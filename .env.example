# Protocol-7 Environment Configuration
# Copy to .env and customize for your setup

# Protocol-7 Root Path
PROTOCOL7_ROOT=/data/projects/protocol-7

# Current Working Branch (updated by session)
PROTOCOL7_BRANCH=main

# Active Zenka
PROTOCOL7_ZENKA=workflow

# Git Repository Settings
GIT_REPOSITORY_PATH=/data/projects/protocol-7

# Crypto Settings
CRYPTO_AUTO_LOAD_KEYS=no
CRYPTO_AUTOCREATE_USER_KEY=yes

# Zenka Verbosity
ZENKA_VERBOSITY_BUFFER=2
ZENKA_VERBOSITY_LOGFILE=2

# ═══════════════════════════════════════════════════════════════════════════
# Session Tracking (for LLM context recovery)
# ═══════════════════════════════════════════════════════════════════════════

# Last session date
SESSION_LAST_UPDATED=2025-11-12

# Session type identifier
SESSION_TYPE=workflow_zenka_development

# Quick start command
CMD_OVERVIEW=./bin/Protocol-7 workflow overview

# Documentation paths
SESSION_STARTUP_GUIDE=data/yaml/project-context/next-session-start.yaml
SESSION_SUMMARY=data/yaml/project-context/session-2025-11-12-workflow-enhancements.yaml
SESSION_PATTERNS=data/yaml/project-context/workflow-zenka-patterns.yaml

# ═══════════════════════════════════════════════════════════════════════════
# IMPORTANT: Check .env.session for complete LLM session context
# ═══════════════════════════════════════════════════════════════════════════
