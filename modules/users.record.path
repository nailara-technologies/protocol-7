## [:< ##

# name  = users.record.path
# descr = keyword path of a record document within a namespace
# param = $username [ , $document ]

## THE ONE PLACE that knows how a record is laid out on disk.  every reader
## and writer goes through here, so the layout can grow without hunting call
## sites.
##
##   [USERS_HOST]/<user>/details.yaml
##
## a record is a DIRECTORY, not a file.  that is the resolved design, not a
## convenience : users-zenka.yaml's directory-as-session fallback treats every
## node as BOTH a directory [ structural/addressable ] and a session [
## append-only/temporal ], precisely so "a plain record can always grow a log/
## subdirectory without changing its address".  a flat <user>.yaml cannot,
## which is the sole reason for the per-user level.
##
## siblings the design already anticipates, none built yet : log/ for the
## append-only half, and a separate CONTENT checksum file, distinct from the
## identity checksum that names the directory.
##
## returns a KEYWORD path -- format.yaml.load_keyword_path resolves it, and
## base.path.resolve_keywords turns it absolute for a write.

my ( $username, $document ) = @ARG;

return undef if not defined $username or not length $username;

$document //= qw| details |;

return sprintf( qw| [USERS_HOST]/%s/%s.yaml |, $username, $document );

