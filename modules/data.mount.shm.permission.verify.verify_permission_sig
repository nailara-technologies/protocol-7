# name = data.mount.shm.permission.verify.verify_permission_sig
# desc: Verify permission signature

my ( $perm, $owner_pubkey ) = @_;

my $canonical = sprintf( "%s:%s:%s:%d:%s",
    $perm->{'to'},     $perm->{'branch'}, join( ',', @{ $perm->{'rights'} } ),
    $perm->{'expiry'}, $perm->{'granted'}, );

my $expected_sig = sprintf(
    "%08X",
    <[chk-sum.amos.truth_template_chksum]>->(
        $canonical . $owner_pubkey, \0
    )
);

return $perm->{'sig'} eq $expected_sig;

