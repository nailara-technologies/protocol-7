# name = data.mount.shm.permission.verify.verify_permission_sig
# desc: Verify permission signature (simplified)

my ( $perm, $owner_pubkey ) = @ARG;

# Build canonical string (same as signing)
my $canonical
    = $perm->{'to'} . ':'
    . $perm->{'branch'} . ':'
    . join( ',', @{ $perm->{'rights'} } ) . ':'
    . $perm->{'expiry'} . ':'
    . $perm->{'granted'};

# Calculate expected signature (placeholder)
my $sig = 0;
for my $i ( 0 .. length($canonical) - 1 ) {
    $sig = ( $sig * 31 + ord( substr( $canonical, $i, 1 ) ) ) & 0xFFFFFFFF;
}
$sig = ( $sig * length( $owner_pubkey || '' ) ) & 0xFFFFFFFF
    if length( $owner_pubkey || '' );

my $expected_sig = sprintf( "%08X", $sig );

return $perm->{'sig'} eq $expected_sig;

