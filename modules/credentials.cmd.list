## [:< ##

# name  = credentials.cmd.list
# descr = list credentials and authorized zenki (no passwords)

my $store_dir = <credentials.cfg.store_dir>;

return { 'mode' => qw| false |, 'data' => 'store directory not found' }
    unless -d $store_dir;

my @entries;

opendir my $dh,
    $store_dir
    or return {
    'mode' => qw| false |,
    'data' => 'cannot read store directory'
    };

foreach my $file ( sort readdir $dh ) {
    next unless $file =~ m|^(.*)\.yaml\.enc$|;
    my $cred_name = $1;

    my $cred = <[credentials.load]>->($cred_name);
    next unless defined $cred;

    my $type = $cred->{'type'} // qw| unknown |;
    my $zenki_str
        = join( ', ', @{ $cred->{'authorized_zenki'} // [] } );

    push @entries,
        sprintf( '%-20s  [%-12s]  -> %s', $cred_name, $type, $zenki_str );
}

closedir $dh;

return { 'mode' => qw| false |, 'data' => 'no credentials found' }
    unless @entries;

return {
    'mode' => qw| size |,
    'data' => join( "\n", @entries ) . "\n"
};

