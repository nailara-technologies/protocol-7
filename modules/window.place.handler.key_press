## [:< ##

# name  = window.place.handler.key_press
# descr = keyboard move/resize/commit/cancel

my ( $widget, $event ) = @ARG;

my $keyval = $event->keyval;
my $state  = $event->state;

my $SHIFT_MASK   = eval { Gtk3::Gdk::SHIFT_MASK() }   // 1;
my $CONTROL_MASK = eval { Gtk3::Gdk::CONTROL_MASK() } // 4;

my $KEY_ESC    = eval { Gtk3::Gdk::KEY_Escape() }   // 65307;
my $KEY_RET    = eval { Gtk3::Gdk::KEY_Return() }   // 65293;
my $KEY_KP_RET = eval { Gtk3::Gdk::KEY_KP_Enter() } // 65421;
my $KEY_UP     = eval { Gtk3::Gdk::KEY_Up() }       // 65362;
my $KEY_DOWN   = eval { Gtk3::Gdk::KEY_Down() }     // 65364;
my $KEY_LEFT   = eval { Gtk3::Gdk::KEY_Left() }     // 65361;
my $KEY_RIGHT  = eval { Gtk3::Gdk::KEY_Right() }    // 65363;

my $shift = $state & $SHIFT_MASK   ? 10 : 1;
my $ctrl  = $state & $CONTROL_MASK ? 1  : 0;

my $x = <x11.coordinates.left> // 0;
my $y = <x11.coordinates.top>  // 0;
my $w = <x11.window.width>     // 320;
my $h = <x11.window.height>    // 240;

my $step = $shift;

if ( $keyval == $KEY_ESC ) {
    <[window.place.cancel]>;
    return TRUE;
} elsif ( $keyval == $KEY_RET or $keyval == $KEY_KP_RET ) {
    <[window.place.commit]>;
    return TRUE;
} elsif ( $keyval == $KEY_UP ) {
    if ($ctrl) {
        $h -= $step;
        $y += $step;
    } else {
        $y -= $step;
    }
} elsif ( $keyval == $KEY_DOWN ) {
    if ($ctrl) {
        $h += $step;
    } else {
        $y += $step;
    }
} elsif ( $keyval == $KEY_LEFT ) {
    if ($ctrl) {
        $w -= $step;
        $x += $step;
    } else {
        $x -= $step;
    }
} elsif ( $keyval == $KEY_RIGHT ) {
    if ($ctrl) {
        $w += $step;
    } else {
        $x += $step;
    }
} else {
    return FALSE;
}

## clamp ##
$w = 32 if $w < 32;
$h = 32 if $h < 32;

my $new_geom = {
    'x'      => $x,
    'y'      => $y,
    'width'  => $w,
    'height' => $h
};

<[window.place.apply_geometry]>->( $widget, $new_geom );
$widget->queue_draw;

return TRUE;

