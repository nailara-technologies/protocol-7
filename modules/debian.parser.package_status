# name  = debian.parser.package_status
# descr = format debian package status for display

my $status = shift;

return
      $status eq 'installed' ? '✓'
    : $status eq 'missing'   ? '✗'
    : $status eq 'unknown'   ? '?'
    :                          $status;

0;

