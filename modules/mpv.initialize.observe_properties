# name = mpv.initialize.observe_properties

map { <[mpv.send_command]>->( qw| observe_property |, 1, $ARG ) } qw[

    video-aspect-override
    path
    width
    height
    volume

];

if (<mpv.fade_idle_volume>) {
    <[mpv.send_command]>->( qw| set_property |,     qw| volume |, 0 );
    <[mpv.send_command]>->( qw| observe_property |, 1, qw| core-idle | );
}

## client-message isn't one of the events enabled by default -- without    ##
## this our control socket never receives the 'protocol7-window-released'  ##
## script-message p7-osc.lua sends, even though mpv.handler.pipe_output    ##
## would dispatch it correctly if it ever arrived.                         ##
<[mpv.send_command]>->( qw| enable_event |, qw| client-message | );

