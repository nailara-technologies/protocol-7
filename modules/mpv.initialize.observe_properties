## [:< ##

# name = mpv.initialize.observe_properties

## observe every tunable settings-map property [ resolved mpv property      ##
## names, same resolution as mpv.cmd.setting ] so the <mpv.current.*> cache ##
## stays populated for state snapshots                                      ##

my %observe
    = map { $ARG => TRUE }
    qw[ path width height seekable partially-seekable ];

my $settings_map = <mpv.map.settings> // {};
foreach my $setting_key ( keys %{$settings_map} ) {
    my $map_entry = $settings_map->{$setting_key} // {};
    my @mpv_properties
        = ref( $map_entry->{'keys'} ) eq qw| ARRAY |
        ? @{ $map_entry->{'keys'} }
        : ( $map_entry->{'key'} // $setting_key );
    map { $observe{$ARG} = TRUE } @mpv_properties;
}

map { <[mpv.send_command]>->( qw| observe_property |, 1, $ARG ) }
    sort keys %observe;

if (<mpv.fade_idle_volume>) {
    <[mpv.send_command]>->( qw| set_property |,     qw| volume |, 0 );
    <[mpv.send_command]>->( qw| observe_property |, 1, qw| core-idle | );
}

## client-message isn't one of the events enabled by default -- without   ##
## this our control socket never receives the 'protocol7-window-released' ##
## script-message p7-osc.lua sends, even though mpv.handler.pipe_output   ##
## would dispatch it correctly if it ever arrived.                        ##
<[mpv.send_command]>->( qw| enable_event |, qw| client-message | );

