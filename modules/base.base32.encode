## [:< ##

# name  = base.base32.encode
# descr = encode string to base32 in reverse byte order and return value
# note  = dependencies loaded already in bin/Protocol-7

if ( not defined $ARG[0] ) {
    warn '[B32] input not defined., [enc] <{C1}>';
    return undef;
} elsif ( ref $ARG[0] ne qw| SCALAR | ) {
    return Crypt::Misc::encode_b32r( $ARG[0] );
} else {
    return Crypt::Misc::encode_b32r( $ARG[0]->$* );
}

