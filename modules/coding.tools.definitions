## [:< ##

# name  = coding.tools.definitions
# descr = OpenAI function-calling tool schemas for inference

## returns arrayref of tool definitions in OpenAI format  each tool maps to ##
## an existing $code{} module  encoding parameter defaults to UTF-8 for     ##
## backwards compatibility recognized encodings: UTF-8 (default), :raw,     ##
## :bytes  normalization will convert any encoding to UTF-8 internally      ##

my @tools;

## read_file : budget-aware file content ##
if ( exists $code{'context.file'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'read_file',
            'description' =>
                'read file content with line range and token budget',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'path' => {
                        'type'        => 'string',
                        'description' => 'file path relative to project root'
                    },
                    'from_line' => {
                        'type'        => 'integer',
                        'description' => 'start line number [ default 1 ]'
                    },
                    'to_line' => {
                        'type'        => 'integer',
                        'description' => 'end line number [ 0 = to end ]'
                    },
                    'budget' => {
                        'type'        => 'integer',
                        'description' => 'token budget [ default 2000 ]'
                    },
                    'offset' => {
                        'type'        => 'integer',
                        'description' =>
                            'character offset to start reading [ default 0 ]'
                    },
                    'length' => {
                        'type'        => 'integer',
                        'description' =>
                            'max characters to read [ default 8000 ]'
                    },
                    'show_line_numbers' => {
                        'type'        => 'boolean',
                        'description' =>
                            'prepend line numbers [ default true ]'
                    },
                },
                'required' => ['path'],
            },
        },
        };
}

## read_module : P7 module content with metadata ##
if ( exists $code{'coding.context.read_module'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'read_module',
            'description' =>
                'read P7 module file with description and metadata',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'module' => {
                        'type'        => 'string',
                        'description' =>
                            'module name [ e.g. coding.system_prompt ]'
                    },
                    'max_chars' => {
                        'type'        => 'integer',
                        'description' => 'character budget [ default 8000 ]'
                    },
                },
                'required' => ['module'],
            },
        },
        };
}

## list_modules : discover modules by namespace ##
if ( exists $code{'context.modules.list'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'list_modules',
            'description' => 'list available modules in a namespace',
            'parameters'  => {
                'type'       => 'object',
                'properties' => {
                    'namespace' => {
                        'type'        => 'string',
                        'description' =>
                            'module namespace [ e.g. coding, context, httpd ]'
                    },
                    'budget' => {
                        'type'        => 'integer',
                        'description' => 'token budget [ default 800 ]'
                    },
                },
                'required' => ['namespace'],
            },
        },
        };
}

## module_deps : dependency call graph ##
if ( exists $code{'context.module.dependencies'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'module_deps',
            'description' => 'find what a module calls and what calls it',
            'parameters'  => {
                'type'       => 'object',
                'properties' => {
                    'module' => {
                        'type'        => 'string',
                        'description' => 'module name to analyze'
                    },
                    'budget' => {
                        'type'        => 'integer',
                        'description' => 'token budget [ default 800 ]'
                    },
                },
                'required' => ['module'],
            },
        },
        };
}

## recent_changes : git diff stats ##
if ( exists $code{'context.git.recent_changes'} ) {
