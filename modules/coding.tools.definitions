## list_files : directory listing ##
if ( exists $code{'pager.source.file-list'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'list_files',
            'description' =>
                'list files in a directory with optional pattern',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'root' => {
                        'type'        => 'string',
                        'description' =>
                            'directory path [ default project root ]'
                    },
                    'pattern' => {
                        'type'        => 'string',
                        'description' => 'file pattern filter'
                    },
                    'recursive' => {
                        'type'        => 'boolean',
                        'description' =>
                            'recurse subdirectories [ default true ]'
                    },
                    'sort' => {
                        'type'        => 'string',
                        'description' =>
                            'sort by name | size | mtime [ default unsorted ]'
                    },
                    'order' => {
                        'type'        => 'string',
                        'description' =>
                            'sort order asc | desc [ default desc ]'
                    },
                },
                'required' => [],
            },
        },
        };
}

## extract_file : smart partial file read ##
if ( exists $code{'context.file.extract'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'extract_file',
            'description' =>
                'smart file extraction: header, functions, or pattern match',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'path' => {
                        'type'        => 'string',
                        'description' => 'file path relative to project root'
                    },
                    'extract' => {
                        'type'        => 'string',
                        'description' =>
                            'extraction mode: header, functions, or pattern'
                    },
                    'pattern' => {
                        'type'        => 'string',
                        'description' => 'regex for pattern extraction mode'
                    },
                    'budget' => {
                        'type'        => 'integer',
                        'description' => 'token budget [ default 1000 ]'
                    },
                },
                'required' => ['path'],
            },
        },
        };
}

## search_code : grep across codebase ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'search_code',
        'description' => 'search modules and files for a pattern [ grep ]',
        'parameters'  => {
            'type'       => 'object',
            'properties' => {
                'pattern' => {
                    'type'        => 'string',
                    'description' => 'search pattern [ perl regex ]'
                },
                'scope' => {
                    'type'        => 'string',
                    'description' =>
                        'search scope: modules, config, lib [ AMOS7 perl '
                        . 'modules under data/lib-path/pm ], or all [ '
                        . 'default modules ]'
                },
                'max_results' => {
                    'type'        => 'integer',
                    'description' => 'max matching lines [ default 30 ]'
                },
                'offset' => {
                    'type'        => 'integer',
                    'description' =>
                        'skip first N results for pagination [ default 0 ]'
                },
            },
            'required' => ['pattern'],
        },
    },
    };

## dep_graph : bidirectional call graph for a namespace ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'dep_graph',
        'description' => 'build call graph for a module namespace '
            . '[ shows who calls what, clusters ]',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'namespace' => {
                    'type'        => 'string',
                    'description' =>
                        'module namespace [ e.g. coding, context.template ]'
                },
                'module' => {
                    'type'        => 'string',
                    'description' =>
                        'single module to graph [ alternative to namespace ]'
                },
            },
            'required' => [],
        },
    },
    };

## ncode_search : full codebase search via ncode binary ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'ncode_search',
        'description' => 'search entire P7 codebase with ncode [ '
            . 'all files, line numbers, grouped by file ]',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'query' => {
                    'type'        => 'string',
                    'description' =>
                        'search string [ case insensitive regex ]'
                },
                'max_results' => {
                    'type'        => 'integer',
                    'description' => 'max output lines [ default 50 ]'
                },
                'offset' => {
                    'type'        => 'integer',
                    'description' =>
                        'skip first N results for pagination [ default 0 ]'
                },
            },
            'required' => ['query'],
        },
    },
    };

## edit_file : line-based file editing with preview ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'edit_file',
        'description' => 'replace specific lines in a file '
            . '[ applies changes by default ]',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'path' => {
                    'type'        => 'string',
                    'description' => 'file path relative to project root'
                },
                'edits' => {
                    'description' => 'edit instructions as array of objects:'
                        . ' [{"line":N,"old":"text","new":"text"}, ...]'
                        . ' [can be array or JSON string]',
                    'anyOf' => [
                        {   'type'  => 'array',
                            'items' => { 'type' => 'object' }
                        },
                        { 'type' => 'string' }
                    ]
                },
                'apply' => {
                    'type'        => 'boolean',
                    'description' =>
                        'true=write changes [ default ], false=preview only'
                },
                'encoding' => {
                    'type'        => 'string',
                    'description' => 'character encoding [ default UTF-8 ]'
                },
            },
            'required' => [ 'path', 'edits' ],
        },
    },
    };

## replace_in_file : content-based find and replace [ no line numbers ] ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'replace_in_file',
        'description' => 'find and replace text in a file by content match [ '
            . 'no line numbers needed, old_string must be '
            . 'unique ]',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'path' => {
                    'type'        => 'string',
                    'description' => 'file path relative to project root'
                },
                'old_string' => {
                    'type'        => 'string',
                    'description' =>
                        'exact text to find [ must match uniquely ]'
                },
                'new_string' => {
                    'type'        => 'string',
                    'description' =>
                        'replacement text [ use empty string to delete ]'
                },
                'replace_all' => {
                    'type'        => 'boolean',
                    'description' =>
                        'replace all occurrences [ default false ]'
                },
                'encoding' => {
                    'type'        => 'string',
                    'description' => 'character encoding [ default UTF-8 ]'
                },
            },
            'required' => [ 'path', 'old_string', 'new_string' ],
        },
    },
    };

## replace_line : replace single line by line number ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'replace_line',
        'description' => 'replace a single line in a file by line number',
        'parameters'  => {
            'type'       => 'object',
            'properties' => {
                'path' => {
                    'type'        => 'string',
                    'description' => 'file path relative to project root'
                },
                'line' => {
                    'type'        => 'integer',
                    'description' => 'line number to replace (1-based)'
                },
                'content' => {
                    'type'        => 'string',
                    'description' => 'replacement line content'
                },
                'apply' => {
                    'type'        => 'boolean',
                    'description' => 'apply change [ default true ]'
                },
                'encoding' => {
                    'type'        => 'string',
                    'description' => 'character encoding [ default UTF-8 ]'
                },
            },
            'required' => [ 'path', 'line', 'content' ],
        },
    },
    };

## delete_lines : delete a range of lines by line numbers ##
push @tools,
