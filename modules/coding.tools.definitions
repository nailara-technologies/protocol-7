            'name'        => 'regex_replace_undo',
            'description' => 'undo the last regex_replace_apply for a file. '
                . 'restores original content from backup.',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'path' => {
                        'type'        => 'string',
                        'description' => 'file path relative to project root'
                    },
                },
                'required' => ['path'],
            },
        },
        };
}

## perltidy : format a file with project perltidy settings ##
if ( exists $code{'coding.tools.handler.perltidy'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'perltidy',
            'description' =>
                'format a perl file with perltidy using project settings. '
                . 'runs in-place by default. use check_only=true to '
                . 'preview issues without modifying.',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'path' => {
                        'type'        => 'string',
                        'description' => 'file path relative to project root'
                    },
                    'check_only' => {
                        'type'        => 'boolean',
                        'description' => 'if true, only report issues '
                            . 'without modifying [ default '
                            . 'false ]'
                    },
                },
                'required' => ['path'],
            },
        },
        };
}

## module_convention_check : audit module headers for convention violations ##
if ( exists $code{'coding.tools.handler.module_convention_check'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'module_convention_check',
            'description' =>
                'audit module files for header convention violations. '
                . 'reports lines exceeding max length and descr lines '
                . 'over limit in cmd/console modules. sorted by longest '
                . 'lines first, shorter filenames first.',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'path' => {
                        'type'        => 'string',
                        'description' => 'directory to scan '
                            . '[ default modules ]'
                    },
                    'max_line' => {
                        'type'        => 'integer',
                        'description' => 'max line length [ default 78 ]'
                    },
                    'max_descr' => {
                        'type'        => 'integer',
                        'description' => 'max descr length for '
                            . 'cmd/console [ default 55 ]'
                    },
                },
                'required' => [],
            },
        },
        };
}

## consensus_query : multi-perspective analysis via perspective injection ##
if ( exists $code{'coding.tools.handler.consensus_query'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'consensus_query',
            'description' =>
                'query the inference model from multiple independent '
                . 'perspectives and return labeled responses for '
                . 'synthesis. use when you need to catch blind spots, '
                . 'verify correctness, or get a multi-angle view of '
                . 'code, a design decision, or a finding. each '
                . 'perspective uses a different system role (critic, '
                . 'advocate, auditor, alternative). responses are '
                . 'independent : the calling model synthesizes them.',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'prompt' => {
                        'type'        => 'string',
                        'description' =>
                            'the question, code snippet, or finding to '
                            . 'evaluate [ keep focused: one concern per '
                            . 'call ]'
                    },
                    'mode' => {
                        'type'        => 'string',
                        'description' => 'preset perspective combination: '
                            . 'review (critic+advocate, '
                            . 'default), verify '
                            . '(critic+auditor), explore '
                            . '(advocate+alternative), '
                            . 'thorough (all three: '
                            . 'critic+advocate+auditor)'
                    },
                    'perspectives' => {
                        'type'        => 'array',
                        'description' =>
                            'explicit list of perspectives to use : '
                            . 'overrides mode. built-in: critic, '
                            . 'advocate, auditor, alternative. any other '
                            . 'string is used as a literal system '
                            . 'prompt.',
                        'items' => { 'type' => 'string' },
                    },
                    'max_tokens' => {
                        'type'        => 'integer',
                        'description' => 'max tokens per perspective '
                            . 'response [ default 512 ]'
                    },
                },
                'required' => ['prompt'],
            },
        },
        };
}

## summarize_context : model-pinned inference summarization ##
if ( exists $code{'coding.tools.handler.summarize_context'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'summarize_context',
            'description' =>
                'summarize content using a dedicated inference call. '
                . 'supports model pinning : specify a large-context '
                . 'model for compression, small fast model receives the '
                . 'dense result. routes to cpu backend by default to '
                . 'avoid interrupting active tasks.',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'content' => {
                        'type'        => 'string',
                        'description' => 'text to summarize'
                    },
                    'focus' => {
                        'type'        => 'string',
                        'description' =>
                            'summarization focus directive [ optional ]'
                    },
                    'model' => {
                        'type'        => 'string',
                        'description' =>
                            'AMOS model ID to use [ empty = loaded model ]'
                    },
                    'backend' => {
                        'type'        => 'string',
                        'description' => 'cpu|gpu|auto [ default cpu ]'
                    },
                    'max_len' => {
                        'type'        => 'integer',
                        'description' =>
                            'target summary tokens [ default 800 ]'
                    },
                    'store' => {
                        'type'        => 'boolean',
                        'description' =>
                            'store result in valued tree [ default false ]'
                    },
                    'node_id' => {
                        'type'        => 'string',
                        'description' =>
                            'valued tree node to attach summary to'
                    },
                },
                'required' => ['content'],
            },
        },
        };
}

## search_memory : focus-scored memory tree lookup ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'search_memory',
        'description' =>
            'search the focus-scored memory tree for relevant context. '
            . 'boosts query terms in the memory zenka focus vector, '
            . 're-scores the tree by recency × focus × IDF, and returns '
            . 'the top-ranked branches as compact ASCII. use to retrieve '
            . 'relevant project memory mid-task.',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'terms' => {
                    'type'        => 'string',
                    'description' =>
                        'one or more space-separated search terms'
                },
            },
            'required' => ['terms'],
        },
    },
    };

## scratchpad_list_all : enumerate session scratchpads [ /tmp + repo ] ##
if ( exists $code{'coding.tools.handler.scratchpad_list_all'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'scratchpad_list_all',
            'description' =>
                'list claude session scratchpads system-wide : volatile /tmp '
                . 'dirs [ import candidates, wiped on reboot ] and '
                . 'imported ones in data/scratchpad/, merged by bmw-L13 '
                . 'id with repo | /tmp | repo+/tmp status.',
            'parameters' => {
                'type'       => 'object',
                'properties' => {},
            },
        },
        };
}

## scratchpad_categorize : local-model keep/drop/review verdict ##
if ( exists $code{'coding.tools.handler.scratchpad_categorize'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'scratchpad_categorize',
            'description' =>
                'triage one claude session scratchpad via a dedicated '
                . 'inference call : reads the /tmp scratchpad files and '
                . 'returns a keep | drop | needs-human-review verdict '
                . 'with reasoning. use before scratchpad_rescue.',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'session' => {
                        'type'        => 'string',
                        'description' => 'claude session uuid'
                    },
                    'max_len' => {
                        'type'        => 'integer',
                        'description' => 'max reply tokens [ default 400 ]'
                    },
                },
                'required' => ['session'],
            },
        },
        };
}

## scratchpad_rescue : import one scratchpad into data/scratchpad/ ##
if ( exists $code{'coding.tools.handler.scratchpad_rescue'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'scratchpad_rescue',
            'description' =>
                'import one claude session scratchpad from /tmp into '
                . 'data/scratchpad/<bmw-L13 of session tmp path>/ with '
                . 'an IMPORT-INFO provenance record [ original path, '
                . 'uuid, per-file mtimes ]. use after a keep verdict '
                . 'from scratchpad_categorize.',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'session' => {
                        'type'        => 'string',
                        'description' => 'claude session uuid'
                    },
                },
                'required' => ['session'],
            },
        },
        };
}

return \@tools;

