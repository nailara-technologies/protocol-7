## [:< ##

# name  = coding.tools.definitions
# descr = OpenAI function-calling tool schemas for inference

## returns arrayref of tool definitions in OpenAI format ##
## each tool maps to an existing $code{} module          ##

my @tools;

## read_file — budget-aware file content ##
if ( exists $code{'context.file'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'read_file',
            'description' =>
                'read file content with line range and token budget',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'path' => {
                        'type'        => 'string',
                        'description' => 'file path relative to project root'
                    },
                    'from_line' => {
                        'type'        => 'integer',
                        'description' => 'start line number [ default 1 ]'
                    },
                    'to_line' => {
                        'type'        => 'integer',
                        'description' => 'end line number [ 0 = to end ]'
                    },
                    'budget' => {
                        'type'        => 'integer',
                        'description' => 'token budget [ default 2000 ]'
                    },
                },
                'required' => ['path'],
            },
        },
        };
}

## read_module — P7 module content with metadata ##
if ( exists $code{'coding.context.read_module'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'read_module',
            'description' =>
                'read P7 module file with description and metadata',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'module' => {
                        'type'        => 'string',
                        'description' =>
                            'module name [ e.g. coding.system_prompt ]'
                    },
                    'max_chars' => {
                        'type'        => 'integer',
                        'description' => 'character budget [ default 8000 ]'
                    },
                },
                'required' => ['module'],
            },
        },
        };
}

## list_modules — discover modules by namespace ##
if ( exists $code{'context.modules.list'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'list_modules',
            'description' => 'list available modules in a namespace',
            'parameters'  => {
                'type'       => 'object',
                'properties' => {
                    'namespace' => {
                        'type'        => 'string',
                        'description' =>
                            'module namespace [ e.g. coding, context, httpd ]'
                    },
                    'budget' => {
                        'type'        => 'integer',
                        'description' => 'token budget [ default 800 ]'
                    },
                },
                'required' => ['namespace'],
            },
        },
        };
}

## module_deps — dependency call graph ##
if ( exists $code{'context.module.dependencies'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'module_deps',
            'description' => 'find what a module calls and what calls it',
            'parameters'  => {
                'type'       => 'object',
                'properties' => {
                    'module' => {
                        'type'        => 'string',
                        'description' => 'module name to analyze'
                    },
                    'budget' => {
                        'type'        => 'integer',
                        'description' => 'token budget [ default 800 ]'
                    },
                },
                'required' => ['module'],
            },
        },
        };
}

## recent_changes — git diff stats ##
if ( exists $code{'context.git.recent_changes'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'recent_changes',
            'description' => 'recent git changes with file stats',
            'parameters'  => {
                'type'       => 'object',
                'properties' => {
                    'max_files' => {
                        'type'        => 'integer',
                        'description' => 'max files to list [ default 10 ]'
                    },
                    'since_commit' => {
                        'type'        => 'string',
                        'description' => 'specific commit to diff from'
                    },
                    'budget' => {
                        'type'        => 'integer',
                        'description' => 'token budget [ default 1500 ]'
                    },
                },
                'required' => [],
            },
        },
        };
}

## recent_errors — error log with filter ##
if ( exists $code{'context.error.recent'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'recent_errors',
            'description' => 'recent error log entries with optional filter',
            'parameters'  => {
                'type'       => 'object',
                'properties' => {
                    'filter' => {
                        'type'        => 'string',
                        'description' => 'error filter pattern'
                    },
                    'lines' => {
                        'type'        => 'integer',
                        'description' => 'max error lines [ default 50 ]'
                    },
                    'budget' => {
                        'type'        => 'integer',
                        'description' => 'token budget [ default 500 ]'
                    },
                },
                'required' => [],
            },
        },
        };
}

## list_files — directory listing ##
if ( exists $code{'pager.source.file-list'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'list_files',
            'description' =>
                'list files in a directory with optional pattern',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'root' => {
                        'type'        => 'string',
                        'description' =>
                            'directory path [ default project root ]'
                    },
                    'pattern' => {
                        'type'        => 'string',
                        'description' => 'file pattern filter'
                    },
                    'recursive' => {
                        'type'        => 'boolean',
                        'description' =>
                            'recurse subdirectories [ default true ]'
                    },
                },
                'required' => [],
            },
        },
        };
}

## extract_file — smart partial file read ##
if ( exists $code{'context.file.extract'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'extract_file',
            'description' =>
                'smart file extraction: header, functions, or pattern match',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'path' => {
                        'type'        => 'string',
                        'description' => 'file path relative to project root'
                    },
                    'extract' => {
                        'type'        => 'string',
                        'description' =>
                            'extraction mode: header, functions, or pattern'
                    },
                    'pattern' => {
                        'type'        => 'string',
                        'description' => 'regex for pattern extraction mode'
                    },
                    'budget' => {
                        'type'        => 'integer',
                        'description' => 'token budget [ default 1000 ]'
                    },
                },
                'required' => ['path'],
            },
        },
        };
}

## search_code — grep across codebase ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'search_code',
        'description' => 'search modules and files for a pattern [ grep ]',
        'parameters'  => {
            'type'       => 'object',
            'properties' => {
                'pattern' => {
                    'type'        => 'string',
                    'description' => 'search pattern [ perl regex ]'
                },
                'scope' => {
                    'type'        => 'string',
                    'description' => 'search scope: modules, config, or all'
                        . ' [ default modules ]'
                },
                'max_results' => {
                    'type'        => 'integer',
                    'description' => 'max matching lines [ default 30 ]'
                },
            },
            'required' => ['pattern'],
        },
    },
    };

## dep_graph — bidirectional call graph for a namespace ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'dep_graph',
        'description' => 'build call graph for a module namespace'
            . ' [ shows who calls what, clusters ]',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'namespace' => {
                    'type'        => 'string',
                    'description' =>
                        'module namespace [ e.g. coding, context.template ]'
                },
                'module' => {
                    'type'        => 'string',
                    'description' =>
                        'single module to graph [ alternative to namespace ]'
                },
            },
            'required' => [],
        },
    },
    };

## ncode_search — full codebase search via ncode binary ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'ncode_search',
        'description' => 'search entire P7 codebase with ncode [ all files,'
            . ' line numbers, grouped by file ]',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'query' => {
                    'type'        => 'string',
                    'description' =>
                        'search string [ case insensitive regex ]'
                },
                'max_results' => {
                    'type'        => 'integer',
                    'description' => 'max output lines [ default 50 ]'
                },
            },
            'required' => ['query'],
        },
    },
    };

## edit_file — line-based file editing with preview ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'edit_file',
        'description' => 'replace specific lines in a file'
            . ' [ applies changes by default ]',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'path' => {
                    'type'        => 'string',
                    'description' => 'file path relative to project root'
                },
                'edits' => {
                    'type'        => 'string',
                    'description' => 'edit instructions as JSON array:'
                        . ' [{"line":N,"old":"text","new":"text"}]'
                },
                'apply' => {
                    'type'        => 'boolean',
                    'description' =>
                        'true=write changes [ default ], false=preview only'
                },
            },
            'required' => [ 'path', 'edits' ],
        },
    },
    };

## replace_in_file — content-based find and replace [ no line numbers ] ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'replace_in_file',
        'description' => 'find and replace text in a file by content match'
            . ' [ no line numbers needed, old_string must be unique ]',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'path' => {
                    'type'        => 'string',
                    'description' => 'file path relative to project root'
                },
                'old_string' => {
                    'type'        => 'string',
                    'description' =>
                        'exact text to find [ must match uniquely ]'
                },
                'new_string' => {
                    'type'        => 'string',
                    'description' =>
                        'replacement text [ use empty string to delete ]'
                },
                'replace_all' => {
                    'type'        => 'boolean',
                    'description' =>
                        'replace all occurrences [ default false ]'
                },
            },
            'required' => [ 'path', 'old_string', 'new_string' ],
        },
    },
    };

## list_inline_subs — scan module for sub declarations ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'list_inline_subs',
        'description' => 'scan a P7 module for inline sub declarations'
            . ' [ returns names, line numbers, line counts ]',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'module' => {
                    'type'        => 'string',
                    'description' =>
                        'module name [ e.g. plugin.storage.visual.extract-floats ]'
                },
                'min_lines' => {
                    'type'        => 'integer',
                    'description' =>
                        'minimum sub body lines to include [ default 0 ]'
                },
            },
            'required' => ['module'],
        },
    },
    };

## validate_module_format — check P7 module against format rules ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'validate_module_format',
        'description' => 'check a P7 module for format issues:'
            . ' header, metadata, forbidden patterns,'
            . ' inline sub declarations',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'module' => {
                    'type'        => 'string',
                    'description' =>
                        'module name [ e.g. context.util.tree.canonical_json ]'
                },
            },
            'required' => ['module'],
        },
    },
    };

## ptd_check — syntax check a P7 module ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'ptd_check',
        'description' => 'syntax check a P7 module with ptd -c'
            . ' [ reports compile errors ]',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'module' => {
                    'type'        => 'string',
                    'description' =>
                        'module name [ e.g. coding.tools.dispatch ]'
                },
            },
            'required' => ['module'],
        },
    },
    };

## ptd_format — format a P7 module with ptd ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'ptd_format',
        'description' => 'format a P7 module with ptd'
            . ' [ auto-indents and reports changes ]',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'module' => {
                    'type'        => 'string',
                    'description' =>
                        'module name [ e.g. coding.tools.dispatch ]'
                },
            },
            'required' => ['module'],
        },
    },
    };

## write_new_file — create a new file [ refuses to overwrite ] ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'write_new_file',
        'description' => 'create a new file [ fails if file already exists ]',
        'parameters'  => {
            'type'       => 'object',
            'properties' => {
                'path' => {
                    'type'        => 'string',
                    'description' => 'file path relative to project root'
                },
                'content' => {
                    'type'        => 'string',
                    'description' => 'file content to write'
                },
            },
            'required' => [ 'path', 'content' ],
        },
    },
    };

<[base.logs]>->(
    2,
    ':. tools.definitions: %d tools available',
    scalar @tools
);

return \@tools;

