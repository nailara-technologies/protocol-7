## task_file_search — find task files across active and archived locations ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'task_file_search',
        'description' =>
            'search task files across active and archived locations. '
            . 'first searches filenames, then optionally file contents. '
            . 'knows about data/yaml/coding-tasks, data/md/coding-tasks, '
            . 'and archive subdirectories.',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'pattern' => {
                    'type'        => 'string',
                    'description' =>
                        'search pattern [ regex or glob, required ]'
                },
                'status' => {
                    'type'        => 'string',
                    'description' =>
                        'filter by status: active | archived | all [ default all ]'
                },
                'depth' => {
                    'type'        => 'integer',
                    'description' =>
                        'search depth: 1 = filenames only, 2 = +content [ default 1 ]'
                },
                'max_results' => {
                    'type'        => 'integer',
                    'description' => 'max files to return [ default 50 ]'
                },
            },
            'required' => ['pattern'],
        },
    },
    };

## tree_list — list children of a branch with type info ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'tree_list',
        'description' =>
            'inspect in-memory zenka state hash (%data) — NOT the filesystem. '
            . 'use list_files to browse disk. '
            . 'shows keys, types (scalar/hash/array/code), and sizes.',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'path' => {
                    'type'        => 'string',
                    'description' =>
                        'dot-separated path [ empty = top-level ]'
                },
                'pattern' => {
                    'type'        => 'string',
                    'description' =>
                        'regex filter for key names [ optional ]'
                },
                'depth' => {
                    'type'        => 'integer',
                    'description' => 'recursion depth [ default 1, max 3 ]'
                },
                'budget' => {
                    'type'        => 'integer',
                    'description' => 'token budget [ default 1500 ]'
                },
            },
            'required' => [],
        },
    },
    };

## file_rename — rename or move a file within the project ##
if ( exists $code{'coding.tools.handler.file_rename'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'file_rename',
            'description' => 'rename or move a file within the project'
                . ' [ both paths must stay inside project root ]',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'source' => {
                        'type'        => 'string',
                        'description' =>
                            'current file path relative to project root'
                    },
                    'target' => {
                        'type'        => 'string',
                        'description' =>
                            'new file path relative to project root'
                    },
                },
                'required' => [ 'source', 'target' ],
            },
        },
        };
}

## remove_file — move file to trash [ recoverable delete ] ##
if ( exists $code{'coding.tools.handler.remove_file'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'remove_file',
            'description' =>
                'delete a file by moving it to trash [ recoverable ]'
                . ' [ use for cleanup of obsolete or generated files ]',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'path' => {
                        'type'        => 'string',
                        'description' => 'file path relative to project root'
                    },
                    'reason' => {
                        'type'        => 'string',
                        'description' =>
                            'reason for deletion [ logged for audit ]'
                    },
                },
                'required' => ['path'],
            },
        },
        };
}

## write_new_file — create a new file [ refuses to overwrite ] ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'write_new_file',
        'description' => 'create a new file [ fails if file already exists ]',
        'parameters'  => {
            'type'       => 'object',
            'properties' => {
                'path' => {
                    'type'        => 'string',
                    'description' => 'file path relative to project root'
                },
                'content' => {
                    'type'        => 'string',
                    'description' => 'file content to write'
                },
                'encoding' => {
                    'type'        => 'string',
                    'description' => 'character encoding [ default UTF-8 ]'
                },
            },
            'required' => [ 'path', 'content' ],
        },
    },
    };

## write_append — append to existing file ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'write_append',
        'description' => 'append content to an existing file',
        'parameters'  => {
            'type'       => 'object',
            'properties' => {
                'path' => {
                    'type'        => 'string',
                    'description' => 'file path relative to project root'
                },
                'content' => {
                    'type'        => 'string',
                    'description' => 'content to append'
                },
                'encoding' => {
                    'type'        => 'string',
                    'description' => 'character encoding [ default UTF-8 ]'
                },
            },
            'required' => [ 'path', 'content' ],
        },
    },
    };

<[base.logs]>->(
    2,
    ':. tools.definitions: %d tools available',
    scalar @tools
);

## note_write — save finding/thought to task notes ##
if ( exists $code{'coding.tools.handler.note_write'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'note_write',
            'description' =>
                'write a finding or thought to task notes workspace'
                . ' [ persists across rounds, accessible to later tasks ]',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'section' => {
                        'type'        => 'string',
                        'description' =>
                            'note section name [ e.g. finding, analysis, todo ]'
                    },
                    'content' => {
                        'type'        => 'string',
                        'description' => 'content to save'
                    },
                },
                'required' => [ 'section', 'content' ],
            },
        },
        };
}

## note_read — access notes from current or previous task ##
if ( exists $code{'coding.tools.handler.note_read'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'note_read',
            'description' => 'read notes from current or previous task'
                . ' [ L1=short summary, L2=detailed, L3=full workspace ]',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'task_id' => {
                        'type'        => 'string',
                        'description' =>
                            'task ID to read [ default: current task ]'
                    },
                    'level' => {
                        'type'        => 'string',
                        'description' =>
                            'detail level: L1, L2, or L3 [ default L3 ]',
                        'enum' => [ 'L1', 'L2', 'L3' ]
                    },
                },
                'required' => [],
            },
        },
        };
}

## note_list — browse available note trees ##
if ( exists $code{'coding.tools.handler.note_list'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'note_list',
            'description' => 'list available note trees with previews'
                . ' [ find related prior work ]',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'tag' => {
                        'type'        => 'string',
                        'description' => 'filter by category tag [ optional ]'
                    },
                    'max' => {
                        'type'        => 'integer',
                        'description' => 'max results [ default 10 ]'
                    },
                },
                'required' => [],
            },
        },
        };
}

## note_summarize — create L1/L2 summaries ##
if ( exists $code{'coding.tools.handler.note_summarize'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'note_summarize',
            'description' =>
                'generate token-efficient summaries from workspace'
                . ' [ L1 for quick scan, L2 for detailed context ]',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'short' => {
                        'type'        => 'string',
                        'description' =>
                            'L1 short summary [ 1-2 paragraphs ]'
                    },
                    'long' => {
                        'type'        => 'string',
                        'description' =>
                            'L2 detailed summary [ key findings, approach ]'
                    },
                },
                'required' => [],
            },
        },
        };
}

## note_search — find notes by keyword or content ##
if ( exists $code{'coding.tools.handler.note_search'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'note_search',
            'description' =>
                'search previous notes by keyword, tag, or content'
                . ' [ find relevant prior work ]',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'query' => {
                        'type'        => 'string',
                        'description' =>
                            'search string [ matches task_id, tags, content ]'
                    },
                    'search_level' => {
                        'type'        => 'string',
                        'description' =>
                            'where to search: all, L1, L2, L3, or meta',
                        'enum' => [ 'all', 'L1', 'L2', 'L3', 'meta' ]
                    },
                    'max_results' => {
                        'type'        => 'integer',
                        'description' => 'max notes to return [ default 10 ]'
                    },
                },
                'required' => ['query'],
            },
        },
        };
}

## note_update — replace content in an existing note section ##
if ( exists $code{'coding.tools.handler.note_update'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'note_update',
            'description' => 'replace content in an existing note section'
                . ' [ does not append, replaces entire section ]',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'section' => {
                        'type'        => 'string',
                        'description' => 'section name to update'
                    },
                    'content' => {
                        'type'        => 'string',
                        'description' =>
                            'new content (replaces entire section)'
                            . ' [ timestamp header added automatically ]'
                    },
                    'task_id' => {
                        'type'        => 'string',
                        'description' => 'task ID [ default: current task ]'
                    },
                },
                'required' => [ 'section', 'content' ],
            },
        },
        };
}

## note_delete — remove note section or entire task notes ##
if ( exists $code{'coding.tools.handler.note_delete'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'note_delete',
            'description' => 'delete a note section or all notes for a task'
                . ' [ clean up old or irrelevant notes ]',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'section' => {
                        'type'        => 'string',
                        'description' => 'section name to delete'
                            . ' [ omit to delete all task notes ]'
                    },
                    'task_id' => {
                        'type'        => 'string',
                        'description' =>
                            'task id [ defaults to current task ]'
                    },
                },
                'required' => [],
            },
        },
        };
}

## note_tag — add tags to a note section ##
if ( exists $code{'coding.tools.handler.note_tag'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'note_tag',
            'description' => 'add tags to a note section'
                . ' [ organize notes with keyword tags ]',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'section' => {
                        'type'        => 'string',
                        'description' => 'section name to tag'
                    },
                    'tags' => {
                        'type'        => 'string',
                        'description' =>
                            'comma-separated tags [ e.g. bug,urgent,auth ]'
                    },
                    'task_id' => {
                        'type'        => 'string',
                        'description' =>
                            'task id [ defaults to current task ]'
                    },
                },
                'required' => [ 'section', 'tags' ],
            },
        },
        };
}

## note_recent — list recent notes across all tasks ##
if ( exists $code{'coding.tools.handler.note_recent'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'note_recent',
            'description' => 'list recent notes across all tasks'
                . ' [ sorted by last update, shows preview ]',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'count' => {
                        'type'        => 'integer',
                        'description' =>
                            'max entries to return [ default 10 ]'
                    },
                    'section' => {
                        'type'        => 'string',
                        'description' =>
                            'filter to specific section name [ optional ]'
                    },
                },
                'required' => [],
            },
        },
        };
}

## note_filter — multi-criteria filtering across notes ##
if ( exists $code{'coding.tools.handler.note_filter'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'note_filter',
            'description' => 'filter notes by tag, section, date, or task'
                . ' [ combine criteria for targeted search ]',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'tag' => {
                        'type'        => 'string',
                        'description' => 'filter by tag name'
                    },
                    'section' => {
                        'type'        => 'string',
                        'description' =>
                            'filter by section name pattern [ regex ]'
                    },
                    'after' => {
                        'type'        => 'string',
                        'description' =>
                            'only notes updated after this timestamp'
                    },
                    'task_id' => {
                        'type'        => 'string',
                        'description' =>
                            'filter to specific task [ optional ]'
                    },
                },
                'required' => [],
            },
        },
        };
}

## note_history — show modification history for a section ##
if ( exists $code{'coding.tools.handler.note_history'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'note_history',
            'description' => 'show modification history for a note section'
                . ' [ timestamps and previews of past entries ]',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'section' => {
                        'type'        => 'string',
                        'description' => 'section name to check history'
                    },
                    'task_id' => {
                        'type'        => 'string',
                        'description' =>
                            'task id [ defaults to current task ]'
                    },
                    'count' => {
                        'type'        => 'integer',
                        'description' => 'max history entries [ default 5 ]'
                    },
                },
                'required' => ['section'],
            },
        },
        };
}

## note_merge — combine notes from multiple sections or tasks ##
if ( exists $code{'coding.tools.handler.note_merge'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'note_merge',
            'description' => 'merge notes from multiple sections into one'
                . ' [ combine findings across tasks or sections ]',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'sources' => {
                        'type'        => 'string',
                        'description' => 'comma-separated source specs'
                            . ' [ "section" or "task_id:section" ]'
                    },
                    'target_section' => {
                        'type'        => 'string',
                        'description' =>
                            'target section name for merged content'
                    },
                    'task_id' => {
                        'type'        => 'string',
                        'description' =>
                            'target task id [ defaults to current task ]'
                    },
                },
                'required' => [ 'sources', 'target_section' ],
            },
        },
        };
}

## validate_module — check module for errors before commit ##
if ( exists $code{'coding.tools.handler.validate_module'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'validate_module',
            'description' =>
                'validate P7 module for common errors and format issues'
                . ' [ run before declaring task complete ]',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'module' => {
                        'type'        => 'string',
                        'description' => 'module name to validate'
                    },
                },
                'required' => ['module'],
            },
        },
        };
}

## decode_base32 — decode base32/base32r encoded strings ##
if ( exists $code{'coding.tools.handler.decode_base32'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'decode_base32',
            'description' => 'decode base32 or base32r encoded strings'
                . ' [ useful for encoded identifiers, checksums ]',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'encoded' => {
                        'type'        => 'string',
                        'description' =>
                            'base32 encoded string [ e.g. NFWXA4T... ]'
                    },
                },
                'required' => ['encoded'],
            },
        },
        };
}

## ncode_search_context — regexp search across files with context lines ##
if ( exists $code{'ncode.cmd.search'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'ncode_search_context',
            'description' =>
                'regexp search across files with optional context lines',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'target' => {
                        'type'        => 'string',
                        'description' => 'target path or directory to search'
                    },
                    'pattern' => {
                        'type'        => 'string',
                        'description' => 'perl regex pattern to match'
                    },
                    'context' => {
                        'type'        => 'integer',
                        'description' =>
                            'context lines around matches [ default 0 ]'
                    },
                },
                'required' => [ 'target', 'pattern' ],
            },
        },
        };
}

return \@tools;

