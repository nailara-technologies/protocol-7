## task_complete : signal task completion and stop the loop ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'task_complete',
        'description' => 'signal that the task is done and stop working '
            . '[ call this when all work is finished ]',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'summary' => {
                    'type'        => 'string',
                    'description' => 'brief summary of what was accomplished'
                },
            },
            'required' => ['summary'],
        },
    },
    };

## escalate : signal need for human attention ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'escalate',
        'description' => 'stop and ask a human for help [ use when '
            . 'blocked, confused, or need a decision ]',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'question' => {
                    'type'        => 'string',
                    'description' => 'what you need help with'
                },
                'context' => {
                    'type'        => 'string',
                    'description' =>
                        'additional context [ what you tried, why stuck ]'
                },
                'severity' => {
                    'type'        => 'string',
                    'description' =>
                        'question, warning, or blocker [ default question ]'
                },
            },
            'required' => ['question'],
        },
    },
    };

## subtask_spawn : delegate work to a child task ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'subtask_spawn',
        'description' => 'spawn a focused child task to investigate or solve '
            . 'a sub-problem. the parent task pauses until '
            . 'the child completes and the result is '
            . 'injected back into parent context. use for '
            . 'parallelizable work or deep dives that '
            . 'should not block the main flow.',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'description' => {
                    'type'        => 'string',
                    'description' => 'clear description of what '
                        . 'the child task should do'
                },
                'template' => {
                    'type'        => 'string',
                    'description' => 'optional context template '
                        . 'name to guide the child task'
                },
                'guiding_message' => {
                    'type'        => 'string',
                    'description' => 'optional guidance for the child task [ '
                        . 'constraints, priorities, hints ]'
                },
            },
            'required' => ['description'],
        },
    },
    };

## record_question : note uncertainty without stopping ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'record_question',
        'description' => 'record a question or uncertainty for later '
            . 'human review [ does NOT stop the task ]',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'content' => {
                    'type'        => 'string',
                    'description' => 'the question or uncertainty to record'
                },
                'category' => {
                    'type'        => 'string',
                    'description' =>
                        'topic area [ e.g. architecture, naming, '
                        . 'requirements, style ] [ default general ]'
                },
                'priority' => {
                    'type'        => 'string',
                    'description' =>
                        'low, normal, or high [ default normal ]'
                },
            },
            'required' => ['content'],
        },
    },
    };

