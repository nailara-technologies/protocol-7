                    },
                    'since_commit' => {
                        'type'        => 'string',
                        'description' => 'specific commit to diff from'
                    },
                    'budget' => {
                        'type'        => 'integer',
                        'description' => 'token budget [ default 1500 ]'
                    },
                },
                'required' => [],
            },
        },
        };
}

