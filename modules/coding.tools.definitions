                    },
                    'flags' => {
                        'type'        => 'string',
                        'description' =>
                            'regex flags [default g]. g=global, '
                            . 'i=case-insensitive, m=multiline, s=dotall'
                    },
                },
                'required' => [ 'path', 'pattern', 'replacement' ],
            },
        },
        };
}

