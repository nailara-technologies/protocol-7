## ask_user_choice : modal option-selection dialog ##
if ( exists $code{'coding.tools.handler.ask_user_choice'} ) {
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'ask_user_choice',
            'description' =>
                'ask the user to choose one option from a pre-generated '
                . 'list. urgent=true pops the dialog immediately; '
                . 'urgent=false (default) queues the question and asks it '
                . 'at the next checkpoint flush.',
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'question' => {
                        'type'        => 'string',
                        'description' => 'short question text'
                    },
                    'options' => {
                        'type'        => 'array',
                        'description' => 'list of option strings',
                        'items'       => { 'type' => 'string' }
                    },
                    'urgent' => {
                        'type'        => 'boolean',
                        'description' =>
                            'ask now instead of batching [ default false ]'
                    },
                },
                'required' => [ 'question', 'options' ],
            },
        },
        };
}

## ask_user_text : blocking free-text input dialog ##
