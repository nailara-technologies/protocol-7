# name  = base.callback.expire_code_version
# descr = free archived code version after rollback window expires

my $version    = delete <base.loader.rollback_version>;
my $code_store = <base.loader.code_store>;

return if not defined $version or not defined $code_store;

delete $code_store->{$version};    ##  free archived version  ##

delete <base.loader.rollback_watcher>;

## strip _v _ for numerical display ##
( my $iteration = $version ) =~ s|\D||g;

<[base.log]>->(
    2, sprintf '..: rollback window expired, unreferenced [%03d]', $iteration
);

