# name = debian.parent.verify_dependency_state
# descr = universal verification function for any dependency type (PM, OS, Binary)

my $dep_type = shift;  ## 'pm_module', 'os_package', or 'binary'
my $dep_name = shift;

## Return structure: { available => 0|1, error => 'message' or undef, path => '/path/to/binary' or undef }

my %result = (
    available => 0,
    error     => undef,
    path      => undef
);

## Verify Perl module dependency
if ( $dep_type eq 'pm_module' ) {
    eval {
        require Module::Load;
        Module::Load::load($dep_name);
    };
    if ($@) {
        $result{error} = "Failed to load Perl module '$dep_name': $@";
        return \%result;
    }
    $result{available} = 1;
    return \%result;
}

## Verify OS package dependency
elsif ( $dep_type eq 'os_package' ) {
    my $check_cmd = qq{ dpkg -l | grep -q "^ii.*$dep_name" };
    my $exit_code = system($check_cmd);

    if ( $exit_code == 0 ) {
        $result{available} = 1;
        return \%result;
    } else {
        $result{error} = "Debian package '$dep_name' is not installed";
        return \%result;
    }
}

## Verify Binary dependency
elsif ( $dep_type eq 'binary' ) {
    my $which_output = `which $dep_name 2>/dev/null`;
    chomp($which_output);

    if ( -x $which_output && $which_output ) {
        $result{available} = 1;
        $result{path} = $which_output;
        return \%result;
    } else {
        $result{error} = "Binary '$dep_name' not found in \$PATH";
        return \%result;
    }
}

## Unknown dependency type
else {
    $result{error} = "Unknown dependency type: $dep_type (use 'pm_module', 'os_package', or 'binary')";
    return \%result;
}

