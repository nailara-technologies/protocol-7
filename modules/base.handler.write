## [:< ##

# name  = base.handler.write
# descr = writes buffer content to client handle

my $id;
my $event;

if ( ref $ARG[0] ne qw| Event::Event::Io | and $ARG[0] =~ m|^\d+| ) {
    $id = shift;    ##  direct call with session id  ##
} else {    ## was Event watcher ##
    $event = shift;
    $id    = $event->w->data;
}

return <[base.session.check_remaining]> if not defined $data{'session'}{$id};

my $session = $data{'session'}{$id};
my $buf     = $session->{'buffer'}->{'output'};

my $write_size = length $buf;

if ( fileno $session->{'handle'} ) {
    ## For downloads with SSL sockets, keep writing in a loop until the buffer drains
    ## or the socket would block, because SSL sockets can only write one TLS record
    ## (16KB) at a time due to OpenSSL limitations.
    ## Limit iterations to ~1MB per handler call to prevent blocking the event loop
    ## and ensure fair scheduling for other sessions/downloads.
    my $is_download = defined $session->{'watcher'}->{'download_handler'};
    my $write_count = 0;
    my $max_writes_per_call = 64;   ## ~1MB per handler invocation (64 * 16KB)

    while ( $write_size > 0 && $write_count < $max_writes_per_call ) {
        ## CRITICAL FIX: For SSL sockets, use base.ssl.write instead of base.s_write
        ## IO::AIO does not work with IO::Socket::SSL because SSL encryption happens
        ## at the OpenSSL library level, not the kernel level.
        my $size_written
            = ref( $session->{'handle'} ) eq qw| IO::Socket::SSL |
            ? <[base.ssl.write]>->(
            $session->{'handle'}, \$session->{'buffer'}->{'output'},
            $write_size
            )
            : <[base.s_write]>->(
            $session->{'handle'}, \$session->{'buffer'}->{'output'},
            $write_size
            );

        if ( $size_written < 0 ) {
            $session->{'shutdown'} = 1;
            last;
        } elsif ( $size_written == 0 ) {
            ## No more data could be written (socket would block for SSL)
            ## For downloads, we'll keep the handler registered to continue later
            last;
        } else {
            $data{'handle'}{ $session->{'handle'} }{'bytes'}{'out'}
                += $size_written;

            substr( $session->{'buffer'}->{'output'}, 0, $size_written, '' );

            ## Recalculate write size for next iteration
            $write_size = length $session->{'buffer'}->{'output'};
            $write_count++;

            ## Continue loop to write more data if available
            ## For SSL downloads, syswrite() typically writes one record (16KB)
            ## Loop limit ($max_writes_per_call) prevents event loop starvation
        }
    }

    if ( defined $event ) {
        $event->w->stop;

        my $remaining_buf = length $session->{'buffer'}->{'output'};

        ## For downloads, always restart immediately (don't use burst-write defer)
        if ($is_download) {
            $event->w->start;    ## immediate restart for downloads ##
        } elsif ( defined $session->{'burst-writes'}
            and $session->{'burst-writes'} =~ m|^\d+$| ) {
            $session->{'burst-write-counter'} //= 0;
            if ( $session->{'burst-write-counter'}++
                < $session->{'burst-writes'} ) {
                $event->w->start;    ## burst-write mode ##
            } else {
                ##  deferred restart [ idle-watcher ]  ##
                delete $session->{'burst-write-counter'};
            }

        } else {
            $event->w->start;    ## immediate restart ##
        }

        # httpd zenka [ download in progress ]
        if ( defined $session->{'watcher'}->{'download_handler'}
            and !$session->{'watcher'}->{'download_handler'}->is_running ) {
            $session->{'watcher'}->{'download_handler'}->start;
        }
    }
} else {
    $event->w->cancel;
    $session->{'shutdown'} = 1;
    return 2;
}

## Check remaining buffer size
if ( $write_size = length $session->{'buffer'}->{'output'} ) {

    ##  deferred restart [ when idle ]  ##
    <[event.io_idle_restart]>->($event)
        if defined $event and not $event->w->is_active;

    $data{'watcher'}{'io'}{'transfer'}->start
        if not $data{'watcher'}{'io'}{'transfer'}->is_active;

} elsif ( not $session->{'watcher'}{'output_buffer'}->is_active ) {
    $session->{'watcher'}->{'output_buffer'}->start;
}

$session->{'shutdown'} = 1 if !$write_size and $session->{'flush_shutdown'};

return 0;

