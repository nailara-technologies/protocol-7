## [:< ##

# name = coding.task.dequeue
# descr = get next available coding task from queue
# purpose = coding task management : wrapper around jobqueue.get_next_job for 'queued' queue

my $result = <[jobqueue.get_next_job]>->('queued');

return {
    success => FALSE,
    error   => 'no tasks available in queue'
    }
    unless defined $result;

my ( $job_id, $job_data ) = @$result;

return {
    success   => TRUE,
    job_id    => $job_id,
    task_id   => $job_data->{object_id},
    task_type => $job_data->{callback_params}->{type} // 'general',
    priority  => $job_data->{priority},
    status    => $job_data->{status},
};

