## [:< ##

# name = letsencrypt.cmd.enroll
# descr = Enroll domain with Let's Encrypt and optionally install to httpsd

my $params = shift || {};

my $domain = $params->{domain};

if (!$domain) {
        return {
            success => 0,
            error   => qw| domain parameter required |,
            usage   => qw| letsencrypt.enroll domain=example.com [auto_install=1] |
        };
    }

    my $auto_install = $params->{auto_install} // 1;

    <[base.log]>->( 2, "letsencrypt.cmd.enroll: Starting enrollment for '$domain'" );

    ## Check if certificate already exists and is valid
    my $cert_file = "/etc/protocol-7/certs/$domain.pem";
    my $key_file  = "/etc/protocol-7/certs/$domain.key";

    if (-f $cert_file && -f $key_file) {
        ## Check certificate expiration
        my $cert_info = <[letsencrypt.parent.get_cert_info]>->($cert_file);

        if ($cert_info && $cert_info->{days_until_expiry} > 30) {
            <[base.log]>->( 2, "  Certificate exists and valid for $cert_info->{days_until_expiry} days" );

            return {
                success           => 1,
                status            => qw| existing_valid |,
                domain            => $domain,
                cert_file         => $cert_file,
                key_file          => $key_file,
                days_until_expiry => $cert_info->{days_until_expiry}
            };
        } else {
            <[base.log]>->( 1, "  Certificate exists but expires soon, renewing..." );
        }
    }

    ## Trigger ACME enrollment via IPC to letsencrypt zenka
    <[base.log]>->( 2, "  Sending enrollment request to letsencrypt zenka" );

    ## Prepare enrollment request
    my $enrollment_request = {
        command   => qw| letsencrypt.parent.enroll_domain |,
        zenka     => qw| letsencrypt |,
        call_args => {
            args => $domain
        },
        reply => {
            handler => qw| letsencrypt.handler.enrollment_reply |,
            timeout => 300  ## 5 minutes for ACME challenges
        }
    };

    ## For now, call directly if in same zenka, otherwise use IPC
    my $result;

    if (exists $code{'letsencrypt.parent.enroll_domain'}) {
        ## Direct call (same zenka or module loaded)
        <[base.log]>->( 2, "  Calling letsencrypt.parent.enroll_domain directly" );

        eval {
            $result = <[letsencrypt.parent.enroll_domain]>->($domain);
        };

        if ($@) {
            <[base.log]>->( 0, "  Enrollment failed: $@" );
            return {
                success => 0,
                error   => qq| enrollment failed: $@ |
            };
        }

        if (!$result || !$result->{success}) {
            my $error_msg = $result->{error} || qw| unknown enrollment error |;
            <[base.log]>->( 0, "  Enrollment failed: $error_msg" );

            return {
                success => 0,
                error   => $error_msg
            };
        }

        <[base.log]>->( 2, "  Certificate enrolled successfully" );

        ## Step 2: Install to httpsd if requested
        if ($auto_install) {
            <[base.log]>->( 2, "  Installing certificate to httpsd" );

            my $install_result;
            eval {
                $install_result = <[letsencrypt.parent.install_certificate_to_httpsd]>->($domain);
            };

            if ($@ || !$install_result || !$install_result->{success}) {
                my $error = $@ || $install_result->{error} || qw| unknown install error |;
                <[base.log]>->( 0, "  Certificate installation failed: $error" );

                return {
                    success       => 1,  ## Enrollment succeeded
                    status        => qw| enrolled_install_failed |,
                    domain        => $domain,
                    cert_file     => $cert_file,
                    key_file      => $key_file,
                    install_error => $error
                };
            }

            <[base.log]>->( 2, "  Certificate installed and httpsd reloaded" );

            return {
                success   => 1,
                status    => qw| enrolled_and_installed |,
                domain    => $domain,
                cert_file => $cert_file,
                key_file  => $key_file
            };
        } else {
            return {
                success   => 1,
                status    => qw| enrolled_not_installed |,
                domain    => $domain,
                cert_file => $cert_file,
                key_file  => $key_file
            };
        }

    } else {
        ## IPC call to letsencrypt zenka (not implemented yet)
        <[base.log]>->( 0, "  IPC to letsencrypt zenka not yet implemented" );

        return {
            success => 0,
            error   => qw| letsencrypt zenka IPC not implemented |,
            hint    => qw| ensure letsencrypt zenka is running or load modules directly |
        };
    }

0;

