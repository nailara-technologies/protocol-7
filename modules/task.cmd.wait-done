## [:< ##

# name  = task.cmd.wait-done
# descr = deferred wait for task completion — returns result
# param = <task_id> [timeout-seconds]

my $args_str = $call->{'args'} // '';
my ( $task_id, $timeout ) = split m{ +}, $args_str, 2;

$task_id = uc( substr( $task_id // '', 0, 7 ) );
$timeout = defined $timeout ? int($timeout) : 300;
$timeout = 0 if $timeout < 0;

return { 'mode' => 'false', 'data' => 'task_id required' }
    unless length $task_id;

my $task = <task.queue>->{$task_id};

return { 'mode' => 'false', 'data' => "task not found: $task_id" }
    unless defined $task;

## already done at call time — reply immediately ##
my $status = $task->{'status'} // '';
if ( $status eq 'done' ) {
    <[base.logs]>->( 1, 'wait-done: %s already done', $task_id );
    return { 'mode' => 'size', 'data' => $task->{'result'} // '' };
}
if ( $status eq 'failed' ) {
    <[base.logs]>->( 1, 'wait-done: %s already failed', $task_id );
    return {
        'mode' => 'false',
        'data' => 'failed: ' . ( $task->{'result'} // '' )
    };
}

## store reply_id for deferred completion ##
my $reply_id = $call->{'reply_id'};
<task.wait.pending>->{$task_id} = $reply_id;

## timeout is handled by the caller (p7c/bin/task-wait) ##
## internal timer deferred — add task.cmd.wait-timeout module if needed ##

<[base.logs]>->( 1, 'wait-done: deferred for %s', $task_id );

return { 'mode' => 'deferred' };

