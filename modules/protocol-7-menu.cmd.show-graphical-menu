# name = protocol-7-menu.cmd.show-graphical-menu
# descr = Command: Initialize (if needed) and show graphical menu window

return { 'mode' => qw| false |, 'data' => 'graphical mode not enabled' }
    unless <protocol-7-menu.init-graphical>;

## Lazy initialization - only create window when actually requested
unless ( <protocol-7-menu.graphical-initialized> ) {
    <[base.log]>->( 1, "initializing graphical menu on-demand" );
    <[protocol-7-menu.graphical-init]>;
    <protocol-7-menu.graphical-initialized> = TRUE;
}

my $window = <protocol-7-menu.graphical-window>;
unless ( defined $window ) {
    <[base.log]>->( 2, "graphical window initialization failed" );
    return { 'mode' => qw| false |, 'data' => 'window initialization failed' };
}

## Present window to user
$window->present;
$window->set_keep_below(0) if <protocol-7-menu.cfg.raise_on_request>;

<[base.log]>->( 1, "graphical menu shown" );

return { 'mode' => qw| true |, 'data' => 'graphical menu displayed' };

