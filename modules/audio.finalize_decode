## [:< ##

# name  = audio.finalize_decode
# descr = finish decode : render pcm to png and reply to deferred caller
# param = $decode_id

my $id = shift // '';

my $state = delete <audio.decode>->{$id};
return unless defined $state and defined $state->{'reply_id'};

## cancel leftover watchers + timeout, terminate decode process group ##
eval { $state->{'w_err'}->cancel } if defined $state->{'w_err'};
eval { $state->{'timer'}->cancel } if defined $state->{'timer'};
kill( 9, -( $state->{'pid'} ) ) if $state->{'pid'};

my $reply;
my $pcm_bin = $state->{'pcm'} // '';

if ( length $pcm_bin < <audio.cfg.fft_size> * 4 ) {
    my $err = $state->{'stderr'} // '';
    $err =~ s|\s+$||;
    $err   = substr( $err, -200 ) if length $err > 200;
    $reply = {
        'mode' => qw| false |,
        'data' => sprintf( 'decode produced no pcm : %s',
            length $err ? $err : 'empty stream' )
    };
} else {
    my @pcm = unpack( 'f<*', $pcm_bin );

    ## output path chosen internally, never caller-controlled ##
    my $out_dir = <audio.cfg.output_dir>;
    $out_dir =~ s|/+$||;
    if ( not -d $out_dir ) {
        <[file.make_path]>->($out_dir);
    }
    chmod( 0775, $out_dir );    ## screenshot zenka precedent : 775/664 ##
    my $stamp    = <[base.ntime.b32]>->( 5, TRUE );
    my $out_path = sprintf '%s/spatial-%s.png', $out_dir, $stamp;

    ## style dispatch : render_style selects which versioned renderer to  ##
    ## call, so future divergent styles can coexist rather than overwrite ##
    ## this one -- see audio.render_standing_wave.v1's own header         ##
    my $style      = <audio.cfg.render_style>;
    my $render_sub = "audio.render_standing_wave.$style";

    my ( $ok, $result, $stats );
    if ( not exists $code{$render_sub} ) {
        ( $ok, $result )
            = ( FALSE, sprintf 'unknown render_style : %s', $style );
    } else {
        ( $ok, $result, $stats ) = $code{$render_sub}->(
            \@pcm,
            <audio.cfg.sample_rate>,
            $out_path,
            {   'size'     => <audio.cfg.image_size>,
                'fft_size' => <audio.cfg.fft_size>
            }
        );
    }

    ## post-process dispatch : orthogonal to render_style, applied in place ##
    ## on the file the render_sub already wrote -- see                      ##
    ## audio.post_process.rotation_stack.v1's own header                    ##
    if (    $ok
        and length <audio.cfg.post_process>
        and <audio.cfg.post_process> ne 'none' ) {
        my $pp_sub = "audio.post_process." . <audio.cfg.post_process>;
        if ( exists $code{$pp_sub} ) {
            my ( $pp_ok, $pp_result ) = $code{$pp_sub}->($result);
            if ( not $pp_ok ) {
                <[base.logs]>->( 0, 'post-process failed : %s', $pp_result );
            }
        } else {
            <[base.logs]>->( 0, 'unknown post_process : %s', $pp_sub );
        }
    }

    if ($ok) {
        chmod( 0664, $result );
        <[base.logs]>->(
            2,       'standing-wave render : %s [ %.1f%% lit, %d samples ]',
            $result, 100 * ( $stats->{'lit_ratio'} // 0 ),
            scalar @pcm
        );
        $reply = { 'mode' => qw| true |, 'data' => $result };
    } else {
        <[base.logs]>->( 0, 'standing-wave render failed : %s', $result );
        $reply = { 'mode' => qw| false |, 'data' => $result };
    }
}

<[base.callback.cmd_reply]>->( $state->{'reply_id'}, $reply );

return TRUE;

