# name  = pager.util.buffer.load_page_items
# descr = load items for a specific page number from source

my ( $buf, $page_num ) = @ARG;

my $page_size = $buf->{'pages'}{'size'};
my $start_idx = $page_num * $page_size;
my $source    = $buf->{'source'};

my @items;

## source supports random access ##
if ( $source->{'get_item_at'} ) {
    for my $i ( 0 .. $page_size - 1 ) {
        my $item = $source->{'get_item_at'}->( $start_idx + $i );
        last unless $item;
        push @items, $item;
    }
    return \@items;
}

## otherwise, batch through source ##
## inefficient for high page numbers but necessary for streaming sources ##
my $current_batch = 0;
my $target_batch  = int( $start_idx / $page_size );

while ( $current_batch <= $target_batch ) {
    my $batch = $source->{'next_batch'}->();
    last unless $batch && @$batch;

    if ( $current_batch == $target_batch ) {
        my $offset_in_batch = $start_idx % $page_size;
        @items = @$batch[ $offset_in_batch .. $#$batch ];
        @items = @items[ 0 .. $page_size - 1 ] if @items > $page_size;
    }

    $current_batch++;
}

return \@items;

