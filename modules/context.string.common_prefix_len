# name  = context.string.common_prefix_len
# descr = find common prefix length between two strings

my $params = shift // {};

my $a = $params->{'a'} // '';
my $b = $params->{'b'} // '';

my $len = 0;
my $max = length $a < length $b ? length $a : length $b;

while ( $len < $max and substr( $a, $len, 1 ) eq substr( $b, $len, 1 ) ) {
    $len++;
}

return $len;

