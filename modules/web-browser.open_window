## [:< ##

# name  = web-browser.open_window

$ENV{'DISPLAY'} = <x11.display>;
$ENV{'GDK_BACKEND'}
    = 'x11';    ## force XWayland — deiconify blocked on native Wayland ##
delete $ENV{'WAYLAND_DISPLAY'};

my ( $size_x, $size_y, $pos_x, $pos_y )
    = ( $1, $2, sprintf( qw| %.0f |, $4 ), sprintf( qw| %.0f |, $5 ) )
    if defined <web-browser.geometry>
    and <web-browser.geometry> =~ m|^(\d+)x(\d+)(([\-\+]\d+)([\-\+]\d+))?$|;

<web-browser.window.pos>  = { 'x' => $pos_x,  'y' => $pos_y };
<web-browser.window.size> = { 'x' => $size_x, 'y' => $size_y };

## window profile fallback when tile had no geometry (used screen size) ##
if (<x11.geometry_was_undefined>) {
    my $profile = <web-browser.window.profile> // 'automatic';
    $profile = <web-browser.window.profile-fallback> // 'fullscreen'
        if $profile eq 'automatic';
    ## x11.geometry set before Gtk3->init : parse it directly ##
    my ( $sw, $sh )
        = ( <x11.geometry> // '1920x1080+0+0' ) =~ m|^(\d+)x(\d+)|;
    my $geo = <[window.profile.calculate]>->(
        {   profile  => $profile,
            screen_w => $sw // 1920,
            screen_h => $sh // 1080,
        }
    );
    ( $size_x, $size_y, $pos_x, $pos_y )
        = @{$geo}{qw| width height x y |};
    <web-browser.window.pos>  = { 'x' => $pos_x,  'y' => $pos_y };
    <web-browser.window.size> = { 'x' => $size_x, 'y' => $size_y };
}

Gtk3->init;

<[base.log]>->( 1, 'window initializaion .,' );

my $window = Gtk3::Window->new('toplevel');

$window->set_icon_from_file(<web-browser.path.icon-file>);
$window->set_title(<web-browser.window.title_str>);

<web-browser.gtk_obj.window> = $window;
if ( length( <web-browser.cfg.cursor_image> // '' ) ) {
    ## custom pixbuf cursor -- covers the window-level default shown before ##
    ## WebKit's own per-element CSS cursor tracking takes over on the first ##
    ## mouse-move, and any native chrome outside page content               ##
    my $pixbuf = eval {
        Gtk3::Gdk::Pixbuf->new_from_file(<web-browser.cfg.cursor_image>);
    };
    if ( defined $pixbuf ) {
        my $hot_x = <web-browser.cfg.cursor_image_hot_x>
            // int( $pixbuf->get_width / 2 );
        my $hot_y = <web-browser.cfg.cursor_image_hot_y>
            // int( $pixbuf->get_height / 2 );
        my $cursor = Gtk3::Gdk::Cursor->new_from_pixbuf( $window->get_display,
            $pixbuf, $hot_x, $hot_y );
        $window->get_root_window->set_cursor($cursor);
    } else {
        <[base.logs]>->(
            0,
            'cursor_image load failed [%s] : %s',
            <web-browser.cfg.cursor_image>,
            <[base.str.eval_error]>
        );
    }
} elsif ( defined <web-browser.cfg.change_cursor> ) {
    my $cursor = Gtk3::Gdk::Cursor->new(<web-browser.cfg.change_cursor>);
    $window->get_root_window->set_cursor($cursor);
}

$window->signal_connect( destroy => sub { Gtk3->main_quit() } );

$window->set_decorated(FALSE)
    if <[base.cfg_bool]>->(<web-browser.cfg.no_decorations>);

## pre-set window background to page color -- prevents white flash on ##
## startup                                                            ##
my $bg = <web-browser.bg_color> // '';
if ( length $bg ) {
    $bg =~ s{^#?}{#};
    my $css_bg = Gtk3::CssProvider->new;
    $css_bg->load_from_data("window { background-color: $bg; }");
    $window->get_style_context->add_provider( $css_bg,
        Gtk3::STYLE_PROVIDER_PRIORITY_APPLICATION );
}

# my $atom_id = Gtk3::Gdk->atom_intern_static_string('WM_CLASS'); # <-- set

## restore saved window position if available and enabled
my $wb_caller = <system.zenka.name> // '';
if ( length $wb_caller
    and <[base.cfg_bool]>->(<web-browser.restore_last_position>) ) {
    my $saved = <[window.profile.load]>->($wb_caller);
    if (    defined $saved
        and ref($saved) eq qw| HASH |
        and defined $saved->{'x'}
        and defined $saved->{'y'}
        and defined $saved->{'width'}
        and defined $saved->{'height'} ) {
        ( $pos_x, $pos_y, $size_x, $size_y )
            = @{$saved}{qw| x y width height |};

        ## skip position restore if saved coords are entirely off the       ##
        ## current virtual screen — stale from a different monitor layout.  ##
        ## weston cannot move windows across compositor outputs via x11     ##
        ## configurerequest, so there is no reliable programmatic recovery. ##
        ## fall back to default geometry and let the user reposition via    ##
        ## the window-place overlay (alt+.) once the window is visible.     ##
        my ( $sw, $sh )
            = ( <x11.geometry> // '1920x1080' ) =~ m|^(\d+)x(\d+)|;
        $sw //= 1920;
        $sh //= 1080;
        if ( $pos_x >= $sw or $pos_y >= $sh ) {
            <[base.logs]>->(
                1,
                '[startup] saved position [%dx%d+%d+%d] is '
                    . 'off-screen [screen:%dx%d] — using default geometry',
                $size_x,
                $size_y,
                $pos_x,
                $pos_y,
                $sw,
                $sh
            );
            ( $pos_x, $pos_y, $size_x, $size_y )
                = ( undef, undef, undef, undef );
        }

        <web-browser.window.pos>  = { 'x' => $pos_x,  'y' => $pos_y };
        <web-browser.window.size> = { 'x' => $size_x, 'y' => $size_y };
        <[base.logs]>->(
            2, '[startup] restoring saved position [%dx%d+%d+%d]',
            $size_x, $size_y, $pos_x, $pos_y
        ) if defined $pos_x;
    }
}

$window->move( $pos_x, $pos_y ) if defined $pos_x and defined $pos_y;

$window->set_default_size( $size_x, $size_y )
    if defined $size_x and defined $size_y;

my $overlay = Gtk3::Overlay->new();
<web-browser.gtk_obj.overlay> = $overlay;

<web-browser.gtk_obj.css_prov> = Gtk3::CssProvider->new();
<web-browser.gtk_obj.css_prov>->load_from_data(<<'EOT');
*undershoot.top, *undershoot.right, *undershoot.bottom, *undershoot.left {
    background-image: none;
}
EOT

# web context setup #

my $web_context;
if (<web-browser.cfg.ephemeral>) {
    my $data_manager = Gtk3::WebKit2::WebsiteDataManager->new_ephemeral;
    $web_context = Gtk3::WebKit2::WebContext->new_with_website_data_manager(
        $data_manager);
} else {
    $web_context = Gtk3::WebKit2::WebContext->new;
}

my $proc_model = 'WEBKIT_PROCESS_MODEL_MULTIPLE_SECONDARY_PROCESSES';
$web_context->set_process_model($proc_model);

if (<web-browser.cfg.no_memory_cache>) {

    $web_context->set_cache_model('WEBKIT_CACHE_MODEL_DOCUMENT_VIEWER');
    <[base.log]>->( 1, ': deactivating in-memory cache.,' );
} else {

    <[base.log]>->( 1, ': moderate caching enabled.,' );
    $web_context->set_cache_model('WEBKIT_CACHE_MODEL_DOCUMENT_BROWSER');

    # LLL: deal with cache size \ auto-clear..,
    # $web_context->set_cache_model('WEBKIT_CACHE_MODEL_WEB_BROWSER');

}

<web-browser.gtk_obj.web_context> = $web_context;

## local self-signed services [ e.g. Nessus's own web UI before a real cert ##
## is configured ] are rejected by default -- opt-in only, never the        ##
## default, since this disables TLS validation entirely.                    ##
$web_context->set_tls_errors_policy('WEBKIT_TLS_ERRORS_POLICY_IGNORE')
    if ( <web-browser.cfg.ignore_tls_errors> // qw| no | ) eq qw| yes |;

# will use initialized web context
foreach my $view (qw|  1  2  |) {
    <[web-browser.init_view]>->($view);
}

<web-browser.gtk_obj.overlay>
    ->reorder_overlay( <web-browser.gtk_obj.scrolled_window>->{2}, 0 );

<web-browser.overlay.index> = { 'fg' => 1, 'bg' => 2 };

$window->signal_connect( 'size_allocate',
    $code{'web-browser.handler.size_allocate'} );

$window->add($overlay);

if ( <system.zenka.mode> eq qw| universal-child | ) {
    <[base.log]>->(
        1,
        "<<< setting slideshow.autostart = 1 [ 'universal-child' mode ] >>>"
    ) if !( <web-browser.slideshow.autostart> //= 0 );
    ## <-- auto-enable slideshow mode ##
    <web-browser.slideshow.autostart> = 5;    ## true ##
    $window->iconify();
} else {
    ## hide during page load without iconifying (deiconify is blocked under ##
    ## WSLg)                                                                ##
    if ( $window->is_composited ) {
        $window->set_opacity(0);
        <web-browser.start-up.opacity_hidden> = TRUE;
    }

    ## raise window when ready ##  .. background color properly set .,  ##
    <web-browser.start-up.raise_delay> //= 0.13747;
    <[web-browser.js_call]>->(
        'document.readyState',
        sub {
            <[event.add_timer]>->(
                {   'after'   => <web-browser.start-up.raise_delay>,
                    'handler' => 'web-browser.start-up.raise_window'
                }
            );
        }
    );
}

## use 'map' signal : fires after window is actually mapped, no race ##
## condition                                                         ##
$window->signal_connect(
    'map' => sub {
        <[web-browser.wait_for_window]>;

        # handle previous segfaults [ should there have been any ]
        <[web-browser.process_crash_mitigation]>;

        if (<web-browser.slideshow.autostart>) {
            <[base.log]>->( 1, ':: slideshow autostart is enabled ::' );
            <[web-browser.get_url_list]>;
        }
        return FALSE;
    }
);

$window->show_all;

## debounced position+size save on move or resize
$window->signal_connect(
    'configure-event' => sub {
        my ( $widget, $event ) = @_;
        <web-browser.pos_save.geo> = {
            'x'      => $event->x,
            'y'      => $event->y,
            'width'  => $event->width,
            'height' => $event->height
        };
        eval { <web-browser.pos_save.timer>->cancel }
            if defined <web-browser.pos_save.timer>;
        <web-browser.pos_save.timer> = <[event.add_timer]>->(
            {   'after' => 0.7,
                'cb'    => sub {
                    <web-browser.pos_save.timer> = undef;
                    my $geo = <web-browser.pos_save.geo> // return;
                    return if not length $wb_caller;
                    ## skip save if window is entirely off the virtual    ##
                    ## screen — prevents perpetuating stale multi-monitor ##
                    ## positions                                          ##
                    do {
                        my ( $ssw, $ssh )
                            = ( <x11.geometry> // '1920x1080' )
                            =~ m|^(\d+)x(\d+)|;
                        if ( defined $ssh ) {
                            my ( $gx, $gy )
                                = @{$geo}{qw| x y |};
                            return
                                   if ( $gx // 0 ) >= $ssw
                                or ( $gy    // 0 ) >= $ssh
                                or ( $gx    // 0 ) + ( $geo->{'width'} // 0 )
                                <= 0
                                or ( $gy // 0 ) + ( $geo->{'height'} // 0 )
                                <= 0;
                        }
                    };
                    <[window.profile.save]>->(
                        $wb_caller,      $geo->{'x'}, $geo->{'y'},
                        $geo->{'width'}, $geo->{'height'}
                    );
                    <[base.logs]>->(
                        2,
                        '[position] saved [caller=%s] x=%d y=%d w=%d h=%d',
                        $wb_caller,
                        $geo->{'x'},
                        $geo->{'y'},
                        $geo->{'width'},
                        $geo->{'height'}
                    );
                }
            }
        );
        return FALSE;
    }
);

$window->add_events( ['key-press-mask'] );
$window->signal_connect(
    'key-press-event' => $code{'web-browser.handler.key_press'} );

##  register signal handlers  ##
##
foreach my $signal_name (qw|  INT  TERM  |) {

    <base.watcher.signal>->{$signal_name} = <[event.add_signal]>->(
        {   'signal'  => $signal_name,
            'handler' => qw| web-browser.handler.sig_term |
        }
    );
}

