# name = v7.callback.get_x11_display

<[base.log]>->( 1, "requesting x11.display from X-11 zenka.," );

<[base.zenki.resolve_primary_sid]>->(
    'X-11',
    sub {
        my $sid = shift;
        if ( not defined $sid ) {
            <[base.logs]>->( 1, '[get_x11_display] no X-11 instance online' );
            return;
        }
        <[protocol-7.route-send]>->(
            {   'command' => "$sid.get_display",
                'reply' => { 'handler' => qw| v7.handler.get_display_reply | }
            }
        );
    }
);

