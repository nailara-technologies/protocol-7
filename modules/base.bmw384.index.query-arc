## [:< ##

# name  = base.bmw384.index.query-arc
# args  = $arc
# descr = return all nodes in given arc segment sorted by color ascending

my $arc = shift;

return undef
    if not defined $arc
    or not defined <bmw384.index>;

my @names = @{ <bmw384.index>->{'by_arc'}{$arc} // [] };

my @result;
for my $ARG (@names) {
    my $coord = <bmw384.index>->{'by_name'}{$ARG};
    next if not defined $coord;
    push @result, { qw| name | => $ARG, qw| coord | => $coord };
}

return [ sort { $a->{'coord'}{'color'} <=> $b->{'coord'}{'color'} } @result ];

