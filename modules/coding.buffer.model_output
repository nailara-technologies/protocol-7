## [:< ##

# name  = coding.buffer.model_output
# descr = log model output to observation buffer

my $content = shift // '';
my $context = shift // {};

return FALSE unless length $content;

my $buffer_name = 'model_output';

##  add timestamp and round info  ##
my $round = $context->{'round'} // '?';
my $tool  = $context->{'tool'}  // 'none';

my $prefix = sprintf( '[R%s|%s]', $round, $tool );

##  truncate if too long  ##
my $max_line = 200;
if ( length $content > $max_line ) {
    $content = substr( $content, 0, $max_line ) . '...';
}

##  clean newlines  ##
$content =~ s|\n| / |g;
$content =~ s|\r||g;

##  add to buffer  ##
<[base.buffer.add_line]>->( $buffer_name, "$prefix $content" );

return TRUE;

