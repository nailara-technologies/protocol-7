## [:< ##

# name  = decoder.cmd.show-vterm
# descr = dump current vterm 25×80 screen content

return { 'mode' => qw| false |, 'data' => 'vterm not initialized' }
    unless defined $data{'decoder'}{'vterm'};

my $screen = $data{'decoder'}{'vterm_screen'};

return { 'mode' => qw| false |, 'data' => 'vterm screen not available' }
    unless defined $screen;

## read full 25×80 surface via get_text ##
my $rect = Term::VTerm::Rect->new(
    start_row => 0,
    end_row   => 25,
    start_col => 0,
    end_col   => 80,
);

my $text = $screen->get_text($rect);

## annotate with row numbers for readability ##
my @rows    = split /\n/, $text, -1;
my @display = map {
    sprintf( "%02d| %s", $ARG, $rows[$ARG] // '' )
} ( 0 .. 24 );

return {
    'mode' => qw| true |,
    'data' => join( "\n", @display ),
};

