## [:< ##

# name  = valued.cmd.list
# descr = list valued tree nodes sorted by effective priority

my @ids = keys %{<valued.index>};

return { 'mode' => 'size', 'data' => 'no nodes' } unless @ids;

## resolve priority for each node ##
my %priority;
foreach my $id (@ids) {
    $priority{$id} = <[valued.resolve]>->($id) // 0.0;
}

my @sorted = sort { $priority{$b} <=> $priority{$a} } @ids;

my $output = join "\n", map {
    my $node = <valued.index>->{$ARG};
    sprintf '%.2f  %-28s  refs=%-3d weight=%.3f',
        $priority{$ARG},
        $ARG,
        $node->{'refs'}   // 0,
        $node->{'weight'} // 0.0
} @sorted;

return { 'mode' => 'size', 'data' => $output };

