## [:< ##

# name  = mpv.cmd.prev
# descr = select previous file from playlist

push( @{<mpv.reply_ids>}, $$call{'reply_id'} );

<mpv.success_reply_str> = 'playlist previous entry';

<[mpv.send_command]>->('playlist_prev');

return { 'mode' => 'deferred' };

