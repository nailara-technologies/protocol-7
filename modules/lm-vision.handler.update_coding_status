## [:< ##

# name  = lm-vision.handler.update_coding_status
# descr = poll coding zenka for inference server status and cache locally

my $reply = shift;
my $data  = $reply->{'data'} // '';

<[base.logs]>->(
    3, '[update_coding_status] received %d bytes from coding',
    length($data)
);

if ( $data =~ m|^error:| ) {
    <[base.logs]>->(
        2, '[update_coding_status] coding zenka error: %s', $data
    );
    return;
}

use YAML::XS qw| Load |;
my $status;
eval { $status = Load($data) };
if ( $EVAL_ERROR || !ref($status) ) {
    <[base.logs]>->(
        2,
        '[update_coding_status] failed to parse status YAML: %s',
        $EVAL_ERROR // 'no data'
    );
    return;
}

<lm-vision.cached_coding_status> = $status;

my $gpu_status = $status->{'gpu'}{'status'} // 'unknown';
my $interval   = <lm-vision.poll_interval>  // 5.0;

if ( $gpu_status eq qw| ready | ) {
    $interval = 5.0;    ## reset to base when server is ready ##
} else {
    $interval = sprintf( '%.2f', $interval * 1.2 );
    $interval = sprintf( '%.1f', $interval ) if $interval > 10;
    $interval = sprintf( '%.0f', $interval ) if $interval > 20;
    $interval = 60.0 if $interval > 60.0;
}
<lm-vision.poll_interval> = $interval;

<[base.logs]>->(
    3,
    '[update_coding_status] cached: gpu=%s port=%d mmproj=%s next_poll=%ss',
    $gpu_status,
    $status->{'gpu'}{'port'} // 0,
    length( $status->{'gpu'}{'mmproj_path'} // '' ) ? 'yes' : 'no',
    $interval
);

## pause polling when server is ready [ first successful reply or http success ] ##
if ( $gpu_status eq qw| ready | ) {
    <lm-vision.poll_paused> = 1;
    my $old_timer = <lm-vision.poll_timer>;
    $old_timer->cancel() if defined $old_timer && $old_timer->is_active();

    ## process any pending vision requests queued while server was starting ##
    my $pending = <lm-vision.pending_requests> // [];
    if (@$pending) {
        <[base.logs]>->(
            1, '[update_coding_status] processing %d queued vision requests',
            scalar(@$pending)
        );
        foreach my $req (@$pending) {
            next if <[base.time]>->(3) - $req->{'queued_at'} > 300;
            <[lm-vision.cmd.analyze_image]>->(
                {   'args' => $req->{'image_path'} . ' ' . $req->{'prompt'},
                    'reply_id' => $req->{'reply_id'}
                }
            );
        }
        <lm-vision.pending_requests> = [];
    }

    <[base.logs]>->(
        3, '[update_coding_status] polling paused [ gpu ready ]'
    );
    return;
}

## server not ready: keep polling with backoff ##
<lm-vision.poll_paused> = 0;
my $old_timer = <lm-vision.poll_timer>;
$old_timer->cancel() if defined $old_timer && $old_timer->is_active();
<lm-vision.poll_timer> = <[event.add_timer]>->(
    {   'after'   => $interval,
        'handler' => 'lm-vision.handler.poll_coding_status',
        'desc'    => 'poll coding zenka inference server status'
    }
);

return;

