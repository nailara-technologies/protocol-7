# name  = plugin.storage.util.resolve_all_p7refs
# descr = Resolve all P7REF members to actual checksums

my ( $members, $registry ) = @ARG;

my @resolved;

for my $member (@$members) {
    if ( $member =~ m|^p7://checksum-cluster:([^\]]+)| ) {

        # It's a cluster reference - expand it
        my $sub_cluster_id = $1;
        $registry->{'stats'}{'p7refs_resolved'}++;

        if ( exists $registry->{'clusters'}{$sub_cluster_id} ) {
            push @resolved,
                @{ $registry->{'clusters'}{$sub_cluster_id}{'members'} };
        } else {

            # P7REF points outside - use storage.p7ref.resolve
            my $resolved = <[plugin.storage.p7ref.resolve]>
                ->( { 'p7ref' => $member, } );
            push @resolved, $resolved if $resolved;
        }
    } else {
        push @resolved, $member;
    }
}

return \@resolved;

