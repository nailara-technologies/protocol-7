# name  = plan-9.server.handle_request
# descr = Dispatch 9P protocol requests

use strict;
use warnings;

return sub {
    my ( $client, $fd, $type, $tag, $data ) = @_;

    my $Tversion = <plan-9.protocol.constants.Tversion>;
    my $Tattach  = <plan-9.protocol.constants.Tattach>;
    my $Twalk    = <plan-9.protocol.constants.Twalk>;
    my $Topen    = <plan-9.protocol.constants.Topen>;
    my $Tread    = <plan-9.protocol.constants.Tread>;
    my $Twrite   = <plan-9.protocol.constants.Twrite>;
    my $Tclunk   = <plan-9.protocol.constants.Tclunk>;
    my $Tstat    = <plan-9.protocol.constants.Tstat>;

    if ( $type == $Tversion ) {
        return <[plan-9.server.handle_version]>->( $client, $tag, $data );
    } elsif ( $type == $Tattach ) {
        return <[plan-9.server.handle_attach]>->( $client, $tag, $data );
    } elsif ( $type == $Twalk ) {
        return <[plan-9.server.handle_walk]>->( $client, $tag, $data );
    } elsif ( $type == $Topen ) {
        return <[plan-9.server.handle-io-open]>->( $client, $tag, $data );
    } elsif ( $type == $Tread ) {
        return <[plan-9.server.handle-io-read]>->( $client, $tag, $data );
    } elsif ( $type == $Twrite ) {
        return <[plan-9.server.handle-io-write]>->( $client, $tag, $data );
    } elsif ( $type == $Tclunk ) {
        return <[plan-9.server.handle-io-clunk]>->( $client, $tag, $data );
    } elsif ( $type == $Tstat ) {
        return <[plan-9.server.handle-io-stat]>->( $client, $tag, $data );
    } else {
        return
            <[plan-9.protocol.error]>
            ->( $tag, "unknown message type: $type" );
    }
};

