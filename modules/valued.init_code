## [:< ##

# name  = valued.init_code
# descr = initialize valued tree subsystem — N+f composite node storage

## valued tree nodes live under $data{'valued'} ##
## each node: { refs => N, weight => f, parents => [], children => [] } ##

$data{'valued'}    //= {};
<valued.index>     //= {};  ## id → node href ##
<valued.ref-graph> //= {};  ## id → [ ids that reference it ] ##
<valued.deferred>  //= {};  ## parent_id → [ node defs waiting for parent ] ##

<[base.logs]>->( 0, ':. valued tree subsystem initialized' );

<[valued.tree.load]>;

