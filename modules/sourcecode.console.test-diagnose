## [:< ##

# name  = sourcecode.console.test-diagnose
# descr = test cycle without restoration - diagnose oscillation with temp key

my $command_params = shift // '';

$command_params =~ s,^ *| *$,,;

unless ( length $command_params ) {
    say ': usage: sourcecode test-diagnose <file-pattern>';
    say ': example: sourcecode test-diagnose '
        . 'cfg/zenki/debian/zenka-startup.v7';
    say ': note: DOES NOT RESTORE - leaves files with temp key signatures';
    return;
}

say ':';
say ': .:[ TEST DIAGNOSE: SIGN AND VERIFY (NO RESTORE) ]:.::';
say ':';

my $sig_key_name  = qw| proto-7.sourcecode |;
my $test_key_name = qw| test-proto7-sourcecode |;

# Load unencrypted test key
say ': Loading test key...';
unless (
    <[crypt.C25519.load_keypair]>->( $test_key_name, undef, FALSE, FALSE ) ) {
    say ': ERROR: Failed to load test key. Create it first with:';
    say ': ./bin/Protocol-7 keys create -U test-proto7-sourcecode';
    return;
}

say sprintf( ': Loaded test key: %s', $test_key_name );
say ':';

my @source_paths = <[base.source.collect_file_list]>->($command_params);

unless (@source_paths) {
    printf( ": no files found for pattern: %s\n", $command_params );
    return;
}

say sprintf( ': Found %d files', scalar(@source_paths) );
say ':';

# Replace signature key with test key
$keys{'C25519'}{$sig_key_name} = $keys{'C25519'}{$test_key_name};

say sprintf( ': Signature key set to %s', $test_key_name );
say ':';

# CYCLE 1: Update signatures
say ': .:[ CYCLE 1: UPDATING SIGNATURES ]:.::';
say ':';

my $update_count = 0;
foreach my $path_rel (@source_paths) {
    next unless -f $path_rel;

    my $code_data_ref;
    eval {
        use warnings FATAL => qw| all |;
        $code_data_ref = <[source.cmd.get-code-signed]>->(
            {   qw| args |       => $path_rel,
                qw| skip-valid | => TRUE,
                qw| verbosity |  => 0
            }
        );
    };

    if (    defined $code_data_ref
        and ref $code_data_ref eq qw| HASH |
        and $code_data_ref->{'mode'} ne qw| false |
        and not($code_data_ref->{'mode'} eq qw| true |
            and $code_data_ref->{'data'} eq 'still valid. =)' )
    ) {
        if ( <[file.put_bin]>->( $path_rel, $code_data_ref->{'data'} ) ) {
            printf( ": [SIGNED] %s\n", ( split '/', $path_rel )[-1] );
            $update_count++;
        }
    }
}

say ':';
printf( ': Updated %d files', $update_count );
say ':';

# CYCLE 1: Verify signatures
say ': .:[ CYCLE 1: VERIFYING SIGNATURES ]:.::';
say ':';

my $cycle1_results = {};
my $valid_count    = 0;
my $invalid_count  = 0;

foreach my $file_path (@source_paths) {
    next unless -f $file_path;

    <[file.slurp]>->( $file_path, \my $src_str, qw| :raw | );
    my $footer_data = <[source.extract_sig_body]>->( \$src_str, qw| strip | );

    if ( $footer_data->{'was-present'} ) {
        my $state = $footer_data->{'endline-state-encoded'} // '?';
        my $bmw   = $footer_data->{'bmw-chksum'}            // 'ERROR';
        my $sig   = $footer_data->{'signature'}             // 'ERROR';

        my $bmw_short = <[base.parser.ellipse_center]>->( $bmw, 21 );
        my $sig_short = <[base.parser.ellipse_center]>->( $sig, 21 );

        my $file_name = ( split '/', $file_path )[-1];
        $cycle1_results->{$file_name}
            = { state => $state, bmw => $bmw_short, sig => $sig_short };

        printf( ': %-30s state=%d bmw=%s sig=%s' . "\n",
            $file_name, $state, $bmw_short, $sig_short );

        my ( $is_valid, $report_ref )
            = <[source.signature_valid]>->( \$src_str, $footer_data );
        if ($is_valid) {
            $valid_count++;
        } else {
            $invalid_count++;
            say sprintf(':  ^ INVALID');
        }
    }
}

say ':';
printf( ': Results: %d valid, %d invalid', $valid_count, $invalid_count );
say ':';

# CYCLE 2: Update signatures again (with files already signed with temp key)
say ': .:[ CYCLE 2: UPDATING SIGNATURES ]:.::';
say ':';

$update_count = 0;
foreach my $path_rel (@source_paths) {
    next unless -f $path_rel;

    my $code_data_ref;
    eval {
        use warnings FATAL => qw| all |;
        $code_data_ref = <[source.cmd.get-code-signed]>->(
            {   qw| args |       => $path_rel,
                qw| skip-valid | => TRUE,
                qw| verbosity |  => 0
            }
        );
    };

    if (    defined $code_data_ref
        and ref $code_data_ref eq qw| HASH |
        and $code_data_ref->{'mode'} ne qw| false |
        and not($code_data_ref->{'mode'} eq qw| true |
            and $code_data_ref->{'data'} eq 'still valid. =)' )
    ) {
        if ( <[file.put_bin]>->( $path_rel, $code_data_ref->{'data'} ) ) {
            printf( ": [SIGNED] %s\n", ( split '/', $path_rel )[-1] );
            $update_count++;
        }
    }
}

say ':';
printf( ': Updated %d files (oscillation if > 0)', $update_count );
say ':';

# CYCLE 2: Verify signatures
say ': .:[ CYCLE 2: VERIFYING SIGNATURES ]:.::';
say ':';

$valid_count   = 0;
$invalid_count = 0;

foreach my $file_path (@source_paths) {
    next unless -f $file_path;

    <[file.slurp]>->( $file_path, \my $src_str, qw| :raw | );
    my $footer_data = <[source.extract_sig_body]>->( \$src_str, qw| strip | );

    if ( $footer_data->{'was-present'} ) {
        my $state = $footer_data->{'endline-state-encoded'} // '?';
        my $bmw   = $footer_data->{'bmw-chksum'}            // 'ERROR';
        my $sig   = $footer_data->{'signature'}             // 'ERROR';

        my $bmw_short = <[base.parser.ellipse_center]>->( $bmw, 21 );
        my $sig_short = <[base.parser.ellipse_center]>->( $sig, 21 );

        my $file_name  = ( split '/', $file_path )[-1];
        my $oscillated = 0;
        if (   $cycle1_results->{$file_name}{'bmw'} ne $bmw_short
            or $cycle1_results->{$file_name}{'sig'} ne $sig_short ) {
            $oscillated = 1;
        }

        printf( ': %-30s state=%d bmw=%s sig=%s%s' . "\n",
            $file_name, $state, $bmw_short, $sig_short,
            $oscillated ? ' [OSCILLATED]' : '' );

        my ( $is_valid, $report_ref )
            = <[source.signature_valid]>->( \$src_str, $footer_data );
        if ($is_valid) {
            $valid_count++;
        } else {
            $invalid_count++;
            say sprintf(':  ^ INVALID');
        }
    }
}

say ':';
printf( ': Results: %d valid, %d invalid', $valid_count, $invalid_count );
say ':';

0;

