## [:< ##

# name  = window.place.startup.geo_ready
# descr = continuation after window-place's own geometry resolves --
#         nothing further to do at startup, windows are opened on-demand
#         via the place_window command

<[base.logs]>->(
    2, 'window-place startup complete [ geometry: %s ]',
    <x11.geometry>
);

