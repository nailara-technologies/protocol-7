## [:< ##

# name  = workflow.console.version-sign-commit
# param = [commit-message]
# descr = update version, sign with appropriate key, commit, and push

my $message = shift // '';
my $no_push = 0;

# Check for --no-push flag
if ($message eq '--no-push') {
    $no_push = 1;
    $message = '';
}

say '';
say ' .:[ WORKFLOW: VERSION-SIGN-COMMIT-PUSH ]:.';
say '';

## Prompt for message if not provided
unless (length $message) {
    print ' : Commit message (or Enter for default): ';
    $message = <STDIN>;
    chomp $message if defined $message;
    $message //= '';
}

## Step 0: Update version
say ' .:[ STEP 0: UPDATE VERSION ]:.';
say '';

system('./bin/dev/update-version');
my $version_exit = $? >> 8;

if ($version_exit != 0) {
    say '';
    say sprintf ' : ✗ Version update failed (exit: %d)', $version_exit;
    say '';
    return 1;
}

say '';
say ' : ✓ Version updated';
say '';

## Detect signing mode based on key presence
my $sig_key_name = qw| proto-7.sourcecode |;
my $test_key_name = qw| test-proto7-sourcecode |;
my $use_production_key = 0;
my $use_test_key = 0;
my $key_mode = 'unknown';

# Check if production key is loaded
if ( exists $keys{'C25519'}{$sig_key_name} && defined $keys{'C25519'}{$sig_key_name} ) {
    $use_production_key = 1;
    $key_mode = 'production';
    say ' : ✓ Production key detected';
    say sprintf ' : Using key: %s', $sig_key_name;
    say '';
} else {
    # Production key not available - use test key mode
    $use_test_key = 1;
    $key_mode = 'test';
    say ' : Production key not loaded - using test key mode';

    # Check if test key exists
    unless ( exists $keys{'C25519'}{$test_key_name} && defined $keys{'C25519'}{$test_key_name} ) {
        say ' : Test key not found';

        # Check if crypt.C25519.gen_keys is available
        if ( exists $code{'crypt.C25519.gen_keys'} ) {
            say ' : Creating test key...';

            my ($new_key, $created_name) = <[crypt.C25519.gen_keys]>->( $test_key_name );

            unless ( defined $new_key ) {
                say ' : ⚠ WARNING: Failed to generate test key';
                say ' : Continuing without signature capability';
                say '';
                say ' : ✓ Task completed (no signatures applied)';
                say '';
                return 0;  # Return success anyway
            }

            say sprintf ' : ✓ Created test key: %s', $test_key_name;
        } else {
            say ' : ⚠ WARNING: crypt.C25519 module not loaded';
            say ' : Cannot generate or use signing keys';
            say ' : Continuing without signature capability';
            say '';
            say ' : ✓ Task completed (no signatures applied)';
            say '';
            return 0;  # Return success - workflow completed even without signing
        }
    } else {
        say sprintf ' : ✓ Test key loaded: %s', $test_key_name;
    }
    say '';
}

## Step 1: Update signatures with appropriate key
say ' .:[ STEP 1: UPDATING SIGNATURES ]:.';
say '';

if ( $use_test_key ) {
    # Backup original key and use test key
    my $original_key = $keys{'C25519'}{$sig_key_name};
    $keys{'C25519'}{$sig_key_name} = $keys{'C25519'}{$test_key_name};

    system('./bin/Protocol-7', 'sourcecode', 'update-signatures');
    my $sign_exit = $? >> 8;

    # Restore original key
    $keys{'C25519'}{$sig_key_name} = $original_key if defined $original_key;

    if ( $sign_exit != 0 ) {
        say '';
        say sprintf ' : ✗ Signature update failed (exit: %d)', $sign_exit;
        say '';
        return 1;
    }
} else {
    # Use production key directly
    system('./bin/Protocol-7', 'sourcecode', 'update-signatures');
    my $sign_exit = $? >> 8;

    if ( $sign_exit != 0 ) {
        say '';
        say sprintf ' : ✗ Signature update failed (exit: %d)', $sign_exit;
        say '';
        return 1;
    }
}

say '';
say ' : ✓ Signatures updated';
say '';

## Step 2: Git add all changes
say ' .:[ STEP 2: STAGING CHANGES ]:.';
say '';

system('git', 'add', '-A');
my $add_exit = $? >> 8;

if ( $add_exit != 0 ) {
    say ' : ✗ Failed to stage changes';
    say '';
    return 1;
}

# Show what will be committed
system('git', 'status', '--short');

say '';
say ' : ✓ Changes staged';
say '';

## Step 3: Commit with message
say ' .:[ STEP 3: COMMITTING ]:.';
say '';

my $commit_message = $message;
unless ( length $commit_message ) {
    # Generate default message
    $commit_message = "chore: Update signatures with $key_mode key";
}

# Add key mode context to commit message
$commit_message .= "\n\nSigned-by: $key_mode-key" if $use_test_key;

my $commit_cmd = sprintf(
    'git commit -m "%s"',
    $commit_message =~ s/"/\\"/gr
);

system($commit_cmd);
my $commit_exit = $? >> 8;

if ( $commit_exit != 0 ) {
    say ' : ✗ Commit failed';
    say '';
    return 1;
}

say '';
say ' : ✓ Changes committed';
say '';

## Step 4: Push to remote
unless ($no_push) {
    say ' .:[ STEP 4: PUSHING TO REMOTE ]:.';
    say '';

    # Get current branch
    my $branch = `git branch --show-current`;
    chomp $branch if defined $branch;

    unless (length $branch) {
        say ' : ⚠ WARNING: Could not determine current branch';
        say ' : Skipping push';
        say '';
    } else {
        say sprintf ' : Pushing branch: %s', $branch;
        say '';

        system('git', 'push', '-u', 'origin', $branch);
        my $push_exit = $? >> 8;

        if ($push_exit != 0) {
            say '';
            say sprintf ' : ✗ Push failed (exit: %d)', $push_exit;
            say ' : Note: Changes are committed locally';
            say '';
            return 1;
        }

        say '';
        say ' : ✓ Pushed to remote';
        say '';
    }
} else {
    say ' : [Skipped push - --no-push flag]';
    say '';
}

## Summary
say ' .:[ COMPLETE ]:.';
say '';
say sprintf ' : Key mode: %s', $key_mode;
say sprintf ' : Key used: %s', $use_test_key ? $test_key_name : $sig_key_name;
say sprintf ' : Commit message: %s', $commit_message;
say sprintf ' : Pushed: %s', $no_push ? 'no' : 'yes';
say '';

return 0;

