## [:< ##

# name  = coding.async.send_request
# descr = send next inference request after tool execution

use JSON::PP;

my ($task_id) = @ARG;

return { success => FALSE, error => 'task_id required' }
    unless defined $task_id;

## hold dispatch while backend is restarting after crash ##
if (<coding.task.queue_paused>) {
    <[base.logs]>->(
        1, 'send_request: queue paused : rescheduling %s in 5s', $task_id
    );
    my $state = <[coding.async.state_machine]>->( qw| get |, $task_id );
    my $round = $state->{'round'} // 0;
    <[event.add_timer]>->(
        {   'after'   => 5.0,
            'handler' => 'coding.task.enqueue_round',
            'params'  => { 'task_id' => $task_id, 'round' => $round }
        }
    );
    return { success => FALSE, error => 'queue_paused' };
}

## get state machine state ##
my $state = <[coding.async.state_machine]>->( qw| get |, $task_id );
return { success => FALSE, error => "no state for $task_id" }
    unless defined $state;

## compact context if approaching token limit ##
## returns 'pending' when inference compaction sub-task was spawned ##
my $compact_result = <[coding.async.compact_context]>->($task_id);
if ( defined $compact_result and $compact_result eq qw| pending | ) {
    <[base.logs]>->(
        1, "send_request: %s suspended for inference compaction", $task_id
    );
    return { success => TRUE, task_id => $task_id, compacting => 1 };
}

## messages already built by state_machine transition handler ##
## just use the accumulated conversation from state ##
my @messages = @{ $state->{'messages'} // [] };
## log message roles for debugging ##
my @roles = map { $ARG->{'role'} } @messages;
<[base.logs]>->(
    1,
    "send_request: task=%s round=%d messages=%d roles=[%s]",
    $task_id,
    $state->{'round'} // 0,
    scalar(@messages),
    join( ',', map { uc( substr( $ARG, 0, 1 ) ) } @roles )
);

## check for injected messages from coding.cmd.inject-message ##
my $task = <coding.task.queue>->{$task_id};
if (    defined $task
    and ref $task->{'injected_messages'} eq qw| ARRAY |
    and $task->{'injected_messages'}->@* ) {
    my @injected = $task->{'injected_messages'}->@*;
    $task->{'injected_messages'} = [];

    for my $im (@injected) {
        push @{ $state->{'messages'} },
            {
            'role'    => $im->{'role'}    // qw| user |,
            'content' => $im->{'content'} // ''
            };
    }

    <[base.logs]>->(
        1,
        "send_request: injected %d message(s) from external source",
        scalar @injected
    );
}

## refresh messages array after potential injection ##
@messages = @{ $state->{'messages'} // [] };

## check for stop request ##
if ( defined $task && $task->{'stop_requested'} ) {
    <[base.logs]>->(
        1, "send_request: stop requested for %s, completing", $task_id
    );
    delete $task->{'stop_requested'};  ## consume so task-append can resume ##
    <[coding.async.complete_task]>->($task_id);
    return { success => TRUE, stopped => TRUE };
}

## check for pause request ##
if ( defined $task && $task->{'pause_requested'} ) {
    <[base.logs]>->( 1, "send_request: pause requested for %s", $task_id );
    $task->{'pause_requested'} = FALSE;
    <[coding.async.state_machine]>->(
        'pause', $task_id,
        { 'reason' => 'user request', 'resume_event' => 'resume' }
    );
    return { success => TRUE, paused => TRUE };
}

## consume retry flag : if this was a retry, preserve retry_count ##
## if this is a fresh request, reset retry_count to 0 ##
my $is_retry = $state->{'retry_pending'} // FALSE;
if ($is_retry) {
    $state->{'retry_pending'} = FALSE;
    <[coding.async.state_manager]>->(
        'set', $task_id, { retry_pending => FALSE }
    );
    <[base.logs]>->( 2, "send_request: retry execution for %s", $task_id );
} elsif ( defined $state->{'retry_count'} && $state->{'retry_count'} > 0 ) {
    $state->{'retry_count'} = 0;
    <[coding.async.state_manager]>->( 'set', $task_id, { retry_count => 0 } );
    <[base.logs]>->( 2, "send_request: reset retry_count for %s", $task_id );
}

## check round limit [ task-level override or global ] ##
my $task_ref   = <coding.task.queue>->{$task_id} // {};
my $max_rounds = $task_ref->{'max_rounds'} // <coding.async.max_rounds> // 50;
if ( ( $state->{'round'} // 0 ) > $max_rounds ) {
    <[base.logs]>->(
        0, "send_request: max rounds exceeded (%d > %d) for %s",
        $state->{'round'}, $max_rounds, $task_id
    );
    <[coding.async.fail_task]>->( $task_id, 'max rounds exceeded' );
    return { success => FALSE, error => 'max rounds exceeded' };
}

## build request body ##
## no_tools flag: summary/classification tasks that don't need tool use ##
## also detect :no_tools: marker prefix in description ##
if ( not $task_ref->{'no_tools'}
    and ( $task_ref->{'description'} // '' ) =~ m|^:no_tools:|i ) {
    $task_ref->{'no_tools'} = TRUE;
    $task_ref->{'description'} =~ s|^:no_tools:\n?||i;
}
my $tools
    = ( $task_ref->{'no_tools'} // FALSE )
    ? []
    : ( $state->{'tools'} // [] );
<[base.logs]>->(
    2,               "send_request: sending %d tools for %s",
    scalar(@$tools), $task_id
);

## get inference parameters (matching blocking version) ##
my $max_tokens_cfg = <inference.model.max_tokens>
    // <inference.model.context_length> // 7777;
my $temperature = <inference.model.temperature> // 0.7;

## cap max_tokens to avoid KV cache overflow [ context + max_tokens must fit in server n_ctx ] ##
## n_ctx is stored in inference_servers when the backend was spawned ##
## map routing name to server key [ 'single-llm' routes to gpu ] ##
my $routed       = $state->{'backend'} // 'gpu';
my $srv_key      = $routed eq qw| cpu | ? qw| cpu | : qw| gpu |;
my $backend_info = <coding.inference_servers>->{$srv_key} // {};
my $n_ctx = $backend_info->{'n_ctx'} // <inference.model.context_length>
    // 7777;
my $chars_per_token_pre = 3.2;
my $body_chars_pre      = length(
    JSON::PP->new->utf8->encode(
        { messages => \@messages, tools => $tools }
    )
);
my $est_tokens_pre  = int( $body_chars_pre / $chars_per_token_pre );
my $headroom        = 500;    ## tokens reserved for generation overhead ##
my $max_tokens_safe = $n_ctx - $est_tokens_pre - $headroom;

## context overflow: ctx_est exceeds n_ctx : inject a user-visible error
## message so the model can acknowledge and the task fails cleanly,
## rather than silently producing a 200-token stub completion          ##
if ( $max_tokens_safe < 1000 ) {
    my $overflow = $est_tokens_pre - $n_ctx;
    my $err
        = sprintf(
        'context overflow: estimated %d tokens exceeds n_ctx=%d by %d'
            . ' : reduce tool output size or use a larger context window',
        $est_tokens_pre, $n_ctx, $overflow > 0 ? $overflow : 0 );
    <[base.logs]>->( 0, "send_request: %s for %s", $err, $task_id );
    <[coding.async.fail_task]>->( $task_id, $err );
    return { success => FALSE, error => $err };
}

my $max_tokens
    = $max_tokens_cfg < $max_tokens_safe ? $max_tokens_cfg : $max_tokens_safe;

if ( $max_tokens < $max_tokens_cfg ) {
    <[base.logs]>->(
        1, "send_request: max_tokens capped %d→%d [n_ctx=%d ctx_est=%d]",
        $max_tokens_cfg, $max_tokens, $n_ctx, $est_tokens_pre
    );

    ## when severely capped, inject a warning so the model adapts its strategy ##
    ## rather than silently generating truncated tool call arguments             ##
    if ( $max_tokens < 3000 ) {
        push @{ $state->{'messages'} },
            {
            'role'    => 'user',
            'content' => sprintf(
                '[CONTEXT PRESSURE: only %d tokens available for generation'
                    . ' : context is %d%% full. Use shorter responses, break'
                    . ' large writes into smaller chunks, or summarize instead'
                    . ' of writing verbatim content.]',
                $max_tokens, int( $est_tokens_pre * 100 / $n_ctx )
            ),
            };
        ## refresh messages after injection ##
        @messages = @{ $state->{'messages'} // [] };
        <[base.logs]>->(
            1,
            "send_request: context pressure warning injected for %s [%d tokens left]",
            $task_id,
            $max_tokens
        );
    }
}

my $request_body = {
    'model'    => $task->{'execution'}->{'model_used'} // 'default',
    'messages' => \@messages,
    ## use streaming : SSE chunks accumulate content as they arrive ##
    ## if connection drops mid-generation, we keep partial content ##
    ## [ non-streaming returns single JSON blob, vulnerable to drops ] ##
    'stream'      => JSON::PP::true(),
    'max_tokens'  => $max_tokens,
    'temperature' => $temperature,
};

## add tools if available [ matches task.execute logic ] ##
if (@$tools) {
    $request_body->{'tools'}       = $tools;
    $request_body->{'tool_choice'} = 'auto';
}

## estimate context usage and log CTX% ##
my $context_limit   = $n_ctx;    ## actual server context window ##
my $chars_per_token = 3.2;
my $body_chars      = length( JSON::PP->new->utf8->encode( \@messages ) );
my $est_tokens      = int( $body_chars / $chars_per_token );
my $pct_used        = int( $est_tokens * 100 / $context_limit );
my $tokens_left     = $context_limit - $est_tokens - $max_tokens;

<[base.logs]>->(
    1,
    "send_request: :%03d: msgs=%d <T:%d:%d:%d> [CTX:%d%%]",
    $state->{'round'} // 0,
    scalar(@messages),
    $est_tokens,
    $context_limit,
    $tokens_left > 0 ? $tokens_left : 0,
    $pct_used
);

## pass pct to model_output buffer for round header display ##
$state->{'pct_used'} = $pct_used;

## sanitize messages for jinja2 safety ##
<[coding.sanitize.jinja_messages]>->( \@messages );

## debug: log first message structure to diagnose HTTP 500 ##
if (@messages) {
    my $first_tool
        = ( grep { $ARG->{'role'} eq 'assistant' && $ARG->{'tool_calls'} }
            @messages )[0];
    if ($first_tool) {
        my @tc_ids = map { $ARG->{'id'} // qw| NO_ID | }
            @{ $first_tool->{'tool_calls'} // [] };
        <[base.logs]>->(
            2,
            "send_request: assistant has tool_calls with ids: [%s]",
            join( ', ', @tc_ids )
        );
    }
}

## start new async request ##
return
    <[coding.async.request]>->( $task_id, $request_body, $state->{'job_id'} );

