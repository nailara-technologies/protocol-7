## [:< ##

# name  = coding.async.send_request
# descr = send next inference request after tool execution

my ($task_id) = @ARG;

return { success => FALSE, error => 'task_id required' }
    unless defined $task_id;

## get state machine state ##
my $state = <[coding.async.state_machine]>->( qw| get |, $task_id );
return { success => FALSE, error => "no state for $task_id" }
    unless defined $state;

## build messages for next round ##
my @messages = @{ $state->{'messages'} // [] };

## add assistant response with tool calls ##
if ( @{ $state->{'tool_calls'} // [] } ) {
    push @messages,
        {
        'role'       => 'assistant',
        'content'    => $state->{'content'} // '',
        'tool_calls' => $state->{'tool_calls'},
        };
}

## add tool results ##
if ( @{ $state->{'tool_results'} // [] } ) {
    push @messages, @{ $state->{'tool_results'} };
}

## increment round counter (use 'round' key matching state_machine) ##
my $round = ( $state->{'round'} // 0 ) + 1;
if ( $round > 10 ) {
    <[base.logs]>
        ->( 0, "send_request: max rounds exceeded for %s", $task_id );
    <[coding.async.fail_task]>->( $task_id, 'max rounds exceeded' );
    return { success => FALSE, error => 'max rounds exceeded' };
}

<[coding.async.state_manager]>->(
    'set', $task_id,
    {   'round'         => $round,
        'content'       => '',
        'tool_calls'    => [],
        'finish_reason' => undef,
    }
);

## build request body ##
my $request_body = {
    'model'    => 'default',
    'messages' => \@messages,
    'stream'   => 1,
    'tools'    => $state->{'tools'},
};

## start new async request ##
return
    <[coding.async.request]>->( $task_id, $request_body, $state->{'job_id'} );

