## [:< ##

# name = httpd.http_get
# descr = HTTP GET handler with intelligent routing via route_dispatcher
# Updated: 2025-11-14 to integrate httpd.route_dispatcher

my $id            = shift;
my $session       = $data{'session'}->{$id};
my $allow_overlap = <httpd.cfg.allow_range_overlap> // 0;

my $http_host = <[httpd.determine_host]>->($id);

return <[httpd.send_error_page]>->( $id, $http_host )
    if $http_host =~ m|^\d{3}$|;    ##  numerical HTTP error code  ##

$session->{'http_host'} = $http_host;

my $request  = $session->{'http'}->{'request'};
my $response = $session->{'response'};
my $headers  = $request->{'headers'};
my $req_host = $request->{'host'};
my $http_uri = $request->{'uri'};

$session->{'http'}->{'request'}->{'matched_host'} = $http_host;

## Intelligent request routing via route_dispatcher [v2025-11-14]
## Extract URI path and delegate to route_dispatcher for intelligent routing

my $uri_obj  = URI->new($http_uri);
my $uri_path = $uri_obj->path // '/';

<[base.logs]>->(
    2,   "[%d] route_dispatcher : GET %s [vhost=%s]",
    $id, $uri_path, $http_host
);

# Call route_dispatcher to determine the appropriate handler
my $route = <[httpd.route_dispatcher]>->( 'GET', $uri_path, $http_host, $id );

unless ( ref($route) eq qw| HASH | ) {
    <[base.logs]>->(
        0, "[%d] route_dispatcher returned not valid result", $id
    );
    return <[httpd.send_error_page]>->( $id, 500 );
}

my $handler_name = $route->{'handler'}      // qw| httpd.send_error_page |;
my $handler_args = $route->{'handler_args'} // {};

<[base.logs]>->( 2, "[%d] dispatcher selected : %s", $id, $handler_name );

# Dispatch to the appropriate handler
# Get the actual code reference from the code hash
my $handler_ref = $code{$handler_name};    ## <-- improve style [exists]
unless ( ref($handler_ref) eq qw| CODE | ) {
    <[base.logs]>->(
        0,   "[%d] handler not found or not a coderef : %s",
        $id, $handler_name
    );
    return <[httpd.send_error_page]>->( $id, 500 );
}

# Call the handler with appropriate arguments based on handler type
if ( $handler_name eq qw| httpd.process_template | ) {
    return $handler_ref->( $id, $handler_args->{'template_path'} );
} elsif ( $handler_name eq qw| httpd.serve_static | ) {
    return $handler_ref->( $id, $handler_args );
} elsif ( $handler_name eq qw| httpd.handler.acme_request | ) {
    return $handler_ref->( $id, $handler_args->{'token'} );
} elsif ( $handler_name eq qw| letsencr.http.api_handler | ) {
    return $handler_ref->( $id, $handler_args->{'endpoint'} );
} elsif ( $handler_name eq qw| httpd.send_error_page | ) {
    return $handler_ref->( $id, $handler_args->{'code'} // 500 );
} else {

    # Generic handler fallback
    <[base.logs]>->( 1, "[%d] calling handler : %s", $id, $handler_name );
    return $handler_ref->( $id, $handler_args );
}

## Legacy fallback (should not be reached if routing is correct)
<[base.logs]>->( 0, "[%d] http_get : unexpected fallthrough", $id );
return <[httpd.send_error_page]>->( $id, 500 );

