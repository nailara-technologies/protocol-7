## [:< ##

# name = httpd.http_get
# descr = HTTP GET handler with intelligent routing via route_dispatcher
# Updated: 2025-11-14 to integrate httpd.route_dispatcher for modern content routing

my $id            = shift;
my $session       = $data{'session'}->{$id};
my $allow_overlap = <httpd.cfg.allow_range_overlap> // 0;

my $http_host = <[httpd.determine_host]>->($id);

return <[httpd.send_error_page]>->( $id, $http_host )
    if $http_host =~ m|^\d{3}$|;    ##  numerical HTTP error code  ##

$session->{'http_host'} = $http_host;

my $request     = $session->{'http'}->{'request'};
my $response    = $session->{'response'};
my $headers     = $request->{'headers'};
my $req_host    = $request->{'host'};
my $http_uri    = $request->{'uri'};
my $link_target = <httpd.cfg.hostnames>->{$http_host}
    if defined <httpd.cfg.hostnames>->{$http_host};

if (    $link_target =~ m|^\d{3}$|
    and -l catfile( <httpd.site_dir>,  $http_host )
    and !-e catfile( <httpd.site_dir>, $link_target ) ) {    # special codes

    $session->{'watcher'}->{'input_handler'}->cancel;
    if ( $link_target ne qw| 000 | ) {    # n > 000 == HTTP error codes
        <[base.logs]>->(
            1,   "[%d] status '%s' for requested host '%s'",
            $id, $link_target, $req_host
        );
        <[httpd.send_error_page]>->( $id, $link_target );
        $session->{'flush_shutdown'} = 1;
    } else {
        <[base.logs]>->(
            1,   "[%s] <000> dropping host request '%s'",
            $id, $req_host
        );
        $session->{'close'} = 1;
    }
    return 2;
}

$session->{'http'}->{'request'}->{'matched_host'} = $http_host;

## ============================================================================
## NEW: Intelligent request routing via route_dispatcher [v2025-11-14]
## ============================================================================
## Extract URI path and delegate to route_dispatcher for intelligent routing

my $uri_obj  = URI->new($http_uri);
my $uri_path = $uri_obj->path // '/';

<[base.logs]>->(
    2,   "[%d] route_dispatcher : GET %s [vhost=%s]",
    $id, $uri_path, $http_host
);

# Call route_dispatcher to determine the appropriate handler
my $route = <[httpd.route_dispatcher]>->( 'GET', $uri_path, $http_host, $id );

unless ( ref($route) eq qw| HASH | ) {
    <[base.logs]>->(
        0, "[%d] route_dispatcher returned not valid result", $id
    );
    return <[httpd.send_error_page]>->( $id, 500 );
}

my $handler_name = $route->{'handler'}      // qw| httpd.send_error_page |;
my $handler_args = $route->{'handler_args'} // {};

<[base.logs]>->( 2, "[%d] dispatcher selected: %s", $id, $handler_name );

# Dispatch to the appropriate handler
# Get the actual code reference from the code hash
my $handler_ref = $code{$handler_name};    ## <-- improve style [exists]
unless ( ref($handler_ref) eq qw| CODE | ) {
    <[base.logs]>->(
        0,   "[%d] handler not found or not a coderef : %s",
        $id, $handler_name
    );
    return <[httpd.send_error_page]>->( $id, 500 );
}

# Call the handler with appropriate arguments based on handler type
if ( $handler_name eq qw| httpd.process_template | ) {
    return $handler_ref->( $id, $handler_args->{'template_path'} );
} elsif ( $handler_name eq qw| httpd.serve_static | ) {
    return $handler_ref->( $id, $handler_args );
} elsif ( $handler_name eq qw| httpd.handler.acme_request | ) {
    return $handler_ref->( $id, $handler_args->{'token'} );
} elsif ( $handler_name eq qw| letsencr.http.api_handler | ) {
    return $handler_ref->( $id, $handler_args->{'endpoint'} );
} elsif ( $handler_name eq qw| httpd.send_error_page | ) {
    return $handler_ref->( $id, $handler_args->{'code'} // 500 );
} else {

    # Generic handler fallback
    <[base.logs]>->( 1, "[%d] calling handler : %s", $id, $handler_name );
    return $handler_ref->( $id, $handler_args );
}

## Legacy fallback (should not be reached if routing is correct)
<[base.logs]>->( 0, "[%d] http_get : unexpected fallthrough", $id );

if ( exists $headers->{'range'} ) {
    my $bad_req = 0;
    my $max_len = 1024;
    if ( length( $headers->{'range'} ) > $max_len ) {
        $bad_req = 1;
    } else {
        $headers->{'range'} =~ s| +||g;
    }
    $bad_req = 1 if $headers->{'range'} !~ s|^bytes=||;
    my $range_reg = qr{(\d+-\d+|-\d+|\d+-\*?)};
    return <[httpd.send_error_page]>->( $id, 400 )    # <-- Bad Request
        if $bad_req
        or $headers->{'range'} !~ m{^$range_reg(,$range_reg)*$};
}

my $file_path;

if ( defined $http_host and defined $link_target ) {
    <[base.logs]>->(
        1,   "[%d] matched host : '%s' --> '%s'",
        $id, $session->{'http'}{'request'}{'host'}, $http_host
        )
        if defined $session->{'http'}{'request'}{'host'}
        and $http_host ne $session->{'http'}{'request'}{'host'};

    my $base_dir = <httpd.cfg.hostnames>->{$http_host};

    my $uri_obj = URI->new($http_uri);

    $file_path = join '', $base_dir, $uri_obj->path;
    $file_path =~ s|/$||;

    return <[httpd.send_error_page]>->( $id, 404 )
        if $file_path =~ m|\.tmpl$|    # *.tmpl files are masked.
        and -f $file_path;

    if ( -d $file_path ) {
        $file_path .= qw|/index.html| if -f $file_path . qw| /index.html |;
        $file_path .= qw|/index.tmpl| if -f $file_path . qw| /index.tmpl |;
    } elsif ( -f sprintf qw| %s.tmpl |, $file_path ) {
        $file_path .= qw| .tmpl |;
    } elsif ( $file_path =~ m,\/, ) {
        my $real_path = $file_path;
        while ( $real_path =~ s|\/+[^\/]*$|| ) {
            if ( -d $real_path and -f catfile( $real_path, qw|index.tmpl| ) )
            {
                $file_path = catfile( $real_path, qw| index.tmpl | );
                last;
            } elsif ( !-d $real_path and -f sprintf qw|%s.tmpl|, $real_path )
            {
                $file_path = sprintf qw| %s.tmpl |, $real_path;
                last;
            }
        }
    }

    if ( $file_path =~ m|\.tmpl$| and -f $file_path ) { ## <-- native template
        $request->{'query'}
            = { map { $ARG => $uri_obj->query_param($ARG) }
                $uri_obj->query_param };
        return <[httpd.process_template]>->( $id, $file_path );
    }

    if ( -f $file_path and !-r $file_path ) { # LLL: cfg + deal with symlinks.
        <[base.logs]>->(
            0,   "[%d] <<!>> denied by fs permissions [ %s ]",
            $id, $file_path
        );
        ## Permission Denied [FS] ##
        return <[httpd.send_error_page]>->( $id, 403 );
    } elsif ( -f $file_path ) {

        $file_path = readlink($file_path)
            if -l $file_path and -f $file_path;    ##

        my $file_stat     = File::stat::stat($file_path);
        my $content_inode = $file_stat->ino;
        my $content_size  = $file_stat->size;
        my $content_date  = time2str( $file_stat->mtime );
        my $server_date   = time2str(time);

        my $path_etag = <[chk-sum.elf.vax-BASE32]>
            ->("$content_inode.$content_size.$content_date.$file_path");
        $response->{'params'}->{'ETag'} = $path_etag;

        ## caching meta data ..,
        my $meta = <http.meta_cache> //= {};

        foreach my $check_etag ( keys $meta->%* )
        {    # use timer once too many ..,
            delete $meta->{$check_etag}
                if <[base.time]>->(4) - $meta->{$check_etag}->{'cached_since'}
                > 777;
        }

        $meta->{$path_etag} //= {
            'cached_since' => <[base.time]>->(4),
            'content_type' => mimetype($file_path)
        };

        my $content_type = $meta->{$path_etag}->{'content_type'};
        ##
        my $reply_code = 200;    # status [OK] =)

        if ( defined $request->{'headers'}->{'if-none-match'}
            and $request->{'headers'}->{'if-none-match'} eq
            $response->{'params'}->{'ETag'} ) {
            <[base.log]>->( 1, "[if-none-match] returning 304 [$path_etag]" );
            $reply_code = 304;    # Not Modified [304]

        } elsif ( defined $request->{'headers'}->{'if-modified-since'}
            and $request->{'headers'}->{'if-modified-since'} eq
            $content_date ) {
            <[base.logs]>->(
                1, "[if-modified-since] returning 304 [%s]", $path_etag
            );
            $reply_code = 304;    # Not Modified [304]
        }

        my @byte_ranges;
        goto skip_range
            if not exists $headers->{'range'}
            or not defined $headers->{'range'};
        $response->{'params'}->{'Content-Range'} = "bytes */$content_size";

        foreach my $range_str ( split ',', $headers->{'range'} ) {
            my ( $start, $end );  ### regular byte range [ <start>-<end> ] ###
            ( $start, $end ) = ( $1, $2 ) if $range_str =~ m{^(\d+)-(\d+)$};

            ( $start, $end ) = ( $content_size - $1, $content_size - 1 )
                if $range_str =~ m{^-(\d+)$};  ## <-- byte[s] from file end..,

            ( $start, $end ) = ( $1, $content_size - 1 )
                if $range_str =~ m{^(\d+)-\*?$};   ## <--  ..,to rest of file.

            ## 416 ## Range Not Satisfiable ##
            return <[httpd.send_error_page]>->( $id, 416 )
                if $start >= $content_size
                or $end >= $content_size
                or $end < $start;

            map {                                  ## overlapping ranges? ##
                return <[httpd.send_error_page]>->( $id, 416 )
                    if ($start >= $ARG->{'start'}
                    and $start <= $ARG->{'end'} )
                    or ($end >= $ARG->{'start'}
                    and $end <= $ARG->{'end'} )
            } @byte_ranges if not $allow_overlap;

            push( @byte_ranges, { 'start' => $start, 'end' => $end } );
        }
        delete $response->{'params'}->{'Content-Range'};
        $request->{'range'} = \@byte_ranges if @byte_ranges;
    skip_range:

        my $reply_header = {
            'Content-Type'   => $content_type,
            'Last-Modified'  => $content_date,
            'Content-Length' => $content_size,
            'Connection'     => $session->{'http'}->{'close'}
            ? qw| close |
            : qw| keep-alive |,
            'Accept-Ranges' => qw| bytes |,
            $response->{'params'}->%*
        };

        $path_etag = <[chk-sum.elf.vax-BASE32]>
            ->("$content_inode.$content_size.$content_date.$file_path");
        $response->{'params'}->{'ETag'} = $path_etag;

        if ( $reply_code != 200 ) {    # <-- 304 [ Not Modified ]
            $session->{'buffer'}->{'output'}
                .= <[httpd.new_header]>->( $reply_code, $reply_header );
            return $session->{'http'}->{'close'} ? 2 : 0;
        } elsif ( $content_size <= 16 * 1024
            and not exists $request->{'range'} )
        {                              # <-- [ 'small' file, send now.. ]

            my $content_sref = <[file.slurp]>->($file_path);  ## blocking ? ##
            if ( ref($content_sref) ne qw| SCALAR | ) {    ## unknown error ##
                ## log error \ return 500 ##
                <[base.s_warn]>->(
                    '<< ! >> %s : \l%s',
                    $file_path, <[base.str.os_err]>
                );
                ## Internal Error [500] ##
                return <[httpd.send_error_page]>->( $id, 500 );
            } elsif ( length( $content_sref->$* ) < $content_size ) {
                <[base.s_warn]>->(
                    '<< ! >> %s : file read returned %d less byte[s]',
                    $file_path, $content_size - length( $content_sref->$* )
                );
                return <[httpd.send_error_page]>->( $id, 500 ); ## send ERR ##
            }
            ## has content + size matches ##
            $session->{'buffer'}->{'output'}
                .= <[httpd.new_header]>->( $reply_code, $reply_header );
            $session->{'buffer'}->{'output'} .= $content_sref->$*;
            return $session->{'http'}->{'close'}   # [LLL] check code handling
                ? 2
                : 0;

        } else {    # 'larger' file, transfer in pieces.,
            return <[httpd.download_init]>->(
                {   'sid'    => $id,
                    'path'   => $file_path,
                    'header' => $reply_header
                }
            );
        }
    }
} else {
    return <[httpd.send_error_page]>->( $id, 400 );    # Bad Request
}

return <[httpd.send_error_page]>->( $id, 404 )         # Not Found
    if not defined $file_path
    or !-f $file_path;

