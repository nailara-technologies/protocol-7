## [:< ##

# name = web.cmd.process_template_ipc
# descr = IPC command handler - wrapper for web.process_template_ipc
# args  = template_id:template_content_b32r:meta_vars_b32r:session_id

## Commands receive a hash ref with args directly ##
my $hash_ref = shift;
my $args_str = $hash_ref->{'args'} // '';

## Call the actual implementation (returns hash ref) ##
my $result = <[web.process_template_ipc]>->($args_str);

## Debug logging ##
<[base.log]>->(
    0,
    "wrapper : mode="
        . ( $result->{'mode'} // 'unknown' )
        . ", data type="
        . ref( $result->{'data'} )
        . ", length="
        . ( defined $result->{'data'} ? length( $result->{'data'} ) : 0 )
);

## Return hash ref directly ##
return $result;

