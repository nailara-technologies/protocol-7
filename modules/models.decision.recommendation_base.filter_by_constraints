# name  = models.decision.recommendation_base.filter_by_constraints
# descr = Filter models by constraint criteria

my ($models, $constraints) = @ARG;

return [] unless $models && ref($models) eq 'ARRAY';

my @filtered = grep {
  my $model = $_;
  my $pass = 1;

  # Check capability requirements
  if ($constraints->{required_capability}) {
    my $caps = $model->{capabilities} // {};
    $pass = 0 unless $caps->{$constraints->{required_capability}};
  }

  # Check size constraints
  if ($constraints->{max_size_gb}) {
    my $size = $model->{resource_profile}->{storage}->{size_gb} // 0;
    $pass = 0 if $size > $constraints->{max_size_gb};
  }

  $pass;
} @$models;

return \@filtered;

