## [:< ##

# name = models.backend.api.detect_limit
# descr = detect API rate limit conditions from response

my $params = shift;

my $api_result = $params->{'api_result'} // {};
my $context    = $params->{'context'}    // 'backend';

## Check if result indicates rate limiting
my $is_rate_limited = $api_result->{'rate_limited'} ? 1 : 0;

## Also check error messages for quota patterns
unless ($is_rate_limited) {
    my $error_msg = $api_result->{'error'} // '';
    if ( $error_msg =~ /rate\s+limit|quota|throttle|429/i ) {
        $is_rate_limited = 1;
    }
}

<[base.log]>->(
    2,                "[$context] rate limit check: limited=%d error=%s",
    $is_rate_limited, $api_result->{'error'} // 'none'
);

return {
    'rate_limited' => $is_rate_limited,
    'api_result'   => $api_result,
};

