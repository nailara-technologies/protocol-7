## [:< ##

# name  = base.env.detect_environment
# descr = Detect current environment and repository paths
# return = hash with protocol7_root, workspace_root, and environment_type

## Check for environment variables first ##
my %env_info;

## Protocol-7 root detection ##
if ($ENV{PROTOCOL7_ROOT}) {
    $env_info{protocol7_root} = $ENV{PROTOCOL7_ROOT};
} elsif (-d '/home/user/protocol-7') {
    $env_info{protocol7_root} = '/home/user/protocol-7';
} elsif (-d '/data/projects/protocol-7') {
    $env_info{protocol7_root} = '/data/projects/protocol-7';
} else {
    ## Fallback: try to find from current working directory ##
    my $cwd = `pwd`;
    chomp $cwd;
    if ($cwd =~ m{^(.*?/protocol-7)}) {
        $env_info{protocol7_root} = $1;
    } else {
        <[base.log]>->( 0, "Warning: Could not detect protocol-7 root directory" );
        $env_info{protocol7_root} = '/home/user/protocol-7';  ## fallback
    }
}

## Workspace-transfer root detection ##
if ($ENV{WORKSPACE_TRANSFER_ROOT}) {
    $env_info{workspace_root} = $ENV{WORKSPACE_TRANSFER_ROOT};
} elsif (-d '/home/user/workspace-transfer') {
    $env_info{workspace_root} = '/home/user/workspace-transfer';
} elsif (-d '/data/projects/workspace-transfer') {
    $env_info{workspace_root} = '/data/projects/workspace-transfer';
} else {
    ## Try to find relative to protocol-7 ##
    my $p7_root = $env_info{protocol7_root};
    if (-d "$p7_root/../workspace-transfer") {
        $env_info{workspace_root} = "$p7_root/../workspace-transfer";
    } else {
        <[base.log]>->(
            0, "Warning: Could not detect workspace-transfer root directory"
        );
        $env_info{workspace_root} = '/home/user/workspace-transfer';  ## fallback
    }
}

## Detect environment type ##
if ($env_info{protocol7_root} =~ m{^/home/user}) {
    $env_info{environment_type} = 'local';
} elsif ($env_info{protocol7_root} =~ m{^/data/projects}) {
    $env_info{environment_type} = 'claude';
} else {
    $env_info{environment_type} = 'unknown';
}

return \%env_info;

