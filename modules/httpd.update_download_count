# name = httpd.update_download_count
# descr = track file download statistics

my $file_path = shift;
my $bytes = shift; # Optional: bytes transferred (for partial downloads)

# Skip if no file path provided
return 0 if !defined $file_path || $file_path eq '';

# Skip if file doesn't exist
return 0 if !-f $file_path;

# Initialize statistics data structure if needed
$data{'httpd'}{'downloads'} //= {};
$data{'httpd'}{'downloads'}{'files'} //= {};
$data{'httpd'}{'downloads'}{'totals'} //= {
    'count' => 0,
    'bytes' => 0,
    'last_time' => 0
};

# Get file size if bytes not provided
if (!defined $bytes) {
    $bytes = -s $file_path;
}

# Update file-specific statistics
if (!exists $data{'httpd'}{'downloads'}{'files'}{$file_path}) {
    $data{'httpd'}{'downloads'}{'files'}{$file_path} = {
        'count' => 0,
        'bytes' => 0,
        'first_time' => <[base.time]>->(3),
        'last_time' => 0
    };
}

$data{'httpd'}{'downloads'}{'files'}{$file_path}{'count'}++;
$data{'httpd'}{'downloads'}{'files'}{$file_path}{'bytes'} += $bytes;
$data{'httpd'}{'downloads'}{'files'}{$file_path}{'last_time'} = <[base.time]>->(3);

# Update global download statistics
$data{'httpd'}{'downloads'}{'totals'}{'count'}++;
$data{'httpd'}{'downloads'}{'totals'}{'bytes'} += $bytes;
$data{'httpd'}{'downloads'}{'totals'}{'last_time'} = <[base.time]>->(3);

# Log download at debug level
<[base.log]>->(
    3, "File download: $file_path - " . <[httpd.base.size.normalize]>->($bytes) .
       " (Total downloads: $data{'httpd'}{'downloads'}{'files'}{$file_path}{'count'})"
);

# Clean up old statistics if too many files are tracked
if (scalar(keys %{$data{'httpd'}{'downloads'}{'files'}}) > 1000) {
    # Find oldest accessed files
    my @files = sort {
        $data{'httpd'}{'downloads'}{'files'}{$a}{'last_time'} <=>
        $data{'httpd'}{'downloads'}{'files'}{$b}{'last_time'}
    } keys %{$data{'httpd'}{'downloads'}{'files'}};

    # Remove oldest entries to keep only 900 entries
    foreach my $old_file (@files[0..99]) {
        delete $data{'httpd'}{'downloads'}{'files'}{$old_file};
    }
}

return 1;

