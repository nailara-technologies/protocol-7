## [:< ##

# name  = letsencr.child.acme_new
# descr = child process ACME new certificate issuance (blocking crypto/network calls)

my $msg = shift;

my $domains = $msg->{domains};                           # array ref
my $email   = $msg->{email} || <letsencr.admin.email>;

return {
    status => 'error',
    error  => 'domains array required'
    }
    unless $domains && ref($domains) eq 'ARRAY' && @$domains;

my $primary_domain = $domains->[0];

<[base.log]>->(
    2,
    "child: issuing new certificate for domains: " . join( ', ', @$domains )
);

## STEP 1: Fetch ACME directory (if not already cached)
unless ( <letsencr.child.acme_client> {directory} ) {
    <[base.log]>->( 2, 'step 1: fetching ACME directory' );
    my $dir_info = <[letsencr.child.fetch_acme_directory]>->();
    unless ($dir_info) {
        return {
            status => 'error',
            error  => 'Failed to fetch ACME directory'
        };
    }
}

## STEP 2: Load or generate account key
<[base.log]>->( 2, 'step 2: loading or generating account key' );
my $account_key = <[letsencr.child.load_account_key]>->();
unless ($account_key) {
    $account_key = <[letsencr.child.generate_account_key]>->();
    unless ($account_key) {
        return {
            status => 'error',
            error  => 'Failed to generate account key'
        };
    }
}

## STEP 3: Register ACME account (or retrieve existing)
unless ( <letsencr.child.acme_client> {account_url} ) {
    <[base.log]>->( 2, 'step 3: registering ACME account' );
    my $account_info = <[letsencr.child.acme_register_account]>->();
    unless ($account_info) {
        ## Try checking if account already exists
        my $existing = <[letsencr.child.acme_check_account]>->();
        unless ($existing) {
            return {
                status => 'error',
                error  => 'Failed to register ACME account'
            };
        }
    }
}

## STEP 4: Create certificate order
<[base.log]>->( 2, 'step 4: creating certificate order' );
my $order = <[letsencr.child.acme_create_order]>->($domains);
unless ($order) {
    return {
        status => 'error',
        error  => 'Failed to create certificate order'
    };
}

<[base.log]>->( 2, "  order URL: $order->{order_url}" );
<[base.log]>->(
    2, "  authorizations: " . scalar( @{ $order->{authorizations} } )
);

## STEP 5: Process authorizations for each domain
<[base.log]>->( 2, 'step 5: processing authorizations' );
my @auth_urls;
my $auth_index = 0;

foreach my $auth_url ( @{ $order->{authorizations} } ) {
    $auth_index++;
    my $domain = $domains->[ $auth_index - 1 ];

    <[base.log]>->(
        2,
        "  authorization $auth_index/${\(scalar @{$order->{authorizations}})}: $domain"
    );

    ## Get authorization and challenges
    my $auth = <[letsencr.child.acme_get_authorization]>->($auth_url);
    unless ($auth) {
        return {
            status => 'error',
            error  => "Failed to get authorization for $domain"
        };
    }

    ## Determine challenge type based on domain and availability
    my $is_wildcard    = ( $domain =~ /^\*\./ ) || $auth->{wildcard};
    my $challenge_type = $is_wildcard ? 'dns-01'       : 'http-01';
    my $challenge_data = $is_wildcard ? $auth->{dns01} : $auth->{http01};

    ## Fall back to DNS-01 if HTTP-01 not available
    if ( !$challenge_data && $auth->{dns01} ) {
        <[base.log]>->( 2, "    HTTP-01 not available, using DNS-01" );
        $challenge_type = 'dns-01';
        $challenge_data = $auth->{dns01};
    }

    unless ($challenge_data) {
        return {
            status => 'error',
            error  => "No suitable challenge available for $domain"
        };
    }

    <[base.log]>->( 2, "    challenge type: $challenge_type" );

    ## Create challenge response based on type
    my $challenge_response;

    if ( $challenge_type eq 'dns-01' ) {
        $challenge_response = <[letsencr.child.create_dns01_challenge]>->(
            $challenge_data, $domain
        );

        unless ($challenge_response) {
            return {
                status => 'error',
                error  => "Failed to create DNS-01 challenge for $domain"
            };
        }

        <[base.log]>->(
            2,
            "    DNS TXT record: $challenge_response->{dns_record_name} = $challenge_response->{dns_value}"
        );

        ## Wait for DNS propagation
        <[base.log]>->( 2, "    waiting for DNS propagation..." );
        my $dns_check = <[letsencr.child.check_dns_propagation]>->(
            $challenge_response->{dns_record_name},
            $challenge_response->{dns_value}
        );

        unless ( $dns_check && $dns_check->{propagated} ) {
            return {
                status => 'error',
                error  =>
                    "DNS propagation failed for $domain: $dns_check->{error}"
            };
        }

        <[base.log]>->(
            2,
            "    DNS propagated successfully in $dns_check->{attempts} attempts"
        );

    } else {
        ## HTTP-01 challenge
        $challenge_response = <[letsencr.child.create_http01_challenge]>->(
            $challenge_data, $domain
        );

        unless ($challenge_response) {
            return {
                status => 'error',
                error  => "Failed to create HTTP-01 challenge for $domain"
            };
        }

        <[base.log]>->(
            2, "    challenge file: $challenge_response->{file_path}"
        );
    }

    ## Notify ACME server that challenge is ready
    my $respond_result = <[letsencr.child.respond_to_challenge]>->(
        $challenge_response->{challenge_url},
        $challenge_response->{token}
    );

    unless ($respond_result) {
        return {
            status => 'error',
            error  => "Failed to respond to challenge for $domain"
        };
    }

    push @auth_urls, { url => $auth_url, domain => $domain };
}

## STEP 6: Poll all authorizations until valid
<[base.log]>->( 2, 'step 6: polling authorization status' );
foreach my $auth_info (@auth_urls) {
    my $validation = <[letsencr.child.poll_challenge_status]>->(
        $auth_info->{url}, $auth_info->{domain}
    );

    unless ( $validation && $validation->{valid} ) {
        my $error = $validation->{error} || 'Challenge validation failed';
        return {
            status => 'error',
            error  =>
                "Domain validation failed for $auth_info->{domain}: $error"
        };
    }

    <[base.log]>->(
        2,
        "    $auth_info->{domain}: validated in $validation->{attempts} attempts"
    );
}

## STEP 7: Generate CSR
<[base.log]>->( 2, 'step 7: generating certificate signing request' );
my $csr = <[letsencr.child.generate_csr]>->($domains);
unless ($csr) {
    return {
        status => 'error',
        error  => 'Failed to generate CSR'
    };
}

## STEP 8: Finalize order and download certificate
<[base.log]>->( 2, 'step 8: finalizing order and downloading certificate' );
my $cert_result = <[letsencr.child.acme_finalize_order]>->();
unless ($cert_result) {
    return {
        status => 'error',
        error  => 'Failed to finalize order or download certificate'
    };
}

<[base.log]>->( 2, "certificate obtained successfully!" );
<[base.log]>->( 2, "  polled $cert_result->{poll_attempts} times" );

## STEP 9: Parse certificate expiration
my $valid_until = time() + ( 90 * 86400 );    # Default 90 days
## TODO: Parse certificate to get actual expiration date

## STEP 10: Send result back to parent
<[base.log]>->( 2, 'sending certificate to parent process' );

<[letsencr.child.send_to_parent]>->(
    {   command     => 'cert_ready',
        domain      => $primary_domain,
        domains     => $domains,
        cert        => $cert_result->{certificate},
        key         => $cert_result->{key},
        valid_until => $valid_until,
        fingerprint => 'SHA256:...',             # TODO: Calculate fingerprint
        cert_url    => $cert_result->{cert_url},
    }
);

return {
    status      => 'success',
    domains     => $domains,
    cert        => $cert_result->{certificate},
    key         => $cert_result->{key},
    valid_until => $valid_until,
    cert_url    => $cert_result->{cert_url},
};

