## [:< ##

# name  = coding.tools.handler.replace_line
# descr = replace single line in file by line number

my $args    = shift              // {};
my $path    = $args->{'path'}    // return 'error : path required';
my $line    = $args->{'line'}    // return 'error : line number required';
my $content = $args->{'content'} // return 'error : content required';
my $apply   = $args->{'apply'}   // TRUE;

## resolve and sanitize path ##
my $root      = <system.root_path>;
my $abs_path  = "$root/$path";
my $real_path = Cwd::abs_path($abs_path) // '';
my $real_root = Cwd::abs_path($root)     // '';
return 'error: path escapes project root'
    if !length $real_path
    or index( $real_path, "$real_root/" ) != 0;
return 'error: file not found' unless -f $real_path;

## read file into lines ##
my $lines_ref = <[base.file.slurp]>->( $real_path, [], ':encoding(UTF-8)' );
return 'error: cannot read file' unless defined $lines_ref;
my @lines = @{$lines_ref};

## validate line number ##
my $line_num = int($line);
return 'error: line number must be >= 1' if $line_num < 1;
return sprintf 'error: line %d out of range [1..%d]', $line_num,
    scalar @lines
    if $line_num > scalar @lines;

my $old = $lines[ $line_num - 1 ];
chomp $old;

## apply or preview ##
if ($apply) {
    $lines[ $line_num - 1 ] = "$content\n";
    <[base.file.write_encoded]>->( ':encoding(UTF-8)', $real_path, @lines );
    return sprintf "replaced line %d\n  was: %s\n  now: %s", $line_num, $old,
        $content;
}

return sprintf "preview line %d\n  was: %s\n  now: %s", $line_num, $old,
    $content;

