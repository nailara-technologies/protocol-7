# name  = models.cmd.adapter-lmstudio-repair
# descr = cmd: validate gguf files for lmstudio adapter

my @tokens  = split m|\s+|, $call->{'args'} // '';
my %flags   = map { $_ => 1 } @tokens;
my $dry_run = $flags{':dry-run:'} ? 1 : 0;

my $result
    = <[models.storage.adapter.lmstudio.repair]>->( { dry_run => $dry_run } );

<[base.logs]>->(
    1, "adapter-lmstudio-repair: valid=%d corrupt=%d missing=%d",
    $result->{'valid'}, $result->{'corrupt'}, $result->{'missing'}
);

return;

