## [:< ##

# name  = channels.memory-sync
# descr = Synchronize nested %data branches between zenka via channels
# args  = none
# return = 0

##  Memory-sync configuration: maps local %data to channels  ##
##  Format: <channels.memory_sync_config> = {
##      'zenka_name.data.branch' => 'channel.path',  # bidirectional
##      ...
##  }  ##

<channels.memory_sync_config>  //= {};
<channels.memory_sync_watches> //= {};    ## watches to detect changes ##

##  Helper: Apply memory-sync mappings  ##
##  Called when channel data updates or local %data changes  ##

return 0;

1;

