# name  = models.cmd.adapter-repair
# descr = cmd: repair path structure for a host adapter

my @tokens  = split m|\s+|, $call->{'args'} // '';
my $host    = shift @tokens // 'invoke';
my %flags   = map { $_ => 1 } @tokens;
my $dry_run = $flags{':dry-run:'} ? 1 : 0;

my $out = "";

if ( $host eq 'invoke' ) {
    my $result = <[models.storage.adapter.invoke.repair]>
        ->( { dry_run => $dry_run } );
    $out = sprintf "created=%d skipped=%d missing=%d failed=%d\n",
        $result->{'created'}, $result->{'skipped'},
        $result->{'missing'}, $result->{'failed'};
} elsif ( $host eq 'lmstudio' ) {
    my $result = <[models.storage.adapter.lmstudio.repair]>
        ->( { dry_run => $dry_run } );
    $out = sprintf "valid=%d corrupt=%d missing=%d\n",
        $result->{'valid'}, $result->{'corrupt'}, $result->{'missing'};
} else {
    <[base.logs]>->( 0, "unknown adapter [ %s ]", $host );
}

return { mode => qw| size |, data => $out };

