## [:< ##

# name  = site-yaml.handler.fetch_tick
# descr = process one item from fetch queue, adjust delay, reschedule

my $queue = $data{'site-yaml'}{'fetch_queue'} // [];

if ( not @{$queue} ) {
    <[site-yaml.fetch.schedule]>;
    return;
}

my $item = shift @{$queue};
my $url  = $item->{'url'} // '';
my $id   = $item->{'id'}  // '';

return unless length $url;

## fetch job detail ##
my $job = <[site-yaml.stepstone.job]>->($url);

my $ql = scalar @{$queue} + 1;    ## including current item

if ( ref $job ne 'HASH' ) {
    my $code    = $job // 0;
    my $is_gone = $code =~ m{^4(10|04)$};    ## 410 Gone, 404 Not Found ##
    my $is_ratelimit
        = $code =~ m{403|429} || ( $code // '' ) =~ m{rate.?limit|too.?many}i;
    my $tag = $is_gone ? 'gone' : $is_ratelimit ? '403' : 'err';

    if ($is_gone) {
        ## permanent — drop immediately, no retry ##
    } elsif ($is_ratelimit) {
        $item->{'retry_count'} //= 0;
        $item->{'retry_count'}++;
        if ( $item->{'retry_count'} <= 5 ) {
            push @{$queue}, $item;  ## back of queue — allow others through ##
            $tag .= ' retry=' . $item->{'retry_count'};
            <[site-yaml.fetch.backoff]>->('error');
        } else {
            $tag = 'drop';          ## give up after 5 ratelimit retries ##
        }
    } else {
        $item->{'retry_count'} //= 0;
        $item->{'retry_count'}++;
        if ( $item->{'retry_count'} <= 2 ) {
            push @{$queue}, $item;
            $tag .= ' retry=' . $item->{'retry_count'};
        } else {
            $tag = 'drop';
        }
    }

    my $is_retry  = $tag =~ m{retry=};
    my $log_level = $is_gone ? 2 : ( $is_ratelimit || $is_retry ) ? 1 : 0;
    <[base.logs]>->(
        $log_level, 'fetch: %s [%s] q=%d',
        $id, $tag, scalar @{$queue}
    );
    <[site-yaml.fetch.state]>->('save');
    <[site-yaml.fetch.schedule]>;
    return;
}

## success ##
my $result = <[site-yaml.jobs.upsert]>->($job);
my $tag    = $result eq 'new' ? 'new' : 'skip';
<[base.logs]>->( 1, 'fetch: %s [%s] q=%d', $id, $tag, $ql - 1 );

<[site-yaml.fetch.backoff]>->('success');

<[site-yaml.fetch.state]>->('save');
<[site-yaml.fetch.schedule]>;

return;

