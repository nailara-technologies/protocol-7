## [:< ##

# name  = pager.sort.multi-key
# descr = Multi-key weighted sorting

my ($args) = @ARG;
my $items  = $args->{'items'};
my $spec   = $args->{'spec'} // {};

return $items unless @$items > 1;

my $keys = $spec->{'keys'}
    // [ { 'field' => 'name', 'dir' => 'asc', 'weight' => 1.0 } ];

# If no weights specified, use equal weights
my $total_weight = 0;
for my $key (@$keys) {
    $key->{'weight'} //= 1.0;
    $total_weight += $key->{'weight'};
}

# Normalize weights
if ( $total_weight > 0 ) {
    for my $key (@$keys) {
        $key->{'weight'} /= $total_weight;
    }
}

# Sort using Schwartzian transform for efficiency
my @sorted = map { $ARG->[0] }
    sort {
    my $cmp = 0;
    for my $key (@$keys) {
        my $field  = $key->{'field'};
        my $dir    = $key->{'dir'} eq 'desc' ? -1 : 1;
        my $weight = $key->{'weight'};

        my $va = $a->[1]{$field};
        my $vb = $b->[1]{$field};

        # Handle undef values
        $va = '' unless defined $va;
        $vb = '' unless defined $vb;

        # Numeric comparison for numbers, string otherwise
        if ( $va =~ /^-?\d+(\.\d+)?$/ && $vb =~ /^-?\d+(\.\d+)?$/ ) {
            $cmp = ( $va <=> $vb ) * $dir;
        } else {
            $cmp = ( $va cmp $vb ) * $dir;
        }

        # Apply weight (scaled comparison)
        $cmp = $cmp * $weight;

        last if $cmp != 0;
    }
    $cmp;
    }
    map { [ $ARG, $ARG ] } @$items;

return \@sorted;

