## [:< ##

# name = git.parent.init_code
# descr = initialize git operations module (controlled by workflow zenka)

<[base.log]>->( 2, 'initializing git operations module..,' );

## Check if Git::Wrapper is available
<[base.perlmod.autoload]>->('Git::Wrapper');

## configuration — always use auto-detected root path ##
<git.cfg.repository_path> = <system.root_path>;
<git.cfg.use_wrapper> //= 1;    ## Use Git::Wrapper when available
<git.cfg.cache_log>   //= 1;    ## Cache git log for performance

## Git instance (will be created when needed)
<git.instance> //= undef;

## Cached data
<git.cache.log>      //= [];    ## Cached git log
<git.cache.log_time> //= 0;     ## Timestamp of cache
<git.cache.branches> //= {};    ## Branch information
<git.cache.tags>     //= {};    ## Tag information

## Statistics
<git.stats> = {
    commands_executed => 0,
    commits_accessed  => 0,
    cache_hits        => 0,
    cache_misses      => 0
};

<[base.log]>->( 2, 'git operations module initialized' );

0;

