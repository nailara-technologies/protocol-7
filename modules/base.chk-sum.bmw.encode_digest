# name  = base.chk-sum.bmw.encode_digest
# args  = $bmw_ctx or $digest_binary
# descr = Encode BMW digest as BASE32 (reverse byte order)

my $input = shift;
my $digest_bin;

if (ref($input) && $input->can('digest')) {
    # BMW context object - get digest
    $digest_bin = $input->digest;
} else {
    # Already a binary digest
    $digest_bin = $input;
}

return encode_b32r($digest_bin);

