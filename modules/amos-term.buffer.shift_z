## [:< ##

# name  = amos-term.buffer.shift_z
# descr = Shift buffer contents for history (push to Z+1)

my $window_id = shift;

my $window = <amos-term.windows.by_id>->{$window_id};
return undef unless defined $window;

my $shm_ptr = $window->{'buffer'}->{'shm_ptr'};
return undef unless defined $shm_ptr;

my $dims       = $window->{'buffer'}->{'dimensions'};
my $layer_size = $dims->[0] * $dims->[1] * 2;           # 112 bytes

## shift from highest Z down (to avoid overwriting) ##
for ( my $z = $dims->[2] - 1; $z > 0; $z-- ) {
    my $src_offset = ( $z - 1 ) * $layer_size;
    my $dst_offset = $z * $layer_size;
    substr( $$shm_ptr, $dst_offset, $layer_size )
        = substr( $$shm_ptr, $src_offset, $layer_size );
}

## clear Z=0 (surface) ##
substr( $$shm_ptr, 0, $layer_size ) = "\0" x $layer_size;

## update cursor Z if needed ##
my $cursor = $window->{'buffer'}->{'cursor'};
$cursor->{'z'} = 0;

return TRUE;

