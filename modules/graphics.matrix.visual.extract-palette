# name  = graphics.matrix.visual.extract-palette
# desc  = Extract color palette from sphere 0 images

my $images = shift // [];

my $colors = {};
for my $img (@$images) {
    my $col = $img->{'color_sample'} // [ 128, 128, 128 ];
    my $key = sprintf( "%02x%02x%02x", @$col );
    $colors->{$key} = ( $colors->{$key} // 0 ) + 1;
}

# Sort by frequency
return [ sort { $colors->{$b} <=> $colors->{$a} } keys %$colors ];

