# name  = models.decision.cost_analysis.where_should_model_reside
# descr = Analyze where model should reside based on cost/latency tradeoffs

my ($model_entry, $context) = @ARG;

return {} unless $model_entry && ref($model_entry) eq 'HASH';

my $size_gb = $model_entry->{resource_profile}->{storage}->{size_gb} // 10;
my $access_freq = <[models.decision.cost_base.estimate_usage_frequency]>->($model_entry, $context);
my $is_latency_sensitive = <[models.decision.cost_base.is_latency_sensitive]>->($model_entry, $context);

# Storage costs (monthly baseline)
my $local_storage_cost = $size_gb * 0.10;  # $0.10/GB/month local
my $remote_storage_cost = $size_gb * 0.023;  # AWS S3 pricing

# Bandwidth costs
my $per_download_cost = ($size_gb * 1024) * 0.09 / 1024;  # $0.09/GB download
my $monthly_bandwidth_downloads = $access_freq->{per_month} // 5;
my $monthly_bandwidth_cost = $per_download_cost * $monthly_bandwidth_downloads;

# Latency costs
my $cold_start_latency_ms = $is_latency_sensitive ? 5000 : 1000;  # seconds to fetch + decompress
my $cost_per_cold_start = $is_latency_sensitive ? 2.50 : 0.50;

# Break-even analysis
my $keep_local = $local_storage_cost + ($access_freq->{per_month} * 0.01);  # small per-use cost
my $fetch_ondemand = $remote_storage_cost + $monthly_bandwidth_cost + ($cost_per_cold_start * $access_freq->{per_month});

return {
  storage_cost => {
    monthly_usd => $local_storage_cost,
    annual_usd => $local_storage_cost * 12,
  },
  bandwidth_cost => {
    per_download_usd => $per_download_cost,
    estimated_monthly_usd => $monthly_bandwidth_cost,
    estimated_annual_usd => $monthly_bandwidth_cost * 12,
  },
  latency_cost => {
    initialization_ms => $cold_start_latency_ms,
    cost_per_cold_start => $cost_per_cold_start,
  },
  break_even_analysis => {
    keep_local_monthly => $keep_local,
    fetch_ondemand_monthly => $fetch_ondemand,
    delta_monthly => $fetch_ondemand - $keep_local,
    recommendation => $keep_local < $fetch_ondemand ? 'keep_local' : 'fetch_ondemand',
  },
  usage_frequency => {
    per_month => $access_freq->{per_month} // 5,
    per_day => $access_freq->{per_day} // 0.17,
  },
};

