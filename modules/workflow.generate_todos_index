# name  = workflow.generate_todos_index
# descr = generate todos index from all sources

my @todos;

# Get yaml todos
my $yaml_todos = <[workflow.extract_yaml_todos]>;
push @todos, @$yaml_todos;

# Get workspace todos
my $workspace_todos = <[workflow.extract_workspace_todos]>;
push @todos, @$workspace_todos;

my $index_data = {
    generated_at => scalar(localtime()),
    timestamp => time(),
    total_count => scalar(@todos),
    by_source => {},
    by_priority => {},
    by_status => {},
    todos => \@todos
};

# Aggregate statistics
foreach my $todo (@todos) {
    $index_data->{by_source}{$todo->{source}}++;
    $index_data->{by_priority}{$todo->{priority}}++;
    $index_data->{by_status}{$todo->{status}}++;
}

# Ensure index directory exists
my $index_dir = <workflow.cfg.index_dir>;
unless (-d $index_dir) {
    # Create with parents if needed
    require File::Path;
    File::Path::make_path($index_dir) or die "Cannot create index directory: $!";
}

# Write index
my $todos_index = <workflow.index.todos>;
YAML::XS::DumpFile($todos_index, $index_data);

return $index_data;

