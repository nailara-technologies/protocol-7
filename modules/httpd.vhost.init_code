## [:< ##

# name  = httpd.vhost.init_code
# descr = initialize vhost manifest registry and installed tracking

<httpd.vhosts.registry>     //= {};
<httpd.vhosts.installed>    //= {};
<httpd.vhosts.merge_needed> //= {};

my $root_path = <system.root_path> // qw| . |;
<httpd.vhosts.source_dir> //= "$root_path/data/web-root/vhosts";

my $manifests_found = <[httpd.vhost.read_manifests]>;

<[base.logs]>->(
    2,
    'vhost registry initialized with %d manifest%s',
    scalar @$manifests_found,
    <[base.cnt_s]>->( scalar @$manifests_found )
);

0;

