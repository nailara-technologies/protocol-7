## [:< ##

# name = httpd.handler.acme_challenge
# descr = serve HTTP-01 ACME challenge response files

## handler receives: session_id and handler_args with token
my $id    = shift;
my $args  = shift            // {};
my $token = $args->{'token'} // '';

my $session = $data{'session'}->{$id};

unless ( length $token ) {
    <[base.logs]>->( 1, "[%d] challenge handler: missing token", $id );
    my $reply_code   = 400;
    my $reply_body   = 'Bad Request';
    my $reply_header = {
        'Content-Type'   => 'text/plain',
        'Content-Length' => length($reply_body),
        'Connection'     => qw| close |,
    };
    $session->{'buffer'}->{'output'}
        .= <[httpd.new_header]>->( $reply_code, $reply_header );
    $session->{'buffer'}->{'output'} .= $reply_body;
    return 2;
}

## construct path to challenge file
my $site_dir = <httpd.site_dir>;
my $vhost    = $session->{'http'}->{'request'}->{'matched_host'} // '';
my $challenge_file = sprintf '%s%s/.well-known/acme-challenge/%s',
    $site_dir, $vhost, $token;

<[base.logs]>
    ->( 2, "[%d] serving challenge file : %s", $id, $challenge_file );

## check if file exists
unless ( -f $challenge_file ) {
    <[base.logs]>->(
        1,   "[%d] challenge file not found : %s",
        $id, $challenge_file
    );
    my $reply_code   = 404;
    my $reply_body   = 'Not Found';
    my $reply_header = {
        'Content-Type'   => 'text/plain',
        'Content-Length' => length($reply_body),
        'Connection'     => qw| close |,
    };
    $session->{'buffer'}->{'output'}
        .= <[httpd.new_header]>->( $reply_code, $reply_header );
    $session->{'buffer'}->{'output'} .= $reply_body;
    return 2;
}

## read challenge content
my $content = <[file.content]>->( $challenge_file, ':raw' );

unless ( defined $content ) {
    <[base.logs]>->(
        1,   "[%d] failed to read challenge file : %s",
        $id, <[base.str.os_err]>
    );
    my $reply_code   = 500;
    my $reply_body   = 'Internal Server Error';
    my $reply_header = {
        'Content-Type'   => 'text/plain',
        'Content-Length' => length($reply_body),
        'Connection'     => qw| close |,
    };
    $session->{'buffer'}->{'output'}
        .= <[httpd.new_header]>->( $reply_code, $reply_header );
    $session->{'buffer'}->{'output'} .= $reply_body;
    return 2;
}

<[base.logs]>->(
    2,   "[%d] challenge content length : %d bytes",
    $id, length($content)
);

## send response with plain text content type
my $reply_code   = 200;
my $reply_header = {
    'Content-Type'   => 'text/plain',
    'Content-Length' => length($content),
    'Connection'     => $session->{'http'}->{'close'}
    ? qw| close |
    : qw| keep-alive |,
};

$session->{'buffer'}->{'output'}
    .= <[httpd.new_header]>->( $reply_code, $reply_header );
$session->{'buffer'}->{'output'} .= $content;

<[base.logs]>->(
    2,   "[%d] ACME challenge response: %d (body len: %d)",
    $id, $reply_code, length($content)
);

return $session->{'http'}->{'close'} ? 2 : 0;

