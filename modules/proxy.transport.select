## [:< ##

# name  = proxy.transport.select
# descr = delegate to transport.select if co-loaded, else return undef
# args  = $context_hash
# returns transport handle hashref or undef

my $ctx = shift // return undef;

return undef unless exists $code{'transport.select'};

return <[transport.select]>->($ctx);

