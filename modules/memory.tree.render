## [:< ##

# name = memory.tree.render
# descr = walk tree, render visible children, compose parent frame

my $params  = shift                // {};
my $variant = $params->{'variant'} // 'compact';
my $n       = $params->{'n'};

return undef if not defined <memory.tree>;

## [ score lazily — guarded so a scoring bug never kills the render ]##
eval { <[memory.tree.score]>->( { 'node' => <memory.tree> } ) };
if ( my $err = <[base.str.eval_error]> ) {
    <[base.logs]>->( 0, 'memory.tree.score failed: %s', $err );
}

## [ render recursively from root ]##
my $rendered = <[memory.tree.render.node]>
    ->( <memory.tree>, $variant, undef, 0, 1, $n );

return $rendered;

