## [:< ##

# name  = ncode.regex.expand.util.process_candidate
# descr = process a single regex candidate for expansion

my $candidate    = shift;
my $patterns     = shift;
my $max_patterns = shift;
my $threshold    = shift;

my $name    = $candidate->{'name'}    // '';
my $pattern = $candidate->{'pattern'} // '';
my $replace = $candidate->{'replace'};
my $app     = $candidate->{'applicability'} // {};
my $conf    = $app->{'confidence'}          // 0.5;

## validate required fields ##
unless ( length $name and length $pattern ) {
    return {
        'name'   => $name || qw| [unnamed] |,
        'status' => qw| rejected |,
        'reason' => 'missing name or pattern'
    };
}

## compile regex ##
my $compiled = eval {qr/$pattern/};
if ($@) {
    <[base.logs]>->(
        1, ':. ncode.regex.expand: compile failed [%s] :.', $name
    );
    return {
        'name'   => $name,
        'status' => qw| rejected |,
        'reason' => 'regex compilation failed'
    };
}

## check for duplicates (exact pattern string match) ##
my $existing_name = _find_duplicate( $pattern, $patterns );
if ( defined $existing_name ) {
    my $merged = _merge_duplicate( $existing_name, $candidate, $patterns );
    return {
        'name'           => $name,
        'status'         => qw| merged |,
        'merged_with'    => $existing_name,
        'new_confidence' => $merged->{'confidence'}
    };
}

## capacity check ##
my $current_count = scalar keys %$patterns;
if ( $current_count >= $max_patterns ) {
    my $evicted = _evict_and_replace( $candidate, $compiled, $patterns,
        $max_patterns );
    if ( defined $evicted ) {
        <[base.logs]>->(
            1,
            ':. ncode.regex.expand: evicted %s for %s '
                . '[conf %.2f > %.2f] :.',
            $evicted,
            $name,
            $conf,
            $patterns->{$evicted} // 0
        );
        return {
            'name'    => $name,
            'status'  => qw| added |,
            'evicted' => $evicted,
            'reason'  => 'replaced lower confidence pattern'
        };
    } else {
        return {
            'name'   => $name,
            'status' => qw| rejected |,
            'reason' => 'capacity limit reached'
        };
    }
}

## add new pattern ##
$patterns->{$name} = {
    'name'          => $name,
    'descr'         => $candidate->{'descr'} // '',
    'pattern'       => $pattern,
    'compiled'      => $compiled,
    'replace'       => $replace,
    'applicability' => {
        'file_type'  => $app->{'file_type'} // qw| module |,
        'confidence' => $conf,
        'coverage'   => $app->{'coverage'} // qw| partial |
    },
    'origin'      => $candidate->{'origin'}      // qw| expanded |,
    'source_task' => $candidate->{'source_task'} // '',
    'note'        => $candidate->{'note'}        // '',
    'stats'       => {
        'applied'        => 0,
        'false_positive' => 0,
        'skipped'        => 0
    }
};

return {
    'name'   => $name,
    'status' => qw| added |
};

sub _find_duplicate {
    my ( $pattern, $patterns ) = @ARG;

    foreach my $name ( keys %$patterns ) {
        my $existing = $patterns->{$name};
        if ( $existing->{'pattern'} eq $pattern ) {
            return $name;
        }
    }
    return undef;
}

sub _merge_duplicate {
    my ( $existing_name, $candidate, $patterns ) = @ARG;

    my $existing = $patterns->{$existing_name};
    my $old_conf = $existing->{'applicability'}->{'confidence'}  // 0.5;
    my $old_app  = $existing->{'stats'}->{'applied'}             // 0;
    my $new_conf = $candidate->{'applicability'}->{'confidence'} // $old_conf;

    ## weighted average: new_conf = (old_conf * old_applied + candidate_conf)
    ##     / (old_applied + 1) ##
    my $merged_conf = ( $old_conf * $old_app + $new_conf ) / ( $old_app + 1 );

    ## round to 2 decimal places ##
    $merged_conf = sprintf qw| %.2f |, $merged_conf;

    ## update confidence ##
    $existing->{'applicability'}->{'confidence'} = $merged_conf;

    ## update source tracking to most recent ##
    $existing->{'source_task'} = $candidate->{'source_task'}
        if length $candidate->{'source_task'} // '';

    return { 'confidence' => $merged_conf };
}

sub _evict_and_replace {
    my ( $candidate, $compiled, $patterns, $max_patterns ) = @ARG;

    my $app             = $candidate->{'applicability'} // {};
    my $new_conf        = $app->{'confidence'}          // 0.5;
    my $candidate_score = $new_conf * 1;    ## applied = 1 for new ##

    ## find pattern with lowest (confidence * applied) score ##
    my $lowest_name  = undef;
    my $lowest_score = $candidate_score;

    foreach my $name ( keys %$patterns ) {
        my $p     = $patterns->{$name};
        my $conf  = $p->{'applicability'}->{'confidence'} // 0.5;
        my $appd  = $p->{'stats'}->{'applied'}            // 0;
        my $score = $conf * ( $appd + 1 );    ## +1 to avoid zero ##

        if ( $score < $lowest_score ) {
            $lowest_score = $score;
            $lowest_name  = $name;
        }
    }

    ## only replace if we found a lower scoring pattern ##
    return undef unless defined $lowest_name;

    my $name = $candidate->{'name'};

    ## remove evicted pattern ##
    delete $patterns->{$lowest_name};

    ## add new pattern ##
    $patterns->{$name} = {
        'name'          => $name,
        'descr'         => $candidate->{'descr'} // '',
        'pattern'       => $candidate->{'pattern'},
        'compiled'      => $compiled,
        'replace'       => $candidate->{'replace'},
        'applicability' => {
            'file_type'  => $app->{'file_type'} // qw| module |,
            'confidence' => $new_conf,
            'coverage'   => $app->{'coverage'} // qw| partial |
        },
        'origin'      => $candidate->{'origin'}      // qw| expanded |,
        'source_task' => $candidate->{'source_task'} // '',
        'note'        => $candidate->{'note'}        // '',
        'stats'       => {
            'applied'        => 0,
            'false_positive' => 0,
            'skipped'        => 0
        }
    };

    return $name;
}

