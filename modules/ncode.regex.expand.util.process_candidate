## [:< ##

# name  = ncode.regex.expand.util.process_candidate
# descr = process a single regex candidate for expansion

my $candidate    = shift;
my $patterns     = shift;
my $max_patterns = shift;
my $threshold    = shift;

my $name    = $candidate->{'name'}    // '';
my $pattern = $candidate->{'pattern'} // '';
my $replace = $candidate->{'replace'};
my $app     = $candidate->{'applicability'} // {};
my $conf    = $app->{'confidence'}          // 0.5;

## validate required fields ##
unless ( length $name and length $pattern ) {
    return {
        'name'   => $name || qw| [unnamed] |,
        'status' => qw| rejected |,
        'reason' => 'missing name or pattern'
    };
}

## compile regex ##
my $compiled = eval {qr/$pattern/};
if ($@) {
    <[base.logs]>->(
        1, ':. ncode.regex.expand: compile failed [%s] :.', $name
    );
    return {
        'name'   => $name,
        'status' => qw| rejected |,
        'reason' => 'regex compilation failed'
    };
}

## check for duplicates (exact pattern string match) ##
my $existing_name
    = <[ncode.regex.expand.util.find_duplicate]>->( $pattern, $patterns );
if ( defined $existing_name ) {
    my $merged = <[ncode.regex.expand.util.merge_duplicate]>->(
        $existing_name, $candidate, $patterns
    );
    return {
        'name'           => $name,
        'status'         => qw| merged |,
        'merged_with'    => $existing_name,
        'new_confidence' => $merged->{'confidence'}
    };
}

## capacity check ##
my $current_count = scalar keys %$patterns;
if ( $current_count >= $max_patterns ) {
    my $evicted = <[ncode.regex.expand.util.evict_and_replace]>->(
        $candidate, $compiled, $patterns, $max_patterns
    );
    if ( defined $evicted ) {
        <[base.logs]>->(
            1,
            ':. ncode.regex.expand: evicted %s for %s [conf %.2f > %.2f] :.',
            $evicted,
            $name,
            $conf,
            $patterns->{$evicted} // 0
        );
        return {
            'name'    => $name,
            'status'  => qw| added |,
            'evicted' => $evicted,
            'reason'  => 'replaced lower confidence pattern'
        };
    } else {
        return {
            'name'   => $name,
            'status' => qw| rejected |,
            'reason' => 'capacity limit reached'
        };
    }
}

## approval-gate status : only high-confidence full-coverage candidates ##
## enter as trusted auto-apply rules ; everything else still persists [ ##
## below-threshold is NOT a rejection ] but requires per-fix review     ##
my $entry_status
    = ( $conf >= $threshold and ( $app->{'coverage'} // '' ) eq qw| full | )
    ? qw| auto-apply |
    : qw| llm-required |;

## add new pattern ##
$patterns->{$name} = {
    'name'          => $name,
    'status'        => $entry_status,
    'descr'         => $candidate->{'descr'} // '',
    'pattern'       => $pattern,
    'compiled'      => $compiled,
    'replace'       => $replace,
    'applicability' => {
        'file_type'  => $app->{'file_type'} // qw| module |,
        'confidence' => $conf,
        'coverage'   => $app->{'coverage'} // qw| partial |
    },
    'origin'      => $candidate->{'origin'}      // qw| expanded |,
    'source_task' => $candidate->{'source_task'} // '',
    'note'        => $candidate->{'note'}        // '',
    'stats'       => {
        'applied'        => 0,
        'false_positive' => 0,
        'skipped'        => 0
    },
    ## review-time outcomes [ sibling to stats, not merged : a decline is a ##
    ## correct conservative call, not an apply-time false_positive ]        ##
    'review' => {
        'approved_streak' => 0,
        'declined'        => 0
    }
};

return {
    'name'   => $name,
    'status' => qw| added |
};

