## [:< ##

# name  = sessions.cmd.hold
# descr = hold a caller-supplied secret under a name
# param = <name> <secret_b32>

my $args = $call->{'args'} // '';
$args =~ s/^\s+|\s+$//g;

my ( $name, $secret_b32 ) = split q| |, $args, 2;
$name       //= '';
$secret_b32 //= '';

return {
    'mode' => qw| size |,
    'data' => "<< usage: hold <name> " . "<secret_b32> >>\n"
    }
    if not length $name or not length $secret_b32;

return { 'mode' => qw| size |, 'data' => "<< invalid name >>\n" }
    if $name !~ m|^[\w\-]+$|;

my $ok = <[sessions.util.secret.start_child]>->( $name, $secret_b32 );

return {
    'mode' => qw| size |,
    'data' => sprintf( "%s\n", $ok ? "held $name" : "<< hold failed >>" )
};

