## [:< ##

# name  = source.signature_valid

## input parameters ##
my $payload_sref          = shift // '';
my $signature_footer_data = shift;
my $truth_checks          = shift // {};    ##  optional  ##
my $key_name_param        = shift;          ##  optional  ##
my $mode = shift // 'strict';    # Options: 'strict', 'repair', 'update'

map {    ## early exit without further validation ##
    if ( defined $signature_footer_data->{$ARG}
        and not $signature_footer_data->{$ARG} ) {

        return ( FALSE, { $ARG => FALSE } ) if wantarray;
        return FALSE;
    }
} qw| was-present structure-was-valid |;

map {    ## verify presence of footer data parameters ##
    if ( not defined $signature_footer_data->{$ARG} ) {
        <[base.s_warn]>->(
            "footer data key '%s' is not present <{C1}>", $ARG
        ) if not exists $signature_footer_data->{$ARG};

        return ( FALSE, { $ARG => FALSE } ) if wantarray;
        return FALSE;
    }
    } qw| was-present structure-was-valid data-reference amos-payload-checksum
    amos-iterations-remaining endline-state-encoded checksum-type bmw-chksum
    signature-type signature footer-length-found signature-footer-str |;

##  return values  ## 5 == TRUE,  0 == FALSE ##
##
my $verified_true = TRUE; ## signature valid and essential checks succeeded ##

##[ truth validation setting constants ]##
##
use constant RQ => TRUE;  ##  TRUTH REQUIRED [ essential ]  ##
use constant OP => 2;     ##  optional [ only report ]  ##

##  default enabled checks  ##
my $truth_check_settings = {

    ##  essential [ overall status false when absent ]  ##
    ##
    qw| footer-bmw          | => RQ,
    qw| entire-payload      | => RQ,
    qw| signature-as-parts  | => RQ,
    qw| signature-complete  | => RQ,
    qw| single-footer-lines | => RQ,

    qw| embedded-code-style | => OP,    ##  optional [ only report ]  ##
    qw| footer-complete     | => OP,    ##  optional [ only report ]  ##
};

##  returned as second [ in list context ]  ##
my $truth_status_report = { qw| bmw-chksum-matches | => FALSE };

warn 'expecting scalar reference to payload <{C1}>' and return undef
    if ref $payload_sref ne qw| SCALAR |;
warn 'payload data not defined <{C1}>' if not defined $payload_sref->$*;
warn 'footer data is not a hash reference <{C1}>'
    and return undef
    if defined $signature_footer_data
    and ref $signature_footer_data ne qw| HASH |;
warn 'truth check set-up is not a hash ref. <{C1}>'
    and return undef
    if defined $truth_checks
    and ref $truth_checks ne qw| HASH |;

##  setting option defaults  ##
while ( my ( $param_key, $set ) = each $truth_check_settings->%* ) {
    $truth_checks->{$param_key} //= $set;
}

my $ELFmode         = 7;   ###  ELF chksum mode for AMOS-chksum generation  ##
my @t_elf_modes     = qw| 4 7 |;    ## elf modes for truth assertion ##
my $footer_bit_size = <source.chksum_bitsize>; ## footer BMW bits [ 384 ] ##
my $AMOS_bitsize    = 512;                     ## AMOS checksum BMW bitsize ##

my $footer_as_string = $signature_footer_data->{'signature-footer-str'};

##  strip signature if not done already  ##
if ( not defined $signature_footer_data
    or defined $footer_as_string
    and $payload_sref->$* =~ m|$footer_as_string$| ) {

    $signature_footer_data    ##  endline state is restored during strip  ##

        #        = <[source.extract_sig_body]>->( $payload_sref, , $mode );
        = <[source.extract_sig_body]>->( $payload_sref, qw| strip |, $mode );

    # Check for missing separator endline with appropriate mode handling
    # (no debug output needed in normal operation)
}

## no valid signature footer was found ##
##
if ( not $signature_footer_data->{'was-present'} ) {
    <[base.s_warn]>->('file has no signature footer (unsigned file)');
    <[base.logs]>->( 2, ': validation failed: file is unsigned' );
    return ( FALSE, { 'footer-was-present' => FALSE } ) if wantarray;
    return FALSE;
} elsif ( not $signature_footer_data->{'structure-was-valid'} ) {
    return ( FALSE, { 'footer-structure-was-valid' => FALSE } ) if wantarray;
    return FALSE;
} elsif ( $signature_footer_data->{'needs_separator_endline'} ) {

    # Record the issue regardless of mode
    $truth_status_report->{'footer-needs-separator-endline'} = TRUE;

    # Only fail in strict mode
    if ( $mode eq 'strict' ) {

        # Consider signatures with missing separator endlines as invalid
        # so they will be updated by the signature process
        $verified_true = FALSE;
        return ( FALSE, { 'footer-needs-separator-endline' => TRUE } )
            if wantarray;
        return FALSE;
    }

    # In repair mode, try different endline states
    if ( $mode eq 'repair' ) {
        <[base.log]>->(
            1, ': attempting to repair by trying different endline states'
        );
        <[base.logs]>->(
            2,
            ': needs_separator_endline = %s',
            $signature_footer_data->{'needs_separator_endline'}
            ? 'TRUE'
            : 'FALSE'
        );

        # Store original reference and content
        my $original_ref     = $payload_sref;
        my $original_content = $$original_ref;

        # Track if we found a valid repair
        my $repaired       = FALSE;
        my $repaired_state = 5;       # Default state

        # Try different endline states
        foreach my $test_state ( 6, 7, 5 ) {  # Order by likelihood of success
            <[base.logs]>->( 2, ': : testing endline state %d', $test_state );

            # Create a temporary copy of the content
            my $test_content = $original_content;

            # Apply the endline state
            if ( $test_state == 6 ) {

                # Add separator endline only
                $test_content =~ s|(\n*)$|$1\n|;
                <[base.log]>->( 2, ': : adding separator endline' );
            } elsif ( $test_state == 7 ) {

                # Add both complete line and separator endlines
                $test_content =~ s|(\n*)$|$1\n\n|;
                <[base.log]>->(
                    2, ': : adding complete line and separator endlines'
                );
            }

            <[base.logs]>->(
                2, ': : testing with endline state %d content length %d',
                $test_state, length($test_content)
            );

            # Create a temporary reference for testing
            my $temp_ref = \$test_content;

            # Create a copy of the footer data for testing
            my %test_footer_data = %$signature_footer_data;
            $test_footer_data{'data-reference'}          = $temp_ref;
            $test_footer_data{'endline-state-encoded'}   = $test_state;
            $test_footer_data{'needs_separator_endline'} = FALSE;

            # Extract the signature again with the modified content
            my $test_sig_data = <[source.extract_sig_body]>
                ->( $temp_ref, qw| strip |, $mode );

            # Log extraction results
            <[base.log]>->( 2, ': : signature extraction results:' );
            <[base.logs]>->(
                2,
                ': : : was-present: %s',
                $test_sig_data->{'was-present'} ? 'TRUE' : 'FALSE'
            );
            <[base.logs]>->(
                2,
                ': : : structure-was-valid: %s',
                $test_sig_data->{'structure-was-valid'} ? 'TRUE' : 'FALSE'
            );

            if ( $test_sig_data->{'encountered-error'} ) {
                <[base.logs]>->(
                    2,
                    ': : : error: %s',
                    $test_sig_data->{'encountered-error'}
                );
            }

            # Skip if extraction failed
            next
                if not $test_sig_data->{'was-present'}
                or not $test_sig_data->{'structure-was-valid'};

            # Try full verification with the extracted signature
            my $test_verified
                = <[source.signature.util.verify_signature_with_data]>->(
                $temp_ref, $test_sig_data, $truth_checks, $key_name_param
                );

            if ($test_verified) {
                <[base.logs]>->(
                    1, ': successfully repaired with endline state %d',
                    $test_state
                );

                # Update the original data with the fixed version
                $$original_ref = $test_content;

                # Update footer data with the fixed values
                $signature_footer_data               = $test_sig_data;
                $signature_footer_data->{'repaired'} = TRUE;
                $signature_footer_data->{'repaired-with-state'} = $test_state;

                $repaired       = TRUE;
                $repaired_state = $test_state;

                # Set verification result to true
                $verified_true                                = TRUE;
                $truth_status_report->{'repaired'}            = TRUE;
                $truth_status_report->{'repaired-with-state'} = $test_state;

                # Break out of the loop
                last;
            }
        }

        # If endline state changes didn't work, try signature reconstruction
        if ( !$repaired && $signature_footer_data->{'template'} ) {
            <[base.log]>->( 1, ': attempting signature reconstruction' );

            # Get the template and other stored data
            my $template     = $signature_footer_data->{'template'};
            my $footer_start = $signature_footer_data->{'footer-start-line'};
            my $bmw_chksum   = $signature_footer_data->{'bmw-chksum'} // '';
            my $signature    = $signature_footer_data->{'signature'}  // '';

            # If we have the needed components, try reconstruction
            if ( $footer_start && $bmw_chksum && $signature ) {
                <[base.log]>->(
                    2, ': reconstructing signature from components'
                );

              # Create the reconstructed footer, following the template format
              # but using our extracted values
                my $reconstructed_footer = $footer_start;

                # Insert the checksums and signature into the right positions
                my $template_copy = $template;

  # We need to carefully quote the replacement patterns to avoid syntax errors
  # Use simple string replacement instead of regex for these complex strings
                $template_copy
                    =~ s|\\\\\\\\||;    # Remove first backslash sequence
                $template_copy
                    =~ s|\\\\\\\\|$bmw_chksum\\\\\\\\|;  # Insert BMW checksum
                $template_copy =~ s|\\\\\\\\\[7\]||; # Remove signature marker
                $template_copy =~ s|\\\\\\\\\[7\]|$signature\\\\\\\[7\]|
                    ;                                # Insert signature

                # Attach the reconstructed footer
                if ($signature_footer_data->{
                        'original_separator_endline_absent'}
                ) {
                    # Add a separator endline if it was missing
                    $$original_ref .= "\n" . $template_copy;
                } else {
                    $$original_ref .= $template_copy;
                }

                <[base.log]>->(
                    1, ': signature reconstructed and appended to file'
                );

                # Update footer data with the reconstructed values
                $signature_footer_data->{'reconstructed'} = TRUE;
                $signature_footer_data->{'repaired'}      = TRUE;

                # Set verification result to true
                $verified_true                          = TRUE;
                $truth_status_report->{'reconstructed'} = TRUE;
                $truth_status_report->{'repaired'}      = TRUE;

                # Return with success
                return ( TRUE, $truth_status_report ) if wantarray;
                return TRUE;
            }
        }

        if ($repaired) {

            # Continue with successful repair
            return ( TRUE, $truth_status_report ) if wantarray;
            return TRUE;
        } else {
            <[base.log]>->(
                1,
                ': repair attempts failed, allowing validation despite issues'
            );
        }
    }

    # If we get here, repair mode couldn't fix it or we're in a different mode
    <[base.log]>->(
        1,
        ': allowing validation despite missing separator endline (repair '
            . 'mode)'
    ) if $mode ne 'strict';
}

my $found_footer_length = $signature_footer_data->{'footer-length-found'};
my $footer_bmw          = $signature_footer_data->{'data-chksum'};

##  initialize elf start chksum values  ##
my $elf_chksum = {
    qw|   entire-payload     | => { map { $ARG => 0 } @t_elf_modes },
    qw| embedded-code-style  | => { map { $ARG => 0 } @t_elf_modes }
};

my $data_pos     = 0;
my $read_length  = 4282;
my $content_size = length $payload_sref->$*;

##  array refs [ <chksum_name>, [chksum_param[s]] ],
##
my $chksum_parameters = [];
##
## my $chksum_parameters = shift // [];

my @embedded_params;

##  embedded code style syntax  ##
##
@embedded_params = map {    ##  [ embedded code style ] line prefix  ##
    [ qw| ELF-7 |, $code{'base.parser.chk-sum.embedded-code-style'}, $ARG ]
    } @t_elf_modes
    if $truth_check_settings->{'embedded-code-style'};
##

$chksum_parameters = [      ##  data checksum set-up  ##

    ##  FOOTER ELF CHKSUM  ## [ 4 7 ]
    ( map { [ qw| ELF-7 |, $ARG ] } @t_elf_modes ),

    [qw | BMW 384 |],       ##  FOOTER BMW CHKSUM  ## [ 384 ]

    [ qw| ELF-7 |, $ELFmode ],    ##  AMOS7 ELF CHKSUM  ## [ 7 ]
    [qw | BMW-bin 512 |],         ##  AMOS7 BMW CHKSUM  ## [ 512 ]

    @embedded_params              ##  embedded code style syntax  ##
];
##
###

my @chksum_results = <[base.chk-sum.from_substr]>->(
    $payload_sref, $data_pos, $content_size, $chksum_parameters, $read_length
);

##  removing BMW ctx objects  ##
##
my $BMW_objects_ref = pop @chksum_results;
my $bmw_start_ctx   = shift $BMW_objects_ref->@*;    ##[ BMW 384 ]##
my $bmw_amos_ctx    = shift $BMW_objects_ref->@*;    ##[  BMW 512  ]##

##  FOOTER ELF CHKSUM  ## [ 4 7 ]
##
map { $elf_chksum->{'entire-payload'}->{$ARG} = shift @chksum_results }
    @t_elf_modes;

shift @chksum_results;    ##  strip footer BMW checksum  ##
shift @chksum_results;    ##  stripping amos-ELF checksum  ##

##  AMOS7 BMW CHKSUM  ## [ 512 ]
my $amos_digest_bin = shift @chksum_results;

##  embedded code style syntax  ##
#
map { $elf_chksum->{'embedded-code-style'}->{$ARG} = shift @chksum_results }
    @t_elf_modes
    if $truth_check_settings->{'embedded-code-style'};

##  validating payload + footer and embedded code style elf  ##
#
foreach my $type (qw| entire-payload embedded-code-style |) {

    if ( $truth_check_settings->{$type} ) {    ##  full payload true ?  ##
        $truth_status_report->{$type} = {
            map {

                my $test_elf = $elf_chksum->{$type}->{$ARG};

                ##  add footer  ##
                $test_elf = <[chk-sum.elf]>->(
                    \$signature_footer_data->{'signature-footer-str'},
                    $elf_chksum->{$type}->{$ARG}, $ARG
                ) if $type eq qw| entire-payload |;

                $ARG => AMOS7::Assert::Truth::true_int($test_elf)

            } @t_elf_modes
        };

        next if $truth_check_settings->{$type} < RQ;    ##  not essential  ##

        foreach my $__elfmode (@t_elf_modes) {
            if ( not $truth_status_report->{$type}->{$__elfmode} ) {
                $verified_true = FALSE;                 ##  overall status  ##
                last;
            }
        }
    }
}

my $AMOS_B32 = AMOS7::CHKSUM::amos_chksum(   ##[  AMOS7-elf chksum mode 7  ]##
    {   qw| elf-shift-bits | => 13,
        qw| elf-modes      | => [ 4, 7 ],
        qw| elf_checksum   | => $elf_chksum->{'entire-payload'}->{$ELFmode},
        qw| BMW_checksum   | => $amos_digest_bin    ##  512 bits [bin]  ##
    }
);

if ( $AMOS_B32 eq $signature_footer_data->{'amos-payload-checksum'} ) {
    $truth_status_report->{'AMOS-chksum-matches'} = TRUE;    ## true ##
} else {
    $truth_status_report->{'AMOS-chksum-matches'} = FALSE;    ##  false  ##

    # In strict or update mode, reject any checksum mismatch
    if ( $mode eq 'strict' or $mode eq 'update' ) {
        $verified_true = FALSE;                               ##  false  ##
        return ( $verified_true, $truth_status_report ) if wantarray;
        return $verified_true;    ## end assertion ##
    } else {

        # In repair mode, log and continue with mismatch
        if ( $mode eq 'repair' ) {
            <[base.logs]>->(
                1, ': AMOS checksum mismatch but continuing in repair mode'
            );
            <[base.logs]>->(
                2,
                ': expected %s, got %s',
                $signature_footer_data->{'amos-payload-checksum'}, $AMOS_B32
            );
        }
        $truth_status_report->{'amos_checksum_mismatch_ignored'} = TRUE;
    }
}

## add start line + # to checksum ##
$bmw_start_ctx->add( sprintf '%s#',
    $signature_footer_data->{'footer-start-line'} );

##  calculating footer BMW checksum  ##
$footer_bmw = <[chk-sum.bmw.encode_digest]>->($bmw_start_ctx);

if ( $footer_bmw eq $signature_footer_data->{'bmw-chksum'} ) {
    $truth_status_report->{'bmw-chksum-matches'} = TRUE;    ## true ##
} else {
    $truth_status_report->{'bmw-chksum-matches'} = FALSE;    ##  false  ##

    # In strict or update mode, reject any checksum mismatch
    if ( $mode eq 'strict' or $mode eq 'update' ) {
        $verified_true = FALSE;                              ##  false  ##
        return ( $verified_true, $truth_status_report ) if wantarray;
        return $verified_true;    ## end assertion ##
    } else {

# In repair mode, attempt to recover the correct endline-state via brute-force
        if ( $mode eq 'repair' ) {
            <[base.logs]>->( 1, ': [ file checksum changed ]' );
            <[base.logs]>->(
                1,
                ': BMW checksum mismatch - attempting endline-state recovery'
            );
            <[base.logs]>->(
                2,
                ': expected %s, got %s',
                $signature_footer_data->{'bmw-chksum'}, $footer_bmw
            );
        }

        # Try to find the correct endline-state by brute-forcing
        my $recovered_state = undef;

        foreach my $try_state ( 0 .. 7 ) {
            <[base.logs]>->( 2, ': trying endline-state %d', $try_state )
                if $mode eq 'repair';

            # Apply the endline restoration for this state
            my $test_payload = $$payload_sref;
            if ( $try_state == 0 or $try_state < 5 ) {

               # Remove endlines: state 0 = remove 4, state 1 = remove 3, etc.
                my $remove_count = 4 - $try_state;
                $test_payload =~ s|\n{$remove_count,}$|\n|s
                    if $remove_count > 0;
            } elsif ( $try_state == 6 ) {

                # Add 1 endline (separator)
                $test_payload =~ s|(\n*)$|$1\n|s;
            } elsif ( $try_state == 7 ) {

                # Add 2 endlines (complete line + separator)
                $test_payload =~ s|(\n*)$|$1\n\n|s;
            }

            # Recalculate BMW with the test payload
            my $test_bmw_ctx = $bmw_start_ctx->clone;
            $test_bmw_ctx->add( sprintf '%s#',
                $signature_footer_data->{'footer-start-line'} );
            my $test_bmw = <[chk-sum.bmw.encode_digest]>->($test_bmw_ctx);

            <[base.logs]>->( 2, ': state %d BMW: %s', $try_state, $test_bmw )
                if $mode eq 'repair';

            # Check if this state's BMW matches the signature
            if ( $test_bmw eq $signature_footer_data->{'bmw-chksum'} ) {
                if ( $mode eq 'repair' ) {
                    <[base.logs]>->(
                        1, ': recovered correct endline-state: %d',
                        $try_state
                    );
                }
                $recovered_state = $try_state;
                $truth_status_report->{'bmw-chksum-matches'} = TRUE;
                $truth_status_report->{'recovered-endline-state'}
                    = $try_state;
                last;
            }
        }

        if ( defined $recovered_state ) {

            # Update footer data with recovered state for next signing cycle
            $signature_footer_data->{'endline-state-encoded'}
                = $recovered_state;
            if ( $mode eq 'repair' ) {
                <[base.logs]>->(
                    1, ': endline-state recorded for next signing cycle'
                );
            }
        } else {

            # Brute-force failed, continue with mismatch noted
            $truth_status_report->{'bmw_checksum_mismatch_ignored'} = TRUE;
        }
    }
}

##  checking signature validity  ##
#                          ##  up to signature string  ##
my $signed_data_str = substr( $footer_as_string, 0, 163 );
my $signature_str   = $signature_footer_data->{'signature'};

my $sig_valid = 0;
eval {
    $sig_valid = <[crypt.C25519.verify_sign]>->(
        \$signed_data_str, \$signature_str, $key_name_param
    ) ? 1 : 0;
};

if ($sig_valid) {
    $truth_status_report->{'signature-is-valid'} = TRUE;    ## true ##
} else {
    $truth_status_report->{'signature-is-valid'} = FALSE;    ##  false  ##

    # In strict or update mode, reject invalid signatures
    if ( $mode eq 'strict' or $mode eq 'update' ) {
        <[base.logs]>
            ->( 0, ': [ checksum correct but signature not valid ]' );
        $verified_true = FALSE;    ##  false  ##
        return ( $verified_true, $truth_status_report ) if wantarray;
        return $verified_true;     ## end assertion ##
    } else {

        # In repair mode, log and continue with signature verification issues
        if ( $mode eq 'repair' ) {
            <[base.logs]>->(
                1, ':!: C25519 signature verification failed but :'
            );
            <[base.logs]>->(
                1, ':!: :.     ..continuing in repair mode ..   .:'
            );
        }
        $truth_status_report->{'signature_verification_ignored'} = TRUE;
    }
}

## checking footer as block ##
#
foreach my $type (qw| footer-complete |) {    ## [..,]

    if ( $truth_check_settings->{$type} ) {    ##  elf-checksums true ?  ##

        $truth_status_report->{$type} = {
            map {
                $ARG => AMOS7::Assert::Truth::true_int(
                    $elf_chksum->{$type}->{$ARG} //= FALSE )
            } @t_elf_modes
        };

        map {
            $verified_true = FALSE    ##  overall status  ##
                if $verified_true
                and not $truth_status_report->{$type}->{$ARG}
            } @t_elf_modes
            if $truth_check_settings->{$type} == RQ;    ##  essential  ##
    }
}

##  returning report  ##
##
return ( $verified_true, $truth_status_report ) if wantarray;
return $verified_true;

