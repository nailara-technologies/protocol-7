# name  = decoder.cmd.receive-entropy
# descr = Command wrapper for decoder.zenka.receive_entropy
# param = <stream_id> <entropy_bits>

my ( $stream_id, $entropy ) = split m| +|, $call->{'args'} // '', 2;

return {
    'mode' => qw| false |,
    'data' => 'expected: <stream_id> <entropy_bits>'
    }
    unless defined $stream_id && defined $entropy;

return <[decoder.zenka.receive_entropy]>->(
    {   'stream_id' => $stream_id,
        'entropy'   => $entropy,
    }
);

