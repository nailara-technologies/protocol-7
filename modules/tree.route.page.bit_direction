# name = tree.route.page.bit_direction
# descr = return left/right for group index in decoded word

my $decoded = shift // {};
my $index   = shift // 0;

return undef
    if ref $decoded ne qw| HASH |
    or not exists $decoded->{'leading'};

my $leading = $decoded->{'leading'};
return undef if ref $leading ne qw| ARRAY |;
return undef if $index < 0 or $index > 7;

## [ group 7 ] = leading '0' = carry = LEFT ##
## [ groups 0-6 ] = leading '1' = awaiting = RIGHT ##

return $leading->[$index] eq qw| 0 | ? qw| left | : qw| right |;

