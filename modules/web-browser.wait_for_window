## [:< ##

# name = web-browser.wait_for_window

( my $wait_title_str = <web-browser.window.title_str> )
    =~ s|([\[\]\.])|\\$1|g;

if ( <[window.gtk.is_mapped]>->(<web-browser.gtk_obj.window>) ) {
    ## get X11 window ID directly from GTK — requires GdkX11 introspection ##
    eval {
        Glib::Object::Introspection->setup(
            basename => 'GdkX11',
            version  => '3.0',
            package  => 'Gdk::X11'
        );
    };
    my $gdk_win = <web-browser.gtk_obj.window>->get_window;
    if ( defined $gdk_win ) {
        my $xid = eval { $gdk_win->get_xid };
        if ( defined $xid ) {
            <x11.id> = $xid;
            <[base.logs]>->(
                2, ': window mapped, X11 id: %d (gtk)', <x11.id>
            );
        } else {
            <[base.log]>->( 2, ': window mapped (gtk), X11 id unavailable' );
        }
    }
} else {
    unless ( <[base.X-11.wait_for_window]>->( '^' . $wait_title_str ) ) {
        <[base.log]>->(
            0, '<< window cannot open, aborting zenka start-up. >>'
        );
        <[base.exit]>->( ':. ending process [ window timed out ].,', 2, 2 );
    }
}

<[base.X-11.assign_window]>;
<[base.async.get_session_id]>;

