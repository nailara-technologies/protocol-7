## [:< ##

# name  = letsencrypt.cmd.inst-self-signed
# descr = Generate and install a self-signed Ed25519 ECDSA certificate for local testing

use File::Temp qw(tempfile);
use File::Spec;

<[base.log]>->( 2, 'inst-self-signed command requested' );

# Certificate paths from httpsd config
my $cert_dir  = '/etc/protocol-7/certs';
my $cert_path = <httpsd.cfg.certificate_path> // "$cert_dir/current.pem";
my $key_path  = <httpsd.cfg.key_path> // "$cert_dir/current.key";

## Check if certificates already exist
if ( -f $cert_path && -f $key_path ) {
    <[base.log]>->( 2, 'certificates already installed' );
    return {
        'mode' => 'inline',
        'data' => "✓ Self-signed certificate already installed at:\n  Cert: $cert_path\n  Key:  $key_path\n"
    };
}

<[base.log]>->( 2, 'generating self-signed Ed25519 ECDSA certificate...' );

## Ensure certificate directory exists
unless ( -d $cert_dir ) {
    mkdir( $cert_dir, 0700 ) or do {
        my $err = "error: failed to create directory $cert_dir: $!";
        <[base.log]>->( 1, $err );
        return {
            'mode' => 'inline',
            'data' => "✗ Failed to create certificate directory:\n  $err\n"
        };
    };
    <[base.log]>->( 2, "created certificate directory: $cert_dir" );
}

## Generate private key (Ed25519)
<[base.log]>->( 2, 'generating Ed25519 private key...' );

my ( $temp_key_fh, $temp_key_file ) = tempfile( UNLINK => 1 );
close($temp_key_fh);  # Close so openssl can write to it

my $key_result = system("openssl genpkey -algorithm Ed25519 -out '$temp_key_file' 2>/dev/null");

unless ( -f $temp_key_file && -s $temp_key_file && $key_result == 0 ) {
    <[base.log]>->( 1, 'error: failed to generate Ed25519 key' );
    return {
        'mode' => 'inline',
        'data' => "✗ Failed to generate Ed25519 private key\n"
    };
}

<[base.log]>->( 2, 'Ed25519 key generated successfully' );

## Generate self-signed certificate (365 days, no intermediate processing)
<[base.log]>->( 2, 'generating self-signed certificate...' );

my ( $temp_cert_fh, $temp_cert_file ) = tempfile( UNLINK => 1 );
close($temp_cert_fh);  # Close so openssl can write to it

my $cert_result = system("openssl req -new -x509 -key '$temp_key_file' " .
    "-out '$temp_cert_file' -days 365 -subj '/CN=localhost' 2>/dev/null");

unless ( -f $temp_cert_file && -s $temp_cert_file && $cert_result == 0 ) {
    <[base.log]>->( 1, 'error: failed to generate self-signed certificate' );
    return {
        'mode' => 'inline',
        'data' => "✗ Failed to generate self-signed certificate\n"
    };
}

<[base.log]>->( 2, 'self-signed certificate generated successfully' );

## Install certificate to final location
<[base.log]>->( 2, "installing certificate to $cert_path" );

unless ( copy_file( $temp_cert_file, $cert_path ) ) {
    <[base.log]>->( 1, "error: failed to install certificate to $cert_path" );
    return {
        'mode' => 'inline',
        'data' => "✗ Failed to install certificate to $cert_path\n"
    };
}

unless ( chmod( 0600, $cert_path ) ) {
    <[base.log]>->( 1, "warning: could not set permissions on $cert_path" );
}

<[base.log]>->( 2, "certificate installed successfully" );

## Install private key to final location
<[base.log]>->( 2, "installing private key to $key_path" );

unless ( copy_file( $temp_key_file, $key_path ) ) {
    <[base.log]>->( 1, "error: failed to install private key to $key_path" );
    return {
        'mode' => 'inline',
        'data' => "✗ Failed to install private key to $key_path\n"
    };
}

unless ( chmod( 0600, $key_path ) ) {
    <[base.log]>->( 1, "warning: could not set permissions on $key_path" );
}

<[base.log]>->( 2, "private key installed successfully" );

## Build response
my $reply = "✓ Self-signed certificate successfully generated and installed\n\n";
$reply .= ":  INSTALLATION SUMMARY\n";
$reply .= ":    Certificate: $cert_path\n";
$reply .= ":    Private Key: $key_path\n";
$reply .= ":    Validity:    365 days\n";
$reply .= ":    Algorithm:   Ed25519 ECDSA\n";
$reply .= ":    CN:          localhost\n";
$reply .= ":\n";
$reply .= ":  USAGE\n";
$reply .= ":    This certificate is suitable for local testing only.\n";
$reply .= ":    Browsers will show security warnings (expected for self-signed certs).\n";
$reply .= ":\n";
$reply .= ":  NEXT STEPS\n";
$reply .= ":    1. Reload httpsd to use the new certificate\n";
$reply .= ":    2. Test with: curl -k -s https://localhost/\n";
$reply .= ":\n";

return {
    'mode' => 'inline',
    'data' => $reply
};

## Helper function to safely copy files
sub copy_file {
    my ( $src, $dst ) = @_;

    open( my $src_fh, '<:raw', $src ) or return undef;
    local $/;
    my $content = <$src_fh>;
    close($src_fh);

    open( my $dst_fh, '>:raw', $dst ) or return undef;
    print $dst_fh $content;
    close($dst_fh);

    return 1;
}

