## [:< ##

# name  = base.stream.push
# descr = append one data frame to an open STRM / STRM-SIZE stream ;
#         producer-side gate : returns 0 if session gone / cancelled /
#         producer state cleared, so caller loops exit on return-zero
# param = <handle> <chunk_ref>
# return = bytes written, 0 if gated

my ( $h, $chunk_ref ) = @ARG;

return 0 if not defined $h or ref $h ne qw| HASH |;
return 0 if not defined $chunk_ref;

my $chunk     = ref $chunk_ref eq qw| SCALAR | ? $$chunk_ref : $chunk_ref;
my $chunk_len = bytes::length($chunk);
return 0 if $chunk_len == 0;

my $sid    = $h->{'sid'};
my $cmd_id = $h->{'cmd_id'};
my $type   = $h->{'type'};

my $session = <[base.stream.gate]>->( $sid, $cmd_id, 1 );
return 0 if not defined $session;

my $cmd_id_str = $session->{'streams'}->{$cmd_id}->{'cmd_id_str'} // '';

my $frame = sprintf "%s%s %d\n%s", $cmd_id_str, $type, $chunk_len, $chunk;

my $written = bytes::length($frame);
$session->{'buffer'}->{'output'} .= $frame;

$session->{'streams'}->{$cmd_id}->{'sent_bytes'} += $chunk_len;

<[base.stream.record_emission]>->( $sid, $cmd_id, $written, $type );

return $written;

