## [:< ##

# name  = letsencrypt.base.init_code
# descr = Initialize Let's Encrypt ACME client zenka with configuration and utilities

<[base.log]>->( 2, 'initializing Let\x27s Encrypt ACME client zenka..,' );

## ACME Server Configuration (with defaults)
<letsencrypt.acme.server> = <letsencrypt.acme.server>
    || 'https://acme-v02.api.letsencrypt.org/directory';
<letsencrypt.admin.email> = <letsencrypt.admin.email> || 'admin@example.com';

## Certificate Storage (with defaults)
<letsencrypt.certs.dir> = <letsencrypt.certs.dir> || '/etc/protocol-7/certs';
<letsencrypt.certs.backup>
    = <letsencrypt.certs.backup> || '/var/protocol-7/certs';

## Renewal Configuration (with defaults)
<letsencrypt.renewal.days-before> = <letsencrypt.renewal.days-before> || 30;
<letsencrypt.renewal.check-interval>
    = <letsencrypt.renewal.check-interval> || 3600;
<letsencrypt.renewal.retry-delay> = <letsencrypt.renewal.retry-delay> || 300;

## Cache Configuration (with defaults)
<letsencrypt.cache.dir> = <letsencrypt.cache.dir> || '/var/cache/letsencrypt';
<letsencrypt.cache.timeout> = <letsencrypt.cache.timeout> || 86400;

## Challenge Configuration (with defaults)
<letsencrypt.challenge.type>    = <letsencrypt.challenge.type> || 'http-01';
<letsencrypt.challenge.timeout> = <letsencrypt.challenge.timeout> || 300;

## Rate Limiting Configuration (with defaults)
<letsencrypt.ratelimit.enabled> = <letsencrypt.ratelimit.enabled> || 1;
<letsencrypt.ratelimit.max-per-hour>
    = <letsencrypt.ratelimit.max-per-hour> || 5;

## Initialize statistics and state
<letsencrypt.stats> = {
    certificates_active   => 0,
    certificates_expiring => 0,
    renewals_completed    => 0,
    renewals_failed       => 0,
    challenges_succeeded  => 0,
    challenges_failed     => 0,
    last_renewal_check    => 0,
    acme_account_created  => 0,
};

## Initialize certificate registry
<letsencrypt.certs.registry> = {};

## Initialize renewal queue
<letsencrypt.renewal.queue> = [];

## Initialize challenge handlers
<letsencrypt.challenges> = {
    'http-01' => {
        handler => 'letsencrypt.handler.acme_challenge_http01',
        timeout => <letsencrypt.challenge.timeout>,
    },
    'dns-01' => {
        handler => 'letsencrypt.handler.acme_challenge_dns01',
        timeout => <letsencrypt.challenge.timeout>,
    },
};

## Validate certificate directories exist or create them
my @dir_configs = (
    [ 'certs.dir',    <letsencrypt.certs.dir> ],
    [ 'certs.backup', <letsencrypt.certs.backup> ],
    [ 'cache.dir',    <letsencrypt.cache.dir> ],
);

foreach my $config (@dir_configs) {
    my ( $name, $dir ) = @$config;
    if ( !-d $dir ) {
        <[base.log]>->( 2, "creating directory: $dir" );
        mkdir( $dir, 0700 )
            or <[base.log]>->( 1, "warning: could not create $dir: $!" );
    }
}

## All ACME protocol modules are loaded in letsencrypt.base.pre_init

<[base.log]>->( 2, "Let's Encrypt ACME client initialization complete" );
<[base.logs]>->( 2, ": ACME Server     : %s", <letsencrypt.acme.server> );
<[base.logs]>->( 2, ": Certificate Dir : %s", <letsencrypt.certs.dir> );
<[base.logs]>->( 2, ": Admin Email     : %s", <letsencrypt.admin.email> );

0;

