# name  = models.registry.find_alternative.find_best_alternative
# descr = Find best alternative model if primary is unavailable

my ($model_amos, $context) = @ARG;

my $all_models = <[models.registry.list_all.list_all_models]>;
return {} unless $all_models && @$all_models;

my $current = <[models.registry.get_entry.get_model_entry]>->($model_amos);
my $current_cat = $current->{metadata}->{category} // '';

# Find alternatives in same category
my @alternatives = grep {
  $_->{metadata}->{category} eq $current_cat &&
  $_->{amos_checksum} ne $model_amos
} @$all_models;

# Return best by success rate
return (sort { $b->{statistics}->{success_rate} <=> $a->{statistics}->{success_rate} } @alternatives)[0] // {};

