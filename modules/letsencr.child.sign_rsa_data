## [:< ##

# name  = letsencr.child.sign_rsa_data
# descr = sign data with RS256 (SHA-256 + RSA PKCS#1 v1.5 padding) for ACME

my $data_ref         = shift;
my $account_key_name = shift;

<[base.log]>->( 3, 'signing data with RS256 (RSA 2048-bit + SHA-256)' );

## validate key name
unless ( defined $account_key_name ) {
    <[base.log]>->( 1, 'error: account key name required for signing' );
    return undef;
}

## validate data reference
unless ( defined $data_ref && ref $data_ref eq 'SCALAR' ) {
    <[base.log]>->( 1, 'error: signing requires scalar reference' );
    return undef;
}

## retrieve RSA key object from global hash
unless ( exists $keys{'RSA'}->{$account_key_name}
    && exists $keys{'RSA'}->{$account_key_name}->{'pem_private'} ) {
    <[base.logs]>->(
        1, "error : RSA account key '%s' not found",
        $account_key_name
    );
    return undef;
}

## use Crypt::PK::RSA [ CryptX / libtomcrypt ] for signing
## avoids OpenSSL 3.2+ Marvin attack restriction on PKCS#1 v1.5 ##
my $pem = $keys{'RSA'}->{$account_key_name}->{'pem_private'};
my $pk;
eval { $pk = Crypt::PK::RSA->new( \$pem ) };
if ( $EVAL_ERROR or not $pk ) {
    <[base.logs]>->(
        1, 'error : failed to load RSA key for signing : %s',
        <[base.str.eval_error]>
    );
    return undef;
}

## sign using RS256 (PKCS#1 v1.5 + SHA-256) ##
my $signature;
eval { $signature = $pk->sign_message( $data_ref->$*, 'SHA256', 'v1.5' ) };
if ( $EVAL_ERROR or not defined $signature ) {
    <[base.logs]>->(
        1, 'error : RSA signing failed : %s',
        <[base.str.eval_error]>
    );
    return undef;
}

<[base.log]>->( 3, 'RS256 signature generated successfully' );

## return raw signature bytes (caller will base64url encode)
return $signature;

