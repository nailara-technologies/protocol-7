## [:< ##

# name  = editor.buffer.memory.save
# descr = save in-memory editor buffer content to destination scalarref

my ( $buffer, $destination ) = @ARG;

return undef if ref $buffer ne qw| HASH |;

## memory adapter destination: a scalar ref to assign the text to ##
return undef if ref $destination ne qw| SCALAR |;

$$destination = $buffer->{'text'};

return TRUE;

