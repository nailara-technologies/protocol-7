# name = httpd.route_dispatcher
# descr = intelligent HTTP request routing using pattern matching
#
# Routes HTTP requests to appropriate handlers based on:
#   1. ACME challenges (Let's Encrypt HTTP-01 validation)
#   2. API endpoints (certificate status, management)
#   3. Template-based dynamic content
#   4. Static files
#
# Uses base.parser.pattern_split for flexible path pattern matching
#
# Parameters:
#   $_[0] - HTTP request method (GET, POST, etc.)
#   $_[1] - Request URI path (e.g., "/blog/post.html")
#   $_[2] - Vhost name (e.g., "127.0.0.1")
#   $_[3] - Session ID (for logging)
#
# Returns:
#   Hash reference with routing decision:
#   {
#     handler => 'httpd.handler.acme_challenge',  # Handler module name
#     handler_args => { ... },                     # Arguments to pass
#     cache_ttl => 1800,                          # Cache TTL in seconds
#   }

my $method     = shift // qw| GET |;
my $path       = shift // qw| / |;
my $vhost      = shift;
my $session_id = shift // qw| unknown |;

## Validate parameters ##
unless ( defined $path and length $path ) {
    <[base.log]>->(
        0, "[%d] route_dispatcher : missing path parameter", $session_id
    );
    return {
        handler      => qw| httpd.send_error_page |,
        handler_args => { code => 400 }
    };
}

## Normalize path ##
$path =~ s|/+$|| unless $path eq qw| / |;

<[base.logs]>->(
    2, "[%d] routing %s %s [vhost=%s]",
    $session_id, $method, $path, $vhost
);

## Initialize route cache if needed ##
unless ( exists $data{'route_cache'} ) {
    $data{'route_cache'} = {};
}

my $cache_key = "$method:$path:$vhost";

## Check cache for route decision ##
if ( exists $data{'route_cache'}->{$cache_key} ) {
    my $cached_route = $data{'route_cache'}->{$cache_key};
    <[base.logs]>->( 2, "[%d] :. using cached route decision", $session_id );
    return $cached_route;
}

## Route 1: ACME challenges (Let's Encrypt HTTP-01 validation) ##
## Pattern: /.well-known/acme-challenge/{token}
if ( $path =~ m|^/.well-known/acme-challenge/(.+)$| ) {
    my $token = $LAST_PAREN_MATCH;
    <[base.logs]>->(
        1,           "[%d] ACME challenge route : token='%s'",
        $session_id, $token
    );

    my $route = {
        handler      => qw| httpd.handler.acme_challenge |,
        handler_args => { token => $token },
        cache_ttl    => 0,    # Don't cache ACME challenges
    };

    $data{'route_cache'}->{$cache_key} = $route;
    return $route;
}

## Route 2: Template-based dynamic content ##
## Try to resolve template using vhost resolver
if ( defined $vhost ) {
    my $template_path = <[httpd.vhost_template_resolver]>->( $vhost, $path );

    if ( defined $template_path ) {
        <[base.logs]>->(
            1,           '[%d] template route : %s',
            $session_id, $template_path
        );

        my $route = {
            handler      => qw| httpd.process_template |,
            handler_args => { template_path => $template_path },
            cache_ttl    => 1800,    # Cache template results for 30 minutes
        };

        $data{'route_cache'}->{$cache_key} = $route;
        return $route;
    }
}

## Route 3: Static files [default] ##
<[base.logs]>->( 1, '[%d] static file route [default]', $session_id );

my $route = {
    handler      => qw| httpd.serve_static |,
    handler_args => { path => $path },
    cache_ttl    => 3600,    # Cache static file metadata for 1 hour
};

$data{'route_cache'}->{$cache_key} = $route;
return $route;

