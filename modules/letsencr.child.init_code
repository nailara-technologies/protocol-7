## [:< ##

# name  = letsencr.child.init_code
# descr = initialize child process for Let's Encrypt ACME operations - handles blocking crypto and network calls

<[base.log]>->( 2, "initializing Let's Encrypt ACME child process..," );

## Load child-specific cryptographic module (letsencr.base already loaded/initialized by zenka startup)
<[base.load_modules]>->('crypt.C25519');
<[base.init_modules]>->('crypt.C25519');
<[base.perlmod.autoload]>->(
    'Crypt::OpenSSL::X509', qw| FORMAT_ASN1 FORMAT_PEM |
);

## Load ACME and cryptographic modules
<[base.perlmod.load]>->('JSON::XS');
<[base.perlmod.load]>->('HTTP::Request');
<[base.perlmod.load]>->( 'Digest::SHA', qw| sha256 | );
<[base.perlmod.load]>->(
    'MIME::Base64', qw| encode_base64url encode_base64 |
);
<[base.perlmod.autoload]>->('Net::DNS');
<[base.perlmod.load]>->( 'File::Temp', qw| tempfile | );

## Initialize ACME client state (child-side)
<letsencr.child.acme_client> = {
    server           => <letsencr.acme.server>,
    account_key      => undef,
    account_key_type => 'Ed25519',    ## Track key type for signing (EdDSA)
    account_id       => undef,
    nonce            => undef,
};

## Initialize certificate request queue (for blocking operations)
<letsencr.child.cert_queue> = [];

## Initialize challenge handlers (child performs actual challenge)
<letsencr.child.active_challenges> = {};

## All required cryptographic modules are loaded in letsencr.base.pre_init
## No need to duplicate loading here

## NOTE: Message handler is registered by fork_letsencr_child via base.handler.command
## Do NOT register custom handler here - use Protocol-7's command protocol

## Initialize ACME account (blocking operation - safe in child)
my $account_key_path = sprintf '%s/account.key', <letsencr.cache.dir>;
if ( -f $account_key_path ) {
    <[base.log]>->( 2, 'loading existing ACME account key' );

    # Load account key (deferred)
    # <[letsencr.child.load_account_key]>->($account_key_path);
} else {
    <[base.log]>->( 2, 'generating new ACME account key' );

    # Generate Ed25519 key (blocking - safe in child)
    # <[letsencr.child.generate_account_key]>;
}

<[base.log]>->( 2, "Let's Encrypt child process initialization complete" );
<[base.logs]>->(
    2,
    ': ACME Server : %s',
    <[base.parser.ellipse_center]>->( <letsencr.acme.server>, 35 )
);
<[base.logs]>->( 2, ': Account Key : %s', $account_key_path );

0;

