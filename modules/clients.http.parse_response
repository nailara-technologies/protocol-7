# name  = clients.http.parse_response
# descr = split raw http response into status, headers, body

my $raw = shift // '';

if ( $raw =~ /\A(.*?)\r?\n\r?\n(.*)\z/s ) {
    my ( $header_section, $body ) = ( $1, $2 );
    my @lines       = split /\r?\n/, $header_section;
    my $status_line = shift @lines;
    my ($status)    = ( $status_line // '' ) =~ m{HTTP/\d\.\d\s+(\d+)};
    my %headers;
    for my $line (@lines) {
        if ( $line =~ /^([^:]+):\s*(.+)/ ) {
            $headers{ lc $1 } = $2;
        }
    }
    return {
        'status'  => ( $status // 0 ) + 0,
        'headers' => \%headers,
        'body'    => $body
    };
}

return { 'status' => 0, 'headers' => {}, 'body' => $raw };

