## [:< ##

# name  = llama-server-vision.cmd.status
# descr = get llama-vision server status

my $is_alive = <[llama-server-vision.is_alive]>->();
my $status = $is_alive ? 'online' : 'offline';
my $child_pid = <llama-server-vision.child.pid>;
my $pending = scalar keys <llama-server-vision.pending_requests>->%*;

my $response = "status: $status\n";
$response .= "child_pid: $child_pid\n";
$response .= "pending_requests: $pending\n";

return {
    'mode' => 'true',
    'data' => $response
};

