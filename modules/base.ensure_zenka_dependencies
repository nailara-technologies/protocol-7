## [:< ##

# name  = base.ensure_zenka_dependencies
# descr = wrapper to ensure zenki dependencies
#         [ calls debian zenka if available. ]

my $zenka_name = shift // <system.zenka.name>;

## check if debian zenka is available
if ( exists $code{'debian.parent.ensure_zenka_dependencies'} ) {
    <[base.log]>->(
        2, "Checking dependencies via debian zenka for '$zenka_name'"
    );
    return <[debian.parent.ensure_zenka_dependencies]>->( $zenka_name, TRUE );
}

## check via IPC if debian zenka is running
## [ not implemented yet - would use base.protocol-7.command.send.local ]

<[base.log]>->( 2, "debian zenka not available - skipping dependency check" );

return TRUE;    ## Continue anyway

