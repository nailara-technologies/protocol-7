## [:< ##

# name = zenki.parent.ensure_zenka
# descr = Ensure a specific zenka is running

my $params = shift || {};

my $zenka_name = $params->{zenka};
my $wait_ready = $params->{wait_ready} // 1;

unless ($zenka_name) {
    return { success => FALSE, error => 'zenka name required' };
}

<[base.log]>->( 3, "zenki.ensure: checking zenka '$zenka_name'..." );

## First ensure cube is running (all zenki need cube for IPC)
my $cube_result = <[zenki.parent.ensure_cube]>;

unless ( $cube_result->{success} ) {
    return {
        success => FALSE,
        error   => 'cube dependency failed: '
            . ( $cube_result->{error} || 'unknown' ),
        dependency_failed => 'cube'
    };
}

## Check if zenka is already running
my $zenka_check
    = <[zenki.parent.check_running]>->( { zenka => $zenka_name } );

if ( $zenka_check->{running} ) {
    <[base.log]>->(
        3,
        "  ✓ zenka '$zenka_name' already running (PID: "
            . $zenka_check->{pid} . ")"
    );

    ## Update registry
    $data{'zenki'}{'running'}{'zenki'}{$zenka_name} = {
        pid     => $zenka_check->{pid},
        started => $data{'zenki'}{'running'}{'zenki'}{$zenka_name}{'started'}
            || time(),
        status => qw| running |
    };

    return {
        success         => TRUE,
        already_running => 1,
        zenka           => $zenka_name,
        pid             => $zenka_check->{pid}
    };
}

## Zenka not running - request v7 to start it
<[base.log]>->(
    2, "  zenka '$zenka_name' not running - requesting v7 to start..."
);

## Send IPC command to v7 to start the zenka
my $start_result
    = <[zenki.parent.request_v7_start]>->( { zenka => $zenka_name } );

unless ( $start_result->{success} ) {
    return {
        success => FALSE,
        error   => 'failed to request v7 start: '
            . ( $start_result->{error} || 'unknown' )
    };
}

## Wait for zenka to start if requested
if ($wait_ready) {
    my $timeout    = <zenki.cfg.zenka_startup_timeout>;
    my $start_time = time();

    while ( time() - $start_time < $timeout ) {
        sleep 1;

        my $check
            = <[zenki.parent.check_running]>->( { zenka => $zenka_name } );

        if ( $check->{running} ) {
            <[base.log]>->(
                2,
                "  ✓ zenka '$zenka_name' started (PID: "
                    . $check->{pid} . ")"
            );

            ## Update registry and statistics
            $data{'zenki'}{'running'}{'zenki'}{$zenka_name} = {
                pid     => $check->{pid},
                started => time(),
                status  => qw| running |
            };

            $data{'zenki'}{'stats'}{'zenka_starts'}++;

            return {
                success => TRUE,
                started => 1,
                zenka   => $zenka_name,
                pid     => $check->{pid}
            };
        }
    }

    <[base.log]>->(
        0, "  ✗ zenka '$zenka_name' startup timeout after ${timeout}s"
    );

    return {
        success => FALSE,
        error   => "zenka startup timeout after ${timeout}s"
    };
}

## Not waiting - assume success
return {
    success => TRUE,
    started => 1,
    zenka   => $zenka_name,
    waiting => 0
};

0;

