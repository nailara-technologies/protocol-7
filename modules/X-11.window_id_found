# name  = X-11.window_id_found

my $window_id = shift // '';
die 'expected window id parameter' if $window_id !~ m|^\d+$|;

for my $w_id (<[X-11.get_window_ids]>) {
    return TRUE if $w_id == $window_id;
}

## _NET_CLIENT_LIST may be empty under Wayland/WSLg; fall back to tree walk ##
my $X     = <X-11.obj>;
my @stack = ( $X->root );
my %seen;
while ( my $w = shift @stack ) {
    next        if not defined $w or $w eq qw| None | or $seen{$w}++;
    return TRUE if $w == $window_id;
    push @stack, $X->QueryTree($w);
}

return FALSE;

