## [:< ##

# name  = credential_fabric.ui.query.key_holder
# descr = return key-holder child process status

my $pid   = <credential_fabric.key_holder.pid>;
my $state = 'not started';

if ( defined $pid and $pid > 0 ) {
    $state = kill( 0, $pid ) ? 'running' : 'dead';
}

## key material is mlocked in child — treat as locked when running ##
my $locked = ( $state eq 'running' ) ? 'yes' : 'n/a';

## no operation tracking yet — phase 1 placeholder ##
my $last_op       = '';
my $last_op_age_s = 0;

return {
    'state'         => $state,
    'pid'           => $pid // '',
    'locked'        => $locked,
    'last_op'       => $last_op,
    'last_op_age_s' => $last_op_age_s,
};

