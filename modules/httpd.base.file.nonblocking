## [:< ##

# name = httpd.base.file.nonblocking
# descr = set file handle to non-blocking mode

my $fh = shift;

return FALSE if !defined $fh;

my $flags = fcntl( $fh, Fcntl::F_GETFL(), 0 )                or return FALSE;
fcntl( $fh, Fcntl::F_SETFL(), $flags | Fcntl::O_NONBLOCK() ) or return FALSE;

return TRUE;

