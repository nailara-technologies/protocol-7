## [:< ##

# name  = job-site-scan.dispatch.assessments
# descr = collect new untracked jobs and queue assessment tasks

## collect new untracked jobs from site-yaml store ##
<[base.perlmod.autoload]>->('HTML::Entities');
my $store = $data{'site-yaml'}{'jobs'}{'store'} // {};

## fallback: read from file if not in shared namespace
if ( not %{$store} ) {
    <[base.perlmod.autoload]>->('YAML::XS');
    my $store_file = '/var/protocol-7/site-yaml/store.yaml';
    if ( -f $store_file ) {
        eval { $store = YAML::XS::LoadFile($store_file) };
        <[base.logs]>->( 0, 'store load error: %s', $@ ) if $@;
        <[base.logs]>->(
            1,
            'loaded %d store entries from file',
            ref $store eq 'HASH' ? scalar keys %{$store} : 0
        );
    }
}

my @to_assess;
for my $job_id ( keys %{$store} ) {
    my $job = $store->{$job_id};
    next if ( $job->{'status'} // '' ) ne 'new';
    next if exists <job-site-scan.tasks>->{$job_id};

    ## checksum dedup / blacklist check ##
    my $chk = <[job-site-scan.checksum.index]>->( qw| check |, $job );
    if ( $chk->{'is_blocked'} ) {
        <[base.logs]>->(
            2,       'job %s blocked by checksum index [%s]',
            $job_id, join( ', ', $chk->{'hits'}->@* )
        );
        $job->{'status'} = 'blocked';
        next;
    }

    push @to_assess, $job_id;
}

if ( not @to_assess ) {
    <[base.logs]>->( 1, 'no new untracked jobs to assess, idle' );
    <job-site-scan.cycle> = 'idle';
    <[job-site-scan.state.persist]>;
    return;
}

<job-site-scan.cycle>         = 'assessing';
<job-site-scan.pending_count> = scalar @to_assess;
<[job-site-scan.state.persist]>;

<[base.logs]>->(
    1,
    'queuing %d assessment tasks (sequential)',
    scalar @to_assess
);

## load candidate profile once
my $profile_file = <job-site-scan.cfg.profile_file>
    // '/etc/protocol-7/job-site-scan/profile.txt';
my $profile_text = '';
$profile_text = <[file.read]>->($profile_file)
    // 'no profile configured — score based on job listing alone';
<[base.perlmod.autoload]>->('Encode');
$profile_text = Encode::decode( 'UTF-8', $profile_text )
    unless utf8::is_utf8($profile_text);

## build queue entries
my @queue;
for my $job_id (@to_assess) {
    <job-site-scan.tasks>->{$job_id}
        = { 'stage' => 'queued', 'task_id' => '' };

    ## initialize assertion tree for this job ##
    <[job-site-scan.assert.init]>->($job_id);

    my $prompt = <[job-site-scan.util.build_prompt]>->( $store->{$job_id} );

    push @queue, { 'job_id' => $job_id, 'desc' => $prompt };
}

<job-site-scan.assess_queue> = \@queue;

## dispatch first task — task-created handler will call dispatch.next for each
<[job-site-scan.dispatch.next]>;

return;

