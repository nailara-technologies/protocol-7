# name  = coding.tools.handler.search_memory
# descr = search focus-scored memory tree by terms

my $args  = shift            // {};
my $terms = $args->{'terms'} // '';
return 'terms required' unless length $terms;

## [ reject shell metacharacters ]##
if ( $terms =~ m{[;&|`\$\\"'\n\r<>]} ) {
    return 'error: terms contain invalid characters';
}
return 'error: terms too long' if length($terms) > 200;

my $output = '';
if ( open my $fh, '-|', 'p7c', 'memory.search', $terms ) {
    local $INPUT_RECORD_SEPARATOR;
    $output = <$fh>;
    close $fh;
}
$output //= '';
chomp $output;

return length $output
    ? $output
    : 'memory.search returned empty — memory zenka may not be running';

