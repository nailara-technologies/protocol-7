## [:< ##

# name  = base.chk-sum.jha.b64u
# descr = returns base64 URL encoded [ network ordered ] jhash value

return Crypt::Misc::encode_b64u( pack qw| N |,
    Digest::JHash::jhash( join '', @ARG ) )

