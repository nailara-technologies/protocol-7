# name  = debian.parent.callback.register_deb_package
# descr = register a zenka debian package dependency

my $package = shift;
my $zenka   = shift;

## Ensure registries are initialized
$data{'debian'}{'packages'}{'registry'} //= {};
$data{'debian'}{'packages'}{'by_name'}  //= {};

## Ensure list is initialized if not already
unless ( exists $data{'_list_meta'}{'debian-packages'} ) {
    <[base.list.init]>->(
        {   'name'         => qw| debian-packages |,
            'key_ref'      => \$data{'debian'}{'packages'}{'registry'},
            'max_elements' => 2048
        }
    );
}

## Check if already registered
my $pkg_id = $data{'debian'}{'packages'}{'by_name'}->{$package};

if ( defined $pkg_id ) {
    ## Increment zenki count
    $data{'debian'}{'packages'}{'registry'}{$pkg_id}{zenki_count}++;
    return $pkg_id;
}

## Add to registry
$pkg_id = <[base.list.element.add]>->(
    {   'key_ref' => \$data{'debian'}{'packages'}{'registry'},
        'val_ref' => \{
            package           => $package,
            status            => qw| unknown |,
            installed_version => undef,
            cpan_modules      => [],
            zenki_count       => 1
        }
    }
);

if ( defined $pkg_id ) {
    $data{'debian'}{'packages'}{'by_name'}->{$package} = $pkg_id;
}

return $pkg_id;

