## [:< ##

# name  = users.init_code
# descr = init users zenka, register host-system path keyword

<[base.logs]>->( 2, 'users zenka initialized' );

## register top-level host-system storage path keyword  [ not per-zenka ##
## etc_P7/users : shared /etc/protocol-7/users/ convention ]            ##

my $users_host_path = qw| /etc/protocol-7/users/host-system |;

<[base.path.register_keywords]>->( { qw| USERS_HOST | => $users_host_path } );

return TRUE;

