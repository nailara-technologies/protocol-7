## [:< ##
# name  = models.backend.local.invoke
# descr = local backend for on-device LLMs with AnyEvent::HTTP

my $params = shift;

## Extract parameters ##
my $participant_id  = $params->{'participant_id'} // '';
my $job_id          = $params->{'job_id'}         // '';
my $model_id        = $params->{'model_id'}       // '';
my $reply_id        = $params->{'reply_id'}       // '';
my $system_prompt   = $params->{'system_prompt'}  // '';
my $system_template = $params->{'system_template'}
    // 'configuration/models/system-messages/coding-assistant.tmpl';
my $messages    = $params->{'messages'}         // [];
my $temperature = $params->{'temperature'}      // 0.7;
my $max_tokens  = $params->{'max_tokens'}       // 2048;
my $llama_url   = $params->{'llama_server_url'} // 'http://127.0.0.1:8080';

## Validate required params ##
return { 'success' => FALSE, 'error' => 'no model_id' }
    unless length($model_id);
return { 'success' => FALSE, 'error' => 'no messages' }
    unless @$messages;

## Generate inference ID for tracking ##
my $inference_id
    = <[chk-sum.elf.vax-BASE32]>->( $job_id . <[base.time]>->(2) );

## Render dynamic system message from template if no explicit prompt ##
if ( !length($system_prompt) && length($system_template) ) {
    my $template_result = <[web.cmd.render-template]>->(
        {   template_path => $system_template,
            meta          => { model => $model_id, context => 'local' },
            budget        => 2000,
            session_id    => "local_invoke_$job_id",
        }
    );
    if ( $template_result->{'status'} eq qw| success | ) {
        $system_prompt = $template_result->{'content'};
        <[base.log]>->(
            2,
            "[local.invoke] system message rendered "
                . "($template_result->{'elapsed_ms'}ms, "
                . length($system_prompt)
                . " chars)"
        );
    } else {
        <[base.log]>->(
            1,
            "[local.invoke] render failed: " . $template_result->{'message'}
        );
        $system_prompt = 'you are a protocol-7 assistant.';
    }
}

## Build request payload ##
my $payload = {
    model       => $model_id,
    messages    => $messages,
    temperature => $temperature,
    max_tokens  => $max_tokens,
    stream      => JSON::PP::false,
};
$payload->{'system'} = $system_prompt if length($system_prompt);

## Encode JSON ##
my $json_body = eval { JSON::PP::encode_json($payload) };
if ($@) {
    <[base.log]>->( 0, "[local.invoke] JSON encode error: $@" );
    return { 'success' => FALSE, 'error' => 'json_encode_failed' };
}

## Store request metadata for callback ##
<models.pending.requests>->{$inference_id} = {
    job_id         => $job_id,
    participant_id => $participant_id,
    model_id       => $model_id,
    reply_id       => $reply_id,
    start_time     => <[base.time]>->(2),
};

## Submit async HTTP request via AnyEvent::HTTP  Watcher registered ##
## directly into Event.pm - no polling!                             ##
http_post(
    "$llama_url/v1/chat/completions",
    $json_body,
    headers => {
        'Content-Type' => 'application/json',
        'Accept'       => 'application/json',
    },
    sub {
        my ( $body, $headers ) = @_;
        <[models.handler.llm_response]>->(
            {   inference_id => $inference_id,
                body         => $body,
                headers      => $headers,
            }
        );
    }
);

<[base.log]>->( 2, "[local.invoke] request submitted: $inference_id" );

## Return immediately (non-blocking)  If reply_id provided, async callback ##
## will handle response                                                    ##
if ( length($reply_id) ) {
    return {
        'success' => TRUE,
        'pending' => TRUE,
        'async'   => TRUE,
    };
} else {
    ## Synchronous fallback - return inference_id for polling
    return {
        'success'      => TRUE,
        'pending'      => TRUE,
        'inference_id' => $inference_id,
    };
}

