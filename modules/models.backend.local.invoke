## [:< ##

# name = models.backend.local.invoke
# descr = Local backend for on-device LLM models served via llama-server

my $params = shift;

my $participant_id = $params->{'participant_id'}  // '';
my $job_id         = $params->{'job_id'}          // '';
my $model_id       = $params->{'model_id'}        // '';
my $system_prompt  = $params->{'system_prompt'}   // '';
my $messages       = $params->{'messages'}        // [];
my $temperature    = $params->{'temperature'}     // 0.7;
my $max_tokens     = $params->{'max_tokens'}      // 4096;
my $timeout_secs   = $params->{'timeout_seconds'} // 30;
my $context        = $params->{'context'}         // 'backend';

return {
    'success' => FALSE,
    'error'   => 'participant_id required'
    }
    unless length($participant_id);

return {
    'success' => FALSE,
    'error'   => 'model_id required'
    }
    unless length($model_id);

unless ( ref($messages) eq 'ARRAY' && scalar( @{$messages} ) > 0 ) {
    return {
        'success' => FALSE,
        'error'   => 'messages must be non-empty array'
    };
}

my $start_time = <[base.time]>->(4);

## Build request payload for llama-server /v1/chat/completions
my $request_payload = {
    'model'       => $model_id,
    'messages'    => $messages,
    'temperature' => $temperature,
    'max_tokens'  => $max_tokens,
};

$request_payload->{'system'} = $system_prompt if length($system_prompt);

## Get llama-server endpoint from configuration
my $llama_server_url = <models.llama_server_url> // 'http://localhost:8000';

## Attempt HTTP request to llama-server
my $response_data = undef;
my $api_error     = undef;

eval {
    ## Make HTTP POST request to llama-server
    my $ua = LWP::UserAgent->new();
    $ua->timeout($timeout_secs);
    my $request = HTTP::Request->new(
        POST => $llama_server_url . '/v1/chat/completions',
        [ 'Content-Type' => 'application/json' ],
        JSON::PP::encode_json($request_payload)
    );

    my $response = $ua->request($request);

    if ( $response->is_success() ) {
        $response_data = JSON::PP::decode_json( $response->content() );
    } else {
        $api_error = $response->code() . ': '
            . ( $response->content() // 'unknown error' );
    }
};

if ($@) {
    <[base.logs]>->(
        2, "[$context] local error: participant=%s model=%s error=%s",
        $participant_id, $model_id, $@
    );
    return {
        'success'        => FALSE,
        'model_id'       => $model_id,
        'participant_id' => $participant_id,
        'error'          => "Local model error: $@",
        'rate_limited'   => 0,
        'elapsed_ms'     => ( <[base.time]>->(4) - $start_time ) * 1000
    };
}

## Check for API error
unless ($response_data) {
    <[base.logs]>->(
        2, "[$context] local error: participant=%s model=%s error=%s",
        $participant_id, $model_id, $api_error
    );
    return {
        'success'        => FALSE,
        'model_id'       => $model_id,
        'participant_id' => $participant_id,
        'error'          => "Local model error: $api_error",
        'rate_limited'   => 0,
        'elapsed_ms'     => ( <[base.time]>->(4) - $start_time ) * 1000
    };
}

## Extract response text from first choice
my $response_text = '';
if ( defined $response_data->{'choices'}
    && ref $response_data->{'choices'} eq 'ARRAY' ) {
    my $first_choice = $response_data->{'choices'}->[0];
    if ( defined $first_choice->{'message'} ) {
        $response_text = $first_choice->{'message'}->{'content'} // '';
    }
}

unless ( length($response_text) ) {
    <[base.logs]>->(
        2, "[$context] local no response: participant=%s model=%s",
        $participant_id, $model_id
    );
    return {
        'success'        => FALSE,
        'model_id'       => $model_id,
        'participant_id' => $participant_id,
        'error'          => 'No response from local model',
        'rate_limited'   => 0,
        'elapsed_ms'     => ( <[base.time]>->(4) - $start_time ) * 1000
    };
}

## Extract usage information if available
my $tokens_used = 0;
if ( defined $response_data->{'usage'} ) {
    $tokens_used = $response_data->{'usage'}->{'completion_tokens'} // 0;
}

<[base.logs]>->(
    2, "[$context] local response: participant=%s model=%s tokens=%d",
    $participant_id, $model_id, $tokens_used
);

my $elapsed_ms = ( <[base.time]>->(4) - $start_time ) * 1000;

return {
    'success'        => TRUE,
    'model_id'       => $model_id,
    'participant_id' => $participant_id,
    'response'       => $response_text,
    'tokens_used'    => $tokens_used,
    'rate_limited'   => 0,
    'latency_ms'     => $elapsed_ms,
    'elapsed_ms'     => $elapsed_ms
};

