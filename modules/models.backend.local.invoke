## [:< ##

# name = models.backend.local.invoke
# descr = Local backend for on-device LLM models served via llama-server

my $params = shift;

my $participant_id = $params->{'participant_id'}  // '';
my $job_id         = $params->{'job_id'}          // '';
my $model_id       = $params->{'model_id'}        // '';
my $system_prompt  = $params->{'system_prompt'}   // '';
my $messages       = $params->{'messages'}        // [];
my $temperature    = $params->{'temperature'}     // 0.7;
my $max_tokens     = $params->{'max_tokens'}      // 4096;
my $timeout_secs   = $params->{'timeout_seconds'} // 30;
my $context        = $params->{'context'}         // 'backend';
my $reply_id       = $params->{'reply_id'};

return {
    'success' => FALSE,
    'error'   => 'participant_id required'
    }
    unless length($participant_id);

return {
    'success' => FALSE,
    'error'   => 'model_id required'
    }
    unless length($model_id);

unless ( ref($messages) eq 'ARRAY' && scalar( @{$messages} ) > 0 ) {
    return {
        'success' => FALSE,
        'error'   => 'messages must be non-empty array'
    };
}

my $start_time = <[base.time]>->(4);

## Check if this is a vision task (has image_path parameter)
my $image_path = $params->{'image_path'} // '';
my $model_path = $params->{'model_path'} // '';

if ( length($image_path) && -f $image_path ) {
    ## Route to vision backend (CLI-based, not HTTP)
    return <[models.backend.local.vision]>->(
        {   'participant_id' => $participant_id,
            'job_id'         => $job_id,
            'model_id'       => $model_id,
            'system_prompt'  => $system_prompt,
            'messages'       => $messages,
            'image_path'     => $image_path,
            'model_path'     => $model_path,
            'temperature'    => $temperature,
            'max_tokens'     => $max_tokens,
            'context'        => $context,
        }
    );
}

## Build request payload for llama-server /v1/chat/completions (text/code)
my $request_payload = {
    'model'       => $model_id,
    'messages'    => $messages,
    'temperature' => $temperature,
    'max_tokens'  => $max_tokens,
};

$request_payload->{'system'} = $system_prompt if length($system_prompt);

## Get llama-server endpoint from coding zenka or fallback to localhost
my $endpoint_check = <[models.get_inference_endpoint]>->(
    {   'backend_type' => 'cpu',
        'context'      => $context,
    }
);

my $llama_server_url = $endpoint_check->{'endpoint'}
    // <models.llama_server_url> // 'http://127.0.0.1:8000';

## Generate unique inference ID
my $inference_id = "$job_id:$participant_id:" . int(<[base.time]>->(2));

## Prepare JSON payload
my $json_payload = JSON::PP::encode_json($request_payload);

## Write payload to temp file for curl
my $temp_file = "/tmp/llama_req_$$.json";
open( my $payload_fh, '>', $temp_file )
    or die "Cannot write temp file: $!";
print $payload_fh $json_payload;
close($payload_fh);

## Build curl command for async execution
my @curl_cmd = (
    'curl', '-s', '-m', $timeout_secs,
    '-X', 'POST',
    "$llama_server_url/v1/chat/completions",
    '-H', 'Content-Type: application/json',
    '-d', "\@$temp_file"
);

## Spawn curl process asynchronously with open3
my ( $curl_in, $curl_out, $curl_err );
$curl_err = Symbol::gensym();

my $pid = eval {
    use IPC::Open3;
    delete $ENV{'http_proxy'};
    delete $ENV{'https_proxy'};
    delete $ENV{'HTTP_PROXY'};
    delete $ENV{'HTTPS_PROXY'};
    delete $ENV{'ALL_PROXY'};
    $ENV{'NO_PROXY'} = 'localhost,127.0.0.1';

    IPC::Open3::open3( $curl_in, $curl_out, $curl_err, @curl_cmd );
};

if ( !$pid || $EVAL_ERROR ) {
    unlink($temp_file);
    <[base.logs]>->(
        2, "[$context] failed to spawn inference: participant=%s error=%s",
        $participant_id, $EVAL_ERROR // 'unknown error'
    );
    return {
        'success'        => FALSE,
        'model_id'       => $model_id,
        'participant_id' => $participant_id,
        'error'          => "Failed to spawn inference: $EVAL_ERROR",
        'rate_limited'   => 0,
        'elapsed_ms'     => ( <[base.time]>->(4) - $start_time ) * 1000
    };
}

## Report child PID to v7 for lifecycle management
<[base.zenki.report_child_pid]>->($pid);

## Store pending inference job
<models.pending_inferences>->{$inference_id} = {
    'pid'             => $pid,
    'job_id'          => $job_id,
    'participant_id'  => $participant_id,
    'model_id'        => $model_id,
    'system_prompt'   => $system_prompt,
    'messages'        => $messages,
    'context'         => $context,
    'start_time'      => $start_time,
    'timeout_secs'    => $timeout_secs,
    'output'          => '',
    'errors'          => '',
    'curl_out'        => $curl_out,
    'curl_err'        => $curl_err,
    'temp_file'       => $temp_file,
    'rdr_closed'      => 0,
    'err_closed'      => 0,
    'reply_id'        => $reply_id,
};

<[base.logs]>->(
    1, "[$context] inference spawned: id=%s job=%s participant=%s pid=%d",
    $inference_id, $job_id, $participant_id, $pid
);

## Register non-blocking I/O handler for curl stdout
my $io_handler_stdout = <[event.add_io]>->(
    {   'fd'      => $curl_out,
        'handler' => 'models.handler.read_inference_response',
        'data'    => { 'inference_id' => $inference_id, 'stream' => 'stdout' }
    }
);

<models.pending_inferences>->{$inference_id}->{'io_handler_stdout'} = $io_handler_stdout;

## Register non-blocking I/O handler for curl stderr (completion trigger)
my $io_handler_stderr = <[event.add_io]>->(
    {   'fd'      => $curl_err,
        'handler' => 'models.handler.read_inference_response',
        'data'    => { 'inference_id' => $inference_id, 'stream' => 'stderr' }
    }
);

<models.pending_inferences>->{$inference_id}->{'io_handler_stderr'} = $io_handler_stderr;

## Return immediately with pending status
## Response will be delivered asynchronously via event handlers
return {
    'success'         => TRUE,
    'pending'         => TRUE,
    'inference_id'    => $inference_id,
    'model_id'        => $model_id,
    'participant_id'  => $participant_id,
    'job_id'          => $job_id,
    'message'         => 'inference spawned, response pending',
    'rate_limited'    => 0,
};

