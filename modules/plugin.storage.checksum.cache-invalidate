## [:< ##
# name  = plugin.storage.checksum.cache-invalidate
# descr = Invalidate checksum cache entries

use strict;
use warnings;

return sub {
    my ($args) = @ARG;
    $args //= {};

    my $path       = $args->{path};
    my $all        = $args->{all} // 0;
    my $older_than = $args->{older_than};    # seconds

    my $registry    = $data{'storage'}{'mapping'}{'checksum'};
    my $invalidated = 0;

    if ($all) {

        # Clear all cache entries
        for my $path ( keys %{ $registry->{'cache'} } ) {
            delete $registry->{'cache'}{$path};
            $invalidated++;
        }
    } elsif ( defined $path ) {

        # Clear specific path
        if ( exists $registry->{'cache'}{$path} ) {
            delete $registry->{'cache'}{$path};
            $invalidated++;
        }
    } elsif ( defined $older_than ) {

        # Clear entries older than N seconds
        my $cutoff = time() - $older_than;
        for my $path ( keys %{ $registry->{'cache'} } ) {
            if ( $registry->{'cache'}{$path}{'cached_at'} < $cutoff ) {
                delete $registry->{'cache'}{$path};
                $invalidated++;
            }
        }
    }

    return {
        'mode' => 'true',
        'data' => {
            'invalidated' => $invalidated,
            'remaining'   => scalar( keys %{ $registry->{'cache'} } ),
        }
    };
};

