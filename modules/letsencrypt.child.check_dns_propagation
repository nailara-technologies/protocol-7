# name  = letsencrypt.child.check_dns_propagation
# descr = Verify DNS-01 challenge TXT record has propagated before ACME validation

use Net::DNS;

my $dns_record_name = shift;
my $expected_value  = shift;

return undef unless $dns_record_name && $expected_value;

<[base.log]>->(
    2, "checking DNS propagation for TXT record: $dns_record_name"
);

## Create DNS resolver
my $resolver = Net::DNS::Resolver->new(
    nameservers => [
        '8.8.8.8',        # Google Public DNS
        '1.1.1.1',        # Cloudflare DNS
        '8.8.4.4',        # Google Public DNS secondary
    ],
    recurse => 1,
    tcp_timeout => 5,
    udp_timeout => 5,
);

## Query TXT records with retry logic
my $max_attempts = 10;
my $attempt      = 0;
my $backoff      = 2;     # Start at 2 seconds

while ( $attempt < $max_attempts ) {
    $attempt++;

    <[base.log]>->( 3, "  DNS query attempt $attempt/$max_attempts" );

    ## Query for TXT records
    my $query = $resolver->query( $dns_record_name, 'TXT' );

    if ($query) {
        my @txt_records;

        foreach my $rr ( $query->answer ) {
            next unless $rr->type eq 'TXT';

            ## Get TXT record value (may be in quotes)
            my $value = join( '', $rr->txtdata );

            <[base.log]>->( 3, "  found TXT: $value" );
            push @txt_records, $value;

            ## Check if this matches our expected value
            if ( $value eq $expected_value ) {
                <[base.log]>->(
                    2,
                    "DNS-01 challenge propagated successfully (attempt $attempt)"
                );
                return {
                    propagated => 1,
                    attempts   => $attempt,
                    value      => $value,
                };
            }
        }

        ## Record found but value doesn't match
        if (@txt_records) {
            <[base.log]>->(
                2,
                "TXT record found but value mismatch (expected: $expected_value)"
            );
        }
    } else {
        my $errorstring = $resolver->errorstring;
        <[base.log]>->( 3, "  DNS query failed: $errorstring" );
    }

    ## Not propagated yet, wait before retrying
    if ( $attempt < $max_attempts ) {
        <[base.log]>->( 3, "  waiting ${backoff}s before retry..." );
        sleep($backoff);
        $backoff = $backoff < 30 ? $backoff * 1.5 : 30;    # Cap at 30s
    }
}

<[base.log]>->(
    1,
    "DNS propagation timeout after $max_attempts attempts (record not found or incorrect)"
);

return {
    propagated => 0,
    attempts   => $attempt,
    error      => 'DNS propagation timeout',
};

