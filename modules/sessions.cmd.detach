## [:< ##

# name  = sessions.cmd.detach
# descr = detach the key-holding child [ SIGUSR2, close control
#         connection, child keeps running dormant ]

my $ok = <[sessions.holder.detach]>;

return {
    'mode' => qw| size |,
    'data' => sprintf(
        "%s\n", $ok ? '<< detached >>' : '<< detach ' . 'failed >>'
    )
};

