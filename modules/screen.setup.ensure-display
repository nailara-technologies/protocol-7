## [:< ##

# name  = screen.setup.ensure-display
# descr = point gdk at the xwayland display + initialise gtk once, so both
#         the monitor enumeration and the map window use the right display
#         [ idempotent : safe to call from every entry point ]

$ENV{'DISPLAY'}     = <x11.display>;
$ENV{'GDK_BACKEND'} = 'x11';           ## force XWayland under WSL|Wayland ##
delete $ENV{'WAYLAND_DISPLAY'};

## under minimal xwayland|wsl no xsettings daemon propagates a cursor ##
## theme, so name an installed one + a sane size [ see window.place ] ##
$ENV{'XCURSOR_THEME'} //= 'Adwaita';
$ENV{'XCURSOR_SIZE'} = '24';

Gtk3->init if not <screen.setup.gtk.inited>;
<screen.setup.gtk.inited> = TRUE;

return TRUE;

