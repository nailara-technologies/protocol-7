# name  = base.stream.advance_drain
# descr = consume N drained bytes from the head of the outbound-stream deque

my ( $sid, $bytes ) = @ARG;

return if not defined $sid   or not exists $data{'session'}{$sid};
return if not defined $bytes or $bytes < 1;

my $deque = $data{'session'}{$sid}{'obs_deque'};
return if not defined $deque or not $deque->@*;

my $remaining = 0 + $bytes;

while ( $remaining > 0 and $deque->@* ) {

    my $head = $deque->[0];

    if ( $head->{'byte_len'} <= $remaining ) {
        $remaining -= $head->{'byte_len'};
        shift $deque->@*;
    } else {
        $head->{'byte_len'} -= $remaining;
        $remaining = 0;
    }
}

delete $data{'session'}{$sid}{'obs_deque'}
    if not $deque->@*;

return;

