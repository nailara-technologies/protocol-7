# name  = crypt.C25519.pre_init

<[base.perlmod.load]>->('Crypt::Ed25519');
<[base.perlmod.load]>->('AMOS7::Twofish');
<[base.perlmod.load]>->('Crypt::Curve25519');

<crypt.C25519.loaded-keys> //= {};    ## key name \ checksum table ##

0;

