## [:<
# name  = pager.decode.division-13
# descr = Decode division-13-table protocol from pager items
## >:]

return sub {
    my ($args) = @_;

    my $data = $args->{'data'};  # Binary data or items with d13_state
    my $mode = $args->{'mode'} // 'full';  # full | routing | payload | graphical

    return [] unless $data;

    my @items;

    if (ref($data) eq 'ARRAY') {
        # Array of items with d13_state
        for my $item (@$data) {
            my $d13 = $item->{'d13_state'};
            next unless $d13;

            push @items, _decode_d13_state($d13, $mode);
        }
    }
    elsif (!ref($data)) {
        # Binary string - unpack 64-bit chunks
        while (length($data) >= 8) {
            my $chunk = substr($data, 0, 8, '');
            my $num = unpack('Q>', $chunk);
            my $num_bits_64 = sprintf('%064b', $num);

            my $d13 = {
                'full_64' => $num,
                'main_42' => substr($num_bits_64, 0, 42),
                'decoded' => substr($num_bits_64, 42, 7),
                'aux_15'  => substr($num_bits_64, 49, 15),
            };

            push @items, _decode_d13_state($d13, $mode);
        }
    }

    return \@items;
};

# Decode a single division-13 state
sub _decode_d13_state {
    my ($d13, $mode) = @_;

    my $decoded = $d13->{'decoded'};
    my $prefix = substr($decoded, 0, 2);

    my $result = {
        'd13'       => $d13,
        'raw_64'    => $d13->{'full_64'},
        'main_42'   => $d13->{'main_42'},
        'decoded_7' => $decoded,
        'aux_15'    => $d13->{'aux_15'},
    };

    # Parse based on prefix
    if ($prefix eq '00') {
        # Routing
        $result->{'type'} = 'routing';
        $result->{'hop_count'} = 1 + oct('0b' . substr($decoded, 3, 3));
        $result->{'direction'} = _decode_direction(substr($decoded, 5, 2));

        return undef if $mode eq 'payload' || $mode eq 'graphical';
    }
    elsif ($prefix eq '01') {
        my $subtype = substr($decoded, 2, 1);
        if ($subtype eq '0') {
            # BASE32 payload
            $result->{'type'} = 'base32_payload';
            $result->{'char_index'} = oct('0b' . substr($decoded, 3, 5));

            return undef if $mode eq 'routing' || $mode eq 'graphical';
        }
        else {
            # Document header
            $result->{'type'} = 'document_header';
            $result->{'color'} = (substr($decoded, 3, 1) eq '1');
            $result->{'size_code'} = oct('0b' . substr($decoded, 4, 4));

            return undef if $mode eq 'routing' || $mode eq 'graphical';
        }
    }
    elsif (substr($decoded, 0, 1) eq '1') {
        # Graphical
        $result->{'type'} = 'graphical';
        $result->{'matrix_x'} = oct('0b' . substr($decoded, 1, 3));
        $result->{'matrix_y'} = oct('0b' . substr($decoded, 4, 3));

        return undef if $mode eq 'routing' || $mode eq 'payload';
    }
    else {
        $result->{'type'} = 'unknown';
    }

    return $result;
}

# Decode direction bits
sub _decode_direction {
    my ($bits) = @_;
    my $dir = oct('0b' . $bits);
    return ['UP', 'RIGHT', 'LEFT', 'DOWN']->[$dir] // 'UNKNOWN';
}

