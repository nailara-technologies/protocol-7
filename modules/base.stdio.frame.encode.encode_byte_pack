# name  = base.stdio.frame.encode.encode_byte_pack
# param = $bytes
# descr = encode bytes to base-7 byte frames

my $bytes = shift;
return () if not length $bytes;

my @frames;
for my $byte ( unpack( qw| C* |, $bytes ) ) {
    my $d0 = int( $byte / 49 ) + 1;
    my $d1 = int( ( $byte % 49 ) / 7 ) + 1;
    my $d2 = ( $byte % 7 ) + 1;
    push @frames,
        <[base.stdio.frame.encode.pack_nibble]>->( $d0, 0 ),
        <[base.stdio.frame.encode.pack_nibble]>->( $d1, 0 ),
        <[base.stdio.frame.encode.pack_nibble]>->( $d2, 0 );
}

return @frames;

