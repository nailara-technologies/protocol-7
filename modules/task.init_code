## [:< ##

# name  = task.init_code
# descr = initialize task zenka — load task queue from disk

## task queue data structures
<task.queue>       //= {};    ## { task_id => task_record } — live tasks
<task.history>     //= {};    ## { task_id => task_record } — completed/failed
<task.queue.order> //= [];    ## [ task_id, ... ] preserves insertion order
<task.wait.pending>
    //= {};    ## { task_id => reply_id } — deferred wait-done replies
<task.wait.timeout> //= {};    ## { task_id => timeout_secs } — for cleanup
<task.summarize.pending>
    //= {};                    ## { task_id => reply_id } — summarize replies

## load existing queue from disk [ zenka_dir handles /var/protocol-7/task/ ]
<[task.persist.load]>;

<[base.logs]>->(
    1,
    ': task zenka initialized [ %d tasks in queue ]',
    scalar( keys %{<task.queue>} )
);

return TRUE;

