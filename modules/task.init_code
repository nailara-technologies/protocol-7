## [:< ##

# name  = task.init_code
# descr = initialize task zenka : load task queue from disk

## task queue data structures
<task.queue>       //= {};    ## { task_id => task_record } : live tasks
<task.history>     //= {};    ## { task_id => task_record } : completed/failed
<task.queue.order> //= [];    ## [ task_id, ... ] preserves insertion order
<task.wait.pending>
    //= {};    ## { task_id => reply_id } : deferred wait-done replies
<task.wait.timeout> //= {};    ## { task_id => timeout_secs } : for cleanup
<task.summarize.pending>
    //= {};                    ## { task_id => reply_id } : summarize replies
<task.summary_tree.entries>
    //= {};    ## { chk(focus.content) => entry } : summary-tree cache/deltas

## cold-queue config + state ##
<task.cfg.gpu_cold_temp_c>      //= 57;
<task.cfg.cold_debounce_secs>   //= 120;
<task.cfg.gpu_cold_samples>     //= 5;
<task.cold_queue.last_notify>   //= {};
<task.cold_queue.gpu_available> //= FALSE;
<task.stats.gpu.temp>           //= {
    'load_1s'       => undef,
    'load_5s'       => undef,
    'sparkline_buf' => [],
    'updated_at'    => undef,
};

## reasoning branch registry [ generic parallel orchestration ] ##
<reasoning.branch.registry>        //= {};
<reasoning.branch.stuck_threshold> //= 0.75;
<reasoning.branch.check_interval>  //= 300;    ## seconds

## load existing queue from disk [ zenka_dir handles /var/protocol-7/task/ ]
<[task.persist.load]>;
<[task.persist.summary_tree.load]>;

<[base.logs]>->(
    1,
    ': task zenka initialized [ %d tasks in queue ]',
    scalar( keys %{<task.queue>} )
);

## subscribe to X-11 GPU temperature stream if available -- deferred via
## <system.callbacks.initialized>: resolve_primary_sid's own internal
## route-send fires before this zenka's own cube session exists when
## called directly from init_code, and the resolver has no retry of its
## own, so a race here means never getting GPU stats at all ##
push <system.callbacks.initialized>->@*, sub {
    <[base.zenki.resolve_primary_sid]>->(
        'X-11',
        sub {
            my $sid = shift;
            return if not defined $sid;
            <[protocol-7.route-send]>->(
                {   'command'   => "$sid.gpu_metric",
                    'call_args' => { 'args' => 'temp subscribe' },
                    'reply'     => {
                        'handler' => 'task.handler.gpu_temp_update',
                        'params'  => {}
                    }
                }
            );
        }
    );
};

return TRUE;

