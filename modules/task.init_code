## [:< ##

# name  = task.init_code
# descr = initialize task zenka — load task queue from disk

## task queue data structures
<task.queue>       //= {};    ## { task_id => task_record }
<task.queue.order> //= [];    ## [ task_id, ... ] preserves insertion order

## configuration
<task.cfg.persist_path>
    //= <system.root_path> . '/var/protocol-7/task/queue.yaml';
<task.cfg.persist_dir> //= <system.root_path> . '/var/protocol-7/task';

## ensure persist directory exists
if ( not -d <task.cfg.persist_dir> ) {
    <[file.make_path]>->( <task.cfg.persist_dir>, 0750 );
}

## load existing queue from disk
<[task.persist.load]>;

<[base.logs]>->(
    1,
    ': task zenka initialized [ %d tasks in queue ]',
    scalar( keys %{<task.queue>} )
);

return TRUE;

