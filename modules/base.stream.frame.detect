## [:< ##

# name  = base.stream.frame.detect
# descr = sliding window frame lock : find the separator column offset
# param = <bits> [ arrayref of 0/1 bits ]
# return = offset [ 0-3 ] on lock, undef if insufficient data or no uniform column

my $bits = shift // [];

return undef if scalar( $bits->@* ) < 5;

OFFSET:
for my $offset ( 0 .. 3 ) {
    my @col;
    for ( my $i = $offset; $i < scalar $bits->@*; $i += 4 ) {
        push @col, $bits->[$i];
    }

    next OFFSET
        if scalar(@col) < 2;    ## need two separator samples to be safe ##

    for my $bit (@col) {
        next OFFSET
            if $bit != $col[0];   ## column varies : payload, not separator ##
    }

    return $offset;  ## uniform every 4th position : separator column found ##
}

return undef;

