## [:< ##

# name  = kimi.handler.ws_message
# descr = dispatch incoming kimi-web json-rpc messages from websocket frames
# note  = called by websocket.handler.read on each complete frame
#         first arg is undef on disconnect

<[base.perlmod.load]>->(qw| JSON |);

my $text    = shift;
my $context = shift // {};

## disconnect signal — tear down and schedule reconnect
if ( not defined $text ) {
    <[base.logs]>->( 2, 'kimi.handler.ws_message: websocket disconnected' );
    <kimi.ws.connected> = FALSE;
    <kimi.ws.status>    = qw| disconnected |;
    if ( defined <kimi.ws.io_watcher> ) {
        <kimi.ws.io_watcher>->cancel
            if <kimi.ws.io_watcher>->is_active;
        <kimi.ws.io_watcher> = undef;
    }
    ## check for active prompt entries — preserve them across reconnect
    ## so TurnEnd can still deliver the result after kimi-web finishes
    my $has_active_prompt = FALSE;
    foreach my $pend_id ( keys %{<kimi.wire.pending>} ) {
        my $pend = <kimi.wire.pending>->{$pend_id};
        if ( ( $pend->{'type'} // '' ) eq qw| prompt | ) {
            $has_active_prompt = TRUE;
            <[base.logs]>->(
                1, ': preserving pending prompt [ %s ] across reconnect',
                $pend_id
            );
        } else {
            ## fail non-prompt entries immediately [ e.g. initialize ]
            delete <kimi.wire.pending>->{$pend_id};
            my $rid = $pend->{'reply_id'} // '';
            if ( length($rid) ) {
                <[base.callback.cmd_reply]>->(
                    $rid, { 'mode' => 'false', 'data' => 'kimi disconnected' }
                );
            }
        }
    }

    ## preserve active task across reconnect if prompt is still pending
    if ( $has_active_prompt and defined <kimi.task.active_id> ) {
        <[base.logs]>->(
            1, ': keeping task %s active across reconnect',
            <kimi.task.active_id>
        );
    } elsif ( defined <kimi.task.active_id> ) {
        my $task_id = <kimi.task.active_id>;
        <[base.logs]>->(
            1, ': kimi disconnected mid-task %s, resetting to pending',
            $task_id
        );
        <[protocol-7.route-send]>->(
            {   'command'   => 'task.reset',
                'call_args' => { 'args' => $task_id }
            }
        );
        <kimi.task.active_id> = undef;
    }

    ## schedule grace timeout to fail preserved prompts if reconnect stalls
    if ($has_active_prompt) {
        <[event.add_timer]>->(
            {   'after'   => 90,
                'handler' => qw| kimi.handler.reconnect_grace_timeout |,
                'desc'    => 'fail preserved prompts if still pending'
            }
        );
    }

    <[kimi.connect.schedule_retry]>;
    return;
}

## parse json-rpc frame
my $msg = eval { JSON::from_json($text) };
if ($@) {
    my $preview = substr( $text, 0, 120 );
    $preview =~ s{\n}{ }g;
    <[base.logs]>->(
        0,  'kimi.handler.ws_message: json parse error : %s [ %s ]',
        $@, $preview
    );
    <buffer.json-errors.max_size> //= 42 * 1024;
    <[base.buffer.add_line]>->(
        qw| json-errors |,
        sprintf( '[ ws json error ] %s  %s', $@, $preview )
    );
    return;
}

my $method = $msg->{'method'} // '';
my $msg_id = $msg->{'id'}     // '';
my $params = $msg->{'params'} // {};

## --- server-sent events (method present, no id or id not a response) ---

if ( $method eq qw| history_complete | ) {
    <[base.logs]>
        ->( 2, 'kimi.handler.ws_message: history_complete received' );
    ## skip initialize if already ready, busy, or retry in progress
    if (   <kimi.ws.status> eq qw| ready |
        or <kimi.ws.status> eq qw| busy |
        or ( <kimi.init.retry_pending> // FALSE ) ) {
        <[base.logs]>->(
            2, ': skipping init [ status=%s retry_pending=%s ]',
            <kimi.ws.status>, <kimi.init.retry_pending> // 0
        );
        return;
    }
    <[kimi.wire.initialize]>;
    return;
}

if ( $method eq qw| session_status | ) {
    my $state = $params->{'state'} // '';
    <[base.logs]>->(
        2, 'kimi.handler.ws_message: session_status [ %s ]', $state
    );
    return;
}

if ( $method eq qw| event | ) {
    ## wire events: ContentPart, TurnBegin, TurnEnd, StepBegin, ToolCall, ...
    my $type    = $params->{'type'}    // '';
    my $payload = $params->{'payload'} // {};

    if ( $type eq qw| ContentPart | ) {
        my $part_type = $payload->{'type'} // '';
        if ( $part_type eq qw| text | ) {
            my $chunk = $payload->{'text'} // '';
            <kimi.wire.accumulator> .= $chunk;
        }
        ## ignore think/tool ContentParts for the plain response
        return;
    }

    if ( $type eq qw| TurnEnd | ) {
        <[base.logs]>->(
            2,
            'kimi.handler.ws_message: TurnEnd — reply length=%d',
            length(<kimi.wire.accumulator>)
        );

        ## find the pending prompt entry and fire deferred reply
        my ($pend_id) = grep {
            ( <kimi.wire.pending>->{$_}->{'type'} // '' ) eq qw| prompt |
        } keys %{<kimi.wire.pending>};

        if ( defined $pend_id ) {
            my $pend     = delete <kimi.wire.pending>->{$pend_id};
            my $reply_id = $pend->{'reply_id'} // '';
            my $response = <kimi.wire.accumulator>;
            <kimi.wire.accumulator> = '';
            <kimi.ws.status>        = qw| ready |;

            ## check if this was a task submission
            my $task_id = $pend->{'task_id'} // '';
            if ( length($task_id) and defined <kimi.task.active_id> ) {
                ## complete the task [ collapse newlines for single-line ipc ]
                ( my $safe_response = $response ) =~ s{\n}{ }g;
                <[protocol-7.route-send]>->(
                    {   'command'   => 'task.complete',
                        'call_args' => { 'args' => "$task_id $safe_response" }
                    }
                );
                <[base.logs]>->(
                    1,        ': task %s completed [ %d bytes result ]',
                    $task_id, length($response)
                );
                <kimi.task.active_id> = undef;
            }

            ## fire original reply handler if set
            if ( length($reply_id) ) {
                <[base.callback.cmd_reply]>->(
                    $reply_id, { 'mode' => 'size', 'data' => $response }
                );
            }
        } else {
            <kimi.wire.accumulator> = '';
            <kimi.ws.status>        = qw| ready |;
        }
        return;
    }

    ## other event types (TurnBegin, StepBegin, ToolCall, etc.) — log at debug
    <[base.logs]>->( 3, 'kimi.handler.ws_message: event [ type=%s ]', $type );
    return;
}

if ( $method eq qw| request | ) {
    ## tool approval or execution request from kimi-web
    my $type    = $params->{'type'}    // '';
    my $payload = $params->{'payload'} // {};

    if ( $type eq qw| ApprovalRequest | ) {
        <[kimi.handler.approval_request]>->( $msg_id, $payload );
        return;
    }

    if ( $type eq qw| ToolCallRequest | ) {
        ## external tool execution — not yet implemented
        <[base.logs]>->(
            1,       ': tool call request [ %s ] name=%s — not handled',
            $msg_id, $payload->{'name'} // '?'
        );
        return;
    }

    if ( $type eq qw| QuestionRequest | ) {
        ## structured question — not yet implemented
        <[base.logs]>->(
            1, ': question request [ %s ] — not handled', $msg_id
        );
        return;
    }

    <[base.logs]>->(
        2,     ': unknown request type [ %s ] id=%s',
        $type, $msg_id
    );
    return;
}

## --- responses to our requests (method is absent or empty) ---

if ( not length($method) and length($msg_id) ) {
    my $pend = delete <kimi.wire.pending>->{$msg_id};

    unless ( defined $pend ) {
        <[base.logs]>->(
            2,
            'kimi.handler.ws_message: response for unknown id [ %s ]', $msg_id
        );
        return;
    }

    if ( $pend->{'type'} eq qw| initialize | ) {
        if ( defined $msg->{'result'} ) {
            <kimi.ws.status>          = qw| ready |;
            <kimi.init.retry_count>   = 0;
            <kimi.init.retry_pending> = FALSE;
            if ( not <kimi.session.acquired> ) {
                ## first successful handshake — go online
                <kimi.session.acquired> = TRUE;
                <[base.logs]>
                    ->( 1, ': kimi-web ready to serve requests :..' );
                <[base.async.get_session_id]>;
            } else {
                <[base.logs]>->( 2, 'kimi: reconnected — status ready' );
            }
        } else {
            my $err = $msg->{'error'}{'message'} // 'unknown';
            ## log at level 2 for expected "agent turn in progress" retries
            my $log_level = $err =~ m{agent turn.*in progress}i ? 2 : 0;
            <[base.logs]>->(
                $log_level,
                'kimi.handler.ws_message: initialize failed : %s', $err
            );

            ## retry initialize when agent turn is still in progress
            ## [ kimi-web is finishing work from before the reconnect ]
            if ( $err =~ m{agent turn.*in progress}i ) {
                <kimi.init.retry_count> //= 0;
                <kimi.init.retry_count>++;
                if ( <kimi.init.retry_count> <= 12
                    and not( <kimi.init.retry_pending> // FALSE ) )
                {    ## ~60s max
                    <kimi.init.retry_pending> = TRUE;
                    <[base.logs]>->(
                        2, ': init retry %d/12 in 5s [ waiting for turn ]',
                        <kimi.init.retry_count>
                    );
                    <[event.add_timer]>->(
                        {   'after'   => 5,
                            'handler' => qw| kimi.wire.initialize |,
                            'desc'    => 'init retry after agent turn'
                        }
                    );
                } elsif ( <kimi.init.retry_count> > 12 ) {
                    <[base.logs]>->(
                        0, ': init retry limit reached — giving up'
                    );
                    <kimi.init.retry_count>   = 0;
                    <kimi.init.retry_pending> = FALSE;
                }
            }
        }
        return;
    }

    if ( $pend->{'type'} eq qw| prompt | ) {
        ## success/cancel response for the prompt request itself
        ## actual content arrives via event stream above
        my $status = ( $msg->{'result'} // {} )->{'status'} // 'unknown';
        <[base.logs]>->(
            2,
            'kimi.handler.ws_message: prompt response [ status=%s ]', $status
        );
        return;
    }
}

