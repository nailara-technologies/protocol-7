## [:< ##

# name  = base.chk-sum.jha.b32
# descr = returns BASE32 encoded [network ordered] jhash value

return Crypt::Misc::encode_b32r( pack qw| N |,
    Digest::JHash::jhash( join '', @ARG ) )

