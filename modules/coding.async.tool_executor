## [:< ##

# name  = coding.async.tool_executor
# descr = Execute tool calls asynchronously and trigger next request
# purpose = Phase 2+3: Tool execution loop for async mode

my ($task_id) = @ARG;

return unless defined $task_id;

<[base.logs]>->( 1, "tool_executor: STARTING for %s", $task_id );

## get state ##
my $state = <[coding.async.state_machine]>->( 'get', $task_id );
if ( !defined $state ) {
    <[base.logs]>->( 0, "tool_executor: no state for %s", $task_id );
    return;
}

my $tool_calls = $state->{'pending_tools'} // [];
my $round      = $state->{'round'}         // 0;

<[base.logs]>->(
    2, "async.tool_executor: task %s round %d executing %d tools",
    $task_id, $round, scalar(@$tool_calls)
);

## no tools to execute ##
if ( !@$tool_calls ) {
    <[base.logs]>->(
        1, "async.tool_executor: no tools, skipping to next request"
    );
    <[coding.async.state_machine]>->(
        'transition', $task_id, { 'event' => 'tools_done' }
    );
    return { success => TRUE, tool_results => [] };
}

## execute each tool call [ sequentially for simplicity ] ##
my @tool_results;
my @tool_summaries;

my $idx = 0;
foreach my $tc (@$tool_calls) {
    ## check for stop request between tools ##
    my $task_ref = <coding.task.queue>->{$task_id};
    if ( defined $task_ref && $task_ref->{'stop_requested'} ) {
        <[base.logs]>->(
            1, "tool_executor: stop requested, aborting after %d tools",
            scalar(@tool_results)
        );
        last;
    }

    my $tool_name = $tc->{'function'}->{'name'}      // '?';
    my $args_str  = $tc->{'function'}->{'arguments'} // '{}';
    my $call_id   = $tc->{'id'}                      // '';

    ## generate synthetic call_id if missing [ model didn't provide one ] ##
    if ( !length($call_id) ) {
        $call_id = sprintf( "call_%s_%d", $task_id, $idx );
        <[base.logs]>->(
            1, "tool_executor: generated synthetic call_id %s", $call_id
        );
    }

    <[base.logs]>->(
        2,          "async.tool_executor: calling %s [id=%s]",
        $tool_name, $call_id
    );

    ## parse arguments  use from_json -- args may be perl character strings ##
    ## [ wide chars ] decode_json expects raw bytes and dies on             ##
    ## utf8-flagged strings                                                 ##
    my $args = eval { JSON::PP->new->utf8(0)->decode($args_str) };

    ## repair common model JSON anti-patterns before retrying ##
    if ( $EVAL_ERROR || !defined $args ) {
        my $repaired = $args_str;
        my $did_repair;

        ## anti-pattern 1 : literal newlines|tabs inside string values ##
        ## model emits raw \n instead of \\n -- fix by escaping within ##
        ## strings                                                     ##
        if ($repaired =~ s/("(?:[^"\\]|\\.)*")/
            do { (my $s=$1) =~ s|(?<!\\)\n|\\n|g;
                              $s =~ s|(?<!\\)\r|\\r|g;
                              $s =~ s|(?<!\\)\t|\\t|g; $s }/ge
        ) {
            $did_repair = 'escaped literal whitespace in strings';
        }

        ## anti-pattern 2 : trailing comma before closing } or ] ##
        $repaired =~ s/,(\s*[}\]])/$1/g
            and $did_repair //= 'removed trailing comma';

        ## anti-pattern 3 : illegal backslash escapes like \[ \# \< \$ ##
        ## valid JSON escapes: \" \\ \/ \b \f \n \r \t \uXXXX          ##
        if ( $repaired =~ s|\\([^"\\\/bfnrtu])|'\\\\' . $1|ge ) {
            $did_repair //= 'fixed illegal backslash escapes';
        }

        if ($did_repair) {
            $args = eval { JSON::PP->new->utf8(0)->decode($repaired) };

            <[base.logs]>->(
                1,          "tool_executor: repaired args for %s [%s]",
                $tool_name, $did_repair
            ) unless $EVAL_ERROR;
            $args_str = $repaired;
        }
    }

    ## handle concatenated JSON objects [ model error ] ##
    if ( $EVAL_ERROR && $args_str =~ m/^\s*\{.*\}\s*\{/s ) {
        ## multiple objects concatenated - try to extract first valid one ##
        if ( $args_str =~ m/^\s*(\{.*?\})\s*(?:\{|\z)/s ) {
            my $first_obj = $1;
            $args = eval { JSON::PP->new->utf8(0)->decode($first_obj) };
            <[base.logs]>->(
                1,
                "tool_executor: extracted first JSON "
                    . "object from concatenated args for %s",
                $tool_name
            ) unless $EVAL_ERROR;
        }
    }

    ## malformed arguments -- skip dispatch and return parse error to model ##
    ## giving the model the exact error lets it fix its JSON rather than    ##
    ## retrying blindly with empty args                                     ##
    if ( $EVAL_ERROR || ref $args ne qw| HASH | ) {
        my $parse_err
            = $EVAL_ERROR
            ? <[base.str.eval_error]>
            : "expected object, got " . ref($args);
        ## sanitize preview -- raw broken args in tool result crash Jinja ##
        my $args_preview = substr( $args_str, 0, 120 );
        $args_preview .= '...' if length($args_str) > 120;
        $args_preview =~ s/[^\x20-\x7E]/?/g;
        <[base.logs]>->(
            0, "async.tool_executor: malformed args for %s: %s [args=%s]",
            $tool_name, $parse_err, $args_preview
        );
        push @tool_results,
            {
            'role'         => 'tool',
            'tool_call_id' => $call_id,
            'content'      => sprintf(
                "ERROR: could not parse tool arguments for %s.\n%s\nPlease "
                    . "fix your JSON and call the tool again.\nCommon "
                    . "issues: unescaped backslashes (use \\\\ not \\), "
                    . "literal newlines in strings (use \\n), trailing "
                    . "commas.",
                $tool_name, $parse_err
            ),
            };
        $tc->{'id'} = $call_id;
        next;
    }

    ## dispatch tool call  coding.tools.dispatch expects a single hashref ##
    ## with function.* keys                                               ##
    my $tool_result;
    my $tool_call = {
        'function' => {
            'name'      => $tool_name,
            'arguments' => $args,
        },
        'id' => $call_id,
    };
    <[base.logs]>->(
        2,          "tool_executor: dispatching %s with args: %s",
        $tool_name, join( ', ', keys %$args ) || 'no args'
    );
    eval { $tool_result = <[coding.tools.dispatch]>->($tool_call); };

    if ($@) {
        <[base.logs]>->(
            0,          "async.tool_executor: tool %s died: %s",
            $tool_name, $@
        );
        $tool_result
            = { error =>
                sprintf( "tool execution died: %s", <[base.str.eval_error]> )
            };
    } elsif ( !defined $tool_result ) {
        <[base.logs]>->(
            0, "async.tool_executor: tool %s returned undef", $tool_name
        );
        $tool_result = { error => 'Tool returned undef' };
    } else {
        <[base.logs]>->(
            2, "tool_executor: tool %s result type: %s",
            $tool_name, ( defined $tool_result ? ref $tool_result : 'undef' )
        );
    }

    ## format result ##
    my $result_content;
    if ( defined $tool_result && ref $tool_result eq 'HASH' ) {
        ## coding.tools.dispatch returns 'content', not 'data' ##
        $result_content = $tool_result->{'content'}
            // $tool_result->{'error'} // 'empty result';
        <[base.logs]>->(
            2,          "tool_executor: %s result keys: %s",
            $tool_name, join( ', ', sort keys %$tool_result )
        );
        <[base.logs]>->(
            2,          "tool_executor: %s content length: %d",
            $tool_name, length($result_content)
        );
    } else {
        $result_content = 'tool returned invalid result: '
            . ( defined $tool_result ? ref $tool_result : 'undef' );
        <[base.logs]>->(
            0,
            "async.tool_executor: tool %s returned invalid result type: %s",
            $tool_name,
            ( defined $tool_result ? ref $tool_result : 'undef' )
        );
    }

    ## reject-with-instructions instead of appending an oversized tool     ##
    ## result -- never truncate mid-content [ could cut off mid-tag/line ] ##
    ## ; tell the model exactly how to retry narrower, mirroring           ##
    ## edit_file's auto-split pattern [ coding.tools.dispatch ~line 393 ]  ##
    my $tool_result_too_large = FALSE;
    {
        my $routed  = $state->{'backend'} // 'gpu';
        my $srv_key = $routed eq qw| cpu | ? qw| cpu | : qw| gpu |;
        my $srv_n_ctx
            = ( <coding.inference_servers> // {} )->{$srv_key}->{'n_ctx'}
            // <inference.model.context_length> // 16384;

        my $chars_per_token = 3.2;
        my $existing_chars  = length(
            JSON::PP->new->utf8->encode(
                {   'messages' => $state->{'messages'} // [],
                    'tools'    => $state->{'tools'}    // [],
                }
            )
        );
        my $headroom     = 500;
        my $budget_chars = ( $srv_n_ctx - $headroom ) * $chars_per_token;

        if ( $existing_chars + length($result_content) > $budget_chars ) {
            $tool_result_too_large = TRUE;
            my $result_tokens
                = int( length($result_content) / $chars_per_token );
            my $available_tokens = int(
                ( $budget_chars - $existing_chars ) / $chars_per_token );
            $available_tokens = 0 if $available_tokens < 0;
            <[base.logs]>->(
                0,
                "tool_executor: %s result too large [ ~%d tokens, "
                    . "only ~%d available ], rejecting with instructions",
                $tool_name,
                $result_tokens,
                $available_tokens
            );
            $result_content
                = sprintf(
                "ERROR: %s result too large to fit remaining context [ ~%d "
                    . "tokens, only ~%d available ].\nRetry with a narrower "
                    . "range: read_file offset=N length=M [ smaller M ], or "
                    . "use search_code / ncode_search to locate the exact "
                    . "target line first, then read_file a small range "
                    . "around it.",
                $tool_name, $result_tokens, $available_tokens );
        }
    }

    ## replace-in-place paging for read_file : a repeat call against the   ##
    ## same path supersedes its prior page in message history instead of   ##
    ## appending -- keeps context bounded no matter how many pages a task  ##
    ## walks. content is overwritten but role/tool_call_id stay untouched, ##
    ## so the assistant/tool tool_call_id pairing the backend template     ##
    ## expects is never broken                                             ##
    if (    $tool_name eq 'read_file'
        and ref $args eq 'HASH'
        and not $tool_result_too_large ) {
        my $rf_path = $args->{'path'} // '';
        if ( length $rf_path ) {
            my $paged = $state->{'paged_reads'} //= {};
            if ( my $prior_id = $paged->{$rf_path} ) {
                for my $m ( @{ $state->{'messages'} // [] } ) {
                    if (    ( $m->{'role'} // '' ) eq 'tool'
                        and ( $m->{'tool_call_id'} // '' ) eq $prior_id ) {
                        my ($prior_range)
                            = $m->{'content'}
                            =~ m/^\.:\[ file: \Q$rf_path\E\s+lines (\S+)/;
                        $m->{'content'}
                            = sprintf( "[ superseded: lines %s of %s -- "
                                . "replaced by a later read_file call ]",
                            $prior_range // '?', $rf_path );
                        last;
                    }
                }
            }

            ## still partial [ footer's continuation hint present ] : keep ##
            ## tracking this path so the *next* page supersedes this one.  ##
            ## reached end of file : stop tracking, this page is the final ##
            ## one and should stay intact                                  ##
            if ( $result_content =~ /to continue: read_file path=/ ) {
                $paged->{$rf_path} = $call_id;
            } else {
                delete $paged->{$rf_path};
            }
        }
    }

    ## build tool result message ##
    my $tool_result_msg = {
        'role'         => 'tool',
        'tool_call_id' => $call_id,
        'content'      => $result_content,
    };

    push @tool_results, $tool_result_msg;

    ## update tool call id in pending_tools [ for assistant message ] ##
    $tc->{'id'} = $call_id;

    ## write to per-task buffers ##
    my $round = $state->{'round'} // 0;
    <[coding.buffer.task_write]>->(
        $task_id, '',
        'tool_call',
        {   'round' => $round,
            'name'  => $tool_name,
            'args'  => ref $args eq 'HASH' ? $args : {},
        }
    );
    <[coding.buffer.task_write]>->(
        $task_id,
        $result_content,
        'tool_result',
        {   'round' => $round,
            'name'  => $tool_name,
            'size'  => length($result_content),
        }
    );

    ## summary for logging ##
    my $snippet = substr( $result_content, 0, 60 );
    $snippet =~ s|\n| |g;
    push @tool_summaries, sprintf( "%s=%s", $tool_name, $snippet );

    $idx++;
}

<[base.logs]>->(
    2,                     "async.tool_executor: completed %d tools [%s]",
    scalar(@tool_results), join( ', ', @tool_summaries )
);

## update state with tool results [keep pending_tools for state_machine] ##
$state = <[coding.async.state_machine]>->(
    'set', $task_id,
    {   'tool_results' => \@tool_results,
        ## pending_tools kept for state_machine to build assistant message
    }
);

## check if task_complete or escalate was called during tool execution ##
if (<coding.tool_loop.stop>) {
    my $stop_reason  = <coding.tool_loop.stop_reason>  // 'task_complete';
    my $stop_summary = <coding.tool_loop.stop_summary> // 'task completed';
    ## reset flags ##
    <coding.tool_loop.stop>         = FALSE;
    <coding.tool_loop.stop_reason>  = undef;
    <coding.tool_loop.stop_summary> = undef;
    <[base.logs]>->(
        1,            "tool_executor: stop flag set [%s], completing task %s",
        $stop_reason, $task_id
    );
    ## set final content from stop summary ##
    <[coding.async.state_machine]>->(
        'set', $task_id, { 'final_content' => $stop_summary }
    );
    <[coding.async.complete_task]>->($task_id);
    return { success => TRUE, tool_results => \@tool_results };
}

## transition back to streaming [pass tool_calls for assistant message] ##
<[coding.async.state_machine]>->(
    'transition',
    $task_id,
    {   'event'      => qw| tools_done |,
        'tool_calls' => $tool_calls,  ## original tool calls for assistant msg
        'tool_results' => \@tool_results,
    }
);

return { success => TRUE, tool_results => \@tool_results };

