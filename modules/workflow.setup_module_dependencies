## [:< ##

# name = workflow.setup_module_dependencies
# descr = Setup dependency tracking for perl modules from suggestions yaml

<[base.log]>->( 2, 'setting up perl module dependency tracking..' );

## Load suggestions if not already loaded ##
my $suggestions_data = <workflow.suggestions>;
unless ($suggestions_data) {
    <[workflow.load_suggestions]>->();
    $suggestions_data = <workflow.suggestions>;
}

return unless $suggestions_data;

## Install callbacks for dependency validation ##
<[dependency.install_callbacks]>->('workflow');

## Get dependencies from suggestions yaml ##
my $dependencies = $suggestions_data->{dependencies} // {};

## Track essential modules ##
my $essential = $dependencies->{essential} // [];
foreach my $dep (@$essential) {
    my $module_name = $dep->{name};
    my $install_cmd = $dep->{install} // '';

    <[base.log]>->( 3, "  registering essential module: $module_name" );

    ## Create dependency object ##
    my $object_id = <[dependency.add_object]>->({
        type         => 'perl_module',
        module_name  => $module_name,
        install_cmd  => $install_cmd,
        priority     => 'essential'
    });

    ## Store for easy lookup ##
    <workflow.dependencies.essential>{$module_name} = $object_id;
}

## Track optional modules ##
my $optional = $dependencies->{optional} // [];
foreach my $dep (@$optional) {
    my $module_name = $dep->{name};
    my $install_cmd = $dep->{install} // '';

    <[base.log]>->( 3, "  registering optional module: $module_name" );

    ## Create dependency object ##
    my $object_id = <[dependency.add_object]>->({
        type         => 'perl_module',
        module_name  => $module_name,
        install_cmd  => $install_cmd,
        priority     => 'optional'
    });

    ## Store for easy lookup ##
    <workflow.dependencies.optional>{$module_name} = $object_id;
}

my $essential_count = scalar(@$essential);
my $optional_count = scalar(@$optional);
<[base.log]>->( 2, "  ✓ registered $essential_count essential, $optional_count optional modules" );

return 1;

0;

