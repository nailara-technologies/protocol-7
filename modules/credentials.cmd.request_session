## [:< ##

# name  = credentials.cmd.request_session
# descr = request credential access (cube-authenticated caller)
#         via source_zenka alias

## SOURCE_ZENKA alias prepends the caller's identity as the first token ##
my $args = $call->{'args'} // '';
my ( $zenka_name, $cred_name ) = split( m|\s+|, $args, 2 );
$zenka_name //= '';
$cred_name  //= '';

$cred_name =~ s|^\s+||;
$cred_name =~ s|\s+$||;

return { 'mode' => qw| false |, 'data' => 'missing credential name' }
    unless length $cred_name;

return { 'mode' => qw| false |, 'data' => 'missing zenka identity' }
    unless length $zenka_name;

## load credential entry ##
my $cred = <[credentials.load]>->($cred_name);
return {
    'mode' => qw| false |,
    'data' => "unknown credential '$cred_name'"
    }
    unless defined $cred;

## check authorization ##
my @authorized = @{ $cred->{'authorized_zenki'} // [] };
unless ( grep { $ARG eq $zenka_name } @authorized ) {
    <[credentials.audit]>->( $zenka_name, $cred_name, qw| DENIED | );
    return { 'mode' => qw| false |, 'data' => 'not authorized' };
}

<[credentials.audit]>->( $zenka_name, $cred_name, qw| GRANTED | );

## provision access based on type ##
if ( $cred->{'type'} eq qw| web-session | ) {
    return <[credentials.spawn_web_session]>->( $cred, $zenka_name );
} elsif ( $cred->{'type'} eq qw| api-key | ) {
    return { 'mode' => qw| true |, 'data' => $cred->{'key'} };
} elsif ( $cred->{'type'} =~ m{^(smtp|imap)$} ) {
    return {
        'mode' => qw| true |,
        'data' => {
            'host' => $cred->{'host'},
            'user' => $cred->{'username'},
            'pass' => $cred->{'password'},
        }
    };
} else {
    return {
        'mode' => qw| false |,
        'data' => "unsupported credential type '" . $cred->{'type'} . "'"
    };
}

