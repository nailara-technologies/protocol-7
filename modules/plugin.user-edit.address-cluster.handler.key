## [:< ##

# name  = plugin.user-edit.address-cluster.handler.key
# descr = address-cluster plugin's key handling -- entry cycling, primary toggle, body/label edit
# param = $editor_state, $field, $key

## KEYBINDINGS, chosen against real constraints found live while building
## this, documented here since none of them are the obvious/default choice :
##
## PageUp/PageDown : previous/next entry -- the only navigation-ish key with
## established precedent in this codebase [ list windowing, multiline
## windowing both already page ], per advisor.
##
## Left is PERMANENTLY UNAVAILABLE : user-edit.handler.stdin_key's plugin-
## mode block intercepts it unconditionally to LEAVE plugin mode, before ever
## reaching this sub -- confirmed by reading that block, not assumed.  Right
## is free [ that interception only fires OUTSIDE plugin mode, for the
## two-stage entry trigger ; once mode = 'plugin:<field>' this sub sees every
## key except Left ], so Right moves the cursor right within whichever text is
## targeted. Left's absence is filled by Ctrl+B [ 'back', unclaimed, mnemonic
## enough given no arrow is available ] rather than left as a real gap --
## without it there would be no NON-destructive way to move backward through
## typed text at all, only Backspace.
##
## Tab : toggles which of the current entry's TWO text fields [ label / body ]
## typing goes to. free to use here -- inside plugin mode Tab is NOT the
## generic field_next it is everywhere else, since every key but Left routes
## straight here.
##
## Insert : new entry. Ctrl+P : toggle primary on the current entry.  Ctrl+D :
## delete the current entry -- NOT bare Delete, which stays an ordinary
## forward-character-delete exactly as anyone editing body text would expect ;
## a whole-entry delete needs a key nothing else means.
##
## Up/Down : move between the BODY's own lines [ no-op for label, which is
## always one line ] -- reuses editor.control.multiline.cursor_line /
## line_col_to_offset against the body substring alone, same helpers the core
## multiline feature uses against a whole field's buffer.
##
## STATE : selection/target/cursor persist on
## $editor_state->{'plugin_state'}{$field} -- confirmed LIVE, across separate
## char-add calls, to be the same object <user-edit.form.state> always
## returns, not a per-call snapshot. entries themselves are NEVER held
## authoritative there : re-parsed from the buffer on every single call [
## parse_blob ] and, whenever this sub changes them, immediately re-
## serialized and written straight back [ write_buffer ] -- write-through, not
## a cache, so there is only ever ONE copy of the data to drift from itself.
## this is the same lesson the add_field/schema_from_record drift bugs already
## taught twice this session, applied here from the start rather than found
## live a third time.

my ( $editor_state, $field, $key ) = @ARG;

return undef if ref $editor_state ne qw| HASH |;
return undef if not length $field;

my $raw     = <[editor.control.get_value]>->( $editor_state, $field ) // '';
my $entries = <[plugin.user-edit.address-cluster.parse_blob]>->($raw);

my $state = ( $editor_state->{'plugin_state'}{$field} //= {} );

my $selected = $state->{'selected'} // 0;
$selected            = 0            if $selected < 0;
$selected            = $#{$entries} if $selected > $#{$entries};
$selected            = 0            if $selected < 0;
$state->{'selected'} = $selected;

$state->{'target'} //= qw| body |;
$state->{'cursor'} //= 0;

## NEW ENTRY, works even on an empty list -- the only key meaningful then ##
if ( $key eq "\e[2~" or $key eq "\x1b[2~" ) {    ## Insert ##

    my $ref = <[plugin.user-edit.address-cluster.gen_ref]>
        ->( [ map { $ARG->{'ref'} } $entries->@* ] );
    return FALSE if not defined $ref;

    push $entries->@*,
        {
        qw| ref |     => $ref,
        qw| label |   => '',
        qw| primary | => ( not scalar $entries->@* ) ? TRUE : FALSE,
        qw| body |    => '',
        };

    $state->{'selected'} = $#{$entries};
    $state->{'target'}   = qw| body |;
    $state->{'cursor'}   = 0;

    <[plugin.user-edit.address-cluster.write_buffer]>->(
        $editor_state, $field, $entries
    );
    return TRUE;
}

return FALSE if not $entries->@*;    ## every other key needs a real entry ##

my $entry = $entries->[$selected];

## cursor lands at the END of the newly-shown text on every selection/target
## change below, not the start -- per advisor : cursor-at-0 was this sub's own
## first-draft choice, and it means the FIRST keystroke after switching to an
## entry/target that already has content PREPENDS to it rather than continuing
## it, the less conventional of the two options and a real annoyance
## correcting a typo in an existing label would hit immediately
if ( $key eq "\e[6~" or $key eq "\x1b[6~" ) {    ## PageDown : next entry ##
    if ( $selected < $#{$entries} ) {
        $state->{'selected'} = $selected + 1;
        $state->{'cursor'}
            = length( $entries->[ $selected + 1 ]{ $state->{'target'} }
                // '' );
    }
    return TRUE;
}

if ( $key eq "\e[5~" or $key eq "\x1b[5~" ) {    ## PageUp : previous entry ##
    if ( $selected > 0 ) {
        $state->{'selected'} = $selected - 1;
        $state->{'cursor'}
            = length( $entries->[ $selected - 1 ]{ $state->{'target'} }
                // '' );
    }
    return TRUE;
}

if ( $key eq "\t" ) {    ## Tab : swap target ##
    my $new_target
        = $state->{'target'} eq qw| body | ? qw| label | : qw| body |;
    $state->{'target'} = $new_target;
    $state->{'cursor'} = length( $entry->{$new_target} // '' );
    return TRUE;
}

if ( $key eq "\x10" ) {    ## Ctrl+p : toggle primary ##
    $ARG->{'primary'}   = FALSE foreach $entries->@*;
    $entry->{'primary'} = TRUE;
    <[plugin.user-edit.address-cluster.write_buffer]>->(
        $editor_state, $field, $entries
    );
    return TRUE;
}

if ( $key eq "\x04" ) {    ## Ctrl+d : delete entry ##
    my $was_primary = $entry->{'primary'};
    splice( $entries->@*, $selected, 1 );

    if ( $was_primary and $entries->@* ) {
        $entries->[0]{'primary'} = TRUE;
    }

    my $new_selected = $selected > 0 ? $selected - 1 : 0;
    $state->{'selected'} = $new_selected;
    $state->{'cursor'}
        = length( ( $entries->[$new_selected] // {} )->{ $state->{'target'} }
            // '' );

    <[plugin.user-edit.address-cluster.write_buffer]>->(
        $editor_state, $field, $entries
    );
    return TRUE;
}

## everything below edits WHICHEVER text is targeted -- label is a single
## line, body may be multiple ; cursor is an offset into that TEXT alone,
## never into the other one, reset to 0 whenever Tab/PageUp/PageDown moves the
## target or selection [ above ]
my $target_key = $state->{'target'};
my $text       = $entry->{$target_key} // '';
my $cursor     = $state->{'cursor'}    // 0;
$cursor = 0             if $cursor < 0;
$cursor = length($text) if $cursor > length($text);

if ( $key eq "\e[C" or $key eq "\x1b[C" ) {    ## Right : cursor + 1 ##
    $state->{'cursor'} = $cursor + 1 if $cursor < length($text);
    return TRUE;
}

if ( $key eq "\x02" ) {    ## Ctrl+b : cursor - 1 ##
    $state->{'cursor'} = $cursor - 1 if $cursor > 0;
    return TRUE;
}

## editor.control.multiline.line_col_to_offset takes the PRE-SPLIT lines
## arrayref as its first param, not raw text -- computed once here and reused
## by Home/End/Up/Down below rather than re-split per branch
my $lines_of_target = <[editor.control.multiline.lines]>->($text);

if ( $key eq "\e[H" or $key eq "\x1b[H" ) {    ## Home ##
    if ( $target_key eq qw| body | ) {
        my ($line_no)
            = <[editor.control.multiline.cursor_line]>->( $text, $cursor );
        $state->{'cursor'}
            = <[editor.control.multiline.line_col_to_offset]>->(
            $lines_of_target, $line_no, 0
            );
    } else {
        $state->{'cursor'} = 0;
    }
    return TRUE;
}

if ( $key eq "\e[F" or $key eq "\x1b[F" ) {    ## End ##
    if ( $target_key eq qw| body | ) {
        my ($line_no)
            = <[editor.control.multiline.cursor_line]>->( $text, $cursor );
        my $line_len = length( $lines_of_target->[$line_no] // '' );
        $state->{'cursor'}
            = <[editor.control.multiline.line_col_to_offset]>->(
            $lines_of_target, $line_no, $line_len
            );
    } else {
        $state->{'cursor'} = length($text);
    }
    return TRUE;
}

## Up/Down : between the BODY's own lines only -- a label is always one line,
## nothing to move between, so these are no-ops on that target
if (
    (      $key eq "\e[A"
        or $key eq "\x1b[A"
        or $key eq "\e[B"
        or $key eq "\x1b[B"
    )
    and $target_key eq qw| body |
) {

    my $direction = ( $key eq "\e[A" or $key eq "\x1b[A" ) ? -1 : 1;
    my ( $line_no, $col )
        = <[editor.control.multiline.cursor_line]>->( $text, $cursor );
    my $target_line = $line_no + $direction;
    my $total_lines = scalar $lines_of_target->@*;

    if ( $target_line >= 0 and $target_line < $total_lines ) {
        $state->{'cursor'}
            = <[editor.control.multiline.line_col_to_offset]>->(
            $lines_of_target, $target_line, $col
            );
    }
    return TRUE;
}

## Enter / Backspace / Delete-forward each RETURN UNCONDITIONALLY once
## matched, same as the printable/backspace pair every plugin handler.key in
## this codebase already returns unconditionally for [ see plugin.user-edit.
## example.handler.key's own precedent ] -- REAL BUG caught by advisor before
## this could bite live : an earlier draft left Backspace's return implicit,
## conditional on $mutated, which only got set INSIDE the "cursor > 0" guard.
## Backspace pressed at cursor == 0 [ e.g. an empty body ] then fell through
## with $mutated still FALSE into the printable check below -- which does NOT
## exclude "\x7f" [ ord 127, satisfies ord >= 32 same as any real printable
## byte does ], so a no-op backspace on empty text would have INSERTED A
## LITERAL DEL BYTE into the entry instead of doing nothing.  returning
## immediately after the key is recognised, whether or not the guard inside
## fired, closes this off structurally rather than by careful exclusion in the
## printable check
if ( $key eq "\n" and $target_key eq qw| body | ) {    ## Enter : newline ##
    $text = substr( $text, 0, $cursor ) . "\n" . substr( $text, $cursor );
    $state->{'cursor'}    = $cursor + 1;
    $entry->{$target_key} = $text;
    <[plugin.user-edit.address-cluster.write_buffer]>->(
        $editor_state, $field, $entries
    );
    return TRUE;
}

if ( $key eq "\x08" or $key eq "\x7f" ) {    ## Backspace ##
    if ( $cursor > 0 ) {
        $text = substr( $text, 0, $cursor - 1 ) . substr( $text, $cursor );
        $state->{'cursor'}    = $cursor - 1;
        $entry->{$target_key} = $text;
        <[plugin.user-edit.address-cluster.write_buffer]>->(
            $editor_state, $field, $entries
        );
    }
    return TRUE;
}

if ( $key eq "\e[3~" or $key eq "\x1b[3~" ) {    ## Delete forward ##
    if ( $cursor < length($text) ) {
        $text = substr( $text, 0, $cursor ) . substr( $text, $cursor + 1 );
        $entry->{$target_key} = $text;
        <[plugin.user-edit.address-cluster.write_buffer]>->(
            $editor_state, $field, $entries
        );
    }
    return TRUE;
}

return FALSE
    if not length $key
    or ord( substr( $key, 0, 1 ) ) < 32;    ## not printable ##

$text = substr( $text, 0, $cursor ) . $key . substr( $text, $cursor );
$state->{'cursor'} = $cursor + length($key);

$entry->{$target_key} = $text;

<[plugin.user-edit.address-cluster.write_buffer]>->(
    $editor_state, $field, $entries
);

return TRUE;

