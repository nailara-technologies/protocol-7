## [:< ##

# name  = plugin.user-edit.address-cluster.handler.key
# descr = address-cluster plugin's key handling -- MINIMAL smoke-test stage
# param = $editor_state, $field, $key

## SMOKE-TEST STAGE ONLY, per plugin.user-edit.example.handler.key's own
## precedent : proves user-edit.handler.stdin_key's plugin-mode dispatch [
## including the empty-field entry fix this same change made in stdin_key ]
## actually reaches this sub before the real ref-generation / blob-parsing /
## entry-cycling logic is layered on top. printable characters append,
## Backspace drops the last character -- not the real editing UI.

my ( $editor_state, $field, $key ) = @ARG;

## TEMP persistence probe, removed once verified ##
$editor_state->{'plugin_state'}{$field}{'probe'}++;

my $buffer = $editor_state->{'fields'}{$field} // return undef;
my $len    = <[editor.buffer.memory.length]>->($buffer);

if ( $key eq "\x08" or $key eq "\x7f" ) {    ## backspace ##
    <[editor.control.commands.delete]>->(
        $editor_state, $field, $len - 1, $len
    ) if $len > 0;
    return TRUE;
}

if ( length $key and ord( substr( $key, 0, 1 ) ) >= 32 ) {    ## printable ##
    <[editor.control.commands.insert]>->( $editor_state, $field, $len, $key );
    return TRUE;
}

return FALSE;

