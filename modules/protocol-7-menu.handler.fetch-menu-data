# name = protocol-7-menu.handler.fetch-menu-data
# descr = Handle provider data fetch reply - parse YAML and update menu structure

<[base.perlmod.load]>->('YAML::XS');

my $params = shift;
my $provider = $params->{'params'}->{'provider'};
my $update_ref = $params->{'params'}->{'update_ref'};
my $yaml_string = $params->{'data'};

<[base.log]>->( 1, "received menu data from provider '%s' (%d bytes)", $provider, length($yaml_string // '') );

return unless defined $yaml_string && length($yaml_string) > 0;

# Parse YAML data
my $provider_data;
eval {
    my $prepended_yaml = "---\n" . $yaml_string;
    $provider_data = YAML::XS::Load($prepended_yaml);
};

if ($@) {
    <[base.s_warn]>->('Failed to parse provider data from %s: %s', $provider, $@);
    return;
}

# Validate structure
unless (ref($provider_data) eq 'HASH' && defined $provider_data->{'items'}) {
    <[base.s_warn]>->('Provider data invalid - no items hash from %s', $provider);
    return;
}

# Update menu structure with provider data
my $menu_structure = <protocol-7-menu.menu-structure>;
$menu_structure->{providers}{$provider} = $provider_data;

# Mark structure as changed (triggers watcher)
$menu_structure->{'last-changed'} = <[base.ntime.b32]>;

<[base.log]>->( 1, "menu structure updated from provider '%s' with %d items",
    $provider, scalar(keys %{$provider_data->{'items'}}) );

0;

