## [:< ##
# name = memory.tree.zoom
# descr = multiply n_visible globally, respecting vterm columns

my $params = shift               // {};
my $n      = $params->{'factor'} // 1;

my $cfg = <memory.cfg> // {};

$cfg->{'n_visible'} = int( 7 * $n );

$cfg->{'n_visible'} = 1 if $cfg->{'n_visible'} < 1;

my $max_cols = <vterm.default_cols> // 80;
$cfg->{'n_visible'} = $max_cols if $cfg->{'n_visible'} > $max_cols;

my $cap = $cfg->{'n_max_cap'} // 13;
$cfg->{'n_visible'} = $cap if $cfg->{'n_visible'} > $cap;

<memory.tree> {'n_visible'} = $cfg->{'n_visible'}
    if defined <memory.tree>;

return $cfg->{'n_visible'};

