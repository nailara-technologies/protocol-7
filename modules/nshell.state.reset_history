# name = nshell.state.reset_history
# descr = Reset history navigation state when user begins editing

my ($state_ref) = @_;

## Reset navigation state when user edits in VIEWING_HISTORY mode
## This returns us to NORMAL mode for further editing
if ( $state_ref->{'current_mode'} == 2 ) {    # VIEWING_HISTORY
    $state_ref->{'current_mode'}          = 0;     # NORMAL
    $state_ref->{'current_history_index'} = -1;
    $state_ref->{'paging_index_stack'}    = [];    # Clear paging stack

    ## [ also reset ctrl+o cycle state to prevent stale state issues ]
    $state_ref->{'ctrl_o_start_position'}   = -1;
    $state_ref->{'ctrl_o_entries_added'}    = 0;
    $state_ref->{'ctrl_o_redraw_cursor'}    = FALSE;
    $state_ref->{'display_preloaded_entry'} = FALSE;
}

return;

