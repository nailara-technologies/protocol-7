# name = nshell.redraw_command_line
# descr = Helper to clear and redraw command line from history

my ( $buffer, $display ) = @_;

## Clear current line and redraw
## Get terminal width for proper clearing (safe fallback for non-TTY contexts)
my $term_width = eval { AMOS7::TERM::terminal_size() } // 80;
my $clear_len  = length($buffer) + 20;                         ## Leave margin
print "\r" . ( ' ' x $clear_len ) . "\r" . $display;

return;

