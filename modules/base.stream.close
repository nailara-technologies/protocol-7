## [:< ##

# name  = base.stream.close
# descr = close an open STRM / STRM-SIZE stream : emits 'close' frame if the
#         stream is still alive ; cleans producer-side state either way
# param = <handle>
# return = 1 on clean close [ close frame emitted ], 0 if gated

my $h = shift;

return 0 if not defined $h or ref $h ne qw| HASH |;

my $sid    = $h->{'sid'};
my $cmd_id = $h->{'cmd_id'};
my $type   = $h->{'type'};

my $session = <[base.stream.gate]>->( $sid, $cmd_id, 1 );

if ( not defined $session ) {

    ##  gated : skip the close frame [ peer gone / cancelled ] but still   ##
    ##  clean any residual producer state so the next cmd_id reuse is safe ##

    if ( exists $data{'session'}{$sid} ) {
        delete $data{'session'}{$sid}{'streams'}{$cmd_id}
            if exists $data{'session'}{$sid}{'streams'}{$cmd_id};
    }

    ##  closing a stream is not itself input/output traffic, but the       ##
    ##  idle-shutdown watcher only re-checks after one of those -- give it ##
    ##  a prompt chance now instead of waiting on the next unrelated event ##
    $data{'watcher'}{'io'}{'transfer'}->start
        if defined $data{'watcher'}{'io'}{'transfer'}
        and not $data{'watcher'}{'io'}{'transfer'}->is_active;

    return 0;
}

my $cmd_id_str = $session->{'streams'}->{$cmd_id}->{'cmd_id_str'} // '';
my $frame      = sprintf "%s%s close\n", $cmd_id_str, $type;

my $written = bytes::length($frame);
utf8::downgrade( $session->{'buffer'}->{'output'}, 1 )
    if utf8::is_utf8( $session->{'buffer'}->{'output'} );
$session->{'buffer'}->{'output'} .= $frame;

<[base.stream.record_emission]>->( $sid, $cmd_id, $written, $type );

delete $session->{'streams'}->{$cmd_id};

##  same idle-watcher nudge as the gated branch above -- the buffer write ##
##  just queued here doesn't itself flush through base.handler.write      ##
$data{'watcher'}{'io'}{'transfer'}->start
    if defined $data{'watcher'}{'io'}{'transfer'}
    and not $data{'watcher'}{'io'}{'transfer'}->is_active;

return 1;

