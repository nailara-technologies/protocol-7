## [:< ##

# name  = base.indexcube.here
# descr = Return current position (top of @INDEXCUBE)

return { 'mode' => qw| false |, 'data' => 'stack empty' }
    unless @INDEXCUBE;

my $entry = $INDEXCUBE[-1];

return {
    'mode' => qw| true |,
    'data' => {
        'p7ref'     => $entry->{'p7ref'},
        'depth'     => $entry->{'depth'},
        'timestamp' => $entry->{'timestamp'},
        'signature' => $entry->{'signature'},
        'is_origin' => scalar(@INDEXCUBE) == 1,
    }
};

