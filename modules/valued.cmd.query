## [:< ##

# name  = valued.cmd.query
# descr = query valued tree with n, parent, type filters

my $params = {};

## parse params: hash path first, then positional args fallback ##
if ( $call->{'args'} ) {
    my $n_arg = $call->{'args'};
    $n_arg =~ s{\s+$}{};    ## trim trailing whitespace ##

    if ( $n_arg =~ /^\d+$/ ) {
        $params = { 'n' => $n_arg, 'parent' => '', 'type' => '' };
    }
}

if ( !$n && $args ) {

    # positional args fallback: first token = n
    my @toks = split /[\\\\\\\\\s,]+/, $args;
    $n = $toks[0] if $toks[0] =~ /^\\\\\\\\\d+$/;
}

# validate n is a positive integer, clamp to range 1..100
$n =~ s/[^0-9]//g;
if ( !$n || $n < 1 ) { $n = 10; }
if ( $n > 100 )      { $n = 100; }

# call the internal sub
my $result = <[valued.tree.top_n]>
    ->( { n => $n, parent => $parent, type => $type } );

# if result is empty/undef, return 'no nodes'
if ( !defined $result || $result !~ /[^ \t\n\r\\\\\\\\v\f]/ ) {
    $result = 'no nodes';
}
my $n      = $params->{'n'}      // 10;
my $parent = $params->{'parent'} // '';
my $type   = $params->{'type'}   // '';

## validate n: must be positive integer, clamp to 1..100 ##
$n = int $n;
if ( $n < 1 ) {
    $n = 1;
}
if ( $n > 100 ) {
    $n = 100;
}

my $output;

## call the internal sub ##
$output = <[valued.tree.top_n]>
    ->( { 'n' => $n, 'parent' => $parent, 'type' => $type } );

## handle empty result ##
if ( !defined $output or ( length $output ) == 0 ) {
    $output = 'no nodes';
}

return { 'mode' => 'size', 'data' => $output };

## [:< ##

