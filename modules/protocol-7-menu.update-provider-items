# name = protocol-7-menu.update-provider-items
# descr = Compute diff and update existing provider menu items

my ( $provider, $prev_data, $curr_data ) = @ARG;

return 0 unless <protocol-7-menu.init-graphical>;

my $gui_items     = <protocol-7-menu.gui-provider-items> //= {};
my $provider_refs = $gui_items->{$provider};

return 0 unless defined $provider_refs;

my $submenu    = $provider_refs->{submenu};
my $prev_items = $prev_data->{items} //= {};
my $curr_items = $curr_data->{items} //= {};

## Find added/removed/changed items
my %all_keys = ( map { $_ => 1 } ( keys %$prev_items, keys %$curr_items ) );

foreach my $item_key ( keys %all_keys ) {
    my $prev_item = $prev_items->{$item_key};
    my $curr_item = $curr_items->{$item_key};

    if ( !defined $curr_item ) {
        ## Item removed - find and remove from submenu
        my @children = $submenu->get_children();
        foreach my $child (@children) {
            if ( $child->get_label() eq $item_key ) {
                $submenu->remove($child);
                last;
            }
        }
    } elsif ( !defined $prev_item ) {
        ## Item added - create and append
        my $label
            = ref $curr_item eq 'HASH'
            ? ( $curr_item->{label} // $item_key )
            : $curr_item;

        my $menu_item = Gtk3::MenuItem->new_with_label($label);

        if ( ref $curr_item eq 'HASH' && defined $curr_item->{callback} ) {
            $menu_item->signal_connect(
                'activate' => $curr_item->{callback} );
        } elsif ( ref $curr_item eq 'HASH' && defined $curr_item->{command} )
        {
            my $cmd = $curr_item->{command};
            $menu_item->signal_connect( 'activate' => sub {qx| $cmd |} );
        }

        $submenu->append($menu_item);
    } else {
        ## Item updated - update label if changed
        if ( ref $curr_item eq 'HASH' && ref $prev_item eq 'HASH' ) {
            my $prev_label = $prev_item->{label} // '';
            my $curr_label = $curr_item->{label} // '';

            if ( $curr_label ne $prev_label ) {
                my @children = $submenu->get_children();
                foreach my $child (@children) {
                    if ( $child->get_label() eq $prev_label ) {
                        $child->set_label($curr_label);
                        last;
                    }
                }
            }
        }
    }
}

$submenu->show_all;

<[base.logs]>->( 1, "updated menu items for provider '%s'", $provider );

return 0;

