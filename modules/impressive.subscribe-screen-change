## [:< ##

# name  = impressive.subscribe-screen-change
# descr = init callback: subscribe to X-11 screen-change STRM

<[base.log]>->( 1, 'subscribing impressive to X-11 screen-change events .,' );

<[base.zenki.resolve_primary_sid]>->(
    'X-11',
    sub {
        my $sid = shift;
        return if not defined $sid;
        <[protocol-7.route-send]>->(
            {   'command' => "$sid.subscribe-screen-change",
                'reply'   => {
                    'handler' =>
                        qw| impressive.handler.screen-change_strm_open |,
                }
            }
        );
    }
);

return TRUE;

