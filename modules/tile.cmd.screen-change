## [:< ##

# name  = tile.cmd.screen-change
# descr = handle X-11 screen-change [ layout reaction stub ]

## single-line key=value payload, not YAML [ see X-11.emit.screen-change ] ##
my %event = $call->{'args'} =~ m|(\w+)=(\S*)|g;
my $w     = $event{'width'}  // 0;
my $h     = $event{'height'} // 0;

<[base.logs]>->( 1, '[screen-change] %dx%d', $w, $h );

## LLL: trigger layout recalculation or tile-profile selection when needed ##

return { 'mode' => qw| true |, 'data' => 'ok' };

