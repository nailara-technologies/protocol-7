## [:< ##

# name = models.chat.append
# descr = append message to chat buffer (rolling buffer, format agnostic)
# param = $session_id, $sender, $message
# return = TRUE on success

my $session_id = shift;
my $sender     = shift;
my $message    = shift // '';

return FALSE unless defined $sender;

## encode escapes for storage (single-line format)
my $encoded = <[models.escape.encode]>->($message);

## store structured message data
<models.chat.messages> //= [];
my $entry = {
    'time'    => <[base.time]>->(3),    ## high-precision timestamp
    'sender'  => $sender,
    'message' => $encoded,
};
push @{<models.chat.messages>}, $entry;

## limit structured storage (keep last 500 messages)
my $max_size = <models.cfg.chat_buffer_size> // 500;
if ( scalar @{<models.chat.messages>} > $max_size ) {
    shift @{<models.chat.messages>};
}

## also log to Protocol-7 buffer for visibility
my $timestamp    = <[base.parser.timestamp]>->( 'time', $entry->{'time'} );
my $buffer_entry = sprintf '[%s] [%s]: %s', $timestamp, $sender, $encoded;
<[base.buffer.add_line]>->( qw| models-chat |, $buffer_entry, 2 );

return TRUE;

0;

