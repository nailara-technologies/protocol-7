## [:< ##

# name  = coding.callback.object_memory_gpu
# descr = Dependency callback to check GPU VRAM availability

my $object_id = shift;
return undef unless exists <dependency.object>->{$object_id};

my $object = <dependency.object>->{$object_id};

## Get configured threshold [ default: 3GB free VRAM ] ##
my $min_free_mb = $object->{'min_free_mb'} // 3072;

## Try nvidia-smi to get GPU memory info ##
my $exec_str = join ' ',
    qw| nvidia-smi |,
    '--query-gpu=memory.total,memory.free',
    '--format=csv,noheader,nounits';
##
my $nvidia_smi = qx{ $exec_str 2>/dev/null };

if ( $? != 0 || !defined $nvidia_smi || $nvidia_smi !~ m|^(\d+),\s*(\d+)|m ) {
    <[base.logs]>->(
        2, '[memory_gpu] nvidia-smi failed, assuming no GPU available'
    );
    return FALSE;
}

my ( $total_mb, $free_mb ) = ( $1, $2 );

## Check against threshold ##
if ( $free_mb >= $min_free_mb ) {
    <[base.logs]>->(
        3,        '[memory_gpu] OK: %d MB free [ threshold : %d MB ]',
        $free_mb, $min_free_mb
    );
    return TRUE;
} else {
    <[base.logs]>->(
        1,        '[memory_gpu] LOW: %d MB free [ threshold: %d MB ]',
        $free_mb, $min_free_mb
    );
    return FALSE;
}

