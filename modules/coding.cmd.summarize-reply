## [:< ##

# name  = coding.cmd.summarize-reply
# descr = reply handler for routed summarize-context requests

my $call    = <[protocol-7.call]>;
my $summary = $call->{'data'} // '';

## store in valued tree if node_id was passed ##
if ( length( $call->{'params'}{'node_id'} // '' ) ) {
    my $node_id = $call->{'params'}{'node_id'};
    <[valued.tree.register_outcome]>->(
        {   node_id      => $node_id,
            outcome_text => $summary,
        }
    );
}

return { mode => 'true', data => $summary };

