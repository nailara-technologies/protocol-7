# name = models.storage.check_space
# descr = Check available space in tier

# Check available space in tier
sub check_tier_space {
  my ($tier) = @_;

  my $base = $data{models}{tiers}->{$tier}->{base_path};
  return undef unless $base && -d $base;

  # Simple check - count files and estimate space
  my @files;
  opendir(my $dh, $base) or return undef;
  while (my $file = readdir($dh)) {
    next if $file =~ /^\\./;
    push @files, {
      'name' => $file,
      'size' => -s File::Spec->catfile($base, $file),
    };
  }
  closedir($dh);

  my $total_size = 0;
  $total_size += $_->{size} for @files;

  return {
    'tier' => $tier,
    'path' => $base,
    'file_count' => scalar(@files),
    'total_size_bytes' => $total_size,
    'total_size_gb' => sprintf('%.2f', $total_size / (1024 ** 3)),
  };
}

# Entry point
{
  my @args = @ARG;
  return check_tier_space(@args);
};

