## [:< ##

# name  = jobsite.cmd.show-prompt
# descr = show assessment prompt or list jobs

my $arg = $call->{'args'} // '';
return {
    'mode' => 'false',
    'data' => 'usage: show-prompt <job_id>|list|new|latest'
    }
    unless length $arg;

my $store = <[jobsite.job.load_all]>;

## list all jobs ##
if ( $arg eq qw| list | ) {
    my @lines;
    for my $id (
        sort {
            $store->{$b}{'fetched_at'} // 0 <=> $store->{$a}{'fetched_at'}
                // 0
        }
        keys %{$store}
    ) {
        my $j = $store->{$id};
        push @lines, sprintf "%s | %s | %s | %s",
            $id, $j->{'status'} // 'new', $j->{'company'} // '',
            $j->{'title'} // '';
    }
    return { 'mode' => 'size', 'data' => join( "\n", @lines ) };
}

## list only new (unassessed) jobs ##
if ( $arg eq qw| new | ) {
    my @lines;
    for my $id (
        sort {
            $store->{$b}{'fetched_at'} // 0 <=> $store->{$a}{'fetched_at'}
                // 0
        }
        keys %{$store}
    ) {
        my $j = $store->{$id};
        next unless ( $j->{'status'} // '' ) eq 'new';
        push @lines, sprintf "%s | %s | %s",
            $id, $j->{'company'} // '', $j->{'title'} // '';
    }
    return {
        'mode' => 'size',
        'data' => join( "\n", @lines ) || 'no new jobs'
    };
}

## latest job ##
if ( $arg eq qw| latest | ) {
    my @ids = sort {
        $store->{$b}{'fetched_at'} // 0 <=> $store->{$a}{'fetched_at'} // 0
        }
        keys %{$store};
    return { 'mode' => 'false', 'data' => 'no jobs in store' } unless @ids;
    $arg = $ids[0];
}

## specific job id ##
my $job = $store->{$arg};
return { 'mode' => 'false', 'data' => "job $arg not found" }
    unless defined $job;

my $prompt = <[jobsite.util.build_prompt]>->($job);

return { 'mode' => 'size', 'data' => $prompt };

