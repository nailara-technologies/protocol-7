## [:< ##
# name  = plugin.storage.checksum.cluster.lookup
# descr = Lookup cluster by checksum or find cluster members

use strict;
use warnings;

return sub {
    my ($args) = @ARG;

    my $checksum      = $args->{'checksum'};
    my $type          = $args->{'type'};    # Optional: filter by cluster type
    my $resolve_p7ref = $args->{'resolve_p7ref'}
        // 1;                               # Auto-resolve nested clusters

    return undef unless $checksum;

    my $registry = $data{'storage'}{'mapping'}{'checksum-cluster'};
    $checksum = <[plugin.storage.util.normalize_checksum]>->($checksum);
    $registry->{'stats'}{'lookups'}++;

    # Direct cluster lookup (checksum IS a cluster ID)
    if ( exists $registry->{'clusters'}{$checksum} ) {
        my $cluster = $registry->{'clusters'}{$checksum};

        # Type filter
        return undef if $type && $cluster->{'type'} ne $type;

        # Resolve P7REFs if requested
        my $members = $cluster->{'members'};
        if ( $resolve_p7ref
            && <[plugin.storage.util.has_p7ref_members]>->($members) ) {
            $members = <[plugin.storage.util.resolve_all_p7refs]>->(
                $members, $registry
            );
        }

        return {
            'cluster_id' => $checksum,
            'type'       => $cluster->{'type'},
            'members'    => $members,
            'metadata'   => $cluster->{'metadata'},
            'p7ref'      => $cluster->{'p7ref'},
            'is_primary' => 1,
        };
    }

    # Reverse index lookup (checksum IS a member of some cluster)
    if ( $registry->{'config'}{'index_reverse'}
        && exists $registry->{'index'}{$checksum} ) {
        my $cluster_id = $registry->{'index'}{$checksum};
        my $cluster    = $registry->{'clusters'}{$cluster_id};

        return undef unless $cluster;
        return undef if $type && $cluster->{'type'} ne $type;

        my $members = $cluster->{'members'};
        if ( $resolve_p7ref
            && <[plugin.storage.util.has_p7ref_members]>->($members) ) {
            $members = <[plugin.storage.util.resolve_all_p7refs]>->(
                $members, $registry
            );
        }

        return {
            'cluster_id' => $cluster_id,
            'type'       => $cluster->{'type'},
            'members'    => $members,
            'metadata'   => $cluster->{'metadata'},
            'p7ref'      => $cluster->{'p7ref'},
            'is_primary' => 0,
            'member_of'  => $cluster_id,
        };
    }

    # Not found
    return undef;
};

