## [:< ##
# name  = plugin.storage.checksum.cluster.lookup
# descr = Lookup cluster by checksum or find cluster members

use strict;
use warnings;

return sub {
    my ($args) = @_;

    my $checksum = $args->{'checksum'};
    my $type = $args->{'type'};  # Optional: filter by cluster type
    my $resolve_p7ref = $args->{'resolve_p7ref'} // 1;  # Auto-resolve nested clusters

    return undef unless $checksum;

    my $registry = $data{'storage'}{'mapping'}{'checksum-cluster'};
    $checksum = _normalize_checksum($checksum);
    $registry->{'stats'}{'lookups'}++;

    # Direct cluster lookup (checksum IS a cluster ID)
    if (exists $registry->{'clusters'}{$checksum}) {
        my $cluster = $registry->{'clusters'}{$checksum};

        # Type filter
        return undef if $type && $cluster->{'type'} ne $type;

        # Resolve P7REFs if requested
        my $members = $cluster->{'members'};
        if ($resolve_p7ref && _has_p7ref_members($members)) {
            $members = _resolve_all_p7refs($members, $registry);
        }

        return {
            'cluster_id' => $checksum,
            'type'       => $cluster->{'type'},
            'members'    => $members,
            'metadata'   => $cluster->{'metadata'},
            'p7ref'      => $cluster->{'p7ref'},
            'is_primary' => 1,
        };
    }

    # Reverse index lookup (checksum IS a member of some cluster)
    if ($registry->{'config'}{'index_reverse'} && exists $registry->{'index'}{$checksum}) {
        my $cluster_id = $registry->{'index'}{$checksum};
        my $cluster = $registry->{'clusters'}{$cluster_id};

        return undef unless $cluster;
        return undef if $type && $cluster->{'type'} ne $type;

        my $members = $cluster->{'members'};
        if ($resolve_p7ref && _has_p7ref_members($members)) {
            $members = _resolve_all_p7refs($members, $registry);
        }

        return {
            'cluster_id'   => $cluster_id,
            'type'         => $cluster->{'type'},
            'members'      => $members,
            'metadata'     => $cluster->{'metadata'},
            'p7ref'        => $cluster->{'p7ref'},
            'is_primary'   => 0,
            'member_of'    => $cluster_id,
        };
    }

    # Not found
    return undef;
};

# Check if member list contains P7REFs
sub _has_p7ref_members {
    my ($members) = @_;
    return 0 unless $members && @$members;

    for my $m (@$members) {
        return 1 if $m =~ m|^p7://|;
    }
    return 0;
}

# Resolve all P7REF members to actual checksums
sub _resolve_all_p7refs {
    my ($members, $registry) = @_;

    my @resolved;

    for my $member (@$members) {
        if ($member =~ m|^p7://checksum-cluster:([^\]]+)|) {
            # It's a cluster reference - expand it
            my $sub_cluster_id = $1;
            $registry->{'stats'}{'p7refs_resolved'}++;

            if (exists $registry->{'clusters'}{$sub_cluster_id}) {
                push @resolved, @{$registry->{'clusters'}{$sub_cluster_id}{'members'}};
            }
            else {
                # P7REF points outside - use storage.p7ref.resolve
                my $resolved = <[plugin.storage.p7ref.resolve]>->({
                    'p7ref' => $member,
                });
                push @resolved, $resolved if $resolved;
            }
        }
        else {
            push @resolved, $member;
        }
    }

    return \@resolved;
}

sub _normalize_checksum {
    my ($checksum) = @_;
    return undef unless defined $checksum;
    $checksum =~ s|\s+||g;
    if ($checksum !~ m|^[a-z0-9-]+:|i) {
        $checksum = "bmw-L13:$checksum";
    }
    return lc($checksum);
}

