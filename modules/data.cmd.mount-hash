## [:< ##

# name  = data.cmd.mount-hash
# param = <hash-path> [local-path]
# descr = mount nested data hash as FUSE filesystem

my $args = $$call{'args'} // '';
$args =~ s|^\s+||;
$args =~ s|\s+$||;

my ( $hash_path, $local_path ) = split( / +/, $args, 2 );

return {
    'mode' => qw| false |,
    'data' => 'expected <hash-path> parameter'
    }
    unless length($hash_path);

## validate hash path exists ##
my $ref = <[data.resolve_hash_path]>->($hash_path);

return {
    'mode' => qw| false |,
    'data' => "hash path '$hash_path' does not exist"
    }
    unless defined $ref;

## determine local mount path ##
if ( !defined $local_path || !length($local_path) ) {

    # Generate default mount path under /tmp
    my $safe_name = $hash_path;
    $safe_name =~ s|\\.|_|g;    # replace dots with underscores
    $local_path = "/tmp/p7-data-$safe_name-$$";
}

$local_path =~ s|/+$|| if length($local_path) > 1;

## create mount directory if it doesn't exist ##
if ( !-d $local_path ) {
    mkdir( $local_path, 0755 )
        or return {
        'mode' => qw| false |,
        'data' => "cannot create mount directory '$local_path': $!"
        };
}

## check if FUSE is available ##
if ( !<data.fuse.capabilities.available> ) {
    return {
        'mode' => qw| false |,
        'data' =>
            "FUSE module not available - install Fuse.pm to use mount feature"
    };
}

## check if already mounted at this path ##
if ( exists <data.fuse.mounts> {$local_path} ) {
    my $existing = <data.fuse.mounts> {$local_path};
    return {
        'mode' => qw| false |,
        'data' =>
            "already mounted at $local_path (pid $existing->{'pid'}, hash: $existing->{'hash_path'})"
    };
}

## initialize FUSE subsystem if needed ##
if ( !<data.fuse.mounts> ) {
    <[data.mount.fuse.init_code]>;
}

## spawn FUSE child process ##
my $result = <[data.mount.fuse.spawn]>->( $hash_path, $local_path );

# Add mount info to result
if ( $result->{'mode'} eq 'true' ) {
    $result->{'data'} .= "\n\nMount point: $local_path";
    $result->{'data'} .= "\nTo unmount: fusermount -u $local_path";
}

return $result;

