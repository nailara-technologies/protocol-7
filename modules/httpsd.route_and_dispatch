#!/usr/bin/env perl
# Module: httpsd.route_and_dispatch
# Purpose: Integrate intelligent routing with request handling
# Integration: Called from httpd.request_handler as primary handler
# Pattern: Routes request, manages cache, dispatches to appropriate handler

my $id = $_[0];    # Session ID

unless ( defined $id && $id =~ m/^\d+$/ ) {
    return <[base.s_warn]>->("Invalid session ID: $id");
}

my $session = $data{'session'}->{$id};
unless ( defined $session ) {
    <[base.logs]>->( 0, "[$id]: Session not found in route_and_dispatch" );
    return 2;
}

# Extract request details
my $request = $session->{'http'}->{'request'};
unless ( defined $request ) {
    <[base.logs]>->( 0, "[$id]: HTTP request data not available" );
    return 2;
}

my $method = $request->{'method'} // 'GET';
my $uri    = $request->{'uri'}    // '/';
my $vhost  = $request->{'host'}   // 'localhost';

# Normalize vhost (remove port if present)
$vhost =~ s|:.*||;

<[base.logs]>
    ->( 2, "[$id]: route_and_dispatch: $method $uri (vhost=$vhost)" );

# Call our intelligent router
my $route = eval {
    <[httpsd.route_template_request]>->( $method, $uri, $vhost, $id );
};

if ($@) {
    <[base.logs]>->( 0, "[$id]: Router error: $@" );
    <[httpd.send_error_page]>->( $id, 500 );
    return 2;
}

unless ( defined $route && ref($route) eq 'HASH' ) {
    <[base.logs]>->( 0, "[$id]: Router returned invalid response" );
    <[httpd.send_error_page]>->( $id, 500 );
    return 2;
}

<[base.logs]>->(
    2, "[$id]: Routed to type=" . ( $route->{type} // 'unknown' )
);

# Store route decision in session for downstream handlers
$session->{'route_decision'} = $route;

# Dispatch based on route type
my $handler_name = $route->{handler};
unless ( defined $handler_name && length $handler_name ) {
    <[base.logs]>->( 0, "[$id]: No handler specified in route" );
    <[httpd.send_error_page]>->( $id, 500 );
    return 2;
}

# Look up and call the handler
if ( exists $code{$handler_name} ) {
    <[base.logs]>->( 2, "[$id]: Calling handler: $handler_name" );
    my $handler_result = $code{$handler_name}->($id);
    return $handler_result if defined $handler_result;
} else {
    <[base.logs]>->( 0, "[$id]: Handler not found: $handler_name" );
    <[httpd.send_error_page]>->( $id, 500 );
    return 2;
}

return TRUE;

