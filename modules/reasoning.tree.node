## [:< ##

# name  = reasoning.tree.node
# descr = create reasoning tree node with numerical identity

my $args = @ARG ? shift : $ARG;
$args //= {};

my $name      = $args->{'name'}      // '';
my $narration = $args->{'narration'} // '';
my $depth     = $args->{'depth'}     // 0;
my $parent    = $args->{'parent'};

## [ compute AMOS checksum as numerical identity ] ##
my $content = join( ':', $name, $depth, $narration );
my $chksum  = <[chk-sum.amos]>->( \$content );

my $node = {
    name             => $name,
    chksum           => $chksum,
    depth            => $depth,
    parent           => $parent,
    narration        => $narration,
    convergence      => 0,
    threshold        => 0.769230769230769,
    state            => 'compact',
    children         => [],
    overlaps         => [],
    approach_vectors => [],
    up_refs          => 0,
    down_refs        => 0,
    directional      => 0,
    visual_refs      => 0,
    ntime            => <[base.ntime]>,
};

return $node;

