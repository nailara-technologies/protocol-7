## [:< ##

# name  = devmod.cmd.elf-b32
# descr = VAX + BASE32 encoded ELF-7-13 chksum
# param = [str]

return {
    'mode' => qw| true |,
    'data' => <[chk-sum.elf.vax-BASE32]>->( $call->{'args'} // '' )
    }

