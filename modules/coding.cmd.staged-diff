## [:< ##

# name  = coding.cmd.staged-diff
# descr = show diff of staged edits against current source
# param = [args]

my $args = $call->{'args'} // '';

## check for :files: flag [ list filenames only ] ##
my $files_only = 0;
if ( $args =~ s|:files:|| ) {
    $files_only = 1;
}
my $filter = $args;
$filter =~ s|^\s+||;
$filter =~ s|\s+$||;

my $staged_dir
    = <system.path.zenka-dirs>->{'var_P7'} . '/'
    . <system.zenka.name>
    . '/staged';

return { 'mode' => qw| false |, 'data' => 'no staged directory' }
    unless -d $staged_dir;

my $dh;
if ( not opendir $dh, $staged_dir ) {
    <[base.logs]>->( 0, ':. staged-diff: cannot open %s', $staged_dir );
    return {
        'mode' => qw| false |,
        'data' => 'cannot read staged directory'
    };
}

my @files = sort grep { $ARG ne '.' and $ARG ne '..' } readdir $dh;
closedir $dh;

return { 'mode' => qw| false |, 'data' => 'no staged edits' } unless @files;

my $root   = <system.root_path>;
my $output = '';

for my $staged_name (@files) {
    ## convert staged name back to source path ##
    my $src_rel = $staged_name;
    $src_rel =~ s|__|/|g;

    ## optional filter ##
    next if length $filter and $src_rel !~ m|\Q$filter\E|;

    my $src_path    = "$root/$src_rel";
    my $staged_path = "$staged_dir/$staged_name";

    ## :files: mode - just list the path ##
    if ($files_only) {
        my $marker = -f $src_path ? '' : ' [new]';
        $output .= sprintf "%s%s\n", $src_rel, $marker;
        next;
    }

    unless ( -f $src_path ) {
        $output .= sprintf "## %s [ new file, %d bytes ] ##\n",
            $src_rel, -s $staged_path;
        next;
    }

    ## run diff ##
    my $diff = '';
    if ( open my $fh, '-|', 'diff', '-u', $src_path, $staged_path ) {
        local $/;
        $diff = <$fh>;
        close $fh;
    }

    if ( length $diff ) {
        ## strip absolute paths for readability ##
        $diff =~ s|\Q$root/\E||g;
        $diff =~ s|\Q$staged_dir/\E|staged/|g;
        $output .= sprintf "## %s ##\n%s\n", $src_rel, $diff;
    } else {
        $output .= sprintf "## %s [ no changes ] ##\n", $src_rel;
    }
}

$output = 'no matching staged edits' unless length $output;

return { 'mode' => qw| size |, 'data' => $output };

