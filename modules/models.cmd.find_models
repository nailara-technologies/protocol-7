## [:< ##

# name = models.cmd.find_models
# descr = Find models available for a specific context

my $cmd = shift @ARG;  # Remove command name from @ARG
my ($context) = @ARG;

if (!$context) {
  return { 'mode' => qw| size |, 'data' => "error: context name required\n" };
}

# Load registry - call extracted module directly
my $all_models = <[models.registry.list_all.list_all_models]>->();

# Find models for this context
my @matching;
foreach my $model (@$all_models) {
  next unless $model->{statistics}->{by_context}->{$context};

  my $stats = $model->{statistics}->{by_context}->{$context};
  push @matching, {
    'amos' => $model->{amos_checksum},
    'name' => $model->{metadata}->{name},
    'version' => $model->{metadata}->{version},
    'success_rate' => $stats->{success_rate},
    'margin_vs_alt' => $stats->{margin_vs_best_alt} // 0,
    'available' => $model->{presence_decision}->{currently_present},
    'category' => $model->{metadata}->{category},
    'invocations' => $stats->{invocations},
  };
}

# Sort by success rate
@matching = sort { $b->{success_rate} <=> $a->{success_rate} } @matching;

my $reply_str = '';
$reply_str .= "context: $context\n";
$reply_str .= "count: " . scalar(@matching) . "\n";
$reply_str .= "\n";

foreach my $model (@matching) {
  $reply_str .= "amos: " . $model->{amos} . "\n";
  $reply_str .= "  name: " . $model->{name} . "\n";
  $reply_str .= "  version: " . $model->{version} . "\n";
  $reply_str .= "  success_rate: " . sprintf('%.2f', $model->{success_rate}) . "\n";
  $reply_str .= "  margin_vs_alt: " . sprintf('%.2f', $model->{margin_vs_alt}) . "\n";
  $reply_str .= "  available: " . ($model->{available} ? 'yes' : 'no') . "\n";
  $reply_str .= "  category: " . ($model->{category} // 'unknown') . "\n";
  $reply_str .= "  invocations: " . ($model->{invocations} // 0) . "\n";
  $reply_str .= "\n";
}

return { 'mode' => qw| size |, 'data' => $reply_str };

