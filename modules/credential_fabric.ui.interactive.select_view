## [:< ##

# name  = credential_fabric.ui.interactive.select_view
# descr = switch credential-fabric ui view and reset focus to top row

my $call_args = shift // {};

my $session_id = $call_args->{'session_id'} // '';
my $view       = '';
my $slot_name  = '';

if ( defined $call_args->{'args'} ) {
    my $args_str = $call_args->{'args'};
    $args_str =~ s/^\s+|\s+$//g;

    ## extract session_id= suffix if present ##
    if ( $args_str =~ s/\s+session_id=(\d{3,17})$// ) {
        $session_id = $1;
    }

    my ( $first, @rest ) = split qr|\s+|, $args_str;
    $view      = $first // '';
    $slot_name = join( ' ', @rest );
}

return {
    'mode' => qw| false |,
    'data' => 'missing session_id'
    }
    unless length $session_id;

return {
    'mode' => qw| false |,
    'data' => 'missing view name'
    }
    unless length $view;

my $ui    = $data{'session'}{$session_id}{'credential_fabric'}{'ui'};
my $focus = $ui->{'focus'};
return {
    'mode' => qw| false |,
    'data' => 'no active ui focus'
    }
    if not defined $focus
    or ref $focus ne qw| HASH |;

$focus->{'view'}           = $view;
$focus->{'row_index'}      = 0;
$focus->{'pending_action'} = undef;
$focus->{'detail_slot'}    = $slot_name;

return <[credential_fabric.ui.interactive.refresh]>->($call_args);

