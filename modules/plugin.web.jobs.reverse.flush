## [:< ##

# name  = plugin.web.jobs.reverse.flush
# descr = return and clear pending reverse change queue, run prune

my $pending = <plugin.web.jobs.reverse> // [];
<plugin.web.jobs.reverse> = [];

## clear on-disk persistence ##
my $cache_dir    = <[plugin.web.jobs.cache.path]>;
my $reverse_file = "$cache_dir/reverse-pending.yaml";
unlink $reverse_file if -f $reverse_file;

## periodic lifecycle prune ##
<[plugin.web.jobs.store.prune]>;

return $pending;

