## [:< ##

# name  = letsencrypt.base.pre_init
# descr = Pre-initialization for Let's Encrypt ACME client zenka - load required libraries

<[base.log]>->(
    2, 'letsencrypt pre-initialization: loading ACME libraries..,'
);

## Load ACME-required libraries (Crypt::Ed25519 loaded via crypt.C25519 module)
## CSR certificate generation via OpenSSL CLI (Ed25519 support, no Perl module needed)
<[base.perlmod.autoload]>->('JSON::XS');
<[base.perlmod.autoload]>->('LWP::UserAgent');
<[base.perlmod.autoload]>->('LWPx::ParanoidAgent');
<[base.perlmod.autoload]>->('Encode');
<[base.perlmod.autoload]>->('MIME::Base64');    ## Base64url encoding for JWK
<[base.perlmod.autoload]>->('Digest::SHA');     ## SHA hashing for JWK thumbprint

## Validate ACME server configuration
if ( not defined <letsencrypt.acme.server> ) {
    <[base.log]>->( 0, ": warning : LETSENCRYPT ACME server not configured" );
}

if ( not defined <letsencrypt.admin.email> ) {
    <[base.log]>->( 0, ": warning : LETSENCRYPT admin email not configured" );
}

## Note: Certificate directories are created/validated in
##       #               init_code after config is loaded

<[base.log]>->( 2, 'letsencrypt pre-init complete' );

0;

