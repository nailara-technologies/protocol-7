## [:< ##

# name  = letsencr.child.acme_revoke
# descr = Child process revokes a certificate with Let's Encrypt (blocking operation)

my $msg = shift;

my $cert_path = $msg->{cert_path};
my $key_path  = $msg->{key_path};
my $domain    = $msg->{domain};

<[base.log]>->( 2, "child: revoking certificate for domain: $domain" );

## STEP 1: Load certificate from disk
unless ( -f $cert_path ) {
    return {
        status => qw| error |,
        error  => "Certificate file not found: $cert_path"
    };
}

<[base.log]>->( 2, 'step 1: loading certificate' );

my $cert_content;
open( my $cert_fh, '<', $cert_path )
    or return {
    status => qw| error |,
    error  => "Failed to read certificate: $!"
    };
{
    local $/;
    $cert_content = <$cert_fh>;
}
close($cert_fh);

## Extract certificate DER encoding for revocation request
my $x509 = Crypt::OpenSSL::X509->new_from_string( $cert_content,
    qw| FORMAT_PEM | );
unless ($x509) {
    return {
        status => qw| error |,
        error  => 'Failed to parse certificate'
    };
}

## Get DER format for ACME revocation
my $cert_der  = $x509->as_string(qw| FORMAT_ASN1 |);
my $cert_b64u = <[letsencr.child.encode_base64url]>->($cert_der);

<[base.log]>->( 2, "certificate loaded and encoded for revocation" );

## STEP 2: Ensure ACME account is set up
<[base.log]>->( 2, 'step 2: verifying ACME account' );

unless ( <letsencr.child.acme_client> {directory} ) {
    my $dir_info = <[letsencr.child.fetch_acme_directory]>->();
    unless ($dir_info) {
        return {
            status => qw| error |,
            error  => 'Failed to fetch ACME directory'
        };
    }
}

unless ( <letsencr.child.acme_client> {account_url} ) {
    ## Try to get or register account
    my $account_info = <[letsencr.child.acme_check_account]>;
    unless ($account_info) {
        $account_info = <[letsencr.child.acme_register_account]>;
        unless ($account_info) {
            return {
                status => qw| error |,
                error  => 'Failed to register ACME account'
            };
        }
    }
}

## STEP 3: Get fresh nonce
<[base.log]>->( 2, 'step 3: obtaining fresh nonce' );

my $nonce = <[letsencr.child.get_fresh_nonce]>;
unless ($nonce) {
    return {
        status => qw| error |,
        error  => 'Failed to obtain fresh nonce'
    };
}

## STEP 4: Create revocation request
<[base.log]>->( 2, 'step 4: creating revocation request' );

my $revoke_url = <letsencr.child.acme_client> {directory}{revoke};
unless ($revoke_url) {
    return {
        status => qw| error |,
        error  => 'ACME directory missing revoke endpoint'
    };
}

## Revocation payload contains just the certificate in DER+base64url format
my $revoke_payload = { certificate => $cert_b64u };

## STEP 5: Send revocation request to ACME
<[base.log]>->( 2, 'step 5: sending revocation request to ACME server' );

my $revoke_response = <[letsencr.child.acme_http_request]>->(
    'POST', $revoke_url, $revoke_payload, $nonce,
    <letsencr.child.acme_client> {kid}
);

unless ($revoke_response) {
    return {
        status => qw| error |,
        error  => 'Failed to send revocation request'
    };
}

## Check HTTP status
my $http_status = $revoke_response->{status};
if ( $http_status != 200 ) {
    my $error_msg = $revoke_response->{error_detail} || 'Unknown ACME error';
    <[base.log]>->(
        1, "revocation failed with HTTP $http_status: $error_msg"
    );
    return {
        status => qw| error |,
        error  => "ACME revocation error: $error_msg"
    };
}

<[base.log]>->( 2, 'certificate successfully revoked with ACME server' );

my $result = {
    status     => qw| success |,
    domain     => $domain,
    revoked_at => time(),
};

<[base.log]>->( 2, "child: certificate revoked for $domain" );

return $result;

