## [:< ##

# name  = job-site-scan.handler.assess-done
# descr = receive assessment result, update job state

my $call = shift // {};

my $mode    = $call->{'mode'} // '';
my $raw     = $call->{'data'} // '';
my $result  = ref $raw ? $raw->$* : $raw;
my $job_id  = $call->{'params'}{'job_id'}  // '';
my $task_id = $call->{'params'}{'task_id'} // '';

my $job_rec = <job-site-scan.tasks>->{$job_id};
if ( not defined $job_rec ) {
    <[base.logs]>->( 0, 'jss.assess-done: unknown job %s', $job_id );
    <job-site-scan.pending_count>--;
    return;
}

if ( lc($mode) eq qw| false | ) {
    <[base.logs]>->(
        0,        'jss.assess-done: task %s failed for job %s',
        $task_id, $job_id
    );
    $job_rec->{'stage'} = 'failed';
    <job-site-scan.pending_count>--;
    <[job-site-scan.state.persist]>;
    <[job-site-scan.dispatch.next]>;
    return;
}

## try to extract score from result (json or plain "score: N" line)
my ( $score, $reason, $apply ) = ( '', '', '' );
if ( $result =~ m{\{.*?"(?:fit_)?score"\s*:\s*(\d+(?:\.\d+)?)}s ) {
    $score = $1;
    ($reason) = ( $result =~ m{"reason(?:s)?"\s*:\s*"([^"]+)"} );
    ($reason) //= do {
        my ($arr) = ( $result =~ m{"reasons"\s*:\s*\[([^\]]+)\]} );
        $arr ? ( split /,/, $arr )[0] =~ s/^\s*"?|"?\s*$//gr : undef;
    };
    ($apply)
        = ( $result
            =~ m{"(?:apply|recommendation)"\s*:\s*"?(true|false|interview|apply)"?}
        );
} elsif ( $result =~ m{(?:fit_)?score[:\s]+(\d+(?:\.\d+)?)}i ) {
    $score = $1;
}

$job_rec->{'score'}        = $score;
$job_rec->{'score_reason'} = $reason // '';
$job_rec->{'stage'}        = 'assessed';

my $threshold = <job-site-scan.cfg.threshold> // 6;
if ( length($score) and $score >= $threshold ) {
    $job_rec->{'stage'} = 'review';
    <[base.logs]>->(
        1,       'jss: job %s score=%s ABOVE threshold → review',
        $job_id, $score
    );
} else {
    <[base.logs]>->(
        1,       'jss: job %s score=%s below threshold',
        $job_id, length($score) ? $score : '?'
    );
}

## update site-yaml store status to 'assessed'
<[base.perlmod.autoload]>->('YAML::XS');
my $store_file = '/var/protocol-7/site-yaml/store.yaml';
if ( -f $store_file ) {
    my $store = eval { YAML::XS::LoadFile($store_file) } // {};
    if ( exists $store->{$job_id} ) {
        $store->{$job_id}{'status'}       = 'assessed';
        $store->{$job_id}{'score'}        = $score;
        $store->{$job_id}{'score_reason'} = $reason // '';
        eval { YAML::XS::DumpFile( $store_file, $store ) };
    }
}

<job-site-scan.pending_count>--;
<[job-site-scan.state.persist]>;

## translate reason to German for review-stage jobs — dispatch.next fires from translate-done
if ( $job_rec->{'stage'} eq 'review' and length( $reason // '' ) ) {
    my $translate_prompt
        = ':local: :simple: Übersetze folgende englische Stelleneinschätzung'
        . ' in ein bis zwei kurze deutsche Sätze. Antworte nur mit der'
        . ' deutschen Übersetzung, ohne zusätzlichen Text oder'
        . ' Anführungszeichen: '
        . $reason;
    my $enc = ':B32:'
        . encode_b32r( Encode::encode( 'UTF-8', $translate_prompt ) );
    <[protocol-7.route-send]>->(
        {   'command'   => 'task.create',
            'call_args' => { 'args' => $enc },
            'reply'     => {
                'handler' => 'job-site-scan.handler.translate-done',
                'params'  => { 'job_id' => $job_id },
            },
        }
    );
} else {
    <[job-site-scan.dispatch.next]>;    ## no translation needed, proceed
}

