## [:< ##

# name  = letsencr.parent.save_certificate
# descr = store certificate bundle to disk with metadata

my $cert_data = shift;

my $domain          = $cert_data->{domain};
my $certificate_pem = $cert_data->{certificate_pem};
my $chain_pem       = $cert_data->{chain_pem};
my $private_key_pem = $cert_data->{private_key_pem};
my $issued_at       = $cert_data->{issued_at} // time();
my $expires_at      = $cert_data->{expires_at};
my $certificate_url = $cert_data->{certificate_url};
my $alt_names       = $cert_data->{alt_names} // [];
my $account_id      = $cert_data->{account_id};

## Validate required inputs
unless ( $domain && $certificate_pem ) {
    <[base.log]>->( 1, "error : domain and certificate_pem are required" );
    return {
        status    => qw| error |,
        error_msg => 'domain and certificate_pem are required'
    };
}

my $certs_dir = <letsencr.certs.dir>;
unless ( -d $certs_dir ) {
    <[base.logs]>->( 2, 'creating certificates directory: %s', $certs_dir );
    <[file.make_path]>->(
        $certs_dir, 02770, <system.amos-zenka-user>, qw| httpsd |
        )
        or return {
        status    => qw| error |,
        error_msg => "Cannot create certs directory: $certs_dir"
        };
}

## Build certificate metadata
my $metadata = {
    domain          => $domain,
    alt_names       => ref($alt_names) eq 'ARRAY' ? $alt_names : [],
    issued_at       => $issued_at,
    expires_at      => $expires_at,
    certificate_url => $certificate_url,
    account_id      => $account_id,
    status          => 'valid',
};

## warn if chain intermediate does not match leaf issuer
## [ full AIA repair happens in child.validate_chain : this is a safety net ]
if ( length($chain_pem) ) {
    my $issuer_check
        = <[letsencr.x509_field]>->( $certificate_pem, '-issuer' );
    my $subject_check = <[letsencr.x509_field]>->( $chain_pem, '-subject' );
    if (    defined $issuer_check
        and defined $subject_check
        and $issuer_check ne $subject_check ) {
        <[base.logs]>->(
            0,
            ': chain mismatch for %s : leaf issuer [%s] != chain subject [%s]',
            $domain,
            $issuer_check,
            $subject_check
        );
    }
}

## Write certificate files
my %files = (
    'pem' => $certificate_pem
        . ( $chain_pem ? "\n" . $chain_pem : "" ) . "\n"
        . $private_key_pem,
    'cert'  => $certificate_pem,
    'chain' => $chain_pem // '',
    'key'   => $private_key_pem,
    'meta'  => JSON::XS::encode_json($metadata),
);

my $backup_dir = <letsencr.certs.backup>;
my $any_error  = 0;

foreach my $ext ( keys %files ) {
    my $file_path = catfile( $certs_dir, "$domain.$ext" );

    ## Create backup of existing file if present
    if ( -f $file_path && $backup_dir ) {
        unless ( -d $backup_dir ) {
            <[file.make_path]>->(
                $backup_dir, 0700, <system.amos-zenka-user>
                )
                or <[base.logs]>->(
                1, 'warning: cannot create backup directory: %s', $backup_dir
                );
        }

        if ( -d $backup_dir ) {
            my $backup_path
                = catfile( $backup_dir, "$domain.$ext." . time() );
            my ( $src, $dst );
            unless ( open( $src, '<', $file_path )
                && open( $dst, '>', $backup_path ) ) {
                <[base.log]>->( 1, "warning : cannot backup $file_path" );
            } else {
                {
                    local $/;
                    my $content = <$src>;
                    print $dst $content;
                }
                close($src);
                close($dst);
                chmod( 0640, $backup_path );
            }
        }
    }

    ## unlink before write so open() creates a new inode
    ## [ setgid group inheritance only applies to newly created files ]
    unlink $file_path if -f $file_path;

    ## write new file
    my $fh;
    unless ( open( $fh, '>', $file_path ) ) {
        <[base.log]>->( 1, "error : cannot write $file_path: $!" );
        $any_error = 1;
        next;
    }

    print $fh $files{$ext};
    close($fh);

    ## set proper permissions [ no world access: dir is drwxrws--- ]
    chmod( 0640, $file_path );

    <[base.log]>->( 3, "wrote $ext file : $file_path" );
}

if ($any_error) {
    <[base.log]>->(
        0, "error: failed to write some certificate files for $domain"
    );
    return {
        status    => 'partial',
        error_msg => 'Some certificate files failed to write'
    };
}

## Update in-memory registry
<letsencr.parent.certs>->{$domain} = {
    issued_at       => $issued_at,
    expires_at      => $expires_at,
    domain          => $domain,
    alt_names       => $alt_names,
    certificate_url => $certificate_url,
    account_id      => $account_id,
    status          => 'valid',
    key_path        => catfile( $certs_dir, "$domain.key" ),
    cert_path       => catfile( $certs_dir, "$domain.cert" ),
    chain_path      => catfile( $certs_dir, "$domain.chain" ),
    pem_path        => catfile( $certs_dir, "$domain.pem" ),
    meta_path       => catfile( $certs_dir, "$domain.meta" ),
};

my $days_remaining = ( $expires_at - time() ) / 86400;
<[base.log]>->(
    2,
    "certificate saved: $domain (expires in "
        . sprintf( "%.1f", $days_remaining )
        . " days)"
);

return {
    status    => qw| success |,
    domain    => $domain,
    pem_path  => catfile( $certs_dir, "$domain.pem" ),
    error_msg => undef
};

