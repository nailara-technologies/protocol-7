## [:< ##

# name  = coding.handler.process-queued-task
# descr = dequeue coding tasks via inference
# purpose = Event handler to process tasks from job queue after deferred reply

## hybrid mode: called from event loop OR jobqueue callback ##
my $input = $_[0];
my ( $task_id, $meta_id );

## detect calling context ##
if ( defined $input && ref($input) && ref($input) =~ m{Event::} ) {

    ## called from event loop (complete-analysis) ##
    my $event = $input;
    $meta_id = $event->w->data;

    unless ( defined $meta_id && length $meta_id ) {
        <[base.logs]>->( 0, "::working:: meta_id required" );
        return { success => FALSE, error => 'meta_id required' };
    }

    my $meta_job = <coding.complete_analysis_jobs>->{$meta_id};

    unless ( defined $meta_job ) {
        <[base.logs]>->( 0, "::working:: meta-job not found : %s", $meta_id );
        return { success => FALSE, error => "meta-job not found: $meta_id" };
    }

    $task_id = $meta_job->{'task_id'};
} elsif ( ref($input) eq qw| HASH |
    && ref( $input->{'params'} ) eq qw| HASH | ) {

    ## called from jobqueue callback (coding.task.execute) ##
    $task_id = $input->{'params'}->{'task_id'};
    $meta_id = undef;    ## no meta-job for direct queue submit ##

    unless ( defined $task_id ) {
        <[base.logs]>->( 0, "::working:: task_id required in jobqueue mode" );
        return { success => FALSE, error => 'task_id required' };
    }
} else {
    <[base.logs]>->(
        0,
        "::working:: unexpected input type : %s",
        ref($input) || 'undef'
    );
    return { success => FALSE, error => 'unexpected input type' };
}

<[base.logs]>->(
    2,        "::working:: processing task=%s [meta=%s]",
    $task_id, $meta_id // 'none'
);

# Get the task from queue
my $task = <coding.task.queue>->{$task_id};

unless ( defined $task ) {
    <[base.logs]>->( 0, "::working:: task not found : %s", $task_id );
    return { success => FALSE, error => "task not found : $task_id" };
}

## reset tool loop stop flag for this task ##
<coding.tool_loop.stop>         = FALSE;
<coding.tool_loop.stop_reason>  = '';
<coding.tool_loop.stop_summary> = '';
<coding.loop_detect_count>      = 0;

## assemble prompt and message array [ shared with show-prompt ] ##
my $assembled    = <[coding.prompt.assemble]>->($task);
my $parsed       = $assembled->{'parsed'};
my $backend_info = $assembled->{'backend_info'};
my $prompt       = $assembled->{'prompt'};

unless ( $backend_info->{'available'} ) {
    <[base.logs]>->(
        0,
        "::working:: backend not available : %s",
        $backend_info->{'error'} // 'unknown'
    );
    $task->{'execution'}->{'status'} = 'failed';
    $task->{'execution'}->{'error'}  = $backend_info->{'error'}
        // 'backend unavailable';
    return { success => FALSE, error => $task->{'execution'}->{'error'} };
}

## update task with routing info ##
$task->{'execution'}->{'backend'}    = $backend_info->{'backend'};
$task->{'execution'}->{'port'}       = $backend_info->{'port'};
$task->{'execution'}->{'model_used'} = $backend_info->{'model'};
$task->{'execution'}->{'status'}     = 'in_progress';
$task->{'execution'}->{'started'}    = <[base.time]>->(3);

## check inference cache before calling backend ##
if ( exists $code{'plugin.storage.inference.lookup'} ) {
    my $cache_result = $code{'plugin.storage.inference.lookup'}->(
        {   'question'    => $prompt,
            'max_results' => 1,
            'prefer'      => qw| recent |
        }
    );

    if (    ref $cache_result eq qw| HASH |
        and $cache_result->{'mode'} eq qw| true |
        and $cache_result->{'data'}{'results'}
        and $cache_result->{'data'}{'results'}->@* ) {
        my $cached    = $cache_result->{'data'}{'results'}[0];
        my $hit_count = $cache_result->{'data'}{'hit_count'} // 0;

        <[base.logs]>->(
            1,
            "::working:: cache hit [ branch=%s hits=%d model=%s ]",
            $cache_result->{'data'}{'branch'},
            $hit_count,
            $cached->{'model'} // qw| unknown |
        );

        ## update task execution metadata ##
        $task->{'execution'}->{'status'}        = 'completed';
        $task->{'execution'}->{'model_used'}    = $cached->{'model'};
        $task->{'execution'}->{'cached'}        = TRUE;
        $task->{'execution'}->{'started'}       = <[base.time]>->(3);
        $task->{'execution'}->{'finish_reason'} = $cached->{'finish_reason'}
            // qw| stop |;

        my $t = <coding.task.queue>->{$task_id};
        $t->{'execution'}->{'finish_reason'} = $cached->{'finish_reason'}
            // qw| stop |
            if defined $t;

        return {
            success => TRUE,
            result  => $cached->{'content'},
            task_id => $task_id,
            cached  => TRUE,
        };
    }

    <[base.logs]>->( 2, "::working:: cache miss, proceeding to inference" );
}

<[base.logs]>->(
    1,
    "::working:: routed to %s:%d model=%s",
    $backend_info->{'backend'},
    $backend_info->{'port'},
    $backend_info->{'model'} // 'default'
);

# Call inference API
my $inference_result = <[coding.routing.decide_service]>->( 'route', $task );

if ( !$inference_result->{success} ) {
    <[base.logs]>->(
        1,
        "::working:: routing decision : %s",
        $inference_result->{error}
    );
}

# Get inference configuration
my $max_tokens     = <inference.model.max_tokens>  // 4096;
my $temperature    = <inference.model.temperature> // 0.7;
my $inference_port = $backend_info->{'port'};
my $model_id       = $backend_info->{'model'};
my $server_seed    = $backend_info->{'seed'} // 'unknown';

<[base.logs]>->(
    2, "::working:: model=%s tokens=%d temp=%f port=%d seed=%s",
    $model_id, $max_tokens, $temperature, $inference_port, $server_seed
);

## use pre-assembled message array ##
my @messages = $assembled->{'messages'}->@*;

## tool definitions for function calling ##
my $tools = $assembled->{'tools'};

## inference loop with tool call support ##
my $response_text     = '';
my $finish_reason_val = 'stop';
my $http_error;
my $max_tool_rounds = 777;
my $tool_round      = 0;
my $server_retries  = 5;  ## retries for transient server/connection errors ##

## context size tracking for compaction ##
my $context_limit     = <inference.model.context_length> // 16384;
my $compact_threshold = int( $context_limit * 0.53 );    ## compact at 53% ##
my $chars_per_token   = 3.2;    ## adjusted for tool-calling JSON overhead ##
my $keep_recent_msgs  = 6;      ## preserve last 3 tool rounds [ 6 msgs ] ##

eval {
    use LWP::UserAgent;
    use JSON::PP;

    my $ua = LWP::UserAgent->new;
    $ua->timeout(300);    ## 5 min [ allows 4096 token generation on gpu ] ##

    my $json = JSON::PP->new->utf8->canonical;

INFERENCE_LOOP:
    while ( $tool_round <= $max_tool_rounds ) {

        ## check for and process event loop activity ##
        <[event.once]>->(0.07);

        ## check for stop request from coding.cmd.stop-task ##
        if ( $task->{'stop_requested'} ) {
            <[base.logs]>->(
                1, "::working:: stop requested for task %s", $task_id
            );
            $task->{'execution'}->{'status'}      = 'failed';
            $task->{'execution'}->{'error'}       = 'task stopped by user';
            $task->{'execution'}->{'stop_reason'} = 'user_request';
            return {
                success => FALSE,
                error   => 'task stopped by user',
                task_id => $task_id
            };
        }

        ## check for injected messages from coding.cmd.inject-message ##
        if ( ref $task->{'injected_messages'} eq qw| ARRAY |
            and $task->{'injected_messages'}->@* ) {
            my @injected = $task->{'injected_messages'}->@*;
            $task->{'injected_messages'} = [];

            for my $im (@injected) {
                push @messages,
                    {
                    'role'    => $im->{'role'}    // qw| user |,
                    'content' => $im->{'content'} // ''
                    };
            }

            <[base.logs]>->(
                1,
                "::working:: injected %d message(s) from external source",
                scalar @injected
            );
        }

        ## context compaction: estimate size, compact if approaching limit ##
        if ( $tool_round > 2 and @messages > 4 ) {
            my $total_chars = 0;
            for my $msg (@messages) {
                $total_chars += length( $msg->{'content'} // '' );
                ## count tool call arguments [ often largest part ] ##
                if ( ref $msg->{'tool_calls'} eq qw| ARRAY | ) {
                    for my $tc ( $msg->{'tool_calls'}->@* ) {
                        $total_chars
                            += length( $tc->{'function'}->{'arguments'}
                                // '' );
                        $total_chars
                            += length( $tc->{'function'}->{'name'} // '' );
                    }
                }
            }
            ## 1.4x accounts for JSON keys, tool defs, metadata ##
            my $est_tokens = int( ( $total_chars * 1.4 ) / $chars_per_token );

            if ( $est_tokens > $compact_threshold ) {
                <[base.logs]>->(
                    1,
                    "::working:: context compaction : "
                        . "%d tokens est, threshold=%d, %d msgs",
                    $est_tokens,
                    $compact_threshold,
                    scalar @messages
                );

                ## keep system [0] and user [1] messages intact ##
                ## compact tool round messages in the middle ##
                ## keep the most recent $keep_recent_msgs messages ##
                my $protect_start = 2;    ## after system + user ##
                my $protect_end   = scalar(@messages) - $keep_recent_msgs;
                $protect_end = $protect_start
                    if $protect_end < $protect_start;

                if ( $protect_end > $protect_start ) {
                    ## graduated compaction: older = more aggressive ##
                    my $mid = int( ( $protect_start + $protect_end ) / 2 );
                    my @summary_parts;

                    ## oldest section: aggressive — just tool names ##
                    for my $i ( $protect_start .. $mid - 1 ) {
                        my $m = $messages[$i];
                        if ( $m->{'role'} eq 'assistant'
                            and ref $m->{'tool_calls'} eq qw| ARRAY | ) {
                            my @names
                                = map { $_->{'function'}->{'name'} // '?' }
                                $m->{'tool_calls'}->@*;
                            push @summary_parts,
                                'called: ' . join( ', ', @names );
                        } elsif ( $m->{'role'} eq 'tool' ) {
                            my $content = $m->{'content'} // '';
                            my $snip    = substr( $content, 0, 80 );
                            $snip =~ s|\n.*||s;
                            push @summary_parts, "result: $snip";
                        }
                    }

                    ## middle section: moderate — tool name + short result ##
                    for my $i ( $mid .. $protect_end - 1 ) {
                        my $m = $messages[$i];
                        if ( $m->{'role'} eq 'assistant'
                            and ref $m->{'tool_calls'} eq qw| ARRAY | ) {
                            my @names
                                = map { $_->{'function'}->{'name'} // '?' }
                                $m->{'tool_calls'}->@*;
                            push @summary_parts,
                                'called: ' . join( ', ', @names );
                        } elsif ( $m->{'role'} eq 'tool' ) {
                            my $content = $m->{'content'} // '';
                            my $snip    = substr( $content, 0, 200 );
                            $snip =~ s|\n| / |g;
                            push @summary_parts, "result: $snip";
                        }
                    }

                    ## Calculate progress based on current token usage ##
                    my $pct_complete
                        = int( ( $est_tokens / $context_limit ) * 100 );

                    ## replace compacted range with summary message ##
                    my $summary
                        = "[ inference : round "
                        . $tool_round
                        . " | context "
                        . $pct_complete
                        . "% used ]\n"
                        . "[ compacted tool rounds — "
                        . scalar(@summary_parts)
                        . " interactions ]\n"
                        . join( "\n", @summary_parts );

                    splice @messages, $protect_start,
                        $protect_end - $protect_start,
                        {
                        'role'    => 'assistant',
                        'content' => $summary,
                        };

                    ## store compaction data for later analysis ##
                    my $after_chars = 0;
                    $after_chars += length( $_->{'content'} // '' )
                        for @messages;

                    <coding.compaction.last> = {
                        'round'        => $tool_round,
                        'threshold'    => $compact_threshold,
                        'before_count' => scalar(@messages)
                            + $protect_end
                            - $protect_start,
                        'before_tokens' => $est_tokens,
                        'after_count'   => scalar @messages,
                        'after_tokens'  =>
                            int( ( $after_chars * 1.4 ) / $chars_per_token ),
                        'compacted_count' => $protect_end - $protect_start,
                        'first_round'     => $protect_start - 2,
                        'last_round'      => $protect_end - 2,
                        'summary'         => substr( $summary, 0, 2000 ),
                    };

                    <[base.logs]>->(
                        1,
                        "::working:: compacted %d msgs → 1 "
                            . "summary, %d msgs remain",
                        $protect_end - $protect_start,
                        scalar @messages
                    );
                }

                ## truncate protected messages only if still over threshold ##
                ## after compaction [ allows 10K+ file reads when under limit ] ##
                my $after_chars = 0;
                $after_chars += length( $_->{'content'} // '' ) for @messages;
                my $after_tokens
                    = int( ( $after_chars * 1.4 ) / $chars_per_token );

                if ( $after_tokens > $compact_threshold * 0.8 ) {
                    my $max_protected_chars = 8000;    ## ~2500 tokens each ##
                    for my $i ( $protect_end .. $#messages ) {
                        my $content = $messages[$i]->{'content'} // '';
                        if ( length $content > $max_protected_chars ) {
                            my $truncated
                                = substr( $content, 0, $max_protected_chars );
                            $truncated
                                .= "\n\n... [ truncated "
                                . ( length($content) - $max_protected_chars )
                                . " chars ]";
                            $messages[$i]->{'content'} = $truncated;
                            <[base.logs]>->(
                                2,
                                "::working:: truncated msg %d to %d chars [still %d tokens est]",
                                $i,
                                $max_protected_chars,
                                $after_tokens
                            );
                        }
                    }
                }
            }
        }

        ## sanitize messages for jinja2 safety ##
        ## only match actual jinja template patterns, not perl hashrefs ##
        my $jinja_var   = qr|\{\{\s*[a-zA-Z_]\w*\s*\}\}|;      ## {{ var }} ##
        my $jinja_block = qr{%\s*(?:if|for|set|include)\s};    ## {% tag ##
        my $jinja_ns = qr|namespace\s*\(\s*value\s*=|;  ## namespace(value= ##

        for my $msg (@messages) {
            my $content  = $msg->{'content'} // '';
            my $detected = '';

            if ( $content =~ $jinja_var ) {
                $detected = 'jinja_var';
            } elsif ( $content =~ $jinja_block ) {
                $detected = 'jinja_block';
            } elsif ( $content =~ $jinja_ns ) {
                $detected = 'jinja_ns';
            }

            if ($detected) {
                ## log snippet for false positive analysis ##
                my $snippet = $content;
                $snippet =~ s|\s+| |g;
                $snippet = substr( $snippet, 0, 80 );
                <[base.logs]>->(
                    2,         "::working:: sanitized %s [ %s ]",
                    $detected, $snippet
                );
                ## escape braces to prevent template errors ##
                $content =~ s|\{\{|｛｛|g;
                $content =~ s|\}\}|｝｝|g;
                $content =~ s|\{%|｛%|g;
                $content =~ s|%\}|%｝|g;
                ## break namespace( pattern to prevent template interpretation ##
                $content =~ s|namespace\s*\(|namespace_(|g;
                $msg->{'content'} = $content;
            }
        }

        ## log request to model output buffer ##
        my $last_msg = $messages[-1];
        <[coding.buffer.model_output]>->(
            $last_msg->{'content'} // '[tool result]',
            {   'round' => $tool_round,
                'tool'  => 'input',
            }
        );

        ## build request body ##
        my %request = (
            model       => $model_id,
            messages    => \@messages,
            max_tokens  => $max_tokens,
            temperature => $temperature,
        );

        ## include tools on first round or when tool loop is active ##
        if ( defined $tools and $tools->@* ) {
            $request{'tools'}       = $tools;
            $request{'tool_choice'} = 'auto';
        }

        ## sanitize all message content before sending to prevent Jinja errors ##
        for my $msg ( $request{'messages'}->@* ) {
            my $content = $msg->{'content'} // '';
            ## use unicode lookalikes to break Jinja parsing on server ##
            $content =~ s|\{\{|｛｛|g;
            $content =~ s|\}\}|｝｝|g;
            $content =~ s|\{%|｛%|g;
            $content =~ s|%\}|%｝|g;
            $content =~ s|namespace\s*\(|namespace_(|g;
            $msg->{'content'} = $content;
        }

        my $body = $json->encode( \%request );

        ## estimate token usage for monitoring ##
        my $body_chars  = length($body);
        my $est_tokens  = int( $body_chars / $chars_per_token );
        my $pct_used    = int( $est_tokens * 100 / $context_limit );
        my $tokens_left = $context_limit - $est_tokens - $max_tokens;

        <[base.logs]>->(
            1,
            "::working:: :%03d: msgs=%d <T:%d:%d:%d> [CTX:%d%%]",
            $tool_round,
            scalar @messages,
            $est_tokens,
            $context_limit,
            $tokens_left > 0 ? $tokens_left : 0,
            $pct_used
        );

        my $http_response = $ua->post(
            "http://localhost:${inference_port}/v1/chat/completions",
            Content_Type => 'application/json',
            Content      => $body
        );

        if ( !$http_response->is_success ) {
            my $status = $http_response->status_line;
            ## extract error detail from response body ##
            my $detail = '';
            my $body   = $http_response->content // '';
            if ( length $body ) {
                my $err_detail = eval { $json->decode($body) };
                if ( ref $err_detail eq qw| HASH |
                    and $err_detail->{'error'} ) {
                    $detail = $err_detail->{'error'}{'message'}
                        // $err_detail->{'error'};
                }
            }

            ## detect retryable errors ##
            my $is_jinja_err
                = $detail  =~ m|item pairs from a mapping|
                || $detail =~ m|jinja|i
                || $detail =~ m|namespace\(|i;
            my $is_timeout = $status =~ m|timeout|i
                || $status =~ m|^5\d\d|;
            my $is_conn_err
                = $detail  =~ m|Connection refused|i
                || $detail =~ m|Can't connect|i
                || $detail =~ m|connect.*failed|i;

            if ( ( $is_jinja_err or $is_timeout or $is_conn_err )
                and $server_retries > 0 ) {
                $server_retries--;
                my $err_type
                    = $is_jinja_err ? 'jinja template'
                    : $is_conn_err  ? 'connection'
                    :                 'server';
                <[base.logs]>->(
                    1,         "::working:: %s error [ retrying, %d left ]",
                    $err_type, $server_retries
                );
                ## remove last assistant message with broken tool calls ##
                if ($is_jinja_err) {
                    pop @messages
                        if @messages
                        and ( $messages[-1]->{'role'} // '' ) eq 'assistant';
                }
                ## for connection errors, yield to event loop to allow server restart ##
                if ($is_conn_err) {
                    <[event.once]>->(2.0)
                        ;    ## yield for server restart processing ##
                } else {
                    <[base.sleep]>->( $is_timeout ? 2 : 0.5 );
                }
                next INFERENCE_LOOP;
            }

            $http_error
                = length $detail
                ? sprintf '%s [ %s ]', $status, $detail
                : $status;
            last INFERENCE_LOOP;
        }

        my $decoded = eval { $json->decode( $http_response->content ) };
        if ($@) {
            $http_error = sprintf 'json decode error: %s',
                <[base.str.eval_error]>;
            last INFERENCE_LOOP;
        }

        unless ( ref($decoded) eq qw| HASH | && $decoded->{'choices'} ) {
            $http_error = 'unexpected response format';
            last INFERENCE_LOOP;
        }

        my $choice  = $decoded->{'choices'}[0];
        my $message = $choice->{'message'} // {};
        $finish_reason_val = $choice->{'finish_reason'} // 'stop';

        ## sanitize model response content for jinja safety ##
        my $model_content = $message->{'content'} // '[tool_calls]';
        $model_content =~ s|\{\{|｛｛|g;  ## replace {{ with fullwidth braces ##
        $model_content =~ s|\}\}|｝｝|g;  ## replace }} with fullwidth braces ##
        $model_content =~ s|\{%|｛%|g;   ## replace {% with mixed braces ##
        $model_content =~ s|%\}|%｝|g;   ## replace %} with mixed braces ##
        $model_content
            =~ s|namespace\s*\(|namespace_(|g;    ## break namespace( ##
        $message->{'content'} = $model_content;

        ## log model response to output buffer ##
        <[coding.buffer.model_output]>->(
            $model_content,
            {   'round' => $tool_round,
                'tool'  => 'model',
            }
        );

        ## check for tool calls ##
        if (    $finish_reason_val eq 'tool_calls'
            and ref $message->{'tool_calls'} eq qw| ARRAY |
            and $message->{'tool_calls'}->@* ) {
            $tool_round++;

            ## sanitize tool call arguments for jinja safety ##
            for my $tc ( $message->{'tool_calls'}->@* ) {
                my $args = $tc->{'function'}->{'arguments'} // '';
                if ( length $args ) {
                    $args =~ s|\{\{|\\{\\{|g;
                    $args =~ s|\{%|\\{%|g;
                    $args =~ s|namespace\s*\(|namespace_(|g;
                    $tc->{'function'}->{'arguments'} = $args;
                }
            }

            ## append assistant message with tool calls to conversation ##
            push @messages, $message;

            ##========================================================##
            ## LOOP DETECTION - Multi-phase with model assertion      ##
            ## Compatible with future task multiplexing               ##
            ##========================================================##

            my $loop_check         = qw| false |;
            my $assertion_injected = 0;

            ## Track model response for loop detection ##
            my $model_content = $message->{'content'} // '';
            $model_content =~ s|^\s+||;    ## Normalize leading whitespace ##
            $model_content =~ s|\s+$||;

            $loop_check = <[coding.tool.detect_loop]>->(
                $task,       $message->{'tool_calls'},
                'suspicion', $model_content
            );

            ## Handle direct escalation (high-confidence patterns) ##
            if (ref $loop_check eq qw| HASH |
                and (  $loop_check->{'skip_assert'}
                    or $loop_check->{'escalate_direct'} )
            ) {

                <[base.logs]>->(
                    0,
                    "::working:: loop detected [score %.1f]: %s",
                    $loop_check->{'score'}   // 0,
                    $loop_check->{'message'} // 'unknown'
                );

                ## Track consecutive loop detections ##
                <coding.loop_detect_count>++;
                if ( <coding.loop_detect_count> >= 3 ) {
                    <[base.logs]>->(
                        0,
                        "::working:: loop persisted after 3 warnings, forcing stop"
                    );
                    $http_error
                        = 'loop detected: task stopped after repeated warnings';
                    last INFERENCE_LOOP;
                }

                ## Inject escalation warning as system message ##
                push @messages,
                    {
                    'role'    => 'system',
                    'content' => $loop_check->{'warning'}
                        // $loop_check->{'message'}
                    };
            }
            ## Handle assertion request (polling-allowed patterns) ##
            elsif ( ref $loop_check eq qw| HASH |
                and $loop_check->{'request_assertion'} ) {

                my $pattern = $loop_check->{'pattern'}    // 'unknown';
                my $score   = $loop_check->{'score'}      // 0;
                my $conf    = $loop_check->{'confidence'} // 0;

                <[base.logs]>->(
                    1, "::working:: loop suspicion [%.1f, %s] - assertion",
                    $score, $pattern
                );

                ## Build assertion prompt ##
                my $assert_prompt = sprintf(
                    "[LOOP ASSERTION REQUEST]\n\n"
                        . "Pattern '%s' detected (conf: %d%%)\n"
                        . "Recent: %s | Score: %.1f\n\n"
                        . "Self-assess: Are you looping? Reply:\n"
                        . "LOOPING | NOT_LOOPING | UNCLEAR",
                    $pattern,
                    int( $conf * 100 ),
                    join( ' → ',
                        @{ $loop_check->{'history_snapshot'} // [] } ),
                    $score
                );

                ## Inject as tool result ##
                push @messages,
                    {
                    'role'         => 'tool',
                    'tool_call_id' => 'loop_assert_' . $tool_round,
                    'content'      => $assert_prompt,
                    };

                $assertion_injected = 1;
            } else {
                ## No loop pattern detected - reset counter ##
                <coding.loop_detect_count> = 0;
            }

            ## dispatch each tool call ##
            for my $tc ( $message->{'tool_calls'}->@* ) {
                my $tool_name = $tc->{'function'}->{'name'} // '?';

                <[base.logs]>->(
                    2,           "::working:: tool call :%04d: %s",
                    $tool_round, $tool_name
                );

                my $tool_result = $code{'coding.tools.dispatch'}->($tc);

                ## sanitize malformed arguments before they re-enter   ##
                ## conversation history — jinja template crashes when   ##
                ## iterating non-dict arguments in tool_calls messages  ##
                my $tc_args = $tc->{'function'}->{'arguments'} // '';
                if ( not ref $tc_args and length $tc_args ) {
                    my $check = eval { JSON::PP::decode_json($tc_args) };
                    if ( not defined $check or ref $check ne qw| HASH | ) {
                        $tc->{'function'}->{'arguments'} = '{}';
                    }
                }

                ## sanitize tool result content for jinja safety ##
                my $tool_content = $tool_result->{'content'} // '';
                $tool_content
                    =~ s|\{\{|｛｛|g;    ## replace {{ with fullwidth braces ##
                $tool_content
                    =~ s|\}\}|｝｝|g;    ## replace }} with fullwidth braces ##
                $tool_content
                    =~ s|\{%|｛%|g;     ## replace {% with mixed braces ##
                $tool_content
                    =~ s|%\}|%｝|g;     ## replace %} with mixed braces ##
                $tool_content
                    =~ s|namespace\s*\(|namespace_(|g;  ## break namespace( ##

                ## append tool result as tool role message ##
                push @messages,
                    {
                    'role'         => 'tool',
                    'tool_call_id' => $tc->{'id'} // '',
                    'content'      => $tool_content,
                    };
            }

            ## build tool summary with truncated parameters ##
            my @tool_summaries;
            for my $tc ( $message->{'tool_calls'}->@* ) {
                my $name = $tc->{'function'}->{'name'}      // '?';
                my $args = $tc->{'function'}->{'arguments'} // '';

                ## extract key params for context (path, pattern, module, etc.) ##
                my $param_summary = '';
                if ( length $args ) {
                    my $args_hash = eval { JSON::PP::decode_json($args) };
                    if ( ref $args_hash eq qw| HASH | ) {
                        ## extract most informative params ##
                        my @key_params;
                        for my $key (qw| path module pattern name query |) {
                            if ( defined $args_hash->{$key}
                                and length $args_hash->{$key} ) {
                                push @key_params,
                                    "$key:" . $args_hash->{$key};
                                last;    ## only first match ##
                            }
                        }
                        $param_summary = join( ', ', @key_params )
                            if @key_params;
                    }
                }

                ## ellipsize params for display ##
                if ( length $param_summary ) {
                    $param_summary = <[base.parser.ellipse_center]>
                        ->( $param_summary, 24 );
                    push @tool_summaries, "[ $name ]::[ $param_summary ]";
                } else {
                    push @tool_summaries, "[ $name ]";
                }
            }

            <[base.logs]>->(
                1,           "::working:: :%03d: %s",
                $tool_round, join( ' ', @tool_summaries )
            );

            ## check if a tool signaled stop [ task_complete / escalate ] ##
            if (<coding.tool_loop.stop>) {
                my $reason  = <coding.tool_loop.stop_reason>  // 'unknown';
                my $summary = <coding.tool_loop.stop_summary> // '';

                <[base.logs]>->(
                    1,       "::working:: stop signal: %s [ %s ]",
                    $reason, substr( $summary, 0, 120 )
                );

                $response_text = $summary;
                $finish_reason_val
                    = $reason eq 'escalate' ? 'escalate' : 'stop';

                ## store reason on task ##
                my $t = <coding.task.queue>->{$task_id};
                if ( defined $t ) {
                    $t->{'execution'}->{'finish_reason'} = $finish_reason_val;
                    $t->{'execution'}->{'stop_reason'}   = $reason;
                }

                last INFERENCE_LOOP;
            }

            ## yield to event loop between tool rounds ##
            ## allows network commands [ show-buffer, get-result ] to be ##
            ## processed while inference is running ##
            <[event.once]>->(0.07);

            next INFERENCE_LOOP;
        }

        ## normal completion — extract response text ##
        $response_text = $message->{'content'} // '';

        ##============================================================##
        ## PROCESS ASSERTION RESPONSE (if assertion was requested)    ##
        ##============================================================##
        if (    $task->{'execution'}->{'loop_detection'}
            and
            $task->{'execution'}->{'loop_detection'}->{'assertion_pending'} )
        {

            my $assert_result = <[coding.tool.detect_loop]>->(
                $task,
                $response_text,    ## Model's response content ##
                'assertion'
            );

            if ( ref $assert_result eq qw| HASH | ) {
                ## Model confirmed loop - escalate ##
                if ( $assert_result->{'confirmed_loop'} ) {
                    <[base.logs]>->(
                        0,
                        "::working:: loop CONFIRMED by model [%s]",
                        $assert_result->{'votes'} // 'single'
                    );

                    ## Inject escalation warning ##
                    push @messages,
                        {
                        'role'    => 'system',
                        'content' => $assert_result->{'message'}
                            . "\n\nACTION REQUIRED: "
                            . "Please conclude your work or call task_complete."
                        };

                    ## Continue loop - model sees warning and should act ##
                    next INFERENCE_LOOP;
                }
                ## Model says not looping - clear and continue ##
                elsif ( $assert_result->{'assertion_complete'}
                    and !$assert_result->{'confirmed_loop'} ) {
                    <[base.logs]>->(
                        1, "::working:: loop cleared by model assertion"
                    );
                }
                ## Requesting confirmation (single assertion says looping) ##
                elsif ( $assert_result->{'request_confirm'} ) {
                    <[base.logs]>->(
                        1,
                        "::working:: loop assertion: requesting confirmation"
                    );
                    ## Will ask again on next suspicion trigger ##
                }
            }
        }

        ## accumulate partial content from tool rounds ##
        if ( $tool_round > 0 ) {
            <[base.logs]>->(
                1, "::working:: completed after %d tool rounds, %d chars",
                $tool_round, length($response_text)
            );
        } else {
            <[base.logs]>->(
                1,
                "::working:: inference success : %d chars, finish_reason=%s",
                length($response_text),
                $finish_reason_val
            );
        }

        ## store finish_reason on task so completion chain can read it ##
        my $t = <coding.task.queue>->{$task_id};
        $t->{'execution'}->{'finish_reason'} = $finish_reason_val
            if defined $t;

        last INFERENCE_LOOP;
    }

    if ( $tool_round > $max_tool_rounds ) {
        $http_error = "tool call loop exceeded $max_tool_rounds rounds";
    }
};

$http_error //= <[base.str.eval_error]> if $@;    ## capture eval die ##

if ( defined $http_error ) {
    my $err_short
        = <[base.parser.center_ellipse_string]>->( $http_error, 72 );
    <[base.logs]>->( 0, "::working:: inference error : %s", $err_short );
    $task->{'execution'}->{'status'} = 'failed';
    $task->{'execution'}->{'error'}  = $http_error;
    return { success => FALSE, error => $http_error, task_id => $task_id };
}

## store result in inference cache ##
if ( length $response_text
    and exists $code{'plugin.storage.inference.store'} ) {
    my $store_result = $code{'plugin.storage.inference.store'}->(
        {   'question'      => $prompt,
            'response'      => $response_text,
            'model'         => $model_id,
            'temperature'   => $temperature,
            'seed'          => $server_seed,
            'finish_reason' => $finish_reason_val,
        }
    );

    if ( ref $store_result eq qw| HASH |
        and $store_result->{'mode'} eq qw| true | ) {
        <[base.logs]>->(
            2,
            "::working:: cached → branch=%s result=%s",
            $store_result->{'data'}{'branch'} // '?',
            substr( $store_result->{'data'}{'result'} // '', 0, 12 )
        );
    }
}

## return result hashref for jobqueue callback ##
return { success => TRUE, result => $response_text, task_id => $task_id };

