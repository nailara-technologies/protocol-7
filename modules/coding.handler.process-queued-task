## [:< ##

# name  = coding.handler.process-queued-task
# descr = dequeue coding tasks via inference
# purpose = Event handler to process tasks from job queue after deferred reply

## hybrid mode: called from event loop OR jobqueue callback ##
my $input = $_[0];
my ( $task_id, $meta_id );

## detect calling context ##
if ( defined $input && ref($input) && ref($input) =~ m{Event::} ) {

    ## called from event loop (complete-analysis) ##
    my $event = $input;
    $meta_id = $event->w->data;

    unless ( defined $meta_id && length $meta_id ) {
        <[base.logs]>->( 0, "[process-queued-task] meta_id required" );
        return { success => FALSE, error => 'meta_id required' };
    }

    my $meta_job = <coding.complete_analysis_jobs>->{$meta_id};

    unless ( defined $meta_job ) {
        <[base.logs]>->(
            0, "[process-queued-task] meta-job not found: %s", $meta_id
        );
        return { success => FALSE, error => "meta-job not found: $meta_id" };
    }

    $task_id = $meta_job->{'task_id'};
} elsif ( ref($input) eq qw| HASH |
    && ref( $input->{'params'} ) eq qw| HASH | ) {

    ## called from jobqueue callback (coding.task.execute) ##
    $task_id = $input->{'params'}->{'task_id'};
    $meta_id = undef;    ## no meta-job for direct queue submit ##

    unless ( defined $task_id ) {
        <[base.logs]>->(
            0, "[process-queued-task] task_id required in jobqueue mode"
        );
        return { success => FALSE, error => 'task_id required' };
    }
} else {
    <[base.logs]>->(
        0,
        "[process-queued-task] unexpected input type: %s",
        ref($input) || 'undef'
    );
    return { success => FALSE, error => 'unexpected input type' };
}

<[base.logs]>->(
    2,        "[process-queued-task] processing task=%s (meta=%s)",
    $task_id, $meta_id // 'none'
);

# Get the task from queue
my $task = <coding.task.queue>->{$task_id};

unless ( defined $task ) {
    <[base.logs]>
        ->( 0, "[process-queued-task] task not found: %s", $task_id );
    return { success => FALSE, error => "task not found: $task_id" };
}

## assemble prompt and message array [ shared with show-prompt ] ##
my $assembled    = <[coding.prompt.assemble]>->($task);
my $parsed       = $assembled->{'parsed'};
my $backend_info = $assembled->{'backend_info'};
my $prompt       = $assembled->{'prompt'};

unless ( $backend_info->{'available'} ) {
    <[base.logs]>->(
        0,
        "[process-queued-task] backend not available: %s",
        $backend_info->{'error'} // 'unknown'
    );
    $task->{'execution'}->{'status'} = 'failed';
    $task->{'execution'}->{'error'}  = $backend_info->{'error'}
        // 'backend unavailable';
    return { success => FALSE, error => $task->{'execution'}->{'error'} };
}

## update task with routing info ##
$task->{'execution'}->{'backend'}    = $backend_info->{'backend'};
$task->{'execution'}->{'port'}       = $backend_info->{'port'};
$task->{'execution'}->{'model_used'} = $backend_info->{'model'};
$task->{'execution'}->{'status'}     = 'in_progress';
$task->{'execution'}->{'started'}    = <[base.time]>->(3);

## check inference cache before calling backend ##
if ( exists $code{'plugin.storage.inference.lookup'} ) {
    my $cache_result = $code{'plugin.storage.inference.lookup'}->(
        {   'question'    => $prompt,
            'max_results' => 1,
            'prefer'      => qw| recent |
        }
    );

    if (    ref $cache_result eq qw| HASH |
        and $cache_result->{'mode'} eq qw| true |
        and $cache_result->{'data'}{'results'}
        and $cache_result->{'data'}{'results'}->@* ) {
        my $cached    = $cache_result->{'data'}{'results'}[0];
        my $hit_count = $cache_result->{'data'}{'hit_count'} // 0;

        <[base.logs]>->(
            1,
            "[process-queued-task] cache hit [ branch=%s hits=%d model=%s ]",
            $cache_result->{'data'}{'branch'},
            $hit_count,
            $cached->{'model'} // qw| unknown |
        );

        ## update task execution metadata ##
        $task->{'execution'}->{'status'}        = 'completed';
        $task->{'execution'}->{'model_used'}    = $cached->{'model'};
        $task->{'execution'}->{'cached'}        = TRUE;
        $task->{'execution'}->{'started'}       = <[base.time]>->(3);
        $task->{'execution'}->{'finish_reason'} = $cached->{'finish_reason'}
            // qw| stop |;

        my $t = <coding.task.queue>->{$task_id};
        $t->{'execution'}->{'finish_reason'} = $cached->{'finish_reason'}
            // qw| stop |
            if defined $t;

        return {
            success => TRUE,
            result  => $cached->{'content'},
            task_id => $task_id,
            cached  => TRUE,
        };
    }

    <[base.logs]>->(
        2, "[process-queued-task] cache miss, proceeding to inference"
    );
}

<[base.logs]>->(
    1,
    "[process-queued-task] routed to %s:%d",
    $backend_info->{'backend'},
    $backend_info->{'port'}
);
<[base.logs]>->(
    2,
    "[process-queued-task] model=%s",
    $backend_info->{'model'} // 'default'
);

<[base.logs]>->(
    1,
    "[process-queued-task] executing via inference: %s",
    substr( $prompt, 0, 50 )
);

# Call inference API
my $inference_result = <[coding.routing.decide_service]>->( 'route', $task );

if ( !$inference_result->{success} ) {
    <[base.logs]>->(
        1,
        "[process-queued-task] routing decision: %s",
        $inference_result->{error}
    );
}

# Get inference configuration
my $max_tokens     = <inference.model.max_tokens>  // 4096;
my $temperature    = <inference.model.temperature> // 0.7;
my $inference_port = $backend_info->{'port'};
my $model_id       = $backend_info->{'model'};
my $server_seed    = $backend_info->{'seed'} // 'unknown';

<[base.logs]>->(
    1, "[process-queued-task] model=%s tokens=%d temp=%f port=%d seed=%s",
    $model_id, $max_tokens, $temperature, $inference_port, $server_seed
);

## use pre-assembled message array ##
my @messages = $assembled->{'messages'}->@*;

## tool definitions for function calling ##
my $tools = $assembled->{'tools'};

## inference loop with tool call support ##
my $response_text     = '';
my $finish_reason_val = 'stop';
my $http_error;
my $max_tool_rounds = 42;
my $tool_round      = 0;

## context size tracking for compaction ##
my $context_limit     = <inference.model.context_length> // 16384;
my $compact_threshold = int( $context_limit * 0.55 );    ## compact at 55% ##
my $chars_per_token   = 3.2;    ## adjusted for tool-calling JSON overhead ##
my $keep_recent_msgs  = 6;      ## preserve last 3 tool rounds [ 6 msgs ] ##

eval {
    use LWP::UserAgent;
    use JSON::PP;

    my $ua = LWP::UserAgent->new;
    $ua->timeout(300);    ## 5 min [ allows 4096 token generation on gpu ] ##

    my $json = JSON::PP->new->utf8->canonical;

INFERENCE_LOOP:
    while ( $tool_round <= $max_tool_rounds ) {

        ## context compaction: estimate size, compact if approaching limit ##
        if ( $tool_round > 2 and @messages > 4 ) {
            my $total_chars = 0;
            $total_chars += length( $_->{'content'} // '' ) for @messages;
            my $est_tokens = int( $total_chars / $chars_per_token );

            if ( $est_tokens > $compact_threshold ) {
                <[base.logs]>->(
                    1,
                    "[process-queued-task] context compaction: "
                        . "%d tokens est, threshold=%d, %d msgs",
                    $est_tokens,
                    $compact_threshold,
                    scalar @messages
                );

                ## keep system [0] and user [1] messages intact ##
                ## compact tool round messages in the middle ##
                ## keep the most recent $keep_recent_msgs messages ##
                my $protect_start = 2;    ## after system + user ##
                my $protect_end   = scalar(@messages) - $keep_recent_msgs;
                $protect_end = $protect_start
                    if $protect_end < $protect_start;

                if ( $protect_end > $protect_start ) {
                    ## graduated compaction: older = more aggressive ##
                    my $mid = int( ( $protect_start + $protect_end ) / 2 );
                    my @summary_parts;

                    ## oldest section: aggressive — just tool names ##
                    for my $i ( $protect_start .. $mid - 1 ) {
                        my $m = $messages[$i];
                        if ( $m->{'role'} eq 'assistant'
                            and ref $m->{'tool_calls'} eq qw| ARRAY | ) {
                            my @names
                                = map { $_->{'function'}->{'name'} // '?' }
                                $m->{'tool_calls'}->@*;
                            push @summary_parts,
                                'called: ' . join( ', ', @names );
                        } elsif ( $m->{'role'} eq 'tool' ) {
                            my $content = $m->{'content'} // '';
                            my $snip    = substr( $content, 0, 80 );
                            $snip =~ s|\n.*||s;
                            push @summary_parts, "result: $snip";
                        }
                    }

                    ## middle section: moderate — tool name + short result ##
                    for my $i ( $mid .. $protect_end - 1 ) {
                        my $m = $messages[$i];
                        if ( $m->{'role'} eq 'assistant'
                            and ref $m->{'tool_calls'} eq qw| ARRAY | ) {
                            my @names
                                = map { $_->{'function'}->{'name'} // '?' }
                                $m->{'tool_calls'}->@*;
                            push @summary_parts,
                                'called: ' . join( ', ', @names );
                        } elsif ( $m->{'role'} eq 'tool' ) {
                            my $content = $m->{'content'} // '';
                            my $snip    = substr( $content, 0, 200 );
                            $snip =~ s|\n| / |g;
                            push @summary_parts, "result: $snip";
                        }
                    }

                    ## replace compacted range with summary message ##
                    my $summary
                        = "[ compacted tool rounds — "
                        . scalar(@summary_parts)
                        . " interactions ]\n"
                        . join( "\n", @summary_parts );

                    splice @messages, $protect_start,
                        $protect_end - $protect_start,
                        {
                        'role'    => 'assistant',
                        'content' => $summary,
                        };

                    <[base.logs]>->(
                        1,
                        "[process-queued-task] compacted %d msgs → 1 "
                            . "summary, %d msgs remain",
                        $protect_end - $protect_start,
                        scalar @messages
                    );
                }
            }
        }

        ## build request body ##
        my %request = (
            model       => $model_id,
            messages    => \@messages,
            max_tokens  => $max_tokens,
            temperature => $temperature,
        );

        ## include tools on first round or when tool loop is active ##
        if ( defined $tools and $tools->@* ) {
            $request{'tools'}       = $tools;
            $request{'tool_choice'} = 'auto';
        }

        my $body = $json->encode( \%request );

        ## estimate token usage for monitoring ##
        my $body_chars  = length($body);
        my $est_tokens  = int( $body_chars / $chars_per_token );
        my $pct_used    = int( $est_tokens * 100 / $context_limit );
        my $tokens_left = $context_limit - $est_tokens - $max_tokens;

        <[base.logs]>->(
            1,
            "[process-queued-task] round=%d msgs=%d est_tokens=%d/%d"
                . " [ %d%% ] remaining=%d",
            $tool_round,
            scalar @messages,
            $est_tokens,
            $context_limit,
            $pct_used,
            $tokens_left > 0 ? $tokens_left : 0
        );

        my $http_response = $ua->post(
            "http://localhost:${inference_port}/v1/chat/completions",
            Content_Type => 'application/json',
            Content      => $body
        );

        if ( !$http_response->is_success ) {
            $http_error = $http_response->status_line;
            ## log response body for diagnostics ##
            my $body = $http_response->content // '';
            if ( length $body ) {
                my $err_detail = eval { $json->decode($body) };
                if ( ref $err_detail eq qw| HASH |
                    and $err_detail->{'error'} ) {
                    $http_error .= sprintf ' [ %s ]',
                        $err_detail->{'error'}{'message'}
                        // $err_detail->{'error'};
                }
            }
            last INFERENCE_LOOP;
        }

        my $decoded = eval { $json->decode( $http_response->content ) };
        if ($@) {
            $http_error = sprintf 'json decode error: %s',
                <[base.str.eval_error]>;
            last INFERENCE_LOOP;
        }

        unless ( ref($decoded) eq qw| HASH | && $decoded->{'choices'} ) {
            $http_error = 'unexpected response format';
            last INFERENCE_LOOP;
        }

        my $choice  = $decoded->{'choices'}[0];
        my $message = $choice->{'message'} // {};
        $finish_reason_val = $choice->{'finish_reason'} // 'stop';

        ## check for tool calls ##
        if (    $finish_reason_val eq 'tool_calls'
            and ref $message->{'tool_calls'} eq qw| ARRAY |
            and $message->{'tool_calls'}->@*
            and exists $code{'coding.tools.dispatch'} ) {
            $tool_round++;

            ## append assistant message with tool calls to conversation ##
            push @messages, $message;

            ## dispatch each tool call ##
            for my $tc ( $message->{'tool_calls'}->@* ) {
                my $tool_name = $tc->{'function'}->{'name'} // '?';

                <[base.logs]>->(
                    1, "[process-queued-task] tool call round=%d: %s",
                    $tool_round, $tool_name
                );

                my $tool_result = $code{'coding.tools.dispatch'}->($tc);

                ## append tool result as tool role message ##
                push @messages,
                    {
                    'role'         => 'tool',
                    'tool_call_id' => $tc->{'id'}               // '',
                    'content'      => $tool_result->{'content'} // '',
                    };
            }

            <[base.logs]>->(
                2,
                "[process-queued-task] tool round %d complete, %d calls dispatched",
                $tool_round,
                scalar $message->{'tool_calls'}->@*
            );

            ## yield to event loop between tool rounds ##
            ## allows network commands [ show-buffer, get-result ] to be ##
            ## processed while inference is running ##
            <[event.once]>->(0.0007);

            next INFERENCE_LOOP;
        }

        ## normal completion — extract response text ##
        $response_text = $message->{'content'} // '';

        ## accumulate partial content from tool rounds ##
        if ( $tool_round > 0 ) {
            <[base.logs]>->(
                1,
                "[process-queued-task] completed after %d tool rounds, %d chars",
                $tool_round,
                length($response_text)
            );
        } else {
            <[base.logs]>->(
                1,
                "[process-queued-task] inference success: %d chars, finish_reason=%s",
                length($response_text),
                $finish_reason_val
            );
        }

        ## store finish_reason on task so completion chain can read it ##
        my $t = <coding.task.queue>->{$task_id};
        $t->{'execution'}->{'finish_reason'} = $finish_reason_val
            if defined $t;

        last INFERENCE_LOOP;
    }

    if ( $tool_round > $max_tool_rounds ) {
        $http_error = "tool call loop exceeded $max_tool_rounds rounds";
    }
};

$http_error //= <[base.str.eval_error]> if $@;    ## capture eval die ##

if ( defined $http_error ) {
    my $err_short
        = <[base.parser.center_ellipse_string]>->( $http_error, 72 );
    <[base.logs]>->(
        0, "[process-queued-task] inference error: %s", $err_short
    );
    return { success => FALSE, error => $http_error, task_id => $task_id };
}

## store result in inference cache ##
if ( length $response_text
    and exists $code{'plugin.storage.inference.store'} ) {
    my $store_result = $code{'plugin.storage.inference.store'}->(
        {   'question'      => $prompt,
            'response'      => $response_text,
            'model'         => $model_id,
            'temperature'   => $temperature,
            'seed'          => $server_seed,
            'finish_reason' => $finish_reason_val,
        }
    );

    if ( ref $store_result eq qw| HASH |
        and $store_result->{'mode'} eq qw| true | ) {
        <[base.logs]>->(
            2,
            "[process-queued-task] cached → branch=%s result=%s",
            $store_result->{'data'}{'branch'} // '?',
            substr( $store_result->{'data'}{'result'} // '', 0, 12 )
        );
    }
}

## return result hashref for jobqueue callback ##
return { success => TRUE, result => $response_text, task_id => $task_id };

