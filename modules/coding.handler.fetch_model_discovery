## [:< ##

# name  = coding.handler.fetch_model_discovery
# descr = timer handler: request model discovery from models zenka at startup

## send async request to models zenka - guaranteed online via dependency
my $cmd_count = <[base.protocol-7.command.send.local]>->(
    {   'command'   => 'models.cmd.discover',
        'call_args' => { 'args' => 'available' },
        'reply'     => {
            'handler' => 'coding.handler.models_discover_reply',
            'params'  => { 'context' => 'init' }
        }
    }
);

if ($cmd_count) {
    <[base.logs]>->( 2, 'model discovery request sent to models zenka' );
} else {
    <[base.logs]>->( 1, 'models zenka offline during discovery request' );
}

