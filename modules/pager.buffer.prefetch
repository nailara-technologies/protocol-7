## [:< ##

# name  = pager.buffer.prefetch
# descr = Predictive page prefetching

my ($args) = @ARG;

my $buffer_id = $args->{'buffer_id'};
my $page_num  = $args->{'page_num'};
my $direction = $args->{'direction'} // 'forward';
my $depth     = $args->{'depth'}     // 2;

my $buf = $data{'pager'}{'buffers'}{$buffer_id};
return unless $buf;

# Don't prefetch if cache is near full
my $cached    = $buf->{'pages'}{'cached'};
my $max_cache = $buf->{'pages'}{'max_cache'};
return if scalar( keys %$cached ) >= $max_cache - 1;

my @to_fetch;

# Linear prefetch in scroll direction
for my $i ( 1 .. $depth ) {
    my $target
        = $direction eq 'forward'
        ? $page_num + $i
        : $page_num - $i;
    next if $target < 0;
    push @to_fetch, $target unless exists $cached->{$target};
}

# Prefetch "jump targets" if user has patterns
if ( $buf->{'access_pattern'}{'end_jumps'} ) {

    # Prefetch near end if user jumps there often
    my $estimated_pages = _estimate_total_pages($buf);
    push @to_fetch, $estimated_pages - 1
        if $estimated_pages && !exists $cached->{ $estimated_pages - 1 };
}

# Limit prefetch to available cache slots
my $available = $max_cache - scalar( keys %$cached ) - 1;
@to_fetch = @to_fetch[ 0 .. $available - 1 ] if @to_fetch > $available;

# Async load (non-blocking)
for my $prefetch_page (@to_fetch) {
    $buf->{'stats'}{'prefetches'}++;

    # Load in background - simplified: just queue for next cycle
    # In full implementation, could use async I/O
    $buf->{'prefetch_queue'}{$prefetch_page} = 1;
}

return scalar(@to_fetch);

# Estimate total pages from what we've seen
sub _estimate_total_pages {
    my ($buf) = @ARG;

    if ( $buf->{'source'}{'total'} ) {
        return int( $buf->{'source'}{'total'} / $buf->{'pages'}{'size'} ) + 1;
    }

    # Estimate based on items seen
    return undef unless $buf->{'stats'}{'items_seen'} > 0;

    # Conservative estimate: what we've seen is just the beginning
    return
        int( $buf->{'stats'}{'items_seen'} * 2 / $buf->{'pages'}{'size'} )
        + 1;
}

