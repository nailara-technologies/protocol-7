## [:< ##

# name  = ascii.frame.render.color
# descr = apply p7 ansi color codes to a rendered ascii frame by character class

my $input = shift // return undef;

return $input if not length $input;

## load and cache color config from cfg/ascii-frame ##
if ( not exists <ascii.frame.color.cfg> ) {
    <ascii.frame.color.cfg> = <[base.load_section_conf]>->('ascii-frame')
        // {};
}

my $cfg         = <ascii.frame.color.cfg>;
my $color_root  = $cfg->{'colors'}         // {};
my $fill_cfg    = $color_root->{'fill'}    // {};
my $bracket_cfg = $color_root->{'bracket'} // {};
my $corner_cfg  = $color_root->{'corner'}  // {};
my $content_cfg = $color_root->{'content'} // {};

## resolve config color names to ansi codes via %colors package hash ##
my %A;
$A{'fill_colon'}  = $colors{ $fill_cfg->{'single'}   // 'p7_fg_0000' } // '';
$A{'fill_double'} = $colors{ $fill_cfg->{'double'}   // 'p7_fg_0001' } // '';
$A{'fill_dot'}    = $colors{ $fill_cfg->{'dot'}      // 'p7_fg_0001' } // '';
$A{'fill_eq'}     = $colors{ $fill_cfg->{'equals'}   // 'p7_fg_0002' } // '';
$A{'br_char'}     = $colors{ $bracket_cfg->{'char'}  // 'p7_fg_0000' } // '';
$A{'br_label'}    = $colors{ $bracket_cfg->{'label'} // 'p7_fg_0004' } // '';
$A{'soft'}        = $colors{ $corner_cfg->{'soft'}   // 'p7_fg_0001' } // '';
$A{'anchor'}      = $colors{ $corner_cfg->{'anchor'} // 'p7_fg_0000' } // '';
$A{'value'}       = $colors{ $content_cfg->{'value'} // 'p7_fg_0004' } // '';
$A{'label'}       = $colors{ $content_cfg->{'label'} // 'p7_fg_0001' } // '';

my $anchor_bold = $corner_cfg->{'anchor.bold'} ? "\e[1m" : '';
my $RESET       = "\e[0m";

## if no colors are populated [ non-interactive ] : return input unchanged ##
my $any_color = 0;
for my $code ( values %A ) { $any_color = 1, last if length $code; }
return $input if not $any_color;

## split into lines preserving empties ##
my @lines = split m{\n}, $input, -1;

## split off any uniform leading-whitespace margin per line : classify and ##
## colorize the border/content SHAPE, then re-apply the margin verbatim so ##
## an outer frame margin never poisons side / corner detection             ##
my @indent;
my @body;
for my $i ( 0 .. $#lines ) {
    if ( $lines[$i] =~ m{^(\s*)(.*)$} ) {
        ( $indent[$i], $body[$i] ) = ( $1, $2 );
    } else {
        ( $indent[$i], $body[$i] ) = ( '', $lines[$i] );
    }
}

## identify border lines : strip bracketed regions first, then measure     ##
## structural density on the remainder. position-independent [ works on    ##
## composite output where nested frame top-borders sit mid-stream ] and    ##
## avoids false positives from content rows carrying inline [brackets] — a ##
## top border diluted by a text slot still resolves to a border            ##
my %is_border;
for my $i ( 0 .. $#body ) {
    my $line = $body[$i];
    next if not length $line;
    ( my $bare = $line ) =~ s{\[[^\]]*\]}{}g;
    my $bare_len = length $bare;
    my $sc       = 0;
    $sc++ while $bare =~ m{[:.,#=]}g;
    my $density = $bare_len > 0 ? $sc / $bare_len : 0;
    $is_border{$i} = 1 if $density >= 0.5 or $line =~ m{^#};
}

my @out;
for my $i ( 0 .. $#body ) {
    my $colored;
    if ( $is_border{$i} ) {
        $colored = <[ascii.frame.render.color.border_line]>->(
            $body[$i], \%A, $anchor_bold, $RESET
        );
    } else {
        $colored = <[ascii.frame.render.color.content_line]>->(
            $body[$i], \%A, $RESET
        );
    }
    push @out, $indent[$i] . $colored;
}

return join "\n", @out;

