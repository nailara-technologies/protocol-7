## [:< ##

# name  = letsencr.child.generate_csr
# descr = generate Certificate Signing Request (CSR) for certificate issuance

my $domains = shift;    # arrayref of domains

return undef unless $domains && @$domains;

<[base.log]>->( 2, 'generating certificate signing request (CSR)' );

my $primary_domain = $domains->[0];

## Generate new certificate key (RSA 2048-bit) matching account key algorithm
<[base.log]>->( 2, 'generating certificate key (RSA 2048-bit)...' );

my ( $key_fh, $key_file ) = tempfile( UNLINK => 1 );
system(
    "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out '$key_file' 2>/dev/null"
);

unless ( -f $key_file && -s $key_file ) {
    <[base.log]>->( 1, 'error: failed to generate RSA 2048-bit key' );
    return undef;
}

open( my $kfh, '<', $key_file ) or return undef;
local $/;
my $key_pem = <$kfh>;
close($kfh);

<[base.log]>->( 2, 'generating CSR...' );

## Create openssl config for CSR with SAN extension
my ( $conf_fh, $conf_file ) = tempfile( UNLINK => 1 );
print $conf_fh <<"EOF";
[req]
distinguished_name = req_distinguished_name
req_extensions = v3_req
prompt = no

[req_distinguished_name]
C = US
ST = State
L = City
O = Organization
CN = $primary_domain

[v3_req]
EOF

if ( @$domains > 1 ) {
    my $san_string = join( ', ', map {"DNS:$_"} @$domains );
    print $conf_fh "subjectAltName = $san_string\n";
}

close($conf_fh);

## Generate CSR using openssl
my ( $csr_fh, $csr_file ) = tempfile( UNLINK => 1 );
system(
    "openssl req -new -key '$key_file' -out '$csr_file' -config '$conf_file' 2>/dev/null"
);

unless ( -f $csr_file && -s $csr_file ) {
    <[base.log]>->( 1, 'error: failed to generate CSR' );
    return undef;
}

open( my $cfh, '<', $csr_file ) or return undef;
local $/;
my $csr_pem = <$cfh>;
close($cfh);

<[base.log]>->( 2, 'CSR generated successfully' );

## Extract DER and encode for ACME submission
my ( $der_fh, $der_file ) = tempfile( UNLINK => 1 );
system(
    "openssl req -in '$csr_file' -outform DER -out '$der_file' 2>/dev/null");

open( my $dfh, '<:raw', $der_file ) or return undef;
local $/;
my $csr_der = <$dfh>;
close($dfh);

my $csr_b64url = <[letsencr.child.encode_base64url]>->($csr_der);

## Store in child state
<letsencr.child.current_csr> = {
    pem        => $csr_pem,
    der        => $csr_der,
    b64url     => $csr_b64url,
    domains    => $domains,
    created_at => time(),
};

## Store certificate key in child state (will be saved to disk after cert issued)
<letsencr.child.cert_key> = { pem => $key_pem, };

return {
    csr_pem    => $csr_pem,
    csr_b64url => $csr_b64url,
    key_pem    => $key_pem,
    domains    => $domains,
};

