            ## At or past end of buffer
            print "\e[K";
        }

        $prev_cursor_pos = $cursor_pos;
        $display_buffer  = '';    ## User is editing, clear display buffer
    } elsif ( $edit_result->{action}
        =~ m{^(kill_to_end|kill_from_start|kill_word|yank)$} ) {
        ## Full line redraw for all buffer modifications - ensures clean rendering
        my $cursor_pos = $editor->{cursor_pos};
