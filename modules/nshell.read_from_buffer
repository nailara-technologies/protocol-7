        ## Reset attributes and reapply text color
        ## (terminal cursor is now after the cursor character)
        print "\e[0m" . $colors{p7_fg_0004};

        ## Print everything after cursor (terminal cursor is in the right position now)
        if ( $cursor_pos < length($buffer) ) {
            my $after_cursor = substr( $buffer, $cursor_pos + 1 );
            print $after_cursor if length($after_cursor);

            ## Clear from current position to end of line
            print "\e[K";

            ## Backspace to position cursor correctly before the next character
            print "\x08" x length($after_cursor) if length($after_cursor);
        } else {
            ## At or past end of buffer
            print "\e[K";
        }

        $prev_cursor_pos = $cursor_pos;
        $display_buffer  = '';    ## User is editing, clear display buffer
    } elsif ( $edit_result->{action} eq qw| newline | ) {
        ## Clear cursor before printing newline
        my $cursor_pos = $editor->{cursor_pos};
        my $buffer     = $editor->{buffer};
        my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';

        ## Go to start of line, then to cursor position, then clear cursor
        print "\r";
        if ( $cursor_pos > 0 ) {
            print substr( $buffer, 0, $cursor_pos );
        }

        if ( $char_at_cursor eq '' or $char_at_cursor eq ' ' ) {
            ## Cursor was rendered as underscore, erase it
            print "\e[K";
        } else {
            ## Cursor was rendered as inverse video character
            ## Reprint the character without inverse to overwrite the inverted display
            print $colors{p7_fg_0004} . $char_at_cursor;
        }

        ## Reset all attributes and apply text color
        print "\e[0m" . $colors{p7_fg_0004};

        ## Now print the newline
        print $edit_result->{output};
        STDOUT->flush();

        my $result = AMOS7::TERM::editor_submit($editor);
        $display_buffer   = '';
        $debug_cmd_buffer = '';    ## Clear any partial debug command

        ## Save to history if not empty
        if ( length $result ) {
            my @lines = split "\n", $result;
            AMOS7::TERM::history_add(@lines);
        }

        ## Trigger cursor display after newline (whether command is empty or not)
        ## This handles both: empty Enter and Enter with command output
        $show_cursor_on_call = TRUE;

        ## If there's a command result, return it (which will trigger shell_loop -> hook -> cursor)
        if ( length $result ) {
            return $result;
        }

        ## For empty line, trigger watcher immediately to show cursor
        my ($session_id) = keys <user.cube.session>->%*;
        if ( defined $session_id and defined $data{'session'}{$session_id} ) {
            my $session = $data{'session'}{$session_id};
            if ( defined $session->{'watcher'}{'stdin_handler'} ) {
                $session->{'watcher'}{'stdin_handler'}->now();
            }
        }

        next;    ## Continue to next buffered character
    } elsif ( $edit_result->{action} eq qw| signal | ) {
        ## Clear cursor before sending signal, preserve buffer content
        ## User may want to exit shell with history command visible for copy-paste
        my $cursor_pos = $editor->{cursor_pos};
        my $buffer     = $editor->{buffer};
        my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';

        ## Go to start of line, clear any cursor remnants, then print buffer
        print "\r\e[K" . $colors{p7_fg_0004} . $buffer . " ";
        STDOUT->flush();

        ## Clear the buffer flag so term_restore doesn't try to clean up
        ## We've already printed the buffer on screen for copy-paste
        delete $data{'nshell'}{'current_buffer'};

        ## Send signal to current process
        my $sig = $edit_result->{should_signal} // 'INT';
        kill( $sig, $$ );
        next;    ## Continue to next buffered character
    }

    ## For 'none' action, just continue

}    ## End of while ( length $input_chars ) loop

return undef;    ## No complete line yet, buffer exhausted or incomplete UTF-8

