# name = nshell.read_from_buffer
# descr = Orchestrator for keyboard input - delegates to refactored handler modules

## Non-blocking keyboard input with buffered I/O
## Delegates to specialized modules: history navigation, search, editor
## Returns complete line when user presses Enter
## Persists state across calls (static variables)

## Initialize refactored state structure on first call
state $state_ref           = undef;
state $input_chars         = '';
state $show_cursor_on_call = TRUE;

## Get state reference (initialize on first call)
if ( !defined $state_ref ) {
    $state_ref = <[nshell.state.init]>->();
}

## Sync state to %data for debugging
$main::data{'nshell'}{'edit_state'} = {
    current_history_index => $state_ref->{current_history_index},
    display_buffer        => $state_ref->{display_buffer},
    search_mode           => $state_ref->{search_mode},
};

## Show cursor at start of each call (after command execution or on first call)
if ($show_cursor_on_call) {
    $show_cursor_on_call = FALSE;

    ## Load colors if not already loaded
    if ( !keys %{ $state_ref->{colors} } ) {
        eval { %{ $state_ref->{colors} } = %{<nshell.colors>} };
        $state_ref->{colors}->{p7_fg_0003}
            //= $AMOS7::TERM::p7_colors{'p7_fg_0003'};
        $state_ref->{colors}->{p7_fg_0004}
            //= $AMOS7::TERM::p7_colors{'p7_fg_0004'};
        $state_ref->{editor} //= AMOS7::TERM::editor_init();
        AMOS7::TERM::cursor_set_color( $state_ref->{colors}->{p7_fg_0003} );
    }

    ## Display cursor
    print $state_ref->{colors}->{p7_fg_0003} . '_' . "\e[0m"
        . $state_ref->{colors}->{p7_fg_0004};
    STDOUT->flush();

    return undef;    ## Return to event loop to display cursor before input
}

## Input reading: TTY vs piped
if ( -t STDIN ) {
    ## TTY input: use sysread with non-blocking mode
    if ( !length $input_chars ) {
        my $read_size = 1024;
        while (1) {
            my $bytes_read = sysread( STDIN, my $chunk, $read_size );
            if ( defined $bytes_read && $bytes_read > 0 ) {
                $input_chars .= $chunk;
            } else {
                last;
            }
        }
        return undef if !length $input_chars;
    }
} else {
    ## Piped input: use line-oriented reading
    if ( !length $input_chars ) {
        my $line = <STDIN>;
        $input_chars = $line // '';
        return undef if !length $input_chars;
    }
}

## Load colors if needed for key processing
if ( !keys %{ $state_ref->{colors} } ) {
    eval { %{ $state_ref->{colors} } = %{<nshell.colors>} };
    $state_ref->{colors}->{p7_fg_0003}
        //= $AMOS7::TERM::p7_colors{'p7_fg_0003'};
    $state_ref->{colors}->{p7_fg_0004}
        //= $AMOS7::TERM::p7_colors{'p7_fg_0004'};
    $state_ref->{editor} //= AMOS7::TERM::editor_init();
}

## Process all buffered characters
while ( length $input_chars ) {
    my $key = <[nshell.util.extract_utf8_char]>->( \$input_chars );
    last if not defined $key;

    ## Accumulate escape sequences
    if ( $key eq "\e" ) {
        $state_ref->{escape_buffer} = $key;
        for ( my $i = 0; $i < 20; $i++ ) {
            ## Check if we need more input
            if ( !length $input_chars && -t STDIN ) {
                my $bytes_read = sysread( STDIN, $input_chars, 64 );
                last if not defined $bytes_read or $bytes_read <= 0;
            }
            last if not length $input_chars;

            my $next_key = substr( $input_chars, 0, 1, '' );
            $state_ref->{escape_buffer} .= $next_key;

            ## Check if sequence is complete (arrow, page, function keys)
            last
                if $state_ref->{escape_buffer}
                =~ m{\e\[[A-Z]|\eO[A-Z]|\e\[[0-9;]*~$};
        }
        $key = $state_ref->{escape_buffer};
        $state_ref->{escape_buffer} = '';
    }

    ## Convert Home/End keys to Ctrl+A/Ctrl+E for editor processing
    if ( $key eq "\e[H" or $key eq "\e[1~" or $key eq "\eOH" ) {
        $key = "\x01";    ## Home → Ctrl+A
    } elsif ( $key eq "\e[F" or $key eq "\e[4~" or $key eq "\eOF" ) {
        $key = "\x05";    ## End → Ctrl+E
    }

    ## In search mode: delegate to search handler
    if ( $state_ref->{search_mode} ) {
        my $result = <[nshell.search.handler]>->(
            $state_ref, $key, \$input_chars, $state_ref->{editor},
            $state_ref->{colors}
        );
        ## Handle return codes from search handler
        if ( $result == 1 ) {
            ## Exit search mode (Ctrl+C/Esc) - buffer already loaded
            next;
        } elsif ( $result == 2 ) {
            ## Selected command - return it for execution
            my $selected = $state_ref->{editor}->{buffer} // '';
            return $selected if length($selected);
        }
        ## $result == 0 or any other value: continue in search mode
        next;
    }

    ## In viewing history mode: handle navigation keys
    if ( $state_ref->{current_mode} == 2 ) {    # VIEWING_HISTORY
        if ( $key eq "\e[A" ) {
            <[nshell.history.arrow_up]>->(
                $state_ref, $state_ref->{editor}, $state_ref->{colors}
            );
            next;
        } elsif ( $key eq "\e[B" ) {
            <[nshell.history.arrow_down]>->(
                $state_ref, $state_ref->{editor}, $state_ref->{colors}
            );
            next;
        } elsif ( $key eq "\e[5~" ) {
            <[nshell.history.page_up]>->(
                $state_ref, $state_ref->{editor}, $state_ref->{colors}
            );
            next;
        } elsif ( $key eq "\e[6~" ) {
            <[nshell.history.page_down]>->(
                $state_ref, $state_ref->{editor}, $state_ref->{colors}
            );
            next;
        }
    }

    ## In normal mode: special key handling
    if ( $state_ref->{current_mode} == 0 ) {    # NORMAL
        if ( $key eq "\x12" ) {                 # Ctrl+R
            $state_ref->{search_mode}       = TRUE;
            $state_ref->{current_mode}      = 1;      # SEARCHING
            $state_ref->{pre_search_buffer} = $state_ref->{editor}->{buffer}
                // '';
            $state_ref->{search_term}    = '';
            $state_ref->{search_results} = [];
            $state_ref->{search_index}   = 0;
            print "\r\e[K(search) \e[0m";
            STDOUT->flush();
            next;
        } elsif ( $key eq "\e[5~" ) {
            <[nshell.history.page_up]>->(
                $state_ref, $state_ref->{editor}, $state_ref->{colors}
            );
            next;
        } elsif ( $key eq "\e[6~" ) {
            <[nshell.history.page_down]>->(
                $state_ref, $state_ref->{editor}, $state_ref->{colors}
            );
            next;
        } elsif ( $key eq "\e[A" ) {
            <[nshell.history.arrow_up]>->(
                $state_ref, $state_ref->{editor}, $state_ref->{colors}
            );
            next;
        } elsif ( $key eq "\e[B" ) {
            <[nshell.history.arrow_down]>->(
                $state_ref, $state_ref->{editor}, $state_ref->{colors}
            );
            next;
        }
    }

    ## All other keys: delegate to editor.process
    my $result = <[nshell.editor.process]>->(
        $state_ref->{editor}, $key, $state_ref->{colors}
    );

    ## Check for state change when exiting history mode
    if ( defined $result && $state_ref->{current_mode} == 2 ) {
        $state_ref->{current_mode}          = 0;    # Return to NORMAL
        $state_ref->{current_history_index} = -1;
    }

    ## Return command if submitted
    return $result if defined $result;
}

return undef;

