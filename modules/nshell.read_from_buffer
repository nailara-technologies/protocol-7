# name = nshell.read_from_buffer
# descr = Non-blocking keyboard input with line accumulation

## Reads one character at a time with very short timeout
## Returns complete line when user presses Enter
## Persists buffer across calls (static variable)

state $command_buffer = '';

## Non-blocking read with 0 timeout (immediate)
my $key = Term::ReadKey::ReadKey(-1);

return undef if not defined $key;  ## No input available

if ( $key eq "\n" or $key eq "\r" ) {
    print "\n" if length $command_buffer;
    my $result = $command_buffer;
    $command_buffer = '';
    return $result;
} elsif ( $key eq "\x03" ) {  ## Ctrl-C
    print "^C\n";
    $command_buffer = '';
    return undef;
} elsif ( $key eq "\x04" ) {  ## Ctrl-D (EOF)
    return undef;
} elsif ( $key eq "\x08" or $key eq "\x7f" ) {  ## Backspace/Delete
    if ( length $command_buffer ) {
        chop($command_buffer);
        print "\x08 \x08";
    }
} elsif ( length $key and ord($key) >= 32 ) {  ## Printable
    $command_buffer .= $key;
    print $key;  ## Echo
}

return undef;  ## Partial input, keep accumulating

