## [:< ##

# name = nshell.read_from_buffer
# descr = Non-blocking keyboard input with buffered I/O (no XS dependencies)

## Reads multiple bytes at once with sysread, processes character by character
## Returns complete line when user presses Enter
## Persists buffer across calls (static variable)
## Supports history navigation with arrow keys and Page Up/Down
## Uses AMOS7::TERM editor for text editing operations

state $editor           = undef;   ## Editor state reference
state $escape_buffer    = '';
state $display_buffer   = '';      ## Current display (may be from history)
state $debug_cmd_buffer = '';      ## Accumulate potential debug command :CMD:
state $input_chars      = ''; ## Character buffer for both TTY and piped input
state %colors           = (); ## Color palette (lazily loaded)
state $prev_cursor_pos
    = 0;    ## Previous cursor position for clearing old cursor
state $show_cursor_on_call = TRUE;  ## Show cursor at start of each call

## Show cursor at start of each call (after command execution or on first call)
if ( $show_cursor_on_call ) {
    $show_cursor_on_call = FALSE;

    ## Load colors if not already loaded
    if ( !%colors ) {
        eval { %colors = %{<nshell.colors>} };
        $colors{p7_fg_0003} //= $AMOS7::TERM::p7_colors{'p7_fg_0003'};
        $colors{p7_fg_0004} //= $AMOS7::TERM::p7_colors{'p7_fg_0004'};
        $editor //= AMOS7::TERM::editor_init();
        AMOS7::TERM::cursor_set_color( $colors{p7_fg_0003} );
    }

    ## Display cursor
    print $colors{p7_fg_0003} . '_' . "\e[0m" . $colors{p7_fg_0004};
    STDOUT->flush();

    return undef;  ## Return to event loop to display cursor before input
}

## Get one character from buffer, refilling via sysread if needed
my $key;
my $command_buffer;

if ( -t STDIN ) {
    ## TTY input: use sysread with non-blocking mode [STDIN in binary mode
    ## from nshell.init_code]
    if ( !length $input_chars ) {
        ## Drain all available data in non-blocking mode using while loop
        my $read_size  = 1024;
        my $total_read = 0;
        while (1) {
            my $bytes_read = sysread( STDIN, my $chunk, $read_size );
            if ( defined $bytes_read && $bytes_read > 0 ) {
                $input_chars .= $chunk;
                $total_read += $bytes_read;
            } else {
                last;    ## No more data available (non-blocking) or EOF
            }
        }
        return undef if !length $input_chars;    ## No data at all
    }
} else {
    ## Piped input: use line-oriented reading
    if ( !length $input_chars ) {
        my $line = <STDIN>;
        $input_chars = $line // '';
        return undef if !length $input_chars;
    }
}

## Process all buffered characters in a loop to prevent event loop starvation
while ( length $input_chars ) {
    my $key = _extract_utf8_char( \$input_chars );
    last if not defined $key; ## Incomplete UTF-8 sequence, wait for more data

    ## Load colors early if not already loaded (needed for all key processing)
    if ( !%colors ) {
        ## Try to get colors from Protocol-7 context if available
        eval { %colors = %{<nshell.colors>} };

        ## Fallback to Protocol-7 official colors from AMOS7::TERM
        ## p7_fg_0003 = phosphor green (cursor), p7_fg_0004 = TRUE blue (text)
        $colors{p7_fg_0004} //= $AMOS7::TERM::p7_colors{'p7_fg_0004'};
        $colors{p7_fg_0003} //= $AMOS7::TERM::p7_colors{'p7_fg_0003'};

        ## Set cursor to phosphor green
        AMOS7::TERM::cursor_set_color( $colors{p7_fg_0003} );

        ## Initialize editor if not already done
        $editor //= AMOS7::TERM::editor_init();
    }

## Helper: extract a complete UTF-8 character (may be 1-4 bytes)
    sub _extract_utf8_char {    ### extract subroutine ### [LLL]
        my ($buf_ref) = @ARG;
        return undef if !length($$buf_ref);

        my $first_byte = ord( substr( $$buf_ref, 0, 1 ) );
        my $seq_len    = 1;

        ## Determine UTF-8 sequence length from first byte
        if ( ( $first_byte & 0xE0 ) == 0xC0 ) {  ## 110xxxxx - 2 byte sequence
            $seq_len = 2;
        } elsif ( ( $first_byte & 0xF0 ) == 0xE0 )
        {                                        ## 1110xxxx - 3 byte sequence
            $seq_len = 3;
        } elsif ( ( $first_byte & 0xF8 ) == 0xF0 )
        {                                        ## 11110xxx - 4 byte sequence
            $seq_len = 4;
        }
        ## else: 0xxxxxxx (ASCII) - already $seq_len = 1

        ## Extract the complete sequence (or what we have)
        return substr( $$buf_ref, 0, $seq_len, '' );
    }

## Helper: write bytes ensuring complete write (syswrite may be partial)
    sub _syswrite_complete {    ### extract subroutine ## [LLL]
        my ( $fh, $data ) = @ARG;
        my $total   = length($data);
        my $written = 0;

        while ( $written < $total ) {
            my $n = syswrite( $fh, $data, $total - $written, $written );
            last if !defined $n or $n <= 0;
            $written += $n;
        }
        return $written;
    }

    ## If we got ESC, keep reading to complete the escape sequence
    if ( $key eq "\e" ) {
        $escape_buffer = $key;

        ## Accumulate more characters to complete escape sequence
        my $seq_complete = 0;
        for ( my $i = 0; $i < 20 && !$seq_complete; $i++ ) {
            ## Check if we need more input
            if ( !length $input_chars && -t STDIN ) {
                my $bytes_read = sysread( STDIN, $input_chars, 64 );
                last if not defined $bytes_read or $bytes_read <= 0;
            }
            last if not length $input_chars;

            my $next_key = substr( $input_chars, 0, 1, '' );
            $escape_buffer .= $next_key;

            ## Check if sequence is complete (arrow keys or function keys)
            ## Matches: \e[A-Z (like arrow keys), \eOA-Z (alternate arrow), \e[...~ (function keys with any modifiers)
            $seq_complete = TRUE if $escape_buffer =~ m{\e\[[A-Z]|\eO[A-Z]|\e\[[0-9;]*~$};
        }

        ## Initialize editor early if needed (before loading history)
        $editor //= AMOS7::TERM::editor_init();

        ## Now process the complete escape sequence
        if ( $escape_buffer eq "\e[A" ) {
            my $lines_ref = AMOS7::TERM::history_up();
            if ( defined $lines_ref ) {
                ## Clear previous display before showing new one
                my $clear_len = length($display_buffer) + 8;
                print "\r" . ( ' ' x $clear_len ) . "\r" if $clear_len > 0;

                $display_buffer = join "\n", $lines_ref->@*;
                $command_buffer = $display_buffer;

                ## Store recalled buffer for terminal restore on Ctrl+C
                $data{'nshell'}{'current_buffer'} = $command_buffer;

                ## Load into editor to sync editor buffer with loaded history
                AMOS7::TERM::editor_load( $editor, $command_buffer );

                $display_buffer = $colors{'p7_fg_0004'} . $display_buffer;
                <[nshell.redraw_command_line]>->(
                    $command_buffer, $display_buffer
                );

                ## Render cursor at editor's position
                ## Terminal is already at end of buffer after redraw_command_line
                ## Just move back if cursor is not at end, then render cursor
                my $cursor_pos = $editor->{cursor_pos};
                my $buffer     = $editor->{buffer};
                my $buf_len    = length($buffer);
                my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';

                ## Move back to cursor position (if not at end)
                if ( $cursor_pos < $buf_len ) {
                    my $moves_back = $buf_len - $cursor_pos;
                    print "\x08" x $moves_back;
                }

                ## Render cursor at current position
                if ( $char_at_cursor eq '' or $char_at_cursor eq ' ' ) {
                    print $colors{p7_fg_0003} . '_';
                } else {
                    print "\e[7m" . $char_at_cursor . "\e[27m";
                }

                print "\e[0m" . $colors{p7_fg_0004};
                print "\e[K";
            }
        } elsif ( $escape_buffer eq "\e[B" ) {
            my $lines_ref = AMOS7::TERM::history_down();
            if ( defined $lines_ref ) {
                ## Clear previous display before showing new one
                my $clear_len = length($display_buffer) + 8;
                print "\r" . ( ' ' x $clear_len ) . "\r" if $clear_len > 0;

                $display_buffer = join "\n", $lines_ref->@*;
                $command_buffer = $display_buffer;

                ## Store recalled buffer for terminal restore on Ctrl+C
                $data{'nshell'}{'current_buffer'} = $command_buffer;

                ## Load into editor to sync editor buffer with loaded history
                AMOS7::TERM::editor_load( $editor, $command_buffer );

                $display_buffer = $colors{'p7_fg_0004'} . $display_buffer;
                <[nshell.redraw_command_line]>->(
                    $command_buffer, $display_buffer
                );

                ## Render cursor at editor's position
                ## Terminal is already at end of buffer after redraw_command_line
                ## Just move back if cursor is not at end, then render cursor
                my $cursor_pos = $editor->{cursor_pos};
                my $buffer     = $editor->{buffer};
                my $buf_len    = length($buffer);
                my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';

                ## Move back to cursor position (if not at end)
                if ( $cursor_pos < $buf_len ) {
                    my $moves_back = $buf_len - $cursor_pos;
                    print "\x08" x $moves_back;
                }

                ## Render cursor at current position
                if ( $char_at_cursor eq '' or $char_at_cursor eq ' ' ) {
                    print $colors{p7_fg_0003} . '_';
                } else {
                    print "\e[7m" . $char_at_cursor . "\e[27m";
                }

                print "\e[0m" . $colors{p7_fg_0004};
                print "\e[K";
            } else {
                my $clear_len = length($display_buffer) + 8;
                print "\r" . ( ' ' x $clear_len ) . "\r";
                $display_buffer = '';
                $command_buffer = '';

                ## Clear editor when reaching new command position
                AMOS7::TERM::editor_reset($editor);

                ## Render cursor at start of new empty line
                print $colors{p7_fg_0003} . '_' . "\e[0m" . $colors{p7_fg_0004};
            }
        } elsif ( $escape_buffer eq "\e[5~" ) {
            my $lines_ref = AMOS7::TERM::history_page_up();
            if ( defined $lines_ref ) {
                ## Clear previous display before showing new one
                my $clear_len = length($display_buffer) + 8;
                print "\r" . ( ' ' x $clear_len ) . "\r" if $clear_len > 0;

                $display_buffer = join "\n", $lines_ref->@*;
                $command_buffer = $display_buffer;

                ## Store recalled buffer for terminal restore on Ctrl+C
                $data{'nshell'}{'current_buffer'} = $command_buffer;

                ## Load into editor to sync editor buffer with loaded history
                AMOS7::TERM::editor_load( $editor, $command_buffer );

                $display_buffer = $colors{'p7_fg_0004'} . $display_buffer;
                <[nshell.redraw_command_line]>->(
                    $command_buffer, $display_buffer
                );

                ## Render cursor at editor's position
                ## Terminal is already at end of buffer after redraw_command_line
                ## Just move back if cursor is not at end, then render cursor
                my $cursor_pos = $editor->{cursor_pos};
                my $buffer     = $editor->{buffer};
                my $buf_len    = length($buffer);
                my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';

                ## Move back to cursor position (if not at end)
                if ( $cursor_pos < $buf_len ) {
                    my $moves_back = $buf_len - $cursor_pos;
                    print "\x08" x $moves_back;
                }

                ## Render cursor at current position
                if ( $char_at_cursor eq '' or $char_at_cursor eq ' ' ) {
                    print $colors{p7_fg_0003} . '_';
                } else {
                    print "\e[7m" . $char_at_cursor . "\e[27m";
                }

                print "\e[0m" . $colors{p7_fg_0004};
                print "\e[K";
            }
        } elsif ( $escape_buffer eq "\e[6~" ) {
            my $lines_ref = AMOS7::TERM::history_page_down();
            if ( defined $lines_ref ) {
                ## Clear previous display before showing new one
                my $clear_len = length($display_buffer) + 8;
                print "\r" . ( ' ' x $clear_len ) . "\r" if $clear_len > 0;

                $display_buffer = join "\n", $lines_ref->@*;
                $command_buffer = $display_buffer;

                ## Store recalled buffer for terminal restore on Ctrl+C
                $data{'nshell'}{'current_buffer'} = $command_buffer;

                ## Load into editor to sync editor buffer with loaded history
                AMOS7::TERM::editor_load( $editor, $command_buffer );

                $display_buffer = $colors{'p7_fg_0004'} . $display_buffer;
                <[nshell.redraw_command_line]>->(
                    $command_buffer, $display_buffer
                );

                ## Render cursor at editor's position
                ## Terminal is already at end of buffer after redraw_command_line
                ## Just move back if cursor is not at end, then render cursor
                my $cursor_pos = $editor->{cursor_pos};
                my $buffer     = $editor->{buffer};
                my $buf_len    = length($buffer);
                my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';

                ## Move back to cursor position (if not at end)
                if ( $cursor_pos < $buf_len ) {
                    my $moves_back = $buf_len - $cursor_pos;
                    print "\x08" x $moves_back;
                }

                ## Render cursor at current position
                if ( $char_at_cursor eq '' or $char_at_cursor eq ' ' ) {
                    print $colors{p7_fg_0003} . '_';
                } else {
                    print "\e[7m" . $char_at_cursor . "\e[27m";
                }

                print "\e[0m" . $colors{p7_fg_0004};
                print "\e[K";
            } else {
                my $clear_len = length($display_buffer) + 8;
                print "\r" . ( ' ' x $clear_len ) . "\r";
                $display_buffer = '';
                $command_buffer = '';

                ## Clear editor when reaching new command position
                AMOS7::TERM::editor_reset($editor);

                ## Render cursor at start of new empty line
                print $colors{p7_fg_0003} . '_' . "\e[0m" . $colors{p7_fg_0004};
            }
        } elsif ( $escape_buffer eq "\e[H" or $escape_buffer eq "\e[1~" or $escape_buffer eq "\eOH" ) {
            ## Home key (multiple variants) - map to Ctrl+A (move to start of line)
            $key           = "\x01";  ## Ctrl+A
            $escape_buffer = '';
            ## Fall through to editor processing below
        } elsif ( $escape_buffer eq "\e[F" or $escape_buffer eq "\e[4~" or $escape_buffer eq "\eOF" ) {
            ## End key (multiple variants) - map to Ctrl+E (move to end of line)
            $key           = "\x05";  ## Ctrl+E
            $escape_buffer = '';
            ## Fall through to editor processing below
        } elsif ( $escape_buffer eq "\e[C" ) {
            ## Right arrow - pass to editor for cursor movement
            $key           = $escape_buffer;
            $escape_buffer = '';
            ## Fall through to editor processing below
        } elsif ( $escape_buffer eq "\e[D" ) {
            ## Left arrow - pass to editor for cursor movement
            $key           = $escape_buffer;
            $escape_buffer = '';
            ## Fall through to editor processing below
        } elsif ( $escape_buffer eq "\e[3~" ) {
            ## Delete key - pass to editor for forward delete
            $key           = $escape_buffer;
            $escape_buffer = '';
            ## Fall through to editor processing below
        } else {
            ## Unknown escape sequence
            $escape_buffer = '';
            next;
        }

        ## If we got left/right arrows or delete, fall through to editor processing
        ## Otherwise continue to next character
        if ( length $escape_buffer ) {
            ## History sequence was handled, continue
            next;
        }

        ## Left/right/delete: continue to editor processing with $key set
    }

    ## Handle potential debug command: :COMMAND: or :COMMAND:N:
    ## Accumulate into separate buffer until we know if it's a valid pattern
    ## Only start if we're NOT in an escape sequence
    if ( $key eq ':' && !length $escape_buffer && !length $debug_cmd_buffer )
    {
        $debug_cmd_buffer = ':';
        ## Don't echo the opening colon yet, continue to next buffered
        ## character
        next;
    } elsif ( length $debug_cmd_buffer ) {
        $debug_cmd_buffer .= $key;

        if ( $key eq ':' ) {
            ## Try to parse as debug command :UP: :DOWN: :PAGE_DOWN:..
            if ( $debug_cmd_buffer =~ m,^:([A-Z_]+(?::\d+)?):$, ) {
                my $cmd_with_count = $1;
                my ( $cmd, $repeat_count )
                    = $cmd_with_count =~ m,^([A-Z_]+)(?::(\d+))?$,;
                $repeat_count //= 1;

                ## Check if this is a valid debug command
                if ( defined $cmd
                    && $cmd =~ m,^(UP|DOWN|PAGE_UP|PAGE_DOWN)$, ) {
                    ## Valid debug command - execute without echoing
                    my $history_result;
                    for ( my $i = 0; $i < $repeat_count; $i++ ) {
                        if ( $cmd eq qw| UP | ) {
                            $history_result = AMOS7::TERM::history_up();
                        } elsif ( $cmd eq qw| DOWN | ) {
                            $history_result = AMOS7::TERM::history_down();
                        } elsif ( $cmd eq qw| PAGE_UP | ) {
                            $history_result = AMOS7::TERM::history_page_up();
                        } elsif ( $cmd eq qw| PAGE_DOWN | ) {
                            $history_result
                                = AMOS7::TERM::history_page_down();
                        }
                        ## Don't continue looping if we hit a boundary (undef result)
                        last if !defined $history_result;
                    }

                    ## Replace command_buffer with history result
                    if ( defined $history_result ) {
                        $command_buffer = join "\n", $history_result->@*;
                        $display_buffer = $command_buffer;
                    }

                    $debug_cmd_buffer = '';
                    ## Don't echo anything, continue to next buffered
                    ## character
                    next;
                }
            }

            ## Not a valid debug command - echo the whole accumulated buffer
            print $debug_cmd_buffer;
            $command_buffer .= $debug_cmd_buffer;
            $debug_cmd_buffer = '';
            $display_buffer   = '';
            next;    ## Continue to next buffered character
        } elsif ( length $debug_cmd_buffer > 20 ) {
            ## Too long to be a debug command, flush it
            print $debug_cmd_buffer;
            $command_buffer .= $debug_cmd_buffer;
            $debug_cmd_buffer = '';
            $display_buffer   = '';
            next;    ## Continue to next buffered character
        }
        ## Still accumulating potential debug command, continue to next
        ## buffered character
        next;
    }

    ## Initialize editor on first key
    $editor //= AMOS7::TERM::editor_init();

    ## Process key through editor
    my $edit_result
        = AMOS7::TERM::editor_process_key( $editor, $key, %colors );

    if ( $edit_result->{action} eq qw| echo | ) {
        ## Full line redraw for character insertion - ensures clean rendering
        my $cursor_pos = $editor->{cursor_pos};
        my $buffer     = $editor->{buffer};

        ## Store current buffer in global data for terminal restore on exit
        $data{'nshell'}{'current_buffer'} = $buffer;

        ## Go to start of line
        print "\r";

        ## Print everything before cursor
        if ( $cursor_pos > 0 ) {
            print substr( $buffer, 0, $cursor_pos );
        }

        ## Render cursor inline without cursor_render's trailing backspace
        ## This avoids the positioning issues that come from the backspace
        my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';

        if ( $char_at_cursor eq '' or $char_at_cursor eq ' ' ) {
            ## At end or on space: print colored underscore (terminal cursor advances past it)
            print $colors{p7_fg_0003} . '_';
        } else {
            ## On a character: print with inverse video
            ## (stands out from both text and cursor color)
            print "\e[7m" . $char_at_cursor . "\e[27m";
        }

        ## Reset attributes and reapply text color
        ## (terminal cursor is now after the cursor character)
        print "\e[0m" . $colors{p7_fg_0004};

        ## Print everything after cursor (terminal cursor is in the right position now)
        if ( $cursor_pos < length($buffer) ) {
            my $after_cursor = substr( $buffer, $cursor_pos + 1 );
            print $after_cursor if length($after_cursor);

            ## Clear from current position to end of line
            print "\e[K";

            ## Backspace to position cursor correctly before the next character
            print "\x08" x length($after_cursor) if length($after_cursor);
        } else {
            ## At or past end of buffer
            print "\e[K";
        }

        $prev_cursor_pos = $cursor_pos;
        $display_buffer  = '';    ## User is editing, clear display buffer
    } elsif ( $edit_result->{action} eq qw| backspace |
        or $edit_result->{action} eq qw| delete | ) {
        ## Full line redraw for deletion operations - ensures clean rendering
        my $cursor_pos = $editor->{cursor_pos};
        my $buffer     = $editor->{buffer};

        ## Store current buffer in global data for terminal restore on exit
        $data{'nshell'}{'current_buffer'} = $buffer;

        ## Go to start of line
        print "\r";

        ## Print everything before cursor
        if ( $cursor_pos > 0 ) {
