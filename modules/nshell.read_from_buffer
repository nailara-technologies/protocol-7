## [:< ##

# name = nshell.read_from_buffer
# descr = Orchestrator for keyboard input - delegates to
#         refactored handler modules

## Non-blocking keyboard input with buffered I/O  Delegates to specialized
## modules: history navigation, search, editor Returns complete line when user
## presses Enter  Persists state across calls (static variables)

## Get shared nshell state reference (initialized in nshell.init_code)
state $state_ref           = <nshell.state>;
state $input_chars         = '';
state $show_cursor_on_call = TRUE;

## Sync state to %data for debugging
$main::data{'nshell'}{'edit_state'} = {
    current_history_index => $state_ref->{'current_history_index'},
    display_buffer        => $state_ref->{'display_buffer'},
    search_mode           => $state_ref->{'search_mode'},
};

## show cursor at start of each call  (after command execution or on first
## call)
if ($show_cursor_on_call) {
    $show_cursor_on_call = FALSE;

    $state_ref->{'editor'}
        //= <[editor.control.create]>->(<[nshell.editor.default_schema]>);
    AMOS7::TERM::cursor_set_color( $colors{'p7_fg_0003'} );

    ## [ check if we need to display a preloaded entry from ctrl+o cycle ]
    if ( $state_ref->{'display_preloaded_entry'} ) {
        $state_ref->{'display_preloaded_entry'} = FALSE;
        ## [ display the preloaded buffer with cursor ]
        my $buffer = <[editor.control.get_value]>->(
            $state_ref->{'editor'}, 'command'
        ) // '';
        utf8::encode($buffer);    ## char state -> byte view for the log
        if (<nshell.mode.no_tty_debug>) {
            <[base.logs]>->(
                2,       "[ preload display: buffer='%s' color_0004='%s' ]",
                $buffer, $colors{'p7_fg_0004'} // '<undef>'
            );
        }
        ## [ recover terminal state after raw-ANSI reply with no trailing
        ## newline ]
        if ( $state_ref->{'needs_newline_prefix'} ) {
            print "\n\n";
            delete $state_ref->{'needs_newline_prefix'};
        }
        ## [ clear line and render preloaded entry ]
        ## [ \r\e[2K avoids wrap on long lines, matches arrow handler behavior
        ## ]
        print "\r\e[2K";
        $state_ref->{'view_offset'} = 0;
        <[nshell.render.viewport]>->( $state_ref->{'editor'}, \%colors );
    } else {
        ## recover terminal state after raw-ANSI reply with no trailing
        ## newline
        if ( $state_ref->{'needs_newline_prefix'} ) {
            print "\n\n";
            delete $state_ref->{'needs_newline_prefix'};
        }
        ## Just display cursor on empty line
        print $colors{'p7_fg_0003'} . "_\r" . "\e[0m" . $colors{'p7_fg_0004'};
        STDOUT->flush();
    }

    return undef;    ## Return to event loop to display cursor before input
}

## Input reading: debug buffer, TTY, or piped
if ( <nshell.mode.no_tty_debug> && length <nshell.buffer.debug_input> ) {
    ## Debug mode: adopt data from alternate debug input buffer
    if ( !length $input_chars ) {
        $input_chars = <nshell.buffer.debug_input>;

        ## clear the buffer for next input,  pausing watcher to prevent
        ## re-triggering
        <nshell.watcher.buffer.debug_input>->stop;     ## pause watcher ##
        <nshell.buffer.debug_input> = '';              ## clear buffer ##
        <nshell.watcher.buffer.debug_input>->start;    ## resume watcher ##

        return undef if !length $input_chars;
    }
} elsif ( -t STDIN ) {
    ## TTY input: use sysread with non-blocking mode
    if ( !length $input_chars ) {
        my $read_size = 1024;
        while (1) {
            my $bytes_read = sysread( STDIN, my $chunk, $read_size );
            if ( defined $bytes_read && $bytes_read > 0 ) {
                $input_chars .= $chunk;
            } else {
                last;
            }
        }
        return undef if !length $input_chars;
    }
} else {
    ## Piped input: use line-oriented reading
    if ( !length $input_chars ) {
        my $line = <STDIN>;
        $input_chars = $line // '';
        return undef if !length $input_chars;
    }
}

$state_ref->{'editor'}
    //= <[editor.control.create]>->(<[nshell.editor.default_schema]>);

## Process all buffered characters
while ( length $input_chars ) {
    my $key = <[nshell.util.extract_utf8_char]>->( \$input_chars );
    last if not defined $key;

    ## Accumulate escape sequences
    if ( $key eq "\e" ) {
        $state_ref->{'escape_buffer'} = $key;
        for ( my $i = 0; $i < 20; $i++ ) {
            ## Check if we need more input
            if ( !length $input_chars && -t STDIN ) {
                my $bytes_read = sysread( STDIN, $input_chars, 64 );
                last if not defined $bytes_read or $bytes_read <= 0;
            }
            last if not length $input_chars;

            my $next_key = substr( $input_chars, 0, 1, '' );
            $state_ref->{'escape_buffer'} .= $next_key;

            ## Check if sequence is complete (arrow, page, function keys)
            last
                if $state_ref->{'escape_buffer'}
                =~ m{\e\[[A-Z]|\eO[A-Z]|\e\[[0-9;]*~$};
        }
        $key = $state_ref->{'escape_buffer'};
        $state_ref->{'escape_buffer'} = '';
    }

    ## Convert Home/End keys to Ctrl+A/Ctrl+E for editor processing
    if ( $key eq "\e[H" or $key eq "\e[1~" or $key eq "\eOH" ) {
        $key = "\x01";    ## Home → Ctrl+A
    } elsif ( $key eq "\e[F" or $key eq "\e[4~" or $key eq "\eOF" ) {
        $key = "\x05";    ## End → Ctrl+E
    }

    ## normalize SS3 arrow keys [ \eOA .. \eOD ] to their CSI form [ \e[A ..
    ## \e[D ] : some terminals send SS3 when application cursor key mode [
    ## DECCKM ] is on -- every dispatch site below only ever matches CSI, same
    ## reasoning as the Home/End normalization above
    state %ss3_arrow_map = (
        "\eOA" => "\e[A",
        "\eOB" => "\e[B",
        "\eOC" => "\e[C",
        "\eOD" => "\e[D",
    );
    $key = $ss3_arrow_map{$key} // $key;

    ## In search mode: delegate to search handler
    if ( $state_ref->{'search_mode'} ) {
        my $result = <[nshell.search.handler]>->(
            $state_ref, $key, \$input_chars,
            $state_ref->{'editor'},
            $state_ref->{'colors'}
        );
        ## Handle return codes from search handler
        if ( $result == 1 ) {
            ## Exit search mode (Ctrl+C/Esc) - buffer already loaded
            next;
        } elsif ( $result == 2 ) {
            ## Selected command - return it for execution
            my $selected = <[editor.control.get_value]>->(
                $state_ref->{'editor'}, 'command'
            ) // '';
            ## returned command crosses back into the byte world [ execution ]
            ## — same bytes as the old path
            utf8::encode($selected);

            ## Clear editor buffer for next command  [ per-field reset: clears
            ## text/cursor but NOT kill_buffer, matching the two old direct
            ## writes exactly ]
            <[editor.control.reset]>->( $state_ref->{'editor'}, 'command' );

            ## Set flag to redraw cursor on next call after reply arrives
            $show_cursor_on_call = TRUE;

            return $selected if length($selected);
        }
        ## $result == 0 or any other value: continue in search mode
        next;
    }

    ## In viewing history mode: handle navigation keys
    if ( $state_ref->{'current_mode'} == 2 ) {    # VIEWING_HISTORY
        ## Execute and advance forward (Ctrl+O)
        if ( $key eq "\x0f" ) {                   # Ctrl+O
            if (<nshell.mode.no_tty_debug>) {
                <[base.logs]>->(
                    1,
                    "ctrl_o: key received in VIEWING_HISTORY mode, index=%s",
                    $state_ref->{'current_history_index'}
                );
            }

            ## Only process if we have a valid history entry
            if ( defined $state_ref->{'current_history_index'}
                && $state_ref->{'current_history_index'} >= 0 ) {

                my $result = <[nshell.handler.ctrl_o_cycle]>->($state_ref);

                if ( defined $result ) {
                    if (<nshell.mode.no_tty_debug>) {
                        <[base.logs]>->(
                            1, "ctrl_o: handler returned result, length=%s",
                            length($result)
                        );
                    }
                    $show_cursor_on_call = TRUE;
                    return $result;
                }
            } else {
                if (<nshell.mode.no_tty_debug>) {
                    <[base.log]>->(
                        1, "ctrl_o: skipping - index undefined or negative"
                    );
                }
            }
            next;
        }

        ## [ reset ctrl+o cycle on manual navigation ]
        if ( $key eq "\e[A" or $key eq "\e[B" ) {    # [ up or down arrow ]
            $state_ref->{'ctrl_o_start_position'} = -1;
            $state_ref->{'ctrl_o_entries_added'}  = 0;
            ## [ fall through to existing arrow handling ]
        }

        if ( $key eq "\e[A" ) {
            <[nshell.history.arrow_up]>->(
                $state_ref,
                $state_ref->{'editor'},
                $state_ref->{'colors'}
            );
            next;
        } elsif ( $key eq "\e[B" ) {
            <[nshell.history.arrow_down]>->(
                $state_ref,
                $state_ref->{'editor'},
                $state_ref->{'colors'}
            );
            next;
        } elsif ( $key eq "\e[5~" ) {
            <[nshell.history.page_up]>->(
                $state_ref,
                $state_ref->{'editor'},
                $state_ref->{'colors'}
            );
            next;
        } elsif ( $key eq "\e[6~" ) {
            <[nshell.history.page_down]>->(
                $state_ref,
                $state_ref->{'editor'},
                $state_ref->{'colors'}
            );
            next;
        }
    }

    ## In normal mode: special key handling
    if ( $state_ref->{'current_mode'} == 0 ) {    # NORMAL
        ## Ctrl+O in normal mode: ignore [ only works in history mode ]
        if ( $key eq "\x0f" ) {                   # Ctrl+O
            next;
        }

        if ( $key eq "\x12" ) {                   # Ctrl+R
            $state_ref->{'search_mode'}  = TRUE;
            $state_ref->{'current_mode'} = 1;      # SEARCHING
            $state_ref->{'pre_search_buffer'}
                = <[editor.control.get_value]>->(
                $state_ref->{'editor'}, 'command'
                ) // '';
            ## kept character-based: only ever round-trips back into the
            ## editor via load_field on search exit, never printed
            $state_ref->{'search_term'}    = '';
            $state_ref->{'search_results'} = [];
            $state_ref->{'search_index'}   = 0;

            ## Render initial search prompt with correct formatting
            print "\r\e[K" . $colors{'p7_fg_0003'} . "[search:  ] ";
            STDOUT->flush();
            next;
        } elsif ( $key eq "\e[5~" ) {
            <[nshell.history.page_up]>->(
                $state_ref,
                $state_ref->{'editor'},
                $state_ref->{'colors'}
            );
            next;
        } elsif ( $key eq "\e[6~" ) {
            <[nshell.history.page_down]>->(
                $state_ref,
                $state_ref->{'editor'},
                $state_ref->{'colors'}
            );
            next;
        } elsif ( $key eq "\e[A" ) {
            <[nshell.history.arrow_up]>->(
                $state_ref,
                $state_ref->{'editor'},
                $state_ref->{'colors'}
            );
            next;
        } elsif ( $key eq "\e[B" ) {
            <[nshell.history.arrow_down]>->(
                $state_ref,
                $state_ref->{'editor'},
                $state_ref->{'colors'}
            );
            next;
        }
    }

    ## All other keys: delegate to editor.process
    my $result = <[nshell.editor.process]>->(
        $state_ref->{'editor'},
        $key, $state_ref->{'colors'}
    );

    if (<nshell.mode.no_tty_debug>) {
        <[base.buffer.add_line]>->(
            qw| no-tty-debug |,
            sprintf(
                "editor.process key=%s result=%s",
                ( $key eq "\n"    ? "NEWLINE"     : "'$key'" ),
                ( defined $result ? "YES:$result" : "UNDEF" )
            )
        );
    }

    ## [ check for state change when exiting history mode ]
    if ( defined $result && $state_ref->{'current_mode'} == 2 ) {
        <[base.buffer.add_line]>->(
            qw| no-tty-debug |,
            "exiting VIEWING_HISTORY, returning to NORMAL"
        ) if <nshell.mode.no_tty_debug>;
        $state_ref->{'current_mode'}          = 0;    # [ return to normal ]
        $state_ref->{'current_history_index'} = -1;
        $state_ref->{'display_buffer'}        = '';
        $state_ref->{'ctrl_o_start_position'} = -1;
        $state_ref->{'ctrl_o_entries_added'}  = 0;
    }

    ## Return command if submitted
    if ( defined $result ) {
        <[base.buffer.add_line]>->(
            qw| no-tty-debug |,
            "COMMAND COMPLETE: returning result=$result"
        ) if <nshell.mode.no_tty_debug>;
        ## Set flag to redraw cursor on next call after reply arrives
        $show_cursor_on_call = TRUE;
        return $result;
    }
}

return undef;

