# name = coding.callback.object.inference_server
# descr = dependency callback to check if inference server is HTTP ready

my $object_id = shift;
return undef if not exists <dependency.object>->{$object_id};

my $object = <dependency.object>->{$object_id};

## check if permanently failed [ flagged by monitor_inference_startup ] ##
if ( $object->{'failed'} ) {
    <[base.logs]>->(
        1,
        "[dep_check] backend=%s dependency marked as failed: %s",
        $object->{'backend'} // 'unknown',
        $object->{'error'}   // 'unknown error'
    );
    return FALSE;
}

my $backend = $object->{'backend'} // 'gpu';

## read server status set by monitor_inference_startup [ non-blocking ] ##
my $server = ( <coding.inference_servers> // {} )->{$backend};

return undef unless defined $server;    ## not spawned yet ##

my $status = $server->{'status'} // 'starting';

return FALSE if $status eq qw| crashed |;
return TRUE  if $status eq qw| ready |;
return undef;                           ## still starting ##

