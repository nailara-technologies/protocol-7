## [:< ##

# name  = plugin.web.space.grid
# descr = return current grid state as html fragment for template embedding

my $section = shift // qw| summary |;

## ensure cache and config exist [ init_code may not have run ] ##
eval {
    <web.space.grid.cache> //= {
        qw| target_dir | => qw| unknown |,
        qw| file_count | => 0,
        qw| cells      | => [],
        qw| timestamp  | => 0,
        qw| ttl        | => 60,
    };
    <web.space.grid.cfg.ttl>        //= 60;
    <web.space.grid.cfg.target_dir> //= qw| data/md/design |;
};
return sprintf '<!-- grid init error: %s -->', $@ if $@;

my $cache = <web.space.grid.cache>;
my $ttl   = <web.space.grid.cfg.ttl> // 60;

## trigger re-scan if cache is stale or empty ##
my $age = time() - ( $cache->{'timestamp'} // 0 );
if ( $age > $ttl or not @{ $cache->{'cells'} // [] } ) {
    my $scan_ok = eval { <[plugin.web.space.grid.scan]>; 1 };
    return sprintf '<!-- grid scan error: %s -->', $@ if not $scan_ok;
    $cache = <web.space.grid.cache>;
    $age   = time() - ( $cache->{'timestamp'} // 0 );
}

my $target_dir = $cache->{'target_dir'} // qw| unknown |;
my $file_count = $cache->{'file_count'} // 0;
my $cells      = $cache->{'cells'}      // [];
my $timestamp  = $cache->{'timestamp'}  // 0;

## summary section : default ##
if ( $section eq qw| summary | ) {

    my @lines;
    push @lines, '<div class="space-state">';
    push @lines,
          sprintf '  <div class="state-row">'
        . '<span class="label">target dir</span>'
        . '<span class="value">%s</span></div>', $target_dir;
    push @lines,
          sprintf '  <div class="state-row">'
        . '<span class="label">file count</span>'
        . '<span class="value">%s</span></div>', $file_count;
    push @lines,
          sprintf '  <div class="state-row">'
        . '<span class="label">cache age</span>'
        . '<span class="value">%ds</span></div>', $age;
    push @lines, '</div>';

    return join( "\n", @lines );

} elsif ( $section eq qw| json | ) {

    ## json wrapped in script tag : for inline javascript consumption ##
    my $payload = {
        qw| target_dir | => $target_dir,
        qw| file_count | => $file_count,
        qw| cells      | => $cells,
        qw| timestamp  | => $timestamp,
    };
    my $json = eval { JSON::XS::encode_json($payload) } // '{}';
    return sprintf '<script>window.spaceGrid = %s;</script>', $json;

} elsif ( $section eq qw| json-raw | ) {

    ## raw json : for api endpoints with content-type override ##
    my $payload = {
        qw| target_dir | => $target_dir,
        qw| file_count | => $file_count,
        qw| cells      | => $cells,
        qw| timestamp  | => $timestamp,
    };
    return eval { JSON::XS::encode_json($payload) } // '{}';

} else {

    return sprintf '<!-- unknown grid section: %s -->', $section;
}

