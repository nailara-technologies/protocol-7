## [:< ##

# name  = v7.callback.stdout_log_rotate
# descr = rotates stdout log when it exceeds max size

use Fcntl qw| O_WRONLY O_APPEND |;

my $log_path = <v7.stdout_log.path> // return FALSE;
my $log_fh   = <v7.stdout_log.fh>   // return FALSE;

my $max_size  = <v7.stdout_log.max_size>;
my $rotate_to = <v7.stdout_log.rotate_to>;
my $check_mod = <v7.stdout_log.check_every> // 113;

## only check every N writes to avoid stat() overhead ##
<v7.stdout_log.write_count>++;
return TRUE if <v7.stdout_log.write_count> % $check_mod != 0;

my $size = -s $log_path // 0;
return TRUE if $size < $max_size;

## need to rotate - read and truncate ##
<[base.logs]>->( 2, ': rotating stdout log [size: %d ]', $size );

## close, trim, reopen atomically ##
close($log_fh)
    or <[base.s_warn]>->( 'close log for rotate : %s', <[base.str.os_err]> );

## read last $rotate_to bytes ##
if ( open( my $read_fh, qw| < |, $log_path ) ) {
    binmode( $read_fh, qw| :raw | );

    my $seek_pos = $size > $rotate_to ? $size - $rotate_to : 0;
    sysseek( $read_fh, $seek_pos, 0 ) or goto ROTATE_FAIL;

    my $buffer;
    my $read_len = sysread( $read_fh, $buffer, $rotate_to );
    close($read_fh);

    if ( defined $read_len and $read_len > 0 ) {
        ## write trimmed content back ##
        if ( open( my $write_fh, qw| > |, $log_path ) ) {
            binmode( $write_fh, qw| :raw | );
            syswrite( $write_fh, $buffer )
                or <[base.s_warn]>->('rotate write failed');
            close($write_fh);
        }
    }
}

ROTATE_FAIL:

## reopen in append mode ##
sysopen( $log_fh, $log_path, O_WRONLY | O_APPEND, 0600 )
    or do {
    <[base.logs]>->(
        0, ': cannot reopen stdout log : %s',
        <[base.str.os_err]>
    );
    <v7.stdout_log.fh> = undef;
    return FALSE;
    };
$log_fh->autoflush(1);
<v7.stdout_log.fh> = $log_fh;

return TRUE;

