## [:< ##

# name = content.check_queued

return if not exists <content.items_queued> or !<content.items_queued>;

# LLL: quick and dirty version ... clean up!

<[base.log]>->( 1, "found queued items, reloading playlist..." );

my $playlist_file = <content.file_name>;
<[content.load_file]>->($playlist_file);

