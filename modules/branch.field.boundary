## [:< ##

# name  = branch.field.boundary
# descr = return boundary value for named axis
# param = id, [ axis_name ]
#
# default axis if only one axis exists
# returns undef if not found or ambiguous

my ( $id, $axis_name ) = @ARG;

return undef
    if not defined $id
    or not exists $data{'branch.field'}{$id};

my $axes  = $data{'branch.field'}{$id}{'axes'} // {};
my @names = keys %$axes;

return undef unless @names;

if ( not defined $axis_name or not length $axis_name ) {
    return undef if @names > 1;
    $axis_name = $names[0];
}

return undef unless exists $axes->{$axis_name};

return $axes->{$axis_name}{'boundary'} // 0;

