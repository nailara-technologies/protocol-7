## [:< ##

# name  = powershell.cmd.display-switch-toggle
# descr = re-push host display topology [ internal+extend ]

## fixes weston/WSLg retaining stale per-output placement state after a     ##
## monitor disappears - confirmed live: a monitor-count drop without this   ##
## leaves windows unable to be placed anywhere within the now-removed       ##
## monitor's former Y-range. see X-11.handler.screen_change, the caller.    ##

my $out
    = <[powershell.exec]>
    ->(   'DisplaySwitch.exe /internal; Start-Sleep -Milliseconds 400; '
        . 'DisplaySwitch.exe /extend' );

return { 'mode' => qw| false |, 'data' => 'powershell.exec failed' }
    if not defined $out;

return { 'mode' => qw| true |, 'data' => 'display switch toggled' };

