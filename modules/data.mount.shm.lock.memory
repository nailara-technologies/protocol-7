## [:< ##

# name = data.mount.shm.lock.memory
# descr = Lock SHM segment in memory (prevent swap to disk)

# thin zenka wrapper -> AMOS7::SHM::lock_memory [ zero behavior change ;
# the ported body was already zenka-agnostic pure perl ]

my ( $mmap_ref, $offset, $length ) = @ARG;

return AMOS7::SHM::lock_memory( $mmap_ref, $offset, $length );

