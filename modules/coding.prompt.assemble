## [:< ##

# name  = coding.prompt.assemble
# descr = build inference message array from task [ single source of truth ]

my $task = shift // {};

## parse query for backend/model prefix ##
my $raw_type = $task->{'metadata'}->{'raw_request'}->{'type'}        // '';
my $raw_desc = $task->{'metadata'}->{'raw_request'}->{'description'} // '';

my $parsed;
if ( $raw_type =~ m{^(cpu|gpu)$}i ) {
    $parsed = {
        backend => lc($raw_type),
        model   => undef,
        query   => $raw_desc
    };
} else {
    my $raw_prompt = $task->{'request'}->{'description'} // '';

    ## b32-transport path stores bytes without utf8 flag : re-decode before use ##
    utf8::decode($raw_prompt)
        if not utf8::is_utf8($raw_prompt)
        and utf8::valid($raw_prompt);

    ## append task context if provided ##
    my $task_context = $task->{'context'} // $task->{'request'}->{'context'}
        // '';
    if ( length $task_context ) {
        $raw_prompt .= "\n\n" . $task_context;
    }

    $parsed = <[coding.parser.query_prefix]>->($raw_prompt);
}

## :model:AMOS:ID: keyword : task-level model override, stripped from prompt ##
## allows task files to be self-describing: ":model:WZIZD6Y:2BIZKWY:" ##
if ( $parsed->{'query'} =~ s{:model:([A-Z2-7]{7}:[A-Z2-7]{7}):}{}i ) {
    $parsed->{'model'} //= $1;  ## don't override an explicit GPU:M: prefix ##
    $parsed->{'query'} =~ s{^\s+}{};
    <[base.logs]>->(
        2, ':. prompt.assemble: :model: override → %s',
        $parsed->{'model'}
    );
}

## select best available backend ##
my $backend_info = <[coding.routing.select_backend]>->(
    {   backend         => $parsed->{'backend'},
        preferred_model => $parsed->{'model'}
    }
);

## start with clean query [ prefix stripped ] ##
my $prompt = $parsed->{'query'};

## enrich prompt with module content for review and explain tasks ##
## skip enrichment when a specialized template handles context loading ##
my $skip_enrich = 0;
if (exists $code{'coding.context.read_module'}
    and $prompt =~ m{(?:review|explain|check|analyze)\s+
                     (?:modules?[/\s]+)?
                     ([\w][\w.\-]+[\w])}xi
) {
    my $enrich_module = $1;

    ## check if this word matches a template name : if so, the template ##
    ## handles its own context, skip inline enrichment ##
    my $root    = <system.root_path>;
    my $tpl_dir = "$root/"
        . ( <context.cfg.template_dir> // 'data/yaml/context-templates' );
    my $hyph_name = $enrich_module;
    $hyph_name =~ s|\.|-|g;
    if (   -f "$tpl_dir/$enrich_module.yaml"
        or -f "$tpl_dir/$hyph_name.yaml" ) {
        $skip_enrich = 1;
        <[base.logs]>->(
            2,
            ':. prompt.assemble: skip enrich, template handles context [ %s ]',
            $enrich_module
        );
    }

    if ( not $skip_enrich ) {
        my $read_result = $code{'coding.context.read_module'}
            ->( { 'module' => $enrich_module, 'max_chars' => 6000 } );
        if ( ref $read_result eq qw| HASH |
            and $read_result->{'mode'} eq qw| true | ) {
            my $mod = $read_result->{'data'};
            $prompt
                .= sprintf "\n\n"
                . ".:[ module content : %s ]:.\n"
                . ".:[ descr = %s ]:.\n"
                . ".:[ %d lines ]:.\n\n%s",
                $mod->{'module'},
                $mod->{'descr'} || '?',
                $mod->{'lines'},
                $mod->{'content'};
            <[base.logs]>->(
                1, ':. prompt.assemble: enriched with %s [ %d chars ]',
                $mod->{'module'}, $mod->{'chars'}
            );
        }
    }
}

## collect tool definitions early [ needed for template context ] ##
my $tools;
if ( exists $code{'coding.tools.definitions'} ) {
    $tools = $code{'coding.tools.definitions'}->();
    if ( ref $tools eq qw| ARRAY | and $tools->@* ) {
        <[base.logs]>->(
            2,
            ':. prompt.assemble: %d tools available',
            scalar $tools->@*
        );
    } else {
        $tools = undef;
    }
}

## build template context for condition evaluation ##
my $task_type = $task->{'metadata'}->{'raw_request'}->{'type'} // 'review';

## dynamic template selection from prompt ##
## check if prompt references a known template name ##
## skip for no-tools single-round tasks [ utility inference, summarization ] ##
my $selected_template = 'system-default';
if ( $task->{'no_tools'} and ( $task->{'max_rounds'} // 99 ) <= 1 ) {
    $selected_template = 'system-tools';    ## minimal context, no template ##
    goto TEMPLATE_SELECTED;
}

## auto-select model-selection template when self_select_model is set ##
my $self_select = $task->{'self_select_model'}
    // $task->{'metadata'}->{'raw_request'}->{'self_select_model'} // 0;
if ($self_select) {
    $selected_template = 'system-model-select';
    <[base.logs]>->(
        1, ':. prompt.assemble: self_select_model → system-model-select'
    );
    goto TEMPLATE_SELECTED;
}

my $target_module = '';

if ( exists $code{'context.template.load'} ) {
    my $root         = <system.root_path>;
    my $template_dir = "$root/"
        . ( <context.cfg.template_dir> // 'data/yaml/context-templates' );

    ## first: check if task_type itself is a template [ e.g. improve-system-prompt ] ##
    if ( $task_type =~ m{^[\w-]+$} ) {
        my $type_template_path = "$template_dir/$task_type.yaml";
        if ( -f $type_template_path && $task_type !~ m{^system-} ) {
            $selected_template = $task_type;
            <[base.logs]>->(
                1,
                ':. prompt.assemble: matched template from task_type [ %s ]',
                $task_type
            );
        }
    }

    ## extract candidate words from prompt ##
    my @words = $prompt =~ m{([\w][\w-]*[\w])}g;

    ## check each word against template files ##
    ## longer matches first [ self-improve before self ] ##
    ## skip if already matched from task_type ##
    for my $candidate ( sort { length($b) <=> length($a) } @words ) {
        last if $selected_template ne 'system-default';
        next if $candidate =~ m{^system-};    ## skip system templates ##
        my $tpl_path = "$template_dir/$candidate.yaml";
        if ( -f $tpl_path ) {
            $selected_template = $candidate;
            <[base.logs]>->(
                1, ':. prompt.assemble: matched template [ %s ]', $candidate
            );
            last;
        }
    }

    ## also try hyphenated versions of dot-notation words ##
    if ( $selected_template eq 'system-default' ) {
        for my $candidate (@words) {
            my $hyph = $candidate;
            $hyph =~ s|\.|-|g;
            next if $hyph eq $candidate;
            next if $hyph =~ m{^system-};
            my $tpl_path = "$template_dir/$hyph.yaml";
            if ( -f $tpl_path ) {
                $selected_template = $hyph;
                <[base.logs]>->(
                    1,
                    ':. prompt.assemble: matched template [ %s ] via dot→hyphen',
                    $hyph
                );
                last;
            }
        }
    }
}

TEMPLATE_SELECTED:

## extract target module from prompt [ for template vars ] ##
if ($prompt =~ m{(?:review|explain|check|analyze|fix)\s+
                   (?:modules?[/\s]+)?
                   ([\w][\w.\-]+[\w])}xi
) {
    my $candidate = $1;
    ## don't use template name as target module ##
    if ( $candidate ne $selected_template ) {
        $target_module = $candidate;
    }
}

## also extract target from second word after template name ##
if ( not length $target_module
    and $prompt =~ m{\Q$selected_template\E\s+([\w][\w.\-]+[\w])}i ) {
    $target_module = $1;
}

my $tpl_vars = {
    'task_type'         => $task_type,
    'task_summary'      => substr( $prompt, 0, 200 ),
    'target_module'     => $target_module,
    'selected_template' => $selected_template,
};
my $tpl_context = {
    'task_type'   => $task_type,
    'tools'       => ( defined $tools and $tools->@* )   ? 1 : '',
    'memory'      => exists $code{'context.memory.load'} ? 1 : '',
    'active_task' => '',
    'module'      => length($target_module) ? 1 : '',
};

<[base.logs]>->(
    2, ':. prompt.assemble: template=%s target=%s task_type=%s',
    $selected_template, $target_module || 'none', $task_type
);

## task-level custom system prompt overrides template + fallback ##
my @messages;
my $hooks = [];
if ( defined $task->{'system'} && length $task->{'system'} ) {
    push @messages, { 'role' => 'system', 'content' => $task->{'system'} };
    <[base.logs]>->(
        2,
        ':. prompt.assemble: using task-level system prompt [ %d chars ]',
        length $task->{'system'}
    );
}

## resolve system prompt via template or fallback ##

if ( !@messages && exists $code{'context.template.resolve'} ) {
    my $resolved = $code{'context.template.resolve'}->(
        {   'template' => $selected_template,
            'vars'     => $tpl_vars,
            'context'  => $tpl_context,
        }
    );

    if ( defined $resolved and length( $resolved->{'content'} // '' ) ) {
        push @messages,
            { 'role' => 'system', 'content' => $resolved->{'content'} };
        $hooks = $resolved->{'hooks'} // [];
        <[base.logs]>->(
            2,
            ':. prompt.assemble: template resolved [ %d chars, %d hooks ]',
            length( $resolved->{'content'} ),
            scalar $hooks->@*
        );
    }
}

## fallback to hardcoded system prompt ##
if ( !@messages and exists $code{'coding.system_prompt'} ) {
    my $sys_prompt = $code{'coding.system_prompt'}->();
    if ( defined $sys_prompt and length $sys_prompt ) {
        push @messages, { 'role' => 'system', 'content' => $sys_prompt };
        <[base.logs]>->(
            2, ':. prompt.assemble: fallback to coding.system_prompt'
        );
    }
}

push @messages, { 'role' => 'user', 'content' => $prompt };

<[base.logs]>->(
    2,
    ':. prompt.assemble: %d messages, %d chars user prompt',
    scalar @messages,
    length($prompt)
);

return {
    'prompt'       => $prompt,
    'messages'     => \@messages,
    'parsed'       => $parsed,
    'backend_info' => $backend_info,
    'tools'        => $tools,
    'hooks'        => $hooks,
};

