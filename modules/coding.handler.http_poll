## [:< ##

# name  = coding.handler.http_poll
# descr = timer-based polling handler for async HTTP socket reads
# purpose = replaces event.add_io watcher which fails to fire reliably for
#           round N+1 connections created inside timer/var-watcher callbacks

my $state     = shift->w->data;
my $sock      = $state->{'sock'};
my $callbacks = $state->{'callbacks'};

## socket already cleaned up ##
return unless defined $sock;

## try non-blocking read ##
my $buffer;
my $bytes = sysread( $sock, $buffer, 8192 );

<[base.logs]>->(
    3,
    "async.http_poll: sysread=%s",
    defined $bytes ? $bytes : "undef[$!]"
);

if ( !defined $bytes ) {
    if ( $!{EAGAIN} || $!{EWOULDBLOCK} ) {
        ## no data yet — reschedule poll ##
        my $next = <[event.add_timer]>->(
            {   'after'   => 0.05,
                'handler' => qw| coding.handler.http_poll |,
                'data'    => $state,
            }
        );
        $state->{'io_watcher'} = $next if defined $next;
        return;
    }
    ## real read error ##
    my $error = "Read error: $!";
    <[base.logs]>->( 0, "async.http_poll: %s", $error );
    $callbacks->{'on_error'}->($error) if exists $callbacks->{'on_error'};
    <[coding.async.http_cleanup]>->($state);
    return;
}

if ( $bytes == 0 )
{ ## LLL: since it is a poll watcher, it will inevitablt return 0 for 'noting yet'

    # goto POLL_AGAIN; ## testing ##

    ## EOF ##
    my $buf_len = length( $state->{'buffer'} );
    <[base.logs]>->(
        1, "http_poll : EOF : connection closed. [ total : %03d bytes ]",
        $buf_len
    );
    if ( length( $state->{'buffer'} ) ) {
        my $remaining = $state->{'buffer'};
        $remaining =~ s|\r$||;
        $state->{'buffer'} = '';
        <[coding.handler.http_io_parse_line]>->(
            $remaining, $state, $callbacks
        );
    }
    $state->{'completed'} = TRUE;
    $callbacks->{'on_complete'}->($state)
        if exists $callbacks->{'on_complete'};
    <[coding.async.http_cleanup]>->($state);
    return;
}

## data received — delegate to http_io for parsing ##
## [ reuse existing parse logic by temporarily making state look like http_io state ] ##
$state->{'last_activity'} = <[base.time]>->(3);
$state->{'bytes_received'} += $bytes;
$state->{'buffer'} .= $buffer;

<[base.logs]>->(
    2,      "async.http_poll: received %d bytes [ total : %d ]",
    $bytes, $state->{'bytes_received'}
);

## parse headers if not yet done ##
if ( !$state->{'headers_parsed'} ) {
    if ( $state->{'buffer'} =~ s/^(.+?)\r?\n\r?\n//s ) {
        my $header_text = $1;
        my @lines       = split( /\r?\n/, $header_text );
        my $status_line = shift @lines;
        if ( $status_line =~ m{HTTP/\d\.\d\s+(\d+)\s*(.*)} ) {
            my $code = $1 // '???';
            $state->{'status_code'}    = $code;
            $state->{'status_message'} = $2 // '';
            <[base.logs]>->(
                1, "http_poll : %s : streaming started..,", $code
            );
            if ( $state->{'status_code'} !~ m{^2} ) {
                my $error = "HTTP error: " . $state->{'status_code'};
                $callbacks->{'on_error'}->($error)
                    if exists $callbacks->{'on_error'};
                <[coding.async.http_cleanup]>->($state);
                return;
            }
            $callbacks->{'on_header'}->( { Status => $code } )
                if exists $callbacks->{'on_header'};
        }
        foreach my $line (@lines) {
            if ( $line =~ /^([^:]+):\s*(.+)/ ) {
                $state->{'headers'}{ lc($1) } = $2;
            }
        }
        $state->{'headers_parsed'} = TRUE;
    }
}

## process SSE lines ##
if ( $state->{'headers_parsed'} ) {
    while ( $state->{'buffer'} =~ s/^([^\r\n]*)\r?\n// ) {
        <[coding.handler.http_io_parse_line]>->( $1, $state, $callbacks );
    }
}

POLL_AGAIN:

## reschedule poll for more data ##
my $next = <[event.add_timer]>->(
    {   'after'   => 0.01,
        'handler' => qw| coding.handler.http_poll |,
        'data'    => $state,
    }
);
$state->{'io_watcher'} = $next if defined $next;

return;

