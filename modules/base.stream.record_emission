# name  = base.stream.record_emission
# descr = record an outbound-stream emission for possible later cancellation
# param = ( session_id, cmd_id, byte_len, type )

my ( $sid, $cmd_id, $byte_len, $type ) = @ARG;

return if not defined $sid      or not exists $data{'session'}{$sid};
return if not defined $cmd_id   or $cmd_id !~ m|^\d+$| or $cmd_id == 0;
return if not defined $byte_len or $byte_len < 1;

my $session = $data{'session'}{$sid};
$session->{'obs_deque'} //= [];

push $session->{'obs_deque'}->@*,
    {
    'cmd_id'   => 0 + $cmd_id,
    'byte_len' => 0 + $byte_len,
    'type'     => $type // 'SIZE',
    };

return;

