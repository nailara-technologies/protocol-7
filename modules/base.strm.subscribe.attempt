## [:< ##

# name  = base.strm.subscribe.attempt
# descr = single subscribe attempt ; falls back to the notify_online
#         wait when the publisher is not routable [ internal :
#         called by base.strm.subscribe and by retry timers ]

my $key = shift // '';

my $state = <base.strm.subscribe.registry>->{$key} // return FALSE;

## an attempt means the deferred own-session wait is over ##
$state->{'deferred'} = FALSE;

## notify_online request already outstanding : its reply will resume ##
return TRUE if $state->{'waiting_no'};

my $sent = <[protocol-7.route-send]>->(
    {   'command'   => $state->{'cmd_str'},
        'call_args' => { 'args' => $state->{'args_str'} },
        'reply'     => {
            'handler' => qw| strm.subscribe.reply-handler |,
            'params'  => { 'key' => $key },
        },
    }
);

return TRUE if $sent > 0;    ## in flight : reply handler continues ##

## route-send failed [ no session / unroutable ] : wait for publisher ##
return <[strm.subscribe.wait-online]>->($key);

