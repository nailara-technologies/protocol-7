# name = coding.routing.check_cache_first
# descr = check if task result is already cached
# purpose = routing : cache lookup optimization

my ($task) = @ARG;

my $task_type = $task->{'type'} // $task->{'task_type'} // '';

## no cache lookup without a task type ##
return { found => 0 } unless length $task_type;

## load outcomes from persistence file ##
my $outcomes_file = '/var/protocol-7/coding/learning/outcomes.json';
return { found => 0 } unless -f $outcomes_file;

<[base.perlmod.autoload]>->('JSON::PP');
my $content = <[file.slurp]>->($outcomes_file)->$*;
return { found => 0 } unless defined $content and length $content;

my $outcomes = eval { JSON::PP::decode_json($content) };
return { found => 0 } unless ref $outcomes eq qw| ARRAY |;

## find most recent successful outcome for this task type ##
my $match;
for my $o ( reverse $outcomes->@* ) {
    next unless $o->{'task_type'} eq $task_type;
    next unless $o->{'success'};
    $match = $o;
    last;
}

return { found => 0 } unless defined $match;

return {
    found         => 1,
    cached_result => $match,
    cache_key     => sprintf( '%s:%s', $task_type, $match->{'task_id'} )
};

