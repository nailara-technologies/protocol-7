## [:< ##

# name = image-batch.cmd.status
# descr = Query batch processing status (optionally by batch_id)

my $batch_id = shift;

# Call the main image-batch.status module
my $result = <[image-batch.status]>->($batch_id);

# Check if we got a valid result
return { 'mode' => qw| FALSE |, 'data' => 'Invalid status response' } unless defined $result && ref($result) eq 'HASH';

# Return status data in network format
if ($result->{success}) {
    # Remove internal 'success' field before sending to client
    my %data = %$result;
    delete $data{success};
    # Return as JSON string to avoid hash serialization issues
    require JSON::XS;
    my $json = JSON::XS::encode_json(\%data);
    return { 'mode' => qw| TRUE |, 'data' => $json };
} else {
    return { 'mode' => qw| FALSE |, 'data' => $result->{error} // 'Failed to get batch status' };
}

