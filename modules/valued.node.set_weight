## [:< ##

# name  = valued.node.set_weight
# descr = update the fractional weight of a node

my $id     = shift // return undef;
my $weight = shift // return undef;

my $node = <valued.index>->{$id};
if ( not defined $node ) {
    <[base.s_warn]>->( "valued node '%s' not found", $id );
    return undef;
}

$weight = 0.0   if $weight < 0.0;
$weight = 0.999 if $weight >= 1.0;

$node->{'weight'} = $weight;

return $weight;

