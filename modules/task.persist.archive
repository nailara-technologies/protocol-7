## [:< ##

# name  = task.persist.archive
# param = task_id
# descr = move completed/failed task to history

my $task_id = shift // '';
return FALSE unless length $task_id;

my $task = delete <task.queue>->{$task_id};
return FALSE unless defined $task;

## remove from queue order ##
<task.queue.order> = [ grep { $ARG ne $task_id } @{<task.queue.order>} ];

## store in history ##
<task.history>->{$task_id} = $task;

return TRUE;

