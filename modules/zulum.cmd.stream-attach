## [:< ##

# name  = zulum.cmd.stream-attach
# descr = Attach a consumer to an entropy stream
# param = <stream_id> <callback>

my $params      = shift                  // {};
my $stream_id   = $params->{'stream_id'} // $ARG[0] // 1;
my $consumer_id = $params->{'consumer'}  // $ARG[1] // 'decoder';

## Validate stream ID ##
return {
    'mode' => qw| false |,
    'data' => "stream_id must be 1-13, got: $stream_id"
    }
    unless $stream_id >= 1 && $stream_id <= 13;

## Get stream ##
my $stream = <zulum.stream>->{$stream_id};
return {
    'mode' => qw| false |,
    'data' => "stream $stream_id not initialized"
    }
    unless defined $stream;

## Create callback wrapper ##
my $callback = sub {
    ## phase 2 : route through cube-13 switch matrix ##
    my ( $sid, $entropy, $iteration ) = @ARG;
    my $stream  = <zulum.stream>->{$sid};
    my $is_true = $stream->{'is_true'} // 0;
    <[protocol-7.command.send.local]>->(
        {   'command'   => 'cube-13.receive-entropy',
            'call_args' => { 'args' => "$sid $entropy $is_true" },
        }
    );
};

## Attach to stream ##
push @{ $stream->{'attached'} }, $callback;

<[base.log]>->(
    1,
    sprintf(
        "[zulum] stream %d attached to consumer '%s'",
        $stream_id, $consumer_id
    )
);

return {
    'mode' => qw| true |,
    'data' => "attached to stream $stream_id"
};

