## [:< ##

# name  = zulum.init_code
# descr = Initialize 13 entropy streams from harmonic generator

## Zulum: 13 parallel entropy streams from division-by-13 harmonic table ##
## Each stream initialized from gen×n seed (n=1..13) ##

## Load required modules ##
<[base.perlmod.autoload]>->('AMOS7::Assert::Truth');

## Generator constant: 076923 = fractional part of 1/13 as 6-digit block ##
my $GENERATOR = 76923;

## Initialize 13 streams ##
for my $stream_id ( 1 .. 13 ) {
    ## Seed = generator × stream_id ##
    my $seed = $GENERATOR * $stream_id;

    ## Initialize stream state ##
    <zulum.stream> {$stream_id} = {
        'seed'      => $seed,
        'state'     => $seed,
        'iteration' => 0,
        'entropy'   => 0,
        'active'    => 1,
        'attached'  => [],      ## consumer callbacks ##
    };

    <[base.log]>->(
        2,          "[zulum] stream %d initialized, seed=%d",
        $stream_id, $seed
    );
}

## Global stream state ##
<zulum.generator>      = $GENERATOR;
<zulum.streams_active> = 13;

##[ AUTO-ATTACH DECODER ]#####################################################
## Wire all streams to decoder.zenka.receive_entropy by default ##
###############################################################################

for my $stream_id ( 1 .. 13 ) {
    <[zulum.cmd.stream-attach]>->(
        {   'stream_id' => $stream_id,
            'consumer'  => 'decoder'
        }
    );
}

<[base.log]>->( 1, "[zulum] all 13 streams attached to decoder" );

return TRUE;

