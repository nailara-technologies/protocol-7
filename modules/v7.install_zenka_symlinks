## [:< ##

# name  = v7.install_zenka_symlinks
# descr = install p7.<zenka> symlinks for console-only zenki access

my $root_path     = <system.root_path>;
my $protocol7_bin = sprintf qw| %s/bin/Protocol-7 |, $root_path;    ##[LLL]
my $symlink_dir   = <v7.cfg.zenka_symlink_dir> || qw| /usr/local/bin |;
my $enabled = <[base.cfg_bool]>->( <v7.cfg.install_zenka_symlinks> // 'yes' );

return FALSE unless $enabled;
return FALSE unless $UID == 0;                             ## root only ##
return FALSE unless -x $protocol7_bin;
return FALSE unless -d $symlink_dir and -w $symlink_dir;

## list of zenki to create symlinks for.. ##
my @zenka_list = ();

## match 'console' zenki [ modules directory / *.cmd.* ]
##
my $modules_dir = <system.code_path>;
if ( -d $modules_dir ) {
    opendir( my $mod_dh, $modules_dir ) or return FALSE;
    while ( my $file = readdir($mod_dh) ) {
        ## Match .console files (work.console.commit, sourcecode.console.*, etc)
        if ( $file =~ m|^([^.]+)\.console\.| ) {
            my $zenka_name = $LAST_PAREN_MATCH;
            push @zenka_list, $zenka_name
                unless grep { $ARG eq $zenka_name } @zenka_list;
        }
    }
    closedir($mod_dh);
}

## adding configured zenki from startup configs ##
##
my $zenki_dir = sprintf qw| %s/configuration/zenki |, $root_path;
if ( -d $zenki_dir ) {
    opendir( my $cfg_dh, $zenki_dir ) or return FALSE;
    while ( my $dir = readdir($cfg_dh) ) {
        next if $dir =~ m|^\.\.?$|;
        next unless -d catfile( $zenki_dir, $dir );
        ## Skip v7 itself and system zenki
        next if $dir eq qw| v7 | or $dir eq qw| cube |;
        push @zenka_list, $dir unless grep { $ARG eq $dir } @zenka_list;
    }
    closedir($cfg_dh);
}

return FALSE unless @zenka_list;

my $installed_count = 0;
my $updated_count   = 0;

foreach my $zenka_name ( sort @zenka_list ) {
    my $symlink_path = sprintf qw| %s/p7.%s |, $symlink_dir, $zenka_name;

    ## check if symlink already exists and is current
    ##
    if ( -l $symlink_path ) {
        my $current_target = readlink($symlink_path);
        if ( $current_target eq $protocol7_bin ) {
            ## already correct, skiping.. ##
            next;

            ## creating symlink ##
            if ( symlink( $protocol7_bin, $symlink_path ) ) {
                $installed_count++;
            } else {
                <[base.logs]>->(
                    0,             ": failed to create symlink : %s [ \l%s ]",
                    $symlink_path, <[base.str.os_err]>
                );
            }

        } else {
            ## updating symlink ##
            unlink($symlink_path) or do {
                <[base.logs]>->(
                    0, ": cannot update symlink : %s",
                    $symlink_path
                );
                next;
            };
            $updated_count++;
        }
    }

}

if ( $installed_count > 0 or $updated_count > 0 ) {
    <[base.logs]>->(
        1,
        ': installed %d zenka symlink%s to %s',
        $installed_count + $updated_count,
        <[base.cnt_s]>->( $installed_count + $updated_count ),
        $symlink_dir
    );

    if ( $installed_count > 0 ) {
        <[base.logs]>->( 2, ': :. created : %d', $installed_count );
    }
    if ( $updated_count > 0 ) {
        <[base.logs]>->( 2, ': :. updated : %d', $updated_count );
    }
}

return $installed_count + $updated_count;

