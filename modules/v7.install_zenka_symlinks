## [:< ##

# name  = v7.install_zenka_symlinks
# descr = install v7.<zenka> symlinks for console-only zenki access
# todo  = use internal base.file routines .,.

my $root_path     = <system.root_path>;
my $conf_path     = <system.conf_path>;
my $protocol7_bin = sprintf qw| %s/bin/Protocol-7 |, $root_path;    ##[LLL]
my $symlink_dir   = <v7.cfg.zenka_symlink_dir> || qw| /usr/local/bin |;
my $enabled = <[base.cfg_bool]>->( <v7.cfg.install_zenka_symlinks> // TRUE );

return FALSE unless $enabled;
return FALSE unless -x $protocol7_bin;
return FALSE
    unless -d $symlink_dir and -w $symlink_dir;    ## <- add warning ##

<[base.log]>->(': checking zenki-alias symlinks [ v7.* ]');

## list of [symlinked] zenki ##
my %console_zenki;
my @zenki_list;

## match 'console' commands, extract module name [ modules/<module>.*.cmd.* ]
##
my $modules_dir = <system.code_path>;
if ( -d $modules_dir ) {
    opendir( my $mod_dh, $modules_dir ) or return FALSE;
    while ( my $file = readdir($mod_dh) ) {
        next if -d $file;    ## skip any present directories ##
        ## match .console files like [ work.console.commit ,
        ##                             sourcecode.console.* .. ]
        if ( $file =~ m|^([^.]+)\.console\.| ) {
            my $module_name = $LAST_PAREN_MATCH;
            next if exists $console_zenki{$module_name};
            $console_zenki{$module_name} = TRUE;
        }
    }
    closedir($mod_dh);
}
return FALSE unless scalar keys %console_zenki;   ## <- implement warning.. ##

## adding existing console-commands-having zenki from startup configs ##
##
my $zenki_dir = catdir( $conf_path, qw| zenki | );
if ( -d $zenki_dir ) {
    opendir( my $cfg_dh, $zenki_dir ) or return FALSE;
    foreach my $dir_name ( <[base.sort]>->( readdir($cfg_dh) ) )
    {    ## zenka config directory ##
        next if $dir_name =~ m|^\.\.?$|;
        next unless -d catfile( $zenki_dir, $dir_name );
        push( @zenki_list, $dir_name )  # keep zenka name if has console cmd #
            if defined delete $console_zenki{$dir_name};
    }
    closedir($cfg_dh);
}
return FALSE unless scalar @zenki_list;    ## <- implement warning.. ##
undef %console_zenki;    ## done with that, moved to @zenki_list ##

my $installed_count = 0;
my $updated_count   = 0;

foreach my $zenka_name (@zenki_list) {  # implement zenka symlink skip-list[!]
    my $symlink_path = sprintf qw| %s/v7.%s |, $symlink_dir, $zenka_name;

    ## check if symlink already exists and is current
    ##
    if ( -l $symlink_path ) {
        my $current_target = readlink($symlink_path);
        if ( $current_target eq $protocol7_bin ) {
            ## already correct, skiping.. ##
            <[base.logs]>->( 2, ": =) : %s", $symlink_path );
            next;
        } else {
            ## updating symlink ##
            unlink($symlink_path) or do {
                <[base.logs]>->(
                    0, ": cannot update symlink : %s",
                    $symlink_path
                );
                next;
            };
            $updated_count++;
        }
    }

    ### creating symlink ### [ /usr/local/bin/v7.,. ]
    ##
    if ( symlink( $protocol7_bin, $symlink_path ) ) {
        $installed_count++;
    } else {
        <[base.logs]>->(
            0,             ": failed to create symlink : %s [ \l%s ]",
            $symlink_path, <[base.str.os_err]>
        );
    }
}

### skip following report when nothing changed : ###
return FALSE unless $installed_count + $updated_count;

if ( $installed_count > 0 or $updated_count > 0 ) {
    <[base.logs]>->(
        ': installed %d zenka symlink%s to %s',
        $installed_count + $updated_count,
        <[base.cnt_s]>->( $installed_count + $updated_count ),
        $symlink_dir
    );

    if ( $installed_count > 0 ) {
        <[base.logs]>->( 2, ': :. created : %d', $installed_count );
    }
    if ( $updated_count > 0 ) {
        <[base.logs]>->( 2, ': :. updated : %d', $updated_count );
    }
}

return $installed_count + $updated_count;

