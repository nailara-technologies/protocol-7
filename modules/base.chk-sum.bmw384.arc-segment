## [:< ##

# name  = base.chk-sum.bmw384.arc-segment
# args  = $color
# descr = map a 24-bit color value to its arc segment (0..25)

my $color = shift;

if ( not defined $color ) {
    <[base.logs]>->( 1, 'color value must be defined <{C1}>' );
    return undef;
}

<[base.perlmod.autoload]>->('AMOS7::CHKSUM::BMW384')
    if not <[base.perlmod.loaded]>->('AMOS7::CHKSUM::BMW384');

return AMOS7::CHKSUM::BMW384::bmw384_arc_segment($color);

