## [:< ##

# name = session.parent.check_and_resolve_deps
# descr = Smart dependency resolution - auto-install when unambiguous, helper when needed

my $params = shift || {};

my $force = $params->{force} // 0;

## Don't check again if already done this session (unless forced)
    if (<session.cfg.check_performed> && !$force) {
        <[base.log]>->( 3, "session.deps: check already performed this session" );
        return { success => 1, already_checked => 1 };
    }

    unless (<session.cfg.auto_check_deps>) {
        <[base.log]>->( 3, "session.deps: auto-check disabled" );
        return { success => 1, disabled => 1 };
    }

    <[base.log]>->( 2, "session.deps: checking dependencies at startup..." );

    ## Mark check as performed
    <session.cfg.check_performed> = 1;
    $data{'session'}{'stats'}{'checks_performed'}++;

    ## Scan zenki dependencies (if debian module loaded)
    unless (exists $code{'debian.parent.scan_zenki_dependencies'}) {
        <[base.log]>->( 3, "  debian module not loaded - skipping dependency check" );
        return { success => 1, debian_not_loaded => 1 };
    }

    ## Perform scan
    <[debian.parent.scan_zenki_dependencies]>;
    <[debian.parent.check_installed]>;

    ## Check what's missing
    my $stats = $data{'debian'}{'stats'} || {};
    my $missing_count = $stats->{'missing_deps'} || 0;

    if ($missing_count == 0) {
        <[base.log]>->( 2, "  ✓ All dependencies satisfied" );
        $data{'session'}{'stats'}{'deps_satisfied'}++;
        return {
            success => 1,
            all_satisfied => 1,
            message => 'All dependencies are installed'
        };
    }

    <[base.log]>->( 2, "  Found $missing_count missing dependencies" );

    ## Decision logic: Unambiguous vs Ambiguous

    ## Unambiguous case: Only minimal/base dependencies missing
    ## Ambiguous case: Zenka-specific deps missing, user should choose

    my $minimal_missing = <[session.parent.check_minimal_deps]>;

    if ($minimal_missing && <session.cfg.auto_install_minimal>) {
        ## UNAMBIGUOUS: Just install minimal dependencies automatically
        <[base.log]>->( 2, "  Auto-installing minimal Protocol-7 dependencies..." );

        my $script = '/data/projects/protocol-7/bin/dependencies/install_minimal_dependencies.debian.sh';

        if (-f $script) {
            $data{'session'}{'stats'}{'auto_installs'}++;

            ## Check if we have permission
            if ($UID == 0 || -w '/usr/local') {
                system('bash', $script);
                my $exit_code = $? >> 8;

                if ($exit_code == 0) {
                    <[base.log]>->( 2, "  ✓ Minimal dependencies installed successfully" );
                    return {
                        success => 1,
                        auto_installed => 1,
                        message => 'Minimal dependencies installed automatically'
                    };
                } else {
                    <[base.log]>->( 0, "  ✗ Auto-install failed with exit code: $exit_code" );
                }
            } else {
                <[base.log]>->( 1, "  ⚠ Need permissions to install (try: sudo)" );
            }
        }
    }

    ## AMBIGUOUS: Need user input or startup zenka help
    if (<session.cfg.show_startup_zenka>) {
        <[base.log]>->( 2, "  Starting interactive dependency helper..." );
        $data{'session'}{'stats'}{'startup_zenka_shown'}++;

        ## TODO: Start startup zenka here
        ## For now, show helpful message
        <[session.parent.show_startup_help]>;

        return {
            success => 1,
            showed_helper => 1,
            missing_count => $missing_count
        };
    }

    ## Fallback: Just report status
    return {
        success => 1,
        missing_count => $missing_count,
        message => "Missing $missing_count dependencies - run 'debian check-deps' for details"
    };

0;

