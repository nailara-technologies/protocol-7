## [:< ##

# name  = editor.control.create
# descr = create editor state from a field schema

## $editor_state shape per design doc editor.control.create :
##   { schema, fields => { $name => $buffer_ref }, active_field, mode }
## only the freeform_line field type has a real implementation ;
## enum/masked/readonly/freeform_multiline stay interface-only for now.

my $schema = shift;

return undef if ref $schema ne qw| HASH |;
return undef
    if ref $schema->{'fields'} ne qw| ARRAY |
    or not $schema->{'fields'}->@*;

my %fields;
foreach my $field_def ( $schema->{'fields'}->@* ) {
    return undef if ref $field_def ne qw| HASH |;
    my $name = $field_def->{'name'} // return undef;
    my $type = $field_def->{'type'} // qw| freeform_line |;

    ## 'masked' behaves exactly like freeform_line for editing -- same buffer,
    ## same key handling -- and differs ONLY in how it is drawn, which lives
    ## in editor.control.get_display_value.  enum / readonly /
    ## freeform_multiline stay interface-only
    return undef
        if $type ne qw| freeform_line |
        and $type ne qw| masked |;
    $fields{$name} = <[editor.buffer.memory.create]>->($field_def);
    return undef if not defined $fields{$name};
}

return {
    'schema'       => $schema,
    'fields'       => \%fields,
    'active_field' => $schema->{'active_field'} // 0,
    'mode'         => 'insert',
    ## provisional single-field placement ; pending the design doc's open
    ## multi-field kill-ring question [ per-field vs shared ring ]
    'kill_buffer' => '',
};

