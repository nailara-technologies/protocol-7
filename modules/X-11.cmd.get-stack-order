## [:< ##

# name  = X-11.cmd.get-stack-order
# descr = return the window stacking order [win ids]

my $xtops = <X-11.WM>;
<[X-11.update_X11_WM]>;

my @order = $xtops->stacking;

## [ WSL / no-WM fallback: build stacking order from root QueryTree ] ##
if ( not @order ) {
    my $X    = <X-11.obj>;
    my $root = $X->root;

    my $wm_name     = $X->atom('WM_NAME');
    my $net_wm_name = $X->atom('_NET_WM_NAME');
    my $utf8_string = $X->atom('UTF8_STRING');
    my $string      = $X->atom('STRING');

    ## [ helper: fetch a property value, ignoring errors and empty replies ] ##
    my $fetch_title = sub {
        my ( $wid, $atom, $req_type ) = @ARG;
        return undef unless defined $wid and defined $atom;
        my ($val)
            = eval { $X->GetProperty( $wid, $atom, $req_type, 0, 256, 0 ); };
        return undef if $EVAL_ERROR or not defined $val or not length $val;
        return $val;
    };

    ## [ helper: try atom with explicit type and fall back to any type ] ##
    my $try_title = sub {
        my ( $wid, $atom, $type ) = @ARG;
        return undef unless defined $atom;
        my $val = $fetch_title->( $wid, $atom, $type );
        return $val if defined $val;
        return $fetch_title->( $wid, $atom, 'AnyPropertyType' );
    };

    ## [ helper: find first titled descendant, returns ( xid, title ) ] ##
    my $find_title;
    $find_title = sub {
        my ($wid) = @ARG;
        return undef unless defined $wid and $wid ne 'None';

        my $title;
        $title = $try_title->( $wid, $net_wm_name, $utf8_string );
        return [ $wid, $title ] if defined $title;
        $title = $try_title->( $wid, $wm_name, $string );
        return [ $wid, $title ] if defined $title;

        my ( undef, undef, @children ) = eval { $X->QueryTree($wid) };
        return undef if $EVAL_ERROR;
        foreach my $child (@children) {
            next unless defined $child and $child ne 'None';
            my $pair = $find_title->($child);
            return $pair if defined $pair;
        }
        return undef;
    };

    ## [ QueryTree returns children bottom-to-top; filter to titled windows ] ##
    eval {
        my ( undef, undef, @root_children ) = $X->QueryTree($root);
        foreach my $wid (@root_children) {
            next unless defined $wid and $wid ne 'None' and $wid =~ m|^\d+$|;
            my %wa = eval { $X->GetWindowAttributes($wid) };
            next if $EVAL_ERROR or not %wa;
            next if ( $wa{'map_state'} // '' ) eq 'Unmapped';

            my $pair = $find_title->($wid);
            next unless defined $pair;
            my ( $titled_id, $title ) = @$pair;
            next
                unless defined $titled_id
                and defined $title
                and length $title;

            push @order, $titled_id;
        }
    };

    if ($EVAL_ERROR) {
        <[base.logs]>->(
            0, 'QueryTree stacking fallback failed: %s', $EVAL_ERROR
        );
    }
}

my $reply_str = join( "\n", reverse(@order) ) // '';

$reply_str .= "\n" if length($reply_str);

return { 'mode' => qw| size |, 'data' => $reply_str };

