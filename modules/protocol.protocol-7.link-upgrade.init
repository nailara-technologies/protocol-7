## [:< ##

# name  = protocol.protocol-7.link-upgrade.init
# descr = setup link-upgrade negotiation state
#
# called = from base.session.init_state when transitioning to state 2
# optional = state 2 only entered if client explicitly requests upgrade
#            normal unencrypted operation remains in state 1 indefinitely
# args   = session_id, mode, state_id
# returns = 1 (success) | 0 (failure - return to state 1)

my ( $session_id, $mode, $state_id ) = @ARG;
my $session = $data{'session'}{$session_id};

## Generate ephemeral Curve25519 keypair for this session
## Use Crypt::Misc for key generation (for DH, not Ed25519 signatures)
use Crypt::Misc;
use Crypt::Curve25519;

my $ephemeral_secret = Crypt::Misc::random_bytes(32);
my $ephemeral_public
    = Crypt::Curve25519::curve25519_public_key($ephemeral_secret);
my $ephemeral_key_name = sprintf( qw| link-upgrade-%d-%s |,
    $session_id, <[base.prng.chars-anum]>->(8) );

my $ephemeral_keypair = {
    'secret' => $ephemeral_secret,
    'public' => $ephemeral_public,
};

if (   not defined $ephemeral_keypair
    or not defined $ephemeral_secret
    or not defined $ephemeral_public ) {
    <[base.logs]>->(
        0,
        '[%d] failed to generate Curve25519 ephemeral keypair for link-upgrade',
        $session_id
    );
    return FALSE;
}

## Store ephemeral keypair info in session
$session->{'link_ephemeral_key_name'} = $ephemeral_key_name;
$session->{'link_ephemeral_pubkey'}   = $ephemeral_keypair->{'public'};
$session->{'link_ephemeral_keypair'}
    = $ephemeral_keypair;    ## Store entire keypair for handler access

## Initialize capability flags
my $capabilities = {
    'encryption'  => ['ChaCha20-Poly1305'],
    'encoding'    => [ 'utf7', 'base32', 'base32-xz' ],
    'compression' => []
};

## Add compression support if available
if ( <base.perlmod.loaded>->{'Compress::Raw::Lzma'} ) {
    push @{ $capabilities->{'compression'} }, 'xz';
}

$session->{'link_capabilities'} = $capabilities;

## Set negotiation timeout (17 seconds, matching auth timeout)
my $link_timeout = <protocol-7.link-upgrade-timeout> // 17;
$session->{'link_upgrade_timeout'} = time() + $link_timeout;

<[base.logs]>->(
    2,
    '[%d] initialized link-upgrade negotiation (state %d), ephemeral keypair ready',
    $session_id,
    $state_id
);

## Note: ephemeral pubkey is sent by cube.cmd.link-upgrade after command response
## This ensures proper message ordering: TRUE response first, then pubkey
return TRUE;

1;

