## [:< ##

# name = memory.cmd.summarize
# descr = manually trigger memory tree summarize wave

return { 'mode' => 'size', 'data' => "memory tree not ready\n" }
    if not <memory.ready>;

my $queued = eval { <[memory.tree.summarize.wave]> };
my $err    = <[base.str.eval_error]>;

if ($err) {
    <[base.logs]>->( 0, 'memory.cmd.summarize failed: %s', $err );
    return { 'mode' => 'size', 'data' => "summarize wave failed: $err\n" };
}

my $output = sprintf "summarize wave queued %d nodes for summarization\n",
    $queued // 0;

return { 'mode' => 'size', 'data' => $output };

