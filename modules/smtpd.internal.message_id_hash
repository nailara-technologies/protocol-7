# name  = smtpd.internal.message_id_hash
# descr = generate short hash from message-id for filesystem storage
# param = $message_id
# return = $hash_string

my $msg_id = shift // '';
return 'unknown' if not length $msg_id;

my $hash = <[chk-sum.amos]>->($msg_id);
$hash =~ s|[^A-Za-z0-9]||g;
return substr( $hash, 0, 16 );

