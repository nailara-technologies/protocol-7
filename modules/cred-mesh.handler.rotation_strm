## [:< ##

# name  = cred-mesh.handler.rotation_strm
# descr = push STRM notification to all subscribers when a credential rotates.
#         args: $slot, $reason

my $slot   = shift // '';
my $reason = shift // '';

return undef unless length $slot;

my $subs     = <cred-mesh.rotation_subscribers>->{$slot} // [];
my $all_subs = <cred-mesh.rotation_subscribers>->{'*'}   // [];
my @combined = ( @$subs, @$all_subs );
return undef if not @combined;

my $ntime = <[base.time]>->(3);

## base32-encode the payload before sending: YAML::XS::Dump is multi-line
## block style, but the command wire protocol here is line-based (one
## command per \n) -- an unencoded dump would get truncated at its own
## first internal newline on delivery ##
my $event_yaml = YAML::XS::Dump(
    {   'event'  => 'credential.rotated.' . $slot,
        'slot'   => $slot,
        'ntime'  => $ntime,
        'reason' => $reason,
    }
);
my $event_b32 = <[base.base32.encode]>->( \$event_yaml );

foreach my $handler (@combined) {
    ## dispatch STRM-style notification via protocol-7 route-send ##
    <[protocol-7.route-send]>->(
        {   'command'   => $handler,
            'call_args' => { 'args' => $event_b32 },
        }
    );
}

return scalar @$subs;

