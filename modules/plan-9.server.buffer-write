## [:< ##
# name  = plan-9.server.buffer-write
# descr = Write to buffer layer

my ( $amos_id, $z, $offset, $content ) = @ARG;

my $buf = $data{'plan-9'}{'server'}{'buffers'}{$amos_id};
return 0 unless $buf;

my $window = $buf->{window};

$window->{buffer}{layers} //= [];
$window->{buffer}{layers}[$z] //= '';

if ( length( $window->{buffer}{layers}[$z] ) < $offset ) {
    $window->{buffer}{layers}[$z]
        .= "\0" x ( $offset - length( $window->{buffer}{layers}[$z] ) );
}

substr( $window->{buffer}{layers}[$z], $offset, length($content) )
    = $content;

return length($content);

