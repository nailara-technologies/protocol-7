## [:< ##

# name  = task.cmd.create
# param = ['multiline'] description [context]
# descr = create a new task and return its id

my $description = '';
my $context     = '';

## parse params
my $iteration    = 0;
my $criteria     = [];
my $node_id      = '';
my $max_attempts = 5;
my $parent_id    = '';
my $groups       = [];
my $depends_on   = [];
my $requires     = [];
my $slots        = [];

if ( defined $call->{'param'} and ref $call->{'param'} eq 'HASH' ) {
    $description  = $call->{'param'}->{'description'}         // '';
    $context      = $call->{'param'}->{'context'}             // '';
    $iteration    = $call->{'param'}->{'iteration'}           // 0;
    $criteria     = $call->{'param'}->{'acceptance_criteria'} // [];
    $node_id      = $call->{'param'}->{'node_id'}             // '';
    $max_attempts = $call->{'param'}->{'max_attempts'}        // 5;
    $parent_id    = $call->{'param'}->{'parent_id'}           // '';
    $groups       = $call->{'param'}->{'groups'}              // [];
    $depends_on   = $call->{'param'}->{'depends_on'}          // [];
    $requires     = $call->{'param'}->{'requires'}            // [];
    $slots        = $call->{'param'}->{'slots'}               // [];
} else {
    ## args is the full description string — decode B32 if prefixed
    $description = $call->{'args'} // '';
    if ( $description =~ s|^:B32:||i ) {
        $description = Encode::decode( 'UTF-8', decode_b32r($description) );
    }
}

return { 'mode' => 'false', 'data' => 'description required' }
    unless length $description;

## get current ntime for timestamp and id generation
my $ntime_b32 = <[base.ntime.b32]>;

## generate 7-char task id from amos checksum of "ntime:description"
my $chk_input = sprintf( '%s:%s', $ntime_b32, $description );

## use swap-boundary safe dispatch [ see CLAUDE.md ]
my $amos_chksum = $code{'chk-sum.amos'} // $code{'base.chk-sum.amos'};
my $full_chksum = $amos_chksum->($chk_input);

## take first 7 chars for readable id
my $task_id = substr( $full_chksum, 0, 7 );

## ensure uniqueness — if collision, append counter
my $counter     = 0;
my $original_id = $task_id;
while ( exists <task.queue>->{$task_id} ) {
    $counter++;
    $task_id
        = substr( $original_id, 0, 6 ) . sprintf( '%01X', $counter % 16 );
}

## create task record
my $task = {
    'id'                  => $task_id,
    'status'              => 'pending',
    'created_at'          => $ntime_b32,
    'updated_at'          => $ntime_b32,
    'description'         => $description,
    'context'             => $context,
    'result'              => undef,
    'agent'               => undef,
    'iteration'           => $iteration,
    'acceptance_criteria' => $criteria,
    'node_id'             => $node_id,
    'max_attempts'        => $max_attempts,
    'parent_id'           => $parent_id,
    'children'            => [],
    'groups'              => $groups,
    'depends_on'          => $depends_on,
    'requires'            => $requires,
    'slots'               => $slots,
};

## register as child of parent ##
if ( length $parent_id ) {
    my $parent = <task.queue>->{$parent_id} // <task.history>->{$parent_id};
    push @{ $parent->{'children'} }, $task_id if defined $parent;
}

## store in queue
<task.queue>->{$task_id} = $task;
push @{<task.queue.order>}, $task_id;

## persist to disk
<[task.persist.save]>;

<[base.logs]>->( 1, ':. task created [ %s ]', $task_id );

## notify models zenka that a new task is available [event-driven, no polling]
my $sent = <[protocol-7.route-send]>->(
    {   'command'   => 'models.task-notify',
        'call_args' => { 'args' => $task_id }
    }
);
<[base.logs]>->(
    $sent ? 1 : 0,
    ':. task-notify sent to models [ %s ] : %s',
    $task_id, $sent ? 'success' : 'not delivered'
);

return { 'mode' => 'size', 'data' => $task_id };

