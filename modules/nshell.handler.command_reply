## [:< ##

# name = nshell.handler.command_reply
# descr = process and display cube command replies to terminal and history

my $reply = shift // return FALSE;

return FALSE unless defined $reply;

## extract reply components [ already parsed by base.handler.command ]
my $cmd  = $reply->{'cmd'};            # reply type [TRUE, FALSE, SIZE, etc.]
my $args = $reply->{'call_args'}->{'args'} // '';    # content from call_args
my $payload_str = $reply->{'data'};    # raw payload for multi-line replies

### logging to terminal-history with endline padding ###
## precede with blank line, log reply type and args with two-space prefix,
## then payload [if present], then blank line

## encode control characters for safe history storage
my $encoded_args = <[nshell.parser.term_encode]>->($args);
my $encoded_payload
    = defined $payload_str
    ? <[nshell.parser.term_encode]>->($payload_str)
    : undef;

## blank line before reply
<[base.buffer.add_line]>->( qw| terminal-history |, '' );

## reply type and args with two-space prefix
<[base.buffer.add_line]>->(
    qw| terminal-history |,
    sprintf '  %s %s',
    $cmd, $encoded_args
);

## log data payload if present [SIZE, STRM, ..] - also with two-space prefix
if ( defined $encoded_payload ) {
    map {
        <[base.buffer.add_line]>->(
            qw| terminal-history |,
            sprintf '  %s', $ARG
        )
    } split "\n", $encoded_payload;
}
## blank line after reply
<[base.buffer.add_line]>->( qw| terminal-history |, '' );

## print to console [STDOUT] and handle cursor display
#
if ( not defined $payload_str ) {

    ## single-line reply : colorize and print to console for immediate display
    ## TRUE replies  : standard text color
    ## FALSE replies : emphasis color [p7_fg_0003]
    my $reply_color = ( $cmd eq 'FALSE' ) ? $colors{'p7_fg_0003'} : '';
    my $reset_color = ( $cmd eq 'FALSE' ) ? $colors{'p7_fg_0004'} : '';

    printf "\n%s%s%s\n\n", $reply_color, $args, $reset_color;

} else {    ## print multi-line output directly without padding to console

    print $payload_str;
}
print "\r"    ## re-display cursor after multi-line output
    . $colors{'p7_fg_0003'} . "_\e[K\r" . "\e[0m" . $colors{'p7_fg_0004'};

STDOUT->flush();

return TRUE;

