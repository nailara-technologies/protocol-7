# name = nshell.handler.command_reply
# descr = Handle cube command replies and output to terminal

my $reply_data = shift // return FALSE;

## Extract command result from reply
my $result = ref($reply_data) eq 'HASH' ? $reply_data->{'result'} : $reply_data;

## Write result to terminal
<[nshell.write_to_buffer]>->($result) if defined $result && length $result;

return TRUE;

