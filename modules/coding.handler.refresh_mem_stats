# name  = coding.handler.refresh_mem_stats
# descr = timer handler: request system memory stats from system zenka

my $cmd_count = <[protocol-7.route-send]>->(
    {   'command' => qw| system.mem-used |,
        'reply'   => {
            'handler' => qw| coding.handler.system_mem_reply |,
            'params'  => {}
        }
    }
);

<[base.logs]>->( 3, 'memory stats request sent to system zenka' )
    if $cmd_count;

return TRUE;

