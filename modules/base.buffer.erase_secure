## [:< ##

# name  = base.buffer.erase_secure
# descr = overwrite a secret buffer with random data twice, then truncate

my $buffer_sref = shift;

return 0 if ref $buffer_sref ne qw| SCALAR |;
return 0 if not defined $buffer_sref->$*;

my $len = length( $buffer_sref->$* );
return 0 if $len == 0;

## two random-overwrite passes before truncation -- a single pass can leave ##
## recoverable remnants depending on how the allocator reused the page;     ##
## matches bin/p7-auth-keypair-helper.pl's original approach                ##
my $prng = Crypt::PRNG::Fortuna->new();
substr( $buffer_sref->$*, 0, $len, $prng->bytes($len) );
substr( $buffer_sref->$*, 0, $len, $prng->bytes($len) );

$buffer_sref->$* = '';    ##  truncate  ##

return $len;

