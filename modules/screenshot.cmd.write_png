## [:< ##

# name  = screenshot.cmd.write_png
# param = [coords]
# descr = grab screen or region and return path

my $param_str = shift->{'args'} // '';
return {
    'mode' => qw| false |,
    'data' => 'expected screen region coordinates'
    }
    if $param_str !~ /^(\d+ +){3}\d+$/;
my @coords = ( split( / +/, $param_str ) );

my $image   = <[screenshot.grab_region]>->(@coords);
my $err_str = $image if ref($image) ne 'Imager';

return {
    'mode' => qw| false |,
    'data' => "unable to acquire screenshot [ $err_str ]"
    }
    if defined $err_str;

my $out_dir = <screenshot.cfg.output_dir>;
<[base.file.make_path]>->($out_dir) unless -d $out_dir;
my $out_path = sprintf '%s/screenshot_%d_%d.png', $out_dir, time, $$;

my $write_ok = $image->write(
    'file' => $out_path,
    'type' => 'png'
);

return {
    'mode' => qw| false |,
    'data' => "unable to write PNG [ " . Imager->errstr . " ]"
    }
    if not $write_ok;

return {
    'mode' => qw| true |,
    'data' => $out_path
};

