## [:< ##

# name  = screenshot.cmd.write_png
# param = [coords]
# descr = grab screen or region and return path

my $param_str = $call->{'args'} // '';
return {
    'mode' => qw| false |,
    'data' => 'expected screen region coordinates'
    }
    if $param_str !~ m|^(\d+ +){3}\d+$|;
my @coords = ( split( m| +|, $param_str ) );

my $image   = <[screenshot.grab_region]>->(@coords);
my $err_str = $image if ref($image) ne qw| Imager |;

return {
    'mode' => qw| false |,
    'data' => "unable to acquire screenshot [ $err_str ]"
    }
    if defined $err_str;

my $out_dir = <screenshot.cfg.output_dir>;
<[file.make_path]>->($out_dir) unless -d $out_dir;
my $stamp    = <[base.ntime]>->(0) // time;
my $out_path = sprintf '%s/screenshot_%s.png', $out_dir, $stamp;

my $write_ok = $image->write(
    'file' => $out_path,
    'type' => 'png'
);

return {
    'mode' => qw| false |,
    'data' => "unable to write PNG [ " . Imager->errstr . " ]"
    }
    if not $write_ok;

return {
    'mode' => qw| true |,
    'data' => $out_path
};

