## [:< ##

# name  = screen.setup.subscribe-screen-change
# descr = initialized callback — subscribe screen-setup to X-11 screen-change
#         events so pending window-intent moves can be retried

<[base.log]>->(
    1, 'subscribing screen-setup to X-11 screen-change events .,'
);

<[protocol-7.command.send.local]>->(
    {   'command'   => qw| X-11.subscribe-screen-change |,
        'call_args' => { 'args' => qw| screen.setup.cmd.screen-change | }
    }
);

