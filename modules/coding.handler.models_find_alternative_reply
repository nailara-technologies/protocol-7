# name = coding.handler.models_find_alternative_reply
# descr = Handle async response from models.find_best_alternative command

my $reply = shift;

my $sid                = $reply->{'sid'};
my $cmd_status         = $reply->{'cmd'};
my $call_args          = $reply->{'call_args'};
my $primary_model_amos = $reply->{'params'}->{'primary_model_amos'};
my $context            = $reply->{'params'}->{'context'};

<[base.log]>->(
    2,
    "[coding] models_find_alternative_reply: status=%s primary=%s context=%s sid=%s",
    $cmd_status,
    $primary_model_amos,
    $context,
    $sid
);

# Log call_args structure for debugging
if ( ref($call_args) eq qw| HASH | ) {
    my @keys = keys %$call_args;
    <[base.log]>->(
        2,
        "[coding] models_find_alternative: call_args keys: %s",
        join( ", ", @keys )
    );
    foreach my $key (@keys) {
        my $val = $call_args->{$key};
        if ( ref($val) eq 'ARRAY' ) {
            <[base.log]>->(
                2,    "[coding] models_find_alternative: %s = ARRAY[%d]",
                $key, scalar(@$val)
            );
        } elsif ( ref($val) ) {
            <[base.log]>->(
                2,    "[coding] models_find_alternative: %s = %s",
                $key, ref($val)
            );
        } else {
            <[base.log]>->(
                2,    "[coding] models_find_alternative: %s = %s",
                $key, defined($val) ? $val : 'undef'
            );
        }
    }
} else {
    <[base.log]>->(
        2,
        "[coding] models_find_alternative: call_args type = %s",
        ref($call_args) || 'SCALAR'
    );
}

# TODO: Extract alternative model from $call_args
# TODO: Verify alternative is available
# TODO: Fallback to alternative model for task retry

return 1;

