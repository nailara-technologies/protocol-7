# name  = amos-term.cursor-set_pos
# descr = Set cursor to absolute position

my ( $window_id, $x, $y, $z ) = @ARG;

my $window = <amos-term.windows.by_id>->{$window_id};
return undef unless defined $window;

my $cursor = $window->{'buffer'}->{'cursor'};
my $dims   = $window->{'buffer'}->{'dimensions'};

## bounds checking ##
$x = 0              if $x < 0;
$x = $dims->[0] - 1 if $x >= $dims->[0];
$y = 0              if $y < 0;
$y = $dims->[1] - 1 if $y >= $dims->[1];
$z = 0              if $z < 0;
$z = $dims->[2] - 1 if $z >= $dims->[2];

$cursor->{'x'} = $x;
$cursor->{'y'} = $y;
$cursor->{'z'} = $z;

return $cursor;

