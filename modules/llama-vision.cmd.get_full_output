# name  = llama-vision.cmd.get_full_output
# descr = retrieve both stdout and stderr buffers for debugging

my $job_id = $call->{'args'};

unless ( defined $job_id && length $job_id ) {
    return { 'mode' => 'false', 'data' => 'job_id required' };
}

unless ( exists <llama-vision.jobs>->{$job_id} ) {
    return { 'mode' => 'false', 'data' => 'no such job' };
}

my $job = <llama-vision.jobs>->{$job_id};

my $output_str
    = "=== STDOUT (" . length( $job->{'output'} ) . " bytes) ===\n";
$output_str .= $job->{'output'} . "\n\n";

$output_str .= "=== STDERR (" . length( $job->{'stderr'} ) . " bytes) ===\n";
$output_str .= $job->{'stderr'} . "\n\n";

$output_str
    .= "=== COMBINED ("
    . ( length( $job->{'output'} ) + length( $job->{'stderr'} ) )
    . " bytes) ===\n";
$output_str .= $job->{'output'} . $job->{'stderr'};

return {
    'mode' => 'size',
    'data' => $output_str
};

