# name = coding.test.models_async
# descr = Test async communication with models zenka

my $test_results = {};

# Test 1: models.list_all
<[base.log]>->( 2, "[coding.test] Sending async request to models.list_all" );
<[base.protocol-7.command.send.local]>->(
    {   'command'   => "models.list_all",
        'call_args' => { 'args' => "" },
        'reply'     => {
            'handler' => 'coding.handler.models_list_all_reply',
            'params'  => { 'context' => 'test_batch' }
        }
    }
);

# Test 2: models.get_entry
<[base.log]>
    ->( 2, "[coding.test] Sending async request to models.get_entry" );
<[base.protocol-7.command.send.local]>->(
    {   'command'   => "models.get_entry",
        'call_args' => {
            'model_amos' => 'llama-3.1-8b-instruct',
            'task_id'    => 'test_001'
        },
        'reply' => {
            'handler' => 'coding.handler.models_get_entry_reply',
            'params'  => {
                'model_amos' => 'llama-3.1-8b-instruct',
                'task_id'    => 'test_001'
            }
        }
    }
);

# Test 3: models.resolve_model_path
<[base.log]>->(
    2, "[coding.test] Sending async request to models.resolve_model_path"
);
<[base.protocol-7.command.send.local]>->(
    {   'command'   => "models.resolve_model_path",
        'call_args' =>
            { 'model_amos' => 'gpt-3.5', 'context' => 'inference' },
        'reply' => {
            'handler' => 'coding.handler.models_resolve_path_reply',
            'params'  =>
                { 'model_amos' => 'gpt-3.5', 'context' => 'inference' }
        }
    }
);

# Test 4: models.get_model_recommendations
