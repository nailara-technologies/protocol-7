);
<[base.protocol-7.command.send.local]>->(
    {   'command'   => "models.get_model_recommendations",
        'call_args' =>
            { 'context' => 'batch_processing', 'task_id' => 'test_002' },
        'reply' => {
            'handler' => 'coding.handler.models_recommendations_reply',
            'params'  =>
                { 'context' => 'batch_processing', 'task_id' => 'test_002' }
        }
    }
);

# Test 5: models.record_invocation
<[base.log]>->(
    2, "[coding.test] Sending async request to models.record_invocation"
);
<[base.protocol-7.command.send.local]>->(
    {   'command'   => "models.record_invocation",
        'call_args' => {
            'model_amos' => 'llama-3.1-8b-instruct',
            'context'    => 'interactive',
            'success'    => 1
        },
        'reply' => {
            'handler' => 'coding.handler.models_record_invocation_reply',
            'params'  => {
                'model_amos' => 'llama-3.1-8b-instruct',
                'context'    => 'interactive',
                'success'    => 1
            }
        }
    }
);

# Test 6: models.find_best_alternative
<[base.log]>->(
    2, "[coding.test] Sending async request to models.find_best_alternative"
);
<[base.protocol-7.command.send.local]>->(
    {   'command'   => "models.find_best_alternative",
        'call_args' =>
            { 'primary_model_amos' => 'gpt-4', 'context' => 'streaming' },
        'reply' => {
            'handler' => 'coding.handler.models_find_alternative_reply',
            'params'  =>
                { 'primary_model_amos' => 'gpt-4', 'context' => 'streaming' }
        }
    }
);

<[base.log]>->(
    2, "[coding.test] All async requests sent, waiting for replies..."
);

return 1;

