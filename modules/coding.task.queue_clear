## [:< ##

# name = coding.task.queue_clear
# descr = remove completed tasks from queue and history
# purpose = Queue operation: Clean up finished work

# Get persistent storage refs
my $queue_ref     = <coding.task.queue>;
my $completed_ref = <coding.task.completed>;

my $cleared = scalar( @$completed_ref );

# Remove completed tasks from queue
foreach my $task_id ( @$completed_ref ) {
    delete $queue_ref->{$task_id};
}

# Clear completed list
@$completed_ref = ();

<[base.logs]>->( 1, "cleared %d completed tasks", $cleared );

return {
    success   => TRUE,
    cleared   => $cleared,
    remaining => scalar( keys %$queue_ref )
};

