## [:< ##

# name = coding.task.queue_clear
# descr = remove completed tasks from queue and history
# purpose = Queue operation: Clean up finished work

## persistent storage [array] refs ##
<coding.task.queue>     //= [];
<coding.task.completed> //= [];

my $cleared = scalar <coding.task.completed>->%*;

# Remove completed tasks from queue
foreach my $task_id ( <coding.task.completed>->@* ) {
    delete <coding.task.queue>->{$task_id};
}

# Clear completed list
<coding.task.completed> = [];

<[base.logs]>->( 1, "cleared %d completed tasks", $cleared );

return {
    success   => TRUE,
    cleared   => $cleared,
    remaining => scalar( keys <coding.task.queue>->%* )
};

