## [:< ##

# name = image-batch.cmd.process
# descr = Submit batch job for processing (expects YAML path as parameter)

my $call_args = shift;

# Extract parameter from command args hash
my $yaml_path;
if (defined $call_args && ref($call_args) eq 'HASH' && exists $call_args->{'param'}) {
    # Try 'arg0' first (positional), then 'yaml_path' or 'path'
    $yaml_path = $call_args->{'param'}->{'arg0'}
              // $call_args->{'param'}->{'yaml_path'}
              // $call_args->{'param'}->{'path'};
}

return { 'mode' => qw| FALSE |, 'data' => 'YAML batch file path required' } unless defined $yaml_path;
return { 'mode' => qw| FALSE |, 'data' => 'Path cannot be empty' } if $yaml_path eq '';

# Call the main image-batch.process module
my $result = <[image-batch.process]>->($yaml_path);

# Ensure result is valid before returning
return { 'mode' => qw| FALSE |, 'data' => 'Invalid result from batch process' } unless defined $result && ref($result) eq 'HASH';

# Return with proper network format
if ($result->{success}) {
    # Return as JSON string to avoid hash serialization issues
    require JSON::XS;
    my $json = JSON::XS::encode_json($result);
    return { 'mode' => qw| TRUE |, 'data' => $json };
} else {
    return { 'mode' => qw| FALSE |, 'data' => $result->{error} // 'Batch processing failed' };
}

