## [:< ##

# name  = letsencrypt.parent.handler_cert_ready
# descr = Handle successful certificate issuance or renewal from child process

my $msg = shift;

my $domain    = $msg->{domain};
my $cert_data = $msg->{cert};

<[base.log]>->( 2, "certificate ready for domain: $domain" );

## Store certificate info in parent registry
<letsencrypt.parent.certs> {$domain} = {
    issued_at   => time(),
    valid_until => $msg->{valid_until},
    fingerprint => $msg->{fingerprint},
    key_path    => $msg->{key_path},
    cert_path   => $msg->{cert_path},
    chain_path  => $msg->{chain_path} || undef,
};

## Write to disk
<[file.put]>->(
    sprintf( '%s/%s.pem', <letsencrypt.certs.dir>, $domain ),
    $cert_data, qw| :raw |
);

<[base.log]>->( 2, "saved certificate for $domain" );

## Update renewal timer tracking
delete <letsencrypt.parent.renewal_timers> {$domain}
    if exists <letsencrypt.parent.renewal_timers> {$domain};

## Update statistics
<letsencrypt.stats.renewals_completed>++;

<[base.log]>->( 2, "certificate updated for $domain" );

