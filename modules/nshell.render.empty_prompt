## [:< ##

# name = nshell.render.empty_prompt
# descr = Render empty prompt with cursor - centralized exit point from history

my ( $state_ref, $editor, $colors ) = @ARG;

## recover terminal state after raw-ANSI reply with no trailing newline
if ( <nshell.state>->{'needs_newline_prefix'} ) {
    print "\n\n";
    delete <nshell.state>->{'needs_newline_prefix'};
}

## Clear the line completely
print "\r\e[2K";

## Reset state to empty
$state_ref->{'display_buffer'}        = '';
$state_ref->{'current_mode'}          = 0;     # NORMAL mode
$state_ref->{'current_history_index'} = -1;    # Not in history mode

## Load empty into editor
AMOS7::TERM::editor_load( $editor, '' );

## Render the empty prompt with cursor
my $display_buffer = $colors{'p7_fg_0004'};
<[nshell.render.full_line]>->( $editor, $display_buffer, $colors );

return;

