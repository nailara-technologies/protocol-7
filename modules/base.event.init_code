## [:< ##

# name  = base.event.init_code

# <[base.perlmod.autoload]>->('Event'); # LLL: base.init_code

$Event::DebugLevel = 1;
$Event::DIED       = $code{'event.handler.exceptions'};

# setup io handler

<watcher_list.paused> = [];

$data{'watcher'}{'io'}{'transfer'} = Event->idle(
    cb     => $code{'event.callback.io-idle-restart'},
    repeat => 1
);

return 0;

