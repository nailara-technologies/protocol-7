## [:< ##

# name  = invoke.cmd.list-images
# descr = list recently generated images from invoke.ai

my $limit = int( $call->{'args'} // 20 );
$limit = 20 unless $limit > 0 and $limit <= 200;

my $url = $data{'invoke'}{'url'};
my $ua  = LWP::UserAgent->new( timeout => 10 );

## [ api endpoint : verify path against /openapi.json if needed ]
my $resp
    = $ua->get(
    "$url/api/v1/images/list?limit=$limit&order_by=created_at&order_dir=DESC"
    );

unless ( $resp->is_success ) {
    return {
        mode => qw| false |,
        data => sprintf( 'list failed [ %s ]', $resp->status_line )
    };
}

my $img_data = JSON::decode_json( $resp->decoded_content );
my @images   = @{ $img_data->{'items'} // [] };

unless (@images) {
    return { mode => qw| false |, data => 'no images found' };
}

my $out = '';
for my $img (@images) {
    my $name    = $img->{'image_name'} // '';
    my $created = $img->{'created_at'} // '';
    my $w       = $img->{'width'}      // 0;
    my $h       = $img->{'height'}     // 0;
    ## shorten timestamp to date+time
    $created =~ s|T| |;
    $created =~ s|\.\d+.*$||;
    $out .= sprintf "%-40s  %dx%d  %s\n", $name, $w, $h, $created;
}

return { mode => qw| size |, data => $out };

