# name  = models.registry.update_entry.update_model_entry
# descr = update a model entry in the registry and persist to YAML

my ( $model_amos, $updates ) = @ARG;

return 0 unless $model_amos && $updates;

my $registry = <models.registry> // {};
my $entry    = $registry->{$model_amos};

return 0 unless $entry;

## update allowed fields
foreach my $key ( keys %$updates ) {
    $entry->{$key} = $updates->{$key};
}

$entry->{updated_at} = time();

## persist to YAML [ single source of truth ]
<[models.storage.yaml_save]>->($registry);

return 1;

