## [:< ##

# name  = httpd.route.handler.iris-svg
# descr = serve BMW384 iris SVG : mode and params from query string

my $id      = shift;
my $session = $data{'session'}->{$id};

# [ parse query string from URI ]
my $uri = $session->{'http'}->{'request'}->{'uri'} // '';
my %qparam;
if ( $uri =~ m{\?(.+)$} ) {
    for my $ARG ( split m{&}, $1 ) {
        my ( $k, $v ) = split m{=}, $ARG, 2;
        $v //= '';
        $v =~ s{%([0-9a-fA-F]{2})}{chr(hex($1))}eg;
        $qparam{$k} = $v;
    }
}

my $mode       = $qparam{'mode'}       // 'ring';
my $rings      = $qparam{'rings'}      // 26;
my $param      = $qparam{'param'}      // '';
my $label_mode = $qparam{'label_mode'} // '';
my $ns         = $qparam{'ns'}         // '';
my $tl         = $qparam{'tl'}         // '';
my $intensity  = $qparam{'intensity'}  // '';
my $expanse    = $qparam{'expanse'}    // '';
my $dim        = $qparam{'dim'}        // '';

if ( $dim eq 'vertical' ) {
    $mode = 'vertical';
}
$rings = int($rings);
$rings = 1  if $rings < 1;
$rings = 63 if $rings > 63;

my $t0 = <[base.time]>->(3);

# [ populate local BMW384 index if needed : code_path = modules/ ]
if ( not scalar keys %{ <bmw384.index>->{'by_name'} // {} } ) {
    <[route.bmw384.index.from-path]>->();
}

<[base.logs]>->( 2, 'iris-svg index ready: %.3fs', <[base.time]>->(3) - $t0 );

# [ svg cache key ]
my $cache_key = join ':', $mode, $rings, $param, $label_mode, $ns, $tl,
    $intensity, $expanse, $dim;
<bmw384.svg.cache> //= {};

# [ oscilloscope: route to index zenka for cross-zenka zulum data ]
# [ uses SIZE reply pattern: index assembles complete SVG, fires reply handler ]
if ( $mode eq 'oscilloscope' ) {
    $session->{'http'}->{'close'} = 1;
    my $args_str = "svg $rings oscilloscope";
    <[protocol-7.route-send]>->(
        {   'command'   => 'index.visual-wheel',
            'call_args' => { 'args' => $args_str },
            'reply'     => {
                'handler' => 'httpd.handler.iris-svg.relay',
                'params'  => { 'http_sid' => $id },
            },
        }
    );
    return 0;    # [ deferred : reply handler writes response ]
}

if ( defined <bmw384.svg.cache>->{$cache_key} ) {
    my $svg = <bmw384.svg.cache>->{$cache_key};
    $session->{'buffer'}->{'output'} .= <[httpd.new_header]>->(
        200,
        {   'Content-Type'   => 'image/svg+xml',
            'Content-Length' => length($svg),
            'Cache-Control'  => 'no-cache',
        }
    );
    $session->{'buffer'}->{'output'} .= $svg;
    <[base.logs]>->(
        2,          'iris-svg cache hit [%s]: %.3fs',
        $cache_key, <[base.time]>->(3) - $t0
    );
    return 2;
}

# [ save cfg state ]
my $saved_mode        = <route.bmw384.cfg.visual_mode>;
my $saved_rings       = <route.bmw384.cfg.rings>;
my $saved_gauss       = <route.bmw384.cfg.gauss_arcs>;
my $saved_ns          = <route.bmw384.cfg.overlay_namespaces>;
my $saved_label_mode  = <route.bmw384.cfg.ring_label_mode>;
my $saved_ns_filter   = <route.bmw384.cfg.namespace_filter>;
my $saved_tl          = <route.bmw384.cfg.translucency_mode>;
my $saved_intensity   = <route.bmw384.cfg.translucency_intensity>;
my $saved_expanse     = <route.bmw384.cfg.translucency_expanse>;
my $saved_ledger_mode = <route.bmw384.cfg.ledger_mode>;
my $saved_dimension   = <route.bmw384.cfg.dimension_view>;

# [ apply request params ]
<route.bmw384.cfg.rings>       = $rings;
<route.bmw384.cfg.visual_mode> = $mode;

if ( length $dim ) {
    <route.bmw384.cfg.dimension_view> = $dim;
}

if ( length $label_mode ) {
    <route.bmw384.cfg.ring_label_mode> = $label_mode;
}

if ( length $param ) {
    if ( $mode eq 'gauss' ) {
        <route.bmw384.cfg.gauss_arcs> = $param;
    } elsif ( $mode eq 'overlay' ) {
        <route.bmw384.cfg.overlay_namespaces> = $param;
    }
}
if ( length $ns ) {
    <route.bmw384.cfg.namespace_filter> = $ns;
}
if ( length $tl and $tl =~ m{^\d$} ) {
    <route.bmw384.cfg.translucency_mode> = int($tl);
}
if ( length $intensity and $intensity =~ m{^\d*\.?\d+$} ) {
    <route.bmw384.cfg.translucency_intensity> = $intensity + 0;
}
if ( length $expanse and $expanse =~ m{^\d+$} ) {
    <route.bmw384.cfg.translucency_expanse> = int($expanse);
}

if ( $mode eq 'ledger' ) {
    <route.bmw384.cfg.ledger_mode> = 1;
}

my $svg = <[route.bmw384.visual.wheel-mode]>;

# [ add flying route elements ]
if ( $mode ne 'oscilloscope' ) {
    my $flying = <[route.bmw384.visual.flying-elements]>;
    $svg =~ s{</svg>}{$flying</svg>} if defined $flying and length $flying;
}

# [ add route commitment overlay ]
if ( $mode ne 'oscilloscope' ) {
    my $commitment = <[route.bmw384.visual.route-commitment]>;
    $svg =~ s{</svg>}{$commitment</svg>}
        if defined $commitment and length $commitment;
}

# [ restore cfg state ]
if ( defined $saved_mode ) {
    <route.bmw384.cfg.visual_mode> = $saved_mode;
} else {
    delete <route.bmw384.cfg.visual_mode>;
}
if ( defined $saved_rings ) {
    <route.bmw384.cfg.rings> = $saved_rings;
} else {
    delete <route.bmw384.cfg.rings>;
}
if ( defined $saved_gauss ) {
    <route.bmw384.cfg.gauss_arcs> = $saved_gauss;
} else {
    delete <route.bmw384.cfg.gauss_arcs>;
}
if ( defined $saved_ns ) {
    <route.bmw384.cfg.overlay_namespaces> = $saved_ns;
} else {
    delete <route.bmw384.cfg.overlay_namespaces>;
}
if ( defined $saved_label_mode ) {
    <route.bmw384.cfg.ring_label_mode> = $saved_label_mode;
} else {
    delete <route.bmw384.cfg.ring_label_mode>;
}
if ( defined $saved_ns_filter ) {
    <route.bmw384.cfg.namespace_filter> = $saved_ns_filter;
} else {
    delete <route.bmw384.cfg.namespace_filter>;
}
if ( defined $saved_tl ) {
    <route.bmw384.cfg.translucency_mode> = $saved_tl;
} else {
    delete <route.bmw384.cfg.translucency_mode>;
}
if ( defined $saved_intensity ) {
    <route.bmw384.cfg.translucency_intensity> = $saved_intensity;
} else {
    delete <route.bmw384.cfg.translucency_intensity>;
}
if ( defined $saved_expanse ) {
    <route.bmw384.cfg.translucency_expanse> = $saved_expanse;
} else {
    delete <route.bmw384.cfg.translucency_expanse>;
}
if ( defined $saved_ledger_mode ) {
    <route.bmw384.cfg.ledger_mode> = $saved_ledger_mode;
} else {
    delete <route.bmw384.cfg.ledger_mode>;
}
if ( defined $saved_dimension ) {
    <route.bmw384.cfg.dimension_view> = $saved_dimension;
} else {
    delete <route.bmw384.cfg.dimension_view>;
}

if ( not defined $svg ) {
    my $body = '{"error":"bmw384 index not initialized"}';
    $session->{'buffer'}->{'output'} .= <[httpd.new_header]>->(
        503,
        {   'Content-Type'   => 'application/json',
            'Content-Length' => length($body),
        }
    );
    $session->{'buffer'}->{'output'} .= $body;
    return 2;
}

if ( $mode ne 'oscilloscope' and $mode ne 'ledger' ) {
    <bmw384.svg.cache>->{$cache_key} = $svg;
}

<[base.logs]>->(
    2,          'iris-svg generated [%s]: %.3fs',
    $cache_key, <[base.time]>->(3) - $t0
);

$session->{'buffer'}->{'output'} .= <[httpd.new_header]>->(
    200,
    {   'Content-Type'   => 'image/svg+xml',
        'Content-Length' => length($svg),
        'Cache-Control'  => 'no-cache',
    }
);
$session->{'buffer'}->{'output'} .= $svg;

return 2;

