## [:< ##

# name  = httpd.route.handler.iris-svg
# descr = serve BMW384 iris SVG — mode and params from query string

my $id      = shift;
my $session = $data{'session'}->{$id};

# [ parse query string from URI ]
my $uri = $session->{'http'}->{'request'}->{'uri'} // '';
my %qparam;
if ( $uri =~ m{\?(.+)$} ) {
    for my $ARG ( split m{&}, $1 ) {
        my ( $k, $v ) = split m{=}, $ARG, 2;
        $v //= '';
        $v =~ s{%([0-9a-fA-F]{2})}{chr(hex($1))}eg;
        $qparam{$k} = $v;
    }
}

my $mode  = $qparam{'mode'}  // 'ring';
my $rings = $qparam{'rings'} // 26;
my $param = $qparam{'param'} // '';
$rings = int($rings);
$rings = 1  if $rings < 1;
$rings = 52 if $rings > 52;

# [ call index zenka via p7c — it holds the BMW384 index ]
my $cmd = "p7c index.visual-wheel svg $rings";
$cmd .= " $mode"  if $mode ne 'ring';
$cmd .= " $param" if length $param;

my $svg = '';
if ( open( my $fh, '-|', $cmd ) ) {
    local $INPUT_RECORD_SEPARATOR = undef;
    $svg = <$fh>;
    close $fh;
}
$svg = undef unless defined $svg and $svg =~ m{^<\?xml};

if ( not defined $svg ) {
    my $body = '{"error":"bmw384 index not initialized"}';
    $session->{'buffer'}->{'output'} .= <[httpd.new_header]>->(
        503,
        {   'Content-Type'   => 'application/json',
            'Content-Length' => length($body),
        }
    );
    $session->{'buffer'}->{'output'} .= $body;
    return 2;
}

$session->{'buffer'}->{'output'} .= <[httpd.new_header]>->(
    200,
    {   'Content-Type'   => 'image/svg+xml',
        'Content-Length' => length($svg),
        'Cache-Control'  => 'no-cache',
    }
);
$session->{'buffer'}->{'output'} .= $svg;

return 2;

