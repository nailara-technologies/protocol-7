## [:< ##

# name  = window.place.handler.button_press
# descr = begin drag or commit on double-click

my ( $widget, $event ) = @ARG;

my $ex = $event->x;
my $ey = $event->y;

my $w = <x11.window.width>  // 320;
my $h = <x11.window.height> // 240;

## right-click anywhere : submit, same as the enter key. commit is      ##
## deferred to button-release [ committing here would Gtk3->main_quit   ##
## and exit before the release event arrives, so the underlying         ##
## desktop would see an unmatched release and pop its context menu ].   ##
## switch to a thin cross cursor right away so the press itself signals ##
## the pending submit.                                                  ##
if ( $event->button == 3 ) {
    my $gdk_window = $widget->get_window;
    $gdk_window->set_cursor( Gtk3::Gdk::Cursor->new('tcross') )
        if defined $gdk_window;
    return TRUE;
}

my $region = <[window.place.classify_region]>->( $ex, $ey );

## double-click on body : re-center the window on the cursor [ also     ##
## compensates for the missed first drag under wslg/xwayland, letting   ##
## the user land the window without relying on drag at all ]            ##
if ( $region eq 'body' ) {
    my $now = <[base.time]>->(5);
    if ( defined <window.place.last_click>
        and ( $now - <window.place.last_click> ) < 0.3 ) {
        <[base.log]>->( 1, '[place.button_press] double-click re-center' );
        my $new_geom = {
            'x'      => int( $event->x_root - $w / 2 ),
            'y'      => int( $event->y_root - $h / 2 ),
            'width'  => $w,
            'height' => $h
        };
        <[window.place.damp.set_target]>->($new_geom);
        <[window.place.update_x11_state]>->($new_geom);
        delete <window.place.last_click>;
        return TRUE;
    }
    <window.place.last_click> = $now;
}

<window.place.drag.active>     = TRUE;
<window.place.drag.region>     = $region;
<window.place.drag.start_x>    = $event->x_root;
<window.place.drag.start_y>    = $event->y_root;
<window.place.drag.start_geom> = {
    'x'      => <x11.coordinates.left> // 0,
    'y'      => <x11.coordinates.top>  // 0,
    'width'  => <x11.window.width>     // $w,
    'height' => <x11.window.height>    // $h
};

<[base.logs]>->( 2, '[place.button_press] region=%s', $region );

return TRUE;

