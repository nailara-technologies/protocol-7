## [:< ##

# name  = window.place.handler.button_press
# descr = begin drag or commit on double-click

my ( $widget, $event ) = @ARG;

my $ex = $event->x;
my $ey = $event->y;

my $w = <x11.window.width>  // 320;
my $h = <x11.window.height> // 240;

my $region = <[window.place.classify_region]>->( $ex, $ey );

<window.place.drag.active>     = TRUE;
<window.place.drag.region>     = $region;
<window.place.drag.start_x>    = $event->x_root;
<window.place.drag.start_y>    = $event->y_root;
<window.place.drag.start_geom> = {
    'x'      => <x11.coordinates.left> // 0,
    'y'      => <x11.coordinates.top>  // 0,
    'width'  => <x11.window.width>     // $w,
    'height' => <x11.window.height>    // $h
};

## double-click commit on body ##
if ( $region eq 'body' ) {
    my $now = <[base.time]>->(5);
    if ( defined <window.place.last_click>
        and ( $now - <window.place.last_click> ) < 0.3 ) {
        <[base.log]>->( 1, '[place.button_press] double-click commit' );
        <[window.place.commit]>;
        return TRUE;
    }
    <window.place.last_click> = $now;
}

<[base.logs]>->( 2, '[place.button_press] region=%s', $region );

return TRUE;

