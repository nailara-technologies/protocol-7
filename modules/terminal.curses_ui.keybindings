## [:< ##

# name  = terminal.curses_ui.keybindings
# descr = shared keybinding definitions for curses UI widgets

return {
    'quit'    => [ 'q',  "\e" ],
    'up'      => [ 'k',  Curses::KEY_UP() ],
    'down'    => [ 'j',  Curses::KEY_DOWN() ],
    'select'  => [ "\n", Curses::KEY_ENTER() ],
    'filter'  => ['/'],
    'detail'  => [ 'd', "\n" ],
    'repair'  => ['r'],
    'refresh' => ['R'],
    'help'    => ['?'],
    }

