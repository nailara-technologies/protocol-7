# name = models.cmd.conversation_create
# descr = initialize conversation with token budget and template context

# Extract params - $call is set by code header
my $params = {};

if ( defined $call->{'param'} && ref $call->{'param'} eq qw| HASH | ) {
    $params = $call->{'param'};
} elsif ( defined $call->{'args'} && length $call->{'args'} ) {

    # Parse JSON from args
    eval { $params = JSON::PP::decode_json( $call->{'args'} ); };
    $params = {} if $EVAL_ERROR;
}

my $job_id       = $params->{'job_id'}        // '';
my $token_budget = $params->{'token_budget'}  // 4096;
my $template     = $params->{'template_name'} // 'default';
my $context      = $params->{'context'}       // 'conversation';

if ( !length($job_id) ) {
    return {
        'mode' => 'false',
        'data' => "error: job_id required\n"
    };
}

if ( $token_budget <= 0 ) {
    return {
        'mode' => 'false',
        'data' => "error: token_budget must be positive\n"
    };
}

# Initialize conversations registry if needed
<models.conversations> //= {};

# Check if conversation already exists
if ( exists <models.conversations>->{$job_id} ) {
    <[base.logs]>->( 2, "[$context] conversation exists : %s", $job_id );
    return {
        'mode' => 'false',
        'data' => "error: conversation exists: $job_id\n"
    };
}

my $start_time = <[base.time]>->(4);

## Initialize conversation structure
my $conversation = {
    'job_id'           => $job_id,
    'template_name'    => $template,
    'token_budget'     => $token_budget,
    'tokens_used'      => 0,
    'created_at'       => time(),
    'turns'            => [],
    'turn_count'       => 0,
    'last_compaction'  => 0,
    'compaction_count' => 0,
};

<models.conversations>->{$job_id} = $conversation;

<[base.log]>->(
    1,       "[$context] created: job_id=%s budget=%d",
    $job_id, $token_budget
);

## Update metrics
<models.metrics.conversations_active>++;
<models.metrics.conversations_completed> //= 0;

my $elapsed_ms = ( <[base.time]>->(4) - $start_time ) * 1000;

my $response = {
    'success'       => TRUE,
    'job_id'        => $job_id,
    'token_budget'  => $token_budget,
    'tokens_used'   => 0,
    'template_name' => $template,
    'created_at'    => $conversation->{'created_at'},
    'elapsed_ms'    => $elapsed_ms
};

my $json_data    = JSON::PP::encode_json($response);
my $is_multiline = $json_data =~ m|\n| ? 1 : 0;
return {
    'mode' => $is_multiline ? 'size' : 'true',
    'data' => $json_data . "\n"
};

