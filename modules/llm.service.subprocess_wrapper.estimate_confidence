# name  = llm.service.subprocess_wrapper.estimate_confidence
# descr = estimate confidence score from llama.cpp output
# param = $output

my ($output) = @ARG;

# very simple heuristic: if output is substantial, high confidence
return 0.5 + ( length($output) / 1000 ) * 0.4;

