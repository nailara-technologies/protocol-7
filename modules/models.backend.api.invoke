## [:< ##

# name = models.backend.api.invoke
# descr = API backend with rate limit detection for remote LLM models

my $params = shift;

my $participant_id = $params->{'participant_id'}  // '';
my $job_id         = $params->{'job_id'}          // '';
my $model_id       = $params->{'model_id'}        // '';
my $system_prompt  = $params->{'system_prompt'}   // '';
my $messages       = $params->{'messages'}        // [];
my $temperature    = $params->{'temperature'}     // 0.7;
my $max_tokens     = $params->{'max_tokens'}      // 4096;
my $timeout_secs   = $params->{'timeout_seconds'} // 30;
my $context        = $params->{'context'}         // qw| backend |;
my $reply_id       = $params->{'reply_id'};

return {
    'success' => FALSE,
    'error'   => 'participant_id required'
    }
    unless length($participant_id);

return {
    'success' => FALSE,
    'error'   => 'model_id required'
    }
    unless length($model_id);

unless ( ref($messages) eq qw| ARRAY | && scalar( $messages->@* ) > 0 ) {
    return {
        'success' => FALSE,
        'error'   => 'messages must be non-empty array'
    };
}

my $start_time = <[base.time]>->(4);

## Validate API key is configured
my $api_key = <models.api.key> // '';

unless ( length($api_key) ) {
    return {
        'success'        => FALSE,
        'model_id'       => $model_id,
        'participant_id' => $participant_id,
        'error'          => 'API key not configured',
        'elapsed_ms'     => ( <[base.time]>->(4) - $start_time ) * 1000
    };
}

## Build request payload
my $request_payload = {
    'model'       => $model_id,
    'messages'    => $messages,
    'temperature' => $temperature,
    'max_tokens'  => $max_tokens,
};

$request_payload->{'system'} = $system_prompt if length($system_prompt);

## Attempt API call with timeout
my $response_data = undef;
my $http_status   = 0;
my $api_error     = undef;

eval {
    ## Make HTTP POST request to Claude API
    my $ua = LWP::UserAgent->new();
    $ua->timeout($timeout_secs);
    my $request = HTTP::Request->new(
        POST => 'https://api.anthropic.com/v1/messages',
        [   'Content-Type'      => 'application/json',
            'x-api-key'         => $api_key,
            'anthropic-version' => '2023-06-01',
        ],
        JSON::PP::encode_json($request_payload)
    );

    my $response = $ua->request($request);
    $http_status = $response->code();

    ## Parse response
    if ( $response->is_success() ) {
        $response_data = JSON::PP::decode_json( $response->content() );
    } else {
        $api_error = $response->content() // "HTTP $http_status";
    }
};

if ( length $EVAL_ERROR ) {
    return {
        'success'        => FALSE,
        'model_id'       => $model_id,
        'participant_id' => $participant_id,
        'error'          => "API error: $EVAL_ERROR",
        'elapsed_ms'     => ( <[base.time]>->(4) - $start_time ) * 1000,
        'rate_limited'   => 0
    };
}

## Check for rate limit/quota errors (429, 400, 500 with quota patterns)
my $is_rate_limited = 0;
my $limit_type      = undef;

if ( $http_status == 429 ) {
    $is_rate_limited = 1;
    $limit_type      = 'rate_limit';
} elsif ( $http_status =~ m{^(400|402|403|500|502|503)$} ) {
    ## Check error response for quota/overload patterns
    if ( $api_error =~ m{quota|tokens|limit|overload|capacity|429}i ) {
        $is_rate_limited = 1;
        $limit_type = 'quota'      if $api_error =~ m{quota|tokens}i;
        $limit_type = 'overloaded' if $api_error =~ m{overload|capacity}i;
        $limit_type = 'rate_limit' unless $limit_type;
    }
}

if ($is_rate_limited) {
    <[base.logs]>->(
        1,
        "[$context] api limit detected: participant=%s model=%s type=%s status=%d",
        $participant_id,
        $model_id,
        $limit_type // 'unknown',
        $http_status
    );
    return {
        'success'        => FALSE,
        'model_id'       => $model_id,
        'participant_id' => $participant_id,
        'error'          => "API $limit_type limit: $api_error",
        'elapsed_ms'     => ( <[base.time]>->(4) - $start_time ) * 1000,
        'rate_limited'   => 1,
        'limit_type'     => $limit_type,
        'http_status'    => $http_status,
    };
}

## Check for other API errors (not rate limited)
unless ($response_data) {
    return {
        'success'        => FALSE,
        'model_id'       => $model_id,
        'participant_id' => $participant_id,
        'error'          => "API error: $api_error",
        'elapsed_ms'     => ( <[base.time]>->(4) - $start_time ) * 1000,
        'rate_limited'   => 0,
        'http_status'    => $http_status,
    };
}

## Extract response text from first choice
my $response_text = '';
if ( defined $response_data->{'content'}
    && ref $response_data->{'content'} eq 'ARRAY' ) {
    my $first_content = $response_data->{'content'}->[0];
    $response_text = $first_content->{'text'} // '';
}

unless ( length($response_text) ) {
    return {
        'success'        => FALSE,
        'model_id'       => $model_id,
        'participant_id' => $participant_id,
        'error'          => 'No response text in API response',
        'elapsed_ms'     => ( <[base.time]>->(4) - $start_time ) * 1000,
        'rate_limited'   => 0
    };
}

## Extract usage information if available
my $tokens_used = 0;
if ( defined $response_data->{'usage'} ) {
    $tokens_used = $response_data->{'usage'}->{'output_tokens'} // 0;
}

<[base.logs]>->(
    2, "[$context] api response: participant=%s model=%s tokens=%d",
    $participant_id, $model_id, $tokens_used
);

my $elapsed_ms = ( <[base.time]>->(4) - $start_time ) * 1000;

return {
    'success'        => TRUE,
    'model_id'       => $model_id,
    'participant_id' => $participant_id,
    'response'       => $response_text,
    'tokens_used'    => $tokens_used,
    'latency_ms'     => $elapsed_ms,
    'elapsed_ms'     => $elapsed_ms,
    'rate_limited'   => 0
};

