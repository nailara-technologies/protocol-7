## [:< ##

# name  = base.path.del_keyword
# descr = delete a path keyword from they list hash

my $key_name = shift // '';

if ( not length $key_name ) {
    <[base.s_warn]>->('expected key name parameter <{C1}>');
    return FALSE;
}

if ( not <[base.is_defined_recursive]>->(qw| base.path.keywords |) ) {
    <[base.s_warn]>->('keyword list is not initialized <{C1}>');
    return FALSE;
}
my $key_href = <base.path.keywords>;

if ( not <[base.is_defined_recursive]>->(qw| base.path.keywords |) ) {
    <[base.s_warn]>->('keyword list is not initialized <{C1}>');
    return FALSE;
}

return FALSE if not exists <base.path.keywords>->{$key_name};
delete <base.path.keywords>->{$key_name};    ## no such key present ##
return TRUE;                                 ## key-pair deleted ##

