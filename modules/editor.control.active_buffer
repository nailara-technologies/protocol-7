## [:< ##

# name  = editor.control.active_buffer
# descr = resolve the active field's buffer ref

## {fields} is keyed by field NAME while active_field is an INDEX into
## $schema->{fields} [ revision-2 indexing fix ] — always go through this
## helper instead of inlining the lookup.

my $editor_state = shift;

return undef if ref $editor_state ne qw| HASH |;

my $index = $editor_state->{'active_field'} // 0;
my $name  = $editor_state->{'schema'}{'fields'}[$index]{'name'}
    // return undef;

return $editor_state->{'fields'}{$name};

