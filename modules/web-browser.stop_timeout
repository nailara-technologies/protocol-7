## [:< ##

# name = web-browser.stop_timeout

delete <web-browser.timeout>;

if ( defined <web-browser.signal_id.load_timeout> ) {
    Glib::Source->remove( delete <web-browser.signal_id.load_timeout> );
    <[base.log]>->( 2, "..load timeout stopped.." );
}

