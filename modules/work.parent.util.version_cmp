## [:< ##

# name  = work.parent.util.version_cmp
# descr = compare two version strings

my ( $a, $b ) = @ARG;
my @a_parts = split m|\.|, $a;
my @b_parts = split m|\.|, $b;

for ( my $i = 0; $i < 3; $i++ ) {
    my $cmp = ( $a_parts[$i] || 0 ) <=> ( $b_parts[$i] || 0 );
    return $cmp if $cmp != 0;
}

return FALSE;

