#\\\|4P4HYFDGWIIJ4ZAGPJCDY6X3I2PLWBHELCM23APLDMER3N7QZP3 \ / AMOS7 \ YOURUM ::
#\[7]KDGLEWSA54XTGVIKHO22SVXV5VQLAXIXJKJ2YUAZHE7WILFTAUCY 7  DATA SIGNATURE ::
