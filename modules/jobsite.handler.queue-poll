## [:< ##

# name  = jobsite.handler.queue-poll
# descr = timer handler : ask site-yaml for its async fetch queue depth

<[protocol-7.route-send]>->(
    {   'command' => qw| site-yaml.queue-depth |,
        'reply' => { 'handler' => qw| jobsite.handler.queue-depth-reply |, },
    }
);

return;

