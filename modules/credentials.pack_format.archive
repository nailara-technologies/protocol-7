## [:< ##

# name  = credentials.pack_format.archive
# descr = pack a credential hash into archive payload format

my $cred = shift;

return undef
    if ref $cred ne qw| HASH |
    or not defined $cred->{'name'}
    or not length $cred->{'name'};

my $yaml_str = eval { YAML::XS::Dump($cred) };
if ($@) {
    <[base.logs]>->( 0, 'credentials: yaml dump failed: %s', $@ );
    return undef;
}

$yaml_str =~ s|\n|\\n|g;    ## preserving linefeeds ##

my $payload
    = "## [:< ##\n#.\n"
    . sprintf( "['credential']%s\n", $yaml_str )
    . "#.\n#.::\n";

return \$payload;

