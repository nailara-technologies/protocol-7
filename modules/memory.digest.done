## [:< ##

# name = memory.digest.done
# descr = reply handler: forward prose digest to caller

my $reply   = shift;
my $params  = $reply->{'params'}      // {};
my $key     = $params->{'digest_key'} // '';
my $cmd     = $reply->{'cmd'}         // '';
my $summary = $reply->{'data'}        // '';

return FALSE unless length $key;

my $reply_id = delete( <memory.digest.pending>->{$key} );
return FALSE unless defined $reply_id;

my $mode
    = ( $cmd eq 'SIZE' or index( $summary, "\n" ) >= 0 ) ? 'size' : 'true';

<[base.callback.cmd_reply]>->(
    $reply_id, { 'mode' => $mode, 'data' => $summary }
);

return TRUE;

