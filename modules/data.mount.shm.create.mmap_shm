## [:< ##

# name = data.mount.shm.create.mmap_shm
# desc = mmap POSIX SHM segment

my ( $fd, $size ) = @_;

if ( eval { require Sys::Mmap } ) {
    my $var;
    Sys::Mmap::mmap( $var, $size,
        Sys::Mmap::PROT_READ() | Sys::Mmap::PROT_WRITE(),
        Sys::Mmap::MAP_SHARED(), $fd, 0 );
    return \$var if length($var) > 0;
}

return undef;

