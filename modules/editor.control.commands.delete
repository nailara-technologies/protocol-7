## [:< ##

# name  = editor.control.commands.delete
# descr = delete CHARACTER range [start,end) from a field buffer

my ( $editor_state, $field, $start, $end ) = @ARG;

return undef if ref $editor_state ne qw| HASH |;
my $buffer = $editor_state->{'fields'}{$field} // return undef;

return <[editor.buffer.memory.delete]>->( $buffer, $start, $end );

