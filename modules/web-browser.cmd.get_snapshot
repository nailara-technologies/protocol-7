## [:< ##

# name  = web-browser.cmd.get_snapshot
# descr = capture visible viewport of foreground view to PNG

my $reply_id   = $call->{'reply_id'};
my $region_arg = $call->{'args'};

## get the active foreground view
my $view_index = <web-browser.overlay.index.fg> // 1;
my $view       = <web-browser.gtk_obj.view>->{$view_index};

return { 'mode' => qw| false |, 'data' => 'no active view' }
    unless defined $view;

## determine output path
my $snap_dir = <web-browser.cfg.snapshot_dir>
    // ( <system.root_path> . '/data/snapshots' );
my $stamp    = <[base.ntime.b32]>->( 5, TRUE );
my $out_path = "$snap_dir/snapshot-$stamp.png";

## ensure output directory exists
<[file.make_path]>->($snap_dir) unless -d $snap_dir;

my $region
    = defined($region_arg) && length($region_arg)
    ? $region_arg
    : <web-browser.cfg.snapshot_region> // 'visible';

## async snapshot : result delivered via handler
<web-browser.snapshot.pending_path>  = $out_path;
<web-browser.snapshot.pending_reply> = $reply_id;

eval {
    $view->get_snapshot(
        $region,
        'WEBKIT_SNAPSHOT_OPTIONS_NONE',
        undef,    ## cancellable
        $code{'web-browser.handler.snapshot_result'},
        undef     ## user_data
    );
};

if ($EVAL_ERROR) {
    <web-browser.snapshot.pending_path>  = undef;
    <web-browser.snapshot.pending_reply> = undef;
    return {
        'mode' => qw| false |,
        'data' => <[base.str.eval_error]>
    };
}

## return deferred : handler sends reply when snapshot completes
return { 'mode' => 'deferred' };

