# name  = site-yaml.cmd.confirm-stray-claimed
# descr = jobsite confirmed it stored a stray job, safe to delete
#
# notes = see site-yaml.cmd.export-stray-job

my $id = $call->{'args'} // '';

return { 'mode' => 'false', 'data' => 'id required' } if not length $id;

my $entry = <site-yaml.stray_manifest>->{$id};
return { 'mode' => 'true', 'data' => 'already gone' } if not defined $entry;

my $jobs_root = <[file.zenka_dir.data_path]> . '/jobs';
my $job_file  = "$jobs_root/$entry->{'status'}/$entry->{'name'}.yaml";

unlink $job_file if -f $job_file;
delete <site-yaml.stray_manifest>->{$id};

return { 'mode' => 'true', 'data' => "claimed: $id" };

