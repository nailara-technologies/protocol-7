## [:< ##

# name = models.config.loader
# descr = Load model configuration from YAML file into models data structure

my $config_root = <system.conf_path>;
my $config_file = catfile( $config_root, qw| zenki/models/models.yaml | );

unless ( -f $config_file ) {
    <[base.logs]>->( 2, "[config] Config file not found : %s", $config_file );
    return 0;
}

my $yaml = YAML::Tiny::Load( <[file.slurp]>->($config_file)->$* );

unless ($yaml) {
    <[base.logs]>->( 2, "[config] Failed to parse YAML : %s", $config_file );
    return 0;
}

# Load model definitions into data structure
if ( exists $yaml->{'models'} && ref( $yaml->{'models'} ) eq qw| HASH | ) {
    $data{models}{definitions} = $yaml->{'models'};
    my $count = scalar( keys $yaml->{'models'}->%* );
    <[base.logs]>->( 1, "[config] loaded %d model definitions", $count );
}

# Load aliases into data structure
if ( exists $yaml->{'aliases'} && ref( $yaml->{'aliases'} ) eq qw| HASH | ) {
    <models.aliases> = $yaml->{'aliases'};
    my $count = scalar( keys $yaml->{'aliases'}->%* );
    <[base.logs]>->( 1, "[config] loaded %d model aliases", $count );
}

<[base.log]>->( 1, "[config] Model configuration loaded successfully" );

return 0;

