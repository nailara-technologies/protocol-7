## [:< ##
# name  = plan-9.protocol.codec.encode-message
# descr = Encode 9P message header

return sub {
    my ( $type, $tag, $payload ) = @_;
    $tag //= 0xFFFF;
    my $size = 4 + 1 + 2 + length($payload);
    return pack( 'V C v', $size, $type, $tag ) . $payload;
};

