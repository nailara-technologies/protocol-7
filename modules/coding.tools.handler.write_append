## [:< ##

# name  = coding.tools.handler.write_append
# descr = append content to existing file with staging support
# param = $args[{path,content,encoding}], encoding defaults to UTF-8

my $args     = shift               // {};
my $path     = $args->{'path'}     // return 'path required';
my $content  = $args->{'content'}  // return 'content required';
my $encoding = $args->{'encoding'} // qw| :encoding(UTF-8) |;

my $root     = <system.root_path>;
my $abs_path = "$root/$path";

## auto-prefix modules/ for dot-notation filenames without directory ##
if ( $path !~ m|/| and $path =~ m|[.]\w+[.]| ) {
    $path     = "modules/$path";
    $abs_path = "$root/$path";
}

## validate path stays within project [ resolve symlinks ] ##
my $real_root = Cwd::abs_path($root)                           // '';
my $real_dir  = Cwd::abs_path( ( $abs_path =~ s|/[^/]+$||r ) ) // '';
return 'error: path escapes project root'
    if !length $real_dir
    or index( $real_dir, "$real_root/" ) != 0
    or $path =~ m|\.\./|;

## normalize encoding parameter ##
my $norm_encoding = <[coding.parser.normalize_encoding]>->($encoding);
return
      ': error : unsupported encoding : '
    . $encoding
    . ' [ supported are :raw, :bytes, :encoding(UTF-8), :encoding(<other>)]'
    unless length( $norm_encoding // '' );

## file must exist to append ##
return "error: file does not exist [ $path ]" if !-f $abs_path;

## use chmod child to gain write access if needed ##
my $chmod_fh = <coding.chmod_child.w_fh>;
my $mode_restore;
if ( !-w $abs_path and defined $chmod_fh ) {
    my $cur_mode = ( stat $abs_path )[2] // 0644;
    $cur_mode &= 07777;
    print {$chmod_fh} "gw $abs_path\n";
    <[coding.chmod_child.readline]>;    ## wait for gw to complete ##
    $mode_restore = $cur_mode if -w $abs_path;
}

if ( -w $abs_path ) {
    ## file is writable : append content ##
    my $result = <[file.append]>->( $abs_path, \$content, $norm_encoding );
    if ( defined $mode_restore and defined $chmod_fh ) {
        print {$chmod_fh} sprintf "restore %04o %s\n", $mode_restore,
            $abs_path;
        <[coding.chmod_child.readline]>;    ## consume restore reply ##
    }
    return undef if not $result;
    return sprintf "appended %s [ %d bytes ]", $path, length($content);
}

## stage to zenka dir when no write access ##
my $stage_name = $path;
$stage_name =~ s|/|__|g;
my $stage_rel = "staged/$stage_name";
<[file.zenka_dir.write]>->(
    $stage_rel, \$content, qw| >> |, 0664, $norm_encoding
);
<[base.logs]>->(
    1, ':. write_append: staged append %s [ no write access ]', $path
);
return sprintf "staged append to %s [ %d bytes, no write access ]\n"
    . "staged at: %s",
    $path, length($content), $stage_rel;

