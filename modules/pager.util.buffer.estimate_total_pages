# name  = pager.util.buffer.estimate_total_pages
# descr = estimate total pages from what we have seen

my ($buf) = @ARG;

if ( $buf->{'source'}{'total'} ) {
    return int( $buf->{'source'}{'total'} / $buf->{'pages'}{'size'} ) + 1;
}

## estimate based on items seen ##
return undef unless $buf->{'stats'}{'items_seen'} > 0;

## conservative estimate: what we have seen is just the beginning ##
return int( $buf->{'stats'}{'items_seen'} * 2 / $buf->{'pages'}{'size'} ) + 1;

