## [:< ##

# name  = editor.ui.ascii_frame.render_form
# descr = render editor state as ascii-art form via ascii.frame backend
# param = $editor_state, $frame_name [ , $only_field ]

## rendering backend for the editor.ui.* contract [ design doc :
## editor-namespace-interface-design.yaml ]. builds a FRESH values hash from
## editor.control.get_display_value on every call [ no live slot binding —
## ascii.frame.slot.bind deliberately not used here ].
##
## focus indication : ascii.frame slot prefix/suffix are static [ part of the
## descriptor, not the values ], so the ACTIVE field's value itself is
## bracket-wrapped and given a '|' cursor marker at the character offset from
## editor.control.get_cursor before entering the values hash.  inactive fields
## render their plain value.
##
## cursor-marker width note [ hand-traced against ascii.frame.render ] : the
## marker [ and brackets ] are counted BOTH in the required_width computation
## AND in the render-time fill calculation — both use length() of the same
## value string — so row alignment stays exact. do NOT strip the marker from
## width accounting : fill_width would clamp at 0 and the row would overflow
## the right border by the marker count.
##
## frame width is INVARIANT under focus changes, and both halves below are
## what make it so : an unfocused value gets pad_l/pad_r where a focused one
## gets its brackets, and the cursor is OVERLAID into a reserved cell rather
## than appended.  every value is therefore length + 4 whether focused or not.
## [ this replaces an earlier note here warning of a 3-column shift : that was
## true before the pads and the reserved cell existed, and left behind it a
## jump to go looking for that is no longer there. ]

my ( $editor_state, $frame_name, $only_field, $marks ) = @ARG;

## the cursor marker is parameterisable so a COLOURED caller can pass a
## one-character placeholder [ e.g. "\x01" ], colourise the finished frame,
## then substitute a coloured cursor into it afterwards.  it must stay ONE
## character here : both the required-width computation and the render-time
## fill padding measure it with length(), so an ansi sequence passed in
## directly would silently break row alignment
$marks = {} if ref $marks ne qw| HASH |;

my %mark = (
    qw| cursor |  => q{|},
    qw| focus_l | => q{[},
    qw| focus_r | => q{]},
    qw| pad_l |   => q{ },
    qw| pad_r |   => q{ },
);

foreach my $key ( keys %mark ) {
    $mark{$key} = $marks->{$key}
        if defined $marks->{$key}
        and length $marks->{$key} == 1;
}

my $cursor_marker = $mark{'cursor'};

return undef if ref $editor_state ne qw| HASH |;
return undef if not defined $frame_name or not length $frame_name;
return undef if ref $editor_state->{'schema'}{'fields'} ne qw| ARRAY |;

my $entry = <[ascii.frame.load]>->($frame_name);
return undef if not defined $entry;

## resolve descriptor [ single-mode frame, or first declared mode ] ##
my $descriptor;
if ( exists $entry->{'descriptor'} ) {
    $descriptor = $entry->{'descriptor'};
} elsif ( exists $entry->{'descriptors'} ) {
    my $mode = $entry->{'modes'}[0] // qw| expanded |;
    $descriptor = $entry->{'descriptors'}{$mode};
}
return undef if not defined $descriptor;

## active field NAME [ active_field is an index into schema fields ] ##
my $active_index = $editor_state->{'active_field'} // 0;
my $active_name  = $editor_state->{'schema'}{'fields'}[$active_index]{'name'}
    // '';

## build fresh values hash from live field state ##
my %values;
foreach my $field_def ( $editor_state->{'schema'}{'fields'}->@* ) {
    my $name = $field_def->{'name'} // next;

    ## MULTILINE field : see user-edit-multiline-note.yaml. handled entirely
    ## separately and skips the generic per-field body below -- a raw '\n'
    ## reaching a single ascii.frame slot [ what get_display_value would
    ## return unmodified for an ordinary scalar ] would corrupt the frame's
    ## row layout, so this writes windowed per-line slots [ '<name>_0' ..
    ## '<name>_<cap-1>', plus '<name>_scrollinfo' -- all reserved
    ## unconditionally by user-edit.form.build_frame ] instead of $name
    ## itself, which carries no token in the generated frame at all
    if ( $field_def->{'multiline'} ) {

        my $text = <[editor.control.get_value]>->( $editor_state, $name )
            // '';
        my $lines      = <[editor.control.multiline.lines]>->($text);
        my $total      = scalar $lines->@*;
        my $cap        = <[editor.control.list.window_cap]>;
        my $max_offset = $total > $cap ? $total - $cap : 0;

        my $is_active = ( $name eq $active_name );

        my ( $cursor_line, $cursor_col ) = ( -1, 0 );
        if ($is_active) {
            my $cursor
                = <[editor.control.get_cursor]>->( $editor_state, $name )
                // 0;
            ( $cursor_line, $cursor_col )
                = <[editor.control.multiline.cursor_line]>
                ->( $text, $cursor );
        }

        ## AUTO-SCROLL-TO-CURSOR : only the active field's own edits can ever
        ## move the cursor outside the current window, so this only adjusts
        ## while focused here -- an unfocused multiline field's window stays
        ## exactly where PgUp/PgDn last left it [
        ## user-edit.form.scroll_multiline ], same as a list's does
        my $offset = $field_def->{'multiline_offset'} // 0;
        $offset = 0           if $offset < 0;
        $offset = $max_offset if $offset > $max_offset;
        if ( $is_active and $cursor_line >= 0 ) {
            $offset = $cursor_line if $cursor_line < $offset;
            $offset = $cursor_line - $cap + 1
                if $cursor_line > $offset + $cap - 1;
            $offset = 0           if $offset < 0;
            $offset = $max_offset if $offset > $max_offset;
        }
        $field_def->{'multiline_offset'} = $offset;

        ## per-row viewport budget, derived from the frame's OWN already-
        ## computed width floor -- see the 'MULTILINE VIEWPORT' section of
        ## user-edit-address-cluster-plugin.yaml. a multiline field's body
        ## never contributes to min_width [ user-edit.form.build_frame's
        ## $display_length returns 0 for it ], so this reads a floor computed
        ## entirely from everything ELSE in the form -- no circularity.
        ## label_width + 10 mirrors build_frame's own row-prefix accounting [
        ## '   %*s:  ' = label_width + 6, plus this block's own +4 pad/cursor
        ## reservation ]. floored, not tuned to exact pixel precision -- a
        ## soft display cap, adjust the floor/subtraction against what
        ## actually renders, not a structural invariant.
        ##
        ## NOTE : this module is generic editor.ui.* [ ascii.frame render
        ## backend, zenka-agnostic ] reading 'label_width' off the descriptor
        ## -- a key only user-edit.form.build_frame sets, not part of this
        ## module's own generic frame contract. the '// 0' fallback means any
        ## OTHER caller [ a frame built some other way, without that key ]
        ## just gets a wider budget rather than breaking -- silent, not
        ## unsafe, but worth knowing this is a cross-layer reach, not a
        ## documented contract field
        my $viewport_width
            = ( $descriptor->{'min_width'}   // 0 )
            - ( $descriptor->{'label_width'} // 0 )
            - 10;
        $viewport_width = 20 if $viewport_width < 20;

        foreach my $i ( 0 .. $cap - 1 ) {
            my $line_index = $offset + $i;
            my $line_text = $line_index < $total ? $lines->[$line_index] : '';
            my $slot_name = sprintf( '%s_%d', $name, $i );

            ## only the ONE row actually holding the cursor is marked as
            ## focused -- the rest of the block renders plain, the same
            ## single-row highlight convention an expanded list already uses [
            ## only its 'active_field' row gets brackets, siblings do not ]
            my $is_cursor_row
                = ( $is_active and $line_index == $cursor_line );

            ## bound this ONE line to the row's width budget -- non-
            ## destructively [ editor.control.multiline.viewport_slice ], the
            ## stored text itself never changes, only what this render shows.
            ## cursor-following only on the row that actually holds it ; every
            ## other overlong row windows from its own start
            my $display_col;
            ( $line_text, $display_col )
                = <[editor.control.multiline.viewport_slice]>->(
                $line_text, $viewport_width,
                $is_cursor_row ? $cursor_col : undef
                );

            my $display = q{ } . $line_text . q{ };

            if ($is_cursor_row) {
                my $c = ( $display_col // $cursor_col ) + 1;
                $c = length($display) - 1 if $c > length($display) - 1;
                substr( $display, $c, 1 ) = $cursor_marker;
            }

            $values{$slot_name}
                = $is_cursor_row
                ? $mark{'focus_l'} . $display . $mark{'focus_r'}
                : $mark{'pad_l'} . $display . $mark{'pad_r'};
        }

        ## always present in the frame [ build_frame's own reasoning for
        ## reserving it unconditionally ], left blank under the cap rather
        ## than omitted -- reads as a reserved blank row, same as an under-cap
        ## list's own reservation
        my $info_slot = sprintf( '%s_scrollinfo', $name );
        $values{$info_slot}
            = $total > $cap
            ? $mark{'pad_l'}
            . <[editor.control.list.window_info]>->(
            $offset + 1,
            ( $offset + $cap > $total ? $total : $offset + $cap ), $total
            )
            . $mark{'pad_r'}
            : '';

        next;
    }

    ## ADD-A-FIELD CYCLER : see the 'user-edit form: horizontal-scroll
    ## add-a-field cycler' design. handled entirely separately from the
    ## generic per-field body below, same reason the multiline block above is
    ## -- this row's display is not its stored value at all [ 'choices' +
    ## 'choice' index, editor.control.cycler.set ], and windowing it needs
    ## live auto-scroll state persisted on the field def, the same live-
    ## reference-through-$editor_state pattern 'multiline_offset' above
    ## already uses, just over discrete CELLS instead of characters.
    if ( $field_def->{'add_field'} ) {

        my @choices = grep { defined $ARG and length $ARG }
            ( $field_def->{'choices'} // [] )->@*;

        my $current = $field_def->{'choice'} // 0;
        $current = 0 if $current < 0 or $current > $#choices;

        my $width = <[editor.control.cycler.window_width]>;

        my $cell_width = sub {
            my ($index) = @ARG;
            return length( $choices[$index] ) + 2;
        };

        my $offset = $field_def->{'cycler_offset'} // 0;
        $offset = 0 if $offset < 0 or $offset > $#choices;

        ## SETTLE : lookahead-margin scrolling, modeled on nshell.render.
        ## viewport's own view_offset -- holds the window steady until an edge
        ## is reached rather than recentering on every step, right for a
        ## cycler since Left/Right move one discrete choice at a time and
        ## constant recentering would reshuffle every neighbour on every
        ## keystroke instead
        if ( $current < $offset ) {

            ## scrolled past the LEFT edge : current becomes leftmost ##
            $offset = $current;

        } else {

            ## does $current already fit in the window forward-packed from the
            ## CURRENT $offset? both markers reserved unconditionally, same
            ## trick editor.control.cycler.render_windowed itself uses
            my $body_width = $width - 2;
            $body_width = 0 if $body_width < 0;

            my $sum = 0;
            for ( my $i = $offset; $i <= $current; $i++ ) {
                $sum += $cell_width->($i);
                last if $sum > $body_width;
            }

            if ( $sum > $body_width ) {

                ## scroll RIGHT : a single backward pack from $current, not an
                ## $offset++ loop -- see the design's own trace for why that
                ## earlier draft was wrong [ walks the whole vocabulary
                ## re-packing on every step, converges to $current pinned at
                ## the LEFT edge instead of the RIGHT -- "scrolled way too
                ## far," not "scrolled just enough" ].  current's own cell is
                ## always included as the base case, even if it alone exceeds
                ## $body_width -- render_windowed makes the same guarantee for
                ## the same reason : the marker must never simply vanish
                my $new_offset = $current;
                my $acc        = $cell_width->($current);
                for ( my $i = $current - 1; $i >= 0; $i-- ) {
                    my $w = $cell_width->($i);
                    last if $acc + $w > $body_width;
                    $acc += $w;
                    $new_offset = $i;
                }
                $offset = $new_offset;
            }
        }

        $offset = 0 if $offset < 0 or $offset > $#choices;
        $field_def->{'cycler_offset'} = $offset;

        my $value = <[editor.control.cycler.render_windowed]>->(
            \@choices, $current, $offset, $width
        );

        ## no inner reservation : render_windowed's own per-choice cells
        ## already carry the padding a value elsewhere gets from the
        ## pad+cursor-cell reservation below, and this row is never cursor-
        ## bearing [ its value is a choice index, not text -- see the generic
        ## $cursor_bearing exclusion this replaces ]
        $values{$name}
            = $name eq $active_name
            ? $mark{'focus_l'} . $value . $mark{'focus_r'}
            : $mark{'pad_l'} . $value . $mark{'pad_r'};

        next;
    }

    ## DISPLAY value, never the stored one — a masked field must not reach the
    ## screen in clear text [ editor.control.get_display_value ]
    my $value
        = <[editor.control.get_display_value]>->( $editor_state, $name )
        // '';

    ## a field whose DISPLAY value is a summary rather than its editable text
    ## has no meaningful character position -- overlaying a cursor there just
    ## corrupts the summary.  the bracket wrapping alone marks focus for those
    ## [ collapsed list fields ]  neither a collapsed list nor a menu row has
    ## a meaningful character position -- both DISPLAY something other than
    ## editable text, so a cursor overlaid there marks nothing and corrupts
    ## the label.  the focus framing alone shows which row is active.
    ## list_info [ a windowed list's 'start-end of total' row,
    ## editor.control.list.expand ] joins them for the same reason -- it is
    ## READ-ONLY text about the list, not a value belonging to it
    ##
    ## 'plugin' joins them too, REAL BUG found live while building the
    ## address-cluster plugin, not specific to it : get_cursor's offset is
    ## into the RAW STORED BUFFER, but a plugin's display_override is free to
    ## return an ARBITRARILY RESTRUCTURED string [ decorated, reordered, a
    ## different entry's text entirely -- whatever the plugin's own tab_info
    ## /render contract decides ] with no positional relationship to that raw
    ## offset at all. overlaying the generic marker there lands it at a
    ## meaningless position instead of corrupting nothing -- worse than the
    ## list-summary case above, since a restructured string is more likely to
    ## have SOME character sitting at that offset, silently misleading rather
    ## than visibly broken. a plugin wanting its own cursor indication draws
    ## one itself, exactly as this exclusion already expects every other
    ## member of this list to  'add_field' no longer appears here -- that row
    ## now ends in its own 'next' above, before this point is ever reached
    my $cursor_bearing = not( $field_def->{'list'}
        or $field_def->{'menu_row'}
        or $field_def->{'list_info'}
        or $field_def->{'plugin'} );

    if ( $field_def->{'list'} ) {

        ## a collapsed list's summary text [ '< 2 entries >' ] is a COUNT
        ## standing in for a value, not a value itself -- per user, shown two
        ## columns CLOSER to its label's colon than a real value would be, so
        ## it reads as non-value at a glance while tabbing past it rather than
        ## sitting at the identical column every real value does.  BOTH the
        ## inner leading pad AND the outer pad_l [ below ] are dropped for
        ## this row ; the trailing cursor cell and outer pad_r stay, since
        ## there is still a closing bracket or pad-mark to keep the text off.
        ## deliberately asymmetric -- symmetry is what makes this
        ## indistinguishable from a value in the first place
        ##
        ## relies on a list field never being FOCUSED while still collapsed [
        ## user-edit.form.sync_list_mode expands it on every arrival, so no
        ## render ever observes the two together ] -- otherwise this would
        ## violate the frame-width-invariant-under-focus this module states up
        ## top, since a focused row uses the bracket marks instead of
        ## pad_l/pad_r and this row's own outer pad_l is no longer their equal
        ## width
        $value = $value . q{ };

    } else {

        ## TWO reserved cells : <pad><value><cursor cell>.
        ##
        ## the CURSOR CELL gives a cursor sitting past the last character
        ## somewhere to live -- without it the marker is appended instead,
        ## growing the value by one and stepping the closing bracket [ and the
        ## whole frame ] right as soon as you reach the end of a field.
        ##
        ## the LEADING pad keeps the value off its opening framing character.
        ## the trailing side has no separate pad of its own any more -- per
        ## user, the right side was carrying one more reserved column than the
        ## left [ pad + cursor cell vs. just pad ], which read as asymmetric.
        ## the cursor cell now doubles as the trailing pad : an end-of-line
        ## cursor sits flush against the closing bracket, e.g. '[ Taeki Ten_]'
        ## rather than '[ Taeki Ten_ ]' -- a deliberate reversal of the '[ _]'
        ## this used to be written to avoid.
        ##
        ## constant length + 4 with the framing, focused or not
        $value = q{ } . $value . q{ };

        if ( $name eq $active_name and $cursor_bearing ) {

            ## OVERLAY, not insert [ nshell.render.cursor's shape ] : the
            ## marker REPLACES the character it sits on, so the row keeps its
            ## width and a colourising caller can restore that character in
            ## inverse video -- the character under the cursor stays readable.
            ## the reserved cell above guarantees there is always something to
            ## overlay +1 for the leading reserved cell : the editor's cursor
            ## offset is into the VALUE, while this string now carries a cell
            ## in front of it.  clamped so it can reach the trailing cell but
            ## not the leading one
            my $cursor
                = <[editor.control.get_cursor]>->( $editor_state, $name )
                // 0;
            $cursor = 0 if $cursor < 0;
            $cursor++;
            $cursor = length($value) - 1 if $cursor > length($value) - 1;

            substr( $value, $cursor, 1 ) = $cursor_marker;
        }
    }

    ## framing : brackets when focused, matching spaces when not, so a value
    ## occupies the same columns either way and nothing shifts sideways --
    ## except a collapsed list's summary, whose outer LEADING pad is dropped
    ## too [ see the 'list' branch above for why that is safe here ]
    my $row_pad_l = $field_def->{'list'} ? '' : $mark{'pad_l'};

    $value
        = $name eq $active_name
        ? $mark{'focus_l'} . $value . $mark{'focus_r'}
        : $row_pad_l . $value . $mark{'pad_r'};

    $values{$name} = $value;
}

## single-field scope : narrow the descriptor to the requested slot ##
if ( defined $only_field ) {
    my $slot = $descriptor->{'slots'}{$only_field} // return undef;
    $descriptor = {
        'border' => {
            'left'   => $descriptor->{'border'}{'left'},
            'right'  => $descriptor->{'border'}{'right'},
            'top'    => [],
            'bottom' => [],
        },
        'padding' => {
            'left'  => $descriptor->{'padding'}{'left'}  // 0,
            'right' => $descriptor->{'padding'}{'right'} // 0,
        },
        ## carried, or a single-row redraw comes out NARROWER than the frame
        ## it is patching : min_width is the width its whole form reserved,
        ## and this row on its own has no idea what the others needed
        'min_width' => $descriptor->{'min_width'} // 0,
        'slots'     => { $only_field => { %{$slot}, 'row' => 1 } },
    };
    %values = ( $only_field => $values{$only_field} // '' );
}

return <[ascii.frame.render]>->(
    {   'descriptor' => $descriptor,
        'values'     => \%values,
    }
);

