# name = models.cmd.test_api_limit
# descr = command wrapper for testing API limit detection

my $params = {};

if ( defined $call->{'param'} && ref $call->{'param'} eq qw| HASH | ) {
    $params = $call->{'param'};
} elsif ( defined $call->{'args'} && length $call->{'args'} ) {
    eval { $params = JSON::PP::decode_json( $call->{'args'} ); };
    if ($@) {
        eval { $params = YAML::XS::Load( $call->{'args'} ); };
    }
    $params = {} if $@;
}

my $result = <[models.test.api_limit_detection]>->($params);

my $yaml_data = YAML::XS::Dump($result);
return {
    'mode' => 'size',
    'data' => $yaml_data
};

