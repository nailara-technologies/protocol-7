## [:< ##

# name = models.registry.get_entry
# descr = Get registry entry for a model

sub get_model_entry {
  my ($model_amos) = @_;
  my $base = <[models.registry.base]>;
  my $registry = $base->{get_registry}->();

  return $registry->{models}->{$model_amos} // {
    'not_found' => 1,
    'model_amos' => $model_amos,
  };
}

# Entry point
{
  my @args = @ARG;
  return get_model_entry(@args);
};

