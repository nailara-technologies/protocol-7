## [:< ##

# name  = coding.task.resurrect
# descr = resurrect failed task back to active queue for retry

my ($task_id) = @ARG;

return { 'mode' => qw| false |, 'data' => 'task_id required' }
    unless defined $task_id && length $task_id;

my $queue_href  = <coding.task.queue> // {};
my $aref_failed = <coding.task.failed> //= [];

return { 'mode' => qw| false |, 'data' => 'task not found in failed queue' }
    unless grep { $ARG eq $task_id } $aref_failed->@*;

my $task = $queue_href->{$task_id};

return { 'mode' => qw| false |, 'data' => 'task record missing from queue' }
    unless defined $task;

return {
    'mode' => qw| false |,
    'data' => 'buried tasks cannot be resurrected'
    }
    if ( $task->{'execution'}->{'status'} // '' ) eq 'failed-stopped';

## drop from failed list + queue : enqueue rejects existing ids, so the old ##
## record must be cleared before re-registering it                          ##
$aref_failed->@* = grep { $ARG ne $task_id } $aref_failed->@*;
delete $queue_href->{$task_id};

## update retry count and reset status ##
$task->{'execution'}->{'retry_count'}++;
$task->{'execution'}->{'resurrected_at'} = <[base.time]>->(3);
$task->{'execution'}->{'status'}         = 'queued';
delete $task->{'execution'}->{'failed_at'};
delete $task->{'execution'}->{'error'};
delete $task->{'execution'}->{'failure_type'};

## re-enqueue : restores queue/pending tracking + spawns a fresh job ##
my $enqueue_result = <[coding.task.enqueue]>->($task);

<[base.logs]>->(
    1,        "::task:: resurrected [%s] for retry #%d",
    $task_id, $task->{'execution'}->{'retry_count'}
);

return {
    'mode' => qw| true |,
    'data' => {
        'task_id'     => $task_id,
        'retry_count' => $task->{'execution'}->{'retry_count'},
        'queued'      => $enqueue_result->{'success'} // 0,
    }
};

