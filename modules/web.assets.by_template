## [:< ##

# name = web.assets.by_template
# descr = Get assets by template from registry

my ($template) = @_;

my @assets;
foreach my $path ( keys %{ $data{'web'}{'assets'}{'registry'} } ) {
    push @assets, $data{'web'}{'assets'}{'registry'}{$path}
        if $data{'web'}{'assets'}{'registry'}{$path}{template} eq $template;
}

return @assets;

0;

