## [:< ##

# name  = space.template.list
# descr = list all registered templates with formats
# param = {}

my @templates;
for my $name ( sort keys %{ <space.templates> // {} } ) {
    my $tpl = <space.templates>->{$name};
    push @templates,
        {
        'name'          => $name,
        'chain_format'  => $tpl->{'chain_format'}  // '',
        'branch_format' => $tpl->{'branch_format'} // '',
        };
}

return \@templates;

