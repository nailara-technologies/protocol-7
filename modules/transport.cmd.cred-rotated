## [:< ##

# name  = transport.cmd.cred-rotated
# descr = cred-mesh rotation-notify subscriber target
# param = <base32-encoded event yaml>

my $args_b32  = $call->{'args'}                        // '';
my $args_yaml = <[base.base32.decode]>->( \$args_b32 ) // '';

my $result = <[transport.handler.cred_rotated]>
    ->( { 'args' => { 'data' => $args_yaml } } );

return { 'mode' => qw| false |, 'data' => 'flush failed' }
    unless ref $result eq qw| HASH |;

return {
    'mode' => qw| true |,
    'data' => sprintf(
        'flushed %d profiles, %d active handles',
        $result->{'profiles_flushed'} // 0,
        $result->{'active_cleared'}   // 0
    ),
};

## [ end ] ###################################################################

