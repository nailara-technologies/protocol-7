## [:< ##

# name = index.rebalance
# descr = rebalance address space after ingest

return if not <index.meta>->{'dirty'};

<[index.rank]>;

<index.meta>->{'dirty'} = FALSE;

my $total = scalar keys %{<index.freq>};
<[base.log]>->( 2, "index rebalanced [ $total unique tokens ]" );

