## [:< ##

# name  = jobsite.job.write
# descr = write a single job record to status-directory storage, update index

my $job_id = shift // '';
my $job    = shift // {};

return FALSE if not length $job_id;
return FALSE if ref $job ne 'HASH';

my $enc_id = <[base.vax-int.encode]>->($job_id);

my $jobs_root = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite jobs |;

my $status = $job->{'status'} // 'new';

## determine target path ##
my ( $rel_path, $abs_path, $is_trash );
if ( $status eq 'blocked' ) {
    my $epoch = $job->{'blocked_epoch'} // <[base.ntime.epoch_timestamp]>;
    $rel_path = "jobs/blocked/$epoch/$enc_id.yaml";
    $abs_path = "$jobs_root/blocked/$epoch/$enc_id.yaml";
} elsif ( $status eq 'deleted' ) {
    my $epoch = $job->{'deleted_epoch'} // <[base.ntime.epoch_timestamp]>;
    $rel_path = "jobs/deleted/$epoch/$enc_id.yaml";
    $abs_path = "$jobs_root/deleted/$epoch/$enc_id.yaml";
} elsif ( $status eq 'trash' ) {
    my $epoch = $job->{'trash_epoch'} // <[base.ntime.epoch_timestamp]>;
    $rel_path = "jobs/trash/$epoch/$enc_id.yxz.B32";
    $abs_path = "$jobs_root/trash/$epoch/$enc_id.yxz.B32";
    $is_trash = 1;
} else {
    $rel_path = "jobs/$status/$enc_id.yaml";
    $abs_path = "$jobs_root/$status/$enc_id.yaml";
}

## ensure parent directory exists ##
my $parent_dir = $abs_path;
$parent_dir =~ s|/[^/]+$||;
if ( not -d $parent_dir ) {
    my $p7_user = <system.amos-zenka-user> // qw| protocol-7 |;
    <[file.make_path]>->( $parent_dir, 0750, $p7_user, $p7_user );
}

## find old path via index ##
my $old_status   = <jobsite.job.index>->{$job_id} // '';
my $old_abs_path = '';
if ( length $old_status ) {
    if ( $old_status =~ m{^(blocked|deleted):(.+)$} ) {
        $old_abs_path = "$jobs_root/$1/$2/$enc_id.yaml";
    } elsif ( $old_status =~ m{^trash:(.+)$} ) {
        $old_abs_path = "$jobs_root/trash/$1/$enc_id.yxz.B32";
    } else {
        $old_abs_path = "$jobs_root/$old_status/$enc_id.yaml";
    }
}

## defensive scan for orphaned copies : the index-derived old path above is ##
## a single guess that can be stale relative to the filesystem [ e.g.       ##
## rapid multi-step status sequences ], leaving copies of this job under    ##
## other status dirs that neither this rename nor store.prune ever sees     ##
## again -- glob for this id across all status dirs [ one-level for the     ##
## plain statuses, two-level for the epoch-bucketed blocked/deleted/trash   ##
## dirs with their varying epoch subdir names ] and remove any genuine      ##
## stray that is neither the new target nor the handled old path            ##
my @stray_matches = eval {
    grep { -f $ARG } map { glob($ARG) }
        "$jobs_root/*/$enc_id.yaml",
        "$jobs_root/*/*/$enc_id.yaml",
        "$jobs_root/*/*/$enc_id.yxz.B32";
};
if ($EVAL_ERROR) {
    <[base.logs]>->(
        0,       'jss.job.write: orphan scan glob error for %s: %s',
        $job_id, $EVAL_ERROR
    );
} else {
    for my $stray (@stray_matches) {
        next if $stray eq $abs_path;
        next if length $old_abs_path and $stray eq $old_abs_path;
        if ( not unlink $stray ) {
            <[base.logs]>->(
                0,
                'jss.job.write: orphan unlink '
                    . 'failed for %s [ job %s ]: %s',
                $stray,
                $job_id,
                $!
            );
            next;
        }
        <[base.logs]>->(
            1, 'jss.job.write: removed orphaned status file for job %s : %s',
            $job_id, $stray
        );
    }
}

## tombstone a genuine [ not-already-terminal ] transition into a terminal  ##
## state : jobsite.sync.push forwards this so the web-cache can prune the   ##
## record instead of holding a stale copy forever [ trash/deleted/blocked   ##
## job content is never loaded into %jobs by job.load_all, so sync.push has ##
## no other way to notice the transition ]                                  ##
( my $old_base_status = $old_status ) =~ s{:.+$}{};
if ( $status =~ m{^(?:blocked|deleted|trash)$} ) {
    if ( $old_base_status ne $status ) {
        <[jobsite.removed_log.append]>->($enc_id);
    }
} elsif ( $old_base_status =~ m{^(?:blocked|deleted|trash)$} ) {
    ## rescued/reset out of a terminal state : any earlier tombstone for ##
    ## this id is now stale and must stop being forwarded as a removal   ##
    ## signal, or it keeps clobbering this job's real data on every sync ##
    <[jobsite.removed_log.prune]>->($enc_id);
}

## prepare content ##
my $write_job;
if ( $status eq 'blocked' ) {
    $write_job = {
        'id'            => $enc_id,
        'url'           => $job->{'url'} // '',
        'status'        => 'blocked',
        'blocked_epoch' => $job->{'blocked_epoch'}
            // <[base.ntime.epoch_timestamp]>,
        'checksum_hit' => $job->{'checksum_hit'} // '',
    };
} else {
    $write_job                    = $job;
    $write_job->{'id'}            = $enc_id;
    $write_job->{'last_modified'} = <[base.ntime.b32]>;
}

## build file payload: plain yaml or xz+base32 for trash ##
my ( $payload_ref, $write_mode );
if ($is_trash) {
    my $yaml;
    eval { $yaml = YAML::XS::Dump($write_job) };
    if ($@) {
        <[base.logs]>->(
            0,       'jss.job.write: dump error for %s: %s',
            $job_id, $@
        );
        return FALSE;
    }
    utf8::encode($yaml) if utf8::is_utf8($yaml);
    my $compressed;
    IO::Compress::Xz::xz( \$yaml, \$compressed )
        or return <[base.logs]>->(
        0, 'jss.job.write: xz compression failed for %s', $job_id
        );
    my $b32 = <[base32.encode]>->($compressed);
    $payload_ref = \$b32;
    $write_mode  = '>';
} else {
    my $yaml;
    eval { $yaml = YAML::XS::Dump($write_job) };
    if ($@) {
        <[base.logs]>->(
            0,       'jss.job.write: dump error for %s: %s',
            $job_id, $@
        );
        return FALSE;
    }
    $payload_ref = \$yaml;
    $write_mode  = '>';
}

## atomic transition: rename if path changed ##
my $written = FALSE;
if (    length $old_abs_path
    and $old_abs_path ne $abs_path
    and -f $old_abs_path ) {
    if ( not rename( $old_abs_path, $abs_path ) ) {
        <[base.logs]>->(
            0, 'jss.job.write: rename %s -> %s failed: %s',
            $old_abs_path, $abs_path, $!
        );
        return FALSE;
    }
}

## write fresh or overwrite in-place ##
my $wrote = <[file.zenka_dir.write]>
    ->( $rel_path, $payload_ref, $write_mode, 0640 );
if ( not defined $wrote ) {
    <[base.logs]>->( 0, 'jss.job.write: write failed for %s', $job_id );
    return FALSE;
}
$written = TRUE;

## update in-memory index ##
<jobsite.job.index>->{$job_id} = do {
    if ( $status =~ m{^(blocked|deleted|trash)$} ) {
        my $epoch_key = "${status}_epoch";
        my $epoch     = $job->{$epoch_key} // <[base.ntime.epoch_timestamp]>;
        "$status:$epoch";
    } else {
        $status;
    }
};

## update on-disk index.yaml atomically ##
my $base_dir = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite |;
my $index_file = join qw| / |, $base_dir, qw| index.yaml |;

my $index = {};
if ( -f $index_file ) {
    $index = eval { YAML::XS::LoadFile($index_file) } // {};
}

$index->{$enc_id} = {
    'status' => $job->{'status'} // '',
    'score'  => $job->{'score'}  // '',
    'stage'  => $job->{'stage'}  // '',
};

my $index_tmp = "$index_file.tmp";
eval { YAML::XS::DumpFile( $index_tmp, $index ) };
if ($@) {
    <[base.logs]>->( 0, 'jss.job.write: index dump error: %s', $@ );
    return FALSE;
}

rename( $index_tmp, $index_file )
    or <[base.logs]>->( 0, 'jss.job.write: index rename failed: %s', $! );

return $written;

