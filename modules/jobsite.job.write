## [:< ##

# name  = jobsite.job.write
# descr = write a single job record to per-file storage, update index

my $job_id = shift // '';
my $job    = shift // {};

return FALSE if not length $job_id;
return FALSE if ref $job ne 'HASH';

my $base_dir = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite |;
my $jobs_dir   = join qw| / |, $base_dir, qw| jobs |;
my $index_file = join qw| / |, $base_dir, qw| index.yaml |;

## ensure jobs directory exists with correct ownership ##
if ( not -d $jobs_dir ) {
    my $p7_user = <system.amos-zenka-user> // qw| protocol-7 |;
    <[file.make_path]>->( $jobs_dir, 0750, $p7_user, $p7_user );
}

$job->{'last_modified'} = <[ntime.b32]>;

## write job file atomically ##
my $job_file = "$jobs_dir/$job_id.yaml";
my $tmp_file = "$job_file.tmp";

eval { YAML::XS::DumpFile( $tmp_file, $job ) };
if ($@) {
    <[base.logs]>->( 0, 'jss.job.write: dump error for %s: %s', $job_id, $@ );
    return FALSE;
}

if ( not rename( $tmp_file, $job_file ) ) {
    <[base.logs]>->(
        0,       'jss.job.write: rename failed for %s: %s',
        $job_id, $!
    );
    return FALSE;
}

## update index.yaml atomically ##
my $index = {};
if ( -f $index_file ) {
    $index = eval { YAML::XS::LoadFile($index_file) } // {};
}

$index->{$job_id} = {
    'status' => $job->{'status'} // '',
    'score'  => $job->{'score'}  // '',
    'stage'  => $job->{'stage'}  // '',
};

my $index_tmp = "$index_file.tmp";
eval { YAML::XS::DumpFile( $index_tmp, $index ) };
if ($@) {
    <[base.logs]>->( 0, 'jss.job.write: index dump error: %s', $@ );
    return FALSE;
}

rename( $index_tmp, $index_file )
    or <[base.logs]>->( 0, 'jss.job.write: index rename failed: %s', $! );

return TRUE;

