# name  = letsencr.parent.handler_child_ready
# descr = Handle child process ready notification - completes parent initialization

my $msg = shift;

my $child_pid = $msg->{pid};

<[base.log]>->( 2, "letsencr parent: child process ready (PID: $child_pid)" );

## Check for any pending operations
<[letsencr.parent.process_pending_ops]>->()
    if defined <[letsencr.parent.process_pending_ops]>;

