# name  = context.string.common_suffix_len
# descr = find common suffix length between two strings

my $params = shift // {};

my $a = $params->{'a'} // '';
my $b = $params->{'b'} // '';

my $len   = 0;
my $len_a = length $a;
my $len_b = length $b;
my $max   = $len_a < $len_b ? $len_a : $len_b;

while ( $len < $max
    and substr( $a, $len_a - $len - 1, 1 ) eq
    substr( $b, $len_b - $len - 1, 1 ) ) {
    $len++;
}

return $len;

