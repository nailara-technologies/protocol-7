## [:< ##

# name = httpd.json.encode
# descr = encode Perl data structure to JSON string

my $data = shift;

state $json;
if ( !defined $json ) {
    $json = JSON::XS->new();
    $json->convert_blessed(1);
    $json->allow_nonref(1);
    $json->canonical(1);
    $json->relaxed(1);
    $json->pretty(1);
    $json->utf8(0);
    ## Output octets [bytes], not UTF-8 flagged strings
    ## for OCTETS mode compatibility
}
return $json->encode($data);
