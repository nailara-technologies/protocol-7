## [:< ##

# name = httpd.json.encode
# descr = encode Perl data structure to JSON string

my $data = shift;

state $json;
if (!defined $json) {
    $json = JSON::XS->new();
    $json->convert_blessed(1);
    $json->allow_nonref(1);
    $json->canonical(1);
    $json->relaxed(1);
    $json->pretty(1);
    $json->utf8(1);
}

return $json->encode($data);

