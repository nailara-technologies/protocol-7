## [:< ##

# name  = user-edit.term_restore
# descr = restore terminal settings after an interactive form session

## mirrors nshell.term_restore.  MUST run on every exit path — a form left in
## raw/noecho mode hands the user back a shell that does not echo.  registered
## as an end_code callback by user-edit.console.start so it fires on normal
## exit, ctrl-c and SIGTERM alike [ SIGKILL is unblockable, same tradeoff
## nshell and mpv.snapshot already accept ]

## $colors{'reset'}, NOT a literal "\e[0m" : under -nc the palette is blanked
## precisely so nothing forces the terminal back to its DEFAULT foreground --
## a hardcoded reset there overrides whatever colour the user's own terminal
## was set to, which is the one thing -nc is asking us not to do.  the \r\e[K
## stays : clearing the partial line is a cursor operation, not a colour one,
## and -nc does not disable those
print( ( $colors{'reset'} // '' ) . "\r\e[K" );
STDOUT->flush();

## prefer the fd stored at init : fileno(STDIN) can be stale at exit time ##
my $tty_fd = <user-edit.term.tty_fd> // fileno(STDIN);
return FALSE if not defined $tty_fd or $tty_fd < 0;

## show the terminal cursor again [ hidden by user-edit.term_init ] -- this is
## a cursor operation, not a colour one, so it is emitted even under -nc, and
## it must happen on EVERY exit path or the user is left with an invisible
## cursor in their shell
print "\e[?25h";

## restore the :encoding(UTF-8) layer bin/Protocol-7 installed and
## user-edit.term_init dropped, so anything reading STDIN afterwards sees the
## handle it expects
binmode( STDIN, qw| :encoding(UTF-8) | );

my $flags = fcntl( \*STDIN, F_GETFL, 0 );
fcntl( \*STDIN, F_SETFL, $flags & ~O_NONBLOCK ) if defined $flags;

my $orig_termios = <user-edit.term.orig_termios>;

## TCSANOW, not TCSAFLUSH : the flush variant waits for an i/o drain that
## never completes on a signal-exit path [ nshell.term_restore's own note ]
if ( defined $orig_termios ) {
    $orig_termios->setattr( $tty_fd, TCSANOW() );
    <user-edit.term.orig_termios> = undef;
    return TRUE;
}

## fallback : no saved state — re-enable echo/canonical/signals explicitly
## rather than leaving the calling shell raw
my $fallback = Linux::Termios2->new();
if ( $fallback->getattr($tty_fd) ) {
    $fallback->setlflag( $fallback->getlflag() | ECHO() | ICANON() | ISIG() );
    $fallback->setattr( $tty_fd, TCSANOW() );
}

return TRUE;

