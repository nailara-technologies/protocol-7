## [:< ##

# name  = workspace-transfer.console.bug
# descr = bug tracking system (Protocol-7 styled console output)

## Protocol-7 color scheme ##
my $reset       = "\e[0m";
my $nailara_bg  = "\e[48;2;9;5;42m";
my $blacklight  = "\e[38;2;68;39;172m";
my $TRUE_blue   = "\e[38;2;6;71;195m";
my $neon_orange = "\e[38;2;197;141;7m";
my $neon_green  = "\e[38;2;71;195;6m";
my $neon_red    = "\e[38;2;195;6;71m";

<[base.perlmod.autoload]>->(qw| POSIX |);

my $cmd  = shift || 'list';
my @args = @_;

my $ws_dir = workspace_transfer::chdir_workspace();
<[base.exit]>->(qw| 0110 |) unless defined $ws_dir;

my $bug_file = 'BUGS.md';

if ( $cmd eq 'list' ) {
    unless ( -f $bug_file ) {
        say "";
        say "$blacklight .:[ ${neon_red}BUG TRACKER${blacklight} ]:.$reset";
        say "";
        say "  ${neon_green}No bugs tracked yet.$reset";
        say
            "  ${blacklight}Add one with: ${TRUE_blue}bug add <description>$reset";
        say "";
        return;
    }

    say "";
    say "$blacklight .:[ ${neon_red}BUG TRACKER${blacklight} ]:.$reset";
    say "";

    open my $fh, '<', $bug_file or do {
        <[base.logs]>->( 0, 'cannot read BUGS.md: %s', $! );
        <[base.exit]>->(qw| 0110 |);
    };

    my $count = 0;
    my $fixed = 0;
    while (<$fh>) {
        if (/^- \[ \].*\[BUG-(\d+)\](.*)/) {
            $count++;
            my $bug_num = $1;
            my $desc    = $2;
            say
                "${neon_red}[BUG-${bug_num}]${reset} ${TRUE_blue}●$reset$desc";
        } elsif (/^- \[x\].*\[BUG-(\d+)\](.*)/) {
            $fixed++;
            my $bug_num = $1;
            my $desc    = $2;
            say
                "${blacklight}[BUG-${bug_num}]${reset} ${neon_green}✓$reset$desc";
        } elsif (/^  - (Reported|Status):(.*)/) {
            say "  ${blacklight}$1:${reset}$2";
        } else {
            print;
        }
    }
    close $fh;

    say "";
    say "$blacklight" . "=" x 60 . "$reset";
    say sprintf
        "  ${TRUE_blue}Open: ${neon_red}%d${reset} | ${TRUE_blue}Fixed: ${neon_green}%d${reset} | ${TRUE_blue}Total: ${neon_orange}%d${reset}",
        $count, $fixed, ( $count + $fixed );
    say "$blacklight" . "=" x 60 . "$reset";
    say "";

} elsif ( $cmd eq 'add' ) {
    die "Usage: bug add <description>\n" unless @args;

    my $desc      = join( ' ', @args );
    my $timestamp = POSIX::strftime( "%Y-%m-%d %H:%M:%S", localtime() );

    # Read existing bugs to get next ID
    my $next_id = 1;
    if ( -f $bug_file ) {
        open my $fh, '<', $bug_file or do {
            <[base.logs]>->( 0, 'cannot read BUGS.md: %s', $! );
            <[base.exit]>->(qw| 0110 |);
        };
        while (<$fh>) {
            if (/\[BUG-(\d+)\]/) {
                my $id = $1;
                $next_id = $id + 1 if $id >= $next_id;
            }
        }
        close $fh;
    }

    open my $fh, '>>', $bug_file or do {
        <[base.logs]>->( 0, 'cannot write BUGS.md: %s', $! );
        <[base.exit]>->(qw| 0110 |);
    };
    print $fh sprintf "- [ ] **[BUG-%d]** %s\n", $next_id, $desc;
    print $fh "  - Reported: $timestamp\n";
    print $fh "  - Status: Open\n";
    print $fh "\n";
    close $fh;

    say "";
    say
        "$neon_green✓$reset ${TRUE_blue}Bug reported:$reset ${neon_red}[BUG-$next_id]$reset $neon_orange$desc$reset";
    say "";

} elsif ( $cmd eq 'fixed' ) {
    my ($bug_id) = @args;
    die "Usage: bug fixed <bug_id>\n" unless defined $bug_id;

    $bug_id =~ s|^BUG-||i;    # Allow "BUG-1" or just "1"

    unless ( -f $bug_file ) {
        say "";
        say "$neon_orange⚠$reset No bugs to mark fixed.";
        say "";
        return;
    }

    open my $fh, '<', $bug_file or do {
        <[base.logs]>->( 0, 'cannot read BUGS.md: %s', $! );
        <[base.exit]>->(qw| 0110 |);
    };
    my @lines = <$fh>;
    close $fh;

    my $found = 0;
    for my $i ( 0 .. $#lines ) {
        if ( $lines[$i] =~ /^- \[ \].*\[BUG-$bug_id\]/ ) {
            $lines[$i] =~ s|^- \[ \]|- [x]|;
            $found = 1;

            # Update status line
            for my $j ( $i + 1 .. $#lines ) {
                if ( $lines[$j] =~ /Status: Open/ ) {
                    $lines[$j] =~ s|Status: Open|Status: Fixed|;
                    $lines[$j] =~ s|\n$||;
                    $lines[$j] .= " ("
                        . POSIX::strftime( "%Y-%m-%d", localtime() ) . ")\n";
                    last;
                }
                last if $lines[$j] =~ /^- \[/;    # Next bug
            }

            open my $out, '>', $bug_file or do {
                <[base.logs]>->( 0, 'cannot write BUGS.md: %s', $! );
                <[base.exit]>->(qw| 0110 |);
            };
            print $out @lines;
            close $out;

            say "";
            say
                "$neon_green✓$reset ${TRUE_blue}Marked bug$reset ${neon_red}[BUG-$bug_id]$reset ${TRUE_blue}as fixed$reset";
            say "";
            return;
        }
    }

    say "";
    say "$neon_orange⚠$reset Bug ${neon_red}[BUG-$bug_id]$reset not found";
    say "";

} elsif ( $cmd eq 'help' ) {
    say "";
    say "$blacklight .:[ ${neon_red}BUG TRACKER HELP${blacklight} ]:.$reset";
    say "";
    say "  ${TRUE_blue}Usage:$reset";
    say
        "    ${neon_green}bug list${reset}              - List all bugs (default)";
    say
        "    ${neon_green}bug add${reset} ${neon_orange}<desc>${reset}        - Report a new bug";
    say
        "    ${neon_green}bug fixed${reset} ${neon_orange}<id>${reset}       - Mark bug as fixed";
    say "    ${neon_green}bug help${reset}              - Show this help";
    say "";

} else {
    say "";
    say "$neon_orange⚠$reset Unknown command: ${TRUE_blue}$cmd$reset";
    say "  Run ${neon_green}bug help$reset for usage";
    say "";
}

