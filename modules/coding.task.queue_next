## [:< ##

# name = coding.task.queue_next
# descr = get next task from queue respecting priority and dependencies
# purpose = Queue operation: Retrieve work in priority order

# Get persistent storage refs
my $queue_href   = <coding.task.queue>;
my $aref_pending = <coding.task.pending>;
my $aref_active  = <coding.task.active>;

# Filter tasks that have no unfinished dependencies
my @available = ();

foreach my $task_id ( $aref_pending->@* ) {
    my $task = $queue_href->{$task_id};

    # Skip if not pending
    next unless $task->{'execution'}->{'status'} eq qw| pending |;

    # Simple dependency check (placeholder)
    # Full dependency tracking would check task dependencies

    push @available,
        {
        id             => $task_id,
        task           => $task,
        priority_score => <[coding.helper.priority_scorer]>->($task)
        };
}

# Sort by priority (highest first)
my @sorted
    = sort { $b->{priority_score} <=> $a->{priority_score} } @available;

if (@sorted) {
    my $next = $sorted[0];
    my $task = $next->{task};

    # Mark as being worked on (don't remove yet)
    $task->{'execution'}->{'status'}  = qw| in_progress |;
    $task->{'execution'}->{'started'} = <[base.time]>;

    # Move to active list
    $aref_pending->@* = grep { $ARG ne $next->{id} } $aref_pending->@*;
    push $aref_active->@*, $next->{id};

    <[base.logs]>->( 2, "task started : %s", $next->{id} );

    return {
        success         => TRUE,
        task            => $task,
        queue_remaining => scalar( $aref_pending->@* )
    };
}

return {
    success    => FALSE,
    error      => 'no available tasks in queue',
    queue_size => scalar( $aref_pending->@* )
};

