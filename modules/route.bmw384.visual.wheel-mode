## [:< ##

# name  = route.bmw384.visual.wheel-mode
# descr = dispatch to appropriate wheel visualization mode

my $mode = <route.bmw384.cfg.visual_mode> // 'ring';

if ( $mode eq 'arc-width' ) { return <[route.bmw384.visual.wheel.arc-width]> }
elsif ( $mode eq 'density' ) { return <[route.bmw384.visual.wheel.density]> }
elsif ( $mode eq 'gauss' )   { return <[route.bmw384.visual.wheel.gauss]> }
elsif ( $mode eq 'overlay' ) { return <[route.bmw384.visual.wheel.overlay]> }
elsif ( $mode eq 'metric' )  { return <[route.bmw384.visual.wheel.metric]> }
elsif ( $mode eq 'heatmap' ) { return <[route.bmw384.visual.wheel.heatmap]> }
elsif ( $mode eq 'vortex' )  { return <[route.bmw384.visual.wheel.vortex]> }
elsif ( $mode eq 'alpha-density' ) {
    return <[route.bmw384.visual.wheel.alpha-density]>;
} elsif ( $mode eq 'oscilloscope' ) {
    return <[route.bmw384.visual.wheel.oscilloscope]>;
} elsif ( $mode eq 'ledger' ) {
    return <[route.bmw384.visual.wheel.ledger]>;
} elsif ( $mode eq 'vertical' ) {
    return <[route.bmw384.visual.wheel.vertical]>;
} elsif ( $mode eq 'temporal' ) {
    return <[route.bmw384.visual.wheel.temporal]>;
} else {
    return <[route.bmw384.visual.wheel]>;
}

