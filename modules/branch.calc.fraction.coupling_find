# name  = branch.calc.fraction.coupling_find
# descr = scan X/Y pairs for period length at or below threshold
# param = pairs_arrayref, max_period_length
#
# pairs = [ [x1,y1], [x2,y2], ... ]
# returns arrayref of qualifying pairs

my ( $pairs, $threshold ) = @ARG;

return undef
    if not defined $pairs
    or ref $pairs ne qw| ARRAY |
    or not defined $threshold;

my @result;

for my $pair (@$pairs) {
    next if ref $pair ne qw| ARRAY | or @$pair < 2;
    my ( $x, $y ) = @$pair;
    next if not defined $x or not defined $y or $y == 0;
    my $len = <[branch.calc.fraction.period_length]>->( $x, $y );
    next if not defined $len;
    push @result, $pair if $len <= $threshold;
}

return \@result;

