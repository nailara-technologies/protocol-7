## [:< ##

# name  = transport.handle.udt-tunnel
# descr = UDT tunnel handler (stub, full impl when UDT::Simple available)
# args  = $entry, $context, $continue
# invokes $continue->( $handle_or_undef ) once resolution + connect complete.

my ( $entry, $ctx, $continue ) = @ARG;

my $endpoint = $entry->{'endpoint'} // $ctx->{'request'}{'domain'} // '';
if ( not length $endpoint ) {
    $continue->(undef) if ref $continue eq qw| CODE |;
    return;
}

## check if UDT is available ##
my $udt_registry = <transport.registry>->{'registry'}{'udt'};
if (   not defined $udt_registry
    or not $udt_registry->{'available'} ) {
    <[base.logs]>->( 1, 'transport.handle.udt-tunnel: UDT not available' );
    $continue->(undef) if ref $continue eq qw| CODE |;
    return;
}

my ( $host, $port ) = split /:/, $endpoint, 2;
$port //= 9000;

## finalize handle once credential resolution (if any) completes ##
my $build_handle = sub {
    my $cred = shift;

    if ( exists $entry->{'credential'}
        and defined $entry->{'credential'} ) {
        if (   not defined $cred
            or ref $cred ne qw| HASH |
            or ( $cred->{'mode'} // '' ) ne qw| true | ) {
            <[base.logs]>->(
                1,
                'transport.handle.udt-tunnel: '
                    . 'credential %s resolution failed',
                $entry->{'credential'}
            );
            $continue->(undef) if ref $continue eq qw| CODE |;
            return;
        }
    }

    my $has_udt = <[base.perlmod.loaded]>->('UDT::Simple')
        || <[base.perlmod.autoload]>->('UDT::Simple');

    my $sock;
    if ($has_udt) {
        eval {
            $sock = UDT::Simple->new( AF_INET(), SOCK_DGRAM() );
            $sock->connect( $host, $port );
        };
        if ( $@ or not defined $sock ) {
            <[base.logs]>->(
                0,
                'transport.handle.udt-tunnel: UDT connect failed: %s',
                $@ // 'unknown'
            );
            $sock = undef;
        }
    }

    if ( not defined $sock ) {
        $continue->(undef) if ref $continue eq qw| CODE |;
        return;
    }

    my $dest = $ctx->{'session'}{'destination'}
        // $ctx->{'request'}{'domain'} // $endpoint;

    my $handle = {
        'type'     => 'udt-tunnel',
        'socket'   => $sock,
        'endpoint' => $endpoint,
        'quality'  => <transport.registry>->{'quality'}{'udt-tunnel'}{$dest}
            // {},
        'credential' => $cred,
    };

    <transport.registry>->{'stats'}{'connections_ok'}++;

    $continue->($handle) if ref $continue eq qw| CODE |;
    return;
};

## no credential to resolve: build synchronously ##
if (   not exists $entry->{'credential'}
    or not defined $entry->{'credential'} ) {
    $build_handle->(undef);
    return;
}

## async credential resolve via cred-mesh ##
my $req_id = sprintf( 'udt-%d-%d-%d',
    <[base.ntime.b32]> // 0,
    $PROCESS_ID, int( rand(1_000_000) ) );

<transport.registry>->{'pending_resolve'}{$req_id} = {
    'build'    => $build_handle,
    'continue' => $continue,
    'slot'     => $entry->{'credential'},
    'handler'  => qw| transport.handle.udt-tunnel |,
};

<[protocol-7.route-send]>->(
    {   'command'   => qw| cred-mesh.resolve |,
        'call_args' => { 'args' => $entry->{'credential'} },
        'reply'     => {
            'handler' => qw| transport.handler.credential_resolved |,
            'params'  => { 'req_id' => $req_id },
        },
    }
);

return;

