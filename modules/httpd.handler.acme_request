## [:< ##

# name = httpd.handler.acme_request
# descr = handle ACME/API certificate request endpoints - routes to letsencr commands

## Handle both direct calls and event handler callbacks
my $id;
my $event;
my $http_uri;

## Detect calling convention: direct call vs event watcher
if ( index( ref $ARG[0], qw| Event:: | ) != 0 and $ARG[0] =~ m|^\d+| ) {
    $id = shift;    ## direct call with session id
    $http_uri
        = shift;   ## optional: URI passed when called directly from http_post
} else {
    ## Event watcher callback (Event::Io, Event::Var, etc.)
    $event    = shift;             ## fetch event
    $id       = $event->w->data;   ## stored session id
    $http_uri = undef;             ## will retrieve from session storage below
}

my $session = $data{'session'}->{$id};

## Get URI from multiple possible sources
unless ( defined $http_uri && length $http_uri ) {
    ## Try session stored URI (set by body_watcher setup)
    $http_uri
        = (
        defined $session ? $session->{'http'}->{'acme_request_uri'} : undef )
        // (
        defined $session ? $session->{'http'}->{'request'}->{'uri'} : undef )
        // 'unknown';
}

my $request  = $session->{'http'}->{'request'};
my $headers  = $request->{'headers'};
my $response = $session->{'response'};

## Extract request body from input buffer (after headers were parsed)
## The body comes after the headers in $session->{'buffer'}->{'input'}
my $req_body = '';

if ( exists $session->{'http'}->{'body'} ) {
    ## Already parsed and stored
    $req_body = $session->{'http'}->{'body'};
    <[base.logs]>->( 3, '[%d] using stored body', $id );
} elsif ( $session->{'buffer'}->{'input'}
    && length( $session->{'buffer'}->{'input'} ) > 0 ) {
    ## Still in input buffer - check if complete first
    my $content_length = $headers->{'content-length'} // 0;
    my $bytes_received = length( $session->{'buffer'}->{'input'} );

    if ( $bytes_received < $content_length ) {
        ## body not yet complete - return without processing
        ## watcher will fire again when more data arrives
        <[base.logs]>->(
            3,   '[%d] body incomplete: %d/%d bytes, waiting for more',
            $id, $bytes_received, $content_length
        );
        return FALSE;
    }

    ## Body is complete - extract and process
    $req_body = $session->{'buffer'}->{'input'};
    $session->{'buffer'}->{'input'} = '';
    <[base.logs]>->( 3, '[%d] extracted body from buffer', $id );
} else {
    <[base.logs]>->( 3, '[%d] no body in buffer', $id );
}

<[base.logs]>->(
    2,   '[%d] ACME request: %s (body len: %d)',
    $id, $http_uri, length($req_body)
);

## Parse JSON body if present
my $acme_req = {};
if ( length($req_body) > 0 ) {
    $acme_req = <[httpd.json.decode]>->($req_body) // {};
    <[base.logs]>->( 3, '[%d] parsed JSON request', $id );
} else {
    <[base.logs]>->( 3, '[%d] empty body, using empty request object', $id );
}

my $content_type = qq| application/json; charset=utf-8 |;
my $reply_code   = 200;
my $reply_body   = '';

## Route based on URI path
if ( $http_uri =~ m|^/api/certificate/request| ) {
    ## Certificate request endpoint
    my $domain = $acme_req->{'domain'} // '';

    unless ( $domain && length($domain) > 0 ) {
        <[base.logs]>->( 1, '[%d] missing domain in request', $id );
        $reply_code = 400;
        $reply_body = <[httpd.json.encode]>->(
            {   'status' => qw| error |,
                'error'  => qq| domain parameter required |
            }
        );
    } else {
        <[base.logs]>->(
            2,   '[%d] requesting certificate for: %s',
            $id, $domain
        );

        ## Send request to letsencr parent via cube
        my $cmd_result = undef;
        eval {
            ## Try to reach letsencr parent command
            my $cmd_call = {
                'command'   => qw| letsencr.request-certificate |,
                'call_args' => { 'args' => $domain }
            };
            $cmd_result = <[base.protocol-7.command.send.local]>->($cmd_call);
        };

        if ( length $EVAL_ERROR ) {
            <[base.logs]>->(
                1,   '[%d] error calling letsencr: %s',
                $id, <[base.str.eval_error]>
            );
            $reply_code = 500;
            $reply_body = <[httpd.json.encode]>->(
                {   'status' => qw| error |,
                    'error'  => qq| internal server error |
                }
            );
        } elsif ( $cmd_result
            && $cmd_result->{'mode'}
            && $cmd_result->{'mode'} eq qw| true | ) {
            $reply_code = 202;    ## Accepted (async processing)
            $reply_body = <[httpd.json.encode]>->(
                {   'status'  => qw| accepted |,
                    'domain'  => $domain,
                    'message' => $cmd_result->{'data'}
                        // qq| Certificate request accepted |
                }
            );
        } else {
            ## Fallback: return accepted even if letsencr might not have processed
            <[base.logs]>->(
                2,   '[%d] queued certificate request for: %s',
                $id, $domain
            );
            $reply_code = 202;
            $reply_body = <[httpd.json.encode]>->(
                {   'status'  => qw| accepted |,
                    'domain'  => $domain,
                    'message' =>
                        qw| Certificate request submitted for processing |
                }
            );
        }
    }
} elsif ( $http_uri =~ m|^/api/certificate/status| ) {
    ## Certificate status endpoint
    my $domain = $acme_req->{'domain'} // '';

    unless ( $domain && length($domain) > 0 ) {
        <[base.logs]>->( 1, '[%d] missing domain in status request', $id );
        $reply_code = 400;
        $reply_body = <[httpd.json.encode]>->(
            {   'status' => qw| error |,
                'error'  => qq| domain parameter required |
            }
        );
    } else {
        <[base.logs]>->( 2, '[%d] checking status for: %s', $id, $domain );

        ## Get certificate status from letsencr
        my $cmd_result = eval {
            <[base.protocol-7.command.send.local]>->(
                {   'command'   => qw| letsencr.parent.status |,
                    'call_args' => { 'args' => $domain }
                }
            );
        };

        if ( length $EVAL_ERROR ) {
            <[base.logs]>->(
                1,   '[%d] error checking status: %s',
                $id, <[base.str.eval_error]>
            );
            $reply_code = 500;
            $reply_body = <[httpd.json.encode]>->(
                {   'status' => qw| error |,
                    'error'  => qq| internal server error |
                }
            );
        } elsif ($cmd_result) {
            $reply_code = 200;
            $reply_body = <[httpd.json.encode]>->(
                {   'status' => qw| success |,
                    'domain' => $domain,
                    'data'   => $cmd_result->{'data'}
                        // qq| no status available |
                }
            );
        } else {
            $reply_code = 404;
            $reply_body = <[httpd.json.encode]>->(
                {   'status' => qw| not_found |,
                    'domain' => $domain,
                    'error'  => qq| no certificate found |
                }
            );
        }
    }
} elsif ( $http_uri =~ m|^/api/certificate/list| ) {
    ## List certificates endpoint
    <[base.logs]>->( 2, '[%d] listing certificates', $id );

    ## Get certificate list from letsencr
    my $cmd_result = eval {
        <[base.protocol-7.command.send.local]>->(
            {   'command'   => qw| letsencr.parent.status |,
                'call_args' => { 'args' => '' }
            }
        );
    };

    if ( length $EVAL_ERROR ) {
        <[base.logs]>->(
            1,   '[%d] error listing certificates: %s',
            $id, <[base.str.eval_error]>
        );
        $reply_code = 500;
        $reply_body = <[httpd.json.encode]>->(
            {   'status' => qw| error |,
                'error'  => qq| internal server error |
            }
        );
    } elsif ($cmd_result) {
        $reply_code = 200;
        $reply_body = <[httpd.json.encode]>->(
            {   'status'       => qw| success |,
                'certificates' => $cmd_result->{'data'} // []
            }
        );
    } else {
        $reply_code = 200;
        $reply_body = <[httpd.json.encode]>->(
            {   'status'       => qw| success |,
                'certificates' => []
            }
        );
    }
} else {
    ## Unknown ACME endpoint
    <[base.logs]>->( 1, '[%d] unknown ACME endpoint: %s', $id, $http_uri );
    $reply_code = 404;
    $reply_body = <[httpd.json.encode]>->(
        {   'status' => qw| error |,
            'error'  => qq| unknown endpoint |
        }
    );
}

## Send response
my $reply_header = {
    'Content-Type'   => $content_type,
    'Content-Length' => length($reply_body),
    'Connection'     => $session->{'http'}->{'close'}
    ? qw| close |
    : qw| keep-alive |,
};

$session->{'buffer'}->{'output'}
    .= <[httpd.new_header]>->( $reply_code, $reply_header );
$session->{'buffer'}->{'output'} .= $reply_body;

<[base.logs]>->(
    2,   '[%d] ACME response: %d (body len: %d)',
    $id, $reply_code, length($reply_body)
);

return $session->{'http'}->{'close'} ? 2 : 0;

