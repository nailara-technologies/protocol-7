# name  = httpsd.startup.validate_certificates
# descr = Validate certificate files exist before creating SSL socket
# return = TRUE [5] on success, FALSE [0] on failure

my $cert_file = <httpsd.cfg.certificate_path>;
my $key_file  = <httpsd.cfg.key_path>;

<[base.log]>->( 2, "httpsd: validating certificate files before startup" );
<[base.log]>->( 2, "  checking certificate: $cert_file" );
<[base.log]>->( 2, "  checking key: $key_file" );

unless ( -f $cert_file ) {
    <[base.log]>->( 0, "FATAL: Certificate file not found: $cert_file" );
    <[base.log]>->(
        0, "HTTPSD cannot start without valid SSL/TLS certificate."
    );
    return FALSE;
}

unless ( -f $key_file ) {
    <[base.log]>->( 0, "FATAL: Key file not found: $key_file" );
    <[base.log]>->( 0, "HTTPSD cannot start without valid SSL/TLS key." );
    return FALSE;
}

<[base.log]>->( 2, "httpsd: certificate files validated successfully" );
return TRUE;

