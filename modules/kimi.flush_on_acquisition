# name  = kimi.flush_on_acquisition
# descr = flush pending approvals when kimi session is acquired

my $href_pending = <kimi.approval.pending> // {};
foreach my $request_id ( keys %{$href_pending} ) {
    my $payload = {
        'id'           => $request_id,
        'tool_call_id' => '',
        'sender'       => '',
        'action'       => '',
        'description'  => ''
    };
    <kimi.handler.approval_request>->( $request_id, $payload );
}
<kimi.approval.pending> = [];

