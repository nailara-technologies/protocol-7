## [:< ##

# name  = p7-log.anon.key
# descr = derive + cache twofish key from the user system key [ key-tree ]
#         [ called lazily : EUID is only final after root.drop_privs ]

return <p7-log.anon.key32> if defined <p7-log.anon.key32>;

map { <[base.perlmod.load]>->($ARG) } qw| AMOS7::13 Crypt::Misc |;

## key name : config override or <system-user>.base ##
<p7-log.anon.key_name> //= do {
    my $key_usr = getpwuid($EUID) // $ENV{'USER'} // qw| protocol-7 |;
    join( qw| . |, $key_usr, qw| base | );
};
my $key_name = <p7-log.anon.key_name>;

## prefer already-loaded user base key from the key-tree ##
my $secret;
$secret = $keys{'C25519'}{$key_name}{'secret'}
    if exists $keys{'C25519'}{$key_name}
    and defined $keys{'C25519'}{$key_name}{'secret'};

## otherwise read plain [ unencrypted ] secret keyfile directly ##
if ( not defined $secret or length($secret) != 32 ) {
    undef $secret;
    my $home_dir = ( getpwuid($EUID) )[7] // '';
    my $sec_path = sprintf qw| %s/.n/user-keys/%s.secret |, $home_dir,
        $key_name;
    if ( length $home_dir and -r $sec_path ) {
        my $b32_str = <[file.slurp]>->($sec_path)->$* // '';
        chomp $b32_str;
        if ( $b32_str !~ m|^[A-Z2-7]+={0,6}$| ) {
            <[base.logs]>->(
                0,
                'p7-log.anon.key : %s not a plain base32 keyfile', $sec_path
            );
        } else {
            my $decoded = Crypt::Misc::decode_b32r($b32_str);
            if ( defined $decoded and substr( $decoded, 0, 2 ) eq qw| U: | ) {
                $secret = substr( $decoded, 2 );    ## strip 'U:' prefix ##
            } elsif ( defined $decoded ) {
                <[base.logs]>->(
                    0, 'p7-log.anon.key : key %s is encrypted [ cannot use ]',
                    $key_name
                );
            }
        }
    }
}

if ( not defined $secret or length($secret) != 32 ) {
    <[base.logs]>->(
        0, 'p7-log.anon.key : no usable system key for %s ..,', $key_name
    );
    return undef;
}

## derive twofish key [ domain separated ] ##
my $key_input = $secret . qw| .:log.anon.v1:. |;
<p7-log.anon.key32> = AMOS7::13::key_32( \$key_input );

if ( not defined <p7-log.anon.key32> or length(<p7-log.anon.key32>) != 32 ) {
    <[base.logs]>->( 0, 'p7-log.anon.key : key derivation failed ..,' );
    undef <p7-log.anon.key32>;
    return undef;
}

return <p7-log.anon.key32>;

