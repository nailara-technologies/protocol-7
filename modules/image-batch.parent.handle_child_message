# name = image-batch.parent.handle_child_message
# descr = Handle incoming messages from child worker processes

my $pipe = shift;
my $data = shift;
my $pid  = $data->{pid};

return { success => FALSE, error => 'Child PID required in data' }
    unless defined $pid;

# Read message from child
my $line;
eval { $line = <$pipe>; };

if ( $@ || !defined $line ) {

    # Pipe closed or error reading - mark child as dead
    return {
        success => FALSE,
        error   => "Failed to read from child $pid: $@"
    };
}

chomp($line);

# Parse JSON message
my $msg;
eval { $msg = JSON::XS::decode_json($line); };

if ($@) {
    return {
        success => FALSE,
        error   => "Failed to parse JSON from child $pid: $@"
    };
}

my $cmd = $msg->{cmd};

# Handle different message types
if ( $cmd eq 'ready' ) {

    # Child is ready for work - distribute next job
    my $dist_result = <[image-batch.parent.distribute_jobs]>->($pid);
    return $dist_result;

} elsif ( $cmd eq 'result' ) {

    # Child has completed a job - collect the result
    my $coll_result = <[image-batch.parent.collect_results]>->( $pid, $msg );

    if ( $coll_result->{success} ) {

        # After collecting, distribute next job to the now-available child
        return <[image-batch.parent.distribute_jobs]>->($pid);
    }
    return $coll_result;

} elsif ( $cmd eq 'error' ) {

    # Child reported an error - mark job as failed and distribute next
    return {
        success => FALSE,
        error   => "Child $pid reported error: "
            . ( $msg->{error} // 'unknown' ),
        child_error => $msg->{error}
    };

} else {
    return { success => FALSE, error => "Unknown command from child: $cmd" };
}

