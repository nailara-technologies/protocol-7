## [:< ##

# name  = coding.vision-parser.init_code
# descr = initialize vision-text-extraction state machine and variable watchers

# Initialize state machine infrastructure
<coding.vision-parser.state>  = 'pending';
<coding.vision-parser.jobs>   = {};
<coding.vision-parser.timers> = {};

<[base.logs]>->( 1, '[vision-parser] state machine initialized' );

# Register variable watcher on state variable
# This watcher triggers state_transition handler whenever state is written to
<coding.vision-parser.watcher.state> = <[event.add_var]>->(
    {   'var'     => \<coding.vision-parser.state>,
        'poll'    => qw| w |,                         # Watch for writes
        'handler' => qw| coding.vision-parser.handler.state_transition |,
        'repeat'  => TRUE,                                     # Keep watching
        'data'    => undef,
        'desc'    => '[vision-parser] state machine watcher'
    }
);

<[base.logs]>->( 1, '[vision-parser] state transition watcher registered' );

return TRUE;

