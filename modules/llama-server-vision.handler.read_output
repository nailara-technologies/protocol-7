## [:< ##

# name  = llama-server-vision.handler.read_output
# descr = non-blocking I/O handler - read output chunks from vision CLI

my $event = shift->w;
my $read_fh = $event->fd;
my $io_data = $event->data;

my $job_id = $io_data->{'job_id'};
my $stream = $io_data->{'stream'};

my $vision_job = <llama-server-vision.jobs>->{$job_id};

unless ( defined $vision_job ) {
    $event->cancel if $event->is_active;
    return;
}

# Read available data (non-blocking)
my $bytes = <[base.s_read]>->(
    $read_fh,
    \$vision_job->{'output'},
    8 * 1024  # Read up to 8KB at a time
) // 0;

<[base.logs]>->( 2, "[read_output] job=%s stream=%s bytes=%d", $job_id, $stream, $bytes )
    if $bytes > 0;

# Check for EOF
if ( $bytes <= 0 ) {
    # EOF reached on this stream
    $vision_job->{ $stream eq 'stdout' ? 'rdr_closed' : 'err_closed' } = 1;
    close($read_fh);
    $event->cancel if $event->is_active;
    <[base.logs]>->( 2, "[read_output] EOF: job=%s stream=%s", $job_id, $stream );
}

