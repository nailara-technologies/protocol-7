## [:< ##

# name  = llama-server-vision.handler.read_output
# descr = non-blocking I/O handler - read output chunks from vision CLI

my $event = shift->w;
my $read_fh = $event->fd;
my $io_data = $event->data;

my $job_id = $io_data->{'job_id'};
my $stream = $io_data->{'stream'};

my $vision_job = <llama-server-vision.jobs>->{$job_id};

unless ( defined $vision_job ) {
    $event->cancel if $event->is_active;
    return;
}

# Read available data (non-blocking)
# Keep stdout and stderr separate - we only want stdout for the payload
my $output_buffer = $stream eq 'stdout' ? \$vision_job->{'output'} : \$vision_job->{'stderr'};
my $bytes = <[base.s_read]>->(
    $read_fh,
    $output_buffer,
    8 * 1024  # Read up to 8KB at a time
) // 0;

if ( $bytes > 0 ) {
    my $total_stdout = length($vision_job->{'output'});
    my $total_stderr = length($vision_job->{'stderr'});
    <[base.logs]>->( 2, "[read_output] job=%s stream=%s bytes=%d (accumulated: stdout=%d, stderr=%d)",
                     $job_id, $stream, $bytes, $total_stdout, $total_stderr );
} elsif ( $bytes == 0 ) {
    my $total_stdout = length($vision_job->{'output'});
    my $total_stderr = length($vision_job->{'stderr'});
    <[base.logs]>->( 2, "[read_output] job=%s stream=%s EOF detected (final: stdout=%d, stderr=%d)",
                     $job_id, $stream, $total_stdout, $total_stderr );
} else {
    <[base.logs]>->( 2, "[read_output] job=%s stream=%s error: %s", $job_id, $stream, $! );
}

# Check for EOF
if ( $bytes <= 0 ) {
    # EOF reached on this stream
    $vision_job->{ $stream eq 'stdout' ? 'rdr_closed' : 'err_closed' } = 1;
    close($read_fh);
    $event->cancel if $event->is_active;
    <[base.logs]>->( 2, "[read_output] EOF: job=%s stream=%s", $job_id, $stream );
}

