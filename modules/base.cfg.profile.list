## [:< ##

# name  = base.cfg.profile.list
# descr = return list of defined profile names for current zenka

my $zenka = <system.zenka.name> // '';

return () if not length $zenka;

my $profiles_ref = $data{$zenka}{cfg}{profiles} // {};

return sort keys %{$profiles_ref};

