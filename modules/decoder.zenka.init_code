## [:< ##

# name  = decoder.zenka.init_code
# descr = Initialize decoder for level-5 base32 stream handling

## Decoder: receives entropy from zulum, accumulates base32 values ##

## Level-5 accumulator state ##
<decoder.level5> = {
    'accumulator' => '',    ## accumulated bits ##
    'bit_count'   => 0,     ## bits in accumulator ##
    'values'      => [],    ## decoded base32 values ##
};

## Initialize rolling buffer for base32 values ##
if ( not exists <buffer.level-5-B32> ) {
    <buffer.level-5-B32.max_size> = 65536;    ## 64K rolling buffer ##
    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
    <[base.buffer.add_line]>->(
        qw| level-5-B32 |,
        join( ' ',
            $time_stamp, 0, 'level-5 base32 accumulator initialized ..,' ),
        0
    );
}

## Attach to zulum streams on request ##
<decoder.attached_streams> = [];

<[base.log]>->( 2, "[decoder] level-5 accumulator initialized" );

return TRUE;

