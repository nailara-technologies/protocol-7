## [:< ##

# name  = decoder.zenka.init_code
# descr = Initialize decoder — level-5 B32, level-6 D3, Term::VTerm surface

## load Term::VTerm for ANSI/VT sequence parsing ##
<[base.perlmod.autoload]>->('Term::VTerm');
<[base.perlmod.autoload]>->('Term::VTerm::Screen');

## level-5 accumulator state ##
<decoder.level5> = {
    'accumulator' => '',    ## accumulated bits ##
    'bit_count'   => 0,     ## bits in accumulator ##
    'values'      => [],    ## decoded base32 values ##
};

## level-6 D3 state — 3 decimal digits per unicode char ##
$data{'decoder'}{'level6_acc'}     = '';
$data{'decoder'}{'boundary_count'} = 0;
$data{'decoder'}{'INDEXCUBE'}      = [];

## initialize level-5-B32 rolling buffer ##
if ( not exists <buffer.level-5-B32> ) {
    <buffer.level-5-B32.max_size> = 65536;
    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
    <[base.buffer.add_line]>->(
        qw| level-5-B32 |,
        join( ' ',
            $time_stamp, 0, 'level-5 base32 accumulator initialized .., ' ),
        0
    );
}

## initialize level-6-D3 rolling buffer ##
if ( not exists <buffer.level-6-D3> ) {
    <buffer.level-6-D3.max_size> = 65536;
    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
    <[base.buffer.add_line]>->(
        qw| level-6-D3 |,
        join( ' ',
            $time_stamp, 0,
            'level-6 d3 linguistic projection initialized .., ' ),
        0
    );
}

## initialize Term::VTerm surface — 25×80 terminal [ matches xterm wrapper ] ##
$data{'decoder'}{'vterm'} = Term::VTerm->new( rows => 25, cols => 80 );
my $screen = $data{'decoder'}{'vterm'}->obtain_screen;
$screen->set_damage_merge(2);    ## VTERM_DAMAGE_SCROLL ##
$data{'decoder'}{'vterm_screen'} = $screen;

## stream attachment registry ##
<decoder.attached_streams> = [];

<[base.log]>->(
    2, "decoder initialized — level-5 B32, level-6 D3, vterm 25×80"
);

return TRUE;

