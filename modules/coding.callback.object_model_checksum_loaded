# name  = coding.callback.object_model_checksum_loaded
# descr = dependency callback : true when the object's checksum is the
#         currently-loaded, ready model on the object's backend - live
#         self-computing check, no manual flag to flip

my $object_id = shift;
my $obj       = <dependency.object>->{$object_id} // {};
my $checksum  = $obj->{'checksum'}                // '';
my $backend   = $obj->{'backend'}                 // qw| gpu |;

return FALSE if !length $checksum;

my $server = ( <coding.inference_servers> // {} )->{$backend} // {};
my $status = $server->{'status'}                              // '';
my $model  = $server->{'model'}                               // '';

return $status eq qw| ready | && $model eq $checksum;

