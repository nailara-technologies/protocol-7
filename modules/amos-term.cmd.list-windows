## [:< ##

# name  = amos-term.cmd.list-windows
# descr = List all 3D terminal windows

my $output = ".: amos-term windows :.\n\n";

my $by_amos = <amos-term.windows.by_amos> // {};
my @windows = keys %$by_amos;

if ( @windows == 0 ) {
    $output .= "No windows created\n";
    return { 'mode' => 'size', 'data' => $output };
}

$output .= sprintf( "%-12s %-20s %s\n", "AMOS ID", "Name", "State" );
$output .= "-" x 50 . "\n";

my $by_id = <amos-term.windows.by_id> // {};

foreach my $amos_id ( sort @windows ) {
    my $session_id = $by_amos->{$amos_id};
    my $window     = $by_id->{$session_id};
    next unless defined $window;

    my $state = $window->{'state'};
    my $name  = $window->{'client_name'};

    my $state_str
        = $state == 0 ? 'created'
        : $state == 1 ? 'active'
        : $state == 2 ? 'hidden'
        : $state == 3 ? 'fullscreen'
        :               'unknown';

    $output .= sprintf( "%-12s %-20s %s\n", $amos_id, $name, $state_str );
}

return { 'mode' => 'size', 'data' => $output };

