## [:< ##

# name  = job-site-scan.handler.rewire-all
# descr = re-register task.wait-done for all orphaned assessing jobs

my $queue = <job-site-scan.rewire_queue> // [];

<[base.logs]>->(
    1,
    'jss: rewire-all: processing %d orphaned tasks',
    scalar @{$queue}
);

for my $entry ( @{$queue} ) {
    my $job_id  = $entry->{'job_id'}  // '';
    my $task_id = $entry->{'task_id'} // '';
    next if not length $job_id or not length $task_id;

    <[base.logs]>
        ->( 2, 'jss: re-wiring job %s → task %s', $job_id, $task_id );

    <[protocol-7.route-send]>->(
        {   'command'   => 'task.wait-done',
            'call_args' => { 'args' => $task_id },
            'reply'     => {
                'handler' => 'job-site-scan.handler.assess-done',
                'params'  => { 'job_id' => $job_id, 'task_id' => $task_id },
            },
        }
    );
}

<job-site-scan.rewire_queue> = [];

