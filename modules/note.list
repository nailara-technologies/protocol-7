## [:< ##

# name  = note.list
# descr = list available note trees with L1 summaries

my ($filter_tag, $max_results) = @ARG;

$max_results //= 20;

my $base_dir = <[file.zenka_dir.data]> . '/notes';
return { 'mode' => qw| true |, 'data' => [] } unless -d $base_dir;

my @task_dirs = <[file.glob]>->("$base_dir/*/");
my @results;

for my $task_dir (@task_dirs) {
    next unless -d $task_dir;
    
    my $task_id = <[file.basename]>->($task_dir);
    my $meta_file = "$task_dir/.meta";
    my $short_file = "$task_dir/summary.short";
    
    my $entry = {
        'task_id' => $task_id,
        'has_L1'  => (-f $short_file && -s $short_file) ? 1 : 0,
        'has_L2'  => (-f "$task_dir/summary.long" && -s _) ? 1 : 0,
    };
    
    ## load metadata if available ##
    if (-f $meta_file) {
        my $meta = eval { JSON::PP::decode_json(<[file.read]>->($meta_file)) };
        if (ref $meta eq qw| HASH |) {
            $entry->{'created'} = $meta->{'created'};
            $entry->{'zenka'}   = $meta->{'zenka'};
            $entry->{'tags'}    = $meta->{'tags'};
            $entry->{'status'}  = $meta->{'status'};
            $entry->{'rounds'}  = $meta->{'rounds'};
            
            ## filter by tag if requested ##
            if (defined $filter_tag && length $filter_tag) {
                my $found = 0;
                for my $tag (@{$meta->{'tags'} // []}) {
                    $found = 1 if $tag eq $filter_tag;
                }
                next unless $found;
            }
        }
    }
    
    ## load L1 preview if available ##
    if ($entry->{'has_L1'}) {
        my $content = <[file.read]>->($short_file);
        $entry->{'preview'} = <[base.parser.ellipse_center]>->($content, 120);
    }
    
    push @results, $entry;
    last if @results >= $max_results;
}

## sort by creation time, newest first ##
@results = sort { $b->{'created'} <=> $a->{'created'} } @results;

return {
    'mode' => qw| true |,
    'data' => \\&results,
};

