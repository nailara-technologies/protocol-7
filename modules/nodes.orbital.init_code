## [:< ##

# name  = nodes.orbital.init_code
# descr = derive and publish orbital position from local ip + session key

## confirm Net::IP::Lite is available ##
<[base.perlmod.autoload]>->('Net::IP::Lite');

## detect local ip address ##
my $local_ip = '127.0.0.1';
my @candidates;

if ( eval { <[base.perlmod.autoload]>->('IO::Interface::Simple'); 1 } ) {
    foreach my $ifobj ( IO::Interface::Simple->interfaces ) {
        next if $ifobj->is_loopback;
        next if not $ifobj->is_running;
        next if not defined $ifobj->address;

        my $ip = $ifobj->address;
        next if $ip !~ m|^\d+\.\d+\.\d+\.\d+$|;

        my $is_rfc1918 = $ip =~ m[
            (^10\.)|
            (^127\.)|
            (^192\.168\.)|
            (^172\.1[6-9]\.)|(^172\.2[0-9]\.)|(^172\.3[0-1]\.)
        ]x;

        push @candidates,
            { 'ip' => $ip, 'is_rfc1918' => $is_rfc1918 ? 1 : 0 };
    }
}

## prefer non-rfc1918, then any available ##
if (@candidates) {
    @candidates
        = sort { $a->{'is_rfc1918'} <=> $b->{'is_rfc1918'} } @candidates;
    $local_ip = $candidates[0]->{'ip'};
}

<nodes.orbital.local_ip> = $local_ip;

## derive orbital parameters from ip octets ##
my @octets = split( qw| \. |, $local_ip );
my $theta  = $octets[0] / 255 * 360;
my $phi    = $octets[1] / 255 * 360;
my $psi    = $octets[2] / 255 * 360;
my $omega  = $octets[3] / 255 * 360;

## store session start time ##
my $session_start = <[base.ntime]>->(3);
<nodes.orbital.session_start> = $session_start;

## store derived params ##
<nodes.orbital.params> = {
    'theta' => $theta,
    'phi'   => $phi,
    'psi'   => $psi,
    'omega' => $omega
};

## compute initial addr_b32 with zero time offset ##
my $addr_b32 = <[nodes.orbital.addr_b32]>->(
    {   'theta'       => $theta,
        'phi'         => $phi,
        'psi'         => $psi,
        'omega'       => $omega,
        'time_offset' => 0
    }
);

## compute CHKSUM7 using local ip as seed input ##
my $amos_chksum = $code{'chk-sum.amos'} // $code{'base.chk-sum.amos'};
my $chksum7     = substr( $amos_chksum->($local_ip), 0, 7 );

my $p7ref = sprintf( "NODE:%s:%s", $chksum7, $addr_b32 );

## push onto @INDEXCUBE ##
<[base.indexcube.push]>->( { 'p7ref' => $p7ref } );

<nodes.orbital.current_p7ref> = $p7ref;

## set up repeating timer to keep position current ##
<[event.add_timer]>->(
    {   'interval' => 13,
        'repeat'   => TRUE,
        'handler'  => 'nodes.orbital.update_position'
    }
);

<[base.logs]>->(
    2,
    "[orbital.init] params derived from %s [ theta=%.2f phi=%.2f psi=%.2f omega=%.2f ] initial %s",
    $local_ip,
    $theta,
    $phi,
    $psi,
    $omega,
    $p7ref
);

0;

