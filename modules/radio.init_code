## [:< ##

# name = radio.init_code
# descr = initialize radio relay zenka

<[base.perlmod.autoload]>->( 'IPC::Open3', qw| open3 | );
<[base.perlmod.autoload]>->( 'Fcntl',      qw| :DEFAULT | );
<[base.perlmod.autoload]>->(qw| IO::Handle |);
<[base.perlmod.autoload]>->( 'File::Path', qw| make_path | );
<[base.perlmod.autoload]>->( 'List::Util', qw| shuffle   | );

<radio.listeners>  //= [];
<radio.stream.icy> //= {
    headers_done   => 0,
    header_buf     => '',
    metaint        => 8192,
    bytes_to_meta  => 8192,
    meta_expected  => 0,
    meta_buf       => '',
    current_title  => '',
    is_jingle      => 0,
    track_started  => undef,
    track_duration => undef,
    keep_flagged   => 0,
    rip_fh         => undef,
    rip_path       => undef,
    rip_bytes      => 0
};

<radio.gap_fill.active>   //= 0;
<radio.keep_library.path> //= '/var/protocol-7/radio/keep-library';

if ( ( <radio.stream.auto_connect> // '' ) eq qw| yes | ) {
    <[event.add_timer]>->(
        {   after   => 0.5,
            handler => qw| radio.connect |,
        }
    );
}

0;

