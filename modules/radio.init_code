## [:< ##

# name = radio.init_code
# descr = initialize radio relay zenka

<[base.perlmod.autoload]>->('IO::Socket::SSL');
<[base.perlmod.autoload]>->( 'File::Path', qw| make_path | );
<[base.perlmod.autoload]>->( 'List::Util', qw| shuffle   | );

<radio.listeners>  //= [];
<radio.stream.icy> //= {
    headers_done   => 0,
    header_buf     => '',
    metaint        => 8192,
    bytes_to_meta  => 8192,
    meta_expected  => 0,
    meta_buf       => '',
    current_title  => '',
    is_jingle      => 0,
    track_started  => undef,
    track_duration => undef,
    keep_flagged   => 0,
    rip_fh         => undef,
    rip_path       => undef,
    rip_bytes      => 0
};

<radio.gap_fill.active>   //= 0;
<radio.keep_library.path> //= catdir( <system.path.zenka-dirs.var_P7>,
    <system.zenka.name>, 'keep-library' );
<radio.audio.online_count> //= 0;
<radio.audio.active>       //= 0;

<radio.stream.reconnect_delay>   //= 5;
<radio.stream.reconnect_watcher> //= undef;
<radio.audio.reinit_watcher>     //= undef;

if ( ( <radio.stream.auto_connect> // '' ) eq qw| yes | ) {
    <[base.logs]>->(
        2,
        '[radio] auto_connect enabled [ url: %s ]',
        <radio.stream.url> // '(none)'
    );
    <[event.add_timer]>->(
        {   after   => 0.5,
            handler => qw| radio.connect |,
        }
    );
} else {
    <[base.logs]>->( 2, '[radio] auto_connect disabled' );
}

<[event.add_timer]>->(
    {   after   => 1.0,
        handler => qw| radio.post_init |,
    }
);

<[event.add_timer]>->(
    {   after   => 2.0,
        handler => qw| radio.audio.init |,
    }
);

##  radio stream log buffer  ##
##
if ( not exists <buffer.radio-stream> ) {
    <buffer.radio-stream.max_size> = 16 * 1024;    ## 16K buffer size ##
    my $log_level  = 0;
    my $log_msg    = 'radio stream log initialized';
    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
    <[base.buffer.add_line]>->(
        qw| radio-stream |,
        join( ' ', $time_stamp, $log_level, $log_msg ), $log_level
    );
}

##  radio jingle log buffer  ##
##
if ( not exists <buffer.radio-jingle> ) {
    <buffer.radio-jingle.max_size> = 16 * 1024;    ## 16K buffer size ##
    my $log_level  = 0;
    my $log_msg    = 'radio jingle log initialized';
    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
    <[base.buffer.add_line]>->(
        qw| radio-jingle |,
        join( ' ', $time_stamp, $log_level, $log_msg ), $log_level
    );
}

0;

