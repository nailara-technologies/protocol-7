## [:< ##

# name = httpsd.post_init
# descr = post-initialization socket creation with graceful cert handling
# note = called after all modules loaded, can use all functionality

<[base.logs]>->( 2, 'httpsd: post-initialization starting' );

## check if HTTPS is enabled
unless ( <httpsd.cfg.enable_https> // 1 ) {
    <[base.logs]>->( 2, 'httpsd: HTTPS disabled, skipping socket creation' );
    return TRUE;
}

## skip socket creation if already active [ in-process reload scenario ]
if ( defined <httpsd.sock> and fileno(<httpsd.sock>) ) {
    <[base.logs]>->( 2, 'httpsd: ssl socket already active, skipping' );
    return TRUE;
}

## check certificate availability
my $cert_info = <[httpsd.check_certificate_available]>;

if ( !$cert_info->{available} ) {
    ## certificate not available - defer socket creation
    <[base.logs]>->(
        1,
        'httpsd: certificate not available, deferring HTTPS socket creation'
    );
    <[base.logs]>->(
        2,
        'httpsd: will retry periodically, use httpsd.socket-status to check'
    );
    <httpsd.socket_deferred> = 1;
    return TRUE;
}

## binding port 443 requires root privileges [ lost after drop_privs ]
## if running non-root [ in-process reload ], request a v7 restart instead
if ( $> != 0 ) {
    <[base.logs]>->( 1, 'httpsd: non-root: requesting self-restart..' );
    <[httpsd.self_restart]>;
    return TRUE;
}

## certificate available - create SSL socket and bind protocol
<[base.logs]>->( 2, 'httpsd: certificate available, creating HTTPS socket' );

<httpsd.sock>
    = <[httpsd.create_ssl_socket]>->( <net.https.addr>, <net.https.port> );

unless ( defined <httpsd.sock> ) {
    <[base.logs]>->( 0, 'httpsd: failed to create SSL socket' );
    return FALSE;
}

## register socket in data structure
unless ( <[httpsd.register_socket]>->( <httpsd.sock>, 'ip.ssl', 'input' ) ) {
    <[base.logs]>->( 0, 'httpsd: failed to register SSL socket' );
    return FALSE;
}

## bind HTTPS protocol to socket
unless ( <[base.protocol.bind]>->( <httpsd.sock>, 'https', 'server' ) ) {
    <[base.logs]>->( 0, 'httpsd: failed to bind HTTPS protocol' );
    return FALSE;
}

<[base.logs]>->( 2, 'httpsd: HTTPS socket created and bound successfully' );

return TRUE;

0;

