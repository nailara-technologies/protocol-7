## [:< ##

# name = plugin.web.menu.tree
# descr = generate hierarchical tree menu navigation from /data/web/ structure
# args  = $current_path, $base_dir, $max_depth

my $current_path = shift // '';
my $base_dir     = shift // '/data/web';
my $max_depth    = shift // 3;

## Clean up current path ##
$current_path =~ s/^\/+|\/+$//g;
$current_path =~ s|\.\.+|.|g;

<[base.log]>->(
    3,
    "plugin.web.menu.tree: generating menu for '$current_path' (depth: $max_depth)"
);

## Determine which top-level directory to expand ##
my $first_segment = $current_path;
$first_segment =~ s/\/.*$//;

## Scan root directory ##
my $root_scan = <[web.scan_directory]>->( $base_dir, '', {} );

if ( $root_scan->{status} ne qw| success | ) {
    <[base.log]>->(
        1, "plugin.web.menu.tree: failed to scan root: " . $root_scan->{error}
    );
    return qq| <p>Menu not available</p> |;
}

my @html_lines;
push @html_lines, qq|<nav class="web-menu-tree">|;
push @html_lines, qq|<ul class="menu-level-0">|;

## Generate menu items ##
foreach my $item ( @{ $root_scan->{items} } ) {
    ## Only show directories and index files ##
    next if $item->{type} eq 'file' and !$item->{is_index};

    my $item_path = $item->{path};
    my $is_active = (
               $current_path eq $item_path
            or $current_path =~ m|^\Q$item_path\E/|
    );

    my $css_class = 'menu-item';
    $css_class .= ' active'       if $is_active;
    $css_class .= ' current'      if $current_path eq $item_path;
    $css_class .= ' has-children' if $item->{type} eq 'dir';

    ## Format display name (replace underscores with spaces) ##
    my $display = $item->{display_name};
    $display =~ s|_| |g;

    push @html_lines, qq|  <li class="$css_class">|;

    if ($is_active) {
        push @html_lines,
            qq|    <a href="/$item_path" class="menu-link active"><strong>$display</strong></a>|;
    } else {
        push @html_lines,
            qq|    <a href="/$item_path" class="menu-link">$display</a>|;
    }

    ## If this is a directory and it matches the current path's first segment,
    ## recursively expand it ##
    if (    $item->{type} eq 'dir'
        and $first_segment eq $item->{name}
        and $max_depth > 1 ) {
        my $submenu_html = <[plugin.web.content.util.generate_submenu]>->(
            $base_dir, $item_path, $current_path, $max_depth - 1, 1
        );
        push @html_lines, $submenu_html if length($submenu_html);
    }

    push @html_lines, qq|  </li>|;
}

push @html_lines, qq|</ul>|;
push @html_lines, qq|</nav>|;

my $menu_html = join( "\n", @html_lines );

<[base.log]>->(
    3,
    "plugin.web.menu.tree: generated menu ("
        . scalar( @{ $root_scan->{items} } )
        . " items)"
);

return $menu_html;

