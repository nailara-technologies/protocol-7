## [:< ##

# name  = format.yaml.load_file
# descr = load and parse a yaml file — errors routed to yaml-errors buffer

my $path = shift // return undef;

if ( not defined <format.yaml.loader> ) {
    my $err = 'no yaml parser loaded [ format.yaml.pre_init required ]';
    <[base.logs]>->( 0, $err );
    return wantarray ? ( undef, $err ) : undef;
}

my ( $yaml_data, $err_summary );

eval { $yaml_data = <format.yaml.loader>->($path) };

## yaml::xs strict parsing failed — attempt pure-yaml fallback ##
##
if (    $EVAL_ERROR
    and defined <format.yaml.backend>
    and <format.yaml.backend> eq 'YAML::XS' ) {

    my $xs_err = <[base.str.eval_error]>;

    ## lazily load and cache the pure-yaml file loader ##
    ##
    <format.yaml.load_file_fallback> //= do {
        eval { <[base.perlmod.autoload]>->('YAML') };
        defined &YAML::LoadFile ? \&YAML::LoadFile : undef;
    };

    if ( defined <format.yaml.load_file_fallback> ) {
        eval { $yaml_data = <format.yaml.load_file_fallback>->($path) };
        if ($EVAL_ERROR) {
            $err_summary
                = sprintf 'YAML::XS: %s; YAML: %s',
                $xs_err, <[base.str.eval_error]>;
        }
        ## else: pure-yaml succeeded — continue with $yaml_data ##
    } else {
        $err_summary = "YAML::XS: $xs_err [ no yaml fallback available ]";
    }

} elsif ($EVAL_ERROR) {
    $err_summary = <[base.str.eval_error]>;
}

if ( defined $err_summary ) {
    <buffer.yaml-errors.max_size> //= 42 * 1024;
    <[base.buffer.add_line]>->( qw| yaml-errors |, '' );
    <[base.buffer.add_line]>->(
        qw| yaml-errors |,
        sprintf '[ yaml parse error ] %s', $path
    );
    <[base.buffer.add_line]>->( qw| yaml-errors |, $err_summary );
    <[base.buffer.add_line]>->( qw| yaml-errors |, '' );

    return wantarray ? ( undef, $err_summary ) : undef;
}

## parser returned undef without error [ empty file or bare '---' ] ##
##
if ( not defined $yaml_data ) {
    $err_summary = 'yaml parsed as empty [ no data returned ]';
    <buffer.yaml-errors.max_size> //= 42 * 1024;
    <[base.buffer.add_line]>->( qw| yaml-errors |, '' );
    <[base.buffer.add_line]>->(
        qw| yaml-errors |,
        sprintf '[ yaml empty result ] %s', $path
    );
    <[base.buffer.add_line]>->( qw| yaml-errors |, '' );
    return wantarray ? ( undef, $err_summary ) : undef;
}

return wantarray ? ( $yaml_data, undef ) : $yaml_data;

