# name  = coding.task.enqueue_round
# descr = schedule next inference round for task
# param = <task_id> <round>

my ( $task_id, $round ) = @ARG;

return { success => FALSE, error => 'task_id required' }
    unless defined $task_id;

return { success => FALSE, error => 'round required' }
    unless defined $round;

my $task = <coding.task.queue>->{$task_id};

return { success => FALSE, error => "task not found: $task_id" }
    unless defined $task;

## acquire backend lock or queue — backend_release wakes us if busy ##
my $backend = ( <coding.async.task_state>->{$task_id} // {} )->{'backend'}
    // qw| gpu |;
my $lock_result = <[coding.async.backend_acquire]>->( $task_id, $backend );

<[base.logs]>->(
    1, "enqueue_round: %s round=%d [backend %s: %s]",
    $task_id, $round, $backend,
    $lock_result->{'acquired'} ? 'acquired' : 'queued'
);

## proceed immediately if lock acquired — backend_release handles queued case ##
<[coding.async.send_request]>->($task_id) if $lock_result->{'acquired'};

return {
    success  => TRUE,
    task_id  => $task_id,
    round    => $round,
    deferred => TRUE,
};

