# name  = coding.task.enqueue_round
# descr = schedule next inference round via timer — bypasses jobqueue for N+1 rounds
# param = <task_id> <round>

my ( $task_id, $round ) = @ARG;

return { success => FALSE, error => 'task_id required' }
    unless defined $task_id;

return { success => FALSE, error => 'round required' }
    unless defined $round;

my $task = <coding.task.queue>->{$task_id};

return { success => FALSE, error => "task not found: $task_id" }
    unless defined $task;

## schedule send_request via timer — defers to next event loop tick ##
## [ the jobqueue dispatches synchronously via variable-watcher, which caused  ##
##   io-watcher registration to fail when nested inside timer/var-watcher chain ] ##
## [ using the timer directly avoids all nested-watcher issues ] ##
<[event.add_timer]>->(
    {   'after'   => 0.1,  ## 100ms: give server time to fully release slot ##
        'handler' => qw| coding.callback.backend_busy_retry |,
        'data'    => $task_id,
    }
);

<[base.logs]>->(
    1,        "enqueue_round: %s round=%d [scheduled via timer]",
    $task_id, $round
);

return {
    success  => TRUE,
    task_id  => $task_id,
    round    => $round,
    deferred => TRUE,
};

