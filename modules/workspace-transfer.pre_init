## [:< ##

# name  = workspace-transfer.pre_init
# descr = initialize path keywords for protocol-7 + workspace-transfer repos

my $env_href = <[workspace-transfer.env.detect_paths]>;
return
    <[base.s_warn]>
    ->(':: error :: while detecting workspace-transfer environment.')
    if ref $env_href ne qw| HASH |;

## [LLL] read symlink for path resolution in
## workspace-transfer.env.detect_paths from
## cfg/development/workspace-transfer-repository

## [LLL] use acquired path set-up here ..

###[ [protocol-7] + [workspace-transfer] ]###
##
<[base.path.register_keywords]>->($env_href);

0;

