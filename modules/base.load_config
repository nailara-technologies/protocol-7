## [:< ##

# name  = base.load_config

<[base.load_config_file]>->('global');

if ( <system.path.rel.cur_zenka_cfg> =~ /~$/ ) {
    <[base.log]>->( 0, "invalid zenka name (backup file!) - aborting." );
    exit(1);
}

<[base.load_config_file]>->(<system.path.rel.cur_zenka_cfg>);

