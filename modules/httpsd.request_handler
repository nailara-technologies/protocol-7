# name = httpsd.request_handler
# descr = HTTPS request handler - processes HTTP over TLS
# note : return 2 to close connection

# Protocol handler for HTTPS that delegates to HTTP request processing
# The TLS encryption/decryption is transparent at IO::Socket::SSL layer,
# so HTTP parsing is identical to plaintext HTTP.

# Delegate to httpd.request_handler to handle the actual HTTP processing
# httpd.request_handler expects an Event::Event::Io object, but we receive
# it from the session management system, so just pass it through directly
$code{'httpd.request_handler'}->( @_ );

