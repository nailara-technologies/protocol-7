# name = httpsd.request_handler
# descr = HTTPS request handler - adds HSTS headers and delegates to httpd handler
# note : return 2 to close connection

my $id      = $_[0]->w->data;
my $session = $data{'session'}->{$id};

# DEBUG: Check if we're being called
if ( defined $session ) {
    my $input_len = length($session->{'buffer'}->{'input'} // '');
    <[base.log]>->( 1, "[%d] httpsd.request_handler called, input_buffer_len=%d", $id, $input_len );
} else {
    <[base.log]>->( 0, "[%d] httpsd.request_handler: session not found!", $id );
    return 2;
}

# First call httpd request handler to process the HTTP request
my $result = <[httpd.request_handler]>->(@_);

# If httpd returned a response object (usually not directly in protocol state handler)
# Then modify HTTPS-specific headers
if ( defined $result && ref($result) eq 'HASH' && $result->{headers} ) {
    my $hsts_max_age = <httpsd.cfg.hsts_max_age> // 31536000;

    $result->{headers}->{'Strict-Transport-Security'}
        = "max-age=$hsts_max_age" . ( <httpsd.cfg.hsts_include_subdomains> ? "; includeSubDomains" : "" );

    <[base.log]>->( 3, "[%d] added HSTS header to HTTPS response", $id );
}

# Mark session as HTTPS for request processing
$session->{'is_https'} = 1 if defined $session;

return $result;

