# name = httpsd.request_handler
# descr = HTTPS request handler - wrapper for HTTP with TLS and HSTS support
# note : return 2 to close connection

# Handler calling is automatic via session management
# This handler is invoked by the event system when HTTPS data arrives
# It delegates to httpd.request_handler which will:
# 1. Parse the HTTP request
# 2. Call the appropriate HTTP method handler (GET, POST, etc.)
# 3. The method handler writes response to output buffer
# 4. base.handler.write is automatically called to send the response

# For now, just call httpd's handler - it handles all the HTTP processing
# The SSL encryption is transparent (handled by IO::Socket::SSL at socket level)
<[httpd.request_handler]>

