# name = httpsd.request_handler
# descr = HTTPS request handler - processes HTTP over TLS
# note : return 2 to close connection

## mark session as https for response generation [ HSTS headers, scheme ]
my $id = $_[0]->w->data;
$data{'session'}->{$id}->{'is_https'} = TRUE
    if defined $data{'session'}->{$id};

## delegate to standard http request handler [ TLS is transparent ]
return <[httpd.request_handler]>->( $_[0] );

