## [:< ##

# name = httpsd.request_handler
# descr = HTTPS request handler - processes HTTP over TLS
# note : return 2 to close connection

# Receive Event object from protocol state handler invocation
<[base.logs]>->(
    2,
    ": httpsd.request_handler: event type='%s'",
    ref( $ARG[0] ) // 'UNDEF'
);

if ( not defined $ARG[0] or ref $ARG[0] ne qw| Event::Event::Io | ) {
    return <[base.s_warn]>->(
        "expected event argument [got:'%s', ref:'%s'] <{C1}>",
        $ARG[0] // qw| UNDEF |,
        ref( $ARG[0] ) // qw| UNDEF |
    );
}
my $event = shift;

# Extract session ID from event watcher [same pattern as httpd.request_handler]
my $id = $event->w->data if defined $event;

if ( not defined $id or $id !~ m|^\d+$| ) {
    <[base.logs]>->(
        0,
        "[%d] httpsd.request_handler: session id not defined! [event param?]",
        $id
    );
    return 2;
}

## acquiring current session hash structure ##
my $session = $data{'session'}->{$id};

# Mark session as HTTPS before processing the request
$session->{'is_https'} = TRUE if defined $session;

# Verify session exists
if ( not defined $session ) {
    <[base.logs]>->( 0, "[$id]: HTTPS session not found!" );
    return 2;
}

my $input_len = length( $session->{'buffer'}->{'input'} // '' );
<[base.logs]>->( 2, "[%d]: HTTPS request [input=%d bytes]", $id, $input_len );

# Delegate to httpd request handler (response goes to output buffer for SSL write)
<[base.log]>->( 2, ": delegating to httpd.request_handler" );
my $result = <[httpd.request_handler]>->($event) if defined $event;

if ( not defined $result ) {
    <[base.log]>->( 0, "[$id]: httpd.request_handler failed" );
    return 2;
}

## Flush output buffer for HTTPS responses
my $check_session = $data{'session'}->{$id};
if ( defined $check_session ) {
    my $buffer_len = length( $check_session->{'buffer'}->{'output'} // '' );
    if ( $buffer_len > 0 ) {
        $check_session->{'flush_shutdown'} = 1;
        <[base.logs]>->(
            2,   ": [%d]: flushing HTTPS response [%d bytes]",
            $id, $buffer_len
        );
        <[base.handler.write]>->($event);
    }
}

return $result;

