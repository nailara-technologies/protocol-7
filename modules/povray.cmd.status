## [:< ##

# name  = povray.cmd.status
# param = <render-id>
# descr = poll render state, path if done

my $id = $call->{'args'} // '';
$id =~ s|^\s+||;
$id =~ s|\s+$||;

return { 'mode' => qw| false |, 'data' => 'render id required' }
    if not length $id;

if ( my $state = <povray.render>->{$id} ) {
    return {
        'mode' => qw| true |,
        'data' => sprintf(
            'running : pid %d, %ds elapsed, out %s',
            $state->{'pid'} // 0,
            time - ( $state->{'started'} // time ),
            $state->{'out_png'} // ''
        )
    };
}

if ( my $finished = <povray.finished>->{$id} ) {
    return {
        'mode' => qw| true |,
        'data' => sprintf 'done : %s',
        $finished->{'path'}
        }
        if $finished->{'ok'};
    return {
        'mode' => qw| false |,
        'data' => sprintf 'error : %s',
        $finished->{'error'} // 'unknown'
    };
}

return {
    'mode' => qw| false |,
    'data' => sprintf 'unknown render id : %s',
    $id
};

