## [:< ##

# name  = letsencrypt.parent.query_httpd_vhosts
# descr = Query httpd zenka for list of configured virtual hosts

<[base.log]>->( 2, 'querying httpd zenka for vhost list..' );

## Check if httpd is available via cube
## Note: httpd.vhost-list may not be available if httpd zenka is not running
## In that case, we gracefully return empty list and proceed with primary domain only

my $reply = eval {
    <[base.protocol-7.command.send.local]>->(
        {   'command'   => qw| cube.httpd.vhost-list |,
            'call_args' => { 'args' => '' },
        }
    );
};

unless ( $reply && ref($reply) eq qw| HASH | ) {
    <[base.log]>->(
        2, 'httpd.vhost-list not available [ httpd may not be running ]'
    );
    return {
        'status' => qw| error |,
        'error'  => 'httpd not available',
        'vhosts' => [],
    };
}

## Parse reply based on mode
my $mode = $reply->{cmd}  // $reply->{mode};
my $reply_data = $reply->{data} // '';

unless ($mode) {
    <[base.log]>->( 2, 'httpd.vhost-list returned unexpected format' );
    return {
        'status' => qw| error |,
        'error'  => 'invalid reply format',
        'vhosts' => [],
    };
}

<[base.logs]>->(
    3,     ': httpd reply mode : %s, data length : %d',
    $mode, length($reply_data)
);

## The vhost-list returns multiple lines of vhost names
my @vhosts;
if ( $mode eq qw| SIZE | ) {
    ## SIZE mode means multi-line output
    @vhosts = grep { length($_) > 0 } split( m|\n|, $reply_data );
} elsif ( $mode eq qw| TRUE | ) {
    ## TRUE mode with data contains vhost names separated by newlines
    @vhosts = grep { length($_) > 0 } split( m|\n|, $reply_data );
} else {
    <[base.logs]>->(
        1, ': warning : unexpected reply mode from httpd : %s', $mode
    );
    return {
        'status' => qw| error |,
        'error'  => sprintf( 'unexpected reply mode : %s', $mode ),
        'vhosts' => [],
    };
}

## Remove whitespace
@vhosts = map  { s{^\s+|\s+$}{}g; $ARG } @vhosts;
@vhosts = grep { length($_) > 0 } @vhosts;

if ( @vhosts == 0 ) {
    <[base.log]>->( 1, ': warning : httpd returned no vhosts' );
    return {
        'status' => qw| error |,
        'error'  => 'No vhosts from httpd',
        'vhosts' => [],
    };
}

<[base.logs]>->( 2, 'found %d vhosts from httpd', scalar(@vhosts) );
foreach my $vh (@vhosts) {
    <[base.logs]>->( 3, '  - %s', $vh );
}

## Cache the vhost list with timestamp
<letsencrypt.parent.vhosts_cache> = {
    'vhosts'    => \@vhosts,
    'timestamp' => <[base.time]>,
    'ttl'       => 3600,            # 1 hour cache TTL
};

return {
    'status' => qw| success |,
    'vhosts' => \@vhosts,
};

