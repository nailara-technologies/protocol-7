## [:< ##

# name = index.stats
# descr = report current disk geometry as formatted string

my $total_chars = <index.meta>->{'total'} // 0;

my @lines;
push @lines, sprintf "index disk geometry";
push @lines, sprintf "  chars ingested : %d", $total_chars;

## per-ring counts ##
my $ring0_count = scalar keys %{ <index.freq> // {} };
push @lines, sprintf "  ring 0 : %6d tokens", $ring0_count;

for my $depth ( sort { $a <=> $b } keys %{<index.packed_rank>} ) {
    next if $depth == 0;
    my $count
        = length( <index.packed_rank>->{$depth} // '' ) / ( $depth + 1 );
    push @lines, sprintf "  ring %d : %6d sequences", $depth, $count;
}

## top inner ring (disk 0) ##
my @inner = map { [ $ARG, <index.addr>->{"0:$ARG"}, <index.freq>->{$ARG} ] }
    sort { <index.freq>->{$b} <=> <index.freq>->{$a} }
    keys %{ <index.freq> // {} };

my $top_n = 13;
@inner = @inner[ 0 .. ( $top_n - 1 < $#inner ? $top_n - 1 : $#inner ) ];

push @lines, sprintf "  inner ring [ top %d ] :", scalar @inner;
for my $entry (@inner) {
    ( my $disp = $entry->[0] ) =~ s/\n/\\n/g;
    $disp                      =~ s/\r/\\r/g;
    $disp                      =~ s/\t/\\t/g;
    $disp                      =~ s/\v/\\v/g;
    push @lines, sprintf "    %4d  %s  [ freq %d ]",
        $entry->[1], $disp, $entry->[2];
}

my $result = join "\n", @lines;

return { mode => 'size', data => $result };

