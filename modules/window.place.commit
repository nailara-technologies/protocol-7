## [:< ##

# name  = window.place.commit
# descr = save placement geometry and reply to caller

my $id = shift;

return undef if not defined $id;

my $inst = $data{window}{place}{instances}{$id};
return undef if not defined $inst;

my $geom = $inst->{'geom'}   // {};
my $x    = $geom->{'x'}      // 0;
my $y    = $geom->{'y'}      // 0;
my $w    = $geom->{'width'}  // 1;
my $h    = $geom->{'height'} // 1;

my $caller = $inst->{'caller'} // '';

if ( length $caller ) {
    <[window.profile.save]>->( $caller, $x, $y, $w, $h );
}

my $reply_id = $inst->{'reply_id'};

my $reply_args = sprintf 'x=%d y=%d width=%d height=%d profile=saved',
    $x, $y, $w, $h;

if ( defined $reply_id and $reply_id =~ m|^\d+$| ) {
    <[base.callback.cmd_reply]>->(
        $reply_id,
        {   'mode' => qw| true |,
            'data' => $reply_args
        }
    );
} else {
    <[base.logs]>->(
        1, '[place.commit] id=%s no reply_id, skipping direct reply', $id
    );
}

## optional notification handler ##
my $reply_handler = $inst->{'reply_handler'} // '';
if ( length $reply_handler and length $caller ) {
    <[protocol-7.command.send.local]>->(
        {   'command' => sprintf( qw| cube.%s.%s |, $caller, $reply_handler ),
            'call_args' => { 'args' => $reply_args }
        }
    );
}

<[base.logs]>->( 1, '[place.commit] id=%s placement committed', $id );

## destroy the window if still alive ##
my $window = $inst->{'window'};
if ( defined $window and $window->get_visible ) {
    $window->destroy;
}

## stop instance timers ##
my $poll_timer = $inst->{'poll'}{'timer'};
$poll_timer->cancel if defined $poll_timer;

my $damp_timer = $inst->{'damp'}{'timer'};
$damp_timer->cancel if defined $damp_timer;

## remove instance state ##
delete $data{window}{place}{instances}{$id};

return TRUE;

