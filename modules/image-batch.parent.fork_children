# name = image-batch.parent.fork_children
# descr = Fork worker pool with socketpair IPC for batch processing

# Modules Socket and IO::Handle are pre-loaded by Protocol-7

my $concurrency = shift // 4;

return { success => FALSE, error => 'Concurrency must be > 0' }
    if $concurrency <= 0;

my $batch_state = <image-batch.batch_state>;
return { success => FALSE, error => 'No batch_state available' }
    unless defined $batch_state;

# Register CHLD signal handler
<[event.add_signal]>->(
    {   'signal'  => qw| CHLD |,
        'handler' => qw| image-batch.parent.handle_child_exit |
    }
);

my $child_pids   = $batch_state->{child_pids};
my $forked_count = 0;
my $failed_count = 0;

# Fork worker processes
for ( my $worker_id = 1; $worker_id <= $concurrency; $worker_id++ ) {

    # Create socketpair for bidirectional IPC
    my ( $parent_pipe, $child_pipe );

    my $result = socketpair( $parent_pipe, $child_pipe, 1, 1, 0 );

    unless ($result) {
        $failed_count++;
        next;
    }

    # Set non-blocking mode and autoflush
    $parent_pipe->autoflush(1);
    $child_pipe->autoflush(1);

    # Fork child process
    my $pid = fork();

    if ( !defined $pid ) {

        # Fork failed
        close $parent_pipe;
        close $child_pipe;
        $failed_count++;
        next;

    } elsif ( $pid == 0 ) {

        # CHILD PROCESS

        # Close parent's end of pipe in child
        close $parent_pipe;

        # Reinitialize IO::AIO after fork
        eval {
            <[base.perlmod.load]>->('IO::AIO');
            IO::AIO::reinit();
        };

        # Load JSON module for communication
        <[base.perlmod.load]>->( 'JSON::XS', qw| encode_json decode_json | );

        # Set autoflush for pipe and send ready signal
        $child_pipe->autoflush(1);

        my $ready_msg = JSON::XS::encode_json(
            { cmd => 'ready', worker_id => $worker_id } );
        print {$child_pipe} "$ready_msg\n";
        $child_pipe->flush();

        # Child event loop: wait for jobs from parent
        while (1) {

            # Read JSON command from parent
            my $line = <$child_pipe>;
            last unless defined $line;    # Parent pipe closed

            chomp $line;

            # Parse JSON command
            my $job;
            eval { $job = JSON::XS::decode_json($line); };

            if ($@) {

                # Invalid JSON, send error and continue
                my $error_response = JSON::XS::encode_json(
                    {   cmd   => 'error',
                        error => "Failed to parse JSON: $@"
                    }
                );
                print {$child_pipe} "$error_response\n";
                next;
            }

            # Check command type
            if ( $job->{cmd} eq 'analyze' ) {

                # Process image analysis job
                my $result;
                eval { $result = <[image-batch.child.analyze_job]>->($job); };

                if ($@) {

                    # Job processing failed
                    $result = {
                        cmd        => 'result',
                        job_id     => $job->{job_id},
                        image_path => $job->{image_path},
                        success    => FALSE,
                        error      => "Job processing error: $@"
                    };
                }

                # Ensure result has required fields
                $result->{cmd}    //= 'result';
                $result->{job_id} //= $job->{job_id};

                # Send result back to parent
                my $response = JSON::XS::encode_json($result);
                print {$child_pipe} "$response\n";

                # Send ready signal for next job
                print {$child_pipe} "$ready_msg\n";

            } elsif ( $job->{cmd} eq 'shutdown' ) {

                # Parent signaled shutdown
                last;

            } else {

                # Unknown command
                my $error_response = JSON::XS::encode_json(
                    {   cmd   => 'error',
                        error => "Unknown command: $job->{cmd}"
                    }
                );
                print {$child_pipe} "$error_response\n";
            }
        }

        # Graceful exit
        close $child_pipe;
        exit(0);

    } else {

        # PARENT PROCESS

        # Close child's end of pipe in parent
        close $child_pipe;

        # Track child process
        $child_pids->{$pid} = {
            worker_id      => $worker_id,
            pid            => $pid,
            parent_pipe    => $parent_pipe,
            status         => qw| spawned |,
            spawned_at     => <[base.time]>->(3),
            current_job_id => undef,
            jobs_completed => 0
        };

        # Register event listener for child socketpair
        <[event.add_io]>->(
            {   'fd'      => $parent_pipe,
                'handler' => qw| image-batch.parent.handle_child_message |,
                'data'    => { 'pid' => $pid },
                'poll'    => qw| re |
            }
        );

        $forked_count++;
    }
}

return {
    success      => ( $forked_count > 0 ),
    forked_count => $forked_count,
    failed_count => $failed_count,
    concurrency  => $concurrency,
    message      => "Forked $forked_count worker processes"
        . ( $failed_count > 0 ? " ($failed_count failed)" : '' )
};

