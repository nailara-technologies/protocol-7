# name = image-batch.parent.fork_children
# descr = Fork worker pool with Protocol-7 sessions over socketpairs for batch processing

use Socket;

# Get current session ID for parent context
( my $session_id ) = keys <user.cube.session>->%*;

my $concurrency = shift // 4;

return { success => FALSE, error => 'Concurrency must be > 0' }
    if $concurrency <= 0;

my $batch_state = <image-batch.batch_state>;
return { success => FALSE, error => 'No batch_state available' }
    unless defined $batch_state;

<[base.log]>->( 1, 'forking image-batch children.,' );

# Enable session list for observability
<[base.enable_list]>->('sessions');

# Register CHLD signal handler
<[event.add_signal]>->(
    {   'signal'  => qw| CHLD |,
        'handler' => qw| base.handler.sig_chld.shutdown |
    }
);

my $child_pids   = $batch_state->{child_pids};
my $forked_count = 0;
my $failed_count = 0;

# Load parent-specific modules once (before fork loop)
<[base.load_modules]>->('image-batch.parent');
<[base.init_modules]>->();

# Fork worker processes
for ( my $worker_id = 1; $worker_id <= $concurrency; $worker_id++ ) {

    # Create socketpair for Protocol-7 session IPC
    my ( $child_pipe, $parent_pipe );

    my $result = socketpair( $child_pipe, $parent_pipe, AF_UNIX, SOCK_STREAM,
        PF_UNSPEC );

    unless ($result) {
        $failed_count++;
        next;
    }

    # Register pipes in data structure for Protocol-7 session handling
    map { $data{'handle'}{$ARG}{'link'} = qw| ipc.pipe | }
        ( $child_pipe, $parent_pipe );

    # Fork child process
    my $pid = fork();

    if ( !defined $pid ) {

        # Fork failed
        close $child_pipe;
        close $parent_pipe;
        $failed_count++;
        next;

    } elsif ( $pid == 0 ) {

        # CHILD PROCESS

        # Close parent's end and clean up pipe storage
        close $parent_pipe;
        delete <image-batch.pipe.child> if exists <image-batch.pipe.child>;

        # Reinitialize IO::AIO after fork
        IO::AIO::reinit();

        # Store child pipe for protocol-7 communication
        <image-batch.pipe.parent> = $child_pipe;

        # Set up logging identifier for this child process
        my $subname = <system.zenka.subname>;
        my $sn_str  = defined $subname ? ':' . $subname : '';
        <system.zenka.subname> = sprintf 'child%s[%d]', $sn_str, $worker_id;
        $PROGRAM_NAME = sprintf '%s[child%s]', <system.zenka.name>, $sn_str;

        # Mark parent session for shutdown when child closes
        $data{'session'}{$session_id}{'shutdown'} = 1;

        # Initialize Protocol-7 session over socketpair
        $data{'handle'}{$child_pipe}{'mode'} = qw| out |;
        my $id = <[base.session.init]>->(
            $child_pipe, qw| protocol-7 client parent |
        );

    # Set command handler so child can receive and execute Protocol-7 commands
        $data{'session'}{$id}{'input'}{'handler'}
            = qw| base.handler.command |;

        <[base.log]>->( 1, 'preparing to close cube session of child .,' );

        # Load and initialize child-specific modules
        <[base.load_modules]>->('image-batch.child');
        <[base.init_modules]>->();

    } else {

        # PARENT PROCESS

        # Close child's end
        close $child_pipe;

        # Initialize Protocol-7 session over socketpair
        $data{'handle'}{$parent_pipe}{'mode'} = qw| out |;
        my $id = <[base.session.init]>->(
            $parent_pipe, qw| protocol-7 client child |
        );

        # Set command handler so parent can send commands and receive replies
        $data{'session'}{$id}{'input'}{'handler'}
            = qw| base.handler.command |;

        # Track child process with Protocol-7 session info
        $child_pids->{$pid} = {
            worker_id      => $worker_id,
            pid            => $pid,
            session_id     => $id,
            status         => qw| spawned |,
            spawned_at     => <[base.time]>->(3),
            current_job_id => undef,
            jobs_completed => 0
        };

        $forked_count++;
    }
}

return {
    success      => ( $forked_count > 0 ),
    forked_count => $forked_count,
    failed_count => $failed_count,
    concurrency  => $concurrency,
    message      => "Forked $forked_count worker processes"
        . ( $failed_count > 0 ? " ($failed_count failed)" : '' )
};

