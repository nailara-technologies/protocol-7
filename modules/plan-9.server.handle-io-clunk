## [:< ##
# name  = plan-9.server.handle-io-clunk
# descr = Handle 9P Tclunk/Rclunk

use strict;
use warnings;

return sub {
    my ( $client, $tag, $data ) = @_;

    my $fid
        = <[plan-9.protocol.codec.decode-uint32]>->( substr( $data, 0, 4 ) );

    delete $client->{fids}{$fid};

    return <[plan-9.protocol.codec.encode-message]>->(
        <plan-9.protocol.constants.Rclunk>,
        $tag, ''
    );
};

