## [:< ##

# name = protocol-7-menu.graphical-startup-init
# descr = Initialize graphical menu during zenka startup [not on-demand]

return 0 unless <protocol-7-menu.init-graphical>;

<[base.log]>->( 1, "initializing graphical menu at startup" );

# Create window
my $window       = Gtk3::Window->new('toplevel');
my $scale_factor = <protocol-7-menu.cfg.scale_factor> //= 0.043;

my $logo_path = <protocol-7-menu.image_path>
    //= File::Spec->catfile( <system.root_path>,
    qw| data/gfx/logos/nailara.png | );

die "image file '$logo_path' not found" if !-f $logo_path;

# Set window properties
$window->signal_connect( qw| delete_event | => sub { Gtk3->main_quit } );

$window->set_position('none');
$window->set_border_width(0);
$window->set_keep_above(1);    # Keep window on top
$window->set_decorated(0);
$window->stick;
$window->set_app_paintable(1);

my $screen           = $window->get_screen;
my $use_transparency = $window->is_composited ? 1 : 0;
$window->set_opacity(1) if $use_transparency;

if ($use_transparency) {
    my $rgba = $screen->get_rgba_visual();
    $window->set_visual($rgba);
}

# Apply CSS styling
my $css_prov = Gtk3::CssProvider->new();
$css_prov->load_from_data(<<'EOT');
menu { background-color:#000013; border-color:#000042; color:#0055CC;
                                                       font-size:x-large }
menu *:hover { background-color:#000042; color:#0088FF }
menu *:focus { background-color:#000042; color:#0088FF }
EOT
Gtk3::StyleContext::add_provider_for_screen( $screen, $css_prov, -1 );

# Load and scale image
my $pbuf  = Gtk3::Gdk::Pixbuf->new_from_file($logo_path);
my $img_w = $pbuf->get_width();
my $img_h = $pbuf->get_height();
my $scr_w = $screen->get_width();
my $scr_h = $screen->get_height();

## positions are grouped by screen resolution: a position saved on one ##
## screen size [ eg. host display ] must never apply on another        ##
## [ eg. a small xephyr screen ], where it could fall off-screen        ##
my $screen_key = sprintf( qw| %dx%d |, $scr_w, $scr_h );

my $win_width = sprintf( qw|%.0f|, $scr_w * $scale_factor );
my $win_height
    = sprintf( qw|%.0f|, $img_h * ( ( $scr_w / $img_w ) * $scale_factor ) );

my $image = Gtk3::Image->new_from_pixbuf(
    $pbuf->scale_simple( $win_width, $win_height, 'hyper' ) );

$window->add($image);

# Enable pointer events for drag-to-move
$image->set_events(
    [qw(button-press-mask button-release-mask pointer-motion-mask)] );
$window->set_events(
    [qw(button-press-mask button-release-mask pointer-motion-mask)] );

# Drag-to-move detection: circular zones based on distance from center
my $menu_radius = $win_width
    * 0.35;    # ~35% = menu zone [ bright mandala - clickable for menu ]

# Anything outside menu_radius is draggable
my $window_center_x = $win_width / 2;
my $window_center_y = $win_height / 2;

## drag tracking state [ begin_move_drag avoided : it takes a compositor grab
## that weston sometimes does not release, freezing mouse input to this window ]
my $is_dragging = FALSE;
my ( $drag_start_xr,    $drag_start_yr )    = ( 0, 0 );
my ( $drag_win_start_x, $drag_win_start_y ) = ( 0, 0 );

## forward-declared : real values assigned after saved-position load
## [ closures below capture these variables; declaration must precede them ]
my ( $win_x_cache, $win_y_cache ) = ( 0, 0 );

## button press handler : detect drag or menu zone
$window->signal_connect(
    'button-press-event' => sub {
        my ( $widget, $event ) = @ARG;
        my $click_x = $event->x;
        my $click_y = $event->y;
        my $dist    = sqrt( ( $click_x - $window_center_x )**2
                + ( $click_y - $window_center_y )**2 );

        if ( $dist < $menu_radius ) {

            ## menu zone - bright mandala, allow menu to open on click
            return 0; # don't consume - let button-release handle menu opening

        } else {

            ## drag zone - left button only [ other buttons fall through ]
            return 0 unless $event->button == 1;

            ## Weston's XWM sends ConfigureNotify with WM-frame-relative coords
            ## instead of root coords, so $win_x/y_cache may be wrong [ eg 230
            ## when the actual root pos is 4635 ]. get_origin() calls
            ## XTranslateCoordinates which returns the true root position.
            my $gdk_win = eval { $widget->get_window() };
            if ( defined $gdk_win ) {
                my ( $rx, $ry ) = eval { $gdk_win->get_origin() };
                if ( defined $rx ) {
                    $win_x_cache = $rx;
                    $win_y_cache = $ry;
                }
            }

            $is_dragging      = TRUE;
            $drag_start_xr    = $event->x_root;
            $drag_start_yr    = $event->y_root;
            $drag_win_start_x = $win_x_cache;
            $drag_win_start_y = $win_y_cache;
            return 1;    # consume event - prevent menu open
        }
    }
);

## manual drag : update window position on each pointer-motion during drag.
## $drag_win_start_x/y set from get_origin() at button-press = true X11 root
## position, not the WM-frame-relative coords that configure-event gives.
$window->signal_connect(
    'motion-notify-event' => sub {
        return 0 unless $is_dragging;
        my ( $widget, $event ) = @ARG;
        my $new_x = $drag_win_start_x + ( $event->x_root - $drag_start_xr );
        my $new_y = $drag_win_start_y + ( $event->y_root - $drag_start_yr );
        ## two-call approach for cross-output boundary : first move anchors X
        ## at the last get_origin()-confirmed Y [ always valid ] so X still
        ## moves even when the second call's Y is rejected at the compositor
        ## per-output boundary
        $widget->move( $new_x, $win_y_cache );
        $widget->move( $new_x, $new_y );
        ## update X immediately; Y follows configure-event [ which now queries
        ## get_origin() for true root coords ]
        $win_x_cache = $new_x;
        $data{'protocol-7-menu'}{'window'}{'x'} = $new_x;
        return 1;
    }
);

# Button release handler - open menu if clicked in menu zone,
#                           - or save position if drag ended
$window->signal_connect(
    'button-release-event' => sub {
        my ( $widget, $event ) = @ARG;

        ## save position only if we were actually dragging
        if ($is_dragging) {
            $is_dragging = FALSE;

            my $cfg_val       = <protocol-7-menu.cfg> // {};
            my $save_offset_x = $cfg_val->{'position_save_offset_x'} //= 38;
            my $save_offset_y = $cfg_val->{'position_save_offset_y'} //= 58;

            ## drag-calculated final position : start was set from get_origin()
            ## [ true X11 root coords ] + root-coord delta from events = exact
            my $final_x
                = $drag_win_start_x + ( $event->x_root - $drag_start_xr );
            my $final_y
                = $drag_win_start_y + ( $event->y_root - $drag_start_yr );

            my $save_pos_x = $final_x + $save_offset_x;
            my $save_pos_y = $final_y + $save_offset_y;

            <[base.logs]>->(
                1, "SAVE: window position on button-release: x=%d y=%d",
                $save_pos_x, $save_pos_y
            );
            <[protocol-7-menu.position.save]>->(
                $save_pos_x, $save_pos_y, $screen_key
            );
            return 1;    # consume event
        }

        # Check if click was in menu zone (for non-drag clicks)
        my $click_x = $event->x;
        my $click_y = $event->y;
        my $dist    = sqrt( ( $click_x - $window_center_x )**2
                + ( $click_y - $window_center_y )**2 );

        if ( $dist < $menu_radius ) {

            # Menu zone - open menu
            my $menu = <protocol-7-menu.graphical-menu>;
            if ( defined $menu ) {
                <protocol-7-menu.menu_open> = TRUE;
                $menu->popup_at_widget( $widget, qw| east east | );
            }
            return 1;    # Consume event
        }

        return 0;        # Not menu zone
    }
);

# Load saved position or use default
<[base.log]>->( 1, "attempting to load saved position" );
my $saved_position = <[protocol-7-menu.position.load]>->($screen_key);
my ( $pos_x, $pos_y );

## margin used for the no-saved-position default and for post-map recovery ##
my $margin = 20;

if ( defined $saved_position ) {
    $pos_x = $saved_position->{'x'};
    $pos_y = $saved_position->{'y'};

    ## no manual clamp here : snap_to_monitor [ called below ] handles
    ## off-screen and void positions correctly, and negative coordinates
    ## are valid for secondary monitors positioned above or left of primary
    <[base.logs]>->( 1, "loaded saved position : x=%d y=%d", $pos_x, $pos_y );
} else {

    # Default: top-right with equal margin
    $pos_x = $scr_w - ( $win_width + $margin );
    $pos_y = $margin;
    <[base.logs]>->(
        1,
        "no saved position, using default: x=%d y=%d [screen_w=%d win_w=%d]",
        $pos_x,
        $pos_y,
        $scr_w,
        $win_width
    );
}

## Position BEFORE show_all
# [ must set position before window is mapped to window  manager ]
$window->set_gravity('north-west');

## sanitize against the real monitor rects : the default + restore clamps ##
## above only bound to the virtual screen, which has voids on offset multi- ##
## monitor layouts -- an off-all-outputs position cannot map and hangs the ##
## compositor [ the top-right-of-virtual default landed in such a void ]   ##
( $pos_x, $pos_y )
    = <[base.gtk.snap_to_monitor]>
    ->( $pos_x, $pos_y, $win_width, $win_height );

<[base.logs]>->(
    1,      "moving window to x=%d y=%d [before show_all]",
    $pos_x, $pos_y
);
$window->move( $pos_x, $pos_y );

## assign real initial values now that pos_x/pos_y are resolved
( $win_x_cache, $win_y_cache ) = ( $pos_x, $pos_y );

$data{'protocol-7-menu'}{'window'} = {
    'x' => $pos_x,
    'y' => $pos_y,
    'w' => $win_width,
    'h' => $win_height,
};

$window->signal_connect(
    'configure-event' => sub {
        my ( $widget, $event ) = @ARG;
        ## Weston XWM sends ConfigureNotify with WM-frame-relative coords,
        ## not root coords. use get_origin() [ XTranslateCoordinates ] for
        ## the true root position [ $event->x/y would give ~230 while the
        ## real root X11 position is ~4635 in a multi-monitor setup ].
        ## guard against the X11 "not yet mapped" sentinel (-32736) that
        ## XTranslateCoordinates returns during the initial-map configure-event
        ## before weston has committed the surface position.
        my $gdk_win = eval { $widget->get_window() };
        if ( defined $gdk_win ) {
            my ( $rx, $ry ) = eval { $gdk_win->get_origin() };
            if ( defined $rx and $rx >= -32736 and $ry >= -32736 ) {   ##[LLL]
                ( $win_x_cache, $win_y_cache ) = ( $rx, $ry );
                $data{'protocol-7-menu'}{'window'}{'x'} = $win_x_cache;
                $data{'protocol-7-menu'}{'window'}{'y'} = $win_y_cache;
            }
        }
        return 0;
    }
);

$window->show_all;

## when no saved position exists, the pre-show_all default is only a best   ##
## guess. weston can silently place the window in a void, so verify post-map ##
## with real move+readback and cycle through corner candidates until one     ##
## lands. fall back to a random unverified placement if nothing works.       ##
if ( not defined $saved_position ) {
    my $placement_attempts     = 0;
    my $max_placement_attempts = 10;
    my $placement_timer;
    $placement_timer = <[event.add_timer]>->(
        {   'after'    => 0.2,
            'interval' => 0.2,
            'cb'       => sub {
                return if not defined $placement_timer;

                $placement_attempts++;

                my $xid = eval {
                    $window->get_toplevel()->get_window()->get_xid();
                };
                if ( not defined $xid ) {
                    <[base.log]>->(
                        0,
                        'graphical menu startup: no xid yet, deferring '
                            . 'placement'
                    );
                    $placement_timer->cancel
                        if $placement_attempts >= $max_placement_attempts;
                    return;
                }

                my $monitors = <[base.gtk.list_monitors]> // [];
                if ( not @$monitors ) {
                    <[base.log]>->(
                        0, 'graphical menu startup: no monitors detected'
                    );
                    $placement_timer->cancel
                        if $placement_attempts >= $max_placement_attempts;
                    return;
                }

                my $current = <[base.X-11.get_window_geometry]>->($xid);
                my $preferred_index;
                if ( defined $current ) {
                    my $cx = $current->{'x'} + $current->{'width'} / 2;
                    my $cy = $current->{'y'} + $current->{'height'} / 2;
                    for my $i ( 0 .. $#$monitors ) {
                        my $m = $monitors->[$i];
                        if (    $cx >= $m->{'x'}
                            and $cx < $m->{'x'} + $m->{'width'}
                            and $cy >= $m->{'y'}
                            and $cy < $m->{'y'} + $m->{'height'} ) {
                            $preferred_index = $i;
                            last;
                        }
                    }
                }

                ## use actual mapped size for candidate generation ##
                my $use_width
                    = defined $current ? $current->{'width'} : $win_width;
                my $use_height
                    = defined $current ? $current->{'height'} : $win_height;

                my $candidates = <[window.place.build_corner_candidates]>->(
                    $monitors, $use_width, $use_height, $margin,
                    $preferred_index
                );

                my $safe = <[window.place.find_safe_position]>
                    ->( $xid, $candidates );

                if ( defined $safe ) {
                    <[base.logs]>->(
                        1,
                        'graphical menu startup: landed at x=%d y=%d on '
                            . 'monitor %d',
                        $safe->{'x'},
                        $safe->{'y'},
                        $safe->{'monitor_index'} // -1
                    );
                    <[base.X-11.raise-window]>->($xid);
                    <[base.X-11.keep_above]>->($xid);
                    $placement_timer->cancel;
                    return;
                }

                <[base.logs]>->(
                    0,
                    'graphical menu startup: placement attempt %d/%d failed',
                    $placement_attempts,
                    $max_placement_attempts
                );

                return if $placement_attempts < $max_placement_attempts;

                ## exhausted: one random unverified placement as last resort, ##
                ## still inset by margin so it never lands flush against the ##
                ## screen border.                                            ##
                my $random_mon
                    = $monitors->[ int( rand( scalar @$monitors ) ) ];
                my $rand_x = $random_mon->{'x'} + $margin;
                my $rand_y = $random_mon->{'y'} + $margin;
                my $rand_x_range
                    = $random_mon->{'width'} - $use_width - 2 * $margin;
                my $rand_y_range
                    = $random_mon->{'height'} - $use_height - 2 * $margin;
                $rand_x += int( rand($rand_x_range) ) if $rand_x_range > 0;
                $rand_y += int( rand($rand_y_range) ) if $rand_y_range > 0;

                <[base.X-11.move-window]>->(
                    $xid, $rand_x, $rand_y, $use_width, $use_height
                );
                <[base.logs]>->(
                    1,
                    'graphical menu startup: random fallback to x=%d y=%d '
                        . 'on monitor %s',
                    $rand_x,
                    $rand_y,
                    $random_mon->{'index'} // '?'
                );

                $placement_timer->cancel;
            }
        }
    );
}

# Create menu with menu-commands items
my $menu = Gtk3::Menu->new();

my $menu_commands = <menu-commands.mappings> // {};
foreach my $mapping_id ( sort keys %$menu_commands ) {
    my $mapping = $menu_commands->{$mapping_id};
    my $label   = $mapping->{label}   // $mapping_id;
    my $command = $mapping->{command} // '';

    my $item = Gtk3::MenuItem->new_with_label($label);
    $item->signal_connect(
        'activate' => sub {
            <[base.logs]>->( 1, "executing menu command : %s", $command );
            system($command) if $command;
        }
    );
    $menu->append($item);
}

$menu->show_all;

$menu->signal_connect(
    'deactivate' => sub {
        Glib::Timeout->add( 400,
            sub { <protocol-7-menu.menu_open> = FALSE; return FALSE } );
    }
);

## distance-aware opacity via windows pointer hook + shm
if ($use_transparency) {
    use YAML::XS qw| Load Dump |;

    my $opacity_min   = <protocol-7-menu.cfg.opacity.min>   //= 0.47;
    my $opacity_max   = <protocol-7-menu.cfg.opacity.max>   //= 0.63;
    my $opacity_click = <protocol-7-menu.cfg.opacity.click> //= 0.77;

    ## calibration : offset aligns windows virtual-screen coords to x11 coords
    ## [ negative pointer values reveal the offset : offset = -min_ptr ]
    ## max_dist scales the opacity curve to the observed reachable range
    ## both are keyed by screen_key and self-correct as the mouse explores
    my $ptr_offset_x = 0;
    my $ptr_offset_y = 0;
    my $max_dist     = $scr_w;    ## screen-width as sensible baseline ##
    my $calib_dirty  = 0;
    my $existing_ref = <[file.zenka_dir.load]>->('window/position.yaml');
    if ( defined $existing_ref ) {
        eval {
            my $c
                = ref($existing_ref) eq 'SCALAR'
                ? $$existing_ref
                : $existing_ref;
            my $p = Load($c);
            if ( ref($p) eq 'HASH' and ref( $p->{'calibration'} ) eq 'HASH' )
            {
                my $cal = $p->{'calibration'}{$screen_key} // {};
                $ptr_offset_x = $cal->{'offset_x'} // 0;
                $ptr_offset_y = $cal->{'offset_y'} // 0;
                $max_dist     = $cal->{'max_dist'} // $scr_w;
            }
        };
    }
    <[base.logs]>->(
        1, 'opacity : calibration offset x=%d y=%d max_dist=%.0f [%s]',
        $ptr_offset_x, $ptr_offset_y, $max_dist, $screen_key
        )
        if $ptr_offset_x
        or $ptr_offset_y
        or $max_dist;

    ## save calibration when dirty, debounced to every 30s
    <[event.add_timer]>->(
        {   'after'    => 30,
            'interval' => 30,
            'repeat'   => TRUE,
            'cb'       => sub {
                return unless $calib_dirty;
                $calib_dirty = 0;
                my $positions = {};
                my $ref = <[file.zenka_dir.load]>->('window/position.yaml');
                if ( defined $ref ) {
                    eval {
                        my $c = ref($ref) eq 'SCALAR' ? $$ref : $ref;
                        my $p = Load($c);
                        if ( ref($p) eq 'HASH' ) {
                            $positions = $p->{'positions'} // {};
                        }
                    };
                }
                my $yaml;
                eval {
                    $yaml = Dump(
                        {   'positions'   => $positions,
                            'calibration' => {
                                $screen_key => {
                                    'offset_x' => int($ptr_offset_x),
                                    'offset_y' => int($ptr_offset_y),
                                    'max_dist' => int($max_dist),
                                }
                            },
                            'metadata' =>
                                { 'saved_at' => <[base.time]>->(3) },
                        }
                    );
                };
                <[file.zenka_dir.write]>->(
                    'window/position.yaml', \$yaml, '>', 0600, ':utf8'
                ) if defined $yaml and length $yaml;
            }
        }
    );

    my $current_opacity = $opacity_max;
    my $set_opacity     = sub {
        my $o = int( shift() * 100 + 0.5 ) / 100;
        return if abs( $o - $current_opacity ) < 0.01;
        $current_opacity = $o;
        eval { $window->set_opacity($o) };
    };

    Glib::Timeout->add(
        50,
        sub {
            ## shm_ptr set by handler.pointer-stream-path once handshake done
            my $shm_ptr = $data{'protocol-7-menu'}{'pointer'}{'shm_ptr'};
            return TRUE unless defined $shm_ptr;
            if ( <protocol-7-menu.menu_open> && $menu->get_visible ) {
                $set_opacity->($opacity_click);
                return TRUE;
            }

            my ( $ptr_x, $ptr_y )
                = unpack( 'l<l<',
                substr( $$shm_ptr, AMOS7::SHM::SHM_HEADER_SIZE(), 8 ) );
            ## self-correcting offset : negative ptr coords are impossible
            ## in x11 space [ screen starts at 0 ] so they reveal the offset
            if ( $ptr_x < -$ptr_offset_x ) {
                $ptr_offset_x = -$ptr_x;
                $calib_dirty  = 1;
            }
            if ( $ptr_y < -$ptr_offset_y ) {
                $ptr_offset_y = -$ptr_y;
                $calib_dirty  = 1;
            }

            my $cx   = $win_x_cache + $win_width / 2;
            my $cy   = $win_y_cache + $win_height / 2;
            my $dist = sqrt( ( $ptr_x + $ptr_offset_x - $cx )**2
                    + ( $ptr_y + $ptr_offset_y - $cy )**2 );

            ## grow instantly on new max; gentle decay otherwise so calibration
            ## self-corrects when cursor consistently stays closer over time
            ## [ ~1.7% per minute at 50ms tick rate ]
            if ( $dist > $max_dist ) {
                $max_dist    = $dist;
                $calib_dirty = 1;
            } else {
                $max_dist *= 0.9999;
                $calib_dirty = 1;
            }
            my $scale = $max_dist > 1 ? $max_dist : 1;

            my $t      = $dist >= $scale ? 1 : $dist / $scale;
            my $curved = ( 1 - cos( $t * 3.14159 ) ) / 2;
            my $target
                = $opacity_max - $curved * ( $opacity_max - $opacity_min );
            $set_opacity->($target);
            return TRUE;
        }
    );

    ## trigger shm handshake after zenka is fully initialized
    push <system.callbacks.initialized>->@*,
        qw| protocol-7-menu.pointer-stream-init |;
}

# Store references
<protocol-7-menu.graphical-window>      = $window;
<protocol-7-menu.graphical-menu>        = $menu;
<protocol-7-menu.graphical-initialized> = TRUE;

<[base.log]>->( 1, "graphical menu initialized at startup" );

return 0;

