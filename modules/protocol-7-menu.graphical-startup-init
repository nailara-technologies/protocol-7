# name = protocol-7-menu.graphical-startup-init
# descr = Initialize graphical menu during zenka startup [not on-demand]

return 0 unless <protocol-7-menu.init-graphical>;

<[base.log]>->( 1, "initializing graphical menu at startup" );

# Create window
my $window       = Gtk3::Window->new('toplevel');
my $scale_factor = <protocol-7-menu.cfg.scale_factor> //= 0.043;

my $logo_path = <protocol-7-menu.image_path>
    //= File::Spec->catfile( <system.root_path>,
    qw| data/gfx/logos/nailara.png | );

die "image file '$logo_path' not found" if !-f $logo_path;

# Set window properties
$window->signal_connect( qw| delete_event | => sub { Gtk3->main_quit } );

$window->set_position('none');
$window->set_border_width(0);
$window->set_keep_above(1);    # Keep window on top
$window->set_decorated(0);
$window->stick;
$window->set_app_paintable(1);

my $screen           = $window->get_screen;
my $use_transparency = $window->is_composited ? 1 : 0;
$window->set_opacity(1) if $use_transparency;

if ($use_transparency) {
    my $rgba = $screen->get_rgba_visual();
    $window->set_visual($rgba);
}

# Apply CSS styling
my $css_prov = Gtk3::CssProvider->new();
$css_prov->load_from_data(<<'EOT');
menu { background-color:#000013; border-color:#000042; color:#0055CC;
                                                       font-size:x-large }
menu *:hover { background-color:#000042; color:#0088FF }
menu *:focus { background-color:#000042; color:#0088FF }
EOT
Gtk3::StyleContext::add_provider_for_screen( $screen, $css_prov, -1 );

# Load and scale image
my $pbuf  = Gtk3::Gdk::Pixbuf->new_from_file($logo_path);
my $img_w = $pbuf->get_width();
my $img_h = $pbuf->get_height();
my $scr_w = $screen->get_width();
my $scr_h = $screen->get_height();

my $win_width = sprintf( qw|%.0f|, $scr_w * $scale_factor );
my $win_height
    = sprintf( qw|%.0f|, $img_h * ( ( $scr_w / $img_w ) * $scale_factor ) );

my $image = Gtk3::Image->new_from_pixbuf(
    $pbuf->scale_simple( $win_width, $win_height, 'hyper' ) );

$window->add($image);

# Enable pointer events for drag-to-move
$image->set_events(
    [qw(button-press-mask button-release-mask pointer-motion-mask)] );
$window->set_events(
    [qw(button-press-mask button-release-mask pointer-motion-mask)] );

# Drag-to-move detection: circular zones based on distance from center
my $menu_radius = $win_width
    * 0.35;    # ~35% = menu zone [ bright mandala - clickable for menu ]

# Anything outside menu_radius is draggable
my $window_center_x = $win_width / 2;
my $window_center_y = $win_height / 2;

# Track if we initiated a drag this click
my $is_dragging = FALSE;

# Button press handler - detect drag or menu zone
$window->signal_connect(
    'button-press-event' => sub {
        my ( $widget, $event ) = @ARG;
        my $click_x = $event->x;
        my $click_y = $event->y;
        my $dist    = sqrt( ( $click_x - $window_center_x )**2
                + ( $click_y - $window_center_y )**2 );

        if ( $dist < $menu_radius ) {

            # MENU ZONE - bright mandala, allow menu to open on click
            return 0; # Don't consume - let button-release handle menu opening

        } else {

            # DRAG ZONE - use GTK3 native drag-to-move
            # This handles all coordinate system issues automatically
            $is_dragging = TRUE;
            $widget->begin_move_drag(
                $event->button, $event->x_root,
                $event->y_root, $event->time
            );
            return 1;    # Consume event - prevent menu open
        }
    }
);

# Button release handler - open menu if clicked in menu zone,
#                           - or save position if drag ended
$window->signal_connect(
    'button-release-event' => sub {
        my ( $widget, $event ) = @ARG;

        # Save position only if we were actually dragging
        if ($is_dragging) {
            $is_dragging = FALSE;

            my $cfg_val = <protocol-7-menu.cfg> // {};

       # Apply position save offset correction
       # NOTE: Root cause of offset unknown. When subtracting from image size:
       #   128 - 38 = 90, 128 - 58 = 70 (no clear correlation identified yet)
       # If offset occurs, adjust config values until root cause is determined
            my $save_offset_x = $cfg_val->{'position_save_offset_x'} //= 38;
            my $save_offset_y = $cfg_val->{'position_save_offset_y'} //= 58;

            my @pos = $widget->get_position();

            my $save_pos_x = $pos[0] + $save_offset_x;
            my $save_pos_y = $pos[1] + $save_offset_y;

            if ( @pos && defined $pos[0] && defined $pos[1] ) {
                <[base.logs]>->(
                    1, "SAVE: window position on button-release: x=%d y=%d",
                    $save_pos_x, $save_pos_y
                );
                <[protocol-7-menu.position.save]>->(
                    $save_pos_x, $save_pos_y
                );
            }
            return 1;    # Consume event
        }

        # Check if click was in menu zone (for non-drag clicks)
        my $click_x = $event->x;
        my $click_y = $event->y;
        my $dist    = sqrt( ( $click_x - $window_center_x )**2
                + ( $click_y - $window_center_y )**2 );

        if ( $dist < $menu_radius ) {

            # Menu zone - open menu
            my $menu = <protocol-7-menu.graphical-menu>;
            $menu->popup_at_widget( $widget, qw| east east | )
                if defined $menu;
            return 1;    # Consume event
        }

        return 0;        # Not menu zone
    }
);

# Load saved position or use default
<[base.log]>->( 1, "attempting to load saved position" );
my $saved_position = <[protocol-7-menu.position.load]>;
my ( $pos_x, $pos_y );

if ( defined $saved_position ) {
    $pos_x = $saved_position->{'x'};
    $pos_y = $saved_position->{'y'};
    <[base.logs]>->( 1, "loaded saved position : x=%d y=%d", $pos_x, $pos_y );
} else {

    # Default: top-right with equal margin
    my $margin = 20;
    $pos_x = $scr_w - ( $win_width + $margin );
    $pos_y = $margin;
    <[base.logs]>->(
        1,
        "no saved position, using default: x=%d y=%d [screen_w=%d win_w=%d]",
        $pos_x,
        $pos_y,
        $scr_w,
        $win_width
    );
}

## Position BEFORE show_all
# [ must set position before window is mapped to window  manager ]
$window->set_gravity('north-west');
<[base.log]>->(
    1,      "moving window to x=%d y=%d [before show_all]",
    $pos_x, $pos_y
);
$window->move( $pos_x, $pos_y );

$window->show_all;

# Create menu with menu-commands items
my $menu = Gtk3::Menu->new();

my $menu_commands = <menu-commands.mappings> // {};
foreach my $mapping_id ( sort keys %$menu_commands ) {
    my $mapping = $menu_commands->{$mapping_id};
    my $label   = $mapping->{label}   // $mapping_id;
    my $command = $mapping->{command} // '';

    my $item = Gtk3::MenuItem->new_with_label($label);
    $item->signal_connect(
        'activate' => sub {
            <[base.logs]>->( 1, "executing menu command : %s", $command );
            system($command) if $command;
        }
    );
    $menu->append($item);
}

$menu->show_all;

# Store references
<protocol-7-menu.graphical-window>      = $window;
<protocol-7-menu.graphical-menu>        = $menu;
<protocol-7-menu.graphical-initialized> = TRUE;

<[base.log]>->( 1, "graphical menu initialized at startup" );

return 0;

