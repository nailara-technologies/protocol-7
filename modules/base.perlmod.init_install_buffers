## [:< ##

# name  = base.perlmod.init_install_buffers
# descr = initialize tracking buffers for CPAN module installation operations

## Installation activity log buffer ##
<buffer.perlmod-install.max_size> //= 32 * 1024; # 32K buffer [install logs] #

my $zenka_init
    = defined $data{'buffer'}{'perlmod-install'}{'data'}
    ? qw| re-init |
    : qw| init |;

my $init_msg
    = sprintf '.:[ zenka %s | CPAN module installation tracker ]:.',
    $zenka_init;

## Reset buffer if it only has initialization message ##
if (    $zenka_init eq qw| re-init |
    and $data{'buffer'}{'perlmod-install'}{'data'}->@* == 3 ) {
    undef $data{'buffer'}{'perlmod-install'}{'data'}->@*;
    $data{'buffer'}{'perlmod-install'}{'size'} = 0;
}

## Populate buffer with initialization message ##
<[base.buffer.add_line]>->( qw| perlmod-install |, '' )
    if $zenka_init eq qw| init |;
<[base.buffer.add_line]>->( qw| perlmod-install |, $init_msg );
<[base.buffer.add_line]>->( qw| perlmod-install |, '' );

## Statistics tracking log buffer ##
## Note: perlmod-stats is a log buffer for tracking module installation statistics,
##       not a list. Use 'p7 <zenka>.show-buffer perlmod-stats' to view.
<buffer.perlmod-stats.max_size> //= 16 * 1024;  ## 16K buffer for stats log ##

my $stats_init_msg
    = sprintf '.:[ zenka %s | CPAN module statistics tracker ]:.',
    defined $data{'buffer'}{'perlmod-stats'}{'data'}
    ? qw| re-init |
    : qw| init |;

<[base.buffer.add_line]>->( qw| perlmod-stats |, '' )
    if $zenka_init eq qw| init |;
<[base.buffer.add_line]>->( qw| perlmod-stats |, $stats_init_msg, 0 );
<[base.buffer.add_line]>->( qw| perlmod-stats |, '' );

## Log buffer reference for installation activity log ##
## Note: perlmod-install is a log buffer for installation activity
##       - use 'p7 <zenka>.show-buffer perlmod-install' to view installation logs
<buffer.perlmod-install.type> //= qw| log |;

return FALSE;

