## [:< ##

# name = image-quality.vision.subprocess
# descr = Subprocess for GPU-accelerated vision analysis using llama-mtmd-cli (multimodal)

my ( $image_path, $model_identifier, $analysis_prompt ) = @_;

<[base.logs]>->(
    1, "[image-quality] vision.subprocess: model=%s",
    $model_identifier
);

# Validate inputs
unless ( defined $image_path ) {
    <[base.log]>->( 0, "[image-quality] Error: Image path required" );
    return { success => FALSE, error => 'Image path required' };
}
unless ( -f $image_path ) {
    <[base.logs]>->(
        0, "[image-quality] Error: Image file not found: %s", $image_path
    );
    return { success => FALSE, error => 'Image file not found' };
}
unless ( defined $model_identifier ) {
    <[base.log]>->( 0, "[image-quality] Error: Model identifier required" );
    return { success => FALSE, error => 'Model identifier required' };
}
unless ( defined $analysis_prompt ) {
    <[base.log]>->( 0, "[image-quality] Error: Analysis prompt required" );
    return { success => FALSE, error => 'Analysis prompt required' };
}

# Fetch model configuration from models zenka
<[base.perlmod.autoload]>->(qw| JSON::PP |);

my $response = <[base.protocol-7.command.send.local]>->(
    {   'command'   => "models.get_model_path",
        'call_args' => { 'model_id' => $model_identifier }
    }
);

return {
    success => FALSE,
    error   => "Failed to fetch model configuration: $model_identifier",
    method  => 'subprocess'
    }
    unless $response && ref($response) eq 'HASH' && $response->{data};

my $model_data;
eval { $model_data = JSON::PP::decode_json( $response->{data} ); };

return {
    success => FALSE,
    error   => "Failed to parse model configuration",
    method  => 'subprocess'
    }
    unless $model_data && ref($model_data) eq 'HASH';

my $model_file  = $model_data->{path};
my $mmproj_file = $model_data->{mmproj};

# Verify model files exist
return {
    success => FALSE,
    error   => "Model file not found: $model_file",
    method  => 'subprocess'
    }
    unless -f $model_file;
return {
    success => FALSE,
    error   => "Mmproj file not found: $mmproj_file",
    method  => 'subprocess'
    }
    unless -f $mmproj_file;

# Use llama-mtmd-cli (multimodal-enabled binary) for vision analysis
my $llama_mtmd_cli = '/data/source/ik_llama.cpp/llama-mtmd-cli-cuda';
return {
    success => FALSE,
    error   => "llama-mtmd-cli-cuda not found at $llama_mtmd_cli",
    method  => 'subprocess'
    }
    unless -x $llama_mtmd_cli;

# Escape paths for shell execution
my $escaped_model  = quotemeta($model_file);
my $escaped_mmproj = quotemeta($mmproj_file);
my $escaped_image  = quotemeta($image_path);
my $escaped_prompt = quotemeta($analysis_prompt);

# Build command: use llama-mtmd-cli with multimodal vision support (GPU-accelerated)
# Parameters:
# -m: model file path
# --mmproj: multimodal projection for vision encoding (CLIP)
# --image: input image file path
# -n 100: generate up to 100 tokens (sufficient for image analysis)
# -c 8192: context size (8K - sufficient for image embeddings + analysis prompt)
#          Image embeddings can consume 500-1000+ tokens depending on image size
# -e: process escape sequences in prompt
# Wrap in sh -c to ensure LD_LIBRARY_PATH is properly propagated
my $cmd = sprintf(
    'sh -c %s',
    quotemeta(
        sprintf(
            'export LD_LIBRARY_PATH=/data/source/ik_llama.cpp:$LD_LIBRARY_PATH && %s -m %s --mmproj %s --image %s -n 100 -c 8192 -e --prompt %s 2>&1',
            $llama_mtmd_cli, $escaped_model, $escaped_mmproj,
            $escaped_image,  $escaped_prompt
        )
    )
);

# Execute with timeout
my $out = '';
eval {
    local $SIG{ALRM} = sub { die "timeout\n" };
    alarm(90);    # 90 second timeout for image analysis
    $out = `$cmd`;
    alarm(0);
};

if ($@) {
    return {
        success => FALSE,
        error   => "Subprocess timeout or error: $@",
        method  => 'subprocess'
    };
}

if ( $? != 0 ) {
    return {
        success => FALSE,
        error   => "llama-mtmd-cli-cuda exited with error code $?",
        method  => 'subprocess'
    };
}

if ( !$out || length($out) == 0 ) {
    return {
        success => FALSE,
        error   => "No output from llama-mtmd-cli-cuda subprocess",
        method  => 'subprocess'
    };
}

return {
    success    => TRUE,
    response   => $out,
    method     => 'subprocess',
    model_used => $model_identifier
};

