## [:< ##

# name = image-quality.vision.subprocess
# descr = Subprocess fallback using IPC::Run for llama-server/llama-cli

my ($image_path, $model_path, $analysis_prompt) = @_;

# Validate inputs
return { success => FALSE, error => 'Image path required' } unless defined $image_path;
return { success => FALSE, error => 'Model path required' } unless defined $model_path;
return { success => FALSE, error => 'Analysis prompt required' } unless defined $analysis_prompt;

# Execute llama-server via backtick command (simplified approach)
# Build command string
my $cmd = sprintf(
    'llama-server -m %s --image %s -p %s -n 512 --temp 0.1 2>&1',
    quotemeta($model_path),
    quotemeta($image_path),
    quotemeta($analysis_prompt)
);

# Execute with timeout
my $out = '';
eval {
    local $SIG{ALRM} = sub { die "timeout\n" };
    alarm(60);
    $out = `$cmd`;
    alarm(0);
};

if ($@) {
    return { success => FALSE, error => "Subprocess failed: $@", method => 'subprocess' };
}

if ($? != 0) {
    return { success => FALSE, error => "llama-server exited with error code $?", method => 'subprocess' };
}

if (!$out || length($out) == 0) {
    return { success => FALSE, error => "No output from llama-server subprocess", method => 'subprocess' };
}

return {
    success => TRUE,
    response => $out,
    method => 'subprocess'
};

