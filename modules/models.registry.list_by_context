# name = models.registry.list_by_context
# descr = List models by context from registry

sub list_models_by_context {
  my ($context) = @_;
  my $base = <[models.registry.base]>;
  my $registry = $base->{get_registry}->();
  my @matching = grep {
    $_->{statistics}->{by_context}->{$context}
  } values %{$registry->{models}};
  return \@matching;
}

# Entry point
{
  my @args = @ARG;
  return list_models_by_context(@args);
};

