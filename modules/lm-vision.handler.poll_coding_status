## [:< ##

# name  = lm-vision.handler.poll_coding_status
# descr = send status query to coding zenka

my $clients_reached = <[protocol-7.command.send.local]>->(
    {   'command'   => 'cube.coding.inference-status',
        'call_args' => { 'args' => '' },
        'reply' => { 'handler' => 'lm-vision.handler.update_coding_status' }
    }
);

if ( $clients_reached == 1 ) {
    <[base.logs]>
        ->( 2, '[poll_coding_status] status request sent to coding' );
} else {
    <[base.logs]>->(
        1,
        '[poll_coding_status] failed to reach coding zenka (clients=%d), will retry',
        $clients_reached
    );
    ## schedule retry ##
    <lm-vision.poll_timer> = <[event.add_timer]>->(
        {   'after'   => 2.0,
            'handler' => 'lm-vision.handler.poll_coding_status',
            'desc'    => 'retry poll after send failure'
        }
    );
}

return;

