# name  = base.handler.strm_size_absolute_timeout
# descr = strm-size absolute timeout (total duration limit, never reset)

my $event  = shift;
my $data_h = $event->w->data;
my $id     = $data_h->{'sid'};
my $cmd_id = $data_h->{'cmd_id'};

return
        unless defined $id
    and exists $data{'session'}{$id}
    and defined $cmd_id;

my $session = $data{'session'}{$id};
my $stream  = $session->{'streams'}{$cmd_id};

return unless defined $stream;

## absolute timeout fired: stream took too long total ##
my $timeout    = $session->{'strm_size_timeout'} // 12;
my $total_time = <[base.time]>->(3) - $stream->{'started_at'};
my $received   = $stream->{'received_bytes'} // 0;
my $total      = $stream->{'total_bytes'}    // 0;

<[base.logs]>->(
    0,
    "[%d] STRM-SIZE stream %d absolute timeout: %.1fs > %ds "
        . "[ %d/%d bytes ]",
    $id,
    $cmd_id,
    $total_time,
    $timeout,
    $received,
    $total
);

## cancel idle timer if still active ##
if ( defined $stream->{'timer'}{'idle_timeout'}
    and not $stream->{'timer'}{'idle_timeout'}->is_cancelled ) {
    $stream->{'timer'}{'idle_timeout'}->cancel;
}

## inject close-timeout into input buffer ##
$session->{'buffer'}{'input'} .= sprintf "(%d)STRM-SIZE close-timeout\n",
    $cmd_id;

## trigger input processing ##
if ( exists $session->{'watcher'}{'input_buffer'} ) {
    $session->{'watcher'}{'input_buffer'}->again;
}

return TRUE;

