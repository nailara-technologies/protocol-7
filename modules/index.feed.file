## [:< ##

# name = index.feed.file
# descr = ingest a single file into the index

my $path = @ARG ? shift : $ARG;

if ( not defined $path or not -r $path ) {
    <[base.log]>->(
        1, "index.feed.file: not readable [ " . ( $path // 'undef' ) . " ]"
    );
    return FALSE;
}

my $content = <[file.slurp]>->($path);

if ( not defined $content ) {
    <[base.log]>->( 1, "index.feed.file: slurp failed [ $path ]" );
    return FALSE;
}

my $chk = <[base.chk-sum.amos]>->($content);
return TRUE if exists <index.contributions>->{$chk};

my %freq_before = %{ <index.freq> // {} };

<[index.ingest]>->($content);

my %freq_delta;
for my $k ( keys %{<index.freq>} ) {
    my $delta = <index.freq>->{$k} - ( $freq_before{$k} // 0 );
    $freq_delta{$k} = $delta if $delta;
}

my %level_delta;
<[index.deduplicate]>->( $content, \%level_delta );

<index.contributions>->{$chk} = {
    'freq'  => \%freq_delta,
    'level' => \%level_delta,
};

<[index.rebalance]>;

<[base.log]>->( 2, "index fed [ $path ]" );

return TRUE;

