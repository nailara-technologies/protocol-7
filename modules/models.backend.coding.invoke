## [:< ##

# name = models.backend.coding.invoke
# descr = route local inference through coding zenka's async infrastructure
# param = $params - standard backend params
# return = response via coding zenka's task system

my $params = shift;

my $model_id       = $params->{'model_id'}       // '';
my $messages       = $params->{'messages'}       // [];
my $participant_id = $params->{'participant_id'} // '';

return {
    'success' => FALSE,
    'error'   => 'model_id required'
    }
    unless length($model_id);

return {
    'success' => FALSE,
    'error'   => 'messages must be non-empty array'
    }
    unless ref($messages) eq 'ARRAY' && scalar(@$messages) > 0;

## extract message content from messages array
my $message_content = '';
for my $msg (@$messages) {
    next unless ref($msg) eq 'HASH';
    my $role    = $msg->{'role'}    // '';
    my $content = $msg->{'content'} // '';
    $message_content .= "$role: $content\n" if length($content);
}

## build simple inference request for coding zenka
my $request = sprintf 'Simple inference: model=%s\n\nMessage: %s',
    $model_id, $message_content;

## send command to coding zenka via IPC
my $cmd_count = <[base.protocol-7.command.send.local]>->(
    {   'command'   => 'coding.cmd.submit',
        'call_args' => { 'args' => $request },
        'reply'     => {
            'handler' => 'models.handler.coding_inference_reply',
            'params'  => {
                'model_id'       => $model_id,
                'participant_id' => $participant_id
            }
        }
    }
);

## check if command was sent
if ( $cmd_count && $cmd_count > 0 ) {
    <[base.logs]>->(
        2, 'inference request sent to coding zenka: model=%s', $model_id
    );

    return {
        'success' => TRUE,
        'pending' => TRUE,
        'message' => 'inference request queued via coding zenka',
        'note'    => 'response will arrive via async callback',
    };
} else {
    return {
        'success'   => FALSE,
        'error'     => 'failed to send command to coding zenka',
        'cmd_count' => $cmd_count // 0,
    };
}

0;

