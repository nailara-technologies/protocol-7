## [:< ##

# name       = base.file.pre_init
# descr      = moves base.file.* routines to file.* namespace

if ( exists $code{'base.file.init_code'} ) {
    <[base.swap_subs]>->( 'base.file', 'file' );
}

<[base.perlmod.load]>->( 'File::Which', qw| which where | );

return 0;

