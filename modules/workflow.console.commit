## [:< ##

# name  = workflow.console.commit
# param = <message>
# descr = LLM-friendly commit with auto-signing

my $message = shift;

unless ($message) {
    <[base.log]>->( 0, "Error: commit message required" );
    return say "::\n: Usage: workflow commit <message>\n::";
}

say '';
say ' .:[ WORKFLOW: AUTO-SIGN-COMMIT ]:.';
say '';

## Load crypto keys (production or LLM development)
my $sig_key_name = qw| proto-7.sourcecode |;
my $test_key_name = qw| LLM-dev.sourcecode |;

# Attempt to load user's base key if not already loaded
my $base_key_name = <[crypt.C25519.key_vars]>->()->{'key_name'};
if ($base_key_name && !exists $keys{'C25519'}{$base_key_name}) {
    if (<[crypt.C25519.key_exists]>->($base_key_name)) {
        <[crypt.C25519.load_keypair]>->($base_key_name);
    }
}

# Attempt to load production key if it exists
if (!exists $keys{'C25519'}{$sig_key_name} && <[crypt.C25519.key_exists]>->($sig_key_name)) {
    <[crypt.C25519.load_keypair]>->($sig_key_name);
}

## Detect signing mode based on key presence
my $use_production_key = 0;
my $use_test_key = 0;
my $key_mode = 'unknown';

# Check if production key is loaded
if ( exists $keys{'C25519'}{$sig_key_name} && defined $keys{'C25519'}{$sig_key_name} ) {
    $use_production_key = 1;
    $key_mode = 'production';
    say ' : ✓ Production key detected';
    say sprintf ' : Using key: %s', $sig_key_name;
    say '';
} else {
    # Production key not available - use test key mode
    $use_test_key = 1;
    $key_mode = 'test';
    say ' : Production key not loaded - using LLM development key mode';

    # Check if LLM dev key exists on disk
    if ( <[crypt.C25519.key_exists]>->($test_key_name) ) {
        # Load existing LLM dev key from disk
        say sprintf ' : Loading existing LLM dev key: %s', $test_key_name;
        <[crypt.C25519.load_keypair]>->($test_key_name);

        unless ( exists $keys{'C25519'}{$test_key_name} && defined $keys{'C25519'}{$test_key_name} ) {
            say ' : ⚠ WARNING: Failed to load LLM dev key from disk';
            say ' : Committing without signature updates';
            goto SKIP_SIGNATURES;
        }

        say ' : ✓ LLM dev key loaded from disk';

        # Export public key to workspace-transfer repo (always, for each session)
        my $root_path = $data{'system'}{'root_path'};
        my $workspace_repo = "$root_path/../workspace-transfer";
        if ( -d $workspace_repo ) {
            my $pub_key_export = "$workspace_repo/LLM-dev.sourcecode.pub";
            my $key_vars = <[crypt.C25519.key_vars]>->($test_key_name);
            my $pub_key_file = $key_vars->{'key_filename'}->{'public'};

            if ( -f $pub_key_file && ! -f $pub_key_export ) {
                system('cp', $pub_key_file, $pub_key_export);
                if ( $? == 0 && -f $pub_key_export ) {
                    say sprintf ' : ✓ Public key exported: %s', $pub_key_export;
                }
            }
        }
    } else {
        # Generate new LLM dev key and save to disk
        say ' : Creating persistent LLM development key...';

        # Ensure key vars are initialized with test key name
        <[crypt.C25519.key_vars]>->($test_key_name);

        # Ensure key directory exists
        my $key_dir = <[crypt.C25519.chk_key_dir]>;
        unless ( $key_dir ) {
            say ' : ⚠ WARNING: Could not create/access key directory';
            say ' : Committing without signature updates';
            goto SKIP_SIGNATURES;
        }

        my ($new_key, $created_name) = <[crypt.C25519.gen_keys]>->( $test_key_name );

        unless ( defined $new_key ) {
            say ' : ⚠ WARNING: Failed to generate LLM dev key';
            say ' : Committing without signature updates';
            goto SKIP_SIGNATURES;
        }

        # Save LLM dev key unencrypted to disk
        say ' : Saving LLM dev key to disk (unencrypted)...';
        my ($write_status, @checksums) = <[crypt.C25519.write_keys]>->( $test_key_name, undef, FALSE );

        unless ( $write_status ) {
            say ' : ⚠ WARNING: Failed to save LLM dev key to disk';
            say ' : Continuing with in-memory key (not persistent across sessions)';
        } else {
            say sprintf ' : ✓ LLM dev key saved: %s', join(':', @checksums);

            # Export public key to workspace-transfer repo
            my $root_path = $data{'system'}{'root_path'};
            my $workspace_repo = "$root_path/../workspace-transfer";
            if ( -d $workspace_repo ) {
                my $pub_key_export = "$workspace_repo/LLM-dev.sourcecode.pub";
                my $key_vars = <[crypt.C25519.key_vars]>->($test_key_name);
                my $pub_key_file = $key_vars->{'key_filename'}->{'public'};

                if ( -f $pub_key_file ) {
                    say ' : Exporting public key to workspace-transfer...';
                    system('cp', $pub_key_file, $pub_key_export);
                    if ( $? == 0 && -f $pub_key_export ) {
                        say sprintf ' : ✓ Public key exported: %s', $pub_key_export;
                    }
                }
            }
        }

        say sprintf ' : ✓ Created LLM dev key: %s', $test_key_name;
    }
    say '';
}

## Update signatures with appropriate key
say ' .:[ UPDATING SIGNATURES ]:.';
say '';

if ( $use_test_key ) {
    # Get list of currently modified/new files (unstaged and staged)
    my $git_status = `git diff --name-only; git diff --cached --name-only; git ls-files --others --exclude-standard`;
    my @modified_files = split /\n/, $git_status // '';
    @modified_files = grep { length $_ && -f $_ } @modified_files;

    # Remove duplicates
    my %seen;
    @modified_files = grep { !$seen{$_}++ } @modified_files;

    # Filter to only Protocol-7 source files (modules/* bin/* etc)
    @modified_files = grep { m/^(modules|bin|configuration)\/.*[^~]$/ } @modified_files;

    if ( @modified_files ) {
        # Load and initialize sourcecode module if not already loaded
        unless ( exists $code{'source.cmd.get-code-signed'} ) {
            <[base.load_modules]>->(qw| source amos7 sourcecode |);
            <[base.init_modules]>->(qw| source amos7 sourcecode |);
            <[sourcecode.init_code]> if exists $code{'sourcecode.init_code'};
        }

        # Load production key to check for valid signatures (if it exists)
        my $prod_key_loaded = 0;
        if ( <[crypt.C25519.key_exists]>->($sig_key_name) ) {
            <[crypt.C25519.load_keypair]>->($sig_key_name);
            $prod_key_loaded = 1 if exists $keys{'C25519'}{$sig_key_name};
        }

        # Filter out files that have valid signatures (production or LLM dev)
        my @files_to_sign;
        foreach my $file_path ( @modified_files ) {
            next unless -f $file_path;

            my $needs_signing = 1;

            # Check production key signature if available
            if ( $prod_key_loaded ) {
                my $valid_with_prod = <[source.signature_valid]>->($file_path, $sig_key_name);
                if ( $valid_with_prod ) {
                    $needs_signing = 0;
                }
            }

            # If no valid production signature, check LLM dev key signature
            if ( $needs_signing ) {
                my $valid_with_llm = <[source.signature_valid]>->($file_path, $test_key_name);
                if ( $valid_with_llm ) {
                    $needs_signing = 0;
                }
            }

            push @files_to_sign, $file_path if $needs_signing;
        }

        if ( @files_to_sign ) {
            say sprintf ' : Signing %d file(s) without valid signatures...', scalar(@files_to_sign);

            # Swap LLM dev key into production slot for signing
            my $original_key = $keys{'C25519'}{$sig_key_name};
            $keys{'C25519'}{$sig_key_name} = $keys{'C25519'}{$test_key_name};

            # Sign each file that needs signing
            my $signed_count = 0;
            foreach my $file_path ( @files_to_sign ) {
                <[event.once]>->(0.0007);  # Ctrl+C support

                my $result = <[source.cmd.get-code-signed]>->($file_path);
                if ( $result ) {
                    $signed_count++;
                }
            }

            # Restore original key
            $keys{'C25519'}{$sig_key_name} = $original_key if defined $original_key;

            say sprintf ' : ✓ Signed %d file(s)', $signed_count;
        } else {
            say ' : All modified files already have valid signatures';
        }
    } else {
        say ' : No modified source files to sign';
    }
} else {
    # Use production key via subprocess
    system('./bin/Protocol-7', 'sourcecode', 'update-signatures', ':sign-silent:');
    my $sign_exit = $? >> 8;

    if ( $sign_exit != 0 ) {
        say sprintf ' : ⚠ WARNING: Signature update failed (exit: %d)', $sign_exit;
        say ' : Continuing without signature updates';
        say '';
        $key_mode = 'none';
    }
}

unless ($key_mode eq 'none') {
    say ' : ✓ Signatures updated';
    say '';
}

SKIP_SIGNATURES:

## Stage all changes
say ' .:[ STAGING CHANGES ]:.';
say '';

system('git', 'add', '-A');
my $add_exit = $? >> 8;

if ( $add_exit != 0 ) {
    say ' : ✗ Failed to stage changes';
    say '';
    return 1;
}

# Show what will be committed
system('git', 'status', '--short');

say '';
say ' : ✓ Changes staged';
say '';

## Commit with message
say ' .:[ COMMITTING ]:.';
say '';

# Add key mode context to commit message if using test key
my $commit_message = $message;
$commit_message .= "\n\nSigned-by: $key_mode-key" if $use_test_key;

my $commit_cmd = sprintf(
    'git commit --no-gpg-sign -m "%s"',
    $commit_message =~ s/"/\\"/gr
);

system($commit_cmd);
my $commit_exit = $? >> 8;

if ( $commit_exit != 0 ) {
    say ' : ✗ Commit failed';
    say '';
    return 1;
}

say '';
say ' : ✓ Changes committed';
say '';

## Summary
say ' .:[ COMPLETE ]:.';
say '';
say sprintf ' : Key mode: %s', $key_mode;
say sprintf ' : Commit message: %s', $message;
say '';

return 0;

