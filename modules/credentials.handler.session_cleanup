# name  = credentials.handler.session_cleanup
# descr = periodic timer to purge expired session tokens

my $now   = time;
my $count = 0;

foreach my $token_id ( keys <credentials.session>->%* ) {
    my $session = <credentials.session>->{$token_id};
    next unless defined $session;
    if ( $session->{'expires'} < $now ) {
        delete <credentials.session>->{$token_id};
        $count++;
    }
}

<[base.logs]>->( 2, 'credentials: purged %d expired session tokens', $count )
    if $count > 0;

return 0;

