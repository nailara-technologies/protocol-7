## [:< ##

# name  = lm-vision.init_code
# descr = GPU-accelerated vision analysis with job dispatch architecture

<[base.log]>->( 1, 'lm-vision zenka starting.,' );

## load generic modules ##
<[base.perlmod.autoload]>->('IPC::Open3');
<[base.perlmod.load]>->( 'Symbol',      qw| gensym        | );
<[base.perlmod.autoload]>->('LWP::UserAgent');
<[base.perlmod.load]>->( 'HTTP::Request' );
<[base.perlmod.load]>->( 'MIME::Base64', qw| encode_base64 | );

## load Imager module for image scaling ##
<[base.perlmod.autoload]>->('Imager');

# Vision model binary and library configuration
<lm-vision.binary>   = qw{/data/source/ik_llama.cpp/llama-mtmd-cli-cuda-fa};
<lm-vision.lib_path> = qw| /data/source/ik_llama.cpp |;
<lm-vision.log_file> = qw| /var/log/protocol-7/lm-vision.log |;
<lm-vision.log_dir>  = qw| /var/log/protocol-7 |;
<lm-vision.log_mask> = 0750;

# Ensure log directory exists with proper permissions
# (only if running as root)
if ( $EUID == 0 ) {
    <[base.perlmod.load]>->( 'File::Path', qw| make_path | );
    <[file.make_path]>->(
        <lm-vision.log_dir>, <lm-vision.log_mask>, <system.amos-zenka-user>
        )
        and <[base.logs]>->(
        1, "created log directory [%s/]",
        <lm-vision.log_dir>
        ) if !-d <lm-vision.log_dir>;
}

# Load vision model configuration from centralized models.yaml
<[base.logs]>->( 1, "loading vision model config from models.yaml" );

<[base.perlmod.autoload]>->(qw| YAML::Tiny |);

my $config_file = catfile( <system.conf_path>, qw|zenki/models/models.yaml| );

my $model_path  = undef;
my $mmproj_path = undef;

if ( -f $config_file ) {
    my $yaml_content_sref = <[file.slurp]>->($config_file);

    if ( ref $yaml_content_sref eq qw| SCALAR | ) {
        my $yaml = YAML::Tiny::Load( $yaml_content_sref->$* );

        if (   $yaml
            && exists $yaml->{'models'}
            && exists $yaml->{'models'}->{'qwen3-vl-4b-instruct'} ) {
            my $model_def = $yaml->{'models'}->{'qwen3-vl-4b-instruct'};
            $model_path  = $model_def->{'path'};
            $mmproj_path = $model_def->{'mmproj'};
        } else {
            <[base.log]>->(
                0, " Error: qwen3-vl-4b-instruct not found in models.yaml"
            );
        }
    }
} else {
    <[base.log]>->( 0, " Error : models.yaml not found at $config_file" );
}

if ( $model_path && $mmproj_path ) {

    # Trust YAML-defined model paths from models registry
    <lm-vision.vision_model_path>  = $model_path;
    <lm-vision.vision_mmproj_path> = $mmproj_path;

    <[base.logs]>->(
        1,
        "vision model configured : %s",
        <[base.parser.ellipse_center]>->( $model_path, 28 )
    );
} else {
    <lm-vision.vision_model_path>  = undef;
    <lm-vision.vision_mmproj_path> = undef;

    <[base.log]>->(
        0,
        "[error] vision model configuration"
            . " incomplete [check:models.yaml]"
    );
}

<[base.logs]>->(
    1,
    "vision binary : %s",
    <[base.parser.ellipse_center]>->( <lm-vision.binary>, 28 )
);
<[base.logs]>->( 1, "will fetch config on-demand from models zenka" );

# Initialize job queue for vision analysis tasks
<lm-vision.jobs> //= {};

# Initialize timers hash for process watchers
<lm-vision.timers> //= {};

# Initialize batch queue for request batching [amortizes model loading]
<lm-vision.batch_queue> //= [];
<lm-vision.batch_timer> = undef;
<lm-vision.batch_window_ms>
    = 100;    # Collect requests for 100ms before processing

<[base.logs]>->( 1, "vision job dispatch system initialized.," );
<[base.logs]>->(
    1, "batch processing enabled [window: %dms]",
    <lm-vision.batch_window_ms>
);

# Image scaling configuration [vision models typically expect 224-1024 range]
<lm-vision.max_image_width>  = 1024;    # Scale down if wider
<lm-vision.max_image_height> = 1024;    # Scale down if taller

# Temp files are managed by base.file.temp
# with automatic cleanup via end_code callbacks

0;    # Return success for module initialization

