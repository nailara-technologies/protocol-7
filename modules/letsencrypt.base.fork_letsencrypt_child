## [:< ##

# name  = letsencrypt.base.fork_letsencrypt_child
# descr = Fork child process for ACME operations (non-blocking cert provisioning and renewal)

use Socket;

( my $session_id ) = keys <user.cube.session>->%*;

<letsencrypt.pipe> = { 'child' => {}, 'parent' => {} };

<[base.log]>->( 1, 'forking letsencrypt child.,' );

<[base.enable_list]>->('sessions');

socketpair( my $child_pipe, my $parent_pipe, AF_UNIX, SOCK_STREAM, PF_UNSPEC )
    || die "can't create socketpair. [ \l$OS_ERROR ]";
map { $data{'handle'}{$ARG}{'link'} = qw| ipc.pipe | }
    ( $child_pipe, $parent_pipe );

<[event.add_signal]>->(
    { 'signal' => 'CHLD', 'handler' => qw| base.handler.sig_chld.shutdown | }
);

<letsencrypt.child.pid> = <[base.fork]>;

if ( !<letsencrypt.child.pid> ) {    ## child ##

    <[event.add_signal]>->( { 'signal' => 'CHLD', 'handler' => 'dev.null' } );
    close($child_pipe);
    delete <letsencrypt.pipe.child> if exists <letsencrypt.pipe.child>;

    ## making base.s_read() and base.s_write() work after fork ., ##
    IO::AIO::reinit();

    <letsencrypt.pipe.parent> = $parent_pipe;
    <log.file.system.retry_timer>->cancel
        if exists <log.file.system.retry_timer>;

    my $subname = <system.zenka.subname>;
    my $sn_str  = defined $subname ? ':' . $subname : '';
    <system.zenka.subname> = sprintf 'child%s', $sn_str;
    $PROGRAM_NAME = sprintf '%s[child%s]', <system.zenka.name>, $sn_str;

    $data{'session'}{$session_id}{'shutdown'} = 1;

    $data{'handle'}{$parent_pipe}{'mode'} = qw| out |;
    my $id = <[base.session.init]>->(
        $parent_pipe, qw| protocol-7 client parent |
    );

    $data{'session'}{$id}{'input'}{'handler'} = qw| base.handler.command |;

    <[base.load_modules]>->('letsencrypt.child');
    <[base.init_modules]>->('letsencrypt.child');

    <[base.log]>->( 1, 'child process ready - listening on IPC pipe' );

    ## Child process serves commands from parent via IPC pipe
    ## The event loop (base.event.*) is inherited from initialization
    ## Child enters the event loop to handle incoming commands
    <[event.loop]>;

} else {    ## parent ##
    close($parent_pipe);
    delete <letsencrypt.pipe.parent> if exists <letsencrypt.pipe.parent>;
    <letsencrypt.pipe.child> = $child_pipe;

    <[base.load_modules]>->('letsencrypt.parent');
    <[base.init_modules]>->('letsencrypt.parent');

    $data{'handle'}{$child_pipe}{'mode'} = qw| out |;
    my $id
        = <[base.session.init]>
        ->( $child_pipe, qw| protocol-7 client child | );
    $data{'session'}{$id}{'input'}{'handler'} = qw| base.handler.command |;

    my $cache_dir  = <letsencrypt.cache.dir>;
    my $cert_cache = sprintf '%s/cert.cache', $cache_dir;
    if ( -f $cert_cache ) {
        <[base.log]>->( 1, "found saved certificate cache.," );

        ##  contains serialized cert metadata  ##
        <[file.slurp]>->( $cert_cache, \my $cache_str, qw| :raw | );

        # Load cached certificate data (deferred to parent init)
        <letsencrypt.cache.loaded> = 1;
    }

    <[base.log]>->( 1, 'letsencrypt parent initialized' );
}

