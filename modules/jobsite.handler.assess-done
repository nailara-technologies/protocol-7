## [:< ##

# name  = jobsite.handler.assess-done
# descr = receive assessment result, validate, update job state or dispatch repair

my $call = shift // {};

my $mode    = $call->{'mode'} // '';
my $raw     = $call->{'data'} // '';
my $result  = ref $raw ? $raw->$* : $raw;
my $job_id  = <[base.vax-int.decode]>->( $call->{'params'}{'job_id'} // '' );
my $task_id = $call->{'params'}{'task_id'} // '';

<[base.logs]>->(
    1, ':assess-done: job=%s mode=%s result_len=%d ..',
    $job_id, $mode, length($result)
);
<[base.logs]>->(
    1, ":. [ %s ]", <[base.parser.ellipse_center]>->( $result, 63 )
);

my $job_rec = <jobsite.tasks>->{$job_id};
if ( not defined $job_rec ) {
    <[base.logs]>->( 0, ':assess-done: unknown job %s', $job_id );
    <jobsite.pending_count>--;
    if ( <jobsite.pending_count> <= 0 ) {
        <jobsite.pending_count> = 0;
        <jobsite.cycle>         = 'idle';
        <[base.logs]>->( 1, 'all assessments complete, cycle=idle' );
        if (<jobsite.sync.push_in_progress>) {
            ## current push already collected its job list; schedule follow-up ##
            <jobsite.sync.push_after_assess> = TRUE;
            <[base.logs]>->(
                1, 'assess-done: sync push in progress, scheduling follow-up'
            );
        } else {
            <[jobsite.sync.push]>->( undef, FALSE )
                ;    ## push results to web immediately ##
        }
    }
    <[jobsite.dispatch.next]>;
    return;
}

if ( lc($mode) eq qw| false | ) {
    <[base.logs]>->(
        0,        'assess-done: task %s failed for job %s',
        $task_id, $job_id
    );
    $job_rec->{'stage'} = 'failed';
    my $job_f = <[jobsite.job.read]>->($job_id) // {};
    $job_f->{'status'} = 'assessed';
    $job_f->{'stage'}  = 'failed';
    <[jobsite.job.write]>->( $job_id, $job_f );
    <jobsite.pending_count>--;
    <[jobsite.state.persist]>;
    <[jobsite.dispatch.next]>;
    return;
}

## protected stages : user decisions must survive pipeline activity ##
my %protected_stage
    = map { $ARG => 1 }
    qw| applied interviewed responded rejected skipped archived |;

my %stage_to_status = (
    'review'      => 'review',
    'to_apply'    => 'apply',
    'applied'     => 'applied',
    'interviewed' => 'interviewed',
    'responded'   => 'applied',
    'rejected'    => 'rejected',
    'skipped'     => 'skipped',
    'archived'    => 'rejected',
);

## parse yaml result : fall back to json regex for backward compat ##
my ( $score, $reason, $summary, $apply, $parsed ) = ( '', '', '', '', undef );
my $yaml_src = $result;
## ensure utf8 flag set for regex ops, then encode to bytes for YAML::XS ##
utf8::decode($yaml_src)
    if not utf8::is_utf8($yaml_src)
    and utf8::valid($yaml_src);
## slice from the score: line onward : match score:\d anywhere, not just line-start ##
my $has_yaml = $yaml_src =~ m{score\s*:\s*\d};
$yaml_src = substr( $yaml_src, $-[0] ) if $has_yaml;
## strip trailing markdown code fence if model wrapped output ##
$yaml_src =~ s{\n*```\s*$}{}s;
## strip yaml-forbidden control chars : C0 (except tab/LF/CR), DEL, C1 ##
$yaml_src =~ s/[^\x09\x0A\x0D\x20-\x7E\xA0-\x{FFFD}]//g;
## YAML::XS::Load needs utf-8 bytes without the perl utf8 flag ##
my $yaml_bytes = $yaml_src;
utf8::encode($yaml_bytes) if utf8::is_utf8($yaml_bytes);
my $yaml_err;
$parsed = eval { YAML::XS::Load($yaml_bytes) }
    if $has_yaml and length $yaml_src;
$yaml_err = $@;

if ($yaml_err) {
    <[base.logs]>->(
        0,         ':assess-done: YAML parse error: %s | src=[%s]',
        $yaml_err, substr( $yaml_src, 0, 80 ) =~ s/\n/\\n/gr
    );
}
if ( ref $parsed eq 'HASH' ) {
    $score   = $parsed->{'score'}   // '';
    $reason  = $parsed->{'reason'}  // '';
    $summary = $parsed->{'summary'} // '';
    $apply   = $parsed->{'apply'}   // '';
    $apply   = $apply ? 'true' : 'false' if ref \$apply eq 'SCALAR';
} elsif ( $result =~ m{\{.*?"(?:fit_)?score"\s*:\s*(\d+(?:\.\d+)?)}s ) {
    ## legacy json fallback ##
    $score = $1;
    ($reason) = ( $result =~ m{"reason(?:s)?"\s*:\s*"([^"]+)"} );
    ($reason) //= do {
        my ($arr) = ( $result =~ m{"reasons"\s*:\s*\[([^\]]+)\]} );
        $arr
            ? ( split /,/, $arr )[0] =~ s/^\s*"?|"?\s*$//gr
            : undef;
    };
    ($summary) = ( $result =~ m{"summary"\s*:\s*"([^"]+)"} );
    ($apply)
        = ( $result
            =~ m{"(?:apply|recommendation)"\s*:\s*"?(true|false|interview|apply)"?}
        );
} elsif ( $result =~ m{(?:fit_)?score[:\s]+(\d+(?:\.\d+)?)}i ) {
    $score = $1;
}

## validate assessment quality ##
my $validation
    = <[jobsite.validate.assessment]>->( $result, $reason, $summary );

if (    not $validation->{'is_valid'}
    and not $job_rec->{'repair_attempted'} ) {
    ## first defect : dispatch repair, do NOT decrement pending_count ##
    $job_rec->{'repair_attempted'} = TRUE;
    <[base.logs]>->(
        1,       'job %s defects [%s] : dispatching repair',
        $job_id, join( ', ', $validation->{'defects'}->@* )
    );
    <[jobsite.state.persist]>;
    <[jobsite.dispatch.repair]>->( $job_id, $validation->{'defects'} );
    return;
}

if ( not $validation->{'is_valid'} and $job_rec->{'repair_attempted'} ) {
    ## repair already tried and failed : store original, mark, move on ##
    <[base.logs]>->(
        1,       'job %s still invalid after repair (%s), keeping original',
        $job_id, join( ', ', $validation->{'defects'}->@* )
    );
    $job_rec->{'repair_failed'} = TRUE;
}

## parse assertions : from yaml parse or legacy json regex ##
my $assertions = $job_rec->{'assertions'} // {};
if ( ref $parsed eq 'HASH' && ref $parsed->{'assertions'} eq 'HASH' ) {
    my $pa = $parsed->{'assertions'};
    if ( ref $pa->{'suggest'} eq 'HASH' ) {
        for my $k (qw| apply delete archive |) {
            $assertions->{'suggest'}{$k}
                = $pa->{'suggest'}{$k} ? 'true' : 'false'
                if exists $pa->{'suggest'}{$k};
        }
    }
    if ( ref $pa->{'dimensions'} eq 'HASH' ) {
        for my $dim ( keys %{ $pa->{'dimensions'} } ) {
            my $d = $pa->{'dimensions'}{$dim};
            $assertions->{'dimensions'}{$dim}{'score'} = $d->{'score'}
                // 'unasserted';
            $assertions->{'dimensions'}{$dim}{'reason'} = $d->{'reason'}
                // '';
        }
    }
} elsif ( $result =~ m{"assertions"\s*:\s*(\{.*?\})\s*[,\}]\s*$}s
    or $result =~ m{"assertions"\s*:\s*(\{.*\})\s*}s ) {
    ## legacy json fallback ##
    my $assert_json = $1;
    if ( $assert_json =~ m{"suggest"\s*:\s*\{(.*?)\}}s ) {
        my $suggest_block = $1;
        for my $k (qw| apply delete archive |) {
            $assertions->{'suggest'}{$k}
                = $suggest_block =~ m{"$k"\s*:\s*(true|false)}i
                ? ( lc($1) eq 'true' ? 'true' : 'false' )
                : undef;
        }
    }
    if (   $assert_json =~ m{"dimensions"\s*:\s*\{(.*?)\}\s*[,\}]}s
        or $assert_json =~ m{"dimensions"\s*:\s*\{(.*)\}}s ) {
        my $dim_block = $1;
        for my $dim (
            qw| location work-profile company-culture compensation
            remote-flexibility career-growth tech-stack team-structure |
        ) {
            if ( $dim_block =~ m{"$dim"\s*:\s*\{(.*?)\}}s ) {
                my $d = $1;
                $assertions->{'dimensions'}{$dim}{'score'}
                    = ( $d =~ m{"score"\s*:\s*(\d+(?:\.\d+)?)} )[0]
                    // 'unasserted';
                $assertions->{'dimensions'}{$dim}{'reason'}
                    = ( $d =~ m{"reason"\s*:\s*"([^"]+)"} )[0] // '';
            }
        }
    }
}
$job_rec->{'assertions'} = $assertions;

## store result (original or post-repair) ##
## sanitize encoding before storing ##
## ensure utf8 flag is set so fix_encoding reaches mojibake repair, not raw-bytes short-circuit ##
for ( $reason, $summary ) {
    utf8::decode($_)
        if defined $_
        and not utf8::is_utf8($_)
        and utf8::valid($_);
}
$reason  = <[jobsite.util.fix_encoding]>->($reason) if defined $reason;
$summary = <[jobsite.util.fix_encoding]>->($summary)
    if defined $summary;
for my $dim ( keys %{ $assertions->{'dimensions'} // {} } ) {
    my $dr = $assertions->{'dimensions'}{$dim}{'reason'} // '';
    utf8::decode($dr)
        if length $dr
        and not utf8::is_utf8($dr)
        and utf8::valid($dr);
    $assertions->{'dimensions'}{$dim}{'reason'}
        = <[jobsite.util.fix_encoding]>->($dr)
        if length $dr;
}

$job_rec->{'score'}         = $score;
$job_rec->{'score_reason'}  = $reason  // '';
$job_rec->{'score_summary'} = $summary // '';

my $threshold     = <jobsite.cfg.threshold> //= 7;
my $current_stage = $job_rec->{'stage'} // '';

if ( $protected_stage{$current_stage} ) {
    ## keep user-selected stage, derive matching status ##
    $job_rec->{'status'} = $stage_to_status{$current_stage} // 'assessed';
    $job_rec->{'stage'}  = $current_stage;
    <[base.logs]>->(
        1, 'job %s stage=%s protected, preserving stage [score=%s]',
        $job_id, $current_stage, length($score) ? $score : '?'
    );
} elsif ( length($score) and $score >= $threshold ) {
    $job_rec->{'status'} = 'review';
    $job_rec->{'stage'}  = 'review';
    <[base.logs]>->(
        1,       'job %s score=%s ABOVE threshold → review',
        $job_id, $score
    );
} else {
    ## below threshold : recoverable trash (user can rescue or bulk-delete) ##
    $job_rec->{'status'} = 'trash';
    $job_rec->{'stage'}  = 'trash';
    $job_rec->{'trash_epoch'} //= <[base.ntime.epoch_timestamp]>;
    <[base.logs]>->(
        1,       'job %s score=%s below threshold → trash',
        $job_id, length($score) ? $score : '?'
    );
}

## update per-job file
my $job = <[jobsite.job.read]>->($job_id) // {};
$job->{'status'}        = $job_rec->{'status'};
$job->{'score'}         = $score;
$job->{'score_reason'}  = $reason  // '';
$job->{'score_summary'} = $summary // '';
$job->{'assertions'}    = $assertions if %{ $assertions // {} };
$job->{'stage'}         = $job_rec->{'stage'};

<[jobsite.job.write]>->( $job_id, $job );

## add to checksum index for dedup on future scans ##
<[jobsite.checksum.index]>->( qw| add |, $job );

<jobsite.pending_count>--;

if ( <jobsite.pending_count> <= 0 ) {
    <jobsite.pending_count> = 0;
    <jobsite.cycle>         = 'idle';
    <[base.logs]>->( 1, 'all assessments complete, cycle=idle' );
    if (<jobsite.sync.push_in_progress>) {
        ## current push already collected its job list; schedule follow-up ##
        <jobsite.sync.push_after_assess> = TRUE;
        <[base.logs]>->(
            1, 'assess-done: sync push in progress, scheduling follow-up'
        );
    } else {
        <[jobsite.sync.push]>->( undef, FALSE )  ## push updated job to web ##
            ;    ## push results to web immediately ##
    }
}

<[jobsite.state.persist]>;
<[jobsite.dispatch.next]>

#,,..,...,.,,,.,.,,.,,...,...,.,,,...,...,,..,..,,...,...,...,...,,.,,,.,,,,.,
