# name  = storage.visual.util.list_workflows
# descr = list available visual workflows from storage mapping registry

my $registry  = $data{'storage'}{'mapping'}{'visual'};
my $workflows = $registry->{workflows};

my $output = "Available visual workflows:\n\n";
for my $name ( sort keys %$workflows ) {
    my $wf = $workflows->{$name};
    $output .= sprintf( "  %-20s %s\n", $name, $wf->{desc} );
    $output .= sprintf( "    Steps: %d\n", scalar( @{ $wf->{steps} } ) );
}

return { 'mode' => 'size', 'data' => $output };

