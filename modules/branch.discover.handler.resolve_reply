# name  = branch.discover.handler.resolve_reply
# descr = handle reply from discover.branch.query

my $reply    = shift;
my $query_id = $reply->{'params'}{'query_id'} // '';

return unless length $query_id;

$data{'branch.discover.results'}{$query_id} = {
    'ntime'  => <[base.time]>->(4),
    'data'   => $reply->{'data'},
    'status' => 'complete',
};

if ( exists $data{'branch.discover.queries'}{$query_id} ) {
    $data{'branch.discover.queries'}{$query_id}{'status'} = 'complete';
}

<[base.logs]>->(
    2, 'branch.discover.resolve_reply: query %s complete', $query_id
);

return { 'mode' => 'true', 'data' => $query_id };

