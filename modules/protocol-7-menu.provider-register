## [:< ##

# name = protocol-7-menu.provider-register
# descr = Helper for external zenka to register and unregister from menu

my ( $provider_name, $provider_data, $operation ) = @ARG;

$operation //= 'register';

return {
    'mode' => qw| false |,
    'data' => 'provider name required'
    }
    unless defined $provider_name;

if ( $operation eq 'register' ) {
    ## Register provider with menu system
    $provider_data //= { 'items' => {} };

    my $response = <[base.protocol-7.command.send.local]>->(
        {   'command'   => 'protocol-7-menu.menu-update',
            'call_args' => {
                'args' => "$provider_name "
                    . JSON::encode_json($provider_data)
            }
        }
    );

    <[base.logs]>->(
        1, "registered provider '%s' with menu system",
        $provider_name
    );

    return $response;
} elsif ( $operation eq 'unregister' ) {
    ## Unregister provider (removes from menu)
    my $response = <[base.protocol-7.command.send.local]>->(
        {   'command'   => 'protocol-7-menu.menu-update',
            'call_args' => { 'args' => $provider_name }
        }
    );

    <[base.logs]>->(
        1, "unregistered provider '%s' from menu system",
        $provider_name
    );

    return $response;
} elsif ( $operation eq 'update' ) {
    ## Update provider menu items
    $provider_data //= {};

    my $response = <[base.protocol-7.command.send.local]>->(
        {   'command'   => 'protocol-7-menu.menu-update',
            'call_args' => {
                'args' => "$provider_name "
                    . JSON::encode_json($provider_data)
            }
        }
    );

    return $response;
} else {
    return {
        'mode' => qw| false |,
        'data' =>
            "unknown operation '$operation' (use: register|update|unregister)"
    };
}

