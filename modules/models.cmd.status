## [:< ##

# name = models.cmd.status
# descr = Handle status command - return current zenka state

$data{models} //= {};

my $reply_str = '';
$reply_str .= 'status: running' . "\n";
$reply_str .= 'zenka: models' . "\n";
$reply_str .= 'timestamp: ' . time() . "\n";
$reply_str .= 'operation_log_entries: '
    . scalar( @{ $data{models}{operation_log} // [] } ) . "\n";
$reply_str .= 'error_log_entries: '
    . scalar( @{ $data{models}{error_log} // [] } ) . "\n";
$reply_str .= 'action_log_entries: '
    . scalar( @{ $data{models}{action_log} // [] } ) . "\n";

return { 'mode' => qw| size |, 'data' => $reply_str };

