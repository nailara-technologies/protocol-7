## [:< ##

# name = models.cmd.status
# descr = Handle status command - return current zenka state

sub execute_status {
  return {
    'success' => TRUE,
    'zenka' => 'models',
    'status' => 'running',
    'operation_log_entries' => scalar(@{$data{operation_log}}),
    'error_log_entries' => scalar(@{$data{error_log}}),
    'action_log_entries' => scalar(@{$data{action_log}}),
    'timestamp' => time(),
  };
}

# Entry point
{
  my $cmd = shift @ARG;

  if ($cmd eq 'status') {
    return execute_status();
  }

  return {
    'success' => FALSE,
    'error' => "unknown command: $cmd",
  };
};

