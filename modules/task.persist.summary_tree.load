## [:< ##

# name  = task.persist.summary_tree.load
# descr = load summary-tree entries from disk yaml

my $sref = <[file.zenka_dir.load]>->('summary-tree.yaml');
unless ( defined $sref ) {
    <[base.logs]>->( 2, ': summary-tree file not found, starting fresh' );
    return TRUE;
}

my $data = <[format.yaml.load_str]>->( $sref->$* );
if ( not defined $data or ref $data ne 'HASH' ) {
    <[base.logs]>->( 1, ': summary-tree file invalid : removing' );
    <[file.zenka_dir.unlink_file]>->('summary-tree.yaml');
    return TRUE;
}

<task.summary_tree.entries> = $data->{'entries'} // {};

<[base.logs]>->(
    2,
    ': summary-tree loaded [ %d entries ]',
    scalar( keys %{<task.summary_tree.entries>} )
);

return TRUE;

