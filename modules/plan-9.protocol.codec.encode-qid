## [:< ##
# name  = plan-9.protocol.codec.encode-qid
return sub {
    my ( $type, $version, $path ) = @_;
    my ( $plo, $phi ) = ( $path & 0xFFFFFFFF, $path >> 32 );
    pack( 'C V VV', $type, $version, $plo, $phi );
};

