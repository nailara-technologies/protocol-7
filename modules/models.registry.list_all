## [:< ##

# name = models.registry.list_all
# descr = List all models in registry

sub list_all_models {
  my $base = <[models.registry.base]>;
  my $registry = $base->{get_registry}->();
  my @models = values %{$registry->{models}};
  return \@models;
}

# Entry point
{
  my @args = @ARG;
  return list_all_models(@args);
};

