## [:< ##

# name = data.mount.shm.feedback.create
# descr = Create the native notify fifo alongside a paged SHM segment

# thin zenka wrapper -> AMOS7::SHM::Feedback::create_notify_fifo
# the fifo's lifecycle follows the segment's; data.mount.shm.unlink now also
# removes the sibling .notify path.

my $mount = shift;

return AMOS7::SHM::Feedback::create_notify_fifo($mount);

