## [:< ##

# name  = nodes.orbital.current_position
# descr = return current orbital P7REF and derived parameters

my $params        = <nodes.orbital.params> // {};
my $session_start = <nodes.orbital.session_start>;
my $current_p7ref = <nodes.orbital.current_p7ref>;

return {
    'mode' => qw| false |,
    'data' => 'orbital position not initialized'
    }
    unless defined $session_start;

my $computed_at = <[base.ntime]>->(3);

return {
    'mode' => qw| true |,
    'data' => {
        'p7ref'         => $current_p7ref,
        'local_ip'      => <nodes.orbital.local_ip> // '127.0.0.1',
        'theta'         => $params->{'theta'},
        'phi'           => $params->{'phi'},
        'psi'           => $params->{'psi'},
        'omega'         => $params->{'omega'},
        'session_start' => $session_start,
        'computed_at'   => $computed_at
    }
};

