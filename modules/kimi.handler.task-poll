## [:< ##

# name  = kimi.handler.task-poll
# descr = poll task queue for pending tasks and auto-submit to kimi

## guard: only one task in flight at a time
return if defined <kimi.task.active_id>;

## guard: must be connected and ready
return unless <kimi.ws.connected>;
return unless <kimi.ws.status> eq qw| ready |;

<[base.log]>->( 3, ': task poll: checking for pending tasks' );

## query pending tasks via async callback chain
my $sent = <[protocol-7.route-send]>->(
    {   'command'   => 'task.queue',
        'call_args' => { 'args' => 'status=pending' },
        'reply'     => {
            'handler' => 'kimi.handler.task-poll-step',
            'params'  => { 'step' => 'list' }
        }
    }
);

if ( $sent <= 0 ) {
    <[base.log]>->( 3, ': task poll: task zenka not reachable' );
}

return;

