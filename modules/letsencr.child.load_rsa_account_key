## [:< ##

# name  = letsencr.child.load_rsa_account_key
# descr = load cached RSA account key from PEM format

<[base.log]>->( 2, 'loading RSA account key from cache' );

my $key_cache = sprintf '%s/account.key.rsa', <letsencr.cache.dir>;

## check if cache file exists
unless ( -f $key_cache ) {
    <[base.log]>->(
        2, 'RSA account key cache not found, will generate new key'
    );
    return undef;
}

## read PEM-encoded private key from cache
my $pem_private;
{
    open( my $fh, '<:raw', $key_cache ) or do {
        <[base.log]>->(
            1, "error : unable to read RSA account key file : $!"
        );
        return undef;
    };
    local $/;
    $pem_private = <$fh>;
    close($fh);
}

## instantiate Crypt::OpenSSL::RSA object from PEM
my $rsa = eval { Crypt::OpenSSL::RSA->new_private_key($pem_private) } or do {
    my $err = <[base.str.eval_error]>;
    <[base.logs]>->(
        1, "error: failed to load RSA private key from PEM: %s", $err
    );
    return undef;
};

<[base.log]>->( 2, "RSA account key loaded from cache [ PEM format ]" );

## extract modulus and exponent via Crypt::PK::RSA [ CryptX ]
my $pem_public = $rsa->get_public_key_string;
my $pk_rsa     = Crypt::PK::RSA->new( \$pem_public );
my $key_hash   = $pk_rsa->key2hash;

my $modulus_b64;
my $exponent_b64;

if ( $key_hash->{'N'} ) {
    my $modulus_bin = pack( 'H*', $key_hash->{'N'} );
    $modulus_bin =~ s{^\x00}{};    ## strip leading null byte
    $modulus_b64 = encode_base64url($modulus_bin);
    <[base.logs]>
        ->( 3, 'modulus_b64 length: %d chars', length($modulus_b64) );
}

## exponent from key hash [ hex → binary → base64url ]
my $exponent_bin = pack( 'H*', $key_hash->{'e'} );
$exponent_b64 = encode_base64url($exponent_bin);

<[base.logs]>->(
    3,             'exponent_b64: %s (length %d)',
    $exponent_b64, length($exponent_b64)
);

unless ($modulus_b64) {
    <[base.log]>->( 1, 'warning: could not extract modulus from loaded key' );
    return undef;
}

## generate unique key identifier for this load
my $key_name = 'acme-account-' . <[base.prng.chars-anum]>->(8);

## store in global %keys{'RSA'} hash
$keys{'RSA'}->{$key_name} = {
    'rsa_object'  => $rsa,
    'modulus'     => $modulus_b64,
    'exponent'    => $exponent_b64,
    'pem_private' => $pem_private,
    'time-loaded' => <[base.ntime]>,
};

## store key name in child state for signing operations
<letsencr.child.acme_client>->{account_key_name} = $key_name;
<letsencr.child.acme_client>->{account_key_type} = 'RSA';

<[base.log]>->( 2, 'RSA account key ready for ACME operations' );

## return key name
return $key_name;

