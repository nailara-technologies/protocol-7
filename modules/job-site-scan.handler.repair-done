## [:< ##

# name  = job-site-scan.handler.repair-done
# descr = receive repair result, validate, store if improved

my $call = shift // {};

my $mode    = $call->{'mode'} // '';
my $raw     = $call->{'data'} // '';
my $result  = ref $raw ? $raw->$* : $raw;
my $job_id  = $call->{'params'}{'job_id'}  // '';
my $task_id = $call->{'params'}{'task_id'} // '';

my $job_rec = <job-site-scan.tasks>->{$job_id};
if ( not defined $job_rec ) {
    <[base.logs]>->( 0, 'jss.repair-done: unknown job %s', $job_id );
    <job-site-scan.pending_count>--;
    <[job-site-scan.dispatch.next]>;
    return;
}

if ( lc($mode) eq qw| false | ) {
    <[base.logs]>->(
        0,        'jss.repair-done: repair task %s failed for job %s',
        $task_id, $job_id
    );
    $job_rec->{'repair_failed'} = TRUE;
    <job-site-scan.pending_count>--;
    <[job-site-scan.state.persist]>;
    <[job-site-scan.dispatch.next]>;
    return;
}

## extract fields same as assess-done ##
my ( $score, $reason, $summary ) = ( '', '', '' );
if ( $result =~ m{\{.*?"(?:fit_)?score"\s*:\s*(\d+(?:\.\d+)?)}s ) {
    $score = $1;
    ($reason) = ( $result =~ m{"reason(?:s)?"\s*:\s*"([^"]+)"} );
    ($reason) //= do {
        my ($arr) = ( $result =~ m{"reasons"\s*:\s*\[([^\]]+)\]} );
        $arr
            ? ( split /,/, $arr )[0] =~ s/^\s*"?|"?\s*$//gr
            : undef;
    };
    ($summary) = ( $result =~ m{"summary"\s*:\s*"([^"]+)"} );
}

## validate repair result ##
my $validation
    = <[job-site-scan.validate.assessment]>->( $result, $reason, $summary );

if ( $validation->{'is_valid'} ) {
    ## parse assertions if present ##
    my $assertions = $job_rec->{'assertions'} // {};
    if (   $result =~ m{"assertions"\s*:\s*(\{.*?\})\s*[,\}]\s*$}s
        or $result =~ m{"assertions"\s*:\s*(\{.*\})\s*}s ) {
        my $assert_json = $1;
        if ( $assert_json =~ m{"suggest"\s*:\s*\{(.*?)\}}s ) {
            my $suggest_block = $1;
            if ( $suggest_block =~ m{"apply"\s*:\s*(true|false)}i ) {
                $assertions->{'suggest'}{'apply'}
                    = lc($1) eq 'true' ? 'true' : 'false';
            }
            if ( $suggest_block =~ m{"delete"\s*:\s*(true|false)}i ) {
                $assertions->{'suggest'}{'delete'}
                    = lc($1) eq 'true' ? 'true' : 'false';
            }
            if ( $suggest_block =~ m{"archive"\s*:\s*(true|false)}i ) {
                $assertions->{'suggest'}{'archive'}
                    = lc($1) eq 'true' ? 'true' : 'false';
            }
        }
        if (   $assert_json =~ m{"dimensions"\s*:\s*\{(.*?)\}\s*[,\}]}s
            or $assert_json =~ m{"dimensions"\s*:\s*\{(.*)\}}s ) {
            my $dim_block = $1;
            for my $dim (
                qw| location work-profile company-culture compensation
                remote-flexibility career-growth tech-stack team-structure |
            ) {
                if ( $dim_block =~ m{"$dim"\s*:\s*\{(.*?)\}}s ) {
                    my $d    = $1;
                    my ($ds) = ( $d =~ m{"score"\s*:\s*(\d+(?:\.\d+)?)} );
                    my ($dr) = ( $d =~ m{"reason"\s*:\s*"([^"]+)"} );
                    $assertions->{'dimensions'}{$dim}{'score'}
                        = defined $ds ? $ds : 'unasserted';
                    $assertions->{'dimensions'}{$dim}{'reason'}
                        = defined $dr ? $dr : '';
                }
            }
        }
    }
    $job_rec->{'assertions'} = $assertions;

    ## sanitize encoding before storing ##
    $reason = <[job-site-scan.util.fix_encoding]>->($reason)
        if defined $reason;
    $summary = <[job-site-scan.util.fix_encoding]>->($summary)
        if defined $summary;
    for my $dim ( keys %{ $assertions->{'dimensions'} // {} } ) {
        my $dr = $assertions->{'dimensions'}{$dim}{'reason'} // '';
        $assertions->{'dimensions'}{$dim}{'reason'}
            = <[job-site-scan.util.fix_encoding]>->($dr)
            if length $dr;
    }

    ## apply repair ##
    $job_rec->{'score'}         = $score;
    $job_rec->{'score_reason'}  = $reason  // '';
    $job_rec->{'score_summary'} = $summary // '';
    $job_rec->{'stage'}         = 'assessed';

    my $threshold = <job-site-scan.cfg.threshold> // 6;
    if ( length($score) and $score >= $threshold ) {
        $job_rec->{'stage'} = 'review';
        <[base.logs]>->(
            1,       'repair for job %s score=%s → review',
            $job_id, $score
        );
    } else {
        <[base.logs]>->(
            1,       'repair for job %s score=%s below threshold',
            $job_id, length($score) ? $score : '?'
        );
    }

    $job_rec->{'repair_applied'} = TRUE;

    ## update site-yaml store ##
    <[base.perlmod.autoload]>->('YAML::XS');
    my $store_file = '/var/protocol-7/site-yaml/store.yaml';
    if ( -f $store_file ) {
        my $store = eval { YAML::XS::LoadFile($store_file) } // {};
        if ( exists $store->{$job_id} ) {
            $store->{$job_id}{'status'}        = 'assessed';
            $store->{$job_id}{'score'}         = $score;
            $store->{$job_id}{'score_reason'}  = $reason  // '';
            $store->{$job_id}{'score_summary'} = $summary // '';
            $store->{$job_id}{'assertions'}    = $assertions
                if %{ $assertions // {} };
            eval { YAML::XS::DumpFile( $store_file, $store ) };

            ## add to checksum index for dedup on future scans ##
            <[job-site-scan.checksum.index]>
                ->( qw| add |, $store->{$job_id} );
        }
    }
} else {
    ## repair still invalid — mark and keep whatever we have ##
    $job_rec->{'repair_failed'} = TRUE;
    <[base.logs]>->(
        1,       'repair for job %s still invalid (%s), keeping original',
        $job_id, join( ', ', $validation->{'defects'}->@* )
    );
}

<job-site-scan.pending_count>--;

if ( <job-site-scan.pending_count> <= 0 ) {
    <job-site-scan.pending_count> = 0;
    <job-site-scan.cycle>         = 'idle';
    <[base.logs]>->( 1, 'all assessments complete, cycle=idle' );
}

<[job-site-scan.state.persist]>;
<[job-site-scan.dispatch.next]>;

