## [:< ##

# name  = coding.vision-parser.handler.vision_reply
# descr = receive vision analysis result and send deferred response callback

my $reply = shift;

my $job_id = $reply->{'params'}->{'job_id'};

unless ( defined $job_id && defined <coding.vision-parser.jobs>->{$job_id} ) {
    <[base.logs]>->(
        0,
        '[vision-parser] vision_reply: job not found: %s',
        $job_id // 'undef'
    );
    return;
}

my $job = <coding.vision-parser.jobs>->{$job_id};

<[base.logs]>->(
    1, '[vision-parser] vision_reply: received result for job=%s data_len=%d',
    $job_id, length( $reply->{'data'} // '' )
);

# Extract vision result from reply
my $vision_output = $reply->{'data'} // '';

unless ( length $vision_output > 0 ) {
    <[base.logs]>->( 0, '[vision-parser] vision returned no data' );
    <[base.callback.cmd_reply]>->(
        $job->{'reply_id'},
        { 'mode' => 'false', 'data' => "Vision analysis failed\n" }
    );
    return;
}

<[base.logs]>->(
    1, '[vision-parser] vision complete: %d bytes',
    length($vision_output)
);
$job->{'vision_result'} = $vision_output;

## Add vision result to conversation (TURN 1)
<[models.conversation.add_turn]>->(
    {   'job_id'  => $job_id,
        'role'    => 'assistant',
        'content' => $vision_output,
        'tokens'  => int( length($vision_output) / 4 ),
        'context' => 'vision-parser'
    }
);

## STAGE 2: Queue extraction (JSON→YAML translation)
<[base.logs]>->( 1, '[vision-parser] STAGE 2: queuing extraction' );

my $extraction_prompt = $job->{'extraction_prompt'}
    // 'Convert the following to YAML format. Preserve all fields.';

## For v2, use extraction service to convert vision output
## This will become a separate extraction LLM call
$job->{'extraction_result'} = $vision_output;

<[base.logs]>->( 1, '[vision-parser] extraction queued: job=%s', $job_id );

## Add extraction to conversation (TURN 2)
<[models.conversation.add_turn]>->(
    {   'job_id'  => $job_id,
        'role'    => 'user',
        'content' => $extraction_prompt,
        'context' => 'vision-parser'
    }
);

## Send final response via deferred callback
<[base.logs]>->(
    1, '[vision-parser] sending response: reply_id=%s bytes=%d',
    $job->{'reply_id'}, length($vision_output)
);

my $cb_result = <[base.callback.cmd_reply]>->(
    $job->{'reply_id'},
    { 'mode' => 'size', 'data' => $job->{'extraction_result'} }
);

<[base.logs]>->(
    1,
    '[vision-parser] callback sent: result=%s',
    $cb_result // 'undef'
);

return;

