# name  = work.cmd.regenerate-indexes
# descr = force regeneration of all yaml indexes

say "Regenerating todos index...";
my $todos_index = <[work.generate_todos_index]>;
say sprintf "✓ Todos index regenerated: %d todos", $todos_index->{total_count};

say "";
say "Regenerating workspace-transfer index...";
my $workspace_index = <[work.generate_workspace_index]>;
say sprintf "✓ Workspace index regenerated: %d bugs", $workspace_index->{total_bugs};

say "";
say "=== Index Statistics ===";
say "";
say sprintf "Todos by source:";
foreach my $source (sort keys %{$todos_index->{by_source}}) {
    say sprintf "  %s: %d", $source, $todos_index->{by_source}{$source};
}

say "";
say sprintf "Todos by priority:";
foreach my $priority (sort keys %{$todos_index->{by_priority}}) {
    say sprintf "  %s: %d", $priority, $todos_index->{by_priority}{$priority};
}

say "";
say sprintf "Repos tracked: %d", scalar @{$workspace_index->{repos}};

say "";
say "✓ All indexes regenerated successfully";

