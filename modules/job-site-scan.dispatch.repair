## [:< ##

# name  = job-site-scan.dispatch.repair
# descr = dispatch repair assessment task for a job with defects

my $job_id  = shift // '';
my $defects = shift // [];

return unless length $job_id;

my $job_rec = <job-site-scan.tasks>->{$job_id};
return unless defined $job_rec;

## load job data from site-yaml store ##
<[base.perlmod.autoload]>->('YAML::XS');
my $store_file = '/var/protocol-7/site-yaml/store.yaml';
my $store      = {};
if ( -f $store_file ) {
    $store = eval { YAML::XS::LoadFile($store_file) } // {};
}

my $job = $store->{$job_id} // {};

## build repair prompt via shared builder ##
my $prompt = <[job-site-scan.util.build_prompt]>->( $job, $defects );

## dispatch repair task ##
my $encoded = ':B32:' . encode_b32r( Encode::encode( 'UTF-8', $prompt ) );

<[protocol-7.route-send]>->(
    {   'command'   => 'task.create',
        'call_args' => { 'args' => $encoded },
        'reply'     => {
            'handler' => 'job-site-scan.handler.repair-created',
            'params'  => { 'job_id' => $job_id },
        },
    }
);

