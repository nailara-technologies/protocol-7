# name = plugin.web.content.util.calculate_checksum
# descr = compute elf checksum for file

my $file_path = shift;

return 'n/a' unless -f $file_path and -r $file_path;

## use elf.vax-BASE32 checksum ##
my $checksum = <[chk-sum.elf.vax-BASE32]>->($file_path);

return $checksum // 'error';

