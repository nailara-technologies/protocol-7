## [:< ##

# name  = kimi.connect.schedule_retry
# descr = schedule a reconnect attempt after retry_delay seconds

return if <kimi.connect.retrying>;

<kimi.connect.retrying> = TRUE;

my $delay = <kimi.connect.retry_cur>;

<[event.add_timer]>->(
    {   'after'   => $delay,
        'handler' => qw| kimi.connect |,
        'desc'    => 'kimi-web reconnect attempt'
    }
);

<[base.logs]>->( 2, 'kimi.connect: retry scheduled in %ds', $delay );

## double delay for next attempt, capped at configured maximum
my $next = $delay * 2;
<kimi.connect.retry_cur>
    = $next < <kimi.connect.retry_delay> ? $next : <kimi.connect.retry_delay>;

