## [:< ##

# name  = base.log.send-buffer.send-idle-callback
# todo  = implement alternative [non-local] ask-routes using nodes zenka

my $name = length ref $ARG[0] ? shift->w->data : shift;    ## buffer name ##

## path to target zenka via parent_route [ empty for cube, 'cube.' for
##                          direct, 'parent.cube.' for child zenki, etc. ] ##
my $route_prefix = '';
if ( ref(<protocol-7.network.parent_route>) eq qw| ARRAY |
    and <protocol-7.network.parent_route>->@* ) {
    $route_prefix = join( '.', <protocol-7.network.parent_route>->@* ) . '.';
}

if ( not defined $data{'buffer'}->{$name}->{'log_cmd'} ) {
    <[base.s_warn]>->(
        "no send command defined for '%s' buffer <{C1}>", $name
    );
    return undef;
}

my $log_send_cmd = $data{'buffer'}->{$name}->{'log_cmd'};

if ( not exists <log.send-buffer>->{$name} ) {
    <[base.s_warn]>->( "send-buffer '%s' no longer exists <{C1}>", $name );
    return undef;
}

##  removing idle callback reference  ##
delete <log.send-buffer>->{$name}->{'watcher'}->{'idle-send'};

my $b_ref = <log.send-buffer>->{$name};

( my $target_zenka = $log_send_cmd ) =~ s|\..+$||;   ##[ only local routes ]##

if ( $b_ref->{'paused'} and not $b_ref->{'n.o.-asking'} ) {

    if ( <system.zenka.name> eq qw| v7 | ) {

        ##  checking v7 registry for target zenka  ##

        ## check if already online ##

        if ( $b_ref->{'paused'} ) {
            <v7.status-request.log-target-zenka>->{$target_zenka} = TRUE;
        }

    } elsif ( <system.zenka.name> eq qw| cube | ) {

        ##  checking cube sessions for target zenka  ##
        $b_ref->{'paused'} = TRUE;
        if ( ( my $session_id ) = keys $data{'user'}{$target_zenka}->%* ) {
            $b_ref->{'paused'} = FALSE
                if $data{'session'}->{$session_id}->{'initialized'};
        }

        if ( $b_ref->{'paused'} ) {
            <cube.status-request.log-target-zenka>->{$target_zenka} = TRUE;
        }

    } else {    ## other zenki using 'v7.notify_online' command ##

        ##  deferred via <system.init_reports> instead of a direct send --
        ##  this callback can fire before this zenka's own cube session is
        ##  established (e.g. from an early idle-watcher tick), which
        ##  send.local silently drops with no retry. init_reports already
        ##  solves exactly this: queued here, flushed once by
        ##  base.session.send_init_reports once <system.zenka.initialized>
        ##  is true, self-rescheduling until then ##
        <system.init_reports> //= [];
        push(
            <system.init_reports>->@*,
            {   'target_command' =>
                    join( '', $route_prefix, qw| v7.notify_online | ),
                'param'   => $target_zenka,
                'descr'   => "waiting for log target '$target_zenka'..,",
                'handler' =>
                    qw| base.log.send-buffer.reply-handler.notify-online |,
                'reply_params' => { 'name' => $name },
            }
        );
    }

    $b_ref->{'n.o.-asking'} = TRUE;

} elsif ( $b_ref->{'data'}->$#* != -1 and defined $b_ref->{'data'}->[0] ) {

    ##  target zenka online : sending log request  ##
    my $line_sref = $b_ref->{'data'}->[0];

    if (    ref $line_sref eq qw| SCALAR |
        and defined $line_sref->$*
        and index( $line_sref->$*, "\n" ) > 0 ) { #### catch \n characters ###
        my $buffer_name = '';
        if ( $line_sref->$* =~ m{^([^ ]+)} ) {
            $buffer_name = sprintf( ' [%s]', $LAST_PAREN_MATCH );
        }
        <[base.logs]>->(
            0, 'endlines not allowed in%s log-msg string <{C1}>', $buffer_name
        );
        ### skip not valid entry and remove from queue ###
        shift $b_ref->{'data'}->@*;    ## remove offending entry line ##
    }

    my @send_line;    ##  composing log message parameters  ##

    ##  'source sid' command [ protocol ] mode expected  ##
    ## only cube prepends zenka name + sid : other zenki must NOT add this ##
    ## [ p7-log.cmd.append now always prepends its own trusted node name   ##
    ## since the SOURCE_ZENKA hostname-prefix removal (2026-06-19) -- cube ##
    ## must send its bare zenka name here, not node.zenka, or the node    ##
    ## name ends up doubled ] ##
    if ( <system.zenka.name> eq qw| cube | ) {
        push @send_line,    ##[ cube has sid 0 : set manually here ]##
            <system.zenka.name>, 0;
    }

    if ( ref $line_sref eq qw| SCALAR | and defined $line_sref->$* ) {

        ##  log buffer name and message  ##
        push @send_line, $name, $line_sref->$*;
        <[protocol-7.command.send.local]>->(
            {   qw| command | => join( '', $route_prefix, $log_send_cmd ),
                'call_args'   => { qw| args | => join ' ', @send_line },

                qw| reply | => {
                    'handler' =>
                        qw| base.log.send-buffer.reply-handler.send-reply |,
                    qw| params | => { qw| name | => $name }
                }
            }
        );
        $b_ref->{'waiting'} = TRUE;   ## register outstanding request reply ##

    } else {
        <[base.log]>->(
            0, ":. < skipping not valid log entry [ undefined message ] >"
        );
        ### skip not valid entry and remove from queue ###
        ##
        shift $b_ref->{'data'}->@*;    ## remove malformed entry ##
    }
}

