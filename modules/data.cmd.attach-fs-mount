## [:< ##

# name  = data.cmd.attach-fs-mount
# param = <hash-path> <dir> [options]
# descr = mount hash structure as FUSE filesystem at local directory

my $args = $call->{'args'} // '';
$args =~ s|^\s+||;
$args =~ s|\s+$||;

# Parse options [ format: key=value,key2=value ]
my $options = {};
if ( $args =~ s|\s+--\s*(.+)$|| || $args =~ s|\s+:\s*(.+)$|| ) {
    my $opt_str = $LAST_PAREN_MATCH;
    for my $pair ( split m|,\s*|, $opt_str ) {
        my ( $k, $v ) = split '=', $pair, 2;
        $v = 1 if !defined $v;
        $options->{$k} = $v;
    }
}

my ( $hash_path, $local_dir ) = split( m| +|, $args, 2 );

return {
    'mode' => qw| false |,
    'data' => 'expected <hash-path> and <local-dir> arguments'
    }
    unless defined $hash_path and defined $local_dir;

$local_dir =~ s|/+$|| if length($local_dir) > 1;

return {
    'mode' => qw| false |,
    'data' => sprintf( "directory '%s' does not exist", $local_dir )
    }
    unless -d $local_dir;

## validate hash path exists ##
my $ref = <[data.resolve_hash_path]>->($hash_path);

return {
    'mode' => qw| false |,
    'data' => sprintf( "hash path '%s' does not exist", $hash_path )
    }
    unless defined $ref;

## initialize FUSE subsystem if needed ##
if ( !<data.fuse.mounts> ) {
    <[data.mount.fuse.init_code]>;
}

## spawn FUSE child process ##
my $result = <[data.mount.fuse.spawn]>->( $hash_path, $local_dir, $options );

return $result;

