## [:< ##

# name  = data.cmd.attach-fs-mount
# param = <hash-path> <local-dir>
# descr = mount hash structure as FUSE filesystem at local directory

my ( $hash_path, $local_dir ) = split( / +/, $$call{'args'} // '', 2 );

return {
    'mode' => qw| false |,
    'data' => 'expected <hash-path> and <local-dir> arguments'
    }
    unless defined $hash_path and defined $local_dir;

$local_dir =~ s|/+$|| if length($local_dir) > 1;

return {
    'mode' => qw| false |,
    'data' => "directory '$local_dir' does not exist"
    }
    unless -d $local_dir;

return {
    'mode' => qw| false |,
    'data' => "directory '$local_dir' is not writable"
    }
    unless -w $local_dir;

## validate hash path exists ##
my $ref = <[data.resolve_hash_path]>->($hash_path);

return {
    'mode' => qw| false |,
    'data' => "hash path '$hash_path' does not exist"
    }
    unless defined $ref;

## check if FUSE is available ##
if ( !<data.fuse.capabilities.available> ) {
    return {
        'mode' => qw| false |,
        'data' =>
            "FUSE module not available - install Fuse.pm to use mount feature"
    };
}

## check if already mounted at this path ##
if ( exists <data.fuse.mounts> {$local_dir} ) {
    my $existing = <data.fuse.mounts> {$local_dir};
    return {
        'mode' => qw| false |,
        'data' =>
            "already mounted at $local_dir (pid $existing->{'pid'}, hash: $existing->{'hash_path'})"
    };
}

## initialize FUSE subsystem if needed ##
if ( !<data.fuse.mounts> ) {
    <[data.mount.fuse.init_code]>;
}

## spawn FUSE child process ##
my $result = <[data.mount.fuse.spawn]>->( $hash_path, $local_dir );

return $result;

