## [:< ##

# name  = window.place.cancel
# descr = cancel placement and notify caller

my $id = shift;

return undef if not defined $id;

my $inst = $data{window}{place}{instances}{$id};
return undef if not defined $inst;

my $reply_id = $inst->{'reply_id'};

if ( defined $reply_id and $reply_id =~ m|^\d+$| ) {
    <[base.callback.cmd_reply]>->(
        $reply_id,
        {   'mode' => qw| false |,
            'data' => 'cancelled'
        }
    );
} else {
    <[base.logs]>->(
        1, '[place.cancel] id=%s no reply_id, skipping direct reply', $id
    );
}

<[base.logs]>->( 1, '[place.cancel] id=%s placement cancelled', $id );

## destroy the window if still alive ##
my $window = $inst->{'window'};
if ( defined $window and $window->get_visible ) {
    $window->destroy;
}

## stop instance timers ##
my $poll_timer = $inst->{'poll'}{'timer'};
$poll_timer->cancel if defined $poll_timer;

my $damp_timer = $inst->{'damp'}{'timer'};
$damp_timer->cancel if defined $damp_timer;

## remove instance state ##
delete $data{window}{place}{instances}{$id};

## only exit the process when no instances remain ##
my $remaining = scalar keys %{ $data{window}{place}{instances} // {} };
if ( $remaining == 0 ) {
    <[base.log]>->( 1, '[place.cancel] no instances remain, exiting' );
    Gtk3->main_quit;
    <[base.exit]>->( 0, 'window.place cancelled', 2 );
}

return TRUE;

