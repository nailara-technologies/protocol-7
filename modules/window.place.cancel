## [:< ##

# name  = window.place.cancel
# descr = cancel placement and notify caller

my $reply_id = <window.place.reply_id>;

if ( defined $reply_id and $reply_id =~ m|^\d+$| ) {
    <[base.callback.cmd_reply]>->(
        $reply_id,
        {   'mode' => qw| false |,
            'data' => 'cancelled'
        }
    );
} else {
    <[base.log]>->( 1, '[place.cancel] no reply_id, skipping direct reply' );
}

<[base.log]>->( 1, '[place.cancel] placement cancelled' );

Gtk3->main_quit;

<[base.exit]>->( 0, 'window.place cancelled', 2 );

