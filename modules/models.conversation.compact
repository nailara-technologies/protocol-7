## [:< ##

# name = models.conversation.compact
# descr = compact conversation by summarizing old turns

my $params = shift;

my $job_id     = $params->{'job_id'}     // '';
my $keep_turns = $params->{'keep_turns'} // 5;
my $context    = $params->{'context'}    // 'conversation';

return {
    'success' => FALSE,
    'error'   => 'job_id required'
    }
    unless length($job_id);

return {
    'success' => FALSE,
    'error'   => 'keep_turns must be >= 1'
    }
    unless $keep_turns >= 1;

<models.conversations> //= {};

unless ( exists <models.conversations>->{$job_id} ) {
    return {
        'success' => FALSE,
        'error'   => "conversation not found: $job_id",
        'job_id'  => $job_id
    };
}

my $conversation = <models.conversations>->{$job_id};
my $start_time   = <[base.time]>->(4);

## Check if compaction is needed
my $turn_count = scalar( @{ $conversation->{'turns'} } );
unless ( $turn_count > $keep_turns ) {
    return {
        'success'    => TRUE,
        'job_id'     => $job_id,
        'turn_count' => $turn_count,
        'compacted'  => 0,
        'summary'    => 'no compaction needed'
    };
}

## Calculate how many turns to summarize
my $summarize_count = $turn_count - $keep_turns;

## Build summary of removed turns
my @summarized_turns
    = @{ $conversation->{'turns'} }[ 0 .. ( $summarize_count - 1 ) ];

## Create summary text
my $summary = '';
foreach my $turn (@summarized_turns) {
    my $role    = $turn->{'role'}    // 'unknown';
    my $content = $turn->{'content'} // '';
    substr( $content, 50 ) = '...' if length($content) > 50;
    $summary .= "[$role] $content\n";
}

## Remove old turns and add summary
my @remaining_turns
    = @{ $conversation->{'turns'} }
    [ $summarize_count .. $#{ $conversation->{'turns'} } ];

my $summary_tokens = int( length($summary) / 4 ) + 1;

## Create summary turn
my $summary_turn = {
    'role'    => 'system',
    'content' =>
        "Summary of conversation (turns 1-$summarize_count):\n$summary",
    'tokens'     => $summary_tokens,
    'timestamp'  => <[base.ntime]>,
    'is_summary' => 1
};

## Replace old turns with summary
unshift @remaining_turns, $summary_turn;
$conversation->{'turns'} = \@remaining_turns;

## Update compaction tracking
$conversation->{'compaction_count'}++;
$conversation->{'last_compaction'} = <[base.ntime]>;

<[base.logs]>->(
    1, "[$context] conversation compacted: job_id=%s turns=%d->%d",
    $job_id, $turn_count, scalar(@remaining_turns)
);

my $elapsed_ms = ( <[base.time]>->(4) - $start_time ) * 1000;

return {
    'success'              => TRUE,
    'job_id'               => $job_id,
    'original_turn_count'  => $turn_count,
    'compacted_turn_count' => scalar(@remaining_turns),
    'summarized_turns'     => $summarize_count,
    'summary_tokens'       => $summary_tokens,
    'compaction_count'     => $conversation->{'compaction_count'},
    'elapsed_ms'           => $elapsed_ms
};

