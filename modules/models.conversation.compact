## [:< ##

# name = models.conversation.compact
# descr = compact conversation history using various strategies

my $params = shift;

my $job_id        = $params->{'job_id'}        // '';
my $strategy      = $params->{'strategy'}      // 'drop_oldest';
my $target_tokens = $params->{'target_tokens'} // 2048;
my $context_label = $params->{'context'}       // 'conversation';

return {
    'success' => FALSE,
    'error'   => 'job_id required'
    }
    unless length($job_id);

<models.conversations> //= {};

unless ( exists <models.conversations>->{$job_id} ) {
    return {
        'success' => FALSE,
        'error'   => "conversation not found: $job_id"
    };
}

my $conversation = <models.conversations>->{$job_id};
my $start_time   = <[base.time]>->(4);
my $turns_ref    = $conversation->{'turns'};
my $turn_count   = scalar( @{$turns_ref} );

<[base.log]>->(
    1,         "[$context_label] compact: strategy=%s target=%d",
    $strategy, $target_tokens
);

my @compacted_turns;
my $removed_tokens = 0;

if ( $strategy eq 'drop_oldest' ) {

    ## Keep dropping oldest turns until under target
    for ( my $i = 0; $i < $turn_count; $i++ ) {
        my $turn       = $turns_ref->[$i];
        my $test_total = $conversation->{'tokens_used'} - $removed_tokens;

        if ( $test_total <= $target_tokens ) {
            push @compacted_turns, @{$turns_ref}[ $i .. $turn_count - 1 ];
            last;
        }
        $removed_tokens += $turn->{'tokens'} // 0;
    }

} elsif ( $strategy eq 'token_sample' ) {

    ## Keep first N, drop middle, keep last N
    my $keep_per_side = int( $target_tokens / 4 );
    my $keep_recent   = int( $target_tokens / 2 );

    if ( $turn_count > 10 ) {
        push @compacted_turns, @{$turns_ref}[ 0 .. $keep_per_side - 1 ];

        ## Add placeholder for dropped turns
        push @compacted_turns,
            {
            'role'    => 'system',
            'content' => '[... conversation history compacted ...]',
            'tokens'  => 0
            };

        push @compacted_turns,
            @{$turns_ref}[ $turn_count - $keep_recent .. $turn_count - 1 ];
    } else {
        @compacted_turns = @{$turns_ref};
    }

    $removed_tokens = $conversation->{'tokens_used'} - $target_tokens;

} elsif ( $strategy eq 'extract_critical' ) {

    ## Keep system and error turns, sample others
    foreach my $turn ( @{$turns_ref} ) {
        my $role    = $turn->{'role'}    // '';
        my $content = $turn->{'content'} // '';

        if (   $role eq 'system'
            || $content =~ /error|missing|fail|invalid/i ) {
            push @compacted_turns, $turn;
        }
    }

} else {
    return {
        'success'    => FALSE,
        'error'      => "unknown strategy: $strategy",
        'strategies' => [qw| drop_oldest token_sample extract_critical |]
    };
}

## Apply compaction
$conversation->{'turns'} = \@compacted_turns;
$conversation->{'tokens_used'} -= $removed_tokens;
$conversation->{'compaction_count'}++;
$conversation->{'last_compaction'} = time();

<[base.log]>->(
    1,
    "[$context_label] compacted: removed %d turns %d tokens",
    $turn_count - scalar(@compacted_turns),
    $removed_tokens
);

<models.metrics.context_compactions>++;

my $elapsed_ms = ( <[base.time]>->(4) - $start_time ) * 1000;

return {
    'success'          => TRUE,
    'job_id'           => $job_id,
    'strategy'         => $strategy,
    'turns_before'     => $turn_count,
    'turns_after'      => scalar(@compacted_turns),
    'turns_removed'    => $turn_count - scalar(@compacted_turns),
    'tokens_removed'   => $removed_tokens,
    'tokens_remaining' => $conversation->{'tokens_used'},
    'elapsed_ms'       => $elapsed_ms
};

