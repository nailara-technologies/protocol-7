# name = web-browser.callback.query_withheld_entries

<[base.log]>->( 1, "checking if playlist zenka is withholding entries..." );

<[base.protocol-7.command.send.local]>->(
    {   'command'   => "cube.content.entries_withheld",
        'call_args' => { 'args' => <system.zenka.subname> },
        'reply'     =>
            { 'handler' => 'web-browser.handler.withheld_entries_reply' }
    }
);

