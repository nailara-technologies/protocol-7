## [:< ##

# name  = context.init_code
# descr = initialize context subsystem state

## template directory path ##
<context.cfg.template_dir> //= qw| data/yaml/context-templates |;

## default token budget ##
<context.cfg.default_budget> //= 4000;

## characters per token estimate ##
<context.cfg.chars_per_token> //= 4;

## ai-mem base directory ##
<context.cfg.ai_mem_dir> //= qw| data/ai-mem |;

## style conventions file ##
<context.cfg.style_file> //= qw| data/yaml/code-style/CONVENTIONS.yaml |;

## loaded template cache ##
<context.templates> //= {};

<[base.logs]>->( 2, ': context subsystem initialized' );

return TRUE;

