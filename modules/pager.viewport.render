## [:< ##

# name  = pager.viewport.render
# descr = Render virtual buffer viewport to display

my ($args) = @ARG;

my $buffer_id = $args->{'buffer_id'};
my $buf       = $data{'pager'}{'buffers'}{$buffer_id};
return undef unless $buf;

my $top    = $args->{'top'}    // 0;   # First item to show
my $height = $args->{'height'} // 24;  # Rows visible
my $width  = $args->{'width'}  // 80;  # Columns available
my $cursor = $args->{'cursor'} // 0;   # Cursor position (0-based within view)

my $page_size  = $buf->{'pages'}{'size'};
my $start_page = int( $top / $page_size );
my $end_page   = int( ( $top + $height - 1 ) / $page_size );

# Gather items from page(s)
my @items;
for my $page_num ( $start_page .. $end_page ) {
    my $page_items = <[pager.buffer.page.get]>->( $buf, $page_num );
    next unless $page_items;
    push @items, @$page_items;
}

# Calculate visible slice
my $offset_in_items = $top - ( $start_page * $page_size );
my @visible = @items[ $offset_in_items .. $offset_in_items + $height - 1 ];

# Format function (customizable)
my $formatter = <[pager.util.viewport.default_formatter]>;

# Render lines
my @lines;
for my $i ( 0 .. $height - 1 ) {
    my $item = $visible[$i];
    my $line;

    if ($item) {
        my $is_cursor = ( $i == $cursor );
        $line = $formatter->( $item, $width, $is_cursor );
    } else {
        $line = ' ' x $width;
    }

    # Truncate/pad to width
    $line = substr( $line, 0, $width )        if length($line) > $width;
    $line .= ' ' x ( $width - length($line) ) if length($line) < $width;

    push @lines, $line;
}

return {
    'lines'       => \@lines,
    'total_items' => scalar(@items),
    'top'         => $top,
    'cursor'      => $top + $cursor,
    'has_more'    => ( scalar(@items) > $offset_in_items + $height ),
};

