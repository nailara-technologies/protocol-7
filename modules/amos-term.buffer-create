# name  = amos-term.buffer-create
# descr = Create SHM buffer for 3D terminal

my $window_id = shift;

my $window = <amos-term.windows.by_id>->{$window_id};
return undef unless defined $window;

my $amos_id    = $window->{'amos_id'};
my $session_id = $window->{'session_id'};

## create unique SHM identifier (must be >= 32 chars for ##
## data.mount.shm.create)                                ##
my $shm_owner_id = sprintf( "amos-term-buffer:%s:%010d:%08d",
    $amos_id, $session_id, time() % 100000000 );
my $shm_path = <amos-term.cfg.shm_base_path> . "/$amos_id";

## create SHM using data zenka ##
my $shm_size = $window->{'buffer'}->{'voxel_count'} * 2 + 16;    # 1472 bytes

my $shm = <[data.mount.shm.create]>->(
    $shm_owner_id,    # owner (32+ chars)
    $shm_size,
    { 'sub_path' => 'buffer' }
);

return undef unless defined $shm;

## store reference ##
$window->{'buffer'}->{'shm_path'} = $shm_path;

## raw mapping includes the SHM header [ P7SH, header_size bytes ] ; voxel  ##
## data starts at header_size. store a data-region alias as shm_ptr so all  ##
## consumers [ buffer-write, shift_z, erase, render ] address voxels from 0 ##
my $data_offset = $shm->{'header'}->{'header_size'} // 0;
$window->{'buffer'}->{'shm_map_ptr'} = $shm->{'mmap_ptr'};
$window->{'buffer'}->{'shm_ptr'}
    = \substr( ${ $shm->{'mmap_ptr'} }, $data_offset );

## initialize data region in place [ whole-scalar assign would detach the ##
## mmap and silently revert it to process-private memory ]                ##
substr( ${ $window->{'buffer'}->{'shm_ptr'} }, 0, $shm_size )
    = "\0" x $shm_size;

<[base.logs]>->(
    2,        ":. buffer created for %s (%d bytes)",
    $amos_id, $shm_size
);

return $shm;

