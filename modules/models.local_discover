## [:< ##

# name = models.local_discover
# descr = auto-scan and discover available local GGUF models

my $params = shift;

my $scan_paths = $params->{'scan_paths'}
    // ['/mnt/ext-xfs-data/models-lmstudio'];    ## [LLL] fix!!
my $context = $params->{'context'} // qw| discover |;

## Initialize cache
<models.local_models_cache> //= {};
my $cache_time = <models.local_cache_time> // 0;
my $now        = <[base.time]>->(2);

## Return cached models if recent (30 min cache TTL)
if ( $now - $cache_time < 1800
    && scalar( keys <models.local_models_cache>->%* ) > 0 ) {
    <[base.logs]>->(
        2,
        "[$context] using cached models: count=%d",
        scalar( keys <models.local_models_cache>->%* )
    );
    return {
        'success'    => TRUE,
        'models'     => <models.local_models_cache>,
        'count'      => scalar( keys <models.local_models_cache>->%* ),
        'from_cache' => TRUE,
    };
}

## Scan directories for GGUF files
my %discovered;

foreach my $scan_dir (@$scan_paths) {
    next unless -d $scan_dir;

    <[base.logs]>
        ->( 2, "[$context] scanning directory : path=%s", $scan_dir );

    eval {
        opendir( my $dh, $scan_dir ) or die "Cannot open $scan_dir: $!";
        my @entries = readdir($dh);
        closedir($dh);

        foreach my $entry (@entries) {
            next if $entry =~ m|^\.| || !-d "$scan_dir/$entry";

            ## Recursively search for .gguf files [LLL] fix !!!!!
            (   my $find_cmd = qq[
                find "$scan_dir/$entry"
                    -maxdepth 3
                    -name "*.gguf"
                    -type f
                    2>/dev/null
            ]
            ) =~ s|\s+| |g;
            my @find_results = qx{ $find_cmd };

            foreach my $file_path (@find_results) {
                chomp($file_path);
                next unless -f $file_path && length($file_path);

                ## Extract model name from path and filename
                my $filename = $file_path;
                $filename =~ s|.*/||;
                $filename =~ s|\.gguf$||;

                ## Skip mmproj files - they're vision projectors, not models
                next if $filename =~ m|^mmproj|i;

                say STDERR $filename;

                ## detect vision models — three methods in order ##
                my $is_vision = 0;

                ## 1. filename pattern ##
                $is_vision = 1 if $filename =~ m{vl|vision|vlm}i;

                ## 2. companion mmproj file in same directory ##
                my $mmproj_path = '';
                my $model_dir   = $file_path;
                $model_dir =~ s|/[^/]+$||;
                my @mmproj_files = glob("$model_dir/*mmproj*.gguf");
                if (@mmproj_files) {
                    $mmproj_path = $mmproj_files[0];
                    $is_vision   = 1;
                }

                ## 3. scan gguf metadata header for embedded vision encoder ##
                ## newer models bundle clip/vision encoder in a single gguf   ##
                if ( !$is_vision && open( my $gfh, '<:raw', $file_path ) ) {
                    my $header;
                    read( $gfh, $header, 65536 );  ## first 64 KB is enough ##
                    close($gfh);
                    if ( defined $header
                        && $header =~ /clip\.|vision_encoder|has_vision/i ) {
                        $is_vision = 1;
                    }
                }

                ## 4. check config.json for image_token_id ##
                ## present in multimodal architectures even without mmproj ##
                if ( !$is_vision ) {
                    my $cfg_path = "$model_dir/config.json";
                    if ( -f $cfg_path
                        && open( my $cfh, '<:utf8', $cfg_path ) ) {
                        my $cfg = do { local $/; <$cfh> };
                        close($cfh);
                        $is_vision = 1 if $cfg =~ /"image_token_id"/;
                    }
                }

                ## Extract model family from path
                my $family = 'local';
                $family = 'qwen'  if $file_path =~ m|qwen|i;
                $family = 'llama' if $file_path =~ m|llama|i;
                $family = 'coder' if $file_path =~ m|coder|i;

                ## Extract quantization from filename
                my $quantization = 'unknown';
                if ( $filename =~ m|([IQ][0-8](?:_[A-Z0-9_]+)?)\s*$|i ) {
                    $quantization = uc($1);
                }

                ## Get file size
                my $size_bytes = -s $file_path;
                my $size_gb    = $size_bytes / ( 1024**3 );

                $discovered{$filename} = {
                    'path'         => $file_path,
                    'family'       => $family,
                    'is_vision'    => $is_vision,
                    'quantization' => $quantization,
                    'size_gb'      => sprintf( '%.3f', $size_gb ),
                    'mmproj_path'  => $mmproj_path,
                    'found_at'     => $now,
                };
            }
        }
    };
}

## Cache the results
<models.local_models_cache> = \%discovered;
<models.local_cache_time>   = $now;

<[base.logs]>->(
    1,
    "[$context] discovery complete: found=%d models",
    scalar( keys %discovered )
);

return {
    'success'       => TRUE,
    'models'        => \%discovered,
    'count'         => scalar( keys %discovered ),
    'scanned_paths' => $scan_paths,
};

