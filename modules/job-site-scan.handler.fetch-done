## [:< ##

# name  = job-site-scan.handler.fetch-done
# descr = receive site-yaml.import reply, dispatch assessments when all done

my $call = shift // {};

my $mode     = $call->{'mode'} // '';
my $raw      = $call->{'data'} // '';
my $data_str = ref $raw ? $raw->$* : $raw;
my $category = $call->{'params'}{'category'} // '';

if ( lc($mode) eq qw| false | ) {
    <[base.logs]>->(
        0,         'jss.fetch-done [%s]: import failed: %s',
        $category, $data_str
    );
} else {
    <[base.logs]>->( 1, 'jss.fetch-done [%s]: %s', $category, $data_str );
}

## decrement fetch counter — only proceed when all categories replied
<job-site-scan.fetch_pending> //= 1;
<job-site-scan.fetch_pending>--;

return if <job-site-scan.fetch_pending> > 0;

## all imports replied — check if async detail fetches are still running ##
my $queue = $data{'site-yaml'}{'fetch_queue'} // [];
if ( @{$queue} ) {
    <[base.logs]>->(
        1,
        'jss: %d detail fetches in progress, waiting for queue drain',
        scalar @{$queue}
    );
    $data{'site-yaml'}{'fetch_drain_cb'}
        = 'job-site-scan.handler.fetch-drain';
    return;
}

## queue empty — proceed to assessments immediately ##
<[job-site-scan.dispatch.assessments]>;

