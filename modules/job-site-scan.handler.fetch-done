## [:< ##

# name  = job-site-scan.handler.fetch-done
# descr = receive site-yaml.import reply, dispatch assessments when all done

my $call = shift // {};

my $mode     = $call->{'mode'} // '';
my $raw      = $call->{'data'} // '';
my $data_str = ref $raw ? $raw->$* : $raw;
my $category = $call->{'params'}{'category'} // '';

if ( lc($mode) eq qw| false | ) {
    <[base.logs]>->(
        0,         'jss.fetch-done [%s]: import failed: %s',
        $category, $data_str
    );
} else {
    <[base.logs]>->( 1, 'jss.fetch-done [%s]: %s', $category, $data_str );
}

## decrement fetch counter — only proceed when all categories replied
<job-site-scan.fetch_pending> //= 1;
<job-site-scan.fetch_pending>--;

return if <job-site-scan.fetch_pending> > 0;

## all fetches done — collect new untracked jobs from site-yaml store
<[base.perlmod.autoload]>->('HTML::Entities');
my $store = $data{'site-yaml'}{'jobs'}{'store'} // {};

## fallback: read from file if not in shared namespace
if ( not %{$store} ) {
    <[base.perlmod.autoload]>->('YAML::XS');
    my $store_file = '/var/protocol-7/site-yaml/store.yaml';
    eval { $store = YAML::XS::LoadFile($store_file) } if -f $store_file;
}

my @to_assess;
for my $job_id ( keys %{$store} ) {
    my $job = $store->{$job_id};
    next if ( $job->{'status'} // '' ) ne 'new';
    next if exists <job-site-scan.tasks>->{$job_id};
    push @to_assess, $job_id;
}

if ( not @to_assess ) {
    <[base.logs]>->( 1, 'jss: no new untracked jobs to assess, idle' );
    <job-site-scan.cycle> = 'idle';
    <[job-site-scan.state.persist]>;
    return;
}

<job-site-scan.cycle>         = 'assessing';
<job-site-scan.pending_count> = scalar @to_assess;
<[job-site-scan.state.persist]>;

<[base.logs]>->(
    1,
    'jss: queuing %d assessment tasks (sequential)',
    scalar @to_assess
);

## load candidate profile once
my $profile_file = <job-site-scan.cfg.profile_file>
    // '/etc/protocol-7/job-site-scan/profile.txt';
my $profile_text = '';
if ( -r $profile_file ) {
    open( my $fh, '<:utf8', $profile_file )
        and do { local $/; $profile_text = <$fh>; close $fh };
} else {
    $profile_text
        = 'no profile configured — score based on job listing alone';
}

## build queue entries
my @queue;
for my $job_id (@to_assess) {
    <job-site-scan.tasks>->{$job_id}
        = { 'stage' => 'queued', 'task_id' => '' };

    my $job      = $store->{$job_id};
    my $title    = $job->{'title'}       // '';
    my $co       = $job->{'company'}     // '';
    my $city     = $job->{'city'}        // '';
    my $ind      = $job->{'industry'}    // '';
    my $raw_desc = $job->{'description'} // '';
    HTML::Entities::decode_entities($raw_desc) if length $raw_desc;
    my $desc = substr( $raw_desc, 0, 1200 );

    ## build complete self-contained prompt — no template dependency
    my $prompt = join( "\n\n",
        ':local: you are a job matching assistant. assess the fit and return'
            . ' a JSON object only — no other text.',
        'scoring criteria: technical skill overlap (weighted highest),'
            . ' seniority level match, location / remote compatibility,'
            . ' industry relevance, role scope fit.',
        'return exactly this json and nothing else:'
            . ' {"score": <0-10>, "reason": "<one sentence>", "apply": <true|false>}',
        '## candidate profile ##',
        $profile_text,
        '## job listing ##',
        "title: $title",
        "company: $co",
        "city: $city",
        "industry: $ind",
        "description:\n$desc",
    );

    push @queue, { 'job_id' => $job_id, 'desc' => $prompt };
}

<job-site-scan.assess_queue> = \@queue;

## dispatch first task — task-created handler will call dispatch.next for each
<[job-site-scan.dispatch.next]>;

