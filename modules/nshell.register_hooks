## [:< ##

# name  = nshell.register_hooks
# descr = Register hooks on nshell session to intercept unknown messages

## Get the current session ID from cube user's sessions
## From nshell's perspective, it communicates with cube user
my ($session_id) = keys <user.cube.session>->%*;

unless ( defined $session_id and defined $data{'session'}{$session_id} ) {
    <[base.log]>->(
        0,
        'nshell.register_hooks: no cube session found, cannot register hooks'
    );
    return FALSE;
}

## Register hooks to intercept unknown messages from cube/other zenki
## These are called by base.handler.command when it encounters unknown messages

## Hook for replies with unknown route IDs
<[base.handler.hooks.register]>->(
    $session_id, 'unknown-reply-route', 'nshell.hook.unknown_reply_route'
);

## Hook for replies with unknown/invalid types
<[base.handler.hooks.register]>->(
    $session_id, 'unknown-reply-type', 'nshell.hook.unknown_reply_type'
);

## unknown-command and unknown-command-global hooks disabled
## these would print to console, blocking network replies from being routed back
## nshell handles commands through normal reply handlers, not through unknown-command hooks

<[base.log]>->(
    2,
    'nshell: registered 2 message interception hooks (reply-route, reply-type)'
);

return TRUE;

