## [:< ##

# name  = select.region.handler.draw
# descr = draw translucent selection frame with readout

my ( $id, $widget, $context ) = @ARG;

return TRUE if not defined $id;

my $inst = $data{select}{region}{instances}{$id};
return TRUE if not defined $inst;

## bracket / HUD geometry follows the live cairo surface, which during a   ##
## damped resize trails the target [ keeps brackets pinned to real edges ] ##
my $w = $widget->get_allocated_width  // $inst->{'geom'}{'width'}  // 320;
my $h = $widget->get_allocated_height // $inst->{'geom'}{'height'} // 240;

## clear ##
$context->set_operator('source');

## translucent deep blue fill [ alpha varies by kind ] ##
if ( $inst->{'kind'} eq qw| window | ) {
    $context->set_source_rgba( 0.0, 0.0, 0.24, 0.72 );
} else {
    $context->set_source_rgba( 0.0, 0.0, 0.24, 0.40 );
}
$context->paint;

$context->set_operator('over');

## corner brackets [ protocol-7 'truth' foreground #0647C3 ] ##
## [ arm = 16, matches $corner hit-region in button_press ] ##
my $arm = 16;
$context->set_source_rgba( 0.023529, 0.278431, 0.764706, 0.9 );
$context->set_line_width(2);

## top-left ##
$context->move_to( 0, 0 );
$context->line_to( $arm, 0 );
$context->move_to( 0, 0 );
$context->line_to( 0, $arm );

## top-right ##
$context->move_to( $w, 0 );
$context->line_to( $w - $arm, 0 );
$context->move_to( $w, 0 );
$context->line_to( $w, $arm );

## bottom-left ##
$context->move_to( 0, $h );
$context->line_to( $arm, $h );
$context->move_to( 0, $h );
$context->line_to( 0, $h - $arm );

## bottom-right ##
$context->move_to( $w, $h );
$context->line_to( $w - $arm, $h );
$context->move_to( $w, $h );
$context->line_to( $w, $h - $arm );

$context->stroke;

## text overlay : caller title top-left, geometry readout bottom-right ##
my $x = $inst->{'geom'}{'x'} // 0;
my $y = $inst->{'geom'}{'y'} // 0;

my $margin      = <select.region.font-size.margin> //= 10;
my $title_size  = <select.region.font-size.title>  //= 40;
my $coords_size = <select.region.font-size.coords> //= 24;

## use the white-rabbit face when it loaded, else the cairo toy font ##
my $font_face = <select.region.font.face>;
$context->set_font_face($font_face) if defined $font_face;

## title : kind + optional caller/tag, larger, bottom-left ##
my $title;
if ( $inst->{'kind'} eq qw| window | ) {
    $title = sprintf '[%s]', $inst->{'caller'} // '';
} elsif ( defined $inst->{'tag'} and length $inst->{'tag'} ) {
    $title = sprintf '[screenshot:%s]', $inst->{'tag'};
} else {
    $title = '[screenshot]';
}

if ( length $title and $title ne '[]' ) {
    $context->set_font_size($title_size);
    $context->set_source_rgba( 0.023529, 0.278431, 0.764706, 0.95 );
    $context->move_to( $margin, $h - $margin );
    $context->show_text($title);
}

## readout shows the precise target geometry, not the trailing surface ##
my $rw = $inst->{'geom'}{'width'}  // $w;
my $rh = $inst->{'geom'}{'height'} // $h;

my $readout = sprintf '[ W:%d H:%d X:%d Y:%d ]', $rw, $rh, $x, $y;

## center the readout in the window, both axes ##
$context->set_font_size($coords_size);
$context->set_source_rgba( 0.023529, 0.278431, 0.764706, 0.95 );
my $extents = $context->text_extents($readout);
my $tw      = $extents->{'width'};
my $th      = $extents->{'height'};
$context->move_to(
    ( $w - $tw ) / 2 - $extents->{'x_bearing'},
    ( $h - $th ) / 2 - $extents->{'y_bearing'}
);
$context->show_text($readout);

return TRUE;

