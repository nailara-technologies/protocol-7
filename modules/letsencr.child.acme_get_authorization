## [:< ##

# name  = letsencr.child.acme_get_authorization
# descr = fetch authorization from ACME server and extract challenges

my $auth_url = shift;

return undef unless $auth_url;

<[base.log]>->( 2, "fetching authorization from $auth_url" );

## Get fresh nonce
my $nonce = <[letsencr.child.get_fresh_nonce]>;
unless ($nonce) {
    <[base.log]>->( 1, 'error: failed to get fresh nonce' );
    return undef;
}

## Make authenticated GET request
my $response = <[letsencr.child.acme_http_request]>->(
    'POST',    # RFC 8555 requires POST-as-GET (POST with empty payload)
    $auth_url,
    '',        # empty payload for POST-as-GET
    $nonce,
    <letsencr.child.acme_client> {account_url}
);

unless ($response) {
    <[base.log]>->( 1, 'error: authorization request failed' );
    return undef;
}

unless ( $response->{status} == 200 ) {
    <[base.log]>->(
        1, "error: authorization request returned status $response->{status}"
    );
    return undef;
}

## Extract authorization data
my $auth_data  = $response->{data};
my $identifier = $auth_data->{identifier};
my $challenges = $auth_data->{challenges};

unless ( $identifier && $challenges && @$challenges ) {
    <[base.log]>->( 1, 'error: invalid authorization response' );
    return undef;
}

<[base.log]>->( 2, "authorization fetched for $identifier->{value}" );
<[base.log]>->( 2, "  status: $auth_data->{status}" );
<[base.log]>->( 2, "  challenges: " . scalar(@$challenges) );
<[base.log]>->(
    2, "  wildcard: " . ( $auth_data->{wildcard} ? 'yes' : 'no' )
);

## Find HTTP-01 and DNS-01 challenges
my $http01_challenge;
my $dns01_challenge;

foreach my $challenge (@$challenges) {
    if ( $challenge->{type} eq 'http-01' ) {
        $http01_challenge = $challenge;
    } elsif ( $challenge->{type} eq 'dns-01' ) {
        $dns01_challenge = $challenge;
    }
}

## For wildcard domains, DNS-01 is required
my $is_wildcard = $auth_data->{wildcard} // 0;

if ($is_wildcard) {
    unless ($dns01_challenge) {
        <[base.log]>->(
            1, 'error: wildcard domain requires dns-01 challenge'
        );
        return undef;
    }
    <[base.log]>->( 2, 'using DNS-01 challenge (wildcard domain)' );
} else {
    unless ( $http01_challenge || $dns01_challenge ) {
        <[base.log]>
            ->( 1, 'error: no http-01 or dns-01 challenge available' );
        return undef;
    }
    <[base.log]>->(
        2,
        'using '
            . ( $http01_challenge ? 'HTTP-01' : 'DNS-01' )
            . ' challenge'
    );
}

## Update nonce
<letsencr.child.acme_client> {nonce} = $response->{nonce};

return {
    status     => $auth_data->{status},
    identifier => $identifier,
    challenges => $challenges,
    http01     => $http01_challenge,
    dns01      => $dns01_challenge,
    wildcard   => $is_wildcard,
};

