# name  = base.devmod.dump_var

<[base.perlmod.load]>->('Data::Dumper')
    if not <[base.perlmod.loaded]>->('Data::Dumper');

local $Data::Dumper::Sortkeys = TRUE;

say Data::Dumper::Dumper(@ARG);

