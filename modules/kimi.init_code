## [:< ##

# name  = kimi.init_code
# descr = initialize kimi-web zenka client state and schedule connection

map { <[base.perlmod.load]>->($_) }
    qw| JSON LWP::UserAgent Protocol::WebSocket::Frame |;

## kimi-web endpoint configuration
<kimi.web.host> //= qw| 127.0.0.1 |;
<kimi.web.port> //= 5494;
<kimi.web.base_url>
    //= sprintf( 'http://%s:%d', <kimi.web.host>, <kimi.web.port> );
<kimi.web.ws_base>
    //= sprintf( 'ws://%s:%d', <kimi.web.host>, <kimi.web.port> );
<kimi.web.work_dir> //= <system.root_path>;

## connection state
<kimi.ws.connected> //= FALSE;
<kimi.ws.status>    //= qw| disconnected |;
<kimi.session_id>   //= undef;

## restore persisted session id from previous run
if ( not defined <kimi.session_id> ) {
    my $sref = <[file.zenka_dir.load]>->('session_id');
    if ( defined $sref and length $$sref ) {
        ( my $saved_id = $$sref ) =~ s{\s+$}{};
        if ( length $saved_id ) {
            <kimi.session_id> = $saved_id;
            <[base.logs]>->( 2, ': restored session id [ %s ]', $saved_id );
        }
    }
}

## wire protocol state
<kimi.wire.seq>     //= 0;
<kimi.wire.pending> //= {};    ## { $msg_id => { type, reply_id, params } }
<kimi.wire.accumulator>
    //= '';    ## response text accumulated across ContentParts

## session state
<kimi.session.acquired>
    //= FALSE;    ## true after first successful get_session_id

## task state [ models zenka dispatches via kimi.ask-reply, no polling needed ]
<kimi.task.active_id> //= undef;    ## task id currently being processed

## tool approval state
<kimi.approval.pending>      //= {};     ## { $request_id => { action, ... } }
<kimi.approval.auto_approve> //= TRUE;   ## auto-approve all [ task mode ]
<kimi.approval.auto_allow>   //= {};     ## policy allowlist { action => 1 }

## reconnect configuration [ exponential backoff ]
<kimi.connect.retry_delay> //= 60;       ## max retry delay cap [ seconds ]
<kimi.connect.retry_cur>   //= 2;        ## current delay [ reset on connect ]
<kimi.connect.retrying>    //= FALSE;

## schedule initial connection attempt after init completes
<[event.add_timer]>->(
    {   'after'   => 1.0,
        'handler' => qw| kimi.connect |,
        'desc'    => 'initial kimi-web websocket connection'
    }
);

<[base.logs]>->( 2, ': kimi-web client initialized :..' );

return TRUE;

