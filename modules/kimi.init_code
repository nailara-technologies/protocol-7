## [:< ##

# name  = kimi.init_code
# descr = initialize kimi-web zenka client state and schedule connection

map { <[base.perlmod.load]>->($ARG) }
    qw| JSON LWP::UserAgent Protocol::WebSocket::Frame
    IO::Socket::INET Protocol::WebSocket::Handshake::Client
    Errno Crypt::Misc IPC::Open2 |;

## kimi-web endpoint configuration
<kimi.web.host> //= qw| 127.0.0.1 |;
<kimi.web.port> //= 5494;
<kimi.web.base_url>
    //= sprintf( 'http://%s:%d', <kimi.web.host>, <kimi.web.port> );
<kimi.web.ws_base>
    //= sprintf( 'ws://%s:%d', <kimi.web.host>, <kimi.web.port> );
<kimi.web.work_dir> //= <system.root_path>;

## connection state
<kimi.ws.connected> //= FALSE;
<kimi.ws.status>    //= qw| disconnected |;
<kimi.session_id>   //= undef;

## restore persisted session id from previous run
if ( not defined <kimi.session_id> ) {
    my $sref = <[file.zenka_dir.load]>->('session_id');
    if ( defined $sref and length $$sref ) {
        ( my $saved_id = $$sref ) =~ s{\s+$}{};
        if ( length $saved_id ) {
            <kimi.session_id> = $saved_id;
            <[base.logs]>->( 2, ': restored session id [ %s ]', $saved_id );
        }
    }
}

## wire protocol state
<kimi.wire.seq>     //= 0;
<kimi.wire.pending> //= {};    ## { $msg_id => { type, reply_id, params } }
<kimi.wire.accumulator>
    //= '';    ## response text accumulated across ContentParts

## session state
<kimi.session.acquired>
    //= FALSE;    ## true after first successful get_session_id
<kimi.session.was_ready>
    //= FALSE;    ## true after session reaches ready — survives reconnect

## reconnect state
<kimi.reconnect.grace_timer> //= undef;    ## cancellable timer ref
<kimi.reconnect.timer>       //= undef;    ## reconnect attempt timer ref
<kimi.liveness.timer>        //= undef;    ## session liveness timer ref
<kimi.init.retry_timer>      //= undef;    ## init retry timer ref

## task queue state ##
<kimi.task.max_concurrent> //= 1;        ## start sequential, design for N
<kimi.task.active_id>      //= undef;    ## task id currently being processed
<kimi.task.queue>          //= {};       ## task_id => task hashref
<kimi.task.pending>        //= [];       ## task ids awaiting execution
<kimi.task.active>         //= [];       ## task ids in progress
<kimi.task.completed>      //= [];       ## task ids finished
<kimi.task.failed>         //= [];       ## task ids that failed

## tool approval state
<kimi.approval.pending>      //= {};     ## { $request_id => { action, ... } }
<kimi.approval.auto_approve> //= TRUE;   ## auto-approve all [ task mode ]
<kimi.approval.auto_allow>   //= {};     ## policy allowlist { action => 1 }
<kimi.approval.responded>    //= {};     ## { $request_id => 1 } dedup set

## restore responded set from previous run
if ( not keys %{<kimi.approval.responded>} ) {
    my $sref = <[file.zenka_dir.load]>->('approval_responded');
    if ( defined $sref and length $$sref ) {
        for my $line ( split m{\n}, $$sref ) {
            next unless length $line;
            <kimi.approval.responded>->{$line} = 1;
        }
        <[base.logs]>->(
            2,
            ': restored %d responded approval ids',
            scalar keys %{<kimi.approval.responded>}
        );
    }
}

## api child state [ persistent lightweight perl child for session api ]
<kimi.api_child.pid>  //= undef;
<kimi.api_child.r_fh> //= undef;
<kimi.api_child.w_fh> //= undef;

## reconnect configuration [ exponential backoff ]
<kimi.connect.retry_delay> //= 60;      ## max retry delay cap [ seconds ]
<kimi.connect.retry_cur>   //= 2;       ## current delay [ reset on connect ]
<kimi.connect.retrying>    //= FALSE;

## install variable watcher for websocket status state machine
<kimi.watcher.ws_status> = <[event.add_var]>->(
    {   'var'     => \<kimi.ws.status>,
        'poll'    => qw| w |,
        'repeat'  => TRUE,
        'handler' => qw| kimi.watcher.ws_status |,
        'desc'    => 'kimi websocket lifecycle state machine'
    }
);

## schedule kimi-web connection attempt after event loop starts
<[event.add_timer]>->(
    {   'after'   => 0.5,
        'handler' => qw| kimi.connect |,
        'desc'    => 'initial kimi-web websocket connection'
    }
);

<[base.logs]>->( 2, ': kimi-web client initialized :..' );

return TRUE;

