## [:< ##

# name = base.perlmod.install
# descr = Install CPAN modules and their debian package dependencies safely

my $module_name = shift;
my $cpanm_path  = <system.bin_path.cpanm>;
my $known_deps  = <[base.known_dependencies]>->{'perlmod'}->{$module_name}
    // {};

$module_name = $known_deps->{'cpan'}
    if defined $known_deps->{'cpan'}
    and $known_deps->{'cpan'} ne $module_name;

<[base.logs]>->( 2, ": installing perl module '%s' ...", $module_name );
<[base.buffer.add_line]>->( qw| perlmod-install |, sprintf 'installing: %s', $module_name );

## Detect privilege state for future zenka routing (Level 3) ##
my $lost_privileges = $UID != 0 && defined <system.zenka-user.current>;
if ($lost_privileges) {
    <[base.logs]>->( 2, ":  (running as unprivileged user '%s')", <system.zenka-user.current> );
    <[base.buffer.add_line]>->( qw| perlmod-install |,
        sprintf '  (unprivileged: %s)', <system.zenka-user.current> );
}

my $result = {
    success         => FALSE,
    module_name     => $module_name,
    installed_deb   => [],
    installed_cpan  => [],
    failed_deb      => [],
    failed_cpan     => [],
    error           => undef,
    lost_privileges => $lost_privileges,    ## flag for Level 3 zenka routing ##
};

## Detect OS distribution ##
<system.host.os.dist.name> //= qw| unknown |;
<system.host.os.dist.name> = qw| debian |
    if <system.host.os.dist.name> eq qw| unknown |
    and -f qw| /etc/os-release |
    and <[file.content]>->('/etc/os-release') =~ m|^ID(_LIKE)?=debian$|m;

my @cpan_list = ($module_name);
my @deb_list;

## Separate debian and cpan packages ##
if (    <system.host.os.dist.name> eq qw | debian |
    and defined $known_deps->{'debian'}
    and ref( $known_deps->{'debian'} ) eq qw| ARRAY |
    and $known_deps->{'debian'}->@* ) {
    @cpan_list = ();
    map {
        if ( $ARG =~ s|^cpan:|| ) {
            push @cpan_list, $ARG;
        } else {
            push @deb_list, $ARG;
        }
    } $known_deps->{'debian'}->@*;

    ## Install debian packages if available ##
    if (@deb_list) {
        my $deb_result = <[base.debian.install_package]>->(@deb_list);
        $result->{failed_deb} = \@deb_list if $deb_result;
        push @{ $result->{installed_deb} }, @deb_list if !$deb_result;
    }
}

## Install CPAN modules if needed ##
if (@cpan_list) {
    ## Ensure cpanm is available ##
    if ( not length $cpanm_path ) {
        <[base.logs]>->( 2, ": installing cpanminus ..." );

        my $cpanm_installed = <[base.perlmod.install_cpanm]>;
        if ( not $cpanm_installed ) {
            $result->{error} = 'failed to install cpanminus';
            <[base.logs]>->( 0, "  ✗ cannot proceed without cpanminus" );
            return $result;
        }
        $cpanm_path = <system.bin_path.cpanm>;
    }

    my $count = @cpan_list;
    my $s     = $count > 1 ? 's' : '';
    <[base.logs]>->( 2, ": installing %d CPAN module%s", $count, $s );

    ## Install each CPAN module via cpanm with safe subprocess handling ##
    foreach my $cpan_module (@cpan_list) {
        <[base.logs]>->( 2, ":  cpanm %s", $cpan_module );

        my $exit_code = <[base.perlmod.install_cpan_module]>->($cpan_module);

        if ( $exit_code == 0 ) {
            push @{ $result->{installed_cpan} }, $cpan_module;
        } else {
            push @{ $result->{failed_cpan} }, $cpan_module;
            <[base.logs]>->( 1, ":  ✗ failed to install %s", $cpan_module );
        }
    }
}

## Report final status ##
if ( !@{ $result->{failed_deb} } and !@{ $result->{failed_cpan} } ) {
    $result->{success} = TRUE;
    if ( @{ $result->{installed_deb} } or @{ $result->{installed_cpan} } ) {
        <[base.logs]>->( 1, ":. installation complete" );
        <[base.buffer.add_line]>->( qw| perlmod-install |, '✓ installation complete' );

        ## Update statistics ##
        <perlmod.install.stats>->{successful}++;
        <perlmod.install.stats>->{debian_pkgs} += scalar @{ $result->{installed_deb} };
        <perlmod.install.stats>->{cpan_mods} += scalar @{ $result->{installed_cpan} };
    }
} else {
    $result->{error} = 'some packages failed to install';
    <[base.logs]>->( 0, "  ✗ installation had failures" );
    <[base.buffer.add_line]>->( qw| perlmod-install |, '✗ installation had failures' );
    <perlmod.install.stats>->{failed}++;
}

<perlmod.install.stats>->{total_attempts}++;

return $result;

