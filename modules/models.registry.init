## [:< ##

# name = models.registry.init
# descr = Initialize registry data structures

use JSON::PP;
use File::Path qw| make_path |;

# Initialize registry cache in $data{models} namespace
$data{models} //= {};
$data{models}{registry} ||= {};

# Ensure registry directory exists
make_path('/var/protocol-7/models') unless -d '/var/protocol-7/models';

# Preload base helpers for faster access
my $base = <[models.registry.base]>;

# Entry point - just returns success
{   'success' => 1,
    'message' => 'registry initialized',
};

