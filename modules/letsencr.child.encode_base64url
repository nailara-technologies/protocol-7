# name  = letsencr.child.encode_base64url
# descr = URL-safe Base64 encoding for ACME protocol

use MIME::Base64 qw(encode_base64);

my $data = shift;

return undef unless defined $data;

## Standard base64 encode
my $b64 = encode_base64( $data, '' );    # no line breaks

## Convert to URL-safe: replace + with -, / with _, remove padding
$b64 =~ tr{+/}{-_};
$b64 =~ s|=+$||;

return $b64;

