# name = data.mount.shm.permission.verify.path_pattern_match
# descr = Match path against glob pattern

my ( $path, $pattern ) = @ARG;

$pattern =~ s{\*}{.*}g;
$pattern =~ s{\?}{.}g;

return $path =~ m{^$pattern$};

