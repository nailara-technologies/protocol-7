## [:< ##

# name = X-11.init_code

<[base.perlmod.autoload]>->('X11::WM');
<[base.perlmod.autoload]>->('IPC::Open3');
<[base.perlmod.autoload]>->('X11::Protocol');
<[base.perlmod.autoload]>->('X11::Keyboard');
<[base.perlmod.autoload]>->('Linux::Inotify2');
<[base.perlmod.autoload]>->('X11::Protocol::WM');
<[base.perlmod.autoload]>->('File::MimeInfo::Magic');
<[base.perlmod.autoload]>->('X11::Protocol::XSetRoot');

## trailing '-<digits>' [ e.g. 'xvfb-0000' ] is an instance index, not part ##
## of the mode name -- same convention as mpv's 'audio(?:-\d+)?' subnames. ##
## captured [ not discarded ] so the display-range calc in X-11.post_init ##
## can offset the configured per-mode base display by this instance's    ##
## index [ 'xvfb-0000' -> offset 0, 'xvfb-0001' -> offset 1, etc. ]       ##
my $modes_re = <X-11.modes_re>
    = qr{^(host|xnest|nxagent|xorg|xephyr|xvfb)(?:-(\d+))?$};

if ( defined <system.zenka.subname> ) {
    my $override_mode = <system.zenka.subname>;
    if ( $override_mode =~ $modes_re ) {
        my $base_mode = $1;
        <X-11.mode_index> = defined $2 ? int($2) : undef;
        <[base.logs]>->(
            0, "<< overriding X-11 zenka mode [ with '%s' ] >>", $base_mode
        );
        <X-11.mode> = $base_mode;
    } else {
        my $old_mode = <X-11.mode>;
        <[base.logs]>->(
            0,              "<< zenka mode \"%s\" not valid, keeping '%s' >>",
            $override_mode, $old_mode
        );
    }
}

foreach my $bin_name ( qw [
    Xorg
    Xvfb
    Xnest
    lspci
    Xephyr
    nxagent
    nvidia-smi
    ]
) {
    <X-11.bin_path>->{$bin_name} //= <[base.required_bin_path]>->($bin_name);
}

## optional intel gpu tools : silent lookup, not an error if absent
for my $bin_name (qw[ intel_gpu_top intel_gpu_frequency ]) {
    ( <X-11.bin_path>->{$bin_name} ) = <[file.which]>->($bin_name);
}

## dependency callbacks for per-display x11_display_flag objects ##
<[dependency.install_callbacks]>->('X-11');

## multi-server registry ##
<X-11.servers>         //= {};
<X-11.primary_display> //= undef;

## auto-detect gpu vendor
my $nvidia_bin = <X-11.bin_path>->{'nvidia-smi'};
my $intel_bin  = <X-11.bin_path>->{'intel_gpu_top'};

if ( -x $nvidia_bin ) {
    <X-11.gpu_vendor> //= 'nvidia';
    <[base.log]>->( 1, "gpu monitoring: nvidia [ nvidia-smi ]" );
} elsif ( -x $intel_bin ) {
    <X-11.gpu_vendor> //= 'intel';
    <[base.log]>->( 1, "gpu monitoring: intel [ intel_gpu_top ]" );
} else {
    <X-11.gpu_vendor> //= 'none';
    <[base.log]>->( 2, "gpu monitoring: no supported tool found" );
}

<[base.inotify.install_io_watcher]>;

if ( <X-11.mode> eq qw| auto-xephyr | ) { ## detect if Xorg running --> xephyr
    system('ps h -C Xorg 1>/dev/null 2>/dev/null');
    <X-11.mode> = $CHILD_ERROR == 256 ? qw| xorg | : qw| xephyr |;
    <[base.log]>->( 1, "[auto] switched to '<X-11.mode>'-mode.," );
}

<X-11.waiting>        //= {};
<X-11.bg_mode>        //= qw| cover |;
<X-11.video_driver>   //= <[X-11.get_video_driver]>;
<X-11.disable_glamor> //= 0;
<X-11.blank_timeout>  //= 60 * 13;    ## 13 minutes default timeout setting ##

<X-11.bg_gfx_directory>
    //= sprintf( '%s/data/gfx/backgrounds', <system.root_path> );

<X-11.bg_color> //= qw| 000000 |;
<X-11.bg_color> =~ s|^#?([0-9a-f]{6})$|#$1|i;

<X-11.keybd.grab_all_keys> //= qw| no |;
<X-11.max_intel_gpu_freq>  //= qw| no |;

<X-11.collect_intel_gpu_stats> //= FALSE;
<X-11.collect_gpu_stats>       //= <X-11.collect_intel_gpu_stats>;

<X-11.reconnect.enabled>       //= TRUE;
<X-11.reconnect.max_attempts>  //= 7;
<X-11.reconnect.initial_delay> //= 1;
<X-11.reconnect.max_delay>     //= 60;

<X-11.pool.enabled>       //= FALSE;    ## default off until verified ##
<X-11.pool.query_timeout> //= 2;        ## seconds ##
<X-11.pool.ping_timeout>  //= 1;        ## seconds ##

## silence bad-drawable protocol errors : dead window XIDs queried after  ##
## a zenka shuts down return false via eval [ X-11.cmd.get_geometry ],    ##
## this blacklist suppresses the warn log before it reaches process-x11-  ##
## error [ the $SIG{__WARN__} handler in bin/Protocol-7 checks this ]    ##
<sig_warn_blacklist.pattern> = qr{bad \d+ \(Drawable\)}i;

<[X-11.maximize_intel_gpu_frequency]>
    if <[base.cfg_bool]>->(<X-11.max_intel_gpu_freq>)
    and <X-11.mode> eq qw| xorg |
    and <X-11.video_driver> =~ m|^i\d\d\d$|;

0;

