## [:< ##

# name  = jobsite.handler.rescan-timer
# descr = periodic rescan timer : triggers fetch when idle

return if <jobsite.cycle> ne 'idle';

<[base.logs]>->( 1, 'rescan timer : starting fetch' );
<[jobsite.stage.fetch]>;

