## [:< ##

# name  = valued.resolve
# descr = compute effective priority of a node — returns refs + weight

my $id = shift // return undef;

my $node = <valued.index>->{$id};
if ( not defined $node ) {
    <[base.s_warn]>->( "valued node '%s' not found", $id );
    return undef;
}

return $node->{'refs'} + $node->{'weight'};

