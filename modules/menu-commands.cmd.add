## [:< ##

# name = menu-commands.cmd.add
# descr = Add a new menu command mapping

my $args = defined $$call{'args'} ? $$call{'args'} : '';
$args =~ s{^\s+|\s+$}{}g;

my @parts = split(/\s+/, $args, 4);

unless (@parts >= 3) {
    return {
        'mode' => qw| false |,
        'data' => 'Usage: add <mapping-id> <label> <command> [category]'
    };
}

my $mapping_id = $parts[0];
my $label = $parts[1];
my $command = $parts[2];
my $category = $parts[3];

# Validate mapping-id
unless ($mapping_id =~ /^[a-zA-Z0-9_-]+$/) {
    return {
        'mode' => qw| false |,
        'data' => 'Mapping ID must contain only alphanumeric characters, underscores, and dashes'
    };
}

# Check if mapping already exists
if (exists <menu-commands.mappings>->{$mapping_id}) {
    return {
        'mode' => qw| false |,
        'data' => 'Mapping already exists: ' . $mapping_id
    };
}

# Add to mappings hash
<menu-commands.mappings>->{$mapping_id} = {
    'label'    => $label,
    'command'  => $command,
    'category' => $category,
    'enabled'  => 1,
};

# Save to disk
<[menu-commands.save-state]>;

# Push update to protocol-7-menu
<[menu-commands.update-menu]>;

return {
    'mode' => qw| true |,
    'data' => 'Added mapping: ' . $mapping_id
};

