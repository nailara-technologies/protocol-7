## [:< ##

# name = menu-commands.update-menu
# descr = Push menu updates to protocol-7-menu zenka

<[base.perlmod.load]>->('JSON');

# Build items hash from current mappings
my $items = {};
foreach my $mapping_id (keys %{<menu-commands.mappings>}) {
    my $mapping = <menu-commands.mappings>->{$mapping_id};
    $items->{$mapping_id} = {
        'label'    => $mapping->{'label'} // 'Unnamed',
        'enabled'  => $mapping->{'enabled'} // 1,
        'action'   => $mapping->{'command'} // '',
    };
}

# Prepare provider data - only items for protocol-7-menu
my $provider_data = {
    'items' => $items,
};

# Convert to JSON for protocol-7-menu (menu-update expects JSON format)
my $json_data = JSON::encode_json($provider_data);

# Send update to protocol-7-menu via cube router
<[base.log]>->( 1, "sending menu update for %d items to protocol-7-menu", scalar(keys %{$items}) );

my $response = eval {
    <[base.protocol-7.command.send.local]>->({
        'command'   => 'cube.protocol-7-menu.menu-update',
        'call_args' => {
            'args' => "menu-commands " . $json_data
        }
    });
};
if ($EVAL_ERROR) {
    <[base.s_warn]>->('Failed to update protocol-7-menu (exception): %s', $EVAL_ERROR);
} elsif (!defined $response) {
    <[base.s_warn]>->('menu-update returned no response');
} elsif (ref($response) eq 'HASH') {
    if ($response->{'mode'} =~ /false|error/i) {
        <[base.s_warn]>->('menu-update failed: %s', $response->{'data'} // 'unknown error');
    } else {
        <[base.log]>->( 1, "menu-commands update pushed to protocol-7-menu (%d items)", scalar(keys %{$items}) );
    }
} else {
    <[base.log]>->( 1, "menu-update response: %s", ref($response) ? 'ref' : $response );
}

1;

