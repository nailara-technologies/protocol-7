## [:< ##

# name = menu-commands.update-menu
# descr = Notify protocol-7-menu of menu update (handler-based fetch pattern)

# Generate timestamp reference for this update
my $update_timestamp = <[base.ntime.b32]>;

my $item_count = scalar(keys %{<menu-commands.mappings>});

<[base.log]>->( 1, "notifying protocol-7-menu of %d menu items (ref: %s)", $item_count, $update_timestamp );

# Send notification to protocol-7-menu with:
# - provider name: menu-commands
# - reference: timestamp (allows protocol-7-menu to fetch when ready)
# - reply handler: protocol-7-menu will call get-provider-data to fetch the YAML
my $response = eval {
    <[base.protocol-7.command.send.local]>->({
        'command'   => 'cube.protocol-7-menu.menu-update-notify',
        'call_args' => {
            'args' => "menu-commands $update_timestamp"
        },
        'reply' => {
            'handler' => 'menu-commands.handler.menu-update-reply'
        }
    });
};

if ($EVAL_ERROR) {
    <[base.s_warn]>->('Failed to notify protocol-7-menu (exception): %s', $EVAL_ERROR);
} elsif (ref($response) eq 'HASH' && $response->{'mode'} =~ /false|error/i) {
    <[base.s_warn]>->('menu-update-notify failed: %s', $response->{'data'} // 'unknown error');
} elsif (ref($response) eq 'HASH') {
    <[base.log]>->( 2, "protocol-7-menu notified successfully" );
}

1;

