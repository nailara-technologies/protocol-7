## [:< ##

# name  = coding.cmd.tree-write
# param = <path> <value>
# descr = set scalar value in %data tree

my $args_str = $call->{'args'} // '';
my ( $path, $value ) = split m| |, $args_str, 2;

return { 'mode' => qw| false |, 'data' => 'expected: path value' }
    unless defined $path and length $path;
return { 'mode' => qw| false |, 'data' => 'expected value after path' }
    unless defined $value;

my $result = $code{'coding.tools.handler.tree_write'}
    ->( { 'path' => $path, 'value' => $value } );

return { 'mode' => qw| false |, 'data' => $result }
    if $result =~ m|^error:|;

return { 'mode' => qw| true |, 'data' => $result };

0;

