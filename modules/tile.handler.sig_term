## [:< ##

# name = tile.handler.sig_term

return
    if not defined <tile.current_tile_group>
    or !length(<tile.current_tile_group>);

my $file_name = 'tile-group.current';
my $cfg_file  = join( '/', <tile.cfg_directory>, $file_name );
<[base.log]>->( 1, "storing current tile group in '$file_name' config.," );

<[file.put]>->(
    $cfg_file,
    sprintf( "%.4f %s\n", <[base.time]>->(4), <tile.current_tile_group> )
);

