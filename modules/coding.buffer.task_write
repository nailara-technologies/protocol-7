## [:< ##

# name  = coding.buffer.task_write
# descr = write model interaction to per-task ring buffers
# param = task_id, content, type, opts_hashref
#
# types : assistant  — model text output
#         thinking   — reasoning_content trace
#         tool_call  — tool invocation with args summary
#         tool_result — tool output [ full only ]
#         system     — status / header lines
#
# writes to three buffers per task:
#   task-<id>          compact : assistant + tool summaries only
#   task-<id>-thinking compact + reasoning traces
#   task-<id>-full     all content including full tool outputs

my ( $task_id, $content, $type, $opts ) = @ARG;

return FALSE unless defined $task_id && length($task_id);
return FALSE unless defined $content && length($content);

$type //= 'assistant';
$opts //= {};

my $round  = $opts->{'round'} // '?';
my $pct    = $opts->{'pct'}   // 0;
my $name   = $opts->{'name'}  // '';    ## tool name for tool_call/result ##
my $size   = $opts->{'size'}  // 0;    ## result size for tool_result ##

my $buf_compact  = "task-$task_id";
my $buf_thinking = "task-$task_id-thinking";
my $buf_full     = "task-$task_id-full";

my $pct_tag = $pct ? " [CTX:${pct}%]" : '';

## initialize buffers on first write [ 256K each ] ##
for my $buf ( $buf_compact, $buf_thinking, $buf_full ) {
    <[base.buffer.add_line]>->( $buf, undef )
        unless defined $data{'buffer'}{$buf}{'data'};
}

## helper: append lines to a buffer ##
my $append = sub {
    my ( $buf, @lines ) = @ARG;
    <[base.buffer.add_line]>->( $buf, $_ ) for @lines;
};

## helper: box-format multi-line content ##
my $box = sub {
    my ( $label, $body, $pct_str ) = @ARG;
    $body //= '';
    $body =~ s|\r||g;
    my $header = sprintf '┌──[ %s | round %s%s ]%s',
        $label, $round, $pct_str // '', '─' x 30;
    my @lines = ( $header );
    push @lines, "│ $_" for split /\n/, $body;
    push @lines, '└' . '─' x 50;
    return @lines;
};

## helper: truncate long lines ##
my $trunc = sub {
    my ( $line, $max ) = @ARG;
    $max //= 200;
    return length($line) > $max ? substr( $line, 0, $max ) . '.,.' : $line;
};

if ( $type eq 'assistant' ) {
    my @lines = $box->( 'assistant', $content, $pct_tag );
    @lines = map { $trunc->($_) } @lines;
    $append->( $buf_compact,  @lines );
    $append->( $buf_thinking, @lines );
    $append->( $buf_full,     @lines );

} elsif ( $type eq 'thinking' ) {
    ## compact: one-line summary only ##
    my $chars   = length($content);
    my $preview = substr( $content, 0, 120 );
    $preview =~ s|\n| ↵ |g;
    my $summary = $trunc->( "│ [thinking $chars chars] $preview" );
    my $header  = sprintf '┌──[ thinking | round %s%s ]%s',
        $round, $pct_tag, '─' x 30;
    $append->( $buf_compact, $header, $summary, '└' . '─' x 50 );

    ## thinking + full: full reasoning box ##
    my @lines = $box->( 'thinking', $content, $pct_tag );
    @lines = map { $trunc->($_) } @lines;
    $append->( $buf_thinking, @lines );
    $append->( $buf_full,     @lines );

} elsif ( $type eq 'tool_call' ) {
    ## compact + thinking: summary line ##
    my $summary = sprintf '  → %s [ %s ]', $name,
        join( ', ',
        map  { "$_=$opts->{'args'}{$_}" }
        grep { defined $opts->{'args'}{$_} }
        sort keys %{ $opts->{'args'} // {} } );
    $summary = $trunc->($summary);
    $append->( $buf_compact,  $summary );
    $append->( $buf_thinking, $summary );

    ## full: include full args block ##
    my $args_str = '';
    if ( ref $opts->{'args'} eq 'HASH' ) {
        for my $k ( sort keys %{ $opts->{'args'} } ) {
            $args_str .= sprintf "    %s = %s\n", $k, $opts->{'args'}{$k} // '';
        }
    }
    $append->( $buf_full,
        sprintf( '  → %s(', $name ),
        split( /\n/, $args_str ),
        '  )' );

} elsif ( $type eq 'tool_result' ) {
    ## compact + thinking: size only ##
    my $summary = $trunc->(
        sprintf '  ← %s [ %d chars ]', $name, $size );
    $append->( $buf_compact,  $summary );
    $append->( $buf_thinking, $summary );

    ## full: full result box ##
    my @lines = $box->( "tool: $name", $content, '' );
    @lines = map { $trunc->($_) } @lines;
    $append->( $buf_full, @lines );

} elsif ( $type eq 'system' ) {
    my $line = $trunc->( "  · $content" );
    $append->( $buf_compact,  $line );
    $append->( $buf_thinking, $line );
    $append->( $buf_full,     $line );
}

return TRUE;

