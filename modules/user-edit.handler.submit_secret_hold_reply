## [:< ##

# name  = user-edit.handler.submit_secret_hold_reply
# descr = one masked field's sessions.hold reply, during a form submit.
#         deliberately SEPARATE from user-edit.handler.secret_hold_reply
#         -- that one is wired into the standalone test-secret-roundtrip
#         harness's own hold->release auto-chain; reusing it here would
#         wire a real submit's holds into that chain by accident.

my ($info) = @ARG;

my $field_name = ( $info->{'params'} // {} )->{'field_name'} // '?';
my $reply_data = $info->{'data'} // '';

## sessions.cmd.* uses mode=>size UNIFORMLY for success and failure --
## confirmed against every sessions.cmd.* file shipped this session, not
## mode=>false like users.cmd.* -- failure is the '<<' prefix, not 'cmd'
if ( $reply_data =~ m|^\s*<<| ) {
    <[user-edit.form.submit_note_secret_result]>->(
        $field_name, FALSE, $reply_data );
    return FALSE;
}

<[user-edit.form.submit_note_secret_result]>->( $field_name, TRUE, 'held' );

return TRUE;

