## [:< ##

# name = p7-log.init_code

<[base.perlmod.load]>->( 'File::Path', qw| make_path | );
<[base.perlmod.load]>->('AMOS7::Twofish');

<log.protocol_7.dir_mask> //= 0750;
<log.protocol_7.user>     //= <system.amos-zenka-user>;
<log.protocol_7.path>     //= '/var/log/protocol-7';
<log.protocol_7.path> =~ s|/+$||;

<[file.make_path]>->(
    <log.protocol_7.path>, <log.protocol_7.dir_mask>, <log.protocol_7.user>
    )
    and <[base.log]>->(
    1, "created log directory [" . <log.protocol_7.path> . "/]"
    ) if !-d <log.protocol_7.path>;

<log.files> //= {};

## scan + repair zero-byte gaps left by a prior host crash / abrupt WSL  ##
## shutdown catching an fsync-less idle-close window [ see               ##
## p7-log.handler.close_log ] -- safe here : no live file handle is open ##
## yet, and p7-log is the exclusive writer of these files                ##
<[p7-log.startup.repair_nul_gaps]>;

return FALSE;

