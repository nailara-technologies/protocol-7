## [:< ##

# name = io.ssl.ip.input.open
# descr = initialize accepted SSL client socket for input handling (called after accept)
# param = client socket returned from connect handler

my $client_sock = shift;

return undef if not defined $client_sock;

# Verify it's an SSL socket
if ( ref($client_sock) ne 'IO::Socket::SSL' ) {
    <[base.logs]>->(
        0,
        '[open] invalid socket type: expected IO::Socket::SSL, got %s',
        ref($client_sock)
    );
    return undef;
}

# SSL socket is ready for input - no special initialization needed beyond what accept() does
# The socket is already in SSL handshake state if we got here

<[base.logs]>->(
    2,
    '[open] SSL client socket opened, fd=%d, ready for input',
    fileno($client_sock)
);

return $client_sock;

0;

