## [:< ##

# name  = base.exit_when_empty
# descr = Exit zenka if first parameter is undef or empty, pass remaining parameters to base.exit

my $value = shift @ARG;

warn ": is returning : $value :";

if ( not defined $value or $value eq '' ) {
    ## First parameter is empty/undef, exit with error ##
    <[base.exit]>->(@ARG);
} else {
    ## First parameter has value, return it for continued processing ##
    return $value;
}

