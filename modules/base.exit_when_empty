## [:< ##

# name  = base.exit_when_empty
# descr = exit zenka if first parameter is undef or empty,
#         pass remaining parameters to base.exit

my $value = shift @ARG;

if ( not defined $value or $value eq '' ) {
    ## first parameter empty|undef, exit with error ##
    <[base.exit]>->(@ARG);
} else {
    ## first parameter has value, return it for continued processing.. ##
    return $value;
}

