## [:< ##
# name  = data.fuse.init_code.disabled
# descr = Initialize FUSE capabilities and check availability

my $fuse_available = 0;
my $fuse_error     = '';

## Check for Fuse.pm availability
eval {
    require Fuse;
    Fuse->import();
    $fuse_available = 1;
};

if ($@) {
    $fuse_error = $@;
    <[base.logs]>->( 1, "[FUSE] Fuse.pm not available: %s", $fuse_error );
} else {
    <[base.logs]>->( 2, "[FUSE] Fuse.pm loaded successfully" );
}

## Export capabilities
$data{'fuse'}{'capabilities'}{'available'} = $fuse_available ? 1 : 0;
$data{'fuse'}{'capabilities'}{'error'}   = $fuse_error if not $fuse_available;
$data{'fuse'}{'capabilities'}{'version'} = $Fuse::VERSION if $fuse_available;

## Initialize mount tracking
$data{'fuse'}{'mounts'}     //= {};
$data{'fuse'}{'mount_base'} //= '/tmp/amos-term-fuse';

## Ensure mount base directory exists
if ( not -d $data{'fuse'}{'mount_base'} ) {
    require File::Path;
    File::Path::make_path( $data{'fuse'}{'mount_base'}, { mode => 0755 } )
        or <[base.s_warn]>->( "Cannot create FUSE mount base: %s", $! );
}

## Register cleanup on shutdown
<[base.register_shutdown_handler]>->(
    'fuse.cleanup',
    sub {
        my @mounts = keys %{ $data{'fuse'}{'mounts'} };
        foreach my $mount_point (@mounts) {
            my $info = $data{'fuse'}{'mounts'}{$mount_point};
            if ( $info->{'pid'} ) {
                kill 'TERM', $info->{'pid'};
                <[base.logs]>->(
                    2,            "[FUSE] Unmounted %s (pid %d)",
                    $mount_point, $info->{'pid'}
                );
            }
        }
    }
);

return {
    'mode' => 'true',
    'data' => $fuse_available
    ? 'FUSE available'
    : 'FUSE not available: ' . $fuse_error
};

