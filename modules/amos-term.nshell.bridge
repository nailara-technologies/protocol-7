## [:< ##

# name  = amos-term.nshell.bridge
# descr = Bridge nshell to amos-term 3D buffer (generic attachment)

my ( $buffer_id, $nshell_state ) = @ARG;

$nshell_state //= <nshell.state>;

## === attach nshell to buffer === ##
my $attachment = <[amos-term.buffer-attach_generic]>->(
    $buffer_id,
    qw| nshell |,
    {   qw| cursor_x | => $nshell_state->{'cursor_x'} // 0,
        qw| cursor_y | => $nshell_state->{'cursor_y'} // 0,
        qw| cursor_z | => 0,      # nshell operates at Z=0 (surface)
        qw| write |    => TRUE,
        qw| read |     => TRUE,
        qw| data |     => {
            qw| nshell_state |     => $nshell_state,
            qw| on_buffer_change | =>
                qw| amos-term.handler.nshell-buffer-changed |,
        }
    }
);

return undef unless defined $attachment;

## === store attachment reference in nshell state === ##
$nshell_state->{'amos_term'} = {
    qw| attach_id | => $attachment->{'attach_id'},
    qw| buffer_id | => $buffer_id,
    qw| amos_id |   => $attachment->{'amos_id'},
    qw| attached |  => <[base.time]>->(3),
};

## === redirect nshell output to 3D buffer === ##
$nshell_state->{'output_handler'} = qw| amos-term.handler.nshell-output |;

<[base.logs]>->(
    2,
    "[nshell] bridged to amos-term buffer [%s]",
    $attachment->{'amos_id'}
);

return $attachment;

