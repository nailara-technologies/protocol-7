## [:< ##

# name  = amos-term.nshell.bridge
# descr = Bridge nshell to amos-term 3D buffer (generic attachment)

my ( $buffer_id, $nshell_state ) = @ARG;

$nshell_state //= <nshell.state>;

## === attach nshell to buffer === ##
my $attachment = <[amos-term.buffer.attach_generic]>->(
    $buffer_id,
    qw| nshell |,
    {   qw| cursor_x | => $nshell_state->{'cursor_x'} // 0,
        qw| cursor_y | => $nshell_state->{'cursor_y'} // 0,
        qw| cursor_z | => 0,      # nshell operates at Z=0 (surface)
        qw| write |    => TRUE,
        qw| read |     => TRUE,
        qw| data |     => {
            qw| nshell_state |     => $nshell_state,
            qw| on_buffer_change | => \&amos_term_nshell_buffer_changed,
        }
    }
);

return undef unless defined $attachment;

## === store attachment reference in nshell state === ##
$nshell_state->{'amos_term'} = {
    qw| attach_id | => $attachment->{'attach_id'},
    qw| buffer_id | => $buffer_id,
    qw| amos_id |   => $attachment->{'amos_id'},
    qw| attached |  => <[base.time]>->(3),
};

## === redirect nshell output to 3D buffer === ##
$nshell_state->{'output_handler'} = \&amos_term_nshell_output_handler;

<[base.logs]>->(
    2,
    "[nshell] bridged to amos-term buffer [%s]",
    $attachment->{'amos_id'}
);

return $attachment;

## === callback: output from nshell to 3D buffer === ##
sub amos_term_nshell_output_handler {
    my ( $text, $nshell_state ) = @ARG;

    my $amos = $nshell_state->{'amos_term'};
    return unless defined $amos;

    my $attach_id = $amos->{'attach_id'};
    my $attach    = <amos-term.buffer.attachments>->{$attach_id};
    return unless defined $attach;

    ## === write text to buffer at cursor position === ##
    my $cursor    = $attach->{'cursor'};
    my $window_id = $attach->{'buffer_id'};

    foreach my $char ( split //, $text ) {
        if ( $char eq "\n" ) {
            ## newline: shift Z (history) and reset X ##
            <[amos-term.buffer.shift_z]>->($window_id);
            $cursor->{'x'} = 0;
            $cursor->{'y'} = ( $cursor->{'y'} + 1 ) % 7;
        } else {
            ## write character ##
            <[amos-term.buffer.write]>->(
                $window_id,
                $cursor->{'x'},
                $cursor->{'y'},
                $cursor->{'z'},
                $char,
                4    # p7_fg_0004 color
            );
            $cursor->{'x'} = ( $cursor->{'x'} + 1 ) % 8;
        }
    }

    ## === trigger render update === ##
    my $window = <amos-term.windows.by_id>->{$window_id};
    if ( defined $window and $window->{'display'}->{'visible'} ) {
        $window->{'display'}->{'draw_area'}->queue_draw()
            if defined $window->{'display'}->{'draw_area'};
    }
}

## === callback: buffer changed by other client === ##
sub amos_term_nshell_buffer_changed {
    my ( $attach_id, $change_info ) = @ARG;

    ## nshell can choose to update display or ignore ##
    ## for now: log the change ##
    <[base.logs]>->(
        2,
        "[nshell] buffer changed by %s",
        $change_info->{'client_type'} // 'unknown'
    );
}

