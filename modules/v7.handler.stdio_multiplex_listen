## [:< ##

# name  = v7.handler.stdio_multiplex_listen
# descr = open the v7-side listener on /dev/shm/.7/STDIO/<zenka>
#         for any zenka that has opted in [ start config flag ]

my $requested_zenka = shift;

<v7.stdio_multiplex.listeners> //= {};

my $stdio_dir = qw|/dev/shm/.7/STDIO|;

<[file.make_path]>->( $stdio_dir, 0775, <system.amos-zenka-user> )
    if not -d $stdio_dir;

my $zenka_config = <v7.start_setup.zenki.config> // {};

my @zenki;
if ( defined $requested_zenka and length $requested_zenka ) {
    @zenki = ($requested_zenka);
} else {
    @zenki = keys %$zenka_config;
}

my @opened;
for my $zenka_name (@zenki) {
    my $config = $zenka_config->{$zenka_name};
    next if not defined $config;

    my $multiplex_flag = $config->{'stdio'}{'multiplex'} // '';
    next if not <[base.cfg_bool]>->($multiplex_flag);

    ## [ skip if listener already active for this zenka ] ##
    next
        if exists <v7.stdio_multiplex.listeners>->{$zenka_name}
        and defined <v7.stdio_multiplex.listeners>->{$zenka_name};

    my $socket_path = catfile( $stdio_dir, $zenka_name );

    my $on_record = sub {
        my ( $record, $socket ) = @ARG;
        <[v7.handler.stdio_multiplex_demux]>->(
            $record, $socket, $zenka_name
        );
    };

    my $listen_sock
        = <[base.stdio.transport.listen]>->( $socket_path, $on_record );

    if ( defined $listen_sock ) {
        <v7.stdio_multiplex.listeners>->{$zenka_name} = $listen_sock;
        push @opened, $zenka_name;
        <[base.logs]>->(
            2,           'stdio multiplex listener opened for %s [%s]',
            $zenka_name, $socket_path
        );
    } else {
        <[base.logs]>->(
            0,           'stdio multiplex listener failed for %s [%s]',
            $zenka_name, $socket_path
        );
    }
}

return \@opened;

