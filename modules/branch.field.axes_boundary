# name  = branch.field.axes_boundary
# descr = hashref of boundary per axis
# param = id
#
# returns { axis_name => boundary, ... }
# returns undef if branch not found

my ($id) = @ARG;

return undef
    if not defined $id
    or not exists $data{'branch.field'}{$id};

my $axes = $data{'branch.field'}{$id}{'axes'} // {};

my %bounds = map { $ARG => $axes->{$ARG}{'boundary'} // 0 } keys %$axes;

return \%bounds;

