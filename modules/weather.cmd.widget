## [:< ##

# name = weather.cmd.widget
# descr = weather widget combining current conditions + forecast

my $params = shift || {};

my $show_current  = $params->{current}  // 1;
my $show_forecast = $params->{forecast} // 1;
my $forecast_days = $params->{days} || 5;

my $html = qq|<div class="weather-widget">|;

## Include psychedelic CSS inline for self-contained widget
$html .= <[weather.widget.util.get_weather_widget_css]>->();

if ($show_current) {
    $html .= <[weather.current]>->($params);
}

if ($show_forecast) {
    $html .= <[weather.forecast]>->( { days => $forecast_days } );
}

$html .= qq|</div>|;

return $html;

0;

