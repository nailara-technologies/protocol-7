## [:< ##

# name = weather.cmd.widget
# descr = weather widget combining current conditions and forecast

my $params = shift || {};

my $show_current  = $params->{current}  // 1;
my $show_forecast = $params->{forecast} // 1;
my $forecast_days = $params->{days} || 5;

my $html = qq|<div class="weather-widget">|;

## Include psychedelic CSS inline for self-contained widget
$html .= _get_weather_widget_css();

if ($show_current) {
    $html .= <[weather.current]>->($params);
}

if ($show_forecast) {
    $html .= <[weather.forecast]>->( { days => $forecast_days } );
}

$html .= qq|</div>|;

return $html;

sub _get_weather_widget_css {
    return qq|
<style>
/* Weather Widget - Blacklight Psychedelic Styling */

.weather-widget {
    font-family: 'Courier New', monospace;
    background: linear-gradient(135deg, #000014 0%, #000a1f 50%, #001433 100%);
    border: 2px solid rgba(34, 211, 238, 0.3);
    border-radius: 12px;
    padding: 24px;
    margin: 20px 0;
    box-shadow: 0 0 20px rgba(34, 211, 238, 0.2),
                0 0 40px rgba(168, 139, 250, 0.1),
                inset 0 0 60px rgba(0, 20, 51, 0.8);
    animation: border-pulse 4s ease-in-out infinite;
}

@keyframes border-pulse {
    0%, 100% {
        border-color: rgba(34, 211, 238, 0.3);
        box-shadow: 0 0 20px rgba(34, 211, 238, 0.2),
                    0 0 40px rgba(168, 139, 250, 0.1),
                    inset 0 0 60px rgba(0, 20, 51, 0.8);
    }
    50% {
        border-color: rgba(168, 139, 250, 0.4);
        box-shadow: 0 0 30px rgba(34, 211, 238, 0.3),
                    0 0 50px rgba(168, 139, 250, 0.2),
                    inset 0 0 60px rgba(0, 20, 51, 0.8);
    }
}

/* Current Weather Section */
.weather-current {
    margin-bottom: 30px;
}

.weather-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(34, 211, 238, 0.2);
}

.weather-location {
    font-size: 24px;
    font-weight: bold;
    color: #22d3ee;
    text-shadow: 0 0 10px rgba(34, 211, 238, 0.6),
                 0 0 20px rgba(34, 211, 238, 0.3);
    animation: text-glow 3s ease-in-out infinite;
}

@keyframes text-glow {
    0%, 100% {
        text-shadow: 0 0 10px rgba(34, 211, 238, 0.6),
                     0 0 20px rgba(34, 211, 238, 0.3);
    }
    50% {
        text-shadow: 0 0 15px rgba(34, 211, 238, 0.8),
                     0 0 30px rgba(34, 211, 238, 0.4),
                     0 0 40px rgba(168, 139, 250, 0.3);
    }
}

.weather-updated {
    font-size: 12px;
    color: rgba(139, 192, 253, 0.6);
}

.weather-main {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

.temp-display {
    flex: 1;
}

.temp-value {
    font-size: 56px;
    font-weight: bold;
    color: #22d3ee;
    text-shadow: 0 0 20px rgba(34, 211, 238, 0.8),
                 0 0 40px rgba(34, 211, 238, 0.4);
    line-height: 1;
    margin-bottom: 8px;
}

.feels-like {
    font-size: 14px;
    color: rgba(139, 192, 253, 0.7);
    margin-bottom: 6px;
}

.weather-desc {
    font-size: 18px;
    color: #a78bfa;
    text-transform: capitalize;
    text-shadow: 0 0 10px rgba(167, 139, 250, 0.5);
}

.weather-icon-container {
    width: 120px;
    height: 120px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.weather-icon-glow {
    width: 80px;
    height: 80px;
    background: radial-gradient(circle, rgba(34, 211, 238, 0.4) 0%,
                                        rgba(168, 139, 250, 0.2) 50%,
                                        transparent 70%);
    border-radius: 50%;
    animation: icon-pulse 3s ease-in-out infinite;
}

@keyframes icon-pulse {
    0%, 100% {
        transform: scale(1);
        opacity: 0.8;
    }
    50% {
        transform: scale(1.2);
        opacity: 1;
    }
}

/* Weather Details */
.weather-details {
    background: rgba(0, 20, 51, 0.4);
    border: 1px solid rgba(34, 211, 238, 0.15);
    border-radius: 8px;
    padding: 16px;
}

.detail-row {
    display: flex;
    align-items: center;
    margin-bottom: 12px;
    gap: 12px;
}

.detail-row:last-child {
    margin-bottom: 0;
}

.detail-label {
    min-width: 100px;
    font-size: 14px;
    color: rgba(139, 192, 253, 0.8);
}

.detail-bar-container {
    flex: 1;
    height: 12px;
    background: rgba(0, 10, 31, 0.6);
    border: 1px solid rgba(34, 211, 238, 0.2);
    border-radius: 6px;
    overflow: hidden;
    position: relative;
}

.detail-bar {
    height: 100%;
    background: linear-gradient(90deg, #22d3ee 0%, #06b6d4 100%);
    box-shadow: 0 0 10px rgba(34, 211, 238, 0.6),
                inset 0 0 5px rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    transition: width 0.8s ease-out;
}

.detail-bar.humidity-bar {
    background: linear-gradient(90deg, #a78bfa 0%, #8b5cf6 100%);
    box-shadow: 0 0 10px rgba(167, 139, 250, 0.6),
                inset 0 0 5px rgba(255, 255, 255, 0.2);
}

.detail-value {
    min-width: 80px;
    text-align: right;
    font-size: 14px;
    font-weight: bold;
    color: #22d3ee;
    text-shadow: 0 0 8px rgba(34, 211, 238, 0.5);
}

/* Forecast Section */
.weather-forecast {
    margin-top: 30px;
    padding-top: 24px;
    border-top: 2px solid rgba(34, 211, 238, 0.2);
}

.forecast-header {
    font-size: 20px;
    font-weight: bold;
    color: #22d3ee;
    text-shadow: 0 0 10px rgba(34, 211, 238, 0.6);
    margin-bottom: 16px;
    text-align: center;
}

.forecast-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: 16px;
}

.forecast-day {
    background: rgba(0, 20, 51, 0.3);
    border: 1px solid rgba(34, 211, 238, 0.2);
    border-radius: 8px;
    padding: 12px;
    text-align: center;
    transition: all 0.3s ease;
}

.forecast-day:hover {
    background: rgba(0, 20, 51, 0.5);
    border-color: rgba(168, 139, 250, 0.4);
    box-shadow: 0 0 15px rgba(34, 211, 238, 0.3);
    transform: translateY(-2px);
}

.forecast-day-name {
    font-size: 16px;
    font-weight: bold;
    color: #a78bfa;
    text-shadow: 0 0 8px rgba(167, 139, 250, 0.5);
    margin-bottom: 8px;
}

.forecast-icon-container {
    width: 60px;
    height: 60px;
    margin: 8px auto;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.forecast-icon-glow {
    width: 40px;
    height: 40px;
    background: radial-gradient(circle, rgba(34, 211, 238, 0.3) 0%,
                                        rgba(168, 139, 250, 0.15) 50%,
                                        transparent 70%);
    border-radius: 50%;
}

.forecast-temps {
    font-size: 18px;
    font-weight: bold;
    margin: 8px 0;
}

.temp-max {
    color: #22d3ee;
    text-shadow: 0 0 8px rgba(34, 211, 238, 0.5);
}

.temp-separator {
    color: rgba(139, 192, 253, 0.4);
    margin: 0 4px;
}

.temp-min {
    color: rgba(139, 192, 253, 0.6);
}

.forecast-desc {
    font-size: 12px;
    color: rgba(139, 192, 253, 0.7);
    text-transform: capitalize;
    margin-bottom: 8px;
}

.forecast-clouds {
    height: 4px;
    background: rgba(0, 10, 31, 0.6);
    border-radius: 2px;
    overflow: hidden;
}

.clouds-bar-mini {
    height: 100%;
    background: linear-gradient(90deg, #a78bfa 0%, #8b5cf6 100%);
    box-shadow: 0 0 8px rgba(167, 139, 250, 0.6);
    border-radius: 2px;
}

/* Responsive design */
@media (max-width: 768px) {
    .weather-widget {
        padding: 16px;
    }

    .temp-value {
        font-size: 42px;
    }

    .forecast-grid {
        grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
        gap: 12px;
    }
}
</style>
|;
}

0;

