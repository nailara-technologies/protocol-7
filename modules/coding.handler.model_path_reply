## [:< ##

# name  = coding.handler.model_path_reply
# descr = handle async reply from models zenka with resolved model path
# note  = called when models.get_path_by_amos command response arrives

use YAML::XS qw| Load |;

my $reply         = shift;
my $model_amos_id = $reply->{'params'}->{'model_amos_id'} // '';

<[base.logs]>->(
    1, '[model_path_reply] received response for amos_id=%s',
    $model_amos_id
);

my $response_text = $reply->{'data'} // '';

<[base.logs]>->(
    2, '[model_path_reply] response data length=%d',
    length($response_text)
);

## check for error response (plaintext, starts with 'error:')
if ( $response_text =~ m|^error:| ) {
    my ($err_line) = split( m|\n|, $response_text );
    <[base.logs]>->(
        0, '[model_path_reply] model lookup failed: %s', $err_line
    );
    return FALSE;
}

## parse YAML response
my $entry;
eval { $entry = Load($response_text) };
if ( $EVAL_ERROR || !ref($entry) ) {
    <[base.logs]>->(
        0, '[model_path_reply] YAML parse failed: %s',
        <[base.str.eval_error]>
    );
    return FALSE;
}

my $model_path = $entry->{'file_path'} // '';

unless ( defined $model_path && length $model_path ) {
    <[base.logs]>->( 0, '[model_path_reply] no file_path in response' );
    return FALSE;
}

<[base.logs]>->( 1, '[model_path_reply] model path resolved' );
<[base.logs]>->(
    1, ':. %s', <[base.parser.ellipse_center]>->( $model_path, 60 )
);

<inference.model.path>        = $model_path;
<inference.model.mmproj_path> = $entry->{'mmproj_path'} // '';
<inference.model.is_vision>   = $entry->{'is_vision'}   // 0;

## re-trigger spawn if servers not yet running [ race with deferred timer ] ##
## also respawn if mmproj_path became available after initial spawn ##
my $gpu_pid       = <inference.gpu_pid> // 0;
my $needs_respawn = 0;
if ($gpu_pid) {
    my $server     = <coding.inference_servers>      // {};
    my $old_mmproj = $server->{'gpu'}{'mmproj_path'} // '';
    my $new_mmproj = <inference.model.mmproj_path>   // '';
    $needs_respawn = 1 if length($new_mmproj) && !length($old_mmproj);
}

if ( ( not $gpu_pid or $needs_respawn )
    and exists $code{'coding.async_spawn_inference_servers'} ) {
    <[base.logs]>->(
        1,
        '[model_path_reply] path resolved, triggering %sspawn',
        $needs_respawn ? 're-' : 'deferred '
    );
    $code{'coding.async_spawn_inference_servers'}->();

    ## cancel deferred spawn timer — we've already spawned, avoid duplicate ##
    if ( defined <coding.timer.spawn_servers> ) {
        eval { <coding.timer.spawn_servers>->cancel };
        <coding.timer.spawn_servers> = undef;
        <[base.logs]>->(
            2, '[model_path_reply] cancelled deferred spawn timer'
        );
    }
}

return TRUE;

