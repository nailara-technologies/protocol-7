## [:< ##

# name = plugin.web.content.util.format_size
# descr = format bytes to human-readable string

my $bytes = shift;

return '0 B' if $bytes == 0;

my @units = qw( B KB MB GB TB );
my $unit  = 0;
my $size  = $bytes;

while ( $size >= 1024 and $unit < @units - 1 ) {
    $size /= 1024;
    $unit++;
}

return sprintf( '%.1f %s', $size, $units[$unit] );

