# name = coding.helper.category_mapper
# descr = map task types to execution categories

my $type = shift @ARG // qw| analysis |;

my $categories = {
    'analysis'         => qw| reasoning |,
    'reasoning'        => qw| reasoning |,
    'transcription'    => qw|  sensory  |,
    'brainstorming'    => qw| reasoning |,
    'code-generation'  => qw| execution |,
    'image-generation' => qw|  sensory  |
};

return $categories->{$type} // qw| other |;

