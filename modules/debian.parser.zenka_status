## [:< ##

# name  = debian.parser.zenka_status
# descr = Format zenka dependency status for display

my $status = shift;

return
      $status eq 'complete' ? '✓'
    : $status eq 'partial'  ? '⚠'
    : $status eq 'missing'  ? '✗'
    :                         $status;

0;

