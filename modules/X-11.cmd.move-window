## [:< ##

# name  = X-11.cmd.move-window
# descr = move an x11 window to an absolute or relative position
# param = <win_id> <pos-change>
#
## pos-change : <x> <y>      — absolute positional
## pos-change : +<dx> -<dy>  — relative positional [ sign = relative ]
## pos-change : x<v> y<v>    — labeled [ one or both axes; sign = relative ]

my @parts
    = ref( $call->{'args'} ) eq qw| ARRAY |
    ? $call->{'args'}->@*
    : split( m| +|, $call->{'args'} // '' );

my $window_id = shift @parts;

return { 'mode' => qw| false |, 'data' => 'expected : <id> <x> <y>' }
    if not defined $window_id or not @parts;

return { 'mode' => qw| false |, 'data' => 'invalid window id' }
    if $window_id !~ m|^\d+$|;

my ( $xarg, $yarg );

## labeled args : x<val> or y<val> [with optional sign] ##
if ( grep {m|^[xy][+-]?\d+$|} @parts ) {
    for my $a (@parts) {
        $xarg = $1 if $a =~ m|^x([+-]?\d+)$|;
        $yarg = $1 if $a =~ m|^y([+-]?\d+)$|;
    }
} else {
    ## positional : both x and y required ##
    ( $xarg, $yarg ) = @parts;
    return {
        'mode' => qw| false |,
        'data' => 'positional mode requires both x and y'
        }
        if not defined $xarg or not defined $yarg;
}

for my $pair ( [ x => $xarg ], [ y => $yarg ] ) {
    my ( $axis, $val ) = @$pair;
    next unless defined $val;
    return { 'mode' => qw| false |, 'data' => "invalid $axis value" }
        if $val !~ m|^[+-]?\d+$|;
}

my $X = <X-11.obj>;
return { 'mode' => qw| false |, 'data' => 'X-11 connection not available' }
    if not defined $X;

## window may still be unmapped/unrealized under weston/wslg - actualize  ##
## before touching it, same as X-11.cmd.set_geometry / window_id_found    ##
<[X-11.WM.update]>;

## fetch current geometry if any axis needs a relative delta ##
my $need_geom = ( defined $xarg and $xarg =~ m|^[+-]| )
    || ( defined $yarg and $yarg =~ m|^[+-]| );

my %cur;
if ($need_geom) {
    %cur = eval { $X->GetGeometry( $window_id + 0 ) };
    if ( $EVAL_ERROR or not exists $cur{'x'} ) {
        <[base.logs]>->(
            1,          '[move-window] GetGeometry id=%s : %s',
            $window_id, <[base.str.eval_error]>
        );
        return { 'mode' => qw| false |, 'data' => 'GetGeometry failed' };
    }
}

my %configure;
if ( defined $xarg ) {
    $configure{'x'}
        = $xarg =~ m|^[+-]| ? $cur{'x'} + ( $xarg + 0 ) : $xarg + 0;
}
if ( defined $yarg ) {
    $configure{'y'}
        = $yarg =~ m|^[+-]| ? $cur{'y'} + ( $yarg + 0 ) : $yarg + 0;
}

eval { $X->ConfigureWindow( $window_id + 0, %configure ) };

if ( length $EVAL_ERROR ) {
    <[base.logs]>->(
        1,          '[move-window] ConfigureWindow id=%s : %s',
        $window_id, <[base.str.eval_error]>
    );
    return { 'mode' => qw| false |, 'data' => 'ConfigureWindow failed' };
}

## push the new position through to the wm/compositor - see set_geometry ##
<[X-11.WM.update]>;

my $pos_str = join ' ', map {"$_=$configure{$_}"} sort keys %configure;
<[base.logs]>->( 2, '[move-window] id=%s %s', $window_id, $pos_str );
return { 'mode' => qw| true |, 'data' => $pos_str };

