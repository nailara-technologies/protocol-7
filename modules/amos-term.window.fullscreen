## [:< ##

# name  = amos-term.window.fullscreen
# descr = Toggle fullscreen mode for GTK3 window

my ( $window_id, $enable ) = @ARG;
$enable //= TRUE;

my $window = <amos-term.windows.by_id>->{$window_id};
return undef unless defined $window;

my $gtk_win = $window->{'display'}->{'gtk_window'};
return undef unless defined $gtk_win;

if ($enable) {
    $gtk_win->fullscreen();
    $window->{'state'} = 3;    # fullscreen state
} else {
    $gtk_win->unfullscreen();
    $window->{'state'} = 1;    # normal state
}

$window->{'display'}->{'fullscreen'} = $enable;

return $window_id;

