# name  = coding.callback.object_memory_system
# descr = Dependency callback to check system RAM availability

my $object_id = shift;
return undef unless exists <dependency.object>->{$object_id};

my $object = <dependency.object>->{$object_id};

## bypass ram check if any inference server is already running [ ram already committed ] ##
my $servers = <coding.inference_servers> // {};
for my $backend ( keys $servers->%* ) {
    if ( ( $servers->{$backend}->{'status'} // '' ) eq 'ready' ) {
        <[base.logs]>->(
            3, '[memory_system] %s server already ready, bypassing ram check',
            $backend
        );
        return TRUE;
    }
}

## Get configured threshold (default: 4GB free RAM) ##
my $min_free_mb = $object->{'min_free_mb'} // 4096;

## Read system memory info from /proc/meminfo ##
my ( $mem_total, $mem_available );
if ( open my $fh, '<', '/proc/meminfo' ) {
    while (<$fh>) {
        if (/^MemTotal:\s+(\d+)/) {
            $mem_total = $1;
        } elsif (/^MemAvailable:\s+(\d+)/) {
            $mem_available = $1;
            last;    ## MemAvailable comes after MemTotal ##
        }
    }
    close $fh;
}

unless ( defined $mem_available && defined $mem_total ) {
    <[base.logs]>->( 2, '[memory_system] cannot read /proc/meminfo' );
    return FALSE;
}

## Convert to MB ##
my $free_mb  = int( $mem_available / 1024 );
my $total_mb = int( $mem_total / 1024 );

## Check against threshold ##
if ( $free_mb >= $min_free_mb ) {
    <[base.logs]>->(
        3,        '[memory_system] OK: %d MB free (threshold: %d MB)',
        $free_mb, $min_free_mb
    );
    return TRUE;
} else {
    <[base.logs]>->(
        1,        '[memory_system] LOW: %d MB free (threshold: %d MB)',
        $free_mb, $min_free_mb
    );
    return FALSE;
}

