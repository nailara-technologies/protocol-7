## [:< ##

# name  = workspace-transfer.console.todo-commit
# descr = add todo and auto-commit/push (Protocol-7 styled console output)

## Protocol-7 color scheme ##
my $reset      = "\e[0m";
my $nailara_bg = "\e[48;2;9;5;42m";
my $blacklight = "\e[38;2;68;39;172m";
my $TRUE_blue  = "\e[38;2;6;71;195m";
my $neon_orange = "\e[38;2;197;141;7m";
my $neon_green = "\e[38;2;71;195;6m";
my $neon_red   = "\e[38;2;195;6;71m";

my @args = @_;
die "Usage: todo-commit <description>\n" unless @args;

my $ws_dir = workspace_transfer::chdir_workspace();
<[base.exit]>->(qw| 0110 |) unless defined $ws_dir;

# Add the todo using workspace-transfer.console.todo
say "";
say "$blacklight .:[ ${TRUE_blue}TODO COMMIT${blacklight} ]:.$reset";
say "";

<[workspace-transfer.console.todo]>->('add', @args);

# Get current branch
my $branch = `git branch --show-current`;
chomp $branch;

# Check if TODO.md changed
my $status = `git status --short TODO.md`;
if ($status =~ /TODO\.md/) {
    say "${TRUE_blue}📝 Committing TODO.md...$reset";

    system('git', 'add', 'TODO.md') == 0 or do {
        <[base.logs]>->( 0, 'git add failed' );
        <[base.exit]>->(qw| 0110 |);
    };

    my $desc = join(' ', @args);
    my $commit_msg = "todo: Add - $desc";
    system('git', 'commit', '--no-gpg-sign', '-m', $commit_msg) == 0 or do {
        <[base.logs]>->( 0, 'git commit failed' );
        <[base.exit]>->(qw| 0110 |);
    };

    say "${TRUE_blue}🚀 Pushing to GitHub...$reset";
    my $result = system('git', 'push', '-u', 'origin', $branch);

    say "";
    if ($result == 0) {
        say "$neon_green✓$reset ${neon_green}Todo added, committed, and pushed to GitHub!$reset";
    } else {
        say "$neon_orange⚠$reset Todo added and committed, but push failed.";
        say "  ${blacklight}You may need to configure GitHub PAT.$reset";
        say sprintf "  ${blacklight}Run: ${TRUE_blue}git push -u origin %s$reset", $branch;
    }
    say "";
} else {
    say "$neon_green✓$reset ${neon_green}Todo added (no changes to commit)$reset";
    say "";
}

