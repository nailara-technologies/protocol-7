# name  = httpd.vhost.read_manifests
# descr = scan data/web-root/vhosts/ for .vhost-manifest files

my $vhosts_dir = <httpd.vhosts.source_dir>;
$vhosts_dir = <system.root_path> . "/$vhosts_dir"
    if defined <system.root_path> and $vhosts_dir !~ m|^/|;

<[base.logs]>->(
    1, 'vhost source dir: %s [ exists: %s ]',
    $vhosts_dir, ( -d $vhosts_dir ? 'yes' : 'no' )
);

unless ( -d $vhosts_dir ) {
    <[base.logs]>->( 1, 'vhost source dir not found: %s', $vhosts_dir );
    return [];
}

<[base.perlmod.autoload]>->('YAML::XS');

my $dir_fh;
if ( not opendir( $dir_fh, $vhosts_dir ) ) {
    <[base.logs]>->(
        1, 'cannot open vhost source dir [ %s ]',
        <[base.str.os_err]>
    );
    return [];
}

my @hostnames_found;

foreach my $entry ( <[base.sort]>->( readdir $dir_fh ) ) {
    next if $entry =~ m|^\.|;
    my $vhost_path = "$vhosts_dir/$entry";
    next unless -d $vhost_path;

    my $manifest_path = "$vhost_path/.vhost-manifest";
    next unless -f $manifest_path;

    my $manifest_yaml = do {
        local $INPUT_RECORD_SEPARATOR = undef;
        my $fh;
        open( $fh, '<', $manifest_path ) or do {
            <[base.logs]>->(
                1,              'cannot open manifest %s [ %s ]',
                $manifest_path, $OS_ERROR
            );
            next;
        };
        my $content = <$fh>;
        close $fh;
        $content;
    };

    my $manifest = eval { YAML::XS::Load($manifest_yaml) };
    if ( $EVAL_ERROR or not defined $manifest or ref $manifest ne 'HASH' ) {
        <[base.logs]>->(
            1,      'failed to parse manifest for %s [ %s ]',
            $entry, $EVAL_ERROR // qw| unknown error |
        );
        next;
    }

    my $hostname = $manifest->{'hostname'} // $entry;

    <httpd.vhosts.registry>->{$hostname} = {
        'manifest'      => $manifest,
        'source_path'   => $vhost_path,
        'hostname'      => $hostname,
        'discovered_at' => <[base.time]>->(3)
    };

    push @hostnames_found, $hostname;
}

closedir($dir_fh);

<[base.logs]>->(
    2,
    'found %d vhost manifest%s',
    scalar @hostnames_found,
    <[base.cnt_s]>->( scalar @hostnames_found )
);

return \@hostnames_found;

