## [:< ##

# name  = nameserv.cmd.show-zone
# descr = display all records in a zone

my $args_str = $call->{'args'} // '';

## parse args: zone=<zone>
## or positional: <zone>
my %args;
if ( $args_str =~ /=/ ) {
    while ( $args_str =~ /(\w+)=(\S+)/g ) {
        $args{$1} = $2;
    }
} else {
    my @parts = split /\s+/, $args_str;
    $args{'zone'} = $parts[0] if @parts;
}

my $zone_name = lc( $args{'zone'} // '' );

if ( not $zone_name ) {
    return { mode => 'false', data => 'usage: show-zone zone=<zone>' };
}

my $zones = <nameserv.zones>;

if ( not exists $zones->{$zone_name} ) {
    return { mode => 'false', data => "zone not found: $zone_name" };
}

my $zone  = $zones->{$zone_name};
my @lines = (
    sprintf( "zone: %s",     $zone_name ),
    sprintf( "  serial: %d", $zone->{'serial'} ),
    sprintf( "  ttl: %d",    $zone->{'ttl'} ),
    sprintf("  records:"),
);

for my $rec ( @{ $zone->{'records'} } ) {
    push @lines,
        sprintf( "    %s %s %s",
        $rec->{'name'}, $rec->{'type'}, $rec->{'value'} );
}

return { mode => 'size', data => join( "\n", @lines ) };

