## [:< ##

# name  = letsencr.parent.init_code
# descr = initialize parent process for Let's Encrypt ACME operations - manages state, cache, and renewal scheduling

<[base.log]>->( 2, "initializing Let's Encrypt ACME parent process..," );

## letsencr.base is already loaded and initialized by zenka startup
## No need to reload/reinitialize here

## Initialize parent-side certificate registry and cache
<letsencr.parent.certs>              = {};
<letsencr.parent.acme_account>       = {};
<letsencr.parent.renewal_timers>     = {};
<letsencr.parent.pending_challenges> = {};

## Load stored certificates from disk into memory registry
my $load_result = <[letsencr.parent.load_certificate_registry]>;
if ( $load_result && $load_result->{status} eq 'success' ) {
    <[base.log]>->(
        2, 'loaded ' . $load_result->{loaded} . ' certificates from disk'
    );
} elsif ( $load_result && $load_result->{status} eq 'partial' ) {
    <[base.log]>->(
        1, 'warning: partial certificate load - ' . $load_result->{error_msg}
    );
} else {
    <[base.log]>->(
        1, 'warning: no stored certificates found on disk (first run)'
    );
}

## Initialize renewal check timer using event system
## Fires every <letsencr.renewal.check-interval> seconds (86400 = 24 hours)
<letsencr.parent.renewal_check_timer> = <[event.add_timer]>->(
    {   'interval' => <letsencr.renewal.check-interval>,
        'handler'  => qw| letsencr.parent.handler_renewal_check |,
        'repeat'   => 1,
        'data'     => {},
    }
);

## Initialize rate limiter for ACME requests
<letsencr.parent.ratelimit> = {
    enabled  => <letsencr.ratelimit.enabled>      // 1,
    max_hour => <letsencr.ratelimit.max-per-hour> // 5,
    history  => [],    # timestamps of recent requests
};

## Initialize event handlers for child-to-parent communication
<letsencr.parent.handlers> = {
    'cert_ready'       => 'letsencr.parent.handler_cert_ready',
    'challenge_needed' => 'letsencr.parent.handler_challenge_needed',
    'renewal_failed'   => 'letsencr.parent.handler_renewal_failed',
    'acme_status'      => 'letsencr.parent.handler_acme_status',
    'child_ready'      => 'letsencr.parent.handler_child_ready',
};

## NOTE: Message handler is registered by fork_letsencr_child via base.handler.command
## Child-to-parent communication uses Protocol-7's command protocol (TRUE/FALSE replies)
## Do NOT register custom handler here - base.handler.command is already set up by fork

## Initialize visibility lists for monitoring
<list.certificates> = {
    qw| var |   => qw| data |,
    qw| key |   => qw| letsencr.parent.certs |,
    qw| descr | => 'Installed SSL certificates and expiration status',
    qw| mask |  => '<key>:domain issued_at expires_at status',
    qw| align | => {
        qw| domain |     => qw| left+2 |,
        qw| issued_at |  => qw| center-1 |,
        qw| expires_at | => qw| center-1 |,
        qw| status |     => qw| center-1 |
    },
    qw| filters | => {
        qw| issued_at |  => qw| base.parser.timestamp |,
        qw| expires_at | => qw| base.parser.timestamp |
    }
};

<list.renewals> = {
    qw| var |   => qw| data |,
    qw| key |   => qw| letsencr.parent.renewal_timers |,
    qw| descr | => 'Active certificate renewal operations',
    qw| mask |  => '<key>:domain started attempts status',
    qw| align | => {
        qw| domain |   => qw| left+2 |,
        qw| started |  => qw| center-1 |,
        qw| attempts | => qw| right-1 |,
        qw| status |   => qw| center-1 |
    },
    qw| filters | => { qw| started | => qw| base.parser.timestamp | }
};

<list.challenges> = {
    qw| var |   => qw| data |,
    qw| key |   => qw| letsencr.parent.pending_challenges |,
    qw| descr | => 'Pending ACME challenge validations',
    qw| mask |  => '<key>:domain type status created_at expires_at',
    qw| align | => {
        qw| domain |     => qw| left+2 |,
        qw| type |       => qw| center-1 |,
        qw| status |     => qw| center-1 |,
        qw| created_at | => qw| center-1 |,
        qw| expires_at | => qw| center-1 |
    },
    qw| filters | => {
        qw| created_at | => qw| base.parser.timestamp |,
        qw| expires_at | => qw| base.parser.timestamp |
    }
};

## Initialize ACME activity buffer
if ( not exists <buffer.acme-activity> ) {
    <buffer.acme-activity.max_size> = 100 * 1024;    ## 100K buffer size ##
    my $log_level  = 2;
    my $log_msg    = 'ACME activity buffer initialized ..,';
    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
    <[base.buffer.add_line]>->(
        qw| acme-activity |,
        join( ' ', $time_stamp, $log_level, $log_msg ), $log_level
    );
}

<[base.log]>->( 2, "Let's Encrypt parent process initialization complete" );
<[base.logs]>->( 2, ': Certificate cache : %s', <letsencr.cache.dir> );
<[base.logs]>->(
    2,
    '  Renewal check interval: %d seconds',
    <letsencr.renewal.check-interval>
);
<[base.log]>->( 2, '  Activity logging: enabled [ acme-activity buffer ]' );

## Mark parent as fully initialized [ child is ready via IPC pipe ]
<letsencr.parent.initialized> = 1;

0;

