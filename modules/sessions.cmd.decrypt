## [:< ##

# name  = sessions.cmd.decrypt
# descr = decrypt a console-supplied base32 blob
#         [ from sessions.cmd.encrypt's output ], via the live child
# param = <blob_b32>

my $blob_b32 = $call->{'args'} // '';
$blob_b32 =~ s/^\s+|\s+$//g;
my $blob = eval { decode_b32r($blob_b32) };

return { 'mode' => qw| size |, 'data' => "<< invalid base32 input >>\n" }
    if not defined $blob;

my $result = <[sessions.holder.parent]>->( qw| DECRYPT |, $blob );

return { 'mode' => qw| size |, 'data' => "<< decrypt failed >>\n" }
    if not defined $result;

return { 'mode' => qw| size |, 'data' => sprintf( "%s\n", $result ) };

