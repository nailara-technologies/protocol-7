# name = lm-vision.fetch_model_config
# descr = Handle async response from models.get_model_path for vision config

<[base.perlmod.autoload]>->(qw| JSON::PP |);

my $reply = shift;

# Extract response data from reply
my $response_data = $reply->{'data'} // '';

<[base.logs]>->(
    1, "[lm-vision] fetch_model_config: received %d bytes",
    length($response_data)
);

# Parse model configuration from response
if ( $response_data && length($response_data) > 0 ) {
    my $model_data;
    eval { $model_data = JSON::PP::decode_json($response_data); };

    if ( $model_data && ref($model_data) eq 'HASH' ) {
        my $model_path  = $model_data->{path};
        my $mmproj_path = $model_data->{mmproj};

        if ( -f $model_path && -f $mmproj_path ) {
            <lm-vision.vision_model_path>  = $model_path;
            <lm-vision.vision_mmproj_path> = $mmproj_path;

            <[base.log]>->(
                1, "[lm-vision] Vision model loaded: %s", $model_path
            );
            <[base.log]>->(
                1, "[lm-vision] Multimodal proj: %s", $mmproj_path
            );

            return 1;
        } else {
            <[base.log]>->( 0, "[lm-vision] Error : Model files not found" );
        }
    } else {
        <[base.log]>->(
            0, "[lm-vision] Error: Failed to parse model configuration JSON"
        );
    }
} else {
    <[base.log]>->(
        0,
        "[lm-vision] Error: Empty or missing response data from models zenka"
    );
}

return 0;

