## [:< ##

# name = lm-vision.fetch_model_config
# descr = handle async response from models.get_model_path for vision config

use YAML::XS qw| Load |;

my $reply = shift;

my $response_data = $reply->{'data'} // '';

<[base.logs]>->(
    1, '[lm-vision] fetch_model_config: received %d bytes',
    length($response_data)
);

## check for error response
if ( $response_data =~ m|^error:| ) {
    my ($err_line) = split( m|\n|, $response_data );
    <[base.logs]>->(
        0, '[lm-vision] fetch_model_config error: %s', $err_line
    );
    return 0;
}

## parse YAML response
my $model_data;
eval { $model_data = Load($response_data) };
if ( $EVAL_ERROR || !ref($model_data) ) {
    <[base.log]>->( 0, '[lm-vision] failed to parse model config YAML' );
    return 0;
}

my $model_path  = $model_data->{'file_path'}   // '';
my $mmproj_path = $model_data->{'mmproj_path'} // '';

## for vision models, mmproj is required; for non-vision it may be empty
my $is_vision = $model_data->{'is_vision'} // 0;
if ( $is_vision && !-f $mmproj_path ) {
    <[base.logs]>->(
        0, '[lm-vision] mmproj file not found: %s', $mmproj_path
    );
    return 0;
}

unless ( -f $model_path ) {
    <[base.logs]>->( 0, '[lm-vision] model file not found: %s', $model_path );
    return 0;
}

<lm-vision.vision_model_path>  = $model_path;
<lm-vision.vision_mmproj_path> = $mmproj_path;

<[base.logs]>->( 1, '[lm-vision] vision model loaded: %s', $model_path );
<[base.logs]>->( 1, '[lm-vision] multimodal proj: %s',     $mmproj_path )
    if length $mmproj_path;

return 1;

