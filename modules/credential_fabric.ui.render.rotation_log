## [:< ##

# name  = credential_fabric.ui.render.rotation_log
# descr = render the rotation log frame

my $params = shift // {};

my $entry = <[ascii.frame.load]>->('credential-fabric/rotation-log');
return '' if not defined $entry;

my $data = <[credential_fabric.ui.query.rotation_log]>->();

my $descriptor;
if ( exists $entry->{'descriptor'} ) {
    $descriptor = $entry->{'descriptor'};
} elsif ( exists $entry->{'descriptors'} ) {
    my $mode = $entry->{'modes'}[0] // 'expanded';
    $descriptor = $entry->{'descriptors'}{$mode};
}
return '' if not defined $descriptor;

my $rotations = $data->{'rotations'} // [];
my $count     = scalar @$rotations;

my @lines;
for my $r (@$rotations) {
    push @lines,
        sprintf( '%s  %s  by:%s  result:%s',
        $r->{'ntime_b32'}, $r->{'slot'}, $r->{'actor'}, $r->{'result'} );
}

my $block = @lines ? join( "\n", @lines ) : '';

my %values = (
    LOG_COUNT       => $count,
    ROTATIONS_BLOCK => $block,
);

my $rendered = <[ascii.frame.render]>->(
    {   descriptor => $descriptor,
        values     => \%values,
    }
);

return $rendered // '';

