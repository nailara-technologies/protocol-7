# name  = select.region.apply_geometry
# descr = apply current geometry to selection window and per-instance state

my ( $id, $window, $geometry ) = @ARG;

return undef if not defined $id;
return undef if not defined $window;
return undef if not defined $geometry;

<[window.gtk.profile.apply]>->( $window, $geometry );

<[select.region.update_x11_state]>->( $id, $geometry );

return TRUE;

