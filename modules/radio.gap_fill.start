## [:< ##

# name  = radio.gap_fill.start
# descr = pick a random keep-library file and start idle-watcher relay

my $dir = <radio.keep_library.path> // '';

if ( not -d $dir ) {
    <[base.logs]>->( 2, '[radio] gap filler: no keep-library files' );
    return;
}

my @files = glob("$dir/*.mp3");
if ( not @files ) {
    <[base.logs]>->( 2, '[radio] gap filler: no keep-library files' );
    return;
}

<[base.perlmod.autoload]>->( 'List::Util', qw| shuffle | );

my ($chosen) = shuffle(@files);

open( my $fh, '<:raw', $chosen )
    or return
    <[base.logs]>->( 1, '[radio] gap filler: open failed: %s', $chosen );

<radio.gap_fill.fh>     = $fh;
<radio.gap_fill.active> = 1;

<radio.gap_fill.watcher> = <[event.add_timer]>->(
    {   interval => 1.0,
        repeat   => 1,
        handler  => qw| radio.gap_fill.tick |,
    }
);

<[base.logs]>->( 2, '[radio] gap filler: playing %s', $chosen );

my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
<[base.buffer.add_line]>->(
    qw| radio-jingle |,
    join( ' ', $time_stamp, 2, "gap fill started :. $chosen" ), 2
);

