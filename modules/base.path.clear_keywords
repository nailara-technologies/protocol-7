# name  = base.path.clear_keywords
# descr = clear all path keywords from registry

if ( not <[base.is_defined_recursive]>->(qw| base.path.keywords |) ) {
    <[base.s_warn]>->('keyword list is not initialized <{C1}>');
    return FALSE;
}

<[base.log]>->( 2, 'path keyword list cleared.' );

<base.path.keywords> = {};    ## clear and reinitialize as empty ##
return TRUE;                  ## keywords cleared ##

