# name  = httpd.cmd.remove-acme-challenge
# param = <domain> <token>
# descr = remove ACME challenge response file after validation completes

( my $domain, my $token ) = split m{\ +}, $call->{'args'} // '';

return { 'mode' => qw| false |, 'data' => 'domain parameter required' }
    unless defined $domain && length($domain);

return { 'mode' => qw| false |, 'data' => 'expected token parameter' }
    unless defined $token && length($token);

<[base.logs]>->( 2, "removing ACME challenge file for domain : %s", $domain );

<[base.logs]>->( 2, ": token : %s", $token );

## build challenge file path
my $httpd_site_dir = <httpd.cfg.site_dir>     // qw| /var/httpd |;
my $default_site   = <httpd.cfg.default_site> // qw| default |;
my $well_known_dir = qw| /.well-known/acme-challenge |;

my $challenge_file = sprintf qw| %s/%s%s/%s |,
    $httpd_site_dir,
    $default_site,
    $well_known_dir,
    $token;

<[base.logs]>->( 2, "challenge file path : %s", $challenge_file );

## check if file exists
unless ( -f $challenge_file ) {
    <[base.logs]>->(
        2, "challenge file not found [ already removed or never created ]"
    );
    return {
        'mode' => qw| true |,
        'data' => 'challenge file not found [ nothing left to do ]'
    };
}

## remove the file
unless ( unlink($challenge_file) ) {
    <[base.logs]>->(
        1,               "failed to remove challenge file %s : %s",
        $challenge_file, <[base.str.os_err]>
    );
    return {
        'mode' => qw| false |,
        'data' => sprintf( "failed to remove challenge file : %s",
            <[base.str.os_err]> )
    };
}

<[base.logs]>->( 2, "challenge file removed successfully.." );

## check if directory is now empty and remove it if so
my $challenge_dir = sprintf qw| %s/%s%s |,
    $httpd_site_dir,
    $default_site,
    $well_known_dir;

if ( -d $challenge_dir ) {
    if ( opendir( my $dh, $challenge_dir ) ) {
        my @files = grep { !m|^\.| } readdir($dh);
        closedir($dh);

        if ( @files == 0 ) {
            <[base.logs]>->( 2, "removing empty challenge directory.." );
            unless ( rmdir($challenge_dir) ) {
                <[base.logs]>->(
                    2, "could not remove empty directory %s : %s",
                    $challenge_dir, <[base.str.os_err]>
                );
            } else {
                <[base.logs]>->( 2, "challenge directory removed.." );
            }
        }
    }
}

return {
    'mode' => qw| true |,
    'data' => sprintf( 'ACME challenge file removed for %s', $domain )
};

