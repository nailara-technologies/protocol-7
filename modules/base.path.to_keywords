## [:< ##

# name  = base.path.to_keywords
# param = $absolute_path
# descr = Convert absolute path to use registered keywords
# return = path string with keyword placeholders

my $path = shift;
return $path unless defined $path;

## Get keyword registry ##
return $path unless <[base.is_defined_recursive]>->(qw| base.path.keywords |);
my $keywords_href = <base.path.keywords>;

## Sort keywords by length (longest first) to handle nested paths ##
my @sorted_keys
    = sort { length $keywords_href->{$b} <=> length $keywords_href->{$a} }
    keys %$keywords_href;

## Try each keyword in order ##
foreach my $key_name (@sorted_keys) {
    my $key_path = $keywords_href->{$key_name};
    next unless defined $key_path;

    ## Replace absolute path with keyword placeholder ##
    if ( $path =~ s{^\Q$key_path\E(?=/|$)}{[$key_name]} ) {
        return $path;
    }
}

## If no keyword matches, return original ##
return $path;

