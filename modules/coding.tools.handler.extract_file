## [:< ##

# name  = coding.tools.handler.extract_file
# descr = dispatch extract_file tool call to context.file.extract handler

my $args = shift // {};

return unless exists $code{'context.file.extract'};
return $code{'context.file.extract'}->(
    {   'path'    => $args->{'path'}    // '',
        'extract' => $args->{'extract'} // 'header',
        'pattern' => $args->{'pattern'} // '',
        'budget'  => $args->{'budget'}  // 1000,
    }
);

