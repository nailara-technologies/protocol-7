# name = models.storage.get_tier_path
# descr = Get path for model in specific tier

use File::Spec;

sub get_tier_path {
  my ($model_amos, $tier, $filename) = @_;
  my $tiers = $data{tiers};

  return undef unless defined $tier && $tiers->{$tier};

  my $tier_def = $tiers->{$tier};
  my $base = $tier_def->{base_path};

  return undef unless $base;

  my $path = File::Spec->catfile($base, "$model_amos.gguf");
  $path = "$filename" if $filename;

  return $path;
}

# Entry point
{
  my @args = @ARG;
  return get_tier_path(@args);
};

