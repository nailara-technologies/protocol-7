## [:< ##

# name  = mpv.startup.request_geometry
# descr = initialized callback: contact placement zenka for window geometry

my $caller = <mpv.startup.caller> // '';

unless ( length $caller ) {
    <[base.log]>->(
        0, '[startup.request_geometry] caller not set, opening with fallback'
    );
    <[mpv.startup.job.fork_player]>;
    return;
}

<[base.logs]>->(
    1, '[startup] requesting placement from %s [caller=%s]',
    <mpv.placement_mode>, $caller
);

<[protocol-7.route-send]>->(
    {   'command'   => qw| v7.notify_online |,
        'call_args' => { 'args'    => ':start: ' . <mpv.placement_mode> },
        'reply'     => { 'handler' => 'mpv.startup.handler.placement_online' }
    }
);

