## [:< ##

# name  = amos-term.handler.nshell-buffer-changed
# descr = Handler for buffer changes from other clients

my ( $attach_id, $change_info ) = @ARG;

## nshell can choose to update display or ignore ##
## for now: log the change ##
<[base.logs]>->(
    2,
    "[nshell] buffer changed by %s",
    $change_info->{'client_type'} // 'unknown'
);

