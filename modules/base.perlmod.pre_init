## [:< ##

# name  = base.perlmod.pre_init
# desc  = Pre-initialization for perlmod subsystem, ensures Module::Runtime is available early for dynamic module loading

##  Load Module::Runtime early so base.perlmod.runtime_use can be called from other modules' init_code  ##
<[base.perlmod.autoload]>->('Module::Runtime');

return 0;

