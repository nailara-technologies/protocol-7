## [:< ##

# name  = job-site-scan.cmd.approve
# descr = approve job for application queue

my $reply_id = $call->{'reply_id'};
my $job_id   = uc( $call->{'args'} // '' );
$job_id =~ s/^\s+|\s+$//g;

my $rec = <job-site-scan.tasks>->{$job_id};
return <[base.callback.cmd_reply]>->(
    $reply_id, { 'mode' => 'false', 'data' => "unknown job: $job_id" }
) if not defined $rec;

$rec->{'stage'}       = 'approved';
$rec->{'approved_at'} = time;

## update site-yaml store
<[base.perlmod.autoload]>->('YAML::XS');
my $store_file = '/var/protocol-7/site-yaml/store.yaml';
if ( -f $store_file ) {
    my $store = eval { YAML::XS::LoadFile($store_file) } // {};
    if ( exists $store->{$job_id} ) {
        $store->{$job_id}{'status'} = 'applied';
        eval { YAML::XS::DumpFile( $store_file, $store ) };
    }
}

my $tasks = <job-site-scan.tasks> // {};
my $remaining
    = grep { ( $tasks->{$ARG}{'stage'} // '' ) eq 'review' } keys %{$tasks};

if ( not $remaining and <job-site-scan.cycle> eq 'reviewing' ) {
    <job-site-scan.cycle> = 'idle';
    <[base.logs]>->( 1, 'jss: review complete, returning to idle' );
}

<[job-site-scan.state.persist]>;

<[base.callback.cmd_reply]>->(
    $reply_id, { 'mode' => 'true', 'data' => "approved: $job_id" }
);

