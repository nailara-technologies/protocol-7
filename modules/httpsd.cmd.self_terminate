## [:< ##

# name  = httpsd.cmd.self_terminate
# descr = cleanly terminate httpsd zenka instance
# note  = closes all sessions and exits

<[base.logs]>->( 'httpsd self-terminating [PID %d]', $$ );

## mark all sessions for closure
if ( exists <base.session.ids> ) {
    my $session_count = scalar keys <base.session.ids>->%*;
    <[base.logs]>->( 2, 'closing %d active sessions', $session_count );

    foreach my $sid ( keys <base.session.ids>->%* ) {
        <base.session.ids>->{$sid}->{'close'} = 1;
    }
}

## clean up listen socket
if ( exists <httpsd.listen_socket> and defined <httpsd.listen_socket> ) {
    close(<httpsd.listen_socket>);
    delete <httpsd.listen_socket>;
}

## signal v7 that we're shutting down gracefully
## this is done by simply exiting - v7.handler.sig_chld will handle cleanup

<[base.log]>->( 2, 'httpsd: exit(0)' );

exit(0);

