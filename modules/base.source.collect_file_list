## [:< ##

# name  = base.source.collect_file_list
# param = array[s] or array reference[s] to source files

my @path_parameter = @ARG;    ##  optional  ##

### EXCLUSION PATHS ### ..expand as required., ###
#
my $exclude_files = { map { $ARG => TRUE } qw|   | };
#
#my $exclude_files = { map { $ARG => TRUE } qw| bin/p7c bin/p-7-r | };
#
### [ some LLMs compiled to these paths for permission reasons ]
#   [ NOTE : binaries still work even with added signature footers., =) ]

##                                   ##
##  work path set-ups and fallbacks  ##
##                                   ##

my $paths = <sourcecode.path> // <source.path>
    // { work_tree => <system.root_path> };

my $work_tree         = $paths->{'work_tree'};
my $work_path_abs     = abs_path($work_tree);
my $current_zenka_dir = <[base.getcwd]>;

## when sourcecode zenka ##
##
my $error_exit = FALSE;

my @all_files;
my $param_index  = 0;
my $copy_sources = [];

foreach my $path_param (@path_parameter) {
    if ( not length ref $path_param ) {
        push( $copy_sources->@*, split m| +|, $path_param );
    } elsif ( ref $path_param eq qw| ARRAY | ) {
        push( $copy_sources->@*, $path_param->@* );
    } else {
        <[base.s_warn]>->(
            'unexpected ref type [ %s ] encountered [ parameter %d ]',
            ref($param_index), $param_index
        );
    }
    $param_index++;
}

warn 'missing source path [ array or reference to array ] parameter <{C1}>'
    if not scalar $copy_sources->@*;

my @all_dirs = grep {length} grep {defined} map {

    my $rel_path = catfile( $current_zenka_dir, $ARG );  ## relative path ? ##
    $rel_path = File::Spec->canonpath($rel_path);

    my $absolute_path = -e $rel_path ? abs_path($rel_path) : $rel_path;
    $absolute_path //= abs_path( catfile( $work_path_abs, $ARG ) );

    if ( defined $absolute_path and -f $absolute_path ) {    ##  is a file  ##

        push( @all_files, $absolute_path );
        undef;

    } elsif ( defined $absolute_path and -d $absolute_path ) {    ## dir ##

        $absolute_path;    ## add to dirs ##

    } else {    ##  treat as pattern  ##

        if ( !<[file.match_dirs]>->( $work_path_abs, qw| recursive |, $ARG ) )
        {
            <[base.logs]>->( 0, ": no match for pattern %s ..,", $ARG );
            $error_exit = 2 if not $error_exit;
        }
    }
    }
    grep { !m|\*| } grep { !m|^\!| } $copy_sources->@*;

if ($error_exit) {
    <[base.exit]>->(2) if <system.zenka.name> eq qw| sourcecode |;
    warn 'path error <{C1}>';
    return undef;
}

map {    ## full-recursion wildcard matches [ path/** ] ##
    ( my $base_path = $ARG ) =~ s|/?\*\*.*$||;
    my $absolute_path = catfile( $work_tree, $base_path );
    $absolute_path = abs_path($absolute_path) if -e $absolute_path;
    if ( defined $absolute_path && -d $absolute_path ) {
        push @all_files,
            <[file.all_files]>->( $base_path, qw| recursive | )->@*;
    } else {
        <[base.logs]>->( 0, ': pattern \'%s\' - base path not found', $ARG );
    }
    }
    grep {m|\*\*|} $copy_sources->@*;

push(    ## enabling [non-recursive] wildcard matches ##
    @all_dirs,
    map {
        my $original_pattern = $ARG;
        ( my $base_path = $ARG ) =~ s|/*\*.*$||;
        ( my $pattern   = $ARG ) =~ s|^[^\*]*||;

        # Special case: standalone * or patterns without directory separator
        # These should match in the work_tree root
        if ( $original_pattern eq '*'
            or ( $original_pattern !~ m|/| and $original_pattern =~ m|\*| ) )
        {
            # Try glob in work_tree
            my @glob_results
                = glob( catfile( $work_tree, $original_pattern ) );
            if (@glob_results) {

                # Return matching directories;
                # files will be collected by file.all_files
                grep {-d} @glob_results;
            } else {

              # No glob matches, return the work_tree itself as fallback for *
                if ( $original_pattern eq qw| * | ) {
                    $work_tree;
                } else {
                    <[base.logs]>->(
                        0, ': pattern \'%s\' - no matches found',
                        $original_pattern
                    );
                    ();
                }
            }
        } else {

            # Original logic for patterns with path separators
            my $absolute_path = catfile( $work_tree, $base_path );

            # Check if base path exists before attempting match
            if ( not -e $absolute_path ) {
                <[base.logs]>->(
                    0, ': pattern \'%s\' - base path does not exist',
                    $original_pattern
                );
                ();    # return empty list for this pattern
            } else {
                $absolute_path = abs_path($absolute_path);

                # Special case: pattern ending with /* means scan immediate
                # files non-recursively This is different from /*/ which
                # means find subdirectories
                if ( $original_pattern =~ m|/\*$| and $pattern eq qw| * | ) {

                    # Add the base directory itself to be scanned for
                    # immediate files only
                    ($absolute_path);
                } else {

                    # Return directory matches for other wildcard patterns
                    <[file.match_dirs]>->( $absolute_path, $pattern );
                }
            }
        }
        }
        grep { !m|\*/| }
        grep { !m|\*\*| }
        grep {m|\*|} $copy_sources->@*
);

push(    ## glob based wildcard matches ##  [ ,../*/ ]
    @all_dirs,
    grep { defined $_ }    ## filter out undef from non-existent paths ##
        map {
        ( my $base_path = $ARG ) =~ s|/*\*.*$||;
        ( my $pattern   = $ARG ) =~ s|^[^\*]*||;
        my $absolute_path = catfile( $work_tree, $base_path );
        $absolute_path = abs_path($absolute_path) if -e $absolute_path;
        $absolute_path;
        }
        grep {-d} map {glob}
        grep {m|\*.*/$|} $copy_sources->@*
);

push(    ## glob based wildcard matches ##  [ ,../*/* files ]
    @all_files,
    grep { defined $_ }    ## filter out undef from non-existent paths ##
        map {
        ( my $base_path = $ARG ) =~ s|/*\*.*$||;
        ( my $pattern   = $ARG ) =~ s|^[^\*]*||;
        my $absolute_path = catfile( $work_tree, $base_path );
        $absolute_path = abs_path($absolute_path) if -e $absolute_path;
        }
        grep {-f} map {glob}
        grep {m|\*/.*\*$|} $copy_sources->@*
);

push(    ## file-extension glob matches ##  [ path/*.ext ]
    @all_files,
    grep {-f} map {glob}
        map  { catfile( $work_tree, $ARG ) }
        grep {m|/\*\.\w+$|}  ## path/*.ext — not recursive, specific extension
        $copy_sources->@*
);

map {
    my $source_path = $ARG;
    die "source path '$source_path' does not exist" if not -d $source_path;
    if ( <system.zenka.name> eq qw| sourcecode | and not -w $source_path ) {
        <[base.logs]>->(
            0, "<< missing write permissions for '%s' >>", $source_path
        );
        if ($error_exit) {
            <[base.exit]>->(4) if <system.zenka.name> eq qw| sourcecode |;
            warn 'path error <{C1}>';
            return undef;
        }
    }
} @all_dirs;

foreach my $absolute_path (@all_dirs) {
    <[file.all_files]>->( $absolute_path, \@all_files );
}

## Deduplicate absolute paths
# before converting to relative
@all_files = uniq @all_files;

my @source_paths
    = grep { $ARG =~ s|^$work_tree/?||; not exists $exclude_files->{$ARG} }
    grep { !m{/\.|~$} } @all_files;

## exclusion patterns [ !..,* ] ##
## supports $ at end for end-of-string anchor ##

foreach my $pattern_str ( grep {m|^\!|} $copy_sources->@* ) {
    $pattern_str =~ s|^\!||;

    ## check for $ anchor at end (literal $ in pattern) ##
    if ( $pattern_str =~ s|\$$|| ) {
        ## has $ anchor - use end-of-string matching ##
        @source_paths = grep { !m|\Q$pattern_str\E$| } @source_paths;
    } else {
        ## no anchor - match anywhere ##
        @source_paths = grep { !m|\Q$pattern_str\E| } @source_paths;
    }
}

@source_paths = uniq <[base.sort]>->(@source_paths);

if ( scalar $copy_sources->@* > @source_paths ) {
    my @report_paths;
NXT_PATH:
    foreach my $chk_path ( $copy_sources->@* ) {
        next if -e $chk_path;
        foreach my $src_path (@source_paths) {
            ##  improve : could have false positives  ##  [ LLL ]
            next NXT_PATH if rindex( $src_path, $chk_path ) != -1;
        }
        push @report_paths, $chk_path;
    }
    foreach my $err_path (@report_paths) {
        <[base.logs]>->( 0, ': no matches : %s', $err_path );
    }
    if ($error_exit) {
        <[base.exit]>->(qw| 0110 |)
            if <system.zenka.name> eq qw| sourcecode |;
        warn 'path error <{C1}>';
        return undef;
    }
}

return @source_paths;

