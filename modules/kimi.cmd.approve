## [:< ##

# name  = kimi.cmd.approve
# descr = approve a pending tool call request

my $request_id = $call->{'args'} // '';

## approve all pending if no id given
if ( not length $request_id ) {
    my @pending = keys %{<kimi.approval.pending>};
    if ( not @pending ) {
        return { 'mode' => qw| false |, 'data' => 'no pending approvals' };
    }
    foreach my $rid (@pending) {
        delete <kimi.approval.pending>->{$rid};
        <[kimi.wire.approval_respond]>->( $rid, 'approve' );
    }
    return {
        'mode' => qw| true |,
        'data' => sprintf( 'approved %d pending requests', scalar @pending )
    };
}

my $pend = delete <kimi.approval.pending>->{$request_id};
if ( not defined $pend ) {
    return {
        'mode' => qw| false |,
        'data' => "no pending approval for $request_id"
    };
}

<[kimi.wire.approval_respond]>->( $request_id, 'approve' );

return {
    'mode' => qw| true |,
    'data' =>
        sprintf( 'approved %s [ %s ]', $request_id, $pend->{'action'} // '' )
};

