# name  = context.util.tree.resolve_time_range
# descr = resolve relative time range expressions to epoch timestamps

my $range = shift // [];

my $now = time();

my $start = $range->[0] // '-1 hour';
my $end   = $range->[1] // 'now';

return (
    <[context.util.tree.parse_relative_time]>->( $start, $now ),
    <[context.util.tree.parse_relative_time]>->( $end,   $now ),
);

