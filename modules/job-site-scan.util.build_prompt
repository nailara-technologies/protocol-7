## [:< ##

# name  = job-site-scan.util.build_prompt
# descr = build assessment prompt for a single job

my $job     = shift // {};
my $defects = shift // undef;

my $title    = $job->{'title'}       // '';
my $co       = $job->{'company'}     // '';
my $city     = $job->{'city'}        // '';
my $ind      = $job->{'industry'}    // '';
my $raw_desc = $job->{'description'} // '';

<[base.perlmod.autoload]>->('HTML::Entities');
HTML::Entities::decode_entities($raw_desc) if length $raw_desc;

<[base.perlmod.autoload]>->('Encode');
for ( $title, $co, $city, $ind, $raw_desc ) {
    $_ = Encode::decode( 'UTF-8', $_ ) unless utf8::is_utf8($_);
}
my $desc = substr( $raw_desc, 0, 1200 );

## load candidate profile once and cache ##
my $profile_text = $data{'job-site-scan'}{'cached_profile'} // '';
if ( not length $profile_text ) {
    my $profile_file = <job-site-scan.cfg.profile_file>
        // '/etc/protocol-7/job-site-scan/profile.txt';
    $profile_text = <[file.read]>->($profile_file)
        // 'no profile configured — score based on job listing alone';
    $profile_text = Encode::decode( 'UTF-8', $profile_text )
        unless utf8::is_utf8($profile_text);
    $data{'job-site-scan'}{'cached_profile'} = $profile_text;
}

## extract candidate name from profile header ##
my $candidate_name = 'the candidate';
if ( $profile_text =~ m{^#\s*Candidate Profile\s*[-\x{2014}]\s*(.+?)$}m ) {
    $candidate_name = $1;
    $candidate_name =~ s{^\s+|\s+$}{}g;
}

## build task preamble ##
my ( $task_preamble, $step1_preamble );
if ( defined $defects and @$defects ) {
    my $defect_note = join( ', ', @$defects );
    $task_preamble
        = ':local: :simple: You are a job-matching assistant.'
        . " RE-ASSESS this job for $candidate_name."
        . "\n\nPREVIOUS ASSESSMENT HAD DEFECTS: $defect_note";
    $step1_preamble
        = "Step 1 — Analyze in English: compare $candidate_name's profile"
        . ' against the job requirements and FIX the defects above.';
} else {
    $task_preamble
        = ':local: :simple: You are a job-matching assistant. Your task:'
        . " evaluate whether $candidate_name fits the job below."
        . ' Output ONLY a German JSON object — no other text.';
    $step1_preamble
        = "Step 1 — Analyze in English: compare $candidate_name's profile"
        . ' against the job requirements.';
}

my $prompt = join( "\n\n",
    $task_preamble,
    "IMPORTANT: $candidate_name is the CANDIDATE."
        . ' The section below marked "## Stellenanzeige" is the JOB.'
        . ' Do NOT confuse the candidate with the role being advertised.'
        . ' Never describe the candidate using job description keywords.'
        . ' Never attribute job requirements to the candidate.',
    'Assessment criteria: technical alignment (highest weight),'
        . ' seniority, location / remote option, industry relevance, role scope.',
    $step1_preamble,
    'Step 2 — Translate into German and output EXACTLY this JSON format:'
        . ' {"score": <0-10>, "apply": <true|false>,'
        . " \"reason\": \"<1-2 deutsche Sätze:"
        . " passt der Kandidat zu dieser Stelle oder nicht>\","
        . " \"summary\": \"<2-3 deutsche Sätze:"
        . ' was die Stelle bietet, gesuchte Skills,'
        . ' Remote/Standort-Details, Besonderheiten>",'
        . ' "assertions": {'
        . '   "suggest": {'
        . '     "apply": <true|false>,'
        . '     "delete": <true|false>,'
        . '     "archive": <true|false>' . '   },'
        . '   "dimensions": {'
        . '     "location": {"score": <0-10>, "reason": "<1 Satz>"},'
        . '     "work-profile": {"score": <0-10>, "reason": "<1 Satz>"},'
        . '     "company-culture": {"score": <0-10>, "reason": "<1 Satz>"},'
        . '     "compensation": {"score": <0-10>, "reason": "<1 Satz>"},'
        . '     "remote-flexibility": {"score": <0-10>, "reason": "<1 Satz>"},'
        . '     "career-growth": {"score": <0-10>, "reason": "<1 Satz>"},'
        . '     "tech-stack": {"score": <0-10>, "reason": "<1 Satz>"},'
        . '     "team-structure": {"score": <0-10>, "reason": "<1 Satz>"}'
        . '   }'
        . ' } }',
    'CRITICAL: All text MUST be valid UTF-8 German with proper umlauts (ä ö ü ß).'
        . ' Never use ae/oe/ue/ss. No English. No Chinese.',
    "## Kandidatenprofil — $candidate_name ##",
    $profile_text,
    '## Stellenanzeige — DIESE STELLE BEWERTEN ##',
    "Titel: $title",
    "Unternehmen: $co",
    "Ort: $city",
    "Branche: $ind",
    "Beschreibung:\n$desc",
);

return $prompt;

