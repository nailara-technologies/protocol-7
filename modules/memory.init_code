## [:< ##

# name = memory.init_code
# descr = init focus vector state, cfg defaults, and decay timer

## [ idempotent — skip if already initialized ]##
return TRUE if <memory.initialized>;

## [ full config defaults ]##
<[memory.cfg.defaults]>;
my $cfg = <memory.cfg> // {};

## [ focus vector state ]##
## [ topic boosts live in <memory.focus>; metadata kept as siblings ]##
## [ so the decay/score loops over %{<memory.focus>} see topics only ]##
<memory.focus>                //= {};
<memory.focus_floor>          //= {};
<memory.focus_cmd_buffer>     //= [];
<memory.focus_cmd_buffer_max> //= 7;

## [ register repeating decay timer :
##   : hardcoded floor prevents undef interval ]##
my $decay_interval = $cfg->{'focus_interval'} // 30;
$decay_interval = 30 if not $decay_interval or $decay_interval < 5;
<[event.add_timer]>->(
    {   'after'    => $decay_interval,
        'interval' => $decay_interval,
        'repeat'   => TRUE,
        'handler'  => 'memory.focus.decay',
        'desc'     => 'focus vector decay toward floor'
    }
);

## [ register maintenance timer ] ##
my $maint_interval = $cfg->{'maintenance_interval'} // 300;
$maint_interval = 60 if not $maint_interval or $maint_interval < 30;
<[event.add_timer]>->(
    {   'after'    => $maint_interval,
        'interval' => $maint_interval,
        'repeat'   => TRUE,
        'handler'  => 'memory.maintenance.timer',
        'desc'     => 'memory tree maintenance wave'
    }
);

## [ tree init ]##
<[memory.tree.init]>;

## [ register source adapters if present ]##
my @sources = qw[
    memory.source.file
    memory.source.session
    memory.source.git
    memory.source.index
];
for my $src (@sources) {
    my $mod_path = <system.root_path> . "/modules/$src";
    next if not -f $mod_path;
    push @{ <memory.sources_registered> //= [] }, $src;
}

## [ always defer — never call startup synchronously inside init ]##
push @{ <system.callbacks.initialized> //= [] }, 'memory.startup';

<[base.logs]>->( 1, 'memory focus vector initialized' );

<memory.focus_initialized> = TRUE;
<memory.initialized>       = TRUE;

return TRUE;

