## [:< ##

# name  = base.handler.deferred_compile
# descr = placeholder for deferred module compilation on first call
#
# install as $code{$name} compiled with '# line 1 "$name"' filename
# hint so base.caller can self-identify and load the actual source

my $sub_name = [<[base.caller]>]->[0];    ##  own name via filename hint  ##

<[base.logs]>->( 2, '..: deferred compile : %s ..,', $sub_name );

##  bypass whitelist — deferred stubs are for non-whitelisted modules  ##
<[base.load_runtime_modules]>->($sub_name);

goto &{ $code{$sub_name} }    ##  transparent hand-off on first call  ##
    if ref $code{$sub_name} eq qw| CODE |;

##  install broken stub — prevents retry loop, clears itself on reload  ##
$data{'code'}{$sub_name}{'status'} = 'error';    ##
$code{$sub_name} = eval(                         ##
    "sub { if ( ( \$data{'code'}{'$sub_name'}{'status'} // '' )"       ##
        . " ne 'error' ) {"                                            ##
        . " goto &{ \$code{'$sub_name'} } }"                           ##
        . " \$code{'base.log'}->(0,"                                   ##
        . "'..: broken sub called [ $sub_name ] — compile failed')"    ##
        . " }"
);                                                                     ##

<[base.logs]>->( 0, '..: deferred compile failed [ %s ]', $sub_name );

