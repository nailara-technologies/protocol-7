## [:< ##

# name = coding.task.queue.dequeue_next
# descr = get next task to execute
# purpose = queue management : retrieve next available task respecting priority and dependencies

# filter tasks that have no unfinished dependencies
my @available = ();

foreach my $task_id (@{<coding.task.queue.QUEUE_ORDER>}) {
    my $task = <coding.task.queue.TASK_QUEUE>->{$task_id};

    # skip if not pending
    next unless $task->{execution}->{status} eq qw| pending |;

    # check dependencies
    my $blocked = 0;
    if ( exists <coding.task.queue.TASK_DEPENDENCIES>->{$task_id} ) {
        foreach my $dep_id ( @{ <coding.task.queue.TASK_DEPENDENCIES>->{$task_id} } ) {
            my $dep_task = <coding.task.queue.TASK_QUEUE>->{$dep_id};
            if (  !$dep_task
                || $dep_task->{execution}->{status} ne qw| completed | ) {
                $blocked = 1;
                last;
            }
        }
    }

    next if $blocked;

    push @available,
        {
        id             => $task_id,
        task           => $task,
        priority_score => <[coding.helper.priority_scorer]>->($task)
        };
}

# sort by priority (highest first)
my @sorted
    = sort { $b->{priority_score} <=> $a->{priority_score} } @available;

if (@sorted) {
    my $next = $sorted[0];
    my $task = $next->{task};

    # mark as being worked on (don't remove yet)
    $task->{execution}->{status}  = qw| in_progress |;
    $task->{execution}->{started} = <[base.time]>;

    return {
        success         => TRUE,
        task            => $task,
        queue_remaining => scalar(@{<coding.task.queue.QUEUE_ORDER>}) - 1
    };
}

return {
    success    => FALSE,
    error      => 'no available tasks in queue',
    queue_size => scalar(@{<coding.task.queue.QUEUE_ORDER>})
};

