## [:< ##

# name  = context.tree.summary.init-code
# descr = Initialize context awareness tree for network-wide parallel consciousness

## Awareness tree registry ##
$data{'context'}{'tree'}{'summary'} = {
    'version' => '0.1',
    'root'    => 'network-consciousness',

    # Tree structure: hierarchical branches
    'branches' => {

        # Core system branches
        'storage' => { 'active' => 1, 'priority' => 'high' },
        'context' => { 'active' => 1, 'priority' => 'high' },
        'index'   => { 'active' => 1, 'priority' => 'medium' },

        # Agent-specific branches
        'agents' => {
            'kimi'   => { 'active' => 1, 'priority' => 'high' },
            'claude' => { 'active' => 0, 'priority' => 'high' },     # Offline
            'coding' => { 'active' => 1, 'priority' => 'medium' },
        },

        # Cross-cutting concerns
        'delegations' => { 'active' => 1, 'priority' => 'high' },
        'errors'      => { 'active' => 1, 'priority' => 'critical' },
        'milestones'  => { 'active' => 1, 'priority' => 'high' },
    },

    # Event storage (checksum-addressed)
    'events' => {},    # checksum => event_node

    # Summary nodes (compacted events)
    'summaries' => {},    # checksum => summary_node

    # Indices for efficient queries
    'index' => {
        'by_time'   => {},    # timestamp => [checksums]
        'by_type'   => {},    # type => [checksums]
        'by_agent'  => {},    # agent => [checksums]
        'by_branch' => {},    # branch => [checksums]
        'by_ref'    => {},    # referenced_checksum => [event_checksums]
    },

    # Relevance cache (ephemeral, LRU)
    'relevance_cache' => {
        'max_size' => 10000,
        'entries'  => {},      # checksum => relevance_score
    },

    # Configuration
    'config' => {

        # Compaction schedule
        'compaction' => {
            'twig_interval'   => 3600,      # 1 hour
            'branch_interval' => 86400,     # 24 hours
            'trunk_interval'  => 604800,    # 7 days
            'retention_days'  => 365,
        },

        # Sync settings
        'sync' => {
            'gossip_interval' => 60,            # seconds
            'max_sync_peers'  => 5,
            'sync_priority'   => 'proximity',
        },

        # Relevance weights
        'relevance_weights' => {
            'proximity'  => 0.25,
            'recency'    => 0.25,
            'centrality' => 0.20,
            'semantic'   => 0.20,
            'authority'  => 0.10,
        },
    },

    # Statistics
    'stats' => {
        'events_added'      => 0,
        'events_compacted'  => 0,
        'summaries_created' => 0,
        'queries_served'    => 0,
        'syncs_completed'   => 0,
    },

};
## Checkpoint registry (for reset recovery)
$data{'context'}{'tree'}{'summary'}{'checkpoints'} = {};

0;

