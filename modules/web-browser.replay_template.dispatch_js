## [:< ##

# name  = web-browser.replay_template.dispatch_js
# descr = js fn : dispatch normalized events at __p7ReplayTarget
# note  = invoked as ( <fn> )( events_json, speed ) ; returns event count

return <<'JS_SRC';
function ( events, speed ) {
    var target = window.__p7ReplayTarget || document;
    var isDoc = ( target === document );
    var w = isDoc ? window.innerWidth
        : ( target.clientWidth || window.innerWidth );
    var h = isDoc ? window.innerHeight
        : ( target.clientHeight || window.innerHeight );
    var typeMap = { down: 'mousedown', move: 'mousemove', up: 'mouseup' };
    window.__p7ReplayDone = false;
    window.__p7ReplayCount = events.length;
    var dispatched = 0;
    events.forEach( function ( rec ) {
        setTimeout( function () {
            var cx = Math.round( rec.x * w );
            var cy = Math.round( rec.y * h );
            var ev;
            if ( rec.type === 'wheel' ) {
                ev = new WheelEvent( 'wheel', {
                    deltaY: rec.dz || 0,
                    clientX: cx, clientY: cy,
                    bubbles: true, cancelable: true
                } );
            } else {
                ev = new MouseEvent( typeMap[ rec.type ] || rec.type, {
                    clientX: cx, clientY: cy,
                    button: 0,
                    buttons: rec.type === 'up' ? 0 : 1,
                    bubbles: true, cancelable: true
                } );
            }
            target.dispatchEvent( ev );
            dispatched++;
            if ( dispatched === events.length ) window.__p7ReplayDone = true;
        }, rec.t / speed );
    } );
    return events.length;
}
JS_SRC

