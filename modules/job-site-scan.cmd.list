## [:< ##

# name  = job-site-scan.cmd.list
# descr = list jobs, optional stage filter

my $filter = $call->{'args'} // '';

my $tasks = <job-site-scan.tasks> // {};
my @ids   = sort keys %{$tasks};

@ids = grep { ( $tasks->{$ARG}{'stage'} // '' ) eq $filter } @ids
    if length $filter;

if ( not @ids ) {
    return <[base.callback.cmd_reply]>->(
        {   'mode' => TRUE,
            'data' => 'no jobs'
                . ( length $filter ? " (filter: $filter)" : '' )
        }
    );
}

<[base.perlmod.autoload]>->('YAML::XS');
my $store_file = '/var/protocol-7/site-yaml/store.yaml';
my $store
    = -f $store_file
    ? ( eval { YAML::XS::LoadFile($store_file) } // {} )
    : {};

my @lines;
for my $id (@ids) {
    my $rec = $tasks->{$id};
    my $job = $store->{$id} // {};
    my $score
        = length( $rec->{'score'} // '' )
        ? sprintf( ' [%s]', $rec->{'score'} )
        : '';
    push @lines, sprintf '%-14s %-11s%s  %s — %s (%s)',
        $id,
        $rec->{'stage'} // '?',
        $score,
        $job->{'title'}   // '',
        $job->{'company'} // '',
        $job->{'city'}    // '';
}

<[base.callback.cmd_reply]>
    ->( { 'mode' => TRUE, 'data' => join( "\n", @lines ) } );

