## [:< ##

# name = memory.render.term
# descr = ansi colored tree render for terminal / nshell

my $params = shift // {};
my $n      = $params->{'n'};

my $tree = <[memory.tree.render]>->( { variant => 'compact', n => $n } );
return $tree if not defined $tree or not length $tree;

my $colored = <[ascii.frame.render.color]>->($tree);
return $colored // $tree;

