# name  = base.perlmod.install_cpan_module
# descr = Safely install CPAN module via cpanm with proper subprocess handling

my $module_name = shift;
my $cpanm_path  = <system.bin_path.cpanm>;

return -1 if not defined $module_name;
return -2 if not length $cpanm_path;

## Safe subprocess execution with captured output ##
my $output = '';
my $errors = '';

open( my $cpanm_fh, '-|', $cpanm_path, '--quiet', '--notest', $module_name )
    or do {
    <[base.logs]>->( 0, ": failed to execute cpanm: %s", $! );
    <[base.buffer.add_line]>->(
        qw| perlmod-install |,
        sprintf '  ✗ %s (exec failed: %s)',
        $module_name, $!
    );
    return -1;
    };

## Capture output while process runs ##
while (<$cpanm_fh>) {
    chomp;
    $output .= $_ . "\n";
}

close($cpanm_fh);
my $exit_code = $? >> 8;

## Log captured output if there were issues ##
if ( $exit_code != 0 and length $output ) {
    <[base.logs]>->( 2, ": cpanm output: %s", $output );
    <[base.buffer.add_line]>->(
        qw| perlmod-install |,
        sprintf '  ✗ %s (install failed)', $module_name
    );
} elsif ( $exit_code == 0 ) {
    <[base.buffer.add_line]>->(
        qw| perlmod-install |,
        sprintf '  ✓ %s', $module_name
    );
}

return $exit_code;

