# name  = lm-vision.handler.process_batch
# descr = process batched image analysis requests with single model load

my $batch = <lm-vision.batch_queue>;
return unless scalar @$batch > 0;

<[base.logs]>->(
    1,
    "[process_batch] processing %d queued requests",
    scalar @$batch
);

# Clear batch timer reference - we'll store it in a scalar
my $batch_timer_ref;
$batch_timer_ref = <lm-vision.batch_timer>;

# Extract first request to use for model loading
my $first_req   = $batch->[0];
my $binary      = <lm-vision.binary>;
my $model_path  = <lm-vision.vision_model_path>;
my $mmproj_path = <lm-vision.vision_mmproj_path>;

# Build command with first image - optimized for 4B model with flash attention
# Note: All requests in batch receive same response;
# implement parsing if per-request responses needed
my $log_file = <system.root_path> . '/llama';
my @cmd      = (
    $binary,
    '-m',       $model_path,
    '--mmproj', $mmproj_path,
    '-ngl',     99,
    '-c',       8192,           # Context: image tokens + prompt + response
    '-t',       4,
    '--image',  $first_req->{'image_path'},
    '--image-min-tokens', 1024,    # Minimum image tokens for Qwen3-VL
    '-n', -2,    # Generate until context size full (better streaming than -1)
    '--no-warmup',    # Skip warmup to reduce initialization output
    '--log-file', $log_file,    # Log redirection via symlink to /dev/null
    '--prompt',   $first_req->{'prompt'},

    # Reverse prompts: stop generation at natural boundaries
    '--reverse-prompt', 'User:',    # Stop at conversation turn
    '--reverse-prompt', '###',      # Stop at section separator

    # Qwen3 recommended VL task parameters from modelcard
    '--temp',             0.7,    # Moderate temperature for focused VL output
    '--top-k',            20,     # Top-k sampling (recommended for VL)
    '--top-p',            0.8,    # Nucleus sampling for VL tasks
    '--repeat-penalty',   1.0,    # Repetition penalty (default)
    '--presence-penalty', 1.5,    # Presence penalty to reduce repetition
);

# Set up environment for vision model
local $ENV{'LD_LIBRARY_PATH'}
    = <lm-vision.lib_path> . ':' . ( $ENV{'LD_LIBRARY_PATH'} // '' );

# Spawn vision CLI process with stdin redirected from /dev/null
my ( $wtr, $rdr, $err );
$err = Symbol::gensym();

# Open /dev/null for stdin
open( my $null_in, '<', '/dev/null' ) or do {
    <[base.logs]>->( 0, "ERROR : Failed to open /dev/null for stdin" );
    return;
};

my $pid = eval { open3( $null_in, $rdr, $err, @cmd ) };

if ( !$pid || $EVAL_ERROR ) {
    <[base.logs]>->(
        0,
        "ERROR: Failed to spawn vision CLI: %s",
        $EVAL_ERROR // 'unknown error'
    );

    # Mark all requests in batch as failed
    foreach my $req (@$batch) {
        <[base.callback.cmd_reply]>->(
            $req->{'reply_id'},
            { 'mode' => 'false', 'data' => 'vision CLI spawn failed' }
        );
    }

    # Clear the batch queue
    @$batch = ();
    return;
}

# Enable autoflush and set non-blocking mode on read filehandles
$rdr->autoflush(1);
$err->autoflush(1);

# Set filehandles to non-blocking mode using fcntl
use Fcntl qw(F_GETFL F_SETFL O_NONBLOCK);
foreach my $fh ( $rdr, $err ) {
    my $flags = fcntl( $fh, F_GETFL, 0 ) or die "can't get flags: $!";
    fcntl( $fh, F_SETFL, $flags | O_NONBLOCK )
        or die "can't set non-blocking: $!";
}

<[base.logs]>->(
    1,    "[process_batch] batch spawned: pid=%d requests=%d",
    $pid, scalar @$batch
);

# Create batch job entry with COPY of requests (not reference to queue)
my $batch_id  = <[base.gen_id]>->(<lm-vision.jobs>);
my $batch_job = {
    'batch_id'   => $batch_id,
    'pid'        => $pid,
    'status'     => 'running',
    'output'     => '',
    'stderr'     => '',
    'rdr'        => $rdr,
    'err'        => $err,
    'requests'   => [@$batch],   # Store COPY of requests for response routing
    'start_time' => <[base.time]>->(3),
};

<lm-vision.jobs>->{$batch_id} = $batch_job;

# Register non-blocking I/O handler for stdout (data reading - lightweight)
# prio => 2 (higher priority): process all available data first
$batch_job->{'rdr_io'} = <[event.add_io]>->(
    {   'fd'      => $rdr,
        'handler' => qw| lm-vision.handler.read_batch_output |,
        'data'    => $batch_id,
        'poll'    => qw| r |,
        'prio'    => 2
    }
);

# Register non-blocking I/O handler for stderr
# (read + exception for completion)
# prio => 1 (lower priority): process EOF after all data has been read
$batch_job->{'err_io'} = <[event.add_io]>->(
    {   'fd'      => $err,
        'handler' => qw| lm-vision.handler.check_batch_completion |,
        'data'    => $batch_id,
        'poll'    => qw| re |,
        'prio'    => 1
    }
);

# Clear batch queue for next batch
@$batch = ();

