## [:< ##

# name  = task.handler.summarize-reply
# descr = reply handler — store summary in task queue + valued tree

my $call    = <[protocol-7.call]>;
my $task_id = $call->{'params'}{'task_id'} // '';
my $summary = $call->{'data'}              // '';

if ( length $task_id ) {
    ## store summary on task record ##
    <coding.task.queue>->{$task_id}{'summary'} = $summary;

    ## register in valued tree ##
    <[valued.tree.register_outcome]>->(
        {   node_id      => $task_id,
            outcome_text => $summary,
        }
    );
}

return { mode => 'true', data => $summary };

