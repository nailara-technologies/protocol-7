## [:< ##

# name  = cred-mesh.cmd.subscribe_rotation
# descr = subscribe a handler to credential rotation events
# param = <slot> <handler>

my $args_str = $call->{'args'} // '';
$args_str =~ s/^\s+|\s+$//g;

my ( $slot, $handler ) = split qr|\s+|, $args_str, 2;
$slot    //= '';
$handler //= '';

<[base.logs]>->(
    1,     'cred-mesh.cmd.subscribe_rotation: received slot=%s handler=%s',
    $slot, $handler
);

return { 'mode' => qw| false |, 'data' => 'missing slot' }
    unless length $slot;
return { 'mode' => qw| false |, 'data' => 'missing handler' }
    unless length $handler;

my $result = <[cred-mesh.subscribe_rotation]>->(
    {   'slot'    => $slot,
        'handler' => $handler,
    }
);

<[base.logs]>->(
    ( defined $result and ref $result eq qw| HASH | ) ? 1 : 0,
    'cred-mesh.cmd.subscribe_rotation: result for handler %s : %s',
    $handler,
    ( defined $result and ref $result eq qw| HASH | )
    ? ( $result->{'data'} // 'ok' )
    : 'subscribe failed'
);

return $result
    if defined $result and ref $result eq qw| HASH |;

return { 'mode' => qw| false |, 'data' => 'subscribe failed' };

## [ end ] ###################################################################

