# name  = coding.handler.check-completion-chain
# descr = variable watcher handler for auto-resume completion detection

my $ev = shift;
my $meta_id = $ev->w->data;

my $meta_job = <coding.complete_analysis_jobs>->{$meta_id};

# Helper to cancel watcher and avoid repeat firing
my $cancel_watcher = sub {
    if ( defined $meta_job->{'continuation_watcher'} ) {
        $meta_job->{'continuation_watcher'}->cancel;
    }
};

unless ( defined $meta_job ) {
    # Meta job not found, stop monitoring
    <[base.logs]>->( 1, "[check-completion-chain] meta job not found: %s", $meta_id );
    return;
}

# Count how many times handler is called
$meta_job->{'handler_call_count'} //= 0;
$meta_job->{'handler_call_count'}++;

<[base.logs]>->(
    1, "[check-completion-chain] CALLED (call %d, status=%s)",
    $meta_job->{'handler_call_count'},
    $meta_job->{'status'} // 'analyzing'
);

# Guard: Don't process if we've already sent a reply
if ( $meta_job->{'status'} =~ /^(complete|error|failed)$/ ) {
    <[base.logs]>->( 2, "[check-completion-chain] already processed (status=%s), ignoring", $meta_job->{'status'} );
    return;
}

# Clear the continuation flag immediately (set to FALSE) to prevent re-triggering
$meta_job->{'continue_analysis'} = FALSE;
$ev->w->stop;  # Stop watching this variable

# Get the current task
my $task = $meta_job->{'task'};

unless ( defined $task && length $task->{'id'} ) {
    <[base.logs]>->(
        0, "[check-completion-chain] task not found for meta=%s",
        $meta_id
    );

    <[base.callback.cmd_reply]>->(
        $meta_job->{'reply_id'},
        { 'mode' => 'false', 'data' => 'task lost or failed' }
    );

    $meta_job->{'status'} = 'failed';
    $cancel_watcher->();
    return;
}

# Check if task has completed (check in coding.task.queue where tasks are stored)
my $queue_task = <coding.task.queue>->{ $task->{'id'} };

unless ( defined $queue_task && $queue_task->{execution}->{status} eq 'completed' ) {
    # Task not yet complete, reschedule and return
    <[base.logs]>->(
        2, "[check-completion-chain] task still processing: %s",
        $task->{'id'}
    );
    return;
}

# Get task result from the completed task
my $task_result = $queue_task->{execution}->{result} // '';

# On first response (resume_count == 0), accumulated is already set by on_task_complete
# On continuations (resume_count > 0), append the new result to accumulated
if ( $meta_job->{'resume_count'} > 0 ) {
    $meta_job->{'accumulated'} .= $task_result;
}

<[base.logs]>->(
    1,
    "[check-completion-chain] task completed: %s (accumulated=%d bytes)",
    $task->{'id'},
    length( $meta_job->{'accumulated'} )
);

# Check if response appears complete (ends with proper punctuation or is short)
my $appears_complete = (
    $task_result =~ /[\.\!\?]\s*$/  ||  # Ends with period, exclamation, or question
    length($task_result) < 100           # Very short responses likely complete
);

if ($appears_complete) {
    <[base.logs]>->(
        1, "[check-completion-chain] analysis complete, returning result"
    );

    # Determine reply mode based on internal newlines (excluding trailing)
    my $final_data = $meta_job->{'accumulated'};
    my $stripped_data = $final_data;
    $stripped_data =~ s/\n$//;  # Remove trailing newline for counting
    my $internal_newlines = ( $stripped_data =~ tr/\n// );

    # Single-line (0 internal newlines): strip trailing newline, use 'true' mode
    # Multi-line (1+ internal newlines): ensure trailing newline, use 'size' mode
    my $reply_mode;
    if ( $internal_newlines == 0 ) {
        $final_data =~ s/\n$//;  # Strip trailing newline
        $reply_mode = 'true';
    } else {
        $final_data .= "\n" if $final_data !~ /\n$/;  # Ensure trailing newline
        $reply_mode = 'size';
    }

    # Response is complete - send final result
    <[base.callback.cmd_reply]>->(
        $meta_job->{'reply_id'},
        { 'mode' => $reply_mode, 'data' => $final_data }
    );

    $meta_job->{'status'} = 'complete';
    $cancel_watcher->();
    return;
}

# Response is incomplete - check if we've exceeded max resumes
if ( $meta_job->{'resume_count'} >= $meta_job->{'max_resumes'} ) {
    <[base.logs]>->(
        1,
        "[check-completion-chain] max resumes exceeded (%d), returning partial result",
        $meta_job->{'max_resumes'}
    );

    # Send accumulated result with size mode (still successful, just capped)
    my $capped_data = $meta_job->{'accumulated'};
    my $stripped_capped = $capped_data;
    $stripped_capped =~ s/\n$//;
    my $capped_internal_newlines = ( $stripped_capped =~ tr/\n// );

    my $capped_reply_mode;
    if ( $capped_internal_newlines == 0 ) {
        $capped_data =~ s/\n$//;
        $capped_reply_mode = 'true';
    } else {
        $capped_data .= "\n" if $capped_data !~ /\n$/;
        $capped_reply_mode = 'size';
    }

    <[base.callback.cmd_reply]>->(
        $meta_job->{'reply_id'},
        { 'mode' => $capped_reply_mode, 'data' => $capped_data }
    );

    $meta_job->{'status'} = 'complete';
    $cancel_watcher->();
    return;
}

# Response is incomplete - resume for more content
$meta_job->{'resume_count'}++;

<[base.logs]>->(
    1,
    "[check-completion-chain] response incomplete, resuming (attempt %d/%d)",
    $meta_job->{'resume_count'},
    $meta_job->{'max_resumes'}
);

# Build continuation task with previous response as context
my $continuation_description = $meta_job->{'description'};
if ( $meta_job->{'resume_count'} > 1 ) {
    $continuation_description .= " [Please continue and provide more detail]";
}

# Append previous response as context for continuation
$continuation_description .= "\n\n[Previous response (continue from here):\n"
    . $meta_job->{'accumulated'} . "\n]\n"
    . "[Continue...]";

# Parse continuation task
my $cont_intake = <[coding.task.intake]>->($continuation_description);

if ( !$cont_intake->{success} ) {
    <[base.logs]>->(
        0,
        "[check-completion-chain] ERROR: Failed to parse continuation: %s",
        $cont_intake->{error} // 'unknown error'
    );

    # Return accumulated result on error
    <[base.callback.cmd_reply]>->(
        $meta_job->{'reply_id'},
        { 'mode' => 'false', 'data' => 'error during continuation' }
    );

    $meta_job->{'status'} = 'error';
    $cancel_watcher->();
    return;
}

my $cont_task = $cont_intake->{task};

# Analyze continuation task
my $cont_analysis = <[coding.task.analyze]>->( 'full', $cont_task );

if ( !$cont_analysis->{success} ) {
    <[base.callback.cmd_reply]>->(
        $meta_job->{'reply_id'},
        { 'mode' => 'false', 'data' => 'error analyzing continuation' }
    );

    $meta_job->{'status'} = 'error';
    $cancel_watcher->();
    return;
}

my $cont_analyzed = $cont_analysis->{task};

# Route continuation task
my $cont_routing = <[coding.routing.decide_service]>->( 'route', $cont_analyzed );

if ( !$cont_routing->{success} ) {
    <[base.callback.cmd_reply]>->(
        $meta_job->{'reply_id'},
        { 'mode' => 'false', 'data' => 'error routing continuation' }
    );

    $meta_job->{'status'} = 'error';
    $cancel_watcher->();
    return;
}

my $cont_routed = $cont_routing->{task};

# Enqueue continuation task
my $cont_queue = <[coding.task.queue]>->( 'enqueue', $cont_routed );

if ( !$cont_queue->{success} ) {
    <[base.callback.cmd_reply]>->(
        $meta_job->{'reply_id'},
        { 'mode' => 'false', 'data' => 'error queueing continuation' }
    );

    $meta_job->{'status'} = 'error';
    $cancel_watcher->();
    return;
}

# Update meta job with new task ID
$meta_job->{'task_id'} = $cont_routed->{id};
$meta_job->{'task'} = $cont_routed;

<[base.logs]>->(
    1, "[check-completion-chain] spawned continuation: task=%s",
    $cont_routed->{id}
);

