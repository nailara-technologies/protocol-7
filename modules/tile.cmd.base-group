## [:< ##

# name  = tile.cmd.base-group
# descr = return current 'fallback' tile group name

return {
    'mode' => qw| false |,
    'data' => 'fallback_tile_group is undefined!'
    }
    if not defined <tile.fallback_tile_group>;

return { 'mode' => qw| true |, 'data' => <tile.fallback_tile_group> }

