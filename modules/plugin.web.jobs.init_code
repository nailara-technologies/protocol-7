## [:< ##

# name  = plugin.web.jobs.init_code
# descr = initialize jobs web plugin, register template aliases

## register template command aliases for use in .tmpl files ##
for my $suffix (qw| list stats |) {
    my $full  = "plugin.web.jobs.$suffix";
    my $alias = "web.jobs.$suffix";
    $code{$alias} = $code{$full} if exists $code{$full};
}

$code{'web.jobs.data'} = $code{'plugin.web.jobs.handler.get'}
    if exists $code{'plugin.web.jobs.handler.get'};
$code{'web.jobs.sync'} = $code{'plugin.web.jobs.handler.sync'}
    if exists $code{'plugin.web.jobs.handler.sync'};

<[base.logs]>->( 1, 'plugin.web.jobs : initialized' );

0;

