## [:< ##

# name  = plugin.web.jobs.init_code
# descr = initialize jobs web plugin, register template aliases

## load shared perl modules once at init ##
<[base.perlmod.autoload]>->('JSON::XS');
<[base.perlmod.autoload]>->('YAML::XS');

## ensure web-owned jobs cache dir exists [ var_P7/web/jobs/ ] ##
my %_web_zenka_identity = (
    httpd => {
        user  => <httpd.system.user>  // qw| httpd |,
        group => <httpd.system.group> // qw| httpd |
    },
    httpsd => {
        user  => <httpsd.system.user>  // qw| httpsd |,
        group => <httpsd.system.group> // qw|  httpd |
    },
    ##[ protocol-7 user, primary group ]##
    web => { user => <system.amos-zenka-user> },
);
if ( exists $_web_zenka_identity{<system.zenka.name>} ) {
    my $id = $_web_zenka_identity{<system.zenka.name>};
    <system.zenka-user.current>  //= $id->{'user'};
    <system.zenka-group.current> //= $id->{'group'};
}
<[base.path-set-up.check-zenka-paths]>->(
    TRUE, 0750, FALSE, 0700, 'jobs', TRUE
);

## ensure status subdirectories exist under web jobs root ##
my $cache_dir = <[plugin.web.jobs.cache.path]>;
my $user      = <system.zenka-user.current> // <system.amos-zenka-user>
    // qw| protocol-7 |;
my $group = <system.zenka-group.current> // $user;

for my $status ( qw| new review apply applied interviewed rejected skipped |,
    qw| blocked deleted | ) {
    my $dir = "$cache_dir/$status";
    next if -d $dir;
    <[file.make_path]>->( $dir, 0750, $user, $group );
}

## load any reverse-change queue that was persisted before a restart       ##
## (browser delete/reassess actions would otherwise be lost on web reload) ##
my $reverse_file = "$cache_dir/reverse-pending.yaml";
if ( -f $reverse_file ) {
    my $loaded = eval { YAML::XS::LoadFile($reverse_file) };
    if ( ref $loaded eq 'ARRAY' and @{$loaded} ) {
        <plugin.web.jobs.reverse> = $loaded;
        <[base.logs]>->(
            1,
            'plugin.web.jobs : loaded %d pending reverse entries',
            scalar @{$loaded}
        );
    }
}

## pre-warm in-memory job cache and index ##
my $loaded = <[plugin.web.jobs.cache.read_all]>;
my $count  = scalar keys %{$loaded};
<[base.logs]>->(
    1, 'plugin.web.jobs : initialized [ %d jobs loaded ]', $count
);

## build active jobsite id set from directory scan (index.yaml is incomplete) ##
my $jobsite_root = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite jobs |;
my %active_id;
for my $status (qw| new review apply applied interviewed rejected skipped |) {
    my $dir = "$jobsite_root/$status";
    next if not -d $dir;
    opendir my $dh, $dir or next;
    for my $fn ( grep { /\.yaml$/ && !/^\./ } readdir($dh) ) {
        my $enc_id = $fn;
        $enc_id =~ s/\.yaml$//;
        my $id = <[base.vax-int.decode]>->($enc_id);
        $active_id{$id} = $status if length $id;
    }
    closedir $dh;
}

## prune loaded web-cache entries that jobsite no longer considers active ##
## (trash/deleted/blocked jobs whose stale cache files survived sync)      ##
if (%active_id) {
    my @stale = grep { not exists $active_id{$_} } keys %{$loaded};
    for my $id (@stale) {
        my $enc_id    = <[base.vax-int.encode]>->($id);
        my $st_status = <plugin.web.jobs.index>->{$id} // '';
        my $st_path   = '';
        if ( $st_status =~ m{^(blocked|deleted):(.+)$} ) {
            $st_path = "$cache_dir/$1/$2/$enc_id.yaml";
        } elsif ( length $st_status ) {
            $st_path = "$cache_dir/$st_status/$enc_id.yaml";
        }
        unlink $st_path if length $st_path and -f $st_path;
        delete <plugin.web.jobs.cache>->{$id}
            if ref <plugin.web.jobs.cache> eq 'HASH';
        delete <plugin.web.jobs.index>->{$id}
            if ref <plugin.web.jobs.index> eq 'HASH';
    }
    <[base.logs]>->(
        1,
        'plugin.web.jobs : pruned %d stale cache entries',
        scalar @stale
    ) if @stale;
}

## backfill fields that jobsite gained after the web cache was created ##
## (city is sometimes present in jobsite yaml but missing in web cache) ##
my $backfilled = 0;
for my $id ( keys %active_id ) {
    next if not exists $loaded->{$id};

    my $need_city       = not length( $loaded->{$id}{'city'}       // '' );
    my $need_date_added = not length( $loaded->{$id}{'date_added'} // '' );
    next if not $need_city and not $need_date_added;

    my $status  = $active_id{$id};
    my $enc_id  = <[base.vax-int.encode]>->($id);
    my $js_file = "$jobsite_root/$status/$enc_id.yaml";
    next if not -f $js_file;

    my $js_job = eval { YAML::XS::LoadFile($js_file) };
    next if ref $js_job ne qw| HASH |;

    my $now          = <[base.ntime.b32]>;
    my $cache_status = <plugin.web.jobs.index>->{$id} // $status;
    my $cache_file   = "$cache_dir/$cache_status/$enc_id.yaml";
    next if not -f $cache_file;

    my $cached = eval { YAML::XS::LoadFile($cache_file) };
    next if ref $cached ne qw| HASH |;

    my $changed = 0;

    if ($need_city) {
        my $city = $js_job->{'city'} // '';
        if ( length $city ) {
            $loaded->{$id}{'city'} = $city;
            $cached->{'city'}      = $city;
            $changed               = 1;
        }
    }

    if ($need_date_added) {
        my $date_added  = '';
        my $date_posted = $js_job->{'date_posted'} // '';
        if ( length $date_posted
            and $date_posted =~ m{^(\d{4})-(\d{2})-(\d{2})} ) {
            $date_added = "$1-$2-$3";
        } else {
            my $fetched_at = $js_job->{'fetched_at'} // '';
            if ( length $fetched_at and $fetched_at =~ m{^\d+$} ) {
                my ( $d, $m, $y )
                    = ( localtime($fetched_at) )[ 3, 4, 5 ];
                $date_added
                    = sprintf( '%04d-%02d-%02d', $y + 1900, $m + 1, $d );
            }
        }
        if ( length $date_added ) {
            $loaded->{$id}{'date_added'} = $date_added;
            $cached->{'date_added'}      = $date_added;
            $changed                     = 1;
        }
    }

    if ($changed) {
        $loaded->{$id}{'last_modified'} = $now;
        $cached->{'last_modified'} = $now;
        my $tmp = "$cache_file.tmp";
        eval { YAML::XS::DumpFile( $tmp, $cached ) };
        rename $tmp, $cache_file if -f $tmp;
        $backfilled++;
    }
}
<[base.logs]>->(
    1, 'plugin.web.jobs : backfilled %d cache entries', $backfilled
) if $backfilled;

## remove deprecated cache directories that read_all no longer scans  ##
## (legacy assessed/ and trash epoch dirs left by older sync code)    ##
for my $dep_dir ( "$cache_dir/assessed", glob("$cache_dir/trash*") ) {
    next if not -d $dep_dir;
    my $removed = 0;
    if ( opendir my $dh, $dep_dir ) {
        while ( my $fn = readdir($dh) ) {
            next if $fn =~ m{^\.};
            my $path = "$dep_dir/$fn";
            if ( -f $path ) {
                unlink $path;
                $removed++;
            } elsif ( -d $path ) {
                opendir my $sdh, $path or next;
                for my $sfn ( grep { !/^\./ } readdir($sdh) ) {
                    unlink "$path/$sfn" if -f "$path/$sfn";
                }
                closedir $sdh;
                rmdir $path;
            }
        }
        closedir $dh;
    }
    rmdir $dep_dir;
    <[base.logs]>->(
        1, 'plugin.web.jobs : removed deprecated cache dir %s (%d files)',
        $dep_dir, $removed
    ) if $removed;
}

0;

