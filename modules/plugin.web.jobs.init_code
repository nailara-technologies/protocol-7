## [:< ##

# name  = plugin.web.jobs.init_code
# descr = initialize jobs web plugin, register template aliases

## load shared perl modules once at init ##
<[base.perlmod.autoload]>->('JSON::XS');
<[base.perlmod.autoload]>->('YAML::XS');

## ensure httpd-owned jobs cache dir exists [ var_P7/httpd/jobs/ ] ##
<[base.path-set-up.check-zenka-paths]>->( TRUE, 0750, FALSE, 0700, 'jobs' );

<[base.logs]>->( 1, 'plugin.web.jobs : initialized' );

0;

