# name = web.assets.update_status
# descr = Update asset status in the registry

my ( $asset_path, $new_status ) = @_;

return unless exists $data{'web'}{'assets'}{'registry'}{$asset_path};

$data{'web'}{'assets'}{'registry'}{$asset_path}{status}         = $new_status;
$data{'web'}{'assets'}{'registry'}{$asset_path}{last_validated} = time();

return TRUE;

0;

