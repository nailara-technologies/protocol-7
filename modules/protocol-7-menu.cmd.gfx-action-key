## [:< ##

# name  = protocol-7-menu.cmd.gfx-action-key
# param = <keycode> [m-key]
# descr = report X-11 action key press

my $action_key_params_str = $call->{'args'};
return {
    'mode' => qw| false |,
    'data' => 'expected at least key-code parameter'
    }
    if not defined $action_key_params_str;

( my $key_code, my $MOD_code ) = split( m| +|, $action_key_params_str );

return {
    'mode' => qw| false |,
    'data' => 'expected at least key-code parameter'
    }
    if $key_code !~ m|^\d{1,3}$|;
return {
    'mode' => qw| false |,
    'data' => 'mod-key code not numerical'
    }
    if defined $MOD_code and $MOD_code !~ m|^\d{1,3}$|;

$MOD_code //= 0;

my $action_key_href = <protocol-7-menu.action-keys.graphical> //= {};

return { 'mode' => qw| false |, 'data' => 'no such key configured' }
    if not exists $action_key_href->{$MOD_code}
    or not exists $action_key_href->{$MOD_code}->{$key_code};

## Execute the configured action for this key
my $action_config = $action_key_href->{$MOD_code}->{$key_code};
my $action_result;

if ( defined $action_config->{callback}
    && ref $action_config->{callback} eq 'CODE' ) {
    eval { $action_config->{callback}->(); };
    return {
        'mode' => qw| false |,
        'data' => "callback error [ details logged ]"
        }
        if length $EVAL_ERROR;
} elsif ( defined $action_config->{command} ) {
    my $cmd = $action_config->{command};
    qx| $cmd |;
    return {
        'mode' => qw| false |,
        'data' => "command execution failed: $?"
        }
        if $?;
} else {
    return { 'mode' => qw| false |, 'data' => 'action not configured' };
}

<[base.logs]>->(
    1,         "executed action for key %d with mod %d",
    $key_code, $MOD_code
);

return { 'mode' => qw| true |, 'data' => 'action executed' };

