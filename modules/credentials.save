## [:< ##

# name  = credentials.internal.save
# descr = encrypt and save a credential entry to disk

my $cred = shift;

return undef
    if ref $cred ne qw| HASH |
    or not defined $cred->{'name'}
    or not length $cred->{'name'};

my $cred_name = $cred->{'name'};
my $store_dir = <credentials.cfg.store_dir>;
my $file_path = $store_dir . $cred_name . '.yaml.enc';

## dump to yaml ##
my $yaml_str = eval { YAML::XS::Dump($cred) };
if ($@) {
    <[base.logs]>->(
        0,          'credentials: yaml dump failed for %s: %s',
        $cred_name, $@
    );
    return undef;
}

## generate nonce ##
my $nonce_size = <credentials.cfg.nonce_size>;
my $nonce      = <base.prng.fortuna>->bytes($nonce_size);

## derive encryption key ##
my $instance_id  = <protocol-7.instance-id> // qw| protocol-7 |;
my $key_material = $nonce . $cred_name . $instance_id;
my $sym_key      = AMOS7::13::key_32( \$key_material );

if ( not defined $sym_key or not length $sym_key ) {
    <[base.logs]>->(
        0, 'credentials: key derivation failed for %s', $cred_name
    );
    return undef;
}

while ( length($sym_key) < 32 ) {
    $sym_key .= "\0";
}

my $status
    = AMOS7::Twofish::key_init( $sym_key, qw| encryption credentials | );
if ( not defined $status or not $status ) {
    <[base.logs]>->(
        0, 'credentials: twofish key init failed for %s', $cred_name
    );
    return undef;
}

my $encrypted_ref = AMOS7::Twofish::encrypt( qw| credentials |, \$yaml_str );

AMOS7::Twofish::delete_table_entry(qw| encryption credentials |);

if (   not defined $encrypted_ref
    or ref $encrypted_ref ne qw| SCALAR |
    or not length $encrypted_ref->$* ) {
    <[base.logs]>->( 0, 'credentials: encryption failed for %s', $cred_name );
    return undef;
}

## write nonce + ciphertext ##
my $write_ok = <[file.put_bin]>->( $file_path, $nonce . $encrypted_ref->$* );

if ( not $write_ok ) {
    <[base.logs]>->( 0, 'credentials: failed to write %s', $file_path );
    return undef;
}

chmod 0600, $file_path;

return TRUE;

