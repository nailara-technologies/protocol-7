## [:< ##

# name  = credentials.save
# descr = encrypt and save a credential entry to disk using archive format

my $cred = shift;

return undef
    if ref $cred ne qw| HASH |
    or not defined $cred->{'name'}
    or not length $cred->{'name'};

my $cred_name = $cred->{'name'};
my $store_dir = <credentials.cfg.store_dir>;
my $file_path = $store_dir . $cred_name . '.yaml.enc';

## pack into archive payload ##
my $payload_ref = <[credentials.pack_format.archive]>->($cred);
return undef unless defined $payload_ref;

## derive archive encryption password from system constants ##
my $instance_id = <protocol-7.instance-id> // qw| protocol-7 |;
my $enc_pwd     = $cred_name . ':' . $instance_id;

## write encrypted archive ##
my $write_ok = <[credentials.write_archive_file]>->(
    $file_path, $enc_pwd, $payload_ref, TRUE
);

if ( not $write_ok ) {
    <[base.logs]>->(
        0, 'credentials: failed to write archive %s', $file_path
    );
    return undef;
}

chmod 0600, $file_path;

return TRUE;

