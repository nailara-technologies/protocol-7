## [:< ##
# name  = plan-9.server.handle_attach
# descr = Handle 9P Tattach/Rattach

my ( $client, $tag, $data ) = @ARG;

my $fid  = <[plan-9.protocol.codec.decode-uint32]>->( substr( $data, 0, 4 ) );
my $afid = <[plan-9.protocol.codec.decode-uint32]>->( substr( $data, 4, 4 ) );

my ( $uname, $rest )
    = <[plan-9.protocol.codec.decode-string]>->( substr( $data, 8 ) );
my ( $aname, $rest2 ) = <[plan-9.protocol.codec.decode-string]>->($rest);

$client->{uname} = $uname;
$client->{aname} = $aname;

# Root Qid - type directory, version 0, path 0
my $root_qid = <[plan-9.protocol.codec.encode-qid]>->(
    <plan-9.protocol.constants.QTDIR>,
    0, 0
);

$client->{fids}{$fid} = {
    type => 'root',
    qid  => {
        type    => <plan-9.protocol.constants.QTDIR>,
        version => 0,
        path    => 0
    },
    path => '/',
};

return <[plan-9.protocol.codec.encode-message]>->(
    <plan-9.protocol.constants.Rattach>,
    $tag, $root_qid
);

