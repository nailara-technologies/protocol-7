## [:< ##

# name  = context.module.dep_graph
# descr = build full bidirectional dependency graph for a file set

my $params = shift // {};

my $pattern   = $params->{'pattern'}   // '';
my $files     = $params->{'files'}     // [];
my $namespace = $params->{'namespace'} // '';

## resolve file list ##
my @file_list;

if (@$files) {
    @file_list = @$files;
} elsif ( length $pattern ) {
    @file_list = glob "modules/$pattern";
} elsif ( length $namespace ) {
    @file_list = glob "modules/$namespace.*";
} else {
    @file_list = glob 'modules/*';
}

@file_list = grep { -f $ARG } @file_list;

return { 'mode' => qw| false |, 'data' => 'no files matched' }
    unless @file_list;

## normalize to module names ##
my %file_set;
foreach my $f (@file_list) {
    ( my $name = $f ) =~ s|^modules/||;
    $file_set{$name} = $f;
}

## extract edges ##
my %nodes;
my @edges;

foreach my $name ( sort keys %file_set ) {
    my $path = $file_set{$name};

    open my $fh, '<', $path or next;
    my $content = do { local $/; <$fh> };
    close $fh;

    ## estimate size ##
    my $chars = length $content;
    $nodes{$name} = {
        'module'      => $name,
        'path'        => $path,
        'size_chars'  => $chars,
        'size_tokens' => int( $chars / <context.cfg.chars_per_token> )
    };

    ## outgoing calls ##
    my %seen;

    ## <[module.name]> syntax ##
    while ( $content =~ m|<\[([a-z][a-z0-9._-]+)\]>|g ) {
        my $target = $1;
        next if $seen{$target}++;
        push @edges,
            { 'from' => $name, 'to' => $target, 'type' => qw| calls | };
    }

    ## $code{'module.name'} syntax ##
    while ( $content =~ m|\$code\{'([a-z][a-z0-9._-]+)'\}|g ) {
        my $target = $1;
        next if $seen{$target}++;
        push @edges,
            { 'from' => $name, 'to' => $target, 'type' => qw| dynamic | };
    }
}

## filter edges to file set [ internal edges only ] ##
my @internal = grep { exists $file_set{ $ARG->{'to'} } } @edges;
my @external = grep { not exists $file_set{ $ARG->{'to'} } } @edges;

## build adjacency for SCC detection ##
my %adj;
my %radj;
foreach my $e (@internal) {
    push $adj{ $e->{'from'} }->@*, $e->{'to'};
    push $radj{ $e->{'to'} }->@*,  $e->{'from'};
}

## kosaraju SCC — pass 1: finish order ##
my %visited;
my @finish_order;

my $dfs_forward;
$dfs_forward = sub {
    my $node = shift;
    return if $visited{$node};
    $visited{$node} = 1;
    foreach my $next ( ( $adj{$node} // [] )->@* ) {
        $dfs_forward->($next);
    }
    push @finish_order, $node;
};

$dfs_forward->($ARG) for sort keys %file_set;

## pass 2: reverse graph, assign components ##
%visited = ();
my @clusters;

my $dfs_reverse;
$dfs_reverse = sub {
    my ( $node, $component ) = @_;
    return if $visited{$node};
    $visited{$node} = 1;
    push @$component, $node;
    foreach my $prev ( ( $radj{$node} // [] )->@* ) {
        $dfs_reverse->( $prev, $component );
    }
};

for my $node ( reverse @finish_order ) {
    next if $visited{$node};
    my @component;
    $dfs_reverse->( $node, \@component );
    push @clusters, [ sort @component ] if @component;
}

return {
    'mode' => qw| true |,
    'data' => {
        'nodes'          => \%nodes,
        'edges'          => \@edges,
        'internal_edges' => \@internal,
        'external_edges' => \@external,
        'clusters'       => \@clusters,
        'file_count'     => scalar keys %file_set,
        'edge_count'     => scalar @edges
    }
};

