# name  = powershell.cmd.pointer-stream
# descr = start pointer hook process writing coords to shm

my $result = <[powershell.pointer-stream]>;
return {
    'mode' => defined $result && $result ? qw| true | : qw| false |,
    'data' => defined $result && $result
    ? 'pointer-stream started'
    : 'pointer-stream failed or already running',
};

