# name  = mpv.job.deferred_send_command
# descr = send a buffered mpv ipc command once the socket dep resolves

my $job = shift                         // {};
my $cmd = $job->{'params'}->{'command'} // return;

if ( not defined <mpv.socket> ) {
    <[base.log]>->( 0, '[deferred_send_command] socket still unavailable' );
    return;
}

<[base.s_write]>->( <mpv.socket>, $cmd );

