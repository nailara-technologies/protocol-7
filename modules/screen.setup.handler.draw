## [:< ##

# name  = screen.setup.handler.draw
# descr = draw the discovered monitor rects to scale with offsets + labels;
#         the voids between staggered monitors show through as the dim
#         background, making the real virtual-desktop shape legible

my ( $id, $widget, $context ) = @ARG;

return TRUE if not defined $id;

my $inst = $data{'screen-setup'}{'instances'}{$id};
return TRUE if not defined $inst;

my $model    = $inst->{'model'};
my $monitors = $model->{'monitors'};

my $w = $widget->get_allocated_width  // 900;
my $h = $widget->get_allocated_height // 620;

## luminous translucent blue field : this is the lit area, the monitors  ##
## sit in it as darker glass panels [ the voids between them show this    ##
## field through, so the real desktop shape reads as the lit negative ]   ##
$context->set_operator('source');
$context->set_source_rgba( 0.055, 0.185, 0.470, 0.62 );
$context->paint;
$context->set_operator('over');

## drag-handle band around the edge : the same dark glass tone as the    ##
## monitor panels below, so the boundary reads as a dark frame holding    ##
## the luminous field [ stroke line-width = border, centered on the inset ##
## rect, fills the outer band exactly ]; keep $border in sync with        ##
## screen.setup.handler.button_press, and the colour in sync with the     ##
## monitor glass fill further down                                        ##
my $border = 26;
$context->set_source_rgba( 0.0, 0.015, 0.075, 0.74 );
$context->set_line_width($border);
$context->rectangle( $border / 2, $border / 2, $w - $border, $h - $border );
$context->stroke;

## faint inner edge where the dark band meets the field ##
$context->set_source_rgba( 0.0, 0.0, 0.0, 0.25 );
$context->set_line_width(1);
$context->rectangle(
    $border + 0.5,
    $border + 0.5,
    $w - 2 * $border - 1,
    $h - 2 * $border - 1
);
$context->stroke;

## fit the whole virtual bounding box into the inner content area, aspect ##
## preserved + centered, with breathing room inside the band              ##
my $gap     = 14;
my $pad     = $border + $gap;
my $inner_w = $w - 2 * $pad;
my $inner_h = $h - 2 * $pad;
my $bbox_w  = $model->{'width'}  || 1;
my $bbox_h  = $model->{'height'} || 1;

my $scale   = $inner_w / $bbox_w;
my $scale_y = $inner_h / $bbox_h;
$scale = $scale_y if $scale_y < $scale;

## center the scaled layout within the inner area ##
my $off_x = $pad + ( $inner_w - $bbox_w * $scale ) / 2;
my $off_y = $pad + ( $inner_h - $bbox_h * $scale ) / 2;

## map a virtual coordinate to device space ##
my $map_x = sub { $off_x + ( $_[0] - $model->{'min_x'} ) * $scale };
my $map_y = sub { $off_y + ( $_[0] - $model->{'min_y'} ) * $scale };

## custom display font when it loaded, else the cairo toy font ##
my $font_face = <screen.setup.font.face>;
$context->set_font_face($font_face) if defined $font_face;

for my $m (@$monitors) {
    my $dx = $map_x->( $m->{'x'} );
    my $dy = $map_y->( $m->{'y'} );
    my $dw = $m->{'width'} * $scale;
    my $dh = $m->{'height'} * $scale;

    ## dark glass panel : the monitor reads as a dense dark screen set    ##
    ## into the luminous field, opaque enough to settle the wallpaper      ##
    ## bleed-through and let the labels read cleanly                       ##
    $context->set_source_rgba( 0.0, 0.015, 0.075, 0.74 );
    $context->rectangle( $dx, $dy, $dw, $dh );
    $context->fill;

    ## crisp luminous border, primary a touch stronger ##
    my $alpha = $m->{'primary'} ? 1.0 : 0.9;
    $context->set_source_rgba( 0.10, 0.45, 0.95, $alpha );
    $context->set_line_width( $m->{'primary'} ? 2.5 : 1.5 );
    $context->rectangle( $dx + 0.5, $dy + 0.5, $dw - 1, $dh - 1 );
    $context->stroke;

    ## labels : name, resolution, then offset -- centered in the rect ##
    my $label = length $m->{'name'} ? $m->{'name'} : "monitor-$m->{'index'}";
    my $dims  = sprintf '%dx%d',  $m->{'width'}, $m->{'height'};
    my $offs  = sprintf '+%d+%d', $m->{'x'},     $m->{'y'};

    my $cx = $dx + $dw / 2;

    ## muted steel-blue labels [ calmer than the previous near-white ] ##
    $context->set_source_rgba( 0.60, 0.72, 0.90, 0.92 );
    $context->set_font_size(16);
    my $le = $context->text_extents($label);
    $context->move_to( $cx - $le->{'width'} / 2 - $le->{'x_bearing'},
        $dy + $dh / 2 - 10 );
    $context->show_text($label);

    $context->set_font_size(13);
    my $de = $context->text_extents($dims);
    $context->move_to( $cx - $de->{'width'} / 2 - $de->{'x_bearing'},
        $dy + $dh / 2 + 8 );
    $context->show_text($dims);

    $context->set_source_rgba( 0.46, 0.58, 0.80, 0.82 );
    my $oe = $context->text_extents($offs);
    $context->move_to( $cx - $oe->{'width'} / 2 - $oe->{'x_bearing'},
        $dy + $dh / 2 + 24 );
    $context->show_text($offs);
}

## title line, centered on the top drag band ##
$context->set_source_rgba( 0.023529, 0.278431, 0.764706, 0.95 );
$context->set_font_size(14);
my $title = sprintf '.:[ display layout : %d monitors : %dx%d virtual ]:.',
    scalar @$monitors, $model->{'width'}, $model->{'height'};
my $tie = $context->text_extents($title);
$context->move_to( ( $w - $tie->{'width'} ) / 2 - $tie->{'x_bearing'},
    $border / 2 + $tie->{'height'} / 2 );
$context->show_text($title);

return TRUE;

