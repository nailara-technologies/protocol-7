## [:< ##

# name  = branch.route.key.request
# descr = request missing key for a route segment
# param = { node_id, route_id }

my $params   = shift                 // {};
my $node_id  = $params->{'node_id'}  // '';
my $route_id = $params->{'route_id'} // '';

return { 'mode' => 'false', 'data' => 'node id required' }
    unless length $node_id;
return { 'mode' => 'false', 'data' => 'route id required' }
    unless length $route_id;

my $req_pubkey = $keys{'public'} // '';

my $args = eval {
    YAML::XS::Dump(
        {   'node_id'          => $node_id,
            'route_id'         => $route_id,
            'requestor_pubkey' => $req_pubkey,
        }
    );
};
$args = '' if not defined $args;

<[protocol-7.route-send]>->(
    {   'command'   => 'discover.key.request',
        'call_args' => { 'args' => $args },
        'reply'     => {
            'handler' => 'branch.route.key.handler.reply',
            'params'  => {
                'node_id'  => $node_id,
                'route_id' => $route_id,
            },
        },
    }
);

return { 'mode' => 'true', 'data' => 'requested' };

