## [:< ##
# name  = plan-9.client.read
# descr = Read file from 9P server

use strict;
use warnings;

return sub {
    my ( $client, $fid, $offset, $count ) = @_;
    $offset //= 0;
    $count  //= $client->{msize} // 8192;

    my $req
        = <[plan-9.protocol.codec.encode-uint32]>->($fid)
        . <[plan-9.protocol.codec.encode-uint64]>->($offset)
        . <[plan-9.protocol.codec.encode-uint32]>->($count);

    my $msg = <[plan-9.protocol.codec.encode-message]>->(
        <plan-9.protocol.constants.Tread>,
        4, $req
    );

    $client->{socket}->send($msg);

    my $resp = <[plan-9.client.read-message]>->($client);
    return $resp if $resp->{'mode'} eq 'false';

    my $data = $resp->{'data'};
    my $len
        = <[plan-9.protocol.codec.decode-uint32]>->( substr( $data, 0, 4 ) );
    my $content = substr( $data, 4, $len );

    return { 'mode' => 'true', 'data' => $content };
};

