# name = coding.task.complete
# descr = mark coding task as completed
# purpose = coding task management : wrapper around jobqueue.move_job to mark job complete

my ( $job_id, $result ) = @ARG;

return {
    success => FALSE,
    error   => 'job_id required'
    }
    unless defined $job_id;

# Get job data before moving to verify it exists
my $job_data = <[jobqueue.get_job_data]>->($job_id);

return {
    success => FALSE,
    error   => "task not found : $job_id"
    }
    unless defined $job_data;

# Move job to completed queue
<[jobqueue.move_job]>->( $job_id, 'completed' );

return {
    success => TRUE,
    job_id  => $job_id,
    task_id => $job_data->{object_id},
    result  => $result,
    message => "task completed : $job_id"
};

