## [:< ##

# name    = coding.task.complete
# descr   = mark coding task as completed
# purpose = coding task management
#           [ wrapper around jobqueue.move_job to mark job complete ]

my ( $task_id, $result ) = @ARG;

return {
    success => FALSE,
    error   => 'task_id required'
    }
    unless defined $task_id;

# Get task from coding task queue
my $queue_href = <coding.task.queue>;
my $task       = $queue_href->{$task_id};

return {
    success => FALSE,
    error   => "task not found : '$task_id'"
    }
    unless defined $task;

# Update task execution status
$task->{'execution'}->{'status'}    = qw| completed |;
$task->{'execution'}->{'result'}    = $result;
$task->{'execution'}->{'success'}   = TRUE;
$task->{'execution'}->{'completed'} = <[base.time]>->(3);

# Move task to completed list
my $aref_pending   = <coding.task.pending>;
my $aref_completed = <coding.task.completed>;

$aref_pending->@* = grep { $ARG ne $task_id } $aref_pending->@*;
push $aref_completed->@*, $task_id;

<[base.logs]>->( 2, "task completed : %s", $task_id );

# Trigger task completion event handler (checks for auto-resume)
<[coding.event.on_task_complete]>->( $task_id, $result );

return {
    success => TRUE,
    task_id => $task_id,
    result  => $result,
    message => "task completed : $task_id"
};

