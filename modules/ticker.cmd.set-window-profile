## [:< ##

# name  = ticker.cmd.set-window-profile
# descr = switch window placement profile at runtime

my $profile = $call->{'args'} // 'bottom-strip';

my $valid_profiles = qr{^(fullscreen|bottom-strip|top-strip
          |bottom-right|top-right|center|saved|config)$}x;

if ( $profile !~ $valid_profiles ) {
    return {
        'mode' => qw| false |,
        'data' => "invalid profile '$profile'"
    };
}

<ticker.window.profile> = $profile;

## recalculate and apply ##
my $window = <ticker.obj.window>;

if ( not defined $window ) {
    return {
        'mode' => qw| false |,
        'data' => 'ticker window not initialized'
    };
}

my $screen = <[window.gtk.get_screen_size]>;

## in swap mode the ticker can be constrained to a selected monitor.  the    ##
## default is to span the full virtual desktop because WSLg/XWayland monitor  ##
## geometry is not always reliable; set ticker.window.monitor to follow-     ##
## pointer, primary, index:N or cycle to enable per-monitor placement.       ##
my ( $base, $monitor );
if ( <[base.cfg_bool]>->(<ticker.mouse.swap_edge>) ) {
    my $mode = <ticker.window.monitor> // qw| full-desktop |;
    if ( $mode ne qw| full-desktop | ) {
        $monitor = <[ticker.select_monitor]>;
    }
}
$base = $monitor // $screen;

my $geo = <[window.profile.calculate]>->(
    {   profile  => $profile,
        screen_w => $base->{'width'},
        screen_h => $base->{'height'}
    }
);

if ( defined $monitor ) {
    $geo->{'x'} += $monitor->{'x'};
    $geo->{'y'} += $monitor->{'y'};
}

<[window.gtk.profile.apply]>->( $window, $geo );

## update legacy coordinate vars ##
<x11.window.width>       = $geo->{'width'};
<x11.window.height>      = $geo->{'height'};
<x11.coordinates.left>   = $geo->{'x'};
<x11.coordinates.top>    = $geo->{'y'};
<x11.coordinates.right>  = $geo->{'x'} + $geo->{'width'};
<x11.coordinates.bottom> = $geo->{'y'} + $geo->{'height'};

<[base.logs]>->(
    2,
    ': ticker geometry set: x=%d y=%d w=%d h=%d [monitor=%s]',
    $geo->{'x'},
    $geo->{'y'},
    $geo->{'width'},
    $geo->{'height'},
    $monitor->{'source'} // 'full-desktop'
);

return {
    'mode' => qw| true |,
    'data' => "window profile: $profile"
};

