## [:< ##

# name  = user-edit.form.schema_from_record
# descr = derive an editor.control schema from a users.* record envelope
# param = $record [ , $submit_on ]

## the record's settings payload is deliberately open [ users-zenka.yaml : no
## declared settings field list exists anywhere yet ], so the form schema is
## DERIVED at runtime from whatever keys the record actually carries, rather
## than declared here.  when a real field list eventually exists this stays
## valid — typed/enum/validator field defs then merge on top of what this
## returns, they do not replace it.
##
## every field is a freeform_line : editor.control.create rejects every other
## type as interface-only, and no setting is known to be enum- or secret-
## shaped yet [ user-edit-console-zenka.yaml : field_types_needed ]

my ( $record, $submit_on ) = @ARG;

return undef if ref $record ne qw| HASH |;

my $fields = $record->{'fields'};
$fields = {} if ref $fields ne qw| HASH |;

my @field_defs;

## which list fields re-sort the moment focus ENTERS them, mid-session --
## editor.control.list.expand reads the per-field 'sort_on_focus' flag below
## and stays entirely unaware of WHY [ generic, zenka-agnostic machinery ].
##
## DUPLICATES users.record.sorted_fields's list rather than calling it :
## user-edit and users are SEPARATE zenka processes, each with its own
## compiled %code -- <[users.record.sorted_fields]> is not reachable from here
## at all [ confirmed live : 'subroutine not defined', the same reason
## user-edit talks to users only over the cube link, e.g.
## user-edit.console.show-form's N.users.value-get ], and loading the whole
## users.* module family into user-edit's deliberately narrow modules.load [
## see this zenka's start file header ] just to reach one two-item list would
## be a much larger coupling than the duplication it avoids.  keep the two
## lists in sync by hand if the vocabulary ever changes
my %sort_on_focus = map { $ARG => TRUE } qw| contact phone |;

## which SCALAR fields render/edit as multiple windowed display rows instead
## of one -- see user-edit-multiline-note.yaml.  NOT hand-duplicated like
## %sort_on_focus above : user-edit.form.add_field needs this SAME list too [
## found live -- a freshly-added field was single-line until save+reload, see
## that module's own name-list header for the full account ], and both call
## sites live in this one zenka's process, so one shared module is correct
## here rather than two copies drifting
my %multiline = map { $ARG => TRUE } <[user-edit.form.multiline_field_names]>;

## DISPLAY order, not storage order : base.reverse-sort [ length descending,
## alphabetical-descending tiebreak -- see base.each_sort / base.cmd.commands
## for the same idiom elsewhere ] rather than a plain alphabetical `sort`, per
## user.  takes the HASHREF directly [ base.context.list expands it to keys ],
## the same call shape base.diff.hash_keys / base.each_sort already use
foreach my $name ( <[base.reverse-sort]>->($fields) ) {

    ## ascii.frame slot tokens are \w+ [ ascii.frame.parse's own token regex
    ## ], so a field name that cannot become a slot name is skipped loudly
    ## here instead of rendering as a silently blank row
    if ( $name !~ m|^\w+$| ) {
        <[base.logs]>->(
            2, ': field name is not slot-safe, skipped [ %s ]', $name
        );
        next;
    }

    my $value = $fields->{$name} // '';

    ## an ARRAY becomes a LIST field : collapsed it draws as a count summary [
    ## editor.control.get_display_value ] and expands into one editable row
    ## per entry when entered.  the type stays freeform_line because
    ## editor.control.create accepts no other -- 'list' is metadata on the
    ## field def, and 'entries' is the authoritative value
    if ( ref $value eq qw| ARRAY | ) {
        push @field_defs,
            {
            qw| name |    => $name,
            qw| type |    => qw| freeform_line |,
            qw| default | => '',
            qw| list |    => TRUE,
            qw| entries | =>
                [ grep { defined $ARG and length $ARG } $value->@* ],
            qw| noun |          => qw| entr |,
            qw| noun_plural |   => qw| ies |,
            qw| noun_singular | => qw| y |,
            qw| sort_on_focus | => $sort_on_focus{$name} ? TRUE : FALSE,
            };
        next;
    }

    ## other nested structures have no freeform_line representation ##
    if ( length ref $value ) {
        <[base.logs]>->(
            2, ': field value is not a scalar, skipped [ %s ]', $name
        );
        next;
    }

    ## PLUGIN-PINNED key : per design doc data/yaml/coding-tasks/user-edit-
    ## plugin-detail-tabs.yaml, a field a plugin has pinned itself to stays a
    ## PLAIN SCALAR buffer [ get_value / submit / draft / outbox all keep
    ## working completely unmodified ] with only DISPLAY customised, via the
    ## GENERIC display_override hook editor.control.get_display_value now
    ## honours -- that module stays unaware this is "a plugin," it just calls
    ## a coderef.  readonly blocks ORDINARY typing before the field is entered
    ## [ user-edit.handler.stdin_key's Tab/Right trigger ] ; once entered [
    ## mode = 'plugin:<name>' ], that same handler routes every key straight
    ## to the plugin's own handler.key, bypassing editor.control.  process_key
    ## -- and process_key's readonly guard -- entirely, so this never blocks
    ## the plugin's OWN edits, only a stray keystroke that landed here before
    ## Tab/Right was pressed
    my $pinned_plugin = <user-edit.plugin.registry> {'by_key'}{$name};

    if ( defined $pinned_plugin ) {

        my $render_sub = sprintf( qw| %s.render |, $pinned_plugin );

        push @field_defs, {
            qw| name |             => $name,
            qw| type |             => qw| freeform_line |,
            qw| default |          => "$value",
            qw| readonly |         => TRUE,
            qw| plugin |           => $pinned_plugin,
            qw| display_override | => sub {
                my ( $render_state, $render_field ) = @ARG;
                return
                    exists $code{$render_sub}
                    ? $code{$render_sub}->( $render_state, $render_field )
                    : <[editor.control.get_value]>->(
                    $render_state, $render_field
                    );
            },
        };
        next;
    }

    push @field_defs, {
        qw| name | => $name,
        qw| type | => qw| freeform_line |,
        ## editor.buffer.memory.create reads the initial text from 'default' —
        ## NOT from a 'value' key
        qw| default |   => "$value",
        qw| multiline | => $multiline{$name} ? TRUE : FALSE,
    };
}

if ( not @field_defs ) {
    <[base.logs]>->(
        1,
        ': record has no editable scalar fields [ %s ]',
        $record->{'name'} // '?'
    );
    return undef;
}

return {
    qw| fields |       => \@field_defs,
    qw| active_field | => 0,
    qw| submit_on |    => $submit_on // qw| enter |,
};

