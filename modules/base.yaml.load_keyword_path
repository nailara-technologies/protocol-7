## [:< ##

# name  = base.yaml.load_keyword_path
# param = $keyword_path
# descr = Load YAML file using keyword paths [protocol-7] or [workspace-transfer]
# return = parsed YAML data or undef on error

my $path = shift;
return unless defined $path;

## Resolve keywords to actual path ##
my $resolved_path = <[base.path.resolve_keywords]>->($path);

## Load YAML file ##
my $data;
eval {
    $data = YAML::XS::LoadFile($resolved_path);
};

if ($@) {
    <[base.log]>->(
        0,
        "Error loading YAML file: $path (resolved: $resolved_path): $@"
    );
    return;
}

return $data;

