## [:< ##

# name  = context.cmd.review
# descr = command interface for the batch review pipeline
# param = $call [ args, param => { pattern, type, page_budget,
#                                   llm_cmd, output_dir } ]

my $call = shift // {};

## extract parameters from call structure ##
my $args  = $call->{'args'}  // '';
my $param = $call->{'param'} // {};

## parse args string: 'pattern [type]' ##
my ( $args_pattern, $args_type ) = $args =~ m|^\s*(\S+)(?:\s+(\S+))?\s*$|;

## parameter resolution: param hashref takes precedence over args string ##
my $pattern     = $param->{'pattern'}     // $args_pattern // '';
my $type        = $param->{'type'}        // $args_type    // qw| style |;
my $page_budget = $param->{'page_budget'} // 8000;
my $llm_cmd     = $param->{'llm_cmd'}     // '';
my $output_dir  = $param->{'output_dir'}  // 'data/review';

## validate pattern ##
return { 'mode' => qw| false |, 'data' => 'pattern required' }
    unless length $pattern;

## normalize review type ##
my @valid_types = qw| security style refactor dependency |;
my $type_valid  = grep { $_ eq $type } @valid_types;
$type = qw| style | unless $type_valid;

<[base.log]>->(
    1,     ':. review.cmd: starting %s review — pattern: %s :.',
    $type, $pattern
);

## step 1: create review plan ##
my $plan_result = <[context.review.plan]>->(
    {   'pattern'     => $pattern,
        'review_type' => $type,
        'page_budget' => $page_budget,
        'result_dir'  => $output_dir
    }
);

## handle plan failure ##
if ( $plan_result->{'mode'} ne qw| true | ) {
    my $error = $plan_result->{'data'} // 'plan creation failed';
    <[base.log]>->( 0, ':. review.cmd: plan failed — %s :.', $error );
    return { 'mode' => qw| false |, 'data' => $error };
}

my $plan = $plan_result->{'data'};

## check if any files matched ##
if ( ( $plan->{'total_files'} // 0 ) == 0 ) {
    <[base.log]>->( 1, ':. review.cmd: no files matched pattern :.' );
    return { 'mode' => qw| false |, 'data' => 'no files matched pattern' };
}

<[base.log]>->(
    1,
    ':. review.cmd: plan created — %d files in %d pages :.',
    $plan->{'total_files'},
    $plan->{'total_pages'}
);

## step 2: iterate through pages ##
my $iterate_result = <[context.review.iterate]>->(
    {   'plan'       => $plan,
        'target_cmd' => $llm_cmd,
        'result_dir' => $plan->{'result_dir'}
    }
);

## handle iteration failure ##
if ( $iterate_result->{'mode'} ne qw| true | ) {
    my $error = $iterate_result->{'data'} // 'iteration failed';
    <[base.log]>->( 0, ':. review.cmd: iterate failed — %s :.', $error );
    return { 'mode' => qw| false |, 'data' => $error };
}

my $iterate_data = $iterate_result->{'data'};
my $status       = $iterate_data->{'status'} // '';

## step 3: handle async (deferred) mode ##
if ( $status eq qw| dispatched | ) {
    <[base.log]>->(
        1,
        ':. review.cmd: async dispatch — page %d/%d :.',
        $iterate_data->{'page_num'} + 1,
        $plan->{'total_pages'}
    );
    return {
        'mode' => qw| deferred |,
        'data' => {
            'plan_summary' =>
                "$type review — $plan->{'total_files'} files in "
                . "$plan->{'total_pages'} pages",
            'pages'         => $plan->{'total_pages'},
            'status'        => qw| async_in_progress |,
            'dispatch_info' => $iterate_data->{'dispatch'}
        }
    };
}

## step 4: synchronous completion — consolidate results ##
if ( $status eq qw| ready | ) {

    ## synchronous mode: results need manual processing ##
    <[base.log]>->(
        1, ':. review.cmd: sync mode — page ready for processing :.'
    );
    return {
        'mode' => qw| true |,
        'data' => {
            'plan_summary' =>
                "$type review — $plan->{'total_files'} files in "
                . "$plan->{'total_pages'} pages",
            'result_dir' => $plan->{'result_dir'},
            'pages'      => $plan->{'total_pages'},
            'status'     => qw| ready_for_processing |,
            'page_num'   => $iterate_data->{'page_num'},
            'page_data'  => $iterate_data->{'page'}
        }
    };
}

## step 5: handle complete status from iterate ##
if ( $status eq qw| complete | ) {
    my $results = $iterate_data->{'results'} // [];

    ## call consolidate ##
    my $consolidate_result = <[context.review.consolidate]>->(
        {   'plan'       => $plan,
            'results'    => $results,
            'result_dir' => $plan->{'result_dir'}
        }
    );

    if ( $consolidate_result->{'mode'} ne qw| true | ) {
        my $error = $consolidate_result->{'data'} // 'consolidation failed';
        <[base.log]>->(
            0, ':. review.cmd: consolidate failed — %s :.', $error
        );
        return { 'mode' => qw| false |, 'data' => $error };
    }

    my $consolidate_data = $consolidate_result->{'data'};

    <[base.log]>->(
        1,
        ':. review.cmd: complete — %d findings in %s :.',
        $consolidate_data->{'total_findings'} // 0,
        $consolidate_data->{'result_dir'}
    );

    return {
        'mode' => qw| true |,
        'data' => {
            'plan_summary' =>
                "$type review — $plan->{'total_files'} files in "
                . "$plan->{'total_pages'} pages",
            'result_dir'       => $consolidate_data->{'result_dir'},
            'pages'            => $plan->{'total_pages'},
            'findings_count'   => $consolidate_data->{'total_findings'} // 0,
            'modules_reviewed' => $consolidate_data->{'modules_reviewed'}
                // 0,
            'summary_file' => $consolidate_data->{'summary_file'}
        }
    };
}

## unknown status ##
<[base.log]>->( 0, ':. review.cmd: unknown status — %s :.', $status );
return { 'mode' => qw| false |, 'data' => "unknown status: $status" };

