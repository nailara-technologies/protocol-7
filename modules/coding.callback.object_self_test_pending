# name  = coding.callback.object_self_test_pending
# descr = Dependency callback to block backend tasks during a self-test model switch

my $object_id = shift;
return undef if not exists <dependency.object>->{$object_id};

my $object = <dependency.object>->{$object_id};

## default: not blocking (ready / satisfied) ##
return TRUE if not $object->{'pending'};

<[base.logs]>->(
    2, '[self_test] dependency %s pending : blocking backend tasks',
    $object_id
);

return FALSE;

