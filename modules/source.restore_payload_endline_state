## [:< ##

# name  = source.restore_payload_endline_state

my $payload_sref      = shift;
my $endline_state_oct = shift;

##  endline state description  ##
#
##  7 : 2 added, 5 : untouched, 0 : 4 removed  ##

warn 'expected sref to payload data <{C1}>' and return undef
    if not length ref $payload_sref;
<[base.s_warn]>->( 'got ref-type %s , want SCALAR <{C1}>', ref $payload_sref )
    and return undef
    if ref $payload_sref ne qw| SCALAR |;

warn 'expected octal endline state descriptor <{C1}>' and return undef
    if not defined $endline_state_oct
    or $endline_state_oct !~ m|^\d$|
    or $endline_state_oct > 7;

return FALSE if $endline_state_oct == 5;

my $previous_payload_length = length $payload_sref->$*;

# Fix #5: Correctly reverse the harmonization based on recorded state
# The state tells us how many newlines were ADDED during harmonization
# We must reverse that by removing the same number of newlines
# State 5 = no change (already handled by early return above)
# State 6 = 1 newline was added  → remove 1 newline
# State 7 = 2 newlines were added → remove 2 newlines
# State 4,3,2,1,0 = newlines were removed → we can't add them back, keep as-is

# First remove ALL trailing newlines to get to the base
$payload_sref->$* =~ s|\n+$||s;

# Now add back the appropriate number based on the state
# State 6: was missing separator, had 1 endline added
# State 7: was incomplete (no endline), had 2 endlines added
if ( $endline_state_oct == 6 ) {
    $payload_sref->$* .= "\n";    # Add back the 1 newline
} elsif ( $endline_state_oct == 7 ) {
    $payload_sref->$* .= "\n\n";  # Add back the 2 newlines
}
# For states 0-4: newlines were removed, can't restore those
# Keep file as-is (no trailing newlines)

##  return length difference [ representing change in trailing endlines ]  ##
return length( $payload_sref->$* ) - $previous_payload_length;

