## [:< ##

# name  = sourcecode.console.test-cycle
# descr = test cycle: backup signatures, update with temp key, verify, restore

my $command_params = shift // '';

$command_params =~ s,^ *| *$,,;

unless ( length $command_params ) {
    say ': usage: sourcecode test-cycle <file-pattern>';
    say ': example: sourcecode test-cycle bin/elf';
    say ': note: single zenka invocation: backup → update → verify → restore';
    return;
}

say ':';
say ': .:[ TEST CYCLE: BACKUP / UPDATE / VERIFY / RESTORE ]:.::';
say ':';

my $sig_key_name = qw| proto-7.sourcecode |;
my $test_key_name = qw| test-proto7-sourcecode |;

# Load unencrypted test key (no passphrase needed)
say ': Loading test key...';
unless ( <[crypt.C25519.load_keypair]>->( $test_key_name, undef, FALSE, FALSE ) ) {
    say ': ERROR: Failed to load test key. Create it first with:';
    say ': ./bin/Protocol-7 keys create -U test-proto7-sourcecode';
    return;
}

say sprintf( ': Loaded test key: %s', $test_key_name );
say ':';

my @source_paths = <[base.source.collect_file_list]>->($command_params);

unless ( @source_paths ) {
    printf( ": no files found for pattern: %s\n", $command_params );
    return;
}

say sprintf( ': Found %d files', scalar(@source_paths) );
say ':';

# STEP 1: Backup original signatures
say ': .:[ STEP 1: BACKING UP ORIGINAL SIGNATURES ]:.::';
say ':';

my $backup_dir = '.test-cycle-backups';
mkdir $backup_dir unless -d $backup_dir;

foreach my $file_path ( @source_paths ) {
    next unless -f $file_path;
    <[file.slurp]>->( $file_path, \my $content, qw| :raw | );
    my $footer_data = <[source.extract_sig_body]>->( \$content, qw| | );
    if ( $footer_data->{'was-present'} ) {
        my $sig_footer = $footer_data->{'signature-footer-str'};
        my $backup_file = sprintf( '%s/%s.orig-sig', $backup_dir, (split '/', $file_path)[-1] );
        open my $fh, '>', $backup_file or die "Cannot write $backup_file: $!";
        print $fh $sig_footer;
        close $fh;
        printf( ": backed up %s\n", (split '/', $file_path)[-1] );
    }
}

say ':';

# STEP 2: Replace signature key with test key
say ': .:[ STEP 2: USING TEST KEY FOR SIGNING ]:.::';
say ':';

$keys{'C25519'}{$sig_key_name} = $keys{'C25519'}{$test_key_name};

say sprintf( ': Signature key set to %s', $test_key_name );
say ':';

# STEP 3: Update signatures
say ': .:[ STEP 3: UPDATING SIGNATURES ]:.::';
say ':';

my $update_count = 0;
foreach my $path_rel (@source_paths) {
    next unless -f $path_rel;

    my $code_data_ref;
    eval {
        use warnings FATAL => qw| all |;
        $code_data_ref = <[source.cmd.get-code-signed]>->(
            {   qw| args |       => $path_rel,
                qw| skip-valid | => TRUE,
                qw| verbosity |  => 0
            }
        );
    };

    if ( defined $code_data_ref and ref $code_data_ref eq 'HASH' and $code_data_ref->{'mode'} ne 'false' ) {
        if ( <[file.put_bin]>->( $path_rel, $code_data_ref->{'data'} ) ) {
            printf( ": [SIGNED] %s\n", (split '/', $path_rel)[-1] );
            $update_count++;
        }
    }
}

say ':';
printf( ': Updated %d files', $update_count );
say ':';

# STEP 4: Verify signatures
say ': .:[ STEP 4: VERIFYING SIGNATURES ]:.::';
say ':';

my $valid_count = 0;
my $invalid_count = 0;

foreach my $file_path ( @source_paths ) {
    next unless -f $file_path;

    <[file.slurp]>->( $file_path, \my $src_str, qw| :raw | );
    my $footer_data = <[source.extract_sig_body]>->( \$src_str, qw| strip | );

    if ( $footer_data->{'was-present'} ) {
        my $state = $footer_data->{'endline-state-encoded'} // '?';
        my $bmw = $footer_data->{'bmw-chksum'} // 'ERROR';
        my $sig = $footer_data->{'signature'} // 'ERROR';

        my $bmw_short = <[base.parser.ellipse_center]>->( $bmw, 21 );
        my $sig_short = <[base.parser.ellipse_center]>->( $sig, 21 );

        printf( ': %-30s state=%d bmw=%s sig=%s' . "\n",
            (split '/', $file_path)[-1],
            $state,
            $bmw_short,
            $sig_short
        );

        my ($is_valid, $report_ref) = <[source.signature_valid]>->( \$src_str, $footer_data );
        if ( $is_valid ) {
            $valid_count++;
        } else {
            $invalid_count++;
            say sprintf( ':  ^ INVALID' );
        }
    }
}

say ':';
printf( ': Results: %d valid, %d invalid', $valid_count, $invalid_count );
say ':';

# STEP 5: Restore original signatures
say ': .:[ STEP 5: RESTORING ORIGINAL SIGNATURES ]:.::';
say ':';

my $restored_count = 0;
foreach my $file_path ( @source_paths ) {
    next unless -f $file_path;

    my $file_name = (split '/', $file_path)[-1];
    my $backup_file = sprintf( '%s/%s.orig-sig', $backup_dir, $file_name );

    unless ( -f $backup_file ) {
        printf( ': [SKIP] No backup for %s' . "\n", $file_name );
        next;
    }

    <[file.slurp]>->( $file_path, \my $content, qw| :raw | );
    my $footer_data = <[source.extract_sig_body]>->( \$content, qw| strip | );
    <[file.slurp]>->( $backup_file, \my $orig_sig );

    $content .= $orig_sig;
    <[file.put_bin]>->( $file_path, $content );

    printf( ': [RESTORED] %s' . "\n", $file_name );
    $restored_count++;
}

say ':';
printf( ': Restored %d files', $restored_count );
say ':';

0;

