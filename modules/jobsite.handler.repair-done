## [:< ##

# name  = jobsite.handler.repair-done
# descr = receive repair result, validate, store if improved

my $call = shift // {};

my $mode    = $call->{'mode'} // '';
my $raw     = $call->{'data'} // '';
my $result  = ref $raw ? $raw->$* : $raw;
my $job_id  = <[base.vax-int.decode]>->( $call->{'params'}{'job_id'} // '' );
my $task_id = $call->{'params'}{'task_id'} // '';

my $job_rec = <jobsite.tasks>->{$job_id};
if ( not defined $job_rec ) {
    <[base.logs]>->( 0, 'jss.repair-done: unknown job %s', $job_id );
    <jobsite.pending_count>--;
    <[jobsite.dispatch.next]>;
    return;
}

if ( lc($mode) eq qw| false | ) {
    <[base.logs]>->(
        0,        'jss.repair-done: repair task %s failed for job %s',
        $task_id, $job_id
    );
    $job_rec->{'repair_failed'} = TRUE;
    my $job_f = <[jobsite.job.read]>->($job_id) // {};
    $job_f->{'status'}        = 'assessed';
    $job_f->{'repair_failed'} = TRUE;
    <[jobsite.job.write]>->( $job_id, $job_f );
    <jobsite.pending_count>--;
    <[jobsite.state.persist]>;
    <[jobsite.dispatch.next]>;
    return;
}

## parse yaml result : fall back to json regex for backward compat ##
my ( $score, $reason, $summary, $parsed ) = ( '', '', '', undef );
my $yaml_src = $result;
## ensure utf8 flag set for regex ops, then encode to bytes for YAML::XS ##
utf8::decode($yaml_src)
    if not utf8::is_utf8($yaml_src)
    and utf8::valid($yaml_src);
## slice from the score: line onward : match score:\d anywhere ##
my $has_yaml = $yaml_src =~ m{score\s*:\s*\d};
$yaml_src = substr( $yaml_src, $-[0] ) if $has_yaml;
$yaml_src =~ s{\n*```\s*$}{}s;
## strip yaml-forbidden control chars : C0 (except tab/LF/CR), DEL, C1 ##
$yaml_src =~ s/[^\x09\x0A\x0D\x20-\x7E\xA0-\x{FFFD}]//g;
## YAML::XS::Load needs utf-8 bytes without the perl utf8 flag ##
my $yaml_bytes = $yaml_src;
utf8::encode($yaml_bytes) if utf8::is_utf8($yaml_bytes);
$parsed = eval { YAML::XS::Load($yaml_bytes) }
    if $has_yaml and length $yaml_src;

if ( ref $parsed eq 'HASH' ) {
    $score   = $parsed->{'score'}   // '';
    $reason  = $parsed->{'reason'}  // '';
    $summary = $parsed->{'summary'} // '';
} elsif ( $result =~ m{\{.*?"(?:fit_)?score"\s*:\s*(\d+(?:\.\d+)?)}s ) {
    ## legacy json fallback ##
    $score = $1;
    ($reason) = ( $result =~ m{"reason(?:s)?"\s*:\s*"([^"]+)"} );
    ($reason) //= do {
        my ($arr) = ( $result =~ m{"reasons"\s*:\s*\[([^\]]+)\]} );
        $arr
            ? ( split /,/, $arr )[0] =~ s/^\s*"?|"?\s*$//gr
            : undef;
    };
    ($summary) = ( $result =~ m{"summary"\s*:\s*"([^"]+)"} );
}

## validate repair result ##
my $validation
    = <[jobsite.validate.assessment]>->( $result, $reason, $summary );

if ( $validation->{'is_valid'} ) {
    ## parse assertions : from yaml parse or legacy json regex ##
    my $assertions = $job_rec->{'assertions'} // {};
    if ( ref $parsed eq 'HASH' && ref $parsed->{'assertions'} eq 'HASH' ) {
        my $pa = $parsed->{'assertions'};
        if ( ref $pa->{'suggest'} eq 'HASH' ) {
            for my $k (qw| apply delete archive |) {
                $assertions->{'suggest'}{$k}
                    = $pa->{'suggest'}{$k} ? 'true' : 'false'
                    if exists $pa->{'suggest'}{$k};
            }
        }
        if ( ref $pa->{'dimensions'} eq 'HASH' ) {
            for my $dim ( keys %{ $pa->{'dimensions'} } ) {
                my $d = $pa->{'dimensions'}{$dim};
                $assertions->{'dimensions'}{$dim}{'score'} = $d->{'score'}
                    // 'unasserted';
                $assertions->{'dimensions'}{$dim}{'reason'} = $d->{'reason'}
                    // '';
            }
        }
    } elsif ( $result =~ m{"assertions"\s*:\s*(\{.*?\})\s*[,\}]\s*$}s
        or $result =~ m{"assertions"\s*:\s*(\{.*\})\s*}s ) {
        ## legacy json fallback ##
        my $assert_json = $1;
        if ( $assert_json =~ m{"suggest"\s*:\s*\{(.*?)\}}s ) {
            my $suggest_block = $1;
            for my $k (qw| apply delete archive |) {
                $assertions->{'suggest'}{$k}
                    = $suggest_block =~ m{"$k"\s*:\s*(true|false)}i
                    ? ( lc($1) eq 'true' ? 'true' : 'false' )
                    : undef;
            }
        }
        if (   $assert_json =~ m{"dimensions"\s*:\s*\{(.*?)\}\s*[,\}]}s
            or $assert_json =~ m{"dimensions"\s*:\s*\{(.*)\}}s ) {
            my $dim_block = $1;
            for my $dim (
                qw| location work-profile company-culture compensation
                remote-flexibility career-growth tech-stack team-structure |
            ) {
                if ( $dim_block =~ m{"$dim"\s*:\s*\{(.*?)\}}s ) {
                    my $d = $1;
                    $assertions->{'dimensions'}{$dim}{'score'}
                        = ( $d =~ m{"score"\s*:\s*(\d+(?:\.\d+)?)} )[0]
                        // 'unasserted';
                    $assertions->{'dimensions'}{$dim}{'reason'}
                        = ( $d =~ m{"reason"\s*:\s*"([^"]+)"} )[0] // '';
                }
            }
        }
    }
    $job_rec->{'assertions'} = $assertions;

    ## sanitize encoding before storing ##
    ## ensure utf8 flag is set so fix_encoding reaches mojibake repair ##
    for ( $reason, $summary ) {
        utf8::decode($_)
            if defined $_
            and not utf8::is_utf8($_)
            and utf8::valid($_);
    }
    $reason = <[jobsite.util.fix_encoding]>->($reason)
        if defined $reason;
    $summary = <[jobsite.util.fix_encoding]>->($summary)
        if defined $summary;
    for my $dim ( keys %{ $assertions->{'dimensions'} // {} } ) {
        my $dr = $assertions->{'dimensions'}{$dim}{'reason'} // '';
        utf8::decode($dr)
            if length $dr
            and not utf8::is_utf8($dr)
            and utf8::valid($dr);
        $assertions->{'dimensions'}{$dim}{'reason'}
            = <[jobsite.util.fix_encoding]>->($dr)
            if length $dr;
    }

    ## apply repair ##
    $job_rec->{'score'}         = $score;
    $job_rec->{'score_reason'}  = $reason  // '';
    $job_rec->{'score_summary'} = $summary // '';
    $job_rec->{'stage'}         = 'assessed';

    my $threshold = <jobsite.cfg.threshold> //= 7;

    if ( length($score) and $score >= $threshold ) {
        $job_rec->{'stage'}  = 'review';
        $job_rec->{'status'} = 'review';
        <[base.logs]>->(
            1,       'repair for job %s score=%s → review',
            $job_id, $score
        );
    } else {
        $job_rec->{'stage'}  = 'trash';
        $job_rec->{'status'} = 'trash';
        $job_rec->{'trash_epoch'} //= <[base.ntime.epoch_timestamp]>;
        <[base.logs]>->(
            1,       'repair for job %s score=%s below threshold → trash',
            $job_id, length($score) ? $score : '?'
        );
    }

    $job_rec->{'repair_applied'} = TRUE;

    ## update per-job file
    my $job = <[jobsite.job.read]>->($job_id) // {};
    if ( length($score) and $score >= $threshold ) {
        $job->{'status'} = 'review';
        $job->{'stage'}  = $job_rec->{'stage'};
    } else {
        ## post-repair still below threshold : recoverable trash ##
        $job->{'status'} = 'trash';
        $job->{'stage'}  = 'trash';
        $job->{'trash_epoch'} //= <[base.ntime.epoch_timestamp]>;
    }
    $job->{'score'}         = $score;
    $job->{'score_reason'}  = $reason  // '';
    $job->{'score_summary'} = $summary // '';
    $job->{'assertions'}    = $assertions if %{ $assertions // {} };

    <[jobsite.job.write]>->( $job_id, $job );

    ## add to checksum index for dedup on future scans ##
    <[jobsite.checksum.index]>->( qw| add |, $job );
} else {
    ## repair still invalid : mark and keep whatever we have ##
    $job_rec->{'repair_failed'} = TRUE;
    <[base.logs]>->(
        1,       'repair for job %s still invalid (%s), keeping original',
        $job_id, join( ', ', $validation->{'defects'}->@* )
    );
    my $job_e = <[jobsite.job.read]>->($job_id) // {};
    $job_e->{'status'}        = 'assessed';
    $job_e->{'repair_failed'} = TRUE;
    <[jobsite.job.write]>->( $job_id, $job_e );
}

<jobsite.pending_count>--;

if ( <jobsite.pending_count> <= 0 ) {
    <jobsite.pending_count> = 0;
    <jobsite.cycle>         = 'idle';
    <[base.logs]>->( 1, 'all assessments complete, cycle=idle' );
}

<[jobsite.state.persist]>;
<[jobsite.dispatch.next]>;

