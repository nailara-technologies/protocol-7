## [:< ##

# name  = httpd.cmd.setup-acme-challenge
# param = <domain> <token> <key_auth>
# descr = create HTTP-01 challenge response file

( my $domain, my $token, my $key_auth ) = split m{\ +}, $call->{'args'} // '';

unless ( $domain && $token && $key_auth ) {
    return {
        'mode' => qw| false |,
        'data' => 'domain, token, and key_auth required'
    };
}

<[base.logs]>->( 1, 'setting up HTTP-01 challenge for %s', $domain );

## construct well-known challenge path
my $well_known_dir = sprintf qw| %s%s/.well-known/acme-challenge |,
    <httpd.site_dir>, $domain;

<[base.logs]>->( 3, ': challenge directory : %s', $well_known_dir );

## track if we created the vhost directory
my $vhost_path    = sprintf '%s%s', <httpd.site_dir>, $domain;
my $vhost_existed = -d $vhost_path;

## create directory if needed
<[file.make_path]>->( $well_known_dir, 0770 )
    or do {
    my $error = <[base.str.os_err]>;
    <[base.logs]>->( 1, 'failed to create challenge directory : %s', $error );
    return {
        'mode' => qw| false |,
        'data' => sprintf 'failed to create directory : %s',
        $error
    };
    };

## write challenge response file
my $challenge_file = join qw| / |, $well_known_dir, $token;

<[file.put]>->( $challenge_file, $key_auth, qw| :raw | ) or do {
    my $error = <[base.str.os_err]>;
    <[base.logs]>->( 1, 'failed to write challenge file : %s', $error );
    return {
        'mode' => qw| false |,
        'data' => sprintf 'failed to write file : %s',
        $error
    };
};

<[base.logs]>->( 2, 'challenge file written : %s', $challenge_file );

return {
    'mode' => qw| true |,
    'data' => 'challenge file set up successfully'
};

