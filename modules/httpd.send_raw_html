# name = httpd.send_raw_html

die "not enough arguments, expected <id>,<code>,<html>" if @_ != 3;

my ( $id, $code, $html_str ) = @_;
my $session         = $data{'session'}{$id};

unless (defined $session) {
    <[base.logs]>->( 0, "[%d] send_raw_html: session not found!", $id );
    return undef;
}

unless (defined $session->{'buffer'}) {
    <[base.logs]>->( 0, "[%d] send_raw_html: buffer not initialized!", $id );
    return undef;
}

my $http_host       = $session->{'http'}{'request'}{'host'};
my $matched_host    = $session->{'http'}{'request'}{'matched_host'};
my $response_params = $session->{'response'}->{'params'} // {};

<[base.logs]>->(
    1, "[%d] send_raw_html: writing %d bytes for HTTP %d response",
    $id, length($html_str), $code
);

$response_params->{'Host'} = $http_host
    if defined $http_host
    and defined $matched_host
    and $matched_host ne 'default';

unless (defined $session->{'buffer'}->{'output'}) {
    $session->{'buffer'}->{'output'} = '';
    <[base.logs]>->( 1, "[%d] send_raw_html: initializing empty output buffer", $id );
} elsif (ref($session->{'buffer'}->{'output'}) eq 'SCALAR') {
    # If output is a reference to a scalar, dereference it for initialization check
    unless (defined ${ $session->{'buffer'}->{'output'} }) {
        ${ $session->{'buffer'}->{'output'} } = '';
        <[base.logs]>->( 1, "[%d] send_raw_html: initializing empty referenced scalar buffer", $id );
    }
}

<[base.logs]>->(
    2, "[%d] send_raw_html: buffer_obj_type=%s, output_tied=%s",
    $id,
    ref( $session->{'buffer'} ) // 'HASH',
    (tied( %{ $session->{'buffer'} } ) ? 'YES' : 'NO')
);

my $buffer_ref_check = $session->{'buffer'}->{'output'};
my $before_len = length(
    (ref($buffer_ref_check) ? ${$buffer_ref_check} : $buffer_ref_check) // ''
);

<[base.logs]>->(
    1, "[%d] send_raw_html: output_type=%s, is_ref=%s, before_len=%d",
    $id,
    ref($buffer_ref_check) // 'SCALAR',
    (ref($buffer_ref_check) ? 'YES' : 'NO'),
    $before_len
);

my $header_data = <[httpd.new_header]>->(
    $code,
    {   'Content-Type'   => 'text/html',
        'Content-Length' => length($html_str),
        'Connection'     => $session->{'http'}->{'close'}
        ? 'close'
        : 'keep-alive',
        %{$response_params}
    }
);

<[base.logs]>->(
    1, "[%d] send_raw_html: header_len=%d, html_len=%d, total=%d",
    $id, length($header_data), length($html_str), length($header_data) + length($html_str)
);

# The buffer is a reference to a scalar (for Event watcher), so dereference it
# event.add_var passes \$session->{'buffer'}->{'output'}, so we need to dereference when writing
my $buffer_ref = $session->{'buffer'}->{'output'};
my $new_content = (ref($buffer_ref) ? ${$buffer_ref} : $buffer_ref) . $header_data . $html_str;

# Assign back, dereferencing if needed
if (ref($buffer_ref)) {
    ${$buffer_ref} = $new_content;
} else {
    $session->{'buffer'}->{'output'} = $new_content;
}

my $after_len = length(
    (ref($buffer_ref) ? ${$buffer_ref} : $session->{'buffer'}->{'output'}) // ''
);

<[base.logs]>->(
    2, "[%d] send_raw_html: session flags - close=%s, shutdown=%s, is_https=%s",
    $id,
    ($session->{'close'} ? 'YES' : 'NO'),
    ($session->{'flush_shutdown'} ? 'YES' : 'NO'),
    ($session->{'is_https'} ? 'YES' : 'NO')
);

if ($after_len == $before_len) {
    <[base.logs]>->(
        0, "[%d] send_raw_html: ERROR - buffer not updated! (before=%d, after=%d, attempted_write=%d)",
        $id, $before_len, $after_len, length($header_data) + length($html_str)
    );
}

<[base.logs]>->(
    1, "[%d] send_raw_html: buffer before=%d, after=%d bytes",
    $id, $before_len, $after_len
);

# Set flush_shutdown so base.handler.write will close after flushing the buffer
$session->{'flush_shutdown'} = 1 if $session->{'http'}->{'close'};
return 0;

