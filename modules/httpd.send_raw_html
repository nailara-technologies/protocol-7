# name = httpd.send_raw_html

die "not enough arguments, expected <id>,<code>,<html>" if @_ != 3;

my ( $id, $code, $html_str ) = @_;
my $session = $data{'session'}{$id};

unless ( defined $session ) {
    <[base.logs]>->( 0, "[%d] send_raw_html: session not found!", $id );
    return undef;
}

unless ( defined $session->{'buffer'} ) {
    <[base.logs]>->( 0, "[%d] send_raw_html: buffer not initialized!", $id );
    return undef;
}

my $http_host       = $session->{'http'}{'request'}{'host'};
my $matched_host    = $session->{'http'}{'request'}{'matched_host'};
my $response_params = $session->{'response'}->{'params'} // {};

<[base.logs]>->(
    1,   "[%d] send_raw_html: writing %d bytes for HTTP %d response",
    $id, length($html_str), $code
);

$response_params->{'Host'} = $http_host
    if defined $http_host
    and defined $matched_host
    and $matched_host ne 'default';

unless ( defined $session->{'buffer'}->{'output'} ) {
    $session->{'buffer'}->{'output'} = '';
    <[base.logs]>->(
        1, "[%d] send_raw_html: initializing empty output buffer", $id
    );
}

<[base.logs]>->(
    2, "[%d] send_raw_html: buffer_is_tied=%s",
    $id, ( tied( $session->{'buffer'}->{'output'} ) ? 'YES' : 'NO' )
);

my $before_len = length( $session->{'buffer'}->{'output'} // '' );

my $header_data = <[httpd.new_header]>->(
    $code,
    {   'Content-Type'   => 'text/html',
        'Content-Length' => length($html_str),
        'Connection'     => $session->{'http'}->{'close'}
        ? 'close'
        : 'keep-alive',
        %{$response_params}
    }
);

<[base.logs]>->(
    1,
    "[%d] send_raw_html: header_len=%d, html_len=%d, total=%d",
    $id,
    length($header_data),
    length($html_str),
    length($header_data) + length($html_str)
);

# Write to output buffer (tied variable that triggers output handler watcher)
<[base.logs]>->(
    3,
    "[%d] send_raw_html: writing %d+%d bytes to output buffer (tied=%s)",
    $id,
    length($header_data),
    length($html_str),
    ( tied( $session->{'buffer'}->{'output'} ) ? 'YES' : 'NO' )
);

## Use explicit assignment instead of .= for tied variables
## Some tied variable handlers don't properly support compound assignment operators
$session->{'buffer'}->{'output'}
    = $session->{'buffer'}->{'output'} . $header_data . $html_str;

my $after_len = length( $session->{'buffer'}->{'output'} // '' );

<[base.logs]>->(
    2,
    "[%d] send_raw_html: session flags - close=%s, shutdown=%s, is_https=%s",
    $id,
    ( $session->{'close'}          ? 'YES' : 'NO' ),
    ( $session->{'flush_shutdown'} ? 'YES' : 'NO' ),
    ( $session->{'is_https'}       ? 'YES' : 'NO' )
);

## Log buffer state for debugging (response delivery is handled by base.handler.write)
<[base.logs]>->(
    2,   "[%d] send_raw_html: response queued, buffer bytes: %d -> %d",
    $id, $before_len, $after_len
);

# Set flush_shutdown so base.handler.write will close after flushing the buffer
$session->{'flush_shutdown'} = 1 if $session->{'http'}->{'close'};
return FALSE;

