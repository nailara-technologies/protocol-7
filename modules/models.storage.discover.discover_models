# name  = models.storage.discover.discover_models
# descr = Discover all models from configured search paths

my @all_discovered;
my $search_paths = <models.storage.search_paths>;

return [] unless $search_paths && ref($search_paths) eq 'ARRAY';

foreach my $path_config (@$search_paths) {
    next unless $path_config->{enabled};
    next unless -d $path_config->{path};

    my $found = <[models.storage.discover_directory]>->(
        $path_config->{path}, $path_config->{recursive}
    );

    # Add tier info
    foreach my $model (@$found) {
        $model->{tier} = $path_config->{tier};
    }

    push @all_discovered, @$found;
}

return \@all_discovered;

