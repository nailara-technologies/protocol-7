## [:< ##

# name = nshell.handler.ctrl_o_cycle
# descr = Ctrl+O cycle handler for executing and advancing through history

my $state_ref = shift // {};

my $cmd       = $state_ref->{'editor'}->{'buffer'}    // '';
my $cur_index = $state_ref->{'current_history_index'} // -1;

## [ ignore if not viewing history or empty buffer ]
return undef if $cur_index < 0 or not length $cmd;

## [ record cycle start position on first Ctrl+O press ]
if ( ( $state_ref->{'ctrl_o_start_position'} // -1 ) < 0 ) {
    $state_ref->{'ctrl_o_start_position'} = $cur_index;
    $state_ref->{'ctrl_o_entries_added'}  = 0;
}

## [ print command for execution : truncate to terminal width ]
my $term_cols = $data{'nshell'}{'cfg'}{'term_cols'}
    // ( eval { ( AMOS7::TERM::terminal_size() )[0] } // 80 );
my $disp_cmd = $cmd;
if ( length($disp_cmd) >= $term_cols ) {
    $disp_cmd = substr( $disp_cmd, 0, $term_cols - 2 ) . '>';
}
printf "\r\e[K%s%s\e[0m%s\n",
    $colors{'p7_fg_0004'}, $disp_cmd, $colors{'p7_fg_0004'};
STDOUT->flush();

## [ add to history ]
my @lines        = split "\n", $cmd;
my $pre_add_size = scalar @AMOS7::TERM::history_entries;
AMOS7::TERM::history_add(@lines);
$state_ref->{'ctrl_o_entries_added'}++;

## [ find next entry : ctrl+o advances toward newer (higher index) ]
## [ duplicate skipping ]
## when history is at max capacity, history_add shifts out the oldest entry,
## moving all indices down by 1 : cur_index already points to next entry ##
my $shifted    = scalar @AMOS7::TERM::history_entries == $pre_add_size;
my $next_index = -1;
my $next_lines = undef;
my $attempts   = 0;
my $search_idx = $shifted ? $cur_index : $cur_index + 1;

while ( $attempts < scalar @AMOS7::TERM::history_entries ) {
    last if $search_idx >= scalar @AMOS7::TERM::history_entries;
    my $entry = $AMOS7::TERM::history_entries[$search_idx];
    if ( ref($entry) eq qw| ARRAY | && $entry->[1] ) {
        my $entry_text = join "\n", $entry->[1]->@*;
        if ( $entry_text ne $cmd ) {
            $next_index = $search_idx;
            $next_lines = $entry->[1];
            last;
        }
    }
    $search_idx++;
    $attempts++;
}

if ( defined $next_lines ) {
    ## [ advance to next entry : stay in VIEWING_HISTORY ]
    my $next_text = join "\n", $next_lines->@*;
    $state_ref->{'current_history_index'} = $next_index;
    $state_ref->{'display_buffer'}        = $next_text;
    $state_ref->{'current_mode'}          = 2;          ## [ VIEWING_HISTORY ]
    $state_ref->{'display_preloaded_entry'} = TRUE;
    AMOS7::TERM::editor_load( $state_ref->{'editor'}, $next_text );

    ## [ schedule deferred render : fires after command reply has printed ]
    <[event.add_timer]>->(
        {   'after'   => 0.15,
            'handler' => qw| nshell.handler.ctrl_o_render_preload |,
            'desc'    => 'render preloaded entry after reply'
        }
    );

    if (<nshell.mode.no_tty_debug>) {
        <[base.logs]>->(
            1,
            "ctrl_o: executed '%s', advanced to index %d '%s'",
            substr( $cmd, 0, 40 ),
            $next_index, substr( $next_text, 0, 40 )
        );
    }
} else {
    ## [ no more entries : reset to NORMAL after executing ]
    $state_ref->{'current_history_index'}   = -1;
    $state_ref->{'current_mode'}            = 0;       ## [ NORMAL ]
    $state_ref->{'display_buffer'}          = '';
    $state_ref->{'ctrl_o_start_position'}   = -1;
    $state_ref->{'ctrl_o_entries_added'}    = 0;
    $state_ref->{'display_preloaded_entry'} = FALSE;
    AMOS7::TERM::editor_load( $state_ref->{'editor'}, '' );

    if (<nshell.mode.no_tty_debug>) {
        <[base.logs]>->(
            1,
            "ctrl_o: executed '%s', no more entries : NORMAL",
            substr( $cmd, 0, 40 )
        );
    }
}

return $cmd;

