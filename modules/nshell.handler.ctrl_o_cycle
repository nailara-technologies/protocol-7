## [:< ##

# name = nshell.handler.ctrl_o_cycle
# descr = Ctrl+O cycle handler for executing and advancing through history

my $state_ref = shift // {};

## Only initialize Ctrl+O state, not caller-provided values
$state_ref->{'ctrl_o_entries_added'}  //= 0;
$state_ref->{'ctrl_o_start_position'} //= -1;
$state_ref->{'current_history_index'} //= -1;

my $cmd = $state_ref->{'editor'}->{'buffer'} // '';

## Set start index on first Ctrl+O press [ for looping ]
if ( $state_ref->{'ctrl_o_start_position'} < 0 ) {
    $state_ref->{'ctrl_o_start_position'}
        = $state_ref->{'current_history_index'};
    $state_ref->{'ctrl_o_entries_added'} = 0;
    if (<nshell.mode.no_tty_debug>) {
        <[base.logs]>->(
            1,
            "ctrl_o: cycle start at index=%s",
            $state_ref->{'ctrl_o_start_position'}
        );
    }
}

## Print command for execution
printf "\r\e[K%s%s\e[0m\n", $colors{'p7_fg_0004'}, $cmd;
STDOUT->flush();

## Add executed command to history FIRST
## This shifts all indices up by 1, so we calculate next_index after
if ( length $cmd ) {
    my @lines = split "\n", $cmd;
    AMOS7::TERM::history_add(@lines);
    ## Track that an entry was added [ shifts all indices up by 1 ]
    $state_ref->{'ctrl_o_entries_added'}++;
    ## Note: we do NOT increment ctrl_o_start_position here
    ## The shift is applied dynamically via $shift variable
    ## start_position stays constant (the original cycle start point)

    if (<nshell.mode.no_tty_debug>) {
        <[base.logs]>->(
            1,
            "ctrl_o: added command to history,"
                . " entries_added=%s start_position=%s",
            $state_ref->{'ctrl_o_entries_added'},
            $state_ref->{'ctrl_o_start_position'}
        );
    }
}

## [ calculate indices after history_add shifts everything ]
## [ shift accounts for entries added during the cycle ]
my $shift = $state_ref->{'ctrl_o_entries_added'};

## [ calculate post-shift positions consistently ]
my $pos_original = $state_ref->{'ctrl_o_start_position'} + $shift;
my $pos_before   = $pos_original - 1;

## [ current position also shifted if we had a valid index ]
my $current_now = $state_ref->{'current_history_index'};
$current_now++ if $current_now >= 0;

## [ toggle between original and previous entry ]
my $next_index
    = ( $current_now == $pos_original ) ? $pos_before : $pos_original;

if (<nshell.mode.no_tty_debug>) {
    <[base.logs]>->(
        1,
        "ctrl_o: current=%s pos_original=%s pos_before=%s next=%s shift=%s",
        $current_now, $pos_original, $pos_before, $next_index, $shift
    );
}

## Navigate to next entry [ load into editor for display ]
if ( $next_index >= 0 && $next_index < @AMOS7::TERM::history_entries ) {
    my $entry = $AMOS7::TERM::history_entries[$next_index];
    if ( ref($entry) eq qw| ARRAY | && $entry->[1] ) {
        $state_ref->{'current_history_index'} = $next_index;
        $state_ref->{'display_buffer'}        = join "\n", $entry->[1]->@*;

        ## Load into editor
        AMOS7::TERM::editor_load( $state_ref->{'editor'},
            $state_ref->{'display_buffer'} );

        ## Signal to display the preloaded entry on next cursor call
        $state_ref->{'display_preloaded_entry'} = TRUE;

        if (<nshell.mode.no_tty_debug>) {
            <[base.log]>->(
                1, "ctrl_o: loaded history entry at index=$next_index"
            );
        }
    }
} elsif (<nshell.mode.no_tty_debug>) {
    <[base.logs]>->(
        1,           "ctrl_o: next_index=%s out of bounds [ 0..%s ]",
        $next_index, $#AMOS7::TERM::history_entries
    );
}

## Set flag to redraw cursor on next call
$state_ref->{'ctrl_o_redraw_cursor'} = TRUE;

if ( length $cmd ) { ## stay in VIEWING_HISTORY mode with next entry preloaded
    if (<nshell.mode.no_tty_debug>) {
        <[base.logs]>->( 1, "ctrl_o: RETURNING cmd='%s'", $cmd );
    }
    return $cmd;
} else {
    return undef;
}

