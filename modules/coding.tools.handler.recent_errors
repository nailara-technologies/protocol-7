# name  = coding.tools.handler.recent_errors
# descr = dispatch recent_errors tool call to context.error.recent handler

my $args = shift // {};

return unless exists $code{'context.error.recent'};
return $code{'context.error.recent'}->(
    {   'filter' => $args->{'filter'} // '',
        'lines'  => $args->{'lines'}  // 50,
        'budget' => $args->{'budget'} // 500,
    }
);

