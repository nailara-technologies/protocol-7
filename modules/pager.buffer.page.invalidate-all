# name  = pager.buffer.page.invalidate-all
# descr = invalidate all pages in buffer cache

my ($args) = @ARG;

my $buf = $args->{'buffer'};
return 0 unless $buf;

my $total = scalar( keys %{ $buf->{'pages'}{'cached'} } );

$buf->{'pages'}{'cached'}   = {};
$buf->{'pages'}{'lru'}      = [];
$buf->{'pages'}{'dirty'}    = {};
$buf->{'memory'}{'current'} = 0;

return $total;

