## [:< ##

# name  = plugin.web.jobs.data
# descr = return all jobs as JSON for GET endpoint / template

my $id = shift;

my $session = $data{'session'}->{$id};

my $jobs = <[jobsite.job.load_all]>;

my @ids = sort {
    ( $jobs->{$b}{'fetched_at'} // 0 ) <=> ( $jobs->{$a}{'fetched_at'} // 0 )
} keys %{$jobs};

my @array;
for my $job_id (@ids) {
    my $job = { %{ $jobs->{$job_id} }, 'id' => $job_id };
    push @array, $job;
}

my $reply_body = eval { JSON::XS::encode_json( \@array ) };
if ($@) {
    <[base.logs]>->( 0, 'plugin.web.jobs.handler.get: json error: %s', $@ );
    return <[httpd.send_error_page]>->( $id, 500 );
}

my $reply_header = {
    qw| Content-Type   | => qw| application/json |,
    qw| Content-Length | => length($reply_body),
};

$session->{'buffer'}->{'output'}
    .= <[httpd.new_header]>->( 200, $reply_header );
$session->{'buffer'}->{'output'} .= $reply_body;

return 2;

