## [:< ##

# name  = select.region.cmd.last-window-coords
# param = [name]
# descr = return last window coords by caller or most recent

my $args = $call->{'args'} // '';

## optional positional caller name ##
my $name   = '';
my @tokens = split m|\s+|, $args;
foreach my $token (@tokens) {
    $name = $token if length $token;
}

my ( $x, $y, $w, $h, $source );

if ( length $name ) {
    my $saved = <[window.profile.load]>->($name);
    if ( defined $saved ) {
        ( $x, $y, $w, $h ) = @{$saved}{qw| x y width height |};
        $source = 'profile';
    }
}

if ( not defined $source ) {
    my $last = $data{select}{region}{last_window_commit};
    if ( defined $last ) {
        ( $x, $y, $w, $h ) = @{$last}{qw| x y width height |};
        $source = 'last-commit';
    }
}

if ( not defined $source ) {
    return {
        'mode' => qw| false |,
        'data' => 'no window coordinates available'
    };
}

my $reply_data = sprintf 'x=%d y=%d width=%d height=%d', $x, $y, $w, $h;
$reply_data .= " source=$source";
$reply_data .= " caller=$name" if length $name;

return { 'mode' => qw| true |, 'data' => $reply_data };

