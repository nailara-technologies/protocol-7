## [:< ##

# name  = base.file.copy
# descr = copy a file from source to destination using File::Copy

my ( $src_path, $dst_path ) = @ARG;

if ( not defined $src_path or not defined $dst_path ) {
    warn 'expected source and destination file paths <{C1}>';
    return undef;
}

if ( not -f $src_path ) {
    <[base.s_warn]>->(
        "source file does not exist [ %s ] <{C1}>", $src_path
    );
    return undef;
}

if ( not -e $dst_path or -f $dst_path ) {
    if ( not copy( $src_path, $dst_path ) ) {
        <[base.s_warn]>->(
            "failed to copy '%s' to '%s' [ %s ] <{C1}>",
            $src_path, $dst_path, <[base.str.os_err]>
        );
        return undef;
    }
    return TRUE;
} else {
    <[base.s_warn]>->(
        "destination path exists and is not a regular file [ %s ] <{C1}>",
        $dst_path
    );
    return undef;
}

