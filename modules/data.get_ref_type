## [:< ##

# name  = data.get_ref_type
# param = <path>
# descr = determine reference type at hash path
# return = HASH|ARRAY|CODE|SCALAR|TIED|PLAIN|UNDEF

my $path_str = shift // return 'UNDEF';
my $ref      = <[data.resolve_hash_path]>->($path_str);

return 'UNDEF' unless defined $ref;
return 'HASH'   if ref($ref) eq 'HASH';
return 'ARRAY'  if ref($ref) eq 'ARRAY';
return 'CODE'   if ref($ref) eq 'CODE';
return 'SCALAR' if ref($ref) eq 'SCALAR';
return 'TIED'   if ref($ref) and tied( ${$ref} );
return 'PLAIN';

