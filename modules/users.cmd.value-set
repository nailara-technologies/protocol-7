## [:< ##

# name  = users.cmd.value-set
# param = <username> <json-fields>
# descr = write or overwrite a host-system user record

my $args = $call->{'args'} // '';
$args =~ s|^\s+||;
$args =~ s|\s+$||;

return {
    'mode' => qw| false |,
    'data' => 'usage: users.value-set <username> <json-fields>'
    }
    if not length $args;

## split username from the rest of the argument string ##
my ( $username, $json_str ) = $args =~ m|^\s*(\S+)(?:\s+(.*))?\s*$|s;
$username //= '';

return {
    'mode' => qw| false |,
    'data' => 'usage: users.value-set <username> <json-fields>'
    }
    if not length $username;

return {
    'mode' => qw| false |,
    'data' => 'username cannot contain path separators'
    }
    if $username =~ m|[/\\]|;

## use the shared P7 json module [ not raw JSON::PP : avoids relying on an ##
## unimported perl module being loaded by some other zenka path            ##
my $fields = {};
$fields = <[format.json.decode]>->($json_str)
    if defined $json_str and length $json_str;

return {
    'mode' => qw| false |,
    'data' => 'fields must be a JSON object'
    }
    if ref $fields ne qw| HASH |;

## USERS_HOST is created once at boot, as root, in users.init_code — this ##
## handler runs post-drop_privs and can't mkdir under the root-owned      ##
## /etc/protocol-7/ parent, so it only ever writes here                   ##
my $file_path     = sprintf( qw| [USERS_HOST]/%s.yaml |, $username );
my $resolved_path = <[base.path.resolve_keywords]>->($file_path);

## best-effort read of the existing record, only to preserve its creation   ##
## timestamp across updates -- undef/error is fine here, it just means this ##
## write is treated as a fresh record                                       ##
my $existing = <[format.yaml.load_keyword_path]>->($file_path);

my $envelope = <[users.record.build]>->( $username, $fields, $existing );

my ( $ok, $err ) = <[format.yaml.write_file]>->( $resolved_path, $envelope );

return {
    'mode' => qw| false |,
    'data' => sprintf(
        "failed to write user " . "'%s': %s",
        $username, $err // 'unknown error'
    )
    }
    if not $ok;

return {
    'mode' => qw| true |,
    'data' => sprintf( "user '%s' stored", $username )
};

