# name  = models.cmd.get_model_path_by_checksum
# descr = Get model file path from registry by AMOS checksum (composite or single)
# return = { mode, data } with file_path or error

my $amos_id = $call->{'args'} // $call->{'param'}->{'amos_id'} // '';

unless ( defined $amos_id && length $amos_id ) {
    return {
        'mode' => 'false',
        'data' => 'error: amos_id required (checksum or composite key)'
    };
}

## Look up model in registry
my $model_entry = <[models.registry.lookup]>->($amos_id);

unless ( defined $model_entry ) {
    return {
        'mode' => 'false',
        'data' => "error: model not found: $amos_id"
    };
}

## Verify file_path exists
unless ( defined $model_entry->{'file_path'} && length $model_entry->{'file_path'} ) {
    return {
        'mode' => 'false',
        'data' => "error: no file_path for model: $amos_id"
    };
}

## Verify file exists on disk
unless ( -f $model_entry->{'file_path'} ) {
    return {
        'mode' => 'false',
        'data' => "error: model file not found: " . $model_entry->{'file_path'}
    };
}

## Return success with model metadata
return {
    'mode'     => 'true',
    'data'     => $model_entry->{'file_path'},
    'model_id' => $model_entry->{'model_id'},
    'name'     => $model_entry->{'name'},
    'quant'    => $model_entry->{'quantization'}
};

