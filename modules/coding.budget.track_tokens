## [:< ##

# name = coding.budget.track_tokens
# descr = monitor and manage token budget for API calls
# purpose = Token economy: Track spending, enforce limits, report usage

# Budget state now stored in shared coding.budget.* data structure
# initialized in coding.init_code for proper scope and Registry access
# [ required modules loaded in coding.init_code: JSON::XS ]
# Time functions: use <[base.time]> instead of time() for proper
# Protocol-7 integration

my $cmd = shift @ARG // qw| status |;

if ( $cmd eq qw| log | ) {
    my ( $task_id, $service, $tokens, $success, $result ) = @ARG;
    return <[coding.helper.log_transaction]>->(
        $task_id, $service, $tokens, $success, $result
    );
} elsif ( $cmd eq qw| check | ) {
    my ($estimated) = @ARG;
    return <[coding.helper.check_budget]>->($estimated);
} elsif ( $cmd eq qw| status | ) {
    my $remaining = <coding.budget.allocated> - <coding.budget.used>;
    my $percentage_used
        = ( <coding.budget.used> / <coding.budget.allocated> ) * 100;
    return {
        total_allocated      => <coding.budget.allocated>,
        total_used           => <coding.budget.used>,
        remaining            => $remaining,
        percentage_used      => sprintf( "%.1f", $percentage_used ),
        percentage_remaining => sprintf( "%.1f", 100 - $percentage_used ),
        status => <[coding.helper.budget_status]>->($percentage_used),
        session_duration =>
            <[base.parser.duration]>->(<coding.budget.session_start>),
        average_per_transaction => <coding.budget.used> > 0
        ? int(
            <coding.budget.used> / scalar( <coding.budget.transactions>->@* )
            )
        : 0
    };
} elsif ( $cmd eq qw| history | ) {
    my ($limit) = @ARG;
    return <[coding.helper.get_transaction_history]>->($limit);
} elsif ( $cmd eq qw| refund | ) {
    my ( $task_id, $amount ) = @ARG;
    return <[coding.helper.refund_tokens]>->( $task_id, $amount );
} elsif ( $cmd eq qw| reset | ) {
    my ($new_alloc) = @ARG;
    return <[coding.helper.reset_budget]>->($new_alloc);
} elsif ( $cmd eq qw| breakdown | ) {
    return <[coding.helper.get_service_breakdown]>;
} else {
    return {
        success   => FALSE,
        error     => sprintf( "unknown budget command : '%s'", $cmd ),
        available => [
            qw| log
                check
                reset
                refund
                status
                history
                breakdown |
        ]
    };
}

