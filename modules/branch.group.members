## [:< ##

# name  = branch.group.members
# descr = list nodes in reference group with tree path for each
# param = group name [ string or { group => ... } ]

my $params = shift                                      // '';
my $group  = ref $params eq 'HASH' ? $params->{'group'} // '' : $params;

return { 'mode' => 'false', 'data' => 'group name required' }
    unless length $group;
return { 'mode' => 'false', 'data' => 'group not found' }
    unless exists $data{'branch.groups'}{$group};

my $members = $data{'branch.groups'}{$group}{'members'} // [];

my @entries = map {
    my $node = $data{'branch.nodes'}{$ARG} // {};
    my $path = <[branch.node.path]>->($ARG);
    {   'id'   => $ARG,
        'name' => $node->{'name'} // '',
        'face' => $node->{'face'} // 0,
        'path' => $path->{'data'} // '',
    }
} @$members;

return { 'mode' => 'true', 'data' => \@entries };

