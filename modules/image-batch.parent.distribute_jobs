# name = image-batch.parent.distribute_jobs
# descr = Distribute jobs from queue to available children

my $pid = shift;    # The child PID that is ready for work

return { success => FALSE, error => 'Child PID required' }
    unless defined $pid;

my $batch_state = <image-batch.batch_state>;
my $batch_queue = <image-batch.batch_queue>;
my $child_pids  = $batch_state->{child_pids};

return { success => FALSE, error => 'No batch_state available' }
    unless defined $batch_state;
return { success => FALSE, error => 'No child_pids available' }
    unless defined $child_pids;

my $child_info = $child_pids->{$pid};
return { success => FALSE, error => "Child PID $pid not found in tracking" }
    unless defined $child_info;

# Mark child as ready
$child_info->{status} = 'ready';
delete $child_info->{current_job_id};

# Find next queued job
my $next_job;
foreach my $job (@$batch_queue) {
    if ( $job->{status} eq 'queued' ) {
        $next_job = $job;
        last;
    }
}

# If no job available, just return
return {
    success => TRUE,
    message => 'Child marked ready, no jobs available'
    }
    unless defined $next_job;

# Send job to child via Protocol-7 command routing
# The reply will be automatically routed to image-batch.parent.handle_child_reply handler
<[base.protocol-7.command.send.local]>->(
    {   'command'   => "child.analyze_image",
        'call_args' => {
            'args' => sprintf( "%s %s",
                $next_job->{image_path},
                $next_job->{job_id} )
        },
        'reply' => {
            'handler' => 'image-batch.parent.handle_child_reply',
            'params'  =>
                { 'job_id' => $next_job->{job_id}, 'assigned_pid' => $pid }
        }
    }
);

# Update job and child tracking
$next_job->{status}          = 'processing';
$next_job->{assigned_to_pid} = $pid;
$next_job->{assigned_at}     = <[base.time]>->(3);

$child_info->{status}         = 'busy';
$child_info->{current_job_id} = $next_job->{job_id};

# Update statistics
$batch_state->{statistics}->{processing}++;

return {
    success         => TRUE,
    job_id          => $next_job->{job_id},
    image_path      => $next_job->{image_path},
    assigned_to_pid => $pid,
    message         => "Job assigned to child process"
};

