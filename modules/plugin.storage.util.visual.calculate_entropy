# name  = plugin.storage.util.visual.calculate_entropy
# descr = Calculate Shannon entropy of a string normalized to 0-1 range

my ($str) = @ARG;
return 0 unless length($str);

my %freq;
$freq{$ARG}++ for split //, $str;

my $entropy = 0;
my $len     = length($str);
for my $count ( values %freq ) {
    my $p = $count / $len;
    $entropy -= $p * log($p) / log(2);
}

# Normalize to 0-1 (max entropy for base32 is log2(32) = 5)
return $entropy / 5.0;

