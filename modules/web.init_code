## [:< ##

# name = web.init_code
# descr = Initialize web content zenka - recursive template processing engine

<[base.log]>->( 2, 'initializing web (content processing) zenka..,' );

# Template processing configuration
<web.cfg.recursion_depth_max>     //= 8;
<web.cfg.command_timeout>         //= 15;
<web.cfg.cache_enabled>           //= 1;
<web.cfg.cache_ttl>               //= 1800;
<web.cfg.template_max_size>       //= 1024 * 1024 * 5;  ## 5MB max template
<web.cfg.parallel_commands_max>   //= 16;

# Template command pattern for base.parser.pattern_split
# Matches: <[command.name:param1:param2]>
# Also matches nested: <[outer:<[inner]>]>
<web.template.command_pattern>    = qr/(?<!\\)<\[([\w\-_.]+[^\]]*)\]>/;

# Meta variable pattern
# Matches: <{variable_name}>
<web.template.meta_pattern>       = qr/<\{([\w\-_.]+)\}>/;

# Template processing state
<web.templates.active>            = {};
<web.templates.cache>             = {};
<web.commands.pending>            = {};
<web.commands.completed>          = 0;
<web.commands.failed>             = 0;

# Performance metrics
<web.metrics> = {
    templates_processed     => 0,
    templates_cached        => 0,
    commands_executed       => 0,
    commands_nested         => 0,
    recursion_depth_max_hit => 0,
    avg_processing_time_ms  => 0,
    cache_hits              => 0,
    cache_misses            => 0,
};

# Visibility list for active template processing
<list.web-templates> = {
    qw| var |   => qw| data |,
    qw| key |   => qw| web.templates.active |,
    qw| descr | => 'Active template processing operations',
    qw| mask |  => '<key>:template_id client_id status depth started_at',
    qw| align | => {
        qw| template_id | => qw| left+2 |,
        qw| client_id |   => qw| center-1 |,
        qw| status |      => qw| center-1 |,
        qw| depth |       => qw| center-1 |,
        qw| started_at |  => qw| center-1 |,
    },
    qw| filters | => {
        qw| started_at | => qw| base.parser.timestamp |,
    }
};

# Visibility list for pending commands
<list.web-commands> = {
    qw| var |   => qw| data |,
    qw| key |   => qw| web.commands.pending |,
    qw| descr | => 'Pending template command executions',
    qw| mask |  => '<key>:command_name template_id status created_at',
    qw| align | => {
        qw| command_name | => qw| left+2 |,
        qw| template_id |  => qw| center-1 |,
        qw| status |       => qw| center-1 |,
        qw| created_at |   => qw| center-1 |,
    },
    qw| filters | => {
        qw| created_at | => qw| base.parser.timestamp |,
    }
};

<[base.log]>->( 2, 'web zenka initialization complete' );
<[base.log]>->( 2, "  Max recursion depth: " . <web.cfg.recursion_depth_max> );
<[base.log]>->( 2, "  Command timeout: " . <web.cfg.command_timeout> . "s" );
<[base.log]>->( 2, "  Cache enabled: " . ( <web.cfg.cache_enabled> ? 'yes' : 'no' ) );

0;

