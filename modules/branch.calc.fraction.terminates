## [:< ##

# name  = branch.calc.fraction.terminates
# descr = true if Y has only prime factors 2 and 5
# param = numerator, denominator
#
# pure arithmetic check — no long division needed

my ( $numerator, $denominator ) = @ARG;

return undef
    if not defined $numerator
    or not defined $denominator
    or $denominator == 0;

my $yy = $denominator;
while ( $yy % 2 == 0 ) { $yy /= 2; }
while ( $yy % 5 == 0 ) { $yy /= 5; }

return $yy == 1 ? TRUE : FALSE;

