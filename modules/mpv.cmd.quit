## [:< ##

# name  = mpv.cmd.quit
# descr = initiate mpv zenka shutdown [ + pre-quit snapshot ]

<zenka.shutdown> = 1;

<[base.log]>->( 1, "quit command received.." );

<mpv.snapshot.quit_reply_id> = $call->{'reply_id'};
<mpv.snapshot.quit_sent>     = FALSE;

## graceful pre-quit snapshot : 'quit' is sent on completion ##
<[base.code.call_optional]>->(
    qw| mpv.snapshot.save |,
    qw| mpv.snapshot.send_quit |
);

## safety net : quit anyway when snapshot collection stalls ##
<[event.add_timer]>->(
    {   'after' => 2,
        'cb'    => sub {
            <[base.code.call_optional]>->(qw| mpv.snapshot.send_quit |);
        }
    }
);

return { 'mode' => qw| deferred | };

