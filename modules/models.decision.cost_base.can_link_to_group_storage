# name  = models.decision.cost_base.can_link_to_group_storage
# descr = Check if model can be linked to shared group storage

my ($model_entry) = @ARG;

return 0 unless $model_entry && ref($model_entry) eq 'HASH';

my $metadata = $model_entry->{metadata} // {};

return $metadata->{shareable} // 1;

