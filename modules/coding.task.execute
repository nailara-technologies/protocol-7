## [:< ##

# name  = coding.task.execute
# descr = execute a coding task from jobqueue callback
# purpose = bridge jobqueue execution to coding task processing
#         = Phase 2: async streaming support (default: blocking)

## JSON::XS loaded via coding.init_code

my $params          = shift;
my $job_id          = $params->{'job_id'};
my $callback_params = $params->{'params'} // {};

my $task_id = $callback_params->{'task_id'};

unless ( defined $task_id ) {
    <[base.logs]>->(
        0, "coding.task.execute: missing task_id in callback params"
    );
    return FALSE;
}

## get task from coding queue ##
my $task = <coding.task.queue>->{$task_id};

unless ( defined $task ) {
    <[base.logs]>->( 0, "coding.task.execute: task not found: %s", $task_id );
    return FALSE;
}

## check if inference server is ready via HTTP ##
my $routed_to = $task->{'analysis'}->{'routed_to'} // 'gpu';
my $port
    = $routed_to eq 'cpu'
    ? ( <inference.backend.cpu.port> // 8001 )
    : ( <inference.backend.gpu.port> // 8000 );

## verify http server is actually responding ##
my $is_ready = eval {
    use LWP::UserAgent;
    my $ua       = LWP::UserAgent->new( timeout => 2 );
    my $response = $ua->get("http://127.0.0.1:${port}/health");
    return $response->is_success ? 1 : 0;
};

unless ($is_ready) {
    ## fail-safe: dependency check passed but HTTP not ready ##
    <[base.logs]>->(
        2,        "coding.task.execute: HTTP fail-safe for %s on port %d",
        $task_id, $port
    );
    return FALSE;
}

## clear stale staged edits from previous tasks ##
<[coding.staged.clear]>;

## mark task as in_progress ##
$task->{'execution'}->{'status'}  = qw| in_progress |;
$task->{'execution'}->{'started'} = <[base.time]>->(3);

## move from pending to active ##
my $aref_pending = <coding.task.pending> // [];
my $aref_active  = <coding.task.active>  // [];

$aref_pending->@* = grep { $ARG ne $task_id } $aref_pending->@*;
push $aref_active->@*, $task_id;

<[base.logs]>->( 2, "coding.task.execute: starting task %s", $task_id );

## Phase 2: Check for async mode ##
my $async_mode = <coding.async.enabled> // FALSE;

if ($async_mode) {
    ## ASYNC MODE: Build request and start streaming ##
    <[base.logs]>->( 1, "coding.task.execute: async mode for %s", $task_id );

    ## Assemble prompt and check cache ##
    my $assembled    = <[coding.prompt.assemble]>->($task);
    my $backend_info = $assembled->{'backend_info'};

    unless ( $backend_info->{'available'} ) {
        <[base.logs]>->(
            0,
            "coding.task.execute: backend not available : %s",
            $backend_info->{'error'} // 'unknown'
        );
        $task->{'execution'}->{'status'} = 'failed';
        $task->{'execution'}->{'error'}  = $backend_info->{'error'}
            // 'backend unavailable';
        <[jobqueue.move_job]>->( $job_id, 'error' );
        <[coding.task.fail]>->( $task_id, $task->{'execution'}->{'error'} );
        return { success => FALSE, error => $task->{'execution'}->{'error'} };
    }

    ## Update task with routing info ##
    $task->{'execution'}->{'backend'}    = $backend_info->{'backend'};
    $task->{'execution'}->{'port'}       = $backend_info->{'port'};
    $task->{'execution'}->{'model_used'} = $backend_info->{'model'};

    ## Build request body ##
    my $request_body = {
        model       => $backend_info->{'model'},
        messages    => $assembled->{'messages'},
        max_tokens  => <inference.model.max_tokens>  // 4096,
        temperature => <inference.model.temperature> // 0.7,
        stream      => JSON::XS::true,    ## Enable streaming ##
    };

    ## Add tools if available ##
    if ( defined $assembled->{'tools'} && $assembled->{'tools'}->@* ) {
        $request_body->{'tools'}       = $assembled->{'tools'};
        $request_body->{'tool_choice'} = 'auto';
    }

    ## Start async streaming request ##
    my $async_result
        = <[coding.async.request]>->( $task_id, $request_body, $job_id );

    if ( !$async_result->{'success'} ) {
        ## Async start failed, fall back to blocking ##
        <[base.logs]>->(
            0,
            "coding.task.execute: async start failed, using blocking: %s",
            $async_result->{'error'} // 'unknown'
        );
        ## Fall through to blocking mode below ##
    } else {
        ## Async started successfully ##
        <[base.logs]>->(
            1, "coding.task.execute: async streaming started for %s",
            $task_id
        );
        ## Return deferred - completion handled by async callbacks ##
        return { success => TRUE, mode => 'deferred', task_id => $task_id };
    }
}

## BLOCKING MODE: Call the actual inference processor ##
## expects: { params => { task_id => ... } } for jobqueue callback mode ##
my $result = <[coding.handler.process-queued-task]>
    ->( { 'params' => { 'task_id' => $task_id } } );

## handle job completion based on result ##
if ( defined $result && $result->{'success'} ) {
    <[jobqueue.move_job]>->( $job_id, 'completed' );
    ## extract the actual result text from hashref ##
    my $result_text = $result->{'result'} // '';
    <[coding.task.complete]>->( $task_id, $result_text );
} else {
    my $error_msg = $result->{'error'} // 'unknown error';
    my $err_short = <[base.parser.center_ellipse_string]>->( $error_msg, 72 );
    <[base.logs]>->(
        0,        "coding.task.execute: task %s failed: %s",
        $task_id, $err_short
    );
    <[jobqueue.move_job]>->( $job_id, 'error' );
    <[coding.task.fail]>->( $task_id, $error_msg );
}

## Clean up async state if we were in async mode ##
if ($async_mode) {
    <[coding.async.state_manager]>->( 'delete', $task_id );
}

return $result;

