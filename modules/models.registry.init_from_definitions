# name = models.registry.init_from_definitions
# descr = initialize registry from pre-configured model definitions
#            [ no file-content checksum - path/metadata checksum only ]

my $models_defs = <models.definitions>;
my $registry    = <models.registry> // {};

foreach my $model_id ( keys %$models_defs ) {
    my $model = $models_defs->{$model_id};

    # Include YAML-defined models even if files not immediately accessible
    # (may be on inaccessible mount or have permission restrictions)

    # Calculate size from file if accessible, otherwise use 0
    my $size_bytes  = -s $model->{'path'};
    my $size_gb     = $size_bytes ? $size_bytes / ( 1024**3 ) : 0;
    my $size_gb_fmt = sprintf( qw| %.3f |, $size_gb );

    my $is_vision = ( $model->{'is_vision'}
            && lc( $model->{is_vision} ) ne qw| false | ) ? 1 : 0;

    ## composite key : path_checksum:model_checksum, same shape as     ##
    ## populate_from_discovery/populate_from_yaml build - neither half ##
    ## reads file content, so this still works for inaccessible files  ##
    my $path_checksum  = <[models.checksum.from_path]>->( $model->{'path'} );
    my $model_checksum = <[models.checksum.from_metadata]>->(
        {   'model_id'     => $model_id,
            'name'         => $model->{'name'},
            'quantization' => $model->{'quantization'} // 'unknown',
            'size_gb'      => $size_gb_fmt,
            'is_vision'    => $is_vision
        }
    );

    ## fall back to the plain yaml key if either checksum call failed ##
    my $registry_key
        = ( defined $path_checksum && defined $model_checksum )
        ? "$path_checksum:$model_checksum"
        : $model_id;

    $registry->{$registry_key} = {
        amos          => $registry_key,
        model_id      => $model_id,
        name          => $model->{'name'},
        path          => $model->{'path'},
        size_gb       => $size_gb_fmt,
        quantization  => $model->{'quantization'},
        is_vision     => $is_vision,
        source        => qw| yaml |,
        registered_at => <[base.time]>->(3)
    };
}

<models.registry> = $registry;

return { success => TRUE, loaded => scalar( keys $registry->%* ) };

