## [:< ##

# name  = site-yaml.cmd.set-status
# descr = set job status: args = "<id> <status>"

my $reply_id = $call->{'reply_id'};
my $args     = $call->{'args'} // '';
my ( $id, $status ) = split /\s+/, $args, 2;

return <[base.callback.cmd_reply]>->(
    $reply_id,
    { 'mode' => 'false', 'data' => 'usage: set-status <id> <status>' }
) if not( defined $id and defined $status );

my %valid
    = map { $ARG => 1 } qw| new assessed applied rejected skipped archived |;
return <[base.callback.cmd_reply]>->(
    $reply_id,
    {   'mode' => 'false',
        'data' => "invalid status '$status'; valid: "
            . join( ' ', sort keys %valid )
    }
) if not $valid{$status};

my $store = $data{'jobs.store'};
return <[base.callback.cmd_reply]>->(
    $reply_id, { 'mode' => 'false', 'data' => "unknown job id: $id" }
) if not exists $store->{$id};

$store->{$id}{'status'}     = $status;
$store->{$id}{'applied_at'} = time if $status eq 'applied';

<[site-yaml.jobs.save]>;

<[base.callback.cmd_reply]>->(
    $reply_id, { 'mode' => 'true', 'data' => "ok: $id => $status" }
);

