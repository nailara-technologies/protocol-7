## [:< ##

# name  = models.task.execute
# descr = jobqueue callback : dispatch task to backend

my $callback = shift;
my $job_id   = $callback->{'job_id'};
my $params   = $callback->{'params'} // {};

my $task_id    = $params->{'task_id'}    // '';
my $model      = $params->{'model'}      // '';
my $prompt     = $params->{'prompt'}     // '';
my $target_cmd = $params->{'target_cmd'} // '';

<[base.logs]>->(
    1, ': executing task %s via %s [ job %s ]',
    $task_id, $target_cmd, $job_id
);

## set active dispatch guard ##
<models.task.active_id>  = $task_id;
<models.task.active_job> = $job_id;

## check for delegation flag ##
my $delegate_config = $params->{'delegate'} // {};
my $use_delegation
    = ref $delegate_config eq qw| HASH |
    ? ( $delegate_config->{'enabled'} // FALSE )
    : FALSE;

## try delegation path if enabled ##
if ($use_delegation) {
    <[base.logs]>->( 2, ': task %s: attempting delegation path', $task_id );

    my $bridge_result = <[models.task.delegate_bridge]>->(
        {   'task_id'    => $task_id,
            'model'      => $model,
            'prompt'     => $prompt,
            'target_cmd' => $target_cmd,
            'job_id'     => $job_id,
            'delegate'   => $delegate_config
        }
    );

    ## check if delegation flow started successfully ##
    if ( ref $bridge_result eq qw| HASH | ) {
        if ( $bridge_result->{'mode'} eq qw| true | ) {
            my $status = $bridge_result->{'data'}->{'status'} // '';
            if ( $status eq qw| checking | ) {
                ## async check in progress - handler will continue ##
                <[base.logs]>->(
                    2, ': task %s: delegation check in progress', $task_id
                );
                return TRUE;
            }
            ## immediate success (should not happen with _skip_check) ##
            <[base.logs]>->(
                1, ': task %s: delegated successfully', $task_id
            );
            return TRUE;
        }
    }

    ## bridge returned failure - fallback to direct dispatch ##
    my $reason
        = ref $bridge_result eq qw| HASH |
        ? $bridge_result->{'data'}
        : qw| unknown |;
    <[base.logs]>->(
        2,        ': task %s: delegation bridge failed [ %s ], falling back',
        $task_id, $reason
    );

    ## reset active state before fallback ##
    <models.task.active_id>  = $task_id;
    <models.task.active_job> = $job_id;
}

## check for iteration flag : supports bool or { enabled => 1 } ##
my $iter_param = $params->{'iteration'} // 0;
my $use_iteration
    = ref $iter_param eq qw| HASH |
    ? ( $iter_param->{'enabled'} // 0 )
    : $iter_param;

## route through iteration loop if enabled ##
if ($use_iteration) {
    <[base.logs]>->(
        2, ': task %s: routing through iteration loop', $task_id
    );

    my $result = <[iteration.loop]>->(
        {   task_id      => $task_id,
            result       => '',
            criteria     => $params->{'acceptance_criteria'} // [],
            node_id      => $params->{'node_id'}             // '',
            max_attempts => $params->{'max_attempts'}        // 5,
        }
    );

    ## handle iteration result ##
    if ( $result && ref $result eq qw| HASH | ) {
        my $mode = $result->{'mode'} // '';

        if ( $mode eq qw| true | ) {
            ## iteration complete, task success ##
            <[base.logs]>->(
                1, ': task %s: iteration complete, task successful', $task_id
            );
            <models.task.active_id>  = undef;
            <models.task.active_job> = undef;
            <[jobqueue.move_job]>->( $job_id, qw| complete | );
            return TRUE;
        } elsif ( $mode eq qw| retry | ) {
            ## iteration requires retry with updated prompt ##
            my $issues = $result->{'data'} // '';
            <[base.logs]>->(
                2,        ': task %s: iteration requires retry [ issues=%s ]',
                $task_id, $issues
            );

            ## append issues to prompt as user message ##
            my $updated_prompt = $prompt;
            if ( length $issues ) {
                $updated_prompt
                    .= "\n\n[iteration issues to fix: " . $issues . "]";
            }

            ## re-dispatch task with updated prompt ##
            <[base.logs]>->(
                1, ': task %s: re-dispatching through iteration loop',
                $task_id
            );

            return <[models.task.execute]>->(
                {   'job_id' => $job_id,
                    'params' => {
                        'task_id'             => $task_id,
                        'model'               => $model,
                        'prompt'              => $updated_prompt,
                        'target_cmd'          => $target_cmd,
                        'acceptance_criteria' =>
                            $params->{'acceptance_criteria'} // [],
                        'node_id'      => $params->{'node_id'}      // '',
                        'max_attempts' => $params->{'max_attempts'} // 5,
                    }
                }
            );
        } elsif ( $mode eq qw| escalate | ) {
            ## iteration escalation - mark task blocked ##
            my $reason = $result->{'data'} // 'escalation';
            <[base.logs]>->(
                0,        ': task %s: iteration escalation triggered [ %s ]',
                $task_id, $reason
            );

            <[protocol-7.route-send]>->(
                {   'command'   => 'task.fail',
                    'call_args' =>
                        { 'args' => "$task_id iteration escalated: $reason" }
                }
            );

            <models.task.active_id>  = undef;
            <models.task.active_job> = undef;
            <[jobqueue.move_job]>->( $job_id, qw| blocked | );
            return FALSE;
        } else {
            ## unknown iteration mode - fail task ##
            <[base.logs]>->(
                0,        ': task %s: unknown iteration mode [ %s ]',
                $task_id, $mode
            );
            <[protocol-7.route-send]>->(
                {   'command'   => 'task.fail',
                    'call_args' =>
                        { 'args' => "$task_id unknown iteration mode" }
                }
            );
            <models.task.active_id>  = undef;
            <models.task.active_job> = undef;
            <[jobqueue.move_job]>->( $job_id, qw| error | );
            return FALSE;
        }
    }
}

## fall back to direct dispatch ##
return <[models.task.fallback-direct]>->(
    {   'task_id'    => $task_id,
        'model'      => $model,
        'prompt'     => $prompt,
        'target_cmd' => $target_cmd,
        'job_id'     => $job_id
    }
);

