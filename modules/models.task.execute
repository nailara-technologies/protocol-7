## [:< ##

# name  = models.task.execute
# descr = jobqueue callback : dispatch task to backend

<[base.perlmod.load]>->('Crypt::Misc');

my $callback = shift;
my $job_id   = $callback->{'job_id'};
my $params   = $callback->{'params'} // {};

my $task_id    = $params->{'task_id'}    // '';
my $model      = $params->{'model'}      // '';
my $prompt     = $params->{'prompt'}     // '';
my $target_cmd = $params->{'target_cmd'} // '';

<[base.logs]>->(
    1, ': executing task %s via %s [ job %s ]',
    $task_id, $target_cmd, $job_id
);

## set active dispatch guard ##
<models.task.active_id>  = $task_id;
<models.task.active_job> = $job_id;

## prepend :next: for fresh session per task
$prompt = ':next: ' . $prompt;

## base32r encode prompt for safe ipc ##
my $encoded = eval { Crypt::Misc::encode_b32r($prompt) };
if ( $@ or not defined $encoded or not length $encoded ) {
    <[base.logs]>->( 0, ': task %s: base32r encode failed', $task_id );
    <[protocol-7.route-send]>->(
        {   'command'   => 'task.fail',
            'call_args' => { 'args' => "$task_id encode error" }
        }
    );
    <models.task.active_id>  = undef;
    <models.task.active_job> = undef;
    <[jobqueue.move_job]>->( $job_id, qw| error | );
    return FALSE;
}

## extract zenka name from target command [ kimi.ask-reply → kimi ]
( my $zenka_name = $target_cmd ) =~ s{\..*}{};

## wait for backend zenka to be online before dispatching
my $sent = <[protocol-7.route-send]>->(
    {   'command'   => 'v7.notify_online',
        'call_args' => { 'args' => ":start: $zenka_name" },
        'reply'     => {
            'handler' => 'models.handler.notify-online-reply',
            'params'  => {
                'task_id'    => $task_id,
                'model'      => $model,
                'job_id'     => $job_id,
                'target_cmd' => $target_cmd,
                'encoded'    => $encoded
            }
        }
    }
);

if ( $sent <= 0 ) {
    <[base.logs]>->(
        0, ': task %s: v7 not reachable [ job %s ]',
        $task_id, $job_id
    );
    <[protocol-7.route-send]>->(
        {   'command'   => 'task.fail',
            'call_args' =>
                { 'args' => "$task_id v7 not reachable" }
        }
    );
    <models.task.active_id>  = undef;
    <models.task.active_job> = undef;
    <[jobqueue.move_job]>->( $job_id, qw| error | );
    return FALSE;
}

return TRUE;

