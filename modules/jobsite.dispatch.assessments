## [:< ##

# name  = jobsite.dispatch.assessments
# descr = collect new untracked jobs and queue assessment tasks

## re-entrant safe : a settle-timer (new job-upsert arrivals) or a queue-drain ##
## signal can both call this while a previous batch is still mid-flight ; only ##
## the call that finds cycle already idle is allowed to kick dispatch.next -- ##
## an in-flight chain already re-invokes dispatch.next via assess-done, so a  ##
## second kick here would double-dispatch a task ##
my $was_idle = ( <jobsite.cycle> // '' ) ne 'assessing';

## collect new untracked jobs from per-file store ##
<[base.perlmod.autoload]>->('HTML::Entities');
my $store = <[jobsite.job.load_all]>;

my @to_assess;
for my $job_id ( keys %{$store} ) {
    my $job = $store->{$job_id};
    next if ( $job->{'status'} // '' ) ne 'new';

    ## skip only if an active task is already in flight for this job ##
    my $existing = ( <jobsite.tasks>->{$job_id} // {} )->{'stage'} // '';
    next if $existing =~ m{^(?:queued|assessing|assessed|done)$};

    ## checksum dedup / blacklist check ##
    my $chk = <[jobsite.checksum.index]>->( qw| check |, $job );
    if ( $chk->{'is_blocked'} ) {
        <[base.logs]>->(
            2,       'job %s blocked by checksum index [%s]',
            $job_id, join( ', ', $chk->{'hits'}->@* )
        );

        ## backfill checksums if missing [ original   ##
        ##             assessment may predate store ] ##
        my $need_add   = 0;
        my $store_root = '/var/protocol-7/jobsite/checksum-store';
        for my $hit ( $chk->{'hits'}->@* ) {
            if ( $hit =~ m{^url:([A-Z2-7]+)$} ) {
                my $found = 0;
                if ( opendir my $udh, "$store_root/urls" ) {
                    for my $ep ( grep { !/^\./ } readdir($udh) ) {
                        if ( -e "$store_root/urls/$ep/$1" ) {
                            $found = 1;
                            last;
                        }
                    }
                    closedir $udh;
                }
                $need_add = 1 if not $found;
            }
        }
        <[jobsite.checksum.index]>->( qw| add |, $job ) if $need_add;

        ## write blocked stub and skip assessment ##
        my $blocked_job = {
            'id'            => $job_id,
            'url'           => $job->{'url'} // '',
            'status'        => 'blocked',
            'blocked_epoch' => <[base.ntime.epoch_timestamp]>,
            'checksum_hit'  => ( $chk->{'hits'}[0] // '' ),
        };
        <[jobsite.job.write]>->( $job_id, $blocked_job );

        ## job.write's rename-based cleanup trusts <jobsite.job.index> for the ##
        ## old path, which can already point elsewhere if this id was blocked ##
        ## under a different filename/epoch before (e.g. a resurrected repost ##
        ## racing an index rebuild) -- that leaves this 'new' copy orphaned,  ##
        ## re-detected and re-"blocked" forever without ever being removed.   ##
        ## we know for certain this file lives at new/<enc_id>.yaml since we  ##
        ## just loaded it from there, so remove it directly instead of       ##
        ## trusting the index's single-slot memory of the old location ##
        my $enc_id   = <[base.vax-int.encode]>->($job_id);
        my $new_path = join( '/',
            <system.path.zenka-dirs>->{'var_P7'},
            qw| jobsite jobs new | )
            . "/$enc_id.yaml";
        unlink $new_path if -f $new_path;

        next;
    }

    push @to_assess, $job_id;
}

if ( not @to_assess ) {
    if ($was_idle) {
        <[base.logs]>->( 1, 'no new untracked jobs to assess, idle' );
        <jobsite.cycle> = 'idle';
        <[jobsite.state.persist]>;
    }
    return;
}

<jobsite.cycle> = 'assessing';
<jobsite.pending_count>
    = ( <jobsite.pending_count> // 0 ) + scalar @to_assess;
<[jobsite.state.persist]>;

<[base.logs]>->(
    1,
    'queuing %d assessment tasks (sequential)',
    scalar @to_assess
);

## load candidate profile once
my $profile_file = <jobsite.cfg.profile_file>
    // '/etc/protocol-7/jobsite/profile.txt';
my $profile_text = '';
$profile_text = <[file.read]>->($profile_file)
    // 'no profile configured : score based on job listing alone';
<[base.perlmod.autoload]>->('Encode');
$profile_text = Encode::decode( 'UTF-8', $profile_text )
    unless utf8::is_utf8($profile_text);

## build queue entries
my @queue;
for my $job_id (@to_assess) {
    <jobsite.tasks>->{$job_id} = { 'stage' => 'queued', 'task_id' => '' };

    ## initialize assertion tree for this job ##
    <[jobsite.assert.init]>->($job_id);

    my $prompt = <[jobsite.util.build_prompt]>->( $store->{$job_id} );

    push @queue, { 'job_id' => $job_id, 'desc' => $prompt };
}

## append : a batch may already be mid-flight with its own queue tail ##
<jobsite.assess_queue> //= [];
push @{<jobsite.assess_queue>}, @queue;

## dispatch first task only if nothing was already running -- an in-flight
## chain's own assess-done -> dispatch.next will pick up the appended entries ##
<[jobsite.dispatch.next]>
    if $was_idle;

return;

