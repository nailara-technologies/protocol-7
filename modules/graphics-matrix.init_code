## [:< ##

# name = graphics-matrix.init_code

<[base.perlmod.load]>->( 'File::Path', qw| make_path | );
<[base.perlmod.autoload]>->('Graphics::Magick');
<[base.perlmod.autoload]>->('Convert::Color');
<[base.perlmod.autoload]>->('Convert::Color::HSV');
<[base.perlmod.autoload]>->('Crypt::Misc');

<graphics-matrix.cache_dir> //= qw| /var/cache/graphics-matrix |;
my $cache_dir = <graphics-matrix.cache_dir>;

my $p_c_dir = <graphics-matrix.permission.work_cache_dir>   //= qw| 0770 |;
my $p_ds    = <graphics-matrix.permission.document-storage> //= qw| 0750 |;

<[file.make_path]>->( $cache_dir, $p_c_dir, <system.amos-zenka-user> );
map {
    <[file.make_path]>->( $ARG, $p_ds, <graphics-matrix.document-path-owner> )
} ( <graphics-matrix.import_directory>,
    <graphics-matrix.export_directory> );

-d $cache_dir && chdir($cache_dir)
    or die sprintf( 'chdir[ %s ] : %s',
    $cache_dir, <[base.format_error]>->($OS_ERROR) );

## initialize cursor state ##
<[graphics-matrix.cursor.init]>;

## initialize glow state ##
<[graphics-matrix.glow.init]>;

## initialize channel state ##
<[graphics-matrix.channel.init]>;

## initialize address registry ##
<[graphics-matrix.address.init]>;

## initialize cell storage ##
<[graphics-matrix.cell.init]>;

## initialize similarity graph ##
<[graphics-matrix.graph.init]>;

## initialize harmonic voxel density grid ##
<[graphics-matrix.harmonic.density]>;

##  orbital STRM push : disable in zenki/graphics-matrix/start when     ##
##  required                                                            ##
##
<graphics-matrix.cfg.orbital_push_enabled> //= TRUE;

## no discrete mutation event covers this summary : poll our own ##
## listeners on a slow timer instead, gated to a no-op when nobody is  ##
## subscribed                                                          ##
<[event.add_timer]>->(
    {   qw| interval | => 45,
        qw| repeat   | => TRUE,
        qw| handler  | =>
            qw| graphics-matrix.orbital.push_state_if_subscribed |,
    }
);

0;

