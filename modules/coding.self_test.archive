## [:< ##

# name  = coding.self_test.archive
# descr = store one self-test result in epoch-scoped data tree

my $params   = shift                 // {};
my $epoch    = $params->{'epoch'}    // <[base.time]>->(3);
my $model_id = $params->{'model_id'} // '';
my $result   = $params->{'result'}   // {};
my $anomaly  = $params->{'anomaly'}  // '';

return { mode => qw| false |, data => 'model_id required' }
    if !length $model_id;
return { mode => qw| false |, data => 'empty result' }
    if !%$result;

my $store = <coding.self_test>->{$epoch}{$model_id} //= {};

$store->{'timestamp'} = $result->{'timestamp'} // <[base.time]>->(3);
$store->{'ttft'}      = $result->{'ttft'}      // 0;
$store->{'tps'}       = $result->{'tps'}       // 0;
$store->{'passed'}    = $result->{'passed'}    // FALSE;
$store->{'answer'}    = $result->{'answer'}    // '';
$store->{'prompt_id'} = $result->{'prompt_id'} // 0;

## full per-prompt detail, keyed by prompt_id so a multi-prompt run [ eg    ##
## prompt 1 + prompt 2 ] doesn't overwrite itself in the flat fields above  ##
## - used by coding.self_test.cmd.self-test-detail to show exactly what was ##
## sent/received on each tier1 reformat attempt                             ##
$store->{'prompts'}{ $result->{'prompt_id'} // 0 } = {
    prompt             => $result->{'prompt'}             // '',
    answer             => $result->{'answer'}             // '',
    reasoning          => $result->{'reasoning'}          // '',
    finish_reason      => $result->{'finish_reason'}      // '',
    server_tail        => $result->{'server_tail'}        // '',
    expected           => $result->{'expected'}           // '',
    passed             => $result->{'passed'}             // FALSE,
    tier               => $result->{'tier'}               // '',
    structural_reason  => $result->{'structural_reason'}  // '',
    tier1_reason       => $result->{'tier1_reason'}       // '',
    tier1_attempts     => $result->{'tier1_attempts'}     // [],
    failure_class      => $result->{'failure_class'}      // '',
    reformatted_answer => $result->{'reformatted_answer'} // '',
    ttft               => $result->{'ttft'}               // 0,
    timestamp          => $result->{'timestamp'} // <[base.time]>->(3),
};

if ( length $anomaly ) {
    my $prompt_id = $result->{'prompt_id'} // 0;
    $store->{'anomaly'}{$prompt_id} = {
        answer      => $result->{'answer'} // '',
        explanation => $anomaly,
        expected    => $result->{'expected'} // '',
    };
}

<coding.self_test>->{$epoch}{$model_id} = $store;

## durable cross-restart stats : <coding.self_test> above is an in-memory  ##
## %data tree keyed by epoch - it does not survive a zenka restart, so it  ##
## can only ever answer "this run", never "how many retries does model X   ##
## typically need" [ the actual point of collecting this ]. persisted here ##
## via the zenka_dir wrappers [ atomic write, permission-safe -- same      ##
## pattern as any other zenka runtime data under /var/protocol-7/coding/ ] ##
## rather than a raw path, per user request 2026-08-08                     ##
{
    my $stats_file    = 'self_test-stats.yaml';
    my $existing_yaml = <[file.zenka_dir.load]>->($stats_file);
    my $stats
        = ( defined $existing_yaml and length $$existing_yaml )
        ? ( <[format.yaml.load_str]>->($$existing_yaml) // {} )
        : {};

    my $prompt_id = $result->{'prompt_id'} // 0;
    my $entry     = $stats->{$model_id}{$prompt_id} //= {
        attempts_histogram   => {},
        failure_class_counts => {},
        pass_count           => 0,
        fail_count           => 0,
    };

    ## attempts_needed : 0 = tier0 passed literally, never touched tier1 ##
    my $attempts_needed = scalar @{ $result->{'tier1_attempts'} // [] };
    $entry->{'attempts_histogram'}{$attempts_needed}++;

    if ( $result->{'passed'} ) {
        $entry->{'pass_count'}++;
    } else {
        $entry->{'fail_count'}++;
        my $fc = $result->{'failure_class'} // 'other';
        $entry->{'failure_class_counts'}{$fc}++;
    }
    $entry->{'last_updated'} = $result->{'timestamp'} // <[base.time]>->(3);

    my $yaml_str = <[format.yaml.dump_str]>->($stats);
    if ( length $yaml_str ) {
        <[file.zenka_dir.write]>->( $stats_file, \$yaml_str, qw| > |, 0640 )
            or <[base.logs]>->(
            1, '[self_test] failed to persist stats file [ %s ]', $stats_file
            );
    }
}

return { mode => qw| true |, data => 'archived' };

