## [:< ##

# name  = coding.self_test.archive
# descr = store one self-test result in epoch-scoped data tree

my $params   = shift                 // {};
my $epoch    = $params->{'epoch'}    // <[base.time]>->(3);
my $model_id = $params->{'model_id'} // '';
my $result   = $params->{'result'}   // {};
my $anomaly  = $params->{'anomaly'}  // '';

return { mode => qw| false |, data => 'model_id required' }
    if !length $model_id;
return { mode => qw| false |, data => 'empty result' }
    if !%$result;

my $store = <coding.self_test>->{$epoch}{$model_id} //= {};

$store->{'timestamp'} = $result->{'timestamp'} // <[base.time]>->(3);
$store->{'ttft'}      = $result->{'ttft'}      // 0;
$store->{'tps'}       = $result->{'tps'}       // 0;
$store->{'passed'}    = $result->{'passed'}    // FALSE;
$store->{'answer'}    = $result->{'answer'}    // '';
$store->{'prompt_id'} = $result->{'prompt_id'} // 0;

## full per-prompt detail, keyed by prompt_id so a multi-prompt run [ eg    ##
## prompt 1 + prompt 2 ] doesn't overwrite itself in the flat fields above  ##
## - used by coding.self_test.cmd.self-test-detail to show exactly what was ##
## sent/received on each tier1 reformat attempt                             ##
$store->{'prompts'}{ $result->{'prompt_id'} // 0 } = {
    prompt             => $result->{'prompt'}             // '',
    answer             => $result->{'answer'}             // '',
    reasoning          => $result->{'reasoning'}          // '',
    finish_reason      => $result->{'finish_reason'}      // '',
    server_tail        => $result->{'server_tail'}        // '',
    expected           => $result->{'expected'}           // '',
    passed             => $result->{'passed'}             // FALSE,
    tier               => $result->{'tier'}               // '',
    structural_reason  => $result->{'structural_reason'}  // '',
    tier1_reason       => $result->{'tier1_reason'}       // '',
    tier1_attempts     => $result->{'tier1_attempts'}     // [],
    reformatted_answer => $result->{'reformatted_answer'} // '',
    ttft               => $result->{'ttft'}               // 0,
    timestamp          => $result->{'timestamp'} // <[base.time]>->(3),
};

if ( length $anomaly ) {
    my $prompt_id = $result->{'prompt_id'} // 0;
    $store->{'anomaly'}{$prompt_id} = {
        answer      => $result->{'answer'} // '',
        explanation => $anomaly,
        expected    => $result->{'expected'} // '',
    };
}

<coding.self_test>->{$epoch}{$model_id} = $store;

return { mode => qw| true |, data => 'archived' };

