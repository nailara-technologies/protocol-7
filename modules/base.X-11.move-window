## [:< ##

# name = base.X-11.move-window

my $id     = shift;
my $x      = shift;
my $y      = shift;
my $width  = shift;
my $height = shift;

my $user     = shift // 'cube';
my $cmd_path = shift // '';
$cmd_path .= '.'                   if length($cmd_path);
die "expected numerical window id" if not defined $id or $id !~ /^\d+$/;

my ($local_sid) = keys( %{ $data{'user'}{$user}{'session'} } );

<[base.log]>->( 2, "moving window '$id' to x=$x y=$y w=$width h=$height" );

my $cmd_id = <[base.gen_id]>->( $data{'route'} );

## include width/height when available: the original position-only      ##
## change broke WSLg/Weston placement for managed ticker windows.        ##
## X-11.cmd.move-window now accepts optional w/h and passes them to      ##
## ConfigureWindow so the WM gets a complete geometry request.           ##
my $args = join( ' ',
    map { defined $_ ? $_ : '' } ( $id, $x, $y, $width, $height ) );

my $cube_fh = $data{'session'}{$local_sid}{'handle'};
<[base.net.send_to_socket]>->(
    $cube_fh, "($cmd_id)${cmd_path}X-11.move-window $args\n"
);

my $reply_string;
my $matched_reply = 0;
while ( !$matched_reply ) {
    $reply_string = <$cube_fh>;
    die "cube handle had an exception!" if not defined $reply_string;
    $matched_reply = 1 if $reply_string =~ /^\($cmd_id\)(TRUE|FALSE) /;
    if ( !$matched_reply ) {
        $data{'session'}{$local_sid}{'buffer'}{'input'} .= $reply_string;
    }
}

if ( $reply_string =~ /^\($cmd_id\)FALSE (.+)$/ ) {
    <[base.log]>->( 0, "move_window command failed with '$1'.." );
    return FALSE;
} else {
    return TRUE;
}

