## [:< ##

# name  = cred-mesh.handler.route_reply
# descr = handle async reply from remote owning zenka during credential.resolve.

my $params = shift              // {};
my $reply  = $params->{'reply'} // {};
my $args   = $params->{'args'}  // {};

my $slot = $reply->{'params'}{'slot'} // '';

return undef unless length $slot;

my $result = $args->{'data'};

## store routed result in a transient cache for the requesting zenka ##
<cred-mesh.route_reply_cache> //= {};
<cred-mesh.route_reply_cache>->{$slot} = {
    'result' => $result,
    'ntime'  => <[base.time]>->(3),
};

return $result;

