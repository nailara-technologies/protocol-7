## [:< ##

# name  = nshell.handler.ctrl_o_render_preload
# descr = timer callback to render preloaded entry after command reply

## [ fired ~150ms after Ctrl+O, so command reply has already printed ]

my $state_ref = <nshell.state> // {};

## [ only render if preload flag is still set : might have been cancelled ]
return if not $state_ref->{'display_preloaded_entry'};
$state_ref->{'display_preloaded_entry'} = FALSE;

my $editor = $state_ref->{'editor'}                               // return;
my $buffer = <[editor.control.get_value]>->( $editor, 'command' ) // '';
utf8::encode($buffer);    ## char state -> byte view for the log below

return unless length $buffer;

## [ render the preloaded entry with cursor, same as arrow_up display path ]
print "\r\e[2K";
$state_ref->{'view_offset'} = 0;
<[nshell.render.viewport]>->( $editor, \%colors );

if (<nshell.mode.no_tty_debug>) {
    <[base.logs]>->(
        1,
        "ctrl_o_render: displayed preload '%s'",
        substr( $buffer, 0, 40 )
    );
}

return;

