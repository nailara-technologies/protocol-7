# name = data.init_holographic.calculate_magnetic_trajectory
# desc = Calculate magnetic field line trajectory

my ( $from, $to, $intent ) = @_;

my $dx = $to->[0] - $from->[0];
my $dy = $to->[1] - $from->[1];
my $dz = $to->[2] - $from->[2];

my $intent_strength = $intent->{'strength'} // 0.5;

return {
    'direction'  => [ $dx, $dy, $dz ],
    'magnitude'  => sqrt( $dx * $dx + $dy * $dy + $dz * $dz ),
    'curvature'  => $intent_strength,
    'field_line' => <[data.init_holographic.generate_field_line]>->(
        $from, $to, $intent
    ),
};

