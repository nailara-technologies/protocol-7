## [:< ##

# name  = coding.task.fail
# descr = mark task failed with error context [ array+queue model ]

my ( $task_id, $error, $failure_type ) = @ARG;

return { 'mode' => qw| false |, 'data' => 'task_id required' }
    unless defined $task_id && length $task_id;

my $queue_href = <coding.task.queue> // {};

return { 'mode' => qw| false |, 'data' => 'task not found' }
    unless exists $queue_href->{$task_id};

my $task = $queue_href->{$task_id};

$task->{'execution'} //= {};
$task->{'execution'}->{'failed_at'}    = <[base.ntime]>;
$task->{'execution'}->{'error'}        = $error        // 'unknown error';
$task->{'execution'}->{'failure_type'} = $failure_type // 'unknown';
$task->{'execution'}->{'retry_count'} //= 0;
$task->{'execution'}->{'status'} = 'failed';

## move id between queue lists : record stays in <coding.task.queue> ##
my $aref_pending = <coding.task.pending> //= [];
my $aref_active  = <coding.task.active>  //= [];
my $aref_failed  = <coding.task.failed>  //= [];

$aref_pending->@* = grep { $ARG ne $task_id } $aref_pending->@*;
$aref_active->@*  = grep { $ARG ne $task_id } $aref_active->@*;
push $aref_failed->@*, $task_id
    unless grep { $ARG eq $task_id } $aref_failed->@*;

<[base.logs]>->(
    0,
    "::task:: failed [%s]: %s [type: %s, retries: %d]",
    $task_id,
    <[base.parser.ellipse_center]>->( $error // 'unknown', 60 ),
    $task->{'execution'}->{'failure_type'},
    $task->{'execution'}->{'retry_count'}
);

## resolve reasoning branch as failed ##
<[reasoning.branch.resolve]>->(
    {   id     => $task_id,
        output => 'failed: ' . ( $error // 'unknown error' )
    }
);

return {
    'mode' => qw| true |,
    'data' => {
        'task_id'     => $task_id,
        'failed_at'   => $task->{'execution'}->{'failed_at'},
        'retry_count' => $task->{'execution'}->{'retry_count'},
    }
};

