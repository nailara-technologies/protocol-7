## [:< ##

# name = coding.task.fail
# descr = mark coding task as failed
# purpose = coding task management : wrapper around jobqueue.move_job to mark job failed with error

my ($job_id, $error_msg) = @ARG;

return {
    success => FALSE,
    error   => 'job_id required'
} unless defined $job_id;

$error_msg //= 'task execution failed';

# Get job data before moving to verify it exists
my $job_data = <[jobqueue.get_job_data]>->($job_id);

return {
    success => FALSE,
    error   => "task not found : $job_id"
} unless defined $job_data;

# Move job to error queue
<[jobqueue.move_job]>->($job_id, 'error');

return {
    success   => TRUE,
    job_id    => $job_id,
    task_id   => $job_data->{object_id},
    error     => $error_msg,
    message   => "task failed : $job_id"
};

