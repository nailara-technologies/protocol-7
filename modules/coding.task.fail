## [:< ##

# name  = coding.task.fail
# descr = move failed task to failed queue with error context

my ( $task, $error, $failure_type ) = @ARG;

return { 'mode' => qw| false |, 'data' => 'task required' }
    unless ref $task eq qw| HASH |;

$task->{'execution'} //= {};
$task->{'execution'}->{'failed_at'}    = <[base.time]>->(3);
$task->{'execution'}->{'error'}        = $error        // 'unknown error';
$task->{'execution'}->{'failure_type'} = $failure_type // 'unknown';
$task->{'execution'}->{'retry_count'} //= 0;
$task->{'execution'}->{'status'} = 'failed';

## store in failed queue ##
my $failed_queue = <coding.task.failed.queue> //= {};
$failed_queue->{ $task->{'id'} } = $task;

## remove from active queue ##
if ( exists <coding.task.queue>->{ $task->{'id'} } ) {
    delete <coding.task.queue>->{ $task->{'id'} };
}

<[base.logs]>->(
    0,
    "::task:: failed [%s]: %s [type: %s, retries: %d]",
    $task->{'id'},
    <[base.parser.ellipse_center]>->( $error // 'unknown', 60 ),
    $task->{'execution'}->{'failure_type'},
    $task->{'execution'}->{'retry_count'}
);

## resolve reasoning branch as failed ##
<[reasoning.branch.resolve]>->(
    {   id     => $task->{'id'},
        output => 'failed: ' . ( $error // 'unknown error' )
    }
);

return {
    'mode' => qw| true |,
    'data' => {
        'task_id'     => $task->{'id'},
        'failed_at'   => $task->{'execution'}->{'failed_at'},
        'retry_count' => $task->{'execution'}->{'retry_count'},
    }
};

