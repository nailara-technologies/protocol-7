## [:< ##

# name = image-batch.init_code
# descr = Image batch orchestrator initialization with infrastructure

## Initialize zenka directory paths for persistent storage
<[base.path-set-up.check-zenka-paths]>->(TRUE);

## Initialize data structures for batch processing with zenka namespace to avoid collisions

## Batch queue: tracks images and their analysis status
<image-batch.batch_queue> = [];

## Batch state: overall batch progress and statistics
<image-batch.batch_state> = {
    batch_id   => '',
    status     => 'idle',
    timestamps =>
        { created => 0, started => 0, last_update => 0, completed => 0 },
    statistics => {
        total_images         => 0,
        analyzed             => 0,
        pending              => 0,
        failed               => 0,
        quality_distribution => {}
    },
    current_operation => {
        image_path       => '',
        stage            => '',
        progress_percent => 0,
        child_pids       => []
    }
};

## Child process tracking: maps PID to job information
<image-batch.child_pids> = {};

## Operation log: chronological record of batch operations
<image-batch.operation_log> = [];

## Error log: failed analyses and rule application errors
<image-batch.error_log> = [];

## Action log: file operations performed (copy, move, scale, tag)
<image-batch.action_log> = [];

## Load Perl modules at startup time using base.perlmod.autoload
## Modules are automatically registered in <base.perlmod.loaded> on success
## Socket, IO::Handle, IO::AIO are already loaded by Protocol-7
map { <[base.perlmod.autoload]>->($ARG) } qw| Data::UUID JSON::XS YAML::XS |;

## Define list structures for observability

## List: batch_state - shows current batch status
<list.batch_state> = {
    'var'  => 'data',
    'key'  => 'batch_state',
    'mask' =>
        'batch_id:id status:state analyzed:count pending:count failed:count',
    'descr' => '[operations] active batch status'
};

## List: job_queue - shows all jobs and their status
<list.job_queue> = {
    'var'  => 'data',
    'key'  => 'batch_queue',
    'mask' =>
        'image_path:file status:state grade:letter rule_applied:action result:ok',
    'descr' => '[operations] job queue and results'
};

## List: operation_log - shows major batch milestones
<list.operation_log> = {
    'var'     => 'data',
    'key'     => 'operation_log',
    'mask'    => 'timestamp:time action:op image:file status:state',
    'align'   => {},
    'filters' => {},
    'descr'   => '[operations] major milestones'
};

## List: error_log - shows failed operations
<list.error_log> = {
    'var'   => 'data',
    'key'   => 'error_log',
    'mask'  => 'timestamp:time image:file error_type:type reason:msg',
    'descr' => '[errors] failed operations'
};

## List: action_log - shows file operations performed
<list.action_log> = {
    'var'   => 'data',
    'key'   => 'action_log',
    'mask'  => 'timestamp:time image:file action:op source:file target:file',
    'descr' => '[actions] file operations performed'
};

return TRUE;

