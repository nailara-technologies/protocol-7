## [:< ##

# name  = reasoning.tree.lookup
# descr = find node by checksum or name in reasoning tree

my $args = @ARG ? shift : $ARG;
$args //= {};

my $tree   = $args->{'tree'} // <reasoning.tree> // {};
my $chksum = $args->{'chksum'};
my $name   = $args->{'name'};

## [ O(1) checksum lookup ] ##
if ( defined $chksum and length $chksum ) {
    return $tree->{'by_chksum'}->{$chksum}
        if exists $tree->{'by_chksum'}->{$chksum};
    return undef;
}

## [ O(n) name lookup via index ] ##
if ( defined $name and length $name ) {
    return $tree->{'by_name'}->{$name}
        if exists $tree->{'by_name'}->{$name};
    return undef;
}

return undef;

