## [:< ##
# name  = plugin.storage.checksum.lookup
# descr = Look up files by checksum

use strict;
use warnings;

return sub {
    my ($args) = @ARG;

    my $checksum = $args->{checksum}
        or return { 'mode' => 'false', 'data' => 'checksum required' };

    my $registry = $data{'storage'}{'mapping'}{'checksum'};
    my $paths    = $registry->{'reverse'}{$checksum} // [];

    # Verify paths still exist and match
    my @valid_paths;
    for my $path (@$paths) {
        if ( -f $path ) {
            my $cached = $registry->{'cache'}{$path};
            if ( $cached and $cached->{checksum} eq $checksum ) {
                push @valid_paths, $path;
            }
        }
    }

    return {
        'mode' => 'true',
        'data' => {
            'checksum' => $checksum,
            'paths'    => \@valid_paths,
            'count'    => scalar(@valid_paths),
        }
    };
};

