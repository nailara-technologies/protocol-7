## [:< ##

# name = menu-commands.save-state
# descr = Save menu-commands persistent state to disk

use YAML::XS qw| Dump |;

my $cache_dir = <menu-commands.cache_dir>;
my $mappings_file = $cache_dir . '/mappings.yaml';
my $categories_file = $cache_dir . '/categories.yaml';

# Save mappings
eval {
    my $mappings_data = {
        'mappings' => <menu-commands.mappings>,
        'metadata' => {
            'saved_at' => <[base.time]>->(3),
            'count' => scalar(keys %{<menu-commands.mappings>})
        }
    };
    my $yaml_content = Dump($mappings_data);
    <[base.file.put]>->($mappings_file, $yaml_content);
};
if ($EVAL_ERROR) {
    <[base.s_warn]>->('Error saving mappings: ' . $EVAL_ERROR);
    return 0;
}

# Save categories
eval {
    my $categories_data = {
        'categories' => <menu-commands.categories>,
        'metadata' => {
            'saved_at' => <[base.time]>->(3),
            'count' => scalar(keys %{<menu-commands.categories>})
        }
    };
    my $yaml_content = Dump($categories_data);
    <[base.file.put]>->($categories_file, $yaml_content);
};
if ($EVAL_ERROR) {
    <[base.s_warn]>->('Error saving categories: ' . $EVAL_ERROR);
    return 0;
}

1;

