## [:< ##

# name = menu-commands.save-state
# descr = Save menu-commands persistent state to disk

use YAML::XS qw| Dump |;

# Save mappings
my $mappings_data = {
    'mappings' => <menu-commands.mappings>,
    'metadata' => {
        'saved_at' => <[base.time]>->(3),
        'count' => scalar(keys %{<menu-commands.mappings>})
    }
};
my $yaml_content = Dump($mappings_data);
my $mappings_ref = \$yaml_content;
unless (<[file.zenka_dir.write]>->('data/mappings.yaml', $mappings_ref, '>', 0600, ':utf8')) {
    return 0;
}

# Save categories
my $categories_data = {
    'categories' => <menu-commands.categories>,
    'metadata' => {
        'saved_at' => <[base.time]>->(3),
        'count' => scalar(keys %{<menu-commands.categories>})
    }
};
my $yaml_content_cats = Dump($categories_data);
my $categories_ref = \$yaml_content_cats;
unless (<[file.zenka_dir.write]>->('data/categories.yaml', $categories_ref, '>', 0600, ':utf8')) {
    return 0;
}

1;

