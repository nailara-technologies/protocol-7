## [:< ##

# name  = transport.demote
# descr = mark transport as demoted for a destination
# args  = $dest, $type, $reason

my ( $dest, $type, $reason ) = @ARG;

return if not defined $dest or not defined $type;

<transport.registry>->{'demoted'}{$dest}{$type} = <[base.time]>->(4);

<[base.logs]>->(
    1, 'transport.demote: %s demoted for %s (reason: %s)',
    $type, $dest, $reason // 'unknown'
);

## update consecutive failures ##
my $q = <transport.registry>->{'quality'}{$type}{$dest} //= {};
$q->{'consecutive_failures'} //= 0;
$q->{'consecutive_failures'}++;

return 1;

