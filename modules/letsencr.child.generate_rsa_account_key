## [:< ##

# name  = letsencr.child.generate_rsa_account_key
# descr = generate RSA 2048-bit account key for ACME operations (RS256)

<[base.log]>->( 2, 'generating new RSA 2048-bit account key for ACME' );

my $start_time = time();

## generate RSA 2048-bit keypair using CryptX library
## uses Crypt::PK::RSA for proper PKCS#1 v1.5 padding and RS256 signing
my $pk = Crypt::PK::RSA->new;
$pk->generate_key(2048);

<[base.log]>->(
    2,
    'RSA 2048-bit account key generated in '
        . ( time() - $start_time )
        . ' seconds'
);

## generate unique key identifier for storage
my $key_name = 'acme-account-' . <[base.prng.chars-anum]>->(8);

## extract public key components for JWK
my $key_info = $pk->key2hash;
my $modulus  = $key_info->{N};
my $exponent = $key_info->{e};

## base64url encode for JWK usage
my $modulus_b64  = encode_base64url($modulus);
my $exponent_b64 = encode_base64url($exponent);

## export private key as PEM format for caching
my $pem_private = $pk->export_key_pem('private');

## store in global %keys{'RSA'} hash following Protocol-7 pattern
$keys{'RSA'}->{$key_name} = {
    'pk_object'   => $pk,
    'modulus'     => $modulus_b64,
    'exponent'    => $exponent_b64,
    'pem_private' => $pem_private,
    'time-loaded' => time(),
};

## cache private key to disk for persistence
my $key_cache = sprintf '%s/account.key.rsa', <letsencr.cache.dir>;

{
    open( my $fh, '>:raw', $key_cache ) or do {
        <[base.log]>
            ->( 1, "error: unable to write RSA account key file: $!" );
        return undef;
    };
    print $fh $pem_private;
    close($fh);
}
chmod( 0600, $key_cache );

<[base.logs]>->(
    2, "RSA account key saved to %s [ PEM encoded ]", $key_cache
);

## store key name in child state for later reference
<letsencr.child.acme_client>->{account_key_name} = $key_name;
<letsencr.child.acme_client>->{account_key_type} = 'RSA';

<[base.log]>->( 2, 'RSA account key ready for ACME operations' );

## return keypair (key_name is already stored in acme_client state)
return {
    'key_name' => $key_name,
    'pk'       => $pk,
    'modulus'  => $modulus_b64,
    'exponent' => $exponent_b64,
};

