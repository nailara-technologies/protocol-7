## [:< ##

# name  = letsencr.child.generate_rsa_account_key
# descr = generate RSA 2048-bit account key for ACME operations (RS256)

<[base.log]>->( 2, 'generating new RSA 2048-bit account key for ACME' );

my $start_time = time();

## generate RSA 2048-bit keypair using Crypt::OpenSSL::RSA
## [ OpenSSL library with proper PKCS#1 v1.5 padding for RS256 ]
my $rsa = Crypt::OpenSSL::RSA->generate_key(2048);

<[base.log]>->(
    2,
    'RSA 2048-bit account key generated in '
        . ( time() - $start_time )
        . ' seconds'
);

## get private key in PEM format for caching
my $pem_private = $rsa->get_private_key_string;
my $pem_public  = $rsa->get_public_key_string;

## extract modulus and exponent using openssl command
my $modulus_b64;
my $exponent_b64;

## write public key to temp file for openssl parsing
my ( $fh, $temp_pub ) = <[file.temp]>;
print $fh $pem_public;
close($fh);

## extract modulus as hex
my $modulus_hex
    = `openssl rsa -pubin -noout -modulus < $temp_pub 2>/dev/null`;
$modulus_hex =~ s/Modulus=//;
chomp($modulus_hex);

## convert modulus hex to binary and base64url
if ($modulus_hex) {
    my $modulus_bin = pack( 'H*', lc($modulus_hex) );
    $modulus_b64 = encode_base64url($modulus_bin);
}

## extract exponent (standard RSA exponent is 65537 = 0x10001)
my $exponent_int = 65537;
my $exponent_hex = sprintf '%x', $exponent_int;
my $exponent_bin = pack( 'H*', $exponent_hex );
$exponent_b64 = encode_base64url($exponent_bin);

## fallback if openssl extraction failed
unless ($modulus_b64) {
    <[base.log]>->( 1, 'warning: could not extract modulus from openssl' );
    return undef;
}

## generate unique key identifier
my $key_name = 'acme-account-' . <[base.prng.chars-anum]>->(8);

## store in global %keys{'RSA'} hash
$keys{'RSA'}->{$key_name} = {
    'rsa_object'  => $rsa,
    'modulus'     => $modulus_b64,
    'exponent'    => $exponent_b64,
    'pem_private' => $pem_private,
    'time-loaded' => time(),
};

## cache private key to disk
my $key_cache = sprintf '%s/account.key.rsa', <letsencr.cache.dir>;

{
    open( my $fh, '>:raw', $key_cache ) or do {
        <[base.log]>->( 1, "error: unable to write RSA account key: $!" );
        return undef;
    };
    print $fh $pem_private;
    close($fh);
}
chmod( 0600, $key_cache );

<[base.logs]>->(
    2, "RSA account key saved to %s [ PEM encoded ]", $key_cache
);

## store in child state
<letsencr.child.acme_client>->{account_key_name} = $key_name;
<letsencr.child.acme_client>->{account_key_type} = 'RSA';

<[base.log]>->( 2, 'RSA account key ready for ACME operations' );

return {
    'key_name' => $key_name,
    'rsa'      => $rsa,
    'modulus'  => $modulus_b64,
    'exponent' => $exponent_b64,
};

