## [:< ##

# name  = coding.init_output_buffer
# descr = initialize output buffer for observing model interactions

##  model output observation buffer  ##
##  used to capture and analyze model behavior, detect patterns  ##

<buffer.model_output.max_size> //= 128 * 1024;    ## 128K buffer ##

my $buffer_name = 'model_output';

##  check if re-initializing  ##
my $is_init
    = defined $data{'buffer'}{$buffer_name}{'data'}
    ? qw| re-init |
    : qw| init |;

##  add header line  ##
<[base.buffer.add_line]>->(
    $buffer_name,
    sprintf(
        '.:[ %s | coding model output buffer %s ]:.',
        <[base.time]>->(2), $is_init
    )
);

##  add empty line for spacing  ##
<[base.buffer.add_line]>->( $buffer_name, '' );

return TRUE;

