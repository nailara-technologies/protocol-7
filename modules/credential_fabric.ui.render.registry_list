## [:< ##

# name  = credential_fabric.ui.render.registry_list
# descr = render the slot registry list frame with column-aligned rows

my $params = shift // {};

my $entry = <[ascii.frame.load]>->('credential-fabric/registry-list');
return '' if not defined $entry;

my $data = <[credential_fabric.ui.query.slots]>;

my $descriptor;
if ( exists $entry->{'descriptor'} ) {
    $descriptor = $entry->{'descriptor'};
} elsif ( exists $entry->{'descriptors'} ) {
    my $mode = $entry->{'modes'}[0] // 'expanded';
    $descriptor = $entry->{'descriptors'}{$mode};
}
return '' if not defined $descriptor;

my $slots = $data->{'slots'} // [];
my $count = scalar @$slots;

## compute column widths from data ##
my $slot_w  = 4;    ## 'slot' header ##
my $owner_w = 5;    ## 'owner' header ##
my $type_w  = 4;    ## 'type' header ##
my $sens_w  = 4;    ## 'sens' header ##

for my $s (@$slots) {
    my $sl = length( $s->{'slot'} // '' );
    $slot_w = $sl if $sl > $slot_w;

    my $ow = length( $s->{'owner'} // '' );
    $owner_w = $ow if $ow > $owner_w;

    my $tw = length( $s->{'type'} // '' );
    $type_w = $tw if $tw > $type_w;

    my $sw = length( $s->{'sensitivity'} // '' );
    $sens_w = $sw if $sw > $sens_w;
}

## add 2 chars for single quotes around slot name ##
$slot_w += 2;

my @lines;
push @lines,
    sprintf( "%-*s  %-*s  %-*s  %s",
    $slot_w, 'slot', $owner_w, 'owner', $type_w, 'type', 'sens' );

for my $s ( sort { $a->{'slot'} cmp $b->{'slot'} } @$slots ) {
    push @lines,
        sprintf(
        "%-*s  %-*s  %-*s  %s",
        $slot_w,  sprintf( qw| '%s' |, $s->{'slot'} ),
        $owner_w, $s->{'owner'}, $type_w, $s->{'type'}, $s->{'sensitivity'}
        );
}

my $block = join "\n", @lines;

my %values = (
    SLOT_COUNT  => $count,
    SLOTS_BLOCK => $block,
);

my $rendered = <[ascii.frame.render]>->(
    {   descriptor => $descriptor,
        values     => \%values,
    }
);

return $rendered // '';

