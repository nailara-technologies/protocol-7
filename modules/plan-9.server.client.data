## [:< ##
# name  = plan-9.server.client.data
# descr = Process data from 9P client

use strict;
use warnings;

return sub {
    my ( $fd, $data ) = @_;

    my $client = $data{'plan-9'}{'server'}{'clients'}{$fd};
    return unless $client;

    $client->{'buffer'} .= $data;

    while ( length( $client->{'buffer'} ) >= 4 ) {
        my $size = <[plan-9.protocol.codec.decode-uint32]>
            ->( substr( $client->{'buffer'}, 0, 4 ) );

        return if length( $client->{'buffer'} ) < $size;

        my $msg  = substr( $client->{'buffer'}, 0, $size, '' );
        my $type = <[plan-9.protocol.codec.decode-uint8]>
            ->( substr( $msg, 4, 1 ) );
        my $tag = <[plan-9.protocol.codec.decode-uint16]>
            ->( substr( $msg, 5, 2 ) );
        my $payload = substr( $msg, 7 );

        my $response = <[plan-9.server.handle_request]>->(
            $client, $fd, $type, $tag, $payload
        );

        if ($response) {
            <[base.net.send_to_socket]>->( $fd, \$response );
        }
    }
};

