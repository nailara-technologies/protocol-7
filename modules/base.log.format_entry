## [:< ##

# name  = base.log.format_entry
# descr = format a log entry string from level, message, and optional prefix;
#         centralizes level-to-color mapping for base.log, flush paths,
#         and future log visualization clients
# args  = log_level, log_msg [, prefix]
# note  = if prefix is omitted, calls log.format_name for the current zenka

my ( $log_level, $log_msg, $prefix ) = @ARG;

$prefix //= <[log.format_name]>;

## color index per log level [ 0=error 1=default 2=info 3+=debug ] ##
state @fg_idx = ( 3, 4, 1 );

return sprintf '%s %s%s%s%s%s',
    $prefix,
    ( $log_level        ? ''    : $colors{'bold'} ),
    $colors{ $log_level ? 'B01' : 'B02' },
    $colors{ 'p7_fg_000' . ( $fg_idx[$log_level] // 0 ) },
    $log_msg,
    $colors{'reset'};

