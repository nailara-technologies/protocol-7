# name  = nshell.hook.unknown_command_global
# descr = Intercept globally unknown commands and display to user

my ($msg_data) = @ARG;

return FALSE unless defined $msg_data;

my $cmd    = $msg_data->{'cmd'};
my $cmd_id = $msg_data->{'cmd_id'};
my $user   = $msg_data->{'user'} // 'unknown';

## Format and display the unknown command to user
my $output = sprintf( "\n[nshell: unknown command] '%s' (user: %s, id: %d)\n",
    $cmd, $user, $cmd_id );

print $output;
$| = 1;    ## flush immediately

return TRUE;    ## we handled it

