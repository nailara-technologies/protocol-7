# name  = nshell.hook.unknown_command_global
# descr = Intercept globally unknown commands and display to user

my ($msg_data) = @ARG;

return FALSE unless defined $msg_data;

my $cmd = $msg_data->{'cmd'};

## Display message transparently to user
print $cmd . ": command not found\n";
$| = 1;    ## flush immediately

return TRUE;    ## we handled it

