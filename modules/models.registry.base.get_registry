## [:< ##

# name  = models.registry.base.get_registry
# descr = Get or load registry from persistent storage

return $data{models}{registry} if defined $data{models}{registry};

# Load from disk if not in memory
my $registry = <[models.registry.load.load_registry]>->();
$data{models}{registry} = $registry;
return $registry;

