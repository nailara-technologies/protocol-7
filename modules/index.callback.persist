## [:< ##

# name  = index.callback.persist
# descr = deferred persist reply after blocking nstore completes

my $reply_id = delete <index.persist.reply_id>;

my $ok = <[index.persist]>;

<[base.callback.cmd_reply]>->(
    $reply_id,
    $ok
    ? { 'mode' => 'size',  'data' => 'index state saved' }
    : { 'mode' => 'false', 'data' => 'persist failed' }
);

