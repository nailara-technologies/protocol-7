# name = models.registry.find_alternative
# descr = Find best alternative model in registry

sub find_best_alternative {
  my ($model_amos, $context) = @_;
  my $base = <[models.registry.base]>;
  my $registry = $base->{get_registry}->();

  my $entry = $registry->{models}->{$model_amos};
  return undef unless $entry;

  return $entry->{statistics}->{alternatives}->[0] // undef;
}

# Entry point
{
  my @args = @ARG;
  return find_best_alternative(@args);
};

