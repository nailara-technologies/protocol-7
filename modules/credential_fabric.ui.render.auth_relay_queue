# name  = credential_fabric.ui.render.auth_relay_queue
# descr = render the pending auth-relay queue frame

my $params = shift // {};

my $entry = <[ascii.frame.load]>->('credential-fabric/auth-relay-queue');
return { 'rendered' => '', 'row_keys' => [] } if not defined $entry;

my $focus_index = $params->{'focus_index'};

my $data = <[credential_fabric.ui.query.auth_relay]>;

my $descriptor;
if ( exists $entry->{'descriptor'} ) {
    $descriptor = $entry->{'descriptor'};
} elsif ( exists $entry->{'descriptors'} ) {
    my $mode = $entry->{'modes'}[0] // 'expanded';
    $descriptor = $entry->{'descriptors'}{$mode};
}
return { 'rendered' => '', 'row_keys' => [] }
    if not defined $descriptor;

my $relays = $data->{'relays'} // [];
my $count  = scalar @$relays;

my @lines;
my @row_keys;
my $row_idx = 0;
for my $r (@$relays) {
    my $age_str = <[credential_fabric.util.format_age]>->( $r->{'age_s'} );
    my $row     = sprintf( '%s  %s  %s  %s',
        $r->{'req_id'}, $r->{'domain'}, $age_str, $r->{'status'} );

    push @row_keys, $r->{'req_id'};

    if ( defined $focus_index and $row_idx == $focus_index ) {
        $row = "\e[7m" . $row . "\e[27m";
    }

    push @lines, $row;
    $row_idx++;
}

my $block = @lines ? join( "\n", @lines ) : '';

my %values = (
    RELAY_COUNT  => $count,
    RELAYS_BLOCK => $block,
);

my $rendered = <[ascii.frame.render]>->(
    {   descriptor => $descriptor,
        values     => \%values,
    }
);

return {
    'rendered' => $rendered // '',
    'row_keys' => \@row_keys,
};

