## [:< ##

# name  = plugin.web.jobs.sync
# descr = handle POST sync — jobsite push or browser field update

my $id = shift;

my $session = $data{'session'}->{$id};

my $body = $session->{'http'}->{'body'} // $session->{'buffer'}->{'input'}
    // '';
$session->{'http'}->{'body'}    = undef;
$session->{'buffer'}->{'input'} = '';

my $payload = eval { JSON::XS::decode_json($body) };
if ( $@ or ref $payload ne 'HASH' ) {
    my $rb = '{"ok":false,"error":"invalid json"}';
    $session->{'buffer'}->{'output'} .= <[httpd.new_header]>->(
        400,
        {   'Content-Type'   => 'application/json',
            'Content-Length' => length($rb)
        }
    );
    $session->{'buffer'}->{'output'} .= $rb;
    return 2;
}

my $job_id = $payload->{'id'} // '';
if ( not length $job_id ) {
    my $rb = '{"ok":false,"error":"missing id"}';
    $session->{'buffer'}->{'output'} .= <[httpd.new_header]>->(
        400,
        {   'Content-Type'   => 'application/json',
            'Content-Length' => length($rb)
        }
    );
    $session->{'buffer'}->{'output'} .= $rb;
    return 2;
}

## load cached record or start fresh ##
my $job = eval {
    my $f = <[plugin.web.jobs.cache.path]> . "/$job_id.yaml";
    -f $f ? YAML::XS::LoadFile($f) : {};
} // {};

## jobsite push: has pipeline-owned fields — overwrite pipeline fields,
## preserve browser-owned fields already in cache ##
my @pipeline_fields = qw| title company url score score_reason score_summary
    fetched_at status description |;
my @browser_fields = qw| stage notes date_applied |;

if ( exists $payload->{'fetched_at'} or exists $payload->{'score'} ) {
    ## jobsite push — update pipeline fields, keep browser fields ##
    for my $f (@pipeline_fields) {
        $job->{$f} = $payload->{$f} if exists $payload->{$f};
    }
} else {
    ## browser update — only browser-owned fields, queue reverse change ##
    my %changed;
    for my $f (@browser_fields) {
        if ( exists $payload->{$f} ) {
            $job->{$f} = $payload->{$f};
            $changed{$f} = $payload->{$f};
        }
    }
    if (%changed) {
        <[plugin.web.jobs.reverse.queue]>->( { 'id' => $job_id, %changed } );
    }
}

my $ok = <[plugin.web.jobs.cache.write]>->( $job_id, $job );

## return reverse queue to jobsite callers ##
my $reverse = <[plugin.web.jobs.reverse.flush]>;
my $rb      = eval {
    JSON::XS::encode_json(
        {   'ok'      => $ok ? JSON::XS::true() : JSON::XS::false(),
            'reverse' => $reverse
        }
    );
} // '{"ok":false,"error":"encode failed"}';

my $reply_header = {
    qw| Content-Type   | => qw| application/json |,
    qw| Content-Length | => length($rb),
    qw| Connection     | => qw| close |,
};

$session->{'buffer'}->{'output'}
    .= <[httpd.new_header]>->( 200, $reply_header );
$session->{'buffer'}->{'output'} .= $rb;

return 2;

