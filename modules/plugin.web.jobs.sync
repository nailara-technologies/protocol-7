## [:< ##

# name  = plugin.web.jobs.sync
# descr = jobs sync endpoint — handles batch jobsite push or single browser update

my $call = shift           // {};
my $body = $call->{'args'} // '';

my $payload = eval { JSON::XS::decode_json($body) };
if ( $@ or ref $payload ne 'HASH' ) {
    return {
        'mode'         => 'size',
        'data'         => '{"ok":false,"error":"invalid json"}',
        'content_type' => 'application/json',
    };
}

my @pipeline_fields = qw| title company url score score_reason score_summary
    fetched_at status description last_modified |;
my @browser_fields = qw| stage notes date_applied |;

my $since    = '';
my @job_list = ();

if ( ref $payload->{'jobs'} eq 'ARRAY' ) {
    ## batch push from jobsite ##
    $since    = $payload->{'since'} // '';
    @job_list = @{ $payload->{'jobs'} };
} else {
    ## single update from browser ##
    @job_list = ($payload);
}

my $ok = TRUE;
for my $job_data (@job_list) {
    my $job_id = $job_data->{'id'} // '';
    next if not length $job_id;

    ## load cached record or start fresh ##
    my $cached = eval {
        my $f = <[plugin.web.jobs.cache.path]> . "/$job_id.yaml";
        -f $f ? YAML::XS::LoadFile($f) : {};
    } // {};

    if (   exists $job_data->{'fetched_at'}
        or exists $job_data->{'score'}
        or exists $job_data->{'last_modified'} ) {
        ## jobsite push — update pipeline fields, keep browser fields ##
        for my $f (@pipeline_fields) {
            $cached->{$f} = $job_data->{$f} if exists $job_data->{$f};
        }
    } else {
        ## browser update — browser-owned fields only, queue reverse ##
        my %changed;
        for my $f (@browser_fields) {
            if ( exists $job_data->{$f} ) {
                $cached->{$f} = $job_data->{$f};
                $changed{$f} = $job_data->{$f};
            }
        }
        if (%changed) {
            <[plugin.web.jobs.reverse.queue]>
                ->( { 'id' => $job_id, %changed } );
        }
    }

    my $wrote = <[plugin.web.jobs.cache.write]>->( $job_id, $cached );
    $ok = FALSE if not $wrote;
}

## flush reverse queue, filtered to entries newer than since ##
my $all_reverse = <[plugin.web.jobs.reverse.flush]>;
my @reverse
    = length($since)
    ? grep { ( $_->{'ntime'} // '' ) gt $since } @{$all_reverse}
    : @{$all_reverse};

my $current_ntime = <[ntime.b32]>;

my $rb = eval {
    JSON::XS::encode_json(
        {   'ok'      => $ok ? JSON::XS::true() : JSON::XS::false(),
            'reverse' => \@reverse,
            'ntime'   => $current_ntime,
        }
    );
} // '{"ok":false,"error":"encode failed"}';

return {
    'mode'         => 'size',
    'data'         => $rb,
    'content_type' => 'application/json',
};

