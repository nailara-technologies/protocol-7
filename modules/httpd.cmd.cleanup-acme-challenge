## [:< ##

# name  = httpd.cmd.cleanup-acme-challenge
# param = <domain>
# descr = remove HTTP-01 challenge directory

my $domain = ( split m{\ +}, $call->{'args'} // '' )[0];

unless ($domain) {
    return {
        'mode' => qw| false |,
        'data' => 'domain required'
    };
}

<[base.logs]>->( 1, 'cleaning up HTTP-01 challenge for %s', $domain );

## remove well-known challenge directory
my $well_known_dir
    = sprintf( '%s%s/.well-known/acme-challenge', <httpd.site_dir>, $domain );

## Get token from letsencr child call
my $token = ( split m{\ +}, $call->{'args'} // '' )[1];

if ($token) {
    my $challenge_file = join qw| / |, $well_known_dir, $token;
    if ( -f $challenge_file ) {
        <[base.logs]>->( 2, 'removing challenge file: %s', $challenge_file );
        if ( unlink($challenge_file) ) {
            <[base.logs]>->(
                2, 'challenge file removed: %s',
                $challenge_file
            );
        } else {
            my $error = <[base.str.os_err]>;
            <[base.logs]>->(
                1, 'failed to remove challenge file: %s', $error
            );
        }
    }
}

## Clean up empty directories if nothing left
if ( -d $well_known_dir ) {
    <[base.logs]>->(
        2, 'cleaning up challenge directory: %s',
        $well_known_dir
    );
    <[file.clean-paths]>->($well_known_dir);
}

## Also clean up .well-known parent directory if empty
my $well_known_parent
    = sprintf( '%s%s/.well-known', <httpd.site_dir>, $domain );
if ( -d $well_known_parent ) {
    <[base.logs]>->(
        2, 'cleaning up .well-known directory: %s',
        $well_known_parent
    );
    <[file.clean-paths]>->($well_known_parent);
}

## If vhost directory is now empty, remove it too (temporary challenge-only vhost)
my $vhost_path = sprintf '%s%s', <httpd.site_dir>, $domain;
if ( -d $vhost_path ) {
    opendir my $dirh,
        $vhost_path
        or return {
        'mode' => qw| true |,
        'data' => 'cleanup complete'
        };
    my @entries = grep { $ARG ne qw| . | and $ARG ne qw| .. | } readdir $dirh;
    closedir $dirh;

    ## Remove vhost if it's now empty
    if ( !@entries ) {
        <[base.logs]>->(
            2, 'removing empty vhost directory: %s', $vhost_path
        );
        if ( rmdir($vhost_path) ) {
            <[base.logs]>->( 1, 'vhost directory removed: %s', $vhost_path );
        } else {
            my $error = <[base.str.os_err]>;
            <[base.logs]>->(
                2, 'could not remove vhost directory: %s', $error
            );
        }
    }
}

return {
    'mode' => qw| true |,
    'data' => 'cleanup complete'
};

