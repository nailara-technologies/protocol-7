## [:< ##

# name = base.check_dependency_dirs

my $user           = shift // <system.amos-zenka-user>;
my $zenka          = <system.zenka.name>;
my $cfg_path       = <system.conf_path>;
my $start_cfg_name = qw| start |;

my $subdir_perms = 0775;    ##  zenki group needs write access  ##

my @sub_dirs = qw[
    os-dep
    os-dep/binary
    os-dep/debian
    pm-dep
    source
];

my $dep_dir = <[base.get_path.zenka_cfg]>;

if (    $dep_dir =~ s|zenki/$zenka/$start_cfg_name$|$cfg_path/zenki/$zenka|
    and -d $dep_dir
    and -w $dep_dir ) {

    ## Get parent directory owner and group ##
    my $parent_owner = <[base.path_owners]>->($dep_dir);
    unless ( defined $parent_owner ) {
        <[base.logs]>->(
            0,
            "<< check_dependency_dirs : cannot "
                . "get parent dir owner for '%s' >>",
            $dep_dir
        );
        return undef;
    }

    ## Get zenka group [ gid 0 fallback for root when no 'root' group entry ]
    my $zenka_group = $user;

    my $gid = getgrnam($zenka_group)
        // ( $zenka_group eq qw| root | ? 0 : undef );

    ## try auto-installing user if not found and running as root ##
    if ( not defined $gid and $EUID == 0 ) {
        <[base.logs]>->(
            2, ': : auto-creating system user [%s]', $zenka_group
        );
        if ( <[base.root.check_system_user]>->($zenka_group) ) {
            $gid = getgrnam($zenka_group)
                // ( $zenka_group eq qw| root | ? 0 : undef );
        }
    }

    unless ( defined $gid ) {
        <[base.logs]>->(
            0, "<< check_dependency_dirs : unix group '%s' not found >>",
            $zenka_group
        );
        return undef;
    }

    ## Get parent owner UID for placeholder chown ##
    my ( undef, undef, $parent_uid ) = getpwnam($parent_owner)
        or <[base.logs]>->(
        0, "<< check_dependency_dirs : cannot get uid for '%s' >>",
        $parent_owner
        ) and return undef;

    foreach my $sub_dir (@sub_dirs) {
        my $dir_path = catfile( $dep_dir, $sub_dir );

        ## ..avoiding race conditions in pre_init phase before swap_subs.. ##
        my $early_makepath_code_ref
            = exists $code{'file.make_path'}
            ? $code{'file.make_path'}
            : $code{'base.file.make_path'};

        ## use file.make_path to create\fix directory with ##
        ##                      parent owner + zenka group ##
        $early_makepath_code_ref->(
            $dir_path, $subdir_perms, $parent_owner, $zenka_group
        ) if ref $early_makepath_code_ref eq qw| CODE | and -r $dep_dir;

        ( my $relpath = $dir_path ) =~ s|^.*/||;

        ## create placeholder file ##
        my $placeholder_path = catfile( $dir_path, qw| .placeholder | );
        ( my $ph_relpath = $placeholder_path ) =~ s|^.+/zenki/||;

        if ( not -e $placeholder_path ) {
            open( my $fh, qw| > |, $placeholder_path ) or next;
            close($fh);
        }

        ## fix placeholder ownership ##
        if ( $EUID == 0 ) {
            chown( $parent_uid, $gid, $placeholder_path )
                or <[base.logs]>->(
                2,           ":. : cannot chown %s : %s .:",
                $ph_relpath, <[base.str.os_err]>
                );
        }
    }
}

