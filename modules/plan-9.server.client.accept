## [:< ##
# name  = plan-9.server.client.accept
# descr = Handle 9P client connection

use strict;
use warnings;

return sub {
    my ( $fd, $peer_addr ) = @_;

    $data{'plan-9'}{'server'}{'clients'}{$fd} = {
        'fids'   => {},
        'msize'  => 8192,
        'uname'  => undef,
        'aname'  => undef,
        'buffer' => '',
        'peer'   => $peer_addr,
    };

    <[base.logs]>->("9P client connected from $peer_addr");
};

