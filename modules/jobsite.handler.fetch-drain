## [:< ##

# name  = jobsite.handler.fetch-drain
# descr = called when site-yaml fetch queue drains : proceed to assessments

<[base.logs]>->( 1, 'fetch queue drained, proceeding to assessments' );

<[jobsite.dispatch.assessments]>;

return;

