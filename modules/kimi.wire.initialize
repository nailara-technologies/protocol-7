## [:< ##

# name  = kimi.wire.initialize
# descr = send json-rpc initialize handshake to kimi-web wire server

my $msg_id = 'p7-kimi-init';

## clear retry pending flag [ timer has fired ]
<kimi.init.retry_pending> = FALSE;

<[base.logs]>->( 2, 'kimi.wire.initialize: sending initialize handshake' );

## register pending so we notice the response
<kimi.wire.pending>->{$msg_id} = {
    'type'    => qw| initialize |,
    'sent_at' => <[base.time]>->(3)
};

<[kimi.wire.send]>->(
    qw| initialize |,
    $msg_id,
    {   'protocol_version' => '1.3',
        'client'           => { 'name' => 'p7-kimi', 'version' => '0.1.0' }
    }
);

