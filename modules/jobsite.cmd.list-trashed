## [:< ##

# name  = jobsite.cmd.list-trashed
# param = [limit=<n>]
# descr = list recently trashed jobs

my $args  = $call->{'args'} // '';
my $limit = ( $args =~ m{(?:^|&)limit=(\d+)} ) ? $1 : 50;
$limit = 200 if $limit > 200;

my $jobs_root = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite jobs |;

my $idx = <jobsite.job.index> // {};

## cheap pass : stat every trash entry's file mtime [ = the moment it was  ##
## written into trash, a one-time write ] instead of decompressing all of ##
## them just to sort -- only the top $limit survivors get decompressed    ##
## below to fetch display metadata ##
## File::stat overloads the stat() builtin to return a blessed object      ##
## instead of a 13-element list -- `my @stat = stat(...)` under it silently ##
## collapses to a 1-element list [ the object ] in list context, so        ##
## $stat[9] was always undef. use the object accessor instead ##
my @candidates;
for my $id ( keys %{$idx} ) {
    my $st = $idx->{$id} // '';
    next unless $st =~ m{^trash:(.+)$};
    my $epoch    = $1;
    my $enc_id   = <[base.vax-int.encode]>->($id);
    my $abs_path = "$jobs_root/trash/$epoch/$enc_id.yxz.B32";
    my $fstat    = File::stat::stat($abs_path);
    next unless $fstat;
    push @candidates, { 'id' => $id, 'mtime' => $fstat->mtime };
}

@candidates
    = sort { ( $b->{'mtime'} // 0 ) <=> ( $a->{'mtime'} // 0 ) } @candidates;
splice( @candidates, $limit ) if @candidates > $limit;

my @array;
for my $c (@candidates) {
    my $job = <[jobsite.job.read]>->( $c->{'id'} );
    next unless ref $job eq 'HASH';
    push @array,
        {
        'id'         => <[base.vax-int.encode]>->( $c->{'id'} ),
        'title'      => $job->{'title'}   // '',
        'company'    => $job->{'company'} // '',
        'city'       => $job->{'city'}    // '',
        'score'      => $job->{'score'}   // '',
        'trashed_at' => $c->{'mtime'},
        };
}

my $json = eval { JSON::XS::encode_json( { 'jobs' => \@array } ) };
if ($@) {
    <[base.logs]>->(
        0, 'jss.list-trashed: json error: %s',
        <[base.str.eval_error]>
    );
    return {
        'mode'         => qw| strm |,
        'data'         => '{"jobs":[]}',
        'content_type' => qw| application/json |,
    };
}

return {
    'mode'         => qw| strm |,
    'data'         => $json,
    'content_type' => qw| application/json |,
};

