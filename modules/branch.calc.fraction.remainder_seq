# name  = branch.calc.fraction.remainder_seq
# descr = return full list of remainders from long division of X/Y
# param = numerator, denominator
#
# sequence length equals period length. orbit of X in group mod Y.

my ( $numerator, $denominator ) = @ARG;

return undef
    if not defined $numerator
    or not defined $denominator
    or $denominator == 0;

my @seq;
my $rem = $numerator % $denominator;
my %seen;

while ( $rem != 0 ) {
    last if exists $seen{$rem};
    $seen{$rem} = 1;
    push @seq, $rem;
    $rem = ( $rem * 10 ) % $denominator;
}

return \@seq;

