# name = coding.helper.refund_tokens
# descr = refund unused tokens from failed operation

my ( $task_id, $tokens_to_refund ) = @ARG;

<coding.budget.used> -= $tokens_to_refund;
<coding.budget.used> = 0 if <coding.budget.used> < 0;

return {
    success     => TRUE,
    refunded    => $tokens_to_refund,
    new_balance => <coding.budget.allocated> - <coding.budget.used>,
    message     => "Refunded $tokens_to_refund tokens for task $task_id"
};

