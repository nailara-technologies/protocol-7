## [:< ##

# name  = base.bmw384.index.stats
# descr = return summary statistics of bmw384 field index

return undef
    if not defined <bmw384.index>;

my $by_name = <bmw384.index>->{'by_name'};
my $by_arc  = <bmw384.index>->{'by_arc'};

my %arc_counts;
my %arc_labels;

for my $ARG ( 0 .. 25 ) {
    my $count = scalar @{ $by_arc->{$ARG} // [] };
    $arc_counts{$ARG} = $count;
    $arc_labels{ chr( ord('A') + $ARG ) } = $count;
}

return {
    qw| total      | => scalar keys %$by_name,
    qw| by_arc     | => \%arc_counts,
    qw| arc_labels | => \%arc_labels,
};

