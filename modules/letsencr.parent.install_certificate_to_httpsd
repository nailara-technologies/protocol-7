## [:< ##

# name  = letsencr.parent.install_certificate_to_httpsd
# param = $domain
# descr = install Let's Encrypt certificate to httpsd - creates symlinks and reloads TLS
# return = { status => 'success'|'error', message => ... }

my $domain = shift;

return {
    qw| status |  => qw| error |,
    qw| message | => qq| domain parameter required |
    }
    unless defined $domain && length($domain);

<[base.log]>->( 2, "installing certificate for $domain to httpsd" );

<[letsencr.parent.activity_logger]>->(
    qw| install |, $domain, qw| pending |, qq| installing to httpsd |
);

## Get certificate paths from registry
my $cert_entry = <letsencr.parent.certs> {$domain};

unless ( defined $cert_entry ) {
    <[base.log]>->( 1, "certificate not found in registry: $domain" );
    <[letsencr.parent.activity_logger]>->(
        qw| install |, $domain, qw| failed |, qq| certificate not found |
    );
    return {
        qw| status |  => qw| error |,
        qw| message | => qq| certificate not found in registry |
    };
}

## Source paths from letsencr cache
my $cache_dir   = <letsencr.cache.dir>;
my $source_cert = sprintf '%s/%s.pem', $cache_dir, $domain;
my $source_key  = sprintf '%s/%s.key', $cache_dir, $domain;

## Verify source files exist
unless ( -f $source_cert ) {
    <[base.log]>->( 1, "certificate file not found: $source_cert" );
    <[letsencr.parent.activity_logger]>->(
        qw| install |, $domain, qw| failed |, qq| cert file missing |
    );
    return {
        qw| status |  => qw| error |,
        qw| message | => qq| certificate file not found: $source_cert |
    };
}

unless ( -f $source_key ) {
    <[base.log]>->( 1, "key file not found: $source_key" );
    <[letsencr.parent.activity_logger]>->(
        qw| install |, $domain, qw| failed |, qq| key file missing |
    );
    return {
        qw| status |  => qw| error |,
        qw| message | => qq| key file not found: $source_key |
    };
}

## Target paths for httpsd
my $httpsd_cert_dir = <httpsd.cfg.certificate_dir> // '/etc/protocol-7/certs';
my $target_cert     = sprintf '%s/%s.pem',      $httpsd_cert_dir, $domain;
my $target_key      = sprintf '%s/%s.key',      $httpsd_cert_dir, $domain;
my $current_cert    = sprintf '%s/current.pem', $httpsd_cert_dir;
my $current_key     = sprintf '%s/current.key', $httpsd_cert_dir;

<[base.log]>->( 2, "target directory: $httpsd_cert_dir" );

## Create httpsd certificate directory if needed
unless ( -d $httpsd_cert_dir ) {
    <[base.log]>->( 2, "creating httpsd certificate directory" );

    unless ( mkdir( $httpsd_cert_dir, 0755 ) ) {
        <[base.log]>->( 1, "failed to create directory: $!" );
        <[letsencr.parent.activity_logger]>->(
            qw| install |, $domain, qw| failed |, qq| mkdir failed |
        );
        return {
            qw| status |  => qw| error |,
            qw| message | => qq| failed to create cert directory: $! |
        };
    }
}

## Copy certificate file
<[base.log]>->( 2, "copying certificate: $source_cert -> $target_cert" );

my $cert_content;
{
    my $fh;
    local $} = undef;
    unless ( open( $fh, '<', $source_cert ) ) {
        <[base.log]>->( 1, "failed to open source cert: $!" );
        return {
            qw| status |  => qw| error |,
            qw| message | => qq| failed to read certificate: $! |
        };
    }
    $cert_content = <$fh>;
    close($fh);
}

{
    my $fh;
    unless ( open( $fh, '>', $target_cert ) ) {
        <[base.log]>->( 1, "failed to write target cert: $!" );
        return {
            qw| status |  => qw| error |,
            qw| message | => qq| failed to write certificate: $! |
        };
    }
    print $fh $cert_content;
    close($fh);
    chmod( 0644, $target_cert );
}

## Copy key file (more secure handling)
<[base.log]>->( 2, "copying private key: $source_key -> $target_key" );

my $key_content;
{
    my $fh;
    local $/ = undef;
    unless ( open( $fh, '<', $source_key ) ) {
        <[base.log]>->( 1, "failed to open source key: $!" );
        return {
            qw| status |  => qw| error |,
            qw| message | => qq| failed to read private key: $! |
        };
    }
    $key_content = <$fh>;
    close($fh);
}

my $fh;
unless ( open( $fh, '>', $target_key ) ) {
    <[base.log]>->( 1, "failed to write target key: $!" );
    return {
        qw| status |  => qw| error |,
        qw| message | => qq| failed to write private key: $! |
    };
}
print $fh $key_content;
close($fh);
chmod( 0600, $target_key );    ## Private key: owner read/write only

<[base.log]>->( 2, "certificate and key installed successfully" );

## Update or create symlinks to current certificate
<[base.log]>->( 2, "updating symlinks: current.pem -> $domain.pem" );

## Remove old symlinks if they exist
unlink($current_cert) if -l $current_cert;
unlink($current_key)  if -l $current_key;

## Create new symlinks
unless ( symlink( "$domain.pem", $current_cert ) ) {
    <[base.log]>->( 1, "failed to create cert symlink: $!" );
    return {
        qw| status |  => qw| error |,
        qw| message | => qq| failed to create cert symlink: $! |
    };
}

unless ( symlink( "$domain.key", $current_key ) ) {
    <[base.log]>->( 1, "failed to create key symlink: $!" );
    return {
        qw| status |  => qw| error |,
        qw| message | => qq| failed to create key symlink: $! |
    };
}

<[base.log]>->( 2, "symlinks updated successfully" );

## Reload httpsd certificates
<[base.log]>->( 2, "reloading httpsd certificates" );

my $reload_result = <[httpsd.reload_certificates]>->();

if ($reload_result) {
    <[base.log]>->( 2, "httpsd certificate reload successful" );
    <[letsencr.parent.activity_logger]>->(
        qw| install |, $domain, qw| success |, qq| installed to httpsd |
    );

    return {
        qw| status |  => qw| success |,
        qw| message | => qq| certificate installed and httpsd reloaded |,
        qw| cert |    => $target_cert,
        qw| key |     => $target_key,
    };
} else {
    <[base.log]>->( 1, "httpsd certificate reload failed" );
    <[letsencr.parent.activity_logger]>->(
        qw| install |, $domain, qw| partial |,
        qq| installed but reload failed |
    );

    return {
        qw| status |  => qw| partial |,
        qw| message | => qq| certificate installed but httpsd reload failed |,
        qw| cert |    => $target_cert,
        qw| key |     => $target_key,
    };
}

0;

