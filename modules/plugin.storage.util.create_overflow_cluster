# name  = plugin.storage.util.create_overflow_cluster
# descr = Create overflow cluster when main cluster is full

my ( $parent_id, $members ) = @ARG;

return <[plugin.storage.checksum.cluster.create]>->(
    {   'checksum' => $parent_id . '-overflow-' . time(),
        'type'     => 'overflow',
        'members'  => $members,
        'metadata' => {
            'parent'      => $parent_id,
            'is_overflow' => 1,
        },
    }
);

