## [:< ##
# name  = plugin.storage.checksum.init_code
# descr = Initialize checksum-based storage mapping plugin

## Initialize checksum mapping registry ##
$data{'storage'}{'mapping'}{'checksum'} = {
    'enabled'    => 1,
    'algorithms' => {},    # algorithm -> { priority, impl }
    'cache'      => {},    # path -> { checksum, mtime, size }
    'reverse'    => {},    # checksum -> [ paths ]
    'stats'      => {
        'hashed'     => 0,
        'cached'     => 0,
        'collisions' => 0,
    },
};

## Available BMW checksum algorithms ##
$data{'storage'}{'mapping'}{'checksum'}{'algorithms'} = {

    # Standard file checksums
    'bmw'     => { 'priority' => 1, 'module' => 'base.chk-sum.bmw.filesum' },
    'bmw-224' => { 'priority' => 2, 'module' => 'base.chk-sum.bmw.224.B32' },
    'bmw-512' => { 'priority' => 3, 'module' => 'base.chk-sum.bmw.512_32' },

    # L13 for @INDEXCUBE integration
    'bmw-L13' => { 'priority' => 4, 'module' => 'base.chk-sum.bmw.L13-str' },
    'bmw-L13-b32' =>
        { 'priority' => 5, 'module' => 'base.chk-sum.bmw.str-b32.L13' },

    # AMOS checksums
    'amos' => { 'priority' => 6, 'module' => 'base.chk-sum.amos' },
};

<[base.logs]>->(
    1, "storage mapping plugin initialized: checksum (BMW/AMOS/L13)"
);

0;

