## [:< ##

# name  = editor.control.get_value
# descr = fetch a field's current text value

my ( $editor_state, $field ) = @ARG;

return undef if ref $editor_state ne qw| HASH |;
my $buffer = $editor_state->{'fields'}{$field} // return undef;

return <[editor.buffer.memory.get_text]>->($buffer);

