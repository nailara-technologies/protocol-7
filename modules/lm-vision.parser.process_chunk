# name  = lm-vision.parser.process_chunk
# descr = Buffer llama-cli output for processing by check_completion handler

# $ARG[0] is scalar ref to chunk from raw output

my $chunk = $ARG[0]->$*;
return unless defined $chunk && length $chunk;

# Initialize stateful parser
<coding.vision-parser.parser_state> //= { buffer => '' };

my $state = <coding.vision-parser.parser_state>;

# Remove only ANSI codes and vision control tokens, preserve everything else
# The check_completion handler will do the real cleanup
$chunk =~ s/\x1b\[[0-9;]*[mGKH]//g;    # Remove ANSI codes
$chunk
    =~ s/<\|(?:vision_start|vision_end|image_pad|im_start|im_end|endoftext)\|>//g;

# Just accumulate the chunk
if ( length($chunk) > 0 ) {
    $state->{buffer} .= $chunk;
}

# Output when buffer is substantial
if ( length( $state->{buffer} ) > 100 ) {
    my $final = $state->{buffer};

 # Only collapse multiple spaces - let check_completion handle everything else
    $final =~ s/\s+/ /g;

    $ARG[0]->$* = $final;
    $state->{buffer} = '';
} else {
    $ARG[0]->$* = '';
}

return;

