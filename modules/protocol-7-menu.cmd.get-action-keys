# name  = protocol-7-menu.cmd.get-action-keys
# descr = list of gfx action key and modifiers codes

my $action_key_href = <protocol-7-menu.action-keys.graphical> //= {};

return { 'mode' => qw| false |, 'data' => 'no keys configured' }
    if not scalar keys %$action_key_href;

my @key_list;

##  Build list of configured keys: MOD_code:KEY_code  ##
foreach my $MOD_code ( sort { $a <=> $b } keys %$action_key_href ) {
    my $mod_keys = $action_key_href->{$MOD_code};
    foreach my $key_code ( sort { $a <=> $b } keys %$mod_keys ) {
        push @key_list, "${MOD_code}:${key_code}";
    }
}

return { 'mode' => qw| false |, 'data' => 'no keys configured' }
    if not scalar @key_list;

return { 'mode' => qw| true |, 'data' => join( ' ', @key_list ) }

