# name = models.registry.empty
# descr = Create an empty registry data structure

sub create_empty_registry {
  return {
    version => '1.0',
    created_at => time(),
    updated_at => time(),
    models => {},
  };
}

# Return registry interface
{
  'create_empty_registry' => \&create_empty_registry,
};

