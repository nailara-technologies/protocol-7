## [:< ##

# name  = clients.https.handler.timeout
# descr = fired when https request exceeds timeout — cleans up and signals error

my $state = shift->w->data;

return if not defined $state->{'sock'};    ## already completed ##

<[base.logs]>->( 0, 'clients.https.handler.timeout: request timed out' );
<[clients.https.cleanup]>->($state);

$code{ $state->{'on_done'} }->(
    {   'ok'     => FALSE,
        'error'  => 'timeout',
        'params' => $state->{'params'},
    }
);

