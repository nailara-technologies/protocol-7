## [:< ##

# name  = build.init_code
# descr = build zenka initialization : network command registry

##  recipe.run -> build.cmd.recipe.run [ p7c build.recipe.run <name>        ##
##  [force] ]                                                               ##
##                                                                          ##
##  runtime dirs [ data/build/{logs,checksums,env} ] are created lazily by  ##
##  build.cmd.recipe.run itself : init runs as root before drop_privs,      ##
##  creating them here would leave root-owned dirs the zenka user cannot    ##
##  write to ..,                                                            ##
##                                                                          ##
##  no manual cmd registration needed here : the '.cmd.' filename segment   ##
##  makes the loader auto-register 'recipe.run' at compile time ..,         ##

return 0;

