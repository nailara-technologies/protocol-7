## [:< ##

# name = models.registry.save
# descr = Save registry to disk with file locking

use JSON::PP;
use Fcntl qw| :flock |;

# Initialize registry path in $data{} for persistence
$data{registry_path} ||= '/var/protocol-7/models/registry.json';

sub save_registry {
  my ($registry) = @_;

  return 0 unless $registry && ref($registry) eq 'HASH';

  my $path = $data{registry_path};
  open my $fh, '>', $path or return 0;
  flock($fh, 2);  # LOCK_EX
  $registry->{updated_at} = time();
  print $fh encode_json($registry);
  flock($fh, 8);  # LOCK_UN
  close $fh;

  return 1;
}

# Return registry interface
{
  'save_registry' => \&save_registry,
};

