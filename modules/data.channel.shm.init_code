## [:< ##

# name = data.channel.shm.init_code
# desc = Initialize SHM-backed channel transport for data zenka

<[base.log]>->( 2, ': initializing SHM channel transport..,' );

# Register SHM as a channel transport type
$data{'channel'}{'transport'}{'shm'} = {
    'create' => 'data.channel.shm.create',
    'read'   => 'data.channel.shm.read',
    'write'  => 'data.channel.shm.write',
    'close'  => 'data.channel.shm.close',
    'poll'   => 'data.channel.shm.poll',
};

# SHM channel registry - tracks active SHM-backed channels
$data{'channel'}{'shm'}{'registry'} //= {};

return TRUE;    ## [success] ##

