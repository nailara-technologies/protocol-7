## [:< ##

# name  = coding.tools.handler.list_modules
# descr = dispatch list_modules tool call to context.modules.list handler

my $args = shift // {};

return unless exists $code{'context.modules.list'};
return $code{'context.modules.list'}->(
    {   'namespace' => $args->{'namespace'} // '',
        'budget'    => $args->{'budget'}    // 800,
    }
);

