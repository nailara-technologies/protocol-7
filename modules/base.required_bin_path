# name = base.required_bin_path

my $bin_name = shift // '';
warn "expected bin_name parameter" if !length($bin_name);

<[base.register_bin_deps]>->($bin_name);

( my $bin_path ) = <[file.which]>->($bin_name);

<[base.logs]>->( 0, "binary not found [ '%s' ]", $bin_name )
    if not defined $bin_path;

<[base.log]>->( 0, ": ENV{ PATH } is not defined" )
    if not defined $ENV{'PATH'};

return $bin_path;

