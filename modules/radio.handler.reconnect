## [:< ##

# name  = radio.handler.reconnect
# descr = schedule radio reconnect with exponential backoff

##  guard: already scheduled  ##
return if defined <radio.stream.reconnect_watcher>;

my $delay = <radio.stream.reconnect_delay> // 5;

<[base.logs]>->( 1, '[radio] reconnecting in %ds', $delay );

my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
<[base.buffer.add_line]>->(
    qw| radio-stream |,
    join( ' ', $time_stamp, 1, "reconnect scheduled :. ${delay}s" ), 1
);

<radio.stream.reconnect_watcher> = <[event.add_timer]>->(
    {   after   => $delay,
        handler => qw| radio.connect |,
    }
);

##  exponential backoff, capped at 77s  ##
<radio.stream.reconnect_delay> = $delay < 77 ? $delay * 2 : 77;

