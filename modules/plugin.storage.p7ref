## [:< ##
# name  = plugin.storage.p7ref
# descr = P7REF unified storage reference - main dispatch

my ($args) = @ARG;
$args //= {};

my $operation = $args->{operation} // 'resolve';

if ( $operation eq 'resolve' ) {
    return <[plugin.storage.p7ref.resolve]>->($args);
} elsif ( $operation eq 'parse' ) {
    return <[plugin.storage.p7ref.parse]>->($args);
} elsif ( $operation eq 'index' ) {
    return <[plugin.storage.p7ref.index]>->($args);
} elsif ( $operation eq 'search' ) {
    return <[plugin.storage.p7ref.search]>->($args);
} elsif ( $operation eq 'nested' ) {
    return <[plugin.storage.p7ref.nested-resolve]>->($args);
} else {
    return {
        'mode' => 'false',
        'data' => "Unknown operation: $operation"
    };
}

