## [:< ##

# name  = coding.async.request
# descr = Initiate async inference request with streaming
# purpose = Phase 2: Start non-blocking inference, return immediately

my ( $task_id, $request_body, $job_id ) = @ARG;

return { success => FALSE, error => 'task_id required' }
    unless defined $task_id;
return { success => FALSE, error => 'request_body required' }
    unless defined $request_body;

## get task info ##
my $task = <coding.task.queue>->{$task_id};
return { success => FALSE, error => "task not found: $task_id" }
    unless defined $task;

## determine backend ##
my $backend = $task->{'analysis'}->{'routed_to'} // qw| gpu |;
my $port
    = $backend eq qw| cpu |
    ? ( <inference.backend.cpu.port> // 8001 )
    : ( <inference.backend.gpu.port> // 8000 );

my $url = "http://127.0.0.1:${port}/v1/chat/completions";

## store async state ##
<[coding.async.state_manager]>->(
    qw| set |,
    $task_id,
    {   job_id        => $job_id,
        task_id       => $task_id,
        backend       => $backend,
        port          => $port,
        start_time    => <[base.time]>->(3),
        mode          => qw| streaming |,
        chunk_context => {},
    }
);

## initialize state machine for tool execution loop ##
<[coding.async.state_machine]>->(
    qw| init |,
    $task_id,
    {   messages => $request_body->{'messages'} // [],
        tools    => $request_body->{'tools'}    // [],
        backend  => $backend,
        port     => $port,
    }
);

## setup callbacks — extracted to coding.callback.* modules ##
my $callbacks = {
    on_header => sub { <[coding.callback.http_header]>->( $task_id, @ARG ) },
    on_chunk  => sub { <[coding.callback.http_chunk]>->( $task_id, @ARG ) },
    on_complete =>
        sub { <[coding.callback.http_complete]>->( $task_id, @ARG ) },
    on_error   => sub { <[coding.callback.http_error]>->( $task_id, @ARG ) },
    check_stop => sub { <[coding.callback.http_check_stop]>->($task_id) },
    timeout    => 300,    # 5 minutes max
};

<[base.logs]>
    ->( 1, "async.request: connecting to %s for %s", $url, $task_id );

## start HTTP request (returns immediately) ##
my $http_result
    = <[coding.async.http_client]>->( $url, $request_body, $callbacks );

if ( !$http_result->{'success'} ) {
    ## immediate error ##
    <[base.logs]>->(
        0,        "async.request : immediate error for %s : %s",
        $task_id, $http_result->{'error'}
    );
    <[coding.async.complete]>->(
        $task_id, { success => FALSE, error => $http_result->{'error'} }
    );
    return { success => FALSE, error => $http_result->{'error'} };
}

<[base.logs]>->(
    1, "async.request: http_client returned success for %s", $task_id
);

return {
    success => TRUE,
    task_id => $task_id,
    mode    => qw| streaming |,
};

