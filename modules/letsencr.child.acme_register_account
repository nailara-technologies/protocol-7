## [:< ##

# name  = letsencr.child.acme_register_account
# descr = register new ACME account with Let's Encrypt

<[base.log]>->( 2, 'registering new ACME account' );

## Ensure we have directory and nonce
my $directory = <letsencr.child.acme_client>->{directory};
my $nonce     = <letsencr.child.acme_client>->{nonce};

unless ( $directory && $nonce ) {
    <[base.log]>->( 1, 'error: ACME directory or nonce not available' );
    return { 'error' => 'ACME directory or nonce not available' };
}

my $newAccount_url = $directory->{newAccount};
my $email          = <letsencr.admin.email>;

## Create account creation payload
my $payload = {
    termsOfServiceAgreed => JSON::XS::true(),
    contact              => ["mailto:$email"],
};

## Retry loop for handling badNonce errors
my $max_retries = 3;
my $attempt     = 0;
my $response;

while ( $attempt < $max_retries ) {
    $attempt++;
    $nonce = <letsencr.child.acme_client>->{nonce};

    <[base.logs]>->(
        3,        "account registration attempt %d/%d",
        $attempt, $max_retries
    );

    ## Make ACME request (no KID yet - this is new account creation)
    $response = <[letsencr.child.acme_http_request]>->(
        'POST',
        $newAccount_url,
        $payload,
        $nonce,
        undef    # no KID for account creation
    );

    unless ($response) {
        <[base.log]>->( 1, 'error: account registration request failed' );
        return { 'error' => 'account registration request failed' };
    }

    ## Check for badNonce error - refresh nonce and retry
    <[base.logs]>->(
        1,                   "ACME response received: status=%d, type=%s",
        $response->{status}, $response->{data}{type} // 'NONE'
    );

    if (   $response->{status} == 400
        && $response->{data}{type}
        && $response->{data}{type} =~ m{badNonce} ) {
        <[base.log]>->(
            1, "badNonce error detected, fetching fresh nonce for retry"
        );

        ## Fetch fresh nonce from server
        my $fresh_nonce = <[letsencr.child.get_fresh_nonce]>;
        if ($fresh_nonce) {
            <[base.logs]>->(
                2,
                "fresh nonce obtained, retrying (attempt %d/%d)",
                $attempt + 1, $max_retries
            );
            next if $attempt < $max_retries;
        } else {
            <[base.log]>->( 1, "error : failed to fetch fresh nonce" );
            return { 'error' => 'failed to fetch fresh nonce for retry' };
        }
    }

    ## Exit loop if we got a successful response (not badNonce)
    last
        if $response->{status} != 400
        || !$response->{data}{type}
        || $response->{data}{type} !~ m{badNonce};
}

## Check for success
unless ( $response->{status} == 200 || $response->{status} == 201 ) {
    <[base.log]>->(
        1, "error: ACME server returned status $response->{status}"
    );
    my $error_detail = $response->{data}{detail}
        // "ACME server error status $response->{status}";
    if ( $response->{data}{detail} ) {
        <[base.log]>->( 1, "  details : $response->{data}{detail}" );
    }
    return { 'error' => $error_detail };
}

## Extract account ID from Location header
my $account_url
    = $response->{headers}{location} || $response->{headers}{Location};

unless ($account_url) {
    <[base.log]>->(
        1, 'error: no Location header in account creation response'
    );
    return { 'error' => 'no Location header in account creation response' };
}

<[base.log]>->( 2, "ACME account registered : $account_url" );

## Store account info in child state
<letsencr.child.acme_client>->{account_url} = $account_url;
<letsencr.child.acme_client>->{account_id}
    = $account_url;    # Use full URL as ID
<letsencr.child.acme_client>->{nonce} = $response->{nonce};  # Get fresh nonce

## Save account info to cache
my $account_cache = sprintf '%s/account.json', <letsencr.cache.dir>;
my $account_info  = {
    account_url => $account_url,
    created_at  => time(),
    email       => $email,
};
<[file.put]>->(
    $account_cache, JSON::XS::encode_json($account_info),
    qw| :raw |
);

<[base.log]>->( 2, "account information saved to cache" );

return {
    account_url => $account_url,
    account_id  => $account_url,
    email       => $email,
    created_at  => time(),
};

