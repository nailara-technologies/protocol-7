## [:< ##

# name  = transport.promote
# descr = restore a demoted transport after probe success
# args  = $dest, $type

my ( $dest, $type ) = @ARG;

return if not defined $dest or not defined $type;

delete <transport.registry>->{'demoted'}{$dest}{$type};
delete <transport.registry>->{'demoted'}{$dest}
    if not keys %{ <transport.registry>->{'demoted'}{$dest} // {} };

<[base.logs]>->( 1, 'transport.promote: %s promoted for %s', $type, $dest );

## reset consecutive failures ##
my $q = <transport.registry>->{'quality'}{$type}{$dest} //= {};
$q->{'consecutive_failures'} = 0;

return 1;

