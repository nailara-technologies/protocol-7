## [:< ##

# name  = proxy.listen
# descr = create listening socket, register accept handler

my $addr = <proxy.cfg.listen_address> // '127.0.0.1';
my $port = <proxy.cfg.listen_port>    // 8118;

my $sock = IO::Socket::IP->new(
    LocalAddr => $addr,
    LocalPort => $port,
    Type      => SOCK_STREAM(),
    ReuseAddr => 1,
    ReusePort => 1,
    Listen    => 128,
    )
    or do {
    <[base.logs]>->(
        0, 'proxy.listen: cannot bind %s:%d: %s',
        $addr, $port, $OS_ERROR
    );
    return;
    };

## prevent listen socket from being inherited by forked children ##
{
    use Fcntl qw| F_GETFD F_SETFD FD_CLOEXEC |;
    my $flags = fcntl( $sock, F_GETFD, 0 ) // 0;
    fcntl( $sock, F_SETFD, $flags | FD_CLOEXEC );
}

<proxy.listen_sock> = $sock;

<[event.add_io]>->(
    {   fd      => $sock,
        poll    => 'r',
        handler => 'proxy.handler.accept',
        data    => $sock,
        desc    => 'proxy accept handler'
    }
);

<[base.logs]>->( 1, 'proxy listening on %s:%d', $addr, $port );

return $sock;

