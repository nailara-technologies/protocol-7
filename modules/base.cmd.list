## [:< ##

# name  = base.cmd.list
# param = [list_name] [pattern]
# descr = display named lists with content, optional regex pattern filter
#
# USAGE:
#   list                       -> show all available lists (overview)
#   list <name>                -> show all entries in list
#   list <name> <pattern>      -> filter entries by regex pattern
#
# FILTERING:
#   The pattern is a Perl regex matched against:
#   - Entry keys (IDs)
#   - Any visible field values
#
#   Examples:
#   list sessions taek         -> sessions with 'taek' in ID or username
#   list models cod            -> models with 'cod' in name or ID
#   list users 127             -> users with '127' in any field
#
# RELATED: base.parser.list, base.parser.list_filtered

my $list_name = $call->{'args'};

## Parse optional pattern from args
my $pattern;
if ( defined $list_name && $list_name =~ s|\s+(.+)$|| ) {
    $pattern = $1;
}

## Validate regex pattern if provided
my $regex_filter;
if ( defined $pattern && length($pattern) ) {
    my ( $regex_compiled, $regex_err ) = <[base.eval.comp_regex]>->($pattern);

    if ( not defined $regex_compiled ) {
        return {
            'mode' => qw| false |,
            'data' => sprintf( 'invalid regex pattern: %s', $regex_err )
        };
    }
    $regex_filter = $regex_compiled;
}

if ( not defined $list_name or $list_name eq '' ) {    ## list overview
    return {
        qw| mode | => qw| size |,
        qw| data | => <[base.parser.list]>->(
            {   qw| var |   => qw| data |,
                qw| key |   => qw| list |,
                qw| mask |  => [qw| <key>:list_name descr:description |],
                qw| align | => { qw| list_name | => qw| right+5 | },
            }
        )
    };
}

my $list_nam_chars = qw| \w\d\- |;    ## valid characters

if ( $list_name =~ m|^[$list_nam_chars]+$|
    and defined $data{'list'}->{$list_name} ) {

    my $list = $data{'list'}->{$list_name};

    $list->{'mask'} //= sprintf qw| <key>:%s |, $list->{'key'};

    ## Use filtered parser if pattern specified
    if ( defined $regex_filter ) {
        return {
            qw| mode | => qw| size |,
            qw| data | => <[base.parser.list_filtered]>->(
                {   qw| var |      => $list->{'var'},
                    qw| key |      => $list->{'key'},
                    qw| sub_key |  => $list->{'sub_key'},
                    qw| sort_key | => $list->{'sort_key'},
                    qw| defaults | => $list->{'defaults'},
                    qw| filters |  => $list->{'filters'},
                    qw| align |    => $list->{'align'},
                    qw| mask |     => [ split( m| +|, $list->{'mask'} ) ],
                    qw| filter |   => $regex_filter,
                }
            )
        };
    }

    return {
        qw| mode | => qw| size |,
        qw| data | => <[base.parser.list]>->(
            {   qw| var |      => $list->{'var'},
                qw| key |      => $list->{'key'},
                qw| sub_key |  => $list->{'sub_key'},
                qw| sort_key | => $list->{'sort_key'},
                qw| defaults | => $list->{'defaults'},
                qw| filters |  => $list->{'filters'},
                qw| align |    => $list->{'align'},
                qw| mask |     => [ split( m| +|, $list->{'mask'} ) ]
            }
        )
    };
} elsif ( $list_name =~ m|([^$list_nam_chars])| ) {
    my $quote_str = $LAST_PAREN_MATCH eq ' ' ? "'" : ' ';
    $reply->{'data'} = sprintf 'not valid character in list name [%s%s%s]',
        $quote_str, $LAST_PAREN_MATCH, $quote_str;
} else {
    $reply->{'data'} = "no such list [ see 'list' command ]";
}

