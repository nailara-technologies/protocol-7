# name = coding.intake.validate_task
# descr = validates task has required fields
# purpose = Ensure task structure is valid before processing

my ($task) = @ARG;

my @errors = ();

push @errors, "Missing task.request.description"
    unless $task->{request}->{description};
push @errors, "Missing task.type" unless $task->{type};

return {
    valid  => scalar(@errors) == 0,
    errors => \@errors
};

