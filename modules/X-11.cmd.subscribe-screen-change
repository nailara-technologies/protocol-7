# name  = X-11.cmd.subscribe-screen-change
# descr = register a handler for screen-change notifications.
#         args: handler name (e.g. tile.handler.screen-change)

my $params  = shift                     // {};
my $handler = $params->{'args'}{'data'} // '';

return { 'mode' => qw| false |, 'data' => 'expected handler name' }
    unless length $handler;

<X-11.screen_change_subscribers> //= [];

my $subs = <X-11.screen_change_subscribers>;
return { 'mode' => qw| true |, 'data' => 'already subscribed' }
    if grep { $ARG eq $handler } @$subs;

push @$subs, $handler;
<[base.logs]>->( 1, ': screen-change subscriber added [ %s ]', $handler );

return { 'mode' => qw| true |, 'data' => 'subscribed' };

