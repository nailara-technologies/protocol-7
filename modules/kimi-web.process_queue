## [:< ##

# name  = kimi-web.process_queue
# descr = start next queued task when no active stream

## busy check: any active task in registry? ##
return if scalar keys %{ <kimi-web.task.registry> // {} } > 0;

## empty queue check ##
return unless @{ <kimi-web.task.queue> // [] };

my $next = shift <kimi-web.task.queue>->@*;

<[base.logs]>->( 2, ': starting queued task %s', $next->{'id'} );

## dispatch via stream — deferred reply, events via STRM ##
<[kimi-web.cmd.dispatch_stream]>->(
    {   'args'       => $next->{'args'},
        'session_id' => $next->{'sid'},
        'cmd_id'     => $next->{'cmd_id'},
    }
);

