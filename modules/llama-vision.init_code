## [:< ##

# name  = llama-vision.init_code
# descr = GPU-accelerated vision analysis with job dispatch architecture

<[base.log]>->( 1, 'llama-vision zenka starting.,' );

# Imager module will be loaded in analyze_image command when needed

# Vision model binary and library configuration
<llama-vision.binary>   = qw{/data/source/ik_llama.cpp/llama-mtmd-cli-cuda};
<llama-vision.lib_path> = qw| /data/source/ik_llama.cpp |;
<llama-vision.log_file> = qw| /var/log/protocol-7/llama-vision.log |;
<llama-vision.log_dir>  = qw| /var/log/protocol-7 |;
<llama-vision.log_mask> = 0750;

# Ensure log directory exists with proper permissions (only if running as root)
if ( $EUID == 0 ) {
    <[base.perlmod.load]>->( 'File::Path', qw| make_path | );
    <[file.make_path]>->(
        <llama-vision.log_dir>, <llama-vision.log_mask>,
        <system.amos-zenka-user>
        )
        and <[base.logs]>->(
        1, "created log directory [%s/]",
        <llama-vision.log_dir>
        ) if !-d <llama-vision.log_dir>;
}

# Load vision model configuration from centralized models.yaml
<[base.logs]>->( 1, "loading vision model config from models.yaml" );

<[base.perlmod.autoload]>->(qw| YAML::Tiny |);

my $config_file = catfile( <system.conf_path>, qw|zenki/models/models.yaml| );

my $model_path  = undef;
my $mmproj_path = undef;

if ( -f $config_file ) {
    my $yaml_content_sref = <[file.slurp]>->($config_file);

    if ( ref $yaml_content_sref eq qw| SCALAR | ) {
        my $yaml = YAML::Tiny::Load( $yaml_content_sref->$* );

        if (   $yaml
            && exists $yaml->{'models'}
            && exists $yaml->{'models'}->{'qwen3-vl-4b-instruct'} ) {
            my $model_def = $yaml->{'models'}->{'qwen3-vl-4b-instruct'};
            $model_path  = $model_def->{'path'};
            $mmproj_path = $model_def->{'mmproj'};
        } else {
            <[base.log]>->(
                0, " Error: qwen3-vl-4b-instruct not found in models.yaml"
            );
        }
    }
} else {
    <[base.log]>->( 0, " Error: models.yaml not found at $config_file" );
}

if ( $model_path && $mmproj_path ) {

    # Trust YAML-defined model paths from models registry
    <llama-vision.vision_model_path>  = $model_path;
    <llama-vision.vision_mmproj_path> = $mmproj_path;

    <[base.logs]>->(
        1,
        "vision model configured : %s",
        <[base.parser.ellipse_center]>->( $model_path, 28 )
    );
} else {
    <llama-vision.vision_model_path>  = undef;
    <llama-vision.vision_mmproj_path> = undef;

    <[base.log]>->(
        0,
        "[error] vision model configuration"
            . " incomplete [check:models.yaml]"
    );
}

<[base.logs]>->(
    1,
    "vision binary : %s",
    <[base.parser.ellipse_center]>->( <llama-vision.binary>, 28 )
);
<[base.logs]>->( 1, "will fetch config on-demand from models zenka" );

# Initialize job queue for vision analysis tasks
<llama-vision.jobs> //= {};

# Initialize timers hash for process watchers
<llama-vision.timers> //= {};

# Initialize batch queue for request batching [amortizes model loading]
<llama-vision.batch_queue> //= [];
<llama-vision.batch_timer> = undef;
<llama-vision.batch_window_ms>
    = 100;    # Collect requests for 100ms before processing

<[base.logs]>->( 1, "vision job dispatch system initialized.," );
<[base.logs]>->(
    1,
    "batch processing enabled [window: %dms]",
    <llama-vision.batch_window_ms>
);

# Image scaling configuration [vision models typically expect 224-1024 range]
<llama-vision.max_image_width>  = 1024;    # Scale down if wider
<llama-vision.max_image_height> = 1024;    # Scale down if taller

# Temp files are managed by base.file.temp with automatic cleanup via end_code callbacks

0;    # Return success for module initialization

