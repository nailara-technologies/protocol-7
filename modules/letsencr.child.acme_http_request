## [:< ##

# name  = letsencr.child.acme_http_request
# descr = make authenticated ACME request to Let's Encrypt server

my $method  = shift;    # GET, POST
my $url     = shift;
my $payload = shift;    # hashref or string (for POST)
my $nonce   = shift;
my $kid     = shift;    # Key ID for authenticated requests

<[base.logs]>->( 3, "ACME HTTP %s to %s...", $method, substr( $url, 0, 50 ) );

## Create HTTP client [ use standard LWP::UserAgent to
##                         allow localhost for testing.. ]

my $ua = LWP::UserAgent->new( timeout => 10, );

## Disable SSL verification for localhost/test servers
if ( $url =~ m{^https?://localhost} ) {
    $ua->ssl_opts( verify_hostname => 0, SSL_verify_mode => 0 );
}

my $request;

if ( $method eq qw| POST | ) {
    ## Create JWS wrapper for authenticated request
    my $jws = <[letsencr.child.create_jws]>->( $payload, $nonce, $kid, $url );

    unless ($jws) {
        <[base.log]>->( 1, 'error: failed to create JWS' );
        return undef;
    }

    ## Create request with JWS body
    my $jws_json = JSON::XS::encode_json($jws);

    $request = HTTP::Request->new( qw| POST | => $url );
    $request->header( 'Content-Type' => 'application/jose+json' );
    $request->content($jws_json);

} elsif ( $method eq qw| GET | ) {
    $request = HTTP::Request->new( qw| GET | => $url );
    $request->header( 'Accept' => 'application/json' );
} else {
    <[base.logs]>->( 1, "error: unsupported method: %s", $method );
    return undef;
}

## Execute request
my $response = $ua->request($request);

unless ( $response->is_success ) {
    <[base.logs]>->( 1, "ACME request failed: %s", $response->status_line );

    ## Capture and log full error response for debugging
    my $error_body = $response->decoded_content();
    <[base.logs]>->(
        1,
        "ACME error response body: %s",
        substr( $error_body, 0, 500 )
    );

    ## try to parse error details from JSON response
    my $error_data;
    eval { $error_data = JSON::XS::decode_json($error_body); };
    if ( !$EVAL_ERROR && $error_data ) {
        if ( $error_data->{detail} ) {
            <[base.log]>->(
                1, "ACME error detail: %s",
                $error_data->{detail}
            );
        }
        if ( $error_data->{type} ) {
            <[base.log]>->( 1, "ACME error type: %s", $error_data->{type} );
        }
    }

    return undef;
}

## Extract response headers (especially Replay-Nonce)
my $replay_nonce = $response->header('Replay-Nonce');

## Parse JSON response
my $body = $response->decoded_content();
my $data;

eval { $data = JSON::XS::decode_json($body); };
if ( length $EVAL_ERROR ) {
    <[base.logs]>->(
        1, "error parsing ACME response: %s",
        <[base.str.eval_error]>
    );
    return undef;
}

## Return response with fresh nonce
return {
    status  => $response->code,
    data    => $data,
    nonce   => $replay_nonce,
    headers => $response->headers,
};

