## [:< ##

# name  = cred-mesh.encrypt
# descr = encrypt a credential blob for a given slot using the key-holder child

my $slot = shift // '';
my $data = shift // '';

return undef unless length $slot and length $data;

return <[cred-mesh.key_holder.parent]>->( qw| ENCRYPT |, $slot, $data );

