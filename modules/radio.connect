## [:< ##

# name = radio.connect
# descr = open TCP connection to ICY stream host and send HTTP GET request

my $url = <radio.stream.url>;

if ( not defined $url or not length $url ) {
    <[base.logs]>->( 0, '[radio] no stream url configured' );
    return;
}

if ( defined <radio.stream.sock> ) {
    <[base.logs]>->( 2, '[radio] already connected' );
    return;
}

<[base.logs]>->( 2, '[radio] connecting to %s', $url );

##  parse http://host[:port]/path  ##
my ( $host, $port, $path )
    = ( $url =~ m{^https?://([^/:]+)(?::(\d+))?(/.*)?$} );
$port //= 80;
$path //= '/';

if ( not defined $host ) {
    <[base.logs]>->( 0, '[radio] invalid stream url: %s', $url );
    return;
}

<[base.logs]>->( 2, '[radio] connecting to %s:%d%s', $host, $port, $path );

my $sock = <[base.open]>->( qw| ip.tcp output |, $host, $port );

if ( not defined $sock ) {
    <[base.logs]>->( 0, '[radio] connection failed: %s:%d', $host, $port );
    return;
}

##  set non-blocking for event-loop reads  ##
$sock->blocking(0);

##  send ICY HTTP GET request  ##
my $req = join( "\r\n",
    "GET $path HTTP/1.0",
    "Host: $host",
    "Icy-Metadata: 1",
    "User-Agent: radio-relay/1.0",
    "Connection: close",
    "", "" );
syswrite( $sock, $req );

<radio.stream.sock> = $sock;

<radio.stream.io_watcher> = <[event.add_io]>->(
    {   fd      => $sock,
        poll    => qw| r |,
        handler => qw| radio.handler.stream-chunk |,
    }
);

0;

