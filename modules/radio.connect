## [:< ##

# name = radio.connect
# descr = open TCP/TLS connection to ICY stream host and send HTTP GET request

my $url = <radio.stream.url>;

if ( not defined $url or not length $url ) {
    <[base.logs]>->( 0, '[radio] no stream url configured' );
    return;
}

if ( defined <radio.stream.sock> ) {
    <[base.logs]>->( 2, '[radio] already connected' );
    return;
}

<[base.logs]>->( 2, '[radio] connecting to %s', $url );

##  parse http[s]://host[:port]/path  ##
my ( $scheme, $host, $port, $path )
    = ( $url =~ m{^(https?)://([^/:]+)(?::(\d+))?(/.*)?$} );
my $use_tls = defined $scheme && $scheme eq 'https';
$port //= $use_tls ? 443 : 80;
$path //= '/';

if ( not defined $host ) {
    <[base.logs]>->( 0, '[radio] invalid stream url: %s', $url );
    return;
}

<[base.logs]>->(
    2, '[radio] connecting to %s:%d%s [%s]',
    $host, $port, $path, $use_tls ? 'tls' : 'tcp'
);

my $sock;
if ($use_tls) {
    $sock = IO::Socket::SSL->new(
        PeerAddr        => $host,
        PeerPort        => $port,
        Proto           => 'tcp',
        Timeout         => 7,
        SSL_verify_mode => 0,
    );
    if ( not defined $sock ) {
        <[base.logs]>->(
            0, '[radio] TLS connection failed: %s:%d [ %s ]',
            $host, $port, IO::Socket::SSL::errstr()
        );
        return;
    }
} else {
    $sock = <[base.open]>->( qw| ip.tcp output |, $host, $port );
    if ( not defined $sock ) {
        <[base.logs]>
            ->( 0, '[radio] connection failed: %s:%d', $host, $port );
        return;
    }
}

##  set non-blocking for event-loop reads  ##
$sock->blocking(0);

##  send ICY HTTP GET request  ##
my $req = join( "\r\n",
    "GET $path HTTP/1.0",
    "Host: $host",
    "Icy-Metadata: 1",
    "User-Agent: radio-relay/1.0",
    "Connection: close",
    "", "" );
my $written = syswrite( $sock, $req );
<[base.logs]>->(
    2,
    '[radio] GET sent: %s bytes written [ %s ]',
    defined $written ? $written : 'undef',
    defined $written ? 'ok'     : $OS_ERROR
);

<radio.stream.sock> = $sock;

<radio.stream.io_watcher> = <[event.add_io]>->(
    {   fd      => $sock,
        poll    => qw| r |,
        handler => qw| radio.handler.stream-chunk |,
    }
);

0;

