# name  = graphics.matrix.visual.group-spheres
# desc  = Group classified images by sphere and sort by cubic coordinates
#
# input : $classified - array of classified image hashes
#         $max_spheres - maximum sphere number
# output: hash { sphere_num => [sorted images] }

my $classified  = shift // [];
my $max_spheres = shift // 6;

my $spheres = {};

# Initialize empty spheres
$spheres->{$_} = [] for 0 .. $max_spheres;

# Group images
for my $img (@$classified) {
    my $s = $img->{'sphere'};
    push @{ $spheres->{$s} }, $img;
}

# Sort within spheres by cubic coordinate for spatial locality
for my $s ( 0 .. $max_spheres ) {
    $spheres->{$s} = [
        sort {
                   $a->{'cubic_coord'}->[0] <=> $b->{'cubic_coord'}->[0]
                || $a->{'cubic_coord'}->[1] <=> $b->{'cubic_coord'}->[1]
        } @{ $spheres->{$s} // [] }
    ];
}

return $spheres;

