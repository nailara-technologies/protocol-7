## [:< ##

# name  = branch.route.timer.cleanup
# descr = sweep expired routes and release them

my $now     = <[base.time]>->(4);
my $expired = 0;

for my $route_id ( keys %{ $data{'branch.routes'} // {} } ) {
    my $route = $data{'branch.routes'}{$route_id};
    next unless defined $route;
    next if $route->{'state'} eq 'released';

    my $age = $now - $route->{'created'};
    if ( $age > $route->{'ttl'} ) {
        <[branch.route.release]>->($route_id);
        $expired++;
    }
}

<[base.logs]>->(
    2, 'branch.route.timer.cleanup: released %d expired routes', $expired
) if $expired;

