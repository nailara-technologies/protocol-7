## [:< ##

# name  = zulum.cmd.stream-status
# descr = Show stream attachment status and P7REF
# param = [stream_id]

my $params = shift // {};
my $stream_id = $params->{'stream_id'} // $params->{'args'} // 1;

return { 'mode' => qw| false |, 'data' => 'invalid stream_id' }
    unless $stream_id >= 1 && $stream_id <= 13;

my $stream = <zulum.stream>->{$stream_id};
return {
    'mode' => qw| false |,
    'data' => "stream $stream_id not initialized"
    }
    unless defined $stream;

my $attached_count = scalar( @{ $stream->{'attached'} // [] } );

## generate P7REF: TYPE:CHKSUM7:ADDR_B32 ##
## cycle_val = gen × stream_id = seed value ##
my $cycle_val = $stream->{'seed'};    ## 76923 × stream_id ##

## swap-boundary dispatch for chk-sum.amos ##
my $amos_chk = $code{'chk-sum.amos'} // $code{'base.chk-sum.amos'};
my $chksum7  = $amos_chk->($cycle_val);
my $addr_b32 = substr( $chksum7, 0, 6 );
my $p7ref    = "STREAM:$chksum7:$addr_b32";

return {
    'mode' => qw| size |,
    'data' => sprintf(
        "stream    : %d\n"
            . "p7ref     : %s\n"
            . "seed      : %d\n"
            . "iteration : %d\n"
            . "attached  : %d\n",
        $stream_id,             $p7ref, $stream->{'seed'},
        $stream->{'iteration'}, $attached_count
    )
};

