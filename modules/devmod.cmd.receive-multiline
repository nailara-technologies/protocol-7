## [:< ##

# name  = devmod.cmd.receive-multiline
# descr = Test command for receiving and echoing multiline input

## Access multiline data from $call ##
my $headers = $call->{'param'} // {};
my $body    = $call->{'data'}  // '';

<[base.log]>->(
    2,             "[receive-multiline] received %d bytes, %d headers",
    length($body), scalar( keys %$headers )
);

## Build verification output ##
my $output = "=== MULTILINE RECEIPT ===\n";

## Headers (parsed into param hash) ##
if ( keys %$headers ) {
    $output .= "Headers:\n";
    foreach my $key ( sort keys %$headers ) {
        $output .= sprintf "  %s: %s\n", $key, $headers->{$key};
    }
} else {
    $output .= "Headers: (none)\n";
}

## Body content ##
$output .= sprintf "\nBody:\n";
$output .= sprintf "  Length: %d bytes\n", length($body);
$output .= sprintf "  Lines: %d\n", scalar( split m{\n}, $body );
$output .= "\n--- BODY START ---\n";
$output .= length($body) ? $body : "(empty body)\n";
$output .= "\n--- BODY END ---\n";

return {
    'mode' => 'size',
    'data' => $output
};

