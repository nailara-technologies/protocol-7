## [:< ##

# name  = radio.cmd.keep
# descr = flag current track as to-keep (clear jingle flag)

my $icy = <radio.stream.icy>;

$icy->{'keep_flagged'} = 1;
$icy->{'is_jingle'}    = 0;

my $title = $icy->{'current_title'} // '(none)';

<[base.logs]>->( 2, '[radio] keep: flagged [ %s ]', $title );

return {
    'mode' => qw| true |,
    'data' => sprintf( 'keeping: %s', $title )
};

