## [:< ##

# name  = radio.cmd.keep
# descr = flag current track as to-keep (clear jingle flag)

my $icy = <radio.stream.icy>;

$icy->{'keep_flagged'} = 1;
$icy->{'is_jingle'}    = 0;

##  open rip file if not already ripping  ##
<[radio.ripper]>->( $icy->{'current_title'} )
    if not defined $icy->{'rip_fh'};

##  stop gap filler if running (we just un-muted)  ##
if (<radio.gap_fill.active>) {
    CORE::close( delete <radio.gap_fill.fh> )
        if defined <radio.gap_fill.fh>;
    <radio.gap_fill.watcher>->cancel
        if defined <radio.gap_fill.watcher>;
    delete <radio.gap_fill.watcher>;
    <radio.gap_fill.active> = 0;
}

my $title = $icy->{'current_title'} // '(none)';

<[base.logs]>->( 2, '[radio] keep: flagged [ %s ]', $title );

return {
    'mode' => qw| true |,
    'data' => sprintf( 'keeping: %s', $title )
};

