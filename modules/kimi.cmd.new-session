## [:< ##

# name  = kimi.cmd.new-session
# descr = clear saved session and reconnect fresh

## clear persisted session id
<[file.zenka_dir.write]>->( 'session_id', \'' );

## tear down current connection if active
if (<kimi.ws.connected>) {
    if ( defined <kimi.ws.io_watcher> ) {
        <kimi.ws.io_watcher>->cancel
            if <kimi.ws.io_watcher>->is_active;
        <kimi.ws.io_watcher> = undef;
    }
    if ( defined <kimi.ws.socket> ) {
        eval { shutdown( <kimi.ws.socket>, 2 ) };
        close <kimi.ws.socket>;
    }
    <kimi.ws.connected> = FALSE;
}

<kimi.ws.status>          = qw| disconnected |;
<kimi.session_id>         = undef;
<kimi.wire.accumulator>   = '';
<kimi.wire.pending>       = {};
<kimi.task.active_id>     = undef;
<kimi.approval.responded> = {};
<kimi.approval.pending>   = {};
<[file.zenka_dir.write]>->( 'approval_responded', \'' );

## schedule immediate reconnect [ will create fresh session ]
<[event.add_timer]>->(
    {   'after'   => 0.5,
        'handler' => qw| kimi.connect |,
        'desc'    => 'fresh session reconnect'
    }
);

return { 'mode' => 'true', 'data' => 'session cleared, reconnecting' };

