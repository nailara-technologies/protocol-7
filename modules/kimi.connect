## [:< ##

# name  = kimi.connect
# descr = create kimi-web session and establish persistent websocket
#         connection

map { <[base.perlmod.load]>->($_) }
    qw| JSON LWP::UserAgent Protocol::WebSocket::Frame |;

if (<kimi.ws.connected>) {
    <[base.logs]>->( 2, 'kimi.connect: already connected' );
    return;
}

<kimi.ws.status>        = qw| connecting |;
<kimi.connect.retrying> = FALSE;

## create new kimi-web session via rest api (once per lifetime)
if ( not defined <kimi.session_id> ) {
    my $ua       = LWP::UserAgent->new( timeout => 10 );
    my $work_dir = <kimi.web.work_dir> // '';
    my $api_url  = sprintf( '%s/api/sessions/', <kimi.web.base_url> );

    ## pass project work_dir in json post body
    my $body
        = length $work_dir
        ? JSON::encode_json( { 'work_dir' => $work_dir } )
        : '{}';

    my $resp = $ua->post(
        $api_url,
        'Content-Type' => 'application/json',
        'Content'      => $body
    );

    if ( not $resp->is_success ) {
        <[base.logs]>->(
            0, 'kimi.connect: session create failed : %s',
            $resp->status_line
        );
        <kimi.ws.status> = qw| disconnected |;
        <[kimi.connect.schedule_retry]>;
        return;
    }

    my $session = eval { JSON::decode_json( $resp->decoded_content ) };
    if ( $@ or not defined $session or not defined $session->{'session_id'} )
    {
        <[base.logs]>->(
            0,
            'kimi.connect: invalid session response : %s',
            $@ // 'no session_id'
        );
        <kimi.ws.status> = qw| disconnected |;
        <[kimi.connect.schedule_retry]>;
        return;
    }

    <kimi.session_id> = $session->{'session_id'};
    <[base.logs]>->(
        2, 'kimi.connect: session created [ %s ]',
        <kimi.session_id>
    );

    ## persist session id for resume after restart
    my $sid_str = <kimi.session_id> . "\n";
    <[file.zenka_dir.write]>->( 'session_id', \$sid_str );
}

## websocket connect
my $ws_url = sprintf( '%s/api/sessions/%s/stream',
    <kimi.web.ws_base>, <kimi.session_id> );

my $sock = <[websocket.connect]>->($ws_url);

if ( not defined $sock ) {
    <[base.logs]>->(
        0, 'kimi.connect: websocket connect failed [ %s ]', $ws_url
    );
    <kimi.ws.status>  = qw| disconnected |;
    <kimi.session_id> = undef;    ## clear so next retry creates fresh session
    <[kimi.connect.schedule_retry]>;
    return;
}

<kimi.ws.socket> = $sock;
<kimi.ws.frame>  = Protocol::WebSocket::Frame->new(
    max_payload_size => 16 * 1024
        * 1024                    ## 16 MiB [ tool results can be large ]
);
<kimi.wire.accumulator>  = '';
<kimi.connect.retry_cur> = 2;     ## reset backoff on each new connect

## register event.add_io for incoming frames
<kimi.ws.io_watcher> = <[event.add_io]>->(
    {   'fd'      => $sock,
        'handler' => qw| websocket.handler.read |,
        'data'    => {
            'frame'      => <kimi.ws.frame>,
            'on_message' => qw| kimi.handler.ws_message |,
            'context'    => { 'session_id' => <kimi.session_id> }
        },
        'poll' => qw| re |
    }
);

<kimi.ws.connected> = TRUE;

## if prompts were preserved across reconnect, restore busy status so that
## history_complete skips initialize [ TurnEnd will fire when work completes ]
my $has_preserved_prompt = FALSE;
for my $pend_id ( keys %{<kimi.wire.pending>} ) {
    if ( ( <kimi.wire.pending>->{$pend_id}{'type'} // '' ) eq qw| prompt | ) {
        $has_preserved_prompt = TRUE;
        last;
    }
}
if ($has_preserved_prompt) {
    <kimi.ws.status> = qw| busy |;
    <[base.logs]>->(
        1, ': reconnected with preserved prompt — status set to busy'
    );
}    ## else status stays 'connecting' until history_complete + initialize

## session liveness timeout — if status doesn't leave 'connecting' within
## 15s, the session is likely dead/archived. clear and retry with fresh one.
## [ must fit within v7 start timeout of ~65s with room for fresh connect ]
<[event.add_timer]>->(
    {   'after'   => 15,
        'handler' => qw| kimi.handler.session_liveness_timeout |,
        'desc'    => 'detect dead kimi-web session'
    }
);

<[base.logs]>->( 2, 'kimi.connect: websocket connected [ %s ]', $ws_url );

