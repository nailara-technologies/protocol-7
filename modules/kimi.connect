## [:< ##

# name  = kimi.connect
# descr = create kimi-web session and establish persistent websocket
#         connection

if (<kimi.ws.connected>) {
    <[base.logs]>->( 2, 'kimi.connect: already connected' );
    return;
}

<kimi.connect.retrying> = FALSE;

## verify restored session id is still valid at the backend [ api child ]
if ( defined <kimi.session_id> ) {
    my $handles = <[kimi.session.start_api_child]>;
    if ( not defined $handles ) {
        <[base.logs]>->( 0, ': api child unavailable : clearing session' );
        <kimi.session_id> = undef;
        <[file.zenka_dir.write]>->( 'session_id', \'' );
    } else {
        my ( $r_fh, $w_fh ) = @{$handles};
        my $check_url = sprintf( '%s/api/sessions/%s',
            <kimi.web.base_url>, <kimi.session_id> );

        print $w_fh "verify $check_url\n";
        my $status_line = <$r_fh>;
        chomp $status_line if defined $status_line;

        if ( not defined $status_line
            or $status_line =~ m{^(stale|archived)} ) {
            <[base.logs]>->(
                1,
                ': restored session %s is %s : creating fresh',
                <kimi.session_id>,
                ( $status_line // 'no response' ) =~ m|^stale|
                ? "stale [ $status_line ]"
                : ( $status_line // 'child error' )
            );
            <kimi.session_id> = undef;
            <[file.zenka_dir.write]>->( 'session_id', \'' );
        } elsif ( $status_line =~ m|^error| ) {
            <[base.logs]>->(
                0, ': session verify error [ %s ] : clearing session',
                $status_line
            );
            <kimi.session_id> = undef;
            <[file.zenka_dir.write]>->( 'session_id', \'' );
        } else {
            <[base.logs]>->(
                2, ': restored session %s verified at backend',
                <kimi.session_id>
            );
        }
    }
}

## create new kimi-web session via rest api [ api child ]
if ( not defined <kimi.session_id> ) {
    my $session_id = <[kimi.session.create]>;

    if ( not defined $session_id ) {
        <kimi.ws.status> = qw| disconnected |;
        return;
    }

    <kimi.session_id> = $session_id;
}

## websocket connect
my $ws_url = sprintf( '%s/api/sessions/%s/stream',
    <kimi.web.ws_base>, <kimi.session_id> );

my $sock = <[websocket.connect]>->($ws_url);

if ( not defined $sock ) {
    <[base.logs]>->(
        0, 'kimi.connect: websocket connect failed [ %s ]', $ws_url
    );
    <kimi.ws.status>  = qw| disconnected |;
    <kimi.session_id> = undef;    ## clear so next retry creates fresh session
    return;
}

<kimi.ws.socket> = $sock;
<kimi.ws.frame>  = Protocol::WebSocket::Frame->new(
    max_payload_size => 16 * 1024
        * 1024                    ## 16 MiB [ tool results can be large ]
);
<kimi.wire.accumulator>  = '';
<kimi.connect.retry_cur> = 2;     ## reset backoff on each new connect

## register event.add_io for incoming frames
<kimi.ws.io_watcher> = <[event.add_io]>->(
    {   'fd'      => $sock,
        'handler' => qw| websocket.handler.read |,
        'data'    => {
            'frame'      => <kimi.ws.frame>,
            'on_message' => qw| kimi.handler.ws_message |,
            'context'    => { 'session_id' => <kimi.session_id> }
        },
        'poll' => qw| re |
    }
);

<kimi.ws.connected> = TRUE;

## if prompts were preserved across reconnect, restore busy status so that
## history_complete skips initialize [ TurnEnd will fire when work completes ]
my $has_preserved_prompt = FALSE;
for my $pend_id ( keys %{<kimi.wire.pending>} ) {
    if ( ( <kimi.wire.pending>->{$pend_id}{'type'} // '' ) eq qw| prompt | ) {
        $has_preserved_prompt = TRUE;
        last;
    }
}
if ($has_preserved_prompt) {
    <kimi.ws.status> = qw| busy |;
    <[base.logs]>->(
        1, ': reconnected with preserved prompt : status set to busy'
    );
} else {
    ## status change triggers watcher : starts liveness timeout
    <kimi.ws.status> = qw| connecting |;
}

## clear responded cache so re-sent approvals on new ws session are not
## silently dropped : previous response may not have been received by backend
<kimi.approval.responded> = {};
<[file.zenka_dir.write]>->( 'approval_responded', \'' );

## flush any approvals that arrived during the disconnect window ##
my $pending = <kimi.approval.pending> // {};
my @stale   = keys %$pending;
if (@stale) {
    <[base.logs]>->(
        1,
        ': flushing %d stale approval%s after reconnect',
        scalar @stale,
        @stale == 1 ? '' : 's'
    );
    for my $rid (@stale) {
        ## approval_respond marks responded itself on confirmed send : keep in
        ## pending on failure so the next reconnect flush retries
        if ( defined <[kimi.wire.approval_respond]>->( $rid, 'approve' ) ) {
            delete $pending->{$rid};
        }
    }
}

<[base.logs]>->( 2, 'kimi.connect: websocket connected [ %s ]', $ws_url );

