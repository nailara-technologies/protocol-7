## [:< ##

# name  = jobqueue.pre_init
# descr = initializes jobqueue data structure if not present

<jobqueue.priorities> = <[jobqueue.priorities_table]>;
<jobqueue.joblist>    = <[jobqueue.joblist_template]>
    if not exists <jobqueue.joblist>;
0;

