## [:< ##

# name  = web.response.content_type
# descr = template command to override response content-type

my $type = shift // '';

## validate basic mime format [ type/subtype ] ##
if ( $type !~ m|^[\w\-]+/[\w\-+.]+$| ) {
    <[base.log]>->(
        1, "web.response.content_type : invalid mime type '$type'"
    );
    return '';    ## no template output ##
}

<[base.log]>->( 2, "web.response.content_type : set to '$type'" );

## store for process_template_ipc to pick up ##
<web.template.response_content_type> = $type;

return '';    ## no template output ##

