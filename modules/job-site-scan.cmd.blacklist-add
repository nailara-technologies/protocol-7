# name  = job-site-scan.cmd.blacklist-add
# descr = add company name to checksum blacklist
# param = <company_name>

my $args = $call->{'args'} // '';
$args =~ s/^\s+|\s+$//g;

return { 'mode' => qw| false |, 'data' => 'company_name required' }
    unless length $args;

my $ok = <[job-site-scan.checksum.index]>->( qw| blacklist_company |, $args );

if ($ok) {
    <[job-site-scan.checksum.index]>->(qw| persist |);
    my $sum = <[chk-sum.amos]>->($args);
    return {
        'mode' => qw| true |,
        'data' => "blacklisted company '$args' [amos:$sum]"
    };
}

return { 'mode' => qw| false |, 'data' => 'failed to blacklist' };

