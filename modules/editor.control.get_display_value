# name  = editor.control.get_display_value
# descr = field value as it should be drawn, not as stored
# param = $editor_state, $field

## the boundary between what a field HOLDS and what a renderer may PUT ON
## SCREEN.  every ui backend draws through this ; editor.control.get_value
## stays truthful and is what editor.control.submit collects, so a masked
## field still submits its real content.
##
## masked fields return a run of '*' of the same length -- same length so
## cursor offsets, required-width computation and per-row fill padding all
## stay consistent with the real buffer [ see editor.ui.ascii_frame.
## render_form's width note ].  a caller must therefore never assume the
## displayed string equals the stored one.
##
## adding a type that renders differently from how it is stored means
## extending THIS module, not the renderers.

my ( $editor_state, $field ) = @ARG;

return undef if ref $editor_state ne qw| HASH |;

my $value = <[editor.control.get_value]>->( $editor_state, $field );

return $value if not defined $value;

## LIST fields : the buffer is not the value.  entries live on the schema
## field def, which stays authoritative while collapsed, and what gets DRAWN
## is a count summary -- the HOLDS-vs-DRAWN split this module exists for
my ($field_def)
    = grep { ( $ARG->{'name'} // '' ) eq $field }
    ( $editor_state->{'schema'}{'fields'} // [] )->@*;

## the summary text itself lives in editor.control.list.summary : it is also
## what user-edit.form.build_frame measures to reserve the frame width across
## an expand/collapse, and two implementations of one sentence would drift
if ( ref $field_def eq qw| HASH | and $field_def->{'list'} ) {

    return <[editor.control.list.summary]>->($field_def);
}

## CYCLER fields : the buffer is not the value either -- choices live on the
## field def and the current one is an index.  drawn as the choice set with
## the current one bracketed, so the whole option row reads at a glance : '+
## [full_name] |  phone    |  shell    '
##
## the layout itself lives in editor.control.cycler.render, because
## user-edit.form.build_frame reserves this row's WIDTH by drawing the full
## vocabulary through the same code -- two implementations of one grid would
## drift and the reservation would silently stop matching
if (    ref $field_def eq qw| HASH |
    and ref $field_def->{'choices'} eq qw| ARRAY | ) {

    return <[editor.control.cycler.render]>->(
        $field_def->{'choices'},
        $field_def->{'choice'}
    );
}

my $buffer = $editor_state->{'fields'}{$field};
my $type
    = ref $buffer eq qw| HASH |
    ? $buffer->{'type'} // qw| freeform_line |
    : qw| freeform_line |;

return q|*| x length $value if $type eq qw| masked |;

return $value;

