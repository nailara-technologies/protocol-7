# name = models.storage.resolve_model
# descr = Resolve model through fallback chain

use File::Spec;

# Resolve model through fallback chain: Tier 3 → Tier 2 → Tier 4 → Tier 5 → Tier 1
sub resolve_model_path {
  my ($model_amos, $storage_locations) = @_;

  # Default fallback order if no locations provided
  my @fallback_tiers = (3, 2, 4, 5, 1);

  foreach my $tier (@fallback_tiers) {
    my $location = find_location_at_tier($model_amos, $storage_locations, $tier);

    if ($location) {
      my $path = $location->{path};
      if (-f $path || -l $path) {
        return {
          'path' => $path,
          'tier' => $tier,
          'available' => 1,
          'location' => $location,
        };
      }
    }
  }

  # Not found anywhere - return metadata location
  my $metadata_path = File::Spec->catfile('data/models', "$model_amos.meta");
  return {
    'path' => $metadata_path,
    'tier' => 1,
    'available' => 0,
    'is_metadata_only' => 1,
  };
}

# Find location within storage_locations array
sub find_location_at_tier {
  my ($model_amos, $storage_locations, $target_tier) = @_;

  return undef unless $storage_locations && ref($storage_locations) eq 'ARRAY';

  foreach my $loc (@$storage_locations) {
    next unless $loc->{tier} == $target_tier;
    return $loc;
  }

  return undef;
}

# Entry point
{
  my @args = @ARG;
  return resolve_model_path(@args);
};

