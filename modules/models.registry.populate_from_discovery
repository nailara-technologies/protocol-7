## [:< ##

# name  = models.registry.populate_from_discovery
# args  = $discovered_models_arrayref [optional, by default discover from paths]
# descr = Add discovered .gguf files to registry

my $discovered = shift;

# If no discovered models provided, discover them
unless ( $discovered && ref($discovered) eq qw| ARRAY | ) {
    $discovered = <[models.storage.discover_directory]>->(
        qw| /mnt/ext-xfs-data/models-lmstudio |, TRUE    ## [LLL] fix path
    ) // [];
}

my $registry = <models.registry> // {};

my $added_count = 0;

foreach my $model ( $discovered->@* ) {

    # Check if already in registry by path
    my $already_exists = FALSE;
    my $model_path     = $model->{'path'} // '';
    next unless length $model_path;

    foreach my $entry ( values $registry->%* ) {
        my $entry_path = $entry->{path} // '';
        if ( length $entry_path && $entry_path eq $model_path ) {
            $already_exists = TRUE;
            last;
        }
    }
    next if $already_exists;

    ## Calculate composite checksum: path_checksum:model_checksum
    my $path_checksum  = <[models.checksum.from_path]>->( $model->{'path'} );
    my $model_checksum = <[models.checksum.from_metadata]>->(
        {   'model_id'     => $model->{'name'},
            'name'         => $model->{'name'},
            'quantization' => $model->{'quantization'} // 'unknown',
            'size_gb'      => $model->{'size_gb'}      // 0,
            'is_vision'    => $model->{'is_vision'}    // FALSE
        }
    );

    unless ( defined $path_checksum && defined $model_checksum ) {
        <[base.logs]>->(
            0,
            '[populate_from_discovery] failed to calculate checksums for: %s',
            $model->{'name'}
        );
        next;
    }

    my $model_id = "$path_checksum:$model_checksum";

    $registry->{$model_id} = {
        amos          => $model_id,           ## composite checksum key ##
        model_id      => $model->{'name'},    ## short name ##
        name          => $model->{'name'},
        file_path     => $model->{'path'},
        path          => $model->{'path'},
        size_gb       => $model->{'size_gb'}      // 0,
        quantization  => $model->{'quantization'} // 'unknown',
        tier          => $model->{'tier'},
        is_vision     => $model->{'is_vision'} // FALSE,
        source        => qw| discovered |,
        registered_at => <[base.time]>->(3)
    };

    $added_count++;
}

<models.registry> = $registry;

return { 'success' => TRUE, 'added' => $added_count };

