# name  = models.registry.populate_from_discovery
# descr = Add discovered .gguf files to registry

my $discovered = <[models.storage.discover.discover_models]> ();
my $registry   = <models.registry> // {};

my $added_count = 0;

foreach my $model (@$discovered) {

    # Check if already in registry by path
    my $already_exists = 0;
    foreach my $entry ( values %$registry ) {
        if ( $entry->{path} eq $model->{path} ) {
            $already_exists = 1;
            last;
        }
    }
    next if $already_exists;

    # Calculate checksums
    my $checksums = <[models.checksum.calculate_all]>->( $model->{path} );
    next unless $checksums && $checksums->{success};

    # Use BMW-L13 as model_id for discovered models
    my $model_id = $checksums->{bmw_l13};

    $registry->{$model_id} = {
        model_id      => $model_id,
        amos_7        => $checksums->{amos_7},
        bmw_l13       => $checksums->{bmw_l13},
        bmw_base32    => $checksums->{bmw_base32},
        name          => $model->{name},
        path          => $model->{path},
        size_gb       => $model->{size_gb},
        tier          => $model->{tier},
        source        => 'discovered',
        registered_at => time()
    };

    $added_count++;
}

<models.registry> = $registry;

return { success => TRUE, added => $added_count };

