## [:< ##

# name  = data.cmd.detach-cube
# param = <mountpoint>
# descr = unmount FUSE filesystem and terminate child process

my $mountpoint = $call->{'args'} // '';
$mountpoint =~ s|^\s+||;
$mountpoint =~ s|\s+$||;

return {
    'mode' => qw| false |,
    'data' => 'expected <mountpoint> argument'
    }
    unless length($mountpoint);

$mountpoint =~ s|/+$|| if length($mountpoint) > 1;

## check if mount exists in registry ##
if ( !exists <data.fuse.mounts> {$mountpoint} ) {
    return {
        'mode' => qw| false |,
        'data' => "no active mount found at '$mountpoint'"
    };
}

my $mount_info = <data.fuse.mounts> {$mountpoint};
my $pid        = $mount_info->{'pid'};

## try graceful unmount via fusermount ##
my $unmount_result = 0;
my $unmount_output = '';

if ( -x '/usr/bin/fusermount' || -x '/bin/fusermount' ) {
    $unmount_output = `fusermount -u "$mountpoint" 2>&1`;
    $unmount_result = $?;
} elsif ( -x '/usr/bin/umount' || -x '/bin/umount' ) {

    # Fallback to regular umount
    $unmount_output = `umount "$mountpoint" 2>&1`;
    $unmount_result = $?;
}

## kill child process if still running ##
my $killed = 0;
if ( defined $pid && kill( 0, $pid ) ) {
    kill( 'TERM', $pid );
    sleep(0.1);
    if ( kill( 0, $pid ) ) {

        # Force kill if still running
        kill( 'KILL', $pid );
    }
    $killed = 1;
}

## remove from registry ##
delete <data.fuse.mounts> {$mountpoint};

## clean up child_pids array ##
<data.fuse.child_pids> = [ grep { $_ != $pid } <data.fuse.child_pids>->@* ];

return {
    'mode' => qw| true |,
    'data' => sprintf(
        "Unmounted %s (pid %d)%s%s",
        $mountpoint,
        $pid // 'unknown',
        $killed         ? ' - process terminated'    : '',
        $unmount_result ? " - note: $unmount_output" : ''
    )
};

