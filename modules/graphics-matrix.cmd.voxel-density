# name  = graphics-matrix.cmd.voxel-density
# descr = query voxel density grid

my $args      = $call->{'args'} // '';
my $threshold = 1;
my $top_n     = 0;

if ( $args =~ m|^threshold\s+(\d+)$| ) {
    $threshold = $1;
} elsif ( $args =~ m|^top\s+(\d+)$| ) {
    $top_n = $1;
}

my $voxels = <graphics-matrix.harmonic.voxels>;

my @results;
for my $key ( keys %$voxels ) {
    my $v = $voxels->{$key};
    next if $v->{'count'} < $threshold;
    push @results, $v;
}

if ($top_n) {
    @results = sort { $b->{'count'} <=> $a->{'count'} } @results;
    @results = @results[ 0 .. $top_n - 1 ] if @results > $top_n;
}

my @lines;
for my $v (@results) {
    my $key = sprintf( "%s:%s:%s",
        substr( $v->{'coords'}->{'x'}, 0, 3 ),
        substr( $v->{'coords'}->{'y'}, 0, 3 ),
        substr( $v->{'coords'}->{'z'}, 0, 3 ) );
    push @lines,
          "voxel: $key"
        . " | density: $v->{'count'}"
        . " | agreement: $v->{'axis_agreement'}"
        . " | inputs: "
        . join( ', ', $v->{'inputs'}->@* );
}

return {
    'mode' => 'size',
    'data' => @lines
    ? join( "\n", @lines ) . "\n"
    : "no voxels match criteria\n"
};

