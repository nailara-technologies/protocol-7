## [:< ##

# name  = job-site-scan.init_code
# descr = initialize scan coordinator, restore state

<[base.perlmod.autoload]>->('YAML::XS');

## cycle-level state
<job-site-scan.cycle>         = 'idle';
<job-site-scan.last_scan>     = 0;
<job-site-scan.pending_count> = 0;

## per-job state lives under job-site-scan.tasks.<job_id>.*
<job-site-scan.tasks> //= {};

<[job-site-scan.state.load]>;

## var watcher on pending_count — fires when all assessments land
<[event.add_var]>->(
    {   'var'     => \<job-site-scan.pending_count>,
        'poll'    => 'w',
        'handler' => 'job-site-scan.handler.pending-changed',
        'repeat'  => TRUE,
        'desc'    => 'jss pending_count watcher',
    }
);

## rescan timer — only when interval > 0
my $interval = <job-site-scan.cfg.rescan_interval> // 0;
if ( $interval > 0 ) {
    <[event.add_timer]>->(
        {   'after'    => $interval,
            'interval' => $interval,
            'repeat'   => TRUE,
            'handler'  => 'job-site-scan.handler.rescan-timer',
        }
    );
    <[base.logs]>->( 1, 'job-site-scan: rescan timer %ds', $interval );
}

## re-wire task.wait-done for any jobs stuck in 'assessing' after restart
my $tasks   = <job-site-scan.tasks> // {};
my @orphans = grep {
    ( $tasks->{$ARG}{'stage'} // '' ) eq 'assessing'
        and length( $tasks->{$ARG}{'task_id'} // '' )
    }
    keys %{$tasks};

if (@orphans) {
    <job-site-scan.pending_count> = scalar @orphans;
    <[base.logs]>->(
        1,
        'job-site-scan: re-wiring %d orphaned assessment tasks',
        scalar @orphans
    );
    ## store queue — rewire-all handler processes after event loop starts
    <job-site-scan.rewire_queue>
        = [
        map { { 'job_id' => $ARG, 'task_id' => $tasks->{$ARG}{'task_id'} } }
            @orphans ];
    <[event.add_timer]>->(
        {   'after'   => 2,
            'repeat'  => FALSE,
            'handler' => 'job-site-scan.handler.rewire-all',
        }
    );
}

my $job_count = scalar keys %{$tasks};
<[base.logs]>->(
    1,                     'job-site-scan: ready, cycle=%s, jobs=%d',
    <job-site-scan.cycle>, $job_count
);

