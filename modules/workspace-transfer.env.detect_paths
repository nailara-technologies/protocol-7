## [:< ##

# name  = workspace-transfer.env.detect_paths
# descr = Detect current environment and repository paths
# return = hash with protocol7_root, workspace_root, and environment_type

## Protocol-7 root is known at system initialization ##
my $protocol7_root = $ENV{PROTOCOL7_ROOT} // <system.root_path>;
my %env_data       = ( qw| protocol7_root | => $protocol7_root );

## Workspace-transfer root detection via symlink ##
my $symlink_path = <worspace-transfer.repo_path_symlink>
    // qw| configuration/development/workspace-transfer-repository |;
my $symlink_full = catfile( $protocol7_root, $symlink_path );

if ( $ENV{WORKSPACE_TRANSFER_ROOT} ) {
    ## Use environment variable if set ##
    $env_data{workspace_root} = $ENV{WORKSPACE_TRANSFER_ROOT};
} elsif ( -l $symlink_full ) {
    ## Read symlink target and resolve to absolute path ##
    my $link_target = readlink $symlink_full;
    if ( defined $link_target ) {
        my $abs_path;
        if ( $link_target =~ m{^/} ) {
            ## Absolute symlink ##
            $abs_path = $link_target;
        } else {
            ## Relative symlink - resolve from symlink's directory ##
            my $symlink_dir = $symlink_full;
            $symlink_dir =~ s{/[^/]+$}{};    ## remove filename ##
            $abs_path = "$symlink_dir/$link_target";
        }
        ## Resolve . and .. in path ##
        $abs_path =~ s{/\.(?=/|$)}{};
        1 while $abs_path =~ s{/[^/]+/\.\.(?=/|$)}{};
        $abs_path =~ s{/+}{/}g;              ## remove duplicate slashes ##
        $env_data{workspace_root} = $abs_path if -d $abs_path;
    }
}

## Fallback to relative path if symlink read failed ##
unless ( defined $env_data{workspace_root} ) {
    my $fallback = "$protocol7_root/../workspace-transfer";
    if ( -d $fallback ) {
        $env_data{workspace_root} = $fallback;
    } else {
        <[base.logs]>->(
            0,
            ":: warning :: could not detect workspace-transfer root directory"
        );
        return undef;
    }
}

## Detect environment type from protocol-7 root path ##
if ( $protocol7_root =~ m{/home/(/user/)?protocol-7/?$} ) {
    $env_data{'environment_type'} = qw| claude |; ### [LLL] multiple types ###
} elsif ( $protocol7_root =~ m{/data/projects/.+} ) {
    $env_data{'environment_type'} = qw| local |;
} elsif ( $protocol7_root =~ m{/usr/local/protocol-7/?$} ) {
    $env_data{'environment_type'} = qw| production |;
} else {
    $env_data{'environment_type'} = qw| unknown |;
}

return \%env_data;

