# name = data.init_holographic.determine_polarity
# desc = Determine space vs anti-space polarity

my ($position) = @_;
my ( $x, $y, $z ) = @$position;
my $sum = $x + $y + $z;

return ( $sum % 2 ) ? 'space' : 'anti-space';

