## [:< ##

# name = menu-commands.cmd.status
# descr = Show menu-commands zenka status

# Get zenka data directory path
my $zenka_dir_href  = <system.path.zenka-dirs>;
my $zenka_name      = <system.zenka.name>;
my $zenka_data_dir  = $zenka_dir_href->{'var_P7'} . '/' . $zenka_name;
my $mappings_file   = $zenka_data_dir . '/data/mappings.yaml';
my $categories_file = $zenka_data_dir . '/data/categories.yaml';

my $mappings_size
    = -f $mappings_file ? ( File::stat::stat($mappings_file)->size // 0 ) : 0;
my $categories_size
    = -f $categories_file
    ? ( File::stat::stat($categories_file)->size // 0 )
    : 0;

my $output = '';
$output .= "\n";
$output .= "Menu-Commands Zenka Status\n";
$output .= "===========================\n";
$output .= "\n";
$output .= sprintf(
    "Mappings:       " . "   %d\n",
    scalar( keys %{<menu-commands.mappings>} )
);
$output .= sprintf(
    "Categories:       " . " %d\n",
    scalar( keys %{<menu-commands.categories>} )
);
$output .= "\n";
$output .= "Persistent Storage:\n";
$output .= sprintf( "  Mappings file: " . "  %s (%d bytes)\n",
    $mappings_file, $mappings_size );
$output .= sprintf( "  Categories file: %s " . "(%d bytes)\n",
    $categories_file, $categories_size );
$output .= sprintf( "  Zenka data dir:  %s\n", $zenka_data_dir );
$output .= "\n";
$output .= "Registration:\n";
$output .= sprintf(
    "  Protocol-7-Menu: available " . "(updates pushed on change)\n" );
$output .= "\n";
$output .= "Configuration:\n";
$output .= sprintf("  On-demand:       enabled (70 minute idle timeout)\n");
$output .= sprintf("  Auto-restart:    disabled\n");
$output .= sprintf("  Heartbeat:       disabled\n");

return {
    'mode' => qw| true |,
    'data' => $output,
};

