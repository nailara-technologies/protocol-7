## [:< ##

# name = protocol-7-menu.init_code

### early '-MGtk3' loading from ./bin/protocol-7 [gui] wrapper script
##
my $init_gtk3 = <[base.cfg_bool]>->( $ENV{'P7_GTK3_INIT'} //= FALSE );

<[base.perlmod.load]>->( 'YAML::XS', qw|  Load  Dump  | );

<protocol-7-menu.init-graphical> //= TRUE;    ### testing ###

<protocol-7-menu.init-console>   //= FALSE;
<protocol-7-menu.init-graphical> //= $init_gtk3 ? TRUE : FALSE;

<protocol-7-menu.menu-tree>
    //= { 'character-console' => {}, 'graphical' => {} };

<protocol-7-menu.action-keys>
    //= { 'character-console' => {}, 'graphical' => {} };

##  load menu structure and action keys  ##
<[protocol-7-menu.load-menu-tree]>;
<[protocol-7-menu.load-action-keys]>;

##  initialize push-based menu structure  ##
<[protocol-7-menu.menu-structure-init]>;

##  load console mode dependencies  ##
if (<protocol-7-menu.init-console>) {
    <[base.perlmod.autoload]>->('Curses::UI');
}

<[base.perlmod.autoload]>->('Gtk3');
<[base.perlmod.autoload]>->('Glib::Object::Introspection');

<[base.gtk.attempt_load.glib_event]>;  ##  load Glib::Event when installed  ##

# <protocol-7-menu.stderr_capture> = '';

##  silence stderr console output  ##
#
<[base.stderr_redir]>;

##  load graphical [X-11] mode dependencies  ##
if (<protocol-7-menu.init-graphical>) {

    <[base.gtk.attempt_load.glib_event]>;

    Gtk3->init;    ## initialize explicitly ##

    my $logo_image_path = <protocol-7-menu.image_path>
        //= File::Spec->catfile( <system.root_path>,
        qw| data/gfx/logos/nailara.png | );
    <[base.logs]>->( 0, "[ not found ] image file '%s'", $logo_image_path )
        if not -f $logo_image_path;
}

## Defer graphical initialization until zenka loop runs
## This ensures display context is available before creating Gtk3 widgets
<protocol-7-menu.graphical-initialized> //= FALSE;

return 0;

