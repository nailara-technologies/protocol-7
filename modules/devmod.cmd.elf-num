## [:< ##

# name  = devmod.cmd.elf-num
# descr = return ELF-7-13 checksum value [numerical]
# param = [str]

return {
    'mode' => qw| true |,
    'data' => <[chk-sum.elf]>->( $call->{'args'} // '' )
    }

