## [:< ##

# name  = jobsite.checksum.index
# descr = filesystem directory-based checksum store for jobsite dedup + blacklist
# note  = file existence = record; no load/persist cycle; epoch dirs for url expiry

my $action = shift // 'check';

my $store_root    = '/var/protocol-7/jobsite/checksum-store';
my $old_yaml      = '/var/protocol-7/jobsite/checksum-index.yaml';
my $migrated_flag = "$store_root/.migrated";

if ( -f $old_yaml and not -f $migrated_flag ) {
    <[base.perlmod.autoload]>->('YAML::XS');
    my $old = eval { YAML::XS::LoadFile($old_yaml) } // {};
    for my $c_sum ( keys %{ $old->{'companies'} // {} } ) {
        my $empty = '';
        <[file.zenka_dir.write]>->(
            "checksum-store/companies/blacklisted/$c_sum",
            \$empty, '>', 0640
        );
    }
    my $empty = '';
    <[file.zenka_dir.write]>->(
        'checksum-store/.migrated', \$empty, '>', 0640
    );
    <[base.logs]>->( 1, 'checksum-store: migrated old yaml blacklist' );
}

## migrate flat titles/ to titles/assessed/ (one-time) ##
my $titles_root = "$store_root/titles";
if ( -d $titles_root ) {
    opendir my $dh, $titles_root or goto MIGRATE_DONE;
    my @files = grep { !/^\./ && -f "$titles_root/$_" } readdir($dh);
    closedir $dh;
    if (@files) {
        my $assessed_dir = "$titles_root/assessed";
        if ( not -d $assessed_dir ) {
            my $p7_user = <system.amos-zenka-user> // qw| protocol-7 |;
            <[file.make_path]>->( $assessed_dir, 0750, $p7_user, $p7_user );
        }
        for my $fn (@files) {
            rename "$titles_root/$fn",
                "$assessed_dir/$fn"
                or <[base.logs]>->(
                0,   'checksum-store: migrate title %s failed: %s',
                $fn, $!
                );
        }
        <[base.logs]>->(
            1,
            'checksum-store: migrated %d flat title entries to assessed/',
            scalar @files
        );
    }
}
MIGRATE_DONE:

if ( $action eq 'check' ) {
    my $job = shift // {};
    my @hits;
    my $resolved_status;

    ## company blacklist ##
    if ( length( $job->{'company'} // '' ) ) {
        utf8::encode( my $co = $job->{'company'} );
        my $c_sum = <[chk-sum.amos]>->($co);
        if ( length $c_sum ) {
            push @hits, "company:$c_sum"
                if -e "$store_root/companies/blacklisted/$c_sum";
        }
    }

    ## title dedup with status resolution ##
    if ( length( $job->{'title'} // '' ) ) {
        utf8::encode( my $ti = $job->{'title'} );
        my $t_sum = <[chk-sum.bmw.str-b32.L13]>->($ti);
        if ( length $t_sum ) {
            if ( opendir my $dh, $titles_root ) {
                for my $status_dir ( readdir $dh ) {
                    next if $status_dir =~ m{^\.};
                    next unless -d "$titles_root/$status_dir";
                    if ( -e "$titles_root/$status_dir/$t_sum" ) {
                        push @hits, "title:$t_sum";
                        $resolved_status //= $status_dir;
                        last;
                    }
                }
                closedir $dh;
            }
        }
    }

    ## url dedup : check across all epoch dirs ##
    if ( length( $job->{'url'} // '' ) ) {
        utf8::encode( my $url = $job->{'url'} );
        my $u_sum = <[chk-sum.bmw.str-b32.L13]>->($url);
        if ( length $u_sum ) {
            my $url_root = "$store_root/urls";
            if ( opendir my $dh, $url_root ) {
                for my $epoch_dir ( readdir $dh ) {
                    next if $epoch_dir =~ m{^\.};
                    if ( -e "$url_root/$epoch_dir/$u_sum" ) {
                        push @hits, "url:$u_sum";
                        last;
                    }
                }
                closedir $dh;
            }
        }
    }

    return {
        'is_blocked'      => scalar(@hits) > 0,
        'hits'            => \@hits,
        'resolved_status' => $resolved_status // '',
    };
}

if ( $action eq 'add' ) {
    my $job = shift // {};

    my $epoch_dir = <[base.ntime.epoch_timestamp]>;

    if ( length( $job->{'title'} // '' ) ) {
        utf8::encode( my $ti = $job->{'title'} );
        my $t_sum = <[chk-sum.bmw.str-b32.L13]>->($ti);
        if ( length $t_sum ) {
            my $t_path = "$titles_root/assessed/$t_sum";
            if ( not -e $t_path ) {
                my $empty = '';
                <[file.zenka_dir.write]>->(
                    "checksum-store/titles/assessed/$t_sum",
                    \$empty, '>', 0640
                );
            }
        }
    }

    if ( length( $job->{'url'} // '' ) ) {
        utf8::encode( my $url = $job->{'url'} );
        my $u_sum = <[chk-sum.bmw.str-b32.L13]>->($url);
        if ( length $u_sum and not -e "$store_root/urls/$epoch_dir/$u_sum" ) {
            my $empty = '';
            <[file.zenka_dir.write]>->(
                "checksum-store/urls/$epoch_dir/$u_sum",
                \$empty, '>', 0640
            );
        }
    }

    return TRUE;
}

if ( $action eq 'update_status' ) {
    my $job        = shift // {};
    my $new_status = shift // '';
    return FALSE unless length $new_status;

    if ( length( $job->{'title'} // '' ) ) {
        utf8::encode( my $ti = $job->{'title'} );
        my $t_sum = <[chk-sum.bmw.str-b32.L13]>->($ti);
        if ( length $t_sum ) {
            my $found = 0;
            if ( opendir my $dh, $titles_root ) {
                for my $status_dir ( readdir $dh ) {
                    next if $status_dir =~ m{^\.};
                    next unless -d "$titles_root/$status_dir";
                    my $old_path = "$titles_root/$status_dir/$t_sum";
                    if ( -e $old_path ) {
                        my $new_dir = "$titles_root/$new_status";
                        if ( not -d $new_dir ) {
                            my $p7_user = <system.amos-zenka-user>
                                // qw| protocol-7 |;
                            <[file.make_path]>->(
                                $new_dir, 0750, $p7_user, $p7_user
                            );
                        }
                        my $new_path = "$new_dir/$t_sum";
                        if ( $old_path ne $new_path ) {
                            rename $old_path,
                                $new_path
                                or <[base.logs]>->(
                                0,
                                'checksum.index: update_status rename %s -> %s failed: %s',
                                $old_path,
                                $new_path,
                                $!
                                );
                        }
                        $found = 1;
                        last;
                    }
                }
                closedir $dh;
            }
            return $found;
        }
    }
    return FALSE;
}

if ( $action eq 'blacklist_company' ) {
    my $company = shift // '';
    return FALSE unless length $company;
    utf8::encode($company) if utf8::is_utf8($company);
    my $c_sum = <[chk-sum.amos]>->($company);
    return FALSE unless length $c_sum;
    my $empty = '';
    my $wrote = <[file.zenka_dir.write]>->(
        "checksum-store/companies/blacklisted/$c_sum",
        \$empty, '>', 0640
    );
    return defined $wrote ? TRUE : FALSE;
}

if ( $action eq 'stats' ) {
    my $co_count = 0;
    if ( opendir my $dh, "$store_root/companies/blacklisted" ) {
        $co_count = scalar grep { !/^\./ } readdir $dh;
        closedir $dh;
    }
    my $ti_count = 0;
    if ( opendir my $dh, "$store_root/titles" ) {
        for my $st ( grep { !/^\./ && -d "$store_root/titles/$_" }
            readdir $dh ) {
            opendir my $edh, "$store_root/titles/$st" or next;
            $ti_count += scalar( grep { !/^\./ } readdir $edh );
            closedir $edh;
        }
        closedir $dh;
    }
    my $url_count = 0;
    if ( opendir my $dh, "$store_root/urls" ) {
        for my $ep ( grep { !/^\./ } readdir $dh ) {
            opendir( my $edh, "$store_root/urls/$ep" ) or next;
            $url_count += scalar( grep { !/^\./ } readdir $edh );
        }
    }
    return {
        'companies' => $co_count,
        'titles'    => $ti_count,
        'urls'      => $url_count,
    };
}

if ( $action eq 'prune' ) {
    my $keep              = <jobsite.cfg.checksum_store_keep_epochs> // 100;
    my $current_epoch_num = int(<[base.ntime.epoch_dec]>);
    my $removed           = 0;
    my $url_root          = "$store_root/urls";
    if ( opendir my $dh, $url_root ) {
        for my $ep_dir ( grep { !/^\./ } readdir $dh ) {
            next unless $ep_dir =~ m{^V7[A-Z2-7]{5}$}i;
            ## decode epoch dir name to integer for comparison ##
            my $ep_num = <[base.ntime.epoch_timestamp]>->($ep_dir);
            next unless defined $ep_num and $ep_num =~ m{^\d+$};
            if ( $current_epoch_num - $ep_num > $keep ) {
                unlink glob("$url_root/$ep_dir/*");
                rmdir "$url_root/$ep_dir";
                $removed++;
            }
        }
        closedir $dh;
    }
    <[base.logs]>->(
        1, 'checksum-store prune: removed %d epoch dirs', $removed
    );
    return $removed;
}

if ( $action eq 'load' )    { return TRUE; }
if ( $action eq 'persist' ) { return TRUE; }

return { 'mode' => 'false', 'data' => "unknown action: $action" };

