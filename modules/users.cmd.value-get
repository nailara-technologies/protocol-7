## [:< ##

# name  = users.cmd.value-get
# param = <username>
# descr = return parsed host-system record for a username

my $args = $call->{'args'} // '';
$args =~ s|^\s+||;
$args =~ s|\s+$||;

return {
    'mode' => qw| false |,
    'data' => 'usage: users.value-get <username>'
    }
    if not length $args;

my $username = $args;
$username =~ s|\s.*||s;    ## first whitespace-delimited token only ##

return {
    'mode' => qw| false |,
    'data' => 'username cannot contain path separators'
    }
    if $username =~ m|[/\\]|;

my $file_path = <[users.record.path]>->($username);
my $user_data = <[format.yaml.load_keyword_path]>->($file_path);

## COUPLED STRING : user-edit.handler.value_get_reply matches this text
## EXACTLY to tell "no such record" apart from the other 'false' replies below
## [ record invalid, usage ], and only offers to create in the former case.
## changing the wording here disables that offer -- it logs a near-miss at
## level 1 rather than failing loudly, so grep for it there before editing
## this line
return {
    'mode' => qw| false |,
    'data' => sprintf( "user '%s' not found", $username )
    }
    if not defined $user_data;

my ( $record, $err ) = <[users.record.validate]>->( $user_data, $username );

if ( not defined $record ) {
    <[base.logs]>->(
        1,         "user '%s' record failed validation: %s",
        $username, $err
    );
    return {
        'mode' => qw| false |,
        'data' => sprintf( "user '%s' record invalid: %s", $username, $err )
    };
}

## users.record.sorted_fields are shown in the same canonical order they are
## WRITTEN in [ users.record.build ] -- a record saved before that
## normalisation landed [ or one whose fields are mid-edit ] still has its
## old/arbitrary insertion order, and re-sorting on every READ too [ rather
## than only after the next write ] is what makes 'show' agree with a fresh
## submit immediately, without requiring a no-op re-save first.  a read-side
## copy only : this must never WRITE the reordered arrays back, or a plain
## 'get' would have a silent side effect on stored state
my @sorted_fields = grep { ref $record->{'fields'}{$ARG} eq qw| ARRAY | }
    <[users.record.sorted_fields]>;

if (@sorted_fields) {
    $record = { %{$record}, 'fields' => { %{ $record->{'fields'} } } };
    $record->{'fields'}{$ARG}
        = [ <[base.sort]>->( $record->{'fields'}{$ARG} ) ]
        foreach @sorted_fields;
}

## reply contract requires a string 'data' payload, never a raw hashref ##
my $yaml_str = <[format.yaml.dump_str]>->($record);

return {
    'mode' => qw| size |,
    'data' => $yaml_str
};

