# name  = llama-server-vision.cmd.analyze_image
# descr = analyze image with vision model and return analysis result

my ($image_path, $prompt) = split( m| +|, $$call{'args'}, 2 );
$prompt //= 'Describe this image';

unless ( defined $image_path && length $image_path ) {
    return { 'mode' => 'false', 'data' => 'image_path required' };
}

unless ( -f $image_path ) {
    return { 'mode' => 'false', 'data' => "image not found: $image_path" };
}

# Get parent pipe for sending commands to child
my $parent_pipe = <llama-server-vision.pipe.child>;
unless ( defined $parent_pipe ) {
    return { 'mode' => 'false', 'data' => 'vision server not available' };
}

# Generate unique request ID
<llama-server-vision.request_counter> += 1;
my $request_id = <llama-server-vision.request_counter>;

# Track reply for this request
push( @{<llama-server-vision.reply_ids>}, $call->{'reply_id'} );

# Store pending request info
<llama-server-vision.pending_requests>->{$request_id} = {
    'reply_id' => $call->{'reply_id'},
    'image_path' => $image_path,
    'prompt' => $prompt,
};

# Send request to child via pipe
print $parent_pipe "REQUEST|$request_id|$image_path|$prompt\n" if defined $parent_pipe;

return { 'mode' => 'deferred' };

