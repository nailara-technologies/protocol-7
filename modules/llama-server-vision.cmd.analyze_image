# name  = llama-server-vision.cmd.analyze_image
# descr = spawn image analysis with vision model (Qwen3-VL-4B optimized)

use IPC::Open3;
use Symbol qw(gensym);

my ($image_path, $prompt) = split( m| +|, $$call{'args'}, 2 );
$prompt //= 'Describe this image';

unless ( defined $image_path && length $image_path ) {
    return { 'mode' => 'false', 'data' => 'image_path required' };
}

unless ( -f $image_path ) {
    return { 'mode' => 'false', 'data' => "image not found: $image_path" };
}

<[base.logs]>->( 2, "[analyze_image] spawning: image=%s prompt=%s", $image_path, $prompt );

# Spawn vision CLI process immediately (4B model loads fast: 6.5s)
my $binary = <llama-server-vision.binary>;
my $model_path = <llama-server-vision.vision_model_path>;
my $mmproj_path = <llama-server-vision.vision_mmproj_path>;

my @cmd = (
    $binary,
    '-m', $model_path,
    '--mmproj', $mmproj_path,
    '-ngl', 99,
    '-c', 1024,
    '-t', 4,
    '--image', $image_path,
    '-n', 100,
    '-p', $prompt
);

# Set up environment for vision model
local $ENV{'LD_LIBRARY_PATH'} = <llama-server-vision.lib_path> . ':' . ($ENV{'LD_LIBRARY_PATH'} // '');

# Spawn vision CLI process
my ($wtr, $rdr, $err);
$err = gensym;

my $pid = eval { open3($wtr, $rdr, $err, @cmd) };

if ( !$pid || $@ ) {
    <[base.logs]>->( 0, "ERROR: Failed to spawn vision CLI: %s", $@ // 'unknown error' );
    return { 'mode' => 'false', 'data' => 'vision CLI spawn failed' };
}

close($wtr);  # We don't send any stdin

# Generate unique job ID
my $job_id = <[base.gen_id]>->(<llama-server-vision.jobs>);

# Create job entry
my $job = {
    'job_id'      => $job_id,
    'reply_id'    => $$call{'reply_id'},
    'image_path'  => $image_path,
    'prompt'      => $prompt,
    'status'      => qw| running |,
    'pid'         => $pid,
    'output'      => '',
    'rdr_closed'  => 0,
    'err_closed'  => 0,
    'start_time'  => <[base.time]>->(3)
};

# Store job in queue
<llama-server-vision.jobs>->{$job_id} = $job;

<[base.logs]>->( 1, "[analyze_image] spawned: job=%s pid=%d", $job_id, $pid );

# Register non-blocking I/O handlers for stdout and stderr
$job->{'rdr_io'} = <[event.add_io]>->(
    {
        'fd'      => $rdr,
        'handler' => 'llama-server-vision.handler.read_output',
        'data'    => { 'job_id' => $job_id, 'stream' => 'stdout' }
    }
);

$job->{'err_io'} = <[event.add_io]>->(
    {
        'fd'      => $err,
        'handler' => 'llama-server-vision.handler.read_output',
        'data'    => { 'job_id' => $job_id, 'stream' => 'stderr' }
    }
);

# Register completion checker timer
<llama-server-vision.timers>->{$job_id} = <[event.add_timer]>->(
    {
        'interval' => 0.2,
        'handler'  => 'llama-server-vision.handler.check_completion',
        'data'     => $job_id
    }
);

return { 'mode' => 'deferred' };

