## [:< ##

# name = httpsd.init_code
# descr = Initialize HTTPS/TLS server zenka - wraps httpd with TLS encryption

<[base.log]>->( 2, 'initializing HTTPSD (HTTPS server) zenka..,' );

# Load HTTPD initialization (core HTTP handling)
<[httpd.init_code]>;

# CRITICAL FIX: Ensure httpd.cfg.hostnames has default entries
# httpd.scan_site_dir initializes httpd.cfg.hostnames as empty, then populates from /var/httpd
# If no vhosts exist, it remains empty. We must add defaults for localhost/127.0.0.1
unless ( defined <httpd.cfg.hostnames> ) {
    <httpd.cfg.hostnames> = {};
}

# Add defaults if not already present (map to directory paths)
my $default_dir = <httpd.site_dir> . '/default' // '/var/httpd/default';

# Explicitly set hostname mappings (using unless exists to preserve any user-configured overrides)
unless ( exists <httpd.cfg.hostnames>->{'default'} ) {
    <httpd.cfg.hostnames>->{'default'} = $default_dir;
    <[base.log]>->( 2, "  set httpd.cfg.hostnames->{default} = $default_dir" );
}
unless ( exists <httpd.cfg.hostnames>->{'localhost'} ) {
    <httpd.cfg.hostnames>->{'localhost'} = $default_dir;
    <[base.log]>->( 2, "  set httpd.cfg.hostnames->{localhost} = $default_dir" );
}
unless ( exists <httpd.cfg.hostnames>->{'127.0.0.1'} ) {
    <httpd.cfg.hostnames>->{'127.0.0.1'} = $default_dir;
    <[base.log]>->( 2, "  set httpd.cfg.hostnames->{127.0.0.1} = $default_dir" );
}

<[base.log]>->(
    2,
    'initialized default hostnames for HTTP/HTTPS routing: default, localhost, 127.0.0.1'
);

# CRITICAL FIX: Copy HTTPS handler configurations to HTTP namespace
# httpd.request_handler looks for handlers in <http.handler> namespace,
# but httpsd config defines them as <https.handler.*>
# Solution: After httpd init, copy https.handler.* to http.handler.* so lookup works
if ( defined <https.handler.get> ) {
    <http.handler.get>     = <https.handler.get>;
    <http.handler.head>    = <https.handler.head>    // <https.handler.get>;
    <http.handler.post>    = <https.handler.post>    // <https.handler.get>;
    <http.handler.options> = <https.handler.options> // <https.handler.get>;
    <[base.log]>->(
        2,
        'copied https.handler.* definitions to http.handler.* for httpd lookup'
    );
}

# HTTPSD-specific TLS configuration (added to httpd config)
<httpsd.cfg.tls_version> //= 'TLSv1_3:TLSv1_2';
<httpsd.cfg.cipher_suite>
    //= 'ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256';
<httpsd.cfg.certificate_path>        //= '/etc/protocol-7/certs/current.pem';
<httpsd.cfg.key_path>                //= '/etc/protocol-7/certs/current.key';
<httpsd.cfg.hsts_max_age>            //= 31536000;
<httpsd.cfg.hsts_include_subdomains> //= 1;

# Protocol state for HTTPS (using 'https' protocol instead of 'http')
# Create HTTPS state with httpsd.request_handler for input (overriding HTTP handler)
# CRITICAL: Include read-mode=binary to handle SSL frames properly (16KB chunks)
# CRITICAL: Include bytes-to-read=16384 to match SSL frame size limit from IO::Socket::SSL
<protocol.https.state> = {
    '0' => {
        'read-mode'     => 'binary',
        'bytes-to-read' => 16384,
        'input'  => { 'handler' => 'httpsd.request_handler' },
        'output' => { 'handler' => 'base.handler.write' }
    }
};
<protocol.https.connect.banner> = '';

<[base.logs]>->(
    2,
    "[protocol-7] configured https protocol state with httpsd.request_handler"
);

# CRITICAL FIX: Register SSL socket type and HTTPS protocol handlers
# This allows base.handler.connect to find the handlers when a TLS connection arrives

# Register IO::Socket::SSL type handlers (for listening socket)
$data{'io'}{'type'}{'ip.ssl'} = {
    'ref'     => 'IO::Socket::SSL',
    'handler' => {
        'output' => {
            'open' => 'io.ip.ssl.output.open'
            ,    # TODO: May not exist, fallback to tcp
            'close' => 'io.ip.ssl.output.close'
            ,    # TODO: May not exist, fallback to tcp
            'read'  => 'base.handler.read',
            'write' => 'base.handler.write'
        },
        'input' => {
            'open' =>
                'io.ip.ssl.input.open', # TODO: May not exist, fallback to tcp
            'close' => 'io.ip.ssl.input.close'
            ,                           # TODO: May not exist, fallback to tcp
            'connect' => 'io.ip.ssl.input.connect',    # Custom SSL handler
            'read'    => 'base.handler.read',
            'write'   => 'base.handler.write'
        }
    }
};

# Register HTTPS protocol with httpsd.request_handler bridge
# httpsd.request_handler delegates to httpd.request_handler for HTTP parsing
# TLS encryption/decryption is transparent at IO::Socket::SSL layer
$data{'protocol'}{'https'} = {
    'connect' => {
        'callback' => undef,
        'banner'   => ''
    },
    'state' => <protocol.https.state>
};

<[base.log]>->(
    2, 'registered SSL socket type (ip.ssl) and HTTPS protocol handlers'
);

# Session management for HTTPS
<httpsd.sessions>         = {};
<httpsd.connection_count> = 0;

# Performance metrics
<httpsd.metrics> = {
    handshakes_successful => 0,
    handshakes_failed     => 0,
    connections_active    => 0,
    total_bytes_encrypted => 0,
    total_bytes_decrypted => 0,
    avg_handshake_time    => 0,
};

<[base.log]>->( 2, 'HTTPSD initialization complete' );
<[base.log]>->( 2, "  TLS Version: " . <httpsd.cfg.tls_version> );
<[base.log]>->( 2, "  Certificate: " . <httpsd.cfg.certificate_path> );

0;

