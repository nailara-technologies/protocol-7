# name = models.decision.recommendation_engine
# descr = Generate ranked model recommendations for specific contexts

use List::Util qw| max |;

# Main recommendation engine
sub get_model_recommendations {
  my ($context, $constraints, $all_models) = @_;

  my $base = <[models.decision.recommendation_base]>;
  my @candidates = $base->{find_models_for_context}->($context, $all_models);

  return {
    'context' => $context,
    'recommendations' => [],
    'best_choice' => undef,
    'error' => 'No models found for context',
  } unless @candidates;

  my @scored = map {
    my $model = $_;
    my $stats = $model->{statistics}->{by_context}->{$context} // {};

    my $score = {
      model_amos => $model->{amos_checksum},
      name => $model->{metadata}->{name},
      version => $model->{metadata}->{version},
      success_rate => $stats->{success_rate} // 0,
      margin_vs_alt => $stats->{margin_vs_best_alt} // 0,
      available_locally => $model->{presence_decision}->{currently_present} // 0,
      initialization_ms => $model->{metadata}->{init_latency_ms} // 0,
      avg_inference_ms => $model->{metadata}->{avg_inference_ms} // 0,
      composite_score => $base->{calculate_composite_score}->($model, $context, $constraints),
      reasoning => $base->{generate_reasoning}->($model, $context),
    };
    $score;
  } @candidates;

  @scored = sort { $b->{composite_score} <=> $a->{composite_score} } @scored;
  @scored = $base->{filter_by_constraints}->(\@scored, $constraints);

  return {
    'context' => $context,
    'recommendations' => \@scored,
    'best_choice' => $scored[0] // undef,
    'alternatives' => [@scored[1..$#scored]],
    'count' => scalar(@scored),
  };
}

{
  'get_model_recommendations' => \&get_model_recommendations,
};

