## [:< ##

# name  = mcp.tools.chat
# descr = MCP chat tool definitions for p7 server
## pure perl only — loaded via do(), no <[...]> p7 syntax ##

sub {
    my $tools_ref = shift;

    push @$tools_ref,
        {
        'name'        => 'p7_chat_send',
        'description' =>
            'send a message to a chat channel. writes to history '
            . 'and dispatches to the active model unless -model user is specified.',
        'inputSchema' => {
            'type'       => 'object',
            'properties' => {
                'message' => {
                    'type'        => 'string',
                    'description' => 'message text to send'
                },
                'channel' => {
                    'type'        => 'string',
                    'description' =>
                        'target channel (default: current active channel)'
                },
                'model' => {
                    'type'        => 'string',
                    'description' =>
                        'target model — kimi, claude, user, or all'
                },
                'wait_reply' => {
                    'type'        => 'integer',
                    'description' =>
                        'seconds to wait for reply (omit for no wait, 0 for indefinite)'
                }
            },
            'required'             => ['message'],
            'additionalProperties' => \0
        }
        },
        {
        'name'        => 'p7_chat_read',
        'description' => 'read recent messages from a channel history. '
            . 'returns last N lines (default 20) as formatted text.',
        'inputSchema' => {
            'type'       => 'object',
            'properties' => {
                'channel' => {
                    'type'        => 'string',
                    'description' => 'channel to read (default: main)'
                },
                'lines' => {
                    'type'        => 'integer',
                    'description' =>
                        'number of recent lines to return (default 20, max 200)'
                }
            },
            'additionalProperties' => \0
        }
        },
        {
        'name'        => 'p7_chat_summary',
        'description' =>
            'get the summary for a channel. triggers coding zenka '
            . 'summarization if summary is stale or missing (lazy, blocks until done).',
        'inputSchema' => {
            'type'       => 'object',
            'properties' => {
                'channel' => {
                    'type'        => 'string',
                    'description' => 'channel to summarize (default: main)'
                },
                'all_channels' => {
                    'type'        => 'boolean',
                    'description' =>
                        'summarize all channels and return combined overview'
                }
            },
            'additionalProperties' => \0
        }
        },
        {
        'name'        => 'p7_chat_search',
        'description' => 'search chat history for a term or pattern.',
        'inputSchema' => {
            'type'       => 'object',
            'properties' => {
                'term' => {
                    'type'        => 'string',
                    'description' => 'search term (literal) or regex pattern'
                },
                'regex' => {
                    'type'        => 'boolean',
                    'description' =>
                        'treat term as regex (default false = literal)'
                },
                'channel' => {
                    'type'        => 'string',
                    'description' =>
                        'channel to search (default: active channel)'
                },
                'all_channels' => {
                    'type'        => 'boolean',
                    'description' => 'search across all channels'
                }
            },
            'required'             => ['term'],
            'additionalProperties' => \0
        }
        },
        {
        'name'        => 'p7_chat_channels',
        'description' => 'list all channels with last-active timestamps '
            . 'and summary snippets.',
        'inputSchema' => {
            'type'                 => 'object',
            'properties'           => {},
            'additionalProperties' => \0
        }
        };
    }

