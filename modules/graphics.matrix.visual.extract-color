# name  = graphics.matrix.visual.extract-color
# desc  = Extract dominant/average color from image info
#
# input : $info - image info hash
# output: [r, g, b] array

my $info = shift // {};

# Placeholder - would use actual image analysis
# For now, return gray or extract from info if available

if ( $info->{'average_color'} ) {
    return $info->{'average_color'};
}

if ( $info->{'rgb'} ) {
    return $info->{'rgb'};
}

return [ 128, 128, 128 ];    # Gray default

