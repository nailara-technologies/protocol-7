# name  = lm-vision.cmd.get_full_stderr
# descr = retrieve full stderr output for debugging

my $job_id = $call->{'args'};

unless ( defined $job_id && length $job_id ) {
    return { 'mode' => 'false', 'data' => 'job_id required' };
}

unless ( exists <lm-vision.jobs>->{$job_id} ) {
    return { 'mode' => 'false', 'data' => 'no such job' };
}

my $job = <lm-vision.jobs>->{$job_id};

unless ( defined $job->{'stderr'} && length $job->{'stderr'} ) {
    return { 'mode' => 'false', 'data' => 'no stderr captured for this job' };
}

return {
    'mode' => 'size',
    'data' => $job->{'stderr'}
};

