## [:< ##

# name  = site-yaml.cmd.search
# descr = fetch stepstone search URL, return job list YAML

my $url = $call->{'args'} // '';

## default to configured search url if none supplied
$url = $data{'site-yaml.cfg.stepstone_search_url'} // ''
    if not length $url;

return
    <[base.callback.cmd_reply]>->(
    { 'mode' => FALSE, 'data' => 'no search url configured or supplied' } )
    if not length $url;

my $jobs = <[site-yaml.stepstone.search]>->($url);

if ( ref $jobs ne 'ARRAY' ) {
    return
        <[base.callback.cmd_reply]>
        ->( { 'mode' => FALSE, 'data' => $jobs // 'search failed' } );
}

<[base.logs]>
    ->( 1, 'site-yaml.search : found %d job links', scalar @{$jobs} );

my $yaml = YAML::XS::Dump( { 'jobs' => $jobs } );

<[base.callback.cmd_reply]>->( { 'mode' => TRUE, 'data' => $yaml } );

