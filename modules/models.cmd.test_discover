# name = models.cmd.test_discover
# descr = Test discover_directory module

my $test_path = '/mnt/ext-xfs-data/models-lmstudio';

# Test 1: Check if path exists
my $exists = -d $test_path;
my $reply  = "Test Results:\n";
$reply .= "Path exists: " . ( $exists ? "YES" : "NO" ) . "\n";

if ($exists) {

    # Test 2: Call discover_directory
    @ARG = ( $test_path, 1 );
    my $result = <[models.storage.discover_directory]>;

    if ( defined $result ) {
        $reply .= "discover_directory returned: " . ref($result) . "\n";
        if ( ref($result) eq 'ARRAY' ) {
            $reply .= "Array contains " . scalar(@$result) . " items\n";
            if ( @$result > 0 ) {
                $reply .= "First item keys: "
                    . join( ", ", keys %{ $result->[0] } ) . "\n";
            }
        }
    } else {
        $reply .= "discover_directory returned undef\n";
    }
} else {
    $reply .= "Cannot test - path doesn't exist\n";
}

return { 'mode' => qw| size |, 'data' => $reply };

