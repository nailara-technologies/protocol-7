## [:< ##

# name  = format.inline-nested.encode
# descr = encode ordered key-value pairs to inline-nested text
# param = $pairs - arrayref of [ key, value ] pairs [ or hashref, sorted keys ]
#          $opts  - optional hashref { inline_path => name, nest_level => N }
# return = inline-nested text string [ bare form when no inline_path given ]

my ( $input, $opts ) = @_;
$opts //= {};

require Text::Wrap;

my @pairs;
if ( ref $input eq 'ARRAY' ) {
    @pairs = @{$input};
} elsif ( ref $input eq 'HASH' ) {
    @pairs = map { [ $_, $input->{$_} ] } sort keys %{$input};
} else {
    return '';
}

## column alignment : longest key in the whole block ##
my $max_len = 0;
foreach my $pair (@pairs) {
    next unless ref $pair eq 'ARRAY';
    my $key_len = length( $pair->[0] // '' );
    $max_len = $key_len if $key_len > $max_len;
}

my $pad = ' ' x ( $max_len + 2 );    ## separator column [ dot above ':' ] ##
my $w_prefix = $pad . ':  ';         ## continuation line prefix

## inline framing adds ' ' x $nest . ':  ' on top of every line -- reduce
## the wrap width up front so the final physical line stays <= 78 cols ##
my $use_inline
    = defined( $opts->{inline_path} )
    && length( $opts->{inline_path} )
    && $opts->{inline_path} !~ m|\n|;
my $nest     = $opts->{nest_level} // 1;
my $overhead = $use_inline ? $nest + 3 : 0;

local $Text::Wrap::columns   = 78 - $overhead;
local $Text::Wrap::separator = "\n";
local $Text::Wrap::huge      = qw| overflow |;
local $Text::Wrap::unexpand  = 0;    ## keep spaces [ no tab substitution ] ##

my $block = '';
foreach my $pair (@pairs) {
    next unless ref $pair eq 'ARRAY';
    my ( $key, $value ) = @{$pair};
    $key   //= '';
    $value //= '';
    next unless $key =~ m|^[\w\-\.]+$|;    ## strict key charset

    ## lone dot line opens the entry [ survives blank stripping ]; a
    ## trailing bare ':' closes it, symmetric with the opening dot -- this
    ## also doubles as the inter-entry separator, so no extra blank line ##
    $block .= $pad . ".\n";

    if ( not length $value ) {
        $block .= sprintf "%*s  :\n", $max_len, $key;
        $block .= $pad . ":\n";
        next;
    }

    my $k_prefix   = sprintf "%*s  :  ", $max_len, $key;
    my $first_para = 1;
    my @out_lines;

    foreach my $para ( grep {length} split m|\n\n|, $value, -1 ) {
        my $p_first = $first_para ? $k_prefix : $w_prefix;
        $first_para = 0;

        if ( index( $para, "\n" ) == -1 ) {

            ## single logical line -> greedily wrap to 78 columns ##
            push @out_lines,
                split m|\n|, Text::Wrap::wrap( $p_first, $w_prefix, $para ),
                -1;
        } else {

            ## free-format -> preserve deliberate line breaks as-is ##
            my @p_lines = split m|\n|, $para, -1;
            $p_lines[0] = $p_first . $p_lines[0];
            $p_lines[$_] = $w_prefix . $p_lines[$_] for 1 .. $#p_lines;
            push @out_lines, @p_lines;
        }
        push @out_lines, $pad . ':';    ## framed blank [ paragraph break ]
    }

    ## last paragraph-break line doubles as the entry's closing marker ##
    $block .= join '', map { $_ . "\n" } @out_lines;
}

## bare / standalone form ##
## header may be a strict dot-path [ machine key ] or a free-form title
## [ human alias, resolved to a key path by a higher layer ] -- either way
## it's a single line with no embedded newline ##
return $block if not $use_inline;

## inline / nested form : header, colon-framed lines, footer ##
my $indent = ' ' x $nest;

my @body = split m|\n|, $block, -1;
pop @body if @body and not length $body[-1];    ## trailing newline artifact

my @framed
    = ( $indent . '.:[ ' . $opts->{inline_path} . ' ]:.', $indent . ':' );
push @framed, map { length $_ ? $indent . ':  ' . $_ : $indent . ':' } @body;
## unconditional trailer-boundary marker [ empty trailer -- none defined
## yet -- immediately followed by the footer signals "no trailer" ] ##
push @framed, $indent . ':', $indent . ':.';

return join '', map { $_ . "\n" } @framed;

