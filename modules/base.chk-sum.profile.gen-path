## [:< ##

#  name  = base.chk-sum.profile.gen-path
#  descr = anti-entropic path generation profiles

my ($preset_id) = @ARG;

my $profile = {
    algo    => qw| amos |,
    modes   => [ 5, 7 ],
    offsets => [ 0, 1, 2, 3, 4, 5, 6 ],
    length  => 7,
    filter  => [ 7, 9 ],
};

if ( defined $preset_id ) {
    my $resolved
        = <[base.resolve_key]>->("chk-sum.profile.gen-path.$preset_id");
    if ( defined $resolved
        and $resolved->{'r-type'} eq qw| HASH | ) {
        my $delta = $resolved->{'r-data'};
        while ( my ( $k, $v ) = each %$delta ) {
            $profile->{$k} = $v;
        }
    }
}

return $profile;

