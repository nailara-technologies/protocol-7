# name  = window.place.apply_geometry
# descr = apply current geometry to placement window and x11 state

my ( $window, $geometry ) = @ARG;

return undef if not defined $window;
return undef if not defined $geometry;

<[window.gtk.profile.apply]>->( $window, $geometry );

<x11.window.width>       = $geometry->{'width'};
<x11.window.height>      = $geometry->{'height'};
<x11.coordinates.left>   = $geometry->{'x'};
<x11.coordinates.top>    = $geometry->{'y'};
<x11.coordinates.right>  = $geometry->{'x'} + $geometry->{'width'};
<x11.coordinates.bottom> = $geometry->{'y'} + $geometry->{'height'};

return 1;

