# name  = zulum.cmd.export-streams
# descr = export all 13 stream states to a shared JSON file
#         called periodically by zulum timer for httpd/iris to read

my %export;
for my $sid ( 1 .. 13 ) {
    my $s = <zulum.stream>->{$sid} // {};
    $export{$sid} = {
        state     => $s->{'state'}   // 0,
        entropy   => $s->{'entropy'} // ( '0' x 42 ),
        is_true   => $s->{'is_true'} ? 1 : 0,
        iteration => $s->{'iteration'} // 0,
    };
}

my $json = eval { JSON::to_json( \%export, { pretty => 0 } ) };
return undef unless defined $json;

<[file.zenka_dir.write]>->( 'streams.json', \$json );

return { 'mode' => qw| true |, 'data' => 'streams.json' };

