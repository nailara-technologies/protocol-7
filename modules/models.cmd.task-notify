## [:< ##

# name  = models.cmd.task-notify
# descr = handle task notification from task zenka

my $task_id = $call->{'args'} // '';

unless ( length $task_id ) {
    return { 'mode' => 'false', 'data' => 'task id required' };
}

<[base.logs]>->( 2, ': task-notify: new task %s', $task_id );

## claim the task via async callback chain ##
## [ jobqueue handles serialization — no active_id guard needed here ] ##
<[protocol-7.route-send]>->(
    {   'command'   => 'task.claim',
        'call_args' => { 'args' => "$task_id models" },
        'reply'     => {
            'handler' => 'models.handler.task-poll-step',
            'params'  => { 'step' => 'claimed', 'task_id' => $task_id }
        }
    }
);

return { 'mode' => 'true', 'data' => "claiming $task_id" };

