## [:< ##

# name  = channels.subscription.manager
# descr = Manage automatic channel subscriptions based on zenka configuration
# args  = hash { zenka_name, config_mappings }
# return = hash { subscribed => count, errors => [...] }

my $args_ref = shift;
return { 'subscribed' => 0, 'errors' => ['no configuration provided'] }
    unless defined $args_ref and ref $args_ref eq qw| HASH |;

my $zenka_name = $args_ref->{'zenka_name'}      // 'unknown';
my $mappings   = $args_ref->{'config_mappings'} // [];

return { 'subscribed' => 0, 'errors' => ['no mappings provided'] }
    unless ref $mappings eq 'ARRAY' and @{$mappings};

my $subscribed_count = 0;
my @errors;

##  Initialize zenka subscription table if not present  ##
<channels.zenka_subscriptions> //= {};
<channels.zenka_subscriptions>->{$zenka_name} //= {
    'subscriptions' => [],
    'subscribed_at' => <[base.ntime]>,
    'status'        => 'ACTIVE',
    'error_count'   => 0
};

my $zenka_entry = <channels.zenka_subscriptions>->{$zenka_name};

##  Process each mapping  ##
foreach my $mapping ( @{$mappings} ) {
    next unless defined $mapping and ref $mapping eq qw| HASH |;

    my $channel_path   = $mapping->{'channel_path'};
    my $source_channel = $mapping->{'source_channel'};
    my $map_rules      = $mapping->{'map_rules'} // [];

    ##  Skip invalid mappings  ##
    unless ( length $channel_path and length $source_channel ) {
        push @errors, "incomplete mapping (missing channel or source)";
        $zenka_entry->{'error_count'}++;
        next;
    }

    ##  Create subscription entry  ##
    my $subscription_id = "${zenka_name}_" . <[base.gen_id]>->( {} );

    push @{ $zenka_entry->{'subscriptions'} },
        {
        'subscription_id' => $subscription_id,
        'channel_path'    => $channel_path,
        'source_channel'  => $source_channel,
        'map_rules'       => $map_rules,
        'subscribed_at'   => <[base.ntime]>,
        'status'          => 'ACTIVE',
        'last_sync'       => undef,
        'last_error'      => undef
        };

    ## Subscribe to source channel if not already subscribed (In ##
    ## production, routes through cube to channels zenka)        ##

    <[base.logs]>->(
        1, "channels: %s subscribed to '%s' (mapped to '%s')",
        $zenka_name, $source_channel, $channel_path
    );

    $subscribed_count++;
}

##  Log summary  ##
<[base.logs]>->(
    1,
    "channels: subscription manager configured "
        . "%d mappings for '%s' (errors: %d)",
    $subscribed_count,
    $zenka_name,
    scalar @errors
);

return {
    'subscribed' => $subscribed_count,
    'errors'     => @errors ? \@errors : undef
};

1;

