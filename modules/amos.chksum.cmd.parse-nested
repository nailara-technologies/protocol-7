## [:< ##

# name  = amos.chksum.cmd.parse-nested
# descr = parse [child:parent] checksum notation
# param = <[child:parent]>

my $notation = $call->{'args'} // '';

return {
    'mode' => qw| false |,
    'data' => 'expected [child:parent] notation'
    }
    if not length $notation;

my $parsed = AMOS7::CHKSUM::Nested::parse_nested($notation);

return {
    'mode' => qw| false |,
    'data' => 'notation not valid'
    }
    if not defined $parsed;

return {
    'mode' => qw| true |,
    'data' => sprintf(
        'child: %s, parent: %s',
        $parsed->{'child'}, $parsed->{'parent'}
    )
};

