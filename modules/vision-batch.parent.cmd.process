## [:< ##

# name = vision-batch.parent.cmd.process
# descr = Submit batch job for processing (expects YAML path as parameter)

# Extract parameter from command args
# Automatic code header provides $call->{'args'} with space-separated arguments
my $_call = shift;
my $yaml_path;
if ( defined $_call && ref($_call) eq qw|HASH| && defined $_call->{'args'} ) {

    # Extract first argument from space-separated args string
    $yaml_path = ( split m|\s+|, $_call->{'args'} )[0];
}

return { 'mode' => qw| FALSE |, 'data' => 'YAML batch file path required' }
    unless defined $yaml_path;
return { 'mode' => qw| FALSE |, 'data' => 'Path cannot be empty' }
    if $yaml_path eq '';

# Call the main vision-batch.parent.process module
my $result = <[vision-batch.parent.process]>->($yaml_path);

# Ensure result is valid before returning
return {
    'mode' => qw| FALSE |,
    'data' => 'Invalid result from batch process'
    }
    unless defined $result && ref($result) eq qw| HASH |;

# Return with proper network format
if ( $result->{success} ) {

    # Return as YAML string for human-readable output
    <[base.perlmod.load]>->( 'YAML::XS', qw| Dump | );
    my $yaml = YAML::XS::Dump($result);
    return { 'mode' => qw| TRUE |, 'data' => $yaml };
} else {
    return {
        'mode' => qw| FALSE |,
        'data' => $result->{error} // 'Batch processing failed'
    };
}

