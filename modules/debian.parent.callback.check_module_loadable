# name  = debian.parent.callback.check_module_loadable
# descr = Check if a perl module is loadable

my $module = shift;

## Try to load the module
eval {
    local $SIG{__DIE__}  = sub { };
    local $SIG{__WARN__} = sub { };
    require $module =~ s|::|/|gr . '.pm';
};

return $@ ? 0 : 1;

