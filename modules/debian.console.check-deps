## [:< ##

# name  = debian.console.check-deps
# param = [zenka=<name>]
# descr = check dependency status for zenka or all zenki

my $param = shift;
my $zenka_filter;

if (defined $param) {
    if ($param =~ m/^zenka=(.+)$/) {
        $zenka_filter = $1;
    } else {
        $zenka_filter = $param;
    }
}

## Rescan to ensure latest info
<[base.log]>->( 2, "Rescanning zenki dependencies..." );
<[debian.parent.scan_zenki_dependencies]>();

## Run check
<[base.log]>->( 2, "Checking installation status..." );
my $result = <[debian.parent.check_installed]>();

unless ($result->{success}) {
    <[base.log]>->( 0, "Check failed: " . ($result->{error} || 'unknown') );
    return say "::\n: ✗ Check failed\n::";
}

## Display results
my @output;

push @output, "::";
push @output, ": Dependency Check Results";
push @output, ":";

if ($zenka_filter) {
    ## Show specific zenka
    my $zenka_id = $data{'debian'}{'zenki_deps'}{'by_zenka'}{$zenka_filter};

    unless ($zenka_id) {
        push @output, ": Error: zenka '$zenka_filter' not found";
        push @output, "::";
        return say join("\n", @output);
    }

    my $zenka = $data{'debian'}{'zenki_deps'}{'registry'}{$zenka_id};

    push @output, sprintf(": Zenka: %s", $zenka_filter);
    push @output, ":";

    my $pm_missing = 0;
    foreach my $pm (@{$zenka->{pm_deps} || []}) {
        my $mod_id = $data{'debian'}{'cpan_modules'}{'by_name'}{$pm};
        if ($mod_id) {
            my $mod = $data{'debian'}{'cpan_modules'}{'registry'}{$mod_id};
            $pm_missing++ if $mod->{status} eq 'missing';
        }
    }

    my $os_missing = 0;
    foreach my $os (@{$zenka->{os_deps} || []}) {
        my $pkg_id = $data{'debian'}{'packages'}{'by_name'}{$os};
        if ($pkg_id) {
            my $pkg = $data{'debian'}{'packages'}{'registry'}{$pkg_id};
            $os_missing++ if $pkg->{status} eq 'missing';
        }
    }

    push @output, sprintf(":   PM deps: %d total, %d missing",
        $zenka->{pm_deps_count} || 0, $pm_missing);
    push @output, sprintf(":   OS deps: %d total, %d missing",
        $zenka->{os_deps_count} || 0, $os_missing);
    push @output, ":";

    if ($pm_missing + $os_missing == 0) {
        push @output, ":   ✓ All dependencies satisfied";
    } else {
        push @output, sprintf(":   ✗ %d dependencies missing",
            $pm_missing + $os_missing);
        push @output, ":";
        push @output, ":   To install: install-deps $zenka_filter";
    }

} else {
    ## Show summary
    push @output, sprintf(": Debian Packages: %d installed, %d missing",
        $result->{installed_pkgs} || 0, $result->{missing_pkgs} || 0);
    push @output, sprintf(": CPAN Modules: %d installed, %d missing",
        ($result->{checked_modules} || 0) - ($result->{missing_modules} || 0),
        $result->{missing_modules} || 0);
    push @output, ":";
    push @output, sprintf(": Zenki scanned: %d",
        $data{'debian'}{'stats'}{'zenki_scanned'} || 0);
    push @output, sprintf(": Total missing: %d",
        $data{'debian'}{'stats'}{'missing_deps'} || 0);
}

push @output, "::";

return say join("\n", @output);

