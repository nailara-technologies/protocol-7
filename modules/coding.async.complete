## [:< ##

# name  = coding.async.complete
# descr = handle completion of async coding task
# purpose = Phase 1: Callback when deferred inference finishes

my ( $task_id, $result ) = @ARG;

return { success => FALSE, error => 'task_id required' }
    unless defined $task_id;

## retrieve stored state ##
my $state = <[coding.async.state_manager]>->( 'get', $task_id );

return { success => FALSE, error => "no state for task $task_id" }
    unless defined $state;

my $job_id = $state->{'job_id'};

## release backend lock : wakes next queued task if any ##
my $backend = $state->{'backend'} // '';
<[coding.async.backend_release]>->( $task_id, $backend ) if length $backend;

## save conversation state before cleanup ##
##    : needed for task-append resumption ##
my $task_rec = <coding.task.queue>->{$task_id};
if ( defined $task_rec ) {
    $task_rec->{'execution'}->{'messages'} = $state->{'messages'}
        if defined $state->{'messages'};
    $task_rec->{'execution'}->{'tools'} = $state->{'tools'}
        if defined $state->{'tools'};
}

## clean up async state ##
<[coding.async.state_manager]>->( 'delete', $task_id );

## handle completion (mirrors coding.task.execute logic) ##
if ( defined $result && $result->{'success'} ) {
    my $result_text = $result->{'result'} // '';

    ## move job to completed ##
    <[jobqueue.move_job]>->( $job_id, 'completed' )
        if defined $job_id;

    ## skip lifecycle hooks for internal compaction subtasks ##
    my $is_compaction
        = ( ( <coding.task.queue>->{$task_id} // {} )->{'metadata'} // {} )
        ->{'is_compaction'} // 0;

    ## complete the task ##
    <[coding.task.complete]>->( $task_id, $result_text )
        unless $is_compaction;

    ## resume parent if this task is a subtask ##
    my $parent_id = <coding.task.parent>->{$task_id};
    if ( defined $parent_id ) {
        my $parent_state
            = <[coding.async.state_manager]>->( qw| get |, $parent_id );
        if (    defined $parent_state
            and $parent_state->{'state'} eq qw| subtask |
            and ( $parent_state->{'pending_subtask'} // '' ) eq $task_id ) {

            ## compaction sub-task: splice summary into messages, no user msg ##
            if ( ( $parent_state->{'compaction_pending'} // '' ) eq $task_id )
            {
                my $c_start     = $parent_state->{'compact_start'} // 2;
                my $c_end       = $parent_state->{'compact_end'}   // 2;
                my $msgs        = $parent_state->{'messages'};
                my $round       = $parent_state->{'round'} // 0;
                my $n_compacted = $c_end - $c_start;

                if ( $n_compacted > 0 and $c_end <= scalar @{$msgs} ) {
                    splice @{$msgs}, $c_start, $n_compacted,
                        {
                        'role'    => 'assistant',
                        'content' => "[ compaction summary | round $round ]\n"
                            . $result_text,
                        };
                    <[base.logs]>->(
                        1, "[%s] compaction applied : msgs : %d -> 1",
                        $parent_id, $n_compacted
                    );
                }
                delete $parent_state->{'compaction_pending'};
                delete $parent_state->{'compact_start'};
                delete $parent_state->{'compact_end'};
                ## prevent re-triggering on same round ##
                ##             if still near threshold ##
                $parent_state->{'compaction_applied_round'} = $round;
            } else {
                ## regular subtask: append result as user message ##
                push @{ $parent_state->{'messages'} },
                    {
                    'role'    => 'user',
                    'content' => "[SUBTASK RESULT: $task_id]\n\n"
                        . $result_text
                    };
            }

            ## check subtask queue for more work ##
            my $queue = <coding.task.subtask_queue>->{$parent_id} // [];
            ## remove completed subtask from front of queue ##
            while ( @$queue && $queue->[0] eq $task_id ) {
                shift @$queue;
            }
            <coding.task.subtask_queue>->{$parent_id} = $queue;

            if (@$queue) {
                ## check if parent was stopped while this subtask ran ##
                my $parent_task_rec = <coding.task.queue>->{$parent_id};
                if ( defined $parent_task_rec
                    && $parent_task_rec->{'stop_requested'} ) {
                    <[base.logs]>->(
                        1,
                        "async.complete: parent %s was stopped,"
                            . " clearing %d remaining subtask(s)",
                        $parent_id,
                        scalar @$queue
                    );
                    ## clear remaining queue so they don't start later ##
                    for my $orphan_id (@$queue) {
                        my $orphan = delete <coding.task.queue>->{$orphan_id};
                        if ( defined $orphan ) {
                            $orphan->{'execution'}->{'status'}
                                = qw| cancelled |;
                            push @{ <coding.task.completed> //= [] },
                                $orphan_id;
                        }
                        delete <coding.task.parent>->{$orphan_id};
                    }
                    <coding.task.subtask_queue>->{$parent_id} = [];
                    $parent_state->{'pending_subtask'} = undef;
                    $parent_state->{'state'}           = qw| streaming |;
                    <coding.async.task_state>->{$parent_id} = $parent_state;
                } else {
                    my $next_subtask = $queue->[0];
                    $parent_state->{'pending_subtask'} = $next_subtask;
                    ## stay in subtask state : next queued task will run ##
                    <coding.async.task_state>->{$parent_id} = $parent_state;
                    ## enqueue the next subtask so the task queue picks it up ##
                    ## [ remove from queue first to avoid duplicate rejection ] ##
                    my $next_task
                        = delete <coding.task.queue>->{$next_subtask};
                    if ( defined $next_task ) {
                        my $enq = <[coding.task.enqueue]>->($next_task);
                        if ( !$enq->{'success'} ) {
                            ## restore if enqueue failed ##
                            <coding.task.queue>->{$next_subtask} = $next_task;
                            <[base.logs]>->(
                                0,
                                "async.complete: enqueue of %s failed: %s",
                                $next_subtask,
                                $enq->{'error'} // 'unknown'
                            );
                        }
                    } else {
                        <[base.logs]>->(
                            0,
                            "async.complete: next subtask %s not found in queue",
                            $next_subtask
                        );
                    }
                    <[base.logs]>->(
                        1,
                        "async.complete: parent %s starting next queued subtask %s",
                        $parent_id,
                        $next_subtask
                    );
                }
            } else {
                $parent_state->{'pending_subtask'} = undef;
                ## transition parent from subtask back to streaming ##
                $parent_state->{'state'} = qw| streaming |;
                <coding.async.task_state>->{$parent_id} = $parent_state;
                <[coding.task.enqueue_round]>->(
                    $parent_id, $parent_state->{'round'}
                );
                <[base.logs]>->(
                    1, "async.complete: resumed parent %s from subtask %s",
                    $parent_id, $task_id
                );
            }
        } elsif ( defined $parent_state
            and $parent_state->{'state'} eq qw| subtask | ) {
            <[base.logs]>->(
                1,
                "async.complete: subtask %s completed"
                    . " but parent %s waits for %s",
                $task_id,
                $parent_id,
                $parent_state->{'pending_subtask'} // qw| none |
            );
        }
    }

    <[base.logs]>->( 2, "async.complete: task %s completed", $task_id );

    return { success => TRUE, task_id => $task_id };
} else {
    my $error_msg = $result->{'error'} // 'unknown error';
    my $err_short = <[base.parser.center_ellipse_string]>->( $error_msg, 72 );

    <[base.logs]>->(
        0,        "async.complete: task %s failed: %s",
        $task_id, $err_short
    );

    ## move job to error ##
    <[jobqueue.move_job]>->( $job_id, qw| error | )
        if defined $job_id;

    ## mark task failed and remove from active/pending lists ##
    ## coding.task.fail has a P7 data-path bug, so we inline this ##
    my $task_obj_fail = <coding.task.queue>->{$task_id};
    if ( defined $task_obj_fail ) {
        $task_obj_fail->{'execution'}->{'status'}    = qw| failed |;
        $task_obj_fail->{'execution'}->{'error'}     = $error_msg;
        $task_obj_fail->{'execution'}->{'failed_at'} = <[base.time]>->(3);
    }
    my $aref_pending_f = <coding.task.pending> // [];
    my $aref_active_f  = <coding.task.active>  // [];
    $aref_pending_f->@* = grep { $ARG ne $task_id } $aref_pending_f->@*;
    $aref_active_f->@*  = grep { $ARG ne $task_id } $aref_active_f->@*;

    ## fire any deferred reply waiting on this task (ask-reply, etc.) ##
    my $deferred_replies = $data{'coding'}{'deferred_replies'} // {};
    for my $did ( keys %{$deferred_replies} ) {
        my $dr = $deferred_replies->{$did};
        if ( defined $dr && ( $dr->{'task_id'} // '' ) eq $task_id ) {
            <[coding.handler.deferred_reply]>->($did);
            last;
        }
    }

    ## notify parent if this task is a subtask ##
    my $parent_id_fail = <coding.task.parent>->{$task_id};
    if ( defined $parent_id_fail ) {
        my $parent_state
            = <[coding.async.state_manager]>->( qw| get |, $parent_id_fail );
        if (    defined $parent_state
            and $parent_state->{'state'} eq qw| subtask |
            and ( $parent_state->{'pending_subtask'} // '' ) eq $task_id ) {
            push @{ $parent_state->{'messages'} },
                {
                'role'    => 'user',
                'content' => "[SUBTASK FAILED: $task_id]\n\n" . $error_msg
                };

            ## check subtask queue for more work ##
            my $queue = <coding.task.subtask_queue>->{$parent_id_fail} // [];
            while ( @$queue && $queue->[0] eq $task_id ) {
                shift @$queue;
            }
            <coding.task.subtask_queue>->{$parent_id_fail} = $queue;

            if (@$queue) {
                ## check if parent was stopped while this subtask ran ##
                my $parent_task_rec = <coding.task.queue>->{$parent_id_fail};
                if ( defined $parent_task_rec
                    && $parent_task_rec->{'stop_requested'} ) {
                    <[base.logs]>->(
                        1,
                        "async.complete: parent %s was stopped,"
                            . " clearing %d remaining subtask(s) after failure",
                        $parent_id_fail,
                        scalar @$queue
                    );
                    for my $orphan_id (@$queue) {
                        my $orphan = delete <coding.task.queue>->{$orphan_id};
                        if ( defined $orphan ) {
                            $orphan->{'execution'}->{'status'}
                                = qw| cancelled |;
                            push @{ <coding.task.completed> //= [] },
                                $orphan_id;
                        }
                        delete <coding.task.parent>->{$orphan_id};
                    }
                    <coding.task.subtask_queue>->{$parent_id_fail} = [];
                    $parent_state->{'pending_subtask'} = undef;
                    $parent_state->{'state'}           = qw| streaming |;
                    <coding.async.task_state>->{$parent_id_fail}
                        = $parent_state;
                } else {
                    my $next_subtask = $queue->[0];
                    $parent_state->{'pending_subtask'} = $next_subtask;
                    ## stay in subtask state : next queued task will run ##
                    <coding.async.task_state>->{$parent_id_fail}
                        = $parent_state;
                    ## enqueue the next subtask so the task queue picks it up ##
                    ## [ remove from queue first to avoid duplicate rejection ] ##
                    my $next_task
                        = delete <coding.task.queue>->{$next_subtask};
                    if ( defined $next_task ) {
                        my $enq = <[coding.task.enqueue]>->($next_task);
                        if ( !$enq->{'success'} ) {
                            ## restore if enqueue failed ##
                            <coding.task.queue>->{$next_subtask} = $next_task;
                            <[base.logs]>->(
                                0,
                                "async.complete: enqueue of %s failed : %s",
                                $next_subtask,
                                $enq->{'error'} // qw| unknown |
                            );
                        }
                    } else {
                        <[base.logs]>->(
                            0,
                            "async.complete: next subtask %s not found in queue",
                            $next_subtask
                        );
                    }
                    <[base.logs]>->(
                        1,
                        "async.complete: parent %s starting"
                            . " next queued subtask %s after failure",
                        $parent_id_fail,
                        $next_subtask
                    );
                }
            } else {
                $parent_state->{'pending_subtask'} = undef;
                ## transition parent from subtask back to streaming ##
                $parent_state->{'state'} = qw| streaming |;
                <coding.async.task_state>->{$parent_id_fail} = $parent_state;
                <[coding.task.enqueue_round]>->(
                    $parent_id_fail, $parent_state->{'round'}
                );
                <[base.logs]>->(
                    1,
                    "async.complete: resumed parent"
                        . " %s after subtask %s failed",
                    $parent_id_fail,
                    $task_id
                );
            }
        } elsif ( defined $parent_state
            and $parent_state->{'state'} eq qw| subtask | ) {
            <[base.logs]>->(
                1,
                "async.complete: subtask %s failed but parent %s waits for %s",
                $task_id,
                $parent_id_fail,
                $parent_state->{'pending_subtask'} // qw| none |
            );
        }
    }

    return { success => FALSE, error => $error_msg, task_id => $task_id };
}

