## [:< ##

# name  = coding.async.complete
# descr = handle completion of async coding task
# purpose = Phase 1: Callback when deferred inference finishes

my ( $task_id, $result ) = @ARG;

return { success => FALSE, error => 'task_id required' }
    unless defined $task_id;

## retrieve stored state ##
my $state = <[coding.async.state_manager]>->( 'get', $task_id );

return { success => FALSE, error => "no state for task $task_id" }
    unless defined $state;

my $job_id = $state->{'job_id'};

## release backend lock before deleting state ##
## [ http_complete may see deleted state and skip lock release ] ##
my $backend = $state->{'backend'} // '';
if ( length $backend ) {
    my $lock = <coding.async.backend_busy>->{$backend};
    if (   defined $lock
        && ref($lock) eq qw| HASH |
        && $lock->{'task_id'} eq $task_id ) {
        delete <coding.async.backend_busy>->{$backend};
        <[base.logs]>->(
            1,        "async.complete: released %s lock for %s",
            $backend, $task_id
        );
    }
}

## clean up async state ##
<[coding.async.state_manager]>->( 'delete', $task_id );

## handle completion (mirrors coding.task.execute logic) ##
if ( defined $result && $result->{'success'} ) {
    my $result_text = $result->{'result'} // '';

    ## move job to completed ##
    <[jobqueue.move_job]>->( $job_id, 'completed' )
        if defined $job_id;

    ## complete the task ##
    <[coding.task.complete]>->( $task_id, $result_text );

    ## resume parent if this task is a subtask ##
    my $parent_id = <coding.task.parent>->{$task_id};
    if ( defined $parent_id ) {
        my $parent_state
            = <[coding.async.state_manager]>->( qw| get |, $parent_id );
        if (    defined $parent_state
            and $parent_state->{'state'} eq qw| subtask |
            and ( $parent_state->{'pending_subtask'} // '' ) eq $task_id ) {
            push @{ $parent_state->{'messages'} },
                {
                'role'    => 'user',
                'content' => "[SUBTASK RESULT: $task_id]\n\n" . $result_text
                };
            $parent_state->{'pending_subtask'} = undef;
            ## transition parent from subtask back to streaming ##
            $parent_state->{'state'} = qw| streaming |;
            <coding.async.task_state>->{$parent_id} = $parent_state;
            <[coding.task.enqueue_round]>->(
                $parent_id, $parent_state->{'round'}
            );
            <[base.logs]>->(
                1, "async.complete: resumed parent %s from subtask %s",
                $parent_id, $task_id
            );
        } elsif ( defined $parent_state
            and $parent_state->{'state'} eq qw| subtask | ) {
            <[base.logs]>->(
                1,
                "async.complete: subtask %s completed but parent %s waits for %s",
                $task_id,
                $parent_id,
                $parent_state->{'pending_subtask'} // 'none'
            );
        }
    }

    <[base.logs]>->( 2, "async.complete: task %s completed", $task_id );

    return { success => TRUE, task_id => $task_id };
} else {
    my $error_msg = $result->{'error'} // 'unknown error';
    my $err_short = <[base.parser.center_ellipse_string]>->( $error_msg, 72 );

    <[base.logs]>->(
        0,        "async.complete: task %s failed: %s",
        $task_id, $err_short
    );

    ## move job to error ##
    <[jobqueue.move_job]>->( $job_id, 'error' )
        if defined $job_id;

    ## fail the task ##
    <[coding.task.fail]>->( $task_id, $error_msg );

    ## notify parent if this task is a subtask ##
    my $parent_id_fail = <coding.task.parent>->{$task_id};
    if ( defined $parent_id_fail ) {
        my $parent_state
            = <[coding.async.state_manager]>->( qw| get |, $parent_id_fail );
        if (    defined $parent_state
            and $parent_state->{'state'} eq qw| subtask |
            and ( $parent_state->{'pending_subtask'} // '' ) eq $task_id ) {
            push @{ $parent_state->{'messages'} },
                {
                'role'    => 'user',
                'content' => "[SUBTASK FAILED: $task_id]\n\n" . $error_msg
                };
            $parent_state->{'pending_subtask'} = undef;
            ## transition parent from subtask back to streaming ##
            $parent_state->{'state'} = qw| streaming |;
            <coding.async.task_state>->{$parent_id_fail} = $parent_state;
            <[coding.task.enqueue_round]>->(
                $parent_id_fail, $parent_state->{'round'}
            );
            <[base.logs]>->(
                1,
                "async.complete: resumed parent %s after subtask %s failed",
                $parent_id_fail, $task_id
            );
        } elsif ( defined $parent_state
            and $parent_state->{'state'} eq qw| subtask | ) {
            <[base.logs]>->(
                1,
                "async.complete: subtask %s failed but parent %s waits for %s",
                $task_id,
                $parent_id_fail,
                $parent_state->{'pending_subtask'} // 'none'
            );
        }
    }

    return { success => FALSE, error => $error_msg, task_id => $task_id };
}

