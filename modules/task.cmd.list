## [:< ##

# name  = task.cmd.list
# descr = list tasks — queue + history by priority

my @entries;

## live queue — all statuses ##
foreach my $task_id ( @{<task.queue.order>} ) {
    my $task = <task.queue>->{$task_id};
    next unless defined $task;
    my $priority = <[valued.resolve]>->( $task->{'node_id'} // '' ) // 0.0;
    push @entries, { id => $task_id, task => $task, priority => $priority };
}

## recent history — done/failed ##
foreach my $task_id ( keys %{<task.history>} ) {
    my $task = <task.history>->{$task_id};
    next unless defined $task;
    push @entries, { id => $task_id, task => $task, priority => -1.0 };
}

return { mode => qw| false |, data => 'no tasks' } unless @entries;

## sort: live by priority desc, history at bottom ##
@entries = sort {
           $b->{'priority'} <=> $a->{'priority'}
        || $a->{'task'}{'created_at'} cmp $b->{'task'}{'created_at'}
} @entries;

my $output = '';
foreach my $e (@entries) {
    my $task   = $e->{'task'};
    my $status = $task->{'status'}      // '?';
    my $desc   = $task->{'description'} // '';
    $desc = substr( $desc, 0, 57 ) . '...' if length $desc > 60;
    $output .= sprintf "%-7s  %-11s  %s\n", $e->{'id'}, $status, $desc;
}

return { 'mode' => 'size', 'data' => $output };

