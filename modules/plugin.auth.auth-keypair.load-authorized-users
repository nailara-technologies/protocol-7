# name    = plugin.auth.auth-keypair.load-authorized-users
# descr   = load authorized remote user public keys from .n/remote-keys/authorized/<zenka>/
# return  = count of loaded keys, or undef on error

my $zenka_name = <system.zenka.name>;
my $key_vars_ref = <[crypt.C25519.key_vars]>->();
my $auth_base_dir = $key_vars_ref->{'auth_dir'};
my $auth_key_dir = catfile( $auth_base_dir, $zenka_name );

return 0 unless -d $auth_key_dir;

$keys{'authorized-remote'} //= {};
my $loaded_count = 0;

## Scan directory for <user>.public files
if ( opendir( my $dh, $auth_key_dir ) ) {
    foreach my $filename ( sort readdir($dh) ) {
        next if $filename =~ m/^\./;  ## skip . and ..
        next unless $filename =~ m/\.public$/;

        my $username = $filename;
        $username =~ s/\.public$//;

        my $pubkey_file = catfile( $auth_key_dir, $filename );
        my $pubkey_b32 = <[file.slurp]>->($pubkey_file)->$*;

        if ( defined $pubkey_b32 and length $pubkey_b32 > 0 ) {
            chomp $pubkey_b32;

            ## Validate it's a valid base32 string
            my $pubkey_bin = eval { Crypt::Misc::decode_b32r($pubkey_b32) };
            if ( defined $pubkey_bin and length $pubkey_bin == 32 ) {
                $keys{'authorized-remote'}{$username} = {
                    'public_b32' => $pubkey_b32,
                    'public'     => $pubkey_bin,
                    'loaded_at'  => <[base.time]>->(3),
                };
                $loaded_count++;
                <[base.logs]>->( 2, ": authorized remote user '%s' loaded", $username );
            } else {
                <[base.logs]>->( 1, ": invalid key format for '%s' [ %s ]", $username, $pubkey_file );
            }
        } else {
            <[base.logs]>->( 1, ": empty key file [ %s ]", $filename );
        }
    }
    closedir($dh);
}

if ( $loaded_count > 0 ) {
    <[base.logs]>->( 1, ": loaded %d authorized remote user(s) for '%s'", $loaded_count, $zenka_name );
}

return $loaded_count;

