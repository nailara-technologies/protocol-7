## [:< ##

# name  = user-edit.form.add_field
# descr = add the field the add-a-field row currently offers
# param = -none-

## Enter on the add-a-field row turns the chosen option into a REAL field :
## the row is replaced by it, and a fresh row offering what is left appears
## below -- so adding several fields is one keystroke each with no menu.
##
## rebuilds through editor.control.create rather than patching the two
## structures, the same move editor.control.list.expand makes, and for the
## same reason : there is no add/remove-field primitive, and recreating reuses
## every guard create already has.
##
## the new field's STARTING SHAPE comes from the authority's vocabulary [
## users.record.optional_fields, over the wire as users.cmd.field-options'
## '<name> <shape>' pairs ] : a field declared as a list starts as a
## collapsible list, exactly as one read back from a record does.  the shape
## used to be assumed to be a line here, which stored a list-shaped field as a
## scalar and silently lost the declaration.

my $editor_state = <user-edit.form.state>;

return FALSE if ref $editor_state ne qw| HASH |;

my ($row_def)
    = grep { $ARG->{'add_field'} }
    ( $editor_state->{'schema'}{'fields'} // [] )->@*;

return FALSE if ref $row_def ne qw| HASH |;
return FALSE if ref $row_def->{'choices'} ne qw| ARRAY |;

my @choices = $row_def->{'choices'}->@*;
my $chosen  = $choices[ $row_def->{'choice'} // 0 ];

return FALSE if not defined $chosen or not length $chosen;

## rebuild : every existing field with its CURRENT value, the chosen field as
## a new empty one, then a fresh add-a-field row if anything is left
my @fields;

foreach my $field_def ( $editor_state->{'schema'}{'fields'}->@* ) {

    my $name = $field_def->{'name'} // next;

    next if $field_def->{'add_field'};

    push @fields,
        {
        %{$field_def},
        $field_def->{'list'}
        ? ()
        : ( qw| default | =>
                <[editor.control.get_value]>->( $editor_state, $name ) // '' )
        };
}

## the LIST shape, built exactly as user-edit.form.schema_from_record builds
## one from an array-valued record field -- 'list' is metadata on the def and
## 'entries' is the authoritative value, while the type stays freeform_line
## because editor.control.create accepts no other
my $shape = ( <user-edit.form.field_options> // {} )->{$chosen} // qw| line |;

push @fields,
    $shape eq qw| list |
    ? {
    qw| name |          => $chosen,
    qw| type |          => qw| freeform_line |,
    qw| default |       => '',
    qw| list |          => TRUE,
    qw| entries |       => [],
    qw| noun |          => qw| entr |,
    qw| noun_plural |   => qw| ies |,
    qw| noun_singular | => qw| y |,
    }
    : {
    qw| name |    => $chosen,
    qw| type |    => qw| freeform_line |,
    qw| default | => '',
    };

my $new_state = <[editor.control.create]>
    ->( { qw| fields | => \@fields, qw| active_field | => 0 } );

return FALSE if not defined $new_state;

$new_state->{'kill_buffer'} = $editor_state->{'kill_buffer'} // '';
$new_state->{'mode'}        = qw| insert |;
$new_state->{'title'}       = $editor_state->{'title'};

## what is left to offer is recomputed from the vocabulary against the NEW
## schema, not carried over as the old choice list minus one -- the same
## answer today, and the only one that stays right once fields can come back
<[user-edit.form.add_field_row]>->(
    $new_state, <[user-edit.form.addable_fields]>->($new_state)
);

## focus the field just added, by NAME -- active_field is an index and the
## count just changed
my $position = 0;
foreach my $field_def ( $new_state->{'schema'}{'fields'}->@* ) {
    $new_state->{'active_field'} = $position, last
        if ( $field_def->{'name'} // '' ) eq $chosen;
    $position++;
}

<user-edit.form.state> = $new_state;

## a LIST field added this way opens EXPANDED, exactly as one does when focus
## arrives on it by any other route -- otherwise the field you just asked for
## sits there reading '.. no entries ..' with nowhere to type
<[user-edit.form.sync_list_mode]>;
$new_state = <user-edit.form.state>;

<[user-edit.form.build_frame]>->(
    $new_state,
    <user-edit.form.frame_name> // qw| user-edit-form |,
    $new_state->{'title'} // <user-edit.form.title>
);

return TRUE;

