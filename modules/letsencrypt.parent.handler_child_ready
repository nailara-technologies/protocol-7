# name  = letsencrypt.parent.handler_child_ready
# descr = Handle child process ready notification - completes parent initialization

my $msg = shift;

my $child_pid = $msg->{pid};

<[base.log]>->(
    2, "letsencrypt parent: child process ready (PID: $child_pid)"
);

## Check for any pending operations
<[letsencrypt.parent.process_pending_ops]>->()
    if defined <[letsencrypt.parent.process_pending_ops]>;

