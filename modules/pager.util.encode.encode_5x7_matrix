# name  = pager.util.encode.encode_5x7_matrix
# descr = Encode item as 5x7 matrix coordinates

my ( $item, $bits ) = @ARG;

my $value = oct( '0b' . $bits );
my $x     = $value % 5;
my $y     = int( $value / 5 ) % 7;

return { 'x' => $x, 'y' => $y, 'set' => 1 };

