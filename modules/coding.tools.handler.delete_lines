## [:< ##

# name  = coding.tools.handler.delete_lines
# descr = delete a line range from file by line numbers

my $args  = shift            // {};
my $path  = $args->{'path'}  // return 'error : path required';
my $from  = $args->{'from'}  // return 'error : from line required';
my $to    = $args->{'to'}    // $from;
my $apply = $args->{'apply'} // TRUE;

## resolve and sanitize path — no Cwd, use string check ##
return 'error: path traversal not allowed' if $path =~ m{\.\.};
my $root     = <system.root_path>;
my $abs_path = "$root/$path";
return 'error: file not found' unless -f $abs_path;

my $from_n = int($from);
my $to_n   = int($to);
return 'error: from must be >= 1'  if $from_n < 1;
return 'error: to must be >= from' if $to_n < $from_n;

## read file into lines ##
my $content = <[file.read]>->( $abs_path, ':encoding(UTF-8)' );
return 'error: cannot read file' unless defined $content;
my @lines = split /^/m, $content;

return sprintf 'error: from %d out of range [1..%d]', $from_n, scalar @lines
    if $from_n > scalar @lines;
$to_n = scalar @lines if $to_n > scalar @lines;

my $count = $to_n - $from_n + 1;

if ($apply) {
    splice @lines, $from_n - 1, $count;

    ## use chmod child for write access if needed ##
    my $chmod_fh = <coding.chmod_child.w_fh>;
    my $mode_restore;
    if ( !-w $abs_path and defined $chmod_fh ) {
        my $cur_mode = ( stat $abs_path )[2] & 07777;
        print {$chmod_fh} "gw $abs_path\n";
        $mode_restore = $cur_mode if -w $abs_path;
    }

    if ( -w $abs_path ) {
        <[base.file.write_encoded]>
            ->( ':encoding(UTF-8)', $abs_path, @lines );
        if ( defined $mode_restore and defined $chmod_fh ) {
            print {$chmod_fh} sprintf "restore %04o %s\n", $mode_restore,
                $abs_path;
        }
        return sprintf "deleted %d line%s [ %d..%d ] from %s",
            $count, $count == 1 ? '' : 's', $from_n, $to_n, $path;
    } else {
        ## stage when no write access ##
        my $stage_name = $abs_path =~ s{/}{__}gr;
        my $stage_path = "/var/protocol-7/coding/staged/$stage_name";
        open my $fh, '>:encoding(UTF-8)', $stage_path;
        print {$fh} @lines;
        close $fh;
        return
            sprintf "staged delete %d line%s [ %d..%d ] "
            . "from %s [ no write access ]\nstaged at: %s",
            $count, $count == 1 ? '' : 's', $from_n, $to_n, $path,
            $stage_path;
    }
}

return sprintf "preview: would delete %d line%s [ %d..%d ]",
    $count, $count == 1 ? '' : 's', $from_n, $to_n;

