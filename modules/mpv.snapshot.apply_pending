## [:< ##

# name  = mpv.snapshot.apply_pending
# descr = file-loaded hook : apply deferred seek + pause from a snapshot
#         restore once the saved file is actually the one playing

my $pending_path = <mpv.snapshot.pending_path>;
return if not defined $pending_path;

## wait until the saved file is the loaded one [ playlist flow may load ##
## other entries first ]                                                ##
my $current_path = <mpv.current.path>;
return if not defined $current_path or $current_path ne $pending_path;

my $position = delete <mpv.snapshot.pending_pos>;
delete <mpv.snapshot.pending_path>;

if (    defined $position
    and $position =~ m|^\d+(\.\d+)?$|
    and $position > 0 ) {
    <[base.logs]>->(
        1, '[snapshot] seeking to restored position %.1f', $position
    );
    push( @{<mpv.command.reply>}, { 'handler' => qw| dev.null | } );
    <[mpv.send_command]>->( 'seek', $position, 'absolute', 'exact' );
}

## pause restore is sent after the file-loaded handler's own pause logic so ##
## the snapshot state wins                                                  ##
my $pause = delete <mpv.snapshot.pending_pause>;
if ( defined $pause and $pause =~ m{^(yes|no)$} ) {
    push( @{<mpv.command.reply>}, { 'handler' => qw| dev.null | } );
    <[mpv.send_command]>->( 'set_property_string', 'pause', $pause );
}

return;

