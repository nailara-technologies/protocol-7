## [:< ##

# name  = branch.calc.fraction.period
# descr = compute repeating period string for X/Y via long division
# param = numerator, denominator
#
# return empty string if terminates

my ( $numerator, $denominator ) = @ARG;

return undef
    if not defined $numerator
    or not defined $denominator
    or $denominator == 0;

## [ long division : track remainders, detect repeat ] ##
my $rem = $numerator % $denominator;
my %seen;
my $pos = 0;
my $period_str = '';

while ( $rem != 0 ) {
    last if exists $seen{$rem};
    $seen{$rem} = $pos++;
    $rem *= 10;
    my $digit = int( $rem / $denominator );
    $period_str .= $digit;
    $rem = $rem % $denominator;
}

return '' if $rem == 0;    ## [ terminates ] ##

my $start = $seen{$rem};
return substr( $period_str, $start );

