# name = data.mount.shm.open.mmap_file_read
# descr = mmap file for read access

my $fh = shift;

if ( eval { require Sys::Mmap } ) {
    my $var;
    Sys::Mmap::mmap( $var, 0, Sys::Mmap::PROT_READ(), Sys::Mmap::MAP_SHARED(),
        fileno($fh), 0 );
    return \$var if length($var) > 0;
}

# Fallback: slurp
local $/;
my $data = <$fh>;
return \$data;

