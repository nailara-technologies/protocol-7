# name  = models.storage.discover_directory
# args  = $directory_path, $recursive (default: TRUE)
# descr = Discover .gguf model files in directory

my $directory_path = shift;
my $recursive      = shift // TRUE;

return [] unless defined $directory_path && length $directory_path;
return [] unless -d $directory_path;

# Use extracted scan_directory module for recursive scanning
@ARG = ( $directory_path, $recursive );
my $found_models
    = <[models.discover.scan_directory]>->( $directory_path, $recursive );

say STDERR Dumper($found_models);

return $found_models;

