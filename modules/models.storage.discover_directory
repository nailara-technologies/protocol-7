# name  = models.storage.discover_directory
# args  = $directory_path, $recursive (default: TRUE)
# descr = Discover .gguf model files in directory

my $directory_path = shift;
my $recursive      = shift // TRUE;

return [] unless -d $directory_path;

my @found_models;
my $find_pattern = $recursive ? '**/*.gguf' : '*.gguf';

# Use glob to find models
my $files = [];    ## preparing result array reference ##
<[file.match_files]>->( $files, $directory_path, $find_pattern );

foreach my $model_path ( $files->@* ) {
    next unless -f $model_path;

    # Get file size
    my $size_bytes = -s $model_path;
    my $size_gb    = $size_bytes / ( 1024**3 );

    # Extract model name from filename
    my ($model_name) = $model_path =~ m|/([^/]+)\.gguf$|;

    push @found_models,
        {
        path    => $model_path,
        name    => $model_name,
        size_gb => sprintf( '%.2f', $size_gb ),
        source  => 'discovered'
        };
}

return \@found_models;

