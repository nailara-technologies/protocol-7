## [:< ##

# name  = pager.decode.direction
# descr = decode direction bits to named direction

my ($bits) = @ARG;
my $dir = oct( '0b' . $bits );
return [ 'UP', 'RIGHT', 'LEFT', 'DOWN' ]->[$dir] // 'UNKNOWN';

