## [:< ##

# name  = web.jobs.data
# descr = command handler for jobs data — returns SIZE reply with JSON

my $call = shift // {};

my $jobs = <[plugin.web.jobs.cache.read_all]>;

my @ids = sort {
    ( $jobs->{$b}{'fetched_at'} // 0 ) <=> ( $jobs->{$a}{'fetched_at'} // 0 )
} keys %{$jobs};

my @array;
for my $job_id (@ids) {
    push @array, { %{ $jobs->{$job_id} }, 'id' => $job_id };
}

my $json = eval { JSON::XS::encode_json( \@array ) };
if ($@) {
    <[base.logs]>->( 0, 'web.jobs.data: json error: %s', $@ );
    return {
        'mode'         => 'size',
        'data'         => '[]',
        'content_type' => 'application/json'
    };
}

return {
    'mode'         => 'size',
    'data'         => $json,
    'content_type' => 'application/json'
};

