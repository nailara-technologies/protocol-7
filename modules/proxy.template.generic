## [:< ##

# name  = proxy.template.generic
# descr = generic p7-style HTML renderer for extracted content

my $client_id = shift;
my $context   = shift;

my $client = $data{'proxy'}{'clients'}{$client_id};
return if not defined $client;

my $url = $context->{'request'}{'url'};

## async call to site-yaml.cmd.fetch ##
<[protocol-7.route-send]>->(
    {   'command'   => 'site-yaml.cmd.fetch',
        'call_args' => { 'args' => $url },
        'reply'     => {
            'handler' => 'proxy.handler.site_yaml_reply',
            'params'  => {
                client_id => $client_id,
                context   => $context,
            }
        }
    }
);

return;

