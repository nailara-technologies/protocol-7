## [:< ##

# name  = channels.handler.llm-content-evaluation
# descr = Evaluate discovered content interest and relevance for LLM processing
# args  = hash { content_data, evaluation_context }
# return = hash { interest_score => 0-100, relevant => 0/1, evaluation => {...} }

my $args = shift;
return { 'interest_score' => 0, 'relevant' => FALSE }
    unless defined $args and ref $args eq 'HASH';

my $content = $args->{'content_data'};
my $context = $args->{'evaluation_context'} // {};

return { 'interest_score' => 0, 'relevant' => FALSE }
    unless defined $content and ref $content eq 'HASH';

##  Evaluation criteria ##
##  - Content type match (podcasts, technical articles, etc.)
##  - Author/source relevance (known quality sources)
##  - Keyword matching against interest domains
##  - Duration suitability (not too short/long)
##  - Recency (prefer fresh content)
##  - Engagement metrics (if available)

my $evaluation = {
    'timestamp'       => <[base.time]>->(2),
    'content_title'   => $content->{'title'} // '',
    'criteria_scores' => {}
};

my $total_score        = 0;
my $evaluated_criteria = 0;

##  Criterion 1: Type relevance  ##
my $type       = $content->{'type'} // '';
my $type_score = 0;

if ( $type =~ m|audio.podcast|i ) {
    $type_score = 80;    ## Strong interest in podcasts ##
} elsif ( $type =~ m|document.article|i ) {
    $type_score = 75;    ## Good interest in technical articles ##
} elsif ( $type =~ m|video|i ) {
    $type_score = 60;    ## Moderate interest in videos ##
} elsif ( $type =~ m|audio|i ) {
    $type_score = 65;    ## Moderate-high audio interest ##
}

$evaluation->{'criteria_scores'}->{'type_relevance'} = $type_score;
$total_score += $type_score;
$evaluated_criteria++;

##  Criterion 2: Source quality  ##
my $source       = $content->{'source'} // '';
my $source_score = 50;                           ## Default neutral score ##

my %trusted_sources = (
    'arxiv'     => 95,
    'github'    => 90,
    'hn'        => 80,
    'youtube'   => 70,
    'medium'    => 65,
    'wikipedia' => 85
);

if ( $trusted_sources{$source} ) {
    $source_score = $trusted_sources{$source};
}

$evaluation->{'criteria_scores'}->{'source_quality'} = $source_score;
$total_score += $source_score;
$evaluated_criteria++;

##  Criterion 3: Title keyword matching  ##
my $title         = $content->{'title'} // '';
my $keyword_score = 50;                          ## Default ##

my @interest_keywords = qw(
    AI machine-learning neural network deep-learning
    protocol distributed systems cryptography
    automation LLM transformer architecture
    performance optimization engineering
);

foreach my $keyword (@interest_keywords) {
    if ( $title =~ m|\Q$keyword\E|i ) {
        $keyword_score = 85;
        last;
    }
}

$evaluation->{'criteria_scores'}->{'keyword_match'} = $keyword_score;
$total_score += $keyword_score;
$evaluated_criteria++;

##  Criterion 4: Recency (prefer content < 6 months old)  ##
my $discovery_ts = $content->{'discovered_at'} // <[base.time]>->(2);
my $age_seconds  = <[base.time]>->(2) - $discovery_ts;
my $age_days     = $age_seconds / 86400;

my $recency_score = 100;
if ( $age_days > 180 ) {
    $recency_score = 40;    ## Old content ##
} elsif ( $age_days > 90 ) {
    $recency_score = 70;    ## Somewhat old ##
} elsif ( $age_days > 30 ) {
    $recency_score = 90;    ## Moderately fresh ##
}

$evaluation->{'criteria_scores'}->{'recency'} = $recency_score;
$total_score += $recency_score;
$evaluated_criteria++;

##  Calculate final interest score  ##
my $final_score = int( $total_score / $evaluated_criteria );
my $is_relevant = $final_score >= 65 ? TRUE : FALSE;

##  Store evaluation for auditing  ##
<channels.content_evaluations> //= {};
<channels.content_evaluations>->{ $content->{'title'} } = {
    'evaluation'     => $evaluation,
    'interest_score' => $final_score,
    'relevant'       => $is_relevant,
    'evaluated_at'   => <[base.time]>->(2)
};

<[base.logs]>->(
    2,
    "channels: LLM evaluated '%s' (score: %d, relevant: %s)",
    substr( $content->{'title'}, 0, 50 ),
    $final_score, $is_relevant ? 'yes' : 'no'
);

return {
    'interest_score' => $final_score,
    'relevant'       => $is_relevant,
    'evaluation'     => $evaluation
};

1;

