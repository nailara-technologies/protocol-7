## [:< ##

# name  = ascii.frame.init_code
# descr = reset the frame descriptor cache on init / reload

## ascii.frame.load caches parsed descriptors keyed by frame name. clearing
## the cache here — base.init_modules re-runs init_code on every source
## reload — lets edited frame yaml take effect on reload without a cold
## zenka restart, while keeping the lifecycle owned by the frame system
## itself rather than leaking frame specifics into generic base.cmd.reload ##

<ascii.frame.cache> = {};

return TRUE;

