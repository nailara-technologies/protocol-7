## [:< ##

# name  = site-yaml.cmd.import
# descr = fetch search url, import new job records

my $url = $call->{'args'} // '';
$url = $data{'site-yaml'}{'cfg'}{'stepstone_search_url'} // ''
    if not length $url;

return { 'mode' => 'false', 'data' => 'no url' }
    if not length $url;

## step 1: get job link list from search page
my $links = <[site-yaml.stepstone.search]>->($url);
if ( ref $links ne 'ARRAY' ) {
    return { 'mode' => 'false', 'data' => "search failed: $links" };
}

my ( $new_count, $skip_count, $err_count ) = ( 0, 0, 0 );
my @retry_queue;

for my $link ( @{$links} ) {
    my $id = $link->{'id'};

    ## skip already-known jobs to avoid redundant fetches
    if ( exists $data{'jobs'}{'store'}{$id} ) {
        $skip_count++;
        next;
    }

    ## fetch full job record — small delay to avoid rate limiting
    select( undef, undef, undef, 0.5 );
    my $job = <[site-yaml.stepstone.job]>->( $link->{'url'} );
    if ( ref $job ne 'HASH' ) {
        <[base.logs]>->( 0, 'import: fetch error id=%s : %s', $id, $job );
        push @retry_queue, $link;
        next;
    }

    my $result = <[site-yaml.jobs.upsert]>->($job);
    $new_count++ if $result eq 'new';
}

## retry failed fetches once with longer delay
if (@retry_queue) {
    <[base.logs]>->(
        1,
        'import: retrying %d failed fetch%s',
        scalar @retry_queue,
        scalar @retry_queue == 1 ? '' : 'es'
    );
    select( undef, undef, undef, 3 );    ## wait 3s before retry pass
    for my $link (@retry_queue) {
        my $id = $link->{'id'};
        select( undef, undef, undef, 2 );
        my $job = <[site-yaml.stepstone.job]>->( $link->{'url'} );
        if ( ref $job ne 'HASH' ) {
            <[base.logs]>
                ->( 0, 'import: retry failed id=%s : %s', $id, $job );
            $err_count++;
            next;
        }
        my $result = <[site-yaml.jobs.upsert]>->($job);
        $new_count++ if $result eq 'new';
    }
}

<[site-yaml.jobs.save]> if $new_count;

my $summary = sprintf 'import done: %d new, %d skipped, %d errors',
    $new_count, $skip_count, $err_count;
<[base.logs]>->( 1, 'site-yaml.import : %s', $summary );

return { 'mode' => 'size', 'data' => $summary };

