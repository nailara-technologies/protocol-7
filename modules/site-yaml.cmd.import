## [:< ##

# name  = site-yaml.cmd.import
# descr = fetch search url, import new job records

my $url = $call->{'args'} // '';
$url = $data{'site-yaml'}{'cfg'}{'stepstone_search_url'} // ''
    if not length $url;

return { 'mode' => 'false', 'data' => 'no url' }
    if not length $url;

my $max_pages = <site-yaml.import_max_pages> // 1;
$max_pages = 1 if $max_pages < 1;
$max_pages = 5 if $max_pages > 5;    ## safety cap

my $delay_search = <site-yaml.import_delay_search> // 1.5;
my $delay_detail = <site-yaml.import_delay_detail> // 2.0;

my ( $new_count, $skip_count, $err_count ) = ( 0, 0, 0 );
my @retry_queue;

for my $page ( 1 .. $max_pages ) {
    my $page_url = $url;
    if ( $page > 1 ) {
        $page_url .= ( $url =~ m{\?} ) ? '&' : '?';
        $page_url .= "page=$page";
    }

    <[base.logs]>->( 1, 'import: fetching page %d/%d', $page, $max_pages )
        if $max_pages > 1;

    my $links = <[site-yaml.stepstone.search]>->($page_url);
    if ( ref $links ne 'ARRAY' ) {
        <[base.logs]>->(
            0,     'import: page %d search failed: %s',
            $page, $links
        );
        last;
    }

    ## stop if empty page (end of results)
    last if not @{$links};

    for my $link ( @{$links} ) {
        my $id = $link->{'id'};

        ## skip already-known jobs to avoid redundant fetches
        if ( exists $data{'jobs'}{'store'}{$id} ) {
            $skip_count++;
            next;
        }

        ## fetch full job record — delay to avoid rate limiting
        select( undef, undef, undef, $delay_detail );
        my $job = <[site-yaml.stepstone.job]>->( $link->{'url'} );
        if ( ref $job ne 'HASH' ) {
            <[base.logs]>->( 0, 'import: fetch error id=%s : %s', $id, $job );
            push @retry_queue, $link;
            next;
        }

        my $result = <[site-yaml.jobs.upsert]>->($job);
        $new_count++ if $result eq 'new';
    }

    ## delay between search pages
    select( undef, undef, undef, $delay_search )
        if $page < $max_pages;
}

## retry failed fetches once with longer delay
if (@retry_queue) {
    <[base.logs]>->(
        1,
        'import: retrying %d failed fetch%s',
        scalar @retry_queue,
        scalar @retry_queue == 1 ? '' : 'es'
    );
    select( undef, undef, undef, 5 );    ## wait 5s before retry pass
    for my $link (@retry_queue) {
        my $id = $link->{'id'};
        select( undef, undef, undef, 3 );
        my $job = <[site-yaml.stepstone.job]>->( $link->{'url'} );
        if ( ref $job ne 'HASH' ) {
            <[base.logs]>
                ->( 0, 'import: retry failed id=%s : %s', $id, $job );
            $err_count++;
            next;
        }
        my $result = <[site-yaml.jobs.upsert]>->($job);
        $new_count++ if $result eq 'new';
    }
}

<[site-yaml.jobs.save]> if $new_count;

my $summary = sprintf 'import done: %d new, %d skipped, %d errors',
    $new_count, $skip_count, $err_count;
<[base.logs]>->( 1, 'site-yaml.import : %s', $summary );

return { 'mode' => 'size', 'data' => $summary };

