## [:< ##

# name  = site-yaml.cmd.import
# descr = queue search results for async detail fetching

my $url = $call->{'args'} // '';
$url = $data{'site-yaml'}{'cfg'}{'stepstone_search_url'} // ''
    if not length $url;

return { 'mode' => 'false', 'data' => 'no url' }
    if not length $url;

my $max_pages = <site-yaml.import_max_pages> // 1;
$max_pages = 1 if $max_pages < 1;
$max_pages = 5 if $max_pages > 5;    ## safety cap

my $delay_search = <site-yaml.import_delay_search> // 1.5;

my ( $queued_count, $skip_count, $err_count ) = ( 0, 0, 0 );

for my $page ( 1 .. $max_pages ) {
    my $page_url = $url;
    if ( $page > 1 ) {
        $page_url .= ( $url =~ m{\?} ) ? '&' : '?';
        $page_url .= "page=$page";
    }

    <[base.logs]>->( 1, 'import: fetching page %d/%d', $page, $max_pages )
        if $max_pages > 1;

    my $links = <[site-yaml.stepstone.search]>->($page_url);
    if ( ref $links ne 'ARRAY' ) {
        <[base.logs]>->(
            0,     'import: page %d search failed: %s',
            $page, $links
        );
        last;
    }

    ## stop if empty page (end of results)
    last if not @{$links};

    for my $link ( @{$links} ) {
        my $id = $link->{'id'};

        ## skip already-known jobs
        if ( exists $data{'jobs'}{'store'}{$id} ) {
            $skip_count++;
            next;
        }

        ## queue for async fetch with adaptive backoff ##
        push @{ $data{'site-yaml'}{'fetch_queue'} },
            {
            'id'  => $id,
            'url' => $link->{'url'},
            };
        $queued_count++;
    }

    ## delay between search pages
    select( undef, undef, undef, $delay_search )
        if $page < $max_pages;
}

## start async fetch timer if queue has items and timer not running ##
if ( $queued_count and not defined $data{'site-yaml'}{'fetch_timer'} ) {
    <[site-yaml.fetch.schedule}>;
}

<[site-yaml.fetch.state]>->('save');

my $summary = sprintf 'import queued: %d new, %d skipped, %d errors',
    $queued_count, $skip_count, $err_count;
<[base.logs]>->( 1, 'site-yaml.import : %s', $summary );

return { 'mode' => 'size', 'data' => $summary };

