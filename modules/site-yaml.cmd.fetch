## [:< ##

# name  = site-yaml.cmd.fetch
# descr = fetch a URL and return structured YAML

my $url = $call->{'args'} // '';

return { 'mode' => 'false', 'data' => 'no url supplied' }
    if not length $url;

my $result = <[site-yaml.extract]>->($url);

if ( not defined $result or ref $result ne 'HASH' ) {
    return { 'mode' => 'false', 'data' => $result // 'extraction failed' };
}

my $yaml = YAML::XS::Dump($result);

return { 'mode' => 'size', 'data' => $yaml };

