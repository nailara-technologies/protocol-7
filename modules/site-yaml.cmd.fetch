## [:< ##

# name  = site-yaml.cmd.fetch
# descr = fetch a URL and return structured YAML

my $url = $call->{'args'} // '';
return
    <[base.callback.cmd_reply]>
    ->( { 'mode' => FALSE, 'data' => 'no url supplied' } )
    if not length $url;

my $result = <[site-yaml.extract]>->($url);

if ( not defined $result or ref $result ne 'HASH' ) {
    return
        <[base.callback.cmd_reply]>
        ->( { 'mode' => FALSE, 'data' => $result // 'extraction failed' } );
}

my $yaml = YAML::XS::Dump($result);

<[base.callback.cmd_reply]>->( { 'mode' => TRUE, 'data' => $yaml } );

