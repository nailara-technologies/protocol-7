# name  = crypt.C25519.keys.annotate_type
# descr = Add algorithm type annotations to existing keys
#         Enables safe migration to type-aware key system
#         Identifies key purpose and marks appropriate algorithm
#
# params:
#   $key_name       = Name of the key to annotate
#   $algorithm_type = 'Ed25519' or 'Curve25519' (optional, inferred if not provided)
#
# returns: 1 (success) | 0 (failure)
#
# logic:
#   - If type already set in keypair, return success
#   - If algorithm_type provided, use it
#   - Otherwise infer from key name/usage patterns
#   - Update key name to include type suffix
#   - Preserve all key material

my $key_name       = shift;
my $algorithm_type = shift;

return FALSE unless defined $key_name;

$keys{'C25519'} //= {};

my $keypair = $keys{'C25519'}->{$key_name};
return FALSE unless defined $keypair;

## If type already set, nothing to do
if ( defined $keypair->{'type'} ) {
    <[base.logs]>->(
        2,         "key '%s' already has type '%s'",
        $key_name, $keypair->{'type'}
    );
    return TRUE;
}

## Infer algorithm type if not provided
unless ( defined $algorithm_type ) {
    if ( $key_name =~ m/link-upgrade/ ) {
        $algorithm_type = 'Curve25519';    # DH keys
    } elsif ( $key_name =~ m/sign/ or $key_name =~ m/auth/ ) {
        $algorithm_type = 'Ed25519';       # Signature keys
    } elsif ( $key_name =~ m/dh|exchange/ ) {
        $algorithm_type = 'Curve25519';    # DH keys
    } else {
        ## Default based on context: if has 'private' key material, likely Ed25519
        if ( defined $keypair->{'private'}
            and length( $keypair->{'private'} ) > 32 ) {
            $algorithm_type = 'Ed25519';    # Ed25519 has extended private key
        } else {
            $algorithm_type = 'Curve25519';    # Fallback to Curve25519
        }
    }
}

## Validate algorithm type
unless ( $algorithm_type =~ m/^(Ed25519|Curve25519)$/ ) {
    <[base.logs]>->( 0, "invalid algorithm type: %s", $algorithm_type );
    return FALSE;
}

## Create new key name with type suffix
my $new_key_name = $key_name;
unless ( $new_key_name =~ m/:(?:Ed25519|Curve25519)$/ ) {
    $new_key_name = sprintf( "%s:%s", $key_name, $algorithm_type );
}

## Store type in keypair
$keypair->{'type'} = $algorithm_type;

## If name changed, update the key registry
if ( $new_key_name ne $key_name ) {
    $keys{'C25519'}->{$new_key_name} = delete $keys{'C25519'}->{$key_name};

    <[base.logs]>->(
        2, "annotated key '%s' with type '%s' (renamed to '%s')",
        $key_name, $algorithm_type, $new_key_name
    );
} else {
    <[base.logs]>->(
        2,         "annotated key '%s' with type '%s'",
        $key_name, $algorithm_type
    );
}

return TRUE;

1;

