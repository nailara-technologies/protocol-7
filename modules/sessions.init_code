## [:< ##

# name  = sessions.init_code
# descr = init sessions zenka [ first real capability: one key-holding
#         child, spawn/detach/attach/encrypt/decrypt via sessions.cmd.* ]

<sessions.holder.state> //= qw| unspawned |;

<[base.logs]>->( 2, 'sessions zenka initialized' );

return TRUE;

