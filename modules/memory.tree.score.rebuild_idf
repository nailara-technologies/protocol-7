## [:< ##

# name = memory.tree.score.rebuild_idf
# descr = rebuild idf cache from current tree and store it

my $result = <[memory.tree.wordcount]>->( { 'node' => <memory.tree> } );
<memory.score.idf_cache> = $result;

return TRUE;

