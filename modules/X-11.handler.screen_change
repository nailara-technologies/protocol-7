## [:< ##

# name  = X-11.handler.screen_change
# descr = refresh cached screen size on RANDR screen-change notification

my $event = shift // {};

my $new_w = $event->{'width'}  // 0;
my $new_h = $event->{'height'} // 0;

if ( $new_w and $new_h ) {
    <[base.logs]>->(
        1,      ': screen change notification [ %d X %d ]',
        $new_w, $new_h
    );
    <x11.screen.width>  = $new_w;
    <x11.screen.height> = $new_h;
} else {
    ## dimensions absent in event — requery root geometry ##
    my %geom = eval { <X-11.obj>->GetGeometry( <X-11.obj>->root ) };
    if ( not $EVAL_ERROR and $geom{'width'} and $geom{'height'} ) {
        <x11.screen.width>  = $geom{'width'};
        <x11.screen.height> = $geom{'height'};
        <[base.logs]>->(
            1,              ': screen change [ %d X %d ] [ requeried ]',
            $geom{'width'}, $geom{'height'}
        );
    } else {
        <[base.log]>->( 1, ': screen change notification [ no dimensions ]' );
    }
}

## refresh per-monitor geometry registry ##
<[X-11.build_monitor_registry]> if <X-11.has_randr>;

<[X-11.emit.screen-change]>->(
    <x11.screen.width>  // 0,
    <x11.screen.height> // 0
    )
    if <X-11.screen_change_subscribers>
    and @{<X-11.screen_change_subscribers>};

