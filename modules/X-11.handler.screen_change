# name  = X-11.handler.screen_change
# descr = refresh cached screen size on RANDR screen-change notification

my $event = shift // {};

my $new_w = $event->{'width'}  // 0;
my $new_h = $event->{'height'} // 0;

if ( $new_w and $new_h ) {
    <[base.logs]>->(
        1,      ': screen change notification [ %d X %d ]',
        $new_w, $new_h
    );
    <x11.screen.width>  = $new_w;
    <x11.screen.height> = $new_h;
} else {
    ## dimensions absent in event — requery root geometry ##
    my %geom = eval { <X-11.obj>->GetGeometry( <X-11.obj>->root ) };
    if ( not $EVAL_ERROR and $geom{'width'} and $geom{'height'} ) {
        <x11.screen.width>  = $geom{'width'};
        <x11.screen.height> = $geom{'height'};
        <[base.logs]>->(
            1,              ': screen change [ %d X %d ] [ requeried ]',
            $geom{'width'}, $geom{'height'}
        );
    } else {
        <[base.log]>->( 1, ': screen change notification [ no dimensions ]' );
    }
}

## refresh per-monitor geometry registry ##
my $prev_monitor_count = scalar @{ <X-11.monitors> // [] };
<[X-11.build_monitor_registry]> if <X-11.has_randr>;
my $new_monitor_count = scalar @{ <X-11.monitors> // [] };

## a reconnect-on-every-notification approach was tried here to recover a   ##
## separate visibility/compositing bug [ a window stuck un-composited       ##
## after a monitor topology change ], but X-11.job.finalize_server ties the ##
## RandR subscription, the event_handler='queue' flag, and the keyboard IO  ##
## watcher's file descriptor all to ONE specific connection object, none of ##
## which carry over to a fresh connection or get re-registered             ##
## automatically. the codebase's own existing reconnect mechanism [ see     ##
## X-11.reconnect, called only from the connection's error_handler on a    ##
## server crash ] doesn't solve this either - it deliberately exits the     ##
## whole process on exhaustion so v7 restarts it through the full init      ##
## chain, which is what actually re-registers everything correctly.        ##
## removed after costing two live regressions for no confirmed benefit -   ##
## only a full `v7.restart X-11` was ever shown to fix that bug.           ##

## monitor topology changed - windows that were on a now-vanished/restored ##
## screen need the wm to re-actualize their state [ same need as after a   ##
## set_geometry/move-window call, see X-11.cmd.set_geometry ]              ##
<[X-11.WM.update]>;

## a monitor disappearing leaves weston/WSLg with stale per-output         ##
## placement state - confirmed live: any window placement whose Y falls    ##
## within the now-removed monitor's former Y-range silently fails forever, ##
## with no recovery short of either a full Weston/WSLg restart or a host-  ##
## side display topology re-push. fire that re-push automatically here.    ##
## windows' own disconnect handling is its own multi-iteration, unsynced   ##
## storm [ audio freeze, focus loss, repeated off/on ] - react on the      ##
## FIRST drop notification, not a debounced/settled one, to race ahead of  ##
## it rather than wait it out. guarded by a cooldown so the later, still-   ##
## arriving notifications from that SAME storm don't each re-trigger their ##
## own toggle and stack additional disruption on top.                      ##
if ( $new_monitor_count < $prev_monitor_count ) {
    my $cooldown_s = <X-11.display_switch.cooldown_s> // 10;
    my $now        = <[base.time]>->(3);
    if ( not defined <X-11.display_switch.cooldown_until>
        or $now >= <X-11.display_switch.cooldown_until> ) {
        <X-11.display_switch.cooldown_until> = $now + $cooldown_s;
        <[base.logs]>->(
            1,
            ': monitor count dropped [ %d -> %d ] - triggering host-side'
                . ' display switch toggle to avoid stale placement state',
            $prev_monitor_count,
            $new_monitor_count
        );
        <[protocol-7.command.send.local]>->(
            { 'command' => qw| cube.powershell.display-switch-toggle | } );
    } else {
        <[base.logs]>->(
            2,
            ': monitor count dropped [ %d -> %d ] - display switch toggle'
                . ' still in cooldown, skipping',
            $prev_monitor_count,
            $new_monitor_count
        );
    }
}

## debounced settle-check : notifications can stop arriving before the      ##
## topology has actually reached its final state, leaving the registry     ##
## stale with nothing left to trigger a rebuild [ see                      ##
## X-11.handler.monitor_settle_check ]. reschedule on every notification so ##
## only the LAST one in a burst fires the check, a few seconds after       ##
## things quiet down.                                                      ##
<X-11.monitor_settle_timer>->cancel if defined <X-11.monitor_settle_timer>;
<X-11.monitor_settle_timer> = <[event.add_timer]>->(
    {   'after'   => <X-11.monitor_settle_delay> // 4,
        'handler' => qw| X-11.handler.monitor_settle_check |,
    }
);

<[X-11.emit.screen-change]>->(
    <x11.screen.width>  // 0,
    <x11.screen.height> // 0
    )
    if <X-11.screen_change_listeners>
    and @{<X-11.screen_change_listeners>};

