# name = data.mount.shm.create.pack_shm_header
# desc = Pack SHM header structure into binary format

use constant SHM_HEADER_SIZE => 512;

my $header = shift;

# Build fields separately to avoid sprintf format issues with colons
my $version   = $header->{'version'} // 1;
my $pubkey    = $header->{'owner_pubkey'};
my $created   = $header->{'created'};
my $data_size = $header->{'data_size'};
my $hdr_size  = $header->{'header_size'} // SHM_HEADER_SIZE;

# Build flags string
my @flags;
for my $key ( keys %{ $header->{'flags'} } ) {
    push @flags, $key . '=' . ( $header->{'flags'}{$key} ? 1 : 0 );
}
my $flags_str = join( ',', @flags );

# Concatenate directly instead of sprintf (avoids colon interpretation)
my $packed
    = 'P7SH:'
    . $version . ':'
    . $pubkey . ':'
    . $created . ':'
    . $data_size . ':'
    . $hdr_size . ':'
    . $flags_str . ":\n";

# Pad to fixed header size
$packed .= "\0" x ( SHM_HEADER_SIZE - length($packed) );
return substr( $packed, 0, SHM_HEADER_SIZE );

