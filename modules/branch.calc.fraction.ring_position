## [:< ##

# name  = branch.calc.fraction.ring_position
# descr = map period string to 1001-ring harmonic index (0..12)
# param = period_string
#
# derived from which generator family the period belongs to

my ($period_str) = @ARG;

return undef
    if not defined $period_str
    or not length $period_str;

## [ load yaml registry ] ##
my $yaml_path = 'data/yaml/harmonic/fraction-period-groups.yaml';
my $yaml_data = eval { YAML::XS::LoadFile($yaml_path) };

return undef if $@ or not defined $yaml_data;

my $periods = $yaml_data->{'periods'} // {};

if ( exists $periods->{$period_str} ) {
    my $ring_pos = $periods->{$period_str}{'ring_pos'};
    return defined $ring_pos ? $ring_pos : undef;
}

## [ fallback : check rotations of canonical families ] ##
my @families = (
    [ qw| 076923 |, 0 ],
    [ qw| 142857 |, 1 ],
    [ qw| 153846 |, 2 ],
);

for my $fam (@families) {
    my ( $base, $pos ) = @$fam;
    next if length($period_str) != length($base);
    my $double = $base . $base;
    return $pos if index( $double, $period_str ) >= 0;
}

return undef;

