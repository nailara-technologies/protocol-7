## [:< ##

# name  = graphics-matrix.cmd.cursor-state
# descr = return cursor state as structured data for other zenki

my $cursor = <[graphics-matrix.cursor.position]>;
my $chk    = <[graphics-matrix.cursor.checksum]>;

## format as key=value pairs for easy parsing ##
my $out = sprintf "selX=%d selY=%d selZ=%d zoom=%.2f radius=%d chk=%s",
    $cursor->{'selX'},
    $cursor->{'selY'},
    $cursor->{'selZ'},
    $cursor->{'zoom'},
    $cursor->{'radius'},
    $chk;

return { qw| mode | => qw| size |, qw| data | => "$out\n" };

