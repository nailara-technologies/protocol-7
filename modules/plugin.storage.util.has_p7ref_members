# name  = plugin.storage.util.has_p7ref_members
# descr = Check if member list contains P7REFs

my ($members) = @_;
return 0 unless $members && @$members;

for my $m (@$members) {
    return 1 if $m =~ m|^p7://|;
}
return 0;

