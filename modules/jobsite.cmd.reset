## [:< ##

# name  = jobsite.cmd.reset
# descr = reset job(s) to status=new, clearing assessment fields
# param = [status=] [stage=] [job_id=] [encoding_broken=]

my $args_str = $call->{'args'} // '';
$args_str =~ s|^\s+||;
$args_str =~ s|\s+$||;

## parse key=value tokens ##
my %params;
for my $token ( split /\s+/, $args_str ) {
    $params{ lc $1 } = $2 if $token =~ m{^([\w\-]+)=(.*)$};
}

## require at least one filter : refuse naked reset ##
return {
    'mode' => 'false',
    'data' =>
        'reset requires a filter: status=, stage=, job_id=, encoding_broken='
    }
    unless %params;

## never reset user-decision stages regardless of other filters ##
my %protected = map { $ARG => 1 } qw| applied responded rejected archived |;

## fields cleared on reset ##
my @clear_fields = qw|
    score score_reason score_summary
    assertions stage
    repair_attempted repair_failed repair_applied
    |;

my $jobs_dir = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite jobs |;

my $tasks = <jobsite.tasks> // {};

## build candidate list ##
my @candidates;
if ( defined $params{'job_id'} ) {
    push @candidates, map { uc $ARG }
        grep { length $ARG } split /[,\s]+/, $params{'job_id'};
} else {
    my %seen = map { $ARG => 1 } keys %{$tasks};
    ## also scan job files for statuses not tracked in-memory (e.g. blocked) ##
    if ( defined $params{'status'} ) {
        my $status_pat = quotemeta( $params{'status'} );
        if ( opendir my $dh, $jobs_dir ) {
            for my $fn ( readdir $dh ) {
                next unless $fn =~ m{^(\d+)\.yaml$};
                my $jid = $1;
                next if $seen{$jid};
                my $job_file = "$jobs_dir/$jid.yaml";
                open my $fh, '<', $job_file or next;
                my $found = grep {m{^status:\s*$status_pat\s*$}} <$fh>;
                close $fh;
                push @candidates, $jid if $found;
            }
            closedir $dh;
        }
    }
    push @candidates, keys %{$tasks};
}

## encoding_broken: use cfg_bool so yes/true/1/5 all work ##
my $check_encoding
    = exists $params{'encoding_broken'}
    ? <[base.cfg_bool]>->( $params{'encoding_broken'} )
    : undef;

my ( $n_reset, $n_protected ) = ( 0, 0 );

for my $job_id (@candidates) {
    my $rec = $tasks->{$job_id};

    ## for jobs not in-memory (e.g. blocked), read status from file for filters ##
    my $rec_status = defined $rec ? ( $rec->{'status'} // '' ) : do {
        my $job_file = "$jobs_dir/$job_id.yaml";
        my $st       = '';
        if ( open my $fh, '<', $job_file ) {
            ($st) = map { /^status:\s*(\S+)/ ? $1 : () } <$fh>;
            close $fh;
        }
        $st;
    };
    my $rec_stage = defined $rec ? ( $rec->{'stage'} // '' ) : '';

    ## always skip protected stages ##
    if ( $protected{$rec_stage} ) {
        $n_protected++;
        next;
    }

    ## status filter ##
    next
        if defined $params{'status'}
        and $rec_status ne $params{'status'};

    ## stage filter ##
    next
        if defined $params{'stage'}
        and $rec_stage ne $params{'stage'};

    ## encoding_broken filter : scan raw file bytes for double-encoded marker ##
    if ( defined $check_encoding ) {
        my $job_file = "$jobs_dir/$job_id.yaml";
        my $broken   = FALSE;
        if ( -f $job_file ) {
            open my $fh, '<:raw', $job_file or next;
            my $raw = do { local $/; <$fh> };
            close $fh;
            $broken = TRUE if $raw =~ /\xc3\x83/;
        }
        next if $check_encoding     and not $broken;
        next if not $check_encoding and $broken;
    }

    ## reset in-memory record if present ##
    if ( defined $rec ) {
        delete $rec->{$ARG} for @clear_fields;
        $rec->{'status'} = 'new';
    }

    ## reset per-job file ##
    my $job = <[jobsite.job.read]>->($job_id) // {};
    delete $job->{$ARG} for @clear_fields;
    $job->{'status'} = 'new';
    <[jobsite.job.write]>->( $job_id, $job );

    $n_reset++;
}

<[jobsite.state.persist]> if $n_reset;

<[base.logs]>->(
    1,        'jss.reset: reset=%d protected_skipped=%d',
    $n_reset, $n_protected
);

return {
    'mode' => 'true',
    'data' => sprintf 'reset %d job(s)%s',
    $n_reset,
    $n_protected ? " ($n_protected protected skipped)" : ''
};

