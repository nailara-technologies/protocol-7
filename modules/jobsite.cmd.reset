## [:< ##

# name  = jobsite.cmd.reset
# descr = job reset to 'new', clears assessment fields
# param = <status=|stage=|job_id=|enc_error=|rep-err=>

my $args_str = $call->{'args'} // '';
$args_str =~ s|^\s+||;
$args_str =~ s|\s+$||;

## parse key=value tokens ##
my %params;
for my $token ( split /\s+/, $args_str ) {
    $params{ lc $1 } = $2 if $token =~ m{^([\w\-]+)=(.*)$};
}

## require at least one filter : refuse naked reset ##
return {
    'mode' => qw| false |,
    'data' =>
        'reset requires a filter : status= stage= job_id= enc_error= rep-err='
    }
    unless %params;

## never reset user-decision stages regardless of other filters ##
my %protected
    = map { $ARG => 1 } qw| applied interviewed responded rejected archived |;

## fields cleared on reset ##
my @clear_fields = qw|
    score score_reason score_summary
    assertions stage
    repair_attempted repair_failed repair_applied
    |;

my $jobs_dir = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite jobs |;

my $tasks = <jobsite.tasks> // {};

## build candidate list ##
my @candidates;
if ( defined $params{'job_id'} ) {
    ## decode short encoded ids [ e.g. 'ZKP5U' ] to the raw numeric form    ##
    ## <jobsite.tasks>/<jobsite.job.index>/job.read/job.write all key on -- ##
    ## without this, a short id is used as-is under the wrong key, silently ##
    ## creating a near-empty record that collides on disk with the real job ##
    ## [ vax-int.encode of the real numeric id produces the same filename   ##
    ## the bogus string-keyed write also lands on ]                         ##
    push @candidates, map { <[base.vax-int.decode]>->($ARG) }
        map { uc $ARG }
        grep { length $ARG } split /[,\s]+/, $params{'job_id'};
} else {
    my %seen = map { $ARG => 1 } keys %{$tasks};
    ## also scan job files for statuses not tracked in-memory (e.g. ##
    ## blocked)                                                     ##
    if ( defined $params{'status'} ) {
        my $status_val = $params{'status'};
        my $status_dir = "$jobs_dir/$status_val";
        if ( -d $status_dir and opendir my $dh, $status_dir ) {
            for my $fn ( readdir $dh ) {
                next unless $fn =~ m{^([A-Z2-7]+)\.yaml$};
                my $jid = <[base.vax-int.decode]>->($1);
                next if $seen{$jid};
                push @candidates, $jid;
            }
            closedir $dh;
        }
    }
    push @candidates, keys %{$tasks};
}

## enc_error: use cfg_bool so yes/true/1/5 all work ##
my $check_encoding
    = exists $params{'enc_error'}
    ? <[base.cfg_bool]>->( $params{'enc_error'} )
    : undef;

my ( $n_reset, $n_protected ) = ( 0, 0 );

for my $job_id (@candidates) {
    my $rec = $tasks->{$job_id};

    ## for jobs not in-memory (e.g. blocked), read status from index for ##
    ## filters                                                           ##
    my $rec_status = defined $rec ? ( $rec->{'status'} // '' ) : do {
        my $idx = <jobsite.job.index>->{$job_id} // '';
        $idx =~ s/^(blocked|deleted):.*/$1/;
        $idx;
    };
    my $rec_stage = defined $rec ? ( $rec->{'stage'} // '' ) : '';

    ## always skip protected stages ##
    if ( $protected{$rec_stage} ) {
        $n_protected++;
        next;
    }

    ## status filter ##
    next
        if defined $params{'status'}
        and $rec_status ne $params{'status'};

    ## stage filter ##
    next
        if defined $params{'stage'}
        and $rec_stage ne $params{'stage'};

    ## enc_error filter : scan raw file bytes for double-encoded marker ##
    if ( defined $check_encoding ) {
        my $enc_id   = <[base.vax-int.encode]>->($job_id);
        my $job_file = do {
            my $idx_status = <jobsite.job.index>->{$job_id} // '';
            if ( $idx_status =~ m{^(blocked|deleted):(.+)$} ) {
                "$jobs_dir/$1/$2/$enc_id.yaml";
            } elsif ( length $idx_status ) {
                "$jobs_dir/$idx_status/$enc_id.yaml";
            } else {
                '';
            }
        };
        my $broken = FALSE;
        if ( length $job_file and -f $job_file ) {
            open my $fh, '<:raw', $job_file or next;
            my $raw = do { local $/; <$fh> };
            close $fh;
            $broken = TRUE if $raw =~ /\xc3\x83/;
        }
        next if $check_encoding     and not $broken;
        next if not $check_encoding and $broken;
    }

    ## rep-err filter : check YAML field directly ##
    if ( exists $params{'rep-err'} ) {
        my $want     = <[base.cfg_bool]>->( $params{'rep-err'} );
        my $enc_id   = <[base.vax-int.encode]>->($job_id);
        my $job_file = do {
            my $idx_status = <jobsite.job.index>->{$job_id} // '';
            $idx_status =~ m{^(blocked|deleted):(.+)$}
                ? "$jobs_dir/$1/$2/$enc_id.yaml"
                : (
                length $idx_status ? "$jobs_dir/$idx_status/$enc_id.yaml"
                : ''
                );
        };
        my $has_flag = FALSE;
        if ( length $job_file and -f $job_file ) {
            open my $fh, '<', $job_file or next;
            $has_flag = TRUE if grep {m|^repair_failed:\s*[15]|} <$fh>;
            close $fh;
        }
        next if $want     and not $has_flag;
        next if not $want and $has_flag;
    }

    ## reset in-memory record if present ##
    if ( defined $rec ) {
        delete $rec->{$ARG} for @clear_fields;
        $rec->{'status'} = qw| new |;
    }

    ## reset per-job file ##
    my $job = <[jobsite.job.read]>->($job_id) // {};
    delete $job->{$ARG} for @clear_fields;
    $job->{'status'} = qw| new |;
    <[jobsite.job.write]>->( $job_id, $job );

    $n_reset++;
}

<[jobsite.state.persist]> if $n_reset;

<[base.logs]>->(
    1,        'jss.reset : reset=%d protected_skipped=%d',
    $n_reset, $n_protected
);

return {
    'mode' => qw| true |,
    'data' => sprintf 'reset %d job%s%s',
    $n_reset, <[base.cnt_s]>->($n_reset),
    $n_protected ? " [$n_protected protected skipped]" : ''
};

