## [:< ##

# name  = workflow.load_workspace_index
# descr = load or generate workspace-transfer index

my $workspace_index = <workflow.index.workspace>;

if (<[workflow.index_needs_regeneration]>->($workspace_index)) {
    return <[workflow.generate_workspace_index]>;
}

my $index_data;
eval {
    $index_data = YAML::XS::LoadFile($workspace_index);
};

if ($@) {
    # If load fails, regenerate
    return <[workflow.generate_workspace_index]>;
}

return $index_data;

