## [:< ##

# name  = graphics-matrix.cmd.harmonic-coords
# descr = show 3D harmonic coordinates for input
# param = <input-string>

my $input = $call->{'args'} // '';
return { 'mode' => 'false', 'data' => 'expected input' }
    unless length $input;

my ( $x, $y, $z ) = <[graphics-matrix.harmonic.coords]>->( \$input );

return {
    'mode' => 'size',
    'data' => sprintf( "x: %s  y: %s  z: %s", $x, $y, $z )
};

