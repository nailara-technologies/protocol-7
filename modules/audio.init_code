## [:< ##

# name = audio.init_code

<[base.perlmod.load]>->(qw| PDL |);
<[base.perlmod.load]>->(qw| PDL::FFT |);
<[base.perlmod.load]>->(qw| Imager |);
<[base.perlmod.load]>->( 'File::Path', qw| make_path | );
<[base.perlmod.load]>->(qw| IPC::Open3 |);
<[base.perlmod.load]>->(qw| Symbol |);
<[base.perlmod.load]>->(qw| Fcntl |);
<[base.perlmod.load]>->(qw| POSIX |);

<audio.cfg.output_dir>         //= '/var/protocol-7/audio/';
<audio.cfg.sample_rate>        //= 22050;
<audio.cfg.fft_size>           //= 4096;
<audio.cfg.image_size>         //= 512;
<audio.cfg.decode_timeout>     //= 90;
<audio.cfg.max_decode_seconds> //= 600;
## selects audio.render_standing_wave.<style> ##
<audio.cfg.render_style> //= 'v1';
## optional : selects audio.post_process.<name>, applied after render_style ##
## if given -- orthogonal versioning axis, 'none' = no post-process         ##
<audio.cfg.post_process> //= 'none';
## optional : selects audio.overlay.<name>, applied last -- draws new ##
## content (from pcm) as a foreground on top, 'none' = no overlay     ##
<audio.cfg.overlay> //= 'none';

<audio.path.ffmpeg_bin> //= <[base.required_bin_path]>->('ffmpeg');

if ( not -x <audio.path.ffmpeg_bin> ) {
    <[base.log]>->( 0, "[!] 'ffmpeg' binary not found, shutting down..," );
    exit(2);
}

<audio.decode> //= {};

0;

