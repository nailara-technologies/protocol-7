# name  = base.exit_when_empty
# descr = Exit zenka if first parameter is undef, empty or a number < 1

my $value = shift @ARG;

if (   not defined $value
    or $value eq ''
    or $value =~ m|^-?\d+$| and $value < 1 ) {
    ## when irst parameter is empty|undef or a number < 1 : exit with error ##
    <[base.exit]>->(@ARG);    ## <-- passing on remaining parameters ##
} else {
    ## First parameter has value, return it for continued processing ##
    return $value;
}

