## [:< ##

# name  = site-yaml.http.get
# descr = fetch URL, return html string or undef on error

my $url = $ARG[0] // '';
return undef if not length $url;

my $ua  = $data{'site-yaml'}{'ua'};
my $res = $ua->get($url);

if ( not $res->is_success ) {
    <[base.logs]>->(
        0,    'site-yaml.http.get : %s => %s',
        $url, $res->status_line
    );
    return
        $res->code
        ; ## return numeric code — callers can distinguish permanent vs transient ##
}

return $res->decoded_content;

