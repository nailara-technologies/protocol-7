## [:< ##

# name  = graphics.matrix.visual.cubic-layers
# desc  = Build hierarchical sphere layers for cubic-sorted images
#
# input : $by_sphere - hash mapping sphere numbers to image arrays
#         $max_spheres - maximum sphere layer (0-6, default: 6)
#
# output: hash of sphere layers with metadata and statistics

my $by_sphere   = shift // {};
my $max_spheres = shift // 6;

my $SPHERE_DEFS = <[graphics.matrix.visual.sphere]>->(qw| defs |);
my $layers      = {};

for my $sphere ( 0 .. $max_spheres ) {
    my $sphere_images = $by_sphere->{$sphere} // [];

    $layers->{$sphere} = {
        'definition' => $SPHERE_DEFS->{$sphere},
        'count'      => scalar(@$sphere_images),
        'images'     => $sphere_images,
        'cubic_grid' =>
            <[graphics.matrix.visual.build-cubic-grid]>->($sphere_images),
        'color_palette' => $sphere == 0
        ? <[graphics.matrix.visual.extract-palette]>->($sphere_images)
        : undef,
        'statistics' =>
            <[graphics.matrix.visual.sphere-stats]>->($sphere_images),
    };
}

return $layers;

