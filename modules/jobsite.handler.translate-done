## [:< ##

# name  = jobsite.handler.translate-done
# descr = receive german translation of score reason, store and dispatch next

my $call = shift // {};

my $mode   = $call->{'mode'} // '';
my $raw    = $call->{'data'} // '';
my $result = ref $raw ? $raw->$* : $raw;
my $job_id = $call->{'params'}{'job_id'} // '';

my $job_rec = <jobsite.tasks>->{$job_id};

if ( defined $job_rec and lc($mode) ne qw| false | and length $result ) {
    ## strip surrounding whitespace and any stray quotes
    ( my $de = $result ) =~ s{^\s+|\s+$}{}g;
    $de =~ s{^["„]|[""]$}{}g;
    $job_rec->{'score_reason_de'} = $de;

    ## persist to per-job file
    my $job = <[jobsite.job.read]>->($job_id) // {};
    $job->{'score_reason_de'} = $de;
    <[jobsite.job.write]>->( $job_id, $job );

    <[base.logs]>->( 1, 'job %s reason_de stored', $job_id );
} else {
    <[base.logs]>->(
        1,       'translate-done skipped for job %s (mode=%s)',
        $job_id, $mode
    );
}

<[jobsite.state.persist]>;
<[jobsite.dispatch.next]>;    ## proceed to next job in queue

