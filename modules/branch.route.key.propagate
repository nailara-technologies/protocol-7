## [:< ##

# name  = branch.route.key.propagate
# descr = auto-propagate public keys along route
# param = { route_id }

my $params   = shift                 // {};
my $route_id = $params->{'route_id'} // '';

return { 'mode' => 'false', 'data' => 'route id required' }
    unless length $route_id;

my $route = $data{'branch.routes'}{$route_id};
return { 'mode' => 'false', 'data' => 'route not found' }
    unless defined $route;
return { 'mode' => 'false', 'data' => 'route released' }
    if $route->{'state'} eq 'released';

my $hops      = $route->{'hops'} // [];
my $keys      = $route->{'keys'} // {};
my $all_ready = TRUE;

for my $hop_id (@$hops) {
    if ( exists $data{'branch.nodes'}{$hop_id}{'pubkey'}
        and length $data{'branch.nodes'}{$hop_id}{'pubkey'} ) {
        $keys->{$hop_id} = $data{'branch.nodes'}{$hop_id}{'pubkey'};
    } else {
        $all_ready = FALSE;
        <[branch.route.key.request]>->(
            {   'node_id'  => $hop_id,
                'route_id' => $route_id,
            }
        );
    }
}

my $collected = scalar keys %$keys;

if ($all_ready) {
    $route->{'state'} = 'active';
    <[base.logs]>->(
        2,         'branch.route.key.propagate: %s active, %d keys',
        $route_id, $collected
    );

    ## announce if discover layer loaded ##
    if ( defined $code{'branch.discover.announce'} ) {
        <[branch.discover.announce]>->(
            {   'event'    => 'route-ready',
                'route_id' => $route_id,
            }
        );
    }
} else {
    <[base.logs]>->(
        2, 'branch.route.key.propagate: %s pending, %d/%d keys',
        $route_id, $collected, scalar @$hops
    );
}

return { 'mode' => 'true', 'data' => $collected };

