# name  = llama-server-vision.handler.read_batch_output
# descr = non-blocking I/O handler - read output chunks from batched vision CLI

my $event = shift->w;
my $read_fh = $event->fd;
my $io_data = $event->data;

my $batch_id = $io_data->{'batch_id'};
my $stream = $io_data->{'stream'};

my $batch_job = <llama-server-vision.jobs>->{$batch_id};

unless ( defined $batch_job ) {
    $event->cancel if $event->is_active;
    return;
}

# Read available data (non-blocking)
my $bytes = <[base.s_read]>->(
    $read_fh,
    \$batch_job->{'output'},
    8 * 1024  # Read up to 8KB at a time
) // 0;

<[base.logs]>->( 2, "[read_batch_output] batch=%s stream=%s bytes=%d", $batch_id, $stream, $bytes )
    if $bytes > 0;

# Check for EOF
if ( $bytes <= 0 ) {
    # EOF reached on this stream
    $batch_job->{ $stream eq 'stdout' ? 'rdr_closed' : 'err_closed' } = 1;
    close($read_fh);
    $event->cancel if $event->is_active;
    <[base.logs]>->( 2, "[read_batch_output] EOF: batch=%s stream=%s", $batch_id, $stream );
}

