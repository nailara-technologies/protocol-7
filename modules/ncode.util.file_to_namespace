# name  = ncode.util.file_to_namespace
# descr = derive p7 dot-notation namespace from a module file path
# param = $path [ e.g. modules/ncode.regex.expand -> ncode.regex.expand ]

my $path = shift // '';

return '' unless length $path;

## only flat p7 module paths carry a derivable namespace : take the name ##
## below the modules/ directory [ no deeper hierarchy exists there ]     ##
return '' unless $path =~ m{(?:^|/)modules/([^/]+)$};

my $namespace = $1;

## strip a real source extension if any [ p7 modules themselves have none ] ##
$namespace =~ s{\.(?:pl|pm|t)$}{};

return $namespace;

