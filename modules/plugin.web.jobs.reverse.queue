## [:< ##

# name  = plugin.web.jobs.reverse.queue
# descr = append a reverse change entry for jobsite to pick up on next push

my $entry = shift // {};    ## hashref: { id, action, fields... }

return FALSE if ref $entry ne 'HASH' or not length( $entry->{'id'} // '' );

$entry->{'ntime'} = <[base.ntime.b32]>;

<plugin.web.jobs.reverse> //= [];
push @{<plugin.web.jobs.reverse>}, $entry;

return TRUE;

