# name  = source.extract_sig_body

my $src_ref = shift;
my $strip   = shift // '';
my $mode    = shift // 'strict';    # Options: 'strict', 'repair', 'info'

warn 'expected source_str scalar reference <{C1}>' and return undef
    if not length ref $src_ref;

<[base.s_warn]>->( 'got ref-type %s , want SCALAR <{C1}>', ref $src_ref )
    and return undef
    if ref $src_ref ne qw| SCALAR |;

my $footer_data = {
    qw| was-present               | =>  0,
    qw| structure-was-valid       | =>  0,
    qw| footer-length-found       | =>  0,
    qw| amos-iterations-remaining | => -1,
    qw| endline-state-encoded     | =>  5,     ##  endline state unchanged  ##
    qw| amos-payload-checksum     | => undef,
    qw| checksum-type             | => undef,
    qw| bmw-chksum                | => undef,
    qw| signature-type            | => undef,
    qw| signature                 | => undef,
    qw| signature-footer-str      | => undef,
    qw| footer-start-line         | => undef,
    qw| encountered-error         | => undef,
    qw| data-reference            | => $src_ref
};

$strip = $strip eq qw| strip | ? 1 : 0;
my $bit_size = <source.chksum_bitsize>;
<[base.s_warn]>->(
    "invalid keyword '%s' for 'strip' parameter <{C1}>", $strip
    )
    and return undef
    if $strip !~ m,^[0|1]$,;

### extract [ optionally strip ] code signature footer #######################
my $footer_body;
my $footer_start;
my $footer_start_regex = qr|#[\.,]{77}|;    #.......,.......,......., [..,]
my $footer_start_regex_length = 78;         ##  manually acquired  ##

<[base.logs]>->(
    3,     ': source.extract_sig_body called with mode: %s, strip: %s',
    $mode, $strip ? 'TRUE' : 'FALSE'
);

my $seperator_endline_absent = 0;

if ($strip) {    ##  NOTE :  also matches\strips old type \ multiple  ##
       # Try the standard pattern first (for backward compatibility)
       # Match blank line separator: just a newline before the signature start
       # This represents the blank line between content and signature

    # Define signature patterns for standard extraction
    my @signature_line_patterns = (
        qr|#.*?AMOS7.*?DATA-SIGNATURE.*|,       # DATA signature
        qr|#.*?AMOS7.*?TEXT-SIGNATURE.*|,       # TEXT signature
        qr|#.*?AMOS7.*?TRANSIT-SIGNATURE.*|,    # TRANSIT signature
        qr|#.*?AMOS7.*?CODE-SIGNATURE.*|,       # CODE signature
        qr|#.*?AMOS7.*?YOURUM\s*::|,            # Classic format
        qr|#.*?SIGNATURE.*|                     # Generic signature mention
    );

    my $standard_regex_matched = 0;
    my $matched_signature_type = "";

    # Try each pattern
    foreach my $sig_pattern (@signature_line_patterns) {
        <[base.logs]>->( 3, ': trying standard pattern: %s', $sig_pattern );

# Match from footer start marker through all content lines to the colon line (end marker)
# This ensures we capture the complete signature block regardless of line count
# The pattern captures: (separator)(start marker) then (all body lines including colon with final newline)
# The separator is a blank line: optional newline before the footer start
        my $pattern
            = qr/(\n)?(# _{78}|$footer_start_regex)\n((?:#[^\n]+\n)+)$/s;

        <[base.logs]>->( 3, ': attempting complete signature extraction' );

        # Use match-only first to capture groups correctly
        if ( $$src_ref =~ m/$pattern/ ) {

            # Capture groups immediately while they're valid
            my $capture_separator = $1 // '';
            my $capture_start     = $2 // '';
            my $capture_body      = $3 // '';

            # Now do the substitution
            my $matched = ( $$src_ref =~ s/$pattern//sg );

            if ($matched) {
                $standard_regex_matched = 1;
                $matched_signature_type = $sig_pattern;
                $footer_start           = $capture_start;
                $footer_body            = $capture_body;

                # Check for missing separator endline
                $seperator_endline_absent = 1
                    if length($$src_ref)    # content remains
                    and not length($capture_separator)
                    ;                       # no separator was found

                # Restore separator if it was present
                if ( length($capture_separator) ) {
                    $$src_ref .= "\n";
                }

                <[base.logs]>->(
                    3, ': standard extraction matched signature type: %s',
                    $matched_signature_type
                );
                $footer_data->{'signature_type_detected'}
                    = $matched_signature_type;
                last;
            }
        }
    }

    # If in repair mode, try a more flexible approach when standard fails
    if ( !$standard_regex_matched && $mode ne 'strict' ) {
        <[base.logs]>->(
            3, ': attempting flexible signature extraction for repair'
        );

        # Define more comprehensive signature marker patterns
        my @signature_markers = (
            qr|DATA[-\s]SIGNATURE|,       # Standard pattern
            qr|TEXT[-\s]SIGNATURE|,       # Text signature
            qr|TRANSIT[-\s]SIGNATURE|,    # Transit signature
            qr|CODE[-\s]SIGNATURE|,       # Code signature
            qr|SIGNATURE|                 # Generic signature
        );

        my $start_marker = qr|#[\s\.,_]{70,80}|
            ;    # More flexible start marker for start line
        my $end_marker
            = qr|#[:\.]+[\s\n]*|;    # End line pattern (colons or periods)

        # Look for signature parts in the content
        my $content_copy
            = $$src_ref;    # Work on a copy to avoid modifying original yet
        my $found_signature = 0;

        <[base.logs]>->(
            3, ': flexible repair mode searching for signatures'
        );

        # Try each signature marker pattern
        foreach my $signature_marker (@signature_markers) {
            <[base.logs]>->(
                3, ': trying flexible signature marker: %s',
                $signature_marker
            );

    # Try different patterns - from specific to more general
    # These patterns use concrete regex anchors without variable interpolation
    # Using {} delimiter to avoid conflicts with | in file content
            my @extraction_patterns = (

    # Pattern 1: Require separator + AMOS7 keyword + data/signature indicators
    # Most specific: needs newline separator, AMOS7 presence, and colon footer
                qr{(.*?)(\n#[\.,]{70,80}\n(?:#[^\n]*AMOS7[^\n]*\n)*?(?:#[^\n]*SIGNATURE[^\n]*\n)*?#[:]{70,80}\n?)$}s,

          # Pattern 2: With separator, require either AMOS7 or YOURUM marker
          # Requires exact marker structure: separator + dot/comma start + end
                qr{(.*?)(\n#[\.,]{70,80}\n(?:#[^\n]*(?:AMOS7|YOURUM)[^\n]*\n)*?#[:]{70,80}[\s\n]*?)$}s,

     # Pattern 3: No separator required, but require clear signature markers
     # Fallback when separator missing: require YOURUM or SIGNATURE in content
                qr{(.*?)(#[\.,]{70,80}\n(?:#[^\n]*(?:AMOS7|YOURUM|SIGNATURE)[^\n]*\n)*?#[:]{70,80}[\s\n]*)$}s,

         # Pattern 4: Most lenient but strict on markers
         # Last resort: just need recognizable footer markers and some content
                qr{(.*?)(#[\.,\s\.]{70,80}\n(?:#[^\n]+\n)*?#[:]{65,}[\s\n]*)$}s
            );

            foreach my $pattern (@extraction_patterns) {
                if ( $content_copy =~ m/$pattern/ ) {
                    my $content_part = $1;
                    my $sig_part     = $2;

                    <[base.logs]>->(
                        3, ': found signature with marker: %s',
                        $signature_marker
                    );
                    <[base.logs]>->( 3, ': signature part: %s', $sig_part );

                    # Extract the footer start line and body
                    if ( $sig_part =~ m|^(#[^\n]+)\n(.*?)$|s ) {
                        $footer_start = $1;
                        $footer_body  = $2;

                        # Remove signature from content
                        $$src_ref = $content_part;

                        # Set flags for repair
                        $seperator_endline_absent                = 1;
                        $footer_data->{'needs_signature_repair'} = TRUE;
                        $footer_data->{'original_signature'}     = $sig_part;
                        $footer_data->{'signature_type_detected'}
                            = $signature_marker;

                        <[base.logs]>->(
                            0,
                            ': successfully extracted signature for repair with marker: %s',
                            $signature_marker
                        );
                        $found_signature = 1;
                        last;    # Exit the inner loop
                    }
                }
            }

            last if $found_signature;    # Exit the outer loop if found
        }

        # If flexible extraction also failed, log it with debug details
        if ( !$found_signature && $mode eq 'repair' ) {
            <[base.logs]>->( 2, ': flexible signature extraction failed' );

            # Debug output at verbosity level 3 only (use -vvv to see)
            my $content_len = length($content_copy);
            my $has_amos7   = ( $content_copy =~ /AMOS7/ ) ? 'YES' : 'NO';
            my $has_signature
                = ( $content_copy =~ /SIGNATURE/ ) ? 'YES' : 'NO';
            my $has_yourum = ( $content_copy =~ /YOURUM/ ) ? 'YES' : 'NO';
            my $has_data_sig
                = ( $content_copy =~ /DATA[-\s]SIGNATURE/ ) ? 'YES' : 'NO';
            my $last_200_chars = substr( $content_copy, -200 );

            <[base.logs]>->( 3, ': flexible extraction failure details:' );
            <[base.logs]>
                ->( 3, ':   Content length: %d bytes', $content_len );
            <[base.logs]>->( 3, ':   Contains AMOS7: %s', $has_amos7 );
            <[base.logs]>
                ->( 3, ':   Contains SIGNATURE: %s', $has_signature );
            <[base.logs]>->( 3, ':   Contains YOURUM: %s', $has_yourum );
            <[base.logs]>->(
                3, ':   Contains DATA-SIGNATURE: %s',
                $has_data_sig
            );
            <[base.logs]>->( 3, ':   Last 200 chars:' );

            foreach my $line ( split /\n/, $last_200_chars ) {
                <[base.logs]>->( 3, ':     | %s', $line );
            }

     # CRITICAL FIX: When flexible extraction fails BUT the original file
     # contains signature markers, we should NOT treat this as "no signature"
     # Instead, return with recovery flags so verification phase can handle it
            if ( $has_signature eq 'YES' ) {
                <[base.logs]>->(
                    2,
                    ': signature markers found but flexible extraction failed - returning for recovery'
                );
                <[base.logs]>->( 2, ': :. proceeding with recovery mode' );

                # Mark that we found signatures but couldn't extract them
                $footer_data->{'extraction_failed_with_markers'} = TRUE;
                $footer_data->{'flexible_extraction_failed'}     = TRUE;
                $footer_data->{'was-present'}                    = 1;

                # Return early so verification phase can attempt BMW recovery
                # This prevents treating the file as first-time signing
                return $footer_data;
            }
        }
    }
} else {

    # Non-strip path - just detect signature without stripping

    # Define signature patterns for detection
    my @signature_line_patterns = (
        qr|#.*?AMOS7.*?DATA-SIGNATURE.*|,       # DATA signature
        qr|#.*?AMOS7.*?TEXT-SIGNATURE.*|,       # TEXT signature
        qr|#.*?AMOS7.*?TRANSIT-SIGNATURE.*|,    # TRANSIT signature
        qr|#.*?AMOS7.*?CODE-SIGNATURE.*|,       # CODE signature
        qr|#.*?AMOS7.*?YOURUM\s*::|,            # Classic format
        qr|#.*?SIGNATURE.*|                     # Generic signature mention
    );

    my $found_signature        = 0;
    my $matched_signature_type = "";
    my $capture_separator      = '';

    <[base.logs]>->( 3, ': non-strip mode, searching for signatures' );

    # Try each pattern
    foreach my $sig_pattern (@signature_line_patterns) {
        <[base.logs]>->( 3, ': non-strip trying pattern: %s', $sig_pattern );

# Match from separator+start marker through all content lines to the colon line (end marker)
# This ensures we detect the complete signature block regardless of line count
# Captures all body lines (including colon line) with their trailing newlines
# The separator is a blank line: optional newline before the footer start
        my $pattern = qr/(\n)?($footer_start_regex)\n((?:#[^\n]+\n)+)$/s;

        <[base.logs]>->(
            3, ': non-strip attempting complete signature detection'
        );

        if ( $$src_ref =~ m/$pattern/ ) {

            # Capture groups immediately while they're valid
            $capture_separator = $1 // '';    # Separator endline (optional)
            $footer_start      = $2 // ''
                ; # Start marker (capture group 2, since group 1 is separator)
            $footer_body = $3 // ''
                ;   # All content lines including colon line (capture group 3)
            $found_signature        = 1;
            $matched_signature_type = $sig_pattern;
            <[base.logs]>->(
                2, ': non-strip mode found signature, type: %s',
                $matched_signature_type
            );
            last;
        }

        # Break outer loop if found
        last if $found_signature;
    }

    $footer_body //= '';
    $footer_data->{'signature_type_detected'} = $matched_signature_type
        if $found_signature;

    $seperator_endline_absent = 1    ## missing endline ##
        if length($$src_ref)
        > ( length( $footer_start // '' ) + length( $footer_body // '' ) )
        and not length($capture_separator);
}

#### [ remove ? # missing ? ]  [LLL]

$footer_data->{'data-chksum'}    ## adding first footer line to BMW-chksum ##
    = <[chk-sum.bmw.strsum]>->( $$src_ref . "$footer_start\n", $bit_size )
    if defined $footer_start;

####

# If NO signature was found at all, we're doing first signing
# In that case, ensure separator endline will be added
if ( not defined $footer_body ) {

# Before claiming "no signature present", verify the content doesn't have markers
# This check must happen REGARDLESS OF MODE to correctly detect existing signatures
    my $content_has_markers
        = $$src_ref =~ /SIGNATURE|YOURUM|AMOS7|DATA[-\s]SIGNATURE/;

    if ($content_has_markers) {

# Check if file has signature marker but missing separator endline before it
# This happens when signature exists but is directly at end without blank line
        my $has_separator_issue
            = (    $$src_ref =~ /#[\.,]{70,80}\n(?:#[^\n]+\n)+#[:]{70,80}/
                && $$src_ref !~ /\n#[\.,]{70,80}\n/ );

        if ($has_separator_issue) {

            # Signature exists but missing separator endline
            <[base.logs]>->( 2, ': [ no separator endline present ]' );
            <[base.logs]>->(
                2, ': [ signature footer at end without blank line ]'
            );
            $footer_data->{'extraction_failed_with_markers'} = TRUE;
            $footer_data->{'flexible_extraction_failed'}     = TRUE;
            $footer_data->{'was-present'}                    = 1;
            $footer_data->{'needs_separator_endline'}        = TRUE;
            return $footer_data;
        }

        # File contains signature markers but extraction failed
        # Set recovery flags so verification can handle it (in all modes)
        $footer_data->{'extraction_failed_with_markers'} = TRUE;
        $footer_data->{'flexible_extraction_failed'}     = TRUE;
        $footer_data->{'was-present'}                    = 1;
        <[base.logs]>->(
            2,
            ': [ existing signature but extraction failed - marking for recovery ]'
        );
        return $footer_data;
    }

    # Only now claim "no signature present" if truly no markers found
    $footer_data->{'needs_separator_endline'} = TRUE;
    <[base.logs]>->( 2, ': [ no signature present ]' );
    <[base.logs]>->( 2, ': [ initial signing ]' );
    <[base.logs]>->( 2, '+ < adding separator endline >' );
    return $footer_data;    ## keeping current checksum ##
}

$footer_data->{'was-present'} = 1;    ## had a signature footer ##

$footer_data->{'footer-start-line'} = sprintf "%s\n", $footer_start;

$footer_data->{'signature-footer-str'}
    = join( "\n", $footer_start, $footer_body );

my $footer_length = 1 + $footer_start_regex_length + length $footer_body;

$footer_data->{'footer-length-found'} = $footer_length;

## Multiple signature templates may have different sizes
## We completely bypass size check in repair mode - any size is acceptable
if ( $mode eq 'strict' && $footer_length != length <source.sign_template> )
{    ## [ ERR: length ]
    $footer_data->{'encountered-error'}
        = sprintf 'data signature footer size mismatch [ %d != %d ]',
        $footer_length, length <source.sign_template>;
    return $footer_data;
} elsif ( $mode ne 'strict'
    && $footer_length != length <source.sign_template> ) {

    # In repair mode, we allow any size and continue without error
    <[base.logs]>->(
        3, ': size mismatch but allowing in repair mode [%d vs %d]',
        $footer_length, length <source.sign_template>
    );
    $footer_data->{'template_size_mismatch'} = TRUE;
    $footer_data->{'footer_length'}          = $footer_length;
    $footer_data->{'template_length'}        = length <source.sign_template>;
}

my $signed_chksum;
my $signature_B32;

### comparing footer structure with signature template #######################

my $match_template = <source.sign_template>;

## In repair mode, we'll continue regardless of footer start pattern
if ($mode eq 'strict'
    && ( not defined $footer_start
        || $match_template !~ s|^$footer_start_regex\n|| )
) {
    $footer_data->{'encountered-error'}
        = 'data signature footer structure not valid'
        . ' [ footer-start not matched ]';
    return $footer_data;
} elsif (
    $mode ne 'strict'
    && ( not defined $footer_start
        || $match_template !~ s|^$footer_start_regex\n|| )
) {
    <[base.logs]>->( 2, ': footer start pattern mismatch' );
    <[base.logs]>->( 2, ': :. continuing in repair mode' );
    $footer_data->{'footer_start_mismatch'} = TRUE;

    # Try a more flexible start line regex for repair mode
    if ( defined $footer_start && $match_template !~ s|^#[\s\.,_]{70,}|| ) {
        <[base.logs]>->(
            3, ': attempting with more flexible footer start pattern'
        );
    } else {
        <[base.logs]>->(
            3, ': continuing with structure validation despite mismatch'
        );
    }
}
my $emptied_footer = $footer_data->{'signature-footer-str'};

# Different signature templates might have different offsets and lengths
# We'll try to adapt if in repair mode
my @subst_params = ( ( 80, 77 ), ( 163, 51 ), ( 242, 52 ) );
my $line_num     = 0;

# Check if repair mode needed for substr processing
my $empty_footer_len = length($emptied_footer);
my $need_repair      = 0;

# In repair mode, adapt to different signature formats
if ( $mode ne 'strict' ) {

    # Check if any position is beyond the footer length
    foreach my $i ( 0, 2, 4 ) {
        if (   $i < scalar(@subst_params)
            && $subst_params[$i] >= $empty_footer_len ) {
            $need_repair = 1;
            <[base.logs]>->(
                3, ': param position %d exceeds footer length %d, adapting',
                $subst_params[$i], $empty_footer_len
            );
            last;
        }
    }
}

# Extract signature parts safely
if ( $need_repair && $mode ne 'strict' ) {

    # Simple alternative: try to extract based on patterns
    <[base.logs]>->(
        3, ': using alternative signature extraction in repair mode'
    );

    # Look for the patterns typical in signatures
    if ( $emptied_footer =~ m/#\\\\\\\\([A-Z0-9]+)/ ) {
        $signed_chksum = $1;
        <[base.logs]>->( 3, ': found checksum: %s', $signed_chksum );
    }

    if ( $emptied_footer =~ m/#\\\\\[7\]([A-Z0-9]+)/ ) {
        $signature_B32 = $1;
        <[base.logs]>->( 3, ': found signature: %s', $signature_B32 );
    }

    # Mark as repaired
    $footer_data->{'signature_extracted_by_pattern'} = TRUE;
} else {

    # Standard extraction
    while (@subst_params) {
        my $pos = shift @subst_params;
        my $len = shift @subst_params;

        # Safety check to prevent substr errors
        if ( $pos >= $empty_footer_len ) {
            <[base.logs]>->(
                3,    ': position %d exceeds footer length %d, skipping',
                $pos, $empty_footer_len
            );
            next;
        }

        # Adjust length if needed to prevent going past end of string
        if ( $pos + $len > $empty_footer_len ) {
            $len = $empty_footer_len - $pos;
            <[base.logs]>->(
                3, ': adjusted length to %d to stay within footer', $len
            );
        }

        $signature_B32 .= substr $emptied_footer, $pos, $len, '_' x $len;
        $signed_chksum = $signature_B32 and $signature_B32 = ''
            if 0 == $line_num++;
    }
}

## Remove the actual extracted first line from the footer copy for comparison
( my $match_footer = $emptied_footer ) =~ s|^\Q$footer_start\E\n||;

## Also remove the template's first line for fair comparison
$match_template =~ s|^[^\n]+\n||;

## In repair mode, we completely bypass the template comparison
if ( $mode eq 'strict' && $match_footer ne $match_template )
{    ## [ ERR: structural ]
    $footer_data->{'encountered-error'}
        = 'data signature footer structure not valid [ template mismatch ]';
    return $footer_data;
} elsif ( $mode ne 'strict' && $match_footer ne $match_template ) {
    <[base.logs]>->( 2, ': template mismatch but continuing in repair mode' );
    $footer_data->{'template_mismatch'} = TRUE;
}

if ($seperator_endline_absent) {

    # Always store the information regardless of mode
    $footer_data->{'needs_separator_endline'} = TRUE;

    # Check if the last line is also incomplete
    my $last_line_incomplete = ( $$src_ref !~ m/\n$/ );
    $footer_data->{'last_line_incomplete'} = $last_line_incomplete;

    # Issue warning
    map { <[base.logs]>->( 0, ": $ARG" ) }
        ( 'data-signature footer has no', ': separator endline' );

    # Only treat as error in strict mode
    if ( $mode eq 'strict' ) {
        $footer_data->{'encountered-error'}
            = 'data signature footer not valid [ no separator endline ]';
        return $footer_data;    # Early return only in strict mode
    }

    # In repair mode, continue but note we're fixing
    <[base.logs]>->( 0, ": fixing in $mode mode" ) if $mode ne 'strict';

    # Continue processing to allow proper restoration
}

##############################################################################

## decoding AMOS7 [ first ] footer line ##

# Try decoding the AMOS7 header, but handle errors gracefully in repair mode
my $amos7_header;
eval { $amos7_header = <[amos7.decode_octal_bit_header]>->($footer_start); };

# Check for errors or invalid structure
if (   defined $@ && length($@)
    || !defined $amos7_header
    || ( defined $amos7_header && !$amos7_header->{'structure-was-valid'} ) )
{

    # In strict mode, treat as error
    if ( $mode eq 'strict' ) {
        $footer_data->{'encountered-error'}
            = $amos7_header
            ? ( $amos7_header->{'encountered-error'}
                // 'unspecified error in amos bit-header' )
            : 'failed to decode AMOS7 header';
        return $footer_data;
    } else {

        # In repair mode, log but continue
        <[base.logs]>->(
            2, ': AMOS7 header decode error but continuing in repair mode'
        );

        # Set default values
        $footer_data->{'amos7_header_error'}    = TRUE;
        $footer_data->{'amos-payload-checksum'} = 'REPAIRMODE';
        $footer_data->{'endline-state-encoded'} = 5;   # Default endline state
        $footer_data->{'amos-iterations-remaining'} = -1;
    }
} else {

# Decoding was successful
# For state 6/7 with separator restored, skip endline restoration to preserve separator
    my $separator_was_restored = $strip && !$seperator_endline_absent;
    my $state                  = $amos7_header->{'endline-state-encoded'};

    if ( !( $separator_was_restored && ( $state == 6 || $state == 7 ) ) ) {
        <[source.restore_payload_endline_state]>->( $src_ref, $state );
    }

    # Copy data from header
    map { $footer_data->{$ARG} = $amos7_header->{$ARG}; } qw[
        amos-payload-checksum
        endline-state-encoded
        amos-iterations-remaining
    ];
}

##############################################################################

my @err_loc;
push( @err_loc, qw| bmw-chksum | )
    if defined $signed_chksum && $signed_chksum !~ m|^[0-9A-Z]+$|;
push( @err_loc, qw| c25519-b32 | )
    if defined $signature_B32 && $signature_B32 !~ m|^[0-9A-Z]+$|;

if (@err_loc) {    ## [E: alien characters ]
                   # In strict mode, treat as error
    if ( $mode eq 'strict' ) {
        $footer_data->{'encountered-error'}
            = sprintf 'not valid characters in signature data [ %s ]',
            join( ' and ', @err_loc );
        return $footer_data;
    } else {

        # In repair mode, log but continue
        <[base.logs]>->(
            2,
            ': signature contains invalid characters but continuing in repair mode'
        );
        $footer_data->{'invalid_characters'} = TRUE;

        # Try to clean up the signature and checksum if needed
        $signed_chksum =~ s|[^0-9A-Z]||g if defined $signed_chksum;
        $signature_B32 =~ s|[^0-9A-Z]||g if defined $signature_B32;
    }
}

$footer_data->{'structure-was-valid'} = 1;

$footer_data->{'checksum-type'}  = qw| BMW-384-B32 |;  # only ones implemented
$footer_data->{'signature-type'} = qw| C25519-B32 |; # <-- ###################
$footer_data->{'bmw-chksum'}     = $signed_chksum;
$footer_data->{'signature'}      = $signature_B32;

# In repair mode, store the template for signature reconstruction
if ( $mode eq 'repair' ) {
    $footer_data->{'template'} = <source.sign_template>;
    $footer_data->{'original_separator_endline_absent'}
        = $seperator_endline_absent;

    # Use footer_data signature-footer-str instead of direct variable
    $footer_data->{'original_signature_footer_str'}
        = $footer_data->{'signature-footer-str'}
        if defined $footer_data->{'signature-footer-str'};

    # Log what we're doing
    <[base.logs]>->(
        3, ': storing signature template for possible reconstruction'
    );
}

return $footer_data;

