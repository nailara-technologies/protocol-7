# name  = base.cmd.src-ver
# descr = running nailara zenka source code version

return { 'mode' => qw| false |, 'data' => 'not defined' }
    if not defined <protocol-7.src-ver>;

return {
    'mode' => qw| true |,
    'data' => ': source[code] version : ' . <protocol-7.src-ver>
    }

