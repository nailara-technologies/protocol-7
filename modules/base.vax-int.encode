## [:< ##

# name  = base.vax-int.encode
# descr = encode a numeric job id to VAX base32 form; pass non-numeric through

my $id = shift // '';

return $id if not length $id;
return $id if $id !~ m|^\d+$|;
return $id if $id > 4294967295;

<[base.perlmod.autoload]>->('Crypt::Misc');

my $encoded = Crypt::Misc::encode_b32r( pack qw| V |, $id );
$encoded =~ s|A+$||;    ## remove zero padding ##
$encoded = qw| A | if not length $encoded;

return $encoded;

