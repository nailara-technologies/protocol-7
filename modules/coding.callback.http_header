## [:< ##

# name  = coding.callback.http_header
# descr = HTTP header received callback for async streaming

my ( $task_id, $headers ) = @ARG;

<[base.logs]>->(
    2,        "async.request: headers received for %s [HTTP %s]",
    $task_id, $headers->{'Status'}
);

## reset retry count on successful connection ##
if ( $headers->{'Status'} =~ m{^2} ) {
    my $state = <[coding.async.state_manager]>->( 'get', $task_id );
    if ( $state && ( $state->{'retry_count'} // 0 ) > 0 ) {
        <[coding.async.state_manager]>->(
            'set', $task_id, { retry_count => 0 }
        );
        <[base.logs]>->(
            2, "async.request: retry count reset for %s", $task_id
        );
    }
}

return;

