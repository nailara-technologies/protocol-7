## [:< ##

# name  = models.cmd.get_model_path
# descr = retrieve model metadata by ID, alias, or AMOS checksum
# return = { mode, data } YAML-encoded model entry or error string

use YAML::XS qw| Dump |;

## extract model_id from call parameters
my $model_id
    = $call->{'param'}->{'model_id'} || $call->{'call_args'}->{'model_id'};

unless ($model_id) {
    if ( $call->{'args'} && length( $call->{'args'} ) ) {
        ($model_id) = split( /\s+/, $call->{'args'} );
    }
}

<[base.logs]>->( 1, '[models.cmd] get_model_path: %s', $model_id // 'NONE' );

unless ($model_id) {
    return { 'mode' => 'size', 'data' => "error: model_id required\n" };
}

## unified lookup: aliases -> definitions -> discovered registry
my $entry = <[models.resolve.entry]>->($model_id);

unless ($entry) {
    return {
        'mode' => 'size',
        'data' => "error: model not found: $model_id\n"
    };
}

return { 'mode' => 'size', 'data' => Dump($entry) };

