## [:< ##

# name = index.address
# descr = return numerical address for a token

my $token = shift // $ARG;

return -1 if defined $token and $token eq '';    ## '' is -1, the root ##

my @path;
for my $depth ( 0 .. length($token) - 1 ) {
    my $prefix = substr( $token, 0, $depth + 1 );
    push @path, <index.addr>->{"$depth:$prefix"} // undef;
}
return \@path;

