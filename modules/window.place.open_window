## [:< ##

# name  = window.place.open_window
# descr = create and run the interactive placement window

my $geometry = shift // {};

$ENV{'DISPLAY'}     = <x11.display>;
$ENV{'GDK_BACKEND'} = 'x11';           ## force XWayland under WSL/Wayland ##
delete $ENV{'WAYLAND_DISPLAY'};

<[base.perlmod.autoload]>->('Gtk3');
<[base.perlmod.autoload]>->('Cairo');
<[base.perlmod.autoload]>->('Glib');

Gtk3->init;

my $window = <window.place.obj.window> = Gtk3::Window->new('toplevel');

$window->signal_connect( delete_event => sub {<[window.place.cancel]>} );

$window->set_decorated(0);
$window->set_keep_above(1);
$window->set_app_paintable(1);
$window->set_accept_focus(1);
$window->set_focus_on_map(1);
$window->set_title('window.place');

## apply initial geometry ##
<[window.place.apply_geometry]>->( $window, $geometry );

## RGBA visual ##
my $screen = $window->get_screen;
my $rgba   = $screen->get_rgba_visual();
$window->set_visual($rgba) if $rgba;

## event masks ##
$window->add_events(
    [   qw| button-press-mask button-release-mask pointer-motion-mask key-press-mask |
    ]
);

## connect signals ##
$window->signal_connect(
    draw => sub {
        eval { <[window.place.handler.draw]>->(@ARG) };
        if ( length $EVAL_ERROR ) {
            <[base.log]>->( 0, <[base.str.eval_error]>->(1) );
        }
        return TRUE;
    }
);

$window->signal_connect(
    'button-press-event' => sub {
        eval { <[window.place.handler.button_press]>->(@ARG) };
        if ( length $EVAL_ERROR ) {
            <[base.log]>->( 0, <[base.str.eval_error]>->(1) );
        }
        return TRUE;
    }
);

$window->signal_connect(
    'button-release-event' => sub {
        eval { <[window.place.handler.button_release]>->(@ARG) };
        if ( length $EVAL_ERROR ) {
            <[base.log]>->( 0, <[base.str.eval_error]>->(1) );
        }
        return TRUE;
    }
);

$window->signal_connect(
    'motion-notify-event' => sub {
        eval { <[window.place.handler.motion]>->(@ARG) };
        if ( length $EVAL_ERROR ) {
            <[base.log]>->( 0, <[base.str.eval_error]>->(1) );
        }
        return TRUE;
    }
);

$window->signal_connect(
    'key-press-event' => sub {
        my $ret = eval { <[window.place.handler.key_press]>->(@ARG) };
        if ( length $EVAL_ERROR ) {
            <[base.log]>->( 0, <[base.str.eval_error]>->(1) );
        }
        return defined $ret ? $ret : TRUE;
    }
);

$window->show_all;
$window->grab_focus;

<[base.log]>->( 1, '[place.open_window] window shown, entering main loop' );

<[base.gtk.main_loop]>;

<[base.log]>->( 1, '[place.open_window] left main loop' );

0;

