## [:< ##

# name  = index.persist
# descr = save corpus data compressed to zenka_dir [ .zxps ]

<[base.perlmod.autoload]>->( 'Storable', qw( nfreeze ) );

my $state = {
    'meta'  => { %{ <index.meta> // {} } },
    'freq'  => { %{ <index.freq> // {} } },
    'level' => {
        map { $ARG => { %{ <index.level>->{$ARG} } } }
            keys %{ <index.level> // {} }
    },
};

my $frozen;
IO::Compress::Xz::xz( \( nfreeze($state) ), \$frozen )
    or return <[base.log]>->( 1, 'index.persist: xz compression failed' );

my $rel_path = qw| numerical/numerical-index_state.zxps |;
my $written  = <[base.file.zenka_dir.write]>->( $rel_path, \$frozen );

return <[base.log]>->( 1, "index.persist: write failed [ $rel_path ]" )
    if not $written;

my $total = <index.meta>->{'total'} // 0;
<[base.log]>->( 1, "index persisted [ $total chars -> $rel_path ]" );

return TRUE;

