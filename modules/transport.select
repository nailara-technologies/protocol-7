## [:< ##

# name  = transport.select
# descr = select and connect best transport for given context (async)
# args  = $context_hash, $reply
#         $reply may be a coderef invoked as $reply->( $handle_or_undef ),
#         or a hashref { handler => 'name', params => {...} } that is
#         dispatched as $code{handler}->({ handle => ..., params => ... }).
# returns nothing meaningful; result delivered via $reply.

my ( $ctx, $reply ) = @ARG;
return undef if not defined $ctx;

## deliver final result to caller ##
my $finish = sub {
    my $handle = shift;
    if ( ref $reply eq qw| CODE | ) {
        $reply->($handle);
    } elsif ( ref $reply eq qw| HASH |
        and defined $reply->{'handler'}
        and exists $code{ $reply->{'handler'} } ) {
        $code{ $reply->{'handler'} }->(
            {   'handle' => $handle,
                'params' => $reply->{'params'} // {},
            }
        );
    }
    return;
};

## get profile name ##
my $profile_name = <[transport.profile.match]>->($ctx);
my $profile      = <[transport.profile.load]>->($profile_name);

my $dest = $ctx->{'session'}{'destination'} // $ctx->{'request'}{'domain'}
    // $profile_name;

## fallback to hardcoded direct-tcp if no profile ##
if ( not defined $profile ) {
    <[base.logs]>->(
        1, 'transport.select: no profile for %s, using direct-tcp',
        $profile_name
    );
    my $handle = <[transport.handle.direct-tcp]>->( {}, $ctx );
    $finish->($handle);
    return;
}

my $transports = $profile->{'transports'} // [];
my $fallback   = $profile->{'fallback'}   // 'direct-tcp';

## async handlers that take a continuation as third arg ##
my %async_handlers = map { $_ => 1 } qw|
    quic-hysteria
    udt-tunnel
    |;

my @queue = @$transports;
my $try_next;
$try_next = sub {

    if ( not @queue ) {
        ## all primary transports failed: try fallback ##
        <[base.logs]>->(
            1,
            'transport.select: all primary transports failed for %s,'
                . ' trying fallback %s',
            $dest,
            $fallback
        );

        my $fallback_handler = sprintf 'transport.handle.%s', $fallback;
        if ( exists $code{$fallback_handler} ) {
            my $fb_entry    = { 'type' => $fallback, 'endpoint' => $dest };
            my $on_fallback = sub {
                my $handle = shift;
                if ( defined $handle ) {
                    <transport.registry>->{'active'}{$dest} = {
                        'type'    => 'fallback:' . $fallback,
                        'handle'  => $handle,
                        'started' => <[base.time]>->(4),
                    };
                    $ctx->{'transport'}{'degraded'} = TRUE;
                    $finish->($handle);
                    return;
                }
                <[base.logs]>->(
                    0, 'transport.select: fallback also failed for %s', $dest
                );
                $finish->(undef);
                return;
            };
            if ( $async_handlers{$fallback} ) {
                $code{$fallback_handler}->( $fb_entry, $ctx, $on_fallback );
            } else {
                my $handle = $code{$fallback_handler}->( $fb_entry, $ctx );
                $on_fallback->($handle);
            }
            return;
        }
        <[base.logs]>->(
            0, 'transport.select: fallback also failed for %s', $dest
        );
        $finish->(undef);
        return;
    }

    my $entry = shift @queue;
    my $type  = $entry->{'type'};
    if ( not defined $type ) {
        $try_next->();
        return;
    }

    ## check demotion ##
    my $demoted = <transport.registry>->{'demoted'}{$dest}{$type};
    if ( defined $demoted ) {
        <[base.logs]>->(
            2,     'transport.select: %s demoted for %s, skipping',
            $type, $dest
        );
        $try_next->();
        return;
    }

    ## check min_quality if we have quality data ##
    my $quality = <transport.registry>->{'quality'}{$type}{$dest};
    if ( defined $quality and exists $entry->{'min_quality'} ) {
        my $min = $entry->{'min_quality'};
        if ( exists $min->{'loss_max'}
            and defined $quality->{'loss_rate'} ) {
            if ( $quality->{'loss_rate'} > $min->{'loss_max'} ) {
                <[base.logs]>->(
                    'transport.select: %s quality too low for %s'
                        . ' (loss %.2f > %.2f)',
                    $type, $dest, $quality->{'loss_rate'},
                    $min->{'loss_max'}
                );
                <[transport.demote]>->(
                    $dest, $type, 'quality_below_threshold'
                );
                $try_next->();
                return;
            }
        }
    }

    my $handler = sprintf 'transport.handle.%s', $type;
    if ( not exists $code{$handler} ) {
        <[base.logs]>->( 0, 'transport.select: no handler for %s', $type );
        $try_next->();
        return;
    }

    my $on_handle = sub {
        my $handle = shift;
        if ( defined $handle ) {
            <transport.registry>->{'active'}{$dest} = {
                'type'    => $type,
                'handle'  => $handle,
                'started' => <[base.time]>->(4),
            };

            <transport.registry>->{'quality'}{$type}{$dest} //= {
                'loss_rate'            => 0.0,
                'rtt_ms'               => 0,
                'goodput_kbps'         => 0,
                'last_measured'        => <[base.time]>->(4),
                'consecutive_failures' => 0,
            };

            <[base.logs]>->(
                2,     'transport.select: %s active for %s',
                $type, $dest
            );
            $finish->($handle);
            return;
        }
        <[transport.demote]>->( $dest, $type, 'connection_failed' );
        $try_next->();
        return;
    };

    if ( $async_handlers{$type} ) {
        $code{$handler}->( $entry, $ctx, $on_handle );
    } else {
        my $handle = $code{$handler}->( $entry, $ctx );
        $on_handle->($handle);
    }
    return;
};

$try_next->();

return;

