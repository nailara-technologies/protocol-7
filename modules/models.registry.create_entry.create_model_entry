# name  = models.registry.create_entry.create_model_entry
# descr = Create a new model entry in the registry

my ( $model_amos, $metadata ) = @ARG;

return {} unless $model_amos && $metadata;

my $entry = {
    amos_checksum => $model_amos,
    metadata      => $metadata // {},
    statistics    => {
        total_invocations => 0,
        success_rate      => 100,
        days_active       => 0,
    },
    resource_profile =>
        { storage => { size_gb => $metadata->{size_gb} // 10 }, },
    presence_decision => {
        currently_present => 1,
        presence_tier     => 'local',
    },
    created_at => time(),
};

return $entry;

