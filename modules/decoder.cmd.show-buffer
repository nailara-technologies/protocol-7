## [:< ##

# name  = decoder.cmd.show-buffer
# param = [stream_id]
# descr = show raw bit buffer feeding level-5 B32 accumulation

my $params    = shift // {};
my $stream_id = $params->{'args'};

my $l5_streams = <decoder.level5> // {};

return { 'mode' => qw| false |, 'data' => 'no level-5 streams active' }
    unless keys %{$l5_streams};

my @lines;

if ( defined $stream_id and length $stream_id ) {
    ## single stream detail ##
    my $s = $l5_streams->{$stream_id};
    return {
        'mode' => qw| false |,
        'data' => "stream $stream_id not found"
        }
        unless defined $s;

    my $acc         = $s->{'accumulator'} // '';
    my $bit_cnt     = $s->{'bit_count'}   // 0;
    my $to_boundary = 5 - ( $bit_cnt % 5 );
    $to_boundary = 5 if $to_boundary == 5;

    push @lines,
        sprintf( "stream     : %s",                     $stream_id ),
        sprintf( "bit_count  : %d",                     $bit_cnt ),
        sprintf( "to_boundary: %d bits until next B32", $to_boundary ),
        sprintf( "buffer_len : %d bits",                length $acc ),
        sprintf( "preview    : %s", substr( $acc, 0, 80 ) );

} else {
    ## summary of all streams ##
    push @lines,
        sprintf( "level-5 bit buffers: %d streams",
        scalar keys %{$l5_streams} );

    for my $sid ( sort { $a <=> $b } keys %{$l5_streams} ) {
        my $s           = $l5_streams->{$sid};
        my $acc         = $s->{'accumulator'} // '';
        my $bit_cnt     = $s->{'bit_count'}   // 0;
        my $to_boundary = 5 - ( $bit_cnt % 5 );
        $to_boundary = 5 if $to_boundary == 5;

        push @lines,
            sprintf( "  stream %-3s | bits:%3d | to_b32:%d | preview:%s",
            $sid, $bit_cnt, $to_boundary, substr( $acc, 0, 20 ) );
    }
}

return {
    'mode' => qw| size |,
    'data' => join( "\n", @lines )
};

