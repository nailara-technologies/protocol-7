## [:< ##

# name  = letsencr.init_code
# descr = Initialize Let's Encrypt certificate manager zenka with ACME support and renewal pipeline
# todo  = ACME client implementation, challenge handlers, renewal scheduler

<[base.perlmod.autoload]>->('JSON::PP');
<[base.perlmod.autoload]>->('LWP::UserAgent');
## CSR certificate key generation [ Ed25519 ECDSA via OpenSSL ]

<[base.log]>
    ->( 2, "initializing Let's Encrypt certificate manager zenka..," );

# Initialize Let's Encrypt configuration
<letsencr.cfg.enabled>
    = <[base.cfg_bool]>->( <letsencr.cfg.enabled> // TRUE );
<letsencr.cfg.environment> = <letsencr.cfg.environment> // qw| production |;
<letsencr.cfg.email>       = <letsencr.cfg.email>       // 'admin@localhost';
<letsencr.cfg.domains>     = <letsencr.cfg.domains>     // '';
<letsencr.cfg.renewal_check_interval>
    = <letsencr.cfg.renewal_check_interval> || 86400;

# ACME server configuration
my $acme_base
    = <letsencr.cfg.environment> eq qw| staging |
    ? qw| https://acme-staging-v02.api.letsencrypt.org/directory |
    : qw| https://acme-v02.api.letsencrypt.org/directory |;

<letsencr.cfg.acme_server>    = <letsencr.cfg.acme_server> || $acme_base;
<letsencr.cfg.challenge_type> = <letsencr.cfg.challenge_type>
    // qw| http-01 |;
<letsencr.cfg.challenge_port> = <letsencr.cfg.challenge_port> // 80;

# Paths
<letsencr.cfg.cert_dir> = <letsencr.cfg.cert_dir> // '/etc/protocol-7/certs';
<letsencr.cfg.key_dir>  = <letsencr.cfg.key_dir>  // '/etc/protocol-7/keys';
<letsencr.cfg.account_key_path> = <letsencr.cfg.account_key_path>
    // '/etc/protocol-7/letsencr/account.key';

# Renewal settings
<letsencr.cfg.auto_renewal_enabled> = <letsencr.cfg.auto_renewal_enabled>
    // TRUE;
<letsencr.cfg.renewal_threshold> = <letsencr.cfg.renewal_threshold>
    // 2592000;
<letsencr.cfg.notify_renewal_start> = <letsencr.cfg.notify_renewal_start>
    // TRUE;
<letsencr.cfg.notify_renewal_complete>
    = <letsencr.cfg.notify_renewal_complete> // TRUE;
<letsencr.cfg.notify_renewal_failure> = <letsencr.cfg.notify_renewal_failure>
    // TRUE;

# Certificate registry
<letsencr.certificates> = {};    # Domain => cert info mapping
<letsencr.renewals>     = {};    # Domain => renewal status

# Renewal scheduling
<letsencr.scheduled_renewals>   = [];
<letsencr.in_progress_renewals> = {};

# Performance metrics
<letsencr.metrics> = {
    renewal_attempts     => 0,
    renewal_successes    => 0,
    renewal_failures     => 0,
    certificates_issued  => 0,
    current_active_certs => 0,
    avg_renewal_time     => 0,
};

# Error handling
<letsencr.errors>     = [];
<letsencr.last_error> = undef;

## Create certificate directories
my $cert_dir = <letsencr.cfg.cert_dir>;
my $key_dir  = <letsencr.cfg.key_dir>;

foreach my $dir ( $cert_dir, $key_dir ) {
    <[file.make_path]>->( $dir, 0750, <system.amos-zenka-user> )
        or <[base.logs]>->(
            0,
            "warning: could not create directory '%s'", $dir
        );
}

<[base.log]>->( 2, "Let's Encrypt manager initialization complete" );
<[base.logs]>->( 2, ": Environment    : %s", <letsencr.cfg.environment> );
<[base.logs]>->( 2, ": ACME Server    : %s", <letsencr.cfg.acme_server> );
<[base.logs]>->( 2, ": Challenge Type : %s", <letsencr.cfg.challenge_type> );
<[base.logs]>->(
    2,
    ": Auto-Renewal : %s",
    ( <letsencr.cfg.auto_renewal_enabled> ? 'enabled' : 'disabled' )
);
<[base.logs]>->( 2, ": Certificate Directory : ", $cert_dir );

0;

