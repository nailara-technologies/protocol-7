## [:< ##

# name  = X-11.emit.screen-change
# descr = push screen-change event to all registered handler subscribers.
#         args: $width, $height (optional; reads cached dims if omitted)

my $width  = shift // <x11.screen.width>  // 0;
my $height = shift // <x11.screen.height> // 0;

my $subs = <X-11.screen_change_subscribers> // [];
return unless @$subs;

## a single-line format is required here, not YAML::XS::Dump's multi-line  ##
## output - confirmed live: each YAML line got misread as a separate stray ##
## command by cube's line-oriented protocol, corrupting the command stream ##
## on every screen-change event. never caught before since the subscriber ##
## list was always empty until tonight.                                   ##
my $ntime   = <[base.time]>->(3);
my $payload = sprintf(
    'event=screen.change width=%d height=%d ntime=%s',
    $width + 0,
    $height + 0,
    $ntime
);

foreach my $handler (@$subs) {
    <[protocol-7.route-send]>->(
        {   'command'   => $handler,
            'call_args' => { 'args' => $payload },
        }
    );
}

<[base.logs]>->(
    2, ': screen-change emitted [ %dx%d ] to %d subscriber(s)',
    $width, $height, scalar @$subs
);

