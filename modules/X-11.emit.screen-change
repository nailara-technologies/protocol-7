# name  = X-11.emit.screen-change
# descr = push screen-change event to all registered STRM listeners.
#         args: $width, $height (optional; reads cached dims if omitted)

my $width  = shift // <x11.screen.width>  // 0;
my $height = shift // <x11.screen.height> // 0;

my $listeners = <X-11.screen_change_listeners> // [];
return if not @$listeners;

my $payload = sprintf( "%d %d\n", $width + 0, $height + 0 );

my @keep;
for my $h (@$listeners) {
    push @keep, $h if <[base.stream.push]>->( $h, \$payload );
}
<X-11.screen_change_listeners> = \@keep;

<[base.logs]>->(
    2, ': screen-change emitted [ %dx%d ] to %d listener(s)',
    $width, $height, scalar @keep
);

return;

