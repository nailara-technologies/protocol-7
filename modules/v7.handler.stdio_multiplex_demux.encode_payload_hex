# name  = v7.handler.stdio_multiplex_demux.encode_payload_hex
# param = $payload_sref  [ scalar ref to raw bytes ]
# descr = encode a scalar-ref payload to a lowercase hex string

my ($payload_sref) = @ARG;

return ''
    if not defined $payload_sref
    or ref $payload_sref ne qw| SCALAR |;

my $bytes = $payload_sref->$*;
return '' if not length $bytes;

return unpack( qw| H* |, $bytes );

