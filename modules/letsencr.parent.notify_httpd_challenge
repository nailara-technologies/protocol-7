# name  = letsencr.parent.notify_httpd_challenge
# descr = notify HTTPd to serve HTTP-01 ACME challenge response

my $challenge_info = shift;

my $domain   = $challenge_info->{domain};
my $token    = $challenge_info->{token};
my $key_auth = $challenge_info->{key_auth};
my $type     = $challenge_info->{type} // 'http-01';

unless ( $domain && $token && $key_auth ) {
    <[base.log]>->( 1, 'error: missing required challenge parameters' );
    return {
        status => 'failed',
        error  => 'missing domain, token, or key_auth'
    };
}

<[base.logs]>->(
    2,     "notifying HTTPd to serve %s challenge for %s",
    $type, $domain
);

## send challenge setup command to HTTPd
## [ parameters as space-separated args: domain token key_auth type ]
my $challenge_cmd = 'httpd.cmd.setup-acme-challenge';
my $args_string   = sprintf '%s %s %s %s', $domain, $token, $key_auth, $type;

my $result = <[base.protocol-7.command.send.local]>->(
    {   'command'   => $challenge_cmd,
        'call_args' => { 'args' => $args_string }
    }
);

if ($result) {
    <[base.logs]>->( 2, "HTTPd challenge setup queued for %s", $domain );
    return {
        status  => qw| success |,
        message => sprintf( 'challenge response setup sent to HTTPd for %s',
            $domain )
    };
} else {
    <[base.logs]>->(
        1, 'failed to queue challenge setup to HTTPd for %s', $domain
    );
    return {
        status => qw| failed |,
        error  => 'failed to queue command to HTTPd'
    };
}

