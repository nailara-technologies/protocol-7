## [:< ##

# name = models.cmd.discover
# descr = Discover all available models in registry

my $cmd = shift @ARG;  # Remove command name from @ARG
my ($filter) = @ARG;
$filter //= 'all';

# Load registry - call extracted module directly
my $all_models = <[models.registry.list_all.list_all_models]>->();

# Apply filter
my @discovered;
foreach my $model (@$all_models) {
  next if $filter eq 'available' && !$model->{presence_decision}->{currently_present};
  next if $filter eq 'unavailable' && $model->{presence_decision}->{currently_present};

  push @discovered, {
    'amos' => $model->{amos_checksum},
    'name' => $model->{metadata}->{name},
    'version' => $model->{metadata}->{version},
    'category' => $model->{metadata}->{category},
    'available' => $model->{presence_decision}->{currently_present},
    'size_gb' => $model->{resource_profile}->{storage}->{size_gb},
    'success_rate' => $model->{statistics}->{success_rate},
    'total_invocations' => $model->{statistics}->{total_invocations},
    'presence_tier' => $model->{presence_decision}->{presence_tier},
  };
}

# Sort by success rate
@discovered = sort {
  $b->{success_rate} <=> $a->{success_rate}
} @discovered;

my $reply_str = '';
$reply_str .= "filter: $filter\n";
$reply_str .= "count: " . scalar(@discovered) . "\n";
$reply_str .= "\n";

foreach my $model (@discovered) {
  $reply_str .= "amos: " . $model->{amos} . "\n";
  $reply_str .= "  name: " . $model->{name} . "\n";
  $reply_str .= "  version: " . ($model->{version} // 'unknown') . "\n";
  $reply_str .= "  category: " . ($model->{category} // 'uncategorized') . "\n";
  $reply_str .= "  available: " . ($model->{available} ? 'yes' : 'no') . "\n";
  $reply_str .= "  size_gb: " . ($model->{size_gb} // 'unknown') . "\n";
  $reply_str .= "  success_rate: " . sprintf('%.2f', $model->{success_rate} // 0) . "\n";
  $reply_str .= "  total_invocations: " . ($model->{total_invocations} // 0) . "\n";
  $reply_str .= "  presence_tier: " . ($model->{presence_tier} // 'unknown') . "\n";
  $reply_str .= "\n";
}

return { 'mode' => qw| size |, 'data' => $reply_str };

