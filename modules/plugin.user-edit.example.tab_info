## [:< ##

# name  = plugin.user-edit.example.tab_info
# descr = minimal reference plugin's self-description
# param = -none-

## THROWAWAY / reference only -- see plugin.user-edit.example.init_code's own
## note.  pins 'location', an existing default field, purely so the registry
## has a real by_key entry to verify against.

return {
    qw| label |       => qw| example |,
    qw| pinned_keys | => [qw| location |],
};

