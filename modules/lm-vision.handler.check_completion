## [:< ##

# name  = lm-vision.handler.check_completion
# descr = check if vision job is complete (process exited AND all data read)

my $watcher = shift->w;
my $job_id  = $watcher->data;

<[base.logs]>
    ->( 2, "[check_completion] exception event for job=%s", $job_id );

my $vision_job = <lm-vision.jobs>->{$job_id};

unless ( defined $vision_job ) {
    <[base.logs]>->( 1, "[check_completion] job not found: %s", $job_id );
    $watcher->cancel if $watcher->is_active;
    return;
}

# If already processed, cancel this handler and return
if ( $vision_job->{'processed'} ) {
    <[base.logs]>->( 2, "[check_completion] already processed, cancelling" );
    $watcher->cancel if $watcher->is_active;

    # Also cancel the read handler to prevent warnings
    if ( defined $vision_job->{'rdr_io'} ) {
        $vision_job->{'rdr_io'}->cancel if $vision_job->{'rdr_io'}->is_active;
    }
    return;
}

<[base.logs]>->( 1, "[check_completion] process has exited" );

# Process has exited - read any remaining output
if ( defined $vision_job->{'rdr'} ) {
    while ( sysread( $vision_job->{'rdr'}, my $buf, 4096 ) ) {

        <[lm-vision.parser.process_chunk]>->( \$buf );

        $vision_job->{'output'} .= $buf;
    }
}
if ( defined $vision_job->{'err'} ) {
    while ( sysread( $vision_job->{'err'}, my $buf, 4096 ) ) {

        <[lm-vision.parser.process_chunk]>->( \$buf );

        $vision_job->{'stderr'} .= $buf;
    }
}

# Close filehandles
close( $vision_job->{'rdr'} ) if defined $vision_job->{'rdr'};
close( $vision_job->{'err'} ) if defined $vision_job->{'err'};

# Mark as processed
$vision_job->{'processed'} = TRUE;

# Cancel both event handlers to prevent warnings
$watcher->cancel if $watcher->is_active;
if ( defined $vision_job->{'rdr_io'} ) {
    $vision_job->{'rdr_io'}->cancel if $vision_job->{'rdr_io'}->is_active;
}

<[base.logs]>->( 1, "[check_completion] process exited, processing output" );

# Extract output
my $full_stdout = $vision_job->{'output'};
my $full_stderr = $vision_job->{'stderr'};
my $payload     = '';

<[base.logs]>->(
    1,
    "[check_completion] raw stdout length: %d bytes, stderr length: %d bytes",
    length($full_stdout),
    length($full_stderr)
);

# Determine which buffer has more content (model response is likely in the larger one)
my $primary_buffer
    = length($full_stderr) > length($full_stdout)
    ? $full_stderr
    : $full_stdout;
my $full_output
    = $full_stdout . $full_stderr;    # Still combine both for pattern search

# Log first 300 chars for debugging
if ( length $full_output > 0 ) {
    map { <[base.logs]>->( 1, $ARG ) } split "\n",
        sprintf(
        "[check_completion] %s",
        <[base.wrap_text]>->(
            '', 42,
            sprintf(
                'primary buffer has %d bytes,'
                    . ' combined first 300 chars : %s',
                length($primary_buffer), substr( $full_output, 0, 30 )
            )
        )
        );
}

# Extract model response - output contains token-by-token debug logs interspersed
# Pattern: TEXT[TIMESTAMP] [/path:LINE][FUNCTION] TEXT[TIMESTAMP]...
# We need to aggressively strip ALL debug patterns and keep only the generated text

# Remove "Resampling because..." debug messages (grammar constraint issues)
# These are interspersed with the JSON output and look like:
# "Resampling because token NNN:'text' does not meet grammar rules"
$full_output
    =~ s,Resampling\s+because\s+token\s+\d+:[^}]*?does\s+not\s+meet\s+grammar\s+rules\s*,,g;

# Remove all timestamp patterns: [10 digits]
$full_output =~ s,\[\d{10}\]\s*,,g;

# Remove all file path patterns: [/path: digits]
$full_output =~ s{\[\/[^\]]*\]\s*}{}g;

# Replace all function/label patterns with spaces: [generate_response], [   main   ], etc.
# Handle spaces inside brackets: \[\s*[a-z_]+\s*\]
# Use space replacement to prevent word merging
$full_output =~ s{\[\s*[a-z_]+\s*\]}{}g;

# Find and skip the initialization section - everything before model loading completes
# The "main: loading model:" marker indicates the end of initialization
my $init_marker  = 'main: loading model:';
my $init_end_pos = index( $full_output, $init_marker );

<[base.logs]>->(
    1, "[check_completion] init marker search: looking for '%s'", $init_marker
);

if ( $init_end_pos >= 0 ) {

  # Find the end of the model loading line (next newline after the model path)
    my $line_end = index( $full_output, "\n", $init_end_pos );
    if ( $line_end > $init_end_pos ) {

        # Skip to the character after the newline
        $full_output = substr( $full_output, $line_end + 1 );
        map { <[base.logs]>->( 1, $ARG ) } split "\n",
            sprintf(
            "[check_completion] %s",
            <[base.wrap_text]>->(
                '', 42,
                sprintf(
                    'found init marker at %d, skipped %d bytes of init output',
                    $init_end_pos, $line_end + 1
                )
            )
            );
    } else {

      # No newline found, might be at end of buffer - skip from marker onwards
        $full_output = substr( $full_output, $init_end_pos );
        map { <[base.logs]>->( 1, $ARG ) } split "\n",
            sprintf(
            "[check_completion] %s",
            <[base.wrap_text]>->(
                '', 42,
                sprintf(
                    'found init marker at %d, skipped to marker location',
                    $init_end_pos )
            )
            );
    }
} else {
    map { <[base.logs]>->( 1, $ARG ) } split "\n",
        sprintf(
        "[check_completion] %s",
        <[base.wrap_text]>->(
            '',
            42,
            'init marker not found in cleaned output, continuing with pattern matching'
        )
        );
}

# Remove llama_print_timings section and everything after it
my $timing_pos = index( $full_output, 'llama_print_timings' );
if ( $timing_pos > 0 ) {
    $full_output = substr( $full_output, 0, $timing_pos );
}

# Skip analysis_start detection - it's causing hangs with large outputs
# The init marker removal should be sufficient to clean up the output

# Trim and clean up
$full_output =~ s/\s+/ /g;         # Collapse multiple spaces/newlines
$full_output =~ s/^\s+|\s+$//g;    # Trim edges

# Remove spaces after opening braces and brackets
$full_output =~ s/([{\[\"])\s+/$1/g;

# Remove spaces before closing braces and brackets
$full_output =~ s/\s+([}\]"])/$1/g;

# Remove spaces before punctuation (tokenization artifact cleanup)
$full_output =~ s/\s+([,.!?;:'")])/$1/g;

## fix intermixed spaces ##
# <[lm-vision.parser.process_chunk]>->( \$full_output ); #[LLL] for each token

# The cleaned output should now be the vision analysis text
if ( length $full_output )
{    # Sanity check - should be at least somewhat substantial
    $payload = $full_output;
    <[base.logs]>->(
        1, "[check_completion] extracted model response, length: %d bytes",
        length($payload)
    );
} else {
    <[base.logs]>->(
        1, "[check_completion] output empty: '%s'", $full_output
    );
}

$payload .= "\n" if $payload !~ m|\n$|;    ## make sure payload has endline ##

# Store stderr for diagnostic access
$vision_job->{'debug_log'}          = $vision_job->{'stderr'};
$vision_job->{'raw_payload_sample'} = $payload;

if ( length $payload ) {
    $vision_job->{'status'} = qw| completed |;
    <[base.logs]>->(
        1,       "[check_completion] success: job=%s payload_bytes=%d",
        $job_id, length($payload)
    );
    map { <[base.log]>->( 1, $ARG ) } split "\n",
        sprintf(
        "[check_completion] %s",
        <[base.wrap_text]>->(
            '', 42,
            sprintf( 'cleaned payload: %s', substr( $payload, 0, 200 ) )
        )
        );
    <[base.logs]>->(
        1,
        "[check_completion] sending deferred response: reply_id=%s",
        $vision_job->{'reply_id'}
    );
    my $cb_result = <[base.callback.cmd_reply]>->(
        $vision_job->{'reply_id'},
        { 'mode' => 'size', 'data' => $payload }
    );
    <[base.logs]>->(
        1,
        "[check_completion] callback returned: %s",
        $cb_result // 'undef'
    );
} else {
    $vision_job->{'status'} = qw| failed |;
    $vision_job->{'error'}  = 'no response from vision model';
    <[base.logs]>->(
        0, "ERROR: No analysis output from vision CLI: job=%s", $job_id
    );
    <[base.callback.cmd_reply]>->(
        $vision_job->{'reply_id'},
        { 'mode' => 'false', 'data' => 'no response from vision model' }
    );
}

# Schedule cleanup after 70 seconds
<[event.add_timer]>->(
    {   'after'   => 70,
        'handler' => qw| lm-vision.handler.job_cleanup |,
        'data'    => $job_id
    }
);

