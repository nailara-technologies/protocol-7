## [:< ##

# name  = lm-vision.handler.check_completion
# descr = check if vision job is complete (process exited AND all data read)

my $watcher = shift->w;
my $job_id  = $watcher->data;

<[base.logs]>->( 2, "[check_completion] I/O event for job=%s", $job_id );

my $vision_job = <lm-vision.jobs>->{$job_id};

unless ( defined $vision_job ) {
    <[base.logs]>->( 1, "[check_completion] job not found: %s", $job_id );
    $watcher->cancel if $watcher->is_active;
    return;
}

# If already processed, cancel this handler and return
if ( $vision_job->{'processed'} ) {
    <[base.logs]>->( 2, "[check_completion] already processed, cancelling" );
    $watcher->cancel if $watcher->is_active;

    # Also cancel the read handler to prevent warnings
    if ( defined $vision_job->{'rdr_io'} ) {
        $vision_job->{'rdr_io'}->cancel if $vision_job->{'rdr_io'}->is_active;
    }
    return;
}

# First, try to read any available stderr data
# Keep reading while data is available
my $read_bytes = 0;
if ( defined $vision_job->{'err'} ) {
    while ( sysread( $vision_job->{'err'}, my $buf, 4096 ) ) {
        $vision_job->{'stderr'} .= $buf;
        $read_bytes += length($buf);
    }
}

# If we got data, this wasn't EOF yet - just accumulate and return
if ( $read_bytes > 0 ) {
    <[base.logs]>->(
        2, "[check_completion] accumulated %d bytes from stderr, continuing",
        $read_bytes
    );
    return;
}

# If we reach here, sysread returned 0 (EOF) or undef - process the response
<[base.logs]>->(
    1, "[check_completion] process has exited, processing response"
);

# Process has exited - read any remaining stdout (debug output)
# stderr was already accumulated by the early read at start of handler
if ( defined $vision_job->{'rdr'} ) {
    while ( sysread( $vision_job->{'rdr'}, my $buf, 4096 ) ) {

        # Note: stdout is debug/init output, don't parse it
        $vision_job->{'output'} .= $buf;
    }
}

# Close filehandles
close( $vision_job->{'rdr'} ) if defined $vision_job->{'rdr'};
close( $vision_job->{'err'} ) if defined $vision_job->{'err'};

# Mark as processed
$vision_job->{'processed'} = TRUE;

# Cancel both event handlers to prevent warnings
$watcher->cancel if $watcher->is_active;
if ( defined $vision_job->{'rdr_io'} ) {
    $vision_job->{'rdr_io'}->cancel if $vision_job->{'rdr_io'}->is_active;
}

<[base.logs]>->( 1, "[check_completion] process exited, processing output" );

# Extract output
my $full_stdout = $vision_job->{'output'} // '';
my $full_stderr = $vision_job->{'stderr'} // '';
my $payload     = '';

<[base.logs]>->(
    1,
    "[check_completion] raw stdout length: %d bytes, stderr length: %d bytes",
    length($full_stdout),
    length($full_stderr)
);

# Compare stdout vs stderr to see which is cleaner
# stdout might have model response without debug interleaving
# stderr has both debug output and response mixed together
<[base.logs]>->(
    1, "[check_completion] buffer sizes: stdout_len=%d stderr_len=%d",
    length($full_stdout), length($full_stderr)
);

my $full_output;

# Model response goes to stderr (larger buffer with actual content)
# stdout has init/debug output (device lines, batch size)
# Prefer stderr since it has the actual vision analysis response
$full_output = $full_stderr;
<[base.logs]>->(
    1,
    "[check_completion] using stderr for model response (stdout: %d, stderr: %d bytes)",
    length($full_stdout),
    length($full_stderr)
);

# Log buffer samples for debugging
<[base.logs]>->(
    1,
    "[check_completion] stdout first 80 chars: %s",
    substr( $full_stdout, 0, 80 )
) if length($full_stdout) > 0;
<[base.logs]>->(
    1,
    "[check_completion] stderr first 80 chars: %s",
    substr( $full_stderr, 0, 80 )
) if length($full_stderr) > 0;

# Extract model response - output contains token-by-token debug logs interspersed
# Pattern: TEXT[TIMESTAMP] [/path:LINE][FUNCTION] TEXT[TIMESTAMP]...
# We need to aggressively strip ALL debug patterns and keep only the generated text

# Remove "Resampling because..." debug messages (grammar constraint issues)
# These are interspersed with the JSON output and look like:
# "Resampling because token NNN:'text' does not meet grammar rules"
$full_output =~ s,Resampling\s+because\s+token\s+\d+:[^}]*?does\s+not\s+meet\s+grammar\s+rules\s*,,g;

# First, find where the actual model response starts by looking for known markers
# The model response typically starts after all "load_hparams:" messages and contains actual text
# Look for the first substantial text that isn't initialization content

# Remove all timestamp patterns: [10 digits]
$full_output =~ s,\[\d{10}\]\s*,,g;

# Remove all file path patterns: [/path: digits]
$full_output =~ s{\[\/[^\]]*\]\s*}{}g;

# Replace all function/label patterns: [generate_response], [   main   ], etc.
$full_output =~ s{\[\s*[a-z_]+\s*\]}{}g;

# After cleanup patterns, we should have mostly model response text
# But there may still be extra noise - collapse whitespace and trim

# Remove all debug/initialization lines from output (applies to both stdout and stderr)
# Both buffers may contain debug output interspersed with model response
# Aggressively strip patterns while preserving the actual response text

# Remove build and compiler info
$full_output =~ s/build:\s+\d+[^\n]+\n?//gm;    # "build: 0 (unknown) with cc ..."
$full_output =~ s/XXXXXXXXXXXXXXXXXXXXX[^\n]*\n?//gm;  # "XXXXX Setting only active experts offload"

# Remove chat template examples (both paired and orphaned markers)
$full_output =~ s/<\|im_start\|>.*?<\|im_end\|>\s*//gs;  # Remove <|im_start|>...<|im_end|> blocks
$full_output =~ s/<\|im_start\|>\s*[a-z]*\s*//gi;         # Remove orphaned <|im_start|> markers
$full_output =~ s/<\|im_end\|>\s*//gi;                    # Remove orphaned <|im_end|> markers

# Remove file operation error messages
$full_output =~ s/Failed to open logfile[^\n]+\n?//gm;  # "Failed to open logfile 'llama.log'..."

# Remove CUDA initialization messages
$full_output =~ s/ggml_cuda_init:[^\n]+\n?//gm;         # "ggml_cuda_init: ..."
$full_output =~ s/CUDA\d*:[^\n]+\n?//gm;                # "CUDA0: using device..."
$full_output =~ s/Device\s+\d+:[^\n]+\n?//gm;           # "Device 0: NVIDIA GeForce..."
$full_output =~ s/llama_model_loader:[^\n]+\n?//gm;     # "llama_model_loader: ..."

# Remove model loading debug messages
$full_output =~ s/main:\s+[^\n]+\n?//gm;       # "main: loading model..."
$full_output =~ s/load:\s+[^\n]+\n?//gm;       # "load: ... cache size"
$full_output =~ s/llm_load[^\n]+\n?//gm;       # "llm_load_print_meta: ..."

# Remove load_hparams lines
$full_output =~ s/load_hparams:[^\n]+\n?//gm;  # "load_hparams: ..."
$full_output =~ s/---\s+vision\s+hparams\s+---[^\n]*\n?//gm;  # "--- vision hparams ---"

# Remove vision/image processing debug messages (including inline)
$full_output =~ s/Adjust\s+batch\s+[^\n]+\n?//gm;       # "Adjust batch size..."
$full_output =~ s/encoding\s+image\s+[^\n]+\n?//gm;     # "encoding image..."
$full_output =~ s/decoding\s+image\s+[^\n]+\n?//gm;     # "decoding image..."
$full_output =~ s/image\s+(?:decoded|slice)[^\n]*\n?//gm;  # "image decoded...", "image slice..."
$full_output =~ s/^\s*\d+:\s+(?:CPU|CUDA\d*)[^\n]*\n?//gm;  # "  0: CPU", "  1: CUDA0" with leading spaces

# Remove other common llama.cpp debug prefixes
$full_output =~ s/^(?:alloc_compute_meta|warmup|print_info|clip_[a-z_]+|mtmd_[a-z_]+|llama_[a-z_]+):[^\n]+\n?//gmi;

# Remove llama_print_timings section and everything after it
my $timing_pos = index( $full_output, 'llama_print_timings' );
if ( $timing_pos > 0 ) {
    $full_output = substr( $full_output, 0, $timing_pos );
}

# Trim and clean up
$full_output =~ s/\s+/ /g;         # Collapse multiple spaces/newlines
$full_output =~ s/^\s+|\s+$//g;    # Trim edges

# Remove debug prefix that appears at the start (preserve token output after it)
$full_output =~ s/^print_info:\s+vocab\s+type\s+=\s+BPE\s+//i;  # Remove "print_info: vocab type = BPE" only

# Strip leading BPE padding dots (single '.' tokens generated during model initialization)
$full_output =~ s/^\.+\s*//;  # Remove all leading dots until real content starts

# Remove spaces after opening braces and brackets
$full_output =~ s/([{\[\"])\s+/$1/g;

# Remove spaces before closing braces and brackets
$full_output =~ s/\s+([}\]"])/$1/g;

# Remove spaces before punctuation (tokenization artifact cleanup)
$full_output =~ s/\s+([,.!?;:'")])/$1/g;

## Fix intermixed spaces from Qwen3 BPE tokenization breaks
## Tokens starting with space = word boundary, without space = continuation
## When tokens are output as text with spaces between them, we see: "definit ively"
## Pattern: lowercase + space + lowercase usually means a tokenization break that should be joined

# Initialize dictionary cache if not already done
<lm-vision.word_dict> //= do {
    my %dict;
    if ( open( my $fh, '<', '/usr/share/dict/words' ) ) {
        while (<$fh>) {
            chomp;
            $dict{ lc($_) } = 1;
        }
        close($fh);
        <[base.logs]>->(
            1,
            "[check_completion] loaded %d words from dictionary",
            scalar keys %dict
        );
    } else {
        <[base.logs]>->(
            1, "[check_completion] warning: could not load word dictionary"
        );
    }
    \%dict;
};

my $word_dict = <lm-vision.word_dict>;

# NOTE: The spaces in the output (both intermixed like "styl ized" and missing like "Thiswordis")
# are generated directly from the Qwen3 BPE vocab strings in the model file.
# Each token has its exact text as stored in id_to_token[token_id].text from the GGUF vocab.
# No guessing/heuristics should be applied - the output is truth from the model.

# The cleaned output should now be the vision analysis text
if ( length $full_output )
{    # Sanity check - should be at least somewhat substantial
    $payload = $full_output;
    <[base.logs]>->(
        1, "[check_completion] extracted model response, length: %d bytes",
        length($payload)
    );
} else {
    <[base.logs]>->(
        1, "[check_completion] output empty: '%s'", $full_output
    );
}

$payload .= "\n" if $payload !~ m|\n$|;    ## make sure payload has endline ##

# Store stderr for diagnostic access
$vision_job->{'debug_log'}          = $vision_job->{'stderr'};
$vision_job->{'raw_payload_sample'} = $payload;

if ( length $payload ) {
    $vision_job->{'status'} = qw| completed |;
    <[base.logs]>->(
        1,       "[check_completion] success: job=%s payload_bytes=%d",
        $job_id, length($payload)
    );
    map { <[base.log]>->( 1, $ARG ) } split "\n",
        sprintf(
        "[check_completion] %s",
        <[base.wrap_text]>->(
            '', 42,
            sprintf( 'cleaned payload: %s', substr( $payload, 0, 200 ) )
        )
        );
    <[base.logs]>->(
        1,
        "[check_completion] sending deferred response: reply_id=%s",
        $vision_job->{'reply_id'}
    );
    my $cb_result = <[base.callback.cmd_reply]>->(
        $vision_job->{'reply_id'},
        { 'mode' => 'size', 'data' => $payload }
    );
    <[base.logs]>->(
        1,
        "[check_completion] callback returned: %s",
        $cb_result // 'undef'
    );
} else {
    $vision_job->{'status'} = qw| failed |;
    $vision_job->{'error'}  = 'no response from vision model';
    <[base.logs]>->(
        0, "ERROR: No analysis output from vision CLI: job=%s", $job_id
    );
    <[base.callback.cmd_reply]>->(
        $vision_job->{'reply_id'},
        { 'mode' => 'false', 'data' => 'no response from vision model' }
    );
}

# Schedule cleanup after 70 seconds
<[event.add_timer]>->(
    {   'after'   => 70,
        'handler' => qw| lm-vision.handler.job_cleanup |,
        'data'    => $job_id
    }
);

