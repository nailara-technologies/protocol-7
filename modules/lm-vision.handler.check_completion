## [:< ##

# name  = lm-vision.handler.check_completion
# descr = check if vision job is complete (process exited AND all data read)

my $watcher = shift->w;
my $job_id  = $watcher->data;

<[base.logs]>->( 2, '[check_completion] job=%s : I\O-event', $job_id );

my $vision_job = <lm-vision.jobs>->{$job_id};

unless ( defined $vision_job ) {
    <[base.logs]>->( 1, "[check_completion] job not found : %s", $job_id );

    # Guard: only cancel if watcher is valid
    if (   defined $watcher
        && length ref $watcher
        && $watcher->can('is_active') ) {
        $watcher->cancel if $watcher->is_active;
    }
    return;
}

# If already processed, cancel this handler and return
if ( $vision_job->{'processed'} ) {
    <[base.logs]>->( 2, "[check_completion] already processed, cancelling" );

    # Guard: only cancel if watcher is valid
    if (   defined $watcher
        && length ref $watcher
        && $watcher->can('is_active') ) {
        $watcher->cancel if $watcher->is_active;
    }

    # Also cancel the read handler to prevent warnings
    if ( defined $vision_job->{'rdr_io'} ) {
        if (   defined $vision_job->{'rdr_io'}
            && length ref $vision_job->{'rdr_io'}
            && $vision_job->{'rdr_io'}->can('is_active') ) {
            $vision_job->{'rdr_io'}->cancel
                if $vision_job->{'rdr_io'}->is_active;
        }
    }
    return;
}

## First, try to read any available stderr data
## Keep reading while data is available
my $read_bytes = 0;
if ( defined $vision_job->{'err'} ) {
    while ( sysread( $vision_job->{'err'}, my $buf, 4096 ) ) {
        $vision_job->{'stderr'} .= $buf;
        $read_bytes += length($buf);
    }
}

## If we got data, this wasn't EOF yet - just accumulate and return
if ( $read_bytes > 0 ) {
    <[base.logs]>->(
        2, "[check_batch_completion] stderr += %d bytes", $read_bytes
    );
    return;
}

## If we reach here, sysread returned 0 [EOF]
## or undef - process the response
<[base.logs]>->(
    1, "[check_completion] process has exited, processing response"
);

## Process has exited - read any remaining stdout [ debug output ]
## stderr was already accumulated by the early read at start of handler
if ( defined $vision_job->{'rdr'} ) {
    while ( sysread( $vision_job->{'rdr'}, my $buf, 4096 ) ) {

        ## Note: stdout is debug/init output, don't parse it
        $vision_job->{'output'} .= $buf;
    }
}

## Close filehandles
close( $vision_job->{'rdr'} ) if defined $vision_job->{'rdr'};
close( $vision_job->{'err'} ) if defined $vision_job->{'err'};

## Wait for process to fully terminate and release GPU memory
## This prevents race conditions when consecutive calls are made
if ( defined $vision_job->{'pid'} ) {
    <[base.waitpid]>->( $vision_job->{'pid'}, 0 );
    ## Wait [ blocking ] for child to exit
}

## Mark as processed
$vision_job->{'processed'} = TRUE;

## Cancel both event handlers to prevent warnings
if ( defined $watcher && length ref $watcher && $watcher->can('is_active') ) {
    $watcher->cancel if $watcher->is_active;
}
if (   defined $vision_job->{'rdr_io'}
    && length ref $vision_job->{'rdr_io'}
    && $vision_job->{'rdr_io'}->can('is_active') ) {
    $vision_job->{'rdr_io'}->cancel if $vision_job->{'rdr_io'}->is_active;
}

<[base.logs]>->( 1, "[check_completion] process exited, processing output" );

## Extract output
my $full_stdout = $vision_job->{'output'} // '';
my $full_stderr = $vision_job->{'stderr'} // '';
my $payload     = '';

<[base.logs]>->(
    1,
    "[check_completion] raw stdout length: %d bytes, stderr length: %d bytes",
    length($full_stdout),
    length($full_stderr)
);

## Compare stdout vs stderr to see which is cleaner
## stdout might have model response without debug interleaving
## stderr has both debug output and response mixed together
<[base.logs]>->(
    1, "[check_completion] buffer sizes: stdout_len=%d stderr_len=%d",
    length($full_stdout), length($full_stderr)
);

my $full_output;

## Model response goes to stderr [ larger buffer with actual content ]
## stdout has init/debug output [ device lines, batch size ]
## Prefer stderr since it has the actual vision analysis response
$full_output = $full_stderr;
<[base.logs]>->(
    1,
    "[check_completion] using stderr for model response"
        . " (stdout: %d, stderr: %d bytes)",
    length($full_stdout),
    length($full_stderr)
);

## Log buffer samples for debugging
if ( length($full_stdout) > 0 ) {
    my $stdout_sample = substr( $full_stdout, 0, 80 );
    $stdout_sample =~ s/\n/<newline>/g;
    <[base.logs]>->(
        1,
        "[check_completion] stdout first 80 chars: %s",
        <[base.wrap_text]>->( '', 65, $stdout_sample )
    );
}
if ( length($full_stderr) > 0 ) {
    my $stderr_sample = substr( $full_stderr, 0, 80 );
    $stderr_sample =~ s/\n/<newline>/g;
    <[base.logs]>->(
        1,
        "[check_completion] stderr first 80 chars: %s",
        <[base.wrap_text]>->( '', 65, $stderr_sample )
    );
}

## Extract model response - output contains
## token-by-token debug logs interspersed
## Pattern: TEXT[TIMESTAMP] [/path:LINE][FUNCTION] TEXT[TIMESTAMP]...
## We need to aggressively strip ALL debug patterns
## and keep only generated text

## Remove "Resampling because..." debug messages [ grammar constraint issues ]
## These are interspersed with the JSON output and look like:
## "Resampling because token NNN:'text' does not meet grammar rules"
$full_output =~ s{
    Resampling\s+because\s+token\s+\d+:[^\}]*?
    does\s+not\s+meet\s+grammar\s+rules\s*
}{}gx;

# First, find where the actual model response starts
# by looking for known markers
# The model response typically starts after all
# "load_hparams:" messages and contains actual text
# Look for the first substantial text that isn't initialization content

# Remove all timestamp patterns: [10 digits]
$full_output =~ s,\[\d{10}\]\s*,,g;

# Remove all file path patterns: [/path: digits]
$full_output =~ s{\[\/[^\]]*\]\s*}{}g;

# Replace all function/label patterns: [generate_response], [   main   ], etc.
$full_output =~ s{\[\s*[a-z_]+\s*\]}{}g;

# After cleanup patterns, we should have mostly model response text
# But there may still be extra noise - collapse whitespace and trim

## Remove all debug/initialization lines from output
## [ applies to both stdout and stderr ]
## Both buffers may contain debug output interspersed with model response
## Aggressively strip patterns while preserving the actual response text

## Remove build and compiler info
$full_output =~ s/build:\s+\d+[^\n]+\n?//gm;
## "build: 0 (unknown) with cc ..."
$full_output =~ s/XXXXXXXXXXXXXXXXXXXXX[^\n]*\n?//gm;
## "XXXXX Setting only active experts offload"

## Remove chat template examples [ both paired and orphaned markers ]
$full_output =~ s/<\|im_start\|>.*?<\|im_end\|>\s*//gs;
## Remove <|im_start|>...<|im_end|> blocks
$full_output =~ s/<\|im_start\|>\s*[a-z]*\s*//gi;
## Remove orphaned <|im_start|> markers
$full_output =~ s/<\|im_end\|>\s*//gi;
## Remove orphaned <|im_end|> markers

## Remove file operation error messages
$full_output =~ s/Failed to open logfile[^\n]+\n?//gm;
## "Failed to open logfile 'llama.log'..."

## Remove CUDA initialization messages
$full_output =~ s/ggml_cuda_init:[^\n]+\n?//gm;
## "ggml_cuda_init: ..."
$full_output =~ s/CUDA\d*:[^\n]+\n?//gm;
## "CUDA0: using device..."
$full_output =~ s/Device\s+\d+:[^\n]+\n?//gm;
## "Device 0: NVIDIA GeForce..."
$full_output =~ s/llama_model_loader:[^\n]+\n?//gm;
## "llama_model_loader: ..."

## Remove model loading debug messages
$full_output =~ s/main:\s+[^\n]+\n?//gm;
## "main: loading model..."
$full_output =~ s/load:\s+[^\n]+\n?//gm;
## "load: ... cache size"
$full_output =~ s/llm_load[^\n]+\n?//gm;
## "llm_load_print_meta: ..."

## Remove load_hparams lines
$full_output =~ s/load_hparams:[^\n]+\n?//gm;
## "load_hparams: ..."
$full_output =~ s{---\s+vision\s+hparams\s+---[^\n]*\n?}{}gm;
## "--- vision hparams ---"

## Remove vision/image processing debug messages [ including inline ]
$full_output =~ s/Adjust\s+batch\s+[^\n]+\n?//gm;
## "Adjust batch size..."
$full_output =~ s/encoding\s+image\s+[^\n]+\n?//gm;
## "encoding image..."
$full_output =~ s/decoding\s+image\s+[^\n]+\n?//gm;
## "decoding image..."
$full_output =~ s/image\s+(?:decoded|slice)[^\n]*\n?//gm;
## "image decoded...", "image slice..."
$full_output =~ s/^\s*\d+:\s+(?:CPU|CUDA\d*)[^\n]*\n?//gm;
## "  0: CPU", "  1: CUDA0" with leading spaces

## Remove other common llama.cpp debug prefixes [ various functions ]
$full_output =~ s{
    ^(?:
        alloc_compute_meta | warmup | print_info |
        clip_[a-z_]+ | mtmd_[a-z_]+ | llama_[a-z_]+
    ) : [^\n]+ \n?
}{}gxmi;

# Remove llama_print_timings section and everything after it
my $timing_pos = index( $full_output, 'llama_print_timings' );
if ( $timing_pos > 0 ) {
    $full_output = substr( $full_output, 0, $timing_pos );
}

## Trim and clean up
$full_output =~ s/\s+/ /g;         ## collapse multiple spaces/newlines
$full_output =~ s/^\s+|\s+$//g;    ## trim edges

## Remove debug prefix [ preserve token output after it ]
$full_output =~ s{^print_info:\s+vocab\s+type\s+=\s+BPE\s+}{}i;
## Remove "print_info: vocab type = BPE" only

## Strip leading BPE padding dots [ generated during model initialization ]
$full_output =~ s/^\.+\s*//;   ## remove all leading dots until content starts

## Remove spaces after opening braces and brackets
$full_output =~ s/([{\[\"])\s+/$1/g;

## Remove spaces before closing braces and brackets
$full_output =~ s/\s+([}\]"])/$1/g;

## Remove spaces before punctuation [ tokenization artifact cleanup ]
$full_output =~ s/\s+([,.!?;:'")])/$1/g;

## The cleaned output should now be the vision analysis text
if ( length $full_output ) {
    ## Sanity check - should be at least somewhat substantial
    $payload = $full_output;
    <[base.logs]>->(
        1, "[check_completion] extracted model response, length: %d bytes",
        length($payload)
    );
} else {
    <[base.logs]>->(
        1, "[check_completion] output empty: '%s'", $full_output
    );
}

$payload .= "\n" if $payload !~ m|\n$|;    ## make sure payload has endline ##

## Detect if response is complete or truncated
## Complete: must end with natural punctuation or be very short
## Very conservative: only trust period+closing, or very short responses
my $appears_complete = (
    $payload =~ /[\.\!\?]\s*$/
        ||    ## ends with period, exclamation, or question mark
        length($payload) < 80    ## only short responses without punctuation
);

my $payload_tail
    = length($payload) > 20 ? substr( $payload, -20 ) : substr( $payload, 0 );
$payload_tail =~ s/\n/<newline>/g;

<[base.logs]>->(
    1,
    "[check_completion] response completeness: %s (length=%d bytes)",
    $appears_complete ? 'complete' : 'possibly truncated',
    length($payload)
);

## Store payload and metadata for downstream handlers
## [ completion chain, etc. ]
$vision_job->{'payload'}            = $payload;
$vision_job->{'debug_log'}          = $vision_job->{'stderr'};
$vision_job->{'raw_payload_sample'} = $payload;
$vision_job->{'appears_complete'}   = $appears_complete ? 1 : 0;

if ( length $payload ) {
    $vision_job->{'status'} = qw| completed |;
    <[base.logs]>->(
        1,       "[check_completion] success: job=%s payload_bytes=%d",
        $job_id, length($payload)
    );
    my $payload_sample = substr( $payload, 0, 200 );
    <[base.logs]>->(
        1,
        "[check_completion] cleaned payload (first 200 chars): %s",
        <[base.wrap_text]>->( '', 65, $payload_sample )
    );

    ## Only send response if this is NOT part of a completion chain
    if ( !$vision_job->{'is_completion_chain'}
        && defined $vision_job->{'reply_id'} ) {
        <[base.logs]>->(
            1,
            "[check_completion] sending deferred response: reply_id=%s",
            $vision_job->{'reply_id'}
        );
        <[base.callback.cmd_reply]>->(
            $vision_job->{'reply_id'},
            { 'mode' => 'size', 'data' => $payload }
        );
    } else {
        <[base.logs]>->(
            1, "[check_completion] job complete, response handled by chain"
        );
    }
} else {
    $vision_job->{'status'} = qw| failed |;
    $vision_job->{'error'}  = 'no response from vision model';
    <[base.logs]>->(
        0, "ERROR: No analysis output from vision CLI: job=%s", $job_id
    );

    ## Only send error response if this is NOT part of a completion chain
    if ( !$vision_job->{'is_completion_chain'}
        && defined $vision_job->{'reply_id'} ) {
        <[base.callback.cmd_reply]>->(
            $vision_job->{'reply_id'},
            { 'mode' => 'false', 'data' => 'no response from vision model' }
        );
    }
}

## Schedule cleanup after 70 seconds
<[event.add_timer]>->(
    {   'after'   => 70,
        'handler' => qw| lm-vision.handler.job_cleanup |,
        'data'    => $job_id
    }
);

