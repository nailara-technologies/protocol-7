## [:< ##

# name  = pager.buffer.page.get
# descr = get page from cache or load from source

my ( $buf, $page_num ) = @ARG;

# Cache hit
if ( exists $buf->{'pages'}{'cached'}{$page_num} ) {
    $buf->{'stats'}{'hits'}++;
    _update_lru( $buf, $page_num );
    return $buf->{'pages'}{'cached'}{$page_num};
}

# Cache miss - need to load
$buf->{'stats'}{'misses'}++;

# 1. Evict oldest page if at limit
my $cached = $buf->{'pages'}{'cached'};
if ( scalar( keys %$cached ) >= $buf->{'pages'}{'max_cache'} ) {
    my $evict = shift @{ $buf->{'pages'}{'lru'} };
    if ( defined $evict && exists $cached->{$evict} ) {
        my $evicted_items = scalar( @{ $cached->{$evict} } );
        delete $cached->{$evict};
        $buf->{'memory'}{'current'} -= $evicted_items;
    }
}

# 2. Load from source (may require multiple batches)
my $items = _load_page_items( $buf, $page_num );

return undef unless $items && @$items;

# 3. Apply filter chain
$items = _apply_filters( $buf, $items );

# 4. Apply sort if configured
$items = _apply_sort( $buf, $items ) if $buf->{'sort'};

# 5. Cache and update LRU
$cached->{$page_num} = $items;
push @{ $buf->{'pages'}{'lru'} }, $page_num;
$buf->{'memory'}{'current'}   += scalar(@$items);
$buf->{'stats'}{'items_seen'} += scalar(@$items);

# 6. Trigger prefetch
<[pager.buffer.prefetch]>->(
    {   'buffer_id' => $buf->{'id'},
        'page_num'  => $page_num,
        'direction' => 'forward',
    }
);

return $items;

# Load items for a specific page number
sub _load_page_items {
    my ( $buf, $page_num ) = @ARG;

    my $page_size = $buf->{'pages'}{'size'};
    my $start_idx = $page_num * $page_size;
    my $source    = $buf->{'source'};

    my @items;

    # If source supports random access, use it
    if ( $source->{'get_item_at'} ) {
        for my $i ( 0 .. $page_size - 1 ) {
            my $item = $source->{'get_item_at'}->( $start_idx + $i );
            last unless $item;
            push @items, $item;
        }
        return \@items;
    }

# Otherwise, need to batch through source
# This is inefficient for high page numbers but necessary for streaming sources
    my $current_batch = 0;
    my $target_batch  = int( $start_idx / $page_size );

    while ( $current_batch <= $target_batch ) {
        my $batch = $source->{'next_batch'}->();
        last unless $batch && @$batch;

        if ( $current_batch == $target_batch ) {

            # This is our target page
            my $offset_in_batch = $start_idx % $page_size;
            @items = @$batch[ $offset_in_batch .. $#$batch ];
            @items = @items[ 0 .. $page_size - 1 ] if @items > $page_size;
        }

        $current_batch++;
    }

    return \@items;
}

# Apply filter chain to items
sub _apply_filters {
    my ( $buf, $items ) = @ARG;

    for my $filter_spec ( @{ $buf->{'filters'} } ) {
        my $filter_type   = $filter_spec->{'type'};
        my $filter_params = $filter_spec->{'params'} // {};

        my $filter_mod = "pager.filter.$filter_type";
        if ( exists $data{'calls'}{$filter_mod} ) {
            $items = <[$filter_mod]>->(
                {   'items'  => $items,
                    'params' => $filter_params,
                }
            );
        }
    }

    return $items;
}

# Apply sort to items
sub _apply_sort {
    my ( $buf, $items ) = @ARG;

    my $sort_spec = $buf->{'sort'};
    my $sort_type = $sort_spec->{'type'} // 'multi-key';

    my $sort_mod = "pager.sort.$sort_type";
    if ( exists $data{'calls'}{$sort_mod} ) {
        $items = <[$sort_mod]>->(
            {   'items' => $items,
                'spec'  => $sort_spec,
            }
        );
    }

    return $items;
}

# Update LRU list for a page
sub _update_lru {
    my ( $buf, $page_num ) = @ARG;

    my $lru = $buf->{'pages'}{'lru'};
    @$lru = grep { $ARG != $page_num } @$lru;
    push @$lru, $page_num;
}

