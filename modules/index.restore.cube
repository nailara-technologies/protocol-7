## [:< ##

# name = index.restore.cube
# descr = load schema v4 .zxpc cube file, fall back to v2 .zxps

## try schema v4 cube first ##
my $rel_path = 'numerical/numerical-index_state.zxpc';
my $sref     = <[file.zenka_dir.load]>->($rel_path);

if ( defined $sref ) {
    ## validate magic ##
    if ( length($$sref) >= 256 and substr( $$sref, 0, 4 ) eq 'P7IC' ) {

        ## parse header ##
        my $magic = substr( $$sref, 0, 4 );
        my ( $schema_version, $compat_version, $flags, $max_depth )
            = unpack( 'S S L S', substr( $$sref, 4, 12 ) );

        my $checksum_offset = 30 + 12 * ( $max_depth + 1 );
        if (   $checksum_offset + 8 > 256
            or $checksum_offset + 8 > length($$sref) ) {
            <[base.log]>->(
                1,
                'index.restore.cube: header size exceeds 256 bytes,'
                    . ' falling back to v2'
            );
            goto FALLBACK;
        }

        my @ring_count
            = unpack( 'S*', substr( $$sref, 14, 2 * ( $max_depth + 1 ) ) );

        my $dir_base_offset = 14 + 2 * ( $max_depth + 1 );
        my @dir_base        = unpack( 'Q*',
            substr( $$sref, $dir_base_offset, 8 * ( $max_depth + 1 ) ) );

        my $dir_stride_offset = $dir_base_offset + 8 * ( $max_depth + 1 );
        my @dir_stride        = unpack( 'S*',
            substr( $$sref, $dir_stride_offset, 2 * ( $max_depth + 1 ) ) );

        my $data_offset = $dir_stride_offset + 2 * ( $max_depth + 1 );
        my ( $data_base, $total_size )
            = unpack( 'Q Q', substr( $$sref, $data_offset, 16 ) );

        my $header_checksum
            = unpack( 'A8', substr( $$sref, $checksum_offset, 8 ) );

        ## validate schema version ##
        if ( $schema_version != 4 ) {
            <[base.log]>->(
                1,
                "index.restore.cube: schema $schema_version != 4,"
                    . ' falling back to v2'
            );
            goto FALLBACK;
        }

        ## validate header checksum ##
        my $header_for_chk = substr( $$sref, 0, $checksum_offset );
        my $computed_checksum
            = substr( <[chk-sum.amos]>->($header_for_chk), 0, 8 );
        if ( $computed_checksum ne $header_checksum ) {
            <[base.log]>->(
                1,
                'index.restore.cube: header checksum mismatch,'
                    . ' falling back to v2'
            );
            goto FALLBACK;
        }

        my $header = {
            magic           => $magic,
            schema_version  => $schema_version,
            compat_version  => $compat_version,
            flags           => $flags,
            max_depth       => $max_depth,
            ring_count      => \@ring_count,
            dir_base        => \@dir_base,
            dir_stride      => \@dir_stride,
            data_base       => $data_base,
            total_size      => $total_size,
            header_checksum => $header_checksum,
            checksum_offset => $checksum_offset,
        };

        ## set global state ##
        <index.cube.mmap>   = $sref;
        <index.cube.header> = $header;
        <index.cube.loaded> = {};

        ## eager load rings 0 and 1 ##
        my $total_rings = 0;
        for my $depth ( 0, 1 ) {
            my $count = $header->{'ring_count'}[$depth] // 0;
            next unless $count;
            $total_rings++;
            for my $rank ( 0 .. $count - 1 ) {
                my $comp = <[index.cube.load_compartment]>->( $depth, $rank );
                <index.cube.loaded>->{$depth}{$rank} = $comp
                    if defined $comp;
            }
            <[base.log]>->(
                1,
                "index.restore.cube: ring $depth eager-loaded"
                    . " [ $count compartments ]"
            );
        }

        <[base.log]>
            ->( 1, "index restored from cube [ $total_rings rings ]" );

        ## also load .zxps for main in-memory data structures ##
        <[index.restore]>;

        return TRUE;
    }

    <[base.log]>->(
        1, 'index.restore.cube: invalid magic, falling back to v2'
    );
}

FALLBACK:
## fall back to schema v2 .zxps ##
return <[index.restore]>;

