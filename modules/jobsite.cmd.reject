## [:< ##

# name  = jobsite.cmd.reject
# descr = reject a job from review queue

my $job_id = uc( $call->{'args'} // '' );
$job_id =~ s/^\s+|\s+$//g;

my $rec = <jobsite.tasks>->{$job_id};
return { 'mode' => 'false', 'data' => "unknown job: $job_id" }
    if not defined $rec;

$rec->{'stage'}       = 'rejected';
$rec->{'rejected_at'} = time;

<[base.perlmod.autoload]>->('YAML::XS');
my $store_file = '/var/protocol-7/site-yaml/store.yaml';
if ( -f $store_file ) {
    my $store = eval { YAML::XS::LoadFile($store_file) } // {};
    if ( exists $store->{$job_id} ) {
        $store->{$job_id}{'status'} = 'rejected';
        eval { YAML::XS::DumpFile( $store_file, $store ) };
    }
}

my $tasks = <jobsite.tasks> // {};
my $remaining
    = grep { ( $tasks->{$ARG}{'stage'} // '' ) eq 'review' } keys %{$tasks};

if ( not $remaining and <jobsite.cycle> eq 'reviewing' ) {
    <jobsite.cycle> = 'idle';
    <[base.logs]>->( 1, 'review complete, returning to idle' );
}

<[jobsite.state.persist]>;

return { 'mode' => 'true', 'data' => "rejected: $job_id" };

