## [:< ##

# name  = reasoning.branch.checkpoint
# param = { id, activity_summary, output_so_far }

my $params = shift // {};

## command interface ##
if ( ref $params eq qw| HASH | and exists $params->{'args'} ) {
    my $args = $params->{'args'} // '';
    if ( length $args ) {
        my $parsed = eval { <[format.yaml.load_str]>->($args) };
        $params
            = ( defined $parsed and ref $parsed eq qw| HASH | )
            ? $parsed
            : { id => $args };
    } else {
        $params = {};
    }
}

my $id = $params->{'id'} // '';
return { 'mode' => qw| false |, 'data' => 'branch id required' }
    unless length $id;

my $registry = <reasoning.branch.registry> // {};
my $branch   = $registry->{$id};

return { 'mode' => qw| false |, 'data' => "branch not found: $id" }
    unless defined $branch;

my $summary = $params->{'activity_summary'} // '';
my $output  = $params->{'output_so_far'}    // '';

push $branch->{'checkpoints'}->@*,
    {
    summary       => $summary,
    output_so_far => $output,
    timestamp     => <[base.time]>->(4),
    };

## keep only last 10 checkpoints ##
if ( scalar $branch->{'checkpoints'}->@* > 10 ) {
    shift $branch->{'checkpoints'}->@*;
}

## update stuck score automatically ##
$branch->{'stuck_score'} = <[reasoning.branch.stuck_score]>->($id);

return { 'mode' => qw| true |, 'data' => 'checkpoint saved' };

