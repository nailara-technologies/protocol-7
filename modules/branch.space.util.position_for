## [:< ##

# name  = branch.space.util.position_for
# descr = resolve ranked position for node in scope
# param = $id, $scope

my ( $id, $scope ) = @ARG;
if ( exists $data{'branch.space.positions'}{$scope}{$id} ) {
    return $data{'branch.space.positions'}{$scope}{$id}{'position'} // 0;
}
my $res = <[branch.space.rank]>->(
    {   'node_id' => $id,
        'scope'   => $scope,
    }
);
return $res->{'data'}{'position'} // 0
    if ref $res eq qw| HASH | and $res->{'mode'} eq 'true';
return 0;

