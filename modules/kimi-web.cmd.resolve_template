## [:< ##

# name  = kimi-web.cmd.resolve_template
# descr = resolve P7 context templates for agent preloading
# param = template - template name (e.g., integrate-recent)
# param = vars     - variable substitutions hashref
# param = budget   - token budget (default 8000)

my $args = $call->{'args'} // {};

my $template = $args->{'template'} // '';
my $vars     = $args->{'vars'}     // {};
my $budget   = $args->{'budget'}   // 8000;

if ( not length $template ) {
    return {
        'mode' => qw| false |,
        'data' => 'template name is required'
    };
}

## resolve via context.template.resolve ##
my $resolved = <[context.template.resolve]>->(
    {   'template' => $template,
        'vars'     => $vars,
        'budget'   => $budget,
    }
);

if ( not defined $resolved ) {
    return {
        'mode' => qw| false |,
        'data' => "template '$template' not found or resolution failed"
    };
}

return {
    'mode' => qw| true |,
    'data' => $resolved,
    'meta' => {
        'template'     => $template,
        'budget_used'  => length($resolved),
        'budget_total' => $budget,
    }
};

