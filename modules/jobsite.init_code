## [:< ##

# name  = jobsite.init_code
# descr = initialize scan coordinator, restore state

<[base.perlmod.autoload]>->('YAML::XS');
<[base.perlmod.autoload]>->('File::Path');
<[base.perlmod.autoload]>->('JSON::XS');
<[base.perlmod.autoload]>->('IO::Compress::Xz');
<[base.perlmod.autoload]>->('IO::Uncompress::UnXz');
<[base.perlmod.autoload]>->('Encode');
<[base.perlmod.autoload]>->('HTML::Entities');
<[base.perlmod.autoload]>->('HTML::TreeBuilder');
<[base.perlmod.autoload]>->('HTML::FormatText');
<[base.perlmod.autoload]>->('MIME::QuotedPrint');
<[base.perlmod.autoload]>->('MIME::Base64');
<[base.perlmod.autoload]>->('Encode::MIME::Header');

## ensure jobs storage paths are owned by the jobsite zenka user only on a  ##
## cold start : once privileges are dropped [ reload case ], chown/chmod on ##
## files not already owned by us fails noisily and is a no-op               ##
if ( $EFFECTIVE_USER_ID == 0 ) {
    <[base.path-set-up.check-zenka-paths]>->(
        TRUE, 0750, FALSE, 0700, 'jobs', TRUE
    );
} else {
    <[base.logs]>->(
        2,
        'jobsite: skipping zenka-path ownership '
            . 'check [ privileges already dropped ]'
    );
}

## fallback if cfg/zenki/jobsite/start doesn't set it ##
<jobsite.cfg.assessment_model> //= 'ZDMAPAY:AR3OCKQ';

## cycle-level state
<jobsite.cycle>         = 'idle';
<jobsite.last_scan>     = 0;
<jobsite.pending_count> = 0;

## per-job state lives under jobsite.tasks.<job_id>.*
<jobsite.tasks> //= {};

## in-flight watchdog timers, keyed by job_id -- NOT persisted [ mirrors  ##
## audio.decode's transient-object hash ] : a fresh process has no timers ##
## to restore, they're re-armed by dispatch.next/dispatch.repair as jobs  ##
## are (re)dispatched after restart                                       ##
<jobsite.assess_timer> = {};

## migrate flat layout to status-directory layout (one-time) ##
my $jobs_root = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite jobs |;
if ( glob("$jobs_root/*.yaml") ) {
    <[base.logs]>->(
        1, 'jobsite: migrating flat layout to status directories'
    );
    for my $f ( glob("$jobs_root/*.yaml") ) {
        my $job = eval { YAML::XS::LoadFile($f) };
        if ($@) {
            <[base.logs]>->( 0, 'migrate: load error for %s: %s', $f, $@ );
            next;
        }
        my $id     = $job->{'id'}     // ( $f =~ m{/([^/]+?)\.yaml$} )[0];
        my $status = $job->{'status'} // 'new';
        next if not length $id;

        if ( $status eq 'blocked' ) {
            ## blocked jobs with full content: convert to minimal stub ##
            my $epoch    = <[base.ntime.epoch_timestamp]>;
            my $stub_dir = "$jobs_root/blocked/$epoch";
            if ( not -d $stub_dir ) {
                my $p7_user = <system.amos-zenka-user> // qw| protocol-7 |;
                <[file.make_path]>->( $stub_dir, 0750, $p7_user, $p7_user );
            }
            my $stub = {
                'id'            => $id,
                'url'           => $job->{'url'} // '',
                'status'        => 'blocked',
                'blocked_epoch' => $epoch,
                'checksum_hit'  => '',
            };
            my $yaml;
            eval { $yaml = YAML::XS::Dump($stub) };
            if ($@) {
                <[base.logs]>->(
                    0,   'migrate: dump error for blocked %s: %s',
                    $id, $@
                );
                next;
            }
            <[file.zenka_dir.write]>->(
                "jobs/blocked/$epoch/$id.yaml",
                \$yaml, '>', 0640
            );
            ## ensure checksum store has this job ##
            <[jobsite.checksum.index]>->( qw| add |, $job )
                if length( $job->{'title'} // '' )
                or length( $job->{'url'}   // '' );
            unlink $f;
        } else {
            my $target_dir = "$jobs_root/$status";
            if ( not -d $target_dir ) {
                my $p7_user = <system.amos-zenka-user> // qw| protocol-7 |;
                <[file.make_path]>->( $target_dir, 0750, $p7_user, $p7_user );
            }
            my $target = "$target_dir/$id.yaml";
            rename $f,
                $target
                or <[base.logs]>->(
                0,  'migrate: rename %s -> %s failed: %s',
                $f, $target, $!
                );
        }
    }
}

<[jobsite.state.load]>;

## rebuild job index and in-memory task map from filesystem ##
<[jobsite.job.index.build]>;
$data{'jobs'}{'store'} = <[jobsite.job.load_all]>;

## restore the removed-id tombstone log so a reload doesn't lose not-yet- ##
## pushed removal signals for the web-cache                               ##
my $removed_log_file = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite removed-log.yaml |;
if ( -f $removed_log_file ) {
    my $loaded = eval { YAML::XS::LoadFile($removed_log_file) };
    <jobsite.removed_log> = $loaded if ref $loaded eq 'ARRAY';
}

## rotate trash/deleted files based on configured epoch retention ##
<[jobsite.store.prune]>;

## migrate jobs with status=assessed but stage=review to review directory ##
my $tasks = <jobsite.tasks> // {};
for my $id ( keys %{$tasks} ) {
    my $rec = $tasks->{$id};
    next unless ( $rec->{'stage'}  // '' ) eq 'review';
    next unless ( $rec->{'status'} // '' ) eq 'assessed';
    my $job = <[jobsite.job.read]>->($id) // next;
    $job->{'status'} = 'review';
    <[jobsite.job.write]>->( $id, $job );
}

## load checksum-based dedup / blacklist index ##
<[jobsite.checksum.index]>->(qw| load |);

## seed checksum store for active jobs that were fetched before the   ##
## job-upsert checksum-add fix, so future scans skip them even if ids ##
## change                                                             ##
my %skip_checksum_status = map { $ARG => 1 } qw| blocked deleted trash |;
for my $id ( keys %{$tasks} ) {
    my $rec = $tasks->{$id};
    next if $skip_checksum_status{ $rec->{'status'} // '' };
    my $job = <[jobsite.job.read]>->($id) // next;
    <[jobsite.checksum.index]>->( 'add', $job );
}

## also seed checksums for deleted/trash jobs so reposts are skipped ##
my $idx = <jobsite.job.index> // {};
for my $id ( keys %{$idx} ) {
    my $st = $idx->{$id} // '';
    next unless $st =~ m{^(deleted|trash):};
    my $job = <[jobsite.job.read]>->($id) // next;
    <[jobsite.checksum.index]>->( 'add', $job );
}

## var watcher on pending_count : fires when all assessments land
<[event.add_var]>->(
    {   'var'     => \<jobsite.pending_count>,
        'poll'    => 'w',
        'handler' => 'jobsite.handler.pending-changed',
        'repeat'  => TRUE,
        'desc'    => 'jss pending_count watcher',
    }
);

## rescan timer : only when interval > 0
my $interval = <jobsite.cfg.rescan_interval> // 0;
if ( $interval > 0 ) {
    <[event.add_timer]>->(
        {   'after'    => $interval,
            'interval' => $interval,
            'repeat'   => TRUE,
            'handler'  => 'jobsite.handler.rescan-timer',
        }
    );
    <[base.logs]>->( 1, 'jobsite: rescan timer %ds', $interval );
}

## sync push timer : only when interval > 0
my $sync_interval = <jobsite.cfg.sync_interval> // 0;
if ( $sync_interval > 0 ) {
    <[event.add_timer]>->(
        {   'after'    => 30,
            'interval' => $sync_interval,
            'repeat'   => TRUE,
            'handler'  => 'jobsite.sync.push',
        }
    );
    <[base.logs]>->( 1, 'jobsite: sync push timer %ds', $sync_interval );
}

## re-wire task.wait-done for any jobs stuck mid-assessment after restart   ##
## KNOWN GAP : task_id is never cleared on completion by assess-done /      ##
## repair-done, so it can't be used alone as an in-flight signal [ that     ##
## would re-flag every job ever assessed, every reload ]. stage is the only ##
## safe signal for now, but a protected stage [ e.g. applied ] mid-         ##
## reassessment keeps its real stage and would be missed here — narrow,     ##
## restart-timing-window edge case, left open rather than risking a         ##
## reload-triggered reassessment storm                                      ##
$tasks = <jobsite.tasks> // {};
my @orphans = grep { ( $tasks->{$ARG}{'stage'} // '' ) eq 'assessing' }
    keys %{$tasks};

if (@orphans) {
    <jobsite.pending_count> = scalar @orphans;
    <[base.logs]>->(
        1,
        'jobsite: re-wiring %d orphaned assessment tasks',
        scalar @orphans
    );
    ## store queue : rewire-all handler processes after event loop starts
    <jobsite.rewire_queue>
        = [
        map { { 'job_id' => $ARG, 'task_id' => $tasks->{$ARG}{'task_id'} } }
            @orphans ];
    <[event.add_timer]>->(
        {   'after'   => 2,
            'repeat'  => FALSE,
            'handler' => 'jobsite.handler.rewire-all',
        }
    );
}

## reset tasks stuck in 'queued' with no task_id : dispatch was interrupted ##
## before the task zenka created the actual task ; clear so                 ##
## dispatch.assessments can re-queue them on the deferred startup pass      ##
my @stuck_queued = grep {
    ( $tasks->{$ARG}{'stage'} // '' ) eq 'queued'
        and not length( $tasks->{$ARG}{'task_id'} // '' )
    }
    keys %{$tasks};

if (@stuck_queued) {
    <[base.logs]>->(
        1,
        'jobsite: resetting %d stuck-queued jobs for re-dispatch',
        scalar @stuck_queued
    );
    delete $tasks->{$ARG} for @stuck_queued;
}

## deferred dispatch on startup : picks up any status=new jobs that     ##
## survived reload (rescan_interval=0 means nothing else triggers this) ##
<[event.add_timer]>->(
    {   'after'   => 4,
        'repeat'  => FALSE,
        'handler' => 'jobsite.dispatch.assessments',
    }
);

my $job_count = scalar keys %{$tasks};
<[base.logs]>->(
    1,               'jobsite: ready, cycle=%s, jobs=%d',
    <jobsite.cycle>, $job_count
);

## on its own startup schedule, check configured zenki for job files        ##
## stranded under their own var dir [ eg from a past path-resolution desync ##
## ] ; jobsite decides when to look, never an unsolicited push              ##
<[event.add_timer]>->(
    {   'after'   => 2,
        'repeat'  => FALSE,
        'handler' => 'jobsite.stray.check',
    }
);

TRUE;

