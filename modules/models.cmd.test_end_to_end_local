# name = models.cmd.test_end_to_end_local
# descr = command wrapper for end-to-end test with local model inference

my $params = {};

if ( defined $call->{'param'} && ref $call->{'param'} eq 'HASH' ) {
    $params = $call->{'param'};
} elsif ( defined $call->{'args'} && length $call->{'args'} ) {
    eval { $params = JSON::PP::decode_json( $call->{'args'} ); };
    if ($@) {
        eval { $params = YAML::XS::Load( $call->{'args'} ); };
    }
    $params = {} if $@;
}

## Store reply_id for async handlers to use later
my $reply_id = $call->{'reply_id'};
$params->{'reply_id'} = $reply_id if defined $reply_id;

my $result = <[models.test.end_to_end_local]>->($params);

## If pending (async), return deferred to keep session alive for handlers
if ( $result->{'pending'} ) {
    return { 'mode' => 'deferred' };
}

## If synchronous result, return immediately
my $yaml_data = YAML::XS::Dump($result);
return {
    'mode' => 'size',
    'data' => $yaml_data
};

