## [:< ##

# name  = letsencrypt.base.check_dirs
# descr = Validate and create required directories for Let's Encrypt operations

## Check and create certificate directories
my @dirs = (
    <letsencrypt.certs.dir>, <letsencrypt.certs.backup>,
    <letsencrypt.cache.dir>,
);

foreach my $dir (@dirs) {
    next unless $dir;

    if ( !-d $dir ) {
        <[base.log]>->( 2, "creating directory: $dir" );
        mkdir( $dir, 0700 )
            or <[base.log]>->( 1, "error: failed to create $dir: $!" );
    } elsif ( !-w $dir ) {
        <[base.log]>->( 1, "error: directory not writable: $dir" );
    }
}

<[base.log]>->( 2, 'certificate directories validated' );

