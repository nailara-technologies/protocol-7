## [:< ##

# name  = letsencrypt.base.check_dirs
# descr = Create required directories for Let's Encrypt operations with proper permissions

## Directories to create (called before drop_privs, so runs as root)
my @dirs = (
    <letsencrypt.certs.dir>, <letsencrypt.certs.backup>,
    <letsencrypt.cache.dir>,
);

foreach my $dir (@dirs) {
    next unless $dir;

    <[file.make_path]>->( $dir, 0700, <system.amos-zenka-user> )
        or <[base.log]>->( 1, "error: failed to create directory: $dir" );
}

<[base.log]>->( 2, 'certificate directories created and configured' );

