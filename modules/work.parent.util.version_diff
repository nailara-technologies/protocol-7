## [:< ##

# name  = work.parent.util.version_diff
# descr = calculate difference between two version strings

my ( $a, $b ) = @ARG;
my @a_parts = split m|\.|, $a;
my @b_parts = split m|\.|, $b;

## Simple heuristic: check if patch version jumped by more than 1
return abs( ( $b_parts[2] || 0 ) - ( $a_parts[2] || 0 ) );

