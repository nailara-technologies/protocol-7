## [:< ##

# name  = protocol.protocol-7.init_code

##  calc_port, calc_unix_path  ##
<[base.perlmod.load]>->('AMOS7::Protocol::P7');

if ( index( <system.p7.ext-proto-ver>, qw| \ |, 0 ) != 0 ) {
    ##[ translating syntax ]##
    <[base.parser.protocol-version]>->(<system.p7.ext-proto-ver>);
}

<protocol.protocol-7> = {

    qw| regex | => {
        qw| protocol-version | =>    ## protocol banner match ##
            qr|^\\\\\QPROTOCOL-7-VERSION\E\\\\([A-Z2-7]{7})\\\\\n$|
    },

    qw| connect | => {

        ##  protocol reply messages  ##
        ##
        qw| banner |          => sprintf( "%s\n", <system.p7.ext-proto-ver> ),
        qw| timeout |         => ">:| timeout\n",
        qw| auth_method_wrn | => ":| auth methods\n",
        qw| auth_method_err | => ">;| auth methods\n",
        qw| protocol_error |  => ">:[ speak protocol 7 ?\n",

        ##  client side activity  ##
        ##
        qw| select-method | => "select %s\n"
    },

    qw| authentication-timeout | => 17,
    qw| authentication-methods | => {},    ## registry ##

    qw| state | => {
        qw| 0 | => {  ## Pre-auth state

            ## [ linewise | bytewise | binary ] ##
            qw| read-mode | => qw| linewise |, ##  bytewise has size limit  ##

            qw| input |  => { qw| handler | => qw| base.handler.auth | },
            qw| output | => { qw| handler | => qw| base.handler.command | },

            qw| error | => { qw|handler| => qw| base.handler.session_error | }
        },
        qw| 1 | => {  ## Authenticated state (stable, default operational)

            ## [ linewise | bytewise | binary ] ##
            qw| read-mode | => qw| linewise |,

            qw| input |  => { qw| handler | => qw| base.handler.command | },
            qw| output | => { qw| handler | => qw| base.handler.command | },

            qw| error | => { qw|handler| => qw| base.handler.session_error | }

            ## Note: Sessions remain in state 1 indefinitely unless link-upgrade is explicitly
            ## requested. Unencrypted local links can operate without overhead.
        },

        qw| 2 | => {  ## Link-upgrade negotiation (OPTIONAL encryption/transport encoding)

            ## Linewise for handshake (BASE32 encoding allows linewise transmission)
            qw| read-mode | => qw| linewise |,

            qw| input |  => { qw| handler | => qw| base.handler.link-upgrade | },
            qw| output | => { qw| handler | => qw| base.handler.link-upgrade.response | },

            ## Handshake initialization: exchange C25519 keys, negotiate encryption
            ## and transport encoding modes (utf7, base32, base32-xz with optional compression)
            qw| init | => qw| protocol.protocol-7.link-upgrade.init |,

            qw| error | => { qw|handler| => qw| base.handler.session_error | }

            ## Note: Only entered if client explicitly requests link upgrade.
            ## Failed negotiation returns to state 1. Successful completion transitions to state 3.
        },

        qw| 3 | => {  ## Encrypted session state (post link-upgrade)

            ## Linewise transmission with BASE32 encoding wrapping encryption
            ## Order: plaintext → encrypt → compress (optional) → BASE32 encode → linewise
            ## Keeps protocol linewise while enabling binary encryption underneath
            qw| read-mode | => qw| linewise |,

            qw| input |  => {
                qw| handler | => qw| base.handler.read.encryption-wrapper |
            },
            qw| output | => {
                qw| handler | => qw| base.handler.command |
            },

            ## Encryption initialization (install encryption layers)
            qw| init | => qw| protocol.protocol-7.encryption.init |,

            qw| error | => { qw|handler| => qw| base.handler.session_error | }

            ## Note: Only entered after successful link-upgrade from state 2.
            ## Encryption and optional link-layer encoding active for session lifetime.
        }
    },
    'clean-up-regex' => [qr|^(\s*\n)+$|], ## <-- applied before cmd processing
    qw| command-handlers | =>
        { qw| input | => [qw| multi-line |], qw| process | => [qq||] }
};

<protocol.protocol-7.settings.do-clean-up> //= 5; ## default: clean empty lines in input (override in set-up) ##

##  log and protocol messages  ##
<[templates.register_add]>;    ## register module sprintf templates ##

0;

