## [:< ##

# name = nshell.search.handler
# descr = Complete Ctrl+R search mode implementation for history

my ( $state_ref, $key, $input_chars_ref, $editor, $colors ) = @_;

## Helper to display search prompt and current match
## Color varies based on add-to-history mode: green when adding, blue when not
my $display_search = sub {
    my ($term) = @_;
    my $prompt_color = $state_ref->{search_add_to_history}
        ? $colors->{p7_fg_0003}     # Green = add to history
        : $colors->{p7_fg_0004};    # Blue = no-history mode

    print "\r\e[K" . $prompt_color . "[search: " . $term . " ] ";
    if ( @{ $state_ref->{search_results} }
        && $state_ref->{search_index} < @{ $state_ref->{search_results} } ) {
        print $colors->{p7_fg_0004}
            . $state_ref->{search_results}->[ $state_ref->{search_index} ];
    }
    print "\e[K\e[0m";
    STDOUT->flush();
};

## Helper to search history for matching entries
my $search_history = sub {
    my ($term) = @_;
    my @matching = ();
    foreach my $entry ( reverse @AMOS7::TERM::history_entries ) {
        if ( ref($entry) eq 'ARRAY' && $entry->[1] ) {
            my $cmd = join( "\n", @{ $entry->[1] } );
            push @matching, $cmd if index( $cmd, $term ) >= 0;
        }
    }
    return \@matching;
};

## Accumulate escape sequences in search mode
if ( $key eq "\e" ) {
    my $escape_buffer = $key;

    ## Accumulate more characters to complete escape sequence
    my $seq_complete = 0;
    for ( my $i = 0; $i < 20 && !$seq_complete; $i++ ) {
        ## Check if we need more input
        if ( !length $$input_chars_ref && -t STDIN ) {
            my $bytes_read = sysread( STDIN, $$input_chars_ref, 64 );
            last if not defined $bytes_read or $bytes_read <= 0;
        }
        last if not length $$input_chars_ref;

        my $next_key = substr( $$input_chars_ref, 0, 1, '' );
        $escape_buffer .= $next_key;

        ## Check if sequence is complete
        $seq_complete = 1
            if $escape_buffer =~ m{\e\[[A-Z]|\eO[A-Z]|\e\[[0-9;]*~$};
    }

    $key = $escape_buffer;
}

## Toggle add-to-history mode (Ctrl+R while already in search)
if ( $key eq "\x12" ) {    # Ctrl+R
    $state_ref->{search_add_to_history}
        = !$state_ref->{search_add_to_history};
    $display_search->( $state_ref->{search_term} );
    return 0;
}

## Exit search mode (Ctrl+C or Esc)
if ( $key eq "\x03" or $key eq "\e" ) {
    ## If there's a valid search result, load it; otherwise restore original buffer
    my $exit_buffer;

    if (   @{ $state_ref->{search_results} }
        && $state_ref->{search_index} < @{ $state_ref->{search_results} }
        && length( $state_ref->{search_term} ) ) {
        ## Search result found - load it into buffer
        $exit_buffer
            = $state_ref->{search_results}->[ $state_ref->{search_index} ];
    } else {
        ## No result or cleared search - restore original buffer
        $exit_buffer = $state_ref->{pre_search_buffer};
    }

    ## Save search term to history if not empty
    if (length( $state_ref->{search_term} )
        && ( @{ $state_ref->{search_term_history} } == 0
            || $state_ref->{search_term_history}->[0] ne
            $state_ref->{search_term} )
    ) {
        unshift @{ $state_ref->{search_term_history} },
            $state_ref->{search_term};
        pop @{ $state_ref->{search_term_history} }
            if @{ $state_ref->{search_term_history} } > 50;
    }

    $state_ref->{search_mode}            = 0;    # FALSE
    $state_ref->{search_term}            = '';
    $state_ref->{search_results}         = [];
    $state_ref->{search_index}           = 0;
    $state_ref->{search_term_hist_index} = -1;
    $state_ref->{search_deleted_chars}   = '';
    $state_ref->{search_add_to_history}  = 1;    # TRUE - reset to default
    $state_ref->{current_mode}           = 0;    # NORMAL

    AMOS7::TERM::editor_load( $editor, $exit_buffer );
    $state_ref->{display_buffer} = $colors->{p7_fg_0004} . $exit_buffer;

    ## Redraw the buffer
    <[nshell.redraw_command_line]>->(
        $exit_buffer, $state_ref->{display_buffer}
    );

    ## Render cursor at editor's position
    <[nshell.render.cursor]>->( $editor, $colors, 1 );

    return 1;    ## Signal to exit search mode
}

## Select current match and exit search (Enter)
if ( $key eq "\r" or $key eq "\n" ) {
    if ( @{ $state_ref->{search_results} }
        && $state_ref->{search_index} < @{ $state_ref->{search_results} } ) {
        my $selected
            = $state_ref->{search_results}->[ $state_ref->{search_index} ];

        ## Save search term to history if not empty
        if (length( $state_ref->{search_term} )
            && ( @{ $state_ref->{search_term_history} } == 0
                || $state_ref->{search_term_history}->[0] ne
                $state_ref->{search_term} )
        ) {
            unshift @{ $state_ref->{search_term_history} },
                $state_ref->{search_term};
            pop @{ $state_ref->{search_term_history} }
                if @{ $state_ref->{search_term_history} } > 50;
        }

        ## Add selected command to history only if not in no-history mode
        if ( length $selected && $state_ref->{search_add_to_history} ) {
            my @lines = split "\n", $selected;
            AMOS7::TERM::history_add(@lines);
        }

        $state_ref->{search_mode}            = 0;    # FALSE
        $state_ref->{search_term}            = '';
        $state_ref->{search_results}         = [];
        $state_ref->{search_index}           = 0;
        $state_ref->{search_term_hist_index} = -1;
        $state_ref->{search_deleted_chars}   = '';
        $state_ref->{search_add_to_history}  = 1;    # TRUE - reset to default
        $state_ref->{current_mode}           = 0;    # NORMAL

        AMOS7::TERM::editor_load( $editor, $selected );
        ## Clear search prompt and display selected command
        print "\r\e[K" . $colors->{p7_fg_0004} . $selected . "\n";
        STDOUT->flush();
        $state_ref->{display_buffer}      = '';
        $state_ref->{show_cursor_on_call} = 1;       # TRUE

        return 2;    ## Signal to return selected command
    }
    return 0;
}

## Backspace - remove from search term
if ( $key eq "\x08" or $key eq "\x7f" ) {
    $state_ref->{search_term} = substr( $state_ref->{search_term}, 0, -1 )
        if length( $state_ref->{search_term} );
    $state_ref->{search_deleted_chars} = '';
    $state_ref->{search_results}
        = $search_history->( $state_ref->{search_term} );
    $state_ref->{search_index} = 0
        if $state_ref->{search_index} >= @{ $state_ref->{search_results} };
    $display_search->( $state_ref->{search_term} );
    return 0;
}

## Delete key - clear entire search term (practical shortcut in search mode)
if ( $key eq "\e[3~" ) {
    $state_ref->{search_term}            = '';
    $state_ref->{search_term_hist_index} = -1;
    $state_ref->{search_deleted_chars}   = '';
    $state_ref->{search_results}
        = $search_history->( $state_ref->{search_term} );
    $state_ref->{search_index} = 0
        if $state_ref->{search_index} >= @{ $state_ref->{search_results} };
    $display_search->( $state_ref->{search_term} );
    return 0;
}

## Ctrl+W - clear previous word from search term
if ( $key eq "\x17" ) {
    $state_ref->{search_term} =~ s/\s*\S+\s*$//;
    $state_ref->{search_term_hist_index} = -1;
    $state_ref->{search_deleted_chars}   = '';
    $state_ref->{search_results}
        = $search_history->( $state_ref->{search_term} );
    $state_ref->{search_index} = 0
        if $state_ref->{search_index} >= @{ $state_ref->{search_results} };
    $display_search->( $state_ref->{search_term} );
    return 0;
}

## Ctrl+U - clear entire search term
if ( $key eq "\x15" ) {
    $state_ref->{search_term}            = '';
    $state_ref->{search_term_hist_index} = -1;
    $state_ref->{search_deleted_chars}   = '';
    $state_ref->{search_results}
        = $search_history->( $state_ref->{search_term} );
    $state_ref->{search_index} = 0
        if $state_ref->{search_index} >= @{ $state_ref->{search_results} };
    $display_search->( $state_ref->{search_term} );
    return 0;
}

## Up arrow - cycle to next matching result, skip duplicates
if ( $key eq "\e[A" ) {
    if ( @{ $state_ref->{search_results} } ) {
        my $current_result
            = $state_ref->{search_results}->[ $state_ref->{search_index} ]
            // '';
        my $attempts = 0;
        while ( $attempts < @{ $state_ref->{search_results} } ) {
            $state_ref->{search_index}++;
            $state_ref->{search_index} = 0
                if $state_ref->{search_index}
                >= @{ $state_ref->{search_results} };

            if (
                (   $state_ref->{search_results}
                    ->[ $state_ref->{search_index} ] // ''
                ) ne $current_result
            ) {
                last;
            }
            $attempts++;
        }
    }
    $state_ref->{search_deleted_chars} = '';
    $display_search->( $state_ref->{search_term} );
    return 0;
}

## Down arrow - cycle to previous matching result, skip duplicates
if ( $key eq "\e[B" ) {
    if ( @{ $state_ref->{search_results} } ) {
        my $current_result
            = $state_ref->{search_results}->[ $state_ref->{search_index} ]
            // '';
        my $attempts = 0;
        while ( $attempts < @{ $state_ref->{search_results} } ) {
            $state_ref->{search_index}--;
            $state_ref->{search_index} = @{ $state_ref->{search_results} } - 1
                if $state_ref->{search_index} < 0;

            if (
                (   $state_ref->{search_results}
                    ->[ $state_ref->{search_index} ] // ''
                ) ne $current_result
            ) {
                last;
            }
            $attempts++;
        }
    }
    $state_ref->{search_deleted_chars} = '';
    $display_search->( $state_ref->{search_term} );
    return 0;
}

## Left arrow - delete last character from search term (like backspace)
if ( $key eq "\e[D" or $key eq "\eOD" ) {
    if ( length( $state_ref->{search_term} ) > 0 ) {
        $state_ref->{search_deleted_chars}
            = substr( $state_ref->{search_term}, -1 )
            . $state_ref->{search_deleted_chars};
        $state_ref->{search_term}
            = substr( $state_ref->{search_term}, 0, -1 );
    }
    $state_ref->{search_results}
        = $search_history->( $state_ref->{search_term} );
    $state_ref->{search_index} = 0
        if $state_ref->{search_index} >= @{ $state_ref->{search_results} };
    $display_search->( $state_ref->{search_term} );
    return 0;
}

## Right arrow - restore deleted character
if ( $key eq "\e[C" or $key eq "\eOC" ) {
    if ( length( $state_ref->{search_deleted_chars} ) > 0 ) {
        $state_ref->{search_term}
            .= substr( $state_ref->{search_deleted_chars}, 0, 1 );
        $state_ref->{search_deleted_chars}
            = substr( $state_ref->{search_deleted_chars}, 1 );
    }
    $state_ref->{search_results}
        = $search_history->( $state_ref->{search_term} );
    $state_ref->{search_index} = 0
        if $state_ref->{search_index} >= @{ $state_ref->{search_results} };
    $display_search->( $state_ref->{search_term} );
    return 0;
}

## Other escape sequences - ignore
if ( $key =~ m{^(\e\[|\eO)} ) {
    return 0;
}

## Printable character - add to search term
if ( $key =~ m{[\x20-\x7e]} ) {
    $state_ref->{search_term} .= $key;
    $state_ref->{search_deleted_chars}   = '';
    $state_ref->{search_term_hist_index} = -1;
}

## Ignore other control characters
if ( $key !~ m{[\x20-\x7e]} ) {
    return 0;
}

## Search history for matching entries
$state_ref->{search_results} = $search_history->( $state_ref->{search_term} );
$state_ref->{search_index}   = 0
    if $state_ref->{search_index} >= @{ $state_ref->{search_results} };

## Display search prompt with current match
$display_search->( $state_ref->{search_term} );

return 0;    ## Continue in search mode

