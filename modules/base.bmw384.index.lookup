## [:< ##

# name  = base.bmw384.index.lookup
# args  = $name
# descr = exact coordinate lookup by node name

my $name = shift;

return undef
    if not defined $name
    or not defined <bmw384.index>;

return <bmw384.index>->{'by_name'}{$name};

