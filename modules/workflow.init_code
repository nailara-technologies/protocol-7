## [:< ##

# name  = workflow.init_code
# descr = workflow zenka initialization

# Load YAML module for aggregation features
eval {
    <[base.perlmod.autoload]>->('YAML::XS');
};
if ($@) {
    <[base.logs]>->( 1, 'YAML::XS not available, yaml aggregation features disabled' );
}

## Configuration - use Protocol-7 auto-detected system paths ##
my $root_path = <system.root_path>;
<workflow.cfg.yaml_data_dir>  //= "$root_path/data/yaml";
<workflow.cfg.index_dir>      //= <workflow.cfg.yaml_data_dir> . '/indexes';
<workflow.cfg.index_ttl>      //= 300;  ## 5 minutes ##

## Index file paths ##
<workflow.index.todos>     = <workflow.cfg.index_dir> . '/todos-index.yaml';
<workflow.index.workspace> = <workflow.cfg.index_dir> . '/workspace-transfer-index.yaml';

## Workspace-transfer paths ##
<workflow.cfg.workspace_root> //= '/var/run/.7';

## Git remote configuration ##
## Configure multiple remotes to push to all of them
## Example: <workflow.git.remotes> = ['origin', 'backup', 'mirror'];
## Leave empty or undefined to use single remote 'origin'
<workflow.git.remotes> //= [];

## Initialize data structures ##
<workflow.yaml.tasks>      //= {};
<workflow.yaml.todos>      //= [];
<workflow.workspace.repos> //= {};
<workflow.workspace.todos> //= [];
<workflow.workspace.bugs>  //= [];

## Activity log buffers ##
if ( not exists <buffer.workflow-activity> ) {
    <buffer.workflow-activity.max_size> = 32 * 1024;    ## 32K buffer size ##
    my $log_level  = 0;
    my $log_msg    = 'workflow activity buffer initialized ..,';
    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
    <[base.buffer.add_line]>->(
        qw| workflow-activity |,
        join( ' ', $time_stamp, $log_level, $log_msg ), $log_level
    );
}

if ( not exists <buffer.workflow-aggregation> ) {
    <buffer.workflow-aggregation.max_size> = 24 * 1024;    ## 24K buffer size ##
    my $log_level  = 0;
    my $log_msg    = 'workflow aggregation buffer initialized ..,';
    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
    <[base.buffer.add_line]>->(
        qw| workflow-aggregation |,
        join( ' ', $time_stamp, $log_level, $log_msg ), $log_level
    );
}

## Define lists for workflow data display ##

<list.yaml-tasks> = {
    'var'      => qw| data |,
    'key'      => qw| workflow.yaml.tasks |,
    'sort_key' => 'alpha:file',
    'mask'     => '<key>:file type:task_type status path',
    'align'    => {
        qw| file   | => qw| right-2 |,
        qw| type   | => qw| center-1 |,
        qw| status | => qw| center-1 |,
        qw| path   | => qw| left+1 |
    },
    'descr' => 'yaml task files from protocol-7'
};

<list.workspace-repos> = {
    'var'      => qw| data |,
    'key'      => qw| workflow.workspace.repos |,
    'sort_key' => 'alpha:name',
    'mask'     => 'name path',
    'align'    => {
        qw| name | => qw| right-2 |,
        qw| path | => qw| left+1 |
    },
    'descr' => 'workspace-transfer repositories'
};

<list.workflow-buffers> = {
    'var'   => qw| data |,
    'key'   => qw| buffer |,
    'mask'  => '<key>:name data:lines size:bytes max_size:of_bytes',
    'align' => {
        qw| data     | => qw| right-5 |,
        qw| size     | => qw| right-5 |,
        qw| max_size | => qw| right-3 |
    },
    'filters' => {
        qw| data     | => qw| base.parser.element_count |,
        qw| max_size | => qw| base.parser.size_str |
    },
    'descr' => 'workflow activity log buffers'
};

## Register lists ##
<[base.list.init]>->(
    {   qw| name |     => qw| yaml-tasks |,
        'key_ref'      => \$data{'workflow'}{'yaml'}{'tasks'},
        'max_elements' => 1024
    }
);

<[base.list.init]>->(
    {   qw| name |     => qw| workspace-repos |,
        'key_ref'      => \$data{'workflow'}{'workspace'}{'repos'},
        'max_elements' => 512
    }
);

<[base.logs]>->( 2, 'workflow module initialized with yaml aggregation support' );

return 0;

