# name  = base.gtk.list_monitors
# descr = enumerate every gdk monitor as a { index x y width height name
#         primary } rect, in-process [ assumes the default gdk display is
#         already open ]. shared monitor source for any zenka's placement
#         + layout code.

my $display = eval { Gtk3::Gdk::Display::get_default() };
if ( not defined $display ) {
    <[base.log]>->( 0, '[base.gtk.list_monitors] no default gdk display' );
    return undef;
}

my $count = eval { $display->get_n_monitors } // 0;

my @monitors;
for my $i ( 0 .. $count - 1 ) {
    my $mon = eval { $display->get_monitor($i) };
    next if not defined $mon;

    my $geo = eval { $mon->get_geometry };
    next if not defined $geo;

    my ( $x, $y, $w, $h );
    if ( ref($geo) eq qw| HASH | ) {
        ( $x, $y, $w, $h ) = @$geo{qw| x y width height |};
    } else {
        ( $x, $y, $w, $h ) = ( $geo->x, $geo->y, $geo->width, $geo->height );
    }
    next if not defined $w or not defined $h;

    my $name    = eval { $mon->get_model } // '';
    my $primary = eval { $mon->is_primary } ? TRUE : FALSE;

    push @monitors,
        {
        'index'   => $i,
        'x'       => $x + 0,
        'y'       => $y + 0,
        'width'   => $w + 0,
        'height'  => $h + 0,
        'name'    => $name,
        'primary' => $primary,
        };
}

return \@monitors;

