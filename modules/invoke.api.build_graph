## [:< ##

# name  = invoke.api.build_graph
# descr = construct invoke.ai enqueue_batch request body for txt2img

my $params = $ARG // {};

my $prompt     = $params->{'prompt'}     // '';
my $seed       = $params->{'seed'}       // <[base.prng.harmonic_seed]>;
my $steps      = $params->{'steps'}      // 30;
my $cfg        = $params->{'cfg'}        // 7.0;
my $width      = $params->{'width'}      // 1024;
my $height     = $params->{'height'}     // 1024;
my $model_key  = $params->{'model_key'}  // '';
my $model_base = $params->{'model_base'} // 'sdxl';

my $graph_id = sprintf 'txt2img_%d', $seed;

my ( %nodes, @edges );

if ( $model_base eq 'sdxl' ) {

    ## sdxl graph
    %nodes = (
        'sdxl_model_loader' => {
            'type'  => 'sdxl_model_loader',
            'id'    => 'sdxl_model_loader',
            'model' => { 'key' => $model_key },
        },
        'positive_cond' => {
            'type'   => 'sdxl_compel_prompt',
            'id'     => 'positive_cond',
            'prompt' => $prompt,
            'style'  => $prompt,
        },
        'negative_cond' => {
            'type'   => 'sdxl_compel_prompt',
            'id'     => 'negative_cond',
            'prompt' => '',
            'style'  => '',
        },
        'noise' => {
            'type'   => 'noise',
            'id'     => 'noise',
            'seed'   => $seed,
            'width'  => $width,
            'height' => $height,
        },
        'denoise_latents' => {
            'type'      => 'denoise_latents',
            'id'        => 'denoise_latents',
            'cfg_scale' => $cfg,
            'scheduler' => 'euler',
            'steps'     => $steps,
        },
        'l2i' => {
            'type' => 'l2i',
            'id'   => 'l2i',
        },
        'save_image' => {
            'type' => 'save_image',
            'id'   => 'save_image',
        },
    );

    @edges = (
        ## model loader → denoise + conditioning
        {   source => { node_id => 'sdxl_model_loader', field => 'unet' },
            destination => { node_id => 'denoise_latents', field => 'unet' },
        },
        {   source => { node_id => 'sdxl_model_loader', field => 'clip' },
            destination => { node_id => 'positive_cond', field => 'clip' },
        },
        {   source => { node_id => 'sdxl_model_loader', field => 'clip2' },
            destination => { node_id => 'positive_cond', field => 'clip2' },
        },
        {   source => { node_id => 'sdxl_model_loader', field => 'clip' },
            destination => { node_id => 'negative_cond', field => 'clip' },
        },
        {   source => { node_id => 'sdxl_model_loader', field => 'clip2' },
            destination => { node_id => 'negative_cond', field => 'clip2' },
        },
        ## conditioning → denoise
        {   source => { node_id => 'positive_cond', field => 'conditioning' },
            destination => {
                node_id => 'denoise_latents',
                field   => 'positive_conditioning'
            },
        },
        {   source => {
                node_id => 'positive_cond',
                field   => 'pooled_conditioning'
            },
            ## [ field name from openapi : verify against /openapi.json ]
            destination => {
                node_id => 'denoise_latents',
                field   => 'positive_conditioning_2'
            },
        },
        {   source => { node_id => 'negative_cond', field => 'conditioning' },
            destination => {
                node_id => 'denoise_latents',
                field   => 'negative_conditioning'
            },
        },
        {   source => {
                node_id => 'negative_cond',
                field   => 'pooled_conditioning'
            },
            destination => {
                node_id => 'denoise_latents',
                field   => 'negative_conditioning_2'
            },
        },
        ## noise → denoise
        {   source      => { node_id => 'noise',           field => 'noise' },
            destination => { node_id => 'denoise_latents', field => 'noise' },
        },
        ## vae + latents → l2i
        {   source      => { node_id => 'sdxl_model_loader', field => 'vae' },
            destination => { node_id => 'l2i',               field => 'vae' },
        },
        {   source => { node_id => 'denoise_latents', field => 'latents' },
            destination => { node_id => 'l2i', field => 'latents' },
        },
        ## l2i → save
        {   source      => { node_id => 'l2i',        field => 'image' },
            destination => { node_id => 'save_image', field => 'image' },
        },
    );

} else {

    ## sd-1 / sd-1.5 graph
    $width  = 512 if $width > 512  and not $params->{'width'};
    $height = 512 if $height > 512 and not $params->{'height'};

    %nodes = (
        'main_model_loader' => {
            'type'  => 'main_model_loader',
            'id'    => 'main_model_loader',
            'model' => { 'key' => $model_key },
        },
        'clip_skip' => {
            'type'           => 'clip_skip',
            'id'             => 'clip_skip',
            'skipped_layers' => 0,
        },
        'positive_cond' => {
            'type'   => 'compel',
            'id'     => 'positive_cond',
            'prompt' => $prompt,
        },
        'negative_cond' => {
            'type'   => 'compel',
            'id'     => 'negative_cond',
            'prompt' => '',
        },
        'noise' => {
            'type'   => 'noise',
            'id'     => 'noise',
            'seed'   => $seed,
            'width'  => $width,
            'height' => $height,
        },
        'denoise_latents' => {
            'type'      => 'denoise_latents',
            'id'        => 'denoise_latents',
            'cfg_scale' => 7.5,
            'scheduler' => 'euler',
            'steps'     => $steps,
        },
        'l2i' => {
            'type' => 'l2i',
            'id'   => 'l2i',
        },
        'save_image' => {
            'type' => 'save_image',
            'id'   => 'save_image',
        },
    );

    @edges = (
        ## model loader → denoise + clip_skip
        {   source => { node_id => 'main_model_loader', field => 'unet' },
            destination => { node_id => 'denoise_latents', field => 'unet' },
        },
        {   source => { node_id => 'main_model_loader', field => 'clip' },
            destination => { node_id => 'clip_skip', field => 'clip' },
        },
        ## clip_skip → conditioning
        ## [ field name: clip_skip_output : verify against /openapi.json ]
        {   source => { node_id => 'clip_skip', field => 'clip_skip_output' },
            destination => { node_id => 'positive_cond', field => 'clip' },
        },
        {   source => { node_id => 'clip_skip', field => 'clip_skip_output' },
            destination => { node_id => 'negative_cond', field => 'clip' },
        },
        ## conditioning → denoise
        {   source => { node_id => 'positive_cond', field => 'conditioning' },
            destination => {
                node_id => 'denoise_latents',
                field   => 'positive_conditioning'
            },
        },
        {   source => { node_id => 'negative_cond', field => 'conditioning' },
            destination => {
                node_id => 'denoise_latents',
                field   => 'negative_conditioning'
            },
        },
        ## noise → denoise
        {   source      => { node_id => 'noise',           field => 'noise' },
            destination => { node_id => 'denoise_latents', field => 'noise' },
        },
        ## vae + latents → l2i
        {   source      => { node_id => 'main_model_loader', field => 'vae' },
            destination => { node_id => 'l2i',               field => 'vae' },
        },
        {   source => { node_id => 'denoise_latents', field => 'latents' },
            destination => { node_id => 'l2i', field => 'latents' },
        },
        ## l2i → save
        {   source      => { node_id => 'l2i',        field => 'image' },
            destination => { node_id => 'save_image', field => 'image' },
        },
    );
}

my $graph = {
    'id'    => $graph_id,
    'nodes' => \%nodes,
    'edges' => \@edges,
};

return {
    'prepend' => JSON::false,
    'batch'   => {
        'graph' => $graph,
        'runs'  => 1,
    },
};

