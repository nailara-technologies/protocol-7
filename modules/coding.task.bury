## [:< ##

# name  = coding.task.bury
# descr = permanently archive failed task to failed-stopped state

my ( $task_id, $reason ) = @ARG;

return { 'mode' => qw| false |, 'data' => 'task_id required' }
    unless defined $task_id && length $task_id;

my $queue_href  = <coding.task.queue>  // {};
my $aref_failed = <coding.task.failed> // [];

return { 'mode' => qw| false |, 'data' => 'task not found in failed queue' }
    unless grep { $ARG eq $task_id } $aref_failed->@*;

my $task = $queue_href->{$task_id};

return { 'mode' => qw| false |, 'data' => 'task record missing from queue' }
    unless defined $task;

## stays in <coding.task.failed> : status marks it permanently archived ##
$task->{'execution'} //= {};
$task->{'execution'}->{'buried_at'}   = <[base.time]>->(3);
$task->{'execution'}->{'bury_reason'} = $reason // 'manually stopped';
$task->{'execution'}->{'status'}      = 'failed-stopped';

<[base.logs]>->(
    0,        "::task:: buried [%s] to failed-stopped: %s",
    $task_id, $task->{'execution'}->{'bury_reason'}
);

return {
    'mode' => qw| true |,
    'data' => {
        'task_id'   => $task_id,
        'buried_at' => $task->{'execution'}->{'buried_at'},
        'reason'    => $task->{'execution'}->{'bury_reason'},
    }
};

