## [:< ##

# name  = channels.mapping.apply
# descr = Apply mapping rules to channel data (JSON path extraction and variable assignment)
# args  = hash { source_data, map_rules, target_ref }
# return = hash { success => 0/1, mapped_vars => {...}, errors => [...] }

my $args_ref = shift;
return { 'success' => 0, 'errors' => ['no arguments provided'] }
    unless defined $args_ref and ref $args_ref eq qw| HASH |;

my $source_data = $args_ref->{'source_data'};
my $map_rules   = $args_ref->{'map_rules'} // [];
my $target_ref  = $args_ref->{'target_ref'};

return { 'success' => 0, 'errors' => ['source data is not a hash'] }
    unless ref $source_data eq qw| HASH |;

return { 'success' => 0, 'errors' => ['map rules is not an array'] }
    unless ref $map_rules eq 'ARRAY';

my %mapped_vars;
my @errors;

##  Apply each mapping rule  ##
foreach my $rule ( @{$map_rules} ) {
    next unless defined $rule and ref $rule eq qw| HASH |;

    my $json_path = $rule->{'json_path'};
    my $to_var    = $rule->{'to_var'};

    next unless length $json_path and length $to_var;

    ##  JSON path parsing (simple dot notation: .key.subkey.array[0])  ##
    my $value
        = <[channels.util.extract_json_path]>->( $source_data, $json_path );

    if ( defined $value ) {
        $mapped_vars{$to_var} = $value;

        ##  Assign to target reference if provided  ##
        if ( defined $target_ref and ref $target_ref eq qw| HASH | ) {
            $target_ref->{$to_var} = $value;
        }
    } else {
        push @errors, "unable to extract path '$json_path'";
    }
}

<[base.logs]>->(
    2,
    "channels: applied %d mapping rules (%d successful, %d errors)",
    scalar @{$map_rules},
    scalar keys %mapped_vars,
    scalar @errors
);

return {
    'success'     => scalar @errors ? 0 : 1,
    'mapped_vars' => \%mapped_vars,
    'errors'      => @errors ? \@errors : undef
};

1;

