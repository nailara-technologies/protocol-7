## [:< ##

# name  = graphics-matrix.cell.list
# descr = list occupied cells with optional filtering

my $params = shift // {};

my $center = $params->{'center'};
my $radius = $params->{'radius'} // 0;
my $limit  = $params->{'limit'}  // 20;
my $sort   = $params->{'sort'}   // qw| distance |;

my ( $cx, $cy, $cz );
if ( defined $center ) {
    ( $cx, $cy, $cz )
        = ( $center->{'selX'}, $center->{'selY'}, $center->{'selZ'} );
}

my $cells = $data{'graphics-matrix'}{'cell'}{'cells'};
my @results;

for my $key ( keys %$cells ) {
    my $cell = $cells->{$key};

    my ( $x, $y, $z ) = (
        $cell->{'position'}{'selX'},
        $cell->{'position'}{'selY'},
        $cell->{'position'}{'selZ'},
    );

    my $distance = 0;
    if ( defined $center ) {
        $distance = abs( $x - $cx ) + abs( $y - $cy ) + abs( $z - $cz );
        next if $radius > 0 and $distance > $radius;
    }

    push @results,
        {
        qw| key      | => $key,
        qw| refs     | => $cell->{'refs'},
        qw| distance | => $distance,
        qw| elements | => scalar( @{ $cell->{'elements'} } ),
        qw| checksum | => $cell->{'checksum'},
        };
}

## sort results ##
if ( $sort eq qw| refs | ) {
    @results = sort { $b->{'refs'} <=> $a->{'refs'} } @results;
} elsif ( $sort eq qw| recent | ) {
    @results = sort {
        ( $cells->{ $b->{'key'} }{'modified'} // 0 )
            <=> ( $cells->{ $a->{'key'} }{'modified'} // 0 )
    } @results;
} else {
    ## default: distance ##
    @results = sort {
               $a->{'distance'} <=> $b->{'distance'}
            or $a->{'key'} cmp $b->{'key'}
    } @results;
}

## apply limit ##
splice @results, $limit if scalar @results > $limit;

return \@results;

