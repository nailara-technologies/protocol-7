## [:< ##

# name  = letsencr.parent.cmd.status
# descr = certificate status overview and ACME state

<[base.log]>->( 3, 'status command requested' );

my $certs    = <letsencr.parent.certs>;
my $renewals = <letsencr.parent.renewal_timers>;
my $now      = time();

## Calculate certificate statistics
my $total_certs   = scalar( keys %$certs );
my $expired       = 0;                        # < 0 days
my $expiring_soon = 0;                        # 0..7 days
my $needs_renewal = 0;                        # 7..30 days
my $valid         = 0;                        # > 30 days

foreach my $domain ( keys %$certs ) {
    my $cert = $certs->{$domain};
    next unless $cert->{expires_at};

    my $days_remaining = ( $cert->{expires_at} - $now ) / 86400;

    if ( $days_remaining < 0 ) {
        $expired++;
    } elsif ( $days_remaining <= 7 ) {
        $expiring_soon++;
    } elsif ( $days_remaining <= 30 ) {
        $needs_renewal++;
    } else {
        $valid++;
    }
}

my $active_renewals = scalar( keys %$renewals );

## Build status report with better formatting
my $status_report = "\n  :::[ let's encrypt ACME status ]:::\n\n";
$status_report .= "." x 52 . "\n\n";

## Certificate Status Section
$status_report .= ":: certificate status ::\n:\n";
$status_report
    .= sprintf( ":   %-30s :%5d\n", "total installed", $total_certs );
$status_report .= sprintf( ":   %-30s :%5d\n", "valid [ >30 days ]", $valid );
$status_report .= sprintf(
    ":   %-30s :%5d\n",
    "renewal needed [ 7-30 days ]",
    $needs_renewal
);
$status_report .= sprintf(
    ":   %-30s :%5d\n",
    "expiring soon [ 0-7 days ]",
    $expiring_soon
);
$status_report
    .= sprintf( ":   %-30s :%5d\n", "expired [ <0 days ]", $expired );
$status_report .= ":.\n\n";

## Renewal Operations Section
$status_report .= ":: renewal operations ::\n:\n";
$status_report
    .= sprintf( ":   %-30s :%5d\n:.\n", "active renewals", $active_renewals );

if ( $active_renewals > 0 ) {
    $status_report .= "\n  Active domains :\n\n";
    foreach my $domain ( sort keys %$renewals ) {
        my $renewal          = $renewals->{$domain};
        my $time_since_start = $now - $renewal->{started};
        my $hours            = int( $time_since_start / 3600 );
        my $mins             = int( ( $time_since_start % 3600 ) / 60 );
        my $time_str         = $hours > 0 ? "$hours h $mins m" : "$mins m";

        $status_report .= sprintf( "    %-30s (attempt %d, %s ago)\n",
            $domain, $renewal->{attempts}, $time_str );
    }
}

$status_report .= "\n";

## System Status Section
$status_report .= ":: system status ::\n:\n";
$status_report .= sprintf( ":   %-30s :    %s\n",
    "initialized", ( <letsencr.parent.initialized> ? 'YES' : 'NO' ) );

my $last_check_str = 'NOT RUN YET';
if (<letsencr.stats.last_renewal_check>) {
    my $last_check  = time() - <letsencr.stats.last_renewal_check>;
    my $check_hours = int( $last_check / 3600 );
    my $check_mins  = int( ( $last_check % 3600 ) / 60 );
    $last_check_str
        = $check_hours > 0
        ? "$check_hours h $check_mins m ago"
        : "$check_mins m ago";
}
$status_report .= sprintf(
    ":   %-30s :    %s\n:.\n",
    "last renewal check",
    $last_check_str
);

$status_report .= "\n";

## Statistics Section
$status_report .= ":: statistics ::\n:\n";
$status_report .= sprintf(
    ":   %-30s :%5d\n",
    "renewals completed",
    ( <letsencr.stats.renewals_completed> // 0 )
);
$status_report .= sprintf(
    ":   %-30s :%5d\n",
    "renewals failed",
    ( <letsencr.stats.renewals_failed> // 0 )
);
$status_report .= ":.\n\n";

return {
    mode => 'size',
    data => $status_report,
};

