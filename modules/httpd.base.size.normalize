## [:< ##

# name = httpd.base.size.normalize
# descr = format byte size to human-readable format

my $bytes     = shift;
my $precision = shift // 1;

return '0B' if $bytes == 0;

my @units      = ( 'B', 'KB', 'MB', 'GB', 'TB', 'PB' );
my $unit_index = 0;

while ( $bytes >= 1024 && $unit_index < scalar(@units) - 1 ) {
    $bytes /= 1024;
    $unit_index++;
}

return sprintf( "%.${precision}f%s", $bytes, $units[$unit_index] );
