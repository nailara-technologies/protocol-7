## [:< ##

# name = nshell.read_from_buffer
# descr = Non-blocking keyboard input with buffered I/O (no XS dependencies)

## Reads multiple bytes at once with sysread, processes character by character
## Returns complete line when user presses Enter
## Persists buffer across calls (static variable)
## Supports history navigation with arrow keys and Page Up/Down
## Uses AMOS7::TERM editor for text editing operations

state $editor           = undef;   ## Editor state reference
state $escape_buffer    = '';
state $display_buffer   = '';      ## Current display (may be from history)
state $debug_cmd_buffer = '';      ## Accumulate potential debug command :CMD:
state $input_chars      = ''; ## Character buffer for both TTY and piped input
state %colors           = (); ## Color palette (lazily loaded)
state $prev_cursor_pos
    = 0;    ## Previous cursor position for clearing old cursor
state $show_cursor_on_call = TRUE;    ## Show cursor at start of each call

## History search mode state
state $search_mode         = FALSE;   ## Whether in Ctrl+R search mode
state $search_term         = '';      ## Current search term
state $search_results      = [];      ## Matching history entries
state $search_index        = 0;       ## Current position in search results
state $pre_search_buffer   = '';      ## Buffer before entering search mode
state @search_term_history = (); ## Search term history for Up/Down navigation
state $search_term_hist_index = -1; ## Current position in search term history
state $search_deleted_chars
    = '';    ## Characters deleted by Left arrow (for Right arrow undo)

## History navigation state for Page Up/Down
state $current_history_index
    = -1;    ## Track which history entry we're viewing (-1 = none)

## Show cursor at start of each call (after command execution or on first call)
if ($show_cursor_on_call) {
    $show_cursor_on_call = FALSE;

    ## Load colors if not already loaded
    if ( !%colors ) {
        eval { %colors = %{<nshell.colors>} };
        $colors{p7_fg_0003} //= $AMOS7::TERM::p7_colors{'p7_fg_0003'};
        $colors{p7_fg_0004} //= $AMOS7::TERM::p7_colors{'p7_fg_0004'};
        $editor             //= AMOS7::TERM::editor_init();
        AMOS7::TERM::cursor_set_color( $colors{p7_fg_0003} );
    }

    ## Display cursor
    print $colors{p7_fg_0003} . '_' . "\e[0m" . $colors{p7_fg_0004};
    STDOUT->flush();

    return undef;    ## Return to event loop to display cursor before input
}

## Get one character from buffer, refilling via sysread if needed
my $key;
my $command_buffer;

if ( -t STDIN ) {
    ## TTY input: use sysread with non-blocking mode [STDIN in binary mode
    ## from nshell.init_code]
    if ( !length $input_chars ) {
        ## Drain all available data in non-blocking mode using while loop
        my $read_size  = 1024;
        my $total_read = 0;
        while (1) {
            my $bytes_read = sysread( STDIN, my $chunk, $read_size );
            if ( defined $bytes_read && $bytes_read > 0 ) {
                $input_chars .= $chunk;
                $total_read += $bytes_read;
            } else {
                last;    ## No more data available (non-blocking) or EOF
            }
        }
        return undef if !length $input_chars;    ## No data at all
    }
} else {
    ## Piped input: use line-oriented reading
    if ( !length $input_chars ) {
        my $line = <STDIN>;
        $input_chars = $line // '';
        return undef if !length $input_chars;
    }
}

## Process all buffered characters in a loop to prevent event loop starvation
while ( length $input_chars ) {
    my $key = _extract_utf8_char( \$input_chars );
    last if not defined $key; ## Incomplete UTF-8 sequence, wait for more data

    ## Load colors early if not already loaded (needed for all key processing)
    if ( !%colors ) {
        ## Try to get colors from Protocol-7 context if available
        eval { %colors = %{<nshell.colors>} };

        ## Fallback to Protocol-7 official colors from AMOS7::TERM
        ## p7_fg_0003 = phosphor green (cursor), p7_fg_0004 = TRUE blue (text)
        $colors{p7_fg_0004} //= $AMOS7::TERM::p7_colors{'p7_fg_0004'};
        $colors{p7_fg_0003} //= $AMOS7::TERM::p7_colors{'p7_fg_0003'};

        ## Set cursor to phosphor green
        AMOS7::TERM::cursor_set_color( $colors{p7_fg_0003} );

        ## Initialize editor if not already done
        $editor //= AMOS7::TERM::editor_init();
    }

    ## Handle search mode input (Ctrl+R)
    if ($search_mode) {
        ## Accumulate escape sequences in search mode
        if ( $key eq "\e" ) {
            $escape_buffer = $key;

            ## Accumulate more characters to complete escape sequence
            my $seq_complete = 0;
            for ( my $i = 0; $i < 20 && !$seq_complete; $i++ ) {
                ## Check if we need more input
                if ( !length $input_chars && -t STDIN ) {
                    my $bytes_read = sysread( STDIN, $input_chars, 64 );
                    last if not defined $bytes_read or $bytes_read <= 0;
                }
                last if not length $input_chars;

                my $next_key = substr( $input_chars, 0, 1, '' );
                $escape_buffer .= $next_key;

                ## Check if sequence is complete
                $seq_complete = TRUE
                    if $escape_buffer =~ m{\e\[[A-Z]|\eO[A-Z]|\e\[[0-9;]*~$};
            }

            $key           = $escape_buffer;
            $escape_buffer = '';
        }

        if ( $key eq "\x03" or $key eq "\e" ) {
            ## Ctrl+C or Esc - exit search mode
            ## If there's a valid search result, load it; otherwise restore original buffer
            my $exit_buffer;

            if (   @$search_results
                && $search_index < @$search_results
                && length($search_term) ) {
                ## Search result found - load it into buffer
                $exit_buffer = $search_results->[$search_index];
            } else {
                ## No result or cleared search - restore original buffer
                $exit_buffer = $pre_search_buffer;
            }

            ## Save search term to history if not empty
            if (length($search_term)
                && (   @search_term_history == 0
                    || $search_term_history[0] ne $search_term )
            ) {
                unshift @search_term_history, $search_term;
                pop @search_term_history
                    if @search_term_history > 50;    ## Keep last 50 searches
            }

            $search_mode            = FALSE;
            $search_term            = '';
            $search_results         = [];
            $search_index           = 0;
            $search_term_hist_index = -1;
            $search_deleted_chars   = '';
            AMOS7::TERM::editor_load( $editor, $exit_buffer );
            $command_buffer = $exit_buffer;
            $display_buffer = $colors{p7_fg_0004} . $exit_buffer;

            ## Redraw the buffer
            <[nshell.redraw_command_line]>->( $exit_buffer, $display_buffer );

            ## Render cursor at editor's position
            my $cursor_pos     = $editor->{cursor_pos};
            my $buffer         = $editor->{buffer};
            my $buf_len        = length($buffer);
            my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';

            ## Move back to cursor position (if not at end)
            if ( $cursor_pos < $buf_len ) {
                my $moves_back = $buf_len - $cursor_pos;
                print "\x08" x $moves_back;
            }

            ## Render cursor at current position
            if ( $char_at_cursor eq '' or $char_at_cursor eq ' ' ) {
                print $colors{p7_fg_0003} . '_';
            } else {
                print "\e[7m" . $char_at_cursor . "\e[27m";
            }

            print "\e[0m" . $colors{p7_fg_0004};
            ## Only clear to end of line if cursor is at buffer end
            print "\e[K" if $cursor_pos >= $buf_len;
            STDOUT->flush();
            next;
        } elsif ( $key eq "\r" or $key eq "\n" ) {
            ## Enter - select current match and exit search
            if ( @$search_results && $search_index < @$search_results ) {
                my $selected = $search_results->[$search_index];

                ## Save search term to history if not empty
                if (length($search_term)
                    && (   @search_term_history == 0
                        || $search_term_history[0] ne $search_term )
                ) {
                    unshift @search_term_history, $search_term;
                    pop @search_term_history
                        if @search_term_history > 50; ## Keep last 50 searches
                }

                $search_mode            = FALSE;
                $search_term            = '';
                $search_results         = [];
                $search_index           = 0;
                $search_term_hist_index = -1;
                $search_deleted_chars   = '';
                AMOS7::TERM::editor_load( $editor, $selected );
                $command_buffer = $selected;
                $display_buffer = '';
                print "\n";
                STDOUT->flush();
                $show_cursor_on_call = TRUE;
                return $selected;
            }
            next;
        } elsif ( $key eq "\x17" ) {
            ## Ctrl+W - clear previous word from search term
            $search_term =~ s/\s*\S+\s*$//;
            $search_term_hist_index = -1;
            $search_deleted_chars   = '';
        } elsif ( $key eq "\x15" ) {
            ## Ctrl+U - clear entire search term
            $search_term            = '';
            $search_term_hist_index = -1;
            $search_deleted_chars   = '';
        } elsif ( $key eq "\x08" or $key eq "\x7f" ) {
            ## Backspace - remove from search term
            $search_term = substr( $search_term, 0, -1 )
                if length($search_term);
            $search_deleted_chars = '';    ## Clear any undo buffer
        } elsif ( $key eq "\e[A" ) {
            ## Up arrow - cycle to next matching result, skip duplicates
            if (@$search_results) {
                my $current_result = $search_results->[$search_index] // '';
                my $attempts       = 0;
                while ( $attempts < @$search_results ) {
                    $search_index++;
                    $search_index = 0 if $search_index >= @$search_results;

                    if ( ( $search_results->[$search_index] // '' ) ne
                        $current_result ) {
                        last;    ## Found a different result
                    }
                    $attempts++;
                }
            }
            $search_deleted_chars = '';
            ## Display updated match
            print "\r\e[K"
                . $colors{p7_fg_0003}
                . "[search: "
                . $search_term . " ] ";
            if ( @$search_results && $search_index < @$search_results ) {
                print $colors{p7_fg_0004} . $search_results->[$search_index];
            }
            print "\e[K\e[0m";
            STDOUT->flush();
            next;
        } elsif ( $key eq "\e[B" ) {
            ## Down arrow - cycle to previous matching result, skip duplicates
            if (@$search_results) {
                my $current_result = $search_results->[$search_index] // '';
                my $attempts       = 0;
                while ( $attempts < @$search_results ) {
                    $search_index--;
                    $search_index = @$search_results - 1 if $search_index < 0;

                    if ( ( $search_results->[$search_index] // '' ) ne
                        $current_result ) {
                        last;    ## Found a different result
                    }
                    $attempts++;
                }
            }
            $search_deleted_chars = '';
            ## Display updated match
            print "\r\e[K"
                . $colors{p7_fg_0003}
                . "[search: "
                . $search_term . " ] ";
            if ( @$search_results && $search_index < @$search_results ) {
                print $colors{p7_fg_0004} . $search_results->[$search_index];
            }
            print "\e[K\e[0m";
            STDOUT->flush();
            next;
        } elsif ( $key eq "\e[D" or $key eq "\eOD" ) {
            ## Left arrow - delete last character from search term (like backspace)
            if ( length($search_term) > 0 ) {
                $search_deleted_chars
                    = substr( $search_term, -1 ) . $search_deleted_chars;
                $search_term = substr( $search_term, 0, -1 );
            }
            ## Fall through to update display
        } elsif ( $key eq "\e[C" or $key eq "\eOC" ) {
            ## Right arrow - restore deleted character
            if ( length($search_deleted_chars) > 0 ) {
                $search_term .= substr( $search_deleted_chars, 0, 1 );
                $search_deleted_chars = substr( $search_deleted_chars, 1 );
            }
            ## Fall through to update display
        } elsif ( $key =~ m{^(\e\[|\eO)} ) {
            ## Other escape sequences - ignore (don't add to search term)
            next;
        } elsif ( $key =~ m{[\x20-\x7e]} ) {
            ## Printable character - add to search term
            $search_term .= $key;
            $search_deleted_chars
                = '';    ## Clear any undo buffer when typing new chars
            $search_term_hist_index
                = -1;    ## Exit history navigation on new input
        } else {
            ## Other control characters - ignore
            next;
        }

        ## Search history for matching entries
        ## History entries are [ $timestamp, \@lines ], need to extract and join lines
        my @matching = ();
        foreach my $entry ( reverse @AMOS7::TERM::history_entries ) {
            if ( ref($entry) eq 'ARRAY' && $entry->[1] ) {
                my $cmd = join( "\n", @{ $entry->[1] } );
                push @matching, $cmd if index( $cmd, $search_term ) >= 0;
            }
        }
        $search_results = \@matching;
        $search_index   = 0 if $search_index >= @$search_results;

        ## Display search prompt with current match
        print "\r\e[K"
            . $colors{p7_fg_0003}
            . "[search: "
            . $search_term . " ] ";
        if ( @$search_results && $search_index < @$search_results ) {
            print $colors{p7_fg_0004} . $search_results->[$search_index];
        }
        print "\e[K\e[0m";
        STDOUT->flush();
        next;
    }

    ## Check for Ctrl+R to enter search mode or cycle search term history
    if ( $key eq "\x12" ) {
        ## Ctrl+R
        if ($search_mode) {
            ## Already in search mode - cycle through search term history forward
            if (@search_term_history) {
                if ( $search_term_hist_index == -1 ) {
                    ## First time, start at most recent search term
                    $search_term_hist_index = 0;
                } else {
                    ## Move to next search term in history
                    $search_term_hist_index++;
                    if ( $search_term_hist_index >= @search_term_history ) {
                        ## Wrap around to empty (user can clear and start new)
                        $search_term_hist_index = -1;
                    }
                }

                ## Load search term from history if on a valid index
                if (   $search_term_hist_index >= 0
                    && $search_term_hist_index < @search_term_history ) {
                    $search_term
                        = $search_term_history[$search_term_hist_index];
                } elsif ( $search_term_hist_index == -1 ) {
                    $search_term = '';
                }

                ## Re-search with loaded term
                my @matching = ();
                foreach my $entry ( reverse @AMOS7::TERM::history_entries ) {
                    if ( ref($entry) eq 'ARRAY' && $entry->[1] ) {
                        my $cmd = join( "\n", @{ $entry->[1] } );
                        push @matching, $cmd
                            if index( $cmd, $search_term ) >= 0;
                    }
                }
                $search_results = \@matching;
                $search_index   = 0;

                ## Display updated search with new term and first matching result
                print "\r\e[K"
                    . $colors{p7_fg_0003}
                    . "[search: "
                    . $search_term . " ] ";
                if ( @$search_results && $search_index < @$search_results ) {
                    print $colors{p7_fg_0004}
                        . $search_results->[$search_index];
                }
                print "\e[K\e[0m";
                STDOUT->flush();
            }
        } else {
            ## Not in search mode - enter history search mode (new search)
            $search_mode            = TRUE;
            $search_term            = '';
            $pre_search_buffer      = $editor->{buffer};
            $search_results         = [];
            $search_index           = 0;
            $search_term_hist_index = -1;
            $search_deleted_chars   = '';

            ## Display search prompt
            print "\r\e[K" . $colors{p7_fg_0003} . "[search:  ] ";
            print "\e[K\e[0m";
            STDOUT->flush();
        }
        next;
    }

    ## Check for Ctrl+Shift+R to cycle search term history backward
    if ( $key eq "\e[1;6R" or $key eq "\e[1;2R" ) {
        ## Ctrl+Shift+R
        if ($search_mode) {
            ## In search mode - cycle through search term history backward
            if (@search_term_history) {
                if ( $search_term_hist_index == -1 ) {
                    ## First time going backward, start at end of history
                    $search_term_hist_index = @search_term_history - 1;
                } else {
                    ## Move to previous search term in history
                    $search_term_hist_index--;
                    if ( $search_term_hist_index < 0 ) {
                        ## Wrap around to empty
                        $search_term_hist_index = -1;
                    }
                }

                ## Load search term from history if on a valid index
                if (   $search_term_hist_index >= 0
                    && $search_term_hist_index < @search_term_history ) {
                    $search_term
                        = $search_term_history[$search_term_hist_index];
                } elsif ( $search_term_hist_index == -1 ) {
                    $search_term = '';
                }

                ## Re-search with loaded term
                my @matching = ();
                foreach my $entry ( reverse @AMOS7::TERM::history_entries ) {
                    if ( ref($entry) eq 'ARRAY' && $entry->[1] ) {
                        my $cmd = join( "\n", @{ $entry->[1] } );
                        push @matching, $cmd
                            if index( $cmd, $search_term ) >= 0;
                    }
                }
                $search_results = \@matching;
                $search_index   = 0;

                ## Display updated search with new term and first matching result
                print "\r\e[K"
                    . $colors{p7_fg_0003}
                    . "[search: "
                    . $search_term . " ] ";
                if ( @$search_results && $search_index < @$search_results ) {
                    print $colors{p7_fg_0004}
                        . $search_results->[$search_index];
                }
                print "\e[K\e[0m";
                STDOUT->flush();
            }
        }
        next;
    }

## Helper: extract a complete UTF-8 character (may be 1-4 bytes)
    sub _extract_utf8_char {    ### extract subroutine ### [LLL]
        my ($buf_ref) = @ARG;
        return undef if !length($$buf_ref);

        my $first_byte = ord( substr( $$buf_ref, 0, 1 ) );
        my $seq_len    = 1;

        ## Determine UTF-8 sequence length from first byte
        if ( ( $first_byte & 0xE0 ) == 0xC0 ) {  ## 110xxxxx - 2 byte sequence
            $seq_len = 2;
        } elsif ( ( $first_byte & 0xF0 ) == 0xE0 )
        {                                        ## 1110xxxx - 3 byte sequence
            $seq_len = 3;
        } elsif ( ( $first_byte & 0xF8 ) == 0xF0 )
        {                                        ## 11110xxx - 4 byte sequence
            $seq_len = 4;
        }
        ## else: 0xxxxxxx (ASCII) - already $seq_len = 1

        ## Extract the complete sequence (or what we have)
        return substr( $$buf_ref, 0, $seq_len, '' );
    }

## Helper: write bytes ensuring complete write (syswrite may be partial)
    sub _syswrite_complete {    ### extract subroutine ## [LLL]
        my ( $fh, $data ) = @ARG;
        my $total   = length($data);
        my $written = 0;

        while ( $written < $total ) {
            my $n = syswrite( $fh, $data, $total - $written, $written );
            last if !defined $n or $n <= 0;
            $written += $n;
        }
        return $written;
    }

    ## If we got ESC, keep reading to complete the escape sequence
    if ( $key eq "\e" ) {
        $escape_buffer = $key;

        ## Accumulate more characters to complete escape sequence
        my $seq_complete = 0;
        for ( my $i = 0; $i < 20 && !$seq_complete; $i++ ) {
            ## Check if we need more input
            if ( !length $input_chars && -t STDIN ) {
                my $bytes_read = sysread( STDIN, $input_chars, 64 );
                last if not defined $bytes_read or $bytes_read <= 0;
            }
            last if not length $input_chars;

            my $next_key = substr( $input_chars, 0, 1, '' );
            $escape_buffer .= $next_key;

            ## Check if sequence is complete (arrow keys or function keys)
            ## Matches: \e[A-Z (like arrow keys), \eOA-Z (alternate arrow), \e[...~ (function keys with any modifiers)
            $seq_complete = TRUE
                if $escape_buffer =~ m{\e\[[A-Z]|\eO[A-Z]|\e\[[0-9;]*~$};
        }

        ## Initialize editor early if needed (before loading history)
        $editor //= AMOS7::TERM::editor_init();

        ## Now process the complete escape sequence
        if ( $escape_buffer eq "\e[A" ) {
            ## Up arrow
            my $target_index = -1;
            my $lines_ref    = undef;

            if ( $current_history_index >= 0 ) {
                ## We're viewing history from Page Up/Down - navigate relative to current position
                ## Up = newer = lower index
                $target_index = $current_history_index - 1;
                if (   $target_index >= 0
                    && $target_index < @AMOS7::TERM::history_entries ) {
                    my $entry = $AMOS7::TERM::history_entries[$target_index];
                    if ( ref($entry) eq 'ARRAY' && $entry->[1] ) {
                        $lines_ref = $entry->[1];
                    }
                }
            } else {
                ## Not in tracked history - use library function
                $lines_ref = AMOS7::TERM::history_up();
            }

            if ( defined $lines_ref ) {
                ## Clear previous display before showing new one
                my $clear_len = length($display_buffer) + 8;
                print "\r" . ( ' ' x $clear_len ) . "\r" if $clear_len > 0;

                $display_buffer = join "\n", $lines_ref->@*;
                $command_buffer = $display_buffer;

                ## Update history index if navigating from tracked position
                $current_history_index = $target_index if $target_index >= 0;

                ## Store recalled buffer for terminal restore on Ctrl+C
                $data{'nshell'}{'current_buffer'} = $command_buffer;

                ## Load into editor to sync editor buffer with loaded history
                AMOS7::TERM::editor_load( $editor, $command_buffer );

                $display_buffer = $colors{'p7_fg_0004'} . $display_buffer;
                <[nshell.redraw_command_line]>->(
                    $command_buffer, $display_buffer
                );

                ## Render cursor at editor's position
                ## Terminal is already at end of buffer after redraw_command_line
                ## Just move back if cursor is not at end, then render cursor
                my $cursor_pos     = $editor->{cursor_pos};
                my $buffer         = $editor->{buffer};
                my $buf_len        = length($buffer);
                my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';

                ## Move back to cursor position (if not at end)
                if ( $cursor_pos < $buf_len ) {
                    my $moves_back = $buf_len - $cursor_pos;
                    print "\x08" x $moves_back;
                }

                ## Render cursor at current position
                if ( $char_at_cursor eq '' or $char_at_cursor eq ' ' ) {
                    print $colors{p7_fg_0003} . '_';
                } else {
                    print "\e[7m" . $char_at_cursor . "\e[27m";
                }

                print "\e[0m" . $colors{p7_fg_0004};
                print "\e[K";
            }
        } elsif ( $escape_buffer eq "\e[B" ) {
            ## Down arrow
            my $target_index = -1;
            my $lines_ref    = undef;

            if ( $current_history_index >= 0 ) {
                ## We're viewing history from Page Up/Down - navigate relative to current position
                ## Down = older = higher index
                $target_index = $current_history_index + 1;
                if (   $target_index >= 0
                    && $target_index < @AMOS7::TERM::history_entries ) {
                    my $entry = $AMOS7::TERM::history_entries[$target_index];
                    if ( ref($entry) eq 'ARRAY' && $entry->[1] ) {
                        $lines_ref = $entry->[1];
                    }
                } else {
                    ## Reached end of history - clear buffer and reset
                    $current_history_index = -1;
                }
            } else {
                ## Not in tracked history - use library function
                $lines_ref = AMOS7::TERM::history_down();
            }

            if ( defined $lines_ref ) {
                ## Clear previous display before showing new one
                my $clear_len = length($display_buffer) + 8;
                print "\r" . ( ' ' x $clear_len ) . "\r" if $clear_len > 0;

                $display_buffer = join "\n", $lines_ref->@*;
                $command_buffer = $display_buffer;

                ## Update history index if navigating from tracked position
                $current_history_index = $target_index if $target_index >= 0;

                ## Store recalled buffer for terminal restore on Ctrl+C
                $data{'nshell'}{'current_buffer'} = $command_buffer;

                ## Load into editor to sync editor buffer with loaded history
                AMOS7::TERM::editor_load( $editor, $command_buffer );

                $display_buffer = $colors{'p7_fg_0004'} . $display_buffer;
                <[nshell.redraw_command_line]>->(
                    $command_buffer, $display_buffer
                );

                ## Render cursor at editor's position
                ## Terminal is already at end of buffer after redraw_command_line
                ## Just move back if cursor is not at end, then render cursor
                my $cursor_pos     = $editor->{cursor_pos};
                my $buffer         = $editor->{buffer};
                my $buf_len        = length($buffer);
                my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';

                ## Move back to cursor position (if not at end)
                if ( $cursor_pos < $buf_len ) {
                    my $moves_back = $buf_len - $cursor_pos;
                    print "\x08" x $moves_back;
                }

                ## Render cursor at current position
                if ( $char_at_cursor eq '' or $char_at_cursor eq ' ' ) {
                    print $colors{p7_fg_0003} . '_';
                } else {
                    print "\e[7m" . $char_at_cursor . "\e[27m";
                }

                print "\e[0m" . $colors{p7_fg_0004};
                print "\e[K";
            } else {
                my $clear_len = length($display_buffer) + 8;
                print "\r" . ( ' ' x $clear_len ) . "\r";
                $display_buffer = '';
                $command_buffer = '';

                ## Clear editor when reaching new command position
                AMOS7::TERM::editor_reset($editor);

                ## Render cursor at start of new empty line
                print $colors{p7_fg_0003} . '_' . "\e[0m"
                    . $colors{p7_fg_0004};
            }
        } elsif ( $escape_buffer eq "\e[5~" ) {
            ## Page Up - jump to previous session (grouped by temporal proximity)
            my $session_gap
                = $main::data{'nshell'}{'history'}{'session_gap_minutes'}
                // 13;
            my $gap_seconds = $session_gap * 60;

            ## Determine current history position
            my $current_index = -1;
            if ( $current_history_index >= 0 ) {
                ## Already viewing history - use tracked index
                $current_index = $current_history_index;
            } else {
                ## Not viewing history yet - search for current buffer or start at most recent
                my $current_cmd = $command_buffer // '';
                if ( length($current_cmd) ) {
                    for (
                        my $i = 0;
                        $i < @AMOS7::TERM::history_entries;
                        $i++
                    ) {
                        my $entry = $AMOS7::TERM::history_entries[$i];
                        if ( ref($entry) eq 'ARRAY' && $entry->[1] ) {
                            my $cmd = join( "\n", @{ $entry->[1] } );
                            if ( $cmd eq $current_cmd ) {
                                $current_index = $i;
                                last;
                            }
                        }
                    }
                } else {
                    ## Empty buffer - start from most recent history entry
                    $current_index = 0 if @AMOS7::TERM::history_entries;
                }
            }

            ## Skip current session (consecutive entries within gap), find previous session
            my $target_index = -1;
            if (   $current_index >= 0
                && $current_index < @AMOS7::TERM::history_entries ) {
                my $prev_time_raw
                    = $AMOS7::TERM::history_entries[$current_index]->[0];
                my $prev_time = $prev_time_raw;
                $prev_time =~ s/:[\d]+$//;    ## Strip :count suffix

                for (
                    my $i = $current_index + 1;
                    $i < @AMOS7::TERM::history_entries;
                    $i++
                ) {
                    my $entry          = $AMOS7::TERM::history_entries[$i];
                    my $entry_time_raw = $entry->[0];
                    my $entry_time     = $entry_time_raw;
                    $entry_time =~ s/:[\d]+$//;    ## Strip :count suffix

                    ## Calculate time difference using base.ntime.delta_seconds
                    my $time_diff = <[base.ntime.delta_seconds]>->(
                        $prev_time, $entry_time
                    ) // 0;

                    ## Found session boundary (gap >= session_gap_minutes)
                    if ( $time_diff >= $gap_seconds ) {
                        ## Found start of previous session, go to it
                        $target_index
                            = $i;   ## Jump to first entry of previous session
                        last;
                    }
                    $prev_time = $entry_time;
                }

                ## If no boundary found, go to oldest entry
                if (   $target_index == -1
                    && $current_index < @AMOS7::TERM::history_entries - 1 ) {
                    $target_index = @AMOS7::TERM::history_entries - 1;
                }
            }

            ## Load and display the target entry
            if (   $target_index >= 0
                && $target_index < @AMOS7::TERM::history_entries ) {
                my $entry = $AMOS7::TERM::history_entries[$target_index];
                if ( ref($entry) eq 'ARRAY' && $entry->[1] ) {
                    my $lines_ref = $entry->[1];

                    ## Clear previous display before showing new one
                    my $clear_len = length($display_buffer) + 8;
                    print "\r" . ( ' ' x $clear_len ) . "\r"
                        if $clear_len > 0;

                    $display_buffer = join "\n", $lines_ref->@*;
                    $command_buffer = $display_buffer;

                    ## Track that we're viewing this history entry (Page Up)
                    $current_history_index = $target_index;

                    ## Store recalled buffer for terminal restore on Ctrl+C
                    $data{'nshell'}{'current_buffer'} = $command_buffer;

                    ## Load into editor to sync editor buffer with loaded history
                    AMOS7::TERM::editor_load( $editor, $command_buffer );

                    $display_buffer = $colors{'p7_fg_0004'} . $display_buffer;
                    <[nshell.redraw_command_line]>->(
                        $command_buffer, $display_buffer
                    );

                    ## Render cursor at editor's position
                    my $cursor_pos     = $editor->{cursor_pos};
                    my $buffer         = $editor->{buffer};
                    my $buf_len        = length($buffer);
                    my $char_at_cursor = substr( $buffer, $cursor_pos, 1 )
                        // '';

                    ## Move back to cursor position (if not at end)
                    if ( $cursor_pos < $buf_len ) {
                        my $moves_back = $buf_len - $cursor_pos;
                        print "\x08" x $moves_back;
                    }

                    ## Render cursor at current position
                    if ( $char_at_cursor eq '' or $char_at_cursor eq ' ' ) {
                        print $colors{p7_fg_0003} . '_';
                    } else {
                        print "\e[7m" . $char_at_cursor . "\e[27m";
                    }

                    print "\e[0m" . $colors{p7_fg_0004};
                    print "\e[K";
                }
            }
        } elsif ( $escape_buffer eq "\e[6~" ) {
            ## Page Down - jump to next session (mirror of Page Up but searches backward)
            my $session_gap
                = $main::data{'nshell'}{'history'}{'session_gap_minutes'}
                // 13;
            my $gap_seconds = $session_gap * 60;

            ## Determine current history position
            my $current_index = -1;
            if ( $current_history_index >= 0 ) {
                ## Already viewing history - use tracked index
                $current_index = $current_history_index;
            } else {
                ## Not viewing history yet - search for current buffer or start at most recent
                my $current_cmd = $command_buffer // '';
                if ( length($current_cmd) ) {
                    for (
                        my $i = 0;
                        $i < @AMOS7::TERM::history_entries;
                        $i++
                    ) {
                        my $entry = $AMOS7::TERM::history_entries[$i];
                        if ( ref($entry) eq 'ARRAY' && $entry->[1] ) {
                            my $cmd = join( "\n", @{ $entry->[1] } );
                            if ( $cmd eq $current_cmd ) {
                                $current_index = $i;
                                last;
                            }
                        }
                    }
                } else {
                    ## Empty buffer - start from most recent history entry
                    $current_index = 0 if @AMOS7::TERM::history_entries;
                }
            }

            ## Skip current session (consecutive entries within gap), find next session (search backward toward index 0)
            my $target_index = -1;
            if (   $current_index >= 0
                && $current_index < @AMOS7::TERM::history_entries ) {
                my $prev_time_raw
                    = $AMOS7::TERM::history_entries[$current_index]->[0];
                my $prev_time = $prev_time_raw;
                $prev_time =~ s/:[\d]+$//;    ## Strip :count suffix

                for ( my $i = $current_index - 1; $i >= 0; $i-- ) {
                    my $entry          = $AMOS7::TERM::history_entries[$i];
                    my $entry_time_raw = $entry->[0];
                    my $entry_time     = $entry_time_raw;
                    $entry_time =~ s/:[\d]+$//;    ## Strip :count suffix

                    ## Calculate time difference using base.ntime.delta_seconds
                    my $time_diff = <[base.ntime.delta_seconds]>->(
                        $prev_time, $entry_time
                    ) // 0;

                    ## Found session boundary (gap >= session_gap_minutes)
                    if ( $time_diff >= $gap_seconds ) {
                        ## Found start of next newer session, go to last entry of it
                        $target_index
                            = $i + 1;    ## Jump to last entry of next session
                        last;
                    }
                    $prev_time = $entry_time;
                }

                ## If no boundary found, do nothing (stay in current session)
            }

            ## Load and display the target entry
            if (   $target_index >= 0
                && $target_index < @AMOS7::TERM::history_entries ) {
                my $entry = $AMOS7::TERM::history_entries[$target_index];
                if ( ref($entry) eq 'ARRAY' && $entry->[1] ) {
                    my $lines_ref = $entry->[1];

                    ## Clear previous display before showing new one
                    ## Must clear at least cursor width (1) + margin, even if display_buffer is empty
                    my $clear_len = length($display_buffer) + 20;
                    $clear_len = 20 if $clear_len < 20;
                    print "\r" . ( ' ' x $clear_len ) . "\r";

                    $display_buffer = join "\n", $lines_ref->@*;
                    $command_buffer = $display_buffer;

                    ## Track that we're viewing this history entry (Page Down)
                    $current_history_index = $target_index;

                    ## Store recalled buffer for terminal restore on Ctrl+C
                    $data{'nshell'}{'current_buffer'} = $command_buffer;

                    ## Load into editor to sync editor buffer with loaded history
                    AMOS7::TERM::editor_load( $editor, $command_buffer );

                    $display_buffer = $colors{'p7_fg_0004'} . $display_buffer;
                    <[nshell.redraw_command_line]>->(
                        $command_buffer, $display_buffer
                    );

                    ## Render cursor at editor's position
                    my $cursor_pos     = $editor->{cursor_pos};
                    my $buffer         = $editor->{buffer};
                    my $buf_len        = length($buffer);
                    my $char_at_cursor = substr( $buffer, $cursor_pos, 1 )
                        // '';

                    ## Move back to cursor position (if not at end)
                    if ( $cursor_pos < $buf_len ) {
                        my $moves_back = $buf_len - $cursor_pos;
                        print "\x08" x $moves_back;
                    }

                    ## Render cursor at current position
                    if ( $char_at_cursor eq '' or $char_at_cursor eq ' ' ) {
                        print $colors{p7_fg_0003} . '_';
                    } else {
                        print "\e[7m" . $char_at_cursor . "\e[27m";
                    }

                    print "\e[0m" . $colors{p7_fg_0004};
                    print "\e[K";
                }
            }
            ## No boundary found - stay at current position
            ## If $current_index < 0 (not in history), we're at command prompt - no change needed
            ## If $current_index >= 0 (in history), we're viewing a history entry - stay there

            $escape_buffer = '';
            next;
        } elsif ( $escape_buffer eq "\e[H"
            or $escape_buffer eq "\e[1~"
            or $escape_buffer eq "\eOH" ) {
            ## Home key (multiple variants) - map to Ctrl+A (move to start of line)
            $key           = "\x01";    ## Ctrl+A
            $escape_buffer = '';
            ## Fall through to editor processing below
        } elsif ( $escape_buffer eq "\e[F"
            or $escape_buffer eq "\e[4~"
            or $escape_buffer eq "\eOF" ) {
            ## End key (multiple variants) - map to Ctrl+E (move to end of line)
            $key           = "\x05";    ## Ctrl+E
            $escape_buffer = '';
            ## Fall through to editor processing below
        } elsif ( $escape_buffer eq "\e[C" ) {
            ## Right arrow - pass to editor for cursor movement
            $key           = $escape_buffer;
            $escape_buffer = '';
            ## Fall through to editor processing below
        } elsif ( $escape_buffer eq "\e[D" ) {
            ## Left arrow - pass to editor for cursor movement
            $key           = $escape_buffer;
            $escape_buffer = '';
            ## Fall through to editor processing below
        } elsif ( $escape_buffer eq "\e[3~" ) {
            ## Delete key - pass to editor for forward delete
            $key           = $escape_buffer;
            $escape_buffer = '';
            ## Fall through to editor processing below
        } else {
            ## Unknown escape sequence
            $escape_buffer = '';
            next;
        }

        ## If we got left/right arrows or delete, fall through to editor processing
        ## Otherwise continue to next character
        if ( length $escape_buffer ) {
            ## History sequence was handled, continue
            next;
        }

        ## Left/right/delete: continue to editor processing with $key set
    }

    ## Handle potential debug command: :COMMAND: or :COMMAND:N:
    ## Accumulate into separate buffer until we know if it's a valid pattern
    ## Only start if we're NOT in an escape sequence
    if ( $key eq ':' && !length $escape_buffer && !length $debug_cmd_buffer )
    {
        $debug_cmd_buffer = ':';
        ## Don't echo the opening colon yet, continue to next buffered
        ## character
        next;
    } elsif ( length $debug_cmd_buffer ) {
        $debug_cmd_buffer .= $key;

        if ( $key eq ':' ) {
            ## Try to parse as debug command :UP: :DOWN: :PAGE_DOWN:..
            if ( $debug_cmd_buffer =~ m,^:([A-Z_]+(?::\d+)?):$, ) {
                my $cmd_with_count = $1;
                my ( $cmd, $repeat_count )
                    = $cmd_with_count =~ m,^([A-Z_]+)(?::(\d+))?$,;
                $repeat_count //= 1;

                ## Check if this is a valid debug command
                if ( defined $cmd
                    && $cmd =~ m,^(UP|DOWN|PAGE_UP|PAGE_DOWN)$, ) {
                    ## Valid debug command - execute without echoing
                    my $history_result;
                    for ( my $i = 0; $i < $repeat_count; $i++ ) {
                        if ( $cmd eq qw| UP | ) {
                            $history_result = AMOS7::TERM::history_up();
                        } elsif ( $cmd eq qw| DOWN | ) {
                            $history_result = AMOS7::TERM::history_down();
                        } elsif ( $cmd eq qw| PAGE_UP | ) {
                            $history_result = AMOS7::TERM::history_page_up();
                        } elsif ( $cmd eq qw| PAGE_DOWN | ) {
                            $history_result
                                = AMOS7::TERM::history_page_down();
                        }
                        ## Don't continue looping if we hit a boundary (undef result)
                        last if !defined $history_result;
                    }

                    ## Replace command_buffer with history result
                    if ( defined $history_result ) {
                        $command_buffer = join "\n", $history_result->@*;
                        $display_buffer = $command_buffer;
                    }

                    $debug_cmd_buffer = '';
                    ## Don't echo anything, continue to next buffered
                    ## character
                    next;
                }
            }

            ## Not a valid debug command - echo the whole accumulated buffer
            print $debug_cmd_buffer;
            $command_buffer .= $debug_cmd_buffer;
            $debug_cmd_buffer = '';
            $display_buffer   = '';
            next;    ## Continue to next buffered character
        } elsif ( length $debug_cmd_buffer > 20 ) {
            ## Too long to be a debug command, flush it
            print $debug_cmd_buffer;
            $command_buffer .= $debug_cmd_buffer;
            $debug_cmd_buffer = '';
            $display_buffer   = '';
            next;    ## Continue to next buffered character
        }
        ## Still accumulating potential debug command, continue to next
        ## buffered character
        next;
    }

    ## Initialize editor on first key
    $editor //= AMOS7::TERM::editor_init();

    ## Process key through editor
    my $edit_result
        = AMOS7::TERM::editor_process_key( $editor, $key, %colors );

    if ( $edit_result->{action} eq qw| echo | ) {
        ## Full line redraw for character insertion - ensures clean rendering
        my $cursor_pos = $editor->{cursor_pos};
        my $buffer     = $editor->{buffer};

        ## Store current buffer in global data for terminal restore on exit
        $data{'nshell'}{'current_buffer'} = $buffer;

        ## Go to start of line
        print "\r";

        ## Print everything before cursor
        if ( $cursor_pos > 0 ) {
            print substr( $buffer, 0, $cursor_pos );
        }

        ## Render cursor inline without cursor_render's trailing backspace
        ## This avoids the positioning issues that come from the backspace
        my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';

        if ( $char_at_cursor eq '' or $char_at_cursor eq ' ' ) {
            ## At end or on space: print colored underscore (terminal cursor advances past it)
            print $colors{p7_fg_0003} . '_';
        } else {
            ## On a character: print with inverse video
            ## (stands out from both text and cursor color)
            print "\e[7m" . $char_at_cursor . "\e[27m";
        }

        ## Reset attributes and reapply text color
        ## (terminal cursor is now after the cursor character)
        print "\e[0m" . $colors{p7_fg_0004};

        ## Print everything after cursor (terminal cursor is in the right position now)
        if ( $cursor_pos < length($buffer) ) {
            my $after_cursor = substr( $buffer, $cursor_pos + 1 );
            print $after_cursor if length($after_cursor);

            ## Clear from current position to end of line
            print "\e[K";

            ## Backspace to position cursor correctly before the next character
            print "\x08" x length($after_cursor) if length($after_cursor);
        } else {
            ## At or past end of buffer
            print "\e[K";
        }

        $prev_cursor_pos       = $cursor_pos;
        $display_buffer        = ''; ## User is editing, clear display buffer
        $current_history_index = -1; ## Reset history tracking when user types
    } elsif ( $edit_result->{action} eq qw| backspace |
        or $edit_result->{action} eq qw| delete | ) {
        ## Full line redraw for deletion operations - ensures clean rendering
        my $cursor_pos = $editor->{cursor_pos};
        my $buffer     = $editor->{buffer};

        ## Reset history tracking when user edits
        $current_history_index = -1;

        ## Store current buffer in global data for terminal restore on exit
        $data{'nshell'}{'current_buffer'} = $buffer;

        ## Go to start of line
        print "\r";

        ## Print everything before cursor
        if ( $cursor_pos > 0 ) {
            print substr( $buffer, 0, $cursor_pos );
        }

        ## Render cursor inline without cursor_render's trailing backspace
        ## This avoids the positioning issues that come from the backspace
        my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';

        if ( $char_at_cursor eq '' or $char_at_cursor eq ' ' ) {
            ## At end or on space: print colored underscore (terminal cursor advances past it)
            print $colors{p7_fg_0003} . '_';
        } else {
            ## On a character: print with inverse video
            ## (stands out from both text and cursor color)
            print "\e[7m" . $char_at_cursor . "\e[27m";
        }

        ## Reset attributes and reapply text color
        ## (terminal cursor is now after the cursor character)
        print "\e[0m" . $colors{p7_fg_0004};

        ## Print everything after cursor (terminal cursor is in the right position now)
        if ( $cursor_pos < length($buffer) ) {
            my $after_cursor = substr( $buffer, $cursor_pos + 1 );
            print $after_cursor if length($after_cursor);

            ## Clear from current position to end of line
            print "\e[K";

            ## Backspace to position cursor correctly before the next character
            print "\x08" x length($after_cursor) if length($after_cursor);
        } else {
            ## At or past end of buffer
            print "\e[K";
        }

        $prev_cursor_pos = $cursor_pos;
        $display_buffer  = '';    ## User is editing, clear display buffer
    } elsif ( $edit_result->{action} eq qw| cursor_left |
        or $edit_result->{action} eq qw| cursor_right | ) {
        ## Full line redraw for cursor movement
        ## (no remnants, future-proof for color intensity)
        my $cursor_pos = $editor->{cursor_pos};
        my $buffer     = $editor->{buffer};

        ## Store current buffer in global data for terminal restore on exit
        $data{'nshell'}{'current_buffer'} = $buffer;

        ## Go to start of line
        print "\r";

        ## Print everything before cursor
        if ( $cursor_pos > 0 ) {
            print substr( $buffer, 0, $cursor_pos );
        }

        ## Render cursor inline without trailing backspace (consistent with echo handler)
        my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';

        if ( $char_at_cursor eq '' or $char_at_cursor eq ' ' ) {
            ## At end or on space: print colored underscore
            print $colors{p7_fg_0003} . '_';
        } else {
            ## On a character: print with inverse video
            ## (stands out from both text and cursor color)
            print "\e[7m" . $char_at_cursor . "\e[27m";
        }

        ## Reset attributes and reapply text color
        print "\e[0m" . $colors{p7_fg_0004};

        ## Print everything after cursor with safe bounds check
        if ( $cursor_pos < length($buffer) ) {
            my $after_cursor = substr( $buffer, $cursor_pos + 1 );
            print $after_cursor if length($after_cursor);

            ## Clear from current position to end of line
            print "\e[K";

            ## Backspace to position cursor correctly
            print "\x08" x length($after_cursor) if length($after_cursor);
        } else {
            ## At or past end of buffer
            print "\e[K";
        }

        $prev_cursor_pos = $cursor_pos;
        $display_buffer  = '';    ## User is editing, clear display buffer
    } elsif ( $edit_result->{action}
        =~ m{^(kill_to_end|kill_from_start|kill_word|yank)$} ) {
        ## Full line redraw for all buffer modifications - ensures clean rendering
        my $cursor_pos = $editor->{cursor_pos};
        my $buffer     = $editor->{buffer};

        ## Store current buffer in global data for terminal restore on exit
        $data{'nshell'}{'current_buffer'} = $buffer;

        ## Go to start of line
        print "\r";

        ## Print everything before cursor
        if ( $cursor_pos > 0 ) {
            print substr( $buffer, 0, $cursor_pos );
        }

        ## Render cursor inline without cursor_render's trailing backspace
        ## This avoids the positioning issues that come from the backspace
        my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';

        if ( $char_at_cursor eq '' or $char_at_cursor eq ' ' ) {
            ## At end or on space: print colored underscore (terminal cursor advances past it)
            print $colors{p7_fg_0003} . '_';
        } else {
            ## On a character: print with inverse video
            ## (stands out from both text and cursor color)
            print "\e[7m" . $char_at_cursor . "\e[27m";
        }

        ## Reset attributes and reapply text color
        ## (terminal cursor is now after the cursor character)
        print "\e[0m" . $colors{p7_fg_0004};

        ## Print everything after cursor (terminal cursor is in the right position now)
        if ( $cursor_pos < length($buffer) ) {
            my $after_cursor = substr( $buffer, $cursor_pos + 1 );
            print $after_cursor if length($after_cursor);

            ## Clear from current position to end of line
            print "\e[K";

            ## Backspace to position cursor correctly before the next character
            print "\x08" x length($after_cursor) if length($after_cursor);
        } else {
            ## At or past end of buffer
            print "\e[K";
        }

        $prev_cursor_pos = $cursor_pos;
        $display_buffer  = '';    ## User is editing, clear display buffer
    } elsif ( $edit_result->{action} eq qw| newline | ) {
        ## Clear cursor before printing newline
        my $cursor_pos     = $editor->{cursor_pos};
        my $buffer         = $editor->{buffer};
        my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';

        ## Go to start of line, then to cursor position, then clear cursor
        print "\r";
        if ( $cursor_pos > 0 ) {
            print substr( $buffer, 0, $cursor_pos );
        }

        if ( $char_at_cursor eq '' or $char_at_cursor eq ' ' ) {
            ## Cursor was rendered as underscore, erase it
            print "\e[K";
        } else {
            ## Cursor was rendered as inverse video character
            ## Reprint the character without inverse to overwrite the inverted display
            print $colors{p7_fg_0004} . $char_at_cursor;
        }

        ## Reset all attributes and apply text color
        print "\e[0m" . $colors{p7_fg_0004};

        ## Now print the newline
        print $edit_result->{output};
        STDOUT->flush();

        my $result = AMOS7::TERM::editor_submit($editor);
        $display_buffer   = '';
        $debug_cmd_buffer = '';    ## Clear any partial debug command

        ## Save to history if not empty
        if ( length $result ) {
            my @lines = split "\n", $result;
            AMOS7::TERM::history_add(@lines);
        }

        ## Trigger cursor display after newline (whether command is empty or not)
        ## This handles both: empty Enter and Enter with command output
        $show_cursor_on_call = TRUE;

        ## If there's a command result, return it (which will trigger shell_loop -> hook -> cursor)
        if ( length $result ) {
            return $result;
        }

        ## For empty line, trigger watcher immediately to show cursor
        my ($session_id) = keys <user.cube.session>->%*;
        if ( defined $session_id and defined $data{'session'}{$session_id} ) {
            my $session = $data{'session'}{$session_id};
            if ( defined $session->{'watcher'}{'stdin_handler'} ) {
                $session->{'watcher'}{'stdin_handler'}->now();
            }
        }

        next;    ## Continue to next buffered character
    } elsif ( $edit_result->{action} eq qw| signal | ) {
        ## Clear cursor before sending signal, preserve buffer content
        ## User may want to exit shell with history command visible for copy-paste
        my $cursor_pos     = $editor->{cursor_pos};
        my $buffer         = $editor->{buffer};
        my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';

        ## Go to start of line, clear any cursor remnants, then print buffer
        print "\r\e[K" . $colors{p7_fg_0004} . $buffer . " ";
        STDOUT->flush();

        ## Clear the buffer flag so term_restore doesn't try to clean up
        ## We've already printed the buffer on screen for copy-paste
        delete $data{'nshell'}{'current_buffer'};

        ## Send signal to current process
        my $sig = $edit_result->{should_signal} // 'INT';
        kill( $sig, $$ );
        next;    ## Continue to next buffered character
    }

    ## For 'none' action, just continue

}    ## End of while ( length $input_chars ) loop

return undef;    ## No complete line yet, buffer exhausted or incomplete UTF-8

