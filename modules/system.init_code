## [:< ##

# name = system.init_code

<system.cleanup_on_startup> //= 1;

<[base.perlmod.load]>->( 'File::Path', qw| remove_tree | );

<system.path.cleanup_files> //= sprintf( '%s/zenki/%s/cleanup-on-upgrade',
    <system.conf_path>, <system.zenka.name> );

0;

