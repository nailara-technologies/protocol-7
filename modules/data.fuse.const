## [:< ##
# name  = data.fuse.const
# descr = FUSE filesystem constants

use constant {

    # File types
    S_IFMT   => 0170000,    # Type of file mask
    S_IFDIR  => 0040000,    # Directory
    S_IFCHR  => 0020000,    # Character device
    S_IFBLK  => 0060000,    # Block device
    S_IFREG  => 0100000,    # Regular file
    S_IFIFO  => 0010000,    # FIFO
    S_IFLNK  => 0120000,    # Symbolic link
    S_IFSOCK => 0140000,    # Socket

    # File mode bits
    S_IRWXU => 00700,       # Owner read/write/execute
    S_IRUSR => 00400,       # Owner read
    S_IWUSR => 00200,       # Owner write
    S_IXUSR => 00100,       # Owner execute
    S_IRWXG => 00070,       # Group read/write/execute
    S_IRGRP => 00040,       # Group read
    S_IWGRP => 00020,       # Group write
    S_IXGRP => 00010,       # Group execute
    S_IRWXO => 00007,       # Other read/write/execute
    S_IROTH => 00004,       # Other read
    S_IWOTH => 00002,       # Other write
    S_IXOTH => 00001,       # Other execute

    # Combined modes for convenience
    MODE_DIR  => 0040755,    # drwxr-xr-x
    MODE_FILE => 0100644,    # -rw-r--r--
    MODE_EXEC => 0100755,    # -rwxr-xr-x
    MODE_LINK => 0120777,    # lrwxrwxrwx
};

# Export all constants
use Exporter qw| import |;
our @EXPORT = qw|
    S_IFMT S_IFDIR S_IFCHR S_IFBLK S_IFREG S_IFIFO S_IFLNK S_IFSOCK
    S_IRWXU S_IRUSR S_IWUSR S_IXUSR
    S_IRWXG S_IRGRP S_IWGRP S_IXGRP
    S_IRWXO S_IROTH S_IWOTH S_IXOTH
    MODE_DIR MODE_FILE MODE_EXEC MODE_LINK
    |;

