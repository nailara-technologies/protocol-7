# name = models.cmd.invoke_participant
# descr = invoke participant with automatic fallback on rate limit

# Extract params - $call is set by code header
my $params = {};

if ( defined $call->{'param'} && ref $call->{'param'} eq qw| HASH | ) {
    $params = $call->{'param'};
} elsif ( defined $call->{'args'} && length $call->{'args'} ) {

    # Try parsing as JSON first, fall back to YAML
    eval { $params = JSON::PP::decode_json( $call->{'args'} ); };
    if ( length $EVAL_ERROR ) {
        eval { $params = YAML::XS::Load( $call->{'args'} ); };
    }
    $params = {} if length $EVAL_ERROR;
}

my $job_id         = $params->{'job_id'}         // '';
my $participant_id = $params->{'participant_id'} // '';
my $system_prompt  = $params->{'system_prompt'}  // '';
my $messages       = $params->{'messages'}       // [];
my $context        = $params->{'context'}        // 'conversation';

if ( !length($job_id) ) {
    return {
        'mode' => qw| false |,
        'data' => "error: job_id required\n"
    };
}

if ( !length($participant_id) ) {
    return {
        'mode' => qw| false |,
        'data' => "error: participant_id required\n"
    };
}

# Call the actual invoke_participant module
my $result = <[models.invoke_participant]>->(
    {   'job_id'         => $job_id,
        'participant_id' => $participant_id,
        'system_prompt'  => $system_prompt,
        'messages'       => $messages,
        'context'        => $context,
    }
);

# Return as YAML
my $yaml_data = YAML::XS::Dump($result);
return {
    'mode' => qw| size |,
    'data' => $yaml_data
};

