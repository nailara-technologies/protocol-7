## [:< ##

# name  = p7-log.startup.repair_nul_gaps
# descr = at boot, before any new line is appended, check the tail of each
#          own log file for a trailing zero-byte run and truncate it off --
#          the only way a gap can form [ see p7-log.handler.close_log ] is
#          an idle-closed file whose last write never got fsynced before a
#          host crash / abrupt WSL shutdown, which can only ever leave
#          trailing zeros at the exact end of the file as it stood at that
#          moment -- mid-file gaps [ from older, already-passed-over
#          restarts ] are a separate, historical issue and untouched here.
#          cheap : single-byte check per file in the common [ no gap ] case

my $system_name  = <system.host.hostname>;
my $log_dir_path = <log.protocol_7.path>;

my @logfile_paths;
<[file.match_files]>->(
    \@logfile_paths, $log_dir_path, "$system_name.**.log"
);

my $repaired_files = 0;

foreach my $log_path (@logfile_paths) {

    ## File::stat is in effect globally here : stat() returns a blessed  ##
    ## object [ ->size, ->mode, .. ], NOT the classic 13-element list -- ##
    ## see File::stat::stat($ARG)->size in p7-log.cmd.file-sizes         ##
    my $file_stat = File::stat::stat($log_path);
    next if not defined $file_stat;
    my $file_size = $file_stat->size;
    next if not $file_size;

    my $fh;
    if ( not open( $fh, '<:raw', $log_path ) ) {
        <[base.log]>->(
            0,         "repair_nul_gaps : cannot open [%s] : %s",
            $log_path, <[base.str.os_err]>
        );
        next;
    }

    ## cheapest possible check first -- just the last byte ##
    seek( $fh, $file_size - 1, 0 );
    my $last_byte;
    read( $fh, $last_byte, 1 );

    if ( $last_byte ne "\x00" ) {
        close($fh);
        next;
    }

    ## last byte is NUL -- read backwards in growing chunks until we find ##
    ## the boundary between real content and the trailing zero run        ##
    my $chunk_size = 4096;
    my $trailing_len;
    while (1) {
        my $read_len = $chunk_size < $file_size ? $chunk_size : $file_size;
        seek( $fh, $file_size - $read_len, 0 );
        my $tail;
        read( $fh, $tail, $read_len );

        if ( $tail =~ m|(\x00+)\z| ) {
            $trailing_len = length($1);
            last if $trailing_len < $read_len or $read_len == $file_size;
        } else {
            ## shouldn't happen [ last byte was NUL ] -- bail out safely ##
            $trailing_len = undef;
            last;
        }
        $chunk_size *= 4;    ## whole chunk was zero -- widen and retry ##
    }
    close($fh);

    next if not defined $trailing_len or $trailing_len == 0;

    my $new_size = $file_size - $trailing_len;

    if ( not truncate( $log_path, $new_size ) ) {
        <[base.log]>->(
            0,         "repair_nul_gaps : cannot truncate [%s] : %s",
            $log_path, <[base.str.os_err]>
        );
        next;
    }

    $repaired_files++;
    <[base.logs]>->(
        1, "repair_nul_gaps : truncated %d trailing zero-byte%s from [%s]",
        $trailing_len, <[base.cnt_s]>->($trailing_len), $log_path
    );

    ## find the session id [sid] of the last real line still in the file,   ##
    ## to attribute the notice to -- a new zenka boot always logs its own   ##
    ## new sid first, so "the last one seen" can never have silently gone   ##
    ## stale. base.log/base.logs can't write into another zenka's log file  ##
    ## [ they only ever report the CALLING zenka's own operation ], so this ##
    ## notice is a direct write, same as legacy_gap_sweep.run's mid-file    ##
    ## notices -- kept short per line : this log format still expects       ##
    ## console-width-tight single lines, no wrapping support yet no prior   ##
    ## line found [ file starts with the gap ] -- 7777777, never '0000000'  ##
    ## [ reserved for "from cube itself" ], distinct enough from real ids   ##
    ## to read as an intentional "no prior context" marker [ same spirit as ##
    ## this project's ELF-7 checksum fix : +=777 per zero-byte instead of   ##
    ## +=0, so a zero byte's presence actually shows up ]                   ##
    my $own_sid = 7777777;
    {
        my $ctx_fh;
        if ( open( $ctx_fh, '<:raw', $log_path ) ) {
            my $read_len = $new_size < 4096 ? $new_size : 4096;
            seek( $ctx_fh, $new_size - $read_len, 0 );
            my $ctx;
            read( $ctx_fh, $ctx, $read_len );
            close($ctx_fh);
            $own_sid = $1 if $ctx =~ m|\S+ (\S+) \d+ [^\n]*\n?\z|;
        }
    }

    ## base.log gates every write against configured verbosity before it ##
    ## ever reaches a log file -- a hand-assembled write has to respect  ##
    ## that too, or it ignores what the operator configured              ##
    my $notice_level = 0;
    next if $notice_level > ( <system.zenka.verbosity.logfile> // 0 );

    my $repl_id = <[base.ntime.b32]>;
    my $notice  = sprintf(
        "%s %s 0 [p7-log] truncated %d trailing zero-byte%s at boot .,\n%s "
            . "%s 0 [p7-log] likely unflushed writeback lost to a crash / "
            . "shutdown .,\n%s %s 0 [p7-log] see p7-log.handler.close_log\n",
        $repl_id, $own_sid, $trailing_len, <[base.cnt_s]>->($trailing_len),
        $repl_id, $own_sid, $repl_id,      $own_sid
    );

    my $out_fh;
    if ( open( $out_fh, '>>:raw', $log_path ) ) {
        print {$out_fh} $notice;
        close($out_fh);
    } else {
        <[base.log]>->(
            0,         "repair_nul_gaps : cannot append notice to [%s] : %s",
            $log_path, <[base.str.os_err]>
        );
    }
}

<[base.logs]>->(
    1, "repair_nul_gaps : %d file%s had a trailing gap truncated",
    $repaired_files, <[base.cnt_s]>->($repaired_files)
) if $repaired_files;

return TRUE;

