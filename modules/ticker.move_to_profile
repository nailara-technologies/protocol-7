## [:< ##

# name  = ticker.move_to_profile
# param = $target_profile [ $previous_profile ]
# descr = apply a window placement profile, forcing the move via X11
#         ConfigureWindow retries [needed under WSLg/Wayland, where GTK
#         moves are not honored once the window is mapped]. on
#         verification failure, reverts to $previous_profile [or the
#         profile active before this call] and restores fade opacity.
#         returns TRUE on success, FALSE if the move did not land.

my $target   = shift;
my $previous = shift // <ticker.window.profile> // qw| bottom-strip |;

<[ticker.cmd.set-window-profile]>->( { 'args' => $target } );

return TRUE if not defined <x11.id>;

<[base.X-11.move-window]>->(
    <x11.id>,              <x11.coordinates.left>,
    <x11.coordinates.top>, <x11.window.width>,
    <x11.window.height>
);

## the first move/configure after (re)map tends to be dropped by WSLg/   ##
## Weston; a second [and third] apply a bit after the first one is what  ##
## actually lands. give the compositor a brief moment, then repeat both  ##
## the GTK move/resize and the X11 ConfigureWindow before verifying.     ##
<[base.sleep]>->(0.15);
<[ticker.cmd.set-window-profile]>->( { 'args' => $target } );
<[base.X-11.move-window]>->(
    <x11.id>,              <x11.coordinates.left>,
    <x11.coordinates.top>, <x11.window.width>,
    <x11.window.height>
);

<[base.sleep]>->(0.15);
<[ticker.cmd.set-window-profile]>->( { 'args' => $target } );
<[base.X-11.move-window]>->(
    <x11.id>,              <x11.coordinates.left>,
    <x11.coordinates.top>, <x11.window.width>,
    <x11.window.height>
);

## verify the window actually moved and is near the target; if not,     ##
## revert the profile and restore visibility, since the caller may have ##
## triggered this at opacity 0 [fade-out].                              ##
my $actual = <[base.X-11.get_window_geometry]>->(<x11.id>);
return TRUE if not defined $actual;

my $tol        = 50;
my $dx         = abs( $actual->{'x'} - <x11.coordinates.left> );
my $dy         = abs( $actual->{'y'} - <x11.coordinates.top> );
my $off_target = ( $dx > $tol or $dy > $tol );

## pre-existing bug, found live: $did_not_move only compares actual vs the  ##
## PRIOR position, with no regard for whether the target equals the prior  ##
## position too [ eg a redundant/duplicate swap call landing on the edge   ##
## it's already on ]. that misclassified an already-correct position as a  ##
## failure whenever before_geo happened to equal the target, triggering    ##
## an unnecessary fallback cascade. success must only depend on whether we  ##
## actually reached the TARGET, not on whether the prior position differed. ##
return TRUE if not $off_target;

<[base.log]>->(
    1,
    sprintf(
        ': profile move to %s failed (actual x=%d y=%d, target x=%d y=%d)',
        $target,        $actual->{'x'},
        $actual->{'y'}, <x11.coordinates.left>,
        <x11.coordinates.top>
    )
);

## before giving up entirely, try a list of known-alternate positions via  ##
## a real move+verify [ window.place.find_safe_position ] - generic        ##
## recovery for the class of bug move-window's own mismatch detector       ##
## catches: a position can silently fail to apply for reasons not fully    ##
## modeled analytically, so probe real alternates instead of computing     ##
## whether one SHOULD work. a same-monitor-only candidate list can't help  ##
## if the WHOLE monitor it's anchored to is unavailable, so cycle through  ##
## every known monitor too [ window.place.build_strip_candidates ], not    ##
## just the alternate edge of the one ticker is currently on.              ##
my $monitors = <[base.gtk.list_monitors]> // [];

## prefer whichever monitor currently contains ticker's position, so the   ##
## common case [ same monitor, alternate edge ] is still tried first ##
my $cur_x = <x11.coordinates.left>;
my $cur_y = <x11.coordinates.top>;
my $preferred_index;
for my $i ( 0 .. $#$monitors ) {
    my $m = $monitors->[$i];
    if (    defined $cur_x
        and $cur_x >= $m->{'x'}
        and $cur_x < $m->{'x'} + $m->{'width'}
        and $cur_y >= $m->{'y'}
        and $cur_y < $m->{'y'} + $m->{'height'} ) {
        $preferred_index = $i;
        last;
    }
}

my $candidates = <[window.place.build_strip_candidates]>->(
    $monitors, $target, $preferred_index
);

my $safe = <[window.place.find_safe_position]>->( <x11.id>, $candidates );

if ( defined $safe and defined $safe->{'profile'} ) {
    ## a fallback candidate landed somewhere real - the window is visible  ##
    ## and correctly placed there, just not at the ORIGINALLY requested    ##
    ## profile. raise it and leave fade/visibility state alone instead of  ##
    ## forcing keep_below + opacity=1 below, which would push a correctly-  ##
    ## placed, fully-opaque window BEHIND other windows - confirmed live   ##
    ## this looked identical to "stuck invisible, needs a restart" even    ##
    ## though the window was technically fine, just hidden behind others.  ##
    <ticker.window.profile> = $safe->{'profile'};

    <[base.X-11.raise-window]>->(<x11.id>);
    <[base.X-11.keep_above]>->(<x11.id>);
} else {
    ## nothing landed at all - revert the profile name even though the     ##
    ## geometry itself never verified, and force full visibility so the    ##
    ## caller doesn't end up stuck at opacity 0 with nothing left to fade   ##
    ## it back in.                                                         ##
    <[ticker.cmd.set-window-profile]>->( { 'args' => $previous } );
    <[base.X-11.keep_below]>->(<x11.id>);

    if ( defined <ticker.timer.fade> ) {
        <ticker.timer.fade>->cancel;
        delete <ticker.timer.fade>;
    }
    delete <ticker.time.fade_view>;
    delete <ticker.fade.handler>;
    <ticker.fade_opacity> = 1;
    <ticker.obj.window>->set_opacity(1)
        if <ticker.is_composited> and defined <ticker.obj.window>;
}

## resync tracked coordinates to GROUND TRUTH regardless of which branch   ##
## above ran - confirmed live: trusting set-window-profile/find_safe_      ##
## position's COMPUTED values [ rather than re-querying the window's REAL  ##
## position ] left ticker.handler.check_pointer's hover-detection box      ##
## wrong, so it could never register the pointer as "outside" again no     ##
## matter where the mouse actually was - the fade-stuck bug.               ##
my $ground_truth = <[base.X-11.get_window_geometry]>->(<x11.id>);
if ( defined $ground_truth ) {
    <x11.coordinates.left>  = $ground_truth->{'x'};
    <x11.coordinates.top>   = $ground_truth->{'y'};
    <x11.coordinates.right> = $ground_truth->{'x'} + $ground_truth->{'width'};
    <x11.coordinates.bottom>
        = $ground_truth->{'y'} + $ground_truth->{'height'};
    <x11.window.width>  = $ground_truth->{'width'};
    <x11.window.height> = $ground_truth->{'height'};
}

return FALSE;

