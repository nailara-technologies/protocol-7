## [:< ##

# name = ticker.handler.fade_out

my $timer  = shift->w;
my $window = <ticker.obj.window>;

if ( not defined <ticker.time.fade_view> ) {
    <[base.log]>->( 2, ":. fade-out started.," );
    <ticker.fade_opacity> //= 1;
    <ticker.time.fade_view> = <[base.time]>->(3);
}

my $delta_t = sprintf( '%.3f', <[base.time]>->(3) - <ticker.time.fade_view> );

<ticker.fade_opacity> -= <[ticker.calc_decr]>->($delta_t);
<ticker.fade_opacity> = 0 if <ticker.fade_opacity> <= 0;

if (<ticker.is_composited>) {
    $window->set_opacity(<ticker.fade_opacity>);
}

if ( <ticker.fade_opacity> == 0 ) {
    <[base.log]>->( 2, ":: fade-out complete." );

    if ( <[base.cfg_bool]>->(<ticker.mouse.swap_edge>) ) {
        my $current = <ticker.window.profile> // qw| bottom-strip |;
        if ( $current =~ m{^bottom-strip$} ) {
            <[base.log]>->( 1, ': swap mode: moving ticker to top edge' );
            <[ticker.cmd.set-window-profile]>
                ->( { 'args' => qw| top-strip | } );
        } elsif ( $current =~ m{^top-strip$} ) {
            <[base.log]>->( 1, ': swap mode: moving ticker to bottom edge' );
            <[ticker.cmd.set-window-profile]>
                ->( { 'args' => qw| bottom-strip | } );
        }
        ## fade-in is handled by check_pointer once it sees the new edge is free ##
    } elsif ( defined <x11.id> ) {
        <[base.X-11.keep_below]>->(<x11.id>);
    }

    delete <ticker.fade_opacity>;
    delete <ticker.time.fade_view>;
    delete <ticker.timer.fade>;
    $timer->cancel;
}

