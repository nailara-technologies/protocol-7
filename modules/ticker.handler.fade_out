## [:< ##

# name = ticker.handler.fade_out

my $timer  = shift->w;
my $window = <ticker.obj.window>;

if ( not defined <ticker.time.fade_view> ) {
    <[base.log]>->( 2, ":. fade-out started.," );
    <ticker.fade_opacity> //= 1;
    <ticker.time.fade_view> = <[base.time]>->(3);
}

my $delta_t = sprintf( '%.3f', <[base.time]>->(3) - <ticker.time.fade_view> );

## in swap mode stretch/compress the fade so it reaches opacity 0 exactly   ##
## at ticker.swap.delay seconds.  calc_decr/calc_incr are tuned for a 4s    ##
## fade, so scaling time by 4/delay maps the delay onto that curve.        ##
my $delay      = <ticker.swap.delay> // 3;
my $time_scale = 1;
if (    <[base.cfg_bool]>->(<ticker.mouse.swap_edge>)
    and not <ticker.swap.disabled>
    and $delay > 0 ) {
    $time_scale = 4 / $delay;
}

my $fade_t = sprintf( '%.3f', $delta_t * $time_scale );

<ticker.fade_opacity> -= <[ticker.calc_decr]>->($fade_t);
<ticker.fade_opacity> = 0 if <ticker.fade_opacity> <= 0;

if (<ticker.is_composited>) {
    $window->set_opacity(<ticker.fade_opacity>);
}

if ( <ticker.fade_opacity> == 0 ) {
    <[base.log]>->( 2, ":: fade-out complete." );

    if ( delete <ticker.dismiss.pending> ) {
        ## ticker.dismiss requested a fade-out before hiding/pausing ##
        <[ticker.dismiss_now]>;
    } elsif ( ( <ticker.display.mode> // qw| continuous | ) eq qw| notify | )
    {
        ## notify mode: hovering fully faded the message out -> dismiss it ##
        <[base.log]>->( 1, ': notify message dismissed, hiding ticker' );

        my $notify_window = <ticker.obj.window>;
        $notify_window->hide if defined $notify_window;

        <ticker.notify.dismissed> = TRUE;
        delete <ticker.animation_started>;
        delete <ticker.draw.x_pos>;

        ## resolve any deferred :wait-dismissed: replies, including all      ##
        ## pending ones from back-to-back notify calls.                      ##
        my $pending = <ticker.notify.pending_reply_ids> // [];
        if ( scalar @{$pending} ) {
            my $chksum     = <ticker.content.chksum_L13> // '';
            my $reply_data = "notify dismissed [$chksum]";
            foreach my $reply_id ( @{$pending} ) {
                <[base.callback.cmd_reply]>->(
                    $reply_id,
                    {   'mode' => qw| true |,
                        'data' => $reply_data
                    }
                );
            }
            <ticker.notify.pending_reply_ids> = [];
            <[base.log]>->(
                1,
                sprintf( ': notify resolved %d deferred reply(s)',
                    scalar @{$pending} )
            );
        }

        if ( <[base.cfg_bool]>->(<ticker.notify.terminate_after_dismiss>) ) {
            <[base.log]>->(
                1, ': notify terminate_after_dismiss enabled, exiting'
            );
            Gtk3->main_quit;
        }
    } elsif ( <[base.cfg_bool]>->(<ticker.mouse.swap_edge>)
        and not <ticker.swap.disabled> ) {
        ## move the ticker to the opposite edge as soon as the fade ends.  ##
        <[ticker.cmd.swap_profile]>->(<ticker.window.profile>);

        ## keep it raised so check_pointer can fade it in on the new edge. ##
        if ( defined <x11.id> ) {
            <[base.X-11.raise_window]>->(<x11.id>);
            <[base.X-11.keep_above]>->(<x11.id>);
        }
    } else {
        <[base.X-11.keep_below]>->(<x11.id>) if defined <x11.id>;
    }

    delete <ticker.fade_opacity>;
    delete <ticker.time.fade_view>;
    delete <ticker.timer.fade>;
    delete <ticker.fade.handler>;
    $timer->cancel;
}

