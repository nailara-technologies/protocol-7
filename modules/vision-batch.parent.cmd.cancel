## [:< ##

# name = vision-batch.parent.cmd.cancel
# descr = Cancel batch processing

# Extract batch_id from command args
# Automatic code header provides $call->{'args'}
# with space-separated arguments

my $batch_id;
if ( defined $call && ref($call) eq qw| HASH | && defined $call->{'args'} ) {

    # Extract first argument from space-separated args string
    $batch_id = ( split m|\s+|, $call->{'args'} )[0];
}

return { 'mode' => qw| FALSE |, 'data' => 'Batch ID required' }
    unless defined $batch_id;

# Get batch_state to find the batch
my $batch_state = <vision-batch.batch_state>;
return { 'mode' => qw| FALSE |, 'data' => 'No active batch found' }
    unless defined $batch_state;
return { 'mode' => qw| FALSE |, 'data' => "Batch $batch_id not found" }
    if $batch_state->{batch_id} ne $batch_id;

# Trigger shutdown of batch
my $shutdown_result = <[vision-batch.parent.shutdown]>;

if ( $shutdown_result->{success} ) {
    $batch_state->{status}       = 'cancelled';
    $batch_state->{cancelled_at} = <[base.time]>->(3);

    # Return as YAML string for human-readable output
    <[base.perlmod.load]>->( 'YAML::XS', qw| Dump | );
    my $yaml = YAML::XS::Dump(
        {   batch_id              => $batch_id,
            message               => 'Batch cancellation initiated',
            shutdown_signals_sent => $shutdown_result->{signals_sent},
            pipes_closed          => $shutdown_result->{pipes_closed}
        }
    );
    return {
        'mode' => qw| size |,
        'data' => $yaml
    };
} else {
    return { 'mode' => qw| false |, 'data' => $shutdown_result->{error} };
}

