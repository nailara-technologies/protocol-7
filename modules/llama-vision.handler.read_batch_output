# name  = llama-vision.handler.read_batch_output
# descr = non-blocking I/O handler - read output chunks from batched vision CLI

my $event   = shift->w;
my $read_fh = $event->fd;
my $batch_id = $event->data;

my $batch_job = <llama-vision.jobs>->{$batch_id};

unless ( defined $batch_job ) {
    $event->cancel if $event->is_active;
    return;
}

# Read available data from stdout (non-blocking)
my $bytes = <[base.s_read]>->(
    $read_fh,
    \$batch_job->{'output'},
    8 * 1024    # Read up to 8KB at a time
) // 0;

<[base.logs]>->(
    2, "[read_batch_output] batch=%s bytes=%d",
    $batch_id, $bytes
) if $bytes > 0;

# Check for EOF - when stdout closes, vision CLI is done
if ( $bytes <= 0 ) {
    close($read_fh);
    $event->cancel if $event->is_active;
    <[base.logs]>->(
        1, "[read_batch_output] EOF: batch=%s - triggering completion",
        $batch_id
    );

    # Trigger completion handler
    <[llama-vision.handler.check_batch_completion]>->(
        { 'w' => { 'data' => $batch_id, 'is_active' => sub { 0 } } }
    );
}

