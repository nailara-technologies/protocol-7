## [:< ##

# name  = base.slot.resolve
# descr = resolve a slot address to its current registry entry
# param = { address }

my $address = $ARG[0]->{'address'} // '';

return undef if not length $address;

## parse stable prefix or full geometry-suffixed form
my $chksum7;
if ( $address =~ m|^SLOT:([^:]+):| ) {
    $chksum7 = $1;
} else {
    return undef;
}

return <base.slots>->{$chksum7};

