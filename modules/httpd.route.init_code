## [:< ##

# name  = httpd.route.init_code
# descr = parse routes config file, populate httpd route registry

my $root_path  = <system.root_path> // qw| . |;
my $routes_cfg = "$root_path/cfg/zenki/httpd/routes";

$data{'httpd'}{'route'}      //= { 'exact' => {}, 'prefix' => {} };
$data{'httpd'}{'route_args'} //= { 'exact' => {}, 'prefix' => {} };

if ( not -f $routes_cfg ) {
    <[base.logs]>->(
        1, 'httpd.route: no routes file found [ %s ]', $routes_cfg
    );
    return 0;
}

my $fh;
if ( not open $fh, '<', $routes_cfg ) {
    <[base.logs]>->( 0, 'httpd.route: cannot open routes file: %s', $! );
    return 0;
}

my ( $exact_count, $prefix_count ) = ( 0, 0 );

while ( my $line = <$fh> ) {
    chomp $line;
    $line =~ s|^\s+||;
    next if !length($line) or $line =~ m|^#|;

    my ( $method, $path, $sub_name, $arg_str ) = split /\s+/, $line, 4;
    next unless defined $method and defined $path and defined $sub_name;

    $method = uc $method;

    my $handler_args = {};
    if ( defined $arg_str and length $arg_str ) {
        ## parse [command:value,key=value,...] : strip brackets, split on ##
        ## comma first pair uses directive syntax 'key:value' [ see       ##
        ## load_modules: ], remaining pairs use 'key=value'               ##
        my $inner = $arg_str;
        $inner =~ s|^\[||;
        $inner =~ s|\]$||;
        my @pairs = split /,/, $inner;
        my $first = shift @pairs;
        if ( defined $first and length $first ) {
            my ( $key, $val ) = split /:/, $first, 2;
            $handler_args->{$key} = $val if defined $key and defined $val;
        }
        for my $pair (@pairs) {
            my ( $key, $val ) = split /=/, $pair, 2;
            next unless defined $key and defined $val and length $key;
            $handler_args->{$key} = $val;
        }
    }

    ## prefix routes: prefix:/api/ or prefix: /api/
    if ( $path =~ s|^prefix:|| ) {
        $data{'httpd'}{'route'}{'prefix'}{$method}{$path} = $sub_name;
        $data{'httpd'}{'route_args'}{'prefix'}{$method}{$path}
            = $handler_args;
        $prefix_count++;
    } else {
        $data{'httpd'}{'route'}{'exact'}{$method}{$path}      = $sub_name;
        $data{'httpd'}{'route_args'}{'exact'}{$method}{$path} = $handler_args;
        $exact_count++;
    }
}

close $fh;

<[base.logs]>->(
    1,            'httpd.route: loaded %d exact + %d prefix route%s',
    $exact_count, $prefix_count,
    <[base.cnt_s]>->( $exact_count + $prefix_count )
);

0;

