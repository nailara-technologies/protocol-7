## [:< ##

# name  = transport.handle.direct-tcp
# descr = direct TCP connection handler (baseline)
# args  = $entry, $context
# returns transport handle hashref or undef

my ( $entry, $ctx ) = @ARG;

my $endpoint = $entry->{'endpoint'} // $ctx->{'session'}{'destination'}
    // $ctx->{'request'}{'domain'} // '';
return undef unless length $endpoint;

my ( $host, $port ) = split /:/, $endpoint, 2;
$port //= 80;

my $sock = IO::Socket::IP->new(
    PeerHost => $host,
    PeerPort => $port,
    Type     => SOCK_STREAM(),
    Timeout  => 7,
);

if ( not $sock ) {
    <[base.logs]>->(
        0, 'transport.handle.direct-tcp: connect to %s:%d failed: %s',
        $host, $port, $OS_ERROR
    );
    return undef;
}

$sock->blocking(0);

my $dest = $ctx->{'session'}{'destination'} // $ctx->{'request'}{'domain'}
    // $endpoint;

my $handle = {
    'type'     => 'direct-tcp',
    'socket'   => $sock,
    'endpoint' => $endpoint,
    'quality'  => <external.transports>->{'quality'}{'direct-tcp'}{$dest}
        // {},
};

## update stats ##
<external.transports>->{'stats'}{'connections_ok'}++;
<external.transports>->{'active'}{$dest} = {
    'type'    => 'direct-tcp',
    'started' => <[base.time]>->(4),
};

return $handle;

