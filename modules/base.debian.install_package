# name = base.debian.install_package

my @deb_list = @_;
my $errors   = 0;
my $max_fail = 5;

return FALSE if !@deb_list;

local $ENV{'APT_LISTCHANGES_FRONTEND'} = qw| none |;
local $ENV{'UCF_FORCE_CONFFOLD'}       = qw| true |;
local $ENV{'UCF_FORCE_CONFMISS'}       = qw| true |;
local $ENV{'DEBCONF_PRIORITY'}         = qw| critical |;
local $ENV{'PAGER'}                    = qw| /bin/true |;
local $ENV{'LANG'}                     = qw| en_US.UTF-8 |;

my $ok = 0;
my $wait;
my $warned;
while ( !$ok and $max_fail-- ) {
    $warned = 0;
    $wait   = 2 + int( rand(5) );
    while ( length(qx(lslocks|grep ^dpkg)) and $wait = 11 or $wait-- ) {
        if ( $wait > 10 and !$warned++ ) {
            <[base.logs]>->( 1, "auto_install: waiting for dpkg lock ..." );
        }
        <[base.sleep]>->(0.33);
    }

    my $s = @deb_list > 1 ? 's' : '';
    <[base.logs]>->(
        1, "auto_install: debian package%s: %s",
        $s, join( ', ', @deb_list )
    );

    open( my $apt_out, '-|', 'apt-get', '-fy', 'install', @deb_list ) or do {
        <[base.logs]>->( 0, "  ✗ apt-get failed to execute : %s", $! );
        $errors++;
        next;
    };

    my $output = join( '', <$apt_out> );
    close($apt_out);
    my $result = $?;

    if ( $result == 0 ) {
        <[base.logs]>->( 1, ":. successfully installed." );
        $ok = 1;
    } elsif ( $output =~ m|Unable to locate package| ) {
        ## package doesn't exist — don't retry ##
        <[base.logs]>->( 0, "  ✗ package not found — cannot continue" );
        $errors++;
        last;
    } elsif ( $output =~ m|Permission denied|
        or $output =~ m|EACCES|
        or $output =~ m|could not open lock file|i ) {
        ## permission denied — no retries, not running as root ##
        <[base.logs]>->( 0, "  ✗ permission denied — not running as root" );
        $errors++;
        last;
    } else {
        $errors++;
        <[base.logs]>->( 1, ": retrying automatic installation ..," );
    }

}
return $errors;

