## [:< ##

# name  = auth.callback.cap-neg.declare-strm-support
# descr = capability negotiation: client supports strm protocol
# param = session_id, [true|false]
# return = TRUE | FALSE | error_code

my $id    = shift;
my $value = shift // 'true';

return FALSE unless defined $id and exists $data{'session'}{$id};

my $session = $data{'session'}{$id};

## parse value ##
$value = lc($value);
if ( $value =~ m{^(true|1|yes|on)$} ) {
    $session->{'strm_support'} = TRUE;
} elsif ( $value =~ m{^(false|0|no|off)$} ) {
    delete $session->{'strm_support'};
} else {
    <[base.logs]>->( 0, '[%d] invalid strm-support value: %s', $id, $value );
    return 3;    ## validation error ##
}

<[base.logs]>->(
    2,   '[%d] STRM support: %s',
    $id, $session->{'strm_support'} ? 'enabled' : 'disabled'
);

return TRUE;

