## [:< ##

# name    = base.load_modules
# descr   = load a given set of modules

## prepare known exclusion patterns ##
my $exclude_regex = <regex.base.backup_files>
    // qr{(?<![^\w/])(DEADJOE|.+~)$};    ## editor backup files ##

my @modules_to_load                      ## filter is for excluded files ##
    = grep { $ARG !~ $exclude_regex } split( m| +|, join( ' ', @ARG ) );

my %seen;                                ## uniq implementation ##
my $num_elements   = scalar @modules_to_load;
my @unique_modules = grep { !$seen{$ARG}++ } @modules_to_load;

my $delta_mod = $num_elements - scalar @unique_modules;
if ( $delta_mod > 0 ) {
    <[base.s_warn]>->(
        "%d redundant module name%s submitted\n",
        $delta_mod, ( $delta_mod == 1 ? '' : 's' )
    );
    ## filtered against redundancy ###
    @modules_to_load = @unique_modules;

} elsif ( @modules_to_load == 0 ) {
    warn 'expected module name[s] <{C1}>';
    return ( 0, 0 ) if wantarray;
    return FALSE;
}

<[base.register_src_deps]>->(@modules_to_load);
<[base.register_p7_mod_load]>->(@modules_to_load);

my ( $subs_ok, $subs_failed ) = <[base.load_code]>->(@modules_to_load);

if ( not defined $subs_ok or $subs_ok == 0 ) {
    <[base.log]>->( 0, '[base.load_modules] no routines were loaded ..,' );
}

return ( $subs_ok, $subs_failed ) if wantarray;

return TRUE if not $subs_failed and $subs_ok;

return FALSE;

