## [:< ##

# name  = base.cmd.when-present
# descr = forward a command when zenka is present
# param = <command> [args]

( my $user, my $cmnd, my $params ) = split( m|\s+|, $call->{'args'}, 3 );

$user =~ s|^.+\.||;    ## removing host portion ###

return { 'mode' => qw| false |, 'data' => 'no access permissions' }
    if not <[base.has_access]>->( $user, $cmnd );

return { 'mode' => qw| false |, 'data' => 'no command specified' }
    if not defined $cmnd or not length $cmnd;

my $push_args = {
    qw| command | => $cmnd,
    qw| queue_max | => 1,
};

$push_args->{'args'} = { qw| args | => $params }
    if defined $params and length $params;

<[zenka.push]>->($push_args);

return { 'mode' => qw| true |, 'data' => 'queued' }

