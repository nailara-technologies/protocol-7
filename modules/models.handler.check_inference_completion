# name = models.handler.check_inference_completion
# descr = fallback handler - check if inference is complete and process response

my $event         = shift->w;
my $inference_id  = $event->data;

my $job           = <models.pending_inferences>->{$inference_id};

unless ( defined $job ) {
    $event->cancel if $event->is_active;
    return;
}

## Skip if already completed
if ( $job->{'completed'} ) {
    <[base.logs]>->( 2, "[check_inference] already completed, cancelling: id=%s", $inference_id );
    $event->cancel if $event->is_active;
    # Also cancel the read handler to prevent warnings
    if ( defined $job->{'io_handler_stdout'} ) {
        $job->{'io_handler_stdout'}->cancel if $job->{'io_handler_stdout'}->is_active;
    }
    return;
}

## Exception event on stderr indicates curl has finished
<[base.logs]>->(
    1, "[check_inference] exception event (curl finished): id=%s",
    $inference_id
);

## Cancel both handlers
$event->cancel if $event->is_active;
if ( defined $job->{'io_handler_stdout'} ) {
    $job->{'io_handler_stdout'}->cancel if $job->{'io_handler_stdout'}->is_active;
}

## Process the response
<[models.handler.process_response]>->(
    { 'inference_id' => $inference_id, 'job' => $job }
);

