# name = models.handler.check_inference_completion
# descr = fallback handler - check if inference is complete and process response

my $event         = shift->w;
my $inference_id  = $event->data;

my $job           = <models.pending_inferences>->{$inference_id};

unless ( defined $job ) {
    $event->cancel if $event->is_active;
    return;
}

## Skip if already completed (read handler may have already processed)
if ( $job->{'completed'} ) {
    $event->cancel if $event->is_active;
    return;
}

## Fallback: if both streams closed but process_response not called yet, call it now
if ( $job->{'rdr_closed'} && $job->{'err_closed'} && !$job->{'completed'} ) {
    <[base.logs]>->(
        1, "[check_inference] fallback completion: id=%s",
        $inference_id
    );

    <[models.handler.process_response]>->(
        { 'inference_id' => $inference_id, 'job' => $job }
    );

    $event->cancel if $event->is_active;
}

