## [:< ##

# name  = letsencr.child.fetch_acme_directory
# descr = fetch ACME directory from Let's Encrypt server and get initial nonce

my $server_url = shift || <letsencr.acme.server>;

return undef unless $server_url;

<[base.log]>->( 2, "fetching ACME directory from $server_url" );

## Create HTTP client (use standard LWP::UserAgent  to allow localhost for
## testing)
my $ua = LWP::UserAgent->new( timeout => 10, );

## Disable SSL verification for localhost/test servers
if ( $server_url =~ m{^https?://localhost} ) {
    $ua->ssl_opts( verify_hostname => 0, SSL_verify_mode => 0 );
}

## Fetch directory
my $response = $ua->get($server_url);

unless ( $response->is_success ) {
    <[base.log]>->(
        1, "error fetching ACME directory: " . $response->status_line
    );
    return undef;
}

## Parse directory JSON
my $directory;
eval { $directory = JSON::XS::decode_json( $response->decoded_content() ); };
if ($EVAL_ERROR) {
    <[base.log]>->( 1, "error parsing ACME directory : $EVAL_ERROR" );
    return undef;
}

## Extract important URLs
unless ( exists $directory->{newAccount} && exists $directory->{newOrder} ) {
    <[base.log]>->( 1, "error : ACME directory missing required endpoints" );
    return undef;
}

## Get initial nonce from header (HTTP/2)  or newNonce endpoint (HTTP/1.1
## fallback)
my $initial_nonce = $response->header('Replay-Nonce');

<[base.logs]>->(
    3,
    'nonce from directory response: %s',
    $initial_nonce // 'UNDEFINED'
);

unless ($initial_nonce) {
    ## fallback: fetch from newNonce endpoint if not in directory response
    <[base.log]>->(
        2, "Replay-Nonce not in directory, using newNonce endpoint fallback"
    );

    unless ( exists $directory->{newNonce} ) {
        <[base.log]>->( 1, "error : no newNonce endpoint in directory" );
        return undef;
    }

    my $nonce_url = $directory->{newNonce};
    <[base.logs]>->( 3, 'fetching nonce from: %s', $nonce_url );

    my $nonce_response = $ua->head($nonce_url);
    unless ( $nonce_response->is_success ) {
        <[base.log]>->(
            1, "error fetching nonce: " . $nonce_response->status_line
        );
        return undef;
    }

    $initial_nonce = $nonce_response->header('Replay-Nonce');
    <[base.logs]>->(
        3,
        'nonce from newNonce endpoint: %s',
        $initial_nonce // 'UNDEFINED'
    );

    unless ($initial_nonce) {
        <[base.log]>->( 1, "error : no Replay-Nonce in newNonce response" );
        return undef;
    }
}

<[base.log]>->( 2, 'ACME directory fetched successfully' );

## Store in child state
<letsencr.child.acme_client>->{directory} = $directory;
<letsencr.child.acme_client>->{nonce}     = $initial_nonce;
<letsencr.child.acme_client>->{server}    = $server_url;

## Return directory info
return {
    directory => $directory,
    nonce     => $initial_nonce,
    endpoints => {
        newAccount => $directory->{newAccount},
        newOrder   => $directory->{newOrder},
        revokeCert => $directory->{revokeCert},
        keyChange  => $directory->{keyChange},
    },
};

