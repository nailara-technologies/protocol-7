## [:< ##

# name = data.mount.shm.feedback.read
# descr = Read and clamp the feedback region from the writer side

# thin zenka wrapper -> AMOS7::SHM::Feedback::read_feedback
# the writer is the sole reader of the feedback region; the core clamps
# last_page_read against the announced [ 0, total_pages ] range.

my $mount = shift;

return AMOS7::SHM::Feedback::read_feedback($mount);

