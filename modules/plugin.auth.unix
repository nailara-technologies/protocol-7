## [:< ##

# name    = plugin.auth.unix
# return  = user-name [ success ], undef on error

my $event = shift;
my $id    = $event->w->data;
my $re    = <regex.base>;

my $input  = \$data{'session'}{$id}{'buffer'}{'input'};
my $output = \$data{'session'}{$id}{'buffer'}{'output'};

if ( $input->$* =~ s|^auth ($re->{usr_str})\n|| ) {

    my $auth_user = $LAST_PAREN_MATCH;

    if ( $data{'handle'}{ $data{'session'}{$id}{'handle'} }{'link'} ne
        qw| unix | ) {
        <[base.logs]>->(
            0,   "[%d] [ auth unix ] access denied to user '%s' %s",
            $id, $auth_user, '[ not a unix link ]'
        );
        $output->$* .= ">:[\n";
        return 2;
    }

    my $authorize_unix_session = FALSE;

    my $client_uid
        = $data{'handle'}{ $data{'session'}{$id}{'handle'} }{'unix'}{'uid'};
    my $client_uname = getpwuid($client_uid);

    if ( not defined $client_uname ) {
        $output->$* .= ">:[\n";
        <[base.logs]>->(
            0, '[%s] peer UID is undefined, unix auth aborted..,', $id
        );
        return 2;
    }

    ## Expand template variables in auth username (e.g., <admin-user> -> admin-user)
    my $lookup_auth_user = $auth_user;
    if ( $auth_user =~ m|^<([^>]+)>$| ) {
        my $template = "<${^CAPTURE}[0]}>";
        my $expanded = <[base.access.special-user-map]>->( $template, 1 )
            ;    # silent mode
        $lookup_auth_user = $expanded
            if defined $expanded;    # Apply template expansion
    }

    my $mapped_user_string;
    if ( defined <auth.setup.usr>->{$lookup_auth_user}
        and <auth.setup.usr>->{$lookup_auth_user} =~ m|:unix:(\S+)| ) {
        my @allowed_users = split( m|\s*[, +]\s*|, ${^CAPTURE}[0] );

        if ( not $authorize_unix_session ) {

            ## 'unix-'-prefixed users are matched ##
            ##  #### against actual unix accounts ##
            foreach my $allowed_user (@allowed_users) {

                my $prefixed_user  ## acquire the special user variable map ##
                    = <[base.access.special-user-map]>->($allowed_user);

                next               ## no match for access ##
                    if not defined $prefixed_user
                    or $prefixed_user !~ s|^unix-||
                    and $prefixed_user ne $allowed_user;

                ## unix user match ##
                if ( $prefixed_user eq $allowed_user ) {
                    ###                                       ###
                    ## authorized using special user template ##
                    #                                         #
                    $mapped_user_string     = $allowed_user;
                    $authorize_unix_session = TRUE;
                    last;    ##  5 == true  ##
                }
            }
        }
    } else {
        <[base.log]>->(0, ": not present in auth.setup.\n" );
        <[base.log]>->(0, ": :. with ':unix:' prefix .:\n" );
    }

    if ($authorize_unix_session) {
        $output->$* .= "AUTH_TRUE =)\n";
        my $s_usr = $client_uname ne $auth_user ? " [$client_uname]" : '';

        <[base.logs]>->(    ## reports unix user seperated if different ##
            "[%d] session authorized%s as '%s'",
            $id, $s_usr, $auth_user
        );
        <[base.logs]>->(    ##  report matching template  ##
            "[%d] .: unix user '%s' match in %s",
            $id, $client_uname, $mapped_user_string
        ) if defined $mapped_user_string;

        return ( 0, $auth_user )
            ;               ## register as authorized (success code 0) ##
    } else {    ##  no match for unix-user \ auth-user pair  ##
        $output->$* .= "AUTH_ERROR `>:|\n";
        <[base.logs]>->(
            0,   "[%s] :auth.unix: no '%s' access",
            $id, $auth_user
        );
        <[base.logs]>->(
            0,             "          :UNIX.USER: :. %s != %s",
            $client_uname, $auth_user
        );
        return 2;
    }
} elsif ( $input->$* =~ m|\n| ) {
    $output->$* .= ">:[\n";
    <[base.logs]>->(
        0, "[%d] authentication protocol mismatch [ unix ] `:|", $id
    );
} else {
    return TRUE;
}

return 2;

