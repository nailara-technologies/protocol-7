# name = v7.handler.reset_restart_delay

my $instance_id = shift->w->data;
die "expected instance id" if not defined $instance_id;
my $instance  = <v7.zenka.instance>->{$instance_id};
my $log_level = 2;                                       ## start level 2 ##
$log_level-- if $instance->{'restart_delay'} >= 0.7;     ## default: 0.05 ##

<[base.logs]>->( $log_level, "[%s] resetting restart delay", $instance_id );
delete $instance->{'restart_delay'};    ## delete last value to re-init.., ##
delete $instance->{'timer'}->{'restart_delay'};    ## clean-up watcher ##
delete $instance->{'timer'} if not keys $instance->{'timer'}->%*;  ## and href

