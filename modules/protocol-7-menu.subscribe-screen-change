# name  = protocol-7-menu.subscribe-screen-change
# descr = initialized callback — subscribe protocol-7-menu to X-11 screen-change STRM events

<[base.log]>->(
    1, 'subscribing protocol-7-menu to X-11 screen-change events .,'
);

<[protocol-7.route-send]>->(
    {   'command' => qw| X-11.subscribe-screen-change |,
        'reply'   => {
            'handler' =>
                qw| protocol-7-menu.handler.screen-change_strm_open |,
        }
    }
);

return TRUE;

