## [:< ##

# name  = ncode.regex.load
# descr = parse regex pattern definitions from yaml file

my $params = shift // {};

my $file = $params->{'file'} // '';

return { 'mode' => qw| false |, 'data' => 'file path required' }
    unless length $file;

return { 'mode' => qw| false |, 'data' => "file not found: $file" }
    unless -f $file and -r $file;

## load yaml ##
my $yaml_fn = $code{'format.yaml.load_file'};

my $data;
if ( defined $yaml_fn ) {
    $data = $yaml_fn->($file);
} else {
    <[base.perlmod.load]>->('YAML::XS');
    $data = eval { YAML::XS::LoadFile($file) };
    if ($@) {
        <[base.logs]>->(
            0, ':. ncode.regex.load: yaml parse error [ %s ] :.', $@
        );
        return { 'mode' => qw| false |, 'data' => 'yaml parse error' };
    }
}

return { 'mode' => qw| false |, 'data' => 'no data in yaml' }
    unless ref $data eq qw| HASH |;

my $patterns  = $data->{'patterns'}  // [];
my $workflows = $data->{'workflows'} // [];

## load workflows if present ##
if ( ref $workflows eq qw| ARRAY | and @$workflows ) {
    <ncode.workflows> //= {};
    foreach my $wf (@$workflows) {
        next unless ref $wf eq qw| HASH |;
        my $wf_name = $wf->{'name'} // next;
        <ncode.workflows>->{$wf_name} = $wf;
    }
}

<ncode.patterns> //= {};

my $loaded  = 0;
my $skipped = 0;

foreach my $def (@$patterns) {
    my $name = $def->{'name'} // next;

    ## validate required fields ##
    my $pattern = $def->{'pattern'} // $def->{'detect'} // '';
    unless ( length $pattern ) {
        $skipped++;
        next;
    }

    ## compile regex for fast reuse ##
    my $compiled = eval {qr/$pattern/};
    if ($@) {
        <[base.logs]>->(
            0,     ':. ncode.regex.load: bad pattern %s [ %s ] :.',
            $name, $@
        );
        $skipped++;
        next;
    }

    ## store pattern with metadata ##
    <ncode.patterns>->{$name} = {
        'name'     => $name,
        'descr'    => $def->{'descr'} // $def->{'description'} // '',
        'pattern'  => $pattern,
        'detect'   => $def->{'detect'} // '',
        'compiled' => $compiled,
        'replace'  => $def->{'replace'},
        'steps'    => do {
            my $yaml_steps = $def->{'steps'} // [];
            if (@$yaml_steps) {
                $yaml_steps;    ## explicit steps — use as-is
            } elsif ( length $pattern and defined $def->{'replace'} ) {
                ## synthesize single-step from pattern/replace [ form 1 patterns ] ##
                [
                    {   'tool'    => 'ncode',
                        'search'  => $pattern,
                        'replace' => $def->{'replace'}
                    }
                ];
            } else {
                [];    ## detect-only [ replace: null ] — no apply steps
            }
        },
        'verify'        => $def->{'verify'}        // [],
        'applicability' => $def->{'applicability'} // {},
        'origin'        => $def->{'origin'}        // qw| loaded |,
        'source_task'   => $def->{'source_task'}   // '',
        'note'          => $def->{'note'}          // '',
        'stats'         => {
            'applied'        => $def->{'stats'}->{'applied'}        // 0,
            'false_positive' => $def->{'stats'}->{'false_positive'} // 0,
            'skipped'        => 0
        }
    };

    $loaded++;
}

return {
    'mode' => qw| true |,
    'data' => {
        'file'    => $file,
        'loaded'  => $loaded,
        'skipped' => $skipped
    }
};

