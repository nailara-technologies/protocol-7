## [:< ##

# name = nshell.write_to_buffer
# descr = Write command output to STDOUT

my ($output) = @ARG;

return FALSE unless defined $output and length $output;

## Write directly to STDOUT
print $output;
STDOUT->flush();

return TRUE;

