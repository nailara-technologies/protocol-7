## [:< ##

# name = image-quality.vision.select_model
# descr = Select appropriate vision model from registry

<[base.perlmod.load]>->( 'YAML::XS', qw| LoadFile | );

my $registry_path
    = '/data/projects/protocol-7/data/yaml/vision-models-registry.yaml';

# Load registry
my $registry;
eval { $registry = LoadFile($registry_path); };
return { success => FALSE, error => "Cannot load registry: $@" } if $@;

return { success => FALSE, error => 'Invalid registry format' }
    unless ref $registry eq 'HASH';
return { success => FALSE, error => 'No categories in registry' }
    unless $registry->{categories};

# Get stable_production models (highest priority)
my $stable_models = $registry->{categories}{stable_production}{models};
return { success => FALSE, error => 'No stable production models available' }
    unless $stable_models && ref $stable_models eq 'ARRAY';

# Try each stable model in preferred_order
my $preferred_order = $registry->{preferred_order} || [];
foreach my $model_path (@$preferred_order) {

    # Find this model in the registry
    foreach my $model (@$stable_models) {
        if ( $model->{model_path} eq $model_path ) {
            return {
                success        => TRUE,
                model_path     => $model_path,
                model_name     => $model->{name},
                params         => $model->{params},
                capabilities   => $model->{capabilities},
                max_resolution => $model->{max_resolution} || 4096,
                category       => 'stable_production'
            };
        }
    }
}

# Fallback: return first stable model
if (@$stable_models) {
    my $first = $stable_models->[0];
    return {
        success        => TRUE,
        model_path     => $first->{model_path},
        model_name     => $first->{name},
        params         => $first->{params},
        capabilities   => $first->{capabilities},
        max_resolution => $first->{max_resolution} || 4096,
        category       => 'stable_production'
    };
}

return {
    success => FALSE,
    error   => 'No suitable vision models available in registry'
};

