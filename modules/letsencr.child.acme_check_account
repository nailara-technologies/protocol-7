# name  = letsencr.child.acme_check_account
# descr = child process verifies ACME account status and nonce with Let's Encrypt server

my $msg = shift;

<[base.log]>->( 2, "child: checking ACME account status" );

## This is where blocking ACME operations occur:
## 1. Connect to ACME directory
## 2. Get fresh nonce
## 3. Load account key
## 4. Request account information
## 5. Check Terms of Service acceptance

my $result = {
    status       => 'success',
    account_id   => <letsencr.child.acme_client> {account_id},
    nonce        => 'new-nonce-from-server',
    tos_accepted => 1,
    email        => <letsencr.admin.email>,
};

if ( !<letsencr.child.acme_client> {account_key} ) {
    <[base.log]>->(
        2, "child: account key not initialized - creating new account"
    );

    # <[letsencr.child.generate_account_key]>;
    # <[letsencr.child.acme_register_account]>;
    $result->{account_created} = 1;
}

<[letsencr.child.send_to_parent]>->(
    {   command         => 'acme_status',
        account_id      => $result->{account_id},
        nonce           => $result->{nonce},
        tos_accepted    => $result->{tos_accepted},
        account_created => $result->{account_created} // 0,
    }
);

