## [:< ##

# name = crypt.C25519.init_code

<crypt.C25519.initialized> //= FALSE;

<[base.perlmod.load]>->( 'File::Path', qw| make_path | );

##  C25519 and BASE-32 modules loaded in 'pre_init'  ##

<crypt.C25519.autocreate-user-key> //= FALSE;

## Determine key owner user: use smart logic for privilege dropping contexts
## Security: each process keeps its own keys in its own home directory
## Note: Invalidate key_vars cache at start of init to ensure fresh computation
##       for this process, since each zenka process has different user context
delete <crypt.C25519.key_vars>;

my $current_user = $ENV{'USER'} // getpwuid($EUID);

## If a drop_privs target user is configured and differs from current user,
## use target user for keys — handles v7-started zenka and other contexts.
## In other contexts (console, no privilege drop), use current user.
## note: some zenka may set this in pre_init before init_code runs
if ( not defined <crypt.C25519.usr_name> ) {
    my $drop_target_user = <system.amos-zenka-user> // '';

    if ( length($drop_target_user) and $drop_target_user ne $current_user ) {
        ## Will drop privileges to different user: store keys for target user
        <crypt.C25519.usr_name> = $drop_target_user;
    } else {
        ## No privilege drop configured: use current user
        <crypt.C25519.usr_name> = $current_user;
    }
}

my $key_dir = <[crypt.C25519.chk_key_dir]>;

if ( not defined $key_dir ) {
    my $key_usr = <crypt.C25519.usr_name> // <system.amos-zenka-user>
        // $ENV{'USER'} // getpwuid($EUID);
    <[base.s_warn]>->(
        "user '%s' key dir not accessible, aborting init.., <{NC}>", $key_usr
    );
    return -2;
}

<crypt.C25519.path.key_chksums_cache_file>
    //= catfile( $key_dir, qw| .key-chksums.cache | );

## regex ##
##
my @key_ext   = qw|  \.secret  \.private  \.public  :seed-phrase  |;
my @key_types = qw| private public secret |;    # virtual #

my $re_keyfiles = sprintf qw| (%s) |, join( '|', @key_ext );

## lowercase names + underscore support [ TOFU hostkeys: remote.host_port ] ##
my $name_regex = qr|[0-9a-z\.\-_]+|;

## uppercase names ##
my $uc_name_regex = qr|[0-9A-Z_\-]+|;

delete <crypt.C25519.regex>    ##  allow updates during reload  ##
    if <[base.is_defined_recursive]>->(qw| crypt.C25519.regex |);

const <crypt.C25519.regex> => {    ## requires Const::Fast to be loaded ##
    qw| key_name |           => qr|^$name_regex$|,
    qw| signature_key_name | => qr|^$uc_name_regex|,
    qw| key_sig |            => {
        qw| pub-key |   => qr|^($name_regex)\.sk\.(.+)$|, ## pub 'root' key ##
        qw| sign-req |  => qr|^($name_regex)\.rq\.(.+)$|, ## sign. req. ##
        qw| signature | => qr|^($name_regex)\.ks\.(.+)$|, ## key signature ##
        qw| virtualpk | => qr|^($name_regex)\.vp$|        ## virtual p.key ##
    },
    qw| key_file | => {
        qw| virtual |      => qr|^($name_regex):\Qseed-phrase\E$|,
        qw| tofu_hostkey | => qr|^(remote-host\.[0-9a-z\.\-_]+)\.public$|
        ,    ## TOFU pinned remote server hostkey ##
        map { $ARG => qr|^($name_regex)\.$ARG$| } @key_types
    },
    qw| key_files | => qr|$re_keyfiles|
};

delete <crypt.C25519.keys.sizetype>    ##  allow updates during reload  ##
    if <[base.is_defined_recursive]>->(qw| crypt.C25519.keys.sizetype |);

const <crypt.C25519.keys.sizetype> => {    ## <- will be read-only [again]. ##

    ##  binary [ unencoded ] public or secret keys  ##
    ##
    32 => {
        qw| type |        => UNKNOWN,
        qw| encoding |    => qw| bin |,
        qw| prefixed |    => FALSE,
        qw| linefeed |    => FALSE,
        qw| old-form |    => FALSE,
        qw| encrypted |   => FALSE,
        qw| virtual-key | => FALSE,
        qw| seed-phrase | => FALSE
    },

    ##  binary secret keys  ##
    ##
    34 => {
        qw| type |      => qw| secret |,
        qw| encoding |  => qw| bin |,
        qw| prefixed |  => TRUE,        ##  <-- remove prefix before using  ##
        qw| linefeed |  => FALSE,
        qw| old-form |  => FALSE,
        qw| encrypted | => UNKNOWN,     ##  requires prefix match  ##
        qw| virtual-key | => FALSE,
        qw| seed-phrase | => FALSE
    },

    ##  binary private keys  ##
    ##
    64 => {
        qw| type |        => qw| private |,
        qw| encoding |    => qw| bin |,
        qw| prefixed |    => FALSE,
        qw| linefeed |    => FALSE,
        qw| old-form |    => FALSE,
        qw| encrypted |   => UNKNOWN, ##  requires public key test signing  ##
        qw| virtual-key | => FALSE,
        qw| seed-phrase | => FALSE
    },
    66 => {
        qw| type |     => qw| private |,
        qw| encoding | => qw| bin |,
        qw| prefixed | => TRUE,         ##  <-- remove prefix before using  ##
        qw| linefeed | => FALSE,
        qw| old-form | => FALSE,
        qw| encrypted |   => UNKNOWN,    ##  requires prefix match  ##
        qw| virtual-key | => FALSE,
        qw| seed-phrase | => FALSE
    },

    ##  encoded [prefixed] secret keys  ##
    ##
    55 => {
        qw| type |        => qw| secret |,
        qw| encoding |    => qw| b32 |,
        qw| prefixed |    => TRUE,
        qw| old-form |    => FALSE,
        qw| linefeed |    => FALSE,
        qw| encrypted |   => UNKNOWN,        ##  requires prefix match  ##
        qw| virtual-key | => FALSE,
        qw| seed-phrase | => FALSE
    },
    56 => {
        qw| type |        => qw| secret |,
        qw| encoding |    => qw| b32 |,
        qw| prefixed |    => TRUE,
        qw| old-form |    => FALSE,
        qw| linefeed |    => TRUE,
        qw| encrypted |   => UNKNOWN,        ##  requires prefix match  ##
        qw| virtual-key | => FALSE,
        qw| seed-phrase | => FALSE
    },

    ##  encoded private keys  ##
    ##
    103 => {
        qw| type |        => qw| private |,
        qw| encoding |    => qw| b32 |,
        qw| prefixed |    => FALSE,
        qw| linefeed |    => FALSE,
        qw| old-form |    => TRUE,
        qw| encrypted |   => UNKNOWN,       ##  : probably : test required  ##
        qw| virtual-key | => FALSE,
        qw| seed-phrase | => FALSE
    },
    104 => {
        qw| type |        => qw| private |,
        qw| encoding |    => qw| b32 |,
        qw| prefixed |    => FALSE,
        qw| linefeed |    => FALSE,
        qw| old-form |    => TRUE,
        qw| encrypted |   => FALSE,
        qw| virtual-key | => FALSE,
        qw| seed-phrase | => FALSE
    },
    106 => {
        qw| type |        => qw| private |,
        qw| encoding |    => qw| b32 |,
        qw| prefixed |    => TRUE,
        qw| old-form |    => TRUE,
        qw| linefeed |    => FALSE,
        qw| encrypted |   => UNKNOWN,         ##  requires prefix match  ##
        qw| virtual-key | => FALSE,
        qw| seed-phrase | => FALSE
    },
    107 => {
        qw| type |        => qw| private |,
        qw| encoding |    => qw| b32 |,
        qw| prefixed |    => TRUE,
        qw| linefeed |    => TRUE,
        qw| old-form |    => FALSE,
        qw| encrypted |   => UNKNOWN,         ##  requires prefix match  ##
        qw| virtual-key | => FALSE,
        qw| seed-phrase | => FALSE
    },

    ##  encoded public keys  ##
    ##
    52 => {
        qw| type |        => qw| public |,
        qw| encoding |    => qw| b32 |,
        qw| prefixed |    => FALSE,
        qw| linefeed |    => FALSE,
        qw| old-form |    => TRUE,
        qw| encrypted |   => FALSE,
        qw| virtual-key | => FALSE,
        qw| seed-phrase | => FALSE
    },
    53 => {
        qw| type |        => qw| public |,
        qw| encoding |    => qw| b32 |,
        qw| prefixed |    => FALSE,
        qw| linefeed |    => TRUE,
        qw| old-form |    => FALSE,
        qw| encrypted |   => FALSE,
        qw| virtual-key | => FALSE,
        qw| seed-phrase | => FALSE
    },

    ##  virtual private keys [ stub-key file ]  ##
    ##
    97 => {
        qw| type |        => qw| virtual |,
        qw| encoding |    => qw| plain |,
        qw| prefixed |    => FALSE,
        qw| linefeed |    => FALSE,
        qw| old-form |    => FALSE,
        qw| encrypted |   => FALSE,
        qw| virtual-key | => TRUE,
        qw| seed-phrase | => TRUE
    },

    ##  TOFU pinned server hostkeys [ NTIME:PUBKEY format ]  ##
    ##
    60 => {
        qw| type |        => qw| tofu_hostkey |,
        qw| encoding |    => qw| b32 |,
        qw| prefixed |    => FALSE,
        qw| linefeed |    => FALSE,
        qw| old-form |    => FALSE,
        qw| encrypted |   => FALSE,
        qw| virtual-key | => FALSE,
        qw| seed-phrase | => FALSE
    }
};

0;

