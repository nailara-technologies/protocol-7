# name  = plan-9.server.buffer-read-layer
# descr = Read layer content

my ( $amos_id, $z, $offset, $count ) = @ARG;

my $buf = $data{'plan-9'}{'server'}{'buffers'}{$amos_id};
return '' unless $buf;

my $window     = $buf->{window};
my $layer_data = $window->{buffer}{layers}[$z] // '';

return substr( $layer_data, $offset, $count );

