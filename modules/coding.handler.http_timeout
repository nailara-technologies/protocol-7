## [:< ##

# name  = coding.handler.http_timeout
# descr = Handle HTTP request timeout
# purpose = Clean up and report timeout error

my $event     = shift->w;
my $data      = $event->data;
my $state     = $data->{'state'};
my $callbacks = $state->{'callbacks'};

<[base.logs]>->(
    0,
    "async.http_timeout: request timed out after %d seconds",
    <[base.time]>->(3) - $state->{'last_activity'}
);

my $error = "Request timeout";
$callbacks->{'on_error'}->($error) if exists $callbacks->{'on_error'};

<[coding.async.http_cleanup]>->($state);

