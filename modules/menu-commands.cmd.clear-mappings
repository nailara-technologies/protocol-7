# name = menu-commands.cmd.clear-mappings
# descr = Clear all menu command mappings and categories

my $confirm = $call->{'args'} // '';

if ( $confirm ne 'confirm' ) {
    return {
        'mode' => qw| true |,
        'data' => 'This will delete all menu mappings and categories. '
            . 'Use: menu-commands.clear-mappings confirm'
    };
}

# Clear both structures
<menu-commands.mappings>   = {};
<menu-commands.categories> = {};

# Save to persistent storage
unless ( <[menu-commands.save-state]> ) {
    return {
        'mode' => qw| true |,
        'data' => 'Error saving cleared state to disk'
    };
}

# Trigger update to protocol-7-menu
<[menu-commands.update-menu]>;

return {
    'mode' => qw| true |,
    'data' => 'All mappings and categories cleared'
};

