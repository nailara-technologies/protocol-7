# name = models.gguf.file.is_garbage_name
# descr = Check if a GGUF model name is garbage/invalid
# param = $name (string from general.name metadata)
# return = 1 if garbage, 0 if valid

my $name = shift;

return 1 unless defined $name;
return 1 if length($name) == 0;
return 1 if $name =~ /^[.\s]+$/;      # Just dots/spaces
return 1 if $name =~ /\\/;            # Windows backslash
return 1 if $name =~ /^[A-Za-z]:/;    # Drive letter
return 1 if $name =~ /:\\\\[^\\]/;    # Windows path pattern

return 0;

