# name = models.gguf.file.is_garbage_name
# descr = Check if a GGUF model name is garbage/invalid
# param = $name (string from general.name metadata)
# return = 1 if garbage, 0 if valid

my $name = shift;

return 1 unless defined $name;
return 1 if length($name) == 0;
return 1 if length($name) < 3;         # Too short to be meaningful
return 1 if length($name) > 100;       # Too long, likely garbage
return 1 if $name =~ m|^[.\s]+$|;      # Just dots/spaces
return 1 if $name =~ m|\\|;            # Windows backslash
return 1 if $name =~ m|^[A-Za-z]:|;    # Drive letter
return 1 if $name =~ m|:\\\\[^\\]|;    # Windows path pattern

## Detect random alphanumeric strings (like "909Acke7", "AbCdEf12")
## Pattern: contains mixed case letters + numbers without spaces/words
return 1 if $name =~ m|^[a-z]*\d+[a-z]*\d+[a-z]*$|i && length($name) < 15;

## Detect generic tool signatures without model identifiers
## e.g., "Unsloth Gguf", "LlamaCpp Model", "Converted Gguf"
return 1 if $name =~ m|^\s*unsloth\s*\w*\s*$|i;
return 1 if $name =~ m|^\s*llamacpp\s*\w*\s*$|i;
return 1 if $name =~ m|^\s*convert\s*\w*\s*$|i;
return 1 if $name =~ m|^\s*export\s*\w*\s*$|i;
return 1 if $name =~ m|^\s*merge\w*\s*$|i;
return 1 if $name =~ m|^\s*quant\s*\w*\s*$|i;
return 1 if $name =~ m|^\s*unsloth\s+gguf|i;
return 1 if $name =~ m|^\s*unsloth\s+model|i;
return 1 if $name =~ m|^\s*unsloth\s+export|i;
return 1 if $name =~ m|^\s*llamacpp\s+gguf|i;
return 1 if $name =~ m|^\s*llamacpp\s+model|i;

## Contains random-looking hash-like patterns (mixed alphanum without meaning)
return 1 if $name =~ m|\b[a-f0-9]{8,}\b|i;    # hex-like sequences

return 0;

