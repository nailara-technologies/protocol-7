## [:< ##

# name  = lm-vision.handler.http_analyze
# descr = HTTP backend for vision analysis via llama-server with LOVES_IT allocation
# param = image_path, prompt, reply_id, requester, amos_tokens

my $params     = shift                   // {};
my $image_path = $params->{'image_path'} // '';
my $prompt     = $params->{'prompt'}     // 'describe this image';
my $reply_id   = $params->{'reply_id'}   // '';
my $requester  = $params->{'requester'}  // 'anonymous';
my $amos_tokens = $params->{'amos_tokens'} // 0;

return { 'mode' => qw| false |, 'data' => 'image_path required' }
    unless length($image_path);
return { 'mode' => qw| false |, 'data' => 'image not found' }
    unless -f $image_path;

##[ LOVES_IT RESOURCE ALLOCATION ]############################################

## Calculate workload hash for loves_it scoring
my $workload_hash = <[chk-sum.bmw.filesum]>->( 256, $image_path );

## Use AMOS7 checksum with elf modes 4 and 7 (default truth modes)
my $amos_result = eval {
    <[chk-sum.amos]>->( { 'str' => $workload_hash, 'elf_modes' => [ 4, 7 ] } );
};

## For mode 13 (cosmic assertion), use division by 13 validation
my $div13_valid = 0;
if ( defined $amos_result && length($amos_result) >= 13 ) {
    my $first_13 = substr( $amos_result, 0, 13 );
    ## Check if it contains harmonic patterns (simplified check)
    $div13_valid = 1 if $first_13 =~ m{[27][59]};  ## Harmonic signature
}

## Check modes (simplified - use checksum properties)
my $mode4  = defined $amos_result ? 1 : 0;  ## Data exists (mode 4: data truth)
my $mode7  = ( defined $amos_result && length($amos_result) >= 7 ) ? 1 : 0;  ## Mode 7: love-truth
my $mode13 = $div13_valid;

## Calculate loves_it score (max 13)
my $loves_score = ( $mode4 ? 4 : 0 ) + ( $mode7 ? 7 : 0 ) + ( $mode13 ? 2 : 0 );
my $loves_it    = $loves_score == 13;

## Calculate priority weight (0.25 to 1.13)
my $priority_weight = $loves_score / 13;
$priority_weight = 0.25 if $priority_weight < 0.25;
$priority_weight *= 1.13 if $loves_it;  ## 13% bonus for loves_it!

<[base.log]>->(
    1,
    "[http_analyze] loves_it score: %d (modes 4:%d 7:%d 13:%d) weight: %.2f",
    $loves_score, $mode4, $mode7, $mode13, $priority_weight
);

## Get server endpoint from coding zenka ##
my $server_info = <coding.inference_servers>->{'gpu'} // {};
my $server_url  = $server_info->{'url'}   // 'http://localhost:8000';
my $model_name  = $server_info->{'model'} // 'vision-model';

<[base.log]>->(
    1, "[http_analyze] analyzing %s via %s (priority: %.2f)",
    $image_path, $server_url, $priority_weight
);

## Load and base64-encode image ##
open my $img_fh, '<:raw', $image_path
    or return {
    'mode' => qw| false |,
    'data' => "failed to open image: $!"
    };
local $/;
my $img_data = <$img_fh>;
close $img_fh;

my $b64_image = encode_base64( $img_data, '' );

## Determine MIME type from extension ##
my $mime_type = 'image/jpeg';
if ( $image_path =~ m{\.(png|gif|webp)$}i ) {
    $mime_type
        = lc($1) eq 'png'  ? 'image/png'
        : lc($1) eq 'gif'  ? 'image/gif'
        : lc($1) eq 'webp' ? 'image/webp'
        :                    'image/jpeg';
}

## Build OpenAI-compatible request with LOVES_IT headers ##
my $request = {
    'model'    => $model_name,
    'messages' => [
        {   'role'    => 'user',
            'content' => [
                { 'type' => 'text', 'text' => $prompt },
                {   'type'      => 'image_url',
                    'image_url' =>
                        { 'url' => "data:$mime_type;base64,$b64_image" }
                }
            ]
        }
    ],
    'max_tokens' => 4096,
};

## Send HTTP request with LOVES_IT priority headers ##
my $http_request = HTTP::Request->new(
    'POST',
    "$server_url/v1/chat/completions",
    [   'Content-Type'         => 'application/json',
        'X-Loves-It-Score'     => $loves_score,
        'X-Priority-Weight'    => sprintf( "%.2f", $priority_weight ),
        'X-Requester'          => $requester,
        'X-AMOS-Tokens'        => $amos_tokens,
        $loves_it ? ( 'X-Loves-It' => 'true' ) : (),
    ],
    <[format.json.encode]>->($request)
);

my $ua       = LWP::UserAgent->new( timeout => 300 );
my $response = $ua->request($http_request);

if ( !$response->is_success ) {
    <[base.log]>->( 0, "[http_analyze] HTTP error: %s", $response->status_line );
    return {
        'mode' => qw| false |,
        'data' => "HTTP error: " . $response->status_line
    };
}

## Parse JSON response ##
my $result = <[format.json.decode]>->( $response->content );

if ( !$result || !exists $result->{'choices'} ) {
    <[base.log]>->( 0, "[http_analyze] JSON parse error or unexpected response" );
    return {
        'mode' => qw| false |,
        'data' => 'json parse error or unexpected response format'
    };
}

## Extract generated text ##
my $generated_text = $result->{'choices'}[0]{'message'}{'content'} // '';
my $finish_reason  = $result->{'choices'}[0]{'finish_reason'}      // 'stop';

<[base.log]>->(
    1, "[http_analyze] complete: %d chars, finish_reason=%s, loves_score=%d",
    length($generated_text), $finish_reason, $loves_score
);

## Store result with LOVES_IT metadata ##
my $job_id = <[base.gen_id]>->(<lm-vision.jobs>);
<lm-vision.jobs>->{$job_id} = {
    'job_id'         => $job_id,
    'reply_id'       => $reply_id,
    'image_path'     => $image_path,
    'prompt'         => $prompt,
    'status'         => 'complete',
    'output'         => $generated_text,
    'finish_reason'  => $finish_reason,
    'start_time'     => <[base.time]>->(3),
    'end_time'       => <[base.time]>->(3),
    'backend'        => 'http',
    'loves_score'    => $loves_score,
    'loves_it'       => $loves_it,
    'priority_weight' => $priority_weight,
    'modes'          => { '4' => $mode4, '7' => $mode7, '13' => $mode13 },
};

## Send reply if requested ##
if ( length($reply_id) ) {
    my $reply_data = sprintf(
        "[loves_it:%d/13 weight:%.2f]\n%s",
        $loves_score, $priority_weight, $generated_text
    );
    <[base.callback.cmd_reply]>->(
        $reply_id, { 'mode' => 'size', 'data' => $reply_data }
    );
}

return {
    'mode' => qw| true |,
    'data' => {
        'job_id'         => $job_id,
        'output'         => $generated_text,
        'finish_reason'  => $finish_reason,
        'loves_score'    => $loves_score,
        'loves_it'       => $loves_it,
        'priority_weight' => $priority_weight,
    }
};

