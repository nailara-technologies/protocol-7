## [:< ##

# name  = coding.tools.handler.note_update
# descr = update/replace content in an existing note section

my $args = shift // {};

my $section = $args->{'section'} // '';
my $content = $args->{'content'} // '';
my $task_id = $args->{'task_id'} // '';

return { 'content' => 'section and content required' }
    unless length $section && length $content;

## auto-initialize if needed ##
my $base_dir = <[file.zenka_dir.data_path]> . '/notes';
<[note.init]>->($task_id) unless -d "$base_dir/$task_id";

## call backend to update section ##
my $result = <[note.update]>->( $section, $content, $task_id );

return {
      'content' => $result->{'mode'} eq qw| true |
    ? "Updated section '$section' (" . $result->{'data'}{'bytes'} . " bytes)"
    : "Failed: " . ( $result->{'data'} // 'unknown' ),
};

