## [:< ##

# name  = letsencrypt.init_code
# descr = Initialize Let's Encrypt certificate manager zenka with ACME support and renewal pipeline
# todo  = ACME client implementation, challenge handlers, renewal scheduler

<[base.perlmod.autoload]>->('JSON::PP');
<[base.perlmod.autoload]>->('LWP::UserAgent');
<[base.perlmod.autoload]>->('Crypt::OpenSSL::RSA')
    ;    ## CSR certificate key generation (RSA-2048)

<[base.log]>
    ->( 2, "initializing Let's Encrypt certificate manager zenka..," );

# Initialize Let's Encrypt configuration
<letsencrypt.cfg.enabled>     = <letsencrypt.cfg.enabled>     || 1;
<letsencrypt.cfg.environment> = <letsencrypt.cfg.environment> || 'production';
<letsencrypt.cfg.email>   = <letsencrypt.cfg.email>   || 'admin@localhost';
<letsencrypt.cfg.domains> = <letsencrypt.cfg.domains> || '';
<letsencrypt.cfg.renewal_check_interval>
    = <letsencrypt.cfg.renewal_check_interval> || 86400;

# ACME server configuration
my $acme_base
    = <letsencrypt.cfg.environment> eq 'staging'
    ? 'https://acme-staging-v02.api.letsencrypt.org/directory'
    : 'https://acme-v02.api.letsencrypt.org/directory';

<letsencrypt.cfg.acme_server> = <letsencrypt.cfg.acme_server> || $acme_base;
<letsencrypt.cfg.challenge_type>
    = <letsencrypt.cfg.challenge_type> || 'http-01';
<letsencrypt.cfg.challenge_port> = <letsencrypt.cfg.challenge_port> || 80;

# Paths
<letsencrypt.cfg.cert_dir>
    = <letsencrypt.cfg.cert_dir> || '/etc/protocol-7/certs';
<letsencrypt.cfg.key_dir>
    = <letsencrypt.cfg.key_dir> || '/etc/protocol-7/keys';
<letsencrypt.cfg.account_key_path> = <letsencrypt.cfg.account_key_path>
    || '/etc/protocol-7/letsencrypt/account.key';

# Renewal settings
<letsencrypt.cfg.auto_renewal_enabled>
    = <letsencrypt.cfg.auto_renewal_enabled> || 1;
<letsencrypt.cfg.renewal_threshold>
    = <letsencrypt.cfg.renewal_threshold> || 2592000;
<letsencrypt.cfg.notify_renewal_start>
    = <letsencrypt.cfg.notify_renewal_start> || 1;
<letsencrypt.cfg.notify_renewal_complete>
    = <letsencrypt.cfg.notify_renewal_complete> || 1;
<letsencrypt.cfg.notify_renewal_failure>
    = <letsencrypt.cfg.notify_renewal_failure> || 1;

# Certificate registry
<letsencrypt.certificates> = {};    # Domain => cert info mapping
<letsencrypt.renewals>     = {};    # Domain => renewal status

# Renewal scheduling
<letsencrypt.scheduled_renewals>   = [];
<letsencrypt.in_progress_renewals> = {};

# Performance metrics
<letsencrypt.metrics> = {
    renewal_attempts     => 0,
    renewal_successes    => 0,
    renewal_failures     => 0,
    certificates_issued  => 0,
    current_active_certs => 0,
    avg_renewal_time     => 0,
};

# Error handling
<letsencrypt.errors>     = [];
<letsencrypt.last_error> = undef;

# Create certificate directories
my $cert_dir = <letsencrypt.cfg.cert_dir>;
my $key_dir  = <letsencrypt.cfg.key_dir>;

foreach my $dir ( $cert_dir, $key_dir ) {
    if ( !-d $dir ) {
        <[base.logs]>->( 0, "creating certificate directory '%s'..,", $dir );
        system( 'mkdir', '-p', $dir ) == 0
            or <[base.logs]>->(
            1, "warning: could not create directory '%s'", $dir
            );
    }
}

<[base.log]>->( 2, "Let's Encrypt manager initialization complete" );
<[base.log]>->( 2, "  Environment: " . <letsencrypt.cfg.environment> );
<[base.log]>->( 2, "  ACME Server: " . <letsencrypt.cfg.acme_server> );
<[base.log]>->( 2, "  Challenge Type: " . <letsencrypt.cfg.challenge_type> );
<[base.log]>->(
    2,
    "  Auto-Renewal: "
        . ( <letsencrypt.cfg.auto_renewal_enabled> ? 'enabled' : 'disabled' )
);
<[base.log]>->( 2, "  Certificate Directory: " . $cert_dir );

0;

