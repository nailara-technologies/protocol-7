## [:< ##

# name  = site-yaml.cmd.list-stray-jobs
# descr = passive read-only listing of stranded record files
#
# notes = see site-yaml.job.scan_stray ; callers decide on their own
#         schedule whether and when to claim any of them ; 'size' mode
#         reply auto-fragments via STRM-SIZE if large, no manual chunking

<[base.perlmod.autoload]>->('JSON::XS');

my $stray = <[site-yaml.job.scan_stray]>;

return { 'mode' => 'size', 'data' => JSON::XS::encode_json($stray) };

