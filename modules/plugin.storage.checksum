## [:< ##
# name  = plugin.storage.checksum
# descr = Checksum-based storage mapping - main dispatch

use strict;
use warnings;

return sub {
    my ($args) = @ARG;
    $args //= {};

    my $operation = $args->{operation} // 'map';

    if ( $operation eq 'map' ) {
        return <[plugin.storage.checksum.map-file]>->($args);
    } elsif ( $operation eq 'lookup' ) {
        return <[plugin.storage.checksum.lookup]>->($args);
    } elsif ( $operation eq 'verify' ) {
        return <[plugin.storage.checksum.verify]>->($args);
    } elsif ( $operation eq 'cache-invalidate' ) {
        return <[plugin.storage.checksum.cache-invalidate]>->($args);
    } else {
        return {
            'mode' => 'false',
            'data' => "Unknown operation: $operation"
        };
    }
};

