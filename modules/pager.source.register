## [:< ##

# name  = pager.source.register
# descr = Register custom data sources for pager

my ($args) = @ARG;

my $type    = $args->{'type'};
my $handler = $args->{'handler'};

return undef unless $type && ref($handler) eq 'CODE';

$data{'pager'}{'sources'}{$type} = $handler;
return 1;

