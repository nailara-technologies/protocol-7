## [:< ##

# name  = base.strm.subscribe.reply-handler
# descr = subscribe command reply : success marks the subscription,
#         'client not present' falls back to the notify_online wait,
#         anything else is a definitive error [ no blind retry ]

my $reply = shift;

my $key = $reply->{'params'}->{'key'} // '';

my $state = <base.strm.subscribe.registry>->{$key} // return FALSE;

if ( $reply->{'cmd'} eq qw| TRUE | ) {
    $state->{'subscribed'} = TRUE;
    $state->{'error'}      = undef;
    $state->{'backoff_n'}  = 0;
    <[base.logs]>->( 2, 'strm.subscribe : subscribed [ %s ]', $key );

    ## arm the publisher-restart re-affirm hook [ idempotent : one     ##
    ## handler sub per publisher, on_restart dedups the registration ] ##
    <[strm.subscribe.on-restart]>->( $state->{'publisher'} );

    return TRUE;
}

my $reply_str = $reply->{'call_args'}->{'args'} // '';

if ( $reply_str =~ m|^client\b|i ) {
    ## publisher offline [ 'client not present' ] : wait for it ##
    $state->{'backoff_n'} = 0;
    return <[strm.subscribe.wait-online]>->($key);
}

## definitive error [ permission, unknown slot, .. ] : record + stop ##
$state->{'error'} = $reply_str;
<[base.logs]>->( 0, 'strm.subscribe : %s refused [ %s ]', $key, $reply_str );
return FALSE;

