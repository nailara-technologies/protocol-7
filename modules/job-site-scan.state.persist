## [:< ##

# name  = job-site-scan.state.persist
# descr = save scan state to disk

my $payload = {
    'cycle'     => <job-site-scan.cycle>     // 'idle',
    'last_scan' => <job-site-scan.last_scan> // 0,
    'tasks'     => <job-site-scan.tasks>     // {},
};

my $yaml;
eval { $yaml = YAML::XS::Dump($payload) };
if ($@) {
    <[base.logs]>->( 0, 'jss.persist: serialize error: %s', $@ );
    return FALSE;
}

my $written = <[file.zenka_dir.write]>->( 'scan-state.yaml', \$yaml );
if ( not defined $written ) {
    <[base.logs]>->( 0, 'jss.persist: write failed' );
    return FALSE;
}
return TRUE;

