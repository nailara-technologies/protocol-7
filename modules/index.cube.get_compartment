# name = index.cube.get_compartment
# descr = get compartment at (depth, rank) from cache or load from cube file

my ( $depth, $rank ) = @ARG;

return <index.cube.loaded>->{$depth}{$rank}
    if exists <index.cube.loaded>->{$depth}{$rank};

my $comp = <[index.cube.load_compartment]>->( $depth, $rank );
return undef if not defined $comp;

<index.cube.loaded>->{$depth}{$rank} = $comp;
return $comp;

