## [:< ##

# name  = ticker.cmd.swap_profile
# descr = toggle ticker between top and bottom edge

my $current = shift // <ticker.window.profile> // qw| bottom-strip |;
my $target;
if ( $current =~ m{^bottom-strip$} ) {
    $target = qw| top-strip |;
} elsif ( $current =~ m{^top-strip$} ) {
    $target = qw| bottom-strip |;
} else {
    return;
}

<[base.log]>->(
    2, sprintf( ': swap mode: moving ticker to %s edge', $target )
);

<ticker.swap.previous_profile> = $current;

## only disable swap for the session after several consecutive failures, ##
## so a single bad move doesn't kill swap mode for the rest of the run.  ##
if ( <[ticker.move_to_profile]>->( $target, $current ) ) {
    delete <ticker.swap.move_failed>;
    delete <ticker.swap.fail_count>;
    delete <ticker.swap.previous_profile>;
} else {
    <ticker.swap.fail_count> = ( <ticker.swap.fail_count> // 0 ) + 1;
    my $max_fails = 3;
    <[base.log]>->(
        1,
        sprintf(
            ': swap move failed, attempt %d/%d',
            <ticker.swap.fail_count>, $max_fails
        )
    );
    <ticker.swap.move_failed> = 1;
    <ticker.swap.disabled>    = 1
        if <ticker.swap.fail_count> >= $max_fails;
    delete <ticker.swap.previous_profile>;
}

