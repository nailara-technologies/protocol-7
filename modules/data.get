## [:< ##

# name  = data.get
# descr = universal data path resolution with security and transparency

my $path = shift;
return undef unless defined $path && length($path);

##[ SECURITY ]################################################################

my $security_check = <[data.get.validate_path_security]>->($path);
return {
    'error'     => 'access_denied',
    'path'      => $path,
    'required'  => $security_check->{'required'},
    'available' => $security_check->{'available'},
    }
    unless $security_check->{'allowed'};

##[ CLASSIFICATION ]##########################################################

my $classification = <[data.get.classify_path]>->($path);
my $source_type    = $classification->{'type'};

##[ RESOLUTION ]##############################################################

my $metadata = {
    'path'           => $path,
    'source_type'    => $source_type,
    'classification' => $classification,
    'resolved_time'  => <[base.ntime]>,
};

my $result;

if ( $source_type eq 'virtual' ) {
    $result = <[data.get.resolve_virtual]>->( $path, \@ARG, $classification );
} elsif ( $source_type eq 'plugin' ) {
    $result = <[data.get.resolve_plugin]>->( $path, \@ARG, $classification );
} elsif ( $source_type eq 'physical' ) {
    $result
        = <[data.get.resolve_physical]>->( $path, \@ARG, $classification );
} elsif ( $source_type eq 'interference' ) {
    $result = <[data.get.resolve_interference]>
        ->( $path, \@ARG, $classification );
} else {
    return {
        'error'   => 'unknown_path_type',
        'path'    => $path,
        'message' => "Cannot classify path: $path",
    };
}

##[ RETURN ]##################################################################

return {
    'value'        => $result->{'value'},
    'source'       => $source_type,
    'handler'      => $classification->{'handler'},
    'module_path'  => $result->{'module_path'},
    'permissions'  => $security_check->{'permissions'},
    'topology_pos' => $result->{'topology_pos'}
        // <[data.get.classify_topology_pos]>->($path),
    'cached'   => $result->{'cached'} // 0,
    'metadata' => { %$metadata, %{ $result->{'metadata'} // {} } },
};

