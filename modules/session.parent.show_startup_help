my @messages = (
        "",
        "=============================================================================",
        "  Protocol-7 Dependency Check",
        "=============================================================================",
        "",
        "  Some dependencies are missing. You have several options:",
        "",
        "  1. Install all dependencies for specific zenka:",
        "     \$ ./bin/Protocol-7 debian install-deps <zenka_name>",
        "",
        "  2. Check what's missing:",
        "     \$ ./bin/Protocol-7 debian check-deps",
        "",
        "  3. List all zenki with dependency status:",
        "     \$ ./bin/Protocol-7 debian list-zenki",
        "",
        "  4. Install minimal Protocol-7 dependencies:",
        "     \$ ./bin/Protocol-7 debian install-deps minimal",
