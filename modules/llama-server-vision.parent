## [:< ##

# name  = llama-server-vision.parent
# descr = parent process - monitors llama-server child and provides management API

<[base.log]>->( 1, 'llama-server parent process starting.,' );

# Store child PID for monitoring
my $child_pid = <llama-server-vision.child.pid>;
<[base.logs]>->( 1, "monitoring child process PID %d", $child_pid );

# Define parent-side commands
<llama-server-vision.cmd.status> = {
    'descr' => 'Get llama-server status',
    'scope' => 'main',
};

<llama-server-vision.cmd.info> = {
    'descr' => 'Get server info',
    'scope' => 'main',
};

# Status command handler
<llama-server-vision.handler.status> = sub {
    my $is_alive = <[llama-server-vision.is_alive]>();
    return {
        'status' => $is_alive ? 'online' : 'offline',
        'child_pid' => <llama-server-vision.child.pid>,
        'port' => <llama-server-vision.port>,
    };
};

<[base.log]>->( 1, 'llama-server parent initialized.,' );

