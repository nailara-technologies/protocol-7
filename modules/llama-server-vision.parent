## [:< ##

# name  = llama-server-vision.parent
# descr = parent process - monitors llama-server child and provides management API

<[base.log]>->( 1, 'llama-server parent process starting.,' );

# Store child PID for monitoring
my $child_pid = <llama-server-vision.child.pid>;
<[base.logs]>->( 1, "monitoring child process PID %d", $child_pid );

# Initialize reply tracking for pipe communication
<llama-server-vision.reply_ids> = [];
<llama-server-vision.pending_requests> = {};
<llama-server-vision.request_counter> = 0;

# Get parent pipe for sending commands to child
my $parent_pipe = <llama-server-vision.pipe.parent>;

# Register commands for discovery by framework
<data.base.cmd.status> = 'llama-server-vision.cmd.status';
<data.base.cmd.analyze_image> = 'llama-server-vision.cmd.analyze_image';

<[base.log]>->( 1, 'llama-server vision parent initialized.,' );

