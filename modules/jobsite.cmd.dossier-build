# name  = jobsite.cmd.dossier-build
# descr = build full evidence dossier for a period
# param = "<from> <to>"
# note  = from/to are YYYY-MM-DD each

my $args = $call->{'args'} // '';
my ( $from, $to ) = split ' ', $args;
if ( not length $from or not length $to ) {
    return { 'mode' => 'false', 'data' => 'expected "<from> <to>"' };
}
my $params = { 'from' => $from, 'to' => $to };

my $assembled = <[jobsite.report.assemble]>->($params);
return { 'mode' => 'false', 'data' => $assembled->{'data'} }
    if not $assembled->{'mode'};

my $rendered
    = <[jobsite.report.render_dossier]>->( $assembled->{'report_path'} );
return { 'mode' => 'false', 'data' => $rendered->{'data'} }
    if not $rendered->{'mode'};

return {
    'mode' => 'true',
    'data' => sprintf(
        'report: %s  dossier: %s  entries: %d',
        $assembled->{'report_path'}, $rendered->{'html_path'},
        $assembled->{'count'}
    ),
};

