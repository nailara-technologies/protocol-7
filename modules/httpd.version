## [:< ##

# name = httpd.version

# Return HTTP server version information

my $detail_level = shift // 0;

# Basic version information
my $version_info = {
    'version'    => '2.5.3',
    'codename'   => 'Async Performance',
    'build_date' => '2025-03-01',
    'protocol'   => 'HTTP/1.1'
};

# Add extended information if requested
if ( $detail_level > 0 ) {
    $version_info->{'features'} = {
        'async_io'         => 1,
        'range_requests'   => 1,
        'chunked_transfer' => 1,
        'keepalive'        => 1,
        'tls'              => 0,    # Planned for future
        'http2'            => 0     # Planned for future
    };

    $version_info->{'performance'} = {
        'max_connections'      => 200,
        'avg_response_time_ms' => 28
    };
}

# Add full diagnostic information if requested
if ( $detail_level > 1 ) {
    $version_info->{'modules'} = [
        'httpd.benchmark',     'httpd.diagnostic',
        'httpd.file_transfer', 'httpd.http_get',
        'httpd.http_head'
    ];

    $version_info->{'developers'} = ['nailara-technologies'];
}

return $version_info;

