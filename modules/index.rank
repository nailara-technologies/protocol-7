## [:< ##

# name = index.rank
# descr = assign numerical addresses by frequency rank and build ring trie

## clear old address and trie structures ##
<index.addr>        = {};
<index.packed_rank> = {};
<index.trie>        = {};

## ring 0 : single characters ##
my %char_freq = %{<index.freq>};
my @char_ranked
    = sort { $char_freq{$b} <=> $char_freq{$a} || $a cmp $b } keys %char_freq;

my $rank = 0;
for my $char (@char_ranked) {
    <index.addr>->{"0:$char"} = $rank;
    $rank++;
}
<index.packed_rank>->{0} = join '', @char_ranked;

## per-ring sequence ranking ##
my %seq_by_win;

for my $win ( sort { $a <=> $b } keys %{<index.level>} ) {
    next if $win == 0;
    my %freq   = %{ <index.level>->{$win} };
    my @ranked = sort { $freq{$b} <=> $freq{$a} || $a cmp $b } keys %freq;
    $seq_by_win{$win} = \@ranked;
    my $depth = $win - 1;
    my $r     = 0;
    for my $seq (@ranked) {
        <index.addr>->{"$depth:$seq"} = $r;
        $r++;
    }
    <index.packed_rank>->{$depth} = join '', @ranked;
}

## pre-compute children by prefix for trie building ##
my %children_by_prefix;    # "$next_win:$prefix" => [ [child_seq, freq], ... ]

## ring 0 children come from window size 2 ##
if ( exists <index.level>->{2} ) {
    my %freq = %{ <index.level>->{2} };
    for my $seq ( keys %freq ) {
        my $prefix = substr( $seq, 0, 1 );
        push @{ $children_by_prefix{"2:$prefix"} }, [ $seq, $freq{$seq} ];
    }
}

## higher rings ##
for my $win ( sort { $a <=> $b } keys %{<index.level>} ) {
    next if $win == 0;
    my $next_win = $win + 1;
    next if not exists <index.level>->{$next_win};
    my %freq = %{ <index.level>->{$next_win} };
    for my $seq ( keys %freq ) {
        my $prefix = substr( $seq, 0, $win );
        push @{ $children_by_prefix{"$next_win:$prefix"} },
            [ $seq, $freq{$seq} ];
    }
}

## build ring 0 trie nodes ##
my @ring0_nodes;
for my $r ( 0 .. $#char_ranked ) {
    my $char          = $char_ranked[$r];
    my @child_entries = @{ $children_by_prefix{"2:$char"} // [] };
    my @sorted
        = sort { $b->[1] <=> $a->[1] || $a->[0] cmp $b->[0] } @child_entries;
    my @child_ranks = map { <index.addr>->{ "1:" . $_->[0] } } @sorted;
    my $term        = <index.terminal>->{ $char_ranked[$r] } ? 1 : 0;
    push @ring0_nodes, [ $term, pack( 'N*', @child_ranks ) ];
}
<index.trie>->{0} = \@ring0_nodes if @ring0_nodes;

## build sequence ring trie nodes ##
for my $win ( sort { $a <=> $b } keys %{<index.level>} ) {
    next if $win == 0;
    my $depth      = $win - 1;
    my $next_win   = $win + 1;
    my $next_depth = $next_win - 1;
    my @nodes;
    for my $seq ( @{ $seq_by_win{$win} } ) {
        my @child_entries = @{ $children_by_prefix{"$next_win:$seq"} // [] };
        my @sorted = sort { $b->[1] <=> $a->[1] || $a->[0] cmp $b->[0] }
            @child_entries;
        my @child_ranks
            = map { <index.addr>->{ "$next_depth:" . $_->[0] } } @sorted;
        my $term = <index.terminal>->{$seq} ? 1 : 0;
        push @nodes, [ $term, pack( 'N*', @child_ranks ) ];
    }
    <index.trie>->{$depth} = \@nodes if @nodes;
}

0;

