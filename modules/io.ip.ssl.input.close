## [:< ##

# name = io.ip.ssl.input.close
# descr = Clean up SSL client socket after input processing complete

my $client_sock = shift;

return undef if not defined $client_sock;

<[base.logs]>->(
    2, '[close] SSL client socket closing, fd=%d',
    fileno($client_sock)
);

# Close the SSL socket (automatically closes underlying TCP socket)
if ( defined $client_sock ) {
    close($client_sock);
    return TRUE;
}

return undef;

0;

