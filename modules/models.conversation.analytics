## [:< ##

# name = models.conversation.analytics
# descr = compute analytics for conversation system

my $params = shift;

my $job_id  = $params->{'job_id'}  // '';
my $context = $params->{'context'} // 'conversation';

<models.conversations> //= {};

my $start_time = <[base.time]>->(4);

## Single conversation stats
if ( length($job_id) ) {
    unless ( exists <models.conversations>->{$job_id} ) {
        return {
            'success' => FALSE,
            'error'   => "conversation not found: $job_id",
            'job_id'  => $job_id
        };
    }

    my $conversation = <models.conversations>->{$job_id};
    my $turns = $conversation->{'turns'} // [];
    my @participants
        = keys %{ $conversation->{'participants'} // {} };

    my $turn_count = scalar(@$turns);
    my $tokens_used = $conversation->{'tokens_used'} // 0;

    ## Analyze by role
    my %role_stats;
    foreach my $turn (@$turns) {
        my $role = $turn->{'role'} // 'unknown';
        $role_stats{$role}{'count'}++;
        $role_stats{$role}{'tokens'}
            += ( $turn->{'tokens'} // 0 );
    }

    <[base.logs]>->(
        2, "[$context] analytics: job_id=%s turns=%d tokens=%d",
        $job_id, $turn_count, $tokens_used
    );

    my $elapsed_ms = ( <[base.time]>->(4) - $start_time ) * 1000;

    return {
        'success'           => TRUE,
        'job_id'            => $job_id,
        'turn_count'        => $turn_count,
        'tokens_used'       => $tokens_used,
        'token_budget'      => $conversation->{'token_budget'} // 0,
        'participant_count' => scalar(@participants),
        'compaction_count'  => $conversation->{'compaction_count'} // 0,
        'role_breakdown'    => \%role_stats,
        'elapsed_ms'        => $elapsed_ms
    };
}

## All conversations stats
my @conversation_ids = keys %{ <models.conversations> };
my $total_conversations = scalar(@conversation_ids);
my $total_turns = 0;
my $total_tokens = 0;

foreach my $cid (@conversation_ids) {
    my $c = <models.conversations>->{$cid};
    $total_turns += scalar( @{ $c->{'turns'} } );
    $total_tokens += ( $c->{'tokens_used'} // 0 );
}

<[base.logs]>->(
    2, "[$context] global analytics: conversations=%d turns=%d tokens=%d",
    $total_conversations, $total_turns, $total_tokens
);

my $elapsed_ms = ( <[base.time]>->(4) - $start_time ) * 1000;

return {
    'success'                   => TRUE,
    'total_active_conversations' => $total_conversations,
    'total_turns'               => $total_turns,
    'total_tokens_used'         => $total_tokens,
    'average_tokens_per_turn'   => $total_turns > 0
        ? int( $total_tokens / $total_turns )
        : 0,
    'average_turns_per_conversation' => $total_conversations > 0
        ? int( $total_turns / $total_conversations )
        : 0,
    'elapsed_ms' => $elapsed_ms
};

