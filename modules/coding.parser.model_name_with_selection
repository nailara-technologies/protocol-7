## [:< ##

# name  = coding.parser.model_name_with_selection
# descr = prefix amos id with * if it matches the configured active model

my $amos = shift // '';

return $amos unless length $amos;

## get configured model ids
my $gpu_model = <inference.backend.gpu.model_id> // '';
my $cpu_model = <inference.backend.cpu.model_id> // '';

## differentiate gpu, cpu, and dual active models with different bracket
## styles
my $gpu_match = length($gpu_model) && $amos eq $gpu_model;
my $cpu_match = length($cpu_model) && $amos eq $cpu_model;

return sprintf( '{%s}', $amos ) if $gpu_match && $cpu_match;
return sprintf( '[%s]', $amos ) if $gpu_match;
return sprintf( '<%s>', $amos ) if $cpu_match;
return $amos;

