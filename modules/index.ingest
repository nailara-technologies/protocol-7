## [:< ##

# name = index.ingest
# descr = stream raw text into frequency counts

my $text = ref $ARG ? $ARG->$* : $ARG;

for my $char ( split //, $text ) {
    next if $char eq ' ';    ## space is separator, excluded from index ##
    <index.freq>->{$char}++;
}

<index.meta>->{'total'} += length($text);
<index.meta>->{'dirty'} = TRUE;

