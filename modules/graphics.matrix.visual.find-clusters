# name  = graphics.matrix.visual.find-clusters
# desc  = Find similarity clusters within sphere groups
#
# input : $spheres - hash of sphere groups
#         $threshold - similarity threshold (default: 0.95)
# output: array of cluster hashes

my $spheres   = shift // {};
my $threshold = shift // 0.95;

my $clusters = [];

for my $sphere ( sort { $a <=> $b } keys %$spheres ) {
    my $sphere_images = $spheres->{$sphere} // [];
    next unless @$sphere_images;

    # For sphere 0 (color samples), group by color similarity
    if ( $sphere == 0 ) {
        my $color_groups = <[graphics.matrix.visual.group-by-color]>->(
            $sphere_images, $threshold
        );
        push @$clusters, @$color_groups;
    }

    # For larger spheres, use spatial proximity
    else {
        my $proximity_groups
            = <[graphics.matrix.visual.group-by-proximity]>->(
            $sphere_images, $threshold
            );
        push @$clusters, @$proximity_groups;
    }
}

return $clusters;

