# name  = base.validate.composite_name
# param = $name, $context (optional: 'auth', 'ondemand', 'session')
# descr = validate username/zenka name against composite length limits with progressive warnings

my $name    = shift // return { valid => 0, error => 'name required' };
my $context = shift // 'general';

## Length limits (must match base.regex configuration!)
my $MAX_USERNAME    = 32;
my $MAX_SUBNAME     = 18;
my $MAX_SYSTEM_USER = 32;
my $MAX_WITH_PREFIX = 27;  ## Safe limit for 'unix-<name>' to fit in system-usr
my $MAX_COMPOSITE   = 50;  ## username[subname] composite limit

## Initialize warning tracking
$data{'validate'}{'composite_name'}{'warnings'} //= {};
my $warn_key = "$context:$name";
my $warned   = $data{'validate'}{'composite_name'}{'warnings'}{$warn_key} // 0;

## Start at log level 1 for first warning, increase on repeats (up to level 3)
my $loglevel = 1;
$loglevel++ if $warned > 0 && $warned < 2;
$loglevel++ if $warned >= 2 && $warned < 5;

## Basic validation - name matches usr_str pattern
my $re = $data{'regex'}{'base'};
if ( $name !~ m{^$re->{'usr_str'}$} ) {
    return {
        valid => 0,
        error => "invalid username format: '$name' (alphanumeric, hyphen, underscore only)"
    };
}

my $name_len = length($name);
my %result   = ( valid => 1, name => $name, length => $name_len );

## Check for composite pattern violations
my @warnings;
my @errors;

## 1. Check 'unix-<name>' prefix safety (critical for unix domain socket auth)
## All zenki can be accessed via unix socket, so validate for all contexts
if ( 1 ) {  ## Always check unix-auth prefix safety
    my $with_prefix     = "unix-$name";
    my $with_prefix_len = length($with_prefix);

    if ( $with_prefix_len > $MAX_SYSTEM_USER ) {
        push @errors,
            sprintf(
            "composite 'unix-%s' (%d chars) exceeds system-usr limit (%d)",
            $name, $with_prefix_len, $MAX_SYSTEM_USER );
        push @errors,
            "  This breaks: Unix domain socket authentication";
        push @errors,
            sprintf( "  Reduce username to %d chars or reconfigure base.regex",
            $MAX_WITH_PREFIX );
        $result{valid}           = 0;
        $result{breaks_unixauth} = 1;
    } elsif ( $name_len > $MAX_WITH_PREFIX ) {
        push @warnings,
            sprintf(
            "username '%s' (%d chars) near limit for unix-auth prefix safety",
            $name, $name_len );
        push @warnings,
            sprintf( "  'unix-%s' = %d chars (system-usr limit: %d)",
            $name, $with_prefix_len, $MAX_SYSTEM_USER );
        push @warnings,
            sprintf( "  Recommended maximum: %d chars", $MAX_WITH_PREFIX );
        $result{warn_unixauth} = 1;
    }
}

## 2. Check 'name[subname]' composite (informational)
## All zenki can have session subnames, so validate for all contexts
if ( 1 ) {  ## Always check composite patterns
    my $max_composite_len = $name_len + 2 + $MAX_SUBNAME;

    if ( $max_composite_len > $MAX_COMPOSITE ) {
        push @warnings,
            sprintf(
            "username '%s' (%d chars) may cause long session identifiers",
            $name, $name_len );
        push @warnings,
            sprintf(
            "  '%s[subname]' could reach %d chars (limit: %d)",
            $name, $max_composite_len, $MAX_COMPOSITE
            );
        $result{warn_composite} = 1;
    }
}

## 3. Log errors (always shown)
if (@errors) {
    $result{error} = join( "\n", @errors );
    <[base.log]>->( 0, "composite name validation FAILED: $name" );
    foreach my $err (@errors) {
        <[base.log]>->( 0, "  $err" );
    }
}

## 4. Log warnings (progressive: decrease frequency on repeats)
if ( @warnings && $loglevel <= 2 ) {
    <[base.log]>->( $loglevel, "composite name validation warning: $name" );
    foreach my $warn (@warnings) {
        <[base.log]>->( $loglevel, "  $warn" );
    }

    ## Track this warning
    $data{'validate'}{'composite_name'}{'warnings'}{$warn_key} = $warned + 1;
}

## 5. Store detailed info
$result{warnings}      = \@warnings if @warnings;
$result{context}       = $context;
$result{warning_count} = $warned + 1 if @warnings;

return \%result;

