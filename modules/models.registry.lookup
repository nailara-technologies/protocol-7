## [:< ##

# name  = models.registry.lookup
# param = <checksum_or_composite_id>
# descr = Smart lookup supporting both single (7-char) and composite (15-char) checksums
# return = model entry hashref or undef if not found

my $lookup_id = shift;

unless ( defined $lookup_id && length $lookup_id ) {
    <[base.s_warn]>->('lookup ID required');
    return undef;
}

my $registry = <models.registry> // {};

unless ( keys $registry->%* ) {
    <[base.logs]>->( 2, '[registry.lookup] registry is empty' );
    return undef;
}

## Check if this is a composite key (contains colon)
if ( $lookup_id =~ m{:} ) {

    ## COMPOSITE LOOKUP: path_checksum:model_checksum
    if ( exists $registry->{$lookup_id} ) {
        <[base.logs]>->( 1, '[registry.lookup] found composite key: %s', $lookup_id );
        return $registry->{$lookup_id};
    } else {
        <[base.logs]>->(
            2, '[registry.lookup] composite key not found: %s',
            $lookup_id
        );
        return undef;
    }

} else {

    ## SINGLE LOOKUP: just model_checksum (7 chars)
    ## Find all entries with this model checksum (may be multiple paths)

    my @matches = ();

    ## Direct match on registry key
    if ( exists $registry->{$lookup_id} ) {
        push @matches, { key => $lookup_id, entry => $registry->{$lookup_id} };
    }

    ## Check composite keys (format: path:model)
    foreach my $key ( keys $registry->%* ) {
        if ( $key =~ m{^[^:]+:(.+)$} ) {
            my $model_part = $1;
            if ( $model_part eq $lookup_id ) {
                push @matches, { key => $key, entry => $registry->{$key} };
            }
        }
    }

    unless ( @matches ) {
        <[base.logs]>->(
            2, '[registry.lookup] no matches found for model: %s',
            $lookup_id
        );
        return undef;
    }

    if ( @matches == 1 ) {
        <[base.logs]>->(
            1, '[registry.lookup] found single match for model: %s',
            $lookup_id
        );
        return $matches[0]->{entry};
    }

    ## Multiple matches - prefer primary (non-composite) key first
    foreach my $match (@matches) {
        if ( $match->{key} !~ m{:} ) {
            <[base.logs]>->(
                1, '[registry.lookup] found %d matches, returning primary: %s',
                scalar(@matches), $match->{key}
            );
            return $match->{entry};
        }
    }

    ## If all are composite, return first
    <[base.logs]>->(
        1, '[registry.lookup] found %d matches, returning first: %s',
        scalar(@matches), $matches[0]->{key}
    );
    return $matches[0]->{entry};
}

