## [:< ##

# name  = coding.async.compact_context
# descr = compact async conversation context when approaching token limit
# purpose = matches blocking version context compaction [ process-queued-task 245-405 ]

my ($task_id) = @ARG;

return unless defined $task_id;

my $state = <[coding.async.state_machine]>->( qw| get |, $task_id );
return unless defined $state;

my $messages = $state->{'messages'} // [];
my $round    = $state->{'round'}    // 0;

## skip if too few messages ##
return if $round < 3 || @{$messages} < 6;

## compaction parameters — use actual server n_ctx, not configured floor ##
## configured value may be a minimum floor; server may have more context ##
my $backend       = $state->{'backend'} // 'gpu';
my $srv_key       = $backend eq qw| cpu | ? qw| cpu | : qw| gpu |;
my $srv_info      = ( <coding.inference_servers> // {} )->{$srv_key} // {};
my $context_limit = $srv_info->{'n_ctx'} // <inference.model.context_length>
    // 16384;
my $compact_threshold = int( $context_limit * 0.53 );
my $chars_per_token   = 3.2;
my $keep_recent_msgs  = 6;    ## preserve last 3 tool rounds [ 6 msgs ] ##

## estimate total tokens ##
my $total_chars = 0;
for my $msg ( @{$messages} ) {
    $total_chars += length( $msg->{'content'} // '' );
    if ( ref $msg->{'tool_calls'} eq qw| ARRAY | ) {
        for my $tc ( $msg->{'tool_calls'}->@* ) {
            $total_chars
                += length( $tc->{'function'}->{'arguments'} // '' );
            $total_chars += length( $tc->{'function'}->{'name'} // '' );
        }
    }
}

## 1.4x accounts for json keys, tool defs, metadata ##
my $est_tokens = int( ( $total_chars * 1.4 ) / $chars_per_token );

return if $est_tokens <= $compact_threshold;

<[base.logs]>->(
    1, "compact_context: %d tokens est, threshold=%d, %d msgs",
    $est_tokens, $compact_threshold, scalar @{$messages}
);

## keep system [0] and user [1] messages intact ##
## compact tool round messages in the middle ##
## keep the most recent $keep_recent_msgs messages ##
my $protect_start = 2;
my $protect_end   = scalar( @{$messages} ) - $keep_recent_msgs;
$protect_end = $protect_start if $protect_end < $protect_start;

return if $protect_end <= $protect_start;

## inference-backed compaction path — enqueue sub-task, suspend parent ##
if ( ( <coding.cfg.compaction_inference> // 'no' ) eq qw| yes |
    and not defined $state->{'compaction_pending'} ) {

    ## serialize middle messages into a single text block for the summarizer ##
    my @to_compact = @{$messages}[ $protect_start .. $protect_end - 1 ];
    my @parts;
    for my $m (@to_compact) {
        my $role    = $m->{'role'}    // 'unknown';
        my $content = $m->{'content'} // '';
        if ( $role eq qw| assistant |
            and ref $m->{'tool_calls'} eq qw| ARRAY | ) {
            my @names = map { $ARG->{'function'}->{'name'} // '?' }
                $m->{'tool_calls'}->@*;
            push @parts, "assistant called: " . join( ', ', @names );
            push @parts,
                "  args: "
                . ( $m->{'tool_calls'}[0]{'function'}{'arguments'} // '' )
                if @{ $m->{'tool_calls'} } == 1;
        } elsif ( length $content ) {
            my $snip = substr( $content, 0, 800 );
            push @parts, "$role: $snip";
        }
    }
    my $history_text = join( "\n---\n", @parts );

    my $sys
        = "You are a context summarizer. Summarize the following conversation "
        . "history into a compact but information-dense paragraph. Preserve: "
        . "files read, edits made, findings, decisions, errors encountered. "
        . "Omit: tool call mechanics, raw file content, repetition. "
        . "Reply with only the summary paragraph, no preamble.";

    my $prompt
        = "Conversation history to summarize:\n\n$history_text\n\n"
        . "[ round=$round | est_tokens=$est_tokens | msgs="
        . scalar(@to_compact) . " ]";

    ## enqueue compaction sub-task with no tools, single round ##
    my $child_id = <[coding.task.enqueue]>->(
        {   request  => { description => $prompt },
            metadata => {
                raw_request    => { type => 'gpu', description => $prompt },
                parent_task_id => $task_id,
                is_compaction  => 1,
                compact_start  => $protect_start,
                compact_end    => $protect_end,
            },
            system     => $sys,
            no_tools   => 1,
            max_rounds => 1,
        }
    );

    if ( defined $child_id and length $child_id ) {
        <coding.task.parent>->{$child_id} = $task_id;
        $state->{'compaction_pending'} = $child_id;
        $state->{'compact_start'}      = $protect_start;
        $state->{'compact_end'}        = $protect_end;
        $state->{'state'}              = qw| subtask |;
        $state->{'subtask_id'}         = $child_id;
        $state->{'pending_subtask'}    = $child_id;
        <coding.async.task_state>->{$task_id} = $state;
        <[base.logs]>->(
            1, "compact_context: inference compaction → child %s [ %d msgs ]",
            $child_id, scalar(@to_compact)
        );
        return qw| pending |;    ## signal caller to hold the round ##
    }

    ## fallback to heuristic if enqueue failed ##
    <[base.logs]>->(
        1, "compact_context: inference enqueue failed, falling back"
    );
}

## graduated compaction: older = more aggressive ##
my $mid = int( ( $protect_start + $protect_end ) / 2 );
my @summary_parts;

## oldest section: aggressive — just tool names ##
for my $i ( $protect_start .. $mid - 1 ) {
    my $m = $messages->[$i];
    if ( ( $m->{'role'} // '' ) eq 'assistant'
        and ref $m->{'tool_calls'} eq qw| ARRAY | ) {
        my @names = map { $ARG->{'function'}->{'name'} // '?' }
            $m->{'tool_calls'}->@*;
        push @summary_parts, 'called: ' . join( ', ', @names );
    } elsif ( ( $m->{'role'} // '' ) eq 'assistant'
        and ( $m->{'content'} // '' ) =~ m/\[tool_calls:/ ) {
        ## handle async format without tool_calls field ##
        push @summary_parts, $m->{'content'};
    } elsif ( ( $m->{'role'} // '' ) eq 'tool' ) {
        my $content = $m->{'content'} // '';
        my $snip    = substr( $content, 0, 80 );
        $snip =~ s|\n.*||s;
        push @summary_parts, "result: $snip";
    }
}

## middle section: moderate — tool name + short result ##
for my $i ( $mid .. $protect_end - 1 ) {
    my $m = $messages->[$i];
    if ( ( $m->{'role'} // '' ) eq 'assistant'
        and ref $m->{'tool_calls'} eq qw| ARRAY | ) {
        my @names = map { $ARG->{'function'}->{'name'} // '?' }
            $m->{'tool_calls'}->@*;
        push @summary_parts, 'called: ' . join( ', ', @names );
    } elsif ( ( $m->{'role'} // '' ) eq 'assistant'
        and ( $m->{'content'} // '' ) =~ m/\[tool_calls:/ ) {
        push @summary_parts, $m->{'content'};
    } elsif ( ( $m->{'role'} // '' ) eq 'tool' ) {
        my $content = $m->{'content'} // '';
        my $snip    = substr( $content, 0, 200 );
        $snip =~ s|\n| / |g;
        push @summary_parts, "result: $snip";
    }
}

## calculate progress based on current token usage ##
my $pct_complete = int( ( $est_tokens / $context_limit ) * 100 );

## replace compacted range with summary message ##
my $summary
    = "[ inference : round "
    . $round
    . " | context "
    . $pct_complete
    . "% used ]\n"
    . "[ compacted tool rounds — "
    . scalar(@summary_parts)
    . " interactions ]\n"
    . join( "\n", @summary_parts );

splice @{$messages}, $protect_start, $protect_end - $protect_start,
    {
    'role'    => 'assistant',
    'content' => $summary,
    };

<[base.logs]>->(
    1,
    "compact_context: compacted %d msgs → 1 summary, %d msgs remain",
    $protect_end - $protect_start,
    scalar @{$messages}
);

## truncate protected messages if still over threshold ##
my $after_chars = 0;
$after_chars += length( $ARG->{'content'} // '' ) for @{$messages};
my $after_tokens = int( ( $after_chars * 1.4 ) / $chars_per_token );

if ( $after_tokens > $compact_threshold * 0.8 ) {
    my $max_protected_chars = 32000;
    my $new_protect_end     = scalar( @{$messages} ) - $keep_recent_msgs;
    for my $i ( $new_protect_end .. $#{$messages} ) {
        my $content = $messages->[$i]->{'content'} // '';
        if ( length $content > $max_protected_chars ) {
            $messages->[$i]->{'content'}
                = substr( $content, 0, $max_protected_chars )
                . "\n\n... [ truncated "
                . ( length($content) - $max_protected_chars )
                . " chars ]";
        }
    }
}

return;

