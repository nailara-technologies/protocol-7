## [:< ##
# name  = storage.cmd.lookup-checksum
# descr = Look up files by checksum

use strict;
use warnings;

return sub {
    my ($call) = @_;
    my $args = $call->{'args'} // '';

    my ( $type, $checksum ) = split /\s+/, $args, 2;

    $type     //= '';
    $checksum //= '';

    if ( not length $type or not length $checksum ) {
        return {
            'mode' => 'false',
            'data' => 'Usage: lookup-checksum <mapping-type> <checksum>'
        };
    }

    my $module = "plugin.storage.$type";

    unless ( exists $data{'storage'}{'mapping'}{$type} ) {
        return {
            'mode' => 'false',
            'data' => "Mapping type '$type' not loaded"
        };
    }

    my $result = <[$module]>->(
        {   'operation' => 'lookup',
            'checksum'  => $checksum,
        }
    );

    if ( $result->{'mode'} eq 'true' ) {
        my $data   = $result->{'data'};
        my $output = "Checksum: $data->{checksum}\n";
        $output .= "Found: $data->{count} file(s)\n\n";

        for my $path ( @{ $data->{paths} } ) {
            $output .= "  $path\n";
        }

        return { 'mode' => 'size', 'data' => $output };
    } else {
        return $result;
    }
};

