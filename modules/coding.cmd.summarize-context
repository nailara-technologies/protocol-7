## [:< ##

# name  = coding.cmd.summarize-context
# descr = summarize content via inference [ model-pinned ]

my $args_str = $call->{'args'} // '';

## content in call->{'data'}, options in args ##
my $content = $call->{'data'} // $args_str;
my $focus   = '';
my $model   = '';
my $backend = 'cpu';
my $store   = 0;
my $node_id = '';
my $max_len = 800;
my $path    = '';

if ( $args_str =~ s|focus=(\S+)|| )        { $focus   = $1 }
if ( $args_str =~ s|model=(\S+:\S+)|| )    { $model   = $1 }
if ( $args_str =~ s|backend=(cpu\|gpu)|| ) { $backend = $1 }
if ( $args_str =~ s|store=(\d+)|| )        { $store   = $1 }
if ( $args_str =~ s|node_id=(\S+)|| )      { $node_id = $1 }
if ( $args_str =~ s|max_len=(\d+)|| )      { $max_len = $1 }
if ( $args_str =~ s|path=(\S+)|| )         { $path    = $1 }

## :file: / :path: keyword prefix [ overrides content ] ##
if ( $content =~ s|^:(?:file|path):| | ) { $path = $content }

## explicit :b32: prefix ##
if ( $content =~ s|^:b32:||i ) {
    my $decoded = decode_b32r($content);
    $content = $decoded if defined $decoded and length $decoded;
}

## file path: detect encoding and slurp ##
if ( length $path ) {
    my $enc         = <[file.encoding]>->($path);
    my $content_ref = <[file.slurp]>->( $path, $enc );
    $content = defined $content_ref ? $content_ref->$* : '';
}

## base32 auto-detect on plain single-line args ##
elsif ( $content =~ /^[2-7A-Z]+=*$/ ) {
    my $decoded = decode_b32r($content);
    $content = $decoded if defined $decoded and length $decoded;
}

my $summary = <[coding.tools.handler.summarize_context]>->(
    {   content => $content,
        focus   => $focus,
        model   => $model,
        backend => $backend,
        max_len => $max_len,
        store   => $store,
        node_id => $node_id,
    }
);

return { mode => 'true', data => $summary };

