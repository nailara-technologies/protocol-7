## [:< ##

# name  = coding.cmd.summarize-context
# descr = summarize content via inference [ model-pinned ]

my $args_str = $call->{'args'} // '';

## parse options from args first, then remainder is bare content ##
my $focus   = '';
my $model   = '';
my $backend = qw| cpu |;
my $store   = 0;
my $node_id = '';
my $max_len = 800;
my $path    = '';

my $callback_id = '';

if ( $args_str =~ s|focus=(\S+)|| )         { $focus       = $1 }
if ( $args_str =~ s|model=(\S+:\S+)|| )     { $model       = $1 }
if ( $args_str =~ s{backend=(cpu\|gpu)}{} ) { $backend     = $1 }
if ( $args_str =~ s|store=(\d+)|| )         { $store       = $1 }
if ( $args_str =~ s|node_id=(\S+)|| )       { $node_id     = $1 }
if ( $args_str =~ s|max_len=(\d+)|| )       { $max_len     = $1 }
if ( $args_str =~ s|path=(\S+)|| )          { $path        = $1 }
if ( $args_str =~ s|callback_id=(\S+)|| )   { $callback_id = $1 }
$args_str =~ s{^\s+|\s+$}{}g;    ## trim remaining whitespace ##

## content: multiline data takes precedence, else remaining args ##
my $content = $call->{'data'} // $args_str;

## :file: / :path: keyword prefix : extract path only, no trailing options ##
if ( $content =~ s{^:(?:file|path):(\S+).*}{} ) { $path = $1 }

## explicit :b32: prefix ##
if ( $content =~ s|^:B32:||i ) {
    my $decoded = decode_b32r($content);
    $content = $decoded if defined $decoded and length $decoded;
}

## file path: detect encoding and slurp ##
if ( length $path ) {
    ## resolve relative paths against system root ##
    $path = <system.root_path> . "/$path" if length $path and $path !~ m{^/};
    return { mode => qw| false |, data => "file not found : $path" }
        unless -e $path;
    return { mode => qw| false |, data => "not readable : $path" }
        unless -r $path;
    my $enc = <[file.encoding]>->($path);
    $content = <[file.read]>->( $path, $enc );
    return { mode => qw| false |, data => "failed to read : $path" }
        unless defined $content;
}

## base32 auto-detect on plain single-line args ##
elsif ( $content =~ m|^[2-7A-Z]+=*$| ) {
    my $decoded = decode_b32r($content);
    $content = $decoded if defined $decoded and length $decoded;
}

return { mode => qw| false |, data => 'content required' }
    unless length $content;

## build system prompt : compaction-style, focus-aware ##
my $system_prompt
    = 'you are a context compaction assistant. '
    . 'your response IS the summary : output it directly as plain text. '
    . 'no tool calls, no apologies, no explanation of what you are doing. '
    . 'preserve all load-bearing specifics: module names, line numbers, '
    . 'decisions, open questions. omit narrative filler. '
    . ( length($focus) ? "focus on: $focus. " : '' )
    . 'target length: 2-4 paragraphs.';

## enqueue single-round no-tools inference task ##
my $task = {
    'id'      => <[base.gen_id]>->(<coding.task.queue>),
    'type'    => 'summary',
    'request' =>
        { description => "summarize the following content:\n\n$content" },
    'metadata' => {
        raw_request => {
            type        => 'gpu',
            description => "summarize the following content:\n\n$content"
        }
    },
    'system'     => $system_prompt,
    'no_tools'   => TRUE,
    'max_rounds' => 1,
};

my $queue_result = <[coding.task.enqueue]>->($task);
return {
    mode => qw| false |,
    data => "enqueue failed: $queue_result->{'error'}\n"
    }
    unless $queue_result->{'success'};

## register deferred completion : on_task_complete routes result back ##
$data{'coding'}{'deferred_replies'} //= {};
my $deferred_id = <[base.gen_id]>->( $data{'coding'}{'deferred_replies'} );
$data{'coding'}{'deferred_replies'}->{$deferred_id} = {
    'deferred_id' => $deferred_id,
    'reply_id'    => $call->{'reply_id'},
    'callback_id' =>
        $callback_id,    ## task zenka callback key if cross-zenka ##
    'task_id'   => $task->{'id'},
    'submitted' => <[base.time]>->(3),
    'status'    => qw| waiting |,
};

return { mode => qw| deferred | };

