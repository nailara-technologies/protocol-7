## [:< ##

# name = httpd.vhost_template_resolver
# descr = resolve template files across vhost hierarchy
#         (3-level priority system)
#
# Implements template resolution with the following priority:
#   1. Vhost-subdirectory level:  /var/httpd/{vhost}/{path}/_templates/
#   2. Vhost root level:          /var/httpd/{vhost}/_templates/
#   3. Global level:              /var/httpd/_global_templates/
#
# Parameters:
#   $_[0] - Vhost name (e.g., "127.0.0.1", "example.com")
#   $_[1] - Request path (e.g., "/blog/post.html")
#   $_[2] - File extension to check (default: "tmpl" for Protocol-7 templates)
#
# Returns:
#   Full file path if template found, undef otherwise
#   Also stores resolution info in $data{'template_resolve_cache'} for caching

my $vhost = shift;
my $path  = shift;
my $ext   = shift // 'tmpl';

## Validate parameters ##
unless ( defined $vhost and length $vhost ) {
    <[base.log]>->( 0, "vhost_template_resolver : missing vhost parameter" );
    return undef;
}

unless ( defined $path and length $path ) {
    <[base.log]>->( 0, "vhost_template_resolver : missing path parameter" );
    return undef;
}

## Get site root directory ##
my $site_root = <httpd.site_dir>;

## Normalize path (remove leading slash, trailing slash) ##
$path =~ s|^/+||;
$path =~ s|/+$||;

## Handle root path - use index.html as default ##
$path = 'index.html' if !length $path;

## Initialize caching if needed ##
unless ( exists $data{'template_resolve_cache'} ) {
    $data{'template_resolve_cache'} = {};
}

my $cache_key = "$vhost:$path:$ext";
if ( exists $data{'template_resolve_cache'}->{$cache_key} ) {
    return $data{'template_resolve_cache'}->{$cache_key};
}

## Template resolution strategy ##
## For path /blog/post.html, we try:
##   1. /var/httpd/{vhost}/blog/_templates/post.html.{ext}
##   2. /var/httpd/{vhost}/_templates/blog/post.html.{ext}
##   3. /var/httpd/{vhost}/_templates/post.html.{ext}
##   4. /var/httpd/_global_templates/blog/post.html.{ext}
##   5. /var/httpd/_global_templates/post.html.{ext}

my @resolution_attempts;

## Extract directory and filename from path ##
my $dirname  = $path;
my $filename = '';
if ( $path =~ m|^(.*/)?([^/]+)$| ) {
    $dirname  = defined $1 ? $1 : '';
    $filename = $2;
}

<[base.log]>->(
    2,
    "vhost_template_resolver: resolving "
        . "'$path' (dir='$dirname', file='$filename')"
);

## Priority 1: Subdirectory-level templates (most specific) ##
if ( length $dirname ) {
    my $subdir_path = "$site_root/$vhost/$dirname/_templates/$filename.$ext";
    <[base.log]>->( 3, "  [1] checking : $subdir_path" );
    push @resolution_attempts, $subdir_path;
    if ( -f $subdir_path ) {
        $data{'template_resolve_cache'}->{$cache_key} = $subdir_path;
        <[base.log]>->(
            1,
            "vhost_template_resolver: [$vhost] FOUND (level 1): $subdir_path"
        );
        return $subdir_path;
    }
}

## Priority 2: Vhost root templates ##
my $vhost_template_path = "$site_root/$vhost/_templates/$path.$ext";
<[base.log]>->( 3, "  [2] checking : $vhost_template_path" );
push @resolution_attempts, $vhost_template_path;
if ( -f $vhost_template_path ) {
    $data{'template_resolve_cache'}->{$cache_key} = $vhost_template_path;
    <[base.log]>->(
        1,
        "vhost_template_resolver: [$vhost] "
            . "FOUND (level 2): $vhost_template_path"
    );
    return $vhost_template_path;
}

## Priority 3: Global templates ##
my $global_template_path = "$site_root/_global_templates/$path.$ext";
<[base.log]>->( 3, "  [3] checking : $global_template_path" );
push @resolution_attempts, $global_template_path;
if ( -f $global_template_path ) {
    $data{'template_resolve_cache'}->{$cache_key} = $global_template_path;
    <[base.log]>->(
        1,
        "vhost_template_resolver: [$vhost] "
            . "FOUND (level 3): $global_template_path"
    );
    return $global_template_path;
}

## Template not found - log all attempts for debugging ##
<[base.log]>->(
    2, "vhost_template_resolver: [$vhost] template NOT FOUND for '$path'"
);

## Cache the negative result (prevents repeated searches) ##
$data{'template_resolve_cache'}->{$cache_key} = undef;

return undef;

