## [:< ##

# name  = data.handler.indexer.notify
# descr = handle notifications from data zenka for indexing

my ($args_str) = @ARG;
$args_str //= '';

my ( $hash_path, $count, $size ) = split( / +/, $args_str, 3 );

<[base.log]>->(
    1, ": indexer notified of import: '%s' (%s files, %s bytes)",
    $hash_path,
    $count // '?',
    $size  // '?'
);

## trigger index job for this path ##
## in full implementation, this would queue an indexing job

return TRUE;

