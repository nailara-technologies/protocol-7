## [:< ##

# name  = coding.handler.drain_pipe
# descr = drain server stdout/stderr pipe to prevent write() blocking
# note  = single-read io watcher : returns to event loop after each
#         invocation. modeled after v7.handler.zenka_output.

my $event = shift;

my $watcher = eval { $event->w };
my $fh      = eval { $watcher->fd };
return unless defined $fh;

## precheck: avoid Perl warning on closed filehandle ##
unless ( defined fileno($fh) ) {
    $watcher->cancel if defined $watcher;
    <[base.logs]>->( 2, "drain_pipe: pipe closed, watcher cancelled" );
    return;
}

## single read per watcher invocation : yields to event loop the watcher ##
## fires again automatically if more data arrives                        ##
my $buf = '';
my $n   = sysread( $fh, $buf, 4096 );

if ( !defined $n ) {
    ## EBADF/EINVAL: fd closed between precheck and read ##
    if ( $! == 9 or $! == 22 ) {
        $watcher->cancel if defined $watcher;
        <[base.logs]>->( 2, "drain_pipe: pipe closed, watcher cancelled" );
    }
    ## EAGAIN and other transient errors: return without cancelling the ##
    ## watcher stays alive and fires again when readable                ##
    return;
}

if ( $n == 0 ) {
    ## EOF : server closed its write end ##
    $watcher->cancel if defined $watcher;
    <[base.logs]>->( 2, "drain_pipe: pipe EOF, watcher cancelled" );
    return;
}

## keep a bounded rolling tail instead of fully discarding : once a server ##
## is 'ready', ITS stdout/stderr are drained-not-logged, so a request-time ##
## error [ eg an inference call getting http_500 ] left NO trace anywhere  ##
## of what the server itself said - confirmed live, repeatedly, chasing    ##
## http_500s with no server-side error visible. cap keeps memory bounded ; ##
## same fileno-match lookup coding.cancel_watcher.backend_monitor uses to  ##
## find which backend a drained fd belongs to                              ##
my $fileno = fileno($fh);
if ( defined $fileno ) {
    my $servers = <coding.inference_servers> // {};
    for my $backend ( keys %$servers ) {
        my $srv = $servers->{$backend};
        my $out = $srv->{'io_stdout'};
        my $err = $srv->{'io_stderr'};
        if (   ( defined $out && eval { fileno($out) } == $fileno )
            || ( defined $err && eval { fileno($err) } == $fileno ) ) {
            my $tail_cap = 4096;
            $srv->{'tail_output'}
                = substr( ( $srv->{'tail_output'} // '' ) . $buf,
                -$tail_cap );
            last;
        }
    }
}

## successfully discarded $n bytes ##
<[base.logs]>->( 3, "drain_pipe: discarded %d bytes from server pipe", $n );

return;

