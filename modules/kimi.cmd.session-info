## [:< ##

# name  = kimi.cmd.session-info
# descr = show current kimi-web session state

my $sid    = <kimi.session_id> // 'none';
my $status = <kimi.ws.status>  // 'unknown';
my $conn   = <kimi.ws.connected> ? 'yes' : 'no';
my $task   = <kimi.task.active_id> // 'none';
my $pend   = scalar keys %{<kimi.wire.pending>};
my $approv = scalar keys %{<kimi.approval.pending>};
my $auto   = <kimi.approval.auto_approve> ? 'on' : 'off';

my $output = sprintf " session_id   : %s\n", $sid;
$output .= sprintf " status       : %s\n", $status;
$output .= sprintf " connected    : %s\n", $conn;
$output .= sprintf " active_task  : %s\n", $task;
$output .= sprintf " wire_pending : %d\n", $pend;
$output .= sprintf " approvals    : %d\n", $approv;
$output .= sprintf " auto_approve : %s\n", $auto;

return { 'mode' => 'data', 'data' => $output };

