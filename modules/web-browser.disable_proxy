# name = web-browser.disable_proxy

my $log_level = shift // 1;

if (<web-browser.init_proxy>) {

    my $context = <web-browser.gtk_obj.web_context>;
    $context->set_network_proxy_settings(
        'WEBKIT_NETWORK_PROXY_MODE_NO_PROXY', undef );
    <web-browser.init_proxy> = 0;

    <[base.log]>->( $log_level, "http proxy disabled" );
}

