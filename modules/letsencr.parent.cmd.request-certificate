## [:< ##

# name  = letsencr.parent.cmd.request-certificate
# descr = Request new SSL certificate from Let's Encrypt for domain[s]

## Extract domain from call structure [call is pre-parsed from headers]
#
my $domain = $call->{'call_args'}->{'args'} // $call->{'args'};

unless ($domain) {
    return {
        mode => qw| false |,
        data => 'domain name required',
    };
}

<[base.logs]>->( 2, 'request-certificate command received for: %s', $domain );

## Log activity start
<[letsencr.parent.activity_logger]>->(
    'enrollment', $domain, 'pending', 'initiated by user'
);

## Check if certificate already exists for this domain
my $certs = <letsencr.parent.certs>;
if ( $certs->{$domain} && $certs->{$domain}{status} eq 'active' ) {
    my $expires_at = $certs->{$domain}{expires_at};
    <[base.log]>->(
        2, "certificate already exists for $domain [expires: $expires_at]"
    );
    <[letsencr.parent.activity_logger]>->(
        'enrollment', $domain, 'pending',
        'certificate already exists [not requesting new]'
    );

    return {
        mode => qw| true |,
        data => "certificate already exists for '$domain'",
    };
}

## Simple implementation: just request for primary domain
## The child can discover SANs if needed via HTTPd queries
my @domains_to_request = ($domain);

<[base.logs]>->(
    2,
    'requesting certificate for domains: %s',
    join( ', ', @domains_to_request )
);

## Send enrollment command to child process
<[base.log]>->( 2, "sending enrollment command to child for: $domain" );

my $result = <[base.protocol-7.command.send.local]>->(
    {   'command'   => qw| child.request-certificate |,
        'call_args' => {
            'args'  => $domain,
            'param' => {
                'domains' => \@domains_to_request,
                'email'   => <letsencr.admin.email>,
                'attempt' => 1,
            }
        },
        'reply' => {
            'handler' => qw| letsencr.parent.handler_enrollment_reply |,
            'params'  => { 'domain' => $domain, 'attempt' => 1 }
        }
    }
);

if ($result) {
    <[base.log]>->( 2, "enrollment command queued for: $domain" );
    <[letsencr.parent.activity_logger]>->(
        'enrollment', $domain, 'pending', 'queued to child'
    );

    return {
        mode => qw| true |,
        data => "certificate request initiated for '$domain' - processing..",
    };
} else {
    <[base.log]>->( 1, "error: failed to queue enrollment for: $domain" );
    <[letsencr.parent.activity_logger]>->(
        'enrollment', $domain, 'failed', 'failed to queue to child'
    );

    return {
        mode => qw| false |,
        data => sprintf "failed to queue certificate request for '%s'",
        $domain
    };
}

