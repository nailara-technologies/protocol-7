## [:< ##

# name  = kimi.cmd.task-file
# descr = read task file from disk and dispatch to kimi ask-reply
# param = [:next:] <file-path>

my $args       = $call->{'args'} // '';
my $wants_next = $args =~ s{^:next:\s+}{};
my $file_path  = $args;

if ( not length $file_path ) {
    return { 'mode' => 'false', 'data' => 'file parameter expected' };
}

## try relative to repo root, then as absolute/literal path ##
my $resolved;
for my $candidate ( <system.root_path> . '/' . $file_path, $file_path ) {
    if ( -f $candidate and -r $candidate ) {
        $resolved = $candidate;
        last;
    }
}

if ( not defined $resolved ) {
    return {
        'mode' => 'false',
        'data' => sprintf( 'cannot read file [%s]', $file_path )
    };
}

my $file_content = <[file.read]>->($resolved) // '';
if ( not length $file_content ) {
    return {
        'mode' => 'false',
        'data' => sprintf( 'empty or unreadable [%s]', $resolved )
    };
}

<[base.logs]>->(
    1, 'task-file: dispatching %s [ %d bytes%s]',
    $resolved, length($file_content), $wants_next ? ', :next:' : ' '
);

## handle :next: here — reset session first, then dispatch without :next: prefix
## so ask-reply gets a stable ready session rather than a deferred chain
<[kimi.cmd.new-session]> if $wants_next;

my $fwd_call = { %{$call}, 'args' => $file_content };
<[kimi.cmd.ask-reply]>->($fwd_call);
return { 'mode' => qw| deferred | };

