# name  = llm.service.subprocess_wrapper.estimate_tokens
# descr = estimate token count for prompt and answer text
# param = $prompt, $answer

my ( $prompt, $answer ) = @ARG;

my $total_text = $prompt . ' ' . $answer;

# rough estimate: 1 token per 4 characters
return int( length($total_text) / 4 );

