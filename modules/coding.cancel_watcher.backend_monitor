## [:< ##

# name  = coding.cancel_watcher.backend_monitor

my $current_watcher = shift;

<coding.watcher_pair> //= {};
return warn 'watcher not found'
    if not exists <coding.watcher_pair>->{$current_watcher};
my $other_watcher = <coding.watcher_pair>->{$current_watcher};

<[base.log]>->( 1, ':. cancelling backend_monitor watchers' );

$current_watcher->cancel
    if defined $current_watcher
    and $current_watcher->is_active;

$other_watcher->cancel
    if defined $other_watcher
    and $other_watcher->is_active;

## close pipe fds so server doesn't block on stdout/stderr writes ##
## [ pipe buffer fills during inference → server deadlocks on write() ] ##
eval { close( $current_watcher->fd ) } if defined $current_watcher;
eval { close( $other_watcher->fd ) }   if defined $other_watcher;

## clean up pair references to avoid memory accumulation ##
delete <coding.watcher_pair>->{$current_watcher};
delete <coding.watcher_pair>->{$other_watcher}
    if defined $other_watcher;

