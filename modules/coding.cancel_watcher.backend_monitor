# name  = coding.cancel_watcher.backend_monitor

my $current_watcher = shift;

<coding.watcher_pair> //= {};
return warn 'watcher not found'
    if not exists <coding.watcher_pair>->{$current_watcher};
my $other_watcher = <coding.watcher_pair>->{$current_watcher};

<[base.log]>->( 2, ':. cancelling backend_monitor watchers' );

my $current_fd = eval { $current_watcher->fd };
my $other_fd   = eval { $other_watcher->fd };

$current_watcher->cancel
    if defined $current_watcher
    and $current_watcher->is_active;

$other_watcher->cancel
    if defined $other_watcher
    and $other_watcher->is_active;

## replace startup-monitoring watchers with drain watchers            ##
## the server's pipes must stay readable : if the buffer fills [64KB] ##
## llama-server's write() blocks and inference stalls silently        ##
## do NOT close the fds : that sends SIGPIPE to the server            ##
## store watcher refs so spawn_inference_server can cancel on respawn ##
my @drain_watchers;
for my $fd ( grep { defined $_ } $current_fd, $other_fd ) {
    my $dw = <[event.add_io]>->(
        {   'fd'      => $fd,
            'handler' => qw| coding.handler.drain_pipe |,
            'poll'    => qw| r |    ## r only : handler covers EOF + EBADF ##
        }
    );
    push @drain_watchers, $dw if defined $dw;
}

## find which backend these fds belong to and store drain watchers ##
## [ fileno ] comparison : watcher->fd returns the filehandle, not a number ##
my $servers        = <coding.inference_servers> // {};
my $current_fileno = eval { fileno($current_fd) };
for my $backend ( keys %{$servers} ) {
    my $srv = $servers->{$backend};
    my $out = $srv->{'io_stdout'};
    my $err = $srv->{'io_stderr'};
    next unless defined $current_fileno;
    if (   ( defined $out && eval { fileno($out) } == $current_fileno )
        || ( defined $err && eval { fileno($err) } == $current_fileno ) ) {
        $srv->{'watcher_drain_stdout'} = $drain_watchers[0];
        $srv->{'watcher_drain_stderr'} = $drain_watchers[1];
        last;
    }
}

## clean up pair references to avoid memory accumulation ##
delete <coding.watcher_pair>->{$current_watcher};
delete <coding.watcher_pair>->{$other_watcher}
    if defined $other_watcher;

