## [:< ##

# name  = external.orbital.sync_grid_fragment
# descr = sync orbital grid fragment from connected node

my $name = shift // '';
return unless length $name;

my $conn_ref = $data{'external'}{'connections'} // {};
return unless exists $conn_ref->{$name};

## request remote node's orbital list ##
my $sent = eval {
    <[protocol-7.route-send]>->(
        {   'command'   => 'discover.cmd.list-orbital',
            'call_args' => { 'args' => '' },
            'reply'     => {
                'handler' => qw| external.handler.orbital_connect_reply |,
                'params'  => {
                    'name' => $name,
                    'step' => qw| grid_sync |
                }
            }
        }
    );
};

if ( $EVAL_ERROR or not $sent ) {
    <[base.logs]>->( 2, qq| grid fragment request failed for %s |, $name );
    return;
}

<[base.logs]>->( 2, qq| requested grid fragment from %s |, $name );

return TRUE;

