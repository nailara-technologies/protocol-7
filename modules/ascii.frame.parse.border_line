## [:< ##

    # name  = ascii.frame.parse.border_line
    # descr = parse a border line into elements (fills, anchors, slots)

    my $line = shift;
    my @elements;

    ## locate all slots first ##
    my @slot_positions;
    while ( $line =~ m{\{\{(\w+)(\.\.\.)?\}\}}g ) {
        push @slot_positions,
            {
            name  => $1,
            start => $-[0],
            end   => $+[0],
            };
    }

    ## process segments between slots ##
    my $pos = 0;
    for my $sp (@slot_positions) {
        my $segment = substr( $line, $pos, $sp->{'start'} - $pos );
        <[ascii.frame.parse.border_segment]>->( $segment, \@elements );
        push @elements, { type => qw| slot |, name => $sp->{'name'} };
        $pos = $sp->{'end'};
    }
    my $trailing = substr( $line, $pos );
    <[ascii.frame.parse.border_segment]>->( $trailing, \@elements );

    return \@elements;

