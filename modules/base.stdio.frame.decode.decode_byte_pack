# name  = base.stdio.frame.decode.decode_byte_pack
# param = $data_ref  [ arrayref of base-7 digit values, 1-based ]
# descr = decode a byte-pack-encoded data run back into raw bytes

my $data_ref = shift;

my @bytes;
for ( my $j = 0; $j < @$data_ref; $j += 3 ) {
    last if $j + 2 >= @$data_ref;
    my $d0 = $data_ref->[$j] - 1;
    my $d1 = $data_ref->[ $j + 1 ] - 1;
    my $d2 = $data_ref->[ $j + 2 ] - 1;
    push @bytes, $d0 * 49 + $d1 * 7 + $d2;
}

return pack qw| C* |, @bytes;

