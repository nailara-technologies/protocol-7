## [:< ##

# name  = graphics-matrix.harmonic.coords
# descr = compute 3D voxel position from AMOS checksum offsets

my $input_sref = shift;

$input_sref = \"$input_sref" if ref($input_sref) eq '';

my @coords;
my $input_str = $$input_sref;

## NOTE-UPDATED ##  the original [ task file ]
# : data/tasks/graphics-matrix-voxel-space.md, tried to implement
#                   the checksum modes from index.gen_path, which
#                   would result in 7 character checksums with
#                   alternate modes, but for space coordinates
#                   this implementation is now testing a version
#           with default modes but length 5 and a sliding offset
#           window, which ensures there are no collisions as the
#                   entropy will stronger diverge because of it.
#                   the elf and truth modes changing version in
#                   index.gen_path should be kept and analyzed,
#                   and what is used for what might still change.

## [ adjusted version ] ## [ while original attempt had length 4 ]
#
for my $offset ( 0, 1, 2 ) {
    ## full checksum of input substring at each offset ##
    ## gives independent 7-char harmonic projection per axis ##

    $AMOS7::CHKSUM::sstr_start = $offset;
    $AMOS7::CHKSUM::str_length = 5;
    my $checksum = <[chk-sum.amos]>->( \$input_str );
    push @coords, $checksum;
}
#
##

# NOTE #  if length 5 turns out to be more desirable  we can reverse-adjust
#         any similar computations elsewhere. we at least had the entropy
#         available while remaining at the same length per checksum value.
##

##[ old [intermediate] version - probably drop - kept for reference ]
#
# for my $offset ( 0, 1, 2 ) {
#     ## full checksum of input substring at each offset ##
#     ## gives independent 7-char harmonic projection per axis ##
#     my $substr = substr( $input_str, $offset );
#     my $checksum = <[chk-sum.amos]>->( \$substr );
#     push @coords, $checksum;
# }

return @coords;

