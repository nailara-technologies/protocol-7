## [:< ##

# name  = letsencrypt.parent.handler_enrollment_retry
# descr = Retry handler for failed certificate enrollment with exponential backoff

my $data = shift;

my $domain  = $data->{domain};
my $attempt = $data->{attempt} // 1;

<[base.log]>->(
    2, "retrying certificate enrollment for $domain (attempt $attempt)"
);

<[letsencrypt.parent.activity_logger]>->(
    'enrollment', $domain, 'pending', "retry attempt $attempt"
);

## Send enrollment command to child process
my $request_cmd = 'letsencrypt.child.cmd.request-certificate ' . $domain;

my $result = <[base.protocol-7.command.send.local]>->(
    {   'command'   => $request_cmd,
        'call_args' => {
            'args'  => $domain,
            'param' => {
                'email'   => <letsencrypt.admin.email>,
                'attempt' => $attempt,
            }
        },
        'reply' => {
            'handler' => 'letsencrypt.parent.handler_enrollment_reply',
            'params'  => { 'domain' => $domain, 'attempt' => $attempt }
        }
    }
);

if ($result) {
    <[base.log]>->( 2, "enrollment retry queued for: $domain" );
} else {
    <[base.log]>->(
        1, "failed to queue enrollment retry for: $domain (attempt $attempt)"
    );
    <[letsencrypt.parent.activity_logger]>->(
        'enrollment', $domain, 'failed',
        "failed to queue retry attempt $attempt"
    );
}

return 0;

