## [:< ##

# name  = context.diff.find_resync
# descr = find how many lines to skip to resync diff alignment

my $params = shift // {};

my $in_ref  = $params->{'in'}  // [];
my $i       = $params->{'i'}   // 0;
my $out_ref = $params->{'out'} // [];
my $j       = $params->{'j'}   // 0;

for my $skip ( 1 .. 3 ) {
    return $skip
        if $i + $skip < @$in_ref
        and $j + $skip < @$out_ref
        and $in_ref->[ $i + $skip ] eq $out_ref->[ $j + $skip ];
}
return 0;

