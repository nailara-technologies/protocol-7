## [:< ##

# name  = models.handler.task-poll
# descr = poll task queue for pending tasks and route to model backends

## guard: only one task in flight at a time
return if defined <models.task.active_id>;

<[base.log]>->( 3, ': task poll: checking for pending tasks' );

## query pending tasks via cube routing
my $sent = <[protocol-7.route-send]>->(
    {   'command'   => 'task.queue',
        'call_args' => { 'args' => 'status=pending' },
        'reply'     => {
            'handler' => 'models.handler.task-poll-step',
            'params'  => { 'step' => 'list' }
        }
    }
);

if ( $sent <= 0 ) {
    <[base.log]>->( 3, ': task poll: task zenka not reachable' );
}

return;

