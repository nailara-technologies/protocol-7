# name  = pager.util.encode.format_display
# descr = Format encoded item for display output

my ($encoded) = @ARG;

my $type = $encoded->{'type'};
my $d13  = $encoded->{'d13_state'};

return sprintf(
    "[%s] %s | 42:%s | 7:%s | 15:%s",
    $type,
    $encoded->{'item'}{'name'} // $encoded->{'item'}{'checksum'} // '?',
    substr( $d13->{'main_42'}, 0, 8 ) . '...',
    $d13->{'decoded'},
    $d13->{'aux_15'}
);

