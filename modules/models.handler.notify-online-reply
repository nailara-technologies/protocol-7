# name  = models.handler.notify-online-reply
# descr = dispatch task prompt after backend zenka confirmed online

my $reply = shift;

my $reply_params = $reply->{'params'} // {};
my $task_id      = $reply_params->{'task_id'}    // '';
my $model        = $reply_params->{'model'}      // '';
my $job_id       = $reply_params->{'job_id'}     // '';
my $target_cmd   = $reply_params->{'target_cmd'} // '';
my $encoded      = $reply_params->{'encoded'}    // '';

my $mode = $reply->{'mode'} // '';

if ( $mode eq qw| false | ) {
    my $reason = $reply->{'data'} // 'unknown';
    <[base.logs]>->(
        0, ': task %s: backend not available [ %s ]',
        $task_id, $reason
    );
    <[protocol-7.route-send]>->(
        {   'command'   => 'task.fail',
            'call_args' =>
                { 'args' => "$task_id backend $target_cmd not available" }
        }
    );
    <models.task.active_id>  = undef;
    <models.task.active_job> = undef;
    <[jobqueue.move_job]>->( $job_id, qw| error | );
    return;
}

## backend zenka is online : dispatch prompt
<[base.logs]>->(
    2, ': task %s: %s online : dispatching prompt',
    $task_id, $target_cmd
);

my $sent = <[protocol-7.route-send]>->(
    {   'command'   => $target_cmd,
        'call_args' => { 'args' => $encoded },
        'reply'     => {
            'handler' => 'models.handler.task-result',
            'params'  => {
                'task_id' => $task_id,
                'model'   => $model,
                'job_id'  => $job_id
            }
        }
    }
);

if ( $sent <= 0 ) {
    <[base.logs]>->(
        0, ': task %s: %s route failed after online [ job %s ]',
        $task_id, $target_cmd, $job_id
    );
    <[protocol-7.route-send]>->(
        {   'command'   => 'task.fail',
            'call_args' =>
                { 'args' => "$task_id route to $target_cmd failed" }
        }
    );
    <models.task.active_id>  = undef;
    <models.task.active_job> = undef;
    <[jobqueue.move_job]>->( $job_id, qw| error | );
}

