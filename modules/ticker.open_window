## [:< ##

# name = ticker.open_window

<[base.log]>->( 1, ': opening ticker window.,' );

$ENV{'DISPLAY'}     = <x11.display>;
$ENV{'GDK_BACKEND'} = 'x11';           ## force XWayland under WSL/Wayland ##
delete $ENV{'WAYLAND_DISPLAY'};
Gtk3->init;

<ticker.is-iconified> //= FALSE;

my $window_mode = <ticker.window.force_above> ? qw|popup| : qw|toplevel|;
my $is_popup    = $window_mode eq qw| popup |;

my $window = <ticker.obj.window> = Gtk3::Window->new($window_mode);

$window->signal_connect( delete_event => sub { Gtk3->main_quit } );

if ( $window->is_composited ) {
    <ticker.is_composited> = TRUE;
    <[base.log]>->( 1, ': : compositor detected =)' );
    $window->set_opacity(0)
        if <ticker.use_transparency> and <ticker.do_custom_fade_in>;
} else {
    <ticker.is_composited> = FALSE;
    <[base.log]>->( 1, ': : no compositor running :|' );
}

## apply window placement profile ##
## in swap mode this also constrains the ticker to the selected monitor,    ##
## so use the shared profile helper instead of duplicating the logic here.   ##
<[ticker.cmd.set-window-profile]>->( { 'args' => <ticker.window.profile> } );

## detect when the monitor the ticker is on disappears (e.g. beamer switched  ##
## off) and move it to the next available monitor automatically.             ##
my $display = Gtk3::Gdk::Display::get_default;
if ( defined $display and <[base.cfg_bool]>->(<ticker.mouse.swap_edge>) ) {
    $display->signal_connect(
        'monitor-removed' => sub {
            my ( undef, $monitor ) = @ARG;
            return if not defined $monitor;

            my $mgeo = eval { $monitor->get_geometry };
            return if not defined $mgeo;
            my ( $mx, $my )
                = ref($mgeo) eq qw| HASH |
                ? @$mgeo{qw| x y |}
                : ( $mgeo->x, $mgeo->y );

            return
                if not defined <x11.coordinates.left>
                or not defined <x11.coordinates.top>;

            my $tol = 5;
            if (    abs( <x11.coordinates.left> - $mx ) <= $tol
                and abs( <x11.coordinates.top> - $my ) <= $tol ) {
                <[base.log]>->(
                    1,
                    ': current monitor removed, moving ticker to next monitor'
                );
                <[ticker.cmd.set-window-profile]>
                    ->( { 'args' => <ticker.window.profile> } );
            }
        }
    );
}

my $geo = {
    'width'  => <x11.window.width>,
    'height' => <x11.window.height>,
    'x'      => <x11.coordinates.left>,
    'y'      => <x11.coordinates.top>
};

<[ticker.load_font_offsets_table]>;    ## <--  uses window-height ##

$window->set_title(<x11.title_str>);
$window->set_border_width(0);
$window->set_decorated(0);
$window->set_keep_above(1) if <ticker.window.force_above>;
$window->set_app_paintable(1);
$window->set_accept_focus(0);
$window->set_focus_on_map(0);
$window->set_can_focus(0);
$window->set_skip_taskbar_hint(1);

## dock type hint makes WSLg/Weston take over positioning and ignore client   ##
## moves; override-redirect popup windows must not carry it.                  ##
$window->set_type_hint('dock')
    if not $is_popup;    ## don't steal focus/taskbar entry ##

## mouse-avoidance: fade out + lower on hover, raise + fade in on leave ##
<ticker.mouse.avoid>  //= TRUE;
<ticker.mouse.inside> //= FALSE;
$window->add_events( [qw| enter-notify-mask leave-notify-mask |] );

my $start_fade = sub {
    my ($handler) = @ARG;
    return if not <ticker.use_transparency> or not <ticker.do_custom_fade_in>;
    <ticker.timer.fade>->cancel if defined <ticker.timer.fade>;
    delete <ticker.time.fade_view>
        ;    ## reset time, keep opacity for smooth switch ##
    <ticker.timer.fade> = <[event.add_timer]>->(
        {   'after'    => 0,
            'interval' => 0.017,
            'handler'  => $handler
        }
    );
};

$window->signal_connect(
    'enter-notify-event' => sub {
        my ( undef, $event ) = @ARG;
        return FALSE if not <ticker.mouse.avoid>;
        return FALSE if <ticker.mouse.inside>;
        return FALSE
            if defined $event
            and $event->detail =~ /^(inferior|virtual|nonlinear-virtual)$/;
        if ( defined <ticker.mouse.grace_until>
            and <[base.time]>->(5) < <ticker.mouse.grace_until> ) {
            return FALSE;
        }
        <ticker.mouse.inside> = TRUE;
        delete <ticker.mouse.leave_pending_until>;
        <[base.log]>->( 1, ': mouse entered ticker window, fading out' );
        if ( <ticker.use_transparency> and <ticker.do_custom_fade_in> ) {
            $start_fade->(qw| ticker.handler.fade_out |);
        } elsif ( defined <x11.id> ) {
            <[base.X-11.keep_below]>->(<x11.id>);
        }
        return FALSE;
    }
);
$window->signal_connect(
    'leave-notify-event' => sub {
        my ( undef, $event ) = @ARG;
        return FALSE if not <ticker.mouse.avoid>;
        return FALSE if not <ticker.mouse.inside>;
        return FALSE
            if defined $event
            and $event->detail =~ /^(inferior|virtual|nonlinear-virtual)$/;
        <ticker.mouse.inside>              = FALSE;
        <ticker.mouse.leave_pending_until> = <[base.time]>->(5) + 0.3;
        <[base.log]>->(
            1, ': mouse left ticker window, fade-in delayed 300ms'
        );
        return FALSE;
    }
);

my $screen = $window->get_screen;

my $rgba = FALSE;
$rgba = $screen->get_rgba_visual() if <ticker.use_transparency>;

if ( not $rgba ) {
    <ticker.use_transparency> = FALSE;
} else {
    $window->set_visual($rgba);
}

## $window->signal_connect( 'draw' => $code{'ticker.callback.draw'} );

$window->signal_connect(
    qw| draw | => sub {
        eval { <[ticker.callback.draw]>->(@ARG) };
        if ( length $EVAL_ERROR ) {
            <[base.log]>->( 0, <[base.str.eval_error]>->(1) );
            <[base.sleep]>->(0.07);
        }
    }
);

my $map_assigned = 0;
$window->signal_connect(
    qw| map | => sub {
        return FALSE if $map_assigned++;
        <[base.log]>->( 1, ': ticker window mapped, assigning X11 id' );
        <x11.id> = $window->get_toplevel()->get_window()->get_xid();
        <[base.X-11.assign_window]>;

        return FALSE;
    }
);

## keep input shape in sync with the actual window size. under Wayland the ##
## allocation at map time can differ from the final compositor placement, ##
## so we refresh the shape on every resize/configure. ##
my $update_input_shape = sub {
    eval {
        return if not $window->get_realized;

        ## get_allocation can return an unblessed hash ref on some Gtk3/Perl ##
        ## versions, so access width/height defensively.                     ##
        my $alloc = $window->get_allocation;
        my ( $alloc_w, $alloc_h )
            = ref($alloc) eq qw| HASH |
            ? ( $alloc->{'width'}, $alloc->{'height'} )
            : ( $alloc->width, $alloc->height );

        return if $alloc_w <= 1 or $alloc_h <= 1;

        return
            if not defined <x11.coordinates.left>
            or not defined <x11.window.width>;

        ## set input shape to the full allocation. on Wayland            ##
        ## gtk_window_get_position returns (0,0), so a position-relative ##
        ## clip would end up empty. the log shows the allocation already ##
        ## matches the intended ticker geometry, so full-window input     ##
        ## shape is correct here.                                        ##
        my $shape_w = $alloc_w;
        my $shape_h = $alloc_h;

        return if $shape_w <= 1 or $shape_h <= 1;

        my $region = Cairo::Region->create(
            {   x      => 0,
                y      => 0,
                width  => $shape_w,
                height => $shape_h
            }
        );
        $window->input_shape_combine_region($region);

        <[base.logs]>->(
            2,        ': updated input shape: w=%d h=%d',
            $shape_w, $shape_h
        );
    };
    <[base.log]>->( 0, ': input shape update failed: ' . $EVAL_ERROR )
        if length $EVAL_ERROR;
    return FALSE;
};
$window->signal_connect( 'configure-event' => $update_input_shape );
$window->signal_connect( 'size-allocate'   => $update_input_shape );

$window->show_all;

## set initial input shape once allocation is known ##
Glib::Idle->add($update_input_shape);

## poll-based hover detection because WSLg/XWayland enter/leave events ##
## are unreliable for transparent dock windows ##
<ticker.timer.pointer_check> //= <[event.add_timer]>->(
    {   'after'    => 0.1,
        'interval' => 0.1,
        'handler'  => qw| ticker.handler.check_pointer |
    }
);

<ticker.font.size> = 0;

my $font_name = <ticker.font.name>;
my $font_path = sprintf qw| %s/%s.ttf |, <ticker.font.path>, $font_name;
my $freetype  = Font::FreeType->new;
my $ft_face   = $freetype->face($font_path);
<ticker.font.face> = Cairo::FtFontFace->create($ft_face);

<ticker.obj.window>->queue_draw;

