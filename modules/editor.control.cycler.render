## [:< ##

# name  = editor.control.cycler.render
# descr = draw an inline cycler's choice set on a CONSTANT grid
# param = $choices_aref [ , $current_index ]

## the drawn form of an inline cycler [ editor.control.cycler.set ], factored
## out of editor.control.get_display_value because the WIDTH of this row is
## reserved ahead of time by user-edit.form.build_frame -- which has to render
## the full vocabulary to know how wide the row can ever get, and must not
## re-implement the layout to do it.
##
## '[choice]' was tried first, matching the focus-bracket rule
## editor.ui.ascii_frame.render_form applies elsewhere : brackets when
## current, matching spaces when not.  dropped -- this row's own frame ALSO
## brackets it when the row has focus, so a focused cycler nested '[ [shell] |
## timezone ]', a doubled bracket that reads as a typo rather than as
## selection.  '+choice+' marks the current one instead, leaving '[ ]' meaning
## exactly one thing on screen : the outer frame's own focus marker.  '+' also
## still reads as "add" for the row as a whole, so no prefix word is spent on
## that either.
##
## CONSTANT GRID, restored : an EARLIER version of this line let the '+'-pair
## add two columns on top of a bare, unpadded choice, so only the currently
## marked choice paid for its marker and everything to its right shifted
## sideways as the marker moved -- exactly the jitter this module's own descr
## warns against.  fixed by giving every choice the same reserved cell
## regardless of state : the '+' does not ADD width, it WRITES INTO the single
## space each choice already carries on both sides when it is not current.
## one cell, one width, always -- '+choice+' and ' choice ' are the same
## length, so nothing to either side ever moves.  the join separator is a bare
## '|' with no space of its own, since the padding living inside each choice's
## own cell already supplies it -- adding a second layer of spacing here is
## what produced the double-space '[shell] |  timezone' the very first version
## had

my ( $choices_aref, $current ) = @ARG;

my @choices
    = grep { defined $ARG and length $ARG } ( $choices_aref // [] )->@*;

return '( none )' if not @choices;

$current //= 0;
$current = 0 if $current < 0 or $current > $#choices;

return join( q{|},
    map { sprintf( $ARG == $current ? '+%s+' : ' %s ', $choices[$ARG] ) }
        0 .. $#choices );

