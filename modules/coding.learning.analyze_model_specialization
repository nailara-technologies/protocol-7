# name = coding.learning.analyze_model_specialization
# descr = analyze specialization of different language models
# purpose = learning : determine which models excel at specific tasks

my @models = qw( qwen mathstral aya );

my %specialization = ();

foreach my $model (@models) {
    $specialization{$model} = {
        model               => $model,
        best_for            => [],
        success_rate        => 0.5,
        avg_response_tokens => 0,
        avg_latency_ms      => 0
    };
}

return {
    success        => TRUE,
    specialization => \%specialization
};

