## [:< ##

# name  = channels.cmd.last-data-timestamp
# descr = query current channel state timestamp [ synchronous ]
# param = [<channel-path>]
# return = { mode => 'timestamp', data => 'BASE32_ENCODED_TIMESTAMP' }

my $args         = $$call{'args'} // '';
my $channel_path = $args;
$channel_path =~ s|^\s+||;    ## trim leading whitespace ##
$channel_path =~ s|\s+$||;    ## trim trailing whitespace ##

my $current_time   = <[base.time]>->(3);  ## unix timestamp with subseconds ##
my $current_ts_b32 = encode_b32r( pack( 'Q>', int($current_time) ) );

##  If no specific channel requested, return global timestamp  ##
unless ( length $channel_path ) {
    ##  Return single timestamp for entire remote  ##
    return {
        'mode' => qw| timestamp |,
        'data' => $current_ts_b32
    };
}

##  Validate channel path syntax  ##
##  Absolute syntax: /channel.name (single key only)  ##
##  Implicit tree: channel.name (includes subtree)  ##

my $is_absolute = $channel_path =~ m|^/|;
$channel_path =~ s|^/||;    ## strip leading / for processing ##

##  For now, return same timestamp regardless of path  ##
##  (Route-dependent dedup happens at routing layer)  ##

return {
    'mode' => qw| timestamp |,
    'data' => $current_ts_b32
};

1;

