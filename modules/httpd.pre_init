## [:< ##

# name = httpd.pre_init
# descr = pre-init setup for HTTP server module

<[base.log]>->( 2, "Loading HTTP server module dependencies..." );

# Load required Perl modules
<[base.perlmod.autoload]>->('JSON::XS');
<[base.perlmod.autoload]>->('IO::Socket');
<[base.perlmod.autoload]>->('POSIX');
<[base.perlmod.autoload]>->('Fcntl');

return 0;
