## [:< ##

# name  = base.vax-int.decode
# descr = decode a VAX base32 job id back to numeric; pass non-encoded through

my $id = shift // '';

return $id if not length $id;
return $id if $id =~ m|^\d+$|;          ## already numeric ##
return $id if $id !~ qr|^[A-Z2-7]+$|;
return $id if length($id) > 7;

## all-'A' strings represent zero value(s) ##
return 0 if $id =~ m|^A+$|;

## the encoder strips trailing 'A' padding; restore a full 8-char base32 ##
## block so decode_b32r can handle short encoded ids consistently        ##
my $padded_id = $id . ( qw| A | x ( 8 - length($id) ) );

my $decoded_bytes = <[base32.decode]>->($padded_id);
return $id if not defined $decoded_bytes;

## keep the low 32 bits; any extra bytes came from the restored padding ##
$decoded_bytes = substr( $decoded_bytes, 0, 4 );

## trailing 'A' chars were stripped by the encoder to shorten the string;   ##
## they represent zero bytes, so pad the decoded bytes back to 32-bit width ##
$decoded_bytes .= "\0" x ( 4 - length($decoded_bytes) )
    if length($decoded_bytes) < 4;

my $decoded = eval { unpack qw| V |, $decoded_bytes };
return $id if not defined $decoded;

return $decoded;

