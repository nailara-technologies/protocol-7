## [:< ##

# name = models.registry.update_entry
# descr = Update registry entry for a model

sub update_model_entry {
  my ($model_amos, $entry_data) = @_;
  my $base = <[models.registry.base]>;
  my $registry = $base->{get_registry}->();

  $registry->{models}->{$model_amos} = {
    %{$registry->{models}->{$model_amos} // {}},
    %$entry_data,
  };

  $base->{save_registry_internal}->();
  return 1;
}

# Entry point
{
  my @args = @ARG;
  return update_model_entry(@args);
};

