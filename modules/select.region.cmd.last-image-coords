## [:< ##

# name  = select.region.cmd.last-image-coords
# param = [name]
# descr = return last screenshot rect by name or all

my $args = $call->{'args'} // '';

## optional positional name ##
my $name   = '';
my @tokens = split m|\s+|, $args;
foreach my $token (@tokens) {
    $name = $token if length $token;
}

my $last;
if ( length $name ) {
    $last = $data{select}{region}{last_image_coords}{'by_name'}{$name};
} else {
    $last = $data{select}{region}{last_image_coords}{'global'};
}

if ( not defined $last ) {
    return {
        'mode' => qw| false |,
        'data' => 'no image coordinates available'
    };
}

my ( $x, $y, $w, $h ) = @{$last}{qw| x y width height |};

my $reply_data = sprintf 'x=%d y=%d width=%d height=%d', $x, $y, $w, $h;
$reply_data .= " name=$name" if length $name;

return { 'mode' => qw| true |, 'data' => $reply_data };

