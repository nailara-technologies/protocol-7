## [:< ##

# name  = coding.abort.lookup
# descr = load a registered abort-pattern by checksum id

my $c_sum = shift // '';
return undef unless length $c_sum;

my $content_sref = <[file.zenka_dir.load]>
    ->( "abort-patterns/$c_sum", ':encoding(UTF-8)' );

return undef unless defined $content_sref;

return $content_sref->$*;

