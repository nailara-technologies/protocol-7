## [:< ##

# name  = jobsite.handler.task-created
# descr = receive task id, register wait-done watcher

my $call = shift // {};

my $mode    = $call->{'mode'} // '';
my $raw     = $call->{'data'} // '';
my $task_id = ref $raw ? $raw->$* : $raw;
my $job_id  = $call->{'params'}{'job_id'} // '';

if ( lc($mode) eq qw| false | ) {
    <[base.logs]>->(
        0,       'jss.task-created: failed for job %s: %s',
        $job_id, $task_id
    );
    <jobsite.pending_count>--;
    <[jobsite.dispatch.next]>;    ## continue with next job
    return;
}

$task_id = uc( substr( $task_id, 0, 7 ) );
<[base.logs]>->( 1, 'job %s → task %s', $job_id, $task_id );

<jobsite.tasks>->{$job_id}{'task_id'} = $task_id;
<jobsite.tasks>->{$job_id}{'stage'}   = 'assessing';
<[jobsite.state.persist]>;

## deferred watcher : fires when task.complete or task.fail is called
## next dispatch happens in assess-done to keep one task in flight at a time
<[protocol-7.route-send]>->(
    {   'command'   => 'task.wait-done',
        'call_args' => { 'args' => $task_id },
        'reply'     => {
            'handler' => 'jobsite.handler.assess-done',
            'params'  => { 'job_id' => $job_id, 'task_id' => $task_id },
        },
    }
);

