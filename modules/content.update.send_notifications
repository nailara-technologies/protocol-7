## [:< ##

# name  = content.update.send_notifications

my $update_cmd = shift // qw| playlist-update |;

my $count = 0;
map {
    ## [LLL] implement zenka name syntax check [base.regex?] ##
    ## sending only when zenka is already present !! ## [LLL] make cofigurable
    ##
    <[protocol-7.route-send]>->(
        { 'command' => join ' ', qw| when-present |, $ARG, $update_cmd } );
    $count++;
} split( m| +|, <update.notify_zenki> );

if (<content.content_changed>) {
    <[protocol-7.command.send.local]>->(
        {   'command'   => qw| cube.notify.msg_reload |,
            'call_args' =>    ## implement base.squote routine ##
                { 'args' => "'" . <locales.string.playlist_updated> . "'" }
        }
    ) if <content.cfg.change_notifications>;
    <content.content_changed> = 0;
}

return $count;

