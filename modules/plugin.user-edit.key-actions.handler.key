## [:< ##

# name  = plugin.user-edit.key-actions.handler.key
# descr = key-actions tab key handling -- enter opens the in-frame key prompt
# param = $editor_state, $field, $key

## claims exactly ONE trigger key, Enter, for "create a new key".  Enter is
## free to use here : <user-edit.form.submit_on> = 'enter' only governs
## editor.control.process_key's NORMAL dispatch, and user-edit.handler.
## stdin_key's plugin-mode block routes EVERY key directly to this sub once
## the field is entered, bypassing process_key entirely [ confirmed against
## that block : it ends in 'next' for every key, so Enter can never fall
## through to a form submit from here ].
##
## Enter opens the IN-FRAME prompt chain [ editor.control.prompt.* -- name,
## then masked passphrase, both rendered into THIS field's own row ].  the old
## shape -- set <user-edit.pending.key_create>, Event::unloop(), run blocking
## terminal prompts outside the loop -- is retired : nothing in this flow
## leaves the event loop any more, so no unloop, no pending flag, no
## check_pending_excursions resume site.  while a prompt is open every key [
## including Ctrl-C, which the prompt claims as prompt-cancel rather than
## letting it reach stdin_key's signal branch -> form.quit ] is simply
## delegated to editor.control.prompt.handler.key.
##
## Left declines with FALSE when no prompt is open -- the 'no further left to
## go' convention stdin_key's plugin-mode Left branch reads as its signal to
## LEAVE plugin mode.  every other key is swallowed as a handled no-op : this
## tab edits no text of its own.
##
## reentrancy note : crypt.C25519.gen_keys [ reached from the passphrase
## stage's submit ] re-pumps the event loop while generating, so a keypress
## can re-enter THIS handler mid-submit.  the guard for that window lives on
## the prompt itself [ $editor_state->{'prompt'}{'busy'}, set by prompt.
## handler.key around every submit callback ] -- it replaced the global
## <user-edit.key_actions.busy> flag the retired excursion shape needed.

my ( $editor_state, $field, $key ) = @ARG;

return undef if ref $editor_state ne qw| HASH |;

## prompt open : every key belongs to it [ modal -- see header ] ##
if ( ref $editor_state->{'prompt'} eq qw| HASH | ) {

    my $result
        = <[editor.control.prompt.handler.key]>->( $editor_state, $key );

    if ( defined $result and $result eq qw| cancelled | ) {

        ## cancel backs out of the prompt AND of this tab's entered state,
        ## back to the focused-but-un-entered row [ same relabel + readonly
        ## restore stdin_key's Left branch and user-edit.form.escape's plugin
        ## branch do ] -- 'cancel the PROMPT only', never the form
        $editor_state->{'mode'} = qw| insert |;
        $editor_state->{'fields'}{$field}{'readonly'} = TRUE
            if ref $editor_state->{'fields'}{$field} eq qw| HASH |;
    }

    return TRUE;
}

if ( $key eq "\e[D" or $key eq "\x1b[D" ) {    ## Left : leave plugin mode ##
    return FALSE;
}

if ( $key eq "\n" or $key eq "\r" ) {    ## Enter : create a new key ##

    <[editor.control.prompt.open]>->(
        $editor_state,
        {   qw| field |     => qw| key_actions |,
            qw| label |     => q| new key name [ esc : cancel ] |,
            qw| type |      => qw| freeform_line |,
            qw| on_submit | => qw| user-edit.key_actions.submit_name |,
        }
    );
    return TRUE;
}

return TRUE;    ## every other key : claimed, no-op ##

