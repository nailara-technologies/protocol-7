## [:< ##

# name  = plugin.user-edit.key-actions.handler.key
# descr = key-actions tab key handling -- enter triggers key-create excursion
# param = $editor_state, $field, $key

## claims exactly ONE trigger key, Enter, for "create a new key".  Enter is
## free to use here : <user-edit.form.submit_on> = 'enter' only governs
## editor.control.process_key's NORMAL dispatch, and user-edit.handler.
## stdin_key's plugin-mode block routes EVERY key directly to this sub once
## the field is entered, bypassing process_key entirely [ confirmed against
## that block : it ends in 'next' for every key, so Enter can never fall
## through to a form submit from here ].
##
## on the trigger key : set <user-edit.pending.key_create>, then
## Event::unloop() -- the same "set flag, unloop, let the resumer check it"
## contract <user-edit.pending.create> already establishes [ user-edit.
## handler.value_get_reply ].  the resumer is user-edit.
## check_pending_excursions, called after BOTH <[base.zenka.loop]> sites an
## unloop can wake up in [ console.start's and offer_create's ] -- the
## blocking terminal work must never run inside this io-watcher callback.
## Event::unloop() THROWS rather than returning, so nothing below it runs.
##
## Left declines with FALSE -- the 'no further left to go' convention plugin.
## user-edit.key-details.handler.key documents -- which stdin_key's plugin-
## mode Left branch reads as its signal to LEAVE plugin mode.  every other key
## is swallowed as a handled no-op : this tab edits no text.

my ( $editor_state, $field, $key ) = @ARG;

return undef if ref $editor_state ne qw| HASH |;

if ( $key eq "\e[D" or $key eq "\x1b[D" ) {    ## Left : leave plugin mode ##
    return FALSE;
}

if ( $key eq "\n" or $key eq "\r" ) {    ## Enter : create a new key ##

    ## the excursion prompts with blocking terminal reads ; without a real
    ## terminal there is nothing safe to unloop INTO [ see user-edit.
    ## excursion.key_create's own no-tty note ], so decline in place
    if ( not -t STDIN or <user-edit.mode.no_tty_debug> ) {
        <user-edit.key_actions.last_result>
            = 'key create needs a real terminal, nothing created';
        return TRUE;
    }

    ## REENTRANCY GUARD, found live 2026-08-16 : crypt.C25519.gen_keys's own
    ## harmonic-truth retry loop briefly re-pumps Event [ base.event.once is a
    ## real Event::loop() call, not a sleep -- see user-edit.
    ## check_pending_excursions' own header for the full account ], which can
    ## dispatch this very handler AGAIN while a create is still in flight.
    ## <user-edit.key_actions.busy> is set only around that window -- swallow
    ## the keypress here instead of arming a second Event::unloop()
    if (<user-edit.key_actions.busy>) {
        return TRUE;
    }

    <user-edit.pending.key_create> = TRUE;
    Event::unloop();
    return TRUE;    ## unreached : unloop unwinds out of the event loop ##
}

return TRUE;        ## every other key : claimed, no-op ##

