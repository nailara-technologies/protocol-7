# name  = letsencrypt.child.acme_get_authorization
# descr = Fetch authorization from ACME server and extract challenges

use JSON::XS;

my $auth_url = shift;

return undef unless $auth_url;

<[base.log]>->( 2, "fetching authorization from $auth_url" );

## Get fresh nonce
my $nonce = <[letsencrypt.child.get_fresh_nonce]>->();
unless ($nonce) {
    <[base.log]>->( 1, 'error: failed to get fresh nonce' );
    return undef;
}

## Make authenticated GET request
my $response = <[letsencrypt.child.acme_http_request]>->(
    'POST',    # RFC 8555 requires POST-as-GET (POST with empty payload)
    $auth_url,
    '',        # empty payload for POST-as-GET
    $nonce,
    <letsencrypt.child.acme_client> {account_url}
);

unless ($response) {
    <[base.log]>->( 1, 'error: authorization request failed' );
    return undef;
}

unless ( $response->{status} == 200 ) {
    <[base.log]>->(
        1, "error: authorization request returned status $response->{status}"
    );
    return undef;
}

## Extract authorization data
my $auth_data  = $response->{data};
my $identifier = $auth_data->{identifier};
my $challenges = $auth_data->{challenges};

unless ( $identifier && $challenges && @$challenges ) {
    <[base.log]>->( 1, 'error: invalid authorization response' );
    return undef;
}

<[base.log]>->( 2, "authorization fetched for $identifier->{value}" );
<[base.log]>->( 2, "  status: $auth_data->{status}" );
<[base.log]>->( 2, "  challenges: " . scalar(@$challenges) );

## Find HTTP-01 challenge
my $http01_challenge;
foreach my $challenge (@$challenges) {
    if ( $challenge->{type} eq 'http-01' ) {
        $http01_challenge = $challenge;
        last;
    }
}

unless ($http01_challenge) {
    <[base.log]>->( 1, 'error: no http-01 challenge in authorization' );
    return undef;
}

## Update nonce
<letsencrypt.child.acme_client> {nonce} = $response->{nonce};

return {
    status     => $auth_data->{status},
    identifier => $identifier,
    challenges => $challenges,
    http01     => $http01_challenge,
    wildcard   => $auth_data->{wildcard} // 0,
};

