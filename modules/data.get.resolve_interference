# name = data.get.resolve_interference
# desc: Resolve interference pattern matches

my ( $path, $args, $classification ) = @ARG;
my $handler = $classification->{'handler'};

my $result = <[devmod.cmd.get]>->( $handler, @$args );

return {
    'value'        => $result,
    'handler'      => $handler,
    'original'     => $classification->{'original'},
    'confidence'   => $classification->{'match_conf'},
    'interference' => 1,
};

