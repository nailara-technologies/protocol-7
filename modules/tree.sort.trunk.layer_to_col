## [:< ##

# name = tree.sort.trunk.layer_to_col
# descr = map a trunk layer name to its column index

my $layer = shift;
my %map   = (
    qw| task     | => 0,
    qw| template | => 1,
    qw| design   | => 2,
    qw| intent   | => 3,
    qw| address  | => 4,
);
return $map{$layer};

