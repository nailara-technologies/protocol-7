## [:< ##

# name = nshell.shell_loop
# descr = Terminal pass-through relay loop

## After authentication, nshell operates in transparent pass-through mode:
##   STDIN/keyboard → session input buffer → [cube/shell processes]
##   [cube output] → session output buffer → STDOUT/terminal
##
## History, cooked mode, line editing: handled on session side (cube)
## nshell just relays raw bytes in both directions

## Get current session (created during authentication)
my $session_id = <system.session_id>;
return 0 unless defined $session_id;

my $session = $data{'session'}{$session_id};
return 0 unless defined $session;

## Get session I/O buffers (already set up by auth handlers)
my $input_buf  = \$session->{'buffer'}->{'input'};
my $output_buf = \$session->{'buffer'}->{'output'};

return 0 unless defined $input_buf && defined $output_buf;

## Read one keystroke from terminal
my $key = <[nshell.read_from_buffer]>;

if ( defined $key ) {
    ## Relay keystroke to session input buffer
    ## (session and connected shell will process it)
    ${$input_buf} .= $key;
}

## Check if session has output for us
if ( defined ${$output_buf} && length ${$output_buf} ) {
    my $output = ${$output_buf};
    ${$output_buf} = '';  ## Clear after reading

    ## Relay session output to terminal
    <[nshell.write_to_buffer]>->($output);
}

return 0;

