## [:< ##

# name = nshell.shell_loop
# descr = Main nshell command processing loop

## This module runs as part of zenka.loop
## Reads keyboard input from STDIN, processes commands, writes output to STDOUT
## Uses simple TTY I/O (future: migrate to amos-term buffer for distributed consensus)

use AMOS7::TERM;

my $buffer_id = <nshell.buffer_id>;
my $history   = <nshell.command_history> //= [];

## Display prompt
my $prompt = sprintf '%s [nshell]: ', ( <nshell.prompt_newline> ? "\n" : '' );
print $prompt;
$| = 1;  ## Flush stdout

## Try to read command
my $cmd_input = <[nshell.read_from_buffer]>;

return 0 unless defined $cmd_input && length($cmd_input);

## Add to history (keep last N commands)
push( @{$history}, $cmd_input );
splice( @{$history}, 0, @{$history} - <nshell.history_size> )
    if @{$history} > <nshell.history_size>;

## Handle local commands (prefix with .)
if ( $cmd_input =~ m|^\.(.+)$| ) {
    ## Local shell command execution
    my $shell_cmd = $1;
    my $result    = qx| $shell_cmd 2>&1 |;
    <[nshell.write_to_buffer]>->($result);
    return 0;
}

## Handle special commands
if ( $cmd_input eq '[quit]' || $cmd_input eq 'exit' ) {
    <[nshell.write_to_buffer]>->("session terminated\n");
    <[base.exit]>->(0);
    return 0;
}

if ( $cmd_input eq '[reset]' ) {
    system(qw| clear |);
    return 0;
}

## Process as Protocol-7 cube command
## Send command and get response
my $cmd_with_newline = $cmd_input . "\n";
my $result           = <[nshell.execute_cube_command]>->($cmd_with_newline);

## Write result to buffer with colors
<[nshell.write_to_buffer]>->($result) if defined $result;

return 0;

