## [:< ##

# name = nshell.shell_loop
# descr = Terminal pass-through relay loop

## After authentication, nshell operates in transparent pass-through mode:
##   STDIN/keyboard → session input buffer → [cube/shell processes]
##   [cube output] → session output buffer → STDOUT/terminal
##
## History, cooked mode, line editing: handled on session side (cube)
## nshell just relays raw bytes in both directions

## Get current session (created during authentication)
my $session_id = <system.session_id>;
return 0 unless defined $session_id;

my $session = $data{'session'}{$session_id};
return 0 unless defined $session;

## Register hooks on first pass (check if already registered)
if ( !<nshell.hooks_registered> ) {
    ## Register input-pre hook to write shell output FROM cube to STDOUT
    ## instead of parsing it as protocol-7 commands
    <[base.handler.hooks]>->(
        'register', $session_id, 'input-pre', 'nshell.hook.input_passthrough'
    );

    <nshell.hooks_registered> = TRUE;
}

## Get session output buffer (for sending STDIN to cube)
my $output_buf = \$session->{'buffer'}->{'output'};
return 0 unless defined $output_buf;

## Read one keystroke from terminal STDIN
my $key = <[nshell.read_from_buffer]>;

if ( defined $key ) {
    ## Send keystroke TO cube (output buffer gets transmitted automatically)
    ${$output_buf} .= $key;
}

## Note: Shell output from cube arrives in input buffer → triggers base.handler.input →
## input-pre hook intercepts and writes to STDOUT → normal protocol handler is skipped

return 0;

