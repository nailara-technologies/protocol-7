## [:< ##

# name  = debian.console.install-deps
# param = [zenka=<name>|minimal]
# descr = install dependencies for zenka or minimal v7 dependencies

my $param = shift;

## Determine what to install
my $install_type;
my $zenka_name;

if ( !defined $param || $param eq 'minimal' || $param eq '' ) {
    $install_type = 'minimal';
} elsif ( $param =~ m/^zenka=(.+)$/ ) {
    $install_type = 'zenka';
    $zenka_name   = $1;
} else {
    ## Try direct zenka name
    $install_type = 'zenka';
    $zenka_name   = $param;
}

<[base.logs]>->(
    1,             "debian.install-deps: type=%s zenka=%s",
    $install_type, $zenka_name // 'N/A'
);

if ( $install_type eq 'minimal' ) {
    ## Install minimal v7 dependencies
    <[base.log]>->( 1, "Installing minimal Protocol-7 dependencies..." );

    my $script
        = '/data/projects/protocol-7/bin/dependencies/'
        . 'install_minimal_dependencies.debian.sh';

    unless ( -f $script ) {
        <[base.log]>
            ->( 0, "Error : Installation script not found : $script" );
        return say "::\n: Installation failed - script not found\n::";
    }

    <[base.log]>->( 1, "Running : $script" );
    <[base.log]>->( 1, "This may take several minutes..." );

    system( 'bash', $script );

    my $exit_code = $? >> 8;

    if ( $exit_code == 0 ) {
        <[base.log]>->( 1, "✓ Minimal dependencies installed successfully" );
        return say "::\n: ✓ Installation complete\n::";
    } else {
        <[base.log]>->(
            0, "✗ Installation failed with exit code: $exit_code"
        );
        return say "::\n: ✗ Installation failed\n::";
    }

} elsif ( $install_type eq 'zenka' ) {
    ## Install dependencies for specific zenka

    unless ( defined $zenka_name && length($zenka_name) > 0 ) {
        <[base.log]>->( 0, "Error : No zenka name specified" );
        return
            say "::\n: Error: zenka name required\n"
            . ": Usage: install-deps <zenka_name>\n::";
    }

    <[base.log]>->( 1, "Installing dependencies for zenka : $zenka_name" );

    ## Check if debian.parent.install_missing exists
    unless ( exists $code{'debian.parent.install_missing'} ) {
        <[base.log]>->( 0, "Error : Dependency installer not available" );
        return
            say "::\n: Error: debian.parent.install_missing not loaded\n::";
    }

    ## Rescan to ensure latest dependency info
    <[debian.parent.scan_zenki_dependencies]>;

    ## Install for zenka
    my $result = <[debian.parent.install_missing]>->(
        {   zenka         => $zenka_name,
            prefer_debian => <debian.cfg.prefer_debian>,
            use_cpanm     => <debian.cfg.use_cpanm>
        }
    );

    if ( $result->{success} ) {
        my $total = ( $result->{installed_debian} || 0 )
            + ( $result->{installed_cpan} || 0 );
        my $failed = ( $result->{failed_debian} || 0 )
            + ( $result->{failed_cpan} || 0 );

        if ( $failed == 0 ) {
            <[base.log]>->(
                1, "✓ Installed $total dependencies successfully"
            );
            return say "::\n: ✓ $total dependencies installed\n::";
        } else {
            <[base.log]>->( 0, "⚠ Installed $total, failed $failed" );
            return say "::\n: ⚠ $total installed, $failed failed\n::";
        }
    } else {
        my $error = $result->{error} || 'unknown error';
        <[base.log]>->( 0, "✗ Installation failed : $error" );
        return say "::\n: ✗ Installation failed: $error\n::";
    }
}

