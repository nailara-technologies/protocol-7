## [:< ##

# name  = X-11.cmd.bg_color
# descr = return the configured background color

return { 'mode' => qw| false |, 'data' => 'not defined' }
    if not defined <X-11.bg_color>;
return { 'mode' => qw| true |, 'data' => <X-11.bg_color> }

