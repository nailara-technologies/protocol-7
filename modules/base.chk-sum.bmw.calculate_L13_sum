# name  = base.chk-sum.bmw.calculate_L13_sum

my $bmw_512_bin = shift // '';

return undef if length $bmw_512_bin != 64;

return <[chk-sum.bmw.harmonize_L13]>->(
    $bmw_512_bin, sub { AMOS7::Assert::Truth::is_true( $ARG[0], 0, 1 ) }
);

