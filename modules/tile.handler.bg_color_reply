# name = tile.handler.bg_color_reply

my $answer = shift;

return warn "unexpected (FALSE) reply from X-11 zenka!"
    if $answer->{'cmd'} ne qw| TRUE |;

<tile.x11_bg_color> = $answer->{'call_args'}->{'args'};

<[base.log]>->(
    1, " : received X-11 background color '" . <tile.x11_bg_color> . "'"
);

