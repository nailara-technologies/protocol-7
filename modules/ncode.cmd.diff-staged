## [:< ##

# name  = ncode.cmd.diff-staged
# descr = show staged changes via git diff --cached

my @cmd = (qw| git diff --cached |);

my $output = $code{'ncode.util.run_cmd'}->(@cmd);

return { 'mode' => qw| size |, 'data' => $output };

