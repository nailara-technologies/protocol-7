# name  = lm-vision.cmd.get_raw_sample
# descr = retrieve raw payload sample (first 500 chars before token extraction)

my $job_id = $call->{'args'};

unless ( defined $job_id && length $job_id ) {
    return { 'mode' => 'false', 'data' => 'job_id required' };
}

unless ( exists <lm-vision.jobs>->{$job_id} ) {
    return { 'mode' => 'false', 'data' => 'no such job' };
}

my $job = <lm-vision.jobs>->{$job_id};

unless ( defined $job->{'raw_payload_sample'}
    && length $job->{'raw_payload_sample'} ) {
    return {
        'mode' => 'false',
        'data' => 'no raw payload sample available for this job'
    };
}

return {
    'mode' => qw| size |,
    'data' => $job->{'raw_payload_sample'}
};

