## [:< ##

# name  = route.bmw384.visual.wheel
# descr = generate SVG visualization of the BMW384 field index

return undef if not defined <bmw384.index>;

my $by_name = <bmw384.index>->{'by_name'};
my @sorted_names
    = @{ <bmw384.index>->{'sorted_names'} // [ sort keys %$by_name ] };

# [ optional namespace filter ]
my $ns_filter = <route.bmw384.cfg.namespace_filter> // '';
if ( length $ns_filter ) {
    @sorted_names = grep { index( $ARG, $ns_filter ) == 0 } @sorted_names;
}

# [ parameters ]
my $rings            = <route.bmw384.cfg.rings>            // 1;
my $ring_hue_drift   = <route.bmw384.cfg.ring_hue_drift>   // 14;
my $ring_radius_step = <route.bmw384.cfg.ring_radius_step> // 11;
my $outer_radius     = <route.bmw384.cfg.outer_radius>     // 320;
my $ring_blue_tint   = <route.bmw384.cfg.ring_blue_tint>   // 0.6;

# [ co-location ] count nodes per coordinate key
my %coord_count;
for my $ARG (@sorted_names) {
    my $coord = $by_name->{$ARG};
    my $key   = join( ':', $coord->{'color'}, $coord->{'arc'} );
    $coord_count{$key}++;
}

my $PI = 3.14159265358979;

my $segment_deg   = 360 / 26;
my $segment_width = 16777216 / 26;

my $svg = '<?xml version="1.0" encoding="UTF-8"?>' . "\n";
$svg .= '<svg xmlns="http://www.w3.org/2000/svg"'
    . ' viewBox="0 0 800 800" width="800" height="800">' . "\n";
$svg .= '  <rect width="800" height="800" fill="#0a0a0f"/>' . "\n";

# [ arc spokes — counterclockwise ]
for my $ARG ( 0 .. 25 ) {
    my $angle_deg = -$ARG * $segment_deg;
    my $rad       = $angle_deg * $PI / 180;
    my $x2        = 400 + 360 * sin($rad);
    my $y2        = 400 - 360 * cos($rad);
    $svg
        .= sprintf '  <line x1="400" y1="400" x2="%.2f" y2="%.2f"'
        . ' stroke="rgba(255,255,255,0.08)" stroke-width="1"/>'
        . "\n", $x2, $y2;
}

# [ arc labels — counterclockwise, per ring ]
for my $ring ( 0 .. $rings - 1 ) {
    my $radius        = $outer_radius - $ring * $ring_radius_step;
    my $label_opacity = sprintf( '%.2f', 0.3 * ( 0.75**$ring ) );
    $label_opacity = 0.05 if $label_opacity < 0.05;
    my $label_font_size = 10 - $ring;
    $label_font_size = 7 if $label_font_size < 7;
    my $label_radius = $radius + 12;

    for my $ARG ( 0 .. 25 ) {
        my $angle_deg = -$ARG * $segment_deg;
        my $rad       = $angle_deg * $PI / 180;
        my $x         = 400 + $label_radius * sin($rad);
        my $y         = 400 - $label_radius * cos($rad);
        my $label     = <[route.bmw384.visual.ring-label]>->( $ring, $ARG );

        # [ ring 27 darksun marker — special rendering ]
        my ( $label_fill, $label_font_size_actual );
        if ( $label eq '.' ) {
            $label_fill             = 'rgba(100,150,255,0.6)';
            $label_font_size_actual = $label_font_size + 2;
        } else {
            $label_fill             = "rgba(255,255,255,$label_opacity)";
            $label_font_size_actual = $label_font_size;
        }

        $svg
            .= sprintf '  <text x="%.2f" y="%.2f" fill="%s"'
            . ' font-size="%d" text-anchor="middle"'
            . ' dominant-baseline="middle">%s</text>'
            . "\n", $x, $y, $label_fill, $label_font_size_actual, $label;
    }
}

# [ nodes ] concentric rings for co-located coordinates, per ring
for my $ring ( 0 .. $rings - 1 ) {
    my $radius      = $outer_radius - $ring * $ring_radius_step;
    my $hue_offset  = $ring * $ring_hue_drift;
    my $opacity     = sprintf( '%.2f', 0.85 * ( 0.75**$ring ) );
    my $node_base_r = 4 - int( $ring / 3 );
    $node_base_r = 2 if $node_base_r < 2;

    my %drawn_index;

    for my $ARG (@sorted_names) {
        my $coord = $by_name->{$ARG};
        my $key   = join( ':', $coord->{'color'}, $coord->{'arc'} );

        my $colocated_index = $drawn_index{$key} // 0;
        $drawn_index{$key} = $colocated_index + 1;

        my $arc_start_deg = -$coord->{'arc'} * $segment_deg;
        my $within_arc_frac
            = ( $coord->{'color'} / $segment_width )
            - int( $coord->{'color'} / $segment_width );
        my $angle_deg = $arc_start_deg - $within_arc_frac * $segment_deg;
        my $rad       = $angle_deg * $PI / 180;

        my $x = 400 + $radius * sin($rad);
        my $y = 400 - $radius * cos($rad);

        my $base_hue
            = (
            180 - int( $coord->{'color'} / 16777216 * 360 ) + $hue_offset )
            % 360;
        my $blue_blend
            = $rings > 1
            ? ( $ring / ( $rings - 1 ) ) * $ring_blue_tint
            : 0;
        my $hue = int( $base_hue * ( 1 - $blue_blend ) + 220 * $blue_blend )
            % 360;
        my $color_hex = sprintf 'hsl(%d,90%%,60%%)', $hue;
        my $r = $node_base_r + ( $colocated_index * 2 );

        my $coord_str = sprintf '%s:%06X:%s',
            $coord->{'segment_label'},
            $coord->{'color'},
            substr( $coord->{'angle_bits'}, 0, 16 );

        $svg
            .= sprintf
            '  <circle cx="%.2f" cy="%.2f" r="%d" fill="%s" opacity="%s">'
            . "\n", $x, $y, $r, $color_hex, $opacity;
        $svg .= sprintf '    <title>%s — %s</title>' . "\n", $ARG, $coord_str;
        $svg .= '  </circle>' . "\n";
    }
}

# [ center logo — nailara at the darksun ]
my $logo_size = 44;    # diameter covering the void circle (r=24)
my $logo_xy   = 400 - $logo_size / 2;

$svg
    .= sprintf '  <image x="%.1f" y="%.1f" width="%d" height="%d"'
    . ' href="%s" opacity="0.7"'
    . ' style="mix-blend-mode:screen"/>' . "\n",
    $logo_xy, $logo_xy, $logo_size, $logo_size,
    '/gfx/logos/nailara_logo.trans-dark.png';

$svg .= '  <circle cx="400" cy="400" r="24" fill="none"'
    . ' stroke="rgba(255,255,255,0.08)" stroke-width="0.5"/>' . "\n";
$svg .= '</svg>' . "\n";

return $svg;

