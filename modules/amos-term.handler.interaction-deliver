# name  = amos-term.handler.interaction-deliver
# descr = Interaction prototype: default reply delivery endpoint
#
# Default reply_handler for amos-term.interaction.ask. In the full plugin this
# is where the reply routes back into the calling coding-zenka task; in the
# prototype it logs the completed exchange and stores it in the channel state
# for inspection.

my ( $question, $reply ) = @ARG;

my $state = <amos-term.interaction.state>;
$state->{'answered'} //= [];

push $state->{'answered'}->@*,
    {
    qw| question | => $question,
    qw| reply |    => $reply,
    qw| answered | => <[base.time]>->(3),
    };

<[base.logs]>->(
    2,         "[interaction] delivered :: Q: %s :: A: %s",
    $question, $reply
);

return TRUE;

0;

