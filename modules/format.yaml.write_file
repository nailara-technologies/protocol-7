## [:< ##

# name  = format.yaml.write_file
# descr = serialize data structure to yaml and write to file

my ( $path, $yaml_data ) = @ARG;

return <[base.logs]>->( 0, 'write_file : path not specified' )
    unless defined $path;

return <[base.logs]>->( 0, 'write_file : no data to write [ %s ]', $path )
    unless defined $yaml_data;

return <[base.logs]>->(
    0, 'no yaml parser loaded [ format.yaml.pre_init required ]'
) unless defined <format.yaml.dumper>;

my $err_summary;

eval { <format.yaml.dumper>->( $path, $yaml_data ) };

if ($EVAL_ERROR) {
    ( $err_summary = $EVAL_ERROR ) =~ s|\s*\n.*||s;    ## first line only ##
    $err_summary =~ s|\s+$||;

    <buffer.yaml-errors.max_size> //= 42 * 1024;
    <[base.buffer.add_line]>->( qw| yaml-errors |, '' );
    <[base.buffer.add_line]>->(
        qw| yaml-errors |,
        sprintf '[ yaml write error ] %s', $path
    );
    <[base.buffer.add_line]>->( qw| yaml-errors |, $err_summary );
    <[base.buffer.add_line]>->( qw| yaml-errors |, '' );

    return wantarray ? ( FALSE, $err_summary ) : FALSE;
}

return wantarray ? ( TRUE, undef ) : TRUE;

