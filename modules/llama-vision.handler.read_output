## [:< ##

# name  = llama-vision.handler.read_output
# descr = non-blocking I/O handler - read output chunks from vision CLI

my $event   = shift->w;
my $read_fh = $event->fd;
my $job_id  = $event->data;

my $vision_job = <llama-vision.jobs>->{$job_id};

unless ( defined $vision_job ) {
    $event->cancel if $event->is_active;
    return;
}

# If already processed by completion handler, skip
if ( $vision_job->{'processed'} ) {
    return;
}

# Read available data from stdout (non-blocking)
my $bytes = 0;
if ( defined $vision_job->{'rdr'} ) {
    while ( sysread( $vision_job->{'rdr'}, my $buf, 4096 ) ) {
        $vision_job->{'output'} .= $buf;
        $bytes += length($buf);
    }
}

<[base.logs]>->(
    2, "[read_output] job=%s bytes=%d",
    $job_id, $bytes
) if $bytes > 0;

