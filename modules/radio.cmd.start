## [:< ##

# name  = radio.cmd.start
# descr = connect to the radio stream if not already connected

if ( not defined <radio.stream.pid> or not <radio.stream.pid> ) {
    <[radio.connect]>;
}

return { 'mode' => qw| true |, 'data' => 'started' };

