# name  = models.decision.recommendation_base.calculate_composite_score
# descr = Calculate composite recommendation score for a model

my ( $model, $weights ) = @ARG;

return 0 unless $model && ref($model) eq qw| HASH |;

$weights //= {};

# Default weights for scoring
my $w_quality      = $weights->{quality}      // 0.4;
my $w_speed        = $weights->{speed}        // 0.3;
my $w_cost         = $weights->{cost}         // 0.2;
my $w_availability = $weights->{availability} // 0.1;

# Get metrics (normalized 0-1)
my $success_rate = ( $model->{statistics}->{success_rate} // 0 ) / 100;
my $speed_score  = 1
    - ( ( $model->{latency}->{p99_ms} // 1000 ) / 10000 ); # Normalize latency
my $cost_score
    = 1 - ( ( $model->{cost}->{monthly} // 100 ) / 1000 );    # Normalize cost
my $availability = $model->{presence_decision}->{currently_present} ? 1 : 0.5;

# Calculate composite
my $composite
    = ( $success_rate * $w_quality )
    + ( $speed_score * $w_speed )
    + ( $cost_score * $w_cost )
    + ( $availability * $w_availability );

return $composite;

