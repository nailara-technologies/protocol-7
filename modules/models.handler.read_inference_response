## [:< ##

# name = models.handler.read_inference_response
# descr = non-blocking I/O handler - read curl response from llama-server

my $event   = shift->w;
my $read_fh = $event->fd;
my $io_data = $event->data;

my $inference_id = $io_data->{'inference_id'};
my $stream       = $io_data->{'stream'};

my $job = <models.pending_inferences>->{$inference_id};

unless ( defined $job ) {
    $event->cancel if $event->is_active;
    return;
}

## Determine which field to read into
my $output_ref = undef;
if ( $stream eq 'stdout' ) {
    $output_ref = \$job->{'output'};
} elsif ( $stream eq 'stderr' ) {
    $output_ref = \$job->{'errors'};
}

unless ( defined $output_ref ) {
    return;
}

## Read available data (non-blocking)
my $bytes = <[base.s_read]>->(
    $read_fh,
    $output_ref,
    8 * 1024    # Read up to 8KB at a time
) // 0;

if ( $bytes > 0 ) {
    <[base.logs]>->(
        1, "[read_inference] id=%s stream=%s bytes=%d",
        $inference_id, $stream, $bytes
    );
}

## Check for EOF on this stream
if ( $bytes <= 0 ) {
    <[base.logs]>->(
        1, "[read_inference] EOF: id=%s stream=%s",
        $inference_id, $stream
    );

    close($read_fh);
    $event->cancel if $event->is_active;

    ## Mark appropriate stream as closed
    if ( $stream eq 'stdout' ) {
        $job->{'rdr_closed'} = 1;
    } elsif ( $stream eq 'stderr' ) {
        $job->{'err_closed'} = 1;
    }

    ## When both streams are closed, process the response
    ## (Process regardless of which stream closes second)
    if ( $job->{'rdr_closed'} && $job->{'err_closed'} ) {
        <[base.logs]>->(
            1, "[read_inference] both streams closed, processing response: id=%s",
            $inference_id
        );

        ## Process response immediately when both streams are closed
        <[models.handler.process_response]>->(
            { 'inference_id' => $inference_id, 'job' => $job }
        );
    }
}

