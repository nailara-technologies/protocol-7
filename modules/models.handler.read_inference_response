## [:< ##

# name = models.handler.read_inference_response
# descr = non-blocking I/O handler - read curl response from llama-server

my $event   = shift->w;
my $read_fh = $event->fd;
my $io_data = $event->data;

my $inference_id = $io_data->{'inference_id'};
my $stream       = $io_data->{'stream'};

my $job = <models.pending_inferences>->{$inference_id};

unless ( defined $job ) {
    $event->cancel if $event->is_active;
    return;
}

## Read available data (non-blocking)
my $bytes = <[base.s_read]>->(
    $read_fh,
    \$job->{'output'},
    8 * 1024    # Read up to 8KB at a time
) // 0;

<[base.logs]>->(
    2, "[read_inference] id=%s stream=%s bytes=%d",
    $inference_id, $stream, $bytes
) if $bytes > 0;

## Check for EOF
if ( $bytes <= 0 ) {
    ## EOF reached on stdout
    $job->{'rdr_closed'} = 1;
    close($read_fh);
    $event->cancel if $event->is_active;
    <[base.logs]>->(
        2, "[read_inference] EOF: id=%s stream=%s",
        $inference_id, $stream
    );
}

