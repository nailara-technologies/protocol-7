## [:< ##

# name = memory.startup
# descr = deferred callback — synchronous tree build from memory sources

return TRUE if <memory.ready>;    ## [ idempotent ] ##

my $cfg = <memory.cfg> // {};

## [ adapters temporarily disabled for stability testing ]##
<[base.logs]>->( 2, 'memory startup : empty tree — adapters disabled' );

<memory.ready> = TRUE;
<[base.logs]>->( 2, 'memory tree built — ready' );

return TRUE;

