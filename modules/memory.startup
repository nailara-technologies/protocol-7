## [:< ##

# name = memory.startup
# descr = deferred callback — synchronous tree build from memory sources

return TRUE if <memory.ready>;    ## [ idempotent ] ##

my $cfg = <memory.cfg> // {};

## [ resolve absolute ai-mem dir ] ##
my $dir  = $cfg->{'ai_mem_dir'} // 'data/ai-mem';
my $root = <system.root_path>;
$dir = "$root/$dir" if $dir !~ m{^/};

## [ build from file adapter ] ##
my $leaves = <[memory.source.file]>->( { dir => $dir } ) // [];

<[memory.tree.init]> if not defined <memory.tree>;

for my $leaf (@$leaves) {
    my $ref    = $leaf->{'source_ref'} // '';
    my ($file) = split /#/, $ref, 2;
    $file //= '';
    $file =~ s{^.*/}{};
    $file =~ s{\.(md|txt|log)$}{}i;

    my $path;
    my $group_by = $cfg->{'group_by'} // 'file';

    if ( $group_by eq 'flat' ) {
        $path = [];
    } elsif ( $group_by eq 'source-type' ) {
        $path = [ $leaf->{'source_type'} // 'file' ];
    } elsif ( $group_by eq 'section-class' ) {
        my $class;
        my $curve = $leaf->{'curve_type'} // '';
        if ( $curve eq 'gaussian_pulse' ) {
            $class = 'CRITICAL';
        } elsif ( $curve eq 'quantized' ) {
            $class = 'Active Topics';
        } elsif ( $curve eq 'exponential' ) {
            $class = 'Archive';
        } else {
            $class = 'General';
        }
        $path = [$class];
    } else {    ## [ default: file ] ##
        $path = [$file];
    }

    <[memory.tree.insert]>->( { leaf => $leaf, path => $path } );
}

## [ rebuild idf cache, flow, then score whole tree once ]##
<[memory.tree.score.rebuild_idf]>;
<[memory.tree.flow]>->( { node => <memory.tree> } );
<[memory.tree.score]>->( { node => <memory.tree> } );

<memory.ready>       = TRUE;
<memory.built_ntime> = <[base.ntime]>;    ## raw numerical network time ##
<[base.logs]>->(
    2,                'memory tree built : %d leaves, group_by=%s',
    scalar(@$leaves), $cfg->{'group_by'}
);

return TRUE;

