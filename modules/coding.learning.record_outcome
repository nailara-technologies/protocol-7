## [:< ##

# name = coding.learning.record_outcome
# descr = record task outcome with metrics and efficiency data
# purpose = learning : store task success|failure with performance metrics

my ($task_id, $task_type,   $service_used,
    $success, $tokens_used, $duration_ms
) = @ARG;

return {
    success => FALSE,
    error   => 'missing required parameters'
    }
    unless defined $task_id && defined $service_used && defined $success;

# Record outcome with computed efficiency metrics
my $outcome = {
    task_id     => $task_id,
    task_type   => $task_type || 'unknown',
    service     => $service_used,
    success     => $success ? 1 : 0,
    tokens_used => $tokens_used // 0,
    duration_ms => $duration_ms // 0,
    timestamp   => <[base.time]>,
    efficiency  => $tokens_used && $duration_ms > 0
    ? int( $tokens_used / ( $duration_ms / 1000 ) )
    : 0
};

## persist outcome to JSON file ##
my $learn_dir     = '/var/protocol-7/coding/learning';
my $outcomes_file = $learn_dir . '/outcomes.json';

## ensure directory exists ##
if ( !-d $learn_dir ) {
    require File::Path;
    File::Path::make_path($learn_dir);
}

## load existing outcomes ##
<[base.perlmod.autoload]>->('JSON::PP');
my @outcomes;
if ( -f $outcomes_file ) {
    my $content = <[file.slurp]>->($outcomes_file)->$*;
    if ( defined $content and length $content ) {
        my $decoded = eval { JSON::PP::decode_json($content) };
        @outcomes = $decoded->@* if ref $decoded eq qw| ARRAY |;
    }
}

## append and write back ##
push @outcomes, $outcome;
my $json_out = JSON::PP->new->utf8->pretty->canonical->encode( \@outcomes );

if ( open my $fh, '>', $outcomes_file ) {
    print {$fh} $json_out;
    close $fh;
} else {
    <[base.logs]>->(
        0,              '[record_outcome] cannot write %s : %s',
        $outcomes_file, $!
    );
    return { success => FALSE, error => "cannot write outcomes: $!" };
}

return {
    success => TRUE,
    outcome => $outcome,
    message => sprintf( "recorded outcome for task : %s", $task_id )
};

