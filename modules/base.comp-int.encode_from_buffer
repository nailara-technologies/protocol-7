# name  = base.comp-int.encode_from_buffer
# descr = encode non-negative integers to BER compressed integer buffer

my $input = shift;

if ( not defined $input ) {
    warn 'expected integer or arrayref parameter [ got nothing ] <{C1}>';
    return undef;
}

my @numbers;

if ( ref $input eq qw| ARRAY | ) {
    @numbers = $input->@*;
} elsif ( not ref $input ) {
    @numbers = ($input);
} else {
    warn 'expected integer or arrayref parameter [ invalid ref type ] <{C1}>';
    return undef;
}

foreach my $num (@numbers) {
    if ( not defined $num ) {
        warn 'undefined value in input sequence [ cannot encode ] <{C1}>';
        return undef;
    } elsif ( $num !~ m|^\d+$| ) {
        warn 'expected non-negative integer [ negative or non-integer ] <{C1}>';
        return undef;
    }
}

return pack qw| w* |, @numbers;

