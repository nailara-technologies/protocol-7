## [:< ##

# name  = cred-mesh.ui.interactive.action
# descr = dispatch credential-fabric ui slot/relay actions

my $call_args = shift // {};

my $session_id  = $call_args->{'session_id'} // '';
my $action_name = '';

if ( defined $call_args->{'args'} ) {
    my $args_str = $call_args->{'args'};
    $args_str =~ s/^\s+|\s+$//g;

    ## extract session_id= suffix if present ##
    if ( $args_str =~ s/\s+session_id=(\d{3,17})$// ) {
        $session_id = $1;
    }

    ($action_name) = split qr|\s+|, $args_str;
}

return {
    'mode' => qw| false |,
    'data' => 'missing session_id'
    }
    unless length $session_id;

return {
    'mode' => qw| false |,
    'data' => 'missing action name'
    }
    unless length $action_name;

my $ui    = $data{'session'}{$session_id}{'cred-mesh'}{'ui'};
my $focus = $ui->{'focus'};
return {
    'mode' => qw| false |,
    'data' => 'no active ui focus'
    }
    if not defined $focus
    or ref $focus ne qw| HASH |;

## helper: set a one-line status message ##
my $set_status = sub {
    my $msg = shift // '';
    $ui->{'status'} = $msg if length $msg;
};

## helper: current focused key from row_keys ##
my $focused_key = sub {
    my $keys  = $focus->{'row_keys'}  // [];
    my $index = $focus->{'row_index'} // 0;
    return undef if $index < 0 or $index >= scalar @$keys;
    return $keys->[$index];
};

## rotate action ##
if ( $action_name eq qw| rotate | ) {
    my $slot = $focused_key->();
    if ( not defined $slot ) {
        $set_status->('no slot focused');
        return <[cred-mesh.ui.interactive.refresh]>->($call_args);
    }

    my $new_value = eval { Crypt::Misc::random_bytes(32) };
    $new_value //= <[base.time]>->(3);

    my $result = eval {
        <[cred-mesh.rotate]>->(
            {   'slot'      => $slot,
                'new_value' => $new_value,
                'reason'    => qw| ui-manual |
            }
        );
    };

    if (    defined $result
        and ref $result eq qw| HASH |
        and $result->{'mode'} eq qw| true | ) {
        $set_status->("rotated slot '$slot'");
    } else {
        my $err = 'rotate failed';
        $err = $result->{'data'}
            if defined $result and ref $result eq qw| HASH |;
        $set_status->($err);
    }

    return <[cred-mesh.ui.interactive.refresh]>->($call_args);
}

## revoke action ##
if ( $action_name eq qw| revoke | ) {
    my $slot = $focused_key->();
    if ( not defined $slot ) {
        $set_status->('no slot focused');
        return <[cred-mesh.ui.interactive.refresh]>->($call_args);
    }

    my $meta = <cred-mesh.registry>->{$slot};
    if ( not defined $meta ) {
        $set_status->("unknown slot '$slot'");
        return <[cred-mesh.ui.interactive.refresh]>->($call_args);
    }

    $meta->{'revoked'} = TRUE;

    ## persist registry ##
    eval {
        my $yaml_str = YAML::XS::Dump(<cred-mesh.registry>);
        <[file.zenka_dir.write]>->( 'registry.yaml', \$yaml_str, '>', 0600 );
    };
    if ($@) {
        $set_status->('failed to persist revoked state');
    } else {
        $set_status->("revoked slot '$slot'");
    }

    return <[cred-mesh.ui.interactive.refresh]>->($call_args);
}

## grant action — switch to prompt mode ##
if ( $action_name eq qw| grant | ) {
    my $slot = $focused_key->();
    if ( not defined $slot ) {
        $set_status->('no slot focused');
        return <[cred-mesh.ui.interactive.refresh]>->($call_args);
    }

    $focus->{'pending_action'} = 'grant_zenka';
    $focus->{'pending_slot'}   = $slot;

    my $entry = <[ascii.frame.load]>->('credential-fabric/grant-prompt');
    if ( not defined $entry ) {
        $set_status->('grant prompt template not found');
        return <[cred-mesh.ui.interactive.refresh]>->($call_args);
    }

    my $descriptor;
    if ( exists $entry->{'descriptor'} ) {
        $descriptor = $entry->{'descriptor'};
    } elsif ( exists $entry->{'descriptors'} ) {
        my $mode = $entry->{'modes'}[0] // 'expanded';
        $descriptor = $entry->{'descriptors'}{$mode};
    }
    if ( not defined $descriptor ) {
        $set_status->('grant prompt descriptor not found');
        return <[cred-mesh.ui.interactive.refresh]>->($call_args);
    }

    my $rendered = <[ascii.frame.render]>->(
        {   descriptor => $descriptor,
            values     => { 'ZENKA_NAME' => '' }
        }
    );

    return { 'mode' => qw| size |, 'data' => $rendered // '' };
}

## approve action — switch to prompt mode [ only valid on relays view ] ##
if ( $action_name eq qw| approve | ) {
    if ( $focus->{'view'} ne qw| relays | ) {
        $set_status->('approve is only valid on the auth-relay queue view');
        return <[cred-mesh.ui.interactive.refresh]>->($call_args);
    }

    my $req_id = $focused_key->();
    if ( not defined $req_id ) {
        $set_status->('no relay request focused');
        return <[cred-mesh.ui.interactive.refresh]>->($call_args);
    }

    $focus->{'pending_action'} = 'approve_payload';
    $focus->{'pending_req_id'} = $req_id;

    my $entry = <[ascii.frame.load]>->('credential-fabric/approve-prompt');
    if ( not defined $entry ) {
        $set_status->('approve prompt template not found');
        return <[cred-mesh.ui.interactive.refresh]>->($call_args);
    }

    my $descriptor;
    if ( exists $entry->{'descriptor'} ) {
        $descriptor = $entry->{'descriptor'};
    } elsif ( exists $entry->{'descriptors'} ) {
        my $mode = $entry->{'modes'}[0] // 'expanded';
        $descriptor = $entry->{'descriptors'}{$mode};
    }
    if ( not defined $descriptor ) {
        $set_status->('approve prompt descriptor not found');
        return <[cred-mesh.ui.interactive.refresh]>->($call_args);
    }

    my $rendered = <[ascii.frame.render]>->(
        {   descriptor => $descriptor,
            values     => { 'REQ_ID' => $req_id, 'PAYLOAD' => '' }
        }
    );

    return { 'mode' => qw| size |, 'data' => $rendered // '' };
}

## detail action — switch to registry-detail of focused slot ##
if ( $action_name eq qw| detail | ) {
    my $slot = $focused_key->();
    if ( not defined $slot ) {
        $set_status->('no slot focused');
        return <[cred-mesh.ui.interactive.refresh]>->($call_args);
    }

    $call_args->{'args'}
        = sprintf( 'slot %s session_id=%s', $slot, $session_id );
    return <[cred-mesh.ui.interactive.select_view]>->($call_args);
}

## unknown action ##
$set_status->( sprintf( "unknown action '%s'", $action_name ) );
return <[cred-mesh.ui.interactive.refresh]>->($call_args);

