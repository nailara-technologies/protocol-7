# name  = models.decision.cost_base.has_available_alternative
# descr = Check if model has available alternative models

my ($model_entry) = @ARG;

return 0 unless $model_entry && ref($model_entry) eq 'HASH';

my $alternatives = $model_entry->{alternatives} // [];
return scalar(@$alternatives) > 0;

