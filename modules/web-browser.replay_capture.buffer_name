## [:< ##

# name  = web-browser.replay_capture.buffer_name
# descr = derive ring-buffer name for a view's input recording [ id->name ]
# param = <view_id>

my $view_id = shift;

return undef unless defined $view_id and $view_id =~ m|^\d+$|;

return sprintf( 'js-replay-view-%04d', $view_id - 1 );

