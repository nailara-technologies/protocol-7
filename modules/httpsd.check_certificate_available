# name = httpsd.check_certificate_available
# descr = check if certificate and key files exist and are readable
# return = { available => 1/0, path => cert_path, expires => timestamp }

## discover active certificate using auto-discovery
my $cert_info = <[httpsd.discover_active_certificate]>;

my $result = {
    available => 0,
    path      => undef,
    expires   => undef
};

unless ($cert_info) {
    <[base.logs]>->( 3, 'httpsd: no certificate found via discovery' );
    return $result;
}

my $cert_file = $cert_info->{cert_path};
my $key_file  = $cert_info->{key_path};

$result->{path} = $cert_file;

## verify files exist and are readable
unless ( -f $cert_file && -r $cert_file ) {
    <[base.logs]>->( 3, 'httpsd certificate not readable: %s', $cert_file );
    return $result;
}

unless ( -f $key_file && -r $key_file ) {
    <[base.logs]>->( 3, 'httpsd key not readable: %s', $key_file );
    return $result;
}

## validate certificate format
my $cert_fh;
unless ( open( $cert_fh, '<', $cert_file ) ) {
    <[base.logs]>->(
        2,          'cannot read certificate file: %s - %s',
        $cert_file, $OS_ERROR
    );
    return $result;
}

my $cert_header = <$cert_fh>;
close($cert_fh);
chomp($cert_header);

unless ( $cert_header =~ m/^-----BEGIN CERTIFICATE-----$/ ) {
    <[base.logs]>->(
        2, 'certificate file has invalid format: %s', $cert_file
    );
    return $result;
}

## validate key format
my $key_fh;
unless ( open( $key_fh, '<', $key_file ) ) {
    <[base.logs]>->(
        2,         'cannot read key file: %s - %s',
        $key_file, $OS_ERROR
    );
    return $result;
}

my $key_header = <$key_fh>;
close($key_fh);
chomp($key_header);

unless ( $key_header =~ m/^-----BEGIN (?:RSA |EC |)PRIVATE KEY-----$/ ) {
    <[base.logs]>
        ->( 2, 'private key file has invalid format: %s', $key_file );
    return $result;
}

## verify certificate is not expired via Net::SSLeay [ already loaded ] ##
my $x509 = Net::SSLeay::PEM_read_bio_X509(
    Net::SSLeay::BIO_new_file( $cert_file, qw| r | ) );
if ( not defined $x509 ) {
    <[base.logs]>->( 1, 'httpsd: cannot parse certificate: %s', $cert_file );
    return $result;
}
my $not_after = Net::SSLeay::X509_get_notAfter($x509);
my $expiry    = Net::SSLeay::P_ASN1_TIME_timet( $not_after, undef );
Net::SSLeay::X509_free($x509);
if ( not defined $expiry or $expiry <= time ) {
    <[base.logs]>->( 1, 'httpsd: certificate is expired: %s', $cert_file );
    return $result;
}

## certificate and key are available and valid
$result->{available} = 1;

## update config paths to point to discovered certificate files
<httpsd.cfg.certificate_path> = $cert_file;
<httpsd.cfg.key_path>         = $key_file;

<[base.logs]>->( 3, 'httpsd certificate available: %s', $cert_file );

return $result;

0;

