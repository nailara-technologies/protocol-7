## [:< ##

# name = httpsd.check_certificate_available
# descr = check if certificate and key files exist and are readable
# return = { available => 1/0, path => cert_path, expires => timestamp }

my $cert_file = <httpsd.cfg.certificate_path>;
my $key_file  = <httpsd.cfg.key_path>;

my $result = {
    available => 0,
    path      => $cert_file,
    expires   => undef
};

## check if both files exist and are readable
unless ( -f $cert_file && -r $cert_file ) {
    <[base.logs]>->( 3, 'httpsd certificate not available: %s', $cert_file );
    return $result;
}

unless ( -f $key_file && -r $key_file ) {
    <[base.logs]>->( 3, 'httpsd key not available: %s', $key_file );
    return $result;
}

## validate certificate format
my $cert_fh;
unless ( open( $cert_fh, '<', $cert_file ) ) {
    <[base.logs]>->(
        2,          'cannot read certificate file: %s - %s',
        $cert_file, $OS_ERROR
    );
    return $result;
}

my $cert_header = <$cert_fh>;
close($cert_fh);
chomp($cert_header);

unless ( $cert_header =~ m/^-----BEGIN CERTIFICATE-----$/ ) {
    <[base.logs]>->(
        2, 'certificate file has invalid format: %s', $cert_file
    );
    return $result;
}

## validate key format
my $key_fh;
unless ( open( $key_fh, '<', $key_file ) ) {
    <[base.logs]>->(
        2,         'cannot read key file: %s - %s',
        $key_file, $OS_ERROR
    );
    return $result;
}

my $key_header = <$key_fh>;
close($key_fh);
chomp($key_header);

unless ( $key_header =~ m/^-----BEGIN (?:RSA |EC |)PRIVATE KEY-----$/ ) {
    <[base.logs]>
        ->( 2, 'private key file has invalid format: %s', $key_file );
    return $result;
}

## certificate and key are available
$result->{available} = 1;

<[base.logs]>->( 3, 'httpsd certificate available: %s', $cert_file );

return $result;

0;

