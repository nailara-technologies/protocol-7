## [:< ##

# name  = devmod.cmd.add-env
# param = <key>
# descr = delete value from ENV hash

my $param_str = $call->{'args'};

return { 'mode' => qw| false |, 'data' => 'key name required' }
    if not defined $param_str;

my ( $key, $value ) = split m| +|, $param_str, 2;

return { 'mode' => qw| false |, 'data' => 'value parameter expected' }
    if not length $value // '';

return { 'mode' => qw| false |, 'data' => 'env key is aleady present' }
    if exists $ENV{$key};

$ENV{$key} = $value;

return { 'mode' => qw| true |, 'data' => 'value has been set' };

