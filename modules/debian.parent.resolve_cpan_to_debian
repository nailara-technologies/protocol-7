# name = debian.parent.resolve_cpan_to_debian
# descr = resolve CPAN module name to Debian package name

my $cpan_module = shift;

return undef unless $cpan_module;

## Look up in known_dependencies
my $known = $data{'debian'}{'known_deps'}{perlmod}{$cpan_module};

if ( $known && $known->{debian} ) {
    ## Handle array of debian packages
    if ( ref( $known->{debian} ) eq 'ARRAY' ) {
        ## Return first non-cpan: package
        foreach my $pkg ( @{ $known->{debian} } ) {
            next if $pkg =~ /^cpan:/;
            return $pkg;
        }
    }
}

## not found in known_dependencies — no invented names ##
return undef;

0;

