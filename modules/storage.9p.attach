## [:< ##
# name  = storage.9p.attach
# descr = 9P attach for storage connection

use strict;
use warnings;

return sub {
    my ( $conn, $aname ) = @_;
    $aname //= '';

    my $fid  = $conn->{root_fid};
    my $afid = 0xFFFFFFFF;
    my $tag  = ++$conn->{tag} & 0xFFFF;

    my $req
        = <[plan-9.protocol.codec.encode-uint32]>->($fid)
        . <[plan-9.protocol.codec.encode-uint32]>->($afid)
        . <[plan-9.protocol.codec.encode-string]>->( $conn->{uname} )
        . <[plan-9.protocol.codec.encode-string]>->($aname);

    my $msg = <[plan-9.protocol.codec.encode-message]>->(
        <plan-9.protocol.constants.Tattach>,
        $tag, $req
    );

    $conn->{socket}->send($msg);

    my $resp = <[storage.9p.read-message]>->( $conn, $tag );
    return $resp if $resp->{'mode'} eq 'false';

    my $data = $resp->{'data'};
    my ( $qid_type, $qid_version, $qid_path )
        = <[plan-9.protocol.codec.decode-qid]>->( substr( $data, 0, 13 ) );

    $conn->{fids}{$fid} = {
        'type' => 'root',
        'qid'  => {
            'type'    => $qid_type,
            'version' => $qid_version,
            'path'    => $qid_path
        },
        'path' => '/',
    };

    return { 'mode' => 'true', 'data' => $fid };
};

