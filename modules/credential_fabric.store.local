## [:< ##

# name  = credential_fabric.store.local
# descr = tier-1 local encrypted storage: read/write credential blobs to disk.
#         file path: var/credential_fabric/store/<slot_name>.enc

my $operation = shift // '';    ## 'read' or 'write' ##
my $slot      = shift // '';
my $data      = shift // '';    ## for write: plaintext bytes ##

return undef unless length $operation and length $slot;

my $store_dir = <credential_fabric.cfg.store_dir> // 'var/credential_fabric/';
my $file_path = $store_dir . 'store/' . $slot . '.enc';

if ( $operation eq qw| read | ) {
    return undef unless -f $file_path and -r $file_path;

    my $content_ref = <[file.slurp]>->( $file_path, qw| :raw | );
    return undef
        if not defined $content_ref
        or not length $content_ref->$*;

    ## decrypt via key-holder child ##
    return <[credential_fabric.decrypt]>->( $slot, $content_ref->$* );

} elsif ( $operation eq qw| write | ) {
    return undef if not length $data;

    ## encrypt via key-holder child ##
    my $enc_data = <[credential_fabric.encrypt]>->( $slot, $data );
    return undef if not defined $enc_data;

    ## atomic write via temp file ##
    my $tmp_path = $file_path . '.tmp.' . $$ . '.' . <[base.ntime.b32]>;
    my $write_ok = <[file.put_bin]>->( $tmp_path, $enc_data );
    return undef if not $write_ok;

    chmod 0600, $tmp_path;
    rename( $tmp_path, $file_path )
        or do {
        <[base.s_warn]>->(
            'credential_fabric.store.local: rename failed: %s', $!
        );
        unlink($tmp_path);
        return undef;
        };

    chmod 0600, $file_path;
    return TRUE;

} else {
    warn
        "credential_fabric.store.local: unknown operation '$operation' <{C1}>";
    return undef;
}

