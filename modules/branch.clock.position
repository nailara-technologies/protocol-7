## [:< ##

# name  = branch.clock.position
# descr = compute current position in the 13-slot clock cycle

my $param = shift             // {};
my $ntime = $param->{'ntime'} // '';

return { mode => 'false', data => 'ntime required' }
    if not length $ntime;

my $numerical = <[base.ntime_BASE32_to_numerical]>->($ntime);

return { mode => 'false', data => 'invalid ntime' }
    if not defined $numerical;

my $position         = int($numerical) % 13;
my $next_correlation = 13 - $position;
my $is_correlation   = ( $position == 0 ) ? TRUE : FALSE;

return {
    mode => 'true',
    data => {
        position         => $position,
        next_correlation => $next_correlation,
        is_correlation   => $is_correlation,
    }
};

