## [:< ##

# name  = letsencr.parent.handler_challenge_validated
# descr = Handle challenge validation notification from child - update challenge status

my $validation_data = shift;

my $token  = $validation_data->{'params'}{'token'};
my $domain = $validation_data->{'params'}{'domain'};
my $mode   = $validation_data->{'cmd'};

<[base.log]>->(
    2,
    "challenge validation notification: token=$token, domain=$domain, mode=$mode"
);

unless ( exists <letsencr.parent.pending_challenges> {$token} ) {
    <[base.log]>->(
        1, "challenge token $token not found in pending challenges"
    );
    return 0;
}

my $challenge = <letsencr.parent.pending_challenges> {$token};

if ( $mode eq 'TRUE' ) {
    <[base.log]>->( 2, "challenge validated for $domain (token: $token)" );
    <[letsencr.parent.activity_logger]>->(
        'challenge', $domain, 'success', 'ACME challenge validated'
    );

    ## Mark challenge as validated
    $challenge->{status}       = 'valid';
    $challenge->{validated_at} = time();

} elsif ( $mode eq 'FALSE' ) {
    my $error = $validation_data->{'data'} // 'validation failed';
    <[base.log]>->( 1, "challenge validation failed for $domain: $error" );
    <[letsencr.parent.activity_logger]>->(
        'challenge', $domain, 'failed', "validation error: $error"
    );

    ## Mark challenge as failed
    $challenge->{status}    = 'failed';
    $challenge->{error}     = $error;
    $challenge->{failed_at} = time();

    ## Request HTTPd to clean up the challenge file
    <[base.protocol-7.command.send.local]>->(
        {   'command'   => 'httpd.cmd.remove-acme-challenge',
            'call_args' => {
                'args'  => $domain,
                'param' => { 'token' => $token, }
            }
        }
    );

} else {
    <[base.log]>->( 1, "unknown validation mode: $mode for $domain" );
    <[letsencr.parent.activity_logger]>->(
        'challenge', $domain, 'failed', "unknown validation mode: $mode"
    );
}

return 0;

