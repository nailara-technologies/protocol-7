## [:< ##

# name  = letsencr.parent.handler_challenge_validated
# descr = handle challenge validation notification from child process

my $validation_data = shift;

my $token  = $validation_data->{'params'}{'token'};
my $domain = $validation_data->{'params'}{'domain'};
my $mode   = $validation_data->{'cmd'};

<[base.logs]>->(
    2, 'challenge validation: token=%s domain=%s mode=%s',
    $token, $domain, $mode
);

unless ( exists <letsencr.parent.pending_challenges> {$token} ) {
    <[base.logs]>->(
        1, 'challenge token %s not found in pending challenges', $token
    );
    return FALSE;
}

my $challenge = <letsencr.parent.pending_challenges> {$token};

if ( $mode eq 'TRUE' ) {
    <[base.logs]>->(
        2,       'challenge validated for %s (token: %s)',
        $domain, $token
    );
    <[letsencr.parent.activity_logger]>->(
        'challenge', $domain, 'success', 'ACME challenge validated'
    );

    ## mark challenge as validated
    $challenge->{status}       = qw| valid |;
    $challenge->{validated_at} = time();

} elsif ( $mode eq 'FALSE' ) {
    my $error = $validation_data->{'data'} // 'validation failed';
    <[base.logs]>->(
        1,       'challenge validation failed for %s: %s',
        $domain, $error
    );
    <[letsencr.parent.activity_logger]>->(
        'challenge', $domain, 'failed',
        sprintf( 'validation error: %s', $error )
    );

    ## mark challenge as failed
    $challenge->{status}    = qw| failed |;
    $challenge->{error}     = $error;
    $challenge->{failed_at} = time();

    ## request HTTPd to clean up the challenge file
    ## [ parameters as space-separated args: domain token ]
    <[base.protocol-7.command.send.local]>->(
        {   'command'   => 'httpd.cmd.remove-acme-challenge',
            'call_args' => { 'args' => "$domain $token" }
        }
    );

} else {
    <[base.logs]>
        ->( 1, 'unknown validation mode: %s for %s', $mode, $domain );
    <[letsencr.parent.activity_logger]>->(
        'challenge', $domain, 'failed',
        sprintf( 'unknown validation mode: %s', $mode )
    );
}

return FALSE;

