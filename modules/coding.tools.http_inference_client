# name  = coding.tools.http_inference_client
# descr = one-shot HTTP client for llama-server chat completions API

my $params   = shift                 // {};
my $url      = $params->{'url'}      // 'http://127.0.0.1:8000';
my $model_id = $params->{'model_id'} // '';
my $prompt   = $params->{'prompt'}   // '';
my $timeout  = $params->{'timeout'}  // 30;
## reasoning models spend tokens on a <think> trace before any visible ##
## content - 128 was getting fully consumed by reasoning, leaving the  ##
## actual answer empty [ confirmed live 2026-06-21 ]                   ##
my $max_tokens = $params->{'max_tokens'} // 1024;

return { mode => qw| false |, data => 'prompt required' }
    if !length $prompt;

## normalize base url to completions endpoint ##
my $completion_url = $url;
if ( $completion_url !~ m{/v1/chat/completions$} ) {
    $completion_url =~ s{/+$}{};
    $completion_url .= '/v1/chat/completions';
}

## NOTE: llama-server serves exactly one model, fixed at process-spawn time
## via --model <path> [ see coding.spawn_inference_server ]. it does NOT route
## by this 'model' field - which port you connect to (8000=gpu, 8001=cpu) is
## what actually selects the model, not this request body.  $model_id here is
## a label for logging/archival only - confirmed live 2026-06-21 after the
## field was mistaken for a working switch param.
my $request_body = {
    model       => $model_id,
    messages    => [ { role => 'user', content => $prompt } ],
    max_tokens  => $max_tokens,
    temperature => 0.3,
    stream      => JSON::PP::false,
};

my $json_body = eval { JSON::PP->new->utf8->encode($request_body) };
if ($@) {
    <[base.logs]>->( 0, 'http_inference_client: JSON encode error: %s', $@ );
    return { mode => qw| false |, data => 'encode_error' };
}

my $reply = eval {
    use LWP::UserAgent;
    my $ua       = LWP::UserAgent->new( timeout => $timeout );
    my $response = $ua->post(
        $completion_url,
        'Content-Type' => 'application/json',
        Content        => $json_body,
    );

    if ( !$response->is_success ) {
        return {
            mode => qw| false |,
            data => 'http_' . $response->code
        };
    }

    my $data    = JSON::PP::decode_json( $response->decoded_content );
    my $content = $data->{'choices'}[0]{'message'}{'content'} // '';
    return { mode => qw| true |, data => $content };
};

if ($@) {
    my $err = $@;
    $err =~ s|\s+at\s+\S+\s+line\s+\d+.*||s;
    <[base.logs]>->( 0, 'http_inference_client: request failed: %s', $err );
    return { mode => qw| false |, data => 'request_failed' };
}

return $reply;

