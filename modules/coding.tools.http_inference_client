# name  = coding.tools.http_inference_client
# descr = one-shot HTTP client for llama-server chat completions API

my $params   = shift                 // {};
my $url      = $params->{'url'}      // 'http://127.0.0.1:8000';
my $model_id = $params->{'model_id'} // '';
my $prompt   = $params->{'prompt'}   // '';
my $timeout  = $params->{'timeout'}  // 30;
## reasoning models spend tokens on a <think> trace before any visible ##
## content - 128 was getting fully consumed by reasoning, leaving the  ##
## actual answer empty [ confirmed live 2026-06-21 ]                   ##
my $max_tokens = $params->{'max_tokens'} // 1024;

return { mode => qw| false |, data => 'prompt required' }
    if !length $prompt;

## normalize base url to completions endpoint ##
my $completion_url = $url;
if ( $completion_url !~ m{/v1/chat/completions$} ) {
    $completion_url =~ s{/+$}{};
    $completion_url .= '/v1/chat/completions';
}

## NOTE: llama-server serves exactly one model, fixed at process-spawn time ##
## via --model <path> [ see coding.spawn_inference_server ]. it does NOT    ##
## route by this 'model' field - which port you connect to (8000=gpu,       ##
## 8001=cpu) is what actually selects the model, not this request body.     ##
## $model_id here is a label for logging/archival only - confirmed live     ##
## 2026-06-21 after the field was mistaken for a working switch param.      ##
## step-1 experiment [ 2026-07-31, task coding-self-test-async-http-        ##
## client-rewrite ] : stream => true, still blocking LWP - keeps bytes      ##
## flowing so a silence-based cutoff [ the leading http_500 hypothesis :    ##
## stream=false is one long silent read ] can't trip. SSE deltas are        ##
## accumulated below exactly like coding.async.chunk_handler does           ##
my $request_body = {
    model       => $model_id,
    messages    => [ { role => 'user', content => $prompt } ],
    max_tokens  => $max_tokens,
    temperature => 0.3,
    stream      => JSON::PP::true(),
};

my $json_body = eval { JSON::PP->new->utf8->encode($request_body) };
if ($@) {
    <[base.logs]>->( 0, 'http_inference_client: JSON encode error: %s', $@ );
    return { mode => qw| false |, data => 'encode_error' };
}

my $reply = eval {
    use LWP::UserAgent;

    my $content       = '';
    my $reasoning     = '';
    my $finish_reason = '';
    my $sse_buffer    = '';

    ## one complete SSE line : strip 'data: ' prefix, skip [DONE], decode ##
    ## json, accumulate delta.content / delta.reasoning_content and the   ##
    ## finish_reason - mirrors coding.async.chunk_handler:26-105, nothing ##
    ## else                                                               ##
    my $process_line = sub {
        my ($line) = @ARG;
        return unless $line =~ m{^data:\s*(.+)};
        my $json_str = $1;
        return if $json_str eq '[DONE]';
        my $chunk = eval { JSON::PP::decode_json($json_str) };
        return if $@ or ref $chunk ne qw| HASH |;
        my $choice = $chunk->{'choices'}[0] // {};
        my $delta  = $choice->{'delta'}     // {};
        $content   .= $delta->{'content'}           // '';
        $reasoning .= $delta->{'reasoning_content'} // '';
        $finish_reason = $choice->{'finish_reason'}
            if defined $choice->{'finish_reason'};
        return;
    };

    ## LWP's own timeout is an INACTIVITY timeout : the request is aborted  ##
    ## if no activity is observed for $timeout seconds. that is exactly why ##
    ## stream=false tripped at 90s - one long silent generation is one long ##
    ## inactivity gap. with stream=true bytes arrive continuously, so LWP's ##
    ## timeout can NEVER fire : enforce a real wall-clock ceiling by hand   ##
    ## here or this call becomes unbounded [ the precise failure class of   ##
    ## the waitpid incident this task exists to prevent ]                   ##
    my $deadline = <[base.time]>->(9) + $timeout;

    my $ua       = LWP::UserAgent->new( timeout => $timeout );
    my $response = $ua->post(
        $completion_url,
        'Content-Type' => 'application/json',
        Content        => $json_body,
        ':content_cb'  => sub {
            my ( $data_chunk, $resp, $proto ) = @ARG;

            ## die - NOT return - is what actually aborts the transfer.    ##
            ## LWP catches it, stops reading and reports it via the X-Died ##
            ## response header [ verified live against LWP 6.83 : it does  ##
            ## NOT rethrow ] - re-thrown right after ->post below          ##
            die 'self_test_stream_deadline'
                if <[base.time]>->(9) > $deadline;

            $sse_buffer .= $data_chunk;
            while ( $sse_buffer =~ s{^([^\r\n]*)\r?\n}{} ) {
                $process_line->($1);
            }
            return;
        },
    );

    ## deadline trip [ or any other callback death ] : LWP swallows the die ##
    ## into X-Died and can still report is_success on partial content -     ##
    ## rethrow so the enclosing eval maps it to 'request_failed', the same  ##
    ## contract a transport failure has today                               ##
    die $response->header('X-Died') if $response->header('X-Died');

    if ( !$response->is_success ) {
        return {
            mode => qw| false |,
            data => 'http_' . $response->code
        };
    }

    ## flush a trailing SSE line that arrived without a terminating newline ##
    if ( length $sse_buffer ) {
        my $remaining = $sse_buffer;
        $remaining =~ s|\r$||;
        $sse_buffer = '';
        $process_line->($remaining);
    }

    ## capture the reasoning trace separately rather than silently dropping ##
    ## it : some servers return it as its own field [ analogous to the      ##
    ## streaming delta.reasoning_content coding.async.chunk_handler already ##
    ## handles ], others leave it inline as <think>...</think> inside       ##
    ## content - strip that out too so callers get clean content either     ##
    ## way, with the trace available for diagnostics when content comes     ##
    ## back empty [ eg the model spent its whole max_tokens budget          ##
    ## reasoning and never got to emit an answer - confirmed live ]         ##
    while ( $content =~ s|<think>(.*?)</think>||s ) {
        $reasoning .= $1;
    }
    $content =~ s|^\s*</think>\s*||;    ## stray closing tag, no opener ##

    return {
        mode          => qw| true |,
        data          => $content,
        reasoning     => $reasoning,
        finish_reason => $finish_reason,
    };
};

if ($@) {
    my $err = $@;
    $err =~ s|\s+at\s+\S+\s+line\s+\d+.*||s;
    <[base.logs]>->( 0, 'http_inference_client: request failed: %s', $err );
    return { mode => qw| false |, data => 'request_failed' };
}

return $reply;

