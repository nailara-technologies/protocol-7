## [:< ##

# name  = data.mount.fuse.read
# param = <fuse_path> <buffer_size> <offset>
# descr = FUSE read callback - return file content
# return = string content (or empty string for errors)

my ( $fuse_path, $buffer_size, $offset ) = @ARG;

$fuse_path   //= '';
$buffer_size //= 4096;
$offset      //= 0;

# Translate FUSE path to relative hash path
my $rel_hash_path = $fuse_path;
$rel_hash_path =~ s|^/||;     # Remove leading /
$rel_hash_path =~ s|/|.|g;    # Convert / to .

# Combine with root hash path if set (in FUSE child context)
my $full_hash_path;
if ( defined <data.fuse.root_hash_path> ) {
    if ( length($rel_hash_path) ) {
        $full_hash_path = <data.fuse.root_hash_path> . '.' . $rel_hash_path;
    } else {
        $full_hash_path = <data.fuse.root_hash_path>;
    }
} else {
    $full_hash_path = $rel_hash_path;
}

# Resolve the hash path
my $ref = <[data.resolve_hash_path]>->($full_hash_path);

# Return empty if not found
return '' unless defined $ref;

my $content = '';

# Get content based on reference type
if ( ref($ref) eq 'SCALAR' ) {
    $content = ${$ref} // '';
} elsif ( ref($ref) eq 'HASH' || ref($ref) eq 'ARRAY' ) {

    # Serialize structured data as JSON-like representation
    $content = encode_json($ref);
} elsif ( ref($ref) eq 'CODE' ) {

    # Execute CODE ref with 'read' context
    my $result = eval { $ref->('read') };
    if ( !$@ && defined $result ) {
        if ( ref($result) eq 'SCALAR' ) {
            $content = ${$result} // '';
        } else {
            $content = "$result";
        }
    }
} else {

    # Plain scalar - stringify
    $content = "$ref";
}

# Handle offset and buffer size
if ( $offset > 0 ) {
    $content = substr( $content, $offset );
}

if ( length($content) > $buffer_size ) {
    $content = substr( $content, 0, $buffer_size );
}

return $content;

