# name  = plan-9.protocol.codec.decode-string
return sub {
    my ($data) = @_;
    my $len = unpack( 'v', substr( $data, 0, 2 ) );
    return ( substr( $data, 2, $len ), substr( $data, 2 + $len ) );
};

