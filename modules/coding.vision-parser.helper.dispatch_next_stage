## [:< ##

# name  = coding.vision-parser.helper.dispatch_next_stage
# descr = orchestrate pipeline stages: spawn vision analysis or text extraction, register completion monitoring

my ( $job_id, $stage ) = @ARG;

my $job = <coding.vision-parser.jobs>->{$job_id};

unless ( defined $job ) {
    <[base.logs]>->(
        0, '[vision-parser] dispatch_next_stage: job not found: %s', $job_id
    );
    return;
}

if ( $stage eq 'analyzing' ) {

    ## stage 1: send vision analysis request async via reply handler
    <[base.logs]>->(
        1,
        '[vision-parser] STAGE 1: routing '
            . 'vision analysis to lm-vision job=%s',
        $job_id
    );

    ## send async - result arrives via
    ## coding.vision-parser.handler.vision_reply
    my $cmd_count = <[protocol-7.command.send.local]>->(
        {   'command'   => 'cube.lm-vision.analyze_image',
            'call_args' =>
                { 'args' => "$job->{'image_path'} $job->{'vision_prompt'}" },
            'reply' => {
                'handler' => 'coding.vision-parser.handler.vision_reply',
                'params'  => { 'job_id' => $job_id }
            }
        }
    );

    if ( !$cmd_count ) {
        <[base.logs]>->(
            0, '[vision-parser] lm-vision zenka unreachable [ job=%s ]',
            $job_id
        );
        $job->{'error'} = 'lm-vision zenka offline';
        <coding.vision-parser.state> = 'failed';
    } else {
        <[base.logs]>->(
            2,
            '[vision-parser] vision request sent, awaiting reply [ job=%s ]',
            $job_id
        );
        <coding.vision-parser.state> = 'analyzing_pending';
    }

} elsif ( $stage eq 'extracting' ) {

    # STAGE 2: Text extraction using simple prompt + vision context
    <[base.logs]>->(
        1, '[vision-parser] STAGE 2: text extraction job=%s', $job_id
    );

    unless ( defined $job->{'vision_result'} ) {
        <[base.logs]>->(
            0, '[vision-parser] no vision result available for extraction'
        );
        $job->{'error'} = 'vision result not available';
        <coding.vision-parser.state> = 'failed';
        return;
    }

    # For v1, just return the vision result as-is
    # Later versions can add real text extraction/structuring
    <[base.logs]>->(
        1, '[vision-parser] returning vision result as text extraction output'
    );

    $job->{'extraction_result'} = $job->{'vision_result'};

    # Advance to final response stage
    <coding.vision-parser.state> = 'extracting_done';
    <[base.logs]>->(
        2, '[vision-parser] state transition: extracting_done (job=%s)',
        $job_id
    );
}

return;

