## [:< ##

# name = menu-commands.cmd.remove
# descr = Remove a menu command mapping

my $mapping_id = defined $$call{'args'} ? $$call{'args'} : '';
$mapping_id =~ s{^\s+|\s+$}{}g;

unless ($mapping_id) {
    return {
        'mode' => qw| false |,
        'data' => 'Usage: remove <mapping-id>'
    };
}

# Check if mapping exists
unless (exists <menu-commands.mappings>->{$mapping_id}) {
    return {
        'mode' => qw| false |,
        'data' => 'Mapping not found: ' . $mapping_id
    };
}

# Remove from mappings hash
delete <menu-commands.mappings>->{$mapping_id};

# Save to disk
<[menu-commands.save-state]>;

# Push update to protocol-7-menu
<[menu-commands.update-menu]>;

return {
    'mode' => qw| true |,
    'data' => 'Removed mapping: ' . $mapping_id
};

