## [:< ##

# name  = sessions.cmd.encrypt
# descr = encrypt a console-supplied string via the live child
#         [ result printed as base32 ]
# param = <plaintext>

my $plaintext = $call->{'args'} // '';
$plaintext =~ s/^\s+|\s+$//g;

my $result = <[sessions.holder.parent]>->( qw| ENCRYPT |, $plaintext );

return { 'mode' => qw| size |, 'data' => "<< encrypt failed >>\n" }
    if not defined $result;

return {
    'mode' => qw| size |,
    'data' => sprintf( "%s\n", encode_b32r($result) )
};

