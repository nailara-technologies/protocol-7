## [:< ##

# name = base.register_bin_deps

my %binaries = map { $ARG => TRUE } @ARG;
my $zenka    = <system.zenka.name>;
my $cfg_path = <system.conf_path>;
my $warned   = <base.register_bin_deps.warned> //= 0;
my $bin_deps = <[base.get_path.zenka_cfg]>;

my $file_perm = 0664;    ## zenka group gets write access ##

my @not_registered;

if ( $bin_deps =~ s|zenki/$zenka/start$|$cfg_path/zenki/$zenka/os-dep/binary|
    and -d $bin_deps
    and -r $bin_deps ) {

    ## Get parent directory owner [taeki in dev, root in production] ##
    my ($parent_uid) = <[base.path_owners]>->($bin_deps);
    unless ( defined $parent_uid ) {
        <[base.logs]>->(
            0,
            "<< register_bin_deps : cannot get parent dir owner for '%s' >>",
            $bin_deps
        );
        return undef;
    }

    ## Get zenka group [httpd, httpsd, etc.] ##
    my $zenka_group = <system.amos-zenka-user> // qw| protocol-7 |;
    my $gid         = getgrnam($zenka_group)
        or <[base.logs]>->(
        0, "<< register_bin_deps : unix group '%s' not in passwd >>",
        $zenka_group
        ) and return undef;

    my $bin_stat = File::stat::stat($bin_deps);

    my $skip_chmod = TRUE;    ## skip chmod if root and standalone ##
    if ( $EUID == 0 ) {
        foreach my $start_type (qw| v7-started-zenka cube v7 |) {
            $skip_chmod = FALSE
                and last
                if defined <system.zenka.type>
                and <system.zenka.type> eq $start_type;
        }
    }

    foreach my $bin_name ( <[base.reverse-sort]>->( \%binaries ) ) {
        my $bin_file = join( qw| / |, $bin_deps, $bin_name );

        ## create file if it doesn't exist ##
        if ( !-e $bin_file ) {
            if ( -w $bin_deps ) {
                my $fh;    ## use mknod to create empty files ##  [LLL]
                open( $fh, qw| > |, $bin_file )
                    and close($fh);
            } else {
                push( @not_registered, $bin_name );
                next;
            }
        }

        ( my $relpath = $bin_file ) =~ s|^.*/||;

        ## always chown to fix existing root-owned files,
        ## even in standalone zenka mode .., ##
        if ( $EUID == 0 ) {
            chown( $parent_uid, $gid, $bin_file )
                or <[base.logs]>->(
                2,        ':. : cannot chown %s : %s .:',
                $relpath, <[base.str.os_err]>
                );
        }

        next if $skip_chmod;    ## skip chmod only [ root + standalone ] ##

        ## chmod ##
        chmod( $file_perm, $bin_file )
            or <[base.logs]>->(
            2,        ":. : '%s' : chmod : %s .:",
            $relpath, <[base.str.os_err]>
            );
    }
}

if ( @not_registered and not $warned ) {
    <[base.log]>->(
        0,
        'cannot check \ register binary dep. '
            . join( ', ', map { sprintf qw| '%s' |, $ARG } @not_registered )
            . ' [ os-dep dir read-only ]'
    );
    <base.register_bin_deps.warned>++;
}

