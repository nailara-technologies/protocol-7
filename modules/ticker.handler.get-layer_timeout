## [:< ##

# name  = ticker.handler.get-layer_timeout
# descr = bounded-fallback timer handler for the cube.tile.get-layer request
#         sent from ticker.startup. fires when the tile layer reply does not
#         arrive within the configured window [ tile offline / stuck ]: opens
#         the ticker window with the default stacking layer instead of hanging
#         until the v7 start-up timeout. the real reply [ get-layer_reply ]
#         resolves + cancels this timer first, so this only runs when no reply
#         was processed.

## real reply already opened the window -- nothing to do ##
return if <ticker.layer_resolved>;
<ticker.layer_resolved> = TRUE;

delete <ticker.layer_timer>;

<[base.log]>->(
    1, '[get-layer] fallback timer fired -- opening with default layer'
);

## same swap-edge decision as get-layer_reply : a popup is invisible under  ##
## WSLg without a parent, so swap mode needs a managed toplevel window.      ##
if ( not <ticker.window.force_above>
    and <[base.cfg_bool]>->(<ticker.mouse.swap_edge>) ) {
    <[base.log]>->( 1, ': swap mode enabled, using managed toplevel window' );
    <ticker.window.force_above> = TRUE;
}

<[ticker.open_window]>;

