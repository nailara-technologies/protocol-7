## [:< ##

# name  = signal.cancel.init_code
# descr = initialize signal cancellation library and register commands

my $reinit = $ARG[0] // FALSE;

<[base.perlmod.load]>->('YAML::XS')
    if not <[base.perlmod.loaded]>->('YAML::XS');

my %cmd_map = (
    'signal.filter'                  => 'signal.cancel.cmd.filter',
    'signal.cancel.filter'           => 'signal.cancel.cmd.filter',
    'signal.cancel.check-line'       => 'signal.cancel.cmd.check-line',
    'signal.cancel.scan-baseline'    => 'signal.cancel.cmd.scan-baseline',
    'signal.cancel.add-pattern'      => 'signal.cancel.cmd.add-pattern',
    'signal.cancel.baseline-capture' => 'signal.cancel.cmd.baseline-capture',
);

while ( my ( $cmd_name, $sub_name ) = each %cmd_map ) {
    if ( exists $code{$sub_name} ) {
        <base.cmd>->{$cmd_name} = $sub_name;
    } else {
        <[base.logs]>->(
            0, 'signal.cancel.init_code: handler %s not loaded', $sub_name
        );
    }
}

## preload pattern library so errors surface early ##
<[signal.cancel.load]>->() if exists $code{'signal.cancel.load'};

0;

