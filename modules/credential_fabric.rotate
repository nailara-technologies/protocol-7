## [:< ##

# name  = credential_fabric.rotate
# descr = perform credential rotation for a slot and notify subscribers.
#         args: { slot => '...', new_value => '...', reason => '...' }

my $params = shift;

return { 'mode' => qw| false |, 'data' => 'expected hashref' }
    if ref $params ne qw| HASH |;

my $slot      = $params->{'slot'}      // '';
my $new_value = $params->{'new_value'} // '';
my $reason    = $params->{'reason'}    // qw| manual |;

return { 'mode' => qw| false |, 'data' => 'missing slot' }
    unless length $slot;
return { 'mode' => qw| false |, 'data' => 'missing new_value' }
    unless length $new_value;

my $meta = <credential_fabric.registry>->{$slot};
return {
    'mode' => qw| false |,
    'data' => "unknown slot '$slot'"
    }
    if not defined $meta;

## write new encrypted value to tier-1 storage ##
my $write_ok
    = <[credential_fabric.store.local]>->( qw| write |, $slot, $new_value );

return {
    'mode' => qw| false |,
    'data' => 'failed to store rotated credential'
    }
    if not $write_ok;

## update registry metadata ##
$meta->{'rotated'}       = <[base.time]>->(3);
$meta->{'rotate_reason'} = $reason;

## persist registry ##
eval {
    my $yaml_str = YAML::XS::Dump(<credential_fabric.registry>);
    <[file.zenka_dir.write]>->( 'registry.yaml', \$yaml_str, '>', 0600 );
};

## audit log ##
<[base.logs]>->(
    1,     'credential_fabric: rotated slot %s [reason: %s]',
    $slot, $reason
);

## push STRM notification to subscribers ##
<[credential_fabric.handler.rotation_strm]>->( $slot, $reason );

return { 'mode' => qw| true |, 'data' => 'rotated' };

