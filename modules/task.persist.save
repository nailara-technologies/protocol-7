## [:< ##

# name  = task.persist.save
# descr = save task queue to disk as yaml

<[format.yaml.pre_init]>;

my $queue_file = 'queue.yaml';

my $data = {
    'queue'       => <task.queue>,
    'queue_order' => <task.queue.order>,
    'saved_at'    => <[base.time]>->(3)
};

my $yaml_str = <[format.yaml.dump_str]>->($data);

if ( not defined $yaml_str or not length $yaml_str ) {
    <[base.s_warn]>->('task.persist.save: yaml serialization failed');
    return FALSE;
}

my $written = <[file.zenka_dir.write]>->( $queue_file, \$yaml_str );

if ( not defined $written ) {
    <[base.s_warn]>->('task.persist.save: failed to write queue file');
    return FALSE;
}

return TRUE;

