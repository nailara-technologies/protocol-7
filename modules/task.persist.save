## [:< ##

# name  = task.persist.save
# descr = save task queue to disk as yaml

<[format.yaml.pre_init]>;

my $path = <task.cfg.persist_path>;

my $data = {
    'queue'       => <task.queue>,
    'queue_order' => <task.queue.order>,
    'saved_at'    => <[base.time]>->(3)
};

my ( $ok, $err ) = <[format.yaml.write_file]>->( $path, $data );

if ( not $ok ) {
    <[base.s_warn]>->( 'task.persist.save: failed to write [ %s ]', $path );
    return FALSE;
}

return TRUE;

