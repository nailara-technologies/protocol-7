## [:< ##

# name  = letsencr.parent.handler_enrollment_reply
# descr = handle enrollment command reply from child process (processes TRUE/FALSE/SIZE responses)

my $reply_data = shift;

my $domain = $reply_data->{'params'}{'domain'};
my $mode   = $reply_data->{'cmd'};
my $args   = $reply_data->{'call_args'}{'args'};
my $data   = $reply_data->{'data'} // '';

unless ($domain) {
    <[base.log]>->(
        1, 'error: enrollment reply handler missing domain in params'
    );
    return FALSE;
}

<[base.logs]>->(
    2,       'enrollment reply for domain: %s, mode: %s',
    $domain, $mode
);

<[letsencr.parent.activity_logger]>->(
    'enrollment', $domain, 'pending',
    sprintf( 'child replied with mode: %s', $mode )
);

if ( $mode eq 'TRUE' ) {
    <[base.logs]>->( 2, 'enrollment succeeded for %s', $domain );
    <[letsencr.parent.activity_logger]>->(
        'enrollment', $domain, 'success', 'certificate enrollment completed'
    );

} elsif ( $mode eq 'FALSE' ) {
    <[base.logs]>->( 1, 'enrollment failed for %s: %s', $domain, $data );
    <[letsencr.parent.activity_logger]>->(
        'enrollment', $domain, 'failed', "ACME error: $data"
    );

    ## Schedule retry with exponential backoff
    my $attempt = ( $reply_data->{'params'}{'attempt'} // 1 ) + 1;

    if ( $attempt <= 3 ) {
        my @backoff_delays = ( 300, 900, 1800 )
            ;    ## 5min, 15min, 30min (shorter for enrollment than renewal)
        my $delay = $backoff_delays[ $attempt - 1 ] // 1800;

        <[base.logs]>->(
            2,
            'scheduling enrollment retry for %s in %d seconds (attempt %d)',
            $domain, $delay, $attempt
        );

        <[letsencr.parent.activity_logger]>->(
            'enrollment', $domain, 'pending',
            "retry scheduled in $delay seconds (attempt $attempt)"
        );

        ## Store retry data in a module variable for the handler to retrieve
        <letsencr.parent.pending_retry>->{$domain} = {
            'domain'  => $domain,
            'attempt' => $attempt,
        };

        <[event.add_timer]>->(
            {   'delay'   => $delay,
                'handler' => qw| letsencr.parent.handler_enrollment_retry |,
                'cb_data' => $domain,
            }
        );
    } else {
        <[base.logs]>->(
            0, 'enrollment failed for %s after 3 attempts - giving up',
            $domain
        );
        <[letsencr.parent.activity_logger]>->(
            'enrollment', $domain, 'failed', 'max retries exceeded'
        );
    }

} elsif ( $mode eq 'SIZE' ) {
    <[base.logs]>->(
        2,       'enrollment returned certificate data for %s (%d bytes)',
        $domain, length($data)
    );

    ## Parse certificate bundle from base32r encoded JSON
    my $bundle_json;
    eval {
        $bundle_json
            = JSON::XS::decode_json( Crypt::Misc::decode_b32r($data) );
    };

    if ($EVAL_ERROR) {
        <[base.logs]>->(
            1,       'failed to decode certificate bundle for %s: %s',
            $domain, $EVAL_ERROR
        );
        <[letsencr.parent.activity_logger]>->(
            'enrollment', $domain, 'failed',
            "failed to decode certificate: $EVAL_ERROR"
        );
        return FALSE;
    }

    ## validate bundle has required fields
    unless ( $bundle_json->{certificate} && $bundle_json->{key} ) {
        <[base.logs]>->(
            1, 'certificate bundle missing required fields for %s', $domain
        );
        <[letsencr.parent.activity_logger]>->(
            'enrollment', $domain, 'failed', 'certificate bundle invalid'
        );
        return FALSE;
    }

    ## Save certificate using existing infrastructure
    my $save_result = <[letsencr.parent.save_certificate]>->(
        {   domain          => $domain,
            certificate_pem => $bundle_json->{certificate},
            chain_pem       => $bundle_json->{chain} // '',
            private_key_pem => $bundle_json->{key},
            expires_at      => $bundle_json->{expires_at},
            alt_names       => $bundle_json->{domains} // [],
            account_id      => <letsencr.parent.acme_account> {account_id},
        }
    );

    unless ($save_result) {
        <[base.logs]>->( 1, 'failed to save certificate for %s', $domain );
        <[letsencr.parent.activity_logger]>->(
            'enrollment', $domain, 'failed', 'failed to save certificate'
        );
        return FALSE;
    }

    <[base.logs]>->( 2, 'certificate saved for %s', $domain );
    <[letsencr.parent.activity_logger]>->(
        'enrollment', $domain, 'success', 'certificate saved to disk'
    );

    ## update certificate registry
    <letsencr.parent.certs> {$domain} = {
        issued_at  => time(),
        expires_at => $bundle_json->{expires_at},
        domain     => $domain,
        status     => 'active',
        cert_path  => sprintf( '%s/%s.pem', <letsencr.certs.dir>, $domain ),
        key_path   => sprintf( '%s/%s.key', <letsencr.certs.dir>, $domain ),
        alt_names  => $bundle_json->{domains} || [],
        account_id => <letsencr.parent.acme_account> {account_id},
    };

    ## install certificate to httpsd
    <[base.logs]>->( 2, 'installing certificate to httpsd for %s', $domain );

    my $httpsd_install_result
        = <[letsencr.parent.install_certificate_to_httpsd]>->($domain);

    if ( $httpsd_install_result->{status} eq qw| success | ) {
        <[base.logs]>->( 2, 'certificate installed to httpsd successfully' );
        <[letsencr.parent.activity_logger]>->(
            qw| enrollment |,
            $domain, qw| success |, qq| installed to httpsd and reloaded |
        );
    } elsif ( $httpsd_install_result->{status} eq qw| partial | ) {
        <[base.logs]>->(
            1,
            'certificate installed but httpsd reload failed: %s',
            $httpsd_install_result->{message}
        );
        <[letsencr.parent.activity_logger]>->(
            qw| enrollment |,
            $domain, qw| partial |, qq| installed but httpsd reload failed |
        );
    } else {
        <[base.logs]>->(
            1,
            'failed to install certificate to httpsd: %s',
            $httpsd_install_result->{message}
        );
        <[letsencr.parent.activity_logger]>->(
            qw| enrollment |,
            $domain, qw| partial |,
            qq| certificate saved but httpsd install failed |
        );
    }

    ## Notify HTTPd that certificate has been installed
    my $notify_result
        = <[letsencr.parent.notify_httpd_certificate_update]>->(
        {   domain    => $domain,
            cert_path =>
                sprintf( '%s/%s.pem', <letsencr.certs.dir>, $domain ),
            key_path => sprintf( '%s/%s.key', <letsencr.certs.dir>, $domain ),
        }
        );

    if ( !$notify_result || $notify_result->{status} ne 'success' ) {
        <[base.logs]>->(
            1,
            'warning: failed to notify httpd of certificate installation for %s',
            $domain
        );
        <[letsencr.parent.activity_logger]>->(
            'enrollment', $domain, 'success',
            'certificate installed but httpd notification failed'
        );
    } else {
        <[letsencr.parent.activity_logger]>->(
            'enrollment', $domain, 'success',
            'certificate installed and httpd notified'
        );
    }

} else {
    <[base.logs]>->(
        1,     'enrollment got unexpected mode: %s for %s',
        $mode, $domain
    );
    <[letsencr.parent.activity_logger]>->(
        'enrollment', $domain, 'failed', "unexpected response mode: $mode"
    );
}

return FALSE;

