## [:< ##

# name  = letsencr.parent.handler_enrollment_reply

# descr = handle enrollment command reply from child process
#                      [ processes TRUE|FALSE|SIZE responses ]

my $reply = shift;

my $domain     = $reply->{'params'}->{'domain'};
my $mode       = $reply->{'cmd'};
my $args       = $reply->{'call_args'}->{'args'};
my $reply_data = $reply->{'data'} // '';

unless ($domain) {
    <[base.log]>->(
        1, 'error : enrollment reply handler missing domain in params'
    );
    return FALSE;
}

<[base.logs]>->(
    2,       'enrollment reply for domain : %s, mode : %s',
    $domain, $mode
);

<[letsencr.parent.activity_logger]>->(
    qw| enrollment |,
    $domain, qw| pending |, sprintf( 'child replied with mode : %s', $mode )
);

if ( $mode eq qw| TRUE | ) {
    ## distinguish between async [deferred] vs sync [success] based on data
    ## content async returns base32r-encoded challenge info, sync returns
    ## simple message
    my $challenge_info;
    eval {
        $challenge_info
            = JSON::XS::decode_json( Crypt::Misc::decode_b32r($reply_data) );
    };

    if ( length $EVAL_ERROR && $challenge_info->{status} eq qw|deferred| ) {
        ## ASYNC CASE: Parent orchestrates challenge setup with httpd
        <[base.logs]>->( 2, 'async enrollment initiated for %s', $domain );
        <[letsencr.parent.activity_logger]>->(
            qw| enrollment |,
            $domain, qw| pending |,
            'async processing: orchestrating challenge setup'
        );

        ## [todo] Extract challenges from order and call
        ## notify_httpd_challenge Store challenge_info for continuation
        ## handler to access

        <letsencr.parent.pending_challenges>->{$domain} = $challenge_info;

        <[base.logs]>
            ->( 2, 'challenge orchestration queued for %s', $domain );

    } else {
        ## SYNC CASE: Certificate enrollment completed synchronously
        <[base.logs]>->( 2, 'enrollment succeeded for %s', $domain );
        <[letsencr.parent.activity_logger]>->(
            qw| enrollment |,
            $domain, qw| success |, 'certificate enrollment completed'
        );
    }

} elsif ( $mode eq qw| FALSE | ) {
    <[base.logs]>
        ->( 1, 'enrollment failed for %s: %s', $domain, $reply_data );
    <[letsencr.parent.activity_logger]>->(
        qw| enrollment |,
        $domain, qw| failed |, sprintf 'ACME error: %s', $reply_data
    );

    ## Schedule retry with exponential backoff
    my $attempt = ( $reply_data->{'params'}{'attempt'} // 1 ) + 1;

    if ( $attempt <= 3 ) {
        my @backoff_delays = ( 300, 900, 1800 )
            ;    ## 5min, 15min, 30min (shorter for enrollment than renewal)
        my $delay = $backoff_delays[ $attempt - 1 ] // 1800;

        <[base.logs]>->(
            2,
            'scheduling enrollment retry for %s in %d seconds [attempt:%d]',
            $domain, $delay, $attempt
        );

        <[letsencr.parent.activity_logger]>->(
            qw| enrollment |,
            $domain, qw| pending |,
            "retry scheduled in $delay seconds [attempt:$attempt]"
        );

        ## Store retry data in a module variable for the handler to retrieve
        <letsencr.parent.pending_retry>->{$domain} = {
            'domain'  => $domain,
            'attempt' => $attempt,
        };

        <[event.add_timer]>->(
            {   'delay'   => $delay,
                'handler' => qw| letsencr.parent.handler_enrollment_retry |,
                'cb_data' => $domain,
            }
        );
    } else {
        <[base.logs]>->(
            0, 'enrollment failed for %s after 3 attempts - giving up',
            $domain
        );
        <[letsencr.parent.activity_logger]>->(
            qw| enrollment |,
            $domain, qw| failed |, 'max retries exceeded'
        );
    }

} elsif ( $mode eq qw| SIZE | ) {
    <[base.logs]>->(
        2,       'enrollment returned certificate data for %s [bytes:%d]',
        $domain, length($reply_data)
    );

    ## decode base32r [ no eval - preserve errors ]
    chomp($reply_data);    ## remove trailing newline from transmission
    my $decoded_data = Crypt::Misc::decode_b32r($reply_data);
    unless ($decoded_data) {
        <[base.logs]>->( 1, 'failed to decode base32r for %s', $domain );
        <[letsencr.parent.activity_logger]>->(
            qw| enrollment |,
            $domain, qw| failed |, 'failed to decode base32r bundle'
        );
        return FALSE;
    }

    ## parse JSON [ eval to catch JSON decode errors ]
    my $bundle_json;
    eval { $bundle_json = JSON::XS::decode_json($decoded_data); };

    if ( length $EVAL_ERROR ) {
        <[base.logs]>->(
            1,       'failed to parse JSON for %s: %s',
            $domain, <[base.str.eval_error]>
        );
        <[letsencr.parent.activity_logger]>->(
            qw| enrollment |,
            $domain, qw| failed |, sprintf 'failed to parse certificate : %s',
            <[base.str.eval_error]>
        );
        return FALSE;
    }

    ## validate bundle has required fields
    unless ( $bundle_json->{certificate} && $bundle_json->{key} ) {
        <[base.logs]>->(
            1, 'certificate bundle missing required fields for %s', $domain
        );
        <[letsencr.parent.activity_logger]>->(
            qw| enrollment |,
            $domain, qw| failed |, 'certificate bundle invalid'
        );
        return FALSE;
    }

    ## Save certificate using existing infrastructure
    my $save_result = <[letsencr.parent.save_certificate]>->(
        {   domain          => $domain,
            certificate_pem => $bundle_json->{certificate},
            chain_pem       => $bundle_json->{chain} // '',
            private_key_pem => $bundle_json->{key},
            expires_at      => $bundle_json->{expires_at},
            alt_names       => $bundle_json->{domains} // [],
            account_id      => <letsencr.parent.acme_account>->{account_id},
        }
    );

    unless ($save_result) {
        <[base.logs]>->( 1, 'failed to save certificate for %s', $domain );
        <[letsencr.parent.activity_logger]>->(
            qw| enrollment |,
            $domain, qw| failed |, 'failed to save certificate'
        );
        return FALSE;
    }

    <[base.logs]>->( 2, 'certificate saved for %s', $domain );
    <[letsencr.parent.activity_logger]>->(
        qw| enrollment |,
        $domain, qw| success |, 'certificate saved to disk'
    );

    ## update certificate registry
    <letsencr.parent.certs>->{$domain} = {
        issued_at  => <[base.time]>,
        expires_at => $bundle_json->{expires_at},
        domain     => $domain,
        status     => qw| active |,
        cert_path  => sprintf( '%s/%s.pem', <letsencr.certs.dir>, $domain ),
        key_path   => sprintf( '%s/%s.key', <letsencr.certs.dir>, $domain ),
        alt_names  => $bundle_json->{domains} || [],
        account_id => <letsencr.parent.acme_account>->{account_id},
    };

    ## install certificate to httpsd
    <[base.logs]>->( 2, 'installing certificate to httpsd for %s', $domain );

    my $httpsd_install_result
        = <[letsencr.parent.install_certificate_to_httpsd]>->($domain);

    if ( $httpsd_install_result->{status} eq qw| success | ) {
        <[base.logs]>->( 2, 'certificate installed to httpsd successfully' );
        <[letsencr.parent.activity_logger]>->(
            qw| enrollment |,
            $domain, qw| success |, qq| installed to httpsd and reloaded |
        );
    } elsif ( $httpsd_install_result->{status} eq qw| partial | ) {
        <[base.logs]>->(
            1,
            'certificate installed but httpsd reload failed: %s',
            $httpsd_install_result->{message}
        );
        <[letsencr.parent.activity_logger]>->(
            qw| enrollment |,
            $domain, qw| partial |, qq| installed but httpsd reload failed |
        );
    } else {
        <[base.logs]>->(
            1,
            'failed to install certificate to httpsd: %s',
            $httpsd_install_result->{message}
        );
        <[letsencr.parent.activity_logger]>->(
            qw| enrollment |,
            $domain, qw| partial |,
            qq| certificate saved but httpsd install failed |
        );
    }

    ## Notify HTTPd that certificate has been installed
    my $notify_result
        = <[letsencr.parent.notify_httpd_certificate_update]>->(
        {   domain    => $domain,
            cert_path =>
                sprintf( '%s/%s.pem', <letsencr.certs.dir>, $domain ),
            key_path => sprintf( '%s/%s.key', <letsencr.certs.dir>, $domain ),
        }
        );

    if ( !$notify_result || $notify_result->{'status'} ne qw| success | ) {
        <[base.logs]>->(
            1,
            'warning: failed to notify httpd of certificate installation for %s',
            $domain
        );
        <[letsencr.parent.activity_logger]>->(
            qw| enrollment |,
            $domain, qw| success |,
            'certificate installed but httpd notification failed'
        );
    } else {
        <[letsencr.parent.activity_logger]>->(
            qw| enrollment |,
            $domain, qw| success |,
            'certificate installed and httpd notified'
        );
    }

} else {
    <[base.logs]>->(
        1,     'enrollment got unexpected mode: %s for %s',
        $mode, $domain
    );
    <[letsencr.parent.activity_logger]>->(
        qw| enrollment |,
        $domain, qw| failed |, "unexpected response mode: $mode"
    );
}

return FALSE;

