# name = coding.task.enqueue
# descr = enqueue coding task with jobqueue backend
# purpose = coding task management : wrapper around jobqueue.add_job with priority calculation

my ($task) = @ARG;

return {
    success => FALSE,
    error   => 'task must be a hashref'
} unless ref($task) eq 'HASH';

return {
    success => FALSE,
    error   => 'task must have id'
} unless exists $task->{id};

# calculate priority based on task type
my $priority = <[coding.helper.task_priority]>->( $task->{type} // 'general', $task );

# prepare job params for jobqueue
my $job_params = {
    name             => $task->{id},
    priority         => $priority,
    object_id        => $task->{id},
    target_queue     => 'queued',
    job_callback     => 'coding.task.execute',
    callback_params  => $task,
};

# add to jobqueue
my $job_id = <[jobqueue.add_job]>->($job_params);

return {
    success => TRUE,
    job_id  => $job_id,
    task_id => $task->{id},
    message => "task enqueued : $task->{id}"
};

