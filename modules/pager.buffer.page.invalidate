## [:<
# name  = pager.buffer.page.invalidate
# descr = Invalidate specific page in cache
## >:]

return sub {
    my ($args) = @_;

    my $buf = $args->{'buffer'};
    my $page_num = $args->{'page_num'};

    return 0 unless $buf;

    if (defined $page_num) {
        # Invalidate specific page
        if (exists $buf->{'pages'}{'cached'}{$page_num}) {
            my $count = scalar(@{$buf->{'pages'}{'cached'}{$page_num}});
            delete $buf->{'pages'}{'cached'}{$page_num};
            @{$buf->{'pages'}{'lru'}} = grep { $_ != $page_num } @{$buf->{'pages'}{'lru'}};
            $buf->{'memory'}{'current'} -= $count;
            $buf->{'memory'}{'current'} = 0 if $buf->{'memory'}{'current'} < 0;
            return 1;
        }
        return 0;
    }
    else {
        # Invalidate all pages
        my $total = scalar(keys %{$buf->{'pages'}{'cached'}});
        $buf->{'pages'}{'cached'} = {};
        $buf->{'pages'}{'lru'} = [];
        $buf->{'pages'}{'dirty'} = {};
        $buf->{'memory'}{'current'} = 0;
        return $total;
    }
};

