## [:< ##

# name = coding.task.queue_fail
# descr = mark task as failed and move to failed list
# purpose = Queue operation: Record task failure with error

my ( $task_id, $error ) = @ARG;

# Get persistent storage refs
my $queue_href  = <coding.task.queue>;
my $aref_active = <coding.task.active>;
my $aref_failed = <coding.task.failed>;

return {
    success => FALSE,
    error   => "task not found: $task_id"
    }
    unless exists $queue_href->{$task_id};

my $task = $queue_href->{$task_id};

$task->{'execution'}->{'status'}    = qw| failed |;
$task->{'execution'}->{'completed'} = <[base.ntime]>;
$task->{'execution'}->{'success'}   = 0;
$task->{'execution'}->{'error'}     = $error // qq| unknown error |;

# Move from active to failed
$aref_active->@* = grep { $ARG ne $task_id } $aref_active->@*;
push $aref_failed->@*, $task_id;

<[base.logs]>->(
    0, "task failed : %s : %s",
    $task_id, ( $error // 'unknown error' )
);

return {
    success => TRUE,
    task_id => $task_id,
    error   => $error,
    message => "Task failed: $task_id"
};

