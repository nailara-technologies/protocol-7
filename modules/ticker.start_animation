## [:< ##

# name = ticker.start_animation

<[base.log]>->( 1, "<<... starting ticker text animation ...>>" );

my $window = <ticker.obj.window>;

<ticker.animation_started> = 1;

if ( not $window->get_visible or <ticker.is-iconified>-- ) {
    my $was_hidden = not $window->get_visible;
    if (    $was_hidden
        and not <ticker.mouse.inside>
        and <ticker.is_composited> ) {
        <ticker.fade_opacity> = 0;
        $window->set_opacity(0);
    }
    <ticker.obj.window>->show;
    <[base.X-11.unhide_window]>->(<x11.id>) if defined <x11.id>;
    <ticker.is-iconified>      = 0;
    <ticker.mouse.inside>      = FALSE;
    <ticker.mouse.grace_until> = <[base.time]>->(5) + 1.5;
    <[base.log]>->( 1, 'showing window' );
}

if ( defined <x11.id> ) {
    <ticker.timer.fade>->cancel if defined <ticker.timer.fade>;
    delete <ticker.time.fade_view>;  ## keep opacity for smooth transitions ##

    my $handler;
    if (<ticker.mouse.inside>) {
        <[base.log]>->( 1, 'mouse is inside ticker window, keeping below' );
        <[base.X-11.keep_below]>->(<x11.id>);
        $handler = qw| ticker.handler.fade_out |;
    } else {
        <[base.X-11.keep_above]>->(<x11.id>);
        <[base.X-11.raise_window]>->(<x11.id>);
        $handler = qw| ticker.handler.fade_in |;
    }

    if ( <ticker.use_transparency> and <ticker.do_custom_fade_in> ) {
        <ticker.timer.fade> = <[event.add_timer]>->(
            {   'after'    => 0,
                'interval' => 0.017,
                'handler'  => $handler
            }
        );
    }
}

$window->queue_draw();

