# name  = jobsite.cmd.blacklist-stats
# descr = show checksum index statistics

my $stats = <[jobsite.checksum.index]>->(qw| stats |);

my $out = sprintf( "checksum index: companies=%d titles=%d urls=%d",
    $stats->{'companies'}, $stats->{'titles'}, $stats->{'urls'} );

return { 'mode' => qw| true |, 'data' => $out };

