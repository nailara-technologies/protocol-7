## [:< ##

# name  = index.cmd.lookup
# descr = look up index entries by input string or address prefix

my $args = $call->{'args'} // '';
return { 'mode' => 'false', 'data' => 'expected input' } unless length $args;

my $path  = <[index.gen_path]>->( \$args );
my $store = <index.path.index-files> . '/' . $path;

return { 'mode' => 'false', 'data' => 'not found' } unless -d $store;

my $dir_fh;
opendir( $dir_fh, $store )
    or return { 'mode' => 'false', 'data' => 'cannot read directory' };
my @entries = grep { !/^\.{1,2}$/ } readdir($dir_fh);
closedir($dir_fh);

return { 'mode' => 'size', 'data' => join( "\n", @entries ) };

