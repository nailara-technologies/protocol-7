# name  = coding.async.state_manager
# descr = manage state for async/deferred coding tasks
# purpose = Phase 1: Store and retrieve task state for deferred execution

my $action  = shift // 'get';
my $task_id = shift;

return undef unless defined $task_id;

if ( $action eq 'get' ) {
    return <coding.async.task_state>->{$task_id};
} elsif ( $action eq 'set' ) {
    my $state = shift // {};
    <coding.async.task_state>->{$task_id} = $state;
    return $state;
} elsif ( $action eq 'delete' ) {
    return delete <coding.async.task_state>->{$task_id};
} elsif ( $action eq 'exists' ) {
    return exists <coding.async.task_state>->{$task_id} ? TRUE : FALSE;
} elsif ( $action eq 'list' ) {
    return [ keys <coding.async.task_state>->%* ];
}

return undef;

