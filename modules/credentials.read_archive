## [:< ##

# name  = credentials.read_archive
# descr = read and decrypt credential archive file
#         adapted from keys.read_key_archive pattern

my $src_path_abs   = shift // '';
my $decryption_pwd = shift // '';

my $block_size = <credentials.size.archive_block> // 13312;

if ( not length $src_path_abs ) {
    warn 'expecting archive file path parameter <{C1}>';
    return undef;
} elsif ( not length $decryption_pwd ) {
    warn 'decryption password parameter required <{C1}>';
    return undef;
} elsif ( -d $src_path_abs ) {
    warn 'archive path is a directory <{C1}>';
    return undef;
} elsif ( -z $src_path_abs ) {
    warn 'archive file is empty <{C1}>';
    return undef;
} elsif ( not -e $src_path_abs ) {
    warn 'specified archive file not found <{C1}>';
    return undef;
} elsif ( not -r $src_path_abs ) {
    warn 'archive file not readable <{C1}>';
    return undef;
}

my $content_ref = <[file.slurp]>->( $src_path_abs, qw| :raw | );
if ( not defined $content_ref or not length $content_ref->$* ) {
    warn 'cannot read credential archive <{C1}>';
    return undef;
}

my $dec_key_32 = AMOS7::13::key_32( \$decryption_pwd );

if ( not defined $dec_key_32 or not length $dec_key_32 ) {
    warn 'error during file dec key derivation <{C1}>';
    return undef;
}
my $status
    = AMOS7::Twofish::key_init( $dec_key_32, qw| decryption credentials | );

if ( not defined $status or not $status ) {
    warn 'error during initializing of archive file'
        . ' decryption key <{C1}>';
    return undef;
}

my $decrypted_sref
    = AMOS7::Twofish::decrypt( qw| credentials |, $content_ref );

AMOS7::Twofish::delete_table_entry(qw| decryption credentials |);

my $decrypted_size = length( $decrypted_sref->$* // '' );

if (   not defined $decrypted_sref
    or ref $decrypted_sref ne qw| SCALAR |
    or $decrypted_size < $block_size
    or $decrypted_size % $block_size != 0 ) {
    warn 'archive file decryption error <{C1}>';
    return undef;
}

## extracting possible payload offsets ##
my $offset_limit   = int( 8 * $decrypted_size * 0.7 );
my $offset_max_len = length pack qw| w |, $offset_limit;

my @payload_bit_offsets;
foreach my $byte_len ( 1 .. $offset_max_len ) {
    my $possible_comp_int_bin = substr $decrypted_sref->$*, -$byte_len;
    next if not <[base.comp-int.is_valid]>->($possible_comp_int_bin);
    my $possible_offset_num = unpack qw| w |, $possible_comp_int_bin;
    push @payload_bit_offsets, $possible_offset_num;
}

if ( @payload_bit_offsets == 0 ) {
    warn 'found no payload offset' . ' [ correct password ? ] <{C1}>';
    return undef;
}

my $matching_offset;
foreach my $offset (@payload_bit_offsets) {
    my $payload_data_ref = <[base.parser.splice_out_data]>
        ->( $decrypted_sref, $offset, 2, 80 );
    if ( ref $payload_data_ref ne qw| SCALAR | ) {
        <[base.log]>->( 0, 'error during payload extraction' );
        return undef;
    }
    $matching_offset = $offset
        if $payload_data_ref->$* eq "## [:< ##\n";
}

if ( not defined $matching_offset ) {
    warn 'payload header not found' . ' [ password correct ? ] <{C1}>';
    return undef;
}

my $max_payload_bit_length = sprintf qw| %u |,
    8 + ( 8 * $decrypted_size ) / 3;

my $payload_data_ref = <[base.parser.splice_out_data]>->(
    $decrypted_sref, $matching_offset, 2, $max_payload_bit_length
);

my $archive_end_pos = rindex $payload_data_ref->$*, '#.::';

if ( $archive_end_pos == -1 ) {
    warn 'payload end not found' . ' [ archive corrupted ? ] <{C1}>';
    return undef;
} else {
    $archive_end_pos += 5;
}

substr( $payload_data_ref->$*, $archive_end_pos,
    length( $payload_data_ref->$* ) - $archive_end_pos, '' );

return $payload_data_ref;

