## [:< ##
# name  = coding.tools.handler.read_file
# descr = dispatch read_file tool call to context.file handler

my $args = shift // {};

return unless exists $code{'context.file'};

## offset/length as line numbers (model-friendly pagination) ##
my $from_line = $args->{'from_line'} // $args->{'offset'} // 1;
my $to_line   = $args->{'to_line'}   // 0;

## if length given, derive to_line from from_line + length ##
if ( !$to_line && ( $args->{'length'} // 0 ) > 0 ) {
    $to_line = $from_line + $args->{'length'} - 1;
}

$from_line = 1 if $from_line < 1;

my $path   = $args->{'path'}   // '';
my $budget = $args->{'budget'} // 8000;

my $result = $code{'context.file'}->(
    {   'path'      => $path,
        'budget'    => $budget,
        'from_line' => $from_line,
        'to_line'   => $to_line,
    }
);

## count total lines in file for pagination display ##
my $total_lines = 0;
if ( length $path && -f $path ) {
    if ( open my $fh, '<', $path ) {
        $total_lines++ while <$fh>;
        close $fh;
    }
}

## wrap truncated output with ASCII pagination UI ##
if ( defined $result && $total_lines > 0 ) {
    my $shown_to
        = $to_line && $to_line < $total_lines ? $to_line : $total_lines;
    my $pct        = int( $shown_to / $total_lines * 100 );
    my $bar_filled = int( $pct / 5 );
    my $bar        = '|' x $bar_filled . ' ' x ( 20 - $bar_filled );
    my $is_partial = $shown_to < $total_lines;

    my $header = sprintf
        ".:[ file: %s  lines %d-%d / %d ]:%s\n",
        $path, $from_line, $shown_to, $total_lines,
        $is_partial ? '' : ' [ end of file ]';

    my $footer;
    if ($is_partial) {
        my $hint = sprintf(
            "offset=%d  [ %d lines remaining of %d ]"
                . "\n:: to continue: read_file path=\"%s\" offset=%d",
            $from_line,   $total_lines - $shown_to,
            $total_lines, $path, $shown_to + 1
        );
        my $hint_box = <[base.parser.txt_box]>->( \$hint, 'truncated' );
        $footer
            = sprintf( "\n::[ %s %3d%% ]::\n%s\n", $bar, $pct, $hint_box );
    } else {
        $footer = sprintf( "\n::[ %s 100%% ]:: [ end of file ]::\n", $bar );
    }

    $result = $header . $result . $footer;
}

return $result;

