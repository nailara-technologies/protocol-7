## [:< ##
# name  = coding.tools.handler.read_file
# descr = dispatch read_file tool call to context.file handler

my $args = shift // {};

return unless exists $code{'context.file'};

## get file content first ##
my $result = $code{'context.file'}->(
    {   'path'      => $args->{'path'}      // '',
        'budget'    => $args->{'budget'}    // 8000,
        'from_line' => $args->{'from_line'} // 1,
        'to_line'   => $args->{'to_line'}   // 0,
    }
);

## apply offset/length pagination if requested ##
my $offset = $args->{'offset'} // 0;
my $length = $args->{'length'} // 0;

if ( $offset > 0 || $length > 0 ) {
    ## extract content from result ##
    if ( ref $result && $result =~ m|\.:\[ .* \]:\.\n\n(.*)|s ) {
        my $content      = $1;
        my $total_length = length $content;

        ## apply offset ##
        if ( $offset > 0 ) {
            $content = substr( $content, $offset );
        }

        ## apply length limit ##
        if ( $length > 0 && length $content > $length ) {
            $content = substr( $content, 0, $length );
            $content
                .= "\n\n... [ truncated, "
                . ( $total_length - $offset - $length )
                . " chars remaining ]";
        }

        ## rebuild result with pagination info ##
        $result
            =~ s|\.:\[ .* \]:\.\n\n.*|.: [ content offset=$offset length=" . length($content) . " total=$total_length ]:.\n\n$content|s;
    }
}

return $result;

