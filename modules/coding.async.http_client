## [:< ##

# name  = coding.async.http_client
# descr = HTTP streaming client using Protocol-7 event system
# purpose = Phase 2: Non-blocking HTTP with chunked response handling

my ( $url, $body, $callbacks ) = @ARG;

return { success => FALSE, error => 'url required' }  unless defined $url;
return { success => FALSE, error => 'body required' } unless defined $body;
return { success => FALSE, error => 'callbacks hashref required' }
    unless ref($callbacks) eq 'HASH';

## Parse URL ##
my ( $host, $port, $path ) = $url =~ m{^http://([^:/]+)(?::(\d+))?(/?.*)$};
$port //= 80;
$path = '/' if !length($path);

## Parse body ##
my $json     = JSON::XS->new->utf8->canonical;
my $body_str = ref($body) ? $json->encode($body) : $body;

## Build HTTP request ##
my $request
    = sprintf( "POST %s HTTP/1.1\r\n"
        . "Host: %s:%d\r\n"
        . "Content-Type: application/json\r\n"
        . "Content-Length: %d\r\n"
        . "Accept: application/json\r\n"
        . "Connection: close\r\n" . "\r\n" . "%s",
    $path, $host, $port, length($body_str), $body_str );

## Create blocking socket for connection ##
my $sock = IO::Socket::IP->new(
    PeerHost => $host,
    PeerPort => $port,
    Type     => SOCK_STREAM(),
    Timeout  => 10,
);

if ( !$sock ) {
    my $error = sprintf "Failed to connect to %s:%d :%s", $host, $port,
        <[base.str.os_err]>;
    <[base.logs]>->( 0, "async.http_client : %s", $error );
    $callbacks->{'on_error'}->($error) if exists $callbacks->{'on_error'};
    return { success => FALSE, error => $error };
}

## Set non-blocking for event loop integration ##
## Write request (blocking is fine for localhost) ##
my $written = syswrite( $sock, $request );
if ( !defined $written || $written != length($request) ) {
    my $error = "Failed to write request: $!";
    <[base.logs]>->( 0, "async.http_client: %s", $error );
    $callbacks->{'on_error'}->($error) if exists $callbacks->{'on_error'};
    close($sock);
    return { success => FALSE, error => $error };
}

<[base.logs]>->( 2, "async.http_client: wrote %d bytes", $written );

## Set socket to non-blocking for event loop ##
use Fcntl qw| F_GETFL F_SETFL O_NONBLOCK |;
my $flags = fcntl( $sock, F_GETFL, 0 );
if ( defined $flags ) {
    fcntl( $sock, F_SETFL, $flags | O_NONBLOCK )
        or <[base.logs]>->(
        0, "async.http_client: failed to set non-blocking: %s", $!
        );
}

## Set up connection state ##
my $state = {
    'sock'            => $sock,
    'buffer'          => '',
    'headers_parsed'  => FALSE,
    'status_code'     => undef,
    'content_type'    => undef,
    'bytes_received'  => 0,
    'chunks_received' => 0,
    'last_activity'   => <[base.time]>->(3),
    'callbacks'       => $callbacks,
    'json_decoder'    => JSON::XS->new->utf8,
    'completed'       => FALSE,
};

## Register socket for read handling ##
my $io_watcher = <[event.add_io]>->(
    {   'fd'      => $sock,
        'handler' => qw| coding.handler.http_io |,
        'data'    => $state,
        ## Default poll is 'r' (read) ##
    }
);

## Set up timeout ##
my $timeout_sec     = $callbacks->{'timeout'} // 780;
my $timeout_watcher = <[event.add_timer]>->(
    {   'after'   => $timeout_sec,
        'handler' => 'coding.handler.http_timeout',
        'data'    => { state => $state, io_watcher => $io_watcher },
    }
);

$state->{'io_watcher'}      = $io_watcher;
$state->{'timeout_watcher'} = $timeout_watcher;

<[base.logs]>->(
    1,     "async.http_client: connection established to %s:%d",
    $host, $port
);

return {
    success => TRUE,
    state   => $state,
};

