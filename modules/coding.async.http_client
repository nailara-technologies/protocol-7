## [:< ##

# name  = coding.async.http_client
# descr = HTTP streaming client using Protocol-7 event system
# purpose = Phase 2 : Non-blocking HTTP with chunked response handling

my ( $url, $body, $callbacks ) = @ARG;

return { success => FALSE, error => 'url required' }  unless defined $url;
return { success => FALSE, error => 'body required' } unless defined $body;
return { success => FALSE, error => qw| callbacks hashref required | }
    unless ref($callbacks) eq qw| HASH |;

my $default_http_timeout = <coding.http-timeouts.request-completed> // 780;

## Parse URL ##
my ( $host, $port, $path ) = $url =~ m{^http://([^:/]+)(?::(\d+))?(/?.*)$};
$port //= 80;
$path = '/' if !length($path);

## Parse body ##
my $json     = JSON::XS->new->utf8->canonical;
my $body_str = ref($body) ? $json->encode($body) : $body;

## Build HTTP request ##
my $request
    = sprintf( "POST %s HTTP/1.1\r\n"
        . "Host: %s:%d\r\n"
        . "Content-Type: application/json\r\n"
        . "Content-Length: %d\r\n"
        . "Accept: application/json\r\n"
        . "Connection: close\r\n" . "\r\n" . "%s",
    $path, $host, $port, length($body_str), $body_str );

## Create blocking socket for connection ##
my $sock = IO::Socket::IP->new(
    PeerHost => $host,
    PeerPort => $port,
    Type     => SOCK_STREAM(),
    Timeout  => 13,
);

if ( !$sock ) {
    my $error = sprintf "Failed to connect to %s:%d : %s", $host, $port,
        <[base.str.os_err]>;
    <[base.logs]>->( 0, "async.http_client : %s", $error );
    $callbacks->{'on_error'}->($error) if exists $callbacks->{'on_error'};
    return { success => FALSE, error => $error };
}

my $req_bytes = bytes::length($request);

## Set up connection state ##
my $state = {
    'sock'            => $sock,
    'buffer'          => '',
    'headers_parsed'  => FALSE,
    'status_code'     => undef,
    'content_type'    => undef,
    'bytes_received'  => 0,
    'chunks_received' => 0,
    'last_activity'   => <[base.time]>->(3),
    'request_start'   => <[base.time]>->(3),
    'callbacks'       => $callbacks,
    'json_decoder'    => JSON::XS->new->utf8,
    'completed'       => FALSE,
};

$sock->blocking(0);

## Register socket for read events ##
my $io_watcher = <[event.add_io]>->(
    {   'fd'      => $sock,
        'handler' => qw| coding.handler.http_io |,
        'data'    => $state,
    }
);

if ( !defined $io_watcher ) {
    my $error = "event.add_io failed for $host:$port";
    <[base.logs]>->( 0, "async.http_client : %s", $error );
    $callbacks->{'on_error'}->($error) if exists $callbacks->{'on_error'};
    close($sock);
    return { success => FALSE, error => $error };
}

$state->{'io_watcher'} = $io_watcher;

## Write request ##
my $total_written = 0;
while ( $total_written < $req_bytes ) {
    my $n = syswrite( $sock, $request, $req_bytes - $total_written,
        $total_written );
    if ( defined $n ) {
        $total_written += $n;
    } elsif ( $!{EAGAIN} || $!{EWOULDBLOCK} ) {
        select( undef, undef, undef, 0.001 );
    } else {
        my $error = sprintf 'Failed to write request : %s',
            <[base.str.os_err]>;
        <[base.logs]>->( 0, "async.http_client: %s", $error );
        $callbacks->{'on_error'}->($error) if exists $callbacks->{'on_error'};
        eval { $io_watcher->cancel };
        close($sock);
        return { success => FALSE, error => $error };
    }
}

<[base.logs]>->( 2, "async.http_client : wrote %d bytes", $total_written );

## Set up timeout ##

my $timeout_sec     = $callbacks->{'timeout'} // $default_http_timeout;
my $timeout_watcher = <[event.add_timer]>->(
    {   'after'   => $timeout_sec,
        'handler' => qw| coding.handler.http_timeout |,
        'data'    => { state => $state, io_watcher => $io_watcher },
    }
);

$state->{'timeout_watcher'} = $timeout_watcher;

<[base.logs]>->(
    1,     "async.http_client: connection established to %s:%d",
    $host, $port
);

return {
    success => TRUE,
    state   => $state,
};

