## [:< ##

# name  = coding.async.http_client
# descr = HTTP streaming client using Protocol-7 event system
# purpose = Phase 2 : Non-blocking HTTP with chunked response handling

my ( $url, $body, $callbacks ) = @ARG;

return { success => FALSE, error => 'url required' }  unless defined $url;
return { success => FALSE, error => 'body required' } unless defined $body;
return { success => FALSE, error => qw| callbacks hashref required | }
    unless ref($callbacks) eq qw| HASH |;

my $default_http_timeout   = <coding.http-timeouts.request-completed> // 780;
my $data_start_timeout_sec = <coding.http-timeouts.data-start>        // 47;

## Parse URL ##
my ( $host, $port, $path ) = $url =~ m{^http://([^:/]+)(?::(\d+))?(/?.*)$};
$port //= 80;
$path = '/' if !length($path);

## Parse body ##
my $json     = JSON::XS->new->utf8->canonical;
my $body_str = ref($body) ? $json->encode($body) : $body;

## scale data-start timeout with estimated prompt size : a flat timeout
## starves large prompts — the first streamed token can't arrive until
## the whole prompt is prefilled, and prefill of 15K+ tokens routinely
## exceeds a short flat budget under queue contention. floor stays as
## configured [ short prompts really do start in a couple seconds ]   ##
my $chars_per_token        = 3.2;
my $est_prompt_tokens      = int( length($body_str) / $chars_per_token );
my $prefill_tokens_per_sec = <coding.cfg.prefill_tokens_per_sec> // 1200;
my $prefill_margin_sec     = <coding.cfg.prefill_margin_sec>     // 5;
my $scaled_timeout_sec
    = int( $est_prompt_tokens / $prefill_tokens_per_sec )
    + $prefill_margin_sec;

if ( $scaled_timeout_sec > $data_start_timeout_sec ) {
    <[base.logs]>->(
        2,
        'async.http_client: data-start timeout scaled %d -> %d'
            . ' [est_tokens=%d prefill_rate=%d/s]',
        $data_start_timeout_sec,
        $scaled_timeout_sec,
        $est_prompt_tokens,
        $prefill_tokens_per_sec
    );
    $data_start_timeout_sec = $scaled_timeout_sec;
}

## cold-start grace : the FIRST request to a freshly-(re)spawned server  ##
## pays model-load / first-inference warmup latency on top of normal     ##
## prefill — and that request is often small [ short initial prompt ],   ##
## so prompt-size scaling alone hands it the shortest timeout exactly    ##
## when it needs the longest one. grant a flat grace period instead,     ##
## independent of prompt size ; cleared on first chunk received          ##
my $backend_name = $callbacks->{'backend'} // '';
my $backend_srv
    = length($backend_name)
    ? ( <coding.inference_servers> // {} )->{$backend_name}
    : undef;

if ( $backend_srv && $backend_srv->{'cold_start'} ) {
    my $cold_start_timeout_sec = <coding.cfg.cold_start_data_start_timeout>
        // 90;
    if ( $cold_start_timeout_sec > $data_start_timeout_sec ) {
        <[base.logs]>->(
            1,
            'async.http_client: cold-start grace applied %d -> %d'
                . ' [backend=%s]',
            $data_start_timeout_sec,
            $cold_start_timeout_sec,
            $backend_name
        );
        $data_start_timeout_sec = $cold_start_timeout_sec;
    }
}

## Build HTTP request ##
my $request
    = sprintf( "POST %s HTTP/1.1\r\n"
        . "Host: %s:%d\r\n"
        . "Content-Type: application/json\r\n"
        . "Content-Length: %d\r\n"
        . "Accept: application/json\r\n"
        . "Connection: close\r\n" . "\r\n" . "%s",
    $path, $host, $port, length($body_str), $body_str );

## Create blocking socket for connection ##
my $sock = IO::Socket::IP->new(
    PeerHost => $host,
    PeerPort => $port,
    Type     => SOCK_STREAM(),
    Timeout  => 13,
);

if ( !$sock ) {
    my $error = sprintf "Failed to connect to %s:%d : %s", $host, $port,
        <[base.str.os_err]>;
    <[base.logs]>->( 0, "async.http_client : %s", $error );
    $callbacks->{'on_error'}->($error) if exists $callbacks->{'on_error'};
    return { success => FALSE, error => $error };
}

my $req_bytes = bytes::length($request);

## Set up connection state ##
my $state = {
    'sock'            => $sock,
    'buffer'          => '',
    'headers_parsed'  => FALSE,
    'status_code'     => undef,
    'content_type'    => undef,
    'bytes_received'  => 0,
    'chunks_received' => 0,
    'last_activity'   => <[base.time]>->(3),
    'request_start'   => <[base.time]>->(3),
    'callbacks'       => $callbacks,
    'json_decoder'    => JSON::XS->new->utf8,
    'completed'       => FALSE,
    'task_id'         => $callbacks->{'task_id'} // '',
    'abort_context'   => { accumulated => '', compiled => undef },
};

$sock->blocking(0);

## Register socket for read events ##
my $io_watcher = <[event.add_io]>->(
    {   'fd'      => $sock,
        'handler' => qw| coding.handler.http_io |,
        'data'    => $state,
    }
);

if ( !defined $io_watcher ) {
    my $error = "event.add_io failed for $host:$port";
    <[base.logs]>->( 0, "async.http_client : %s", $error );
    $callbacks->{'on_error'}->($error) if exists $callbacks->{'on_error'};
    close($sock);
    return { success => FALSE, error => $error };
}

$state->{'io_watcher'} = $io_watcher;

## Write request ##
my $total_written = 0;
while ( $total_written < $req_bytes ) {
    my $n = syswrite( $sock, $request, $req_bytes - $total_written,
        $total_written );
    if ( defined $n ) {
        $total_written += $n;
    } elsif ( $!{EAGAIN} || $!{EWOULDBLOCK} ) {
        select( undef, undef, undef, 0.001 );
    } else {
        my $error = sprintf 'Failed to write request : %s',
            <[base.str.os_err]>;
        <[base.logs]>->( 0, "async.http_client: %s", $error );
        $callbacks->{'on_error'}->($error) if exists $callbacks->{'on_error'};
        eval { $io_watcher->cancel };
        close($sock);
        return { success => FALSE, error => $error };
    }
}

<[base.logs]>->( 2, "async.http_client : wrote %d bytes", $total_written );

## Set up total request timeout ##
my $timeout_sec     = $callbacks->{'timeout'} // $default_http_timeout;
my $timeout_watcher = <[event.add_timer]>->(
    {   'after'   => $timeout_sec,
        'handler' => qw| coding.handler.http_timeout |,
        'data'    => { state => $state, io_watcher => $io_watcher },
    }
);
$state->{'timeout_watcher'} = $timeout_watcher;

## Set up data-start timeout [ fires if streaming doesn't begin ] ##
my $data_start_watcher = <[event.add_timer]>->(
    {   'after'   => $data_start_timeout_sec,
        'handler' => qw| coding.handler.http_data_start_timeout |,
        'data'    => { state => $state, io_watcher => $io_watcher },
    }
);
$state->{'data_start_watcher'} = $data_start_watcher;

## Set up stall/inactivity timeout [ re-armed on every chunk in http_io — ##
## catches genuine silence regardless of total elapsed time, independent ##
## of the total-duration ceiling above, which never re-arms on activity ##
my $stall_timeout_sec = <coding.http-timeouts.stall> // 77;
$state->{'stall_timeout_sec'} = $stall_timeout_sec;
$state->{'stall_watcher'}     = <[event.add_timer]>->(
    {   'after'   => $stall_timeout_sec,
        'handler' => qw| coding.handler.http_stall_timeout |,
        'data'    => { state => $state, io_watcher => $io_watcher },
    }
);

<[base.logs]>->(
    1,     "async.http_client: connection established to %s:%d",
    $host, $port
);

return {
    success => TRUE,
    state   => $state,
};

