    # name = data.topology.interference.map.calculate_standing_wave
    # desc = Topology calculation subroutine

    my ( $coord, $antipode ) = @ARG;

    # Standing wave between node and antipode
    my $crest  = $coord;
    my $trough = $antipode;

    return {
        'crest'  => $crest,
        'trough' => $trough,
        'nodes'  => [ $coord, $antipode ],
    };

