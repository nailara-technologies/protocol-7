## [:< ##

# name = weather.base.init_code

<[base.perlmod.load]>->( 'File::Path', qw| make_path remove_tree | );
<[base.perlmod.load]>->( 'FreezeThaw', qw| freeze thaw cmpStr | );

<weather.cfg.units> //= 'metric';

<weather.cache_dir> //= '/var/cache/weather';

<weather.forecast.count.hours> //= 6;
<weather.forecast.count.days>  //= 4;

<[weather.base.check_dirs]>;

0;

