## [:< ##

# name  = decoder.cmd.stop-job
# param = <job-id>
# descr = stop a running decoder job by id

my $job_id = $call->{'args'};

return { 'mode' => qw| false |, 'data' => 'no such job running' }
    if not exists <decoder.jobs>->{$job_id};

my $job      = <decoder.jobs>->{$job_id};
my $job_type = $job->{'job-type'};

## inject stop request — callback checks on next tick ##
$job->{'stop-requested'} = TRUE;

return {
    'mode' => qw| true |,
    'data' => sprintf( 'stopping %s job ..,', $job_type )
};

