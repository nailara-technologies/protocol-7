## [:< ##

# name  = coding.cmd.apply-staged
# descr = apply staged edits to project source files

my $filter = $$call{'args'} // '';

my $staged_dir
    = <system.path.zenka-dirs>->{'var_P7'} . '/'
    . <system.zenka.name>
    . '/staged';

return { 'mode' => 'false', 'data' => 'no staged directory' }
    unless -d $staged_dir;

my $dh;
if ( not opendir $dh, $staged_dir ) {
    <[base.logs]>->( 0, ':. apply-staged: cannot open %s', $staged_dir );
    return { 'mode' => 'false', 'data' => 'cannot read staged directory' };
}

my @files = sort grep { $ARG ne '.' and $ARG ne '..' } readdir $dh;
closedir $dh;

return { 'mode' => 'false', 'data' => 'no staged edits' } unless @files;

my $root       = <system.root_path>;
my $applied    = 0;
my $skipped    = 0;
my $output     = '';
my $shell_cmds = '';

my $allow_chmod = <[base.cfg_bool]>->( <coding.cfg.allow_chmod_apply> // 0 );

for my $staged_name (@files) {
    ## convert staged name back to source path ##
    my $src_rel = $staged_name;
    $src_rel =~ s|__|/|g;

    ## optional filter ##
    next if length $filter and $src_rel !~ m|\Q$filter\E|;

    my $src_path    = "$root/$src_rel";
    my $staged_path = "$staged_dir/$staged_name";

    ## read staged content ##
    my $content_ref = <[file.slurp]>->($staged_path);
    unless ( defined $content_ref ) {
        $output .= sprintf ":. %s : cannot read staged file\n", $src_rel;
        $skipped++;
        next;
    }

    ## temporarily enable group write if allowed and needed ##
    my $mode_restore;
    if ( $allow_chmod and -f $src_path and not -w $src_path ) {
        my $cur_mode = ( stat $src_path )[2] & 07777;
        if ( chmod( $cur_mode | 0020, $src_path ) ) {
            $mode_restore = $cur_mode;
        }
    }

    ## write to source path ##
    my $written = <[file.put]>->( $src_path, $content_ref );

    ## restore original file permissions ##
    chmod $mode_restore, $src_path if defined $mode_restore;

    if ($written) {
        $output .= sprintf ":. %s : applied [ %d bytes ]\n",
            $src_rel, length $content_ref->$*;
        $applied++;
        ## remove staged file after successful apply ##
        unlink $staged_path;
    } else {
        ## direct write failed - emit shell command as fallback ##
        $output .= sprintf ":. %s : no write access [ %d bytes ]\n",
            $src_rel, length $content_ref->$*;
        $shell_cmds .= sprintf "cp -v '%s' '%s'\n", $staged_path, $src_path;
        $skipped++;
    }
}

if ( length $shell_cmds ) {
    $output .= sprintf "\n## run as project owner to apply %d file%s ##\n",
        $skipped, $skipped == 1 ? '' : 's';
    $output .= $shell_cmds;
}

$output .= sprintf "\n## %d applied, %d skipped ##\n", $applied, $skipped;

return { 'mode' => 'size', 'data' => $output };

