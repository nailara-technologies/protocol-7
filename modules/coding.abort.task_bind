## [:< ##

# name  = coding.abort.task_bind
# descr = bind a set of abort-pattern checksum ids to a task

my $params = shift // {};

my $task_id = $params->{'task_id'};
return { mode => qw| false |, data => 'task_id required' }
    unless defined $task_id && length $task_id;

my $task = <coding.task.queue>->{$task_id};
return { mode => qw| false |, data => "task not found: $task_id" }
    unless defined $task;

my $ids = $params->{'pattern_ids'} // [];
$ids = [] unless ref $ids eq qw| ARRAY |;

## store only checksum ids on the task record ; patterns are reusable
## across tasks and resolved at match time from the checksum store ##
$task->{'abort_pattern_ids'} = [@$ids];

<[base.logs]>->(
    1,             'abort.task_bind: bound %d pattern(s) to %s',
    scalar(@$ids), $task_id
);

return {
    mode => qw| true |,
    data => {
        task_id     => $task_id,
        pattern_ids => $task->{'abort_pattern_ids'}
    }
};

