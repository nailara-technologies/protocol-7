## [:< ##

# name  = valued.cmd.valued-list
# descr = list all valued tree nodes sorted by priority

my @nodes;

## iterate all nodes in valued.index ##
foreach my $id ( keys %{<valued.index>} ) {
    my $priority = <[valued.resolve]>->($id);
    push @nodes, { 'id' => $id, 'priority' => $priority };
}

## sort by priority descending ##
@nodes = sort { $b->{'priority'} <=> $a->{'priority'} } @nodes;

my $output;

if ( not @nodes ) {
    $output = 'no nodes';
} else {
    $output = '';
    foreach my $n (@nodes) {
        my $node   = <valued.index>->{ $n->{'id'} };
        my $refs   = $node->{'refs'}   // 0;
        my $weight = $node->{'weight'} // 0.0;

        $output .= sprintf "%.2f  %-28s  refs=%-3d weight=%.3f\n",
            $n->{'priority'}, $n->{'id'}, $refs, $weight;
    }
}

return { 'mode' => 'size', 'data' => $output };

