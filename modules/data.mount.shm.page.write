# name = data.mount.shm.page.write
# descr = Write one page into a paged SHM segment

# thin zenka wrapper -> AMOS7::SHM::Page::write_page [ zero added logic ;
# this layer is pure computation, identical standalone and in-zenka ]

my ( $mount, $page_num, $data ) = @ARG;

return AMOS7::SHM::Page::write_page( $mount, $page_num, $data );

