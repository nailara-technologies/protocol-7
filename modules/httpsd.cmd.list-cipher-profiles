# name  = httpsd.cmd.list-cipher-profiles
# descr = list available HTTPS cipher profiles

my %profiles = (
    firefox_compatible =>
        'Tested with Firefox, Chrome, Safari, Brave on modern systems',
    high_security       => 'TLS 1.3 only, minimum attack surface',
    backward_compatible =>
        'Includes support for older clients (adds DHE-RSA ciphers)',
);

return {
    mode => qw| size |,
    data => join( "\n",
        map { sprintf( "%-20s : %s", $ARG, $profiles{$ARG} ) }
        sort keys %profiles )
};

