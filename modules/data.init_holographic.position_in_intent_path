# name = data.init_holographic.position_in_intent_path
# desc = Check if position is in intent ghost path

my ( $pos, $ghost ) = @_;

my ( $px, $py, $pz ) = @$pos;
my ( $fx, $fy, $fz ) = @{ $ghost->{'from'} };
my ( $tx, $ty, $tz ) = @{ $ghost->{'to'} };

my $min_x = ( $fx < $tx ) ? $fx : $tx;
my $max_x = ( $fx > $tx ) ? $fx : $tx;
my $min_y = ( $fy < $ty ) ? $fy : $ty;
my $max_y = ( $fy > $ty ) ? $fy : $ty;
my $min_z = ( $fz < $tz ) ? $fz : $tz;
my $max_z = ( $fz > $tz ) ? $fz : $tz;

return (   $px >= $min_x
        && $px <= $max_x
        && $py >= $min_y
        && $py <= $max_y
        && $pz >= $min_z
        && $pz <= $max_z );

