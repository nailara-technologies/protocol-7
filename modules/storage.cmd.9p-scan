## [:< ##
# name  = storage.cmd.9p-scan
# descr = Scan 9P filesystem with filtering
#         :include: <regex>      - OR match (any matches)
#         :include-all: <regex>  - AND match (all must match)
#         :exclude: <regex>      - OR exclude
#         :exclude-all: <regex>  - AND exclude
#         :max-depth: <n>        - Maximum recursion depth
#         :no-recurse:           - Don't recurse

my $args = $call->{'args'} // '';

# Parse: <name> <path> [options]
my ( $name, $path, @opts ) = split /\s+/, $args;

$name //= '';
$path //= '/';

if ( not length $name ) {
    return {
        'mode' => 'false',
        'data' =>
            'Usage: 9p-scan <connection-name> <path> [:option: value ...]'
    };
}

# Parse options
my $filters = {
    inclusion_add => [],
    inclusion_and => [],
    exclusion_add => [],
    exclusion_and => [],
};

my $recursive = 1;
my $max_depth = 10;

for ( my $i = 0; $i < @opts; $i++ ) {
    my $opt = $opts[$i];

    if ( $opt eq ':include:' and $i + 1 < @opts ) {
        push @{ $filters->{inclusion_add} }, qr/$opts[++$i]/;
    } elsif ( $opt eq ':include-all:' and $i + 1 < @opts ) {
        push @{ $filters->{inclusion_and} }, qr/$opts[++$i]/;
    } elsif ( $opt eq ':exclude:' and $i + 1 < @opts ) {
        push @{ $filters->{exclusion_add} }, qr/$opts[++$i]/;
    } elsif ( $opt eq ':exclude-all:' and $i + 1 < @opts ) {
        push @{ $filters->{exclusion_and} }, qr/$opts[++$i]/;
    } elsif ( $opt eq ':max-depth:' and $i + 1 < @opts ) {
        $max_depth = $opts[ ++$i ];
    } elsif ( $opt eq ':no-recurse:' ) {
        $recursive = 0;
    }
}

my $scan_result = <[storage.9p.scan]>->(
    {   name          => $name,
        path          => $path,
        recursive     => $recursive,
        max_depth     => $max_depth,
        inclusion_add => $filters->{inclusion_add},
        inclusion_and => $filters->{inclusion_and},
        exclusion_add => $filters->{exclusion_add},
        exclusion_and => $filters->{exclusion_and},
    }
);

if ( $scan_result->{'mode'} eq 'false' ) {
    return $scan_result;
}

my $results = $scan_result->{'data'};
my $stats   = $scan_result->{'stats'};

my $output
    = sprintf( "9P Scan Results for %s:%s\n"
        . "Scanned: %d, Matched: %d, Rejected: %d, Errors: %d\n" . "---\n",
    $name, $path, $stats->{scanned}, $stats->{matched}, $stats->{rejected},
    $stats->{errors} );

for my $file (@$results) {
    my $type
        = $file->{qid}{type} & <plan-9.protocol.constants.QTDIR>
        ? 'd'
        : 'f';
    $output
        .= sprintf( "%s %10d %s\n", $type, $file->{length}, $file->{path} );
}

return { 'mode' => 'size', 'data' => $output };

