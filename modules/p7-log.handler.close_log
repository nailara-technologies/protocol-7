## [:< ##

# name = p7-log.handler.close_log

my $log_name  = shift->w->data;
my $file_data = <log.files>->{$log_name};
$file_data->{'timer'}->cancel;
$file_data->{'timer'} = undef;

<[base.log]>->( <devmod.p7_log_level> // 3, "closing log '$log_name'" );

## force written lines out of the OS page cache before releasing the handle ##
## -- close() alone only flushes perl's own buffer via write(2), the data   ##
## can still sit unflushed in the kernel page cache for its normal          ##
## writeback interval. p7-log is a dedicated zenka specifically so its I/O  ##
## never blocks other zenki, so a blocking fsync here is fine -- this is    ##
## exactly the idle window a host crash / abrupt WSL shutdown can catch,    ##
## leaving a zero-filled gap [ metadata committed, data not ]               ##
$file_data->{'fh'}->sync or die lcfirst($OS_ERROR);

flock( $file_data->{'fh'}, 8 ) or die lcfirst($OS_ERROR);    # LOCK_UN
$file_data->{'locked'} = 0;
close( $file_data->{'fh'} ) or die lcfirst($OS_ERROR);

