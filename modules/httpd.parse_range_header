# name = httpd.parse_range_header
# descr = parse http range header and return byte ranges

my $range_header = shift;
my $file_size    = shift;

# Skip if no range header or invalid file size
return undef
    if !defined $range_header || !defined $file_size || $file_size <= 0;

# Parse the range header (format: "bytes=0-499" or "bytes=500-999" or "bytes=500-")
if ( $range_header =~ /^bytes=(\d*)-(\d*)$/ ) {
    my $start = $1;
    my $end   = $2;

    # Handle empty start (e.g., "bytes=-500")
    if ( $start eq '' ) {

        # If no start specified, interpret as last N bytes
        if ( $end eq '' ) {

            # Both start and end empty, invalid range
            return undef;
        }

        # Calculate start from end (e.g., bytes=-500 means last 500 bytes)
        $start = $file_size - $end;
        $start = 0 if $start < 0;
        $end   = $file_size - 1;
    } else {

        # Handle empty end (e.g., "bytes=500-")
        $end = $file_size - 1 if $end eq '';
    }

    # Validate range
    if ( $start > $end || $start >= $file_size || $end >= $file_size ) {

        # Range not satisfiable
        return undef;
    }

    # Return the range
    return [ { 'start' => $start, 'end' => $end } ];
} elsif ( $range_header =~ /^bytes=(.+)$/ ) {

    # Multiple ranges (e.g., "bytes=0-499,500-999")
    my $ranges_str = $1;
    my @ranges     = split( ',', $ranges_str );
    my @result     = ();

    foreach my $range (@ranges) {
        if ( $range =~ /^(\d*)-(\d*)$/ ) {
            my $start = $1;
            my $end   = $2;

            # Handle empty start (e.g., "-500")
            if ( $start eq '' ) {

                # If no start specified, interpret as last N bytes
                if ( $end eq '' ) {

                    # Both start and end empty, invalid range
                    next;
                }

                # Calculate start from end
                $start = $file_size - $end;
                $start = 0 if $start < 0;
                $end   = $file_size - 1;
            } else {

                # Handle empty end (e.g., "500-")
                $end = $file_size - 1 if $end eq '';
            }

            # Validate range
            if ( $start > $end || $start >= $file_size || $end >= $file_size )
            {
                # Range not satisfiable for this segment
                next;
            }

            # Add to result
            push @result, { 'start' => $start, 'end' => $end };
        }
    }

    return @result ? \@result : undef;
}

# Invalid range format
return undef;

