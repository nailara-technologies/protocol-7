# name  = job-site-scan.cmd.set-threshold
# descr = update minimum score threshold for review

my $val = $call->{'args'} // '';
$val =~ s/^\s+|\s+$//g;

return
    <[base.callback.cmd_reply]>
    ->( { 'mode' => FALSE, 'data' => 'usage: set-threshold <0-10>' } )
    if not length $val
    or $val !~ m{^\d+(?:\.\d+)?$}
    or $val > 10;

<job-site-scan.cfg.threshold> = $val + 0;

<[base.callback.cmd_reply]>
    ->( { 'mode' => TRUE, 'data' => "threshold set to $val" } );

