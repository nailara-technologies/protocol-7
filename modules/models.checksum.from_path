## [:< ##

# name  = models.checksum.from_path
# param = <file_path>
# descr = Calculate 7-character AMOS checksum from file path
# return = checksum string or undef on error

my $file_path = shift;

unless ( defined $file_path && length $file_path ) {
    <[base.s_warn]>->('file path required');
    return undef;
}

## Validate path doesn't try to escape or use relative traversal
if ( $file_path =~ m{\.\.} || $file_path !~ m{^/} ) {
    <[base.s_warn]>->('invalid path format: %s', $file_path);
    return undef;
}

## Calculate AMOS checksum from path using base system
my $checksum = <[chk-sum.amos]>->($file_path);

unless ( defined $checksum && length $checksum ) {
    <[base.s_warn]>->('failed to calculate checksum for: %s', $file_path);
    return undef;
}

return $checksum;

