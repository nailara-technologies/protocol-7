## [:< ##

# name = protocol-7-menu.cmd.menu-update-notify
# descr = Receive menu update notification from provider zenka (voluntary fetch pattern)
# param = <provider-name> <update-reference-timestamp>

my $call_args = $call->{'args'} // '';
my ( $provider, $update_ref ) = split( m|\s+|, $call_args, 2 );

return { 'mode' => qw| false |, 'data' => 'provider name required' }
    unless defined $provider;

<[base.logs]>->(
    1,         "[provider:'%s'] update notification [%s]",
    $provider, $update_ref // qw| init |
);

# Set up handler to fetch the data when protocol-7-menu is ready
# This is triggered by protocol-7-menu voluntarily, not forced by the notification

my $sent_count = <[protocol-7.command.send.local]>->(
    {   'command'   => sprintf( qw| cube.%s.get-provider-data |, $provider ),
        'call_args' => { 'args' => '' },
        'reply'     => {
            'params' =>
                { 'provider' => $provider, 'update_ref' => $update_ref },
            'handler' => qw| protocol-7-menu.handler.fetch-menu-data |
        }
    }
);

return {
    'mode' => qw| false |,
    'data' => "[fetch] taget client not present"
    }
    if $sent_count == 0;    ## no clients reached ##

#if (length $EVAL_ERROR) {
#    <[base.s_warn]>->(
#        'Failed to fetch provider data [exception]: %s',<[base.str.eval_error]>
#    );
#    return { 'mode' => qw| false |, 'data' => "fetch failed: $EVAL_ERROR" };
#}

<[base.logs]>->(
    1, "initiated fetch of menu data from provider '%s'", $provider
);

return {
    'mode' => qw| true |,
    'data' => "menu update notification acknowledged, data fetch initiated"
};

