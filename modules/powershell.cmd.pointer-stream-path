# name  = powershell.cmd.pointer-stream-path
# descr = return shm path after granting read to caller pubkey

my $pubkey = $call->{'args'} // '';
my $path   = <[powershell.pointer-stream-path]>->($pubkey);

return {
    'mode' => defined $path ? qw| true | : qw| false |,
    'data' => defined $path ? $path      : 'not available',
};

