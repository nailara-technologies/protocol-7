## [:< ##

# name  = task.cmd.summarize
# descr = summarize task context via inference [ model-pinned ]
# usage = p7c task.summarize <task_id> [focus=<topic>] [model=<AMOS:ID>]

my ( $task_id, @opts ) = split m{\s+}, ( $call->{'args'} // '' );
return { mode => 'false', data => 'task_id required' } unless length $task_id;

my $focus = '';
my $model = '';
for my $opt (@opts) {
    $focus = $1 if $opt =~ m{^focus=(.+)};
    $model = $1 if $opt =~ m{^model=(.+)};
}

## gather task context: description + recent notes + result so far ##
my $task = <task.queue>->{$task_id} // <task.history>->{$task_id}
    // return { mode => 'false', data => "task not found: $task_id" };

my $description = $task->{'description'} // '';
my $notes       = '';
if ( exists $task->{'notes'} and ref $task->{'notes'} eq 'ARRAY' ) {
    $notes = join( "\n\n", grep { length $ARG } $task->{'notes'}->@* );
}
my $result = $task->{'result'} // '';

my $context_text
    = "Task: $task_id\n"
    . ( length($description) ? "Description: $description\n" : '' )
    . ( length($notes)       ? "Notes:\n$notes\n"            : '' )
    . ( length($result)      ? "Result so far:\n$result"     : '' );

my $sent = <[protocol-7.route-send]>->(
    {   command   => 'coding.summarize-context',
        call_args => {
            data => $context_text,
            args => join( ' ',
                length($focus) ? "focus=$focus" : (),
                length($model) ? "model=$model" : (),
                "store=1",
            ),
        },
        reply => {
            handler => 'task.handler.summarize-reply',
            params  => { task_id => $task_id },
        },
    }
);

<[base.logs]>->(
    $sent ? 1 : 0,
    ':. task.summarize %s : route-send to coding.summarize-context : %s',
    $task_id,
    $sent ? 'sent' : 'not delivered [ coding zenka offline? ]'
);

return $sent
    ? { mode => 'deferred' }
    : { mode => 'false', data => 'coding zenka not reachable' };

