# name  = httpd.handler.web_template_reply
# descr = Handle reply from web zenka for template processing

my $reply_data = shift;

my $client_sid  = $reply_data->{'params'}{'client_sid'};
my $template_id = $reply_data->{'params'}{'template_id'};
my $mode        = lc($reply_data->{'cmd'} // '');  ## Normalize to lowercase
my $data        = $reply_data->{'data'};

## Debug logging ##
<[base.log]>->( 0, "handler: data type=" . ref($data) . ", length=" . (defined $data ? length($data) : 0) );
<[base.log]>->( 0, "handler: data preview=[" . substr($data, 0, 100) . "]" ) if defined $data;

unless ( defined $data{'session'}{$client_sid} ) {
    <[base.log]>->(
        1,
        "httpd.handler.web_template_reply: session $client_sid no longer exists for $template_id"
    );
    return 0;
}

my $session = $data{'session'}{$client_sid};

<[base.log]>->(
    2,
    "httpd.handler.web_template_reply: received reply for $template_id (mode: $mode)"
);

if ( $mode eq 'size' ) {
    ## SUCCESS: Web zenka returned processed content ##

    my $content         = $data;
    my $content_length  = length($content);
    my $content_type    = $session->{'content'}->{'type'} // 'text/html';
    my $content_date    = $session->{'content'}->{'date'} // time2str(time);
    my $response_params = $session->{'response'}->{'params'} // {};

    <[base.log]>->(
        2,
        "[$client_sid] template processing complete: $template_id ($content_length bytes)"
    );

    ## Build HTTP response with processed content ##
    $session->{'buffer'}->{'output'} .= <[httpd.new_header]>->(
        200,
        {   'Content-Type'   => $content_type,
            'Last-Modified'  => $content_date,
            'Content-Length' => $content_length,
            'Connection'     => $session->{'http'}->{'close'}
            ? 'close'
            : 'keep-alive',
            'Accept-Ranges' => 'bytes',
            %{$response_params}
        }
    ) . $content;

    ## Mark content as complete ##
    $session->{'content'}->{'complete'} = 1;

    ## Trigger output flush ##
    if ( $session->{'http'}->{'close'} ) {
        $session->{'flush_shutdown'} = 1;
    } else {
        $session->{'flush'} = 1;
    }

} elsif ( $mode eq 'false' ) {
    ## ERROR: Web zenka failed to process template ##

    my $error_message = $data // 'unknown error';

    <[base.log]>->(
        0,
        "[$client_sid] template processing failed: $template_id - $error_message"
    );

    ## Send 500 Internal Server Error ##
    <[httpd.send_error_page]>->( $client_sid, 500 );
    $session->{'flush_shutdown'} = 1;

} elsif ( $mode eq 'true' ) {
    ## Unexpected TRUE response without data ##
    <[base.log]>->(
        1,
        "[$client_sid] unexpected TRUE response for $template_id (expected size)"
    );

    ## Send 500 Internal Server Error ##
    <[httpd.send_error_page]>->( $client_sid, 500 );
    $session->{'flush_shutdown'} = 1;

} else {
    ## Unknown response mode ##
    <[base.log]>->(
        0,
        "[$client_sid] unknown reply mode '$mode' for $template_id"
    );

    ## Send 500 Internal Server Error ##
    <[httpd.send_error_page]>->( $client_sid, 500 );
    $session->{'flush_shutdown'} = 1;
}

return 0;

