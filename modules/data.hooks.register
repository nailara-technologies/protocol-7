## [:< ##

# name  = data.hooks.register
# param = <event> <target-zenka> <command> [priority]
# descr = register a zenka to be notified on data events

my ( $event, $zenka, $command, $priority ) = @ARG;

return {
    'mode' => qw| false |,
    'data' => 'expected <event> <target-zenka> <command>'
    }
    unless defined $event
    and defined $zenka
    and defined $command;

$priority //= 1;

## add hook ##
push @{ <data.hooks.registered>->{$event} //= [] },
    {
    'zenka'    => $zenka,
    'command'  => $command,
    'priority' => $priority,
    'time'     => time(),
    };

<[base.log]>->(
    1, "registered hook: %s → %s.%s (priority %d)",
    $event, $zenka, $command, $priority
);

return {
    'mode' => qw| true |,
    'data' => "registered $event hook for $zenka.$command"
};

