# name = models.decision.recommendation_base
# descr = Base helpers for recommendation engine

use List::Util qw| max |;

sub calculate_composite_score {
  my ($model, $context, $constraints) = @_;
  my $stats = $model->{statistics}->{by_context}->{$context} // {};
  my $success_rate = $stats->{success_rate} // 0;
  my $is_local = $model->{presence_decision}->{currently_present} // 0;
  my $init_time = $model->{metadata}->{init_latency_ms} // 0;

  return ($success_rate * 100) + ($is_local * 50) - ($init_time / 100);
}

sub find_models_for_context {
  my ($context, $all_models) = @_;
  return grep { $_->{statistics}->{by_context}->{$context} } @$all_models;
}

sub filter_by_constraints {
  my ($scored_models, $constraints) = @_;
  return @$scored_models unless $constraints;
  return grep {
    (!$constraints->{min_success_rate} || $_->{success_rate} >= $constraints->{min_success_rate}) &&
    (!$constraints->{require_local} || $_->{available_locally})
  } @$scored_models;
}

sub generate_reasoning {
  my ($model, $context) = @_;
  my $stats = $model->{statistics}->{by_context}->{$context} // {};
  return "Success rate: " . ($stats->{success_rate} // 0) . ", Margin: " . ($stats->{margin_vs_best_alt} // 0);
}

{
  'calculate_composite_score' => \&calculate_composite_score,
  'find_models_for_context' => \&find_models_for_context,
  'filter_by_constraints' => \&filter_by_constraints,
  'generate_reasoning' => \&generate_reasoning,
};

