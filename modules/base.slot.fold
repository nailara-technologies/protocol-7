## [:< ##

# name  = base.slot.fold
# descr = fold a slot to its handle form [ slot disappears from surface ]
# param = { address }

my $address = $ARG[0]->{'address'} // '';

return undef if not length $address;

## parse address for chksum7
my $chksum7;
if ( $address =~ m|^SLOT:([^:]+):| ) {
    $chksum7 = $1;
} else {
    warn 'expected slot address <{C1}>';
    return undef;
}

my $entry = <base.slots>->{$chksum7};
if ( not defined $entry ) {
    warn 'slot not found <{C1}>';
    return undef;
}

## remove from surface render set
my $surface = $entry->{'surface'};
if ( defined $surface and defined $entry->{'geometry'} ) {
    delete <base.slots.surfaces>->{$surface}->{$chksum7}
        if exists <base.slots.surfaces>->{$surface};
}

## clear geometry [ folded state ]
$entry->{'geometry'} = undef;

## produce fold handle
my $handle = eval {
    <[base.ui.fold]>->(
        {   'address' => $entry->{'content_address'} // $entry->{'name'},
            'kind'    => qw| slot |,
            'summary' => $entry->{'name'}
        }
    );
};

if (    defined $handle
    and ref $handle eq 'HASH'
    and exists $handle->{'data'} ) {
    return $handle->{'data'};
}

return
      '.:[ slot ]:[ '
    . ( $entry->{'name'} // 'unknown' )
    . ' ]:[ folded ]:.';

