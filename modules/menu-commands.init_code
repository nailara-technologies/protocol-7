## [:< ##

# name = menu-commands.init_code
# descr = Initialize menu-commands zenka with data structures and persistent state

<[base.perlmod.load]>->('YAML::XS', qw| Load Dump |);

# Initialize data structures
<menu-commands.mappings> = {};
<menu-commands.categories> = {};

# Load persistent state from disk
<[menu-commands.load-state]>;

# Register with protocol-7-menu as a provider
<[menu-commands.update-menu]>;

0;

