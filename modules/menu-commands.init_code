## [:< ##

# name = menu-commands.init_code
# descr = Initialize menu-commands zenka with data structures and persistent state

<[base.perlmod.load]>->( 'YAML::XS', qw| Load Dump | );

# Initialize data structures
<menu-commands.mappings>   //= {};
<menu-commands.categories> //= {};

<list.mappings> = {
    'var'   => qw| data |,
    'key'   => qw| menu-commands.mappings |,
    'mask'  => '<key>:name label command category enabled',
    'align' => {
        qw| name     | => qw| left+1  |,
        qw| label    | => qw| left+2  |,
        qw| command  | => qw| left+3  |,
        qw| category | => qw| left+1  |,
        qw| enabled  | => qw| center-1 |,
    },
    'filters' => {
        'label'    => qw| base.parser.center_ellipse_string:18 |,
        'command'  => qw| base.parser.center_ellipse_string:22 |,
        'category' => qw| base.parser.center_ellipse_string:12 |,
        'enabled'  => qw| base.parser.yes_no_bool |
    },
    'descr' => 'menu-commands mapping definitions'
};

<list.categories> = {
    'var'   => qw| data |,
    'key'   => qw| menu-commands.categories |,
    'mask'  => '<key>:name label order items',
    'align' => {
        qw| name  | => qw| left+1  |,
        qw| label | => qw| left+3  |,
        qw| order | => qw| center-2  |,
        qw| items | => qw| center-1  |
    },
    'sort_key' => qw| num:order |,
    'filters'  => { qw| items | => qw| menu-commands.parser.element_count | },
    'descr'    => 'menu-commands categories'
};

# Load persistent state from disk
<[menu-commands.load-state]>;

# Register with protocol-7-menu as a provider
<[menu-commands.update-menu]>;

0;

