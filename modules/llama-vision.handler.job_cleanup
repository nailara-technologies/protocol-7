## [:< ##

# name  = llama-vision.handler.job_cleanup
# descr = clean up completed job data from memory

my $watcher = shift->w;
my $job_id  = $watcher->data;

if ( exists <llama-vision.jobs>->{$job_id} ) {
    <[base.logs]>->( 2, "[job_cleanup] removing: job=%s", $job_id );
    delete <llama-vision.jobs>->{$job_id};
}

