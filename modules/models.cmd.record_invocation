# name = models.cmd.record_invocation
# descr = Record a model invocation for statistics tracking

# Command: models.record_invocation <amos> <context> <json_data>
# JSON data: { success, failure_mode, latency_ms, tokens_processed, etc }
# Returns: formatted response with timestamp

use JSON::PP;

my $cmd = shift @ARG;
my ( $model_amos, $context, $data_json ) = @ARG;

if ( !$model_amos || !$context ) {
    return {
        'mode' => qw| size |,
        'data' => "error: model AMOS and context required\n"
    };
}

# Parse invocation data
my $invocation_data = {};
if ($data_json) {
    eval { $invocation_data = decode_json($data_json); };
    if ($EVAL_ERROR) {
        return {
            'mode' => qw| size |,
            'data' => "error: invalid invocation data JSON: $EVAL_ERROR\n"
        };
    }
}

# Record invocation - call extracted module directly
my $result = <[models.statistics.invocation_tracking.record_invocation]>->(
    $model_amos, $context, $invocation_data
);

my $reply_str = '';
$reply_str .= "model_amos: $model_amos\n";
$reply_str .= "context: $context\n";
$reply_str .= "recorded: 1\n";
$reply_str
    .= "timestamp: " . ( $result->{timestamp} // <[base.ntime]> ) . "\n";
$reply_str .= "date: " . ( $result->{date} // 'unknown' ) . "\n";

return { 'mode' => qw| size |, 'data' => $reply_str };

