# name = data.get.get_caller_permissions
# desc = Determine calling zenka's permissions

my $caller_zenka = $data{'caller'}{'zenka'} // 'unknown';
return ['all']                   if $caller_zenka eq 'root';
return [ $caller_zenka, 'auth' ] if $data{'caller'}{'authenticated'};
return ['public'];

