## [:< ##

# name  = credential_fabric.handler.auth-relay-reply
# descr = handle protocol-7-menu dialog response to auth approval request.
#         on approval, store session credential in tier-1 storage.
#         on graphical-mode-failure, kick off console fallback.
#         on cancellation, propagate failure and clear pending.

my $params = shift              // {};
my $reply  = $params->{'reply'} // {};
my $args   = $params->{'args'}  // {};

my $req_id = $reply->{'params'}{'req_id'} // '';

return undef unless length $req_id;

my $pending = <credential_fabric.auth_relay_pending>->{$req_id};
return undef if not defined $pending;

my $domain = $pending->{'domain'};

## parse reply mode and data ##
my $reply_mode = $reply->{'mode'} // '';
my $reply_data = $args->{'data'}  // '';

## mode true: user approved via dialog ##
if ( $reply_mode eq qw| true | ) {
    my $session_value = $reply_data;
    if ( not length $session_value ) {
        delete <credential_fabric.auth_relay_pending>->{$req_id};
        return {
            'mode' => qw| false |,
            'data' => 'no session value provided'
        };
    }

    return _complete_approval( $req_id, $domain, $session_value );
}

## mode false with graphical not enabled: console fallback ##
if (    $reply_mode eq qw| false |
    and $reply_data =~ /graphical mode not enabled/ ) {
    ## write pending entry to file for external tooling ##
    my $pending_yaml = eval {
        YAML::XS::Dump( <credential_fabric.auth_relay_pending>->%* );
    };
    if ( defined $pending_yaml ) {
        <[file.zenka_dir.write]>->(
            'relay_pending.yaml', \$pending_yaml, '>', 0600
        );
    }

    <[base.logs]>->(
        0,
        'auth relay pending [%s] domain=%s — approve with:'
            . ' p7c credential_fabric.approve %s <payload>',
        $req_id,
        $domain,
        $req_id
    );

    ## keep pending entry in memory for console approve ##
    return {
        'mode'   => qw| pending |,
        'data'   => 'console fallback active',
        'req_id' => $req_id,
    };
}

## mode false with input cancelled: user dismissed ##
if (    $reply_mode eq qw| false |
    and $reply_data eq 'input cancelled' ) {
    <[base.logs]>->(
        1, 'credential_fabric: auth relay cancelled for domain %s', $domain
    );
    delete <credential_fabric.auth_relay_pending>->{$req_id};
    return { 'mode' => qw| false |, 'data' => 'input cancelled' };
}

## unknown mode: propagate failure ##
<[base.logs]>->(
    1,       'credential_fabric: auth relay failed for domain %s (mode=%s)',
    $domain, $reply_mode
);
delete <credential_fabric.auth_relay_pending>->{$req_id};
return { 'mode' => qw| false |, 'data' => 'auth relay failed' };

##[  completion helper  ]#######################################################

sub _complete_approval {
    my ( $rid, $dom, $value ) = @ARG;

    my $slot = 'session.' . $dom;

    ## auto-register slot if not present ##
    if ( not exists <credential_fabric.registry>->{$slot} ) {
        <[credential_fabric.register]>->(
            {   'slot'        => $slot,
                'owner'       => qw| credential_fabric |,
                'type'        => qw| session-cookie |,
                'storage'     => qw| local |,
                'sensitivity' => qw| low |,
            }
        );
    }

    my $write_ok
        = <[credential_fabric.store.local]>->( qw| write |, $slot, $value );

    if ($write_ok) {
        <[base.logs]>->(
            1, 'credential_fabric: stored auth relay session for domain %s',
            $dom
        );
    }

    delete <credential_fabric.auth_relay_pending>->{$rid};

    ## clear pending file entry if present ##
    my $remaining = <credential_fabric.auth_relay_pending> // {};
    my $yaml_str  = eval { YAML::XS::Dump(%$remaining); };
    if ( defined $yaml_str ) {
        <[file.zenka_dir.write]>->(
            'relay_pending.yaml', \$yaml_str, '>', 0600
        );
    }

    return {
        'mode' => $write_ok ? qw| true |       : qw| false |,
        'data' => $write_ok ? 'session stored' : 'storage failed',
        'slot' => $slot,
    };
}

