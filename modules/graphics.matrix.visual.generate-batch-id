# name  = graphics.matrix.visual.generate-batch-id
# descr = Generate unique batch ID for vision processing

my $cluster = shift // {};

my $center = <[graphics.matrix.visual.cluster-center]>->($cluster);
my $sphere = $cluster->{'sphere'} // 0;

return
    sprintf( "cubic-batch-s%d-%d%d%d-%d", $sphere, @$center, time() % 10000 );

