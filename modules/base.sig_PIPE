## [:< ##

# name  = base.sig_PIPE
# descr = install default signal [warning] handler for SIGPIPE signals

my $event = shift;

my $signal_count = 1;
$signal_count = $event->w->hints    ##  combined events  ##
    if defined $event and ref $event eq qw| Event::signal |;

<[base.logs]>->(
    0,
    ':: SIG PIPE :. unhandled signal%s requiring handler',
    (   $signal_count == 1
        ? ''
        : sprintf( 's [%d]', $signal_count )
    )
);

return TRUE;

