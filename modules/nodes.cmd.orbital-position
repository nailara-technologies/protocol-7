# name  = nodes.cmd.orbital-position
# descr = return current orbital position and P7REF

my $result = <[nodes.orbital.current_position]>->();

return { qw| mode | => qw| false |, qw| data | => $result->{'data'} }
    unless ( $result->{'mode'} // '' ) eq qw| true |;

my $d    = $result->{'data'};
my @keys = <[base.sort]>->( keys %$d );
my $w    = length( ( sort { length $b <=> length $a } @keys )[0] );
my $out  = '';
for my $key (@keys) {
    my $val = $d->{$key} // '';
    $val = sprintf '%.6f', $val
        if $val =~ m|^\d+\.\d+$| and $key =~ m{^(theta|phi|psi|omega)$};
    $out .= sprintf "  %*s  %s\n", $w, $key, $val;
}

return { qw| mode | => qw| size |, qw| data | => $out };

