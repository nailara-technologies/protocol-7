## [:< ##

# name  = nodes.cmd.orbital-position
# descr = return current orbital position and P7REF
#
# notes = args 'subscribe' opens a STRM push channel instead, fed by
#         nodes.orbital.push_position_if_subscribed's own slow timer
#         [ this value is time-derived, no discrete mutation event exists ]

if ( defined $call->{'args'} and $call->{'args'} eq qw| subscribe | ) {
    return { 'mode' => qw| false |, 'data' => 'orbital push disabled' }
        unless <[base.cfg_bool]>->(<nodes.cfg.orbital_push_enabled>);

    my $h = <[base.stream.open]>->(
        {   'sid'    => $call->{'session_id'},
            'cmd_id' => $call->{'command_id'},
            'type'   => qw| STRM |,
            'total'  => undef,
        }
    );
    return { 'mode' => qw| false |, 'data' => 'stream open refused' }
        if not defined $h;

    <nodes.orbital.listeners> //= [];
    push @{<nodes.orbital.listeners>}, $h;
    <[base.logs]>->(
        2, 'orbital position listener added [sid=%d]',
        $call->{'session_id'}
    );

    ## push the current snapshot immediately ##
    my $snapshot = <[nodes.orbital.current_position]>;
    if ( ( $snapshot->{'mode'} // '' ) eq qw| true | ) {
        my $payload
            = <[nodes.orbital.format_strm_payload]>->( $snapshot->{'data'} );
        <[base.stream.push]>->( $h, \$payload ) if length $payload;
    }

    return { 'mode' => qw| deferred | };
}

my $result = <[nodes.orbital.current_position]>;

return { qw| mode | => qw| false |, qw| data | => $result->{'data'} }
    unless ( $result->{'mode'} // '' ) eq qw| true |;

my $d    = $result->{'data'};
my @keys = <[base.sort]>->( keys %$d );
my $w    = length( ( sort { length $b <=> length $a } @keys )[0] );
my $out  = '';
for my $key (@keys) {
    my $val = $d->{$key} // '';
    $val = sprintf '%.6f', $val
        if $val =~ m|^\d+\.\d+$| and $key =~ m{^(theta|phi|psi|omega)$};
    $out .= sprintf "  %*s  %s\n", $w, $key, $val;
}

return { qw| mode | => qw| size |, qw| data | => $out };

