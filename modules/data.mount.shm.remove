## [:< ##

# name  = data.mount.shm.remove
# descr = Remove/unlink SHM file

my $shm_path = shift;

return undef unless defined $shm_path;

## ensure path is under /dev/shm ##
return undef unless $shm_path =~ m{^/dev/shm/};

## unlink the SHM file ##
my $result = unlink($shm_path);

## the phase-3 notify fifo shares the segment's lifecycle ##
my $notify_path = $shm_path . '.notify';
if ( -p $notify_path ) {
    unlink($notify_path);
}

if ($result) {
    <[base.logs]>->( 2, ":. SHM removed: %s", $shm_path );
} else {
    <[base.logs]>->( 1, ":: failed to remove SHM: %s", $shm_path );
}

return $result;

