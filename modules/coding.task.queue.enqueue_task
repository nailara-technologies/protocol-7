## [:< ##

# name = coding.task.queue.enqueue_task
# descr = add task to work queue
# purpose = queue management : enqueue a new task with duplicate prevention

my ($task) = @ARG;

return {
    success => FALSE,
    error   => "task must be a hashref"
    }
    unless ref($task) eq 'HASH';

my $task_id = $task->{id};

# prevent duplicates
if ( exists <coding.task.queue.TASK_QUEUE>->{$task_id} ) {
    return {
        success       => FALSE,
        error         => "task already in queue : $task_id",
        existing_task => <coding.task.queue.TASK_QUEUE>->{$task_id}
    };
}

# store task
<coding.task.queue.TASK_QUEUE>->{$task_id} = {
    %$task,
    queued_at      => <[base.time]>,
    queue_position => scalar(@{<coding.task.queue.QUEUE_ORDER>})
};

# add to ordering (will be sorted by priority)
push @{<coding.task.queue.QUEUE_ORDER>}, $task_id;

<coding.task.queue.QUEUE_UPDATED> = <[base.time]>;

return {
    success    => TRUE,
    task_id    => $task_id,
    queue_size => scalar(@{<coding.task.queue.QUEUE_ORDER>}),
    message    => "task enqueued : $task_id"
};

