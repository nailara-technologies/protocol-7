# name = coding.task.queue_enqueue
# descr = add task to queue with duplicate detection
# purpose = Queue operation: Store and track new work

my ($task) = @ARG;

return {
    success => FALSE,
    error   => "Task must be a hashref"
    }
    unless ref($task) eq 'HASH';

my $task_id = $task->{id};

# Get persistent storage refs
my $queue_href   = <coding.task.queue>;
my $aref_pending = <coding.task.pending>;

# Prevent duplicates
if ( exists $queue_href->{$task_id} ) {
    return {
        success       => FALSE,
        error         => "Task already in queue: $task_id",
        existing_task => $queue_href->{$task_id}
    };
}

# Store task in persistent queue
$queue_href->{$task_id} = {
    %$task,
    queued_at      => <[base.time]>,
    queue_position => scalar( $aref_pending->@* )
};

# Add to pending list (for ordering by priority)
push $aref_pending->@*, $task_id;

# Log task enqueue
<[base.logs]>->( 2, "task enqueued : %s", $task_id );

return {
    success    => TRUE,
    task_id    => $task_id,
    queue_size => scalar( $aref_pending->@* ),
    message    => "Task enqueued: $task_id"
};

