## [:< ##

# name  = amos-term.cmd.window-open
# descr = Open GTK3 window for existing buffer

my $amos_id = shift;

return "Error: AMOS ID required\n" unless defined $amos_id;

my $result = <[amos-term.window-open]>->("amos:$amos_id");

return $result ? "Window opened\n" : "Error: open failed\n";

