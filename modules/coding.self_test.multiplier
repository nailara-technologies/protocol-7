## [:< ##

# name  = coding.self_test.multiplier
# descr = compute timeout multiplier from TTFT samples

my $params   = shift                 // {};
my $model_id = $params->{'model_id'} // '';
my $ttft     = $params->{'ttft'}     // 0;

return { mode => qw| false |, data => 'model_id required' }
    if !length $model_id;

## add sample to rolling window ##
my $models_ref = $data{'coding'}{'cfg'}{'timeout_stats'}{'models'} //= {};
$models_ref->{$model_id}{'ttft_samples'} //= [];
push @{ $models_ref->{$model_id}{'ttft_samples'} }, $ttft
    if $ttft > 0;

my @samples
    = @{ $models_ref->{$model_id}{'ttft_samples'} // [] };

return { mode => qw| true |, data => 'no samples' }
    if !@samples;

my $p95        = <[coding.util.multiplier.percentile_95]>->(@samples);
my $multiplier = $p95 * 1.5;

$models_ref->{$model_id}{'ttft_p95'}     = $p95;
$models_ref->{$model_id}{'baseline_tps'} = 0;
$models_ref->{$model_id}{'multiplier'}   = $multiplier;
$models_ref->{$model_id}{'last_update'}  = <[base.time]>->(3);

## update global aggregate values ##
$data{'coding'}{'cfg'}{'timeout_stats'}{'percentile_95'} = $p95;
$data{'coding'}{'cfg'}{'timeout_stats'}{'multiplier'}    = $multiplier;
$data{'coding'}{'cfg'}{'timeout_stats'}{'last_update'}   = <[base.time]>->(3);

return { mode => qw| true |, data => $multiplier };

