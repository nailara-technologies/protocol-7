## [:< ##

# name  = site-yaml.jobs.init_code
# descr = initialize job store, load persisted data

<[base.perlmod.autoload]>->('YAML::XS');

$data{'jobs'}{'store'} = {};

my $sref = <[file.zenka_dir.load]>->( 'store.yaml', ':utf8' );
if ( defined $sref ) {
    eval {
        my $loaded = YAML::XS::Load( $sref->$* );
        $data{'jobs'}{'store'} = $loaded if ref $loaded eq 'HASH';
    };
    <[base.logs]>->( 0, 'jobs: load error: %s', $@ ) if $@;
    <[base.logs]>->(
        1,
        'jobs: loaded %d entries from store',
        scalar keys %{ $data{'jobs'}{'store'} }
    );
} else {
    <[base.logs]>->( 1, 'jobs: store empty, starting fresh' );
}

