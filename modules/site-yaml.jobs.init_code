## [:< ##

# name  = site-yaml.jobs.init_code
# descr = initialize job store, load persisted data from per-file layout

<[base.perlmod.autoload]>->('YAML::XS');
<[base.perlmod.autoload]>->('File::Path');

$data{'jobs'}{'store'} = {};

## load from per-file layout
my $jobs = <[jobsite.job.load_all}>;
if ( ref $jobs eq 'HASH' and %{$jobs} ) {
    $data{'jobs'}{'store'} = $jobs;
    <[base.logs]>->(
        1,
        'jobs: loaded %d entries from per-file layout',
        scalar keys %{$jobs}
    );
} else {
    ## fallback: load from legacy store.yaml and migrate to per-file
    my $sref = <[file.zenka_dir.load]>->('store.yaml');
    if ( defined $sref ) {
        eval {
            my $loaded = YAML::XS::Load( $sref->$* );
            $data{'jobs'}{'store'} = $loaded if ref $loaded eq 'HASH';
        };
        <[base.logs]>->( 0, 'jobs: load error: %s', $@ ) if $@;
        my $count = scalar keys %{ $data{'jobs'}{'store'} };
        <[base.logs]>->(
            1, 'jobs: loaded %d entries from legacy store', $count
        );

        ## migrate to per-file layout
        if ($count) {
            for my $job_id ( keys %{ $data{'jobs'}{'store'} } ) {
                my $job = $data{'jobs'}{'store'}{$job_id};
                next if ref $job ne 'HASH';
                <[jobsite.job.write]>->( $job_id, $job );
            }
            <[base.logs]>->(
                1, 'jobs: migrated %d entries to per-file layout', $count
            );
        }
    } else {
        <[base.logs]>->( 1, 'jobs: store empty, starting fresh' );
    }
}

