## [:< ##

# name  = site-yaml.jobs.init_code
# descr = initialize job store, load persisted data

map { <[base.perlmod.autoload]>->($ARG) } qw| YAML::XS File::Path |;

my $store_dir  = '/var/protocol-7/jobs';
my $store_file = "$store_dir/store.yaml";

File::Path::make_path($store_dir) if not -d $store_dir;

$data{'jobs.store_file'} = $store_file;
$data{'jobs.store'}      = {};

if ( -f $store_file ) {
    eval {
        my $loaded = YAML::XS::LoadFile($store_file);
        $data{'jobs.store'} = $loaded if ref $loaded eq 'HASH';
    };
    <[base.logs]>->( 0, 'jobs: load error: %s', $@ ) if $@;
    <[base.logs]>->(
        1,
        'jobs: loaded %d entries from store',
        scalar keys %{ $data{'jobs.store'} }
    );
} else {
    <[base.logs]>->( 1, 'jobs: store empty, starting fresh' );
}

