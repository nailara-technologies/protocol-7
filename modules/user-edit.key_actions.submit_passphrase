# name  = user-edit.key_actions.submit_passphrase
# descr = key-create stage 2 : validate passphrase, gen_keys + write_keys
# param = $editor_state, $value, $prompt

## on_submit for the key-actions masked passphrase prompt.  this module is
## what CLOSES the last base.exit-reachable path in the key-create flow [
## design anchor 3 ] : keys.console.create is no longer called at all -- its
## whole post-guard body was '<[crypt.C25519.gen_keys]>->($name)' then
## '<[crypt.C25519.write_keys]>->( $name, $key_password )', and BOTH were
## re-read for this conversion : neither contains a base.exit call [ their
## failure modes are warn / return undef / return FALSE only ].  the one guard
## that used to be un-pre-emptable -- read_password_repeated returning an
## undef / <= 1 char password, base.exiting from INSIDE keys.console.create --
## is now just the length check below, done by user-edit itself BEFORE
## anything is generated.  threshold matched exactly from
## keys.console.create's own guard : 'length <= 1' fails.
##
## gen_keys's harmonic-truth retry loop re-pumps the event loop through
## <[event.once]> while it runs [ base.event.once is a real Event::loop() ] --
## the reentrant-dispatch protection for that window is the prompt's OWN busy
## flag, set by editor.control.prompt.handler.key around this very call [ the
## <user-edit.key_actions.busy> global it replaces guarded the old out-of-loop
## excursion shape, now retired ].
##
## no user-edit.message calls anywhere in this flow : that module printf()s
## raw terminal output, which was fine for the old out-of-loop excursion with
## the terminal in canonical mode but would corrupt the live frame here -- the
## key_actions row's own 'last : ..' display is the feedback.

my ( $editor_state, $value, $prompt ) = @ARG;

return FALSE if ref $editor_state ne qw| HASH |;

my $password = $value // '';
my $name     = ref $prompt eq qw| HASH | ? $prompt->{'data'}{'name'} : undef;

my $done = sub {
    my ( $text, $ok ) = @ARG;
    <user-edit.key_actions.last_result> = $text;
    <[editor.control.prompt.cancel]>->($editor_state);
    return $ok // FALSE;
};

return $done->(q|key create lost its name, nothing created|)
    if not length( $name // '' );

## the passphrase validation keys.console.create could never let us do.  TWO
## thresholds, both read off the real code path, not guessed : its own guard
## fails 'length <= 1', and AMOS7::13::key_32 [ the enc-key derivation
## write_keys runs on the password ] warns 'expected password length is at
## least 13 characters' and returns undef below that -- found live : a 10-char
## passphrase passed the first guard, then failed the write AFTER gen_keys had
## already run.  checking 13 up front keeps that partial-write path
## unreachable
return $done->(q|passphrase empty or too short, nothing created|)
    if length $password <= 1;

return $done->(q|passphrase too short [ min 13 ], nothing created|)
    if length $password < 13;

my ( $key_ref, $gen_name ) = <[crypt.C25519.gen_keys]>->($name);

return $done->( sprintf( q|key '%s' generation failed|, $name ) )
    if ref $key_ref ne qw| HASH |;

my $written = <[crypt.C25519.write_keys]>->( $name, $password );

return $done->( sprintf( q|key '%s' could not be written|, $name ) )
    if not $written;

## the on-disk key list just changed, and user_keys' own field_def/buffer were
## built ONCE at schema time [ see user-edit.form.build_user_keys_ field's own
## header : "on-disk key list is not going to move mid-session" was true until
## key-create made it false ].  without this refresh the new key is real [
## keys list sees it ] but invisible in the form until a full reload -- the
## exact post-create display gap the PREVIOUS round of this feature shipped.
## mutate the EXISTING field_def hashref in place [ found by name in the live
## schema array ] and swap in a fresh buffer wholesale --
## editor.buffer.memory.load refuses on a readonly buffer, create has no such
## guard and is the same call editor.control.create used originally
my ($user_keys_def)
    = grep { ( $ARG->{'name'} // '' ) eq qw| user_keys | }
    ( $editor_state->{'schema'}{'fields'} // [] )->@*;

if ( ref $user_keys_def eq qw| HASH | ) {
    my $fresh_def = <[user-edit.form.build_user_keys_field]>;
    %$user_keys_def = %$fresh_def;
    $editor_state->{'fields'}{'user_keys'}
        = <[editor.buffer.memory.create]>->($fresh_def);
}

return $done->( sprintf( q|created key '%s'|, $name ), TRUE );

