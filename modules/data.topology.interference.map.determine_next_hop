# name = data.topology.interference.map.determine_next_hop
# desc = Determine optimal next hop from resonance field

my ( $spatial, $resonance_map ) = @_;

# Find neighbor with highest resonance
my $best_neighbor;
my $best_resonance = 0;

for my $neighbor ( @{ $spatial->{'neighbors'} } ) {
    my $key = join( ',', @$neighbor );
    my $res = $resonance_map->{$key} // 0;
    if ( $res > $best_resonance ) {
        $best_resonance = $res;
        $best_neighbor  = $neighbor;
    }
}

return $best_neighbor // $spatial->{'neighbors'}[0];

