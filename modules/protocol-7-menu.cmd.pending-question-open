## [:< ##

# name  = protocol-7-menu.cmd.pending-question-open
# descr = Open the oldest pending question via its dialog

my $questions = <protocol-7-menu.pending-questions> // [];

return { 'mode' => qw| false |, 'data' => 'no pending questions' }
    unless scalar @$questions;

my $question = shift @$questions;
my $type     = $question->{'type'}     // '';
my $text     = $question->{'question'} // '';
my $result;

if ( $type eq qw| text | ) {
    $result = <[protocol-7-menu.cmd.input-text]>->($text);
} elsif ( $type eq qw| password | ) {
    $result = <[protocol-7-menu.cmd.input-password]>->($text);
} elsif ( $type eq qw| choice | ) {
    my $options = $question->{'options'} // [];
    my $payload = JSON::encode_json( [ $text, $options ] );
    $result = <[protocol-7-menu.cmd.input-choice]>->($payload);
} else {
    return {
        'mode' => qw| false |,
        'data' => sprintf( "unknown pending question type: %s", $type )
    };
}

## Remove answered question if dialog returned a value ##
if (    ref $result eq qw| HASH |
    and $result->{'mode'} eq qw| true |
    and defined $result->{'data'} ) {
    <[base.logs]>->(
        1,
        "pending question answered via dialog : id=%s",
        $question->{'id'} // '?'
    );
} else {
    ## Return to queue if no selection ##
    unshift @$questions, $question;
}

<[protocol-7-menu.pending-indicator-update]>;

return $result;

