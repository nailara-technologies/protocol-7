# name  = coding.vision-parser.handler.check_extraction_completion
# descr = polling handler for text extraction completion - triggered by timer until result available

my $watcher = shift->w if @ARG;
my $job_id  = shift;

my $job = <coding.vision-parser.jobs>->{$job_id};

unless ( defined $job && $job->{'extraction_pending'} ) {

    # Job not found or not waiting for extraction, cancel timer
    $watcher->cancel if defined $watcher && $watcher->is_active;
    return;
}

<[base.logs]>->(
    2, '[vision-parser] checking extraction completion: job=%s', $job_id
);

# Check if extraction result has been populated by the coding zenka callback
if ( defined $job->{'extraction_result'}
    && length $job->{'extraction_result'} > 0 ) {

    # Text extraction complete!
    <[base.logs]>->(
        1,       '[vision-parser] text extraction complete: job=%s bytes=%d',
        $job_id, length( $job->{'extraction_result'} )
    );

    # Cancel timer
    $watcher->cancel if defined $watcher && $watcher->is_active;
    delete <coding.vision-parser.timers>->{ $job_id . '_extraction' };

    # Clear pending flag
    $job->{'extraction_pending'} = 0;

    # Transition state to trigger final response
    <coding.vision-parser.state> = 'extracting_done';
    <[base.logs]>->(
        2, '[vision-parser] state transition: extracting_done (job=%s)',
        $job_id
    );
}

return;

