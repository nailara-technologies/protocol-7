# name  = plugin.storage.util.inference.update_branch_meta
# descr = update or create branch .meta file [ relative path for zenka_dir ]

my ( $rel_path, $question, $time, $action ) = @ARG;

## read existing meta via zenka_dir.load ##
my %meta;
my $existing = <[file.zenka_dir.load]>->($rel_path);
if ( defined $existing ) {
    for my $line ( split "\n", $existing->$* ) {
        $meta{$1} = $2 if $line =~ m{^([^=]+)=(.*)$};
    }
}

$meta{'question'}  //= $question;
$meta{'created'}   //= $time;
$meta{'hit_count'} //= 0;
$meta{'last_access'} = $time;

if ( $action eq qw| hit | ) {
    $meta{'hit_count'}++;
}

my $content = join '', map {"$ARG=$meta{$ARG}\n"} sort keys %meta;
<[file.zenka_dir.write]>->(
    $rel_path, \$content, qw| > |, 0664, ':encoding(UTF-8)'
);

return;

