## [:< ##

# name  = protocol-7-menu.position.save
# param = $x_coord, $y_coord, $screen_key (window position, "<w>x<h>")
# descr = save window position to YAML file in zenka directory, keyed by
#         screen resolution [ positions saved on one screen size are not
#         valid on another, eg. host display vs. a small xephyr screen ]
# return = bytes written or undef on error

use YAML::XS qw| Load Dump |;

my ( $x, $y, $screen_key ) = @ARG;

unless ( defined $x && defined $y ) {
    <[base.s_warn]>->('x and y coordinates required');
    return undef;
}

# Clamp to valid on-screen bounds: never save negative coordinates [ left \
# top edge ] Multi-monitor setups may have coordinates beyond single screen
# width, so allow those
$x = 0 if $x < 0;
$y = 0 if $y < 0;

$screen_key //= qw| default |;

<[base.logs]>->(
    1, "[position.save] saving clamped position [%s]: x=%d y=%d",
    $screen_key, $x, $y
);

## load existing positions [ other screen-resolution entries must survive ] ##
my $positions    = {};
my $existing_ref = <[file.zenka_dir.load]>->('window/position.yaml');
if ( defined $existing_ref ) {
    my $existing_content
        = ref($existing_ref) eq qw| SCALAR | ? $$existing_ref : $existing_ref;
    eval {
        my $parsed = Load($existing_content);
        $positions = $parsed->{'positions'}
            if ref($parsed) eq qw| HASH |
            and ref( $parsed->{'positions'} ) eq qw| HASH |;
    };
}

$positions->{$screen_key} = { 'x' => $x, 'y' => $y };

## Prepare YAML structure
my $yaml_data = {
    positions => $positions,
    metadata  => { 'saved_at' => <[base.time]>->(3), }
};

## Convert to YAML
my $yaml_content;
eval { $yaml_content = Dump($yaml_data); };
if ($EVAL_ERROR) {
    <[base.s_warn]>->(
        'YAML serialization failed: %s',
        <[base.str.eval_error]>
    );
    return undef;
}

unless ( defined $yaml_content && length $yaml_content ) {
    <[base.s_warn]>->('YAML serialization produced empty content');
    return undef;
}

## Write to zenka directory using base system [ window/position.yaml ]
my $bytes_written = <[file.zenka_dir.write]>->(
    'window/position.yaml',
    \$yaml_content,
    '>',       # Overwrite mode
    0600,      # File permissions (owner read/write only)
    ':utf8'    # UTF-8 encoding
);

unless ( defined $bytes_written ) {
    <[base.s_warn]>->('failed to write position YAML file');
    return undef;
}

<[base.logs]>->(
    1,  '[position.save] saved window position x=%d y=%d [bytes:%d]',
    $x, $y, $bytes_written
);

return $bytes_written;

