## [:< ##

# name  = index.tick.feed-dir
# descr = one tick of a feed-dir job : process one file

my $job_id = shift                   // $ARG;
my $job    = <index.jobs>->{$job_id} // return;

my $file = shift @{ $job->{'files'} };

if ( not defined $file ) {
    ## all files done ##
    delete <index.jobs>->{$job_id};
    my $total = $job->{'total'};
    if ( $job->{'rebalance-later'} ) {
        delete <index.cfg.rebalance_deferred>;
        <[index.rebalance]>;
    }
    <[base.log]>->( 1, "index feed-dir complete [ $total files ]" );
    <[base.callback.cmd_reply]>->(
        $job->{'reply_id'},
        { 'mode' => 'size', 'data' => "fed $total files\n" }
    );
    return;
}

my $ok = <[index.feed.file]>->($file);
<[base.log]>->( 1, "index feed skipped [ $file ]" ) if not $ok;
$job->{'done'}++;

