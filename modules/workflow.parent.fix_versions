## [:< ##

# name = workflow.parent.fix_versions
# descr = Surgical rewrite of commits to fix missing version numbers (minimal changes)

my $params = shift || {};

my $dry_run = $params->{dry_run} // 1;  ## Safe by default
my $auto_approve = $params->{auto_approve} // 0;
my $key_phrase = $params->{key_phrase} // '';
my $abort_after_valid = $params->{abort_after_valid} // 13;  ## Default optimization
my $display_limit = $params->{display_limit} // 20;  ## Show first N commits in dry-run
my $show_all = $params->{show_all} // 0;  ## Override display_limit

<[base.log]>->( 2, "workflow.fix_versions: analyzing commits needing version fixes..." );

## TODO: Load signing key when actual rewriting is implemented
## For now, just check that execute mode will fail gracefully
unless ($dry_run) {
    <[base.log]>->( 2, "  Execute mode requested..." );
}

## Ensure history is scanned with parameters
my $last_scan = <workflow.history.scanned> // 0;
unless ($last_scan > 0) {
    <[workflow.parent.scan_history]>->({
        key_phrase => $key_phrase,
        abort_after_valid => $abort_after_valid
    });
}

## Find commits missing versions
my @commits_to_fix;

my $issues_ref = <workflow.history.issues> // {};
foreach my $hash (keys %{$issues_ref}) {
    my $issue = $issues_ref->{$hash} // next;

    if (($issue->{type} // '') eq 'missing_version') {
        push @commits_to_fix, {
            hash   => $hash,
            commit => $issue->{commit} // {}
        };
    }
}

my $total_to_fix = scalar(@commits_to_fix);

unless ($total_to_fix) {
    <[base.log]>->( 2, "  ✓ No commits need version fixes" );
    return {
        success => 1,
        fixed   => 0,
        message => 'All commits have version numbers'
    };
}

<[base.log]>->( 2, "  Found $total_to_fix commits missing version numbers" );

if ($dry_run) {
    ## Limit commits returned based on display_limit
    my $display_count = $show_all ? $total_to_fix : ($display_limit < $total_to_fix ? $display_limit : $total_to_fix);
    my @commits_to_display = @commits_to_fix[0..($display_count-1)];

    return {
        success => 1,
        dry_run => 1,
        would_fix => $total_to_fix,
        displayed => $display_count,
        has_more => ($total_to_fix > $display_count),
        commits => \@commits_to_display,
        all_commits => \@commits_to_fix  ## Full list if needed
    };
}

## Execute mode: Actually rewrite commits
<[base.log]>->( 1, "  EXECUTE MODE: Rewriting $total_to_fix commits..." );
<[base.log]>->( 1, "  WARNING: This will rewrite git history!" );

## Load required modules (source module loads crypt.C25519 and sets up paths)
unless (exists $code{'source.load_signature_key'}) {
    <[base.log]>->( 2, "  Loading source module..." );
    <[base.load_modules]>->('source');
}

## Get signature key name from source config (set in source.init_code)
my $sig_key_name = <source.C25519.signature_key_name> // qw| proto-7.sourcecode |;
<[base.log]>->( 2, "  Loading signature key '$sig_key_name'..." );

unless (<[crypt.C25519.key_exists]>->($sig_key_name)) {
    return {
        success => 0,
        error   => "Signature key '$sig_key_name' does not exist - cannot sign commits"
    };
}

<[crypt.C25519.load_keypair]>->($sig_key_name);

unless (exists $keys{'C25519'}{$sig_key_name}
    && exists $keys{'C25519'}{$sig_key_name}{'private'}
    && exists $keys{'C25519'}{$sig_key_name}{'public'}) {
    return {
        success => 0,
        error   => "Failed to load signature key '$sig_key_name'"
    };
}

<[base.log]>->( 2, "  ✓ Signature key loaded" );

## Get repository path
my $repo_path = <git.cfg.repository_path>;
unless (-d $repo_path) {
    return {
        success => 0,
        error   => "Repository path not found: $repo_path"
    };
}

## Generate version numbers for each commit (based on position in history)
<[base.log]>->( 2, "  Generating version numbers..." );

my %commit_versions;  ## hash -> version number
my $commit_index = 0;

## Get full commit history to calculate positions
my $log_result = <[git.parent.get_log]>->({});
unless ($log_result->{success}) {
    return {
        success => 0,
        error   => 'Failed to get full commit history'
    };
}

my @all_commits = reverse @{$log_result->{commits}};  ## oldest first
for (my $i = 0; $i < @all_commits; $i++) {
    my $hash = $all_commits[$i]{hash};
    $commit_versions{$hash} = $i + 1;  ## 1-indexed
}

<[base.log]>->( 2, sprintf("  ✓ Generated %d version numbers", scalar(keys %commit_versions)) );

## Create message filter script
<[base.log]>->( 2, "  Creating message filter script..." );

my $filter_script = "$repo_path/.git/workflow-msg-filter.pl";
my $versions_file = "$repo_path/.git/workflow-versions.txt";

## Write version mappings to file for filter script to read
open(my $vfh, '>', $versions_file) or do {
    return {
        success => 0,
        error   => "Cannot create versions file: $!"
    };
};

foreach my $hash (keys %commit_versions) {
    say {$vfh} "$hash $commit_versions{$hash}";
}
close($vfh);

## Create the msg-filter script
my $filter_code = <<'FILTER_END';
#!/usr/bin/perl
use v5.24;
use strict;
use warnings;

my $versions_file = $ENV{WORKFLOW_VERSIONS_FILE};
my $commit_hash = $ENV{GIT_COMMIT};

## Load version mappings
my %versions;
if (open(my $fh, '<', $versions_file)) {
    while (my $line = <$fh>) {
        chomp $line;
        if ($line =~ /^(\S+)\s+(\d+)$/) {
            $versions{$1} = $2;
        }
    }
    close($fh);
}

## Read commit message from stdin
my $message = do { local $/; <STDIN> };

## Add version if this commit needs it and doesn't have one
if (exists $versions{$commit_hash} && $message !~ /^\[v?\d+/) {
    my $version = $versions{$commit_hash};
    $message = "[$version] $message";
}

print $message;
FILTER_END

open(my $sfh, '>', $filter_script) or do {
    return {
        success => 0,
        error   => "Cannot create filter script: $!"
    };
};
print {$sfh} $filter_code;
close($sfh);
chmod 0755, $filter_script;

<[base.log]>->( 2, "  ✓ Message filter created" );

## Find oldest commit that needs fixing
my @commit_hashes = map { $_->{hash} } @commits_to_fix;
my $oldest_hash = $commit_hashes[-1];  ## Last in list (oldest)

<[base.log]>->( 1, "  Running git filter-branch..." );
<[base.log]>->( 1, "    This may take several minutes for large histories" );

## Set environment for filter script
$ENV{WORKFLOW_VERSIONS_FILE} = $versions_file;

## Run git filter-branch
my $git_cmd = sprintf(
    'cd %s && git filter-branch -f --msg-filter %s --',
    $repo_path,
    $filter_script
);

my $output = `$git_cmd 2>&1`;
my $exit_code = $? >> 8;

## Clean up temporary files
unlink $filter_script;
unlink $versions_file;

if ($exit_code != 0) {
    <[base.log]>->( 0, "  ✗ Git filter-branch failed:" );
    <[base.log]>->( 0, "  $output" );
    return {
        success => 0,
        error   => "Git filter-branch failed (exit: $exit_code)",
        output  => $output
    };
}

<[base.log]>->( 1, "  ✓ Git history rewritten successfully" );
<[base.log]>->( 1, "  ✓ Added version numbers to $total_to_fix commits" );

return {
    success => 1,
    fixed   => $total_to_fix,
    message => "Successfully added version numbers to $total_to_fix commits"
};

0;

