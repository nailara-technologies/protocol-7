## [:< ##

# name = models.escape.encode
# descr = encode newlines and tabs to escape sequences for buffer storage
# param = $text - text with actual newlines/tabs
# return = text with escapes encoded as :n: :t:

my $text = shift;

return '' unless defined $text;

## encode actual characters to escapes
$text =~ s/\n/:n:/g;
$text =~ s/\t/:t:/g;

return $text;

0;

