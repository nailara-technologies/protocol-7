# name  = audio.handler.decode_timeout
# descr = abort stalled ffmpeg decode and reply false to deferred caller

my $event = shift;

my $wdata = eval { $event->w->data } // {};
my $id    = $wdata->{'id'}           // '';

my $state = <audio.decode>->{$id} or return;

<[base.log]>->( 0, 'audio decode timeout : %s', $state->{'path'} // $id );

## empty pcm makes finalize_decode take the false-reply path ##
$state->{'stderr'} = 'decode timeout';
$state->{'pcm'}    = '';

<[audio.finalize_decode]>->($id);

return;

