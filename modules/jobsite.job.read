## [:< ##

# name  = jobsite.job.read
# descr = read a single job record from per-file storage

my $job_id = shift // '';
return undef if not length $job_id;

my $job_file = "/var/protocol-7/jobsite/jobs/$job_id.yaml";
return undef if not -f $job_file;

my $job = eval { YAML::XS::LoadFile($job_file) };
if ($@) {
    <[base.logs]>->( 0, 'jss.job.read: load error for %s: %s', $job_id, $@ );
    return undef;
}

return ref $job eq 'HASH' ? $job : undef;

