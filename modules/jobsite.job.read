## [:< ##

# name  = jobsite.job.read
# descr = read a single job record from per-file storage via status index

my $job_id = shift // '';
return undef if not length $job_id;

my $status = <jobsite.job.index>->{$job_id} // '';
return undef unless length $status;

my $enc_id = <[base.vax-int.encode]>->($job_id);

my $rel_path = do {
    if ( $status =~ m{^(blocked|deleted):(.+)$} ) {
        "jobs/$1/$2/$enc_id.yaml";
    } else {
        "jobs/$status/$enc_id.yaml";
    }
};

my $raw = <[file.zenka_dir.load]>->($rel_path);
return undef unless defined $raw;

my $bytes = $$raw;
utf8::encode($bytes) if utf8::is_utf8($bytes);
my $job = eval { YAML::XS::Load($bytes) };
if ($@) {
    <[base.logs]>->( 0, 'jss.job.read: load error for %s: %s', $job_id, $@ );
    return undef;
}
return undef if ref $job ne 'HASH';

## normalize all scalar values to unicode strings ##
for my $v ( values %$job ) {
    next             if not defined $v or ref $v;
    utf8::decode($v) if not utf8::is_utf8($v) and utf8::valid($v);
}

return $job;

