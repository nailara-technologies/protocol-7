## [:< ##

# name  = credential_fabric.ui.query.auth_relay
# descr = return pending auth-relay requests with computed age

my $pending = <credential_fabric.auth_relay_pending> // {};
my $now     = <[base.time]>->(3);

my @entries;
for my $req_id ( sort keys %$pending ) {
    my $entry = $pending->{$req_id};
    my $ntime = $entry->{'ntime'} // 0;
    my $age_s = 0;
    if ( $ntime =~ m{^\d+\.\d+$} ) {
        $age_s = int( $now - $ntime );
        $age_s = 0 if $age_s < 0;
    }

    push @entries,
        {
        'req_id' => $req_id,
        'domain' => $entry->{'domain'} // '',
        'ntime'  => $ntime,
        'age_s'  => $age_s,
        'status' => qw| pending |,
        };
}

return { 'relays' => \@entries };

