## [:< ##

# name  = coding.tools.handler.write_new_file
# descr = write new file with validation and staging support
# param = $args[{path,content,encoding}], encoding defaults to UTF-8
my $args     = shift               // {};
my $path     = $args->{'path'}     // return 'path required';
my $content  = $args->{'content'}  // return 'content required';
my $encoding = $args->{'encoding'} // qw| :encoding(UTF-8) |;

my $content_len = defined $content ? length($content) : 0;

## warn if empty content [ suggest write_append ] ##
if ( $content_len == 0 ) {
    <[base.logs]>->(
        1,     ':. write_new_file: created empty file %s [ %d bytes ]\n',
        $path, $content_len
    );
    return sprintf "created empty file %s [ %d bytes ]\n",
        $path, $content_len;
}

my $root       = <system.root_path>;
my $abs_path   = catfile( $root, $path );
my $stage_name = $path;
$stage_name =~ s|/|__|g;
my $stage_rel = catfile( qw| staged |, $stage_name );

## auto-prefix modules/ for dot-notation filenames without directory ##
if ( $path !~ m|/| and $path =~ m|\.\w+\.| ) {
    $path     = "modules/$path";
    $abs_path = catfile( $root, $path );
}

## validate path stays within project [ resolve symlinks ] ##
my $real_root = Cwd::abs_path($root)                           // '';
my $real_dir  = Cwd::abs_path( ( $abs_path =~ s|/[^/]+$||r ) ) // '';
if (  !length $real_dir
    or index( $real_dir, "$real_root/" ) != 0
    or $path =~ m|\.\./| ) {
    return ': error : path escapes project root' . $path;
}

## refuse to overwrite existing files ##
return "error: file already exists [ $path ]" if -e $abs_path;

## use chmod child to create empty file as admin user if needed ##
my $chmod_fh = <coding.chmod_child.w_fh>;
my $cur_mode;
if ( !-w ( $abs_path =~ s|/[^/]+$||r ) and defined $chmod_fh ) {
    ## parent dir not writable : create file via chmod child then open it ##
    print {$chmod_fh} "create $abs_path\n";
    my $reply = <[coding.chmod_child.readline]>;
    if ( -f $abs_path ) {
        ## grant other-write so coding zenka can write regardless of group ##
        my $raw_mode = ( stat $abs_path )[2];
        $cur_mode = defined $raw_mode ? ( $raw_mode & 07777 ) : 0664;
        printf {$chmod_fh} "restore %04o %s\n", ( $cur_mode | 0002 ),
            $abs_path;
        <[coding.chmod_child.readline]>;    ## wait for restore to complete ##
    }
}

## normalize encoding parameter ##
my $norm_encoding = <[coding.parser.normalize_encoding]>->($encoding);
return
      ': error : unsupported encoding'
    . $encoding
    . '[supported are :raw,:bytes,:encoding(UTF-8)]'
    unless length( $norm_encoding // '' );

## write content if file is writable ##
if ( -f $abs_path and -w $abs_path ) {
    <[file.write]>->( $abs_path, \$content, $norm_encoding );
    if ( defined $chmod_fh and defined $cur_mode ) {
        print {$chmod_fh} sprintf "restore %04o %s\n", $cur_mode, $abs_path;
        <[coding.chmod_child.readline]>
            ;    ## consume restore reply : keep pipe in sync ##
    }
    return sprintf "created %s [ %d bytes ]", $path, length($content);
} elsif ( -d ( $abs_path =~ s|/[^/]+$||r )
    and -w ( $abs_path =~ s|/[^/]+$||r ) ) {
    <[file.write]>->( $abs_path, \$content, $norm_encoding );
    chmod( 0664, $abs_path );
    return sprintf "created %s [ %d bytes ]", $path, length($content);
}

## stage to zenka dir when no write access ##
<[file.zenka_dir.write]>->(
    $stage_rel, \$content, qw| > |, 0664, $norm_encoding
);
<[base.logs]>->(
    1, ':. write_new_file : staged %s [ no write access ]', $path
);
return
    sprintf "staged new file %s [ %d bytes, no write access "
    . "]\nstaged at : %s", $path, length($content), $stage_rel;

