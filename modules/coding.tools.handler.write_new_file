## [:< ##
# name  = coding.tools.handler.write_new_file
# descr = write new file with validation and staging support

my $args    = shift              // {};
my $path    = $args->{'path'}    // return 'path required';
my $content = $args->{'content'} // return 'content required';

my $root     = <system.root_path>;
my $abs_path = "$root/$path";

## validate path stays within project ##
return 'error: path escapes project root'
    if $abs_path =~ m|\.\./| or $path =~ m|^/|;

## refuse to overwrite existing files ##
return "error: file already exists [ $path ]" if -e $abs_path;

## check if parent dir is writable ##
my $dir = $abs_path;
$dir =~ s|/[^/]+$||;

## chmod g+w parent dir if configured and not writable ##
my $did_chmod = 0;
if (    -d $dir
    and !-w $dir
    and ( <coding.cfg.allow_chmod_apply> // '' ) eq qw| yes | ) {
    my $mode = ( stat $dir )[2];
    if ( defined $mode ) {
        chmod( $mode | 020, $dir );    ## add g+w ##
        $did_chmod = 1;
    }
}

if ( -d $dir and -w $dir ) {
    <[file.put]>->( $abs_path, \$content );
    chmod( 0664, $abs_path );
    ## restore dir permissions ##
    chmod( 0775, $dir ) if $did_chmod;
    return sprintf "created %s [ %d bytes ]", $path, length($content);
}
## restore dir if chmod didn't help ##
chmod( 0775, $dir ) if $did_chmod;

## stage to zenka dir when no write access ##
my $stage_name = $path;
$stage_name =~ s|/|__|g;
my $stage_rel = "staged/$stage_name";
<[file.zenka_dir.write]>->(
    $stage_rel, \$content, '>', 0664, ':encoding(UTF-8)'
);
<[base.logs]>->(
    1, ':. write_new_file: staged %s [ no write access ]', $path
);
return sprintf "staged new file %s [ %d bytes, no write access ]\n"
    . "staged at: %s",
    $path, length($content), $stage_rel;

