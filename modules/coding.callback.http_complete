## [:< ##

# name  = coding.callback.http_complete
# descr = HTTP streaming complete callback

my ( $task_id, $http_state ) = @ARG;

<[base.logs]>->(
    1,
    "async.request: inference complete for %s [%d bytes, %d chunks]",
    $task_id,
    $http_state->{'bytes_received'},
    $http_state->{'chunks_received'}
);

## check if state machine already handled this task ##
my $state = <[coding.async.state_manager]>->( qw| get |, $task_id );
if ( !defined $state ) {
    ## state already cleaned up by state machine completion ##
    <[base.logs]>->(
        2, "http_complete: no state for %s [ already handled ]", $task_id
    );
    return;
}

my $sm_state = $state->{'state'} // '';

<[base.logs]>->(
    2,
    "http_complete: %s sm_state=%s finish_reason=%s tool_calls=%d",
    $task_id,
    $sm_state,
    $state->{'finish_reason'} // 'undef',
    scalar( @{ $state->{'tool_calls'} // [] } )
);

## write response to model output buffer (unless empty or tool calls pending) ##
if ( length( $state->{'response_text'} ) && $sm_state ne 'tool_exec' ) {
    <[coding.buffer.model_output]>->(
        $state->{'response_text'},
        {   'round' => $state->{'chunk_context'}{'round'} // 0,
            'tool'  => 'model',
        }
    );
}

## state machine drives all transitions — defer unless no transition happened ##
if ( $sm_state eq 'tool_exec' || $sm_state eq 'streaming' ) {
    ## tool loop in progress or new round started — do not interfere ##
    <[base.logs]>->(
        2, "http_complete: task %s state=%s, deferring to state machine",
        $task_id, $sm_state
    );
    return;
}

if ( $sm_state eq 'complete' || $sm_state eq 'error' ) {
    ## state machine already finalized — nothing to do ##
    <[base.logs]>->(
        2,        "http_complete: task %s already %s",
        $task_id, $sm_state
    );
    return;
}

return;

