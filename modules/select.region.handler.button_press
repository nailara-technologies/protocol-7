## [:< ##

# name  = select.region.handler.button_press
# descr = begin drag or commit on double-click

my ( $id, $widget, $event ) = @ARG;

return TRUE if not defined $id;

my $inst = $data{select}{region}{instances}{$id};
return TRUE if not defined $inst;

my $ex = $event->x;
my $ey = $event->y;

my $w = $inst->{'geom'}{'width'}  // 320;
my $h = $inst->{'geom'}{'height'} // 240;

## right-click anywhere : submit, same as the enter key. commit is      ##
## deferred to button-release [ committing here would Gtk3->main_quit   ##
## and exit before the release event arrives, so the underlying         ##
## desktop would see an unmatched release and pop its context menu ].   ##
## switch to a thin cross cursor right away so the press itself signals ##
## the pending submit.                                                  ##
if ( $event->button == 3 ) {
    my $gdk_window = $widget->get_window;
    $gdk_window->set_cursor( Gtk3::Gdk::Cursor->new('tcross') )
        if defined $gdk_window;
    return TRUE;
}

my $region = <[select.region.classify_region]>->( $id, $ex, $ey );

## double-click on body : re-center the window on the cursor [ also     ##
## compensates for the missed first drag under wslg/xwayland, letting   ##
## the user land the window without relying on drag at all ]            ##
if ( $region eq 'body' ) {
    my $now = <[base.time]>->(5);
    if ( defined $inst->{'last_click'}
        and ( $now - $inst->{'last_click'} ) < 0.3 ) {
        <[base.log]>->( 1, '[region.button_press] double-click re-center' );
        my $new_geom = {
            'x'      => int( $event->x_root - $w / 2 ),
            'y'      => int( $event->y_root - $h / 2 ),
            'width'  => $w,
            'height' => $h
        };
        <[select.region.damp.set_target]>->( $id, $new_geom );
        <[select.region.update_x11_state]>->( $id, $new_geom );
        delete $inst->{'last_click'};
        return TRUE;
    }
    $inst->{'last_click'} = $now;
}

$inst->{'drag'}{'active'}     = TRUE;
$inst->{'drag'}{'region'}     = $region;
$inst->{'drag'}{'start_x'}    = $event->x_root;
$inst->{'drag'}{'start_y'}    = $event->y_root;
$inst->{'drag'}{'start_geom'} = {
    'x'      => $inst->{'geom'}{'x'}      // 0,
    'y'      => $inst->{'geom'}{'y'}      // 0,
    'width'  => $inst->{'geom'}{'width'}  // $w,
    'height' => $inst->{'geom'}{'height'} // $h
};

<[base.logs]>->( 2, '[region.button_press] id=%s region=%s', $id, $region );

return TRUE;

