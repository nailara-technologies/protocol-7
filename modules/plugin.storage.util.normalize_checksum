# name  = plugin.storage.util.normalize_checksum
# descr = Normalize checksum to standard format

my ($checksum) = @_;
return undef unless defined $checksum;
$checksum =~ s|\s+||g;
if ( $checksum !~ m|^[a-z0-9-]+:|i ) {
    $checksum = "bmw-L13:$checksum";
}
return lc($checksum);

