# name  = select.region.set_hover_cursor
# descr = set the window cursor for a region, only when it changes

my ( $id, $widget, $region ) = @ARG;

return undef if not defined $id;
return undef if not defined $widget;

my $inst = $data{select}{region}{instances}{$id};
return undef if not defined $inst;

## skip when the region has not changed since last motion ##
return TRUE
    if defined $inst->{'hover'}{'region'}
    and $inst->{'hover'}{'region'} eq $region;

my $gdk_window = $widget->get_window;
return TRUE if not defined $gdk_window;    ## not realized yet ##

## use core-font cursor type nicks via the single-arg constructor; these  ##
## are server-builtin and do not depend on an xcursor theme being set,    ##
## unlike new_from_name which falls back to the giant white core cursor   ##
## in this minimal xwayland/wsl environment.                              ##
my $name   = <[select.region.cursor_for_region]>->($region);
my $cursor = Gtk3::Gdk::Cursor->new($name);

## set_cursor(undef) just resets, fine if the type is unknown ##
$gdk_window->set_cursor($cursor);

## record only after a successful set so a pre-realize hover retries ##
$inst->{'hover'}{'region'} = $region;

return TRUE;

