## [:< ##

# name = debian.parent.check_installed
# descr = Check which dependencies are installed and update registry status

my $params = shift || {};

<[base.log]>->( 2, "debian.check: checking installation status..." );

my $checked_pkgs    = 0;
my $installed_count = 0;
my $missing_count   = 0;

## Check all registered Debian packages
foreach my $pkg_id ( keys %{ $data{'debian'}{'packages'}{'registry'} } ) {
    my $pkg      = $data{'debian'}{'packages'}{'registry'}{$pkg_id};
    my $pkg_name = $pkg->{package};

    ## Use dpkg-query to check if installed
    my $installed
        = <[debian.parent.callback.check_package_installed]>->($pkg_name);

    if ($installed) {
        $pkg->{status}            = qw| installed |;
        $pkg->{installed_version} = $installed;
        $installed_count++;
    } else {
        $pkg->{status}            = qw| missing |;
        $pkg->{installed_version} = undef;
        $missing_count++;
    }

    $checked_pkgs++;
}

## Check all registered CPAN modules
my $checked_modules = 0;
my $via_debian      = 0;
my $via_cpan        = 0;
my $missing_modules = 0;

foreach my $mod_id ( keys %{ $data{'debian'}{'cpan_modules'}{'registry'} } ) {
    my $mod         = $data{'debian'}{'cpan_modules'}{'registry'}{$mod_id};
    my $module_name = $mod->{module};

    ## First check if debian package is installed
    if ( $mod->{debian_package} ) {
        my $pkg_id = $data{'debian'}{'packages'}{'by_name'}
            { $mod->{debian_package} };
        if (   $pkg_id
            && $data{'debian'}{'packages'}{'registry'}{$pkg_id}{status} eq
            'installed' ) {
            $mod->{status} = qw| via_debian |;
            $via_debian++;
            $checked_modules++;
            next;
        }
    }

    ## Check if module is loadable (installed via cpan or core)
    my $loadable
        = <[debian.parent.callback.check_module_loadable]>->($module_name);

    if ($loadable) {
        $mod->{status} = qw| via_cpan |;
        $via_cpan++;
    } else {
        $mod->{status} = qw| missing |;
        $missing_modules++;
    }

    $checked_modules++;
}

## Update zenki status
foreach my $zenka_id ( keys %{ $data{'debian'}{'zenki_deps'}{'registry'} } ) {
    my $zenka = $data{'debian'}{'zenki_deps'}{'registry'}{$zenka_id};

    my $missing = 0;
    foreach my $pm ( @{ $zenka->{pm_deps} || [] } ) {
        my $mod_id = $data{'debian'}{'cpan_modules'}{'by_name'}{$pm};
        if ($mod_id) {
            my $mod_status
                = $data{'debian'}{'cpan_modules'}{'registry'}{$mod_id}
                {status};
            $missing++ if $mod_status eq 'missing';
        }
    }

    foreach my $os ( @{ $zenka->{os_deps} || [] } ) {
        my $pkg_id = $data{'debian'}{'packages'}{'by_name'}{$os};
        if ($pkg_id) {
            my $pkg_status
                = $data{'debian'}{'packages'}{'registry'}{$pkg_id}{status};
            $missing++ if $pkg_status eq 'missing';
        }
    }

    $zenka->{missing_count} = $missing;
    $zenka->{status}
        = $missing == 0 ? qw| complete |
        : $missing < ( $zenka->{pm_deps_count} + $zenka->{os_deps_count} )
        ? qw| partial |
        : qw| missing |;
}

## Update statistics
$data{'debian'}{'stats'}{debian_available} = $checked_pkgs;
$data{'debian'}{'stats'}{debian_installed} = $installed_count;
$data{'debian'}{'stats'}{cpan_only}        = $via_cpan;
$data{'debian'}{'stats'}{missing_deps} = $missing_count + $missing_modules;

<[base.log]>->( 2, "debian.check: complete" );
<[base.log]>->(
    2, "  Debian packages: $installed_count/$checked_pkgs installed"
);
<[base.log]>->(
    2, "  CPAN modules: $via_debian via debian, $via_cpan via cpan"
);
<[base.log]>->(
    2, "  Missing: " . ( $missing_count + $missing_modules ) . " total"
);

return {
    success         => 1,
    checked_pkgs    => $checked_pkgs,
    installed_pkgs  => $installed_count,
    missing_pkgs    => $missing_count,
    checked_modules => $checked_modules,
    missing_modules => $missing_modules
};

0;

