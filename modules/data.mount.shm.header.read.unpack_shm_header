# name = data.mount.shm.header.read.unpack_shm_header
# descr = Unpack binary SHM header into hash structure

my $raw = shift;

<[base.log]>->( 2, "unpack: raw length=" . length($raw) );
<[base.log]>->( 2, "unpack: first 80 chars=" . substr( $raw, 0, 80 ) );

# Check magic
my $magic = substr( $raw, 0, 4 );
if ( $magic ne 'P7SH' ) {
    <[base.log]>->( 2, "unpack: bad magic='$magic'" );
    return undef;
}

# Try regex match
if ( $raw =~ m{^P7SH:(\d+):([A-Z0-9]+):([\d.]+):(\d+):(\d+):([^:]+):} ) {
    my ( $version, $pubkey, $created, $data_size, $hdr_size, $flags_str )
        = ( $1, $2, $3, $4, $5, $6 );

    <[base.log]>->( 2, "unpack: matched! version=$version, pubkey=$pubkey" );

    my %flags;
    for my $flag_pair ( split( /,/, $flags_str ) ) {
        my ( $key, $val ) = split( /=/, $flag_pair );
        $flags{$key} = $val if defined $key;
    }

    return {
        'magic'        => 'P7SH',
        'version'      => $version,
        'owner_pubkey' => $pubkey,
        'created'      => $created,
        'data_size'    => $data_size,
        'header_size'  => $hdr_size,
        'flags'        => \%flags,
        'permissions'  => [],
    };
}

<[base.log]>->( 2, "unpack: regex did not match" );
return undef;

