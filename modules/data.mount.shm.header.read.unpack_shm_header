# name = data.mount.shm.header.read.unpack_shm_header
# desc = Unpack binary SHM header into hash structure

my $raw = shift;

if ( $raw =~ m{^P7SH:(\d+):([A-Z0-9]+):(\d+):(\d+):(\d+):([^:]+):} ) {
    my ( $version, $pubkey, $created, $data_size, $hdr_size, $flags_str )
        = ( $1, $2, $3, $4, $5, $6 );

    my %flags;
    for my $flag_pair ( split( /,/, $flags_str ) ) {
        my ( $key, $val ) = split( /=/, $flag_pair );
        $flags{$key} = $val if defined $key;
    }

    return {
        'magic'        => 'P7SH',
        'version'      => $version,
        'owner_pubkey' => $pubkey,
        'created'      => $created,
        'data_size'    => $data_size,
        'header_size'  => $hdr_size,
        'flags'        => \%flags,
        'permissions'  => [],
    };
}

return undef;

