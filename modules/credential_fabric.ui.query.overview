## [:< ##

# name  = credential_fabric.ui.query.overview
# descr = return summary counts and holder state for the overview frame

my $registry = <credential_fabric.registry> // {};
my @slots    = keys %$registry;

my $slot_count = scalar @slots;

## unique owners ##
my %owners;
for my $slot (@slots) {
    my $owner = $registry->{$slot}{'owner'} // qw| credential_fabric |;
    $owners{$owner} = 1;
}
my $owner_count = scalar keys %owners;

## pending relay count ##
my $relay_count
    = scalar keys %{ <credential_fabric.auth_relay_pending> // {} };

## holder state ##
my $holder_state = 'not started';
my $pid          = <credential_fabric.key_holder.pid>;
if ( defined $pid and $pid > 0 ) {
    $holder_state = kill( 0, $pid ) ? 'running' : 'dead';
}

## last rotation across all slots ##
my $last_rotation_b32 = qw| never |;
my $last_rotated      = 0;
for my $slot (@slots) {
    my $rotated = $registry->{$slot}{'rotated'} // '';
    next if not length $rotated;
    if ( $rotated > $last_rotated ) {
        $last_rotated      = $rotated;
        $last_rotation_b32 = $rotated;
    }
}

return {
    'slot_count'        => $slot_count,
    'owner_count'       => $owner_count,
    'relay_count'       => $relay_count,
    'holder_state'      => $holder_state,
    'last_rotation_b32' => $last_rotation_b32,
};

