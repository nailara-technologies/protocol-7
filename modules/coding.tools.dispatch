## [:< ##

# name  = coding.tools.dispatch
# descr = execute tool call and return result string

my $tool_call = shift // {};

my $name = $tool_call->{'function'}->{'name'} // $tool_call->{'name'} // '';
my $args = $tool_call->{'function'}->{'arguments'}
    // $tool_call->{'arguments'} // {};
my $call_id = $tool_call->{'id'} // '';

## parse arguments if still JSON string ##
if ( not ref $args and length $args ) {
    my $parsed = eval { JSON::PP::decode_json($args) };
    ## fallback: try from_json for character strings ##
    $parsed = eval { JSON::from_json($args) }
        if not defined $parsed
        or ref $parsed ne qw| HASH |;
    if ( defined $parsed and ref $parsed eq qw| HASH | ) {
        $args = $parsed;
    } else {
        <[base.logs]>->(
            0,     ':. tools.dispatch: JSON parse error for %s: %s',
            $name, <[base.str.eval_error]> // 'unknown'
        );
        <[base.logs]>->(
            2,             ':. raw args [ %d chars ]: %.200s',
            length($args), $args
        );
        my $parse_err = <[base.str.eval_error]> // 'unknown parse error';
        $parse_err =~ s|\s+at\s+\S+\s+line\s+\d+.*||s;    ## strip location ##
        my $raw_snip = substr( $args, 0, 300 );
        return {
            'id'      => $call_id,
            'role'    => 'tool',
            'content' => sprintf(
                "error: JSON parse failed for '%s' arguments.\n"
                    . "parse error: %s\n"
                    . "raw input (%d chars): %s\n\n"
                    . "fix: ensure arguments is a single valid JSON object "
                    . "with properly escaped strings. "
                    . "common mistakes: unescaped quotes inside strings, "
                    . "trailing commas, unquoted keys, "
                    . "single quotes instead of double quotes.",
                $name, $parse_err, length($args), $raw_snip
            ),
        };
    }
}

## ensure args is a hashref after parsing ##
$args = {} unless ref $args eq qw| HASH |;

<[base.logs]>->(
    2,     ':. tools.dispatch: %s [ %d args ]',
    $name, scalar keys $args->%*
);

## dispatch table: tool name => [ module, param builder ] ##
my %dispatch = (

    ## read_file, read_module, list_modules, module_deps,         ##
    ## recent_changes, recent_errors, extract_file, ptd_check,    ##
    ## ptd_format, write_new_file → coding.tools.handler.* modules ##

    'list_files' => sub {
        return unless exists $code{'pager.source.file-list'};
        my $source = $code{'pager.source.file-list'}->(
            {   'root'      => $args->{'root'}      // <system.root_path>,
                'pattern'   => $args->{'pattern'}   // '',
                'recursive' => $args->{'recursive'} // 1,
            }
        );
        return unless ref $source eq qw| HASH |;

        ## consume first batch and format as text listing ##
        my $batch = $source->{'next_batch'}->();
        return '<!-- no files found -->' unless $batch and $batch->@*;

        my $output = "## files in ${\( $source->{'root'} )} ##\n";
        for my $item ( $batch->@* ) {
            $output .= sprintf "%-5s %8d  %s\n",
                $item->{'type'} // '?',
                $item->{'size'} // 0,
                $item->{'path'} // $item->{'name'};
        }

        my $count = scalar $batch->@*;
        if ( $count >= 100 ) {
            $output .= "... [ showing first $count entries ]\n";
        }

        return $output;
    },

    'search_code' => sub {
        my $pattern     = $args->{'pattern'}     // return 'pattern required';
        my $scope       = $args->{'scope'}       // qw| modules |;
        my $max_results = $args->{'max_results'} // 30;

        my $root = <system.root_path>;
        my @dirs;
        if ( $scope eq qw| config | ) {
            @dirs = ("$root/configuration");
        } elsif ( $scope eq qw| all | ) {
            @dirs = ( "$root/modules", "$root/configuration" );
        } else {
            @dirs = ("$root/modules");
        }

        my $output  = '';
        my $count   = 0;
        my $dir_str = join ' ', @dirs;

        ## safe pattern — escape shell, run grep ##
        my @cmd
            = ( 'grep', '-rn', '--include=*', '-m', '200', $pattern, @dirs );

        ## capture stderr to tmpfile to avoid pipe deadlock ##
        my $err_file = "/var/protocol-7/coding/state/.search_err.$$";
        if (open my $fh, '-|', "@{[ join ' ',
            map { quotemeta $ARG } @cmd ]} 2>$err_file"
        ) {
            while ( my $line = <$fh> ) {
                last if $count >= $max_results;
                ## strip root prefix for readability ##
                $line =~ s|^\Q$root/\E||;
                $output .= $line;
                $count++;
            }
            close $fh;
        }
        ## collect stderr warnings [ permission errors etc ] ##
        my $warnings = '';
        if ( -s $err_file ) {
            if ( open my $efh, '<', $err_file ) {
                local $/;
                $warnings = <$efh>;
                close $efh;
                $warnings =~ s|\Q$root/\E||g;
            }
            <[base.logs]>->(
                2,
                ':. search_code: stderr [ %d bytes ]',
                length $warnings
            );
            $output .= sprintf "\n## warnings ##\n%s", $warnings;
        }
        unlink $err_file;

        return $count
            ? sprintf( "## %d matches for /%s/ ##\n%s",
            $count, $pattern, $output )
            : "no matches for /$pattern/";
    },

    'dep_graph' => sub {
        return unless exists $code{'context.module.dep_graph'};
        my $namespace = $args->{'namespace'} // '';
        my $module    = $args->{'module'}    // '';

        my %params;
        if ( length $module ) {
            my $root = <system.root_path>;
            $params{'files'} = ["$root/modules/$module"];
        } elsif ( length $namespace ) {
            my $root = <system.root_path>;
            $params{'pattern'}   = "$root/modules/$namespace.*";
            $params{'namespace'} = $namespace;
        } else {
            return 'error: namespace or module required';
        }

        my $result = $code{'context.module.dep_graph'}->( \%params );
        return 'no graph data'
            unless ref $result eq qw| HASH |
            and $result->{'mode'} eq qw| true |;

        my $d = $result->{'data'};

        ## format as readable text ##
        my $out = sprintf "## dep graph: %d files, %d edges ##\n",
            $d->{'file_count'}, $d->{'edge_count'};

        ## clusters ##
        if ( $d->{'clusters'} and $d->{'clusters'}->@* ) {
            $out .= "\n## clusters [ strongly connected ] ##\n";
            for my $c ( $d->{'clusters'}->@* ) {
                $out .= sprintf "  [ %s ]\n", join ', ', $c->@*;
            }
        }

        ## internal edges ##
        if ( $d->{'internal_edges'} and $d->{'internal_edges'}->@* ) {
            $out .= "\n## internal calls ##\n";
            for my $e ( $d->{'internal_edges'}->@* ) {
                $out .= sprintf "  %s -> %s [ %s ]\n",
                    $e->{'from'}, $e->{'to'}, $e->{'type'};
            }
        }

        ## external deps [ capped ] ##
        if ( $d->{'external_edges'} and $d->{'external_edges'}->@* ) {
            $out .= "\n## external dependencies ##\n";
            my $ext_count = 0;
            for my $e ( $d->{'external_edges'}->@* ) {
                last if $ext_count++ >= 30;
                $out .= sprintf "  %s -> %s [ %s ]\n",
                    $e->{'from'}, $e->{'to'}, $e->{'type'};
            }
            my $total = scalar $d->{'external_edges'}->@*;
            $out .= "  ... [ $total total ]\n" if $total > 30;
        }

        return $out;
    },

    'ncode_search' => sub {
        my $query       = $args->{'query'}       // return 'query required';
        my $max_results = $args->{'max_results'} // 50;

        ## validate query — alphanumeric, dots, underscores, hyphens ##
        ## reject shell metacharacters ##
        if ( $query =~ m{[;&|`\$\\"'\n\r]} ) {
            return 'error: query contains invalid characters';
        }
        return 'error: query too short' if length($query) < 2;
        return 'error: query too long'  if length($query) > 200;

        my $root = <system.root_path>;
        my @cmd = ( "$root/bin/ncode", '-no-color', 'search', 'all', $query );

        my $output = '';
        my $count  = 0;

        ## capture stderr to tmpfile to avoid pipe deadlock ##
        my $err_file = "/var/protocol-7/coding/state/.ncode_err.$$";
        if (open my $fh, '-|', "@{[ join ' ',
            map { quotemeta $ARG } @cmd ]} 2>$err_file"
        ) {
            while ( my $line = <$fh> ) {
                last if $count >= $max_results;
                $output .= $line;
                $count++;
            }
            close $fh;
        }
        ## collect stderr warnings [ permission errors etc ] ##
        my $warnings = '';
        if ( -s $err_file ) {
            if ( open my $efh, '<', $err_file ) {
                local $/;
                $warnings = <$efh>;
                close $efh;
            }
            <[base.logs]>->(
                2,
                ':. ncode_search: stderr [ %d bytes ]',
                length $warnings
            );
            $output .= sprintf "\n## warnings ##\n%s", $warnings;
        }
        unlink $err_file;

        return $count
            ? sprintf( "## ncode search: %d lines for '%s' ##\n%s",
            $count, $query, $output )
            : "no matches for '$query'";
    },

    'edit_file' => sub {
        my $path  = $args->{'path'}  // return 'path required';
        my $edits = $args->{'edits'} // return 'edits required';
        my $apply = $args->{'apply'} // 0;

        my $root     = <system.root_path>;
        my $abs_path = "$root/$path";

        ## validate path stays within project ##
        return 'error: path escapes project root'
            if $abs_path =~ m|\.\./| or $path =~ m|^/|;
        return 'error: file not found' unless -f $abs_path;

        ## parse edits JSON ##
        my $edit_list;
        if ( not ref $edits ) {
            $edit_list = eval { JSON::PP::decode_json($edits) };
            return "error: invalid edits JSON: $@" if $@;
        } else {
            $edit_list = $edits;
        }
        return 'error: edits must be an array'
            unless ref $edit_list eq qw| ARRAY |;

        ## read current file [ prefer staged version for accumulation ] ##
        my $stage_name = $path;
        $stage_name =~ s|/|__|g;
        my $stage_rel   = "staged/$stage_name";
        my $content_ref = <[file.zenka_dir.load]>->($stage_rel);
        $content_ref = <[file.slurp]>->($abs_path)
            unless defined $content_ref;
        return 'error: cannot read file' unless defined $content_ref;
        my @lines = split /\n/, $content_ref->$*, -1;

        ## validate and apply edits ##
        my @preview;
        my $errors = 0;
        for my $edit ( sort { $b->{'line'} <=> $a->{'line'} } @$edit_list ) {
            my $ln  = $edit->{'line'} // next;
            my $old = $edit->{'old'}  // '';
            my $new = $edit->{'new'}  // '';

            if ( $ln < 1 or $ln > scalar @lines ) {
                push @preview,
                    sprintf "line %d: OUT OF RANGE [ 1..%d ]",
                    $ln, scalar @lines;
                $errors++;
                next;
            }

            my $actual = $lines[ $ln - 1 ];
            ## trim for comparison ##
            my $actual_trim = $actual;
            my $old_trim    = $old;
            $actual_trim =~ s|^\s+||;
            $actual_trim =~ s|\s+$||;
            $old_trim    =~ s|^\s+||;
            $old_trim    =~ s|\s+$||;

            if ( length $old_trim and $actual_trim ne $old_trim ) {
                push @preview,
                    sprintf
                    "line %d: MISMATCH\n  expected: %s\n  actual:   %s",
                    $ln, $old, $actual;
                $errors++;
                next;
            }

            push @preview, sprintf "line %d: %s\n     --> %s", $ln, $actual,
                $new;
            $lines[ $ln - 1 ] = $new if $apply;
        }

        ## write back if applying and no errors ##
        if ( $apply and not $errors ) {
            my $new_content = join "\n", @lines;
            if ( -w $abs_path ) {
                <[file.put]>->( $abs_path, \$new_content );
                return sprintf "applied %d edits to %s\n%s",
                    scalar @$edit_list, $path, join "\n", @preview;
            }
            ## stage to zenka dir when no write access ##
            <[file.zenka_dir.write]>->(
                $stage_rel, \$new_content, '>', 0664, ':encoding(UTF-8)'
            );
            <[base.logs]>->(
                1, ':. edit_file: staged %s [ no write access ]', $path
            );
            return
                sprintf "staged %d edits for %s [ no write access ]\n"
                . "staged at: %s\n%s",
                scalar @$edit_list, $path, $stage_rel,
                join "\n", @preview;
        }

        my $mode = $apply ? 'BLOCKED' : 'PREVIEW';
        return sprintf "## %s [ %d edits, %d errors ] ##\n%s",
            $mode, scalar @$edit_list, $errors, join "\n", @preview;
    },

);

## look up and execute — dispatch table first, then handler modules ##
my $handler_mod = "coding.tools.handler.$name";
if ( not exists $dispatch{$name} and not exists $code{$handler_mod} ) {
    <[base.logs]>->( 0, ':. tools.dispatch: unknown tool [ %s ]', $name );
    return {
        'id'      => $call_id,
        'role'    => 'tool',
        'content' => "error: unknown tool '$name'",
    };
}

my $raw_result
    = exists $dispatch{$name}
    ? $dispatch{$name}->()
    : $code{$handler_mod}->($args);

## normalize result to string ##
my $content;
if ( not defined $raw_result ) {
    $content = 'error: tool handler returned undef';
} elsif ( ref $raw_result eq qw| HASH | ) {
    if ( exists $raw_result->{'data'} ) {
        $content
            = ref $raw_result->{'data'}
            ? JSON::PP->new->utf8->pretty->canonical->encode(
            $raw_result->{'data'} )
            : $raw_result->{'data'};
    } else {
        $content
            = JSON::PP->new->utf8->pretty->canonical->encode($raw_result);
    }
} elsif ( ref $raw_result ) {
    $content = JSON::PP->new->utf8->pretty->canonical->encode($raw_result);
} else {
    $content = $raw_result;
}

<[base.logs]>->(
    2,     ':. tools.dispatch: %s → %d chars',
    $name, length($content)
);

return {
    'id'      => $call_id,
    'role'    => 'tool',
    'content' => $content,
};

