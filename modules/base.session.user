## [:< ##

# name  = base.session.user
# descr = resolve user name from a session id
# param = [sid] [ returns $data{'session'}{$sid}{'user'} or '' ]

my $sid = shift // '';

return ''
    if not length $sid
    or not exists $data{'session'}{$sid}
    or not exists $data{'session'}{$sid}{'user'};

return $data{'session'}{$sid}{'user'};

