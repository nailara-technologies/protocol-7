# name  = workflow.extract_workspace_todos
# descr = extract todos from workspace-transfer TODO.md files

my @todos;
my $repos = <[workflow.scan_workspace_repos]>;

foreach my $repo (@$repos) {
    my $absolute_todo_file = "$repo->{path}/TODO.md";
    next unless -f $absolute_todo_file;

    my $keyword_todo_file = <[base.path.to_keywords]>->($absolute_todo_file);

    open my $fh, '<', $absolute_todo_file or next;
    while (<$fh>) {
        if (/^- \[ \](.*)/) {
            my $desc = $1;
            $desc =~ s|^\s+||;

            push @todos,
                {
                title    => $desc,
                priority => 'medium',
                category => 'workspace-todo',
                status   => 'pending',
                repo     => $repo->{name},
                path     => $keyword_todo_file,
                source   => 'workspace-transfer-todo'
                };
        }
    }
    close $fh;
}

return \@todos;

