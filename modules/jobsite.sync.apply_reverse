## [:< ##

# name  = jobsite.sync.apply_reverse
# descr = apply reverse changes from httpd to local records

my $entries = shift;
return if ref $entries ne 'ARRAY';

my $jobs_dir = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite jobs |;

for my $entry ( @{$entries} ) {
    next if ref $entry ne 'HASH';

    my $id = $entry->{'id'} // '';
    next if not length $id;

    my $action = $entry->{'action'} // '';

    if ( $action eq 'delete' ) {
        my $idx_status = <jobsite.job.index>->{$id} // '';
        my $path       = '';
        if ( $idx_status =~ m{^(blocked|deleted):(.+)$} ) {
            $path = "$jobs_dir/$1/$2/$id.yaml";
        } elsif ( length $idx_status ) {
            $path = "$jobs_dir/$idx_status/$id.yaml";
        }
        if ( length $path and -f $path and unlink($path) ) {
            <[base.logs]>->( 1, 'jss.sync.apply: deleted %s', $id );
        } else {
            <[base.logs]>->( 0, 'jss.sync.apply: delete %s failed', $id );
        }
        next;
    }

    if ( $action eq 'blacklist' ) {
        my $job = <[jobsite.job.read]>->($id);
        my $company
            = ( ref $job eq 'HASH' ) ? ( $job->{'company'} // '' ) : '';
        if ( length $company ) {
            <[jobsite.cmd.blacklist-add]>->( { 'args' => $company } );
            <[base.logs]>->(
                1,   'jss.sync.apply: blacklisted %s (%s)',
                $id, $company
            );
        } else {
            <[base.logs]>->(
                0, 'jss.sync.apply: blacklist %s failed, no company', $id
            );
        }
        next;
    }

    if ( $action eq 'reassess' ) {
        my $job = <[jobsite.job.read]>->($id);
        if ( ref $job ne 'HASH' ) {
            <[base.logs]>->(
                0, 'jss.sync.apply: reassess %s — not found', $id
            );
            next;
        }

        ## clear assessment fields, reset to new ##
        for my $f (
            qw| score score_reason score_summary assertions stage
            repair_attempted repair_failed repair_applied |
        ) {
            delete $job->{$f};
        }
        $job->{'status'} = 'new';
        <[jobsite.job.write]>->( $id, $job );

        ## update in-memory task record ##
        my $rec = ( <jobsite.tasks> // {} )->{$id} // {};
        delete $rec->{$ARG}
            for qw| score score_reason score_summary assertions
            stage repair_attempted repair_failed |;
        $rec->{'status'} = 'new';
        <jobsite.tasks>->{$id} = $rec;

        ## inject at front of assess queue (prioritized) ##
        my $profile_file = <jobsite.cfg.profile_file>
            // '/etc/protocol-7/jobsite/profile.txt';
        my $profile_text = <[file.read]>->($profile_file)
            // 'no profile configured';
        <[base.perlmod.autoload]>->('Encode');
        $profile_text = Encode::decode( 'UTF-8', $profile_text )
            unless utf8::is_utf8($profile_text);

        my $prompt = <[jobsite.util.build_prompt]>->($job);
        my $entry  = { 'job_id' => $id, 'desc' => $prompt };

        <jobsite.assess_queue> //= [];
        unshift @{<jobsite.assess_queue>}, $entry;    ## front of queue ##

        ## if idle: start the cycle ##
        if ( ( <jobsite.cycle> // 'idle' ) eq 'idle' ) {
            <jobsite.cycle>         = 'assessing';
            <jobsite.pending_count> = 1 + scalar @{<jobsite.assess_queue>};
            <[jobsite.dispatch.next]>;
        }

        <[base.logs]>->(
            1, 'jss.sync.apply: reassess %s queued (front)', $id
        );
        next;
    }

    ## update browser-owned fields
    my $job = <[jobsite.job.read]>->($id);
    if ( ref $job ne 'HASH' ) {
        <[base.logs]>->( 0, 'jss.sync.apply: cannot read %s', $id );
        next;
    }

    my $updated = 0;
    for my $field (qw| stage notes date_applied |) {
        if ( exists $entry->{$field} ) {
            $job->{$field} = $entry->{$field};
            $updated = 1;
        }
    }

    if ($updated) {
        <[jobsite.job.write]>->( $id, $job );
        <[base.logs]>->( 1, 'jss.sync.apply: updated %s', $id );
    }
}

