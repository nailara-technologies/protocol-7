## [:< ##

# name  = jobsite.sync.apply_reverse
# descr = apply reverse changes from httpd to local records

my $entries = shift;
return if ref $entries ne 'ARRAY';

my $jobs_dir = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite jobs |;

for my $entry ( @{$entries} ) {
    next if ref $entry ne 'HASH';

    my $id = <[base.vax-int.decode]>->( $entry->{'id'} // '' );
    next if not length $id;

    my $action = $entry->{'action'} // '';
    my $enc_id = <[base.vax-int.encode]>->($id);

    if ( $action eq 'delete' ) {
        my $job = <[jobsite.job.read]>->($id);
        if ( ref $job ne 'HASH' ) {
            <[base.logs]>
                ->( 0, 'jss.sync.apply: delete %s — not found', $id );
            next;
        }
        ## archive to deleted/ instead of unlinking, so checksum/index keeps
        ## them out ##
        $job->{'status'} = 'deleted';
        $job->{'stage'}  = 'deleted' if length( $job->{'stage'} // '' );
        $job->{'deleted_epoch'} //= <[base.ntime.epoch_timestamp]>;
        <[jobsite.job.write]>->( $id, $job );
        delete <jobsite.tasks>->{$id}
            if ref <jobsite.tasks> eq qw| HASH |;
        <[base.logs]>->( 1, 'jss.sync.apply: deleted %s', $id );
        next;
    }

    if ( $action eq 'blacklist' ) {
        my $job = <[jobsite.job.read]>->($id);
        my $company
            = ( ref $job eq 'HASH' ) ? ( $job->{'company'} // '' ) : '';
        if ( length $company ) {
            <[jobsite.cmd.blacklist-add]>->( { 'args' => $company } );
            <[base.logs]>->(
                1,   'jss.sync.apply: blacklisted %s (%s)',
                $id, $company
            );
        } else {
            <[base.logs]>->(
                0, 'jss.sync.apply: blacklist %s failed, no company', $id
            );
        }
        next;
    }

    if ( $action eq 'reassess' ) {
        my $job = <[jobsite.job.read]>->($id);
        if ( ref $job ne 'HASH' ) {
            <[base.logs]>->(
                0, 'jss.sync.apply: reassess %s — not found', $id
            );
            next;
        }

        ## clear assessment fields only : keep user stage/status ##
        for my $f (
            qw| score score_reason score_summary assertions
            repair_attempted repair_failed repair_applied |
        ) {
            delete $job->{$f};
        }
        <[jobsite.job.write]>->( $id, $job );

        ## update in-memory task record ##
        my $rec = ( <jobsite.tasks> // {} )->{$id} // {};
        delete $rec->{$ARG}
            for qw| score score_reason score_summary assertions
            repair_attempted repair_failed |;
        ## keep user-selected stage/status so assess-done treats it as
        ## protected ##
        $rec->{'stage'}  = $job->{'stage'}  if defined $job->{'stage'};
        $rec->{'status'} = $job->{'status'} if defined $job->{'status'};
        <jobsite.tasks>->{$id} = $rec;

        ## inject at front of assess queue (prioritized) ##
        my $profile_file = <jobsite.cfg.profile_file>
            // '/etc/protocol-7/jobsite/profile.txt';
        my $profile_text = <[file.read]>->($profile_file)
            // 'no profile configured';
        <[base.perlmod.autoload]>->('Encode');
        $profile_text = Encode::decode( 'UTF-8', $profile_text )
            unless utf8::is_utf8($profile_text);

        my $prompt = <[jobsite.util.build_prompt]>->($job);
        my $entry  = { 'job_id' => $id, 'desc' => $prompt };

        <jobsite.assess_queue> //= [];
        unshift @{<jobsite.assess_queue>}, $entry;    ## front of queue ##

        ## if idle: start the cycle ##
        if ( ( <jobsite.cycle> // 'idle' ) eq 'idle' ) {
            <jobsite.cycle>         = 'assessing';
            <jobsite.pending_count> = scalar @{<jobsite.assess_queue>};
            <[jobsite.dispatch.next]>;
        }

        <[base.logs]>->(
            1, 'jss.sync.apply: reassess %s queued (front)', $id
        );
        next;
    }

    ## update browser-owned fields
    my $job = <[jobsite.job.read]>->($id);
    if ( ref $job ne 'HASH' ) {
        <[base.logs]>->( 0, 'jss.sync.apply: cannot read %s', $id );
        next;
    }

    my %stage_to_status = (
        'review'      => 'review',
        'to_apply'    => 'apply',
        'applied'     => 'applied',
        'interviewed' => 'interviewed',
        'responded'   => 'applied',
        'rejected'    => 'rejected',
        'skipped'     => 'skipped',
        'archived'    => 'rejected',
    );

    my $updated = 0;
    for my $field (qw| stage notes date_applied |) {
        if ( exists $entry->{$field} ) {
            $job->{$field} = $entry->{$field};
            $updated = 1;
        }
    }

    ## stage change also drives backend status so jobs don't stay in review
    ## forever ##
    if (    exists $entry->{'stage'}
        and exists $stage_to_status{ $entry->{'stage'} } ) {
        my $new_status = $stage_to_status{ $entry->{'stage'} };
        if ( ( $job->{'status'} // '' ) ne $new_status ) {
            $job->{'status'} = $new_status;
            $updated = 1;
        }
    }

    if ($updated) {
        ## keep in-memory task record in sync so assess-done protect check
        ## sees current stage ##
        if ( exists $entry->{'stage'} ) {
            my $tasks = <jobsite.tasks>;
            if ( ref $tasks eq 'HASH' and defined $tasks->{$id} ) {
                $tasks->{$id}{'stage'}  = $entry->{'stage'};
                $tasks->{$id}{'status'} = $job->{'status'}
                    if defined $job->{'status'};
            }
        }
        <[jobsite.job.write]>->( $id, $job );
        <[base.logs]>->( 1, 'jss.sync.apply: updated %s', $id );
    }
}

