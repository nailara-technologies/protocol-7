## [:< ##

# name = v7.verify_and_install_zenka_dependencies
# descr = High-level orchestrator for dependency verification and on-demand installation

my %verification_state = (
    timestamp      => time(),
    zenka_checked  => [],
    missing_deps   => [],
    installed_deps => [],
    failed_repairs => [],
    alerts         => []
);

## Initialize tracking registries if not already done
$data{'v7'}{'dependency_state'}        //= {};
$data{'v7'}{'dependency_anomalies'}    //= [];
$data{'v7'}{'dependency_last_checked'} //= {};

## Get list of all zenka dependencies from debian registries
my $zenka_deps_registry = $data{'debian'}{'zenki_deps'}{'registry'} // {};

unless (%$zenka_deps_registry) {
    return {
        success => 0,
        error   => 'No dependency registry found. Run debian.parent.scan_zenki_dependencies first.'
    };
}

<[base.log]>->( 2, "v7.verify_and_install: Starting dependency verification" );

## Verify each registered zenka's dependencies
foreach my $zenka_id ( keys %$zenka_deps_registry ) {
    my $zenka_entry = $zenka_deps_registry->{$zenka_id};
    my $zenka_name  = $zenka_entry->{zenka};

    push @{ $verification_state{zenka_checked} }, $zenka_name;

    <[base.log]>->( 3, "  Verifying dependencies for zenka: $zenka_name" );

    ## Verify PM dependencies
    if ( $zenka_entry->{pm_deps} && @{ $zenka_entry->{pm_deps} } ) {
        foreach my $pm_module ( @{ $zenka_entry->{pm_deps} } ) {
            my $verify_result
                = <[debian.parent.verify_dependency_state]>->( 'pm_module',
                $pm_module );

            if ( !$verify_result->{available} ) {
                push @{ $verification_state{missing_deps} },
                    {
                    type   => 'pm_module',
                    name   => $pm_module,
                    zenka  => $zenka_name,
                    error  => $verify_result->{error}
                    };

                <[base.log]>->( 3, "    Missing PM module: $pm_module" );

                ## Attempt installation via CPAN (uses Level 2 installer)
                my $install_result
                    = <[base.perlmod.install]>->( $pm_module );

                if ( $install_result && $install_result->{success} ) {
                    push @{ $verification_state{installed_deps} },
                        {
                        type  => 'pm_module',
                        name  => $pm_module,
                        zenka => $zenka_name
                        };
                    <[base.log]>
                        ->( 3, "    Auto-installed PM module: $pm_module" );
                } else {
                    push @{ $verification_state{failed_repairs} },
                        {
                        type   => 'pm_module',
                        name   => $pm_module,
                        zenka  => $zenka_name,
                        reason => 'CPAN installation failed'
                        };
                    <[base.log]>
                        ->( 2,
                        "    Failed to install PM module: $pm_module" );
                }
            }
        }
    }

    ## Verify OS dependencies
    if ( $zenka_entry->{os_deps} && @{ $zenka_entry->{os_deps} } ) {
        foreach my $os_package ( @{ $zenka_entry->{os_deps} } ) {
            my $verify_result
                = <[debian.parent.verify_dependency_state]>->( 'os_package',
                $os_package );

            if ( !$verify_result->{available} ) {
                push @{ $verification_state{missing_deps} },
                    {
                    type   => 'os_package',
                    name   => $os_package,
                    zenka  => $zenka_name,
                    error  => $verify_result->{error}
                    };

                <[base.log]>->( 3, "    Missing OS package: $os_package" );

                ## Attempt installation via apt-get (requires privileges)
                if ( $UID == 0 ) {
                    my $install_result
                        = system( "apt-get install -y $os_package 2>/dev/null" );

                    if ( $install_result == 0 ) {
                        push @{ $verification_state{installed_deps} },
                            {
                            type  => 'os_package',
                            name  => $os_package,
                            zenka => $zenka_name
                            };
                        <[base.log]>->( 3,
                            "    Auto-installed OS package: $os_package" );
                    } else {
                        push @{ $verification_state{failed_repairs} },
                            {
                            type   => 'os_package',
                            name   => $os_package,
                            zenka  => $zenka_name,
                            reason => 'apt-get installation failed'
                            };
                        <[base.log]>->( 2,
                            "    Failed to install OS package: $os_package" );
                    }
                } else {
                    ## Unprivileged: can't install, alert only
                    push @{ $verification_state{alerts} },
                        {
                        type     => 'permission',
                        severity => 'warning',
                        message  => "Cannot install OS package '$os_package' for zenka '$zenka_name' - unprivileged user",
                        };
                    <[base.log]>->( 2,
                        "    Cannot install (unprivileged): $os_package" );
                }
            }
        }
    }

    ## Verify Binary dependencies
    if ( $zenka_entry->{bin_deps} && @{ $zenka_entry->{bin_deps} } ) {
        foreach my $binary ( @{ $zenka_entry->{bin_deps} } ) {
            my $verify_result
                = <[debian.parent.verify_dependency_state]>->( 'binary',
                $binary );

            if ( !$verify_result->{available} ) {
                push @{ $verification_state{missing_deps} },
                    {
                    type   => 'binary',
                    name   => $binary,
                    zenka  => $zenka_name,
                    error  => $verify_result->{error}
                    };

                push @{ $verification_state{alerts} },
                    {
                    type     => 'binary_missing',
                    severity => 'error',
                    message  => "Required binary '$binary' for zenka '$zenka_name' not found in \$PATH",
                    };

                <[base.log]>->( 2,
                    "    Missing binary dependency: $binary (requires admin action)" );
            } else {
                <[base.log]>
                    ->( 3,
                    "    Binary OK: $binary at $verify_result->{path}" );
            }
        }
    }
}

## Store state for later retrieval and monitoring
$data{'v7'}{'dependency_state'} = \%verification_state;
$data{'v7'}{'dependency_last_checked'}{timestamp} = time();

## Log summary
<[base.log]>->( 2, "v7.verify_and_install: Complete" );
<[base.log]>->( 2, "  Zenka checked: " . scalar( @{ $verification_state{zenka_checked} } ) );
<[base.log]>->( 2, "  Missing: " . scalar( @{ $verification_state{missing_deps} } ) );
<[base.log]>->( 2, "  Auto-installed: " . scalar( @{ $verification_state{installed_deps} } ) );
<[base.log]>->( 2, "  Failed repairs: " . scalar( @{ $verification_state{failed_repairs} } ) );
<[base.log]>->( 2, "  Alerts: " . scalar( @{ $verification_state{alerts} } ) );

return {
    success           => 1,
    zenka_checked     => scalar( @{ $verification_state{zenka_checked} } ),
    missing_count     => scalar( @{ $verification_state{missing_deps} } ),
    installed_count   => scalar( @{ $verification_state{installed_deps} } ),
    failed_count      => scalar( @{ $verification_state{failed_repairs} } ),
    alerts_count      => scalar( @{ $verification_state{alerts} } ),
    state             => \%verification_state
};

