## [:< ##

# name  = cube.cmd.declare-strm-size-timeout
# descr = update strm-size timeout for session [runtime]
# param = <timeout_seconds>

my $param   = shift;
my $sid     = $param->{'session_id'};
my $timeout = ( split /\s+/, $param->{'args'} // '' )[0];

return { mode => 'false', data => 'timeout required' }
    unless defined $timeout and $timeout =~ m/^\d+$/;

my $session = $data{'session'}{$sid};

## update timeout for strm-size idle detection ##
$session->{'strm_size_timeout'} = 0 + $timeout;

<[base.logs]>->( 2, '[%d] STRM-SIZE timeout updated: %ds', $sid, $timeout );

return {
    mode => 'true',
    data => sprintf( 'timeout set to %ds', $timeout )
};

