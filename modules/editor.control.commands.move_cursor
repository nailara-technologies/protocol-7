## [:< ##

# name  = editor.control.commands.move_cursor
# descr = move a field's cursor by a CHARACTER delta, clamped to buffer

my ( $editor_state, $field, $delta ) = @ARG;

return undef if ref $editor_state ne qw| HASH |;
my $buffer = $editor_state->{'fields'}{$field} // return undef;
$delta //= 0;

my $new_pos = $buffer->{'cursor'} + $delta;
$new_pos = 0 if $new_pos < 0;
my $buf_len = <[editor.buffer.memory.length]>->($buffer);
$new_pos = $buf_len if $new_pos > $buf_len;

$buffer->{'cursor'} = $new_pos;

return $new_pos;

