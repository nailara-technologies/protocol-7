## [:< ##

# name  = context.string.ellipsize
# descr = truncate long strings for display with ellipsis

my $params = shift // {};

my $str = $params->{'str'} // '';
my $max = $params->{'max'} // 40;

return $str if length $str <= $max;
return substr( $str, 0, $max - 3 ) . '...';

