## [:< ##

# name  = cred-mesh.cmd.rotate
# descr = console credential rotation for a slot.
#         args: <slot> <new_value> [reason]  (positional, whitespace-separated)
#         wraps <[cred-mesh.rotate]>.
#         note: cube strips '.cmd.' segment for console routing.

my $args_str = $call->{'args'} // '';
$args_str =~ s/^\s+|\s+$//g;

my ( $slot, $new_value, $reason ) = split qr|\s+|, $args_str, 3;
$slot      //= '';
$new_value //= '';
$reason    //= qw| manual |;

return { 'mode' => qw| false |, 'data' => 'missing slot name' }
    unless length $slot;
return { 'mode' => qw| false |, 'data' => 'missing new_value' }
    unless length $new_value;

my $result = <[cred-mesh.rotate]>->(
    {   'slot'      => $slot,
        'new_value' => $new_value,
        'reason'    => $reason,
    }
);

return $result
    if defined $result and ref $result eq qw| HASH |;

return { 'mode' => qw| false |, 'data' => 'rotate failed' };

## [ end ] ###################################################################

