## [:< ##

# name  = letsencr.child.cmd.request-certificate
# param = <domain>
# descr = request new certificate from ACME server for domain[s]

## $call is provided by compiled-in code header
my $domain = $call->{'args'};

return {
    'mode' => 'false',
    'data' => 'domain parameter required'
    }
    unless defined $domain && length($domain);

<[base.log]>->( 2, "child: requesting new certificate for domain: $domain" );

## Parse additional domains from parameters (if provided)
my $alt_names = $call->{'param'}{'domains'} // [$domain];
my @domains   = @$alt_names if ref($alt_names) eq 'ARRAY' && @$alt_names;
@domains = ($domain) unless @domains;

## Get admin email from config or parameters
my $email = $call->{'param'}{'email'} || <letsencr.admin.email>;

<[base.log]>->( 2, "  domains: " . join( ', ', @domains ) );
<[base.log]>->( 2, "  email: $email" );

## Call ACME new certificate workflow
my $result = <[letsencr.child.acme_new]>->(
    {   domains => \@domains,
        email   => $email,
    },
    $call->{'reply_id'}    ## pass reply_id for async coordination
);

## handle result from acme_new (internal status format)
unless ($result) {
    <[base.logs]>->( 1, 'acme_new returned undef' );
    return {
        'mode' => qw| false |,
        'data' => 'Internal error: acme_new failed'
    };
}

## check for async deferred status
if ( $result->{status} eq qw| deferred | ) {
    ## async processing - challenge coordination with parent ongoing
    ## reply_id was passed to acme_new and stored in state for later callback
    <[base.logs]>->(
        2, 'certificate request accepted, processing asynchronously'
    );

    ## return deferred mode to signal async reply via reply_id callback
    return { 'mode' => qw| deferred | };
}

## check for error result
if ( $result->{status} eq qw| error | ) {
    my $error = $result->{error}
        // 'Unknown error during certificate enrollment';
    <[base.logs]>->( 1, 'certificate enrollment failed: %s', $error );
    return {
        'mode' => qw| false |,
        'data' => $error
    };
}

## check for completion result (sync path: status='success')
unless ( $result->{status} eq qw| success | ) {
    my $error = $result->{error}
        // 'Unknown error during certificate enrollment';
    <[base.logs]>->( 1, 'certificate enrollment failed: %s', $error );
    return {
        'mode' => qw| false |,
        'data' => $error
    };
}

<[base.log]>->( 2, "certificate obtained successfully for $domain" );

## Create certificate bundle for parent
my $cert_bundle = {
    certificate => $result->{cert},
    key         => $result->{key},
    issued_at   => time(),
    expires_at  => $result->{valid_until},
    domain      => $domain,
    domains     => \@domains,
    cert_url    => $result->{cert_url},
};

## Encode as JSON then base32r for transmission
my $bundle_json = JSON::XS::encode_json($cert_bundle);
my $bundle_b32r = Crypt::Misc::encode_b32r($bundle_json);

<[base.log]>->( 2, "certificate bundle encoded (base32r)" );
<[base.log]>->( 3, "  bundle size: " . length($bundle_b32r) . " bytes" );

## Return certificate bundle to parent (mode='size' for binary/encoded data)
return {
    'mode' => 'size',
    'data' => $bundle_b32r
};

