## [:< ##

# name  = plugin.web.attention.cmd.set-state
# descr = p7c command to switch attention state

my $args = $call->{'args'} // '';
my ( $name, $params_str ) = split( /\s+/, $args, 2 );
my $params
    = length($params_str)
    ? eval { JSON::XS::decode_json($params_str) } // {}
    : {};

return {
    qw| mode | => qw| false |,
    qw| data | => qw| state name required |
    }
    unless length $name;

my $result = <[plugin.web.attention.switch_state]>->( $name, $params );

if ( $result->{'error'} ) {
    return {
        qw| mode | => qw| false |,
        qw| data | => $result->{'error'},
    };
}

return {
    qw| mode | => qw| true |,
    qw| data | => eval { JSON::XS::encode_json($result) }
        // $result->{'name'},
};

