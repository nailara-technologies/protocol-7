## [:< ##

# name = menu-commands.cmd.get-provider-data
# descr = Provide YAML provider data on demand to protocol-7-menu

my $items_href = {};    # building items hash from current mappings #
foreach my $mapping_id ( keys <menu-commands.mappings>->%* ) {
    my $mapping = <menu-commands.mappings>->{$mapping_id};
    $items_href->{$mapping_id} = {
        'label'   => $mapping->{'label'}   // qw| unnamed |,
        'enabled' => $mapping->{'enabled'} // TRUE,
        'action'  => $mapping->{'command'} // '',
    };
}

# preparing provider data structure
my $provider_data = { 'items' => $items_href };

# format it as YAML and strip the document marker
my $yaml_output = YAML::XS::Dump($provider_data);
$yaml_output =~ s|^---\n||;

<[base.logs]>->(
    1,    ## log current activity ##
    "providing %d menu items [bytes:%d]",
    scalar( keys $items_href->%* ),
    length $yaml_output
);

# returning SIZE mode [multiline ]- protocol-7-menu will fetch this when ready
return { 'mode' => qw| size |, 'data' => $yaml_output };

