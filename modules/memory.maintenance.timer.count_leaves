## [:< ##

# name  = memory.maintenance.timer.count_leaves
# descr = count leaf nodes in a memory tree

my $node = shift;
return 1 if $node->{'type'} eq 'leaf';
my $c = 0;
$c += <[memory.maintenance.timer.count_leaves]>->($_)
    for @{ $node->{'children'} // [] };
return $c;

