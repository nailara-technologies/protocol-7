## [:< ##

# name  = editor.buffer.memory.load
# descr = load text into in-memory editor buffer

my ( $buffer, $source ) = @ARG;

return undef if ref $buffer ne qw| HASH |;
return undef if $buffer->{'readonly'};

my $text = $source // '';
$text = $$text if ref $text eq qw| SCALAR |;
utf8::decode($text) if length $text and not utf8::is_utf8($text);

$buffer->{'text'}   = $text;
$buffer->{'cursor'} = 0;

return TRUE;

