# name  = models.decision.cost_base.is_latency_sensitive
# descr = Check if a model is sensitive to latency based on context and type

my ( $model_entry, $context ) = @ARG;

return 0 unless $model_entry && ref($model_entry) eq 'HASH';

# Models used in real-time contexts are latency-sensitive
my $latency_contexts = { real_time => 1, interactive => 1, streaming => 1 };
return 1 if $latency_contexts->{$context};

# Check model metadata for latency-sensitive categories
my $category = $model_entry->{metadata}->{category} // '';
my $latency_categories
    = { vision => 1, multimodal => 1, reasoning => 0, analysis => 0 };
return $latency_categories->{$category} // 0;

