## [:< ##

# name = image-batch.child.analyze_job
# descr = Analyze a single image job (wrapper around Phase 2 vision analysis)

my $job = shift;

# Validate job structure
return { success => FALSE, error => 'Job parameter required' } unless defined $job;
return { success => FALSE, error => 'Job must be a hash' } unless ref $job eq 'HASH';
return { success => FALSE, error => 'Job missing image_path' } unless exists $job->{image_path};
return { success => FALSE, error => 'Job missing job_id' } unless exists $job->{job_id};

my $image_path = $job->{image_path};
my $job_id = $job->{job_id};

# Validate image path
return { success => FALSE, error => "Image file not found: $image_path" } unless -f $image_path;

# Call Phase 2 vision analysis (non-blocking image quality analyzer)
my $analysis_result = <[image-quality.analyze]>->($image_path);

# Construct response for parent process
return {
    cmd => 'result',
    job_id => $job_id,
    success => $analysis_result->{success},
    image_path => $image_path,
    metrics => $analysis_result->{success} ? {
        composition => $analysis_result->{composition},
        lighting => $analysis_result->{lighting},
        technical => $analysis_result->{technical},
        relevance => $analysis_result->{relevance},
        overall_grade => $analysis_result->{overall_grade}
    } : undef,
    error => $analysis_result->{error},
    duration_ms => $analysis_result->{duration_ms},
    model_used => $analysis_result->{model_used},
    method => $analysis_result->{method}
};

