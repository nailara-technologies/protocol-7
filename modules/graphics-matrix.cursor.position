## [:< ##

# name  = graphics-matrix.cursor.position
# descr = return current cursor position and state

my $cursor = $data{'graphics-matrix'}{'cursor'};

## return shallow copy, not reference to live hash ##
return {
    qw| selX   | => $cursor->{'selX'},
    qw| selY   | => $cursor->{'selY'},
    qw| selZ   | => $cursor->{'selZ'},
    qw| zoom   | => $cursor->{'zoom'},
    qw| radius | => $cursor->{'radius'}
};

