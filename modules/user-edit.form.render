## [:< ##

# name  = user-edit.form.render
# descr = render the active user-edit form to the terminal

## doubles as the base.event.add_var watcher handler for
## <user-edit.form.dirty> [ see user-edit.handler.value_get_reply ] : both a
## keystroke edit and an async out-of-band field update just bump that
## counter, and this module is what turns either into an actual redraw.
##
## it must never write <user-edit.form.dirty> itself — base.event.add_var
## registers reentrant watchers by default, so a write from inside the handler
## would re-fire it immediately.

my $editor_state = <user-edit.form.state>;

return FALSE if ref $editor_state ne qw| HASH |;

my $frame_name = <user-edit.form.frame_name> // qw| user-edit-form |;

## the frame is generated in memory, and ascii.frame.init_code wipes that ##
## cache on every source reload — regenerate rather than render nothing   ##
if ( not exists <ascii.frame.cache>->{$frame_name} ) {
    <[user-edit.form.build_frame]>->(
        $editor_state->{'schema'},
        $frame_name, <user-edit.form.title>
    );
}

## SOH placeholder for the cursor : one character wide so render_form's width
## and fill maths stay exact, substituted for a coloured '|' after
## colourisation below [ an ansi sequence passed in directly would break row
## alignment ]  one-character placeholders, substituted for coloured glyphs
## after colourisation below.  they must be single characters : render_form's
## width and fill maths measure them with length(), so passing ansi directly
## would break row alignment
my $rendered = <[editor.ui.ascii_frame.render_form]>->(
    $editor_state,
    $frame_name,
    undef,
    {   qw| cursor |  => qq|\x01|,
        qw| focus_l | => qq|\x02|,
        qw| focus_r | => qq|\x03|,
    }
);

if ( not defined $rendered ) {
    <[base.logs]>->( 0, ': form render failed [ %s ]', $frame_name );
    return FALSE;
}

## colourise by character class through the shared frame colouriser --
## config-driven from configuration/ascii-frame [ purple structure, TRUE blue
## slot values ], the same call memory.render.term and  context.provider.frame
## already use
$rendered = <[ascii.frame.render.color]>->($rendered) // $rendered;

## which field the cursor sits in -- active_field is an INDEX into the
## schema's field list, the same resolution render_form does internally
my $active_index = $editor_state->{'active_field'} // 0;
my $active_name  = $editor_state->{'schema'}{'fields'}[$active_index]{'name'}
    // '';

## restore the character the marker overlaid, in nshell.render.cursor's two
## forms : a real character comes back in INVERSE VIDEO so it stays readable,
## and an empty cell [ cursor past the end, or sitting on a space ] becomes a
## phosphor green underscore.  both are exactly one column wide, so the row
## keeps the width ascii.frame.render computed
my $active_value
    = <[editor.control.get_display_value]>->( $editor_state, $active_name )
    // '';
my $active_cursor
    = <[editor.control.get_cursor]>->( $editor_state, $active_name ) // 0;

my $cursor_char
    = $active_cursor < length $active_value
    ? substr( $active_value, $active_cursor, 1 )
    : '';

## THREE cases, not two.  '-nc' blanks the COLOUR palette but is not a request
## for plain text -- bin/Protocol-7 keeps clear_screen as a real escape in
## that same branch -- and inverse video is an ATTRIBUTE, not a colour, so it
## stays available and keeps the cursor visible.  only a non-terminal STDOUT
## must be free of escapes entirely
my $on_terminal = -t STDOUT ? TRUE : FALSE;

my $cursor_render;
if ( not $on_terminal ) {
    ## piped : no escapes at all, so the cursor cell can only be a character
    ## OR a marker -- prefer showing the marker, since losing the cursor
    ## position is worse than losing one readable character
    $cursor_render = q{_};
} elsif ( not length $colors{'reset'} ) {
    ## -nc : no colour, but inverse video still marks the position and keeps
    ## the character underneath readable
    $cursor_render
        = length $cursor_char && $cursor_char ne q{ }
        ? "\e[7m" . $cursor_char . "\e[27m"
        : q{_};
} elsif ( not length $cursor_char or $cursor_char eq q{ } ) {
    $cursor_render = $colors{'p7_fg_0003'} . q{_} . $colors{'p7_fg_0004'};
} else {
    ## \e[7m / \e[27m : inverse video on and off, zero columns each ##
    $cursor_render
        = "\e[7m" . $cursor_char . "\e[27m" . $colors{'p7_fg_0004'};
}

$rendered =~ s{\x01}{$cursor_render}ge;

## focus brackets in the DARKER structural tone, so they read as framing
## rather than as part of the payload text -- then back to the content colour
## for the value between them
my $bracket_color = length $colors{'reset'} ? $colors{'p7_fg_0001'} : '';
my $content_color = length $colors{'reset'} ? $colors{'p7_fg_0004'} : '';

$rendered =~ s{\x02}{$bracket_color . q{[} . $content_color}ge;
$rendered =~ s{\x03}{$bracket_color . q{]} . $content_color}ge;

## interactive mode owns the whole screen ; the one-shot render just adds the
## frame to whatever is already on the terminal  $colors{'clear_screen'}
## rather than a literal : it survives the -nc palette blanking, which is
## exactly where a hardcoded escape would have been inconsistent with the rest
## of this module
print $colors{'clear_screen'} // '' if <user-edit.form.interactive>;

## leading reset is not cosmetic : bin/Protocol-7 leaves STDERR set to
## p7_fg_0002 [ amber ], and without this the whole frame inherits it.
## $colors{'reset'}, NOT a literal "\e[0m" : bin/Protocol-7 blanks the whole
## palette when output is piped, and a hardcoded sequence would put escape
## codes into a pipe that deliberately asked for none
print $colors{'reset'} . "\n" . $rendered . $colors{'reset'} . "\n";

if (<user-edit.form.interactive>) {
    ## multi-line under the card, on the same ':' gutter the frame border
    ## uses, so the hint reads as part of the same object -- one line ran to
    ## roughly twice the card's width and overhung it badly.  keys in the dim
    ## structural tone, actions in content blue, aligned on a separator
    my $gutter = $colors{'p7_fg_0000'} // '';
    my $key    = $colors{'p7_fg_0001'} // '';
    my $action = $colors{'p7_fg_0001'} // '';
    my $done   = $colors{'reset'}      // '';

    print "\n";

    foreach my $hint (
        [ qw{ tab|arrows }, qw| field | ],
        [ qw| enter |,      qw| submit | ],
        [ qw{ esc|ctrl-c }, qw| quit | ],
    ) {
        printf " %s:%s  %-13s%s\x{b7}%s  %s%s\n",
            $gutter, $key, $hint->[0], $gutter, $action, $hint->[1], $done;
    }

    print "\n";
}

STDOUT->flush();

return TRUE;

