# name  = channels.util.get_review_stage
# descr = Determine current review stage from review record
# args  = review_record hash reference
# return = string stage name

my $rev = shift;

if ( !defined $rev->{'ai_feedback'} ) {
    return 'awaiting-ai-review';
}

my $ai_status = $rev->{'ai_feedback'}->{'status'};

if ( $ai_status eq 'approved' and !$rev->{'developer_approved'} ) {
    return 'awaiting-developer-approval';
}

if ( $rev->{'developer_approved'} and $rev->{'ai_approved'} ) {
    return 'ready-for-commit';
}

if ( $ai_status eq 'needs-changes' or $ai_status eq 'blocked' ) {
    return "changes-requested($ai_status)";
}

return 'unknown';

1;

