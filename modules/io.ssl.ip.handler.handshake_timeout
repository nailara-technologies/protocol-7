# name  = io.ssl.ip.handler.handshake_timeout
# descr = handle SSL handshake timeout - cleanup stalled handshakes
#         [ AWS bots and slow clients that open TCP but never send ClientHello ]

my $w     = $_[0]->w;
my $hs_id = $w->data;

## validate handshake state exists ##
if ( not exists $data{'ssl_handshake'}{$hs_id} ) {
    ## handshake state already cleaned up [ likely completed ] ##
    $w->cancel if $w->is_active;
    return undef;
}

my $hs         = $data{'ssl_handshake'}{$hs_id};
my $server_id  = $hs->{'server_id'};
my $p_host     = $hs->{'peerhost'};
my $p_port     = $hs->{'peerport'};
my $ssl_client = $hs->{'socket'};

## log timeout event ##
<[base.logs]>->(
    1, '[%s] ssl handshake timeout for %s:%s [ possible scanner/bot ]',
    $server_id, $p_host, $p_port
);

## crash capture hook [ httpsd only — record ssl-handshake-timeout event ] ##
$code{'httpsd.request_capture.write'}->(
    {   'event'     => 'ssl-handshake-timeout',
        'client_ip' => $p_host,
        'port'      => $p_port,
        'duration'  => ( <httpsd.cfg.ssl_handshake_timeout> // 10 )
    }
) if exists $code{'httpsd.request_capture.write'};

## cancel io watcher if still active ##
if ( defined $hs->{'io_watcher'} and $hs->{'io_watcher'}->can('cancel') ) {
    $hs->{'io_watcher'}->cancel if $hs->{'io_watcher'}->is_active;
}

## close socket ##
if ( defined $ssl_client ) {
    eval { shutdown( $ssl_client, 2 ) };
    close($ssl_client);
}

## remove handshake state ##
delete $data{'ssl_handshake'}{$hs_id};

## cancel self ##
$w->cancel if $w->is_active;

return undef;

