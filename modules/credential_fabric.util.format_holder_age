# name  = credential_fabric.util.format_holder_age
# descr = format seconds into human-readable holder age string

my $s = shift // 0;
return '0s' if $s <= 0;
return sprintf '%dm', int( $s / 60 )   if $s < 3600;
return sprintf '%dh', int( $s / 3600 ) if $s < 86400;
return sprintf '%dd', int( $s / 86400 );

