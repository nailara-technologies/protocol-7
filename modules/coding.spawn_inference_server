## [:< ##

# name  = coding.spawn_inference_server
# descr = spawn llama-server backend asynchronously

my $params = shift;

my $backend = $params->{'backend'} // qw| cpu |;
my $port    = $params->{'port'}    // 8000;

## guard against concurrent spawns : any call path (crash restart, timeout  ##
## recovery, model_path_reply, deferred timer) hits this central lock also  ##
## enforce a 30s cooldown: the seed sleep(0.0013) yields to the event loop, ##
## which can let a second call through before the first completes           ##
if (<coding.awaiting_resources>) {
    <[base.logs]>->(
        2,
        '[spawn_inference_server] awaiting gpu resources — spawn deferred %s',
        $backend
    );
    return { 'success' => FALSE, 'error' => 'awaiting gpu resources' };
}
if (<coding.spawning_in_progress>) {
    <[base.logs]>->(
        2, '[spawn_inference_server] spawn already in progress, skipping %s',
        $backend
    );
    return { 'success' => FALSE, 'error' => 'spawn already in progress' };
}
<coding.spawning_in_progress> = TRUE;

## look up binary from config if not explicitly provided ##
my $lib_path = <coding.lib_path>   // '';
my $binary   = $params->{'binary'} // (
    $backend eq 'gpu'
    ? ( <inference.backend.gpu.binary> // "$lib_path/llama-server-cuda-fa" )
    : ( <inference.backend.cpu.binary> // "$lib_path/llama-server-cpu" )
);
my $threads     = $params->{'threads'}     // 8;
my $gpu_layers  = $params->{'gpu_layers'}  // 33;
my $model_path  = $params->{'model_path'}  // '';
my $mmproj_path = $params->{'mmproj_path'} // '';

## cancel watchers, close fds, and kill old server before spawning new one ##
my $old = <coding.inference_servers>->{$backend} // {};
<coding.watcher_pair> //= {};
for my $w_key (
    qw| watcher_stdout watcher_stderr
    watcher_drain_stdout watcher_drain_stderr |
) {
    my $w = $old->{$w_key};
    next unless defined $w;
    ## remove from watcher_pair BEFORE cancelling : if the old server's ##
    ## "ready" event was already queued, cancel_watcher.backend_monitor ##
    ## will fire after this and find no pair entry, returning early     ##
    ## (prevents drain watchers being set up on B's reused fd numbers)  ##
    my $paired = delete <coding.watcher_pair>->{$w};
    delete <coding.watcher_pair>->{$paired} if defined $paired;
    $w->cancel()                            if $w->is_active();
}
for my $fh_key (qw| io_stdout io_stderr |) {
    my $fh = $old->{$fh_key};
    close($fh) if defined $fh;
}
if ( my $old_pid = $old->{'pid'} ) {
    if ( kill( 0, $old_pid ) ) {    ## process still exists ##
        ## kill the entire process group : covers the server and any forked ##
        ## workers (llama-server forks on first request; all share the pgid ##
        ## set by our setpgid call at spawn time)                           ##
        kill( 'KILL', -$old_pid );     ## negative pid = kill process group ##
        <[base.waitpid]>->($old_pid);  ## reap the group leader's zombie    ##
        <[base.logs]>->(
            1, '[spawn_inference_server] killed old %s server group [pid:%d]',
            $backend, $old_pid
        );
    }
}

## instance-scoped pid file: old and new twins never clobber each other ##
my $zenka_dir = <[file.zenka_dir.data_path]>;
my $pid_rel   = "state/inference.$backend.$$.pid";

## ensure state/ subdir exists ##
<[file.make_path]>->("$zenka_dir/state")
    unless -d "$zenka_dir/state";

## scan ALL instance pid files for this backend and kill any live orphans ##
for my $orphan_path ( glob "$zenka_dir/state/inference.$backend.*.pid" ) {
    my ( $age_s, $pid_bin_str )
        = <[file.timestamped_delta_s]>->($orphan_path);
    next unless defined $pid_bin_str;
    my ( $saved_pid, $saved_bin ) = split m|\s+|, $pid_bin_str, 2;
    $saved_pid //= '';
    $saved_bin //= '';
    if ( $saved_pid =~ m|^\d+$| and kill( 0, $saved_pid ) ) {
        my $proc_cmd = '';
        if ( open my $cfh, '<', "/proc/$saved_pid/cmdline" ) {
            local $/;
            $proc_cmd = <$cfh>;
            close $cfh;
        }
        if ( length $saved_bin and $proc_cmd =~ m|\Q$saved_bin\E| ) {
            ## $age_s is already an elapsed-seconds delta [ from          ##
            ## timestamped_delta_s ] -- base.parser.duration expects an   ##
            ## absolute unix start-time and computes now-start itself, so ##
            ## reconstruct a start-time rather than passing the delta     ##
            ## directly [ else it reports age since unix epoch ]          ##
            my $age_str
                = defined $age_s
                ? <[base.parser.duration]>->( <[base.time]>->() - $age_s )
                : 'unknown age';
            kill( 'KILL', $saved_pid );
            <[base.waitpid]>->($saved_pid);
            <[base.logs]>->(
                1,
                '[spawn_inference_server] killed orphan '
                    . '%s server [pid:%d age:%s] from pid file',
                $backend,
                $saved_pid,
                $age_str
            );
        }
    }
    unlink $orphan_path;    ## clean up regardless of kill result ##
}

## scan for stale llama-server processes on same port ##
my @killed_stale_pids;
if ( open my $pfh, '-|', 'fuser', '-n', 'tcp', $port ) {
    while ( my $line = <$pfh> ) {
        for my $stale_pid ( $line =~ m|(\d+)|g ) {
            next if $stale_pid == $$;    ## skip self ##
            my $proc_cmd = '';
            if ( open my $cfh, '<', "/proc/$stale_pid/cmdline" ) {
                local $/;
                $proc_cmd = <$cfh>;
                close $cfh;
            }
            next unless $proc_cmd =~ m|llama-server|;
            kill( 'KILL', $stale_pid );
            push @killed_stale_pids, $stale_pid;
            <[base.logs]>->(
                1,
                '[spawn_inference_server] killed '
                    . 'stale llama-server on port %d [pid:%d]',
                $port,
                $stale_pid
            );
        }
    }
    close $pfh;
}

<[base.logs]>->(
    1,        "[spawn_inference_server] backend=%s port=%d",
    $backend, $port
);
if ( length($model_path) ) {
    my $path_display = <[base.parser.ellipse_center]>->( $model_path, 60 );
    <[base.logs]>->( 1, ':. %s', $path_display );
}

unless ( -x $binary ) {
    <[base.logs]>->(
        0, "[spawn_inference_server] binary not executable: %s", $binary
    );
    <coding.spawning_in_progress> = FALSE;
    return { 'success' => FALSE, 'error' => 'binary not executable' };
}

# Verify model file exists if provided
if ( length($model_path) && !-f $model_path ) {
    my $path_display = <[base.parser.ellipse_center]>->( $model_path, 60 );
    <[base.logs]>->( 0, "[spawn_inference_server] model not found" );
    <[base.logs]>->( 0, ":. %s", $path_display );
    <coding.spawning_in_progress> = FALSE;
    return { 'success' => FALSE, 'error' => "model not found: $model_path" };
}

## memory safety: check for other llama processes before gpu spawn ##
if ( $backend eq qw| gpu | ) {
    my @other_procs = qx{ pgrep -a 'llama-(server|mtmd-cli)' 2>/dev/null };
    my $own_pid     = <coding.inference_servers>->{$backend}{'pid'} // 0;
    my @foreign_procs;
    foreach my $proc (@other_procs) {
        chomp $proc;
        next unless length $proc;
        my ($pid) = $proc =~ m|^(\d+)|;
        next if $pid && $pid == $own_pid;

        ## Skip defunct (zombie) processes - they're dead but not reaped ##
        if ($pid) {
            ## skip PIDs we just killed in the port scan (may linger ##
            ## briefly)                                              ##
            next if grep { $_ == $pid } @killed_stale_pids;

            ## skip child processes of our own server (llama-server forks a ##
            ## worker on first request : same cmdline, different PID)       ##
            if ($own_pid) {
                my $ppid = 0;
                if ( open my $sfh, '<', "/proc/$pid/status" ) {
                    while ( my $sl = <$sfh> ) {
                        if ( $sl =~ m|^PPid:\s+(\d+)| ) { $ppid = $1; last }
                    }
                    close $sfh;
                }
                next if $ppid == $own_pid;
            }

            my $stat_file = "/proc/$pid/stat";
            if ( open my $fh, '<', $stat_file ) {
                my $stat = <$fh>;
                close($fh);
                ## defunct/zombie processes have 'Z' state in stat stat ##
                ## format: pid (comm) state ppid ...                    ##
                if ( $stat && $stat =~ m|^\d+\s+\([^)]+\)\s+Z| ) {
                    next;    ## skip zombies ##
                }
            }
        }

        push @foreign_procs, $proc;
    }
    if (@foreign_procs) {
        <[base.logs]>->(
            0,
            '[spawn_inference_server] foreign llama process '
                . 'detected, refusing gpu spawn to prevent oom: %s',
            join( '; ', @foreign_procs )
        );
        <coding.spawning_in_progress> = FALSE;
        return {
            'success' => FALSE,
            'error'   => 'another llama process is '
                . 'running : gpu spawn blocked'
        };
    }

    ## vram sanity check ##
    my $nvidia_smi = qx{ nvidia-smi --query-gpu=memory.total,memory.free
                               --format=csv,noheader,nounits 2>/dev/null };
    if ( $nvidia_smi =~ m|^(\d+),\s*(\d+)|m ) {
        my ( $total_mb, $free_mb ) = ( $1, $2 );
        my $model_size_mb = ( -s $model_path ) / ( 1024 * 1024 );
        my $safety_mb     = <coding.cfg.vram_safety_mb> // 1024;
        if ( $free_mb < $model_size_mb + $safety_mb ) {
            <[base.logs]>->(
                0,
                '[spawn_inference_server] insufficient '
                    . 'vram: free=%d MB model=%.0f MB safety=%d MB',
                $free_mb,
                $model_size_mb,
                $safety_mb
            );
            <coding.spawning_in_progress> = FALSE;
            return {
                'success' => FALSE,
                'error'   => 'insufficient vram for model load'
            };
        }
    }
}

## Build llama-server command
my @cmd = ( $binary, '--port', $port, qw|  --host  127.0.0.1  | );

# add model path if provided
push @cmd, '-m', $model_path if length($model_path);

# add multimodal projector for vision models
push @cmd, '--mmproj', $mmproj_path
    if length($mmproj_path) && -f $mmproj_path;

# disable log file for now [LLL] fix location and permissions [owner]
push @cmd, qw| --log-disable --log-file /dev/null |;

# Add context and other parameters
## context and generation limits from config  max_tokens defaults to ##
## context_length when not set separately                            ##
my $max_tokens = <inference.model.max_tokens>
    // <inference.model.context_length> // 4096;

## context size: auto-calculated from VRAM, with configured value as a  ##
## floor configured acts as a minimum : smaller models may safely allow ##
## more context                                                         ##

my $safe = <[coding.helper.calculate_safe_context]>->(
    {   model_path  => $model_path,
        mmproj_path => $mmproj_path,
        backend     => $backend,
    }
);
my $auto_ctx = $safe->{'context_length'};
my $ctx_size;
if ( defined <inference.model.context_length> ) {
    my $configured = <inference.model.context_length>;
    if ( $auto_ctx > $configured ) {
        ## smaller model : auto-calc gives more  context than configured ##
        ## floor                                                         ##
        $ctx_size = $auto_ctx;
        <[base.logs]>->(
            1,
            '[spawn_inference_server] context expanded '
                . 'to %d [auto > configured floor %d] [%s]',
            $ctx_size,
            $configured,
            $safe->{'explanation'}
        );
    } else {
        ## large model : use configured floor  even if above safe auto-calc ##
        $ctx_size = $configured;
        if ( $configured > $auto_ctx ) {
            <[base.logs]>->(
                1,
                ': context set to configured %d [ '
                    . 'above %d auto-calc : user override ]',
                $configured,
                $auto_ctx
            );
        }
    }
} else {
    $ctx_size = $auto_ctx;
    <[base.logs]>->( 1, ': auto-context : %s', $safe->{'explanation'} );
}

## timeout-recovery ceiling : hard cap set by coding.callback.http_error    ##
## after a data-start timeout. unlike the configured floor above, this MUST ##
## win over auto-calc — otherwise VRAM-pressure recovery never takes effect ##
## and the timeout/restart loop repeats forever                             ##
my $recovery_ceiling = <coding.cfg.ctx_recovery_ceiling>;
if ( defined $recovery_ceiling and $ctx_size > $recovery_ceiling ) {
    <[base.logs]>->(
        1,
        '[spawn_inference_server] context capped '
            . 'to %d [timeout recovery ceiling, was %d]',
        $recovery_ceiling,
        $ctx_size
    );
    $ctx_size = $recovery_ceiling;
}

push @cmd, qw| -c |, $ctx_size;
push @cmd, qw| -n |, $max_tokens;

# Backend-specific settings
if ( $backend eq qw| cpu | ) {
    push @cmd, '-t', $threads;    # Number of threads
} elsif ( $backend eq qw| gpu | ) {
    push @cmd, qw| -ngl |, $gpu_layers;    # GPU layers
}

# No warmup to start faster
push @cmd, qw| --no-warmup |;

## jinja template engine [ disable if new binary crashes on tool calls ] ##
if ( <[base.cfg_bool]>->( <coding.jinja.enable> // 1 ) ) {
    push @cmd, qw| --jinja |;
    ## fixed chat template override [ e.g. froggeric qwen3.5/3.6 bug fixes ##
    ## ]                                                                   ##
    my $tmpl_file = <coding.jinja.template_file> // '';
    if ( length $tmpl_file and -r $tmpl_file ) {
        push @cmd, '--chat-template-file', $tmpl_file;
        <[base.logs]>->(
            2, '[spawn_inference_server] chat template: %s', $tmpl_file
        );
    }
}

## reasoning effort [ controls <think> budget : varies by model and task ##
## type ]                                                                ##
my $reasoning_effort = <coding.inference.reasoning_effort> // '';
if ( length $reasoning_effort ) {
    push @cmd, '--chat-template-kwargs',
        sprintf( '{"reasoning_effort":"%s"}', $reasoning_effort );
}

## harmonic seed [ configurable fixed seed or generated from ntime+fortuna ##
## ]                                                                       ##
my $fixed_seed = <inference.model.seed> // 0;
my $seed;
if ($fixed_seed) {
    $seed = $fixed_seed;
} else {
    ## generate harmonic seed from network timestamp mixed with fortuna ##
    my $fortuna = <base.prng.fortuna>;
    ( $seed = join( '', <[base.ntime]>->(13), $fortuna->int32 ) ) =~ s|\.||g;
    ( $seed /= 13 ) =~ s,(\.|e.+$),,g;
    ## iterate until harmonically valid ##
    my $attempts = 57;
    while ( $attempts-- and <[base.assert.harmony]>->($seed) == 0 ) {
        ( $seed = join( '', <[base.ntime]>->(13), $fortuna->int32 ) )
            =~ s|\.||g;
        ( $seed /= 13 ) =~ s,(\.|e.+$),,g;
        <[base.sleep]>->(0.0013) if $attempts < 37;
    }
}
push @cmd, '--seed', $seed;
<[base.logs]>->( 1, ': %s server seed : %s', $backend, $seed );

## Spawn llama-server with open3
my ( $server_in, $server_out, $server_err );
$server_err = Symbol::gensym;

# Set up environment for llama-server [ same as lm-vision does ]
local $ENV{'LD_LIBRARY_PATH'}
    = <coding.lib_path> . ':' . ( $ENV{'LD_LIBRARY_PATH'} // '' );

my $pid = eval { IPC::Open3::open3( undef, $server_out, $server_err, @cmd ) };

if ( !$pid || $EVAL_ERROR ) {
    <[base.logs]>->(
        0, "[spawn_inference_server] failed to spawn: backend=%s error=%s",
        $backend, $EVAL_ERROR // 'unknown error'
    );
    <coding.spawning_in_progress> = FALSE;
    return { 'success' => FALSE, 'error' => $EVAL_ERROR // 'spawn failed' };
}

## set pipes to non-blocking : prevent event loop stall on partial reads ##
for my $pipe_fh ( $server_out, $server_err ) {
    my $flags = fcntl( $pipe_fh, Fcntl::F_GETFL(), 0 );
    fcntl( $pipe_fh, Fcntl::F_SETFL(), $flags | Fcntl::O_NONBLOCK() )
        if defined $flags;
}

## make server its own process group leader so kill( -pid ) reaches all ##
## children [ llama-server forks a worker on first request ]            ##
POSIX::setpgid( $pid, $pid );

<[base.logs]>->(
    1, "[spawn_inference_server] spawned: backend=%s pid=%d port=%d",
    $backend, $pid, $port
);

## Report child PID to v7 for lifecycle management
<[base.zenki.report_child_pid]>->($pid);

## exponential-backoff poll for forked worker  child [ 0.7s × 1.6 each miss ##
## ]                                                                        ##
<[event.add_timer]>->(
    {   'after'   => 0.7,
        'handler' => qw| coding.handler.register_server_children |,
        'data'    => {
            'backend'    => $backend,
            'parent_pid' => $pid,
            'interval'   => 0.7
        }
    }
);

## write timestamped pid file for this instance ##
<[file.write_timestamped]>->( "$zenka_dir/$pid_rel", "$pid $binary" );

## Store server metadata (initialize if needed)
<coding.inference_servers> = {} unless defined <coding.inference_servers>;
<coding.inference_servers>->{$backend} = {
    'backend' => $backend,
    'port'    => $port,
    'pid'     => $pid,
    'binary'  => $binary,
    'seed'    => $seed,
    'n_ctx'   => $ctx_size,    ## actual context window passed to server ##
    'calculated_ctx' => $safe->{'calculated'}, ## VRAM-safe auto-calc value ##
    'status'         => qw| starting |,
    'start_time'     => <[base.time]>->(3),
    'stdout'         => $server_out,
    'stderr'         => $server_err,
    'mmproj_path'    => $mmproj_path,
    'model_path'     => $model_path,
};

## Register I/O handlers to monitor startup
<[base.logs]>->(
    1,
    "[spawn_inference_server] pipe fds: stdout=%s stderr=%s",
    fileno($server_out) // 'undef',
    fileno($server_err) // 'undef'
);
my $watcher_out = <[event.add_io]>->(
    {   'fd'      => $server_out,
        'handler' => qw| coding.handler.monitor_inference_startup |,
        'data'    => {
            'backend'       => $backend,
            'pid'           => $pid,
            'log_whitelist' => [qw| INFO |]
        },
        'poll' => qw| re |
    }
);

my $watcher_err = <[event.add_io]>->(
    {   'fd'      => $server_err,
        'handler' => qw| coding.handler.monitor_inference_startup |,
        'data'    => {
            'backend'       => $backend,
            'pid'           => $pid,
            'log_whitelist' => [qw| INFO |]
        },
        'poll' => qw| re |
    }
);

### reference watcher pair for later cancellation ###
<coding.watcher_pair>->{$watcher_out} = $watcher_err;
<coding.watcher_pair>->{$watcher_err} = $watcher_out;

<coding.inference_servers>->{$backend}->{'io_stdout'}      = $server_out;
<coding.inference_servers>->{$backend}->{'io_stderr'}      = $server_err;
<coding.inference_servers>->{$backend}->{'watcher_stdout'} = $watcher_out;
<coding.inference_servers>->{$backend}->{'watcher_stderr'} = $watcher_err;
#
## <-- 'e' is _not_ stderr, but exception.

<coding.spawning_in_progress> = FALSE;
return {
    'success' => TRUE,
    'backend' => $backend,
    'pid'     => $pid,
    'port'    => $port
};

