# name  = coding.spawn_inference_server
# descr = spawn llama-server HTTP backend asynchronously for text inference

my $params = shift;

my $backend    = $params->{'backend'}    // qw| cpu |;
my $binary     = $params->{'binary'}     // '';
my $port       = $params->{'port'}       // 8000;
my $threads    = $params->{'threads'}    // 8;
my $gpu_layers = $params->{'gpu_layers'} // 33;
my $model_path = $params->{'model_path'} // '';

<[base.logs]>->(
    1,        "[spawn_inference_server] backend=%s port=%d",
    $backend, $port
);
if ( length($model_path) ) {
    my $path_display = <[base.parser.ellipse_center]>->( $model_path, 60 );
    <[base.logs]>->( 1, ':. %s', $path_display );
}

unless ( -x $binary ) {
    <[base.logs]>->(
        0, "[spawn_inference_server] binary not executable: %s", $binary
    );
    return { 'success' => FALSE, 'error' => 'binary not executable' };
}

# Verify model file exists if provided
if ( length($model_path) && !-f $model_path ) {
    my $path_display = <[base.parser.ellipse_center]>->( $model_path, 60 );
    <[base.logs]>->( 0, "[spawn_inference_server] model not found" );
    <[base.logs]>->( 0, ":. %s", $path_display );
    return { 'success' => FALSE, 'error' => "model not found: $model_path" };
}

## Build llama-server command
my @cmd = ( $binary, '--port', $port, qw|  --host  127.0.0.1  | );

# Add model path if provided
push @cmd, '-m', $model_path if length($model_path);

# disable log file for now [LLL] fix location and permissions [owner]
push @cmd, qw| --log-disable --log-file /dev/null |;

# Add context and other parameters
push @cmd, qw| -c 7777 |;    # Context size for text inference
push @cmd, qw| -n 3000 |;    # Default max tokens

# Backend-specific settings
if ( $backend eq qw| cpu | ) {
    push @cmd, '-t', $threads;    # Number of threads
} elsif ( $backend eq qw| gpu | ) {
    push @cmd, qw| -ngl |, $gpu_layers;    # GPU layers
}

# No warmup to start faster
push @cmd, qw| --no-warmup |;

## Spawn llama-server with open3
my ( $server_in, $server_out, $server_err );
$server_err = Symbol::gensym;

# Set up environment for llama-server (same as lm-vision does)
local $ENV{'LD_LIBRARY_PATH'}
    = <coding.lib_path> . ':' . ( $ENV{'LD_LIBRARY_PATH'} // '' );

my $pid = eval { IPC::Open3::open3( undef, $server_out, $server_err, @cmd ) };

if ( !$pid || $EVAL_ERROR ) {
    <[base.logs]>->(
        0, "[spawn_inference_server] failed to spawn: backend=%s error=%s",
        $backend, $EVAL_ERROR // 'unknown error'
    );
    return { 'success' => FALSE, 'error' => $EVAL_ERROR // 'spawn failed' };
}

<[base.logs]>->(
    1, "[spawn_inference_server] spawned: backend=%s pid=%d port=%d",
    $backend, $pid, $port
);

## Report child PID to v7 for lifecycle management
<[base.zenki.report_child_pid]>->($pid);

## Store server metadata (initialize if needed)
<coding.inference_servers> = {} unless defined <coding.inference_servers>;
<coding.inference_servers>->{$backend} = {
    'backend'    => $backend,
    'port'       => $port,
    'pid'        => $pid,
    'binary'     => $binary,
    'status'     => qw| starting |,
    'start_time' => <[base.time]>->(3),
    'stdout'     => $server_out,
    'stderr'     => $server_err,
};

## Register I/O handlers to monitor startup
<[event.add_io]>->(
    {   'fd'      => $server_out,
        'handler' => qw| coding.handler.monitor_inference_startup |,
        'data'    => {
            'backend'       => $backend,
            'log_whitelist' => [qw| INFO |]
        },
        'poll' => qw| re |
    }
);

<[event.add_io]>->(
    {   'fd'      => $server_err,
        'handler' => qw| coding.handler.monitor_inference_startup |,
        'data'    => {
            'backend'       => $backend,
            'log_whitelist' => [qw| INFO |]
        },
        'poll' => qw| re |
    }
);

<coding.inference_servers>->{$backend}->{'io_stdout'} = $server_out;
<coding.inference_servers>->{$backend}->{'io_stderr'} = $server_err;

return {
    'success' => TRUE,
    'backend' => $backend,
    'pid'     => $pid,
    'port'    => $port
};

