# name = data.mount.shm.open.parse_shm_path
# desc = Parse SHM path into pub-key and sub-path components

my $path = shift;

if ( $path =~ m{/dev/shm/p7:M:([A-Z0-9]+)(?::(.+))?} ) {
    return ( $1, $2 );
}

return undef;

