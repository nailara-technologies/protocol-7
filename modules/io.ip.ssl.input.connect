## [:< ##

# name = io.ip.ssl.input.connect
# descr = Handle incoming SSL/TLS connections
#        [ like io.ip.tcp.input.connect but for IO::Socket::SSL ]

my $fd = $_[0]->w->fd;     ## <-- $data{'session'}{$id}{'handle'} ##
my $id = $_[0]->w->data;

return undef if not defined $data{'session'}{$id};

my $client_sock_fd;

# Accept connections from IO::Socket::SSL listening socket
if ( ref($fd) eq qw| IO::Socket::SSL | and -S $fd ) {
    if ( not $client_sock_fd = $fd->accept() ) {
        my $log_level = 0;
        my $known_lvl = 2;
        my $err_msg   = <[base.format_error]>->( IO::Socket::SSL::errstr() );
        $err_msg = 'client session shutdown'
            if $err_msg =~ m|error:0A000126|;
        $err_msg = lc($err_msg) if $err_msg =~ s| attempt||g;
        if ( length( $err_msg // '' ) ) {
            my $os_err = <[base.str.os_err]>;
            $err_msg = sprintf( '%s [%s]', $err_msg, $os_err )
                if length $os_err;
            $log_level = $known_lvl
                if $err_msg =~ s|connection reset|reset|
                or $err_msg =~ s|broken pipe|sigpipe|
                or not length $os_err;
        } else {
            $err_msg = <[base.str.os_err]> if not length( $err_msg // '' );
        }
        $err_msg =~ s|broken pipe|sigpipe|;
        <[base.log]>->( $log_level, "[$id] : IP-TCP-SSL-accept : $err_msg" );
        return undef;
    }

    my ( $p_host, $p_port )
        = ( $client_sock_fd->peerhost(), $client_sock_fd->peerport() );

    return undef    ##  <-- closed .., ##
        if not defined $p_host
        or not defined $p_port;

    ## Register accepted client connection in handle data
    ## structure [ by both socket ref and FD ]
    my $client_fd = fileno($client_sock_fd);

    $data{'handle'}{$client_sock_fd} = {
        'encryption' => qw| tls |,
        'mode'       => qw| input |,
        'link'       => qw| ip.ssl |,
        'peerhost'   => $p_host,
        'peerport'   => $p_port,
        'v4_over_6'  => $p_host =~ s|^::ffff:|| ? 1 : 0
    };

    # Also register by numeric FD for event loop lookup
    $data{'handle'}{$client_fd} = $data{'handle'}{$client_sock_fd};

    <[base.logs]>->(
        1,
        '[%s] IN.-SSL [%s:%s] encrypted=tls',
        $id,
        $data{'handle'}{$client_sock_fd}{'peerhost'},
        $data{'handle'}{$client_sock_fd}{'peerport'}
    );

    <[base.logs]>->(
        2,   '[%s] SSL socket registered: fd=%d (ref and numeric)',
        $id, $client_fd
    );

    return $client_sock_fd;    ## <-- success \ returning client socket ##

} else {
    <[base.logs]>->(
        0,   '[%d] server socket is not valid (expected IO::Socket::SSL) %s',
        $id, <[base.caller]>
    );
    return undef;              ## <-- connection closed \ error connecting ##
}

