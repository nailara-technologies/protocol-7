## [:< ##

# name = image-batch.process
# descr = Batch processing orchestrator using jobqueue for concurrency control

my $yaml_path = shift;

# Validate YAML path provided
return { success => FALSE, error => 'YAML path required' }
    unless defined $yaml_path;
return { success => FALSE, error => "YAML file not found: $yaml_path" }
    unless -f $yaml_path;

# Load and validate YAML batch specification
my $spec_result = <[image-batch.load_yaml_spec]>->($yaml_path);
return $spec_result unless $spec_result->{success};

my $spec = $spec_result->{batch_name} ? $spec_result : $spec_result->{spec};
my $image_paths = $spec->{images};
my $batch_name  = $spec->{batch_name} // 'Untitled Batch';

# Generate unique batch ID
my $batch_id_result = <[image-batch.generate_batch_id]>;
return $batch_id_result unless $batch_id_result->{success};

my $batch_id = $batch_id_result->{batch_id};

# Initialize batch_state with simplified structure (no child_pids array)
<image-batch.batch_state> = {
    batch_id     => $batch_id,
    batch_name   => $batch_name,
    status       => qw| initializing |,
    started_at   => <[base.time]>->(3),
    total_images => scalar(@$image_paths),
    statistics   => {
        completed          => 0,
        failed             => 0,
        grade_distribution => {}
    }
};

my $batch_state = <image-batch.batch_state>;

# Populate jobqueue with all image analysis tasks
# jobqueue handles concurrency and job state management
foreach my $image_path (@$image_paths) {
    my $job_id
        = 'job_' . substr( $batch_id, 0, 8 ) . '_' . <[jobqueue.count]>;

    <[jobqueue.add_job]>->(
        {   job_id     => $job_id,
            batch_id   => $batch_id,
            image_path => $image_path,
            type       => 'analyze',
            priority   => 50,                  # default priority
            queued_at  => <[base.time]>->(3)
        }
    );
}

<[base.log]>->(
    1,
    sprintf(
        'Batch %s: queued %d images for analysis',
        $batch_id, <[jobqueue.count]>->('queued')
    )
);

# Fork single child process for blocking operations
<[image-batch.parent.fork_child]>;

# After fork, parent continues here
if (<image-batch.child.pid>) {

    # PARENT PROCESS

    <[base.log]>->( 1, 'child forked, dispatching first job.,' );

    # Get first job from queue and send to child
    my $first_job = <[jobqueue.get_next_job]>->('queued');

    if ( defined $first_job ) {
        <[jobqueue.move_job]>->( $first_job->{job_id}, 'processing' );

        # Send job to child via Protocol-7 command routing
        <[base.protocol-7.command.send.local]>->(
            {   'command'   => "child.analyze_image",
                'call_args' => {
                    'args' => sprintf( "%s %s",
                        $first_job->{image_path},
                        $first_job->{job_id} )
                },
                'reply' => {
                    'handler' => 'image-batch.parent.handle_job_reply',
                    'params'  => { 'job_id' => $first_job->{job_id} }
                }
            }
        );

        <[base.log]>->(
            2,
            sprintf(
                'Sent first job to child: %s (%s)',
                $first_job->{job_id}, $first_job->{image_path}
            )
        );
    } else {
        <[base.log]>->( 1, 'ERROR: No jobs in queue to process' );
        $batch_state->{status} = 'failed';
        return { success => FALSE, error => 'No jobs in queue' };
    }

    # Update batch state to running
    $batch_state->{status} = qw| running |;

    # Persist batch state to disk
    <[base.perlmod.load]>->( 'JSON::XS', qw| encode_json | );

    my $persist_data = {
        batch_id     => $batch_state->{batch_id},
        batch_name   => $batch_state->{batch_name},
        status       => $batch_state->{status},
        started_at   => $batch_state->{started_at},
        total_images => $batch_state->{total_images},
        statistics   => $batch_state->{statistics}
    };

    my $batch_file_path    = "$batch_id.json";
    my $batch_file_content = JSON::XS::encode_json($persist_data);

    if (<[file.zenka_dir.write]>->(
            $batch_file_path, \$batch_file_content, undef, 0660
        )
    ) {
        <[base.log]>->( 2, "Batch state persisted: $batch_file_path" );
    } else {
        <[base.log]>->(
            1, "WARNING: Failed to persist batch state to $batch_file_path"
        );
    }

    # Return immediately with batch_id (non-blocking)
    return {
        success      => TRUE,
        batch_id     => $batch_id,
        batch_name   => $batch_name,
        status       => qw| running |,
        total_images => $batch_state->{total_images},
        message => sprintf( 'Batch %s processing started with single child',
            $batch_id )
    };
}

