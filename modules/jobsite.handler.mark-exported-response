# name  = jobsite.handler.mark-exported-response
# descr = logs the async outcome of jobsite.cmd.mark-exported's http push

my $result = shift               // {};
my $ok     = $result->{'ok'}     // FALSE;
my $body   = $result->{'body'}   // '';
my $params = $result->{'params'} // {};
my $url    = $params->{'url'}    // '';
my $id     = $params->{'id'}     // '';
my $stage  = $params->{'stage'}  // '';

my $reply   = $ok ? eval { JSON::XS::decode_json($body) }        : undef;
my $body_ok = ref $reply eq 'HASH' ? ( $reply->{'ok'} // FALSE ) : FALSE;

if ( $ok and ref $reply eq 'HASH' and $body_ok ) {
    <[base.logs]>->(
        1,   'jss.mark-exported: %s marked exported (stage=%s) via %s',
        $id, $stage, $url
    );
} else {
    <[base.logs]>->(
        0,
        'jss.mark-exported: FAILED for %s (stage=%s) via %s: %s',
        $id, $stage, $url,
        $ok
        ? (   ( ref $reply eq 'HASH' )
            ? ( $reply->{'error'} // 'server ok:false' )
            : 'bad response body'
            )
        : 'transport failure'
    );
}

