# name = llm.service.subprocess_wrapper
# descr = query local LLM models via subprocess (llama.cpp/ik_llama.cpp)
# purpose = Local inference: Run GGUF models directly without server overhead

use strict;
use warnings;
use IPC::Run    qw(run);
use Time::HiRes qw(time);

# Model aliases for subprocess API compatibility
my %MODEL_ALIASES = (
    'qwen'      => 'qwen2.5-7b-instruct-1m',
    'mathstral' => 'mathstral-7b-v0.1',
    'aya'       => 'aya-23-8b'
);

# Helper to fetch model config from models zenka
<[base.perlmod.autoload]>->(qw| JSON::PP |);

my $get_model_config = sub {
    my ($model_alias) = @ARG;

    # Resolve alias to model ID
    my $model_id = $MODEL_ALIASES{$model_alias} || $model_alias;

    # Fetch from models zenka (now includes metadata)
    my $response = <[protocol-7.command.send.local]>->(
        {   'command'   => "models.get_model_path",
            'call_args' => { 'model_id' => $model_id }
        }
    );

    return undef
        unless $response && ref($response) eq qw| HASH | && $response->{data};

    my $model_data;
    eval { $model_data = JSON::PP::decode_json( $response->{data} ); };
    return undef unless $model_data && ref($model_data) eq qw| HASH |;

    # Return complete config with metadata from models zenka
    return {
        name           => $model_data->{name},
        model_path     => $model_data->{path},
        mmproj         => $model_data->{mmproj},
        context_size   => $model_data->{context_size},
        batch_size     => $model_data->{batch_size},
        threads        => $model_data->{threads},
        tokens_per_sec => $model_data->{tokens_per_sec}
    };
};

# Query a model via subprocess
my $query_subprocess = sub {
    my ( $model, $prompt ) = @ARG;

    <[base.logs]>->( 1, "[llm.service] query_subprocess : model=%s", $model );

    my $config = $get_model_config->($model);
    unless ($config) {
        <[base.logs]>->(
            0, "[llm.service] Error : Unknown model : %s", $model
        );
        return {
            success => FALSE,
            error   => "Unknown model or unable to fetch config: $model"
        };
    }

    unless ( defined $prompt && length($prompt) > 0 ) {
        <[base.log]>->( 0, "[llm.service] Error : Prompt required" );
        return {
            success => FALSE,
            error   => "Prompt required"
        };
    }

    # Verify model file exists
    if ( !-f $config->{model_path} ) {
        <[base.logs]>->(
            0, "[llm.service] Error: Model file not found: %s",
            $config->{model_path}
        );
        return {
            success => FALSE,
            error   => "Model file not found: " . $config->{model_path}
        };
    }

    # Prepare llama.cpp subprocess command
    # Using ik_llama.cpp for better efficiency
    my @cmd = (
        'llama-cli',           # Use llama-cli for direct inference
        '-m',   $config->{model_path},
        '-n',   '256',                     # Max tokens to generate
        '-c',   $config->{context_size},   # Context size
        '-b',   $config->{batch_size},
        '-t',   $config->{threads},
        '-ngl', '99',                      # GPU layers (use GPU if available)
        '--no-penalize-nl',                # Better formatting
        '-p', $prompt,                     # The prompt
    );

    # Execute command and capture output
    my ( $out, $err );
    my $start_time = time();

    eval { run \@cmd, \undef, \$out, \$err, { timeout => 30 }; };

    my $elapsed = time() - $start_time;

    if ($EVAL_ERROR) {
        return {
            success => FALSE,
            error   => "Subprocess execution failed: $EVAL_ERROR",
            command => join( ' ', @cmd ),
            stderr  => $err
        };
    }

    # parse output (llama.cpp outputs the completion after the prompt)
    my $answer = <[llm.service.subprocess_wrapper.extract_completion]>->(
        $out, $prompt
    );

    return {
        success  => TRUE,
        response => {
            model       => $model,
            prompt      => $prompt,
            answer      => $answer,
            tokens_used =>
                <[llm.service.subprocess_wrapper.estimate_tokens]>->(
                $prompt, $answer
                ),
            latency_ms => int( $elapsed * 1000 ),
            timestamp  => <[base.ntime]>,
            confidence =>
                <[llm.service.subprocess_wrapper.estimate_confidence]>->(
                $out)
        }
    };
};

# Get list of available models
my $get_available_models = sub {
    my @available = ();

    foreach my $model_id ( keys %MODEL_ALIASES ) {
        my $config = $get_model_config->($model_id);
        next unless $config;

        push @available,
            {
            id         => $model_id,
            name       => $config->{name},
            model_path => $config->{model_path},
            exists     => -f $config->{model_path} ? 1 : 0
            };
    }

    return {
        success          => TRUE,
        available_models => \@available,
        models_found     => scalar( grep { $_->{exists} } @available )
    };
};

# Check system has llama-cli
my $check_llama_cli = sub {
    my $result = `which llama-cli 2>&1`;
    chomp($result);

    if ( $result && -f $result ) {
        return {
            success        => TRUE,
            llama_cli_path => $result,
            ready          => 1
        };
    }

    return {
        success => FALSE,
        error   => "llama-cli not found in PATH",
        help    => "Install ik_llama.cpp from: "
            . "https://github.com/ikawrakow/ik_llama.cpp",
        alternatives => [
            "Build from source: git clone "
                . "https://github.com/ikawrakow/ik_llama.cpp.git",
            "Download pre-built binaries from GitHub releases",
            "Install via package manager if available"
        ]
    };
};

# Main entry point
my $cmd  = shift @ARG // 'query';
my $arg1 = shift @ARG;

if ( $cmd eq 'query' ) {
    return query_subprocess->( $arg1, $_[0] );
} elsif ( $cmd eq 'models' ) {
    return get_available_models->();
} elsif ( $cmd eq 'check' ) {
    return check_llama_cli->();
} elsif ( $cmd eq 'test' ) {

    # Simple test to verify llama-cli works
    return query_subprocess->( 'qwen',
        'Hello, how are you? Answer briefly.' );
} else {
    return {
        success   => FALSE,
        error     => "Unknown subprocess command: $cmd",
        available => [ 'query', 'models', 'check', 'test' ]
    };
}

