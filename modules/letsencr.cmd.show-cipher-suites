## [:< ##

# name  = letsencr.cmd.show-cipher-suites
# descr = display configured HTTPS cipher suites

<[base.log]>->( 2, 'show-cipher-suites command requested' );

## Cipher suite definitions
my @suites = (
    {   name => 'ECDHE-ECDSA-CHACHA20-POLY1305',
        prio => 'PRIMARY',
        kex  => 'X25519',
        auth => 'Ed25519',
        enc  => 'ChaCha20-Poly1305',
        bits => '256-bit',
        note => 'Fast on non-AES-NI hardware'
    },
    {   name => 'ECDHE-ECDSA-AES256-GCM-SHA384',
        prio => 'FALLBACK',
        kex  => 'X25519',
        auth => 'Ed25519',
        enc  => 'AES-256-GCM',
        bits => '256-bit',
        note => 'Hardware accelerated'
    },
    {   name => 'ECDHE-ECDSA-AES128-GCM-SHA256',
        prio => 'FALLBACK',
        kex  => 'X25519',
        auth => 'Ed25519',
        enc  => 'AES-128-GCM',
        bits => '128-bit',
        note => 'Maximum compatibility'
    },
);

## Calculate column widths
my $max_name = max( map { length $_->{name} } @suites );
my $w_prefix = ':' . ' ' x ( $max_name + 35 );
my $wrap_len = 65;

## Build report
my $reply_str = ":\n";
$reply_str .= sprintf ":  %*s  :  %s\n", $max_name, 'CIPHER SUITE',
    'PRIORITY  KEY EX  AUTH     ENCRYPTION        BITS';
$reply_str .= sprintf ":  %s  :  %s\n", '-' x $max_name,
    '--------  ------  --------  ----------------  --------';

foreach my $suite (@suites) {
    $reply_str .= sprintf ":  %*s  :  %-8s  %-6s  %-8s  %-16s  %s\n",
        $max_name, $suite->{name},
        $suite->{prio}, $suite->{kex}, $suite->{auth},
        $suite->{enc}, $suite->{bits};
    $reply_str .= sprintf ":  %*s  :  %s\n", $max_name, '',
        <[base.wrap_text]>->(
        $w_prefix, $wrap_len, "Note: " . $suite->{note}
        );
}

$reply_str .= ":\n:\n";

## Configuration summary
$reply_str .= ":  CONFIGURATION\n:\n";
$reply_str .= sprintf ":   %-38s :  %s\n", "TLS Versions", "TLSv1.3, TLSv1.2";
$reply_str .= sprintf ":   %-38s :  %s\n", "Total Cipher Suites",
    scalar(@suites);
$reply_str .= sprintf ":   %-38s :  %s\n", "Key Exchange",
    "ECDHE (Curve25519)";
$reply_str .= sprintf ":   %-38s :  %s\n", "Server Certificate",
    "ECDSA (Ed25519)";
$reply_str .= sprintf ":   %-38s :  %s\n", "Forward Secrecy",
    "Perfect (ephemeral)";
$reply_str .= ":\n";

## Security properties
$reply_str .= ":  SECURITY PROPERTIES\n:\n";
$reply_str .= sprintf ":   %-38s :  %s\n", "RSA Dependencies",
    "NONE (removed entirely)";
$reply_str .= sprintf ":   %-38s :  %s\n", "Weak Algorithms",
    "Excluded (MD5, DES, RC4, 3DES)";
$reply_str .= sprintf ":   %-38s :  %s\n", "Selection Method",
    "Whitelist (explicit allow)";
$reply_str .= sprintf ":   %-38s :  %s\n", "CHACHA20 Optimization",
    "Non-AES-NI CPUs";
$reply_str .= sprintf ":   %-38s :  %s\n", "Certificate Algorithm",
    "Ed25519 ECDSA";
$reply_str .= ":\n";

## Implementation
$reply_str .= ":  IMPLEMENTATION\n:\n";
$reply_str .= sprintf ":   %-38s :  %s\n", "HTTPSD Config",
    "modules/httpsd.init_code (13-14)";
$reply_str .= sprintf ":   %-38s :  %s\n", "Zenka Config",
    "configuration/zenki/httpsd/start (18)";
$reply_str .= sprintf ":   %-38s :  %s\n", "Certificate Key Gen",
    "Ed25519 via openssl genpkey";
$reply_str .= sprintf ":   %-38s :  %s\n", "ACME Account Keys",
    "crypt.C25519 (Ed25519)";
$reply_str .= sprintf ":   %-38s :  %s\n", "Entropy Source",
    "Crypt::PRNG::Fortuna";
$reply_str .= ":\n";

return { 'mode' => qw| size |, 'data' => $reply_str };

