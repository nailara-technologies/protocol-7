# name  = letsencrypt.child.generate_account_key
# descr = Generate Ed25519 account key for ACME operations using existing C25519 infrastructure

use Crypt::Ed25519;
use MIME::Base64 qw(encode_base64url);
use Crypt::Misc  qw(encode_b32r);

<[base.log]>->(
    2, 'generating new Ed25519 account key for ACME (via C25519)'
);

my $start_time = time();

## Generate Ed25519 account key using existing Protocol-7 C25519 infrastructure
## This reuses proven code from modules/crypt.C25519.gen_keys and includes:
## - Harmonic key generation (AMOS7::Assert::Truth)
## - Memory locking (IO::AIO::aio_mlock)
## - Secure entropy (Crypt::PRNG::Fortuna)
my ( $ed_keypair, $key_name ) = <[crypt.C25519.gen_keys]>->(
    'acme-account-'
        . <[base.prng.chars-anum]>->(8),    # unique account key identifier
    <letsencrypt.admin.email>    # use admin email as derivation seed
);

<[base.log]>->(
    2,
    'Ed25519 account key generated in '
        . ( time() - $start_time )
        . ' seconds'
);

## Store keypair in child state
<letsencrypt.child.acme_client>->{account_key}      = $ed_keypair;
<letsencrypt.child.acme_client>->{account_key_type} = 'Ed25519';

## Save secret key to cache for persistence (as Base32r-encoded)
my $key_cache  = sprintf '%s/account.key', <letsencrypt.cache.dir>;
my $secret_b32 = encode_b32r( $ed_keypair->{secret} );
<[file.put]>->( $key_cache, $secret_b32, qw| :raw | );
chmod( 0600, $key_cache );

<[base.log]>->(
    2, "Ed25519 account key saved to $key_cache (Base32r encoded)"
);

## Return keypair for later use
return $ed_keypair;

