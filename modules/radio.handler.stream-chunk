## [:< ##

# name  = radio.handler.stream-chunk
# descr = IO read handler for TCP stream : parse ICY headers, extract audio
#         and metadata, relay audio to registered listeners

my $event   = shift->w;
my $read_fh = $event->fd;

my $icy = <radio.stream.icy>;

my $read_buf = '';
my $read_len = sysread( $read_fh, $read_buf, 65536 );

<[base.logs]>->(
    2,
    '[radio] chunk: read=%s listeners=%d headers_done=%d',
    defined $read_len ? $read_len : 'undef',
    scalar <radio.listeners>->@*,
    <radio.stream.icy>->{'headers_done'}
) if defined $read_len and $read_len > 0;

if ( not defined $read_len ) {

    ##  undef: EAGAIN / SSL_WANT_READ — wait for next watcher fire  ##
    my $os_err = $OS_ERROR + 0;
    if ( $os_err == Errno::EAGAIN() or $os_err == Errno::EWOULDBLOCK() ) {
        return;
    }

    ##  real read error  ##
    <[base.logs]>->(
        1,         '[radio] sysread error: %s [errno=%d]',
        $OS_ERROR, $os_err
    );
}

if ( not defined $read_len or $read_len == 0 ) {

    ##  connection closed or error  ##

    ##  preserve the httpd relay connection state  ##
    my $httpd_relay_active
        = ( defined <radio.httpd.sock> and length <radio.httpd.sock> );

    $event->cancel;
    if ( defined <radio.stream.sock> ) {
        close( delete <radio.stream.sock> );
        <[base.logs]>->( 1, '[radio] stream disconnected' );

        my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
        <[base.buffer.add_line]>->(
            qw| radio-stream |,
            join( ' ', $time_stamp, 1, 'stream disconnected' ), 1
        );
    }
    delete <radio.stream.io_watcher>;

    ##  reset icy state for next connect  ##
    $icy->{'headers_done'}  = 0;
    $icy->{'header_buf'}    = '';
    $icy->{'meta_expected'} = 0;
    $icy->{'meta_buf'}      = '';

    ##  schedule reconnect with backoff  ##
    <[radio.handler.reconnect]>;

    return;
}

my $buf = $read_buf;

##  header parse phase  ##

if ( not $icy->{'headers_done'} ) {

    $icy->{'header_buf'} .= $buf;

    if ( $icy->{'header_buf'} =~ s/^(.*?)(?:\r\n\r\n|\n\n)//s ) {

        my $headers = $1;
        my $metaint = 8192;

        if ( $headers =~ /icy-metaint:\s*(\d+)/i ) {
            $metaint = 0 + $1;
        }

        $icy->{'metaint'}       = $metaint;
        $icy->{'bytes_to_meta'} = $metaint;
        $icy->{'headers_done'}  = 1;

        <[base.logs]>->( 2, '[radio] connected, metaint=%d', $metaint );

        $buf = $icy->{'header_buf'};
        $icy->{'header_buf'} = '';

    } else {
        return;    ##  wait for more header data  ##
    }
}

##  audio + metadata parse phase  ##

my $offset  = 0;
my $buf_len = length($buf);

while ( $offset < $buf_len ) {

    if ( $icy->{'meta_expected'} > 0 ) {

        my $need  = $icy->{'meta_expected'} - length( $icy->{'meta_buf'} );
        my $avail = $buf_len - $offset;
        my $take  = $need < $avail ? $need : $avail;

        $icy->{'meta_buf'} .= substr( $buf, $offset, $take );
        $offset += $take;

        if ( length( $icy->{'meta_buf'} ) >= $icy->{'meta_expected'} ) {

            my $meta_str = $icy->{'meta_buf'};
            $meta_str =~ s/\0+$//;

            if ( $meta_str =~ /StreamTitle='([^']*)'/ ) {
                my $new_title = $1;
                if ( $new_title ne $icy->{'current_title'} ) {

                    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
                    my $prev_title = $icy->{'current_title'} // '';

                    ##  finalize outgoing track  ##
                    if ( defined $icy->{'track_started'} ) {
                        $icy->{'track_duration'}
                            = <[base.time]>->(3) - $icy->{'track_started'};
                        if ( length $prev_title ) {
                            <[base.buffer.add_line]>->(
                                qw| radio-jingle |,
                                join(
                                    ' ',
                                    $time_stamp,
                                    2,
                                    sprintf(
                                        'duration :. %.0fs [ %s ]',
                                        $icy->{'track_duration'}, $prev_title
                                    )
                                ),
                                2
                            );
                        }
                        if ( $icy->{'track_duration'}
                            < ( <radio.jingle.min_track_seconds> // 90 ) ) {
                            <[base.logs]>->(
                                2,
                                '[radio] short track %.0fs'
                                    . ' — likely jingle [ %s ]',
                                $icy->{'track_duration'},
                                $prev_title
                            );
                            if ( not $icy->{'is_jingle'} ) {
                                <[base.logs]>->(
                                    2,
                                    '[radio] short track %.0fs'
                                        . ' confirmed as jingle post-hoc',
                                    $icy->{'track_duration'}
                                );
                                <[radio.gap_fill.start]>
                                    if not <radio.gap_fill.active>;
                                $icy->{'is_jingle'} = 'duration';
                                <[base.buffer.add_line]>->(
                                    qw| radio-jingle |,
                                    join( ' ',
                                        $time_stamp, 1,
                                        'verdict :. jingle [ duration ]' ),
                                    1
                                );
                            }
                        }
                    }

                    ##  close and finalize rip if open  ##
                    if ( defined $icy->{'rip_fh'} ) {
                        CORE::close( delete $icy->{'rip_fh'} );
                        <[base.logs]>->(
                            2, '[radio] saved: %s [ %d bytes ]',
                            $icy->{'rip_path'}, $icy->{'rip_bytes'}
                        );
                        if ( $icy->{'track_duration'}
                            < ( <radio.jingle.min_track_seconds> // 90 ) ) {
                            unlink( $icy->{'rip_path'} );
                            <[base.logs]>->(
                                2, '[radio] discarded short rip [ jingle ]'
                            );
                        }
                        delete $icy->{'rip_path'};
                        $icy->{'rip_bytes'} = 0;
                    }

                    ##  reset state for incoming track  ##
                    $icy->{'current_title'} = $new_title;
                    $icy->{'track_started'} = <[base.time]>->(3);
                    $icy->{'keep_flagged'}  = 0;

                    <[base.buffer.add_line]>->(
                        qw| radio-jingle |,
                        join( ' ', $time_stamp, 2, "title :. $new_title" ), 2
                    );

                    ##  jingle detection  ##
                    my $jingle_result = <[radio.filter.jingle]>->($new_title);
                    $icy->{'is_jingle'} = $jingle_result;

                    if ($jingle_result) {
                        <[base.logs]>->(
                            2, '[radio] jingle detected: %s', $new_title
                        );
                        <[radio.gap_fill.start]>
                            if not <radio.gap_fill.active>;

                        <[base.buffer.add_line]>->(
                            qw| radio-jingle |,
                            join( ' ',
                                $time_stamp, 1,
                                "verdict :. jingle [ $jingle_result ]" ),
                            1
                        );

                        ##  fade audio-0 down during jingle  ##
                        if (<radio.audio.active>) {
                            <[protocol-7.route-send]>->(
                                {   'command'   => 'mpv[audio-0].fade',
                                    'call_args' => { 'args' => '0' },
                                }
                            );
                            <[base.logs]>->(
                                2, '[radio.audio] jingle: fading down'
                            );
                        }
                    } else {
                        <[base.logs]>->(
                            2, '[radio] now playing: %s', $new_title
                        );

                        <[base.buffer.add_line]>->(
                            qw| radio-jingle |,
                            join( ' ', $time_stamp, 1, 'verdict :. music' ), 1
                        );

                        ##  fade audio-0 back up on real track  ##
                        if (<radio.audio.active>) {
                            my $vol = <radio.audio.current_vol>
                                // <radio.audio.start_volume> // 70;
                            <[protocol-7.route-send]>->(
                                {   'command'   => 'mpv[audio-0].fade',
                                    'call_args' => { 'args' => $vol },
                                }
                            );
                            <[base.logs]>->(
                                2, '[radio.audio] track: fading up to %d%%',
                                $vol
                            );
                        }
                    }
                }
            }

            $icy->{'meta_buf'}      = '';
            $icy->{'meta_expected'} = 0;
        }

    } else {

        my $avail = $buf_len - $offset;
        my $take
            = $icy->{'bytes_to_meta'} < $avail
            ? $icy->{'bytes_to_meta'}
            : $avail;

        if ( $take > 0 ) {
            my $audio_chunk = substr( $buf, $offset, $take );

            ##  write to rip file if active  ##
            if ( defined $icy->{'rip_fh'} ) {
                syswrite( $icy->{'rip_fh'}, $audio_chunk );
                $icy->{'rip_bytes'} += length($audio_chunk);
            }

            ##  relay to listeners [ jingle gate ]  ##
            if ( not $icy->{'is_jingle'} ) {
                my $before = scalar <radio.listeners>->@*;
                my @keep;
                for my $h ( <radio.listeners>->@* ) {
                    push @keep, $h
                        if <[base.stream.push]>->( $h, \$audio_chunk );
                }
                my $after = scalar @keep;
                if ( $after < $before ) {
                    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
                    <[base.buffer.add_line]>->(
                        qw| radio-stream |,
                        join( ' ',
                            $time_stamp, 2, "listener removed :. $after" ),
                        2
                    );
                }
                <radio.listeners> = \@keep;
            }

            $offset += $take;
            $icy->{'bytes_to_meta'} -= $take;
        }

        if ( $icy->{'bytes_to_meta'} == 0 and $offset < $buf_len ) {

            my $meta_len_byte = ord( substr( $buf, $offset, 1 ) );
            $offset++;

            $icy->{'meta_expected'} = $meta_len_byte * 16;
            $icy->{'bytes_to_meta'} = $icy->{'metaint'};

            ##  meta_expected == 0 : no metadata this interval  ##
        }
    }
}

return;

