    # name  = memory.tree.score.focus_matches_stub
    # descr = fallback focus match when memory.focus.matches is absent

    my ( $node, $topic ) = @_;
    return 0 if not length $topic;
    my $text = join ' ',
        grep {defined} (
        $node->{'title'}      // '',
        $node->{'body'}       // '',
        $node->{'source_ref'} // '',
        );
    return index( lc($text), lc($topic) ) >= 0 ? 1 : 0;

