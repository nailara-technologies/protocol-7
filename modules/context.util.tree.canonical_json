# name  = context.util.tree.canonical_json
# descr = deterministic JSON encoding for checksum stability [ recursive ]

my $val = shift;

return '{}' unless defined $val;

if ( ref($val) eq qw| HASH | ) {
    my @pairs;
    for my $key ( sort keys $val->%* ) {
        push @pairs,
              '"'
            . $key . '":'
            . <[context.util.tree.canonical_json]>->( $val->{$key} );
    }
    return '{' . join( ',', @pairs ) . '}';
} elsif ( ref($val) eq qw| ARRAY | ) {
    return '['
        . join( ',',
        map { <[context.util.tree.canonical_json]>->($ARG) } $val->@* ) . ']';
} elsif ( defined $val ) {
    $val =~ s|"|\\"|g;
    return '"' . $val . '"';
} else {
    return 'null';
}

