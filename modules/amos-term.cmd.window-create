# name  = amos-term.cmd.window-create
# descr = Create new 3D terminal window

my ( $client_name, $geometry ) = @ARG;

$client_name //= 'term-' . <[base.time]>->(2);
$geometry    //= '640x480';

my ( $session_id, $amos_id ) = <[amos-term.window-create]>->(
    {   qw| client_name | => $client_name,
        qw| geometry |    => $geometry
    }
);

return "Error: window creation failed\n" unless defined $session_id;

return sprintf( "Window created\nAMOS ID: %s\nSession: %d\nName: %s\n",
    $amos_id, $session_id, $client_name );

