## [:< ##

# name  = credential_fabric.key_holder.parent
# descr = parent-side dispatcher to the key-holder child process.
#         call with ('start') to fork child, or ('ENCRYPT'|'DECRYPT'|'SIGN',
#         $slot, $data) to perform an operation.

my $op   = shift // '';
my $slot = shift // '';
my $data = shift // '';

## start / ensure child is running ##
if ( $op eq qw| start | ) {
    return _start_child();
}

my $pipe = <credential_fabric.key_holder.pipe>;
my $pid  = <credential_fabric.key_holder.pid>;

## verify child is alive ##
if ( defined $pid and $pid > 0 ) {
    my $alive = kill( 0, $pid );
    if ( not $alive ) {
        undef $pipe;
        <credential_fabric.key_holder.pipe> = undef;
        <credential_fabric.key_holder.pid>  = undef;
    }
}

## restart if needed ##
if ( not defined $pipe or not defined $pid ) {
    my $ok = _start_child();
    return undef if not $ok;
    $pipe = <credential_fabric.key_holder.pipe>;
}

## encode arguments ##
my $slot_b32 = encode_b32r($slot);
my $data_b32 = encode_b32r($data);

## send request ##
my $req_line = sprintf( "%s %s %s\n", $op, $slot_b32, $data_b32 );
my $written  = syswrite( $pipe, $req_line );
if ( not defined $written or $written != length($req_line) ) {
    <[base.s_warn]>->('key_holder.parent: failed to write to child pipe');
    return undef;
}

## read response with timeout (non-blocking via select) ##
my $response;
my $buf     = '';
my $start   = <[base.time]>->(1);
my $timeout = 7;

while ( ( <[base.time]>->(1) - $start ) < $timeout ) {
    my $rin = '';
    vec( $rin, fileno($pipe), 1 ) = 1;
    my $nfound = select( $rin, undef, undef, 0.05 );
    next if not defined $nfound or $nfound <= 0;

    my $n = sysread( $pipe, $buf, 65536, length($buf) );
    if ( defined $n and $n > 0 ) {
        if ( $buf =~ s|^(.+)\n||s ) {
            $response = $1;
            last;
        }
    } elsif ( defined $n and $n == 0 ) {
        last;    ## EOF ##
    }
}

if ( not defined $response ) {
    <[base.s_warn]>
        ->('key_holder.parent: timeout waiting for child response');
    return undef;
}

if ( $response =~ s|^OK\s+|| ) {
    return eval { decode_b32r($response) };
} else {
    $response =~ s|^ERR\s+||;
    <[base.s_warn]>->( 'key_holder.parent: child error: %s', $response );
    return undef;
}

##[  helper: fork child  ]####################################################

sub _start_child {
    socketpair(
        my $parent_pipe, my $child_pipe, AF_UNIX(),
        SOCK_STREAM(),   PF_UNSPEC()
        )
        || do {
        <[base.s_warn]>->( 'key_holder.parent: socketpair failed: %s', $! );
        return undef;
        };

    binmode($parent_pipe);
    binmode($child_pipe);

    my $pid = <[base.fork]>;
    if ( not defined $pid ) {
        <[base.s_warn]>->( 'key_holder.parent: fork failed: %s', $! );
        return undef;
    }

    if ( $pid == 0 ) {    ## child ##
        close($parent_pipe);
        <[credential_fabric.key_holder.child]>->($child_pipe);
        exit(0);
    }

    ## parent ##
    close($child_pipe);
    <credential_fabric.key_holder.pid>  = $pid;
    <credential_fabric.key_holder.pipe> = $parent_pipe;

    <[base.logs]>->( 1, 'key_holder.child forked (pid %d)', $pid );

    return TRUE;
}

