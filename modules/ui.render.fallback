## [:< ##

# name  = ui.render.fallback
# descr = generic rendering of an address as foldable children
# param = { address, slot_budget }

my $address     = $ARG[0]->{'address'} // '';
my $fields      = $ARG[0]->{'fields'};
my $slot_budget = $ARG[0]->{'slot_budget'} // {};

return '' if not length $address;

my $budget_cols = $slot_budget->{'cols'} // 80;

## [ new path ] map-driven rendering
if ( defined $fields and ref $fields eq 'HASH' ) {
    my @lines;

    for my $field_name ( sort keys %$fields ) {
        my $field = $fields->{$field_name};
        next if ref $field ne 'HASH';

        my $value_spec = $field->{'value'};
        my $value      = '';

        if ( ref $value_spec eq 'CODE' ) {
            $value = eval { $value_spec->() } // '';
        } elsif ( defined $value_spec and length $value_spec ) {
            ##  string address — render leaf via tree renderer  ##
            $value = eval {
                <[ui.render.tree]>->(
                    {   'address'     => $value_spec,
                        'slot_budget' => $slot_budget
                    }
                );
            } // '';
        }

        ##  label and wrap  ##
        my $label = "$field_name: $value";
        if ( length $label > $budget_cols ) {
            $label = substr( $label, 0, $budget_cols - 3 ) . '...';
        }
        push @lines, $label;
    }

    return join "\n", @lines;
}

## [ deprecated ] legacy address-driven path
return eval {
    <[ui.render.tree]>->(
        {   'address'     => $address,
            'slot_budget' => $slot_budget
        }
    );
} // '';

