## [:< ##

# name = base.s_read
# descr = utf8 safe non-blocking sysread for sockets and pipes
# note = use base.s_read.file_io for file handle reads [ IO::AIO with offset ]
# note = buffer parameter expects passing by reference

my $read_fh    = $ARG[0];
my $buffer_ref = $ARG[1];
my $read_len   = $ARG[2];

warn 'filehandle not defined <{C1}>' and return undef if not defined $read_fh;
warn 'buffer ref not present <{C1}>' and return undef
    if ref $buffer_ref ne qw| SCALAR |;

## no more dataoffset parameter because of UTF-8 decoding ##

my $r_buff;
my $b_read = sysread( $read_fh, $r_buff, $read_len );

## non-blocking : return 0 on would-block ##
return 0
    if not defined $b_read
    and ( $OS_ERROR{EAGAIN} or $OS_ERROR{EWOULDBLOCK} );

return -1 if not defined $b_read;    ## [ error ] ##

if ( $b_read > 0 ) {
    ## downgrade UTF-8 flag to prevent double-encoding when sending via ##
    ## sockets                                                          ##
    if ( utf8::is_utf8($r_buff) ) {
        utf8::downgrade( $r_buff, 0 );   ## 0 = non-fatal, strip UTF-8 flag ##
    }
    $b_read = length($r_buff);           ##  adjust for decoding  ##
    $$buffer_ref .= $r_buff;
}

return $b_read;                          ## [ returns -1 on error ] ##

