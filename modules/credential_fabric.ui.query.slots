## [:< ##

# name  = credential_fabric.ui.query.slots
# descr = return the full slot registry as a list of structured entries

my $registry   = <credential_fabric.registry> // {};
my @slot_names = sort keys %$registry;

my @entries;
for my $name (@slot_names) {
    my $meta = $registry->{$name};
    push @entries,
        {
        'slot'        => $name,
        'owner'       => $meta->{'owner'}       // qw| credential_fabric |,
        'type'        => $meta->{'type'}        // qw| api-key |,
        'sensitivity' => $meta->{'sensitivity'} // qw| low |,
        'storage'     => $meta->{'storage'}     // qw| local |,
        };
}

return { 'slots' => \@entries };

