## [:< ##

# name  = tile.handler.screen-change
# descr = receive X-11 screen-change event; placeholder for layout reaction

my $params = shift             // {};
my $args   = $params->{'args'} // {};

my $event = eval { YAML::XS::Load( $args->{'data'} // '' ) } // {};
my $w     = $event->{'width'}                                // 0;
my $h     = $event->{'height'}                               // 0;

<[base.logs]>->( 1, '[screen-change] %dx%d', $w, $h );

## LLL: trigger layout recalculation or tile-profile selection when needed ##

return { 'mode' => qw| true |, 'data' => 'ok' };

