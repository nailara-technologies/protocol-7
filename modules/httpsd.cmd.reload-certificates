# name = httpsd.cmd.reload-certificates
# descr = reload TLS certificates from configured cert path
# note  = called by letsencr after installing new certificate

return { 'mode' => qw| false |, 'data' => 'certificate reload failed' }
    unless <[httpsd.reload_certificates]>;

return { 'mode' => qw| true |, 'data' => 'certificates reloaded' };

