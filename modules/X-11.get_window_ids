# name  = X-11.get_window_ids

my $X       = <X-11.obj>;
my $display = <X-11.xlib.display>;
my $root    = <X-11.obj>->root;

state $client_list //= $X->InternAtom( qw| _NET_CLIENT_LIST |, 1 );
state $wmname      //= $X->atom( qw| WM_NAME |, 1 );
state $type_utf8   //= $X->InternAtom( qw| UTF8_STRING |, 1 );

<[X-11.WM.update]>;

my @window_ids;

## InternAtom( ..., 1 ) [ only-if-exists ] returns 0 [ None ] when no   ##
## client has created the atom yet [ eg. a freshly started display,    ##
## before any window manager has run ] -- querying property 0 is a     ##
## protocol error [ BadAtom ], not simply an empty/missing property    ##
##                                                                       ##
## ListProperties only needs a valid window [ $root is never invalid ], ##
## no atom is passed in, so it cannot itself raise BadAtom -- check     ##
## $client_list is actually SET on $root before ever using it in a     ##
## GetProperty call, instead of catching the protocol error after the  ##
## fact [ such errors have been seen to disrupt the X11 connection ]   ##
if ( $client_list and $client_list ne qw| None | ) {
    my @root_properties
        = eval { <[X-11.pool.query]>->( 'ListProperties', $root ) };
    if ( not $EVAL_ERROR and grep { $_ eq $client_list } @root_properties ) {
        eval {
            my ( $value, $type, $format, $bytes_after )
                = <[X-11.pool.query]>->(
                'GetProperty',     $root, $client_list,
                'AnyPropertyType', 0,     -1, 0
                );
            @window_ids = unpack( qw| L* |, $value );
        };

        warn <[base.str.eval_error]> if length $EVAL_ERROR;
    }
}

## [ fall back to WM registry when _NET_CLIENT_LIST is empty ] ##
@window_ids = map { $_->id } <X-11.WM>->sorted->@* if not @window_ids;

return sort { $a <=> $b } @window_ids;

