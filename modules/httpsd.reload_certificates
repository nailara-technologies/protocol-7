## [:< ##

# name = httpsd.reload_certificates
# descr = reload TLS certificates in HTTPSD when Let's Encrypt updates them

<[base.log]>->( 2, 'HTTPSD: reloading TLS certificates' );

## discover active certificate from /etc/protocol-7/certs/
my $cert_info = <[httpsd.discover_active_certificate]>;

unless ($cert_info) {
    <[base.log]>->( 1, 'error: failed to discover active certificate' );
    return FALSE;
}

my $cert_path = $cert_info->{cert_path};
my $key_path  = $cert_info->{key_path};

## verify discovered certificates exist
unless ( -f $cert_path && -f $key_path ) {
    <[base.log]>->(
        1, 'error: certificate or key file not found or not readable'
    );
    return FALSE;
}

## update config paths to point to discovered certificate files
<httpsd.cfg.certificate_path> = $cert_path;
<httpsd.cfg.key_path>         = $key_path;

## update certificate cache in HTTPSD state
delete <httpsd.cert_cache> if exists <httpsd.cert_cache>;

<httpsd.cert_cache> = {
    cert_path => $cert_path,
    key_path  => $key_path,
    loaded_at => time(),
};

<[base.logs]>->( 2, 'HTTPSD: certificate updated [ %s ]', $cert_path );

## ssl socket must be re-bound as root on port 443 - request restart
## [ httpsd drops privileges before zenka.loop - restart runs post_init again ]
<[base.log]>->( 1, 'httpsd: requesting self-restart to activate new cert' );
<[httpsd.self_restart]>;

return TRUE;

