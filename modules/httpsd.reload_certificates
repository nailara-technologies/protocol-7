## [:< ##

# name = httpsd.reload_certificates
# descr = reload TLS certificates in HTTPSD when Let's Encrypt updates them

<[base.log]>->( 2, 'HTTPSD: reloading TLS certificates' );

## discover active certificate from /etc/protocol-7/certs/
my $cert_info = <[httpsd.discover_active_certificate]>;

unless ($cert_info) {
    <[base.log]>->( 1, 'error: failed to discover active certificate' );
    return FALSE;
}

my $cert_dir = $cert_info->{cert_path};
my $key_dir  = $cert_info->{key_path};

## verify discovered certificates exist
unless ( -f $cert_dir && -f $key_dir ) {
    <[base.log]>->(
        1, 'error: certificate or key file not found or not readable'
    );
    return FALSE;
}

## update config paths to point to discovered certificate files
<httpsd.cfg.certificate_path> = $cert_dir;
<httpsd.cfg.key_path>         = $key_dir;

## update certificate cache in HTTPSD state
delete <httpsd.cert_cache> if exists <httpsd.cert_cache>;

## Load new certificates
<[file.slurp]>->( $cert_dir, \my $cert_pem, qw| :raw | );
<[file.slurp]>->( $key_dir,  \my $key_pem,  qw| :raw | );

<httpsd.cert_cache> = {
    cert_path => $cert_dir,
    key_path  => $key_dir,
    cert_pem  => $cert_pem,
    key_pem   => $key_pem,
    loaded_at => time(),
};

<[base.log]>->( 2, 'HTTPSD: certificates reloaded successfully' );

## Optional: Perform graceful reload
## This would close and reopen the TLS socket,
## or signal child processes to do so
# <[httpsd.graceful_reload]>;

return TRUE;

