## [:< ##

# name  = letsencr.child.create_jws
# descr = create JSON Web Signature (JWS) for ACME requests (RS256 or EdDSA signing)

my $payload = shift;  # hashref or JSON string
my $nonce   = shift;
my $kid     = shift;  # Key ID (optional, for account requests use thumbprint)

return undef unless defined $nonce;

## determine algorithm based on account key type
my $key_type  = <letsencr.child.acme_client>->{account_key_type} // 'Ed25519';
my $algorithm = ( $key_type eq 'RSA' ) ? 'RS256' : 'EdDSA';

<[base.log]>->( 3, "creating JWS for ACME request ($algorithm)" );

## Ensure we have payload as string
my $payload_json = ref($payload) ? JSON::XS::encode_json($payload) : $payload;

## URL-safe base64 encode payload
my $payload_b64 = encode_base64url($payload_json);

## create JOSE header with appropriate algorithm
## [ RS256 for RSA keys, EdDSA for Ed25519 keys ]
my $header = {
    alg   => $algorithm,
    nonce => $nonce,
};

## Add either 'kid' (Key ID) or 'jwk' (public key)
if ( defined $kid ) {
    $header->{kid} = $kid;
} else {
    ## Include public key for account creation (RFC 8037 format)
    $header->{jwk} = <[letsencr.child.get_jwk]>;
}

my $header_json = JSON::XS::encode_json($header);
my $header_b64  = encode_base64url($header_json);

## Create signing input: header.payload
my $signing_input = $header_b64 . '.' . $payload_b64;

## sign with account key (RSA or Ed25519)
my $account_key_name = <letsencr.child.acme_client>->{account_key_name};
unless ($account_key_name) {
    <[base.log]>->(
        1, 'error: account key name not properly initialized for signing'
    );
    return undef;
}

<[base.logs]>->(
    3,                 "signing JWS with account key: %s [ %s ]",
    $account_key_name, $algorithm
);

## route signing to appropriate function based on algorithm
my $signature;
if ( $key_type eq 'RSA' ) {
    $signature = <[letsencr.child.sign_rsa_data]>->(
        \$signing_input, $account_key_name
    );
} else {
    ## fallback to Ed25519 signing
    $signature
        = <[crypt.C25519.sign_data]>->( \$signing_input, $account_key_name );
}

## URL-safe base64 encode signature
my $signature_b64 = encode_base64url($signature);

## Return complete JWS (same structure as RSA JWS)
return {
    protected => $header_b64,
    payload   => $payload_b64,
    signature => $signature_b64,
};

