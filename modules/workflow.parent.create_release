# name = workflow.parent.create_release
# descr = create a new release (version tag, README update, signature)

my $params = shift || {};

my $version = $params->{version};    ## e.g., "3.11.10" or "AMOS7-v3.11.10"
my $message = $params->{message} // "Release $version";
my $dry_run = $params->{dry_run} // 1;

unless ($version) {
    return {
        success => FALSE,
        error   => 'version number required'
    };
}

## Normalize version format
$version =~ s|^AMOS7-v||;            ## Remove prefix if present
$version =~ s|^v||;                  ## Remove v prefix if present

unless ( $version =~ /^\d+\.\d+\.\d+$/ ) {
    return {
        success => FALSE,
        error   => "invalid version format: $version (expected X.Y.Z)"
    };
}

my $tag_name = "AMOS7-v$version";

<[base.log]>->( 2, "workflow.release: creating release $tag_name..." );

## Check if version already exists
my $git_bin = <workflow.cfg.git_binary> || 'git';
my $repo    = <git.cfg.repository_path>;

my $existing_tags = `cd $repo && $git_bin tag -l '$tag_name' 2>&1`;

if ( $existing_tags =~ /\Q$tag_name\E/ ) {
    return {
        success => FALSE,
        error   => "version $tag_name already exists as git tag"
    };
}

## Get current git HEAD
my $head_sha = `cd $repo && $git_bin rev-parse HEAD 2>&1`;
chomp($head_sha);

<[base.log]>->( 2, "  Current HEAD: " . substr( $head_sha, 0, 8 ) );

if ($dry_run) {
    <[base.log]>->( 2, "  DRY RUN - would perform:" );
    <[base.log]>->( 2, "    1. Update README.md with version $version" );
    <[base.log]>->( 2, "    2. Update source-code-versions.md" );
    <[base.log]>->( 2, "    3. Commit changes" );
    <[base.log]>->( 2, "    4. Create tag $tag_name" );
    <[base.log]>->( 2, "    5. Sign with AMOS7 signature" );

    return {
        success  => TRUE,
        dry_run  => 1,
        version  => $version,
        tag_name => $tag_name,
        head_sha => $head_sha
    };
}

