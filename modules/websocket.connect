## [:< ##

# name  = websocket.connect
# descr = establish a websocket connection via http upgrade handshake
# param = $url  [ ws://host:port/path ]
# return = IO::Socket::INET handle (non-blocking) or undef on failure

my $url = shift // return undef;

## parse ws://host:port/path
my ( $host, $port, $path );
if ( $url =~ m{^ws://([^/:]+)(?::(\d+))?(/.*)? $}x ) {
    $host = $1;
    $port = $2 // 80;
    $path = $3 // '/';
} else {
    <[base.logs]>->( 0, 'websocket.connect: invalid url [ %s ]', $url );
    return undef;
}

## tcp connect
my $sock = IO::Socket::INET->new(
    PeerAddr => $host,
    PeerPort => $port,
    Proto    => qw| tcp |,
    Timeout  => <websocket.connect_timeout>
);

if ( not defined $sock ) {
    <[base.logs]>->(
        0, 'websocket.connect: tcp connect failed : %s:%d : %s',
        $host, $port, $OS_ERROR
    );
    return undef;
}

## set receive timeout for handshake reads [ Socket::SO_RCVTIMEO ]
my $hs_timeout = <websocket.connect_timeout> // 5;
my $timeval    = pack( 'l!l!', $hs_timeout, 0 );     ## { tv_sec, tv_usec }
$sock->sockopt( Socket::SO_RCVTIMEO, $timeval );

## http upgrade handshake
my $handshake = Protocol::WebSocket::Handshake::Client->new(
    url => sprintf( 'ws://%s:%d%s', $host, $port, $path ) );

## send upgrade request
my $req_str = $handshake->to_string;
$sock->syswrite($req_str) or do {
    <[base.logs]>->( 0, 'websocket.connect: failed to send upgrade request' );
    $sock->close;
    return undef;
};

## read server response until handshake is complete
while ( not $handshake->is_done ) {
    my $chunk = '';
    my $n     = sysread( $sock, $chunk, 4096 );
    if ( not defined $n ) {
        if ( $! == Errno::EAGAIN || $! == Errno::EWOULDBLOCK ) {
            <[base.logs]>->(
                0, 'websocket.connect: handshake read timeout [ %ds ]',
                $hs_timeout
            );
        } else {
            <[base.logs]>->(
                0, 'websocket.connect: handshake read error : %s', $OS_ERROR
            );
        }
        $sock->close;
        return undef;
    }
    if ( $n == 0 ) {
        <[base.logs]>->(
            0, 'websocket.connect: connection closed during handshake'
        );
        $sock->close;
        return undef;
    }
    $handshake->parse($chunk);
    if ( $handshake->error ) {
        <[base.logs]>->(
            0, 'websocket.connect: handshake error : %s',
            $handshake->error
        );
        $sock->close;
        return undef;
    }
}

## clear receive timeout and set non-blocking before handing to event loop
$sock->sockopt( Socket::SO_RCVTIMEO, pack( 'l!l!', 0, 0 ) );
$sock->blocking(0);

<[base.logs]>->(
    2, 'websocket.connect: connected [ ws://%s:%d%s ]',
    $host, $port, $path
);

return $sock;

