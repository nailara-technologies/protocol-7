# name  = pager.util.editor.get_item_at_line
# descr = Get item at specific line number from pager buffer

my ( $buf, $line_num ) = @ARG;

my $page_size = $buf->{'pages'}{'size'};
my $page_num  = int( $line_num / $page_size );
my $offset    = $line_num % $page_size;

my $page = <[pager.buffer.page.get]>->( $buf, $page_num );
return undef unless $page && @$page > $offset;

return $page->[$offset];

