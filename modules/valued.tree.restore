## [:< ##

# name  = valued.tree.restore
# descr = load persisted valued tree from yaml into live index

<[format.yaml.pre_init]>;

my $content = <[file.zenka_dir.load]>->('valued-tree.yaml');

return FALSE unless defined $content and length $content;

my $snapshot = <[format.yaml.load_str]>->($content);
if ( not defined $snapshot or ref $snapshot ne 'HASH' ) {
    <[base.logs]>->(
        0, 'valued.tree.restore: failed to parse valued-tree.yaml'
    );
    return FALSE;
}

my $restored = 0;
foreach my $id ( keys %{$snapshot} ) {
    <[valued.tree.register_node]>->( $snapshot->{$id} );
    $restored++;
}

<[base.logs]>->( 1, 'valued.tree.restore: restored %d nodes', $restored );

return $restored;

