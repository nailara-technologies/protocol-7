# name  = coding.handler.switch_model_reply
# descr = Handle model path reply and execute server restart for switch-model

my $reply        = shift;
my $reply_data   = $reply->{'data'}   // '';
my $reply_params = $reply->{'params'} // {};

## request identity travels with THIS reply via 'params' - not shared ##
## globals, see coding.cmd.switch-model for why [ race condition fix, ##
## confirmed live 2026-06-21 ]                                        ##
my $checksum = $reply_params->{'checksum'};
unless ( defined $checksum ) {
    <[base.logs]>->( 1, "[switch_model_reply] no pending switch request" );
    delete <coding.switch_model_active>;
    return FALSE;
}

## Parse YAML reply from models zenka ##
my $entry = eval { YAML::XS::Load($reply_data) };
if ( $@ || !ref $entry ) {
    <[base.logs]>
        ->( 0, "[switch_model_reply] failed to parse reply: %s", $@ );
    delete <coding.switch_model_active>;
    return FALSE;
}

my $model_path  = $entry->{'file_path'}   // '';
my $mmproj_path = $entry->{'mmproj_path'} // '';

unless ( length $model_path && -f $model_path ) {
    <[base.logs]>->(
        0, "[switch_model_reply] model file not found or invalid: '%s'",
        $model_path
    );
    delete <coding.switch_model_active>;
    return FALSE;
}

my $name    = $reply_params->{'name'};
my $backend = $reply_params->{'backend'} // 'auto';

<[base.logs]>->(
    1,     "[switch_model_reply] switching to %s on %s",
    $name, $backend
);

## helper: update config for a backend that actually got a spawn attempt   ##
## covers 'auto' too [ previously only literal 'gpu'/'cpu'/'both' matched, ##
## so the default 'auto' mode never updated either field - confirmed live  ##
## 2026-06-21, alongside <inference.model.amos_id> never being updated at  ##
## all, which is what monitor_inference_startup/inference-status actually  ##
## label the running model from ]                                          ##
my $mark_backend_updated = sub {
    my ($b) = @_;
    if ( $b eq qw| gpu | ) {
        <inference.backend.gpu.model_id> = $checksum;
        <[base.logs]>->(
            2, "[switch_model_reply] updated GPU model to %s", $checksum
        );
    } elsif ( $b eq qw| cpu | ) {
        <inference.backend.cpu.model_id> = $checksum;
        <[base.logs]>->(
            2, "[switch_model_reply] updated CPU model to %s", $checksum
        );
    }
    ## generic "current model" label - monitor_inference_startup reads this ##
    ## for BOTH backends, regardless of which one actually switched         ##
    ## <inference.model.path> MUST be kept in sync here too - it's the only ##
    ## global coding.async_spawn_inference_servers reads for the actual -m  ##
    ## file path, used by every retry spawn [ e.g. the self- test cat-test  ##
    ## failure path in monitor_inference_startup ]. leaving it stale here [ ##
    ## only coding.handler.model_path_reply, the startup path, used to set  ##
    ## it ] meant a retry after a switch-model call paired the OLD model's  ##
    ## weights with the NEW mmproj_path - confirmed live 2026-07-21: a      ##
    ## switch to a vision model, then a cat-test retry, spawned the         ##
    ## original startup model's .gguf with the new model's mmproj, wedging  ##
    ## the whole zenka on a mismatched-embedding-space generation that      ##
    ## never terminated                                                     ##
    <inference.model.path>        = $model_path;
    <inference.model.amos_id>     = $checksum;
    <inference.model.mmproj_path> = $mmproj_path;
};

## use spawn_smart for memory-aware server restart  NOTE:                   ##
## $mark_backend_updated fires BEFORE each spawn_smart call, not after      ##
## success. spawn_smart's kill-old-server step opens a window where the gpu ##
## backend is briefly down; anything reacting to that gap (e.g.             ##
## coding.handler.await_resources's twin-handover watchdog) reads whatever  ##
## the config currently says. updating AFTER success leaves that window     ##
## pointed at the OLD model - confirmed live 2026-06-21: await_resources    ##
## fired during exactly this gap and respawned the OLD (stale-config)       ##
## model, racing against this function's own intended spawn. updating first ##
## closes the window to (at worst) the NEW target, never the old one.       ##
if ( $backend eq qw| auto | ) {
    ## try gpu first : fall back to cpu if gpu has insufficient resources ##
    $mark_backend_updated->('gpu');
    my $gpu_ok = <[coding.handler.spawn_smart]>->(
        {   'backend'     => qw| gpu |,
            'model_path'  => $model_path,
            'mmproj_path' => $mmproj_path,
            'force'       => 1,
        }
    );
    ## spawn_smart returns FALSE [ not TRUE ] when resources are ##
    ## insufficient                                              ##
    unless ($gpu_ok) {
        <[base.logs]>->(
            1, '[switch_model_reply] gpu unavailable, trying cpu'
        );
        $mark_backend_updated->('cpu');
        <[coding.handler.spawn_smart]>->(
            {   'backend'     => qw| cpu |,
                'model_path'  => $model_path,
                'mmproj_path' => $mmproj_path,
                'force'       => 1,
            }
        );
    }
} else {
    ## expand 'both' into separate gpu + cpu spawns ##
    my @backends = $backend eq qw| both | ? qw| gpu cpu | : ($backend);
    for my $b (@backends) {
        $mark_backend_updated->($b);
        <[coding.handler.spawn_smart]>->(
            {   'backend'     => $b,
                'model_path'  => $model_path,
                'mmproj_path' => $mmproj_path,
                'force'       => 1,
            }
        );
    }
}

delete <coding.switch_model_active>;
return TRUE;

