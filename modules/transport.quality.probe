## [:< ##

# name  = transport.quality.probe
# descr = active probe for a demoted transport (lightweight connect test)
# args  = $dest, $type, $entry_hashref

my ( $dest, $type, $entry ) = @ARG;

return 0 if not defined $dest or not defined $type;

my $handler = sprintf 'transport.handle.%s', $type;
if ( not exists $code{$handler} ) {
    <[base.logs]>->( 0, 'transport.quality.probe: no handler for %s', $type );
    return 0;
}

<[base.logs]>->(
    2,     'transport.quality.probe: probing %s for %s',
    $type, $dest
);

## try a lightweight connection ##
my $ctx = { 'session' => { 'destination' => $dest } };

my $on_handle = sub {
    my $handle = shift;
    if ( defined $handle ) {
        ## success: promote ##
        <[transport.promote]>->( $dest, $type );

        ## close probe handle unless it's a persistent socket we can reuse ##
        if ( ref $handle eq qw| HASH |
            and defined $handle->{'socket'} ) {
            eval { $handle->{'socket'}->close };
        }
        return;
    }

    ## probe failed: keep demoted, update quality ##
    <[transport.quality.measure]>->(
        $dest, $type,
        {   'success'   => FALSE,
            'loss_rate' => 1.0,
        }
    );
    return;
};

my %async_handlers = map { $_ => 1 } qw| quic-hysteria udt-tunnel |;
if ( $async_handlers{$type} ) {
    $code{$handler}->( $entry, $ctx, $on_handle );
} else {
    my $handle = $code{$handler}->( $entry, $ctx );
    $on_handle->($handle);
}

return 1;

