# name  = credential_fabric.subscribe_rotation
# descr = register a STRM rotation handler for a credential slot.
#         args: { slot => '...', handler => 'zenka.handler.name' }

my $params = shift;

return { 'mode' => qw| false |, 'data' => 'expected hashref' }
    if ref $params ne qw| HASH |;

my $slot    = $params->{'slot'}    // '';
my $handler = $params->{'handler'} // '';

return { 'mode' => qw| false |, 'data' => 'missing slot' }
    unless length $slot;
return { 'mode' => qw| false |, 'data' => 'missing handler' }
    unless length $handler;

## ensure slot exists ##
return {
    'mode' => qw| false |,
    'data' => "unknown slot '$slot'"
    }
    if not exists <credential_fabric.registry>->{$slot};

<credential_fabric.rotation_subscribers>->{$slot} //= [];

## avoid duplicate subscriptions ##
my $subs = <credential_fabric.rotation_subscribers>->{$slot};
return { 'mode' => qw| true |, 'data' => 'already subscribed' }
    if grep { $ARG eq $handler } @$subs;

push @$subs, $handler;

return { 'mode' => qw| true |, 'data' => 'subscribed' };

