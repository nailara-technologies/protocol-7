## [:< ##

# name = coding.task.intake
# descr = parse and ingest work requests from various sources
# purpose = Foundation layer: Accept, parse, and structure incoming work

# Parse command-line style strings into structured requests
my $parse_command_string = sub {   ## [LLL] extract into seperate subroutine!!
    my ($cmd) = @ARG;

# Simple command parsing: "type: description | constraints"
# Example: "code-generation: Create Whisper module | Protocol-7 compatible, cache results"

    if ( $cmd =~ m{^([\w-]+):\s*(.+?)(?:\s*\|\s*(.+))?$} ) {
        my ( $type, $desc, $constraints_str ) = ( $1, $2, $3 );

        my @constraints = ();
        if ($constraints_str) {
            @constraints = split( m{\s*,\s*}, $constraints_str );
        }

        return {
            type        => $type,
            description => $desc,
            constraints => \@constraints,
            source      => qw| console |
        };
    }

    # Fallback: treat entire string as description
    return {
        type        => qw| analysis |,
        source      => qw|  console |,
        description => $cmd
    };
};

# Validate task has required fields
my $validate_task = sub {
    my ($task) = @ARG;

    my @errors = ();

    push @errors, "Missing task.request.description"
        unless $task->{request}->{description};
    push @errors, "Missing task.type" unless $task->{type};

    return {
        valid  => scalar(@errors) == 0,
        errors => \@errors
    };
};

# Normalize task data (handle defaults, cleanup)
my $normalize_task = sub {
    my ($task) = @ARG;

    # Ensure all required fields exist with sensible defaults
    $task->{type}                = lc( $task->{type} // qw| analysis | );
    $task->{priority}            = $task->{request}->{priority} // qw|normal|;
    $task->{execution}->{status} = qw| pending |;

    # Normalize priority values
    if ( $task->{priority} !~ m{^(critical|high|normal|low)$} ) {
        $task->{priority} = qw| normal |;
    }

    return $task;
};

# Main task intake function
my $intake_work = sub {
    my ($request) = @ARG;

    # Support multiple input formats
    if ( ref($request) eq qw| HASH | ) {

        # Already structured as hash
        return $request if exists $request->{'id'};
    } elsif ( not length ref $request ) {

        # Plain string - parse as command
        $request = $parse_command_string->($request);
    } else {
        return {
            success => FALSE,
            error   => "Invalid request format: must be hash or string",
            input   => $request
        };
    }

    # Validate and structure the work request
    my $task = {
        id => $request->{id} // <[coding.helper.task_id_generator]>->(
            $request->{type}, $request->{'description'}
        ),
        type    => $request->{'type'}    // qw| analysis |,
        subtype => $request->{'subtype'} // '',
        source  => $request->{'source'}  // qw| api |,

        request => {
            description => $request->{'description'} // '',
            language    => $request->{'language'}    // qw| en |,
            target      => $request->{'target'}      // qw| auto |,
            constraints => ref( $request->{'constraints'} ) eq qw| ARRAY |
            ? $request->{'constraints'}
            : [],
            deadline => $request->{'deadline'} // qw| flexible |,
            priority => $request->{'priority'} // qw| normal |
        },

        analysis => {
            complexity       => undef,          # Will be calculated
            estimated_tokens => undef,          # Will be estimated
            routed_to        => undef,          # Will be decided
            fallback         => undef,          # Will be determined
            cache_priority   => qw| normal |,
            success_history  => { similar_tasks => 0, success_rate => 0 }
        },

        execution => {
            status      => qw| pending |,
            started     => undef,
            completed   => undef,
            model_used  => undef,
            tokens_used => 0,
            result      => undef,
            success     => undef,
            error       => undef
        },

        learning => {
            approach_effectiveness => undef,
            should_cache           => TRUE,
            pattern_id             => undef,
            next_improvement       => undef
        },

        metadata => {
            ingested_at => <[base.time]>->(3),
            ingested_by => $request->{'source'} // qw| unknown |,
            raw_request => $request
        }
    };

    return {
        success => TRUE,
        task    => $task,
        message => sprintf( "Task ingested: %s", $task->{'id'} )
    };
};

# Main entry point
{
    my $result = $intake_work->(@ARG);

    if ( $result->{'success'} && $result->{'task'} ) {

        # Validate the structured task
        my $validation = $validate_task->( $result->{'task'} );
        if ( !$validation->{'valid'} ) {
            return {
                success => FALSE,
                error   => sprintf( "Task validation failed: %s",
                    join( ", ", $validation->{'errors'}->@* ) )
            };
        }

        # Normalize the task
        my $normalized = $normalize_task->( $result->{'task'} );

        return {
            success => TRUE,
            task    => $normalized,
            message => $result->{'message'}
        };
    }

    return $result;
}

