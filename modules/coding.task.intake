## [:< ##

# name = coding.task.intake
# descr = Parse and ingest work requests from various sources
# purpose = Foundation layer: Accept, parse, and structure incoming work

use strict;
use warnings;
use JSON::XS;
use Time::HiRes qw(time);
use Digest::SHA qw(sha256_hex);

# Generate unique task ID
sub _generate_task_id {
    my ( $type, $description ) = @_;
    my $timestamp = int( time() * 1000 );
    my $hash      = substr( sha256_hex( $description . $timestamp ), 0, 8 );
    return sprintf( "task-%d-%s-%s", $timestamp, $type // 'unknown', $hash );
}

# Main task intake function
my $intake_work = sub {
    my ($request) = @_;

    # Support multiple input formats
    if ( ref($request) eq 'HASH' ) {

        # Already structured as hash
        return $request if exists $request->{id};
    } elsif ( ref($request) eq '' ) {

        # Plain string - parse as command
        $request = _parse_command_string($request);
    } else {
        return {
            success => FALSE,
            error   => "Invalid request format: must be hash or string",
            input   => $request
        };
    }

    # Validate and structure the work request
    my $task = {
        id => $request->{id}
            // _generate_task_id( $request->{type}, $request->{description} ),
        type    => $request->{type}    // 'analysis',
        subtype => $request->{subtype} // '',
        source  => $request->{source}  // 'api',

        request => {
            description => $request->{description} // '',
            language    => $request->{language}    // 'en',
            target      => $request->{target}      // 'auto',
            constraints => ref( $request->{constraints} ) eq 'ARRAY'
            ? $request->{constraints}
            : [],
            deadline => $request->{deadline} // 'flexible',
            priority => $request->{priority} // 'normal'
        },

        analysis => {
            complexity       => undef,      # Will be calculated
            estimated_tokens => undef,      # Will be estimated
            routed_to        => undef,      # Will be decided
            fallback         => undef,      # Will be determined
            cache_priority   => 'normal',
            success_history  => { similar_tasks => 0, success_rate => 0 }
        },

        execution => {
            status      => 'pending',
            started     => undef,
            completed   => undef,
            model_used  => undef,
            tokens_used => 0,
            result      => undef,
            success     => undef,
            error       => undef
        },

        learning => {
            approach_effectiveness => undef,
            should_cache           => 1,
            pattern_id             => undef,
            next_improvement       => undef
        },

        metadata => {
            ingested_at => time(),
            ingested_by => $request->{source} // 'unknown',
            raw_request => $request
        }
    };

    return {
        success => TRUE,
        task    => $task,
        message => "Task ingested: " . $task->{id}
    };
};

# Parse command-line style strings into structured requests
my $parse_command_string = sub {
    my ($cmd) = @_;

# Simple command parsing: "type: description | constraints"
# Example: "code-generation: Create Whisper module | Protocol-7 compatible, cache results"

    if ( $cmd =~ /^([\w-]+):\s*(.+?)(?:\s*\|\s*(.+))?$/ ) {
        my ( $type, $desc, $constraints_str ) = ( $1, $2, $3 );

        my @constraints = ();
        if ($constraints_str) {
            @constraints = split( /\s*,\s*/, $constraints_str );
        }

        return {
            type        => $type,
            description => $desc,
            constraints => \@constraints,
            source      => 'console'
        };
    }

    # Fallback: treat entire string as description
    return {
        type        => 'analysis',
        description => $cmd,
        source      => 'console'
    };
};

# Validate task has required fields
my $validate_task = sub {
    my ($task) = @_;

    my @errors = ();

    push @errors, "Missing task.request.description"
        unless $task->{request}->{description};
    push @errors, "Missing task.type" unless $task->{type};

    return {
        valid  => scalar(@errors) == 0,
        errors => \@errors
    };
};

# Normalize task data (handle defaults, cleanup)
my $normalize_task = sub {
    my ($task) = @_;

    # Ensure all required fields exist with sensible defaults
    $task->{type}                = lc( $task->{type} // 'analysis' );
    $task->{priority}            = $task->{request}->{priority} // 'normal';
    $task->{execution}->{status} = 'pending';

    # Normalize priority values
    if ( $task->{priority} !~ /^(critical|high|normal|low)$/ ) {
        $task->{priority} = 'normal';
    }

    return $task;
};

# Main entry point
{
    my $result = $intake_work->(@_);

    if ( $result->{success} && $result->{task} ) {

        # Validate the structured task
        my $validation = $validate_task->( $result->{task} );
        if ( !$validation->{valid} ) {
            return {
                success => FALSE,
                error   => "Task validation failed: "
                    . join( ", ", @{ $validation->{errors} } )
            };
        }

        # Normalize the task
        my $normalized = $normalize_task->( $result->{task} );

        return {
            success => TRUE,
            task    => $normalized,
            message => $result->{message}
        };
    }

    return $result;
}

