##  BASE SOURCE-FILES SET-UP ##
###                         ###

my @copy_sources = qw [

    modules
    bin
    bin/admin/**
    bin/build-scripts/**
    bin/dependencies/**
    bin/dev/**
    bin/ai-scripts/**
    bin/install-scripts/**
    bin/scripts/**
    bin/test-scripts/**
    read-me/**
    data/md/**
    data/yaml/**
    data/tasks/**
    data/ai-mem/**
    data/planning/**
    data/openvas/**
    configuration
    configuration/zenki/*
    configuration/zenki/*/*
    configuration/zenki/openvas/bin/**
    configuration/zenki/build/recipes/**
    configuration/zenki/ext-pkg/packages/**

    !.lua$
    data/lib-path/pm/**
    data/web-root/*.bmw

    !test-fixtures
    !.xml$
    !c_src
    !bin/dev/html
    !INTEGRATION_GUIDE.html$
    !dev/lib
    !read-me/documentation/dev/reminders
    !llama-compiled
    !configuration/backup

];

if ( not chdir(<system.root_path>) ) {
    <[base.s_warn]>
        ->( ': cannot change workdir to : %s', <system.root_path> );
    return undef;
} else {

    return <[base.source.collect_file_list]>->( \@copy_sources );
}

