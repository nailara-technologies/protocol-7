# name  = sourcecode.source_path_set_up

###                         ###
##  BASE SOURCE-FILES SET-UP ##
###                         ###

my @copy_sources = qw [

    modules
    bin
    bin/admin/**
    bin/build-scripts/**
    bin/dependencies/**
    bin/dev/**
    bin/install-scripts/**
    bin/scripts/**
    bin/test-scripts/**
    read-me/**
    data/md/**
    data/yaml/**
    data/ai-mem/**
    data/planning/**
    configuration
    configuration/zenki/*
    configuration/zenki/*/*
    data/lib-path/pm/**

    !test-fixtures
    !.xml
    !.log
    !c_src
    !.html
    !dev/lib
    !read-me/documentation/dev/reminders
    !llama-compiled

];

if ( not chdir(<system.root_path>) ) {
    <[base.s_warn]>
        ->( ': cannot change workdir to : %s', <system.root_path> );
    return undef;
} else {

    return <[base.source.collect_file_list]>->( \@copy_sources );
}

