# name  = sourcecode.source_path_set_up

###                         ###
##  BASE SOURCE-FILES SET-UP ##
###                         ###

my @copy_sources = qw [

    modules
    bin/**
    read-me/**
    data/md/**
    data/yaml/**
    configuration/**
    data/lib-path/pm/**

    !.xml
    !c_src
    !llama-compiled

];

if ( not chdir(<system.root_path>) ) {
    <[base.s_warn]>
        ->( ': cannot change workdir to : %s', <system.root_path> );
    return undef;
} else {

    return <[base.source.collect_file_list]>->( \@copy_sources );
}

