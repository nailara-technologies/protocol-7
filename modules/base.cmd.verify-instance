## [:< ##

# name  = base.cmd.verify-instance
# param = <rnd_str>
# descr = verify root instance id through log feedback

my $random_string = $call->{'args'} // '';
return { 'mode' => qw| false |, 'data' => 'no random string supplied' }
    if not length $random_string;

## v7 confirms this instance is alive by reading the KEY back off console   ##
## output -- if console verbosity is silenced below this line's log level [ ##
## 1, base.logs' default ], the KEY never reaches v7 and the handshake      ##
## looks hung from its side even though this command ran fine. force it     ##
## through once, then restore whatever level was configured.,               ##
my $console_verbosity_bak = <system.zenka.verbosity.console>;
<system.zenka.verbosity.console> = 1 if not $console_verbosity_bak;

<[base.logs]>->( 'instance verification [KEY:%s]', $random_string );

<system.zenka.verbosity.console> = $console_verbosity_bak
    if not $console_verbosity_bak;

<[base.disable_command]>->('verify-instance');    # used only once by v7 zenka

map {
    ref($ARG) eq 'CODE'
        ? <[event.add_timer]>->( { 'after' => 0, 'cb'      => $ARG } )
        : <[event.add_timer]>->( { 'after' => 0, 'handler' => $ARG } );
} @{ <system.callbacks.initialized> //= [] };

## triggering instance reports before the timer does ##
<system.timer>->{'send_reports'}->now
    if defined <system.timer>->{'send_reports'}
    and <system.timer>->{'send_reports'}->is_active;

return { 'mode' => qw| true |, 'data' => 'verification code logged' };

