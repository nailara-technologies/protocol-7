## [:< ##

# name  = ncode.cmd.apply
# descr = apply fixes by checksum ID from pending store

## accept a ready hashref [ programmatic call ] or a cube-dispatch call ##
## object carrying plain-text 'args' [ p7c usage: <fix_id> | --session  ##
## <root> ], mirroring the usage hints ncode.cmd.suggest prints out     ##
my $raw    = shift // {};
my $params = {};
if (    ref $raw eq qw| HASH |
    and exists $raw->{'args'}
    and not ref $raw->{'args'} ) {
    my @tokens = split m|\s+|, $raw->{'args'} // '';
    if ( @tokens and $tokens[0] eq qw| --session | ) {
        $params = { 'session' => $tokens[1] // '' };
    } else {
        $params = { 'ids' => \@tokens };
    }
} elsif ( ref $raw eq qw| HASH | ) {
    $params = $raw;
}

my $ids     = $params->{'ids'}     // [];
my $session = $params->{'session'} // '';

## handle --session style from ids array ##
if (    ref $ids eq qw| ARRAY |
    and @$ids
    and $ids->[0] =~ m|^--session| ) {
    $session = $ids->[1] // '';
    $ids     = [];
}

<ncode.pending> //= {};
my $pending = <ncode.pending>;
my @fix_ids;

if ( length $session ) {
    @fix_ids = grep {
                ref $pending->{$ARG} eq qw| HASH |
            and $pending->{$ARG}{'session'} eq $session
            and $pending->{$ARG}{'status'} eq 'pending'
    } keys %$pending;
} elsif ( ref $ids eq qw| ARRAY | and @$ids ) {
    @fix_ids = @$ids;
} else {
    return { 'mode' => qw| false |, 'data' => 'specify fix ids or session' };
}

my $applied_count = 0;
my $failed_count  = 0;

foreach my $fix_id (@fix_ids) {
    my $fix = $pending->{$fix_id};
    if ( not defined $fix or ref $fix ne qw| HASH | ) {
        <[base.logs]>->(
            1, ':. ncode.cmd.apply: unknown fix_id %s :.', $fix_id
        );
        next;
    }

    my $pname = $fix->{'pattern'};
    my $file  = $fix->{'file'};

    <ncode.patterns> //= {};
    my $def = <ncode.patterns>->{$pname};

    if ( not defined $def or ref $def ne qw| HASH | ) {
        <[base.logs]>->(
            1, ':. ncode.cmd.apply: pattern %s not loaded :.', $pname
        );
        next;
    }

    ## read file ##
    open my $fh, '<', $file or do {
        <[base.logs]>->( 0, ':. ncode.cmd.apply: cannot read %s :.', $file );
        next;
    };
    local $/ = undef;
    my $content = <$fh>;
    close $fh;
    my $original = $content;

    ## apply steps ##
    my $steps   = $def->{'steps'} // [];
    my $step_ok = 1;

    foreach my $step (@$steps) {
        my $tool = $step->{'tool'} // $step->{'action'} // '';

        if ( $tool eq qw| ncode | or $tool eq qw| perl | ) {
            my $search  = $step->{'search'}  // $step->{'pattern'} // '';
            my $replace = $step->{'replace'} // '';

            next unless length $search;

            my $compiled = eval {qr/$search/};
            if ($@) {
                <[base.logs]>->(
                    0, ':. ncode.cmd.apply: bad step regex [ %s ] :.', $@
                );
                $step_ok = 0;
                last;
            }

            my @lines = split m|\n|, $content;
            my $count = 0;
            for my $i ( 0 .. $#lines ) {
                if ( $lines[$i] =~ $compiled ) {
                    my $old = $lines[$i];
                    $lines[$i] =~ s|$compiled|$replace|;
                    $count++ if $lines[$i] ne $old;
                }
            }
            $content = join "\n", @lines;
            $content .= "\n" if $original =~ m|\n$|;
        } elsif ( $tool eq qw| manual | ) {
            <[base.logs]>->(
                2, ':. ncode.cmd.apply: manual step skipped for %s :.',
                $pname
            );
        }
    }

    ## verify ##
    my $verify_pass = 1;
    my $verify_list = $def->{'verify'} // [];

    foreach my $vcheck (@$verify_list) {
        next unless ref $vcheck eq qw| HASH |;

        if ( exists $vcheck->{'no_match'} ) {
            my $vpat      = $vcheck->{'no_match'};
            my $vcompiled = eval {qr/$vpat/};
            if ($@) {
                <[base.logs]>->(
                    0, ':. ncode.cmd.apply: bad verify regex [ %s ] :.', $@
                );
                $verify_pass = 0;
                last;
            }
            if ( $content =~ $vcompiled ) {
                $verify_pass = 0;
                last;
            }
        }
    }

    ## hard safety gate : never keep a change that breaks perl syntax ##
    my $syntax_ok    = 1;
    my $syntax_error = '';
    if ( $verify_pass and $step_ok and $content ne $original ) {
        my $root    = <system.root_path>;
        my $ptd_bin = "$root/bin/ptd";

        ## use the zenka's own writable scratch dir [                      ##
        ## /var/protocol-7/ncode/ by default ] instead of the target's     ##
        ## directory -- sidesteps the whole taeki-owned-directory write    ##
        ## problem entirely, and comes with collision-safe random naming + ##
        ## v7-registered auto-cleanup                                      ##
        my ( $tfh, $tmp ) = <[file.temp]>->(qw| ptdcheck.XXXXXXXX |);

        if ( not defined $tfh ) {
            <[base.logs]>->(
                0, ':. ncode.cmd.apply: cannot create syntax-check tmp :.'
            );
            $syntax_ok = 0;
        } else {
            print {$tfh} $content;
            close $tfh;

            my $ptd_out = <[ncode.util.run_cmd]>->( $ptd_bin, '-c', $tmp );
            unlink $tmp;

            if ( $ptd_out !~ m{syntax ok}i ) {
                $syntax_ok    = 0;
                $syntax_error = $ptd_out;
            }
        }
    }

    if ( $verify_pass and $step_ok and $syntax_ok ) {
        ## temporary write grant via chmod-child, same pattern as           ##
        ## coding.tools.handler.replace_in_file -- child runs as the admin  ##
        ## user [ taeki ] so it can chmod its own taeki-owned files.  must  ##
        ## grant GROUP-write [ 0020 ], not other-write [ 0002 ] -- this     ##
        ## process is a supplementary-group member of taeki-owned files, so ##
        ## posix permission checks match [and stop] on the group class ;    ##
        ## other-write bits are never even consulted once a group match is  ##
        ## found [ write_with_perms carries this same latent bug --         ##
        ## confirmed by direct A/B test against it ]                        ##
        my $chmod_fh = <ncode.chmod_child.w_fh>;
        my $mode_restore;

        if ( -f $file and not -w $file and defined $chmod_fh ) {
            my $cur_mode = ( stat $file )[2] // 0644;
            $cur_mode &= 07777;
            printf {$chmod_fh} "restore %04o %s\n", ( $cur_mode | 0020 ),
                $file;
            <[ncode.chmod_child.readline]>; ## wait for restore to complete ##
            $mode_restore = $cur_mode if -w $file;
        }

        my $write_ok = 0;
        if ( -w $file ) {
            if ( open my $wfh, '>', $file ) {
                print {$wfh} $content;
                close $wfh;
                $write_ok = 1;
            } else {
                <[base.logs]>->(
                    0,     ':. ncode.cmd.apply: cannot write %s [ %s ] :.',
                    $file, $OS_ERROR
                );
            }
        } else {
            <[base.logs]>->(
                0,
                ':. ncode.cmd.apply: %s not writable [ chmod-child %s ] :.',
                $file,
                ( defined $chmod_fh ? 'grant failed' : 'unavailable' )
            );
        }

        ## restore original permissions regardless of write outcome ##
        if ( defined $mode_restore and defined $chmod_fh ) {
            printf {$chmod_fh} "restore %04o %s\n", $mode_restore, $file;
            <[ncode.chmod_child.readline]>;
        }

        next unless $write_ok;

        $fix->{'status'} = 'applied';
        $def->{'stats'}{'applied'}++;
        $applied_count++;
        <[base.logs]>->(
            2,       ':. ncode.cmd.apply: applied %s to %s :.',
            $fix_id, $file
        );
    } else {
        ## revert -- same chmod-child grant dance as the write path above;  ##
        ## in practice $content never differs from $original here today [   ##
        ## verify/step/syntax checks all run before any real write ], but a ##
        ## future multi-step flow could reach this with a real partial      ##
        ## write already on disk, so keep it correct                        ##
        my $revert_ok = 1;
        if ( $content ne $original ) {
            $revert_ok = 0;
            my $chmod_fh = <ncode.chmod_child.w_fh>;
            my $mode_restore;

            if ( -f $file and not -w $file and defined $chmod_fh ) {
                my $cur_mode = ( stat $file )[2] // 0644;
                $cur_mode &= 07777;
                printf {$chmod_fh} "restore %04o %s\n", ( $cur_mode | 0020 ),
                    $file;
                <[ncode.chmod_child.readline]>;
                $mode_restore = $cur_mode if -w $file;
            }

            if ( -w $file ) {
                if ( open my $wfh, '>', $file ) {
                    print {$wfh} $original;
                    close $wfh;
                    $revert_ok = 1;
                } else {
                    <[base.logs]>->(
                        0, ':. ncode.cmd.apply: cannot revert %s [ %s ] :.',
                        $file, $OS_ERROR
                    );
                }
            } else {
                <[base.logs]>->(
                    0,
                    ':. ncode.cmd.apply: cannot '
                        . 'revert %s [ not writable ] :.',
                    $file
                );
            }

            if ( defined $mode_restore and defined $chmod_fh ) {
                printf {$chmod_fh} "restore %04o %s\n", $mode_restore, $file;
                <[ncode.chmod_child.readline]>;
            }
        }

        $fix->{'status'} = 'failed';
        $fix->{'error'}  = $syntax_error if length $syntax_error;
        $def->{'stats'}{'false_positive'}++;
        $failed_count++;
        <[base.logs]>->(
            1,
            ':. ncode.cmd.apply: failed %s [ %s ]%s :.',
            $fix_id,
            ( $revert_ok           ? 'revert done'        : 'REVERT FAILED' ),
            ( length $syntax_error ? " [ $syntax_error ]" : '' )
        );
    }
}

my $summary = "$applied_count fixes applied";
$summary .= ", $failed_count failed" if $failed_count;

return { 'mode' => 'size', 'data' => $summary };

