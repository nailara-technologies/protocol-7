## [:< ##

# name  = coding.abort.remove
# descr = remove an abort-pattern from the store by checksum id

my $c_sum = shift // '';
return FALSE unless length $c_sum;
return FALSE if $c_sum =~ m{/};

my $zenka_dir_href = <system.path.zenka-dirs> // {};
my $zenka_name     = <system.zenka.name>      // 'coding';
my $path           = catfile( $zenka_dir_href->{'var_P7'},
    $zenka_name, 'abort-patterns', $c_sum );

return FALSE unless -f $path;

if ( unlink $path ) {
    <[base.logs]>->( 1, 'abort.remove: removed pattern %s', $c_sum );
    return TRUE;
}

<[base.logs]>->(
    0,      'abort.remove: failed to remove %s : %s',
    $c_sum, <[base.str.os_err]>
);

return FALSE;

