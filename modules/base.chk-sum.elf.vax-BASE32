## [:< ##

# name  = base.chk-sum.elf.vax-BASE32
# descr = return VAX + BASE32 encoded AMOS-13 ELF-7 chksum

##  reduce size by VAX encoding 9 digit elf chksum  ##
return encode_b32r( pack qw| V |, <[chk-sum.elf]>->( join ' ', @ARG ) )

