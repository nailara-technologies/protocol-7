# name = coding.learning.update_success_rate
# descr = update success rate statistics for task type
# purpose = learning : track success rates and trends by task type

my ( $task_type, $success ) = @ARG;

return { success => FALSE, error => 'task type required' }
    unless defined $task_type;

## load outcomes from persistence file ##
my $outcomes_file = '/var/protocol-7/coding/learning/outcomes.json';
my @outcomes;

if ( -f $outcomes_file ) {
    <[base.perlmod.autoload]>->('JSON::PP');
    my $content = <[file.slurp]>->($outcomes_file)->$*;
    if ( defined $content and length $content ) {
        my $decoded = eval { JSON::PP::decode_json($content) };
        @outcomes = $decoded->@* if ref $decoded eq qw| ARRAY |;
    }
}

## filter by task type ##
my @matching = grep { ( $ARG->{'task_type'} // '' ) eq $task_type } @outcomes;
my $total    = scalar @matching;
my $wins     = scalar grep { $ARG->{'success'} } @matching;

## compute trend from last 10 outcomes ##
my $trend = 'neutral';
if ( $total >= 4 ) {
    my @recent = @matching > 10 ? @matching[ -10 .. -1 ] : @matching;
    my $half   = int( scalar(@recent) / 2 );
    my $older  = scalar grep { $ARG->{'success'} } @recent[ 0 .. $half - 1 ];
    my $newer
        = scalar grep { $ARG->{'success'} } @recent[ $half .. $#recent ];
    $trend
        = $newer > $older ? 'improving'
        : $newer < $older ? 'declining'
        :                   'stable';
}

return {
    success      => TRUE,
    task_type    => $task_type,
    success_rate => $total > 0 ? int( $wins * 100 / $total ) : 0,
    samples      => $total,
    trend        => $trend
};

