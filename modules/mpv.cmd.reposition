## [:< ##

# name  = mpv.cmd.reposition
# descr = clear profile, reposition player via window-place ui

my $caller = <mpv.startup.caller> // <system.zenka.name> // 'mpv';

## clear local mpv profile first ##
<[window.profile.delete]>->($caller);

## clear window-place's copy of the profile ##
<[protocol-7.route-send]>->(
    {   'command'   => 'window-place.clear-profile',
        'call_args' => { 'args' => sprintf 'caller=%s', $caller }
    }
);

## request new coords — opens placement ui ##
<[protocol-7.route-send]>->(
    {   'command'   => 'window-place.coords',
        'call_args' => { 'args'    => sprintf 'caller=%s', $caller },
        'reply'     => { 'handler' => 'mpv.handler.reposition_reply' }
    }
);

return {
    'mode' => 'true',
    'data' => sprintf( 'repositioning requested [caller=%s]', $caller )
};

