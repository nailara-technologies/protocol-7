# name = coding.helper.task_priority
# descr = calculate priority for coding task based on task type and requirements
# purpose = helper : map task types and characteristics to jobqueue priority values

my ($task_type, $params) = @ARG;

$task_type //= 'general';
$params    //= {};

# map task types to base priority scores
my %type_priority = (
    'critical'       => -3,
    'high'           => -1,
    'code_gen'       => 0,
    'analysis'       => 0,
    'review'         => 1,
    'general'        => 0,
    'low'            => 2,
);

my $priority = $type_priority{$task_type} // 0;

# adjust priority based on additional parameters
if ( exists $params->{urgent} && $params->{urgent} ) {
    $priority -= 2;
}

if ( exists $params->{size} && $params->{size} eq 'large' ) {
    $priority += 1;
}

return $priority;

