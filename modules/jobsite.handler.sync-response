# name  = jobsite.handler.sync-response
# descr = called when batch sync post completes — stores server ntime, applies reverse

my $result = shift // {};

my $ok   = $result->{'ok'}   // FALSE;
my $body = $result->{'body'} // '';

<jobsite.sync.push_in_progress> = FALSE;

if ($ok) {
    my $reply = eval { JSON::XS::decode_json($body) };
    if ( ref $reply eq 'HASH' ) {
        my $ntime   = $reply->{'ntime'}   // '';
        my $reverse = $reply->{'reverse'} // [];
        <jobsite.sync.last_server_ntime> = $ntime if length $ntime;
        <[base.logs]>->(
            1,
            'jobsite: sync done, reverse=%d ntime=%s',
            scalar @{$reverse}, $ntime
        );
        <[jobsite.sync.apply_reverse]>->($reverse) if @{$reverse};
    }
} else {
    <[base.logs]>->(
        0,
        'jss.sync: push failed: %s',
        $result->{'error'} // $result->{'status'} // '?'
    );
}

