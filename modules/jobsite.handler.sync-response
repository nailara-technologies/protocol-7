# name  = jobsite.handler.sync-response
# descr = called when one job's sync post completes — collects reverse, sends next

my $result = shift // {};

my $ok     = $result->{'ok'}     // FALSE;
my $body   = $result->{'body'}   // '';
my $params = $result->{'params'} // {};
my $job_id = $params->{'job_id'} // '';
my $jobs   = $params->{'jobs'}   // {};

if ($ok) {
    my $reply = eval { JSON::XS::decode_json($body) };
    if ( ref $reply eq 'HASH' and ref $reply->{'reverse'} eq 'ARRAY' ) {
        push @{<jobsite.sync.push_reverse>}, @{ $reply->{'reverse'} };
    }
} else {
    <[base.logs]>->(
        0,       'jss.sync: post failed for %s: %s',
        $job_id, $result->{'error'} // $result->{'status'} // '?'
    );
}

<[jobsite.sync.push_next]>->($jobs);

