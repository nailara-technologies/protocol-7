## [:< ##

# name  = base.mod.exists
# descr = check if a protocol-7 module namespace is loaded in this zenka

my $mod_name = shift // '';

return FALSE if not length $mod_name;

return TRUE if <base.p7_mod.loaded>->{$mod_name};

return FALSE;

