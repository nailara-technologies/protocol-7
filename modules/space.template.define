## [:< ##

# name  = space.template.define
# descr = define a template with chain and branch formats
# param = { name, chain_format, branch_format }

my $params = shift // {};

my $name = $params->{'name'} // '';
return { 'mode' => qw| false |, 'data' => 'name required' }
    unless length $name;

my $chain_format  = $params->{'chain_format'}  // '';
my $branch_format = $params->{'branch_format'} // '';

return { 'mode' => qw| false |, 'data' => 'chain_format required' }
    unless length $chain_format;

<space.templates>->{$name} = {
    'chain_format'  => $chain_format,
    'branch_format' => $branch_format,
};

return { 'mode' => qw| true |, 'data' => $name };

