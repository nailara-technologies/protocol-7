## [:< ##

# name  = plugin.storage.inference.init_code
# descr = initialize checksum-addressed inference cache plugin

## create zenka results directory while still root ##
<[base.path-set-up.check-zenka-paths]>->(
    TRUE, undef, undef, undef, qw| results |
);

## resolve zenka var directory for results root ##
my $zenka_dirs = <system.path.zenka-dirs>;
my $var_base   = $zenka_dirs->{'var_P7'};
my $zenka_name = <system.zenka.name>;
my $root_path  = catfile( $var_base, $zenka_name, qw| results | );

## inference cache registry ##
$data{'storage'}{'mapping'}{'inference'} = {
    'enabled'    => 1,
    'version'    => '0.3',
    'root_path'  => $root_path,
    'rel_prefix' => 'results',    ## for file.zenka_dir.* calls ##

    ## in-memory hot index: L13 => branch metadata ##
    'branches' => {},

    ## config ##
    'config' => {
        'entropy_threshold'  => 0.15,    # L13 hamming distance for "same"
        'max_results_branch' => 20,      # max responses per question branch
        'hit_attention_mult' => 1.5,     # attention multiplier per cache hit
        'prune_min_age_days' => 30,      # min age before prune candidates
        'prune_min_hits'     => 0,       # 0-hit branches after min_age
    },

    ## stats ##
    'stats' => {
        'hits'          => 0,
        'misses'        => 0,
        'stores'        => 0,
        'dedup_skips'   => 0,
        'branches'      => 0,
        'total_results' => 0,
    },
};

## register with p7ref system if available ##
if ( exists $data{'storage'}{'mapping'}{'p7ref'} ) {
    $data{'storage'}{'mapping'}{'p7ref'}{'types'}{'inference'} = {
        'handler'  => 'plugin.storage.inference',
        'priority' => 7,
    };
    <[base.logs]>->( 2, ':. inference.init: registered p7ref type handler' );
}

<[base.logs]>->(
    1, ':. inference cache plugin initialized v0.3 [ root=%s ]', $root_path
);

0;

