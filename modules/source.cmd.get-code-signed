## [:< ##

# name  = source.cmd.get-code-signed
# descr = return specified source code subroutine

my $code_name      = $call->{'args'};    ## [ LLL ] implement multiple ?
my $skip_unchanged = $call->{'skip-valid'} // FALSE;
my $sign_verbosity = $call->{'verbosity'}  // 0;       ## [ 0 | 1 | 2 ] ##

##  expect [:< headers in ./modules/..,  ##
my $expect_valid_code_header = FALSE;    ## temporarely disabled ##
my $report_true_on_failure   = FALSE;    ##

my $code_dir = <source.code_path>;
$code_dir = <source.path.work_tree> if $code_name =~ m|/|;
my $src_path = catfile( $code_dir, $code_name );

return {
    'mode' => qw| false |,
    'data' => sprintf( "requested code ['%s'] name is not valid", $code_name )
    }
    if not <[source.valid_src_name]>->($code_name);

return { 'mode' => qw| false |, 'data' => 'code file not found' }
    if not -f $src_path;

$src_path = abs_path($src_path);

<[file.slurp]>->( $src_path, \my $src_str, qw| :raw | );

return { 'mode' => qw| false |, 'data' => 'no success reading source file' }
    if not defined $src_path;
## checking source header ##

return {
    'mode' => qw| false |,
    'data' => "requested code file has no '[:<' header"
    }
    if $expect_valid_code_header
    and $src_path =~ m|/modules/|
    and substr( $src_str, 0, 5 ) ne "## [:< ##\n";

## Extract signature in repair mode to trigger intelligent recovery
## When BMW checksum mismatches, source.signature_valid will:
##  1. Brute-force endline-states 0-7
##  2. Recalculate BMW for each state
##  3. Find state where BMW matches signature (ground truth)
##  4. Record recovered state in footer_data
## Then this module re-signs with the corrected endline-state
## This prevents oscillation and auto-heals format issues
my $footer_data
    = <[source.extract_sig_body]>->( \$src_str, qw| strip repair | );

my $footer_found        = $footer_data->{'was-present'};
my $found_footer_valid  = $footer_data->{'structure-was-valid'};
my $found_footer_length = $footer_data->{'footer-length-found'};

my $present_checksum;
my $present_signature;

( my $name_rel = $code_name ) =~ s|^.+/(*pla:[^/]+/[^/]+$)||;
<[base.logs]>->( 2, ':::[ %s ]:.', $name_rel );
<[base.log]>->( 2, ': :' );
if ( $footer_found and $found_footer_valid ) {
    $present_checksum  = $footer_data->{'bmw-chksum'};
    $present_signature = $footer_data->{'signature'};
    <[base.logs]>->(
        2, ':+: found valid footer structure [ %d bytes ]',
        $found_footer_length
    );
} else {
    if ( not $footer_found ) {
        <[base.log]>->( 2, ': : had no signature footer ..,' );
    } else {
        my $footer_error = $footer_data->{'encountered-error'};
        <[base.logs]>->(
            0, ':E: %s',
            $footer_error // 'unspecified error in footer structure'
        );
    }
}

## checksum and signature verification ##
##
( my $is_valid, my $report_ref )
    = <[source.signature_valid]>->( \$src_str, $footer_data );

if ($is_valid) {
    <[base.log]>->( 2, ':.: checksums and signature still valid. =)' );

    ## [ SKIP UNCHANGED MODE ] ##
    return { 'mode' => qw| true |, 'data' => 'still valid. =)' }
        if $skip_unchanged;
    ##
} else {
    <[base.log]>->( 2, ':' );
    <[base.log]>->( 2, ': [ not valid ] :' );
    <[base.log]>->( 2, ': :' );
    foreach my $type ( <[base.sort]>->($report_ref) ) {
        next
            if not $report_true_on_failure
            and not length ref $report_ref->{$type}
            and $report_ref->{$type};

        if ( not length ref $report_ref->{$type} ) {
            <[base.logs]>->(
                2,     ': :. %30s : %s',
                $type, $report_ref->{$type} ? 'true  =)' : 'false :|'
            );
        } else {
            foreach my $mode ( <[base.sort]>->( $report_ref->{$type} ) ) {
                next
                    if not $report_true_on_failure
                    and $report_ref->{$type}->{$mode};
                <[base.logs]>->(
                    2,     ': :. %30s [%s] : %s',
                    $type, $mode,
                    $report_ref->{$type}->{$mode} ? 'true  =)' : 'false :|'
                );
            }
        }
    }
    <[base.log]>->( 2, ':' );
}
my $recalc_data
    = <[source.create_harmonic_footer]>->( $footer_data, $sign_verbosity );
##

if (   not defined $present_checksum
    or not defined $present_signature
    or $present_signature ne $recalc_data->{'signature'}
    or $footer_data->{'needs_separator_endline'} )
{    # Always update if endlines need fixing
    if ( not defined $present_signature ) {

        <[base.log]>->( 2, ': : was not signed yet ..,' );
        <[base.log]>->( 2, ': :' );
    } else {

        <[base.log]>->( 2, ':*: body data checksum has changed ..,' );
        <[base.log]>->( 2, ': :' );
        <[base.log]>->( 2, ':-: [ BMW data checksum ] < ..found >' );
        <[base.logs]>->( 2, ': %s .,', $present_checksum );

    }

# Use the encoded endline state from the signature to preemptively restore correct state
    if ( defined $footer_data->{'endline-state-encoded'}
        && $footer_data->{'endline-state-encoded'} != 5 ) {
        ## The signature had encoded endline state, use it to restore correct state now
        <[source.restore_payload_endline_state]>->(
            \$src_str, $footer_data->{'endline-state-encoded'}
        );
        <[base.logs]>->(
            2,
            ': preemptively restoring endline state %d from signature',
            $footer_data->{'endline-state-encoded'}
        );
    }

    # Normalize separator endline: detect original state, calculate delta, normalize to exactly 1
    # Count trailing endlines before signature
    my $original_trailing = $src_str =~ m/(\n*)$/ ? length($1) : 0;

    # Map original endline count to endline state value (delta = transformation applied)
    # State 5 = no change (exactly 1 endline present)
    # State 6 = add 1 endline (0 endlines → add separator)
    # State 1-4 = other normalization deltas (reserved for future use)
    my $endline_delta;
    if ( $original_trailing == 0 ) {
        # No endlines: need to add exactly 1 separator
        $endline_delta = 6;  # "add separator endline"
    } elsif ( $original_trailing == 1 ) {
        # Already exactly 1: no change needed
        $endline_delta = 5;  # "no change"
    } else {
        # Multiple endlines: need to normalize to exactly 1
        $endline_delta = 1;  # "normalize excess endlines"
    }

    # Normalize to exactly 1 trailing endline
    $src_str =~ s/\n*$/\n/s;

    <[base.logs]>->(
        2, ': : normalized endlines (original: %d → canonical: 1, delta: %d)',
        $original_trailing, $endline_delta
    );

    # IMPORTANT: Recalculate footer with normalized content
    # Do NOT re-apply the endline delta - keep footer_data as-is so harmonizer detects state 5
    $recalc_data = <[source.create_harmonic_footer]>->( $footer_data, $sign_verbosity );

    # Append footer directly - content already has exactly 1 trailing newline from normalization
    # This provides canonical format: content\n#signature (exactly 1 separator newline)
    $src_str .= $recalc_data->{'signature-footer-str'};
    <[base.log]>->( 2, ':\\: [ BMW data checksum ] < current. >' );
    <[base.logs]>->( 2, ': %s .,', $recalc_data->{'data-chksum'} );
    <[base.log]>->( 2, ': :' );

    if ( defined $present_signature ) {
        <[base.log]>->( 2, ':+: [ previous signature ]' );
        <[base.logs]>->( 2, ':.%s .,', $present_signature );
    }
    <[base.log]>->( 2, ':+: [ current checksum signature ]' );
    <[base.logs]>->( 2, ':.%s .,', $recalc_data->{'signature'} );

} else {
    <[base.log]>->( 2, ':.: blue midnight wish C25519 signature valid. =)' );

    ## [ SKIP UNCHANGED MODE ] ##
    return { 'mode' => qw| true |, 'data' => 'still valid. =)' }
        if $skip_unchanged;
    ##
}

##  current \ updated source  ##
return { 'mode' => qw| size |, 'data' => $src_str }

