# name  = tile.cmd.get-screen-size
# descr = return screen size for the current display

my $width  = <x11.screen.width>  // 0;
my $height = <x11.screen.height> // 0;

return {
    'mode' => qw| true |,
    'data' => sprintf( '%dx%d', $width, $height )
};

