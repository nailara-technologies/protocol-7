## [:< ##

# name = nshell.term_restore
# descr = Restore terminal settings after nshell session

## Clear any stray cursor character before restoring terminal
## The cursor \r_\e[K\r sequence positions at line start, so we clear from there
print "\e[0m\r\e[K";
STDOUT->flush();

## Retrieve backed-up terminal settings from nshell.term_init
return TRUE if not defined $main::data{'nshell'}{'orig_termios'};

## Get current terminal file descriptor
my $tty_fd = fileno(STDIN);
return FALSE if not defined $tty_fd or $tty_fd < 0;

## Restore STDIN to blocking mode
my $flags = fcntl( \*STDIN, F_GETFL, 0 );
fcntl( \*STDIN, F_SETFL, $flags & ~O_NONBLOCK );

## Restore original terminal settings
my $restore_termios = $main::data{'nshell'}{'orig_termios'};
if ( defined $restore_termios ) {
    $restore_termios->setattr( $tty_fd, TCSAFLUSH() );
}

return TRUE;

