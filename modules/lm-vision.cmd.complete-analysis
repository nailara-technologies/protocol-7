## [:< ##

# name  = lm-vision.cmd.complete-analysis
# descr = perform vision analysis with automatic resumption

my ( $image_path, $prompt ) = split( m| +|, $call->{'args'}, 2 );
$prompt //= 'describe this image';

unless ( defined $image_path && length $image_path ) {
    return { 'mode' => 'false', 'data' => 'image_path required' };
}

unless ( -f $image_path ) {
    return { 'mode' => 'false', 'data' => "image not found : '$image_path'" };
}

<[base.logs]>->(
    1, "[complete-analysis] starting auto-resume loop: image=%s", $image_path
);

## Create meta-job to track the completion chain
## Initialize completion jobs store if needed
<lm-vision.complete_analysis_jobs> = {}
    unless defined <lm-vision.complete_analysis_jobs>;

my $meta_id  = <[base.gen_id]>->(<lm-vision.complete_analysis_jobs>);
my $meta_job = {
    'meta_id'      => $meta_id,
    'reply_id'     => $call->{'reply_id'},
    'image_path'   => $image_path,
    'prompt'       => $prompt,
    'status'       => qw| analyzing |,
    'current_job'  => undef,
    'accumulated'  => '',
    'resume_count' => 0,
    'max_resumes'  => 5,    ## safety limit to prevent infinite loops
    'start_time'   => <[base.time]>->(3),
};

<lm-vision.complete_analysis_jobs>->{$meta_id} = $meta_job;

<[base.logs]>->(
    1, "[complete-analysis] created meta-job=%s for auto-resume chain",
    $meta_id
);

my ( $backend, $backend_reason ) = <[lm-vision.select_backend]>;
if ( $backend eq qw| unavailable | ) {
    <[base.logs]>->(
        0, '[complete-analysis] backend unavailable: %s',
        $backend_reason
    );
    return {
        'mode' => qw| false |,
        'data' => 'vision backend unavailable: ' . $backend_reason
    };
}
if ( $backend eq qw| http | ) {
    <[base.logs]>->(
        0,
        '[complete-analysis] http backend not supported, use analyze_image'
    );
    return {
        'mode' => qw| false |,
        'data' =>
            'complete-analysis requires cli backend, use analyze_image for http'
    };
}

## Spawn initial analysis via lm-vision.analyze_image internally
## We need to call it as a deferred handler, so manually spawn the analysis
my $binary      = <lm-vision.binary>;
my $model_path  = <lm-vision.vision_model_path>;
my $mmproj_path = <lm-vision.vision_mmproj_path>;
my $log_file    = <system.root_path> . '/llama';

my @cmd = (
    $binary,
    '-m',       $model_path,
    '--mmproj', $mmproj_path,
    '-ngl',     99,
    '-c',       4096,           ## context: image tokens + prompt + response
    '-t',       4,
    '--image',  $image_path,
    '--image-min-tokens', 1024,    ## minimum image tokens for Qwen3-VL
    '-n', -2,    ## generate until context size full [ better streaming ]
    '--no-warmup',    ## skip warmup to reduce initialization output
    '--log-file', $log_file,    ## log via symlink to /dev/null
    '--prompt',   $prompt,

    ## Reverse prompts: stop generation at natural boundaries
    '--reverse-prompt', 'User:',    ## stop at conversation turn
    '--reverse-prompt', '###',      ## stop at section separator

    ## Qwen3 recommended VL task parameters from modelcard
    '--temp',             0.7,   ## moderate temperature for focused VL output
    '--top-k',            20,    ## top-k sampling [ recommended for VL ]
    '--top-p',            0.8,   ## nucleus sampling for VL tasks
    '--repeat-penalty',   1.0,   ## repetition penalty [ default ]
    '--presence-penalty', 1.5,   ## presence penalty to reduce repetition
);

## Set up environment for vision model
local $ENV{'LD_LIBRARY_PATH'}
    = <lm-vision.lib_path> . ':' . ( $ENV{'LD_LIBRARY_PATH'} // '' );

## Spawn vision CLI process with stdin redirected from /dev/null
my ( $wtr, $rdr, $err );
$err = Symbol::gensym();

open( my $null_in, '<', '/dev/null' ) or do {
    <[base.logs]>->( 0, "ERROR : Failed to open /dev/null for stdin" );
    return { 'mode' => 'false', 'data' => 'failed to open /dev/null' };
};

my $pid = eval { open3( $null_in, $rdr, $err, @cmd ) };

if ( !$pid || $EVAL_ERROR ) {
    <[base.logs]>->(
        0,
        "ERROR: Failed to spawn vision CLI: %s",
        $EVAL_ERROR // 'unknown error'
    );
    return { 'mode' => 'false', 'data' => 'vision CLI spawn failed' };
}

# Enable autoflush and set non-blocking mode on read filehandles
$rdr->autoflush(1);
$err->autoflush(1);

# Set filehandles to non-blocking mode using fcntl
use Fcntl qw(F_GETFL F_SETFL O_NONBLOCK);
foreach my $fh ( $rdr, $err ) {
    my $flags = fcntl( $fh, F_GETFL, 0 ) or die "can't get flags: $!";
    fcntl( $fh, F_SETFL, $flags | O_NONBLOCK )
        or die "can't set non-blocking: $!";
}

# Generate unique job ID for initial analysis
my $job_id = <[base.gen_id]>->(<lm-vision.jobs>);

# Create job entry with metadata for completion chain
my $job = {
    'job_id'              => $job_id,
    'image_path'          => $image_path,
    'prompt'              => $prompt,
    'status'              => qw| running |,
    'pid'                 => $pid,
    'rdr'                 => $rdr,
    'err'                 => $err,
    'output'              => '',
    'stderr'              => '',
    'start_time'          => <[base.time]>->(3),
    'is_completion_chain' => 1,           # Mark as part of completion chain
    'meta_id'             => $meta_id,    # Reference to meta-job
};

# Store job in queue
<lm-vision.jobs>->{$job_id} = $job;
$meta_job->{'current_job'} = $job_id;

<[base.logs]>->(
    1,       "[complete-analysis] spawned initial analysis: job=%s pid=%d",
    $job_id, $pid
);

# Register non-blocking I/O handler for stdout
# prio => 2 (higher priority): process all available data first
$job->{'rdr_io'} = <[event.add_io]>->(
    {   'fd'      => $rdr,
        'handler' => qw| lm-vision.handler.read_output |,
        'data'    => $job_id,
        'poll'    => qw| r |,
        'prio'    => 2
    }
);

# Register non-blocking I/O handler for stderr (read data + exception on EOF)
# prio => 1 (lower priority): process EOF after all data has been read
$job->{'err_io'} = <[event.add_io]>->(
    {   'fd'      => $err,
        'handler' => qw| lm-vision.handler.check_completion |,
        'data'    => $job_id,
        'poll'    => qw| re |,
        'prio'    => 1
    }
);

# Schedule periodic check for completion chain
<[event.add_timer]>->(
    {   'after'   => 0.7,    # Check every 200ms
        'handler' => qw| lm-vision.handler.check-completion-chain |,
        'data'    => $meta_id
    }
);

<[base.logs]>->(
    1, "[complete-analysis] returning deferred, monitoring for completion"
);

return { 'mode' => 'deferred' };

