## [:< ##

# name  = letsencrypt.parent.handler_renewal_check
# descr = Periodically check which certificates need renewal and queue them

my $timer_data = shift;

<[base.log]>->( 3, 'renewal check timer fired' );

## Get current time
my $now = time();
<letsencrypt.stats.last_renewal_check> = $now;

## Iterate through certificates
for my $domain ( keys <letsencrypt.parent.certs>->%* ) {
    my $cert_info = <letsencrypt.parent.certs> {$domain};

    next unless $cert_info->{valid_until};

    my $days_remaining    = ( $cert_info->{valid_until} - $now ) / 86400;
    my $renewal_threshold = <letsencrypt.renewal.days-before>;

    if ( $days_remaining <= $renewal_threshold ) {
        <[base.log]>->(
            2,
            "certificate for [$domain] needs renewal (expires in $days_remaining days)"
        );

        ## Queue renewal with child via Protocol-7 command protocol
        ## Format: letsencrypt.child.cmd.renew-certificate domain_name
        ## Child will handle via base.handler.command
        my $renewal_cmd
            = sprintf 'letsencrypt.child.cmd.renew-certificate %s', $domain;
        <[base.protocol-7.command.send.local]>->(
            {   'command'   => $renewal_cmd,
                'call_args' => { 'args' => '' },
                'reply'     => {
                    'handler' => 'letsencrypt.parent.handler_renewal_reply',
                    'params'  => { 'domain' => $domain }
                }
            }
        );
        <[base.log]>->( 3, "sent renewal command to child: $renewal_cmd" );

        ## Record that renewal was initiated
        if ( !exists <letsencrypt.parent.renewal_timers> {$domain} ) {
            <letsencrypt.parent.renewal_timers> {$domain} = {
                started  => $now,
                attempts => 0,
            };
        }
        <letsencrypt.parent.renewal_timers> {$domain}{attempts}
        ++;
    }
}

return 0;

