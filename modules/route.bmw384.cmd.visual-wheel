## [:< ##

# name  = route.bmw384.cmd.visual-wheel
# descr = command handler for BMW384 field wheel visualization

my $args = $call->{'args'} // '';
my ( $output_mode, @rest ) = split m{\s+}, $args;
$output_mode //= '';

# [ parse ring count, visual mode, mode params, and label mode from @rest ]
my $rings_override;
my $visual_mode;
my $mode_param;
my $label_mode;

for my $ARG (@rest) {
    if ( $ARG =~ m{^\d+$} and not defined $rings_override ) {
        $rings_override = $ARG + 0;
        $rings_override = 63 if $rings_override > 63;
    } elsif (
        $ARG =~ m{^(?:arc-width|density|gauss|overlay|metric|heatmap|ring)$} )
    {
        $visual_mode = $ARG;
    } elsif ( $ARG =~ m{^(?:namespace63|linear)$} ) {
        $label_mode = $ARG;
    } elsif ( not defined $mode_param ) {
        $mode_param = $ARG;
    }
}

# [ save and apply rings override ]
my $rings_saved;
if ( defined $rings_override ) {
    $rings_saved = <route.bmw384.cfg.rings>;
    <route.bmw384.cfg.rings> = $rings_override;
}

# [ save and apply visual mode ]
my $visual_mode_saved;
if ( defined $visual_mode ) {
    $visual_mode_saved = <route.bmw384.cfg.visual_mode>;
    <route.bmw384.cfg.visual_mode> = $visual_mode;
}

# [ save and apply label mode ]
my $label_mode_saved;
if ( defined $label_mode ) {
    $label_mode_saved = <route.bmw384.cfg.ring_label_mode>;
    <route.bmw384.cfg.ring_label_mode> = $label_mode;
}

# [ apply mode-specific param ]
my $gauss_arcs_saved;
my $overlay_ns_saved;
if ( defined $mode_param ) {
    if ( defined $visual_mode and $visual_mode eq 'gauss' ) {
        $gauss_arcs_saved = <route.bmw384.cfg.gauss_arcs>;
        <route.bmw384.cfg.gauss_arcs> = $mode_param;
    } elsif ( defined $visual_mode and $visual_mode eq 'overlay' ) {
        $overlay_ns_saved = <route.bmw384.cfg.overlay_namespaces>;
        <route.bmw384.cfg.overlay_namespaces> = $mode_param;
    }
}

my $result;

if ( not length $output_mode or $output_mode eq 'svg' ) {
    my $svg = <[route.bmw384.visual.wheel-mode]>;
    if ( not defined $svg ) {
        $result = {
            qw| mode | => qw| size |,
            qw| data | => 'bmw384 index not initialized'
        };
    } else {
        $result = { qw| mode | => qw| size |, qw| data | => $svg };
    }
} elsif ( $output_mode eq 'html' ) {
    my $html = <[route.bmw384.visual.wheel-html]>;
    if ( not defined $html ) {
        $result = {
            qw| mode | => qw| size |,
            qw| data | => 'bmw384 index not initialized'
        };
    } else {
        $result = { qw| mode | => qw| size |, qw| data | => $html };
    }
} elsif ( $output_mode eq 'file' ) {
    my $html = <[route.bmw384.visual.wheel-html]>;
    if ( not defined $html ) {
        $result = {
            qw| mode | => qw| size |,
            qw| data | => 'bmw384 index not initialized'
        };
    } else {
        my $path = '/tmp/bmw384-wheel.html';
        <[file.write]>->( $path, \$html );
        $result = { qw| mode | => qw| size |, qw| data | => $path };
    }
} else {
    $result = {
        qw| mode | => qw| size |,
        qw| data | => 'usage: visual-wheel [svg|html|file] [rings]'
            . ' [arc-width|density|gauss|overlay|metric|heatmap]'
            . ' [mode-param] [linear|namespace63]'
    };
}

# [ restore saved state ]
if ( defined $rings_override ) {
    if ( defined $rings_saved ) {
        <route.bmw384.cfg.rings> = $rings_saved;
    } else {
        delete <route.bmw384.cfg.rings>;
    }
}
if ( defined $visual_mode ) {
    if ( defined $visual_mode_saved ) {
        <route.bmw384.cfg.visual_mode> = $visual_mode_saved;
    } else {
        delete <route.bmw384.cfg.visual_mode>;
    }
}
if ( defined $label_mode ) {
    if ( defined $label_mode_saved ) {
        <route.bmw384.cfg.ring_label_mode> = $label_mode_saved;
    } else {
        delete <route.bmw384.cfg.ring_label_mode>;
    }
}
if ( defined $gauss_arcs_saved ) {
    <route.bmw384.cfg.gauss_arcs> = $gauss_arcs_saved;
} elsif ( defined $mode_param
    and defined $visual_mode
    and $visual_mode eq 'gauss' ) {
    delete <route.bmw384.cfg.gauss_arcs>;
}
if ( defined $overlay_ns_saved ) {
    <route.bmw384.cfg.overlay_namespaces> = $overlay_ns_saved;
} elsif ( defined $mode_param
    and defined $visual_mode
    and $visual_mode eq 'overlay' ) {
    delete <route.bmw384.cfg.overlay_namespaces>;
}

return $result;

