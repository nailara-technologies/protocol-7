## [:< ##

# name  = route.bmw384.cmd.visual-wheel
# descr = command handler for BMW384 field wheel visualization

my $args = $call->{'args'} // '';
my ( $mode, @rest ) = split m{\s+}, $args;
$mode //= '';

if ( not length $mode or $mode eq 'svg' ) {
    my $svg = <[route.bmw384.visual.wheel]>;
    if ( not defined $svg ) {
        return {
            qw| mode | => qw| size |,
            qw| data | => 'bmw384 index not initialized'
        };
    }
    return { qw| mode | => qw| size |, qw| data | => $svg };
}

if ( $mode eq 'html' ) {
    my $html = <[route.bmw384.visual.wheel-html]>;
    if ( not defined $html ) {
        return {
            qw| mode | => qw| size |,
            qw| data | => 'bmw384 index not initialized'
        };
    }
    return { qw| mode | => qw| size |, qw| data | => $html };
}

if ( $mode eq 'file' ) {
    my $html = <[route.bmw384.visual.wheel-html]>;
    if ( not defined $html ) {
        return {
            qw| mode | => qw| size |,
            qw| data | => 'bmw384 index not initialized'
        };
    }
    my $path = '/tmp/bmw384-wheel.html';
    <[base.file.write]>->( $path, $html );
    return { qw| mode | => qw| size |, qw| data | => $path };
}

return {
    qw| mode | => qw| size |,
    qw| data | => 'usage: visual-wheel [svg|html|file]'
};

