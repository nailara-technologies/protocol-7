## [:< ##

# name  = route.bmw384.cmd.visual-wheel
# descr = command handler for BMW384 field wheel visualization

my $args = $call->{'args'} // '';
my ( $mode, @rest ) = split m{\s+}, $args;
$mode //= '';

# [ rings override ]
my $rings_override;
for my $ARG (@rest) {
    if ( $ARG =~ m{^\d+$} ) {
        $rings_override = $ARG + 0;
        last;
    }
}

my $rings_saved;
if ( defined $rings_override ) {
    $rings_saved = <route.bmw384.cfg.rings>;
    <route.bmw384.cfg.rings> = $rings_override;
}

my $result;

if ( not length $mode or $mode eq 'svg' ) {
    my $svg = <[route.bmw384.visual.wheel]>;
    if ( not defined $svg ) {
        $result = {
            qw| mode | => qw| size |,
            qw| data | => 'bmw384 index not initialized'
        };
    } else {
        $result = { qw| mode | => qw| size |, qw| data | => $svg };
    }
} elsif ( $mode eq 'html' ) {
    my $html = <[route.bmw384.visual.wheel-html]>;
    if ( not defined $html ) {
        $result = {
            qw| mode | => qw| size |,
            qw| data | => 'bmw384 index not initialized'
        };
    } else {
        $result = { qw| mode | => qw| size |, qw| data | => $html };
    }
} elsif ( $mode eq 'file' ) {
    my $html = <[route.bmw384.visual.wheel-html]>;
    if ( not defined $html ) {
        $result = {
            qw| mode | => qw| size |,
            qw| data | => 'bmw384 index not initialized'
        };
    } else {
        my $path = '/tmp/bmw384-wheel.html';
        <[file.write]>->( $path, \$html );
        $result = { qw| mode | => qw| size |, qw| data | => $path };
    }
} else {
    $result = {
        qw| mode | => qw| size |,
        qw| data | => 'usage: visual-wheel [svg|html|file] [rings]'
    };
}

if ( defined $rings_override ) {
    if ( defined $rings_saved ) {
        <route.bmw384.cfg.rings> = $rings_saved;
    } else {
        delete <route.bmw384.cfg.rings>;
    }
}

return $result;

