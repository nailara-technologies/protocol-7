## [:< ##

# name  = base.file.encoding
# descr = detect file encoding [ returns :encoding(X) string ]

my $path = shift // return ':encoding(UTF-8)';

return ':encoding(UTF-8)' unless -f $path;

## read first 4096 bytes raw for detection ##
my $sample = '';
<[file.slurp]>->( $path, \$sample, ':raw' );
return ':encoding(UTF-8)' unless length $sample;

## BOM detection ##
return ':encoding(UTF-8)'    if $sample =~ /^\xEF\xBB\xBF/;
return ':encoding(UTF-16LE)' if $sample =~ /^\xFF\xFE/;
return ':encoding(UTF-16BE)' if $sample =~ /^\xFE\xFF/;

## try UTF-8 decode on sample — fail = raw ##
my $test = substr $sample, 0, 4096;
eval { Encode::decode( 'UTF-8', $test, Encode::FB_CROAK ) };
return $@ ? ':raw' : ':encoding(UTF-8)';

