## [:< ##
# name = memory.cfg.defaults
# descr = set memory zenka config defaults in <memory.cfg>

my $cfg = <memory.cfg> //= {};

## [ tree defaults ]##
$cfg->{'n_visible'}           //= 7;
$cfg->{'n_max_cap'}           //= 13;
$cfg->{'summarize_queue_max'} //= 13;
$cfg->{'curve_type'}          //= 'sigmoid';
$cfg->{'eviction_threshold'}  //= 0.05;

## [ focus defaults ]##
$cfg->{'focus_decay'}     //= 0.85;
$cfg->{'focus_interval'}  //= 30;
$cfg->{'focus_apply_cap'} //= 3.0;

## [ source defaults ]##
$cfg->{'ai_mem_dir'} //= 'data/ai-mem';
$cfg->{'git_commit_limit'}
    //= 20;    ## [ conservative default; git source is heavy ]
$cfg->{'git_source_enabled'}
    //= FALSE;    ## [ opt-in; disabled until explicit request ]

return TRUE;

