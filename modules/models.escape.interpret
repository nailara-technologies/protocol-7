## [:< ##

# name = models.escape.interpret
# descr = interpret escape sequences in chat messages for display
# param = $text - text with :n: :t: escapes
# return = text with escapes converted to actual characters

my $text      = shift;
my $tab_width = <models.cfg.tab_width> // 10;

return '' unless defined $text;

## handle escaped markers (literals) first using placeholders
$text =~ s/\\:n:/__LITERAL_COLON_N__/g;
$text =~ s/\\:t:/__LITERAL_COLON_T__/g;

## apply actual escapes
$text =~ s/:n:/\n/g;

## on-demand tab width: :t4: = 4 spaces, :t8: = 8 spaces, etc
$text =~ s/:t(\d+):/' ' x $1/ge;

## default tab width: :t: uses configured width
$text =~ s/:t:/' ' x $tab_width/ge;

## restore literals
$text =~ s/__LITERAL_COLON_N__/:n:/g;
$text =~ s/__LITERAL_COLON_T__/:t:/g;

return $text;

0;

