## [:< ##

# name  = credential_fabric.util.perform_auth
# descr = perform auth operation for credential type

my ( $type, $value, $ctx ) = @ARG;

if ( $type eq qw| api-key | ) {
    return { 'inject_header' => { 'X-API-Key' => $value } };

} elsif ( $type eq qw| bearer-token | ) {
    return { 'inject_header' => { 'Authorization' => "Bearer $value" } };

} elsif ( $type eq qw| session-cookie | ) {
    return { 'inject_header' => { 'Cookie' => $value } };

} elsif ( $type eq qw| basic-auth | ) {
    return {
        'inject_header' => {
            'Authorization' => 'Basic '
                . MIME::Base64::encode_base64( $value, '' )
        }
    };

} elsif ( $type eq qw| psk | ) {
    return { 'psk' => $value };

} elsif ( $type eq qw| oauth-token | ) {
    ## returns access token; refresh handled by owning zenka ##
    return { 'inject_header' => { 'Authorization' => "Bearer $value" } };

} elsif ( $type eq qw| tls-client-cert | ) {
    return { 'tls_cert_pem' => $value };

} else {
    return { 'opaque' => $value };
}

