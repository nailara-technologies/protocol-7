## [:< ##

# name  = proxy.template.resolve
# descr = dispatch to site-yaml or passthrough, assemble typed result

my $client_id = shift;
my $context   = shift;
my $template  = shift;

my $client = $data{'proxy'}{'clients'}{$client_id};
return if not defined $client;

if ( $template =~ m{\.(passthrough)$} ) {
    return
        <[proxy.template.passthrough]>->( $client_id, $context, $template );
} elsif ( $template eq 'generic.proxy' or $template =~ m{\.(proxy)$} ) {
    ## generic.proxy or any *.proxy template → generic renderer ##
    return <[proxy.template.generic]>->( $client_id, $context );
} else {
    ## unknown template: fall back to generic.proxy ##
    <[base.logs]>->(
        1, 'proxy: unknown template %s, falling back to generic.proxy',
        $template
    );
    return <[proxy.template.generic]>->( $client_id, $context );
}

