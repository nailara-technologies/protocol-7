## [:< ##

# name = tree.route.page.read
# descr = read N lines x W bytes from routing table at offset

my $args = shift // {};

my $fh     = $args->{'fh'}     // return undef;
my $lines  = $args->{'lines'}  // 20;
my $width  = $args->{'width'}  // 7;
my $offset = $args->{'offset'} // 0;

return undef if not defined $fh;

## [ seek to offset ] ##
seek( $fh, $offset, 0 ) if $offset;

my @buffer;
my $line_size = $width;

while ( scalar(@buffer) < $lines ) {
    my $n = sysread( $fh, my $data, $line_size );
    last if not defined $n or $n == 0;
    push @buffer, $data;
}

return \@buffer;

