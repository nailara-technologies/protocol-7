## [:< ##

# name = X-11.grab_key

my $keycode  = shift // 0;            #     0 == AnyKey
my $modifier = shift // undef;        # undef == AnyModifier
my $X_obj    = shift // <X-11.obj>;

$X_obj->GrabKey( $keycode, $modifier, $X_obj->root, 0, 'Asynchronous',
    'Asynchronous' );

