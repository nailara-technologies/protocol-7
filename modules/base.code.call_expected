## [:< ##

# name  = base.code.call_expected
# descr = call a %code sub when a condition holds, else silent skip

## condition false : nothing was ever expected here, silent skip ##
## condition true but sub missing : that's a real regression, log loud ##
my $condition = shift;
my $sub_name  = shift // '';
my @call_args = @ARG;

return undef if not $condition;

return FALSE if not length $sub_name;

return $code{$sub_name}->(@call_args) if defined $code{$sub_name};

<[base.logs]>->( 0, ':: expected subroutine missing :. %s', $sub_name );

return undef;

