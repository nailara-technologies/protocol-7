# name = tile-groups.set-up.export_rules

return {
    'keys' => {
        'set-up' => {
            'export' => [
                'tile-groups.import_path',
                'tile-groups.fallback_tile_group'
            ]
        },
        'tile-groups' => { 'export' => ['tile-groups.set-up.tile-groups'], },
        'tile-groups_stripped' => {
            'export'  => ['tile-groups.set-up.tile-groups'],
            'exclude' => [
                '*.start_zenki', '*.stop_zenki',
                '*.fade',        '*.prepare_cmd',
                '*.get_opacity'
            ]
        }
    }
};

