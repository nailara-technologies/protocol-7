## [:< ##

# name  = plugin.storage.inference
# descr = inference cache storage plugin — main dispatch

my $args = shift // {};

my $operation = $args->{'operation'} // qw| lookup |;

if ( $operation eq qw| store | ) {
    return <[plugin.storage.inference.store]>->($args);
} elsif ( $operation eq qw| lookup | ) {
    return <[plugin.storage.inference.lookup]>->($args);
} elsif ( $operation eq qw| stats | ) {
    my $registry = $data{'storage'}{'mapping'}{'inference'};
    return {
        'mode' => qw| true |,
        'data' => {
            'stats'    => $registry->{'stats'},
            'branches' => scalar keys $registry->{'branches'}->%*,
            'enabled'  => $registry->{'enabled'},
        }
    };
} else {
    return {
        'mode' => qw| false |,
        'data' => "unknown operation: $operation",
    };
}

