## [:< ##

# name  = window.profile.save
# descr = save current window position to zenka-local yaml

<[base.perlmod.load]>->( 'YAML::XS', qw| Dump | );

my ( $caller, $x, $y, $width, $height ) = @ARG;

unless ( defined $caller and length $caller ) {
    <[base.s_warn]>->( 'caller required for save <{C1}>', '' );
    return undef;
}

unless ( defined $x and defined $y and defined $width and defined $height ) {
    <[base.s_warn]>->(
        'x, y, width and height required for save <{C1}>', $caller
    );
    return undef;
}

## clamp to non-negative ##
$x      = 0 if $x < 0;
$y      = 0 if $y < 0;
$width  = 1 if $width < 1;
$height = 1 if $height < 1;

<[base.logs]>->(
    2,  "[profile.save] saving position: x=%d y=%d w=%d h=%d",
    $x, $y, $width, $height
);

my $yaml_data = {
    'x'        => $x,
    'y'        => $y,
    'width'    => $width,
    'height'   => $height,
    'profile'  => 'saved',
    'metadata' => {
        'caller'   => $caller,
        'saved_at' => <[base.time]>->(3)
    }
};

my $yaml_content;
eval { $yaml_content = Dump($yaml_data); };
if ($EVAL_ERROR) {
    <[base.s_warn]>->(
        'YAML serialization failed: %s',
        <[base.str.eval_error]>
    );
    return undef;
}

unless ( defined $yaml_content and length $yaml_content ) {
    <[base.s_warn]>->(
        'YAML serialization produced empty content <{C1}>', $caller
    );
    return undef;
}

## key the saved position file on the caller name so each caller   ##
## [ e.g. each shell/window kind ] gets its own remembered position ##
my $caller_chksum = <[chk-sum.amos]>->($caller);
my $position_path = sprintf 'window/position.%s.yaml', $caller_chksum;

my $bytes_written = <[file.zenka_dir.write]>->(
    $position_path,
    \$yaml_content,
    '>',       # overwrite mode
    0600,      # permissions
    ':utf8'    # encoding
);

unless ( defined $bytes_written ) {
    <[base.s_warn]>->(
        'failed to write position YAML file [ %s ]',
        $position_path
    );
    return undef;
}

<[base.logs]>->(
    2, '[profile.save] saved window position [bytes:%d]',
    $bytes_written
);

return $bytes_written;

