## [:< ##

# name  = credential_fabric.seed_registry
# descr = read seed.yaml and register slots once at init.
#         called from credential_fabric.init_code, guarded by seed.loaded.

return if <credential_fabric.seed.loaded>;

my $seed_ref = <[file.zenka_dir.load]>->('seed.yaml');
return if not defined $seed_ref;

my $yaml_str = $seed_ref->$* // '';
return if not length $yaml_str;

my $seed = eval { YAML::XS::Load($yaml_str) };
if ( $@ or not defined $seed or ref $seed ne qw| HASH | ) {
    <[base.logs]>->(
        0,
        'credential_fabric.seed_registry: failed to parse seed.yaml: %s',
        $@ // 'unknown'
    );
    return;
}

my $slots = $seed->{'slots'} // [];
return if ref $slots ne qw| ARRAY |;

for my $entry (@$slots) {
    next if ref $entry ne qw| HASH |;
    next if not defined $entry->{'slot'} or not length $entry->{'slot'};

    my $result = <[credential_fabric.register]>->($entry);
    <[base.logs]>->(
        2,                'credential_fabric.seed_registry: %s -> %s',
        $entry->{'slot'}, $result->{'data'} // 'unknown'
    );
}

<credential_fabric.seed.loaded> = TRUE;

return;

