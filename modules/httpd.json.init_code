## [:< ##

# name = httpd.json.init_code
# descr = initialize JSON handling for HTTP server

<[base.perlmod.autoload]>->('JSON::XS');

<httpd.json.parser> = JSON::XS->new();
<httpd.json.parser>->convert_blessed(1);
<httpd.json.parser>->allow_nonref(1);
<httpd.json.parser>->canonical(1);
<httpd.json.parser>->relaxed(1);
<httpd.json.parser>->pretty(1);
<httpd.json.parser>->utf8(0);
## Output octets [bytes], not UTF-8 flagged strings
## With global 'use bytes;' pragma, SIZE mode counts bytes

return 0;

