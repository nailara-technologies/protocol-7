## [:< ##

# name  = coding.cmd.resurrect
# descr = resurrect failed task for retry

my $task_id = $call->{'args'} // '';

return { 'mode' => qw| false |, 'data' => 'task_id required' } 
    unless length $task_id;

my $result = <[coding.task.resurrect]>->($task_id);

my $output;
if ($result->{'mode'} eq qw| true |) {
    $output = sprintf("Task %s resurrected for retry #%d\n",
        $result->{'data'}{'task_id'},
        $result->{'data'}{'retry_count'}
    );
    $output .= "Successfully re-queued for execution.\n" 
        if $result->{'data'}{'queued'};
} else {
    $output = "Failed: " . ($result->{'data'} // 'unknown error') . "\n";
}

return { 'mode' => qw| size |, 'data' => $output };

