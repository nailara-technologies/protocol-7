## [:< ##

# name  = source.load_signature_key

my $sigkey_name = shift // <source.C25519.signature_key_name>;

##[ proto-7.sourcecode ]##
##
if ( not length $sigkey_name ) {
    warn 'signature key name is not defined <{C1}>';
    return undef;
}

##  enable in zenka config to auto-create key  ##
<source.autocreate-sig-key> //= FALSE;

my $key_vars_ref = <[crypt.C25519.key_vars]>->($sigkey_name);
my $key_dir      = $key_vars_ref->{'key_dir'};
my $key_basepath = $key_vars_ref->{'key_basepath'};

my $success = FALSE;

my $sign_key_exists = <[crypt.C25519.key_exists]>->($sigkey_name);

if ( $sign_key_exists
    and <[crypt.C25519.load_keypair]>->( $sigkey_name, undef, TRUE, TRUE ) ) {

    $success = TRUE;    ##  key loaded  ##

    ## this IS the deliberate override case crypt.C25519.post_init's own
    ## header note describes -- a process whose whole purpose is signing with
    ## $sigkey_name should adopt it as its own identity, explicitly, rather
    ## than relying on key_vars' now-removed first-explicit-caller hijack [
    ## which used to do this as an accidental side effect -- see
    ## bug-crypt-c25519-key-vars-base-identity-hijack.md ] to make later bare
    ## crypt.C25519.sign_data calls [ e.g. via source.sign_data,
    ## source.fill_source_template ] resolve to the right key.  MUST be an
    ## unconditional override, not //= -- crypt.C25519.post_init's own bare
    ## startup call already set base_key_name to '<user>.base' by the time
    ## this runs, so //= would silently no-op and leave the wrong identity
    ## in place
    <crypt.C25519.base_key_name> = $sigkey_name;

    ## also invalidate the full-hashref key_vars cache -- its own early-return
    ## guard [ crypt.C25519.key_vars:9-15 ] only checks whether $key_name is
    ## undef/matches CURRENT base_key_name, never whether the CACHED hashref's
    ## own key_name still matches base_key_name.  changing base_key_name above
    ## does not by itself invalidate an already-populated cache from an
    ## earlier bare call [ e.g. this zenka's own post_init startup ], so a
    ## later bare key_vars() call [ sign_data's ] would otherwise keep serving
    ## the stale pre-override hashref forever.  same invalidation
    ## crypt.C25519.init_code already does once at startup, needed again here
    ## since base_key_name is changing mid-process
    delete <crypt.C25519.key_vars>;

} elsif ( not $sign_key_exists
    and <[base.cfg_bool]>->(<source.autocreate-sig-key>) ) {
    if ( <[crypt.C25519.gen_keys]>->($sigkey_name) ) {
        $success = TRUE
            if <[crypt.C25519.write_keys]>->( $sigkey_name, undef, FALSE );
    }

    <[base.log]>->(
        0, 'autocreate-sig-key not enabled, not creating signature key..,'
    ) if not $success;

}

##  todo : [more] silently load public key for verification only  ##

return $success;

