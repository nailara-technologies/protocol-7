## [:< ##

# name  = site-yaml.init_code
# descr = initialize site-yaml zenka, load http client

map { <[base.perlmod.autoload]>->($ARG) }
    qw| LWP::UserAgent HTTP::Request JSON YAML::XS HTML::Entities |;

## http user agent : reused across requests
$data{'site-yaml'}{'ua'} = LWP::UserAgent->new(
    'agent' =>
        'Mozilla/5.0 (X11; Linux x86_64; rv:124.0) Gecko/20100101 Firefox/124.0',
    'timeout' => 30,
);
$data{'site-yaml'}{'ua'}
    ->default_header( 'Accept-Language' => 'de-DE,de;q=0.9,en;q=0.8' );
$data{'site-yaml'}{'ua'}
    ->default_header( 'Accept' => 'text/html,application/xhtml+xml' );

## enable proxy from environment variables (HTTP_PROXY / HTTPS_PROXY) ##
$data{'site-yaml'}{'ua'}->env_proxy;

## bypass proxy for known direct-access domains [ configurable, default false ] ##
if ( <[base.cfg_bool]>->( <site-yaml.bypass_proxy> // FALSE ) ) {
    $data{'site-yaml'}{'ua'}->no_proxy(qw| stepstone.de www.stepstone.de |);
}

## init fetch queue state ##
<[site-yaml.fetch.state]>->('load');

## pre-populate job store with known IDs from disk : prevents re-fetching known jobs ##
my $jobs_dir = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite jobs |;
if ( opendir my $dh, $jobs_dir ) {
    my $known = 0;
    $data{'jobs'}{'store'} //= {};
    while ( my $f = readdir $dh ) {
        next unless $f =~ s|\.yaml$||;
        $data{'jobs'}{'store'}{$f}
            //= {};    ## placeholder : prevents refetch ##
        $known++;
    }
    closedir $dh;
    <[base.logs]>->( 1, 'site-yaml: %d known job ids pre-loaded', $known );
}

<[base.logs]>->( 1, 'site-yaml ready' );

