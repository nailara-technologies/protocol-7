## [:< ##

# name  = job-site-scan.cmd.scan
# descr = trigger a scan cycle manually

my $reply_id = $call->{'reply_id'};

if ( $data{'jss.cycle'} ne 'idle' ) {
    return <[base.callback.cmd_reply]>->(
        $reply_id,
        {   'mode' => 'false',
            'data' =>
                sprintf( 'cycle already active: %s', $data{'jss.cycle'} ),
        }
    );
}

<[base.callback.cmd_reply]>->(
    $reply_id, { 'mode' => 'true', 'data' => 'scan started' }
);

<[job-site-scan.stage.fetch]>;

