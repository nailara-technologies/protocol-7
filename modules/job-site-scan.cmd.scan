## [:< ##

# name  = job-site-scan.cmd.scan
# descr = trigger a scan cycle manually
# param = [:full:]

my $args      = $call->{'args'} // '';
my $full_mode = ( $args =~ m{:full:} ) ? TRUE : FALSE;

if ( <job-site-scan.cycle> ne qw| idle | ) {
    return {
        'mode' => qw| false |,
        'data' =>
            sprintf( 'cycle already active : %s', <job-site-scan.cycle> ),
    };
}

<[job-site-scan.stage.fetch]>->($full_mode);

my $msg = $full_mode ? 'full scan started' : 'scan started';
return { 'mode' => qw| true |, 'data' => $msg };

