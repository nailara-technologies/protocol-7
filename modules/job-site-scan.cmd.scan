## [:< ##

# name  = job-site-scan.cmd.scan
# descr = trigger a scan cycle manually

if ( $data{'jss.cycle'} ne 'idle' ) {
    return <[base.protocol-7.command.cmd_reply]>->(
        {   'mode' => FALSE,
            'data' => sprintf 'cycle already active: %s',
            $data{'jss.cycle'},
        }
    );
}

<[base.protocol-7.command.cmd_reply]>
    ->( { 'mode' => TRUE, 'data' => 'scan started' } );

<[job-site-scan.stage.fetch]>;

