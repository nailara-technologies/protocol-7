## [:< ##

# name  = coding.self_test.evaluate
# descr = check answer against expected; returns TRUE/FALSE

my $params   = shift                 // {};
my $model_id = $params->{'model_id'} // '';
my $prompt   = $params->{'prompt'}   // '';
my $answer   = $params->{'answer'}   // '';
my $expected = $params->{'expected'} // '';

## trim and case-fold both sides ##
$answer =~ s/^\s+//;
$answer =~ s/\s+$//;
$answer = lc $answer;

$expected =~ s/^\s+//;
$expected =~ s/\s+$//;
$expected = lc $expected;

if ( $answer eq $expected ) {
    return { mode => qw| true |, data => $answer };
}

## mismatch: ask the model to explain its reasoning ##
my $anomaly   = '';
my $follow_up = <[coding.self_test.follow_up]>->(
    {   model_id => $model_id,
        prompt   => $prompt,
        answer   => $answer,
    }
);

if ( $follow_up && $follow_up->{'mode'} eq qw| true | ) {
    $anomaly = $follow_up->{'data'} // '';
}

return {
    mode    => qw| false |,
    data    => 'mismatch',
    anomaly => $anomaly,
};

