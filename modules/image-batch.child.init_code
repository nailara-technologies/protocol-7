## [:< ##

# name = image-batch.child.init_code
# descr = Child process initialization with module loading

# Load required Perl modules for child process
<[base.perlmod.load]>->( 'JSON::XS', qw| encode_json decode_json | );
<[base.perlmod.load]>->( 'Storable', qw| freeze thaw | );

<[base.disable_command]>->('verify-instance');     ## no longer required ##
<[base.disable_command]>->('register-master-key'); ##LLL: make more generic ##

<[base.log]>->( 1, 'child process initialization complete .,' );

return TRUE;

