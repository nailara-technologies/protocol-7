## [:< ##

# name  = space.jump.cache.read
# descr = read cached next hop from branch.route.cache
# param = { hop, target }

my $params = shift               // {};
my $hop    = $params->{'hop'}    // '';
my $target = $params->{'target'} // '';

return undef unless length $hop and length $target;

return $data{'branch.route.cache'}{$hop}{$target};

