## [:< ##

# name = index.deduplicate
# descr = detect repeating sequences and promote to higher-order tokens

my $src      = shift // $ARG;
my $text     = ref $src ? $src->$* : $src;
my $max_win  = <index.meta>->{'max_window'} // 8;
my $min_win  = 2;
my $text_len = length $text;

## ring-0 terminal tracking ##
for ( my $pos = 0; $pos + 1 <= $text_len; $pos++ ) {
    my $seq = substr( $text, $pos, 1 );
    next if $seq eq ' ';
    my $end = $pos + 1;
    if ( $end == $text_len
        or substr( $text, $end, 1 ) =~ m|[ \n\r\t]| ) {
        <index.terminal>->{$seq} = 1;
    }
}

for my $win ( $min_win .. $max_win ) {
    for ( my $pos = 0; $pos + $win <= $text_len; $pos++ ) {
        my $seq = substr( $text, $pos, $win );
        next if $seq =~ m| |;    ## skip sequences containing space ##
        <index.level>->{$win}{$seq}++;

        ## boundary check: true terminal if followed by space or EOS ##
        my $end = $pos + $win;
        if ( $end == $text_len
            or substr( $text, $end, 1 ) =~ m|[ \n\r\t]| ) {
            <index.terminal>->{$seq} = 1;
        }
    }
}

## ranking and trie build are handled by index.rank ##

