## [:< ##

# name = nshell.render.full_line
# descr = Unified full-line redraw with cursor
#         [ delegates to viewport renderer ]
#         always resets view_offset to 0 so history entries
#         display from the start

my ( $editor, $display_buffer, $colors ) = @_;

## reset horizontal scroll position when loading new content
## (history, search, ctrl+o)
my $state_ref = $data{'nshell'}{'state'} //= {};
$state_ref->{'view_offset'} = 0;

## viewport render handles both normal and overflow cases
<[nshell.render.viewport]>->( $editor, $colors );

return;

