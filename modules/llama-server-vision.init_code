## [:< ##

# name  = llama-server-vision.init_code
# descr = GPU-accelerated vision analysis with job dispatch architecture

<[base.log]>->( 1, 'llama-server-vision zenka starting.,' );

# Imager module will be loaded in analyze_image command when needed

# Vision model binary and library configuration
<llama-server-vision.binary> = '/data/source/ik_llama.cpp/llama-mtmd-cli-cuda';
<llama-server-vision.lib_path> = '/data/source/ik_llama.cpp';
<llama-server-vision.log_file> = '/var/log/protocol-7/llama-server-vision.log';

# Vision model with multimodal support (Qwen3-VL-4B - optimized for memory)
<llama-server-vision.vision_model_path> = '/mnt/ext-xfs-data/models-lmstudio/lmstudio-community/Qwen3-VL-4B-Instruct-GGUF/Qwen3-VL-4B-Instruct-Q4_K_M.gguf';
<llama-server-vision.vision_mmproj_path> = '/mnt/ext-xfs-data/models-lmstudio/lmstudio-community/Qwen3-VL-4B-Instruct-GGUF/mmproj-Qwen3-VL-4B-Instruct-F16.gguf';

<[base.logs]>->( 1, "Vision binary: %s", <llama-server-vision.binary> );

# Verify model files exist
my $model_path = <llama-server-vision.vision_model_path>;
unless ( -f $model_path ) {
    <[base.logs]>->( 0, "ERROR: Vision model not found: %s", $model_path );
    return 0;
}

my $mmproj_path = <llama-server-vision.vision_mmproj_path>;
unless ( -f $mmproj_path ) {
    <[base.logs]>->( 0, "ERROR: Multimodal projection not found: %s", $mmproj_path );
    return 0;
}

<[base.logs]>->( 1, "Vision model: %s", $model_path );
<[base.logs]>->( 1, "Multimodal proj: %s", $mmproj_path );

# Initialize job queue for vision analysis tasks
<llama-server-vision.jobs> //= {};

# Initialize timers hash for process watchers
<llama-server-vision.timers> //= {};

# Initialize batch queue for request batching (amortizes model loading)
<llama-server-vision.batch_queue> //= [];
<llama-server-vision.batch_timer> = undef;
<llama-server-vision.batch_window_ms> = 100;  # Collect requests for 100ms before processing

<[base.logs]>->( 1, "Vision job dispatch system initialized.," );
<[base.logs]>->( 1, "Batch processing enabled (window: %dms)", <llama-server-vision.batch_window_ms> );

# Image scaling configuration (vision models typically expect 224-1024 range)
<llama-server-vision.max_image_width> = 1024;  # Scale down if wider
<llama-server-vision.max_image_height> = 1024;  # Scale down if taller
# Temp files are managed by base.file.temp with automatic cleanup via end_code callbacks

0;  # Return success for module initialization

