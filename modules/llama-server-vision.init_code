## [:< ##

# name  = llama-server-vision.init_code
# descr = GPU-accelerated vision analysis with job dispatch architecture

<[base.log]>->( 1, 'llama-server-vision zenka starting.,' );

# Imager module will be loaded in analyze_image command when needed

# Vision model binary and library configuration
<llama-server-vision.binary>
    = '/data/source/ik_llama.cpp/llama-mtmd-cli-cuda';
<llama-server-vision.lib_path> = '/data/source/ik_llama.cpp';
<llama-server-vision.log_file>
    = '/var/log/protocol-7/llama-server-vision.log';
<llama-server-vision.log_dir>  = '/var/log/protocol-7';
<llama-server-vision.log_mask> = 0750;

# Ensure log directory exists with proper permissions (only if running as root)
if ( $EUID == 0 ) {
    <[base.perlmod.load]>->( 'File::Path', qw| make_path | );
    <[file.make_path]>->(
        <llama-server-vision.log_dir>, <llama-server-vision.log_mask>,
        <system.amos-zenka-user>
        )
        and <[base.logs]>->(
        1, "[llama-server-vision] Created log directory [%s/]",
        <llama-server-vision.log_dir>
        ) if !-d <llama-server-vision.log_dir>;
}

# Load vision model configuration from centralized models.yaml
<[base.logs]>->(
    1, "[llama-server-vision] Loading vision model config from models.yaml"
);

<[base.perlmod.autoload]>->(qw| YAML::Tiny |);

my $config_file = <system.conf_path> . '/zenki/models/models.yaml';

my $model_path  = undef;
my $mmproj_path = undef;

if ( -f $config_file ) {
    my $yaml_content = <[file.slurp]>->($config_file);

    if ($yaml_content) {
        my $yaml = YAML::Tiny::Load($$yaml_content);

        if (   $yaml
            && exists $yaml->{models}
            && exists $yaml->{models}->{'qwen3-vl-4b-instruct'} ) {
            my $model_def = $yaml->{models}->{'qwen3-vl-4b-instruct'};
            $model_path  = $model_def->{path};
            $mmproj_path = $model_def->{mmproj};
        } else {
            <[base.log]>->(
                0,
                "[llama-server-vision] Error: qwen3-vl-4b-instruct not found in models.yaml"
            );
        }
    }
} else {
    <[base.log]>->(
        0,
        "[llama-server-vision] Error: models.yaml not found at $config_file"
    );
}

if ( $model_path && $mmproj_path ) {

    # Trust YAML-defined model paths from models registry
    <llama-server-vision.vision_model_path>  = $model_path;
    <llama-server-vision.vision_mmproj_path> = $mmproj_path;

    <[base.logs]>->(
        1, "[llama-server-vision] Vision model configured: %s", $model_path
    );
} else {
    <llama-server-vision.vision_model_path>  = undef;
    <llama-server-vision.vision_mmproj_path> = undef;

    <[base.log]>->(
        0,
        "[llama-server-vision] Error: Vision model configuration incomplete - check models.yaml"
    );
}

<[base.logs]>->( 1, "Vision binary: %s", <llama-server-vision.binary> );
<[base.logs]>->(
    1,
    "Vision model configuration will be fetched from models zenka at runtime"
);

# Initialize job queue for vision analysis tasks
<llama-server-vision.jobs> //= {};

# Initialize timers hash for process watchers
<llama-server-vision.timers> //= {};

# Initialize batch queue for request batching (amortizes model loading)
<llama-server-vision.batch_queue> //= [];
<llama-server-vision.batch_timer> = undef;
<llama-server-vision.batch_window_ms>
    = 100;    # Collect requests for 100ms before processing

<[base.logs]>->( 1, "Vision job dispatch system initialized.," );
<[base.logs]>->(
    1,
    "Batch processing enabled (window: %dms)",
    <llama-server-vision.batch_window_ms>
);

# Image scaling configuration (vision models typically expect 224-1024 range)
<llama-server-vision.max_image_width>  = 1024;    # Scale down if wider
<llama-server-vision.max_image_height> = 1024;    # Scale down if taller

# Temp files are managed by base.file.temp with automatic cleanup via end_code callbacks

0;    # Return success for module initialization

