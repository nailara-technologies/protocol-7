# name = data.get.resolve_physical
# desc: Resolve physical module paths

my ( $path, $args, $classification ) = @ARG;
my $module_path = $classification->{'module_path'}
    // <[data.get.path_to_module]>->($path);

my $result = <[devmod.cmd.get]>->( $path, @$args );

return {
    'value'       => $result,
    'module_path' => $module_path,
    'cached'      => 0,
};

