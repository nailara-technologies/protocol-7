## [:< ##

# name  = mpv.cmd.stop
# descr = stop playback [clears playlist]

push( @{<mpv.reply_ids>}, $call->{'reply_id'} );
<mpv.success_reply_str> = 'playback stopped';

<[mpv.send_command]>->('stop');

## core-idle no longer runs mpv.callback.silenced on our behalf [ see   ##
## mpv.handler.event.property-change.core-idle -- pause/resume now own  ##
## their own sequencing and that event fired too late to be useful for  ##
## those ], so stop -- which doesn't go through that dedicated fade-out ##
## chain -- still needs to call it directly, same as before.,           ##
<[mpv.callback.silenced]> if <mpv.fade_idle_volume>;

<[protocol-7.command.send.local]>->( { 'command' => "cube.report_paused" } )
    if <system.zenka.mode> eq 'universal-child';

return { 'mode' => qw| deferred | };

