## [:< ##

# name  = httpsd.register_socket
# param = $socket, $type, $mode
# descr = Register SSL socket in data structure for handler connection lookup
# note  = Called after SSL socket creation since httpsd.create_ssl_socket doesn't
#         register the socket like base.open does. This ensures base.handler.connect
#         can find the handler definitions when a connection arrives.

my $socket = shift;
my $type   = shift;
my $mode   = shift;

unless ( defined $socket and fileno($socket) ) {
    <[base.logs]>->( 0, "httpsd.register_socket: invalid socket supplied" );
    return undef;
}

unless ( defined $type and defined $mode ) {
    <[base.logs]>->( 0, "httpsd.register_socket: missing type or mode parameter" );
    return undef;
}

my $fd = fileno($socket);

## Register socket in handle data structure using both socket reference AND file descriptor
## Socket reference is used by base.protocol.bind, numeric FD is used by handler connection lookup
$data{'handle'}{$socket}{'link'}      = $type;
$data{'handle'}{$socket}{'mode'}      = $mode;
$data{'handle'}{$socket}{'protocol'}  = 'https';

$data{'handle'}{$fd}{'link'}      = $type;
$data{'handle'}{$fd}{'mode'}      = $mode;
$data{'handle'}{$fd}{'protocol'}  = 'https';

<[base.logs]>->( 2, "httpsd.register_socket: registered fd=$fd using both socket ref and numeric fd" );
<[base.logs]>->( 3, "  type=$type mode=$mode protocol=https" );

return 1;

0;

