## [:< ##

# name  = jobsite.sync.push
# descr = start chunked async http push — sends changed jobs in small batches

return if <jobsite.sync.push_in_progress>;

my $url = <jobsite.cfg.sync_url> // '';
if ( not length $url ) {
    <[base.logs]>->( 0, 'jss.sync.push: no sync_url configured' );
    return;
}

my $jobs       = <[jobsite.job.load_all]>;
my $last_ntime = <jobsite.sync.last_server_ntime> // '';

## filter to jobs changed since server last acknowledged ##
my @changed;
for my $id ( keys %{ $jobs // {} } ) {
    my $job = $jobs->{$id};
    my $mod = $job->{'last_modified'} // '';
    if ( not length $last_ntime or $mod gt $last_ntime ) {
        push @changed, { %{$job}, 'id' => $id };
    }
}

if ( not @changed ) {
    <[base.logs]>->( 2, 'jobsite: sync push skipped [ no changes ]' );
    return;
}

## split into chunks to stay well within session buffer limits ##
my $chunk_size = <jobsite.cfg.sync_chunk_size> // 30;
my @chunks;
while (@changed) {
    push @chunks, [ splice @changed, 0, $chunk_size ];
}

<jobsite.sync.push_in_progress> = TRUE;
<jobsite.sync.push_chunks>      = \@chunks;
<jobsite.sync.push_reverse>     = [];

<[base.logs]>->(
    1, 'jobsite: sync push %d jobs in %d chunks',
    scalar( map { @{$ARG} } @chunks ),
    scalar @chunks,
);

<[jobsite.sync.push_chunk]>;

