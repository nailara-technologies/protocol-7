## [:< ##

# name  = jobsite.sync.push
# descr = start chunked async http push — sends changed jobs in small batches

return if <jobsite.sync.push_in_progress>;

my $url = <jobsite.cfg.sync_url> // '';
if ( not length $url ) {
    <[base.logs]>->( 0, 'jss.sync.push: no sync_url configured' );
    return;
}

my $jobs       = <[jobsite.job.load_all]>;
my $last_ntime = <jobsite.sync.last_server_ntime> // '';

## record local ntime at cycle start — used as new watermark after success ##
my $cycle_ntime_b32 = <[base.ntime.b32]>;
<jobsite.sync.push_cycle_ntime> = $cycle_ntime_b32;

## ntime is encode_b32r (reverse byte order) — NOT lexicographically sortable ##
## must compare numerically via base.ntime_BASE32_to_numerical               ##
my $last_ntime_num
    = length($last_ntime)
    ? ( <[base.ntime_BASE32_to_numerical]>->($last_ntime) // 0 )
    : 0;

## filter to jobs changed since last sync watermark ##
my @changed;
for my $id ( keys %{ $jobs // {} } ) {
    my $job = $jobs->{$id};
    my $mod = $job->{'last_modified'} // '';
    my $mod_num
        = length($mod)
        ? ( <[base.ntime_BASE32_to_numerical]>->($mod) // 0 )
        : 0;
    if ( not $last_ntime_num or $mod_num > $last_ntime_num ) {
        push @changed, { %{$job}, 'id' => $id };
    }
}

if ( not @changed ) {
    <[base.logs]>->(
        1,
        'jobsite: sync push skipped [ no changes since %s ]',
        <jobsite.sync.last_server_ntime>
    );
    return;
}

## split into chunks to stay well within session buffer limits ##
my $chunk_size = <jobsite.cfg.sync_chunk_size> // 30;
my @chunks;
while (@changed) {
    push @chunks, [ splice @changed, 0, $chunk_size ];
}

<jobsite.sync.push_in_progress> = TRUE;
<jobsite.sync.push_chunks>      = \@chunks;
<jobsite.sync.push_reverse>     = [];

<[base.logs]>->(
    1,
    'jobsite: sync push %d jobs in %d chunks',
    scalar( map { @{$ARG} } @chunks ),
    scalar @chunks,
);

<[jobsite.sync.push_chunk]>;

