## [:< ##

# name  = jobsite.sync.push
# descr = start async http push cycle — one job per callback chain

return if <jobsite.sync.push_in_progress>;

my $url = <jobsite.cfg.sync_url> // '';
if ( not length $url ) {
    <[base.logs]>->( 0, 'jss.sync.push: no sync_url configured' );
    return;
}

my $jobs = <[jobsite.job.load_all]>;
my @ids  = keys %{ $jobs // {} };

if ( not @ids ) {
    <[jobsite.sync.apply_reverse]>->( [] );
    return;
}

<jobsite.sync.push_queue>       = \@ids;
<jobsite.sync.push_reverse>     = [];
<jobsite.sync.push_in_progress> = TRUE;

<[base.logs]>->( 1, 'jobsite: sync push starting, %d jobs', scalar @ids );

<[jobsite.sync.push_next]>->($jobs);

