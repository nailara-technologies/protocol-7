## [:< ##

# name  = jobsite.sync.push
# param = < event_object | ondef >, [ force (boolean) ]
# descr = start chunked async http push : sends changed jobs in small batches

my $force = ( @ARG > 1 ) ? <[base.cfg_bool]>->( $ARG[1] ) : FALSE;

return if <jobsite.sync.push_in_progress>;

my @urls = split /\s+/,
    ( <jobsite.cfg.sync_urls> || <jobsite.cfg.sync_url> || '' );
if ( not @urls ) {
    <[base.logs]>->( 0, 'jss.sync.push: no sync_url configured' );
    return;
}

my $jobs = <[jobsite.job.load_all]>;

## ensure status is set from index before push ##
for my $id ( keys %{$jobs} ) {
    my $idx_status = <jobsite.job.index>->{$id} // '';
    $idx_status =~ s{^(?:blocked|deleted):.*}{};
    $jobs->{$id}{'status'} = $idx_status if length $idx_status;
}

## record local ntime at cycle start : used as new watermark after success ##
my $cycle_ntime_b32 = <[base.ntime.b32]>;
<jobsite.sync.push_cycle_ntime> = $cycle_ntime_b32;

my @push_queue;
my @pushed_urls;

for my $url (@urls) {
    next unless length $url;

    my $last_ntime = <jobsite.sync.last_ntime>->{$url} // '';
    ## fallback to scalar for backward compat ##
    $last_ntime = <jobsite.sync.last_server_ntime> // ''
        if not length $last_ntime;

    ## ntime is encode_b32r [reverse byte order] : NOT lexicographically sortable ##
    ## must compare numerically via base.ntime_BASE32_to_numerical                ##
    my $last_ntime_num
        = length($last_ntime)
        ? ( <[base.ntime_BASE32_to_numerical]>->($last_ntime) // 0 )
        : 0;

    $last_ntime_num = 0 if $force;    ## manual sync : bypass watermark ##

    ## filter to jobs changed since last sync watermark ##
    my @changed;
    for my $id ( keys %{ $jobs // {} } ) {
        my $job = $jobs->{$id};
        next if ( $job->{'status'} // '' ) =~ m{^(?:blocked|deleted)$};
        my $mod = $job->{'last_modified'} // '';
        my $mod_num
            = length($mod)
            ? ( <[base.ntime_BASE32_to_numerical]>->($mod) // 0 )
            : 0;
        if ( not $last_ntime_num or $mod_num > $last_ntime_num ) {
            push @changed, { %{$job}, 'id' => $id };
        }
    }

    next if not @changed;

    ## split into chunks to stay well within session buffer limits ##
    my $chunk_size = <jobsite.cfg.sync_chunk_size> // 30;
    while (@changed) {
        push @push_queue,
            {
            'url'   => $url,
            'since' => $last_ntime,
            'chunk' => [ splice @changed, 0, $chunk_size ],
            };
    }
    push @pushed_urls, $url;
}

if ( not @push_queue ) {
    ## no local changes: still ping to collect reverse entries from web side ##
    <[base.logs]>->(
        2,
        'jobsite: sync ping [ no local changes since %s ]',
        <jobsite.sync.last_server_ntime>
    );
    for my $url (@urls) {
        push @push_queue,
            {
            'url'   => $url,
            'since' => (
                <jobsite.sync.last_ntime>->{$url}
                    // <jobsite.sync.last_server_ntime> // ''
            ),
            'chunk' => []
            };
        push @pushed_urls, $url;
    }
}

my $total_jobs = 0;
$total_jobs += scalar @{ $ARG->{'chunk'} } for @push_queue;

<[base.logs]>->(
    1, 'jobsite: sync push %d jobs in %d chunks to %d url(s)',
    $total_jobs,
    scalar @push_queue,
    scalar @pushed_urls,
);

<jobsite.sync.push_in_progress> = TRUE;
<jobsite.sync.push_queue>       = \@push_queue;
<jobsite.sync.push_urls>        = \@pushed_urls;
<jobsite.sync.push_reverse>     = [];

<[jobsite.sync.push_chunk]>;

