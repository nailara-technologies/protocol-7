## [:< ##

# name = models.discover.scan_directory
# args = $directory_path, $recursive [default: TRUE]
# descr = Recursively scan directory for .gguf model files

my $dir        = shift;
my $do_recurse = shift // TRUE;
my @models;

if ( not defined $dir ) {
    warn '[[ expected directory path as first parameter ]] <{C1}>';
    return undef;
}

opendir( my $dh, $dir ) or return \@models;

while ( my $entry = readdir($dh) ) {
    next if $entry =~ m|^\.|;
    my $full_path = catfile( $dir, $entry );

    if ( -f $full_path && $entry =~ m|\.gguf$| ) {
        my $size_bytes   = -s $full_path;
        my $size_gb      = $size_bytes / ( 1024**3 );
        my ($model_name) = $entry =~ m|^(.+)\.gguf$|i;

        ## Detect vision models by filename patterns
        my $is_vision = 0;
        $is_vision = 1 if $model_name =~ m{vl|vision}i;

        ## Handle mmproj files (vision projectors) specially  mmproj can be at
        ## start (mmproj-xxx.gguf) or embedded (xxx.mmproj-f16.gguf)
        my $is_mmproj = 0;
        if ( $model_name =~ m{(?:^|[-._])mmproj}i ) {
            $is_mmproj = 1;
            $is_vision = 1;    ## mmproj files are always vision-related
        }

        ## Check for companion mmproj file in same directory
        my $mmproj_path = '';
        if ( !$is_mmproj ) {
            my $model_dir = $full_path;
            $model_dir =~ s|/[^/]+$||;
            my @mmproj_files = glob( catfile( $model_dir, '*mmproj*.gguf' ) );
            if (@mmproj_files) {
                $mmproj_path = $mmproj_files[0];
                $is_vision   = 1;
            }
        }

        ## Extract quantization from filename (e.g., Q4_K_M, Q6_K, Q8_0,
        ## IQ4_XS) Handles: Q4_K_M-imat, Q4_K_S-imatrix, Q6_K, IQ4_XS, etc.
        my $quantization = 'unknown';
        my $clean_name   = $model_name;

        ## For mmproj files, quantization is always mmproj
        if ($is_mmproj) {
            $quantization = 'mmproj';
            ## Strip mmproj and surrounding separators from anywhere in name
            $clean_name =~ s{(?:^|[-._])mmproj[-._]?}{}gi;
            $clean_name =~ s|[-._]+$||;
        }
        ## Match quantization pattern: Q or IQ, number 2-8, optional _K_M
        ## suffix
        elsif ( $clean_name =~ m|([IQ][2-8](?:_[A-Z]+)+)|i ) {
            $quantization = uc($1);

            ## Remove quant and everything after it (including -imat/imatrix)
            $clean_name =~ s|[-_]?[IQ][2-8](?:_[A-Z]+)+.*$||i;
            $clean_name =~ s|[-_]+$||;
        } elsif ( $clean_name =~ m{([IQ][2-8])(?:[-_]|$)}i ) {
            ## Simple Q6, Q8, etc. (without suffix)
            $quantization = uc($1);
            $clean_name =~ s|[-_]?[IQ][2-8]||i;
            $clean_name =~ s|[-_]+$||;
        }

        ## Get proper model name using smart extraction  Also get
        ## file_type-based quantization as fallback
        my ( $gguf_name, $file_type_quant )
            = <[models.gguf.file.extract_name]>->($full_path);

        ## Use file_type quantization if filename didn't provide one
        $quantization = $file_type_quant
            if $quantization eq 'unknown' && $file_type_quant;

        push @models,
            {
            path         => $full_path,
            name         => $gguf_name,
            size_gb      => sprintf( qw| %.3f |, $size_gb ),
            quantization => $quantization,
            source       => qw| discovered |,
            is_vision    => $is_vision,
            mmproj_path  => $mmproj_path
            };
    } elsif ( -d $full_path && $do_recurse ) {

        # Skip system directories
        next if $entry =~ m{^(System|\.\$)}i;

        # Recursive scan
        my $sub_models
            = <[models.discover.scan_directory]>->( $full_path, TRUE );
        push @models, $sub_models->@* if $sub_models;
    }
}
closedir($dh);

return \@models;

