## [:< ##

# name  = graphics-matrix.orbital.push_state_if_subscribed
# descr = push current cells/glow/graph/channel summary to STRM subscribers
#
# notes = called on its own slow timer [ see graphics-matrix.init_code ]
#         since no discrete mutation event covers this summary ; no-ops
#         [ cheap check only ] when nobody is subscribed

return
    unless <[base.cfg_bool]>->(<graphics-matrix.cfg.orbital_push_enabled>);
return
    unless defined <graphics-matrix.orbital.listeners>
    and @{<graphics-matrix.orbital.listeners>};

my $payload = <[graphics-matrix.orbital.build_summary]> . "\n";

my @keep;
for my $h ( @{<graphics-matrix.orbital.listeners>} ) {
    if ( <[base.stream.push]>->( $h, \$payload ) ) {
        push @keep, $h;
    } else {
        <[base.stream.close]>->($h);  ## clean up base-level producer state ##
    }
}
<graphics-matrix.orbital.listeners> = \@keep;

return TRUE;

