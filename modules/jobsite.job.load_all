## [:< ##

# name  = jobsite.job.load_all
# descr = load all job records from per-file storage

my $jobs_dir = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite jobs |;
my %jobs;

if ( -d $jobs_dir ) {
    opendir my $dh, $jobs_dir or return \%jobs;
    my @files = grep { /\.yaml$/ && !/^\./ } readdir($dh);
    closedir $dh;

    for my $file (@files) {
        my $job_id = $file;
        $job_id =~ s/\.yaml$//;

        my $job_file = "$jobs_dir/$file";
        my $job      = eval { YAML::XS::LoadFile($job_file) };
        if ($@) {
            <[base.logs]>->(
                0,     'jss.load_all: error loading %s: %s',
                $file, $@
            );
            next;
        }
        $jobs{$job_id} = $job if ref $job eq 'HASH';
    }
}

return \%jobs;

