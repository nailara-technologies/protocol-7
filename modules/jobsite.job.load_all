## [:< ##

# name  = jobsite.job.load_all
# descr = load all active job records from status-directory storage

my $jobs_root = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite jobs |;

my %jobs;
my $index = {};
my @active_statuses
    = qw| new assessed review apply applied interviewed rejected |;

for my $status (@active_statuses) {
    my $dir = "$jobs_root/$status";
    next if not -d $dir;
    opendir my $dh, $dir or next;
    my @files = grep { /\.yaml$/ && !/^\./ } readdir($dh);
    closedir $dh;

    for my $file (@files) {
        my $job_id = $file;
        $job_id =~ s/\.yaml$//;

        my $job_file = "$dir/$file";
        my $job      = eval { YAML::XS::LoadFile($job_file) };
        if ($@) {
            <[base.logs]>->(
                0,         'jss.load_all: error loading %s: %s',
                $job_file, $@
            );
            next;
        }
        next unless ref $job eq 'HASH';
        $jobs{$job_id} = $job;
        $index->{$job_id} = $status;
    }
}

## also index blocked/deleted for completeness, but don't load content ##
my @epoch_statuses = qw| blocked deleted |;
for my $status (@epoch_statuses) {
    my $dir = "$jobs_root/$status";
    next if not -d $dir;
    opendir my $dh, $dir or next;
    for my $epoch_dir ( grep { !/^\./ && -d "$dir/$_" } readdir($dh) ) {
        opendir my $edh, "$dir/$epoch_dir" or next;
        for my $fn ( grep { /\.yaml$/ && !/^\./ } readdir($edh) ) {
            my $job_id = $fn;
            $job_id =~ s/\.yaml$//;
            $index->{$job_id} = "$status:$epoch_dir";
        }
        closedir $edh;
    }
    closedir $dh;
}

<jobsite.job.index> = $index;

<[base.logs]>->(
    2,
    'jss.load_all: loaded %d active jobs, index=%d',
    scalar keys %jobs,
    scalar keys %{$index}
) if scalar keys %jobs;

## populate in-memory task map from loaded job YAMLs ##
for my $id ( keys %jobs ) {
    my $job = $jobs{$id};
    <jobsite.tasks>->{$id} = {
        'status'           => $job->{'status'}           // 'new',
        'stage'            => $job->{'stage'}            // '',
        'score'            => $job->{'score'}            // '',
        'repair_attempted' => $job->{'repair_attempted'} // FALSE,
        'repair_failed'    => $job->{'repair_failed'}    // FALSE,
    };
}

## directory name is the authoritative status ##
my $tasks = <jobsite.tasks> // {};
for my $id ( keys %{$tasks} ) {
    my $dir_status = $index->{$id} // '';
    ## strip epoch prefix for blocked/deleted ##
    $dir_status =~ s{^(blocked|deleted):.*}{$1};
    $tasks->{$id}{'status'} = $dir_status if length $dir_status;
}

return \%jobs;

