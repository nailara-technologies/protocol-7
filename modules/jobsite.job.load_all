## [:< ##

# name  = jobsite.job.load_all
# descr = load all active job records from status-directory storage

my $jobs_root = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite jobs |;

my %jobs;
my $index = {};
my @active_statuses
    = qw| new assessed review apply applied interviewed rejected skipped |;

for my $status (@active_statuses) {
    my $dir = "$jobs_root/$status";
    next if not -d $dir;
    opendir my $dh, $dir or next;
    my @files = grep { /\.yaml$/ && !/^\./ } readdir($dh);
    closedir $dh;

    for my $file (@files) {
        my $enc_id = $file;
        $enc_id =~ s/\.yaml$//;
        my $job_id = <[base.vax-int.decode]>->($enc_id);

        my $job_file = "$dir/$file";
        my $job      = eval { YAML::XS::LoadFile($job_file) };
        if ($@) {
            <[base.logs]>->(
                0,         'jss.load_all: error loading %s: %s',
                $job_file, $@
            );
            next;
        }
        next unless ref $job eq 'HASH';
        $jobs{$job_id} = $job;
        $index->{$job_id} = $status;
    }
}

## also index blocked/deleted/trash for completeness, but don't load content ##
my @epoch_statuses = qw| blocked deleted |;
for my $status (@epoch_statuses) {
    my $dir = "$jobs_root/$status";
    next if not -d $dir;
    opendir my $dh, $dir or next;
    for my $epoch_dir ( grep { !/^\./ && -d "$dir/$_" } readdir($dh) ) {
        opendir my $edh, "$dir/$epoch_dir" or next;
        for my $fn ( grep { /\.yaml$/ && !/^\./ } readdir($edh) ) {
            my $enc_id = $fn;
            $enc_id =~ s/\.yaml$//;
            my $job_id = <[base.vax-int.decode]>->($enc_id);
            $index->{$job_id} = "$status:$epoch_dir";
        }
        closedir $edh;
    }
    closedir $dh;
}

## index compressed trash files (.yxz.B32) ##
my $trash_root = "$jobs_root/trash";
if ( -d $trash_root ) {
    opendir my $dh, $trash_root or goto TRASH_DONE;
    for my $epoch_dir ( grep { !/^\./ && -d "$trash_root/$_" } readdir($dh) )
    {
        opendir my $edh, "$trash_root/$epoch_dir" or next;
        for my $fn ( grep { /\.yxz\.B32$/ && !/^\./ } readdir($edh) ) {
            my $enc_id = $fn;
            $enc_id =~ s/\.yxz\.B32$//;
            my $job_id = <[base.vax-int.decode]>->($enc_id);
            $index->{$job_id} = "trash:$epoch_dir";
        }
        closedir $edh;
    }
    closedir $dh;
}
TRASH_DONE:

<jobsite.job.index> = $index;

<[base.logs]>->(
    2,
    'jss.load_all: loaded %d active jobs, index=%d',
    scalar keys %jobs,
    scalar keys %{$index}
) if scalar keys %jobs;

## populate in-memory task map from loaded job YAMLs ##
##
## an in-flight marker ('queued'/'assessing') only ever exists in memory --
## a still-'new' job on disk has no 'stage' field yet, so refreshing stage
## unconditionally from the file wipes the marker dispatch.assessments just
## set, moments before the task it dispatched even replies. that defeats
## dispatch.assessments' own "already in flight" skip-check, so a re-entrant
## call (settle-timer, or any repeat call while a batch is running) queues
## the same job again -- keep the in-flight marker, refresh everything else ##
for my $id ( keys %jobs ) {
    my $job           = $jobs{$id};
    my $prior_stage   = ( <jobsite.tasks>->{$id} // {} )->{'stage'} // '';
    my $keep_inflight = $prior_stage =~ m{^(?:queued|assessing)$};
    <jobsite.tasks>->{$id} = {
        'status' => $job->{'status'} // 'new',
        'stage'  => $keep_inflight ? $prior_stage : ( $job->{'stage'} // '' ),
        'score'            => $job->{'score'}            // '',
        'repair_attempted' => $job->{'repair_attempted'} // FALSE,
        'repair_failed'    => $job->{'repair_failed'}    // FALSE,
    };
}

## directory name is the authoritative status ##
my $tasks = <jobsite.tasks> // {};
for my $id ( keys %{$tasks} ) {
    my $dir_status = $index->{$id} // '';
    ## strip epoch prefix for blocked/deleted ##
    $dir_status =~ s{^(blocked|deleted):.*}{$1};
    $tasks->{$id}{'status'} = $dir_status if length $dir_status;
}

return \%jobs;

