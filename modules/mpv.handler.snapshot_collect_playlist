## [:< ##

# name  = mpv.handler.snapshot_collect_playlist
# descr = snapshot collect chain : playlist reply, then write snapshot

my $playlist_json = shift // '';

## same playlist property shape as mpv.handler.pipe.playlist ##
if ( length $playlist_json ) {
    my $playlist_data = eval { <mpv.json.parser>->decode($playlist_json) };
    if ( ref $playlist_data eq qw| ARRAY | and @{$playlist_data} ) {
        my @filenames;
        my $current_idx;
        foreach my $entry ( @{$playlist_data} ) {
            push( @filenames, $entry->{'filename'} );
            $current_idx = $#filenames
                if not defined $current_idx
                and ref $entry eq qw| HASH |
                and ( exists $entry->{'current'}
                or exists $entry->{'playing'} );
        }
        <mpv.snapshot.pending.playlist>         = \@filenames;
        <mpv.snapshot.pending.playlist_current> = $current_idx;
    }
}

<[mpv.snapshot.write]>;

return;

