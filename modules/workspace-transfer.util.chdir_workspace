# name  = workspace-transfer.util.chdir_workspace
# descr = change into workspace directory

our $WORKSPACE_DIR;

my $ws_dir = <[workspace-transfer.util.ensure_workspace]>->();
return undef unless defined $ws_dir;

chdir $ws_dir or do {
    <[base.logs]>->( 0, 'cannot cd to workspace: %s', $! );
    return undef;
};

return $ws_dir;

