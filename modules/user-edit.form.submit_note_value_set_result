## [:< ##

# name  = user-edit.form.submit_note_value_set_result
# descr = record the users.value-set leg of a fan-in submit
# param = $ok, $message

my ( $ok, $message ) = @ARG;

my $pending = <user-edit.form.submit_pending>;
return FALSE if ref $pending ne qw| HASH |;    ## late/duplicate reply ##

$pending->{'value_set_ok'}  = $ok;
$pending->{'value_set_msg'} = $message;
$pending->{'pending'}--;

<[user-edit.form.submit_maybe_finish]>;

return TRUE;

