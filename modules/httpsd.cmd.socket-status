# name = httpsd.cmd.socket-status
# descr = report SSL socket status and certificate availability
# return = { mode => 'true'|'false', data => status_information }

my $cert_file = <httpsd.cfg.certificate_path>;
my $key_file  = <httpsd.cfg.key_path>;

## check if socket has been created and is listening
my $socket_created = defined <httpsd.sock> && fileno(<httpsd.sock>);

if ($socket_created) {
    ## socket is created and listening - fully operational
    my $output = sprintf(
        "Status: operational\n"
            . "Description: HTTPS socket is listening and operational\n"
            . "Certificate: %s\n"
            . "Key: %s\n"
            . "TLS Version: %s",
        $cert_file               // 'not configured',
        $key_file                // 'not configured',
        <httpsd.cfg.tls_version> // 'TLSv1_3'
    );
    return { mode => qw| true |, data => $output };
} else {
    ## socket not yet created - check why
    my $cert_info = <[httpsd.check_certificate_available]>;

    if ( $cert_info->{available} ) {
        my $output = sprintf(
            "Status: ready_for_socket\n"
                . "Description: Certificate available but socket not yet created\n"
                . "Certificate: %s\n"
                . "Key: %s\n"
                . "Note: Socket creation deferred (non-root or startup timing)",
            $cert_file // 'not configured',
            $key_file  // 'not configured'
        );
        return { mode => qw| true |, data => $output };
    } else {
        my $retry_count = <httpsd.startup.retry_count> // 0;
        my $output      = sprintf(
            "Status: waiting_for_certificate\n"
                . "Description: Waiting for certificate provisioning from letsencr\n"
                . "Certificate: %s (not found)\n"
                . "Key: %s (not found)\n"
                . "Retry Count: %d\n"
                . "Action: Use 'p7c httpsd.socket-status' to check again",
            $cert_file // 'not configured',
            $key_file // 'not configured', $retry_count
        );
        return { mode => qw| false |, data => $output };
    }
}

0;

