## [:< ##

# name  = debian.cmd.scan
# descr = rescan all zenki for dependencies

<[base.log]>->( 2, "..rescanning zenki.." );

my $scan_result = <[debian.parent.scan_zenki_dependencies]>;

if ( !$scan_result->{'success'} ) {
    return {
        'mode' => qw| false |,
        'data' => $scan_result->{'error'} // 'scan failed'
    };
}

## Re-check installation status
<[debian.parent.check_installed]>;

my @output;
push @output, "Rescan complete:\n";
push @output, sprintf( "  Zenki: %d",        $scan_result->{'zenki_count'} );
push @output, sprintf( "  Dependencies: %d", $scan_result->{'deps_count'} );
push @output, "";
push @output, "Run 'check' to see installation status";
push @output, "Run 'install' to install missing dependencies";

return {
    'mode' => qw| size |,
    'data' => "\n" . join( "\n", @output ) . "\n"
};

