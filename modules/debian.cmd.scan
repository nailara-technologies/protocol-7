## [:< ##

# name  = debian.cmd.scan-zenki
# descr = Rescan all zenki for dependencies

<[base.log]>->( 2, "debian: rescanning zenki..." );

my $result = <[debian.parent.scan_zenki_dependencies]>;

if (!$result->{success}) {
    return {
        'mode' => qw| false |,
        'data' => $result->{error} || 'scan failed'
    };
}

## Re-check installation status
<[debian.parent.check_installed]>;

my @output;
push @output, "Rescan complete:";
push @output, sprintf("  Zenki: %d", $result->{zenki_count});
push @output, sprintf("  Dependencies: %d", $result->{deps_count});
push @output, "";
push @output, "Run 'check' to see installation status";
push @output, "Run 'install' to install missing dependencies";

return {
    'mode' => qw| true |,
    'data' => join("\n", @output)
};

