## [:< ##

# name = debian.parent.scan_zenki_dependencies
# descr = recursively scan all zenki for dependencies

# use File::Find qw| find |;

## Ensure registries are initialized
$data{'debian'}{'packages'}{'registry'}     //= {};
$data{'debian'}{'cpan_modules'}{'registry'} //= {};
$data{'debian'}{'binaries'}{'registry'}     //= {};
$data{'debian'}{'zenki_deps'}{'registry'}   //= {};
$data{'debian'}{'packages'}{'by_name'}      //= {};
$data{'debian'}{'cpan_modules'}{'by_name'}  //= {};
$data{'debian'}{'binaries'}{'by_name'}      //= {};
$data{'debian'}{'zenki_deps'}{'by_zenka'}   //= {};

## Ensure lists are initialized if not already
unless ( exists $data{'_list_meta'}{'debian-packages'} ) {
    <[base.list.init]>->(
        {   'name'         => qw| debian-packages |,
            'key_ref'      => \$data{'debian'}{'packages'}{'registry'},
            'max_elements' => 2048
        }
    );
}

unless ( exists $data{'_list_meta'}{'cpan-modules'} ) {
    <[base.list.init]>->(
        {   'name'         => qw| cpan-modules |,
            'key_ref'      => \$data{'debian'}{'cpan_modules'}{'registry'},
            'max_elements' => 4096
        }
    );
}

unless ( exists $data{'_list_meta'}{'binary-dependencies'} ) {
    <[base.list.init]>->(
        {   'name'         => qw| binary-dependencies |,
            'key_ref'      => \$data{'debian'}{'binaries'}{'registry'},
            'max_elements' => 512
        }
    );
}

unless ( exists $data{'_list_meta'}{'zenka-deps'} ) {
    <[base.list.init]>->(
        {   'name'         => qw| zenka-deps |,
            'key_ref'      => \$data{'debian'}{'zenki_deps'}{'registry'},
            'max_elements' => 256
        }
    );
}

my $base_path = $data{'debian'}{'cfg'}{'zenki_config_base'}
    // ( $data{'system'}{'conf_path'} . '/zenki' );

unless ( defined $base_path && -d $base_path ) {
    return {
        success => FALSE,
        error   => qq| zenki config base not found: $base_path |
    };
}

<[base.log]>->( 2, "debian.scan: scanning zenki at $base_path" );

my $zenki_count    = 0;
my $total_pm_deps  = 0;
my $total_os_deps  = 0;
my $total_bin_deps = 0;

## Find all zenka directories
opendir( my $dh, $base_path )
    or return {
    success => FALSE,
    error   => qq| cannot read zenki base: $! |
    };

my @zenki = grep { -d "$base_path/$_" && $_ !~ /^\./ } readdir($dh);
closedir($dh);

<[base.log]>->( 2, "  Found " . scalar(@zenki) . " zenki to scan" );

## Scan each zenka
foreach my $zenka (@zenki) {
    my $zenka_path = "$base_path/$zenka";

    ## Check for pm-dep directory
    my $pm_dep_path  = "$zenka_path/pm-dep";
    my $os_dep_path  = "$zenka_path/os-dep/debian";
    my $bin_dep_path = "$zenka_path/os-dep/binary";

    my @pm_deps;
    my @os_deps;
    my @bin_deps;

    ## Scan Perl module dependencies
    if ( -d $pm_dep_path ) {
        opendir( my $pm_dh, $pm_dep_path ) or next;
        @pm_deps
            = grep { $_ !~ /^\./ && -f "$pm_dep_path/$_" } readdir($pm_dh);
        closedir($pm_dh);

        ## Convert file names back to module names (File__Spec => File::Spec)
        @pm_deps = map {s/__/::/gr} @pm_deps;
    }

    ## Scan OS (Debian) dependencies
    if ( -d $os_dep_path ) {
        opendir( my $os_dh, $os_dep_path ) or next;
        @os_deps
            = grep { $_ !~ /^\./ && -f "$os_dep_path/$_" } readdir($os_dh);
        closedir($os_dh);
    }

    ## Scan Binary dependencies
    if ( -d $bin_dep_path ) {
        opendir( my $bin_dh, $bin_dep_path ) or next;
        @bin_deps
            = grep { $_ !~ /^\./ && -f "$bin_dep_path/$_" } readdir($bin_dh);
        closedir($bin_dh);
    }

    next unless @pm_deps || @os_deps || @bin_deps;

    $zenki_count++;
    $total_pm_deps  += scalar(@pm_deps);
    $total_os_deps  += scalar(@os_deps);
    $total_bin_deps += scalar(@bin_deps);

    <[base.log]>->(
        3,
        "  zenka '$zenka': "
            . scalar(@pm_deps)
            . " pm-dep, "
            . scalar(@os_deps)
            . " os-dep, "
            . scalar(@bin_deps)
            . " bin-dep"
    );

    ## Register zenka dependencies
    my $zenka_id = <[base.list.element.add]>->(
        {   'key_ref' => \$data{'debian'}{'zenki_deps'}{'registry'},
            'val_ref' => \{
                zenka          => $zenka,
                pm_deps        => [@pm_deps],
                os_deps        => [@os_deps],
                bin_deps       => [@bin_deps],
                pm_deps_count  => scalar(@pm_deps),
                os_deps_count  => scalar(@os_deps),
                bin_deps_count => scalar(@bin_deps),
                missing_count  => 0,                   ## Will be calculated
                status         => qw| unknown |
            }
        }
    );

    if ( defined $zenka_id ) {
        $data{'debian'}{'zenki_deps'}{'by_zenka'}->{$zenka} = $zenka_id;

        ## Register each Perl module dependency
        foreach my $pm_module (@pm_deps) {
            <[debian.parent.callback.register_cpan_module]>->(
                $pm_module, $zenka
            );
        }

        ## Register each Debian package dependency
        foreach my $deb_pkg (@os_deps) {
            <[debian.parent.callback.register_deb_package]>->(
                $deb_pkg, $zenka
            );
        }

        ## Register each Binary dependency
        foreach my $binary (@bin_deps) {
            <[debian.parent.callback.register_binary_dependency]>->(
                $binary, $zenka
            );
        }
    }
}

## Update statistics
$data{'debian'}{'stats'}{zenki_scanned}  = $zenki_count;
$data{'debian'}{'stats'}{total_pm_deps}  = $total_pm_deps;
$data{'debian'}{'stats'}{total_os_deps}  = $total_os_deps;
$data{'debian'}{'stats'}{total_bin_deps} = $total_bin_deps;
$data{'debian'}{'stats'}{last_scan}      = time();

<[base.log]>->( 2, "debian.scan: complete" );
<[base.log]>->( 2, "  Zenki scanned: $zenki_count" );
<[base.log]>->( 2, "  PM dependencies: $total_pm_deps" );
<[base.log]>->( 2, "  OS dependencies: $total_os_deps" );
<[base.log]>->( 2, "  Binary dependencies: $total_bin_deps" );

return {
    success     => TRUE,
    zenki_count => $zenki_count,
    deps_count  => $total_pm_deps + $total_os_deps + $total_bin_deps
};

