## [:< ##

# name  = base.stdio.frame.encode.pack_nibble
# param = $payload, $sep
# descr = pack a 3-bit payload with a separator bit

my ( $payload, $sep ) = @ARG;
return ( $payload & 0b111 ) | ( $sep ? 0b1000 : 0 );

