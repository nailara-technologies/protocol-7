## [:< ##

# name  = coding.init_code
# descr = initialize coding zenka state, task queue, budget, and event handlers
# purpose = Foundation: Set up all internal data structures for orchestration

my $reinit = shift // TRUE;   ### provided by 'base.init_modules' [TRUE|FALSE]
my $already_initialized = $reinit;    ## use for skipping redundant calls.. ##
my $first_init          = $already_initialized ? FALSE : TRUE; ## ^ inverse ##

## load all additionally used perl modules ##
#
<[base.perlmod.load]>->(qw| JSON::XS |);
map { <[base.perlmod.autoload]>->($_) } qw| IPC::Open3 YAML::XS FreezeThaw |;

# Initialize coding zenka data structure
<coding.state> //= {
    initialized => FALSE,              ## set TRUE later in this subroutine ##
    start_time  => <[base.time]>->(5),
    version     => qw| 1.0.0 |,
    status      => qw| ready |
};

## load persisted model metadata from disk if available
my $saved_meta_ref = <[file.zenka_dir.load]>->('state/model_metadata.yaml');
if ( defined $saved_meta_ref && length $saved_meta_ref->$* ) {
    my $loaded = eval { YAML::XS::Load( $saved_meta_ref->$* ) };
    if ( !$@ && ref $loaded eq 'HASH' ) {
        <coding.model_metadata> = $loaded;
        <[base.logs]>->(
            2,
            'loaded %d model metadata entries from disk',
            scalar keys %{<coding.model_metadata>}
        );
    }
}
<coding.model_metadata> //= {};

# Set library path for llama-server binaries (CPU and GPU backends)
<coding.lib_path> = qw| /data/source/ik_llama.cpp |;    ## [LLL] fix hardcoded

<[base.logs]>->( 1, ": library path : '%s'..", <coding.lib_path> );

# Initialize inference servers storage
<coding.inference_servers> //= {};

# Initialize task queue
<coding.task.queue>     //= {};
<coding.task.pending>   //= [];
<coding.task.active>    //= [];
<coding.task.completed> //= [];
<coding.task.failed>    //= [];

## load persisted budget state from disk [ freeze-thaw encoded ]
my $saved_budget_ref = <[file.zenka_dir.load]>->('state/budget.b32');
if ( defined $saved_budget_ref && length $saved_budget_ref->$* ) {
    my $thawed = eval { FreezeThaw::thaw( $saved_budget_ref->$* ) };
    if ( !$@ && ref $thawed eq 'HASH' ) {
        <coding.budget> = $thawed;
        <[base.logs]>->(
            2,
            'loaded budget state from disk :. used=%d tokens',
            $thawed->{'used'} // 0
        );
    }
}

## initialize budget tracking [ preserved values override defaults ]
<coding.budget.allocated>          //= 12000;
<coding.budget.used>               //= 0;
<coding.budget.transactions>       //= [];
<coding.budget.session_start>      //= <[base.time]>->(3);
<coding.budget.warnings_at_levels> //= [ 0.75, 0.90, 0.95 ];

# Initialize routing statistics
<coding.routing.stats> //= {
    total_routes => 0,
    by_service   => {},
    cache_hits   => 0
};

# Initialize learning state
<coding.learning.patterns>              //= {};
<coding.learning.success_rate>          //= {};
<coding.learning.model_specializations> //= {};

# Schedule inference server spawning asynchronously [ to not block init ]
<[base.logs]>->( 1, 'scheduling inference server spawning..' )
    if not <coding.state.initialized>;

my $params  = <coding.spawn_params> //= {};
my $backend = <inference.backend>   //= { 'cpu' => {}, 'gpu' => {} };

##  store spawn parameters for async spawning  ##  [LLL] fix hardcoded paths
$params->{'cpu_binary'} = <inference.backend.cpu.binary>
    // '/data/source/ik_llama.cpp/llama-server-cpu';
$params->{'gpu_binary'} = <inference.backend.gpu.binary>
    // '/data/source/ik_llama.cpp/llama-server-cuda-fa';
$params->{'gpu_enabled'}  = <inference.backend.gpu.enabled> // TRUE;
$params->{'cpu_model_id'} = <inference.backend.cpu.model_id>
    // 'gemma3-glitter-4b';
$params->{'gpu_model_id'} = <inference.backend.gpu.model_id>
    // 'gemma3-glitter-4b';
$params->{'cpu_threads'} = <inference.backend.cpu.threads>    // 7;
$params->{'gpu_layers'}  = <inference.backend.gpu.gpu_layers> // 32;
<coding.spawn_params.lib_path> = <coding.lib_path>;

# Register timer to spawn servers after init completes [non-blocking]
# Wait 500ms to allow async model path resolution to complete first
if ( not <coding.state.initialized> ) {
    <coding.timer.spawn_servers> = <[event.add_timer]>->(
        {   'after'   => 0.5,
            'handler' => qw| coding.handler.spawn_servers_deferred |
        }
    );
}

## event handlers are now loaded from separate modules:
## - coding.event.on_task_complete
## - coding.event.on_task_fail
## these are registered in the code registry when loaded

## register with event system
<watcher_list.coding.task_processor> //= TRUE;

<coding.state.initialized> = TRUE;

## fetch fresh model discovery from models zenka [ dependency guarantees it online ]
## fire once after init completes to not block init itself
if ( not $already_initialized ) {
    <[event.add_timer]>->(
        {   'after'   => 1.0,
            'repeat'  => FALSE,
            'handler' => qw| coding.handler.fetch_model_discovery |,
            'desc'    => 'initial model discovery from models zenka'
        }
    );

    ## poll system memory stats periodically [ for spawn decisions and routing ]
    <[event.add_timer]>->(
        {   'after'   => 2.0,
            'repeat'  => FALSE,
            'handler' => qw| coding.handler.refresh_mem_stats |,
            'desc'    => 'initial system memory poll'
        }
    );
    <coding.timer.mem_poll> = <[event.add_timer]>->(
        {   'after'    => 62,
            'interval' => 62,
            'repeat'   => TRUE,
            'handler'  => qw| coding.handler.refresh_mem_stats |,
            'desc'     => 'periodic system memory poll'
        }
    );
}

return 0;

