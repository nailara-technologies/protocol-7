## [:< ##

# name  = coding.init_code
# descr = initialize coding zenka state, task queue, budget, and event handlers
# purpose = Foundation: Set up all internal data structures for orchestration

# Load required Perl modules
<[base.perlmod.autoload]>->('JSON::XS');

# Load model metadata for routing decisions from centralized models.yaml
<[base.logs]>->( 1, "[coding] Loading model metadata from models.yaml" );

<[base.perlmod.autoload]>->(qw| YAML::Tiny |);

my $config_file = <system.conf_path> . '/zenki/models/models.yaml';

my %model_metadata = ();

if ( -f $config_file ) {
    my $yaml_content = <[file.slurp]>->($config_file);

    if ($yaml_content) {
        my $yaml = YAML::Tiny::Load($$yaml_content);

        if ( $yaml && exists $yaml->{models} ) {
            foreach my $model_id ( keys %{ $yaml->{models} } ) {
                my $model_def = $yaml->{models}->{$model_id};
                $model_metadata{$model_id} = {
                    name         => $model_def->{name},
                    path         => $model_def->{path},
                    quantization => $model_def->{quantization},
                    context_size => $model_def->{metadata}->{context_size}
                        // 2048,
                    batch_size => $model_def->{metadata}->{batch_size} // 256,
                    threads    => $model_def->{metadata}->{threads}    // 4,
                    tokens_per_sec => $model_def->{metadata}->{tokens_per_sec}
                        // 5
                };
            }
        } else {
            <[base.log]>->(
                0, "[coding] Error: No models found in models.yaml"
            );
        }
    }
} else {
    <[base.log]>->(
        0, "[coding] Error: models.yaml not found at $config_file"
    );
}

# Cache model metadata in zenka data
<coding.model_metadata> = \%model_metadata;

<[base.logs]>->(
    1,
    "[coding] Model metadata initialized: %d models loaded",
    scalar( keys %model_metadata )
);

# Initialize coding zenka data structure
<coding.state> = {
    initialized => 1,
    start_time  => <[base.time]>->(5),
    version     => '1.0.0',
    status      => 'ready'
};

# Initialize task queue
<coding.task.queue>     = {};
<coding.task.pending>   = [];
<coding.task.active>    = [];
<coding.task.completed> = [];
<coding.task.failed>    = [];

# Initialize budget tracking
<coding.budget.allocated>          = 12000;
<coding.budget.used>               = 0;
<coding.budget.transactions>       = [];
<coding.budget.session_start>      = <[base.time]>;
<coding.budget.warnings_at_levels> = [ 0.75, 0.90, 0.95 ];

# Initialize routing statistics
<coding.routing.stats> = {
    total_routes => 0,
    by_service   => {},
    cache_hits   => 0
};

# Initialize learning state
<coding.learning.patterns>              = {};
<coding.learning.success_rate>          = {};
<coding.learning.model_specializations> = {};

# Event handlers are now loaded from separate modules:
# - coding.event.on_task_complete
# - coding.event.on_task_fail
# These are registered in the code registry when loaded

# Register with event system
<watcher_list.coding.task_processor> = TRUE;

return TRUE;

