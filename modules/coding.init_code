## [:< ##

# name  = coding.init_code
# descr = initialize coding zenka state, task queue, budget,
#         and event handlers
# purpose = Foundation: Set up all internal data structures for orchestration

my $reinit = shift // TRUE;   ### provided by 'base.init_modules' [TRUE|FALSE]
my $already_initialized = $reinit;    ## use for skipping redundant calls.. ##
my $first_init          = $already_initialized ? FALSE : TRUE; ## ^ inverse ##

## load json parser modules [without importing] ##
map { <[base.perlmod.load]>->($ARG) } qw| JSON::XS JSON::PP |;
## load all additionally used perl modules ##
map { <[base.perlmod.autoload]>->($ARG) } qw[
    Cwd
    Fcntl
    Encode
    YAML::XS
    FreezeThaw
    IPC::Open3
    IO::Compress::Xz
];

## Phase 2: Async streaming support ##
## Using Protocol-7 native event system, not AnyEvent::HTTP ##
use Socket qw| SOCK_STREAM |;
use Errno  qw| EAGAIN EWOULDBLOCK |;

map { <[base.perlmod.autoload]>->($_) }
    qw| IPC::Open3 YAML::XS FreezeThaw Fcntl Cwd IO::Compress::Xz |;

## resolve drop_privs args [ secondary admin group for project file access ] ##
my $assume_admin
    = <[base.cfg_bool]>->( <coding.cfg.assume_admin_group> // 0 );
<coding.cfg.drop_privs_user> = <system.amos-zenka-user>;
## default: zenka's own group [ no-op in drop_privs ] ##
my ( undef, undef, undef, $zenka_gid ) = getpwnam(<system.amos-zenka-user>);
<coding.cfg.drop_privs_admin_group> = getgrgid($zenka_gid) // '';
if ($assume_admin) {
    my $root_stat  = File::stat::stat( <system.root_path> // '' );
    my $root_gid   = defined $root_stat ? $root_stat->gid     : undef;
    my $group_name = defined $root_gid  ? getgrgid($root_gid) : undef;
    if ( defined $group_name ) {
        <coding.cfg.drop_privs_admin_group> = $group_name;
        <[base.logs]>->(
            2, ': admin group : %s [ secondary, from project root ]',
            $group_name
        );
    } else {
        <[base.logs]>->(
            0,
            ': admin group : cannot stat root_path [%s]',
            <system.root_path> // 'undef'
        );
    }
}

## allow git commands as protocol-7 user in taeki-owned repo ##
if ( defined <system.root_path> and -d <system.root_path> . '/.git' ) {
    $ENV{'GIT_CONFIG_COUNT'}   = 1;
    $ENV{'GIT_CONFIG_KEY_0'}   = 'safe.directory';
    $ENV{'GIT_CONFIG_VALUE_0'} = <system.root_path>;
}

## set up zenka paths as root [ correct ownership ] ##
<[base.path-set-up.check-zenka-paths]>->(
    TRUE, 0750, FALSE, 0700, 'context-tree'
);
<[base.path-set-up.check-zenka-paths]>->(
    TRUE, 0750, FALSE, 0700, 'context-tree/index'
);
<[base.path-set-up.check-zenka-paths]>->(
    TRUE, 0750, FALSE, 0700, 'context-tree/nodes'
);
<[base.path-set-up.check-zenka-paths]>->(
    TRUE, 0750, FALSE, 0700, 'context-tree/edges'
);
<[base.path-set-up.check-zenka-paths]>->(
    TRUE, 0750, FALSE, 0700, 'context-tree/streams'
);
<[base.path-set-up.check-zenka-paths]>->( TRUE, 0750, FALSE, 0700, 'staged' );
<[base.path-set-up.check-zenka-paths]>->(
    TRUE, 0750, FALSE, 0700, 'learning'
);
<[base.path-set-up.check-zenka-paths]>
    ->( TRUE, 0750, FALSE, 0700, 'results' );
<[base.path-set-up.check-zenka-paths]>->( TRUE, 0750, FALSE, 0700, 'state' );
<[base.path-set-up.check-zenka-paths]>->(
    TRUE, 0750, FALSE, 0700, 'observations'
);

## fork privileged chmod child before drop_privs ##
<[coding.start.chmod_child]>;

## drop privileges [ must happen after path setup and chmod child fork ] ##
<[base.root.drop_privs]>->(
    <coding.cfg.drop_privs_user>, <coding.cfg.drop_privs_admin_group>
);

# Initialize coding zenka data structure
<coding.state> //= {
    initialized => FALSE,              ## set TRUE later in this subroutine ##
    start_time  => <[base.time]>->(5),
    version     => qw| 1.0.0 |,
    status      => qw| ready |
};

## backend lock + queue state : replaces coding.async.backend_busy ##
<coding.state.backend> //= {
    gpu => { lock => undef, queue => [] },
    cpu => { lock => undef, queue => [] },
};

## load persisted model metadata from disk if available
my $saved_meta_ref = <[file.zenka_dir.load]>->('state/model_metadata.yaml');
if ( defined $saved_meta_ref && length $saved_meta_ref->$* ) {
    my $loaded = eval { YAML::XS::Load( $saved_meta_ref->$* ) };
    if ( !$@ && ref $loaded eq qw| HASH | ) {
        <coding.model_metadata> = $loaded;
        <[base.logs]>->(
            2,
            'loaded %d model metadata entries from disk',
            scalar keys %{<coding.model_metadata>}
        );
    }
}
<coding.model_metadata> //= {};

# Set library path for llama-server binaries (CPU and GPU backends)
<coding.lib_path> = <inference.backend.lib_path>
    // qw| /data/source/ik_llama.cpp |;

<[base.logs]>->( 1, ": library path : '%s'..", <coding.lib_path> );

# Initialize inference servers storage
<coding.inference_servers> //= {};

# Initialize task queue
<coding.task.queue>     //= {};
<coding.task.pending>   //= [];
<coding.task.active>    //= [];
<coding.task.completed> //= [];
<coding.task.failed>    //= [];

## load persisted budget state from disk [ freeze-thaw encoded ]
my $saved_budget_ref = <[file.zenka_dir.load]>->('state/budget.b32');
if ( defined $saved_budget_ref && length $saved_budget_ref->$* ) {
    my $thawed = eval { FreezeThaw::thaw( $saved_budget_ref->$* ) };
    if ( !$@ && ref $thawed eq qw| HASH | ) {
        <coding.budget> = $thawed;
        <[base.logs]>->(
            2,
            'loaded budget state from disk :. used=%d tokens',
            $thawed->{'used'} // 0
        );
    }
}

## initialize budget tracking [ preserved values override defaults ]
<coding.budget.allocated>          //= 12000;
<coding.budget.used>               //= 0;
<coding.budget.transactions>       //= [];
<coding.budget.session_start>      //= <[base.time]>->(3);
<coding.budget.warnings_at_levels> //= [ 0.75, 0.90, 0.95 ];

# Initialize routing statistics
<coding.routing.stats> //= {
    total_routes => 0,
    by_service   => {},
    cache_hits   => 0
};

# Initialize timeout statistics [ percentile_95 of TTFT samples x 1.5 ]
<coding.cfg.timeout_stats> //= {
    multiplier    => 2.25,
    percentile_95 => 1.5,
    last_update   => undef,
    models        => {}
};

# Initialize learning state
<coding.learning.patterns>              //= {};
<coding.learning.success_rate>          //= {};
<coding.learning.model_specializations> //= {};

# Phase 1: Async/Deferred Reply Configuration
<coding.async.enabled> //= FALSE;    # Default: blocking mode for stability
<coding.async.max_rounds>
    //= 777;    # Max inference rounds per task (tool loops)
<coding.async.task_state> //= {};    # Store state for deferred tasks

# Schedule inference server spawning asynchronously [ to not block init ]
<[base.logs]>->( 1, 'scheduling inference server spawning..' )
    if not <coding.state.initialized>;

my $params  = <coding.spawn_params> //= {};
my $backend = <inference.backend>   //= { 'cpu' => {}, 'gpu' => {} };

##  store spawn parameters for async spawning ##
$params->{'cpu_binary'} = <inference.backend.cpu.binary>
    // <coding.lib_path> . '/llama-server-cpu';
$params->{'gpu_binary'} = <inference.backend.gpu.binary>
    // <coding.lib_path> . '/llama-server-cuda-fa';
$params->{'gpu_enabled'}  = <inference.backend.gpu.enabled> // TRUE;
$params->{'cpu_model_id'} = <inference.backend.cpu.model_id>
    // 'gemma3-glitter-4b';
$params->{'gpu_model_id'} = <inference.backend.gpu.model_id>
    // 'gemma3-glitter-4b';
$params->{'cpu_threads'} = <inference.backend.cpu.threads>    // 7;
$params->{'gpu_layers'}  = <inference.backend.gpu.gpu_layers> // 32;
<coding.spawn_params.lib_path> = <coding.lib_path>;

## check if GPU port already occupied (another coding instance running)
## ONLY meaningful on a genuine first boot [ :twin: handover scenario ] -  ##
## on every later reload/reinit of an already-running instance, the port  ##
## is legitimately busy with THIS instance's own server, which needs no   ##
## re-spawning at all. without gating on $already_initialized, every      ##
## `coding.reload` re-armed a fresh await_resources watchdog that would   ##
## later misfire on any future switch-model kill - confirmed live         ##
## 2026-06-21, this undid the per-instance retirement fix on every reload.##
my $gpu_port = <inference.backend.gpu.port> // 8000;
my $gpu_busy = 0;

if ( not $already_initialized ) {
    use IO::Socket::INET;
    my $probe = IO::Socket::INET->new(
        PeerAddr => '127.0.0.1',
        PeerPort => $gpu_port,
        Proto    => 'tcp',
        Timeout  => 1
    );
    if ( defined $probe ) {
        $probe->close;
        $gpu_busy = 1;
    }
}

if ($gpu_busy) {
    <[base.logs]>->(
        1, 'GPU port %d occupied — entering resource-wait mode', $gpu_port
    );
    <coding.awaiting_resources> = TRUE;
    ## start polling timer instead of spawn timer
    <coding.timer.await_resources> = <[event.add_timer]>->(
        {   'after'    => 3.0,
            'interval' => 3.0,
            'handler'  => qw| coding.handler.await_resources |,
        }
    );
} elsif ( not <coding.state.initialized> ) {
    ## normal startup: register deferred spawn timer
    <coding.timer.spawn_servers> = <[event.add_timer]>->(
        {   'after'   => 0.5,
            'handler' => qw| coding.handler.spawn_servers_deferred |
        }
    );
}

## event handlers are now loaded from separate modules:
## - coding.event.on_task_complete
## - coding.event.on_task_fail
## these are registered in the code registry when loaded

## register SIGCHLD handler for inference server crash detection ##
<[event.add_signal]>->(
    {   'signal'  => 'CHLD',
        'handler' => qw| coding.handler.inference_server_sigchld |
    }
);

## set up dependency tracking for inference server readiness ##
<[dependency.install_callbacks]>->('coding');

## register memory callback types ##
if ( exists $code{'coding.callback.object_memory_system'} ) {
    <[dependency.setup]>->(
        'memory_system',
        { 'callback' => $code{'coding.callback.object_memory_system'} }
    );
    <[base.logs]>->( 2, '[init] registered memory_system callback' );
}
if ( exists $code{'coding.callback.object_memory_gpu'} ) {
    <[dependency.setup]>->(
        'memory_gpu',
        { 'callback' => $code{'coding.callback.object_memory_gpu'} }
    );
    <[base.logs]>->( 2, '[init] registered memory_gpu callback' );
}

## register self-test pending callback [ blocks backends during model switch ] ##
if ( exists $code{'coding.callback.object_self_test_pending'} ) {
    <[dependency.setup]>->(
        'self_test_pending',
        { 'callback' => $code{'coding.callback.object_self_test_pending'} }
    );
    <[base.logs]>->( 2, '[init] registered self_test_pending callback' );
}

## model_checksum_loaded objects are created lazily, per checksum, by    ##
## coding.task.ensure_model_pinned - only the callback type needs        ##
## registering here, once                                                ##
if ( exists $code{'coding.callback.object_model_checksum_loaded'} ) {
    <[dependency.setup]>->(
        'model_checksum_loaded',
        {   'callback' =>
                $code{'coding.callback.object_model_checksum_loaded'}
        }
    );
    <[base.logs]>->( 2, '[init] registered model_checksum_loaded callback' );
}

## create dependency objects [ only on first init to avoid leaks ] ##
if ( not $already_initialized ) {

    ## create memory availability dependencies ##
    <coding.dep.memory_system> = <[dependency.add_object]>->(
        {   'type'        => 'memory_system',
            'min_free_mb' => 4096,              ## 4GB free RAM required ##
            'description' => 'System RAM available (4GB+)'
        }
    );

    <coding.dep.memory_gpu> = <[dependency.add_object]>->(
        {   'type'        => 'memory_gpu',
            'min_free_mb' => 3072,              ## 3GB free VRAM required ##
            'description' => 'GPU VRAM available (3GB+)'
        }
    );

    ## create self-test pending dependency [ blocks backends during model switch ] ##
    <coding.dep.gpu_self_test_pending> = <[dependency.add_object]>->(
        {   'type'        => 'self_test_pending',
            'description' => 'No self-test model switch in progress'
        }
    );

    ## add self-chains for memory callbacks ##
    <[dependency.add]>->(
        <coding.dep.memory_system>, <coding.dep.memory_system>
    );
    <[dependency.add]>->( <coding.dep.memory_gpu>, <coding.dep.memory_gpu> );

    ## add self-chain so dependency.ok actually calls our callback ##
    <[dependency.add]>->(
        <coding.dep.gpu_self_test_pending>,
        <coding.dep.gpu_self_test_pending>
    );

    ## create dependency objects for inference server ports ##
    my $gpu_port = <inference.backend.gpu.port> // 8000;
    my $cpu_port = <inference.backend.cpu.port> // 8001;

    <coding.dep.gpu_server> = <[dependency.add_object]>->(
        {   'type'    => 'inference_server',
            'port'    => $gpu_port,
            'backend' => 'gpu'
        }
    );

    <coding.dep.cpu_server> = <[dependency.add_object]>->(
        {   'type'    => 'inference_server',
            'port'    => $cpu_port,
            'backend' => 'cpu'
        }
    );

    ## add self-chains so dependency.ok actually calls our callback ##
    <[dependency.add]>->( <coding.dep.gpu_server>, <coding.dep.gpu_server> );
    <[dependency.add]>->( <coding.dep.cpu_server>, <coding.dep.cpu_server> );

    ## create memory-aware dependency chains ##
    ## GPU server needs both GPU memory and system memory ##
    <[dependency.add]>->( <coding.dep.gpu_server>, <coding.dep.memory_gpu> );
    <[dependency.add]>->(
        <coding.dep.gpu_server>, <coding.dep.memory_system>
    );

    ## CPU server needs system memory ##
    <[dependency.add]>->(
        <coding.dep.cpu_server>, <coding.dep.memory_system>
    );

    ## block backend tasks while a self-test-triggered model switch is in progress ##
    <[dependency.add]>->(
        <coding.dep.gpu_server>, <coding.dep.gpu_self_test_pending>
    );
    <[dependency.add]>->(
        <coding.dep.cpu_server>, <coding.dep.gpu_self_test_pending>
    );
}

<[base.logs]>->(
    2,                       "inference server deps: gpu=%s cpu=%s",
    <coding.dep.gpu_server>, <coding.dep.cpu_server>
);

## make dependency status available as 'coding.list dependencies'
<list.depending> = {
    qw| var |      => qw| data |,
    qw| key |      => qw| dependency.object |,
    qw| sort_key | => qw| description |,
    qw| descr |    => 'current workflow dependency status',
    qw| mask |     => '<key>:id type status backend',
    qw| align |    => {
        qw| <key> |   => qw| center |,
        qw| type |    => qw| center |,
        qw| status |  => qw| center-1 |,
        qw| backend | => qw| center-1 |,
    },
    qw| filters | => {
        qw| dependdency | => qw| coding.parser.dependency_chain |,
        qw| backend |     => qw| coding.parser.dependency_backend |,
        qw| status |      => qw| coding.parser.dependency_status |
    }
};

## make available models list with selection indicator
<list.coding-models> = {
    qw| var |      => qw| data |,
    qw| key |      => qw| coding.model_metadata |,
    qw| sort_key | => qw| reverse-num:size_gb |,     ## largest models first
    qw| descr |    => 'available inference models [marked with * = active]',
    qw| mask |     =>
        '<key>:amos-chksum-id name:model_name size_gb:size_GB is_vision:vision',
    qw| align | => {
        qw| amos-chksum-id | => qw| center-1 |,
        qw|   name  |        => qw|  left+1  |,
        qw| size_gb |        => qw|  center  |,
        qw| is_vision |      => qw| center-1 |,
    },
    qw| filters | => {
        qw| amos-chksum-id | => qw| coding.parser.model_name_with_selection |,
        qw| name |           => qw| coding.parser.ellipse_model_name |,
        qw| is_vision |      => qw| coding.parser.str.is_vision |,
    }
};

## register with event system
<watcher_list.coding.task_processor> //= TRUE;

## perltidy tool options [ matching bin/ptd project defaults ] ##
my $ptd_opts = <coding.tools.perltidy.options> // [];
if ( not ref $ptd_opts eq qw| ARRAY | or not @$ptd_opts ) {
    $ptd_opts = [
        qw|
            -q -pbp
            -wc=13 -cs
            -utf8 -l=78
            -bar -sot -ce
            -nst
            |
    ];
    <coding.tools.perltidy.options> = $ptd_opts;
}

<coding.state.initialized> = TRUE;

## validate tool dispatch table at init time [ catch errors early ]
if ( exists $code{'coding.tools.definitions'} ) {
    my @missing_dispatch;
    my @undefined_dispatch;

    ## tools handled directly in coding.tools.dispatch ##
    ## [ not via handler modules ] ##
    my %dispatch_table_tools = map { $_ => 1 } qw(
        list_files search_code dep_graph ncode_search ncode_search_context
        edit_file record_question record_suggestion
    );

    ## get list of defined tools ##
    my $tools_ref = $code{'coding.tools.definitions'}->();
    if ( ref $tools_ref eq qw| ARRAY | ) {
        for my $tool (@$tools_ref) {
            my $name = $tool->{'function'}->{'name'} // next;

            ## skip tools handled directly in dispatch table ##
            next if exists $dispatch_table_tools{$name};

            ## check if handler exists in code registry ##
            my $handler_mod = "coding.tools.handler.$name";
            if ( not exists $code{$handler_mod} ) {
                push @missing_dispatch, $name;
            } elsif ( not defined $code{$handler_mod} ) {
                push @undefined_dispatch, $name;
            }
        }
    }

    if (@missing_dispatch) {
        <[base.logs]>->(
            0,
            '[init] tools without handlers: %s',
            join( ', ', sort @missing_dispatch )
        );
    }
    if (@undefined_dispatch) {
        <[base.logs]>->(
            0,
            '[init] tools with undefined dispatch: %s',
            join( ', ', sort @undefined_dispatch )
        );
    }
    if ( not @missing_dispatch and not @undefined_dispatch ) {
        <[base.logs]>->(
            2,
            '[init] all %d tools have valid handlers',
            scalar @$tools_ref
        );
    }
}

## fetch fresh model discovery from models zenka
## [ init_reports fires when cube is ready to route ]
if ( not $already_initialized ) {
    <system.init_reports> //= [];
    push(
        <system.init_reports>->@*,
        {   'target_command' => qw| cube.models.discover |,
            'param'          => qw| available |,
            'handler'        => qw| coding.handler.models_discover_reply |,
            'descr'          => 'requesting model discovery from models zenka'
        }
    );

    ## poll system memory stats periodically
## [ for spawn decisions and routing ]
    <[event.add_timer]>->(
        {   'after'   => 2.0,
            'repeat'  => FALSE,
            'handler' => qw| coding.handler.refresh_mem_stats |,
            'desc'    => 'initial system memory poll'
        }
    );
    <coding.timer.mem_poll> = <[event.add_timer]>->(
        {   'after'    => 62,
            'interval' => 62,
            'repeat'   => TRUE,
            'handler'  => qw| coding.handler.refresh_mem_stats |,
            'desc'     => 'periodic system memory poll'
        }
    );

    ## scratchpad rescue sweep : startup one-shot [ inference servers need
    ## time to come up ] + hourly repeat ##
    <[event.add_timer]>->(
        {   'after'   => 180,
            'repeat'  => FALSE,
            'handler' => qw| coding.handler.scratchpad_sweep |,
            'desc'    => 'initial scratchpad rescue sweep'
        }
    );
    <coding.timer.scratchpad_sweep> = <[event.add_timer]>->(
        {   'after'    => 3600,
            'interval' => 3600,
            'repeat'   => TRUE,
            'handler'  => qw| coding.handler.scratchpad_sweep |,
            'desc'     => 'periodic scratchpad rescue sweep'
        }
    );

    ## subscribe to X-11 GPU stats stream if available -- deferred via
    ## <system.callbacks.initialized>: resolve_primary_sid's own internal
    ## route-send (for non-v7 zenki) fires before this zenka's own cube
    ## session exists when called directly from init_code, and unlike the
    ## orbital subscribers this resolver has no retry-on-failure of its
    ## own, so a race here means never getting GPU stats at all, not just
    ## a delayed retry ##
    push <system.callbacks.initialized>->@*, sub {
        <[base.zenki.resolve_primary_sid]>->(
            'X-11',
            sub {
                my $sid = shift;
                return if not defined $sid;
                <[protocol-7.route-send]>->(
                    {   'command'   => "$sid.gpu_load",
                        'call_args' => { 'args' => 'subscribe' },
                        'reply'     => {
                            'handler' => 'coding.handler.gpu_stats_update',
                            'params'  => {}
                        }
                    }
                );

                ## parallel feed : gpu temperature ##
                <[protocol-7.route-send]>->(
                    {   'command'   => "$sid.gpu_metric",
                        'call_args' => { 'args' => 'temp subscribe' },
                        'reply'     => {
                            'handler' => 'coding.handler.gpu_temp_update',
                            'params'  => {}
                        }
                    }
                );
            }
        );
    };
}

return 0;

