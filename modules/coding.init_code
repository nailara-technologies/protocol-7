## [:< ##

# name  = coding.init_code
# descr = initialize coding zenka state, task queue, budget, and event handlers
# purpose = Foundation: Set up all internal data structures for orchestration

# Load required Perl modules
<[base.perlmod.load]>->('JSON::XS');
<[base.perlmod.autoload]>->('IPC::Open3');

# Defer model metadata loading to async handler to keep init fast
<[base.logs]>->(
    1, "[coding] deferring model metadata loading to async handler"
);
<coding.model_metadata> //= {};

# Set library path for llama-server binaries (CPU and GPU backends)
$data{'coding.lib_path'} = '/data/source/ik_llama.cpp';

<[base.logs]>->(
    1, "[coding] set library path: %s",
    $data{'coding.lib_path'}
);

# Initialize inference servers storage
$data{'coding.inference_servers'} //= {};

# Initialize coding zenka data structure
<coding.state> = {
    initialized => 1,
    start_time  => <[base.time]>->(5),
    version     => qw| 1.0.0 |,
    status      => qw| ready |
};

# Initialize task queue
<coding.task.queue>     = {};
<coding.task.pending>   = [];
<coding.task.active>    = [];
<coding.task.completed> = [];
<coding.task.failed>    = [];

# Initialize budget tracking
<coding.budget.allocated>          = 12000;
<coding.budget.used>               = 0;
<coding.budget.transactions>       = [];
<coding.budget.session_start>      = <[base.time]>->(3);
<coding.budget.warnings_at_levels> = [ 0.75, 0.90, 0.95 ];

# Initialize routing statistics
<coding.routing.stats> = {
    total_routes => 0,
    by_service   => {},
    cache_hits   => 0
};

# Initialize learning state
<coding.learning.patterns>              = {};
<coding.learning.success_rate>          = {};
<coding.learning.model_specializations> = {};

# Schedule inference server spawning asynchronously (don't block init)
<[base.logs]>->( 1, "[coding] scheduling inference server spawning" );

# Store spawn parameters for async spawning
$data{'coding.spawn_params'} //= {};
$data{'coding.spawn_params'}->{'cpu_binary'} = $data{'inference.backend.cpu.binary'}
    // '/data/source/ik_llama.cpp/llama-server-cpu';
$data{'coding.spawn_params'}->{'gpu_binary'} = $data{'inference.backend.gpu.binary'}
    // '/data/source/ik_llama.cpp/llama-server-cuda-fa';
$data{'coding.spawn_params'}->{'gpu_enabled'} = $data{'inference.backend.gpu.enabled'} // 1;
$data{'coding.spawn_params'}->{'cpu_model_id'} = $data{'inference.backend.cpu.model_id'}
    // 'gemma3-glitter-4b';
$data{'coding.spawn_params'}->{'gpu_model_id'} = $data{'inference.backend.gpu.model_id'}
    // 'gemma3-glitter-4b';
$data{'coding.spawn_params'}->{'cpu_threads'} = $data{'inference.backend.cpu.threads'} // 8;
$data{'coding.spawn_params'}->{'gpu_layers'}  = $data{'inference.backend.gpu.gpu_layers'}
    // 33;
$data{'coding.spawn_params'}->{'lib_path'}  = $data{'coding.lib_path'};

# Register timer to spawn servers after init completes (non-blocking)
<[coding.async_spawn_inference_servers]>;

# Event handlers are now loaded from separate modules:
# - coding.event.on_task_complete
# - coding.event.on_task_fail
# These are registered in the code registry when loaded

# Register with event system
<watcher_list.coding.task_processor> = TRUE;

return 0;

