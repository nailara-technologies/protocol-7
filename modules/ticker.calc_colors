## [:< ##

# name  = ticker.calc_colors

<ticker.font.color> = <[ticker.calc-col.RGB]>->(<ticker.cfg.fg_col>);

<ticker.bg-color> = <[ticker.calc-col.RGB]>
    ->( <ticker.cfg.bg_col> // <ticker.default_background> );

##  automatic calculation using font.color  ##
<[ticker.cfg.font.calc_outline_col]>;

