# name  = models.cmd.adapter-lmstudio-resolve
# descr = cmd: resolve a model name to its on-disk path

my $model_name = $call->{'args'} // '';

if ( !$model_name ) {
    <[base.logs]>->( 0, "usage: adapter-lmstudio-resolve <model_name>" );
    return { mode => qw| false | };
}

my $records = <[models.storage.adapter.lmstudio.discover]>;
my ($rec) = grep { $_->{'name'} eq $model_name } @{ $records // [] };

my $out = "";
if ($rec) {
    my $path = <[models.storage.adapter.lmstudio.resolve]>->($rec);
    if ($path) {
        $out = "$path
";
    } else {
        <[base.logs]>->( 0, "model not found on disk [ %s ]", $model_name );
    }
} else {
    <[base.logs]>->( 0, "model not found [ %s ]", $model_name );
}

return { mode => qw| size |, data => $out };

