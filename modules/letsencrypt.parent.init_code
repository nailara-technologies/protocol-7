## [:< ##

# name  = letsencrypt.parent.init_code
# descr = Initialize parent process for Let's Encrypt ACME operations - manages state, cache, and renewal scheduling

<[base.log]>->( 2, 'initializing Let\x27s Encrypt ACME parent process..,' );

## Load parent-specific modules
<[base.load_modules]>->('letsencrypt.base');
<[base.init_modules]>->('letsencrypt.base');

## Initialize parent-side certificate registry and cache
<letsencrypt.parent.certs>          = {};
<letsencrypt.parent.acme_account>   = {};
<letsencrypt.parent.renewal_timers> = {};

## Load stored certificates from disk into memory registry
my $load_result = <[letsencrypt.parent.load_certificate_registry]>->();
if ( $load_result && $load_result->{status} eq 'success' ) {
    <[base.log]>->(
        2, 'loaded ' . $load_result->{loaded} . ' certificates from disk'
    );
} elsif ( $load_result && $load_result->{status} eq 'partial' ) {
    <[base.log]>->(
        1, 'warning: partial certificate load - ' . $load_result->{error_msg}
    );
} else {
    <[base.log]>->(
        1, 'warning: no stored certificates found on disk (first run)'
    );
}

## Initialize renewal check timer using event system
## Fires every <letsencrypt.renewal.check-interval> seconds (86400 = 24 hours)
<letsencrypt.parent.renewal_check_timer> = <[event.add_timer]>->(
    {   'interval' => <letsencrypt.renewal.check-interval>,
        'handler'  => qw| letsencrypt.parent.handler_renewal_check |,
        'repeat'   => 1,
        'data'     => {},
    }
);

## Initialize rate limiter for ACME requests
<letsencrypt.parent.ratelimit> = {
    enabled  => <letsencrypt.ratelimit.enabled>      // 1,
    max_hour => <letsencrypt.ratelimit.max-per-hour> // 5,
    history  => [],    # timestamps of recent requests
};

## Initialize event handlers for child-to-parent communication
<letsencrypt.parent.handlers> = {
    'cert_ready'       => 'letsencrypt.parent.handler_cert_ready',
    'challenge_needed' => 'letsencrypt.parent.handler_challenge_needed',
    'renewal_failed'   => 'letsencrypt.parent.handler_renewal_failed',
    'acme_status'      => 'letsencrypt.parent.handler_acme_status',
    'child_ready'      => 'letsencrypt.parent.handler_child_ready',
};

## NOTE: Message handler is registered by fork_letsencrypt_child via base.handler.command
## Child-to-parent communication uses Protocol-7's command protocol (TRUE/FALSE replies)
## Do NOT register custom handler here - base.handler.command is already set up by fork

## Initialize visibility lists for monitoring
<list.certificates> = {
    qw| var |   => qw| data |,
    qw| key |   => qw| letsencrypt.parent.certs |,
    qw| descr | => 'Installed SSL certificates and expiration status',
    qw| mask |  => '<key>:domain issued_at expires_at status',
    qw| align | => {
        qw| domain |     => qw| left+2 |,
        qw| issued_at |  => qw| center-1 |,
        qw| expires_at | => qw| center-1 |,
        qw| status |     => qw| center-1 |
    },
    qw| filters | => {
        qw| issued_at |  => qw| base.parser.timestamp |,
        qw| expires_at | => qw| base.parser.timestamp |
    }
};

<list.renewals> = {
    qw| var |   => qw| data |,
    qw| key |   => qw| letsencrypt.parent.renewal_timers |,
    qw| descr | => 'Active certificate renewal operations',
    qw| mask |  => '<key>:domain started attempts status',
    qw| align | => {
        qw| domain |   => qw| left+2 |,
        qw| started |  => qw| center-1 |,
        qw| attempts | => qw| right-1 |,
        qw| status |   => qw| center-1 |
    },
    qw| filters | => { qw| started | => qw| base.parser.timestamp | }
};

<[base.log]>
    ->( 2, 'Let\x27s Encrypt parent process initialization complete' );
<[base.log]>->( 2, '  Certificate cache: ' . <letsencrypt.cache.dir> );
<[base.log]>->(
    2,
    '  Renewal check interval: '
        . <letsencrypt.renewal.check-interval>
        . ' seconds'
);

## Mark parent as fully initialized (child is ready via IPC pipe)
<letsencrypt.parent.initialized> = 1;

0;

