## [:< ##

# name  = plugin.storage.inference.store
# descr = store inference result to timestamp-addressed disk cache

my $params = shift // {};

my $question = $params->{'question'}      // '';
my $response = $params->{'response'}      // '';
my $model    = $params->{'model'}         // qw| unknown |;
my $temp     = $params->{'temperature'}   // 0.7;
my $finish   = $params->{'finish_reason'} // qw| stop |;
my $tags     = $params->{'tags'}          // [];
my $refs     = $params->{'refs'}          // [];

return { 'mode' => qw| false |, 'data' => 'question required' }
    unless length $question;
return { 'mode' => qw| false |, 'data' => 'response required' }
    unless length $response;

my $registry   = $data{'storage'}{'mapping'}{'inference'};
my $root       = $registry->{'root_path'};
my $rel_prefix = $registry->{'rel_prefix'};

## compute checksums ##
my $question_L13 = <[chk-sum.bmw.L13-str]>->($question);
my $response_B32 = <[chk-sum.bmw.224.B32]>->($response);
my $response_L13 = <[chk-sum.bmw.L13-str]>->($response);

return { 'mode' => qw| false |, 'data' => 'checksum computation failed' }
    unless defined $question_L13
    and defined $response_B32
    and defined $response_L13;

## absolute paths for existence checks ##
my $branch_dir = "$root/$question_L13";
my $refs_dir   = "$branch_dir/refs";

## B32 network timestamp for chronological ordering ##
my $ntime = <[base.ntime.b32]>;

## relative paths for file.zenka_dir.write ##
my $rel_content = "$rel_prefix/$question_L13/$ntime/$response_B32";
my $rel_meta    = "$rel_prefix/$question_L13/$ntime/.meta";
my $rel_bmeta   = "$rel_prefix/$question_L13/.meta";

my $now    = time();
my $is_new = not -d $branch_dir;

## check for near-duplicate response at this branch [ entropy check ] ##
## scan timestamp directories reverse-sorted [ newest first ] ##
if ( -d $branch_dir and opendir my $bdh, $branch_dir ) {
    my $threshold = $registry->{'config'}{'entropy_threshold'};
    my @ts_dirs   = sort { $b cmp $a }
        grep { $_ !~ m{^\.} and $_ ne qw| refs | and -d "$branch_dir/$_" }
        readdir $bdh;
    closedir $bdh;

DEDUP_SCAN:
    for my $ts_entry (@ts_dirs) {
        my $ts_meta_path = "$branch_dir/$ts_entry/.meta";
        next unless -f $ts_meta_path;

        if ( open my $fh, '<:encoding(UTF-8)', $ts_meta_path ) {
            my %emeta;
            while ( my $line = <$fh> ) {
                chomp $line;
                if ( $line =~ m{^([^=]+)=(.*)$} ) {
                    $emeta{$1} = $2;
                }
            }
            close $fh;

            ## compare response L13 hamming distance ##
            my $existing_L13 = $emeta{'response_L13'} // '';
            if ( length $existing_L13 == length $response_L13 ) {
                my $distance = 0;
                for my $i ( 0 .. length($response_L13) - 1 ) {
                    $distance++
                        if substr( $response_L13, $i, 1 ) ne
                        substr( $existing_L13, $i, 1 );
                }
                my $divergence = $distance / length($response_L13);

                if ( $divergence < $threshold ) {
                    ## near-duplicate — increment hit, skip store ##
                    $registry->{'stats'}{'dedup_skips'}++;
                    _update_branch_meta( $rel_bmeta, $question, $now, 'hit' );

                    if ( exists $registry->{'branches'}{$question_L13} ) {
                        $registry->{'branches'}{$question_L13}{'hit_count'}++;
                        $registry->{'branches'}{$question_L13}{'last_hit'}
                            = $now;
                    }

                    <[base.logs]>->(
                        2,
                        ':. inference.store: dedup skip at %s [ divergence=%.3f < %.3f ]',
                        $question_L13,
                        $divergence,
                        $threshold
                    );

                    return {
                        'mode' => qw| true |,
                        'data' => {
                            'branch'    => $question_L13,
                            'result'    => $response_B32,
                            'timestamp' => $ts_entry,
                            'cached'    => TRUE,
                            'dedup'     => TRUE,
                        }
                    };
                }
            }
        }
    }
}

## write result content via zenka_dir [ handles mkdir + permissions ] ##
my $written = <[file.zenka_dir.write]>->(
    $rel_content, \$response, qw| > |, 0664, ':encoding(UTF-8)'
);
if ( not defined $written ) {
    <[base.logs]>->(
        0, ':. inference.store: write failed [ %s ]', $rel_content
    );
    return {
        'mode' => qw| false |,
        'data' => "cannot write result: $rel_content"
    };
}

## write response .meta file inside timestamp directory ##
my $meta_content
    = "model=$model\n"
    . "temperature=$temp\n"
    . "finish_reason=$finish\n"
    . "timestamp=$now\n"
    . "ntime=$ntime\n"
    . "response_B32=$response_B32\n"
    . "response_L13=$response_L13\n"
    . "response_len="
    . length($response) . "\n";
$meta_content .= "tags=" . join( ',', $tags->@* ) . "\n" if $tags->@*;

my $meta_written = <[file.zenka_dir.write]>->(
    $rel_meta, \$meta_content, qw| > |, 0664, ':encoding(UTF-8)'
);
if ( not defined $meta_written ) {
    return {
        'mode' => qw| false |,
        'data' => "cannot write meta: $rel_meta"
    };
}

## update branch .meta ##
_update_branch_meta( $rel_bmeta, $question, $now, 'store' );

## update in-memory hot index ##
if ( not exists $registry->{'branches'}{$question_L13} ) {
    $registry->{'branches'}{$question_L13} = {
        'hit_count'    => 0,
        'created'      => $now,
        'last_hit'     => $now,
        'result_count' => 0,
    };
    $registry->{'stats'}{'branches'}++;
}
$registry->{'branches'}{$question_L13}{'result_count'}++;
$registry->{'branches'}{$question_L13}{'last_hit'} = $now;

## create symlink refs to related branches ##
for my $ref_L13 ( $refs->@* ) {
    next unless length $ref_L13;
    my $link_path   = "$refs_dir/$ref_L13";
    my $link_target = "../../$ref_L13";
    if ( -d $refs_dir ) {
        symlink $link_target, $link_path unless -e $link_path;
    }
}

## register with cluster system if available ##
if ( exists $code{'plugin.storage.checksum.cluster.add'} ) {
    $code{'plugin.storage.checksum.cluster.add'}->(
        {   'checksum' => $question_L13,
            'members'  => [$response_B32],
            'type'     => qw| inference |,
        }
    );
}

## emit awareness event if available ##
if ( exists $code{'context.tree.summary.add-event'} ) {
    $code{'context.tree.summary.add-event'}->(
        {   'type'    => 'inference-cached',
            'agent'   => qw| coding |,
            'branch'  => 'storage.inference',
            'payload' => {
                'question_L13' => $question_L13,
                'response_B32' => $response_B32,
                'model'        => $model,
                'is_new'       => $is_new ? TRUE : FALSE,
            },
            'references' =>
                { 'checksums' => [ $question_L13, $response_B32 ], },
        }
    );
}

$registry->{'stats'}{'stores'}++;
$registry->{'stats'}{'total_results'}++;

<[base.logs]>->(
    1,
    ':. inference.store: %s/%s → %s [ model=%s new_branch=%s ]',
    $question_L13,
    $ntime,
    substr( $response_B32, 0, 12 ),
    $model,
    $is_new ? qw| yes | : qw| no |
);

return {
    'mode' => qw| true |,
    'data' => {
        'branch'    => $question_L13,
        'result'    => $response_B32,
        'timestamp' => $ntime,
        'cached'    => FALSE,
    }
};

## update or create branch .meta file [ relative path for zenka_dir ] ##
sub _update_branch_meta {
    my ( $rel_path, $question, $time, $action ) = @_;

    ## read existing meta via zenka_dir.load ##
    my %meta;
    my $existing = <[file.zenka_dir.load]>->($rel_path);
    if ( defined $existing ) {
        for my $line ( split "\n", $existing->$* ) {
            $meta{$1} = $2 if $line =~ m{^([^=]+)=(.*)$};
        }
    }

    $meta{'question'}  //= $question;
    $meta{'created'}   //= $time;
    $meta{'hit_count'} //= 0;
    $meta{'last_access'} = $time;

    if ( $action eq qw| hit | ) {
        $meta{'hit_count'}++;
    }

    my $content = join '', map {"$_=$meta{$_}\n"} sort keys %meta;
    <[file.zenka_dir.write]>->(
        $rel_path, \$content, qw| > |, 0664, ':encoding(UTF-8)'
    );

    return;
}

