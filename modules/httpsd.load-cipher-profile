## [:< ##

# name = httpsd.load-cipher-profile
# descr = load cipher profile configuration for HTTPSD

my $profile_name = shift // qw| firefox_compatible |;

## default profiles (hardcoded fallback) ##
my %DEFAULT_PROFILES = (
    firefox_compatible => {
        description =>
            'Tested with Firefox, Chrome, Safari, Brave on modern systems',
        tls_versions => [ 'TLSv1_3', 'TLSv1_2' ],
        cipher_suite => join(
            ':',
            (   'ECDHE-ECDSA-AES256-GCM-SHA384',
                'ECDHE-ECDSA-CHACHA20-POLY1305',
                'ECDHE-ECDSA-AES128-GCM-SHA256',
                'ECDHE-RSA-AES256-GCM-SHA384',
                'ECDHE-RSA-CHACHA20-POLY1305',
                'ECDHE-RSA-AES128-GCM-SHA256',
            )
        ),
        key_types => [ 'ECDSA', 'RSA' ],
    },
    high_security => {
        description  => 'TLS 1.3 only, minimum attack surface',
        tls_versions => ['TLSv1_3'],
        cipher_suite => join(
            ':',
            (   'TLS_AES_256_GCM_SHA384', 'TLS_CHACHA20_POLY1305_SHA256',
                'TLS_AES_128_GCM_SHA256',
            )
        ),
        key_types => [ 'ECDSA', 'RSA' ],
    },
    backward_compatible => {
        description  => 'Includes support for older clients',
        tls_versions => [ 'TLSv1_3', 'TLSv1_2' ],
        cipher_suite => join(
            ':',
            (   'ECDHE-ECDSA-AES256-GCM-SHA384',
                'ECDHE-ECDSA-CHACHA20-POLY1305',
                'ECDHE-ECDSA-AES128-GCM-SHA256',
                'ECDHE-RSA-AES256-GCM-SHA384',
                'ECDHE-RSA-CHACHA20-POLY1305',
                'ECDHE-RSA-AES128-GCM-SHA256',
                'DHE-RSA-AES256-GCM-SHA384',
                'DHE-RSA-AES128-GCM-SHA256',
            )
        ),
        key_types => [ 'ECDSA', 'RSA' ],
    },
);

my $config_file = '/etc/protocol-7/httpsd-ciphers.yaml';

## try YAML config first ##
if ( -f $config_file ) {
    my $yaml_profile = undef;

    eval { require YAML::XS; } or do {
        goto FALLBACK_DEFAULT;
    };

    my $yaml;
    eval { $yaml = YAML::XS::LoadFile($config_file); } or do {
        <[base.log]>->( 1, "cipher-profile: failed to load YAML config: $@" );
        goto FALLBACK_DEFAULT;
    };

    my $profile = $yaml->{cipher_profiles}{$profile_name};
    unless ($profile) {
        <[base.log]>->(
            1, "cipher-profile: profile not found in YAML: $profile_name"
        );
        goto FALLBACK_DEFAULT;
    }

    ## normalize cipher suite ##
    my $cipher_suite = $profile->{cipher_suite};
    $cipher_suite =~ s|\s+| |g;
    $cipher_suite =~ s{^\s+|\s+$}{}g;
    $cipher_suite =~ s|\s*:\s*|:|g;

    return {
        description  => $profile->{description},
        tls_versions => $profile->{tls_versions} // [ 'TLSv1_3', 'TLSv1_2' ],
        cipher_suite => $cipher_suite,
        key_types    => $profile->{key_types} // [ 'ECDSA', 'RSA' ],
    };
}

FALLBACK_DEFAULT:

## fall back to hardcoded defaults ##
my $default_profile = $DEFAULT_PROFILES{$profile_name};
unless ($default_profile) {
    my @available = sort keys %DEFAULT_PROFILES;
    <[base.log]>->(
        0,
        "cipher-profile: unknown profile '$profile_name', "
            . "available: "
            . join( ', ', @available )
    );
    return undef;
}

return {%$default_profile};

