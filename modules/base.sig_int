## [:< ##

# name  = base.sig_int
# descr = SIGINT interrupt handler

print "\b\b\r" if fileno(STDOUT);    ## removing ^C ##

my $llvl       = <base.sig_int.log-level> //= 0;
my $zenka_name = <system.zenka.name>;

$PROGRAM_NAME .= " :. shutdown in progress.., one moment ., [$zenka_name]";

<[base.log]>->( $llvl, "::: SIGINT ::: stopping '$zenka_name' zenka ..," );

$SIG{'INT'} = sub {
    my $log_level = ( <base.sig_int.log-level> // 1 ) - 1;
    $log_level = 0 if $log_level < 1;
    print "\b\b" if fileno(STDOUT);    ## removing ^C ##
    <[base.log]>->( $log_level, '::: SIGINT ::: emergency shutdown ..,' );
    CORE::exit(1);
};

<[base.net.send_to_all_initialized]>->('!TRM! manual shutdown [SIGINT]');

printf( "\n < DEVMOD MODE > zenka state :\n\n%s\n", <[base.dump_data]> )
    if <system.zenka.verbosity.console> >= 2 and <devmod.sig_int_dump>;

<[base.code.call_expected]>->(
    <[base.mod.exists]>->(qw| v7 |),
    qw| v7.teardown |
);

if ( exists <system.kill_list> and ref(<system.kill_list>) eq qw| ARRAY | ) {
    map { kill( 9, $ARG ) } @{<system.kill_list>};
}

<[base.log]>->( 1, ':. done' );
exit(130);

