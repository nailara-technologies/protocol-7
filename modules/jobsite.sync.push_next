## [:< ##

# name  = jobsite.sync.push_next
# descr = send next job in queue, or finish cycle when queue is empty

my $jobs = shift // {};

my $queue = <jobsite.sync.push_queue> // [];
my $id    = shift @{$queue};

if ( not defined $id ) {
    ## queue empty — cycle done ##
    my $reverse = delete <jobsite.sync.push_reverse> // [];
    delete <jobsite.sync.push_queue>;
    <jobsite.sync.push_in_progress> = FALSE;
    <[base.logs]>->(
        1,
        'jobsite: sync push complete, %d reverse entries',
        scalar @{$reverse}
    );
    <[jobsite.sync.apply_reverse]>->($reverse);
    return;
}

my $job     = $jobs->{$id} // {};
my $payload = { %{$job}, 'id' => $id };
my $body    = eval { JSON::XS::encode_json($payload) } // '';

if ( not length $body ) {
    <[base.logs]>->( 0, 'jss.sync.push_next: encode failed for %s', $id );
    <[jobsite.sync.push_next]>->($jobs);
    return;
}

<[clients.http.post]>->(
    {   'url'     => <jobsite.cfg.sync_url>,
        'body'    => $body,
        'timeout' => 10,
        'on_done' => 'jobsite.handler.sync-response',
        'params'  => { 'job_id' => $id, 'jobs' => $jobs },
    }
);

