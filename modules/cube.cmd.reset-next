## [:< ##

# name  = cube.cmd.reset-next
# descr = cancel any currently-armed routing override [ unused ]

my $sid     = $call->{'session_id'};
my $session = $data{'session'}{$sid};

return { 'mode' => qw| true |, 'data' => 'no routing override armed' }
    if not defined $session
    or not exists $session->{'pending_routing_override'};

my $override = delete $session->{'pending_routing_override'};
$override->{'timer'}->cancel
    if defined $override->{'timer'} and $override->{'timer'}->is_active;

<[base.logs]>->( 2, '[%d] armed routing override cancelled', $sid );

return { 'mode' => qw| true |, 'data' => 'routing override cancelled' };

