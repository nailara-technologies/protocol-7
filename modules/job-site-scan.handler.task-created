## [:< ##

# name  = job-site-scan.handler.task-created
# descr = receive task id, register wait-done watcher

my $call = shift // {};

my $mode    = $call->{'mode'}             // '';
my $task_id = $call->{'data'}             // '';
my $job_id  = $call->{'params'}{'job_id'} // '';

if ( lc($mode) eq qw| false | ) {
    <[base.logs]>->(
        0,       'jss.task-created: failed for job %s: %s',
        $job_id, $task_id
    );
    <job-site-scan.pending_count>--;
    <[job-site-scan.dispatch.next]>;    ## continue with next job
    return;
}

$task_id = uc( substr( $task_id, 0, 7 ) );
<[base.logs]>->( 1, 'jss: job %s → task %s', $job_id, $task_id );

<job-site-scan.tasks>->{$job_id}{'task_id'} = $task_id;
<job-site-scan.tasks>->{$job_id}{'stage'}   = 'assessing';
<[job-site-scan.state.persist]>;

## dispatch next job while this one runs async
<[job-site-scan.dispatch.next]>;

## deferred watcher — fires when task.complete or task.fail is called
<[protocol-7.route-send]>->(
    {   'command'   => 'task.wait-done',
        'call_args' => { 'args' => $task_id },
        'reply'     => {
            'handler' => 'job-site-scan.handler.assess-done',
            'params'  => { 'job_id' => $job_id, 'task_id' => $task_id },
        },
    }
);

