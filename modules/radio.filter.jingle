## [:< ##

# name  = radio.filter.jingle
# descr = detect jingles by title pattern matching

my $title = shift // '';

<radio.jingle.patterns> //= [
    qw| psyndora |, '\bjingle\b',   '\bID\b', '\bpromo\b',
    'station id',   'magicstreams', 'PsyNdora'
];

for my $pat ( <radio.jingle.patterns>->@* ) {
    return 1 if $title =~ m{$pat}i;
}

return 0;

