# name  = models.decision.cost_base.should_keep_model_local
# descr = Determine if model should be kept locally based on usage

my ( $model_entry, $context ) = @ARG;

return 0 unless $model_entry && ref($model_entry) eq 'HASH';

my $access_freq = <[models.decision.cost_base.estimate_usage_frequency]>->(
    $model_entry, $context
);
return $access_freq->{per_month} > 10;    # Keep local if used >10x/month

