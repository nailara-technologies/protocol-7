## [:< ##

# name = httpd.serve_static
# descr = serve static files [called by route_dispatcher as fallback handler]
#
# This handler manages serving static files from the filesystem.
# It's the fallback route when no template or API match exists.
#
# Parameters:
#   $_[0] - Session ID
#   $_[1] - Handler args hash with 'path' key
#
# Returns:
#   HTTP status code or deferred [for large files]

my $session_id   = shift                   // '';
my $handler_args = shift                   // {};
my $path         = $handler_args->{'path'} // '';

die "expected valid session id" if not defined $data{'session'}{$session_id};
my $session = $data{'session'}{$session_id};

die "expected file path in handler args" if !length($path);

my $request   = $session->{'http'}->{'request'};
my $response  = $session->{'response'};
my $http_host = $session->{'http_host'};
my $site_dir  = <httpd.cfg.site_dir> // '/var/httpd';

<[base.logs]>
    ->( 1, "[%s] serve_static : request : '%s'", $session_id, $path );

# Build full file path - look up hostname in hostnames hash to get directory
my $base_dir = <httpd.cfg.hostnames>->{$http_host};
<[base.logs]>->(
    2,
    "[%s] : http_host='%s', base_dir='%s' [defined=%s], path='%s'",
    $session_id,
    $http_host,
    $base_dir // 'UNDEF',
    ( defined $base_dir ? 'yes' : 'no' ),
    $path
);
unless ( defined $base_dir ) {
    <[base.logs]>->(
        0,           "[%s] : hostname '%s' not found in hostnames config",
        $session_id, $http_host
    );
    return <[httpd.send_error_page]>->( $session_id, 404 );
}

my $file_path = join( '', $base_dir, $path );
<[base.logs]>->( 2, "[%s] : file_path='%s'", $session_id, $file_path );
$file_path =~ s{/+$}{};
<[base.logs]>->(
    2,           "[%s] : after strip trailing slash : file_path='%s'",
    $session_id, $file_path
);

# Check for template file instead (backward compat) using directory listing
my $requested_filename = ( split '/', $file_path )[-1];
my $parent_dir         = $file_path;
$parent_dir =~ s|[^/]*$||;
$parent_dir =~ s|/$||;
$parent_dir = '/' if !length($parent_dir);

my $has_file = 0;
my $has_tmpl = 0;
if ( opendir( my $check_fh, $parent_dir ) ) {
    my @dir_entries = readdir($check_fh);
    closedir($check_fh);
    foreach my $entry (@dir_entries) {
        $has_file = 1 if $entry eq $requested_filename;
        $has_tmpl = 1 if $entry eq "$requested_filename.tmpl";
    }
}

if ( !$has_file and $has_tmpl ) {
    <[base.logs]>->(
        2, "[%s] : found template %s, redirecting to template processor",
        $session_id, $file_path . ".tmpl"
    );

    ## this shouldn't happen if routing is correct, but handle gracefully
    return <[httpd.process_template]>->( $session_id, $file_path . ".tmpl" );
}

# Check if it's a directory - try index files first Use opendir/readdir
## instead of -d operator for SSL socket context compatibility
my $dir_fh;
my $is_directory     = 0;
my $found_index_html = 0;
my $found_index_tmpl = 0;

if ( opendir( $dir_fh, $file_path ) ) {   ### FIX : TOO EXPENSIVE \ REDUNDANT.
    $is_directory = 1;
    my @entries = readdir($dir_fh);
    closedir($dir_fh);

    # Check directory contents for index files
    foreach my $entry (@entries) {
        if ( $entry eq qw| index.html | ) {
            $found_index_html = TRUE;
        } elsif ( $entry eq qw| index.tmpl | ) {
            $found_index_tmpl = TRUE;
        }
    }

    <[base.logs]>->(
        2,
        "[%s] directory : found_index.html=%s, found_index.tmpl=%s",
        $session_id,
        ( $found_index_html ? 'YES' : 'NO' ),
        ( $found_index_tmpl ? 'YES' : 'NO' )
    );
}

if ($found_index_html) {
    $file_path = catfile( $file_path, qw| index.html | );
    <[base.logs]>->(
        2,           "[%s] found index.html in directory, using: '%s'",
        $session_id, $file_path
    );
} elsif ($found_index_tmpl) {
    <[base.logs]>->(
        2, "[%s] found index.tmpl, redirecting to template processor",
        $session_id
    );
    return <[httpd.process_template]>->(
        $session_id, catfile( $file_path, qw| index.tmpl | )
    );
} elsif ($is_directory) {
    ## directory exists but no index files
    <[base.logs]>->(
        1,           "[%s] directory listing not allowed : '%s'",
        $session_id, $file_path
    );
    return <[httpd.send_error_page]>->( $session_id, 403 );
}

# File permission checks using directory listing
my $final_filename   = ( split '/', $file_path )[-1];
my $final_parent_dir = $file_path;
$final_parent_dir =~ s|[^/]*$||;
$final_parent_dir =~ s|/$||;
$final_parent_dir = '/' if !length($final_parent_dir);

### FIX THE FOLLOWING [EXPENSIVE] ###
#
my $file_exists = 0;
if ( opendir( my $final_check_fh, $final_parent_dir ) ) {
    my @final_entries = readdir($final_check_fh);
    closedir($final_check_fh);
    foreach my $entry (@final_entries) {
        if ( $entry eq $final_filename ) {
            $file_exists = TRUE;
            last;
        }
    }
}
##

if ( not $file_exists ) {
    <[base.logs]>->(
        1,           "[%s] file not found : '%s', calling send_error_page",
        $session_id, $file_path
    );
    my $result = <[httpd.send_error_page]>->( $session_id, 404 );
    <[base.logs]>->(
        2,           "[%s] send_error_page returned [%s]",
        $session_id, $result
    );
    return $result;
}

## Note: Skip -r check as it may fail in SSL socket context File permissions
## will be checked when we attempt to open the file [line 182+] If file is
## not readable, open() will fail and we'll return 500 error

# Get file metadata
my $file_stat     = File::stat::stat($file_path);
my $content_inode = $file_stat->ino;
my $content_size  = $file_stat->size;
my $content_date  = time2str( $file_stat->mtime );
my $content_type  = mimetype($file_path) // qw| application/octet-stream |;

# add utf-8 charset for text-based content types
if ( $content_type =~ m{^(?:text|application/(?:json|xml|javascript|xhtml))} )
{
    $content_type .= '; charset=utf-8'
        unless $content_type =~ m{charset};    #FIX
}

# Generate ETag
my $path_etag = <[chk-sum.elf.vax-BASE32]>
    ->("$content_inode.$content_size.$content_date.$file_path");
$response->{'params'}->{'ETag'} = $path_etag;

# Check for Not Modified responses
my $reply_code = 200;

if ( defined $request->{'headers'}->{'if-none-match'}
    and $request->{'headers'}->{'if-none-match'} eq
    $response->{'params'}->{'ETag'} ) {
    <[base.logs]>->(
        1, "[%s] returning 304 Not Modified [ ETag match ]", $session_id
    );
    $reply_code = 304;
} elsif ( defined $request->{'headers'}->{'if-modified-since'}
    and $request->{'headers'}->{'if-modified-since'} eq $content_date ) {
    <[base.logs]>->(
        1, "[%s] returning 304 Not Modified [ Date match ]", $session_id
    );
    $reply_code = 304;
}

# Prepare response headers
my $reply_header = {
    'Content-Type'   => $content_type,
    'Last-Modified'  => $content_date,
    'Content-Length' => $content_size,
    'Connection'    => $session->{'http'}->{'close'} ? 'close' : 'keep-alive',
    'Accept-Ranges' => qw| bytes |,
    ( $response->{'params'}->%* )
};

# Handle 304 Not Modified
if ( $reply_code != 200 ) {
    $session->{'buffer'}->{'output'}
        .= <[httpd.new_header]>->( $reply_code, $reply_header );

    # Set flush_shutdown so base.handler.write will close after
    # flushing the buffer
    $session->{'flush_shutdown'} = 1 if $session->{'http'}->{'close'};
    return FALSE;
}

# Serve small files directly
if ( $content_size <= 16 * 1024 and not exists $request->{'range'} ) {
    <[base.logs]>->(
        1,           "[%s] :. directly .: < bytes : %d >",
        $session_id, $content_size
    );

    ### [LLL] consider passing output buffer to file.slurp : ###
    #
    ## use native file.slurp for consistent UTF-8 safe handling
    my $file_content_ref = <[file.slurp]>->($file_path);
    unless ( ref $file_content_ref eq qw| SCALAR | ) {
        <[base.logs]>->(
            0, "[%s] failed to read '%s' [%s]",
            $session_id, $file_path, <[base.str.os_err]>
        );
        return <[httpd.send_error_page]>->( $session_id, 500 );
    }

    ## compare read length to expected ..##

    $session->{'buffer'}->{'output'}    ## improve ## [LLL]
        .= <[httpd.new_header]>->( $reply_code, $reply_header );
    $session->{'buffer'}->{'output'} .= $file_content_ref->$*;

    # Set flush_shutdown so base.handler.write will close after flushing the
    # buffer Don't return 2 immediately - let the write handler finish
    # sending the response
    $session->{'flush_shutdown'} = 1 if $session->{'http'}->{'close'};
    return FALSE;
}

# For large files, use download transfer mechanism
<[base.logs]>->(
    1,           "[%s] : via download handler : << bytes : %d >>",
    $session_id, $content_size
);

return <[httpd.download_init]>->(
    {   'sid'    => $session_id,
        'path'   => $file_path,
        'header' => $reply_header
    }
);

