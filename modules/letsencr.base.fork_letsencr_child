## [:< ##

# name  = letsencr.base.fork_letsencr_child
# descr = fork child process for ACME operations (non-blocking cert provisioning and renewal)

( my $session_id ) = keys <user.cube.session>->%*;

<letsencr.pipe> = { 'child' => {}, 'parent' => {} };

<[base.log]>->( 1, 'forking letsencr child.,' );

<[base.enable_list]>->('sessions');

socketpair(
    my $child_pipe, my $parent_pipe, AF_UNIX(),
    SOCK_STREAM(),  PF_UNSPEC()
) || die "can't create socketpair. [ \l$OS_ERROR ]";
map { $data{'handle'}{$ARG}{'link'} = qw| ipc.pipe | }
    ( $child_pipe, $parent_pipe );

<letsencr.child.pid> = <[base.fork]>;

if ( !<letsencr.child.pid> ) {    ## child ##

    ## making base.s_read() and base.s_write() work after fork ., ##
    IO::AIO::reinit();

    close($child_pipe);
    delete <letsencr.pipe.child> if exists <letsencr.pipe.child>;

    ## removing not required entries ## [ only used in 'parent' itself ]
    delete <access.cmd.usr.cube>;
    delete <access.cmd.usr.child>;
    delete <access.cmd.regex.usr.cube>;
    delete <access.cmd.regex.usr.child>;

    <letsencr.pipe.parent> = $parent_pipe;
    <log.file.system.retry_timer>->cancel
        if exists <log.file.system.retry_timer>;

    my $subname = <system.zenka.subname>;
    my $sn_str  = defined $subname ? ':' . $subname : '';
    <system.zenka.subname> = sprintf 'child%s', $sn_str;
    $PROGRAM_NAME = sprintf '%s[child%s]', <system.zenka.name>, $sn_str;

    <[base.load_modules]>->('letsencr.child');
    <[base.init_modules]>->('letsencr.child');

    ## mark parent session for shutdown when last session closes
    # <callback.session.closing_last.params>->[1] = 1;
    <[base.log]>->( 1, 'preparing to close cube session of child .,' );
    $data{'session'}{$session_id}{'shutdown'} = 1;

    $data{'handle'}{$parent_pipe}{'mode'} = qw| out |;
    my $id = <[base.session.init]>->(
        $parent_pipe, qw| protocol-7 client parent |
    );

    $data{'session'}{$id}->{'input'}->{'handler'}
        = qw| base.handler.command |;

} else {    ## parent ##
    close($parent_pipe);
    delete <letsencr.pipe.parent> if exists <letsencr.pipe.parent>;
    <letsencr.pipe.child> = $child_pipe;

    ## removing not required entries ## [ only used in 'child' ]
    delete <access.cmd.usr.parent>;
    delete <access.cmd.regex.usr.parent>;

    my $child_pid = <letsencr.child.pid>;
    <[base.logs]>->( 1, ":. reporting child PID %d.,", $child_pid );
    <[base.zenki.report_child_pid]>->($child_pid);

    <[base.load_modules]>->('letsencr.parent');
    <[base.init_modules]>->('letsencr.parent');

    $data{'handle'}{$child_pipe}{'mode'} = qw| out |;
    my $id = <[base.session.init]>
        ->( $child_pipe, qw| protocol-7 client child | );
    $data{'session'}{$id}->{'input'}->{'handler'}
        = qw| base.handler.command |;
    $data{'session'}{$id}->{'authenticated'} = qw| yes |; # enabling  commands

    my $cache_dir  = <letsencr.cache.dir>;
    my $cert_cache = sprintf '%s/cert.cache', $cache_dir;
    if ( -f $cert_cache ) {
        <[base.log]>->( 1, 'found saved certificate cache.,' );

        ## contains serialized cert metadata
        <[file.slurp]>->( $cert_cache, \my $cache_str, qw| :raw | );

        # Load cached certificate data (deferred to parent init)
        <letsencr.cache.loaded> = 1;
    }

    <[event.add_signal]>
        ->( { 'signal' => 'CHLD', 'handler' => qw| base.exit | } );

    <[base.async.get_session_id]>;    ## signals 'online' state

    <[base.log]>->( 1, 'letsencr parent initialized' );
}

