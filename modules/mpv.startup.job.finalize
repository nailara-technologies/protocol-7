## [:< ##

# name  = mpv.startup.job.finalize
# descr = socket dep resolved: observe mpv properties and schedule playlist load

<[mpv.initialize.observe_properties]>;

## restore saved player state after observation is re-established [ so the ##
## initial property-change notifications are already accounted for and     ##
## later events only carry actual changes ] -- before the playlist fetch : ##
## the deferred seek applies once the saved file loads                     ##
if ( <[base.cfg_bool]>->( <mpv.restore_on_startup> //= TRUE ) ) {
    <[base.code.call_optional]>
        ->( qw| mpv.snapshot.restore |, qw| startup | );
}

<[event.add_timer]>->(
    {   'after' => 0,
        'cb'    => sub { <[mpv.get_playlist]>->(<mpv.playlist_type>) }
    }
);

<[base.log]>->( 1, '[startup] player startup complete' );

