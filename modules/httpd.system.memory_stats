# name = httpd.system.memory_stats
# descr = get detailed memory statistics (placeholder)

# Return placeholder memory stats until real implementation is available
return {
    'total'      => 1024 * 1024 * 1024 * 16,    # 16GB total
    'free'       => 1024 * 1024 * 1024 * 8,     # 8GB free
    'used'       => 1024 * 1024 * 1024 * 8,     # 8GB used
    'buffers'    => 1024 * 1024 * 512,          # 512MB buffers
    'cached'     => 1024 * 1024 * 1024 * 2,     # 2GB cached
    'swap_total' => 1024 * 1024 * 1024 * 4,     # 4GB swap total
    'swap_free'  => 1024 * 1024 * 1024 * 3      # 3GB swap free
};
