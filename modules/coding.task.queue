# name = coding.task.queue
# descr = manage work queue with priority, dependencies, and state tracking
# purpose = Queue management: Store tasks, maintain order, track state

# Add task to queue
my $enqueue_task = sub {
    my ($task) = @ARG;

    return {
        success => FALSE,
        error   => "Task must be a hashref"
        }
        unless ref($task) eq 'HASH';

    my $task_id = $task->{id};

    # Get persistent storage refs (fresh on each call)
    my $queue_ref   = <coding.task.queue>;
    my $pending_ref = <coding.task.pending>;

    # Prevent duplicates
    if ( exists $queue_ref->{$task_id} ) {
        return {
            success       => FALSE,
            error         => "Task already in queue: $task_id",
            existing_task => $queue_ref->{$task_id}
        };
    }

    # Store task in persistent queue
    $queue_ref->{$task_id} = {
        %$task,
        queued_at      => <[base.time]>,
        queue_position => scalar(@$pending_ref)
    };

    # Add to pending list (for ordering by priority)
    push @$pending_ref, $task_id;

    # Log task enqueue
    <[base.logs]>->( 2, "task enqueued: %s", $task_id );

    return {
        success    => TRUE,
        task_id    => $task_id,
        queue_size => scalar(@$pending_ref),
        message    => "Task enqueued: $task_id"
    };
};

# Get next task to execute (respects priority and dependencies)
my $dequeue_next = sub {    ## <-- inline subs - TO EXTRACT !!!

    # Get persistent storage refs (fresh on each call)
    my $queue_ref   = <coding.task.queue>;
    my $pending_ref = <coding.task.pending>;
    my $active_ref  = <coding.task.active>;

    # Filter tasks that have no unfinished dependencies
    my @available = ();

    foreach my $task_id (@$pending_ref) {
        my $task = $queue_ref->{$task_id};

        # Skip if not pending
        next unless $task->{execution}->{status} eq qw| pending |;

        # Simple dependency check (placeholder)
        # Full dependency tracking would check task dependencies

        push @available,
            {
            id             => $task_id,
            task           => $task,
            priority_score => <[coding.helper.priority_scorer]>->($task)
            };
    }

    # Sort by priority (highest first)
    my @sorted
        = sort { $b->{priority_score} <=> $a->{priority_score} } @available;

    if (@sorted) {
        my $next = $sorted[0];
        my $task = $next->{task};

        # Mark as being worked on (don't remove yet)
        $task->{execution}->{status}  = qw| in_progress |;
        $task->{execution}->{started} = <[base.time]>;

        # Move to active list
        @$pending_ref = grep { $_ ne $next->{id} } @$pending_ref;
        push @$active_ref, $next->{id};

        <[base.logs]>->( 2, "task started : %s", $next->{id} );

        return {
            success         => TRUE,
            task            => $task,
            queue_remaining => scalar(@$pending_ref)
        };
    }

    return {
        success    => FALSE,
        error      => 'no available tasks in queue',
        queue_size => scalar(@$pending_ref)
    };
};

# Mark task as completed
my $complete_task = sub {
    my ( $task_id, $result, $success ) = @ARG;

    # Get persistent storage refs (fresh on each call)
    my $queue_ref     = <coding.task.queue>;
    my $active_ref    = <coding.task.active>;
    my $completed_ref = <coding.task.completed>;

    return {
        success => FALSE,
        error   => "task not found : $task_id"
        }
        unless exists $queue_ref->{$task_id};

    my $task = $queue_ref->{$task_id};

    $task->{execution}->{status}    = qw| completed |;
    $task->{execution}->{completed} = <[base.time]>;
    $task->{execution}->{result}    = $result if defined $result;
    $task->{execution}->{success}   = $success // 1;

    # Move from active to completed
    @$active_ref = grep { $_ ne $task_id } @$active_ref;
    push @$completed_ref, $task_id;

    <[base.logs]>->( 1, "task completed : %s", $task_id );

    return {
        success => TRUE,
        task_id => $task_id,
        message => "Task completed: $task_id"
    };
};

# Mark task as failed
my $fail_task = sub {
    my ( $task_id, $error ) = @ARG;

    # Get persistent storage refs (fresh on each call)
    my $queue_ref  = <coding.task.queue>;
    my $active_ref = <coding.task.active>;
    my $failed_ref = <coding.task.failed>;

    return {
        success => FALSE,
        error   => "task not found: $task_id"
        }
        unless exists $queue_ref->{$task_id};

    my $task = $queue_ref->{$task_id};

    $task->{execution}->{status}    = qw| failed |;
    $task->{execution}->{completed} = <[base.time]>;
    $task->{execution}->{success}   = 0;
    $task->{execution}->{error}     = $error // qq| unknown error |;

    # Move from active to failed
    @$active_ref = grep { $_ ne $task_id } @$active_ref;
    push @$failed_ref, $task_id;

    <[base.logs]>->(
        0, "task failed : %s : %s",
        $task_id, ( $error // 'unknown error' )
    );

    return {
        success => TRUE,
        task_id => $task_id,
        error   => $error,
        message => "Task failed: $task_id"
    };
};

# Get task status
my $get_task_status = sub {
    my ($task_id) = @ARG;

    # Get persistent storage refs (fresh on each call)
    my $queue_ref = <coding.task.queue>;

    return {
        success => FALSE,
        error   => "task not found: $task_id"
        }
        unless exists $queue_ref->{$task_id};

    my $task = $queue_ref->{$task_id};

    return {
        success   => TRUE,
        task_id   => $task_id,
        status    => $task->{execution}->{status},
        started   => $task->{execution}->{started},
        completed => $task->{execution}->{completed},
        result    => $task->{execution}->{result},
        success   => $task->{execution}->{success}
    };
};

# Get queue statistics
my $get_queue_stats = sub {

    # Get persistent storage refs (fresh on each call)
    my $queue_ref     = <coding.task.queue>;
    my $pending_ref   = <coding.task.pending>;
    my $active_ref    = <coding.task.active>;
    my $completed_ref = <coding.task.completed>;
    my $failed_ref    = <coding.task.failed>;

    my $in_progress = scalar(@$active_ref);
    my $completed   = scalar(@$completed_ref);
    my $pending     = scalar(@$pending_ref);
    my $failed      = scalar(@$failed_ref);

    return {
        total_tasks   => scalar( keys %$queue_ref ),
        pending       => $pending,
        in_progress   => $in_progress,
        completed     => $completed,
        failed        => $failed,
        queue_updated => time()
    };
};

# Clear completed tasks
my $clear_completed = sub {

    # Get persistent storage refs (fresh on each call)
    my $queue_ref     = <coding.task.queue>;
    my $completed_ref = <coding.task.completed>;

    my $cleared = scalar(@$completed_ref);

    # Remove completed tasks from queue
    foreach my $task_id (@$completed_ref) {
        delete $queue_ref->{$task_id};
    }

    # Clear completed list
    @$completed_ref = ();

    <[base.logs]>->( 1, "cleared %d completed tasks", $cleared );

    return {
        success   => TRUE,
        cleared   => $cleared,
        remaining => scalar( keys %$queue_ref )
    };
};

# Route based on first argument
my $cmd = shift @ARG // qw| status |;
my $arg = shift @ARG;

if ( $cmd eq 'enqueue' ) {
    return $enqueue_task->($arg);
} elsif ( $cmd eq 'next' ) {
    return $dequeue_next->();
} elsif ( $cmd eq 'complete' ) {
    return $complete_task->( $arg, $ARG[0], $ARG[1] );
} elsif ( $cmd eq 'fail' ) {
    return $fail_task->( $arg, $ARG[0] );
} elsif ( $cmd eq 'status' ) {
    return $get_task_status->($arg) if defined $arg;
    return $get_queue_stats->();
} elsif ( $cmd eq 'clear' ) {
    return $clear_completed->();
} else {
    return {
        success   => FALSE,
        error     => "Unknown queue command: $cmd",
        available =>
            [ 'enqueue', 'next', 'complete', 'fail', 'status', 'clear' ]
    };
}

