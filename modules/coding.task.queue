# name = coding.task.queue
# descr = manage work queue with priority, dependencies, and state tracking
# purpose = Queue management: Store tasks, maintain order, track state

# Internal queue state - stored in memory for this session
my %TASK_QUEUE        = ();       # task_id => task
my @QUEUE_ORDER       = ();       # Ordered by priority/insertion
my %TASK_DEPENDENCIES = ();       # task_id => [dependent_ids]
my $QUEUE_UPDATED     = time();

# Add task to queue
my $enqueue_task = sub {
    my ($task) = @ARG;

    return {
        success => FALSE,
        error   => "Task must be a hashref"
        }
        unless ref($task) eq 'HASH';

    my $task_id = $task->{id};

    # Prevent duplicates
    if ( exists $TASK_QUEUE{$task_id} ) {
        return {
            success       => FALSE,
            error         => "Task already in queue: $task_id",
            existing_task => $TASK_QUEUE{$task_id}
        };
    }

    # Store task
    $TASK_QUEUE{$task_id} = {
        %$task,
        queued_at      => <[base.time]>,
        queue_position => scalar(@QUEUE_ORDER)
    };

    # Add to ordering (will be sorted by priority)
    push @QUEUE_ORDER, $task_id;

    $QUEUE_UPDATED = time();

    return {
        success    => TRUE,
        task_id    => $task_id,
        queue_size => scalar(@QUEUE_ORDER),
        message    => "Task enqueued: $task_id"
    };
};

# Get next task to execute (respects priority and dependencies)
my $dequeue_next = sub {    ## <-- inline subs !!!

    # Filter tasks that have no unfinished dependencies
    my @available = ();

    foreach my $task_id (@QUEUE_ORDER) {
        my $task = $TASK_QUEUE{$task_id};

        # Skip if not pending
        next unless $task->{execution}->{status} eq qw| pending |;

        # Check dependencies
        my $blocked = 0;
        if ( exists $TASK_DEPENDENCIES{$task_id} ) {
            foreach my $dep_id ( @{ $TASK_DEPENDENCIES{$task_id} } ) {
                my $dep_task = $TASK_QUEUE{$dep_id};
                if (  !$dep_task
                    || $dep_task->{execution}->{status} ne qw| completed | ) {
                    $blocked = 1;
                    last;
                }
            }
        }

        next if $blocked;

        push @available,
            {
            id             => $task_id,
            task           => $task,
            priority_score => <[coding.helper.priority_scorer]>->($task)
            };
    }

    # Sort by priority (highest first)
    my @sorted
        = sort { $b->{priority_score} <=> $a->{priority_score} } @available;

    if (@sorted) {
        my $next = $sorted[0];
        my $task = $next->{task};

        # Mark as being worked on (don't remove yet)
        $task->{execution}->{status}  = qw| in_progress |;
        $task->{execution}->{started} = <[base.time]>;

        return {
            success         => TRUE,
            task            => $task,
            queue_remaining => scalar(@QUEUE_ORDER) - 1
        };
    }

    return {
        success    => FALSE,
        error      => 'no available tasks in queue',
        queue_size => scalar(@QUEUE_ORDER)
    };
};

# Mark task as completed
my $complete_task = sub {
    my ( $task_id, $result, $success ) = @ARG;

    return {
        success => FALSE,
        error   => sprintf 'task not found : %s',
        $task_id
        }
        unless exists $TASK_QUEUE{$task_id};

    my $task = $TASK_QUEUE{$task_id};

    $task->{execution}->{status}    = qw| completed |;
    $task->{execution}->{completed} = <[base.time]>;
    $task->{execution}->{result}    = $result if defined $result;
    $task->{execution}->{success}   = $success // 1;

    $QUEUE_UPDATED = time();

    return {
        success => TRUE,
        task_id => $task_id,
        message => "Task completed: $task_id"
    };
};

# Mark task as failed
my $fail_task = sub {
    my ( $task_id, $error ) = @ARG;

    return {
        success => FALSE,
        error   => "Task not found: $task_id"
        }
        unless exists $TASK_QUEUE{$task_id};

    my $task = $TASK_QUEUE{$task_id};

    $task->{execution}->{status}    = qw| failed |;
    $task->{execution}->{completed} = <[base.time]>;
    $task->{execution}->{success}   = 0;
    $task->{execution}->{error}     = $error // qq| unknown error |;

    $QUEUE_UPDATED = time();

    return {
        success => TRUE,
        task_id => $task_id,
        error   => $error,
        message => "Task failed: $task_id"
    };
};

# Get task status
my $get_task_status = sub {
    my ($task_id) = @ARG;

    return {
        success => FALSE,
        error   => "Task not found: $task_id"
        }
        unless exists $TASK_QUEUE{$task_id};

    my $task = $TASK_QUEUE{$task_id};

    return {
        success   => TRUE,
        task_id   => $task_id,
        status    => $task->{execution}->{status},
        started   => $task->{execution}->{started},
        completed => $task->{execution}->{completed},
        result    => $task->{execution}->{result},
        success   => $task->{execution}->{success}
    };
};

# Get queue statistics
my $get_queue_stats = sub {
    my $in_progress = 0;
    my $completed   = 0;
    my $pending     = 0;
    my $failed      = 0;

    foreach my $task_id ( keys %TASK_QUEUE ) {
        my $status = $TASK_QUEUE{$task_id}->{execution}->{status};
        $in_progress++ if $status eq qw| in_progress |;
        $completed++   if $status eq qw| completed |;
        $pending++     if $status eq qw| pending |;
        $failed++      if $status eq qw| failed |;
    }

    return {
        total_tasks   => scalar( keys %TASK_QUEUE ),
        pending       => $pending,
        in_progress   => $in_progress,
        completed     => $completed,
        failed        => $failed,
        queue_updated => $QUEUE_UPDATED
    };
};

# Clear completed tasks
my $clear_completed = sub {
    my @to_remove = ();

    foreach my $task_id ( keys %TASK_QUEUE ) {
        if ( $TASK_QUEUE{$task_id}->{execution}->{status} eq qw| completed | )
        {
            push @to_remove, $task_id;
        }
    }

    foreach my $task_id (@to_remove) {
        delete $TASK_QUEUE{$task_id};
        @QUEUE_ORDER = grep { $_ ne $task_id } @QUEUE_ORDER;
    }

    $QUEUE_UPDATED = time();

    return {
        success   => TRUE,
        cleared   => scalar(@to_remove),
        remaining => scalar(@QUEUE_ORDER)
    };
};

# Route based on first argument
my $cmd = shift @ARG // qw| status |;
my $arg = shift @ARG;

if ( $cmd eq 'enqueue' ) {
    return $enqueue_task->($arg);
} elsif ( $cmd eq 'next' ) {
    return $dequeue_next->();
} elsif ( $cmd eq 'complete' ) {
    return $complete_task->( $arg, $ARG[0], $ARG[1] );
} elsif ( $cmd eq 'fail' ) {
    return $fail_task->( $arg, $ARG[0] );
} elsif ( $cmd eq 'status' ) {
    return $get_task_status->($arg) if defined $arg;
    return $get_queue_stats->();
} elsif ( $cmd eq 'clear' ) {
    return $clear_completed->();
} else {
    return {
        success   => FALSE,
        error     => "Unknown queue command: $cmd",
        available =>
            [ 'enqueue', 'next', 'complete', 'fail', 'status', 'clear' ]
    };
}

