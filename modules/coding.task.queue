## [:< ##

# name = coding.task.queue
# descr = manage work queue by routing to specialized modules
# purpose = Queue dispatcher: Route operations to appropriate handlers

# Dispatcher routes queue operations to extracted modules
my $cmd = shift @ARG // qw| status |;
my $arg = shift @ARG;

if ( $cmd eq 'enqueue' ) {
    return <[coding.task.queue_enqueue]>->($arg);
} elsif ( $cmd eq 'next' ) {
    return <[coding.task.queue_next]>;
} elsif ( $cmd eq 'complete' ) {
    return <[coding.task.queue_complete]>->( $arg, $ARG[0], $ARG[1] );
} elsif ( $cmd eq 'fail' ) {
    return <[coding.task.queue_fail]>->( $arg, $ARG[0] );
} elsif ( $cmd eq 'status' ) {
    return <[coding.task.queue_status]>->($arg);
} elsif ( $cmd eq 'clear' ) {
    return <[coding.task.queue_clear]>;
} else {
    return {
        success   => FALSE,
        error     => "Unknown queue command: $cmd",
        available =>
            [ 'enqueue', 'next', 'complete', 'fail', 'status', 'clear' ]
    };
}

