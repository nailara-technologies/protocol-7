## [:< ##

# name  = sessions.util.secret.start_child
# descr = open a control socket and fork a named secret-holder child.
#         NOT idempotent like the identity holder's start_child -- a
#         different secret under an already-live name is a real
#         conflict, not the same "already running" case.

my $name       = shift;
my $secret_b32 = shift;

if ( not defined $name or $name !~ m|^[\w\-]+$| ) {
    <[base.logs]>->( 0, 'sessions.secret: invalid name' );
    return undef;
}

my $existing = <sessions.secrets>->{$name};
if (    defined $existing
    and defined $existing->{'pid'}
    and <[base.exists.sub-process]>->( $existing->{'pid'} ) ) {
    <[base.logs]>->(
        0, "sessions.secret: '%s' already held [ refusing ]", $name
    );
    return undef;
}
delete <sessions.secrets>->{$name};    ## clear any stale entry ##

my $secret = eval { decode_b32r($secret_b32) };
if ( not defined $secret or not length $secret ) {
    <[base.logs]>->( 0, 'sessions.secret: invalid secret encoding' );
    return undef;
}

my $socket_id = <[base.prng.chars-anum]>->(16);
my $socket_path
    = sprintf( qw|/var/run/.7/UNIX/sessions.secret.%s.sock|, $socket_id );

my $listen_sock = <[io.unix.socket.input.open]>->(
    $socket_path, 0600, <system.amos-zenka-user>
);
if ( not defined $listen_sock ) {
    <[base.logs]>->( 0, 'sessions.secret: failed to open control socket' );
    <[base.buffer.erase_secure]>->( \$secret );
    return undef;
}

my $pid = <[base.fork]>;
if ( not defined $pid ) {
    <[base.s_warn]>->( 'sessions.secret: fork failed: %s <{C1}>', $OS_ERROR );
    <[base.buffer.erase_secure]>->( \$secret );
    return undef;
}

if ( $pid == 0 ) {    ## child ##
    <[sessions.secret.child]>->( $socket_path, $name, $secret );
    exit(0);
}

## parent -- this process's own copy is done being needed the moment fork() ##
## returns; the child already has its own COW'd copy                        ##
<[base.buffer.erase_secure]>->( \$secret );

my $client_sock
    = <[sessions.util.holder.accept_with_timeout]>->( $listen_sock, 3 );
if ( not defined $client_sock ) {
    <[base.logs]>->(
        0, "sessions.secret: '%s' child did not connect within timeout",
        $name
    );
    return undef;
}

<sessions.secrets>->{$name} = {
    'pid'         => $pid,
    'socket_id'   => $socket_id,
    'socket_path' => $socket_path,
    'listen_sock' => $listen_sock,
    'client_sock' => $client_sock,
    'state'       => qw| attached |,
};

<[base.logs]>->(
    1,     "sessions.secret: '%s' child forked and attached (pid %d)",
    $name, $pid
);

return TRUE;

