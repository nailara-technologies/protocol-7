## [:< ##

# name = web.cmd.process-template
# descr = Operator command to manually process a template file with recursive parsing
# usage = process-template <template-path> [meta-var=value ...]

my @args = @_;

unless ( @args >= 1 ) {
    return (
        0,
        qq| usage: process-template <template-path> [meta-var=value ...] |
    );
}

my $template_path = shift @args;
my %meta_vars     = ();

## Parse meta variable assignments from remaining arguments ##
foreach my $arg (@args) {
    if ( $arg =~ /^([\w\-_.]+)=(.*)$/ ) {
        my ( $var_name, $var_value ) = ( $1, $2 );
        $meta_vars{$var_name} = $var_value;
        <[base.log]>->(
            2,
            "process-template: meta variable set: $var_name = $var_value"
        );
    } else {
        return ( 0, qq| invalid meta variable format: $arg | );
    }
}

## Validate template path ##
unless ( -f $template_path ) {
    return ( 0, qq| template file not found: $template_path | );
}

unless ( -r $template_path ) {
    return ( 0, qq| template file not readable: $template_path | );
}

## Check file size ##
my $file_size = -s $template_path;
my $max_size  = <web.cfg.template_max_size> // ( 1024 * 1024 * 5 );

if ( $file_size > $max_size ) {
    return (
        0,
        sprintf(
            qq| template file too large: %d bytes (max: %d) |,
            $file_size, $max_size
        )
    );
}

<[base.log]>->( 2, "process-template: loading $template_path ($file_size bytes)" );

## Load template content ##
my $template_content = <[file.slurp]>->($template_path);

unless ( defined $template_content ) {
    return ( 0, qq| failed to read template file: $template_path | );
}

## Generate unique template ID ##
my $template_id = sprintf(
    'manual_%s_%d',
    <[chk-sum.elf.vax-BASE32]>->($template_path),
    time()
);

## Track active template processing ##
<web.templates.active>{$template_id} = {
    template_id => $template_id,
    client_id   => qw| operator |,
    status      => qw| processing |,
    depth       => 0,
    started_at  => time(),
};

<[base.log]>->( 2, "process-template: processing template $template_id" );

## Process template recursively ##
my $start_time = <[base.time]>->(4);

my $result = <[web.process_template_recursive]>->(
    {   content     => $template_content,
        meta        => \%meta_vars,
        depth       => 0,
        template_id => $template_id,
        session_id  => qw| operator |,
    }
);

my $elapsed_ms = ( <[base.time]>->(4) - $start_time ) * 1000;

## Clean up active template tracking ##
delete <web.templates.active>{$template_id};

## Update metrics ##
<web.templates.processed>++;
my $prev_avg = <web.metrics>->{avg_processing_time_ms};
<web.metrics>->{avg_processing_time_ms} =
    ( $prev_avg * ( <web.templates.processed> - 1 ) + $elapsed_ms )
    / <web.templates.processed>;

if ( $result->{status} eq qw| success | ) {
    <[base.log]>->(
        2,
        sprintf(
            "process-template: completed in %.2fms (depth: %d)",
            $elapsed_ms, $result->{depth}
        )
    );

    ## Return processed content ##
    return ( 5, $result->{content} );    ## 5 = TRUE + SIZE (return data)

} else {
    <[base.log]>->(
        1,
        "process-template: processing failed: " . $result->{message}
    );

    return (
        0,
        qq| template processing failed: |
            . $result->{message}
    );
}

