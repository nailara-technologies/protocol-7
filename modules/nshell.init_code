## [:< ##

# name = nshell.init_code
# descr = Protocol-7 native shell as first-class zenka with buffer I/O

## Set both STDIN and STDOUT to binary mode for consistent raw byte handling
## This allows sysread on STDIN and syswrite on STDOUT without encoding
## layer interference
binmode(STDIN);
binmode(STDOUT);
STDOUT->autoflush(1);    ## Ensure bytes are sent immediately to terminal

## Load AMOS7 for colors and protocol utilities
<[base.perlmod.load]>->('AMOS7');
<[base.perlmod.load]>->('AMOS7::TERM');
<[base.perlmod.load]>->(
    'AMOS7::Protocol::P7', qw| calc_port calc_unix_path |
);

## loading required terminal modules ##
<[base.perlmod.load]>->('Linux::Termios2');
<[base.perlmod.load]>->( 'Fcntl', qw| F_GETFL F_SETFL | );
<[base.perlmod.load]>->( 'POSIX', qw| :termios_h O_NONBLOCK | );

## Configure AMOS7 output
$AMOS7::TERM::title_prefix         = ' .:';
$AMOS7::mesg_prefix_string         = ' ::';
$AMOS7::TERM::prompt_prefix_string = ' ::';

## Get current Unix user for authentication
my $current_user = $ENV{'USER'} // getpwuid($EUID) // 'taeki';

## Initialize command history
## Load previous history entries from ~/.protocol-7/nshell.history
my $history_count = AMOS7::TERM::history_init( 'nshell.history', 1000, 300 );
<[base.log]>->( 2, "loaded %d history entries", $history_count )
    if $history_count > 0;

## Initialize terminal output color to TRUE blue (p7_fg_0004) so first
## command echoes in correct color
printf "%s\r", $colors{'p7_fg_0004'} // '';

## Hide system cursor and enable custom colored cursor
print "\e[?25l";    ## Hide terminal cursor
AMOS7::TERM::cursor_enable();

<base.sig_int.log-level> = 1;    ## override default log level 0 for SIGINT ##

## Initialize terminal using POSIX::Termios [ portable, no XS dependencies ]
<[nshell.term_init]>;

## Set end_code callback to restore terminal mode before exit
$code{'base.handler.end_code'} = sub {
    <[base.log]>->( 2, ': restoring terminal mode ..,' );
    print "\e[?25h";    ## Show terminal cursor before exit
    <[nshell.term_restore]>;
    <[base.exit]>->( '[ terminal restored ]', 1 );
};

## Initialize nshell state
<nshell.buffer_id>        //= qw| nshell-001 |;
<nshell.unix_user>        //= $current_user;
<nshell.authenticated>    //= FALSE;
<nshell.passthrough_mode> //= FALSE;   ## After auth: transparent pass-through

return 0;

