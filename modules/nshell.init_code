## [:< ##

# name = nshell.init_code
# descr = Protocol-7 native shell as first-class zenka with buffer I/O

## Load AMOS7 for colors and protocol utilities
<[base.perlmod.load]>->('AMOS7');
<[base.perlmod.load]>->('AMOS7::TERM');
<[base.perlmod.load]>->(
    'AMOS7::Protocol::P7', qw| calc_port calc_unix_path |
);

## Configure AMOS7 output
$AMOS7::TERM::title_prefix         = ' .:';
$AMOS7::mesg_prefix_string         = ' ::';
$AMOS7::TERM::prompt_prefix_string = ' ::';

## Get current Unix user for authentication
my $current_user = $ENV{'USER'} // getpwuid($EUID) // 'taeki';

## Initialize nshell state
<nshell.buffer_id>       //= 'nshell-001';
<nshell.command_history> //= [];
<nshell.connected>       //= FALSE;
<nshell.session_id>      //= undef;
<nshell.unix_user>       //= $current_user;

## Display configuration
<nshell.prompt_newline> //= TRUE;
<nshell.show_timestamp> //= FALSE;
<nshell.history_size>   //= 256;

return 0;

