# name = mpv.callback.start_reenc_msg
# TODO = implement feature-abort when 'refresh' messages fail with FALSE

my $r_name
    = defined <system.zenka.subname>
    ? sprintf qw| reenc-msg[%s] |, <system.zenka.subname>
    : qw| reenc-msg |;

<[base.protocol-7.command.send.local]>->(
    {   'command'   => qw| cube.v7.notify_online |,
        'call_args' => { 'args'    => $r_name },
        'reply'     => { 'handler' => qw| mpv.handler.reenc_notify_reply | }
    }
);

<[base.protocol-7.command.send.local]>->(
    {   'command'   => qw| cube.v7.start_once |,
        'call_args' => { 'args' => $r_name }
    }
);

