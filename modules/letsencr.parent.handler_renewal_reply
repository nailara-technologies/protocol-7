## [:< ##

# name  = letsencr.parent.handler_renewal_reply
# descr = handle renewal command reply from child process
#         (processes TRUE/FALSE/SIZE responses)

my $reply_data = shift;

my $domain = $reply_data->{'params'}{'domain'};
my $mode   = $reply_data->{'cmd'};
my $args   = $reply_data->{'call_args'}{'args'};
my $data   = $reply_data->{'data'};

<[base.log]>->( 2, "renewal reply for domain : $domain, mode : $mode" );

if ( $mode eq 'TRUE' ) {
    <[base.log]>->( 2, "renewal succeeded for $domain: $args" );

    ## Mark successful renewal
    if ( exists <letsencr.parent.renewal_timers>->{$domain} ) {
        delete <letsencr.parent.renewal_timers>->{$domain};
    }
    <letsencr.stats.renewals_completed>++;

} elsif ( $mode eq 'FALSE' ) {
    <[base.log]>->( 1, "renewal failed for $domain: $args" );

    ## Schedule retry with exponential backoff
    my $attempt = ( $reply_data->{'params'}{'attempt'} // 1 ) + 1;

    if ( $attempt <= 5 ) {
        my @backoff_delays = ( 300, 600, 1200, 2400, 4800 )
            ;    ## 5min, 10min, 20min, 40min, 80min
        my $delay = $backoff_delays[ $attempt - 1 ] // 4800;

        <[base.log]>->(
            2,
            "scheduling retry for $domain in $delay seconds"
                . " (attempt $attempt)"
        );

        ## mark as pending retry in renewal_timers for handler to pick up
        <letsencr.parent.renewal_timers>->{$domain}{status}   = qw| retry |;
        <letsencr.parent.renewal_timers>->{$domain}{attempts} = $attempt;

        <[event.add_timer]>->(
            {   'delay'   => $delay,
                'handler' => qw| letsencr.parent.handler_renewal_retry |,
            }
        );
    } else {
        <[base.log]>->(
            0, "renewal failed for $domain after 5 attempts - giving up"
        );
        <letsencr.stats.renewals_failed>++;
    }

} elsif ( $mode eq 'SIZE' ) {
    <[base.log]>->(
        2,
        "renewal returned certificate data for $domain ("
            . length($data)
            . " bytes)"
    );

    ## Certificate data returned — decode base32r JSON bundle from child
    my $bundle_json = eval { decode_b32r($data) };
    my $cert_bundle
        = defined $bundle_json
        ? eval { JSON::XS::decode_json($bundle_json) }
        : undef;

    unless ( $cert_bundle && ref($cert_bundle) eq qw| HASH | ) {
        <[base.log]>->(
            0, "renewal: failed to decode cert bundle for $domain"
        );
        return FALSE;
    }

    ## save certificate using the established save_certificate module
    my $save_result = <[letsencr.parent.save_certificate]>->($cert_bundle);
    unless ( $save_result && $save_result->{status} eq qw| success | ) {
        <[base.logs]>->(
            0, "renewal: failed to save certificate for %s", $domain
        );
        return FALSE;
    }

    <[base.logs]>->( 2, "saved certificate for %s", $domain );

    ## Update in-memory registry
    <letsencr.parent.certs>->{$domain} = {
        issued_at       => $cert_bundle->{issued_at} // time(),
        expires_at      => $cert_bundle->{expires_at},
        domain          => $domain,
        alt_names       => $cert_bundle->{domains} // [],
        certificate_url => $cert_bundle->{cert_url},
    };

    if ( exists <letsencr.parent.renewal_timers>->{$domain} ) {
        delete <letsencr.parent.renewal_timers>->{$domain};
    }
    <letsencr.stats.renewals_completed>++;

    ## Install renewed certificate to httpsd
    <[base.log]>->(
        2, "installing renewed certificate to httpsd for $domain"
    );

    my $httpsd_install_result
        = <[letsencr.parent.install_certificate_to_httpsd]>->($domain);

    if ( $httpsd_install_result->{status} eq qw| success | ) {
        <[base.log]>->(
            2, "renewed certificate installed to httpsd successfully"
        );
        <[letsencr.parent.activity_logger]>->(
            qw| renewal |, $domain, qw| success |,
            qq| renewed and installed to httpsd |
        );
    } elsif ( $httpsd_install_result->{status} eq qw| partial | ) {
        <[base.log]>->(
            1,
            "renewed certificate installed but httpsd reload failed: "
                . $httpsd_install_result->{message}
        );
        <[letsencr.parent.activity_logger]>->(
            qw| renewal |, $domain, qw| partial |,
            qq| renewed but httpsd reload failed |
        );
    } else {
        <[base.log]>->(
            1,
            "failed to install renewed certificate to httpsd: "
                . $httpsd_install_result->{message}
        );
        <[letsencr.parent.activity_logger]>->(
            qw| renewal |, $domain, qw| partial |,
            qq| renewed but httpsd install failed |
        );
    }

    ## Notify HTTPd that certificate has been updated
    my $notify_result
        = <[letsencr.parent.notify_httpd_certificate_update]>->(
        {   domain    => $domain,
            cert_path => $cert_path,
            key_path => sprintf( '%s/%s.key', <letsencr.certs.dir>, $domain ),
        }
        );

    if ( !$notify_result || $notify_result->{status} ne 'success' ) {
        <[base.log]>->(
            1,
            "warning: failed to notify httpd"
                . " of certificate update for $domain"
        );
    }

} else {
    <[base.log]>->( 1, "renewal got unexpected mode : $mode for $domain" );
}

return FALSE;

