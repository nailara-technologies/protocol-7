## [:< ##

# name = workflow.parent.init_code
# descr = initialize workflow orchestration zenka for git/release management

<[base.log]>->( 2, 'initializing workflow orchestration zenka..,' );

## Configuration - always use auto-detected root path (override any cached value)
<workflow.cfg.git_binary>          //= '/usr/bin/git';
<workflow.cfg.root_path>           = <system.root_path>;
<workflow.cfg.signing_key_loaded>  //= 0;   ## Track if key decrypted this session
<workflow.cfg.auto_scan_on_start>  //= 0;   ## Auto-scan history at startup
<workflow.cfg.version_seed>        //= 54;  ## AMOS7 version seed
<workflow.cfg.readme_path>         //= 'read-me/md/README.md';
<workflow.cfg.versions_path>       //= 'read-me/project-identity/source-code-versions.md';

## Registries
<workflow.history.scanned>      //= 0;      ## Timestamp of last scan
<workflow.history.commits>      //= {};     ## All commits analyzed
<workflow.history.issues>       //= {};     ## Issues found (missing versions, wrong emails, etc.)
<workflow.history.gaps>         //= [];     ## Version number gaps
<workflow.history.unsigned>     //= [];     ## Unsigned commits

## Issue types registry
<workflow.issues.types> = {
    missing_version => 'Commit missing version number',
    wrong_email     => 'Commit author email mismatch',
    unsigned        => 'Commit not signed with AMOS7',
    bad_signature   => 'Invalid or corrupted signature',
    version_gap     => 'Version sequence has gaps'
};

## Statistics - initialize all fields to prevent undefined warnings
<workflow.stats> //= {};
<workflow.stats.commits_total>    //= 0;
<workflow.stats.commits_analyzed> //= 0;
<workflow.stats.issues_found>     //= 0;
<workflow.stats.commits_rewritten> //= 0;
<workflow.stats.commits_resigned>  //= 0;
<workflow.stats.history_scans>    //= 0;

## Email harmonization map
<workflow.email.canonical> = {
    ## Map various email forms to canonical ones
    ## Will be populated from scan
};

<[base.log]>->( 2, 'workflow orchestration zenka initialized' );

0;

