## [:< ##

# name = image-quality.analyze
# descr = Analyze image quality using vision models (hybrid HTTP/subprocess)

<[base.perlmod.load]>->('Time::HiRes', qw| time |);

my $image_path = shift;
my $start_time = Time::HiRes::time();

# Validate input
return { success => FALSE, error => 'Image path required' } unless defined $image_path;
return { success => FALSE, error => "File not found: $image_path" } unless -f $image_path;

# Select vision model from registry
my $model_selection = <[image-quality.vision.select_model]>;
return $model_selection unless $model_selection->{success};

# Prepare analysis prompt
my $analysis_prompt = q{
Analyze this image and provide quality assessment:
1. Composition and framing (score 0-1)
2. Lighting quality (score 0-1)
3. Technical quality: sharpness, noise, artifacts (score 0-1)
4. Subject relevance and clarity (score 0-1)
5. Overall grade (A+ to F)

Respond in JSON format with scores and brief reasoning.
};

# Try HTTP API first (primary method)
my $result = <[image-quality.vision.http_api]>->(
    $image_path,
    $model_selection->{model_path},
    $analysis_prompt
);

# Fallback to subprocess if HTTP failed
if (!$result->{success}) {
    <[base.logs]>->(1, "HTTP API failed, trying subprocess: %s", $result->{error});
    $result = <[image-quality.vision.subprocess]>->(
        $image_path,
        $model_selection->{model_path},
        $analysis_prompt
    );
}

return $result unless $result->{success};

# Parse vision model response into structured metrics
my $metrics = <[image-quality.vision.parse_response]>->($result->{response});
return $metrics unless $metrics->{success};

# Calculate duration
my $duration_ms = int((Time::HiRes::time() - $start_time) * 1000);

# TODO: Implement operation_log and analysis_cache using Protocol-7 data structures
# These require proper angle-bracket syntax support for hash operations

return {
    success => TRUE,
    image_path => $image_path,
    composition => $metrics->{composition},
    lighting => $metrics->{lighting},
    technical => $metrics->{technical},
    relevance => $metrics->{relevance},
    overall_grade => $metrics->{overall_grade},
    model_used => $model_selection->{model_path},
    duration_ms => $duration_ms,
    method => $result->{method} // 'http',
    analyzed_at => time()
};

