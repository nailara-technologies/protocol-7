# name = httpd.system.network_io
# descr = get network interface I/O statistics (placeholder)

my $interface = shift // 'eth0';

# Return placeholder network stats until real implementation is available
return {
    'rx_bytes' => 1024 * 1024 * 10,  # 10MB received
    'tx_bytes' => 1024 * 1024 * 5,   # 5MB transmitted
    'rx_packets' => 1000,
    'tx_packets' => 500,
    'interface' => $interface
};

