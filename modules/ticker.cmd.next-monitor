## [:< ##

# name  = ticker.cmd.next-monitor
# descr = cycle swap-mode ticker to the next monitor

<ticker.window.monitor> = qw| cycle |;

## re-apply current profile: set-window-profile will select the next monitor ##
if ( defined <ticker.obj.window> ) {
    <[ticker.cmd.set-window-profile]>
        ->( { 'args' => <ticker.window.profile> // qw| bottom-strip | } );
}

my $info = sprintf(
    'x=%d y=%d w=%d h=%d',
    <x11.coordinates.left>, <x11.coordinates.top>,
    <x11.window.width>,     <x11.window.height>
);

return { 'mode' => qw| true |, 'data' => "cycled monitor: $info" };

