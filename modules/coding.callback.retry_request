# name  = coding.callback.retry_request
# descr = Retry handler for failed HTTP requests

## timer callbacks receive watcher object, extract data from it ##
## timer event handler: shift gives event object, ->w gives watcher ##
my $task_id = shift->w->data;

return unless defined $task_id && !ref $task_id;

<[base.logs]>->( 2, "retry_request: executing retry for %s", $task_id );

## clear retry pending flag ##
my $state = <[coding.async.state_manager]>->( qw| get |, $task_id );
if ( defined $state ) {
    $state->{'retry_pending'} = FALSE;
    <coding.async.task_state>->{$task_id} = $state;
}

<[coding.async.send_request]>->($task_id);

return;

