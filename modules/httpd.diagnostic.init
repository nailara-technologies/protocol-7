## [:< ##

# name = httpd.diagnostic.init

# Initialize HTTP diagnostic system
<httpd.diagnostic> = {
    'operations' => {},    # Current operations
    'history'    => [],    # Completed operations
    'issues'     => [],    # Detected issues
    'settings'   => {
        'max_history'          => 1000,
        'operation_thresholds' => {
            'file_transfer_init' => 0.01,     # 10ms
            'file_read'          => 0.005,    # 5ms
            'http_parse'         => 0.01,     # 10ms
        }
    }
};

# Install instrumentation on event loop if available
if ( defined &install_event_loop_instrumentation ) {
    install_event_loop_instrumentation();
}

<[base.log]>->( 1, "HTTP diagnostic system initialized" );
return 1;
