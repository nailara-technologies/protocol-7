## [:< ##

# name  = coding.async.chunk_handler
# descr = Handle streaming chunks with state machine integration
# purpose = Phase 2/3: Process chunks, detect tool calls, trigger transitions

my ( $task_id, $chunk_data, $context ) = @ARG;

return $context unless defined $task_id && defined $chunk_data;

$context                    //= {};
$context->{'content'}       //= '';
$context->{'tool_calls'}    //= [];
$context->{'finish_reason'} //= undef;
$context->{'chunk_num'}     //= 0;

$context->{'chunk_num'}++;

## validate chunk is hash ##
my $type = ref($chunk_data) || 'SCALAR';
if ( $type ne 'HASH' ) {
    ## skip non-hash chunks (hex values that slipped through) ##
    return $context;
}

## extract choice ##
my $choice = $chunk_data->{'choices'}->[0];
return $context unless defined $choice;

## extract delta content [ fallback to message for non-sse responses ] ##
my $delta = $choice->{'delta'} // $choice->{'message'} // {};

## accumulate reasoning_content separately [ qwen3 thinking trace ] ##
## never mix into content : it causes double-output in model_output buffer ##
my $content = $delta->{'content'} // '';
if ( length( $delta->{'reasoning_content'} // '' ) ) {
    $context->{'reasoning'} .= $delta->{'reasoning_content'};
    $context->{'has_reasoning_content'} = TRUE;
}

## handle tool calls in delta ##
## streaming tool_calls come in partial chunks by index, need to merge ##
if ( exists $delta->{'tool_calls'}
    && ref( $delta->{'tool_calls'} ) eq 'ARRAY' ) {
    foreach my $tc ( $delta->{'tool_calls'}->@* ) {
        my $idx = $tc->{'index'} // 0;
        ## initialize tool call structure if new ##
        if ( !$context->{'tool_calls'}[$idx] ) {
            $context->{'tool_calls'}[$idx] = {
                'id'       => $tc->{'id'},
                'type'     => $tc->{'type'} // 'function',
                'function' => { 'name' => '', 'arguments' => '' },
            };
        }
        ## merge partial data ##
        my $existing = $context->{'tool_calls'}[$idx];
        $existing->{'id'} //= $tc->{'id'};
        if ( defined $tc->{'function'}{'name'} ) {
            $existing->{'function'}{'name'} = $tc->{'function'}{'name'};
        }
        if ( defined $tc->{'function'}{'arguments'} ) {
            $existing->{'function'}{'arguments'}
                .= $tc->{'function'}{'arguments'};
        }
    }
}

## accumulate content ##
if ( length($content) ) {
    $context->{'content'} .= $content;
}

## extract <think> blocks from content into reasoning [ model may emit them inline ] ##
## do this after accumulation to handle multi-chunk blocks ##
while ( $context->{'content'} =~ s|<think>(.*?)</think>||s ) {
    my $reasoning_text = $1;
    $reasoning_text =~ s|^\s+||;
    $reasoning_text =~ s|\s+$||;
    if ( length $reasoning_text ) {
        $context->{'reasoning'} .= "\n"
            if length( $context->{'reasoning'} // '' );
        $context->{'reasoning'} .= $reasoning_text;
    }
}
## strip stray closing tag if model emits </think> without opening tag ##
$context->{'content'} =~ s|^\s*</think>\s*||;

## check for finish reason ##
if ( defined $choice->{'finish_reason'} ) {
    my $finish = $choice->{'finish_reason'};
    $context->{'finish_reason'} = $finish;

    ## fall back to reasoning if content is empty at finish ##
    ## qwen3 thinking models sometimes emit only reasoning_content ##
    ## strip tool call markup : tool calls are handled separately and  ##
    ## leaving xml in content confuses the model in subsequent rounds  ##
    if (  !length( $context->{'content'} // '' )
        && length( $context->{'reasoning'} // '' ) ) {
        my $reasoning_text = $context->{'reasoning'};
        $reasoning_text =~ s|<tool_call>.*?</tool_call>||gs;
        $reasoning_text =~ s|<function\s*=\s*\w+\s*>.*?</function>||gs;
        $reasoning_text =~ s|^\s+||;
        $reasoning_text =~ s|\s+$||;
        $context->{'content'} = $reasoning_text if length $reasoning_text;
    }

    ## log current state before transition ##
    my $content_preview = substr( $context->{'content'} // '', 0, 50 );
    $content_preview =~ s/\n/ /g;
    <[base.logs]>->(
        2,
        "chunk_handler: task %s finish_reason=%s"
            . " content=[%s...] tool_calls=%d",
        $task_id,
        $finish,
        $content_preview,
        scalar( @{ $context->{'tool_calls'} // [] } )
    );

    ## determine next state based on finish_reason ##
    if ( $finish eq 'tool_calls' || $finish eq 'function_call' ) {
        ## model wants to use tools ##
        if ( @{ $context->{'tool_calls'} } ) {
            <[coding.async.state_machine]>->(
                'transition',
                $task_id,
                {   'event'      => 'finish_tool_calls',
                    'tool_calls' => $context->{'tool_calls'},
                    'content'    => $context->{'content'},
                    'reasoning'  => $context->{'reasoning'} // '',
                }
            );
        }
    } elsif ( $finish eq 'stop' || $finish eq 'end_turn' ) {
        ## guard: don't complete parent while compaction subtask is pending ##
        my $task_state
            = <[coding.async.state_manager]>->( qw| get |, $task_id );
        if ( defined $task_state
            && length( $task_state->{'compaction_pending'} // '' ) ) {
            <[base.logs]>->(
                1,
                "chunk_handler: %s finish_stop but compaction %s pending : holding",
                $task_id,
                $task_state->{'compaction_pending'}
            );
            ## store finish data for later application after compaction ##
            $task_state->{'finish_hold_content'}   = $context->{'content'};
            $task_state->{'finish_hold_reasoning'} = $context->{'reasoning'}
                // '';
            $task_state->{'finish_hold_tools'} = $context->{'tool_calls'}
                // [];
            <coding.async.task_state>->{$task_id} = $task_state;
            return $context;
        }

        ## check if we have tool calls even on stop (model quirk) ##
        if ( @{ $context->{'tool_calls'} // [] } ) {
            <[base.logs]>->(
                1,
                "chunk_handler: finish_reason=stop but %d tool_calls pending",
                scalar( @{ $context->{'tool_calls'} } )
            );
            <[coding.async.state_machine]>->(
                'transition',
                $task_id,
                {   'event'      => 'finish_tool_calls',
                    'tool_calls' => $context->{'tool_calls'},
                    'content'    => $context->{'content'},
                    'reasoning'  => $context->{'reasoning'} // '',
                }
            );
        } else {
            ## check for tool calls in content [ model quirk ] ##
            ## models emit tool calls as xml or json in content ##
            ## instead of structured tool_calls array ##
            my $parsed_tools
                = <[coding.parse.xml_tool_calls]>->( $context->{'content'} );

            ## also check reasoning_content : qwen3 thinking emits xml tool ##
            ## calls in reasoning_content rather than content                ##
            if ( !@{$parsed_tools}
                && length( $context->{'reasoning'} // '' ) ) {
                $parsed_tools
                    = <[coding.parse.xml_tool_calls]>
                    ->( $context->{'reasoning'} );
                <[base.logs]>->(
                    1, "chunk_handler: checking reasoning for xml tool_calls"
                ) if @{$parsed_tools};
            }

            ## fallback: try json tool calls if xml found nothing ##
            if ( !@{$parsed_tools} ) {
                $parsed_tools = <[coding.parse.json_tool_calls]>
                    ->( $context->{'content'} );
            }

            if ( @{$parsed_tools} ) {
                <[base.logs]>->(
                    1,
                    "chunk_handler: extracted %d tool_calls from content",
                    scalar( @{$parsed_tools} )
                );
                <[coding.async.state_machine]>->(
                    'transition',
                    $task_id,
                    {   'event'      => 'finish_tool_calls',
                        'tool_calls' => $parsed_tools,
                        'content'    => $context->{'content'},
                        'reasoning'  => $context->{'reasoning'} // '',
                    }
                );
            } else {
                ## normal completion ##
                <[coding.async.state_machine]>->(
                    'transition',
                    $task_id,
                    {   'event'     => 'finish_stop',
                        'content'   => $context->{'content'},
                        'reasoning' => $context->{'reasoning'} // '',
                    }
                );
            }
        }
    } elsif ( $finish eq 'length' ) {
        ## max tokens reached ##
        <[base.logs]>->(
            1, "chunk_handler: max tokens reached for %s", $task_id
        );
        <[coding.async.state_machine]>->(
            'transition',
            $task_id,
            {   'event'     => 'finish_stop',
                'content'   => $context->{'content'},
                'reasoning' => $context->{'reasoning'} // '',
            }
        );
    } elsif ( $finish eq 'content_filter' ) {
        ## content blocked ##
        <[base.logs]>->(
            0, "chunk_handler: content filtered for %s", $task_id
        );
        <[coding.async.state_machine]>->(
            'transition',
            $task_id,
            {   'event' => 'error',
                'error' => 'Content filtered by safety system',
            }
        );
    }
}

return $context;

