# name  = coding.async.chunk_handler
# descr = Handle streaming chunks with state machine integration
# purpose = Phase 2/3: Process chunks, detect tool calls, trigger transitions

my ( $task_id, $chunk_data, $context ) = @ARG;

return $context unless defined $task_id && defined $chunk_data;

$context                    //= {};
$context->{'content'}       //= '';
$context->{'tool_calls'}    //= [];
$context->{'finish_reason'} //= undef;
$context->{'chunk_num'}     //= 0;

$context->{'chunk_num'}++;

## validate chunk is hash ##
my $type = ref($chunk_data) || 'SCALAR';
if ( $type ne 'HASH' ) {
    ## skip non-hash chunks (hex values that slipped through) ##
    return $context;
}

## extract choice ##
my $choice = $chunk_data->{'choices'}->[0];
return $context unless defined $choice;

## extract delta content [ fallback to message for non-sse responses ] ##
my $delta = $choice->{'delta'} // $choice->{'message'} // {};

## accumulate reasoning_content separately [ qwen3 thinking trace ] never ##
## mix into content : it causes double-output in model_output buffer      ##
my $content = $delta->{'content'} // '';
if ( length( $delta->{'reasoning_content'} // '' ) ) {
    $context->{'reasoning'} .= $delta->{'reasoning_content'};
    $context->{'has_reasoning_content'} = TRUE;
}

## handle tool calls in delta  streaming tool_calls come in partial chunks ##
## by index, need to merge                                                 ##
if ( exists $delta->{'tool_calls'}
    && ref( $delta->{'tool_calls'} ) eq 'ARRAY' ) {
    foreach my $tc ( $delta->{'tool_calls'}->@* ) {
        my $idx = $tc->{'index'} // 0;
        ## initialize tool call structure if new ##
        if ( !$context->{'tool_calls'}[$idx] ) {
            $context->{'tool_calls'}[$idx] = {
                'id'       => $tc->{'id'},
                'type'     => $tc->{'type'} // 'function',
                'function' => { 'name' => '', 'arguments' => '' },
            };
        }
        ## merge partial data ##
        my $existing = $context->{'tool_calls'}[$idx];
        $existing->{'id'} //= $tc->{'id'};
        if ( defined $tc->{'function'}{'name'} ) {
            $existing->{'function'}{'name'} = $tc->{'function'}{'name'};
        }
        if ( defined $tc->{'function'}{'arguments'} ) {
            $existing->{'function'}{'arguments'}
                .= $tc->{'function'}{'arguments'};
        }
    }
}

## accumulate content ##
if ( length($content) ) {
    $context->{'content'} .= $content;
}

## extract <think> blocks from content into reasoning [ model may emit them ##
## inline ] do this after accumulation to handle multi-chunk blocks         ##
while ( $context->{'content'} =~ s|<think>(.*?)</think>||s ) {
    my $reasoning_text = $1;
    $reasoning_text =~ s|^\s+||;
    $reasoning_text =~ s|\s+$||;
    if ( length $reasoning_text ) {
        $context->{'reasoning'} .= "\n"
            if length( $context->{'reasoning'} // '' );
        $context->{'reasoning'} .= $reasoning_text;
    }
}
## strip stray closing tag if model emits </think> without opening tag ##
$context->{'content'} =~ s|^\s*</think>\s*||;

## check for finish reason ##
if ( defined $choice->{'finish_reason'} ) {
    my $finish = $choice->{'finish_reason'};
    $context->{'finish_reason'} = $finish;

    ## fall back to reasoning if content is empty at finish  qwen3 thinking ##
    ## models sometimes emit only reasoning_content strip tool call markup  ##
    ## : tool calls are handled separately and leaving xml in content       ##
    ## confuses the model in subsequent rounds                              ##
    if (  !length( $context->{'content'} // '' )
        && length( $context->{'reasoning'} // '' ) ) {
        my $reasoning_text = $context->{'reasoning'};
        $reasoning_text =~ s|<tool_call>.*?</tool_call>||gs;
        $reasoning_text =~ s|<function\s*=\s*\w+\s*>.*?</function>||gs;
        $reasoning_text =~ s|^\s+||;
        $reasoning_text =~ s|\s+$||;
        $context->{'content'} = $reasoning_text if length $reasoning_text;
    }

    ## log current state before transition ##
    my $content_preview = substr( $context->{'content'} // '', 0, 50 );
    $content_preview =~ s/\n/ /g;
    <[base.logs]>->(
        2,
        "chunk_handler: task %s finish_reason=%s "
            . "content=[%s...] tool_calls=%d",
        $task_id,
        $finish,
        $content_preview,
        scalar( @{ $context->{'tool_calls'} // [] } )
    );

    ## determine next state based on finish_reason ##
    if ( ( $finish eq 'tool_calls' || $finish eq 'function_call' )
        && @{ $context->{'tool_calls'} } ) {
        ## model wants to use tools ##
        <[coding.async.state_machine]>->(
            'transition',
            $task_id,
            {   'event'      => 'finish_tool_calls',
                'tool_calls' => $context->{'tool_calls'},
                'content'    => $context->{'content'},
                'reasoning'  => $context->{'reasoning'} // '',
            }
        );
    } elsif ( $finish eq 'stop'
        || $finish eq 'end_turn'
        || $finish eq 'tool_calls'
        || $finish eq 'function_call' ) {
        ## finish=tool_calls with empty tool_calls array falls through here ##
        ## [ server quirk : claimed tool call but delivered none ]. treat   ##
        ## as stop so xml/json fallback parse runs and, failing that,       ##
        ## finish_stop dispatches so the state machine reaches a terminal   ##
        ## state. without this the round stalls at sm_state='streaming' and ##
        ## the task never completes or fails, orphaning the caller [        ##
        ## task-zenka records stuck at in_progress forever ].  guard: don't ##
        ## complete parent while compaction subtask is pending              ##
        my $task_state
            = <[coding.async.state_manager]>->( qw| get |, $task_id );
        if ( defined $task_state
            && length( $task_state->{'compaction_pending'} // '' ) ) {
            <[base.logs]>->(
                1,
                "chunk_handler: %s finish_stop but "
                    . "compaction %s pending : holding",
                $task_id,
                $task_state->{'compaction_pending'}
            );
            ## store finish data for later application after compaction ##
            $task_state->{'finish_hold_content'}   = $context->{'content'};
            $task_state->{'finish_hold_reasoning'} = $context->{'reasoning'}
                // '';
            $task_state->{'finish_hold_tools'} = $context->{'tool_calls'}
                // [];
            <coding.async.task_state>->{$task_id} = $task_state;
            return $context;
        }

        ## intercept model_selection responses on self-select tasks [ round ##
        ## 0 ] round 0 of a self-select task never completes : it always    ##
        ## continues                                                        ##
        my $task_ref_ch = <coding.task.queue>->{$task_id} // {};
        if (    ( $task_ref_ch->{'self_select_model'} // 0 )
            and ( $context->{'round'} // 0 ) == 0
            and length( $context->{'content'} // '' ) ) {

            my $state_ch
                = <[coding.async.state_manager]>->( qw| get |, $task_id );
            my $old_backend = $state_ch->{'backend'} // '';
            my $new_backend = $old_backend;

            my $parsed = <[coding.parser.model_selection]>
                ->( $context->{'content'} );
            if ( defined $parsed and length $parsed->{'backend'} ) {
                $new_backend = $parsed->{'backend'};

                ## validate reason [ min 20 words, not vague ] ##
                my $reason       = $parsed->{'reason'} // '';
                my @words        = split /\s+/, $reason;
                my $valid_reason = scalar(@words) >= 20
                    && $reason
                    !~ m{^(?:this\s+is\s+(?:a\s+)?complex|i\s+need\s+.+\s+because)}i;

                if ( !$valid_reason ) {
                    <[base.logs]>->(
                        1,
                        "chunk_handler: %s model_selection reason "
                            . "rejected [ %d words ] : using default backend",
                        $task_id,
                        scalar(@words)
                    );
                    $new_backend = $old_backend;
                }

                ## forensics log ##
                <[base.logs]>->(
                    1,
                    "coding: [%s] model=%s reason=\"%s\" source=self",
                    $task_id,
                    $new_backend,
                    <[base.parser.center_ellipse_string]>->( $reason, 60 )
                );
            } else {
                <[base.logs]>->(
                    1,
                    "chunk_handler: %s model_selection block "
                        . "not found : using default backend %s",
                    $task_id,
                    $old_backend
                );
            }

            ## strip model_selection block from content if present ##
            my $stripped = $context->{'content'};
            $stripped =~ s#```ya?ml\s*\n\s*model_selection:.*?(?:```|\z)##s;
            $stripped =~ s|model_selection:\s*\n.*||s; ## unfenced fallback ##
            $stripped =~ s|^\s+||;
            $stripped =~ s|\s+$||;

            ## add assistant message to history ##
            push @{ $state_ch->{'messages'} },
                {
                'role'    => 'assistant',
                'content' => length($stripped)
                ? $stripped
                : '[model selected]',
                };

            ## update state for next round ##
            $state_ch->{'round'}++;
            $state_ch->{'backend'} = $new_backend;
            $state_ch->{'port'}
                = $new_backend eq qw| cpu |
                ? ( <inference.backend.cpu.port> // 8001 )
                : ( <inference.backend.gpu.port> // 8000 );
            $state_ch->{'model_selection_applied'} = TRUE;
            $state_ch->{'content'}                 = '';
            $state_ch->{'tool_calls'}              = [];

            ## update task routing so async.request uses new backend ##
            $task_ref_ch->{'analysis'}->{'routed_to'} = $new_backend;

            ## release old backend lock if backend changed ##
            if ( length $old_backend
                and $old_backend ne $new_backend ) {
                <[coding.async.backend_release]>->( $task_id, $old_backend );
            }

            <coding.async.task_state>->{$task_id} = $state_ch;

            ## dispatch next round on selected backend ##
            <[coding.async.send_request]>->($task_id);

            $context->{'finish_reason'} = qw| model_selected |;
            return $context;
        }

        ## check if we have tool calls even on stop (model quirk) ##
        if ( @{ $context->{'tool_calls'} // [] } ) {
            <[base.logs]>->(
                1,
                "chunk_handler: finish_reason=stop but %d tool_calls pending",
                scalar( @{ $context->{'tool_calls'} } )
            );
            <[coding.async.state_machine]>->(
                'transition',
                $task_id,
                {   'event'      => 'finish_tool_calls',
                    'tool_calls' => $context->{'tool_calls'},
                    'content'    => $context->{'content'},
                    'reasoning'  => $context->{'reasoning'} // '',
                }
            );
        } else {
            ## check for tool calls in content [ model quirk ] models emit ##
            ## tool calls as xml or json in content instead of structured  ##
            ## tool_calls array                                            ##
            my $parsed_tools
                = <[coding.parse.xml_tool_calls]>->( $context->{'content'} );

            ## also check reasoning_content : qwen3 thinking emits xml tool ##
            ## calls in reasoning_content rather than content skip for      ##
            ## no_tools tasks : model hallucinating tool calls in reasoning ##
            ## has no tools to call, treat as normal completion             ##
            my $task_flags_ch = <coding.task.queue>->{$task_id} // {};
            if (   !@{$parsed_tools}
                && !$task_flags_ch->{'no_tools'}
                && length( $context->{'reasoning'} // '' ) ) {
                $parsed_tools
                    = <[coding.parse.xml_tool_calls]>
                    ->( $context->{'reasoning'} );
                <[base.logs]>->(
                    1, "chunk_handler: checking reasoning for xml tool_calls"
                ) if @{$parsed_tools};
            }

            ## fallback: try json tool calls if xml found nothing ##
            if ( !@{$parsed_tools} ) {
                $parsed_tools = <[coding.parse.json_tool_calls]>
                    ->( $context->{'content'} );
            }

            if ( @{$parsed_tools} ) {
                <[base.logs]>->(
                    1,
                    "chunk_handler: extracted %d tool_calls from content",
                    scalar( @{$parsed_tools} )
                );
                <[coding.async.state_machine]>->(
                    'transition',
                    $task_id,
                    {   'event'      => 'finish_tool_calls',
                        'tool_calls' => $parsed_tools,
                        'content'    => $context->{'content'},
                        'reasoning'  => $context->{'reasoning'} // '',
                    }
                );
            } else {
                ## detect tool-call-shaped-but-unparseable content : model  ##
                ## tried to call a tool in a format our parsers don't know  ##
                ## [ e.g. <tool_code>...</tool_code>, <invoke name=..>, or  ##
                ## a top-level {"name":..,"arguments":..} json blob ]. left ##
                ## alone this silently completes as status:done with the    ##
                ## raw unparseable text as the "final answer", eroding      ##
                ## trust in the completion signal. nudge with a format      ##
                ## reminder and retry a bounded number of times [ mirrors   ##
                ## the retry discipline in                                  ##
                ## coding.handler.monitor_inference_startup's cat-test path ##
                ## ]; if the model keeps producing the same shape, fail the ##
                ## task cleanly with a real error rather than reporting     ##
                ## done. skip on no_tools tasks : no tools to call, a stray ##
                ## shape there is genuinely just prose.                     ##
                my $shape_src         = $context->{'content'} // '';
                my $tc_shape_detected = FALSE;
                if ( !$task_flags_ch->{'no_tools'} ) {
                    if (   $shape_src =~ m{<tool_code\b}i
                        || $shape_src =~ m{</tool_code>}i
                        || $shape_src =~ m{<tool_call\b}i
                        || $shape_src =~ m{<function\s*=}i
                        || $shape_src =~ m{<invoke\b}i
                        || $shape_src
                        =~ m{\A\s*\{\s*"name"\s*:\s*"\w+"\s*,\s*"(?:arguments|parameters)"\s*:}s
                    ) {
                        $tc_shape_detected = TRUE;
                    }
                }

                if ($tc_shape_detected) {
                    my $state_ur = <[coding.async.state_manager]>->(
                        qw| get |, $task_id
                    ) // {};
                    my $retry_max
                        = <coding.cfg.unparseable_tool_call_retry_max> // 2;
                    my $retries
                        = $state_ur->{'unparseable_tool_call_retries'} // 0;

                    if ( $retries < $retry_max ) {
                        $state_ur->{'unparseable_tool_call_retries'}
                            = $retries + 1;
                        <[base.logs]>->(
                            1,
                            'chunk_handler: %s '
                                . 'tool-call-shaped-but-unparseable content '
                                . ': injecting format reminder [ attempt '
                                . '%d/%d ]',
                            $task_id,
                            $retries + 1,
                            $retry_max
                        );

                        ## record the model's [ unparseable ] turn in ##
                        ## history                                    ##
                        push @{ $state_ur->{'messages'} },
                            {
                            'role'    => 'assistant',
                            'content' => $context->{'content'} // '',
                            };
                        ## inject the reminder as a user turn ##
                        push @{ $state_ur->{'messages'} },
                            {
                            'role'    => 'user',
                            'content' =>
                                'Your previous reply looks like an attempt'
                                . ' to call a tool in an unrecognized format.'
                                . ' To call a tool, emit exactly:'
                                . ' <tool_call><function=NAME>'
                                . '{"arg":"value"}</function></tool_call>'
                                . ' [ or use the structured tool_calls field'
                                . ' ]. If you intended a final answer,'
                                . ' respond with plain prose containing no'
                                . ' tool-call markup.',
                            };

                        $state_ur->{'round'}++;
                        $state_ur->{'content'}    = '';
                        $state_ur->{'tool_calls'} = [];
                        <coding.async.task_state>->{$task_id} = $state_ur;
                        <[coding.async.send_request]>->($task_id);
                        $context->{'finish_reason'}
                            = qw| tool_call_reminder |;
                        return $context;
                    } else {
                        <[base.logs]>->(
                            0,
                            'chunk_handler: %s tool-call-shape persisted '
                                . 'across %d reminders : failing task',
                            $task_id,
                            $retry_max
                        );
                        <[coding.async.state_machine]>->(
                            'transition',
                            $task_id,
                            {   'event' => 'error',
                                'error' =>
                                    'model produced tool-call-shaped output '
                                    . 'in an unrecognized format across '
                                    . ( $retry_max + 1 )
                                    . ' attempts [ format-reminder '
                                    . 'retries exhausted ]',
                            }
                        );
                        return $context;
                    }
                }

                ## normal completion ##
                <[coding.async.state_machine]>->(
                    'transition',
                    $task_id,
                    {   'event'     => 'finish_stop',
                        'content'   => $context->{'content'},
                        'reasoning' => $context->{'reasoning'} // '',
                    }
                );
            }
        }
    } elsif ( $finish eq 'length' ) {
        ## max tokens reached ##
        <[base.logs]>->(
            1, "chunk_handler: max tokens reached for %s", $task_id
        );
        <[coding.async.state_machine]>->(
            'transition',
            $task_id,
            {   'event'     => 'finish_stop',
                'content'   => $context->{'content'},
                'reasoning' => $context->{'reasoning'} // '',
            }
        );
    } elsif ( $finish eq 'content_filter' ) {
        ## content blocked ##
        <[base.logs]>->(
            0, "chunk_handler: content filtered for %s", $task_id
        );
        <[coding.async.state_machine]>->(
            'transition',
            $task_id,
            {   'event' => 'error',
                'error' => 'Content filtered by safety system',
            }
        );
    }
}

return $context;

