# name  = coding.async.chunk_handler
# descr = Handle streaming chunks with state machine integration
# purpose = Phase 2/3: Process chunks, detect tool calls, trigger transitions

my ( $task_id, $chunk_data, $context ) = @ARG;

return $context unless defined $task_id && defined $chunk_data;

$context                    //= {};
$context->{'content'}       //= '';
$context->{'tool_calls'}    //= [];
$context->{'finish_reason'} //= undef;
$context->{'chunk_num'}     //= 0;

$context->{'chunk_num'}++;

## validate chunk is hash ##
my $type = ref($chunk_data) || 'SCALAR';
if ( $type ne 'HASH' ) {
    ## skip non-hash chunks (hex values that slipped through) ##
    return $context;
}

## extract choice ##
my $choice = $chunk_data->{'choices'}->[0];
return $context unless defined $choice;

## extract delta content ##
my $delta   = $choice->{'delta'}  // {};
my $content = $delta->{'content'} // $delta->{'reasoning_content'} // '';

## handle tool calls in delta ##
if ( exists $delta->{'tool_calls'}
    && ref( $delta->{'tool_calls'} ) eq 'ARRAY' ) {
    push $context->{'tool_calls'}->@*, $delta->{'tool_calls'}->@*;
}

## accumulate content ##
if ( length($content) ) {
    $context->{'content'} .= $content;
}

## check for finish reason ##
if ( defined $choice->{'finish_reason'} ) {
    my $finish = $choice->{'finish_reason'};
    $context->{'finish_reason'} = $finish;

    <[base.logs]>->(
        2,        "chunk_handler: task %s finish_reason=%s",
        $task_id, $finish
    );

    ## determine next state based on finish_reason ##
    if ( $finish eq 'tool_calls' || $finish eq 'function_call' ) {
        ## model wants to use tools ##
        if ( @{ $context->{'tool_calls'} } ) {
            <[coding.async.state_machine]>->(
                $task_id,
                'transition',
                {   'event'      => 'finish_tool_calls',
                    'tool_calls' => $context->{'tool_calls'},
                }
            );
        }
    } elsif ( $finish eq 'stop' || $finish eq 'end_turn' ) {
        ## normal completion ##
        <[coding.async.state_machine]>->(
            $task_id,
            'transition',
            {   'event'   => 'finish_stop',
                'content' => $context->{'content'},
            }
        );
    } elsif ( $finish eq 'length' ) {
        ## max tokens reached ##
        <[base.logs]>->(
            1, "chunk_handler: max tokens reached for %s", $task_id
        );
        <[coding.async.state_machine]>->(
            $task_id,
            'transition',
            {   'event'   => 'finish_stop',
                'content' => $context->{'content'},
            }
        );
    } elsif ( $finish eq 'content_filter' ) {
        ## content blocked ##
        <[base.logs]>->(
            0, "chunk_handler: content filtered for %s", $task_id
        );
        <[coding.async.state_machine]>->(
            $task_id,
            'transition',
            {   'event' => 'error',
                'error' => 'Content filtered by safety system',
            }
        );
    }
}

return $context;

