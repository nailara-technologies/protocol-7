# name  = coding.async.chunk_handler
# descr = Handle streaming chunks with state machine integration
# purpose = Phase 2/3: Process chunks, detect tool calls, trigger transitions

my ( $task_id, $chunk_data, $context ) = @ARG;

return $context unless defined $task_id && defined $chunk_data;

$context                    //= {};
$context->{'content'}       //= '';
$context->{'tool_calls'}    //= [];
$context->{'finish_reason'} //= undef;
$context->{'chunk_num'}     //= 0;

$context->{'chunk_num'}++;

## validate chunk is hash ##
my $type = ref($chunk_data) || 'SCALAR';
if ( $type ne 'HASH' ) {
    ## skip non-hash chunks (hex values that slipped through) ##
    return $context;
}

## extract choice ##
my $choice = $chunk_data->{'choices'}->[0];
return $context unless defined $choice;

## extract delta content [ fallback to message for non-sse responses ] ##
my $delta = $choice->{'delta'} // $choice->{'message'} // {};

## prefer content, fall back to reasoning_content if content is empty ##
## note: content="" is defined but empty — use length check not // ##
my $content = $delta->{'content'} // '';
if ( !length($content) && length( $delta->{'reasoning_content'} // '' ) ) {
    $content = $delta->{'reasoning_content'};
    $context->{'has_reasoning_content'} = TRUE;
}

## handle tool calls in delta ##
## streaming tool_calls come in partial chunks by index, need to merge ##
if ( exists $delta->{'tool_calls'}
    && ref( $delta->{'tool_calls'} ) eq 'ARRAY' ) {
    foreach my $tc ( $delta->{'tool_calls'}->@* ) {
        my $idx = $tc->{'index'} // 0;
        ## initialize tool call structure if new ##
        if ( !$context->{'tool_calls'}[$idx] ) {
            $context->{'tool_calls'}[$idx] = {
                'id'       => $tc->{'id'},
                'type'     => $tc->{'type'} // 'function',
                'function' => { 'name' => '', 'arguments' => '' },
            };
        }
        ## merge partial data ##
        my $existing = $context->{'tool_calls'}[$idx];
        $existing->{'id'} //= $tc->{'id'};
        if ( defined $tc->{'function'}{'name'} ) {
            $existing->{'function'}{'name'} = $tc->{'function'}{'name'};
        }
        if ( defined $tc->{'function'}{'arguments'} ) {
            $existing->{'function'}{'arguments'}
                .= $tc->{'function'}{'arguments'};
        }
    }
}

## accumulate content ##
if ( length($content) ) {
    $context->{'content'} .= $content;
}

## check for finish reason ##
if ( defined $choice->{'finish_reason'} ) {
    my $finish = $choice->{'finish_reason'};
    $context->{'finish_reason'} = $finish;

    ## log current state before transition ##
    my $content_preview = substr( $context->{'content'} // '', 0, 50 );
    $content_preview =~ s/\n/ /g;
    <[base.logs]>->(
        2,
        "chunk_handler: task %s finish_reason=%s"
            . " content=[%s...] tool_calls=%d",
        $task_id,
        $finish,
        $content_preview,
        scalar( @{ $context->{'tool_calls'} // [] } )
    );

    ## determine next state based on finish_reason ##
    if ( $finish eq 'tool_calls' || $finish eq 'function_call' ) {
        ## model wants to use tools ##
        if ( @{ $context->{'tool_calls'} } ) {
            <[coding.async.state_machine]>->(
                'transition',
                $task_id,
                {   'event'      => 'finish_tool_calls',
                    'tool_calls' => $context->{'tool_calls'},
                    'content'    => $context->{'content'},
                }
            );
        }
    } elsif ( $finish eq 'stop' || $finish eq 'end_turn' ) {
        ## check if we have tool calls even on stop (model quirk) ##
        if ( @{ $context->{'tool_calls'} // [] } ) {
            <[base.logs]>->(
                1,
                "chunk_handler: finish_reason=stop but %d tool_calls pending",
                scalar( @{ $context->{'tool_calls'} } )
            );
            <[coding.async.state_machine]>->(
                'transition',
                $task_id,
                {   'event'      => 'finish_tool_calls',
                    'tool_calls' => $context->{'tool_calls'},
                    'content'    => $context->{'content'},
                }
            );
        } else {
            ## check for tool calls in content [ model quirk ] ##
            ## models emit tool calls as xml or json in content ##
            ## instead of structured tool_calls array ##
            my $parsed_tools
                = <[coding.parse.xml_tool_calls]>->( $context->{'content'} );

            ## fallback: try json tool calls if xml found nothing ##
            if ( !@{$parsed_tools} ) {
                $parsed_tools = <[coding.parse.json_tool_calls]>
                    ->( $context->{'content'} );
            }

            if ( @{$parsed_tools} ) {
                <[base.logs]>->(
                    1,
                    "chunk_handler: extracted %d tool_calls from content",
                    scalar( @{$parsed_tools} )
                );
                <[coding.async.state_machine]>->(
                    'transition',
                    $task_id,
                    {   'event'      => 'finish_tool_calls',
                        'tool_calls' => $parsed_tools,
                        'content'    => $context->{'content'},
                    }
                );
            } else {
                ## normal completion ##
                <[coding.async.state_machine]>->(
                    'transition',
                    $task_id,
                    {   'event'   => 'finish_stop',
                        'content' => $context->{'content'},
                    }
                );
            }
        }
    } elsif ( $finish eq 'length' ) {
        ## max tokens reached ##
        <[base.logs]>->(
            1, "chunk_handler: max tokens reached for %s", $task_id
        );
        <[coding.async.state_machine]>->(
            'transition',
            $task_id,
            {   'event'   => 'finish_stop',
                'content' => $context->{'content'},
            }
        );
    } elsif ( $finish eq 'content_filter' ) {
        ## content blocked ##
        <[base.logs]>->(
            0, "chunk_handler: content filtered for %s", $task_id
        );
        <[coding.async.state_machine]>->(
            'transition',
            $task_id,
            {   'event' => 'error',
                'error' => 'Content filtered by safety system',
            }
        );
    }
}

return $context;

