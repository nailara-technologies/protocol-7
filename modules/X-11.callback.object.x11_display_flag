# name  = X-11.callback.object.x11_display_flag
# descr = dep callback: resolves TRUE when the named display is connected

my $obj_id  = shift                          // return FALSE;
my $obj     = <dependency.object>->{$obj_id} // return FALSE;
my $display = $obj->{'display'}              // return FALSE;

return defined <X-11.servers>->{$display}->{'connected'}
    && <X-11.servers>->{$display}->{'connected'} == TRUE ? TRUE : FALSE;

