## [:< ##

# name  = branch.resource.context
# descr = context buffer convenience wrapper
# param = { node, op, data }
#
# op = 'attach' | 'get' | 'detach'
# data is a string [ context text ] or handle

my $params = shift             // {};
my $node   = $params->{'node'} // '';
my $op     = $params->{'op'}   // '';
my $data   = $params->{'data'};

return { 'mode' => 'false', 'data' => 'node id required' }
    unless length $node;
return { 'mode' => 'false', 'data' => 'operation required' }
    unless length $op;

if ( $op eq 'attach' ) {
    return { 'mode' => 'false', 'data' => 'data required' }
        unless defined $data;

    return <[branch.resource.attach]>->(
        {   'node' => $node,
            'type' => 'context',
            'data' => $data
        }
    );
} elsif ( $op eq 'get' ) {
    return <[branch.resource.get]>->(
        {   'node' => $node,
            'type' => 'context'
        }
    );
} elsif ( $op eq 'detach' ) {
    return <[branch.resource.detach]>->(
        {   'node' => $node,
            'type' => 'context'
        }
    );
}

return { 'mode' => 'false', 'data' => 'unknown operation' };

