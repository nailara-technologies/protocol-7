## [:< ##

# name  = data.mount.fuse.init_code
# descr = initialize FUSE mounting subsystem for data zenka

<[base.log]>->( 2, "initializing FUSE mounting subsystem" );

<[base.perlmod.autoload]>->('JSON::XS');

##[ AUTOLOAD PERL MODULES ]#################################################

# Load Fuse module via base.perlmod.autoload
# Note: Fuse is loaded on-demand when first mount is requested
# to avoid loading overhead if FUSE is not used

##[ NAMESPACE INITIALIZATION ]##############################################

# FUSE mount registry - tracks active mounts
<data.fuse.mounts> //= {};    # {$local_dir} -> { pid, hash_path, mountpoint }
<data.fuse.child_pids> //= [];    # List of child PIDs for sigchld handling

# FUSE capability detection
<data.fuse.capabilities.loaded>    = 0;
<data.fuse.capabilities.available> = 0;

# Check if Fuse module is available
if ( eval { require Fuse; 1 } ) {
    <data.fuse.capabilities.available> = 1;
    <[base.log]>->( 2, "FUSE module available (Fuse)" );
} else {
    <[base.log]>->(
        1, "FUSE module not available - install Fuse.pm for mount support"
    );
}

# File type constants for getattr
<data.fuse.const.S_IFDIR> = 0040000;    # directory
<data.fuse.const.S_IFREG> = 0100000;    # regular file
<data.fuse.const.S_IFLNK> = 0120000;    # symbolic link
<data.fuse.const.S_IRUSR> = 0000400;    # owner read
<data.fuse.const.S_IWUSR> = 0000200;    # owner write
<data.fuse.const.S_IXUSR> = 0000100;    # owner execute
<data.fuse.const.S_IRGRP> = 0000040;    # group read
<data.fuse.const.S_IWGRP> = 0000020;    # group write
<data.fuse.const.S_IXGRP> = 0000010;    # group execute
<data.fuse.const.S_IROTH> = 0000004;    # other read
<data.fuse.const.S_IWOTH> = 0000002;    # other write
<data.fuse.const.S_IXOTH> = 0000001;    # other execute

# Default permissions: rwxr-xr-x for dirs, rw-r--r-- for files
<data.fuse.const.MODE_DIR>
    = <data.fuse.const.S_IFDIR> | <data.fuse.const.S_IRUSR>
    | <data.fuse.const.S_IWUSR> | <data.fuse.const.S_IXUSR>
    | <data.fuse.const.S_IRGRP> | <data.fuse.const.S_IXGRP>
    | <data.fuse.const.S_IROTH> | <data.fuse.const.S_IXOTH>;

<data.fuse.const.MODE_FILE>
    = <data.fuse.const.S_IFREG> | <data.fuse.const.S_IRUSR>
    | <data.fuse.const.S_IWUSR> | <data.fuse.const.S_IRGRP>
    | <data.fuse.const.S_IROTH>;

##[ HELPER ROUTINES ]#######################################################

# Path translation: /user/taeki/files -> user.taeki.files
<data.fuse.path_to_hash> = sub {
    my $fuse_path = shift // return '';

    # Remove leading slash
    $fuse_path =~ s|^/||;

    # Replace slashes with dots
    $fuse_path =~ s|/|.|g;

    return $fuse_path;
};

# Path translation: user.taeki.files -> /user/taeki/files
<data.fuse.hash_to_path> = sub {
    my $hash_path = shift // return '/';

    # Replace dots with slashes
    $hash_path =~ s|\.|/|g;

    # Ensure leading slash
    $hash_path = '/' . $hash_path unless $hash_path =~ m|^/|;

    return $hash_path;
};

# Load Fuse module on demand
<data.fuse.load_module> = sub {
    return 1 if <data.fuse.capabilities.loaded>;
    return 0 unless <data.fuse.capabilities.available>;

    eval {
        require Fuse;
        Fuse->import();
    };

    if ($@) {
        <[base.log]>->( 0, "Failed to load Fuse module: $@" );
        return 0;
    }

    <data.fuse.capabilities.loaded> = 1;
    <[base.log]>->( 2, "FUSE module loaded successfully" );
    return 1;
};

<[base.log]>->( 2, "FUSE mounting subsystem initialized" );

return TRUE;

