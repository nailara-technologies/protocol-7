## [:< ##

# name = memory.focus.matches
# descr = predicate does node match topic substring

my $node  = @_ ? shift : $ARG;
my $topic = @_ ? shift : $ARG;

return FALSE if not defined $node  or not ref $node eq 'HASH';
return FALSE if not defined $topic or not length $topic;

my $text = join ' ',
    grep {defined} (
    $node->{'title'}      // '',
    $node->{'body'}       // '',
    $node->{'source_ref'} // '',
    );

return index( lc($text), lc($topic) ) >= 0 ? TRUE : FALSE;

