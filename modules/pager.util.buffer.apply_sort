## [:< ##

# name  = pager.util.buffer.apply_sort
# descr = apply sort specification to pager items

my ( $buf, $items ) = @ARG;

my $sort_spec = $buf->{'sort'};
my $sort_type = $sort_spec->{'type'} // 'multi-key';

my $sort_mod = "pager.sort.$sort_type";
if ( exists $data{'calls'}{$sort_mod} ) {
    $items = <[$sort_mod]>->(
        {   'items' => $items,
            'spec'  => $sort_spec,
        }
    );
}

return $items;

