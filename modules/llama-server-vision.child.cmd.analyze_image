# name  = llama-server-vision.child.cmd.analyze_image
# descr = child-side handler: analyze image with vision model

my ($image_path, $prompt) = split( m| +|, $$call{'args'}, 2 );
$prompt //= 'Describe this image';

unless ( defined $image_path && length $image_path ) {
    return { 'mode' => 'false', 'data' => 'image_path required' };
}

unless ( -f $image_path ) {
    return { 'mode' => 'false', 'data' => "image not found: $image_path" };
}

# Get write handle to vision model's stdin
my $vision_stdin = <llama-server-vision.server_input_fh>;
unless ( defined $vision_stdin ) {
    return { 'mode' => 'false', 'data' => 'vision server not available' };
}

# Track reply_id so response can be routed back to original caller
push( @{<llama-server-vision.reply_ids>}, $$call{'reply_id'} );

# Send image and prompt to vision model
# Format: -img /path/to/image.jpg then the prompt
print $vision_stdin "-img $image_path\n" if defined $vision_stdin;
print $vision_stdin "$prompt\n" if defined $vision_stdin;

<[base.logs]>->( 2, "[child-analyze] processing: image=%s prompt=%s reply_id=%d", $image_path, $prompt, $$call{'reply_id'} );

return { 'mode' => 'deferred' };

