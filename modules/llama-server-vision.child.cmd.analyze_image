# name  = llama-server-vision.child.cmd.analyze_image
# descr = child-side handler: analyze image with vision model

use IPC::Open3;
use Symbol qw(gensym);

my ($image_path, $prompt) = split( m| +|, $$call{'args'}, 2 );
$prompt //= 'Describe this image';

unless ( defined $image_path && length $image_path ) {
    return { 'mode' => 'false', 'data' => 'image_path required' };
}

unless ( -f $image_path ) {
    return { 'mode' => 'false', 'data' => "image not found: $image_path" };
}

# Track reply_id so response can be routed back to original caller
push( @{<llama-server-vision.reply_ids>}, $$call{'reply_id'} );

<[base.logs]>->( 2, "[child-analyze] processing: image=%s prompt=%s", $image_path, $prompt );

# Set up environment for vision model
$ENV{'LD_LIBRARY_PATH'} = <llama-server-vision.lib_path> . ':' . ($ENV{'LD_LIBRARY_PATH'} // '');

# Build command for vision CLI with image and prompt
my $binary = <llama-server-vision.binary>;
my $model_path = <llama-server-vision.vision_model_path>;
my $mmproj_path = <llama-server-vision.vision_mmproj_path>;

my @cmd = (
    $binary,
    '-m', $model_path,
    '--mmproj', $mmproj_path,
    '-ngl', 99,
    '-c', 2048,
    '-t', 4,
    '--image', $image_path,
    '-n', 50,
    '-p', $prompt
);

# Spawn vision CLI process and capture output
my ($wtr, $rdr, $err);
$err = gensym;

my $pid = eval { open3($wtr, $rdr, $err, @cmd) };

if ( !$pid || $@ ) {
    <[base.logs]>->( 0, "ERROR: Failed to spawn vision CLI: %s", $@ // 'unknown error' );
    # Pop the reply_id we pushed since we're not processing it
    pop @{<llama-server-vision.reply_ids>};
    return { 'mode' => 'false', 'data' => 'vision CLI spawn failed' };
}

close($wtr);  # We don't send any stdin

# Read output from vision model
my $output = '';
while ( my $line = <$rdr> ) {
    $output .= $line;
}

close($rdr);
waitpid($pid, 0);

# Trim whitespace
$output =~ s/^\s+|\s+$//g;

unless ( length $output ) {
    <[base.logs]>->( 0, "ERROR: No output from vision CLI" );
    pop @{<llama-server-vision.reply_ids>};
    return { 'mode' => 'false', 'data' => 'no response from vision model' };
}

<[base.logs]>->( 2, "[child-analyze] response: %s", $output );

# Send response back - the handler.server_output is not needed anymore,
# we send the response directly from this command
my $reply_id = pop @{<llama-server-vision.reply_ids>};

<[base.callback.cmd_reply]>->(
    $reply_id,
    {
        'mode' => 'true',
        'data' => $output
    }
);

return undef;  # Response already sent via callback

