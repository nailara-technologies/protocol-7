# name  = models.cmd.adapter-resolve
# descr = cmd: resolve a model name to its on-disk path

my ( $host, $model_name ) = split m|\s+|, $call->{'args'} // '', 2;
$host       //= 'invoke';
$model_name //= '';

my $out = "";

if ( $host eq 'invoke' ) {
    my $records = <[models.storage.adapter.invoke.discover]>;
    my ($rec) = grep { $_->{'name'} eq $model_name } @{ $records // [] };
    if ($rec) {
        my $path = <[models.storage.adapter.invoke.resolve]>->($rec);
        if ($path) {
            $out = "$path
";
        } else {
            <[base.logs]>->(
                0, "model not found on disk [ %s ]", $model_name
            );
        }
    } else {
        <[base.logs]>->( 0, "model not in db [ %s ]", $model_name );
    }
} elsif ( $host eq 'lmstudio' ) {
    my $records = <[models.storage.adapter.lmstudio.discover]>;
    my ($rec) = grep { $_->{'name'} eq $model_name } @{ $records // [] };
    if ($rec) {
        my $path = <[models.storage.adapter.lmstudio.resolve]>->($rec);
        $reply = "$path\n" if $path;
    } else {
        <[base.logs]>->( 0, "model not in lmstudio [ %s ]", $model_name );
    }
} else {
    <[base.logs]>->( 0, "unknown adapter [ %s ]", $host );
}

return { mode => qw| size |, data => $out };

