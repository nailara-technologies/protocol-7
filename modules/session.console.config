## [:< ##

# name  = session.console.config
# param = [key=value]
# descr = configure session startup behavior

my $param = shift;

unless ($param) {
    ## Show current configuration
    <[base.log]>->( 1, "Current session configuration:" );

    my @output;
    push @output, "::";
    push @output, ": Session Configuration";
    push @output, ":";
    push @output, sprintf(": %-30s = %s", "auto_check_deps", <session.cfg.auto_check_deps> ? '1 (enabled)' : '0 (disabled)');
    push @output, sprintf(": %-30s = %s", "auto_install_minimal", <session.cfg.auto_install_minimal> ? '1 (enabled)' : '0 (disabled)');
    push @output, sprintf(": %-30s = %s", "show_startup_zenka", <session.cfg.show_startup_zenka> ? '1 (enabled)' : '0 (disabled)');
    push @output, ":";
    push @output, ": Usage: session config <key>=<value>";
    push @output, ": Example: session config auto_check_deps=0";
    push @output, "::";

    return say join("\n", @output);
}

## Parse key=value
if ($param =~ m/^(\w+)=([01])$/) {
    my ($key, $value) = ($1, $2);

    my $cfg_key = "session.cfg.$key";

    ## Validate key
    unless ($key =~ m/^(auto_check_deps|auto_install_minimal|show_startup_zenka)$/) {
        <[base.log]>->( 0, "Unknown configuration key: $key" );
        return say "::\n: ✗ Unknown key: $key\n: Valid keys: auto_check_deps, auto_install_minimal, show_startup_zenka\n::";
    }

    ## Set value
    $data{'session'}{'cfg'}{$key} = $value;

    <[base.log]>->( 1, "Set $key = $value" );

    return say "::\n: ✓ Configuration updated\n: $key = $value\n::";
}

<[base.log]>->( 0, "Invalid format. Use: key=value" );
return say "::\n: ✗ Invalid format\n: Use: session config <key>=<value>\n::";

