## [:< ##

# name  = letsencr.child.cmd.renew-certificate
# param = <domain>
# descr = renew certificate for domain from Let's Encrypt

## $call is provided by compiled-in code header
my $domain = $call->{'args'};

return {
    'mode' => qw| false |,
    'data' => 'domain parameter required'
    }
    unless defined $domain && length($domain);

<[base.logs]>->( 2, 'child : renewing certificate for domain : %s', $domain );

## Get certificate info and retry attempt from parameters
my $cert_info     = $call->{'param'}{'cert_info'}     // {};
my $retry_attempt = $call->{'param'}{'retry_attempt'} // 0;
my $alt_names     = $call->{'param'}{'alt_names'}     // [];

if ($retry_attempt) {
    <[base.logs]>->( 2, ':. retry attempt : %d', $retry_attempt );
}

## Build domains list (primary + alt names)
my @domains = ($domain);
push @domains, @$alt_names if ref($alt_names) eq qw| ARRAY | && @$alt_names;

## Get admin email from config or parameters
my $email = $call->{'param'}{'email'} || <letsencr.admin.email>;

## Substitute :requested-domain: keyword with primary domain
$email = <[letsencr.child.substitute_admin_email]>->( $email, \@domains );

<[base.log]>->( 2, "  domains : " . join( ', ', @domains ) );
<[base.log]>->( 2, "  email : $email" );

## Call ACME new certificate workflow (renewal uses same process as new)
my $result = <[letsencr.child.acme_new]>->(
    {   domains => \@domains,
        email   => $email,
    },
    $call->{'reply_id'}    ## pass reply_id for async challenge coordination
);

unless ($result) {
    <[base.logs]>->( 1, 'acme_new returned undef' );
    return {
        'mode' => qw| false |,
        'data' => 'internal error : acme_new failed'
    };
}

## handle deferred status [ challenge coordination via parent ]
if ( $result->{status} eq qw| deferred | ) {
    <[base.logs]>->(
        2, 'renewal accepted, processing challenge asynchronously'
    );
    <[letsencr.child.continue_challenge_processing]>;    ## contacts httpd ##
    return { 'mode' => qw| deferred | };
}

## handle error result
if ( $result->{status} eq qw| error | ) {
    my $error = $result->{'error'}
        // 'unknown error during certificate renewal';
    <[base.logs]>->( 1, 'certificate renewal failed : %s', $error );
    return { 'mode' => qw| false |, 'data' => $error };
}

## expect success at this point
unless ( $result->{status} eq qw| success | ) {
    my $error = $result->{error} // 'unexpected status during renewal';
    <[base.logs]>
        ->( 1, 'certificate renewal unexpected result : %s', $error );
    return { 'mode' => qw| false |, 'data' => $error };
}

<[base.logs]>->( 2, 'certificate renewed successfully for %s', $domain );

## Create certificate bundle for parent
my $cert_bundle = {
    certificate => $result->{cert},
    key         => $result->{key},
    issued_at   => <[base.time]>->(3),
    expires_at  => $result->{valid_until},
    domain      => $domain,
    domains     => \@domains,
    cert_url    => $result->{cert_url},
    renewed     => TRUE,                     # Mark as renewal
    retry_count => $retry_attempt,
};

## Encode as JSON then base32r for transmission
my $bundle_json = JSON::XS::encode_json($cert_bundle);
my $bundle_b32r = encode_b32r($bundle_json);

<[base.log]>->( 2, "certificate bundle encoded [base32r]" );
<[base.logs]>->( 3, ':. bundle size : %d bytes', length($bundle_b32r) );

## Return certificate bundle to parent [ mode='size' for binary|encoded data ]
return {
    'mode' => qw| size |,
    'data' => $bundle_b32r
};

