## [:< ##

# name  = select.region.open_window
# descr = create and run an interactive region selection window instance

my $params   = shift // {};
my $id       = $params->{'id'};
my $geometry = $params->{'geometry'} // {};

if ( not defined $id or not exists $data{select}{region}{instances}{$id} ) {
    <[base.log]>
        ->( 0, '[region.open_window] missing or unknown instance id' );
    return undef;
}

my $inst = $data{select}{region}{instances}{$id};

$ENV{'DISPLAY'}     = <x11.display>;
$ENV{'GDK_BACKEND'} = 'x11';           ## force XWayland under WSL|Wayland ##
delete $ENV{'WAYLAND_DISPLAY'};

## cursor theme + size: under minimal xwayland|wsl no xsettings daemon     ##
## propagates a theme, so gdk [ even core-font Cursor->new type nicks ]    ##
## falls back to the giant unscaled core cursor. naming an installed theme ##
## and a sane pixel size makes both new_from_name and the core-font nicks  ##
## resolve to correctly-sized themed cursors. set before Gtk3->init so the ##
## xcursor library picks them up at display open. [ adwaita is the system  ##
## default-inherited theme and ships every resize glyph we request. ]      ##
$ENV{'XCURSOR_THEME'} //= 'Adwaita';
$ENV{'XCURSOR_SIZE'} = '24';    ## force a sane size over any huge default ##

<[base.perlmod.autoload]>->('Gtk3');
<[base.perlmod.autoload]>->('Cairo');
<[base.perlmod.autoload]>->('Glib');

## one-time global Gtk3 initialization [ idempotent in Gtk, cheap guard ] ##
Gtk3->init if not <select.region.gtk.inited>;
<select.region.gtk.inited> = TRUE;

## custom display font [ white-rabbit ] : try once, cache the face, fall  ##
## back to the cairo toy font api if anything in the load chain fails.    ##
if ( not exists <select.region.font.face> ) {
    <select.region.font.face> = undef;    ## mark attempted, default = none ##
    eval {
        <[base.perlmod.autoload]>->('Font::FreeType');
        <[base.perlmod.autoload]>->('Cairo::GObject');
        my $font_path
            = sprintf qw| %s/data/ttf/console/white-rabbit.flipped.ttf |,
            <system.root_path>;
        my $ft_face = Font::FreeType->new->face($font_path);
        <select.region.font.face> = Cairo::FtFontFace->create($ft_face);
    };
    if ( length $EVAL_ERROR ) {
        <[base.log]>->(
            2,
            '[region] white-rabbit font load failed, '
                . 'using default cairo font'
        );
    }
}

my $window = Gtk3::Window->new('toplevel');
$inst->{'window'} = $window;

$window->signal_connect(
    delete_event => sub {
        eval { <[select.region.cancel]>->($id) };
        if ( length $EVAL_ERROR ) {
            <[base.log]>->( 0, <[base.str.eval_error]>->(1) );
        }
        return TRUE;
    }
);

$window->set_decorated(0);
$window->set_keep_above(1);
$window->set_app_paintable(1);
$window->set_accept_focus(1);
$window->set_focus_on_map(1);

my $title;
if ( $inst->{'kind'} eq qw| window | ) {
    $title = 'select-region [window:' . ( $inst->{'caller'} // '' ) . ']';
} else {
    $title = 'select-region [screenshot'
        . ( defined $inst->{'tag'} ? ':' . $inst->{'tag'} : '' ) . ']';
}
$window->set_title($title);

## apply initial geometry ##
<[select.region.apply_geometry]>->( $id, $window, $geometry );

## RGBA visual ##
my $screen = $window->get_screen;
my $rgba   = $screen->get_rgba_visual();
$window->set_visual($rgba) if $rgba;

## event masks #####
## enter/leave masks are required so gtk primes its pointer-in-window  ##
## tracking from the crossing event; without them motion-notify is not ##
## dispatched until a button-press forces the association [ the 'must  ##
## click first' bug ].                                                 ##
$window->add_events(
    [   qw| button-press-mask button-release-mask pointer-motion-mask
            enter-notify-mask leave-notify-mask
            key-press-mask scroll-mask |
    ]
);

## connect signals, closing over this instance's $id ##
$window->signal_connect(
    draw => sub {
        eval { <[select.region.handler.draw]>->( $id, @ARG ) };
        if ( length $EVAL_ERROR ) {
            <[base.log]>->( 0, <[base.str.eval_error]>->(1) );
        }
        return TRUE;
    }
);

$window->signal_connect(
    'button-press-event' => sub {
        eval { <[select.region.handler.button_press]>->( $id, @ARG ) };
        if ( length $EVAL_ERROR ) {
            <[base.log]>->( 0, <[base.str.eval_error]>->(1) );
        }
        return TRUE;
    }
);

$window->signal_connect(
    'button-release-event' => sub {
        eval { <[select.region.handler.button_release]>->( $id, @ARG ) };
        if ( length $EVAL_ERROR ) {
            <[base.log]>->( 0, <[base.str.eval_error]>->(1) );
        }
        return TRUE;
    }
);

$window->signal_connect(
    'motion-notify-event' => sub {
        eval { <[select.region.handler.motion]>->( $id, @ARG ) };
        if ( length $EVAL_ERROR ) {
            <[base.log]>->( 0, <[base.str.eval_error]>->(1) );
        }
        return TRUE;
    }
);

## crossing handler: primes gtk pointer tracking and gives immediate  ##
## hover-cursor feedback on entry, so resize regions work before any  ##
## click. delegates to the non-drag branch of the motion handler.     ##
$window->signal_connect(
    'enter-notify-event' => sub {
        eval { <[select.region.handler.motion]>->( $id, @ARG ) };
        if ( length $EVAL_ERROR ) {
            <[base.log]>->( 0, <[base.str.eval_error]>->(1) );
        }
        return FALSE;
    }
);

$window->signal_connect(
    'key-press-event' => sub {
        my $ret = eval { <[select.region.handler.key_press]>->( $id, @ARG ) };
        if ( length $EVAL_ERROR ) {
            <[base.log]>->( 0, <[base.str.eval_error]>->(1) );
        }
        return defined $ret ? $ret : TRUE;
    }
);

$window->signal_connect(
    'scroll-event' => sub {
        eval { <[select.region.handler.scroll]>->( $id, @ARG ) };
        if ( length $EVAL_ERROR ) {
            <[base.log]>->( 0, <[base.str.eval_error]>->(1) );
        }
        return TRUE;
    }
);

## map-time focus + raise: calling grab_focus / set_keep_above right after  ##
## show_all races the actual map under wslg/xwayland - show_all returning   ##
## does not mean the window is mapped and focusable yet, so an early grab   ##
## is silently dropped and the WM treats the user's first click as a mere   ##
## click-to-focus [ the 'first drag only focuses' bug ]. defer to the map   ##
## signal so we grab once the X server has actually mapped the surface, and ##
## use present to both raise and take input focus the gtk-recommended way.  ##
my $mapped_once = 0;
$window->signal_connect(
    qw| map | => sub {
        return FALSE if $mapped_once++;
        eval {
            $window->set_keep_above(1);    ## reassert stay-on-top post-map ##
            $window->present;              ## raise + take input focus      ##
            $window->grab_focus;           ## widget keyboard focus         ##
        };
        <[base.log]>->( 0, ': map focus failed: ' . $EVAL_ERROR )
            if length $EVAL_ERROR;
        return FALSE;
    }
);

$window->show_all;

## poll-based hover fallback: under wslg/xwayland gtk crossing/motion       ##
## events for this undecorated rgba keep-above window can be lost until a   ##
## button-press forces pointer association [ the 'must click first' bug ].  ##
## a 20fps timer queries the pointer directly and drives the hover cursor   ##
## while not dragging, mirroring ticker.handler.check_pointer; while a drag ##
## is active it drives the drag geometry too, so the first drag works even  ##
## before motion-notify delivery primes [ see handler.poll_pointer ].       ##
$inst->{'poll'}{'timer'} = <[event.add_timer]>->(
    {   after    => 0,
        interval => 0.05,
        repeat   => TRUE,
        handler  => qw| select.region.handler.poll_pointer |,
        data     => $id,
    }
);

<[base.logs]>->( 1, '[region.open_window] id=%s window shown', $id );

## run the shared Gtk3 main loop only once; further instances open while   ##
## the loop is already pumping [ Glib::Event integrates Event watchers ].   ##
if ( not <select.region.gtk.main_running> ) {
    <select.region.gtk.main_running> = TRUE;
    <[base.log]>->( 1, '[region.open_window] entering Gtk3 main loop' );
    Gtk3->main;
    <[base.log]>->( 1, '[region.open_window] left Gtk3 main loop' );
}

0;

