## [:< ##

# name  = web-browser.subscribe-screen-change
# descr = initialized callback — subscribe web-browser to X-11 screen-change STRM events

<[base.log]>
    ->( 1, 'subscribing web-browser to X-11 screen-change events .,' );

<[base.zenki.resolve_primary_sid]>->(
    'X-11',
    sub {
        my $sid = shift;
        return if not defined $sid;
        <[protocol-7.route-send]>->(
            {   'command' => "$sid.subscribe-screen-change",
                'reply'   => {
                    'handler' =>
                        qw| web-browser.handler.screen-change_strm_open |,
                }
            }
        );
    }
);

return TRUE;

