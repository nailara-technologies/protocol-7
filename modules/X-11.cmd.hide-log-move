## [:< ##

# name  = X-11.cmd.hide-log-move
# descr = disable verbose logging for move-window

return { 'mode' => qw| false |, 'data' => 'already disabled.' }
    if not <X-11.log-cfg.verbose.move-window> //= FALSE;

<X-11.log-cfg.verbose.move-window> = FALSE;

<[base.log]>->( 1, ":: verbose 'move-window' logging disabled. ::" );

return {
    'mode' => qw| true |,
    'data' => 'verbose move-window loggin disabled'
    }

