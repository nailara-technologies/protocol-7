## [:< ##

# name  = job-site-scan.cmd.clear-tasks
# descr = reset all task tracking state (keeps job store intact)

<job-site-scan.tasks>         = {};
<job-site-scan.cycle>         = 'idle';
<job-site-scan.pending_count> = 0;
<job-site-scan.assess_queue>  = [];
<job-site-scan.rewire_queue>  = [];

<[job-site-scan.state.persist]>;

<[base.logs]>->( 1, 'task state cleared' );

return { 'mode' => 'true', 'data' => 'task state cleared' };

