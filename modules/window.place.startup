## [:< ##

# name  = window.place.startup
# descr = post-connect startup: acquire session id, then resolve window
#         geometry asynchronously [ window-place is itself the 'tile'
#         zenka, so its own geometry request routes back to itself --
#         it must not block here, or it can never service that request ]

<[base.get_session_id]>;

<[base.X-11.get_geo_async]>->(qw| window.place.startup.geo_ready |);

return 0;

