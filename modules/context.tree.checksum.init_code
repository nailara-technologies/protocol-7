## [:< ##

# name  = context.tree.checksum.init_code
# descr = initialize resumable checksum infrastructure for context tree

## check for required modules ##
<[base.perlmod.load]>->('Digest::BMW');

## load AMOS7::CHKSUM with state extension ##
eval { require AMOS7::CHKSUM };
if ($@) {
    <[base.logs]>->(
        0, ':. context.tree.checksum: AMOS7::CHKSUM load failed [ %s ] :.',
        $@
    );
    return FALSE;
}

## initialize context tree checksum state storage ##
<context.tree.checksum.states>  //= {};
<context.tree.checksum.streams> //= {};
<context.tree.checksum.index>   //= {};

## configuration ##
<context.tree.checksum.cfg> //= {
    'chunk_size'     => 4096,    ## bytes per chunk checksum
    'max_state_age'  => 3600,    ## seconds to keep idle states
    'index_levels'   => 2,       ## directory depth for index
    'diff_threshold' => 0.5,     ## store diff if < 50% size
    'elf_mode'       => 7,       ## default ELF mode
    'elf_shift'      => 13,      ## default ELF shift
};

## storage path [ created by coding.init_code via check-zenka-paths ] ##
my $tree_root = sprintf '%s/%s/context-tree',
    <system.path.zenka-dirs.var_P7>, <system.zenka.name>;

<[base.logs]>->(
    2, ':. context.tree.checksum: initialized [ root=%s ]', $tree_root
);

return TRUE;

