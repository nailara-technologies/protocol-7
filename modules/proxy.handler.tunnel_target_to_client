# name  = proxy.handler.tunnel_target_to_client
# descr = relay data from tunnel target to proxy client

my $client_id = shift->w->data;
my $client    = $data{'proxy'}{'clients'}{$client_id};
return if not defined $client;

my $chunk = '';
my $bytes = <[base.s_read]>->( $client->{'target_sock'}, \$chunk, 65536 );

if ( ( $bytes // -1 ) <= 0 ) {
    <[proxy.client.close]>->($client_id);
    return;
}

my $written = <[base.s_write]>->( $client->{'sock'}, \$chunk );
if ( $written < 0 ) {
    <[proxy.client.close]>->($client_id);
}

return;

