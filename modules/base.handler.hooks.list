## [:< ##

# name  = base.handler.hooks.list
# descr = List all hooks for a session

## list all hooks for a session  Args: session_id  Returns: hash of hook_type
## => [handlers]

my ($sid) = @ARG;
return undef unless defined $sid;
return undef unless defined $data{'session'}{$sid};

return $data{'session'}{$sid}{'hooks'} // {};

