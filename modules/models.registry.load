## [:< ##

# name = models.registry.load
# descr = Load registry from disk or return empty registry

use JSON::PP;
use Fcntl qw| :flock |;

# Initialize registry path in $data{} for persistence
$data{registry_path} ||= '/var/protocol-7/models/registry.json';

sub load_registry {
  my $path = $data{registry_path};
  if (-f $path) {
    open my $fh, '<', $path or goto EMPTY;
    flock($fh, 1);  # LOCK_SH
    my $content = do { local $/; <$fh> };
    flock($fh, 8);  # LOCK_UN
    close $fh;

    my $loaded = decode_json($content) if $content;
    return $loaded if $loaded && ref($loaded) eq 'HASH';
  }

  EMPTY:
  return <[models.registry.empty]>->{'create_empty_registry'}->();
}

# Return registry interface
{
  'load_registry' => \&load_registry,
};

