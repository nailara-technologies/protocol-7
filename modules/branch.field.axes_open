## [:< ##

# name  = branch.field.axes_open
# descr = list all axes with remaining capacity
# param = id
#
# returns arrayref of axis names, sorted
# returns undef if branch not found

my ($id) = @ARG;

return undef
    if not defined $id
    or not exists $data{'branch.field'}{$id};

my $axes = $data{'branch.field'}{$id}{'axes'} // {};

my @open = sort
    grep {
    ( $axes->{$ARG}{'boundary'} // 0 ) > ( $axes->{$ARG}{'position'} // 0 )
    } keys %$axes;

return \@open;

