## [:< ##

# name  = index.cube.format.dir_offset
# descr = compute directory file offset for ring D entry R

my ( $depth, $rank ) = @ARG;

my $base   = <index.cube.header>->{'dir_base'}[$depth]   // return undef;
my $stride = <index.cube.header>->{'dir_stride'}[$depth] // return undef;

return $base + $rank * $stride;

