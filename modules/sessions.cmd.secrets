## [:< ##

# name  = sessions.cmd.secrets
# descr = list currently-held named secrets [ pid/state/alive ]

my $secrets = <sessions.secrets> // {};
my @names   = sort keys %$secrets;

return { 'mode' => qw| size |, 'data' => "no secrets held\n" } if not @names;

my @lines;
foreach my $name (@names) {
    my $entry = $secrets->{$name};
    my $pid   = $entry->{'pid'};
    my $alive = defined $pid ? <[base.exists.sub-process]>->($pid) : FALSE;
    push @lines,
        sprintf(
        "%s: pid=%s state=%s alive=%s",
        $name,
        $pid // 'none',
        $entry->{'state'} // '?',
        $alive ? 'yes' : 'no'
        );
}

return { 'mode' => qw| size |, 'data' => join( "\n", @lines ) . "\n" };

