# name  = pager.util.filter.item_to_number
# descr = Convert item to numeric representation

my ($item) = @ARG;

if ( $item->{'checksum'} ) {

    # Use checksum as number
    return hex( substr( $item->{'checksum'}, 0, 16 ) );
} elsif ( $item->{'path'} ) {

    # Hash path to number
    my $hash = <[chk-sum.bmw.L13-str]>->( $item->{'path'} );
    return hex( substr( $hash, 0, 16 ) );
} else {

    # Use all fields
    my $data = join( '', sort map { $item->{$ARG} // '' } keys %$item );
    my $hash = <[chk-sum.bmw.L13-str]>->($data);
    return hex( substr( $hash, 0, 16 ) );
}

