# name  = debian.parent.callback.check_package_installed
# descr = Check if a debian package is installed via dpkg-query

my $package = shift;

## Use dpkg-query to check if package is installed
my $output
    = qx(dpkg-query -W -f='\${Status} \${Version}' $package 2>/dev/null);

if ( $output && $output =~ /^install ok installed (.+)$/ ) {
    return $1;    ## Return version
}

return undef;

