# name  = debian.parent.callback.check_package_installed
# descr = check if a debian package is installed via AptPkg::Cache

my $package = shift;

<[base.perlmod.load]>->('AptPkg::Cache')
    if not <[base.perlmod.loaded]>->('AptPkg::Cache');

<debian.apt_cache> //= AptPkg::Cache->new;

my $p = <debian.apt_cache>->{$package};

if ( defined $p && $p->{CurrentState} eq 'Installed' ) {
    my $cur = $p->{CurrentVer};
    return $cur ? $cur->{VerStr} : '(installed)';
}

return undef;

