## [:< ##

# name = httpd.http_post
# descr = handle HTTP POST requests - routes to appropriate handlers (ACME, file upload, etc.)

my $id      = shift;
my $session = $data{'session'}->{$id};

my $request  = $session->{'http'}->{'request'};
my $response = $session->{'response'};
my $headers  = $request->{'headers'};
my $http_uri = $request->{'uri'};

## Log POST request at level 1 for visibility
<[base.logs]>->( 1, '[%d] handling POST: %s', $id, $http_uri );

## Detailed POST logging
<[base.logs]>->(
    2,   '[%d] POST request: %s (content-length: %s)',
    $id, $http_uri, $headers->{'content-length'} // 'unknown'
);

## Check Content-Length to prevent massive uploads
my $content_length = $headers->{'content-length'} // 0;
my $max_post_size  = <httpd.cfg.max_post_size>
    // ( 1024 * 1024 );    ## 1MB default

if ( $content_length > $max_post_size ) {
    <[base.logs]>->(
        1,   '[%d] POST body too large: %d bytes (max: %d)',
        $id, $content_length, $max_post_size
    );
    return <[httpd.send_error_page]>->( $id, 413 );    ## Payload Too Large
}

## For ACME endpoints, wait for complete body before processing
if (   $http_uri =~ m|^/api/certificate|
    || $http_uri =~ m|^/\.well-known/acme-challenge| ) {

    ## Check if we have the complete body in the input buffer
    my $current_body   = $session->{'buffer'}->{'input'} // '';
    my $bytes_received = length($current_body);

    <[base.logs]>->(
        2,   '[%d] ACME POST body check: %d bytes received (expected: %d)',
        $id, $bytes_received, $content_length
    );

    ## If body is incomplete, replace input_buffer watcher with body accumulator
    if ( $bytes_received < $content_length ) {

        ## Store request context for accumulator
        $session->{'http'}->{'acme_request_uri'}    = $http_uri;
        $session->{'http'}->{'acme_content_length'} = $content_length;

        ## Back up the current watcher so we can restore it later
        $session->{'http'}->{'original_input_watcher'}
            = $session->{'watcher'}->{'input_buffer'};

        ## Stop the current input_buffer watcher
        if ( defined $session->{'watcher'}->{'input_buffer'} ) {
            $session->{'watcher'}->{'input_buffer'}->stop;
        }

        ## Create body remainder watcher on the same buffer
        $session->{'watcher'}->{'input_buffer'} = <[event.add_var]>->(
            {   'var'     => \$session->{'buffer'}->{'input'},
                'handler' => qw| httpd.handler.input.body_remainder |,
                'poll'    => qw| w |,
                'repeat'  => TRUE,
                'data'    => $id,
                'desc'    => sprintf( '[%d] body accumulator watcher', $id )
            }
        );

        <[base.logs]>->(
            2, '[%d] replaced input_buffer watcher with body accumulator', $id
        );

        ## Trigger the new watcher to process existing buffer content
        $session->{'watcher'}->{'input_buffer'}->now;

        ## Return 1: more data needed
        return 1;
    }

    ## Body is complete - store it and process
    $session->{'http'}->{'body'}    = $current_body;
    $session->{'buffer'}->{'input'} = '';

    <[base.logs]>->(
        2,   '[%d] ACME POST body complete: %d bytes',
        $id, length($current_body)
    );

    ## Route based on URI path
    if ( $http_uri =~ m|^/\.well-known/acme-challenge| ) {
        return <[httpd.handler.acme_request]>->( $id, $http_uri );
    } elsif ( $http_uri =~ m|^/api/certificate/request| ) {
        return <[httpd.handler.acme_request]>->( $id, $http_uri );
    } elsif ( $http_uri =~ m|^/api/certificate/status| ) {
        return <[httpd.handler.acme_request]>->( $id, $http_uri );
    } elsif ( $http_uri =~ m|^/api/certificate/list| ) {
        return <[httpd.handler.acme_request]>->( $id, $http_uri );
    }
} elsif ( $http_uri eq qw| /cursor | ) {

    ## visualization cursor update — selX/Y/Z from browser ##
    return <[plugin.web.space.handler.cursor_update]>->($id);

} elsif ( $http_uri eq qw| /context | ) {

    ## visualization context update — zoom + intent from browser ##
    my $body = $session->{'buffer'}->{'input'} // '';
    $session->{'buffer'}->{'input'} = '';
    <[protocol-7.route-send]>->(
        {   qw| command |   => qw| web.context |,
            qw| call_args | => { qw| args | => $body },
        }
    );
    ## force close — body may arrive after headers in separate chunk,
    ## keeping alive would bleed body bytes into next request parse ##
    $session->{'http'}->{'close'} = 1;
    my $reply_body   = qw| {} |;
    my $reply_header = {
        qw| Content-Type   | => qw| application/json |,
        qw| Content-Length | => length($reply_body),
        qw| Connection     | => qw| close |,
    };
    $session->{'buffer'}->{'output'}
        .= <[httpd.new_header]>->( 200, $reply_header );
    $session->{'buffer'}->{'output'} .= $reply_body;
    return 2;

} else {
    ## Unsupported POST endpoint
    <[base.logs]>->( 1, '[%d] POST not supported for: %s', $id, $http_uri );
    return <[httpd.send_error_page]>->( $id, 405 );    ## Method Not Allowed
}

return 2;    ## Should not reach here

