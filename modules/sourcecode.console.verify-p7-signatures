## [:< ##

# name  = sourcecode.console.verify-p7-signatures
# descr = verify source code signature sections

my $command_params = shift // '';

my $verify_verbosity = 2;           ## [ 0 | 1 | 2 ] ##
my $verify_mode      = 'strict';    ## [ 'strict', 'repair' ] ##

$verify_verbosity = 0
    if $command_params =~ s| *:verify-silent: *| |
    or exists $ENV{'VERIFY_SILENT'}
    and <[base.cfg_bool]>->( $ENV{'VERIFY_SILENT'} ) == TRUE;

# Parse repair mode flag from command
if ( $command_params =~ s| *:repair-mode: *| |i ) {
    $verify_mode = 'repair';
    <[base.log]>->(
        1, ': running in repair mode (will not fail on fixable issues)'
    );
}

$command_params =~ s,^ *| *$,,;

my $signature_key_name = qw| proto-7.sourcecode |;

### needs passphrase for implicit secret key loading ###
##
## <[source.load_signature_key]>->($signature_key_name);

### LOADING PUBLIC KEY FROM DATA BLOCK IN bin/Protocol-7 ##
## [ - silent - no passphrase required. ]
##
<[crypt.C25519.load_from_string]>->(
    $signature_key_name, <[protocol-7.source-key]>
);
###

# For verification, we only need the public key
if (   not exists $keys{'C25519'}{$signature_key_name}
    or not exists $keys{'C25519'}{$signature_key_name}->{'public'} ) {
    <[base.logs]>->(
        0, "source signature public key '%s' not loaded, aborting..,",
        $signature_key_name
    );
    <[base.exit]>->(qw| 0110 |);
}

my $source_version  = <protocol-7.src-ver>;
my $release_version = <protocol-7.rel-ver>;

my $paths     = <sourcecode.path>;    # <-- prepared in 'sourcecode.init_code'
my $work_tree = $paths->{'work_tree'};

my @source_paths;

if ( length $command_params ) {
    if ( not @source_paths
        = <[base.source.collect_file_list]>->($command_params) ) {
        <[base.logs]>->( 0, ": no files found for '%s'", $command_params );
        <[base.exit]>;
    } else {
        my $file_count = scalar @source_paths;
        <[base.logs]>->(
            ": %d file%s match%s '%s'",
            $file_count,
            <[base.cnt_s]>->($file_count),
            <[base.cnt_s]>->( $file_count, '', 'es' ),
            <[base.parser.ellipse_center]>->( $command_params, 19 )
        );
    }
} else {
    @source_paths = <[sourcecode.source_path_set_up]>;
}

if (   @source_paths == 0
    or @source_paths == 1 and not defined $source_paths[0] ) {
    <[base.log]>->(
        0, 'no matching source files, cannot verify signatures..,'
    );
    <[base.exit]>->('0110');
}

<[base.log]>->( 1, '.:[ VERIFYING SOURCE SIGNATURES ]:.' );

my $valid_count   = 0;
my $invalid_count = 0;
my $repair_needed_count
    = 0;    # Count files that need repair but could still verify
my $file_count = scalar @source_paths;

<[base.logs]>->( '* verifying %s source file signatures..,', $file_count );

foreach my $path_rel (@source_paths) {
    my $path_abs = catfile( $work_tree, $path_rel );
    <[base.log]>->( 2, qw| : | );

    # Read file and extract signature data
    <[file.slurp]>->( $path_abs, \my $src_str, qw| :raw | );
    my $footer_data = <[source.extract_sig_body]>
        ->( \$src_str, qw| strip |, $verify_mode );

    <[base.logs]>->( 2, ':::[ %s ]:.', $path_rel );

    # Check if signature exists
    if ( not $footer_data->{'was-present'} ) {
        <[base.logs]>->(
            0,
            ':E: no signature present :: %s',
            <[base.parser.ellipse_center]>->( $path_rel, 44 )
        );
        $invalid_count++;
        next;
    }

    # Check signature structure
    if ( not $footer_data->{'structure-was-valid'} ) {
        my $footer_error = $footer_data->{'encountered-error'};
        <[base.logs]>->(
            0,
            ':E: invalid signature structure :: %s',
            <[base.parser.ellipse_center]>->( $path_rel, 44 )
        );
        $invalid_count++;
        next;
    }

    # Check if signature has missing separator endline
    if ( $footer_data->{'needs_separator_endline'} ) {
        <[base.log]>->( 1, ':E: missing separator endline before signature' );

        if ( $verify_mode eq 'strict' ) {
            $invalid_count++;
            next;
        } else {
            <[base.log]>->( 1, ': continuing in repair mode' );

            # Track files that need repair but allow verification to continue
            $repair_needed_count++;
        }
    }

    # Verify signature using source.signature_valid
    my ( $is_valid, $report_ref ) = <[source.signature_valid]>->(
        \$src_str, $footer_data, {}, $signature_key_name,
        $verify_mode    ##{}<--TRUTH_CHECKS.
    );

    # Track if the file was repaired
    my $was_repaired
        = ( $report_ref && $report_ref->{'repaired'} ) ? TRUE : FALSE;
    my $was_reconstructed
        = ( $report_ref && $report_ref->{'reconstructed'} ) ? TRUE : FALSE;
    my $repaired_state
        = ( $was_repaired && $report_ref->{'repaired-with-state'} )
        ? $report_ref->{'repaired-with-state'}
        : 5;

   # If the signature was repaired, update the file with the corrected content
    if ( ( $was_repaired || $was_reconstructed ) && $verify_mode eq 'repair' )
    {
   # The content has already been modified in memory by source.signature_valid
   # Write it back to the file
        <[base.logs]>->(
            2,
            ': writing %s file: %s',
            $was_reconstructed ? 'reconstructed' : 'repaired', $path_abs
        );
        <[file.put_bin]>->( $path_abs, \$src_str );
        $footer_data->{'repaired'}
            = TRUE;    # Mark as repaired in the footer data
        $footer_data->{'reconstructed'} = TRUE if $was_reconstructed;
    }

    if ($is_valid) {
        $valid_count++;

        # If it was repaired or reconstructed, show special message
        if ( $was_repaired || $was_reconstructed ) {
            <[base.logs]>->(
                1,
                ':+: valid (%s%s) :: %s',
                $was_reconstructed ? 'reconstructed' : 'repaired',
                $was_repaired && !$was_reconstructed
                ? " with state $repaired_state"
                : '',
                <[base.parser.ellipse_center]>->( $path_rel, 28 )
            );

            # Decrement repair needed count since it's now valid
            $repair_needed_count-- if $repair_needed_count > 0;
        } else {
            <[base.logs]>->(
                1,
                ':+: valid :: %s',
                <[base.parser.ellipse_center]>->( $path_rel, 37 )
            );
        }

        # Display valid signature counter in verbose mode
        printf "%s  <VALID>  %s%s%05d%s\r", $colors{'p7_fg_0004'},
            $colors{'p7_fg_0003'},
            $colors{'B01'}, $valid_count, $colors{'reset'}
            if <system.verbosity.console> == 1;
    } else {
        <[base.log]>->( 0, qw| : | ) if $invalid_count == 0;
        $invalid_count++;
        <[base.logs]>->(
            0,
            ':E: signature validation failed :: %s',
            <[base.parser.ellipse_center]>->( $path_rel, 44 )
        );

        # Provide detailed error report in higher verbosity
        if ( $verify_verbosity > 1 && defined $report_ref ) {
            <[base.log]>->( 2, ': : signature verification details:' );
            foreach my $type ( <[base.sort]>->($report_ref) ) {
                if ( not length ref $report_ref->{$type} ) {
                    <[base.logs]>->(
                        2,     ': :. %30s : %s',
                        $type, $report_ref->{$type} ? 'true' : 'false'
                    );
                } else {
                    foreach
                        my $mode ( <[base.sort]>->( $report_ref->{$type} ) ) {
                        <[base.logs]>->(
                            2,
                            ': :. %30s [%s] : %s',
                            $type,
                            $mode,
                            $report_ref->{$type}->{$mode} ? 'true' : 'false'
                        );
                    }
                }
            }
        }
    }

    # Allow for SIGINT
    <[event.once]>;
}

# Final summary
<[base.log]>->( 0, qw| : | ) if $invalid_count;

# Count repaired and reconstructed files - we don't need to re-read files as we already track this
my $repaired_count      = 0;
my $reconstructed_count = 0;
foreach my $path_rel (@source_paths) {
    my $path_abs = catfile( $work_tree, $path_rel );
    <[file.slurp]>->( $path_abs, \my $src_str, qw| :raw | );
    my $footer_data = <[source.extract_sig_body]>
        ->( \$src_str, qw| strip |, $verify_mode );
    $repaired_count++
        if $footer_data->{'repaired'} && !$footer_data->{'reconstructed'};
    $reconstructed_count++ if $footer_data->{'reconstructed'};
}

if ( $verify_mode eq 'repair' ) {
    if ( $repaired_count > 0 || $reconstructed_count > 0 ) {
        <[base.logs]>->(
            1,
            ':.: %d valid (%d repaired, %d reconstructed), %d invalid, %d need repair [total: %d]',
            $valid_count,
            $repaired_count,
            $reconstructed_count,
            $invalid_count,
            $repair_needed_count,
            $file_count
        );
    } elsif ( $repair_needed_count > 0 ) {
        <[base.logs]>->(
            1, ':.: %d valid, %d invalid, %d need repair [total: %d]',
            $valid_count, $invalid_count, $repair_needed_count, $file_count
        );
    } else {
        <[base.logs]>->(
            1, ':.: %d valid, %d invalid signatures [total: %d]',
            $valid_count, $invalid_count, $file_count
        );
    }
} else {
    <[base.logs]>->(
        1, ':. %d files .: signed valid : %d, re-sign : %d',
        $file_count, $valid_count, $invalid_count
    );
}
<[base.log]>->( 1, $invalid_count == 0 ? ':.  .    .     .' : qw| . | );

# Exit with count of invalid signatures (0 = success)
<[base.exit]>->( sprintf( '%04d', $invalid_count ) );

