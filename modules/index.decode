## [:< ##

# name = index.decode
# descr = return token for a numerical address

my $addr = shift // $ARG;

return ''    if defined $addr and $addr == -1;    ## -1 is the root '' ##
return undef if not defined $addr;

my $packed = <index.packed_rank>->{0} // '';
my $token  = substr( $packed, $addr, 1 );

return length($token) ? $token : undef;

