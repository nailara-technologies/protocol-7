## [:< ##

# name  = window.place.handler.draw
# descr = draw translucent placement frame with readout

my ( $widget, $context ) = @ARG;

my $w = <x11.window.width>  // 320;
my $h = <x11.window.height> // 240;

## clear ##
$context->set_operator('source');

## translucent deep blue fill ##
$context->set_source_rgba( 0.0, 0.0, 0.24, 0.72 );
$context->paint;

$context->set_operator('over');

## cyan corner brackets ##
## [ arm = 16, matches $corner hit-region in button_press ] ##
my $arm = 16;
$context->set_source_rgba( 0.0, 1.0, 1.0, 0.9 );
$context->set_line_width(2);

## top-left ##
$context->move_to( 0, 0 );
$context->line_to( $arm, 0 );
$context->move_to( 0, 0 );
$context->line_to( 0, $arm );

## top-right ##
$context->move_to( $w, 0 );
$context->line_to( $w - $arm, 0 );
$context->move_to( $w, 0 );
$context->line_to( $w, $arm );

## bottom-left ##
$context->move_to( 0, $h );
$context->line_to( $arm, $h );
$context->move_to( 0, $h );
$context->line_to( 0, $h - $arm );

## bottom-right ##
$context->move_to( $w, $h );
$context->line_to( $w - $arm, $h );
$context->move_to( $w, $h );
$context->line_to( $w, $h - $arm );

$context->stroke;

## readout + instructions, bottom-right aligned ##
my $x = <x11.coordinates.left> // 0;
my $y = <x11.coordinates.top>  // 0;

my $margin = 12;

my $readout = sprintf 'x=%d y=%d w=%d h=%d', $x, $y, $w, $h;
my $line2   = 'drag/arrows/wheel move, edges/Ctrl resize, Shift=fine 1px';
my $line3   = 'default 10px, dbl-click/Enter=commit, Esc=cancel';

$context->set_source_rgba( 0.0, 1.0, 1.0, 0.95 );

## stack bottom-up, ~4px gap ##
my @lines = ( [ $line3, 12 ], [ $line2, 12 ], [ $readout, 16 ], );

my $baseline = $h - $margin;
for my $line (@lines) {
    my ( $text, $size ) = @{$line};
    $context->set_font_size($size);
    my $extents = $context->text_extents($text);
    my $tw      = $extents->{'width'};
    $context->move_to( $w - $margin - $tw, $baseline );
    $context->show_text($text);
    $baseline -= $size + 4;
}

return TRUE;

