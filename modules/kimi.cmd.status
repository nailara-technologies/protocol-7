## [:< ##

# name  = kimi.cmd.status
# descr = show kimi zenka status and task queue overview

my $queue_stats = <[kimi.task.queue_status}>;

my @lines;
push @lines, sprintf( 'websocket : %s', <kimi.ws.status> // 'unknown' );
push @lines, sprintf( 'connected : %s', <kimi.ws.connected> ? 'yes' : 'no' );
push @lines,
    sprintf( 'session   : %s',
    <kimi.session.acquired> ? 'acquired' : 'pending' );

if ( ref $queue_stats eq qw| HASH | and $queue_stats->{'success'} ) {
    push @lines, '';
    push @lines,
        sprintf(
        'tasks     : %d total  [ %d pending | %d active | %d completed | %d failed ]',
        $queue_stats->{'total_tasks'} // 0,
        $queue_stats->{'pending'}     // 0,
        $queue_stats->{'in_progress'} // 0,
        $queue_stats->{'completed'}   // 0,
        $queue_stats->{'failed'}      // 0,
        );
    push @lines,
        sprintf( 'updated   : %s',
        $queue_stats->{'queue_updated'} // 'never' );
}

if ( defined <kimi.task.active_id> ) {
    push @lines, '';
    push @lines, sprintf( 'active task : %s', <kimi.task.active_id> );
}

my $pending_approvals = <kimi.approval.pending> // {};
my $n_approvals       = scalar keys %$pending_approvals;
if ($n_approvals) {
    push @lines, '';
    push @lines, sprintf( 'pending approvals : %d', $n_approvals );
}

return {
    'mode' => qw| size |,
    'data' => join( "\n", @lines ) . "\n"
};

