## [:< ##

# name  = job-site-scan.cmd.status
# descr = show current cycle state and job counts

my $tasks = <job-site-scan.tasks> // {};

my %counts;
for my $id ( keys %{$tasks} ) {
    my $stage = $tasks->{$id}{'stage'} // 'unknown';
    $counts{$stage}++;
}

my $last = <job-site-scan.last_scan> // 0;
my $age  = $last ? sprintf( '%ds ago', time - $last ) : 'never';

my @lines;
push @lines, sprintf 'cycle:      %s', <job-site-scan.cycle> // 'idle';
push @lines, sprintf 'last scan:  %s', $age;
push @lines, sprintf 'jobs total: %d', scalar keys %{$tasks};
for my $stage (
    qw| queued assessing assessed review approved rejected failed |) {
    push @lines, sprintf '  %-12s %d', $stage, $counts{$stage} // 0
        if $counts{$stage};
}
push @lines, sprintf 'threshold:  %s', <job-site-scan.cfg.threshold> // 6;

<[base.protocol-7.command.cmd_reply]>
    ->( { 'mode' => TRUE, 'data' => join( "\n", @lines ) } );

