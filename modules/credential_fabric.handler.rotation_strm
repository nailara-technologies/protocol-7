## [:< ##

# name  = credential_fabric.handler.rotation_strm
# descr = push STRM notification to all subscribers when a credential rotates.
#         args: $slot, $reason

my $slot   = shift // '';
my $reason = shift // '';

return undef unless length $slot;

my $subs = <credential_fabric.rotation_subscribers>->{$slot};
return undef if not defined $subs or not @$subs;

my $ntime = <[base.time]>->(3);

foreach my $handler (@$subs) {
    ## dispatch STRM-style notification via protocol-7 route-send ##
    <[protocol-7.route-send]>->(
        {   'command'   => $handler,
            'call_args' => {
                'args' => YAML::XS::Dump(
                    {   'event'  => 'credential.rotated',
                        'slot'   => $slot,
                        'ntime'  => $ntime,
                        'reason' => $reason,
                    }
                )
            },
        }
    );
}

return scalar @$subs;

