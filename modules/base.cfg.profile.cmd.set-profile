## [:< ##

# name  = base.cfg.profile.cmd.set-profile
# descr = switch to a named UI control profile

my $profile_name = $call->{'args'} // '';

$profile_name =~ s|^\s+||;
$profile_name =~ s|\s+$||;

return { 'mode' => qw| false |, 'data' => 'no profile name supplied' }
    if not length $profile_name;

my @known_profiles = <[base.cfg.profile.list]>->();

return {
    'mode' => qw| false |,
    'data' => sprintf( "unknown profile '%s'", $profile_name )
    }
    if not grep { $ARG eq $profile_name } @known_profiles;

<[base.cfg.profile.apply]>->($profile_name);

return {
    'mode' => qw| true |,
    'data' => sprintf( 'profile set: %s', $profile_name )
};

