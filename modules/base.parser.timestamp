## [:< ##

# name  = base.parser.timestamp
# descr = returns diffenent time-stamp strings for specified unix-\current time
# note  = ntime values are also accepted [ length >= 13 ]

my @result;
my $mode = shift // qw| time-stamp |;    # [time|time-stamp|date]
my $time = shift // <[base.time]>;

if ( $mode =~ m|^(\d+)(\.\d+)?$| ) { $time = $1 and $mode = qw| time-stamp | }

$time = <[base.n2u_time]>->($time)
    if length( int($time) ) >= 13;       ##  <-- network time ?  ##

my ( $sec, $min, $hour, $mday, $mon, $year, $wday, $yday ) = localtime($time);

$year = sprintf( '%02d', $year + 1900 );
$mon  = sprintf( '%02d', $mon + 1 );
$mday = sprintf( '%02d', $mday );

push( @result, join qw| - |, $year, $mon, $mday )
    if $mode eq qw| time-stamp | or $mode eq qw| date |;

push( @result, sprintf( qw| %02d:%02d:%02d |, $hour, $min, $sec ) )
    if $mode eq qw| time-stamp | or $mode eq qw| time |;

return join ' ', @result;

