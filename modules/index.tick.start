## [:< ##

# name  = index.tick.start
# descr = register idle job-tick watcher if not already active

## cancel ondemand timeout while jobs are running ##
if ( defined <base.timer.ondemand_timeout>
    and <base.timer.ondemand_timeout>->is_active ) {
    <base.timer.ondemand_timeout>->cancel;
}

return if defined <index.tick.idle_watcher>;

<index.tick.idle_watcher> = <[event.add_idle]>->(
    {   'handler' => 'index.callback.tick',
        'repeat'  => TRUE,
        'desc'    => 'index job dispatcher',
    }
);

