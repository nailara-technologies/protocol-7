## [:< ##

# name  = user-edit.excursion.key_create
# descr = blocking terminal excursion : create one new named C25519 key
# param = -none-

## runs OUTSIDE the event loop, between term_restore and term_init [ called
## from user-edit.check_pending_excursions only ].  prompts for a key name,
## then calls keys.console.create -- whose REAL, existing passphrase prompt is
## used unmodified, per task scope.
##
## THE #1 RISK, and why the guards below exist : keys.console.create calls
## <[base.exit]> on EVERY guard failure -- empty name, invalid keyname, key
## already exists, missing Crypt::Mode::CBC, short/empty password, generation
## or write failure -- and base.exit's last line is CORE::exit, ending the
## WHOLE user-edit process, not just the excursion.  'keys' is normally a
## disposable standalone console zenka where dying like that is harmless ;
## user-edit loads its modules directly into this long-lived one.  so every
## guard that can be checked BEFORE the call is checked HERE, and
## keys.console.create is only called once none of them can fire inside it.
##
## RESIDUAL RISK, documented per task, not silently shipped : the password is
## read INSIDE keys.console.create [ AMOS7::TERM::read_password_repeated ], so
## its 'password empty / too short / aborted' guard [ and the generation /
## write failure guards ] cannot be pre-empted without either modifying
## keys.console.create or reimplementing it -- both explicitly out of scope.
## an empty/one-char passphrase or an aborted password prompt therefore STILL
## ends this zenka.  the four checks below cover everything that can be known
## before the password prompt runs.

my $set_result = sub {
    my ( $text, $class ) = @ARG;
    <user-edit.key_actions.last_result> = $text;
    <[user-edit.message]>->( $text, $class );
    return FALSE;
};

## no tty : read_password_repeated's no-tty fallback either blocks on a
## detached STDIN or returns undef -- and undef is exactly what sends
## keys.console.create into base.exit.  decline before either can happen.
## handler.key already gates on this ; checked again here because this module
## is the last point where declining is still safe
if ( not -t STDIN ) {
    return $set_result->(
        'key create needs a real terminal, nothing created',
        qw| no-op |
    );
}

my $name = <[base.term.ask]>->(
    {   qw| question | => q| new key name [ empty : cancel ] |,
        qw| type |     => qw| text |,
    }
);
$name //= '';

## guard 1 : non-empty [ keys.console.create base.exits on this ] ##
return $set_result->( 'no key name entered, nothing created', qw| no-op | )
    if not length $name;

## guard 2 : valid keyname [ validate_keyname applies the anchored key-name ##
## regex plus the stricter character-sequence rules, subsuming              ##
## keys.console.create's own later unanchored regex check too ]             ##
return $set_result->(
    sprintf( q|%s is not a valid key name, nothing created|, $name ),
    qw| fail |
) if not <[crypt.C25519.validate_keyname]>->($name);

## guard 3 : key must NOT already exist [ a virtual key's sentinel return ##
## of 4 is truthy and correctly also counts as 'exists', matching         ##
## keys.console.create's own check exactly ]                              ##
return $set_result->(
    sprintf( q|key '%s' already exists, nothing created|, $name ),
    qw| fail |
) if <[crypt.C25519.key_exists]>->($name);

## guard 4 : mirrored exactly from keys.console.create's own check ##
return $set_result->(
    q|missing Crypt::Mode::CBC module, nothing created|,
    qw| fail |
) if not defined &Crypt::Mode::CBC::new;

## from here on keys.console.create can only die on the residual guards named
## in this module's header -- everything checkable beforehand passed above
my $created = <[keys.console.create]>->($name);

if ($created) {

    ## the on-disk key list just changed, and user_keys' own field_def/buffer
    ## were built ONCE at schema time [ see user-edit.form.
    ## build_user_keys_field's own header : "on-disk key list is not going to
    ## move mid-session" was true until THIS excursion made it false ].
    ## without this refresh the new key is real [ verified via keys list,
    ## keys.console.create's own job ] but invisible in the form until a full
    ## reload -- read live as "did it even create anything," not as success.
    ##
    ## mutate the EXISTING field_def hashref in place [ found by name in the
    ## live schema array, same grep-by-name pattern plugin.user-edit.
    ## key-details.render already uses ] rather than replacing the array
    ## element -- build_frame/render_form hold their own reference to this
    ## same hashref, so an in-place overwrite is what they see on next repaint
    my $editor_state = <user-edit.form.state>;
    if ( ref $editor_state eq qw| HASH | ) {
        my ($user_keys_def)
            = grep { ( $ARG->{'name'} // '' ) eq qw| user_keys | }
            ( $editor_state->{'schema'}{'fields'} // [] )->@*;
        if ( ref $user_keys_def eq qw| HASH | ) {
            my $fresh_def = <[user-edit.form.build_user_keys_field]>;
            %$user_keys_def = %$fresh_def;

            ## the RUNTIME BUFFER is a separate copy of 'default', taken once
            ## at editor.control.create time -- rewriting the field_def alone
            ## does not touch it [ same "schema+buffers together, not schema
            ## alone" trap editor.control.list.expand's own history already
            ## hit ].  editor.buffer.memory.load refuses on a readonly buffer
            ## [ its own guard ], so a fresh buffer is built and swapped in
            ## wholesale instead -- editor.buffer.memory.create has no such
            ## guard, it is the same call editor.control.create itself used to
            ## build this buffer the first time
            $editor_state->{'fields'}{'user_keys'}
                = <[editor.buffer.memory.create]>->($fresh_def);
        }
    }

    $set_result->( sprintf( q|created key '%s'|, $name ), qw| ok | );
    return TRUE;
}

return $set_result->( sprintf( q|key '%s' was not created|, $name ),
    qw| fail | );

