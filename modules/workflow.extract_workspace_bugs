# name  = workflow.extract_workspace_bugs
# descr = extract bugs from workspace-transfer BUGS.md files

my @bugs;
my $repos = <[workflow.scan_workspace_repos]>;

foreach my $repo (@$repos) {
    my $bug_file = "$repo->{path}/BUGS.md";
    next unless -f $bug_file;

    open my $fh, '<', $bug_file or next;
    while (<$fh>) {
        if (/^- \[ \].*\[BUG-(\d+)\]\*?\*?(.*)/) {
            my $bug_id = $1;
            my $desc   = $2;
            $desc =~ s|^\s+||;

            push @bugs,
                {
                bug_id   => $bug_id,
                title    => $desc,
                priority => 'high',
                category => 'bug',
                status   => 'open',
                repo     => $repo->{name},
                path     => $bug_file,
                source   => 'workspace-transfer-bug'
                };
        }
    }
    close $fh;
}

return \@bugs;

