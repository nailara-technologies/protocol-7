## [:< ##

# name  = debian.parent.callback.register_binary_dependency
# descr = register a zenka binary dependency

my $binary = shift;
my $zenka  = shift;

## Ensure registries are initialized
$data{'debian'}{'binaries'}{'registry'} //= {};
$data{'debian'}{'binaries'}{'by_name'}  //= {};

## Ensure list is initialized if not already
unless ( exists $data{'_list_meta'}{'binary-dependencies'} ) {
    <[base.list.init]>->(
        {   'name'         => qw| binary-dependencies |,
            'key_ref'      => \$data{'debian'}{'binaries'}{'registry'},
            'max_elements' => 512
        }
    );
}

## Check if already registered
my $binary_id = $data{'debian'}{'binaries'}{'by_name'}->{$binary};

if ( defined $binary_id ) {
    ## Update zenki list
    my $reg = $data{'debian'}{'binaries'}{'registry'}{$binary_id};
    push @{ $reg->{zenki_list} }, $zenka
        unless grep { $_ eq $zenka } @{ $reg->{zenki_list} || [] };
    return $binary_id;
}

## Add to registry
$binary_id = <[base.list.element.add]>->(
    {   'key_ref' => \$data{'debian'}{'binaries'}{'registry'},
        'val_ref' => \{
            binary      => $binary,
            status      => qw| unknown |,
            found_path  => undef,
            zenki_list  => [$zenka]
        }
    }
);

if ( defined $binary_id ) {
    $data{'debian'}{'binaries'}{'by_name'}->{$binary} = $binary_id;
}

return $binary_id;

