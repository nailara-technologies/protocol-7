## [:< ##

# name  = models.chat.expand_refs.format_file
# descr = format full file content for inline expansion
# param = $path    - file path label
# param = $content - file content string
# return = formatted string with header/footer markers

my ( $path, $content ) = @ARG;

return $content if $content =~ m{^\[ERROR:};

return sprintf( "\n=== FILE: %s ===\n%s\n=== END: %s ===\n",
    $path, $content, $path );

0;

