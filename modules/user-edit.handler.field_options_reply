## [:< ##

# name  = user-edit.handler.field_options_reply
# descr = attach the add-a-field row once options are known

## PROGRESSIVE ENHANCEMENT : the form is rendered and usable before this
## arrives.  the optional-field vocabulary lives with the users zenka, so it
## costs a round trip, and blocking the form on it would trade a visible delay
## for a row that is only occasionally used.
##
## an empty reply would mean the authority declares no optional fields at all
## ; a record that already carries every one of them still gets the full
## vocabulary here, and simply has nothing left to offer once
## user-edit.form.addable_fields has filtered it -- add_field_row then
## declines on its own.

my ($info) = @ARG;

my $cmd = uc( $info->{'cmd'} // '' );

return FALSE if $cmd ne qw| SIZE |;

## '<name> <shape>' per line, shape 'list' or 'line' -- see
## users.cmd.field-options.  a line without a shape is not tolerated silently
## : it would mean an old zenka is answering, and assuming 'line' there is
## what used to store a list-shaped field as a scalar
my %vocabulary;
foreach my $line ( split m|\n|, ( $info->{'data'} // '' ) ) {
    next if not length $line;
    my ( $name, $shape ) = split m|\s+|, $line;
    next if not defined $name or not length $name;
    ## compared, not matched : an alternation inside m|..| would end the
    ## pattern at its own '|'
    if ( not defined $shape
        or ( $shape ne qw| list | and $shape ne qw| line | ) ) {
        <[base.logs]>->(
            1, ': field-options gave no shape for [ %s ] -- ignored', $name
        );
        next;
    }
    $vocabulary{$name} = $shape;
}

return FALSE if not keys %vocabulary;

## REMEMBER them : the row cannot always be added at the moment the answer
## arrives -- a form whose first field is a list opens EXPANDED, and the row
## must not be attached to a transient expanded schema [ collapse rebuilds
## from the schema captured at expand time and would drop it ].  so the
## vocabulary is stored and the row is re-applied after every collapse, by
## user-edit.form.sync_list_mode
##
## the WHOLE vocabulary is kept, not the addable part of it : which fields may
## be REMOVED is the same question read the other way round, and
## user-edit.form.addable_fields makes the split on demand
<user-edit.form.field_options> = \%vocabulary;

my $editor_state = <user-edit.form.state>;

return FALSE if ref $editor_state ne qw| HASH |;

## the ROW only ever goes onto a plain form : never over a menu, and never
## while a list is expanded [ its rows are transient and collapse would drop
## it ] -- but the FRAME is rebuilt either way.  build_frame reserves this
## row's width whether or not the row is there yet, and the reservation is
## only possible once the vocabulary is known, so rebuilding here is what
## makes the width settle the moment the answer lands instead of at whatever
## later collapse happens to rebuild next
my $attached = ( $editor_state->{'mode'} // qw| insert | ) eq qw| insert |
    && <[user-edit.form.add_field_row]>->(
    $editor_state, <[user-edit.form.addable_fields]>->($editor_state)
    );

<[user-edit.form.build_frame]>->(
    $editor_state,
    <user-edit.form.frame_name> // qw| user-edit-form |,
    $editor_state->{'title'} // <user-edit.form.title>
);

<user-edit.form.dirty>++;

return $attached ? TRUE : FALSE;

