## [:< ##

# name  = workflow.console.bug-list
# descr = aggregate bugs with Protocol-7 styled console output

## Protocol-7 color scheme ##
my $reset      = "\e[0m";
my $nailara_bg = "\e[48;2;9;5;42m";
my $blacklight = "\e[38;2;68;39;172m";
my $TRUE_blue  = "\e[38;2;6;71;195m";
my $neon_orange = "\e[38;2;197;141;7m";
my $neon_green = "\e[38;2;71;195;6m";
my $neon_red   = "\e[38;2;195;6;71m";

my $bugs = workflow::aggregate_bugs();

say "";
say "$blacklight" . "=" x 70 . "$reset";
say "$blacklight .:[ ${neon_red}BUG AGGREGATION${blacklight} ]:.$reset";
say "$blacklight" . "=" x 70 . "$reset";
say "";

# Group by repo
my %by_repo;
foreach my $bug (@$bugs) {
    my $repo = $bug->{repo} || 'unknown';
    push @{$by_repo{$repo}}, $bug;
}

if (keys %by_repo == 0) {
    say "  ${neon_green}✓ No open bugs found!$reset";
    say "";
} else {
    # Display bugs by repo
    foreach my $repo (sort keys %by_repo) {
        my $items = $by_repo{$repo};

        say "${TRUE_blue}🐛 Repository: ${neon_orange}$repo$reset ${blacklight}(${\scalar @$items} bugs)$reset";
        say "";

        foreach my $bug (@$items) {
            # Status indicator
            my $status_icon = $bug->{status} =~ /fixed/i ? "${neon_green}✓$reset" :
                             $bug->{status} =~ /open/i ? "${neon_red}●$reset" :
                             "${TRUE_blue}?$reset";

            say sprintf "  %s ${neon_red}[BUG-%s]$reset %s",
                $status_icon, $bug->{bug_id}, $bug->{title};

            # Additional info
            say sprintf "     ${blacklight}→ Priority:$reset ${neon_orange}%s$reset", $bug->{priority};
            say sprintf "     ${blacklight}→ Status:$reset %s", $bug->{status};
            say "";
        }

        say "$blacklight" . "-" x 70 . "$reset";
        say "";
    }
}

say "$blacklight" . "=" x 70 . "$reset";
say sprintf "$neon_red●$reset ${TRUE_blue}Total:$reset ${neon_red}%d bugs tracked$reset", scalar @$bugs;
say "$blacklight" . "=" x 70 . "$reset";
say "";

