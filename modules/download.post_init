## [:< ##

# name  = download.post_init
# descr = checking if init_code behaved correctly

if ( not defined <download.obj.ua> ) {

    <[base.exit]>->( qw| 0110 |, 'initialization was not successful.,', 0 );

} else {
    return FALSE;
}

