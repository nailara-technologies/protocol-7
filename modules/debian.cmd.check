## [:< ##

# name  = debian.cmd.check
# descr = check installation status of dependencies
# param = [zenka=<name>]

my $param        = shift;
my $zenka_filter = $param->{'args'};

## Run check
my $result = <[debian.parent.check_installed]>;

if ( !$result->{success} ) {
    return {
        'mode' => qw| false |,
        'data' => $result->{error} || 'check failed'
    };
}

## Format output
my @output;

push @output, "Dependency Check Results:";
push @output, "";
push @output,
    sprintf(
    "Debian Packages: %d installed, %d missing",
    $result->{installed_pkgs},
    $result->{missing_pkgs}
    );
push @output,
    sprintf(
    "CPAN Modules: %d checked, %d missing",
    $result->{checked_modules},
    $result->{missing_modules}
    );
push @output, "";

if ($zenka_filter) {
    ## Show specific zenka status
    my $zenka_id = $data{'debian'}{'zenki_deps'}{'by_zenka'}{$zenka_filter};

    if ( !$zenka_id ) {
        return {
            'mode' => qw| false |,
            'data' => "zenka '$zenka_filter' not found"
        };
    }

    my $zenka = $data{'debian'}{'zenki_deps'}{'registry'}{$zenka_id};

    push @output, "Zenka: $zenka_filter";
    push @output, sprintf(
        "  PM deps: %d (%d missing)",
        $zenka->{pm_deps_count},
        scalar(
            grep {
                my $mod_id = $data{'debian'}{'cpan_modules'}{'by_name'}{$_};
                $mod_id
                    && $data{'debian'}{'cpan_modules'}{'registry'}{$mod_id}
                    {status} eq 'missing'
            } @{ $zenka->{pm_deps} || [] }
        )
    );
    push @output, sprintf(
        "  OS deps: %d (%d missing)",
        $zenka->{os_deps_count},
        scalar(
            grep {
                my $pkg_id = $data{'debian'}{'packages'}{'by_name'}{$_};
                $pkg_id
                    && $data{'debian'}{'packages'}{'registry'}{$pkg_id}
                    {status} eq 'missing'
            } @{ $zenka->{os_deps} || [] }
        )
    );
    push @output, "  Status: " . $zenka->{status};

} else {
    ## Show overall statistics
    push @output, "Statistics:";
    push @output,
        sprintf( "  Zenki scanned: %d",
        $data{'debian'}{'stats'}{zenki_scanned} );
    push @output,
        sprintf( "  Total PM deps: %d",
        $data{'debian'}{'stats'}{total_pm_deps} );
    push @output,
        sprintf( "  Total OS deps: %d",
        $data{'debian'}{'stats'}{total_os_deps} );
    push @output,
        sprintf( "  Missing deps: %d",
        $data{'debian'}{'stats'}{missing_deps} );
}

return {
    'mode' => qw| size |,
    'data' => "\n" . join( "\n", @output ) . "\n"
};

