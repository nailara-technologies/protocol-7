## [:< ##

# name  = iteration.finish
# descr = summarize all attempts — highlight best, list unfixed issues

my $task_id = shift // return 'no task_id';

my $state = <iteration.state>->{$task_id};
return 'no iteration state found' unless defined $state;

## find which attempt had the best score ##
my $best_attempt_n = 1;
foreach my $attempt ( @{ $state->{'attempts'} // [] } ) {
    $best_attempt_n = $attempt->{'attempt_n'}
        if ( $attempt->{'score'} // 0 ) >= $state->{'best_score'};
}

## collect unfixed issues from final attempt ##
my $final   = $state->{'attempts'}[-1] // {};
my @unfixed = grep { ( $ARG->{'status'} // '' ) ne 'pass' }
    @{ $final->{'issues'} // [] };

my $unfixed_str
    = @unfixed
    ? join ', ', map { $ARG->{'criterion'} } @unfixed
    : 'none';

my $summary = sprintf(
    "iteration complete: %d attempt%s, best score=%.2f (attempt %d)\nunfixed issues: %s",
    $state->{'attempt_n'},
    $state->{'attempt_n'} == 1 ? '' : 's',
    $state->{'best_score'},
    $best_attempt_n, $unfixed_str,
);

<[base.logs]>->( 1, 'iteration.finish: %s', $task_id );

return $summary;

