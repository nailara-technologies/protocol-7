## [:< ##

# name  = index.callback.feed-dir
# descr = idle watcher callback — process one file per idle tick

my $watcher = shift->w;
my $job_id  = $watcher->data;
my $job     = <index.jobs>->{$job_id};

if ( not defined $job ) {
    $watcher->cancel if $watcher->is_active;
    return;
}

my $file = shift @{ $job->{'files'} };

if ( not defined $file ) {
    $watcher->cancel if $watcher->is_active;
    delete <index.jobs>->{$job_id};
    my $total = $job->{'total'};
    <[base.log]>->( 1, "index feed-dir complete [ $total files ]" );
    <[base.callback.cmd_reply]>->(
        $job->{'reply_id'}, { 'mode' => 'size', 'data' => "fed $total files" }
    );
    return;
}

my $ok = <[index.feed.file]>->($file);
<[base.log]>->( 1, "index feed skipped [ $file ]" ) if not $ok;
$job->{'done'}++;

