## [:< ##

# name  = letsencr.parent.handler_renewal_check
# descr = periodically check which certificates need renewal and queue them

my $timer_data = shift;

<[base.logs]>->( 2, 'renewal check timer fired' );

my $now = time();
<letsencr.stats.last_renewal_check> = $now;

## step 1: renew known expired/expiring certs immediately (no httpd needed)
my $check_result = <[letsencr.parent.check_certificate_expiration]>
    ->(<letsencr.parent.certs>);

if ( $check_result && ref($check_result) eq qw| HASH | ) {
    my @needs_renewal = @{ $check_result->{'needs_renewal'} // [] };
    my @expiring_soon = @{ $check_result->{'expiring_soon'} // [] };

    if ( @expiring_soon > 0 ) {
        <[base.logs]>->(
            1, ': warning : %d certificates expiring soon',
            scalar(@expiring_soon)
        );
    }

    if ( @needs_renewal > 0 ) {
        <[base.logs]>->(
            2, 'queuing renewal for %d known certificates',
            scalar(@needs_renewal)
        );
        <[letsencr.parent.queue_renewal_requests]>->( \@needs_renewal );
    }
}

## step 2: async vhost query to discover new domains (opportunistic)
my $num_clients = <[protocol-7.route-send]>->(
    {   'command'   => qw| httpd.vhost-list |,
        'call_args' => { 'args' => '' },
        'reply'     => {
            'handler' => qw| letsencr.parent.handler_renewal_continue |,
            'params'  => {}
        }
    }
);

if ( !defined $num_clients || $num_clients == 0 ) {
    <[base.logs]>->(
        2, 'httpd not available — skipping new domain discovery'
    );
}

return TRUE;

