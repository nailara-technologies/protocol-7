## [:< ##

# name  = letsencr.parent.handler_renewal_check
# descr = periodically check which certificates need renewal and queue them

my $timer_data = shift;

<[base.logs]>->( 2, 'renewal check timer fired - sending async vhost query' );

my $now = time();
<letsencr.stats.last_renewal_check> = $now;

## phase 2 workflow: async vhost query + renewal check continuation
## step 1: send async query to HTTPd for vhost list
## when reply arrives, handler will continue with steps 2-5

my $num_clients = <[base.protocol-7.command.send.local]>->(
    {   'command'   => qw| cube.httpd.vhost-list |,
        'call_args' => { 'args' => '' },
        'reply'     => {
            'handler' => qw| letsencr.parent.handler_renewal_continue |,
            'params'  => {}
        }
    }
);

if ( !defined $num_clients || $num_clients == 0 ) {
    <[base.logs]>->(
        1,
        'httpd vhost query failed: %s',
        'permission denied or httpd not running'
    );
    return FALSE;
}

<[base.log]>->(
    3, 'vhost query sent async, handler will continue renewal check'
);

return TRUE;

