## [:< ##

# name  = credentials.init_code
# descr = initialize credentials zenka state, load crypto modules,
#         set up storage paths and session tracking

my $reinit              = shift // TRUE;
my $already_initialized = $reinit;
my $first_init          = $already_initialized ? FALSE : TRUE;

## load crypto modules ##
map { <[base.perlmod.load]>->($ARG) }
    qw| AMOS7::13 AMOS7::Twofish AMOS7::TERM |;
map { <[base.perlmod.autoload]>->($ARG) } qw| YAML::XS |;

## configure defaults ##
<credentials.cfg.store_dir>
    //= catdir( <system.path.zenka-dirs.var_P7>, <system.zenka.name> );
<credentials.cfg.session_ttl> //= 3600;
<credentials.cfg.audit_log>   //= catfile( <system.path.zenka-dirs.var_P7>,
    <system.zenka.name>, 'audit.log' );
<credentials.cfg.nonce_size>     //= 16;
<credentials.size.archive_block> //= 13312;    ## 13 K archive block size ##

## ensure storage directory exists ##
my $store_dir = <credentials.cfg.store_dir>;
if ( not -d $store_dir ) {
    eval {
        require File::Path;
        File::Path::make_path( $store_dir, { mode => 0700 } );
    };
    if ($@) {
        <[base.logs]>->(
            0,          'credentials: cannot create store dir %s: %s',
            $store_dir, $@
        );
    }
}

## set restrictive permissions on store dir ##
if ( -d $store_dir ) {
    chmod 0700, $store_dir;
}

## in-memory session token store ##
<credentials.session> //= {};

## session cleanup timer ##
if ( not $already_initialized ) {
    <credentials.timer.session_cleanup> = <[event.add_timer]>->(
        {   'after'    => 300,
            'interval' => 300,
            'repeat'   => TRUE,
            'handler'  => qw| credentials.handler.session_cleanup |,
            'desc'     => 'purge expired session tokens'
        }
    );
}

return 0;

