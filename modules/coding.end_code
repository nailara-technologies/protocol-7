## [:< ##

# name  = coding.end_code
# descr = zenka shutdown cleanup : kill inference server process groups

my $servers = <coding.inference_servers> // {};

for my $backend ( keys %{$servers} ) {
    my $pid = $servers->{$backend}{'pid'} // 0;
    next unless $pid && kill( 0, $pid );

    ## kill the full process group (parent + forked workers) ##
    kill( 'KILL', -$pid );
    <[base.logs]>->(
        1,        "end_code: killed %s server group [pid:%d]",
        $backend, $pid
    );
}

