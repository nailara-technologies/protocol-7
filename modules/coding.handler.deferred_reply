# name  = coding.handler.deferred_reply
# descr = send deferred reply for completed coding task
#         Called directly from coding.event.on_task_complete

my $deferred_id = shift;

my $deferred = $data{"coding"}{"deferred_replies"}->{$deferred_id};
return unless defined $deferred;

my $task_id  = $deferred->{'task_id'};
my $reply_id = $deferred->{'reply_id'};
my $task     = <coding.task.queue>->{$task_id};

<[base.logs]>->(
    1, 'deferred_reply: task=%s reply_id=%s task_found=%s',
    $task_id,
    $reply_id // 'undef',
    defined $task ? 'yes' : 'no'
);

unless ( defined $task ) {
    <[base.callback.cmd_reply]>->(
        $reply_id, { 'mode' => 'false', 'data' => 'task not found' }
    );
    delete $data{"coding"}{"deferred_replies"}->{$deferred_id};
    return;
}

my $status = $task->{'execution'}->{'status'};
<[base.logs]>->( 1, 'deferred_reply: status=%s', $status // 'undef' );

if ( $status eq 'completed' ) {
    my $result = $task->{'execution'}->{'result'} // '';

    # Determine reply mode
    my $stripped = $result;
    $stripped =~ s/\n$//;
    my $newlines = ( $stripped =~ tr/\n// );

    my ( $reply_mode, $final_data );
    if ( $newlines == 0 ) {
        $final_data = $result;
        $final_data =~ s/\n$//;
        $final_data = '[ no reply message ]' unless length $final_data;
        $reply_mode = 'true';
    } else {
        $final_data = $result;
        $final_data .= "\n" if $final_data !~ /\n$/;
        $reply_mode = 'size';
    }

    <[base.callback.cmd_reply]>->(
        $deferred->{'reply_id'},
        { 'mode' => $reply_mode, 'data' => $final_data }
    );

    $deferred->{'status'} = 'complete';
    delete $data{"coding"}{"deferred_replies"}->{$deferred_id};

} elsif ( $status eq 'failed' || $status eq 'error' ) {
    my $error = $task->{'execution'}->{'error'} // 'task failed';
    <[base.callback.cmd_reply]>->(
        $deferred->{'reply_id'},
        { 'mode' => 'false', 'data' => $error }
    );
    $deferred->{'status'} = 'error';
    delete $data{"coding"}{"deferred_replies"}->{$deferred_id};
}

