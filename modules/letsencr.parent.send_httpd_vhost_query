## [:< ##

# name  = letsencr.parent.send_httpd_vhost_query
# descr = Send async request to httpd zenka for vhost list

<[base.log]>->( 2, "querying httpd zenka for vhost list [ async ].." );

## Send async command to httpd via cube with reply handler
<[base.protocol-7.command.send.local]>->(
    {   'command'   => qw| cube.httpd.vhost-list |,
        'call_args' => { 'args' => '' },
        'reply'     =>
            { 'handler' => qw| letsencr.parent.handler_httpd_vhost_reply |, }
    }
);

<[base.log]>->( 3, "vhost query sent to httpd, handler registered" );

return 1;

