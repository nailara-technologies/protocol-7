# name  = coding.parser.dependency_chain

my $object_id = shift;

return qw| -- | if not exists <dependency.chain>->{$object_id};

return join ' ',
    map { <dependency.object>->{$ARG}->{'type'} }
    <dependency.chain>->{$object_id}->@*;

