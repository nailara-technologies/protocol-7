## [:< ##

# name  = coding.event.on_task_complete
# descr = event callback handler for task completion
# purpose = Triggered when a task completes successfully

my ( $task_id, $result ) = @ARG;

my $save_after_secs = <coding.buffer-timeouts.save> // 4200;
my $drop_after_secs = <coding.buffer-timeouts.drop> // 5700;

<[base.logs]>->(
    1,
    "[on-task-complete] CALLED for %s result_len=%d",
    $task_id // 'undef',
    length( $result // '' )
);

unless ( defined $task_id && length $task_id ) {
    <[base.logs]>->( 0, "[on-task-complete] task_id required" );
    return TRUE;
}

# Find the meta job tracking this task (for complete-analysis)
my $meta_job;
my $meta_id;

foreach my $mid ( keys %{ <coding.complete_analysis_jobs> // {} } ) {
    my $mj = <coding.complete_analysis_jobs>->{$mid};
    if ( defined $mj && $mj->{'task_id'} eq $task_id ) {
        $meta_job = $mj;
        $meta_id  = $mid;
        last;
    }
}

# If this is part of a complete-analysis chain, check for resumption
if ( defined $meta_job ) {
    <[base.logs]>->(
        1,        "[on-task-complete] task completed : %s [meta=%s]",
        $task_id, $meta_id
    );

    # Get task result from coding.task.queue
    my $queue_task  = <coding.task.queue>->{$task_id};
    my $task_result = $queue_task->{'execution'}->{'result'} // '';

    if ( defined $task_result && length $task_result ) {

        # Store the result in accumulated and trigger completion detection
        $meta_job->{'accumulated'} = $task_result;

        <[base.logs]>->(
            1,
            "[on-task-complete] result stored, "
                . "triggering completion detection"
        );

  # Setting this to TRUE triggers the variable watcher which checks completion
        $meta_job->{'continue_analysis'} = TRUE;
    }
}

# Check for deferred replies waiting on this task
my $deferred_replies = $data{"coding"}{"deferred_replies"} // {};
foreach my $deferred_id ( keys %$deferred_replies ) {
    my $deferred = $deferred_replies->{$deferred_id};
    if ( defined $deferred && $deferred->{'task_id'} eq $task_id ) {
        <[base.logs]>->(
            2, "[on-task-complete] triggering deferred reply %s",
            $deferred_id
        );
        <[coding.handler.deferred_reply]>->($deferred_id);
        last;
    }
}

## register task in completed_ids for buffer save/drop timers ##
<coding.task.completed_ids> //= {};
<coding.task.completed_ids>->{$task_id} = <[base.time]>->(3);

## (re)start 47m save timer ##
if ( defined <coding.timer.task_buffer_save>
    && <coding.timer.task_buffer_save>->is_active ) {
    <coding.timer.task_buffer_save>->cancel;
}
<coding.timer.task_buffer_save> = <[event.add_timer]>->(
    {   'after'   => 2820,
        'handler' => qw| coding.handler.task_buffer_save |,
    }
);

## (re)start 63m drop timer ##
if ( defined <coding.timer.task_buffer_drop>
    && <coding.timer.task_buffer_drop>->is_active ) {
    <coding.timer.task_buffer_drop>->cancel;
}
<coding.timer.task_buffer_drop> = <[event.add_timer]>->(
    {   'after'   => 3780,
        'handler' => qw| coding.handler.task_buffer_drop |,
    }
);

<[base.logs]>->(
    1, "[on-task-complete] buffer save|drop timers set [ 47m | 63m ]"
);

return TRUE;

