## [:< ##

# name  = branch.group.list
# descr = list all reference groups with member count and sample
# param = none or { pattern }  [ substring match on group name ]
#
# returns arrayref sorted by count descending

my $params  = shift                                        // {};
my $pattern = ref $params eq 'HASH' ? $params->{'pattern'} // '' : '';

my $groups = $data{'branch.groups'} // {};
my @result;

for my $group_name ( keys %$groups ) {
    ## pattern filter ##
    if ( length $pattern ) {
        next if index( $group_name, $pattern ) < 0;
    }

    my $members = $groups->{$group_name}{'members'} // [];
    my $count   = scalar @$members;

    push @result,
        {
        'name'   => $group_name,
        'count'  => $count,
        'sample' => [ @$members[ 0 .. ( $count > 3 ? 2 : $count - 1 ) ] ]
        };
}

## sort by count descending ##
@result = sort { $b->{'count'} <=> $a->{'count'} } @result;

<[base.logs]>->( 2, 'branch.group.list: %d groups', scalar @result );

return { 'mode' => 'true', 'data' => \@result };

