## [:< ##

# name  = httpsd.request_capture.collect
# descr = on startup, collect any surviving /dev/shm crash-capture file
#         and route to named log buffer + delete
#         [ called from httpsd.post_init before socket creation ]
#         [ always collects regardless of httpsd.cfg.request_capture state ]

my $path = <httpsd.path.request_capture> //= qw|/dev/shm/httpsd-last-request|;
return if not -f $path;    ## skipping when no capture file is present ##

## skip on reload : file is from normal operation, not a crash ##
return if <system.zenka.initialized>;

my $log_level    = 0;                             ## custom buffer level ##
my $buffer_name  = qw| httpsd-crash-log |;
my $content      = <[file.slurp]>->($path)->$*;
my $collected_at = <[base.ntime.b32]>->(3);

## initializing buffer ondemand ##
$data{'buffer'}{$buffer_name}{'max_size'} //= 64 * 1024;
$data{'buffer'}{$buffer_name}{'data'}     //= [];
$data{'buffer'}{$buffer_name}{'size'}     //= 0;

### log to disk when configured ##
if ( <[base.cfg_bool]>->( <httpsd.cfg.request_capture_send> // TRUE ) ) {
    $data{'buffer'}{$buffer_name}{'log_cmd'} //= qw| p7-log.append |;
}

unlink $path
    or <[base.logs]>->(
    0,     ': request_capture : unlink %s failed [ %s ]',
    $path, <[base.str.os_err]>
    );

my $r_msg = sprintf ':[ crash capture | restarted at %s ]:', $collected_at;
<[base.log]>->( 1, $r_msg );    ## [ httpsd 'zenka' log buffer ] ##

## format for p7-log.append [ <ntime_b32> <level> <text> ] ##
my $log_prefix = join ' ', $collected_at, $log_level;
my $end_msg    = '[ end of crash capture ]';

## write and send captured pre-crash request to custom log-buffer and file ##
for my $line ( $r_msg, split( "\n", $content ), $end_msg ) {
    next unless length $line; ## skip empty lines [ not valid for log_cmd ] ##
    <[base.buffer.add_line]>->( $buffer_name, join ' :', $log_prefix, $line );
}

