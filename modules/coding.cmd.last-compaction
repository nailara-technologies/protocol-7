# name  = coding.cmd.last-compaction
# descr = show last context compaction report
# param = [none]

my $last_compaction_str = <[coding.last-compaction]> // '';

return { 'mode' => qw| false |, 'data' => 'no compaction data found' }
    if not length $last_compaction_str;

return { 'mode' => qw| size |, 'data' => $last_compaction_str }

