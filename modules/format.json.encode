## [:< ##

# name  = format.json.encode
# descr = encode perl data structure to JSON string
# param = $data - perl data structure to encode
# return = JSON octet string

my $data = shift;

state $json;
if ( !defined $json ) {
    $json = JSON::XS->new();
    $json->convert_blessed(1);
    $json->allow_nonref(1);
    $json->canonical(1);
    $json->relaxed(1);
    $json->pretty(1);
    $json->utf8(0);
    ## output octets [bytes], not utf-8 flagged strings
    ## size mode uses bytes::length for byte count
}
return $json->encode($data);

0;

