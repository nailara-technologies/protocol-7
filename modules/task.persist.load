## [:< ##

# name  = task.persist.load
# descr = load task queue from disk yaml

my $queue_file = 'queue.yaml';

my $content_sref = <[file.zenka_dir.load]>->($queue_file);

if ( not defined $content_sref ) {
    <[base.logs]>->( 2, ': task queue file not found, starting fresh' );
    return FALSE;
}

<[format.yaml.pre_init]>;

my $data = <[format.yaml.load_str]>->( $content_sref->$* );

if ( not defined $data or ref $data ne 'HASH' ) {
    <[base.s_warn]>->('task.persist.load: failed to parse queue file');
    return FALSE;
}

<task.queue>       = $data->{'queue'}       // {};
<task.queue.order> = $data->{'queue_order'} // [];
<[base.logs]>->(
    2,
    ': task queue loaded [ %d tasks ]',
    scalar( @{<task.queue.order>} )
);
return TRUE;

