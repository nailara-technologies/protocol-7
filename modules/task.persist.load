## [:< ##

# name  = task.persist.load
# descr = load task queue from disk yaml

<[format.yaml.pre_init]>;

## load live queue ##
my $queue_sref = <[file.zenka_dir.load]>->('queue.yaml');
if ( not defined $queue_sref ) {
    <[base.logs]>->( 2, ': task queue file not found, starting fresh' );
} else {
    my $data = <[format.yaml.load_str]>->( $queue_sref->$* );
    if ( not defined $data or ref $data ne 'HASH' ) {
        <[base.logs]>->( 1, ': task queue file invalid — removing' );
        <[file.zenka_dir.unlink_file]>->('queue.yaml');
    } else {
        <task.queue>       = $data->{'queue'}       // {};
        <task.queue.order> = $data->{'queue_order'} // [];
        <[base.logs]>->(
            2,
            ': task queue loaded [ %d tasks ]',
            scalar( @{<task.queue.order>} )
        );
    }
}

## load history ##
my $hist_sref = <[file.zenka_dir.load]>->('history.yaml');
if ( defined $hist_sref ) {
    my $hdata = <[format.yaml.load_str]>->( $hist_sref->$* );
    if ( not defined $hdata or ref $hdata ne 'HASH' ) {
        <[base.logs]>->( 1, ': task history file invalid — removing' );
        <[file.zenka_dir.unlink_file]>->('history.yaml');
    } else {
        <task.history> = $hdata->{'history'} // {};
        <[base.logs]>->(
            2,
            ': task history loaded [ %d tasks ]',
            scalar( keys %{<task.history>} )
        );
    }
}

return TRUE;

