## [:< ##

# name  = kimi.task.fail
# descr = mark kimi task as failed
# purpose = kimi task management : wrapper around jobqueue.move_job to mark job failed with error

my ( $task_id, $error_msg ) = @ARG;

return {
    success => FALSE,
    error   => 'task_id required'
    }
    unless defined $task_id;

$error_msg //= 'task execution failed';

# Get task from queue
my $task = <kimi.task.queue>->{$task_id};

return {
    success => FALSE,
    error   => "task not found : $task_id"
    }
    unless defined $task;

# Move job to error queue if job_id is tracked
if ( defined $task->{'job_id'} ) {
    <[jobqueue.move_job]>->( $task->{'job_id'}, 'error' );
}

## update budget tracking [ if wired ] ##
if ( defined <kimi.budget.track_tokens> ) {
    <kimi.budget.track_tokens>->(
        {   'service'     => 'kimi.task.fail',
            'tokens_used' => 1,
            'type'        => 'fail',
        }
    );
}

return {
    success => TRUE,
    task_id => $task_id,
    error   => $error_msg,
    message => "task failed : $task_id"
};

