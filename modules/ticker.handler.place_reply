## [:< ##

# name  = ticker.handler.place_reply
# descr = handle geometry reply from window-place zenka

my $reply = shift;

return
    if not defined $reply
    or ( $reply->{'cmd'} // '' ) ne qw| TRUE |;

my $args = $reply->{'call_args'}{'args'} // '';

<[base.logs]>->( 1, '[ticker.place_reply] received: %s', $args );

if ( $args =~ m|x=(\d+).*y=(\d+).*width=(\d+).*height=(\d+)| ) {
    my ( $x, $y, $w, $h ) = ( $1, $2, $3, $4 );
    <[base.logs]>->(
        1,  '[ticker.place_reply] saved geometry x=%d y=%d w=%d h=%d',
        $x, $y, $w, $h
    );
    <[base.log]>->(
        1, 'restart ticker with ticker.window.profile = saved to apply'
    );
} else {
    <[base.log]>->(
        1, '[ticker.place_reply] placement cancelled or malformed'
    );
}

