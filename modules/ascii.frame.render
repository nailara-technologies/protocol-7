## [:< ##

# name  = ascii.frame.render
# descr = render frame descriptor with slot values to ascii art string

my $params = shift // {};

my $descriptor = $params->{'descriptor'} // {};
my $values     = $params->{'values'}     // {};

return undef if not keys %{$descriptor};

my $border      = $descriptor->{'border'}      // {};
my $corners     = $descriptor->{'corners'}     // {};
my $min_width   = $descriptor->{'min_width'}   // 0;
my $padding     = $descriptor->{'padding'}     // { left => 0, right => 0 };
my $slots       = $descriptor->{'slots'}       // {};
my $static_rows = $descriptor->{'static_rows'} // {};

my $lpad = $padding->{'left'}  // 0;
my $rpad = $padding->{'right'} // 0;

## outer margin : applied OUTSIDE the border as a final wrap [ does not
## affect frame_width — it is the parent-plane's breathing room ] ##
my $margin = $descriptor->{'margin'} // {};
my $lmar   = $margin->{'left'}       // 0;
my $rmar   = $margin->{'right'}      // 0;

## compute required width ##
my $required_width = $min_width;

## static rows drive content width when no slots present ##
for my $row ( keys %{$static_rows} ) {
    my $static        = $static_rows->{$row};
    my $content_width = length($static);
    $required_width = $content_width if $content_width > $required_width;
}

## field slots drive content width ##
for my $name ( keys %{$slots} ) {
    my $slot = $slots->{$name};
    if ( $slot->{'type'} eq qw| field | ) {
        my $value = $values->{$name} // '';
        my $row_width
            = length( $slot->{'prefix'} // '' )
            + length($value)
            + length( $slot->{'suffix'} // '' )
            + $lpad + $rpad;
        $required_width = $row_width if $row_width > $required_width;
    } elsif ( $slot->{'type'} eq qw| composed |
        and exists $slot->{'inner_width'} ) {
        ## composed inner frame constrains outer width ##
        my $inner_total = $slot->{'inner_width'};
        my $content_width
            = $inner_total
            - length( $border->{'left'}  // '' )
            - length( $border->{'right'} // '' );
        $required_width = $content_width
            if $content_width > $required_width;
    } elsif ( $slot->{'type'} eq qw| block | ) {
        ## block slot content drives width ##
        my $prefix = $slot->{'prefix'} // '';
        my $value  = $values->{$name}  // '';
        my @lines  = split "\n", $value;
        @lines = ('') if not @lines;
        for my $line (@lines) {
            my $row_width = length($prefix) + length($line) + $lpad + $rpad;
            $required_width = $row_width if $row_width > $required_width;
        }
    }
}

## every border line contributes its own fixed width [ anchors + fill
## minimums + slot values, mirroring render.border_line's $fixed ] —
## not just lines with inline slots. without this, a border line whose
## decorative fills alone exceed the content-driven width renders wider
## than the content rows, drifting out of alignment with them ##
for my $side (qw| top bottom |) {
    my $elements = $border->{$side} // [];
    next if not @{$elements};
    my $fixed = 0;
    for my $e ( @{$elements} ) {
        if ( $e->{'type'} eq qw| anchor | ) {
            $fixed += length( $e->{'value'} // '' );
        } elsif ( $e->{'type'} eq qw| fill | ) {
            $fixed += $e->{'min'} // 1;
        } elsif ( $e->{'type'} eq qw| slot | ) {
            $fixed += length( $values->{ $e->{'name'} } // '' );
        }
    }
    my $candidate
        = $fixed
        - length( $border->{'left'}  // '' )
        - length( $border->{'right'} // '' );
    $required_width = $candidate if $candidate > $required_width;
}

## total frame width includes left and right borders ##
my $frame_width
    = $required_width
    + length( $border->{'left'}  // '' )
    + length( $border->{'right'} // '' );

## render top border ##
my @output;
my $top_line = <[ascii.frame.render.border_line]>->(
    $border->{'top'}, $values, $frame_width
);
push @output, $top_line if length $top_line;

## collect rows with slot assignments ##
my %row_slots;
for my $name ( keys %{$slots} ) {
    my $slot = $slots->{$name};
    next if $slot->{'type'} eq qw| inline |;
    my $row = $slot->{'row'} // 0;
    push @{ $row_slots{$row} }, $name;
}

## determine max content row ##
my $max_row = 0;
for my $k ( keys %row_slots ) {
    $max_row = $k if $k > $max_row;
}
for my $k ( keys %{$static_rows} ) {
    $max_row = $k if $k > $max_row;
}

## render content rows ##
my @content_output;
for my $row ( 1 .. $max_row ) {
    if ( exists $row_slots{$row} ) {
        my @slot_names = @{ $row_slots{$row} };
        for my $name (@slot_names) {
            my $slot  = $slots->{$name};
            my $value = $values->{$name} // '';

            ## resolve scalar binding if present ##
            if ( exists $slot->{'binding'}
                and ref $slot->{'binding'} eq qw| SCALAR | ) {
                $value = ${ $slot->{'binding'} };
            }

            ## render composed inner frame ##
            if ( $slot->{'type'} eq qw| composed |
                and exists $slot->{'inner_frame'} ) {
                my $inner_rendered = <[ascii.frame.render]>->(
                    {   descriptor => $slot->{'inner_frame'},
                        values     => $values,
                    }
                );
                $value = $inner_rendered // '';
            }

            if ( $slot->{'type'} eq qw| composed | ) {
                ## composed inner frame : lines replace slot directly ##
                my @inner_lines = split "\n", $value;
                @inner_lines = ('') if not @inner_lines;
                for my $iline (@inner_lines) {
                    ## inner frame line already has its own borders ##
                    ## pad or trim to fit outer frame width ##
                    my $line_width = length($iline);
                    my $target
                        = $frame_width
                        - length( $border->{'left'}  // '' )
                        - length( $border->{'right'} // '' );
                    if ( $line_width < $target ) {
                        $iline .= ' ' x ( $target - $line_width );
                    }
                    my $line
                        = $border->{'left'} . $iline . $border->{'right'};
                    push @content_output, $line;
                }
            } elsif ( $slot->{'type'} eq qw| block | ) {
                ## block expands to multiple lines ##
                my @block_lines = split "\n", $value;
                @block_lines = ('') if not @block_lines;
                for my $bline (@block_lines) {
                    my $content_part = ( $slot->{'prefix'} // '' ) . $bline;
                    my $fill_width
                        = $frame_width
                        - length( $border->{'left'}  // '' )
                        - length( $border->{'right'} // '' )
                        - $lpad - $rpad
                        - length($content_part);
                    $fill_width = 0 if $fill_width < 0;
                    my $line
                        = $border->{'left'}
                        . ( ' ' x $lpad )
                        . $content_part
                        . ( ' ' x $fill_width )
                        . ( ' ' x $rpad )
                        . $border->{'right'};
                    push @content_output, $line;
                }
            } else {
                ## field slot : pad to required width ##
                my $prefix       = $slot->{'prefix'} // '';
                my $suffix       = $slot->{'suffix'} // '';
                my $content_part = $prefix . $value . $suffix;
                my $fill_width
                    = $frame_width
                    - length( $border->{'left'}  // '' )
                    - length( $border->{'right'} // '' )
                    - $lpad - $rpad
                    - length($content_part);
                $fill_width = 0 if $fill_width < 0;
                my $line
                    = $border->{'left'}
                    . ( ' ' x $lpad )
                    . $content_part
                    . ( ' ' x $fill_width )
                    . ( ' ' x $rpad )
                    . $border->{'right'};
                push @content_output, $line;
            }
        }
    } elsif ( exists $static_rows->{$row} ) {
        my $static   = $static_rows->{$row};
        my $stripped = $static;

        ## [ strip border artifacts left in content by double-style mockups ]##
        my $lb = $border->{'left'}  // '';
        my $rb = $border->{'right'} // '';
        if (    length($lb)
            and length($stripped) >= length($lb)
            and substr( $stripped, 0, length($lb) ) eq $lb ) {
            $stripped = substr( $stripped, length($lb) );
        }
        if (    length($rb)
            and length($stripped) >= length($rb)
            and
            substr( $stripped, length($stripped) - length($rb), length($rb) )
            eq $rb ) {
            $stripped
                = substr( $stripped, 0, length($stripped) - length($rb) );
        }

        if (    $lpad > 0
            and length($stripped) >= $lpad
            and substr( $stripped, 0, $lpad ) eq ' ' x $lpad ) {
            $stripped = substr( $stripped, $lpad );
        }
        if (    $rpad > 0
            and length($stripped) >= $rpad
            and substr( $stripped, length($stripped) - $rpad, $rpad ) eq ' '
            x $rpad ) {
            $stripped = substr( $stripped, 0, length($stripped) - $rpad );
        }
        my $fill_width
            = $frame_width
            - length( $border->{'left'}  // '' )
            - length( $border->{'right'} // '' )
            - $lpad - $rpad
            - length($stripped);
        $fill_width = 0 if $fill_width < 0;
        my $line
            = $border->{'left'}
            . ( ' ' x $lpad )
            . $stripped
            . ( ' ' x $fill_width )
            . ( ' ' x $rpad )
            . $border->{'right'};
        push @content_output, $line;
    }
}

## vertical padding : blank content rows inside the border, above / below
## the content block [ the top/bottom analogue of lpad/rpad ] ##
my $tpad = $padding->{'top'}    // 0;
my $bpad = $padding->{'bottom'} // 0;
if ( $tpad or $bpad ) {
    my $interior
        = $frame_width
        - length( $border->{'left'}  // '' )
        - length( $border->{'right'} // '' );
    $interior = 0 if $interior < 0;
    my $blank
        = ( $border->{'left'} // '' )
        . ( ' ' x $interior )
        . ( $border->{'right'} // '' );
    unshift @content_output, ($blank) x $tpad if $tpad;
    push @content_output, ($blank) x $bpad if $bpad;
}

push @output, @content_output;

## render bottom border ##
if ( @{ $border->{'bottom'} // [] } ) {
    my $bottom_line = <[ascii.frame.render.border_line]>->(
        $border->{'bottom'}, $values, $frame_width
    );
    push @output, $bottom_line if length $bottom_line;
}

## apply outer margin to every line [ space outside the border ] ##
if ( $lmar or $rmar ) {
    my $lm = ' ' x $lmar;
    my $rm = ' ' x $rmar;
    @output = map { $lm . $_ . $rm } @output;
}

return join "\n", @output;

