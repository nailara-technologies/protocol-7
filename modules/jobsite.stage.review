## [:< ##

# name  = jobsite.stage.review
# descr = transition to reviewing, log jobs above threshold

<jobsite.cycle> = 'reviewing';

my $tasks = <jobsite.tasks> // {};
my @for_review
    = grep { ( $tasks->{$ARG}{'stage'} // '' ) eq 'review' } keys %{$tasks};

if ( not @for_review ) {
    <[base.logs]>->( 1, 'jss.review: no jobs above threshold, idle' );
    <jobsite.cycle> = 'idle';
    <[jobsite.state.persist]>;
    return;
}

<[base.logs]>->(
    1,
    'jss.review: %d job(s) await approval:',
    scalar @for_review
);

my $store = <[jobsite.job.load_all]>;

for my $job_id ( sort @for_review ) {
    my $rec = $tasks->{$job_id};
    my $job = $store->{$job_id} // {};
    <[base.logs]>->(
        1,
        'jss.review:  [%s] score=%s  %s — %s (%s)',
        $job_id,
        $rec->{'score'}   // '?',
        $job->{'title'}   // '',
        $job->{'company'} // '',
        $job->{'city'}    // '',
    );
}

<[base.logs]>->( 1, 'jss.review: use "p7c jobsite.approve <id>" to proceed' );

<[jobsite.state.persist]>;

