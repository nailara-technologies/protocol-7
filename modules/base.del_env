## [:< ##

# name  = base.del_env
# param = <key>
# descr = delete value from ENV hash with level 2 log entry
# return = [deleted] <value> or undef

my $key = shift;

if ( not length $key // '' ) {
    <[base.s_warn]>->('key name expected <{C1}>');
    return undef;
} elsif ( not exists $ENV{$key} ) {
    <[base.logs]>->( 2, '[del-env] not present : %s', $key );
    return undef;
}

<[base.logs]>->( 2, ": deleting env-key : %s", $key );

return delete $ENV{$key};

