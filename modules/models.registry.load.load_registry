# name  = models.registry.load.load_registry
# descr = Load registry from disk

use JSON::PP;
use Fcntl qw| :flock |;

my $path = <[models.registry.base.get_registry_path]>;
if ( -f $path ) {
    open my $fh, '<', $path or goto EMPTY;
    flock( $fh, 1 );    # LOCK_SH
    my $content = do { local $/; <$fh> };
    flock( $fh, 8 );    # LOCK_UN
    close $fh;

    my $loaded = decode_json($content) if $content;
    if ( $loaded && ref($loaded) eq qw| HASH | ) {
        ## Handle legacy wrapped format: { models => {...} }
        ## Return flat format: { <id> => {...} }
        if ( exists $loaded->{models}
            && ref( $loaded->{models} ) eq qw| HASH | ) {
            return $loaded->{models};
        }
        return $loaded;
    }
}

EMPTY:
return <[models.registry.empty.create_empty_registry]>;

