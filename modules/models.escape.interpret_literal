# name = models.escape.interpret_literal
# descr = interpret escapes preserving literal tab characters (for code)
# param = $text - text with :n: :t: escapes
# return = text with literal \n and \t characters

my $text = shift;

return '' unless defined $text;

## handle escaped markers first
$text =~ s/\\:n:/__LITERAL_COLON_N__/g;
$text =~ s/\\:t:/__LITERAL_COLON_T__/g;

## apply escapes with literal characters
$text =~ s/:n:/\n/g;
$text =~ s/:t:/\t/g;    ## literal tab character

## restore literals
$text =~ s/__LITERAL_COLON_N__/:n:/g;
$text =~ s/__LITERAL_COLON_T__/:t:/g;

return $text;

0;

