# name  = tile.subscribe-screen-change
# descr = initialized callback — subscribe tile to X-11 screen-change STRM events

<[base.log]>->( 1, 'subscribing tile to X-11 screen-change events .,' );

<[protocol-7.route-send]>->(
    {   'command' => qw| X-11.subscribe-screen-change |,
        'reply'   =>
            { 'handler' => qw| tile.handler.screen-change_strm_open |, }
    }
);

return TRUE;

