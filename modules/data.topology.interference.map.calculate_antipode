    # name = data.topology.interference.map.calculate_antipode
    # desc = Topology calculation subroutine

    my $coord = shift;
    my ( $x, $y, $z ) = @$coord;

    # Antipodal point: opposite side of 13³ sphere
    return [
        ( CUBE_SIZE - 1 - $x ),
        ( CUBE_SIZE - 1 - $y ),
        ( CUBE_SIZE - 1 - $z )
    ];

