    # name = data.topology.interference.map.calculate_antipode
    # descr = Topology calculation subroutine

    my $coord = shift;
    my ( $x, $y, $z ) = @$coord;

    my $cube_size = <[data.topology.interference.map.CUBE_SIZE]>;

    # antipodal point: opposite side of 13³ sphere
    return [
        ( $cube_size - 1 - $x ),
        ( $cube_size - 1 - $y ),
        ( $cube_size - 1 - $z )
    ];

