## [:< ##

# name = kimi.task.queue_status
# descr = get status of specific task or queue statistics
# purpose = queue operation: report task|queue state

my $task_id = shift;

## get persistent storage refs ##
my $queue_href     = <kimi.task.queue>     //= {};
my $aref_pending   = <kimi.task.pending>   //= [];
my $aref_active    = <kimi.task.active>    //= [];
my $aref_completed = <kimi.task.completed> //= [];
my $aref_failed    = <kimi.task.failed>    //= [];

## specific task requested ##
if ( defined $task_id ) {
    return { success => FALSE, error => "task not found: '$task_id'" }
        unless exists $queue_href->{$task_id};

    my $task = $queue_href->{$task_id};

    return {
        success   => TRUE,
        task_id   => $task_id,
        status    => $task->{'execution'}->{'status'},
        started   => $task->{'execution'}->{'started'},
        completed => $task->{'execution'}->{'completed'},
        result    => $task->{'execution'}->{'result'},
    };
}

## general queue statistics ##
return {
    success       => TRUE,
    total_tasks   => scalar( keys $queue_href->%* ),
    pending       => scalar( $aref_pending->@* ),
    in_progress   => scalar( $aref_active->@* ),
    completed     => scalar( $aref_completed->@* ),
    failed        => scalar( $aref_failed->@* ),
    queue_updated => <[base.time]>->(3)
};

