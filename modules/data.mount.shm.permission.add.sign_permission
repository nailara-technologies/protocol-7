# name = data.mount.shm.permission.add.sign_permission
# descr = Sign permission with owner's private key (simplified)

my ( $perm, $priv_key ) = @ARG;

# Build canonical string
my $canonical
    = $perm->{'to'} . ':'
    . $perm->{'branch'} . ':'
    . join( ',', @{ $perm->{'rights'} } ) . ':'
    . $perm->{'expiry'} . ':'
    . $perm->{'granted'};

# Simple hash signature (placeholder - use proper crypto in production)
my $sig = 0;
for my $i ( 0 .. length($canonical) - 1 ) {
    $sig = ( $sig * 31 + ord( substr( $canonical, $i, 1 ) ) ) & 0xFFFFFFFF;
}
$sig = ( $sig * length( $priv_key || '' ) ) & 0xFFFFFFFF
    if length( $priv_key || '' );

return sprintf( "%08X", $sig );

