# name = data.mount.shm.permission.add.sign_permission
# desc = Sign permission with owner's private key

my ( $perm, $priv_key ) = @_;

my $canonical = sprintf( "%s:%s:%s:%d:%s",
    $perm->{'to'},     $perm->{'branch'}, join( ',', @{ $perm->{'rights'} } ),
    $perm->{'expiry'}, $perm->{'granted'}, );

my $signature
    = <[chk-sum.amos.truth_template_chksum]>->( $canonical . $priv_key, \0 );
return sprintf( "%08X", $signature );

