## [:< ##

# name  = jobsite.state.load
# descr = restore scan state from disk

my $sref = <[file.zenka_dir.load]>->('scan-state.yaml');
return if not defined $sref;

my $saved;
eval { $saved = YAML::XS::Load( $sref->$* ) };
if ($@) {
    <[base.logs]>->( 0, 'jss.load: parse error: %s', $@ );
    return;
}
return if ref $saved ne 'HASH';

<jobsite.last_scan>              = $saved->{'last_scan'}       // 0;
<jobsite.pending_count>          = $saved->{'pending_count'}   // 0;
<jobsite.sync.last_server_ntime> = $saved->{'sync_last_ntime'} // ''
    if length( $saved->{'sync_last_ntime'} // '' );

## cycle: reset scanning/assessing to idle ##
my $cycle = $saved->{'cycle'} // 'idle';
if ( $cycle =~ m{^(?:scanning|assessing)$} ) {

    ## in-flight work [ assess_queue, per-job 'queued'/'assessing' stage,  ##
    ## task.wait-done watchers ] lives only in memory and does not survive ##
    ## a restart -- carrying pending_count forward orphans it against work ##
    ## that will never report back, wedging cycle on 'assessing' forever   ##
    ## once the next batch's real jobs finish [ see jss pending_count      ##
    ## orphan-gap bug ]                                                    ##
    <[base.logs]>->(
        1,
        'jss.load: cycle=%s had pending=%d, '
            . 'unrecoverable across restart, resetting',
        $cycle,
        $saved->{'pending_count'} // 0
    );
    <jobsite.pending_count> = 0;
    <jobsite.assess_queue>  = [];
    $cycle = 'idle';
}
<jobsite.cycle> = $cycle;

## sanity check : pending_count only ever means anything while a batch is   ##
## actually being dispatched, i.e. cycle=assessing -- any OTHER cycle value ##
## [ idle, reviewing, or a persisted scanning/assessing already coerced to  ##
## idle above ] implies pending_count must be 0. a stray positive count     ##
## persisted alongside a non-assessing cycle [ e.g. left over from a prior  ##
## mismatched increment/decrement ] survives the reset branch above         ##
## untouched, since that branch only fires for a persisted scanning/        ##
## assessing cycle. uncorrected, it permanently prevents pending_count from ##
## ever reaching 0 again once real work drains, wedging cycle on            ##
## 'assessing' forever the next time dispatch.assessments runs              ##
if ( <jobsite.cycle> ne 'assessing' and <jobsite.pending_count> ) {
    <[base.logs]>->(
        0, 'jss.load: cycle=%s but pending=%d, resetting stray count',
        <jobsite.cycle>, <jobsite.pending_count>
    );
    <jobsite.pending_count> = 0;
}

## migrate from monolithic store.yaml if present (one-time) ##
my $jobs_dir
    = catdir( <system.path.zenka-dirs.var_P7>, <system.zenka.name>, 'jobs' );
my $store_file = '/var/protocol-7/site-yaml/store.yaml';
my $has_jobs   = 0;
if ( -d $jobs_dir ) {
    $has_jobs = 1
        if glob("$jobs_dir/*/*.yaml")
        or glob("$jobs_dir/*/*/*.yaml");
}

if ( -f $store_file and not $has_jobs ) {
    my $store = eval { YAML::XS::LoadFile($store_file) } // {};
    if ( ref $store eq 'HASH' and %{$store} ) {
        my $migrated = 0;
        my $tasks    = <jobsite.tasks> // {};
        for my $job_id ( keys %{$store} ) {
            my $job = $store->{$job_id};
            next if ref $job ne 'HASH';

            ## merge scan-state data if present
            if ( exists $tasks->{$job_id} ) {
                my $task = $tasks->{$job_id};
                for my $key (
                    qw| stage score score_reason score_summary assertions
                    repair_attempted repair_failed repair_applied |
                ) {
                    $job->{$key} = $task->{$key}
                        if defined $task->{$key};
                }
            }

            <[jobsite.job.write]>->( $job_id, $job );
            $migrated++;
        }
        <[base.logs]>->(
            1, 'migrated %d jobs from store.yaml to per-element layout',
            $migrated
        );
    }
}

<[base.logs]>->(
    1,               'jss.load: cycle=%s, pending=%d',
    <jobsite.cycle>, <jobsite.pending_count>
);

