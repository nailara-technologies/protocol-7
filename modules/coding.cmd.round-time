## [:< ##

# name  = coding.cmd.round-time
# descr = active tasks' round elapsed vs timeout ceiling
# param = [limit]

my $args_str = $call->{'args'} // '';
my ($limit)  = split m{ +}, $args_str, 2;
$limit //= 20;

my $default_ceiling = <coding.http-timeouts.request-completed> // 780;
my $now             = <[base.time]>->(3);

my $aref_active = <coding.task.active> // [];

my @rows;
for my $task_id ( $aref_active->@* ) {
    my $task = <coding.task.queue>->{$task_id};
    next unless defined $task;

    my $state = <[coding.async.state_machine]>->( qw| get |, $task_id );
    my $round = $state->{'round'} // 0;

    ## actual ceiling governing THIS round : soft/escalated/GPU-stretched, ##
    ## not always the flat default [ see coding.async.request ]           ##
    my $ceiling = $state->{'timeout_ceiling'} // $default_ceiling;

    ## phase-1 [http-wait] start; phase-2 [tool-exec] starts when this     ##
    ## round's response has been fully received and state_machine enters   ##
    ## tool_exec.                                                          ##
    my $http_started  = $state->{'round_started'};         ## phase 1 start ##
    my $tools_started = $state->{'round_tools_started'};   ## phase 2 start ##

    my ( $http_elapsed, $http_pct, $tools_elapsed );
    if ( defined $http_started ) {
        my $http_end = defined $tools_started ? $tools_started : $now;
        $http_elapsed = $http_end - $http_started;
        $http_pct
            = $ceiling > 0 ? int( 100 * $http_elapsed / $ceiling ) : undef;
    }
    $tools_elapsed = defined $tools_started ? $now - $tools_started : undef;

    my $desc = $task->{'request'}->{'description'} // '';
    $desc = <[base.parser.center_ellipse_string]>->( $desc, 40 )
        if length $desc > 40;

    push @rows,
        {
        'task_id'       => $task_id,
        'round'         => $round,
        'ceiling'       => $ceiling,
        'http_elapsed'  => $http_elapsed,
        'http_pct'      => $http_pct,
        'tools_elapsed' => $tools_elapsed,
        'desc'          => $desc,
        };
}

## slowest-first by http phase : that's the one with the timeout ceiling ##
@rows = sort { ( $b->{'http_pct'} // -1 ) <=> ( $a->{'http_pct'} // -1 ) }
    @rows;
@rows = @rows[ 0 .. $limit - 1 ] if @rows > $limit;

my @output;
push @output, ':: round elapsed | timeout ceiling ::';

if (@rows) {
    for my $row (@rows) {
        if ( not defined $row->{'http_pct'} ) {
            push @output,
                sprintf "   %s | r%d | ---- of ---- [ no data yet ] | %s",
                $row->{'task_id'}, $row->{'round'}, $row->{'desc'};
            next;
        }
        my $http_flag
            = $row->{'http_pct'} >= 90 ? '!!'
            : $row->{'http_pct'} >= 70 ? '! '
            :                            '  ';

        my $tools_str = 'tools: --';
        if ( defined $row->{'tools_elapsed'} ) {
            my $tools_flag
                = $row->{'tools_elapsed'} > $row->{'ceiling'} ? '[!! long]'
                : $row->{'tools_elapsed'} > 300               ? '[! long]'
                :                                               '';
            $tools_str = sprintf "tools: %ds [no ceiling] %s",
                $row->{'tools_elapsed'}, $tools_flag;
            $tools_str =~ s| +$||;
        }

        push @output,
            sprintf
            "%s %s | R:%02d | http: %03ds of %03ds [%%%03d] | %s | %s",
            $http_flag, $row->{'task_id'},
            $row->{'round'},   $row->{'http_elapsed'},
            $row->{'ceiling'}, $row->{'http_pct'},
            $tools_str, $row->{'desc'};
    }
} else {
    push @output, '  (no active tasks)';
}

my $output_str = join( "\n", @output ) . "\n";

return { 'mode' => qw| size |, 'data' => $output_str };

