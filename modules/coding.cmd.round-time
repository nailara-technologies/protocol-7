## [:< ##

# name  = coding.cmd.round-time
# descr = active tasks' round elapsed vs timeout ceiling
# param = [limit]

my $args_str = $call->{'args'} // '';
my ($limit)  = split m{ +}, $args_str, 2;
$limit //= 20;

my $ceiling = <coding.http-timeouts.request-completed> // 780;
my $now     = <[base.time]>->(3);

my $aref_active = <coding.task.active> // [];

my @rows;
for my $task_id ( $aref_active->@* ) {
    my $task = <coding.task.queue>->{$task_id};
    next unless defined $task;

    my $state = <[coding.async.state_machine]>->( qw| get |, $task_id );
    my $round = $state->{'round'} // 0;
    my $round_started = $state->{'round_started'};   ## undef = no data yet ##
    my $round_elapsed
        = defined $round_started ? $now - $round_started : undef;
    my $pct
        = ( defined $round_elapsed && $ceiling > 0 )
        ? int( 100 * $round_elapsed / $ceiling )
        : undef;

    my $desc = $task->{'request'}->{'description'} // '';
    $desc = <[base.parser.center_ellipse_string]>->( $desc, 40 )
        if length $desc > 40;

    push @rows,
        {
        'task_id'       => $task_id,
        'round'         => $round,
        'round_elapsed' => $round_elapsed,
        'pct'           => $pct,
        'desc'          => $desc,
        };
}

## slowest-first : the ones closest to timing out matter most [ undef pct last ] ##
@rows = sort { ( $b->{'pct'} // -1 ) <=> ( $a->{'pct'} // -1 ) } @rows;
@rows = @rows[ 0 .. $limit - 1 ] if @rows > $limit;

my @output;
push @output, ':: round elapsed / timeout ceiling ::';

if (@rows) {
    for my $row (@rows) {
        if ( not defined $row->{'pct'} ) {
            push @output,
                sprintf "   %s | r%d | ---- / ---- [ no data yet ] | %s",
                $row->{'task_id'}, $row->{'round'}, $row->{'desc'};
            next;
        }
        my $flag
            = $row->{'pct'} >= 90 ? '!!'
            : $row->{'pct'} >= 70 ? '! '
            :                       '  ';
        push @output,
            sprintf "%s %s | R:%02d | %03ds of %03ds [ %d%% ] | %s",
            $flag, $row->{'task_id'}, $row->{'round'},
            $row->{'round_elapsed'}, $ceiling, $row->{'pct'}, $row->{'desc'};
    }
} else {
    push @output, '  (no active tasks)';
}

my $output_str = join( "\n", @output ) . "\n";

return { 'mode' => qw| size |, 'data' => $output_str };

