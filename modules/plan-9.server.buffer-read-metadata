# name  = plan-9.server.buffer-read-metadata
# descr = Read buffer metadata

my ( $amos_id, $offset, $count ) = @ARG;

my $buf = $data{'plan-9'}{'server'}{'buffers'}{$amos_id};
return '' unless $buf;

my $window = $buf->{window};
my $meta   = sprintf(
    "amos_id: %s\nsession_id: %s\ncreated: %s\nsize: %dx%dx%d\n",
    $amos_id,
    $window->{session_id} // 'unknown',
    scalar( localtime( $window->{created} // time ) ),
    $window->{buffer}{width}  // 80,
    $window->{buffer}{height} // 24,
    $window->{buffer}{depth}  // 13,
);

return substr( $meta, $offset, $count );

