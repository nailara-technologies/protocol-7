## [:< ##

# name  = channels.cmd.subscribe
# descr = Subscribe to channel (lazy activation of pub/sub)
# param = <channel-path>
# return = { mode => 'true', data => 'subscribed to <channel-path>' }

my $args = $$call{'args'} // '';
my $channel_path = $args;
$channel_path =~ s|^\s+||;        ## trim leading whitespace ##
$channel_path =~ s|\s+$||;        ## trim trailing whitespace ##

return {
    'mode' => qw| false |,
    'data' => 'expected <channel-path> parameter'
} unless length $channel_path;

##  Validate channel path  ##
unless ( $channel_path =~ m|^[a-z0-9\.\-_]+$|i ) {
    return {
        'mode' => qw| false |,
        'data' => 'invalid channel path'
    };
}

##  Create subscription entry (lazy activation)  ##
my $session_id = $$call{'session_id'} // 'unknown';

##  If channel doesn't exist yet, create it  ##
<channels.subscriptions>->{$channel_path} //= {};

##  Record this subscription  ##
my $subscriber_id = "${session_id}_" . <[base.gen_id]>->({});
<channels.subscriptions>->{$channel_path}->{$subscriber_id} = {
    'session_id' => $session_id,
    'subscribed_at' => <[base.time]>->(2),
    'status' => 'ACTIVE'
};

##  Initialize channel data if not present  ##
<channels.data>->{$channel_path} //= {};
<channels.timestamps>->{$channel_path} //= encode_b32r(pack('Q>', <[base.time]>->(2)));

<[base.logs]>->(
    1,
    "channels: session %s subscribed to '%s'",
    $session_id,
    $channel_path
);

return {
    'mode' => qw| true |,
    'data' => "subscribed to '$channel_path'"
};

1;

