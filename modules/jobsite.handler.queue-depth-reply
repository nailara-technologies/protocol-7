## [:< ##

# name  = jobsite.handler.queue-depth-reply
# descr = receive site-yaml queue depth; when zero, stop polling and claim strays

my $call  = shift           // {};
my $raw   = $call->{'data'} // '0';
my $depth = ref $raw ? $raw->$* : $raw;
$depth =~ s/\D//g;
$depth = 0 if not length $depth;

return if $depth > 0;

## queue drained : cancel poll timer, pull stray jobs, then assess ##
if ( defined $data{'jobsite'}{'queue_poll_timer'} ) {
    $data{'jobsite'}{'queue_poll_timer'}->cancel;
    $data{'jobsite'}{'queue_poll_timer'} = undef;
}

<[base.logs]>->( 1, 'fetch: site-yaml queue empty, claiming strays' );
<[jobsite.stray.check]>;
<[jobsite.dispatch.assessments]>;

return;

