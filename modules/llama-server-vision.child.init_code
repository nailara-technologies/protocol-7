## [:< ##

# name  = llama-server-vision.child.init_code
# descr = child process initialization - spawns llama-server with text model

use IPC::Open3;
use Symbol qw(gensym);

<llama-server-vision.binary> = '/data/source/ik_llama.cpp/llama-mtmd-cli-cuda';
<llama-server-vision.lib_path> = '/data/source/ik_llama.cpp';
<llama-server-vision.log_file> = '/var/log/protocol-7/llama-server-vision.log';

# Vision model with multimodal support
<llama-server-vision.vision_model_path> = '/mnt/ext-xfs-data/models-lmstudio/Qwen/Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf';
<llama-server-vision.vision_mmproj_path> = '/mnt/ext-xfs-data/models-lmstudio/Qwen/mmproj-F16.gguf';

<[base.log]>->( 1, 'llama-server vision child process starting.,' );

# Verify model exists
my $model_path = <llama-server-vision.vision_model_path>;
unless ( -f $model_path ) {
    <[base.logs]>->( 0, "ERROR: Vision model not found: %s", $model_path );
    <[base.exit]>->(qw| 0001 |);
}

my $mmproj_path = <llama-server-vision.vision_mmproj_path>;
unless ( -f $mmproj_path ) {
    <[base.logs]>->( 0, "ERROR: Multimodal projection not found: %s", $mmproj_path );
    <[base.exit]>->(qw| 0002 |);
}

<[base.logs]>->( 1, "Vision model: %s", $model_path );
<[base.logs]>->( 1, "Multimodal proj: %s", $mmproj_path );

# Set up environment
$ENV{'LD_LIBRARY_PATH'} = <llama-server-vision.lib_path> . ':' . ($ENV{'LD_LIBRARY_PATH'} // '');

# Build command for vision CLI with stdin/stdout pipes
my $binary = <llama-server-vision.binary>;
my @cmd = (
    $binary,
    '-m', $model_path,
    '--mmproj', $mmproj_path,
    '-ngl', 99,
    '-c', 2048,
    '-t', 4,
    '--interactive-first',
    '--interactive',
);

<[base.logs]>->( 1, "Spawning llama vision subprocess: %s", join(' ', @cmd) );

# Spawn llama-server with pipes
my ($wtr, $rdr, $err);
$err = gensym;

my $pid = eval { open3($wtr, $rdr, $err, @cmd) };

if ( !$pid || $@ ) {
    <[base.logs]>->( 0, "ERROR: Failed to spawn llama-server: %s", $@ // 'unknown error' );
    <[base.exit]>->(qw| 0002 |);
}

<llama-server-vision.server_pid> = $pid;
<[base.logs]>->( 1, "llama-server spawned with PID %d", $pid );

# Check process immediately with WNOHANG to detect immediate failures
my $wait_res = <[base.waitpid]>->($pid);

if ( defined $wait_res && $wait_res == $pid ) {
    <[base.logs]>->( 0, "ERROR: llama-server exited immediately" );
    <[base.exit]>->(qw| 0003 |);
}

# Register server PID with v7 for lifecycle management
push( <system.kill_list>->@*, $pid );
<[base.zenki.report_child_pid]>->($pid);

# Open log file for writing
open my $log_fh, '>>', <llama-server-vision.log_file> or die "Can't open log: $!";
binmode($log_fh);

# Store file handles in global data for handler access
<llama-server-vision.server_output_fh> = $rdr;
<llama-server-vision.server_log_fh> = $log_fh;
<llama-server-vision.server_input_fh> = $wtr;

# Get parent pipe for receiving commands
my $parent_pipe = <llama-server-vision.pipe.parent>;

# Set up non-blocking I/O handler for server output
<[event.add_io]>->(
    {
        'fd'      => $rdr,
        'handler' => qw| llama-server-vision.handler.server_output |,
        'data'    => { 'pid' => $pid }
    }
);

# Set up non-blocking I/O handler for parent input (incoming requests)
<[event.add_io]>->(
    {
        'fd'      => $parent_pipe,
        'handler' => qw| llama-server-vision.handler.parent_request |,
        'data'    => { 'type' => 'request' }
    }
);

<[base.logs]>->( 1, 'llama-server event handlers registered.,' );

