## [:< ##

# name  = graphics-matrix.channel.translate
# descr = translate glow intensity to channel-specific color

my $params = shift // {};

my $intensity   = $params->{'intensity'};
my $channel_idx = $params->{'channel'}
    // $data{'graphics-matrix'}{'channel'}{'active'};

my $channel_data = $data{'graphics-matrix'}{'channel'};
my $channels     = $channel_data->{'channels'};
my $channel      = $channels->{$channel_idx};

## validate intensity ##
return { qw| mode | => qw| false |, qw| data | => 'intensity required' }
    if not defined $intensity;

## default to active channel if index invalid ##
$channel = $channels->{ $channel_data->{'active'} } if not defined $channel;

if ( $channel->{'alpha'} ) {
    ## magenta is a mask color : transparency, not opaque pigment ##
    ## f4 bridges to neighbouring spectra rather than rendering its own ##
    my $alpha     = 0.1 + $intensity * 0.9;      ## same curve as value ##
    my $alpha_255 = int( $alpha * 255 + 0.5 );

    return {
        qw| r |         => 0,
        qw| g |         => 0,
        qw| b |         => 0,
        qw| a |         => $alpha_255,
        qw| hex |       => '#000000',
        qw| alpha |     => sprintf( '%.5f', $alpha ),
        qw| intensity | => sprintf( '%.5f', $intensity ),
        qw| mode |      => qw| alpha |,
    };
}

## opaque channels f0-f3 ##
my $hue = $channel->{'hue_base'};
my $sat = 0.3 + $intensity * 0.7;
my $val = 0.1 + $intensity * 0.9;

my $hsv = Convert::Color::HSV->new( $hue, $sat, $val );

local $SIG{__WARN__} = sub {
    my $w = shift;
    CORE::warn($w) unless $w =~ m|^Relying on AUTOLOAD|;
};

my @rgb = $hsv->rgb;                    ## float 0.0-1.0 ##
my $r   = int( $rgb[0] * 255 + 0.5 );
my $g   = int( $rgb[1] * 255 + 0.5 );
my $b   = int( $rgb[2] * 255 + 0.5 );
my $hex = '#' . $hsv->as_rgb8->hex;

return {
    qw| r |          => $r,
    qw| g |          => $g,
    qw| b |          => $b,
    qw| hex |        => $hex,
    qw| hue |        => $hue,
    qw| saturation | => sprintf( '%.5f', $sat ),
    qw| value |      => sprintf( '%.5f', $val ),
    qw| mode |       => qw| color |,
};

