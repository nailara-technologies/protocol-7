## [:< ##

# name  = coding.start.chmod_child
# descr = fork privileged child for temporary chmod during apply-staged

return if defined <coding.chmod_child.w_fh>;
return if not( $EUID == 0 or $UID == 0 );      ## must be root to fork ##

my $allow_chmod = <[base.cfg_bool]>->( <coding.cfg.allow_chmod_apply> // 0 );
my $assume_admin
    = <[base.cfg_bool]>->( <coding.cfg.assume_admin_group> // 0 );

return if not $allow_chmod or not $assume_admin;

my $admin_group = <coding.cfg.drop_privs_admin_group> // '';
return if not length $admin_group;

my $admin_gid = ( getgrnam($admin_group) )[2];
return if not defined $admin_gid;

## resolve admin user for privilege drop ##
my $admin_user = <system.admin-user> // '';
return if not length $admin_user;

my ( undef, undef, $admin_uid, $admin_user_gid ) = getpwnam($admin_user);
return if not defined $admin_uid;

<system.path.perl_bin> //= <[base.get_path.perl_exec]>;

my $zenka_name_chars = qr|0-9A-Za-z_\-|;
( my $zenka_name = <system.zenka.name> ) =~ s|[^$zenka_name_chars]+||g;

<[base.log]>->( 2, ': starting chmod-child .,' );

my $child_code = <<~"EOT";
use v5.24; use strict; use warnings; use English;
use Fcntl qw| :mode |;
map { \$SIG{\$ARG} = qw| IGNORE | } qw| INT TERM QUIT |;
## drop to admin user [ file owner : can chmod without root ] ##
\$GID = \$EGID = $admin_user_gid;
\$UID = \$EUID = $admin_uid;
\$PROGRAM_NAME = q|$zenka_name-<$admin_user>-chmod-child|;
\$| = 1;  ## autoflush stdout so parent readline never blocks indefinitely ##
my \$admin_gid = $admin_gid;
while ( my \$line = <STDIN> ) {
    chomp \$line;
    exit if not length \$line;
    if ( \$line =~ m|^gw (.+)\$| ) {
        my \$path = \$1;
        do { print "skip\n"; next } if not -f \$path;
        my \$gid = ( stat \$path )[5];
        do { print "skip\n"; next } if not defined \$gid or \$gid != \$admin_gid;
        my \$cur = ( stat \$path )[2] & 07777;
        chmod( \$cur | 0002, \$path );    ## other-write : coding zenka may not be in admin group ##
        print "ok\n";
    } elsif ( \$line =~ m|^gwd (.+)\$| ) {
        ## grant group-write on directory ##
        my \$path = \$1;
        do { print "skip\n"; next } if not -d \$path;
        my \$gid = ( stat \$path )[5];
        do { print "skip\n"; next } if not defined \$gid or \$gid != \$admin_gid;
        my \$cur = ( stat \$path )[2] & 07777;
        chmod( \$cur | 0020, \$path );
        print "ok\n";
    } elsif ( \$line =~ m|^create (.+)\$| ) {
        my \$path = \$1;
        do { print "skip\n"; next } if -e \$path;
        ## verify parent dir is owned by admin group ##
        ( my \$dir = \$path ) =~ s|/[^/]+\$||;
        do { print "skip\n"; next } if not -d \$dir;
        my \$dir_gid = ( stat \$dir )[5];
        do { print "skip\n"; next }
            if not defined \$dir_gid or \$dir_gid != \$admin_gid;
        ## create empty file as admin user [ 0664 for group write ] ##
        if ( open my \$fh, '>', \$path ) {
            close \$fh;
            chmod( 0664, \$path );
            print "ok\n";
        } else {
            print "err\n";
        }
    } elsif ( \$line =~ m|^mkdir (.+)\$| ) {
        ## create directory (and parents) as admin user ##
        my \$path = \$1;
        do { print "skip\n"; next } if -e \$path;
        ## walk up to find the highest existing ancestor ##
        my \$check = \$path;
        \$check =~ s|/[^/]+\$|| while \$check and not -d \$check;
        do { print "skip\n"; next } unless \$check and -d \$check;
        ## verify ancestor is owned by admin group ##
        my \$anc_gid = ( stat \$check )[5];
        do { print "skip\n"; next }
            if not defined \$anc_gid or \$anc_gid != \$admin_gid;
        ## create full path with group-writable permissions ##
        require File::Path;
        File::Path::make_path( \$path, { mode => 0775 } );
        ## set group on newly created directories ##
        chown( -1, \$admin_gid, \$path ) if -d \$path;
        print "ok\n";
    } elsif ( \$line =~ m|^restore (\\d+) (.+)\$| ) {
        my ( \$mode, \$path ) = ( oct(\$1), \$2 );
        do { print "skip\n"; next } if not -e \$path;
        chmod( \$mode, \$path );
        print "ok\n";
    } else {
        print "skip\n";  ## unknown command : always reply ##
    }
}
EOT

<[base.perlmod.load]>->('IPC::Open2')
    if not <[base.perlmod.loaded]>->('IPC::Open2');

<coding.chmod_child.pid>
    = IPC::Open2::open2( <coding.chmod_child.r_fh>, <coding.chmod_child.w_fh>,
    <system.path.perl_bin>, qw| -e |, $child_code )
    || die sprintf( "cannot start perl chmod child process [ %s ]\n",
    scalar <[base.format_error]>->($OS_ERROR) );

<coding.chmod_child.admin_gid> = $admin_gid;

<[base.logs]>->(
    2, ': started chmod child [pid:%d] admin_group=%s [gid=%d]',
    <coding.chmod_child.pid>, $admin_group, $admin_gid
);

