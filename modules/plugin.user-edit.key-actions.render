## [:< ##

# name  = plugin.user-edit.key-actions.render
# descr = key-actions tab display -- static hint, or the last action's outcome
# param = $editor_state, $field

## fires on EVERY render regardless of mode [ editor.control.
## get_display_value calls display_override unconditionally ].  while an
## in-frame prompt anchored to THIS field is open [ editor.control.prompt.* --
## the key-create name / passphrase stages ], the row IS the prompt : label +
## live buffer content + cursor, drawn by prompt.render.  otherwise shows a
## short static hint normally, and the LAST create's outcome once one has run
## [ <user-edit.key_actions.last_result>, set by user-edit.
## key_actions.submit_name / .submit_passphrase ].  that scalar is transient
## UI feedback only, never persisted anywhere -- key data is not record data,
## and this is not even key data.
##
## no leading/trailing space here -- render_form's generic body wrap plus its
## pad_l/pad_r framing already supply that for every unfocused field [ the
## same padding-stack lesson plugin.user-edit.key-details.render documents ]

my ( $editor_state, $field ) = @ARG;

my $prompt_display
    = <[editor.control.prompt.render]>->( $editor_state, $field );

return $prompt_display if defined $prompt_display;

my $last_result = <user-edit.key_actions.last_result>;

return sprintf( q|last : %s|, $last_result ) if length( $last_result // '' );

my $in_tab_mode
    = (
    ( $editor_state->{'mode'} // '' ) eq sprintf( qw| plugin:%s |, $field ) );

return q|enter : create a new key .,. r : rename .,. left : back|
    if $in_tab_mode;

return q|[ enter : create a new key .,. r : rename ]|;

