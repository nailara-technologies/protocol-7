## [:< ##

# name  = nshell.render.viewport
# descr = render input line with horizontal scroll when content
#         exceeds terminal width; overflow direction is indicated
#         by configurable marker chars at line edges
#         [ default: '<' left  '>' right, in p7 accent color (p7_fg_0003) ]
#         set nshell.cfg.overflow_marker_left/right = '' to disable markers

my ( $editor, $colors ) = @ARG;

my $buffer     = <[editor.control.get_value]>->( $editor, 'command' )  // '';
my $cursor_pos = <[editor.control.get_cursor]>->( $editor, 'command' ) // 0;

## editor.* state is character-based [ design: position_units ] ; this
## renderer's column math + terminal output is byte-oriented — reconstruct the
## byte view at the boundary, byte-identical to the old AMOS7::TERM path
my $prefix = substr( $buffer, 0, $cursor_pos );
utf8::encode($prefix);
$cursor_pos = length $prefix;
utf8::encode($buffer);

my $buf_len = length($buffer);

## get terminal width [ terminal_size returns ( cols, rows ) ]  prefer cached
## value from SIGWINCH handler; fall back to live query
my $term_cols = $data{'nshell'}{'cfg'}{'term_cols'}
    // ( eval { ( AMOS7::TERM::terminal_size() )[0] } // 80 );
$term_cols = 20 if $term_cols < 20;    ## minimum sanity

## nshell state for view_offset and marker config
my $state_ref   = $data{'nshell'}{'state'}    //= {};
my $view_offset = $state_ref->{'view_offset'} //= 0;

my $marker_color = $colors{'p7_fg_0003'};
my $text_color   = $colors{'p7_fg_0004'};

## ── no overflow: existing minimal render, untouched ──────────────────────
if ( $buf_len < $term_cols ) {
    $state_ref->{'view_offset'} = 0;

    print "\r";
    print $text_color . substr( $buffer, 0, $cursor_pos ) if $cursor_pos > 0;

    my $char_at = substr( $buffer, $cursor_pos, 1 ) // '';
    if ( $char_at eq '' or $char_at eq ' ' ) {
        print $marker_color . '_';
    } else {
        print "\e[7m" . $char_at . "\e[27m";
    }
    print "\e[0m" . $text_color;

    if ( $cursor_pos < $buf_len ) {
        my $after = substr( $buffer, $cursor_pos + 1 );
        print $after if length $after;
        print "\e[K";
        print "\x08" x length($after) if length($after);
    } else {
        print "\e[K";
    }

    STDOUT->flush();
    return;
}

## ── overflow: horizontal scroll viewport ─────────────────────────────────

## configurable marker chars [ '' disables the marker on that side ]
my $ml = $data{'nshell'}{'cfg'}{'overflow_marker_left'}  // '<';
my $mr = $data{'nshell'}{'cfg'}{'overflow_marker_right'} // '>';

## reserve one column so total render never reaches term_cols  printing
## exactly term_cols chars puts the cursor in pending-wrap state, where \e[K]
## wraps to the next line and erases the rightmost marker char
my $available = $term_cols - 1;

## update view_offset to keep cursor visible  reserve space for both potential
## markers  (worst case: available - 2 content)
my $min_content_w = $available - length($ml) - length($mr);
$min_content_w = 4 if $min_content_w < 4;

if ( $cursor_pos - $view_offset > $min_content_w - 1 ) {
    ## cursor beyond right edge: scroll right
    $view_offset = $cursor_pos - $min_content_w + 1;
}
if ( $cursor_pos < $view_offset ) {
    ## cursor before left edge: scroll left with small lookahead
    $view_offset = ( $cursor_pos > 2 ) ? $cursor_pos - 2 : 0;
}
$view_offset = 0 if $view_offset < 0;
$state_ref->{'view_offset'} = $view_offset;

## compute actual marker presence and resulting content width
my $left_w = ( $view_offset > 0 and length $ml ) ? length($ml) : 0;

## assume right marker present, check if content actually extends past view
my $content_w = $available - $left_w - length($mr);
my $has_right = length($mr) && ( $view_offset + $content_w ) < $buf_len;
unless ($has_right) {
    ## no right overflow: reclaim the marker column for content
    $content_w += length($mr);
}

## visible slice of buffer and cursor position within it
my $slice      = substr( $buffer, $view_offset, $content_w );
my $cursor_col = $cursor_pos - $view_offset;    ## 0-indexed within slice
my $char_at    = substr( $buffer, $cursor_pos, 1 ) // '';

## render
print "\r";

## left overflow marker
if ($left_w) {
    print $marker_color . $ml . "\e[0m" . $text_color;
}

## content before cursor
print $text_color . substr( $slice, 0, $cursor_col ) if $cursor_col > 0;

## cursor character [ underscore or inverse video ]
if ( $char_at eq '' or $char_at eq ' ' ) {
    print $marker_color . '_';
} else {
    print "\e[7m" . $char_at . "\e[27m";
}
print "\e[0m" . $text_color;

## content after cursor within viewport
my $after = '';
if ( $cursor_col + 1 < length($slice) ) {
    $after = substr( $slice, $cursor_col + 1 );
}
print $after if length $after;

## right overflow marker
print $marker_color . $mr if $has_right;

print "\e[K";    ## clear any terminal remnants past rendered content

## reposition terminal cursor to just after visual cursor char
## printed: [left_w] [cursor_col content] [cursor:1] [after] [right_w?]
## need to backspace over: after + right marker
my $back = length($after) + ( $has_right ? length($mr) : 0 );
print "\x08" x $back if $back > 0;

STDOUT->flush();
return;

