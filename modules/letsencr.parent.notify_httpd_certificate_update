# name  = letsencr.parent.notify_httpd_certificate_update
# descr = notify httpd zenka that certificate has been
#         updated and needs reload

my $cert_data = shift;

my $domain    = $cert_data->{domain};
my $cert_path = $cert_data->{cert_path};
my $key_path  = $cert_data->{key_path};

unless ( $domain && $cert_path && $key_path ) {
    <[base.log]>
        ->( 1, "error: domain, cert_path, and key_path are required" );
    return {
        status => 'error',
        error  => 'Missing required certificate data'
    };
}

<[base.log]>->( 2, "notifying httpd of certificate update for : $domain" );

## send notification to httpd via Protocol-7 command protocol
## httpd can refresh its loaded certificate cache for this domain
my $notify_cmd = 'httpd.reload-certificate';

my $result = <[base.protocol-7.command.send.local]>->(
    {   'command'   => $notify_cmd,
        'call_args' => {
            'args'  => $domain,
            'param' => {
                'cert_path' => $cert_path,
                'key_path'  => $key_path,
            }
        },
        'reply' => {
            'handler' => qw| letsencr.parent.handler_httpd_reload_reply |,
            'params'  => { 'domain' => $domain }
        }
    }
);

if ($result) {
    <[base.log]>->(
        2, "certificate update notification sent to httpd for: $domain"
    );
    return {
        status => 'success',
        domain => $domain,
        msg    => 'Notification sent to httpd'
    };
} else {
    <[base.log]>->(
        1,
        "warning: failed to notify httpd of certificate update for: $domain"
    );
    return {
        status => 'error',
        error  => 'Failed to send notification to httpd'
    };
}

