## [:< ##

# name = workflow.parent.fix_signatures
# descr = Re-sign source files with invalid signatures in git history

my $params = shift || {};

my $dry_run           = $params->{dry_run}           // 1;  ## Safe by default
my $key_phrase        = $params->{key_phrase}        // '';
my $abort_after_valid = $params->{abort_after_valid} // 13;

<[base.log]>->(
    2, "workflow.fix_signatures: analyzing commits with invalid signatures..."
);

## Ensure history is scanned
my $last_scan = <workflow.history.scanned> // 0;
unless ( $last_scan > 0 ) {
    <[workflow.parent.scan_history]>->(
        {   key_phrase        => $key_phrase,
            abort_after_valid => $abort_after_valid
        }
    );
}

## Find commits with invalid signatures
my @commits_to_fix;

my $issues_ref = <workflow.history.issues> // {};
foreach my $hash ( keys %{$issues_ref} ) {
    my $issue = $issues_ref->{$hash} // next;

    ## Look for signature validation issues
    if (   ( $issue->{type} // '' ) eq 'invalid_signature'
        || ( $issue->{type} // '' ) eq 'missing_signature' ) {
        push @commits_to_fix,
            {
            hash   => $hash,
            commit => $issue->{commit} // {},
            type   => $issue->{type}
            };
    }
}

my $total_to_fix = scalar(@commits_to_fix);

unless ($total_to_fix) {
    <[base.log]>->( 1, "  ✓ No commits need signature fixes" );
    return {
        success => TRUE,
        fixed   => 0,
        message => 'All commits have valid signatures'
    };
}

<[base.log]>->(
    1, sprintf( "  Found %d commits with signature issues", $total_to_fix )
);

if ($dry_run) {
    return {
        success   => TRUE,
        dry_run   => 1,
        would_fix => $total_to_fix,
        commits   => \@commits_to_fix
    };
}

## Execute mode: Re-sign files in history
<[base.log]>->(
    1, "  EXECUTE MODE: Re-signing files in $total_to_fix commits..."
);
<[base.log]>->( 1, "  WARNING: This will rewrite git history!" );

## Load source modules for signing
unless ( exists $code{'source.sign_data'} ) {
    <[base.log]>->( 2, "  Loading source and sourcecode modules..." );
    <[base.load_modules]>->('source');
    <[base.load_modules]>->('sourcecode');
}

## Load signing key
my $sig_key_name = <source.C25519.signature_key_name>
    // qw| proto-7.sourcecode |;
<[base.log]>->( 1, "  Loading signature key '$sig_key_name'..." );

my $key_loaded
    = exists $keys{'C25519'}{$sig_key_name}
    && exists $keys{'C25519'}{$sig_key_name}{'private'}
    && exists $keys{'C25519'}{$sig_key_name}{'public'};

unless ($key_loaded) {
    my $load_success = <[source.load_signature_key]>->($sig_key_name);
    unless ($load_success) {
        return {
            success => FALSE,
            error   => "Failed to load signature key '$sig_key_name'"
        };
    }
}

## Verify private key is loaded
unless ( exists $keys{'C25519'}{$sig_key_name}{'private'} ) {
    return {
        success => FALSE,
        error   =>
            "Signature key '$sig_key_name' missing private key (needed for signing)"
    };
}

<[base.log]>->( 1, "  ✓ Signature key loaded" );

## Get repository path
my $repo_path = <git.cfg.repository_path>;
unless ( -d $repo_path ) {
    return {
        success => FALSE,
        error   => "Repository path not found: $repo_path"
    };
}

## Get list of source files to re-sign
my @source_paths = <[sourcecode.source_path_set_up]>;
unless (@source_paths) {
    return {
        success => FALSE,
        error   => "No source files found to sign"
    };
}

<[base.log]>->(
    1,
    sprintf( "  Will re-sign %d source files per commit",
        scalar @source_paths )
);

## Create tree-filter script that re-signs files
my $filter_script = "$repo_path/.git/workflow-tree-filter-resign.pl";

open my $script_fh, '>', $filter_script or do {
    return {
        success => FALSE,
        error   => "Failed to create filter script: $!"
    };
};

## Write the filter script that will run for each commit
print $script_fh <<'FILTER_SCRIPT_HEAD';
#!/usr/bin/env perl
use strict;
use warnings;

## This script runs in the context of each commit during git filter-branch
## It re-signs all source files using the Protocol-7 system

## Change to repository root (filter-branch runs in .git directory)
chdir $ENV{GIT_WORK_TREE} or exit 1;

## Check if Protocol-7 modules directory exists
exit 0 unless -d 'modules';

## Execute Protocol-7 to update signatures on source files
## Use :sign-silent: to suppress verbose output
$ENV{SIGN_SILENT} = '1';

my $result = system('./bin/Protocol-7', 'sourcecode', 'update-signatures', ':sign-silent:');
my $exit_code = $? >> 8;

## Exit with success even if signing fails (to allow filter-branch to continue)
## Individual file failures will be logged by update-signatures
exit 0;
FILTER_SCRIPT_HEAD

close $script_fh;
chmod 0755, $filter_script;

<[base.log]>->( 1, "  Running git filter-branch to re-sign files..." );
<[base.log]>->( 1, "  This may take several minutes..." );

## Build commit range for filter-branch (only process commits that need fixing)
my @commit_hashes = map { $_->{hash} } @commits_to_fix;
my $oldest_hash   = $commit_hashes[-1];    ## Last in list (oldest)

## Run git filter-branch with tree-filter
my $git_cmd
    = sprintf( 'cd %s && git filter-branch -f --tree-filter %s %s..HEAD 2>&1',
    $repo_path, $filter_script, $oldest_hash );

my $output    = `$git_cmd`;
my $exit_code = $? >> 8;

## Clean up
unlink $filter_script;

if ( $exit_code != 0 ) {
    <[base.log]>->( 0, "  ✗ Git filter-branch failed:" );
    <[base.log]>->( 0, "  $output" );
    return {
        success => FALSE,
        error   => "Git filter-branch failed (exit: $exit_code)",
        output  => $output
    };
}

<[base.log]>->( 1, "  ✓ Git history rewritten successfully" );
<[base.log]>->( 1, "  ✓ Re-signed files in $total_to_fix commits" );
<[base.log]>->(
    1, "  ⚠ Remember to force-push if you've already pushed this branch"
);

return {
    success => TRUE,
    fixed   => $total_to_fix
};

0;

