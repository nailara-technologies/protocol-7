# name  = workflow.load_todos_index
# descr = load or generate todos index

my $todos_index = <workflow.index.todos>;

if (<[workflow.index_needs_regeneration]>->($todos_index)) {
    return <[workflow.generate_todos_index]>;
}

my $index_data;
eval {
    $index_data = YAML::XS::LoadFile($todos_index);
};

if ($@) {
    # If load fails, regenerate
    return <[workflow.generate_todos_index]>;
}

return $index_data;

