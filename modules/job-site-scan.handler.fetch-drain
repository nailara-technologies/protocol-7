## [:< ##

# name  = job-site-scan.handler.fetch-drain
# descr = called when site-yaml fetch queue drains — proceed to assessments

<[base.logs]>->( 1, 'jss: fetch queue drained, proceeding to assessments' );

<[job-site-scan.dispatch.assessments]>;

return;

