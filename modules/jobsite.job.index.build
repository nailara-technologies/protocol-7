## [:< ##

# name  = jobsite.job.index.build
# descr = scan all job status dirs and build in-memory id->status index

my $jobs_root = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite jobs |;

my $index = {};
my @active_statuses
    = qw| new assessed review apply applied interviewed rejected skipped |;
## trash is xz+base32-packed ( .yxz.B32 ), blocked/deleted are plain yaml ##
my %epoch_statuses = (
    blocked => qr/\.yaml$/,
    deleted => qr/\.yaml$/,
    trash   => qr/\.yxz\.B32$/
);

## scan active status dirs ##
for my $status (@active_statuses) {
    my $dir = "$jobs_root/$status";
    next if not -d $dir;
    opendir my $dh, $dir or next;
    for my $fn ( grep { /\.yaml$/ && !/^\./ } readdir($dh) ) {
        my $enc_id = $fn;
        $enc_id =~ s/\.yaml$//;
        my $id = <[base.vax-int.decode]>->($enc_id);
        $index->{$id} = $status;
    }
    closedir $dh;
}

## scan epoch-bucketed dirs ##
for my $status ( keys %epoch_statuses ) {
    my $dir = "$jobs_root/$status";
    next if not -d $dir;
    my $file_re = $epoch_statuses{$status};
    opendir my $dh, $dir or next;
    for my $epoch_dir ( grep { !/^\./ && -d "$dir/$_" } readdir($dh) ) {
        opendir my $edh, "$dir/$epoch_dir" or next;
        for my $fn ( grep { $ARG =~ $file_re && !/^\./ } readdir($edh) ) {
            my $enc_id = $fn;
            $enc_id =~ s/$file_re//;
            my $id = <[base.vax-int.decode]>->($enc_id);
            $index->{$id} = "$status:$epoch_dir";
        }
        closedir $edh;
    }
    closedir $dh;
}

<jobsite.job.index> = $index;

<[base.logs]>->(
    1,
    'jobsite.job.index: built with %d entries',
    scalar keys %{$index}
);

return $index;

