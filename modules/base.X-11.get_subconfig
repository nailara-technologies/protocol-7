## [:< ##

# name = base.X-11.get_subconfig

my ($local_sid) = keys <user.cube.session>->%*;

my $zenka_name
    = ( defined <system.zenka.mode>
        and <system.zenka.mode> eq qw| universal-child | )
    ? qw| universal |
    : <system.zenka.name>;
my $subname  = <system.zenka.subname>;
my $name_str = defined $subname ? "$zenka_name\[$subname]" : $zenka_name;

<[base.log]>->( 1, "requesting $name_str tile tile subcfg" );

my $cmd_id  = <[base.gen_id]>->( $data{'route'} );
my $cube_fh = $data{'session'}{$local_sid}{'handle'};
<[base.net.send_to_socket]>->(
    $cube_fh, "($cmd_id)tile.get_subconfig $name_str\n"
);

## bounded wait for the reply : tile answers this immediately when alive    ##
## [ from its own <tile.subconfig> ], so silence here means tile is offline  ##
## or stuck. without the timeout the readline blocks the event loop forever  ##
## -> zenka start-up timeout. on timeout return undef so the caller falls    ##
## back to defaults. each received line re-arms the wait. configurable.      ##
my $read_timeout = <x11.subconfig_read_timeout> // 3;
my $fd_mask      = '';
vec( $fd_mask, fileno($cube_fh), 1 ) = 1;

my $reply_string;
my $matched_reply = 0;
while ( !$matched_reply ) {
    if ( !select( my $rout = $fd_mask, undef, undef, $read_timeout ) ) {
        <[base.logs]>->(
            1, 'tile subconfig request timed out [%ss] -- using fallback',
            $read_timeout
        );
        return undef;
    }
    $reply_string  = readline($cube_fh);
    $matched_reply = 1 if $reply_string =~ m{^\($cmd_id\)(SIZE|FALSE) };
    if ( !$matched_reply ) {
        $data{'session'}{$local_sid}{'buffer'}{'input'} .= $reply_string;
    }
}

my $subcfg_data = {};
if ( $reply_string =~ m|^\($cmd_id\)SIZE (\d+)\n$| ) {
    my $bytes_to_go = $1;
    my $bytes_total = $bytes_to_go;
    if ( !$bytes_to_go ) {
        <[base.log]>->(
            2, "tile subconfig for '$name_str' was empty [ 0 bytes ]"
        );
        return {};
    }
    my $buffer = '';
    while ($bytes_to_go) {
        my $bytes = read( $cube_fh, $buffer, $bytes_to_go, length($buffer) );
        $bytes_to_go -= $bytes if defined $bytes;
    }
    chop($buffer);
    foreach my $cfg_line ( split( m|\n|, $buffer ) ) {
        my ( $c_key, $c_val ) = split( m| +\= |, $cfg_line, 2 );
        $subcfg_data->{$c_key} = $c_val;
    }
    <[base.log]>->(
        1,
        "received tile group subconfig for '$name_str' [$bytes_total bytes]"
    );
    return $subcfg_data;
} elsif (
    $reply_string =~ m|^\($cmd_id\)FALSE no set-up for zenka '([^ ]+)'| ) {
    <[base.logs]>->(
        ": << tile zenka has no set-up for '%s' >>",
        ${^CAPTURE}[0]
    );
    return undef;

} elsif ( $reply_string eq
    <[base.sprint_t]>->( qw| IRW7V6A |, sprintf( qw| (%d) |, $cmd_id ) ) ) {
    <[base.logs]>->( ": << get_subconfig [ FALSE ] >> for '%s'", $name_str );
    return undef;
} else {
    <[base.logs]>->(
        1,
        "[ protocol mismatch ] not expected reply"
            . " from tile zenka ['%s']",
        $reply_string
    );
    return undef;
}

