## [:< ##

# name  = kimi.cmd.reject
# descr = reject a pending tool call request

my $request_id = $$call{'args'} // '';

if ( not length $request_id ) {
    return { 'mode' => qw| false |, 'data' => 'request id required' };
}

my $pend = delete <kimi.approval.pending>->{$request_id};
if ( not defined $pend ) {
    return {
        'mode' => qw| false |,
        'data' => "no pending approval for $request_id"
    };
}

<[kimi.wire.approval_respond]>->( $request_id, 'reject' );

return {
    'mode' => qw| true |,
    'data' =>
        sprintf( 'rejected %s [ %s ]', $request_id, $pend->{'action'} // '' )
};

