## [:< ##

# name  = decoder.zenka.receive_entropy
# descr = Receive entropy from zulum and accumulate into level-5 buffer

my $params    = shift                  // {};
my $stream_id = $params->{'stream_id'} // $ARG[0];
my $entropy   = $params->{'entropy'}   // $ARG[1];

return { 'mode' => qw| false |, 'data' => 'missing stream_id' }
    unless defined $stream_id;
return { 'mode' => qw| false |, 'data' => 'missing entropy' }
    unless defined $entropy;

## Get level-5 state ##
my $L5 = <decoder.level5>;

## Add 42-bit entropy to accumulator ##
$L5->{'accumulator'} .= $entropy;
$L5->{'bit_count'} += length($entropy);

## Extract 5-bit chunks (base32) ##
while ( $L5->{'bit_count'} >= 5 ) {
    my $chunk = substr( $L5->{'accumulator'}, 0, 5, '' );
    $L5->{'bit_count'} -= 5;

    ## Convert 5 bits to base32 value (0-31) ##
    my $val = oct("0b$chunk");
    push @{ $L5->{'values'} }, $val;

    ## Add to buffer for display ##
    <[base.buffer.add_line]>->(
        qw| level-5-B32 |,
        sprintf( "value: %02d [stream %s]", $val, $stream_id ),
        2    ## log level 2 ##
    );
}

## Log accumulation ##
<[base.log]>->(
    2,          "[decoder] stream %d: +42 bits, total values: %d",
    $stream_id, scalar( @{ $L5->{'values'} } )
);

return {
    'mode' => qw| true |,
    'data' => {
        'stream_id'    => $stream_id,
        'values_added' => int( length($entropy) / 5 ),
        'total_values' => scalar( @{ $L5->{'values'} } ),
        'pending_bits' => $L5->{'bit_count'},
    }
};

