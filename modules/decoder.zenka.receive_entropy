## [:< ##

# name  = decoder.zenka.receive_entropy
# descr = Receive 42-bit entropy frame — boundary detection, B32, D3, vterm

my $params    = shift                  // {};
my $stream_id = $params->{'stream_id'} // $ARG[0];
my $entropy   = $params->{'entropy'}   // $ARG[1];

return { 'mode' => qw| false |, 'data' => 'missing stream_id' }
    unless defined $stream_id;
return { 'mode' => qw| false |, 'data' => 'missing entropy' }
    unless defined $entropy;

## reconstruct harmonic decimal value from 42-bit binary string ##
my $decimal = oct("0b$entropy");

## passive boundary detection — PYTAURAZUMA canvas-clean at 769230 ##
if ( $decimal == 769230 ) {
    <[protocol-7.route-send]>->(
        {   'command'   => 'decoder.handler.on-boundary',
            'call_args' => { 'args' => "$stream_id 769230" },
        }
    );
}

## feed raw entropy bytes into Term::VTerm for ANSI/sequence parsing ##
if ( defined $data{'decoder'}{'vterm'} ) {
    $data{'decoder'}{'vterm'}->input_write( pack 'B42', $entropy );
}

## level-5 : extract 5-bit chunks → base32 values ##
my $L5 = <decoder.level5>;
$L5->{'accumulator'} .= $entropy;
$L5->{'bit_count'} += 42;

my $chunks_added = 0;
while ( $L5->{'bit_count'} >= 5 ) {
    my $chunk = substr( $L5->{'accumulator'}, 0, 5, '' );
    $L5->{'bit_count'} -= 5;
    my $val = oct("0b$chunk");
    push @{ $L5->{'values'} }, $val;
    $chunks_added++;
    <[base.buffer.add_line]>->(
        qw| level-5-B32 |,
        sprintf( "%02d [ stream %s ]", $val, $stream_id ), 2
    );
}

## level-6 : accumulate 3 decimal digits → unicode codepoint ##
$data{'decoder'}{'level6_acc'} //= '';
$data{'decoder'}{'level6_acc'} .= sprintf '%d', $decimal;
while ( length( $data{'decoder'}{'level6_acc'} ) >= 3 ) {
    my $code_point = 0 + substr( $data{'decoder'}{'level6_acc'}, 0, 3 );
    $data{'decoder'}{'level6_acc'}
        = substr( $data{'decoder'}{'level6_acc'}, 3 );
    my $unicode_char = chr($code_point);
    <[base.buffer.add_line]>->(
        qw| level-6-D3 |,
        join( ' ', sprintf( "%03d", $code_point ), $unicode_char ), 0
    );
}

<[base.log]>->(
    2, "decoder stream %s : decimal %d : +%d B32 chunks",
    $stream_id, $decimal, $chunks_added
);

return {
    'mode' => qw| true |,
    'data' => {
        'stream_id'    => $stream_id,
        'decimal'      => $decimal,
        'boundary'     => ( $decimal == 769230 ) ? TRUE : FALSE,
        'chunks_added' => $chunks_added,
        'total_values' => scalar( @{ $L5->{'values'} } ),
        'pending_bits' => $L5->{'bit_count'},
    }
};

