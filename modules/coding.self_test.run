## [:< ##

# name  = coding.self_test.run
# descr = start async model self-test cycle : timer-driven probe state machine

my $params   = shift                 // {};
my $model_id = $params->{'model_id'} // '';
## 30s was fine before max_tokens was raised to 4096 for a full <think>     ##
## pass - now a deep reasoning trace + this server's prompt-cache rebuild   ##
## overhead [ confirmed live : "prompt cache save took 295.08 ms", repeated ##
## cache invalidation on every follow-up call ] can push a real,            ##
## still-working request past 30s. the client giving up and disconnecting   ##
## surfaces server-side as a cancelled task ["srv stop: cancel task"],      ##
## which we then see as http_500 - not a crash, a timeout mismatch. BUT:    ##
## duration alone doesn't fully explain it - a 69.27s success and a still-  ##
## failing-past-120s run in the same session mean pushing this further has  ##
## diminishing returns. suspected real cause: this client uses stream=false ##
## [ one silent read for the whole generation ], while the proven-stable    ##
## async path [ coding.async.http_client ] streams - a stall/idle cutoff    ##
## independent of total duration is the more likely culprit than total wait ##
## time. 90s as a reasonable middle ground pending that experiment - not    ##
## chasing the timeout further for now [ ondemand zenki don't have          ##
## heartbeat/restart yet, so blocking isn't an active hazard today, but     ##
## shouldn't be pushed needlessly high either ]                             ##
##                                                                          ##
## UPDATE 2026-07-31 [ async transport rewrite ] : hypothesis CONFIRMED -   ##
## with stream=true the http_500s stopped entirely ; the old 500s were      ##
## LWP's inactivity timeout disconnecting mid-generation. this module now   ##
## only STARTS the test : the actual cycle runs non-blocking in             ##
## coding.self_test.handler.poll_probe via coding.self_test.async_probe     ##
my $timeout = $params->{'timeout'} // 90;
my $backend = $params->{'backend'} // 'gpu';
my $url     = $params->{'url'}
    // ( <inference.backend.http_server_url> // 'http://127.0.0.1:8000' );

return { mode => qw| false |, data => 'model_id required' }
    if !length $model_id;

## transport is now async : the result is delivered to this continuation as ##
## { mode => all_passed ? true : false, data => $summary } - the same shape ##
## this module used to return synchronously                                 ##
my $on_done = $params->{'on_done'};
return {
    mode => qw| false |,
    data => 'on_done coderef required [ async self-test transport ]'
    }
    if ref $on_done ne qw| CODE |;

## idempotency guard : a second self-test starting while one is in flight   ##
## would race the probe state machine on the same backend [ same exposure   ##
## class as the verify_inference_startup stacked-timer bug - multiple paths ##
## each scheduling their own lifecycle with no cancellation ]               ##
return { mode => qw| false |, data => 'self-test already in progress' }
    if <coding.self_test_probe_in_flight>;

my $ntime = <[base.ntime]>;

<[base.logs]>->( 1, '[self_test] starting : model %s', $model_id );

## calibration prompt sequence  each prompt carries a result_constraint - ##
## the structural-check rule coding.self_test.check_constraint enforces   ##
## deterministically (no inference call) before any tier-1 reformat or    ##
## tier-2 semantic judgment                                               ##
my @prompts = (
    {   id                => 1,
        text              => 'What is 7 × 13? Reply with only the number.',
        expected          => '91',
        result_constraint => { type => 'numeric', must_contain => ['91'] },
    },
    {   id   => 2,
        text => 'put a cat and a mouse in a room, close the '
            . 'door and wait.., who is the remaining animal?',
        ## no "reply with only the animal name" - forcing terseness up      ##
        ## front can short-circuit this reasoning model's <think> pass into ##
        ## a pattern-matched guess. let it answer naturally ; tier1's       ##
        ## existing "restate in <=2 words" reformat step already exists to  ##
        ## compress a verbose-but-substantively-correct answer down, per    ##
        ## the original design [ data/tasks/completed/                      ##
        ## coding-model-self-test-cycle.md : "the cat is the remaining      ##
        ## animal" instead of "cat" - both substantively CORRECT ]          ##
        expected          => 'cat',
        result_constraint => {
            type         => 'word_count',
            max_words    => 2,
            must_contain => 'cat',
            ## tier1 reformat nudge : common failure mode is naming the     ##
            ## eaten animal because it's still physically "there" [ a body  ##
            ## / remains ] - only surfaced as a follow-up challenge on a    ##
            ## wrong first answer, never in the base prompt [ that would    ##
            ## hand over the answer up front ]. short + Socratic rather     ##
            ## than explanatory : a prior, longer "consider: when one       ##
            ## animal eats the other..." version was confirmed live to do   ##
            ## nothing - the model just reformatted its wrong answer to fit ##
            ## the word limit instead of reconsidering it                   ##
            mismatch_hint =>
                q{Are you certain? "Remaining" can only be one, by }
                . 'definition.',
        },
    },
    {   id   => 3,
        text => 'put a cat and a mouse in a room, close the door and wait.., '
            . 'who is the remaining animal? Reply with only the '
            . 'animal name (at most 2 words).',
        ## primed sibling of prompt 2 : same riddle, but the word-limit is  ##
        ## stated UP FRONT instead of only surfacing via tier1's reformat   ##
        ## step. prompt 2 deliberately withholds it [ see its own comment - ##
        ## forcing terseness up front can short-circuit the <think> pass    ##
        ## into a pattern-matched guess ] specifically to test reasoning    ##
        ## under free-form conditions; this variant tests the opposite      ##
        ## question - does the model answer correctly when it KNOWS the     ##
        ## format constraint from the start, without needing any reformat   ##
        ## round at all. NOT designed to be adversarial or to sometimes     ##
        ## fail on purpose : id 3 participates in the same all_passed /     ##
        ## switch-model accept-reject gate as prompts 1-2 [ see             ##
        ## coding.self_test.handler.poll_switch ], so it must stay a fair,  ##
        ## normally-passing check like prompt 1, not a probe engineered to  ##
        ## flip pass/fail - that distinction is what keeps this additive    ##
        ## rather than a new way to spuriously reject a model switch. does  ##
        ## NOT reuse prompt_id 2 : coding.handler.monitor_inference_startup ##
        ## 's seed-restart-on-failure loop is hardcoded to prompt_id == 2   ##
        ## specifically, and coding.self_test.archive keys its per-prompt   ##
        ## store by prompt_id, so a collision would either wrongly trigger  ##
        ## that restart loop or silently overwrite prompt 2's own record    ##
        expected          => 'cat',
        result_constraint => {
            type         => 'word_count',
            max_words    => 2,
            must_contain => 'cat',
        },
    },
);

$data{'coding'}{'self_test_probe_state'} //= {};
my $probe_id = <[base.gen_id]>->( $data{'coding'}{'self_test_probe_state'} );

$data{'coding'}{'self_test_probe_state'}{$probe_id} = {
    'model_id'   => $model_id,
    'url'        => $url,
    'backend'    => $backend,
    'timeout'    => $timeout,
    'ntime'      => $ntime,
    'started'    => <[base.time]>->(3),
    'prompts'    => \@prompts,
    'idx'        => 0,                    ## which prompt we are on ##
    'phase'      => qw| gap |,
    'gap_until'  => 0,
    'results'    => [],
    'pass_count' => 0,
    'test_count' => 0,
    'all_passed' => TRUE,
    'on_done'    => $on_done,             ## caller continuation ##
};

<coding.self_test_probe_in_flight> = TRUE;

<[event.add_timer]>->(
    {   'interval' => 0.5,
        'repeat'   => TRUE,
        'handler'  => qw| coding.self_test.handler.poll_probe |,
        'data'     => { 'probe_id' => $probe_id },
        'desc'     => "self-test probe $probe_id"
    }
);

return { mode => qw| deferred | };

