## [:< ##

# name = coding.routing.get_model_metadata
# descr = Fetch model metadata from models zenka for routing decisions

my ($model_alias) = @ARG;

<[base.logs]>->( 1, "[coding.routing] get_model_metadata: %s", $model_alias );

<[base.perlmod.autoload]>->(qw| JSON::PP |);

my $response = <[base.protocol-7.command.send.local]>->(
    {   'command'   => "models.get_model_path",
        'call_args' => { 'model_id' => $model_alias }
    }
);

return undef
    unless $response && ref($response) eq 'HASH' && $response->{data};

my $model_data;
eval { $model_data = JSON::PP::decode_json( $response->{data} ); };
return undef unless $model_data && ref($model_data) eq 'HASH';

return $model_data;

