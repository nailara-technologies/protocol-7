# name = image-batch.parent.handle_job_reply
# descr = Handle analysis results from child and update job/batch state

my $reply_data     = shift;
my $handler_params = shift;

my $job_id   = $handler_params->{job_id};
my $batch_id = $handler_params->{batch_id};

return { success => FALSE, error => 'job_id required' }
    unless defined $job_id;
return { success => FALSE, error => 'batch_id required' }
    unless defined $batch_id;

my $batch_state = <image-batch.batch_state>;

# Update job result in jobqueue
if ( $reply_data->{success} ) {
    <[jobqueue.move_job]>->( $job_id, 'completed' );
    $batch_state->{statistics}->{completed}++;

    if ( $reply_data->{metrics}->{overall_grade} ) {
        my $grade = $reply_data->{metrics}->{overall_grade};
        $batch_state->{statistics}->{grade_distribution}->{$grade}++;
    }

    <[base.log]>->(
        2,
        sprintf(
            'Job %s completed [grade: %s]',
            $job_id, $reply_data->{metrics}->{overall_grade}
        )
    );
} else {
    <[jobqueue.move_job]>->( $job_id, 'failed' );
    $batch_state->{statistics}->{failed}++;

    <[base.log]>->(
        1,
        sprintf( 'Job %s failed [error: %s]', $job_id, $reply_data->{error} )
    );
}

# Check if all jobs are complete
my $job_count = <jobqueue.joblist.count>;
my $completed = $job_count->{completed} // 0;
my $failed    = $job_count->{failed}    // 0;
my $total     = $batch_state->{total_images};

if ( $completed + $failed == $total ) {
    $batch_state->{status} = 'completed';
    <[base.log]>->(
        1,
        sprintf(
            'Batch %s complete: %d/%d succeeded, %d failed',
            $batch_id, $completed, $total, $failed
        )
    );
}

# jobqueue.move_job() triggers counter watcher, which dispatches next job automatically

return { success => TRUE, message => "Job result processed: $job_id" };

