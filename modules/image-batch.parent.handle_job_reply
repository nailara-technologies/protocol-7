# name = image-batch.parent.handle_job_reply
# descr = Handle Protocol-7 responses from child process with analysis results, dispatch next job

<[base.perlmod.load]>->( 'Storable', qw| thaw | );

my $reply = shift;

my $batch_state = <image-batch.batch_state>;

return unless defined $batch_state;

my $job_id = $reply->{'params'}->{'job_id'};

# Thaw the serialized response from child
my $response;
my $had_error = 0;

if ( $reply->{'cmd'} ne qw| FALSE | ) {
    eval {
        my $data_str = $reply->{'data'};
        $data_str =~ s|\n$||;
        ($response) = thaw($data_str);
    };

    if ($@) {
        <[base.log]>->(
            1, "ERROR: Failed to deserialize child response for $job_id: $@"
        );
        $had_error = 1;
    }
} else {
    my $error_msg = $reply->{'call_args'}->{'args'} // 'Unknown error';
    <[base.log]>
        ->( 1, "ERROR: Child command failed for $job_id: $error_msg" );
    $had_error = 1;
}

# Update job status in jobqueue
if ( !$had_error && defined $response ) {
    <[jobqueue.move_job]>->( $job_id, 'completed' );

    # Update statistics
    $batch_state->{statistics}->{completed}++;

    # Record overall grade distribution
    if ( defined $response->{metrics}->{overall_grade} ) {
        my $grade = $response->{metrics}->{overall_grade};
        $batch_state->{statistics}->{grade_distribution}{$grade}++;
    }

    # Log successful completion
    <[base.log]>->(
        2,
        sprintf(
            "Job %s completed: %s (grade: %s)",
            $job_id,
            $response->{image_path},
            $response->{metrics}->{overall_grade} // 'N/A'
        )
    );
} else {
    <[jobqueue.move_job]>->( $job_id, 'failed' );

    # Update statistics
    $batch_state->{statistics}->{failed}++;

    # Log failure
    <[base.log]>->( 1, sprintf( "Job %s FAILED", $job_id ) );
}

# Get next job from queue and send to child
my $next_job = <[jobqueue.get_next_job]>->('queued');

if ( defined $next_job ) {
    <[jobqueue.move_job]>->( $next_job->{job_id}, 'processing' );

    # Send next job to child
    <[base.protocol-7.command.send.local]>->(
        {   'command'   => "child.analyze_image",
            'call_args' => {
                'args' => sprintf( "%s %s",
                    $next_job->{image_path},
                    $next_job->{job_id} )
            },
            'reply' => {
                'handler' => 'image-batch.parent.handle_job_reply',
                'params'  => { 'job_id' => $next_job->{job_id} }
            }
        }
    );

    <[base.log]>->(
        2,
        sprintf(
            "Next job assigned to child: %s (%s)",
            $next_job->{job_id}, $next_job->{image_path}
        )
    );
} else {

    # No more jobs - check if batch is complete
    my $completed_count = <[jobqueue.count]>->('completed') // 0;
    my $failed_count    = <[jobqueue.count]>->('failed')    // 0;
    my $total_count     = $batch_state->{total_images};

    if ( $completed_count + $failed_count == $total_count ) {
        $batch_state->{status}       = 'completed';
        $batch_state->{completed_at} = <[base.time]>->(3);

        my $summary = sprintf(
            'Batch completed: %d total, %d successful, %d failed',
            $total_count,
            $batch_state->{statistics}->{completed},
            $batch_state->{statistics}->{failed}
        );

        <[base.log]>->( 0, $summary );
    } else {
        <[base.log]>->(
            1,
            sprintf(
                'All jobs processed: %d completed, %d failed, %d of %d total',
                $completed_count,                 $failed_count,
                $completed_count + $failed_count, $total_count
            )
        );
    }
}

