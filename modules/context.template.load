## [:< ##

# name  = context.template.load
# descr = load named context template from yaml

my $name = shift // return undef;

## check cache first ##
if ( exists <context.templates>->{$name} ) {
    return <context.templates>->{$name};
}

## resolve template file ##
my $template_dir = <context.cfg.template_dir>;
my $path         = "$template_dir/$name.yaml";

unless ( -f $path and -r $path ) {
    <[base.logs]>->( 0, ': context template not found [ %s ]', $path );
    return undef;
}

## load yaml ##
my ( $template, $err ) = <[format.yaml.load_file]>->($path);

if ( defined $err or not defined $template ) {
    <[base.logs]>->(
        0,     ': context template parse error [ %s ]: %s',
        $name, $err // 'empty'
    );
    return undef;
}

## validate required fields ##
unless (defined $template->{'name'}
    and defined $template->{'sections'}
    and ref $template->{'sections'} eq qw| ARRAY | ) {
    <[base.logs]>->(
        0, ': context template invalid [ %s ]: missing name or sections',
        $name
    );
    return undef;
}

## set defaults ##
$template->{'budget'} //= <context.cfg.default_budget>;

## cache for reuse ##
<context.templates>->{$name} = $template;

<[base.logs]>->(
    2,     ': context template loaded [ %s ] [ %d sections ]',
    $name, scalar $template->{'sections'}->@*
);

return $template;

