## [:< ##

# name  = letsencr.base.pre_init
# descr = pre-initialization for Let's Encrypt ACME client zenka - load required libraries

<[base.log]>->( 2, 'letsencr pre-initialization: loading ACME libraries..,' );

## load ACME-required libraries
## [ Crypt::Ed25519 loaded via crypt.C25519 module ]
## [ CSR certificate generation via OpenSSL CLI ]
<[base.perlmod.autoload]>->('JSON::XS');
<[base.perlmod.autoload]>->('LWP::UserAgent');
<[base.perlmod.autoload]>->('LWPx::ParanoidAgent');
<[base.perlmod.autoload]>->('Encode');
<[base.perlmod.autoload]>->('MIME::Base64'); ## base64url encoding for JWK
<[base.perlmod.autoload]>->('Digest::SHA');  ## SHA hashing for JWK thumbprint

## load RSA libraries for RS256 ACME support
<[base.perlmod.autoload]>->('Crypt::OpenSSL::RSA');    ## RSA key generation
##                                                               and signing

<[base.perlmod.autoload]>->('Crypt::OpenSSL::Random'); ## entropy for RSA
##                                                             generation

## Validate ACME server configuration
if ( not defined <letsencr.acme.server> ) {
    <[base.log]>->( 0, ": warning : LETSENCRYPT ACME server not configured" );
}

if ( not defined <letsencr.admin.email> ) {
    <[base.log]>->( 0, ": warning : LETSENCRYPT admin email not configured" );
}

## Note: Certificate directories are created/validated in init_code after
## config is loaded

<[base.log]>->( 2, 'letsencr pre-init complete' );

0;

