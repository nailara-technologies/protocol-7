## [:< ##

# name  = nameserv.cmd.list-zones
# descr = list all loaded zones

my $zones = <nameserv.zones>;

if ( not keys %$zones ) {
    return { mode => 'true', data => 'no zones loaded' };
}

my @lines = ( sprintf( "loaded zones (%d):", scalar keys %$zones ) );

for my $zone_name ( sort keys %$zones ) {
    my $zone      = $zones->{$zone_name};
    my $rec_count = scalar @{ $zone->{'records'} // [] };
    push @lines,
        sprintf( "  %s: %d records (serial %d)",
        $zone_name, $rec_count, $zone->{'serial'} );
}

return { mode => 'size', data => join( "\n", @lines ) };

