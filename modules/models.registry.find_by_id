## [:< ##

# name  = models.registry.find_by_id
# param = <model_id>
# descr = Find model entry in registry by model_id
# return = model entry hashref or undef if not found

my $model_id = shift;

unless ( defined $model_id && length $model_id ) {
    <[base.s_warn]>->('model_id required');
    return undef;
}

my $registry = <models.registry> // {};

unless ( keys $registry->%* ) {
    <[base.logs]>->( 2, '[registry.find_by_id] registry is empty' );
    return undef;
}

## Search registry for matching model_id
foreach my $entry ( values $registry->%* ) {
    if ( ($entry->{'model_id'} // '') eq $model_id ) {
        <[base.logs]>->(
            1, '[registry.find_by_id] found model: %s',
            $model_id
        );
        return $entry;
    }
}

<[base.logs]>->(
    2, '[registry.find_by_id] model not found: %s',
    $model_id
);
return undef;

