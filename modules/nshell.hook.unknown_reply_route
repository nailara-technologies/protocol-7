# name  = nshell.hook.unknown_reply_route
# descr = Intercept replies with unknown route IDs and display to user

my ($msg_data) = @ARG;

return FALSE unless defined $msg_data;

my $cmd    = $msg_data->{'cmd'};
my $cmd_id = $msg_data->{'cmd_id'};

## Format and display the unknown reply to user
my $output
    = sprintf(
    "\n[nshell: unknown reply] %s-reply to unknown route id [%d]\n",
    $cmd, $cmd_id );

print $output;
$| = 1;    ## flush immediately

return TRUE;    ## we handled it

