## [:< ##
# name  = pager.editor.get_line
# descr = get formatted line from pager for editor display

## delegates to pager.editor.integration get_line action ##

return sub {
    my ($args) = @_;

    return <[pager.editor.integration]>->(
        {   'action'    => 'get_line',
            'buffer_id' => $args->{'buffer_id'},
            'line'      => $args->{'line'},
        }
    );
};

