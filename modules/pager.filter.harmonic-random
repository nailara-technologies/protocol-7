## [:<
# name  = pager.filter.harmonic-random
# descr = Harmonic distribution randomization for "pleasant" ordering
## >:]

return sub {
    my ($args) = @_;
    my $items = $args->{'items'};
    my $params = $args->{'params'} // {};

    return $items unless @$items > 1;

    my $seed = $params->{'seed'} // int(rand(1000000));
    my $strength = $params->{'strength'} // 1.0;  # 0.0 = no random, 1.0 = full harmonic

    # Store seed for reproducibility
    $params->{'_last_seed'} = $seed;

    # Create harmonic weights: 1, 1/2, 1/3, 1/4, ..., 1/N
    my @weights = map { 1.0 / ($_ + 1) } 0 .. $#$items;

    # Shuffle indices with reproducible seed
    srand($seed);
    my @indices = (0 .. $#$items);

    # Fisher-Yates shuffle
    for my $i (reverse 1 .. $#indices) {
        my $j = int(rand($i + 1));
        @indices[$i, $j] = @indices[$j, $i];
    }

    # Create harmonic priority: items get priority based on harmonic weight
    # Higher weight = earlier in list (but shuffled)
    my @scored;
    for my $i (0 .. $#indices) {
        my $idx = $indices[$i];
        my $harmonic_score = $weights[$i];

        # Mix with original position based on strength
        my $original_score = 1.0 - ($idx / scalar(@$items));
        my $final_score = ($harmonic_score * $strength) +
                          ($original_score * (1.0 - $strength));

        push @scored, {
            'item'  => $items->[$idx],
            'score' => $final_score,
            'idx'   => $idx,
        };
    }

    # Sort by final score (descending)
    @scored = sort { $b->{'score'} <=> $a->{'score'} } @scored;

    # Extract items in new order
    my @result = map { $_->{'item'} } @scored;

    # Mark items with their harmonic position for reference
    for my $i (0 .. $#result) {
        $result[$i]{'_harmonic_pos'} = $i;
        $result[$i]{'_harmonic_score'} = $scored[$i]{'score'};
    }

    return \@result;
};

