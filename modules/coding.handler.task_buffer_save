# name  = coding.handler.task_buffer_save
# descr = timer handler: save buffers for recently completed tasks

my @completed = keys %{ <coding.task.completed_ids> // {} };

if ( !@completed ) {
    <[base.logs]>->( 2, "task_buffer_save: no completed tasks to save" );
    return TRUE;
}

for my $task_id (@completed) {
    <[base.logs]>->( 1, "task_buffer_save: saving buffers for %s", $task_id );
    <[coding.task.save_buffers]>->($task_id);
}

## clear the save timer handle ##
delete <coding.timer.task_buffer_save>;

return TRUE;

