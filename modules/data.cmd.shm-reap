## [:< ##

# name  = data.cmd.shm-reap
# param = [ttl-seconds]
# descr = on-demand TTL safety-net sweep of stale SHM segments

my $args = $call->{'args'} // '';
$args =~ s|^\s+||;
$args =~ s|\s+$||;

my $ttl;
$ttl = $args if length $args and $args =~ m|^\d+$|;

my $summary = <[data.mount.shm.reap]>->($ttl);

my $output = sprintf(
    "\n: SHM TTL reap summary\n:\n"
        . ": scanned .............. %d\n"
        . ": reaped ............... %d\n"
        . ": skipped fresh ........ %d\n"
        . ": skipped other owner .. %d\n"
        . ": skipped unreadable ... %d\n:\n",
    $summary->{'scanned'}             // 0,
    $summary->{'reaped'}              // 0,
    $summary->{'skipped_fresh'}       // 0,
    $summary->{'skipped_other_owner'} // 0,
    $summary->{'skipped_unreadable'}  // 0,
);

return { 'mode' => qw| size |, 'data' => $output };

