## [:< ##

# name  = base.gtk.ensure_display
# descr = point gdk at the xwayland display and initialise gtk once, so
#         in-process gdk queries [ monitor enumeration / selection ] work
#         BEFORE the window is created -- eg. from a coordinate-resolved
#         geo_ready continuation that needs to shape a monitor-aware
#         fallback. idempotent. requires <x11.display> [ base.X-11.get_display ].

$ENV{'DISPLAY'}     = <x11.display>;
$ENV{'GDK_BACKEND'} = 'x11';           ## force XWayland under WSL|Wayland ##
delete $ENV{'WAYLAND_DISPLAY'};

## sane themed cursor under minimal xwayland|wsl [ see window.place ] ##
$ENV{'XCURSOR_THEME'} //= 'Adwaita';
$ENV{'XCURSOR_SIZE'} = '24';

<[base.perlmod.autoload]>->('Gtk3');

Gtk3->init if not <base.gtk.inited>;
<base.gtk.inited> = TRUE;

return TRUE;

