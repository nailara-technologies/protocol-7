## [:< ##

# name  = workflow.console.harmonize-emails
# param = [execute] [key_phrase]
# descr = standardize author names and email addresses across git history with optional key phrase filter (aborts after 13 consecutive valid)

my $param1 = shift // '';
my $param2 = shift // '';

## Determine execute mode and key phrase
my $dry_run = 1;
my $key_phrase = '';

if ($param1 eq 'execute') {
    $dry_run = 0;
    $key_phrase = $param2;
} elsif (length $param1) {
    $key_phrase = $param1;
}

<[base.log]>->( 1, "Harmonizing author names and email addresses in git history..." );

if (length $key_phrase) {
    <[base.log]>->( 1, "  Filtering by key phrase: '$key_phrase'" );
}

if ($dry_run) {
    <[base.log]>->( 1, "DRY RUN mode - use 'harmonize-emails execute [key_phrase]' to apply changes" );
}

## Trigger harmonization
my $result = <[workflow.parent.harmonize_emails]>->({
    dry_run => $dry_run,
    key_phrase => $key_phrase,
    abort_after_valid => 13
});

if ($result->{dry_run}) {
    my $count = $result->{would_change} || 0;

    if ($count == 0) {
        return say "::\n: ✓ All author names and email addresses are already canonical\n::";
    }

    my @output;
    push @output, "::";
    push @output, ": Identity Harmonization Analysis (DRY RUN)";
    push @output, ":";
    push @output, sprintf(": Commits needing changes: %d", $count);
    push @output, ":";

    if (%{$result->{email_mapping} || {}}) {
        push @output, ": Proposed email mappings:";
        foreach my $variant (sort keys %{$result->{email_mapping}}) {
            my $info = $result->{email_mapping}{$variant};
            push @output, sprintf(":   %s → %s (%d commits)",
                $variant, $info->{canonical}, $info->{commits});
        }
        push @output, ":";
    }

    if (%{$result->{author_mapping} || {}}) {
        push @output, ": Proposed author mappings:";
        foreach my $variant (sort keys %{$result->{author_mapping}}) {
            my $info = $result->{author_mapping}{$variant};
            push @output, sprintf(":   %s → %s (%d commits)",
                $variant, $info->{canonical}, $info->{commits});
        }
        push @output, ":";
    }

    push @output, ": To apply changes:";
    push @output, ":   workflow harmonize-emails execute [key_phrase]";
    push @output, "::";

    return say join("\n", @output);
}

unless ($result->{success}) {
    my $error = $result->{error} || 'unknown error';
    return say "::\n: ✗ Harmonization failed: $error\n::";
}

my $changed = $result->{changed} || 0;
return say "::\n: ✓ Harmonized $changed commits\n::";

