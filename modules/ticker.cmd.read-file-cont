## [:< ##

# name  = ticker.cmd.read-file-cont
# param = <path>
# descr = update ticker from file in continuous scroll mode

my $file_path = $call->{'args'};

## a read_file can arrive before the window is sized -- <ticker.font.size> ##
## is 0 until the first draw callback computes it from the real window     ##
## height, and parse_text dies on a 0 font size. defer instead of         ##
## crashing; ticker.callback.draw replays the queue once initialized.     ##
if ( not <ticker.status.initialized> ) {
    push @{ <ticker.pending_read_calls> //= [] }, $call;
    <[base.logs]>->(
        1, ': read_file received before window initialized, deferring [ %s ]',
        $file_path
    );
    return {
        'mode' => qw| true |,
        'data' => 'deferred, window not yet initialized'
    };
}

my $loaded = <[ticker.load_file_content]>->($file_path);

if ( defined $loaded->{'error'} ) {
    <[base.log]>->(
        0, "[$call->{'session_id'}] $loaded->{'error'} [ $file_path ]"
    );
    return { 'mode' => qw| false |, 'data' => $loaded->{'error'} };
}

<ticker.display.mode> = qw| continuous |;
delete <ticker.notify.dismissed>;

<[ticker.emit_event]>->(qw| shown |) if <ticker.hidden>;
<ticker.hidden> = FALSE;

if (<ticker.paused>) {
    <ticker.paused>    = FALSE;
    <ticker.last_time> = <[base.time]>->(5);
}

my $window      = <ticker.obj.window>;
my $was_visible = defined $window && $window->get_visible;

<[ticker.start_animation]>
    if !<ticker.animation_started>
    or $loaded->{'updated'}
    or not $was_visible;

## restore the profile that was active before a notify-mode top-strip      ##
## override, if any. if notify never overrode it this is a no-op.          ##
if ( defined <ticker.notify.previous_profile> ) {
    my $restore_profile = delete <ticker.notify.previous_profile>;
    if ($was_visible) {
        ## window already mapped: move it ourselves via the X11 retry  ##
        ## sequence [GTK moves alone aren't honored once mapped].      ##
        <[ticker.move_to_profile]>->(
            $restore_profile, <ticker.window.profile>
        );
    } else {
        ## window was hidden/unmapped: moving it now would fail        ##
        ## verification and revert. just set the profile - start_      ##
        ## animation's remap-settle timer applies <ticker.window        ##
        ## .profile> with the X11 move retries once the remap has       ##
        ## finished.                                                     ##
        <[ticker.cmd.set-window-profile]>->( { 'args' => $restore_profile } );
    }
}

return { 'mode' => qw| true |, 'data' => 'ticker display content updated' };

