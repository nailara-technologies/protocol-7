## [:< ##

# name  = index.activate
# descr = mark a content checksum as active in the index

my $chk = shift // $ARG;
return FALSE unless defined $chk and exists <index.contributions>->{$chk};
<index.active_checksums>->{$chk} = 1;
<index.meta>->{'dirty'} = 1;
return TRUE;

