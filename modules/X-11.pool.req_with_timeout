## [:< ##

# name  = X-11.pool.req_with_timeout
# descr = bounded X11::Protocol single-reply request using select() deadline

my ( $X, $timeout, $name, @args ) = @_;

return undef if not defined $X;

my ( $op, $major, $minor ) = eval { $X->get_request($name) };
if ( $EVAL_ERROR or not defined $op or @$op != 3 ) {
    <[base.logs]>->(
        0, '[pool.req_with_timeout] unsupported or unknown request [%s]',
        $name
    );
    return undef;
}

eval {
    $X->give( $X->assemble_request( $op, \@args, $major, $minor ) );
    $X->flush();
};

if ($EVAL_ERROR) {
    <[base.logs]>->(
        0,     '[pool.req_with_timeout] send failed [%s] : %s',
        $name, <[base.str.eval_error]>
    );
    return undef;
}

my $data;
my $seq = $X->next_sequence();
$X->add_reply( $seq, \$data );

my $deadline = time() + $timeout;
my $fh       = $X->{'connection'}->fh;
my $fd       = fileno($fh);

## deadline-bound reads require a non-blocking filehandle: base.s_read returns  ##
## 0 on would-block so we can loop back to select(), re-enforcing the deadline  ##
my $old_blocking = eval { $fh->blocking(0) };
if ($EVAL_ERROR) {
    <[base.logs]>->(
        0, '[pool.req_with_timeout] cannot set non-blocking mode: %s',
        $EVAL_ERROR
    );
    $X->delete_reply($seq);
    return undef;
}

## temporarily replace the connection class's get() with a select()-bounded    ##
## reader, so the entire multi-byte reply [ header + variable body ] is read   ##
## under the same deadline, not just the first byte                            ##
my $pkg = ref( $X->{'connection'} );

my $get_with_deadline = sub {
    my ( $self, $len ) = @ARG;
    my $out = '';

    while ( length($out) < $len ) {
        my $remaining = $deadline - time();
        die '[pool.req_with_timeout] deadline exceeded'
            if $remaining <= 0;

        my $rin = '';
        vec( $rin, $fd, 1 ) = 1;
        my $ready = select( my $rout = $rin, undef, undef, $remaining );
        die '[pool.req_with_timeout] select timeout or error'
            if not $ready or $ready < 0;

        my $need  = $len - length($out);
        my $bytes = <[base.s_read]>->( $fh, \$out, $need );
        die '[pool.req_with_timeout] read error' if $bytes == -1;

        ## $bytes == 0 : EOF or would-block -- loop and let deadline enforce  ##
        ## the overall bound                                                  ##
    }

    return $out;
};

my $ok = FALSE;
eval {
    no warnings 'redefine';
    local *{"${pkg}::get"} = $get_with_deadline;
    $X->handle_input_for($seq);
    $ok = TRUE;
};

eval { $fh->blocking($old_blocking) }; ## restore blocking mode regardless of outcome ##

if ( not $ok or not defined $data ) {
    $X->delete_reply($seq);

    <[base.logs]>->(
        1,     '[pool.req_with_timeout] %s did not complete within %ds',
        $name, $timeout
    ) if not $ok;

    return undef;
}

$X->delete_reply($seq);
return $op->[2]->( $X, $data );

