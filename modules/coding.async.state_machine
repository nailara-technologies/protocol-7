## [:< ##

# name  = coding.async.state_machine
# descr = Async inference state machine with user input and subtask support
# purpose = Manage: streaming → tool_exec | user_input | subtask | paused → streaming → complete

my ( $action, $task_id, $data ) = @ARG;

## state definitions ##
use constant {
    STATE_STREAMING  => qw| streaming  |,    # receiving response from model
    STATE_TOOL_EXEC  => qw| tool_exec  |,    # executing tool calls
    STATE_USER_INPUT => qw| user_input |,    # waiting for user response
    STATE_SUBTASK    => qw|  subtask  |,     # waiting for subtask completion
    STATE_PAUSED     => qw|   paused  |, # temporarily halted [rate limit,..,]
    STATE_COMPLETE   => qw|  complete |, # final answer received
    STATE_ERROR      => qw|   error   |, # something went wrong
};

## valid state transitions ##
my %TRANSITIONS = (
    STATE_STREAMING() => {
        'finish_tool_calls' => STATE_TOOL_EXEC,
        'needs_user'        => STATE_USER_INPUT,
        'spawn_subtask'     => STATE_SUBTASK,
        'pause'             => STATE_PAUSED,
        'finish_stop'       => STATE_COMPLETE,
        'error'             => STATE_ERROR,
    },
    STATE_TOOL_EXEC() => {
        'tools_done'    => STATE_STREAMING,
        'needs_user'    => STATE_USER_INPUT,
        'spawn_subtask' => STATE_SUBTASK,
        'pause'         => STATE_PAUSED,
        'error'         => STATE_ERROR,
    },
    STATE_USER_INPUT() => {
        'user_responded' => STATE_STREAMING,
        'pause'          => STATE_PAUSED,
        'timeout'        => STATE_ERROR,
        'cancelled'      => STATE_ERROR,
    },
    STATE_SUBTASK() => {
        'subtask_done'  => STATE_STREAMING,
        'subtask_error' => STATE_ERROR,
        'pause'         => STATE_PAUSED,
        'timeout'       => STATE_ERROR,
    },
    STATE_PAUSED() => {
        'resume'    => STATE_STREAMING,
        'cancelled' => STATE_ERROR,
        'timeout'   => STATE_ERROR,
    },
);

## get current state ##
if ( $action eq 'get' ) {
    return <coding.async.task_state>->{$task_id} // {};
}

## set/merge state ##
elsif ( $action eq 'set' ) {
    my $state = <coding.async.task_state>->{$task_id} // {};

    foreach my $key ( keys %$data ) {
        $state->{$key} = $data->{$key};
    }

    <coding.async.task_state>->{$task_id} = $state;

    if ( defined $data->{'state'} ) {
        <[base.logs]>->(
            2,        "async.state_machine: task %s → %s",
            $task_id, $data->{'state'}
        );
    }

    return $state;
}

## initialize new task ##
elsif ( $action eq 'init' ) {
    my $initial = {
        'task_id'       => $task_id,
        'state'         => STATE_STREAMING,
        'round'         => 0,
        'messages'      => $data->{'messages'} // [],
        'tools'         => $data->{'tools'}    // [],
        'content'       => '',
        'tool_calls'    => [],
        'pending_tools' => [],
        'awaiting_user' => FALSE,
        'subtask_id'    => undef,
        'backend'       => $data->{'backend'} // 'gpu',
        'port'          => $data->{'port'}    // 8000,
        'start_time'    => <[base.time]>->(3),
        'history'       => [],                   # state transition history
    };

    <coding.async.task_state>->{$task_id} = $initial;

    <[base.logs]>->(
        2,
        "async.state_machine: init task %s [%d messages, %d tools]",
        $task_id,
        scalar( @{ $initial->{'messages'} } ),
        scalar( @{ $initial->{'tools'} } )
    );

    return $initial;
}

## cleanup ##
elsif ( $action eq 'cleanup' ) {
    delete <coding.async.task_state>->{$task_id};
    <[base.logs]>->( 2, "async.state_machine: cleanup task %s", $task_id );
    return { success => TRUE };
}

## validate and perform transition ##
elsif ( $action eq 'transition' ) {
    my $state   = <coding.async.task_state>->{$task_id} // {};
    my $current = $state->{'state'}                     // STATE_ERROR;
    my $event   = $data->{'event'};

    ## lookup valid transition ##
    my $new_state = $TRANSITIONS{$current}->{$event};

    if ( !defined $new_state ) {
        <[base.logs]>->(
            0,        "async.state_machine: invalid transition %s --%s→ ?",
            $current, $event
        );
        return $state;
    }

    ## record transition ##
    push @{ $state->{'history'} },
        {
        'from'  => $current,
        'to'    => $new_state,
        'event' => $event,
        'time'  => <[base.time]>->(3),
        };

    ## update state ##
    $state->{'state'} = $new_state;
    <coding.async.task_state>->{$task_id} = $state;

    <[base.logs]>->(
        2, "async.state_machine: task %s %s --%s→ %s",
        $task_id, $current, $event, $new_state
    );

    ## regex for json tool call markup stripping ##
    my $json_tc_re = qr|
        \{"(?:name"\s*:\s*")?    ## {"name": " or bare {"
        \w+"\s*[,:]?\s*          ## tool_name",
        "arguments"\s*:\s*       ## "arguments":
        \{[^{}]*                 ## { simple args
        (?:\{[^{}]*\}[^{}]*)*    ## nested one level
        \}\s*\}                  ## close both braces
    |xs;

    ## trigger appropriate handler ##
    if ( $new_state eq STATE_TOOL_EXEC ) {
        <[base.logs]>->(
            1, "state_machine: calling tool_executor for %s", $task_id
        );
        ## store content from chunk_handler ##
        $state->{'content'} = $data->{'content'} // $state->{'content'} // '';
        ## strip xml tool call markup from content before output ##
        my $display_content = $state->{'content'};
        ## strip xml tool call markup ##
        $display_content =~ s|</?tool_call>\s*||g;
        $display_content =~ s|<function\s*=\s*\w+\s*>.*?</function>||gs;
        ## strip json tool call markup ##
        $display_content =~ s{$json_tc_re}{}g;
        $display_content =~ s|^\s+||;
        $display_content =~ s|\s+$||;
        ## write reasoning trace to per-task buffers if present ##
        my $reasoning = $data->{'reasoning'} // $state->{'reasoning'} // '';
        if ( length $reasoning ) {
            <[coding.buffer.task_write]>->(
                $task_id,
                $reasoning,
                'thinking',
                {   'round' => $state->{'round'} // 0,
                    'pct'   => $state->{'pct_used'},
                }
            );
        }
        ## write model text to per-task buffers + rolling model_output ##
        <[coding.buffer.model_output]>->(
            length($display_content)
            ? $display_content
            : '[tool call — no reasoning text]',
            {   'round' => $state->{'round'} // 0,
                'tool'  => qw| model |,
                'pct'   => $state->{'pct_used'},
            }
        );
        if ( length $display_content ) {
            <[coding.buffer.task_write]>->(
                $task_id,
                $display_content,
                'assistant',
                {   'round' => $state->{'round'} // 0,
                    'pct'   => $state->{'pct_used'},
                }
            );
        }
        $state->{'pending_tools'} = $data->{'tool_calls'} // [];
        <coding.async.task_state>->{$task_id} = $state;
        <[coding.async.tool_executor]>->($task_id);
    } elsif ( $new_state eq STATE_STREAMING && $event eq 'tools_done' ) {
        $state->{'round'}++;
        ## add assistant message with tool_calls to conversation ##
        ## tool_calls passed from tool_executor in transition data ##
        my $tool_calls   = $data->{'tool_calls'}   // [];
        my $tool_results = $data->{'tool_results'} // [];
        if ( @{$tool_calls} ) {
            <[base.logs]>->(
                1,
                "state_machine: adding assistant msg with %d tool_calls",
                scalar( @{$tool_calls} )
            );
            ## sanitize arguments for jinja safety ##
            ## server requires: key present, type string, valid json ##
            ## server parses json string to dict for jinja iteration ##
            ## concatenated json [ model error ] crashes the parser ##
            ## matches blocking version [ process-queued-task 726-731 ] ##
            for my $tc ( @{$tool_calls} ) {
                my $args = $tc->{'function'}->{'arguments'} // '{}';
                if ( !ref $args && length $args ) {
                    my $parsed
                        = eval { JSON::PP->new->utf8(0)->decode($args) };
                    ## handle concatenated json objects [ model error ] ##
                    if ( !defined $parsed
                        && $args =~ m/^\s*(\{.*?\})\s*\{/s ) {
                        $parsed
                            = eval { JSON::PP->new->utf8(0)->decode($1) };
                    }
                    if ( defined $parsed && ref $parsed eq 'HASH' ) {
                        ## re-encode as clean json string ##
                        $tc->{'function'}->{'arguments'}
                            = JSON::PP::encode_json($parsed);
                    } else {
                        $tc->{'function'}->{'arguments'} = '{}';
                    }
                } else {
                    $tc->{'function'}->{'arguments'} = '{}';
                }
            }
            push @{ $state->{'messages'} },
                {
                'role'       => 'assistant',
                'content'    => $state->{'content'} // '',
                'tool_calls' => $tool_calls,
                };
        } else {
            <[base.logs]>->(
                0, "state_machine: NO tool_calls in transition data!"
            );
        }
        ## add tool results to conversation ##
        if ( @{$tool_results} ) {
            push @{ $state->{'messages'} }, @{$tool_results};
        }
        ## verify message roles after adding ##
        my @roles = map { $_->{'role'} } @{ $state->{'messages'} // [] };
        <[base.logs]>->(
            1,
            "state_machine: round %d has %d messages roles=[%s]",
            $state->{'round'},
            scalar(@roles),
            join( ',', map { uc( substr( $ARG, 0, 1 ) ) } @roles )
        );
        $state->{'content'} = '';
        $state->{'pending_tools'}
            = [];    ## cleared now that we have assistant msg
        $state->{'tool_calls'}   = [];    ## also clear any stale tool_calls
        $state->{'tool_results'} = $data->{'tool_results'} // [];

        ## loop detection [ matches blocking version ] ##
        my $task = <coding.task.queue>->{$task_id};
        if ( defined $task && @{$tool_calls} ) {
            my $model_content = $state->{'content'} // '';
            $model_content =~ s|^\s+||;
            $model_content =~ s|\s+$||;

            my $loop_check = <[coding.tool.detect_loop]>->(
                $task, $tool_calls, 'suspicion', $model_content
            );

            if (ref $loop_check eq qw| HASH |
                and (  $loop_check->{'skip_assert'}
                    or $loop_check->{'escalate_direct'} )
            ) {
                <[base.logs]>->(
                    0,
                    "state_machine: loop detected [score %.1f]: %s",
                    $loop_check->{'score'}   // 0,
                    $loop_check->{'message'} // 'unknown'
                );

                <coding.loop_detect_count> //= 0;
                <coding.loop_detect_count>++;
                if ( <coding.loop_detect_count> >= 3 ) {
                    <[base.logs]>->(
                        0,
                        "state_machine: loop persisted "
                            . "after 3 warnings, forcing stop"
                    );
                    <coding.async.task_state>->{$task_id} = $state;
                    <[coding.async.fail_task]>->(
                        $task_id,
                        'loop detected: task stopped '
                            . 'after repeated warnings'
                    );
                    return $state;
                }

                ## inject escalation warning [ user role: system mid-conv rejected ] ##
                push @{ $state->{'messages'} },
                    {
                    'role'    => 'user',
                    'content' => $loop_check->{'warning'}
                        // $loop_check->{'message'},
                    };
            } elsif ( ref $loop_check eq qw| HASH |
                and $loop_check->{'request_assertion'} ) {
                <[base.logs]>->(
                    1,
                    "state_machine: loop suspicion [%.1f, %s] - assertion",
                    $loop_check->{'score'}   // 0,
                    $loop_check->{'pattern'} // 'unknown'
                );
                ## inject assertion prompt as tool result ##
                my $assert_prompt = sprintf(
                    "[LOOP ASSERTION REQUEST]\n\n"
                        . "Pattern '%s' detected (conf: %d%%)\n"
                        . "Recent: %s | Score: %.1f\n\n"
                        . "Self-assess: Are you looping? Reply:\n"
                        . "LOOPING | NOT_LOOPING | UNCLEAR",
                    $loop_check->{'pattern'} // 'unknown',
                    int( ( $loop_check->{'confidence'} // 0 ) * 100 ),
                    join( ' → ',
                        grep {defined}
                            @{ $loop_check->{'history_snapshot'} // [] } ),
                    $loop_check->{'score'} // 0
                );
                push @{ $state->{'messages'} },
                    {
                    'role'         => 'tool',
                    'tool_call_id' => 'loop_assert_' . $state->{'round'},
                    'content'      => $assert_prompt,
                    };
                ## flag so finish_stop intercepts the next text response ##
                ## as an assertion answer rather than a task completion    ##
                $state->{'loop_assertion_pending'} = TRUE;
            } else {
                ## no loop pattern — reset counter ##
                <coding.loop_detect_count> = 0;
            }
        }

        <coding.async.task_state>->{$task_id} = $state;

        ## round scheduling: break callback chain into discrete jobs ##
        if ( <[base.cfg_bool]>->(<coding.async.round_scheduling.enabled>) ) {
            ## move current round job to completed ##
            my $current_job_id = $state->{'job_id'};
            if ( defined $current_job_id ) {
                <[jobqueue.move_job]>->( $current_job_id, 'completed' );
            }

            ## check for pending subtask ##
            if ( defined $state->{'pending_subtask'}
                and length $state->{'pending_subtask'} ) {
                <[base.logs]>->(
                    1,        "state_machine: %s waiting for subtask %s",
                    $task_id, $state->{'pending_subtask'}
                );
                <[coding.async.state_machine]>->(
                    'transition',
                    $task_id,
                    {   'event'      => 'spawn_subtask',
                        'subtask_id' => $state->{'pending_subtask'}
                    }
                );
            } else {
                ## clear chunk_context before enqueue — prevents http_complete
                ## from re-processing tool_calls when the EOF arrives after
                ## enqueue_round has already been scheduled (double execution) ##
                $state->{'chunk_context'} = {};
                <coding.async.task_state>->{$task_id} = $state;
                ## enqueue next round ##
                <[coding.task.enqueue_round]>
                    ->( $task_id, $state->{'round'} );
            }
        } else {
            ## backward compat: chain directly to next request ##
            <[coding.async.send_request]>->($task_id);
        }
    } elsif ( $new_state eq STATE_STREAMING && $event eq 'user_responded' ) {
        $state->{'round'}++;
        $state->{'content'} = '';
        push @{ $state->{'messages'} },
            {
            'role'    => 'user',
            'content' => $data->{'user_message'},
            };
        <coding.async.task_state>->{$task_id} = $state;
        <[coding.async.send_request]>->($task_id);
    } elsif ( $new_state eq STATE_STREAMING && $event eq 'resume' ) {
        ## resume from pause - continue with existing state
        <[base.logs]>->(
            2, "async.state_machine: task %s resuming from pause", $task_id
        );
        <coding.async.task_state>->{$task_id} = $state;
        <[coding.async.send_request]>->($task_id);
    } elsif ( $new_state eq STATE_COMPLETE
        && $state->{'loop_assertion_pending'} ) {
        ## intercept: this completion is the model answering the loop assertion ##
        ## process it through detect_loop assertion phase then continue          ##
        my $assertion_response = $data->{'content'} // $state->{'content'}
            // '';
        $state->{'loop_assertion_pending'} = FALSE;
        my $task_la = <coding.task.queue>->{$task_id};
        <[coding.tool.detect_loop]>->(
            $task_la, $assertion_response, 'assertion', ''
        ) if defined $task_la;
        ## inject model's answer as user message so context is preserved ##
        push @{ $state->{'messages'} },
            {
            'role'    => 'assistant',
            'content' => $assertion_response,
            };
        push @{ $state->{'messages'} },
            {
            'role'    => 'user',
            'content' => 'Thank you for your self-assessment.'
                . ' Please continue with your task.',
            };
        ## stay in streaming state and enqueue next round ##
        $state->{'state'} = STATE_STREAMING;
        $state->{'round'}++;
        <coding.async.task_state>->{$task_id} = $state;
        <[coding.task.enqueue_round]>->( $task_id, $state->{'round'} );
    } elsif ( $new_state eq STATE_COMPLETE ) {
        $state->{'final_content'} = $data->{'content'} // $state->{'content'};
        ## strip tool call markup if present ##
        my $final_display = $state->{'final_content'};
        $final_display =~ s|</?tool_call>\s*||g;
        $final_display =~ s|<function\s*=\s*\w+\s*>.*?</function>||gs;
        $final_display =~ s{$json_tc_re}{}g;
        $final_display =~ s|^\s+||;
        $final_display =~ s|\s+$||;
        ## write final response to model output buffer + per-task buffers ##
        if ( length($final_display) ) {
            <[coding.buffer.model_output]>->(
                $final_display,
                {   'round' => $state->{'round'} // 0,
                    'tool'  => qw| model |,
                    'pct'   => $state->{'pct_used'},
                }
            );
            <[coding.buffer.task_write]>->(
                $task_id,
                $final_display,
                'assistant',
                {   'round' => $state->{'round'} // 0,
                    'pct'   => $state->{'pct_used'},
                }
            );
        }
        <coding.async.task_state>->{$task_id} = $state;
        <[coding.async.complete_task]>->($task_id);
    } elsif ( $new_state eq STATE_ERROR ) {
        $state->{'error'} = $data->{'error'} // 'unknown error';
        <coding.async.task_state>->{$task_id} = $state;
        <[coding.async.fail_task]>->( $task_id, $state->{'error'} );
    } elsif ( $new_state eq STATE_USER_INPUT ) {
        $state->{'awaiting_user'} = TRUE;
        $state->{'user_prompt'} = $data->{'prompt'} // 'waiting for input.,';
        <coding.async.task_state>->{$task_id} = $state;
        ## notify that we're waiting for user ##
        <[base.logs]>->(
            1, "async.state_machine: task %s" . " waiting for user input",
            $task_id
        );
    } elsif ( $new_state eq STATE_SUBTASK ) {
        $state->{'subtask_id'} = $data->{'subtask_id'};
        <coding.async.task_state>->{$task_id} = $state;
        ## subtask completion will trigger transition back ##
    } elsif ( $new_state eq STATE_PAUSED ) {
        $state->{'pause_reason'} = $data->{'reason'} // 'paused';
        $state->{'resume_event'} = $data->{'resume_event'};
        <coding.async.task_state>->{$task_id} = $state;
        <[base.logs]>->(
            2,        "async.state_machine: task %s paused [%s]",
            $task_id, $state->{'pause_reason'}
        );
    }

    return $state;
}

## pause task ##
elsif ( $action eq 'pause' ) {
    return <[base.call]>->(
        'coding.async.state_machine',
        'transition',
        $task_id,
        {   'event'        => 'pause',
            'reason'       => $data->{'reason'},
            'resume_event' => $data->{'resume_event'}
        }
    );
}

## resume paused task ##
elsif ( $action eq 'resume' ) {
    my $state = <coding.async.task_state>->{$task_id} // {};

    if ( $state->{'state'} ne STATE_PAUSED ) {
        <[base.logs]>->(
            0, "async.state_machine: cannot resume task %s [not paused]",
            $task_id
        );
        return $state;
    }

    return <[base.call]>->(
        'coding.async.state_machine', 'transition', $task_id,
        { 'event' => 'resume', %$data }
    );
}

## get state constants ##
elsif ( $action eq 'constants' ) {
    return {
        'STREAMING'  => STATE_STREAMING,
        'TOOL_EXEC'  => STATE_TOOL_EXEC,
        'USER_INPUT' => STATE_USER_INPUT,
        'SUBTASK'    => STATE_SUBTASK,
        'PAUSED'     => STATE_PAUSED,
        'COMPLETE'   => STATE_COMPLETE,
        'ERROR'      => STATE_ERROR,
    };
}

return { error => sprintf "unknown action : '%s'", $action };

