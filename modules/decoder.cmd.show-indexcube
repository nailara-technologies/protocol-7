# name  = decoder.cmd.show-indexcube
# descr = show INDEXCUBE traversal log entries

my $cube = $data{'decoder'}{'INDEXCUBE'} // [];

return { 'mode' => qw| true |, 'data' => 'INDEXCUBE empty' }
    unless @{$cube};

my @lines = sprintf( "INDEXCUBE depth : %d", scalar @{$cube} );

for my $entry ( @{$cube} ) {
    push @lines,
        sprintf(
        "  [%02d] stream %-8s  boundary:%s  val:%s  %s  t:%s",
        $entry->{'depth'}          // 0,
        $entry->{'stream_id'}      // '?',
        $entry->{'boundary_n'}     // 0,
        $entry->{'boundary_value'} // 0,
        $entry->{'p7ref'}          // 'STREAM:?:?',
        $entry->{'timestamp'}      // 0,
        );
}

return { 'mode' => qw| true |, 'data' => join( "\n", @lines ) };

