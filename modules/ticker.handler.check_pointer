## [:< ##

# name = ticker.handler.check_pointer

# Poll-based hover fallback for WSLg/XWayland. GTK enter/leave events can be
# lost or spurious for transparent dock windows, so this timer queries the
# pointer directly. Both directions are debounced [3 consecutive samples] to
# avoid flicker when the cursor briefly crosses the boundary.
#
# Leave events are also delayed by 150 ms: if the pointer re-enters within
# that window, the leave is cancelled and an in-progress fade-out continues.
return if not <ticker.mouse.avoid>;
return if not <ticker.obj.window>->get_visible;

## a fade-out triggered by ticker.dismiss is in progress - let it run to ##
## completion without the swap-edge logic below restarting a fade-in.    ##
return if <ticker.dismiss.pending>;

my $window = <ticker.obj.window>;

eval {
    ## use the configured/placed geometry instead of the live allocation:  ##
    ## under Wayland the real GtkWindow allocation may be larger than the  ##
    ## visible ticker, which would make the poll think the whole screen is ##
    ## inside.                                                             ##
    my $wx = <x11.coordinates.left> // 0;
    my $wy = <x11.coordinates.top>  // 0;
    my $ww = <x11.window.width>     // $window->get_allocated_width;
    my $wh = <x11.window.height>    // $window->get_allocated_height;

    ## query pointer position via the default pointer device.  under      ##
    ## WSLg/XWayland this is screen-relative, so we also compare screens. ##
    my $display = Gtk3::Gdk::Display::get_default;
    my $seat    = $display->get_default_seat;
    my $pointer = $seat->get_pointer;
    my ( $ptr_screen, $px, $py ) = $pointer->get_position;

    my $ticker_screen = $window->get_screen;

    my $inside
        = (    defined $ptr_screen
            && $ptr_screen == $ticker_screen
            && $px >= $wx
            && $px < $wx + $ww
            && $py >= $wy
            && $py < $wy + $wh );

    ## swap-edge mode: keep the ticker visible on the edge that is NOT under
    ## the mouse.  when the cursor covers the current edge, fade out; the
    ## fade_out handler then moves the window to the opposite edge, and we
    ## fade in there as long as the mouse is not covering it.

    ## remove any leftover pending timer from earlier code that used a ##
    ## separate delay-before-fade stage.                               ##
    delete <ticker.swap.pending_until>
        if defined <ticker.swap.pending_until>;

    ## note: a failed move attempt (ticker.swap.move_failed) does not gate ##
    ## this branch - swap_profile retries each time and only sets          ##
    ## ticker.swap.disabled after several consecutive failures.            ##
    ##                                                                     ##
    ## startup grace period: right after (re)show, the corrected window    ##
    ## position can land directly under the cursor before the user has had ##
    ## a chance to move it away. the GTK enter-notify handler already      ##
    ## checks ticker.mouse.grace_until, but this poll-based fallback did   ##
    ## not - so it could immediately trigger a swap/fail loop at startup   ##
    ## and burn through the failure count before the grace period elapses. ##
    if ( defined <ticker.mouse.grace_until>
        and <[base.time]>->(5) < <ticker.mouse.grace_until> ) {
        return;
    }

    if ( <[base.cfg_bool]>->(<ticker.mouse.swap_edge>)
        and not <ticker.swap.disabled> ) {

        my $opacity
            = <ticker.is_composited>
            ? $window->get_opacity()
            : 1;

        ## combine GTK event state with pointer geometry:  arm if either   ##
        ## says the cursor is over the ticker.  after a leave signal we    ##
        ## trust the event and ignore geometry until the next enter signal ##
        ## (geometry can stick to TRUE under WSLg).                        ##
        my $event_inside = <ticker.mouse.inside> // FALSE;
        my $cursor_over  = ( $inside || $event_inside )
            && not defined <ticker.mouse.swap_left_at>;

        my $timer_running = defined <ticker.timer.fade>;
        my $timer_dir     = <ticker.fade.handler> // '';

        if ($cursor_over) {
            <ticker.mouse.inside> = TRUE;
            delete <ticker.mouse.swap_left_at>;
            <ticker.mouse.leave_pending_until> = undef;

            ## already faded and cursor still over the swapped edge -> stay ##
            ## invisible; do not bounce back and forth.                     ##
            if ( $opacity < 0.05 ) {
                <[base.log]>->(
                    2, ': swapped edge still under cursor, staying invisible'
                );
                return;
            }

            ## fade-out already in progress -> let it run ##
            return if $timer_running and $timer_dir eq qw| fade_out |;

            ## a fade-in is running -> abort it and fade back out ##
            if ($timer_running) {
                <ticker.timer.fade>->cancel;
                delete <ticker.timer.fade>;
                delete <ticker.fade.handler>;
                delete <ticker.time.fade_view>;
            }

            <[base.log]>->(
                2, ': pointer over current edge (swap), fading out'
            );

            <ticker.fade_opacity> = $opacity;
            <ticker.fade.handler> = qw| fade_out |;
            <ticker.timer.fade>   = <[event.add_timer]>->(
                {   'after'    => 0,
                    'interval' => 0.017,
                    'handler'  => qw| ticker.handler.fade_out |
                }
            );

            if ( defined <x11.id> ) {
                <[base.X-11.keep_below]>->(<x11.id>);
            }
        } else {
            <ticker.mouse.inside> = FALSE;

            ## remember that the cursor is outside so geometry alone cannot ##
            ## override a leave event and restart the fade-out.             ##
            <ticker.mouse.swap_left_at> = <[base.time]>->(3)
                if not defined <ticker.mouse.swap_left_at>;
            delete <ticker.mouse.leave_pending_until>;

            ## already visible -> nothing to do ##
            return if $opacity > 0.99;

            ## fade-in already in progress -> let it finish ##
            return if $timer_running and $timer_dir eq qw| fade_in |;

            ## a fade-out is running -> abort it and fade back in ##
            if ($timer_running) {
                <ticker.timer.fade>->cancel;
                delete <ticker.timer.fade>;
                delete <ticker.fade.handler>;
                delete <ticker.time.fade_view>;
            }

            <[base.log]>->( 2, ': edge free (swap), fading in' );

            <ticker.fade_opacity> = $opacity;
            $window->set_opacity($opacity) if <ticker.is_composited>;
            <ticker.fade.handler> = qw| fade_in |;
            <ticker.timer.fade>   = <[event.add_timer]>->(
                {   'after'    => 0,
                    'interval' => 0.017,
                    'handler'  => qw| ticker.handler.fade_in |
                }
            );

            if ( defined <x11.id> ) {
                <[base.X-11.raise-window]>->(<x11.id>);
                <[base.X-11.keep_above]>->(<x11.id>);
            }
        }
        return;
    }

    ## use a small hysteresis margin for leave detection so pointer jitter
    ## near the ticker edge does not abort the fade-out.
    my $leave_margin = 20;
    my $leave_outside
        = (    not defined $ptr_screen
            || $ptr_screen != $ticker_screen
            || $px < $wx - $leave_margin
            || $px >= $wx + $ww + $leave_margin
            || $py < $wy - $leave_margin
            || $py >= $wy + $wh + $leave_margin );

    <ticker.mouse.inside_count>  //= 0;
    <ticker.mouse.outside_count> //= 0;

## delayed leave: GTK signal handler sets this, we expire it ##
    if (    not <ticker.mouse.inside>
        and defined <ticker.mouse.leave_pending_until>
        and <[base.time]>->(5) >= <ticker.mouse.leave_pending_until>
        and ( <ticker.display.mode> // qw| continuous | ) ne qw| notify |
        and not <ticker.hidden> ) {
        delete <ticker.mouse.leave_pending_until>;
        <ticker.mouse.outside_count> = 0;
        <ticker.mouse.inside_count>  = 0;
        <[base.log]>->( 1, ': delayed leave expired, raising and fading in' );

        <ticker.timer.fade>->cancel if defined <ticker.timer.fade>;
        delete <ticker.time.fade_view>;
        <ticker.timer.fade> = <[event.add_timer]>->(
            {   'after'    => 0,
                'interval' => 0.017,
                'handler'  => qw| ticker.handler.fade_in |
            }
        );

        if ( defined <x11.id> ) {
            <[base.X-11.raise-window]>->(<x11.id>);
            <[base.X-11.keep_above]>->(<x11.id>);
        }
        return;
    }

    if ( not <ticker.mouse.inside> ) {

        ## debounced enter detection [for missed GTK enter events] - also   ##
        ## the only point that cancels a pending delayed-leave on re-entry: ##
        ## cancelling it on the FIRST raw $inside sample [ no debounce ]    ##
        ## let one incidental/imprecise reading [ likely on a thin 72px     ##
        ## strip near a screen edge the cursor passes through ] kill the    ##
        ## 300ms grace before it ever got a chance to fire - confirmed live ##
        ## as the cause of fade getting permanently stuck on "entered".     ##
        if ($inside) {
            <ticker.mouse.inside_count>++;
            if ( <ticker.mouse.inside_count> >= 3 ) {
                <ticker.mouse.inside>       = TRUE;
                <ticker.mouse.inside_count> = 0;
                delete <ticker.mouse.leave_pending_until>;
                <[base.log]>->(
                    1, ': pointer entered ticker window (poll), fading out'
                );

                <ticker.timer.fade>->cancel if defined <ticker.timer.fade>;
                delete <ticker.time.fade_view>;
                <ticker.timer.fade> = <[event.add_timer]>->(
                    {   'after'    => 0,
                        'interval' => 0.017,
                        'handler'  => qw| ticker.handler.fade_out |
                    }
                );

                if ( defined <x11.id> ) {
                    <[base.X-11.keep_below]>->(<x11.id>);
                }
            }
        } else {
            <ticker.mouse.inside_count> = 0;
        }
        return;
    }

## mouse.inside is TRUE from here on ##
    if ( not $leave_outside ) {
        <ticker.mouse.outside_count> = 0;
        return;
    }

    <ticker.mouse.outside_count>++;
    return if <ticker.mouse.outside_count> < 3;

## pointer left ticker window [poll] ##
    <ticker.mouse.inside>        = FALSE;
    <ticker.mouse.outside_count> = 0;
    <ticker.mouse.inside_count>  = 0;

    if ( ( <ticker.display.mode> // qw| continuous | ) ne qw| notify |
        and not <ticker.hidden> ) {
        <ticker.mouse.leave_pending_until> = <[base.time]>->(5) + 0.3;
        <[base.log]>->(
            1, ': pointer left ticker window (poll), fade-in delayed 300ms'
        );
    }

};

<[base.log]>->( 0, ': pointer check failed: ' . $EVAL_ERROR )
    if length $EVAL_ERROR;

