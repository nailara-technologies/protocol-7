# name  = external.cmd.list-connections
# descr = list all orbital connections

my $conn_ref = $data{'external'}{'connections'} // {};
my @names    = <[base.sort]>->($conn_ref);

return { 'mode' => qw| true |, 'data' => 'no connections' }
    unless @names;

my $output = "\n";
my $fmt    = "%-16s %-30s %-16s %-12s %-10s\n";
$output .= sprintf $fmt, qw| name p7ref ip status encrypted |;
$output .= '-' x 90 . "\n";

foreach my $name (@names) {
    my $c = $conn_ref->{$name};
    $output .= sprintf $fmt,
        $name,
        $c->{'p7ref'}  // '',
        $c->{'ip'}     // '',
        $c->{'status'} // '',
        $c->{'encrypted'} ? qw| yes | : qw| no |;
}

return { 'mode' => qw| size |, 'data' => $output };

