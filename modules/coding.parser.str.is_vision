## [:< ##

# name  = coding.parser.str.is_vision
# descr = return [vision|text] determined by boolean status
#          [ clone of models.parser.str.is_vision - not statically loaded  ]
#          [ into the coding zenka, and base.call_filter needs it compiled ]

return <[base.cfg_bool]>->(shift) ? qw| vision | : qw| text |;

