## [:< ##

# name = models.cmd.reload
# descr = Handle reload command - reload configuration and registry

sub execute_reload {
  # Clear caches
  $data{registry_cache} = {};
  $data{cache_last_updated} = 0;

  # Log reload
  push @{$data{operation_log}}, {
    timestamp => time(),
    action => 'reload',
    status => 'completed',
    details => 'configuration and registry reloaded',
  };

  return {
    'success' => TRUE,
    'reloaded' => 1,
    'timestamp' => time(),
  };
}

# Entry point
{
  my $cmd = shift @ARG;

  if ($cmd eq 'reload') {
    return execute_reload();
  }

  return {
    'success' => FALSE,
    'error' => "unknown command: $cmd",
  };
};

