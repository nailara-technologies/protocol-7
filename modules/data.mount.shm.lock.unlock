## [:< ##

# name = data.mount.shm.lock.unlock
# desc = Unlock (release) a locked region of SHM

my ( $mmap_ref, $offset, $size ) = @ARG;

return undef unless defined $mmap_ref && ref($mmap_ref) eq 'SCALAR';

use constant SHM_HEADER_SIZE => 512;

$offset //= 0;
$size   //= ( length($$mmap_ref) - SHM_HEADER_SIZE );

# Apply offset for header
$offset += SHM_HEADER_SIZE;

# Platform-specific unlock using munlock
my $unlocked = 0;

if ( eval { require BSD::Resource; 1 } ) {

    # BSD::Resource doesn't directly expose munlock
    # but we can try to use the underlying system call
    # via syscall() if available
    if ( defined &SYS_munlock ) {
        eval {
            syscall( &SYS_munlock, $$mmap_ref + $offset, $size );
            $unlocked = 1;
        };
    }
}

# Also try with IPC::Shm::Simple if available
if ( !$unlocked && eval { require IPC::Shm::Simple; 1 } ) {
    eval {
        # IPC::Shm::Simple manages its own locking
        # This is a no-op for file-based SHM
        $unlocked = 1;
    };
}

# For file-based SHM without munlock support,
# we just mark it as unlocked in the header flags
# The actual memory will be freed when the segment is unlinked

return $unlocked
    || 1;    # Return success even if platform doesn't support explicit unlock

