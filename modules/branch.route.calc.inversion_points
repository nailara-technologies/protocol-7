# name  = branch.route.calc.inversion_points
# descr = list cross-correlation depths where inversions cancel
# param = { max_depth }
#
# cross-correlation occurs at multiples of 13: 0, 13, 26, 39...

my $params    = shift                  // {};
my $max_depth = $params->{'max_depth'} // 0;

$max_depth = int($max_depth);

return { 'mode' => 'false', 'data' => 'max_depth must be non-negative' }
    if $max_depth < 0;

my @points;

for ( my $d = 0; $d <= $max_depth; $d += 13 ) {
    push @points, $d;
}

return { 'mode' => 'true', 'data' => \@points };

