## [:< ##

# name  = models.task.enqueue
# descr = enqueue task for jobqueue-managed execution

my $params = shift;
return warn 'expected hashref parameter <{C1}>' if ref $params ne qw|HASH|;

my $task_id    = $params->{'task_id'}    // '';
my $model      = $params->{'model'}      // '';
my $prompt     = $params->{'prompt'}     // '';
my $target_cmd = $params->{'target_cmd'} // '';

return warn 'task_id required <{C1}>'    unless length $task_id;
return warn 'target_cmd required <{C1}>' unless length $target_cmd;

my $job_id = <[jobqueue.add_job]>->(
    {   'name'            => "task-$task_id",
        'object_id'       => <models.dep.dispatch_slot>,
        'job_callback'    => 'models.task.execute',
        'callback_params' => {
            'task_id'             => $task_id,
            'model'               => $model,
            'prompt'              => $prompt,
            'target_cmd'          => $target_cmd,
            'acceptance_criteria' => $params->{'acceptance_criteria'} // [],
            'node_id'             => $params->{'node_id'}             // '',
            'max_attempts'        => $params->{'max_attempts'}        // 5,
        }
    }
);

<models.task.jobs>->{$job_id} = $task_id;

<[base.logs]>->(
    2, ': enqueued task %s as job %s [ %s ]',
    $task_id, $job_id, $target_cmd
);

return $job_id;

