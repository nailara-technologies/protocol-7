## [:< ##

# name = protocol.https.init_code
# descr = HTTPS protocol configuration using TLS encryption

# HTTPS (HTTP Secure) wraps HTTP requests in TLS encryption
# The encryption/decryption is transparent at IO::Socket::SSL layer
# so HTTP request parsing is identical to plaintext HTTP

<protocol.https.cfg.tls_version> //= 'TLSv1_3:TLSv1_2';
<protocol.https.cfg.cipher_suite>
    //= 'ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256';
<protocol.https.cfg.certificate_path> //= '/etc/protocol-7/certs/current.pem';
<protocol.https.cfg.key_path>         //= '/etc/protocol-7/certs/current.key';
<protocol.https.cfg.hsts_max_age>     //= 31536000;
<protocol.https.cfg.hsts_include_subdomains> //= 1;

## HTTPS protocol structure is defined in httpsd.init_code with proper state and handlers
## Only set configuration values here, do NOT redefine the protocol structure
## Set binary read size for HTTPS - SSL frame size is 16KB max per IO::Socket::SSL docs
## This ensures we read complete SSL frames rather than trying to parse line-by-line
<protocol.https.bytes_to_read> //= 16384;

0;

