## [:< ##

# name  = jobsite.chksum.branch-color
# descr = compute bmw384 color coordinate for a job's assertion dimension branch

my $job_id    = shift // '';
my $dimension = shift // '';

return undef if not length $job_id or not length $dimension;

my $job = <[jobsite.job.read]>->($job_id);
return undef if not defined $job;

my $text = $job->{'assertions'}{'dimensions'}{$dimension}{'reason'} // '';
return undef if not length $text;

<[base.perlmod.autoload]>->('Digest::BMW')
    if not <[base.perlmod.loaded]>->('Digest::BMW');

my $bmw = Digest::BMW->new(384);
$bmw->add($text);
my $digest = $bmw->digest;

my $color = <[chk-sum.bmw384.color]>->($digest);
return undef if not defined $color;

my $arc = <[chk-sum.bmw384.arc-segment]>->($color);

return { 'color' => $color, 'arc' => $arc, 'digest' => $digest };

