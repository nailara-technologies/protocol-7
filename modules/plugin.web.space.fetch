## [:< ##

# name  = plugin.web.space.fetch
# descr = async fetch spatial state from data source zenka

my $source = <web.space.cfg.data_source> // return;

<[base.logs]>->( 2, 'plugin.web.space.fetch : requesting from %s', $source );

## request cursor position ##
<[protocol-7.route-send]>->(
    {   qw| command |   => "$source.cursor-state",
        qw| call_args | => { qw| args | => '' },
        qw| reply |     => {
            qw| handler | => qw| plugin.web.space.handler.state_reply |,
            qw| params |  => { qw| field | => qw| cursor | },
        }
    }
);

## request graph stats ##
<[protocol-7.route-send]>->(
    {   qw| command |   => "$source.graph",
        qw| call_args | => { qw| args | => '' },
        qw| reply |     => {
            qw| handler | => qw| plugin.web.space.handler.state_reply |,
            qw| params |  => { qw| field | => qw| graph | },
        }
    }
);

## sync orbital nodes to graphics-matrix cells ##
<[plugin.web.space.orbital.to_cells]>;

return 1;

