## [:< ##

# name  = decoder.cmd.show-accumulator
# param = [stream_id]
# descr = show level-5 and level-6 accumulator state

my $stream_id
    = defined $call->{'args'} && length $call->{'args'}
    ? $call->{'args'}
    : undef;

my @lines;

## level-5 state — per stream ##
my $l5_streams = <decoder.level5> // {};

if ( defined $stream_id ) {
    ## single stream detail ##
    if ( not exists $l5_streams->{$stream_id} ) {
        return {
            'mode' => qw| false |,
            'data' => "no level-5 state for stream $stream_id"
        };
    }
    my $s = $l5_streams->{$stream_id};
    push @lines,
        sprintf( "level-5 stream %s :", $stream_id ),
        sprintf( "  values      : %d",  scalar @{ $s->{'values'} } ),
        sprintf( "  pending bits: %d",  $s->{'bit_count'} ),
        sprintf( "  acc preview : %s", substr( $s->{'accumulator'}, 0, 40 ) );
} else {
    ## summary of all active streams ##
    push @lines,
        sprintf( "level-5 streams : %d active", scalar keys %{$l5_streams} );
    for my $sid ( sort keys %{$l5_streams} ) {
        my $s = $l5_streams->{$sid};
        push @lines,
            sprintf(
            "  stream %-8s  values:%5d  pending:%2d bits",
            $sid, scalar @{ $s->{'values'} },
            $s->{'bit_count'}
            );
    }
}

## level-6 state — per stream ##
my $l6_streams = <decoder.level6> // {};

if ( defined $stream_id ) {
    ## single stream detail ##
    if ( not exists $l6_streams->{$stream_id} ) {
        push @lines, '', "level-6 stream $stream_id : no state";
    } else {
        my $s = $l6_streams->{$stream_id};
        push @lines, '', sprintf( "level-6 stream %s :", $stream_id ),
            sprintf(
            "  pending acc : [%s]  %d chars",
            $s->{'accumulator'} // '',
            length( $s->{'accumulator'} // '' )
            );
    }
} else {
    ## summary of all active streams ##
    push @lines, '',
        sprintf( "level-6 D3 streams : %d active",
        scalar keys %{$l6_streams} );
    for my $sid ( sort keys %{$l6_streams} ) {
        my $s = $l6_streams->{$sid};
        push @lines,
            sprintf( "  stream %-8s  pending:%2d chars",
            $sid, length( $s->{'accumulator'} // '' ) );
    }
}

## jobs ##
my $job_count = scalar keys %{ <decoder.jobs> // {} };
push @lines, '', sprintf( "active jobs : %d", $job_count );

return { 'mode' => qw| true |, 'data' => join( "\n", @lines ) };

