## [:< ##

# name = models.memory.del
# descr = delete memory item by checksum
# param = $checksum
# return = TRUE on success, FALSE on error

my $checksum = shift;

return FALSE unless defined $checksum;
return FALSE unless $checksum =~ m|^[A-Z0-9]{7}$|;

## memory storage path
my $memory_dir = catdir( '/var/protocol-7', <system.zenka.name>, 'memory' );

## find all files for this checksum (including .meta)
my @files = glob( catfile( $memory_dir, "${checksum}.*" ) );

return FALSE unless scalar(@files) > 0;

## delete all files
my $deleted = 0;
for my $file (@files) {
    if ( unlink($file) ) {
        $deleted++;
    } else {
        <[base.logs]>->(
            0,     ':. failed to delete file .: %s :: %s',
            $file, <[base.str.os_err]>
        );
    }
}

## log deletion
<[base.logs]>->(
    2,         'memory item deleted :. %s [ %d files ]',
    $checksum, $deleted
);

return $deleted > 0 ? TRUE : FALSE;

0;

