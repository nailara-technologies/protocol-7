## [:< ##

# name = models.registry.path
# descr = Get registry file path

sub get_registry_path_public {
  my $base = <[models.registry.base]>;
  return $base->{get_registry_path}->();
}

# Entry point
{
  my @args = @ARG;
  return get_registry_path_public(@args);
};

