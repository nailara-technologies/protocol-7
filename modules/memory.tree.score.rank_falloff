## [:< ##

# name  = memory.tree.score.rank_falloff
# descr = calculate rank-based weight falloff for tree scoring

my ( $curve, $p ) = @_;
$p = 0 if $p < 0;
$p = 1 if $p > 1;

if ( $curve eq 'exponential' ) {
    return <[base.curve.eval]>->( $curve, $p );
} elsif ( $curve =~ m{^(gaussian_pulse|heartbeat)$} ) {
    return <[base.curve.eval]>->( $curve, 0.5 + $p / 2 );
} else {
    ## [ increasing family: sigmoid, linear, quantized, ease-*, sine, hold ]##
    return <[base.curve.eval]>->( $curve, 1 - $p );
}

