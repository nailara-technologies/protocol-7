## [:< ##

# name  = nshell.no-tty-debug.cmd.char-add
# param = <debug-chars>
# descr = add character [sequence] in no-tty-debug mode

### [ detect if called by debug-status wrapper ]
## check caller stack for debug-status in the call chain
##
my $is_debug_status_call = 0;
for ( my $i = 0; $i < 5; $i++ ) {
    my ( $pkg, $file, $line, $sub ) = caller($i);
    last unless defined $file;
    if ( $file =~ m{debug-status} ) {
        $is_debug_status_call = 1;
        last;
    }
}

my $character_string = '';

unless ($is_debug_status_call) {
    $character_string = $call->{'args'} // '';  ## receiving command param. ##
    return {
        'mode' => qw| false |,
        'data' => '..no-tty-debug command character [sequence] expected..'
        }
        if not length
        $character_string;   ## paramter presence is mandatory for char-add ##
}

### [ key mapping for escape sequences ]
##
state %chr_map = (
    ## Navigation keys
    'Up'         => "\e[A",
    'Down'       => "\e[B",
    'Right'      => "\e[C",
    'Left'       => "\e[D",
    'UpArrow'    => "\e[A",    ## alias
    'DownArrow'  => "\e[B",    ## alias
    'RightArrow' => "\e[C",    ## alias
    'LeftArrow'  => "\e[D",    ## alias
    'Home'       => "\e[H",
    'End'        => "\e[F",
    'PageUp'     => "\e[5~",
    'PageDown'   => "\e[6~",

    ## Editing keys
    'Backspace' => "\x7f",     ## DEL (0x7F)
    'Delete'    => "\e[3~",    ## ESC [ 3 ~
    'Tab'       => "\t",
    'Insert'    => "\e[2~",

    ## Control characters
    'Ctrl+o' => "\x0f",        ## Ctrl-O (15)
    'Ctrl+r' => "\x12",        ## Ctrl-R (18)
    'Ctrl+c' => "\x03",        ## Ctrl-C (ETX)
    'Ctrl+d' => "\x04",        ## Ctrl-D (EOT)
    'Ctrl+g' => "\x07",        ## Ctrl-G (BEL)
    'Ctrl+l' => "\x0c",        ## Ctrl-L (FF - clear screen)
    'Ctrl+a' => "\x01",        ## Ctrl-A (SOH - start of line)
    'Ctrl+e' => "\x05",        ## Ctrl-E (ENQ - end of line)
    'Ctrl+k' => "\x0b",        ## Ctrl-K (VT - kill to end)
    'Ctrl+u' => "\x15",        ## Ctrl-U (NAK - kill line)
    'Ctrl+w' => "\x17",        ## Ctrl-W (ETB - delete word)
    'Ctrl+n' => "\x0e",        ## Ctrl-N (SO - next history)
    'Ctrl+p' => "\x10",        ## Ctrl-P (DLE - prev history)
    'Ctrl+f' => "\x06",        ## Ctrl-F (ACK - forward char)
    'Ctrl+b' => "\x02",        ## Ctrl-B (STX - backward char)

    ## Special keys
    'Escape' => "\e",
    'Esc'    => "\e",          ## alias
    'Enter'  => "\n",
    'Return' => "\n",          ## alias
    'Space'  => " ",

    ## Function keys F1-F4 (standard SS3 sequences)
    'F1' => "\eOP",
    'F2' => "\eOQ",
    'F3' => "\eOR",
    'F4' => "\eOS",
);

### [ initialize debug state on first use ]
##
<nshell.debug_state> //= {
    current_mode            =>  0,   # NORMAL
    current_history_index   => -1,
    ctrl_o_start_position   => -1,
    ctrl_o_entries_added    =>  0,
    display_preloaded_entry =>  0,
    mode_names              => {
        0 => 'NORMAL',
        1 => 'SEARCHING',
        2 => 'VIEWING_HISTORY',
    }
};

my $debug_state = <nshell.debug_state>;

### [ initialize state tracking buffer for LLM-friendly debug output ]
##
if ( not exists <buffer.nshell-state-track> ) {
    <buffer.nshell-state-track.max_size> = 24 * 1024;    ## 24K buffer ##
    <[base.buffer.add_line]>->(
        qw| nshell-state-track |,
        sprintf( '=== nshell state tracking initialized [%s] ===',
            <[base.time]>->(9) )
    );
}

### [ helper: log debug event with timestamp ]
##
my $log_debug_event = sub {
    my ( $event_type, $details ) = @_;
    return unless <nshell.mode.no_tty_debug>;

    my $timestamp = <[base.anum_log_time]>->( 5, TRUE );
    my $log_line
        = sprintf( '[%s] %s: %s', $timestamp, $event_type, $details );

    <[base.buffer.add_line]>->( qw| nshell-state-track |, $log_line );
    <[base.buffer.add_line]>->( qw| no-tty-debug |,       $log_line );

    return;
};

### [ parse input: extract [Key1,Key2,...] or :Key1,Key2,...: sequences ]
##
my @tokens = ();
my $pos    = 0;
while ( $pos < length $character_string ) {
    my $char = substr( $character_string, $pos, 1 );

    if ( $char eq '[' ) {
        ## bracketed comma-separated key sequence: [Up,Down,Ctrl+o,Enter]
        my $close = index( $character_string, ']', $pos );
        if ( $close > $pos ) {
            my $key_spec_list
                = substr( $character_string, $pos + 1, $close - $pos - 1 );
            $pos = $close + 1;

            ## split by comma and map each key name
            foreach my $key_spec ( split m{,}, $key_spec_list ) {
                $key_spec
                    =~ s{^\s+|\s+$}{}g;    ## trim whitespace around each key
                if ( length $key_spec ) {
                    if ( exists $chr_map{$key_spec} ) {
                        push @tokens,
                            {
                            'type' => 'key',
                            'name' => $key_spec,
                            'byte' => $chr_map{$key_spec}
                            };
                    } else {
                        ## unknown key name
                        return {
                            'mode' => qw| false |,
                            'data' => "..unknown key name: [$key_spec].."
                        };
                    }
                }
            }
        } else {
            ## unclosed bracket
            return {
                'mode' => qw| false |,
                'data' => '..unclosed bracket in input..'
            };
        }
    } elsif ( $char eq ':' ) {
        ## colon-wrapped comma-separated key sequence: :Up,Down,Ctrl+o,Enter:
        my $close = index( $character_string, ':', $pos + 1 );
        if ( $close > $pos ) {
            my $key_spec_list
                = substr( $character_string, $pos + 1, $close - $pos - 1 );
            $pos = $close + 1;

            ## split by comma and map each key name
            foreach my $key_spec ( split m{,}, $key_spec_list ) {
                $key_spec
                    =~ s{^\s+|\s+$}{}g;    ## trim whitespace around each key
                if ( length $key_spec ) {
                    if ( exists $chr_map{$key_spec} ) {
                        push @tokens,
                            {
                            'type' => 'key',
                            'name' => $key_spec,
                            'byte' => $chr_map{$key_spec}
                            };
                    } else {
                        ## unknown key name
                        return {
                            'mode' => qw| false |,
                            'data' => "..unknown key name: [$key_spec].."
                        };
                    }
                }
            }
        } else {
            ## unclosed colon sequence - treat as literal colon
            push @tokens, { 'type' => 'char', 'byte' => $char };
            $pos++;
        }
    } else {
        ## literal text: any characters including spaces, newlines, etc
        push @tokens, { 'type' => 'char', 'byte' => $char };
        $pos++;
    }
}

### [ append tokens to debug input buffer ]
##
my $token_summary = '';
foreach my $token (@tokens) {
    my $byte = $token->{'byte'};
    ## append to debug input buffer (each token once)
    <nshell.buffer.debug_input> .= $byte;

    ## build summary for logging
    if ( $token->{'type'} eq 'key' ) {
        $token_summary .= '[' . $token->{'name'} . ']';
    } else {
        $token_summary .= $byte;
    }
}

## log the input event
$log_debug_event->(
    'INPUT',
    sprintf(
        'tokens=%d, data=%s',
        scalar(@tokens), substr( $token_summary, 0, 80 )
    )
) unless $is_debug_status_call;

### [ process queued keys : event.once drives event loop for processing ]
##

## diagnostic: state before processing
my $diag_editor = <nshell.state>->{'editor'};
$log_debug_event->(
    'PRE_PROCESS',
    sprintf(
        'debug_buf_len=%d, editor_buf="%s", editor_defined=%d, mode=%d',
        length( <nshell.buffer.debug_input> // '' ),
        substr( ( ( $diag_editor // {} )->{'buffer'} // '' ), 0, 40 ),
        ( defined $diag_editor ? 1 : 0 ),
        ( <nshell.state>->{'current_mode'} // 0 )
    )
) unless $is_debug_status_call;

## consume show_cursor_on_call phase if active [ first call after Enter ]
<[event.once]>->(0.07);

## diagnostic: state after first event.once
$diag_editor = <nshell.state>->{'editor'};
$log_debug_event->(
    'POST_ONCE_1',
    sprintf(
        'debug_buf_len=%d, editor_buf="%s", '
            . 'editor_defined=%d, mode=%d, hist_idx=%d',
        length( <nshell.buffer.debug_input> // '' ),
        substr( ( ( $diag_editor // {} )->{'buffer'} // '' ), 0, 40 ),
        ( defined $diag_editor ? 1 : 0 ),
        ( <nshell.state>->{'current_mode'}          // 0 ),
        ( <nshell.state>->{'current_history_index'} // -1 )
    )
) unless $is_debug_status_call;

## process the debug buffer [ keys consumed via event loop ]
my $iteration     = 0;
my $submitted_cmd = undef;
while ( length( <nshell.buffer.debug_input> // '' ) && $iteration < 20 ) {
    $iteration++;
    my $result = <[nshell.read_from_buffer]>;
    if ( defined $result and length $result ) {
        ## command was submitted [ Enter key processed ]
        ## route to cube same as shell_loop does
        my ($cube_sid) = keys <user.cube.session>->%*;
        if ( defined $cube_sid
            and exists $data{'session'}{$cube_sid} ) {
            $data{'session'}{$cube_sid}{'buffer'}{'output'}
                .= $result . "\n";
            $submitted_cmd = $result;
            $log_debug_event->( 'EXEC', "submitted: $result" );
        }
    }
    <[event.once]>->(0.02);
}

## diagnostic: state after processing loop
$diag_editor = <nshell.state>->{'editor'};
$log_debug_event->(
    'POST_LOOP',
    sprintf(
        'iterations=%d, debug_buf_len=%d, editor_buf="%s",'
            . ' editor_defined=%d, mode=%d, hist_idx=%d',
        $iteration,
        length( <nshell.buffer.debug_input> // '' ),
        substr( ( ( $diag_editor // {} )->{'buffer'} // '' ), 0, 40 ),
        ( defined $diag_editor ? 1 : 0 ),
        ( <nshell.state>->{'current_mode'}          // 0 ),
        ( <nshell.state>->{'current_history_index'} // -1 )
    )
) unless $is_debug_status_call;

STATUS_SECTION:

### [ read current nshell state ]
##
my $nshell_state  = <nshell.state>                           // {};
my $editor        = $nshell_state->{'editor'}                // {};
my $editor_buffer = $editor->{'buffer'}                      // '';
my $nav_mode      = $nshell_state->{'current_mode'}          // 0;
my $hist_idx      = $nshell_state->{'current_history_index'} // -1;

my $mode_name = 'UNKNOWN';
if ( exists $nshell_state->{'mode_names'}
    && ref( $nshell_state->{'mode_names'} ) eq qw| HASH | ) {
    $mode_name = $nshell_state->{'mode_names'}->{$nav_mode}
        if exists $nshell_state->{'mode_names'}->{$nav_mode};
}

### [ log state transition for LLM debugging ]
##
my $prev_mode = $debug_state->{'current_mode'};
my $curr_mode = $nav_mode;

if ( $prev_mode != $curr_mode ) {
    $log_debug_event->(
        'MODE_CHANGE',
        sprintf(
            '%s(%d) -> %s(%d)',
            $debug_state->{'mode_names'}->{$prev_mode} // 'UNKNOWN',
            $prev_mode, $mode_name, $curr_mode
        )
    );
}

## update debug state mirror
$debug_state->{'current_mode'}          = $curr_mode;
$debug_state->{'current_history_index'} = $hist_idx;
$debug_state->{'ctrl_o_start_position'}
    = $nshell_state->{'ctrl_o_start_position'};
$debug_state->{'ctrl_o_entries_added'}
    = $nshell_state->{'ctrl_o_entries_added'} // 0;
$debug_state->{'editor_buffer'} = $editor_buffer;

## log Ctrl+O relevant state
if ( defined $nshell_state->{'ctrl_o_start_position'} ) {
    $log_debug_event->(
        'CTRL_O_STATE',
        sprintf(
            'start_pos=%d, entries_added=%d, history_idx=%d',
            $nshell_state->{'ctrl_o_start_position'},
            $nshell_state->{'ctrl_o_entries_added'} // 0,
            $hist_idx
        )
    );
}

### [ prepare formatted state reply ]
##
my $state_transition_reply = sprintf(
    "\n  : nshell state after processing\n\n"
        . "  : current_mode        : %s (%d)\n"
        . "  : current_history_idx : %d\n"
        . "  : editor_buffer       : %s\n"
        . "  : ctrl_o_start_pos    : %s\n"
        . "  : ctrl_o_entries_add  : %d\n"
        . "  : preload_entry       : %d\n"
        . "  : .\n",
    $mode_name,
    $nav_mode,
    $hist_idx,
    (   length $editor_buffer
        ? "'"
            . substr( $editor_buffer, 0, 50 )
            . ( length $editor_buffer > 50 ? "..." : "" ) . "'"
        : "''"
    ),
    (   defined $nshell_state->{'ctrl_o_start_position'}
        ? $nshell_state->{'ctrl_o_start_position'}
        : 'undef'
    ),
    ( $nshell_state->{'ctrl_o_entries_added'}    // 0 ),
    ( $nshell_state->{'display_preloaded_entry'} // 0 )
);

return { 'mode' => qw| size |, 'data' => $state_transition_reply }

