## [:< ##

# name  = coding.cmd.drain
# descr = drain task queue + self-terminate [handover]
# note  = called via cube command during concurrent restart handover

<[base.logs]>->('coding draining: checking active tasks');

## mark as draining [ prevents new task acceptance ]
<coding.draining> = TRUE;

## count only active (non-completed, non-failed) tasks ##
my $remaining = 0;
if ( exists <coding.task.queue> ) {
    for my $task ( values <coding.task.queue>->%* ) {
        my $st = $task->{'execution'}{'status'} // '';
        $remaining++ unless $st eq 'completed' or $st eq 'failed';
    }
}

<[base.logs]>->( 'coding draining: %d tasks remaining', $remaining );

if ( $remaining == 0 ) {
    ## no tasks - can terminate immediately
    <[base.log]>->('coding: no active tasks, initiating self-termination');
    <[base.exit]>->(0);
} else {
    ## set up task check timer
    ## when queue reaches zero, self-terminate
    <coding.drain_check_timer> = <[event.add_timer]>->(
        {   'after'    => 1.0,
            'interval' => 1.0,
            'handler'  => qw| coding.handler.drain_check |,
            'data'     => {}
        }
    );
}

return { 'mode' => qw| true |, 'data' => 'draining initiated' };

