    # name = data.topology.interference.map.calculate_constructive_zone
    # desc = Topology calculation subroutine

    my ( $coord, $phase ) = @ARG;

    # Constructive interference based on position and phase alignment
    my ( $x, $y, $z ) = @$coord;

    # Standing wave calculation
    use constant PI => 3.14159265358979;
    my $wave
        = sin( $x * PI / 13 ) * sin( $y * PI / 13 ) * sin( $z * PI / 13 );
    my $phase_align = cos( ( $x + $y + $z + $phase ) * PI / 7 );

    return 0.5 + 0.5 * $wave * $phase_align;

