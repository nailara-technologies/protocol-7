## [:< ##

# name  = amos-term.fuse.get_window
# descr = Helper to resolve AMOS ID to window reference for FUSE

my $amos_id = shift;

return undef unless defined $amos_id;
$amos_id = uc($amos_id);

my $session_id = <amos-term.windows.by_amos>->{$amos_id};
return undef unless defined $session_id;

return <amos-term.windows.by_id>->{$session_id};

