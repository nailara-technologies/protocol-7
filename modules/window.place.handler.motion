## [:< ##

# name  = window.place.handler.motion
# descr = update geometry while dragging

my ( $id, $widget, $event ) = @ARG;

return TRUE if not defined $id;

my $inst = $data{window}{place}{instances}{$id};
return TRUE if not defined $inst;

## not dragging: update the hover cursor for resize-region feedback ##
if ( not $inst->{'drag'}{'active'} ) {
    my $hover
        = <[window.place.classify_region]>->( $id, $event->x, $event->y );
    <[window.place.set_hover_cursor]>->( $id, $widget, $hover );
    return TRUE;
}

## dragging: apply geometry from the event's root coordinates. the pointer ##
## poller also drives this same helper, so an active drag works even when  ##
## motion-notify events are not delivered on the first interaction.        ##
<[window.place.apply_drag]>->( $id, $event->x_root, $event->y_root );

return TRUE;

