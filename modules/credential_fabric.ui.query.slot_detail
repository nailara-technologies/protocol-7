## [:< ##

# name  = credential_fabric.ui.query.slot_detail
# descr = return full metadata for a single slot, or undef if unknown

my $params = shift             // {};
my $slot   = $params->{'slot'} // '';

return undef unless length $slot;

my $meta = <credential_fabric.registry>->{$slot};
return undef unless defined $meta;

## subscribers ##
my @subscribers;
my $subs_ref = <credential_fabric.rotation_subscribers>->{$slot} // [];
push @subscribers, @$subs_ref;

## wildcard subscribers ##
my $wild_ref = <credential_fabric.rotation_subscribers> {qw| * |} // [];
push @subscribers, @$wild_ref;

## dedupe ##
my %seen;
@subscribers = grep { not $seen{$ARG}++ } @subscribers;

my $rotate   = $meta->{'rotate'}     // {};
my $interval = $rotate->{'interval'} // qw| manual |;

return {
    'slot'            => $slot,
    'owner'           => $meta->{'owner'}       // qw| credential_fabric |,
    'type'            => $meta->{'type'}        // qw| api-key |,
    'sensitivity'     => $meta->{'sensitivity'} // qw| low |,
    'storage'         => $meta->{'storage'}     // qw| local |,
    'registered'      => $meta->{'registered'}  // '',
    'last_rotated'    => $meta->{'rotated'}     // qw| never |,
    'rotate_interval' => $interval,
    'subscribers'     => \@subscribers,
};

