# name  = coding.async.complete_task
# descr = wrapper for coding.async.complete (state machine interface)

my ($task_id) = @ARG;

return { success => FALSE, error => 'task_id required' }
    unless defined $task_id;

## retrieve state ##
my $state = <[coding.async.state_manager]>->( qw| get |, $task_id );
return { success => FALSE, error => "no state for $task_id" }
    unless defined $state;

## build result from state ##
my $result = {
    success => TRUE,
    result => $state->{'response_text'} // $state->{'final_content'}
        // $state->{'content'} // '',
    finish_reason => $state->{'finish_reason'} // qw| stop |,
    tool_calls    => $state->{'tool_calls'},
};

## call actual completion handler ##
return <[coding.async.complete]>->( $task_id, $result );

