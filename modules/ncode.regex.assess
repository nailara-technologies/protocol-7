## [:< ##

# name  = ncode.regex.assess
# descr = check if a transformation diff can become a regex pattern

my $params = shift // {};

my $input     = $params->{'input'}      // '';
my $output    = $params->{'output'}     // '';
my $context   = $params->{'context'}    // {};
my $file_type = $context->{'file_type'} // qw| module |;
my $namespace = $context->{'namespace'} // '';
my $task_id   = $context->{'task_id'}   // '';

return { 'mode' => qw| true |, 'data' => [] }
    if $input eq $output;

return { 'mode' => qw| false |, 'data' => 'no input provided' }
    unless length $input;

return { 'mode' => qw| false |, 'data' => 'no output provided' }
    unless length $output;

## compute line-by-line diff ##
my @input_lines  = split m|\n|, $input;
my @output_lines = split m|\n|, $output;

my @candidates;
my $change_idx = 0;

## simple lcs-based diff to find 1:1 line changes ##
my @changes = <[context.diff.find_line_changes]>->(
    {   'in'  => \@input_lines,
        'out' => \@output_lines
    }
);

foreach my $change (@changes) {
    my ( $old_line, $new_line ) = @$change{qw| old new |};

    ## attempt to extract regex pattern + replacement ##
    my $extracted = <[context.pattern.extract_from_change]>->(
        {   'old' => $old_line,
            'new' => $new_line
        }
    );

    next unless defined $extracted;

    ## assess generalizability ##
    my $generalizability = <[context.pattern.assess_generalizability]>->(
        {   'extracted'   => $extracted,
            'sample_line' => $old_line
        }
    );

    ## assign confidence based on complexity and context ##
    my $confidence = <[context.pattern.calculate_confidence]>->(
        {   'extracted'        => $extracted,
            'generalizability' => $generalizability
        }
    );

    ## build candidate pattern ##
    my $name = <[context.pattern.generate_name]>->(
        {   'extracted' => $extracted,
            'idx'       => $change_idx++
        }
    );

    my $candidate = {
        'name'          => $name,
        'descr'         => $extracted->{'descr'},
        'pattern'       => $extracted->{'pattern'},
        'replace'       => $extracted->{'replace'},
        'applicability' => {
            'file_type'  => $file_type,
            'confidence' => $confidence,
            'coverage'   => $generalizability->{'coverage'}
        },
        'origin'      => qw| llm-extracted |,
        'source_task' => $task_id,
        'note'        => $extracted->{'note'}
    };

    push @candidates, $candidate;
}

return {
    'mode' => qw| true |,
    'data' => \@candidates
};

