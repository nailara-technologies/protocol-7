## [:< ##

# name  = data.mount.fuse.spawn
# param = <hash_path> <mountpoint> [options]
# descr = fork a child process and start FUSE filesystem
# return = { mode => true/false, data => message }

require Socket;

my ( $hash_path, $mountpoint, $options ) = @ARG;

$options //= {};

# Validate arguments
return {
    'mode' => qw| false |,
    'data' => 'expected <hash_path> and <mountpoint> arguments'
    }
    unless defined $hash_path and defined $mountpoint;

# Ensure mountpoint exists and is a directory
return {
    'mode' => qw| false |,
    'data' => "mountpoint '$mountpoint' does"
        . " not exist or is not a directory"
    }
    unless -d $mountpoint;

## Check mount point ownership
#  [ fusermount requires user to own the mount point ]
my $mountpoint_stat = File::stat::stat($mountpoint);
if ( !$mountpoint_stat ) {
    return {
        'mode' => qw| false |,
        'data' => sprintf(
            "cannot stat mountpoint '%s': %s",
            $mountpoint, $OS_ERROR
        )
    };
}

if ( $mountpoint_stat->uid != $< ) {
    my $mp_owner = getpwuid( $mountpoint_stat->uid ) // qw| unknown |;
    my $cur_user = getpwuid($<)                      // qw| unknown |;
    return {
        'mode' => qw| false |,
        'data' => sprintf(
            "mountpoint '%s' is owned by user '%s' [uid %d], "
                . "but current user is '%s' [uid %d]. "
                . "fusermount requires the mount point"
                . " to be owned by the mounting user.",
            $mountpoint, $mp_owner, $mountpoint_stat->uid, $cur_user, $<
        )
    };
}

# Check if FUSE module is available
if ( !<data.fuse.capabilities.available> ) {
    return {
        'mode' => qw| false |,
        'data' =>
            'FUSE module [ Filesys::Fuse3 ] not available - install to use mount feature'
    };
}

## load Filesys::Fuse3 module on demand ##
if ( !<[base.perlmod.autoload]>->('Filesys::Fuse3') ) {
    return {
        'mode' => qw| false |,
        'data' => 'failed to load Filesys::Fuse3 module'
    };
}

# Check fusermount availability and permissions
my $fusermount_path;
for my $path (
    qw| /usr/bin/fusermount /bin/fusermount /usr/local/bin/fusermount |) {
    if ( -x $path ) {
        $fusermount_path = $path;
        last;
    }
}

if ( !$fusermount_path ) {
    return {
        'mode' => qw| false |,
        'data' => "fusermount not found. Install fuse-utils or fuse package."
    };
}

# Check if fusermount is setuid (required for non-root users)
my $fusermount_stat = File::stat::stat($fusermount_path);
if ( $< != 0 && !( $fusermount_stat->mode & 04000 ) ) {
    <[base.s_warn]>->(
        'fusermount at %s is not setuid root - unmount may fail',
        $fusermount_path
    );
}

# Check /etc/fuse.conf for user_allow_other if allow_other requested
my $allow_other = $options->{'allow_other'} // 0;
if ($allow_other) {
    my $fuse_conf            = qw| /etc/fuse.conf |;
    my $has_user_allow_other = 0;
    if ( -r $fuse_conf ) {
        open( my $fh, '<', $fuse_conf )
            or <[base.s_warn]>->(
            'cannot read %s : %s',
            $fuse_conf, <[base.str.os_err]>
            );
        while (<$fh>) {
            $has_user_allow_other = 1 if m|^\s*user_allow_other|;
        }
        close($fh);
    }
    if ( !$has_user_allow_other ) {
        return {
            'mode' => qw| false |,
            'data' => sprintf(
                "allow_other option requested but 'user_allow_other' is not "
                    . "enabled in %s. Add 'user_allow_other' to that file as"
                    . " root, or remove the allow_other option.",
                $fuse_conf
            )
        };
    }
}

# Get current session for child communication
my ($session_id) = keys <user.cube.session>->%*;

<[base.logs]>->( "forking FUSE child for %s at %s", $hash_path, $mountpoint );

# Create socketpair for parent-child communication
socketpair(
    my $child_pipe,      my $parent_pipe, Socket::AF_UNIX,
    Socket::SOCK_STREAM, Socket::PF_UNSPEC
    )
    || return {
    'mode' => qw| false |,
    'data' => sprintf( "can't create socketpair : %s", <[base.str.os_err]> )
    };

map { binmode($ARG) } ( $child_pipe, $parent_pipe );
map { $data{'handle'}{$ARG}{'link'} = qw| ipc.pipe | }
    ( $child_pipe, $parent_pipe );

# Store mount parameters for child
my %mount_info = (
    'hash_path'   => $hash_path,
    'mountpoint'  => $mountpoint,
    'started'     => time(),
    'allow_other' => $allow_other,
);

# Fork the child process
my $child_pid = <[base.fork]>;

if ( !$child_pid ) {    ## CHILD PROCESS ##
    close($child_pipe);

    # Reinit IO::AIO for child process
    IO::AIO::reinit() if defined &IO::AIO::reinit;

    # Null out SIGCHLD handler - child doesn't need it
    <[event.add_signal]>->( { 'signal' => 'CHLD', 'handler' => 'dev.null' } );

    # Update process name
    my $subname = <system.zenka.subname>;
    my $sn_str  = defined $subname ? ':' . $subname : '';
    <system.zenka.subname> = sprintf 'fuse-child%s', $sn_str;
    $PROGRAM_NAME = sprintf '%s[fuse%s]', <system.zenka.name>, $sn_str;

    # Silence child shutdown logging
    <callback.session.closing_last.params>->[1] = 1;
    $data{'session'}{$session_id}{'shutdown'} = TRUE if defined $session_id;

    # Set up logging to route through parent
    <buffer.zenka.log_cmd> = qw| p7-log.append |;

    # Remove parent-only access entries
    delete <access.cmd.usr.cube>;
    delete <access.cmd.regex.usr.cube>;

    # Set up session for parent communication
    $data{'handle'}{$parent_pipe}{'mode'} = qw| out |;
    unshift <protocol-7.network.parent_route>->@*, qw| parent |;

    my $id = <[base.session.init]>->(
        $parent_pipe, qw| protocol-7 client parent |
    );

    $data{'session'}{$id}{'input'}{'handler'} = qw| base.handler.command |;

    # Initialize FUSE-specific data structures in child
    <data.fuse.current_mount>  = \%mount_info;
    <data.fuse.root_hash_path> = $hash_path;

    <[base.logs]>->(
        2,          "FUSE child starting : %s --> %s",
        $hash_path, $mountpoint
    );

    # Prepare FUSE callbacks with proper path resolution
    # The key insight: FUSE paths are relative to the mountpoint,
    # so we need to prepend the root hash_path for resolution

    my $cb_getattr = sub {
        my $fuse_path = shift;

        # Convert FUSE path (e.g., /uploads/documents) to full hash path
        # by combining with root hash path (e.g., user.taeki.files)
        my $full_hash_path;
        if ( $fuse_path eq qw| / | ) {
            $full_hash_path = $hash_path;
        } else {

            # Remove leading / and convert / to .
            ( my $rel_path = $fuse_path ) =~ s|^/||;
            $rel_path =~ s|/|.|g;
            $full_hash_path = join '.', $hash_path, $rel_path;
        }

        # Resolve the full path to check existence and type
        my $ref = <[data.resolve_hash_path]>->($full_hash_path);
        return ( -ENOENT() ) unless defined $ref;

        # Now call the actual getattr with proper context
        return <[data.mount.fuse.getattr]>->($fuse_path);
    };

    my $cb_readdir = sub {
        my $fuse_path = shift;
        return <[data.mount.fuse.readdir]>->($fuse_path);
    };

    my $cb_read = sub {
        my ( $fuse_path, $size, $offset ) = @ARG;
        return <[data.mount.fuse.read]>->( $fuse_path, $size, $offset );
    };

    my $cb_open = sub {
        my ( $fuse_path, $flags ) = @ARG;
        return <[data.mount.fuse.open]>->( $fuse_path, $flags );
    };

    my $cb_release = sub {
        my ( $fuse_path, $flags ) = @ARG;
        return <[data.mount.fuse.release]>->( $fuse_path, $flags );
    };

    my $cb_statfs = sub {
        my $fuse_path = shift;
        return <[data.mount.fuse.statfs]>->($fuse_path);
    };

    # Build mount options
    my @mount_opts = (
        'mountpoint' => $mountpoint,
        'getattr'    => $cb_getattr,
        'readdir'    => $cb_readdir,
        'read'       => $cb_read,
        'open'       => $cb_open,
        'release'    => $cb_release,
        'statfs'     => $cb_statfs,
        'debug'      => $options->{'debug'} // 0,
        'threaded'   => 0,
    );

    # Build mountopts string for FUSE3 kernel options
    my @mountopts;
    push @mountopts,  'allow_other' if $allow_other;
    push @mountopts,  'default_permissions';
    push @mount_opts, 'mountopts' => join( ',', @mountopts ) if @mountopts;

    # Start FUSE main loop
    <[base.logs]>->( 2, "Entering FUSE3 main loop for %s", $mountpoint );

    eval { Filesys::Fuse3::main(@mount_opts); };

    if ( length $EVAL_ERROR ) {
        <[base.logs]>->(
            0, "FUSE3 main loop error : %s",
            <[base.str.eval_error]>
        );
    }

    <[base.logs]>->( 2, "FUSE3 child exiting for %s", $mountpoint );
    <[base.exit]>;

} else {    ## PARENT PROCESS ##
    close($parent_pipe);

    # Remove child-only access entries
    delete <access.cmd.usr.parent>;
    delete <access.cmd.regex.usr.parent>;

    # Set up session for child communication
    $data{'handle'}{$child_pipe}{'mode'} = qw| out |;
    my $id = <[base.session.init]>
        ->( $child_pipe, qw| protocol-7 client child | );

    $data{'session'}{$id}{'input'}{'handler'} = qw| base.handler.command |;
    $data{'session'}{$id}{'authenticated'} = qw| yes |;

    # Authenticate cube session
    $data{'session'}{$session_id}{'authenticated'} = qw| yes |
        if defined $session_id;

    # Register mount in parent registry
    <data.fuse.mounts> {$mountpoint} = {
        'pid'         => $child_pid,
        'hash_path'   => $hash_path,
        'session_id'  => $id,
        'started'     => <[base.time]>,
        'allow_other' => $allow_other,
    };

    push <data.fuse.child_pids>->@*, $child_pid;

    <[base.logs]>->(
        2, "FUSE3 mount registered : %s at %s [pid %d]",
        $hash_path, $mountpoint, $child_pid
    );

    my $result_data = sprintf( "FUSE3 mount started: %s at %s [pid %d]",
        $hash_path, $mountpoint, $child_pid );
    $result_data .= " [allow_other enabled]" if $allow_other;

    return {
        'mode' => qw| true |,
        'data' => $result_data
    };
}

