# name = data.mount.shm.permission.verify.rights_sufficient
# descr = Check if allowed rights cover requested rights

my ( $requested, $allowed ) = @ARG;

my %allowed = map { $_ => 1 } @$allowed;

for my $right (@$requested) {
    return 0 unless $allowed{$right};
}

return 1;

