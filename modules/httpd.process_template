## [:< ##

# name = httpd.process_template
# descr = process template file - offloads recursive parsing to web zenka

my $session_id    = shift // '';
my $template_path = shift // '';
die "expected valid session id" if not defined $data{'session'}{$session_id};
my $session = $data{'session'}{$session_id};
die "expected template file path argument" if !length($template_path);
die "template file not found"              if !-f $template_path;
my $response_params = $session->{'response'}->{'params'};
my $content_date    = time2str( int( $session->{'start_time'} ) );
my $content_type    = qw| text/plain |;
$content_type = qw| text/html | if $template_path =~ m{\.(html|tmpl)$};
my $site_dir = <httpd.site_dir>;
( my $template_path_rel = $template_path ) =~ s{$site_dir/*}{};

# LLL: ;charset=...

<[base.logs]>->( 1, '[%s] <-- < web zenka >', $template_path_rel );

## Load template content ##
my $template_content = <[file.slurp]>->($template_path)->$*;

unless ( defined $template_content ) {
    <[base.logs]>->(
        0,           "[%d] failed to read template : %s",
        $session_id, $template_path
    );
    return <[httpd.send_error_page]>->( $session_id, 500 );
}

## Store template processing state in session ##
$session->{'content'} = {
    'date'          => $content_date,
    'type'          => $content_type,
    'complete'      => 0,
    'template_path' => $template_path,
};

## Generate unique template ID for tracking ## [LLL] improve algorithm [LLL]
my $template_id = sprintf( qw| httpd_%s_%d |,
    <[chk-sum.elf.vax-BASE32]>->($template_path),
    <[base.time]> );

## Prepare meta variables from session ##
my $meta_vars = $session->{'meta'} // {};

## Serialize meta variables for IPC transmission ##
## Encode meta vars as JSON then base32r to avoid delimiter conflicts
my $meta_json = <[httpd.json.encode]>->($meta_vars) // qw| {} |;
my $meta_b32r = encode_b32r($meta_json);

## Encode template content as base32r to
## avoid colon delimiter conflicts in IPC
my $template_b32r = encode_b32r($template_content);

<[base.logs]>->(
    2, "[%d] offloading template to web zenka : %s [%03d bytes]",
    $session_id, $template_id, length($template_content)
);

## Send template to web zenka for recursive processing ##
<[protocol-7.command.send.local]>->(
    {   'command'   => qw| cube.web.process_template_ipc |,
        'call_args' => {
            'args' => join( qw| : |,
                $template_id, $template_b32r, $meta_b32r, $session_id )
        },
        'reply' => {
            'handler' => qw| httpd.handler.web_template_reply |,
            'params'  => {
                'client_sid'  => $session_id,
                'template_id' => $template_id,
            }
        }
    }
);

<[base.logs]>->(
    3,           "[%d] template processing request sent to web zenka [%s]",
    $session_id, $template_id
);

return 1;    ## Keep connection alive, waiting for web zenka reply ##

