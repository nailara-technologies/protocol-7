# name  = coding.callback.object_model_discovery
# descr = Dependency callback to check if model discovery completed

my $object_id = shift;
<[base.logs]>->(
    3,
    '[callback.model_discovery] checking object_id=%s',
    $object_id // 'undef'
);
return undef unless exists <dependency.object>->{$object_id};

my $object = <dependency.object>->{$object_id};

## Check if discovery has been marked complete ##
my $status = $object->{'status'} // 'pending';

return TRUE if $status eq 'complete';
return FALSE;

