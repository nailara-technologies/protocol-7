## [:< ##

# name  = base.language.detect
# descr = layered language detection: heuristic → wordlist → inference

my $text = shift // '';
my $opts = shift // {};

return { language => '', confidence => 0, method => 'none' }
    unless length $text;

my $hint = lc( $opts->{'hint'} // '' );

##[ LAYER 1 : HEURISTIC ]######################################################

my $result = <[base.language.heuristic]>->($text);

## hint confirmation: if heuristic agrees with hint, boost confidence ##
if ( length $hint and $result->{'language'} eq $hint ) {
    $result->{'confidence'} = 0.95;
    $result->{'method'}     = 'heuristic+hint';
    return $result;
}

## accept heuristic if confident enough ##
return $result if $result->{'confidence'} >= 0.75;

##[ LAYER 2 : WORDLIST ]#######################################################
## activated when layer 1 confidence below threshold ##

my $wordlist_result = _wordlist_detect( $text, $result );

## hint confirmation at layer 2 ##
if ( length $hint
    and $wordlist_result->{'language'} eq $hint ) {
    $wordlist_result->{'confidence'} = 0.92;
    $wordlist_result->{'method'}     = 'wordlist+hint';
    return $wordlist_result;
}

return $wordlist_result if $wordlist_result->{'confidence'} >= 0.70;

##[ LAYER 3 : INFERENCE FALLBACK ]#############################################
## model query + cache : stub for now ##

my $inference_result = {
    language => $wordlist_result->{'language'} || $result->{'language'} || '',
    confidence   => 0.45,
    method       => 'inference-stub',
    alternatives => $result->{'alternatives'} // [],
};

## if we have a hint and nothing else worked, fall back to hint ##
if ( length $hint and not length $inference_result->{'language'} ) {
    $inference_result->{'language'}   = $hint;
    $inference_result->{'confidence'} = 0.30;
    $inference_result->{'method'}     = 'hint-fallback';
}

return $inference_result;

##[ LAYER 2 HELPER ]###########################################################

sub _wordlist_detect {
    my ( $txt, $heuristic ) = @_;

    my $leader = $heuristic->{'language'} // '';
    return { language => '', confidence => 0, method => 'wordlist' }
        unless length $leader;

    ## check for installed wordlist ##
    my $wl_path = "data/language/wordlist/$leader.txt";
    if ( not -f $wl_path ) {
        ## no wordlist : charmap-only result from heuristic ##
        return {
            language     => $leader,
            confidence   => $heuristic->{'confidence'},
            method       => 'charmap',
            wordlist     => 0,
            alternatives => $heuristic->{'alternatives'} // [],
        };
    }

    ## load wordlist into hash for fast lookup ##
    my %words = ();
    if ( open my $fh, '<', $wl_path ) {
        while ( my $w = <$fh> ) {
            chomp($w);
            $words{ lc($w) } = 1 if length $w;
        }
        close $fh;
    }

    ## tokenize and score ##
    my @tokens = ( $txt =~ m{\b\w+\b}g );
    my $total  = scalar @tokens;
    return { language => $leader, confidence => 0, method => 'wordlist' }
        unless $total > 0;

    my $matched = 0;
    for my $t (@tokens) {
        $matched++ if exists $words{ lc($t) };
    }

    my $hit_ratio = $matched / $total;

    ## also score alternatives ##
    my %alt_scores = ( $leader => $hit_ratio );
    for my $alt ( @{ $heuristic->{'alternatives'} // [] } ) {
        my $alt_path = "data/language/wordlist/$alt.txt";
        next unless -f $alt_path;
        my %alt_words = ();
        if ( open my $fh, '<', $alt_path ) {
            while ( my $w = <$fh> ) {
                chomp($w);
                $alt_words{ lc($w) } = 1 if length $w;
            }
            close $fh;
        }
        my $alt_matched = 0;
        for my $t (@tokens) {
            $alt_matched++ if exists $alt_words{ lc($t) };
        }
        $alt_scores{$alt} = $alt_matched / $total;
    }

    ## rank by hit ratio ##
    my @ranked = sort { $alt_scores{$b} <=> $alt_scores{$a} }
        keys %alt_scores;
    my $winner    = $ranked[0];
    my $winner_hr = $alt_scores{$winner}      // 0;
    my $runner_hr = $alt_scores{ $ranked[1] } // 0;
    my $gap       = $winner_hr - $runner_hr;

    my $conf = 0.50;
    if ( $winner_hr > 0.35 and $gap > 0.15 ) {
        $conf = 0.85;
    } elsif ( $winner_hr > 0.25 and $gap > 0.10 ) {
        $conf = 0.70;
    } elsif ( $winner_hr > 0.15 ) {
        $conf = 0.55;
    }

    return {
        language     => $winner,
        confidence   => $conf,
        method       => 'wordlist',
        hit_ratio    => $winner_hr,
        alternatives => [ grep { $_ ne $winner } @ranked ],
    };
}

