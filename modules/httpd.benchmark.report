# name = httpd.benchmark.report
# descr = generate http benchmark report

# We're not declaring or importing $data since it's already available in the context
# where this module is executed

my $params = shift // {};

# Skip if benchmark tracking is disabled
return {} if !$data{'httpd'}{'benchmark'}{'enabled'};

