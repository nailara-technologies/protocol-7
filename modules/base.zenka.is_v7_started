# name  = base.zenka.is_v7_started
# descr = Check if currently running in a v7 zenka context
# return = 1 if running in v7 zenka, 0 otherwise

## Check if zenka type is set to a v7-related type
my $is_v7 = defined <system.zenka.type> && (
    <system.zenka.type> eq 'v7' ||
    <system.zenka.type> eq 'v7-started-zenka' ||
    <system.zenka.type> eq 'cube'
);

return $is_v7 ? 1 : 0;

