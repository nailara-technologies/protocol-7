## [:< ##

# name  = base.zenka.is_v7_started
# descr = Check if currently running in a v7 zenka context
# return = TRUE [5] if running in v7 zenka, FALSE [0] otherwise

## Check if zenka type is set to a v7-related type
my $is_v7 = defined <system.zenka.type>
    && ( <system.zenka.type> eq qw| v7-started-zenka |
    || <system.zenka.type> eq qw| cube |
    || <system.zenka.type> eq qw| v7 | );

return $is_v7 ? TRUE : FALSE;

