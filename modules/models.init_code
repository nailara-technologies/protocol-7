## [:< ##

# name = models.init_code
# descr = Models zenka initialization: registries, lists, operation logs, command dispatcher

my $reinit = shift // TRUE;   ### provided by 'base.init_modules' [TRUE|FALSE]
my $already_initialized = $reinit;    ## use for skipping redundant calls.. ##
my $first_init          = $already_initialized ? FALSE : TRUE; ## ^ inverse ##

## load all additionally used perl modules ##
#
<[base.perlmod.autoload]>->(qw|  JSON::PP  |);
<[base.perlmod.autoload]>->(qw|  YAML::XS  |);
<[base.perlmod.autoload]>->(qw| YAML::Tiny |);

## Ensure zenka directories exist with proper permissions and ownership
<[base.path-set-up.check-zenka-paths]>->(TRUE);

# =============================================================================
# DATA STRUCTURES - Initialize in %data hash
# =============================================================================

# Initialize models namespace
$data{'models'}        //= {};
<models.operation_log> //= [];
<models.error_log>     //= [];
<models.action_log>    //= [];
<models.definitions>   //= {};    # Will be loaded from YAML
<models.aliases>       //= {};    # Will be loaded from YAML

# =============================================================================
# LIST DEFINITIONS - Register with Protocol-7 list system
# =============================================================================

## model discovery scan path registry ##
#
<models.scan_paths> //= {}; ## initialize ## [ <models.storage.search_paths> ]
<list.scan-paths> = {
    'var'   => qw| data |,
    'key'   => qw| models.scan_paths |,
    'mask'  => '<key>:id dir_path:scan-path',
    'align' => {
        'id'       => qw| left+1 |,
        'dir_path' => qw| left+2 |
    },
    'descr' => 'model scan paths and their path-ids'
};

## model path and data registry ##
#
<list.models> = {
    'var'  => qw| data |,
    'key'  => qw| models.registry |,
    'mask' =>
        '<key>:id name quantization:quant size_gb:size_GB is_vision:vision source',
    'align' => {
        'id'           => qw|  left+1  |,
        'name'         => qw|  left+2  |,
        'quantization' => qw| center-1 |,
        'size_gb'      => qw|  right-6 |,
        'is_vision'    => qw| center-1 |,
        'source'       => qw|  center  |
    },
    'filters' => {
        'is_vision' => qw| models.parser.yes_no |,

#       'size_gb'   => qw| models.parser.size_gb | ## [LLL] update to numerical ##
    },
    'sort_key' => qw| reverse-num:size_gb |,
    'descr'    => 'registered models with checksums and metadata'
};

# =============================================================================
# LOG BUFFERS - Named log buffers for audit trail and operation tracking
# =============================================================================

# Initialize operation log buffer if not already created
if ( not exists <buffer.models-operation> ) {
    <buffer.models-operation.max_size> = 64 * 1024;    # 64K buffer
    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
    <[base.buffer.add_line]>->(
        qw| models-operation |,
        join( ' ', $time_stamp, 0, 'operation log buffer initialized' ), 0
    );
}

# Initialize error log buffer
if ( not exists <buffer.models-error> ) {
    <buffer.models-error.max_size> = 32 * 1024;        # 32K buffer
    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
    <[base.buffer.add_line]>->(
        qw| models-error |,
        join( ' ', $time_stamp, 0, 'error log buffer initialized' ), 0
    );
}

# Initialize action log buffer
if ( not exists <buffer.models-action> ) {
    <buffer.models-action.max_size> = 48 * 1024;       # 48K buffer
    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
    <[base.buffer.add_line]>->(
        qw| models-action |,
        join( ' ', $time_stamp, 0, 'action log buffer initialized' ), 0
    );
}

# Load model configuration from YAML
<[models.config.loader]>;

# Initialize model search paths for discovery
unless ( exists <models.storage.search_paths> ) {
    <models.storage.search_paths> = [
        {   path      => qw| /mnt/ext-xfs-data/models-lmstudio |,
            enabled   => TRUE,
            recursive => TRUE,
            tier      => 2
        },
        {   path      => qw| /mnt/ext-xfs-data/models-invoke |,
            enabled   => TRUE,
            recursive => TRUE,
            tier      => 4
        },
        {   path      => '/data/models',
            enabled   => TRUE,
            recursive => FALSE,
            tier      => 5
        }
    ];
}

## Initialize conversations storage directory
<models.storage.conversations_dir>
    //= catdir( <system.conf_path>, qw| conversations | );

# Statistics aggregation state
$data{models}{stats_aggregation_pending}  = 0;
$data{models}{last_stats_aggregation}     = 0;
$data{models}{maintenance_time_available} = 0;

# Cache for frequently accessed registry
$data{models}{registry_cache}     = {};
$data{models}{cache_last_updated} = 0;
$data{models}{cache_ttl_seconds}  = 300;

# =============================================================================
# TEMPLATE & CONVERSATION METRICS
# =============================================================================

# Template processing metrics
<models.metrics> //= {};

<models.metrics.substitutions_total>      //= 0;
<models.metrics.substitutions_completed>  //= 0;
<models.metrics.avg_substitution_time_ms> //= 0;

# Conversation metrics (for multi-turn interactions)
<models.metrics.conversations_active>    //= 0;
<models.metrics.conversations_completed> //= 0;
<models.metrics.context_compactions>     //= 0;

# =============================================================================
# CONVERSATION MANAGEMENT - Registry for active conversations
# =============================================================================

## Conversation registry: maps job_id to conversation state
<models.conversations> //= {};

# =============================================================================
# REGISTRY POPULATION - Initialize empty registry [ populated by discover cmd ]
# =============================================================================

# Initialize registry from pre-configured definitions
# Discovered models will be added on-demand via discover_files command
unless ( exists <models.registry> ) {
    <[models.registry.init_from_definitions]>;
}

return 0;    # Module initialization successful

