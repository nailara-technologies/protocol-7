## [:< ##

# name = models.init_code
# descr = Models zenka initialization: registries, lists, operation logs, command dispatcher

<[base.perlmod.autoload]>->(qw| JSON::PP |);

# =============================================================================
# DATA STRUCTURES - Initialize in %data hash
# =============================================================================

# Initialize operation logs for audit trail in models namespace
$data{models} //= {};
$data{models}{operation_log} = [];
$data{models}{error_log} = [];
$data{models}{action_log} = [];

# Statistics aggregation state
$data{models}{stats_aggregation_pending} = 0;
$data{models}{last_stats_aggregation} = 0;
$data{models}{maintenance_time_available} = 0;

# Cache for frequently accessed registry
$data{models}{registry_cache} = {};
$data{models}{cache_last_updated} = 0;
$data{models}{cache_ttl_seconds} = 300;

# =============================================================================
# LIST DEFINITIONS FOR VISIBILITY
# =============================================================================

# List definition for operation log
$data{list}{models_operation_log} = {
  'var' => 'data',
  'key' => 'models-operation_log',
  'mask' => 'timestamp:time action:op status:state details:info',
  'descr' => '[operations] models zenka action history',
};

# List definition for error log
$data{list}{models_error_log} = {
  'var' => 'data',
  'key' => 'models-error_log',
  'mask' => 'timestamp:time error:err model:info details:info',
  'descr' => '[errors] models zenka error log',
};

# List definition for action log
$data{list}{models_action_log} = {
  'var' => 'data',
  'key' => 'models-action_log',
  'mask' => 'timestamp:time actor:usr action:op status:state',
  'descr' => '[actions] admin/parent actions on models zenka',
};

# =============================================================================
# MAIN COMMAND ENTRY POINT
# =============================================================================

# Parse command and dispatch - this block runs when a command is received
{
  my $cmd = shift @ARG;
  my @args = @ARG;

  # If no command, this is module initialization - return success
  if (!$cmd) {
    return 0;  # Module initialization successful (0 means success)
  }

  # Log action in models namespace
  push @{$data{models}{action_log}}, {
    timestamp => time(),
    actor => 'system',
    action => $cmd,
    status => 'pending',
  };

  # Route to command handlers via module loading
  my $result;

  if ($cmd eq 'status') {
    # Status command - delegate to command module
    unshift @ARG, $cmd, @args;
    $result = <[models.cmd.status]>;
  } elsif ($cmd eq 'reload') {
    # Reload command - delegate to base handler which returns proper format
    unshift @ARG, $cmd, @args;
    $result = <[base.cmd.reload]> // {
      'mode' => qw| size |,
      'data' => "error: base.cmd.reload not available\n",
    };
    return $result;
  } elsif ($cmd eq 'maintenance') {
    # Maintenance command - delegate to command module
    unshift @ARG, $cmd, @args;
    $result = <[models.cmd.maintenance]>;
  } elsif ($cmd =~ /^(get|find|recommend|record|stats|cost|discover|list)/) {
    # Route to command modules
    my $module;
    if ($cmd eq 'get') {
      $module = 'models.cmd.get_model';
    } elsif ($cmd eq 'find') {
      $module = 'models.cmd.find_models';
    } elsif ($cmd eq 'recommend' || $cmd eq 'rec') {
      $module = 'models.cmd.recommend';
    } elsif ($cmd eq 'record') {
      $module = 'models.cmd.record_invocation';
    } elsif ($cmd eq 'stats') {
      $module = 'models.cmd.statistics';
    } elsif ($cmd eq 'cost') {
      $module = 'models.cmd.cost_analysis';
    } elsif ($cmd eq 'discover' || $cmd eq 'list') {
      $module = 'models.cmd.discover';
    }

    # Load and execute the module
    unshift @ARG, $cmd, @args;  # Restore @ARG for the module
    $result = <[$module]> // {
      'mode' => qw| size |,
      'data' => "error: module not found: $module\n",
    };
  } else {
    # Unknown command
    $result = {
      'mode' => qw| size |,
      'data' => "error: unknown command: $cmd\n",
    };
  }

  # Update action log in models namespace
  if (@{$data{models}{action_log}} && $result) {
    my $last_action = $data{models}{action_log}->[-1];
    my $is_success = $result->{data} && $result->{data} !~ /^error:/;
    $last_action->{status} = $is_success ? 'completed' : 'failed';
  }

  # Log operation in models namespace
  my $is_success = $result && $result->{data} && $result->{data} !~ /^error:/;
  push @{$data{models}{operation_log}}, {
    timestamp => time(),
    action => $cmd // 'status',
    status => $is_success ? 'success' : 'failure',
    details => ($result && $result->{data}) ? substr($result->{data}, 0, 100) : 'no response',
  };

  return $result;
};

