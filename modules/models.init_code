## [:< ##

# name = models.init_code
# descr = Models zenka initialization: registries, lists, operation logs, command dispatcher

<[base.perlmod.autoload]>->(qw| JSON::PP |);

# =============================================================================
# DATA STRUCTURES - Initialize in %data hash
# =============================================================================

# Initialize operation logs for audit trail
$data{operation_log} = [];
$data{error_log} = [];
$data{action_log} = [];

# Statistics aggregation state
$data{stats_aggregation_pending} = 0;
$data{last_stats_aggregation} = 0;
$data{maintenance_time_available} = 0;

# Cache for frequently accessed registry
$data{registry_cache} = {};
$data{cache_last_updated} = 0;
$data{cache_ttl_seconds} = 300;

# =============================================================================
# LIST DEFINITIONS FOR VISIBILITY
# =============================================================================

# List definition for operation log
$data{list}{operation_log} = {
  'var' => 'data',
  'key' => 'operation_log',
  'mask' => 'timestamp:time action:op status:state details:info',
  'descr' => '[operations] models zenka action history',
};

# List definition for error log
$data{list}{error_log} = {
  'var' => 'data',
  'key' => 'error_log',
  'mask' => 'timestamp:time error:err model:info details:info',
  'descr' => '[errors] models zenka error log',
};

# List definition for action log
$data{list}{action_log} = {
  'var' => 'data',
  'key' => 'action_log',
  'mask' => 'timestamp:time actor:usr action:op status:state',
  'descr' => '[actions] admin/parent actions on models zenka',
};

# =============================================================================
# MAIN COMMAND ENTRY POINT
# =============================================================================

# Parse command and dispatch - this block runs when a command is received
{
  my $cmd = shift @ARG;
  my @args = @ARG;

  # If no command, this is module initialization - return success
  if (!$cmd) {
    return 0;  # Module initialization successful (0 means success)
  }

  # Log action
  push @{$data{action_log}}, {
    timestamp => time(),
    actor => 'system',
    action => $cmd,
    status => 'pending',
  };

  # Route to command handlers via module loading
  my $result = {
    'success' => FALSE,
    'error' => "unknown command: $cmd",
  };

  if ($cmd eq 'status') {
    # Status command - directly return status
    $result = {
      'success' => TRUE,
      'zenka' => 'models',
      'status' => 'running',
      'operation_log_entries' => scalar(@{$data{operation_log}}),
      'error_log_entries' => scalar(@{$data{error_log}}),
      'action_log_entries' => scalar(@{$data{action_log}}),
      'timestamp' => time(),
    };
  } elsif ($cmd eq 'reload') {
    # Reload command
    $data{registry_cache} = {};
    $data{cache_last_updated} = 0;
    push @{$data{operation_log}}, {
      timestamp => time(),
      action => 'reload',
      status => 'completed',
      details => 'configuration and registry reloaded',
    };
    $result = {
      'success' => TRUE,
      'reloaded' => 1,
      'timestamp' => time(),
    };
  } elsif ($cmd eq 'maintenance') {
    # Maintenance command
    my $start_time = time();
    my $elapsed = time() - $start_time;
    push @{$data{operation_log}}, {
      timestamp => time(),
      action => 'maintenance',
      status => 'completed',
      details => "maintenance completed in ${elapsed}s",
    };
    $result = {
      'success' => TRUE,
      'maintenance_completed' => 1,
      'elapsed_seconds' => $elapsed,
    };
  } elsif ($cmd =~ /^(get|find|recommend|record|stats|cost|discover|list)/) {
    # Route to command modules
    my $module;
    if ($cmd eq 'get') {
      $module = 'models.cmd.get_model';
    } elsif ($cmd eq 'find') {
      $module = 'models.cmd.find_models';
    } elsif ($cmd eq 'recommend' || $cmd eq 'rec') {
      $module = 'models.cmd.recommend';
    } elsif ($cmd eq 'record') {
      $module = 'models.cmd.record_invocation';
    } elsif ($cmd eq 'stats') {
      $module = 'models.cmd.statistics';
    } elsif ($cmd eq 'cost') {
      $module = 'models.cmd.cost_analysis';
    } elsif ($cmd eq 'discover' || $cmd eq 'list') {
      $module = 'models.cmd.discover';
    }

    # Load and execute the module
    unshift @ARG, $cmd, @args;  # Restore @ARG for the module
    $result = <[$module]> // {
      'success' => FALSE,
      'error' => "module not found: $module",
    };
  }

  # Update action log
  if (@{$data{action_log}}) {
    my $last_action = $data{action_log}->[-1];
    $last_action->{status} = $result->{success} ? 'completed' : 'failed';
  }

  # Log operation
  push @{$data{operation_log}}, {
    timestamp => time(),
    action => $cmd // 'status',
    status => $result->{success} ? 'success' : 'failure',
    details => $result->{error} // 'completed',
  };

  return $result;
};

