## [:< ##

# name  = context.file
# descr = return content of a specific file, truncated to budget
# usage = <[context.file]>->( { path => 'modules/base.handler.command',
#                       budget => 2000, from_line => 1, to_line => 100 } )

my $params = shift // {};

my $path              = $params->{'path'}              // '';
my $budget            = $params->{'budget'}            // 2000;
my $from_line         = $params->{'from_line'}         // 1;
my $to_line           = $params->{'to_line'}           // 0;
my $show_line_numbers = $params->{'show_line_numbers'} // 0;

my $char_budget = int( $budget * 4 );

## validate path ##
unless ( length($path) ) {
    return "<!-- no path specified -->";
}

## sanitize path (prevent path traversal) ##
$path =~ s|\.\./||g;

## absolute paths are used as-is [ matches pager.source.file-list /   ##
## list_files, which already honors a leading '/' — jobsite and other ##
## zenki keep real config/data outside the repo, e.g.                 ##
## /etc/protocol-7/jobsite/profile.txt ] ; relative paths resolve     ##
## against the project root as before                                 ##
my $root     = <system.root_path>;
my $abs_path = $path =~ m|^/| ? $path : catfile( $root, $path );

## check if path exists and is a file ##
if ( -d $abs_path ) {
    return "<!-- specified path is a directory: $path -->";
}
unless ( -f $abs_path and -r $abs_path ) {
    ## try prefixing with modules/ ##
    my $mod_path = "$root/modules/$path";
    if ( -f $mod_path and -r $mod_path ) {
        $abs_path = $mod_path;
    } else {
        return "<!-- file not found: $path -->";
    }
}
$path = $abs_path;

## read file ##
my $content_ref = <[file.slurp]>->($path)
    or return "<!-- cannot read: $path -->";

## split AFTER each newline [ lookbehind ] so it stays attached to its line, ##
## matching <$fh> list-context behavior exactly -- including a final line    ##
## with no trailing newline if the file doesn't end in one. plain split on   ##
## /\n/ [ even with a -1 limit ] discards the delimiter itself and would     ##
## squash every line together again downstream where lines are concatenated  ##
## without re-adding a separator                                             ##
my @lines = split /(?<=\n)/, $$content_ref;

## apply line range ##
$from_line = 1              if $from_line < 1;
$to_line   = scalar(@lines) if $to_line == 0 or $to_line > scalar(@lines);

@lines = @lines[ $from_line - 1 .. $to_line - 1 ];

## truncate to budget ##
my $content = '';
my $used    = 0;
my $ln      = $from_line;

foreach my $line (@lines) {
    my $line_out
        = $show_line_numbers
        ? sprintf "%5d\t%s", $ln++, $line
        : $line;
    my $line_len = length($line_out);

    if ( $used + $line_len > $char_budget ) {
        $content .= "\n., [truncated at line budget]";
        last;
    }

    $content .= $line_out;
    $used += $line_len;
}

## format output ##
my $output = "## file: $path ##\n";
$output .= "\`\`\`\n";
$output .= $content;
$output .= "\n\`\`\`\n";

return $output;

