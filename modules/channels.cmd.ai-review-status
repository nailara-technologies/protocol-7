## [:< ##

# name  = channels.cmd.ai-review-status
# descr = check status of AI code review [ read-only ]
# param = <review_id>
# return = { mode => 'size', data => JSON status }

my $args      = $$call{'args'} // '';
my $review_id = $args;
$review_id =~ s|^\s+||;    ## trim leading whitespace ##
$review_id =~ s|\s+$||;    ## trim trailing whitespace ##

return {
    'mode' => qw| false |,
    'data' => 'expected <review_id> parameter'
    }
    unless length $review_id;

##  Retrieve review record  ##
<channels.ai_reviews> //= {};
my $review = <channels.ai_reviews>->{$review_id};

return {
    'mode' => qw| false |,
    'data' => "review $review_id not found"
    }
    unless defined $review;

##  Build status response  ##
my $status = {
    'review_id'          => $review_id,
    'developer'          => $review->{'developer'},
    'branch'             => $review->{'branch'},
    'message'            => $review->{'message'},
    'urgency'            => $review->{'urgency'},
    'submitted_at'       => $review->{'submitted_at'},
    'ai_reviewed'        => defined $review->{'ai_feedback'} ? TRUE : FALSE,
    'ai_approved'        => $review->{'ai_approved'},
    'developer_approved' => $review->{'developer_approved'},
    'stage'              => <[channels.util.get_review_stage]>->($review)
};

##  Include AI feedback if reviewed  ##
if ( defined $review->{'ai_feedback'} ) {
    $status->{'ai_feedback'} = $review->{'ai_feedback'};
}

##  Serialize to JSON  ##
my $json_str = do {
    my $json = <[base.perlmod.load]>->('JSON::PP');
    eval { JSON::PP::encode_json($status) };
};

if ( length $EVAL_ERROR ) {
    return {
        'mode' => qw| false |,
        'data' => "error serializing status: $EVAL_ERROR"
    };
}

return {
    'mode' => qw| size |,
    'data' => $json_str
};

1;

