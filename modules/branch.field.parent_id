## [:< ##

# name  = branch.field.parent_id
# descr = return parent group identifier
# param = id
#
# returns parent string if closed
# returns undef if still open or not found

my ($id) = @ARG;

return undef
    if not defined $id
    or not exists $data{'branch.field'}{$id};

return $data{'branch.field'}{$id}{'parent'};

