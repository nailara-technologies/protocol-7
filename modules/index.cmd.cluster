## [:< ##

# name  = index.cmd.cluster
# descr = prefix cluster density — ring counts, top children

my $prefix = $call->{'args'} // '';
return { 'mode' => 'false', 'data' => 'expected prefix' }
    unless length $prefix;

my $depth = length($prefix) - 1;

## verify prefix exists in trie ##
my $addr = <index.addr>->{"$depth:$prefix"};
return { 'mode' => 'false', 'data' => 'prefix not found' }
    unless defined $addr;

## prefix frequency ##
my $freq
    = length($prefix) == 1
    ? ( <index.freq>->{$prefix} // 0 )
    : ( <index.level>->{ length($prefix) }{$prefix} // 0 );

## immediate children for top-5 report ##
my $children = <[index.search]>->($prefix);
my @top5     = splice @$children, 0, 5;

## subtree density per ring depth — BFS extending one char at a time ##
my %density;
my @current = ($prefix);
while (@current) {
    my @next;
    for my $seq (@current) {
        my $c = <[index.search]>->($seq);
        push @next, map { $_->[0] } @$c;
    }
    last unless @next;
    my $d = length( $next[0] ) - 1;
    $density{$d} = scalar(@next);
    @current = @next;
}

my @out;
push @out, "prefix: $prefix";
push @out, "addr: $addr";
push @out, "freq: $freq";
push @out, "density:";
for my $d ( sort { $a <=> $b } keys %density ) {
    push @out, "  depth $d: $density{$d}";
}
if (@top5) {
    push @out, "top extensions:";
    for my $c (@top5) {
        my ( $seq, $r, $f ) = @$c;
        push @out, "  $seq (rank=$r, freq=$f)";
    }
}

return { 'mode' => 'size', 'data' => join( "\n", @out ) };

