# name  = llama-server-vision.handler.server_output
# descr = event handler for non-blocking vision subprocess output with reply correlation

# Get file handles from global storage
my $fh = <llama-server-vision.server_output_fh>;
my $log_fh = <llama-server-vision.server_log_fh>;

unless ( defined $fh ) {
    <[base.logs]>->( 0, "ERROR: server output file handle not found" );
    return;
}

# Try reading a line from the file handle
my $line = readline($fh);

unless ( defined $line ) {
    # EOF on this read - don't exit the child process
    return;
}

chomp($line);

# Write to log file
if ( defined $log_fh ) {
    print { $log_fh } "[vision] $line\n";
    $log_fh->flush() if $log_fh->can('flush');
}

# Pop reply_id from tracking array - responses come in order as vision model processes them
my $reply_id = shift <llama-server-vision.reply_ids>->@*;

if ( defined $reply_id ) {
    # Send response back to original caller via routing system
    <[base.callback.cmd_reply]>->(
        $reply_id,
        {
            'mode' => 'true',
            'data' => $line
        }
    );
    <[base.logs]>->( 2, "[vision] response sent for reply_id %d", $reply_id );
} else {
    # No pending request - just log the output
    <[base.logs]>->( 2, "[vision] untracked output: %s", $line );
}

