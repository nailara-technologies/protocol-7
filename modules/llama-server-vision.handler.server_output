# name  = llama-server-vision.handler.server_output
# descr = event handler for non-blocking llama-server output

# Get file handles from global storage
my $fh = <llama-server-vision.server_output_fh>;
my $log_fh = <llama-server-vision.server_log_fh>;

unless ( defined $fh ) {
    <[base.logs]>->( 0, "ERROR: server output file handle not found" );
    return;
}

# Try reading a line from the file handle
my $line = readline($fh);

unless ( defined $line ) {
    # EOF on this read - don't exit the child process
    # The server might still be running, just no output right now
    # Or the process might have exited but we shouldn't kill the child zenka
    return;
}

chomp($line);

# Write to log file
if ( defined $log_fh ) {
    print { $log_fh } "[llama-server] $line\n";
    $log_fh->flush() if $log_fh->can('flush');
}

<[base.logs]>->( 2, "[llama-server] %s", $line );

