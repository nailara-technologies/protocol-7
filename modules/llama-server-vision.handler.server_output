# name  = llama-server-vision.handler.server_output
# descr = event handler for non-blocking vision subprocess output with reply correlation

# Get file handles from global storage
my $fh = <llama-server-vision.server_output_fh>;
my $log_fh = <llama-server-vision.server_log_fh>;

unless ( defined $fh ) {
    <[base.logs]>->( 0, "ERROR: server output file handle not found" );
    return;
}

# Try reading a line from the file handle
my $line = readline($fh);

unless ( defined $line ) {
    # EOF on this read - don't exit the child process
    return;
}

chomp($line);

# Write to log file
if ( defined $log_fh ) {
    print { $log_fh } "[vision] $line\n";
    $log_fh->flush() if $log_fh->can('flush');
}

# Check if this is a response line that should be correlated with a request
if ( my $reply_id = shift <llama-server-vision.reply_ids>->@* ) {
    # Pop pending request info
    my $pending = <llama-server-vision.pending_requests>;
    my $request_data;

    # Find and remove the matching request (responses might come in order)
    foreach my $req_id ( sort keys $pending->%* ) {
        if ( $pending->{$req_id}->{'reply_id'} == $reply_id ) {
            $request_data = delete $pending->{$req_id};
            last;
        }
    }

    if ( $request_data ) {
        # Send correlated response back to caller
        <[base.callback.cmd_reply]>->(
            $reply_id,
            {
                'mode' => 'true',
                'data' => {
                    'image' => $request_data->{'image_path'},
                    'prompt' => $request_data->{'prompt'},
                    'response' => $line,
                }
            }
        );
    }
} else {
    # Not a correlated response, just log it
    <[base.logs]>->( 2, "[vision] %s", $line );
}

