## [:< ##

# name  = base.chk-sum.bmw384.coordinate
# args  = $input
# descr = compute BMW384 field coordinate hashref for any scalar input

my $input = shift;

if ( not defined $input ) {
    <[base.logs]>->( 1, 'input must be defined <{C1}>' );
    return undef;
}

<[base.perlmod.autoload]>->('AMOS7::CHKSUM::BMW384')
    if not <[base.perlmod.loaded]>->('AMOS7::CHKSUM::BMW384');

return AMOS7::CHKSUM::BMW384::bmw384_coordinate($input);

