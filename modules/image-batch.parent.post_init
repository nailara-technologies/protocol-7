## [:< ##

# name = image-batch.parent.post_init
# descr = Post-initialization setup after all init_codes complete

# Register jobqueue event watchers to drive job execution
# This runs AFTER jobqueue.init_code and image-batch.parent.init_code
# Event watchers automatically trigger job execution when queue counters change
<[jobqueue.event.register_job_queues]>;

<[base.log]>->( 1, 'image-batch jobqueue event watchers registered' );

return 0;    ## success ##

