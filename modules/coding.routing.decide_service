# name = coding.routing.decide_service
# descr = Intelligent workload routing - decide which service handles each task
# purpose = Core routing engine: Cache lookup, service selection, fallback determination

use strict;
use warnings;
use JSON::XS;

# Rule 1: Check cache first
my $check_cache_first = sub {
    my ($task) = @_;

    # In a real system, check living tree cache
    # For now, return placeholder
    return {
        found         => 0,
        cached_result => undef,
        cache_key     => undef
    };
};

# Rule 2: Simple rules (no LLM needed)
my $can_use_local_rules = sub {
    my ($task) = @_;

    my $desc = lc( $task->{request}->{description} // '' );

    # Examples of tasks that don't need LLM
    if ( $desc =~ /^(format|convert|validate|check|list|count)/i ) {
        return {
            applicable => 1,
            rule       => 'simple-transformation',
            cost       => 0
        };
    }

    # Check type - some types never need LLM
    my $type = $task->{type} // '';
    if ( $type eq 'transcription' ) {
        return { applicable => 1, rule => 'transcription-direct', cost => 0 };
    }

    return { applicable => 0 };
};

# Rule 3: Determine optimal service
my $determine_service = sub {
    my ($task) = @_;

    my $type        = $task->{type}                   // 'analysis';
    my $complexity  = $task->{analysis}->{complexity} // 5;
    my $constraints = $task->{request}->{constraints} // [];

    # Transcription → Whisper (no tokens)
    if ( $type eq 'transcription' ) {
        return {
            service    => 'whisper',
            reason     => 'Task is audio transcription',
            token_cost => 0,
            priority   => 'direct'
        };
    }

    # Image generation → Invoke AI (no tokens)
    if ( $type eq 'image-generation' ) {
        return {
            service    => 'invoke-ai',
            reason     => 'Task is image generation',
            token_cost => 0,
            priority   => 'direct'
        };
    }

    # Code generation → Code specialist model
    if ( $type eq 'code-generation' ) {

        # Check for consensus requirement
        my $needs_consensus
            = grep { lc($_) =~ /consensus|verify/ } @$constraints;

        if ($needs_consensus) {
            return {
                service    => 'consensus-voting',
                models     => [ 'mathstral', 'qwen', 'aya' ],
                reason     => 'Code generation with consensus verification',
                token_cost => 500,
                priority   => 'consensus'
            };
        }

        return {
            service    => 'single-llm',
            model      => 'mathstral',
            reason     => 'Code generation specialist',
            token_cost => 300,
            priority   => 'code-specialist'
        };
    }

    # Reasoning tasks
    if ( $type eq 'reasoning' || $type eq 'analysis' ) {

        # High complexity or explicit consensus requirement → voting
        if ( $complexity >= 7
            || ( grep { lc($_) =~ /consensus|verify/ } @$constraints ) ) {
            return {
                service => 'consensus-voting',
                models  => [ 'qwen', 'mathstral', 'aya' ],
                reason  =>
                    "Complex reasoning (complexity: $complexity) needs consensus",
                token_cost => 600,
                priority   => 'consensus'
            };
        }

        # Medium complexity → single model
        if ( $complexity >= 4 ) {
            return {
                service => 'single-llm',
                model   => 'qwen',
                reason  =>
                    "Medium complexity reasoning (complexity: $complexity)",
                token_cost => 250,
                priority   => 'reasoning'
            };
        }

        # Simple → basic model
        return {
            service    => 'single-llm',
            model      => 'qwen',
            reason     => "Simple analysis (complexity: $complexity)",
            token_cost => 100,
            priority   => 'simple'
        };
    }

    # Creative/brainstorming → diverse consensus
    if ( $type eq 'brainstorming' ) {
        return {
            service    => 'consensus-voting',
            models     => [ 'qwen', 'aya', 'mathstral' ],
            reason     => 'Creative task needs multiple perspectives',
            token_cost => 400,
            priority   => 'diverse'
        };
    }

    # Default fallback
    return {
        service    => 'single-llm',
        model      => 'qwen',
        reason     => "Default routing for type: $type",
        token_cost => 200,
        priority   => 'default'
    };
};

# Determine fallback service
my $determine_fallback = sub {
    my ( $task, $primary_service ) = @_;

    my $primary = $primary_service->{service} // 'single-llm';

    # If primary fails, what's the fallback?
    if ( $primary eq 'consensus-voting' ) {
        return {
            service => 'single-llm',
            model   => 'qwen',
            reason  => 'Fallback from consensus to single model'
        };
    }

    if ( $primary eq 'invoke-ai' ) {
        return {
            service => 'none',
            reason  => 'No fallback for image generation'
        };
    }

    if ( $primary eq 'whisper' ) {
        return {
            service => 'none',
            reason  => 'No fallback for transcription'
        };
    }

    # Default: try consensus
    return {
        service => 'consensus-voting',
        models  => [ 'qwen', 'mathstral' ],
        reason  => 'Fallback to consensus voting'
    };
};

# Main routing decision
my $make_routing_decision = sub {
    my ($task) = @_;

    return {
        success => FALSE,
        error   => "Task must be a hashref"
        }
        unless ref($task) eq 'HASH';

    # Check cache first (Rule 1)
    my $cache_check = check_cache_first->($task);
    if ( $cache_check->{found} ) {
        return {
            success => TRUE,
            route   => {
                service       => 'cache',
                cached_result => $cache_check->{cached_result},
                token_cost    => 0,
                reason        => 'Task result found in cache',
                cache_key     => $cache_check->{cache_key}
            },
            task => $task
        };
    }

    # Check if simple local rules apply (Rule 2)
    my $local_check = can_use_local_rules->($task);
    if ( $local_check->{applicable} ) {
        return {
            success => TRUE,
            route   => {
                service    => 'local-rules',
                token_cost => 0,
                reason     => $local_check->{rule},
                priority   => 'local'
            },
            task => $task
        };
    }

    # Determine primary service (Rule 3)
    my $primary  = determine_service->($task);
    my $fallback = determine_fallback->( $task, $primary );

    # Update task with routing information
    $task->{analysis}->{routed_to}         = $primary->{service};
    $task->{analysis}->{fallback}          = $fallback->{service};
    $task->{execution}->{estimated_tokens} = $primary->{token_cost};

    return {
        success => TRUE,
        route   => {
            primary       => $primary,
            fallback      => $fallback,
            decision_time => scalar(localtime)
        },
        task => $task
    };
};

# Get routing statistics (for monitoring)
my $get_routing_stats = sub {

    # Placeholder for future statistics tracking
    return {
        success => TRUE,
        stats   => {
            routes_made        => 0,
            cache_hits         => 0,
            services_used      => [],
            average_token_cost => 0
        }
    };
};

# Main entry
my $cmd  = shift @_ // 'route';
my $task = shift @_;

if ( $cmd eq 'route' ) {
    return make_routing_decision->($task);
} elsif ( $cmd eq 'check-cache' ) {
    return check_cache_first->($task);
} elsif ( $cmd eq 'determine-service' ) {
    return determine_service->($task);
} elsif ( $cmd eq 'determine-fallback' ) {
    my $primary = shift @_;
    return determine_fallback->( $task, $primary );
} elsif ( $cmd eq 'stats' ) {
    return get_routing_stats->();
} else {
    return {
        success   => FALSE,
        error     => "Unknown routing command: $cmd",
        available => [
            'route',             'check-cache',
            'determine-service', 'determine-fallback',
            'stats'
        ]
    };
}

