## [:< ##

# name  = index.cmd.persist
# descr = save index state to disk

my $ok = <[index.persist]>;
return $ok
    ? { 'mode' => 'size',  'data' => 'index state saved' }
    : { 'mode' => 'false', 'data' => 'persist failed' };

