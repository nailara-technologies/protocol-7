## [:< ##

# name = models.cmd.chat
# descr = multi-model chat interface with keyword support
# usage = models.chat [model message]
# return = chat buffer view (immediate) or deferred reply with full buffer

my $param    = shift;
my $args     = $param->{'args'}     // '';
my $reply_id = $param->{'reply_id'} // '';

## no args (only source_zenka from alias): show recent chat buffer
if ( $args eq '' or $args =~ m|^\S+$| ) {
    my $entries = <[models.chat.get_recent]>->(20);
    my $output  = <[models.chat.format_buffer]>->($entries);

    if ( $output eq '' ) {
        $output = ":. chat buffer empty :.\n";
    }

    return { mode => qw| size |, data => $output };
}

## parse: <source_zenka> <model> <message> (source_zenka from cube alias)
return {
    mode => qw| false |,
    data => 'usage: models.chat [model message]'
    }
    if not defined $args
    or $args !~ m|^(\S+) +(\S+) +(.+)$|s;

my ( $sender, $model, $message )
    = ( ${^CAPTURE}[0], ${^CAPTURE}[1], ${^CAPTURE}[2] );

## strip zenka prefix from source (e.g., 'cube.models' -> 'models')
$sender =~ s|^.+\.||g;

## auto-announce multi-line messages (>5 lines)
my ( $checksum, $final_message ) = <[models.chat.auto_announce]>->($message);

if ( defined $checksum ) {
    ## message was announced, use announcement instead
    $message = $final_message;
}

## append user message to buffer
<[models.chat.append]>->( undef, $sender, $message );

## process keywords in message [ memory expansion, etc ]
my $processed = <[models.chat.process_keywords]>->($message);

## invoke model backend
## Pass chat_response handler to store response and reply when ready
<[models.chat.invoke_model]>->(
    $model,
    $processed,
    {   'reply_id' => $reply_id,
        'handler'  => 'models.handler.chat_response',
        'sender'   => $sender,
        'model'    => $model,
    }
);

## Return deferred - response will come via chat_response handler
return { mode => 'deferred' };

