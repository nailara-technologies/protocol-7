## [:< ##
    # name  = plan-9.protocol.codec.decode-qid
    my ($data) = @ARG;
    my ( $type, $version, $plo, $phi ) = unpack( 'C V VV', $data );
    my $path = ( $phi << 32 ) | $plo;
    return ( $type, $version, $path );

