# name  = base.parser.pattern_split
# descr = split string by pattern with capture group handling and callback injection
#
# Splits a string by a regex pattern, optionally invoking a callback for each
# separator (matched pattern). Callback receives references to surrounding text
# segments and capture group contents.
#
# Parameters:
#   $_[0] - Reference to string to split (SCALAR ref)
#   $_[1] - Regex pattern to split on (string or compiled Regexp)
#   $_[2] - Optional callback subroutine (CODE ref)
#
# Returns:
#   Array reference with alternating text and callback results:
#     [text0, callback_result0, text1, callback_result1, ..., textN]
#
# Callback signature:
#   my ($curr_seg_ref, $next_seg_ref, @capture_groups_refs) = @_;
#   return $processed_separator;
#
# Example:
#   my $text = "foo[bar]baz[qux]end";
#   my $result = <[base.parser.pattern_split]>->(\$text, qr/\[([^\]]+)\]/, sub {
#       my ($curr, $next, $captured) = @_;
#       return ":: " . $$captured . " ::";
#   });
#   # Returns: ["foo", ":: bar ::", "baz", ":: qux ::", "end"]

my $string_sref    = shift;
my $split_pattern  = shift;
my $substr_coderef = shift;

## Validate input parameters
if ( ref($string_sref) ne qw| SCALAR | ) {
    warn('expecting scalar ref to text <{C1}>');
    return undef;
}
if ( not defined $$string_sref ) {
    warn('scalar ref points to undef value <{C1}>');
    return undef;
}
if ( not defined $split_pattern ) {
    warn('expected split pattern parameter <{C1}>');
    return undef;
}
if ( defined $substr_coderef and ref($substr_coderef) ne qw| CODE | ) {
    warn('substr param expected to be coderef <{C1}>');
    return undef;
}

## Prepare pattern: compile if string, track original length
my $result_aref;
my $pattern_length;

if ( not length ref $split_pattern ) {
    $pattern_length = length $split_pattern;
}

## Compile pattern if it's a string (not already a Regexp)
if ( index( ref($split_pattern), qw| Regexp |, 0 ) == -1 ) {
    ( $split_pattern, my $re_err_sref )
        = <[base.eval.comp_regex]>->($split_pattern);

    unless ( defined $split_pattern ) {
        warn(':: pattern not valid regexp syntax :: <{NC}>');
        map { <[base.s_warn]>->( ': %s <{NC}>', $_ ) }
            split( m|; (*pla:marked)|u, $$re_err_sref, 2 );
        warn(':. <{C1}>');
        return undef;
    }
}

## Perform the split operation (limit -13 allows full split with capture groups)
$result_aref = [ split( m|$split_pattern|u, $$string_sref, -13 ) ];

my $str_element_count = scalar @$result_aref;

## Clean up: remove trailing empty element from empty pattern
if (    defined $pattern_length
    and $pattern_length == 0
    and $str_element_count > 1
    and not length $result_aref->[ $str_element_count - 1 ] ) {
    pop @$result_aref;
    --$str_element_count;
}

## If no callback requested, return simple split result
return $result_aref if not defined $substr_coderef;

## If only one element (no matches), return as-is
return $result_aref if $str_element_count == 1;

## Extract capture group count from pattern
my $pattern_cpy = $split_pattern;
$pattern_cpy =~ s|\\\\||gu;         # Remove escaped backslashes
$pattern_cpy =~ s|^\(?[^:]*:||u;    # Remove regexp compiler markers
$pattern_cpy =~ s|\)$||u;           # Remove trailing paren

my @capture_grp_matches
    = $pattern_cpy =~ m|(*nlb:\\)(\([^\)]*(*nlb:\\)\))|gsu;
my $capture_grp_count = scalar @capture_grp_matches;

undef @capture_grp_matches;
undef $pattern_cpy;

## Build extended result with callback results interleaved
my $next_index      = 1;
my $current_index   = 0;
my $extended_result = [];

while ( $current_index < $str_element_count ) {

    ## Add current text segment
    push @$extended_result, $result_aref->[$current_index];

    ## Prepare callback parameters:
    ## - Reference to current segment
    ## - Reference to next segment
    ## - References to any capture groups
    my @callback_param = (
        \$result_aref->[$current_index],
        \$result_aref->[ $next_index + $capture_grp_count ]
    );

    ## Add capture group references
    if ($capture_grp_count) {
        foreach my $offset ( 1 .. $capture_grp_count ) {
            push @callback_param, \$result_aref->[ $current_index + $offset ];
        }
        $current_index += $capture_grp_count;
        $next_index    += $capture_grp_count;
    }

    ## Invoke callback with separator context (only if not at end)
    if ( $current_index < $str_element_count - 1 ) {
        push @$extended_result, $substr_coderef->(@callback_param);
    }

    ++$current_index;
    ++$next_index;
}

## Clean up temporary array
undef @$result_aref;

return $extended_result;

