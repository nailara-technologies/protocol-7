## [:< ##

# name  = signal.cancel.cmd.check-line
# param = <log line>
# descr = check one log line against cancellation library

my $line = $call->{'args'} // '';

return {
    'mode' => qw| false |,
    'data' => 'expected a log line'
    }
    if not length $line;

my $result = <[signal.cancel.match]>->($line);

if ( $result->{'matched'} ) {
    return {
        'mode' => qw| true |,
        'data' => sprintf 'MATCH %s',
        $result->{'pattern_id'}
    };
}

return {
    'mode' => qw| true |,
    'data' => 'NO MATCH'
};

