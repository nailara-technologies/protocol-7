# name = menu-commands.handler.menu-update-reply
# descr = Handle reply from protocol-7-menu after menu update notification

my $params = shift;
my $update_ref = $params->{'data'};

<[base.log]>->( 1, "menu-update notification acknowledged by protocol-7-menu (ref: %s)", $update_ref );

# Handler doesn't need to do anything special - just log the acknowledgment
# The actual fetch of data will happen when protocol-7-menu calls get-provider-data

0;

