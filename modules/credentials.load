## [:< ##

# name  = credentials.internal.load
# descr = load and decrypt a credential entry from disk

my $cred_name = shift // '';

return undef unless length $cred_name;

my $store_dir = <credentials.cfg.store_dir>;
my $file_path = $store_dir . $cred_name . '.yaml.enc';

return undef unless -f $file_path and -r $file_path;

my $content_ref = <[file.slurp]>->( $file_path, qw| :raw | );
return undef
    unless defined $content_ref
    and length $content_ref->$*;

my $nonce_size = <credentials.cfg.nonce_size>;
my $file_data  = $content_ref->$*;
my $nonce      = substr( $file_data, 0, $nonce_size );
my $ciphertext = substr( $file_data, $nonce_size );

## derive encryption key ##
my $instance_id  = <protocol-7.instance-id> // qw| protocol-7 |;
my $key_material = $nonce . $cred_name . $instance_id;
my $sym_key      = AMOS7::13::key_32( \$key_material );

if ( not defined $sym_key or not length $sym_key ) {
    <[base.logs]>->(
        0, 'credentials: key derivation failed for %s', $cred_name
    );
    return undef;
}

## pad key to 32 bytes ##
while ( length($sym_key) < 32 ) {
    $sym_key .= "\0";
}

my $status
    = AMOS7::Twofish::key_init( $sym_key, qw| decryption credentials | );
if ( not defined $status or not $status ) {
    <[base.logs]>->(
        0, 'credentials: twofish key init failed for %s', $cred_name
    );
    return undef;
}

my $decrypted_ref
    = AMOS7::Twofish::decrypt( qw| credentials |, \$ciphertext );

AMOS7::Twofish::delete_table_entry(qw| decryption credentials |);

if (   not defined $decrypted_ref
    or ref $decrypted_ref ne qw| SCALAR |
    or not length $decrypted_ref->$* ) {
    <[base.logs]>->( 0, 'credentials: decryption failed for %s', $cred_name );
    return undef;
}

my $cred = eval { YAML::XS::Load( $decrypted_ref->$* ) };
if ($@) {
    <[base.logs]>->(
        0,          'credentials: yaml parse failed for %s: %s',
        $cred_name, $@
    );
    return undef;
}

if ( ref $cred ne qw| HASH | ) {
    <[base.logs]>->(
        0, 'credentials: invalid data format for %s', $cred_name
    );
    return undef;
}

return $cred;

