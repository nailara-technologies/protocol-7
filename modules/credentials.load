## [:< ##

# name  = credentials.load
# descr = load and decrypt a credential entry from disk using archive format

my $cred_name = shift // '';

return undef unless length $cred_name;

my $store_dir = <credentials.cfg.store_dir>;
my $file_path = $store_dir . $cred_name . '.yaml.enc';

return undef unless -f $file_path and -r $file_path;

## derive archive encryption password from system constants ##
my $instance_id = <protocol-7.instance-id> // qw| protocol-7 |;
my $dec_pwd     = $cred_name . ':' . $instance_id;

## read and decrypt archive ##
my $payload_ref = <[credentials.read_archive]>->( $file_path, $dec_pwd );
return undef unless defined $payload_ref;

## unpack payload into credential hash ##
my $cred = <[credentials.unpack_format.archive_payload]>->($payload_ref);
return undef unless defined $cred;

return $cred;

