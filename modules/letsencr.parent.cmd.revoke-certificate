## [:< ##

# name  = letsencr.parent.cmd.revoke-certificate
# descr = revoke an SSL certificate with ACME server and clean up local files

my $domain = shift;

unless ($domain) {
    return {
        mode => 'false',
        data => 'error: domain name required',
    };
}

<[base.log]>->( 2, "revoke certificate command received for: $domain" );

## Log activity start
<[letsencr.parent.activity_logger]>->(
    'revocation', $domain, 'pending', 'initiated by user'
);

## Check if certificate exists in registry
my $certs = <letsencr.parent.certs>;
unless ( $certs->{$domain} ) {
    <[base.log]>->( 1, "error: certificate not found for domain: $domain" );
    <[letsencr.parent.activity_logger]>->(
        'revocation', $domain, 'failed', 'certificate not found'
    );

    return {
        mode => 'false',
        data => "error: no certificate for domain '$domain'",
    };
}

my $cert_info = $certs->{$domain};
my $certs_dir = <letsencr.certs.dir>;

## Send revocation command to child process
my $revoke_cmd = 'letsencr.child.cmd.revoke-certificate ' . $domain;

<[base.log]>->( 2, "sending revocation command to child for: $domain" );

my $result = <[base.protocol-7.command.send.local]>->(
    {   'command'   => $revoke_cmd,
        'call_args' => {
            'args'  => $domain,
            'param' => {
                'cert_path' => $cert_info->{cert_path},
                'key_path'  => $cert_info->{key_path},
            }
        },
        'reply' => {
            'handler' => qw| letsencr.parent.handler_revocation_reply |,
            'params'  => { 'domain' => $domain }
        }
    }
);

if ($result) {
    <[base.log]>->( 2, "revocation command queued for: $domain" );
    <[letsencr.parent.activity_logger]>->(
        'revocation', $domain, 'pending', 'queued to child'
    );

    return {
        mode => 'true',
        data =>
            "revocation requested for '$domain' - queued to child process",
    };
} else {
    <[base.log]>->( 1, "error: failed to queue revocation for: $domain" );
    <[letsencr.parent.activity_logger]>->(
        'revocation', $domain, 'failed', 'failed to queue to child'
    );

    return {
        mode => 'false',
        data => "error: failed to queue revocation for '$domain'",
    };
}

