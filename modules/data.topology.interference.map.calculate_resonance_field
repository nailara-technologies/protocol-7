# name = data.topology.interference.map.calculate_resonance_field
# desc = Calculate resonance with 26 neighbors

my ( $spatial, $phase ) = @_;

my $resonance = {};
for my $neighbor ( @{ $spatial->{'neighbors'} } ) {
    my $n_phase = ( $neighbor->[0] + $neighbor->[1] + $neighbor->[2] ) % 7;
    my $align   = 1 - abs( $phase - $n_phase ) / 7;
    $resonance->{ join( ',', @$neighbor ) } = $align;
}

return $resonance;

