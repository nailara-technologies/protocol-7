## [:< ##

# name  = user-edit.outbox.clear
# descr = remove a staged edit entry from the local outbox
# param = $id

my $id = shift;

if ( not defined $id or not length $id ) {
    <[base.logs]>->( 0, 'outbox.clear : entry id required' );
    return wantarray ? ( FALSE, 'entry id required' ) : FALSE;
}

if (   index( $id, qw| / | ) != -1
    or index( $id, qw| .. | ) != -1 ) {
    <[base.logs]>->( 0, 'outbox.clear : invalid entry id [ %s ]', $id );
    return wantarray ? ( FALSE, 'invalid entry id' ) : FALSE;
}

my $path = sprintf qw| [VAR_P7]/outbox/%s.yaml |, $id;

my $resolved_path = <[base.path.resolve_keywords]>->($path);

## already gone is SUCCESS, not failure : clearing is about reaching a state,
## not about performing an unlink.  the outbox is written conditionally [
## draft.write skips an empty form, and a form holding a secret is never
## staged at all ], so "no such file" is an ORDINARY outcome of a normal save
## -- reporting it as an error made a clean submit print a spurious failure
return wantarray ? ( TRUE, undef ) : TRUE if not -e $resolved_path;

if ( unlink($resolved_path) ) {
    return wantarray ? ( TRUE, undef ) : TRUE;
}

my $err = sprintf 'cannot remove outbox entry [ %s ] : %s',
    $id, <[base.str.os_err]>;

<[base.logs]>->( 0, $err );

return wantarray ? ( FALSE, $err ) : FALSE;

