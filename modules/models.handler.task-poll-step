## [:< ##

# name  = models.handler.task-poll-step
# descr = async callback chain for task claim and dispatch

my $reply  = shift;
my $cmd    = $reply->{'cmd'}       // '';
my $args   = $reply->{'call_args'} // {};
my $rdata  = $reply->{'data'}      // '';
my $params = $reply->{'params'}    // {};

my $step = $params->{'step'} // '';

## ======================================================================
## step: claimed — verify claim result, fetch task details
## ======================================================================

if ( $step eq 'claimed' ) {

    my $task_id = $params->{'task_id'} // '';

    if ( $cmd ne 'TRUE' ) {
        <[base.logs]>->( 2, ': task claim failed for %s', $task_id );
        return;
    }

    <[base.logs]>->( 2, ': claimed %s, fetching details', $task_id );

    <[protocol-7.route-send]>->(
        {   'command'   => 'task.show',
            'call_args' => { 'args' => $task_id },
            'reply'     => {
                'handler' => 'models.handler.task-poll-step',
                'params'  => {
                    'step'    => 'show',
                    'task_id' => $task_id
                }
            }
        }
    );
    return;
}

## ======================================================================
## step: show — parse details, determine model, enqueue via jobqueue
## ======================================================================

if ( $step eq 'show' ) {

    my $task_id = $params->{'task_id'} // '';

    ## extract task details text
    my $details = '';
    if ( $cmd eq 'SIZE' ) {
        $details = $rdata;
    } elsif ( $cmd eq 'TRUE' ) {
        $details = $args->{'args'} // '';
    }

    if ( not length $details ) {
        <[base.logs]>->( 0, ': empty task details for %s', $task_id );
        <[protocol-7.route-send]>->(
            {   'command'   => 'task.fail',
                'call_args' => { 'args' => "$task_id empty task details" }
            }
        );
        return;
    }

    ## parse description and context from task details
    my ( $description, $context ) = ( '', '' );
    foreach my $line ( split( /\n/, $details ) ) {
        if ( $line =~ m{^description\s*:\s*(.*)$}i ) {
            $description = $1;
        } elsif ( $line =~ m{^context\s*:\s*(.*)$}i ) {
            $context = $1;
        }
    }

    ## determine model from :name: prefix in description [ @name fallback ]
    my $model = <models.task.default_model> // 'kimi';
    if ( $description =~ s{^:([a-z0-9\-]+):\s*}{}i ) {
        $model = $1;
    } elsif ( $description =~ s{^\@(\S+)\s*}{} ) {
        $model = $1;
    }

    ## build prompt
    my $prompt = sprintf "[task %s]\n%s", $task_id, $description;
    $prompt .= "\n\n$context" if length $context;

    ## model to backend command mapping
    my %backend_cmd = (
        'kimi'      => 'kimi.ask-reply',
        'kimi-code' => 'kimi.ask-reply',
        'llama'     => 'coding.ask-reply',
        'local'     => 'coding.ask-reply',
    );

    my $target_cmd = $backend_cmd{$model};

    if ( not defined $target_cmd ) {
        <[base.logs]>->(
            0,      ': no backend for model %s [ task %s ]',
            $model, $task_id
        );
        <[protocol-7.route-send]>->(
            {   'command'   => 'task.fail',
                'call_args' =>
                    { 'args' => "$task_id no backend for model $model" }
            }
        );
        return;
    }

    <[base.logs]>->(
        1,        ': task %s enqueueing for %s backend',
        $task_id, $model
    );

    ## enqueue for jobqueue-managed execution ##
    <[models.task.enqueue]>->(
        {   'task_id'    => $task_id,
            'model'      => $model,
            'prompt'     => $prompt,
            'target_cmd' => $target_cmd
        }
    );

    return;
}

<[base.logs]>->( 0, ': task-poll-step: unknown step [ %s ]', $step );
return;

