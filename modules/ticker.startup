## [:< ##

# name = ticker.startup

<[base.log]>->( 1, 'fetching layer setup.,' );

<x11.title_str>
    = defined <system.zenka.subname>
    ? sprintf( qw| %s[%s] |, <system.zenka.name>, <system.zenka.subname> )
    : <system.zenka.name>;

<ticker.layer_resolved> = FALSE;

<[protocol-7.command.send.local]>->(
    {   'command'   => qw| cube.tile.get-layer |,
        'call_args' => { 'args'    => <x11.title_str> },
        'reply'     => { 'handler' => qw| ticker.handler.get-layer_reply | }
    }
);

## bounded fallback : get-layer routes to tile and gates open_window via   ##
## get-layer_reply. if tile is offline / stuck the reply never arrives and  ##
## the window never opens -> start-up timeout. open with the default layer  ##
## after this window instead. mirrors the coordinates fallback. configurable.##
## [ note : this fires after the coordinate fallback, so the two add up in  ##
## the fully-stuck case -- kept comfortably within ticker's start window. ] ##
my $layer_after = <ticker.layer_fallback_timeout> // 7;

<ticker.layer_timer> = <[event.add_timer]>->(
    {   'after'   => $layer_after,
        'desc'    => 'ticker.layer_fallback',
        'handler' => qw| ticker.handler.get-layer_timeout |,
    }
);

<[ticker.set_default_values]>;

## the gtk main loop is now entered by the start file [ before the async   ##
## coordinate reply fires this continuation ], so it is not entered here.   ##

