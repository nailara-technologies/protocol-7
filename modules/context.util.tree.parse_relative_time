# name  = context.util.tree.parse_relative_time
# descr = parse single relative time expression to epoch timestamp

my ( $expr, $now ) = @_;

$now //= time();

return $now if $expr eq 'now';

if ( $expr =~ m{^-?\d+\s*(second|minute|hour|day|week)s?$} ) {
    my ( $num, $unit ) = $expr =~ m{(-?\d+)\s*(\w+)};
    my $multiplier = {
        'second' => 1,
        'minute' => 60,
        'hour'   => 3600,
        'day'    => 86400,
        'week'   => 604800,
    }->{$unit} // 1;

    return $now + ( $num * $multiplier );
}

## assume absolute timestamp ##
return $expr if $expr =~ m|^\d+$|;

return $now;

