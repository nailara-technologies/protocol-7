## [:< ##

# name = vision-batch.child.loop
# descr = Child worker event loop for job processing

my $parent_pipe = <vision-batch.child.parent_pipe>;
my $worker_id   = <vision-batch.child.worker_id>;

return { success => FALSE, error => 'Parent pipe not initialized' }
    unless defined $parent_pipe;

# Set autoflush for pipe
$parent_pipe->autoflush(1);

# Send ready signal to parent
my $ready_msg
    = JSON::XS::encode_json( { cmd => 'ready', worker_id => $worker_id } );
print {$parent_pipe} "$ready_msg\n";
$parent_pipe->flush() if $parent_pipe->can('flush');

# Event loop: wait for jobs from parent
while (1) {

    # Read JSON command from parent
    my $line = <$parent_pipe>;
    last unless defined $line;    # Parent pipe closed

    chomp $line;

    # Parse JSON command
    my $job;
    eval { $job = JSON::XS::decode_json($line); };

    if ($EVAL_ERROR) {

        # Invalid JSON, send error and continue
        my $error_response = JSON::XS::encode_json(
            {   cmd   => qw| error |,
                error => "Failed to parse JSON: $EVAL_ERROR"
            }
        );
        print {$parent_pipe} "$error_response\n";
        next;
    }

    # Check command type
    if ( $job->{cmd} eq 'analyze' ) {

        # Process image analysis job
        my $result = <[vision-batch.child.analyze_job]>->($job);

        # Send result back to parent
        my $response = JSON::XS::encode_json($result);
        print {$parent_pipe} "$response\n";

        # Send ready signal for next job
        print {$parent_pipe} "$ready_msg\n";

    } elsif ( $job->{cmd} eq 'shutdown' ) {

        # Parent signaled shutdown
        last;

    } else {

        # Unknown command
        my $error_response = JSON::XS::encode_json(
            {   cmd   => qw| error |,
                error => "Unknown command: $job->{cmd}"
            }
        );
        print {$parent_pipe} "$error_response\n";
    }
}

# Graceful exit
close $parent_pipe;
return TRUE;

