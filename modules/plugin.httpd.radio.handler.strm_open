## [:< ##

# name  = plugin.httpd.radio.handler.strm_open
# descr = reply handler for radio.listen STRM open: register local consumer

my $reply    = shift;
my $cmd_id   = $reply->{'cmd_id'};
my $http_sid = $reply->{'params'}{'http_sid'};

##  guard: only process actual STRM open replies  ##
return if not defined $cmd_id or $cmd_id !~ m|^\d+$|;

##  guard: HTTP session may have disconnected before STRM arrived  ##
if ( not exists $data{'session'}{$http_sid} ) {
    <[base.logs]>->(
        2, '[httpd.radio] [%d] session gone before STRM open', $http_sid
    );
    return;
}

<plugin.httpd.radio.relay>->{$http_sid} = $cmd_id;

my $max_relay_buf = 4 * 1024 * 1024;    ##  4 MB hard limit  ##
my $http_buf_high = 512 * 1024;         ##  512 K back-pressure  ##

##  send !TERM! to radio via the route : stops the STRM at the source  ##
my $cancel_strm = sub {
    for my $sid ( keys $data{'session'}->%* ) {
        next if not exists $data{'session'}{$sid}{'route'}{$cmd_id};
        my $rid        = $data{'session'}{$sid}{'route'}{$cmd_id} // next;
        my $route      = $data{'route'}{$rid}                     // next;
        my $src_cmd_id = $route->{'source'}{'cmd_id'}             // 0;
        if ( $src_cmd_id > 0 ) {
            $data{'session'}{$sid}{'buffer'}{'output'}
                .= sprintf "(%d)!TERM!\n", $cmd_id;
            <[base.logs]>->(
                2,         '[httpd.radio] [%d] sent !TERM! [ cmd_id %d ]',
                $http_sid, $cmd_id
            );
        }
        last;
    }
    <[strm.local.cancel]>->($cmd_id);
    delete <plugin.httpd.radio.relay>->{$http_sid};
};

<[strm.local.register]>->(
    $cmd_id,
    {   'watcher' => sub {
            my $lc = shift;

            ##  HTTP client gone : cancel consumer and terminate STRM  ##
            if ( not exists $data{'session'}{$http_sid} ) {
                $cancel_strm->();
                return;
            }

            ##  hard limit: client too slow  ##
            if ( length( $lc->{'buf'} ) > $max_relay_buf ) {
                <[base.logs]>->(
                    1, '[httpd.radio] [%d] relay buf overflow, dropping',
                    $http_sid
                );
                $cancel_strm->();
                $data{'session'}{$http_sid}{'flush_shutdown'} = 1
                    if exists $data{'session'}{$http_sid};
                return;
            }

            ##  back-pressure: HTTP output buffer too full  ##
            my $out_ref
                = \$data{'session'}{$http_sid}{'buffer'}{'output'};
            return if length($$out_ref) > $http_buf_high;

            ##  transfer audio bytes to HTTP output buffer  ##
            $$out_ref .= $lc->{'buf'};
            $lc->{'buf'} = '';
        },
        'on_eof' => sub {
            <[base.logs]>->(
                2, '[httpd.radio] [%d] STRM ended, closing client', $http_sid
            );
            delete <plugin.httpd.radio.relay>->{$http_sid};
            $data{'session'}{$http_sid}{'flush_shutdown'} = 1
                if exists $data{'session'}{$http_sid};
        },
    }
);

<[base.logs]>->(
    2,         '[httpd.radio] [%d] STRM consumer registered cmd_id %d',
    $http_sid, $cmd_id
);

