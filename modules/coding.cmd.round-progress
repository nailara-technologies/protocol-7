## [:< ##

# name  = coding.cmd.round-progress
# descr = current inference round vs timeout ceiling

my $reset      = "\e[0m";
my $blacklight = "\e[38;2;68;39;172m";
my $nailara_bg = "\e[48;2;9;5;42m";
my $TRUE_color = "\e[38;2;6;71;195m";
my $WARN_color = "\e[38;2;197;141;7m";

my $now = <[base.time]>->(3);

## find the task actually holding a backend lock right now : that's the ##
## one genuinely generating, NOT active[0] [ just first-in-list, may be  ##
## idle waiting its turn behind whoever really holds the lock ]          ##
my $backends = <coding.state.backend> // {};
my $task_id;
for my $backend_name ( keys %{$backends} ) {
    my $lock = $backends->{$backend_name}->{'lock'};
    next unless defined $lock and length $lock;
    $task_id = $lock;
    last;
}

## no backend lock held right now doesn't mean nothing's active -- a task ##
## deep in tool execution (search/read calls, no ceiling) holds no lock   ##
## between HTTP rounds and would otherwise make this go blank for most of ##
## its wall-clock time. fall back to whichever active task has the most   ##
## recent round activity timestamp -- NOT active[0] by position, which is ##
## exactly the "misleading first-in-queue" case the lock-check was meant  ##
## to avoid in the first place.                                          ##
if ( not defined $task_id ) {
    my $aref_active = <coding.task.active> // [];
    my $best_ts;
    for my $candidate_id ( $aref_active->@* ) {
        my $cand_state
            = <[coding.async.state_machine]>->( qw| get |, $candidate_id );
        my $ts = $cand_state->{'round_tools_started'}
            // $cand_state->{'round_started'};
        next unless defined $ts;
        if ( not defined $best_ts or $ts > $best_ts ) {
            $best_ts = $ts;
            $task_id = $candidate_id;
        }
    }
}

my $chars_max = 13;

if ( not defined $task_id ) {
    my $output_str
        = sprintf( "${blacklight}:::[${nailara_bg}${TRUE_color}%-13s"
            . "${reset}${blacklight}]::"
            . "[${nailara_bg}${TRUE_color} %s "
            . "${reset}${blacklight}]:.${reset}",
        '', 'no active task' );
    return { 'mode' => qw| true |, 'data' => $output_str };
}

my $state         = <[coding.async.state_machine]>->( qw| get |, $task_id );
my $round         = $state->{'round'} // 0;
my $http_started  = $state->{'round_started'};          ## phase 1 start ##
my $tools_started = $state->{'round_tools_started'};    ## phase 2 start ##

## actual ceiling governing THIS round : soft/escalated/GPU-stretched -- ##
## not always the flat hard-ceiling config value [ coding.async.request ] ##
my $ceiling = $state->{'timeout_ceiling'}
    // <coding.http-timeouts.request-completed> // 780;

my $right;
my $bar;
my $color = $TRUE_color;

if ( not defined $http_started ) {
    $bar   = '';
    $right = sprintf "%s | r%d | no data yet", $task_id, $round;
} else {
    my $http_end     = defined $tools_started ? $tools_started : $now;
    my $http_elapsed = $http_end - $http_started;
    my $http_pct     = $ceiling > 0 ? $http_elapsed / $ceiling : 0;
    my $filled       = int( $chars_max * ( $http_pct > 1 ? 1 : $http_pct ) );
    $bar = ':' x $filled;

    my $tools_elapsed
        = defined $tools_started ? $now - $tools_started : undef;

    my $tools_str = 'tools: --';
    if ( defined $tools_elapsed ) {
        my $tools_flag
            = $tools_elapsed > $ceiling ? '[!! long]'
            : $tools_elapsed > 300      ? '[! long]'
            :                             '';
        $tools_str = sprintf "tools: %ds (no ceiling) %s",
            $tools_elapsed, $tools_flag;
        $tools_str =~ s| +$||;
    }

    ## bar/color reflect http phase [ the one with the timeout ceiling ] ##
    $color = $http_pct >= 0.9 ? $WARN_color : $TRUE_color;
    ## also warn if tool execution has run unreasonably long             ##
    $color = $WARN_color
        if defined $tools_elapsed && $tools_elapsed > $ceiling;

    $right = sprintf "%s | R:%02d | http: %03ds of %03ds [%%%03d] | %s",
        $task_id, $round, $http_elapsed, $ceiling,
        int( $http_pct * 100 ), $tools_str;
}

my $rw = length $right;

my $output_str
    = sprintf( "${blacklight}:::[${nailara_bg}${color}%-13s"
        . "${reset}${blacklight}]::"
        . "[${nailara_bg}${color} %-${rw}s "
        . "${reset}${blacklight}]:.${reset}",
    $bar, $right );

return {
    'mode' => qw| true |,
    'data' => $output_str,
};

