## [:< ##

# name = base.root.drop_privs
# note = more cleanup required .,

my $noop = ( defined $ARG[1] and $ARG[1] eq qw| noop | ) ? TRUE : FALSE;

my $user_spec = shift @ARG;
shift @ARG if $noop;       ## remove 'noop' marker before building group list
my @groups_list = @ARG;    ## variable-length group parameters [ optional ]
return warn 'drop_privs : expected <user> parameter <{C2}>'
    if not defined $user_spec;

## parse user:group syntax [ primary group override ]
my $user;
my $override_primary_group;

if ( $user_spec =~ m{:} ) {
    ( $user, $override_primary_group ) = split m{:}, $user_spec, 2;
    <[base.logs]>->(
        3,     ': drop_privs : user:group override [ %s:%s ]',
        $user, $override_primary_group
    );
} else {
    $user = $user_spec;
}

my $tmp_dir_parent = qw| /var/tmp/ |;    ##  temp homedir parent directory  ##

<[base.root.check_system_user]>->($user);
<[base.check_dependency_dirs]>->($user);

if ( not length( $user // '' ) ) {
    <[base.log]>->(
        0, '<< cannot drop priviledges [ no user name supplied ] >>'
    );
    <[base.exit]>->(qw| 0110 |) if not $noop;
    return -1;
} else {

    my ($name,    $pwd,  $uid,         $gid, $quota,
        $comment, $gcos, $h_directory, $shell
    ) = getpwnam($user);

    ## handle primary group override if user:group syntax used
    if ( defined $override_primary_group ) {
        my ( $_gname, $_pw, $_override_gid )
            = getgrnam($override_primary_group);
        if ( defined $_override_gid ) {
            $gid = $_override_gid;
            <[base.logs]>->(
                2, ': drop_privs : primary group overridden : %s [gid=%s]',
                $override_primary_group, $_override_gid
            );
        } else {
            <[base.logs]>->(
                0, ': drop_privs : primary group not found [ %s ]',
                $override_primary_group
            );
        }
    }

    my %_gid = map { $ARG => TRUE } split( ' ', $GID );
    my %egid = map { $ARG => TRUE } split( ' ', $EGID );

    ## resolve secondary groups  [ explicit only if primary override,
    ##                                      or auto-detect | explicit ]
    my @secondary_gids;

    if (@groups_list) {
        ## process explicit group parameters  [ always used, replaces
        ##                                                auto-detect ]
        for my $gname (@groups_list) {
            ## handle colon-separated groups within single parameter
            my @gnames = split m{:}, $gname;
            for my $gname (@gnames) {
                my ( $_gname, $_pw, $_gid ) = getgrnam($gname);
                if ( defined $_gid ) {
                    push( @secondary_gids, $_gid );
                    <[base.logs]>->(
                        2,      ': drop_privs : adding group : %s [gid=%s]',
                        $gname, $_gid
                    );
                } else {
                    <[base.logs]>->(
                        0, ': drop_privs : group not found [ %s ]', $gname
                    );
                }
            }
        }
    } elsif ( !defined $override_primary_group ) {
        ## auto-detect secondary groups from group membership
        ##                          [ only when no primary group override ]
        while ( my ( $_name, $_pw, $_gid, $_members ) = getgrent ) {
            push( @secondary_gids, $_gid )
                if ( grep( $ARG eq $user, split( m|\s+|, $_members ) ) );
        }
    }

    ## build complete gid list [ primary + all secondary ]
    my @all_gids = ( $gid, @secondary_gids );

    ## check if already running as this user with required groups
    my %required_gids = map { $ARG => TRUE } @all_gids;
    my $has_all_gids  = 1;
    for my $req_gid (@all_gids) {
        unless ( exists $_gid{$req_gid} and exists $egid{$req_gid} ) {
            $has_all_gids = 0;
            last;
        }
    }

    if (    not $noop
        and defined $name
        and $has_all_gids
        and $EUID == $uid
        and $UID == $uid ) {
        <[base.logs]>->(
            2, "< drop_privs > already '%s', doing nothing.", $user
        );
        return -2;
    } elsif ($UID) {
        <[base.logs]>->(
            0, "<< cannot drop privs to user '%s' [ not root ] >>", $user
        );
        <[base.exit]>->(qw| 0110 |) if not $noop;
        return -1;
    } else {
        if ( not defined $name or $name ne $user ) {
            <[base.logs]>->(
                0, "<< cannot drop privs to '%s' [ no such user ] >>", $user
            );
            <[base.exit]>->(qw| 0110 |) if not $noop;
            return -1;
        } else {

            if ( not length( $h_directory // '' ) ) {
                <[base.logs]>->(
                    0, "<< undefined homedir [ user '%s' ] >>", $user
                );
                <[base.log]>->( 2, " :. setting to '/'.," );
                $h_directory = qw| / |;
            } elsif ( !-d $h_directory and $h_directory ne '/nonexistent' ) {
                <[base.logs]>->(
                    0, qq|<< user '%s' has no home dir [ creating %s ] >>|,
                    $user, $h_directory
                );
                make_path(
                    $h_directory,
                    {   'mode'  => 0700,
                        'uid'   => $uid,
                        'group' => $gid
                    }
                );
            } elsif ( !-d $h_directory or $user eq 'nobody' ) {  #/nonexistent
                <[base.logs]>->(
                    0, "<< unable to create home directory '%s' >>",
                    $h_directory
                ) if $h_directory ne qw| /nonexistent |;
                ### temporary home directory ###
                <system.privs.create_temp_home> //= FALSE;

                if ( not <system.privs.create_temp_home> ) {
                    $h_directory = qw| / |;
                    <[base.logs]>->(
                        "[unix:'nobody'] changing home path to '%s'",
                        $h_directory
                    );
                } else
                {    # creating temporary home directory for user 'nobody':.
                    my $tdir_template
                        = <system.zenka.name> ne qw| v7 |
                        ? sprintf 'temp-home.%s.%s.%d', <system.zenka.name>,
                        $user, $PID
                        : sprintf( qw| temp-home.%s.XXXXXXXXXX |, $user );
                    $h_directory = <[base.tmp_dir]>
                        ->( $tmp_dir_parent, $tdir_template );
                    if ( -d $h_directory ) {
                        chown( $uid, $gid, $h_directory )
                            or <base.s_warn]>->(
                            'chown[%u,%u,%s] : %s',
                            $uid, $gid, $h_directory, <[base.str.os_err]>
                            );
                        map { <[base.log]>->( 1, $ARG ) } (
                            ':. created temporary home directory',
                            sprintf( ' : ', $h_directory )
                        );
                        push(
                            <system.init_reports>->@*,
                            {   'target_command' => qw| v7.report-temp-path |,
                                'param'          => $h_directory,
                                'descr' => 'registering temporary directory'
                            }
                        );
                    }
                }
            }

            return {
                qw| uid |      => $uid,
                qw| gid |      => $gid,
                qw| all_gids | => join( ' ', @all_gids ),
                qw| home |     => $h_directory
                }
                if $noop;

            $EGID = join ' ', @all_gids;
            $GID  = $gid;
            $EUID = $uid;
            $UID  = $uid;

            ## log final configuration
            <[base.logs]>->(
                2, 'dropping privs to user %s [uid=%s gid=%s]',
                $user, $uid, $gid
            );
            if (@secondary_gids) {
                <[base.logs]>->(
                    2,
                    'secondary groups: %s',
                    join( ':', @secondary_gids )
                );
            }

            $ENV{'USER'}            = $name;
            $ENV{'HOME'}            = $h_directory;
            $ENV{'XDG_RUNTIME_DIR'} = $h_directory;
            $ENV{'NO_AT_BRIDGE'}    = TRUE;
            chdir($h_directory)
                or <[base.s_warn]>->(
                ":: %s : chdir [ %s ] ::\n",
                <[base.str.os_err]>, $h_directory
                );

            ## recording selected username ##
            <system.zenka-user.current> = $user
                if not defined <system.zenka-user.current>
                or $user ne <system.zenka-user.current>;

            <[base.logs]>->( "switched to unix user '%s'.,", $user );

            ## log group configuration only when explicitly specified
            if ( @groups_list || defined $override_primary_group ) {
                my @group_names;
                for my $gid (@all_gids) {
                    my $gname = getgrgid($gid);
                    push @group_names, ( $gname // $gid );
                }
                <[base.log]>->(    ## skips auto-detected ##
                    1, ":. groups : " . join( ', ', @group_names )
                );
            }
        }
    }
}

