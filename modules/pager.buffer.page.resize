## [:<
# name  = pager.buffer.page.resize
# descr = Resize page size (invalidates cache)
## >:]

return sub {
    my ($buf, $new_size) = @_;

    return 0 unless $buf && $new_size > 0;

    my $old_size = $buf->{'pages'}{'size'};
    return 0 if $old_size == $new_size;

    # Invalidate all cached pages since indices change
    <[pager.buffer.page.invalidate-all]>->({ 'buffer' => $buf });

    $buf->{'pages'}{'size'} = $new_size;

    # Recalculate max cache based on memory limit
    my $max_items = $buf->{'memory'}{'max_items'};
    $buf->{'pages'}{'max_cache'} = int($max_items / $new_size) + 1;

    return 1;
};

