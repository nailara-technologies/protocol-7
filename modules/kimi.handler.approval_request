# name  = kimi.handler.approval_request
# descr = handle incoming tool approval requests from kimi-web

my $msg_id  = shift // '';
my $payload = shift // {};

my $request_id  = $payload->{'id'}           // $msg_id;
my $tool_call   = $payload->{'tool_call_id'} // '';
my $sender      = $payload->{'sender'}       // '';
my $action      = $payload->{'action'}       // '';
my $description = $payload->{'description'}  // '';

## skip already-responded requests [ kimi-web re-sends on reconnect ]
<kimi.approval.responded> //= {};
if ( exists <kimi.approval.responded>->{$request_id} ) {
    <[base.logs]>->(
        2, ': skipping already-responded approval [ %s ]', $request_id
    );
    return;
}

## collapse newlines and truncate for readable console logging
( my $short_desc = $description ) =~ s{\n}{ }g;
$short_desc = <[base.parser.center_ellipse_string]>->( $short_desc, 72 );

<[base.logs]>->(
    1, ': approval request [ %s ] action=%s : %s',
    $request_id, $action, $short_desc
);

## store in pending approvals for manual approve/reject commands
<kimi.approval.pending>->{$request_id} = {
    'request_id'  => $request_id,
    'tool_call'   => $tool_call,
    'sender'      => $sender,
    'action'      => $action,
    'description' => $description,
    'received_at' => <[base.time]>->(3)
};

## auto-approve: check before session guard — works even during reconnect
if (<kimi.approval.auto_approve>) {
    <[base.logs]>->(
        1, ': auto-approving [ %s ] %s : %s',
        $request_id, $action, $short_desc
    );
    delete <kimi.approval.pending>->{$request_id};
    <[kimi.wire.approval_respond]>->( $request_id, 'approve' );
    return;
}

## session not yet acquired — queue for flush on acquisition, don't drop
if ( not <kimi.session.acquired> ) {
    <[base.logs]>->(
        2, ': queuing approval [ %s ] — session not yet acquired', $request_id
    );
    <kimi.approval.pending> //= {};
    <kimi.approval.pending>->{$request_id} = {
        'request_id'  => $request_id,
        'tool_call'   => $tool_call,
        'sender'      => $sender,
        'action'      => $action,
        'description' => $description,
        'received_at' => <[base.time]>->(3)
    };
    return;
}

## policy-based auto-allow for safe read-only actions
my $auto_allow = <kimi.approval.auto_allow> // {};
if ( defined $auto_allow->{$action} ) {
    <[base.logs]>->(
        1, ': policy-approved [ %s ] %s : %s',
        $request_id, $action, $short_desc
    );
    delete <kimi.approval.pending>->{$request_id};
    <[kimi.wire.approval_respond]>->( $request_id, 'approve' );
    return;
}

## otherwise leave pending — user must approve/reject via kimi.approve/reject
<[base.logs]>->(
    1, ': awaiting manual approval [ %s ] %s : %s',
    $request_id, $action, $short_desc
);

## flush pending approvals when session is acquired
sub flush_on_acquisition {
    my $aref_pending = <kimi.approval.pending> // [];
    foreach my $request_id (@$aref_pending) {
        my $payload = {
            'id'           => $request_id,
            'tool_call_id' => '',
            'sender'       => '',
            'action'       => '',
            'description'  => ''
        };
        <kimi.handler.approval_request>->( $request_id, $payload );
    }
    <kimi.approval.pending> = [];
}

return;

