## [:< ##

# name  = window.place.handler.button_release
# descr = end drag operation

my ( $id, $widget, $event ) = @ARG;

return TRUE if not defined $id;

my $inst = $data{window}{place}{instances}{$id};
return TRUE if not defined $inst;

$inst->{'drag'}{'active'} = FALSE;
delete $inst->{'drag'}{'region'};
delete $inst->{'drag'}{'start_x'};
delete $inst->{'drag'}{'start_y'};
delete $inst->{'drag'}{'start_geom'};

## compositor-driven grabs don't go through update_x11_state so we need  ##
## to sync geometry here. prefer an actual X11 query of the overlay's    ##
## final geometry -- this matches what mpv's own drag-save does and      ##
## avoids any GTK/Wayland coordinate-space mismatch. fall back to        ##
## pointer-delta / get_position if the query fails.                      ##
##                                                                       ##
## if there was no left-button interaction (pure right-click commit),    ##
## the original geometry is already correct and GTK's get_position()     ##
## must not be used -- it reports a different coordinate origin than     ##
## X11 root coords on this overlay.                                      ##
my $window          = $inst->{'window'};
my $synced_from_x11 = 0;
my $interacted      = $inst->{'placement_interacted'};

if ( $interacted and defined $window ) {
    my $eval_err   = '';
    my $actual_geo = eval {
        my $gdk_window = $window->get_window;
        if ( not defined $gdk_window ) {
            $eval_err = 'no gdk_window';
            return undef;
        }
        my $xid = $gdk_window->get_xid;
        if ( not defined $xid or $xid !~ /^\d+$/ ) {
            $eval_err = 'no xid';
            return undef;
        }
        my $g = <[base.X-11.get_window_geometry]>->($xid);
        if ( not defined $g ) {
            $eval_err = 'X-11.get_window_geometry returned undef';
            return undef;
        }
        return $g;
    };
    if ( length $EVAL_ERROR ) {
        $eval_err = <[base.str.eval_error]>->(1);
    }
    if (    defined $actual_geo
        and defined $actual_geo->{'x'}
        and defined $actual_geo->{'y'} ) {
        $inst->{'geom'}{'x'}      = $actual_geo->{'x'};
        $inst->{'geom'}{'y'}      = $actual_geo->{'y'};
        $inst->{'geom'}{'width'}  = $actual_geo->{'width'};
        $inst->{'geom'}{'height'} = $actual_geo->{'height'};
        delete $inst->{'drag_move_start'};
        $synced_from_x11 = 1;
        <[base.logs]>->(
            2,
            '[place.button_release] id=%s synced from X11 x=%d y=%d w=%d h=%d',
            $id,
            $actual_geo->{'x'},
            $actual_geo->{'y'},
            $actual_geo->{'width'},
            $actual_geo->{'height'}
        );
    } else {
        <[base.logs]>->(
            1,   '[place.button_release] id=%s X11 sync failed: %s',
            $id, length $eval_err ? $eval_err : 'unknown'
        );
    }
}

if ( $interacted and not $synced_from_x11 ) {
    if ( defined $inst->{'drag_move_start'} ) {
        my $start = delete $inst->{'drag_move_start'};
        my $dx    = $event->x_root - $start->{'ptr_x'};
        my $dy    = $event->y_root - $start->{'ptr_y'};
        $inst->{'geom'}{'x'} = $start->{'geom_x'} + $dx;
        $inst->{'geom'}{'y'} = $start->{'geom_y'} + $dy;
    } elsif ( defined $window ) {
        my ( $real_x, $real_y ) = $window->get_position;
        if ( defined $real_x and defined $real_y ) {
            $inst->{'geom'}{'x'} = $real_x;
            $inst->{'geom'}{'y'} = $real_y;
        }
    }
    if ( defined $window ) {
        my ( $real_w, $real_h ) = $window->get_size;
        if ( defined $real_w and defined $real_h ) {
            $inst->{'geom'}{'width'}  = $real_w;
            $inst->{'geom'}{'height'} = $real_h;
        }
    }
}

## right-click release : submit, same as the enter key [ see          ##
## handler.button_press for why this is deferred to release ]         ##
if ( $event->button == 3 ) {
    <[base.logs]>->(
        1, '[place.button_release] id=%s right-click commit', $id
    );
    <[window.place.commit]>->($id);
}

return TRUE;

