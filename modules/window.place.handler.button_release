# name  = window.place.handler.button_release
# descr = end drag operation

my ( $id, $widget, $event ) = @ARG;

return TRUE if not defined $id;

my $inst = $data{window}{place}{instances}{$id};
return TRUE if not defined $inst;

$inst->{'drag'}{'active'} = FALSE;
delete $inst->{'drag'}{'region'};
delete $inst->{'drag'}{'start_x'};
delete $inst->{'drag'}{'start_y'};
delete $inst->{'drag'}{'start_geom'};

## right-click release : submit, same as the enter key [ see          ##
## handler.button_press for why this is deferred to release ]         ##
if ( $event->button == 3 ) {
    <[base.logs]>->(
        1, '[place.button_release] id=%s right-click commit', $id
    );
    <[window.place.commit]>->($id);
}

return TRUE;

