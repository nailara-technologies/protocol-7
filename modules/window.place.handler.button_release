## [:< ##

# name  = window.place.handler.button_release
# descr = end drag operation

my ( $widget, $event ) = @ARG;

<window.place.drag.active> = FALSE;
delete <window.place.drag.region>;
delete <window.place.drag.start_x>;
delete <window.place.drag.start_y>;
delete <window.place.drag.start_geom>;

## right-click release : submit, same as the enter key [ see          ##
## handler.button_press for why this is deferred to release ]         ##
if ( $event->button == 3 ) {
    <[base.log]>->( 1, '[place.button_release] right-click commit' );
    <[window.place.commit]>;
}

return TRUE;

