## [:< ##

# name  = window.place.handler.button_release
# descr = end drag operation

my ( $id, $widget, $event ) = @ARG;

return TRUE if not defined $id;

my $inst = $data{window}{place}{instances}{$id};
return TRUE if not defined $inst;

$inst->{'drag'}{'active'} = FALSE;
delete $inst->{'drag'}{'region'};
delete $inst->{'drag'}{'start_x'};
delete $inst->{'drag'}{'start_y'};
delete $inst->{'drag'}{'start_geom'};

## [ testing ] a move/resize may have just been driven by the compositor's##
## own interactive grabs [ begin_move_drag / begin_resize_drag ], neither ##
## of which go through update_x11_state -- re-read the real geometry so   ##
## the readout/commit reflect where the window actually ended up, not a   ##
## stale pre-drag value.                                                  ##
my $window = $inst->{'window'};
if ( defined $window ) {
    my ( $real_x, $real_y ) = $window->get_position;
    if ( defined $real_x and defined $real_y ) {
        $inst->{'geom'}{'x'} = $real_x;
        $inst->{'geom'}{'y'} = $real_y;
    }
    my ( $real_w, $real_h ) = $window->get_size;
    if ( defined $real_w and defined $real_h ) {
        $inst->{'geom'}{'width'}  = $real_w;
        $inst->{'geom'}{'height'} = $real_h;
    }
}

## right-click release : submit, same as the enter key [ see          ##
## handler.button_press for why this is deferred to release ]         ##
if ( $event->button == 3 ) {
    <[base.logs]>->(
        1, '[place.button_release] id=%s right-click commit', $id
    );
    <[window.place.commit]>->($id);
}

return TRUE;

