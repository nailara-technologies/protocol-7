## [:< ##

# name  = X-11.cmd.show-log-move
# descr = enable verbose logging for move-window

return { 'mode' => qw| false |, 'data' => 'already enabled.' }
    if <X-11.log-cfg.verbose.move-window> //= FALSE;

<X-11.log-cfg.verbose.move-window> = TRUE;

<[base.log]>->( 1, ":: verbose 'move-window' logging enabled.. ::" );

return {
    'mode' => qw| true |,
    'data' => 'verbose move-window loggin enabled'
    }

