## [:< ##

# name  = context.provider.frame
# descr = ascii frame section provider for context.template.resolve

my $params = shift // {};

## frame resolution ##
my $entry;
my $frame_name;

if ( defined $params->{'frame'} ) {
    $frame_name = $params->{'frame'};
    $entry      = <[ascii.frame.load]>->($frame_name);
} elsif ( defined $params->{'mockup'} ) {
    $frame_name = 'inline';
    my $mockup    = $params->{'mockup'};
    my $cache_key = sprintf 'mockup:%d:%s',
        length($mockup),
        <[base.chk-sum.elf]>->($mockup);
    if ( exists <context.frame.cache>->{$cache_key} ) {
        $entry = <context.frame.cache>->{$cache_key};
    } else {
        my $result = <[ascii.frame.from_mockup]>
            ->( { mockup => $mockup, strict => 0 } );
        if ( $result->{'ok'} ) {
            $entry = {
                name         => 'inline',
                descriptor   => $result->{'descriptor'},
                border_style => 'single',
            };
            <context.frame.cache>->{$cache_key} = $entry;
        } else {
            return "<!-- frame 'inline' not available: parse failed -->";
        }
    }
} else {
    return "<!-- frame ??? not available: no frame or mockup param -->";
}

if ( not defined $entry ) {
    return "<!-- frame '$frame_name' not available: load failed -->";
}

## mode selection ##
my $mode = $params->{'mode'} // 'expanded';
my $descriptor;
my $name = $entry->{'name'} // $frame_name;

if ( exists $entry->{'descriptor'} ) {
    ## single-mode frame : ignore $mode ##
    $descriptor = $entry->{'descriptor'};
} elsif ( exists $entry->{'descriptors'} ) {
    ## dual-mode frame : pick by name ##
    $descriptor = $entry->{'descriptors'}{$mode}
        // $entry->{'descriptors'}{'expanded'}
        // ( values %{ $entry->{'descriptors'} } )[0];
}

if ( not defined $descriptor ) {
    return "<!-- frame '$name' not available: no descriptor for "
        . "mode '$mode' -->";
}

## slot values ##
my $values = $params->{'vars'} // {};

## rendering ##
my $rendered = <[ascii.frame.render]>->(
    {   descriptor => $descriptor,
        values     => $values,
    }
);

if ( not defined $rendered or not length $rendered ) {
    return "<!-- frame '$name' not available: render failed -->";
}

## border style double ##
if ( ( $entry->{'border_style'} // 'single' ) eq 'double' ) {
    my @rl = split "\n", $rendered, -1;
    ## first and last lines are borders : leave them alone ##
    ## NOTE : if descriptor has no bottom border, only first line is border ##
    my $top_idx = 0;
    my $bot_idx = $#rl;
    ## detect whether last line is a structural border [ density >= 0.5 ] ##
    my $last_line = $rl[$bot_idx] // '';
    my $sc        = 0;
    $sc++ while $last_line =~ m{[:.,#=\[\]]}g;
    my $density        = length($last_line) ? $sc / length($last_line) : 0;
    my $last_is_border = $density >= 0.5;
    my $end_content    = $last_is_border ? $bot_idx - 1 : $bot_idx;

    for my $i ( $top_idx + 1 .. $end_content ) {
        $rl[$i] =~ s{^:}{::};
        $rl[$i] =~ s{:$}{::};
    }
    $rendered = join "\n", @rl;
}

## budget truncation with sentinel ##
my $budget = $params->{'budget'};
if ( defined $budget and $budget > 0 ) {
    ## chars-per-token approximation ; render is already chars ##
    my $char_budget = $budget * <context.cfg.chars_per_token>;
    if ( length($rendered) > $char_budget ) {
        ## truncate to last complete line within budget ##
        my $trunc = substr( $rendered, 0, $char_budget );
        $trunc =~ s|[^\n]*$||s;
        $trunc =~ s|\n$||;
        ## append a reconstructed bottom border so the frame stays closed ##
        my $sentinel = _frame_bottom_sentinel( $descriptor, $values,
            $entry->{'border_style'} // 'single' );
        $rendered = $trunc . "\n" . $sentinel;
    }
}

## color pass ##
if ( $params->{'color'} ) {
    my $colored = <[ascii.frame.render.color]>->($rendered);
    $rendered = $colored if defined $colored;
}

return $rendered;

##[ compute bottom border sentinel for truncated frame ]##
sub _frame_bottom_sentinel {
    my ( $descriptor, $values, $border_style ) = @_;

    my $border      = $descriptor->{'border'}    // {};
    my $min_width   = $descriptor->{'min_width'} // 0;
    my $padding     = $descriptor->{'padding'}   // { left => 0, right => 0 };
    my $slots       = $descriptor->{'slots'}     // {};
    my $static_rows = $descriptor->{'static_rows'} // {};

    my $lpad = $padding->{'left'}  // 0;
    my $rpad = $padding->{'right'} // 0;

    ## compute required width [ replicate ascii.frame.render logic ] ##
    my $required_width = $min_width;

    ## static rows drive content width when no slots present ##
    for my $row ( keys %{$static_rows} ) {
        my $static        = $static_rows->{$row};
        my $content_width = length($static);
        $required_width = $content_width if $content_width > $required_width;
    }

    ## field slots drive content width ##
    for my $slot_name ( keys %{$slots} ) {
        my $slot = $slots->{$slot_name};
        if ( $slot->{'type'} eq qw| field | ) {
            my $value = $values->{$slot_name} // '';
            my $row_width
                = length( $slot->{'prefix'} // '' )
                + length($value)
                + length( $slot->{'suffix'} // '' )
                + $lpad + $rpad;
            $required_width = $row_width if $row_width > $required_width;
        } elsif ( $slot->{'type'} eq qw| composed |
            and exists $slot->{'inner_width'} ) {
            ## composed inner frame constrains outer width ##
            my $inner_total = $slot->{'inner_width'};
            my $content_width
                = $inner_total
                - length( $border->{'left'}  // '' )
                - length( $border->{'right'} // '' );
            $required_width = $content_width
                if $content_width > $required_width;
        }
    }

    ## inline slots in borders also contribute ##
    for my $el ( @{ $border->{'top'} // [] } ) {
        if ( $el->{'type'} eq qw| slot | ) {
            my $val_len      = length( $values->{ $el->{'name'} } // '' );
            my $border_width = $min_width + $val_len;
            $required_width = $border_width
                if $border_width > $required_width;
        }
    }
    for my $el ( @{ $border->{'bottom'} // [] } ) {
        if ( $el->{'type'} eq qw| slot | ) {
            my $val_len      = length( $values->{ $el->{'name'} } // '' );
            my $border_width = $min_width + $val_len;
            $required_width = $border_width
                if $border_width > $required_width;
        }
    }

    ## total frame width includes left and right borders ##
    my $frame_width
        = $required_width
        + length( $border->{'left'}  // '' )
        + length( $border->{'right'} // '' );

    ## render bottom border line [ replicate _render_border_line algorithm ] ##
    my $elements = $border->{'bottom'} // [];
    if ( not @{$elements} ) {
        return '.:[ truncated ]:.';
    }

    ## compute fixed width and fill min sum ##
    my $fixed_width  = 0;
    my $fill_count   = 0;
    my $fill_min_sum = 0;
    for my $el ( @{$elements} ) {
        if ( $el->{'type'} eq qw| anchor | ) {
            $fixed_width += length( $el->{'value'} // '' );
        } elsif ( $el->{'type'} eq qw| slot | ) {
            $fixed_width += length( $values->{ $el->{'name'} } // '' );
        } elsif ( $el->{'type'} eq qw| fill | ) {
            $fill_count++;
            $fill_min_sum += $el->{'min'} // 1;
        }
    }

    my $available_fill = $frame_width - $fixed_width;
    $available_fill = $fill_count if $available_fill < $fill_count;

    ## distribute fill among fill elements ##
    my %fill_alloc;
    if ( $fill_count > 0 and $available_fill > 0 ) {
        my @fill_indices = grep { $elements->[$_]->{'type'} eq qw| fill | }
            0 .. $#{$elements};
        if ( @fill_indices == 1 ) {
            $fill_alloc{ $fill_indices[0] } = $available_fill;
        } else {
            ## proportional distribution based on min ##
            my $allocated = 0;
            for my $i ( 0 .. $#fill_indices ) {
                my $idx   = $fill_indices[$i];
                my $min   = $elements->[$idx]->{'min'} // 1;
                my $alloc = int( $available_fill * $min / $fill_min_sum );
                $alloc = 1 if $alloc < 1;
                $fill_alloc{$idx} = $alloc;
                $allocated += $alloc;
            }
            ## adjust for rounding : give remainder to last fill ##
            my $remainder = $available_fill - $allocated;
            if ( $remainder != 0 and @fill_indices ) {
                $fill_alloc{ $fill_indices[-1] } += $remainder;
            }
        }
    }

    ## build line ##
    my $line = '';
    for my $i ( 0 .. $#{$elements} ) {
        my $el = $elements->[$i];
        if ( $el->{'type'} eq qw| anchor | ) {
            $line .= $el->{'value'} // '';
        } elsif ( $el->{'type'} eq qw| slot | ) {
            $line .= $values->{ $el->{'name'} } // '';
        } elsif ( $el->{'type'} eq qw| fill | ) {
            my $flen = $fill_alloc{$i} // 1;
            $flen = 1 if $flen < 1;
            $line .= $el->{'char'} x $flen;
        }
    }

    ## apply double border to sentinel if needed ##
    if ( $border_style eq 'double' ) {
        $line =~ s{^:}{::};
        $line =~ s{:$}{::};
    }

    return $line;
}

