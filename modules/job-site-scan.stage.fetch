## [:< ##

# name  = job-site-scan.stage.fetch
# descr = begin scanning — route-send to site-yaml.import per search url

<job-site-scan.cycle>     = 'scanning';
<job-site-scan.last_scan> = time;
<[job-site-scan.state.persist]>;

my $urls_cfg = <job-site-scan.cfg.search_urls> // '';
my @urls     = split m{\s+}, $urls_cfg;

if ( not @urls ) {
    <[base.logs]>->( 0, 'jss.fetch: no search urls configured' );
    <job-site-scan.cycle> = 'idle';
    <[job-site-scan.state.persist]>;
    return;
}

<[base.logs]>->( 1, 'jss.fetch: scanning %d url(s)', scalar @urls );

for my $url (@urls) {
    <[base.protocol-7.route-send]>->(
        {   'command'   => 'site-yaml.import',
            'call_args' => { 'args' => $url },
            'reply'     => {
                'handler' => 'job-site-scan.handler.fetch-done',
                'params'  => { 'url' => $url },
            },
        }
    );
}

