## [:< ##

# name  = job-site-scan.stage.fetch
# descr = begin scanning — route-send site-yaml.import per category url

<job-site-scan.cycle>     = 'scanning';
<job-site-scan.last_scan> = time;
<[job-site-scan.state.persist]>;

## build category → url map from config
my $cats_cfg = <job-site-scan.cfg.categories> // '';
my @cats     = split m{\s+}, $cats_cfg;

if ( not @cats ) {
    <[base.logs]>->( 0, 'jss.fetch: no categories configured' );
    <job-site-scan.cycle> = 'idle';
    <[job-site-scan.state.persist]>;
    return;
}

my %cat_urls;
for my $cat (@cats) {
    my $url_key = "job-site-scan.cfg.url.$cat";
    my $url     = $data{$url_key} // '';
    if ( not length $url ) {
        <[base.logs]>->( 0, 'jss.fetch: no url for category %s', $cat );
        next;
    }
    $cat_urls{$cat} = $url;
}

if ( not %cat_urls ) {
    <[base.logs]>->( 0, 'jss.fetch: no valid category urls found' );
    <job-site-scan.cycle> = 'idle';
    <[job-site-scan.state.persist]>;
    return;
}

<[base.logs]>->(
    1,
    'jss.fetch: scanning %d categories: %s',
    scalar keys %cat_urls,
    join( ', ', sort keys %cat_urls )
);

for my $cat ( sort keys %cat_urls ) {
    <[protocol-7.route-send]>->(
        {   'command'   => 'site-yaml.import',
            'call_args' => { 'args' => $cat_urls{$cat} },
            'reply'     => {
                'handler' => 'job-site-scan.handler.fetch-done',
                'params'  => { 'category' => $cat, 'url' => $cat_urls{$cat} },
            },
        }
    );
}

## track how many fetch replies we expect
<job-site-scan.fetch_pending> = scalar keys %cat_urls;

