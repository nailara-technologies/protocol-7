# name  = source.target_namespace
# descr = resolves a subroutine name to its on-disk path and namespace root

my $sub_name = shift // '';

return undef if not length $sub_name;

my $rel_path = sprintf qw| modules/%s |, $sub_name;

# [ check alternate paths via base.check_bin_p7 ]
my $checked_rel;
$checked_rel = <[base.check_bin_p7]>->($rel_path)
    if defined $code{'base.check_bin_p7'};

$rel_path = $checked_rel if defined $checked_rel;

my $abs_path = undef;
$abs_path = abs_path( catfile( <system.root_path>, $rel_path ) )
    if defined <system.root_path>;

# [ derive namespace root ]
my $namespace = $sub_name;
$namespace =~ s|\.[^.]+$||;

return {
    qw| path      | => $rel_path,
    qw| abs_path  | => $abs_path,
    qw| namespace | => $namespace
};

