# name = models.cmd.load_conversation
# descr = load conversation from persistent storage

my $params = {};

if ( defined $call->{'param'} && ref $call->{'param'} eq 'HASH' ) {
    $params = $call->{'param'};
} elsif ( defined $call->{'args'} && length $call->{'args'} ) {
    eval { $params = JSON::PP::decode_json( $call->{'args'} ); };
    if ($EVAL_ERROR) {
        eval { $params = YAML::XS::Load( $call->{'args'} ); };
    }
    $params = {} if $EVAL_ERROR;
}

my $filename = $params->{'filename'} // '';
my $job_id   = $params->{'job_id'}   // '';

if ( !length($filename) && !length($job_id) ) {
    return {
        'mode' => 'false',
        'data' => "error: filename or job_id required\n"
    };
}

my $result = <[models.conversation.load]>->(
    {
        'filename' => $filename,
        'job_id'   => $job_id,
    }
);

my $yaml_data = YAML::XS::Dump($result);
return {
    'mode' => 'size',
    'data' => $yaml_data
};

