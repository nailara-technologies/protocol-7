## [:<
# name  = pager.command.demo
# descr = Demo pager with sample data
## >:]

return sub {
    my ($args, $caller) = @_;

    my $count = $args->[0] // 1000;
    my $source_type = $args->[1] // 'file-list';

    # Create demo pager
    my $buffer_id = <[pager.buffer.virtual]>->({
        'source_type' => $source_type,
        'source_args' => {
            'root'      => '/tmp',
            'recursive' => 0,
        },
        'page_size' => 20,
        'max_cache' => 5,
    });

    return "Failed to create pager" unless $buffer_id;

    # Add harmonic random filter for "pleasant" ordering
    <[pager.filter.chain]>->({
        'buffer_id' => $buffer_id,
        'action'    => 'add',
        'type'      => 'harmonic-random',
        'params'    => { 'seed' => 42, 'strength' => 0.7 },
    });

    # Add preference filter
    <[pager.filter.chain]>->({
        'buffer_id' => $buffer_id,
        'action'    => 'add',
        'type'      => 'preference',
        'params'    => { 'recent' => 0.5, 'type_pref' => 0.3 },
    });

    # Set multi-key sort
    <[pager.sort.chain]>->({
        'buffer_id' => $buffer_id,
        'action'    => 'set',
        'type'      => 'multi-key',
        'keys'      => [
            { 'field' => 'mtime', 'dir' => 'desc', 'weight' => 0.5 },
            { 'field' => 'size',  'dir' => 'asc',  'weight' => 0.3 },
            { 'field' => 'name',  'dir' => 'asc',  'weight' => 0.2 },
        ],
    });

    # Render viewport
    my $render = <[pager.viewport.render]>->({
        'buffer_id' => $buffer_id,
        'top'       => 0,
        'height'    => 20,
        'width'     => 80,
    });

    my $output = "=== Pager Demo ($buffer_id) ===\n";
    $output .= "Filters: harmonic-random, preference\n";
    $output .= "Sort: mtime(desc):0.5, size(asc):0.3, name(asc):0.2\n";
    $output .= "=" x 80 . "\n";
    $output .= join("\n", @{$render->{'lines'}}) if $render;
    $output .= "\n" . "=" x 80 . "\n";

    # Show stats
    my $buf = $data{'pager'}{'buffers'}{$buffer_id};
    if ($buf) {
        $output .= sprintf("Stats: hits=%d misses=%d prefetches=%d\n",
            $buf->{'stats'}{'hits'},
            $buf->{'stats'}{'misses'},
            $buf->{'stats'}{'prefetches'}
        );
    }

    # Cleanup
    delete $data{'pager'}{'buffers'}{$buffer_id};

    return $output;
};

