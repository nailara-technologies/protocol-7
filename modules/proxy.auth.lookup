## [:< ##

# name  = proxy.auth.lookup
# descr = async credential lookup via credential_fabric.resolve.
#         args: $client_id
#         calls proxy.handler.post_auth when done (via reply or cache hit).

my $client_id = shift;
my $client    = $data{'proxy'}{'clients'}{$client_id};
return if not defined $client;

my $context = $client->{'context'};
my $domain  = $context->{'request'}{'domain'} // '';

## no domain: skip auth ##
if ( not length $domain ) {
    $client->{'state'} = 'processing';
    <[proxy.handler.post_auth]>->($client_id);
    return;
}

## cache hit ##
if ( exists $data{'proxy'}{'auth_cache'}{$domain} ) {
    $context->{'auth'} = $data{'proxy'}{'auth_cache'}{$domain};
    $client->{'state'} = 'processing';
    <[proxy.handler.post_auth]>->($client_id);
    return;
}

## async route to credential_fabric.resolve ##
my $slot = 'session.' . $domain;
<[protocol-7.route-send]>->(
    {   'command'   => 'credential_fabric.resolve',
        'call_args' => { 'args' => $slot },
        'reply'     => {
            'handler' => 'proxy.handler.auth_lookup_reply',
            'params'  => { 'client_id' => $client_id, 'domain' => $domain },
        },
    }
);

return;

