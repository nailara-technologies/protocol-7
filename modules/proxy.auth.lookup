## [:< ##

# name  = proxy.auth.lookup
# descr = proxy auth lookup stub replaced by credential fabric.
#         extracts domain from request context and attempts credential resolution.
#         args: $context_hash
#         returns: { has_session => bool, slots => {} } or undef

my $context = shift;

return undef if ref $context ne qw| HASH |;

my $domain = $context->{'request'}{'domain'} // '';
return { 'has_session' => FALSE, 'slots' => {} } unless length $domain;

## check cache ##
my $cache_key = $domain;
if ( exists $data{'proxy'}{'auth_cache'}{$cache_key} ) {
    return $data{'proxy'}{'auth_cache'}{$cache_key};
}

## try session slot for this domain ##
my $slot = 'session.' . $domain;

my $result = <[credential_fabric.resolve]>->(
    {   'slot'    => $slot,
        'context' => $context,
    }
);

if (    defined $result
    and ref $result eq qw| HASH |
    and $result->{'mode'} eq qw| true | ) {
    my $auth_result = {
        'has_session' => TRUE,
        'slots'       => { $slot => $result },
    };
    $data{'proxy'}{'auth_cache'}{$cache_key} = $auth_result;
    return $auth_result;
}

## no session found ##
my $no_auth = { 'has_session' => FALSE, 'slots' => {} };
$data{'proxy'}{'auth_cache'}{$cache_key} = $no_auth;
return $no_auth;

