## [:< ##

# name  = users.record.build
# param = <username> <fields_href> <existing_href_or_undef>
# descr = build a host-system record envelope [ name/checksum/timestamp/
#         metadata/fields ], reusing an existing record's creation
#         timestamp when present

my ( $username, $fields_href, $existing_href ) = @ARG;

$fields_href = {} if ref $fields_href ne qw| HASH |;

## users.record.sorted_fields [ contact, phone -- neither has a manual reorder
## control anywhere in the editor, so insertion order is effectively arbitrary
## and reads as unintentional mess rather than a meaningful sequence ] are
## normalised to a canonical order on every WRITE, via base.sort [ length
## ascending, alphabetical-descending tiebreak -- see
## base.access.special-user-map / amos-term.term-params-update for the same
## idiom elsewhere ] -- so display never depends on typing/insertion order and
## every reader [ users.value-get/-all, a future export, the form's own
## re-display after submit ] sees the identical order without re-sorting
## itself.  the AUTHORITY's job, not the form's : this is the one place every
## write path [ user-edit's submit, a direct users.value-set, an installer ]
## converges through, so normalising anywhere else would leave the others
## unsorted.  a shallow copy, not an in-place mutation of the caller's array
## -- callers may still hold that arrayref themselves
my %fields = %{$fields_href};
foreach my $sorted_field (<[users.record.sorted_fields]>) {
    $fields{$sorted_field} = [ <[base.sort]>->( $fields{$sorted_field} ) ]
        if ref $fields{$sorted_field} eq qw| ARRAY |;
}

## creation timestamp is immutable once set -- reuse it across updates, ##
## fall back to a fresh one for brand-new or legacy/malformed records   ##
my $timestamp = <[base.ntime]>;
$timestamp = $existing_href->{'timestamp'}
    if ref $existing_href eq qw| HASH |
    and defined $existing_href->{'timestamp'}
    and length $existing_href->{'timestamp'};

## identity checksum is name-derived only -- never reads key material, so a ##
## record can always be built even before the user has any key              ##
my $checksum = substr( <[chk-sum.amos]>->("host-system:$username"), 0, 7 );

return {
    'name'      => $username,
    'checksum'  => $checksum,
    'timestamp' => $timestamp,
    'metadata'  => { 'updated_at' => <[base.ntime]> },
    'fields'    => \%fields
};

