## [:< ##

# name  = coding.cmd.tree-list
# param = [path] [pattern]
# descr = list children of a %data tree branch

my $args_str = $call->{'args'} // '';
my ( $path, $pattern ) = split m| |, $args_str, 2;

$path    //= '';
$pattern //= '';

my $result = $code{'coding.tools.handler.tree_list'}->(
    {   'path'    => $path,
        'pattern' => $pattern,
        'depth'   => 2,
        'budget'  => 3000
    }
);

return { 'mode' => qw| false |, 'data' => $result }
    if defined $result and $result =~ m{^(error|path not found|leaf value)};

return { 'mode' => qw| size |, 'data' => $result // 'no data' };

0;

