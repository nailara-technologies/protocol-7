## [:< ##

# name  = plugin.web.jobs.cache.read_all
# descr = return in-memory job cache, loading from disk once on first call

return <plugin.web.jobs.cache>
    if ref <plugin.web.jobs.cache> eq qw| HASH |;

my $cache_dir = <[plugin.web.jobs.cache.path]>;
my %jobs;

if ( -d $cache_dir ) {
    opendir my $dh, $cache_dir or do {
        <plugin.web.jobs.cache> = \%jobs;
        return \%jobs;
    };
    my @files = grep { m|\.yaml$| && !m|^\.| } readdir $dh;
    closedir $dh;

    for my $file (@files) {
        my $job_id = $file =~ s|\.yaml$||r;
        my $job    = eval { YAML::XS::LoadFile("$cache_dir/$file") };
        if ($EVAL_ERROR) {
            <[base.logs]>->(
                0,     'jobs.cache.read_all: error %s: %s',
                $file, <[base.str.eval_error]>
            );
            next;
        }
        $jobs{$job_id} = $job if ref $job eq qw| HASH |;
    }
}

<plugin.web.jobs.cache> = \%jobs;

return <plugin.web.jobs.cache>;

