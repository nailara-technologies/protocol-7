# name  = llama-server-vision.handler.check_completion
# descr = check if vision job is complete (process exited AND all data read)

my $watcher = shift->w;
my $job_id = $watcher->data;

my $vision_job = <llama-server-vision.jobs>->{$job_id};

unless ( defined $vision_job ) {
    $watcher->cancel if $watcher->is_active;
    return;
}

# Check if process has exited
my $pid = $vision_job->{'pid'};
my $wait_res = <[base.waitpid]>->($pid);

<[base.logs]>->( 1, "[check_completion] process exit check: pid=%d, wait_res=%s", $pid, (defined $wait_res ? $wait_res : 'undef') );

# Process still running
return if !defined $wait_res or $wait_res == 0;

# Process has exited - check if both streams closed
my $both_closed = $vision_job->{'rdr_closed'} && $vision_job->{'err_closed'};
return unless $both_closed;

# Process exited AND all data read - now we can send response
$watcher->cancel if $watcher->is_active;
delete <llama-server-vision.timers>->{$job_id};

# Extract output - using --json-schema for structured output
# Note: init logs are mixed inside the JSON output, so we can't parse directly
# We'll extract the description field using regex pattern matching
my $full_stdout = $vision_job->{'output'};
my $full_stderr = $vision_job->{'stderr'};
my $payload = '';

<[base.logs]>->( 1, "[check_completion] raw stdout length: %d bytes, stderr length: %d bytes",
                 length($full_stdout), length($full_stderr) );

# Determine which buffer has more content (model response is likely in the larger one)
my $primary_buffer = length($full_stderr) > length($full_stdout) ? $full_stderr : $full_stdout;
my $full_output = $full_stdout . $full_stderr;  # Still combine both for pattern search

# Log first 300 chars for debugging
if ( length $full_output > 0 ) {
    <[base.logs]>->( 1, "[check_completion] primary buffer has %d bytes, combined first 300 chars: %s",
                     length($primary_buffer), substr($full_output, 0, 300) );
}

# Extract model response - output contains token-by-token debug logs interspersed
# Pattern: TEXT[TIMESTAMP] [/path:LINE][FUNCTION] TEXT[TIMESTAMP]...
# We need to aggressively strip ALL debug patterns and keep only the generated text

# Remove all timestamp patterns: [10 digits]
$full_output =~ s/\[\d{10}\]\s*//g;

# Remove all file path patterns: [/path: digits]
$full_output =~ s/\[\/[^\]]*\]\s*//g;

# Replace all function/label patterns with spaces: [generate_response], [   main   ], etc.
# Handle spaces inside brackets: \[\s*[a-z_]+\s*\]
# Use space replacement to prevent word merging
$full_output =~ s/\[\s*[a-z_]+\s*\]/ /g;

# Find and skip the initialization section - everything before model loading completes
# The "main: loading model:" marker indicates the end of initialization
my $init_marker = 'main: loading model:';
my $init_end_pos = index($full_output, $init_marker);

<[base.logs]>->( 1, "[check_completion] init marker search: looking for '%s'", $init_marker );

if ( $init_end_pos >= 0 ) {
    # Find the end of the model loading line (next newline after the model path)
    my $line_end = index($full_output, "\n", $init_end_pos);
    if ( $line_end > $init_end_pos ) {
        # Skip to the character after the newline
        $full_output = substr($full_output, $line_end + 1);
        <[base.logs]>->( 1, "[check_completion] found init marker at %d, skipped %d bytes of init output",
                         $init_end_pos, $line_end + 1 );
    } else {
        # No newline found, might be at end of buffer - skip from marker onwards
        $full_output = substr($full_output, $init_end_pos);
        <[base.logs]>->( 1, "[check_completion] found init marker at %d, skipped to marker location",
                         $init_end_pos );
    }
} else {
    <[base.logs]>->( 1, "[check_completion] init marker not found in cleaned output, continuing with pattern matching" );
}

# Remove llama_print_timings section and everything after it
my $timing_pos = index($full_output, 'llama_print_timings');
if ( $timing_pos > 0 ) {
    $full_output = substr($full_output, 0, $timing_pos);
}

# Find where the actual vision analysis text starts
# Look for common starting patterns: "This", "The", "A ", "An " followed by image/scene/photo descriptors
# These typically mark the start of the actual analysis (not init/debug messages)
my $analysis_start = -1;

# Try to find "This image", "The image", "A highly", etc. - common vision analysis starts
if ( $full_output =~ m/(This|The|A|An)\s+[a-z]/i ) {
    $analysis_start = index($full_output, $&);
}

# If not found with that pattern, look for "This" anywhere (case insensitive)
if ( $analysis_start < 0 && $full_output =~ m/\bThis\b/i ) {
    $analysis_start = index($full_output, 'This');
}

# Extract from the analysis start
if ( $analysis_start > 0 ) {
    $full_output = substr($full_output, $analysis_start);
}

# Trim and clean up
$full_output =~ s/\s+/ /g;  # Collapse multiple spaces/newlines
$full_output =~ s/^\s+|\s+$//g;  # Trim edges

# Remove spaces before punctuation (tokenization artifact cleanup)
$full_output =~ s/\s+([,.!?;:'")])/$1/g;

# The cleaned output should now be the vision analysis text
if ( length $full_output > 20 ) {  # Sanity check - should be at least somewhat substantial
    $payload = $full_output;
    <[base.logs]>->( 1, "[check_completion] extracted model response, length: %d bytes", length($payload) );
} else {
    <[base.logs]>->( 1, "[check_completion] output too short or empty: '%s'", $full_output );
}

# Store stderr for diagnostic access
$vision_job->{'debug_log'} = $vision_job->{'stderr'};
$vision_job->{'raw_payload_sample'} = $payload;

if ( length $payload ) {
    $vision_job->{'status'} = 'completed';
    <[base.logs]>->( 1, "[check_completion] success: job=%s payload_bytes=%d",
                     $job_id, length($payload) );
    <[base.callback.cmd_reply]>->(
        $vision_job->{'reply_id'},
        { 'mode' => 'size', 'data' => $payload }
    );
} else {
    $vision_job->{'status'} = 'failed';
    $vision_job->{'error'} = 'no response from vision model';
    <[base.logs]>->( 0, "ERROR: No analysis output from vision CLI: job=%s", $job_id );
    <[base.callback.cmd_reply]>->(
        $vision_job->{'reply_id'},
        { 'mode' => 'false', 'data' => 'no response from vision model' }
    );
}

# Schedule cleanup after 60 seconds
<[event.add_timer]>->(
    {
        'after'   => 60,
        'handler' => 'llama-server-vision.handler.job_cleanup',
        'data'    => $job_id
    }
);

