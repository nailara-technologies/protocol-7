# name  = llama-server-vision.handler.check_completion
# descr = check if vision job is complete (process exited AND all data read)

my $watcher = shift->w;
my $job_id = $watcher->data;

my $vision_job = <llama-server-vision.jobs>->{$job_id};

unless ( defined $vision_job ) {
    $watcher->cancel if $watcher->is_active;
    return;
}

# Check if process has exited
my $pid = $vision_job->{'pid'};
my $wait_res = <[base.waitpid]>->($pid);

<[base.logs]>->( 1, "[check_completion] process exit check: pid=%d, wait_res=%s", $pid, (defined $wait_res ? $wait_res : 'undef') );

# Process still running
return if !defined $wait_res or $wait_res == 0;

# Process has exited - check if both streams closed
my $both_closed = $vision_job->{'rdr_closed'} && $vision_job->{'err_closed'};
return unless $both_closed;

# Process exited AND all data read - now we can send response
$watcher->cancel if $watcher->is_active;
delete <llama-server-vision.timers>->{$job_id};

# Extract output - using --json-schema for structured output
# Note: init logs are mixed inside the JSON output, so we can't parse directly
# We'll extract the description field using regex pattern matching
my $full_stdout = $vision_job->{'output'};
my $full_stderr = $vision_job->{'stderr'};
my $payload = '';

<[base.logs]>->( 1, "[check_completion] raw stdout length: %d bytes, stderr length: %d bytes",
                 length($full_stdout), length($full_stderr) );

# Determine which buffer has more content (model response is likely in the larger one)
my $primary_buffer = length($full_stderr) > length($full_stdout) ? $full_stderr : $full_stdout;
my $full_output = $full_stdout . $full_stderr;  # Still combine both for pattern search

# Log first 300 chars for debugging
if ( length $full_output > 0 ) {
    <[base.logs]>->( 1, "[check_completion] primary buffer has %d bytes, combined first 300 chars: %s",
                     length($primary_buffer), substr($full_output, 0, 300) );
}

# Extract model response - with --log-disable, output should be clean JSON-like format
# Look for "description": "..." pattern and extract the text

# Simple pattern: "description": "TEXT" where TEXT extends until closing quote
if ( $full_output =~ m/"description"\s*:\s*"((?:[^"\\]|\\.)*)"/ ) {
    $payload = $1;

    # Unescape JSON escapes just in case
    $payload =~ s/\\"/"/g;
    $payload =~ s/\\\\/\\/g;

    # Collapse multiple spaces/newlines
    $payload =~ s/\s+/ /g;
    $payload =~ s/^\s+|\s+$//g;

    <[base.logs]>->( 1, "[check_completion] extracted model response, length: %d bytes", length($payload) );
} else {
    <[base.logs]>->( 1, "[check_completion] could not find 'description' field in output" );
}

# Store stderr for diagnostic access
$vision_job->{'debug_log'} = $vision_job->{'stderr'};
$vision_job->{'raw_payload_sample'} = $payload;

if ( length $payload ) {
    $vision_job->{'status'} = 'completed';
    <[base.logs]>->( 1, "[check_completion] success: job=%s payload_bytes=%d",
                     $job_id, length($payload) );
    <[base.callback.cmd_reply]>->(
        $vision_job->{'reply_id'},
        { 'mode' => 'size', 'data' => $payload }
    );
} else {
    $vision_job->{'status'} = 'failed';
    $vision_job->{'error'} = 'no response from vision model';
    <[base.logs]>->( 0, "ERROR: No analysis output from vision CLI: job=%s", $job_id );
    <[base.callback.cmd_reply]>->(
        $vision_job->{'reply_id'},
        { 'mode' => 'false', 'data' => 'no response from vision model' }
    );
}

# Schedule cleanup after 60 seconds
<[event.add_timer]>->(
    {
        'after'   => 60,
        'handler' => 'llama-server-vision.handler.job_cleanup',
        'data'    => $job_id
    }
);

