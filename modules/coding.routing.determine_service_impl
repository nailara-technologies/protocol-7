## [:< ##

# name = coding.routing.determine_service_impl
# descr = Determine optimal service based on task type and complexity with model metadata

my ($task) = @ARG;

my $type        = $task->{type}                   // 'analysis';
my $complexity  = $task->{analysis}->{complexity} // 5;
my $constraints = $task->{request}->{constraints} // [];

<[base.logs]>->(
    1,     "[coding.routing] determine_service: type=%s complexity=%d",
    $type, $complexity
);

## use discovered model ids [ not hardcoded names ]
my $gpu_model = <inference.backend.gpu.model_id>
    // <inference.backend.cpu.model_id> // 'local';

## available models from discovery cache [ may be empty on first run ]
my $meta_cache = <coding.model_metadata> // {};
my @available  = sort keys %{$meta_cache};

## filter by memory availability [ prefer smaller models when ram is
## constrained ]
my $mem_pct = <coding.system_mem_pct> // 0;
if ( $mem_pct > 75 && @available ) {
    ## sort by size_gb ascending to prefer smaller models [ ram pressure ]
    @available = sort {
        ( $meta_cache->{$a}{'size_gb'} // 999 )
            <=> ( $meta_cache->{$b}{'size_gb'} // 999 )
    } @available;
    <[base.logs]>->(
        2, "[coding.routing] memory at %.2f%% :. preferring smaller models",
        $mem_pct
    );
}

my $primary = @available ? $available[0] : $gpu_model;

## for multi-model scenarios: use discovered models or repeat primary
my $multi_count = 3;
my @multi_models
    = @available >= $multi_count
    ? @available[ 0 .. $multi_count - 1 ]
    : ($primary) x $multi_count;

## transcription → whisper [ no tokens ]
if ( $type eq 'transcription' ) {
    return {
        service    => 'whisper',
        reason     => 'task is audio transcription',
        token_cost => 0,
        priority   => 'direct'
    };
}

## image generation → invoke-ai [ no tokens ]
if ( $type eq 'image-generation' ) {
    return {
        service    => 'invoke-ai',
        reason     => 'task is image generation',
        token_cost => 0,
        priority   => 'direct'
    };
}

my $needs_consensus = grep { lc($_) =~ /consensus|verify/ } @$constraints;

## code generation
if ( $type eq 'code-generation' ) {

    if ($needs_consensus) {
        return {
            service        => 'consensus-voting',
            models         => \@multi_models,
            model_metadata => [
                map { <[coding.routing.get_model_metadata]>->($_) }
                    @multi_models
            ],
            reason     => 'code generation with consensus verification',
            token_cost => 500,
            priority   => 'consensus'
        };
    }

    return {
        service        => 'single-llm',
        model          => $primary,
        model_metadata => <[coding.routing.get_model_metadata]>->($primary),
        reason         => 'code generation [ primary model ]',
        token_cost     => 300,
        priority       => 'code-specialist'
    };
}

## reasoning / analysis
if ( $type eq 'reasoning' || $type eq 'analysis' ) {

    if ( $complexity >= 7 || $needs_consensus ) {
        return {
            service        => 'consensus-voting',
            models         => \@multi_models,
            model_metadata => [
                map { <[coding.routing.get_model_metadata]>->($_) }
                    @multi_models
            ],
            reason =>
                sprintf(
                'complex reasoning [ complexity: %d ] needs consensus',
                $complexity ),
            token_cost => 600,
            priority   => 'consensus'
        };
    }

    return {
        service        => 'single-llm',
        model          => $primary,
        model_metadata => <[coding.routing.get_model_metadata]>->($primary),
        reason     => sprintf( 'reasoning [ complexity: %d ]', $complexity ),
        token_cost => $complexity >= 4 ? 250         : 100,
        priority   => $complexity >= 4 ? 'reasoning' : 'simple'
    };
}

## brainstorming → diverse consensus
if ( $type eq 'brainstorming' ) {
    return {
        service        => 'consensus-voting',
        models         => \@multi_models,
        model_metadata => [
            map { <[coding.routing.get_model_metadata]>->($_) } @multi_models
        ],
        reason     => 'creative task benefits from multiple perspectives',
        token_cost => 400,
        priority   => 'diverse'
    };
}

## default fallback
return {
    service        => 'single-llm',
    model          => $primary,
    model_metadata => <[coding.routing.get_model_metadata]>->($primary),
    reason         => sprintf( 'default routing for type: %s', $type ),
    token_cost     => 200,
    priority       => 'default'
};

