## [:< ##

# name  = radio.post_init
# descr = notify httpd that radio stream endpoint is available

<[protocol-7.route-send]>->(
    {   'command'   => 'httpd.radio_online',
        'call_args' => { 'args' => <radio.stream.path> // '/radio/stream' },
    }
);

<[base.logs]>->( 2, '[radio] notified httpd: radio_online' );

