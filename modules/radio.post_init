## [:< ##

# name  = radio.post_init
# descr = notify httpd that radio stream endpoint is available

## deferred via <system.init_reports> -- post_init runs before this
## zenka's own cube connection exists, so a direct route-send here
## reliably hits send.local's "no clients in session" drop ##
<system.init_reports> //= [];
push(
    <system.init_reports>->@*,
    {   'target_command' => qw| httpd.radio_online |,
        'param'          => <radio.stream.path> // '/radio/stream',
        'descr'          => 'notifying httpd: radio_online',
    }
);

0;

