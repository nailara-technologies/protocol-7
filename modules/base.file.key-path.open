## [:< ##

# name  = base.file.key-path.open
# param = $keyword_path[, $encoding][, $mode][, $create][, $perm]
# descr = Open a file using keyword paths [protocol-7] or [workspace-transfer]
#         Resolves keyword path to actual file path, then delegates to base.file.open
# return = filehandle or undef on error

my $keyword_path = shift;

return unless defined $keyword_path;

## Resolve keywords to actual path ##
my $resolved_path = <[base.path.resolve_keywords]>->($keyword_path);

## Delegate to standard file.open with resolved path and all remaining args ##
return <[file.open]>->( $resolved_path, @_ );

