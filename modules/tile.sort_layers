## [:< ##

# name = tile.sort_layers

my $reply_id = shift;

<[base.log]>->( 2, "requesting window stacking order.." );
<[protocol-7.command.send.local]>->(
    {   'command' => "cube.X-11.get-stack-order",
        'reply'   => {
            'params'  => $reply_id,
            'handler' => 'tile.handler.stack_order_reply'
        }
    }
);

