## [:< ##

# name  = cred-mesh.util.complete_approval
# descr = complete auth approval by storing session credential

my ( $rid, $dom, $value ) = @ARG;

my $slot = 'session.' . $dom;

## auto-register slot if not present ##
if ( not exists <cred-mesh.registry>->{$slot} ) {
    <[cred-mesh.register]>->(
        {   'slot'        => $slot,
            'owner'       => qw| cred-mesh |,
            'type'        => qw| session-cookie |,
            'storage'     => qw| local |,
            'sensitivity' => qw| low |,
        }
    );
}

my $write_ok = <[cred-mesh.store.local]>->( qw| write |, $slot, $value );

if ($write_ok) {
    <[base.logs]>->(
        1, 'cred-mesh: stored auth relay session for domain %s', $dom
    );
}

delete <cred-mesh.auth_relay_pending>->{$rid};

## clear pending file entry if present ##
my $remaining = <cred-mesh.auth_relay_pending> // {};
my $yaml_str  = eval { YAML::XS::Dump(%$remaining); };
if ( defined $yaml_str ) {
    <[file.zenka_dir.write]>->( 'relay_pending.yaml', \$yaml_str, '>', 0600 );
}

return {
    'mode' => $write_ok ? qw| true |       : qw| false |,
    'data' => $write_ok ? 'session stored' : 'storage failed',
    'slot' => $slot,
};

