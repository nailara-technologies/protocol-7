## [:< ##

# name  = route.bmw384.cmd.index-stats
# descr = formatted table of bmw384 field index statistics

my $stats = <[route.bmw384.index.stats}>;

if ( not defined $stats ) {
    return {
        qw| mode | => qw| size |,
        qw| data | => 'bmw384 index not initialized'
    };
}

my @lines;
for my $ARG ( 0 .. 25 ) {
    my $label = chr( ord('A') + $ARG );
    push @lines, sprintf 'arc %s: %d nodes', $label, $stats->{'by_arc'}{$ARG};
}

push @lines, sprintf 'total: %d nodes', $stats->{'total'};

return { qw| mode | => qw| size |, qw| data | => join( "\n", @lines ) };

