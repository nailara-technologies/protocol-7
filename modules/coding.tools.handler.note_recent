## [:< ##

# name  = coding.tools.handler.note_recent
# descr = list recent notes across all tasks

my $args = shift // {};

my $count   = $args->{'count'}   // 10;
my $section = $args->{'section'} // '';

## call backend ##
my $result = <[note.recent]>->( $count, length $section ? $section : undef );

return {
    'content' => $result->{'mode'} ne qw| false |
    ? $result->{'data'}
    : "Failed: " . ( $result->{'data'} // 'unknown' ),
};

