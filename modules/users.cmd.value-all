## [:< ##

# name  = users.cmd.value-all
# descr = list usernames currently present under [USERS_HOST]

my $users_path = <[base.path.resolve_keywords]>->(qw| [USERS_HOST] |);

## reply contract requires a string 'data' payload, never a raw arrayref ##
return { 'mode' => qw| size |, 'data' => '' } if not -d $users_path;

## a record is a DIRECTORY, not a file [ users.record.path ] : the name to
## list is the directory's, and its details.yaml is only one document inside
## it.  a directory WITHOUT that document is a record mid-creation or one
## whose baseline was removed -- not listed, since nothing can be read from it
my @dirs = <[file.match_dirs]>->( $users_path, qw| * | );

my @usernames;
foreach my $dir_path (@dirs) {
    next if $dir_path !~ m|/([^/]+)/?$|;
    my $username = $1;
    next
        if not -f <[base.path.resolve_keywords]>
        ->( <[users.record.path]>->($username) );
    push @usernames, $username;
}

return {
    'mode' => qw| size |,
    'data' => join( "\n", sort @usernames )
};

