## [:< ##

# name  = users.cmd.value-all
# descr = list usernames currently present under [USERS_HOST]

my $users_path = <[base.path.resolve_keywords]>->(qw| [USERS_HOST] |);

## reply contract requires a string 'data' payload, never a raw arrayref ##
return { 'mode' => qw| size |, 'data' => '' } if not -d $users_path;

my @files = <[file.match_files]>->( $users_path, qw| *.yaml | );

my @usernames;
foreach my $file_path (@files) {
    next if $file_path !~ m|/([^/]+)\.yaml$|;
    push @usernames, $1;
}

return {
    'mode' => qw| size |,
    'data' => join( "\n", sort @usernames )
};

