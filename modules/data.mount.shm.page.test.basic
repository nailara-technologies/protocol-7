## [:< ##

# name = data.mount.shm.page.test.basic
# descr = Basic test for paged SHM segments

<[base.log]>->( 2, "=== SHM Page Test ===" );

##[ TEST 1: Create Paged Segment ]##########################################

my $test_pubkey = 'PAGETEST' . ( 'Y' x 24 );
my $content     = ( "PAGE-TEST-DATA-" x 200 );   # not a multiple of page_size
my $page_size   = 512;
my $checksum    = 'TESTCHKSUML13';

<[base.log]>->(
    2, "Creating paged segment for " . length($content) . " bytes"
);

my $mount = <[data.mount.shm.page.create]>->(
    $test_pubkey, length($content), $page_size, $checksum,
    { 'mlock' => 0, 'sub_path' => 'pagetest_basic' }
);

if ( !defined $mount ) {
    <[base.log]>->( 0, "TEST FAIL: Could not create paged segment" );
    return 0;
}

<[base.log]>->( 2, "TEST PASS: Created paged segment at $mount->{'path'}" );

##[ TEST 2: Read Index ]#####################################################

my $index = <[data.mount.shm.page.index.read]>->($mount);

if ( !defined $index or $index->{'page_size'} != $page_size ) {
    <[base.log]>->( 0, "TEST FAIL: Page index missing or wrong page_size" );
    <[data.mount.shm.unlink]>->( $test_pubkey, 'pagetest_basic' );
    return 0;
}

<[base.log]>->(
    2, "TEST PASS: Index verified, total_pages=$index->{'total_pages'}"
);

##[ TEST 3: Write All Pages ]################################################

my $pos      = 0;
my $page_num = 0;
while ( $pos < length($content) ) {
    my $chunk = substr( $content, $pos, $page_size );
    my $w     = <[data.mount.shm.page.write]>->( $mount, $page_num, $chunk );
    if ( !defined $w or $w->{'error'} ) {
        <[base.log]>->(
            0,
            "TEST FAIL: write_page $page_num : "
                . ( $w->{'error'} // 'undef' )
        );
        <[data.mount.shm.unlink]>->( $test_pubkey, 'pagetest_basic' );
        return 0;
    }
    $pos += $page_size;
    $page_num++;
}

<[base.log]>->( 2, "TEST PASS: wrote $page_num pages" );

##[ TEST 4: Read + Reassemble ]##############################################

my $reassembled = '';
for my $n ( 0 .. $index->{'total_pages'} - 1 ) {
    $reassembled .= <[data.mount.shm.page.read]>->( $mount, $n );
}

if ( $reassembled ne $content ) {
    <[base.log]>->( 0, "TEST FAIL: reassembled content mismatch" );
    <[data.mount.shm.unlink]>->( $test_pubkey, 'pagetest_basic' );
    return 0;
}

<[base.log]>->( 2, "TEST PASS: reassembled byte-identically" );

##[ TEST 5: Out-of-Range Rejection ]#########################################

my $oor_read
    = <[data.mount.shm.page.read]>->( $mount, $index->{'total_pages'} );
my $oor_write
    = <[data.mount.shm.page.write]>->( $mount, $index->{'total_pages'}, 'x' );

if ( defined $oor_read or not $oor_write->{'error'} ) {
    <[base.log]>->( 0, "TEST FAIL: out-of-range page was not rejected" );
    <[data.mount.shm.unlink]>->( $test_pubkey, 'pagetest_basic' );
    return 0;
}

<[base.log]>->( 2, "TEST PASS: out-of-range page rejected on read + write" );

##[ CLEANUP ]################################################################

<[data.mount.shm.unlink]>->( $test_pubkey, 'pagetest_basic' );

<[base.log]>->( 2, "=== All SHM Page Tests Passed ===" );

return TRUE;    ## [success] ##

