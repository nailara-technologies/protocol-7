## [:< ##

# name = data.mount.shm.create
# descr = Create SHM segment with cryptographic identity header
#         Uses file-based SHM in /dev/shm (tmpfs) - portable across systems

# thin zenka wrapper -> AMOS7::SHM::shm_create
# [ same relationship base.chk-sum.amos has to AMOS7::CHKSUM::amos_chksum ]
# mechanics live in the standalone-loadable core ; the zenka path adds the
# two context-specific concerns the core deliberately stays out of :
#   - the 'created' time source [ <[base.time]>->(2) ]
#   - mlock + the in-memory segment registry [ lifecycle, zenka-owned ]

my $pub_key_b32 = shift;
my $size        = shift;
my $options     = shift // {};

# inject the zenka time source ; core defaults to time() standalone
$options->{'time_source'} //= sub { <[base.time]>->(2) };

my $mount = AMOS7::SHM::shm_create( $pub_key_b32, $size, $options );

return undef unless defined $mount;

# mlock if requested [ zenka-side lifecycle, not core mechanics ]
if ( $mount->{'header'}{'flags'}{'mlocked'} ) {
    <[data.mount.shm.lock.memory]>->(
        $mount->{'mmap_ptr'}, 0, $mount->{'total_size'}
    );
}

return $mount;

