## [:< ##

# name = data.mount.shm.create
# descr = Create SHM segment with cryptographic identity header
#         Uses file-based SHM in /dev/shm (tmpfs) - portable across systems

use constant SHM_HEADER_SIZE      => 512;
use constant DEFAULT_SEGMENT_SIZE => 63 * 1024;

my $pub_key_b32 = shift;
my $size        = shift // DEFAULT_SEGMENT_SIZE;
my $options     = shift // {};

return undef unless defined $pub_key_b32 && length($pub_key_b32) >= 32;

my $shm_path = sprintf( "/dev/shm/p7:M:%s", $pub_key_b32 );

if ( $options->{'sub_path'} ) {
    $shm_path .= ":" . $options->{'sub_path'};
    $shm_path =~ s{[^a-zA-Z0-9_:/\-]}{_}g;
}

my $total_size = $size + SHM_HEADER_SIZE;

# Use file-based SHM in /dev/shm (tmpfs)
# This is more portable than POSIX::shm_open
open( my $fh, '+>', $shm_path ) or return undef;
binmode($fh);

truncate( $fh, $total_size );

my $header = {
    'magic'        => 'P7SH',
    'version'      => 1,
    'owner_pubkey' => $pub_key_b32,
    'created'      => <[base.time]>->(2),
    'data_size'    => $size,
    'header_size'  => SHM_HEADER_SIZE,
    'flags'        => {
        'mlocked'    => $options->{'mlock'}      // 1,
        'encrypted'  => $options->{'encrypted'}  // 0,
        'compressed' => $options->{'compressed'} // 0,
    },
    'permissions' => [],
};

my $header_packed = <[data.mount.shm.create.pack_shm_header]>->($header);
syswrite( $fh, $header_packed );

# Flush to ensure data is on disk before mmap
$fh->flush();

# mmap the file for zero-copy access
my $mmap_ptr = <[data.mount.shm.create.mmap_file]>->( $fh, $total_size );

# If mmap fails, use scalar reference (data copied to memory)
if ( !defined $mmap_ptr ) {
    seek( $fh, 0, 0 );
    my $data;
    {
        local $/;
        $data = <$fh>;
    }
    $mmap_ptr = \$data;
}

close($fh);

# mlock if requested
if ( $header->{'flags'}{'mlocked'} ) {
    <[data.mount.shm.lock.memory]>->( $mmap_ptr, 0, $total_size );
}

return {
    'path'       => $shm_path,
    'pub_key'    => $pub_key_b32,
    'size'       => $size,
    'total_size' => $total_size,
    'mmap_ptr'   => $mmap_ptr,
    'header'     => $header,
    'type'       => 'file',
};

