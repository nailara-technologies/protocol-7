## [:< ##

# name = io.ssl.ip.input.connect
# descr = handle incoming SSL/TLS connections with non-blocking handshake
#        [ prevents event loop stall from slow/bot clients that open TCP
#          but never complete SSL handshake ]

my $fd = $_[0]->w->fd;     ## <-- $data{'session'}{$id}{'handle'} ##
my $id = $_[0]->w->data;

if ( not exists $data{'session'}->{$id} ) {
    $_[0]->w->cancel if $_[0]->w->is_active;    ## cancel watcher ##
    return undef;
}

my $client_sock_fd;

## accept connections from IO::Socket::SSL listening socket
if ( ref($fd) eq qw| IO::Socket::SSL | and -S $fd ) {
    ## set server socket to non-blocking ##
    $fd->blocking(0);

    ## accept tcp connection without ssl handshake ##
    ##               [ blocking would stall here ] ##
    ## IO::Socket::IP::accept bypasses SSL's accept override ##
    ## but preserves IP socket layer [ buffering, sockopt ]  ##
    my $tcp_client = $fd->IO::Socket::IP::accept();

    if ( not $tcp_client ) {
        ## no pending connection [ level-triggered re-fire ] ##
        return undef if $!{EAGAIN} or $!{EWOULDBLOCK};

        my $err_msg = <[base.format_error]>->($OS_ERROR);
        <[base.log]>->(
            0, "[$id] : IP-TCP-SSL-accept : tcp accept failed: $err_msg"
        );
        return undef;
    }

    ## get peer info before any potential failures ##
    my ( $p_host, $p_port )
        = ( $tcp_client->peerhost(), $tcp_client->peerport() );

    return undef    ##  <-- closed .., ##
        if not defined $p_host
        or not defined $p_port;

    ## log connection start for crash capture ##
    <[base.logs]>->(
        1,   '[%s] IN.-SSL [%s:%s] encrypted=tls (handshake-pending)',
        $id, $p_host, $p_port
    );

    ## crash capture hook [ httpsd only — no-op in other ssl zenki ] ##
    $code{'httpsd.request_capture.write'}
        ->( { 'event' => 'ssl-handshake-start', 'client_ip' => $p_host } )
        if exists $code{'httpsd.request_capture.write'};

    ## set client socket to non-blocking before ssl upgrade ##
    $tcp_client->blocking(0);
    binmode( $tcp_client, ':raw' );

    ## upgrade tcp socket to ssl with deferred handshake ##
    ## SSL_reuse_ctx accepts IO::Socket::SSL instance directly ##
    ## [ inherits cert, key, ciphers from server socket ]      ##
    my $ssl_client = eval {
        IO::Socket::SSL->start_SSL(
            $tcp_client,
            SSL_server         => 1,
            SSL_startHandshake => 0,      ## <-- defer handshake ##
            SSL_reuse_ctx      => $fd,    ## reuse server socket context ##
        );
    };

    if ($EVAL_ERROR) {
        <[base.logs]>
            ->( 1, '[%s] SSL start_SSL error: %s', $id, $EVAL_ERROR );
        close($tcp_client);
        return undef;
    }

    if ( not defined $ssl_client ) {
        my $ssl_err = IO::Socket::SSL::errstr() || 'unknown error';
        <[base.logs]>->( 1, '[%s] SSL start_SSL failed: %s', $id, $ssl_err );
        close($tcp_client);
        return undef;
    }

    ## create unique handshake id ##
    my $hs_id = 'ssl_hs_' . $id . '_' . fileno($ssl_client) . '_' . time;

    ## get handshake timeout from config ##
    my $hs_timeout = <httpsd.cfg.ssl_handshake_timeout> // 10;

    ## register pending handshake ##
    $data{'ssl_handshake'}{$hs_id} = {
        'socket'     => $ssl_client,
        'fd'         => fileno($ssl_client),
        'peerhost'   => $p_host,
        'peerport'   => $p_port,
        'server_id'  => $id,
        'start_time' => time,
        'io_watcher' => undef,                 ## will be set below
        'timer'      => undef,                 ## will be set below
    };

    ## register io watcher for non-blocking ssl handshake ##
    my $io_watcher = <[event.add_io]>->(
        {   'fd'     => $ssl_client,
            'poll'   => 'rw',       ## ssl handshake may need read or write ##
            'repeat' => 1,
            'data'   => $hs_id,
            'handler' => 'io.ssl.ip.handler.handshake'
        }
    );

    if ( not defined $io_watcher ) {
        <[base.logs]>->(
            0, '[%s] failed to add SSL handshake IO watcher', $id
        );
        delete $data{'ssl_handshake'}{$hs_id};
        close($ssl_client);
        return undef;
    }

    $data{'ssl_handshake'}{$hs_id}{'io_watcher'} = $io_watcher;

    ## register timeout timer ##
    my $timer = <[event.add_timer]>->(
        {   'after'   => $hs_timeout,
            'data'    => $hs_id,
            'handler' => 'io.ssl.ip.handler.handshake_timeout'
        }
    );

    if ( not defined $timer ) {
        <[base.logs]>->(
            0, '[%s] failed to add SSL handshake timeout timer', $id
        );
        $io_watcher->cancel if $io_watcher->can('cancel');
        delete $data{'ssl_handshake'}{$hs_id};
        close($ssl_client);
        return undef;
    }

    $data{'ssl_handshake'}{$hs_id}{'timer'} = $timer;

    ## return undef — handshake completion handled by event callbacks ##
    ## the actual client socket will be registered after handshake completes ##
    return undef;

} else {
    <[base.logs]>->(
        0,   '[%d] server socket is not valid (expected IO::Socket::SSL) %s',
        $id, <[base.caller]>
    );
    return undef;    ## <-- connection closed \ error connecting ##
}

