## [:< ##

# name  = models.backend.kimi_web
# descr = route chat to kimi zenka with dynamic system message
# param = $params [messages, reply_id, sender, model, template]

my $params = shift // {};

my $messages        = $params->{'messages'}       // [];
my $reply_id        = $params->{'reply_id'}       // '';
my $sender          = $params->{'sender'}         // '';
my $model           = $params->{'model'}          // 'kimi';
my $participant     = $params->{'participant_id'} // $model;
my $system_template = $params->{'system_template'}
    // 'configuration/models/system-messages/coding-assistant.tmpl';

## render dynamic system message from template ##
my $system_message  = '';
my $template_result = <[web.cmd.render-template]>->(
    {   template_path => $system_template,
        meta          => { model => $model, sender => $sender },
        budget     => 2000,                 ## ~2000 tokens for system message
        session_id => "kimi_web_$reply_id",
    }
);

if ( $template_result->{status} eq qw| success | ) {
    $system_message = $template_result->{content};
    <[base.log]>->(
        2,
        "[kimi_web] system message rendered "
            . "($template_result->{elapsed_ms}ms, "
            . length($system_message)
            . " chars)"
    );
} else {
    <[base.log]>->(
        1, "[kimi_web] render failed: " . $template_result->{message}
    );
    ## fall back to minimal system message ##
    $system_message = 'you are a protocol-7 assistant.';
}

## prepend system message to messages array ##
my @enhanced_messages
    = ( { role => 'system', content => $system_message }, @$messages );

## convert messages array to plain prompt string
my $prompt = <[models.chat.messages_to_prompt]>->( \@enhanced_messages );

unless ( length($prompt) ) {
    my $error = ':. error: empty prompt :.';
    <[models.chat.append]>->( undef, $model, $error );
    my $entries = <[models.chat.get_recent]>->(3);
    my $output  = <[models.chat.format_buffer]>->($entries);
    if ( length($reply_id) ) {
        <[base.callback.cmd_reply]>->(
            $reply_id, { 'mode' => 'size', 'data' => $output }
        );
    }
    return;
}

## base32r encode for safe single-line ipc transmission
my $encoded = eval { Crypt::Misc::encode_b32r($prompt) };
if ( $@ or not length($encoded) ) {
    <[base.logs]>->( 0, '[kimi_web] base32r encode failed : %s', $@ // '' );
    $encoded = $prompt;    ## fall back to raw (may fail on multiline)
}

## route to kimi zenka via cube
my $sent = <[protocol-7.command.send.local]>->(
    {   'command'   => qw| cube.kimi.ask-reply |,
        'call_args' => { 'args' => $encoded },
        'reply'     => {
            'handler' => qw| models.handler.kimi_web_result |,
            'params'  => {
                'original_reply_id' => $reply_id,
                'sender'            => $sender,
                'model'             => $model,
                'participant_id'    => $participant,
            }
        }
    }
);

if ( $sent <= 0 ) {
    <[base.logs]>->( 0, '[kimi_web] kimi zenka not reachable' );
    my $error = ':. error: kimi not reachable :.';
    <[models.chat.append]>->( undef, $model, $error );
    my $entries = <[models.chat.get_recent]>->(3);
    my $output  = <[models.chat.format_buffer]>->($entries);
    if ( length($reply_id) ) {
        <[base.callback.cmd_reply]>->(
            $reply_id, { 'mode' => 'size', 'data' => $output }
        );
    }
}

