## [:< ##

# name  = index.cmd.correlate
# descr = shared continuations between two prefix subtrees

my ( $prefix1, $prefix2 ) = split( m|\s+|, $call->{'args'}, 2 );

return { 'mode' => 'false', 'data' => 'expected two prefixes' }
    unless defined $prefix1
    and defined $prefix2
    and length $prefix1
    and length $prefix2;

## fetch children via trie search ##
my $c1 = <[index.search]>->($prefix1);
my $c2 = <[index.search]>->($prefix2);

## map extension character => [rank, freq] for each prefix ##
my %ext1;
for my $ref (@$c1) {
    my ( $seq, $rank, $freq ) = @$ref;
    $ext1{ substr( $seq, -1, 1 ) } = [ $rank, $freq ];
}

my %ext2;
for my $ref (@$c2) {
    my ( $seq, $rank, $freq ) = @$ref;
    $ext2{ substr( $seq, -1, 1 ) } = [ $rank, $freq ];
}

## intersect and report ##
my @out;
for my $ch ( sort keys %ext1 ) {
    next unless exists $ext2{$ch};
    my ( $r1, $f1 ) = @{ $ext1{$ch} };
    my ( $r2, $f2 ) = @{ $ext2{$ch} };
    push @out,
        sprintf( "'%s'  %s: rank=%d freq=%d  %s: rank=%d freq=%d",
        $ch, $prefix1, $r1, $f1, $prefix2, $r2, $f2 );
}

return {
    'mode' => 'size',
    'data' => @out
    ? join( "\n", @out )
    : 'no shared continuations'
};

