## [:< ##

# name  = amos-term.fuse.init_code
# descr = Initialize FUSE filesystem for 3D terminal buffers
#
# Mount structure:
#   /data/terminals/<amos_id>/
#     ├── current      -> z-0 (symlink to current Z layer)
#     ├── z-0 .. z-12  # Individual Z-layers (binary)
#     ├── metadata     # JSON buffer info
#     ├── cursor       # Text cursor position (x,y,z)
#     └── attachments  # List of attached clients

<[base.log]>->( 2, ":: initializing amos-term FUSE subsystem" );

## === ensure FUSE is available === ##
<[data.fuse.load_module]>->() if defined <data.fuse.load_module>;

## === mount registry === ##
<amos-term.fuse.mounts>     //= {};    # { $mount_point => { amos_id, pid } }
<amos-term.fuse.mount_base> //= qw| /data/terminals |;

## === file type helpers === ##
<amos-term.fuse.file_types> = {
    qw| layer |    => { qw| ext |  => '.bin',  qw| mode | => 0644 },
    qw| metadata | => { qw| ext |  => '.json', qw| mode | => 0644 },
    qw| cursor |   => { qw| ext |  => '.txt',  qw| mode | => 0644 },
    qw| symlink |  => { qw| mode | => 0777 },
};

## === layer size: 8*7*2 = 112 bytes === ##
<amos-term.fuse.layer_size> //= 112;

<[base.log]>->( 2, ":: amos-term FUSE initialized" );

0;

