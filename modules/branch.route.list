## [:< ##

# name  = branch.route.list
# descr = list active routes filtered by observer or target
# param = { observer } or { target } or {} for all

my $params   = shift                 // {};
my $observer = $params->{'observer'} // '';
my $target   = $params->{'target'}   // '';

my @route_ids;

if ( length $observer ) {
    @route_ids
        = keys %{ $data{'branch.routes.by_observer'}{$observer} // {} };
} elsif ( length $target ) {
    @route_ids = keys %{ $data{'branch.routes.by_target'}{$target} // {} };
} else {
    @route_ids = keys %{ $data{'branch.routes'} // {} };
}

my $now = <[base.time]>->(4);

my @results;

for my $id (@route_ids) {
    my $route = $data{'branch.routes'}{$id};
    next unless defined $route;
    next if $route->{'state'} eq 'released';

    push @results,
        {
        'id'          => $id,
        'observer'    => $route->{'observer'},
        'target'      => $route->{'target'},
        'hop_count'   => scalar @{ $route->{'hops'} // [] },
        'state'       => $route->{'state'},
        'age_seconds' => $now - $route->{'created'},
        };
}

return { 'mode' => 'true', 'data' => \@results };

