## [:< ##

# name  = site-yaml.jobs.save
# descr = persist job store to disk

eval { YAML::XS::DumpFile( $data{'jobs.store_file'}, $data{'jobs.store'} ); };
if ($@) {
    <[base.logs]>->( 0, 'jobs.save: error: %s', $@ );
    return FALSE;
}
return TRUE;

