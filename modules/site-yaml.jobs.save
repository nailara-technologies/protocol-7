## [:< ##

# name  = site-yaml.jobs.save
# descr = persist job store to disk

my $yaml;
eval { $yaml = YAML::XS::Dump( $data{'jobs'}{'store'} ) };
if ($@) {
    <[base.logs]>->( 0, 'jobs.save: serialize error: %s', $@ );
    return FALSE;
}

my $written = <[file.zenka_dir.write]>->( 'store.yaml', \$yaml );
if ( not defined $written ) {
    <[base.logs]>->( 0, 'jobs.save: write failed' );
    return FALSE;
}
return TRUE;

