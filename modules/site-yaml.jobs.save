## [:< ##

# name  = site-yaml.jobs.save
# descr = persist job store to disk as per-job files

my $store = $data{'jobs'}{'store'} // {};
my $count = 0;

for my $job_id ( keys %{$store} ) {
    my $job = $store->{$job_id};
    next if ref $job ne 'HASH';
    <[jobsite.job.write]>->( $job_id, $job );
    $count++;
}

<[base.logs]>->( 2, 'jobs.save: wrote %d per-job files', $count ) if $count;

return TRUE;

