## [:< ##

# name  = models.handler.task-result
# descr = receive backend response and complete or fail the task

my $reply = shift;

my $cmd    = $reply->{'cmd'}       // '';
my $args   = $reply->{'call_args'} // {};
my $rdata  = $reply->{'data'}      // '';
my $params = $reply->{'params'}    // {};

my $task_id = $params->{'task_id'} // '';
my $model   = $params->{'model'}   // '';
my $job_id  = $params->{'job_id'}  // <models.task.active_job>;

<[base.logs]>->(
    2, ': task result: %s cmd=%s model=%s job=%s',
    $task_id, $cmd, $model, $job_id // 'n/a'
);

## extract response based on reply type
my $response    = '';
my $job_outcome = qw| completed |;

if ( $cmd eq 'TRUE' ) {
    $response = $args->{'args'} // '';
} elsif ( $cmd eq 'SIZE' ) {
    $response = $rdata;
} elsif ( $cmd eq 'FALSE' ) {
    my $error = $args->{'args'} // 'unknown error';
    ( my $safe_error = $error ) =~ s{\n}{ }g;
    <[base.logs]>
        ->( 0, ': task %s backend error: %s', $task_id, $safe_error );

    ## fail the task
    if ( length $task_id ) {
        <[protocol-7.route-send]>->(
            {   'command'   => 'task.fail',
                'call_args' => { 'args' => "$task_id $safe_error" }
            }
        );
    }
    $job_outcome = qw| error |;
}

## route through iteration loop if task has iteration enabled ##
if ( $job_outcome ne qw| error | ) {
    my $task_ref = <task.queue>->{$task_id};
    if ( defined $task_ref and $task_ref->{'iteration'} ) {
        my $iter_result = <[iteration.loop]>->(
            {   'task_id'      => $task_id,
                'result'       => $response,
                'criteria'     => $task_ref->{'acceptance_criteria'} // [],
                'node_id'      => $task_ref->{'node_id'}             // '',
                'max_attempts' => $task_ref->{'max_attempts'}        // 5,
            }
        );

        if ( defined $iter_result and ref $iter_result eq qw| HASH | ) {
            my $mode = $iter_result->{'mode'} // '';

            if ( $mode eq qw| retry | ) {
                ## append issues and re-enqueue ##
                my $issues  = $iter_result->{'data'}{'issues'} // '';
                my $updated = ( $task_ref->{'prompt'} // '' )
                    . (
                    length $issues
                    ? "\n\n[iteration issues to fix: $issues]"
                    : ''
                    );
                <[models.task.enqueue]>->(
                    {   'task_id'    => $task_id,
                        'model'      => $model,
                        'prompt'     => $updated,
                        'target_cmd' => $task_ref->{'target_cmd'} // $model,
                    }
                );
                <models.task.active_id>  = undef;
                <models.task.active_job> = undef;
                <[base.logs]>->(
                    1, ': task %s: re-enqueued for iteration retry', $task_id
                );
                return;

            } elsif ( $mode eq qw| escalate | ) {
                my $reason = $iter_result->{'data'} // 'escalation';
                <[protocol-7.route-send]>->(
                    {   'command'   => 'task.fail',
                        'call_args' => {
                            'args' => "$task_id iteration escalated: $reason"
                        }
                    }
                );
                <models.task.active_id>  = undef;
                <models.task.active_job> = undef;
                <[jobqueue.move_job]>->( $job_id, qw| error | )
                    if defined $job_id;
                return;

            } elsif ( $mode eq qw| true | ) {
                ## iteration complete : fall through to normal completion ##
                <[base.logs]>->(
                    1, ': task %s: iteration complete', $task_id
                );
            }
        }
    }
}

## complete the task with response [ when not already failed above ]
if ( $job_outcome ne qw| error | ) {
    if ( length $task_id and length $response ) {
        ## b32-encode result to preserve newlines in line-based protocol ##
        ## only encode to bytes if flag is set — raw bytes are already utf-8 ##
        my $utf8_bytes
            = utf8::is_utf8($response)
            ? Encode::encode( 'UTF-8', $response )
            : $response;
        my $encoded_response = ':B32:' . <[base32.encode]>->( \$utf8_bytes );
        <[protocol-7.route-send]>->(
            {   'command'   => 'task.complete',
                'call_args' => { 'args' => "$task_id $encoded_response" }
            }
        );
        <[base.logs]>->( 1, ': task %s completed via %s', $task_id, $model );
    } elsif ( length $task_id ) {
        <[protocol-7.route-send]>->(
            {   'command'   => 'task.fail',
                'call_args' => { 'args' => "$task_id empty response" }
            }
        );
        <[base.logs]>->(
            0,        ': task %s: empty response from %s',
            $task_id, $model
        );
        $job_outcome = qw| error |;
    }
}

## clear active dispatch guard and move job in jobqueue ##
<models.task.active_id> = undef;

if ( defined $job_id ) {
    <[jobqueue.move_job]>->( $job_id, $job_outcome );
    delete <models.task.jobs>->{$job_id};
}
<models.task.active_job> = undef;

## check for next pending task in queue ##
<[protocol-7.route-send]>->(
    {   'command'   => 'task.queue',
        'call_args' => { 'args' => 'status=pending' },
        'reply'     => {
            'handler' => 'models.handler.task-poll-step',
            'params'  => { 'step' => 'check-next' }
        }
    }
);

return;

