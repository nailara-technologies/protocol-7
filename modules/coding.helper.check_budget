## [:< ##

# name = coding.helper.check_budget
# descr = check if budget available for operation

my ($estimated_tokens) = @ARG;

my $remaining = <coding.budget.allocated> - <coding.budget.used>;
my $percentage_used
    = ( <coding.budget.used> / <coding.budget.allocated> ) * 100;

return {
    success         => $remaining >= $estimated_tokens,
    available       => $remaining,
    estimated_cost  => $estimated_tokens,
    can_proceed     => $remaining >= $estimated_tokens,
    percentage_used => sprintf( "%.1f", $percentage_used ),
    status          => <[coding.helper.budget_status]>->($percentage_used)
};

