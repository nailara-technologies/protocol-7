## [:< ##

# name  = index.cmd.feed-dir
# descr = feed a directory into the index

my $dir = $call->{'args'} // '';

return { 'mode' => 'false', 'data' => 'expected directory path' }
    unless length $dir;

## prefix system root path for relative paths ##
$dir = <system.root_path> . '/' . $dir if $dir !~ m|^/|;

return { 'mode' => 'false', 'data' => 'not a directory' }
    unless -d $dir;

my @files = grep { -s $ARG < 10_000_000 } <[file.match_files]>->(
    $dir,
    qw| recursive |,
    qw| *.md *.yaml *.yml *.txt *.pm *.pl |
);

return { 'mode' => 'false', 'data' => 'no files found' }
    unless @files;

my $job_id = <[chk-sum.amos]>->( \$dir );

<index.jobs>->{$job_id} = {
    'job-type'   => 'feed-dir',
    'reply_id'   => $call->{'reply_id'},
    'files'      => \@files,
    'total'      => scalar @files,
    'done'       => 0,
    'idle-event' => <[event.add_idle]>->(
        {   'handler' => 'index.callback.feed-dir',
            'data'    => $job_id,
            'repeat'  => 1,
            'desc'    => "index feed-dir [ $job_id ]",
        }
    ),
};

<[base.log]>->( 1, "index feed-dir queued [ " . scalar(@files) . " files ]" );

return { 'mode' => 'deferred' };

