## [:< ##

# name  = index.cmd.feed-dir
# descr = feed a directory into the index

my $dir = $call->{'args'} // '';

return { 'mode' => 'false', 'data' => 'expected directory path' }
    unless length $dir;

return { 'mode' => 'false', 'data' => 'not a directory' }
    unless -d $dir;

my $count = <[index.feed.dir]>->($dir);

return { 'mode' => 'size', 'data' => "fed $count files from $dir" };

