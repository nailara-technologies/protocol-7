## [:< ##
# name  = plugin.storage.checksum.verify
# descr = Verify file integrity against cached checksum

use strict;
use warnings;

return sub {
    my ($args) = @ARG;

    my $path = $args->{path}
        or return { 'mode' => 'false', 'data' => 'path required' };

    my $registry = $data{'storage'}{'mapping'}{'checksum'};
    my $cached   = $registry->{'cache'}{$path};

    return { 'mode' => 'false', 'data' => 'no cached checksum' }
        unless $cached;
    return { 'mode' => 'false', 'data' => 'file not found' } unless -f $path;

    # Re-compute checksum based on algorithm
    my $current_checksum;
    my $algorithm = $cached->{algorithm};

    if ( $algorithm eq 'bmw' ) {
        $current_checksum = <[base.chk-sum.bmw.filesum]>->($path);
    } elsif ( $algorithm eq 'bmw-224' ) {
        $current_checksum = <[base.chk-sum.bmw.224.B32]>->($path);
    } elsif ( $algorithm eq 'bmw-512' ) {
        $current_checksum = <[base.chk-sum.bmw.512_32]>->($path);
    } elsif ( $algorithm eq 'bmw-L13' or $algorithm eq 'bmw-L13-b32' ) {
        open my $fh, '<:raw', $path
            or return { 'mode' => 'false', 'data' => 'cannot read file' };
        my $content = do { local $/; <$fh> };
        close $fh;

        if ( $algorithm eq 'bmw-L13' ) {
            $current_checksum = <[base.chk-sum.bmw.L13-str]>->($content);
        } else {
            $current_checksum = <[base.chk-sum.bmw.str-b32.L13]>->($content);
        }
    } elsif ( $algorithm eq 'amos' ) {
        $current_checksum = <[base.chk-sum.amos]>->($path);
    }

    return { 'mode' => 'false', 'data' => 'checksum computation failed' }
        unless defined $current_checksum;

    my $valid = $current_checksum eq $cached->{checksum};

    return {
        'mode' => 'true',
        'data' => {
            'path'      => $path,
            'valid'     => $valid,
            'cached'    => $cached->{checksum},
            'current'   => $current_checksum,
            'algorithm' => $algorithm,
        }
    };
};

