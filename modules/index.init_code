## [:< ##

# name = index.init_code
# descr = initialize index zenka data structures

<[base.perlmod.autoload]>->('Digest::BMW');
<[base.perlmod.autoload]>->('Linux::Inotify2');
<[base.perlmod.autoload]>->('Crypt::PRNG::Fortuna');
<[base.perlmod.autoload]>->( 'File::Path',       qw| make_path | );
<[base.perlmod.autoload]>->( 'IO::Compress::Xz', qw| xz | );
<[base.perlmod.autoload]>->( 'Storable',         qw| nfreeze thaw | );

<[base.perlmod.autoload]>->( 'AMOS7::Assert::Truth', qw| is_true | );

<[base.perlmod.load]>->(
    'Crypt::Misc',
    qw(
        decode_b32r encode_b32r
        decode_b58s encode_b58s
        read_rawfile write_rawfile
    )
);

<index.permissions.index_root_path> //= 0700; ## zenka set-up less restrictive

<index.jobs> //= {};

<list.index-jobs> = {
    'var'   => qw| data |,
    'key'   => 'index.jobs',
    'mask'  => '<key>:job-id type',
    'align' => {
        'name' => 'left',
        'type' => qw| center-2 |,
    },
    ##  'filters' => {
    ##      'status'  => 'base.parser..,',
    ##      'session' => 'base.parser..,'
    ##  },
    'descr' => 'active [running] index jobs'
};

<index.data_paths> //= {};

<index.cfg.cluster_summarize_threshold> //= 42;
<index.cluster_reported>                //= {};

## numerical language deduplication tree data structures ##
## use //= throughout : preserves live data across in-process reloads ##
<index.freq>          //= {};
<index.addr>          //= {};
<index.packed_rank>   //= {};
<index.level>         //= {};
<index.trie>          //= {};
<index.terminal>      //= {};
<index.contributions> //= {};

## schema v4 cube format constants [ jhash32 compartment checksums ] ##
<index.cube.format.magic>          //= 'P7IC';
<index.cube.format.schema_version> //= 4;
<index.cube.format.compat_version> //= 4;
<index.cube.format.header_size>    //= 256;
<index.cube.format.dir_entry_size> //= 20;         ## Q(8)+N(4)+n(2)+n(2)+N(4)
<index.cube.format.flag.loaded>    //= 0x01;
<index.cube.format.flag.verified>  //= 0x02;
<index.cube.format.flag.error>     //= 0x04;
<index.cube.format.flag.storable>  //= 0x08;
<index.cube.format.flag.void>      //= 0x10;
<index.cube.format.pack.dir_entry> //= 'Q N n n N';
<index.cube.format.pack.comp_header> //= 'C N N n';
<index.cube.format.pack.child_entry> //= 'N N';
<index.cube.header>                  //= {};
<index.cube.mmap>                    //= undef;
<index.cube.loaded>                  //= {};

<index.sources>          //= {};
<index.active_checksums> //= {};
<index.chain_policy>     //= {};
<index.meta>             //= {
    root  => '',      ## '' is -1, the signed root outside address space
    total => 0,
    dirty => FALSE,
};

## restore corpus if not already in memory ##
if ( not( <index.meta>->{'total'} // 0 ) ) {
    if (<system.zenka.initialized>) {
        ## reload: already online, restore directly ##
        <[index.restore.cube]>;
    } else {
        ## fresh start: defer until after verification ##
        push @{ <system.callbacks.initialized> //= [] }, 'index.restore.cube';
    }
}

<index.tick.cursor>       //= 0;
<index.tick.idle_watcher> //= undef;

<[base.log]>->( 1, 'index zenka initialized [ numerical language tree ]' );

my $create_perm = <index.permissions.index_root_path>;
map { <[file.make_path]>->( $ARG, $create_perm, <system.amos-zenka-user> ) }
    ( <index.path.index-cfg>, <index.path.index-files> );

0;

