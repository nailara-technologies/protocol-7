## [:< ##

# name = index.init_code
# descr = initialize index zenka data structures

<[base.perlmod.autoload]>->('Digest::BMW');
<[base.perlmod.autoload]>->('Linux::Inotify2');
<[base.perlmod.autoload]>->('Crypt::PRNG::Fortuna');
<[base.perlmod.autoload]>->( 'File::Path',       qw| make_path | );
<[base.perlmod.autoload]>->( 'IO::Compress::Xz', qw| xz | );
<[base.perlmod.autoload]>->( 'Storable',         qw| nfreeze thaw | );

<[base.perlmod.autoload]>->( 'AMOS7::Assert::Truth', qw| is_true | );

<[base.perlmod.load]>->(
    'Crypt::Misc',
    qw(
        decode_b32r encode_b32r
        decode_b58s encode_b58s
        read_rawfile write_rawfile
    )
);

<index.permissions.index_root_path> //= 0700; ## zenka set-up less restrictive

<index.jobs> //= {};

<list.index-jobs> = {
    'var'   => qw| data |,
    'key'   => 'index.jobs',
    'mask'  => '<key>:job-id type',
    'align' => {
        'name' => 'left',
        'type' => qw| center-2 |,
    },
    ##  'filters' => {
    ##      'status'  => 'base.parser..,',
    ##      'session' => 'base.parser..,'
    ##  },
    'descr' => 'active [running] index jobs'
};

<index.data_paths> //= {};

<index.cfg.cluster_summarize_threshold> //= 42;
<index.cluster_reported>                //= {};

## numerical language deduplication tree data structures ##
## use //= throughout : preserves live data across in-process reloads ##
<index.freq>        //= {};
<index.addr>        //= {};
<index.packed_rank> //= {};
<index.level>       //= {};
<index.trie>        //= {};
<index.terminal>    //= {};
<index.meta>        //= {
    root  => '',      ## '' is -1, the signed root outside address space
    total => 0,
    dirty => FALSE,
};

## auto-restore from disk only if corpus is not already in memory ##
if ( not( <index.meta>->{'total'} // 0 ) ) {
    <[index.restore]>;
}

## defer rank rebuild to after startup — avoids init timeout on large corpora ##
if ( <index.meta>->{'dirty'} // 0 ) {
    <[event.add_timer]>->(
        {   'after'   => 0.2,
            'handler' => qw| index.rank |,
            'desc'    => 'index post-restore rank rebuild',
        }
    );
}

<[base.log]>->( 1, 'index zenka initialized [ numerical language tree ]' );

my $create_perm = <index.permissions.index_root_path>;
map { <[file.make_path]>->( $ARG, $create_perm, <system.amos-zenka-user> ) }
    ( <index.path.index-cfg>, <index.path.index-files> );

0;

