## [:< ##

# name  = index.restore
# descr = load compressed corpus data from zenka_dir [ .zxps ]

my $rel_path  = qw| numerical/numerical-index_state.zxps |;
my $comp_sref = <[file.zenka_dir.load]>->($rel_path);

return FALSE if not defined $comp_sref;

my $frozen;
IO::Uncompress::UnXz::unxz( $comp_sref, \$frozen )
    or return <[base.log]>->( 1, 'index.restore: xz decompression failed' );

my $state = thaw($frozen);
return FALSE if not defined $state;

<index.meta>          = $state->{'meta'}          // {};
<index.freq>          = $state->{'freq'}          // {};
<index.level>         = $state->{'level'}         // {};
<index.terminal>      = $state->{'terminal'}      // {};
<index.contributions> = $state->{'contributions'} // {};

my $schema_version = <index.meta>->{'schema_version'} // 0;
if ( $schema_version == 2 ) {
    <index.addr>        = $state->{'addr'}        // {};
    <index.packed_rank> = $state->{'packed_rank'} // {};
    <index.trie>        = $state->{'trie'}        // {};
} else {
    ## older format : rebuild derived structures on first query ##
    <index.meta>->{'dirty'} = TRUE;
}

my $total = <index.meta>->{'total'} // 0;
<[base.log]>->( 1, "index restored [ $total chars from $rel_path ]" );

return TRUE;

