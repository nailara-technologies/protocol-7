## [:< ##

# name  = index.restore
# descr = load compressed corpus data from zenka_dir [ .zxps ]

<[base.perlmod.autoload]>->( 'Storable', qw( thaw ) );

my $rel_path  = qw| numerical/numerical-index_state.zxps |;
my $comp_sref = <[base.file.zenka_dir.load]>->($rel_path);

## fall back to legacy uncompressed storable if .zxps not found ##
if ( not defined $comp_sref ) {
    my $legacy = <index.path.index-files> . '/index-state.storable';
    if ( -r $legacy ) {
        <[base.perlmod.autoload]>->( 'Storable', qw( retrieve ) );
        my $state = retrieve($legacy);
        return FALSE if not defined $state;
        <index.meta>  = $state->{'meta'}  // {};
        <index.freq>  = $state->{'freq'}  // {};
        <index.level> = $state->{'level'} // {};
        <[index.rank]>;
        my $total = <index.meta>->{'total'} // 0;
        <[base.log]>->( 1, "index restored [ $total chars from $legacy ]" );
        return TRUE;
    }
    return FALSE;
}

my $frozen;
IO::Uncompress::UnXz::unxz( $comp_sref, \$frozen )
    or return <[base.log]>->( 1, 'index.restore: xz decompression failed' );

my $state = thaw($frozen);
return FALSE if not defined $state;

<index.meta>  = $state->{'meta'}  // {};
<index.freq>  = $state->{'freq'}  // {};
<index.level> = $state->{'level'} // {};

## rebuild all derived structures ##
<[index.rank]>;

my $total = <index.meta>->{'total'} // 0;
<[base.log]>->( 1, "index restored [ $total chars from $rel_path ]" );

return TRUE;

