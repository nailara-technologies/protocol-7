# name  = coding.vision-parser.cmd.analyze_and_extract
# descr = two-stage vision analysis -> text extraction pipeline (deferred, state machine driven)

# Extract parameters from call object
my $image_path;
my $vision_prompt     = 'Analyze this image';
my $extraction_prompt = 'Extract and structure the key information';

if ( defined $call->{'param'} && ref $call->{'param'} eq 'HASH' ) {

    # Multiline mode - parameters as hash
    $image_path
        = $call->{'param'}->{'image_path'} || $call->{'param'}->{'image'};
    $vision_prompt = $call->{'param'}->{'vision_prompt'} || $vision_prompt;
    $extraction_prompt
        = $call->{'param'}->{'extraction_prompt'} || $extraction_prompt;
} elsif ( defined $call->{'args'} && length $call->{'args'} ) {

    # Single-line mode - parse space-separated arguments
    my @args = split( /\s+/, $call->{'args'}, 3 );
    $image_path        = $args[0];
    $vision_prompt     = $args[1] // $vision_prompt;
    $extraction_prompt = $args[2] // $extraction_prompt;
}

# Validate image exists
unless ( -f $image_path ) {
    return { 'mode' => 'false', 'data' => "Image not found: $image_path\n" };
}

# Generate job ID
my $job_id = <[base.gen_id]>->(<coding.vision-parser.jobs>);

# Create job entry - save reply_id for later callback
my $job = {
    'job_id'            => $job_id,
    'reply_id'          => $$call{'reply_id'},
    'image_path'        => $image_path,
    'vision_prompt'     => $vision_prompt,
    'extraction_prompt' => $extraction_prompt,
    'state'             => 'pending',
    'vision_result'     => undef,
    'extraction_result' => undef,
    'error'             => undef,
    'start_time'        => <[base.time]>->(3),
    'processed'         => 0
};

# Store job in global registry
<coding.vision-parser.jobs>->{$job_id} = $job;

<[base.logs]>->(
    1, '[vision-parser] job created: id=%s image=%s reply_id=%s',
    $job_id, $image_path, $$call{'reply_id'}
);

# For v1, queue vision analysis asynchronously - response comes via handler
<[base.logs]>->(
    1, '[vision-parser] starting pipeline execution: job=%s', $job_id
);

# STAGE 1: Queue vision analysis (asynchronous via Protocol-7 API)
<[base.logs]>->( 1, '[vision-parser] STAGE 1: queuing vision analysis' );

my $queue_result = <[base.protocol-7.command.send.local]>->(
    {   'command'   => 'cube.llama-server-vision.analyze_image',
        'call_args' => { 'args' => "$image_path $vision_prompt" },
        'reply'     => {
            'params'  => { 'job_id' => $job_id },
            'handler' => 'coding.vision-parser.handler.vision_reply'
        }
    }
);

<[base.logs]>->(
    1,
    '[vision-parser] vision analysis queued: queue_result=%s job_id=%s',
    $queue_result // 'undef', $job_id
);

# Return deferred response - actual result will come via reply handler
return { 'mode' => 'deferred', 'data' => "Vision analysis queued\n" };

