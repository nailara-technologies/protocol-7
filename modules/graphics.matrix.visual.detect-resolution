# name  = graphics.matrix.visual.detect-resolution
# desc  = Detect image resolution and format from various input types
#
# input : $image - path, data ref, or RGB array
# output: { 'type' => ..., 'size' => [...], 'rgb' => [...], ... }

my $image = shift;

return { 'mode' => qw| false |, 'data' => 'no image' } unless defined $image;

# Handle 1x1 pixel (color sample)
if ( ref $image eq qw| ARRAY | && @$image == 3 ) {
    return {
        'type' => qw| color_sample |,
        'rgb'  => $image,
        'size' => [ 1, 1 ]
    };
}

# Handle image path
if ( !ref $image && -f $image ) {
    my $gm  = Graphics::Magick->new;
    my $err = $gm->Read($image);

    if ($err) {
        return { 'mode' => qw| false |, 'data' => "read error: $err" };
    }

    my ( $w, $h ) = $gm->Get(qw| columns rows |);
    my $format = $gm->Get(qw| format |);

    return {
        'mode'   => qw| true |,
        'type'   => qw| image |,
        'size'   => [ $w, $h ],
        'format' => $format,
        'path'   => $image,
    };
}

# Handle image data reference (blob)
if ( ref $image eq qw| SCALAR | ) {
    my $gm  = Graphics::Magick->new;
    my $err = $gm->BlobToImage($$image);

    if ($err) {
        return { 'mode' => qw| false |, 'data' => "blob read error: $err" };
    }

    my ( $w, $h ) = $gm->Get(qw| columns rows |);
    my $format = $gm->Get(qw| format |);

    return {
        'mode'   => qw| true |,
        'type'   => qw| image_data |,
        'size'   => [ $w, $h ],
        'format' => $format,
    };
}

return { 'mode' => qw| false |, 'data' => 'unrecognized image format' };

