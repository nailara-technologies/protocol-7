## [:< ##

# name  = protocol.protocol-7.encryption.init
# descr = initialization for encrypted session state (state 3)
#         sets up encryption and link-layer encoding transformation layers
#
# called = from base.session.init_state when transitioning to state 3
#         (only after successful link-upgrade negotiation at state 2)
# optional = only entered if client requested and completed link upgrade
#            unencrypted local links never reach this state
# args   = session_id, mode, state_id
# returns = 1 (success) | 0 (failure - disconnect, not return to state 2)

my ( $session_id, $mode, $state_id ) = @ARG;
my $session = $data{'session'}{$session_id};

## Verify shared secret exists from link-upgrade negotiation
if ( not defined $session->{'link_dh_shared_secret'} ) {
    <[base.logs]>->(
        0,
        '[%d] encryption init: missing DH shared secret from link-upgrade',
        $session_id
    );
    return 0;
}

## Derive encryption key using AMOS7::13::key_32
## Input: C25519 DH shared secret
## Seed: session ID for entropy variation
my $enc_key = AMOS7::13::key_32(
    \$session->{'link_dh_shared_secret'},
    $session_id
);

if ( not defined $enc_key or length($enc_key) != 32 ) {
    <[base.logs]>->(
        0,
        '[%d] encryption init: key derivation failed',
        $session_id
    );
    return 0;
}

## Store encryption key in session (volatile, not persistent)
$session->{'link_encryption_key'} = $enc_key;

## TODO: Initialize cipher context (ChaCha20-Poly1305)
## Store cipher state for read/write operations
## For now, placeholder for future implementation

## Install encoding wrappers if negotiated
if ( defined $session->{'link_encoding_mode'}
    and length $session->{'link_encoding_mode'} ) {

    ## Save original handlers
    if ( not defined $session->{'input'}->{'handler_original'} ) {
        $session->{'input'}->{'handler_original'} = $session->{'input'}->{'handler'};
    }
    if ( not defined $session->{'output'}->{'handler_original'} ) {
        $session->{'output'}->{'handler_original'} = $session->{'output'}->{'handler'};
    }

    ## Install read wrapper (decode after decrypt)
    $session->{'input'}->{'handler'} = qw| base.handler.read.encoding-wrapper |;

    ## Create session-specific write wrapper (encode before encrypt)
    my $wrapper_handler_name = sprintf qw| base.handler.write.encoding-%d |, $session_id;
    my $write_wrapper = <[base.handler.write.encoding-wrapper]>->(
        $session_id, $session->{'link_encoding_mode'}
    );
    $code{$wrapper_handler_name} = $write_wrapper if ref $write_wrapper eq qw| CODE |;

    ## Install write wrapper
    $session->{'output'}->{'handler'} = $wrapper_handler_name;

    <[base.logs]>->(
        2,
        '[%d] installed link-layer encoding wrappers for mode: %s',
        $session_id, $session->{'link_encoding_mode'}
    );
}

<[base.logs]>->(
    2,
    '[%d] encryption initialized (state %d), encryption key derived',
    $session_id, $state_id
);

## TODO: Install encryption wrappers
## - Implement base.handler.read.encryption-wrapper (decrypt layer)
## - Implement base.handler.write.encryption-wrapper (encrypt layer)
## - Order: plaintext → encrypt → [compress] → encode → linewise

return 1;

1;

