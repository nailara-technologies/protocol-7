## [:< ##

# name  = protocol.protocol-7.encryption.init
# descr = initialization for encrypted session state (state 3)
#         sets up encryption and link-layer encoding transformation layers
#
# called = from base.session.init_state when transitioning to state 3
#         (only after successful link-upgrade negotiation at state 2)
# optional = only entered if client requested and completed link upgrade
#            unencrypted local links never reach this state
# args   = session_id, mode, state_id
# returns = 1 (success) | 0 (failure - disconnect, not return to state 2)

my ( $session_id, $mode, $state_id ) = @ARG;
my $session = $data{'session'}{$session_id};

## TODO: Initialize encryption and encoding layers
## - Derive session encryption key from negotiated secret (C25519 DH)
## - Initialize cipher context (negotiated during link-upgrade state 2)
## - Set up IV/nonce handling
## - Install encryption wrapper on read handler
## - Install encryption wrapper on write handler
## - If link_encoding_mode negotiated (utf7/base32/base32-xz):
##   * Install read.encoding-wrapper to decode after decrypt
##   * Install write.encoding-wrapper to encode before encrypt
##   * Order: plaintext → encrypt → [compress] → encode → linewise

<[base.logs]>->(
    2,
    '[%d] initializing encrypted session (state %d)',
    $session_id, $state_id
);

## TODO: Derive encryption key from session negotiation
## Key derivation would use:
## - Ephemeral C25519 shared secret (from link-upgrade state 2)
## - Session ID as additional context
## - HKDF or similar KDF

## TODO: Install encryption wrappers
## - read.encryption-wrapper: receive linewise → decode (if encoding) → decompress (if xz) → decrypt → plaintext
## - write.encryption-wrapper: plaintext → encrypt → compress (if xz) → encode (if encoding) → linewise

## TODO: Link-layer encoding installation
## If $session->{'link_encoding_mode'} is set from link-upgrade:
## - Install base.handler.read.encoding-wrapper in pipeline
## - Install base.handler.write.encoding-wrapper closure
## - Wrappers handle utf7/base32/base32-xz transformation

## Placeholder: return success (wrappers will be installed as development continues)
return 1;

1;

