## [:< ##

# name  = protocol.protocol-7.encryption.init
# descr = initialization for encrypted session state (state 3)
#         sets up encryption and link-layer encoding transformation layers
#
# called = from base.session.init_state when transitioning to state 3
#         (only after successful link-upgrade negotiation at state 2)
# optional = only entered if client requested and completed link upgrade
#            unencrypted local links never reach this state
# args   = session_id, mode, state_id
# returns = 1 (success) | 0 (failure - disconnect, not return to state 2)

my ( $session_id, $mode, $state_id ) = @ARG;
my $session = $data{'session'}{$session_id};

## Verify shared secret exists from link-upgrade negotiation
if ( not defined $session->{'link_dh_shared_secret'} ) {
    <[base.logs]>->(
        0,
        '[%d] encryption init: missing DH shared secret from link-upgrade',
        $session_id
    );
    return 0;
}

## Derive encryption key using AMOS7::13::key_32
## Input: C25519 DH shared secret
## Seed: session ID for entropy variation
my $enc_key = AMOS7::13::key_32(
    \$session->{'link_dh_shared_secret'},
    $session_id
);

if ( not defined $enc_key or length($enc_key) != 32 ) {
    <[base.logs]>->(
        0,
        '[%d] encryption init: key derivation failed',
        $session_id
    );
    return 0;
}

## Store encryption key in session (volatile, not persistent)
$session->{'link_encryption_key'} = $enc_key;

## Initialize ChaCha20-Poly1305 cipher context
## Load cipher module if not already loaded
if ( not <base.perlmod.loaded>->( 'Crypt::AuthEnc::ChaCha20Poly1305' ) ) {
    <[base.perlmod.load]>->( 'Crypt::AuthEnc::ChaCha20Poly1305' );
}

## Note: Cipher instances are created per-message with generated nonces
## No need to create a context here - we'll create fresh instances in the wrappers
## Just initialize the message counter for nonce generation

$session->{'link_read_counter'} = 0;   ## read-side message counter
$session->{'link_write_counter'} = 0;  ## write-side message counter

<[base.logs]>->(
    2,
    '[%d] ChaCha20-Poly1305 cipher initialized',
    $session_id
);

## Save current input/output handlers before installing encryption wrappers
if ( not defined $session->{'input'}->{'handler_encryption_original'} ) {
    $session->{'input'}->{'handler_encryption_original'} = $session->{'input'}->{'handler'} // qw| base.handler.command |;
}
if ( not defined $session->{'output'}->{'handler_encryption_original'} ) {
    $session->{'output'}->{'handler_encryption_original'} = $session->{'output'}->{'handler'} // qw| base.handler.write |;
}

## Install read encryption wrapper (decrypts incoming data)
$session->{'input'}->{'handler'} = qw| base.handler.read.encryption-wrapper |;

## Create session-specific write encryption wrapper
my $write_crypto_handler_name = sprintf qw| base.handler.write.encryption-%d |, $session_id;
my $write_crypto_wrapper = <[base.handler.write.encryption-wrapper]>->(
    $session_id, $enc_key
);
$code{$write_crypto_handler_name} = $write_crypto_wrapper if ref $write_crypto_wrapper eq qw| CODE |;

## Install write encryption wrapper
$session->{'output'}->{'handler'} = $write_crypto_handler_name;

<[base.logs]>->(
    2,
    '[%d] encryption wrappers installed',
    $session_id
);

## Install encoding wrappers if negotiated
if ( defined $session->{'link_encoding_mode'}
    and length $session->{'link_encoding_mode'} ) {

    ## Save encryption wrappers as original for encoding wrappers
    if ( not defined $session->{'input'}->{'handler_original'} ) {
        $session->{'input'}->{'handler_original'} = qw| base.handler.read.encryption-wrapper |;
    }
    if ( not defined $session->{'output'}->{'handler_original'} ) {
        $session->{'output'}->{'handler_original'} = $write_crypto_handler_name;
    }

    ## Install read wrapper (decode after decrypt)
    $session->{'input'}->{'handler'} = qw| base.handler.read.encoding-wrapper |;

    ## Create session-specific write wrapper (encode before encrypt)
    my $wrapper_handler_name = sprintf qw| base.handler.write.encoding-%d |, $session_id;
    my $write_wrapper = <[base.handler.write.encoding-wrapper]>->(
        $session_id, $session->{'link_encoding_mode'}
    );
    $code{$wrapper_handler_name} = $write_wrapper if ref $write_wrapper eq qw| CODE |;

    ## Install write wrapper
    $session->{'output'}->{'handler'} = $wrapper_handler_name;

    <[base.logs]>->(
        2,
        '[%d] installed link-layer encoding wrappers for mode: %s',
        $session_id, $session->{'link_encoding_mode'}
    );
}

<[base.logs]>->(
    2,
    '[%d] encryption initialized (state %d), all layers configured',
    $session_id, $state_id
);

return 1;

1;

