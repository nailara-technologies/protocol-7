## [:< ##

# name = models.cmd.get_model
# descr = Retrieve a model by AMOS checksum with automatic fallback chain resolution

# Command: models.get_model <amos_checksum>
# Returns: { path, tier, available, success, error }

sub execute_get_model {
  my ($model_amos) = @_;

  return {
    'success' => FALSE,
    'error' => 'model AMOS checksum required',
  } unless $model_amos;

  # Load registry
  my $registry_funcs = <[models.registry.init]>;
  my $model_entry = $registry_funcs->{get_model_entry}->($model_amos);

  return {
    'success' => FALSE,
    'error' => "model not found: $model_amos",
  } if $model_entry->{not_found};

  # Resolve through fallback chain
  my $storage_funcs = <[models.storage.tier_management]>;
  my $resolved = $storage_funcs->{resolve_model_path}->(
    $model_amos,
    $model_entry->{storage_locations}
  );

  return {
    'success' => 1,
    'model_amos' => $model_amos,
    'path' => $resolved->{path},
    'tier' => $resolved->{tier},
    'available' => $resolved->{available},
    'name' => $model_entry->{metadata}->{name},
    'version' => $model_entry->{metadata}->{version},
    'is_metadata_only' => $resolved->{is_metadata_only} // 0,
  };
}

# Entry point
{
  my $cmd = shift @ARG;
  my @args = @ARG;

  if ($cmd eq 'get_model' || $cmd eq 'get') {
    return execute_get_model(@args);
  }

  return {
    'success' => FALSE,
    'error' => "unknown command: $cmd",
  };
};

