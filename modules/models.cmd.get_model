## [:< ##

# name = models.cmd.get_model
# descr = retrieve model by AMOS checksum with fallback chain

my $cmd = shift @ARG;
my ($model_amos) = @ARG;

if ( !$model_amos ) {
    return {
        'mode' => qw| size |,
        'data' => "error: model AMOS checksum required\n"
    };
}

# Get model entry - call extracted module directly
my $model_entry
    = <[models.registry.get_entry.get_model_entry]>->($model_amos);

if ( $model_entry->{not_found} ) {
    return {
        'mode' => qw| size |,
        'data' => "error: model not found: $model_amos\n"
    };
}

# Resolve through fallback chain - call extracted module directly
my $resolved = <[models.storage.resolve_model.resolve_model_path]>->(
    $model_amos, $model_entry->{storage_locations}
);

my $reply_str = '';
$reply_str .= "model_amos: $model_amos\n";
$reply_str .= "path: " . ( $resolved->{path} // 'not found' ) . "\n";
$reply_str .= "tier: " . ( $resolved->{tier} // 'unknown' ) . "\n";
$reply_str
    .= "available: " . ( $resolved->{available} ? 'yes' : 'no' ) . "\n";
$reply_str
    .= "name: " . ( $model_entry->{metadata}->{name} // 'unknown' ) . "\n";
$reply_str .= "version: "
    . ( $model_entry->{metadata}->{version} // 'unknown' ) . "\n";
$reply_str .= "is_metadata_only: "
    . ( ( $resolved->{is_metadata_only} // 0 ) ? 'yes' : 'no' ) . "\n";

return { 'mode' => qw| size |, 'data' => $reply_str };

