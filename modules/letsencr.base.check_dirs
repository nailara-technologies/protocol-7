## [:< ##

# name  = letsencr.base.check_dirs
# descr = create required directories for Let's Encrypt operations
#         with proper permissions

## directories to create (called before drop_privs, so runs as root)
## certs dir uses setgid [02770] so files inherit httpsd group automatically
## [ letsencr cannot chgrp after dropping privs ]
my $certs_dir = <letsencr.certs.dir>;

## add protocol-7 user to httpsd group so setgid inheritance works
## [ setgid requires creating process to be a member of the target group ]
my $p7_user    = <system.amos-zenka-user>;
my $httpsd_gid = ( getgrnam('httpsd') )[2];
if ( defined $httpsd_gid ) {
    my @httpsd_members = split qw| , |, ( getgrgid($httpsd_gid) )[3] // '';
    unless ( grep { $ARG eq $p7_user } @httpsd_members ) {
        if ( system( 'usermod', qw| -a -G httpsd |, $p7_user ) == 0 ) {
            <[base.logs]>->(
                1, 'added %s to httpsd group for cert file ownership',
                $p7_user
            );
        }
    }
}

my @dirs = (
    [ $certs_dir,              02770, qw| httpsd | ],
    [ <letsencr.certs.backup>, 0700,  undef ],
    [ <letsencr.cache.dir>,    0700,  undef ],
);

foreach my $dir_cfg (@dirs) {
    my ( $dir, $mode, $group ) = @{$dir_cfg};
    next unless $dir;

    <[file.make_path]>->( $dir, $mode, <system.amos-zenka-user>, $group )
        or
        <[base.logs]>->( 1, 'error: failed to create directory: %s', $dir );
}

<[base.log]>->( 2, 'certificate directories created and configured' );

