## [:< ##

# name  = session.console.stats
# param =
# descr = show session dependency check statistics

<[base.log]>->( 1, "Session statistics:" );

my @output;
push @output, "::";
push @output, ": Session Dependency Statistics";
push @output, ":";

my $stats = $data{'session'}{'stats'} || {};

push @output, sprintf(": %-30s: %d", "Checks performed", $stats->{'checks_performed'} || 0);
push @output, sprintf(": %-30s: %d", "Auto-installs", $stats->{'auto_installs'} || 0);
push @output, sprintf(": %-30s: %d", "Startup helpers shown", $stats->{'startup_zenka_shown'} || 0);
push @output, sprintf(": %-30s: %d", "Times fully satisfied", $stats->{'deps_satisfied'} || 0);
push @output, ":";

## Configuration status
push @output, ": Current Configuration:";
push @output, sprintf(": %-30s: %s", "Auto-check enabled", <session.cfg.auto_check_deps> ? 'yes' : 'no');
push @output, sprintf(": %-30s: %s", "Auto-install minimal", <session.cfg.auto_install_minimal> ? 'yes' : 'no');
push @output, sprintf(": %-30s: %s", "Show startup helper", <session.cfg.show_startup_zenka> ? 'yes' : 'no');
push @output, sprintf(": %-30s: %s", "Check performed this session", <session.cfg.check_performed> ? 'yes' : 'no');

push @output, "::";

return say join("\n", @output);

