## [:< ##

# name  = letsencr.child.create_http01_challenge
# descr = create HTTP-01 challenge response and write to well-known directory

my $challenge = shift;    # challenge data from authorization
my $domain    = shift;

return undef unless $challenge && $domain;

<[base.logs]>->( 2, 'creating HTTP-01 challenge response for %s', $domain );

## Extract challenge token
my $token = $challenge->{'token'};

unless ($token) {
    <[base.log]>->( 0, 'no token in challenge' );
    return undef;
}

## Get account key thumbprint
my $jwk = <[letsencr.child.get_jwk]>;
unless ($jwk) {
    <[base.log]>->( 0, 'failed to get JWK' );
    return undef;
}

## Create JWK thumbprint [ RFC 7638 ]
my $jwk_ordered = JSON::XS->new->canonical(1)->encode($jwk);
my $thumbprint  = encode_base64url( sha256($jwk_ordered) );

<[base.logs]>->( 3, 'JWK thumbprint: %s', $thumbprint );

## Create key authorization : token.thumbprint
my $key_auth = join qw| . |, $token, $thumbprint;

<[base.logs]>->( 3, 'key authorization : %s', $key_auth );

## For HTTP-01, we need to serve key auth at:
## http://example.com/.well-known/acme-challenge/{token}

## contact httpd to set up challenge
<[base.logs]>->(
    2, 'contacting httpd to set up HTTP-01 challenge for %s', $domain
);

my $setup_result = <[base.protocol-7.command.send.local]>->(
    {   'command'   => qw| cube.httpd.cmd.setup-acme-challenge |,
        'call_args' => {
            'domain'   => $domain,
            'token'    => $token,
            'key_auth' => $key_auth,
        }
    }
);

unless ($setup_result) {
    <[base.logs]>->(
        0, 'failed to queue challenge setup with httpd for %s', $domain
    );
    return undef;
}

<[base.logs]>->( 2, 'HTTP-01 challenge set up with httpd for %s', $domain );

## Store challenge info in child state for later verification
<letsencr.child.active_challenges>->{$token} = {
    domain        => $domain,
    token         => $token,
    key_auth      => $key_auth,
    challenge_url => $challenge->{'url'},
    created_at    => <[base.time]>->(3),
};

return {
    token          => $token,
    key_auth       => $key_auth,
    well_known_url => "http://$domain/.well-known/acme-challenge/$token",
    challenge_url  => $challenge->{'url'},
};

