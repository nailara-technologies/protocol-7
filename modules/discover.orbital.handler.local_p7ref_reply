## [:< ##

# name  = discover.orbital.handler.local_p7ref_reply
# descr = reply handler for local orbital p7ref request

my $reply = shift;

## nodes.orbital-position returns mode=size key=value lines ##
my $raw   = $reply->{'call_args'}{'args'} // '';
my $p7ref = '';
if ( $raw =~ m|^\s*p7ref\s+(\S+)|m ) {
    $p7ref = $1;
}

if ( length $p7ref ) {
    <discover.orbital.local_p7ref> = $p7ref;
    return $p7ref;
}

<[base.logs]>->( 3, 'orbital p7ref reply contained no p7ref' );

return undef;

