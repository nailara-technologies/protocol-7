## [:< ##

# name = image-batch.child.loop
# descr = Child worker event loop for job processing

<[base.perlmod.load]>->('JSON::XS', qw| encode_json decode_json |);

my $parent_pipe = <image-batch.child.parent_pipe>;
my $worker_id = <image-batch.child.worker_id>;

return { success => FALSE, error => 'Parent pipe not initialized' } unless defined $parent_pipe;

# Set autoflush for pipe
$parent_pipe->autoflush(1);

# Send ready signal to parent
my $ready_msg = encode_json({ cmd => 'ready', worker_id => $worker_id });
print {$parent_pipe} "$ready_msg\n";

# Event loop: wait for jobs from parent
while (1) {
    # Read JSON command from parent
    my $line = <$parent_pipe>;
    last unless defined $line;  # Parent pipe closed

    chomp $line;

    # Parse JSON command
    my $job;
    eval {
        $job = decode_json($line);
    };

    if ($@) {
        # Invalid JSON, send error and continue
        my $error_response = encode_json({
            cmd => 'error',
            error => "Failed to parse JSON: $@"
        });
        print {$parent_pipe} "$error_response\n";
        next;
    }

    # Check command type
    if ($job->{cmd} eq 'analyze') {
        # Process image analysis job
        my $result = <[image-batch.child.analyze_job]>->($job);

        # Send result back to parent
        my $response = encode_json($result);
        print {$parent_pipe} "$response\n";

        # Send ready signal for next job
        print {$parent_pipe} "$ready_msg\n";

    } elsif ($job->{cmd} eq 'shutdown') {
        # Parent signaled shutdown
        last;

    } else {
        # Unknown command
        my $error_response = encode_json({
            cmd => 'error',
            error => "Unknown command: $job->{cmd}"
        });
        print {$parent_pipe} "$error_response\n";
    }
}

# Graceful exit
close $parent_pipe;
return TRUE;

