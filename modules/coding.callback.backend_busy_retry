# name  = coding.callback.backend_busy_retry
# descr = Retry handler when backend is busy with another inference request

## timer callbacks receive watcher object, extract data from it ##
my $task_id = shift->w->data;

return unless defined $task_id && !ref $task_id;

<[base.logs]>->(
    2, "backend_busy_retry: retrying %s after backend wait", $task_id
);

## guard: only proceed if task is still active ##
my $state = <[coding.async.state_manager]>->( qw| get |, $task_id );
if ( !defined $state ) {
    <[base.logs]>->(
        2, "backend_busy_retry: %s no longer active, skipping", $task_id
    );
    return;
}

delete $state->{'backend_busy'};
delete $state->{'retry_timer_pending'};
<coding.async.task_state>->{$task_id} = $state;

## re-attempt inference request ##
<[coding.async.send_request]>->($task_id);

return;

