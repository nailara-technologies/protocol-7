## [:< ##

# name = data.mount.shm.create.mmap_file
# descr = mmap file-based SHM

my ( $fh, $size ) = @ARG;

return undef unless defined $fh;

if ( eval { require Sys::Mmap } ) {
    my $var;
    eval {
        Sys::Mmap::mmap( $var, $size,
            Sys::Mmap::PROT_READ() | Sys::Mmap::PROT_WRITE(),
            Sys::Mmap::MAP_SHARED(), fileno($fh), 0 );
    };
    return \$var if !$@ && length($var) > 0;
}

return undef;

