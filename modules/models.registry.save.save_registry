# name  = models.registry.save.save_registry
# descr = Save registry to disk with file locking

use JSON::PP;
use Fcntl qw| :flock |;

my ($registry) = @ARG;

return 0 unless $registry && ref($registry) eq 'HASH';

my $path = <[models.registry.base.get_registry_path]>->();
open my $fh, '>', $path or return 0;
flock($fh, 2);  # LOCK_EX
$registry->{updated_at} = time();
print $fh encode_json($registry);
flock($fh, 8);  # LOCK_UN
close $fh;

return 1;

