# name = models.storage.create_symlink
# descr = Create symlink in Tier 3 pointing to Tier 2

use File::Path qw| make_path |;

# Create symlink in Tier 3 pointing to Tier 2
sub create_fast_symlink {
  my ($model_amos, $tier2_path) = @_;

  my $tier3_base = $data{models}{tiers}->{3}->{base_path};
  my $tier3_path = File::Spec->catfile($tier3_base, "$model_amos.gguf");

  # Ensure Tier 3 directory exists
  make_path($tier3_base) unless -d $tier3_base;

  # Remove existing symlink if present
  unlink($tier3_path) if -l $tier3_path;

  # Create new symlink
  symlink($tier2_path, $tier3_path) or return {
    'success' => 0,
    'error' => "Cannot create symlink: $!",
  };

  return {
    'success' => 1,
    'symlink' => $tier3_path,
    'target' => $tier2_path,
  };
}

# Entry point
{
  my @args = @ARG;
  return create_fast_symlink(@args);
};

