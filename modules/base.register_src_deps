## [:< ##

# name = base.register_src_deps

my %np7_src        = map { $ARG => TRUE } @ARG;
my $zenka          = <system.zenka.name>;
my $cfg_path       = <system.conf_path>;
my $start_cfg_name = qw| start |;

my $file_perm = 0664;    ## zenka group gets write access ##
my $lc_hook   = qr{pre_init|init_code|post_init|end_code};

my $src_deps = <[base.get_path.zenka_cfg]>;
$src_deps =~ s|zenki/$zenka/$start_cfg_name|$cfg_path/zenki/$zenka/source|;

## skip if dependencies already registered ##
## [ when root : fall through to fix any ownership or permission issues ] ##
my $already_registered = TRUE;
foreach my $src ( keys %np7_src ) {
    my $src_file = catfile( $src_deps, $src );
    if ( not -e $src_file ) {
        $already_registered = 0;
        last;
    }
}
return TRUE if $already_registered and $EUID != 0;

<[base.check_dependency_dirs]> if not -d $src_deps;

## Get parent directory owner [taeki in dev, root in production] ##
my ($parent_uid) = <[base.path_owners]>->($src_deps);
unless ( defined $parent_uid ) {
    <[base.logs]>->(
        0, "<< register_src_deps : cannot get parent dir owner for '%s' >>",
        $src_deps
    );
    return undef;
}

## Get zenka group [httpd, httpsd, etc.] ##
my $zenka_user  = <system.amos-zenka-user> // qw| protocol-7 |;
my $zenka_group = $zenka_user;              ## same as user ##
my $gid         = getgrnam($zenka_group);
if ( not defined $gid ) {                   ## try auto-installing user ##
    <[base.root.check_system_user]>->($zenka_user);
    $gid = getgrnam($zenka_group)
        or <[base.logs]>->(
        0, "<< register_src_deps : unix group '%s' not in passwd >>",
        $zenka_group
        ) and return undef;
}

## log the ownership values being used [ log level 3 ] ##
my $parent_user = getpwuid($parent_uid) // "UID:$parent_uid";
my $group_name  = getgrgid($gid)        // "GID:$gid";
<[base.logs]>->(
    3, "[register_src_deps] owner='%s' [%d] group='%s' [%d]",
    $parent_user, $parent_uid, $group_name, $gid
);

if ( -d $src_deps and -w $src_deps ) {
    my $src_stat = File::stat::stat($src_deps);

    ## skip chmod only when running standalone, not under v7 control ##
    my $skip_chmod = !<[base.zenka.is_v7_started]>;

    foreach my $mod_name ( sort keys %np7_src ) {
        next if $mod_name eq qw| devmod |;

        ## collapse feature : a lifecycle/runtime sub-file [ e.g.       ##
        ## base.base32.pre_init ] is already covered once any ancestor  ##
        ## namespace [ 'base', 'base.base32', ... ] is registered -- or ##
        ## about to be, within this same batch -- so skip its own file  ##
        my @ancestors = split m|\.|, $mod_name;
        pop @ancestors;    ## drop the leaf : ancestors only ##
        my $covered = FALSE;
        while (@ancestors) {
            my $ancestor = join '.', @ancestors;
            if ( exists $np7_src{$ancestor}
                or -e catfile( $src_deps, $ancestor ) ) {
                $covered = TRUE;
                last;
            }
            pop @ancestors;
        }
        next if $covered;

        my $reg_name = $mod_name;

        ## no registered ancestor yet : if this is a nested lifecycle    ##
        ## hook, register the top-level namespace instead of the hook's  ##
        ## own file -- whichever hook happens to compile first then      ##
        ## creates the one covering file, and every sibling collapses    ##
        ## under it above, regardless of compile order [ this is what   ##
        ## lets 'base' itself get created before any of base.*.pre_init  ##
        ## races ahead of base.init_code's own registration call ]      ##
        if ( $mod_name =~ m{\.(?:$lc_hook)$} ) {
            ($reg_name) = split m|\.|, $mod_name, 2;
        }

        my $touch_file = catfile( $src_deps, $reg_name );
        next if $reg_name ne $mod_name and -e $touch_file;

        ## create file if it doesn't exist ##
        if ( !-e $touch_file ) {
            my $fh;    ## use mknod to create empty files ##  [LLL]
            open( $fh, qw| >> |, $touch_file ) and close($fh);
        }

        ( my $relpath = $touch_file ) =~ s|^.*/||;

        ## always chown to fix existing root-owned files,  even in ##
        ## standalone zenka mode                                   ##
        if ( $EUID == 0 ) {
            <[base.logs]>->(
                3, ": attempting chown[ %d, %d, '%s' ]",
                $parent_uid, $gid, $relpath
            );
            chown( $parent_uid, $gid, $touch_file )
                or <[base.logs]>->(
                2,        ':. : cannot chown %s : %s .:',
                $relpath, <[base.str.os_err]>
                );
        } else {
            <[base.logs]>->(
                2,        ": skipping chown for %s - EUID=%d [not root]",
                $relpath, $EUID
            );
        }

        next if $skip_chmod;    ## skip chmod only [ root + standalone ] ##

        ## chmod ##
        chmod( $file_perm, $touch_file )
            or <[base.logs]>->(
            2,        ":. : '%s' : chmod : %s .:",
            $relpath, <[base.str.os_err]>
            );
    }
} else {
    <[base.log]>->( 2, "<< no [writable] src-deps directory found >>" );
}

