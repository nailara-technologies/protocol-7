## [:< ##

# name  = base.session.set_subname
# descr = register a session's routing subname
# param = $session_id, $user_name, $subname

## call only AFTER authorization succeeded -- this records a routing label, it
## never grants anything.
##
## the per-user counter is what base.session.check.close decrements again on
## disconnect, so both writes have to stay together ; that pairing is the
## reason this is one shared module rather than a few lines copied into each
## auth plugin

my ( $session_id, $user_name, $subname ) = @ARG;

return FALSE
    if not defined $session_id
    or not defined $user_name
    or not defined $subname
    or not length $subname;

$data{'session'}{$session_id}{'subname'} = $subname;
$data{'user'}{$user_name}{'subname'}{$subname}++;

<[base.logs]>->( 2, "[%s] .: routing subname '%s'", $session_id, $subname );

return TRUE;

