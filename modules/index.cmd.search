## [:< ##

# name  = index.cmd.search
# descr = prefix search : ranked sequence candidates

my $prefix = $call->{'args'} // '';
return { 'mode' => 'false', 'data' => 'expected prefix' }
    unless length $prefix;

my $results = <[index.search]>->($prefix);
return { 'mode' => 'false', 'data' => 'no results' } unless @{$results};

my @lines;
push @lines, sprintf "search [ %s ] -- %d results :", $prefix,
    scalar @{$results};
for my $r ( @{$results} ) {
    ( my $seq = $r->[0] ) =~ s/\n/\\n/g;
    $seq                  =~ s/\r/\\r/g;
    $seq                  =~ s/\t/\\t/g;
    $seq                  =~ s/\v/\\v/g;
    push @lines, sprintf "  %6d  %s  [ rank %d ]", $r->[2], $seq, $r->[1];
}

return { 'mode' => 'size', 'data' => join( "\n", @lines ) };

