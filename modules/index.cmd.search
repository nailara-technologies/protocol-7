## [:< ##

# name  = index.cmd.search
# descr = prefix search : ranked sequence candidates

## lazy rank rebuild after restore ##
<[index.rank]> if <index.meta>->{'dirty'} // 0;

my $prefix = $call->{'args'} // '';
return { 'mode' => 'false', 'data' => 'expected prefix' }
    unless length $prefix;

my $results = <[index.search]>->($prefix);

## check if prefix itself exists as a ranked sequence ##
my $self_node  = <[index.lookup]>->($prefix);
my $self_match = defined $self_node ? 1 : 0;

return { 'mode' => 'false', 'data' => 'no results' }
    if not @{$results} and not $self_match;

my $depth     = length($prefix) - 1;
my $self_rank = undef;
my $self_freq = 0;
if ($self_match) {
    $self_rank = <index.addr>->{"$depth:$prefix"} // '?';
    my $win = $depth + 1;
    $self_freq
        = $win == 1
        ? ( <index.freq>->{$prefix} // 0 )
        : ( ( <index.level>->{$win} // {} )->{$prefix} // 0 );
}

my @lines;
my $count = scalar( @{$results} ) + ( $self_match ? 1 : 0 );
push @lines, sprintf "search [ %s ] -- %d results :", $prefix, $count;

## direct match first ##
if ($self_match) {
    my $is_terminal = $self_node->[0] ? 1                 : 0;
    my $label       = $is_terminal    ? 'exact, terminal' : 'exact';
    ( my $disp = $prefix ) =~ s|\\|\\\\|g;
    $disp                  =~ s|\n|\\n|g;
    $disp                  =~ s|\r|\\r|g;
    $disp                  =~ s|\t|\\t|g;
    $disp                  =~ s|\v|\\v|g;
    push @lines,
        sprintf "  %6d  %s  [ %s, rank %s ]", $self_freq, $disp,
        $label, $self_rank;
}

for my $r ( @{$results} ) {
    ( my $seq = $r->[0] ) =~ s|\\|\\\\|g;
    $seq                  =~ s|\n|\\n|g;
    $seq                  =~ s|\r|\\r|g;
    $seq                  =~ s|\t|\\t|g;
    $seq                  =~ s|\v|\\v|g;
    push @lines, sprintf "  %6d  %s  [ rank %d ]", $r->[2], $seq, $r->[1];
}

return { 'mode' => 'size', 'data' => join( "\n", @lines ) . "\n" };

