## [:< ##

# name  = space.jump.cache.write
# descr = write next hop to branch.route.cache with current ntime
# param = { hop, target, next_hop }

my $params   = shift                 // {};
my $hop      = $params->{'hop'}      // '';
my $target   = $params->{'target'}   // '';
my $next_hop = $params->{'next_hop'} // '';

return FALSE unless length $hop and length $target and length $next_hop;

my $ntime = <[base.time]>->(4);

$data{'branch.route.cache'}{$hop}{$target} = {
    'next_hop' => $next_hop,
    'ntime'    => $ntime,
};

return TRUE;

