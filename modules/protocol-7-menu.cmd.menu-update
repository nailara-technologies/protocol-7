## [:< ##

# name = protocol-7-menu.cmd.menu-update
# descr = Receive menu structure update from provider zenka (push-based)
# param = <provider-name> [<update-data-yaml-or-json>]
# formats = YAML (native) or JSON (backward compat)

<[base.log]>->(
    1,
    "menu-update COMMAND CALLED with args length: %d",
    length( $call->{'args'} // '' )
);

<[base.perlmod.load]>->('YAML::XS');

my $call_args = $call->{'args'} // '';
my ( $provider, $update_data ) = split( m|\s+|, $call_args, 2 );

return { 'mode' => qw| false |, 'data' => 'provider name required' }
    unless defined $provider;

## Strip surrounding quotes if present (from command-line args)
if ( defined $update_data ) {
    $update_data =~ s/^['"]//;
    $update_data =~ s/['"]$//;
}

<[base.logs]>->(
    1,         "menu update from provider '%s' (%d bytes)",
    $provider, length( $update_data // '' )
);
<[base.logs]>->(
    2,
    "update data length: %d, starts with: [%s]",
    length( $update_data // '' ),
    substr( $update_data // '', 0, 50 )
);

if ( !defined $update_data ) {
    <[base.log]>->( 2, "WARNING: update_data is undefined" );
}

my $menu_structure = <protocol-7-menu.menu-structure>;

## Update or create provider section
if ( defined $update_data ) {
    ## Update with provided data structure
    ## Auto-detect: JSON (starts with '{') or YAML (native format, starts with 'items:' or other key)
    my $provider_data;

    ## Try JSON first (backward compatibility)
    if ( $update_data =~ m/^\{/ ) {
        eval { $provider_data = JSON::decode_json($update_data); };
        if ( length $EVAL_ERROR ) {
            return {
                'mode' => qw| false |,
                'data' => "failed to parse JSON "
                    . "provider data [details loged]"
            };
        }
        <[base.log]>->( 2, "parsed provider data as JSON" );
    } else {
        ## Parse as YAML (native Protocol-7 format)
        ## Expected: key: value structure (no document marker)
        eval {
            my $prepended_yaml
                = "---\n" . $update_data;    # Re-add marker for parser
            $provider_data = YAML::XS::Load($prepended_yaml);
        };
        if ( length $EVAL_ERROR ) {
            return {
                'mode' => qw| false |,
                'data' => "failed to parse YAML "
                    . "provider data [details logged]"
            };
        }
        <[base.log]>->( 2, "parsed provider data as YAML" );
    }

    <[base.logs]>->(
        2, "provider_data structure - ref: %s, items defined: %s",
        ref($provider_data),
        ( defined $provider_data->{'items'} ? 'YES' : 'NO' )
    );

    if ( defined $provider_data->{'items'}
        && ref( $provider_data->{'items'} ) eq 'HASH' ) {
        <[base.log]>->(
            2,
            "items hash has %d keys",
            scalar( keys %{ $provider_data->{'items'} } )
        );
    } elsif ( defined $provider_data->{'items'} ) {
        <[base.logs]>->(
            2,
            "items is defined but not HASH - type: %s",
            ref( $provider_data->{'items'} )
        );
    }

    $menu_structure->{providers}{$provider} = $provider_data;

    <[base.logs]>->(
        2,
        "stored provider data - items: %s",
        (   defined $menu_structure->{providers}{$provider}->{'items'}
            ? scalar(
                keys %{ $menu_structure->{providers}{$provider}->{'items'} }
                )
                . " items"
            : "undef"
        )
    );
} else {
    ## Simple existence update - remove provider if update_data is empty
    ## (allows zenka to signal it's disconnecting)
    delete $menu_structure->{providers}{$provider};
}

## Mark structure as changed
$menu_structure->{'last-changed'} = <[base.ntime.b32]>;

<[base.logs]>->( 1, "menu structure updated for provider '%s'", $provider );

return {
    'mode' => qw| true |,
    'data' => "menu updated for provider $provider"
};

