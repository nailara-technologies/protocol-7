## [:< ##

# name = data.mount.shm.open
# descr = Open SHM segment with cryptographic verification
#         Uses file-based SHM in /dev/shm (tmpfs) - portable

# thin zenka wrapper -> AMOS7::SHM::shm_open
# inject the zenka group registry [ %data slice ] for permission.verify ;
# the core stays branch-free by taking groups as a parameter

my $shm_path           = shift;
my $options            = shift // {};
my $requester_priv_key = shift;

$options->{'groups'} //= $data{'groups'};

return AMOS7::SHM::shm_open( $shm_path, $options, $requester_priv_key );

