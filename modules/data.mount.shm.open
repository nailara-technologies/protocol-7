## [:< ##

# name = data.mount.shm.open
# descr = Open SHM segment with cryptographic verification
#         Uses file-based SHM in /dev/shm (tmpfs) - portable

use constant SHM_HEADER_SIZE => 512;

my $shm_path           = shift;
my $options            = shift // {};
my $requester_priv_key = shift;

return undef unless defined $shm_path;

if ( $shm_path !~ m{^/} ) {
    $shm_path = "/dev/shm/p7:M:$shm_path";
}

my ( $pub_key, $sub_path )
    = <[data.mount.shm.open.parse_shm_path]>->($shm_path);
return undef unless defined $pub_key;

my $requested_rights = $options->{'rights'} // ['read'];

# Open file-based SHM
open( my $fh, '+<', $shm_path )
    or return { 'error' => 'open_failed', 'path' => $shm_path };
binmode($fh);

my $mmap_ref = <[data.mount.shm.open.mmap_file_read]>->($fh);
close($fh) unless defined $mmap_ref;

return { 'error' => 'segment_not_found', 'path' => $shm_path }
    unless defined $mmap_ref;

my $header = <[data.mount.shm.header.read]>->($mmap_ref);
return { 'error' => 'invalid_header' } unless defined $header;

return { 'error' => 'ownership_mismatch' }
    unless $header->{'owner_pubkey'} eq $pub_key;

my $requester_pubkey
    = <[data.mount.shm.open.derive_pubkey]>->($requester_priv_key);

my $has_access = <[data.mount.shm.permission.verify]>->(
    $header, $requester_pubkey, $sub_path // '',
    $requested_rights,
);

return { 'error' => 'access_denied' } unless $has_access;

return {
    'path'        => $shm_path,
    'pub_key'     => $pub_key,
    'sub_path'    => $sub_path,
    'mmap_ptr'    => $mmap_ref,
    'header'      => $header,
    'type'        => 'file',
    'data_offset' => SHM_HEADER_SIZE,
    'data_size'   => $header->{'data_size'},
    'requester'   => $requester_pubkey,
};

