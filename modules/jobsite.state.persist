## [:< ##

# name  = jobsite.state.persist
# descr = save scan state to disk, ensure index exists

my $state = {
    'cycle'           => <jobsite.cycle>                  // 'idle',
    'last_scan'       => <jobsite.last_scan>              // 0,
    'pending_count'   => <jobsite.pending_count>          // 0,
    'sync_last_ntime' => <jobsite.sync.last_server_ntime> // '',
};

my $yaml;
eval { $yaml = YAML::XS::Dump($state) };
if ($@) {
    <[base.logs]>->( 0, 'jss.persist: serialize error: %s', $@ );
    return FALSE;
}

my $written
    = <[file.zenka_dir.write]>->( 'scan-state.yaml', \$yaml, '>', 0640 );
if ( not defined $written ) {
    <[base.logs]>->( 0, 'jss.persist: write failed' );
    return FALSE;
}

## ensure index.yaml exists : rebuild if missing
my $index_file = '/var/protocol-7/jobsite/index.yaml';
if ( not -f $index_file ) {
    <[jobsite.index.rebuild]>;
}

return TRUE;

