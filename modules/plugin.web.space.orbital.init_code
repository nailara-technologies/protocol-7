## [:< ##

# name  = plugin.web.space.orbital.init_code
# descr = initialize orbital data endpoint cache and repeating fetch timer

## orbital data cache : populated by async fetch, read by json endpoint ##
<web.space.orbital.cache> = {
    qw| data            | => {},
    qw| timestamp       | => 0,
    qw| ttl             | => 13,
    qw| expected_fields | => [qw| self known connections gm_state |],
    qw| received_fields | => {},
};

## add nameserv to expected fields if configured ##
my $nameserv_domain = <nameserv.cfg.auto_publish_domain> // '';
if ( length $nameserv_domain ) {
    push <web.space.orbital.cache>->{'expected_fields'}->@*, qw| nameserv |;
}

## set up repeating fetch timer [ interval 13, repeat TRUE ] ##
## NOTE: only 'nameserv' is still polled here, everything else moved to ##
## STRM push below                                                      ##
<[event.add_timer]>->(
    {   qw| interval | => 13,
        qw| repeat   | => TRUE,
        qw| handler  | => qw| plugin.web.space.orbital.fetch |,
    }
);

## subscribe to each orbital producer's STRM push instead of polling it --
## deferred via <system.callbacks.initialized> : this init_code runs before
## this zenka's own cube session exists, so calling these directly here
## guarantees the first attempt fails (send.local: no clients in session)
## on every startup. Each subscribe_* function's own route-send + on-failure
## schedule_*_retry logic is left untouched -- still needed for the separate
## case of the *target* producer zenka not being up yet ##
push <system.callbacks.initialized>->@*,
    qw| plugin.web.space.orbital.subscribe_discover |,
    qw| plugin.web.space.orbital.subscribe_external |,
    qw| plugin.web.space.orbital.subscribe_nodes |,
    qw| plugin.web.space.orbital.subscribe_gm_state |;

<[base.log]>->( 2, qq| orbital data endpoint initialized | );

0;

