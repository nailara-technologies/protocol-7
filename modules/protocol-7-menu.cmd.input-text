## [:< ##

# name = protocol-7-menu.cmd.input-text
# param = [label_text]
# descr = Display styled text input dialog with optional label

return { 'mode' => qw| false |, 'data' => 'graphical mode not enabled' }
    unless <protocol-7-menu.init-graphical>;

my $label_text = $call->{'args'} // '';

# Suppress Gdk warnings during dialog creation
<[base.stderr_redir]>;

# Create dialog window
my $dialog = Gtk3::Window->new('popup');
$dialog->set_modal(1);
$dialog->set_keep_above(1);
$dialog->set_decorated(0);
$dialog->set_border_width(8);
$dialog->set_app_paintable(1);

# Apply styling
my $screen = $dialog->get_screen;
my $css_prov = Gtk3::CssProvider->new();
$css_prov->load_from_data(<<'EOT');
window { background-color:#000013; color:#0055CC; font-size:large }
entry { background-color:#000042; color:#0055CC; padding:4px; }
entry:focus { background-color:#001066; }
label { color:#0055CC; }
EOT
Gtk3::StyleContext::add_provider_for_screen( $screen, $css_prov, -1 );

# Create container
my $vbox = Gtk3::Box->new('vertical', 6);
$dialog->add($vbox);

# Add label if provided
if ($label_text) {
    my $label = Gtk3::Label->new($label_text);
    $label->set_halign('start');
    $vbox->pack_start($label, 0, 0, 0);
}

# Create entry field
my $entry = Gtk3::Entry->new();
$entry->set_placeholder_text('Enter text...');
$entry->set_size_request(300, -1);
$vbox->pack_start($entry, 0, 0, 0);

# Store result
my $result = '';
my $dialog_finished = 0;

# Handle Enter key
$entry->signal_connect( 'key-press-event' => sub {
    my ( $widget, $event ) = @ARG;
    if ( $event->keyval == 65293 ) {  # Return key
        $result = $entry->get_text;
        $dialog_finished = 1;
        $dialog->destroy;
        return 1;
    }
    return 0;
});

# Handle Escape key
$entry->signal_connect( 'key-press-event' => sub {
    my ( $widget, $event ) = @ARG;
    if ( $event->keyval == 65307 ) {  # Escape key
        $result = '';
        $dialog_finished = 1;
        $dialog->destroy;
        return 1;
    }
    return 0;
});

# Position near cursor
my $display = Gtk3::Gdk::Display::get_default();
my $seat = $display->get_default_seat();
my $pointer = $seat->get_pointer();
my ( $screen_ptr, $x, $y ) = $pointer->get_position();
$dialog->move( $x - 150, $y + 20 );

# Show and focus
$dialog->show_all;
$entry->grab_focus;

# Process events until dialog closes
while ( !$dialog_finished ) {
    <[event.once]>->(0.07);
    Gtk3::main_iteration_do(1);
}

# Restore stderr
<[base.stderr_restore]>;

# Return result
if ($result) {
    <[base.logs]>->( 1, "text input: %d chars", length($result) );
    return { 'mode' => qw| size |, 'data' => $result };
} else {
    return { 'mode' => qw| false |, 'data' => 'input cancelled' };
}

