# name  = pager.util.buffer.apply_filters
# descr = apply filter chain to pager items

my ( $buf, $items ) = @ARG;

for my $filter_spec ( @{ $buf->{'filters'} } ) {
    my $filter_type   = $filter_spec->{'type'};
    my $filter_params = $filter_spec->{'params'} // {};

    my $filter_mod = "pager.filter.$filter_type";
    if ( exists $data{'calls'}{$filter_mod} ) {
        $items = <[$filter_mod]>->(
            {   'items'  => $items,
                'params' => $filter_params,
            }
        );
    }
}

return $items;

