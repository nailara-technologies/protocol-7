## [:< ##

# name  = coding.cmd.wait-done
# descr = block until task completes, fails, or timeout
# param = <task_id> [timeout-seconds]

my $args_str = $call->{'args'} // '';
my ( $task_id, $timeout ) = split m{ +}, $args_str, 2;

## validate timeout (0 or undef = no timeout, wait indefinitely) ##
$timeout = defined $timeout ? int($timeout) : 0;
$timeout = 0 if $timeout < 0;

return { 'mode' => qw| false |, 'data' => 'task_id required' }
    unless defined $task_id and length $task_id;

my $task = <coding.task.queue>->{$task_id};

## task not found ##
return { 'mode' => qw| false |, 'data' => "task not found: $task_id" }
    unless defined $task;

my $status = $task->{'execution'}->{'status'} // 'unknown';

## task already completed ##
if ( $status eq qw| completed | ) {
    my $result = $task->{'execution'}->{'result'} // '';
    <[base.logs]>->( 1, "wait-done: %s already completed", $task_id );
    return { 'mode' => qw| true |, 'data' => $result };
}

## task already failed ##
if ( $status eq qw| failed | or $status eq qw| error | ) {
    my $error = $task->{'execution'}->{'error'} // 'unknown error';
    <[base.logs]>->(
        1,        "wait-done: %s already failed - %s",
        $task_id, $error
    );
    return { 'mode' => qw| false |, 'data' => "task failed: $error" };
}

## register deferred reply : coding.event.on_task_complete will fire it ##
$data{'coding'}{'deferred_replies'} //= {};
my $deferred_id = <[base.gen_id]>->( $data{'coding'}{'deferred_replies'} );

my $deferred = {
    'deferred_id' => $deferred_id,
    'reply_id'    => $call->{'reply_id'},
    'task_id'     => $task_id,
    'submitted'   => <[base.time]>->(3),
    'status'      => qw| waiting |
};

my $timeout_str = $timeout > 0 ? "${timeout}s" : "no timeout";
<[base.logs]>->(
    1, "wait-done: deferred reply %s for %s (timeout=%s)",
    $deferred_id, $task_id, $timeout_str
);

## optional timeout timer ##
if ( $timeout > 0 ) {
    my $timer = <[event.add_timer]>->(
        {   'after'   => $timeout,
            'repeat'  => FALSE,
            'handler' => qw| coding.handler.wait_done_timeout |,
            'data'    => {
                'deferred_id' => $deferred_id,
                'reply_id'    => $call->{'reply_id'},
                'task_id'     => $task_id,
            },
        }
    );
    $deferred->{'timeout_timer'} = $timer;
}

$data{'coding'}{'deferred_replies'}->{$deferred_id} = $deferred;

return { 'mode' => qw| deferred | };

