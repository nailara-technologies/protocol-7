# name  = channels.util.extract_json_path
# descr = Extract value from hash using dot notation JSON path
# args  = hash { data => ref, path => string }
# return = extracted value or undef

my ( $data, $path ) = ( shift, shift );
return undef unless defined $data and defined $path;

##  Strip leading dot  ##
$path =~ s|^\.||;
return undef unless length $path;

##  Split on dots (simple case, no array index support yet)  ##
my @keys = split( m|\.|, $path );

my $current = $data;
foreach my $key (@keys) {
    return undef unless defined $current;
    return undef unless ref $current eq qw| HASH |;
    return undef unless defined $current->{$key};

    $current = $current->{$key};
}

return $current;

