## [:< ##

# name  = test.iteration.hello
# descr = iteration loop test module [ hello ]

## read ntime as base32
my $ts = <[base.ntime.b32]>;

## return greeting with hello and timestamp
return { 'mode' => 'true', 'data' => "hello from test.iteration [ $ts ]" };

