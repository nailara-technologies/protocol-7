## [:< ##

# name  = storchencam.subscribe-screen-change
# descr = init callback: subscribe to X-11 screen-change STRM

<[base.log]>
    ->( 1, 'subscribing storchencam to X-11 screen-change events .,' );

<[protocol-7.route-send]>->(
    {   'command' => qw| X-11.subscribe-screen-change |,
        'reply'   => {
            'handler' => qw| storchencam.handler.screen-change_strm_open |,
        }
    }
);

return TRUE;

