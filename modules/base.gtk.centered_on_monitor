# name  = base.gtk.centered_on_monitor
# param = $monitor_rect, $width, $height
# descr = centre a window of the given size within a monitor rect, clamped
#         fully inside it [ shared fallback shaper for window-shaped zenki ].
#         returns ( x, y, width, height ).

my ( $mon, $w, $h ) = @ARG;

return undef
    if not defined $mon
    or not defined $w
    or not defined $h;

## never larger than the monitor ##
$w = $mon->{'width'}  if $w > $mon->{'width'};
$h = $mon->{'height'} if $h > $mon->{'height'};

my $x = $mon->{'x'} + int( ( $mon->{'width'} - $w ) / 2 );
my $y = $mon->{'y'} + int( ( $mon->{'height'} - $h ) / 2 );

return ( $x, $y, $w, $h );

