## [:< ##

# name    = cube.cmd.reply-encoding-mode
# descr   = set session SIZE response mode (SIZE or OCTETS)
#
# usage   : reply-encoding-mode <mode>
# modes   : SIZE (default, character count)
#           OCTETS (byte count)
#
# note    = controls SIZE vs OCTETS protocol header (SIZE protocol distinction)
#           transport-level encoding (base32, utf7, etc) belongs to link-upgrade
#           and is negotiated during encryption handshake (state 2)

my $session_id     = $call->{'session_id'};
my $requested_mode = $call->{'args'} // '';

$requested_mode = lc($requested_mode);
$requested_mode =~ s|\s+||g;    # Remove whitespace

my $session = $data{'session'}{$session_id};

## Validate requested mode
if ( $requested_mode =~ m|^size$| ) {

    ## SIZE mode (default): character count in responses
    $data{'session'}{$session_id}{'size_mode'} = qw| SIZE |;
    return {
        'mode' => qw| true |,
        'data' => "SIZE response mode set (character count)"
    };

} elsif ( $requested_mode =~ m|^octets$| ) {

    ## OCTETS mode: byte count in responses
    $data{'session'}{$session_id}{'size_mode'} = qw| OCTETS |;
    return {
        'mode' => qw| true |,
        'data' => "OCTETS response mode set (byte count)"
    };

} elsif ( $requested_mode =~ m|^$| ) {

    ## No mode specified - show current mode
    my $current_mode = $data{'session'}{$session_id}{'size_mode'} // qw| SIZE |;
    return {
        'mode' => qw| true |,
        'data' => "current SIZE mode: $current_mode"
    };

} else {

    ## Unknown mode
    return {
        'mode' => qw| false |,
        'data' => "unsupported mode: '$requested_mode' "
            . "[ supported : SIZE (default), OCTETS ]"
    };
}

1;

