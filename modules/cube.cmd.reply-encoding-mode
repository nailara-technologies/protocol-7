# name    = cube.cmd.reply-encoding-mode
# descr   = info command - SIZE mode always reports byte count with global 'use bytes;'
#
# usage   : reply-encoding-mode
# note    = SIZE mode now always reports BYTE count (with global 'use bytes;' pragma)
#           CHRSIZE mode reports CHARACTER count (UTF-8 aware)
#           This command is retained for backwards compatibility only

my $session_id     = $call->{'session_id'};
my $requested_mode = $call->{'args'} // '';

## SIZE mode now always uses bytes - OCTETS mode is deprecated and removed
## Clients should use SIZE for byte count and CHRSIZE for character count

if ( length($requested_mode) == 0 ) {
    ## No mode specified - show current behavior
    return {
        'mode' => qw| true |,
        'data' => "SIZE mode: byte count (global 'use bytes;' pragma) "
            . "| CHRSIZE mode: character count (UTF-8 aware)"
    };
} else {
    ## OCTETS mode no longer supported
    return {
        'mode' => qw| false |,
        'data' => "unsupported mode: '$requested_mode' "
            . "[ SIZE=bytes (default), CHRSIZE=characters, OCTETS mode removed ]"
    };
}

1;

