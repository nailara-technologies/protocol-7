## [:< ##

# name = models.cmd.statistics
# descr = Retrieve aggregated success statistics for a model in a context

# Command: models.statistics <amos> [context]
# Returns: { total_invocations, success_rate, avg_latency, by_context, ... }

sub execute_get_statistics {
  my ($model_amos, $context) = @_;

  return {
    'success' => FALSE,
    'error' => 'model AMOS required',
  } unless $model_amos;

  # Load registry
  my $registry_funcs = <[models.registry.init]>;
  my $model_entry = $registry_funcs->{get_model_entry}->($model_amos);

  return {
    'success' => FALSE,
    'error' => "model not found: $model_amos",
  } if $model_entry->{not_found};

  # If context specified, return context-specific stats
  if ($context) {
    my $context_stats = $model_entry->{statistics}->{by_context}->{$context};
    return {
      'success' => 1,
      'model_amos' => $model_amos,
      'model_name' => $model_entry->{metadata}->{name},
      'context' => $context,
      'invocations' => $context_stats->{invocations} // 0,
      'success_rate' => $context_stats->{success_rate} // 0,
      'avg_latency_ms' => $context_stats->{avg_latency_ms} // 0,
      'margin_vs_best_alt' => $context_stats->{margin_vs_best_alt} // 0,
      'ranking' => $context_stats->{ranking} // 0,
    };
  }

  # Return overall statistics
  return {
    'success' => 1,
    'model_amos' => $model_amos,
    'model_name' => $model_entry->{metadata}->{name},
    'total_invocations' => $model_entry->{statistics}->{total_invocations},
    'total_successful' => $model_entry->{statistics}->{total_successful},
    'success_rate' => $model_entry->{statistics}->{success_rate},
    'avg_latency_ms' => $model_entry->{statistics}->{avg_latency_ms},
    'p95_latency_ms' => $model_entry->{statistics}->{p95_latency_ms},
    'p99_latency_ms' => $model_entry->{statistics}->{p99_latency_ms},
    'failure_modes' => $model_entry->{statistics}->{failure_modes},
    'usage_by_period' => $model_entry->{statistics}->{usage_by_period},
    'first_invocation' => $model_entry->{statistics}->{first_invocation},
    'last_invocation' => $model_entry->{statistics}->{last_invocation},
  };
}

# Entry point
{
  my $cmd = shift @ARG;
  my @args = @ARG;

  if ($cmd eq 'statistics' || $cmd eq 'stats') {
    return execute_get_statistics(@args);
  }

  return {
    'success' => FALSE,
    'error' => "unknown command: $cmd",
  };
};

