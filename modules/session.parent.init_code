## [:< ##

# name = session.parent.init_code
# descr = Session startup auto-check for dependencies (smart, non-intrusive)

<[base.log]>->( 2, 'initializing session startup dependency checks..,' );

## Configuration
<session.cfg.auto_check_deps>     //= 1;      ## Check dependencies at startup
<session.cfg.auto_install_minimal> //= 1;      ## Auto-install minimal deps when unambiguous
<session.cfg.show_startup_zenka>   //= 1;      ## Show interactive helper when needed
<session.cfg.check_performed>      //= 0;      ## Track if check already done this session

## Statistics
<session.stats> = {
    checks_performed     => 0,
    auto_installs        => 0,
    startup_zenka_shown  => 0,
    deps_satisfied       => 0
};

<[base.log]>->( 2, 'session startup dependency checks initialized' );

0;

