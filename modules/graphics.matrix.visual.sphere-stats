## [:< ##

# name  = graphics.matrix.visual.sphere-stats
# desc  = Calculate statistics for a sphere of images

my $images = shift // [];

my $sum_pixels       = 0;
my $unique_checksums = {};

for my $img (@$images) {
    $sum_pixels += $img->{'pixels'} // 0;
    $unique_checksums->{ $img->{'checksum'} } = 1 if $img->{'checksum'};
}

my $n = scalar(@$images);

return {
    'total_pixels'     => $sum_pixels,
    'avg_size'         => $n ? int( $sum_pixels / $n ) : 0,
    'unique_checksums' => scalar( keys %$unique_checksums ),
};

