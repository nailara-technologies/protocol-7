# name  = context.util.template.substitute_vars
# descr = substitute {{var}} placeholders in provider params hashref

my ( $params_ref, $v ) = @_;

foreach my $key ( keys $params_ref->%* ) {
    next unless defined $params_ref->{$key};
    next if ref $params_ref->{$key};
    $params_ref->{$key} =~ s|\{\{(\w[\w.]*)\}\}|
        defined $v->{$1} ? $v->{$1} : ''
    |ge;
}

return;

