## [:< ##

# name  = user-edit.form.submit
# descr = stage the edited values, then push them to the users zenka

## ORDER MATTERS [ local_edit_outbox ] : for an ordinary form the outbox write
## is durable and happens BEFORE the users.value-set attempt, so if the users
## zenka is unreachable — or this process dies between the two — the edit
## survives on disk rather than being lost to a failed network call.  the
## outbox entry is cleared only once the zenka confirms the write.
##
## ONE EXCEPTION, and it is deliberate : a form holding a masked field is
## never staged at all, and refuses to submit while offline.  display masking
## is not confidentiality — the outbox stores clear text — and a partial entry
## would be worse than none, since a later retry would push a record with the
## secret blanked and silently destroy it.  see the two guards below.

my $editor_state = <user-edit.form.state>;
return FALSE if ref $editor_state ne qw| HASH |;

my $username = <user-edit.form.username> // return FALSE;

## COLLAPSE FIRST, unconditionally.  Enter submits from ANY field [
## editor.control.process_key ], and submitting while a list is expanded would
## collect '<field>_0', '<field>_1' as separate top-level record fields and
## permanently replace the array.  collapse is a no-op when nothing is
## expanded, so this is safe to call every time
my $collapsed = <[editor.control.list.collapse]>->($editor_state);

if ( $collapsed != $editor_state ) {
    <user-edit.form.state> = $editor_state = $collapsed;
    <[user-edit.form.build_frame]>->(
        $collapsed->{'schema'},
        <user-edit.form.frame_name> // qw| user-edit-form |,
        <user-edit.form.title>
    );
}

my @masked_fields = <[editor.control.masked_field_names]>->($editor_state);

## CHECKED BEFORE editor.control.submit ON PURPOSE : submit RESETS the fields
## on success, so refusing afterwards would destroy what the user just typed.
## a form holding a secret is not allowed to fall back to plaintext outbox
## staging, so if the users zenka is unreachable we stop here with the form
## still intact rather than dropping the secret silently or writing it to disk
## in clear
if (@masked_fields) {
    my ($check_sid) = keys <user.cube.session>->%*;
    if ( not defined $check_sid or not exists $data{'session'}{$check_sid} ) {
        print "\n  << not sent : this form contains a secret and the users "
            . "zenka\n     is unreachable — secrets are never staged "
            . "in clear text >>\n\n";
        STDOUT->flush();
        <user-edit.form.dirty>++;    ## repaint over the message ##
        return FALSE;
    }
}

my $result = <[editor.control.submit]>->($editor_state);

if ( ref $result ne qw| HASH | or not $result->{'ok'} ) {
    ## validator rejected : editor.control.submit deliberately does NOT reset
    ## the fields in this case, so the user's input is still there
    my $errors = $result->{'errors'} // {};
    print sprintf( "\n  << %s : %s >>\n", $ARG, $errors->{$ARG} // 'invalid' )
        foreach sort keys %{$errors};
    STDOUT->flush();
    <user-edit.form.dirty>++;    ## repaint over the message ##
    return FALSE;
}

my $values = $result->{'values'} // {};

## SYNTHESISED ROWS ARE NOT FIELDS and must never reach storage.  the
## add-a-field row is an ACTION, not data -- editor.control.submit collects
## every schema field, so without this it is stored as '_add_field: ""',
## becomes a real record field, sorts to the front of the form and then blocks
## a fresh row from ever being offered again
foreach my $field_def ( ( $editor_state->{'schema'}{'fields'} // [] )->@* ) {
    my $name = $field_def->{'name'} // next;
    delete $values->{$name} if $field_def->{'add_field'};
}

## list fields submit their ARRAY, not the buffer string : the buffer is empty
## for a collapsed list, and 'entries' is what holds the value
foreach my $field_def ( ( $editor_state->{'schema'}{'fields'} // [] )->@* ) {
    next if not $field_def->{'list'};
    my $name = $field_def->{'name'} // next;
    $values->{$name} = [ ( $field_def->{'entries'} // [] )->@* ];
}

## durable staging first -- EXCEPT when the form holds a secret.  a partial
## outbox entry would be worse than none : a later retry would push a record
## with the secret field blanked, silently destroying it.  so a masked form is
## never staged at all, and the reachability check above has already
## guaranteed the zenka is there to send to
<user-edit.form.staged> = FALSE;

if ( not @masked_fields ) {

    my ( $staged, $stage_err )
        = <[user-edit.outbox.write]>->( $username, $values );

    if ( not $staged ) {
        print sprintf( "\n  << could not stage edit locally : %s >>\n\n",
            $stage_err // 'unknown error' );
        STDOUT->flush();
        return FALSE;
    }

    <user-edit.form.staged> = TRUE;
}

my ($cube_sid) = keys <user.cube.session>->%*;

if ( not defined $cube_sid or not exists $data{'session'}{$cube_sid} ) {
    print "\n  << offline : edit staged in the outbox, not yet sent >>\n\n";
    STDOUT->flush();
    <[user-edit.form.quit]>;
    return TRUE;
}

## call_args.data is NOT transmitted over routes — only args, as a string.
## users.cmd.value-set splits '<username> <json-fields>' with a /s-flagged
## (.*) capture, so a json object with spaces survives intact as one arg.
##
## format.json.encode is pretty(1), i.e. MULTI-LINE — which the line-based
## wire would truncate.  flattening is safe rather than lossy : json escapes a
## literal newline inside a string value as '\n' [ two characters ], so a real
## newline byte only ever occurs as pretty-printer formatting.  verified
## round-trip against values containing spaces, double quotes and embedded
## newlines
my $json_fields = <[format.json.encode]>->($values);
$json_fields =~ s|\n\s*||g;

<[protocol-7.command.send.local]>->(
    {   qw| command |   => sprintf( '%d.users.value-set', $cube_sid ),
        qw| call_args | =>
            { qw| args | => sprintf( '%s %s', $username, $json_fields ) },
        qw| reply | =>
            { qw| handler | => qw| user-edit.handler.value_set_reply | }
    }
);

return TRUE;

