# name  = base.handler.read.encoding-wrapper
# descr = decoding wrapper for transport-layer encoding modes (utf7, base32, base32-xz)
#         transforms encoded input buffer back to plaintext before command processing
#
# installed_by = base.handler.link-upgrade during state 2 negotiation
# link_layer = transport-level encoding negotiated during link-upgrade handshake
# modes = utf7 (7-bit safe), base32 (5-bit safe linewise), base32-xz (compressed + encoded)
#
# note  = operates on session buffer, does not cut data (no rewatcher trigger)
#         preserves return code from original handler

my $event = shift;
my $session_id = $event->w->data;
my $session = $data{'session'}{$session_id};

## Get original handler reference (saved before wrapper installation)
my $original_handler = $session->{'input'}->{'handler_original'}
    // qw| base.handler.command |;

## Call original handler (processes protocol commands on decoded data)
my $ret_code = $code{$original_handler}->($event);

## Apply decoding to input buffer based on link-layer encoding mode
## Set during link-upgrade negotiation (state 2)
## Only if mode is set (default: no encoding wrapper installed)
if ( defined $session->{'link_encoding_mode'} ) {
    my $mode = $session->{'link_encoding_mode'};
    my $input_ref = \$session->{'buffer'}->{'input'};

    ## BASE32 modes: decode from 5-bit safe alphabet back to binary
    if ( $mode =~ m|^base32$| ) {
        if ( length $$input_ref ) {
            $$input_ref = Crypt::Misc::decode_b32r($$input_ref);
        }
    }
    ## BASE32-XZ: decompress after base32 decode
    elsif ( $mode =~ m|^base32-xz$| ) {
        if ( length $$input_ref ) {
            my $decoded = Crypt::Misc::decode_b32r($$input_ref);
            if ( defined $decoded and length $decoded ) {
                $$input_ref = Compress::Raw::Lzma::decompress($decoded);
            }
        }
    }
    ## UTF-7: 7-bit safe ASCII encoding (future)
    elsif ( $mode =~ m|^utf7$| ) {
        if ( length $$input_ref ) {
            # UTF-7 decoding logic placeholder
            # Implementation depends on specific UTF-7 variant used
        }
    }
}

return $ret_code;

1;

