## [:< ##

# name  = base.strm.local.register
# descr = register a local STRM consumer for a cmd_id
# param = $cmd_id, \%opts  [ watcher=>, on_eof=>, max_buf=> ]

my $cmd_id = shift;
my $opts   = shift // {};

return <[base.logs]>->( 1, '[strm.local] register: missing cmd_id' )
    if not defined $cmd_id or $cmd_id !~ m|^\d+$|;

<base.strm.local> //= {};

## duplicate-slot guard : a second claimant on an active, unclosed slot ##
## is an anomaly [ e.g. multi-reply fan-out collision ] -- log loudly   ##
## and refuse rather than silently clobbering the first watcher         ##
if ( exists <base.strm.local>->{$cmd_id} ) {
    <[base.logs]>->(
        0,
        '[strm.local] REFUSED duplicate registration for cmd_id %d'
            . ' [ slot active : %d bytes, started %.3f ]',
        $cmd_id,
        <base.strm.local>->{$cmd_id}->{'bytes'}   // 0,
        <base.strm.local>->{$cmd_id}->{'started'} // 0
    );
    return FALSE;
}

<base.strm.local>->{$cmd_id} = {
    'buf'     => '',
    'bytes'   => 0,
    'started' => <[base.time]>->(3),
    'watcher' => $opts->{'watcher'},
    'on_eof'  => $opts->{'on_eof'},
    'max_buf' => $opts->{'max_buf'} // 0,
};

<[base.logs]>->( 2, '[strm.local] registered consumer cmd_id %d', $cmd_id );

return TRUE;

