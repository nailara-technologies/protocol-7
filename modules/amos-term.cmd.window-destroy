# name  = amos-term.cmd.window-destroy
# descr = Destroy window and cleanup buffer

my $amos_id = shift;

return {
    qw| mode | => qw| immediate |,
    qw| data | => "Error: AMOS ID required\n"
    }
    unless defined $amos_id;

my $result = <[amos-term.window-destroy]>->("amos:$amos_id");

return {
    qw| mode | => qw| immediate |,
    qw| data | =>
        ( $result ? "Window destroyed\n" : "Error: destroy failed\n" )
};

