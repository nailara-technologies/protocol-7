# name  = amos-term.cmd.window-destroy
# descr = Destroy window and cleanup buffer

my $amos_id = shift;

return "Error: AMOS ID required\n" unless defined $amos_id;

my $result = <[amos-term.window-destroy]>->("amos:$amos_id");

return $result ? "Window destroyed\n" : "Error: destroy failed\n";

