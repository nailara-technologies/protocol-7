## [:< ##

# name  = base.chk-sum.bmw.cmd.bmw-L13
# param = <input-sring>
# descr = return BMW-L13 chksum for given input string

return {
    'mode' => qw| false |,
    'data' => 'expected input string to chksum'
    }
    if not defined $call->{'args'};

return {
    'mode' => qw| true |,
    'data' => <[chk-sum.bmw.L13-str]>->( $call->{'args'} )
};

