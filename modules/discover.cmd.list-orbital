## [:< ##

# name  = discover.cmd.list-orbital
# descr = list all known orbital addresses
#
# notes = args 'subscribe' opens a STRM push channel instead, fed by
#         discover.orbital.store_remote

if ( defined $call->{'args'} and $call->{'args'} eq qw| subscribe | ) {
    return { 'mode' => qw| false |, 'data' => 'orbital push disabled' }
        unless <[base.cfg_bool]>->(<discover.cfg.orbital_push_enabled>);

    my $h = <[base.stream.open]>->(
        {   'sid'    => $call->{'session_id'},
            'cmd_id' => $call->{'command_id'},
            'type'   => qw| STRM |,
            'total'  => undef,
        }
    );
    return { 'mode' => qw| false |, 'data' => 'stream open refused' }
        if not defined $h;

    <discover.orbital.listeners> //= [];
    push @{<discover.orbital.listeners>}, $h;
    <[base.logs]>->(
        2, 'orbital listener added [sid=%d]',
        $call->{'session_id'}
    );

    ## push the current snapshot immediately : a fresh subscriber otherwise ##
    ## sees nothing until the next store_remote mutation, which may be a   ##
    ## long time away for an already-populated known list.                 ##
    my $known = <discover.orbital.known> // {};
    for my $id ( <[base.sort]>->($known) ) {
        my $entry = $known->{$id};
        my $age   = sprintf qw| %.1fs |,
            <[base.time]>->(5) - $entry->{'timestamp'};
        my $pkey_short
            = substr( Crypt::Misc::encode_b32r( $entry->{'pkey'} ), 0, 7 );
        my $payload = sprintf "%s %s %s %s\n", $entry->{'hostname'},
            $pkey_short, $entry->{'p7ref'}, $age;
        <[base.stream.push]>->( $h, \$payload );
    }

    return { 'mode' => qw| deferred | };
}

<discover.orbital.known> //= {};

my $known = <discover.orbital.known>;
my @keys  = <[base.sort]>->($known);

return { 'mode' => qw| true |, 'data' => 'no orbital addresses known' }
    unless @keys;

my $output = "\n";
my $fmt    = "%-20s %-10s %-30s %-10s\n";
$output .= sprintf $fmt, qw| hostname pkey p7ref age |;
$output .= '-' x 75 . "\n";

foreach my $id (@keys) {
    my $entry = $known->{$id};
    my $age = sprintf qw| %.1fs |, <[base.time]>->(5) - $entry->{'timestamp'};
    my $pkey_short
        = substr( Crypt::Misc::encode_b32r( $entry->{'pkey'} ), 0, 7 );
    $output .= sprintf $fmt,
        $entry->{'hostname'}, $pkey_short, $entry->{'p7ref'}, $age;
}

return { 'mode' => qw| size |, 'data' => $output };

