## [:< ##

# name  = radio.cmd.listen
# descr = register caller as unbounded STRM stream listener

my $call_args = shift;

my $sid    = $call_args->{'session_id'};
my $cmd_id = $call_args->{'command_id'};

my $h = <[base.stream.open]>->(
    {   sid    => $sid,
        cmd_id => $cmd_id,
        type   => qw| STRM |,
        total  => undef,
    }
);

if ( not defined $h ) {
    <[base.callback.cmd_reply]>->(
        $call_args->{'reply_id'},
        {   'mode' => qw| false |,
            'data' => 'stream open refused [ session gone ]'
        }
    );
    return;
}

push <radio.listeners>->@*, $h;

<[base.logs]>->(
    2,    '[radio] listener added [sid=%d cmd_id=%d]',
    $sid, $cmd_id
);

return { 'mode' => qw| deferred | }

