## [:< ##

# name  = credential_fabric.request-authorization
# descr = on-demand auth relay flow. when no credential exists for a domain,
#         request user authorization via the web-browser zenka.
#         args: { domain => '...', context => $ctx }

my $params = shift;

return { 'mode' => qw| false |, 'data' => 'expected hashref' }
    if ref $params ne qw| HASH |;

my $domain  = $params->{'domain'}  // '';
my $context = $params->{'context'} // {};

return { 'mode' => qw| false |, 'data' => 'missing domain' }
    unless length $domain;

## generate a pending request id ##
my $req_id = <[base.gen_id]>->( $data{'route'}, undef, undef, 0 );

<credential_fabric.auth_relay_pending>->{$req_id} = {
    'domain'  => $domain,
    'context' => $context,
    'ntime'   => <[base.time]>->(3),
};

## route auth approval dialog to web-browser zenka ##
<[protocol-7.route-send]>->(
    {   'command'   => 'web-browser.dialog.show',
        'call_args' => {
            'args' => YAML::XS::Dump(
                {   'type'   => 'auth_approval',
                    'domain' => $domain,
                    'req_id' => $req_id,
                }
            )
        },
        'reply' => {
            'handler' => 'credential_fabric.handler.auth-relay-reply',
            'params'  => { 'req_id' => $req_id }
        },
    }
);

return {
    'mode'   => qw| pending |,
    'data'   => 'awaiting user authorization',
    'req_id' => $req_id,
};

