# name = web.assets.load_registry
# descr = load asset registry from YAML file generated by validator

use YAML::Tiny;

my $project_root  = $ENV{PROJECT_ROOT} || '/data/projects/protocol-7';
my $registry_file = "$project_root/var/httpd/static/.asset-registry.yaml";

<[base.log]>->(
    2, 'web.assets.load_registry: loading from ' . $registry_file
);

## Check if registry file exists ##
unless ( -f $registry_file ) {
    <[base.log]>->(
        1,
        'web.assets.load_registry: registry file not found - run validator first'
    );
    return FALSE;
}

## Load YAML ##
my $yaml = eval { YAML::Tiny->read($registry_file) };

if ($EVAL_ERROR) {
    <[base.log]>->( 0, "web.assets.load_registry: YAML parse error: $EVAL_ERROR" );
    return FALSE;
}

unless ( $yaml and $yaml->[0] ) {
    <[base.log]>
        ->( 0, 'web.assets.load_registry: empty or invalid registry' );
    return FALSE;
}

my $data = $yaml->[0];

## Load statistics ##
if ( $data->{stats} ) {
    <web.assets.stats> = $data->{stats};
    <[base.log]>->(
        2,
        sprintf( 'web.assets.load_registry: loaded stats - %d total assets',
            <web.assets.stats>->{total_assets} )
    );
}

## Load asset registry ##
if ( $data->{assets} ) {
    <web.assets.registry> = $data->{assets};

    my $count = scalar( keys %{<web.assets.registry>} );
    <[base.log]>->(
        2, "web.assets.load_registry: loaded $count asset entries"
    );

    ## Update statistics ##
    <web.assets.stats>->{total_assets}   = $count;
    <web.assets.stats>->{assets_present} = 0;
    <web.assets.stats>->{assets_missing} = 0;
    <web.assets.stats>->{assets_copied}  = 0;

    ## Count by status ##
    foreach my $path ( keys %{<web.assets.registry>} ) {
        my $status = <web.assets.registry>->{$path}{status};

        if ( $status eq 'present' ) {
            <web.assets.stats>->{assets_present}++;
        } elsif ( $status eq 'missing' ) {
            <web.assets.stats>->{assets_missing}++;
        } elsif ( $status eq 'copied' ) {
            <web.assets.stats>->{assets_copied}++;
        }
    }
}

<[base.log]>->( 2, 'web.assets.load_registry: registry loaded successfully' );

return TRUE;

