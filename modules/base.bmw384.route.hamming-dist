## [:< ##

# name  = base.bmw384.route.hamming-dist
# args  = $bits_a, $bits_b
# descr = count differing bits between two 360-char angle bitstrings

my $bits_a = shift;
my $bits_b = shift;

if ( not defined $bits_a or not defined $bits_b ) {
    <[base.logs]>->( 1, 'both bit strings required <{C1}>' );
    return undef;
}

my $dist = 0;
for my $ARG ( 0 .. 359 ) {
    $dist++ if substr( $bits_a, $ARG, 1 ) ne substr( $bits_b, $ARG, 1 );
}

return $dist;

