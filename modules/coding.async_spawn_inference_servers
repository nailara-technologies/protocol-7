# name  = coding.async_spawn_inference_servers
# descr = asynchronously spawn inference servers at startup
# purpose = Start GPU and CPU inference servers without blocking zenka initialization

<[base.logs]>->(
    1, "[async_spawn_inference_servers] starting inference servers asynchronously"
);

# Get spawn parameters
my $spawn_params = $data{'coding.spawn_params'} // {};

# Spawn GPU server if enabled
if ( $spawn_params->{'gpu_enabled'} ) {
    my $gpu_port = 8002;
    my $gpu_model = $spawn_params->{'gpu_model_id'} // 'gemma3-glitter-4b';

    <[base.logs]>->(
        1, "[async_spawn_inference_servers] spawning GPU server on port %d for %s",
        $gpu_port, $gpu_model
    );

    my $gpu_result = <[coding.inference.spawn-server]>->( $gpu_port, 'gpu' );

    if ( $gpu_result->{success} ) {
        <[base.logs]>->(
            1, "[async_spawn_inference_servers] GPU server started (pid=%d)",
            $gpu_result->{pid}
        );
        $data{'inference.gpu_port'} = $gpu_port;
        $data{'inference.gpu_pid'} = $gpu_result->{pid};
    } else {
        <[base.logs]>->(
            0, "[async_spawn_inference_servers] GPU server failed: %s",
            $gpu_result->{error}
        );
    }
}

# Note: CPU server spawning can be added here if needed for fallback
# For now, focus on GPU server

<[base.logs]>->(
    1, "[async_spawn_inference_servers] inference server spawning complete"
);

return TRUE;

