## [:< ##

# name  = coding.async_spawn_inference_servers
# descr = asynchronously spawn inference servers at startup
# purpose = Start GPU and CPU inference servers without blocking zenka initialization

<[base.logs]>->( 1, ": starting inference servers asynchronously" );

# Get spawn parameters
my $spawn_params = <coding.spawn_params> // {};

if ( not keys $spawn_params->%* ) {
    warn 'expected spawn parameters not found [cannot start server]';
    return FALSE;
}

## Resolve model path from models zenka for configured AMOS ID
my $model_amos_id = $data{'inference.model.amos_id'} // '';
my $model_path = undef;

if ( defined $model_amos_id && length $model_amos_id ) {
    <[base.logs]>->( 1, ": resolving model path for amos_id=%s", $model_amos_id );

    ## Request model path from models zenka via network (route through cube)
    my $models_response = <[base.protocol-7.command.send.local]>->(
        'cube.models.get_model_path_by_checksum', $model_amos_id
    );

    if ( ref($models_response) eq 'HASH' && $models_response->{'mode'} eq 'true' ) {
        $model_path = $models_response->{'data'};
        <[base.logs]>->(
            1, ": model path resolved: %s",
            $model_path
        );
        $data{'inference.model.path'} = $model_path;
    } else {
        <[base.logs]>->(
            0, ": failed to resolve model path: %s",
            $models_response->{'data'} // 'unknown error'
        );
        return FALSE;
    }
} else {
    <[base.logs]>->( 0, ': no model amos_id configured' );
    return FALSE;
}

# Spawn GPU server if enabled
if ( $spawn_params->{'gpu_enabled'} ) {
    my $gpu_port  = 8002;
    my $gpu_model = $spawn_params->{'gpu_model_id'} // qw|gemma3-glitter-4b|;

    <[base.logs]>->(
        1,         ": spawning GPU server on port %d for %s",
        $gpu_port, $gpu_model
    );

    my $gpu_result = <[coding.inference.spawn-server]>->( $gpu_port, 'gpu', $model_path );

    if ( $gpu_result->{'success'} ) {
        <[base.logs]>->(
            1, ": GPU server started [pid=%d]",
            $gpu_result->{'pid'}
        );
        $data{'inference.gpu_port'} = $gpu_port;
        $data{'inference.gpu_pid'}  = $gpu_result->{'pid'};
    } else {
        <[base.logs]>->( 0, 'GPU server failed : %s', $gpu_result->{error} );
        return FALSE;    ## spawning not successful ##
    }
}

# Note: CPU server spawning can be added here if needed for fallback
# For now, focus on GPU server

<[base.logs]>->( 1, ": inference server spawning complete" );

return TRUE;

