# name  = nshell.clear_terminal
# descr = clear terminal screen and initialize cursor on successful connection

## Initialize and display cursor immediately (before interactive input loop)
## %colors is available from zenka context (initialized in nshell.init_code)
my $cursor_color = $colors{p7_fg_0003}
    // $AMOS7::TERM::p7_colors{'p7_fg_0003'};
my $text_color = $colors{p7_fg_0004} // $AMOS7::TERM::p7_colors{'p7_fg_0004'};

## Set text color and display initial cursor
print STDOUT $text_color;
print STDOUT $cursor_color . '_' . "\e[0m" . $text_color;
STDOUT->flush();

