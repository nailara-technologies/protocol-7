# name  = nshell.clear_terminal
# descr = clear terminal screen on successful connection

## clear screen on connection success ##
printf STDERR "%s\r", $colors{'clear_screen'};

## Print newline and restore text color
## Real cursor will be initialized by nshell.read_from_buffer on first call
say STDERR $colors{'p7_fg_0004'};

