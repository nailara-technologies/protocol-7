# name  = nshell.clear_terminal
# descr = clear terminal screen and print experimental connection cursor

## clear screen on connection success ##
printf STDERR "%s\r", $colors{'clear_screen'};

## print blinking phosphor _ + \n in interactive mode when fully connected ##
say STDERR $colors{'p7_fg_0003'} . "\e[5m_\e[0m" . $colors{'p7_fg_0004'};

