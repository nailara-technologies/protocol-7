## [:< ##

# name  = base.file.write
# descr = write string content to file [ wrapper for file.write_encoded ]

my $path     = shift // '';
my $content  = shift // '';
my $encoding = shift // qw| :encoding(UTF-8) |;

return FALSE unless length $path;

return <[file.write_encoded]>->( $encoding, $path, $content );

