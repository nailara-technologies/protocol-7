## [:< ##

# name  = coding.self_test.follow_up
# descr = re-prompt model to explain reasoning for mismatched answer

my $params   = shift                 // {};
my $model_id = $params->{'model_id'} // '';
my $prompt   = $params->{'prompt'}   // '';
my $answer   = $params->{'answer'}   // '';
my $timeout  = $params->{'timeout'}  // 30;

return { mode => qw| false |, data => 'model_id required' }
    if !length $model_id;

my $server_url = <inference.backend.http_server_url>
    // 'http://127.0.0.1:8000';

## replay original question + answer, then ask for reasoning ##
my $follow_prompt;
if ( length $prompt && length $answer ) {
    $follow_prompt = "For the question '$prompt', you answered '$answer'. "
        . "Explain your reasoning for that answer, step by step.";
} else {
    $follow_prompt = 'Explain your reasoning for that answer, step by step.';
}

my $result = <[coding.tools.http_inference_client]>->(
    {   url      => $server_url,
        model_id => $model_id,
        prompt   => $follow_prompt,
        timeout  => $timeout,
    }
);

if ( !$result || $result->{'mode'} ne qw| true | ) {
    <[base.logs]>->(
        1,         '[self_test] follow_up : model %s : %s',
        $model_id, $result->{'data'} // 'no reply'
    );
    return { mode => qw| false |, data => 'follow_up_failed' };
}

<[base.logs]>->(
    2, '[self_test] follow_up : model %s : explained', $model_id
);

return { mode => qw| true |, data => $result->{'data'} // '' };

