## [:< ##

# name  = branch.route.key.handler.reply
# descr = receive pubkey reply from discover.key.request

my $reply = shift // {};

my $mode   = $reply->{'mode'}   // '';
my $raw    = $reply->{'data'}   // '';
my $params = $reply->{'params'} // {};

my $node_id  = $params->{'node_id'}  // '';
my $route_id = $params->{'route_id'} // '';

return unless length $node_id and length $route_id;

if ( lc($mode) eq qw| false | ) {
    <[base.logs]>->(
        0,         'branch.route.key.handler.reply: failed for %s on %s',
        $route_id, $node_id
    );
    return;
}

my $pubkey = ref $raw ? $raw->$* : $raw;

return unless length $pubkey;

## store key in node registry and route ##
$data{'branch.nodes'}{$node_id}{'pubkey'} = $pubkey;

if ( exists $data{'branch.routes'}{$route_id} ) {
    $data{'branch.routes'}{$route_id}{'keys'}{$node_id} = $pubkey;
}

<[base.logs]>->(
    2,         'branch.route.key.handler.reply: %s key for %s received',
    $route_id, $node_id
);

## re-check route completeness ##
<[branch.route.key.propagate]>->( { 'route_id' => $route_id } );

