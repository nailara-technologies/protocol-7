## [:< ##

# name  = job-site-scan.dispatch.next
# descr = dispatch next assessment task from queue

my $queue = <job-site-scan.assess_queue> // [];

if ( not @{$queue} ) {
    <[base.logs]>->( 1, 'jss: assessment queue empty, waiting for results' );
    return;
}

my $entry  = shift @{$queue};
my $job_id = $entry->{'job_id'};
my $desc   = $entry->{'desc'};

<[base.logs]>->(
    1,       'jss: dispatching assessment for job %s (%d remaining)',
    $job_id, scalar @{$queue}
);

## encode multiline args as base32 to avoid protocol framing issues
my $encoded = ':B32:' . encode_b32r( Encode::encode( 'UTF-8', $desc ) );

<[protocol-7.route-send]>->(
    {   'command'   => 'task.create',
        'call_args' => { 'args' => $encoded },
        'reply'     => {
            'handler' => 'job-site-scan.handler.task-created',
            'params'  => { 'job_id' => $job_id },
        },
    }
);

