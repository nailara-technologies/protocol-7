## [:< ##

# name  = site-yaml.jobs.upsert
# descr = insert or update a job record; returns 'new'/'updated'/'exists'

my $job = $ARG[0]      // {};
my $id  = $job->{'id'} // '';
return 'no_id' if not length $id;

## never resurrect blocked or deleted jobs ##
my $idx_status = <jobsite.job.index>->{$id} // '';
if ( $idx_status =~ m{^(blocked|deleted)(:|$)} ) {
    <[base.logs]>->(
        2,   'jobs.upsert: skipping %s (status %s)',
        $id, $idx_status
    );
    return 'exists';
}

my $store = $data{'jobs'}{'store'};

my $is_new = 0;
if ( exists $store->{$id} ) {
    ## preserve status and score set by user or LLM
    my $existing = $store->{$id};
    for my $key (qw| status score score_reason applied_at |) {
        $job->{$key} = $existing->{$key} if defined $existing->{$key};
    }
    $store->{$id} = $job;
} else {
    ## new job : set defaults
    $job->{'status'} //= 'new';
    $job->{'score'}  //= '';
    $job->{'fetched_at'} = time;
    $store->{$id}        = $job;
    $is_new              = 1;
}

## write per-job file
<[jobsite.job.write]>->( $id, $store->{$id} );

return $is_new ? 'new' : 'updated';

