## [:< ##

# name  = site-yaml.jobs.upsert
# descr = insert or update a job record; returns 'new'/'updated'/'exists'

my $job = $ARG[0]      // {};
my $id  = $job->{'id'} // '';
return 'no_id' if not length $id;

my $store = $data{'jobs'}{'store'};

if ( exists $store->{$id} ) {
    ## preserve status and score set by user or LLM
    my $existing = $store->{$id};
    for my $key (qw| status score score_reason applied_at |) {
        $job->{$key} = $existing->{$key} if defined $existing->{$key};
    }
    $store->{$id} = $job;
    return 'updated';
}

## new job — set defaults
$job->{'status'} //= 'new';
$job->{'score'}  //= '';
$job->{'fetched_at'} = time;
$store->{$id} = $job;
return 'new';

