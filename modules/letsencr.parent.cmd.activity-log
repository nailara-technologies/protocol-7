## [:< ##

# name  = letsencr.parent.cmd.activity-log
# param = [filter] [limit]
# descr = display recent ACME operation activity log with optional filtering

my $filter = shift;         ## optional: filter by operation or domain
my $limit  = shift // 50;   ## optional: limit number of entries (default: 50)

<[base.log]>->( 2, "activity-log command: filter=$filter, limit=$limit" );

## Read activity buffer
unless ( defined $data{'buffer'}{'acme-activity'} ) {
    return {
        mode => 'true',
        data => 'Activity log is empty (no acme-activity buffer found)'
    };
}

my @lines = @{ $data{'buffer'}{'acme-activity'}{'data'} };

unless (@lines) {
    return {
        mode => 'true',
        data => 'Activity log is empty'
    };
}

## Filter lines if filter pattern provided
my @filtered_lines;
foreach my $line (@lines) {
    if ($filter) {
        ## Filter by domain, operation, or status
        if ( $line =~ /acme activity.*:?\s+($filter|\w*$filter\w*)/i ) {
            push @filtered_lines, $line;
        }
    } else {
        push @filtered_lines, $line;
    }
}

## Limit output and reverse to show newest first
@filtered_lines = reverse( @filtered_lines[ 0 .. ( $limit - 1 ) ] )
    if @filtered_lines > 0;

## Build formatted output
my $output = "ACME Activity Log\n";
$output .= "================\n\n";

if ( @filtered_lines == 0 ) {
    $output .= "No activity log entries";
    if ($filter) {
        $output .= " matching: $filter";
    }
    $output .= "\n";

    return {
        mode => 'true',
        data => $output
    };
}

$output .= sprintf( "%-8s %-20s %-15s %-10s %s\n",
    'Time', 'Operation', 'Domain', 'Status', 'Details' );
$output .= "-" x 80 . "\n";

foreach my $line (@filtered_lines) {
    ## Parse timestamp and message from buffer line
    if ( $line
        =~ /^(\d{2}:\d{2}:\d{2})\s+(\d+)\s+:\s+acme\s+activity\s+:\s+(\S+)\s+:\s+(\S+)\s+:\s+(\S+)\s*(.*)?$/
    ) {
        my $time    = $1;
        my $level   = $2;
        my $op      = $3;
        my $domain  = $4;
        my $status  = $5;
        my $details = $6 // '';

        ## Truncate long details
        $details = substr( $details, 0, 40 ) . '...'
            if length($details) > 40;

        $output .= sprintf( "%-8s %-20s %-15s %-10s %s\n",
            $time, $op, $domain, $status, $details );
    } else {
        ## Fallback: just print the line
        $output .= substr( $line, 0, 79 ) . "\n";
    }
}

$output .= "\n";
$output .= sprintf( "Total entries: %d", scalar(@filtered_lines) );
if ($filter) {
    $output .= " (filtered: $filter)";
}
$output .= "\n";

return {
    mode => 'true',
    data => $output
};

