## [:< ##

# name  = ticker.set_default_values

<ticker.cfg.fg_col> //= qw| 00003D |;
<ticker.cfg.bg_col> //= qw| 000047 |;

##  default transparent  ##
<ticker.alpha.bg>      = <ticker.cfg.alpha.bg>      // 100;
<ticker.alpha.fg>      = <ticker.cfg.alpha.fg>      // 94;
<ticker.alpha.outline> = <ticker.cfg.alpha.outline> // 24;

<ticker.cfg.font.outl_value_factor> //= 47;

<ticker.outline.rotation_direction> //= qw| CW |;    ## CW | CCW ##

<ticker.cfg.outline_speed> //= 2.47;                 ##  degree per second  ##

## outline sides color difference ##
<ticker.cfg.outline-deg-steps> //= 14;
##  hue distance limit during rotation  ##
<ticker.cfg.out-hue-distance-limit> //= 0.63;

## dynamic speed factor [ increase on same angle ] ##
<ticker.cfg.dynamic_speed> //= 1.42;

<ticker.auto_speed_mode>         //= FALSE;
<ticker.slowdown.percent>        //= FALSE;
<ticker.slowdown.percent_target> //= FALSE;

## seconds to hold the cursor over the ticker before a swap is executed;    ##
## leaving earlier cancels the swap and fades the ticker back in.           ##
<ticker.swap.delay> //= 4.2;

## default monitor placement for swap mode: 'full-desktop' keeps the ticker
## visible on the virtual desktop [works around unreliable WSLg monitor geo].
## other modes: follow-pointer, primary, index:N, cycle.
<ticker.window.monitor> //= qw| full-desktop |;

## display mode: 'continuous' scroll loop (default) or 'notify' one-shot    ##
<ticker.display.mode> //= qw| continuous |;

## notify mode state: TRUE once a notification has been dismissed/idle      ##
<ticker.notify.dismissed> //= FALSE;

# if TRUE, the ticker zenka exits after a notify is dismissed; next notify  ##
# must be shown by restarting the zenka (v7 on-demand). default stays idle. ##
<ticker.notify.terminate_after_dismiss> //= FALSE;

