## [:< ##

# name = models.storage.check_tier
# descr = Check if model exists at specific tier

use File::Spec;

sub check_tier {
  my ($model_amos, $tier) = @_;

  my $storage_funcs = <[models.storage.get_tier_path]>;
  my $path = $storage_funcs->($model_amos, $tier);
  return 0 unless $path && (-f $path || -l $path);

  return {
    'exists' => 1,
    'path' => $path,
    'is_symlink' => -l $path ? 1 : 0,
    'size' => -s $path,
    'accessible' => -r $path ? 1 : 0,
  };
}

# Entry point
{
  my @args = @ARG;
  return check_tier(@args);
};

