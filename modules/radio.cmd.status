## [:< ##

# name  = radio.cmd.status
# descr = current track, listener count, connection status

my $current_title = <radio.stream.icy>->{'current_title'} // '';
my $listeners     = scalar( <radio.listeners>->@* );
my $connected
    = ( defined <radio.stream.pid> and <radio.stream.pid> )
    ? qw| yes |
    : qw| no |;

return {
    'mode' => qw| true |,
    'data' => sprintf(
        "current track: %s\nlisteners: %d\nconnected: %s",
        length $current_title ? $current_title : '(none)', $listeners,
        $connected
    )
};

