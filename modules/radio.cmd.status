## [:< ##

# name  = radio.cmd.status
# descr = current track, listener count, connection status

my $icy           = <radio.stream.icy>;
my $current_title = $icy->{'current_title'} // '';
my $listeners     = scalar( <radio.listeners>->@* );
my $connected
    = ( defined <radio.stream.pid> and <radio.stream.pid> )
    ? qw| yes |
    : qw| no |;
my $jingle_state = $icy->{'is_jingle'} ? qw| yes | : qw| no |;

my $duration_str = '';
if ( defined $icy->{'track_started'} ) {
    my $dur = <[base.time]>->(3) - $icy->{'track_started'};
    $duration_str = sprintf "\ntrack duration: %.0f seconds", $dur;
}

return {
    'mode' => qw| true |,
    'data' => sprintf(
        "current track: %s\nlisteners: %d\nconnected: %s\njingle: %s%s",
        length $current_title ? $current_title : '(none)',
        $listeners, $connected, $jingle_state, $duration_str
    )
};

