## [:< ##

# name  = mpv.handler.audio_fade
# descr = Register a base.curve for volume fade (replaces timer-driven loop)

my $volume = shift;

<mpv.audio_fade.start_vol> //= <mpv.current.volume> // 0;

my $speed    = <mpv.audio.fade_speed> // 24;
my $duration = sprintf qw| %.3f |,
    ( 4.0 + abs( <mpv.audio_fade.delta_vol> // 0 ) / 100 ) * ( 24 / $speed );

<[base.curve.register]>->(
    {   id       => qw| mpv_audio_fade |,
        from     => <mpv.audio_fade.start_vol>,
        to       => $volume,
        duration => $duration,
        type     => qw| sigmoid |,
        callback => sub {
            my $val        = shift;
            my $new_volume = sprintf( qw| %.3f |, $val );
            return
                if defined <mpv.audio_fade.last_set>
                and $new_volume eq <mpv.audio_fade.last_set>;
            <[base.logs]>->( 2, '< FADE > volume == %.3f%%', $new_volume );
            <[mpv.send_command]>->( qw| set_property volume |, $new_volume );
            <mpv.audio_fade.last_set> = $new_volume;
        },
        on_done => sub {
            ##  sigmoid never quite reaches 1.0 : set exact target  ##
            <[mpv.send_command]>->( qw| set_property volume |, $volume );
            my $vol_str = sprintf( qw| %.2f |, $volume );
            $vol_str =~ s|(\.[^0])0$|$1|g;
            $vol_str =~ s|\.00$||g;
            map {
                <[base.callback.cmd_reply]>->(
                    $ARG,
                    {   'mode' => qw| true |,
                        'data' => sprintf '[%s%%] volume fade completed',
                        $vol_str
                    }
                ) if defined $ARG;
            } <mpv.audio_fade.reply_ids>->@*;
            delete <mpv.audio_fade.reply_ids>;
            delete <mpv.audio_fade>;
        },
    }
);

return;

