## [:< ##

# name  = models.parser.ellipse_name
# descr = Format model name with center ellipsis, tunable length (default 35 chars)

my $name = shift;
my $length = 35;    # Tunable: adjust this value to change display width

return <[base.parser.center_ellipse_string]>->( $name, $length );

