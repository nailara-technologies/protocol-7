## [:< ##

# name  = ascii.frame.slot.bind
# descr = bind a scalar reference to a frame slot for live updates

my $params = shift // {};

my $descriptor = $params->{'descriptor'} // return undef;
my $slot_name  = $params->{'slot'}       // return undef;
my $scalar_ref = $params->{'ref'}        // return undef;

return undef if ref $scalar_ref ne qw| SCALAR |;

$descriptor->{'slots'} //= {};

unless ( exists $descriptor->{'slots'}->{$slot_name} ) {
    $descriptor->{'slots'}->{$slot_name} = {
        type => 'field',
        row  => 1,
    };
}

$descriptor->{'slots'}->{$slot_name}->{'binding'} = $scalar_ref;

return $descriptor;

