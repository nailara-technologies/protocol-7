## [:< ##

# name  = protocol-7-menu.pointer-stream-init
# descr = start pointer-stream and request shm path on zenka init

<[protocol-7.route-send]>->(
    {   'command' => 'powershell.pointer-stream',
        'reply'   =>
            { 'handler' => 'protocol-7-menu.handler.pointer-stream-start' },
    }
);

## re-run this handshake whenever powershell restarts : idempotent, ##
## the on_restart registry dedups the (publisher,handler) pair      ##
<[base.zenka.on_restart]>->(
    {   'publisher' => 'powershell',
        'handler'   => 'protocol-7-menu.pointer-stream-init',
    }
);

