# name = data.mount.shm.permission.verify.group_contains
# descr = Check if member is in group

my ( $group_id, $member_key ) = @ARG;

return 0 unless exists $data{'groups'}{$group_id};
return grep { $_ eq $member_key } @{ $data{'groups'}{$group_id}{'members'} };

