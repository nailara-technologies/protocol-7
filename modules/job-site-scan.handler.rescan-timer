## [:< ##

# name  = job-site-scan.handler.rescan-timer
# descr = periodic rescan timer — triggers fetch when idle

return if <job-site-scan.cycle> ne 'idle';

<[base.logs]>->( 1, 'rescan timer — starting fetch' );
<[job-site-scan.stage.fetch]>;

