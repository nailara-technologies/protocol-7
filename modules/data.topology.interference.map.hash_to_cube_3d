    # name = data.topology.interference.map.hash_to_cube_3d
    # desc = Topology calculation subroutine

    my $hash = shift;

    # Use existing BMW/ELF checksum infrastructure
    my $chksum = <[chk-sum.amos.truth_template_chksum]>->( $hash, \0 ) // 0;

    # Map 64-bit checksum to 13³ space
    # Using division-13 entropy distribution
    my $x = ( $chksum >> 42 ) % CUBE_SIZE;
    my $y = ( $chksum >> 21 ) % CUBE_SIZE;
    my $z = $chksum % CUBE_SIZE;

    return [ $x, $y, $z ];

