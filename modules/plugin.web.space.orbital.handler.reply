## [:< ##

# name  = plugin.web.space.orbital.handler.reply
# descr = reply handler for all orbital data route-sends

my $reply = shift;

my $params = $reply->{'params'} // {};
my $field  = $params->{'field'} // return;
my $cmd    = $reply->{'cmd'}    // '';

my $cache = <web.space.orbital.cache>;
my $data  = $cache->{'data'} //= {};

## determine raw data source based on reply mode ##
my $raw_data;
if ( $cmd eq qw| SIZE | ) {
    $raw_data = $reply->{'data'} // '';
} else {
    $raw_data = $reply->{'call_args'}{'args'} // '';
}

if ( $field eq qw| self | ) {

    ## nodes.cmd.orbital-position — size mode, key=value lines ##
    my %kv;
    foreach my $line ( split "\n", $raw_data ) {
        if ( $line =~ m|^\s*(\w+)\s+(.+)$| ) {
            $kv{$1} = $2;
        }
    }
    $data->{'self'} = {
        qw| p7ref | => ( $kv{'p7ref'} // '' ),
        qw| theta | => ( $kv{'theta'} // 0 ) + 0,
        qw| phi   | => ( $kv{'phi'}   // 0 ) + 0,
        qw| psi   | => ( $kv{'psi'}   // 0 ) + 0,
        qw| omega | => ( $kv{'omega'} // 0 ) + 0,
    };

} elsif ( $field eq qw| known | ) {

    ## discover.list-orbital — size mode with formatted table ##
    my @nodes;
    foreach my $line ( split "\n", $raw_data ) {
        next if $line =~ m|^[-\s]+$|;
        next if $line =~ m|^\s*hostname|i;
        next if $line =~ m|no .* known|i;
        if ( $line =~ m|^\s*(\S+)\s+(\S+)\s+(\S+)\s+(\S+)| ) {
            push @nodes,
                {
                qw| hostname | => $1,
                qw| pkey7    | => $2,
                qw| p7ref    | => $3,
                qw| age      | => $4,
                };
        }
    }
    $data->{'known'} = \@nodes;

} elsif ( $field eq qw| connections | ) {

    ## external.list-connections — size mode with formatted table ##
    my @conns;
    foreach my $line ( split "\n", $raw_data ) {
        next if $line =~ m|^[-\s]+$|;
        next if $line =~ m|^\s*name|i;
        next if $line =~ m|no connections|i;
        if ( $line =~ m|^\s*(\S+)\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)| ) {
            push @conns,
                {
                qw| name      | => $1,
                qw| p7ref     | => $2,
                qw| status    | => $4,
                qw| encrypted | => ( $5 eq qw| yes | ? TRUE : FALSE ),
                };
        }
    }
    $data->{'connections'} = \@conns;

} elsif ( $field eq qw| nameserv | ) {

    ## nameserv.cmd.discover-nodes — true mode with result string ##
    my @entries;
    my $domain = <nameserv.cfg.auto_publish_domain> // '';
    foreach my $line ( split "\n", $raw_data ) {
        if ( $line =~ m|^\s+(\S+)\s+(\S+)| ) {
            push @entries,
                {
                qw| name   | => $1,
                qw| p7ref  | => $2,
                qw| domain | => $domain,
                };
        }
    }
    $data->{'nameserv'} = \@entries;

} elsif ( $field eq qw| gm_state | ) {

    ## graphics-matrix.orbital-sync — true mode with structured data ##
    my $decoded
        = length($raw_data)
        ? eval { JSON::XS::decode_json($raw_data) }
        : undef;
    $data->{'gm_state'} = ( ref $decoded eq qw| HASH | ) ? $decoded : {};

}

## track received fields ##
$cache->{'received_fields'} //= {};
$cache->{'received_fields'}->{$field} = 1;

## update timestamp when all expected fields received ##
my $expected     = $cache->{'expected_fields'} // [];
my $all_received = 1;
foreach my $f (@$expected) {
    $all_received = 0 unless $cache->{'received_fields'}->{$f};
}

$cache->{'timestamp'} = time() if $all_received;

<[base.log]>->( 3, qq| orbital field '$field' received | );

return 0;

