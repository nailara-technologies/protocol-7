# name  = models.decision.recommendation_engine.get_model_recommendations
# descr = Get top model recommendations for a context

my ( $context, $max_results ) = @ARG;

$max_results //= 3;

# Load all models
my $all_models = <[models.registry.list_all.list_all_models]>;
return [] unless $all_models && @$all_models;

# Find models for context
my $candidates
    = <[models.decision.recommendation_base.find_models_for_context]>->(
    $all_models, $context
    );

# Score each candidate
my @scored = map {
    my $score
        = <[models.decision.recommendation_base.calculate_composite_score]>->(
        $_, {}
        );
    { model => $_, score => $score };
} @$candidates;

# Sort by score
@scored = sort { $b->{score} <=> $a->{score} } @scored;

# Return top N
my @top = splice( @scored, 0, $max_results );
return [ map { $_->{model} } @top ];

