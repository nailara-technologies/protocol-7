## [:< ##

# name  = context.memory.load
# descr = load ai-mem files for a zenka with budget

my $params = shift // {};

## [ try scored tree cache from memory zenka first ]##
my $root      = <system.root_path>;
my $cache_txt = "$root/var/memory-context-cache.txt";
my $cache_nt  = "$root/var/memory-context-cache.ntime";

if ( -f $cache_txt and -f $cache_nt ) {
    my $written_at;
    if ( open( my $fh_n, '<:utf8', $cache_nt ) ) {
        local $INPUT_RECORD_SEPARATOR;
        $written_at = <$fh_n>;
        close $fh_n;
        $written_at =~ s|\s+||g if defined $written_at;
    }

    my $age = defined $written_at ? ( <[base.ntime]> - $written_at ) : 99999;

    if ( $age >= 0 and $age <= 600 ) {
        if ( open( my $fh_t, '<:utf8', $cache_txt ) ) {
            local $INPUT_RECORD_SEPARATOR;
            my $cached = <$fh_t>;
            close $fh_t;
            if ( defined $cached and length $cached ) {
                <[base.logs]>->(
                    2,
                    ':. context.memory: using scored tree cache [ %d chars ]',
                    length $cached
                );
                return $cached;
            }
        }
    }
}

<[base.logs]>->( 2, ':. context.memory: cache miss, using flat file load' );

## [ fall through to existing flat-file load below ]##

my $zenka       = $params->{'zenka'}  // '';
my $topics      = $params->{'topics'} // '';
my $budget      = $params->{'budget'} // 1000;
my $char_budget = int( $budget * <context.cfg.chars_per_token> );

my $mem_dir = <context.cfg.ai_mem_dir>;

## resolve zenka directory ##
my $zenka_dir;
if ( length $zenka and -d "$mem_dir/$zenka" ) {
    $zenka_dir = "$mem_dir/$zenka";
} else {
    ## try all subdirectories ##
    my @dirs = glob "$mem_dir/*";
    $zenka_dir = $dirs[0] if @dirs;
}

return "<!-- no ai-mem directory found -->"
    unless defined $zenka_dir and -d $zenka_dir;

## find matching files ##
my @files;
if ( length $topics ) {
    ## filter by topic keywords ##
    my @keywords = split m|\s+|, lc $topics;
    foreach my $file ( glob "$zenka_dir/*.md" ) {
        my $basename = lc $file;
        $basename =~ s|^.*/||;
        foreach my $kw (@keywords) {
            if ( $basename =~ m|\Q$kw\E| ) {
                push @files, $file;
                last;
            }
        }
    }
} else {
    ## load all markdown files ##
    @files = glob "$zenka_dir/*.md";
}

return "<!-- no matching memory files -->" unless @files;

## sort by size [ smaller files first : more likely to be focused ] ##
@files = sort { -s $a <=> -s $b } @files;

## read files within budget ##
my $output = "## ai-mem [ $zenka_dir ] ##\n";
my $used   = length $output;

foreach my $file (@files) {
    my $basename = $file;
    $basename =~ s|^.*/||;

    my $content_ref = <[file.slurp]>->($file);
    next unless defined $content_ref;

    my $content = $content_ref->$*;

    ## strip signature blocks ##
    $content =~ s|^#,,.*\n.*\n.*AMOS7.*\n.*DATA\sSIGNATURE.*\n.*\n||ms;

    my $section     = "### $basename\n$content\n";
    my $section_len = length $section;

    if ( $used + $section_len > $char_budget ) {
        ## try truncating this file ##
        my $remaining
            = $char_budget - $used
            - length("### $basename\n")
            - length("\n... [ truncated ]\n");
        if ( $remaining > 200 ) {
            $output .= "### $basename\n";
            $output .= substr( $content, 0, $remaining );
            $output .= "\n... [ truncated ]\n";
        }
        last;
    }

    $output .= $section;
    $used += $section_len;
}

return $output;

