## [:< ##

# name  = mpv.open_control_socket

## start async poll — socket connection completed in socket_poll handler ##
<mpv.startup.socket_retries> = 0;

<mpv.startup.socket_poll_timer> = <[event.add_timer]>->(
    {   'after'    => 0.02,
        'interval' => 0.05,
        'handler'  => qw| mpv.startup.handler.socket_poll |
    }
);

