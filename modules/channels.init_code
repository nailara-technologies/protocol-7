## [:< ##

# name = channels.init_code
# descr = Initialize channels infrastructure:
#         subscriptions, timestamps, heartbeat

<[base.perlmod.autoload]>->( 'Time::HiRes', qw| gettimeofday tv_interval | );
<[base.perlmod.autoload]>->( 'Digest::SHA', qw| sha256 | );
##  Channel subscription and state tracking  ##
<channels.subscriptions> //= {};
#
## { channel_path => { subscriber_id => timestamp } } ##

<channels.data>       //= {}; ## { channel_path => { name => value, ... } } ##
<channels.timestamps> //= {}; ## { channel_path => base32_timestamp } ##
<channels.checksums>  //= {}; ## { channel_path => base32_checksum } ##

<channels.blocking_clients> //= {};
#
## { request_id => { client_info, since_ts, ... } } ##
<channels.cleanup_enabled> //= TRUE;

##  Configuration defaults  ##
<channels.cfg.heartbeat_interval_seconds> //= 3600;     ## 1 hour ##
<channels.cfg.cleanup_interval_seconds>   //= 21600;    ## 6 hours ##
<channels.cfg.inactive_timeout_seconds>   //= 86400;    ## 24 hours ##
<channels.cfg.max_subscriptions>          //= 4097;
<channels.cfg.max_data_per_channel>       //= 1048576;  ## 1 MB per channel ##

##  Build unified list of all channels from both data and subscriptions  ##
<channels.all_channels> //= {};

foreach my $channel_path ( keys %{<channels.data>} ) {
    <channels.all_channels>->{$channel_path} //= {};
}
foreach my $channel_path ( keys %{<channels.subscriptions>} ) {
    <channels.all_channels>->{$channel_path} //= {};
}

##  Compute display fields for each channel  ##
foreach my $channel_path ( keys <channels.all_channels>->%* ) {
    my $sub_count
        = scalar keys %{ <channels.subscriptions>->{$channel_path} // {} };
    my $last_update = <channels.timestamps>->{$channel_path} // qw|[never]|;
    my $status      = qw| ACTIVE |;
    if ( !defined <channels.data>->{$channel_path} && $sub_count == 0 ) {
        $status = qw| IDLE |;
    }

    <channels.all_channels>->{$channel_path} = {
        'channel_path' => $channel_path,
        'status'       => $status,
        'last_update'  => $last_update,
        'sub_count'    => $sub_count
    };
}

##  Initialize base list structure for base.cmd.list channels  ##
<list.channels> = {
    'var'      => qw| data |,
    'key'      => qw| channels.all_channels |,
    'sort_key' => 'alpha-len:channel_path',
    'descr'    =>
        'active channels with subscription status and heartbeat tracking',
    'mask' => '<key>:channel status:status updated:'
        . 'last_update subscribers:sub_count',
    'align' => {
        'channel'     => 'left+2',
        'status'      => 'center',
        'updated'     => 'left+1',
        'subscribers' => 'center-1'
    },
    'filters' => {
        'status'  => qw| base.parser.channel_status |,
        'updated' => qw| base.parser.timestamp_short |,
    }
};

<[base.list.init]>->(
    {   'name'         => qw| channels |,
        'key_ref'      => \$data{'channels'}{'all_channels'},
        'max_elements' => <channels.cfg.max_subscriptions>
    }
);

<[base.logs]>->( 2, "channels : initialized" );
<[base.logs]>->(
    2,
    "channels: heartbeat interval %.1f hours",
    <channels.cfg.heartbeat_interval_seconds> / 3600
);
<[base.logs]>->(
    2,
    "channels: cleanup every %.1f hours",
    <channels.cfg.cleanup_interval_seconds> / 3600
);

0;

