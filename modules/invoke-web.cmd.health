## [:< ##

# name  = invoke-web.cmd.health
# descr = cmd: check invoke.ai HTTP health endpoint

<[base.perlmod.autoload]>->('LWP::UserAgent');

my $url = $data{'invoke-web'}{'url'} // 'http://127.0.0.1:9090';

my $ua       = LWP::UserAgent->new( timeout => 3 );
my $response = $ua->get("$url/api/v1/app/version");

if ( $response->is_success ) {
    my $body = $response->decoded_content // '';
    return {
        mode => qw| size |,
        data => sprintf( "healthy: %s\n", $body )
    };
} else {
    return {
        mode => qw| size |,
        data => sprintf( "unreachable: %s\n", $response->status_line )
    };
}

