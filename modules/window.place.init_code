## [:< ##

# name = window.place.init_code

## create [ + own + mode ] the zenka output dir while still root, with   ##
## group-write so the dropped-privilege taeki:protocol-7 process can     ##
## later create window/position.<chksum>.yaml without re-running as root ##
<[base.path-set-up.check-zenka-paths]>->( TRUE, 0770 );

<[base.perlmod.autoload]>->('Gtk3');
<[base.perlmod.autoload]>->('Glib::Object::Introspection');

<[base.gtk.attempt_load.glib_event]>;  ##  load Glib::Event when installed  ##

Gtk3->init;    ## initialize explicitly, required before Gtk3->main ##

## needed for $window->get_window->get_xid - without this setup the method  ##
## isn't exposed at all under the plain Gtk3 binding [ same as ticker and   ##
## protocol-7-menu init_code ].                                             ##
Glib::Object::Introspection->setup(
    qw| basename | => qw| GdkX11 |,
    qw| version  | => qw|  3.0   |,
    qw| package  | => qw| Gtk3::Gdk |
);

return 0;

