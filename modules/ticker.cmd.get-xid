## [:< ##

# name  = ticker.cmd.get-xid
# descr = return X11 window id when defined

return { 'mode' => qw| false |, 'data' => 'window id is undefined' }
    if not defined <x11.id>;

return { 'mode' => qw| true |, 'data' => <x11.id> }

