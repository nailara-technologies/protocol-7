## [:< ##

# name  = sessions.holder.op.encrypt
# descr = ChaCha20Poly1305 encrypt with the held test key. nonce = fixed
#         session_id 0 + a monotonic per-child counter [ prepended to the
#         output so decrypt can reconstruct the same nonce without any
#         shared state across a detach/reattach cycle ] + 4 zero bytes --
#         same shape as bin/p7-link-upgrade-helper.pl's op_encrypt.

my $key       = shift;
my $plaintext = shift // '';

<sessions.holder.op_counter> //= 0;
my $counter = <sessions.holder.op_counter>++;

my $nonce = pack( qw| N |, 0 ) . pack( qw| N |, $counter ) . "\0\0\0\0";

my $cipher     = Crypt::AuthEnc::ChaCha20Poly1305->new( $key, $nonce );
my $ciphertext = $cipher->encrypt_add($plaintext);
my $auth_tag   = $cipher->encrypt_done();

return pack( qw| N |, $counter ) . $ciphertext . $auth_tag;

