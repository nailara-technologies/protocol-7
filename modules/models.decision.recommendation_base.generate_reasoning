# name  = models.decision.recommendation_base.generate_reasoning
# descr = Generate human-readable reasoning for model recommendation

my ($model, $decision) = @ARG;

return '' unless $model && ref($model) eq 'HASH';

my @reasons;

push @reasons, "Model: " . ($model->{metadata}->{name} // 'Unknown');
push @reasons, "Success rate: " . ($model->{statistics}->{success_rate} // 0) . "%";

if ($model->{presence_decision}->{currently_present}) {
  push @reasons, "Status: Available locally";
} else {
  push @reasons, "Status: Available via remote fetch";
}

if ($decision->{reason}) {
  push @reasons, "Reason: " . $decision->{reason};
}

return join("\n", @reasons);

