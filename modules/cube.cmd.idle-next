## [:< ##

# name  = cube.cmd.idle-next
# descr = arm one-shot idle-longest routing override [ admin ]
# param = [:single|:next|:keep:] <name>[[subname]]

return <[cube.routing_override.arm]>->(
    $call->{'session_id'},
    qw| idle-longest |,
    $call->{'args'} // ''
);

