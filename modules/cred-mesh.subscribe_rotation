## [:< ##

# name  = cred-mesh.subscribe_rotation
# descr = register a STRM rotation subscriber for a cred slot.
#         args: { slot => '...', source_zenka => 'zenka-name' }
#
# source_zenka must be the caller's authenticated identity [ prepended by
# cube's SOURCE_ZENKA alias ], never a caller-supplied string : at notify
# time each subscriber is fired as "<source_zenka>.cred-rotated" -- a
# variable but verified target with a fixed suffix, so no subscriber can
# dictate what command gets executed under cred-mesh's own permissions ##

my $params = shift;

return { 'mode' => qw| false |, 'data' => 'expected hashref' }
    if ref $params ne qw| HASH |;

my $slot         = $params->{'slot'}         // '';
my $source_zenka = $params->{'source_zenka'} // '';

return { 'mode' => qw| false |, 'data' => 'missing slot' }
    unless length $slot;
return { 'mode' => qw| false |, 'data' => 'missing source zenka' }
    unless length $source_zenka;

## ensure slot exists ('*' is the wildcard/all-slots bucket) ##
return {
    'mode' => qw| false |,
    'data' => "unknown slot '$slot'"
    }
    if $slot ne qw| * |
    and not exists <cred-mesh.registry>->{$slot};

<cred-mesh.rotation_subscribers>->{$slot} //= [];

## avoid duplicate subscriptions ##
my $subs = <cred-mesh.rotation_subscribers>->{$slot};
return { 'mode' => qw| true |, 'data' => 'already subscribed' }
    if grep { $ARG eq $source_zenka } @$subs;

push @$subs, $source_zenka;

return { 'mode' => qw| true |, 'data' => 'subscribed' };

