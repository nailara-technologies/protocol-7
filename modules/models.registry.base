## [:< ##

# name = models.registry.base
# descr = Registry base functionality - internal helpers for registry management

use File::Path qw| make_path |;

# Ensure registry directory exists
make_path('/var/protocol-7/models') unless -d '/var/protocol-7/models';

# Get registry path
sub get_registry_path { return '/var/protocol-7/models/registry.json'; }

# Get or load registry (uses $data{} for persistence)
sub get_registry {
  return $data{models_registry} if defined $data{models_registry};

  # Load from disk if not in memory
  my $loader = <[models.registry.load]>;
  $data{models_registry} = $loader->{'load_registry'}->();
  return $data{models_registry};
}

# Save registry to disk
sub save_registry_internal {
  my $registry = get_registry();
  my $saver = <[models.registry.save]>;
  return $saver->{'save_registry'}->($registry);
}

# Return helpers interface
{
  'get_registry_path' => \&get_registry_path,
  'get_registry' => \&get_registry,
  'save_registry_internal' => \&save_registry_internal,
};

