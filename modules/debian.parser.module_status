# name  = debian.parser.module_status
# descr = Format cpan module status for display

my $status = shift;

return
      $status eq 'via_debian' ? '✓deb'
    : $status eq 'via_cpan'   ? '✓cpan'
    : $status eq 'missing'    ? '✗'
    :                           $status;

0;

