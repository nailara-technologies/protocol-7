# name  = branch.calc.fraction.period_length
# descr = return length of minimal repeating period for X/Y
# param = numerator, denominator
#
# return 0 if terminates

my ( $numerator, $denominator ) = @ARG;

return undef
    if not defined $numerator
    or not defined $denominator
    or $denominator == 0;

my $period_str
    = <[branch.calc.fraction.period]>->( $numerator, $denominator );

return undef if not defined $period_str;
return length($period_str);

