## [:< ##
# name  = plan-9.client.disconnect
# descr = Disconnect from 9P server

my ($client_name) = @ARG;

my $client = $data{'plan-9'}{'client'}{$client_name};
return { 'mode' => 'false', 'data' => 'client not found' } unless $client;

close $client->{socket} if $client->{socket};
delete $data{'plan-9'}{'client'}{$client_name};

<[base.logs]>->("9P client disconnected from $client_name");

return { 'mode' => 'true', 'data' => 'disconnected' };

