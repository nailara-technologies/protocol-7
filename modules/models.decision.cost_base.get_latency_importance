# name  = models.decision.cost_base.get_latency_importance
# descr = Get latency importance score for a context (1-10)

my ($model_entry, $context) = @ARG;

my $latency_scores = {
  real_time => 10,
  interactive => 8,
  streaming => 9,
  batch => 2,
  analysis => 3
};

return $latency_scores->{$context} // 5;

