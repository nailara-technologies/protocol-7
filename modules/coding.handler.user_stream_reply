# name  = coding.handler.user_stream_reply
# descr = persist a reply from the amos-term interaction buffer to notes

my ( $question, $reply ) = @ARG;

return unless defined $question and length $question;
return unless defined $reply   and length $reply;

<[coding.tools.handler.write_answered_note]>->(
    {   'question' => $question,
        'answer'   => $reply,
    }
);

return TRUE;

