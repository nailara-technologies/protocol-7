## [:< ##

# name  = coding.async.http_cleanup
# descr = Clean up HTTP connection resources
# purpose = Remove I/O watchers and close socket

my ($state) = @ARG;

return unless defined $state;

## Cancel timeout watcher ##
if ( defined $state->{'timeout_watcher'} ) {
    eval { $state->{'timeout_watcher'}->cancel() };
    delete $state->{'timeout_watcher'};
}

## Remove I/O watcher ##
if ( defined $state->{'io_watcher'} ) {
    eval { $state->{'io_watcher'}->cancel() };
    delete $state->{'io_watcher'};
}

## Close socket ##
if ( defined $state->{'sock'} ) {
    eval { $state->{'sock'}->close() };
    delete $state->{'sock'};
}

<[base.logs]>->( 2, "async.http_cleanup: resources cleaned up" );

return { success => TRUE };

