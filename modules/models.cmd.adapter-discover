# name  = models.cmd.adapter-discover
# descr = cmd: list models from a host adapter

my $host = $call->{'args'} // qw| invoke |;

my $out = "";

if ( $host eq qw| invoke | ) {
    my $records = <[models.storage.adapter.invoke.discover]>;
    my $count   = scalar @{ $records // [] };
    <[base.logs]>->( 1, "adapter-discover [ invoke ] : %d models", $count );
    for my $rec ( @{ $records // [] } ) {
        $out .= sprintf "%-10s %-8s %-12s %s\n",
            $rec->{'type'}, $rec->{'base'}, $rec->{'format'}, $rec->{'name'};
    }
} elsif ( $host eq qw| lmstudio | ) {
    my $records = <[models.storage.adapter.lmstudio.discover]>;
    my $count   = scalar @{ $records // [] };
    <[base.logs]>->( 1, "adapter-discover [ lmstudio ] : %d models", $count );
    for my $rec ( @{ $records // [] } ) {
        $out .= sprintf "%-10s %-8s %-12s %s\n",
            $rec->{'type'}, $rec->{'base'}, $rec->{'format'}, $rec->{'name'};
    }
} else {
    <[base.logs]>->( 0, "unknown adapter [ %s ]", $host );
}

return { mode => qw| size |, data => $out };

