## [:< ##

# name  = amos-term.cmd.window-close
# descr = Close GTK3 window (preserve buffer)

my $amos_id = $$call{'args'};
$amos_id =~ s/^\s+|\s+$//g;

return {
    'mode'     => 'true',
    qw| data | => "Error: AMOS ID required\n"
    }
    unless defined $amos_id;

my $result = <[amos-term.window-close]>->("amos:$amos_id");

return {
    'mode'     => 'true',
    qw| data | => (
        $result
        ? "Window closed (buffer preserved)\n"
        : "Error: close failed\n"
    )
};

