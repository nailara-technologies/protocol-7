## [:< ##

# name  = work.console.sig-cycle
# param = [file-pattern]
# descr = test signature cycle (backup/update/verify/restore)

my $pattern = shift // 'modules/*';

$pattern =~ s,^ *| *$,,;

say '';
say ' .:[ WORKFLOW: FULL SIGNATURE TEST CYCLE ]:.';
say '';
say sprintf ' : Pattern: %s', $pattern;
say '';

system('./bin/Protocol-7', 'sourcecode', 'test-cycle', $pattern);
my $exit_code = $? >> 8;

say '';
if ( $exit_code == 0 ) {
    say ' : ✓ Test cycle completed successfully';
} else {
    say sprintf ' : ✗ Test cycle failed (exit code: %d)', $exit_code;
}
say '';

return $exit_code;

