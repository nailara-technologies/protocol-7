## [:< ##

# name  = jobsite.cmd.status
# descr = show current cycle state and job counts

my %counts;
my $total = 0;

## prefer index.yaml for fast counts
my $index_file = '/var/protocol-7/jobsite/index.yaml';
if ( -f $index_file ) {
    my $index = eval { YAML::XS::LoadFile($index_file) } // {};
    if ( ref $index eq 'HASH' ) {
        for my $id ( keys %{$index} ) {
            my $stage = $index->{$id}{'stage'} // 'unknown';
            $counts{$stage}++;
        }
        $total = scalar keys %{$index};
    }
}

## fallback to in-memory tasks
if ( not $total ) {
    my $tasks = <jobsite.tasks> // {};
    for my $id ( keys %{$tasks} ) {
        my $stage = $tasks->{$id}{'stage'} // 'unknown';
        $counts{$stage}++;
    }
    $total = scalar keys %{$tasks};
}

my $last = <jobsite.last_scan> // 0;
my $age  = $last ? sprintf( '%ds ago', time - $last ) : 'never';

my @lines;
push @lines, sprintf 'cycle:      %s', <jobsite.cycle> // 'idle';
push @lines, sprintf 'last scan:  %s', $age;
push @lines, sprintf 'jobs total: %d', $total;
for my $stage (
    qw| queued assessing assessed review approved rejected failed |) {
    push @lines, sprintf '  %-12s %d', $stage, $counts{$stage} // 0
        if $counts{$stage};
}
push @lines, sprintf 'threshold:  %s', <jobsite.cfg.threshold> // 6;

return { 'mode' => 'size', 'data' => join( "\n", @lines ) };

