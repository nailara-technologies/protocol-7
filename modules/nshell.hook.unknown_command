# name  = nshell.hook.unknown_command
# descr = Intercept unknown commands and display to user

my ($msg_data) = @ARG;

return FALSE unless defined $msg_data;

my $cmd     = $msg_data->{'cmd'};
my $cmd_id  = $msg_data->{'cmd_id'};
my $context = $msg_data->{'context'} // 'unknown';

## Format and display the unknown command to user
my $output
    = sprintf( "\n[nshell: command not found] '%s' (context: %s, id: %d)\n",
    $cmd, $context, $cmd_id );

print $output;
$| = 1;    ## flush immediately

return TRUE;    ## we handled it

