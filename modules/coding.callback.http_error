## [:< ##

# name  = coding.callback.http_error
# descr = HTTP streaming error callback

my ( $task_id, $error ) = @ARG;

<[base.logs]>->( 0, "async.request: error for %s: %s", $task_id, $error );

## check for retryable errors (HTTP 500, timeouts) ##
my $state       = <[coding.async.state_manager]>->( 'get', $task_id );
my $retry_count = $state->{'retry_count'} // 0;
my $max_retries = 1;

## prevent duplicate retry timers ##
if ( $state->{'retry_pending'} ) {
    <[base.logs]>->(
        2,
        "async.request: retry already pending for %s, ignoring duplicate error",
        $task_id
    );
    ## release lock if we own it [ safety net ] ##
    my $backend_dup = $state->{'backend'} // '';
    <[coding.async.backend_release]>->( $task_id, $backend_dup )
        if length $backend_dup;
    return;
}

if (   $error =~ m{HTTP error:\s*5\d\d|timeout|connection closed}i
    && $retry_count < $max_retries ) {
    $retry_count++;
    <[base.logs]>->(
        1, "async.request: retrying %s [attempt %d/%d]",
        $task_id, $retry_count, $max_retries
    );

    ## server 500 with tool_calls: strip tool_calls from assistant msgs ##
    ## matches blocking version [ process-queued-task lines 544-548 ] ##
    ## jinja template cannot handle tool_calls arguments as strings ##
    ## model keeps content and tool results for context ##
    if ( $error =~ m{HTTP error:\s*500}i ) {
        my $msgs = $state->{'messages'} // [];

        ## detect gemma/llama jinja templates that reject role:tool messages ##
        ## pattern: raise_exception("Invalid content type") in else branch  ##
        my $convert_tool_role = ( $error =~ m{Invalid content type}i
                || $error =~ m{raise_exception}i ) ? 1 : 0;

        for my $msg ( @{$msgs} ) {
            my $role = $msg->{'role'} // '';

            ## convert role:tool → role:user when template rejects tool role ##
            if ( $convert_tool_role && $role eq qw| tool | ) {
                my $tc_id = $msg->{'tool_call_id'} // 'unknown';
                $msg->{'role'} = qw| user |;
                $msg->{'content'}
                    = "[TOOL RESULT: $tc_id]\n" . ( $msg->{'content'} // '' );
                delete $msg->{'tool_call_id'};
                <[base.logs]>->(
                    1,
                    "http_error: converted tool role → user (jinja mismatch)"
                );

                ## convert role:assistant → role:model for gemma-family templates ##
                ## gemma uses 'model' not 'assistant' as the AI turn role name    ##
            } elsif ( $convert_tool_role && $role eq qw| assistant | ) {
                $msg->{'role'} = qw| model |;
                <[base.logs]>->(
                    1, "http_error: converted assistant → model (gemma jinja)"
                );
            }

            ## strip tool_calls from assistant/model messages ##
            if ( ref $msg->{'tool_calls'} eq qw| ARRAY | ) {
                delete $msg->{'tool_calls'};
                <[base.logs]>->(
                    1, "http_error: stripped tool_calls from %s msg", $role
                );
            }
        }
    }

    ## update retry count and set pending flag ##
    <[coding.async.state_manager]>->(
        'set', $task_id,
        {   retry_count   => $retry_count,
            retry_pending => TRUE
        }
    );

    ## retry after short delay (100ms) ##
    ## use named handler - coderefs not supported by event.add_timer ##
    <[event.add_timer]>->(
        {   'after'   => 0.1,
            'handler' => qw| coding.callback.retry_request |,
            'data'    => $task_id
        }
    );
    ## release backend lock before scheduling retry ##
    my $backend_retry = $state->{'backend'} // '';
    <[coding.async.backend_release]>->( $task_id, $backend_retry )
        if length $backend_retry;
    return;
}

## release backend lock before failing task ##
my $backend_fail = $state->{'backend'} // '';
<[coding.async.backend_release]>->( $task_id, $backend_fail )
    if length $backend_fail;

## fail the task ##
my $result = {
    success => FALSE,
    error   => $error,
};

## when all retries fail with a timeout the server accepted the TCP
## connection but never responded : restart it so the next task gets
## a fresh process rather than silently hanging again                  ##
if ( $error =~ m{timeout}i ) {
    my $backend_r = $state->{'backend'} // 'gpu';
    my $srv       = ( <coding.inference_servers> // {} )->{$backend_r} // {};
    if ( ( $srv->{'status'} // '' ) eq 'ready' ) {
        <[base.logs]>->(
            0,
            "http_error: %s timed out after %d retries"
                . " : scheduling %s server restart",
            $task_id,
            $max_retries,
            $backend_r
        );
        $srv->{'status'} = 'restart_needed';

        ## reduce context size to recover from VRAM-pressure timeouts ##
        my $step  = <coding.cfg.ctx_timeout_step>    // 7000;
        my $floor = <coding.cfg.ctx_timeout_floor>   // 16000;
        my $cur   = <inference.model.context_length> // 0;
        if ( $cur > $floor ) {
            my $reduced = ( $cur - $step > $floor ) ? $cur - $step : $floor;
            <inference.model.context_length> = $reduced;
            <[base.logs]>->(
                1,
                "http_error: reducing context %d → %d [timeout recovery, floor=%d]",
                $cur,
                $reduced,
                $floor
            );
        }

        ## clear cached pid so spawn_servers_deferred doesn't skip us ##
        <inference.gpu_pid> = 0 if $backend_r eq 'gpu';
        ## clear awaiting_resources: may be stuck from twin startup,
        ## blocking async_spawn_inference_servers silently             ##
        delete <coding.awaiting_resources> if <coding.awaiting_resources>;
        ## defer restart to avoid interfering with task teardown ##
        <[event.add_timer]>->(
            {   'after'   => 0.5,
                'handler' => qw| coding.handler.spawn_servers_deferred |,
                'data'    => { 'reason' => 'timeout_restart' }
            }
        );

        ## requeue task transparently instead of failing it :              ##
        ## server restart is already scheduled; verify_inference_startup   ##
        ## calls jobqueue.check_dependencies when ready, which picks us up ##
        my $task = <coding.task.queue>->{$task_id};
        if ( defined $task ) {
            $task->{'status'} = 'pending';
            ## clear http-level state so next attempt starts a fresh round ##
            <[coding.async.state_manager]>->( 'delete', $task_id );
            <[base.logs]>->(
                1,
                "http_error: requeued %s as pending — retries after server restart",
                $task_id
            );
            return;
        }
    }
}

<[coding.async.complete]>->( $task_id, $result );

return;

