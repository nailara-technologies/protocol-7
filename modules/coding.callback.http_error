## [:< ##

# name  = coding.callback.http_error
# descr = HTTP streaming error callback

my ( $task_id, $error ) = @ARG;

<[base.logs]>->( 0, "async.request: error for %s: %s", $task_id, $error );

## check for retryable errors (HTTP 500, timeouts) ##
my $state       = <[coding.async.state_manager]>->( 'get', $task_id );
my $retry_count = $state->{'retry_count'} // 0;
my $max_retries = 3;

if (   $error =~ m{HTTP error:\s*5\d\d|timeout|connection closed}i
    && $retry_count < $max_retries ) {
    $retry_count++;
    <[base.logs]>->(
        1, "async.request: retrying %s (attempt %d/%d)",
        $task_id, $retry_count, $max_retries
    );

    ## server 500 with tool_calls: strip tool_calls from assistant msgs ##
    ## matches blocking version [ process-queued-task lines 544-548 ] ##
    ## jinja template cannot handle tool_calls arguments as strings ##
    ## model keeps content and tool results for context ##
    if ( $error =~ m{HTTP error:\s*500}i ) {
        my $msgs = $state->{'messages'} // [];
        for my $msg ( @{$msgs} ) {
            if ( ( $msg->{'role'} // '' ) eq 'assistant'
                and ref $msg->{'tool_calls'} eq qw| ARRAY | ) {
                <[base.logs]>->(
                    1,
                    "http_error: stripping tool_calls from assistant msg for retry"
                );
                delete $msg->{'tool_calls'};
            }
        }
    }

    ## update retry count ##
    <[coding.async.state_manager]>->(
        'set', $task_id, { retry_count => $retry_count }
    );

    ## retry after short delay (100ms) ##
    ## use named handler - coderefs not supported by event.add_timer ##
    <[event.add_timer]>->(
        {   'after'   => 0.1,
            'handler' => qw| coding.callback.retry_request |,
            'data'    => $task_id
        }
    );
    return;
}

## fail the task ##
my $result = {
    success => FALSE,
    error   => $error,
};

<[coding.async.complete]>->( $task_id, $result );

return;

