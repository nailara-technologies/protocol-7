## [:< ##

# name  = coding.callback.http_error
# descr = HTTP streaming error callback

my ( $task_id, $error ) = @ARG;

<[base.logs]>->( 0, "async.request: error for %s: %s", $task_id, $error );

## check for retryable errors (HTTP 500, timeouts) ##
my $state       = <[coding.async.state_manager]>->( 'get', $task_id );
my $retry_count = $state->{'retry_count'} // 0;
my $max_retries = 3;

if (   $error =~ m{HTTP error:\s*(5\d\d|timeout)}i
    && $retry_count < $max_retries ) {
    $retry_count++;
    <[base.logs]>->(
        1, "async.request: retrying %s (attempt %d/%d)",
        $task_id, $retry_count, $max_retries
    );

    ## update retry count ##
    <[coding.async.state_manager]>->(
        'set', $task_id, { retry_count => $retry_count }
    );

    ## retry after short delay (100ms) ##
    <[event.add_timer]>->(
        {   'after'   => 0.1,
            'handler' => sub {
                <[coding.async.send_request]>->($task_id);
            }
        }
    );
    return;
}

## fail the task ##
my $result = {
    success => FALSE,
    error   => $error,
};

<[coding.async.complete]>->( $task_id, $result );

return;

