# name = ticker.handler.get-layer_reply

my $reply = shift;

if ( $reply->{'cmd'} eq qw| TRUE | ) {
    <ticker.tile-groups.layer> = $reply->{'call_args'}->{'args'};
    if ( <ticker.tile-groups.layer> == 100 ) {
        <[base.log]>->(
            1, "tile-groups layer == 100 << ! >> [enabling 'force_above']"
        );
        <ticker.window.force_above> = TRUE;
    }
}

## swap mode needs an override-redirect (popup) window: WSLg/Weston forces  ##
## _NET_WM_WINDOW_TYPE_DOCK windows to a fixed panel position and ignores   ##
## client moves. a popup window can be positioned freely by the client.     ##
if ( not <ticker.window.force_above>
    and <[base.cfg_bool]>->(<ticker.mouse.swap_edge>) ) {
    <[base.log]>->(
        1, ': swap mode enabled, using override-redirect popup window'
    );
    <ticker.window.force_above> = TRUE;
}

<[ticker.open_window]>;

