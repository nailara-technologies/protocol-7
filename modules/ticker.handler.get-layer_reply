## [:< ##

# name = ticker.handler.get-layer_reply

my $reply = shift;

## the fallback timer may have already opened the window [ tile was stuck, ##
## then a late reply arrives once it resumes ]. resolve-once : if the timer ##
## got here first, bail -- the window is already open.                      ##
return if <ticker.layer_resolved>;
<ticker.layer_resolved> = TRUE;

if ( defined <ticker.layer_timer> ) {
    <ticker.layer_timer>->cancel if <ticker.layer_timer>->is_active;
    delete <ticker.layer_timer>;
}

if ( $reply->{'cmd'} eq qw| TRUE | ) {
    <ticker.tile.layer> = $reply->{'call_args'}->{'args'};
    if ( <ticker.tile.layer> == 100 ) {
        <[base.log]>->(
            1, "tile layer == 100 << ! >> [enabling 'force_above']"
        );
        <ticker.window.force_above> = TRUE;
    }
}

## swap mode uses a managed toplevel window: a popup is invisible under    ##
## WSLg without a parent, while a dock window is locked to a panel position.##
if ( not <ticker.window.force_above>
    and <[base.cfg_bool]>->(<ticker.mouse.swap_edge>) ) {
    <[base.log]>->( 1, ': swap mode enabled, using managed toplevel window' );
    <ticker.window.force_above> = TRUE;
}

<[ticker.open_window]>;

