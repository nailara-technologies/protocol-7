## [:< ##

# name  = letsencr.parent.cmd.query-algos
# descr = query ACME server for supported signature algorithms

<[base.log]>->( 2, 'querying ACME server for supported algorithms' );

## Call child command to query server
my $cmd_result = eval {
    <[base.protocol-7.command.send.local]>->(
        {   'command'   => qw| letsencr.child.query-algos |,
            'call_args' => {}
        }
    );
};

if ( length $EVAL_ERROR ) {
    <[base.log]>->(
        1, 'error querying algorithms: %s',
        <[base.str.eval_error]>
    );
    return {
        'mode' => qw| false |,
        'data' => 'Failed to query ACME server'
    };
}

unless ($cmd_result) {
    <[base.log]>->( 1, 'no response from child process' );
    return {
        'mode' => qw| false |,
        'data' => 'No response from child'
    };
}

## Parse algorithm list from child response
my $algo_data;
if ( $cmd_result->{mode} && $cmd_result->{mode} =~ m,^(size|true)$,i ) {
    eval { $algo_data = JSON::XS::decode_json( $cmd_result->{data} ); };

    if ( !$EVAL_ERROR && ref($algo_data) eq 'ARRAY' && @$algo_data ) {
        <[base.log]>->(
            2,
            'ACME server supported algorithms: %s',
            join( ', ', @$algo_data )
        );

        ## Return formatted output
        my $output = "Supported ACME Signature Algorithms:\n";
        $output .= "==================================\n\n";

        foreach my $algo (@$algo_data) {
            $output .= "  • $algo\n";
        }

        return {
            'mode' => qw| size |,
            'data' => $output
        };
    }
}

## Fallback on error
return {
    'mode' => qw| false |,
    'data' => 'Failed to parse algorithm list'
};

