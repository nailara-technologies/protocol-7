external.models.lmstudio.default_chat = YHIIJ5I:I7MZ3UI ## Qwen3.5-9B-Uncensored-Aggressive Q8

## Default embedding model [not yet configured]
## external.models.lmstudio.default_embedding = <embedding-model-checksum>

## Default Invoke.ai model for image generation
external.models.invokeai.default_model = stable-diffusion-xl-base-1.0

##==========================================================================##
## FILE FETCH CONFIGURATION
##==========================================================================##

## LAN hosts to check before downloading from HuggingFace
## space-separated list of IP addresses or hostnames
fetch.file.lan_hosts =

## HuggingFace API token (optional for public models)
## falls back to external.hf.token if not set
fetch.file.hf_token =

