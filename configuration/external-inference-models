external.models.lmstudio.default_chat = MBZAAII:ZRCGL5Q ## Qwen Qwen3.5 9B Q6_K

## Default embedding model [not yet configured]
## external.models.lmstudio.default_embedding = <embedding-model-checksum>

## Default Invoke.ai model for image generation
external.models.invokeai.default_model = stable-diffusion-xl-base-1.0

