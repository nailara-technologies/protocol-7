## [:< ##

# name  = zenka-startup.v7
# descr = 'web-browser' zenka startup configuration used by 'v7' zenka

dependencies = cube X-11 openbox

: v7-init :
  start_mode = stdin-zenka
  command_line_modules = Gtk3 Gtk3::WebKit2
  cube.key = [base.prng.chars-anum:44]
  [v7.callback.setup_zenka_key:<instance_id>,'<zenka_name>',<cube.key>]

: zenka-init :
  cfg.ephemeral = 1

  web-browser.window.profile          = automatic
  web-browser.window.profile-fallback = fullscreen
  [base.auth.set_zenka_key:'<{cube.key}>']

