
 .:[ protocol-7 llama-server-vision - GPU-accelerated vision analysis with job dispatch ]:.

[load_config_file:'shared-params']

### access control ###
access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase \
                      status info * ## <-- restrict some later

access.cmd.usr.parent = commands reload list show-buffer heart *

## Module loading ##
## Job-dispatch architecture: all llama-server-vision.* modules auto-loaded
modules.load = auth net protocol io.unix io.ip crypt.C25519 \
                                         llama-server-vision \
                                         devmod  ## <-- development only.., ##
[load_modules:<modules.load>]

system.verbosity.zenka_buffer  = 1
system.verbosity.console       = 1
system.verbosity.zenka_logfile = 1

[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[zenka.loop]

