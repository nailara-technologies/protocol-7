
.:[ 'menu-commands' zenka [ menu management provider ] ]:.

[load_config_file:'shared-params']

access.cmd.usr.cube = commands heart verify-instance reload \
                      list show-buffer buffer-erase buffer-erase-level \
                      src-age src-ver rel-ver \
                      add remove update list-mappings list-categories \
                      add-category remove-category status get-provider-data

modules.load = auth net protocol io.unix menu-commands
[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

