
 .:[ protocol-7 development workflow zenka ]:.

[load_config_file:'shared-params']

system.verbosity.zenka_buffer = 2
system.verbosity.zenka_logfile = 2

## Disable automatic key loading for work zenka ##
##
## Keys are explicitly loaded by commands that need
##                  them [ e.g. version-sign-commit ]
##
## Read-only commands [fix-versions, harmonize-emails] don't need keys
##
crypt.C25519.auto_load_keys = no

## Disable automatic key creation for console execution
## Console/admin commands run as root don't need key initialization
## v7-started zenka will enable this for proper privilege-dropped users
crypt.C25519.autocreate-user-key = no

## Git repository path is auto-detected from <system.root_path> ##
## No need to hardcode it here ##

access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase buffer-erase-level \
                      test-oscillation sig-verify sig-update sig-cycle \
                      run-tests version-sign-commit todo bug \
                      todo-list bug-list regenerate-indexes \
                      fix-versions harmonize-emails *

## Git remote configuration for version-sign-commit ##
## By default, remotes are auto-detected with
##   priority: hub > origin > first available
##
## Configure multiple remotes to push to all of them automatically:
## Examples:
##   workflow.git.remotes = origin backup      # two remotes
##   workflow.git.remotes = origin backup mirror # three remotes
##   workflow.git.remotes =                    # empty = auto-detect [default]
# workflow.git.remotes =

modules.load = auth net protocol io.unix crypt.C25519 \
               git workspace-transfer workflow

[load_modules:<modules.load>]
[init_modules]

[base.call.console_command:<system.args>]

[exit:0]

