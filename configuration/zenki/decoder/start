
.:[ 'decoder' terminal stream zenka ]:.


[load_config_file:'shared-params']

modules.load           = auth net protocol io.unix decoder ## devmod

access.cmd.usr.cube-13 = heart commands stream-add stream-remove stream-attach \
                                     receive-entropy devmod ## <-- !

access.cmd.usr.decoder = handler.on-boundary

access.cmd.usr.cube    = verify-instance commands heart reload subname \
                         list show-buffer buffer-erase buffer-erase-level \
                         list-deps cur-pid src-ver rel-ver src-age \
                         ask-question save-state load-state show-accumulator \
                         receive-entropy show-access \
                         reduce-entropy stop-job harmony D13-collection \
                         show-accumulator show-vterm show-indexcube \
                         show-level5 show-level6 inject reset stream-list
                               ## * ## <-- devmod

[load_modules:<modules.load>]
[init_modules]

[base.net.connect:'unix','13','127.0.0.1','cube-13']

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

