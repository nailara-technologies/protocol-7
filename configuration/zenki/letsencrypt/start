
  .:[ Let's Encrypt ACME client zenka [ automated certificate management ] ]:.

[load_config_file:'shared-params']

access.cmd.usr.cube = commands heart verify-instance reload name \
                      list show-buffer buffer-erase buffer-erase-level \
                      child.* status renew force-renew list-domains \
                      list-certificates dump echo # <-- require devmod module

                      # reload command currently disabled [ drops parent cmds ]

access.cmd.usr.parent = commands reload show-buffer \
                        status renew force-renew \
                        * # <-- LLL

## ACME Server Configuration
letsencrypt.acme.server = https://acme-v02.api.letsencrypt.org/directory
#letsencrypt.acme.server = https://acme-staging-v02.api.letsencrypt.org/directory  # staging server

## Email for Let's Encrypt account and notifications
letsencrypt.admin.email = admin@example.com  # [!] update to your admin email

## Certificate Storage
letsencrypt.certs.dir = /etc/protocol-7/certs
letsencrypt.certs.backup = /var/protocol-7/certs

## Renewal Configuration
letsencrypt.renewal.days-before = 30  # renew when 30 days remain
letsencrypt.renewal.check-interval = 3600  # check every hour
letsencrypt.renewal.retry-delay = 300  # retry failed renewals after 5 mins

## Cache Configuration
letsencrypt.cache.dir = /var/cache/letsencrypt
letsencrypt.cache.timeout = 86400  # 24 hours

## Challenge Configuration
letsencrypt.challenge.type = http-01  # http-01 or dns-01
letsencrypt.challenge.timeout = 300  # 5 minutes for challenge completion

## Rate Limiting Protection
letsencrypt.ratelimit.enabled = 1
letsencrypt.ratelimit.max-per-hour = 5

modules.load = auth net protocol io.unix io.ip letsencrypt.base
[load_modules:<modules.load>]
[init_modules]

[base.net.connect:'unix']

[letsencrypt.base.fork_letsencrypt_child]

[root.drop_privs:<system.amos-zenka-user>]

[base.get_session_id]

[zenka.loop]

