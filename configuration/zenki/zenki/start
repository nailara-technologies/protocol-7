
 .:[ protocol-7 zenki dependency manager and smart launcher ]:.

[load_config_file:'shared-params']

system.verbosity.zenka_buffer = 2
system.verbosity.zenka_logfile = 2

## Commands available to cube users
access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase buffer-erase-level \
                      start stop status stats *

## Load modules for IPC communication + zenki management
modules.load = auth.client net protocol io.unix ui zenki

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

## Connect to cube for IPC with v7
[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

