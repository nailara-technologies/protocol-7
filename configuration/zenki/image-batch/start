
 .:[ protocol-7 image-batch - on-demand batch processing orchestrator ]:.

[load_config_file:'shared-params']

access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase \
                      status process pause resume cancel ## <-- image-batch commands ##

system.verbosity.zenka_buffer = 2  ##  memory ring buffer verbosity  ##

## On-demand configuration: orchestrator is started when batch needed ##
start.on_demand = 1
restart.disabled = 1
heartbeat.disabled = 1

## Module loading ##
modules.load = auth net protocol io.unix io.ip crypt.C25519 image-batch
[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

