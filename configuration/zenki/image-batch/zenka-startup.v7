## [:< ##

# name  = zenka-startup.v7
# descr = 'image-batch' zenka startup configuration used by 'v7' zenka

dependencies = cube

: v7-init :
  start_mode = stdin-zenka
  image-batch.key = [base.prng.chars-anum:44]
  [v7.callback.setup_zenka_key:<instance_id>,'<zenka_name>',<image-batch.key>]

: zenka-init :
  [base.auth.set_zenka_key:'<{image-batch.key}>']

