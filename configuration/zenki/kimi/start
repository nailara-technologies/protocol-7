
 .:[ protocol-7 kimi-web client zenka ]:.

[load_config_file:'shared-params']

access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase buffer-erase-level \
                      ask-reply status get set dump \
                      approve reject approvals new-session session-info \
                      src-age src-ver subname name \
                      exec-sub eval-code deparse-code list-subs

system.verbosity.zenka_buffer  = 2
system.verbosity.zenka_console = 2

## kimi-web endpoint
#           ##   [ override if kimi-web is on a different host|port ]
# kimi.web.host = 127.0.0.1
# kimi.web.port = 5494

## reconnect backoff [ 2s initial, doubling up to max cap ]
# kimi.connect.retry_delay = 60

## local agent mode [ uses kimi-web zenka to spawn local agents ]
# kimi.cfg.use_local_agent = 0        ## set to 1 to enable local mode
# kimi.cfg.work_dir =                 ## default: <system.root_path>
# kimi.cfg.local_template =           ## context template for new agents

## admin group for spawned agent file access [ auto-detected from root_path ]
# kimi.cfg.assume_admin_group = 0     ## set to 1 to use project admin group

crypt.C25519.autocreate-user-key = yes

modules.load = auth net protocol io.unix websocket crypt.C25519 \
               format.json devmod kimi

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[base.async.get_session_id]

[zenka.loop]

