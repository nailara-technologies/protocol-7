
 .:[ nshell [ Protocol-7 native shell as zenka ] ]:.

[load_config_file:'shared-params']

access.cmd.usr.cube = commands heart verify-instance \
                      reload src-age src-ver rel-ver \
                      list show-buffer buffer-erase buffer-erase-level \
                      history get-history clear-history \
                      eval execute \
                      * # <-- all enabled temp. for devmod debug commands

modules.load = auth net protocol io.unix nshell devmod

[load_modules:<modules.load>]
[init_modules]

## Set authentication user to current Unix user (not zenka name)
system.auth-user = <nshell.unix_user>

[base.net.connect:'unix']

## nshell authenticates as Unix user, not as zenka
## so it doesn't need/use cube session IDs
## [base.get_session_id]

## Register hooks to intercept unknown messages from cube\other zenki
# [ These hooks allow nshell to display messages to the user instead of
# silently dropping them ]
#
[nshell.register_hooks]

[zenka.loop]

