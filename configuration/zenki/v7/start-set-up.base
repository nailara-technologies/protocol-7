
  .:[  'basic' : defines a basic [v7] zenka start-up configuration ].:

.: globals :.

  zenki.enabled  =  cube p7-log  coding image-quality image-batch  # httpd httpsd letsencr web

# zenki.disabled =

.: zenki :.

# specific configuration imported : zenki/<zenka_name>/zenka-startup.v7 ###

  - dist-upgrade

      max_concurrency  = 1
      restart.disabled = 1

      : v7-init :
        start_mode = exec-external
        exec_bin = debian_dist_upgrade.sh       # [ ./bin/dependencies/.., ]
        exec_usr = root

### external program example ###    [ supports '<AMOS-user>' from X11-vars ]

  - llama-server-vision

      max_concurrency  = 1
      restart.disabled = 1
      idle_timeout = 3600  # Keep running for image-quality analysis

      : v7-init :
        start_mode = exec-external
        exec_bin = llama-server-vision.sh
        exec_usr = protocol-7

  - namesrv

      max_concurrency = 1
      dependencies = cube

      : v7-init :
        start_mode = exec-external
        exec_bin = /usr/local/bin/namesrv
        exec_usr = root

