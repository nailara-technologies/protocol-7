
.:[ protocol-7 'v7' process start-up zenka ]:.

system.zenka.name = v7

[load_config_file:'shared-params']
[load_config_file:'X11-vars']

crypt.C25519.auto_load_keys  = 0  ## prevent base key auto-loading ..,

## Load debian dependency manager for automatic dependency installation
modules.load = v7 jobqueue net protocol io.unix io.ip crypt.C25519 auth.zenka   ## debian

load.start_setup = base        #    <--   [ ,../zenki/v7/start-set-up.base ]

access.cmd.usr.cube = *

v7.host-reboot.enabled        = 1
v7.host-reboot.term-delay     = 1.3787
v7.system-poweroff.enabled    = 1
v7.system-poweroff.term-delay = 1.3787

v7.local_cube.connect-unix = 1   ## connect to local cube on unix path ##

###  BIN/P7C AUTO-INSTALLATION (LOCAL)  ###
v7.cfg.install_bin_p7c      =   yes
v7.cfg.bin_p7c_static       =   yes
v7.cfg.bin_p7c_has_symlink  =   auto # [yes|no|auto]
#
system.bin_p7c_src_path     =   'bin/c_src/p7c.c' ## /usr/local/protocol-7 ., ##
v7.cfg.p7c_bin_path         =   '/usr/local/bin/p7c'

###  BIN/P-7-R AUTO-INSTALLATION (REMOTE)  ###
v7.cfg.install_bin_p7r      =   yes
v7.cfg.bin_p7r_static       =   yes
v7.cfg.bin_p7r_has_symlink  =   auto # [yes|no|auto]
#
system.bin_p7r_src_path     =   'bin/c_src/p-7-r.c' ## /usr/local/protocol-7 ., ##
v7.cfg.p7r_bin_path         =   '/usr/local/bin/p-7-r'

### ZENKA SYMLINKS AUTO-INSTALLATION ###
v7.cfg.install_zenka_symlinks  =  yes     # [yes|no]
v7.cfg.zenka_symlink_dir       =  '/usr/local/bin'

 ### settings not enabled yet.., ##
 #
 #  v7.cfg.p7c_bin_path     = '<system.root_path>/bin/p7c'
 #  v7.cfg.p7c_symlink_path = '/usr/local/bin/p7c'
 #
 #  v7.cfg.p7r_bin_path     = '<system.root_path>/bin/p-7-r'
 #  v7.cfg.p7r_symlink_path = '/usr/local/bin/p-7-r'
 #
##

# create protocol-7 user if required.,
[root.check_system_user:<system.amos-zenka-user>]

[load_modules:<modules.load>]
[init_modules]

[init-done] ## declare initialization completed ##

[v7.call_cmd:<system.args>]

[zenka.loop]

