#!/data/projects/protocol-7/bin/Protocol-7

 .:[ protocol-7 C25519 key management zenka ]:.

[load_config_file:'shared-params']
buffer.zenka.log_cmd = ''    ## standalone zenka : no network logging

modules.load  = crypt.C25519 terminal keys


# crypt.C25519.base_key_name = '' ## <-- to override '<user>.base' pattern ..,
crypt.C25519.auto_load_keys  = 0  ## prevent base key auto-loading ..,


[load_modules:<modules.load>]
[init_modules]

[base.call.console_command:<system.args>]

