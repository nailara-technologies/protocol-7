
  .:[ Let's Encrypt ACME client zenka [ automated certificate management ] ]:.

[load_config_file:'shared-params']

system.verbosity.zenka_buffer = 3
system.verbosity.console      = 2

## cube to letsencr [ parent commands ]
access.cmd.usr.cube = commands heart verify-instance name reload \
                      list show-buffer buffer-erase buffer-erase-level \
                      status renew force-renew list-domains child.commands \
                      list-certificates activity-log show-access \
                      request-certificate revoke-certificate query-algos \
                      child.* \ ## <-- routes cube to child
                      dump echo      ## <-- devmod commands

## parent to child commands ##
access.cmd.usr.parent =  status renew force-renew inst-self-signed \
                         list heart commands cur-pid cpu-time src-ver \
                         src-age show-access show-buffer buffer-erase \
                         buffer-erase-level verbosity request-certificate \
                         ## reload
##                       reload command is currently disabled : drops commands!
                         dump get        ## <-- 'devmod' module debug commands

access.cmd.usr.child = cube.httpd.setup-acme-challenge \ ## <-- child to cube
                       cube.httpd.cleanup-acme-challenge \
                       cube.httpd.remove-acme-challenge

## ACME Server Configuration
letsencr.acme.server = https://acme-v02.api.letsencrypt.org/directory
#letsencr.acme.server = https://acme-staging-v02.api.letsencrypt.org/directory
#letsencr.acme.server = http://localhost:8555/directory  # local mock

## email for Let's Encrypt account and notifications
## [ REQUIRED: configure this to your organization's email before production use ]
letsencr.admin.email = domain@:requested-domain:

## Certificate Storage
letsencr.certs.dir = /etc/protocol-7/certs
letsencr.certs.backup = /var/protocol-7/certs

## Renewal Configuration
letsencr.renewal.days-before = 30  # renew when 30 days remain
letsencr.renewal.check-interval = 3600  # check every hour
letsencr.renewal.retry-delay = 300  # retry failed renewals after 5 mins

## Cache Configuration
letsencr.cache.dir = /var/cache/letsencr
letsencr.cache.timeout = 86400  # 24 hours

## Challenge Configuration
letsencr.challenge.type = http-01   # http-01 or dns-01
letsencr.challenge.timeout = 300     # 5 minutes for challenge completion
letsencr.challenge.site_dir = /var/httpd/  # document root for challenges
letsencr.challenge.site_name = default   # default virtual host directory

## Rate Limiting Protection
letsencr.ratelimit.enabled = 1
letsencr.ratelimit.max-per-hour = 5

modules.load = auth net protocol io.unix io.ip letsencr.base    ## devmod
[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[letsencr.base.fork_letsencr_child]

[zenka.loop]

