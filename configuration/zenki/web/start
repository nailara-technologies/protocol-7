
  .:[ web content zenka ]:.

[load_config_file:'shared-params']

system.verbosity.zenka_buffer = 2

access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer content process_template_ipc *

modules.load = auth net protocol io.unix web devmod \
               index.gen_path jobsite.job  ## [ until generic namespace exists ] ##
[load_modules:<modules.load>]

plugins.load = plugin.web
[load_plugins:<plugins.load>]

[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

