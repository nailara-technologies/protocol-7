
 .:[ 'mpv' video player zenka ]:.

[load_config_file:'shared-params']

system.zenka.verbosity.buffer  = 2
system.zenka.verbosity.console = 1

[load_config_file:'X11-vars']  ##  <-- <system.AMOS-user>  ##

buffer.played.log_cmd = p7-log.append # <-- log video paths <?> disable to not.

# mpv.rescale_path = /alternative/video/target/path

access.cmd.usr.cube = name commands heart subname reload verify-instance play \
                      append-play align-x align-y clear-playlist pause-toggle \
                      pid next pause playlist-update prev quit version \
                      reload-playlist resume seek show-playlist stop zoom \
                      append setting shuffle-playlist list change-subname \
                      get-config-names get-config current-file is-idle dump \
                      get-speed set-speed get-volume set-volume show-buffer \
                      start-autoskip stop-autoskip autoskip-interval loop pos \
                      current-hwdec current-vo current-ao drop-buffers fade \
                      buffer-erase buffer-erase-level cur-pid \
                      clear-profile reposition snapshot-save snapshot-restore \
                      src-ver src-age  * ## <-- disable again [devmod]

modules.load = auth.client net protocol io.unix io.ip ui set-up.json chk-sum mpv \
              jobqueue window.profile window.profile.color window.geometry
[load_modules:<modules.load>]

mpv.network.skip_proxy = yes  ### ignore proxy variables from %ENV ? ###

mpv.restore_last_position = yes ## restore last saved window position on  ####
                                ## startup instead of re-querying placement ##
                                ## zenka — set to 0 to always ask fresh   ####

mpv.restore_on_startup = 1   ## replay saved player state [ properties,    ##
                             ## position, pause ] from state/snapshot.yaml ##
                             ## on startup -- set to 0 to disable          ##
mpv.snapshot_interval_seconds = 60  ## periodic state snapshot checkpoint  ##
                                    ## [ 0 disables the periodic save ]    ##

mpv.log_played = 0   # seperately log which files or urls have been played ..,

mpv.fade_in    = 0   # disabled [ now done using the compton fade in option ]
mpv.auto_fs    = 0   # start in fullscreen mode in case no geometry was received
mpv.autoresize = 0   # autoresize player window to get rid of black borders

mpv.autorescale = 0  # [ffmpeg] re-encode video automatically in the background
                     #        [ used by some kiosk-appliances for optimization ]
mpv.rescale_max_width = 720   # <-- max. limit of ffmpeg reencoding video size
mpv.cleanup_rescaled_after = 8 # days [removes converted videos if not played.,]
mpv.resume_timeout = 8         # 'universal'-child resume timeout [ in seconds ]

mpv.fade_idle_volume   = 1  # silence / fade-in on mpv player 'core-idle' state

mpv.audio.fade_speed = 24 # <-- audio volume fade speed [ 0..100 ]  [default]
mpv.start_volume  = 77 # % <-- volume at startup ; fading to after 'core-idle'

mpv.vo_backend = gpu#,sdl # [gpu-hq|gpu|sdl|...]   [ see mpv -vo help for list ]
mpv.hwdec = auto         # [no|auto|nvdec|...]  [ ..more with mpv --hwdec=help ]
# mpv.hwdec = nvdec      # nvdec blacks out without x11egl [ needs cuda+egl ]

mpv.ao = pulse,sdl

## WSLg's native bridge -- no manual pulseaudio.exe needed ##
[set_env:'PULSE_SERVER','unix:/mnt/wslg/PulseServer']      ##
## [mpv.pulse.disable_idle_suspend] moved into mpv.init_code -- this runs ##
## before [init_modules], too early for base.exec.with_timeout's POSIX/  ##
## IPC::Open3 dependencies [see module descr] ##

mpv.xmode.xnest.vo  = x11
mpv.xmode.nxagent.vo = sdl

mpv.playlist_type = video # <-- changed to audio if started with 'audio' subname

mpv.fade_start_geom = 31x31--0--0 ## opening window size to hide X11-flickering ..
#mpv.fade_start_geom = 1x1--0--0  # 1x1 freezes EGL surface at 1px [ x11egl ]

[init_modules]

[root.drop_privs:<system.AMOS-user>]

mpv.loop_plist_param = ''    ## empty init ##
mpv.loop_plist_param = [mpv.loop_plist_param]

#            --loop-playlist=yes # for 'kiosk' mode
#            --idle=once # with start on demand ..,

mpv.preset = wsl-pulse   ##  <--  <kiosk|linux|wsl-nv-sdl|wsl-nv-pulse|...>

mpv.placement_mode = window-place  ## uncomment to use placement on startup

## initial geometry for placement ui when no profile exists [ WxH+X+Y ] ##
# window.place.initial_geometry.mpv = 1280x720+0+0

# mpv.params = [mpv.retrieve_params:<mpv.preset>] ## [LLL] implement ..,.

mpv.idle_logo_script = <system.root_path>/configuration/zenki/mpv/lua/p7-idle-logo.lua
mpv.osc_script       = <system.root_path>/configuration/zenki/mpv/lua/p7-osc.lua
mpv.idle_logo_image  = <system.root_path>/data/gfx/logos/nailara_logo.trans-dark.png
mpv.idle_logo_text   = .:::.mpv.play.:::.

## load p7-blue color theme [ provides defaults for roles below ] ##
[window.profile.color.load:'p7-blue']

## idle logo text style [ p7 purple + deep cobalt glow ] ##
mpv.idle_text_color         = 001E5B   # p7 'true' blue
mpv.idle_text_outline_color = 000007   # deep cobalt outline
mpv.idle_text_shadow_color  = 070005   # near-black

## OSC color theme — p7 blacklight blue [ passed to Lua for '#' prefixing ] ##
mpv.osc_bg_color      = 000510   # near-black with blue cast
mpv.osc_boxalpha      = 45       # semi-opaque [ 0=opaque 255=clear ]
mpv.osc_time_color    = 002FDD   # deep cobalt — timecode
mpv.osc_title_color   = 001AC4   # dark cobalt — title
mpv.osc_timepos_color = 003AFF   # cobalt — position marker
mpv.osc_btn_color     = 001EBB   # cobalt blue — main buttons
mpv.osc_sbtnL_color   = C58D07   # gold — warm contrast accent
mpv.osc_sbtnR_color   = C58D07   # gold — warm contrast accent
mpv.osc_topbtn_color  = 000EA0   # very dark blue — top buttons
mpv.osc_held_color    = 05082A   # near-black blue — held state
mpv.osc_outline_color = 000208   # near-black outline
mpv.osc_layout        = topbar   # topbar centers title at top of window

## native OSD colors [ arrow-key seek bar, status text ] ##
mpv.osd_color      = 002FDD   # deep cobalt - seek bar fill + OSD text
mpv.osd_back_color = 000510   # near-black - seek bar background

mpv.script_opts = osc-idlescreen=no,\
   p7_idle-logo_image=<mpv.idle_logo_image>,\
   p7_idle-logo_text=<mpv.idle_logo_text>,\
   p7_idle-text_color=<mpv.idle_text_color>,\
   p7_idle-text_outline_color=<mpv.idle_text_outline_color>,\
   p7_idle-text_shadow_color=<mpv.idle_text_shadow_color>,\
   p7_idle-osc_bg=<mpv.osc_bg_color>,\
   p7_idle-osc_boxalpha=<mpv.osc_boxalpha>,\
   p7_idle-osc_timecode=<mpv.osc_time_color>,\
   p7_idle-osc_title=<mpv.osc_title_color>,\
   p7_idle-osc_timepos=<mpv.osc_timepos_color>,\
   p7_idle-osc_btn=<mpv.osc_btn_color>,\
   p7_idle-osc_sbtnL=<mpv.osc_sbtnL_color>,\
   p7_idle-osc_sbtnR=<mpv.osc_sbtnR_color>,\
   p7_idle-osc_topbtn=<mpv.osc_topbtn_color>,\
   p7_idle-osc_held=<mpv.osc_held_color>,\
   p7_idle-osc_outline=<mpv.osc_outline_color>,\
   p7_idle-osc_layout=<mpv.osc_layout>,\
   p7_idle-osd_color=<mpv.osd_color>,\
   p7_idle-osd_back_color=<mpv.osd_back_color>

mpv.params = -idle -force-window -keep-open=yes \
             -no-config -vo=<mpv.vo_backend> \
             -no-border -ao=<mpv.ao> -gpu-api=opengl \
             -hwdec=<mpv.hwdec> -gpu-context=x11egl \
             -audio-client-name=mpv-wsl \
             -ytdl-format=hls-1058 \
             --no-osc \
             --script=<mpv.idle_logo_script> \
             --script=<mpv.osc_script> \
             --script-opts=<mpv.script_opts>

##            --ytdl-raw-options='--cookies=/data/video/cookies.yt'
              # -audio-wait-open=3.0 \
              # --no-input-terminal --no-input-cursor --input-vo-keyboard

mpv.audio_params = -vo null -ao=<mpv.ao> --idle=yes <mpv.loop_plist_param> \
                   --no-config --really-quiet

[base.net.connect:'unix']

[mpv.startup.resolve_x11_info]
# [set-up.json.import_file:'mpv.set-up.json'] # ../etc/protocol-7/import/..,

[mpv.startup.init]

## must run before [zenka.loop] : base.session.send_init_reports [ armed in ##
## base.net.connect ] withholds ALL pending reports -- including whatever   ##
## tells v7 this instance exists -- until <system.zenka.initialized> is     ##
## true, which only this call sets. v7's own startup handshake              ##
## [ verify-instance ] depends on that report arriving, and                 ##
## mpv.startup.job.fork_player [ pushed onto system.callbacks.initialized   ##
## by mpv.startup.init above ] only runs once v7 sends verify-instance.     ##
## deferring this call [ eg. to mpv.startup.handler.socket_ready, after the ##
## player's own control socket opens ] deadlocks : the fork that would      ##
## open the socket never happens because v7 never hears from this instance  ##
## in the first place. mpv.startup.handler.socket_ready also (harmlessly)   ##
## calls base.async.get_session_id again once the socket is up; the         ##
## 'already have a cube sid' guard in base.handler.whoami_reply makes that  ##
## second call a no-op.                                                     ##
[base.get_session_id]

# [mpv.get_optional_playlist:<mpv.playlist_type>]

[zenka.loop]

