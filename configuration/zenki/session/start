
.:[ protocol-7 'session' utility zenka ]:.

system.zenka.name = session

[load_config_file:'shared-params']

## Load session and debian modules for dependency checking
modules.load = session debian

access.cmd.usr.cube = check-deps config stats setup-keys *

[load_modules:<modules.load>]
[init_modules]

[init-done] ## declare initialization completed ##

[zenka.loop]

