
 .:[ 'cube-13' user \ command authentication set-up ]:.


auth.setup.usr.zulum    =  :unix:root
auth.setup.usr.storage  =  :unix:root
auth.setup.usr.decoder  =  :unix:root

auth.setup.usr.unix-root  =  :unix:root  # 'unix-*' can be used by './bin/p7'

auth.setup.usr.taeki      =  :unix:<system.admin-user> # <-- development only.

auth.setup.usr.amos-term  =  :unix:protocol-7

