
 .:[ protocol-7 lm-vision - GPU-accelerated vision analysis with job dispatch ]:.

[load_config_file:'shared-params']

### access control ###
access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase \
                      status info * ## <-- restrict some later

access.cmd.usr.parent = commands reload list show-buffer heart *

## Module loading ##
## Job-dispatch architecture: all lm-vision.* modules auto-loaded
modules.load = auth.client net protocol io.unix io.ip ui crypt.C25519 format.json lm-vision \
                                                            devmod  ## <-- development.., ##
[load_modules:<modules.load>]

system.zenka.verbosity.buffer  = 2
system.zenka.verbosity.console = 2
system.zenka.verbosity.logfile = 2

## Backend selection ##
## auto  = use HTTP if coding zenka server ready, else CLI
## http  = force HTTP backend (fails if server unavailable)
## cli   = force CLI backend (llama-mtmd-cli-cuda-fa)
lm-vision.backend = http

[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[base.get_session_id]

[zenka.loop]

