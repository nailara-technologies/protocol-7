
 .:[ protocol-7 kimi-web sub-agent spawner zenka ]:.

[load_config_file:'shared-params']

access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase buffer-erase-level \
                      spawn_agent list_agents dispatch dispatch_parallel \
                      dispatch_stream enqueue \
                      terminate_agent resolve_template \
                      src-age src-ver subname name \
                      eval-code deparse-code list-subs

system.verbosity.zenka_buffer  = 2
system.verbosity.zenka_console = 2

## agent configuration
kimi-web.agent.base_port   = 16000
kimi-web.agent.max_agents  = 8

## default context template budget
kimi-web.template.budget = 8000

crypt.C25519.autocreate-user-key = yes

modules.load = auth net protocol io.unix crypt.C25519 \
               format.json format.yaml clients.http devmod

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[base.async.get_session_id]

[zenka.loop]

