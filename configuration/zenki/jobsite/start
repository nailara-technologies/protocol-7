
 .:[ jobsite — job search scan and assessment coordinator ]:.

[load_config_file:'shared-params']

buffer.session.log_cmd  = p7-log.append
buffer.session.max_size = 795648

system.zenka.verbosity.buffer = 1

## named search categories — space separated list of category keys
jobsite.cfg.categories         = linux-sysadmin linux-developer devops platform-engineer \
                                       security-engineer ki-infrastruktur backend-architect

## per-category stepstone search urls
jobsite.cfg.url.linux-sysadmin    = https://www.stepstone.de/jobs/linux-administrator/in-deutschland
jobsite.cfg.url.linux-developer   = https://www.stepstone.de/jobs/linux-entwickler/in-deutschland
jobsite.cfg.url.devops            = https://www.stepstone.de/jobs/devops-engineer/in-deutschland
jobsite.cfg.url.platform-engineer = https://www.stepstone.de/jobs/platform-engineer/in-deutschland
jobsite.cfg.url.security-engineer = https://www.stepstone.de/jobs/security-engineer/in-deutschland
jobsite.cfg.url.ki-infrastruktur  = https://www.stepstone.de/jobs/ki-infrastruktur/in-deutschland
jobsite.cfg.url.backend-architect = https://www.stepstone.de/jobs/softwarearchitekt/in-deutschland

## minimum llm score [ 0..10 ] to flag job for review
jobsite.cfg.threshold       = 7

## seconds between automatic rescans [ 0 = manual trigger only ]
jobsite.cfg.rescan_interval = 0

## seconds between sync pushes to httpd cache
jobsite.cfg.sync_interval = 300

## seconds to wait for a dispatched assessment/repair task's reply before
## giving up on it and draining the next queue entry [ watchdog against a
## lost task.create/task.wait-done reply wedging cycle on 'assessing' ]
jobsite.cfg.assess_timeout = 600

## two-stage delete retention (in V7 epochs)
jobsite.cfg.trash_keep_epochs  = 1  ## recoverable compressed stage
jobsite.cfg.deleted_keep_epochs = 2  ## plain deleted stage before purging

## httpd sync endpoint url
jobsite.cfg.sync_url      = http://172.24.33.224/jobs-sync
jobsite.cfg.sync_urls     =

## path to cv/profile context file injected into assessment prompt
jobsite.cfg.profile_file    = /etc/protocol-7/jobsite/profile.txt

access.cmd.usr.cube = heart subname name commands reload verify-instance \
                      list-jobs src-age src-ver show-buffer buffer-erase \
                      buffer-erase-level mail_received manual-sync \
                      scan status list approve reject rescue reset set-threshold \
                      set-status job-upsert import-url clear-tasks blacklist-add \
                      blacklist-stats show-prompt progress report-stray-jobs group-jobs \
                      list-trashed rescue-http get-prefs set-prefs \
                      get set dump del exec-sub eval-code # <-- devmod cmds !!

modules.load = auth.client net protocol io.unix ui jobsite clients.http devmod
[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[base.get_session_id]

[zenka.loop]

