
  .:[ forensics zenka [ internal audit : nightly sweep + investigation ] ]:.

[load_config_file:'shared-params']

system.zenka.verbosity.buffer  = 2
system.zenka.verbosity.console = 1

## cube to forensics [ parent commands + routed delivery : cube          ##
## authenticates the source zenka [ cube/access.zenki ] and forwards     ##
## as itself -- investigate-finding is the openvas phase 2 handoff ]     ##
access.cmd.usr.cube = commands heart verify-instance name reload src-age \
                      list show-buffer buffer-erase buffer-erase-level \
                      status src-ver show-access sweep-run \
                      investigate-finding
                      ## future cross-zenka grants live here as comments ##
                      ## until the modules exist [ no placeholder          ##
                      ## access.zenki -- see commit 24e84da2d ] :          ##
                      ##                                                   ##
                      ##   access.cmd.usr.events  = sweep-run              ##

## openvas to forensics [ phase 2 : report-to-forensics handoff ]
access.cmd.usr.openvas = investigate-finding

## sweep policy [ paths default to <system.path.zenka-dirs.var_P7> based ##
## zenka var-dir in forensics.event.nightly-sweep, overridable here ]    ##
forensics.cfg.log_dir              = /var/log/protocol-7
forensics.cfg.sweep_window_seconds = 86400

modules.load = auth.client net protocol io.unix ui format.yaml forensics
[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[base.get_session_id]

[zenka.loop]

