
 .:[ protocol-7 vision-batch - on-demand batch processing orchestrator ]:.

[load_config_file:'shared-params']

### access control to zenka commands, refine later when final commands known ##
##                                                                            #
access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase \
                      status process pause resume cancel child.* \
                      * ### enabled all commands for development and testing ##

access.cmd.usr.parent = commands reload list show-buffer heart * # <- same here
##
###

## Module loading ##
## Note: vision-batch.parent and vision-batch.child are loaded selectively
##       in fork_child to maintain module isolation (parent != child)
## Load parent init_code here for global state initialization
## Fork_child and other parent modules load in parent scope after fork
modules.load = auth net protocol io.unix io.ip crypt.C25519 jobqueue \
                                         vision-batch.parent.init_code \
                                         vision-batch.parent.fork_child \
                                         devmod ## <-- developement only
[load_modules:<modules.load>]

system.verbosity.zenka_buffer  = 2  ## increasing verbosity for development
system.verbosity.console       = 2  ##                       and testing ..
system.verbosity.zenka_logfile = 2


[init_modules] ## initializes the modules from modules.load

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

# Fork single child process for blocking operations
# Parent and child modules are loaded in their respective scopes
# Session ID is obtained inside fork_child to avoid timeout
[vision-batch.parent.fork_child]

[zenka.loop]

