# credential fabric seed registry
# copy to var/credential_fabric/seed.yaml and edit.
# each slot is auto-registered once on first credential_fabric.init_code.

slots:
  - slot:        openweathermap.api-key
    owner:       weather
    type:        api-key
    sensitivity: low
    storage:     local

  - slot:        atom.udt-psk
    owner:       transport
    type:        psk
    sensitivity: high
    storage:     local

  - slot:        atom.hysteria-auth
    owner:       transport
    type:        bearer-token
    sensitivity: high
    storage:     local

