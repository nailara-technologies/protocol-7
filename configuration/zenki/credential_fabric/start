.:[ credential_fabric — credential fabric zenka (tiered storage, zenka ownership) ]:.

[load_config_file:'shared-params']

buffer.session.log_cmd  = p7-log.append
buffer.session.max_size = 795648

system.verbosity.zenka_buffer = 1

access.cmd.usr.cube = heart subname name commands reload verify-instance \
                      list src-age src-ver show-buffer buffer-erase \
                      buffer-erase-level \
                      register \
                      resolve \
                      subscribe_rotation \
                      rotate \
                      request-authorization \
                      approve \
                      list-slots \
                      ui-show \
                      dump set get del exec-sub eval-code

credential_fabric.cfg.store_dir     = var/credential_fabric/
credential_fabric.cfg.registry_file = var/credential_fabric/registry.yaml
credential_fabric.cfg.audit_log     = var/credential_fabric/audit.log

modules.load = auth net protocol io.unix ui credential_fabric credential proxy \
               ascii.frame format.yaml httpd.status_codes devmod

[base.white-list.register:'ascii.frame']

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[base.get_session_id]

[zenka.loop]

