
   .:[ credential_fabric zenka command access permission set-up ]:.

                access.cmd.usr.proxy           =  credential_fabric.resolve \
                                                   credential_fabric.request-authorization

                access.cmd.usr.transport       =  credential_fabric.resolve

                access.cmd.usr.weather         =  credential_fabric.register \
                                                   credential_fabric.resolve

                access.cmd.usr.jobsite         =  credential_fabric.register \
                                                   credential_fabric.resolve

                access.cmd.usr.web-browser     =  credential_fabric.handler.auth-relay-reply

         access.cmd.usr.credential_fabric      =  credential_fabric.register \
                                                   credential_fabric.resolve \
                                                   credential_fabric.subscribe_rotation \
                                                   credential_fabric.rotate \
                                                   credential_fabric.request-authorization

