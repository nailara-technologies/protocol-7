
.:[ protocol-7 opencv - GPU-accelerated computer vision ]:.

[load_config_file:'shared-params']

### access control ###
access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase \
                      features-detect features-match \
                      faces-detect objects-detect \
                      filter-apply transform-warp

## On-demand configuration ##
start.on_demand = 1
restart.disabled = 1
heartbeat.disabled = 1
idle_timeout = 120  ## Auto-shutdown after 2 minutes of inactivity

## Module loading ##
modules.load = auth.client net protocol io.unix ui opencv
[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

