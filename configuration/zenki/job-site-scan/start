.:[ job-site-scan — job search scan and assessment coordinator ]:.

[load_config_file:'shared-params']

buffer.session.log_cmd  = p7-log.append
buffer.session.max_size = 795648

system.verbosity.zenka_buffer = 1

## named search categories — space separated list of category keys
job-site-scan.cfg.categories         = linux-sysadmin ki-automation devops platform-engineer

## per-category stepstone search urls
job-site-scan.cfg.url.linux-sysadmin    = https://www.stepstone.de/jobs/linux-administrator/in-deutschland
job-site-scan.cfg.url.ki-automation     = https://www.stepstone.de/jobs/ki-spezialist/in-deutschland
job-site-scan.cfg.url.devops            = https://www.stepstone.de/jobs/devops-engineer/in-deutschland
job-site-scan.cfg.url.platform-engineer = https://www.stepstone.de/jobs/platform-engineer/in-deutschland

## minimum llm score (0-10) to flag job for review
job-site-scan.cfg.threshold       = 6

## seconds between automatic rescans (0 = manual trigger only)
job-site-scan.cfg.rescan_interval = 0

## path to cv/profile context file injected into assessment prompt
job-site-scan.cfg.profile_file    = /etc/protocol-7/job-site-scan/profile.txt

access.cmd.usr.cube = heart subname name commands reload verify-instance \
                      list src-age src-ver show-buffer \
                      buffer-erase buffer-erase-level \
                      scan status list approve reject set-threshold

modules.load = auth net protocol io.unix job-site-scan
[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[base.get_session_id]

[zenka.loop]

