
  .:[ 'window-place' interactive placement zenka ]:.

[load_config_file:'shared-params']
[load_config_file:'X11-vars']
[root.drop_privs:<system.AMOS-user>]

access.cmd.usr.cube = commands heart reload verify-instance * *.*

modules.load = auth net protocol io.unix ui \
               window.profile window.gtk window.place

[load_modules:<modules.load>]
[init_modules]

[base.net.connect:'unix']

[base.X-11.get_display]
[base.X-11.get_geometry]

[base.get_session_id]

## idle: window is opened on-demand via the place_window command ##

## main event loop - GTK if graphical mode, zenka event loop if TTY ##
[base.gtk.main_loop]

