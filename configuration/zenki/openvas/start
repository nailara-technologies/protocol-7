
  .:[ openvas zenka [ vulnerability scan orchestration [ greenbone ] ] ]:.

[load_config_file:'shared-params']

system.zenka.verbosity.buffer  = 2
system.zenka.verbosity.console = 1

## cube to openvas [ parent commands ]
access.cmd.usr.cube = commands heart verify-instance name reload src-age \
                      list show-buffer buffer-erase buffer-erase-level \
                      status src-ver show-access
                      ## scan.run intentionally not network-exposed :    ##
                      ## openvas.scan.run is an internal module ..,       ##
                      ## openvas.cmd.* exposure arrives with phase 2      ##

## backend control path [ see modules/openvas.scan.run header for reasoning ]
## greenbone community containers provide gvmd + ospd-openvas + nvt feed ..
## control via gvm-tools [ GMP protocol ] over the gvmd unix socket
openvas.cfg.helper        = <system.root_path>/configuration/zenki/openvas/bin/openvas_scan.py
openvas.cfg.gvmd_socket   = /run/gvmd/gvmd.sock
openvas.cfg.container     = openvas-gvmd    ## docker container exposing socket
openvas.cfg.gvmd_user     = admin           ## community container defaults ..
openvas.cfg.gvmd_pass     = admin           ## override for production use ..,
openvas.cfg.poll_interval = 15              ## seconds between status polls
openvas.cfg.scan_timeout  = 14400           ## 4h max per scan

## zenka data dir [ scan result yaml written here ]
openvas.cfg.data_dir      = <system.root_path>/data/openvas

## named scan profiles [ map to greenbone scan config names ]
## fast recon : discovery-shaped .., full : complete nvt run ..,
## compliance-shaped profile placeholder until feed policy is defined
openvas.profile.fast.name       = Host Discovery
openvas.profile.full.name       = Full and fast
openvas.profile.compliance.name = Base

modules.load = auth.client net protocol io.unix ui format.yaml openvas
[load_modules:<modules.load>]
[init_modules]

[load_config_file:'zenki/openvas/access.zenki']

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[base.get_session_id]

[zenka.loop]

