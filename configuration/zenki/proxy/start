
 .:[ protocol-7 web proxy zenka ]:.

[load_config_file:'shared-params']

proxy.cfg.listen_address  = 127.0.0.1
proxy.cfg.listen_port     = 8118
proxy.cfg.selector_config = '<system.root_path>/data/yaml/web-proxy/template-selector.yaml'
proxy.cfg.visit_log       = data/yaml/web-proxy/visit-log.yaml
proxy.cfg.transport       = direct

access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase buffer-erase-level \
                      show-access src-ver src-age subname name status \
                      deparse-code dump core-subs change-log-verbosity *

## [ note ] bare '*' matches single-segment commands only [ regex [^\.]+ ] ;
## the cred-mesh rotation-notify subscriber target is now the single-segment
## 'cred-rotated' (proxy.cmd.cred-rotated, cube strips both zenka prefix and
## '.cmd.'), already covered by the wildcard above -- see
## data/tasks/completed/cred-mesh-rotation-subscription-cross-zenka.md for
## why the old multi-dot 'handler.cred_rotated' target never worked.

env_override_allowed = PROTOCOL_7_VAR

modules.load = auth net protocol io.unix io.ip ui clients.http clients.https \
                                     format.yaml httpd.status_codes proxy devmod

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[base.get_session_id]

[zenka.loop]

