inference.backend.cpu.threads = 8  ## Use system thread count ##

## Routing Configuration ##
inference.routing.prefer_gpu = yes  ## Use GPU when available ##
inference.routing.gpu_timeout = 30000  ## 30 seconds in ms ##
inference.routing.cpu_timeout = 300000  ## 300 seconds in ms ##
inference.routing.fallback_on_timeout = yes  ## Try CPU if GPU times out ##

## Async Mode Configuration ##
coding.async.enabled = 1  ## Use non-blocking HTTP streaming with tool execution loop ##

## concurrent drain timeout: seconds to wait for in-flight inference before force-kill ##
concurrent.drain_timeout = 300

## context reduction on timeout-restart: step and floor values ##
## ctx_recovery_ceiling is set at runtime by coding.callback.http_error : ##
## a hard cap that spawn_inference_server enforces over auto-calc, so the ##
## reduction actually takes effect on the restart that follows a timeout  ##
coding.cfg.ctx_timeout_step  = 7000
coding.cfg.ctx_timeout_floor = 16000
#coding.cfg.ctx_recovery_ceiling = 29000  ## [ runtime-managed, do not set here ]

#
## [timeouts] streaming data begin and total request duration ##
#
## data-start floor : short prompts really do start streaming in <2s on   ##
## local GPU. for larger prompts coding.async.http_client SCALES this up  ##
## based on estimated prompt size — see prefill_tokens_per_sec/_margin    ##
coding.http-timeouts.data-start = 120
coding.http-timeouts.request-completed = 777

## stall/inactivity timeout : fires on genuine silence [ no chunk for N   ##
## seconds ], independent of total elapsed time — re-armed on every chunk ##
coding.http-timeouts.stall = 77

## adaptive ceiling : a round starts with this fast soft ceiling; hitting ##
## it escalates the SAME round to the full request-completed ceiling      ##
## above rather than failing it, and resets back to this value once a     ##
## round completes cleanly — halves typical stuck-round recovery time     ##
## without permanently punishing legitimately-slow rounds                 ##
coding.cfg.round_soft_ceiling = 384

## GPU-temp-aware timeout stretch : a thermally-throttled GPU is          ##
## legitimately slower, not stalled, so the soft ceiling + stall timeout  ##
## above both scale with coding.stretch.timeout_factor (continuous        ##
## proportional feedback, recomputed on every temp reading in             ##
## coding.handler.gpu_temp_update -- ramps up fast when over target,      ##
## relaxes slowly when cooling, clamped to [1.0, 3.0]). Target below is   ##
## tuned from observed behavior (slowdowns already seen around 80C in     ##
## practice on this WSL setup), not a vendor spec number.                 ##
coding.cfg.gpu_target_temp_c = 77

## prefill-time estimate used to scale the data-start timeout for large    ##
## prompts : timeout = est_prompt_tokens / prefill_tokens_per_sec + margin ##
## tune prefill_tokens_per_sec down if timeouts persist on long contexts   ##
coding.cfg.prefill_tokens_per_sec = 600
coding.cfg.prefill_margin_sec     = 5

## cold-start grace : flat data-start timeout for the FIRST request to a  ##
## freshly-(re)spawned server — model load / first-inference warmup adds  ##
## latency independent of prompt size, and that first request is often    ##
## small [ short initial prompt ], so prompt-size scaling alone would     ##
## hand it the shortest timeout right when it needs the longest. cleared  ##
## on first chunk received [ coding.callback.http_chunk ]                 ##
coding.cfg.cold_start_data_start_timeout = 150

## switch-model poll_switch per-phase timeout : the prior flat 120s        ##
## covers spawn + disk load + ready, not just inference - a large model    ##
## (9GB+) cold-loading from disk can outrun 120s outright, confirmed live  ##
## 2026-06-21 [ DVEAZIA:GPAKBLA switch timed out mid-load ]. raised, kept  ##
## configurable rather than re-hardcoded - see feedback-ondemand-timeout-  ##
## tiering ]                                                               ##
coding.cfg.switch_model_max_wait = 300

## vision-model :switch: idle-wait bound : caller timeout defaults to   ##
## this when omitted - bounds ONLY the wait-for-idle phase, the switch  ##
## itself is governed by switch_model_max_wait above                    ##
coding.cfg.vision_switch_idle_timeout = 300

## Model Configuration ##
## Context length: floor value — auto-calculated from VRAM, but never below this   ##
## smaller models expand above this automatically; large models use this as a min  ##
## lowered from 52000 : calculate_safe_context's own auto-calc for the current     ##
## vision-capable default (ZDMAPAY:AR3OCKQ) came out to ~29020, but the 52000      ##
## floor overrode it [ "user override" in the startup log ], and even 29020        ##
## wouldn't have been fully safe -- calculate_safe_context accounts for the        ##
## mmproj FILE size but not the vision encoder's separate runtime compute buffer   ##
## [ observed failing: 558MB CUDA alloc OOM during vision warmup, only 188MB free  ##
## at 52000 ]. 28000 tokens frees ~985MB of KV cache vs. 52000 [ 42KB/token *9B    ##
## class KV estimate ], comfortably covering the missing margin. revisit per-model ##
## if a future default is text-only and could again afford a much higher floor     ##
inference.model.context_length = 28000
## inference.model.context_length = 52000 ## [ prior value, doubled for multi-round tool sessions -- unsafe for vision-capable defaults, see above ##
## inference.model.context_length = 32000 ## [ temporary override ] ##
#inference.model.max_tokens = 32000  ## defaults to context_length if unset
inference.model.temperature = 0.7
inference.model.seed = 0  ## 0 = harmonic seed from ntime+fortuna, >0 = fixed ##

## VRAM safety margin for context auto-calculation [calculate_safe_context]    ##
## safety = 30% of remaining VRAM, clamped to [min, max]                       ##
coding.cfg.vram_safety_min_mb = 300   ## lower to allow larger context windows ##
## raised 3000 -> 4000 : calculate_safe_context doesn't budget for a vision    ##
## encoder's runtime compute buffer (only the mmproj file's static size),      ##
## this margin is the practical place to absorb that gap for any current or    ##
## future vision-capable default, not just the context_length floor above      ##
coding.cfg.vram_safety_max_mb = 4000  ## cap to reserve VRAM for other use     ##

## context ceiling for auto-calculation — 0 = uncapped (VRAM math decides) ##
## code default is 131072; override here for this system                   ##

coding.cfg.context_max = 38777

## Default model AMOS checksum [ resolved from models zenka during init ] ##
##
#inference.model.amos_id = ZDMAPAY:AR3OCKQ  ## Qwopus3.5 9B v3 ##

inference.model.amos_id = <coding.cfg.start_model>

## not declared here : resolved at init via async network request to models ##
## zenka [ coding.resolve_model_path -> coding.handler.model_path_reply ] — ##
## a placeholder value here would get re-applied [ clobbering the resolved  ##
## path ] every time 'reload config'/'reload all' re-parses this file       ##

modules.load = auth.client net protocol io.unix io.ip ui jobqueue crypt.C25519 \
               coding models.conversation storage context ascii \
               note pager format.yaml ncode devmod reasoning ## <-- during development

## storage plugins [ loaded separately via load_plugins ] ##
## todo: consider generic auto-load mechanism for all zenki ##
plugins.load = plugin.storage.inference plugin.storage.util.inference

[load_modules:<modules.load>]

## loading storage plugins [ before init_modules so init_code runs ] ##
[load_plugins:<plugins.load>]

[init_modules]

## drop_privs moved to coding.init_code [ after path setup + chmod child ] ##

[base.net.connect:'unix'] ## [ has network from here ] ##

## Resolve configured model path from models zenka registry
[coding.resolve_model_path]

[get_session_id]

[zenka.loop]

