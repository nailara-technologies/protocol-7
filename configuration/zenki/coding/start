
 .:[ protocol-7 coding zenka - GPU+CPU dual inference ]:.

# coding.cfg.start_model = SJCPFAQ:AGKY7YQ ## Qwen3.5 4B Claude 4.6 Reasoning Distilled v2 ##
coding.cfg.start_model   = WZIZD6Y:2BIZKWY ## Qwen3.5 9B Claude 4.6 Reasoning Distilled v2 ##

[load_config_file:'shared-params']
[zenka.load_sub_list]

[base.white-list.register:'coding.handler']

access.cmd.usr.cube = commands heart reload verify-instance list show-buffer \
                      src-age buffer-erase buffer-erase-level budget status \
                      inference-status submit get-result analyze_and_extract \
                      src-ver complete-analysis resume-analysis ask-reply \
                      switch-model show-prompt match-template dump-env list-subs \
                      vision-parser.analyze_and_extract vision-parser.status \
                      infer query test-inference clear-registry clear-cache \
                      receive-multiline staged-diff staged-clear \
                      clear-applied apply-staged tree-read tree-list \
                      tree-write list-tools call-tool get set dump \
                      inject-message stop-task async-test wait-done \
                      list-tasks task-info pause-task resume-task \
                      execute_round last-compaction task-append

system.verbosity.zenka_buffer  = 2  ##  memory ring buffer verbosity   ##
system.verbosity.zenka_console = 2  ##  console [debugging] verbosity  ##

## Enable automatic user key creation for coding zenka ##
crypt.C25519.autocreate-user-key = yes

## project file write access [ apply-staged ] ##
coding.cfg.assume_admin_group = yes  ## run with project owner's group ##
coding.cfg.allow_chmod_apply  = yes  ## chmod g+w target files during apply ##

## round-based scheduling: each inference round is a discrete jobqueue job ##
## enables fair multiplexing across tasks and natural subtask trees       ##
coding.async.round_scheduling.enabled = yes    ## set to yes when proven ##

## jinja: disable to work around new binary crash on tool calls ##
coding.jinja.enable = yes
## fixed chat template file [ empty = use model's built-in template ] ##
## qwen3.5: data/jinja/templates/qwen3.5-fixed.jinja [ froggeric bug fixes ] ##
## qwen3.6: data/jinja/templates/qwen3.6-fixed.jinja                         ##
coding.jinja.template_file = /data/projects/protocol-7/data/jinja/templates/qwen3.5-fixed.jinja
## reasoning effort: low/medium/high — empty = model default [ no kwarg sent ] ##
## low prevents runaway <think> spirals; use medium/high for complex tasks      ##
coding.inference.reasoning_effort = low
# coding.jinja.convert_tool_role = yes ## testing..
coding.jinja.convert_tool_role = false

## GPU+CPU Dual Inference Configuration ##
inference.backend.lib_path = /data/source/ik_llama.cpp
inference.backend.gpu.enabled = yes
inference.backend.gpu.binary = /data/source/ik_llama.cpp/llama-server-cuda-fa
inference.backend.gpu.vram_threshold = 3221225472  ## 3GB in bytes
##                                            [ Gemma3 Glitter is 2.21GB ] ##
inference.backend.gpu.gpu_layers = 33  ## Full offload for RTX 3060 ##

inference.backend.cpu.enabled = yes
inference.backend.cpu.binary = /data/source/ik_llama.cpp/llama-server-cpu

### [ CURRENT DEFAULT MODELS ]
##

### Qwen3.5-9B-Uncensored-Aggressive Q8 ###
##
# inference.backend.gpu.model_id = YHIIJ5I:I7MZ3UI
# inference.backend.cpu.model_id = YHIIJ5I:I7MZ3UI

### Qwen3.5 9B Claude Opus 4.6 reasoning Distilled v2 ###
##
# inference.backend.gpu.model_id = WZIZD6Y:2BIZKWY
# inference.backend.cpu.model_id = WZIZD6Y:2BIZKWY

### Qwopus3.5 9B v3 ###
##
#inference.backend.gpu.model_id = ZDMAPAY:AR3OCKQ
#inference.backend.cpu.model_id = ZDMAPAY:AR3OCKQ

inference.backend.gpu.model_id = <coding.cfg.start_model>
inference.backend.cpu.model_id = <coding.cfg.start_model>

inference.backend.cpu.threads = 8  ## Use system thread count ##

## Routing Configuration ##
inference.routing.prefer_gpu = yes  ## Use GPU when available ##
inference.routing.gpu_timeout = 30000  ## 30 seconds in ms ##
inference.routing.cpu_timeout = 300000  ## 300 seconds in ms ##
inference.routing.fallback_on_timeout = yes  ## Try CPU if GPU times out ##

## Async Mode Configuration ##
coding.async.enabled = 1  ## Use non-blocking HTTP streaming with tool execution loop ##

## Model Configuration ##
## Context length: floor value — auto-calculated from VRAM, but never below this ##
## smaller models expand above this automatically; large models use this as a min ##
## inference.model.context_length = 63000  ## doubled for multi-round tool sessions ##
inference.model.context_length = 32000
## inference.model.max_tokens = 17777  ## defaults to context_length if unset
inference.model.temperature = 0.7
inference.model.seed = 0  ## 0 = harmonic seed from ntime+fortuna, >0 = fixed ##

## VRAM safety margin for context auto-calculation (calculate_safe_context) ##
## safety = 30% of remaining VRAM, clamped to [min, max]                   ##
coding.cfg.vram_safety_min_mb = 512   ## lower to allow larger context windows ##
coding.cfg.vram_safety_max_mb = 3072  ## cap to reserve VRAM for other use     ##

## context ceiling for auto-calculation — 0 = uncapped (VRAM math decides) ##
## code default is 131072; override here for this system                   ##
# coding.cfg.context_max = 131072
coding.cfg.context_max = 110007

## Default model AMOS checksum [ resolved from models zenka during init ] ##
##
#inference.model.amos_id = ZDMAPAY:AR3OCKQ  ## Qwopus3.5 9B v3 ##

inference.model.amos_id = <coding.cfg.start_model>

inference.model.path = null  ## Resolved during init via network request ##

modules.load = auth net protocol io.unix io.ip jobqueue crypt.C25519 \
               coding models.conversation storage context \
               note pager format.yaml ncode devmod ## <-- during development

## storage plugins [ loaded separately via load_plugins ] ##
## todo: consider generic auto-load mechanism for all zenki ##
plugins.load = plugin.storage.inference plugin.storage.util.inference

[load_modules:<modules.load>]

## loading storage plugins [ before init_modules so init_code runs ] ##
[load_plugins:<plugins.load>]

[init_modules]

## drop_privs moved to coding.init_code [ after path setup + chmod child ] ##

[base.net.connect:'unix'] ## [ has network from here ] ##

## Resolve configured model path from models zenka registry
[coding.resolve_model_path]

[get_session_id]

[zenka.loop]

