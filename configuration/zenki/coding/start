
 .:[ protocol-7 coding zenka - GPU+CPU dual inference ]:.

[load_config_file:'shared-params']

access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase buffer-erase-level \
                      budget status submit analyze_and_extract \
                      complete-analysis resume-analysis \
                      vision-parser.analyze_and_extract vision-parser.status \
                      infer query test-inference \ ## ^ <- coding zenka comands ##
                      get set dump ## <-- development commands to access %data. ##

system.verbosity.zenka_buffer  = 2  ##  memory ring buffer verbosity   ##
system.verbosity.zenka_console = 2  ##  console [debugging] verbosity  ##

## Enable automatic user key creation for coding zenka ##
crypt.C25519.autocreate-user-key = yes

## GPU+CPU Dual Inference Configuration ##
inference.backend.gpu.enabled = yes
inference.backend.gpu.binary = /data/source/ik_llama.cpp/llama-server-cuda-fa
inference.backend.gpu.model_id = gemma3-glitter-4b  ## Fetched from models zenka during init ##
inference.backend.gpu.vram_threshold = 3221225472  ## 3GB in bytes (Gemma3 Glitter is 2.21GB) ##
inference.backend.gpu.gpu_layers = 33  ## Full offload for RTX 3060 ##

inference.backend.cpu.enabled = yes
inference.backend.cpu.binary = /data/source/ik_llama.cpp/llama-server-cuda-fa
inference.backend.cpu.model_id = gemma3-glitter-4b  ## Fetched from models zenka during init ##
inference.backend.cpu.threads = 8  ## Use system thread count ##

## Routing Configuration ##
inference.routing.prefer_gpu = yes  ## Use GPU when available ##
inference.routing.gpu_timeout = 30000  ## 30 seconds in ms ##
inference.routing.cpu_timeout = 300000  ## 300 seconds in ms ##
inference.routing.fallback_on_timeout = yes  ## Try CPU if GPU times out ##

## Model Configuration ##
inference.model.context_length = 2048  ## Reduced for GPU memory (Gemma3 needs ~16GB at full 131k context) ##
inference.model.max_tokens = 256
inference.model.temperature = 0.7

## Default model AMOS checksum (resolved from models zenka during init) ##
inference.model.amos_id = O6A7F7Q:YMKOEDI  ## hackidle-nist-coder-v1.1-q4_k_m (security-aware, lightweight) ##
inference.model.path = null  ## Resolved during init via network request ##

modules.load = auth net protocol io.unix io.ip jobqueue crypt.C25519 coding \
                                                         models.conversation \
                                   devmod ## <-- enabled for development [LLL]
[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>] ## [LLL] needs hybrid mode version

[base.net.connect:'unix']
[get_session_id]

[zenka.loop]

