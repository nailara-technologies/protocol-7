## [:< ##

# name  = zenka-startup.v7
# descr = 'coding' zenka startup configuration used by 'v7' zenka

dependencies    = cube models
max_concurrency = 1

: v7-init :
  start_mode = stdin-zenka
  coding.key = [base.prng.chars-anum:44]
  [v7.callback.setup_zenka_key:<instance_id>,'<zenka_name>',<coding.key>]

: zenka-init :
  [base.auth.set_zenka_key:'<{coding.key}>']

