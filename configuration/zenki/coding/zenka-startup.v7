## [:< ##

# name  = zenka-startup.v7
# descr = 'coding' zenka start-up configuration used by 'v7' zenka
# purpose = Orchestration engine startup - task routing, LLM consensus, token economy

max_concurrency   = 1
heartbeat.timeout = 7

: v7-init :
  start_mode = stdin-zenka
  coding.key = [base.prng.chars-anum:44]

: zenka-init :
  [base.auth.set_v7_key:'<{coding.key}>']

: v7-post-init :
  status.post-init = [v7.callback.connect_to_cube:<instance_id>]
  [v7.callback.register_ondemand]

: startup-error :
  [v7.teardown:'start of coding zenka not successful']

