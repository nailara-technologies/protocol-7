
 .:[ 'ncode' source-code command zenka ]:.

[load_config_file:'shared-params']
system.access.wildcards.allow = false

## read-only : repo browsing/search/diff is public, zero-risk ##
## write/sign commands intentionally NOT granted here yet -- pending a  ##
## signature-gated approval system [ see memory: topic-write-access-   ##
## security-infrastructure ] ## cube itself filters which of its own   ##
## callers may reach these -- taeki/unix-admin already covered via the ##
## cube-side admin wildcard [ configuration/zenki/cube/access.users ]  ##
access.cmd.usr.cube = commands heart verify-instance \
                      list show-buffer get_url reload \
                      child.cur-pid \
                      search diff diff-staged doc parse-headers tool_list

access.cmd.usr.parent = commands show-buffer cur-pid

access.cmd.usr.child = cube.v7.notify_online cube.p7-log.append

## group-write grant on .git only [ needed for git diff/diff-staged index  ##
## refresh -- read-only git ops still need to write .git's lock/index ]   ##
ncode.cfg.assume_admin_group = yes
ncode.cfg.allow_chmod_apply  = yes

modules.load = auth.client net protocol io.unix ui ncode

[load_modules:<modules.load>]
[init_modules]

## drop_privs moved to ncode.init_code [ after path setup + chmod child ] ##

[base.net.connect:'unix']

[get_session_id]

[zenka.loop]

