
   .:[ local cube zenka command access permission set-up ]:.


                access.cmd.usr.*  =  commands clear heart when-present \
                                     whoami present since present-p7-log \
                                     localtime time p7-log.append *.subname \
                                     timestamp ntime-dec amos-chksum \
                                     epoch-num epoch_v7 elf-chksum close \
                                     exit ptl-ver src-ver rel-ver \
                                     reply-encoding-mode X-11.get_display \
                                     X-11.get_geometry \
                                     tile-groups.get_geometry \
                                     tile-groups.assign_window \
                                     tile-groups.get_coordinates \
                                     X-11.get_orientation \
                                     X-11.get_screen_size \
                                     X-11.get_stack_order \
                                     v7.background_zenka loaded-configs \
                                     v7.notify_online v7.restart_own-zenka \
                                     protocol-7-menu.menu-update-notify


               access.cmd.usr.v7  =  heart *.heart session-key \
                                     ondemand-zenka set-initialized \
                                     *.verify-instance \
                                     system.report-X-11-error models.status \
                                     models.reload models.maintenance \
                                     models.discover models.statistics \
                                     models.get_model models.find_models \
                                     models.recommend \
                                     models.record_invocation \
                                     models.cost_analysis

            access.cmd.usr.nodes  =  discover.host_details

         access.cmd.usr.discover  =  *.host-status

         access.cmd.usr.letsencr  =  v7.register_child httpd.vhost-list \
                                     httpd.setup-acme-challenge \
                                     httpd.cleanup-acme-challenge \
                                     httpd.remove-acme-challenge \
                                     httpsd.reload-certificates \
                                     nameserv.set-record \
                                     nameserv.remove-record \
                                     nameserv.get-record

            access.cmd.usr.httpd  =  web.process_template_ipc web.* \
                                     v7.notify_offline \
                                     v7.status \
                                     letsencr.request-certificate \
                                     radio.listen \
                                     nodes.orbital-position \
                                     nameserv.discover-nodes \
                                     graphics-matrix.orbital-sync \
                                     graphics-matrix.cell \
                                     graphics-matrix.cursor \
                                     graphics-matrix.glow

            access.cmd.usr.radio  =  httpd.radio_online v7.notify_offline \
                                     v7.start_once v7.notify_online \
                                     mpv[audio-0].play \
                                     mpv[audio-0].set-volume \
                                     mpv[audio-0].fade \
                                     mpv[audio-1].play \
                                     mpv[audio-1].set-volume \
                                     mpv[audio-1].fade

          access.cmd.usr.cube-13  =  heart p7-log.append list \
                                     v7.report-temp-path \
                                     decoder.receive-entropy

           access.cmd.usr.system  =  v7.stop v7.start X-11.get_driver \
                                     v7.pid-instance v7.notify_online \
                                     v7.restart v7.forced-mod-reload \
                                     v7.register_child X-11.get_xorg_pid \
                                     v7.reboot-warning v7.host-reboot

             access.cmd.usr.X-11  =  v7.restart v7.start_once \
                                     v7.register_child \
                                     tile-groups.gpu_load_alert \
                                     X-11-pointer.blank-cursor \
                                     system.reload_gfx_module \
                                     system.report-X-11-error

          access.cmd.usr.openbox  =  v7.register_child

       access.cmd.usr.notify-osd  =  dbus.socket_address

           access.cmd.usr.notify  =  dbus.socket_address

              access.cmd.usr.mpv  =  v7.start_once X-11.get_mode \
                                     content.get_list reenc-msg.refresh \
                                     reenc-msg.finished v7.notify_online \
                                     X-11.keep_below v7.register_child \
                                     X-11.set_opacity \
                                     X-11.set_geometry \
                                     X-11.wait_visible \
                                     ffmpeg[mpv].rescale_video

             access.cmd.usr.dbus  =  v7.register_child

             access.cmd.usr.melt  =  ffmpeg[melt].frame_count

    access.cmd.usr.menu-commands  =  protocol-7-menu.menu-update-notify

    access.cmd.usr.protocol-7-menu  =  menu-commands.list-mappings \
                                       menu-commands.list-categories \
                                       menu-commands.get-provider-data

             access.cmd.usr.udev  =  notify.message

        access.cmd.usr.universal  =  v7.restart v7.start_once \
                                     pdf2html.get_url X-11.bg_color \
                                     X-11.get_mode X-11.gpu_load \
                                     content.get_list reenc-msg.refresh \
                                     image2html.get_url melt.extract_frame \
                                     content.set_flags reenc-msg.finished \
                                     v7.notify_online v7.stop_implicit \
                                     X-11.keep_below X-11.hide_window \
                                     X-11.set_opacity \
                                     tile-groups.get_subconfig \
                                     X-11.lower_window \
                                     X-11.raise_window \
                                     X-11.set_geometry \
                                     X-11.wait_visible \
                                     X-11.unhide_window \
                                     content.get_list_types \
                                     content.get_list_types \
                                     ffmpeg[mpv].rescale_video \
                                     content.entries_withheld \
                                     v7.register_child \
                                     v7.report-temp-path

            access.cmd.usr.power  =  power-x11.set_states

          access.cmd.usr.set-up   =  get-config *.get-config \
                                     *.get-config-names

           access.cmd.usr.events  =  content.update v7.start_once \
                                     tile-groups.add_overlay \
                                     tile-groups.remove_overlay \
                                     tile-groups.reset-tile-group \
                                     tile-groups.switch-tile-group \
                                     v7.stop_implicit v7.restart

          access.cmd.usr.content  =  v7.restart weather.get-urls \
                                     *.playlist_update notify.msg_reload \
                                     download.get_mimetype \
                                     events.get_playlist_hidden \
                                     events.get_playlist_exclusive

      access.cmd.usr.tile-groups  =  v7.start notify.warn v7.restart \
                                     universal.slow_down content.update \
                                     v7.start_once X-11.bg_color \
                                     X-11.fade_out web-browser.slow_down \
                                     content.get_list v7.notify_online \
                                     v7.stop_implicit v7.notify_offline \
                                     ticker.slow_down \
                                     X-11.lower_window \
                                     v7.get-instance-ids \
                                     X-11.get_window_ids \
                                     X-11.get_stack_order \
                                     screenshot.get_region_color

      access.cmd.usr.web-browser  =  pdf2html.get_url X-11.bg_color \
                                     X-11.gpu_load image2html.get_url \
                                     content.set_flags \
                                     tile-groups.get_subconfig \
                                     X-11.raise_window X-11.lower_window \
                                     X-11.wait_visible \
                                     content.get_list_types \
                                     content.entries_withheld \
                                     v7.report-temp-path

          access.cmd.usr.compton  =  X-11.get_mode X-11.get_driver \
                                     X-11.bg_color v7.register_child

          access.cmd.usr.storage  =  v7.report-temp-path

       access.cmd.usr.remote-cam  =  content.get_list X-11.wait_visible

           access.cmd.usr.pcycle  =  power.on power.off

         access.cmd.usr.osd-logo  =  download.get_file v7.stop_implicit \
                                     graphics-matrix.filter X-11.get_display

      access.cmd.usr.storchencam  =  X-11.wait_visible

        access.cmd.usr.power-x11  =  power.on power.off power.show_all

        access.cmd.usr.reenc-msg  =  v7.stop_implicit

       access.cmd.usr.image2html  =  X-11.bg_color

          access.cmd.usr.lm-vision = whoami present timestamp ntime-dec \
                                     models.get_model_path models.discover \
                                     models.get_entry \
                                     models.find_alternative \
                                     models.record_invocation \
                                     models.statistics v7.register_child \
                                     close exit coding.inference-status \
                                     v7.notify_online

            access.cmd.usr.coding  = lm-vision.analyze_image \
                                     models.get_model_path \
                                     models.get_path_by_amos models.list_all \
                                     models.discover models.recommend \
                                     models.get_entry models.get_model \
                                     models.record_invocation \
                                     models.statistics \
                                     models.substitute_template \
                                     models.conversation_create \
                                     models.conversation_add_turn \
                                     models.find_alternative \
                                     models.conversation_get_context \
                                     v7.register_child task.queue task.show \
                                     task.claim task.complete task.fail \
                                     task.reset

           access.cmd.usr.models  =  v7.register_child coding.ask-reply \
                                     kimi.ask-reply \
                                     task.queue task.show task.claim \
                                     task.complete task.fail \
                                     context.delegate.role \
                                     context.delegate.prepare \
                                     context.delegate.dispatch

             access.cmd.usr.kimi  =  v7.register_child \
                                     task.queue task.show task.claim \
                                     task.complete task.fail task.reset \
                                     kimi-web.list_agents kimi-web.spawn_agent

          access.cmd.usr.kimi-web =  v7.register_child \
                                     task.queue task.show task.claim \
                                     task.complete task.fail task.reset

             access.cmd.usr.task  =  v7.register_child \
                                     v7.notify_online v7.restart_concurrent \
                                     models.task-notify

             access.cmd.usr.work  =  task.queue task.show task.claim \
                                     task.complete task.fail task.reset

          access.cmd.usr.context  =  coding.ask-reply kimi.ask-reply \
                                     task.status task.complete task.fail \
                                     models.status models.list

            access.cmd.usr.zulum  =  decoder.receive-entropy *.receive-entropy

       access.cmd.usr.vision-batch = whoami present timestamp ntime-dec \
                                     image-quality.analyze models.get_entry \
                                     models.get_model_path models.discover \
                                     models.record_invocation models.recommend \
                                     models.statistics v7.register_child

            access.cmd.usr.data  =  graphics-matrix.assert-similarity \
                                     graphics-matrix.visual.cubic-sort

      access.cmd.usr.image-quality =  whoami present timestamp ntime-dec \
                                     graphics-matrix.assert-similarity

       access.cmd.usr.impressive  =  v7.start_once content.get_list \
                                     v7.notify_online v7.stop_implicit \
                                     v7.register_child X-11.set_opacity \
                                     X-11.raise_window X-11.wait_visible \
                                     X-11.bg_color tile-groups.get_subconfig

       access.cmd.usr.start-anim  =  X-11.wait_visible X-11.bg_color \
                                     v7.report-temp-path

            access.cmd.usr.web  =  nodes.orbital-position \
                                     nameserv.discover-nodes \
                                     graphics-matrix.orbital-sync \
                                     graphics-matrix.cell \
                                     graphics-matrix.cursor \
                                     graphics-matrix.glow

           access.cmd.usr.invoke  =  invoke-web.start invoke-web.status \
                                     invoke-web.health v7.register_child

       access.cmd.usr.invoke-web  =  v7.register_child

         access.cmd.usr.nameserv  =  v7.register_child

       access.cmd.usr.rss-ticker  =  content.get_list ticker.read_file

           access.cmd.usr.ticker  =  tile-groups.get-layer X-11.gpu_load \
                                     v7.notify_online X-11.bg_color \
                                     tile-groups.get_subconfig \
                                     rss-ticker.resend_update

       access.cmd.usr.amos-term  =   amos-term.list_attachments \
                                     amos-term.attach_buffer \
                                     amos-term.mount-9p \
                                     amos-term.window-create \
                                     amos-term.window-open \
                                     amos-term.window-close \
                                     amos-term.window-destroy \
                                     amos-term.list-windows

