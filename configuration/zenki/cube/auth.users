
 .:[ local cube user authentication set-up ]:.


auth.setup.usr.root         = :unix:root       ## used by './bin/nshell' ##

## [ taeki + unix-taeki setup - TEMPLATE-BASED ]
auth.setup.usr.<admin-user> = :unix:<unix-admin>,:unix:<admin-user>
auth.setup.usr.<unix-admin>  = :unix:<unix-admin>,:unix:<admin-user>

## ## ##
## # ## ## ### ........... works ................................
auth.setup.usr.unix-kitten = :unix:root,:unix:<system.admin-user>
auth.setup.usr.kitten      = :unix:root :unix:<system.admin-user> #res.#:'unix:taeki'
## # ## ## ### ........... works ................................
## ## ##
## ##
##
                                              # 'unix-*' are used by ./bin/p7
auth.setup.usr.unix-root       = :unix:root,protocol-7   ## ,.adjust these as desired ..,
auth.setup.usr.unix-protocol-7 = :unix:root,protocol-7

auth.setup.usr.notify-loves = :unix:protocol-7,<unix-AMOS-user>
auth.setup.usr.notify-warn  = :unix:protocol-7,<unix-AMOS-user>
auth.setup.usr.notify-info  = :unix:protocol-7,<unix-AMOS-user>
auth.setup.usr.power-x11    = :unix:<unix-admin>,<unix-AMOS-user>

## [ auth-keypair authentication - Ed25519 signature verification ]
## Format: auth <username> <c25519_pubkey_b32> <ed25519_signature_b32>
## Master key registered via: register-master-key <username> <ed25519_pubkey_b32>
auth.setup.usr.taeki              = :unix:taeki,:auth-keypair:
auth.setup.usr.test-auth-keypair  = :auth-keypair:

##  use './bin/mk.usr' to create users with password hashes  ##

