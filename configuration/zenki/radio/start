
 .:[ 'radio' relay zenka ]:.

[load_config_file:'shared-params']

system.verbosity.zenka_buffer = 2

access.cmd.usr.cube = commands heart reload verify-instance \
                      show-buffer buffer-erase buffer-erase-level list \
                      src-age cur-pid start stop status listen \
                      *  ## devmod

modules.load = auth net protocol io.unix radio

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

radio.stream.url          = https://cast.magicstreams.gr/sc/psyndora
radio.stream.auto_connect = yes

[base.net.connect:'unix']

[base.get_session_id]

[zenka.loop]

