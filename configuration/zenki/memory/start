
.:[ nailara [ memory ] zenka : focus-weighted memory tree ]:.

[load_config_file:'shared-params']

modules.load          = net protocol io.unix auth \
                        base.curve base.sort base.sort-num \
                        base.chk-sum.jha ascii.frame format.yaml \
                        context.memory memory devmod # <- !!

access.cmd.usr.cube   = verify-instance commands heart reload \
                        show-buffer src-age src-ver list \
                        show render tree focus init startup \
                        dedup summarize zoom \
                        get set del dump exec-sub eval-code \
                        deparse-code list-subs ## <-- dev only

memory.cfg.n_visible        = 7
memory.cfg.n_max_cap        = 13
memory.cfg.focus_decay      = 0.85
memory.cfg.ai_mem_dir       = data/ai-mem
memory.cfg.git_commit_limit = 200

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

