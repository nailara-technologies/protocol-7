## [:< ##

# name  = zenka-startup.v7
# descr = 'invoke' zenka startup configuration used by 'v7' zenka

dependencies = cube

start.on-demand    = 1
restart.disabled   = 1
heartbeat.disabled = 1
max_concurrency    = 1

: v7-init :
  start_mode = stdin-zenka
  invoke.key = [base.prng.chars-anum:44]
  [v7.callback.setup_zenka_key:<instance_id>,'<zenka_name>',<invoke.key>]

: zenka-init :
  [base.auth.set_zenka_key:'<{invoke.key}>']
  [base.zenki.set_ondemand_timeout:300]

