
# name  = events-setup.letsencr
# descr = Event handlers for Let's Encrypt certificate management

.: events :.

    enabled = letsencr-cert-updated letsencr-renewal-failed letsencr-renewal-check

    - letsencr-cert-updated

      : action :
        type    = send-command
        command = httpsd.reload_certificates

    - letsencr-renewal-failed

      : action :
        type    = send-command
        command = log.error
        params  = "Certificate renewal failed"

    - letsencr-renewal-check

      : action :
        type    = send-command
        command = letsencr.status

    - letsencr-critical-failure

      : action :
        type    = zenka-present
        zenka-name = letsencr

.: timetable :.

  - letsencr-renewal-check
    at  =  HH:05:00
    # runs 5 minutes past each hour to check certificate expiration

  - letsencr-renewal-failed
    at  =  HH:15:00
    # runs 15 minutes past each hour to retry failed renewals

