
# name  = events-setup.letsencr
# descr = event handlers [ includes base events ]

.: events :.

    enabled = letsencr-renewal forensics

    - letsencr-renewal

      : action :
        type       = zenka-present
        zenka-name = letsencr

    - forensics

      : action :
        type       = zenka-present
        zenka-name = forensics

    - dist-upgrade

      : action :
        type       = zenka-present
        zenka-name = dist-upgrade


.: timetable :.

  - forensics
    at  =  04:07

  - dist-upgrade
    at  =  03:47

  - letsencr-renewal
    at  =  HH:05:47

