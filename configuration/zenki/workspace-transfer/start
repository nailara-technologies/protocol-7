.:[ protocol-7 workspace-transfer zenka ]:.

[load_config_file:'shared-params']

system.zenka.verbosity.buffer  = 2
system.zenka.verbosity.logfile = 2

worspace-transfer.repo_path_symlink = configuration/development/\
                                       workspace-transfer-repository

access.cmd.usr.cube = commands bootstrap init status-check checkpoint \
                      quick-save sign verify load-checkpoint \
                      transfer-to-protocol7 todo bug todo-commit bug-commit \
                      configure-remote-PAT handoff *

modules.load = auth.client net protocol io.unix ui workspace-transfer

