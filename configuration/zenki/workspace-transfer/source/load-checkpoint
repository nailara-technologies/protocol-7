#!/usr/bin/perl
## [:< ##

# name  = workspace-transfer.load-checkpoint
# descr = Load and view saved conversation checkpoints

use v5.24;
use strict;
use English;
use warnings;
use File::Spec;
use Cwd qw| abs_path |;
use FindBin qw| $RealBin |;

my $up_dir = File::Spec->updir;
my $p7_root = abs_path(
    File::Spec->catdir( $RealBin, ($up_dir) x 4 )
);

# Get workspace directory (auto-clones if needed)
my $ensure_workspace = File::Spec->catfile( $RealBin, 'ensure-workspace' );
my $workspace_transfer = `$ensure_workspace`;
chomp $workspace_transfer;
die "Failed to ensure workspace\n" unless $workspace_transfer && -d $workspace_transfer;

my $load_checkpoint_script = File::Spec->catfile(
    $workspace_transfer, 'scripts', 'load-context-checkpoint.pl'
);

die ":\n:: workspace-transfer not found: $workspace_transfer\n\n" if !-d $workspace_transfer;
die ":\n:: load-context-checkpoint.pl not found: $load_checkpoint_script\n\n" if !-x $load_checkpoint_script;

chdir $workspace_transfer or die "Cannot cd to workspace-transfer: $!\n";

exec( $load_checkpoint_script, @ARGV );

