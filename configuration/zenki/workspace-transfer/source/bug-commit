#!/usr/bin/perl
## [:< ##

# name  = workspace-transfer.bug-commit
# descr = Add bug and auto-commit/push to GitHub

use v5.24;
use strict;
use English;
use warnings;
use File::Spec;
use Cwd qw| abs_path |;
use FindBin qw| $RealBin |;

my $up_dir = File::Spec->updir;
my $p7_root = abs_path(
    File::Spec->catdir( $RealBin, ($up_dir) x 4 )
);

# Get workspace directory (auto-clones if needed)
my $ensure_workspace = File::Spec->catfile( $RealBin, 'ensure-workspace' );
my $workspace_transfer = `$ensure_workspace`;
chomp $workspace_transfer;
die "Failed to ensure workspace\n" unless $workspace_transfer && -d $workspace_transfer;

my $bug_script = File::Spec->catfile( $RealBin, 'bug' );

die "Usage: bug-commit <description>\n" unless @ARGV;

# Change to workspace directory
chdir $workspace_transfer or die "Cannot cd to workspace: $!\n";

# Add the bug
system($bug_script, 'add', @ARGV) == 0 or die "Failed to add bug\n";

# Get current branch
my $branch = `git branch --show-current`;
chomp $branch;

# Check if BUGS.md changed
my $status = `git status --short BUGS.md`;
if ($status =~ /BUGS\.md/) {
    say "\nCommitting BUGS.md...";

    system('git', 'add', 'BUGS.md') == 0 or die "git add failed\n";

    my $desc = join(' ', @ARGV);
    my $commit_msg = "bug: Report - $desc";
    system('git', 'commit', '--no-gpg-sign', '-m', $commit_msg) == 0
        or die "git commit failed\n";

    say "Pushing to GitHub...";
    my $result = system('git', 'push', '-u', 'origin', $branch);

    if ($result == 0) {
        say "\n✓ Bug reported, committed, and pushed to GitHub!";
    } else {
        say "\n⚠ Bug reported and committed, but push failed.";
        say "  You may need to configure GitHub PAT.";
        say "  Run 'git push -u origin $branch' manually.";
    }
} else {
    say "\n✓ Bug reported (no changes to commit)";
}

