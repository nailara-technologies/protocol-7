#!/usr/bin/perl
## [:< ##

# name  = workspace-transfer.ensure-workspace
# descr = Ensure workspace-transfer repository is available

use v5.24;
use strict;
use English;
use warnings;
use File::Spec;
use Cwd qw| abs_path |;

my $WORKSPACE_DIR = '/var/run/.7/workspace-transfer';
my $WORKSPACE_REPO = 'https://github.com/nailara-technologies/workspace-transfer.git';

# Check if workspace exists
if (-d $WORKSPACE_DIR && -d "$WORKSPACE_DIR/.git") {
    print "$WORKSPACE_DIR\n";
    exit 0;
}

# Need to clone
say STDERR ":\n:: Workspace not found at $WORKSPACE_DIR";
say STDERR ":: Cloning from $WORKSPACE_REPO\n";

# Create parent directory
system('mkdir', '-p', '/var/run/.7') == 0
    or die "Failed to create /var/run/.7: $!\n";

# Clone repository
my $result = system('git', 'clone', $WORKSPACE_REPO, $WORKSPACE_DIR);

if ($result != 0) {
    die ":\n:: Failed to clone workspace-transfer repository\n\n";
}

say STDERR ":: Workspace cloned successfully\n";

# Verify it worked
if (-d $WORKSPACE_DIR && -d "$WORKSPACE_DIR/.git") {
    print "$WORKSPACE_DIR\n";
    exit 0;
} else {
    die ":\n:: Clone succeeded but workspace directory not found\n\n";
}

