#!/usr/bin/perl
## [:< ##

# name  = workspace-transfer.todo
# descr = Todo list management for workspace-transfer

use v5.24;
use strict;
use English;
use warnings;
use File::Spec;
use Cwd qw| abs_path |;
use FindBin qw| $RealBin |;

my $up_dir = File::Spec->updir;
my $p7_root = abs_path(
    File::Spec->catdir( $RealBin, ($up_dir) x 4 )
);

# Get workspace directory (auto-clones if needed)
my $ensure_workspace = File::Spec->catfile( $RealBin, 'ensure-workspace' );
my $workspace_transfer = `$ensure_workspace`;
chomp $workspace_transfer;
die "Failed to ensure workspace\n" unless $workspace_transfer && -d $workspace_transfer;

my $todo_file = File::Spec->catfile( $workspace_transfer, 'TODO.md' );

# Command handling
my $cmd = shift @ARGV || 'list';

if ($cmd eq 'list') {
    list_todos();
} elsif ($cmd eq 'add') {
    add_todo(@ARGV);
} elsif ($cmd eq 'done') {
    mark_done(@ARGV);
} elsif ($cmd eq 'show') {
    show_details(@ARGV);
} elsif ($cmd eq 'help') {
    show_help();
} else {
    die "Unknown command: $cmd\nRun 'todo help' for usage\n";
}

sub list_todos {
    unless (-f $todo_file) {
        say "No TODOs yet. Add one with: todo add <description>";
        return;
    }

    open my $fh, '<', $todo_file or die "Cannot read $todo_file: $!\n";
    print while <$fh>;
    close $fh;
}

sub add_todo {
    my @description = @_;
    die "Usage: todo add <description>\n" unless @description;

    my $desc = join(' ', @description);
    my $timestamp = localtime();

    open my $fh, '>>', $todo_file or die "Cannot write $todo_file: $!\n";
    print $fh "- [ ] $desc\n";
    print $fh "  - Added: $timestamp\n";
    close $fh;

    say "✓ Todo added: $desc";
}

sub mark_done {
    my ($item_num) = @_;
    die "Usage: todo done <item_number>\n" unless defined $item_num;

    unless (-f $todo_file) {
        say "No TODOs to mark done.";
        return;
    }

    open my $fh, '<', $todo_file or die "Cannot read $todo_file: $!\n";
    my @lines = <$fh>;
    close $fh;

    my $count = 0;
    for my $i (0..$#lines) {
        if ($lines[$i] =~ /^- \[ \]/) {
            $count++;
            if ($count == $item_num) {
                $lines[$i] =~ s/^- \[ \]/- [x]/;
                $lines[$i] =~ s/\n$//;
                $lines[$i] .= " (completed: " . localtime() . ")\n";

                open my $out, '>', $todo_file or die "Cannot write $todo_file: $!\n";
                print $out @lines;
                close $out;

                say "✓ Marked item $item_num as done";
                return;
            }
        }
    }

    say "Item $item_num not found";
}

sub show_details {
    list_todos();  # For now, just show the list
}

sub show_help {
    say "Todo List Management";
    say "";
    say "Usage:";
    say "  todo list              - List all todos (default)";
    say "  todo add <desc>        - Add a new todo";
    say "  todo done <num>        - Mark todo as done";
    say "  todo show              - Show detailed view";
    say "  todo help              - Show this help";
    say "";
    say "Examples:";
    say "  todo add Implement new feature";
    say "  todo done 1";
}

#,,,.,,,.,,,,.,,,..,,.,,,.,,.,,,,.,,,,...,.,.,,,.,.,...,...,,.,,,.,.,,.,,,,.,.,,,.
