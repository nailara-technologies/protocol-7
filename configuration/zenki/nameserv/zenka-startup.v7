## [:< ##

# name  = zenka-startup.v7
# descr = 'nameserv' zenka startup configuration used by 'v7' zenka

dependencies = cube

: v7-init :
  start_mode = stdin-zenka
  nameserv.key = [base.prng.chars-anum:44]
  [v7.callback.setup_zenka_key:<instance_id>,'<zenka_name>',<nameserv.key>]

: zenka-init :
  [base.auth.set_zenka_key:'<{nameserv.key}>']

