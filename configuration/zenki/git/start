
 .:[ protocol-7 git version control zenka ]:.

[load_config_file:'shared-params']

system.verbosity.zenka_buffer = 2
system.verbosity.zenka_logfile = 2

access.cmd.usr.cube = commands commit status diff log \
                      update-version changed-files format \
                      restore-permissions add push pull \
                      check-deps install-deps *

modules.load = auth net protocol io.unix ui git

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

