#!/usr/bin/perl
## [:< ##

# name  = git.commit
# descr = Interactive git commit with harmonic validation

use v5.24;
use strict;
use English;
use warnings;
use File::Spec;
use Cwd qw| abs_path |;
use FindBin qw| $RealBin |;

## Wrapper around bin/admin/vc_commit ##
## Provides harmonically-validated commit messages ##

my $up_dir = File::Spec->updir;
my $p7_root = abs_path(
    File::Spec->catdir( $RealBin, ($up_dir) x 4 )
);

my $vc_commit = File::Spec->catfile( $p7_root, 'bin', 'admin', 'vc_commit' );

die ":\n:: vc_commit not found: $vc_commit\n\n" if !-x $vc_commit;

exec( $vc_commit, @ARGV );

