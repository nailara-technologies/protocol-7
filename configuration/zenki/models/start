
.:[ resource-aware model management and recommendation zenka ]:.

## loading local network parameters
#
[load_config_file:'shared-params']


## Module Loading
#
modules.load = auth net protocol io.unix models  devmod ## <-- developement.,

## Access Control - Commands This Zenka Exposes
#
access.cmd.usr.cube = heart verify-instance commands reload list show-buffer \
                      get_model find_models recommend record_invocation \
                      statistics cost_analysis discover status maintenance \
                      get find rec record stats cost \ ## <- models zenka
                       core-subs get set dump eval-code exec-sub \
                       inline-subroutines list-subs permission-setup \
                       since unload-unsafe unload-devmod  ## <-- development


## Module Initialization
#
[load_modules:<modules.load>]
[init_modules]

## Drop Privileges
#
[root.drop_privs:<system.amos-zenka-user>]

## Connect to Network
#
[base.net.connect:'unix']

## Register with Network as initialized
#
[get_session_id]

## Enter Event Loop
#
[zenka.loop]

