
.:[ resource-aware model management and recommendation zenka ]:.

## loading local network parameters
#
[load_config_file:'shared-params']


## Module Loading
#
modules.load = auth net protocol io.unix models devmod ## <-- developement.,

## Access Control - Commands This Zenka Exposes
#
access.cmd.usr.cube = heart verify-instance commands reload show-buffer \
                      list get_model find_models recommend record_invocation \
                      statistics cost_analysis discover discover_files \
                      test_discover status maintenance get_model_path \
                      get_path_by_amos chat request memory \
                      get find rec record stats cost metrics get_path \
                      conversation_create conversation_add_turn \
                      conversation_get_context add_participant extract_file \
                      invoke_participant route_by_role attach_file \
                      list_attachments save_conversation load_conversation \
                      list_conversations compact_conversation \
                      analytics_conversation consensus_vote task_chain \
                      test_api_limit test_api_fallback test_end_to_end_local \
                      local_server local_discover substitute_template core-subs \
                      get set dump eval-code exec-sub inline-subroutines \
                      list-subs permission-setup since unload-unsafe unload-devmod \
                      get_inference_endpoint scan-path-add scan-path-del


## Module Initialization
#
[load_modules:<modules.load>]
[init_modules]

## Drop Privileges
#
[root.drop_privs:<system.amos-zenka-user>]

## Connect to Network
#
[base.net.connect:'unix']

## Register with Network as initialized
## Models have already been discovered during init_code
#
[get_session_id]

## Enter Event Loop
#
[zenka.loop]

