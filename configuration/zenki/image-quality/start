
 .:[ protocol-7 image-quality analyzer - on-demand stateless service ]:.

[load_config_file:'shared-params']

access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase \
                      status analyze ## <-- image-quality commands ##

system.verbosity.zenka_buffer = 2  ##  memory ring buffer verbosity  ##

## On-demand configuration: analyzer is started when needed ##
start.on_demand = 1
restart.disabled = 1
heartbeat.disabled = 1
idle_timeout = 300  ## Auto-shutdown after 5 minutes of inactivity ##

## Enable automatic user key creation ##
crypt.C25519.autocreate-user-key = yes

## Module loading ##
modules.load = auth.client net protocol io.unix io.ip ui crypt.C25519 image-quality
[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

