#!/usr/bin/perl
## [:< ##

# name  = workflow.bug
# descr = Bug tracking via workspace-transfer zenka

use v5.24;
use strict;
use English;
use warnings;
use File::Spec;
use Cwd qw| abs_path |;
use FindBin qw| $RealBin |;

my $up_dir = File::Spec->updir;
my $p7_root = abs_path(
    File::Spec->catdir( $RealBin, ($up_dir) x 4 )
);

my $workspace_bug = File::Spec->catfile(
    $p7_root, 'configuration', 'zenki', 'workspace-transfer', 'source', 'bug'
);

die ":\n:: workspace-transfer bug not found: $workspace_bug\n\n" if !-x $workspace_bug;

exec( $workspace_bug, @ARGV );

