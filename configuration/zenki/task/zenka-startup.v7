## [:< ##

# name  = zenka-startup.v7
# descr = 'task'-zenka startup configuration used by 'v7' zenka

start.on-demand    = 1
restart.disabled   = 1
heartbeat.disabled = 1

: v7-init :
  start_mode = stdin-zenka
  task.key = [base.prng.chars-anum:44]
  [v7.callback.setup_zenka_key:<instance_id>,'<zenka_name>',<task.key>]

: zenka-init :
  [base.auth.set_zenka_key:'<{task.key}>']
  [base.zenki.set_ondemand_timeout:3600]

