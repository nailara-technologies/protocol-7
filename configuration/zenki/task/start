
 .:[ protocol-7 task coordination zenka ]:.

[load_config_file:'shared-params']
[zenka.load_sub_list]

access.cmd.usr.cube = commands heart verify-instance \
                     reload src-age src-ver rel-ver \
                     list show-buffer buffer-erase buffer-erase-level \
                     session-key ondemand-zenka set-initialized \
                     task.list task.status task.next \
                     task.assign task.start task.complete \
                     task.block task.handover

crypt.C25519.auto_load_keys      = no
crypt.C25519.autocreate-user-key = no

modules.load = auth net protocol io.unix jobqueue crypt.C25519 format.yaml task

[load_modules:<modules.load>]
[init_modules]

[base.net.connect:'unix']

[get_session_id]

[zenka.loop]

