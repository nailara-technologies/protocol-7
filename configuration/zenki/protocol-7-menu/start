
 .:[ protocol-7-menu [ user action ] zenka ]:.

[load_config_file:'shared-params']
[load_config_file:'X11-vars']

# position save offset correction [ empirically determined, root cause unknown ]
#                      if window jumps on position restore, adjust these values
protocol-7-menu.cfg.position_save_offset_x = 38
protocol-7-menu.cfg.position_save_offset_y = 58

protocol-7-menu.cfg.opacity.min      = 0.37
protocol-7-menu.cfg.opacity.max      = 0.67
protocol-7-menu.cfg.opacity.click    = 0.77
protocol-7-menu.cfg.opacity.distance = 2000

# buffer.zenka.log_cmd = ''    ## clear log zenka path [ no remote logging ]

[root.drop_privs:<system.AMOS-user>] # LLL: implement desktop-user auto-discovery

access.cmd.usr.cube = commands heart verify-instance \
                     reload src-age src-ver rel-ver \
                     list show-buffer buffer-erase buffer-erase-level \
                     tty-action-key gfx-action-key get-action-keys \
                     get-tty-action-keys load-keys-set-up \
                     add-console-action-key add-gfx-action-key \
                     save-keys-set-up show-X11-menu hide-X11-menu fade-menu \
                     register-action un-register-action enable-action-group \
                     disable-action-group show-graphical-menu show-structure \
                     provider-status test-provider menu-update-notify \
                     input-text input-password debug-structure \
                     screen-change \
                                         dump set get exec-sub ## <-- devmod


crypt.C25519.autocreate-user-key = yes

modules.load = auth.client net protocol io.unix ui crypt.C25519 \
               window.place.find_safe_position \
               window.place.build_corner_candidates \
               protocol-7-menu   devmod #####

[load_modules:<modules.load>]
[init_modules]

[base.net.connect:'unix']

[base.X-11.get_display:1]        ##  silent on warnings  ##

[base.get_session_id]

## Initialize graphical window at startup if running in graphical mode
[protocol-7-menu.graphical-startup-init]

## Main event loop - GTK if graphical mode, zenka event loop if TTY
[base.gtk.main_loop]

