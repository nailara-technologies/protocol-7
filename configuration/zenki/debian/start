
 .:[ protocol-7 debian package manager zenka ]:.

[load_config_file:'shared-params']

system.verbosity.zenka_buffer = 2
system.verbosity.zenka_logfile = 2

access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase buffer-erase-level \
                      scan-zenki deps check install zenka resolve \
                      stats packages install-deps check-deps list-zenki \
                      install-history *

modules.load = auth net protocol io.unix ui debian  ## devmod

[load_modules:<modules.load>]
[init_modules]

[debian.start.apt_child]
[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

