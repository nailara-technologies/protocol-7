
 .:[ protocol-7 transport zenka ]:.

[load_config_file:'shared-params']

transport.cfg.profile_dir    = <system.root_path>/data/yaml/transport/profiles
transport.cfg.probe_interval = 30

access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase buffer-erase-level \
                      status \
                      eval-code ## <-- dev only, harness scenarios 2/3 (F2/F8)

modules.load = auth net protocol io.unix io.ip ui format.yaml transport devmod

[load_modules:<modules.load>]
[init_modules]

[load_config_file:'zenki/transport/access.zenki']

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[base.get_session_id]

[zenka.loop]

