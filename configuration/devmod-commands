

.:[ list of devmod module commands ]:.


##  read-only access to zenka mem [ no keys ] and functions  ##
##
base.devmod.cmd_list.safe = get dump echo true since \
                            b32-elf elf-b32 elf-num \
                            dump-env true-int core-subs \
                            list-subs deparse-code \
                            current-umask unload-devmod \
                            extract-line-map permission-setup \
                            inline-subroutines keep-devmod-loaded \
                            decode-harmonic-ref

##  commands that modify data or eat memory  ##
##
base.devmod.cmd_list.development_only = del set add-env del-env eat-mem \
                                        exec-sub free-mem eval-code \
                                        switch-user mem-allocated \
                                        change-log-verbosity

