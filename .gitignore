bin/p7c
*~
$.log
*.LOG
DEADJOE

# Large compiled binaries (build artifacts) - gigantic ggml library
bin/llama-compiled*/libggml.so
bin/llama-compiled/libggml.so

## compiled p7 binaries ##
#
bin/p7c
bin/p-7-r
#
##

# Dependency cache
.deps/cache/

## fasttext CLI: prefer the debian package [ profile: embeddings, bin/p7-deps ];
## .deps/fasttext/ is a fallback local build kept only when the package is unavailable ##
.deps/fasttext/

## trained embedding binaries [ 2+ GB — regenerate via fasttext skipgram ] ##
data/embeddings/*.bin

## generated dep-graph dot output [ regenerate with bin/dev/dep-graph -dot ] ##
data/md/documentation/module-dependency-graph.dot

## generated fasttext training corpus [ regenerate with bin/dev/dep-graph ] —
## fully rewritten each run, was bloating history [ 23 commits, ~1MB each ] ##
data/training/codebase-depgraph.txt

# Claude Code configuration - track structure with defaults, ignore custom content
.claude/*
!.claude/.gitkeep
!.claude/README.md
!.claude/settings.local.json
!.claude/project-context.md
!.claude/projects/*/memory/MEMORY.md
.claude/commands/*
.claude/hooks/*
scr.incoming/

## local perl lib installs (cpanm --local-lib run as non-root; install as root instead) ##
local/

## runtime state — not committed ##
var/credential_fabric/
var/index/
var/inference-cache/
var/nameserv/
var/sys-deps/
var/zenki-deps/
data/state/

## timing-test scratch output [ bin/dev/tests/timing/* ]
.test-*-output/

## generated screenshot-triage batches [ web-browser paged-capture output —
## hundreds of MB of PNGs per run, regenerate via the capture-slideshow
## commands, never commit ] ##
data/snapshots/

## python bytecode cache [ any zenka bin/ with a .py helper, e.g. openvas ] ##
__pycache__/
*.pyc
