module:
  name: crypt.C25519.init_code
  type: initialization_module
  language: perl
  version: "1.0"
  file_path: src/crypt.C25519.init_code

purpose:
  primary: Initialize the C25519 cryptographic module by setting up configuration variables, regex patterns, and key type definitions
  secondary:
    - Define regex patterns for key file validation
    - Establish key size and type mappings
    - Configure user key directory path
    - Set up key checksum cache location

interface:
  functions: []

  variables:
    - name: crypt.C25519.initialized
      type: boolean
      scope: global
      default: FALSE
      description: Flag indicating whether the C25519 module has been initialized

    - name: crypt.C25519.autocreate-user-key
      type: boolean
      scope: global
      default: FALSE
      description: Controls whether user keys should be automatically created if missing

    - name: crypt.C25519.usr_name
      type: string
      scope: global
      default: <system.amos-zenka-user>
      description: Username for C25519 key ownership, falls back to system user

    - name: crypt.C25519.path.key_chksums_cache_file
      type: string
      scope: global
      default: .key-chksums.cache
      description: Path to the file storing cached key checksums

    - name: crypt.C25519.regex
      type: hash
      scope: global
      default: null
      description: Comprehensive set of regex patterns for key file and name validation

    - name: crypt.C25519.keys.sizetype
      type: hash
      scope: global
      default: null
      description: Mapping of key sizes (in bytes) to their type characteristics

patterns:
  regex:
    - name: key_name
      pattern: ^[0-9a-z\.\-]+$
      purpose: Validate lowercase key names
      matches: ["alice", "test-key", "server.dev"]

    - name: signature_key_name
      pattern: ^[0-9A-Z_\-]+
      purpose: Validate uppercase signature key names
      matches: ["ROOT_KEY", "SIGNING-AUTH", "CA_2024"]

    - name: pub-key signature file
      pattern: ^([0-9a-z\.\-]+)\.sk\.(.+)$
      purpose: Match public root key signature files
      matches: ["alice.sk.bob", "server.sk.client"]

    - name: sign-req signature file
      pattern: ^([0-9a-z\.\-]+)\.rq\.(.+)$
      purpose: Match signature request files
      matches: ["alice.rq.server", "client.rq.ca"]

    - name: key signature file
      pattern: ^([0-9a-z\.\-]+)\.ks\.(.+)$
      purpose: Match key signature files
      matches: ["alice.ks.bob", "server.ks.root"]

    - name: virtual public key file
      pattern: ^([0-9a-z\.\-]+)\.vp$
      purpose: Match virtual public key files
      matches: ["alice.vp", "temp-key.vp"]

    - name: virtual key file
      pattern: ^([0-9a-z\.\-]+):\Qseed-phrase\E$
      purpose: Match virtual key files with seed phrases
      matches: ["wallet:seed-phrase"]

    - name: secret key file
      pattern: ^([0-9a-z\.\-]+)\.secret$
      purpose: Match secret key files
      matches: ["alice.secret", "server.secret"]

    - name: private key file
      pattern: ^([0-9a-z\.\-]+)\.private$
      purpose: Match private key files
      matches: ["alice.private", "server.private"]

    - name: public key file
      pattern: ^([0-9a-z\.\-]+)\.public$
      purpose: Match public key files
      matches: ["alice.public", "server.public"]

  constants:
    - name: key_ext
      value: ["\.secret", "\.private", "\.public", ":seed-phrase"]
      type: array
      usage: Define valid key file extensions for pattern matching

    - name: key_types
      value: ["private", "public", "secret"]
      type: array
      usage: List of recognized key types, excluding virtual keys

  mappings:
    - name: keys.sizetype
      structure: hash
      key_type: integer (byte size)
      value_type: hash (key characteristics)
      examples:
        32: "Unencoded binary public or secret key"
        64: "Binary private key (Ed25519)"
        55: "Base32-encoded secret key with prefix"

implementation:
  algorithm:
    overview: Module initialization with validation and configuration setup
    steps:
      - Load required Perl modules (File::Path for make_path)
      - Initialize configuration variables with default values
      - Verify user key directory accessibility via chk_key_dir
      - Abort with error code -2 if key directory inaccessible
      - Build regex patterns from key extension definitions
      - Create and freeze regex configuration hash
      - Create and freeze key size/type mapping hash
    complexity: O(1) - constant time initialization

  operations:
    - name: module_loading
      type: dependency_resolution
      description: Loads File::Path module with make_path function
      dependencies: ["base.perlmod.load"]

    - name: key_directory_validation
      type: filesystem_check
      description: Validates accessibility of user key directory
      dependencies: ["crypt.C25519.chk_key_dir"]

    - name: user_resolution
      type: configuration
      description: Resolves key owner username through fallback chain
      dependencies: ["system.amos-zenka-user", "ENV{USER}", "getpwuid"]

    - name: regex_compilation
      type: pattern_generation
      description: Compiles regex patterns for key file validation
      dependencies: []

    - name: constant_definition
      type: configuration
      description: Creates immutable configuration hashes
      dependencies: ["base.is_defined_recursive"]

  error_handling:
    strategy: Early return on critical failure (key directory inaccessible)
    error_codes:
      - code: -2
        meaning: User key directory not accessible
        recovery: Aborts initialization, warns user with username context

  security:
    measures:
      - Key directory validation before proceeding with initialization
      - Immutable configuration using const keyword
      - Strict regex patterns for key name validation
      - Separation of key types (public/private/secret/virtual)
      - Encrypted key detection through size/prefix analysis
    vulnerabilities:
      - Relies on filesystem permissions for key directory security
      - Key type detection based on size could be ambiguous for edge cases
      - UNKNOWN encryption status requires additional validation
    recommendations:
      - Ensure key directory has appropriate filesystem permissions (0700)
      - Add explicit validation for key file ownership
      - Consider adding checksum verification during initialization
      - Document the old-form key format for deprecation planning

dependencies:
  modules:
    - name: File::Path
      version: unspecified
      purpose: Directory creation utilities
      functions_used: ["make_path"]

    - name: base.perlmod.load
      version: unspecified
      purpose: Dynamic module loading
      functions_used: ["<[base.perlmod.load]>->()"]

    - name: base.s_warn
      version: unspecified
      purpose: Formatted warning messages
      functions_used: ["<[base.s_warn]>->()"]

    - name: base.is_defined_recursive
      version: unspecified
      purpose: Check if nested hash keys are defined
      functions_used: ["<[base.is_defined_recursive]>->()"]

    - name: crypt.C25519.chk_key_dir
      version: unspecified
      purpose: Validate and return user key directory path
      functions_used: ["<[crypt.C25519.chk_key_dir]>"]

  system:
    - type: environment_variable
      requirement: USER environment variable
      optional: true

    - type: system_call
      requirement: getpwuid() for user ID resolution
      optional: true

    - type: perl_builtin
      requirement: catfile() from File::Spec
      optional: false

  filesystem:
    - path: user_key_directory
      permissions: read/write access required
      purpose: Store and manage C25519 cryptographic keys

    - path: .key-chksums.cache
      permissions: read/write access required
      purpose: Cache key checksums for performance optimization

testing:
  scenarios:
    - name: successful_initialization
      input: Valid key directory exists and is accessible
      expected_output: Module initializes, variables set, regex patterns compiled
      description: Normal initialization path with all prerequisites met

    - name: missing_key_directory
      input: Key directory does not exist or is inaccessible
      expected_output: Returns -2, warning message with username
      description: Error handling when key directory validation fails

    - name: reload_initialization
      input: Module already initialized, being reloaded
      expected_output: Existing const hashes deleted before recreation
      description: Handles module reloading by clearing previous const definitions

  edge_cases:
    - condition: No username available (ENV{USER} unset, getpwuid fails)
      behavior: Falls back through chain, may end with undefined username
      handling: Warning message shows resolved username or 'undef'

    - condition: Key size matches multiple type definitions
      behavior: UNKNOWN encryption status requires additional validation
      handling: Marked in sizetype hash, requires prefix check or signature test

    - condition: Virtual key with seed phrase
      behavior: Special handling for non-file-based keys
      handling: Pattern ":seed-phrase" detected, virtual-key flag set

  validation:
    - method: regex_pattern_testing
      criteria: All regex patterns should match expected examples
      tools: ["perl", "regex tester"]

    - method: key_directory_mock
      criteria: Test initialization with various directory states
      tools: ["Test::More", "File::Temp"]

    - method: const_immutability_check
      criteria: Verify const hashes cannot be modified after creation
      tools: ["perl -c", "Test::Exception"]

analysis:
  code_quality:
    strengths:
      - Clear separation of concerns (regex, constants, type mappings)
      - Defensive programming with key directory validation
      - Good use of fallback chains for user resolution
      - Comprehensive key type definitions covering multiple encodings
      - Proper handling of module reloading
    weaknesses:
      - Line 34: Incorrect use of qw| (%s) | in sprintf (should be "(%s)")
      - Magic numbers (32, 34, 64, 66, 55, 56, etc.) lack inline documentation
      - No validation that regex patterns compile successfully
      - Limited error handling beyond directory check

  maintainability:
    - Well-structured data definitions using hashes
    - Const declarations prevent accidental modification
    - Clear naming conventions (lowercase for keys, uppercase for signatures)
    - Key type definitions are comprehensive but could use more comments

  performance:
    - Regex patterns compiled once at initialization (efficient)
    - Const hashes are immutable (no runtime modification overhead)
    - Early return on error prevents unnecessary processing

  security_posture:
    - Supports multiple key formats including encrypted variants
    - Distinguishes between virtual and physical keys
    - Tracks encoding types (bin, b32, plain)
    - Encryption status detection built into type system

recommendations:
  high_priority:
    - Fix line 34: Change qw| (%s) | to "(%s)" for proper sprintf usage
    - Add inline comments explaining the significance of each key size
    - Add validation that all regex patterns compile successfully

  medium_priority:
    - Document the "old-form" key format and migration path
    - Add explicit error handling for regex compilation failures
    - Consider extracting magic numbers to named constants

  low_priority:
    - Add POD documentation for module purpose and usage
    - Consider splitting sizetype hash into separate file for maintainability
    - Add version tracking for key format evolution

