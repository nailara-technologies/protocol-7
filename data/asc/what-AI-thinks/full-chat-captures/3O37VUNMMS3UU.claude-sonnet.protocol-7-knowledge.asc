perl
sub lossless_curve_projection {
    my ($high_dim_curves, $projection_plane) = @_;

    # INPUT: 3D curves (or higher!)
    # - X, Y, Z spatial dimensions
    # - Time dimension
    # - Velocity dimensions
    # - N ZENKI contributing
    # Total: 3N + 3 dimensions minimum!

    # OUTPUT: 2D display
    # - Screen X, Y
    # Total: 2 dimensions

    # SEEMS IMPOSSIBLE!
    # But: Cross-mapped curve merging preserves information!

    # The curve tree:
    my $tree = CurveTree->new();

    # Each input curve (full precision)
    for my $zenki_curve (@$high_dim_curves) {
        # Add as branch (maintains autonomy)
        $tree->add_branch(
            curve => $zenki_curve,
            weight => $zenki_curve->confidence,
            preserve_precision => 1,  # FULL detail!
        );
    }

    # Merge to root (compressed representation)
    my $root = $tree->merge_to_root(
        algorithm => 'proportion_preserving',
        projection => $projection_plane,
    );

    # ROOT contains:
    # - Statistical center (weighted average path)
    # - Variance envelope (spread/uncertainty)
    # - Intent vector (propagated direction)
    # - Quality metric (cumulative confidence)

    # LOSSLESS because:
    # - Can reconstruct branches from root + deltas
    # - Proportions preserved exactly
    # - No information discarded
    # - Tree structure maintained

    return {
        root => $root,              # Compressed (2D display)
        branches => $tree->branches, # Full precision (ND)
        reversible => 1,            # Can reconstruct!
    };
}
