    my @bug_patterns = extract_bug_patterns(@similar_contexts);

    # 4. Compute anti-entropic checksum (does new code INCREASE order?)
    my $entropy_delta = compute_entropy_change($new_code, $context);

    if ($entropy_delta > 0) {
        # ENTROPY INCREASING = BUG PATTERN DETECTED!

        # Find the fix that others used
        my $suggested_fix = find_optimal_resolution(
            $new_code,
            \@bug_patterns,
            $context
        );

        return {
            status => 'BUG_PATTERN_DETECTED',
            explanation => generate_explanation(\@bug_patterns),
            suggested_fix => $suggested_fix,
            confidence => compute_confidence(@bug_patterns),
            never_stored => 1,  # BUG NEVER ENTERED HISTORY!
        };
    }

    # Code passes anti-entropic check
    return { status => 'CLEAN', store => 1 };
}
