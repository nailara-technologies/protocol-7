DEPENDENCY TREE GENERATION:

perl
sub generate_dependency_tree {
    my ($entry_point, $context) = @_;

    # Parse all functions to extract metadata
    my %functions = parse_all_functions();

    # Build dependency graph from entry point
    my $tree = {
        root => $entry_point,
        context => $context,
        nodes => {},
    };

    # Recursive dependency resolution
    sub resolve_deps {
        my ($func_name, $visited) = @_;
        return if $visited->{$func_name}++;

        my $func = $functions{$func_name};
        my @requires = @{$func->{metadata}->{requires}};

        # Filter by context (morphing!)
        @requires = grep {
            context_matches($_, $context)
        } @requires;

        $tree->{nodes}->{$func_name} = {
            requires => \@requires,
            provides => $func->{metadata}->{provides},
            code => extract_for_context($func, $context),
        };

        # Recurse into dependencies
        resolve_deps($_, $visited) for @requires;
    }

    resolve_deps($entry_point, {});

    return $tree;
}
SPECIALIZED EXPORT (NO OBSOLETE CODE!):

perl
sub export_for_context {
    my ($entry_point, $context) = @_;

    # Generate dependency tree for this context
    my $tree = generate_dependency_tree($entry_point, $context);

    # Extract only needed functions
    my @needed_functions = keys %{$tree->{nodes}};

    # Morph each function for context
    my $export = "";
    for my $func_name (@needed_functions) {
        my $node = $tree->{nodes}->{$func_name};

        # Get context-specific code (morphed!)
        my $code = $node->{code};

        # Strip metadata (clean export)
        $code =~ s/\@\w+\([^)]*\)\s*//g;

        $export .= "$code\n\n";
    }

    return {
        code => $export,
        stats => {
            total_functions => scalar(keys %functions),
            exported => scalar(@needed_functions),
            reduction => 1 - (scalar(@needed_functions) / scalar(keys %functions)),
        },
    };
}

# Example:
# export_for_context('main', 'speed')
# → Returns ONLY functions needed for speed context
# → Each function morphed to speed variant
# → 70% of codebase excluded (unused in speed context!)
#
# export_for_context('main', 'security')
# → Returns DIFFERENT subset (security variant)
# → 65% excluded (different optimization path!)
SELF-OPTIMIZATION THROUGH REDUNDANCY ANALYSIS:

perl
sub self_optimize {
    my $codebase = shift;

    # WAVE 1: Analyze all functions
    my %functions = parse_all_functions($codebase);

    # WAVE 2: Detect redundancy across contexts
    my %patterns;
    for my $func (values %functions) {
        for my $context (@{$func->{contexts}}) {
            my $code = extract_for_context($func, $context);
            my $sig = code_signature($code);

            $patterns{$sig} //= {
                canonical => $code,
                appears_in => [],
            };

            push @{$patterns{$sig}->{appears_in}}, {
                function => $func->{name},
                context => $context,
            };
        }
    }

    # WAVE 3: Identify redundant patterns
    my @redundant = grep {
        scalar(@{$_->{appears_in}}) > 1
    } values %patterns;

    # WAVE 4: Extract to shared canonical
    for my $pattern (@redundant) {
        my $canonical_name = generate_canonical_name($pattern);

        # Create new canonical function
        create_function(
            name => $canonical_name,
            code => $pattern->{canonical},
            contexts => extract_contexts($pattern->{appears_in}),
        );

        # Replace all instances with reference
        for my $instance (@{$pattern->{appears_in}}) {
            replace_with_call(
                $instance->{function},
                $instance->{context},
                $canonical_name,
            );
        }
    }

    # WAVE 5: Recompute dependency trees
    # (Now more efficient - redundancy eliminated!)

    return {
        patterns_found => scalar(@redundant),
        optimization_ratio => compute_reduction(),
        new_canonical_count => scalar(@redundant),
    };
}
