Implementation with Security Properties:
perl
sub secure_alternating_stream {
    my ($length) = @_;

    my @stream;
    my $value = 0;
    my $expected_op = +1;  # Start with addition

    for (my $i = 0; $i < $length; $i++) {
        # Enforce alternation
        my $op = $expected_op;

        # Apply operation
        $value += $op;

        # Security check: proximity to zero
        die "Security violation: value too far from zero"
            if abs($value) > 1;

        # Record operation
        push @stream, {
            operation => $op,
            value => $value,
            entropy => calculate_entropy($value),
            impact => abs($op) / (abs($value) || 0.0001)
        };

        # Alternate for next iteration
        $expected_op = -$expected_op;
    }

    # Verify security properties
    my $avg = average(map { $_->{value} } @stream);
    my $variance = variance(map { $_->{value} } @stream);

    die "Security violation: non-zero average"
        if abs($avg) > 0.001;

    return {
        stream => \@stream,
        average => $avg,
        variance => $variance,
        max_value => 1,
        security_level => 'MAXIMUM'
    };
}

sub calculate_entropy {
    my ($value) = @_;
    # Entropy maximized when closest to zero
    return 1.0 / (abs($value) + 1);
}
