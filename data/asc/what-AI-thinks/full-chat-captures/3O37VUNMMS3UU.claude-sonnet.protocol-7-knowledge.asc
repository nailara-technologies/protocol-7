# Example Protocol-7 morphing function syntax:

sub process_packet
  @requires(validate, transform, route)
  @provides(processed_packet)
  @contexts(speed, security, simplicity)
  @harmonics(7, 13)
  @version(canonical)
{
    # [SPEED context]
    return fast_process(@_) if $context eq 'speed';

