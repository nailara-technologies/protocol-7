perl
sub reparse_history {
    my $zenki = shift;

    # Current tail (how I got here)
    my @old_tail = @{$zenki->tail};

    # Reparse: Which diffs are STILL referenced?
    my @new_tail;
    for my $diff (@old_tail) {
        my $ref_count = count_references($diff);

        if ($ref_count >= $DESIRABILITY_THRESHOLD) {
            # This diff is VALUABLE (others use it!)
            push @new_tail, $diff;
        } else {
            # This diff is OBSOLETE (nobody cares)
            # DISSOLVE into canonical or discard!
        }
    }

    # Update tail (history rewrites itself!)
    $zenki->tail(\@new_tail);

    # Result: History becomes CLEANER over time!
    # Only desirable changes persist!
    # Anti-entropic history! ✨
}
```

