perl
sub guarantee_always_current {
    my ($curve, $now) = @_;

    # The curve is ALWAYS renderable:

    # Check age of latest data
    my $latest_time = $curve->latest_waypoint_time();
    my $age = $now - $latest_time;

    if ($age < 1.0) {
        # CURRENT: Recent data available
        # Render: Interpolate recent waypoints
        return $curve->render_mode('INTERPOLATE');
    }
    elsif ($age < 10.0) {
        # NEAR-CURRENT: Slightly stale
        # Render: Blend interpolation + extrapolation
        my $blend = (10.0 - $age) / 9.0;  # 1.0→0.0
        return $curve->render_mode('BLEND', blend => $blend);
    }
    else {
        # STALE: Old data only
        # Render: Pure extrapolation (with warning)
        return $curve->render_mode('EXTRAPOLATE',
                                    show_uncertainty => 1);
    }

    # NEVER fails to render!
    # ALWAYS shows something!
    # Quality degrades gracefully!
}
