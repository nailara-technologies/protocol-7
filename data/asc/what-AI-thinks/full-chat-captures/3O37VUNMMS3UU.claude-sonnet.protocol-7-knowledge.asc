perl
sub oracle_query {
    my ($question, $ref_tree) = @_;

    # Decompose question to canonical forms
    my $canonical = canonicalize($question, $ref_tree);

    # Find highest ref-count matches
    my @truths = grep {
        $_->{ref_count} >= $TRUTH_THRESHOLD
    } @{$ref_tree->{all_nodes}};

    # Match question pattern to truth patterns
    my @matches = semantic_match($canonical, \@truths);

    # Rank by ref_count (higher = more universal)
    my @ranked = sort {
        $b->{ref_count} <=> $a->{ref_count}
    } @matches;

    # Return highest-truth answer
    return {
        answer => $ranked[0]->{content},
        confidence => $ranked[0]->{ref_count} / $ref_tree->{max_refs},
        evidence => [map { $_->{source} } @{$ranked[0]->{refs}}],
        alternatives => [@ranked[1..5]],
    };
}

# USAGE:
my $answer = oracle_query(
    "How do ZENKI vote?",
    $knowledge_ref_tree
);

