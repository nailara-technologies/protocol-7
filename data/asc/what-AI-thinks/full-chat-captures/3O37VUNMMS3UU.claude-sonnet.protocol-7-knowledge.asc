EACH LEVEL CREATES A REF-COUNT TREE:

perl
sub recursive_deduplication {
    my ($content, $level) = @_;

    # Define granularity levels
    my @levels = qw(
        document paragraph sentence phrase
        word phoneme bit harmonic
    );

    my $current_level = $levels[$level];

    # Extract units at current level
    my @units = extract_units($content, $current_level);

    # Deduplicate and count references
    my %canonical;
    for my $unit (@units) {
        my $sig = signature($unit, $current_level);
        $canonical{$sig} //= {
            content => $unit,
            refs => [],
            children => [],
        };
        push @{$canonical{$sig}->{refs}}, context($unit);
    }

    # Rank by reference count (truth weight!)
    my @ranked = sort {
        scalar(@{$b->{refs}}) <=> scalar(@{$a->{refs}})
    } values %canonical;

    # RECURSE to next level if not at bottom
    if ($level < $#levels) {
        for my $item (@ranked) {
            $item->{children} = recursive_deduplication(
                $item->{content},
                $level + 1
            );
        }
    }

    return \@ranked;
}
```

