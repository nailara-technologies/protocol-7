sub maintain_session_ring_via_wind {
    my ($formation) = @_;

    # Session ring needs ALL ZENKI connected:
    my @ring_members = @{$formation->all_zenki};

    # Physical connections (neighbors):
    for my $i (0 .. $#ring_members - 1) {
        my $current = $ring_members[$i];
        my $next = $ring_members[$i + 1];

        # Direct neighbor links (easy!)
        $current->connect_to($next);
    }

    # Last-to-first connection (HARD!):
