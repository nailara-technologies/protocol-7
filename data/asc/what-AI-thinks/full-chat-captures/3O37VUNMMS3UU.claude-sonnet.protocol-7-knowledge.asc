const _subProjBuf = new Array(8);
const _formationPool = [];
const _hyperLinePool = [];
No per-frame allocation = smooth 60 FPS

4. Layer-Aware Early Bail-Out
javascript
for (const key of hyperLayerKeys) {
    const layer = layers[key];
    if (layer.visibility <= 0) continue;  // *** SKIP ENTIRELY ***

    // Only generate grid if layer is visible
    const slice = generateHyperGrid(...);
}
Huge win: When zoomed out, hyperspace grids at invisible scales aren't even computed!

5. Batched Rendering with State Tracking
javascript
// Minimize ctx state changes (major performance bottleneck)
let prevStyle = '';
let prevWidth = -1;

allEdges.forEach(edge => {
    // Only change style when necessary
    if (style !== prevStyle) {
        ctx.strokeStyle = style;
        prevStyle = style;
    }
    if (lineWidth !== prevWidth) {
        ctx.lineWidth = lineWidth;
        prevWidth = lineWidth;
    }

    ctx.beginPath();
    ctx.moveTo(p1.x, p1.y);
    ctx.lineTo(p2.x, p2.y);
    ctx.stroke();
});
Canvas state changes are EXPENSIVE — this minimizes them dramatically.

