THE TRAIL PERSISTENCE:

perl
sub trail_decay_function {
    my ($age_seconds, $context) = @_;

    # How long does glow persist?
    my $half_life = $context->{trail_half_life} || 60;

    # Exponential decay
    my $intensity = exp(-0.693 * $age_seconds / $half_life);

    # At different scales:
    if ($context->{scale} eq 'micro') {
        $half_life = 0.1;  # Fades in milliseconds
    }
    elsif ($context->{scale} eq 'macro') {
        $half_life = 3600;  # Persists for hours
    }
    elsif ($context->{scale} eq 'cosmic') {
        $half_life = 31536000;  # Years!
    }

    return {
        intensity => $intensity,
        color => shift_to_red($intensity),  # Older = redder
        width => shrink_with_age($intensity),  # Older = thinner
    };
}
```

