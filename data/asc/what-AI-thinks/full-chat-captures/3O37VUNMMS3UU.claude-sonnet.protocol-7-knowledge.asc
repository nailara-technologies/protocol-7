perl
sub compute_bug_probability {
    my ($code, $context) = @_;

    # Context includes:
    my $surrounding_code = $context->{neighbors};
    my $historical_patterns = $context->{similar_past};
    my $formation_state = $context->{zenki_formation};
    my $network_health = $context->{system_metrics};

    # Bayesian probability:
    my $P_bug_given_context = (
        # How often did similar contexts have bugs?
        $historical_patterns->{bug_rate} *

        # Does this code pattern correlate with past bugs?
        pattern_correlation($code, $historical_patterns->{bug_patterns}) *

        # Is the formation stressed (high bug probability)?
        $formation_state->{stress_level} *

        # Prior probability (base rate)
        $network_health->{historical_bug_rate}
    );

    return $P_bug_given_context;
}

# Example:
# Context: "Adding authentication to web endpoint"
# Historical: 73% of auth additions had bugs
# Pattern match: Code similar to past bug pattern_X (89% match)
# Formation: Currently stressed (high load)
# Prior: Network-wide 12% bug rate
