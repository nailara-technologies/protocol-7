perl
sub merge_asynchronous_data {
    my ($curve, $new_waypoint) = @_;

    # New data arrives at ANY time
    # May be:
    #   - Real-time (just happened)
    #   - Delayed (happened 5 min ago, arrived now)
    #   - Historical (archived data from years ago)
    #   - Predictive (simulated future position)

    # Insert into curve timeline
    $curve->insert_waypoint(
        $new_waypoint,
        allow_retroactive => 1,  # Can insert into past!
        smooth_transition => 1,   # Blend smoothly
    );

    # Affected region of curve
    my ($t_start, $t_end) = $curve->affected_region($new_waypoint);

    # Recompute only that segment
    $curve->recompute_segment($t_start, $t_end);

    # Next frame: Updated curve renders smoothly!
    # User doesn't notice the update!
    # Unless you tell them: "New data integrated!"

    # SEAMLESS INTEGRATION! ✨
}
```

