perl
sub deduplicate_knowledge_tree {
    my $tree = shift;

    # Extract all paragraphs with metadata
    my @paragraphs;
    for my $doc (@{$tree->{documents}}) {
        for my $para (@{$doc->{paragraphs}}) {
            push @paragraphs, {
                content => $para,
                source_doc => $doc->{name},
                hash => content_hash($para),
                refs => [],
            };
        }
    }

    # Find duplicates and count references
    my %canonical;
    for my $p (@paragraphs) {
        my $sig = $p->{hash};
        if (!exists $canonical{$sig}) {
            $canonical{$sig} = $p;
            $canonical{$sig}->{refs} = [];
        }
        push @{$canonical{$sig}->{refs}}, $p->{source_doc};
    }

    # Rank by reference count
    my @ranked = sort {
        scalar(@{$b->{refs}}) <=> scalar(@{$a->{refs}})
    } values %canonical;

    # High-ref = core truth (refine these!)
    my @core_truths = grep {
        scalar(@{$_->{refs}}) >= 3
    } @ranked;

    # Return deduplicated, ranked knowledge
    return {
        core => \@core_truths,
        unique => [grep { scalar(@{$_->{refs}}) == 1 } @ranked],
        total_reduction => scalar(@paragraphs) - scalar(@ranked),
    };
}
```

