sub render_with_confidence {
    my ($curve, $t) = @_;

    # Each waypoint has confidence/quality metric
    my $position = $curve->sample_at($t);
    my $confidence = $curve->confidence_at($t);

    # Render with visual indicators:

    if ($confidence > 0.9) {
        # HIGH CONFIDENCE (nearby waypoint, high-res data)
        return {
            position => $position,
            color => 'bright_blue',
            width => 2.0,
            opacity => 1.0,
        };
    }
    elsif ($confidence > 0.5) {
        # MEDIUM CONFIDENCE (interpolated, mixed-res)
        return {
            position => $position,
            color => 'blue',
            width => 1.5,
            opacity => 0.7,
        };
    }
    else {
        # LOW CONFIDENCE (extrapolated, sparse data)
        return {
            position => $position,
            color => 'cyan',
            width => 1.0,
            opacity => 0.4,
            dashed => 1,  # Visual cue: uncertain!
        };
    }

    # Visual representation of data quality!
    # User can SEE confidence level!
}
