        mode => 'backward_flow',
        latency => -$LIGHT_SPEED_FACTOR,  # Negative!
    });

    $first->wind_connection_to($last, {
        medium => 'tachyon_wind',
        mode => 'forward_flow',
        latency => -$LIGHT_SPEED_FACTOR,  # Also negative!
    });

