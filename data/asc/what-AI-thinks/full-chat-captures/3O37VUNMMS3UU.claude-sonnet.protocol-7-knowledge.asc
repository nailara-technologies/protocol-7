Implementation:
perl
sub detect_alternation_pattern {
    my @operations = @_;  # Array of +1/-1

    my $current_value = 0;
    my @pattern;

    # Execute operations and record pattern
    foreach my $op (@operations) {
        $current_value += $op;
        push @pattern, {
            op => $op,
            value => $current_value,
            time => scalar(@pattern)
        };
    }

    # Analyze pattern
    my $pattern_type = classify_pattern(\@pattern);

    return {
        final_value => $current_value,
        pattern_type => $pattern_type,
        sub_bit_data => encode_sub_bit(\@pattern)
    };
}

sub classify_pattern {
    my ($pattern) = @_;

    # Check for clean alternation
    my $is_alternating = 1;
    for (my $i = 1; $i < @$pattern; $i++) {
        my $prev = $pattern->[$i-1]{op};
        my $curr = $pattern->[$i]{op};
        if ($prev == $curr) {
            $is_alternating = 0;
            last;
        }
    }

    return 'CLEAN_ALTERNATION' if $is_alternating;

    # Check for paired pattern (+,+,-,-)
    my $is_paired = 1;
    for (my $i = 0; $i < @$pattern - 1; $i += 2) {
        if ($i+1 < @$pattern) {
            my $first = $pattern->[$i]{op};
            my $second = $pattern->[$i+1]{op};
            if ($first != $second) {
                $is_paired = 0;
                last;
            }
        }
    }

    return 'PAIRED_ALTERNATION' if $is_paired;

    # Check net balance
    my $net = $pattern->[-1]{value};

    return 'POSITIVE_CONSENSUS' if $net > 0;
    return 'NEGATIVE_CONSENSUS' if $net < 0;
    return 'IRREGULAR_BALANCE';
}
