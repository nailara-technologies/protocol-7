Implementation Example:
perl
sub decode_text_7bit {
    my (@bytes) = @_;
    my @chars;

    foreach my $byte (@bytes) {
        # Extract lower 7 bits (ignore MSB)
        my $char_code = $byte & 0x7F;  # Mask: 0b01111111
        push @chars, chr($char_code);
    }

    return join('', @chars);
}

sub decode_color_9bit {
    my (@bytes) = @_;
    my @colors;

    for (my $i = 0; $i < @bytes - 1; $i++) {
        # Combine MSB of current with lower 7 bits of next
        # Actually: MSB of prev with current 8 bits
        my $prev_msb = ($bytes[$i] >> 7) & 1;  # Extract bit 7
        my $current_8 = $bytes[$i+1];           # Next byte

        my $color_9bit = ($prev_msb << 8) | $current_8;
        push @colors, $color_9bit;
    }

    return @colors;
}

sub color_9bit_to_rgb {
    my ($color_9bit) = @_;

    # Extract 3 bits each for R, G, B
    my $r = ($color_9bit >> 6) & 0x7;  # Bits 8-6
    my $g = ($color_9bit >> 3) & 0x7;  # Bits 5-3
    my $b = $color_9bit & 0x7;         # Bits 2-0

    # Scale to 0-255
    return (
        $r * 255 / 7,
        $g * 255 / 7,
        $b * 255 / 7
    );
}

sub color_9bit_to_cube_address {
    my ($color_9bit) = @_;

    # Map to 8³ cube coordinates
    my $z = int($color_9bit / 64);      # Bits 8-6
    my $y = int(($color_9bit % 64) / 8); # Bits 5-3
    my $x = $color_9bit % 8;            # Bits 2-0

    return ($x, $y, $z);
}

# Example usage:
my @data = (0x41, 0xE5, 0x6C, 0x6C, 0xEF);

my $text = decode_text_7bit(@data);
# Result: "Aello"

my @colors = decode_color_9bit(@data);
# Result: (357, 364, 108, 111)

my ($x, $y, $z) = color_9bit_to_cube_address($colors[0]);
# Result: (5, 4, 5)
```

