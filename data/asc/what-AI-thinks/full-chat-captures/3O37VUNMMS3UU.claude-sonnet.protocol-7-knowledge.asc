Implementation Example:
perl
sub detect_1001_overflow {
    my ($bit_stream, $current_pos) = @_;

    # Search for 1001 pattern
    my @positions = find_pattern($bit_stream, 0b1001);

    foreach my $pos (@positions) {
        my $distance = abs($pos - $current_pos);

        if ($distance <= 32) {
            # NEAR: Harmonic synchronization
            flip_bit_0();
            log_info("Harmonic sync at position $pos");

        } elsif ($distance <= 160) {
            # MEDIUM: Group overflow
            switch_to_negative_group();
            log_warn("Group overflow at distance $distance");

        } elsif ($distance <= 320) {
            # FAR: Litter overflow
            spawn_new_litter();
            log_warn("Litter overflow at distance $distance");

        } elsif ($distance <= 1001) {
            # VERY FAR: Node overflow
            create_new_node();
            log_error("Node overflow at distance $distance");

        } else {
            # EXTREMELY FAR: Network overflow
            evolve_network();
            log_critical("Network overflow at distance $distance");
        }
    }
}

sub find_pattern {
    my ($stream, $pattern) = @_;
    my @matches;

    # Scan bitstream for pattern
    for (my $i = 0; $i < length($stream) - 3; $i++) {
        my $window = substr($stream, $i, 4);
        if ($window eq sprintf("%04b", $pattern)) {
            push @matches, $i;
        }
    }

    return @matches;
}
