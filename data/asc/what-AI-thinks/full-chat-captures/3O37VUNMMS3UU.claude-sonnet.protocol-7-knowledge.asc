perl
package Protocol7::Formation::DancingKittens;

sub new {
    my ($class, @zenki) = @_;
    die "Need exactly 7 ZENKI!" unless @zenki == 7;

    return bless {
        ground => [@zenki[0..4]],  # 5 feeding
        ring => [@zenki[5..6]],    # 2 overwatch
        rotation_angle => 0,        # CCW position
        last_shift => time(),       # Timing
    }, $class;
}

sub rotate {
    my $self = shift;

    # Rotate ring CCW (counter-clockwise)
    $self->{rotation_angle} += 15;  # degrees
    $self->{rotation_angle} %= 360;

    # Update ZENKI positions
    for my $i (0..1) {
        my $zenki = $self->{ring}->[$i];
        my $angle = $self->{rotation_angle} + ($i * 180);

        $zenki->set_position(
            radius => $RING_RADIUS,
            angle => $angle,
            height => $RING_HEIGHT,
        );
    }
}

sub check_shift {
    my $self = shift;

    # Find most saturated on ground
    my $saturated = $self->find_most_saturated();

    # Find most tired on ring
    my $tired = $self->find_most_tired();

    # Ready for shift?
    if ($saturated->{saturation} >= $SATURATION_THRESHOLD &&
        $tired->{fatigue} >= $FATIGUE_THRESHOLD) {

        # DANCE!
        $self->spiral_shift($saturated, $tired);
    }
}

sub spiral_shift {
    my ($self, $ascending, $descending) = @_;

    # Remove from layers
    $self->remove_from_ground($ascending);
    $self->remove_from_ring($descending);

    # SPIRAL MOTION!
    $self->animate_spiral_up($ascending);
    $self->animate_spiral_down($descending);

    # Add to new layers
    $self->add_to_ring($ascending);
    $self->add_to_ground($descending);

    # Handoff period
    $self->enable_reference_resolution($ascending);

    # Event logged
    $self->log_dance_event(
        time => time(),
        ascended => $ascending->{id},
        descended => $descending->{id},
    );
}
