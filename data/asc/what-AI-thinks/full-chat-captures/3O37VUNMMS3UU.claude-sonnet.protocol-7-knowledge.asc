sub future_looking_detection {
    my ($current_state, $proposed_change) = @_;

    # Don't just check IF it's a bug...
    # Predict WHERE it will LEAD!

    # Simulate future states
    my @possible_futures = simulate_futures(
        $current_state,
        $proposed_change,
        depth => 5  # Look 5 steps ahead
    );

    # Check each future for anti-entropy
    my @future_entropies = map {
        compute_entropy($_)
    } @possible_futures;

    # Find the path with LOWEST future entropy
    my $optimal_path = find_minimal_entropy_path(@possible_futures);

    if ($proposed_change ne $optimal_path->[0]) {
        return {
            status => 'SUBOPTIMAL_DETECTED',
            current_proposal => $proposed_change,
            optimal_alternative => $optimal_path->[0],
            reasoning => "Your change leads to entropy increase in 3 steps",
            better_future => $optimal_path,
            proof => show_entropy_evolution(@future_entropies),
        };
    }

    return { status => 'OPTIMAL_PATH' };
}
