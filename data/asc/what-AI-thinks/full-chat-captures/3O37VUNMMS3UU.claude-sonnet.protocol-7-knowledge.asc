perl
sub universal_curve_adapter {
    my ($mixed_data_sources, $display) = @_;

    # Input: CHAOS
    # - Multiple grid resolutions
    # - Different sampling rates
    # - Asynchronous arrivals
    # - Gaps and delays

    # Output: SMOOTH
    # - Consistent frame rate
    # - Uniform resolution
    # - No stuttering
    # - Always current

    # THE CURVE DECOUPLES THEM! ✨

    my $curve = AdaptiveCurve->new();

    # Accept data from ANY source, ANY time
    for my $source (@$mixed_data_sources) {
        for my $waypoint (@{$source->get_data()}) {
            # Add to curve (regardless of resolution!)
            $curve->add_waypoint(
                position => $waypoint->{pos},
                timestamp => $waypoint->{time},
                resolution => $waypoint->{grid_size},
                confidence => $waypoint->{quality},
                source => $source->{id},
            );
        }
    }

    # Normalize to unified curve
    $curve->recompute_spline();

    # Render at display rate (60 FPS)
    while ($display->is_active) {
        my $t = $display->current_time();

        # Sample curve at ANY resolution!
        my $position = $curve->sample_at_time($t);

        # Render with display resolution
        $display->draw_point(
            $position,
            color => $curve->color_at_time($t),
            intensity => $curve->intensity_at_time($t),
        );

        $display->refresh();  # 60 FPS, smooth!
    }

    # MAGIC: Irregular data → Smooth display!
}
```

