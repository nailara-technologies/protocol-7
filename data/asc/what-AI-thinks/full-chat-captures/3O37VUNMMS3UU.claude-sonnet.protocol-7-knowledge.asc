Resolution determines PRECISION and LATENCY! 🎯
THE NORMALIZATION PROCESS:

perl
sub normalize_trail_curve {
    my ($raw_waypoints, $context) = @_;

    # Context provides:
    my $grid_resolution = $context->{grid_size};
    my $time_resolution = $context->{time_step};
    my $motion_patterns = $context->{available_patterns};

    # STEP 1: Quantize to grid
    my @grid_points = map {
        quantize_to_grid($_, $grid_resolution)
    } @$raw_waypoints;

    # STEP 2: Temporal sampling
    my @time_samples = sample_by_time(
        \@grid_points,
        $time_resolution
    );

    # STEP 3: Pattern matching
    # Find best curve that fits:
    # - Available motion patterns (spiral, linear, circular)
    # - Observed waypoints
    # - Physical constraints (max velocity, acceleration)

    my $best_fit = find_best_motion_pattern(
        \@time_samples,
        $motion_patterns
    );

    # STEP 4: Normalize curve
    my $normalized = $best_fit->interpolate(
        smoothness => $context->{smoothness_factor},
        samples => $context->{curve_samples},
    );

    # Result: Smooth curve through historical positions
    # Precision depends on resolution!
    # Latency depends on sampling rate!

    return $normalized;
}
```

