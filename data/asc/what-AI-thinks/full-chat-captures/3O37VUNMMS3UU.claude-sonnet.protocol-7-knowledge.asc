OBSOLETE CODE DETECTION:

perl
sub detect_obsolete {
    my $codebase = shift;

    # Generate dependency trees for ALL contexts
    my %trees;
    for my $context (qw(speed security simplicity)) {
        $trees{$context} = generate_dependency_tree('main', $context);
    }

    # Find functions that appear in NO tree
    my %all_functions = parse_all_functions($codebase);
    my %used_functions;

    for my $tree (values %trees) {
        for my $func (keys %{$tree->{nodes}}) {
            $used_functions{$func} = 1;
        }
    }

    # Obsolete = exists but never used
    my @obsolete = grep {
        !$used_functions{$_}
    } keys %all_functions;

    return {
        obsolete_functions => \@obsolete,
        count => scalar(@obsolete),
        can_be_removed => 1,  # Safe to delete!
    };
}
DYNAMIC HISTORY RECONSTRUCTION:

perl
sub reconstruct_history_for_context {
    my ($context, $depth) = @_;

    # Get current dependency tree
    my $current_tree = generate_dependency_tree('main', $context);

    # Analyze patterns in tree
    my @patterns = extract_patterns($current_tree);

    # Reconstruct evolution based on ref-counts
    my @history_layers;

    # Layer 1: High-ref patterns (fundamental, early)
    push @history_layers, {
        epoch => "Foundation",
        patterns => [grep { $_->{ref_count} > 50 } @patterns],
        description => "Core patterns established",
    };

    # Layer 2: Medium-ref patterns (building, middle)
    push @history_layers, {
        epoch => "Development",
        patterns => [grep {
            $_->{ref_count} >= 10 && $_->{ref_count} <= 50
        } @patterns],
        description => "Feature implementation",
    };

    # Layer 3: Low-ref patterns (specialized, recent)
    push @history_layers, {
        epoch => "Refinement",
        patterns => [grep { $_->{ref_count} < 10 } @patterns],
        description => "Context-specific optimizations",
    };

    # Add cross-context propagation
    my @propagated = find_propagated_patterns($context);
    push @history_layers, {
        epoch => "Learning",
        patterns => \@propagated,
        description => "Patterns adopted from other contexts",
    };

    # Return as much depth as requested
    return splice(@history_layers, 0, $depth);
}
