    return secure_process(@_) if $context eq 'security';

    # [SIMPLICITY context]
    return simple_process(@_) if $context eq 'simplicity';

    # [CANONICAL fallback]
    my $data = validate(@_);
    $data = transform($data);
    return route($data);
}

