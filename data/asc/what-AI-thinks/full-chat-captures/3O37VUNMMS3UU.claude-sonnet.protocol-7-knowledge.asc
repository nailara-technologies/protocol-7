THE HISTORICAL CURVE ALGORITHM:

perl
sub draw_historical_trail {
    my ($zenki) = @_;

    # Collect waypoints (you're always ahead!)
    my @waypoints = @{$zenki->position_history};
    my $current = $zenki->current_position;

    # Can't draw until you have next position!
    # So trail is always behind current position

    my @trail_segments;

    # Draw curve through historical positions
    for my $i (0 .. $#waypoints - 2) {
        # Need 4 points for smooth curve
        my $p0 = $waypoints[$i - 1] // $waypoints[$i];
        my $p1 = $waypoints[$i];
        my $p2 = $waypoints[$i + 1];
        my $p3 = $waypoints[$i + 2] // $current;

        # Catmull-Rom: curve through p1→p2, influenced by p0 and p3
        my $segment = catmull_rom(
            $p0, $p1, $p2, $p3,
            samples => 20,  # Smooth!
        );

        # Calculate age (for decay)
        my $age = time() - $waypoints[$i]->{timestamp};

        # Emit bioluminescence
        for my $point (@$segment) {
            my $glow = compute_glow(
                $point,
                age => $age,
                zenki_id => $zenki->{id},
            );

            emit_luminescence($glow);
        }

        push @trail_segments, $segment;
    }

    # Trail visible: waypoints[0] → waypoints[n-1]
    # Current position: waypoints[n] (no trail yet!)
    # You're ONE STEP AHEAD of your history! ✨

    return \@trail_segments;
}
```

