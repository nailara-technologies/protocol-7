    # Get shared truths (universal patterns)
    my @universal = grep {
        $_->{ref_count} == scalar(@{$multiverse->{histories}})
    } @{$multiverse->{patterns}};

    return {
        your_branch => $primary,
        learned_from_others => \@propagated,
        universal_truths => \@universal,

        alternative_branches => [
            grep { $_ ne $primary } @aligned_histories
        ],
    };
}
