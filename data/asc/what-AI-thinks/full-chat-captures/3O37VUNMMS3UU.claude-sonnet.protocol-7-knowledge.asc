perl
sub detect_propagated_intent {
    my @parallel_histories = @_;

    # Extract patterns from each history
    my %all_patterns;
    for my $history (@parallel_histories) {
        for my $pattern (extract_patterns($history)) {
            my $sig = pattern_signature($pattern);
            $all_patterns{$sig} //= {
                pattern => $pattern,
                histories => [],
                intents => [],
            };
            push @{$all_patterns{$sig}->{histories}}, $history->{name};
            push @{$all_patterns{$sig}->{intents}}, $history->{intent};
        }
    }

    # Analyze cross-history propagation
    my @universal_truths = grep {
        scalar(@{$_->{histories}}) == scalar(@parallel_histories)
    } values %all_patterns;

    my @shared_across_intents = grep {
        my %unique_intents = map { $_ => 1 } @{$_->{intents}};
        scalar(keys %unique_intents) >= 2
    } values %all_patterns;

    return {
        universal => \@universal_truths,
        shared => \@shared_across_intents,
        specific => [grep {
            scalar(@{$_->{histories}}) == 1
        } values %all_patterns],

        propagation_graph => build_intent_graph(\@shared_across_intents),
    };
}
