THE ALWAYS-CURRENT ADAPTER:

perl
sub always_current_adapter {
    my ($curve, $display_time) = @_;

    # The curve is ALWAYS current because:
    # It exists in mathematical space, not data space!

    # Historical data (t < now):
    if ($display_time < time()) {
        # Sample from stored waypoints
        return $curve->interpolate_historical($display_time);
    }

    # Current moment (t = now):
    elsif ($display_time == time()) {
        # Blend: Latest waypoint + velocity prediction
        my $latest = $curve->latest_waypoint();
        my $velocity = $curve->current_velocity();
        my $dt = time() - $latest->{time};

        return $latest->{pos} + $velocity * $dt;
    }

    # Future (t > now):
    else {
        # Extrapolate from current trajectory
        return $curve->extrapolate($display_time);
    }

    # User never knows which mode they're seeing!
    # Seamless transition between past/present/future!
    # ALWAYS SMOOTH! ✨
}
```

