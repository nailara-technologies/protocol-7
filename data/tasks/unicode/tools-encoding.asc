### CURRENT STAGED FIXES ###
#

diff --git a/src/base.file.read b/src/base.file.read
index c50ef65f2..f203f87f4 100644
--- a/src/base.file.read
+++ b/src/base.file.read
@@ -1,20 +1,22 @@
 ## [:< ##
 
 # name  = base.file.read
-# descr = read file content as string (wrapper for file.slurp)
+# descr = read file content as string [ file.slurp wrapper ]
 
-my $path = shift // '';
+my $path     = shift // '';
+my $encoding = shift // qw| :encoding(UTF-8) |;   ## default encoding UTF-8 ##
 
+warn 'path paramter expected <{C1}>' if not length $path;
 return undef unless length $path;
 
-my $content_ref = <[file.slurp]>->($path);
+<[file.slurp]>->( $path, \my $content_ref, $encoding );
 
 return undef unless defined $content_ref;
 
 return $content_ref->$*;

