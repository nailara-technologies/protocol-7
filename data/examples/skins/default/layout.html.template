<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><{page.title}> | Default Skin</title>
    <link rel="stylesheet" href="/skins/<[web:current-skin]>/style.css">
</head>
<body class="skin-default">
    <header>
        <nav class="navbar">
            <div class="navbar-brand"><{site.title}></div>
            <ul class="navbar-menu">
                <[web:render-menu]>
            </ul>
        </nav>
    </header>
    
    <main class="container">
        <{content}>
    </main>
    
    <footer>
        <p>&copy; <[web:current-year]> <{site.title}>. All rights reserved.</p>
    </footer>
</body>
</html>
