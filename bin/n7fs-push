#!/usr/bin/perl
use v5.32.0;
use utf8;
use strict;
use English;
use warnings;

## n7fs-push : runs on a sending holder host, without any n7fs key. it reads a
## relay list home wrote into the holder directory and sends each listed blob
## to a receiving host, whose key runs only n7fs-receive.
##
##   n7fs-push <holder-dir> <list-file> <ssh-alias> [ -bwlimit <bytes/s> ]
##
## the list holds blob names only, which the sender already sees. a blob the
## receiver has is skipped, so a rerun after an interruption continues

use FindBin;
BEGIN { unshift @INC, "$FindBin::Bin/../data/lib-path/pm" }
use JSON::PP;
use Time::HiRes qw| time sleep |;

sub out { print STDERR "n7fs-push : $ARG[0]\n"; exit 2 }

my ( $dir, $list, $alias ) = splice @ARGV, 0, 3;
out('usage : n7fs-push <holder-dir> <list-file> <ssh-alias>')
    if not defined $alias;
my $bwlimit = 0;
if ( @ARGV and $ARGV[0] eq '-bwlimit' ) {
    shift;
    $bwlimit = shift // '';
    out('-bwlimit needs bytes per second') if $bwlimit !~ m|\A\d+\z|;
}
out('unexpected arguments') if @ARGV;
out('ssh alias is invalid')
    if $alias !~ m|\A[A-Za-z0-9_.][A-Za-z0-9_.-]*\z|;
my $NAME = qr|\A[A-Z2-7]{77}\z|;
$list = "$dir/$list" if $list !~ m|/|;
open( my $lf, '<:raw', $list ) or out("cannot read the list : $OS_ERROR");
my $data = eval {
    local $INPUT_RECORD_SEPARATOR;
    decode_json(<$lf>);
} // out('the list is not valid json');
close $lf;
my @names = @{ $data->{'blobs'} // [] };
foreach my $name (@names) {
    out('invalid blob name in list') if $name !~ $NAME;
}
## a per-root target : the blobs live in the root's subdirectory on both   ##
## ends [ same root, same tag ] and the receiver expects the prefixed name ##
my $subdir = $data->{'subdir'} // '';
out('invalid subdirectory in list')
    if length $subdir and $subdir !~ m|\Ar-[A-Z2-7]{7}\z|;
my $pre = length $subdir ? "$subdir/" : '';

## a silent link is given up after 77 s [ 11 x 7 ], then retried ##
my @ssh = (
    $ENV{'N7FS_SSH'} // 'ssh',
    qw| -o BatchMode=yes -o ConnectTimeout=30 -o ServerAliveInterval=11
        -o ServerAliveCountMax=7 |, $alias
);

## what the receiver has, in batches that keep the command line short ##
my %have;
for ( my $i = 0; $i < @names; $i += 100 ) {
    my $last = $i + 99 < $#names ? $i + 99 : $#names;
    open( my $fh, '-|', @ssh,
        join ' ', 'has', map {"$pre$ARG"} @names[ $i .. $last ] )
        or out("ssh failed : $OS_ERROR");
    while ( my $line = <$fh> ) {
        my ( $name, $size ) = split ' ', $line;
        ## the receiver echoes the asked name : the prefix is ours ##
        $name =~ s|\A\Q$pre\E||
            if length $pre and defined $name;
        $have{$name} = $size if defined $size;
    }
    close $fh or out('the receiver refused the listing');
}
my ( $sent, $bytes, $skipped, $failed ) = ( 0, 0, 0, 0 );
foreach my $name (@names) {
    my $path = "$dir/$pre$name";
    my $size = -s $path;
    if ( not defined $size ) {
        print STDERR "n7fs-push : not here : $name\n";
        $failed++;
        next;
    }
    if ( defined $have{$name} and $have{$name} == $size ) {
        $skipped++;
        next;
    }
    ## a dropped connection fails this try, not the whole push : retried ##
    ## with growing pauses [ N7FS_PUSH_BACKOFF, seconds ]                ##
    my @delays = map { 0 + $ARG } split m|,|,
        $ENV{'N7FS_PUSH_BACKOFF'} // '5,15,30,60';
    my $ok = 0;
    my $code;
    foreach my $try ( 0 .. @delays ) {
        open( my $in, '<:raw', $path )
            or out("cannot read $name : $OS_ERROR");
        my $pid = open( my $to, '|-', @ssh, "put $pre$name $size" )
            // out("ssh failed : $OS_ERROR");
        binmode $to;
        my ( $start, $done ) = ( time, 0 );
        {
            local $SIG{'PIPE'} = 'IGNORE';
            while ( my $got = sysread( $in, my $buf, 65536 ) ) {
                print {$to} $buf or last;
                $done += $got;
                if ($bwlimit) {
                    my $ahead = $done / $bwlimit - ( time - $start );
                    sleep $ahead if $ahead > 0;
                }
            }
            close $in;
            $ok = close $to;
        }
        $code = $CHILD_ERROR >> 8;
        last if $ok;
        ## 3 \ 4 \ 5 : wrong bytes, another size, full : final ##
        last if $code == 3 or $code == 4 or $code == 5;
        last if $try == @delays;
        print STDERR "n7fs-push : retry $name in $delays[$try] s [ $code ]\n";
        sleep $delays[$try];
    }
    if ($ok) {
        $sent++;
        $bytes += $size;
    } else {
        print STDERR "n7fs-push : receiver refused $name [ $code ]\n";
        $failed++;
    }
}
print ": sent $sent blobs, $bytes bytes ; $skipped already there"
    . ( $failed ? " ; $failed failed" : '' ) . "\n";
exit( $failed ? 1 : 0 );

#,,..,,,.,.,.,.,.,.,.,,.,,,.,,,,.,.,,,,,.,,,,,..,,...,...,..,,,.,,,,.,.,.,,.,,
#SZGKBUUQTMTGG2HAFFFKF5OJIB37YJFRXZJOWQXXN6FFDQSX7W6IIW23CTWDEF4752RTQODJDCB6A
#\\\|A7FRIZ75H2E7ZA333KDWQNRPBF6KQGDPEOJQNE2E4IBG4VBEOMM \ / AMOS7 \ YOURUM ::
#\[7]4SYYQJUKMMAFU4IJN3Y3XVW6STUFJGIXAJQ2UXX72HNBRPSRQ4BA 7  DATA SIGNATURE ::
