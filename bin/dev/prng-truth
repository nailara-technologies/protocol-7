#!/usr/bin/perl

use v5.24;
use strict;
use English;
use warnings;
use Getopt::Std;
use Time::HiRes qw| time |;

####           ####
##  prng-truth  ##
###             ####

##  statistical harmonic truth assertion analysis of PRNG output  ##
##  measures true/false distribution against mod-13 theoretical baseline  ##

##[ LOCAL PM LIB PATH ]#######################################################

BEGIN {
    use English;
    use File::Spec;
    use Cwd     qw| abs_path |;
    use FindBin qw| $RealBin |;
    my $up_dir       = File::Spec->updir;
    my $data_pm_path = qw| data/lib-path/pm |;
    my $root_path = abs_path( r2_abs( c_dir( $RealBin, $up_dir, $up_dir ) ) );
    my $local_lib_path = abs_path( c_dir( $root_path, $data_pm_path ) );
    $local_lib_path //= $data_pm_path;
    die "\n:\n:: not found : $local_lib_path\n:\n" if !-d $local_lib_path;
    unshift( @INC, $local_lib_path )               if -d $local_lib_path;
    sub c_dir  { File::Spec->catdir(@ARG) }
    sub r2_abs { File::Spec->rel2abs(@ARG) }
}

##[ MODULES ]##################################################################

use AMOS7::Assert::Truth;
use Crypt::PRNG::Fortuna;

##[ OPTIONS ]##################################################################

getopts( 'n:s:vqF', \my %opt );

my $iterations = do {
    my $n = $opt{'n'} // 100_000;
    $n =~ s|_||g;    ##  allow 1_000_000 style  ##
    int($n);
};

die ":\n:: -n <iterations> must be a positive integer\n:\n"
    if $iterations < 1;

my $seed_str = $opt{'s'};   ##  optional seed [ -s ] for reproducible runs  ##

##[ COLOR SCHEME ]#############################################################

my $blacklight  = "\e[38;2;68;39;172m";
my $nailara_bg  = "\e[48;2;9;5;42m";
my $nailara_fg  = "\e[38;2;38;46;153m";
my $true_color  = "\e[38;2;6;71;195m";
my $neon_orange = "\e[38;2;197;141;7m";
my $neon_green  = "\e[38;2;71;195;6m";
my $bold        = "\e[1m";
my $reset       = "\e[0m";

##[ SEED — HARMONY-FILTERED HIGH PRECISION TIME ]##############################

##  default: walk forward from current microsecond timestamp until the  ##
##  value passes harmonic truth assertion [ nearest TRUE value ]         ##
##  -F flag: walk to nearest FALSE value instead — for comparison runs   ##
##  seed is printed so results are reproducible with  -s <seed>          ##

my $seed_display;
my $seed_state;    ##  TRUE | FALSE | manual  ##

if ( not defined $seed_str ) {
    my $t = int( time() * 1_000_000 );    ##  microsecond precision  ##
    if ( $opt{'F'} ) {
        $t++ while is_true( $t, 1, 0 ); ##  advance to nearest FALSE value  ##
        $seed_state = 'FALSE';
    } else {
        $t++
            while not is_true( $t, 1, 0 )
            ;                           ##  advance to nearest TRUE value  ##
        $seed_state = 'TRUE';
    }
    $seed_str     = "$t";
    $seed_display = $t;
} else {
    ##  report the harmonic state of the manually supplied seed  ##
    $seed_state = is_true( $seed_str, 2, 1 ) ? 'TRUE' : 'FALSE';
}

##[ PRNG SETUP ]###############################################################

my $prng = Crypt::PRNG->new( qw| Fortuna |, $seed_str );

##[ THEORETICAL BASELINE ]#####################################################

##  all 13 mod-13 remainders map to TRUE or FALSE [ no neither ] :  ##
##  TRUE  : remainders 0 2 5 6 7 8 11  [ 7 of 13 ] == 461538 rotations  ##
##  FALSE : remainders 1 3 4 9 10 12   [ 6 of 13 ] == 230769 rotations  ##

my $theory_true  = 7 / 13;    ##  ≈ 0.538461..  ##
my $theory_false = 6 / 13;    ##  ≈ 0.461538..  ##

##[ MAIN LOOP ]################################################################

my %count = ( 'true' => 0, 'false' => 0 );

my $chars_max    = 26;
my $update_every = int( $iterations / 1000 ) || 1;

say $blacklight, ':', $reset unless $opt{'q'};

for my $i ( 1 .. $iterations ) {

    my $n = $prng->int32;    ##  unsigned 32-bit fortuna sample  ##

    ##  numerical assertion — bypasses ELF, uses true_int fast path  ##
    if ( is_true( $n, 1, 0 ) ) {
        $count{'true'}++;
    } else {
        $count{'false'}++;
    }

    ##  progress bar update  ##
    ##
    if ( not $opt{'q'} and ( $i % $update_every == 0 or $i == $iterations ) )
    {

        my $total_so_far = $count{'true'} + $count{'false'};
        my $ratio_true   = $total_so_far ? $count{'true'} / $total_so_far : 0;

        my $char_count = int( $chars_max * $i / $iterations );
        my $bar        = ':' x $char_count;

        my $ratio_color
            = abs( $ratio_true - $theory_true ) < 0.005 ? $neon_green
            : abs( $ratio_true - $theory_true ) < 0.015 ? $nailara_fg
            :                                             $neon_orange;

        printf(
            "\r%s:::[%s%s%-${chars_max}s%s%s]: %s%s%.4f%s  "
                . "T:%s%d%s F:%s%d%s  %s",
            $blacklight,  $nailara_bg,  $true_color,
            $bar,         $reset,       $blacklight,
            $ratio_color, $bold,        $ratio_true,
            $reset,       $true_color,  $count{'true'},
            $reset,       $neon_orange, $count{'false'},
            $reset,       $reset
        );
    }
}

##[ FINAL REPORT ]#############################################################

my $total            = $count{'true'} + $count{'false'};
my $ratio_true       = $count{'true'} / $total;
my $ratio_false      = $count{'false'} / $total;
my $true_false_ratio = $count{'false'} ? $count{'true'} / $count{'false'} : 0;

my $dev_true  = $ratio_true - $theory_true;
my $dev_false = $ratio_false - $theory_false;

my $dev_color
    = abs($dev_true) < 0.005 ? $neon_green
    : abs($dev_true) < 0.015 ? $nailara_fg
    :                          $neon_orange;

print "\n" unless $opt{'q'};
say $blacklight, ':', $reset unless $opt{'q'};

my $lw = 22;    ##  label column width  ##

printf "%s:%s %${lw}s  %s%s%d%s\n",
    $blacklight, $reset, 'iterations', $nailara_fg, $bold, $total, $reset;

my $seed_label
    = defined $seed_display ? 'seed [ time-filtered ]' : 'seed [ manual ]';
my $state_color = $seed_state eq 'TRUE' ? $true_color : $neon_orange;
printf "%s:%s %${lw}s  %s%s%s%s  %s[ %s ]%s\n",
    $blacklight,  $reset,      $seed_label,
    $nailara_fg,  $bold,       $seed_str, $reset,
    $state_color, $seed_state, $reset;

printf "%s:%s %${lw}s  %s%s%d%s  %s(%.4f)%s  "
    . "theory %s%.13f%s  dev %s%+.6f%s\n",
    $blacklight, $reset,
    'TRUE',
    $true_color, $bold,        $count{'true'}, $reset,
    $nailara_fg, $ratio_true,  $reset,
    $nailara_fg, $theory_true, $reset,
    $dev_color,  $dev_true,    $reset;

printf "%s:%s %${lw}s  %s%s%d%s  %s(%.4f)%s  "
    . "theory %s%.13f%s  dev %s%+.6f%s\n",
    $blacklight, $reset,
    'FALSE',
    $neon_orange, $bold,         $count{'false'}, $reset,
    $nailara_fg,  $ratio_false,  $reset,
    $nailara_fg,  $theory_false, $reset,
    $dev_color,   $dev_false,    $reset;

printf "%s:%s %${lw}s  %s%s%.6f%s  "
    . "theory %s%.13f%s\n",
    $blacklight, $reset,
    'TRUE / FALSE ratio',
    $dev_color, $bold, $true_false_ratio, $reset,
    $nailara_fg, $theory_true / $theory_false, $reset;

say $blacklight, ':', $reset;

