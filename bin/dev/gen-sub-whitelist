#!/usr/bin/perl
use v5.24;
use strict;
use English;
use warnings;

###                   ###
##  gen-sub-whitelist  ##
###                   ###

## generate subroutines.load-early for one or all zenki  output :   ##
## cfg/zenki/<name>/subroutines.load-early [ unsigned ] sign with : ##
## bin/Protocol-7 sourcecode update-signatures <path>               ##

use File::Spec;
use Cwd     qw| abs_path |;
use FindBin qw| $RealBin |;

##[ global constants ]##
use constant TRUE    => 5;    ##  TRUE.  ##
use constant FALSE   => 0;    ##  false  ##
use constant UNKNOWN => 2;    ##  unknown  ##

$OUTPUT_AUTOFLUSH = TRUE;

my $reset      = "\e[0m";
my $blacklight = "\e[38;2;68;39;172m";
my $nailara_bg = "\e[48;2;9;5;42m";
my $TRUE_color = "\e[38;2;6;71;195m";
my $ok_color   = "\e[38;2;71;195;6m";
my $warn_color = "\e[38;2;197;141;7m";

my $root_path = abs_path(
    File::Spec->catdir( $RealBin, File::Spec->updir, File::Spec->updir ) );

my $dep_graph = File::Spec->catfile( $root_path, qw| bin dev dep-graph | );
my $zenki_dir = File::Spec->catdir( $root_path, qw| configuration zenki | );

my @targets = @ARGV;

##  default : all zenki with a start file  ##
if ( not @targets ) {
    opendir my $dh, $zenki_dir
        or die ":: cannot open $zenki_dir: $OS_ERROR\n";
    @targets = sort { length $a <=> length $b || $b cmp $a }
        grep { -f File::Spec->catfile( $zenki_dir, $ARG, 'start' ) }
        grep { $ARG !~ m|^\.| } readdir $dh;
    closedir $dh;
}

die ":: no zenki found\n" if not @targets;

my $total     = scalar @targets;
my $zenka_max = ( sort { $b <=> $a } map { length $ARG } @targets )[0];

my $generated = 0;
my $unchanged = 0;
my $failed    = 0;
my $num       = 0;

say $blacklight . ':' . $reset;

for my $zenka (@targets) {
    $num++;
    my $zenka_dir = File::Spec->catdir( $zenki_dir, $zenka );
    my $out_path
        = File::Spec->catfile( $zenka_dir, 'subroutines.load-early' );

    ## namespace-only targets [ no zenka start file ] have no whitelist ##
    ## their subs are covered by the loading zenka's whitelist          ##
    my $has_start = -f File::Spec->catfile( $zenka_dir, 'start' );

    show_progress( $zenka, $num, $total );

    ##  namespace-only: skip — covered by loading zenka's whitelist ##
    if ( not $has_start ) {
        print_result( $zenka, $num, $total,
            '[ namespace-only : no whitelist needed ]', $blacklight );
        $unchanged++;
        next;
    }

    ##  run dep-graph and capture output  ##
    my @subs = qx| $dep_graph -list-subs -zenka=$zenka 2>/dev/null |;

    if ( $CHILD_ERROR != 0 ) {
        print_result(
            $zenka,
            $num,
            $total,
            sprintf( '[!] dep-graph failed [ exit %d ]', $CHILD_ERROR >> 8 ),
            $warn_color,
            "\n"
        );
        $failed++;
        next;
    }

    ##  strip header lines [ :: prefix ] and empty lines  ##
    @subs = grep { length $ARG && $ARG !~ m|^::| } @subs;
    chomp @subs;

    ## prepend explanatory header + blank line -- this file governs WHEN a  ##
    ## module compiles [ eager at zenka startup vs deferred to first use,   ##
    ## changing only when a compile error surfaces ], NOT whether a command ##
    ## is reachable -- that's access.cmd.usr.cube / access.zenki instead.   ##
    ## regenerate via this script rather than hand-adding items.            ##
    unshift @subs,
        '#',
        "# .:[ regenerate with : bin/dev/gen-sub-whitelist $zenka ]:.",
        '# :',
        '# : governs compile timing only [compiles:always|ondemand],',
        '# : not access : see access.cmd.usr.cube or',
        '# : access.zenki for reachability',
        '# :.',
        '';

    if ( not @subs ) {
        print_result( $zenka, $num, $total, '[!] no subroutines found',
            $warn_color, "\n" );
        $failed++;
        next;
    }

    ## compare with existing file : skip write if content unchanged ##
    ## preserves valid signature footer when list has not changed   ##
    ##
    if ( -f $out_path ) {
        open my $rfh, qw| < |, $out_path
            or do {
            print_result( $zenka, $num, $total,
                sprintf( '[!] cannot read : %s', $OS_ERROR ),
                $warn_color, "\n" );
            $failed++;
            next;
            };
        my @existing = <$rfh>;
        close $rfh;
        chomp @existing;

        ##  strip signature footer [ trailing lines starting with # ]  ##
        pop @existing while @existing && $existing[-1] =~ m|^#|;
        pop @existing while @existing && !length $existing[-1];

        if ( "@existing" eq "@subs" ) {
            print_result( $zenka, $num, $total,
                sprintf( '%d subs [ unchanged ]', scalar(@subs) - 1 ),
                $blacklight );
            $unchanged++;
            next;
        }
    }

    ##  write file  ##
    open my $fh, qw| > |, $out_path
        or do {
        print_result( $zenka, $num, $total,
            sprintf( '[!] cannot write : %s', $OS_ERROR ),
            $warn_color, "\n" );
        $failed++;
        next;
        };
    say $fh $ARG for @subs;
    close $fh;

    print_result( $zenka, $num, $total,
        sprintf( '%d subs [ updated ]', scalar(@subs) - 1 ),
        $ok_color, "\n" );
    $generated++;
}

print "\n";
printf "%s:%s\n", $blacklight, $reset;
printf "%s::%s %d updated, %d unchanged, %d failed%s\n",
    $blacklight, $TRUE_color, $generated, $unchanged, $failed, $reset;
printf "%s:: sign with :%s bin/Protocol-7 sourcecode "
    . "update-signatures cfg/zenki/*/subroutines.load-early%s\n",
    $blacklight, $ok_color, $reset
    if $generated;

exit( $failed ? 1 : 0 );

sub show_progress {
    my ( $zenka, $num, $total ) = @ARG;
    my $chars_max  = 13;
    my $char_count = int( $chars_max * ( $num - 1 ) / $total );
    my $bar        = ':' x $char_count;

    printf "\r%s:::[%s%s%-${chars_max}s%s%s]::[%s%s "
        . "%-${zenka_max}s %s%s]:.%s\e[K\r",
        $blacklight,
        $nailara_bg, $TRUE_color, $bar,   $reset, $blacklight,
        $nailara_bg, $TRUE_color, $zenka, $reset, $blacklight,
        $reset;
}

sub print_result {
    my ( $zenka, $num, $total, $result, $result_color, $term ) = @ARG;
    $term //= "\r";
    my $chars_max  = 13;
    my $char_count = int( $chars_max * $num / $total );
    my $bar        = ':' x $char_count;

    printf "\r%s:::[%s%s%-${chars_max}s%s%s]::[%s%s "
        . "%-${zenka_max}s %s%s] %s%s%s\e[K$term",
        $blacklight,
        $nailara_bg,   $TRUE_color, $bar,   $reset, $blacklight,
        $nailara_bg,   $TRUE_color, $zenka, $reset, $blacklight,
        $result_color, $result,     $reset;
}

