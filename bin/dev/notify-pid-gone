#!/bin/bash

## usage: notify-pid-gone [-i <seconds>] <pid> [<pid> ..]
## blocks until every <pid> no longer exists, then exits [ e.g. watching
## AFK kimi-legacy dispatches finish without babysitting a 1800s+ MCP call ]
## one 'gone: pid <pid>' line per process as it ends ; -i : poll interval,
## default 5 s [ an interval above 300 s is accepted with a warning -- it
## looks like a pid passed where the interval was expected ]

usage() {
    echo "usage: notify-pid-gone [-i <seconds>] <pid> [<pid> ..]" >&2
    exit 1
}

interval=5
if [ "$1" = "-i" ]; then
    [ -n "$2" ] || usage
    interval="$2"
    shift 2
fi

[[ "$interval" =~ ^[0-9]+([.][0-9]+)?$ ]] || {
    echo "notify-pid-gone: interval '$interval' is not a number" >&2
    exit 1
}
[ "${interval%%.*}" -gt 300 ] \
    && echo "notify-pid-gone: warning : interval ${interval} s -- a pid?" >&2

[ $# -gt 0 ] || usage

pids=()
for pid in "$@"; do
    [[ "$pid" =~ ^[0-9]+$ ]] || {
        echo "notify-pid-gone: '$pid' is not a pid" >&2
        exit 1
    }
    pids+=("$pid")
done

while [ ${#pids[@]} -gt 0 ]; do
    left=()
    for pid in "${pids[@]}"; do
        if kill -0 "$pid" 2>/dev/null; then
            left+=("$pid")
        else
            echo "gone: pid $pid"
        fi
    done
    pids=("${left[@]}")
    [ ${#pids[@]} -gt 0 ] && sleep "$interval"
done

exit 0

