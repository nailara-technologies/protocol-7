#!/bin/bash

## usage: notify-pid-gone <pid> [poll_interval_seconds]
## blocks until process <pid> no longer exists, then exits [ e.g. watching
## an AFK kimi-legacy dispatch finish without babysitting a 1800s+ MCP call ]

pid="$1"
interval="${2:-5}"

if [ -z "$pid" ]; then
    echo "usage: notify-pid-gone <pid> [poll_interval_seconds]" >&2
    exit 1
fi

until ! kill -0 "$pid" 2>/dev/null; do
    sleep "$interval"
done

echo "gone: pid $pid"

