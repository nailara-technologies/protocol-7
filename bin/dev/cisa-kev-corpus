#!/usr/bin/perl
#..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..:.
#:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:

use v5.24;
use strict;
use English;
use warnings;
use Getopt::Long;
use JSON::PP;

###                  ###
##  cisa-kev-corpus  ##                     #:..:..:..:..:..:..:..:..:..:
###                  ###

##  fetches the CISA known-exploited-vulnerabilities catalog [ single       ##
##  bounded json file ] and normalizes it into one file per entry under     ##
##  data/protocols/cisa/<cve-id> — also emits a fasttext skipgram training  ##
##  file                                                                    ##
##  at data/training/cisa.txt : one line per entry with id + name + first   ##
##  ~10 description tokens, id repeated 3x for weighting                    ##
##                                                                          ##
##  http fetch is deliberately respectful : single request, no polling      ##
##  loop, non-200 responses are reported, never retried indefinitely        ##

#:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:
##[ LOCAL PM LIB PATH ]#######################################################

BEGIN {
    use English;
    use File::Spec;
    use Cwd     qw| abs_path |;
    use FindBin qw| $RealBin |;
    our $up_dir    = File::Spec->updir;
    our $Bin       = $RealBin;
    our $root_path = abs_path( r2_abs( c_dir( $Bin, $up_dir, $up_dir ) ) );
    sub c_dir  { File::Spec->catdir(@ARG) }
    sub r2_abs { File::Spec->rel2abs(@ARG) }
}

##::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..
##[ COMMAND LINE OPTIONS ]####################################################

our $root_path;    ##  from BEGIN block  ##

my %opt = (
    qw| url         | => qw| https://www.cisa.gov/sites/default/files |
        . qw| /feeds/known_exploited_vulnerabilities.json |,
    qw| input       | => '',    ##  read json from file instead of fetch  ##
    qw| output-dir  | => c_dir( $root_path, qw| data protocols cisa | ),
    qw| corpus      | => c_dir( $root_path, qw| data training cisa.txt | ),
    qw| id-repeat   | => 3,     ##  id weight [ repetitions ] in corpus  ##
    qw| desc-tokens | => 10,    ##  description token budget per line  ##
    qw| timeout     | => 60,
    qw| quiet       | => 0,
);

Getopt::Long::Configure('prefix_pattern=--|-');

GetOptions(
    qw| url=s         | => \$opt{url},
    qw| input=s       | => \$opt{input},
    qw| output-dir=s  | => \$opt{'output-dir'},
    qw| corpus=s      | => \$opt{corpus},
    qw| id-repeat=i   | => \$opt{'id-repeat'},
    qw| desc-tokens=i | => \$opt{'desc-tokens'},
    qw| timeout=i     | => \$opt{timeout},
    qw| quiet         | => \$opt{quiet},
) or die ":: invalid command line arguments\n";

##::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..
##[ MAIN ]####################################################################

my $json_text
    = length $opt{input}
    ? read_file( $opt{input} )
    : fetch_kev( $opt{url}, $opt{timeout} );

my $catalog = decode_catalog($json_text);

my @entries = sort { $a->{cveID} cmp $b->{cveID} }
    @{ $catalog->{vulnerabilities} // [] };

die ":: no vulnerabilities found in catalog\n" if !@entries;

write_entries( \@entries, $opt{'output-dir'} );
my $skipped = write_corpus( \@entries, $opt{corpus}, $opt{'id-repeat'},
    $opt{'desc-tokens'} );

if ( !$opt{quiet} ) {
    printf ":: catalog version %s released %s\n",
        $catalog->{catalogVersion} // qw| ? |,
        $catalog->{dateReleased}   // qw| ? |;
    printf ":: %d entries -> %s\n", scalar @entries, $opt{'output-dir'};
    printf ":: corpus -> %s\n", $opt{corpus};
    printf ":: skipped %d entries with empty description in corpus\n",
        $skipped
        if $skipped;
}

##::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..
##[ SUBROUTINES ]#############################################################

sub fetch_kev {
    ##  single respectful http request — report non-200, never loop  ##
    my ( $url, $timeout ) = @ARG;

    require HTTP::Tiny;
    my $http = HTTP::Tiny->new(
        timeout => $timeout,
        agent   => 'protocol-7-cisa-kev-corpus/1.0',
    );

    my $response = $http->get($url);

    die sprintf( ":: fetch failed : http status %s %s [ %s ]\n",
        $response->{status}, $response->{reason} // qw| ? |, $url )
        if !$response->{success};

    return $response->{content};
}

sub decode_catalog {
    ##  parse and sanity-check the kev json structure  ##
    my ($json_text) = @ARG;

    my $catalog = eval { JSON::PP->new->utf8->decode($json_text) };
    die ":: cannot parse kev json : $EVAL_ERROR" if $EVAL_ERROR;

    die ":: unexpected kev json structure [ no vulnerabilities array ]\n"
        if ref $catalog ne qw| HASH |
        or ref $catalog->{vulnerabilities} ne qw| ARRAY |;

    return $catalog;
}

sub write_entries {
    ##  one normalized file per entry : data/protocols/cisa/<cve-id>  ##
    my ( $entries, $output_dir ) = @ARG;

    system qw| mkdir -p |, $output_dir
        and die ":: cannot create $output_dir\n";

    for my $entry ( @{$entries} ) {
        my $id = $entry->{cveID} // next;
        warn sprintf ":: skipping entry with invalid cve id : %s\n", $id
            and next
            if $id !~ m{^CVE-\d+-\d+$}x;

        write_file(
            c_dir( $output_dir, $id ),
            join(
                '',
                sprintf( "id           = %s\n", $id ),
                sprintf( "name         = %s\n",
                    $entry->{vulnerabilityName} // '' ),
                sprintf( "vendor       = %s\n",
                    $entry->{vendorProject} // '' ),
                sprintf( "product      = %s\n", $entry->{product}   // '' ),
                sprintf( "date_added   = %s\n", $entry->{dateAdded} // '' ),
                sprintf( "due_date     = %s\n", $entry->{dueDate}   // '' ),
                sprintf( "ransomware   = %s\n",
                    $entry->{knownRansomwareCampaignUse} // qw| Unknown | ),
                sprintf( "cwes         = %s\n",
                    join( ' ', @{ $entry->{cwes} // [] } ) ),
                "\n",
                sprintf( "description : %s\n",
                    $entry->{shortDescription} // '' ),
                "\n",
                sprintf( "required action : %s\n",
                    $entry->{requiredAction} // '' ),
                (   length( $entry->{notes} // '' )
                    ? sprintf( "\nnotes : %s\n", $entry->{notes} )
                    : ''
                ),
            )
        );
    }
    return;
}

sub write_corpus {
    ##  skipgram training file : id x N + name + first desc tokens  ##
    my ( $entries, $corpus_path, $id_repeat, $desc_tokens ) = @ARG;

    my $skipped = 0;
    my @lines;

    for my $entry ( @{$entries} ) {
        my $id = $entry->{cveID} // next;
        next if $id !~ m{^CVE-\d+-\d+$}x;

        my @tokens = (
            ($id) x $id_repeat,
            tokenize( $entry->{vulnerabilityName} // '' ),
        );

        my @desc = tokenize( $entry->{shortDescription} // '' );
        $skipped++ and next if !@desc;

        push @tokens, splice( @desc, 0, $desc_tokens );
        push @lines,  join( ' ', @tokens );
    }

    write_file( $corpus_path, join( '', map {"$_\n"} @lines ) );

    return $skipped;
}

sub tokenize {
    ##  split into lowercase word-ish tokens, punctuation stripped  ##
    my ($text) = @ARG;
    return grep {length} split /\s+/x, lc $text =~ s{[^\w\s.-]+}{ }gxr;
}

sub read_file {
    my ($path) = @ARG;
    open my $fh, qw| < |, $path
        or die ":: cannot read $path: $OS_ERROR\n";
    my $content = do { local $INPUT_RECORD_SEPARATOR = undef; <$fh> };
    close $fh;
    return $content;
}

sub write_file {
    ##  write content to file  ##
    my ( $path, $content ) = @ARG;

    open my $fh, qw| > |, $path
        or die ":: cannot write to $path: $OS_ERROR\n";
    binmode $fh, qw| :encoding(UTF-8) |;
    print $fh $content;
    close $fh;
}

