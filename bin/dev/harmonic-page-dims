#!/usr/bin/perl

use v5.24;
use strict;
use English;
use warnings;

##[ LOCAL PM LIB PATH ]#######################################################

BEGIN {
    use File::Spec;
    use Cwd qw| abs_path |;
    use FindBin qw| $RealBin |;
    my $root = abs_path( File::Spec->catdir( $RealBin, (File::Spec->updir) x 2 ) );
    my $lib  = File::Spec->catdir( $root, qw| data lib-path pm | );
    unshift @INC, $lib if -d $lib;
}

use AMOS7::Assert::Truth qw| is_true |;

##[ PAGE DIMENSIONS ]#########################################################

my %formats = (
    'DIN A4'    => { mm => [ 210, 297 ] },
    'DIN A3'    => { mm => [ 297, 420 ] },
    'US Letter' => { in => [ 8.5, 11  ] },
    'US Legal'  => { in => [ 8.5, 14  ] },
);

my @dpis = ( 150, 300, 600 );

##[ HARMONIC SCAN ]###########################################################

sub px {
    my ( $fmt, $dpi ) = @_;
    if ( exists $fmt->{'mm'} ) {
        return map { int( $ARG / 25.4 * $dpi + 0.5 ) } @{ $fmt->{'mm'} };
    } else {
        return map { int( $ARG * $dpi + 0.5 ) } @{ $fmt->{'in'} };
    }
}

sub score_dimension {
    my ( $value, $std, $other ) = @_;

    my @pass;

    ## constraint 1 : numerical truth only ##
    my $s1 = "$value";
    $pass[0] = is_true( \$s1, 1, 0 ) ? 1 : 0;

    ## constraint 2 : combined numerical + elf ##
    my $s2 = "$value";
    $pass[1] = is_true( \$s2, 2, 1 ) ? 1 : 0;

    ## constraint 3 : "WxH" string ##
    my $s3 = "${value}x${other}";
    $pass[2] = is_true( \$s3, 2, 1 ) ? 1 : 0;

    ## constraint 4 : "HxW" string ##
    my $s4 = "${other}x${value}";
    $pass[3] = is_true( \$s4, 2, 1 ) ? 1 : 0;

    ## constraint 5 : value/2 string [ 150 dpi cross-scale ] ##
    my $s5 = "" . int( $value / 2 );
    $pass[4] = is_true( \$s5, 2, 1 ) ? 1 : 0;

    ## constraint 6 : value*2 string [ 600 dpi cross-scale ] ##
    my $s6 = "" . ( $value * 2 );
    $pass[5] = is_true( \$s6, 2, 1 ) ? 1 : 0;

    ## constraint 7 : even delta for symmetric margins ##
    $pass[6] = ( ( $value - $std ) % 2 == 0 ) ? 1 : 0;

    my $score = 0;
    $score += $ARG for @pass;

    return ( $score, \@pass );
}

sub fmt_constraints {
    my ($pass) = @_;
    return join ' ', map { $pass->[$ARG] ? $ARG + 1 : '.' } 0 .. 6;
}

##[ OUTPUT ]##################################################################

for my $name ( sort keys %formats ) {
    for my $dpi (@dpis) {
        my ( $w, $h ) = px( $formats{$name}, $dpi );

        ## width scan [widened range] ##
        my @w_cand;
        for my $W ( ( $w - 200 ) .. ( $w + 800 ) ) {
            next if $W <= 0;
            my ( $score, $pass ) = score_dimension( $W, $w, $h );
            push @w_cand, {
                val  => $W,
                d    => $W - $w,
                half => int( $W / 2 ),
                score => $score,
                pass => $pass,
            };
        }
        @w_cand = sort {
            $b->{score} <=> $a->{score}
                || abs( $a->{d} ) <=> abs( $b->{d} )
        } @w_cand;

        ## height scan [widened range] ##
        my @h_cand;
        for my $H ( ( $h - 200 ) .. ( $h + 800 ) ) {
            next if $H <= 0;
            my ( $score, $pass ) = score_dimension( $H, $h, $w );
            push @h_cand, {
                val  => $H,
                d    => $H - $h,
                half => int( $H / 2 ),
                score => $score,
                pass => $pass,
            };
        }
        @h_cand = sort {
            $b->{score} <=> $a->{score}
                || abs( $a->{d} ) <=> abs( $b->{d} )
        } @h_cand;

        ## print width results ##
        print "\n";
        printf "%s  %d DPI  (standard: %d x %d)  [width scan]\n",
            $name, $dpi, $w, $h;
        printf "  score  W      dW    W/2   constraints passed\n";
        printf "  -----  -----  ----  ----  ------------------\n";
        for my $c ( @w_cand[ 0 .. 4 ] ) {
            last if not defined $c;
            printf "    %d    %5d  %+4d  %4d  %s\n",
                $c->{score}, $c->{val}, $c->{d}, $c->{half},
                fmt_constraints( $c->{pass} );
        }

        ## print height results ##
        print "\n";
        printf "%s  %d DPI  (standard: %d x %d)  [height scan]\n",
            $name, $dpi, $w, $h;
        printf "  score  H      dH    H/2   constraints passed\n";
        printf "  -----  -----  ----  ----  ------------------\n";
        for my $c ( @h_cand[ 0 .. 4 ] ) {
            last if not defined $c;
            printf "    %d    %5d  %+4d  %4d  %s\n",
                $c->{score}, $c->{val}, $c->{d}, $c->{half},
                fmt_constraints( $c->{pass} );
        }

        ## paired (W,H) scan ##
        my %w_by_score;
        my %h_by_score;
        for my $c (@w_cand) { push @{ $w_by_score{ $c->{score} } }, $c; }
        for my $c (@h_cand) { push @{ $h_by_score{ $c->{score} } }, $c; }

        my @w_pool = ( @{ $w_by_score{7} // [] }, @{ $w_by_score{6} // [] },
                       @{ $w_by_score{5} // [] } );
        my @h_pool = ( @{ $h_by_score{7} // [] }, @{ $h_by_score{6} // [] },
                       @{ $h_by_score{5} // [] } );

        my @pairs;
        for my $wc (@w_pool) {
            for my $hc (@h_pool) {
                next if $wc->{score} < 5 || $hc->{score} < 5;

                my $pair_score = $wc->{score} + $hc->{score};
                my $wxh_pass = 0;
                my $hxw_pass = 0;

                my $s_wxh = $wc->{val} . 'x' . $hc->{val};
                $wxh_pass = 1 if is_true( \$s_wxh, 2, 1 );

                my $s_hxw = $hc->{val} . 'x' . $wc->{val};
                $hxw_pass = 1 if is_true( \$s_hxw, 2, 1 );

                $pair_score += $wxh_pass + $hxw_pass;

                my $margin_w = abs( $wc->{d} ) / 2;
                my $margin_h = abs( $hc->{d} ) / 2;

                push @pairs, {
                    W        => $wc->{val},
                    H        => $hc->{val},
                    dW       => $wc->{d},
                    dH       => $hc->{d},
                    sW       => $wc->{score},
                    sH       => $hc->{score},
                    pair     => $pair_score,
                    wxh      => $wxh_pass,
                    hxw      => $hxw_pass,
                    margin_w => $margin_w,
                    margin_h => $margin_h,
                    w_pass   => fmt_constraints( $wc->{pass} ),
                    h_pass   => fmt_constraints( $hc->{pass} ),
                };
            }
        }

        @pairs = sort {
            $b->{pair} <=> $a->{pair}
                || abs( $a->{dW} ) + abs( $a->{dH} ) <=> abs( $b->{dW} ) + abs( $b->{dH} )
        } @pairs;

        print "\n";
        printf "%s  %d DPI  (standard: %d x %d)  [paired scan]\n",
            $name, $dpi, $w, $h;
        printf "  pair   W      H      dW   dH   margin      W-constr  H-constr  WxH HxW\n";
        printf "  -----  -----  -----  ---- ----  ----------  --------  --------  --- ---\n";
        for my $p ( @pairs[ 0 .. 2 ] ) {
            last if not defined $p;
            my $margin = sprintf "%.1f x %.1f", $p->{margin_w}, $p->{margin_h};
            printf "    %d    %5d  %5d  %+4d %+4d  %10s  %8s  %8s   %s   %s\n",
                $p->{pair}, $p->{W}, $p->{H}, $p->{dW}, $p->{dH},
                $margin, $p->{w_pass}, $p->{h_pass},
                $p->{wxh} ? 'Y' : 'N', $p->{hxw} ? 'Y' : 'N';
        }
    }
}

