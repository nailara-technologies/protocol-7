#!/usr/bin/perl

use v5.32;
use Term::ReadKey;

my $last_was_newline = 0;
my $in_paste_mode    = 0;
my $linecount        = 0;

while ( my $char = ReadKey(0.1) ) {
    if ( $char =~ /\n/ ) {
        if ( $last_was_newline && is_fast_enough() ) {

            # Drop the duplicate newline
            next;
        }
        $last_was_newline = 1;
        $linecount++;
        $in_paste_mode = 1 if $linecount % 2 == 0;
    } else {

        # Non-newline: check for divergence from pattern
        if ( $in_paste_mode && $linecount % 2 != 0 ) {
            $in_paste_mode = 0;
            $linecount     = 0;
        }
        $last_was_newline = 0;
    }

    # Process character
    handle_char($char);
}

