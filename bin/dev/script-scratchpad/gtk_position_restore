#!/usr/bin/env perl
# standalone scratchpad: test whether $window->move(x,y) before show_all
# actually sticks, with and without GDK_BACKEND=x11, isolated from any
# protocol-7 zenka/v7 machinery
# usage:
#   GDK_BACKEND=x11 perl bin/dev/script-scratchpad/gtk_position_restore
#   perl bin/dev/script-scratchpad/gtk_position_restore

use strict;
use warnings;
use Gtk3 '-init';
use Glib qw(TRUE FALSE);

my $backend  = $ENV{GDK_BACKEND} // '(default)';
my $target_x = 140;
my $target_y = 90;

print "GDK_BACKEND=$backend\n";
print "DISPLAY=" .         ( $ENV{DISPLAY}         // '(unset)' ) . "\n";
print "WAYLAND_DISPLAY=" . ( $ENV{WAYLAND_DISPLAY} // '(unset)' ) . "\n";
print "target position: x=$target_x y=$target_y\n\n";

my $window = Gtk3::Window->new('toplevel');
$window->set_title("position-restore test [$backend]");
$window->set_default_size( 300, 120 );
$window->set_gravity('north-west');

## matching protocol-7-menu.graphical-startup-init's attribute set [ this  ##
## is the CONFIRMED-WORKING standalone path - x=2718 y=9 restored exactly, ##
## almost certainly a non-primary monitor ]; notably it does NOT set       ##
## accept_focus/focus_on_map, and DOES set position('none') + stick        ##
$window->set_position('none');
$window->set_keep_above(1);
$window->set_decorated(0);
$window->stick;
$window->set_app_paintable(1);

my $screen = $window->get_screen;
my $rgba   = $screen->get_rgba_visual();
$window->set_visual($rgba) if $rgba;

my $label = Gtk3::Label->new(
    "backend: $backend\ntarget: " . "$target_x,$target_y" );
$window->add($label);

## app_paintable(1) + RGBA visual with no draw handler leaves the surface ##
## unpainted [ shadow-only / near-transparent ] - paint a fill like       ##
## window-place's handler.draw does, to rule this out as a positioning    ##
## confound                                                               ##
$window->signal_connect(
    draw => sub {
        my ( $widget, $context ) = @_;
        $context->set_operator('source');
        $context->set_source_rgba( 0.0, 0.0, 0.24, 0.85 );
        $context->paint;
        $context->set_operator('over');
        return FALSE;
    }
);

$window->signal_connect( 'destroy' => sub { Gtk3->main_quit; } );

my $mapped_once = 0;
$window->signal_connect(
    qw| map | => sub {
        return FALSE if $mapped_once++;
        my ( $x, $y ) = $window->get_position();
        printf "  [on-map]      x=%s y=%s\n", $x, $y;
        return FALSE;
    }
);

print "-> move(before show_all)\n";
$window->move( $target_x, $target_y );

$window->show_all;

my ( $x0, $y0 ) = $window->get_position();
printf "  [immediately after show_all] x=%s y=%s\n", $x0, $y0;

## check again after the event loop has had a chance to settle - this is ##
## where a compositor-deferred/ignored move would show up as a mismatch  ##
Glib::Timeout->add(
    800,
    sub {
        my ( $x1, $y1 ) = $window->get_position();
        printf "  [+800ms]      x=%s y=%s  %s\n",
            $x1, $y1, ( $x1 == $target_x and $y1 == $target_y )
            ? '[MATCH]'
            : '[MISMATCH]';

        ## retry move() now that the window is definitely mapped, to see if ##
        ## a post-map move (the window-place/select-region pattern)         ##
        ## succeeds even when the pre-map one didn't                        ##
        print "-> move(after map, retry)\n";
        $window->move( $target_x, $target_y );

        Glib::Timeout->add(
            800,
            sub {
                my ( $x2, $y2 ) = $window->get_position();
                printf "  [+800ms post-remap] x=%s y=%s  %s\n",
                    $x2, $y2,
                    ( $x2 == $target_x and $y2 == $target_y )
                    ? '[MATCH]'
                    : '[MISMATCH]';
                print "-> done, quitting\n";
                Gtk3->main_quit;
                return FALSE;
            }
        );
        return FALSE;
    }
);

print "Starting GTK main loop...\n";
Gtk3->main();
print "Finished.\n";

