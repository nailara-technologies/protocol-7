#!/usr/bin/perl -w
use strict;
use warnings;
use feature 'say';

## optional: apt install gir1.2-wnck-3.0  (for Wnck window names/workspaces)
## fallback: GDK window stack (no window names, empty under Wayland/WSLg)

use Gtk3 -init;
use Glib::Object::Introspection;
Glib::Object::Introspection->setup(
    basename => 'GdkX11',
    version  => '3.0',
    package  => 'Gtk3::Gdk'
);

my $have_wnck = eval {
    Glib::Object::Introspection->setup(
        basename => 'Wnck', version => '3.0', package => 'Wnck'
    ); 1;
};

say "DISPLAY=$ENV{DISPLAY}";
say "GDK_BACKEND=" . ( $ENV{GDK_BACKEND} // '<unset>' );
say "WAYLAND_DISPLAY=" . ( $ENV{WAYLAND_DISPLAY} // '<unset>' );
say '';

my $screen_gdk = Gtk3::Gdk::Screen::get_default();

if ( $have_wnck ) {
    my $screen = Wnck::Screen::get_default();
    $screen->force_update;

    for my $win ( @{ $screen->get_windows } ) {
        my $name = $win->get_name;
        my $ws   = $win->get_workspace;
        my $w    = $ws ? $ws->get_number : -1;
        printf "(%04d, %04d) %04dx%04d:%2s $name\n", $win->get_geometry, $w;
    }
} else {
    say '[ Wnck not available — using GDK window stack (no names, empty on Wayland) ]';
    my $windows = $screen_gdk->get_window_stack() // [];
    if ( @$windows ) {
        for my $w (@$windows) {
            printf "(%04d, %04d) %04dx%04d\n",
                $w->get_x, $w->get_y, $w->get_width, $w->get_height;
        }
    } else {
        say '[ no windows visible — compositor may not expose window list ]';
    }
}

say '';

## create a small test window and probe its XID ##
my $window = Gtk3::Window->new('toplevel');
$window->set_title('gtk_get_windows probe');
$window->set_default_size( 200, 100 );
$window->show_all;

## pump events so the window is realized and mapped ##
while ( Gtk3::events_pending ) { Gtk3::main_iteration }
select( undef, undef, undef, 0.3 );    ## give X server time to register ##
while ( Gtk3::events_pending ) { Gtk3::main_iteration }

my $gdk_window = $window->get_window;
my $xid;
if ( $gdk_window and $gdk_window->can('get_xid') ) {
    $xid = $gdk_window->get_xid;
    my $display = $gdk_window->get_display;
    my $display_name = $display->can('get_name') ? $display->get_name : 'unknown';
    say "probe window XID = $xid (GdkDisplay: $display_name)";
    say "  visible=" . ( $window->get_visible // '?' );
} else {
    say 'probe window has no get_xid() (running native Wayland?)';
}

## query the XID via X11::Protocol, mimicking the X-11 zenka ##
if ($xid) {
    my $have_x11_proto = eval { require X11::Protocol; 1 };
    if ($have_x11_proto) {
        my $X = eval { X11::Protocol->new( $ENV{'DISPLAY'} ) };
        if ($X) {
            say "  X11::Protocol root = " . $X->root;
            my @children = $X->QueryTree( $X->root );
            say "  root children: " . scalar(@children);

            ## check _NET_CLIENT_LIST like X-11.get_window_ids does ##
            my $client_list = $X->InternAtom( '_NET_CLIENT_LIST', 1 );
            my @client_ids  = ();
            if ($client_list) {
                my ( $value, $type, $format, $bytes_after )
                    = $X->GetProperty( $X->root, $client_list, 'AnyPropertyType',
                    0, -1, 0 );
                @client_ids = unpack( 'L*', $value );
                say "  _NET_CLIENT_LIST count: " . scalar(@client_ids);
            } else {
                say "  _NET_CLIENT_LIST atom not found";
            }

            my @found = grep { $_ == $xid } @children;
            my @found_client = grep { $_ == $xid } @client_ids;

            ## recursive tree walk fallback (like updated X-11.window_id_found) ##
            my $found_tree = 0;
            if ( not @found_client and not @found ) {
                my @stack = ( $X->root );
                my %seen;
                while ( my $w = shift @stack ) {
                    next if not defined $w or $w eq 'None' or $seen{$w}++;
                    if ( $w == $xid ) { $found_tree = 1; last }
                    push @stack, $X->QueryTree($w);
                }
            }

            if (@found_client) {
                say "XID $xid found in _NET_CLIENT_LIST [OK]";
            } elsif (@found) {
                say "XID $xid found as direct root child but NOT in _NET_CLIENT_LIST";
            } elsif ($found_tree) {
                say "XID $xid found via recursive tree walk [OK]";
            } else {
                say "X11::Protocol did NOT find XID $xid [FAIL]";
                say "  first few child XIDs: " . join( ', ', @children[ 0 .. 9 ] );
                say "  first few client XIDs: " . join( ', ', @client_ids[ 0 .. 9 ] );
            }
        } else {
            say "could not connect X11::Protocol to $ENV{DISPLAY}: $@";
        }

        ## [ title fetching investigation ] ##
        if ($X) {
            say '';
            say '=== title fetching investigation ===';

            my $wm_name     = $X->atom('WM_NAME');
            my $net_wm_name = $X->atom('_NET_WM_NAME');
            my $utf8_string = $X->atom('UTF8_STRING');
            my $string      = $X->atom('STRING');
            my $any         = 0;    ## AnyPropertyType

            say "atoms: WM_NAME=$wm_name  _NET_WM_NAME=$net_wm_name  "
                . "UTF8_STRING=$utf8_string  STRING=$string";

            my ( undef, undef, @root_children )
                = $X->QueryTree( $X->root );

            ## helper to fetch a property and return ( value, type_name ) ##
            my $fetch_title = sub {
                my ( $wid, $atom, $req_type ) = @_;
                return () unless defined $atom and defined $wid;
                my ( $val, $type, $format, $bytes_after ) = eval {
                    $X->GetProperty( $wid, $atom, $req_type, 0, 256, 0 );
                };
                return () if $@ or not defined $val or not length $val;
                my $type_name
                    = defined $type ? $X->atom_name($type) // $type : '<undef>';
                return ( $val, $type_name, $format, $bytes_after );
            };

            ## probe own window first ##
            if ($xid) {
                say '';
                say "probe window $xid:";
                for my $spec (
                    [ 'WM_NAME',      $wm_name,     $any ],
                    [ 'WM_NAME',      $wm_name,     $string ],
                    [ '_NET_WM_NAME', $net_wm_name, $any ],
                    [ '_NET_WM_NAME', $net_wm_name, $utf8_string ],
                    )
                {
                    my ( $label, $atom, $req_type ) = @$spec;
                    my ( $val, $type, $format, $bytes_after )
                        = $fetch_title->( $xid, $atom, $req_type );
                    printf "  %-18s req=%-12s => val=[%s] type=%s fmt=%s left=%s\n",
                        $label,
                        (   $req_type == 0
                            ? 'Any'
                            : $X->atom_name($req_type) // $req_type
                        ),
                        ( defined $val ? $val : '<undef>' ),
                        ( $type   // '<undef>' ),
                        ( $format // '<undef>' ),
                        ( $bytes_after // '<undef>' );
                }
            }

            ## enumerate direct root children ##
            say '';
            say 'direct root children:';
            foreach my $wid (@root_children) {
                next unless defined $wid and $wid ne 'None' and $wid =~ m|^\d+$|;
                my %wa = eval { $X->GetWindowAttributes($wid) };
                next if $@ or not %wa;
                next if ( $wa{'map_state'} // '' ) eq 'Unmapped';

                my $title = '';
                my $src   = '';
                for my $spec (
                    [ '_NET_WM_NAME/UTF8', $net_wm_name, $utf8_string ],
                    [ '_NET_WM_NAME/Any',  $net_wm_name, $any ],
                    [ 'WM_NAME/String',    $wm_name,     $string ],
                    [ 'WM_NAME/Any',       $wm_name,     $any ],
                    )
                {
                    my ( $label, $atom, $req_type ) = @$spec;
                    my ($val) = $fetch_title->( $wid, $atom, $req_type );
                    next unless defined $val and length $val;
                    $title = $val;
                    $src   = $label;
                    last;
                }
                printf "  %d  map=%s  title=[%s] (src=%s)\n",
                    $wid, $wa{'map_state'}, $title, $src;
            }

            ## recursive walk looking for any window carrying a title ##
            say '';
            say 'recursive tree walk (windows with non-empty titles):';
            my @stack = ( $X->root );
            my %seen;
            my @titled;
            while ( my $wid = shift @stack ) {
                next if not defined $wid or $wid eq 'None' or $seen{$wid}++;
                my ( undef, undef, @children ) = eval { $X->QueryTree($wid) };
                next if $@;

                my $title = '';
                for my $spec (
                    [ '_NET_WM_NAME/UTF8', $net_wm_name, $utf8_string ],
                    [ '_NET_WM_NAME/Any',  $net_wm_name, $any ],
                    [ 'WM_NAME/String',    $wm_name,     $string ],
                    [ 'WM_NAME/Any',       $wm_name,     $any ],
                    )
                {
                    my ( undef, $atom, $req_type ) = @$spec;
                    my ($val) = $fetch_title->( $wid, $atom, $req_type );
                    next unless defined $val and length $val;
                    $title = $val;
                    last;
                }
                push @titled, [ $wid, $title ] if length $title;
                unshift @stack, @children;
            }
            if (@titled) {
                printf "  %d  [%s]\n", @$_[ 0, 1 ] for @titled;
            } else {
                say '  (none)';
            }

            ## compare with xprop for the probe window ##
            say '';
            say 'external xprop check:';
            if ($xid) {
                my $out = eval { `xprop -id $xid WM_NAME _NET_WM_NAME 2>&1` };
                say "  probe $xid:";
                say "    $_" for split /\n/, ( $out // '' );
            }
        }
    } else {
        say 'X11::Protocol not installed; skipping XID query';
    }
}

# Gtk3->main;

exit;

