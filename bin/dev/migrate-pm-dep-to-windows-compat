#!/bin/bash
# One-time migration script for pm-dep files: :: to __ for Windows compatibility
# Triggered via cleanup-on-upgrade mechanism

cd /data/projects/protocol-7 || exit 1

# Find all pm-dep directories
PM_DEP_DIRS=$(find configuration/zenki/*/pm-dep -type d 2>/dev/null)

if [ -z "$PM_DEP_DIRS" ]; then
    echo "No pm-dep directories found, migration skipped"
    exit 0
fi

TOTAL_MIGRATED=0

for DIR in $PM_DEP_DIRS; do
    # Find files with :: in names within this directory
    find "$DIR" -maxdepth 1 -type f -name '*::*' 2>/dev/null | while read -r OLD_PATH; do
        OLD_NAME=$(basename "$OLD_PATH")
        # Convert :: to __
        NEW_NAME="${OLD_NAME//::/__}"
        NEW_PATH="$DIR/$NEW_NAME"

        # Skip if target exists
        if [ -e "$NEW_PATH" ]; then
            rm -f "$OLD_PATH" 2>/dev/null
            continue
        fi

        # Rename file
        if mv "$OLD_PATH" "$NEW_PATH" 2>/dev/null; then
            TOTAL_MIGRATED=$((TOTAL_MIGRATED + 1))
        fi
    done
done

if [ $TOTAL_MIGRATED -gt 0 ]; then
    echo "pm-dep migration: renamed $TOTAL_MIGRATED files from :: to __ naming"
fi

exit 0

