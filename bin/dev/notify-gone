#!/bin/bash

## usage: notify-gone <path> [poll_interval_seconds]
## blocks until <path> no longer exists, then exits [ e.g. watching a
## download's .part file disappear when the transfer completes/renames ]

path="$1"
interval="${2:-2}"

if [ -z "$path" ]; then
    echo "usage: notify-gone <path> [poll_interval_seconds]" >&2
    exit 1
fi

until [ ! -e "$path" ]; do
    sleep "$interval"
done

echo "gone: $path"

