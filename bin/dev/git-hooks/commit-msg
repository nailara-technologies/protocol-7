#!/usr/bin/perl
use v5.24;
use strict;
use English;
use warnings;

##
## configure : git config core.hooksPath = bin/dev/git-hooks
## Prevents committing signatures generated by Claude Code
##

unless ( @ARGV && $ARGV[0] ) {
    print STDERR "\n:: error :: this hook must be run by git "
        . "[ it requires a commit message file argument ]\n\n";
    exit 1;
}

my $commit_msg_file = $ARGV[0];
unless ( -f $commit_msg_file ) {
    print STDERR ": \l$OS_ERROR : $commit_msg_file\n\n";
    exit 1;
}

# Read the commit message
open my $fh, '<', $commit_msg_file or die ":\n:: \l$OS_ERROR\n\n";
my @lines = <$fh>;
close $fh;

my @forbidden_patterns = (
    qr/^🤖\s+Generated with/,
    qr/^Co-Authored-By:/,
);

my $has_forbidden = 0;
my @problematic_lines;

foreach my $line (@lines) {
    chomp $line;
    foreach my $pattern (@forbidden_patterns) {
        if ( $line =~ $pattern ) {
            $has_forbidden = 1;
            push @problematic_lines, $line;
            last;
        }
    }
}

if ($has_forbidden) {
    print STDERR "\n";
    print STDERR
        "✗ COMMIT ABORTED: forbidden patterns detected in commit message\n";
    print STDERR "\n";
    print STDERR "the following patterns must be omitted from commits:\n";
    print STDERR "  • Lines starting with '🤖 Generated with'\n";
    print STDERR "  • Lines starting with 'Co-Authored-By:'\n";
    print STDERR "\n";
    print STDERR ":. problematic lines found:\n";

    foreach my $problematic (@problematic_lines) {
        print STDERR "  > $problematic\n";
    }
    print STDERR "\n";
    print STDERR "please edit the commit message to remove these patterns.\n";
    print STDERR "\n";
    exit 1;
}

exit 0;

