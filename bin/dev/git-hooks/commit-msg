#!/usr/bin/perl
use v5.24;
use strict;
use English;
use FindBin qw| $RealBin |;
use File::Spec;
use warnings;
use open qw[ :std :utf8 ];
##
## configure : git config core.hooksPath = bin/dev/git-hooks  Filters out
## AI-generated metadata (emoji + "Generated with", Co-Authored-By:) from
## commit messages automatically instead of rejecting commits.  Saves tokens
## by avoiding retry loops when Claude Code generates metadata.
##
## Version: 3KZOLZEUIY-5261.0
##

unless ( @ARGV && $ARGV[0] ) {
    print STDERR "\n:: error :: this hook must be run by git [ "
        . "it requires a commit message file argument ]\n\n";
    exit 1;
}

my $commit_msg_file = $ARGV[0];
unless ( -f $commit_msg_file ) {
    print STDERR ": \l$OS_ERROR : $commit_msg_file\n\n";
    exit 1;
}

## llm metadata removed in place [ patterns : cfg/git/llm-metadata.patterns,
## shared with the harmonize-emails history rewrite ]
my $strip_tool = File::Spec->catfile( $RealBin, File::Spec->updir,
    qw| strip-llm-metadata | );
system( $EXECUTABLE_NAME, $strip_tool, qw| -i |, $commit_msg_file ) == 0
    or exit 1;

open my $fh, '<', $commit_msg_file or die ":\n:: \l$OS_ERROR\n\n";
my @kept_lines = <$fh>;
close $fh;

## pii check [ report only, never blocks -- bin/dev/pii-audit -f ] ##
my $pii_audit
    = File::Spec->catfile( $RealBin, File::Spec->updir, qw| pii-audit | );
system( $EXECUTABLE_NAME, $pii_audit, qw| -f |, $commit_msg_file )
    if -f $pii_audit;

## message form check [ title, one empty line, '- ' bullet body ] ##
##
## rejects the two unambiguous cases : line 2 not empty, and a long
## single-line message with the whole body folded into the title.  a long
## title with a body only warns [ the history has many > 80 ]

my $max_single_len = 100;    ## single-line message without a body ##
my $warn_title_len = 80;     ## title of a message with a body ##

my @form_lines;
foreach my $line (@kept_lines) {
    last if $line =~ m|^# -+ >8 -+$|;    ## verbose commit scissors ##
    next if $line =~ m|^#|;              ## editor comment lines ##
    my $text = $line;
    $text =~ s|\s+$||;
    push @form_lines, $text;
}
shift @form_lines while @form_lines and not length $form_lines[0];
pop @form_lines   while @form_lines and not length $form_lines[-1];

## git generated messages are left alone ##
exit 0
    if not @form_lines
    or $form_lines[0] =~ m,^(Merge|Revert|fixup!|squash!|amend!) ,;

my $title     = $form_lines[0];
my $title_len = length $title;
my @errors;

if ( @form_lines > 1 and length $form_lines[1] ) {
    push @errors,
        "line 2 must be empty [ separates " . "the title from the body ]";
}
if ( @form_lines == 1 and $title_len > $max_single_len ) {
    push @errors,
        "single-line message of $title_len chars [ max $max_single_len "
        . "] -- the details belong in a body, not folded into the title";
}

if (@errors) {
    print STDERR "\n:: error :: commit message form\n";
    print STDERR "::   - $_\n" foreach @errors;
    print STDERR "::\n:: expected form :\n::\n::   area : short topic "
        . "title\n::\n::   - first detail [ annotation ]\n::   "
        . "- second detail, wrapped at ~75 columns with a "
        . "two-space\n::     continuation indent\n::\n:: [ see "
        . "'Commit Message Form' in AI-COLLABORATION-GUIDE.md " . "]\n\n";
    exit 1;
}

if ( @form_lines > 1 and $title_len > $warn_title_len ) {
    print STDERR "\n:: warning :: title is $title_len chars [ "
        . "aim for ~72, move details into the body ]\n\n";
}

exit 0;

