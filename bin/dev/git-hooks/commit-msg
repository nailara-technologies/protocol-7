#!/usr/bin/perl
use v5.24;
use strict;
use English;
use warnings;
use open qw[ :std :utf8 ];
##
## configure : git config core.hooksPath = bin/dev/git-hooks  Filters out
## AI-generated metadata (emoji + "Generated with", Co-Authored-By:) from
## commit messages automatically instead of rejecting commits.  Saves tokens
## by avoiding retry loops when Claude Code generates metadata.
##
## Version: 3KZOLZEUIY-5261.0
##

unless ( @ARGV && $ARGV[0] ) {
    print STDERR "\n:: error :: this hook must be run by git [ "
        . "it requires a commit message file argument ]\n\n";
    exit 1;
}

my $commit_msg_file = $ARGV[0];
unless ( -f $commit_msg_file ) {
    print STDERR ": \l$OS_ERROR : $commit_msg_file\n\n";
    exit 1;
}

# Read the commit message
open my $fh, '<', $commit_msg_file or die ":\n:: \l$OS_ERROR\n\n";
my @original_lines = <$fh>;
close $fh;

# Filter patterns that should be automatically removed from commit message
my @filter_patterns = (
    qr|\p{Emoji} Generated with |,
    qr|^Co-Authored-By:|,
    qr|^Claude-Session:|,
    qr|^\[CLAUDE\] |,
    qr|\[Claude Code\] \([^\)]+\)$|
);

# Process lines: separate filtered from kept lines
my @kept_lines;
my @filtered_lines;

foreach my $line (@original_lines) {
    my $should_filter = 0;
    foreach my $pattern (@filter_patterns) {
        if ( $line =~ $pattern ) {
            $should_filter = 1;
            push @filtered_lines, $line;
            last;
        }
    }
    unless ($should_filter) {
        push @kept_lines, $line;
    }
}

# If patterns were found, write cleaned message back to file
if (@filtered_lines) {

    # Write cleaned message back to file
    open $fh, '>', $commit_msg_file or die ":\n:: \l$OS_ERROR\n\n";
    foreach my $line (@kept_lines) {
        print $fh $line;
    }
    close $fh;

    # Inform user that patterns were removed
    print STDERR "\n";
    print STDERR ":: info :: removed author metadata from commit message\n";
    print STDERR ":: filtered patterns:\n";
    foreach my $problematic (@filtered_lines) {
        chomp $problematic;
        print STDERR "::   - $problematic\n" if length $problematic;
    }
    print STDERR "\n";
}

exit 0;

