#!/usr/bin/perl

use v5.24;
use strict;
use English;
use warnings;
use File::Spec;
use Cwd     qw| abs_path |;
use FindBin qw| $RealBin |;
our $up_dir = File::Spec->updir;
our $Bin    = $RealBin;

##
## configure : 	'git config core.hooksPath = bin/dev/git-hooks' ##
##

# die "expected 3 arguments" if @ARGV != 3; # [unused]
my ( $sha_old, $sha_new, $change_br ) = @ARGV;
print ":\n: running 'pre-commit' checks ..,\n:\n";

my $admin_path = 'bin/admin';
my $p7_root    = p7_root_dir();    ## safely determine protocol-7 root path ##
chdir($p7_root) or die "  :\n  :: \l$OS_ERROR : $p7_root\n\n";

## checking files and permissions ##
system("$p7_root/$admin_path/restore-p7-permissions") == 0
    or die ":\n:: \l$OS_ERROR\n\n";

## Check version numbers are updated
check_version_numbers($p7_root) unless $ENV{SKIP_VERSION_CHECK};

## Check for signatures on modified files
check_file_signatures($p7_root) unless $ENV{SKIP_SIGNATURE_CHECK};

print ":\n: done.\n:\n";

#[ SUBROUTINES ]##############################################################

sub c_dir  { File::Spec->catdir(@_) }
sub r2_abs { File::Spec->rel2abs(@_) }

sub p7_root_dir {
    my $root_path = abs_path( r2_abs( c_dir( $Bin, ($up_dir) x 3 ) ) );
    die "  :\n  :: not a directory : '$root_path'\n\n" if !-d $root_path;
    return $root_path;
}

sub is_amend_commit {
    my $is_amend = 0;

    ## check environment first ##                   [ need unsetting again ]
    $is_amend = 1 if defined $ENV{'GIT_AMEND'} and $ENV{'GIT_AMEND'} ne '0';
    $is_amend = 1 if defined $ENV{'AMEND'}     and $ENV{'AMEND'} ne '0';

    ## check .amend file next ##
    my $amend_file_path = c_dir( $p7_root, qw| .amend | );
    if ( -e $amend_file_path and -z $amend_file_path ) {
        $is_amend = 1;
        unlink($amend_file_path);
    }
    return $is_amend;
}

sub check_version_numbers {
    my ($p7_root) = @_;

    my $vers_file = c_dir( $p7_root, 'configuration', 'protocol-7.src-ver' );
    return unless -f $vers_file;

    # Detect if we're amending
    my $is_amend = is_amend_commit();

    # Count commits via git rev-list for accuracy
    my $commit_count = `git -C '$p7_root' rev-list --count HEAD 2>/dev/null`
        // 0;
    chomp($commit_count);
    $commit_count ||= 0;

    # Read version file
    open my $fh, '<', $vers_file or return;
    my $version_content = <$fh>;
    close $fh;

    # Extract version (format: XXXXX-CCCC.R)
    my $version = $version_content;
    $version =~ s/\n.+$//sg;    # Strip signature

    return unless $version =~ m|-(\d+)\.(\d+)$|;
    my ( $file_count, $file_rev ) = ( $1, $2 );

    # Determine expected version based on actual operation
    my $expected_count;
    if ($is_amend) {

  # Amending: version should be commit_count - 1 (the amended commit's number)
        $expected_count = $commit_count - 1;
    } else {

        # New commit: version should be commit_count (the new commit's number)
        $expected_count = $commit_count;
    }

    if ( $file_count != $expected_count ) {
        print STDERR ":::: version mismatch detected ::::\n:\n";
        print STDERR ": version file  : $version\n";
        print STDERR ": current commit: $commit_count\n";
        print STDERR ": operation     : "
            . ( $is_amend ? "amend" : "new commit" ) . "\n";
        print STDERR ": expected      : *-$expected_count.$file_rev\n";
        my $update_cmd
            = $is_amend
            ? './bin/dev/update-version reset'
            : './bin/dev/update-version';
        print STDERR ": suggestion    : run '$update_cmd' to fix\n";
        print STDERR ": valid options : *-"
            . ( $commit_count - 1 )
            . ".$file_rev (amend) or *-$commit_count.$file_rev (new)\n";
        print STDERR ": to override   : SKIP_VERSION_CHECK=1 git commit\n";
        exit 1;
    }
}

sub check_file_signatures {
    my ($p7_root) = @_;

    ## Detect if we're amending ##
    #
    my $is_amend = ( exists $ENV{'GIT_REFLOG_ACTION'}
            && $ENV{'GIT_REFLOG_ACTION'} =~ /amend/ ) ? 1 : 0;

    # Check if there are any staged files at all
    my $git_diff = `git -C '$p7_root' diff --cached --name-only 2>/dev/null`
        // '';
    return unless length($git_diff) || $is_amend;

    ## Use bin/Protocol-7 sourcecode verify-p7-signatures to verify all
    ## signatures This command uses modules/sourcecode.source_path_set_up
    ## for proper path configuration and knows which files need signature
    ## verification The embedded public key is used, no passphrase required

    my $verify_cmd
        = qq{cd '$p7_root' && bin/Protocol-7 sourcecode verify-p7-signatures 2>&1};
    my $verify_output = `$verify_cmd`;
    my $verify_status = $? >> 8;

    if ( $verify_status != 0 ) {
        print STDERR ": signature verification failed :\n:\n";
        print STDERR $verify_output;
        print STDERR ": suggestion    :"
            . " run 'bin/Protocol-7 sourcecode update-signatures'\n";
        print STDERR ": to override   : SKIP_SIGNATURE_CHECK=1 git commit\n";
        exit 1;
    }
}

