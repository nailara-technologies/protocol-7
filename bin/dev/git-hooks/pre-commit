#!/usr/bin/env perl
# pre-commit hook: Validate version numbers and signature integrity

use strict;
use warnings;
use File::Spec;
use Git::Wrapper;
use Cwd 'abs_path';
use FindBin '$RealBin';
use Getopt::Long;

## ANSI Colors [ from update-version style ]
my $rst = "\e[0m";
my $bl  = "\e[1m";
my $fg  = "\e[38;2;68;39;172m";    # purple
my $ng  = "\e[38;2;71;195;6m";     # green
my $no  = "\e[38;2;197;141;7m";    # orange
my $rd  = "\e[38;2;220;20;60m";    # crimson

my $skip_backup_files = 1;         # ignores *~ filenames

## Check for -no-verify flag to allow bypass
my $allow_unsigned = 0;
for my $arg (@ARGV) {
    $allow_unsigned = 1 if $arg eq '-no-verify' || $arg eq qw| -n |;
}

my $skip_version_check   = $ENV{'SKIP_VERSION_CHECK'}   // 0;
my $skip_signature_check = $ENV{'SKIP_SIGNATURE_CHECK'} // 0;
my $skip_descr_check     = $ENV{'SKIP_DESCR_CHECK'}     // 0;

## Get repository root
my $git_dir   = abs_path($RealBin);
my $root_path = abs_path(
    File::Spec->catdir(
        $git_dir, File::Spec->updir, File::Spec->updir, File::Spec->updir
    )
);

## Version file path
my $vers_file = File::Spec->catfile( $root_path, 'configuration',
    'protocol-7.src-ver' );

## Initialize git object
my $git = Git::Wrapper->new($root_path);

## Check descr/param lines over 55 chars in staged command modules
unless ($skip_descr_check) {
    my @staged_files = eval { $git->diff( { cached => 1, name_only => 1 } ) };

    my @violations;
    for my $file (@staged_files) {
        ## only check modules/*cmd* files
        next unless $file =~ m|^modules/.*cmd|;

        my $file_path = File::Spec->catfile( $root_path, $file );
        next unless -f $file_path;

        open my $fh, '<', $file_path or next;
        my $line_num = 0;
        while ( my $line = <$fh> ) {
            $line_num++;
            if ( $line =~ m/^#\s*(descr|param)\s*=\s*(.+)$/ ) {
                my $field   = $1;
                my $content = $2;
                my $length  = length($content);
                if ( $length > 55 ) {
                    push @violations,
                        {
                        file    => $file,
                        line    => $line_num,
                        field   => $field,
                        content => $content,
                        length  => $length
                        };
                }
            }
        }
        close $fh;
    }

    if (@violations) {
        print STDERR "\n";
        print STDERR "${fg}::\n";
        print STDERR "${fg}:: $bl${rd}descr/param lines too long$rst\n";
        print STDERR "${fg}::\n";
        for my $v (@violations) {
            print STDERR "${fg}::   $v->{file}:$v->{line} ";
            print STDERR "($v->{field}, $v->{length} chars)\n";
            print STDERR "${fg}::     $v->{content}\n";
            print STDERR "${fg}::\n";
        }
        print STDERR
            "${fg}:: ${ng}suggestion${rst}${fg} : shorten to 55 chars or less\n";
        print STDERR "${fg}::\n";
        print STDERR
            "${fg}:: to override this check: ${bl}git commit -no-verify$rst or ${bl}SKIP_DESCR_CHECK=1 git commit$rst\n";
        print STDERR "${fg}::\n$rst";
        exit 1;
    }
}

## Exit if version file doesn't exist
unless ( -f $vers_file ) {
    exit 0;
}

## Get current git commit count
my $commit_count = eval { $git->log } - 1;

## Read version string from file
open my $fh, '<', $vers_file or do {
    print STDERR
        "$fg:\n${fg}:: warning :: cannot read version file\n$fg:$rst\n";
    exit 0;
};
my $version_content = <$fh>;
close $fh;

## Extract commit count from version string (format: XXXXXX-CCCC.R)
## where CCCC is the commit count and R is revision
my $version_from_file = $version_content;
$version_from_file =~ s|\n+.+$||sg;    # Strip signature and newlines

unless ( $version_from_file =~ m|-(\d+)\.(\d+)$| ) {
    exit 0;                            # Can't parse version, allow commit
}

my $file_commit_count = $1;
my $file_revision     = $2;

## Check if commit count matches (unless skipped)
unless ($skip_version_check) {
    if ( $file_commit_count != $commit_count + 1 ) {
        print STDERR "\n";
        print STDERR "${fg}::\n";
        print STDERR "${fg}:: $bl${no}version mismatch detected$rst\n";
        print STDERR "${fg}::\n";
        print STDERR "${fg}:: version file  : $bl$version_from_file$rst\n";
        print STDERR "${fg}:: expected      : $bl${rst}*-$bl"
            . ( $commit_count + 1 )
            . ".$file_revision$rst\n";
        print STDERR "${fg}::\n";
        print STDERR
            "${fg}:: ${ng}suggestion${rst}${fg} : run ${bl}./bin/dev/update-version$rst$fg to fix\n";
        print STDERR "${fg}::\n";
        print STDERR
            "${fg}:: ${no}hint${rst}${fg} : version numbers ensure commits are properly tracked\n";
        print STDERR "${fg}::\n";
        print STDERR
            "${fg}:: to override this check: ${bl}git commit -no-verify$rst or ${bl}SKIP_VERSION_CHECK=1 git commit$rst\n";
        print STDERR "${fg}::\n$rst";
        exit 1 unless $allow_unsigned;
    }
}

## Check for unsigned or invalid files (unless skipped)
unless ($skip_signature_check) {
    my @staged_files = eval { $git->diff( { cached => 1, name_only => 1 } ) };

    my $has_unsigned = 0;
    my @unsigned_files;

    for my $file (@staged_files) {
        next if $skip_backup_files and $file =~ m|~$|; # skipping backup files

        my $file_path = File::Spec->catfile( $root_path, $file );
        next unless -f $file_path;

        # Check if file has signature footer
        open my $fh, '<', $file_path or next;
        my $content = do { local $/; <$fh> };
        close $fh;

     # Files should have AMOS7 signature markers if they're tracked code files
        if (   $content =~ /\.(pl|pm|md|yaml|sh|asc)$/
            || $file =~ /^(modules|bin|configuration)\// ) {

            # Check for signature markers
            unless ( $content
                =~ /SIGNATURE|YOURUM|AMOS7.*DATA.*SIGNATURE|AMOS7.*CODE.*SIGNATURE/
            ) {
                # Only warn if file appears to be source code
                #           [ has recognizable code patterns ]
                if ( $content
                    =~ /^#!|^\s*(use|require|my\s+\$|sub\s+\w|if|while|for)\s/
                    || $content =~ /^---|\n---\n/
                    || $content =~ /^#/ ) {
                    push @unsigned_files, $file;
                    $has_unsigned = 1;
                }
            }
        }
    }

    if ( $has_unsigned && !$allow_unsigned ) {
        print STDERR "\n";
        print STDERR "${fg}::\n";
        print STDERR
            "${fg}:: $bl${rd}unsigned or unverified files detected$rst\n";
        print STDERR "${fg}::\n";
        print STDERR "${fg}:: unsigned files:\n";
        for my $f (@unsigned_files) {
            print STDERR "${fg}::   - $bl$f$rst\n";
        }
        print STDERR "${fg}::\n";
        print STDERR
            "${fg}:: ${ng}suggestion${rst}${fg} : run ${bl}bin/Protocol-7 sourcecode update-signatures$rst$fg to sign\n";
        print STDERR "${fg}::\n";
        print STDERR
            "${fg}:: ${no}hint${rst}${fg} : all source files must have AMOS7 signatures for security\n";
        print STDERR "${fg}::\n";
        print STDERR
            "${fg}:: to override this check: ${bl}git commit -no-verify$rst or ${bl}SKIP_SIGNATURE_CHECK=1 git commit$rst\n";
        print STDERR "${fg}::\n$rst";
        exit 1;
    }
}

exit 0;

