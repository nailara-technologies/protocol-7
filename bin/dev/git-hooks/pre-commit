#!/usr/bin/env perl
# pre-commit hook: Validate version numbers and signature integrity

use strict;
use warnings;
use File::Spec;
use Git::Wrapper;
use Cwd 'abs_path';
use FindBin '$RealBin';
use Getopt::Long;

## ANSI Colors [ from update-version style ]
my $rst = "\e[0m";
my $bl  = "\e[1m";
my $fg  = "\e[38;2;68;39;172m";    # purple
my $ng  = "\e[38;2;71;195;6m";     # green
my $no  = "\e[38;2;197;141;7m";    # orange
my $rd  = "\e[38;2;220;20;60m";    # crimson

my $skip_backup_files = 1;         # ignores *~ filenames

## Check for -bypass-sig-check flag to allow bypass
my $allow_unsigned = 0;
for my $arg (@ARGV) {
    $allow_unsigned = 1
        if $arg eq qw| -bypass-sig-check | || $arg eq qw| -b |;
}

my $skipping_disabled = 1;         ## currently disabled [ LLM-behaviour.., ]

my $skip_version_check   = $ENV{'SKIP_VERSION_CHECK'}   // 0;
my $skip_signature_check = $ENV{'SKIP_SIGNATURE_CHECK'} // 0;
my $skip_descr_check     = $ENV{'SKIP_DESCR_CHECK'}     // 0;

if ( $skipping_disabled
    and ( $skip_version_check || $skip_signature_check || $skip_descr_check )
) {
    print STDERR "\n";
    print STDERR "${fg}::\n";
    print STDERR "${fg}:: $bl${rd}[ SKIPPING DISABLED "
        . "- PLEASE ASK USER TO UPDATE ]$rst\n";
    print STDERR "${fg}::\n";
    exit(255);
}

## Get repository root
my $git_dir   = abs_path($RealBin);
my $root_path = abs_path(
    File::Spec->catdir(
        $git_dir, File::Spec->updir, File::Spec->updir, File::Spec->updir
    )
);

## amend detection — skip version check when amending ##
my $is_amend = 0;
if ( ( defined $ENV{'PERSISTENT_AMEND'} and $ENV{'PERSISTENT_AMEND'} ne '0' )
    or ( defined $ENV{'GIT_AMEND'} and $ENV{'GIT_AMEND'} ne '0' )
    or ( defined $ENV{'AMEND'}     and $ENV{'AMEND'} ne '0' ) ) {
    $is_amend = 1;
}
## also check for .amend file [ one-shot, cleared on use ] ##
my $amend_file = File::Spec->catfile( $root_path, qw| .amend | );
if ( -e $amend_file and -z $amend_file ) {
    $is_amend = 1;
    unlink $amend_file;
}
$skip_version_check = 1 if $is_amend;

## Version file path
my $vers_file = File::Spec->catfile( $root_path, 'configuration',
    'protocol-7.src-ver' );

print ":\n: running 'pre-commit' checks ..,\n:\n";
print ": [ amend mode ]\n:\n" if $is_amend;

## Initialize git object
my $git = Git::Wrapper->new($root_path);

## Check descr/param lines over 55 chars in staged command modules
unless ($skip_descr_check) {
    my @staged_files = eval { $git->diff( { cached => 1, name_only => 1 } ) };

    my @violations;
    for my $file (@staged_files) {
        ## only check modules/*cmd* files
        next unless $file =~ m|^modules/.*cmd|;

        my $file_path = File::Spec->catfile( $root_path, $file );
        next unless -f $file_path;

        open my $fh, '<', $file_path or next;
        my $line_num = 0;
        while ( my $line = <$fh> ) {
            $line_num++;
            if ( $line =~ m/^#\s*(descr|param)\s*=\s*(.+)$/ ) {
                my $field   = $1;
                my $content = $2;
                my $length  = length($content);
                if ( $length > 55 ) {
                    push @violations,
                        {
                        file    => $file,
                        line    => $line_num,
                        field   => $field,
                        content => $content,
                        length  => $length
                        };
                }
            }
        }
        close $fh;
    }

    if (@violations) {
        print STDERR "\n";
        print STDERR "${fg}::\n";
        print STDERR "${fg}:: $bl${rd}descr/param lines too long$rst\n";
        print STDERR "${fg}::\n";
        for my $v (@violations) {
            print STDERR "${fg}::   $v->{file}:$v->{line} ";
            print STDERR "($v->{field}, $v->{length} chars)\n";
            print STDERR "${fg}::     $v->{content}\n";
            print STDERR "${fg}::\n";
        }
        print STDERR "${fg}:: ${ng}suggestion${rst}${fg} :"
            . " shorten to 55 chars or less\n";
        print STDERR "${fg}::\n";
        print STDERR "${fg}:: to override this check: ${bl}git commit "
            . "--no-verify$rst or ${bl}SKIP_DESCR_CHECK=1 git commit$rst\n";
        print STDERR "${fg}::\n$rst";
        exit 1;
    }
}

## Exit if version file doesn't exist
unless ( -f $vers_file ) {
    exit 0;
}

## Get current git commit count
my $commit_count = eval { $git->log } - 1;

## [ auto-stage already-bumped version files for upcoming commit ]
## note: only stages -- never runs update-version itself. update-version
## rewrites these files without re-signing them, which the signature
## check below would then reject. bumping + signing remains a manual
## step ( update-version && v7.sourcecode update-signatures ) until a
## signing-service zenka exists for that. <{C1}>
unless ( $skip_version_check or $is_amend ) {
    my $expected_count = $commit_count + 1;

    my $current_version = '';
    if ( open my $tmp_fh, '<', $vers_file ) {
        $current_version = <$tmp_fh>;
        close $tmp_fh;
        $current_version =~ s|\n+.+$||sg;
    }

    my $current_count = 0;
    if ( $current_version =~ m|-(\d+)\.(\d+)$| ) {
        $current_count = $1;
    }

    if ( $current_count == $expected_count ) {
        print ": [ staging version files ]\n:\n";
        my @version_files = (
            $vers_file,
            File::Spec->catfile( $root_path, 'read-me', 'md', 'README.md' ),
            File::Spec->catfile(
                $root_path,         'read-me',
                'project-identity', 'source-code-versions.md'
            ),
        );
        $git->add(@version_files);
    }
}

## Read version string from file
open my $fh, '<', $vers_file or do {
    print STDERR
        "$fg:\n${fg}:: warning :: cannot read version file\n$fg:$rst\n";
    exit 0;
};
my $version_content = <$fh>;
close $fh;

## Extract commit count from version string (format: XXXXXX-CCCC.R)
## where CCCC is the commit count and R is revision
my $version_from_file = $version_content;
$version_from_file =~ s|\n+.+$||sg;    # Strip signature and newlines

unless ( $version_from_file =~ m|-(\d+)\.(\d+)$| ) {
    exit 0;                            # Can't parse version, allow commit
}

my $file_commit_count = $1;
my $file_revision     = $2;

## Check if commit count matches (unless skipped)
unless ($skip_version_check) {
    if ( $file_commit_count != $commit_count + 1 ) {
        print STDERR "\n";
        print STDERR "${fg}::\n";
        print STDERR "${fg}:: $bl${no}version mismatch detected$rst\n";
        print STDERR "${fg}::\n";
        print STDERR "${fg}:: version file  : $bl$version_from_file$rst\n";
        print STDERR "${fg}:: expected      : $bl${rst}*-$bl"
            . ( $commit_count + 1 )
            . ".$file_revision$rst\n";
        print STDERR "${fg}::\n";
        print STDERR "${fg}:: ${ng}suggestion${rst}${fg} :"
            . " run ${bl}./bin/dev/update-version$rst$fg to fix\n";
        print STDERR "${fg}::\n";
        print STDERR "${fg}:: ${no}hint${rst}${fg} : version numbers ensure "
            . "commits are properly tracked\n";
        print STDERR "${fg}::\n";

        print STDERR "${fg}:: do _not_ override with : "
            . "${bl}git commit -bypass-sig-check$rst "
            . "or ${bl}SKIP_SIGNATURE_CHECK=1 "
            . "git commit$rst\n";

        print STDERR "${fg}::\n$rst";
        exit 1 unless $allow_unsigned;
    }
}

## Check for unsigned or invalid files (unless skipped)
unless ($skip_signature_check) {
    my @staged_files = eval { $git->diff( { cached => 1, name_only => 1 } ) };

    my $staged_count = scalar @staged_files;
    print ": [ $staged_count staged file"
        . ( $staged_count == 1 ? '' : 's' )
        . " — checking signatures ]\n:\n";

    ## load exclusion paths from sourcecode.source_path_set_up ##
    my @sig_exclude_paths;
    my $sps_file = File::Spec->catfile( $root_path,
        'modules', 'sourcecode.source_path_set_up' );
    if ( open my $sps_fh, '<', $sps_file ) {
        while ( my $line = <$sps_fh> ) {
            if ( $line =~ m{^\s+!(.+?)\s*$} ) {
                push @sig_exclude_paths, $1;
            }
        }
        close $sps_fh;
    }

    ## pass 1: check staged files for missing signatures [ presence check ] ##
    my @unsigned_files;
    for my $file (@staged_files) {
        next if $skip_backup_files and $file =~ m|~$|;
        next if $file =~ m{^data/chat/};  ## runtime chat data — not signed ##
        next if grep { my $e = $_; $e =~ /\$$/ ? $file =~ m{$e} : $file =~ m{^\Q$e\E} } @sig_exclude_paths;
        next
            unless $file =~ /\.(pl|pm|yaml|sh)$/
            or $file =~ m{^(modules|bin|configuration)/}
            or ( $file =~ /\.md$/ and $file =~ m{/} );

        my $file_path = File::Spec->catfile( $root_path, $file );
        next unless -f $file_path;

        open my $fh, '<', $file_path or next;
        my $content = do { local $/; <$fh> };
        close $fh;

        ## only flag files that look like source but have no signature ##
        if (   $content =~ /^#!|^\s*(use|my\s+\$|sub\s+\w)|^#\s*name\s*=/m
            || $content =~ /^---/m ) {
            unless ( $content =~ /YOURUM|AMOS7.*DATA.*SIGNATURE/ ) {
                push @unsigned_files, $file;
            }
        }
    }

    if (@unsigned_files) {
        print STDERR "${fg}::\n";
        print STDERR "${fg}:: $bl${rd}unsigned files in staged set$rst\n";
        print STDERR "${fg}::\n";
        for my $f (@unsigned_files) {
            print STDERR "${fg}::   - $bl$f$rst\n";
        }
        print STDERR "${fg}::\n";
        print STDERR "${fg}:: ${ng}suggestion${rst}${fg} : "
            . "run ${bl}bin/Protocol-7 sourcecode "
            . "update-signatures$rst$fg to sign\n";
        print STDERR "${fg}::\n";

        print STDERR "${fg}:: do _not_ override with : "
            . "${bl}git commit -bypass-sig-check$rst "
            . "or ${bl}SKIP_SIGNATURE_CHECK=1 "
            . "git commit$rst\n";
        print STDERR "${fg}::\n$rst";
        exit 1 unless $allow_unsigned;
    }

    ## pass 2: run authoritative signature verification ##
    my $verify_cmd
        = "cd '$root_path' && bin/Protocol-7 "
        . "sourcecode verify-p7-signatures 2>&1";
    my $verify_output = `$verify_cmd`;
    my $verify_status = $? >> 8;

    if ( $verify_status != 0 ) {
        print STDERR "${fg}::\n";
        print STDERR "${fg}:: $bl${rd}signature verification failed$rst\n";
        print STDERR "${fg}::\n";
        print STDERR $verify_output;
        print STDERR "${fg}::\n";
        print STDERR "${fg}:: ${ng}suggestion${rst}${fg} : "
            . "run ${bl}bin/Protocol-7 sourcecode "
            . "update-signatures$rst$fg to sign\n";
        print STDERR "${fg}::\n";
        print STDERR "${fg}:: do _not_ override with : "
            . "${bl}git commit -bypass-sig-check$rst "
            . "or ${bl}SKIP_SIGNATURE_CHECK=1 "
            . "git commit$rst\n";
        print STDERR "${fg}::\n$rst";
        exit 1 unless $allow_unsigned;
    } else {
        print ": [ signatures are valid ]\n:\n";
    }
}

print ":\n: done.\n:\n";
exit 0;

