#!/usr/bin/perl
use v5.24;
use strict;
use English;
use warnings;

###                                                                  ###
##  osf-holdings ##  [ stage 2 : stateful incremental holdings scan ] ##
###                                                                 ###

## reads every *_InRelease in the apt list directory, verifies its          ##
## clearsign signature with gpgv against the keyrings apt trusts, then      ##
## reads each Packages file it anchors [ expecting the InRelease hash ]     ##
## into one combined anchor index [ '<algo>:<hex>' keys ]. the local apt    ##
## archive cache is scanned against that index in ONE pass per file,        ##
## computing every index algo plus bmw384 [ B32, the protocol-7 internal id ##
## ] : how many cached .debs are exactly anchored in a signed distribution  ##
## index -> free passive supply. with --state <path> the scan becomes       ##
## incremental : unchanged files [ name, size, mtime, ctime, inode ] reuse  ##
## all recorded digests, the new state is saved, and 'rehashed N of M'      ##
## reports how many files were actually read.                               ##

##[ module loading [ standalone, same shape as bin/test-scripts ] ]###########

use File::Spec;
use Cwd     qw| abs_path |;
use FindBin qw| $RealBin |;

BEGIN {
    my $up_dir    = File::Spec->updir;
    my $root_path = abs_path(
        File::Spec->rel2abs(
            File::Spec->catdir( $RealBin, $up_dir, $up_dir )
        )
    );
    my $local_lib_path
        = File::Spec->catdir( $root_path, qw| data lib-path pm | );
    die "not found : $local_lib_path" if !-d $local_lib_path;
    unshift( @INC, $local_lib_path );
    $main::root_path = $root_path;
}

use AMOS7::Protocol::P7Syntax qw| p7_syntax__translate |;
## base.chk-sum.bmw.encode_digest calls it ##
use Crypt::Misc qw| encode_b32r |;

use constant TRUE  => 5;
use constant FALSE => 0;

our %code;
our %data;

sub compile_module {
    my $module_name = shift;
    my $src_path
        = File::Spec->catfile( $main::root_path, 'src', $module_name );
    open( my $fh, '<', $src_path ) or die "cannot read $src_path : $!";
    my $src = join( '', <$fh> );
    close($fh);
    my $translated = p7_syntax__translate($src);
    my $cref       = eval "sub {\n# line 1 \"$module_name\"\n$translated\n}";
    die "compile failed for $module_name : $EVAL_ERROR"
        if not defined $cref;
    $code{$module_name} = $cref;
    return $cref;
}

compile_module('osf-cache.debian.read_inrelease');
compile_module('osf-cache.debian.read_packages');
compile_module('osf-cache.holdings.scan_apt_cache');
compile_module('osf-cache.holdings.state_save');
compile_module('osf-cache.holdings.state_load');
compile_module('format.yaml.pre_init');
compile_module('format.yaml.write_file');
compile_module('format.yaml.load_file');
compile_module('base.chk-sum.bmw.encode_digest');
$code{'chk-sum.bmw.encode_digest'}
    ## short name modules call ##
    = $code{'base.chk-sum.bmw.encode_digest'};

##[ format.yaml wiring [ standalone stubs ] ]#################################
##                                                                       ##
## the state modules persist through the format.yaml wrappers, which     ##
## resolve their dependencies through the p7 call syntax : %code entries ##
## for <[base.*]> calls and %data for <format.yaml.*> values. the zenka  ##
## provides the real ones ; here they are minimal standalone stubs.      ##
## pre_init must run once before the first write_file / load_file call.  ##

$code{'base.perlmod.autoload'} = sub {
    my $module = shift // return undef;
    eval "require $module" or die $EVAL_ERROR;
    return 5;
};

$code{'base.logs'} = sub {
    return 5;
};

$code{'base.buffer.add_line'} = sub {
    return 5;
};

$code{'base.str.eval_error'} = sub {
    my $error = $EVAL_ERROR // '';
    $error =~ s|\s*\n.*||s;
    $error =~ s|\s+$||;
    return $error;
};

call_module('format.yaml.pre_init');

sub call_module {
    my ( $module_name, $params ) = @ARG;
    return $code{$module_name}->($params);
}

##[ run ]#####################################################################

my $state_path = undef;
my $lists_dir  = undef;
while (@ARGV) {
    my $arg = shift @ARGV;
    if ( $arg eq qw| --state | ) {
        $state_path = shift @ARGV;
        error_exit('--state requires a path') unless defined $state_path;
    } else {
        $lists_dir = $arg;
    }
}
$lists_dir //= '/var/lib/apt/lists';
my $cache_dir = '/var/cache/apt/archives';

error_exit("not a directory : '$lists_dir'") if !-d $lists_dir;

my @inrelease_files
    = sort grep { m{_InRelease$} and -f $_ } glob "$lists_dir/*";

say '';
say ':: osf-holdings [ debian index reader + local holdings scan ]';
say '';
say "   lists : $lists_dir";
say "   cache : $cache_dir";
say "   state : $state_path" if defined $state_path;
say '';

##[ read + verify every InRelease, build the combined anchor index ]##########

my %combined_anchors;
my %combined_algos;
my @repo_report;
my %claimed_packages_file;

foreach my $inrelease_path (@inrelease_files) {
    my $list_name = $inrelease_path;
    $list_name =~ s{^.*/}{};
    my $base = $list_name;
    $base =~ s{_InRelease$}{};

    my $ir = call_module( 'osf-cache.debian.read_inrelease',
        { 'path' => $inrelease_path } );

    my $repo = {
        'id'        => $base,
        'suite'     => $ir->{'data'}{'suite'} // '-',
        'codename'  => $ir->{'data'}{'codename'},
        'signature' => $ir->{'data'}{'signature'} // qw| unverified |,
        'signer'    => $ir->{'data'}{'signer'},
        'packages'  => [],
        'skipped'   => [],
        'entries'   => 0,
    };

    foreach my $rel_path ( sort keys %{ $ir->{'data'}{'files'} } ) {

        ## only uncompressed Packages indexes are read [ apt stores them ##
        ## plain in the list dir ]                                       ##
        next unless $rel_path eq qw| Packages | or $rel_path =~ m{/Packages$};

        my $entry     = $ir->{'data'}{'files'}->{$rel_path};
        my $flat_path = $rel_path;
        $flat_path =~ s{/}{_}g;
        my $packages_name = "$base" . '_' . $flat_path;
        my $packages_path = "$lists_dir/$packages_name";

        if ( !-f $packages_path ) {
            push $repo->{'skipped'}->@*, $rel_path;
            next;
        }

        my $pr = call_module(
            'osf-cache.debian.read_packages',
            {   'path'   => $packages_path,
                'expect' => {
                    'algo' => $entry->{'algo'},
                    'hash' => $entry->{'hash'},
                },
            }
        );

        if ( $pr->{'mode'} ne qw| true | ) {
            push $repo->{'skipped'}->@*,
                "$rel_path [ read failed : $pr->{'data'} ]";
            next;
        }

        $claimed_packages_file{$packages_name} = 1;

        ## trust needs both : the InRelease signature verified good AND the ##
        ## packages file matching its hash -- otherwise entries are listed  ##
        ## but never used to anchor cached files                            ##
        if (    $repo->{'signature'} eq qw| good |
            and $pr->{'data'}{'anchored'} ) {
            foreach my $anchor ( keys %{ $pr->{'data'}{'by_anchor'} } ) {
                $combined_anchors{$anchor}
                    = $pr->{'data'}{'by_anchor'}->{$anchor};
                my ($algo) = split m{:}, $anchor, 2;
                $combined_algos{$algo} = 1 if length $algo;
            }
        }

        push $repo->{'packages'}->@*,
            {
            'rel_path' => $rel_path,
            'anchored' => $pr->{'data'}{'anchored'},
            'entries'  => $pr->{'data'}{'entries'},
            };
        $repo->{'entries'} += $pr->{'data'}{'entries'};
    }

    push @repo_report, $repo;
}

## packages files present in the list dir but claimed by no InRelease ##
my @unclaimed_files = sort grep {
            m{_Packages$}
        and -f $_
        and not $claimed_packages_file{ $ARG =~ s{^.*/}{}r }
} glob "$lists_dir/*";

##[ holdings scan against the combined index ]################################

my $previous_files = [];
if ( defined $state_path ) {
    my $loaded = call_module( 'osf-cache.holdings.state_load',
        { 'path' => $state_path } );
    error_exit("cannot load state '$state_path' : $loaded->{'data'}")
        if $loaded->{'mode'} ne qw| true |;
    $previous_files = $loaded->{'data'}{'holdings'}{'files'} // [];
}

my @combined_algos = sort keys %combined_algos;

my $holdings = call_module(
    'osf-cache.holdings.scan_apt_cache',
    {   'dir'   => $cache_dir,
        'index' => {
            'anchors' => \%combined_anchors,
            'algos'   => \@combined_algos,
        },
        'previous' => $previous_files,
    }
);

error_exit("holdings scan failed : $holdings->{'data'}")
    if $holdings->{'mode'} ne qw| true |;

if ( defined $state_path ) {
    my $saved = call_module(
        'osf-cache.holdings.state_save',
        {   'path'     => $state_path,
            'holdings' => $holdings->{'data'},
        }
    );
    error_exit("cannot save state '$state_path' : $saved->{'data'}")
        if $saved->{'mode'} ne qw| true |;
}

##[ report ]##################################################################

printf "   %d InRelease file%s, %d package index entr%s anchored\n\n",
    scalar @inrelease_files,
    @inrelease_files == 1 ? '' : 's',
    scalar keys %combined_anchors,
    ( keys %combined_anchors ) == 1 ? 'y' : 'ies';

say ':: repositories';
say '';

foreach my $repo (@repo_report) {
    my $codename
        = defined $repo->{'codename'} ? " [ $repo->{'codename'} ]" : '';
    printf "   %s%s\n     signature : %s\n",
        $repo->{'id'}, $codename, $repo->{'signature'};
    say "     signer    : $repo->{'signer'}"
        if defined $repo->{'signer'};
    foreach my $pkg ( $repo->{'packages'}->@* ) {
        printf "     packages  : %-42s %7d entries  anchored %s\n",
            $pkg->{'rel_path'}, $pkg->{'entries'},
            $pkg->{'anchored'} ? qw| y | : qw| n |;
    }
    printf "     no Packages entries in this InRelease\n"
        unless scalar $repo->{'packages'}->@*;

    my @skipped_ex = $repo->{'skipped'}->@*;
    if (@skipped_ex) {
        my $skipped_total = scalar @skipped_ex;
        my $more          = '';
        if ( @skipped_ex > 3 ) {
            $more = sprintf ' .. %d more', $skipped_total - 3;
            splice @skipped_ex, 3;
        }
        printf "     skipped   : %d index entries "
            . "not downloaded [ e.g. %s%s ]\n",
            $skipped_total, join( ', ', @skipped_ex ), $more;
    }
}

if (@unclaimed_files) {
    say '';
    say ':: Packages files not referenced by any InRelease entry';
    say '';
    say "   $_" foreach @unclaimed_files;
}

my $data   = $holdings->{'data'};
my @cached = $data->{'files'}->@*;

my $hr_size = sub {
    my $bytes = shift // 0;
    return sprintf '%.1f MB',  $bytes / 1048576 if $bytes >= 1048576;
    return sprintf '%.1f kB',  $bytes / 1024    if $bytes >= 1024;
    return sprintf '%d bytes', $bytes;
};

my $summary = sprintf '%d cached .deb%s, %d exactly anchored',
    scalar @cached, @cached == 1 ? '' : 's', $data->{'anchored_count'};
$summary .= sprintf ', %s of %s anchored',
    $hr_size->( $data->{'anchored_bytes'} ),
    $hr_size->( $data->{'total_bytes'} );

say '';
say ":: holdings [ $cache_dir ]";
say '';
say "   $summary";

printf "   rehashed %d of %d\n", $data->{'rehashed'} // 0, scalar @cached
    if defined $state_path;

my @anchored_example = grep { $ARG->{'anchored'} } @cached;
my @loose_example    = grep { !$ARG->{'anchored'} } @cached;

say '';
say '   anchored examples :';
say '     none' unless @anchored_example;
foreach my $file (
    @anchored_example[
    0 .. ( @anchored_example > 2 ? 2 : $#anchored_example )
    ]
) {
    printf "     %-42s %10d bytes  %s %s\n",
        $file->{'name'}, $file->{'size'},
        $file->{'package'} // '-', $file->{'version'} // '-';
    my ( $algo, $hex ) = split m{:}, $file->{'anchor'} // ':', 2;
    printf "     algo %-7s anchor %s…  bmw384 %s…\n",
        $algo // '-', substr( $hex // '', 0, 12 ),
        substr( $file->{'digests'}{'bmw384'} // '', 0, 12 );
}

say '';
say '   unanchored examples :';
say '     none' unless @loose_example;
foreach my $file (
    @loose_example[ 0 .. ( @loose_example > 2 ? 2 : $#loose_example ) ] ) {
    printf "     %-42s %10d bytes  %s %s\n",
        $file->{'name'}, $file->{'size'},
        $file->{'package'} // '-', $file->{'version'} // '-';
    printf "     bmw384 %s…  [ unanchored ]\n",
        substr( $file->{'digests'}{'bmw384'} // '', 0, 12 );
}

say '';
exit 0;

##[ SUBROUTINES ]#############################################################

sub error_exit {
    my $msg = shift;
    say STDERR "\n:\n:: $msg\n:\n";
    exit 1;
}

