#!/usr/bin/perl
use v5.24;
use strict;
use English;
use warnings;

###                                                                  ###
##  osf-holdings ##   [ stage 1 : debian index reader + holdings scan ] ##
###                                                                 ###

## reads every *_InRelease in the apt list directory, verifies its     ##
## clearsign signature with gpgv against the keyrings apt trusts, then ##
## reads each Packages file it anchors [ expecting the InRelease hash ]##
## into one combined sha256 index. the local apt archive cache is      ##
## scanned against that index : how many cached .debs are exactly      ##
## anchored in a signed distribution index -> free passive supply.     ##

##[ module loading [ standalone, same shape as bin/test-scripts ] ]#############

use File::Spec;
use Cwd     qw| abs_path |;
use FindBin qw| $RealBin |;

BEGIN {
    my $up_dir    = File::Spec->updir;
    my $root_path = abs_path(
        File::Spec->rel2abs(
            File::Spec->catdir( $RealBin, $up_dir, $up_dir )
        )
    );
    my $local_lib_path
        = File::Spec->catdir( $root_path, qw| data lib-path pm | );
    die "not found : $local_lib_path" if !-d $local_lib_path;
    unshift( @INC, $local_lib_path );
    $main::root_path = $root_path;
}

use AMOS7::Protocol::P7Syntax qw| p7_syntax__translate |;

use constant TRUE  => 5;
use constant FALSE => 0;

our %code;

sub compile_module {
    my $module_name = shift;
    my $src_path
        = File::Spec->catfile( $main::root_path, 'src', $module_name );
    open( my $fh, '<', $src_path ) or die "cannot read $src_path : $!";
    my $src = join( '', <$fh> );
    close($fh);
    my $translated = p7_syntax__translate($src);
    my $cref       = eval "sub {\n# line 1 \"$module_name\"\n$translated\n}";
    die "compile failed for $module_name : $EVAL_ERROR"
        if not defined $cref;
    $code{$module_name} = $cref;
    return $cref;
}

compile_module('osf-cache.debian.read_inrelease');
compile_module('osf-cache.debian.read_packages');
compile_module('osf-cache.holdings.scan_apt_cache');

sub call_module {
    my ( $module_name, $params ) = @ARG;
    return $code{$module_name}->($params);
}

##[ run ]#######################################################################

my $lists_dir = shift // '/var/lib/apt/lists';
my $cache_dir = '/var/cache/apt/archives';

error_exit("not a directory : '$lists_dir'") if !-d $lists_dir;

my @inrelease_files = sort grep { m{_InRelease$} and -f $_ }
    glob "$lists_dir/*";

say '';
say ':: osf-holdings [ debian index reader + local holdings scan ]';
say '';
say "   lists : $lists_dir";
say "   cache : $cache_dir";
say '';

##[ read + verify every InRelease, build the combined sha256 index ]#############

my %combined_index;
my @repo_report;
my %claimed_packages_file;

foreach my $inrelease_path (@inrelease_files) {
    my $list_name = $inrelease_path;
    $list_name =~ s{^.*/}{};
    my $base = $list_name;
    $base =~ s{_InRelease$}{};

    my $ir = call_module( 'osf-cache.debian.read_inrelease',
        { 'path' => $inrelease_path } );

    my $repo = {
        'id'        => $base,
        'suite'     => $ir->{'data'}{'suite'} // '-',
        'codename'  => $ir->{'data'}{'codename'},
        'signature' => $ir->{'data'}{'signature'} // qw| unverified |,
        'signer'    => $ir->{'data'}{'signer'},
        'packages'  => [],
        'skipped'   => [],
        'entries'   => 0,
    };

    foreach my $rel_path ( sort keys %{ $ir->{'data'}{'files'} } ) {

        ## only uncompressed Packages indexes are read [ apt stores ##
        ## them plain in the list dir ]                              ##
        next unless $rel_path eq qw| Packages | or $rel_path =~ m{/Packages$};

        my $entry      = $ir->{'data'}{'files'}->{$rel_path};
        my $flat_path  = $rel_path;
        $flat_path =~ s{/}{_}g;
        my $packages_name = "$base" . '_' . $flat_path;
        my $packages_path = "$lists_dir/$packages_name";

        if ( !-f $packages_path ) {
            push $repo->{'skipped'}->@*, $rel_path;
            next;
        }

        my $pr = call_module(
            'osf-cache.debian.read_packages',
            {   'path'          => $packages_path,
                'expect_sha256' => $entry->{'sha256'},
            }
        );

        if ( $pr->{'mode'} ne qw| true | ) {
            push $repo->{'skipped'}->@*,
                "$rel_path [ read failed : $pr->{'data'} ]";
            next;
        }

        $claimed_packages_file{$packages_name} = 1;

        ## trust needs both : the InRelease signature verified good AND the ##
        ## packages file matching its hash -- otherwise entries are listed  ##
        ## but never used to anchor cached files                            ##
        if ( $repo->{'signature'} eq qw| good | and $pr->{'data'}{'anchored'} )
        {
            $combined_index{$ARG} = $pr->{'data'}{'by_sha256'}->{$ARG}
                foreach keys %{ $pr->{'data'}{'by_sha256'} };
        }

        push $repo->{'packages'}->@*, {
            'rel_path' => $rel_path,
            'anchored' => $pr->{'data'}{'anchored'},
            'entries'  => $pr->{'data'}{'entries'},
        };
        $repo->{'entries'} += $pr->{'data'}{'entries'};
    }

    push @repo_report, $repo;
}

## packages files present in the list dir but claimed by no InRelease ##
my @unclaimed_files = sort grep {
    m{_Packages$} and -f $_ and not $claimed_packages_file{ $ARG =~ s{^.*/}{}r }
} glob "$lists_dir/*";

##[ holdings scan against the combined index ]###################################

my $holdings = call_module( 'osf-cache.holdings.scan_apt_cache',
    { 'dir' => $cache_dir, 'index' => \%combined_index } );

error_exit( "holdings scan failed : $holdings->{'data'}" )
    if $holdings->{'mode'} ne qw| true |;

##[ report ]#####################################################################

printf "   %d InRelease file%s, %d package index entr%s anchored\n\n",
    scalar @inrelease_files,
    @inrelease_files == 1 ? '' : 's',
    scalar keys %combined_index,
    ( keys %combined_index ) == 1 ? 'y' : 'ies';

say ':: repositories';
say '';

foreach my $repo (@repo_report) {
    my $codename = defined $repo->{'codename'}
        ? " [ $repo->{'codename'} ]" : '';
    printf "   %s%s\n     signature : %s\n",
        $repo->{'id'}, $codename, $repo->{'signature'};
    say "     signer    : $repo->{'signer'}"
        if defined $repo->{'signer'};
    foreach my $pkg ( $repo->{'packages'}->@* ) {
        printf "     packages  : %-42s %7d entries  anchored %s\n",
            $pkg->{'rel_path'}, $pkg->{'entries'},
            $pkg->{'anchored'} ? qw| y | : qw| n |;
    }
    printf "     no Packages entries in this InRelease\n"
        unless scalar $repo->{'packages'}->@*;

    my @skipped_ex = $repo->{'skipped'}->@*;
    if (@skipped_ex) {
        my $skipped_total = scalar @skipped_ex;
        my $more = '';
        if ( @skipped_ex > 3 ) {
            $more = sprintf ' .. %d more', $skipped_total - 3;
            splice @skipped_ex, 3;
        }
        printf
            "     skipped   : %d index entries not downloaded"
            . " [ e.g. %s%s ]\n",
            $skipped_total, join( ', ', @skipped_ex ), $more;
    }
}

if (@unclaimed_files) {
    say '';
    say ':: Packages files not referenced by any InRelease entry';
    say '';
    say "   $_" foreach @unclaimed_files;
}

my $data   = $holdings->{'data'};
my @cached = $data->{'files'}->@*;

my $hr_size = sub {
    my $bytes = shift // 0;
    return sprintf '%.1f MB', $bytes / 1048576 if $bytes >= 1048576;
    return sprintf '%.1f kB', $bytes / 1024    if $bytes >= 1024;
    return sprintf '%d bytes', $bytes;
};

my $summary = sprintf '%d cached .deb%s, %d exactly anchored',
    scalar @cached, @cached == 1 ? '' : 's', $data->{'anchored_count'};
$summary .= sprintf ', %s of %s anchored',
    $hr_size->( $data->{'anchored_bytes'} ),
    $hr_size->( $data->{'total_bytes'} );

say '';
say ":: holdings [ $cache_dir ]";
say '';
say "   $summary";

my @anchored_example = grep { $ARG->{'anchored'} } @cached;
my @loose_example    = grep { !$ARG->{'anchored'} } @cached;

say '';
say '   anchored examples :';
say '     none' unless @anchored_example;
foreach my $file ( @anchored_example[ 0 .. ( @anchored_example > 2 ? 2 : $#anchored_example ) ] )
{
    printf "     %-42s %10d bytes  %s %s\n",
        $file->{'name'}, $file->{'size'},
        $file->{'package'} // '-', $file->{'version'} // '-';
}

say '';
say '   unanchored examples :';
say '     none' unless @loose_example;
foreach my $file ( @loose_example[ 0 .. ( @loose_example > 2 ? 2 : $#loose_example ) ] )
{
    printf "     %-42s %10d bytes  %s %s\n",
        $file->{'name'}, $file->{'size'},
        $file->{'package'} // '-', $file->{'version'} // '-';
}

say '';
exit 0;

##[ SUBROUTINES ]###############################################################

sub error_exit {
    my $msg = shift;
    say STDERR "\n:\n:: $msg\n:\n";
    exit 1;
}

