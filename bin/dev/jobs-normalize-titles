#| jobs-normalize-titles
#| recursively strip noisy prefixes / gender suffixes from job titles
#| in both the jobsite and web job caches.
#| keep the patterns in sync with src/jobsite.cmd.job-upsert

use strict;
use warnings;
use File::Find;
use YAML::XS;

my @patterns = (
    { re => qr{^\s*\[Hiring\]\s+}i,  name => '[Hiring]' },
    { re => qr{\s*\(all genders\)}i, name => '(all genders)' },
    {   re   => qr{\s*\((?:m/w/d|w/m/d|m/f/d|f/m/d)\)}i,
        name => 'gender suffix'
    },
);

sub normalize_title {
    my $title = shift;
    return $title unless defined $title and length $title;
    for my $p (@patterns) { $title =~ s|$p->{re}||g; }
    $title =~ s{\s+$}{};
    return $title;
}

my @roots = ( '/var/protocol-7/jobsite/jobs', '/var/protocol-7/web/jobs', );

my ( $seen, $changed ) = ( 0, 0 );

find(
    sub {
        return unless -f $_ and $_ =~ m{\.yaml$};
        my $file = $File::Find::name;
        my $job  = eval { YAML::XS::LoadFile($file) };
        return if ref $job ne 'HASH';

        my $orig = $job->{'title'} // '';
        my $new  = normalize_title($orig);
        return if $new eq $orig;

        $job->{'title'} = $new;
        $seen++;

        my $tmp = "$file.tmp";
        eval { YAML::XS::DumpFile( $tmp, $job ) };
        if ( -f $tmp ) {
            rename $tmp, $file or do {
                warn "rename $tmp -> $file: $!\n";
                unlink $tmp;
                return;
            };
            print "[updated] $file\n";
            print "    '$orig'\n";
            print " -> '$new'\n";
            $changed++;
        } else {
            warn "failed to write $file\n";
        }
    },
    @roots
);

print "\n$changed title(s) normalized.\n";

