#!/usr/bin/perl
#..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..:.
#:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:

use v5.24;
use strict;
use English;
use warnings;
use List::Util qw| min |;
use Getopt::Long;
use IO::Compress::Xz qw| xz $XzError |;
use Crypt::Misc      qw| encode_b32r |;

###           ###
##  dep-graph  ##                                #:..:..:..:..:..:..:..:..:..:
###           ###

##  static dependency graph generator for protocol-7 modules  ##
##  maps module-to-module call sites across the modules/ directory  ##

#:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:..:
##[ LOCAL PM LIB PATH ]#######################################################

BEGIN {
    use English;
    use File::Spec;
    use Cwd     qw| abs_path |;
    use FindBin qw| $RealBin |;
    our $up_dir = File::Spec->updir;
    our $Bin    = $RealBin;
    my $data_pm_path = qw| data/lib-path/pm |;
    our $root_path = abs_path( r2_abs( c_dir( $Bin, $up_dir, $up_dir ) ) );
    my $local_lib_path = abs_path( c_dir( $root_path, $data_pm_path ) );
    $local_lib_path //= $data_pm_path;
    die "\n:\n:: not found : $local_lib_path\n:\n" if !-d $local_lib_path;
    unshift( @INC, $local_lib_path )               if -d $local_lib_path;
    sub c_dir  { File::Spec->catdir(@ARG) }
    sub r2_abs { File::Spec->rel2abs(@ARG) }
}

use AMOS7::Graph;    ##  graph_to_adjacency, adjacency_to_graph  ##

##::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..
##[ COMMAND LINE OPTIONS ]####################################################

my %opt = (
    qw| text         | => 0,
    qw| dot          | => 0,
    qw| reverse      | => 0,
    qw| module       | => undef,
    qw| depth        | => 1,
    qw| zenka        | => undef,
    qw| stdin        | => 0,
    qw| list         | => 0,
    qw| list-modules | => 0,
    qw| list-configs | => 0,
    ##  flat reachable subroutine list [ full scan ]  ##
    qw| list-subs    | => 0,
    qw| count        | => 0,   ##  include call counts in adjacency output  ##
);

Getopt::Long::Configure('prefix_pattern=--|-');

GetOptions(
    qw| text   |        => \$opt{text},
    qw| dot    |        => \$opt{dot},
    qw| reverse|        => \$opt{reverse},
    qw| module=s      | => \$opt{module},
    qw| depth=i       | => \$opt{depth},
    qw| zenka=s       | => \$opt{zenka},
    qw| stdin         | => \$opt{stdin},
    qw| list          | => \$opt{list},
    qw| list-modules  | => \$opt{'list-modules'},
    qw| list-configs  | => \$opt{'list-configs'},
    qw| list-subs     | => \$opt{'list-subs'},
    qw| count         | => \$opt{'count'},
) or die ":: invalid command line arguments\n";

##  default to text output if no format specified  ##
$opt{text} = 1 if !$opt{text} && !$opt{dot};

##  validate depth is positive  ##
die ":: depth must be >= 0\n" if $opt{depth} < 0;

##  validate -zenka not combined with -module  ##
die ":: -zenka cannot be used with -module\n"
    if defined $opt{zenka} && defined $opt{module};

##  validate -stdin not combined with -zenka or -module  ##
die ":: -stdin cannot be used with -zenka\n"
    if $opt{stdin} && defined $opt{zenka};
die ":: -stdin cannot be used with -module\n"
    if $opt{stdin} && defined $opt{module};

##  validate list flags require a start file source  ##
my $any_list = $opt{list} || $opt{'list-modules'} || $opt{'list-configs'};
die ":: -list flags require -zenka=NAME or -stdin\n"
    if $any_list && !defined $opt{zenka} && !$opt{stdin};

##  -list-subs requires -zenka (needs full graph scan)  ##
die ":: -list-subs requires -zenka=NAME\n"
    if $opt{'list-subs'} && !defined $opt{zenka};

##::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..
##[ CONFIGURATION ]###########################################################

our $root_path;    ##  from BEGIN block  ##
my $modules_dir = c_dir( $root_path, qw| modules | );
my $output_dir
    = c_dir( $root_path, qw| data |, qw| md |, qw| documentation | );

##  output file paths  ##
my $text_output_path
    = c_dir( $output_dir, qw| module-dependency-graph.asc | );
my $dot_output_path = c_dir( $output_dir, qw| module-dependency-graph.dot | );
my $txz_output_path = c_dir( $output_dir, qw| module-dependency-graph.txz | );

##::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..
##[ MAIN ]####################################################################

##  handle list flags [ no dep-graph scan needed ]  ##
if ($any_list) {
    my @lines;
    if ( $opt{stdin} ) {
        @lines = <STDIN>;
    } else {
        my $start_file = c_dir( $root_path, qw| configuration zenki |,
            $opt{zenka}, qw| start | );
        die ":: zenka start file not found: $start_file\n" if !-f $start_file;
        open my $fh, qw| < |, $start_file
            or die ":: cannot read $start_file: $OS_ERROR\n";
        @lines = <$fh>;
        close $fh;
    }

    my ( $loaded_set, undef, $config_files, $config_ambiguous )
        = parse_start_lines( \@lines );

    my @to_print;
    if ( $opt{'list-modules'} || $opt{list} ) {
        push @to_print, sort_by_length( keys %{$loaded_set} );
    }
    if ( $opt{'list-configs'} || $opt{list} ) {
        push @to_print, sort_by_length( @{$config_files} );
    }

    ##  deduplicate and sort for -list  ##
    if ( $opt{list} ) {
        my %seen;
        @to_print = sort_by_length( grep { !$seen{$ARG}++ } @to_print );
    }

    say $ARG for @to_print;

    ##  flag runtime-resolved config paths  ##
    if ( ( $opt{'list-configs'} || $opt{list} ) && @{$config_ambiguous} ) {
        say ":: ambiguous [ runtime-resolved config path ]:";
        say "   $ARG" for sort_by_length( @{$config_ambiguous} );
    }

    exit 0;
}

##  scan all modules and build dependency graph  ##
my $graph = scan_modules($modules_dir);

##  handle -zenka mode [reachability analysis]  ##
if ( defined $opt{zenka} ) {
    analyze_zenka_reachability( $graph, $opt{zenka} );
    exit 0;
}

##  handle -stdin mode [reachability from piped start content]  ##
if ( $opt{stdin} ) {
    my @lines = <STDIN>;
    analyze_zenka_reachability( $graph, 'stdin', \@lines );
    exit 0;
}

##  filter graph if module specified  ##
if ( defined $opt{module} ) {
    $graph = filter_graph( $graph, $opt{module}, $opt{depth} );
}

##  reverse graph if requested  ##
if ( $opt{reverse} ) {
    $graph = reverse_graph($graph);
}

##  output results  ##
if ( $opt{text} ) {
    if ( defined $opt{module} ) {
        say generate_tree_output( $graph, $opt{module} );
    } else {
        my $text_output
            = graph_to_adjacency( $graph, { 'with-counts' => $opt{count} } );
        write_file( $text_output_path, $text_output );
        say ":: written to $text_output_path";
    }
}

if ( $opt{dot} ) {
    my $dot_output = generate_dot_output($graph);
    if ( defined $opt{module} ) {
        say $dot_output;
    } else {
        write_file( $dot_output_path, $dot_output );
        say ":: written to $dot_output_path";
        my $xz_data;
        xz( \$dot_output, \$xz_data, Preset => 9 )
            or die ":: xz compression failed: $XzError\n";
        my $b32 = encode_b32r($xz_data);
        open( my $txz_fh, qw| > |, $txz_output_path )
            or die ":: cannot write $txz_output_path: $OS_ERROR\n";
        while ( length $b32 ) {
            say $txz_fh substr( $b32, 0, 78, '' );
        }
        close $txz_fh;
        say ":: written to $txz_output_path";
    }
}

exit 0;

##::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..
##[ SUBROUTINES ]#############################################################

sub scan_modules {
    ##  scan modules directory and build dependency graph  ##
    my $dir = shift;

    my %graph;           ##  module -> { dep_module => call_count }  ##
    my %module_names;    ##  filename -> canonical module name  ##

    ##  get all module files  ##
    my @files = get_module_files($dir);

    ##  first pass: extract canonical module names  ##
    for my $file (@files) {
        my $module_name = extract_module_name($file);
        $module_names{$file} = $module_name if defined $module_name;
    }

    ##  build known module set and reverse swap map  ##
    ##  swap_subs renames base.X.* -> X.* at runtime  ##
    ##  resolve swapped call targets back to their source module names  ##
    my %known     = map { $module_names{$ARG} => 1 } keys %module_names;
    my %swap_from = extract_swap_pairs( \@files );    ##  short -> base  ##

 #  seed graph with all known modules [ leaf nodes have no outgoing edges ]  #
 #  without this, resolve_command_to_module misses leaf nodes entirely       #
    $graph{$ARG} //= {} for values %module_names;

    ##  second pass: scan for call patterns  ##
    for my $file (@files) {
        my $source_module = $module_names{$file};
        next if !defined $source_module;

        my @calls = extract_calls($file);
        for my $target (@calls) {
            my $resolved = $target;

            ##  resolve swapped name to source module name  ##
            ##  try each known base prefix for the matched short prefix  ##
            if ( !$known{$resolved} ) {
            SWAP: for my $short ( keys %swap_from ) {
                    ##  exact rename [ base.chk-sum.elf -> chk-sum.elf ]  ##
                    if ( $resolved eq $short ) {
                        for my $base ( @{ $swap_from{$short} } ) {
                            if ( $known{$base} ) {
                                $resolved = $base;
                                last SWAP;
                            }
                        }
                    }
                    ##  prefix namespace swap [ base.event -> event ]  ##
                    if ( $resolved =~ m|^\Q$short\E(\..+)$| ) {
                        my $suffix = $1;
                        for my $base ( @{ $swap_from{$short} } ) {
                            my $candidate = $base . $suffix;
                            if ( $known{$candidate} ) {
                                $resolved = $candidate;
                                last SWAP;
                            }
                        }
                    }
                }
            }

            $graph{$source_module}{$resolved}++
                if $known{$resolved};
        }
    }

    return \%graph;
}

sub extract_swap_pairs {
    ##  scan module files for base.swap_subs calls  ##
    ##  returns hash : short_prefix -> [ base_prefix, ... ]  ##
    ##  e.g. 'event' -> [ 'base.event' ], 'file' -> [ 'base.file' ]  ##
    ##  multiple sources can swap to the same short prefix, store all  ##
    my $files_ref = shift;
    my %swap_from;

    for my $file ( @{$files_ref} ) {
        open my $fh, qw| < |, $file or next;
        while ( my $line = <$fh> ) {
            next if $line !~ m|swap_subs|;

            my ( $from, $to );

            ##  single-quote form : swap_subs( 'base.X', 'X' )  ##
            if ( $line =~ m{'([^']+)'\s*,\s*'([^']+)'} ) {
                ( $from, $to ) = ( $1, $2 );

                ##  qw form : swap_subs(qw| base.X X |)  ##
            } elsif ( $line =~ m{qw.\s*(\S+)\s+(\S+)\s*.} ) {
                ( $from, $to ) = ( $1, $2 );

                ##  two-qw form : swap_subs( qw| base.X |, qw| X | )  ##
            } elsif ( $line =~ m{qw.\s*(\S+)\s*.\s*,\s*qw.\s*(\S+)\s*.} ) {
                ( $from, $to ) = ( $1, $2 );
            }

            ##  store as arrayref to handle multiple sources -> same short  ##
            push @{ $swap_from{$to} }, $from
                if defined $from and defined $to;
        }
        close $fh;
    }

    return %swap_from;
}

sub get_module_files {
    ##  recursively find all module files  ##
    my $dir = shift;
    my @files;

    opendir my $dh, $dir or die ":: cannot open $dir: $OS_ERROR\n";
    my @entries = readdir $dh;
    closedir $dh;

    for my $entry (@entries) {
        next if $entry eq qw| . | || $entry eq qw| .. |;
        next
            if $entry
            =~ m{(?<![^\w/])(DEADJOE|.+~)$};    ## editor backup files ##
        my $path = c_dir( $dir, $entry );
        if ( -d $path ) {
            push @files, get_module_files($path);
        } elsif ( -f $path ) {
            push @files, $path;
        }
    }

    return @files;
}

sub extract_module_name {
    ##  extract canonical module name from # name  = header line  ##
    my $file = shift;

    open my $fh, qw| < |, $file or return undef;
    while ( my $line = <$fh> ) {
        if ( $line =~ m/^\s*#\s*name\s*=\s*(\S+)/ ) {
            close $fh;
            return $1;
        }
    }
    close $fh;
    return undef;
}

sub extract_calls {
    ##  extract all module calls from file  ##
    my $file = shift;
    my @calls;

    open my $fh, qw| < |, $file or return @calls;
    my @lines = <$fh>;
    close $fh;

    ##  exclude AMOS7 signature footer [last 5 lines]  ##
    my $end_idx = scalar(@lines) - 6;
    $end_idx = 0 if $end_idx < 0;

    for my $i ( 0 .. $end_idx ) {
        my $line = $lines[$i];

        ##  primary call pattern: <[module.name]>  ##
        while ( $line =~ m/<\[([a-zA-Z0-9._-]+)\]>/g ) {
            push @calls, $1;
        }

        ##  runtime dispatch: $code{'module.name'} or $code{"module.name"}  ##
        ##  skip guarded optional calls : if (exists|defined) $code{'X'}    ##
        ##  [ soft dep — only present in specific zenki, not a hard edge ]  ##
        while ( $line =~ m/\$code\{['"]([a-zA-Z0-9._-]+)['"]\}/g ) {
            my $mod       = $1;
            my $lookahead = join '', @lines[ $i .. min( $i + 2, $end_idx ) ];
            my $guard_re
                = qr/if\s+(?:exists|defined)\s+\$code\{['"]\Q$mod\E['"]\}/;
            next if $lookahead =~ $guard_re;
            push @calls, $mod;
        }

       #  event callback / handler string refs [ registered, called later ]  #
       #  key forms : handler  'handler'  qw| handler |                      #
       #  val forms : => qw| name |  => 'name'  => "name"                    #
        my $cb_re  = qr/(?:qw\|\s*)?['"]?(?:handler|callback)/;
        my $val_re = qr/(?:qw\|\s*|['"])([a-zA-Z0-9._-]+)/;
        while ( $line =~ m/$cb_re['"]?(?:\s*\|)?\s*=>\s*$val_re/g ) {
            push @calls, $1;
        }

        #  handler|callback key with value on next line [ multiline split ]  #
        if (    $i < $end_idx
            and $line =~ m/$cb_re['"]?(?:\s*\|)?\s*=>\s*$/ ) {
            my $next = $lines[ $i + 1 ] // '';
            if ( $next =~ m/^\s*(?:qw\|\s*|['"])([a-zA-Z0-9._-]+)/ ) {
                push @calls, $1;
            }
        }

        #  data-variable assigned sub name [ filter_hooks and similar ]      #
        #  pattern : <data.variable> = qw| sub.name |                        #
        #  pattern : 'key' => qw| sub.name |  [ filters hash entries ]       #
        if ( $line =~ m/=>?\s*qw\|\s*([a-zA-Z][\w.-]+)\s*\|/ ) {
            push @calls, $1;
        }
    }

    return @calls;
}

sub filter_graph {
    ##  limit graph to module and its dependencies up to depth  ##
    my ( $graph, $start_module, $depth ) = @ARG;

    my %filtered;
    my %visited;
    my @queue = ( [ $start_module, 0 ] );

    while (@queue) {
        my ( $module, $current_depth ) = @{ shift @queue };
        next if $visited{$module};
        $visited{$module} = 1;

        ##  copy edges for this module  ##
        if ( exists $graph->{$module} ) {
            $filtered{$module} = { %{ $graph->{$module} } };

            ##  queue dependencies if within depth  ##
            if ( $current_depth < $depth ) {
                for my $dep ( keys %{ $graph->{$module} } ) {
                    push @queue, [ $dep, $current_depth + 1 ]
                        if !$visited{$dep};
                }
            }
        }

        ##  also find reverse edges [modules that call this one]  ##
        if ( $current_depth < $depth ) {
            for my $caller ( keys %{$graph} ) {
                next if $visited{$caller};
                if ( exists $graph->{$caller}{$module} ) {
                    $filtered{$caller}{$module} = $graph->{$caller}{$module};
                    push @queue, [ $caller, $current_depth + 1 ];
                }
            }
        }
    }

    return \%filtered;
}

sub reverse_graph {
    ##  reverse dependency direction [who calls module X]  ##
    my $graph = shift;

    my %reversed;
    for my $caller ( keys %{$graph} ) {
        for my $callee ( keys %{ $graph->{$caller} } ) {
            my $weight = $graph->{$caller}{$callee};
            $reversed{$callee}{$caller} = $weight;
        }
    }

    return \%reversed;
}

sub sort_by_length {

    #  sort by length ascending, ties broken by reverse-alpha [ base.sort ] #
    return sort { length $a <=> length $b } reverse sort grep {defined} @ARG;
}

sub get_zenka_namespaces {
    ##  scan configuration/zenki/ to find zenka-owned namespaces          ##
    ##  returns hash of namespace names that correspond to zenki configs   ##
    ##  these namespaces should only appear in whitelists when loaded      ##
    state %zenka_ns;
    return %zenka_ns if %zenka_ns;

    my $zenki_dir = c_dir( $root_path, qw| configuration zenki | );
    return () unless -d $zenki_dir;

    opendir my $dh, $zenki_dir or return ();
    my @entries = readdir $dh;
    closedir $dh;

    for my $entry (@entries) {
        next if $entry eq qw| . | || $entry eq qw| .. |;
        my $path = c_dir( $zenki_dir, $entry );
        next unless -d $path;
        $zenka_ns{$entry} = 1;
    }

    return %zenka_ns;
}

sub generate_tree_output {
    ##  generate indented subroutine tree from a root module  ##
    my ( $graph, $root ) = @ARG;

    my @lines;
    my %visited = ( $root => 1 );

    push @lines, sprintf ':%03d: %s', 1, $root;
    _append_tree_deps( $graph, $root, 1, \%visited, \@lines );

    return join( "\n", @lines ) . "\n";
}

sub _append_tree_deps {
    ##  recursively append dependency lines with increasing indentation  ##
    my ( $graph, $module, $depth, $visited, $lines ) = @ARG;

    return unless exists $graph->{$module};

    my $indent = '  ' x $depth;
    for my $dep ( sort_by_length( keys %{ $graph->{$module} } ) ) {
        my $weight = $graph->{$module}{$dep};
        push @{$lines}, sprintf '%s--> :%03d: %s', $indent, $weight, $dep;
        unless ( $visited->{$dep} ) {
            $visited->{$dep} = 1;
            _append_tree_deps( $graph, $dep, $depth + 1, $visited, $lines );
        }
    }
}

sub ns_colors {
    ##  return [ fill, font ] for a module name by namespace  ##
    state %colors = (
        'base'       => [ '#0d2137', '#4a9eff' ],
        'file'       => [ '#0d1a1f', '#4aeebb' ],
        'coding'     => [ '#0d1f10', '#4aee7a' ],
        'httpd'      => [ '#1f100d', '#ee7a4a' ],
        'cube'       => [ '#180d1f', '#b44aee' ],
        'v7'         => [ '#1f1a0d', '#eebb4a' ],
        'p7'         => [ '#1a1f0d', '#aadd44' ],
        'source'     => [ '#1f0d18', '#ee4ab4' ],
        'sourcecode' => [ '#1f0d18', '#ee4ab4' ],
        'log'        => [ '#1a0d0d', '#dd6644' ],
        'crypt'      => [ '#0d1a0d', '#44ee88' ],
        'work'       => [ '#1a180d', '#ddcc44' ],
        'weather'    => [ '#0d1818', '#44ddcc' ],
        'data'       => [ '#0d0d1f', '#6688ee' ],
        'system'     => [ '#1a0d1a', '#cc44cc' ],
        'devmod'     => [ '#141414', '#888888' ],
    );
    my ($ns) = shift =~ m|^([^.]+)|;
    return $colors{$ns} // [ '#111122', '#7788aa' ];
}

sub generate_dot_output {
    ##  generate graphviz digraph format  ##
    my $graph = shift;

    my @lines = (
        'digraph protocol7_modules {',
        '    bgcolor="#080810";',
        '    rankdir=LR;',
        '    node [shape=box, style=filled, fontname="monospace"];',
        '    edge [fontcolor="#556677", fontsize=9];',
        '',
    );

    ##  collect unique nodes  ##
    my %nodes;
    for my $caller ( keys %{$graph} ) {
        $nodes{$caller} = 1;
        for my $callee ( keys %{ $graph->{$caller} } ) {
            $nodes{$callee} = 1;
        }
    }

    ##  declare nodes with namespace-based colors  ##
    for my $node ( sort keys %nodes ) {
        my $escaped = escape_dot_id($node);
        my ( $fill, $font ) = @{ ns_colors($node) };
        push @lines,
            qq|    "$escaped" | . qq|[fillcolor="$fill", fontcolor="$font"];|;
    }

    push @lines, '';

    ##  declare edges — weight drives penwidth; cross-ns edges brighter  ##
    for my $caller ( sort keys %{$graph} ) {
        my $caller_escaped = escape_dot_id($caller);
        my ($caller_ns) = $caller =~ m|^([^.]+)|;
        for my $callee ( sort keys %{ $graph->{$caller} } ) {
            my $callee_escaped = escape_dot_id($callee);
            my ($callee_ns)    = $callee =~ m|^([^.]+)|;
            my $weight         = $graph->{$caller}{$callee};
            my $penwidth
                = $weight > 4 ? 2.5
                : $weight > 1 ? 1.5
                :               1.0;
            my $color = $caller_ns ne $callee_ns ? '#7766aa' : '#2a3a55';
            push @lines,
                  qq|    "$caller_escaped" -> "$callee_escaped"|
                . qq| [label="$weight",|
                . qq| color="$color", penwidth=$penwidth];|;
        }
    }

    push @lines, '}';

    return join( "\n", @lines ) . "\n";
}

sub escape_dot_id {
    ##  escape special characters for graphviz node ids  ##
    my $id = shift;
    $id =~ s|"|\\"|g;
    return $id;
}

sub write_file {
    ##  write content to file  ##
    my ( $path, $content ) = @ARG;

    open my $fh, qw| > |, $path
        or die ":: cannot write to $path: $OS_ERROR\n";
    print $fh $content;
    close $fh;
}

##::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..::..
##[ ZENKA REACHABILITY ANALYSIS ]#############################################

sub analyze_zenka_reachability {
    ##  analyze which modules are reachable from a zenka's entry points  ##
    my ( $graph, $zenka_name, $lines_ref ) = @ARG;

    my ( $loaded_set, $entry_commands, $whitelist_register );
    if ( defined $lines_ref ) {
        ##  stdin mode: parse lines directly  ##
        ( $loaded_set, $entry_commands, undef, undef, $whitelist_register )
            = parse_start_lines($lines_ref);
    } else {
        ##  file mode: locate and parse start file  ##
        my $start_file = c_dir( $root_path, qw| configuration zenki |,
            $zenka_name, qw| start | );
        die ":: zenka start file not found: $start_file\n" if !-f $start_file;
        ( $loaded_set, $entry_commands, undef, undef, $whitelist_register )
            = parse_zenka_start_file($start_file)
            ;    ##  config_files unused here  ##
    }

    say ":: zenka : $zenka_name";
    say ":: loaded   : " . scalar( keys %{$loaded_set} ) . " modules";
    say ":: whitelist : "
        . scalar( @{$whitelist_register} )
        . " eager-load namespaces"
        if @{$whitelist_register};

    ##  parse access.cmd.* configuration for command filtering  ##
    my $access_config = {};
    if ( defined $zenka_name && $zenka_name ne 'stdin' ) {
        $access_config = parse_access_cmd_config($zenka_name);
        my $total_targets = scalar keys %{$access_config};
        say ":: access   : $total_targets cmd targets"
            if $total_targets > 0;
    }

    ##  resolve entry commands to module names  ##
    my @entry_modules;
    for my $cmd ( @{$entry_commands} ) {
        my $module = resolve_command_to_module( $graph, $cmd );
        push @entry_modules, $module if defined $module;
    }

    #  seed bootstrap modules [ always loaded by bin/Protocol-7 regardless  #
    #  of whitelist ] so their dependencies are included in the reachable   #
    #  set                                                                  #
    for my $bootstrap (qw| base.init base.sig_int base.init_code |) {
        push @entry_modules, $bootstrap if exists $graph->{$bootstrap};
    }

    #  all base.sig_* handlers are registered dynamically via sprintf in     #
    #  base.init_zenka.install_signal_handlers — dep-graph cannot trace them #
    push @entry_modules, grep { exists $graph->{$ARG} }
        grep {m|^base\.sig_|} keys %{$graph};

    #  deferred compile handler installed as stub by bin/Protocol-7 loader  #
    #  for non-whitelisted modules — not traceable by dep-graph             #
    push @entry_modules, 'base.handler.deferred_compile'
        if exists $graph->{'base.handler.deferred_compile'};

    #  base.locales lifecycle hooks — called implicitly by base.init_modules  #
    #  and not traceable via static edges; seed when zenka has locale data    #
    if ( defined $zenka_name and $zenka_name ne 'stdin' ) {
        my $locales_dir = c_dir( $root_path, qw| data locales |, $zenka_name );
        if ( -d $locales_dir ) {
            for my $locale_sub (
                qw| base.locales.pre_init base.locales.init_code
                    base.locales.load_file |
            ) {
                push @entry_modules, $locale_sub
                    if exists $graph->{$locale_sub};
            }
        }
    }

    #  include subroutines called from zenka-startup.v7 zenka-init section  #
    #  these lines are injected over stdin by v7 at startup and eval'd      #
    if ( defined $zenka_name and $zenka_name ne 'stdin' ) {
        my $startup_file = c_dir(
            $root_path,  qw| configuration zenki |,
            $zenka_name, qw| zenka-startup.v7 |
        );
        if ( -f $startup_file ) {
            my $in_zenka_init = 0;
            open my $sfh, '<', $startup_file
                or warn ":: cannot read $startup_file: $!\n";
            while ( defined $sfh and my $line = <$sfh> ) {
                chomp $line;
                if ( $line =~ m|^\s*:\s*zenka-init\s*:| ) {
                    $in_zenka_init = 1;
                } elsif ( $line =~ m|^\s*:\s*\S+\s*:| ) {
                    $in_zenka_init = 0;
                } elsif ($in_zenka_init) {
                    ##  extract [ sub.name ] and [ sub.name : args ] calls  ##
                    while ( $line =~ m|\[([a-zA-Z][\w.-]+)(?::[^\]]+)?\]|g ) {
                        my $sub = $1;
                        push @entry_modules, $sub
                            if exists $graph->{$sub};
                    }
                }
            }
            close $sfh if defined $sfh;
        }
    }

    ##  find all modules reachable from entry points  ##
    my %reachable = walk_reachable( $graph, \@entry_modules );

    say ":: reachable: " . scalar( keys %reachable ) . " modules";

    ##  find unreachable loaded modules  ##
    my @unreachable;
    for my $loaded ( keys %{$loaded_set} ) {
        ##  check if loaded module or any of its expansions are reachable  ##
        my $found = 0;
        for my $reachable_module ( keys %reachable ) {
            if ( $reachable_module =~ m/^\Q$loaded\E/ ) {
                $found = 1;
                last;
            }
        }
        push @unreachable, $loaded if !$found;
    }

    ##  phase 3: load rules and find/resolve variable dispatch  ##
    my $rules = load_rules();
    my ( $ambiguous_ref, $resolved_ref )
        = find_variable_dispatch( $graph, $loaded_set, $rules );
    my @ambiguous = @{$ambiguous_ref};
    my @resolved  = @{$resolved_ref};

    ##  extend reachable set with rule-resolved targets  ##
    for my $res (@resolved) {
        for my $target ( @{ $res->{targets} } ) {
            next if $reachable{$target};
            if ( $target =~ s/\.\*$// ) {
                ##  prefix wildcard — add all matching graph nodes  ##
                for my $node ( grep {m/^\Q$target\E/} keys %{$graph} ) {
                    my %new = walk_reachable( $graph, [$node] );
                    %reachable = ( %reachable, %new );
                }
            } elsif ( exists $graph->{$target} ) {
                my %new = walk_reachable( $graph, [$target] );
                %reachable = ( %reachable, %new );
            }
        }
    }

    ##  flat subroutine list mode : output and exit  ##
    if ( $opt{'list-subs'} ) {
        ##  include all subs from runtime-loaded modules  ##
        ##  base.load_modules loads the full namespace at runtime  ##
        for my $loaded ( keys %{$loaded_set} ) {
            for my $node ( grep {m/^\Q$loaded\E(?:\.|$)/} keys %{$graph} ) {
                my %new = walk_reachable( $graph, [$node] );
                %reachable = ( %reachable, %new );
            }
        }

        ##  include eager-load namespaces from white-list.register  ##
        for my $ns ( @{$whitelist_register} ) {
            for my $node ( grep {m/^\Q$ns\E(?:\.|$)/} keys %{$graph} ) {
                next if $reachable{$node};
                my %new = walk_reachable( $graph, [$node] );
                %reachable = ( %reachable, %new );
            }
        }

       #  detect runtime namespace loads from reachable module source files  #
       #  pattern : <[base.load_runtime_modules]>->('prefix')                #
       #  pattern : <[base.init_modules]>->('prefix')                        #
       #  these fork-child patterns load sub-namespaces that static          #
       #  call analysis cannot reach [ letsencr.child, letsencr.parent ...]  #
        {
            my %runtime_ns_seen;
            my @to_scan = keys %reachable;
            while (@to_scan) {
                my $mod  = shift @to_scan;
                my $file = c_dir( $root_path, qw| modules |, $mod );
                next unless -f $file;
                open my $fh, '<', $file or next;
                while ( my $line = <$fh> ) {
                    while (
                        $line =~ m{<\[base\.(?:load_runtime_modules
                                              |init_modules)\]>
                                   \s*->\s*\(\s*['"]([a-zA-Z0-9._-]+)['"]}xg
                    ) {
                        my $ns = $1;
                        next if $runtime_ns_seen{$ns}++;
                        $loaded_set->{$ns} = 1;
                        for my $node (
                            grep {m/^\Q$ns\E(?:\.|$)/}
                            keys %{$graph}
                        ) {
                            next if $reachable{$node};
                            my %new = walk_reachable( $graph, [$node] );
                            %reachable = ( %reachable, %new );
                            push @to_scan, keys %new;
                        }
                    }
                }
                close $fh;
            }
        }

        #  include all cmd and console subs — only when net is loaded        #
        #  without net, zenka cannot accept connections or dispatch commands #
        if ( exists $loaded_set->{'net'} ) {
            for my $ns ( qw| base |, keys %{$loaded_set} ) {
                for my $node (
                    grep {m/^\Q$ns\E\.(?:.*\.)?(?:cmd|console)\./}
                    keys %{$graph}
                ) {
                    next if $reachable{$node};
                    my %new = walk_reachable( $graph, [$node] );
                    %reachable = ( %reachable, %new );
                }
            }
        }

        #  include all console subs when base.call.console_command reachable #
        #  applies to standalone zenki using console dispatch without net    #
        #  cmd subs not included — those require network dispatch via net    #
        if ( not exists $loaded_set->{'net'}
            and exists $reachable{'base.call.console_command'} ) {
            for my $ns ( qw| base |, keys %{$loaded_set} ) {
                for my $node (
                    grep {m/^\Q$ns\E\.(?:.*\.)?console\./}
                    keys %{$graph}
                ) {
                    next if $reachable{$node};
                    my %new = walk_reachable( $graph, [$node] );
                    %reachable = ( %reachable, %new );
                }
            }
        }

       #  include plugin.* modules scoped to loaded namespaces only          #
       #  plugin.auth.* only when auth loaded, plugin.web.* when web loaded  #
       #  also match plugin.X.* when plugin.X is explicitly in modules.load  #
        if ( exists $loaded_set->{'net'} ) {
            my %loaded_ns
                = map { ( split m|\.| )[0] => 1 } keys %{$loaded_set};
            ## also index plugin sub-namespaces from loaded set ##
            ## plugin.storage.inference → loaded_ns{storage} = 1 ##
            for my $loaded_key ( keys %{$loaded_set} ) {
                if ( $loaded_key =~ m|^plugin\.([^.]+)| ) {
                    $loaded_ns{$1} = 1;
                }
            }
            for my $node ( grep {m/^plugin\./} keys %{$graph} ) {
                next if $reachable{$node};
                my ($plugin_ns) = $node =~ m|^plugin\.([^.]+)|;
                next if defined $plugin_ns and not $loaded_ns{$plugin_ns};
                my %new = walk_reachable( $graph, [$node] );
                %reachable = ( %reachable, %new );
            }
        }

        #  include lifecycle subs [ pre_init init_code post_init ] for     #
        #  explicitly loaded namespaces only — not for the full reachable  #
        #  set, which may contain false-positive modules from other zenki  #
        #  catches base.file.pre_init [ swap_subs ] and base.init_code     #
        #  [ compile-time Const::Fast ] which are never called by name     #
        #  seed 'base' explicitly since it is always loaded by bin/P7      #
        #  repeat until no new additions [ new subs may introduce new      #
        #  namespaces that need lifecycle subs — frozen for-list misses ]  #
        ##  top-level namespace set: base always included,                 #
        ##                             plus loaded modules                ##
        my %loaded_ns
            = map { ( split m|\.| )[0] => 1 } keys %{$loaded_set};
        $loaded_ns{'base'} = 1;

        my %ns_seen;
        my $prev_count = 0;
        while ( scalar( keys %reachable ) != $prev_count ) {
            $prev_count = scalar keys %reachable;
            for my $mod (
                grep { my ($ns) = m|^([^.]+)|; $loaded_ns{$ns} }
                keys %reachable
            ) {
                my @parts = split m|\.|, $mod;
                for my $len ( 1 .. scalar @parts ) {
                    my $ns = join '.', @parts[ 0 .. $len - 1 ];
                    next if $ns_seen{$ns}++;
                    for my $lifecycle (qw| pre_init init_code post_init |) {
                        my $sub = "$ns.$lifecycle";
                        next if $reachable{$sub};
                        if ( exists $graph->{$sub} ) {
                            my %new = walk_reachable( $graph, [$sub] );
                            %reachable = ( %reachable, %new );
                        }
                    }
                }
            }
        }

        ##  filter reachable subs from zenka-owned namespaces not in loaded set  ##
        ##  this prevents namespace leaks where walk_reachable follows static  ##
        ##  call edges into modules from unrelated zenki [e.g., channels.*,    ##
        ##  httpd.*, v7.* subs appearing in X-11 whitelist ]                  ##
        my %zenka_ns = get_zenka_namespaces();
        my @filtered_ns;
        for my $sub ( keys %reachable ) {
            my ($ns) = $sub =~ m|^([^.]+)|;

            ##  shared namespaces are always valid [ base, io, net, etc. ]  ##
            if ( not exists $zenka_ns{$ns} ) {
                push @filtered_ns, $sub;
                next;
            }

            ##  zenka-owned namespace: keep only if in loaded set  ##
            if ( exists $loaded_ns{$ns} ) {
                push @filtered_ns, $sub;
            }
        }
        %reachable = map { $_ => 1 } @filtered_ns;

        ##  filter reachable subs based on access.cmd.* configuration  ##
        ##  this implements Phase A (cmd access filtering) and         ##
        ##  Phase B option c (access-config-gated devmod filtering)    ##
        if ( defined $zenka_name && $zenka_name ne 'stdin' ) {
            ##  $access_config already parsed above, use it  ##
            ##  only filter when the zenka has access.cmd.* entries  ##
            if ( keys %{$access_config} ) {
                my @filtered;
                for my $sub ( keys %reachable ) {

                    ##  non-cmd / non-devmod subs are never filtered  ##
                    if (   $sub !~ m/\.(?:cmd|console)\./
                        && $sub !~ m/^devmod\./ ) {
                        push @filtered, $sub;
                        next;
                    }

                    ##  cmd and devmod subs : keep if command name matches  ##
                    ##  mirrors base.has_access regex check at runtime       ##
                    if ( $sub =~ m/\.(?:cmd|console)\.(.+)$|^devmod\.(.+)$/ )
                    {
                        my $cmd_name = $1 // $2;
                        push @filtered, $sub
                            if command_allowed( $cmd_name, $access_config );
                        next;
                    }

                    ##  default: keep  ##
                    push @filtered, $sub;
                }
                %reachable = map { $_ => 1 } @filtered;
            }
        }

        say $ARG for sort_by_length( keys %reachable );
        return;
    }

    ##  output unreachable list  ##
    if (@unreachable) {
        say ":: unreachable [never called]:";
        for my $mod ( sort_by_length(@unreachable) ) {
            say "   $mod";
        }
    } else {
        say ":: unreachable: none";
    }

    ##  output ambiguous dispatch warnings  ##
    if (@ambiguous) {
        say ":: ambiguous dispatch [ runtime-resolved,"
            . " may call any loaded module ] :.";
        for my $entry (@ambiguous) {
            my $range
                = $entry->{start_line} eq '?'            ? "?-$entry->{line}"
                : $entry->{start_line} == $entry->{line} ? $entry->{line}
                :   "$entry->{start_line}-$entry->{line}";
            my $origin_tag
                = $entry->{origin} eq 'parameter' ? ' [param]' : '';

            ##  phase 2: add via chain if variable was handed over  ##
            my $via_str = '';
            if ( @{ $entry->{via} // [] } ) {
                $via_str = ' via ' . join( '->', @{ $entry->{via} } );
            }

            ##  phase 2.5: add confidence annotation  ##
            my $conf_tag = " [$entry->{confidence}]";

            say "   $entry->{module} [ $range :"
                . " code{ \$$entry->{var} }$origin_tag$via_str$conf_tag ]";
        }
    }

    ##  phase 3: output rule-resolved dispatch  ##
    if (@resolved) {
        say ":: rule-resolved dispatch [ static after rule application ] :.";
        for my $res (@resolved) {
            my $targets = join( ', ', @{ $res->{targets} } );
            say "   $res->{module} [ $res->{line} :"
                . " code{ \$$res->{var} } -> $targets ]"
                . " [rule-resolved] [ $res->{rule} ]";
        }
    }

    ##  generate tree output if -text specified  ##
    if ( $opt{text} ) {
        say "";
        ##  create filtered graph with only reachable modules  ##
        my %reachable_graph;
        for my $module ( keys %reachable ) {
            next unless exists $graph->{$module};
            ##  only include edges to other reachable modules  ##
            for my $dep ( keys %{ $graph->{$module} } ) {
                $reachable_graph{$module}{$dep} = $graph->{$module}{$dep}
                    if exists $reachable{$dep};
            }
        }

        ##  generate a tree for each entry point  ##
        for my $entry_module ( sort_by_length(@entry_modules) ) {
            say generate_tree_output( \%reachable_graph, $entry_module );
        }
    }
}

sub parse_zenka_start_file {
    ##  read a start file from disk and delegate to parse_start_lines  ##
    my $start_file = shift;

    open my $fh, qw| < |, $start_file
        or die ":: cannot read $start_file: $OS_ERROR\n";
    my @lines = <$fh>;
    close $fh;

    return parse_start_lines( \@lines );
}

sub parse_start_lines {

    # parse start file lines to extract loaded modules and entry commands #
    my $lines_ref = shift;

    ##  join continuation lines [ending with \]  ##
    my @joined_lines;
    my $current = '';
    for my $line ( @{$lines_ref} ) {
        chomp $line;
        if ( $line =~ m/\\\s*$/ ) {
            ##  line continues - strip \ and append  ##
            $line =~ s/\\\s*$//;
            $current .= $line . ' ';
        } else {
            $current .= $line;
            push @joined_lines, $current if $current =~ m/\S/;
            $current = '';
        }
    }
    push @joined_lines, $current if $current =~ m/\S/;

    ##  extract modules.load value  ##
    my %loaded_set;
    for my $line (@joined_lines) {
        if ( $line =~ m/^\s*modules\.load\s*=\s*(.+)/ ) {
            my $value = $1;
            ##  strip comments  ##
            $value =~ s/\s*##.*$//;
            ##  split on whitespace  ##
            for my $mod ( split /\s+/, $value ) {
                $loaded_set{$mod} = 1 if $mod =~ m/\S/;
            }
        }
    }

    ##  extract load_config_file includes [ [load_config_file:'name'] ]  ##
    my @config_files;
    my @config_ambiguous;    ##  variable-ref cases [ runtime-resolved ]  ##
    for my $line (@joined_lines) {
        if ( $line =~ m/^\s*\[(?:base\.)?load_config_file\s*:\s*([^\]]+)\]/ )
        {
            my $arg = $1;
            $arg =~ s/^\s+|\s+$//g;
            if ( $arg =~ m/^['"](.+)['"]$/ ) {
                ##  literal string — extractable  ##
                push @config_files, $1;
            } elsif ( $arg =~ m/^<([^>]+)>$/ ) {
                ##  variable reference — runtime-resolved  ##
                push @config_ambiguous, $arg;
            } else {
                push @config_files, $arg;
            }
        }
    }

    ##  extract entry-point commands from [cmd:param] lines  ##
    my @entry_commands;
    for my $line (@joined_lines) {
        if ( $line =~ m/^\s*\[([^\]:]+)/ ) {
            my $cmd = $1;
            ##  strip params after : if present  ##
            $cmd =~ s/:.*$//;
            push @entry_commands, $cmd if $cmd =~ m/\S/;
        }
    }

    ##  extract white-list.register namespace registrations  ##
    my @whitelist_register;
    for my $line (@joined_lines) {
        if ( $line
            =~ m/^\s*\[(?:base\.)?white-list\.register\s*:\s*([^\]]+)\]/ )
        {
            my $arg = $1;
            $arg =~ s/^\s+|\s+$//g;
            if ( $arg =~ m/^['"](.+)['"]$/ ) {
                push @whitelist_register, $1;
            } else {
                push @whitelist_register, $arg;
            }
        }
    }

    return (
        \%loaded_set,   \@entry_commands,
        \@config_files, \@config_ambiguous,
        \@whitelist_register
    );
}

sub parse_access_cmd_config {
    ##  parse access.cmd.* entries from a zenka's start file and includes  ##
    ##  compiles patterns to regexes — mirrors base.parser.access_conf     ##
    ##  returns hashref: { target => qr/compiled_regex/ }                  ##
    my $zenka_name = shift;

    my $start_file = c_dir( $root_path, qw| configuration zenki |,
        $zenka_name, qw| start | );
    return {} if !-f $start_file;

    my %raw_patterns;    ##  { target => [ raw pattern strings ] }  ##
    my @config_stack = ($start_file);
    my %seen_files;

    while (@config_stack) {
        my $file = pop @config_stack;
        next if $seen_files{$file}++;
        next if !-f $file;

        open my $fh, qw| < |, $file or next;
        my @lines = <$fh>;
        close $fh;

        ##  join continuation lines [ ending with \ ]  ##
        my @joined_lines;
        my $current = '';
        for my $line (@lines) {
            chomp $line;
            if ( $line =~ m/\\\s*$/ ) {
                $line =~ s/\\\s*$//;
                $current .= $line . ' ';
            } else {
                $current .= $line;
                push @joined_lines, $current if $current =~ m/\S/;
                $current = '';
            }
        }
        push @joined_lines, $current if $current =~ m/\S/;

        ##  extract access.cmd.* entries  ##
        for my $line (@joined_lines) {
            if ( $line =~ m/^\s*access\.cmd\.\S+\.([^\s=]+)\s*=\s*(.+)/ ) {
                my ( $target, $value ) = ( $1, $2 );
                $value =~ s/\s*##.*$//;     ##  strip ## comments  ##
                $value =~ s/\s+#\s.*$//;    ##  strip #  comments  ##
                for my $pat ( split /\s+/, $value ) {
                    push @{ $raw_patterns{$target} }, $pat if $pat =~ m/\S/;
                }
            }
        }

        ##  follow load_config_file includes  ##
        for my $line (@joined_lines) {
            if ( $line
                =~ m/^\s*\[(?:base\.)?load_config_file\s*:\s*['"]?([^\]'"]+)['"]?\]/
            ) {
                my $arg = $1;
                $arg =~ s/^\s+|\s+$//g;
                my $cfg
                    = $arg =~ m|^/|
                    ? $arg
                    : c_dir( $root_path, qw| configuration |, $arg );
                push @config_stack, $cfg if -f $cfg;
            }
        }
    }

    ##  compile raw patterns to regexes — exact base.parser.access_conf logic  ##
    my %access_regex;
    for my $target ( keys %raw_patterns ) {
        my @parts;
        for my $pat ( @{ $raw_patterns{$target} } ) {
            my $re = $pat;
            $re =~ s|[\[\]]|\\$&|g;    ##  escape brackets  ##
            $re =~ s|\.|\\\.|g;        ##  escape dots       ##
            $re =~ s|\^|\\^|g;         ##  escape caret      ##
            $re =~ s|\*\*|.+|g;        ##  ** → any chars    ##
            $re =~ s|\*|[^\\.]+|g;     ##  * → no-dot chars  ##
            push @parts, sprintf '^%s$', $re;
        }
        my $joined = join '|', @parts;
        $access_regex{$target} = qr/$joined/ if length $joined;
    }

    return \%access_regex;
}

sub command_allowed {
    ##  mirrors base.has_access : match cmd against compiled access regexes  ##
    my ( $cmd, $regex_per_target ) = @ARG;

    return 0 if !defined $regex_per_target || !keys %{$regex_per_target};

    for my $target ( keys %{$regex_per_target} ) {
        my $re = $regex_per_target->{$target};
        return 1 if defined $re and $cmd =~ $re;
    }
    return 0;
}

sub resolve_command_to_module {
    ##  resolve command name to module name using loader prefix logic  ##
    my ( $graph, $cmd ) = @ARG;

    ##  try prefix variations in order: base.cmd.NAME, base.NAME, NAME  ##
    my @candidates = ( "base.cmd.$cmd", "base.$cmd", $cmd );

    for my $candidate (@candidates) {
        return $candidate if exists $graph->{$candidate};
    }

    ##  silently skip if not found [infrastructure calls like root.*]  ##
    return undef;
}

sub walk_reachable {

    #  transitively walk dep-graph from entry points to find all reachable  #
    #  modules                                                              #
    my ( $graph, $entry_modules ) = @ARG;

    my %reachable;
    my @queue = @{$entry_modules};

    while (@queue) {
        my $module = shift @queue;
        next if $reachable{$module};
        $reachable{$module} = 1;

        ##  queue all dependencies  ##
        if ( exists $graph->{$module} ) {
            for my $dep ( keys %{ $graph->{$module} } ) {
                push @queue, $dep if !$reachable{$dep};
            }
        }
    }

    return %reachable;
}

sub find_variable_dispatch {
    ##  find modules that use variable-keyed dispatch [\$code{\$var}]  ##
    my ( $graph, $loaded_set, $rules ) = @ARG;
    $rules //= [];

    my @ambiguous;
    my @resolved;
    my $modules_dir = c_dir( $root_path, qw| modules | );
    my @files       = get_module_files($modules_dir);

    ##  build reverse lookup: module name -> file path  ##
    my %module_to_file;
    for my $file (@files) {
        my $name = extract_module_name($file);
        $module_to_file{$name} = $file if defined $name;
    }

    ##  check each loaded module's source for variable dispatch  ##
    for my $loaded ( keys %{$loaded_set} ) {
        ##  find all modules matching this loaded prefix  ##
        for my $module ( keys %module_to_file ) {
            next unless $module =~ m/^\Q$loaded\E/;
            next unless exists $graph->{$module};

            my $file = $module_to_file{$module};
            open my $fh, qw| < |, $file or next;
            my @lines = <$fh>;
            close $fh;

            ##  exclude AMOS7 footer  ##
            my $end_idx = scalar(@lines) - 6;
            $end_idx = 0 if $end_idx < 0;

            for my $i ( 0 .. $end_idx ) {
                my $line = $lines[$i];
                ##  match variable dispatch: $code{$var} or $code{ $var }  ##
                while ( $line =~ m/\$code\{\s*\$(\w+)\s*\}/g ) {
                    my $var_name   = $1;
                    my $usage_line = $i + 1;

                    ##  backtrack to find variable origin  ##
                    my $origin
                        = backtrack_variable_origin( \@lines, $i, $var_name );

                    ##  phase 2.5: classify confidence based on context  ##
                    my $confidence
                        = classify_dispatch_confidence( \@lines, $i,
                        $var_name );

                   #  phase 3: try rule resolution before marking ambiguous  #
                    my $start_scan = $i - 15;
                    $start_scan = 0 if $start_scan < 0;
                    my $end_scan = $i + 5;
                    $end_scan = $#lines if $end_scan > $#lines;
                    my $context_str
                        = join( "\n", @lines[ $start_scan .. $end_scan ] );

                    my ( $rule_targets_ref, $rule_name )
                        = apply_rules( $rules, $module, $var_name,
                        $context_str );

                    if ( defined $rule_targets_ref ) {
                        push @resolved,
                            {
                            module  => $module,
                            var     => $var_name,
                            line    => $usage_line,
                            targets => $rule_targets_ref,
                            rule    => $rule_name,
                            };
                    } else {
                        push @ambiguous,
                            {
                            module     => $module,
                            var        => $var_name,
                            line       => $usage_line,
                            start_line => $origin->{start_line},
                            origin     => $origin->{type},
                            context    => $origin->{context},
                            via        => $origin->{via} // [],
                            confidence => $confidence
                            };
                    }
                }
            }
        }
    }

    return ( \@ambiguous, \@resolved );
}

##[ PHASE 3: RULE PLUGIN INTERFACE ]##########################################

sub load_rules {
    ##  load dispatch resolution rules from configuration/dep-graph/rules/  ##
    my $rules_dir = c_dir( $root_path, qw| configuration dep-graph rules | );
    my @rules;
    return \@rules unless -d $rules_dir;

    opendir my $dh, $rules_dir or return \@rules;
    my @rule_files = sort grep {m/\.rules$/} readdir $dh;
    closedir $dh;

    for my $filename (@rule_files) {
        my $path = c_dir( $rules_dir, $filename );
        open my $fh, qw| < |, $path or next;
        while ( my $line = <$fh> ) {
            chomp $line;
            next if $line =~ m/^\s*(?:#.*)?$/;   ##  skip blank / comments  ##

            ##  parse: module_glob : var ~ /pattern/ -> template  ##
            ##     or: var ~ /pattern/ -> template                 ##
            my ( $module_glob, $var_name, $pattern, $template );
            if ( $line =~ m{^(\S+)\s*:\s*(\w+)\s*~\s*/(.+)/\s*->\s*(.+)$} ) {
                ( $module_glob, $var_name, $pattern, $template )
                    = ( $1, $2, $3, $4 );
            } elsif ( $line =~ m{^(\w+)\s*~\s*/(.+)/\s*->\s*(.+)$} ) {
                ( $module_glob, $var_name, $pattern, $template )
                    = ( '*', $1, $2, $3 );
            } else {
                next;
            }
            $template =~ s/\s+$//;

            push @rules,
                {
                module_glob => $module_glob,
                var_name    => $var_name,
                pattern     => $pattern,
                template    => $template,
                source      => $filename,
                };
        }
        close $fh;
    }

    return \@rules;
}

sub module_matches_glob {
    ##  check if module name matches a glob pattern  ##
    ##  supports: '*' (any), 'foo.bar.*' (prefix), 'foo.bar' (exact)  ##
    my ( $glob, $module ) = @ARG;
    return 1 if $glob eq '*';
    if ( $glob =~ s/\.\*$// ) {
        return $module =~ m/^\Q$glob\E/;
    }
    return $module eq $glob;
}

sub apply_rules {
    ##  try each rule against a dispatch site  ##
    ##  returns ( \@targets, $rule_source ) on match, or ( undef, undef )  ##
    my ( $rules, $module, $var_name, $context_str ) = @ARG;

    for my $rule ( @{$rules} ) {
        next unless module_matches_glob( $rule->{module_glob}, $module );
        next
            if $rule->{var_name} ne '*'
            && $rule->{var_name} ne $var_name;

        my $pattern = $rule->{pattern};
        if ( $context_str =~ m/$pattern/m ) {
            ##  build resolution from template substituting captures  ##
            my @cap    = map { $_ // '' } ( $1, $2, $3, $4, $5 );
            my $target = $rule->{template};
            $target =~ s/\$(\d)/$cap[$1-1]/g;
            $target =~ s/\$\{?var\}?/$var_name/g;
            $target =~ s/\s+$//;
            return ( [$target], $rule->{source} ) if $target =~ m/\S/;
        }
    }

    return ( undef, undef );
}

sub backtrack_variable_origin {
    ##  trace variable backwards to find where it was introduced  ##
    ##  phase 2: follows handovers through multiple variables  ##
    my ( $lines_ref, $usage_idx, $var_name, $visited_vars ) = @ARG;
    $visited_vars //= {};
    my @lines = @{$lines_ref};

    ##  prevent infinite recursion on circular references  ##
    return undef if $visited_vars->{$var_name};
    $visited_vars->{$var_name} = 1;

    my $result = {
        start_line  => $usage_idx + 1,    ##  default: usage line  ##
        type        => 'local',
        context     => '',
        via         => [],                ##  phase 2: handover chain  ##
        origin_line => undef    ##  phase 2: where ultimate source found  ##
    };

    ##  scan backward from usage to find variable introduction  ##
    for my $i ( reverse 0 .. $usage_idx ) {
        my $line     = $lines[$i];
        my $line_num = $i + 1;

        ##  phase 2: check for handover: $var = $other_var  ##
        #  captures: $var = $other; $var = $other->(); $var = $other->{key}  #
        if ( $line =~ m/^\s*\$\Q$var_name\E\s*=\s*\$(\w+)/ ) {
            my $source_var = $1;

            ##  recursively trace the source variable  ##
            my $source_result
                = backtrack_variable_origin( $lines_ref, $i, $source_var,
                $visited_vars );

            if ( defined $source_result ) {
                ##  merge source info with current result  ##
                $result->{start_line}  = $source_result->{start_line};
                $result->{origin_line} = $source_result->{origin_line}
                    // $line_num;
                $result->{type} = $source_result->{type};

                ##  build via chain: current var + any upstream vias  ##
                push @{ $result->{via} }, $var_name;
                push @{ $result->{via} }, @{ $source_result->{via} }
                    if @{ $source_result->{via} };

                return $result;
            }
        }

        ##  check for parameter assignment patterns  ##
        ##  my $var = shift; my $var = $ARG[0]; my ( $var ) = @ARG;  ##
        if (   $line =~ m/^\s*my\s*\(?\s*\$\Q$var_name\E\s*\)?\s*=\s*shift\b/
            || $line
            =~ m/^\s*my\s*\$\Q$var_name\E\s*=\s*\$ARG\s*\[\s*\d+\s*\]/
            || $line
            =~ m/^\s*my\s*\(?\s*[^)]*\$\Q$var_name\E[^)]*\)\s*=\s*\@ARG\b/ ) {
            $result->{start_line}  = $line_num;
            $result->{origin_line} = $line_num;
            $result->{type}        = 'parameter';
            $result->{context}     = "from \@ARG";
            return $result;
        }

        ##  check for my $var = ... assignment [local variable]  ##
        ##  handles both: my $var = ...  and  my $var\n    = ...  ##
        if ($line =~ m/^\s*my\s*\$\Q$var_name\E\s*=/
            || (   $line =~ m/^\s*my\s*\$\Q$var_name\E\s*$/
                && $i < $#lines
                && $lines[ $i + 1 ] =~ m/^\s*=/ )
        ) {
            $result->{start_line}  = $line_num;
            $result->{origin_line} = $line_num;
            $result->{type}        = 'local';
            $result->{context}     = 'my assignment';
            return $result;
        }

       #  check for list-context my declaration: my ( ..., $var, ... ) = ... #
       #  covers: my ( $a, $b ) = @$ref  and  ( my $var, ... ) = split ...   #
        if ( $line =~ m/my\s*\(?\s*[^)]*\$\Q$var_name\E[^)]*\)?\s*=/ ) {
            $result->{start_line}  = $line_num;
            $result->{origin_line} = $line_num;
            $result->{type}        = 'local';
            $result->{context}     = 'list assignment';
            return $result;
        }

        ##  check for foreach my $var  ##
        if ( $line =~ m/\bmy\s*\$\Q$var_name\E\s+\b/ ) {
            $result->{start_line}  = $line_num;
            $result->{origin_line} = $line_num;
            $result->{type}        = 'local';
            $result->{context}     = 'loop variable';
            return $result;
        }
    }

    ##  if we reach the top without finding origin, mark as external  ##
    $result->{type}        = 'external';
    $result->{context}     = 'external source';
    $result->{start_line}  = '?';
    $result->{origin_line} = '?';

    return $result;
}

sub classify_dispatch_confidence {
    ##  phase 2.5: analyze code context to classify dispatch confidence  ##
    ##  returns: 'probable' | 'constrained' | 'open'  ##
    my ( $lines_ref, $usage_idx, $var_name ) = @ARG;
    my @lines = @{$lines_ref};

    ##  scan surrounding context for constraining patterns  ##
    my $has_regex_check       = 0;
    my $has_literal_compare   = 0;
    my $has_conditional_guard = 0;
    my $has_hash_lookup       = 0;

    ##  scan backward and forward from usage for context  ##
    my $start_scan = $usage_idx - 15;    ##  15 lines before  ##
    $start_scan = 0 if $start_scan < 0;
    my $end_scan = $usage_idx + 5;       ##  5 lines after  ##
    $end_scan = $#lines if $end_scan > $#lines;

    for my $i ( $start_scan .. $end_scan ) {
        next if $i == $usage_idx;        ##  skip the dispatch line itself  ##
        my $line = $lines[$i];

        ##  check for regex validation: $var =~ /pattern/  ##
        if ( $line =~ m/\$\Q$var_name\E\s*=~\s*m?[^\w]/ ) {
            $has_regex_check       = 1;
            $has_conditional_guard = 1 if $i < $usage_idx;
        }

        ##  check for literal string comparison: $var eq 'literal'  ##
        if ( $line =~ m/\$\Q$var_name\E\s+(eq|ne)\s+['"]/ ) {
            $has_literal_compare   = 1;
            $has_conditional_guard = 1 if $i < $usage_idx;
        }

        ##  check for hash key existence: exists $handlers{$var}  ##
        if ( $line =~ m/exists\s+\$\w+\{\$\Q$var_name\E\}/ ) {
            $has_hash_lookup       = 1;
            $has_conditional_guard = 1 if $i < $usage_idx;
        }

        ##  check for conditional guarding the dispatch  ##
        ##  if ( $var =~ /.../ ) { ... $code{$var}->()   ##
        if ( $i < $usage_idx && $line =~ m/\b(if|unless|while)\s*\(/ ) {
            ##  check if condition involves our variable  ##
            my $cond_line = $line;
            ##  peek at next few lines for multi-line conditions  ##
            for my $j ( $i + 1 .. $i + 3 ) {
                last                     if $j >= $usage_idx;
                $cond_line .= $lines[$j] if $j <= $#lines;
            }
            if ( $cond_line =~ m/\$\Q$var_name\E/ ) {
                $has_conditional_guard = 1;
            }
        }
    }

    ##  classify based on findings  ##
    ##  probable: strong constraints (regex + conditional)  ##
    if ( $has_regex_check && $has_conditional_guard ) {
        return 'probable';
    }

    ##  probable: literal comparison with conditional  ##
    if ( $has_literal_compare && $has_conditional_guard ) {
        return 'probable';
    }

    ##  constrained: some validation but not definitive  ##
    if ( $has_hash_lookup || $has_regex_check || $has_literal_compare ) {
        return 'constrained';
    }

    ##  open: no usable constraints found  ##
    return 'open';
}

