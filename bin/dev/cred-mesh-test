#!/usr/bin/perl

# [ cred-mesh integration test harness ]

use v5.24;
use strict;
use warnings;
use English;

use Getopt::Long;
use File::Spec;
use Cwd qw| abs_path |;
use FindBin qw| $RealBin |;

# [ locate project root ]
my $ROOT = abs_path( File::Spec->catdir( $RealBin, File::Spec->updir,
    File::Spec->updir ) );
if ( not -d File::Spec->catdir( $ROOT, 'modules' ) ) {
    die "[ fatal ] cannot find protocol-7 root (got $ROOT)\n";
}

my $SCENARIOS_DIR = File::Spec->catdir( $RealBin, 'cred-mesh-test.d' );

# [ parse options ]
my ( $scenario_arg, $keep_running, $verbose, $no_cleanup, $help );
GetOptions(
    'scenario=i'   => \$scenario_arg,
    'keep-running' => \$keep_running,
    'verbose'      => \$verbose,
    'no-cleanup'   => \$no_cleanup,
    'help'         => \$help,
) or die "[ fatal ] option parse failed\n";

if ($help) {
    print <<"HELP";
usage: $0 [options]
  --scenario N   run only scenario N (1..5)
  --keep-running start services, seed, and stay alive
  --verbose      louder output
  --no-cleanup   keep temp fixture on failure
  --help         this text
HELP
    exit 0;
}

$ENV{'CREDMESH_TEST_VERBOSE'} = 1 if $verbose;

# [ check p7c ]
my $p7c = $ENV{'CREDMESH_TEST_P7C'} // 'p7c';
system( 'which', $p7c );
if ( $CHILD_ERROR != 0 ) {
    die "[ fatal ] '$p7c' not found in PATH\n";
}

# [ test connectivity to cube ]
my $heart = `$p7c cube.heart 2>&1`;
if ( $heart !~ m{beating}i ) {
    warn "[ warn ] no v7 cube responding on default socket\n";
}

# [ temp dir for echo logs and profiles ]
my $temp_dir = File::Spec->catfile( File::Spec->tmpdir,
    'credfab-test-' . time . '-' . $$ );
mkdir $temp_dir or die "[ fatal ] mkdir $temp_dir: $ERRNO\n";
$ENV{'CREDMESH_TEST_DIR'} = $temp_dir;

my $cleanup = sub {
    return if $no_cleanup;
    system( 'rm', '-rf', $temp_dir );
};

# [ ensure services are running ]
my $spawn = File::Spec->catfile( $SCENARIOS_DIR, 'helper-spawn-proxy.pl' );
my $spawn_exit = system($spawn);
if ( $spawn_exit != 0 ) {
    warn "[ fatal ] could not spawn proxy/services\n";
    $cleanup->();
    exit 1;
}

# [ seed registry ]
my $seed = File::Spec->catfile( $SCENARIOS_DIR, 'helper-seed-fabric.pl' );
my $seed_exit = system( $seed, '' );
if ( $seed_exit != 0 ) {
    warn "[ warn ] seed-fabric reported errors (encryption path may be broken)\n";
}

if ($keep_running) {
    print "\n[ keep-running ] proxy at 127.0.0.1:8118\n";
    print "[ keep-running ] temp dir: $temp_dir\n";
    print "[ keep-running ] seeded slots (where rotation succeeded)\n";
    print "press ctrl-c to stop keeping temp dir\n";
    sleep 3600;
    exit 0;
}

# [ run scenarios ]
my @scenario_files = (
    'scenario-1-direct-tcp-api-key.pl',
    'scenario-2-hysteria-bearer.pl',
    'scenario-3-transport-degradation.pl',
    'scenario-4-rotation-invalidation.pl',
    'scenario-5-auth-relay-console.pl',
);

if ( defined $scenario_arg ) {
    if ( $scenario_arg < 1 or $scenario_arg > scalar @scenario_files ) {
        die "[ fatal ] unknown scenario $scenario_arg\n";
    }
    @scenario_files = ( $scenario_files[ $scenario_arg - 1 ] );
}

my ( $total_pass, $total_fail ) = ( 0, 0 );

for my $file (@scenario_files) {
    my $path = File::Spec->catfile( $SCENARIOS_DIR, $file );
    print "\n[ run ] $file\n";
    my $output = `timeout 25 $path 2>&1`;
    my $timeout_exit = $CHILD_ERROR;
    if ( $timeout_exit == 124 << 8 ) {
        $output .= "\n[ TIMEOUT ] scenario exceeded 25s\n";
    }
    print $output;

    my ( $pass, $fail ) = ( 0, 0 );
    while ( $output =~ m{^\[ (OK|FAIL) \]}gmc ) {
        if ( $1 eq 'OK' )   { $pass++ }
        else                { $fail++ }
    }
    $total_pass += $pass;
    $total_fail += $fail;
}

# [ summary ]
print "\n[ summary ]\n";
print "  scenarios run : " . scalar(@scenario_files) . "\n";
print "  assertions passed : $total_pass\n";
print "  assertions failed : $total_fail\n";

if ( $total_fail == 0 ) {
    print "\n[ OK ] all scenarios passed\n";
    $cleanup->();
    exit 0;
}

warn "\n[ FAIL ] $total_fail assertion(s) failed\n";
if ( not $no_cleanup ) {
    print "[ fixture kept: $temp_dir ]\n";
    # [ keep temp dir for inspection ]
    $no_cleanup = 1;
}
exit 1;

# [ end ]

