#!/usr/bin/perl
use v5.24;
use strict;
use English;
use warnings;
use Sys::Hostname;
use Cwd qw| abs_path |;
use File::Spec;
use FindBin     qw| $RealBin |;
use Time::HiRes qw| sleep |;
use File::Path  qw| make_path |;
our $up_dir = File::Spec->updir;
our $Bin    = $RealBin;

my @window_geometry;
if ( hostname eq qw| zuluma | ) {
    @window_geometry = qw|  0  347  -77  947  |;
} else {
    @window_geometry = qw|  0  207  -77  1400  |;
}

my $protocol_7_path = &p7_root_dir;    ## determine protocol-7 root path ##

my @edit_files;

@ARGV = split( m|\s+|, qx| /usr/bin/xsel -o | ) if !@ARGV;

my @check_paths = map { abs_path( join( '/', $protocol_7_path, $ARG ) ) } qw[
    src
    cfg/zenki
    cfg
    bin
    cfg/network
    bin/dev
    bin/admin
    ], '', qw[
    bin/dev/scripts
    data/lib-path/pm
    ];

{
    $ENV{'HOME'} //= qw| taeki |;
    push( @check_paths, $ENV{'HOME'}, qw| /tmp | );
}

## local pm lib path modules ##
if ( @ARGV == 1 and ( $ARGV[0] =~ m|::| or $ARGV[0] eq qw| AMOS7 | ) ) {
    map { $ARG =~ s|::|/|g; $ARG .= '.pm' } @ARGV;
}

foreach my $filename (@ARGV) {
    $filename =~ s|\n||g;
    if ( $filename =~ m|^/| or -f $filename ) {
        push( @edit_files, $filename );
    } else {
        foreach my $path (@check_paths) {
            $filename = sprintf qw| %s/zenka.v7 |, $filename
                if $path =~ m|/zenki$|
                and -d sprintf qw| %s/%s |,          $path, $filename
                and -f sprintf qw| %s/%s/zenka.v7 |, $path, $filename;
            if ( -f join qw| / |, $path, $filename ) {
                push( @edit_files, sprintf( qw| %s/%s |, $path, $filename ) );
                last;
            }
        }
    }
}

warn "\n << selected file name or path not found >>\n\n"
    if @ARGV and !@edit_files;

open( my $fh, '-|', join( ' ', 'scite', @edit_files ) ) or die "\l$OS_ERROR";
close($fh);

## window positioning / fade-in is X11-window-manager eye candy on top of ##
## the actual editor launch above -- skip it cleanly [ no hang, no die ]  ##
## when the tools it needs aren't on this host [ e.g. WSL w/o an openbox  ##
## set-up yet ], rather than spinning forever waiting for a window that   ##
## wmctrl can never report because it doesn't exist                       ##
if ( not cmd_exists(qw| wmctrl |) or not cmd_exists(qw| transset |) ) {
    warn "\n << wmctrl/transset not found -- "
        . "skipping window positioning >>\n\n";
    exit 0;
}

my $xrandr_output = qx| xrandr |;
( my $sw, my $sh ) = ( $1, $2 )
    if $xrandr_output =~ m| current (\d+) x (\d+),|;

die "\n << error while acquiring screen dimensions "
    . "[ xrandr installed ? ] >>\n\n [ $xrandr_output ]"
    if not defined $sw
    or not defined $sh
    or $sw < 1
    or $sh < 1;

my $wh = $sh + 77 - 20;

my $win_geometry = sprintf qw| '%s' |, join( ',', @window_geometry, $wh );
my $window_name  = "' - SciTE'";

## bounded wait [ ~14s ] -- defense in depth : cmd_exists above already  ##
## rules out the missing-wmctrl case, this guards the other way a window ##
## may never appear [ e.g. scite itself failed to start ]                ##
my $found     = 0;
my $wait_left = 200;
while ( not $found and $wait_left-- > 0 ) {
    ++$found   if qx| wmctrl -l | =~ m| SciTE( \[\d+ of \d+\])?$|ms;
    sleep 0.07 if not $found;
}

if ( not $found ) {
    warn "\n << SciTE window not found via wmctrl after "
        . "waiting -- skipping window positioning >>\n\n";
    exit 0;
}

sleep 0.07;

say qx[ wmctrl -e $win_geometry -r $window_name ];
say qx[ wmctrl -a $window_name & ];

system(qw| wmctrl -a ' - SciTE' & |);
my $accel = 0.047;

for ( my $t = 0.97; $t > 0.77; $t -= 0.01 ) {
    qx| transset -n SciTE $t |;
    sleep $accel;
    $accel = 0.044 - sprintf( qw| %.04f |, $accel * 0.47 );
}

sub c_dir  { File::Spec->catdir(@ARG) }
sub r2_abs { File::Spec->rel2abs(@ARG) }

sub cmd_exists {
    my ($cmd) = @ARG;
    my $path = qx| command -v $cmd 2>/dev/null |;
    chomp $path;
    return length $path ? 1 : 0;
}

sub p7_root_dir {
    my $root_path = abs_path( r2_abs( c_dir( $Bin, ($up_dir) x 3 ) ) );
    die "  :\n  :: not a directory : '$root_path'\n\n" if not -d $root_path;
    return $root_path;
}

#,,..,,,.,.,.,..,,...,,.,,..,,.,.,.,,,.,,,...,..,,...,...,.,.,,.,,..,,.,.,..,,
