#!/usr/bin/perl

use v5.24;
use strict;
use English;
use warnings;
use File::Spec;
use Cwd     qw| abs_path |;
use FindBin qw| $RealBin |;

## invoke-queue-harmonize  Harmonically randomize InvokeAI queue using ##
## division-by-13 PRNG                                                 ##

##[ LOCAL PM LIB PATH ]#######################################################

BEGIN {
    my $up_dir       = File::Spec->updir;
    my $data_pm_path = qw| data/lib-path/pm |;
    my $root_path = abs_path( r2_abs( c_dir( $RealBin, $up_dir, $up_dir ) ) );
    my $local_lib_path = abs_path( c_dir( $root_path, $data_pm_path ) );
    $local_lib_path //= $data_pm_path;
    die "\n:\n:: not found : $local_lib_path\n:\n" if !-d $local_lib_path;
    unshift( @INC, $local_lib_path )               if -d $local_lib_path;
    sub c_dir  { File::Spec->catdir(@ARG) }
    sub r2_abs { File::Spec->rel2abs(@ARG) }
}

##[ DBI ]#####################################################################

use DBI;

##[ CONSTANTS ]###############################################################

use constant {
    TRUE  => 5,
    FALSE => 0,
};

##[ MAIN EXECUTION ]##########################################################

my $db_path = "$ENV{HOME}/.invokeai/databases/invokeai.db";

main();

sub main {

    # 1. Connect to InvokeAI database
    my $dbh = connect_db($db_path);
    return unless defined $dbh;

    # 2. Check for in_progress items
    my $in_progress_count = check_in_progress_items($dbh);
    if ( $in_progress_count > 0 ) {
        say "Note: $in_progress_count item(s) currently "
            . "in_progress (will not be modified)";
    }

    # 3. Read pending queue items ONLY - don't touch in_progress items
    my @pending_items = read_pending_queue($dbh);

    if ( @pending_items == 0 ) {
        say "No pending items to randomize";
        $dbh->disconnect;
        return;
    }

    say "Found "
        . scalar(@pending_items)
        . " pending items ready to randomize";

    # 4. Generate harmonic seed from queue state
    my $seed = generate_harmonic_seed( \@pending_items );
    say sprintf( "Harmonic seed: %016x", $seed );

    # 5. Generate entropy stream with multi-pass harmonization
    my @entropy_stream
        = generate_harmonic_entropy_stream( $seed, scalar(@pending_items) );

    # 6. Reorder queue based on harmonic entropy
    reorder_queue_by_entropy( \@pending_items, \@entropy_stream );

    # 7. Update database with new priorities
    update_queue_priorities( $dbh, \@pending_items );

    say "Queue harmonically randomized - "
        . scalar(@pending_items)
        . " items reordered";

    $dbh->disconnect;
}

##[ DATABASE CONNECTION ]#####################################################

sub connect_db {
    my $db_path = shift;

    unless ( -f $db_path ) {
        warn "InvokeAI database not found: $db_path\n";
        return;
    }

    my $dbh = DBI->connect(
        "dbi:SQLite:dbname=$db_path",
        "", "",
        {   RaiseError     => 0,
            AutoCommit     => 1,
            sqlite_unicode => 1,
        }
    );

    unless ( defined $dbh ) {
        warn "Cannot connect to database: $DBI::errstr\n";
        return;
    }

    return $dbh;
}

##[ CHECK FOR IN_PROGRESS ITEMS ]#############################################

sub check_in_progress_items {
    my $dbh = shift;

    my $sth
        = $dbh->prepare( "SELECT COUNT(*) as count FROM "
            . "session_queue WHERE status = 'in_progress'" );

    unless ( $sth->execute ) {
        warn "Failed to query in_progress items: " . $dbh->errstr . "\n";
        return -1;
    }

    my $row = $sth->fetchrow_hashref;
    $sth->finish;

    return $row->{count} // 0;
}

##[ READ PENDING QUEUE ]######################################################

sub read_pending_queue {
    my $dbh = shift;

    my $sth
        = $dbh->prepare(
              "SELECT item_id, session_id, priority FROM session_queue "
            . "WHERE status = 'pending' ORDER BY priority DESC, item_id ASC"
        );

    unless ( $sth->execute ) {
        warn "Failed to query pending items: " . $dbh->errstr . "\n";
        return;
    }

    my @items;
    while ( my $row = $sth->fetchrow_hashref ) {
        push @items, $row;
    }

    $sth->finish;
    return @items;
}

##[ GENERATE HARMONIC SEED ]##################################################

sub generate_harmonic_seed {
    my $items_ref = shift;

    # Concatenate session IDs for seed material
    my $seed_material
        = join( '', map { $_->{session_id} // '' } @$items_ref );
    $seed_material //= 'invokeai-queue-harmonization';

    # Hash the seed material to get a numeric value
    my $seed_num = 0;
    for my $ch ( split '', $seed_material ) {
        $seed_num = ( $seed_num << 5 ) + ( $seed_num << 4 ) + ord($ch);
        $seed_num = int( $seed_num % ( 2**31 ) );
    }

    # Apply division-by-13 transformation for harmonic balance
    $seed_num = divide_by_13($seed_num) while $seed_num > ( 2**30 );

    return $seed_num;
}

##[ GENERATE HARMONIC ENTROPY STREAM ]########################################

sub generate_harmonic_entropy_stream {
    my ( $seed, $count ) = @_;

    # Determine iteration count based on seed (3-7 range for performance)
    my $seed_mod   = $seed % 5;
    my $iterations = 3 + $seed_mod;

    say sprintf( "Multi-pass harmonization: %d passes", $iterations );

    # Seed Perl's random number generator
    srand($seed);

    # Generate initial entropy stream using rand()
    my @entropy = ();
    for ( 1 .. $count ) {
        my $val = int( rand( 2**31 ) );
        push @entropy, $val;
    }

    # Multi-pass harmonic balancing using division-by-13 transforms
    for my $pass ( 1 .. $iterations ) {
        for my $i ( 0 .. $#entropy ) {

            # Apply division-by-13 transformation
            $entropy[$i] = int( $entropy[$i] / 13 );

            # XOR with pass number for additional entropy mixing
            $entropy[$i] = $entropy[$i] ^ ( $pass << 8 );

            # Ensure non-zero
            $entropy[$i] = $entropy[$i] + 1 if $entropy[$i] == 0;
        }
    }

    return @entropy;
}

##[ DIVIDE BY 13 ]############################################################

sub divide_by_13 {
    my $num = shift;
    return int( $num / 13 );
}

##[ REORDER QUEUE ]###########################################################

sub reorder_queue_by_entropy {
    my ( $items_ref, $entropy_ref ) = @_;

    # Create indexed mapping
    my @indexed = map {
        {   entropy => $entropy_ref->[$_],
            index   => $_,
            item    => $items_ref->[$_]
        }
    } ( 0 .. $#$items_ref );

    # Sort by harmonic entropy values
    my @sorted = sort { $a->{entropy} <=> $b->{entropy} } @indexed;

    # Assign descending priorities (highest priority first)
    my $max_priority = scalar(@$items_ref);
    for my $i ( 0 .. $#sorted ) {
        $sorted[$i]{item}{new_priority} = $max_priority - $i;
    }

    return;
}

##[ UPDATE DATABASE ]#########################################################

sub update_queue_priorities {
    my ( $dbh, $items_ref ) = @_;

    # Begin transaction for atomic update
    $dbh->begin_work;

    my $sth
        = $dbh->prepare( "UPDATE session_queue SET priority = ? "
            . "WHERE item_id = ? AND status = 'pending'" );

    my $update_count = 0;
    for my $item (@$items_ref) {
        if ( $sth->execute( $item->{new_priority}, $item->{item_id} ) ) {
            $update_count++;
        } else {
            warn sprintf( "Failed to update item_id %s: %s\n",
                $item->{item_id}, $dbh->errstr );
        }
    }

    $dbh->commit;

    say sprintf( "Database updated - %d priorities assigned", $update_count );

    return;
}

