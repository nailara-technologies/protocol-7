#!/usr/bin/perl
use strict;
use English;
use warnings;

my $changes    = 0;
my $regex_mode = grep { $ARG eq qw| -r | } @ARGV;
my @files      = grep { $ARG ne qw| -r | } @ARGV;
if ( !@files ) {
    opendir( DIR, '.' ) or die $OS_ERROR;
    @files = readdir(DIR);
    closedir(DIR);
}

$! = 1;

my $mode_str = $regex_mode ? 'regex' : 'string';
print "\n<!> [ make sure you have backups ]\n .\n . "
    . ": mode : $mode_str :\n .\n :\n :: find    :. ";
my $find = <STDIN>;
chop($find);
print " :: replace :. ";
my $replace = <STDIN>;
chop($replace);

$INPUT_RECORD_SEPARATOR = undef;

print " ::\n";

foreach my $file (@files) {
    if ( -f $file ) {
        print " :: parsing file $file..\n";
        open( FILE, "<$file" ) or die $OS_ERROR;
        my $file_data = <FILE>;
        close(FILE);

        $changes
            += $regex_mode
            ? ( $file_data =~ s{$find}{$replace}gm )
            : ( $file_data =~ s{\Q$find\E}{$replace}gm );
        open( FILE, ">$file" ) or die $OS_ERROR;
        print FILE $file_data;
        close(FILE);
    }
}

print " ::\n ::\n :::. done. [ changes : $changes ]\n\n";

