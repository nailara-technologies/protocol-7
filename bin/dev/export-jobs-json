#!/usr/bin/perl
## [:< ##

# name  = export-jobs-json
# descr = export scored jobs from site-yaml store as jobs.json

use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../../data/lib-path/pm";

use YAML::XS ();
use JSON::XS ();
use Encode   ();

## normalize a string, repairing UTF-8 double-encoding (Mojibake)
sub to_unicode {
    my $s = shift // '';
    ## raw byte string: just decode as UTF-8
    unless ( utf8::is_utf8($s) ) {
        return eval { Encode::decode( 'UTF-8', $s, Encode::FB_CROAK ) }
            // Encode::decode( 'Latin-1', $s );
    }
        ## Unicode string whose codepoints may be Latin-1 values of double-encoded bytes
    ## use LEAVE_SRC to skip chars outside Latin-1 range (em-dashes etc.) rather
    ## than croaking, apply up to 2 rounds for complex double-encoding
    my $cur = $s;
    for ( 1 .. 2 ) {
        ## encode to Latin-1 bytes, substituting non-Latin-1 chars with placeholder
        my $b = Encode::encode( 'Latin-1', $cur, Encode::HTMLCREF );
        ## HTMLCREF converts non-Latin-1 to &#NNNN; — decode UTF-8 of the result
        my $fixed = eval { Encode::decode( 'UTF-8', $b, Encode::FB_CROAK ) };
        last unless defined $fixed;
        ## restore HTML numeric refs (came from non-Latin-1 chars, already correct)
        $fixed =~ s{&#(\d+);}{chr($1)}ge;
        $cur = $fixed;
        last unless $cur =~ /[\xC0-\xCF]/;    ## still Mojibake?
    }
    return $cur;
}

my $store_file = '/var/protocol-7/site-yaml/store.yaml';
my $out_file   = $ARGV[0] // '/var/httpd/jobs.local/jobs.json';

-f $store_file or die "store not found: $store_file\n";

my $store = YAML::XS::LoadFile($store_file);
ref $store eq 'HASH' or die "invalid store format\n";

my @jobs;
for my $id ( sort keys %{$store} ) {
    my $j     = $store->{$id};
    my $stage = $j->{'status'} // 'new';
    ## map store status to tracker stage
    my $tracker_stage = {
        'new'      => 'review',
        'assessed' => 'review',
        'applied'  => 'applied',
        'rejected' => 'rejected',
        'skipped'  => 'skipped',
        'archived' => 'archived',
        'blocked'  => 'skipped',
    }->{ $stage } // 'review';

    ## build assertions export (compact)
    my $assertions = {};
    if ( ref $j->{'assertions'} eq 'HASH' ) {
        my $as = $j->{'assertions'};
        if ( ref $as->{'suggest'} eq 'HASH' ) {
            $assertions->{'suggest'} = {};
            for my $k ( qw| apply delete archive | ) {
                my $v = $as->{'suggest'}{$k} // '';
                $assertions->{'suggest'}{$k} = $v if length $v;
            }
        }
        if ( ref $as->{'dimensions'} eq 'HASH' ) {
            $assertions->{'dimensions'} = {};
            for my $dim (
                qw| location work-profile company-culture compensation
                    remote-flexibility career-growth tech-stack team-structure |
            ) {
                my $d = $as->{'dimensions'}{$dim} // {};
                my $ds = $d->{'score'} // '';
                next if $ds eq '' or $ds eq 'unasserted';
                $assertions->{'dimensions'}{$dim} = {
                    score  => $ds + 0,
                    reason => to_unicode( $d->{'reason'} // '' ),
                };
            }
        }
    }

    push @jobs, {
        id       => $id,
        title    => to_unicode( $j->{'title'}        ),
        company  => to_unicode( $j->{'company'}      ),
        city     => to_unicode( $j->{'city'}         ),
        industry => to_unicode( $j->{'industry'}     ),
        url      => to_unicode( $j->{'url'}          ),
        score    => ( defined $j->{'score'} && length $j->{'score'} ) ? $j->{'score'} + 0 : undef,
        reason   => to_unicode( $j->{'score_reason_de'} || $j->{'score_reason'} || '' ),
        summary  => to_unicode( $j->{'score_summary'} || '' ),
        stage    => $tracker_stage,
        fetched  => $j->{'fetched_at'} // '',
        assertions    => ( keys %$assertions ) ? $assertions : undef,
        repair_applied=> $j->{'repair_applied'} ? 1 : 0,
        repair_failed => $j->{'repair_failed'}  ? 1 : 0,
    };
}

## sort descending by score (undef scores sort to bottom)
@jobs = sort {
    ( defined $b->{'score'} ? $b->{'score'} : -1 )
    <=>
    ( defined $a->{'score'} ? $a->{'score'} : -1 )
} @jobs;

my $output = {
    generated => scalar localtime,
    total     => scalar @jobs,
    jobs      => \@jobs,
};

my $json = JSON::XS->new->utf8->pretty->encode($output);

## write atomically via tmp file
my $tmp = "$out_file.tmp";
open( my $fh, '>', $tmp ) or die "cannot write $tmp: $!\n";
print $fh $json;
close $fh;
rename $tmp, $out_file or die "cannot rename: $!\n";

printf "exported %d jobs → %s\n", scalar @jobs, $out_file;

