#!/usr/bin/perl
## [:< ##

# name  = export-jobs-json
# descr = export scored jobs from site-yaml store as jobs.json

use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../../data/lib-path/pm";

use YAML::XS ();
use JSON::XS ();
use Encode   ();

## normalize a string to a proper Perl Unicode string
sub to_unicode {
    my $s = shift // '';
    return $s if utf8::is_utf8($s);
    ## try UTF-8 first, fall back to Latin-1
    my $decoded = eval { Encode::decode( 'UTF-8', $s, Encode::FB_CROAK ) };
    return defined $decoded ? $decoded : Encode::decode( 'Latin-1', $s );
}

my $store_file = '/var/protocol-7/site-yaml/store.yaml';
my $out_file   = $ARGV[0] // '/var/httpd/jobs.taute.re/jobs.json';

-f $store_file or die "store not found: $store_file\n";

my $store = YAML::XS::LoadFile($store_file);
ref $store eq 'HASH' or die "invalid store format\n";

my @jobs;
for my $id ( sort keys %{$store} ) {
    my $j     = $store->{$id};
    my $stage = $j->{'status'} // 'new';
    ## only export jobs that have been assessed (have a score)
    next unless defined $j->{'score'} && length $j->{'score'};
    ## map store status to tracker stage
    my $tracker_stage = {
        'new'      => 'review',
        'assessed' => 'review',
        'applied'  => 'applied',
        'rejected' => 'rejected',
        'skipped'  => 'skipped',
        'archived' => 'archived',
    }->{ $stage } // 'review';

    push @jobs, {
        id       => $id,
        title    => to_unicode( $j->{'title'}        ),
        company  => to_unicode( $j->{'company'}      ),
        city     => to_unicode( $j->{'city'}         ),
        industry => to_unicode( $j->{'industry'}     ),
        url      => to_unicode( $j->{'url'}          ),
        score    => $j->{'score'} + 0,
        reason   => to_unicode( $j->{'score_reason_de'} || $j->{'score_reason'} ),
        summary  => to_unicode( $j->{'score_summary'} ),
        stage    => $tracker_stage,
        fetched  => $j->{'fetched_at'} // '',
    };
}

## sort descending by score
@jobs = sort { $b->{'score'} <=> $a->{'score'} } @jobs;

my $output = {
    generated => scalar localtime,
    total     => scalar @jobs,
    jobs      => \@jobs,
};

my $json = JSON::XS->new->utf8->pretty->encode($output);

## write atomically via tmp file
my $tmp = "$out_file.tmp";
open( my $fh, '>', $tmp ) or die "cannot write $tmp: $!\n";
print $fh $json;
close $fh;
rename $tmp, $out_file or die "cannot rename: $!\n";

printf "exported %d jobs → %s\n", scalar @jobs, $out_file;

