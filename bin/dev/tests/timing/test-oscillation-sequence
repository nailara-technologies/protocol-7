#!/bin/bash

# test oscillation sequence - signs with temp key, re-signs, checks idempotency
# usage: ./bin/dev/tests/timing/test-oscillation-sequence <file-pattern>

if [ -z "$1" ]; then
    echo "usage: ./bin/dev/tests/timing/test-oscillation-sequence <file-pattern>"
    echo "example: ./bin/dev/tests/timing/test-oscillation-sequence modules/test.1"
    exit 1
fi

PATTERN="$1"
TEST_DIR=".test-oscillation-output"

mkdir -p "$TEST_DIR"

echo ""
echo "=========================================="
echo "STEP 1: initial sign with temp key"
echo "=========================================="
./bin/Protocol-7 sourcecode test-sign-with-temp-key "$PATTERN" 2>&1 | tee "$TEST_DIR/step1-sign.log"

echo ""
echo "=========================================="
echo "STEP 2: verify after first sign"
echo "=========================================="
./bin/Protocol-7 sourcecode test-verify-with-temp-key "$PATTERN" 2>&1 | tee "$TEST_DIR/step2-verify.log"

echo ""
echo "=========================================="
echo "STEP 3: re-sign with temp key (idempotency check)"
echo "=========================================="
./bin/Protocol-7 sourcecode test-sign-with-temp-key "$PATTERN" 2>&1 | tee "$TEST_DIR/step3-resign.log"

echo ""
echo "=========================================="
echo "STEP 4: verify after re-sign"
echo "=========================================="
./bin/Protocol-7 sourcecode test-verify-with-temp-key "$PATTERN" 2>&1 | tee "$TEST_DIR/step4-verify.log"

echo ""
echo "=========================================="
echo "ANALYSIS"
echo "=========================================="
echo ""
echo "compare step2 and step4 outputs:"
echo "- state/bmw/sig SAME in both : no oscillation"
echo "- state/bmw/sig DIFFERENT    : oscillation detected"
echo ""
diff <(grep 'state=' "$TEST_DIR/step2-verify.log") \
     <(grep 'state=' "$TEST_DIR/step4-verify.log") \
  && echo "[ OK ] checksums match — no oscillation" \
  || echo "[ FAIL ] checksums differ — oscillation detected"
echo ""
echo "logs saved to: $TEST_DIR/"
echo ""

