#!/bin/bash

# Simple oscillation test - uses combined sign-and-verify command
# Usage: ./bin/dev/test-oscillation-simple <file-pattern>

if [ -z "$1" ]; then
    echo "Usage: ./bin/dev/test-oscillation-simple <file-pattern>"
    echo "Example: ./bin/dev/test-oscillation-simple bin/elf"
    exit 1
fi

PATTERN="$1"
TEST_DIR=".test-oscillation-simple-output"

mkdir -p "$TEST_DIR"

echo ""
echo "=========================================="
echo "STEP 1: First sign and verify cycle"
echo "=========================================="
./bin/Protocol-7 sourcecode test-sign-and-verify "$PATTERN" 2>&1 | tee "$TEST_DIR/step1-sign-verify.log"

echo ""
echo "=========================================="
echo "STEP 2: Second sign and verify cycle"
echo "=========================================="
./bin/Protocol-7 sourcecode test-sign-and-verify "$PATTERN" 2>&1 | tee "$TEST_DIR/step2-sign-verify.log"

echo ""
echo "=========================================="
echo "ANALYSIS"
echo "=========================================="
echo ""
echo "Compare step 1 and step 2 outputs:"
echo "- If state/bmw/sig values are SAME: No oscillation - FIX WORKED!"
echo "- If state/bmw/sig values are DIFFERENT: Oscillation detected"
echo ""
echo "Logs saved to: $TEST_DIR/"
echo ""

