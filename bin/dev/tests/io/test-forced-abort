#!/bin/bash
# Test forced abort at 113MB to directly trigger ABORT_DOWNLOAD path

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

cd /data/projects/protocol-7

echo "======================================"
echo "Forced Abort Test (113MB trigger)"
echo "======================================"
echo ""

# Test BROKEN version with forced abort
echo -e "${RED}===[ Testing BROKEN Version ]===${NC}"
echo "Activating test-broken version (->stop, no cleanup)..."
cp modules/httpd.handler.download_transfer.test-broken modules/httpd.handler.download_transfer
p7 v7-zenki.restart httpd > /dev/null
sleep 2

echo "Downloading 512MB file (will abort at 113MB)..."
curl -s "http://localhost/huge-test-file.bin" > /dev/null &
CURL_PID=$!
echo "Download started, PID: $CURL_PID"
echo "Waiting for forced abort at 113MB..."
sleep 5

echo "Checking for spinning/errors..."
sleep 2

ABORT_LOG=$(p7 httpd.show-buffer zenka 2>/dev/null | tail -30)
echo -e "${RED}BROKEN version log:${NC}"
echo "$ABORT_LOG" | grep -E "TEST|abort|warn|error|filehandle" || echo "(no abort messages)"

# Count errors (sign of spinning)
ERROR_COUNT=$(echo "$ABORT_LOG" | grep -c "filehandle already closed" 2>/dev/null || echo "0")
ABORT_COUNT=$(echo "$ABORT_LOG" | grep -c "TEST-BROKEN" 2>/dev/null || echo "0")

echo ""
if [ $ABORT_COUNT -gt 0 ]; then
    echo -e "${RED}✗ Hit ABORT_DOWNLOAD: $ABORT_COUNT times${NC}"
    if [ $ERROR_COUNT -gt 5 ]; then
        echo -e "${RED}✗ SPINNING DETECTED: ${ERROR_COUNT} 'filehandle already closed' errors${NC}"
        echo "  Watcher keeps firing because ->stop doesn't destroy it!"
    fi
else
    echo -e "${YELLOW}? Abort may not have triggered yet, check timing${NC}"
fi

# Kill curl
kill -9 $CURL_PID 2>/dev/null
wait $CURL_PID 2>/dev/null || true

echo ""
echo ""

# Test FIXED version with forced abort
echo -e "${GREEN}===[ Testing FIXED Version ]===${NC}"
echo "Activating test version (->cancel, full cleanup)..."
cp modules/httpd.handler.download_transfer.test modules/httpd.handler.download_transfer
p7 v7-zenki.restart httpd > /dev/null
sleep 2

echo "Downloading 512MB file (will abort at 113MB)..."
curl -s "http://localhost/huge-test-file.bin" > /dev/null &
CURL_PID=$!
echo "Download started, PID: $CURL_PID"
echo "Waiting for forced abort at 113MB..."
sleep 5

echo "Checking logs..."
sleep 2

ABORT_LOG=$(p7 httpd.show-buffer zenka 2>/dev/null | tail -30)
echo -e "${GREEN}FIXED version log:${NC}"
echo "$ABORT_LOG" | grep -E "TEST|abort|warn|error|filehandle" || echo "(no abort messages)"

# Count
ERROR_COUNT=$(echo "$ABORT_LOG" | grep -c "filehandle already closed" 2>/dev/null || echo "0")
ABORT_COUNT=$(echo "$ABORT_LOG" | grep -c "aborting download" 2>/dev/null || echo "0")

echo ""
if [ $ABORT_COUNT -gt 0 ]; then
    echo -e "${GREEN}✓ Hit ABORT_DOWNLOAD: ${ABORT_COUNT} time(s)${NC}"
    if [ $ERROR_COUNT -le 2 ]; then
        echo -e "${GREEN}✓ NO SPINNING: Only ${ERROR_COUNT} error(s) - proper cleanup!${NC}"
        echo "  Watcher destroyed with ->cancel, session cleaned up"
    fi
else
    echo -e "${YELLOW}? Abort may not have triggered yet${NC}"
fi

# Kill curl
kill -9 $CURL_PID 2>/dev/null
wait $CURL_PID 2>/dev/null || true

echo ""
echo ""
echo "======================================"
echo -e "${BLUE}SUMMARY${NC}"
echo "======================================"
echo ""
echo -e "${RED}BROKEN:${NC} Watcher spins with repeated 'filehandle already closed' errors"
echo "  → ->stop leaves watcher registered"
echo "  → No cleanup of file handle or session data"
echo "  → Causes CPU spin and eventual heartbeat timeout"
echo ""
echo -e "${GREEN}FIXED:${NC} Single abort, clean shutdown, no spinning"
echo "  → ->cancel fully destroys watcher"
echo "  → File handle closed, session data deleted"
echo "  → Proper resource cleanup"
echo ""

# Restore production fixed version
echo -e "${YELLOW}Restoring production fixed version...${NC}"
cp modules/httpd.handler.download_transfer.fixed modules/httpd.handler.download_transfer
p7 v7-zenki.restart httpd > /dev/null
echo -e "${GREEN}✓ Production version restored${NC}"

