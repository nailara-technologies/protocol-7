#!/bin/bash
# Test with client that stops reading - creates backpressure

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

cd /data/projects/protocol-7

echo "============================================"
echo "HTTP Backpressure Test - Client Stops Reading"
echo "============================================"
echo ""

# Test BROKEN version
echo -e "${RED}===[ Testing BROKEN Version ]===${NC}"
cp modules/httpd.handler.download_transfer.test-broken modules/httpd.handler.download_transfer
p7 v7-zenki.restart httpd > /dev/null
sleep 2

echo "Starting client that stops reading after initial bytes..."
echo "Using nc (netcat) to connect but not read after initial request"
echo ""

# Use netcat to connect, send request, but don't read response
(
    echo -ne "GET /huge-test-file.bin HTTP/1.1\r\nHost: localhost\r\n\r\n"
    sleep 15  # Keep connection open but don't read
) | timeout 20 nc localhost 80 > /dev/null 2>&1 &
NC_PID=$!

echo "Client connected (PID: $NC_PID), waiting for abort at 113MB..."
sleep 7

echo "Checking logs for spinning behavior..."
sleep 3

LOG=$(p7 httpd.show-buffer zenka 2>/dev/null | tail -50)
ABORT_COUNT=$(echo "$LOG" | grep -c "TEST-BROKEN" || echo "0")
FH_COUNT=$(echo "$LOG" | grep -c "filehandle already closed" || echo "0")
WARN_COUNT=$(echo "$LOG" | grep -c "warn" || echo "0")

echo ""
echo "Results:"
echo "  TEST-BROKEN messages: $ABORT_COUNT"
echo "  Filehandle errors: $FH_COUNT"
echo "  Total warnings: $WARN_COUNT"

if [ $ABORT_COUNT -gt 2 ] || [ $FH_COUNT -gt 5 ]; then
    echo -e "${RED}✗ SPINNING DETECTED - Watcher firing repeatedly!${NC}"
    echo ""
    echo "Recent errors:"
    echo "$LOG" | grep "TEST-BROKEN\|filehandle\|warn" | tail -15
elif [ $ABORT_COUNT -ge 1 ]; then
    echo -e "${YELLOW}Abort triggered but limited spinning${NC}"
else
    echo -e "${YELLOW}No abort triggered yet${NC}"
fi

kill -9 $NC_PID 2>/dev/null
wait $NC_PID 2>/dev/null || true

echo ""
echo ""

# Test FIXED version
echo -e "${GREEN}===[ Testing FIXED Version ]===${NC}"
cp modules/httpd.handler.download_transfer.test modules/httpd.handler.download_transfer
p7 v7-zenki.restart httpd > /dev/null
sleep 2

echo "Starting client that stops reading..."
(
    echo -ne "GET /huge-test-file.bin HTTP/1.1\r\nHost: localhost\r\n\r\n"
    sleep 15
) | timeout 20 nc localhost 80 > /dev/null 2>&1 &
NC_PID=$!

echo "Client connected (PID: $NC_PID), waiting for abort at 113MB..."
sleep 7

echo "Checking logs..."
sleep 3

LOG=$(p7 httpd.show-buffer zenka 2>/dev/null | tail -50)
ABORT_COUNT=$(echo "$LOG" | grep -c "aborting download" || echo "0")
FH_COUNT=$(echo "$LOG" | grep -c "filehandle already closed" || echo "0")

echo ""
echo "Results:"
echo "  Abort messages: $ABORT_COUNT"
echo "  Filehandle errors: $FH_COUNT"

if [ $ABORT_COUNT -eq 1 ] && [ $FH_COUNT -le 2 ]; then
    echo -e "${GREEN}✓ Single abort, no spinning${NC}"
elif [ $ABORT_COUNT -ge 1 ]; then
    echo -e "${YELLOW}Abort triggered: $ABORT_COUNT times${NC}"
else
    echo -e "${YELLOW}No abort triggered${NC}"
fi

kill -9 $NC_PID 2>/dev/null
wait $NC_PID 2>/dev/null || true

echo ""
echo ""
echo "============================================"
echo "Summary"
echo "============================================"
echo ""
echo "The key difference:"
echo ""
echo -e "${RED}BROKEN (->stop):${NC}"
echo "  → Watcher paused but still registered"
echo "  → When output buffer fills, watcher can't proceed"
echo "  → Forced file close triggers repeated errors"
echo "  → Each error re-enters ABORT_DOWNLOAD"
echo "  → But ->stop means it stays in watcher list"
echo ""
echo -e "${GREEN}FIXED (->cancel):${NC}"
echo "  → Watcher completely destroyed"
echo "  → Single error → clean abort"
echo "  → No re-entry possible"
echo "  → Session fully cleaned up"
echo ""

cp modules/httpd.handler.download_transfer.fixed modules/httpd.handler.download_transfer
p7 v7-zenki.restart httpd > /dev/null
echo -e "${GREEN}✓ Production version restored${NC}"

