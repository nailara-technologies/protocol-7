#!/bin/bash
# Test if BROKEN version causes httpd to become unresponsive (blocking)

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

cd /data/projects/protocol-7

echo "========================================"
echo "HTTP Blocking Test - Heartbeat Check"
echo "========================================"
echo ""

# Test BROKEN version
echo -e "${RED}===[ Testing BROKEN Version ]===${NC}"
echo "Activating test-broken version..."
cp modules/httpd.handler.download_transfer.test-broken modules/httpd.handler.download_transfer
p7 v7.restart httpd > /dev/null
sleep 2

echo "Initial heartbeat check..."
p7 httpd.heart
echo ""

echo "Starting download (will force abort at 113MB)..."
curl -s "http://localhost/huge-test-file.bin" > /dev/null &
CURL_PID=$!
echo "Download PID: $CURL_PID"
echo ""

echo "Waiting for forced abort to trigger..."
sleep 5

echo ""
echo -e "${YELLOW}Checking if httpd is responsive after abort...${NC}"
echo ""

for i in {1..10}; do
    echo -n "Heartbeat attempt $i: "
    RESULT=$(timeout 2 p7 httpd.heart 2>&1)
    EXIT_CODE=$?

    if [ $EXIT_CODE -eq 124 ]; then
        echo -e "${RED}TIMEOUT (no response)${NC}"
    elif [ $EXIT_CODE -eq 0 ]; then
        echo -e "${GREEN}$RESULT${NC}"
    else
        echo -e "${YELLOW}Error: $RESULT${NC}"
    fi

    sleep 0.5
done

echo ""
echo -e "${RED}BROKEN version: Check if httpd became unresponsive above${NC}"

# Kill curl if still running
kill -9 $CURL_PID 2>/dev/null
wait $CURL_PID 2>/dev/null || true

echo ""
echo ""

# Test FIXED version
echo -e "${GREEN}===[ Testing FIXED Version ]===${NC}"
echo "Activating test (fixed) version..."
cp modules/httpd.handler.download_transfer.test modules/httpd.handler.download_transfer
p7 v7.restart httpd > /dev/null
sleep 2

echo "Initial heartbeat check..."
p7 httpd.heart
echo ""

echo "Starting download (will force abort at 113MB)..."
curl -s "http://localhost/huge-test-file.bin" > /dev/null &
CURL_PID=$!
echo "Download PID: $CURL_PID"
echo ""

echo "Waiting for forced abort to trigger..."
sleep 5

echo ""
echo -e "${YELLOW}Checking if httpd is responsive after abort...${NC}"
echo ""

for i in {1..10}; do
    echo -n "Heartbeat attempt $i: "
    RESULT=$(timeout 2 p7 httpd.heart 2>&1)
    EXIT_CODE=$?

    if [ $EXIT_CODE -eq 124 ]; then
        echo -e "${RED}TIMEOUT (no response)${NC}"
    elif [ $EXIT_CODE -eq 0 ]; then
        echo -e "${GREEN}$RESULT${NC}"
    else
        echo -e "${YELLOW}Error: $RESULT${NC}"
    fi

    sleep 0.5
done

echo ""
echo -e "${GREEN}FIXED version: Should remain responsive (all heartbeats succeed)${NC}"

# Kill curl if still running
kill -9 $CURL_PID 2>/dev/null
wait $CURL_PID 2>/dev/null || true

echo ""
echo ""
echo "========================================"
echo -e "${BLUE}ANALYSIS${NC}"
echo "========================================"
echo ""
echo -e "${RED}BROKEN:${NC} If heartbeats timeout or stop responding:"
echo "  → Watcher is spinning on closed file handle"
echo "  → Event loop blocked, can't process heartbeat"
echo "  → Eventually v7 detects timeout and restarts httpd"
echo ""
echo -e "${GREEN}FIXED:${NC} All heartbeats should respond normally:"
echo "  → Watcher properly destroyed"
echo "  → Event loop continues normally"
echo "  → No blocking or spinning"
echo ""

# Restore production version
echo -e "${YELLOW}Restoring production fixed version...${NC}"
cp modules/httpd.handler.download_transfer.fixed modules/httpd.handler.download_transfer
p7 v7.restart httpd > /dev/null
echo -e "${GREEN}✓ Production version restored${NC}"

