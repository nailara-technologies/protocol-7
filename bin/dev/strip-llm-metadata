#!/usr/bin/perl
use v5.24;
use strict;
use English;
use warnings;
use Getopt::Std;
use Encode  qw| decode encode |;
use FindBin qw| $RealBin |;
use File::Spec;
use IPC::Open2;

###                     ###
##  strip-llm-metadata   ##
###                     ###

## removes llm metadata [ Co-Authored-By:, 'Generated with Claude Code',
## '[CLAUDE] ' prefixes .. ] from commit messages. the patterns live in
## cfg/git/llm-metadata.patterns, shared by every caller :
##
##  [no option] : filter, message on stdin, cleaned message on stdout
##                [ git filter-branch --msg-filter ]
##  -i <file>   : in place, removed lines reported on stderr [ commit-msg ]
##  -s [revs]   : scan, prints the ids of commits whose message would change
##                or whose author \ committer is an llm identity
##                [ default rev : HEAD, -v adds : author committer message ]
##  -H          : HEAD rebuilt when its author \ committer is an llm identity
##                or its message holds llm metadata : the configured
##                user.name \ user.email takes the llm's place, the author
##                date stays [ post-commit -- commit-tree + update-ref, no
##                hooks run again ]
##  -p <file>   : other pattern file
##  -C <dir>    : repository to scan [ -s, default : current directory ]
##
## lines are matched decoded, but only removed or prefix-stripped lines are
## touched -- every other byte of a message stays as it was

use constant TRUE  => 5;    ##  TRUE.  ##
use constant FALSE => 0;    ##  false  ##

my %opt;
getopts( 'i:sp:C:vH', \%opt ) or usage();
usage() if defined $opt{'i'} and $opt{'s'};

my $pattern_file = $opt{'p'}
    // File::Spec->catfile( $RealBin, File::Spec->updir,
    File::Spec->updir, qw| cfg git llm-metadata.patterns | );
my @identities;
my @patterns = load_patterns($pattern_file);

if ( defined $opt{'i'} ) {
    in_place( $opt{'i'} );
} elsif ( $opt{'H'} ) {
    harmonize_head();
} elsif ( $opt{'s'} ) {
    chdir $opt{'C'} or fail( "\l$OS_ERROR", $opt{'C'} ) if defined $opt{'C'};
    scan( @ARGV ? @ARGV : qw| HEAD | );
} else {
    binmode STDIN,  qw| :raw |;
    binmode STDOUT, qw| :raw |;
    my $msg = do { local $INPUT_RECORD_SEPARATOR; readline STDIN }
        // '';
    print {*STDOUT} ( strip($msg) )[0];
}
exit 0;

##[ patterns ]################################################################

sub load_patterns {
    my $path = shift;
    open( my $fh, qw| < |, $path ) or fail( "\l$OS_ERROR", $path );
    my @list;
    while ( my $line = readline $fh ) {
        next if $line =~ m{^\s*(?:#|$)};
        chomp $line;
        my ( $action, $regex )
            = $line =~ m{^(line|prefix|identity)\s+(.+?)\s*$}
            or fail( "invalid pattern line '$line'", $path );
        if ( $action eq 'identity' ) {
            push @identities, qr{$regex};
            next;
        }
        push @list, { action => $action, regex => qr{$regex} };
    }
    close $fh;
    fail( 'no patterns defined', $path ) if not @list;
    return @list;
}

## 'Name <email>' matching an identity pattern ##
sub llm_identity {
    my $ident = decode( qw| UTF-8 |, shift );
    return scalar grep { $ident =~ $ARG } @identities;
}

##[ strip : message bytes in, cleaned bytes + removed lines out ]#############

sub strip {
    my $msg   = shift;
    my @lines = split m{(?<=\n)}, $msg;
    my ( @kept, @removed );

LINE: foreach my $i ( 0 .. $#lines ) {
        my $raw  = $lines[$i];
        my $text = decode( qw| UTF-8 |, $raw =~ s{\n$}{}r );
        foreach my $pattern (@patterns) {
            next if $text !~ $pattern->{regex};
            if ( $pattern->{action} eq 'line' ) {
                push @removed, $text;
                ## a removed line between two empty lines takes one along ##
                pop @kept
                    if @kept
                    and $kept[-1] eq "\n"
                    and ( $lines[ $i + 1 ] // "\n" ) eq "\n";
                next LINE;
            }
            push @removed, $text;
            $text =~ s|$pattern->{regex}||;
            $raw = encode( qw| UTF-8 |, $text )
                . ( $raw =~ m{\n$} ? "\n" : '' );
        }
        push @kept, $raw;
    }
    return ($msg) if not @removed;

    my $clean = join '', @kept;
    $clean =~ s{\s+\z}{\n};    ## no trailing empty lines ##
    return ( $clean, @removed );
}

##[ -i : commit-msg hook ]####################################################

sub in_place {
    my $file = shift;
    open( my $fh, qw| < |, $file ) or fail( "\l$OS_ERROR", $file );
    binmode $fh, qw| :raw |;
    my $msg = do { local $INPUT_RECORD_SEPARATOR; readline $fh }
        // '';
    close $fh;

    my ( $clean, @removed ) = strip($msg);
    return if not @removed;

    open( $fh, qw| > |, $file ) or fail( "\l$OS_ERROR", $file );
    binmode $fh, qw| :raw |;
    print {$fh} $clean;
    close $fh;

    binmode STDERR, qw| :utf8 |;
    print STDERR "\n:: info :: removed llm metadata "
        . "from commit message\n:: filtered :\n";
    print STDERR "::   - $ARG\n" foreach grep {length} @removed;
    print STDERR "\n";
}

##[ -s : commits whose message would change ]#################################

sub scan {
    my @revs = @ARG;
    open(
        my $log_fh, qw| -\| |,
        qw| git -c color.ui=false log --no-color |,
        q{--format=%H%x00%an <%ae>%x00%cn <%ce>%x00%B%x00},
        @revs, qw| -- |
    ) or fail("cannot start git log : \l$OS_ERROR");
    binmode $log_fh, qw| :raw |;
    local $INPUT_RECORD_SEPARATOR = "\0";
    while ( my $hash = readline $log_fh ) {
        chomp $hash;
        $hash =~ s{^\s+}{};
        chomp( my $author    = readline $log_fh // last );
        chomp( my $committer = readline $log_fh // last );
        chomp( my $msg       = readline $log_fh // last );
        my ( undef, @removed ) = strip($msg);
        my @reasons = (
            ( llm_identity($author)    ? qw| author |    : () ),
            ( llm_identity($committer) ? qw| committer | : () ),
            ( @removed                 ? qw| message |   : () )
        );
        next if not @reasons;
        say $opt{'v'} ? "$hash @reasons" : $hash;
    }
    close $log_fh;
}

##[ -H : post-commit ]########################################################

sub harmonize_head {
    my $fields = git_out(
        qw| log -1 --date=raw |,
        q{--format=%H%x00%T%x00%P%x00%an%x00%ae%x00%ad%x00%cn%x00%ce%x00%B},
        qw| HEAD |
    );
    my ($hash,   $tree,   $parents, $a_name, $a_email,
        $a_date, $c_name, $c_email, $msg
    ) = split m{\0}, $fields, 9;
    return if not defined $msg;

    my $llm_author    = llm_identity("$a_name <$a_email>");
    my $llm_committer = llm_identity("$c_name <$c_email>");
    my ( $clean, @removed ) = strip($msg);
    return if not $llm_author and not $llm_committer and not @removed;

    chomp( my $name  = git_out(qw| config user.name |) );
    chomp( my $email = git_out(qw| config user.email |) );
    if (    ( $llm_author or $llm_committer )
        and ( not length $email or llm_identity("$name <$email>") ) ) {
        print STDERR "\n:: warning :: llm identity on HEAD, but user.name \\ "
            . "user.email is no developer identity to replace "
            . "it with [ pre-push will refuse it ]\n\n";
        return if not @removed;
        ( $llm_author, $llm_committer ) = ( FALSE, FALSE );
    }

    local $ENV{'GIT_AUTHOR_NAME'}  = $llm_author ? $name  : $a_name;
    local $ENV{'GIT_AUTHOR_EMAIL'} = $llm_author ? $email : $a_email;
    local $ENV{'GIT_AUTHOR_DATE'}  = $a_date;
    ## committer always explicit : an inherited GIT_COMMITTER_* env      ##
    ## [ the llm session's own ] would come back otherwise. date renewed ##
    local $ENV{'GIT_COMMITTER_NAME'}  = $llm_committer ? $name  : $c_name;
    local $ENV{'GIT_COMMITTER_EMAIL'} = $llm_committer ? $email : $c_email;
    delete local $ENV{'GIT_COMMITTER_DATE'};

    my @parent_args = map { ( qw| -p |, $ARG ) } split m{ }, $parents;
    my $pid         = open2( my $out, my $in, qw| git commit-tree |, $tree,
        @parent_args );
    binmode $in, qw| :raw |;
    print {$in} $clean;
    close $in;
    chomp( my $new = readline($out) // '' );
    close $out;
    waitpid $pid, 0;
    fail( 'commit-tree failed', $hash ) if $new !~ m|^[0-9a-f]{40}$|;

    system(
        qw| git update-ref -m |,
        'post-commit : llm identity \ metadata harmonized',
        qw| HEAD |, $new, $hash
        ) == 0
        or fail( 'update-ref failed', $hash );

    my @what = (
        ( $llm_author    ? qw| author |    : () ),
        ( $llm_committer ? qw| committer | : () ),
        ( @removed       ? qw| message |   : () )
    );
    binmode STDERR, qw| :utf8 |;
    printf STDERR "\n:: info :: llm %s harmonized .: HEAD %s -> %s\n",
        join( q{ \\ }, @what ), substr( $hash, 0, 9 ), substr( $new, 0, 9 );
    print STDERR "::   - $ARG\n" foreach grep {length} @removed;
    print STDERR "\n";
}

sub git_out {
    open( my $fh, qw| -\| |, qw| git -c color.ui=false |, @ARG )
        or fail("cannot start git : \l$OS_ERROR");
    binmode $fh, qw| :raw |;
    my $text = do { local $INPUT_RECORD_SEPARATOR; readline $fh }
        // '';
    close $fh;
    return $text;
}

sub fail {
    my ( $msg, $subject ) = @ARG;
    print STDERR ":\n:: $msg .: "
        . ( $subject // 'strip-llm-metadata' )
        . " ::\n:\n";
    exit 2;
}

sub usage {
    print STDERR ":\n:: usage : strip-llm-metadata [-p <patterns>]           "
        . "      [ stdin -> stdout ]\n:         "
        . "strip-llm-metadata [-p <patterns>] -i <file>       [ "
        . "in place ]\n:         strip-llm-metadata [-p "
        . "<patterns>] -s [-C <dir>] [revs] [ list commits "
        . "]\n:\n";
    exit 2;
}

