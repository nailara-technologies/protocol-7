#!/usr/bin/perl
use v5.32.0;
use utf8;
use strict;
use English;
use warnings;

###                  ###
##  p7-sign-wait      ##
###                  ###

## wait for a p7_sign job [ bin/dev/p7-sign-run ] to reach its final state,
## then print it and exit -- 0 approved, 1 otherwise. for callers that get
## notified when a background command ends
## [ the p7_sign mcp tool itself never waits ] :
##
## p7-sign-wait <job> [ <timeout seconds, default 3600> ]

use FindBin;
use Cwd      ();
use JSON::PP ();

my $job     = shift // '';
my $timeout = shift // 3600;
die "p7-sign-wait <job> [ <timeout seconds> ]\n"
    if $job !~ m|^p7-sign-\d+-\d+$| or $timeout !~ m|^\d+$|;

my $root_path  = Cwd::abs_path("$FindBin::Bin/../..");
my $state_path = "$root_path/data/state/$job.json";
my $deadline   = time() + $timeout;

while (1) {
    my $state = eval {
        open( my $fh, '<:raw', $state_path ) or die "$OS_ERROR\n";
        local $INPUT_RECORD_SEPARATOR;
        JSON::PP->new->decode(<$fh>);
    };
    if ( ref $state eq 'HASH' ) {
        my $status = $state->{'status'} // '';
        my $final  = $status =~ m{^(?:approved|denied|aborted|failed)$};
        $status = 'failed [ job process gone ]'
            if not $final
            and $state->{'pid'}
            and not kill 0, $state->{'pid'};
        if ( $final or $status =~ m|^failed| ) {
            say "$job : $status";
            say "run    : $state->{'run_id'}" if $state->{'run_id'};
            say sprintf 'signed : %d of %d', $state->{'signed'} // 0,
                scalar @{ $state->{'paths'} // [] };
            say "reason : $state->{'denied_reason'}"
                if length( $state->{'denied_reason'} // '' );
            exit( $status eq 'approved' ? 0 : 1 );
        }
    }
    if ( time() > $deadline ) {
        say "$job : still waiting after $timeout s";
        exit 1;
    }
    select( undef, undef, undef, 2 );
}

