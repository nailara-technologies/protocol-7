#!/usr/bin/perl
use v5.32.0;
use utf8;
use strict;
use English;
use warnings;

###                  ###
##  p7-sign-wait      ##
###                  ###

## wait for a p7_sign job [ bin/dev/p7-sign-run ] or a p7_commit
## [ bin/dev/ p7-commit ] to reach its final state,  then print it and exit --
## 0 approved \ committed, 1 any other final state, 2 unknown job
## [ no state file after 15 s, the newest job ids are listed ], 3 the timeout
## ran out while the job was NOT final [ says so, names the last status ].
## only a final state in the file ends the wait with 0. for callers that get
## notified when a background command ends
## [ the p7_sign mcp tool itself never waits ] :
##
## p7-sign-wait <job> [ <timeout seconds, default 3600> ]

use FindBin;
use Cwd      ();
use JSON::PP ();

my $job     = shift // '';
my $timeout = shift // 3600;
## tests point it at fake state files [ P7_STATE_DIR ] ##
my $fast = $ENV{'P7_SIGN_WAIT_FAST'};
die "p7-sign-wait <job> [ <timeout seconds> ]\n"
    if $job !~ m{^p7-(?:sign|commit)-(?:\d+|[A-Z2-7]+)-\d+$}
    or $timeout !~ m|^\d+$|;

my $root_path  = Cwd::abs_path("$FindBin::RealBin/../..");
my $state_dir  = $ENV{'P7_STATE_DIR'} // "$root_path/data/state";
my $state_path = "$state_dir/$job.json";
my $last       = 'no state yet';
my $pause      = $fast ? 0.05 : 0.5;
my $deadline   = time() + $timeout;

my $session_name = $ENV{'P7_SESSION_NAME'} // '';
my $session_sid  = lc( $ENV{'CLAUDE_CODE_SESSION_ID'} // '' );
my $registered   = 0;

sub report_open {
    my $clear = shift // 0;
    return 0
        if ( $ENV{'P7_SESSION_REPORT'} // '' ) eq 'no'
        or $job !~ m|\Ap7-sign-|
        or ( length $session_name
        and $session_name !~ m|\A[\w.\-]{1,64}\z| )
        or $session_sid !~ m|\A[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}\z|;
    my @args = (
        'p7c',
        'coding.session-open',
        ( length $session_name ? "name=$session_name" : () ),
        "sid=$session_sid",
        'kind=wait',
        "id=$job",
        "clear=$clear"
    );
    push @args, 'what=sign_job' if not $clear;
    open( my $null, '+>', '/dev/null' ) or return 0;
    local *STDOUT = $null;
    local *STDERR = $null;
    return system(@args) == 0;
}

$registered = report_open(0);

END {
    my $status = $?;
    report_open(1) if $registered;
    $? = $status;
}

sub read_state {
    return eval {
        open( my $fh, '<:raw', $state_path ) or die "$OS_ERROR\n";
        local $INPUT_RECORD_SEPARATOR;
        JSON::PP->new->decode(<$fh>);
    };
}

sub is_final {
    return ( ( shift // '' )
        =~ m{^(?:approved|denied|aborted|failed|committed|refused|stale)$} );
}

while (1) {
    my $state = read_state();
    if ( ref $state eq 'HASH' ) {
        my $status = $state->{'status'} // '';
        $last = $status if length $status;
        my $final = is_final($status);
        ## the job process is gone : it writes its final state BEFORE it ##
        ## exits, so read the file again before calling it a crash       ##
        if ( not $final and $state->{'pid'} and not kill 0, $state->{'pid'} )
        {
            select( undef, undef, undef, $fast ? 0.1 : 1 );
            my $again = read_state();
            if ( ref $again eq 'HASH' and is_final( $again->{'status'} ) ) {
                $state  = $again;
                $status = $again->{'status'};
                $final  = 1;
            } else {
                $status = 'failed [ job process gone ]';
            }
        }
        if ( $final or $status =~ m|^failed| ) {
            say "$job : $status";
            say "run    : $state->{'run_id'}" if $state->{'run_id'};
            say "commit : $state->{'commit'}" if $state->{'commit'};
            say sprintf 'signed : %d of %d', $state->{'signed'} // 0,
                scalar @{ $state->{'paths'} // [] }
                if $state->{'paths'};
            print $state->{'report'} if length( $state->{'report'} // '' );
            say "reason : $state->{'denied_reason'}"
                if length( $state->{'denied_reason'} // '' );
            say "ended  : $state->{'end_reason'}"    ## not the owner's no ##
                if length( $state->{'end_reason'} // '' );
            exit( $status =~ m{^(?:approved|committed)$} ? 0 : 1 );
        }
    }
    ## unknown job : no state file after a short grace -- say so and name ##
    ## the newest jobs of that kind, instead of waiting the full timeout  ##
    if ( not -e $state_path
        and time() > $deadline - $timeout + ( $fast ? 1 : 15 ) ) {
        my ($kind) = $job =~ m{^(p7-(?:sign|commit))-};
        my @recent
            = map { m{/([^/]+)\.json$} ? $1 : () }
            ( sort { -M $a <=> -M $b } glob("$state_dir/$kind-*.json") )
            [ 0 .. 2 ];
        say "$job : unknown job [ no state file ]";
        say "newest : $_" foreach grep {defined} @recent;
        exit 2;
    }
    if ( time() > $deadline ) {
        ## not a result : the job is still running, say so loudly ##
        my $msg = "$job : TIMEOUT after $timeout s "
            . "-- NOT final, last status : $last";
        say $msg;
        say {*STDERR} $msg;
        exit 3;
    }
    ## the pause grows [ x1.2, capped ] -- a long wait polls rarely ##
    select( undef, undef, undef, $pause );
    $pause = $pause * 1.2;
    $pause = $fast ? 0.2 : 5 if $pause > ( $fast ? 0.2 : 5 );
}

