#!/usr/bin/env perl
use v5.32.0;
use strict;
use English;
use warnings;

###                  ###
##  inline-prebuild   ##   [ compile every AMOS7 inline source for one user ]
###                  ###

## shared entry of the zenki start [ v7-zenki.init_code ] and the           ##
## installers [ bin/p7-deps install, bin/p7-install ] : calls               ##
## AMOS7::INLINE::prebuild_all in the foreground, which prunes stale object ##
## dirs after building                                                      ##
##
## inline-prebuild              the invoking user's cache  inline-prebuild
## -user <name> root only : drop to <name> first, then build
## [ the zenki cache is the 'protocol-7' user's ]
##
## as root the cache is always the target's : without -user the root home   ##
## is used, never a HOME inherited from sudo -- no root-owned file may land ##
## in a user cache. exit 0 : built or nothing to do, 1 : a source did not   ##
## build                                                                    ##

use File::Spec;
use POSIX   ();
use Cwd     qw| abs_path |;
use FindBin qw| $RealBin |;

BEGIN {
    unshift @INC,
        abs_path( File::Spec->catdir( $RealBin, ( File::Spec->updir ) x 2 ) )
        . '/data/lib-path/pm';
    ## modules that compile at load : no detached builder each, the build ##
    ## is this process's job                                              ##
    no warnings qw| once |;
    $AMOS7::INLINE::no_detached_build = 1;
}

my $target_user;
my $quiet = 0;
while ( my $arg = shift @ARGV ) {
    if    ( $arg eq '-user' ) { $target_user = shift @ARGV }
    elsif ( $arg eq '-q' )    { $quiet = 1 }
    else { die "unknown argument '$arg' [ -user <name> -q ]\n" }
}

## the account whose cache is built ##
my $account = defined $target_user ? $target_user : scalar getpwuid($UID);
my @passwd  = CORE::getpwnam( $account // '' );
die "no such user : '" . ( $account // '' ) . "'\n" if not @passwd;
my ( $uid, $gid, $home ) = @passwd[ 2, 3, 7 ];
die "user '$account' has no home directory '$home'\n" if not -d $home;

if ( $UID == 0 or $EUID == 0 ) {
    $ENV{'HOME'} = $home;    ## never one inherited from sudo ##
    ## root : drop everything before any file is created ; building for ##
    ## root itself uses its own home, never one inherited from sudo     ##
    if ( $uid != 0 ) {
        $ENV{'USER'} = $ENV{'LOGNAME'} = $account;
        $)           = "$gid $gid"; ## primary group, no supplementary ones ##
        $(           = $gid;
        POSIX::setuid($uid) or die "cannot drop to '$account' : $OS_ERROR\n";
        die "still root after the drop [ refusing ]\n"
            if $UID == 0
            or $EUID == 0
            or POSIX::setuid(0);
    }
} elsif ( $uid != $UID ) {
    die "-user '$account' needs root\n";
}

require AMOS7::INLINE;
my $result = AMOS7::INLINE::prebuild_all();

my $summary
    = defined $result->{'unavailable'}
    ? sprintf( 'nothing built [ %s ]', $result->{'unavailable'} )
    : sprintf( '%s : %d of %d sources built, %d failed, %d old dirs removed',
    $account, @{$result}{qw| built total failed pruned |} );

## the last run, readable later : a detached start [ v7-zenki ] discards ##
## the output. written as the target user, after the drop above          ##
my $log_dir = "$home/.7/inline-code";
if (    -d $log_dir
    and not -l $log_dir
    and open( my $log_fh, '>', "$log_dir/prebuild.log" ) ) {
    printf {$log_fh} "%s inline-prebuild : %s\n", scalar localtime, $summary;
    close $log_fh;
}

say "inline-prebuild : $summary" if not $quiet;
exit 0                           if defined $result->{'unavailable'};
exit( $result->{'failed'} ? 1 : 0 );

