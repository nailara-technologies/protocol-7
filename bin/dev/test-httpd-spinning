#!/bin/bash
# Test if watcher spins by checking for repeated error messages

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

cd /data/projects/protocol-7

echo "========================================="
echo "HTTP Watcher Spinning Test"
echo "========================================="
echo ""

# Test BROKEN version
echo -e "${RED}===[ Testing BROKEN Version ]===${NC}"
cp modules/httpd.handler.download_transfer.test-broken modules/httpd.handler.download_transfer
p7 v7.restart httpd > /dev/null
sleep 2

# Clear log
BEFORE_COUNT=$(p7 httpd.show-buffer zenka 2>/dev/null | wc -l)

echo "Starting download (will abort at 113MB, keep running)..."
curl -s "http://localhost/huge-test-file.bin" > /dev/null &
CURL_PID=$!

echo "Waiting for abort to trigger..."
sleep 6

echo "Letting it run for 5 more seconds to see if watcher spins..."
sleep 5

# Count errors
AFTER_LOG=$(p7 httpd.show-buffer zenka 2>/dev/null)
ABORT_COUNT=$(echo "$AFTER_LOG" | grep -c "TEST-BROKEN" || echo "0")
FH_ERROR_COUNT=$(echo "$AFTER_LOG" | grep -c "filehandle already closed" || echo "0")
TOTAL_LINES=$(echo "$AFTER_LOG" | wc -l)
NEW_LINES=$((TOTAL_LINES - BEFORE_COUNT))

echo ""
echo "Results:"
echo "  Abort messages: $ABORT_COUNT"
echo "  'filehandle already closed' errors: $FH_ERROR_COUNT"
echo "  New log lines: $NEW_LINES"
echo ""

if [ $ABORT_COUNT -gt 1 ] || [ $FH_ERROR_COUNT -gt 3 ]; then
    echo -e "${RED}✗ SPINNING DETECTED!${NC}"
    echo "  Watcher fired multiple times because ->stop didn't destroy it"
    echo ""
    echo "  Recent errors:"
    echo "$AFTER_LOG" | grep "TEST-BROKEN\|filehandle already closed" | tail -10
else
    echo -e "${YELLOW}? No obvious spinning (may need different trigger conditions)${NC}"
fi

kill -9 $CURL_PID 2>/dev/null
wait $CURL_PID 2>/dev/null || true

echo ""
echo ""

# Test FIXED version
echo -e "${GREEN}===[ Testing FIXED Version ]===${NC}"
cp modules/httpd.handler.download_transfer.test modules/httpd.handler.download_transfer
p7 v7.restart httpd > /dev/null
sleep 2

BEFORE_COUNT=$(p7 httpd.show-buffer zenka 2>/dev/null | wc -l)

echo "Starting download (will abort at 113MB, keep running)..."
curl -s "http://localhost/huge-test-file.bin" > /dev/null &
CURL_PID=$!

echo "Waiting for abort to trigger..."
sleep 6

echo "Letting it run for 5 more seconds..."
sleep 5

# Count errors
AFTER_LOG=$(p7 httpd.show-buffer zenka 2>/dev/null)
ABORT_COUNT=$(echo "$AFTER_LOG" | grep -c "aborting download" || echo "0")
FH_ERROR_COUNT=$(echo "$AFTER_LOG" | grep -c "filehandle already closed" || echo "0")
TOTAL_LINES=$(echo "$AFTER_LOG" | wc -l)
NEW_LINES=$((TOTAL_LINES - BEFORE_COUNT))

echo ""
echo "Results:"
echo "  Abort messages: $ABORT_COUNT"
echo "  'filehandle already closed' errors: $FH_ERROR_COUNT"
echo "  New log lines: $NEW_LINES"
echo ""

if [ $ABORT_COUNT -eq 1 ] && [ $FH_ERROR_COUNT -le 2 ]; then
    echo -e "${GREEN}✓ NO SPINNING - Single abort, clean shutdown${NC}"
    echo "  Watcher destroyed with ->cancel"
else
    echo -e "${YELLOW}? Unexpected error count${NC}"
fi

kill -9 $CURL_PID 2>/dev/null
wait $CURL_PID 2>/dev/null || true

echo ""
echo ""
echo "========================================="
echo -e "${YELLOW}Note:${NC} Production spinning may require specific conditions:"
echo "  - High system load"
echo "  - Multiple concurrent transfers"
echo "  - Network glitches during transfer"
echo "  - Race conditions in error handling"
echo ""
echo "The fix (->cancel + cleanup) prevents ALL these scenarios"
echo ""

cp modules/httpd.handler.download_transfer.fixed modules/httpd.handler.download_transfer
p7 v7.restart httpd > /dev/null
echo -e "${GREEN}✓ Production version restored${NC}"

