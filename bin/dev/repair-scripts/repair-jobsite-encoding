#!/usr/bin/perl
## [:< ##

# name  = repair-jobsite-encoding
# descr = repair mojibake in jobsite job YAML files : field-level, safe on mixed files

use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../../data/lib-path/pm";

use YAML::XS ();
use Encode   ();

my $jobs_dir = '/var/protocol-7/jobsite/jobs';
my $dry_run  = grep { $_ eq '--dry-run' } @ARGV;
my @files    = grep { $_ ne '--dry-run' } @ARGV;

## text fields that may contain non-ascii and could be mojibake ##
my @TEXT_FIELDS = qw|
    title company city country industry
    description score_reason score_summary
    |;

## repair mojibake in a single string value, safe on already-correct ##
## strings                                                           ##
sub to_unicode {
    my $s = shift // '';
    unless ( utf8::is_utf8($s) ) {
        return
            eval { Encode::decode( 'UTF-8', $s, Encode::FB_CROAK ) }
            // Encode::decode( 'Latin-1', $s );
    }
    my $cur = $s;
    for ( 1 .. 2 ) {
        my $b     = Encode::encode( 'Latin-1', $cur, Encode::HTMLCREF );
        my $fixed = eval { Encode::decode( 'UTF-8', $b, Encode::FB_CROAK ) };
        last unless defined $fixed;
        $fixed =~ s{&#(\d+);}{chr($1)}ge;
        $cur = $fixed;
        last unless $cur =~ m|[\xC0-\xCF]|;    ## still mojibake?
    }
    return $cur;
}

## if no explicit files given, scan the whole jobs dir ##
if ( not @files ) {
    opendir( my $dh, $jobs_dir ) or die "cannot open $jobs_dir: $!\n";
    @files = map {"$jobs_dir/$_"}
        grep {m|^\d+\.yaml$|} readdir($dh);
    closedir $dh;
}

print ".\n:\n";

my ( $repaired, $skipped, $errors ) = ( 0, 0, 0 );

for my $file ( sort @files ) {
    unless ( -f $file && -r $file ) {
        print ": missing : $file\n";
        $errors++;
        next;
    }

    my $job = eval { YAML::XS::LoadFile($file) };
    if ($@) {
        print ": parse error : $file : $@\n";
        $errors++;
        next;
    }

    my $changed = 0;
    for my $f (@TEXT_FIELDS) {
        next unless defined $job->{$f} and length $job->{$f};
        my $orig         = $job->{$f};
        my $repaired_val = to_unicode($orig);
        if ( $repaired_val ne $orig ) {
            $job->{$f} = $repaired_val;
            $changed++;
        }
    }

    if ($changed) {
        if ($dry_run) {
            print ": would repair ($changed fields) : $file\n";
        } else {
            my $tmp = "$file.repair.tmp";
            eval { YAML::XS::DumpFile( $tmp, $job ) };
            if ($@) {
                print ": write error : $file : $@\n";
                unlink $tmp;
                $errors++;
                next;
            }
            rename $tmp, $file or do {
                print ": rename error : $file : $!\n";
                unlink $tmp;
                $errors++;
                next;
            };
            print ": repaired ($changed fields) : $file\n";
        }
        $repaired++;
    } else {
        $skipped++;
    }
}

printf ":\n:. done : %d repaired, %d clean, %d errors\n",
    $repaired, $skipped, $errors;

