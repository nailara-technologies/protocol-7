#!/usr/bin/env perl
## [:< ##
##
## import-atom-jobs — merge atom node's flat job YAMLs into local status-dir store
##
## usage:
##   bin/dev/import-atom-jobs <atom-jobs-dir>
##   bin/dev/import-atom-jobs /path/to/atom/jobs/flat/*.yaml
##
## atom has a flat layout: /var/protocol-7/jobsite/jobs/<id>.yaml
## local has status-dir layout: jobs/<status>/<id>.yaml
##
## merge rule (highest priority status wins, newest last_modified tiebreaker):
##   applied > interviewed > apply > review > assessed > new > rejected > blocked
##
## fields merged from atom record when atom wins:
##   status, stage, score, score_reason, score_summary, assertions,
##   notes, date_applied, last_modified
##
## usage example:
##   ssh atom "tar czf - /var/protocol-7/jobsite/jobs/" | tar xzf - -C /tmp/atom-jobs/
##   bin/dev/import-atom-jobs /tmp/atom-jobs/var/protocol-7/jobsite/jobs/

use v5.24;
use strict;
use warnings;
use YAML::XS qw| LoadFile DumpFile |;
use File::Basename qw| basename |;
use File::Find qw| find |;
use Cwd qw| abs_path |;

my %PRIORITY = (
    applied     => 8,
    interviewed => 7,
    apply       => 6,
    review      => 5,
    assessed    => 4,
    new         => 3,
    rejected    => 2,
    blocked     => 1,
    deleted     => 0,
);

my $local_jobs = '/var/protocol-7/jobsite/jobs';

die "usage: $0 <atom-jobs-dir>\n" unless @ARGV;
my $atom_dir = abs_path($ARGV[0]) or die "cannot resolve path: $ARGV[0]\n";
die "directory not found: $atom_dir\n" unless -d $atom_dir;

## find all yaml files in atom dir (flat or nested) ##
my @atom_files;
find( sub { push @atom_files, $File::Find::name if /\.yaml$/ }, $atom_dir );
printf "found %d atom job files in %s\n", scalar @atom_files, $atom_dir;

my ( $merged, $skipped, $new_imported ) = (0) x 3;

for my $atom_file ( sort @atom_files ) {
    my $id = basename($atom_file, '.yaml');
    next unless $id =~ /^\d+$/;

    my $atom_job = eval { LoadFile($atom_file) };
    if ($@) { warn "parse error $atom_file: $@\n"; next; }
    next if ref $atom_job ne 'HASH';

    $atom_job->{'id'} //= $id;
    my $atom_status = $atom_job->{'status'} // 'new';
    my $atom_pri    = $PRIORITY{$atom_status} // 0;

    ## find local job across all status dirs ##
    my $local_file;
    my $local_status;
    for my $st ( keys %PRIORITY ) {
        my $candidate;
        if ( $st eq 'blocked' or $st eq 'deleted' ) {
            ## search epoch subdirs ##
            for my $epoch_dir ( glob("$local_jobs/$st/*/") ) {
                my $f = "$epoch_dir/$id.yaml";
                if ( -f $f ) { $candidate = $f; last; }
            }
        } else {
            $candidate = "$local_jobs/$st/$id.yaml";
        }
        if ( defined $candidate and -f $candidate ) {
            $local_file   = $candidate;
            $local_status = $st;
            last;
        }
    }

    if ( not defined $local_file ) {
        ## job not in local store: import from atom ##
        my $target_dir = "$local_jobs/$atom_status";
        mkdir $target_dir unless -d $target_dir;
        my $target = "$target_dir/$id.yaml";
        eval { DumpFile($target, $atom_job) };
        if ($@) { warn "write error $target: $@\n"; next; }
        printf "  imported  %s  [%s]\n", $id, $atom_status;
        $new_imported++;
        next;
    }

    ## local job exists: compare and maybe merge ##
    my $local_job = eval { LoadFile($local_file) };
    if ($@) { warn "parse error $local_file: $@\n"; next; }
    next if ref $local_job ne 'HASH';

    my $local_pri = $PRIORITY{$local_status} // 0;

    my $winner;
    if ( $atom_pri > $local_pri ) {
        $winner = 'atom';
    } elsif ( $local_pri > $atom_pri ) {
        $winner = 'local';
    } else {
        ## same status: newest last_modified wins ##
        my $atom_lm  = $atom_job->{'last_modified'}  // '';
        my $local_lm = $local_job->{'last_modified'} // '';
        $winner = ( $atom_lm ge $local_lm ) ? 'atom' : 'local';
    }

    if ( $winner eq 'local' ) {
        $skipped++;
        next;
    }

    ## atom wins: merge user-decision fields into local record ##
    my @merge_fields = qw|
        status stage score score_reason score_summary assertions
        notes date_applied last_modified
    |;
    for my $f (@merge_fields) {
        $local_job->{$f} = $atom_job->{$f} if exists $atom_job->{$f};
    }

    ## move to correct status dir if status changed ##
    my $new_status = $local_job->{'status'} // $local_status;
    my $target_dir = "$local_jobs/$new_status";
    mkdir $target_dir unless -d $target_dir;
    my $target = "$target_dir/$id.yaml";

    eval { DumpFile($target, $local_job) };
    if ($@) { warn "write error $target: $@\n"; next; }

    ## remove old file if status changed ##
    if ( $local_file ne $target ) {
        unlink $local_file or warn "unlink $local_file: $!\n";
        printf "  moved     %s  [%s → %s]\n", $id, $local_status, $new_status;
    } else {
        printf "  updated   %s  [%s, atom newer]\n", $id, $new_status;
    }
    $merged++;
}

printf "\ndone: %d imported, %d merged (atom won), %d skipped (local wins)\n",
    $new_imported, $merged, $skipped;
printf "run 'p7c jobsite.reload' to rebuild the in-memory index\n";

