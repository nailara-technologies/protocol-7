#!/usr/bin/perl
use v5.32.0;
use utf8;
use strict;
use English;
use warnings;

###          ###
##  p7-vault  ##
###          ###

## personal vault : logins, notes, contacts. standalone on purpose -- needs
## perl, CryptX [ + Crypt::Argon2 on CryptX < 0.088 ] and Term::ReadKey,
## nothing from a running protocol-7. copy this file, AMOS7/Vault.pm +
## AMOS7/NTIME.pm [ as AMOS7/ beside it ] and data/md/design/VAULT-FORMAT.md
## next to every backup.
##
## p7-vault                    interactive : unlock once, then commands
## p7-vault <command> [ args ] one command
##
## secrets are only ever typed at a prompt, never taken from argv.
##
## a full copy needs this file, AMOS7/Vault.pm + AMOS7/NTIME.pm
## [ as AMOS7/ beside it ], plus AMOS7/CHKSUM.pm with its AMOS7 dependencies
## [ the 3-char entry codes ] and AMOS7/TERM/Editor.pm [ the note editor ] --
## the last two only for interactive use, a read-only recovery copy opens
## every vault without them

use FindBin;
use Getopt::Std;
use List::Util  ();
use Time::HiRes ();
use Encode      qw| decode encode |;
use Fcntl       qw| O_WRONLY O_CREAT O_EXCL |;
use POSIX       ();
use File::Spec  ();

BEGIN {
    ## repo layout first, then a backup copy [ AMOS7/ beside the script ] ##
    unshift @INC, "$FindBin::Bin/../data/lib-path/pm", "$FindBin::Bin";
}

use AMOS7::Vault qw|
    vault_init vault_open vault_exists vault_unlock vault_rewrap vault_wraps
    entry_save entry_load entry_versions entries_latest vault_verify
    archive_write archive_open archive_restore file_secret git_blob_id
    gen_password recovery_code_new recovery_code_normalize
    type_fields secret_field ntime_b32 ntime_b32_to_unix version_to_unix
    blob_import blob_import_stream blob_export blob_discard vault_lock
    secret_wipe
    |;

##[ global constants ]##
use constant TRUE  => 5;    ##  TRUE.  ##
use constant FALSE => 0;    ##  false  ##

## sync to a directory : p7-vault stands in for ssh -- '--local-shell <label>
## <command>' runs the command with sh, as ssh would on a host
## [ the same push \ pull code for servers and an external drive ]
if ( @ARGV == 3 and $ARGV[0] eq '--local-shell' ) {
    exec '/bin/sh', '-c', $ARGV[2] or exit 127;
}

binmode STDOUT, ':encoding(UTF-8)';
binmode STDERR, ':encoding(UTF-8)';

## prompts must reach a reader before we block on its answer ##
STDOUT->autoflush(1);

## a hidden prompt can leave the tty with echo off [ raw \ stty -echo ] and
## readline holds its own mode -- hand the terminal back before leaving, also
## from a signal : END restores the cursor style, this the tty mode
sub tty_restore {
    ## readline holds the terminal in its own mode : hand it back first ##
    $main::READLINE->deprep_terminal
        if defined $main::READLINE
        and $main::READLINE->ReadLine eq qw| Term::ReadLine::Gnu |;
    if ( -t STDIN ) {
        if ( defined &Term::ReadKey::ReadMode ) { Term::ReadKey::ReadMode(0) }
        else                                    { system qw| stty echo | }
    }
    return;
}

## ctrl-c : a hidden prompt has echo off -- restore the terminal before
## leaving, '\b\b' takes the echoed '^C' back off the line
$SIG{'INT'} = sub {
    tty_restore();
    print "\b\b  " . ( $main::C{'R'} // '' ) . "\n";
    exit 130;
};

my $CLIP_CLEAR_SECONDS = $ENV{'P7_VAULT_CLIP_SECONDS'} // 45;

## the interactive shell pads every command with an empty line itself ##
my $IN_SHELL = FALSE;

## TRUE once the cursor style or visibility was changed [ END restores it ]
my $CURSOR_CHANGED = FALSE;

## auto-lock : the shell locks after this many seconds without input [ 78 min
## = 13 x 360 s ; P7_VAULT_LOCK_SECONDS, 0 = off ; ':keep-open:' at start-up
## turns it off ]. a lock wipes the key, clears screen, scrollback and
## history, then asks for the passphrase again
my $LOCK_SECONDS
    = ( $ENV{'P7_VAULT_LOCK_SECONDS'} // '' ) =~ m|\A\d+\z|
    ? 0 + $ENV{'P7_VAULT_LOCK_SECONDS'}
    : 4680;
my $KEEP_OPEN = grep { $ARG eq ':keep-open:' } @ARGV;
@ARGV = grep { $ARG ne ':keep-open:' } @ARGV;
my $LAST_INPUT   = time;
my $LOCK_PENDING = FALSE;

## a typed but not entered secret clears itself after this many seconds
## without a key
## [ AMOS7::TERM's password timeout ; P7_VAULT_INPUT_SECONDS, 0 = off ] : the
## stars are taken back, accelerating -- a key during the first rewind keeps
## the value [ once ], the second one is twice as fast
my $INPUT_SECONDS
    = ( $ENV{'P7_VAULT_INPUT_SECONDS'} // '' ) =~ m|\A\d+\z|
    ? 0 + $ENV{'P7_VAULT_INPUT_SECONDS'}
    : 13;

my $dir = $ENV{'P7_VAULT_DIR'} // sprintf qw| %s/.n/vault |,
    $ENV{'HOME'} // ( getpwuid($EUID) )[7];

## colors : on by default, off with -nc [ bin/Protocol-7, ssh.hash-hostkey ]
## or a non-empty NO_COLOR [ no-color.org ], and when STDOUT is not a
## terminal. the palette is %AMOS7::C's, copied -- this script runs without
## AMOS7.pm [ usb copy ]
my $no_colors = grep { $ARG eq '-nc' } @ARGV;
@ARGV = grep { $ARG ne '-nc' } @ARGV;
$no_colors ||= length( $ENV{'NO_COLOR'} // '' ) || !-t STDOUT;

our %C = (
    'T' => "\e[38;2;6;71;195m",     ## labels, field names, titles ##
    '0' => "\e[38;2;68;39;172m",    ## frame characters ##
    'g' => "\e[38;2;71;195;6m",     ## done ##
    'o' => "\e[38;2;197;141;7m",    ## attention ##
    'B' => "\e[1m",
    'R' => "\e[0m",
);

## -nc : blank the palette before any message below can use it ##
my %COLOR_ON = %C;
%C = map { $ARG => '' } keys %C if $no_colors;

## content color [ values, typed input ] : T by default ; '-color green' is ##
## the high contrast option for daylight -- the phosphor green of           ##
## bin/Protocol-7's table [ p7_fg_0003 ]                                    ##
my %CONTENT_COLOR = (
    'blue'  => $COLOR_ON{'T'},
    'green' => "\e[38;2;9;170;94m",
);
my $content_color = qw| blue |;
if ( @ARGV and $ARGV[-1] eq '-color' ) {
    say STDERR $C{o}
        . 'p7-vault : -color needs a name [ '
        . join( ' ', sort keys %CONTENT_COLOR ) . ' ]'
        . $C{R};
    exit 2;
}
foreach my $i ( reverse 0 .. $#ARGV - 1 ) {
    next if $ARGV[$i] ne '-color';
    $content_color = lc $ARGV[ $i + 1 ];
    splice @ARGV, $i, 2;
}
if ( not exists $CONTENT_COLOR{$content_color} ) {
    say STDERR $C{o}
        . "p7-vault : unknown color '$content_color' [ "
        . join( ' ', sort keys %CONTENT_COLOR )
        . ' ] -- using blue'
        . $C{R};
    $content_color = qw| blue |;
}
$C{'V'} = $no_colors ? '' : $CONTENT_COLOR{$content_color};

## options before the command [ getopts stops at the command word, so a   ##
## command's own flags like 'show <filter> -r' are left for the command ] ##
my %option;
{
    local $SIG{'__WARN__'}
        = sub { print STDERR 'p7-vault : ', lcfirst $ARG[0]; exit 2 };
    getopts( qw| d:Rho:k: |, \%option );
}
if ( $option{'h'} or defined $option{'o'} ) {
    die "p7-vault : unknown option '-o$option{'o'}'\n"
        if defined $option{'o'} and $option{'o'} ne qw| ptions |;
    usage();
    exit 0;
}
$dir = $option{'d'} if defined $option{'d'};
my $use_recovery = $option{'R'} ? TRUE : FALSE;
my $key_file     = $option{'k'};    ## -k : passphrase + key file ##

my %COMMANDS = (
    init              => \&cmd_init,
    add               => \&cmd_add,
    list              => \&cmd_list,
    ls                => \&cmd_list,
    show              => \&cmd_show,
    copy              => \&cmd_copy,
    get               => \&cmd_get,
    edit              => \&cmd_edit,
    rm                => \&cmd_rm,
    import            => \&cmd_import,
    export            => \&cmd_export,
    files             => \&cmd_files,
    notes             => \&cmd_notes,
    scratchpad        => \&cmd_scratchpad,
    codes             => \&cmd_codes,
    sync              => \&cmd_sync_hosts,
    history           => \&cmd_history,
    restore           => \&cmd_restore,
    gen               => \&cmd_gen,
    passwd            => \&cmd_passwd,
    verify            => \&cmd_verify,
    archive           => \&cmd_archive,
    'restore-archive' => \&cmd_restore_archive,
    commands          => sub { usage( join ' ', @ARG ) },
);

my $vault;    ## unlocked handle, opened on first need ##

if (@ARGV) {
    my $cmd = shift @ARGV;
    my $sub = $COMMANDS{$cmd} // do { unknown_command($cmd); exit 1 };
    exit( $sub->(@ARGV) ? 0 : 1 );
}

## interactive : one unlock for a whole session ##
die "p7-vault : no terminal [ give a command ]\n" if not -t STDIN;
if ( not vault_exists($dir) ) {
    say msg( 'info', "no vault in %s yet -- 'init' creates one", $dir );
} else {
    unlocked() or exit 1;
}
$IN_SHELL = TRUE;
cursor_shell();
say msg( 'info', 'auto-lock off [ :keep-open: ]' ) if $KEEP_OPEN;
$LAST_INPUT = time;
while (TRUE) {
    auto_lock() if $LOCK_PENDING;
    my $line = prompt_line( 'vault', TRUE );
    if ( not defined $line ) {
        next if $LOCK_PENDING;    ## the idle timer, not an end of input ##
        last;
    }
    my ( $cmd, @args ) = split ' ', $line;
    next if not defined $cmd;
    ## quit \ q \ exit \ x clear the screen ; ctrl-d \ ctrl-c leave it as is
    if ( $cmd =~ m{\A(?:quit|q|exit|x)\z} ) {
        vault_lock($vault) if defined $vault;
        screen_clear();
        exit 0;
    }
    my $sub = $COMMANDS{$cmd};
    if ( not $sub ) {
        unknown_command($cmd);
        next;
    }
    $sub->(@args);
}
vault_lock($vault) if defined $vault;    ## the key wiped on the way out ##
exit 0;

##[ OUTPUT ]##################################################################

## TRUE after a hidden prompt's closing ':' line : the next hidden prompt
## shares it [ new + re-enter ] instead of opening a second frame
my $SECRET_FRAME_OPEN = FALSE;

## one message line : kind 'info' [ T ], 'refuse' [ amber ], 'done' [ green ].
## %s values come out in the content color, '[ .. ]' in the frame color
sub msg {
    my ( $kind, $format, @values ) = @ARG;
    $SECRET_FRAME_OPEN = FALSE;    ## a message ends a ':' prompt frame ##
    my $color = {
        qw| info |   => $C{T},
        qw| refuse | => $C{o},
        qw| done |   => $C{g},
    }->{$kind} // $C{T};

    ## a value returns to the colour around it : the frame colour inside
    ## [ .. ], the message colour outside -- one return colour per %s
    my @back;
    my $depth = 0;
    while ( $format =~ m{(\[|\]|%s)}g ) {
        if    ( $1 eq '[' ) { $depth++ }
        elsif ( $1 eq ']' ) { $depth-- if $depth }
        else                { push @back, $depth ? $C{0} : $color }
    }
    $format =~ s|(\[[^\[\]]*\])|$C{0}$1$color|g;
    my $i = 0;
    my $text
        = @values
        ? sprintf( $format,
        map { $C{V} . $ARG . ( $back[ $i++ ] // $color ) } @values )
        : $format;
    return "  $color$text$C{R}";
}

##[ AUTO-LOCK ]###############################################################

## the idle timer runs in the interactive shell while the vault is unlocked
sub lock_armed {
    return (    $IN_SHELL
            and not $KEEP_OPEN
            and $LOCK_SECONDS > 0
            and defined $vault ) ? TRUE : FALSE;
}

## seconds until the lock, undef when the timer is not armed
sub idle_left {
    return undef if not lock_armed();
    my $left = $LOCK_SECONDS - ( time - $LAST_INPUT );
    return $left > 0 ? $left : 0;
}

## wait for input on STDIN : TRUE when there is some
## [ or the timer is not armed : the read may block ], FALSE when the idle
## time ran out
sub wait_for_input {
    state $select = do { require IO::Select; IO::Select->new( \*STDIN ) };
    while (TRUE) {
        my $left = idle_left() // return TRUE;
        if ( $left <= 0 ) {
            $LOCK_PENDING = TRUE;
            return FALSE;
        }
        return TRUE if $select->can_read($left);
    }
}

## the lock : key wiped, screen + scrollback + command history cleared, then
## the passphrase again -- esc \ ctrl-c \ three wrong tries end the session
## the cursor : an underscore in the shell, none during a hidden input ; the
## terminal's own style back on every way out [ END, INT \ TERM \ HUP ]
sub cursor_shell {
    return if not -t STDOUT;
    print "\e[4 q";    ## steady underline ##
    $CURSOR_CHANGED = TRUE;
    $SIG{$ARG} = sub { tty_restore(); exit 130 }
        foreach qw| INT TERM HUP |;
    return;
}

sub cursor_hide {
    print "\e[?25l" if -t STDOUT;
    $CURSOR_CHANGED = TRUE;
    return;
}
sub cursor_show { print "\e[?25h" if -t STDOUT; return }

END {    ## also a signal's exit wipes the key ##
    vault_lock($vault)    if defined $vault;
    print "\e[?25h\e[0 q" if $CURSOR_CHANGED and -t STDOUT;
}

## screen, scrollback and command history [ typed filters, entry names ]
## cleared : on an auto-lock and on quit \ q \ exit \ x
sub screen_clear {
    eval { $main::READLINE->clear_history } if defined $main::READLINE;
    print "\e[H\e[2J\e[3J"                  if -t STDOUT;
    return;
}

sub auto_lock {
    $LOCK_PENDING = FALSE;
    vault_lock($vault) if defined $vault;
    undef $vault;
    screen_clear();
    ## typed-ahead input never reaches the passphrase prompt
    ## [ it would count as a wrong try ]
    POSIX::tcflush( fileno(STDIN), POSIX::TCIFLUSH() ) if -t STDIN;
    say msg(
        'info',
        'locked after %s without input [ esc \\ ctrl-c ends the session ]',
        $LOCK_SECONDS >= 60
        ? sprintf( '%d min', $LOCK_SECONDS / 60 )
        : "$LOCK_SECONDS s"
    );
    if ( not unlocked() ) {
        print "\e[H\e[2J\e[3J";
        exit 0;
    }
    $LAST_INPUT = time;
    return;
}

##[ USAGE ]###################################################################

## an unknown command searches the usage with what was typed : the matching
## entries, or a refusal -- both with the 'commands' hint
sub unknown_command {
    my $typed = shift // '';
    my @lines = usage_entries( usage_text(), $typed );
    if ( not @lines ) {
        say msg( 'refuse', "unknown command '%s' [ 'commands' lists all ]",
            $typed );
        return FALSE;
    }
    say msg( 'refuse', "unknown command '%s' -- entries holding it :",
        $typed );
    say '';    ## not through print_usage : the shell would drop it ##
    print_usage( join "\n", @lines, '' );
    say msg( 'info', "[ 'commands' for the full list ]" );
    return FALSE;
}

## the entries holding $keyword [ case-insensitive, as base.cmd.commands ] :
## an entry is its 4-space line and the deeper continuation lines below it
sub usage_entries {
    my ( $text, $keyword ) = @ARG;
    my ( @kept, @block );
    my $flush = sub {
        push @kept, @block if grep {m|\Q$keyword\E|i} @block;
        @block = ();
    };
    foreach my $line ( split m|\n|, $text ) {
        if    ( $line =~ m|^ {4}\S| ) { $flush->(); push @block, $line }
        elsif ( @block and $line =~ m|^ {10,}\S| ) { push @block, $line }
        else                                       { $flush->() }
    }
    $flush->();
    return @kept;
}

## [ keyword ] : only the entries holding it, the header line stays
sub usage {
    my $keyword = shift // '';
    my $text    = usage_text();
    if ( length $keyword ) {
        my @kept = usage_entries( $text, $keyword );
        if ( not @kept ) {
            say msg( 'refuse', "no commands matching '%s'", $keyword );
            return FALSE;
        }
        my ($header) = $text =~ m{^(  p7-vault.*)$}m;
        $text = join "\n", '', $header, '', @kept, '';
    }
    print_usage($text);
    return TRUE;
}

sub usage_text {
    my $text = <<"EOF";

  p7-vault [ -d <path> ] [ -R ] [ <command> [ args ] ]

    init                     create a vault [ $dir ]
    add [ login|note|contact ]  new entry, fields prompted
                             [ a tty opens note bodies in the editor ]
    list [ filter ]          titles, urls, user names
    notes [ filter ]         every note : code, title, size, last change
                             [ bodies never shown ]
    import [ <path>... ] [ -t t ]  store files : one blob per content, one
                             'file' entry per file [ directories recurse,
                             symlinks skipped ]. no path : file selector
                             [ -d : select a directory ]
    import -a <dir> [ -x g ]... [ -i ] [ -t t ]
                             archive a whole directory : one tar stream, one
                             blob, one 'file' entry [ -x excludes a glob,
                             repeatable ; unreadable paths refuse the import,
                             -i skips them ; no dedup -- archives are stored
                             as imported ]
    import -u [ -a ] <path>...
                             update an earlier import of the same paths :
                             changed files \\ a changed archive become new
                             VERSIONS of their entries [ history \\ restore
                             reach the old ones ], unchanged ones add
                             nothing, files gone are listed, never deleted
    export <filter> [ dest ] write a stored file back [ mode and mtime
                             restored, owner as root ]. an archive entry
                             extracts its tar into a directory
    export -d <prefix> [ dest dir ]
                             every stored file under a path prefix : one
                             list, one confirm, then each to its recorded
                             path [ or <dest dir> + the relative path ],
                             parents created, nothing overwritten
                             unasked
    files [ filter ]         stored files : code, title, size, origins,
                             last import
    scratchpad               open the 'scratchpad' note in the editor,
                             creating it when missing
    codes                    give a 3-char code to entries lacking one
    sync <host>[:<dir>]|<path>...
                             union of the entry and blob files with other
                             hosts or directories [ a path : '/' './' '~' --
                             an external drive ], one after the other [ never
                             overwrites, never deletes ]. no vault here yet :
                             asks to fetch the target's key file, then pulls
                             everything [ its passphrase opens it ]
    sync [ -a | -r <target>... | -l ]
                             no target : every saved one. -a saves targets,
                             -r removes them, -l lists them [ <vault>/
                             sync-targets, this machine only ]
    show <filter> [ -r ]     one entry, secrets masked [ -r reveals ]
    copy <filter> [ field ]  to the clipboard [ default password ],
                             cleared after $CLIP_CLEAR_SECONDS s
    get <filter> [ field ]   print one value raw [ for pipes ]
    edit <filter>            change fields [ enter keeps a value ]
    rm <filter>              delete [ a new deleted version, history stays
                             -- a file entry leaves its blob : format 1
                             has no gc, sync would bring it back ]
    history <filter>         versions of one entry [ deleted ones too ]
    restore <filter> [ n ]   make an older version current again
                             [ default : the newest not deleted one ]
    gen [ length ] [ classes ]  password [ classes : a A 9 # ]
    passwd [ recovery ]      change the passphrase [ or recovery code ]
    verify                   decrypt every version of every entry
    archive <file> [ -f <key file> ] [ -p ]
                             one file for untrusted copies [ public repo ] :
                             entry count and edit times stay hidden. opens
                             with the recovery code ; -f adds passphrase +
                             key file [ any file, e.g. one version of one
                             file in a git history ], -p the plain passphrase
    restore-archive <file>   into -d : a new vault, or the same one
                             [ adds missing versions, replaces nothing ]
    commands [ keyword ]     this list, only the entries holding the
                             keyword [ interactive : quit \ exit [ q \ x ]
                             end and clear the screen, ctrl-d \ ctrl-c end
                             and keep it ]

    hidden input : tab shows \\ hides the value, ctrl-u clears it,
                   esc \\ ctrl-c cancels ; typed but left without enter,
                   it clears itself after 13 s [ a key during the first,
                   slow rewind keeps it, once -- P7_VAULT_INPUT_SECONDS,
                   0 = off ]

    -s on add \\ edit  ....  note body via the hidden multi-line prompt
                             instead of the editor [ scripts, pipes ]

    -d  .......  vault directory [ default P7_VAULT_DIR or ~/.n/vault ]
    -R  .......  unlock with the recovery code
    -k  .......  unlock with passphrase + key file [ -k <file> ]
    -nc ......  no colors [ also with a non-empty NO_COLOR, or output not a terminal ]
    -color green  values and typed text in phosphor green [ daylight,
                  high contrast ; default : blue ]
    -h  .......  this list [ also -options ]
    :keep-open:  no auto-lock in the shell [ default : locked after 78 min
                 without input -- P7_VAULT_LOCK_SECONDS, 0 = off ]

EOF

    return $text;
}

## names in T, descriptions and continuation lines in the frame color
sub print_usage {
    my $text = shift;
    $text =~ s|\A\n|| if $IN_SHELL;    ## the shell prompt padded already ##

    ## names in T, descriptions and continuation lines in the frame color ##
    foreach my $line ( split m|\n|, $text ) {
        if ( $line =~ m{^(  )(p7-vault.*)$} ) {
            $line = $1 . $C{T} . $2 . $C{R};
        } elsif ( $line =~ m{^(    )(\S.*?)(\s{2,}|\s+:\s+)(\S.*)$} ) {
            $line = "$1$C{T}$2$C{0}$3$4$C{R}";
        } elsif ( $line =~ m|^(\s{10,})(\S.*)$| ) {
            $line = "$1$C{0}$2$C{R}";
        } elsif ( $line =~ m{^(    )(\S.*)$} ) {
            $line = "$1$C{T}$2$C{R}";
        }
        say $line;
    }
    return TRUE;
}

##[ TERMINAL INPUT ]##########################################################

## line editing where a real readline backend exists
## [ gnu : arrows, editing, history ] -- the stub only strips escape
## sequences. history is in memory only and holds command lines alone
## [ add_history below ], never field values
our $READLINE;    ## the readline object, for the ctrl-c handler ##

sub readline_term {
    return undef     if not -t STDIN;
    return $READLINE if defined $READLINE;
    require Term::ReadLine;
    my $term = Term::ReadLine->new(qw| p7-vault |);
    $term->ornaments(0);
    $term->MinLine(undef);    ## no automatic history ##

    ## gnu readline restarts its read after a signal, and perl runs a handler
    ## only between its own ops -- ctrl-c did nothing until enter.  readline
    ## calls this hook on every signal it sees during a read : a perl sub
    ## running there gives the pending handler its turn
    if ( $term->ReadLine eq qw| Term::ReadLine::Gnu | ) {
        $term->Attribs->{'signal_event_hook'} = sub { return 0 };

        ## readline echoes '^C' itself and then returns the cursor to column 0
        ## -- the handler's '\b\b' could no longer reach it
        $term->parse_and_bind('set echo-control-characters off');
    }

    return $READLINE = $term;
}

## $history : the command prompt [ '\n:: vault :: ', an empty line after a
## command -- the padding bin/nshell uses ], the line added to the in-memory
## history
sub prompt_line {
    my $label   = shift;
    my $history = shift // FALSE;
    $SECRET_FRAME_OPEN = FALSE;

    my $line;
    my $rl = readline_term();
    print "\n" if $history;    ## outside the readline prompt : no redraw ##
    if ( defined $rl and $rl->ReadLine ne qw| Term::ReadLine::Stub | ) {
        ## \001 \002 mark the color codes as zero width for readline.  the ##
        ## prompt ends in the input color [ nshell : p7_fg_0004 = T ], so  ##
        ## typed text is not left in the default grey                      ##
        my ( $t, $f, $v )
            = map { length ? "\001$ARG\002" : '' } @C{qw| T 0 V |};
        my $prompt
            = $history ? "${f}:: $t$label$f ::$v " : "  $t$label$f >$v ";
        if ( lock_armed() and $rl->ReadLine eq qw| Term::ReadLine::Gnu | ) {
            ## the callback reader : a select with the idle time left can end
            ## the wait -- a blocking readline keeps reading after a signal
            ## and would lock only at the next key
            my ( $got, $done );
            $rl->CallbackHandlerInstall(
                $prompt,
                sub {
                    ( $got, $done ) = ( shift, TRUE );
                    $rl->callback_handler_remove;
                }
            );
            while ( not $done ) {
                if ( not wait_for_input() ) {
                    $rl->Attribs->{'line_buffer'} = '';  ## typed text goes ##
                    $rl->callback_handler_remove;
                    print "$C{R}\n";
                    return undef;
                }
                $rl->callback_read_char;
                $LAST_INPUT = time;
            }
            $line = $got;
        } else {
            $line = $rl->readline($prompt);
        }
        print $C{R};
        return undef if not defined $line;
    } else {
        print $history
            ? "$C{0}:: $C{T}$label$C{0} ::$C{V} "
            : "  $C{T}$label$C{0} >$C{V} ";
        if ( not wait_for_input() ) {
            print "$C{R}\n";
            return undef;
        }
        $line       = <STDIN>;
        $LAST_INPUT = time;
        print $C{R};
        return undef if not defined $line;
        chomp $line;
    }
    print "\n" if $history and $line =~ m|\S|;

    ## terminal escape sequences : arrow keys in both the csi and the
    ## application cursor form, function keys, a lone escape
    state $escape_seq_re = qr{\e(?:\[[0-9;?]*[ -/]*[@-~]|O[ -~]|.)?};
    $line =~ s|$escape_seq_re||g;
    $line = decode( 'UTF-8', $line );
    $rl->AddHistory($line)
        if $history
        and defined $rl
        and length $line
        and $rl->can('AddHistory');
    return $line;
}

## no-echo input, never logged, never on argv  framed as AMOS7::TERM's ##
## password prompt :  ':' / ': label : ***' / ':'                      ##
sub prompt_secret {
    my $label = shift;
    print "$C{0}:$C{R}\n" if not $SECRET_FRAME_OPEN;
    print "$C{0}: $C{T}$label$C{0} :$C{R} ";
    my $secret = _prompt_secret_read($label);
    print "$C{0}:$C{R}\n";
    $SECRET_FRAME_OPEN = TRUE;
    return $secret;
}

sub _prompt_secret_read {
    my $label = shift;

    return read_secret_raw($label)
        if -t STDIN and eval { require Term::ReadKey; 1 };

    my $line;
    if ( -t STDIN ) {
        system qw| stty -echo |;
        $line = <STDIN>;
        system qw| stty echo |;
    } else {
        $line = <STDIN>;
    }
    print "\n";
    return undef if not defined $line;
    chomp $line;

    ## a masked value cannot be edited : an arrow key inside it is junk the
    ## owner never sees. stripping it silently would store a secret that
    ## differs from the one they think they typed -- ask again instead
    ## [ index, not a regex : a match keeps its own copy of the line ]
    if ( index( $line, "\e" ) >= 0 ) {
        secret_wipe( \$line );
        say $C{o}
            . '  << arrow \ escape keys do not edit '
            . 'a hidden value -- type it again >>'
            . $C{R};
        print "$C{0}: $C{T}$label$C{0} :$C{R} ";
        return _prompt_secret_read($label);
    }
    my $secret = decode( 'UTF-8', $line );
    secret_wipe( \$line );
    return $secret;
}

## hidden input in raw mode, key handling as AMOS7::TERM's password reader [
## backspace \ del \ left arrow delete, other escape sequences dropped, ctrl-u
## clears, ctrl-c \ ctrl-d \ esc cancel ] -- but the value comes back EXACTLY
## as typed : no length limit, no minimum, no xor folding [ TERM folds 64+
## chars, which would store a different site password and derive a different
## vault key than the standalone recovery path ]. returns undef on cancel. raw
## mode : ctrl-c arrives as a byte, not a signal
sub read_secret_raw {
    my $label = shift;

    ## the typed bytes live in ONE buffer, written in place : appending [ .= ]
    ## can move the string and a regex keeps its own copy for the match
    ## variables -- both leave copies no wipe reaches. a full buffer moves to
    ## a doubled one, the old one wiped [ still no length limit ]
    my $bytes = "\0" x 256;
    my $n     = 0;
    Term::ReadKey::ReadMode('raw');
    cursor_hide();    ## no cursor to flicker over the stars ##
    my $cancelled = FALSE;
    my $visible   = FALSE;
    my $timed_out = FALSE;
    my $grace     = TRUE;                  ## one rewind a key can stop ##
    my $last_key  = Time::HiRes::time();

    ## feedback without the length : 1 .. 3 random stars per typed character
    ## [ AMOS7::TERM's idea ], kept per byte so a backspace takes its own
    ## stars back. tab shows the value itself [ checking a long password ]
    my @stars;

    ## the first $n bytes as a copy of their own [ for decode ], wiped by the
    ## caller : a plain substr would leave one in the op's pad target
    my $typed = sub {
        my $raw = $bytes;
        substr( $raw, $n, length($raw) - $n, '' );
        return \$raw;
    };
    my $redraw = sub {
        my $raw = $visible ? $typed->() : undef;
        printf "\r\e[K$C{0}: $C{T}%s$C{0} :$C{V} %s$C{R}", $label,
            $visible
            ? decode( 'UTF-8', ${$raw} )
            : '*' x List::Util::sum0(@stars);
        secret_wipe($raw) if defined $raw;
    };

    ## the stars taken back one by one [ AMOS7::TERM's rewinds ] : $first
    ## seconds for the first one, times $factor for each next. with $stop a
    ## key ends it and is returned, else keys wait in the terminal
    my $rewind = sub {
        my ( $first, $factor, $stop ) = @ARG;
        my $delay = $first;
        foreach my $shown ( reverse 0 .. List::Util::sum0(@stars) - 1 ) {
            printf "\r\e[K$C{0}: $C{T}%s$C{0} :$C{V} %s$C{R}", $label,
                '*' x $shown;
            $delay *= $factor;
            if ($stop) {
                my $key = Term::ReadKey::ReadKey($delay);
                return $key if defined $key;
            } else {
                Time::HiRes::sleep($delay);
            }
        }
        return undef;
    };

    ## an abort : a shown value hidden first, then the fast flat rewind
    my $abort_rewind = sub {
        if ($visible) {
            $visible = FALSE;
            $redraw->();
        }
        $rewind->( 0.007, 1, FALSE );
    };

    ## seconds until the typed value clears itself, undef : no timer
    ## [ off, or nothing typed yet -- an empty prompt holds no secret ]
    my $input_left = sub {
        return undef if not $INPUT_SECONDS or not $n;
        return $INPUT_SECONDS - ( Time::HiRes::time() - $last_key );
    };

    while (TRUE) {
        ## armed : wait at most the idle time left
        ## [ a hidden input never keeps an unlocked vault open past the lock ]
        my $left  = idle_left();
        my $input = $input_left->();
        my $wait  = List::Util::min( grep {defined} $left, $input );
        my $key   = Term::ReadKey::ReadKey(
            defined $wait ? List::Util::max( 0.05, $wait ) : 0 );
        if ( not defined $key and defined $input and $input_left->() <= 0 ) {
            ## typed, not entered, left alone : the slow rewind a key stops
            ## [ once ], then the fast one -- the value cleared and cancelled
            if ($visible) {
                $visible = FALSE;
                $redraw->();
            }
            $key = $grace ? $rewind->( 0.777, 0.84, TRUE ) : undef;
            if ( defined $key ) {    ## back in time : the value stays ##
                $grace = FALSE;
                $redraw->();
            } else {
                $rewind->( 0.3885, 0.84, FALSE ) if not $grace;
                $timed_out = TRUE;
                $cancelled = TRUE;
                last;
            }
        } elsif ( not defined $key and defined $wait ) {
            if ( defined $left and idle_left() <= 0 ) {
                $LOCK_PENDING = TRUE;
                $cancelled    = TRUE;
                last;
            }
            next;    ## woke early : no timer due yet ##
        }
        if ( defined $key ) {
            $LAST_INPUT = time;
            $last_key   = Time::HiRes::time();
        }
        if ( not defined $key or $key eq "\x03" or $key eq "\x04" ) {
            ## ctrl-c \ ctrl-d : the stars go fast and flat
            ## [ AMOS7::TERM's abort ] -- the line shows the value was dropped
            $abort_rewind->() if defined $key;
            $cancelled = TRUE;
            last;
        }
        last if $key eq "\r" or $key eq "\n";

        if ( $key eq "\e" ) {    ## escape sequence or a lone escape ##
            my $next = Term::ReadKey::ReadKey(0.05);
            if ( not defined $next ) {    ## a lone esc : abort, as ctrl-c ##
                $abort_rewind->();
                $cancelled = TRUE;
                last;
            }
            my $seq = $next;
            if ( $next eq '[' ) {
                while ( defined( my $c = Term::ReadKey::ReadKey(0.05) ) ) {
                    $seq .= $c;
                    last if $c =~ m|[@-~]|;
                }
            } elsif ( $next eq 'O' ) {
                $seq .= Term::ReadKey::ReadKey(0.05) // '';
            }
            ## left arrow [ csi + application form ] and del act as backspace
            $key = $seq =~ m{^(?:\[D|OD|\[3~)$} ? "\x7f" : next;
        }

        if ( $key eq "\x7f" or $key eq "\x08" ) {    ## one utf-8 char back ##
            if ($n) {
                my $start = $n - 1;    ## back over continuation bytes ##
                $start--
                    while $start > 0
                    and ( ord( substr( $bytes, $start, 1 ) ) & 0xC0 ) == 0x80;
                splice @stars, $start - $n;
                substr( $bytes, $start, $n - $start, "\0" x ( $n - $start ) );
                $n = $start;
            }
        } elsif ( $key eq "\t" ) {    ## tab : show \ hide ##
            $visible = not $visible;
        } elsif ( $key eq "\x15" ) {    ## ctrl-u : clear, the fast rewind ##
            $rewind->( 0.007, 1.042, FALSE );
            substr( $bytes, 0, $n, "\0" x $n );
            $n     = 0;
            @stars = ();
        } elsif ( ord $key >= 32 ) {
            if ( $n == length $bytes ) {    ## full : a doubled buffer ##
                my $bigger = $bytes . ( "\0" x $n );
                secret_wipe( \$bytes );
                $bytes = $bigger;
                secret_wipe( \$bigger );    ## shared : only its own share ##
            }
            substr( $bytes, $n++, 1, $key );
            ## continuation bytes of a utf-8 character add no stars ##
            push @stars, ( ord($key) & 0xC0 ) == 0x80
                ? 0
                : 1 + ord( AMOS7::Vault::_random_bytes(1) ) % 3;
        }
        $redraw->();
    }

    if ($visible) {    ## the value never stays on screen \ in scrollback ##
        $visible = FALSE;
        $redraw->();
    }
    ## keys typed after a timeout never reach the next prompt in plain text
    POSIX::tcflush( fileno(STDIN), POSIX::TCIFLUSH() ) if $timed_out;
    Term::ReadKey::ReadMode('restore');
    cursor_show();
    print "\n";
    ## inside the prompt's ':' frame, as the prompt line itself ##
    say "$C{0}: $C{o}input timeout -- cleared$C{R}" if $timed_out;
    if ($cancelled) {
        secret_wipe( \$bytes );
        return undef;
    }
    my $raw    = $typed->();
    my $secret = decode( 'UTF-8', ${$raw} );
    secret_wipe($raw);
    secret_wipe( \$bytes );
    return $secret;
}

## multi-line, no echo, ends at a line holding a single '.' ##
sub prompt_secret_lines {
    my $label = shift;
    say msg( 'info', "$label [ end with a line holding only '.' ] :" );
    my @lines;
    print "$C{0}:$C{R}\n";    ## one frame for all lines, numbered ##
    while (TRUE) {
        my $number = sprintf '%2d', 1 + @lines;
        print "$C{0}: $C{T}$number$C{0} :$C{R} ";
        my $line = _prompt_secret_read($number);
        last if not defined $line or $line eq '.';
        push @lines, $line;
    }
    print "$C{0}:$C{R}\n";
    $SECRET_FRAME_OPEN = TRUE;
    return join qq|\n|, @lines;
}

## wipes the given secrets [ scalar refs ] when it goes out of scope : every
## return path of a command, early or not
sub wipe_on_exit { return bless [@ARG], qw| P7Vault::WipeGuard | }
sub P7Vault::WipeGuard::DESTROY { secret_wipe($ARG) foreach @{ $ARG[0] } }

sub confirm {
    my $question = shift;
    my $answer   = prompt_line("$question [ y/N ]") // '';
    return $answer =~ m|^y(es)?$|i ? TRUE : FALSE;
}

##[ VAULT ACCESS ]############################################################

sub unlocked {
    return $vault if defined $vault;

    my ( $handle, $err ) = vault_open($dir);
    if ( not defined $handle ) {
        say STDERR msg( 'refuse', '%s', $err );
        return undef;
    }

    return $vault = unlock_prompt($handle);
}

## three tries at the passphrase [ or with -R the recovery code ]
sub unlock_prompt {
    my $handle = shift;

    my ( $wrap, $label )
        = $use_recovery ? ( qw| recovery |, 'recovery code' )
        : defined $key_file
        ? ( qw| passphrase-file |, 'passphrase [ ' . '+ key file ]' )
        : ( qw| passphrase |, 'vault passphrase' );

    ## each form of the secret in its own variable, each one wiped : a
    ## reassignment would free the previous form unwiped
    foreach my $try ( 1 .. 3 ) {
        my $typed  = prompt_secret($label) // return undef;
        my $phrase = encode( 'UTF-8', $typed );
        secret_wipe( \$typed );
        my $with_file;
        if ( defined $key_file ) {
            $with_file = eval { file_secret( $phrase, $key_file ) };
            if ( not defined $with_file ) {
                secret_wipe( \$phrase );
                print $C{o} . "  << $EVAL_ERROR" . $C{R};
                return undef;
            }
        }
        my $ok = vault_unlock( $handle, $with_file // $phrase, $wrap );
        secret_wipe( \$phrase );
        secret_wipe( \$with_file ) if defined $with_file;
        return $handle             if $ok;
        say msg( 'refuse', "wrong $label" );
    }
    return undef;
}

## pick one entry by filter : exact title first, then substring over title /
## url / username / name. several matches : numbered choice
sub pick {
    my $filter       = shift      // '';
    my $with_deleted = shift      // FALSE;
    my $v            = unlocked() // return undef;

    my ( $list, $errors ) = entries_latest( $v, $with_deleted );
    say STDERR $C{o} . "  << $ARG >>" . $C{R} foreach @{$errors};

    ## an exact 3-char code match wins over every title rule [ codes are
    ## unique among live entries -- a 3-letter title cannot be mistaken for
    ## one, and a code is never taken for a title substring ]
    if ( length $filter == 3 ) {
        my ($by_code)
            = grep { lc( $ARG->{'record'}{'code'} // '' ) eq lc $filter }
            @{$list};
        return $by_code if defined $by_code;
    }

    my @hits = grep { lc( $ARG->{'record'}{'title'} // '' ) eq lc $filter }
        @{$list};
    @hits = grep { matches( $ARG->{'record'}, $filter ) } @{$list}
        if not @hits;

    if ( not @hits ) {
        say msg( 'refuse', "no entry matches '%s'", $filter );
        return undef;
    }
    return $hits[0] if @hits == 1;

    if ( not -t STDIN ) {
        say STDERR msg( 'refuse',
            "'%s' matches %s entries " . "-- be more specific",
            $filter, $ARG )
            for scalar @hits;
        return undef;
    }
    foreach my $n ( 1 .. @hits ) {
        say '  ' . summary_line( $n, $hits[ $n - 1 ]{'record'} );
    }
    my $choice = prompt_line('number') // '';
    return undef if $choice !~ m|^\d+$| or $choice < 1 or $choice > @hits;
    return $hits[ $choice - 1 ];
}

sub matches {
    my ( $record, $filter ) = @ARG;
    return TRUE if not length $filter;
    foreach my $field (qw| title url username name email phone |) {
        return TRUE
            if index( lc( $record->{$field} // '' ), lc $filter ) != -1;
    }
    ## file entries : the recorded paths too, so one file out of an imported
    ## directory is found by its path [ titles are base names ]
    foreach my $origin ( @{ $record->{'origins'} // [] } ) {
        return TRUE
            if index( lc( $origin->{'path'} // '' ), lc $filter ) != -1;
    }
    return FALSE;
}

## $width [ the list ] : the right column is shortened to fit, choice lists
## leave it out and keep the full path
sub summary_line {
    my ( $n, $record, $width ) = @ARG;
    my $type = $record->{'type'} // 'login';
    ## file entries show their latest recorded path : same-named files out of
    ## different directories stay apart in a choice list
    my $who
        = $type eq 'contact' ? join( ' ',
        grep {length} $record->{'phone'} // '',
        $record->{'email'} // '' )
        : $type eq 'file' ? _file_who($record)
        : join( ' ',
        grep {length} $record->{'username'} // '',
        $record->{'url'} // '' );
    if ($width) {    ## '  ' + the fixed columns before it : 48 ##
        my $avail = $width - 48;
        $who = center_ellipse( $who, $avail )
            if $avail >= 5 and length $who > $avail;
    }
    return
        sprintf "$C{0}%3s$C{R} $C{0}%-4s$C{R} "
        . "$C{0}%-7s$C{R} $C{T}%-28s$C{R} $C{V}%s$C{R}", $n,
        $record->{'code'} // '',
        $type,
        $record->{'title'} // '', $who;
}

## the right column of a file entry in a choice list : its latest recorded
## path, archives marked [ with the number of excluded patterns ]
sub _file_who {
    my $record = shift;
    my $who = ( ( $record->{'origins'} // [] )->[-1] // {} )->{'path'} // '';
    if ( ( $record->{'archive'} // '' ) eq qw| tar | ) {
        my @excludes = @{ $record->{'excludes'} // [] };
        my @skipped  = @{ $record->{'skipped'}  // [] };
        $who .= ' [ tar archive';
        $who .= sprintf ' · %d excluded', scalar @excludes if @excludes;
        $who .= sprintf ' · %d skipped',  scalar @skipped  if @skipped;
        $who .= ' ]';
    }
    return $who;
}

##[ COMMANDS ]################################################################

sub cmd_init {
    if ( vault_exists($dir) ) {
        say msg( 'refuse', '%s already holds a vault', $dir );
        return FALSE;
    }
    say msg( 'info', 'new vault in %s', $dir );

    my ( $passphrase, $again, $phrase, $recovery, $typed );
    my $wipe = wipe_on_exit( \$passphrase, \$again, \$phrase, \$recovery,
        \$typed );
    while (TRUE) {
        secret_wipe($ARG) foreach \$passphrase, \$again;    ## a retry ##
        $passphrase = prompt_secret('new vault passphrase') // return FALSE;
        $again      = prompt_secret('re-enter passphrase')  // return FALSE;
        if ( $passphrase ne $again ) {
            say msg( 'refuse', 'passphrases differ, again' );
            next;
        }
        if ( length $passphrase < 12 ) {
            say $C{o}
                . '  << short passphrase : every entry depends on it. '
                . 'several words are easier to remember and much '
                . 'stronger >>'
                . $C{R};
            next if not confirm('keep it anyway');
        }
        last;
    }

    $recovery = recovery_code_new();
    say '';
    say msg( 'info',
              'recovery code -- opens the vault '
            . 'if the passphrase is forgotten.' );
    say msg( 'info', 'write it on paper, keep it away from this machine :' );
    say '';
    say "      $C{B}$C{V}$recovery$C{R}";
    say '';
    $typed = prompt_line("type it back to confirm [ or 'skip' ]") // '';

    if ( $typed eq 'skip' ) {
        say $C{o}
            . '  << no recovery code : a forgotten passphrase '
            . 'loses every entry, with no way back >>'
            . $C{R};
        return FALSE if not confirm('create the vault without one');
        secret_wipe( \$recovery );
        undef $recovery;
    } else {
        while ( recovery_code_normalize($typed) ne
            recovery_code_normalize($recovery) ) {
            say msg( 'refuse', 'does not match' );
            secret_wipe( \$typed );
            $typed = prompt_line('type it back') // return FALSE;
        }
    }
    print "\e[3J\e[2J\e[H" if -t STDOUT;    ## code off screen + scrollback ##

    $phrase = encode( 'UTF-8', $passphrase );
    my $created = vault_init( $dir, $phrase, $recovery );

    ## prove both wraps open, from the file, before anyone relies on them ##
    ## [ the check handles locked again : their keys wiped ]              ##
    my ($check)  = vault_open($dir);
    my $ok       = vault_unlock( $check, $phrase );
    my ($check2) = vault_open($dir);
    $ok = FALSE
        if defined $recovery
        and not vault_unlock( $check2, $recovery, 'recovery' );
    vault_lock($ARG) foreach $check, $check2;
    if ( not $ok ) {
        vault_lock($created);
        say $C{o}
            . '  << the new key file does not open -- do not use it >>'
            . $C{R};
        return FALSE;
    }

    $vault = $created;
    say $C{g} . "  vault created and test-unlocked [ $dir ]" . $C{R};
    return TRUE;
}

sub cmd_add {
    my $secret = grep { $ARG eq '-s' } @ARG ? TRUE : FALSE;
    my @args   = grep { $ARG ne '-s' } @ARG;
    my $type   = shift @args // 'login';
    if (@args) {
        say msg( 'refuse', 'add takes one type [ login note contact ]' );
        return FALSE;
    }
    if ( not type_fields($type) ) {
        say msg( 'refuse', "unknown type '%s' [ " . "login note contact ]",
            $type );
        return FALSE;
    }
    my $v = unlocked() // return FALSE;

    my %record = ( type => $type );
    foreach my $field ( type_fields($type) ) {
        my %opt = ( secret => $secret, title => $record{'title'} );
        ## 'add note' offers 'scratchpad' as the title while no live note
        ## carries it -- one key away from the everyday scratch note
        $opt{'default'} = note_title_default($v)
            if $field eq 'title' and $type eq 'note';
        my $value = ask_field( $field, undef, %opt ) // return FALSE;
        $record{$field} = $value if length $value;
    }
    if ( not length( $record{'title'} // '' ) ) {
        say msg( 'refuse', 'a title is needed' );
        return FALSE;
    }
    entry_save( $v, undef, \%record );
    say $C{g} . "  stored '$record{'title'}'" . $C{R};
    return TRUE;
}

## 'scratchpad' as a default title for a new note, only while no live note
## carries that title [ case-insensitive ]
sub note_title_default {
    my $v       = shift;
    my ($list)  = entries_latest($v);
    my ($taken) = grep {
                lc( $ARG->{'record'}{'type'}  // '' ) eq qw| note |
            and lc( $ARG->{'record'}{'title'} // '' ) eq qw| scratchpad |
    } @{$list};
    return $taken ? undef : qw| scratchpad |;
}

## one field. $current undef : new entry. %opt :  default -- offered on empty
## input when there is no current value secret  -- the note body uses the
## hidden multi-line prompt even on a tty [ the -s flag ]  title   -- the
## entry's title, for the editor frame  returns the new value [ '' = none ] or
## undef on cancel [ end of input ]
sub ask_field {
    my ( $field, $current, %opt ) = @ARG;
    my $has = defined $current && length $current;

    if ( $field eq 'password' ) {
        my $default = $has ? 'k' : 'g';
        my $choice
            = prompt_line( sprintf 'password : %sn(ew) / g(enerate) [%s]',
            $has ? 'k(eep) / ' : '', $default ) // return undef;
        $choice = $default if not length $choice;
        return $current    if $choice =~ m|^k|i and $has;
        if ( $choice =~ m|^g|i ) {
            my $length = prompt_line('length [24]') // return undef;
            $length = 24 if $length !~ m|^\d+$| or $length < 4;
            say msg( 'done', 'generated' );
            return gen_password($length);
        }
        while (TRUE) {
            my $new = prompt_secret('password') // return undef;
            return $current // '' if not length $new;
            my $again = prompt_secret('re-enter') // return undef;
            my $same  = $new eq $again;
            secret_wipe( \$again );    ## the entry keeps $new, not this ##
            return $new if $same;
            say msg( 'refuse', 'differs, again' );
        }
    }

    if ( $field eq 'body' ) {
        ## a tty edits the body in the shared terminal editor ; -s and pipes
        ## keep the old hidden prompt, exactly as before
        if ( -t STDIN and -t STDOUT and not $opt{'secret'} ) {
            my $edited = note_editor(
                {   text   => $has ? $current : '',
                    title  => $opt{'title'} // 'note',
                    label  => 'note body',
                    colors => \%C,
                }
            );
            return undef if not defined $edited;    ## editor aborted ##
            return $edited;
        }
        if ($has) {
            my $choice = prompt_line('body : k(eep) / r(eplace) [k]')
                // return undef;
            return $current if $choice !~ m|^r|i;
        }
        return prompt_secret_lines('body');
    }

    if ( secret_field($field) ) {
        my $new = prompt_secret( $has ? "$field [ enter keeps ]" : $field )
            // return undef;
        return $has && !length $new ? $current : $new;
    }

    my $default = $has ? undef : $opt{'default'};
    my $label
        = $has             ? "$field [$current] [ - clears ]"
        : defined $default ? "$field [$default]"
        :                    $field;
    my $new = prompt_line($label) // return undef;
    return ''       if $new eq '-';
    return $current if $has         and !length $new;
    return $default if !length $new and defined $default;
    return $new;
}

## the shared editor, loaded only when a note body is edited on a tty --
## nothing else in this script needs Term::ReadKey beyond what it needed
sub note_editor {
    my $params = shift;
    state $have_editor = eval { require AMOS7::TERM::Editor; 1 };
    die "p7-vault : AMOS7/TERM/Editor.pm not found -- copy it next "
        . "to this script [ see data/md/design/VAULT-FORMAT.md ]\n"
        if not $have_editor;
    my $edited = AMOS7::TERM::Editor::edit_text($params);
    $LAST_INPUT = time;    ## editing is input : the editor has no timer ##
    ## the editor leaves its full-screen frame on screen                 ##
    ## [ the exit never scrolls ] -- clear it the way bin/todo's details ##
    ## editor does [ keep in step ] so the feedback starts on a clean    ##
    ## screen ; the abort path already cleared the screen itself         ##
    print "\e[H\e[2J" if defined $edited and -t STDOUT;
    return $edited;
}

sub cmd_list {
    my $filter = join ' ', @ARG;
    my $v      = unlocked() // return FALSE;
    my ( $list, $errors ) = entries_latest($v);
    say STDERR $C{o} . "  << $ARG >>" . $C{R} foreach @{$errors};

    ## framed like files \ notes : header, rows, count footer ##
    my $width   = list_width();
    my @entries = grep { matches( $ARG->{'record'}, $filter ) } @{$list};
    say '' if not $IN_SHELL;    ## the shell prompt padded already ##
    say notes_rule( $width, ' .:[ entries ]:. ', TRUE );
    say '';
    my $n = 0;
    say '  ' . summary_line( ++$n, $ARG->{'record'}, $width )
        foreach @entries;
    say '  ' . $C{0} . '[ no entries ]' . $C{R} if not $n;
    say '';
    say notes_rule( $width,
        sprintf( ' [ %d entr%s ] ', $n, $n == 1 ? 'y' : 'ies' ), FALSE );
    return TRUE;
}

sub cmd_show {
    my @args   = @ARG;
    my $reveal = grep { $ARG eq '-r' } @args;
    my $entry = pick( join ' ', grep { $ARG ne '-r' } @args ) // return FALSE;
    my $record = $entry->{'record'};
    my $type   = $record->{'type'} // 'login';

    say '' if not $IN_SHELL;    ## the shell prompt padded already ##
    foreach my $field ( 'type', 'code', type_fields($type) ) {
        my $value = $record->{$field};
        next if not defined $value or ref $value or not length $value;
        if ( secret_field($field) and not $reveal ) {
            $value = '*' x 8;
        }
        $value =~ s|\n|\n               |g;
        say sprintf "  $C{T}%-12s$C{R} $C{V}%s$C{R}", $field, $value;
    }
    say sprintf "  $C{T}%-12s$C{R} " . "$C{V}%s " . $C{0} . '[ %s ]' . $C{R},
        'updated',
        scalar localtime( ntime_b32_to_unix( $record->{'updated'} ) // 0 ),
        $record->{'updated'} // '';
    say '';
    return TRUE;
}

sub cmd_get {
    my $field = @ARG > 1 ? pop @ARG : 'password';
    my $entry = pick( join ' ', @ARG ) // return FALSE;
    my $value = $entry->{'record'}{$field};
    if ( not defined $value ) {
        say STDERR msg( 'refuse', "no field '%s'", $field );
        return FALSE;
    }
    print $value;
    print "\n" if -t STDOUT;
    return TRUE;
}

sub cmd_copy {
    my $field = @ARG > 1 ? pop @ARG : 'password';
    my $entry = pick( join ' ', @ARG ) // return FALSE;
    my $value = $entry->{'record'}{$field};
    if ( not defined $value or not length $value ) {
        say msg( 'refuse', "no field '%s'", $field );
        return FALSE;
    }

    my $tool = clipboard_tool() // do {
        say msg( 'refuse',
            'no clipboard tool [ wl-copy, ' . 'xsel, xclip, clip.exe ]' );
        return FALSE;
    };
    clipboard_set( $tool, $value ) or do {
        say msg( 'refuse', '%s failed', $tool->[0] );
        return FALSE;
    };
    say $C{g}
        . "  $field copied [ cleared in $CLIP_CLEAR_SECONDS s ]"
        . $C{R};
    say $C{o}
        . '  << windows clipboard history [ '
        . 'win+v ] keeps a copy, if enabled >>'
        . $C{R}
        if on_wsl();
    clipboard_clear_later( $tool, $value );
    return TRUE;
}

sub cmd_edit {
    my $secret = grep { $ARG eq '-s' } @ARG ? TRUE : FALSE;
    my @args   = grep { $ARG ne '-s' } @ARG;
    my $entry  = pick( join ' ', @args ) // return FALSE;
    my $v      = unlocked()              // return FALSE;
    my %record = %{ $entry->{'record'} };
    delete $record{'updated'};

    foreach my $field ( type_fields( $record{'type'} // 'login' ) ) {
        my $value = ask_field(
            $field, $record{$field},
            secret => $secret,
            title  => $record{'title'}
        ) // return FALSE;
        if ( length $value ) { $record{$field} = $value }
        else                 { delete $record{$field} }
    }
    entry_save( $v, $entry->{'id'}, \%record );
    say $C{g}
        . "  stored '$record{'title'}' [ the old version stays in history ]"
        . $C{R};
    return TRUE;
}

sub cmd_rm {
    my $entry = pick( join ' ', @ARG )      // return FALSE;
    my $v     = unlocked()                  // return FALSE;
    my $title = $entry->{'record'}{'title'} // '';
    return FALSE if not confirm("delete '$title'");

    my %record = ( %{ $entry->{'record'} }, deleted => 1 );
    delete $record{'updated'};
    entry_save( $v, $entry->{'id'}, \%record );
    say $C{g}
        . "  '$title' deleted [ older versions stay readable in history ]"
        . $C{R};
    return TRUE;
}

##[ FILES ]###################################################################

## import paths into the vault : one blob per file content, one 'file' entry
## per file. directories recurse, symlinks and non-files are skipped with a
## note. -t sets the title and takes a single file
sub cmd_import {
    my ( $title_opt, $pick_dir, $archive_dir, $skip_unreadable, $update )
        = ( undef, FALSE, undef, FALSE, FALSE );
    my ( @excludes, @paths );
    while (@ARG) {
        my $arg = shift @ARG;
        if    ( $arg eq '-t' ) { $title_opt   = shift @ARG // '' }
        elsif ( $arg eq '-d' ) { $pick_dir    = TRUE }
        elsif ( $arg eq '-a' ) { $archive_dir = shift @ARG // '' }
        elsif ( $arg eq '-x' ) { push @excludes, shift @ARG // '' }
        elsif ( $arg eq '-i' ) { $skip_unreadable = TRUE }
        elsif ( $arg eq '-u' ) { $update          = TRUE }
        else                   { push @paths, $arg }
    }

    ## archive mode : one directory, one tar stream, one blob, one entry ##
    if ( defined $archive_dir ) {
        if ( @paths or $pick_dir ) {
            say msg( 'refuse', '-a takes one directory' );
            return FALSE;
        }
        if ( not length $archive_dir ) {
            say msg( 'refuse', '-a needs a directory' );
            return FALSE;
        }
        if ( defined $title_opt and not length $title_opt ) {
            say msg( 'refuse', '-t takes one title' );
            return FALSE;
        }
        if ( not -d $archive_dir ) {
            say msg( 'refuse', '%s is not a directory', $archive_dir );
            return FALSE;
        }
        ## unreadable paths found before the passphrase and before a blob ##
        ## is written : refused, or skipped with -i                       ##
        my @unreadable = _archive_unreadable( $archive_dir, \@excludes );
        if (@unreadable) {
            say msg(
                $skip_unreadable ? 'info' : 'refuse',
                '%s path%s not readable%s',
                scalar @unreadable,
                @unreadable == 1 ? ''                   : 's',
                $skip_unreadable ? ' -- skipped [ -i ]' : ''
            );
            say msg( 'info', '  %s', $ARG )
                foreach @unreadable[ 0 .. List::Util::min( 12, $#unreadable )
                ];
            say msg( 'info', '  .. %s more', @unreadable - 13 )
                if @unreadable > 13;
            if ( not $skip_unreadable ) {
                say msg( 'info',
                    'nothing stored [ -x <glob> excludes, -i skips them ]' );
                return FALSE;
            }
        }
        my $v = unlocked() // return FALSE;
        return _import_archive( $v, $archive_dir, \@excludes, $title_opt,
            \@unreadable, $update );
    }
    if (@excludes) {
        say msg( 'refuse', '-x is only valid with -a' );
        return FALSE;
    }

    ## no path : the file selector [ -d : a directory ], one import per pick,
    ## then 'another?' -- until something more native exists
    if ( not @paths ) {
        if ($update) {
            say msg( 'refuse', '-u needs the paths to update' );
            return FALSE;
        }
        my $picked = select_import_path($pick_dir);
        if ( not defined $picked ) {
            say msg( 'info',
                      'import <path>... [ -t <title> : single '
                    . 'file only ] [ -d : select a directory ]' );
            return FALSE;
        }
        while ( defined $picked ) {
            cmd_import( defined $title_opt ? ( '-t', $title_opt ) : (),
                $picked );
            undef $title_opt;    ## a title belongs to the first pick ##
            last if not confirm('import another');
            $picked = select_import_path($pick_dir);
        }
        return TRUE;
    }
    if ( defined $title_opt and ( not length $title_opt or @paths != 1 ) ) {
        say msg( 'refuse', '-t takes one title for a single file' );
        return FALSE;
    }

    my @files = _import_collect(@paths);
    if ( not @files ) {
        say msg( 'refuse', 'nothing to import' );
        return FALSE;
    }

    my $v    = unlocked() // return FALSE;
    my $host = ( POSIX::uname() )[1];
    my ( $failed, $unchanged ) = ( 0, 0 );
    foreach my $file (@files) {
        my $had = _blob_count($dir);
        my $done
            = eval { _import_one( $v, $file, $host, $title_opt, $update ) };
        if ( not $done ) {
            say STDERR msg( 'refuse', '%s',
                $EVAL_ERROR || "cannot import $file" );
            $failed++;
            next;
        }
        my $state = $done->{'state'} // (
            _blob_count($dir) > $had ? qw| stored | : qw| deduplicated | );
        if ( $state eq qw| unchanged | and @files > 1 ) {    ## counted ##
            $unchanged++;
            next;
        }
        say msg(
            $state =~ m{\A(?:stored|a new version)\z}
            ? qw| done |
            : qw| info |,
            "%s '%s' [ %s bytes ] %s",
            @{$done}{qw| code title |},
            $done->{'size'},
            $state
        );
    }
    if ($update) {
        say msg(
            'info',     '%s file%s unchanged',
            $unchanged, $unchanged == 1 ? '' : 's'
        ) if $unchanged;
        _import_report_gone( $v, $host, grep {-d} @paths );
    }
    return $failed ? FALSE : TRUE;
}

## -u on a directory : the stored files of this host recorded under it that
## are no longer there -- listed, nothing deleted [ entries are history ]
sub _import_report_gone {
    my ( $v, $host, @dirs ) = @ARG;
    return if not @dirs;
    my @prefixes = map { File::Spec->rel2abs($ARG) =~ s|/+\z||r } @dirs;
    my ($list) = entries_latest($v);
    my @gone;
    foreach my $entry ( @{$list} ) {
        my $record = $entry->{'record'};
        next if lc( $record->{'type'}  // '' ) ne qw| file |;
        next if ( $record->{'archive'} // '' ) eq qw| tar |;
        foreach my $origin ( @{ $record->{'origins'} // [] } ) {
            my $path = $origin->{'path'} // '';
            next if ( $origin->{'host'} // '' ) ne $host or -e $path;
            push @gone, $path
                if grep { index( $path, "$ARG/" ) == 0 } @prefixes;
        }
    }
    return if not @gone;
    say msg( 'info', '%s stored file%s no longer there [ nothing deleted ] :',
        scalar @gone, @gone == 1 ? '' : 's' );
    say msg( 'info', '  %s', $ARG ) foreach sort @gone;
    return;
}

sub _blob_count {
    my $blobs = shift . '/blobs';
    return 0 if not -d $blobs;
    opendir( my $dh, $blobs ) or return 0;
    my $count = grep { not m|^\.| and -f "$blobs/$_" } readdir $dh;
    closedir $dh;
    return $count;
}

## directories recurse, one regular file after the other ; symlinks and other
## non-files are skipped with a note
sub _import_collect {
    my @out;
    foreach my $path (@_) {
        if ( -l $path ) {
            say STDERR msg( 'info', 'skipping symlink %s', $path );
            next;
        }
        if ( -d $path ) {
            opendir( my $dh, $path ) or do {
                say STDERR msg( 'refuse', 'cannot read %s', $path );
                next;
            };
            my @sub = map {"$path/$_"}
                sort grep { $_ ne '.' and $_ ne '..' } readdir $dh;
            closedir $dh;
            push @out, _import_collect(@sub);
        } elsif ( -f $path ) {
            push @out, $path;
        } else {
            say STDERR msg( 'info',
                'skipping %s [ not a regular file ]', $path );
        }
    }
    return @out;
}

## one file : the blob, then the entry. an existing live 'file' entry of the
## same blob gains the new origin [ one new version ] when this host+path is
## new ; else a new entry. returns { code, title, size }
sub _import_one {
    my ( $v, $file, $host, $title_opt, $update ) = @ARG;

    my @st = stat $file or die "cannot stat $file : $OS_ERROR\n";
    my ( $name, $size ) = blob_import( $v, $file );

    my $abs = File::Spec->rel2abs($file);
    my $title
        = defined $title_opt
        ? $title_opt
        : ( File::Spec->splitpath($abs) )[2];
    my %origin = (
        host     => $host,
        path     => $abs,
        mode     => $st[2] & 07777,
        uid      => $st[4],
        gid      => $st[5],
        user     => scalar getpwuid( $st[4] ) // $st[4],
        mtime    => int $st[9],
        imported => ntime_b32( AMOS7::Vault::ntime_now() ),
    );

    ## -u : the entry recording this host + path follows the file -- the same
    ## content is unchanged, new content its next version
    ## [ history keeps the old one ] ; when the old content is stored for
    ## other paths too, only this path moves on
    ## [ to the entry of the new content ]
    if ($update) {
        my ($listed) = entries_latest($v);
        my $here = sub {
            return
                grep { $ARG->{'host'} eq $host and $ARG->{'path'} eq $abs }
                @{ shift->{'origins'} // [] };
        };
        my ($mine) = sort { $b->{'version'} cmp $a->{'version'} } grep {
                    lc( $ARG->{'record'}{'type'}  // '' ) eq qw| file |
                and ( $ARG->{'record'}{'archive'} // '' ) ne qw| tar |
                and $here->( $ARG->{'record'} )
        } @{$listed};
        if ($mine) {
            my %old      = %{ $mine->{'record'} };
            my ($loaded) = entry_load( $v, $mine->{'id'} );
            my %result   = (
                code  => ( $loaded // {} )->{'code'} // '',
                title => $old{'title'}               // '',
                size  => $size,
            );
            return { %result, state => qw| unchanged | }
                if ( $old{'blob'} // '' ) eq $name;
            my @others = grep {
                not( $ARG->{'host'} eq $host and $ARG->{'path'} eq $abs )
            } @{ $old{'origins'} // [] };
            delete $old{'updated'};
            if ( not @others ) {
                @old{qw| blob size origins |}
                    = ( $name, $size, [ \%origin ] );
                entry_save( $v, $mine->{'id'}, \%old );
                return { %result, state => 'a new version' };
            }
            $old{'origins'} = \@others;
            entry_save( $v, $mine->{'id'}, \%old );
        }
    }

    my ($list)  = entries_latest($v);
    my ($entry) = grep {
        lc( $ARG->{'record'}{'type'} // '' ) eq qw| file |
            and ( $ARG->{'record'}{'blob'} // '' ) eq $name
    } @{$list};

    my ( %record, $id );
    if ($entry) {
        %record = %{ $entry->{'record'} };
        $id     = $entry->{'id'};
        my $origins = $record{'origins'} // [];
        my $recorded
            = grep { $ARG->{'host'} eq $host and $ARG->{'path'} eq $abs }
            @{$origins};
        if ( not $recorded ) {
            push @{$origins}, \%origin;
            $record{'origins'} = $origins;
            delete $record{'updated'};
            entry_save( $v, $id, \%record );
        }
    } else {
        %record = (
            type    => qw| file |,
            title   => $title,
            blob    => $name,
            size    => $size,
            origins => [ \%origin ],
        );
        $id = entry_save( $v, undef, \%record );
    }

    my ($saved) = entry_load( $v, $id );
    return {
        code  => $saved->{'code'} // '',
        title => $record{'title'} // '',
        size  => $size,
    };
}

## a directory as tar sees it : ( parent, base )
## [ trailing slashes dropped, so 'dir/' archives as 'dir' too ], empty when
## it is no directory
sub _archive_split {
    my $dir = shift // '';
    return () if not -d $dir;
    $dir =~ s|(?<=.)/+\z||;
    my $base   = $dir =~ m|\A.*/([^/]+)\z| ? $1                       : $dir;
    my $parent = $dir =~ m|\A(.*)/[^/]+\z| ? ( length $1 ? $1 : '/' ) : '.';
    return ( $parent, $base );
}

## the member names [ 'base/sub/file' ] tar could not read : files without
## read permission, directories without read or search permission
## [ not descended ]. -x globs are honoured the way tar matches them by
## default : '*' crosses '/', a glob matches the whole name or any part after
## a '/' [ bracket classes are taken literally here ]. symlinks are archived
## as links and need no read permission
sub _archive_unreadable {
    my ( $dir, $excludes ) = @ARG;
    no warnings qw| once |;    ## File::Find globals, loaded at run time ##
    my ( $parent, $base ) = _archive_split($dir) or return ();
    my $root  = $parent eq '.' ? $base : "$parent/$base";
    my @globs = map {
        my $re = join '',
            map { $ARG eq '*' ? '.*' : $ARG eq '?' ? '.' : quotemeta $ARG }
            split //, $ARG;
        qr{(?:\A|/)$re(?:/|\z)};
    } grep {length} @{$excludes};

    require File::Find;
    my @unreadable;
    File::Find::find(
        {   no_chdir => 1,
            wanted   => sub {
                my $path   = $File::Find::name;
                my $member = $base . substr( $path, length $root );
                if ( grep { $member =~ $ARG } @globs ) {
                    $File::Find::prune = 1 if -d $path;
                    return;
                }
                return if -l $path;
                if ( -d _ ) {
                    if ( not -r _ or not -x _ ) {
                        push @unreadable, $member;
                        $File::Find::prune = 1;
                    }
                } elsif ( not -r _ ) {
                    push @unreadable, $member;
                }
            },
        },
        $root
    );
    return sort @unreadable;
}

## import -a : pipe 'tar -C <parent> -cf - [ --exclude=<glob> ]... -- <base>'
## [ list form, no shell ] into blob_import_stream : the tar bytes land in one
## randomly-named blob, one 'file' entry with archive => 'tar' records it. tar
## exit 1 [ 'file changed as we read it' ] is a warning, the entry stays ;
## exit >= 2 aborts with NO entry -- the blob already written is discarded
## [ unreferenced, never synced ]
sub _import_archive {
    my ( $v, $dir, $excludes, $title_opt, $skipped, $update ) = @ARG;
    $skipped //= [];

    my ( $parent, $base ) = _archive_split($dir) or do {
        say msg( 'refuse', '%s is not a directory', $dir );
        return FALSE;
    };
    $dir = $parent eq '.' ? $base : "$parent/$base";

    my @tar = ( qw| tar -C |, $parent, qw| -cf - | );
    push @tar, map {"--exclude=$ARG"} @{$excludes};
    ## skipped paths : exact member names, no glob meaning ##
    push @tar, qw| --anchored --no-wildcards |,
        ( map {"--exclude=$ARG"} @{$skipped} ),
        qw| --wildcards --no-anchored |
        if @{$skipped};
    push @tar, '--', $base;
    my $errors = tool_stderr_begin();
    my $opened = open( my $stream, '-|', @tar );
    tool_stderr_end($errors);
    if ( not $opened ) {
        say msg( 'refuse', 'cannot run tar : %s', $OS_ERROR );
        return FALSE;
    }
    binmode $stream;
    my ( $name, $size, $content ) = blob_import_stream( $v, $stream );
    close $stream;
    my $tar_exit = $? >> 8;
    tool_stderr_print( $errors, qw| tar | );
    if ( $tar_exit >= 2 ) {
        ## the stream's blob is this run's, unreferenced and never synced :
        ## removed now [ format 1 has no gc -- it would travel otherwise ]
        my $gone = blob_discard( $v, $name );
        say msg(
            'refuse',
            "tar failed [ exit $tar_exit ] -- no entry saved%s",
            $gone
            ? ''
            : sprintf( ' [ blob %s could not be removed ]', $name )
        );
        return FALSE;
    }
    say STDERR msg( 'info',
              'tar : file changed as we read it [ '
            . 'the archive holds the older bytes ]' )
        if $tar_exit == 1;

    my @st     = stat $dir or die "cannot stat $dir : $OS_ERROR\n";
    my %record = (
        type    => qw| file |,
        title   => defined $title_opt ? $title_opt : $base,
        archive => qw| tar |,
        blob    => $name,
        size    => $size,
        origins => [
            {   host     => ( POSIX::uname() )[1],
                path     => File::Spec->rel2abs($dir),
                mode     => $st[2] & 07777,
                uid      => $st[4],
                gid      => $st[5],
                user     => scalar getpwuid( $st[4] ) // $st[4],
                mtime    => int $st[9],
                imported => ntime_b32( AMOS7::Vault::ntime_now() ),
            }
        ],
    );
    $record{'excludes'} = [ @{$excludes} ] if @{$excludes};
    $record{'skipped'}  = [ @{$skipped} ]  if @{$skipped};
    $record{'content'}  = $content;    ## keyed content id [ -u compares ] ##

    ## -u : a new VERSION of the archive entry of this host + directory
    ## [ history \ restore reach the earlier ones ] ; the same content adds
    ## nothing [ the new blob discarded ]
    my $previous
        = $update
        ? _archive_previous( $v, $record{'origins'}[0] )
        : undef;
    if ($previous) {
        my $old      = $previous->{'record'};
        my ($loaded) = entry_load( $v, $previous->{'id'} );
        my $old_code = ( $loaded // {} )->{'code'} // '';
        if (    ( $old->{'content'} // '' ) eq $content
            and "@{ $old->{'excludes'} // [] }" eq "@{$excludes}"
            and "@{ $old->{'skipped'} // [] }" eq "@{$skipped}" ) {
            blob_discard( $v, $name );
            say msg( 'info', "%s '%s' unchanged -- no new version",
                $old_code, $old->{'title'} // '' );
            return TRUE;
        }
        my $origin = $record{'origins'}[0];
        my %new    = ( %{$old}, %record );
        $new{'title'}   = $old->{'title'} if not defined $title_opt;
        $new{'origins'} = [
            (   grep {
                    not(    $ARG->{'host'} eq $origin->{'host'}
                        and $ARG->{'path'} eq $origin->{'path'} )
                } @{ $old->{'origins'} // [] }
            ),
            $origin
        ];
        delete $new{$ARG}
            foreach grep { not exists $record{$ARG} } qw| excludes skipped |;
        delete $new{'updated'};
        entry_save( $v, $previous->{'id'}, \%new );
        say msg( 'done',
            "%s '%s' [ %s bytes ] -- a new version [ history %s ]",
            $old_code, $new{'title'}, $size, $old_code );
        return TRUE;
    }
    say msg(
        'info',
        'no earlier archive of %s here -- a new entry',
        $record{'origins'}[0]{'path'}
    ) if $update;

    my $id = entry_save( $v, undef, \%record );
    my ($saved) = entry_load( $v, $id );
    say msg(
        'done',
        "%s '%s' [ %s bytes ] stored",
        $saved->{'code'} // '',
        $record{'title'}, $size
    );
    return TRUE;
}

## the live archive entry holding this host + directory as an origin
## [ the newest version when several do ], or undef
sub _archive_previous {
    my ( $v, $origin ) = @ARG;
    my ($list) = entries_latest($v);
    my @hits = sort { $b->{'version'} cmp $a->{'version'} } grep {
        my $record = $ARG->{'record'};
        lc( $record->{'type'} // '' ) eq qw| file |
            and ( $record->{'archive'} // '' ) eq qw| tar |
            and not $record->{'deleted'}
            and grep {
                    ( $ARG->{'host'} // '' ) eq $origin->{'host'}
                and ( $ARG->{'path'} // '' ) eq $origin->{'path'}
            } @{ $record->{'origins'} // [] }
    } @{$list};
    return $hits[0];
}

## write a stored file back. no dest : the recorded path of this host is the
## prompt default [ else the most recent origin of any host ]. never
## overwrites without a confirm ; mode and mtime are restored, the owner only
## as root [ a note when it differs and we cannot ]
sub cmd_export {
    my @args = @ARG;
    ## export -d <prefix> [ dest dir ] : every stored file under a prefix ##
    return cmd_export_prefix( splice( @args, 1 ) )
        if @args and $args[0] eq '-d';

    my $dest   = @args > 1 ? pop @args : undef;
    my $entry  = pick( join ' ', @args ) // return FALSE;
    my $record = $entry->{'record'};
    if ( lc( $record->{'type'} // '' ) ne qw| file | ) {
        say msg(
            'refuse',
            "'%s' is not a file entry",
            $record->{'title'} // ''
        );
        return FALSE;
    }
    my $v = unlocked() // return FALSE;

    my $origin = _origin_for_host($record) // do {
        say msg( 'refuse', 'no origin recorded for this file' );
        return FALSE;
    };

    ## an archive entry : the blob is a tar stream, extracted into a dir ##
    return _export_archive( $v, $record, $origin, $dest )
        if ( $record->{'archive'} // '' ) eq qw| tar |;

    my $default = $origin->{'path'} // '';

    if ( not defined $dest ) {
        my $answer = prompt_line("export to [ $default ]") // return FALSE;
        $dest = length $answer ? $answer : $default;
    }
    if ( not length $dest ) {
        say msg( 'refuse', 'no destination' );
        return FALSE;
    }
    ## a directory as destination : the file keeps its recorded name ##
    if ( -d $dest ) {
        my ($base) = ( $origin->{'path'} // '' ) =~ m|([^/]+)\z|;
        $base //= $record->{'title'} // 'file';
        $dest =~ s|/+\z||;
        $dest = "$dest/$base";
    }
    return FALSE if not _export_prepare_parent($dest);
    if ( -e $dest or -l $dest ) {
        my $all = FALSE;
        return FALSE if not confirm_overwrite( "overwrite '$dest'", \$all );
    }
    return FALSE if not _export_write_file( $v, $record, $origin, $dest );

    say msg( 'done', "exported '%s' -> %s", $record->{'title'} // '', $dest );
    return TRUE;
}

## the origin an export goes to : this host's latest
## [ the last of its records ], else the most recently imported one of any
## host
sub _origin_for_host {
    my $record  = shift;
    my $origins = $record->{'origins'} // [];
    return undef if not @{$origins};
    my $host = ( POSIX::uname() )[1];
    my ($origin);
    foreach my $o ( @{$origins} ) {
        $origin = $o if $o->{'host'} eq $host;
    }
    ($origin) = sort {
        ( ntime_b32_to_unix( $b->{'imported'} // '' ) // 0 )
            <=> ( ntime_b32_to_unix( $a->{'imported'} // '' ) // 0 )
    } @{$origins} if not defined $origin;
    return $origin;
}

## the parent of $dest : created on request [ 0700 when new ] -- FALSE when it
## cannot be made. $quiet : no asking
## [ the bulk export confirmed once already ]
sub _export_prepare_parent {
    my ( $dest, $quiet ) = @ARG;
    my ($parent) = $dest =~ m|\A(.+)/[^/]+\z|;
    return TRUE  if not defined $parent or -d $parent;
    return FALSE if not $quiet and not confirm("create directory '$parent'");
    require File::Path;
    File::Path::make_path( $parent, { mode => 0700, error => \my $e } );
    if ( not -d $parent ) {
        say msg( 'refuse', 'cannot create %s', $parent );
        return FALSE;
    }
    return TRUE;
}

## a confirm with an 'all' answer : 'y' this one, 'n' skip it, 'a' this and
## every later one [ $$all stays set ]
sub confirm_overwrite {
    my ( $question, $all ) = @ARG;
    return TRUE if $$all;
    my $answer = prompt_line("$question [ y/N/a(ll) ]") // '';
    if ( $answer =~ m|^a|i ) { $$all = TRUE; return TRUE }
    return $answer =~ m|^y(es)?$|i ? TRUE : FALSE;
}

## the actual write : blob -> temp next to $dest -> mode + mtime -> rename
## over it. the owner is restored as root, a note otherwise. returns TRUE /
## FALSE [ the message is out ]
sub _export_write_file {
    my ( $v, $record, $origin, $dest ) = @ARG;

    ## temp file next to the dest, then rename over it ##
    my $tmp = sprintf '%s.p7tmp.%s', $dest, $PID;
    my $ok  = eval {
        sysopen( my $fh, $tmp, O_WRONLY | O_CREAT | O_EXCL, 0600 )
            or die "cannot create $tmp : $OS_ERROR\n";
        binmode $fh;
        blob_export( $v, $record->{'blob'}, $fh );
        $fh->flush or die "$OS_ERROR\n";
        close $fh  or die "$OS_ERROR\n";
        chmod( $origin->{'mode'} & 07777, $tmp )
            if defined $origin->{'mode'};
        utime( $origin->{'mtime'}, $origin->{'mtime'}, $tmp )
            if defined $origin->{'mtime'};
        rename $tmp, $dest or die "cannot rename $tmp : $OS_ERROR\n";
        1;
    };
    if ( not $ok ) {
        my $err = $EVAL_ERROR;
        unlink $tmp;
        say STDERR msg( 'refuse', '%s', $err );
        return FALSE;
    }

    my ( $want_uid, $want_gid ) = @{$origin}{qw| uid gid |};
    if ( $EUID == 0 and defined $want_uid ) {
        chown $want_uid, ( $want_gid // -1 ), $dest;
    } elsif ( defined $want_uid and defined $want_gid ) {
        my @st = stat $dest;
        say STDERR msg( 'info', 'owner %s:%s not restored [ not root ]',
            $want_uid, $want_gid )
            if @st and ( $st[4] != $want_uid or $st[5] != $want_gid );
    }
    return TRUE;
}

## export of an archive entry [ archive => 'tar' ] : the blob is a tar stream,
## extracted into a DIRECTORY -- the recorded dir's parent on this host by
## default [ else asked ]. refused when <dest>/<base> exists, unless confirmed
sub _export_archive {
    my ( $v, $record, $origin, $dest_opt ) = @ARG;

    my $dir_path = $origin->{'path'} // '';
    my $base     = $dir_path =~ m|\A.*/([^/]+)\z| ? $1 : '';
    if ( not length $base ) {
        say msg( 'refuse', 'no recorded directory for this archive' );
        return FALSE;
    }

    my $dest;
    if    ( defined $dest_opt ) { $dest = $dest_opt }
    elsif ( ( $origin->{'host'} // '' ) eq ( POSIX::uname() )[1]
        and $dir_path =~ m|\A(.*)/[^/]+\z| ) {
        $dest = $1;
    } else {
        $dest = prompt_line('export archive to directory') // return FALSE;
    }
    $dest =~ s|/+/\z||;
    if ( not length $dest ) {
        say msg( 'refuse', 'no destination' );
        return FALSE;
    }
    if ( -e "$dest/$base" or -l "$dest/$base" ) {
        my $all = FALSE;
        return FALSE
            if not confirm_overwrite( "overwrite '$dest/$base'", \$all );
    }
    if ( not -d $dest ) {
        return FALSE if not confirm("create directory '$dest'");
        require File::Path;
        File::Path::make_path( $dest, { mode => 0700, error => \my $e } );
        if ( not -d $dest ) {
            say msg( 'refuse', 'cannot create %s', $dest );
            return FALSE;
        }
    }

    my @tar = ( qw| tar -C |, $dest );
    push @tar, qw| --no-same-owner | if $EUID != 0;
    push @tar, qw| -xf - |;
    my $errors = tool_stderr_begin();
    my $ok     = eval {
        my $opened = open( my $in, '|-', @tar );
        tool_stderr_end($errors);
        die "cannot run tar : $OS_ERROR\n" if not $opened;
        binmode $in;
        blob_export( $v, $record->{'blob'}, $in );
        close $in or die 'tar exited ' . ( $? >> 8 ) . "\n";
        1;
    };
    tool_stderr_end($errors) if not $ok;    ## died before the restore ##
    tool_stderr_print( $errors, qw| tar | );
    if ( not $ok ) {
        say STDERR msg( 'refuse', '%s', $EVAL_ERROR );
        return FALSE;
    }
    say msg(
        'done',
        "exported '%s' -> %s",
        $record->{'title'} // '',
        "$dest/$base"
    );
    ## an archive imported with -i is not the whole directory : say what it
    ## never held, so a restore does not look complete when it is not
    my @skipped = @{ $record->{'skipped'} // [] };
    if (@skipped) {
        say msg(
            'info',
            '%s path%s not in the archive ' . '[ unreadable at import ]',
            scalar @skipped,
            @skipped == 1 ? '' : 's'
        );
        say msg( 'info', '  %s', $ARG ) foreach @skipped;
    }
    return TRUE;
}

## export -d <prefix> [ dest dir ] : every live per-file entry
## [ not archives ] whose recorded path for this host
## [ else the latest origin ] starts with the prefix
## [ normalised : ~ expanded, trailing slashes off ].  ONE list, ONE confirm,
## then each file to its recorded path
## [ or <dest> + the path relative to the prefix ], parents created
## [ 0700 when new ], never overwritten unasked [ 'a' answers for the rest ]
sub cmd_export_prefix {
    my ( $prefix, $dest ) = @ARG;
    if ( not defined $prefix ) {
        say msg( 'info', 'export -d <path prefix> [ dest dir ]' );
        return FALSE;
    }
    $prefix =~ s{\A~(?=/|\z)}{ $ENV{'HOME'} // '' }e;
    $prefix =~ s|/+/\z||;
    if ( not length $prefix ) {
        say msg( 'refuse', 'no path prefix' );
        return FALSE;
    }
    my $v = unlocked() // return FALSE;
    my ( $list, $errors ) = entries_latest($v);
    say STDERR $C{o} . "  << $ARG >>" . $C{R} foreach @{$errors};

    my @hits;
    foreach my $entry ( @{$list} ) {
        my $record = $entry->{'record'};
        next if lc( $record->{'type'}  // '' ) ne qw| file |;
        next if ( $record->{'archive'} // '' ) eq qw| tar |;
        my $origin = _origin_for_host($record) // next;
        my $path   = $origin->{'path'}         // '';
        next if not length $path;
        next if not( $path eq $prefix or index( $path, "$prefix/" ) == 0 );
        push @hits, [ $record, $origin, $path ];
    }
    if ( not @hits ) {
        say msg( 'info', 'no stored files under %s', $prefix );
        return FALSE;
    }

    my $total = List::Util::sum0( map { $ARG->[0]{'size'} // 0 } @hits );
    say msg(
        'info',       '[ %s file%s · %s bytes ] under %s :',
        scalar @hits, @hits == 1 ? '' : 's',
        $total,       $prefix
    );
    say sprintf "  $C{0}%s$C{R} $C{V}%s$C{R}",
        $ARG->[0]{'code'} // '', $ARG->[2]
        foreach @hits;
    return FALSE if not confirm('export these files');

    my $all = FALSE;
    my ( $ok, $skipped ) = ( 0, 0 );
    foreach my $hit (@hits) {
        my ( $record, $origin, $path ) = @{$hit};
        my $target = $path;
        if ( defined $dest ) {
            my $rel = substr $path, length($prefix) + 1;
            $dest =~ s|/+/\z||;
            $target = "$dest/$rel";
        }
        next if not _export_prepare_parent( $target, TRUE );
        if ( -e $target or -l $target ) {
            if ( not confirm_overwrite( "overwrite '$target'", \$all ) ) {
                $skipped++;
                next;
            }
        }
        if ( _export_write_file( $v, $record, $origin, $target ) ) { $ok++ }
        else { $skipped++ }
    }
    say msg(
        $skipped ? 'refuse' : 'done',
        'exported %s, skipped %s',
        $ok, $skipped
    );
    return $skipped ? FALSE : TRUE;
}

## file \ directory selector for import : Term::Clui::FileSelect
## [ as the keys zenka's archive selector ], loaded only here. undef when
## there is no terminal, no Term::Clui, or nothing was picked. CLUI_DIR OFF :
## Term::Clui otherwise records choices in a database under the home directory
## -- that would leave the imported paths outside the vault
our $import_last_dir;

sub select_import_path {
    my $want_dir = shift;
    return undef if not -t STDIN or not -t STDOUT;
    local $ENV{'CLUI_DIR'} = qw| OFF |;
    return undef if not eval { require Term::Clui::FileSelect; 1 };

    ## the directory p7-vault was started in, later the last one used ##
    require Cwd;
    my $start = $import_last_dir // Cwd::getcwd() // $ENV{'HOME'} // '/';
    $start = '/' if not -d $start;
    say msg(
        'info',
        'select a %s to import [ q : cancel ]',
        $want_dir ? 'directory' : 'file'
    );
    ## the selector draws in the current colour, but Term::Clui resets all
    ## attributes [ "\e[0m" ] after highlights and between directory lists :
    ## all its text goes through puts, so puts is wrapped to set the vault's
    ## label colour first [ a colour code keeps reverse \ bold ]
    my $puts = \&Term::Clui::puts;
    no warnings qw| redefine once |;
    local *Term::Clui::puts = sub {
        print {*Term::Clui::TTY} $C{T} if length $C{T};
        return $puts->(@ARG);
    };
    use warnings qw| redefine |;
    print $C{T};
    my $path = Term::Clui::FileSelect::select_file(
        -TopDir => '/',
        -Path   => $start,
        -FPat   => '*',
        -Title  => $want_dir ? 'import directory' : 'import file',
        ( $want_dir ? ( -Directory => 1 ) : () ),
    );
    print $C{R};
    return undef if not defined $path or not length $path;
    ($import_last_dir) = $want_dir ? ($path) : $path =~ m|\A(.*)/[^/]*\z|;
    return $path;
}

## every stored file in bin/todo's list style : code, title, size, origin
## count and the last import date on the right
sub cmd_files {
    my $filter = join ' ', @ARG;
    my $v      = unlocked() // return FALSE;
    my ( $list, $errors ) = entries_latest($v);
    say STDERR $C{o} . "  << $ARG >>" . $C{R} foreach @{$errors};

    my @files = grep {
        lc( $ARG->{'record'}{'type'} // '' ) eq qw| file |
            and matches( $ARG->{'record'}, $filter )
    } @{$list};

    my $width = list_width();

    say '' if not $IN_SHELL;    ## the shell prompt padded already ##
    say notes_rule( $width, ' .:[ files ]:. ', TRUE );
    say '';
    if ( not @files ) {
        say '  ' . $C{0} . '[ no files ]' . $C{R};
    } else {
        say foreach files_lines( \@files, $width );
    }
    say '';
    say notes_rule( $width,
        sprintf( ' [ %d file%s ] ', scalar @files, @files == 1 ? '' : 's' ),
        FALSE );
    return TRUE;
}

## rows for cmd_files, shaped like notes_lines
sub files_lines {
    my ( $files, $width ) = @ARG;
    my @rows;
    foreach my $entry ( @{$files} ) {
        my $record  = $entry->{'record'};
        my @origins = @{ $record->{'origins'} // [] };
        my $last    = 0;
        foreach my $o (@origins) {
            my $u = ntime_b32_to_unix( $o->{'imported'} // '' ) // 0;
            $last = $u if $u > $last;
        }
        my $info = '';
        if ( ( $record->{'archive'} // '' ) eq qw| tar | ) {
            my @excludes = @{ $record->{'excludes'} // [] };
            my @skipped  = @{ $record->{'skipped'}  // [] };
            $info = 'tar archive';
            $info .= sprintf ' · %d excluded', scalar @excludes if @excludes;
            $info .= sprintf ' · %d skipped',  scalar @skipped  if @skipped;
            $info .= ' · ';
        }
        $info .= sprintf '%s · %d origin%s · %s',
            size_str( $record->{'size'} // 0 ),
            scalar @origins, @origins == 1 ? '' : 's',
            $last ? ymd_date($last) : '-';
        my $marker = @origins ? '┋' : ' ';
        my $code   = $record->{'code'} // '';
        my $prefix = sprintf '  %s  %-4s·  ', $marker, $code;

        my $title = $record->{'title'} // '';
        if ($width) {
            my $avail = $width - length($prefix) - length($info) - 2;
            $title = center_ellipse( $title, $avail ) if $avail >= 5;
        }
        push @rows, [ length( $prefix . $title ), $prefix . $title, $info ];
    }

    my $max = 0;
    foreach my $row (@rows) { $max = $row->[0] if $row->[0] > $max }
    return map {
        my ( $vis, $text, $info ) = @{$ARG};
        my $line = $text;
        $line .= ' ' x ( $max - $vis ) if $width and $max > $vis;
        $line . '  ' . $C{0} . $info . $C{R};
    } @rows;
}

##[ NOTES ]###################################################################

## every note in bin/todo's list style : code column, title, a details marker,
## and on the right the body size in lines \ bytes plus the last change date
## from the version name. bodies are never printed
sub cmd_notes {
    my $filter = join ' ', @ARG;
    my $v      = unlocked() // return FALSE;
    my ( $list, $errors ) = entries_latest($v);
    say STDERR $C{o} . "  << $ARG >>" . $C{R} foreach @{$errors};

    my @notes = grep {
        lc( $ARG->{'record'}{'type'} // '' ) eq qw| note |
            and matches( $ARG->{'record'}, $filter )
    } @{$list};

    my $width = list_width();

    say '' if not $IN_SHELL;    ## the shell prompt padded already ##
    say notes_rule( $width, ' .:[ notes ]:. ', TRUE );
    say '';
    if ( not @notes ) {
        say '  ' . $C{0} . '[ no notes ]' . $C{R};
    } else {
        say foreach notes_lines( \@notes, $width );
    }
    say '';
    say notes_rule( $width,
        sprintf( ' [ %d note%s ] ', scalar @notes, @notes == 1 ? '' : 's' ),
        FALSE );
    return TRUE;
}

## rows for cmd_notes, shaped like bin/todo's format_items :  '  <marker>
## <code>  ·  <title> <pad> <info>'  the marker is '┋' when the body holds
## text [ bin/todo's details marker ], a space otherwise -- one column, so the
## codes never shift
sub notes_lines {
    my ( $notes, $width ) = @ARG;
    my @rows;
    foreach my $entry ( @{$notes} ) {
        my $record = $entry->{'record'};
        my $body   = $record->{'body'} // '';
        my @lines  = split m|\n|, $body, -1;
        pop @lines if @lines > 1 and $lines[-1] eq '';
        my $info = sprintf '%d line%s · %d bytes · %s',
            scalar @lines, @lines == 1 ? '' : 's',
            length( encode( 'UTF-8', $body ) ),
            version_date( $entry->{'version'} );
        my $marker = length $body ? '┋' : ' ';
        my $code   = $record->{'code'} // '';
        my $prefix = sprintf '  %s  %-4s·  ', $marker, $code;

        my $title = $record->{'title'} // '';
        if ($width) {
            ## the row's own budget : title ellipsizes so prefix + title + gap
            ## + info stays inside the terminal, like todo
            my $avail = $width - length($prefix) - length($info) - 2;
            $title = center_ellipse( $title, $avail ) if $avail >= 5;
        }
        push @rows, [ length( $prefix . $title ), $prefix . $title, $info ];
    }

    my $max = 0;
    foreach my $row (@rows) { $max = $row->[0] if $row->[0] > $max }
    return map {
        my ( $vis, $text, $info ) = @{$ARG};
        my $line = $text;
        $line .= ' ' x ( $max - $vis ) if $width and $max > $vis;
        $line . '  ' . $C{0} . $info . $C{R};
    } @rows;
}

## '─' fill with an anchored label, header-style [ label left ] or
## footer-style [ label right ] ; width 0 [ piped ] gives the bare label frame
## line in the frame colour, label in the label colour
## [ like bin/todo's header \ footer ] -- the fill was left uncoloured before
sub notes_rule {
    my ( $width, $label, $header ) = @ARG;
    my $anchor = $C{T} . $label;
    return $anchor . $C{R} if not $width or length($label) + 3 >= $width;
    ## a '─' cap on the outer end as bin/todo : both lines end in the frame,
    ## not in the label's padding space [ looked one column short ]
    my $cap  = $C{0} . '─';
    my $fill = $C{0} . ( '─' x ( $width - 1 - length $label ) );
    return ( $header ? $cap . $anchor . $fill : $fill . $anchor . $cap )
        . $C{R};
}

## terminal width for the notes list
## [ 0 when piped : no truncation, like bin/todo's format_items ]
sub list_width {
    return 0 if not -t STDOUT;
    my $columns = $ENV{'COLUMNS'} // 80;
    return $columns =~ m|^\d+$| && $columns >= 40 ? $columns : 80;
}

## a size for the lists : bytes below 1 KiB, else one decimal KiB \ MiB \ GiB
sub size_str {
    my $bytes = shift // 0;
    return "$bytes bytes" if $bytes < 1024;
    my @units = qw| KiB MiB GiB TiB |;
    my $value = $bytes / 1024;
    my $unit  = shift @units;
    while ( $value >= 1024 and @units ) {
        $value /= 1024;
        $unit = shift @units;
    }
    return sprintf '%.1f %s', $value, $unit;
}

## date of a unix time, for the right side of the lists
sub ymd_date {
    my @time = localtime( shift // 0 );
    return sprintf '%04d-%02d-%02d', $time[5] + 1900, $time[4] + 1, $time[3];
}

## date of a version name, for the right side of the notes list
sub version_date {
    my $unix = version_to_unix( shift // '' ) // return '-';
    return ymd_date($unix);
}

## standalone port of bin/todo's center_ellipse [ keep in step ] : cut
## characters from the center, splice in '.,.', keep the total length
sub center_ellipse {
    my ( $str, $len ) = @ARG;
    return $str if length($str) <= $len;
    my $start = int( $len / 2 ) - 1;
    substr( $str, $start, length($str) - $len + 3, '.,.' );
    return $str;
}

## open the note titled 'scratchpad' in the editor, creating it when no live
## note carries that title. the editor aborts leave everything as it was
sub cmd_scratchpad {
    die "p7-vault : scratchpad needs a terminal\n" if not -t STDIN;
    my $v = unlocked() // return FALSE;

    my ($list) = entries_latest($v);
    my ($note) = grep {
                lc( $ARG->{'record'}{'type'}  // '' ) eq qw| note |
            and lc( $ARG->{'record'}{'title'} // '' ) eq qw| scratchpad |
    } @{$list};

    my $id     = $note ? $note->{'id'}                   : undef;
    my $body   = $note ? $note->{'record'}{'body'} // '' : '';
    my $edited = note_editor(
        {   text   => $body,
            title  => 'scratchpad',
            label  => 'note body',
            colors => \%C,
        }
    ) // return FALSE;

    entry_save( $v, $id,
        { type => qw| note |, title => qw| scratchpad |, body => $edited } );
    say $C{g} . "  stored 'scratchpad'" . $C{R};
    return TRUE;
}

## give a 3-char code to every live entry that lacks one : one new version
## each, nothing else touched. saving assigns the code, so this only re-saves
## the records that need it
sub cmd_codes {
    my $v = unlocked() // return FALSE;
    my ( $list, $errors ) = entries_latest($v);
    say STDERR $C{o} . "  << $ARG >>" . $C{R} foreach @{$errors};

    my @missing
        = grep { not length( $ARG->{'record'}{'code'} // '' ) } @{$list};
    if ( not @missing ) {
        say msg( 'info', 'every entry already has a code' );
        return TRUE;
    }
    say msg(
        'info',
        '%s %s without a code :',
        scalar @missing,
        @missing == 1 ? 'entry' : 'entries'
    );
    say '  ' . summary_line( $ARG + 1, $missing[$ARG]{'record'} )
        foreach 0 .. $#missing;
    return FALSE
        if not confirm( 'one new version each [ the old '
            . 'ones stay in history ] -- go ahead' );

    foreach my $entry (@missing) {
        my %record = %{ $entry->{'record'} };
        delete $record{'updated'};
        entry_save( $v, $entry->{'id'}, \%record );
        my ($now) = entry_load( $v, $entry->{'id'} );
        say $C{g}
            . sprintf( "  %s -> %s%s%s",
            $record{'title'} // $entry->{'id'},
            $C{0}, $now->{'code'} // '', $C{R} );
    }
    return TRUE;
}

##[ SYNC ]####################################################################

## manual union of the entry files with another host :  p7-vault sync
## <ssh-host>[:<remote dir>]
## [ remote dir default : .n/vault in the remote home ]  one ssh call reads
## the remote vault id [ from the key file, which sits in the clear ], the
## remote entries/ names + sha1 sums [ conflict check ] and the blobs/ names
## alone -- a blob name is a keyed mac or random, the same name IS the same
## content, so blobs are never hashed. a different vault id is refused, a
## missing remote vault is refused with a hint. missing files travel as ONE
## tar stream per direction, the name lists in a temp file \ on the remote's
## stdin -- never on a command line [ 'argument list too long' ] --, into a
## temp dir inside the vault, and each file lands in entries/ only when absent
## -- never replaced, never deleted. the key files are never transferred :
## differing content means a passphrase change on one side, reported with a
## hint to copy vault.key.B32 over by hand once. no unlock needed, the files
## are opaque. the ssh command comes from P7_VAULT_SSH [ default 'ssh' ] so
## ControlMaster or a test wrapper can stand in  sync <host>... : one host
## after the other, a failed one does not stop the rest ; a summary line when
## there were several
sub cmd_sync_hosts {
    my @targets = @ARG;
    return sync_targets_edit(@targets)
        if @targets and $targets[0] =~ m{\A-[arl]\z};
    say '' if not $IN_SHELL;    ## the shell prompt pads already ##
    if ( not @targets ) {       ## the saved ones ##
        @targets = sync_targets_read();
        if ( not @targets ) {
            say msg( 'info',
                      'sync <host>[:<dir>]|<path>... [ '
                    . 'none saved yet : sync -a <target> ]' );
            return FALSE;
        }
        say msg( 'info', 'saved targets : %s', join ' ', @targets );
    }
    return cmd_sync(@targets) if @targets <= 1;
    my @failed;
    foreach my $target (@targets) {
        say msg( 'info', '[ %s ]', $target );
        cmd_sync($target) or push @failed, $target;
        say '';
    }
    if (@failed) {
        say msg(
            'refuse',
            '%s of %s hosts not in sync [ %s ]',
            scalar @failed,
            scalar @targets,
            join ' ', @failed
        );
        return FALSE;
    }
    say msg( 'done', 'all %s hosts in sync', scalar @targets );
    return TRUE;
}

## saved sync targets : <vault>/sync-targets, one per line, '#' comments.
## sync never transfers it -- external drive paths differ per machine
sub sync_targets_path {
    return File::Spec->catfile( $dir, qw| sync-targets | );
}

sub sync_targets_read {
    open( my $fh, '<', sync_targets_path() ) or return ();
    my @targets;
    while ( my $line = <$fh> ) {
        $line =~ s{\s*(?:\#.*)?\z}{}s;
        $line =~ s{\A\s+}{};
        push @targets, $line if length $line;
    }
    close $fh;
    return @targets;
}

## written whole into a temp file next to it, then renamed
## [ 0600 ; run as root, it takes the vault directory's owner ]
sub sync_targets_write {
    my @targets = @ARG;
    my $path    = sync_targets_path();
    my $temp    = "$path.tmp.$PID";
    sysopen( my $fh, $temp, O_WRONLY | O_CREAT | O_EXCL, 0600 ) or do {
        say msg( 'refuse', 'cannot write %s : %s', $temp, $OS_ERROR );
        return FALSE;
    };
    print {$fh} "## p7-vault sync targets [ sync -a \\ -r \\ -l ]\n";
    print {$fh} "$ARG\n" foreach @targets;
    if ( not close $fh ) {
        unlink $temp;
        say msg( 'refuse', 'cannot write %s', $temp );
        return FALSE;
    }
    if ( $EUID == 0 ) {
        my ( $uid, $gid ) = ( stat $dir )[ 4, 5 ];
        chown $uid, $gid, $temp if defined $uid;
    }
    if ( not rename $temp, $path ) {
        unlink $temp;
        say msg( 'refuse', 'cannot replace %s : %s', $path, $OS_ERROR );
        return FALSE;
    }
    return TRUE;
}

sub sync_targets_edit {
    my ( $option, @given ) = @ARG;
    my @saved = sync_targets_read();

    if ( $option eq '-l' ) {
        if ( not @saved ) {
            say msg( 'info', 'no saved sync targets [ sync -a <target> ]' );
            return TRUE;
        }
        say '' if not $IN_SHELL;
        say sprintf '  %s%2d%s  %s', $C{0}, $ARG + 1, $C{R}, $saved[$ARG]
            foreach 0 .. $#saved;
        return TRUE;
    }
    if ( not @given ) {
        say msg( 'info', 'sync %s <target>...', $option );
        return FALSE;
    }

    if ( $option eq '-a' ) {
        foreach my $target (@given) {
            ## the same characters cmd_sync accepts [ shell-safe ] ##
            if ( $target !~ m{\A[0-9A-Za-z._~/:@+-]+\z} ) {
                say msg( 'refuse', "unsafe sync target '%s'", $target );
                return FALSE;
            }
        }
        my %have = map  { $ARG => TRUE } @saved;
        my @new  = grep { not $have{$ARG}++ } @given;
        if ( not @new ) {
            say msg( 'info', 'already saved' );
            return TRUE;
        }
        sync_targets_write( @saved, @new ) or return FALSE;
        say msg( 'done', 'saved : %s', join ' ', @new );
        return TRUE;
    }

    ## -r ##
    my %drop    = map  { $ARG => TRUE } @given;
    my @kept    = grep { not $drop{$ARG} } @saved;
    my @missing = grep {
        my $target = $ARG;
        not grep { $ARG eq $target } @saved
    } @given;
    say msg( 'refuse', 'not saved : %s', join ' ', @missing ) if @missing;
    return FALSE if @kept == @saved;
    sync_targets_write(@kept) or return FALSE;
    say msg( 'done', 'removed : %s', join ' ', grep { $drop{$ARG} } @saved );
    return TRUE;
}

sub cmd_sync {
    my $target = shift // do {
        say msg( 'info',
                  'sync <ssh-host>[:<remote dir>] '
                . '| <path> [ ssh via P7_VAULT_SSH ]' );
        return FALSE;
    };

    ## a path [ '/', './', '../', '~' ] is a directory here -- an external
    ## drive : the same union, the commands run by sh instead of ssh
    my ( $host, $remote, @ssh );
    my $local = $target =~ m{\A(?:/|\.{1,2}/|~(?:/|\z))} ? TRUE : FALSE;
    if ($local) {
        ( $remote = $target )
            =~ s{\A~(?=/|\z)}{$ENV{'HOME'} // ( getpwuid $EUID )[7]}e;
        $remote = File::Spec->rel2abs($remote);
        $remote =~ s|(?<=.)/+\z||;
        $host = qw| local |;
        @ssh  = (
            $^X,
            "$FindBin::RealBin/$FindBin::RealScript",
            qw| --local-shell |
        );
        ## the runner is joined into shell strings unquoted, as ssh is ##
        if ( grep { not m{\A[0-9A-Za-z._/+-]+\z} } @ssh ) {
            say msg( 'refuse', 'perl \\ script path not shell-safe [ %s ]',
                join ' ', @ssh );
            return FALSE;
        }
    } else {
        ( $host, $remote ) = split m{:}, $target, 2;
        $remote = qw| .n/vault |
            if not defined $remote or not length $remote;
        @ssh = split m{\s+}, ( $ENV{'P7_VAULT_SSH'} // qw| ssh | );
    }

    if ( not length $host ) {
        say msg( 'refuse', 'sync needs an ssh host' );
        return FALSE;
    }
    ## shell-safe only : the remote side is re-quoted at every use, and a dir
    ## that could break out of the quoting is refused here
    if ( $remote !~ m{\A[0-9A-Za-z._~/-]+\z} ) {
        say msg( 'refuse', "unsafe remote dir '%s'", $remote );
        return FALSE;
    }
    ## no vault here yet : the target's key file can start one
    ## [ asked, after the probe shows a valid vault there ]
    my $fresh = vault_exists($dir) ? FALSE : TRUE;
    ## locked : the id is clear ##
    my ($vh) = $fresh ? () : vault_open($dir);
    if ( $local and File::Spec->rel2abs($dir) eq $remote ) {
        say msg( 'refuse', '%s is this vault itself', $remote );
        return FALSE;
    }

    ## the union runs per directory kind : entries and blobs share the same
    ## rules [ strict name pattern, sha1 by content, never overwrite ]
    my %kind = (
        entries => {
            re   => $AMOS7::Vault::ENTRY_FILE_RE,
            hash => TRUE,
            case => ( '?' x 16 ) . '.'
                . ( '?' x 14 ) . '.'
                . ( '?' x 8 )
                . '.vlt.B32',
        },
        blobs => {
            re   => $AMOS7::Vault::BLOB_FILE_RE,
            hash => FALSE,                 ## the name IS the content check ##
            case => ( '?' x 32 ) . '.vlb',
        },
    );
    my $invalid = 0;
    foreach my $name ( sort keys %kind ) {
        my ( $sha, $invalid_local ) = _sync_local_listing(
            "$dir/$name",
            $kind{$name}{'re'},
            $kind{$name}{'hash'}
        );
        $kind{$name}{'sha'} = $sha;
        $invalid += $invalid_local;
    }

    ## ONE ssh call : key file, entry names + sha1 sums, blob names alone.  no
    ## shell glob over the dirs
    ## [ 'argument list too long' at some 100k files ] : ls output only, find
    ## -exec for the entry sha1 sums
    my $probe = join ' ',
        'cd ' . shq($remote),
        '2>/dev/null && {',
        'echo P7VAULT-KEY;',
        'cat vault.key.B32 2>/dev/null;',
        'echo P7VAULT-LS;',
        'ls entries 2>/dev/null;',
        'echo P7VAULT-SHA;',
        'find entries -maxdepth 1 -type f -exec sha1sum {} + 2>/dev/null;',
        'echo P7VAULT-BLOBS-LS;',
        'ls blobs 2>/dev/null;',
        'echo P7VAULT-END;',
        '}';
    my ( $out, $probe_ok ) = run_capture( @ssh, $host, $probe );
    if ( not $probe_ok or not defined $out or $out !~ m|P7VAULT-KEY| ) {
        say msg( 'refuse',
            "no vault in '%s' [ on %s ] -- copy the key file first",
            $remote, $host );
        ## the dir first : 'scp key host:dir' with no dir there writes a FILE
        ## named like the dir
        if ($local) {
            say msg( 'info', 'mkdir -p -m 700 %s', shq($remote) );
            say msg( 'info', 'cp %s %s/', shq( _key_path_local() ),
                shq($remote) );
            return FALSE;
        }
        say msg( 'info', "ssh %s 'mkdir -p -m 700 %s'", $host, $remote );
        say msg(
            'info',
            'scp %s %s:%s/',
            shq( _key_path_local() ),
            $host, shq($remote)
        );
        return FALSE;
    }

    my ($key_text) = $out =~ m|P7VAULT-KEY\n(.*?)P7VAULT-LS|s;

    ## the remote vault id : the key file is in the clear -- parsed by the
    ## vault's own key file parser [ format + kdf checked too ]
    my $key_bin = AMOS7::Vault::_b32_text_decode( $key_text // '' );
    my ($remote_vault)
        = defined $key_bin
        ? AMOS7::Vault::_key_file_parse( $key_bin, $remote )
        : ();
    my $remote_id = ref $remote_vault ? $remote_vault->{'id'} : undef;
    if ( not defined $remote_id ) {
        say msg( 'refuse', "%s : '%s' holds no vault key file",
            $host, $remote );
        return FALSE;
    }
    if ($fresh) {
        $vh = _sync_start_from( $host, $remote, $key_text, $remote_id )
            // return FALSE;
    } elsif ( $remote_id ne $vh->{'id'} ) {
        say msg( 'refuse', 'different vault [ %s : %s ] -- refusing',
            $host, $remote_id );
        return FALSE;
    }

    ## remote names from the listing : every name passes the same strict
    ## pattern before it can travel -- a hostile name never reaches a path
    ## join
    foreach my $name ( sort keys %kind ) {
        my ( $remote, $invalid_remote )
            = _sync_remote_listing( $out, $name, $kind{$name}{'re'} );
        $kind{$name}{'remote'} = $remote;
        $invalid += $invalid_remote;
    }

    ## the key files are never transferred -- a content difference means a
    ## passphrase change on one side : say how to reconcile, keep going
    my $local_key_sha  = file_sha1( _key_path_local() );
    my $remote_key_sha = text_sha1( $key_text // '' );
    if ( $local_key_sha ne $remote_key_sha ) {
        say $C{o}
            . '  << the key files differ -- a passphrase change on one side? '
            . 'copy vault.key.B32 over by hand, once, then sync again '
            . '[ entries still unite below ] >>'
            . $C{R};
    }

    my @all_conflicts;
    foreach my $name (qw| entries blobs |) {
        my $k          = $kind{$name};
        my %local_sha  = %{ $k->{'sha'} };
        my %remote_sha = %{ $k->{'remote'} };
        my @push_names = sort grep { not exists $remote_sha{$ARG} }
            keys %local_sha;
        my @pull_names = sort grep { not exists $local_sha{$ARG} }
            keys %remote_sha;
        my @conflicts = sort grep {
                    exists $local_sha{$ARG}
                and defined $remote_sha{$ARG}
                and $local_sha{$ARG} ne $remote_sha{$ARG}
            }
            keys %remote_sha;

        my ( $pushed, $push_skipped ) = ( 0, 0 );
        if (@push_names) {
            my $r = _sync_push( $host, \@ssh, $dir, "$dir/$name", $remote,
                $name, $k->{'case'}, \@push_names );
            if ( not defined $r ) {
                say msg( 'refuse',
                    'push to %s failed [ nothing was replaced ]', $host );
                return FALSE;
            }
            ( $pushed, $push_skipped ) = @{$r};
        }

        my ( $pulled, $pull_conflicts, $invalid_pull ) = ( 0, 0, 0 );
        if (@pull_names) {
            my $r = _sync_pull( $host, \@ssh, $dir, "$dir/$name",
                "$remote/$name", $k->{'re'}, \@pull_names );
            return FALSE if not defined $r;    ## the message is out ##
            ( $pulled, $pull_conflicts, $invalid_pull ) = @{$r};
            $invalid += $invalid_pull;
        }

        push @all_conflicts, map {"$name/$_"} @conflicts;
        $k->{'report'} = [
            $pushed, $pulled,
            scalar(@conflicts) + $push_skipped + $pull_conflicts
        ];
    }

    say msg( 'info', 'ignored %s invalid file name%s [ never transferred ]',
        $invalid, $invalid == 1 ? '' : 's' )
        if $invalid;

    if (@all_conflicts) {
        say $C{o}
            . '  << conflict : same name, different content -- left alone :'
            . $C{R};
        say "     $C{V}$ARG$C{R}" foreach @all_conflicts;
    }
    my $conflict_count
        = $kind{'entries'}{'report'}[2] + $kind{'blobs'}{'report'}[2];
    say msg(
        $conflict_count ? 'refuse' : 'done',
        'pushed %s, pulled %s, conflicts %s',
        @{ $kind{'entries'}{'report'} }
    );
    say msg(
        $conflict_count ? 'refuse' : 'done',
        'blobs : pushed %s, pulled %s, conflicts %s',
        @{ $kind{'blobs'}{'report'} }
    );
    return $conflict_count ? FALSE : TRUE;
}

## local names + sha1 sums : only names matching the kind's pattern, the
## others counted [ never transferred ]. a missing dir
## [ a vault written before blobs existed ] is an empty side. $hash FALSE :
## names only, no content read [ blob names are self-authenticating ]
sub _sync_local_listing {
    my ( $path, $re, $hash ) = @ARG;

    my %sha;
    my $invalid = 0;
    opendir( my $dh, $path ) or return ( \%sha, 0 );
    while ( my $name = readdir $dh ) {
        next if $name =~ m|^\.|;
        if ( $name =~ $re ) {
            $sha{$name} = $hash ? file_sha1("$path/$name") : undef;
        } else {
            $invalid++;
        }
    }
    closedir $dh;
    return ( \%sha, $invalid );
}

## remote names + sha1 sums out of the probe output : every name passes the
## same strict pattern before it can travel
sub _sync_remote_listing {
    my ( $out, $kind, $re ) = @ARG;

    ## blobs have no sha1 section : the name IS the content check each    ##
    ## section ends where the next one starts : entries' names end at the ##
    ## sha section, the sha section at the blob names                     ##
    my ( $ls_tag, $ls_end, $sha_tag, $sha_end )
        = $kind eq qw| blobs |
        ? ( qw| P7VAULT-BLOBS-LS P7VAULT-END |, undef, undef )
        : (qw| P7VAULT-LS P7VAULT-SHA P7VAULT-SHA P7VAULT-BLOBS-LS |);

    my ($ls_text) = $out =~ m|\Q$ls_tag\E\n(.*?)\Q$ls_end\E|s;
    my ($sha_text)
        = defined $sha_tag
        ? $out =~ m|\Q$sha_tag\E\n(.*?)\Q$sha_end\E|s
        : undef;

    my %sha;
    my $invalid = 0;
    foreach my $line ( split m|\n|, $ls_text // '' ) {
        $invalid++, next if $line !~ $re;
        $sha{$line} = undef;    ## filled from the sha1 lines ##
    }
    foreach my $line ( split m|\n|, $sha_text // '' ) {
        my ( $sum, $path ) = $line =~ m|\A([0-9a-f]{40})  (\S+)|;
        next if not defined $sum;
        my ($name) = $path =~ m|\A[^/]+/([^/]+)\z|;    ## 'entries/<name>' ##
        next if not defined $name or $name !~ $re;
        $sha{$name} = $sum;
    }
    return ( \%sha, $invalid );
}

## push : ONE tar stream per kind, extracted into a temp dir inside the remote
## vault [ the target subdir may not exist yet on an older copy ], each file
## moved in only when absent. returns [ moved, skipped ] or undef
sub _sync_push {
    my ( $host, $ssh, $dir, $local_dir, $remote, $sub, $case_pattern, $names )
        = @ARG;

    my $list = _sync_list_file( $dir, $names ) // do {
        say msg( 'refuse', 'cannot create the name list' );
        return undef;
    };
    my $target_dir = shq("$remote/$sub");
    my $receive    = join ' ',
        'd=$(mktemp -d ' . shq("$remote/.p7-sync.XXXXXXXX") . ')',
        '&& tar -C "$d" -xf -',
        "&& { [ -d $target_dir ] || mkdir -m 700 $target_dir; }",
        '&& moved=0; skipped=0;',
        'for f in "$d"/*; do',
        'b=${f##*/};',
        'case "$b" in',
        "$case_pattern)",
        "[ -e $target_dir/" . '"$b" ]',
        '&& skipped=$((skipped+1))',
        '|| { mv "$f" ' . "$target_dir/" . '"$b"',
        '&& moved=$((moved+1)); } ;;',
        'esac;',
        'done;',
        'rm -rf "$d";',
        'echo P7SYNC moved=$moved skipped=$skipped';
    ## the names come out of a temp list file : none on the command line ##
    my $pipeline = sprintf '%s | %s %s %s',
        join( ' ',
        'tar', '-C', shq($local_dir), '-cf', '-', '-T', shq($list) ),
        join( ' ', @{$ssh} ), shq($host), shq($receive);
    my ( $pout, $pok ) = run_capture($pipeline);
    unlink $list;
    my ( $moved, $skipped )
        = ( $pout // '' ) =~ m|P7SYNC moved=(\d+) skipped=(\d+)|;
    return ( not $pok or not defined $moved ) ? undef : [ $moved, $skipped ];
}

## the validated names, one per line, in a temp file next to the vault --
## never on a command line [ 'argument list too long' at some thousand ]
sub _sync_list_file {
    my ( $dir, $names ) = @ARG;
    my $path = sprintf '%s/.p7-sync.list.%s.%s', $dir, $PID,
        AMOS7::Vault::_b32( AMOS7::Vault::_random_bytes(4) );
    open( my $fh, '>', $path ) or return undef;
    print {$fh} "$ARG\n" foreach @{$names};
    close $fh or do { unlink $path; return undef };
    return $path;
}

## pull : the same the other way, through a local temp dir inside the vault,
## then the vault's own write-new-file rule per file. a symlink would pull in
## whatever it points to : refused. returns [ pulled, conflicts, invalid ] or
## undef on failure
sub _sync_pull {
    my ( $host, $ssh, $dir, $local_dir, $remote_dir, $re, $names ) = @ARG;

    my $tmp = sprintf '%s/.p7-sync.%s.%s', $dir, $PID,
        AMOS7::Vault::_b32( AMOS7::Vault::_random_bytes(4) );
    mkdir $tmp, 0700 or do {
        say msg( 'refuse', 'cannot create %s', $tmp );
        return undef;
    };
    my $list = _sync_list_file( $dir, $names ) // do {
        rmdir $tmp;
        say msg( 'refuse', 'cannot create the name list' );
        return undef;
    };
    ## the names go to the remote on ITS stdin                              ##
    ## [ tar -T - reads the list there ], the tar stream comes back on ours ##
    ## ; the local tar extracts only the listed names                       ##
    ## [ a hostile stream cannot add members ]                              ##
    my $pipeline = sprintf '%s %s %s < %s | tar -C %s -xf - -T %s',
        join( ' ', @{$ssh} ), shq($host),
        shq( join ' ', 'cd ' . shq($remote_dir), '&& tar -cf - -T -' ),
        shq($list), shq($tmp), shq($list);
    my ( undef, $pok ) = run_capture($pipeline);
    unlink $list;
    if ( not $pok ) {
        unlink glob "$tmp/*";
        rmdir $tmp;
        say msg( 'refuse', 'pull from %s failed', $host );
        return undef;
    }
    my ( $pulled, $conflicts, $invalid ) = ( 0, 0, 0 );
    opendir( my $tdh, $tmp );
    while ( my $name = readdir $tdh ) {
        next if $name =~ m|^\.|;
        my $src = "$tmp/$name";
        ## hostile content in the stream : refused, deleted ##
        if ( $name !~ $re or -l $src or not -f _ ) {
            $invalid++;
            unlink $src;
            next;
        }
        my $target = "$local_dir/$name";
        if ( -e $target ) {
            ## appeared meanwhile : same content is fine, different is a
            ## conflict -- never replaced. blobs : the same name is the same
            ## content [ keyed mac or random ], nothing to hash
            $conflicts++
                if $name !~ $AMOS7::Vault::BLOB_FILE_RE
                and file_sha1($target) ne file_sha1($src);
            next;
        }

        ## the pulled file sits in a temp dir inside the vault
        ## [ same filesystem ] : synced, then linked into place -- never read
        ## into memory [ an archive blob can be 88 GB ]. link is exclusive ;
        ## no hard links [ vfat ] : the checked rename
        if ( open( my $fh, '<:raw', $src ) ) { $fh->sync; close $fh }
        if ( link $src, $target ) {
            unlink $src;
            $pulled++;
        } elsif ( not -e $target and rename $src, $target ) {
            $pulled++;
        } else {
            say STDERR msg( 'refuse', 'cannot place %s : %s', $name,
                "$OS_ERROR" );
        }
    }
    AMOS7::Vault::_sync_dir($local_dir) if $pulled;
    closedir $tdh;
    unlink glob "$tmp/*";
    rmdir $tmp;
    return [ $pulled, $conflicts, $invalid ];
}

sub _key_path_local { return "$dir/vault.key.B32" }

## sync into a directory without a vault : the target's key file [ in the
## clear -- the vault key in it is wrapped by the passphrase \ recovery code ]
## written here after a confirm, then the union pulls every entry and blob.
## the passphrase is the one of that key file. returns the opened handle
sub _sync_start_from {
    my ( $host, $remote, $key_text, $id ) = @ARG;
    say msg( 'info', "no vault in %s yet -- %s : '%s' holds vault %s",
        $dir, $host, $remote, $id );
    if ( not confirm('fetch its key file here and pull everything') ) {
        say msg( 'info', 'nothing fetched' );
        return undef;
    }
    ## missing parents too [ a new machine : no ~/.n yet ], each 0700 and
    ## owned like the directory it is created in
    require File::Path;
    foreach my $sub_dir ( $dir, "$dir/entries", "$dir/blobs" ) {
        next if -d $sub_dir;
        my @made = File::Path::make_path( $sub_dir,
            { mode => 0700, error => \my $errors } );
        if ( @{$errors} or not -d $sub_dir ) {
            say msg( 'refuse', 'cannot create %s', $sub_dir );
            return undef;
        }
        AMOS7::Vault::_own_like_parent( $ARG, $ARG ) foreach @made;
    }
    my ( $ok, $err )
        = AMOS7::Vault::_write_new_file( _key_path_local(), $key_text );
    if ( not $ok ) {
        say msg( 'refuse', 'cannot write the key file : %s', $err );
        return undef;
    }
    my ( $vh, $open_err ) = vault_open($dir);
    if ( not defined $vh or $vh->{'id'} ne $id ) {
        say msg(
            'refuse',
            'the fetched key file does not open : %s',
            $open_err // 'another vault id'
        );
        return undef;
    }
    say msg( 'done', 'key file fetched [ its passphrase opens this vault ]' );
    return $vh;
}

## single-quote for a remote sh -c string
sub shq {
    my $text = shift // '';
    $text =~ s|'|'\\''|g;
    return "'$text'";
}

## run a command [ list, or one shell string ] capturing stdout ; stderr stays
## on our stderr. returns ( stdout, exit-ok )
sub run_capture {
    my @cmd    = @ARG;
    my $errors = tool_stderr_begin();
    my $opened = open( my $pipe, '-|', @cmd );
    tool_stderr_end($errors);
    if ( not $opened ) {
        tool_stderr_print( $errors, $cmd[0] );
        return ( undef, FALSE );
    }
    my $out = do { local $INPUT_RECORD_SEPARATOR; <$pipe> }
        // '';
    close $pipe;
    my $ok = $? == 0 ? TRUE : FALSE;
    tool_stderr_print( $errors, ( split m{ }, $cmd[0] )[0] );
    return ( $out, $ok );
}

## an external tool's stderr [ tar, ssh ] goes to an anonymous temp file and
## comes back through msg() once the tool exited -- raw lines broke the styled
## output. STDERR is redirected only around the fork : the child keeps the
## temp file, our own messages stay on the terminal
sub tool_stderr_begin {
    open( my $saved, '>&', \*STDERR ) or return undef;
    open( my $tmp,   '+>', undef )    or return undef;
    open( STDERR,    '>&', $tmp )     or return undef;
    return [ $saved, $tmp ];
}

sub tool_stderr_end {
    my $errors = shift        // return;
    my $saved  = $errors->[0] // return;    ## restored already ##
    open( STDERR, '>&', $saved );
    binmode STDERR, ':encoding(UTF-8)';
    close $saved;
    $errors->[0] = undef;
}

## 'tar: x: Cannot open' -> tar : x: Cannot open [ the line's own tool name
## when it has one, a pipeline mixes tar and ssh lines ]
sub tool_stderr_print {
    my ( $errors, $tool ) = @ARG;
    return if not defined $errors;
    my $tmp = $errors->[1];
    seek $tmp, 0, 0;
    while ( my $line = readline $tmp ) {
        $line = decode( qw| UTF-8 |, $line );
        $line =~ s{\s+\z}{};
        next if not length $line;
        my ( $name, $text )
            = $line =~ m{\A([\w.-]+):\s+(.+)\z}
            ? ( $1, $2 )
            : ( $tool, $line );
        say STDERR msg( 'refuse', '%s : %s', $name // 'tool', $text );
    }
    close $tmp;
}

sub file_sha1 {
    my $path = shift;
    open( my $fh, '<:raw', $path ) or return undef;
    my $content = do { local $INPUT_RECORD_SEPARATOR; <$fh> };
    close $fh;
    return text_sha1($content);
}

sub text_sha1 {
    state $have_sha1 = eval { require Crypt::Digest::SHA1; 1 };
    die "p7-vault : Crypt::Digest::SHA1 missing\n" if not $have_sha1;
    return Crypt::Digest::SHA1::sha1_hex( shift // '' );
}

sub cmd_history {
    my $entry    = pick( join( ' ', @ARG ), TRUE )        // return FALSE;
    my $v        = unlocked()                             // return FALSE;
    my $versions = entry_versions($v)->{ $entry->{'id'} } // [];

    say msg( 'info', 'entry %s', $entry->{'id'} );
    foreach my $version ( reverse @{$versions} ) {
        my ( $record, $err ) = entry_load( $v, $entry->{'id'}, $version );
        my $stamp = int( version_to_unix($version) // 0 );
        say sprintf "  $C{0}%s  %s$C{R} " . " $C{V}%s$C{R}",
            scalar localtime($stamp), $version,
            $err // (
            $record->{'deleted'}
            ? 'deleted'
            : $record->{'title'} // ''
            );
    }
    return TRUE;
}

## write an older version again as the newest [ undelete, undo an edit ].  n
## counts back from the newest [ 1 = the one before ] ; default : the newest
## version that is not a deletion
sub cmd_restore {
    my @args  = @ARG;
    my $back  = @args > 1 && $args[-1] =~ m|^\d+$| ? pop @args : undef;
    my $entry = pick( join( ' ', @args ), TRUE ) // return FALSE;
    my $v     = unlocked()                       // return FALSE;
    my @older = reverse @{ entry_versions($v)->{ $entry->{'id'} } // [] };
    shift @older;    ## the current one ##

    my $record;
    if ( defined $back ) {
        my $version = $older[ $back - 1 ] // do {
            say msg( 'refuse', 'no version %s back', $back );
            return FALSE;
        };
        ($record) = entry_load( $v, $entry->{'id'}, $version );
    } else {
        foreach my $version (@older) {
            my ($candidate) = entry_load( $v, $entry->{'id'}, $version );
            next if not $candidate or $candidate->{'deleted'};
            $record = $candidate;
            last;
        }
    }
    if ( not $record ) {
        say msg( 'refuse', 'nothing to restore' );
        return FALSE;
    }

    my %restored = %{$record};
    delete @restored{qw| updated deleted |};
    entry_save( $v, $entry->{'id'}, \%restored );
    say $C{g}
        . "  restored '$restored{'title'}' [ as a new version ]"
        . $C{R};
    return TRUE;
}

sub cmd_gen {
    my $length  = shift // 24;
    my $classes = shift;
    $length = 24 if $length !~ m|^\d+$| or $length < 4;
    say $C{V} . gen_password( $length, $classes ) . $C{R};
    return TRUE;
}

## one file for untrusted copies [ public DATA repo ] : count and edit times
## stay hidden. written, then read back and compared before it counts
sub cmd_archive {
    my @args = @ARG;
    my ( $file, %opt, $with_file, $wipe );
    while (@args) {
        my $arg = shift @args;
        if    ( $arg eq '-f' ) { $with_file = shift @args }
        elsif ( $arg eq '-p' ) { $opt{'keep_passphrase'} = TRUE }
        else                   { $file //= $arg }
    }
    if ( not defined $file
        or ( grep { $ARG eq '-f' } @ARG and not defined $with_file ) ) {
        say msg( 'info', 'archive <file> [ -f <key file> ] [ -p ]' );
        return FALSE;
    }
    my $v = unlocked() // return FALSE;

    ## the archive opens with the recovery code ; -f adds passphrase + key
    ## file, -p the plain passphrase [ weak passphrases stay exposed ]
    if ( defined $with_file ) {
        if ( not -r $with_file ) {
            say msg( 'refuse', 'cannot read %s', $with_file );
            return FALSE;
        }
        my ( $phrase, $again, $bytes );
        $wipe = wipe_on_exit( \$phrase, \$again, \$bytes,
            \$opt{'file_secret'} );
        $phrase = prompt_secret('archive passphrase [ + key file ]')
            // return FALSE;
        $again = prompt_secret('re-enter') // return FALSE;
        if ( $phrase ne $again ) {
            say msg( 'refuse', 'passphrases differ -- no archive written' );
            return FALSE;
        }
        $bytes = encode( 'UTF-8', $phrase );
        $opt{'file_secret'} = file_secret( $bytes, $with_file );
        say msg( 'info', 'key file : %s', $with_file );
        say '  '
            . $C{0}
            . '[ git blob '
            . git_blob_id($with_file)
            . " -- note which file and version ]$C{R}";
    }
    say $C{o}
        . '  << -p : the plain passphrase opens this archive '
        . '-- a weak one is exposed in public copies >>'
        . $C{R}
        if $opt{'keep_passphrase'};

    my ( $count, $size, $wraps ) = eval { archive_write( $v, $file, \%opt ) };
    if ( not defined $count ) {
        print $C{o} . "  << $EVAL_ERROR" . $C{R};
        return FALSE;
    }
    say $C{g}
        . "  archive written and read back : $count version"
        . ( $count == 1 ? '' : 's' )
        . ", $size bytes"
        . $C{R};
    say msg( 'info', '[ %s ]',          $file );
    say msg( 'info', 'opens with : %s', join( ' , ', @{$wraps} ) );
    say $C{o}
        . '  << a public copy keeps every archive in its history '
        . ': a later passphrase change does not protect those >>'
        . $C{R};
    return TRUE;
}

## restore an archive into the vault directory [ -d ] : a new directory, or
## the same vault [ missing versions added, nothing replaced ]
sub cmd_restore_archive {
    my $file = shift // do {
        say msg( 'info', 'restore-archive <file>' );
        return FALSE;
    };
    my ( $archive, $err ) = archive_open($file);
    if ( not defined $archive ) {
        say msg( 'refuse', '%s : %s', $file, $err );
        return FALSE;
    }
    unlock_prompt( $archive->{'vault'} ) // return FALSE;

    my $report = eval { archive_restore( $archive, $dir ) };
    if ( not defined $report ) {
        print $C{o} . "  << $EVAL_ERROR" . $C{R};
        return FALSE;
    }
    say $C{g}
        . "  restored into $dir : $report->{'added'} "
        . "added, $report->{'same'} already there"
        . $C{R};
    my $key_note
        = $report->{'key'} eq 'kept'
        ? 'it may hold a newer passphrase'
        : 'from the archive';
    say msg( 'info', "key file %s [ $key_note ]", $report->{'key'} );
    say msg(
        'info',
        'no passphrase in it yet -- add one : %s',
        "p7-vault -d $dir"
            . ( $use_recovery ? ' -R' : " -k $key_file" )
            . ' passwd'
        )
        if $report->{'key'} eq 'created'
        and not grep { $ARG eq 'passphrase' }
        vault_wraps( $archive->{'vault'} );
    if ( @{ $report->{'conflict'} } ) {
        say $C{o}
            . '  << conflict : same name, different '
            . 'content -- kept the existing file :'
            . $C{R};
        say "     $C{V}$ARG$C{R}" foreach @{ $report->{'conflict'} };
        return FALSE;
    }
    return TRUE;
}

sub cmd_passwd {
    my $which = shift      // 'passphrase';
    my $v     = unlocked() // return FALSE;

    if ( $which eq 'recovery' ) {
        my ( $code, $typed );
        my $wipe = wipe_on_exit( \$code, \$typed );
        $code = recovery_code_new();
        say "\n      $C{B}$C{V}$code$C{R}\n";
        $typed = prompt_line('type it back to confirm') // return FALSE;
        if ( recovery_code_normalize($typed) ne recovery_code_normalize($code)
        ) {
            say msg( 'refuse', 'does not match -- recovery code unchanged' );
            return FALSE;
        }
        print "\e[3J\e[2J\e[H" if -t STDOUT;
        vault_rewrap( $v, 'recovery', $code );
        say $C{g}
            . '  new recovery code active [ the old one no longer opens it ]'
            . $C{R};
        return TRUE;
    }

    my ( $new, $again, $bytes );
    my $wipe = wipe_on_exit( \$new, \$again, \$bytes );
    $new   = prompt_secret('new vault passphrase') // return FALSE;
    $again = prompt_secret('re-enter passphrase')  // return FALSE;
    if ( $new ne $again ) {
        say msg( 'refuse', 'passphrases differ -- unchanged' );
        return FALSE;
    }
    say $C{o} . '  << short passphrase >>' . $C{R} if length $new < 12;
    $bytes = encode( 'UTF-8', $new );
    vault_rewrap( $v, 'passphrase', $bytes );

    my ($check) = vault_open($dir);
    my $opens = vault_unlock( $check, $bytes );
    vault_lock($check);    ## the check handle's key wiped ##
    if ( not $opens ) {
        say $C{o}
            . '  << the rewritten key file does '
            . 'not open : use the recovery code >>'
            . $C{R};
        return FALSE;
    }
    say $C{g}
        . '  passphrase changed [ older copies of vault.key.B32 and '
        . 'every archive made before still open with the old one ]'
        . $C{R};
    return TRUE;
}

sub cmd_verify {
    my $v = unlocked() // return FALSE;
    my ( $ok, $errors ) = vault_verify($v);
    say $C{o} . "  << $ARG >>" . $C{R} foreach @{$errors};
    say msg(
        @{$errors} ? 'refuse' : 'done',
        '%s version%s decrypted, ' . '%s failed',
        $ok,
        $ok == 1 ? '' : 's',
        scalar @{$errors}
    );
    return @{$errors} ? FALSE : TRUE;
}

##[ CLIPBOARD ]###############################################################

sub clipboard_tool {
    my @candidates = (
        [ 'wl-copy', [qw| wl-copy |],  [qw| wl-copy --clear |] ],
        [ 'xsel',    [qw| xsel -bi |], [qw| xsel -bc |], [qw| xsel -bo |] ],
        [   'xclip', [qw| xclip -selection clipboard |],
            undef,   [qw| xclip -selection clipboard -o |]
        ],
        [ 'clip.exe', [qw| clip.exe |] ],
    );
    foreach my $tool (@candidates) {
        next if $tool->[0] eq 'wl-copy' and not $ENV{'WAYLAND_DISPLAY'};
        next if $tool->[0] =~ m|^x|     and not $ENV{'DISPLAY'};
        return $tool
            if grep { -x "$ARG/$tool->[0]" } split m|:|,
            $ENV{'PATH'} // '';
    }
    return undef;
}

sub clipboard_set {
    my ( $tool, $value ) = @ARG;
    open( my $pipe, '|-', @{ $tool->[1] } ) or return FALSE;
    ## clip.exe reads the console code page : utf-16le with a bom is the one
    ## input it takes as unicode
    ## [ a typed non-ascii password must paste exactly as typed ]
    print {$pipe} $tool->[0] eq 'clip.exe'
        ? encode( 'UTF-16LE', "\x{FEFF}$value" )
        : encode( 'UTF-8',    $value );
    return close $pipe;
}

## windows syncs every linux clipboard [ wslg ] into its own, history included
sub on_wsl {
    return TRUE if $ENV{'WSL_DISTRO_NAME'};
    open( my $fh, '<', '/proc/version' ) or return FALSE;
    my $version = <$fh> // '';
    return $version =~ m{microsoft}i ? TRUE : FALSE;
}

## a detached child clears the clipboard later -- only if it still holds our
## value, when the tool can read it back
sub clipboard_clear_later {
    my ( $tool, $value ) = @ARG;

    my $pid = fork // return;
    return if $pid;

    POSIX::setsid() if eval { require POSIX; 1 };
    open STDIN,  '<', '/dev/null';
    open STDOUT, '>', '/dev/null';
    open STDERR, '>', '/dev/null';
    sleep $CLIP_CLEAR_SECONDS;

    if ( $tool->[3] ) {
        open( my $read, '-|', @{ $tool->[3] } ) or exit 0;
        my $now = do { local $RS; <$read> }
            // '';
        close $read;
        exit 0 if $now ne encode( 'UTF-8', $value );
    }
    if ( $tool->[2] ) {
        system @{ $tool->[2] };
    } else {
        clipboard_set( $tool, '' );
    }
    exit 0;
}

