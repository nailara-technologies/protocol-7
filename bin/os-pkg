#!/usr/bin/env perl
# Protocol-7 OS Package Manager
# Installs OS packages and tracks them for replication

use strict;
use warnings;
use FindBin qw($RealBin);
use File::Spec;
use File::Path qw(make_path);
use English;

BEGIN {
    use lib "$RealBin/../data/lib-path/pm";
}

use AMOS7::deps::os_package qw( detect_os );
use AMOS7::deps::debp       qw( install_apt );
use AMOS7::deps::tracked    qw| read_tracked record undeclared promote |;

$OUTPUT_AUTOFLUSH = 1;

##[ PATHS ]###################################################################

my $P7_ROOT    = File::Spec->catdir( $RealBin, File::Spec->updir );
my $TRACK_DIR  = File::Spec->catdir( $P7_ROOT, 'var', 'sys-deps' );
my $TRACK_FILE = File::Spec->catfile( $TRACK_DIR, 'tracked.yaml' );

make_path($TRACK_DIR) unless -d $TRACK_DIR;

## group-access for sys-deps zenka \ v7-zenki [ best-effort ] ##
my $p7_gid = getgrnam('protocol-7');
if ( defined $p7_gid and -d $TRACK_DIR and -o $TRACK_DIR ) {
    chown( -1, $p7_gid, $TRACK_DIR );
    chmod( 0775, $TRACK_DIR );
}

my $host_os = detect_os();

##[ DISPATCH ]################################################################

my $cmd = shift @ARGV || 'help';

if ( $cmd eq 'install' ) {
    cmd_install(@ARGV);
} elsif ( $cmd eq 'list' ) {
    cmd_list();
} elsif ( $cmd eq 'undeclared' ) {
    cmd_undeclared();
} elsif ( $cmd eq 'declare' ) {
    cmd_declare(@ARGV);
} elsif ( $cmd eq 'help' || $cmd eq '--help' || $cmd eq '-h' ) {
    cmd_help();
} else {
    print ":. Unknown command: $cmd\n";
    cmd_help();
    exit 1;
}

##[ COMMANDS ]################################################################

sub cmd_install {
    my @pkgs = @_;

    unless (@pkgs) {
        print ":. Usage: bin/os-pkg install <pkg> [<pkg> ...]\n";
        exit 1;
    }

    if ( $host_os ne 'debian' ) {
        print ":. OS type '$host_os' not yet supported\n";
        exit 1;
    }

    my $result = install_apt(@pkgs);

    for my $pkg ( @{ $result->{ok} } ) {
        print ":. installed and tracked: $pkg\n";
    }

    for my $pkg ( @{ $result->{failed} } ) {
        print ":. FAILED: $pkg\n";
    }

    record(
        $P7_ROOT,
        [   map {
                {   pkg          => $ARG,
                    type         => 'debian',
                    installed_at => iso_timestamp(),
                    source       => 'manual',
                    zenka        => undef,
                    declared     => 0
                }
            } @{ $result->{ok} }
        ]
    );

    group_file_access();
}

sub cmd_list {
    my @entries = @{ read_tracked($P7_ROOT) };

    unless (@entries) {
        print ":. no tracked packages\n";
        return;
    }

    print ":. tracked packages:\n";
    for my $entry (@entries) {
        my $declared = $entry->{declared} ? 'declared' : 'undeclared';
        print sprintf(
            "  :. %-40s %s  %s  %s\n",
            $entry->{pkg},    $entry->{installed_at},
            $entry->{source}, $declared
        );
    }
    print "\n";
}

sub cmd_undeclared {
    my @undeclared = @{ undeclared($P7_ROOT) };

    unless (@undeclared) {
        print ":. all tracked packages are declared\n";
        return;
    }

    print ":. tracked but not declared:\n";
    for my $entry (@undeclared) {
        print "  :. $entry->{pkg}  ($entry->{installed_at})\n";
    }
    print "\n";
}

sub cmd_declare {
    my ( $pkg, $zenka ) = @_;

    unless ( defined $pkg && defined $zenka ) {
        print ":. Usage: bin/os-pkg declare <pkg> <zenka>\n";
        exit 1;
    }

    my $result = promote( $P7_ROOT, $zenka, $pkg );

    if ( not $result->{'ok'} ) {
        print ":. $result->{'error'}\n";
        exit 1;
    }

    if ( $result->{'status'} eq 'exists' ) {
        print ":. $pkg already declared for zenka '$zenka'\n";
    } else {
        print ":. declared $pkg for zenka '$zenka'\n";
    }

    group_file_access();
}

sub cmd_help {
    print <<'EOF';
:
::[ os-pkg — OS package tracker ]
:
  install <pkg> [<pkg> ...]   install packages and track them
  list                        show tracked installs
  undeclared                  tracked packages not in any deps/os/ config
  declare <pkg> <zenka>       promote to zenka deps/os config
  help                        show this help
:
EOF
}

##[ TRACKING STATE ]##########################################################

sub group_file_access {

    ## group-access for sys-deps zenka \ v7-zenki [ best-effort ] ##
    if ( defined $p7_gid and -f $TRACK_FILE and -o $TRACK_FILE ) {
        chown( -1, $p7_gid, $TRACK_FILE );
        chmod( 0664, $TRACK_FILE );
    }
}

sub iso_timestamp {
    my @gm = gmtime();
    return sprintf(
        '%04d-%02d-%02dT%02d:%02d:%02dZ',
        $gm[5] + 1900,
        $gm[4] + 1,
        $gm[3], $gm[2], $gm[1], $gm[0]
    );
}

