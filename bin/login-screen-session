#\\\|USCGQ6EJSY7MFVJQB6OCAC2ERIBLQLGVJOIM5HKAE5GM7IPVJIT \ / AMOS7 \ YOURUM ::
#\[7]75PWRFKEDPYBCXYPQZG43INE63CUIQMGPKQEB3H67WWXTCM7N2BQ 7  DATA SIGNATURE ::
