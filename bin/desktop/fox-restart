#!/bin/sh
set -eu

uid=$(id -u)
pkill -CONT -u "$uid" firefox 2>/dev/null || :
pkill -TERM -u "$uid" firefox 2>/dev/null || :

attempt=0
while pgrep -u "$uid" firefox >/dev/null 2>&1; do
    if [ "$attempt" -ge 100 ]; then
        pkill -KILL -u "$uid" firefox 2>/dev/null || :
        break
    fi
    sleep 0.1
    attempt=$((attempt + 1))
done

nohup firefox >/dev/null 2>&1 </dev/null &

