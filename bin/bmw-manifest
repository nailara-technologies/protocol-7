#!/usr/bin/perl
## bmw-manifest — generate or verify BMW384 checksum manifest for binary assets
##
## usage:
##   bmw-manifest <directory>            ## generate manifest (recursive)
##   bmw-manifest --verify <directory>   ## verify against existing manifest
##   bmw-manifest --verify <file.bmw>    ## verify specific manifest file
##
## paths in manifest are relative to dirname(<directory>), so scanning
## data/web-root/vhosts/ produces vhosts.bmw with paths vhosts/iris.v7.ax/...
##

use v5.24;
use strict;
use warnings;
use English;
use Digest::BMW;
use Crypt::Misc  qw| encode_b32r |;
use File::Spec;
use File::Find   qw| find |;
use File::Basename;
use Cwd          qw| abs_path |;
use FindBin      qw| $RealBin |;

BEGIN {
    use File::Spec;
    use Cwd qw| abs_path |;
    my $root = abs_path( File::Spec->catdir( $RealBin, File::Spec->updir ) );
    my $lib  = File::Spec->catdir( $root, qw| data lib-path pm | );
    unshift @INC, $lib if -d $lib;
}

my $verify = 0;
my $target = '';

for ( my $i = 0; $i < @ARGV; $i++ ) {
    if ( $ARGV[$i] eq '--verify' or $ARGV[$i] eq '-v' ) {
        $verify = 1;
    } else {
        $target = $ARGV[$i];
    }
}

die ":\n: usage: bmw-manifest [--verify] <directory|manifest.bmw>\n:\n"
    unless length $target;

## resolve target
my $dir;
my $manifest_path;

if ( $target =~ m|\.bmw$| and -f $target ) {
    $manifest_path = abs_path($target);
    $dir           = dirname($manifest_path);
    $verify        = 1;
} elsif ( -d $target ) {
    $dir           = abs_path($target);
    my $dirname    = basename($dir);
    $manifest_path = File::Spec->catfile( dirname($dir), "$dirname.bmw" );
} else {
    die ":\n: not found: $target\n:\n";
}

## collect files recursively — paths relative to dirname($dir)
my $root = dirname($dir);
my @files;
find(
    {   wanted => sub {
            return unless -f $File::Find::name;
            my $rel = File::Spec->abs2rel( $File::Find::name, $root );
            return if $rel =~ m|^\.|;           ## skip hidden at root
            return if $rel =~ m|/\.|;           ## skip hidden in subdir
            return if $rel =~ m|\.bmw$|;        ## skip existing manifests
            push @files, $rel;
        },
        no_chdir => 1,
    },
    $dir
);

## base.sort order: length ascending, reverse alpha as tiebreaker
@files = sort { length $a <=> length $b || $b cmp $a } @files;

die ":\n: no files found in $dir\n:\n" unless @files;

sub bmw384_file {
    my $path = shift;
    open my $fh, '<:raw', $path or die "cannot read $path: $!";
    my $bmw = Digest::BMW->new(384);
    $bmw->addfile($fh);
    close $fh;
    return substr( encode_b32r( $bmw->digest ), 0, 64 );
}

if ( $verify ) {
    ## verify mode
    die ":\n: manifest not found: $manifest_path\n:\n"
        unless -f $manifest_path;

    say ": verifying [ $manifest_path ]";
    say ":";

    open my $fh, '<', $manifest_path or die "cannot read manifest: $!";
    my %expected;
    while ( <$fh> ) {
        chomp;
        next unless m|^([A-Z2-7]{64})\s+(.+)$|;
        $expected{$2} = $1;
    }
    close $fh;

    my $ok = 0; my $fail = 0;
    for my $fname ( sort keys %expected ) {
        my $path = File::Spec->catfile( $root, $fname );
        unless ( -f $path ) {
            printf ": MISSING  %s\n", $fname;
            $fail++;
            next;
        }
        my $actual = bmw384_file($path);
        if ( $actual eq $expected{$fname} ) {
            printf ":  ok  %s\n", $fname;
            $ok++;
        } else {
            printf ": FAIL %s\n", $fname;
            $fail++;
        }
    }

    say ":";
    printf ": %d ok  %d failed\n:\n", $ok, $fail;
    exit( $fail ? 1 : 0 );

} else {
    ## generate mode
    say ": generating [ $manifest_path ]";
    say ": directory  [ $dir ]";
    say ": files      [ " . scalar(@files) . " ]";
    say ":";

    open my $out, '>', $manifest_path
        or die "cannot write manifest: $!";

    printf $out "## bmw384 manifest : %s\n", basename($dir);
    printf $out "## root            : %s\n", basename($root);
    printf $out "## generated       : %s\n", scalar localtime;
    print  $out "##\n";

    for my $fname (@files) {
        my $path     = File::Spec->catfile( $root, $fname );
        my $checksum = bmw384_file($path);
        printf $out "%s  %s\n", $checksum, $fname;
        printf     ": %s  %s\n", substr($checksum,0,16).'..',  $fname;
    }

    close $out;

    say ":";
    say ": manifest written =)";
    say ": run 'bin/Protocol-7 sourcecode update-signatures' to sign";
    say ":";
}

#,,.,,.,,,.,,,,..,,.,,,..,...,.,.,,,.,.,,,,..,..,,...,...,,.,,.,,,,.,,,,.,..,,
#67HVTYMNVA4GX3RBOBRVQ4B4ZZ3KL65WVKQ6L5GLPAQCIEX5PYA6V3LEZPPB6FNXKIUQFKAEYASSC
#\\\|NFXLQRL5P5RGBP3MXPMPZY6Q4I2W4GK3O7VL4LTEWPJ6ZJEQKTI \ / AMOS7 \ YOURUM ::
#\[7]52ZEDCAX4R2AIEFOUGAPSTO5VXZ53CDBQWIDGAC3GY57JU65HQDY 7  DATA SIGNATURE ::
#:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
