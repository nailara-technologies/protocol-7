#!/usr/bin/perl

use v5.24;
use strict;
use English;
use warnings;
use utf8;
use Getopt::Long;
use open ':std', ':encoding(UTF-8)';
use POSIX      qw| strftime |;
use File::Path qw| make_path |;
use File::Spec;
use Cwd                  qw| abs_path |;
use FindBin              qw| $RealBin |;
use IO::Compress::Xz     qw| xz |;
use IO::Uncompress::UnXz qw| unxz |;
use Encode               qw| encode_utf8 |;
use Crypt::Misc          qw| encode_b32r |;

####        ####
##   chat   ##
###       ####

##[ LOCAL PM LIB PATH ]#######################################################

BEGIN {
    use File::Spec;
    use Cwd     qw| abs_path |;
    use FindBin qw| $RealBin |;
    my $up_dir         = File::Spec->updir;
    my $data_pm_path   = qw| data/lib-path/pm |;
    my $root_path      = abs_path( r2_abs( c_dir( $RealBin, $up_dir ) ) );
    my $local_lib_path = abs_path( c_dir( $root_path, $data_pm_path ) );
    $local_lib_path //= $data_pm_path;
    die "\n:\n:: not found : $local_lib_path\n:\n" if !-d $local_lib_path;
    unshift( @INC, $local_lib_path )               if -d $local_lib_path;
    sub c_dir  { File::Spec->catdir(@ARG) }
    sub r2_abs { File::Spec->rel2abs(@ARG) }
}

##[ AMOS7 COLORS ]############################################################

use AMOS7;

##[ CONSTANTS ]###############################################################

use constant TRUE  => 5;
use constant FALSE => 0;

my $ROOT_PATH   = abs_path( r2_abs( c_dir( $RealBin, File::Spec->updir ) ) );
my $CHAT_DIR    = File::Spec->catdir( $ROOT_PATH, qw| data chat | );
my $CHANNEL_DIR = File::Spec->catdir( $CHAT_DIR,  qw| channel | );
my $ARCHIVE_DIR = File::Spec->catdir( $CHAT_DIR,  qw| archive channel | );
my $MODEL_DIR   = File::Spec->catdir( $CHAT_DIR,  qw| model | );
my $STATE_DIR   = File::Spec->catfile( $ENV{'HOME'} // $ENV{'PWD'},
    qw| .config protocol-7 | );
my $STATE_FILE       = File::Spec->catfile( $STATE_DIR, qw| chat-state | );
my $MAX_HISTORY      = 512 * 1024;   ## 512 KB auto-rotation threshold ##
my $MAX_MEMORY_LINES = 500;          ## line-count trigger for model memory ##
my $WAIT_INTERVAL    = 0.5;          ## poll interval for -wait-reply  ##
my $WAIT_DEFAULT     = 60;           ## default wait timeout           ##
my @KNOWN_MODELS     = qw| kimi-code claude-code |;

##[ OPTION LIST ]#############################################################

my $option_list = <<'EOL';

    .: chat command line options :.

    -w  .......  wait for reply before exiting [ --wait-reply [seconds] ]
    -f  .......  read message from file        [ --file <path> ]
    -c  .......  specify channel               [ --channel <name> ]
    -m  .......  specify model                 [ --model <id> ]
    -q  .......  quiet — no decorative output

    -clear  ...  archive current channel and start fresh
    -clear-all   archive all channels and start fresh
    -clear-msg   remove single message by index [ --clear-msg <n> ]
    -trim <n>    archive messages older than n, keep recent n lines
    -archive     show archive list for current channel
    -channels    list all channels with last-active timestamps
    -models      list known models and their status
    -search      literal search in history      [ --search <term> ]
    -grep        regex search in history        [ --grep <pattern> ]
    -summarize   trigger memory rotation for current channel

    keywords inside the message text :

        :#channel:         switch active channel
        :model:            switch active model
        :all:              broadcast next message to all models
        :note:             write to history, skip model dispatch
        :reply-to:N:       thread reply to history line N
        :->>#channel:      quote last 5 lines from another channel
        :->>#channel:N:    quote last N lines from another channel


EOL

##[ RUNTIME OPTIONS ]#########################################################

my %option;
Getopt::Long::Configure(qw| bundling_override |);
GetOptions(
    \%option,      'wait-reply|w:s', 'file|f=s',  'channel|c=s',
    'model|m=s',   'quiet|q',        'clear',     'clear-all',
    'clear-msg=i', 'trim=i',         'archive:s', 'channels',
    'models',      'search=s',       'grep=s',    'all-channels',
    'summarize',   'help|h',
) or do { list_options(); exit(2) };

if ( $option{'help'} ) {
    list_options();
    exit(0);
}

##[ CALLER DETECTION ]########################################################

my $CALLER = detect_caller();

##[ STATE MANAGEMENT ]########################################################

my $state = load_state();

## apply command-line overrides ##
$state->{'active_channel'} = $option{'channel'} if $option{'channel'};
$state->{'active_model'}   = $option{'model'}   if $option{'model'};

##[ MESSAGE INPUT ]###########################################################

my $message = '';

if ( $option{'file'} ) {
    $message = read_file( $option{'file'} );
} elsif (@ARGV) {
    $message = join( ' ', @ARGV );
} elsif ( not -t STDIN ) {
    local $/;
    $message = <STDIN> // '';
}

chomp $message if defined $message;

##[ KEYWORD PARSING ]#########################################################

my ( $clean_msg, $switches ) = parse_keywords($message);

## apply keyword switches ##
if ( $switches->{'channel'} ) {
    $state->{'active_channel'} = $switches->{'channel'};
    ensure_channel( $state->{'active_channel'} );
}
if ( $switches->{'model'} and not $switches->{'broadcast'} ) {
    $state->{'active_model'} = $switches->{'model'};
}

save_state($state);

##[ LIST / CLEAR COMMANDS ]###################################################

if ( $option{'channels'} ) {
    list_channels();
    exit(0);
}

if ( $option{'models'} ) {
    list_models();
    exit(0);
}

if ( defined $option{'archive'} ) {
    my $ch
        = $option{'archive'} eq ''
        ? $state->{'active_channel'}
        : $option{'archive'};
    list_archives($ch);
    exit(0);
}

if ( defined $option{'search'} or defined $option{'grep'} ) {
    search_history(
        $option{'search'} // $option{'grep'},
        defined $option{'grep'},
        $option{'all-channels'}
    );
    exit(0);
}

if ( $option{'summarize'} ) {
    rotate_with_summary( $state->{'active_channel'},
        $state->{'active_model'} );
    exit(0);
}

if ( $option{'clear'} ) {
    clear_channel( $state->{'active_channel'} );
    exit(0) if not length $clean_msg;
}

if ( $option{'clear-all'} ) {
    clear_all_channels();
    exit(0);
}

if ( defined $option{'clear-msg'} ) {
    clear_message( $state->{'active_channel'}, $option{'clear-msg'} );
    exit(0);
}

if ( defined $option{'trim'} ) {
    trim_history( $state->{'active_channel'}, $option{'trim'} );
    exit(0);
}

##[ NO MESSAGE — SHOW STATUS OR HELP ]########################################

if ( not length $clean_msg ) {
    if ( $switches->{'channel'} or $switches->{'model'} ) {
        say colored(
            ": switched to channel $state->{'active_channel'}, model $state->{'active_model'}"
        ) unless $option{'quiet'};
        exit(0);
    }
    list_options();
    exit(0);
}

##[ WRITE & DISPATCH ]########################################################

write_history( $state->{'active_channel'}, $CALLER, $clean_msg );

my $dispatch_text = build_dispatch_text( $state->{'active_channel'},
    $clean_msg, $switches );

my $broadcast = $switches->{'broadcast'} || $state->{'active_model'} eq 'all';

if ( not $switches->{'note_only'} ) {
    if ($broadcast) {
        broadcast_message( $state->{'active_channel'},
            $CALLER, $dispatch_text );
    } elsif ( $state->{'active_model'} ne 'user' ) {
        dispatch_model(
            $state->{'active_channel'},
            $state->{'active_model'},
            $dispatch_text
        );
    }
}

##[ WAIT FOR REPLY ]##########################################################

if ( $option{'wait-reply'} // '' ne '' or exists $option{'wait-reply'} ) {
    my $timeout = $option{'wait-reply'} // $WAIT_DEFAULT;
    $timeout = $WAIT_DEFAULT if $timeout eq '';
    my $target = $broadcast ? undef : $state->{'active_model'};
    my $reply  = wait_reply( $state->{'active_channel'}, $target, $timeout,
        $CALLER );
    say $reply if defined $reply;
}

exit(0);

##[ SUBROUTINES ]#############################################################

sub detect_caller {
    if ( my $env = $ENV{'P7_CHAT_CALLER'} ) {
        return $env;
    }
    my $ppid      = getppid() or return 'user';
    my $comm_path = "/proc/$ppid/comm";
    if ( open my $fh, '<', $comm_path ) {
        my $comm = <$fh>;
        close $fh;
        chomp $comm          if defined $comm;
        return 'kimi-code'   if defined $comm and $comm =~ m|kimi|i;
        return 'claude-code' if defined $comm and $comm =~ m|claude|i;
    }
    return 'user';
}

sub load_state {
    my %st = ( 'active_channel' => 'main', 'active_model' => 'kimi-code' );
    if ( -f $STATE_FILE ) {
        open my $fh, '<', $STATE_FILE or return \%st;
        while ( my $line = <$fh> ) {
            chomp $line;
            next if $line =~ m{^\s*#} or $line !~ m{=};    ## skip comments ##
            my ( $k, $v ) = split m{=}, $line, 2;
            $st{$k} = $v if defined $k and defined $v;
        }
        close $fh;
    }
    return \%st;
}

sub save_state {
    my $st = shift;
    make_path($STATE_DIR) unless -d $STATE_DIR;
    open my $fh, '>', $STATE_FILE
        or die colored(": cannot write state file : $!");
    print {$fh} "# protocol-7 chat state\n";
    print {$fh} "active_channel=$st->{'active_channel'}\n";
    print {$fh} "active_model=$st->{'active_model'}\n";
    close $fh;
}

sub ensure_channel {
    my $name = shift;
    my $path = File::Spec->catdir( $CHANNEL_DIR, $name );
    make_path( $path, File::Spec->catdir( $path, 'context' ) )
        unless -d $path;
}

sub history_path {
    my $channel = shift;
    return File::Spec->catfile( $CHANNEL_DIR, $channel, 'history' );
}

sub read_file {
    my $path = shift;
    open my $fh, '<:encoding(UTF-8)', $path
        or die colored(": cannot read file : $path : $!");
    local $/;
    my $content = <$fh>;
    close $fh;
    return $content // '';
}

sub parse_keywords {
    my $text = shift // '';
    my %sw;

    ## silent annotation :note: prefix — preserve in history, skip dispatch ##
    my $has_note = 0;
    if ( $text =~ s{^\s*:note:\s*}{} ) {
        $has_note = 1;
        $sw{'note_only'} = 1;
    }

    ## reply-to threading — protect marker, extract number ##
    while ( $text =~ s{:reply-to:(\d+):?\s*}{__REPLY_TO_$1__ } ) {
        $sw{'reply_to'} = int($1);
    }

    ## cross-channel references — strip from text, capture channel + count ##
    while ( $text =~ s{\s*:->>#([^:\s/]+(?:/[^:\s/]+)*)(?::(\d+))?:\s*}{ }g )
    {
        my ( $ch, $n ) = ( $1, $2 // 5 );
        push @{ $sw{'cross_ref'} }, [ $ch, int($n) ];
    }

    ## channel switches :#name: or :#name/sub: ##
    while ( $text =~ s{\s*:#([^:\s/]+(?:/[^:\s/]+)*):\s*}{ }g ) {
        $sw{'channel'} = $1;
    }

    ## model switches and :all: broadcast ##
    while ( $text =~ s{\s*:([a-zA-Z0-9_-]+):\s*}{ }g ) {
        my $m = $1;
        if ( $m eq 'all' ) {
            $sw{'broadcast'} = 1;
        } else {
            $sw{'model'} = $m;
        }
    }

    ## restore protected placeholders ##
    $text =~ s{__REPLY_TO_(\d+)__}{:reply-to:$1:}g;
    $text = ':note: ' . $text if $has_note;

    $text =~ s{^\s+|\s+$}{}g;
    return ( $text, \%sw );
}

sub timestamp {
    return strftime( '%Y-%m-%dT%H:%M:%S', localtime() );
}

sub format_entry {
    my ( $caller_id, $text ) = @_;
    return sprintf( "[%s] <%s>   %s\n", timestamp(), $caller_id, $text );
}

sub write_history {
    my ( $channel, $caller_id, $text ) = @_;
    ensure_channel($channel);
    my $path = history_path($channel);

    auto_rotate($channel) if -f $path and -s $path > $MAX_HISTORY;

    open my $fh, '>>:encoding(UTF-8)', $path
        or die colored(": cannot write history : $path : $!");
    print {$fh} format_entry( $caller_id, $text );
    close $fh;

    ## rolling model memory check ##
    if ( -f $path ) {
        open my $rfh, '<:encoding(UTF-8)', $path or return;
        my @lines = <$rfh>;
        close $rfh;
        if ( @lines > $MAX_MEMORY_LINES ) {
            rotate_with_summary( $channel, $state->{'active_model'} );
        }
    }
}

sub auto_rotate {
    my $channel = shift;
    my $path    = history_path($channel);
    my $size    = -s $path // 0;
    return if $size < $MAX_HISTORY;

    open my $fh, '<:encoding(UTF-8)', $path or return;
    my @lines = <$fh>;
    close $fh;

    return if @lines < 4;    ## too small to split ##

    my $mid   = int( @lines / 2 );
    my @older = @lines[ 0 .. $mid - 1 ];
    my @newer = @lines[ $mid .. $#lines ];

    my $archive_ch = File::Spec->catdir( $ARCHIVE_DIR, $channel );
    make_path($archive_ch) unless -d $archive_ch;

    my $ts     = strftime( '%Y-%m-%dT%H:%M:%S', gmtime() );
    my $azPath = File::Spec->catfile( $archive_ch, "$ts.xz" );

    my $older_str = encode_utf8( join( '', @older ) );
    xz( \$older_str, $azPath, 'Preset' => 6 )
        or warn colored(": archive compression failed");

    open my $out, '>:encoding(UTF-8)', $path
        or die colored(": cannot rewrite history : $path : $!");
    print {$out} @newer;
    close $out;

    say colored(": archived older half to $azPath")
        unless $option{'quiet'};
}

sub clear_channel {
    my $channel = shift;
    my $path    = history_path($channel);
    return if not -f $path or -z $path;

    my $archive_ch = File::Spec->catdir( $ARCHIVE_DIR, $channel );
    make_path($archive_ch) unless -d $archive_ch;

    my $ts     = strftime( '%Y-%m-%dT%H:%M:%S', gmtime() );
    my $azPath = File::Spec->catfile( $archive_ch, "$ts.xz" );

    xz( $path, $azPath, 'Preset' => 6 )
        or die colored(": archive compression failed");

    truncate( $path, 0 )
        or die colored(": cannot truncate history : $path : $!");

    say colored(": cleared channel '$channel' — archived to $ts.xz")
        unless $option{'quiet'};
}

sub clear_all_channels {
    opendir my $dh, $CHANNEL_DIR or return;
    my @ch = grep {
        $_ !~ m{^\.\.?$} and -d File::Spec->catdir( $CHANNEL_DIR, $_ )
    } readdir $dh;
    closedir $dh;
    clear_channel($_) for @ch;
}

sub clear_message {
    my ( $channel, $index ) = @_;
    $index = int($index);
    return if $index < 1;

    my $path = history_path($channel);
    return if not -f $path;

    open my $fh, '<:encoding(UTF-8)', $path or return;
    my @lines = <$fh>;
    close $fh;

    return if $index > scalar @lines;

    splice @lines, $index - 1, 1;

    open my $out, '>:encoding(UTF-8)', $path
        or die colored(": cannot rewrite history : $path : $!");
    print {$out} @lines;
    close $out;

    say colored(": removed message $index from channel '$channel'")
        unless $option{'quiet'};
}

sub trim_history {
    my ( $channel, $keep ) = @_;
    $keep = int($keep);
    return if $keep < 1;

    my $path = history_path($channel);
    return if not -f $path;

    open my $fh, '<:encoding(UTF-8)', $path or return;
    my @lines = <$fh>;
    close $fh;

    return if @lines <= $keep;

    my @archive = splice @lines, 0, scalar(@lines) - $keep;

    my $archive_ch = File::Spec->catdir( $ARCHIVE_DIR, $channel );
    make_path($archive_ch) unless -d $archive_ch;

    my $ts     = strftime( '%Y-%m-%dT%H:%M:%S', gmtime() );
    my $azPath = File::Spec->catfile( $archive_ch, "$ts.xz" );

    my $arch_str = encode_utf8( join( '', @archive ) );
    xz( \$arch_str, $azPath, 'Preset' => 6 )
        or warn colored(": archive compression failed");

    open my $out, '>:encoding(UTF-8)', $path
        or die colored(": cannot rewrite history : $path : $!");
    print {$out} @lines;
    close $out;

    say colored(": trimmed channel '$channel' to $keep lines — archived rest")
        unless $option{'quiet'};
}

sub dispatch_model {
    my ( $channel, $model, $text ) = @_;

    ## prepend channel persona if exists ##
    my $persona_file
        = File::Spec->catfile( $CHANNEL_DIR, $channel, 'persona' );
    if ( -f $persona_file ) {
        my $persona = read_file($persona_file);
        chomp $persona;
        $text = "[ channel persona: $persona ]\n\n$text" if length $persona;
    }

    ## prepend model memory if exists (before persona block) ##
    my $memory_file = File::Spec->catfile( $MODEL_DIR, $model, 'memory' );
    if ( -f $memory_file ) {
        my $memory = read_file($memory_file);
        chomp $memory;
        $text = "[ model memory: $memory ]\n\n$text" if length $memory;
    }

    my $encoded = encode_b32r( encode_utf8($text) );

    if ( $model eq 'kimi-code' ) {
        open( my $fh, '-|', 'p7c', 'kimi.ask-reply', $encoded )
            or warn "chat: p7c kimi.ask-reply failed: $!\n";
        my $reply = do { local $/; <$fh> } if $fh;
        close $fh                          if $fh;
        chomp $reply                       if defined $reply;
        write_history( $channel, $model, $reply )
            if defined $reply and length $reply;
    } elsif ( $model eq 'claude-code' ) {
        ## write to inbox file — claude-code polls data/chat/inbox/claude-code ##
        my $inbox_dir = File::Spec->catdir( $CHAT_DIR, qw| inbox | );
        make_path($inbox_dir) unless -d $inbox_dir;
        my $inbox_file = File::Spec->catfile( $inbox_dir, 'claude-code' );
        open( my $fh, '>:encoding(UTF-8)', $inbox_file )
            or warn "chat: cannot write claude-code inbox: $!\n";
        print $fh $text, "\n" if $fh;
        close $fh if $fh;
    } else {
        warn "chat: unknown model '$model' — no dispatch configured\n";
    }
}

sub broadcast_message {
    my ( $channel, $caller_id, $text ) = @_;
    for my $m (@KNOWN_MODELS) {
        next if $m eq $caller_id;
        dispatch_model( $channel, $m, $text );
    }
}

sub wait_reply {
    my ( $channel, $target_model, $timeout, $caller_id ) = @_;
    $timeout //= $WAIT_DEFAULT;

    my $path = history_path($channel);
    return undef if not -f $path;

    my $elapsed = 0;
    while ( $elapsed <= $timeout ) {
        open my $rfh, '<:encoding(UTF-8)', $path or next;
        my @lines = <$rfh>;
        close $rfh;

        ## find last line from caller, then collect replies after it ##
        my $last_user_idx = -1;
        for my $i ( 0 .. $#lines ) {
            $last_user_idx = $i
                if defined $caller_id
                and $lines[$i] =~ m{<$caller_id>};
        }

        my @candidates;
        my $start = $last_user_idx >= 0 ? $last_user_idx + 1 : 0;
        for my $i ( $start .. $#lines ) {
            my $line = $lines[$i];
            if ( defined $target_model ) {
                push @candidates, $line if $line =~ m{<$target_model>};
            } else {
                ## broadcast mode: collect any model reply ##
                push @candidates, $line
                    if $line =~ m{<(?!user>)[^>]+>};
            }
        }

        if (@candidates) {
            chomp @candidates;
            return join( "\n", @candidates );
        }

        last if $elapsed >= $timeout;
        sleep $WAIT_INTERVAL;
        $elapsed += $WAIT_INTERVAL;
    }

    return colored(": timeout waiting for reply ($timeout s)");
}

sub list_channels {
    opendir my $dh, $CHANNEL_DIR or do {
        say colored(": no channels yet");
        return;
    };
    my @ch = grep {
        $_ !~ m{^\.\.?$} and -d File::Spec->catdir( $CHANNEL_DIR, $_ )
    } readdir $dh;
    closedir $dh;

    if ( not @ch ) {
        say colored(": no channels yet");
        return;
    }

    say colored(".: channels :.");
    for my $name ( sort @ch ) {
        my $hpath = history_path($name);
        my $mtime = -f $hpath ? ( stat($hpath) )[9] : 0;
        my $ts
            = $mtime
            ? strftime( '%Y-%m-%d %H:%M', localtime($mtime) )
            : 'never';
        my $size = -f $hpath ? -s $hpath : 0;
        say sprintf(
            "  $C{T}%-20s$C{0}  last: $C{T}%s$C{0}  size: $C{T}%d$C{0} bytes",
            $name, $ts, $size );
    }
    say $C{R};
}

sub list_models {
    say colored(".: models :.");
    for my $m (@KNOWN_MODELS) {
        my $mdir   = File::Spec->catdir( $MODEL_DIR, $m );
        my $status = -d $mdir ? 'configured' : 'not configured';
        say sprintf( "  $C{T}%-15s$C{0}  $C{T}%s$C{0}", $m, $status );
    }
    say "  $C{T}user$C{0}  (interactive caller)";
    say $C{R};
}

sub list_archives {
    my $channel = shift;
    my $adir    = File::Spec->catdir( $ARCHIVE_DIR, $channel );

    if ( not -d $adir ) {
        say colored(": no archives for channel '$channel'");
        return;
    }

    opendir my $dh, $adir or return;
    my @files = sort
        grep { $_ =~ m{\.xz$} and -f File::Spec->catfile( $adir, $_ ) }
        readdir $dh;
    closedir $dh;

    if ( not @files ) {
        say colored(": no archives for channel '$channel'");
        return;
    }

    say colored(".: archives for channel '$channel' :.");
    for my $f (@files) {
        my $path = File::Spec->catfile( $adir, $f );
        my $size = -s $path;
        say sprintf( "  $C{T}%s$C{0}  $C{T}%d$C{0} bytes", $f, $size );
    }
    say $C{R};
}

sub search_history {
    my ( $pattern, $is_regex, $all_channels ) = @_;
    my @channels;

    if ($all_channels) {
        opendir my $dh, $CHANNEL_DIR or return;
        @channels = grep {
            $_ !~ m{^\.\.?$}
                and -d File::Spec->catdir( $CHANNEL_DIR, $_ )
        } readdir $dh;
        closedir $dh;
    } else {
        @channels = ( $state->{'active_channel'} );
    }

    for my $ch (@channels) {
        my $path = history_path($ch);
        next if not -f $path;

        open my $fh, '<:encoding(UTF-8)', $path or next;
        my @lines = <$fh>;
        close $fh;

        for my $i ( 0 .. $#lines ) {
            my $line = $lines[$i];
            chomp $line;
            my $match
                = $is_regex
                ? ( $line =~ m{$pattern} )
                : ( index( $line, $pattern ) >= 0 );
            if ($match) {
                say "  [" . ( $i + 1 ) . "]  $line";
            }
        }
    }
}

sub build_dispatch_text {
    my ( $channel, $text, $switches ) = @_;
    my $dispatch = $text;

    ## prepend cross-channel context ##
    if ( $switches->{'cross_ref'} ) {
        for my $ref ( @{ $switches->{'cross_ref'} } ) {
            my ( $ch, $n ) = @$ref;
            my @lines = fetch_history_tail( $ch, $n );
            if (@lines) {
                chomp @lines;
                my $ctx = join( "\n", map {"> [#$ch] $_"} @lines );
                $dispatch = "$ctx\n\n$dispatch";
            }
        }
    }

    ## prepend reply-to context ##
    if ( $switches->{'reply_to'} ) {
        $dispatch =~ s{\s*:reply-to:\d+:?\s*}{ }g;
        $dispatch =~ s{^\s+|\s+$}{}g;

        my $line_num = $switches->{'reply_to'};
        my $quoted   = fetch_history_line( $channel, $line_num );
        if ( defined $quoted ) {
            $dispatch = "> [reply to line $line_num]: $quoted\n\n$dispatch";
        }
    }

    return $dispatch;
}

sub fetch_history_line {
    my ( $channel, $line_num ) = @_;
    my $path = history_path($channel);
    return undef if not -f $path;

    open my $fh, '<:encoding(UTF-8)', $path or return undef;
    my @lines = <$fh>;
    close $fh;

    return undef if $line_num < 1 or $line_num > scalar @lines;

    my $line = $lines[ $line_num - 1 ];
    chomp $line;

    ## extract just the message text after timestamp and caller ##
    if ( $line =~ m{^\[[^\]]+\]\s*<[^>]+>\s*(.*)$} ) {
        return $1;
    }
    return $line;
}

sub fetch_history_tail {
    my ( $channel, $n ) = @_;
    my $path = history_path($channel);
    return () if not -f $path;

    open my $fh, '<:encoding(UTF-8)', $path or return ();
    my @lines = <$fh>;
    close $fh;

    my $start = scalar(@lines) > $n ? scalar(@lines) - $n : 0;
    return @lines[ $start .. $#lines ];
}

sub rotate_with_summary {
    my ( $channel, $model ) = @_;
    $model = 'kimi-code' if not $model or $model eq 'all';

    my $path = history_path($channel);
    return if not -f $path;

    open my $fh, '<:encoding(UTF-8)', $path or return;
    my @lines = <$fh>;
    close $fh;

    return if @lines < 4;

    my $mid   = int( @lines / 2 );
    my @older = @lines[ 0 .. $mid - 1 ];
    my @newer = @lines[ $mid .. $#lines ];

    my $prompt
        = "Please summarize the following conversation history concisely, "
        . "preserving key facts, decisions, and context:\n\n"
        . join( '', @older );

    my $summary = dispatch_summary( $model, $prompt );

    if ( defined $summary and length $summary ) {
        my $mdir = File::Spec->catdir( $MODEL_DIR, $model );
        make_path($mdir) unless -d $mdir;
        my $memory_file = File::Spec->catfile( $mdir, 'memory' );

        open my $mfh, '>>:encoding(UTF-8)', $memory_file
            or warn "chat: cannot write memory file: $!\n";
        print {$mfh} "[", timestamp(), "] $summary\n" if $mfh;
        close $mfh if $mfh;
    }

    ## archive older lines ##
    my $archive_ch = File::Spec->catdir( $ARCHIVE_DIR, $channel );
    make_path($archive_ch) unless -d $archive_ch;

    my $ts     = strftime( '%Y-%m-%dT%H:%M:%S', gmtime() );
    my $azPath = File::Spec->catfile( $archive_ch, "$ts-memory.xz" );

    my $older_str = encode_utf8( join( '', @older ) );
    xz( \$older_str, $azPath, 'Preset' => 6 )
        or warn colored(": archive compression failed");

    open my $out, '>:encoding(UTF-8)', $path
        or die colored(": cannot rewrite history : $path : $!");
    print {$out} @newer;
    close $out;

    say colored(": memory rotation — archived older half to $azPath")
        unless $option{'quiet'};
}

sub dispatch_summary {
    my ( $model, $prompt ) = @_;

    if ( $model eq 'kimi-code' ) {
        my $encoded = encode_b32r( encode_utf8($prompt) );
        open( my $fh, '-|', 'p7c', 'kimi.ask-reply', $encoded )
            or warn "chat: p7c kimi.ask-reply failed: $!\n";
        my $reply = do { local $/; <$fh> } if $fh;
        close $fh                          if $fh;
        chomp $reply                       if defined $reply;
        return $reply;
    } elsif ( $model eq 'claude-code' ) {
        ## async inbox — write prompt and poll history for response ##
        my $inbox_dir = File::Spec->catdir( $CHAT_DIR, qw| inbox | );
        make_path($inbox_dir) unless -d $inbox_dir;
        my $inbox_file = File::Spec->catfile( $inbox_dir, 'claude-code' );
        open( my $fh, '>:encoding(UTF-8)', $inbox_file )
            or warn "chat: cannot write claude-code inbox: $!\n";
        print $fh $prompt, "\n" if $fh;
        close $fh if $fh;

        ## poll active channel history for claude reply ##
        my $path      = history_path( $state->{'active_channel'} );
        my $pre_count = 0;
        if ( -f $path ) {
            open my $cfh, '<', $path or return undef;
            $pre_count++ while <$cfh>;
            close $cfh;
        }

        my $timeout = 120;
        my $elapsed = 0;
        while ( $elapsed <= $timeout ) {
            sleep $WAIT_INTERVAL;
            $elapsed += $WAIT_INTERVAL;

            open my $rfh, '<:encoding(UTF-8)', $path or next;
            my @lines = <$rfh>;
            close $rfh;

            for my $i ( $pre_count .. $#lines ) {
                if ( $lines[$i] =~ m{<claude-code>} ) {
                    chomp $lines[$i];
                    $lines[$i] =~ s{^\[[^\]]+\]\s*<claude-code>\s*}{};
                    return $lines[$i];
                }
            }
        }
        return undef;
    }
    return undef;
}

sub list_options {
    chomp( my $opt_str = $option_list );
    my @lines = split "\n", $opt_str;
    map { $ARG =~ s{(\s?\W+\s?)}{$C{B01}$C{0}$1$C{B02}$C{T}}g } @lines;
    map { $ARG = sprintf "$C{B00}$C{0}$ARG$C{R}\n" } @lines;
    say join '', @lines;
}

sub colored {
    my $text = shift;
    return $text if $option{'quiet'};
    return "$C{0}:\n::$C{b} $C{T}$text$C{0} $C{R}\n:$C{R}";
}

