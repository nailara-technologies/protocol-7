#!/usr/bin/perl

use v5.24;
use strict;
use English;
use warnings;
use Capture::Tiny qw| capture |;

my $filter_sig_only = 0;
if (@ARGV) {
    if ( $ARGV[0] eq '-sig-only' ) {
        $filter_sig_only = 1;
    } else {
        die "\n ::: error ::: [ unknown option '$ARGV[0]' ] :::\n\n"
            . "  ::[ usage ]:: $0 [-sig-only]\n  :\n"
            . "  :   [no args.]  :  list all changed files\n"
            . "  :.  -sig-only   :  list signature-only changes\n";
    }
}

my ( $stdout, $stderr, $exit ) = capture {
    system qw| git status |;
};
chomp $stdout;
my %displayed;

foreach my $line (
    sort { length $a <=> length $b }
    reverse sort split( "\n", $stdout )
) {
    $line =~ s|\e\[.*?[mJH]||g;    ##[ strip ansi colors ]##
    ##  match only git status lines (modified:, deleted:, renamed:, etc.) ##
    next unless $line =~ m/\b(modified|deleted|renamed|new file|both):/;
    $line             =~ s|^.*?:\s+||; ##  remove status label (non-greedy) ##
    next if $displayed{$line}++;

    ##  check if file only has signature changes ##
    my $has_only_sig_changes = _has_only_signature_changes($line);

    ##  filter for signature-only changes if --sig-only flag is set ##
    if ($filter_sig_only) {
        next unless $has_only_sig_changes;
    }

    say $line;
}

sub _has_only_signature_changes {
    my ($filepath) = @_;

    my ( $diff_stdout, $diff_stderr, $diff_exit ) = capture {
        system qw| git diff --no-color |, $filepath;
    };

    ##  extract only the actual diff lines (not headers) ##
    my @lines = split( "\n", $diff_stdout );
    my @code_changes;

    foreach my $diff_line (@lines) {
        ##  skip diff headers ##
        next if $diff_line =~ m|^---|;
        next if $diff_line =~ m|^\+\+\+|;
        next if $diff_line =~ m|^@@|;
        next if $diff_line =~ m|^Index:|;
        next if $diff_line =~ m|^index |;
        next if $diff_line =~ m|^diff --git|;

        ##  skip context lines (unchanged) ##
        next if $diff_line =~ m|^\ |;

        ##  skip AMOS7 signature lines ##
        ##  punctuation line (binary encoded) ##
        next if $diff_line =~ m|^[\+\-]#[,\.]+$|;
        next if $diff_line =~ m|^[\+\-]#[A-Z0-9]{64,}|;    ##  hash line ##
        ##  signature marker line (3 backslashes) ##
        next if $diff_line =~ m|^[\+\-]#\\\\\\\|.*AMOS7|;
        ##  data signature line (1 backslash) ##
        next if $diff_line =~ m|^[\+\-]#\\\[7\]|;
        next if $diff_line =~ m|^[\+\-]#:+$|;              ##  terminator ##

        ##  skip empty lines ##
        next if $diff_line eq '';

        ##  if we get here, there's a non-signature change ##
        push @code_changes, $diff_line;
    }

    ##  return true only if there are NO non-signature changes ##
    return scalar(@code_changes) == 0 ? 1 : 0;
}

