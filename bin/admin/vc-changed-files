#!/usr/bin/perl

use v5.24;
use strict;
use English;
use warnings;
use Capture::Tiny qw| capture |;

my $filter_sig_only = 0;
my $filter_exc_len  = 0;
if (@ARGV) {
    if ( $ARGV[0] eq '-sig-only' ) {
        $filter_sig_only = 1;
    } elsif ( $ARGV[0] eq '-exc-len' ) {
        $filter_exc_len = 1;
    } else {
        die "\n ::: error ::: [ unknown option '$ARGV[0]' ] :::\n\n"
            . "  ::[ usage ]:: $0 [-sig-only|-exc-len]\n  :\n"
            . "  :   [no args.]  :  list all changed files\n"
            . "  :.  -sig-only   :  list signature-only changes\n"
            . "  :.  -exc-len    :  list files with lines exceeding 78 characters\n";
    }
}

my ( $stdout, $stderr, $exit ) = capture {
    system qw| git status |;
};
chomp $stdout;
my %displayed;

foreach my $line (
    sort { length $a <=> length $b }
    reverse sort split( "\n", $stdout )
) {
    $line =~ s|\e\[.*?[mJH]||g;    ##[ strip ansi colors ]##
    ##  match only git status lines (modified:, renamed:, new file:, etc.) ##
    ##  note: deleted files are excluded to avoid issues with xargs pipelines ##
    next unless $line =~ m{\b(modified|renamed|new file|both):};
    $line =~ s|^.*?:\s+||;      ##  remove status label (non-greedy) ##
    $line =~ s|.*\s+->\s+||;    ##  for renames, keep only new filename ##
    next if $displayed{$line}++;

    ##  check if file only has signature changes ##
    my $has_only_sig_changes = _has_only_signature_changes($line);

    ##  filter for signature-only changes if --sig-only flag is set ##
    if ($filter_sig_only) {
        next unless $has_only_sig_changes;
    }

    ##  filter for lines exceeding length if --exc-len flag is set ##
    if ($filter_exc_len) {
        ##  check if file has lines exceeding 78 characters ##
        my $has_exc_len_lines = _has_lines_exceeding_length( $line, 78 );
        next unless $has_exc_len_lines;
    }

    say $line;
}

sub _has_only_signature_changes {
    my ($filepath) = @_;

    my ( $diff_stdout, $diff_stderr, $diff_exit ) = capture {
        system qw| git diff HEAD --no-color |, $filepath;
    };

    ##  extract only the actual diff lines (not headers) ##
    my @lines = split( "\n", $diff_stdout );
    my @code_changes;

    foreach my $diff_line (@lines) {
        ##  skip diff headers ##
        next if $diff_line =~ m|^---|;
        next if $diff_line =~ m|^\+\+\+|;
        next if $diff_line =~ m|^@@|;
        next if $diff_line =~ m|^Index:|;
        next if $diff_line =~ m|^index |;
        next if $diff_line =~ m|^diff --git|;

        ##  skip context lines (unchanged) ##
        next if $diff_line =~ m|^\ |;

        ##  skip AMOS7 signature lines ##
        ##  punctuation line (binary encoded) ##
        next if $diff_line =~ m|^[\+\-]#[,\.]+$|;
        next if $diff_line =~ m|^[\+\-]#[A-Z0-9]{64,}|;    ##  hash line ##
        ##  signature marker line (3 backslashes) ##
        next if $diff_line =~ m|^[\+\-]#\\\\\\\|.*AMOS7|;
        ##  data signature line (1 backslash) ##
        next if $diff_line =~ m|^[\+\-]#\\\[7\]|;
        next if $diff_line =~ m|^[\+\-]#:+$|;              ##  terminator ##

        ##  skip empty lines ##
        next if $diff_line eq '';

        ##  if we get here, there's a non-signature change ##
        push @code_changes, $diff_line;
    }

    ##  return true only if there are NO non-signature changes ##
    return scalar(@code_changes) == 0 ? 1 : 0;
}

sub _has_lines_exceeding_length {
    my ( $filepath, $max_length ) = @_;

    ##  check if file exists ##
    return 0 unless -f $filepath;

    ##  read file and check for lines exceeding max length ##
    open( my $fh, qw| <:encoding(UTF-8) |, $filepath ) or return 0;
    my $line_num = 0;
    while ( my $line = <$fh> ) {
        chomp $line;
        $line_num++;
        if ( length($line) > $max_length + 1 ) {
            printf ' :[%03d]: %02d :. ', $line_num, length($line);
            close($fh);
            return 1;
        }
    }
    close($fh);

    ##  return false if no lines exceed max length ##
    return 0;
}

