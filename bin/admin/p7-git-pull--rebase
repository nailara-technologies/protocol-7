#!/usr/bin/perl

use v5.24;
use strict;
use English;
use warnings;
use File::Spec;
use Cwd     qw| abs_path |;
use FindBin qw| $RealBin |;

our $up_dir = File::Spec->updir;
our $Bin    = $RealBin;

## safely determine protocol-7 root path ##
my $p7_root = p7_root_dir();

chdir($p7_root) or die "  :\n  :: \l$OS_ERROR : $p7_root\n\n";

## an untracked file the incoming commits start tracking with the SAME ##
## content [ e.g. a deps/.placeholder a zenka created before it was     ##
## committed ] would make the pull refuse -- it is removed, the pull    ##
## brings it back tracked. a differing file is left and still refuses   ##
system(qw| git fetch --quiet |) == 0
    or die ":\n:: git fetch failed : $OS_ERROR\n\n";

## refresh the index stat info -- a file with only a newer timestamp   ##
## [ same content ] would otherwise refuse the pull as 'not uptodate'  ##
## non-zero exit = real modifications, the check below reports those   ##
system(qw| git update-index -q --refresh |);

foreach my $path ( split m|\0|, git_out(qw| ls-files --others --exclude-standard -z |) )
{
    next if not length $path or -l $path or not -f $path;
    my $incoming = git_out( qw| rev-parse --verify --quiet |, "\@{u}:$path" );
    next if not length $incoming;
    my $local = git_out( qw| hash-object -- |, $path );
    next if $local ne $incoming;
    unlink $path
        or die ":\n:: cannot remove $path [ $OS_ERROR ]\n\n";
    print ": removed $path [ identical to the incoming tracked file ]\n";
}

print ":\n: p7-git-pull--rebase : checking "
    . "for modified or untracked files ..,\n:\n";

## check for modified or untracked files using vc-changed-files ##
my $changed_files = `$p7_root/bin/admin/vc-changed-files 2>&1`;
chomp($changed_files);

if ( length($changed_files) ) {
    print ":\n: error : found modified or untracked files :\n";
    print ":   $_\n" for split( "\n", $changed_files );
    print ":\n: please commit or stash changes before pulling .\n:\n";
    exit 1;
}

print ": no modified or untracked files detected ..\n";
print ": proceeding with git pull --rebase ..\n:\n";

## run git pull --rebase ##
my $rebase_exit = system(qw| git pull --rebase |);
if ( $rebase_exit != 0 ) {
    ## check if we're in a rebase state (conflict during rebase)
    if ( -f '.git/REBASE_HEAD' ) {
        print "\n:\n: rebase conflict detected, "
            . "attempting to continue ..\n:\n";
        my $continue_exit = system(qw| git rebase --continue |);
        if ( $continue_exit != 0 ) {
            die ":\n:: git rebase --continue failed : $OS_ERROR\n\n";
        }
        print "\n:\n: rebase continued successfully .\n:\n";
    } else {
        die ":\n:: git pull --rebase failed : $OS_ERROR\n\n";
    }
} else {
    print "\n:\n: git pull --rebase completed successfully .\n:\n";
}

## restore file permissions (fixes perms even without git hooks) ##
print ": restoring file permissions after pull ..\n:\n";

system(qw| bin/admin/restore-p7-permissions |) == 0
    or die ":\n:: restore-p7-permissions failed : $OS_ERROR\n\n";

print "\n:\n: file permissions restored successfully .\n:\n";

exit 0;

#[ SUBROUTINES ]##############################################################

## git output without a shell [ list form ], trailing newline removed ; ##
## '' when git fails                                                    ##
sub git_out {
    open( my $pipe, '-|', qw| git |, @_ ) or return '';
    local $RS = undef;
    my $out = <$pipe> // '';
    close($pipe) or return '';
    $out =~ s|\n\z||;
    return $out;
}

sub c_dir  { File::Spec->catdir(@_) }
sub r2_abs { File::Spec->rel2abs(@_) }

sub p7_root_dir {
    my $root_path = abs_path( r2_abs( c_dir( $Bin, ($up_dir) x 2 ) ) );
    die "  :\n  :: not a directory : '$root_path'\n\n" if !-d $root_path;
    return $root_path;
}

