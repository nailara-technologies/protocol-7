#!/usr/bin/perl
use v5.32.0;
## after a host rename : merge <old>.<x>.zenka.log slices into
## <new>.<x>.zenka.log by ntime, in place. usage : <old> <new> [ <dir> ]
## [ -apply ]
use strict;
use warnings;
use FindBin;
use lib "$FindBin::RealBin/../../data/lib-path/pm",
    '/usr/local/protocol' . '-7/data/lib-path/pm';
use AMOS7::NTIME qw| b32_to_unix |;
my $apply = grep { $_ eq '-apply' } @ARGV;
my ( $from, $to, $dir ) = grep { $_ ne '-apply' } @ARGV;
die "usage : $0 <old-host> <new-host> [ <log-dir> ] [ -apply ]\n"
    if not defined $to;
$dir //= '/var/log/protocol-7';
chdir $dir or die "$dir : $!\n";

sub records {
    my ( $file, $src ) = @_;
    open( my $fh, '<:raw', $file ) or die "$file : $!";
    my ( @rec, $t );
    my $n = 0;
    while ( my $line = <$fh> ) {
        if ( $line =~ m|\A([A-Z2-7]{15}) | ) {
            my $u = eval { b32_to_unix($1) };
            $t = $u if defined $u;
            push @rec, [ $t // 0, $src, $n++, $line ];
        } elsif (@rec) {
            $rec[-1][3] .= $line;
        } else {
            push @rec, [ 0, $src, $n++, $line ];
        }
    }
    return \@rec;
}
foreach my $old ( sort glob "$from.*.zenka.log" ) {
    for my $try ( 1 .. 5 ) {
        ( my $new = $old ) =~ s|\A\Q$from\E\.|$to.|;
        if ( not -f $new ) {
            print "$old : no $new, renamed\n";
            rename $old, $new or die if $apply;
            last;
        }
        my $size = -s $new;
        my ( $a, $b ) = ( records( $new, 0 ), records( $old, 1 ) );
        ## two-way merge : each file keeps its own order ##
        my @all;
        my ( $i, $j ) = ( 0, 0 );
        while ( $i < @$a or $j < @$b ) {
            if ( $j >= @$b or $i < @$a and $a->[$i][0] <= $b->[$j][0] ) {
                push @all, $a->[ $i++ ];
            } else {
                push @all, $b->[ $j++ ];
            }
        }
        my $body = join '', map { $_->[3] } @all;
        my $want = $size + -s $old;
        printf "%-28s %6d + %6d records -> %6d, bytes %s\n", $new,
            scalar @$a, scalar @$b, scalar @all, length $body == $want
            ? 'ok'
            : "MISMATCH " . length($body) . " vs $want";
        last if not $apply;
        next if length $body != $want;
        open( my $fh, '+<:raw', $new ) or die;
        if ( -s $fh != $size ) {
            print "  $new grew while reading, retry\n";
            close $fh;
            next;
        }
        seek $fh, 0, 0;
        print {$fh} $body;
        truncate $fh, length $body;
        close $fh   or die;
        unlink $old or die;
        print "  merged\n";
        last;
    }
}

