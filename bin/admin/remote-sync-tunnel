#!/usr/bin/env perl
use strict;
use warnings;
use Net::Ping;
use File::Spec;
use Sys::Syslog qw(:standard :macros);
use POSIX       qw(EXIT_SUCCESS EXIT_FAILURE);

## remote-sync-tunnel: manage mounted remote code/content with auto-ssh
## tunneling sets up persistent SSH tunnels and mounts for remote protocol-7
## systems automatically detects server recovery and remounts after crashes

my $REMOTE_HOST      = $ENV{'REMOTE_P7_HOST'} // 'atom.local';
my $REMOTE_USER      = $ENV{'REMOTE_P7_USER'} // 'taeki';
my $LOCAL_MOUNT_BASE = '/mnt/remote-protocol-7';

my %MOUNTS = (
    'code' => {
        local  => '/usr/local/protocol-7',
        remote => '/data/projects/protocol-7'
    },
    'content' => { local => '/var/httpd', remote => '/var/www' },
    'logs'    =>
        { local => '/var/log/protocol-7', remote => '/var/log/protocol-7' },
);

my %TUNNELS = (
    'p7c' => {
        local_port  => 7777,
        remote_host => '127.0.0.1',
        remote_port => 7777
    },
    'p7r' => {
        local_port  => 7778,
        remote_host => '127.0.0.1',
        remote_port => 7778
    },
);

my $ACTION            = shift // 'start';
my $AUTOSSH_PID_FILE  = "/var/run/autossh-${REMOTE_HOST}.pid";
my $MOUNT_STATUS_FILE = "/var/run/p7-mount-${REMOTE_HOST}.status";

openlog( 'remote-sync-tunnel', LOG_PID, LOG_USER );

sub log_msg {
    my ( $level, $msg ) = @_;
    syslog( $level, $msg );
    print STDERR "[$level] $msg\n";
}

sub check_server_alive {
    my $p = Net::Ping->new( 'tcp', 2 );
    $p->port_number(22);    ## check SSH port
    my $result = $p->ping($REMOTE_HOST);
    $p->close;
    return $result;
}

sub create_mount_dirs {
    foreach my $mount ( values %MOUNTS ) {
        my $dir = $mount->{'local'};
        next if -d $dir;
        system("mkdir -p '$dir'") == 0 or do {
            log_msg( LOG_ERR, "failed to create mount directory: $dir" );
            return 0;
        };
    }
    return 1;
}

sub is_mounted {
    my ($mount_point) = @_;
    open( my $fh, '<', '/proc/mounts' ) or return 0;
    while (<$fh>) {
        return 1 if m|$mount_point|;
    }
    close($fh);
    return 0;
}

sub mount_remote {
    my ( $name, $config ) = @_;
    my $local  = $config->{'local'};
    my $remote = $config->{'remote'};

    return 1 if is_mounted($local);

    ## use sshfs for remote mounting
    my $cmd = "sshfs -o reconnect,ServerAliveInterval=60 "
        . "'${REMOTE_USER}\@${REMOTE_HOST}:${remote}' '$local'";

    if ( system($cmd) == 0 ) {
        log_msg( LOG_INFO, "mounted $name: $local" );
        return 1;
    } else {
        log_msg( LOG_ERR, "failed to mount $name: $local" );
        return 0;
    }
}

sub unmount_remote {
    my ( $name, $config ) = @_;
    my $local = $config->{'local'};

    return 1 unless is_mounted($local);

    ## gracefully unmount with retries
    for my $attempt ( 1 .. 3 ) {
        if ( system("fusermount -u '$local'") == 0 ) {
            log_msg( LOG_INFO, "unmounted $name: $local" );
            return 1;
        }
        sleep(1) if $attempt < 3;
    }

    log_msg( LOG_WARNING, "forced unmount of $name: $local" );
    system("fusermount -uz '$local'");
    return 1;
}

sub setup_tunnels {
    my $ssh_opts = '-N -T -o ServerAliveInterval=60 -o ServerAliveCountMax=3';
    my @tunnel_args;

    foreach my $name ( keys %TUNNELS ) {
        my $t = $TUNNELS{$name};
        push @tunnel_args,
            "-L $t->{'local_port'}:$t->{'remote_host'}:$t->{'remote_port'}";
    }

    my $tunnel_str = join( ' ', @tunnel_args );
    my $cmd        = "autossh -M 0 $ssh_opts $tunnel_str "
        . "${REMOTE_USER}\@${REMOTE_HOST}";

    log_msg( LOG_INFO, "starting autossh tunnel to $REMOTE_HOST" );
    system("nohup $cmd > /var/log/autossh-${REMOTE_HOST}.log 2>&1 &");

    return 1;
}

sub stop_tunnels {
    system("pkill -f 'autossh.*$REMOTE_HOST'");
    log_msg( LOG_INFO, "stopped autossh tunnels" );
    return 1;
}

sub start_service {
    log_msg( LOG_INFO, "starting remote-sync-tunnel for $REMOTE_HOST" );

    ## check server is reachable
    unless ( check_server_alive() ) {
        log_msg( LOG_ERR, "server $REMOTE_HOST is not reachable" );
        return EXIT_FAILURE;
    }

    create_mount_dirs() or return EXIT_FAILURE;
    setup_tunnels()     or return EXIT_FAILURE;

    ## mount all directories
    my $all_ok = 1;
    foreach my $name ( keys %MOUNTS ) {
        mount_remote( $name, $MOUNTS{$name} ) or $all_ok = 0;
    }

    if ($all_ok) {
        open( my $fh, '>', $MOUNT_STATUS_FILE );
        print $fh "mounted\n";
        close($fh);
        log_msg( LOG_INFO, "all mounts established successfully" );
        return EXIT_SUCCESS;
    } else {
        log_msg( LOG_WARNING, "some mounts failed, but tunnels are active" );
        return EXIT_FAILURE;
    }
}

sub stop_service {
    log_msg( LOG_INFO, "stopping remote-sync-tunnel" );

    ## unmount all directories
    foreach my $name ( keys %MOUNTS ) {
        unmount_remote( $name, $MOUNTS{$name} );
    }

    stop_tunnels();
    unlink($MOUNT_STATUS_FILE) if -f $MOUNT_STATUS_FILE;

    log_msg( LOG_INFO, "remote-sync-tunnel stopped" );
    return EXIT_SUCCESS;
}

sub monitor_and_recover {
    ## continuous monitoring with auto-recovery on server return
    log_msg( LOG_INFO, "entering monitor mode for $REMOTE_HOST" );

    my $was_mounted    = 1;
    my $check_interval = 30;    ## seconds

    while (1) {
        sleep($check_interval);

        my $alive = check_server_alive();
        my $currently_mounted
            = -f $MOUNT_STATUS_FILE && -e $MOUNT_STATUS_FILE;

        if ( $alive && !$currently_mounted ) {
            log_msg( LOG_INFO, "server recovered, attempting remount" );
            start_service();
        } elsif ( !$alive && $currently_mounted ) {
            log_msg( LOG_WARNING, "server went offline, unmounting" );
            stop_service();
        }
    }
}

sub usage {
    print STDERR <<"EOF";
Usage: $0 [start|stop|restart|monitor|status]

Commands:
  start     - Set up tunnels and mounts
  stop      - Unmount and close tunnels
  restart   - Restart tunnels and mounts
  monitor   - Run in monitoring mode with auto-recovery
  status    - Show current mount/tunnel status

Environment Variables:
  REMOTE_P7_HOST   - Remote hostname (default: atom.local)
  REMOTE_P7_USER   - Remote username (default: taeki)

EOF
    exit EXIT_FAILURE;
}

## main dispatch
if ( $ACTION eq 'start' ) {
    exit start_service();
} elsif ( $ACTION eq 'stop' ) {
    exit stop_service();
} elsif ( $ACTION eq 'restart' ) {
    stop_service();
    exit start_service();
} elsif ( $ACTION eq 'monitor' ) {
    monitor_and_recover();
} elsif ( $ACTION eq 'status' ) {
    print "Server reachable: ", ( check_server_alive() ? "yes" : "no" ), "\n";
    foreach my $name ( keys %MOUNTS ) {
        my $local = $MOUNTS{$name}->{'local'};
        print "  $name: ", ( is_mounted($local) ? "mounted" : "unmounted" ),
            "\n";
    }
    exit EXIT_SUCCESS;
} else {
    usage();
}

closelog();

