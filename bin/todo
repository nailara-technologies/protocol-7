#!/usr/bin/perl
use v5.24;
use strict;
use warnings;
use English;
use utf8;

###         ###
##   todo    ##
###         ###

##[ PROJECT ROOT + DEFAULT TODO PATH ]########################################

BEGIN {
    use File::Spec;
    use Cwd     qw| abs_path |;
    use FindBin qw| $RealBin |;
    my $up_dir    = File::Spec->updir;
    my $root_path = abs_path(
        File::Spec->rel2abs( File::Spec->catdir( $RealBin, $up_dir ) ) );
    $ENV{'P7_ROOT'} //= $root_path if defined $root_path and -d $root_path;

    ## make the project-local AMOS7 pm tree loadable for standalone use ##
    my $lib_pm = defined $root_path ? "$root_path/data/lib-path/pm" : undef;
    unshift @INC, $lib_pm if defined $lib_pm and -d $lib_pm;
}

use AMOS7::TERM qw| frame_border_line |;
use AMOS7::CHKSUM;
use AMOS7::Assert::Truth;

my $root      = $ENV{'P7_ROOT'} // '';
my $list_name = 'default';

## parse -file / -list / $P7_TODO_FILE before other args
my @argv_clean;
my $i = 0;
while ( $i < @ARGV ) {
    if ( $ARGV[$i] eq '-file' and defined $ARGV[ $i + 1 ] ) {
        $ENV{'P7_TODO_FILE'} = $ARGV[ $i + 1 ];
        $i += 2;
    } elsif ( $ARGV[$i] eq '-list' and defined $ARGV[ $i + 1 ] ) {
        $list_name = $ARGV[ $i + 1 ];
        $i += 2;
    } elsif ( $ARGV[$i] =~ m{^-list=(.+)$} ) {
        $list_name = $1;
        $i++;
    } else {
        push @argv_clean, $ARGV[$i];
        $i++;
    }
}
@ARGV = @argv_clean;

my $TODO_FILE
    = defined $ENV{'P7_TODO_FILE'} ? $ENV{'P7_TODO_FILE'}
    : length $root
    && -d "$root/data/yaml/todo" ? "$root/data/yaml/todo/$list_name.yaml"
    : length $root
    && -d "$root/data/yaml" ? do {
    mkdir "$root/data/yaml/todo", 0755;
    "$root/data/yaml/todo/$list_name.yaml";
    }
    : $ENV{'HOME'} . "/.p7/todo.yaml";
my $TTY = -t STDOUT;

binmode( STDOUT, ':utf8' );

##[ terminal width ]##########################################################

my $TERM_WIDTH = 72;
if ($TTY) {
    my $cols = `tput cols 2>/dev/null`;
    chomp $cols if defined $cols;
    $TERM_WIDTH = int($cols)
        if defined $cols
        and $cols =~ m{^\d+$}
        and $cols >= 40;
}

##[ color scheme ]############################################################

my %C;
if ($TTY) {
    %C = (
        T => $AMOS7::TERM::p7_colors{'p7_fg_0004'},  ## TRUE blue (titles)
        0 => $AMOS7::TERM::p7_colors{'p7_fg_0000'},  ## purple
        2 => $AMOS7::TERM::p7_colors{'p7_fg_0002'},  ## neon orange [ high ]
        3 => $AMOS7::TERM::p7_colors{'p7_fg_0003'},  ## phosphor green [ low ]
        g => $AMOS7::TERM::p7_colors{'p7_fg_0003'},  ## phosphor green
        B => "\e[1m",                                ## bold
        R => "\e[0m",                                ## reset
        dim => "\e[2m",                              ## dim
    );
}

##[ yaml module selection ]###################################################

my ( $yaml_load, $yaml_dump );

for my $mod (qw| YAML::PP YAML::XS YAML |) {
    my $file = $mod;
    $file =~ s|::|/|g;
    $file .= '.pm';
    eval { require $file; 1 } or next;

    if ( $mod eq 'YAML::PP' ) {
        my $yp = YAML::PP->new;
        $yaml_load = sub { $yp->load_string(shift) };
        $yaml_dump = sub { $yp->dump_string(shift) };
    } elsif ( $mod eq 'YAML::XS' ) {
        $yaml_load = \&YAML::XS::Load;
        $yaml_dump = \&YAML::XS::Dump;
    } else {
        $yaml_load = \&YAML::Load;
        $yaml_dump = \&YAML::Dump;
    }
    last;
}

die "no yaml module found (need YAML::PP, YAML::XS, or YAML)\n"
    unless defined $yaml_load;

##[ data access ]#############################################################

sub iso_now {
    my @t = localtime;
    return sprintf '%04d-%02d-%02dT%02d:%02d:%02d',
        $t[5] + 1900, $t[4] + 1, $t[3], $t[2], $t[1], $t[0];
}

##[ item id : random 3-char amos-chksum code, collision + harmony checked ]##
##
## mirrors modules/base.gen_id's shape [ random candidate, retry on collision,
## optional harmonic gate via AMOS7::Assert::Truth::is_true ] -- base.gen_id
## itself can't be called here: it's a zenka module using the <[...]> routing
## syntax and depends on <base.prng.fortuna>, a PRNG object living in a
## running zenka's state, not available to this standalone script. rand()
## substitutes for Fortuna; the collision-check + harmonic gate are the same
## idea. the id itself IS the display code -- no separate numeric id + derived
## chk to keep in sync; deleting an item frees its code for reuse, since
## collision-checking only ever looks at items still present in the file.

sub chk3 {
    my $seed = shift;
    local $AMOS7::CHKSUM::str_length = 3;
    ## amos_chksum returns a 2-elem list in list context [ encoded, numeric ]
    ## -- force scalar here or a hash-literal caller silently gets 2 values
    return scalar AMOS7::CHKSUM::amos_chksum("$seed");
}

sub gen_id {
    my $items = shift;

    my %used;
    $used{ uc( $_->{id} // '' ) } = 1 foreach $items->@*;

    my $want_harmony = 1;
    my $max_retries  = 200;

    for my $try ( 1 .. $max_retries ) {
        my $seed      = join( '-', time, $PID, rand(1e9), $try );
        my $candidate = chk3($seed);
        ## exclude anything that could be mistaken for a legacy numeric id on
        ## a future load_data() call [ same pattern load_data uses to detect
        ## legacy items -- measured ~0.57% of candidates land here ]
        next if $candidate =~ m{^\d+$};
        next if $used{ uc($candidate) };
        next
            if $want_harmony
            and not AMOS7::Assert::Truth::is_true($candidate);
        return $candidate;
    }

    ## harmonic space is ~99.6% of all codes [ measured ] -- if this many ##
    ## retries failed, drop the harmony gate rather than fail outright    ##
    for my $try ( 1 .. $max_retries ) {
        my $seed      = join( '-', time, $PID, rand(1e9), 'noharm', $try );
        my $candidate = chk3($seed);
        next if $candidate =~ m{^\d+$};
        return $candidate unless $used{ uc($candidate) };
    }

    die "todo: could not allocate a free id (space exhausted?)\n";
}

sub resolve_id {
    my ( $id_str, $items ) = @_;
    return undef unless defined $id_str and length $id_str;

    my $needle = uc($id_str);
    foreach my $item ( $items->@* ) {
        return $item->{id} if uc( $item->{id} // '' ) eq $needle;
    }
    return undef;
}

sub load_data {
    return { items => [] } unless -f $TODO_FILE;

    open my $fh, '<', $TODO_FILE
        or die "cannot read todo file: $!\n";
    local $/;
    my $content = <$fh>;
    close $fh;

    my $data = eval { $yaml_load->($content) };
    $data = { items => [] } if not defined $data;
    $data->{items} //= [];
    delete $data->{next_id};    ## legacy monotonic counter, no longer used ##

    ## migrate legacy schema : numeric id + separate derived chk field -> ##
    ## single random id [ reuse the already-computed chk if present, so   ##
    ## existing display codes don't needlessly churn on upgrade ]         ##
    my $dirty = 0;
    foreach my $item ( $data->{items}->@* ) {
        next unless defined $item->{id} and $item->{id} =~ m{^\d+$};
        $item->{id} = delete( $item->{chk} ) // chk3( $item->{id} );
        $dirty = 1;
    }
    save_data($data) if $dirty;

    return $data;
}

sub save_data {
    my $data = shift;

    my $dir = $TODO_FILE;
    $dir =~ s|/[^/]+$||;
    if ( not -d $dir ) {
        require File::Path;
        File::Path::make_path($dir);
    }

    open my $fh, '>', $TODO_FILE
        or die "cannot write todo file: $!\n";
    print $fh $yaml_dump->($data);
    close $fh;
}

##[ item helpers ]############################################################

sub count_items {
    my $items = shift;
    my $open  = scalar grep { $_->{status} eq 'open' } $items->@*;
    my $done  = scalar grep { $_->{status} eq 'done' } $items->@*;
    my $high
        = scalar grep { $_->{status} eq 'open' and $_->{priority} eq 'high' }
        $items->@*;
    return ( $open, $done, $high );
}

##[ display ]#################################################################

sub draw_header {
    my $width = shift // $TERM_WIDTH;
    say AMOS7::TERM::frame_border_line(
        {   width    => $width,
            reset    => $C{R} // '',
            elements => [
                {   type  => 'anchor',
                    value => ' .: todo :. ',
                    color => $C{T} // '',
                },
                {   type  => 'fill',
                    char  => '─',
                    min   => 1,
                    color => $C{0} // '',
                },
            ],
        }
    );
}

sub draw_footer {
    my ( $width, $open, $done, $high ) = @_;
    $width //= $TERM_WIDTH;
    my $text = "[ $open open · $done done · $high high ]";
    say AMOS7::TERM::frame_border_line(
        {   width    => $width,
            reset    => $C{R} // '',
            elements => [
                {   type  => 'fill',
                    char  => '─',
                    min   => 1,
                    color => $C{0} // '',
                },
                { type => 'anchor', value => $text, color => $C{T} // '' },
                { type => 'anchor', value => '──', color => $C{0} // '' },
            ],
        }
    );
}

sub format_items {
    my ( $items, $show_done ) = @_;

    my $max_id_len = 1;
    foreach my $item ( $items->@* ) {
        my $l = length( $item->{id} );
        $max_id_len = $l if $l > $max_id_len;
    }

    my $max_width = 0;
    my @rows;

    foreach my $item ( $items->@* ) {
        ## marker always occupies exactly one column [ space when unused ] ##
        ## so the id/text columns don't shift between marked/unmarked rows ##
        my ( $marker, $c_start, $c_end ) = ( ' ', '', '' );

        if ( $item->{status} eq 'done' ) {
            $marker = '✓';
            if ( $TTY and $show_done ) {
                $c_start = $C{dim} . $C{3};    ## dim phosphor green ##
                $c_end   = $C{R};
            }
        } elsif ( $item->{priority} eq 'high' ) {
            $marker = '△';
            if ($TTY) {
                $c_start = $C{3};              ## phosphor green ##
                $c_end   = $C{R};
            }
        } elsif ( $item->{priority} eq 'low' ) {
            $marker = '▽';
            if ($TTY) {
                $c_start = $C{0};              ## blacklight ##
                $c_end   = $C{R};
            }
        } else {
            if ($TTY) {
                ## TRUE blue [ normal priority ] ##
                $c_start = $C{T};
                $c_end   = $C{R};
            }
        }

        my $id_str = sprintf "%-*s", $max_id_len, $item->{id};
        my $prefix = "  $marker  $id_str ·  ";
        my $text   = $item->{text} // '';
        my $tags   = '';
        if ( $item->{tags} and $item->{tags}->@* ) {
            $tags = ' [ ' . join( ' · ', $item->{tags}->@* ) . ' ]';
        }

        my $vis_len = length($prefix) + length($text) + length($tags);
        $max_width = $vis_len if $vis_len > $max_width;

        push @rows,
            {
            prefix  => $prefix,
            text    => $text,
            tags    => $tags,
            c_start => $c_start,
            c_end   => $c_end,
            vis_len => $vis_len,
            };
    }

    $max_width = 50 if $max_width < 50;

    my @lines;
    foreach my $row (@rows) {
        my $pad = '';
        if ( length( $row->{tags} ) > 0 ) {
            my $n = $max_width - $row->{vis_len};
            $n   = 0 if $n < 0;
            $pad = ' ' x $n;
        }
        push @lines,
              $row->{c_start}
            . $row->{prefix}
            . $row->{text}
            . $pad
            . $row->{tags}
            . $row->{c_end};
    }

    return ( \@lines, $max_width );
}

##[ options / help ]##########################################################

my $option_list = <<'EOL';

    .: todo command line options :.

    list [open|done|all|<tag>] .....  list items [ default : open ]
    add [-h|-l] [-t tag,..] <text> .  add a new item
    done <id> [<id>..] .............  mark item[s] as done
    del <id> .......................  remove an item
    edit <id> <text> ...............  replace item text
    pri <id> <high|normal|low> .....  change item priority
    tag <id> <tag> .................  add a tag to an item
    untag <id> <tag> ...............  remove a tag from an item
    clear ..........................  remove all done items
    reset ..........................  remove all items [ tty confirm ]

    <id> above accepts either the permanent numeric id or the short
    chk code shown in the listing [ e.g. 'X6O' ] -- both resolve to the
    same item.

    -file <path> ...................  use given todo file
    -list <name> ...................  use named list [ default : default ]

    -options / help ................  show this option list

EOL

sub list_options {
    if ( not $TTY ) {
        print $option_list;
        return;
    }
    chomp( my $s = $option_list );
    my @lines = split "\n", $s;
    ## structural punctuation in $C{0}, textual content in $C{T} ##
    for my $l (@lines) {
        $l =~ s|(\s?\W+\s?)|$C{0}$1$C{T}|g;
        print "$C{T}$l$C{R}\n";
    }
    print "\n";
}

##[ commands ]################################################################

sub cmd_list {
    my $filter = shift // 'open';

    my $data  = load_data();
    my @items = $data->{items}->@*;

    my $show_done = 0;
    if ( $filter eq 'all' ) {
        $show_done = 1;
    } elsif ( $filter eq 'done' ) {
        @items     = grep { $_->{status} eq 'done' } @items;
        $show_done = 1;
    } elsif ( $filter eq 'open' ) {
        @items = grep { $_->{status} eq 'open' } @items;
    } else {
        my $tag = $filter;
        @items = grep {
            my $t = $_;
            grep { $_ eq $tag } $t->{tags}->@*
        } @items;
    }

    ## id is now a random code, not a creation-ordered sequence, so it's   ##
    ## meaningless as a sort key. use this project's default two-pass sort ##
    ## [ modules/base.sort : ascending length, ties broken by descending   ##
    ## alpha, via a reverse-then-stable-sort ] on item text instead of     ##
    ## base.sort's plain scalars -- same shape, keyed on ->{text}          ##
    @items = sort { length( $a->{text} ) <=> length( $b->{text} ) }
        reverse sort { $a->{text} cmp $b->{text} }
        grep { defined $_->{text} } @items;

    my ( $lines, $content_width ) = format_items( \@items, $show_done );
    my $width = $TERM_WIDTH;
    $width = $content_width + 4 if $content_width + 4 > $width;

    say "";
    draw_header($width);
    say "";

    if ( @items == 0 ) {
        say "  "
            . ( $C{dim} // '' )
            . ( $C{3}   // '' )
            . "no items"
            . ( $C{R} // '' );
    } else {
        say for @$lines;
    }

    say "";
    my ( $open, $done, $high ) = count_items( $data->{items} );
    draw_footer( $width, $open, $done, $high );
    say "";
}

sub cmd_add {
    my @args = @_;

    my $priority = 'normal';
    my @tags;

    while ( @args and $args[0] =~ m{^-} ) {
        my $flag = shift @args;
        if    ( $flag eq '-h' ) { $priority = 'high' }
        elsif ( $flag eq '-l' ) { $priority = 'low' }
        elsif ( $flag eq '-t' ) {
            die "expected tag list after -t\n" unless @args;
            @tags = split /,/, shift @args;
        } else {
            die "unknown flag: $flag\n";
        }
    }

    die "expected todo text\n" unless @args;
    my $text = join ' ', @args;

    my $data = load_data();
    my $id   = gen_id( $data->{items} );

    push $data->{items}->@*,
        {
        id       => $id,
        text     => $text,
        status   => 'open',
        priority => $priority,
        tags     => [@tags],
        added    => iso_now(),
        done_at  => undef,
        };

    save_data($data);
}

sub cmd_done {
    my @ids = @_;
    die "expected item id\n" unless @ids;

    my $data  = load_data();
    my $found = 0;

    foreach my $id_str (@ids) {
        my $id = resolve_id( $id_str, $data->{items} );
        foreach my $item ( $data->{items}->@* ) {
            next unless defined $id and $item->{id} eq $id;
            $item->{status}  = 'done';
            $item->{done_at} = iso_now();
            $found           = 1;
            last;
        }
    }

    die "item not found\n" unless $found;
    save_data($data);
}

sub cmd_del {
    my $id_str = shift // die "expected item id\n";

    my $data   = load_data();
    my $id     = resolve_id( $id_str, $data->{items} );
    my $before = scalar $data->{items}->@*;
    $data->{items}
        = [ grep { !defined $id or $_->{id} ne $id } $data->{items}->@* ];

    die "item $id_str not found\n"
        if scalar( $data->{items}->@* ) == $before;
    save_data($data);
}

sub cmd_edit {
    my $id_str = shift // die "expected item id\n";
    die "expected new text\n" unless @_;

    my $text = join ' ', @_;
    my $data = load_data();
    my $id   = resolve_id( $id_str, $data->{items} );

    foreach my $item ( $data->{items}->@* ) {
        next unless defined $id and $item->{id} eq $id;
        $item->{text} = $text;
        save_data($data);
        return;
    }

    die "item $id_str not found\n";
}

sub cmd_pri {
    my ( $id_str, $priority ) = @_;
    die "expected item id and priority\n"
        unless defined $id_str and defined $priority;
    die "priority must be high, normal, or low\n"
        unless $priority =~ m{^(?:high|normal|low)$};

    my $data = load_data();
    my $id   = resolve_id( $id_str, $data->{items} );

    foreach my $item ( $data->{items}->@* ) {
        next unless defined $id and $item->{id} eq $id;
        $item->{priority} = $priority;
        save_data($data);
        return;
    }

    die "item $id_str not found\n";
}

sub cmd_tag {
    my ( $id_str, $tag ) = @_;
    die "expected item id and tag\n"
        unless defined $id_str and defined $tag;

    my $data = load_data();
    my $id   = resolve_id( $id_str, $data->{items} );

    foreach my $item ( $data->{items}->@* ) {
        next unless defined $id and $item->{id} eq $id;
        my %have = map { $_ => 1 } $item->{tags}->@*;
        push $item->{tags}->@*, $tag unless $have{$tag};
        save_data($data);
        return;
    }

    die "item $id_str not found\n";
}

sub cmd_untag {
    my ( $id_str, $tag ) = @_;
    die "expected item id and tag\n"
        unless defined $id_str and defined $tag;

    my $data = load_data();
    my $id   = resolve_id( $id_str, $data->{items} );

    foreach my $item ( $data->{items}->@* ) {
        next unless defined $id and $item->{id} eq $id;
        $item->{tags} = [ grep { $_ ne $tag } $item->{tags}->@* ];
        save_data($data);
        return;
    }

    die "item $id_str not found\n";
}

sub cmd_clear {
    my $data = load_data();
    $data->{items}
        = [ grep { $_->{status} ne 'done' } $data->{items}->@* ];
    save_data($data);
}

sub cmd_reset {
    if ($TTY) {
        print "remove all items? [y/N] ";
        my $ans = <STDIN>;
        chomp $ans if defined $ans;
        if ( not defined $ans or $ans !~ m{^y}i ) {
            say "cancelled" if $TTY;
            return;
        }
    } else {
        die "reset requires tty for confirmation\n";
    }

    save_data( { items => [], next_id => 1 } );
}

##[ dispatch ]################################################################

my $cmd = shift @ARGV // 'list';

if ( $cmd eq 'list' or $cmd eq '' ) {
    my $filter = shift @ARGV // 'open';
    cmd_list($filter);
} elsif ( $cmd eq 'add' ) {
    cmd_add(@ARGV);
} elsif ( $cmd eq 'done' ) {
    cmd_done(@ARGV);
} elsif ( $cmd eq 'del' ) {
    cmd_del(@ARGV);
} elsif ( $cmd eq 'edit' ) {
    cmd_edit(@ARGV);
} elsif ( $cmd eq 'pri' ) {
    cmd_pri(@ARGV);
} elsif ( $cmd eq 'tag' ) {
    cmd_tag(@ARGV);
} elsif ( $cmd eq 'untag' ) {
    cmd_untag(@ARGV);
} elsif ( $cmd eq 'clear' ) {
    cmd_clear();
} elsif ( $cmd eq 'reset' ) {
    cmd_reset();
} elsif ( $cmd eq '-options' or $cmd eq 'help' or $cmd eq '-h' ) {
    list_options();
} else {
    warn "unknown command: $cmd\n\n";
    list_options();
    exit 1;
}

exit 0;

