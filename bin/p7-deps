#!/usr/bin/env perl
# Protocol-7 Dependency Management System
# Profile-based dependency installation and verification

use strict;
use warnings;
use FindBin qw($RealBin);
use File::Spec;
use File::Path qw(make_path);
use Cwd        qw(abs_path);
use English;

BEGIN {
    use lib "$RealBin/../data/lib-path/pm";
}

use AMOS7::deps::module qw(
    load_known_deps
    scan_zenki_pm_deps
    probe_module
    resolve_install
);
use AMOS7::deps::os_package qw(
    detect_os
    scan_zenki_os_deps
    probe_os_pkg
    probe_binary
);
use AMOS7::deps::debp      qw( probe_apt install_apt );
use AMOS7::deps::dist_upgr ();
use AMOS7::TERM            qw| frame_border_line |;

$OUTPUT_AUTOFLUSH = 1;

## color palette [ pulled from shared %AMOS7::TERM::p7_colors ]
my $TTY        = -t STDOUT;
my $reset      = $TTY ? "\e[0m"                               : '';
my $blacklight = $TTY ? $AMOS7::TERM::p7_colors{'p7_fg_0000'} : '';  ## purple
my $TRUE_color
    = $TTY ? $AMOS7::TERM::p7_colors{'p7_fg_0004'} : '';    ## TRUE blue
my $neon_green
    = $TTY ? $AMOS7::TERM::p7_colors{'p7_fg_0006'} : '';    ## neon green
my $neon_amber
    = $TTY ? $AMOS7::TERM::p7_colors{'p7_fg_0005'} : '';    ## neon amber

## terminal width [ adapts to real tty size for framed output ]
my $TERM_WIDTH = 72;
if ($TTY) {
    my $cols = `tput cols 2>/dev/null`;
    chomp $cols if defined $cols;
    $TERM_WIDTH = int($cols)
        if defined $cols
        and $cols =~ m{^\d+$}
        and $cols >= 40;
}

##[ SIGNAL HANDLERS ]#########################################################

$SIG{INT} = sub {
    print "\n${neon_amber}:. interrupted by user${reset}\n";
    exit 130;
};

##[ PROJECT PATH DISCOVERY ]##################################################

sub catdir  { File::Spec->catdir(@_) }
sub rel2abs { File::Spec->rel2abs(@_) }

my $up_dir  = File::Spec->updir;
my $P7_ROOT = abs_path( rel2abs( catdir( $RealBin, $up_dir ) ) );

my $DEPS_DIR      = catdir( $P7_ROOT, '.deps' );
my $PROFILES_FILE = File::Spec->catfile( $DEPS_DIR, 'profiles.yaml' );
my $CACHE_DIR     = catdir( $DEPS_DIR, 'cache' );
my $ZENKI_DIR     = catdir( $P7_ROOT,  'cfg', 'zenki' );

make_path($CACHE_DIR) unless -d $CACHE_DIR;

my %pkg_cache  = ();
my $known_deps = load_known_deps($P7_ROOT);
my $host_os    = detect_os();

# Parse command
my $cmd = shift @ARGV || 'help';

if ( $cmd eq 'check' ) {
    check_profile( @ARGV, 'explicit' );
} elsif ( $cmd eq 'install' ) {
    install_profile(@ARGV);
} elsif ( $cmd eq 'list' ) {
    list_profiles();
} elsif ( $cmd eq 'status' ) {
    status_all();
} elsif ( $cmd eq 'clear-cache' ) {
    clear_cache();
} elsif ( $cmd eq 'zenka-modules' ) {
    show_zenka_modules(@ARGV);
} elsif ( $cmd eq 'zenka-packages' ) {
    show_zenka_packages(@ARGV);
} elsif ( $cmd eq 'validate' ) {
    validate_zenka_declarations(@ARGV);
} elsif ( $cmd eq 'dist-upgrade' ) {
    run_dist_upgrade(@ARGV);
} elsif ( $cmd eq 'help' || $cmd eq '--help' || $cmd eq '-h' ) {
    show_help();
} else {
    print_error( "Unknown command: $cmd", 0 );
    show_help();
    exit 1;
}

sub check_profile {
    my ( $profile_name, $opts, $is_explicit ) = @_;

    unless ($profile_name) {
        die "Usage: bin/p7-deps check <profile> [--no-cache]\n";
    }

    my $use_cache         = 1;
    my $is_explicit_check = 0;

    if ( defined $opts ) {
        $use_cache         = 0 if $opts eq '--no-cache';
        $is_explicit_check = 1 if $opts eq 'explicit';
    }
    if ( defined $is_explicit ) {
        $use_cache         = 0 if $is_explicit eq '--no-cache';
        $is_explicit_check = 1 if $is_explicit eq 'explicit';
    }

    if ( $use_cache && !$is_explicit_check ) {
        my $cached = check_cache($profile_name);
        if ( defined $cached ) {
            if ($cached) {
                print "${neon_green}$profile_name${reset}: ${neon_green}all "
                    . "dependencies installed${reset} (cached)\n";
                return 0;
            } else {
                print "${neon_green}$profile_name${reset}: "
                    . "${neon_amber}missing dependencies${reset} "
                    . "(cached - use ${TRUE_color}--no-cache${reset} "
                    . "to recheck)\n";
                return 1;
            }
        }
    }

    my $profiles = load_profiles();
    unless ( exists $profiles->{$profile_name} ) {
        die "Unknown profile: $profile_name\nRun "
            . "'bin/p7-deps list' to see available profiles.\n";
    }

    my $profile = $profiles->{$profile_name};

    print "${blacklight}:${reset}\n${blacklight}::[${TRUE_color} dependency "
        . "check ${blacklight}]${reset}\n${blacklight}:${reset}\n";
    print
        "   ${TRUE_color}profile${reset} ${blacklight}:${reset} ${neon_green}$profile_name${reset}\n";
    print "   ${TRUE_color}$profile->{description}${reset}\n\n";

    my @missing;
    my $total  = 0;
    my $all_ok = 1;

    if ( $profile->{includes} ) {
        print
            "${blacklight}::${reset} ${TRUE_color}includes${reset}${blacklight}:${reset} "
            . "${neon_green}"
            . join( "${reset}, ${neon_green}", @{ $profile->{includes} } )
            . "${reset}\n\n";
        for my $included ( @{ $profile->{includes} } ) {
            my $result = check_profile( $included, '--no-cache',
                $is_explicit_check ? 'explicit' : undef );
            $all_ok = 0 if $result != 0;
        }
    }

    ## check APT packages
    if ( $profile->{apt} ) {
        print "${blacklight}::${reset} ${TRUE_color}APT packages${reset}\n";
        my $max_len = 0;
        for ( @{ $profile->{apt} } ) {
            $max_len = length($_) if length($_) > $max_len;
        }
        for my $pkg ( @{ $profile->{apt} } ) {
            $total++;
            my $dots = '.' x ( $max_len - length($pkg) + 3 );
            if ( probe_apt($pkg) ) {
                print
                    "${blacklight}::${reset}   ${TRUE_color}$pkg${reset} ${blacklight}$dots${reset} ${neon_green}installed${reset}\n";
            } else {
                print
                    "${blacklight}::${reset}   ${TRUE_color}$pkg${reset} ${blacklight}$dots${reset} ${neon_amber}missing${reset}\n";
                push @missing, "apt:$pkg";
            }
        }
        print "\n";
    }

    ## check CPAN modules
    if ( $profile->{cpan} ) {
        print "${blacklight}::${reset} ${TRUE_color}CPAN modules${reset}\n";
        my $max_len = 0;
        for ( @{ $profile->{cpan} } ) {
            $max_len = length($_) if length($_) > $max_len;
        }
        for my $module ( @{ $profile->{cpan} } ) {
            $total++;
            my $dots = '.' x ( $max_len - length($module) + 3 );
            if ( probe_module($module) ) {
                print
                    "${blacklight}::${reset}   ${TRUE_color}$module${reset} ${blacklight}$dots${reset} ${neon_green}installed${reset}\n";
            } else {
                print
                    "${blacklight}::${reset}   ${TRUE_color}$module${reset} ${blacklight}$dots${reset} ${neon_amber}missing${reset}\n";
                push @missing, "cpan:$module";
            }
        }
        print "\n";
    }

    ## check CPAN fallback modules
    if ( $profile->{cpan_fallback} ) {
        print "${blacklight}::${reset} ${TRUE_color}CPAN "
            . "modules (Debian fallback)${reset}\n";
        my $max_len = 0;
        for ( @{ $profile->{cpan_fallback} } ) {
            $max_len = length($_) if length($_) > $max_len;
        }
        for my $module ( @{ $profile->{cpan_fallback} } ) {
            $total++;
            my $resolved = resolve_install( $module, $known_deps );
            my $dots     = '.' x ( $max_len - length($module) + 3 );

            if ( $resolved->{method} eq 'debian'
                && probe_apt( $resolved->{pkg} ) ) {
                print
                    "${blacklight}::${reset}   ${TRUE_color}$module${reset} ${blacklight}$dots${reset} "
                    . "${neon_green}installed${reset} ${blacklight}(via Debian: ${TRUE_color}$resolved->{pkg}${blacklight})${reset}\n";
            } elsif ( probe_module($module) ) {
                print
                    "${blacklight}::${reset}   ${TRUE_color}$module${reset} ${blacklight}$dots${reset} ${neon_green}installed${reset}\n";
            } else {
                print
                    "${blacklight}::${reset}   ${TRUE_color}$module${reset} ${blacklight}$dots${reset} ${neon_amber}missing${reset}\n";
                push @missing, "cpan:$module";
            }
        }
        print "\n";
    }

    $all_ok = 0 if @missing;

    ## summary box [ same inline ::[ ] motif as print_header / print_section ]
    if (@missing) {
        print "${blacklight}:${reset}\n${blacklight}::[${neon_amber} "
            . scalar(@missing)
            . " missing ${blacklight}]${reset} ${blacklight}---${reset} "
            . "run: ${TRUE_color}bin/p7-deps "
            . "install $profile_name${reset}\n${blacklight}:${reset}\n";
        update_cache( $profile_name, 0 );
        return 1;
    } else {
        print "${blacklight}:${reset}\n"
            . "${blacklight}::[${neon_green} all "
            . "dependencies installed ${blacklight}]${reset}"
            . " ${blacklight}(${neon_green}$total${blacklight}/${neon_green}$total${blacklight})${reset}\n"
            . "${blacklight}:${reset}\n";
        update_cache( $profile_name, 1 );
        return 0;
    }
}

sub install_profile {
    my ( $profile_name, $opts ) = @_;

    unless ($profile_name) {
        $profile_name = 'minimal';
    }

    my $profiles = load_profiles();
    unless ( exists $profiles->{$profile_name} ) {
        die "Unknown profile: $profile_name\n";
    }

    my $profile = $profiles->{$profile_name};

    print "\n";
    print_header('install profile');
    print "   ${neon_green}$profile_name${reset} ${blacklight}---${reset} "
        . "${TRUE_color}$profile->{description}${reset}\n\n";

    if ( $profile->{includes} ) {
        print
            "${blacklight}::${reset} ${TRUE_color}includes${reset}${blacklight}:${reset} "
            . "${neon_green}"
            . join( "${reset}, ${neon_green}", @{ $profile->{includes} } )
            . "${reset}\n\n";
        for my $included ( @{ $profile->{includes} } ) {
            install_profile( $included, $opts );
        }
    }

    my @to_install_apt;
    my @to_install_cpan;

    if ( $profile->{apt} ) {
        for my $pkg ( @{ $profile->{apt} } ) {
            unless ( probe_apt($pkg) ) {
                push @to_install_apt, $pkg;
            }
        }
    }

    if ( $profile->{cpan} ) {
        for my $module ( @{ $profile->{cpan} } ) {
            unless ( probe_module($module) ) {
                push @to_install_cpan, $module;
            }
        }
    }

    if ( $profile->{cpan_fallback} ) {
        for my $module ( @{ $profile->{cpan_fallback} } ) {
            my $resolved = resolve_install( $module, $known_deps );

            if ( $resolved->{method} eq 'debian' ) {
                unless ( probe_apt( $resolved->{pkg} ) ) {
                    push @to_install_apt, $resolved->{pkg};
                }
            } else {
                unless ( probe_module($module) ) {
                    push @to_install_cpan, $module;
                }
            }
        }
    }

    ## install APT packages
    if (@to_install_apt) {
        print "${blacklight}::${reset} ${TRUE_color}installing "
            . "APT packages${reset}: ${neon_green}"
            . join( "${reset}, ${neon_green}", @to_install_apt )
            . "${reset}\n";
        my $result = install_apt(@to_install_apt);
        if ( @{ $result->{failed} } ) {
            print "${blacklight}::${reset} ${neon_amber}failed${reset}: "
                . "${neon_amber}"
                . join( "${reset}, ${neon_amber}", @{ $result->{failed} } )
                . "${reset}\n";
        }
        if ( @{ $result->{ok} } ) {
            print "${blacklight}::${reset} ${neon_green}installed${reset}: "
                . "${neon_green}"
                . join( "${reset}, ${neon_green}", @{ $result->{ok} } )
                . "${reset}\n";
        }
    }

    ## install CPAN modules
    if (@to_install_cpan) {
        print "${blacklight}::${reset} ${TRUE_color}installing "
            . "CPAN modules${reset}: ${neon_green}"
            . join( "${reset}, ${neon_green}", @to_install_cpan )
            . "${reset}\n";

        my $cpan_available = `which cpanm 2>/dev/null`;
        my $cpan_cmd       = $cpan_available ? 'cpanm' : 'cpan';

        for my $module (@to_install_cpan) {
            print
                "${blacklight}::${reset}   ${TRUE_color}installing${reset} ${neon_green}$module${reset}...\n";

            my $cmd
                = ( $cpan_cmd eq 'cpanm' )
                ? "cpanm -n $module"
                : "cpan -T $module 2>&1 | grep -v 'Loading internal'";

            my $result = system($cmd);

            if ( $result == 0 ) {
                print
                    "${blacklight}::${reset}   ${TRUE_color}$module${reset} ${neon_green}installed${reset}\n";
            } else {
                print
                    "${blacklight}::${reset}   ${TRUE_color}$module${reset} ${neon_amber}installation failed${reset}\n";
            }
        }
    }

    print "\n${blacklight}::${reset} ${neon_green}installation "
        . "complete${reset}\n";
    update_cache( $profile_name, 1 );
}

sub list_profiles {
    my $profiles = load_profiles();

    print "\n";
    print_header('available profiles');

    for my $name ( sort keys %$profiles ) {
        my $profile = $profiles->{$name};
        print "${neon_green}$name${reset}\n";
        print "  ${TRUE_color}$profile->{description}${reset}\n";

        if ( $profile->{includes} ) {
            print "  ${TRUE_color}includes${reset}${blacklight}:${reset} "
                . "${neon_green}"
                . join( "${reset}, ${neon_green}", @{ $profile->{includes} } )
                . "${reset}\n";
        } else {
            my $total = 0;
            $total += scalar( @{ $profile->{apt} } )  if $profile->{apt};
            $total += scalar( @{ $profile->{cpan} } ) if $profile->{cpan};
            $total += scalar( @{ $profile->{cpan_fallback} } )
                if $profile->{cpan_fallback};
            print
                "  ${TRUE_color}packages${reset}${blacklight}:${reset} ${neon_green}$total${reset} ${TRUE_color}total${reset}\n";
        }
        print "\n";
    }
}

sub status_all {
    my $profiles = load_profiles();

    print "\n";
    print_header('dependency status');

    for my $name ( sort keys %$profiles ) {
        next if $profiles->{$name}{includes};

        print "${TRUE_color}checking${reset} ${neon_green}$name${reset}...\n";
        check_profile( $name, '--no-cache' );
        print "\n";
    }
}

sub clear_cache {
    my @cache_files = glob("$CACHE_DIR/*");
    for my $file (@cache_files) {
        unlink($file) or warn "Failed to remove $file: $!\n";
    }
    print "${blacklight}::${reset} ${neon_green}cache cleared${reset}\n";
}

sub run_dist_upgrade {
    my ($action) = @_;
    $action //= 'dist-upgrade';

    print "\n";
    print_header($action);

    my $result = AMOS7::deps::dist_upgr::run($action);

    print $result->{log} if defined $result->{log};

    if ( $result->{ok} ) {
        print "\n${blacklight}::${reset} ${neon_green}$action "
            . "complete${reset}\n\n";
    } else {
        print "\n${blacklight}::${reset} ${neon_amber}$action "
            . "completed with errors${reset}\n\n";
    }
}

##[ INTROSPECTION COMMANDS ]##################################################

sub show_zenka_modules {
    my ($sort_key) = @_;
    $sort_key ||= 'module';

    print_header("Zenka Module Dependencies");

    my $pm_deps = scan_zenki_pm_deps($ZENKI_DIR);

    unless ( keys %$pm_deps ) {
        print "  ${TRUE_color}No Perl module dependencies "
            . "declared in zenka configurations.${reset}\n\n";
        return;
    }

    if ( $sort_key eq 'zenka' ) {
        my %by_zenka;
        for my $module ( keys %$pm_deps ) {
            for my $zenka ( @{ $pm_deps->{$module} } ) {
                push @{ $by_zenka{$zenka} }, $module;
            }
        }

        for my $zenka ( sort keys %by_zenka ) {
            print_section("${neon_green}$zenka${reset}");
            my @modules = sort @{ $by_zenka{$zenka} };
            for my $module (@modules) {
                print
                    "  ${blacklight}:.${reset} ${neon_green}$module${reset}\n";
            }
            print "\n";
        }
    } else {
        for my $module ( sort keys %$pm_deps ) {
            my $zenki_list = "${TRUE_color}"
                . join( "${reset}, ${TRUE_color}",
                sort @{ $pm_deps->{$module} } )
                . "${reset}";
            print
                "  ${neon_green}$module${reset} (${TRUE_color}zenka${reset}${blacklight}:${reset} $zenki_list)\n";
        }
        print "\n";
    }

    print "${TRUE_color}Total modules${reset}: ${neon_green}"
        . scalar( keys %$pm_deps )
        . "${reset}\n\n";
}

sub show_zenka_packages {
    my ($sort_key) = @_;
    $sort_key ||= 'package';

    print_header("Zenka OS Package Dependencies");

    my $os_deps = scan_zenki_os_deps($ZENKI_DIR);

    my %all_packages;
    for my $type ( keys %$os_deps ) {
        for my $pkg ( keys %{ $os_deps->{$type} } ) {
            $all_packages{$pkg} = {
                type  => $type,
                zenki => $os_deps->{$type}{$pkg}
            };
        }
    }

    unless ( keys %all_packages ) {
        print "  ${TRUE_color}No OS package dependencies "
            . "declared in zenka configurations.${reset}\n\n";
        return;
    }

    if ( $sort_key eq 'zenka' ) {
        my %by_zenka;
        for my $pkg ( keys %all_packages ) {
            for my $zenka ( @{ $all_packages{$pkg}{zenki} } ) {
                push @{ $by_zenka{$zenka} }, $pkg;
            }
        }

        for my $zenka ( sort keys %by_zenka ) {
            print_section("${neon_green}$zenka${reset}");
            my @packages = sort @{ $by_zenka{$zenka} };
            for my $pkg (@packages) {
                print "  ${blacklight}:.${reset} ${neon_green}$pkg${reset}\n";
            }
            print "\n";
        }
    } else {
        for my $pkg ( sort keys %all_packages ) {
            my $info = $all_packages{$pkg};
            my $zenki_list
                = "${TRUE_color}"
                . join( "${reset}, ${TRUE_color}", sort @{ $info->{zenki} } )
                . "${reset}";
            print "  ${neon_green}$pkg${reset} "
                . "(${TRUE_color}type${reset}${blacklight}:${reset} ${TRUE_color}$info->{type}${reset}"
                . "${blacklight},${reset} ${TRUE_color}zenka${reset}${blacklight}:${reset} $zenki_list)\n";
        }
        print "\n";
    }

    print "${TRUE_color}Total packages${reset}: ${neon_green}"
        . scalar( keys %all_packages )
        . "${reset}\n\n";
}

sub validate_zenka_declarations {
    print_header("Validating Zenka Dependency Declarations");

    my $pm_deps = scan_zenki_pm_deps($ZENKI_DIR);
    my $os_deps = scan_zenki_os_deps($ZENKI_DIR);

    my %all_zenka;
    for my $module ( keys %$pm_deps ) {
        for my $zenka ( @{ $pm_deps->{$module} } ) {
            $all_zenka{$zenka} = 1;
        }
    }
    for my $type ( keys %$os_deps ) {
        for my $pkg ( keys %{ $os_deps->{$type} } ) {
            for my $zenka ( @{ $os_deps->{$type}{$pkg} } ) {
                $all_zenka{$zenka} = 1;
            }
        }
    }

    my $total_zenka = scalar( keys %all_zenka );

    unless ($total_zenka) {
        print "  ${TRUE_color}No zenka found with "
            . "dependency declarations.${reset}\n\n";
        return;
    }

    print_section("Summary");
    print "  ${TRUE_color}Found${reset} ${neon_green}$total_zenka${reset} "
        . "${TRUE_color}zenka with declared dependencies${reset}\n";

    my $total_pm  = scalar( keys %$pm_deps );
    my $total_deb = scalar( keys %{ $os_deps->{debian} // {} } );
    my $total_bin = scalar( keys %{ $os_deps->{binary} // {} } );

    print "  ${blacklight}:.${reset} ${TRUE_color}CPAN "
        . "modules${reset}: ${neon_green}$total_pm${reset}\n";
    print "  ${blacklight}:.${reset} ${TRUE_color}Debian "
        . "packages${reset}: ${neon_green}$total_deb${reset}\n";
    print "  ${blacklight}:.${reset} ${TRUE_color}Binary "
        . "requirements${reset}: ${neon_green}$total_bin${reset}\n";
    print "\n";

    print_section("Zenka with Dependencies");
    for my $zenka ( sort keys %all_zenka ) {
        my @modules = grep {
            grep { $_ eq $zenka }
                @{ $pm_deps->{$_} }
        } keys %$pm_deps;
        my @debian = grep {
            grep { $_ eq $zenka }
                @{ $os_deps->{debian}{$_} }
            }
            keys %{ $os_deps->{debian} // {} };
        my @binary = grep {
            grep { $_ eq $zenka }
                @{ $os_deps->{binary}{$_} }
            }
            keys %{ $os_deps->{binary} // {} };

        my $count = scalar(@modules) + scalar(@debian) + scalar(@binary);
        print "  ${neon_green}$zenka${reset}: ${TRUE_color}$count${reset} "
            . "dependencies\n";
        print
            "    ${blacklight}:.${reset} ${TRUE_color}CPAN${reset}${blacklight}:${reset} "
            . "${neon_green}"
            . scalar(@modules)
            . "${reset}\n"
            if @modules;
        print
            "    ${blacklight}:.${reset} ${TRUE_color}Debian${reset}${blacklight}:${reset} "
            . "${neon_green}"
            . scalar(@debian)
            . "${reset}\n"
            if @debian;
        print
            "    ${blacklight}:.${reset} ${TRUE_color}Binary${reset}${blacklight}:${reset} "
            . "${neon_green}"
            . scalar(@binary)
            . "${reset}\n"
            if @binary;
    }

    print "\n${blacklight}::${reset} ${neon_green}validation "
        . "complete${reset}\n\n";
}

##[ STYLING FUNCTIONS ]#######################################################

sub print_header {
    my $title = shift;
    print "${blacklight}:${reset}\n";
    print "${blacklight}::[$neon_green $title $blacklight]${reset}\n";
    print "${blacklight}:${reset}\n\n";
}

sub print_section {
    my $title = shift;
    print "${blacklight}::[$TRUE_color $title $blacklight]${reset}\n";
}

sub print_error {
    my ( $message, $exit_code ) = @_;
    print "\n${blacklight}:\n::[$neon_amber ERROR $blacklight] "
        . ".: ${neon_amber}$message$blacklight ::\n:${reset}\n";
    exit($exit_code) if $exit_code;
}

##[ HELPER FUNCTIONS ]########################################################

sub load_profiles {
    unless ( -f $PROFILES_FILE ) {
        die "Cannot find $PROFILES_FILE\n";
    }

    open my $fh, '<', $PROFILES_FILE
        or die "Cannot read $PROFILES_FILE: $!\n";
    my %profiles;
    my $current_profile;
    my $current_section;

    while ( my $line = <$fh> ) {
        chomp $line;
        next if $line =~ /^\s*#/;
        next if $line =~ /^\s*$/;

        if ( $line =~ /^  ([\w-]+):$/ ) {
            $current_profile            = $1;
            $current_section            = undef;
            $profiles{$current_profile} = {};
        } elsif ( $line =~ /^    description: "(.+)"$/ ) {
            $profiles{$current_profile}{description} = $1;
        } elsif ( $line =~ /^    (includes|apt|cpan|cpan_fallback):$/ ) {
            $current_section = $1;
            $profiles{$current_profile}{$current_section} = [];
        } elsif ( $line =~ /^      - (.+)$/ ) {
            my $item = $1;
            $item =~ s/\s*#.*//;
            $item =~ s/\s+$//;
            push @{ $profiles{$current_profile}{$current_section} }, $item
                if $item;
        }
    }
    close $fh;

    return \%profiles;
}

sub check_cache {
    my ($profile_name) = @_;
    my $cache_file = File::Spec->catfile( $CACHE_DIR, "$profile_name.cache" );

    return undef unless -f $cache_file;

    open my $fh, '<', $cache_file or return undef;
    my $status = <$fh>;
    close $fh;

    chomp $status;
    return $status eq 'ok' ? 1 : 0;
}

sub update_cache {
    my ( $profile_name, $status ) = @_;
    my $cache_file = File::Spec->catfile( $CACHE_DIR, "$profile_name.cache" );

    ## non-fatal : the real check/install result is already printed by the ##
    ## time this runs, so a cache-write failure shouldn't abort the run    ##
    open my $fh, '>', $cache_file
        or return print_error("cannot write cache: $!");
    print $fh $status ? 'ok' : 'fail';
    close $fh;
}

sub show_help {
    my $rule = frame_border_line(
        {   width    => $TERM_WIDTH,
            reset    => $reset,
            elements => [
                {   type  => 'fill',
                    char  => '━',
                    min   => 1,
                    color => $neon_green,
                },
            ],
        }
    );
    my $title = "$neon_green" . 'Protocol-7 Dependency Manager' . "$reset";

    print "$rule\n$title\n$rule\n";
    print <<"EOF";

${neon_green}USAGE${reset}:
  ${TRUE_color}bin/p7-deps${reset} ${blacklight}[OPTION]${reset} ${blacklight}<command>${reset} ${blacklight}[args]${reset}

${neon_green}COMMANDS${reset} ${blacklight}(${TRUE_color}Installation${blacklight})${reset}:
  ${TRUE_color}list${reset}                    ${TRUE_color}List all available profiles${reset}
  ${TRUE_color}check${reset} ${blacklight}[profile]${reset}         ${TRUE_color}Check dependencies for a profile${reset}
  ${TRUE_color}install${reset} ${blacklight}[profile]${reset}       ${TRUE_color}Install all dependencies for a profile${reset}
  ${TRUE_color}status${reset}                  ${TRUE_color}Show status of all base profiles${reset}
  ${TRUE_color}clear-cache${reset}             ${TRUE_color}Clear the dependency cache${reset}
  ${TRUE_color}dist-upgrade${reset}            ${TRUE_color}Run Debian dist-upgrade${reset}

${neon_green}COMMANDS${reset} ${blacklight}(${TRUE_color}Introspection${blacklight})${reset}:
  ${TRUE_color}zenka-modules${reset}           ${TRUE_color}Show which zenka declare which CPAN modules${reset}
  ${TRUE_color}zenka-packages${reset}          ${TRUE_color}Show which zenka declare which OS packages${reset}
  ${TRUE_color}validate${reset}                ${TRUE_color}Validate zenka dependency declarations${reset}

${neon_green}COMMANDS${reset} ${blacklight}(${TRUE_color}Help${blacklight})${reset}:
  ${TRUE_color}help${reset}                    ${TRUE_color}Show this help message${reset}

${neon_green}OPTIONS${reset}:
  ${TRUE_color}--no-cache${reset}              ${TRUE_color}Force fresh dependency check (bypass cache)${reset}

${neon_green}EXAMPLES${reset}:
  ${TRUE_color}bin/p7-deps list${reset}                          ${blacklight}# List all profiles${reset}
  ${TRUE_color}bin/p7-deps check minimal${reset}                 ${blacklight}# Check minimal profile${reset}
  ${TRUE_color}bin/p7-deps check development --no-cache${reset}  ${blacklight}# Fresh check of development profile${reset}
  ${TRUE_color}bin/p7-deps install minimal${reset}               ${blacklight}# Install minimal profile${reset}
  ${TRUE_color}bin/p7-deps status${reset}                        ${blacklight}# Check all profiles${reset}
  ${TRUE_color}bin/p7-deps zenka-modules${reset}                 ${blacklight}# Show module-to-zenka mapping${reset}
  ${TRUE_color}bin/p7-deps validate${reset}                      ${blacklight}# Validate dependency declarations${reset}
  ${TRUE_color}bin/p7-deps dist-upgrade${reset}                  ${blacklight}# Run dist-upgrade${reset}

${neon_green}PROFILES${reset}:
  ${TRUE_color}Profiles are defined in${reset}${blacklight}:${reset} ${TRUE_color}$PROFILES_FILE${reset}

${neon_green}ZENKA CONFIGURATION${reset}:
  ${TRUE_color}Zenka dependency declarations are read from${reset}${blacklight}:${reset}
    ${TRUE_color}$ZENKI_DIR/<zenka-name>/deps/p-mod/${reset}   ${blacklight}(CPAN modules)${reset}
    ${TRUE_color}$ZENKI_DIR/<zenka-name>/deps/os/deb/${reset}  ${blacklight}(Debian packages)${reset}
    ${TRUE_color}$ZENKI_DIR/<zenka-name>/deps/os/bin/${reset}  ${blacklight}(binary requirements)${reset}

EOF
}

