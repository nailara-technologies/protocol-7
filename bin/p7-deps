#!/usr/bin/env perl
## [:< ##

# Protocol-7 Dependency Manager (bin/p7-deps)
# Reads from base.known_dependencies and zenki configurations
# Generates/updates dependency YAML for workspace-transfer
# Provides comprehensive dependency reporting

use v5.24;
use strict;
use warnings;
use FindBin qw($RealBin);
use File::Spec;
use File::Find;
use Data::Dumper;
use English;

$OUTPUT_AUTOFLUSH = 1;

# Color palette inspired by Nailara branding
my $reset             = "\e[0m";
my $blacklight        = "\e[38;2;68;39;172m";    # Dark purple
my $nailara_fg        = "\e[38;2;38;46;153m";    # Dark blue
my $TRUE_color        = "\e[38;2;6;71;195m";     # Bright blue
my $NEON_orange       = "\e[38;2;197;141;7m";    # Bright orange
my $NEON_green_yellow = "\e[38;2;71;195;6m";     # Green-yellow

##[ PROJECT PATH DISCOVERY ]######################################################
use Cwd qw(abs_path);

# Helper functions for path operations (inspired by amos-chksum)
sub catdir  { File::Spec->catdir(@_) }
sub rel2abs { File::Spec->rel2abs(@_) }

# Discover Protocol-7 root path using FindBin
my $up_dir = File::Spec->updir;
my $P7_ROOT = abs_path(rel2abs(catdir($RealBin, $up_dir)));

# Build all necessary paths
my $MODULES_DIR = catdir($P7_ROOT, 'modules');
my $ZENKI_DIR = catdir($P7_ROOT, 'configuration', 'zenki');
my $KNOWN_DEPS_FILE = File::Spec->catfile($MODULES_DIR, 'base.known_dependencies');
my $P7_DEPS_DIR = catdir($P7_ROOT, '.deps');

# Workspace-transfer paths
my $WORKSPACE_TRANSFER = catdir($P7_ROOT, '..');
my $WORKSPACE_TRANSFER_DEPS = catdir($WORKSPACE_TRANSFER, 'workspace-transfer', '.deps');
my $WORKSPACE_PROFILES = File::Spec->catfile($WORKSPACE_TRANSFER_DEPS, 'profiles.yaml');

# Parse command
my $cmd = shift @ARGV || 'help';

if ($cmd eq 'list') {
    list_dependencies(@ARGV);
} elsif ($cmd eq 'check') {
    check_dependencies(@ARGV);
} elsif ($cmd eq 'generate') {
    generate_yaml(@ARGV);
} elsif ($cmd eq 'update-workspace') {
    update_workspace_profiles(@ARGV);
} elsif ($cmd eq 'help' || $cmd eq '--help') {
    show_help();
} else {
    die "Unknown command: $cmd\nRun '$0 help' for usage.\n";
}

sub load_known_dependencies {
    unless (-f $KNOWN_DEPS_FILE) {
        die "Cannot find $KNOWN_DEPS_FILE\n";
    }

    open my $fh, '<', $KNOWN_DEPS_FILE or die "Cannot read $KNOWN_DEPS_FILE: $!\n";
    my $content = do { local $/; <$fh> };
    close $fh;

    # Remove header comments
    $content =~ s/^##.*?\n//;
    $content =~ s/#.*?\n/\n/g;

    # Evaluate Perl hash
    my $deps = eval $content;
    die "Error evaluating $KNOWN_DEPS_FILE: $@\n" if $@;

    return $deps;
}

sub get_zenki_pm_deps {
    my %pm_deps;

    return \%pm_deps unless -d $ZENKI_DIR;

    # Scan all zenki directories
    opendir my $dh, $ZENKI_DIR or return \%pm_deps;
    while (my $zenki = readdir $dh) {
        next if $zenki =~ /^\./;

        my $pm_dep_dir = File::Spec->catdir($ZENKI_DIR, $zenki, 'pm-dep');
        next unless -d $pm_dep_dir;

        opendir my $pdh, $pm_dep_dir or next;
        while (my $file = readdir $pdh) {
            next if $file =~ /^\./;

            # Convert filename back to module name (__ -> ::)
            my $module = $file;
            $module =~ s/__/::/g;
            $pm_deps{$module} = $zenki;
        }
        closedir $pdh;
    }
    closedir $dh;

    return \%pm_deps;
}

sub get_zenki_os_deps {
    my %os_deps = (
        debian => {},
        binary => {}
    );

    return \%os_deps unless -d $ZENKI_DIR;

    # Scan all zenki directories
    opendir my $dh, $ZENKI_DIR or return \%os_deps;
    while (my $zenki = readdir $dh) {
        next if $zenki =~ /^\./;

        # Check debian packages
        my $debian_dir = File::Spec->catdir($ZENKI_DIR, $zenki, 'os-dep', 'debian');
        if (-d $debian_dir) {
            opendir my $ddh, $debian_dir or next;
            while (my $pkg = readdir $ddh) {
                next if $pkg =~ /^\./;
                $os_deps{debian}{$pkg} = $zenki;
            }
            closedir $ddh;
        }

        # Check binary requirements
        my $binary_dir = File::Spec->catdir($ZENKI_DIR, $zenki, 'os-dep', 'binary');
        if (-d $binary_dir) {
            opendir my $bdh, $binary_dir or next;
            while (my $bin = readdir $bdh) {
                next if $bin =~ /^\./;
                $os_deps{binary}{$bin} = $zenki;
            }
            closedir $bdh;
        }
    }
    closedir $dh;

    return \%os_deps;
}

sub list_dependencies {
    print "${blacklight}:$reset\n";
    print "${blacklight}::[$NEON_green_yellow Protocol-7 Dependency Analysis $blacklight]$reset\n";
    print "${blacklight}:$reset\n\n";

    my $known = load_known_dependencies();
    my $pm_deps = get_zenki_pm_deps();
    my $os_deps = get_zenki_os_deps();

    print "${blacklight}::[$TRUE_color CPAN Modules$blacklight from base.known_dependencies$blacklight]$reset\n";
    print "${blacklight}::$reset   Total: ${NEON_orange}" . scalar(keys %{$known->{perlmod}}) . "$reset\n\n";

    print "${blacklight}::[$TRUE_color Zenki PM Dependencies$blacklight (from pm-dep)$blacklight]$reset\n";
    my %module_zenki;
    for my $module (sort keys %{$pm_deps}) {
        $module_zenki{$module} = $pm_deps->{$module};
    }
    for my $module (sort keys %module_zenki) {
        print "${blacklight}::$reset   ${NEON_green_yellow}$module$reset (zenka: ${NEON_orange}$module_zenki{$module}$reset)\n";
    }
    print "${blacklight}::$reset   Total: ${NEON_orange}" . scalar(keys %module_zenki) . "$reset\n\n";

    print "${blacklight}::[$TRUE_color Debian Packages$blacklight (from os-dep/debian)$blacklight]$reset\n";
    for my $pkg (sort keys %{$os_deps->{debian}}) {
        print "${blacklight}::$reset   ${NEON_green_yellow}$pkg$reset (zenka: ${NEON_orange}$os_deps->{debian}{$pkg}$reset)\n";
    }
    print "${blacklight}::$reset   Total: ${NEON_orange}" . scalar(keys %{$os_deps->{debian}}) . "$reset\n\n";

    print "${blacklight}::[$TRUE_color Binary Commands$blacklight (from os-dep/binary)$blacklight]$reset\n";
    for my $bin (sort keys %{$os_deps->{binary}}) {
        print "${blacklight}::$reset   ${NEON_green_yellow}$bin$reset (zenka: ${NEON_orange}$os_deps->{binary}{$bin}$reset)\n";
    }
    print "${blacklight}::$reset   Total: ${NEON_orange}" . scalar(keys %{$os_deps->{binary}}) . "$reset\n";
    print "${blacklight}:$reset\n";
}

sub check_dependencies {
    my ($profile_name) = @_;
    $profile_name ||= 'protocol7_full';

    print "${blacklight}:$reset\n";
    print "${blacklight}::[$NEON_green_yellow Checking Protocol-7 dependencies $blacklight for ${NEON_orange}$profile_name$blacklight]$reset\n";
    print "${blacklight}:$reset\n\n";

    my $known = load_known_dependencies();
    my $pm_deps = get_zenki_pm_deps();
    my $os_deps = get_zenki_os_deps();

    # Aggregate dependencies
    my @all_cpan;
    my @all_debian;

    # From base.known_dependencies
    for my $module (keys %{$known->{perlmod}}) {
        push @all_cpan, $module if $known->{perlmod}{$module}{cpan};
    }

    # From zenki pm-dep
    for my $module (keys %{$pm_deps}) {
        push @all_cpan, $module unless grep { $_ eq $module } @all_cpan;
    }

    # From zenki os-dep/debian
    for my $pkg (keys %{$os_deps->{debian}}) {
        push @all_debian, $pkg;
    }

    # Add debian packages from base.known_dependencies
    for my $module (keys %{$known->{perlmod}}) {
        if ($known->{perlmod}{$module}{debian}) {
            for my $pkg (@{$known->{perlmod}{$module}{debian}}) {
                next if $pkg =~ /^cpan:/;
                push @all_debian, $pkg unless grep { $_ eq $pkg } @all_debian;
            }
        }
    }

    print "${blacklight}::[$TRUE_color CPAN modules$blacklight]$reset ${NEON_orange}" . scalar(@all_cpan) . "$reset\n";
    print "${blacklight}::[$TRUE_color Debian packages$blacklight]$reset ${NEON_orange}" . scalar(@all_debian) . "$reset\n\n";

    print "${blacklight}::[$NEON_green_yellow CPAN Modules$blacklight]$reset\n";
    for my $module (sort @all_cpan) {
        print "${blacklight}::$reset   ${NEON_green_yellow}$module$reset\n";
    }

    print "\n${blacklight}::[$NEON_green_yellow Debian Packages$blacklight]$reset\n";
    for my $pkg (sort @all_debian) {
        print "${blacklight}::$reset   ${NEON_green_yellow}$pkg$reset\n";
    }
    print "${blacklight}:$reset\n";
}

sub generate_yaml {
    my ($output_file) = @_;
    $output_file ||= File::Spec->catfile($P7_DEPS_DIR, 'protocol7_full.yaml');

    print "${blacklight}:$reset\n";
    print "${blacklight}::[$NEON_green_yellow Generating YAML$blacklight from Protocol-7 dependencies$blacklight]$reset\n";
    print "${blacklight}:$reset\n\n";

    my $known = load_known_dependencies();
    my $pm_deps = get_zenki_pm_deps();
    my $os_deps = get_zenki_os_deps();

    # Aggregate dependencies
    my %all_cpan;
    my %all_debian;

    # From base.known_dependencies
    for my $module (keys %{$known->{perlmod}}) {
        if ($known->{perlmod}{$module}{cpan}) {
            $all_cpan{$known->{perlmod}{$module}{cpan}} = 1;
        }
        if ($known->{perlmod}{$module}{debian}) {
            for my $pkg (@{$known->{perlmod}{$module}{debian}}) {
                next if $pkg =~ /^cpan:/;
                $all_debian{$pkg} = 1;
            }
        }
    }

    # From zenki pm-dep
    for my $module (keys %{$pm_deps}) {
        $all_cpan{$module} = 1;
    }

    # From zenki os-dep/debian
    for my $pkg (keys %{$os_deps->{debian}}) {
        $all_debian{$pkg} = 1;
    }

    # Create output directory
    mkdir $P7_DEPS_DIR unless -d $P7_DEPS_DIR;

    open my $fh, '>', $output_file or die "Cannot write to $output_file: $!\n";

    print $fh "# Protocol-7 Dependencies (auto-generated from base.known_dependencies and zenki configs)\n";
    print $fh "# Generated: " . scalar(localtime()) . "\n";
    print $fh "# This file is used to sync with workspace-transfer/dependencies.yaml\n\n";

    print $fh "protocol7_full:\n";
    print $fh "  description: \"Protocol-7 complete development environment (auto-generated)\"\n";
    print $fh "  apt:\n";
    for my $pkg (sort keys %all_debian) {
        print $fh "    - $pkg\n";
    }

    print $fh "  cpan:\n";
    for my $module (sort keys %all_cpan) {
        print $fh "    - $module\n";
    }

    close $fh;

    print "${blacklight}::[$TRUE_color Generated$blacklight]$reset ${NEON_orange}$output_file$reset\n";
    print "${blacklight}::$reset   CPAN modules: ${NEON_orange}" . scalar(keys %all_cpan) . "$reset\n";
    print "${blacklight}::$reset   Debian packages: ${NEON_orange}" . scalar(keys %all_debian) . "$reset\n";
    print "${blacklight}:$reset\n";
}

sub update_workspace_profiles {
    print "Updating workspace-transfer profiles from Protocol-7...\n\n";

    # Generate YAML in protocol-7
    my $p7_yaml = File::Spec->catfile($P7_ROOT, '.deps', 'protocol7_full.yaml');
    generate_yaml($p7_yaml);

    print "\n📋 To manually update workspace-transfer profiles:\n";
    print "   1. Review the generated YAML: $p7_yaml\n";
    print "   2. Update workspace-transfer/.deps/profiles.yaml with new dependencies\n";
    print "   3. Commit and push changes\n\n";

    print "Or use this to sync automatically:\n";
    print "   bin/p7-deps copy-to-workspace\n";
}

sub show_help {
    print <<'HELP';
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
Protocol-7 Dependency Manager
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

USAGE:
  bin/p7-deps <command> [args]

COMMANDS:
  list                    List all dependencies from all sources
  check [profile]         Check aggregated dependencies for a profile
  generate [file]         Generate YAML from Protocol-7 dependencies
  update-workspace        Update workspace-transfer profiles guidance
  help                    Show this help

DEPENDENCY SOURCES:
  - modules/base.known_dependencies
    Perl module definitions with Debian package mappings

  - configuration/zenki/*/pm-dep
    Zero-byte files indicating required CPAN modules per zenka

  - configuration/zenki/*/os-dep/debian
    Zero-byte files indicating required Debian packages per zenka

  - configuration/zenki/*/os-dep/binary
    Zero-byte files indicating required system commands per zenka

EXAMPLES:
  bin/p7-deps list                 # Show all dependencies
  bin/p7-deps check protocol7      # Check aggregated dependencies
  bin/p7-deps generate             # Generate YAML file
  bin/p7-deps update-workspace     # Guidance for updating workspace

WORKFLOW:
  1. Update base.known_dependencies or zenki configurations
  2. Run: bin/p7-deps generate
  3. Review: .deps/protocol7_full.yaml
  4. Update workspace-transfer/.deps/profiles.yaml
  5. Commit both repositories

FILES:
  modules/base.known_dependencies     Perl module database
  configuration/zenki/*/pm-dep/       CPAN module requirements
  configuration/zenki/*/os-dep/       OS package requirements
  .deps/protocol7_full.yaml           Generated dependency file

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
HELP
}

