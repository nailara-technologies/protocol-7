#!/usr/bin/env perl
# Protocol-7 Dependency Management System
# Profile-based dependency installation and verification

use strict;
use warnings;
use FindBin qw($RealBin);
use File::Spec;
use File::Path qw(make_path);
use Cwd        qw(abs_path);
use English;

BEGIN {
    use lib "$RealBin/../data/lib-path/pm";
}

use AMOS7::deps::module qw(
    load_known_deps
    scan_zenki_pm_deps
    probe_module
    resolve_install
);
use AMOS7::deps::os_package qw(
    detect_os
    scan_zenki_os_deps
    probe_os_pkg
    probe_binary
);
use AMOS7::deps::debp      qw( probe_apt install_apt );
use AMOS7::deps::dist_upgr ();

$OUTPUT_AUTOFLUSH = 1;

# Color palette
my $reset      = "\e[0m";
my $blacklight = "\e[38;2;68;39;172m";
my $TRUE_color = "\e[38;2;6;71;195m";
my $neon_green = "\e[38;2;71;195;6m";
my $neon_amber = "\e[38;2;197;141;7m";

##[ SIGNAL HANDLERS ]#########################################################

$SIG{INT} = sub {
    print "\n${neon_amber}:. interrupted by user${reset}\n";
    exit 130;
};

##[ PROJECT PATH DISCOVERY ]##################################################

sub catdir  { File::Spec->catdir(@_) }
sub rel2abs { File::Spec->rel2abs(@_) }

my $up_dir  = File::Spec->updir;
my $P7_ROOT = abs_path( rel2abs( catdir( $RealBin, $up_dir ) ) );

my $DEPS_DIR      = catdir( $P7_ROOT, '.deps' );
my $PROFILES_FILE = File::Spec->catfile( $DEPS_DIR, 'profiles.yaml' );
my $CACHE_DIR     = catdir( $DEPS_DIR, 'cache' );
my $ZENKI_DIR     = catdir( $P7_ROOT,  'configuration', 'zenki' );

make_path($CACHE_DIR) unless -d $CACHE_DIR;

my %pkg_cache  = ();
my $known_deps = load_known_deps($P7_ROOT);
my $host_os    = detect_os();

# Parse command
my $cmd = shift @ARGV || 'help';

if ( $cmd eq 'check' ) {
    check_profile( @ARGV, 'explicit' );
} elsif ( $cmd eq 'install' ) {
    install_profile(@ARGV);
} elsif ( $cmd eq 'list' ) {
    list_profiles();
} elsif ( $cmd eq 'status' ) {
    status_all();
} elsif ( $cmd eq 'clear-cache' ) {
    clear_cache();
} elsif ( $cmd eq 'zenka-modules' ) {
    show_zenka_modules(@ARGV);
} elsif ( $cmd eq 'zenka-packages' ) {
    show_zenka_packages(@ARGV);
} elsif ( $cmd eq 'validate' ) {
    validate_zenka_declarations(@ARGV);
} elsif ( $cmd eq 'dist-upgrade' ) {
    run_dist_upgrade(@ARGV);
} elsif ( $cmd eq 'help' || $cmd eq '--help' || $cmd eq '-h' ) {
    show_help();
} else {
    print_error( "Unknown command: $cmd", 0 );
    show_help();
    exit 1;
}

sub check_profile {
    my ( $profile_name, $opts, $is_explicit ) = @_;

    unless ($profile_name) {
        die "Usage: bin/p7-deps check <profile> [--no-cache]\n";
    }

    my $use_cache         = 1;
    my $is_explicit_check = 0;

    if ( defined $opts ) {
        $use_cache         = 0 if $opts eq '--no-cache';
        $is_explicit_check = 1 if $opts eq 'explicit';
    }
    if ( defined $is_explicit ) {
        $use_cache         = 0 if $is_explicit eq '--no-cache';
        $is_explicit_check = 1 if $is_explicit eq 'explicit';
    }

    if ( $use_cache && !$is_explicit_check ) {
        my $cached = check_cache($profile_name);
        if ( defined $cached ) {
            if ($cached) {
                print "$profile_name: all dependencies installed (cached)\n";
                return 0;
            } else {
                print "$profile_name: missing dependencies "
                    . "(cached - use --no-cache to recheck)\n";
                return 1;
            }
        }
    }

    my $profiles = load_profiles();
    unless ( exists $profiles->{$profile_name} ) {
        die "Unknown profile: $profile_name\nRun "
            . "'bin/p7-deps list' to see available profiles.\n";
    }

    my $profile = $profiles->{$profile_name};

    print ":\n::[ dependency check ]\n:\n";
    print "   profile : $profile_name\n";
    print "   $profile->{description}\n\n";

    my @missing;
    my $total  = 0;
    my $all_ok = 1;

    if ( $profile->{includes} ) {
        print ":: includes: "
            . join( ', ', @{ $profile->{includes} } ) . "\n\n";
        for my $included ( @{ $profile->{includes} } ) {
            my $result = check_profile( $included, '--no-cache',
                $is_explicit_check ? 'explicit' : undef );
            $all_ok = 0 if $result != 0;
        }
    }

    # Check APT packages
    if ( $profile->{apt} ) {
        print ":: APT packages\n";
        for my $pkg ( @{ $profile->{apt} } ) {
            $total++;
            if ( probe_apt($pkg) ) {
                print "::   $pkg ................... installed\n";
            } else {
                print "::   $pkg ................... missing\n";
                push @missing, "apt:$pkg";
            }
        }
        print "\n";
    }

    # Check CPAN modules
    if ( $profile->{cpan} ) {
        print ":: CPAN modules\n";
        for my $module ( @{ $profile->{cpan} } ) {
            $total++;
            if ( probe_module($module) ) {
                print "::   $module ................... installed\n";
            } else {
                print "::   $module ................... missing\n";
                push @missing, "cpan:$module";
            }
        }
        print "\n";
    }

    # Check CPAN fallback modules
    if ( $profile->{cpan_fallback} ) {
        print ":: CPAN modules (Debian fallback)\n";
        for my $module ( @{ $profile->{cpan_fallback} } ) {
            $total++;
            my $resolved = resolve_install( $module, $known_deps );

            if ( $resolved->{method} eq 'debian'
                && probe_apt( $resolved->{pkg} ) ) {
                print "::   $module ................... "
                    . "installed (via Debian: $resolved->{pkg})\n";
            } elsif ( probe_module($module) ) {
                print "::   $module ................... installed\n";
            } else {
                print "::   $module ................... missing\n";
                push @missing, "cpan:$module";
            }
        }
        print "\n";
    }

    $all_ok = 0 if @missing;

    if (@missing) {
        print ":\n::  "
            . scalar(@missing)
            . " missing --- run: bin/p7-deps install $profile_name\n:\n";
        update_cache( $profile_name, 0 );
        return 1;
    } else {
        print ":\n::  all dependencies installed ($total/$total)\n:\n";
        update_cache( $profile_name, 1 );
        return 0;
    }
}

sub install_profile {
    my ( $profile_name, $opts ) = @_;

    unless ($profile_name) {
        $profile_name = 'minimal';
    }

    my $profiles = load_profiles();
    unless ( exists $profiles->{$profile_name} ) {
        die "Unknown profile: $profile_name\n";
    }

    my $profile = $profiles->{$profile_name};

    print "\n${neon_green}::[ install profile ]${reset}\n";
    print "   $profile->{description}\n\n";

    if ( $profile->{includes} ) {
        print ":: includes: "
            . join( ', ', @{ $profile->{includes} } ) . "\n\n";
        for my $included ( @{ $profile->{includes} } ) {
            install_profile( $included, $opts );
        }
    }

    my @to_install_apt;
    my @to_install_cpan;

    if ( $profile->{apt} ) {
        for my $pkg ( @{ $profile->{apt} } ) {
            unless ( probe_apt($pkg) ) {
                push @to_install_apt, $pkg;
            }
        }
    }

    if ( $profile->{cpan} ) {
        for my $module ( @{ $profile->{cpan} } ) {
            unless ( probe_module($module) ) {
                push @to_install_cpan, $module;
            }
        }
    }

    if ( $profile->{cpan_fallback} ) {
        for my $module ( @{ $profile->{cpan_fallback} } ) {
            my $resolved = resolve_install( $module, $known_deps );

            if ( $resolved->{method} eq 'debian' ) {
                unless ( probe_apt( $resolved->{pkg} ) ) {
                    push @to_install_apt, $resolved->{pkg};
                }
            } else {
                unless ( probe_module($module) ) {
                    push @to_install_cpan, $module;
                }
            }
        }
    }

    # Install APT packages
    if (@to_install_apt) {
        print ":: installing APT packages: "
            . join( ', ', @to_install_apt ) . "\n";
        my $result = install_apt(@to_install_apt);
        if ( @{ $result->{failed} } ) {
            print ":: failed: " . join( ', ', @{ $result->{failed} } ) . "\n";
        }
        if ( @{ $result->{ok} } ) {
            print ":: installed: " . join( ', ', @{ $result->{ok} } ) . "\n";
        }
    }

    # Install CPAN modules
    if (@to_install_cpan) {
        print ":: installing CPAN modules: "
            . join( ', ', @to_install_cpan ) . "\n";

        my $cpan_available = `which cpanm 2>/dev/null`;
        my $cpan_cmd       = $cpan_available ? 'cpanm' : 'cpan';

        for my $module (@to_install_cpan) {
            print "::   installing $module...\n";

            my $cmd
                = ( $cpan_cmd eq 'cpanm' )
                ? "cpanm -n $module"
                : "cpan -T $module 2>&1 | grep -v 'Loading internal'";

            my $result = system($cmd);

            if ( $result == 0 ) {
                print "::   $module installed\n";
            } else {
                print "::   $module installation failed\n";
            }
        }
    }

    print "\n:: installation complete\n";
    update_cache( $profile_name, 1 );
}

sub list_profiles {
    my $profiles = load_profiles();

    print "\n${neon_green}::[ available profiles ]${reset}\n\n";

    for my $name ( sort keys %$profiles ) {
        my $profile = $profiles->{$name};
        print "${neon_green}$name${reset}\n";
        print "  $profile->{description}\n";

        if ( $profile->{includes} ) {
            print "  includes: "
                . join( ', ', @{ $profile->{includes} } ) . "\n";
        } else {
            my $total = 0;
            $total += scalar( @{ $profile->{apt} } )  if $profile->{apt};
            $total += scalar( @{ $profile->{cpan} } ) if $profile->{cpan};
            $total += scalar( @{ $profile->{cpan_fallback} } )
                if $profile->{cpan_fallback};
            print "  packages: $total total\n";
        }
        print "\n";
    }
}

sub status_all {
    my $profiles = load_profiles();

    print "\n${neon_green}::[[${TRUE_color} "
        . "dependency status ${neon_green}]${reset}\n";
    print "${neon_green}::${reset}\n\n";

    for my $name ( sort keys %$profiles ) {
        next if $profiles->{$name}{includes};

        print "checking ${neon_green}$name${reset}...\n";
        check_profile( $name, '--no-cache' );
        print "\n";
    }
}

sub clear_cache {
    my @cache_files = glob("$CACHE_DIR/*");
    for my $file (@cache_files) {
        unlink($file) or warn "Failed to remove $file: $!\n";
    }
    print ":: cache cleared\n";
}

sub run_dist_upgrade {
    my ($action) = @_;
    $action //= 'dist-upgrade';

    print "\n${neon_green}::[ $action ]${reset}\n\n";

    my $result = AMOS7::deps::dist_upgr::run($action);

    print $result->{log} if defined $result->{log};

    if ( $result->{ok} ) {
        print "\n:: ${neon_green}$action complete${reset}\n\n";
    } else {
        print "\n:: ${neon_amber}$action completed with errors${reset}\n\n";
    }
}

##[ INTROSPECTION COMMANDS ]##################################################

sub show_zenka_modules {
    my ($sort_key) = @_;
    $sort_key ||= 'module';

    print_header("Zenka Module Dependencies");

    my $pm_deps = scan_zenki_pm_deps($ZENKI_DIR);

    unless ( keys %$pm_deps ) {
        print "  No Perl module dependencies "
            . "declared in zenka configurations.\n\n";
        return;
    }

    if ( $sort_key eq 'zenka' ) {
        my %by_zenka;
        for my $module ( keys %$pm_deps ) {
            for my $zenka ( @{ $pm_deps->{$module} } ) {
                push @{ $by_zenka{$zenka} }, $module;
            }
        }

        for my $zenka ( sort keys %by_zenka ) {
            print_section("${neon_green}$zenka${reset}");
            my @modules = sort @{ $by_zenka{$zenka} };
            for my $module (@modules) {
                print "  :. $module\n";
            }
            print "\n";
        }
    } else {
        for my $module ( sort keys %$pm_deps ) {
            my $zenki_list = join( ', ', sort @{ $pm_deps->{$module} } );
            print "  ${neon_green}$module${reset} (zenka: $zenki_list)\n";
        }
        print "\n";
    }

    print "Total modules: " . scalar( keys %$pm_deps ) . "\n\n";
}

sub show_zenka_packages {
    my ($sort_key) = @_;
    $sort_key ||= 'package';

    print_header("Zenka OS Package Dependencies");

    my $os_deps = scan_zenki_os_deps($ZENKI_DIR);

    my %all_packages;
    for my $type ( keys %$os_deps ) {
        for my $pkg ( keys %{ $os_deps->{$type} } ) {
            $all_packages{$pkg} = {
                type  => $type,
                zenki => $os_deps->{$type}{$pkg}
            };
        }
    }

    unless ( keys %all_packages ) {
        print "  No OS package dependencies "
            . "declared in zenka configurations.\n\n";
        return;
    }

    if ( $sort_key eq 'zenka' ) {
        my %by_zenka;
        for my $pkg ( keys %all_packages ) {
            for my $zenka ( @{ $all_packages{$pkg}{zenki} } ) {
                push @{ $by_zenka{$zenka} }, $pkg;
            }
        }

        for my $zenka ( sort keys %by_zenka ) {
            print_section("${neon_green}$zenka${reset}");
            my @packages = sort @{ $by_zenka{$zenka} };
            for my $pkg (@packages) {
                print "  :. $pkg\n";
            }
            print "\n";
        }
    } else {
        for my $pkg ( sort keys %all_packages ) {
            my $info       = $all_packages{$pkg};
            my $zenki_list = join( ', ', sort @{ $info->{zenki} } );
            print "  ${neon_green}$pkg${reset} "
                . "(type: $info->{type}, zenka: $zenki_list)\n";
        }
        print "\n";
    }

    print "Total packages: " . scalar( keys %all_packages ) . "\n\n";
}

sub validate_zenka_declarations {
    print_header("Validating Zenka Dependency Declarations");

    my $pm_deps = scan_zenki_pm_deps($ZENKI_DIR);
    my $os_deps = scan_zenki_os_deps($ZENKI_DIR);

    my %all_zenka;
    for my $module ( keys %$pm_deps ) {
        for my $zenka ( @{ $pm_deps->{$module} } ) {
            $all_zenka{$zenka} = 1;
        }
    }
    for my $type ( keys %$os_deps ) {
        for my $pkg ( keys %{ $os_deps->{$type} } ) {
            for my $zenka ( @{ $os_deps->{$type}{$pkg} } ) {
                $all_zenka{$zenka} = 1;
            }
        }
    }

    my $total_zenka = scalar( keys %all_zenka );

    unless ($total_zenka) {
        print "  No zenka found with dependency declarations.\n\n";
        return;
    }

    print_section("Summary");
    print "  Found ${neon_green}$total_zenka${reset} "
        . "zenka with declared dependencies\n";

    my $total_pm  = scalar( keys %$pm_deps );
    my $total_deb = scalar( keys %{ $os_deps->{debian} // {} } );
    my $total_bin = scalar( keys %{ $os_deps->{binary} // {} } );

    print "  :. CPAN modules: $total_pm\n";
    print "  :. Debian packages: $total_deb\n";
    print "  :. Binary requirements: $total_bin\n";
    print "\n";

    print_section("Zenka with Dependencies");
    for my $zenka ( sort keys %all_zenka ) {
        my @modules = grep {
            grep { $_ eq $zenka } @{ $pm_deps->{$_} }
        } keys %$pm_deps;
        my @debian = grep {
            grep { $_ eq $zenka } @{ $os_deps->{debian}{$_} }
            }
            keys %{ $os_deps->{debian} // {} };
        my @binary = grep {
            grep { $_ eq $zenka } @{ $os_deps->{binary}{$_} }
            }
            keys %{ $os_deps->{binary} // {} };

        my $count = scalar(@modules) + scalar(@debian) + scalar(@binary);
        print "  ${neon_green}$zenka${reset}: $count dependencies\n";
        print "    :. CPAN: " . scalar(@modules) . "\n"  if @modules;
        print "    :. Debian: " . scalar(@debian) . "\n" if @debian;
        print "    :. Binary: " . scalar(@binary) . "\n" if @binary;
    }

    print "\n:: validation complete\n\n";
}

##[ STYLING FUNCTIONS ]#######################################################

sub print_header {
    my $title = shift;
    print "${blacklight}:${reset}\n";
    print "${blacklight}::[$neon_green $title $blacklight]${reset}\n";
    print "${blacklight}:${reset}\n\n";
}

sub print_section {
    my $title = shift;
    print "${blacklight}::[$TRUE_color $title $blacklight]${reset}\n";
}

sub print_error {
    my ( $message, $exit_code ) = @_;
    print "\n${blacklight}:\n::[$neon_amber ERROR $blacklight] "
        . ".: ${neon_amber}$message$blacklight ::\n:${reset}\n";
    exit($exit_code) if $exit_code;
}

##[ HELPER FUNCTIONS ]########################################################

sub load_profiles {
    unless ( -f $PROFILES_FILE ) {
        die "Cannot find $PROFILES_FILE\n";
    }

    open my $fh, '<', $PROFILES_FILE
        or die "Cannot read $PROFILES_FILE: $!\n";
    my %profiles;
    my $current_profile;
    my $current_section;

    while ( my $line = <$fh> ) {
        chomp $line;
        next if $line =~ /^\s*#/;
        next if $line =~ /^\s*$/;

        if ( $line =~ /^  ([\w-]+):$/ ) {
            $current_profile            = $1;
            $current_section            = undef;
            $profiles{$current_profile} = {};
        } elsif ( $line =~ /^    description: "(.+)"$/ ) {
            $profiles{$current_profile}{description} = $1;
        } elsif ( $line =~ /^    (includes|apt|cpan|cpan_fallback):$/ ) {
            $current_section = $1;
            $profiles{$current_profile}{$current_section} = [];
        } elsif ( $line =~ /^      - (.+)$/ ) {
            my $item = $1;
            $item =~ s/\s*#.*//;
            $item =~ s/\s+$//;
            push @{ $profiles{$current_profile}{$current_section} }, $item
                if $item;
        }
    }
    close $fh;

    return \%profiles;
}

sub check_cache {
    my ($profile_name) = @_;
    my $cache_file = File::Spec->catfile( $CACHE_DIR, "$profile_name.cache" );

    return undef unless -f $cache_file;

    open my $fh, '<', $cache_file or return undef;
    my $status = <$fh>;
    close $fh;

    chomp $status;
    return $status eq 'ok' ? 1 : 0;
}

sub update_cache {
    my ( $profile_name, $status ) = @_;
    my $cache_file = File::Spec->catfile( $CACHE_DIR, "$profile_name.cache" );

    open my $fh, '>', $cache_file or die "Cannot write cache: $!\n";
    print $fh $status ? 'ok' : 'fail';
    close $fh;
}

sub show_help {
    print <<"EOF";
${neon_green}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${reset}
${neon_green}Protocol-7 Dependency Manager${reset}
${neon_green}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${reset}

USAGE:
  bin/p7-deps [OPTION] <command> [args]

COMMANDS (Installation):
  ${TRUE_color}list${reset}                    List all available profiles
  ${TRUE_color}check${reset} [profile]         Check dependencies for a profile
  ${TRUE_color}install${reset} [profile]       Install all dependencies for a profile
  ${TRUE_color}status${reset}                  Show status of all base profiles
  ${TRUE_color}clear-cache${reset}             Clear the dependency cache
  ${TRUE_color}dist-upgrade${reset}            Run Debian dist-upgrade

COMMANDS (Introspection):
  ${TRUE_color}zenka-modules${reset}           Show which zenka declare which CPAN modules
  ${TRUE_color}zenka-packages${reset}          Show which zenka declare which OS packages
  ${TRUE_color}validate${reset}                Validate zenka dependency declarations

COMMANDS (Help):
  ${TRUE_color}help${reset}                    Show this help message

OPTIONS:
  ${TRUE_color}--no-cache${reset}              Force fresh dependency check (bypass cache)

EXAMPLES:
  bin/p7-deps list                          # List all profiles
  bin/p7-deps check minimal                 # Check minimal profile
  bin/p7-deps check development --no-cache  # Fresh check of development profile
  bin/p7-deps install minimal               # Install minimal profile
  bin/p7-deps status                        # Check all profiles
  bin/p7-deps zenka-modules                 # Show module-to-zenka mapping
  bin/p7-deps validate                      # Validate dependency declarations
  bin/p7-deps dist-upgrade                  # Run dist-upgrade

PROFILES:
  Profiles are defined in: $PROFILES_FILE

ZENKA CONFIGURATION:
  Zenka dependency declarations are read from:
    $ZENKI_DIR/<zenka-name>/pm-dep/       (CPAN modules)
    $ZENKI_DIR/<zenka-name>/os-dep/debian/ (Debian packages)
    $ZENKI_DIR/<zenka-name>/os-dep/binary/ (binary requirements)

EOF
}

