#!/usr/bin/env perl
use v5.32.0;
use utf8;
use strict;
use English;
use warnings;

###         ###
##  p7-deps  ##
###         ###

## profile-based dependency installation and verification, plus read-only
## hardware detection [ firmware \ hardware package suggestions ] and the
## systemd service unit commands [ see 'bin/p7-deps help' ]
##
## every output goes through the AMOS7::TERM::Frame helpers : a banner
## [ ' .: title :. ' ] per command, ':::[ section ]' headers, dot-leader
## status rows, errors as ':: < p7-deps > : message' on STDERR. colours on a
## terminal only, never with NO_COLOR. exit codes : 0 ok, 1 missing \ failed \
## unknown profile or command \ not root, 0110 usage errors

use FindBin qw| $RealBin |;
use File::Spec;
use File::Path qw| make_path |;
use Cwd        qw| abs_path |;

BEGIN {
    use lib "$RealBin/../data/lib-path/pm";
}

use AMOS7::deps::module qw|
    load_known_deps
    scan_zenki_pm_deps
    probe_module
    resolve_install
    install_pm_src
    |;
use AMOS7::deps::service qw|
    install
    enable
    disable
    check
    |;
use AMOS7::deps::os_package qw|
    detect_os
    scan_zenki_os_deps
    probe_os_pkg
    probe_binary
    |;
use AMOS7::deps::hw_detect qw| detect_hardware write_hw_profile |;
use AMOS7::deps::debp      qw| probe_apt install_apt |;
use AMOS7::deps::tracked   qw| record |;
use AMOS7::deps::dist_upgr ();
use AMOS7::TERM::Frame     qw|
    frame_column_line frame_title_banner frame_section_header
    frame_status_row frame_error_line frame_error_exit frame_option_list
    frame_terminal_width frame_fit_width
    |;

$OUTPUT_AUTOFLUSH = 1;

my $TOOL = qw| p7-deps |;

##[ SIGNAL HANDLERS ]#########################################################

$SIG{INT} = sub {
    ## house clean-exit shape [ cf. AMOS7::Util::do_exit ] : '\b\b' erases ##
    ## the echoed '^C', the reset sweeps stray attributes a child may have ##
    ## left, then the framed error line on STDERR                          ##
    print "\b\b\e[0m";
    print STDERR "\n", frame_error_line( $TOOL, 'interrupted by user' ), "\n";
    exit 130;
};

##[ PROJECT PATH DISCOVERY ]##################################################

sub catdir  { File::Spec->catdir(@_) }
sub rel2abs { File::Spec->rel2abs(@_) }

my $up_dir  = File::Spec->updir;
my $P7_ROOT = abs_path( rel2abs( catdir( $RealBin, $up_dir ) ) );

my $DEPS_DIR      = catdir( $P7_ROOT, '.deps' );
my $PROFILES_FILE = File::Spec->catfile( $DEPS_DIR, 'profiles.yaml' );
my $CACHE_DIR     = catdir( $DEPS_DIR, 'cache' );
my $ZENKI_DIR     = catdir( $P7_ROOT,  'cfg', 'zenki' );

## the cache dir is created by update_cache when it first writes -- read ##
## only commands [ help, check-service ] write nothing into the checkout ##

my %pkg_cache  = ();
my $known_deps = load_known_deps($P7_ROOT);
my $host_os    = detect_os();

## parse command ##
my $cmd = shift @ARGV || 'help';

## check \ install take one or more profiles [ options start with '-' ] ; ##
## every name is validated before anything runs                           ##
my @profile_args = grep { !m|^-| } @ARGV;
my @option_args  = grep {m|^-|} @ARGV;
if ( $cmd eq 'check' or $cmd eq 'install' ) {
    my $profiles = load_profiles();
    my @unknown  = grep { not exists $profiles->{$ARG} } @profile_args;
    if (@unknown) {
        frame_error_exit(
            $TOOL,
            sprintf(
                'unknown profile%s [ %s ] -- bin/p7-deps list shows them',
                @unknown > 1 ? 's' : '',
                join( ', ', @unknown )
            ),
            { exit => 1 }
        );
    }
}

if ( $cmd eq 'check' ) {
    frame_error_exit( $TOOL,
        'check needs a profile [ bin/p7-deps check <profile>.. --no-cache ]' )
        if not @profile_args;
    banner('dependency check');
    ## exit 1 when a profile or one of its included profiles misses ##
    ## dependencies [ bin/p7-install ]                              ##
    my $missing = 0;
    $missing += check_profile( $ARG, @option_args, 'explicit' )
        for @profile_args;
    exit( $missing ? 1 : 0 );
} elsif ( $cmd eq 'install' ) {
    @profile_args = qw| minimal | if not @profile_args;
    banner('dependency install');
    ## exit 1 when an apt \ cpan install failed [ bin/p7-install ] ##
    my $failed = 0;
    my @installed;
    foreach my $profile_name (@profile_args) {
        my $profile_failed = install_profile($profile_name);
        $failed += $profile_failed;
        push @installed, $profile_name if not $profile_failed;
    }
    record_profiles(@installed);
    exit( $failed ? 1 : 0 );
} elsif ( $cmd eq 'list' ) {
    list_profiles();
} elsif ( $cmd eq 'status' ) {
    status_all();
} elsif ( $cmd eq 'clear-cache' ) {
    clear_cache();
} elsif ( $cmd eq 'zenka-modules' ) {
    show_zenka_modules(@ARGV);
} elsif ( $cmd eq 'zenka-packages' ) {
    show_zenka_packages(@ARGV);
} elsif ( $cmd eq 'validate' ) {
    validate_zenka_declarations(@ARGV);
} elsif ( $cmd eq 'dist-upgrade' ) {
    run_dist_upgrade(@ARGV);
} elsif ( $cmd eq 'install-service' ) {
    cmd_install_service();
} elsif ( $cmd eq 'enable-service' ) {
    cmd_enable_service(1);
} elsif ( $cmd eq 'disable-service' ) {
    cmd_enable_service(0);
} elsif ( $cmd eq 'check-service' ) {
    my $all_ok = cmd_check_service();
    exit( $all_ok ? 0 : 1 );
} elsif ( $cmd eq 'detect-hw' ) {
    cmd_detect_hw(@ARGV);
} elsif ( $cmd eq 'help' || $cmd eq '--help' || $cmd eq '-h' ) {
    show_help();
} else {
    frame_error_exit(
        $TOOL,
        "unknown command [ $cmd ] -- bin/p7-deps help lists them",
        { exit => 1 }
    );
}

sub check_profile {
    my ( $profile_name, $opts, $is_explicit ) = @_;

    frame_error_exit( $TOOL, 'check needs a profile name' )
        if not $profile_name;

    my $use_cache         = 1;
    my $is_explicit_check = 0;

    if ( defined $opts ) {
        $use_cache         = 0 if $opts eq '--no-cache';
        $is_explicit_check = 1 if $opts eq 'explicit';
    }
    if ( defined $is_explicit ) {
        $use_cache         = 0 if $is_explicit eq '--no-cache';
        $is_explicit_check = 1 if $is_explicit eq 'explicit';
    }

    if ( $use_cache && !$is_explicit_check ) {
        my $cached = check_cache($profile_name);
        if ( defined $cached ) {
            if ($cached) {
                print_rows(
                    [   $profile_name, 'all dependencies installed',
                        'cached',      'ok'
                    ]
                );
                return 0;
            } else {
                print_rows(
                    [   $profile_name,
                        'missing dependencies',
                        'cached -- --no-cache checks again', 'warn'
                    ]
                );
                return 1;
            }
        }
    }

    my $profiles = load_profiles();
    frame_error_exit( $TOOL,
        "unknown profile [ $profile_name ] -- bin/p7-deps list shows them" )
        unless exists $profiles->{$profile_name};

    my $profile = $profiles->{$profile_name};

    my @missing;
    my $total       = 0;
    my $inc_missing = 0;
    my $inc_total   = 0;

    ## included profiles first -- each one is its own section above ; their ##
    ## missing packages count for this profile too [ the exit code, the     ##
    ## summary and the cache, like install counts them ]                    ##
    if ( $profile->{includes} ) {
        for my $included ( @{ $profile->{includes} } ) {
            my ( $missed, $count )
                = check_profile( $included, '--no-cache',
                $is_explicit_check ? 'explicit' : undef );
            $inc_missing += $missed;
            $inc_total   += $count;
        }
    }
    $total += $inc_total;

    my @rows = ( [ 'description', $profile->{description}, undef, 'value' ] );
    push @rows,
        [
        'includes', join( ', ', @{ $profile->{includes} } ),
        undef,      'value'
        ]
        if $profile->{includes};

    ## check apt packages ##
    if ( $profile->{apt} ) {
        for my $pkg ( @{ $profile->{apt} } ) {
            $total++;
            if ( probe_apt($pkg) ) {
                push @rows, [ $pkg, 'installed', 'apt', 'ok' ];
            } else {
                push @rows,    [ $pkg, 'missing', 'apt' ];
                push @missing, "apt:$pkg";
            }
        }
    }

    ## check cpan modules ##
    if ( $profile->{cpan} ) {
        for my $module ( @{ $profile->{cpan} } ) {
            $total++;
            if ( probe_module($module) ) {
                push @rows, [ $module, 'installed', 'cpan', 'ok' ];
            } else {
                push @rows,    [ $module, 'missing', 'cpan' ];
                push @missing, "cpan:$module";
            }
        }
    }

    ## check cpan modules with a debian package first ##
    if ( $profile->{cpan_fallback} ) {
        for my $module ( @{ $profile->{cpan_fallback} } ) {
            $total++;
            my $resolved = resolve_install( $module, $known_deps );
            my $via
                = $resolved->{method} eq 'debian'
                ? "debian : $resolved->{pkg}"
                : 'cpan';

            if ( $resolved->{method} eq 'debian'
                && probe_apt( $resolved->{pkg} ) ) {
                push @rows, [ $module, 'installed', $via, 'ok' ];
            } elsif ( probe_module($module) ) {
                push @rows, [ $module, 'installed', 'cpan', 'ok' ];
            } else {
                push @rows,    [ $module, 'missing', $via ];
                push @missing, "cpan:$module";
            }
        }
    }

    say frame_section_header("profile $profile_name");
    my $missing_n = scalar(@missing) + $inc_missing;
    if ($missing_n) {
        print_rows(
            @rows, undef,
            [   'result',
                $missing_n . ' missing',
                "bin/p7-deps install $profile_name", 'warn'
            ]
        );
        say frame_column_line();
        update_cache( $profile_name, 0 );
        return wantarray ? ( $missing_n, $total ) : $missing_n;
    } else {
        print_rows(
            @rows, undef,
            [   'result',          'all dependencies ' . 'installed',
                "$total / $total", 'ok'
            ]
        );
        say frame_column_line();
        update_cache( $profile_name, 1 );
        return wantarray ? ( 0, $total ) : 0;
    }
}

## once per run : shared includes, repeated names ##
my %installed_profiles;

sub install_profile {
    my ( $profile_name, $opts ) = @_;

    unless ($profile_name) {
        $profile_name = 'minimal';
    }
    return 0 if $installed_profiles{$profile_name}++;

    ## failed apt \ cpan installs, included profiles counted in ##
    my $failed = 0;

    my $profiles = load_profiles();
    frame_error_exit( $TOOL,
        "unknown profile [ $profile_name ] -- bin/p7-deps list shows them" )
        unless exists $profiles->{$profile_name};

    my $profile = $profiles->{$profile_name};

    ## included profiles first -- each one is its own section above ##
    if ( $profile->{includes} ) {
        for my $included ( @{ $profile->{includes} } ) {
            $failed += install_profile( $included, $opts );
        }
    }

    my @to_install_apt;
    my @to_install_cpan;

    if ( $profile->{apt} ) {
        for my $pkg ( @{ $profile->{apt} } ) {
            unless ( probe_apt($pkg) ) {
                push @to_install_apt, $pkg;
            }
        }
    }

    if ( $profile->{cpan} ) {
        for my $module ( @{ $profile->{cpan} } ) {
            unless ( probe_module($module) ) {
                push @to_install_cpan, $module;
            }
        }
    }

    if ( $profile->{cpan_fallback} ) {
        for my $module ( @{ $profile->{cpan_fallback} } ) {
            my $resolved = resolve_install( $module, $known_deps );

            if ( $resolved->{method} eq 'debian' ) {
                unless ( probe_apt( $resolved->{pkg} ) ) {
                    push @to_install_apt, $resolved->{pkg};
                }
            } else {
                unless ( probe_module($module) ) {
                    push @to_install_cpan, $module;
                }
            }
        }
    }

    ## rows are printed while installing -- the label column is known now ##
    my $width = label_width( qw| description includes apt-get result |,
        @to_install_apt, @to_install_cpan );
    my $row = sub { say frame_status_row( @{ row_args( $width, @ARG ) } ) };

    say frame_section_header("install $profile_name");
    $row->( 'description', $profile->{description}, undef, 'value' );
    $row->(
        'includes', join( ', ', @{ $profile->{includes} } ),
        undef,      'value'
    ) if $profile->{includes};

    ## install apt packages ##
    if (@to_install_apt) {
        $row->( 'apt-get', 'installing', join( ', ', @to_install_apt ) );
        my $result = install_apt(@to_install_apt);
        if ( @{ $result->{failed} } ) {
            $failed += @{ $result->{failed} };
            $row->( $ARG, 'failed', 'apt' ) for @{ $result->{failed} };
        }
        if ( @{ $result->{ok} } ) {
            $row->( $ARG, 'installed', 'apt', 'ok' ) for @{ $result->{ok} };
        }
    }

    ## install cpan modules ##
    if (@to_install_cpan) {
        ## cpanm does the installs -- on a host without it cpanminus comes  ##
        ## from apt first ; only when that fails the slow cpan shell is the ##
        ## fallback                                                         ##
        if ( not `which cpanm 2>/dev/null` ) {
            $row->( 'cpanminus', 'installing', 'apt' );
            my $result = install_apt(qw| cpanminus |);
            if ( @{ $result->{ok} } ) {
                $row->( 'cpanminus', 'installed', 'apt', 'ok' );
            } else {
                $row->(
                    'cpanminus',            'unavailable',
                    'falling back to cpan', 'warn'
                );
                $failed += @{ $result->{failed} };
            }
        }
        ## cpanminus was ensured above -- cpanm is the only installer here ##

        for my $module (@to_install_cpan) {
            $row->( $module, 'installing' );

            ## local pm-src sources first, cpan as fallback -- the report ##
            ## says which one was used                                    ##
            my $resolved       = resolve_install( $module, $known_deps );
            my $installed_from = '';

            if ( $resolved->{method} eq 'pm_src' ) {
                $row->(
                    $module, 'building',
                    'local sources : ' . join( ', ', @{ $resolved->{dirs} } )
                );
                if ( install_pm_src( $P7_ROOT, @{ $resolved->{dirs} } ) ) {
                    $installed_from = 'pm-src';
                } else {
                    $row->(
                        $module,
                        'pm-src failed',
                        'falling back to cpan', 'warn'
                    );
                }
            }

            ## a debian package satisfies the module : apt first, cpanm ##
            ## only when the package is unavailable                     ##
            ## [ no build toolchain needed on the host ]                ##
            if ( not length $installed_from
                and $resolved->{method} eq 'debian' ) {
                my $result = install_apt( $resolved->{pkg} );
                if ( @{ $result->{ok} } ) {
                    $installed_from = 'apt';
                } else {
                    $failed += @{ $result->{failed} };
                    $row->(
                        $module, 'apt failed', 'falling back to cpan', 'warn'
                    );
                }
            }

            if ( not length $installed_from ) {
                ## quiet cpanm keeps the report clean ; on failure the tail ##
                ## of its output is shown as framed rows                    ##
                my $output = qx|cpanm -q -n $module 2>&1|;
                if ( $CHILD_ERROR == 0 ) {
                    $installed_from = 'cpan';
                } else {
                    my @lines = split m{\n}, $output // '';
                    @lines = @lines > 5 ? @lines[ -5 .. -1 ] : @lines;
                    $row->( 'cpanm', $ARG, undef, 'warn' )
                        foreach grep {length} @lines;
                }
            }

            if ( length $installed_from ) {
                $row->( $module, 'installed', $installed_from, 'ok' );
            } else {
                $failed++;
                $row->( $module, 'failed', 'cpanm' );
            }
        }
    }

    ## the cache says ok only when nothing failed ##
    say frame_column_line('::');
    if ($failed) {
        $row->(
            'result',
            'installation incomplete',
            "$failed failed", 'warn'
        );
    } else {
        $row->( 'result', 'installation complete', undef, 'ok' );
    }
    say frame_column_line();
    update_cache( $profile_name, $failed ? 0 : 1 );
    return $failed;
}

## the profiles installed cleanly this run, into the tracked store     ##
## [ type 'profile' ] -- bin/p7-install picks the most recent one on a ##
## re-run without --profile. a failed write is reported, never fatal   ##
sub record_profiles {
    my (@profiles) = @ARG;
    return unless @profiles;

    my $recorded = eval {
        record(
            $P7_ROOT,
            [   map {
                    {   'type'   => qw| profile |,
                        'pkg'    => $ARG,
                        'source' => $TOOL,
                    }
                } @profiles
            ]
        );
    };
    print STDERR frame_error_line(
        $TOOL, 'installed profile not recorded in the tracked store'
        ),
        "\n"
        if not $recorded;
    return;
}

sub list_profiles {
    my $profiles = load_profiles();

    my @rows;
    for my $name ( sort keys %$profiles ) {
        my $profile = $profiles->{$name};
        my $detail;

        if ( $profile->{includes} ) {
            $detail = 'includes : ' . join( ', ', @{ $profile->{includes} } );
        } else {
            my $total = 0;
            $total += scalar( @{ $profile->{apt} } )  if $profile->{apt};
            $total += scalar( @{ $profile->{cpan} } ) if $profile->{cpan};
            $total += scalar( @{ $profile->{cpan_fallback} } )
                if $profile->{cpan_fallback};
            $detail = "$total package" . ( $total == 1 ? '' : qw| s | );
        }
        push @rows, [ $name, $profile->{description}, $detail, 'value' ];
    }

    banner('dependency profiles');
    say frame_section_header('available profiles');

    ## on a terminal the description fits the width -- the name, the dot    ##
    ## leaders and the bracketed counts stay whole ; a pipe or a file keeps ##
    ## the full text [ frame_terminal_width 0 -> no limit ]                 ##
    my $term_width = frame_terminal_width();
    if ($term_width) {
        my $label_w = label_width( map { $ARG->[0] } @rows );
        for my $row (@rows) {
            my $fixed = 10 + $label_w + (
                defined $row->[2] && length $row->[2]
                ? length( $row->[2] ) + 5
                : 0
            );
            my $budget = $term_width - $fixed;
            if ( $budget >= 5 ) {
                $row->[1] = frame_fit_width( $row->[1], $budget )
                    if length( $row->[1] ) > $budget;
                next;
            }
            ## the bracket alone is too wide [ a long include list ] : the ##
            ## description keeps a short head, the bracket shrinks too     ##
            next if not defined $row->[2] or not length $row->[2];
            my ( $desc_w, $detail_w );
            ## a shorter head on narrow terminals ##
            for my $head ( 12, 4 ) {
                $desc_w   = $head;
                $detail_w = $term_width - 10 - $label_w - 5 - $desc_w;
                last if $detail_w >= 5;
            }
            next if $detail_w < 5;
            $row->[1] = frame_fit_width( $row->[1], $desc_w )
                if length( $row->[1] ) > $desc_w;
            $row->[2] = frame_fit_width( $row->[2], $detail_w )
                if length( $row->[2] ) > $detail_w;
        }
    }

    print_rows(@rows);
    say frame_column_line();
}

sub status_all {
    my $profiles = load_profiles();

    banner('dependency status');

    for my $name ( sort keys %$profiles ) {
        next if $profiles->{$name}{includes};
        check_profile( $name, '--no-cache' );
    }
}

sub clear_cache {
    my @cache_files = glob("$CACHE_DIR/*");
    my @rows;
    my $removed = 0;
    for my $file (@cache_files) {
        if ( unlink($file) ) {
            $removed++;
        } else {
            push @rows,
                [ ( File::Spec->splitpath($file) )[2], 'failed',
                "$OS_ERROR" ];
        }
    }
    push @rows,
        [
        'cache', 'cleared',
        "$removed removed" . ( @rows ? ', ' . @rows . ' failed' : '' ),
        @rows ? 'warn' : 'ok'
        ];

    banner('dependency cache');
    print_rows(@rows);
    say frame_column_line();
}

sub run_dist_upgrade {
    my ($action) = @_;
    $action //= 'dist-upgrade';

    banner($action);

    ## streamed : condensed lines arrive as they are produced, styled to  ##
    ## match the rest of the report -- step headers as framed sections,   ##
    ## package lines as status rows [ installed \ upgraded ], the '.. '   ##
    ## meta lines as status rows ; errors and unknown lines stay verbatim ##
    ## [ colours only on a terminal, plain rows in a pipe ]               ##
    my $result = AMOS7::deps::dist_upgr::run(
        $action,
        {   'emit' => sub {
                my $line = $_[0];
                if ( $line =~ m{^:\.\s(.+)\s\.\.,$} ) {
                    say frame_section_header($1);
                } elsif ( $line =~ m|^(\S+)\s{2}(\S+) -> (\S+)\s{2}(\S+)$| ) {
                    my ( $pkg, $old, $new, $size ) = ( $1, $2, $3, $4 );
                    say frame_status_row(
                        $pkg,
                        $old eq qw| new | ? qw| installed | : qw| upgraded |,
                        {   'detail' => sprintf '%s -> %s  %s',
                            $old, $new, $size,
                            'level' => qw| ok |
                        }
                    );
                } elsif ( $line =~ m|^(\S+)\s{2}removed\s{2}(\S+)$| ) {
                    say frame_status_row( $1, qw| removed |,
                        { 'detail' => $2 } );
                } elsif ( $line =~ m{^\.\. (\d+) names : (.+)$} ) {
                    say frame_status_row( '..', $2,
                        { 'detail' => sprintf '%d names', $1 } );
                } elsif ( $line =~ m{^\.\. (\d+) routine lines condensed$} ) {
                    say frame_status_row(
                        '..',
                        'routine lines condensed',
                        { 'detail' => $1 }
                    );
                } else {
                    ## everything apt said itself : framed rows so the      ##
                    ## whole stream reads in the report's visual language [ ##
                    ## errors in the warn color ; conffile prompts and      ##
                    ## tallies keep their text intact in the status ]       ##
                    my $level
                        = $line  =~ m{^(?:Err:|E:|W:)}
                        || $line =~ m{NO_PUBKEY|couldn't be verified}
                        ? qw| warn |
                        : qw| value |;
                    say frame_status_row( qw| apt |, $line,
                        { 'level' => $level } );
                }
            }
        }
    );

    print_rows(
        $result->{'ok'}
        ? [ $action, 'complete', undef, 'ok' ]
        : [ $action,                  'completed with errors',
            $result->{'failed_step'}, 'warn'
        ]
    );
    say frame_column_line();
    exit( $result->{'ok'} ? 0 : 1 );
}

##[ INTROSPECTION COMMANDS ]##################################################

sub show_zenka_modules {
    my ($sort_key) = @_;
    $sort_key ||= 'module';

    banner('zenka module dependencies');

    my $pm_deps = scan_zenki_pm_deps($P7_ROOT);

    unless ( keys %$pm_deps ) {
        print_rows(
            [   'perl modules',
                'none declared',
                'no zenka configuration declares one'
            ]
        );
        say frame_column_line();
        return;
    }

    my @rows;
    if ( $sort_key eq 'zenka' ) {
        my %by_zenka;
        for my $module ( keys %$pm_deps ) {
            for my $zenka ( @{ $pm_deps->{$module} } ) {
                push @{ $by_zenka{$zenka} }, $module;
            }
        }

        say frame_section_header('perl modules by zenka');
        for my $zenka ( sort keys %by_zenka ) {
            push @rows,
                [
                $zenka, join( ', ', sort @{ $by_zenka{$zenka} } ),
                undef,  'value'
                ];
        }
    } else {
        say frame_section_header('perl modules');
        for my $module ( sort keys %$pm_deps ) {
            push @rows,
                [
                $module, join( ', ', sort @{ $pm_deps->{$module} } ),
                undef,   'value'
                ];
        }
    }

    print_rows( @rows, undef,
        [ 'total', scalar( keys %$pm_deps ) . ' modules', undef, 'value' ] );
    say frame_column_line();
}

sub show_zenka_packages {
    my ($sort_key) = @_;
    $sort_key ||= 'package';

    banner('zenka os package dependencies');

    my $os_deps = scan_zenki_os_deps($ZENKI_DIR);

    my %all_packages;
    for my $type ( keys %$os_deps ) {
        for my $pkg ( keys %{ $os_deps->{$type} } ) {
            $all_packages{$pkg} = {
                type  => $type,
                zenki => $os_deps->{$type}{$pkg}
            };
        }
    }

    unless ( keys %all_packages ) {
        print_rows(
            [   'os packages',
                'none declared',
                'no zenka configuration declares one'
            ]
        );
        say frame_column_line();
        return;
    }

    my @rows;
    if ( $sort_key eq 'zenka' ) {
        my %by_zenka;
        for my $pkg ( keys %all_packages ) {
            for my $zenka ( @{ $all_packages{$pkg}{zenki} } ) {
                push @{ $by_zenka{$zenka} }, $pkg;
            }
        }

        say frame_section_header('os packages by zenka');
        for my $zenka ( sort keys %by_zenka ) {
            push @rows,
                [
                $zenka, join( ', ', sort @{ $by_zenka{$zenka} } ),
                undef,  'value'
                ];
        }
    } else {
        say frame_section_header('os packages');
        for my $pkg ( sort keys %all_packages ) {
            my $info = $all_packages{$pkg};
            push @rows,
                [
                $pkg,          join( ', ', sort @{ $info->{zenki} } ),
                $info->{type}, 'value'
                ];
        }
    }

    print_rows(
        @rows, undef,
        [   'total', scalar( keys %all_packages ) . ' packages',
            undef,   'value'
        ]
    );
    say frame_column_line();
}

sub validate_zenka_declarations {
    banner('zenka dependency declarations');

    my $pm_deps = scan_zenki_pm_deps($P7_ROOT);
    my $os_deps = scan_zenki_os_deps($ZENKI_DIR);

    my %all_zenka;
    for my $module ( keys %$pm_deps ) {
        for my $zenka ( @{ $pm_deps->{$module} } ) {
            $all_zenka{$zenka} = 1;
        }
    }
    for my $type ( keys %$os_deps ) {
        for my $pkg ( keys %{ $os_deps->{$type} } ) {
            for my $zenka ( @{ $os_deps->{$type}{$pkg} } ) {
                $all_zenka{$zenka} = 1;
            }
        }
    }

    my $total_zenka = scalar( keys %all_zenka );

    unless ($total_zenka) {
        print_rows(
            [ 'zenki', 'none', 'no zenka declares a dependency', 'value' ] );
        say frame_column_line();
        return;
    }

    my $total_pm  = scalar( keys %$pm_deps );
    my $total_deb = scalar( keys %{ $os_deps->{debian} // {} } );
    my $total_bin = scalar( keys %{ $os_deps->{binary} // {} } );

    say frame_section_header('summary');
    print_rows(
        [   'zenki', "$total_zenka with " . "declared dependencies",
            undef,   'value'
        ],
        [ 'cpan modules',        $total_pm,  undef, 'value' ],
        [ 'debian packages',     $total_deb, undef, 'value' ],
        [ 'binary requirements', $total_bin, undef, 'value' ],
    );
    say frame_column_line();

    my @rows;
    for my $zenka ( sort keys %all_zenka ) {
        my @modules = grep {
            grep { $_ eq $zenka }
                @{ $pm_deps->{$_} }
        } keys %$pm_deps;
        my @debian = grep {
            grep { $_ eq $zenka }
                @{ $os_deps->{debian}{$_} }
            }
            keys %{ $os_deps->{debian} // {} };
        my @binary = grep {
            grep { $_ eq $zenka }
                @{ $os_deps->{binary}{$_} }
            }
            keys %{ $os_deps->{binary} // {} };

        my $count = scalar(@modules) + scalar(@debian) + scalar(@binary);
        my @kinds;
        push @kinds, 'cpan ' . scalar(@modules)  if @modules;
        push @kinds, 'debian ' . scalar(@debian) if @debian;
        push @kinds, 'binary ' . scalar(@binary) if @binary;
        push @rows,
            [
            $zenka,
            "$count dependenc" . ( $count == 1 ? qw| y | : qw| ies | ),
            join( ', ', @kinds ), 'value'
            ];
    }

    say frame_section_header('zenki with dependencies');
    print_rows( @rows, undef, [ 'validation', 'complete', undef, 'ok' ] );
    say frame_column_line();
}

##[ HARDWARE DETECTION ]######################################################

## read-only : suggests firmware \ hardware packages from kernel log        ##
## failures, the loaded modules' modinfo firmware lists and the pci \ cpu   ##
## ids -- nothing is installed, no apt-get, no network. -write <name> saves ##
## the suggestions as a reviewable 'hw-<name>' profile                      ##

sub cmd_detect_hw {
    my (@args) = @_;

    my $write_name;
    while (@args) {
        my $arg = shift @args;
        if ( $arg eq '-write' ) {
            frame_error_exit( $TOOL,
                'detect-hw -write ' . 'needs a profile name' )
                unless @args;
            $write_name = shift @args;
        } else {
            frame_error_exit( $TOOL,
                      "unknown option [ $arg ] -- "
                    . 'detect-hw takes -write <name>' );
        }
    }

    if ( defined $write_name and $write_name !~ m|\A[a-z0-9-]+\z| ) {
        frame_error_exit(
            $TOOL,
            "invalid profile name [ $write_name ] -- "
                . 'only a-z 0-9 and \'-\' are allowed',
            { exit => 0110 }
        );
    }

    banner('hardware detection');

    my $result = detect_hardware();

    ## the kernel log the NEEDED evidence stands on ##
    say frame_section_header('kernel log');
    if ( $result->{kernel_log}{readable} ) {
        print_rows(
            [   $result->{kernel_log}{source},             'readable',
                'the NEEDED evidence below comes from it', 'ok'
            ]
        );
    } else {
        print_rows(
            [   'journalctl \ dmesg',
                'unreadable',
                'kernel log needs privileges [ try as '
                    . 'root ] -- no NEEDED evidence this run',
                'warn'
            ]
        );
    }
    say frame_column_line();

    ## the suggestions, grouped by strength ##
    for my $strength (qw| NEEDED POSSIBLE HARDWARE |) {
        my @rows;
        for my $suggestion ( @{ $result->{suggestions} } ) {
            next unless $suggestion->{strength} eq $strength;
            my @evidence = @{ $suggestion->{evidence} // [] };
            push @rows,
                [ $suggestion->{pkg}, lc $strength, shift @evidence, 'ok' ];
            push @rows, [ '', '', $_, 'ok' ] for @evidence;
        }
        next unless @rows;
        say frame_section_header( lc "$strength packages" );
        print_rows(@rows);
        say frame_column_line();
    }

    ## hardware findings that name no package [ the nvidia driver ] ##
    if ( @{ $result->{notes} } ) {
        say frame_section_header('notes');
        print_rows(
            map { [ $_->{topic}, 'separate decision', $_->{evidence}, ] }
                @{ $result->{notes} } );
        say frame_column_line();
    }

    ## firmware files no package mapping was found for ##
    if ( @{ $result->{unmapped} } ) {
        say frame_section_header('unmapped firmware');
        my @rows;
        for my $entry ( @{ $result->{unmapped} } ) {
            my @evidence = @{ $entry->{evidence} // [] };
            push @rows,
                [
                $entry->{file},
                lc $entry->{strength},
                shift(@evidence)
                    . ' -- no apt-file \ isenkram-lookup mapping',
                ];
            push @rows, [ '', '', $_, ] for @evidence;
        }
        print_rows(@rows);
        say frame_column_line();
    }

    ## the apt sources the firmware packages live in ##
    say frame_section_header('apt sources');
    print_rows(
        [   'non-free-firmware component',
            $result->{non_free_firmware} ? 'present' : 'missing',
            $result->{non_free_firmware}
            ? 'the detected firmware packages are installable'
            : 'needed by the detected firmware '
                . 'packages -- add it to the apt sources',
            $result->{non_free_firmware} ? 'ok' : 'warn'
        ]
    );
    say frame_column_line();

    ## -write : the reviewable profile [ every other profile untouched ] ##
    if ( defined $write_name ) {
        say frame_section_header("write hw-$write_name");
        my ( $written, $detail )
            = write_hw_profile( $PROFILES_FILE, $write_name,
            $result->{suggestions} );
        if ($written) {
            print_rows(
                [   'profile',                               'written',
                    "hw-$write_name " . "in $PROFILES_FILE", 'ok'
                ],
                [   'review', 'suggested',
                    'check the evidence ' . 'comments before install'
                ],
            );
        } else {
            print_rows( [ 'profile', 'failed', $detail, 'warn' ] );
        }
        say frame_column_line();
    }

    my $suggested = scalar @{ $result->{suggestions} };
    my $unmapped  = scalar @{ $result->{unmapped} };
    print_rows(
        undef,
        [   'result',
            "$suggested package"
                . ( $suggested == 1 ? '' : 's' )
                . ' suggested',
            $unmapped  ? "$unmapped unmapped firmware file" : undef,
            $suggested ? 'ok'                               : undef
        ]
    );
    say frame_column_line();
    return;
}

##[ SERVICE COMMANDS ]########################################################

## root-only, idempotent, and none of them ever starts, stops or restarts ##
## the service -- install-service reloads the systemd manager after a     ##
## changed unit, enable \ disable only flip the unit's enabled state.     ##
## P7_DEPS_SERVICE_ROOT prefixes every target path [ test roots ]         ##

sub require_root_for_service {
    return if $EUID == 0;
    return if length( $ENV{'P7_DEPS_SERVICE_ROOT'} // '' );
    frame_error_exit(
        $TOOL,
        'this service command needs root [ '
            . 'or a P7_DEPS_SERVICE_ROOT test root ]',
        { exit => 1 }
    );
}

sub cmd_install_service {
    require_root_for_service();
    banner('install service');
    say frame_section_header('install');
    my $failed = print_service_report( install($P7_ROOT) );
    say frame_column_line();

    ## the state read back from disk \ systemd, not what was just done ##
    say frame_section_header('state after install');
    my ($state) = check($P7_ROOT);
    print_service_report($state);
    say frame_column_line();
    exit 1 if $failed;
}

sub cmd_enable_service {
    my ($enable) = @_;
    require_root_for_service();
    banner( $enable ? 'enable service'           : 'disable service' );
    say frame_section_header( $enable ? 'enable' : 'disable' );
    my $failed = print_service_report( $enable ? enable() : disable() );
    say frame_column_line();
    exit 1 if $failed;
}

sub cmd_check_service {
    banner('check service');
    say frame_section_header('service parts');
    my ( $report, $all_ok ) = check($P7_ROOT);
    print_service_report( $report,
        $all_ok
        ? [ 'service parts', 'ok' ]
        : [ 'service parts', 'missing or differing', undef, 'warn' ] );
    say frame_column_line();
    return $all_ok;
}

## the report rows [ part, status, detail ], then a result row below a '::' ##
## line when given -- returns the count of failed parts                     ##
sub print_service_report {
    my ( $report, $result ) = @_;

    my $failed = grep { $ARG->[1] eq 'failed' } @$report;
    print_rows( @$report, ( defined $result ? ( undef, $result ) : () ) );
    return $failed;
}

##[ OUTPUT HELPERS ]##########################################################

## the main title framed by ':' lines ##
sub banner {
    my ($title) = @_;
    say frame_column_line();
    say frame_title_banner($title);
    say frame_column_line();
}

## the label column of a block : its longest label ##
sub label_width {
    my $width = 0;
    for my $label (@_) {
        $width = length($label) if length($label) > $width;
    }
    return $width;
}

## frame_status_row arguments for [ label, status, detail, level ] ##
sub row_args {
    my ( $width, $label, $status, $detail, $level ) = @_;
    return [
        $label,
        $status // '',
        { width => $width, detail => $detail, level => $level }
    ];
}

## a block of status rows aligned on its longest label ; undef stands for a ##
## '::' line [ before a result row ]                                        ##
sub print_rows {
    my (@rows) = @_;
    my $width = label_width( map { $ARG->[0] } grep {defined} @rows );
    for my $row (@rows) {
        if ( not defined $row ) {
            say frame_column_line('::');
        } else {
            say frame_status_row( @{ row_args( $width, @$row ) } );
        }
    }
}

##[ HELPER FUNCTIONS ]########################################################

sub load_profiles {
    frame_error_exit( $TOOL, "cannot find $PROFILES_FILE" )
        unless -f $PROFILES_FILE;

    open my $fh, '<',
        $PROFILES_FILE
        or frame_error_exit( $TOOL,
        "cannot read " . "$PROFILES_FILE : $OS_ERROR" );
    my %profiles;
    my $current_profile;
    my $current_section;

    while ( my $line = <$fh> ) {
        chomp $line;
        next if $line =~ m|^\s*#|;
        next if $line =~ m|^\s*$|;

        if ( $line =~ m|^  ([\w-]+):$| ) {
            $current_profile            = $1;
            $current_section            = undef;
            $profiles{$current_profile} = {};
        } elsif ( $line =~ m|^    description: "(.+)"$| ) {
            $profiles{$current_profile}{description} = $1;
        } elsif ( $line =~ m{^    (includes|apt|cpan|cpan_fallback):$} ) {
            $current_section = $1;
            $profiles{$current_profile}{$current_section} = [];
        } elsif ( $line =~ m|^      - (.+)$| ) {
            my $item = $1;
            $item =~ s|\s*#.*||;
            $item =~ s|\s+$||;
            push @{ $profiles{$current_profile}{$current_section} }, $item
                if $item;
        }
    }
    close $fh;

    return \%profiles;
}

sub check_cache {
    my ($profile_name) = @_;
    my $cache_file = File::Spec->catfile( $CACHE_DIR, "$profile_name.cache" );

    return undef unless -f $cache_file;

    open my $fh, '<', $cache_file or return undef;
    my $status = <$fh>;
    close $fh;

    chomp $status;
    return $status eq 'ok' ? 1 : 0;
}

sub update_cache {
    my ( $profile_name, $status ) = @_;
    my $cache_file = File::Spec->catfile( $CACHE_DIR, "$profile_name.cache" );

    ## non-fatal : the real check/install result is already printed by the ##
    ## time this runs, so a cache-write failure shouldn't abort the run    ##
    make_path($CACHE_DIR) unless -d $CACHE_DIR;
    open my $fh, '>',
        $cache_file
        or return print STDERR frame_error_line(
        $TOOL, "cannot write cache [ $cache_file ] : $OS_ERROR"
        ),
        "\n";
    print $fh $status ? 'ok' : 'fail';
    close $fh;
}

sub show_help {
    say frame_option_list(<<"EOL");

    .: p7-deps command line options :.

    list ...........................  the profiles and what they hold
    check <profile>.. ..............  check profiles [ exit 1 : missing ]
    install [<profile>..] ..........  install profiles [ default : minimal ]
    status .........................  check every profile without includes
    clear-cache ....................  remove the cached check results
    dist-upgrade [<action>] ........  apt-get dist-upgrade [ or <action> ]

    --no-cache .....................  check again, not from the cache

    detect-hw ......................  suggest firmware \ hardware packages
                                      [ read-only ] from the kernel log,
                                      loaded module firmware, pci \ cpu ids
    -write <name> .................  save the suggestions as profile
                                      hw-<name> [ evidence as comments ]

    install-service ................  unit, install link, launcher symlinks
    enable-service .................  enable the unit [ systemctl enable ]
    disable-service ................  disable the unit [ systemctl disable ]
    check-service ..................  read-only check of unit, links and
                                      unit state [ exit 1 : parts differ ]

    none of the service commands starts, stops or restarts the service.

    zenka-modules [zenka] ..........  perl modules the zenki declare
    zenka-packages [zenka] .........  os packages the zenki declare
    validate .......................  the zenka dependency declarations

    help ...........................  this option list

    profiles ...  $PROFILES_FILE
    zenki ......  $ZENKI_DIR/<zenka>/deps/
                  [ p-mod : cpan, os/deb : debian, os/bin : binaries ]

EOL
}

