#!/usr/bin/perl

use v5.24;
use strict;
use English;
use Sys::Hostname;

$PROGRAM_NAME = qw| [terminal] |;

my $font_size = 21;

$font_size = 14 if hostname eq qw| qmy-tp |;
$font_size = 17 if hostname eq qw| zuluma |;

my $x = 80;
my $y = 25;

## blacklight : #4427AC  nalara bg  : #09052A  truth      : #0647C3

my @exec_args = qw|

    /usr/bin/xterm
    -itc -ulit -wf
    -xrm *xterm*renderFont:true
    -xrm *xterm*faceName:WhiteRabbit
    -xrm *xterm*faceSize:17
    -xrm *xterm*Background:#010015
    -xrm *xterm*Foreground:#0647C3
    -xrm xterm*cursorColor:#4427AC
    -xrm *pointerColor:#7700FF
    -xrm *pointerShape:left_ptr
    -xrm *cursorBlink:true
    -xrm *cursorOffTime:769
    -xrm *cursorUnderLine:true
    -xrm *cursorOnTime:1274

    |;

use warnings;

shift(@ARGV)
    and $font_size = shift(@ARGV)
    if @ARGV > 1
    and $ARGV[0] eq qw| -s |
    and $ARGV[1] =~ m|^\d+$|;

shift(@ARGV)
    and $x = shift(@ARGV)
    if @ARGV > 1
    and $ARGV[0] eq qw| -x |
    and $ARGV[1] =~ m|^\d+$|;

shift(@ARGV)
    and $y = shift(@ARGV)
    if @ARGV > 1
    and $ARGV[0] eq qw| -y |
    and $ARGV[1] =~ m|^\d+$|;

push @exec_args, qw| -xrm |, sprintf qw| xterm*geometry:%dx%d |, $x, $y;

map { $ARG =~ s|Size:17|Size:$font_size| } @exec_args if $font_size != 17;

## larger \ smaller-vt-font only step through the font menu sizes : the     ##
## xterm defaults all sit below our face size, so there was nothing to grow ##
## to. menu sizes around the configured one, the start size in the middle,  ##
## and xterm's own shift + keypad plus \ minus steps through them           ##
my @menu_sizes = map { int( $font_size * $ARG + 0.5 ) } 0.6, 0.8, 1.25, 1.5,
    1.8, 2.2;
push @exec_args,
    map { ( qw| -xrm |, "xterm*faceSize$ARG:" . "$menu_sizes[$ARG - 1]" ) }
    1 .. 6;

shift(@ARGV) if @ARGV and $ARGV[0] eq qw| -e |;

push( @exec_args, qw| -e |, @ARGV ) if @ARGV;

exec @exec_args;

#,,..,,.,,.,.,,,.,.,.,..,,.,,,,..,.,.,.,.,.,.,..,,...,...,.,,,,,,,.,,,.,.,...,
