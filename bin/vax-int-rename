#!/usr/bin/perl
use v5.24;
use strict;
use English;
use warnings;
use Crypt::Misc qw| encode_b32r |;
use File::Spec;

my $pack_template = qw| V |;    ## 32-bit VAX integer encoding ##

## color codes for output
my %C = (
    '0' => "\e[0m",
    'R' => "\e[0m",
    'T' => "\e[38;2;6;71;195m",
    'b' => "\e[1m",
    'n' => "\e[38;2;197;141;7m",
);

## show usage and exit
sub show_usage {
    say "$C{0}:";
    say ":$C{b} $C{T}usage:$C{0} vax-int-rename "
        . "[file|directory] [file|directory] ...$C{R}";
    say "$C{0}:";
    say ":";
    say ": $C{T}Renames files whose basename "
        . "is a pure decimal number to their$C{0}";
    say ": $C{T}VAX-encoded base32 representation. "
        . "File extensions are preserved.$C{0}";
    say ": $C{T}Non-numeric filenames are left "
        . "unchanged and reported as skipped.$C{0}";
    say ":$C{R}";
    say "$C{0}:$C{R}";
    exit(1);
}

show_usage() if not @ARGV;

my $rename_count = 0;
my $skip_count   = 0;
my $error_count  = 0;
my @files_to_process;

## collect all files to process
foreach my $arg (@ARGV) {
    if ( -f $arg ) {
        push @files_to_process, $arg;
    } elsif ( -d $arg ) {
        opendir( my $dh, $arg ) or do {
            warn "\n: error opening directory '$arg': $!\n";
            $error_count++;
            next;
        };
        my @dir_files = grep { -f File::Spec->catfile( $arg, $_ ) }
            grep { $_ ne '.' and $_ ne '..' } readdir($dh);
        closedir($dh);

        foreach my $file (@dir_files) {
            push @files_to_process, File::Spec->catfile( $arg, $file );
        }
    } else {
        warn "\n: warning: not found: '$arg'\n";
        $error_count++;
    }
}

if ( not @files_to_process ) {
    say "\n$C{0}:";
    say ": no files to process";
    say "$C{0}:$C{R}\n";
    exit(0);
}

say "$C{0}:";

## process each file
foreach my $file_path (@files_to_process) {
    my ( $volume, $dir, $filename ) = File::Spec->splitpath($file_path);

    ## split basename and extension
    my ( $basename, $ext ) = ( $filename, '' );
    if ( $filename =~ m|^(.*)(\.[^.]+)$| ) {
        $basename = $1;
        $ext      = $2;
    }

    ## only rename pure decimal basenames
    if ( $basename !~ m|^\d+$| ) {
        $skip_count++;
        say ":$C{b} $C{n}skip$C{0}  $C{T}$filename$C{0}$C{R}";
        next;
    }

    ## VAX-encode the numeric basename
    my $encoded;
    eval {
        if ( $basename > 4294967295 ) {
            die "value exceeds 32-bit [ VAX encoding ]\n";
        }
        $encoded = encode_b32r( pack $pack_template, $basename );
        $encoded =~ s|A+$||;    ## remove zero padding ##
        $encoded = qw| A | if not length $encoded;
    };
    if ($EVAL_ERROR) {
        warn "\n: error encoding '$filename': $EVAL_ERROR\n";
        $error_count++;
        next;
    }

    my $new_filename = $encoded . $ext;
    my $new_path     = File::Spec->catpath( $volume, $dir, $new_filename );

    if ( $file_path eq $new_path ) {
        $skip_count++;
        say ":$C{b} $C{n}skip$C{0}  $C{T}$filename$C{0}$C{R}";
        next;
    }

    if ( -e $new_path ) {
        warn "\n: error renaming '$file_path' to "
            . "'$new_path': target already exists\n";
        $error_count++;
        next;
    }

    if ( rename( $file_path, $new_path ) ) {
        $rename_count++;
        say ":$C{b} $C{T}$filename$C{0}";
        say ": $C{T}  -> $new_filename$C{0}$C{R}";
    } else {
        warn "\n: error renaming '$file_path' to '$new_path': $!\n";
        $error_count++;
    }
}

say "$C{0}:";
say ":$C{b} $C{T}renamed: $rename_count$C{0}$C{R}";
say ":$C{b} $C{T}skipped: $skip_count$C{0}$C{R}";
say ":$C{b} $C{n}errors: $error_count$C{0}$C{R}" if $error_count;
say "$C{0}:$C{R}";
exit( $error_count ? 1 : 0 );

#,,..,..,,..,,..,,..,,.,.,,..,,.,,,,.,..,,,,.,.,.,...,..,,,..,.,.,,..,,..,...,
