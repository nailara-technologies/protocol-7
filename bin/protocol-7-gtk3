#!/usr/bin/env perl

use strict;
use warnings;

use English;
use Module::Load;
use File::Spec;
use Cwd qw| abs_path |;
use File::Spec::Functions;
use FindBin qw| $RealBin $RealScript |;
eval { load 'File::Which', qw| which | };
my $which_loaded = $EVAL_ERROR ? 0 : 1;

### wrapper code to load Gtk3 module at compile time ###

BEGIN {
    ( my $local_lib_path = $PROGRAM_NAME )
        =~ s|/[^/]+/[^/]+$|/data/lib-path/pm|;
    unshift( @INC, $local_lib_path ) if -d $local_lib_path;
    $ENV{'P7_GTK3_INIT'} = qw| true |;
    $ENV{'GDK_BACKEND'}  = qw| x11 |;
}

my $zenkaname;
my @call_args = @ARGV;

## [script path] ##
my $exec_path = abs_path( catfile( $RealBin, $RealScript ) );
my $bin_path  = abs_path($RealBin);
## [perl path] ##

my $perl_path;
eval {
    use Config;
    $perl_path = $Config{'perlpath'};
    if ( $OSNAME ne qw| VMS | ) {
        $perl_path .= $Config{'_exe'}
            unless $perl_path =~ m|\Q$Config{_exe}\E$|i;
    }
};
$perl_path //= $EXECUTABLE_NAME;

my $protocol_7_path = catfile( $bin_path, qw| Protocol-7 | );
die "<< '$protocol_7_path' : path not found >>" if !-f $protocol_7_path;

## zenka name [ link derived ] ###
if ( -l File::Spec->rel2abs($PROGRAM_NAME) ) {
    $zenkaname = lc($PROGRAM_NAME);
    $zenkaname =~ s{^.*protocol-7\.|[\. ]$}{};
    @call_args = ( $zenkaname, @ARGV );
}
$zenkaname //= qw| protocol-7 |;
exec( $perl_path, qw| -C31 -MGtk3 |, $protocol_7_path, @call_args )
    or die "failed to start $zenkaname zenka [ \l$OS_ERROR ]";

#,,..,.,,,...,.,.,.,,,,.,,.,.,,..,,.,,.,.,...,..,,...,...,.,.,..,,...,.,.,.,,,
#QAYQCJR4IOP2Y7YFYK6PAHWBG4UNFCW4JZW5D2NLZYL5BPQQSJFU5ZT5DKQNGS4ZCIWZFDZU4RSR2
#\\\|SDJYBBHYC4XLDLIVMMMZSNEXZLQHLRAAH75VKHKSDOJRPXAGAWP \ / AMOS7 \ YOURUM ::
#\[7]VBRXFAV7XUDUDQNNIQWLWT7TQPPNXH6QAXISI6D74JLEE4RXSEDY 7  DATA SIGNATURE ::
