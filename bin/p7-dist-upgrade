#!/bin/sh
# p7-dist-upgrade : thin wrapper around 'bin/p7-deps dist-upgrade'
#
# the v7-zenki exec-external start set-up only accepts a bare executable
# path as exec_bin [ no arguments -- src/v7-zenki.zenka.start rejects
# whitespace in exec_bin ], so the dist-upgrade zenka entries cannot call
# 'bin/p7-deps dist-upgrade' directly -- they exec this wrapper instead.
# replaces the legacy bin/dependencies/debian_dist_upgrade.sh.

set -e

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

exec "$SCRIPT_DIR/p7-deps" dist-upgrade "$@"

