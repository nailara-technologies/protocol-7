#!/usr/bin/perl

## kimi-task — submit prompt to kimi via p7c with base32r encoding ##
##
## usage:  bin/kimi-task "short prompt here"  bin/kimi-task < prompt-file.txt
## echo "prompt" | bin/kimi-task  bin/kimi-task -next "prompt"       ## force
## fresh session  bin/kimi-task -file task.md        ## read prompt from file
##

use strict;
use warnings;
use Crypt::Misc qw| encode_b32r |;
use Encode      qw| encode_utf8 |;

my $fresh  = 0;
my $prompt = '';

## parse args ##
while ( my $arg = shift @ARGV ) {
    if ( $arg eq '-next' ) {
        $fresh = 1;
    } elsif ( $arg eq '-file' ) {
        my $file = shift @ARGV // die ":: -file requires a path\n";
        open my $fh, '<:encoding(UTF-8)', $file
            or die ":: cannot read $file: $!\n";
        local $/;
        $prompt = <$fh>;
        close $fh;
    } elsif ( $arg eq '-help' or $arg eq '--help' ) {
        print <<~'USAGE';
        usage: kimi-task [options] [prompt]

        options:
          -next         force fresh kimi session before dispatch
          -file PATH    read prompt from file
          -help         show this help

        if no prompt arg, reads from stdin.
        prompt is base32r-encoded to avoid protocol framing issues.
        USAGE
        exit 0;
    } elsif ( not length $prompt ) {
        $prompt = $arg;
    }
}

## read from stdin if no prompt yet ##
unless ( length $prompt ) {
    if ( -t STDIN ) {
        print ":: enter prompt [ ctrl-d to submit ]:\n";
    }
    binmode STDIN, ':encoding(UTF-8)';
    local $/;
    $prompt = <STDIN> // '';
}

chomp $prompt;
binmode STDOUT, ':encoding(UTF-8)';

die ":: empty prompt\n" unless length $prompt;

## encode ##
my $encoded = encode_b32r( encode_utf8($prompt) );

## build command ##
my $prefix = $fresh ? ':next:' : '';
my $cmd    = "p7c kimi.ask-reply '${prefix}${encoded}'";

## show summary ##
my $preview = substr( $prompt, 0, 80 );
$preview .= '...' if length $prompt > 80;
printf ":: prompt: %s\n", $preview;
printf ":: encoded: %d bytes -> %d b32r chars\n",
    length($prompt), length($encoded);
printf ":: fresh session: %s\n", $fresh ? 'yes' : 'no';

## dispatch ##
exec $cmd;

#,,..,...,,.,,..,,,..,,..,,,,,,.,,,.,,..,,...,..,,...,...,..,,,,,,,,.,...,,..,
#GMIH334VRH2SPS2PGTV2ELLABQUAKI5GOR2LFLP2WM7O4YFEXGU6GPV7ARCCONSNW5M6FRDNEF6FQ
#\\\|XTXT4ZDEZM6CKHGY7FMLBOSLXNMGARITYXUOYA7U5ZS3DDHFL23 \ / AMOS7 \ YOURUM ::
#\[7]EFG4E3KC7BUAKX7SHAI5AZLVJCIHUZVWHV62ZT6XJVAONIS76ICA 7  DATA SIGNATURE ::
#:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
