#\\\|ILIM57RD76CM2I6QX6UQ6XLXWNGQT3TBELMU5CGFFD5NR7WYBTS \ / AMOS7 \ YOURUM ::
#\[7]YR6HIZIZ4AFNEFAZDFMBVQ2MKFUIJWDGDXPQIB4CGEBFPLCSMMCA 7  DATA SIGNATURE ::
#:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
