    {   'name'        => 'p7_detected_agent',
        'description' =>
            'debug/validation tool: reports what agent="auto" would '
            . 'currently resolve to for p7_memory_update/p7_memory_summary, '
            . 'and the raw signals used to decide it. no side effects.',
        'inputSchema' => {
            'type'                 => 'object',
            'properties'           => {},
            'additionalProperties' => \0
        }
