            . "<base>...<remote>/<branch>` + the newest commit message "
            . 'in full [ the session summary often lives there ]. base '
            . "defaults to the branch the dispatch started from [ the "
            . "repo's current branch ], else 'base' ; remote defaults "
            . "to 'hub'. branch / base / remote validated [ "
            . '^[A-Za-z0-9._/-]+$, no .. ] BEFORE any git call ; always '
            . '`git -c color.ui=false … --no-color` [ this shell forces '
            . 'colour otherwise ].',
        'params' => [
            [   'branch',
                'the branch the cloud session pushed [ optional — '
                    . 'omit to list the newest remote branches instead ]',
                0
            ],
            [   'base',
                'range base [ default : the branch the dispatch started '
                    . 'from — the repo current branch — else "base" ]',
                0
            ],
            [ 'remote', 'remote name (default: hub)', 0 ],
        ],
        ## no 'command' : routed by name to tool_claude_cloud_result, ##
        ## registered only — same pattern as kimi_check_status        ##
    },
    {   'name'        => 'coding_summarize',
        'description' =>
            'summarize text or a file using the local coding zenka (9B '
