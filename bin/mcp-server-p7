##[ global state ]##

my $cube_sock;               ## persistent connection to cube
my $json = JSON->new->utf8->canonical;
my $model_context_tokens;    ## cached from coding.context-size on first use
my $pending_summary_focus
    ;    ## one-shot focus for next auto_summarize; clears on use
my $mcp_client_name;    ## captured from initialize clientInfo.name

## walk up to 8 process ancestors via /proc, return their cmdlines joined
## with ' | ' -- cooperation-independent: works even when the spawning CLI
## sets no identifying env var and the MCP client library reports a
## generic clientInfo.name. confirmed live: kimi-legacy sets neither
## AI_AGENT nor a "kimi"-containing clientInfo.name (reports literal "mcp"),
## but its own process / an ancestor's cmdline does say "kimi".
sub _ancestor_cmdlines {
    my @lines;
    my $pid = $$;
    for ( 1 .. 8 ) {
        my $ppid;
        if ( open my $fh, '<', "/proc/$pid/status" ) {
            local $/ = undef;
            my $content = <$fh>;
            close $fh;
            ($ppid) = $content =~ /^PPid:\s*(\d+)/m;
        }
        last unless defined $ppid and $ppid > 1;
        $pid = $ppid;
        if ( open my $fh, '<', "/proc/$pid/cmdline" ) {
            local $/ = undef;
            my $cmdline = <$fh> // '';
            close $fh;
            $cmdline =~ s/\0/ /g;
            push @lines, $cmdline if length $cmdline;
        }
    }
    return join( ' | ', @lines );
}

## resolve which agent is calling us, for agent='auto' params. three
## signals, most to least reliable:
## 1. AI_AGENT (env) -- set by some CLIs (confirmed for claude-code), not
##    all (confirmed absent for kimi-legacy).
## 2. process ancestry (/proc cmdlines) -- cooperation-independent, works
##    regardless of what the spawning CLI does or doesn't set.
## 3. clientInfo.name from the MCP initialize handshake -- least reliable,
##    confirmed to be a generic "mcp" literal for kimi-legacy, not "kimi".
sub resolve_agent_auto {
    my ($default) = @ARG;
    $default //= 'claude';

    my $env_agent = lc( $ENV{'AI_AGENT'} // '' );
    return 'kimi'   if $env_agent =~ m{kimi};
    return 'claude' if $env_agent =~ m{claude};

    my $ancestry = lc( _ancestor_cmdlines() );
    return 'kimi'   if $ancestry =~ m{kimi};
    return 'claude' if $ancestry =~ m{claude};

    my $caller = lc( $mcp_client_name // '' );
    return 'kimi'   if $caller =~ m{kimi};
    return 'claude' if $caller =~ m{claude};

    return $default;
}
my $FOCUS_FILE = "$ROOT_PATH/data/state/mcp-summary-focus.txt";
my $summary_focus_sticky
    = 0;    ## 1 if loaded from disk (sticky across sessions)

my $last_chat_mtime = 0;
my $last_hint_time  = 0;
my $last_tool_name  = '';

sub load_sticky_focus {
    return unless -f $FOCUS_FILE and -s $FOCUS_FILE;
    if ( open( my $fh, '<:encoding(UTF-8)', $FOCUS_FILE ) ) {
        local $/;
        my $content = <$fh>;
        close $fh;
        if ( defined $content ) {
            $content =~ s{^\s+|\s+$}{}g;
            if ( length $content ) {
                $pending_summary_focus = $content;
                $summary_focus_sticky  = 1;
            }
        }
    } else {
        warn "cannot read focus file: $OS_ERROR";
    }
}

