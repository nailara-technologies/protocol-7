sub tool_p7_command {
    my ( $id, $args ) = @ARG;

    my $command = $args->{'command'} // '';
    if ( not length $command ) {
        return send_tool_result( $id, 'command is required', 1 );
    }

    my ( $ok, $response ) = cube_command($command);
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

sub tool_task_create {
    my ( $id, $args ) = @ARG;

    my $desc    = $args->{'description'} // '';
    my $context = $args->{'context'}     // '';

    if ( not length $desc ) {
        return send_tool_result( $id, 'description is required', 1 );
    }

    my ( $ok, $response );
    if ( $desc =~ m|\n| or length($desc) > 200 ) {
        ( $ok, $response )
            = cube_command_multiline( 'task.create', {}, $desc );
    } else {
        ( $ok, $response ) = cube_command("task.create $desc");
    }
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

sub tool_task_show {
    my ( $id, $args ) = @ARG;

    my $task_id = $args->{'task_id'} // '';
    if ( not length $task_id ) {
        return send_tool_result( $id, 'task_id is required', 1 );
    }

    my ( $ok, $response ) = cube_command("task.show $task_id");
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

sub tool_task_queue {
    my ( $id, $args ) = @ARG;

    my $status = $args->{'status'} // '';
    my $cmd    = 'task.queue';
    $cmd .= " status=$status" if length $status;

    my ( $ok, $response ) = cube_command($cmd);
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

sub tool_task_complete {
    my ( $id, $args ) = @ARG;

    my $task_id = $args->{'task_id'} // '';
    my $result  = $args->{'result'}  // '';

    if ( not length $task_id or not length $result ) {
        return send_tool_result( $id, 'task_id and result are required', 1 );
    }

    my ( $ok, $response );
    if ( $result =~ m|\n| or length($result) > 200 ) {
        ( $ok, $response )
            = cube_command_multiline( 'task.complete', { 'id' => $task_id },
            $result );
    } else {
        ( $ok, $response ) = cube_command("task.complete $task_id $result");
    }
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

sub tool_task_continue {
    my ( $id, $args ) = @ARG;

    my $task_id = $args->{'task_id'} // '';
    my $message = $args->{'message'} // '';

    if ( not length $task_id or not length $message ) {
        return send_tool_result( $id, 'task_id and message are required', 1 );
    }

    my ( $ok, $response );
    if ( $message =~ m|\n| or length($message) > 200 ) {
        ( $ok, $response )
            = cube_command_multiline( 'task.continue', { 'id' => $task_id },
            $message );
    } else {
        ( $ok, $response ) = cube_command("task.continue $task_id $message");
    }
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

sub tool_task_stop {
    my ( $id, $args ) = @ARG;

    my $task_id = $args->{'task_id'} // '';
    my $mode    = $args->{'mode'}    // 'abort';

    if ( $mode ne 'abort' and $mode ne 'stop' ) {
        return send_tool_result( $id, 'mode must be "abort" or "stop"', 1 );
    }

    my $cmd = $mode eq 'stop' ? 'coding.stop-task' : 'coding.abort-inference';
    $cmd .= " $task_id" if length $task_id;

    my ( $ok, $response ) = cube_command($cmd);
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

sub tool_task_restart_round {
    my ( $id, $args ) = @ARG;

    my $task_id = $args->{'task_id'} // '';

    my $cmd = 'coding.restart-round';
    $cmd .= " $task_id" if length $task_id;

    my ( $ok, $response ) = cube_command($cmd);
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

## =========================================================================
## cube socket communication [ unbuffered sysread/syswrite throughout ]
## =========================================================================

## read a single line from socket via sysread [ byte-by-byte, no buffering ]
sub sock_readline {
    my $sock = shift;
    my $line = '';
    my $byte;
    while (1) {
        my $n = sysread( $sock, $byte, 1 );
        return undef if not defined $n or $n == 0;
        $line .= $byte;
        last if $byte eq "\n";
    }
    chomp $line;
    return $line;
}

## write string to socket via syswrite
sub sock_write {
    my ( $sock, $data ) = @ARG;
    ## syswrite operates on bytes — length() returns characters with -C31 ##
    utf8::encode($data) if utf8::is_utf8($data);
    my $offset = 0;
    my $len    = length $data;
    while ( $offset < $len ) {
        my $n = syswrite( $sock, $data, $len - $offset, $offset );
        return undef if not defined $n;
        $offset += $n;
    }
    return $offset;
}

## read exactly N bytes from socket via sysread
sub sock_read_bytes {
    my ( $sock, $count ) = @ARG;
    my $data      = '';
    my $remaining = $count;
    while ( $remaining > 0 ) {
        my $chunk;
        my $n = sysread( $sock, $chunk, $remaining );
        return undef if not defined $n or $n == 0;
        $data .= $chunk;
        $remaining -= $n;
    }
    return $data;
}

## idle-bounded variants for the STRM drain loop                        ##
## [ select-based, no signals ] : can_read gates every sysread, so a    ##
## quiet-but-open stream trips the safety valve instead of blocking the ##
## whole mcp server.  returns ( $data, undef ) on success, ( undef,     ##
## 'timeout'|'eof' ) else                                               ##

sub sock_readline_timed {
    my ( $sock, $idle_timeout ) = @ARG;
    my $sel  = IO::Select->new($sock);
    my $line = '';
    my $byte;
    while (1) {
        return ( undef, 'timeout' ) if not $sel->can_read($idle_timeout);
        my $n = sysread( $sock, $byte, 1 );
        return ( undef, 'eof' ) if not defined $n or $n == 0;
        $line .= $byte;
        last if $byte eq "\n";
    }
    chomp $line;
    return ( $line, undef );
}

sub sock_read_bytes_timed {
    my ( $sock, $count, $idle_timeout ) = @ARG;
    my $sel  = IO::Select->new($sock);
    my $data = '';
    while ( length($data) < $count ) {
        return ( undef, 'timeout' ) if not $sel->can_read($idle_timeout);
        my $chunk;
        my $n = sysread( $sock, $chunk, $count - length($data) );
        return ( undef, 'eof' ) if not defined $n or $n == 0;
        $data .= $chunk;
    }
    return ( $data, undef );
}

sub cube_connect {
    if ( defined $cube_sock ) {
        ## verify socket is still alive [ connected() is unreliable for
        ## half-closed sockets — probe with zero-length non-blocking read ]
        my $probe;
        $cube_sock->blocking(0);
        my $n = sysread( $cube_sock, $probe, 1 );
        $cube_sock->blocking(1);
        if ( defined $n and $n == 0 ) {
            ## EOF — remote closed
            log_msg('cube socket EOF detected — reconnecting');
            cube_disconnect();
        } elsif ( $cube_sock->connected ) {
            return $cube_sock;
        } else {
            log_msg('cube socket no longer connected — reconnecting');
            cube_disconnect();
        }
    }

    log_msg( 'connecting to cube [ %s ]', $socket_path );

    $cube_sock = IO::Socket::UNIX->new(
        Type => SOCK_STREAM(),
        Peer => $socket_path,
    );

    if ( not defined $cube_sock ) {
        log_msg( 'connection failed: %s', $OS_ERROR );
        return undef;
    }

    ## read banner
    my $banner = sock_readline($cube_sock);
    if ( not defined $banner
        or $banner !~ m{^\\\\PROTOCOL-7-VERSION\\\\} ) {
        log_msg( 'protocol mismatch: %s', $banner // 'no banner' );
        close($cube_sock);
        $cube_sock = undef;
        return undef;
    }

    ## authenticate via unix method
    sock_write( $cube_sock, "select unix\n" );
    my $sel_reply = sock_readline($cube_sock);
    if ( not defined $sel_reply or $sel_reply !~ m{^TRUE} ) {
        log_msg( 'unix auth not available: %s', $sel_reply // 'no reply' );
        close($cube_sock);
        $cube_sock = undef;
        return undef;
    }

    sock_write( $cube_sock, "auth $auth_user\n" );
    my $auth_reply = sock_readline($cube_sock);
    if ( not defined $auth_reply or $auth_reply !~ m{^AUTH_TRUE} ) {
        log_msg( 'authentication failed: %s', $auth_reply // 'no reply' );
        close($cube_sock);
        $cube_sock = undef;
        return undef;
    }

    ## close-on-exec: subprocesses must not inherit the cube socket ##
    ## inherited fds closed by child processes desync the protocol  ##
    my $fd    = fileno($cube_sock);
    my $flags = fcntl( $cube_sock, F_GETFD, 0 ) // 0;
    fcntl( $cube_sock, F_SETFD, $flags | FD_CLOEXEC );

    log_msg('connected and authenticated');
    return $cube_sock;
}

## send a multiline command [ command+\n headers\n\n body\n.\n ] headers:
## hashref of key=>value, body: string (may contain newlines)
sub cube_command_multiline {
    my ( $command, $headers, $body ) = @ARG;
    $headers //= {};
    $body    //= '';

    my $sock = cube_connect();
    if ( not defined $sock ) {
        return ( 0, 'not connected to protocol-7 network' );
    }

    ## build header block ##
    my $header_block = '';
    if ( keys %{$headers} ) {
        my $max_w = max( map {length} keys %{$headers} );
        for my $key ( sort keys %{$headers} ) {
            $header_block .= sprintf " %*s : %s\n", $max_w, $key,
                $headers->{$key};
        }
    }

    ## ensure body is newline-terminated ##
    $body .= "\n" if length($body) and $body !~ m|\n\z|;

    ## downgrade to bytes for syswrite — json decode leaves utf8 flag on ##
    utf8::encode($body)         if utf8::is_utf8($body);
    utf8::encode($header_block) if utf8::is_utf8($header_block);

    my $packet = sprintf "%s+\n%s\n%s.\n", $command, $header_block, $body;

    log_msg( 'sending multiline: %s (%d bytes)', $command, length($packet) );

    my $written = sock_write( $sock, $packet );
    if ( not defined $written ) {
        log_msg('write failed — connection stale');
        cube_disconnect();
        return ( 0, 'connection lost during write' );
    }

    ## read response — same as cube_command ##
    my $first_line = sock_readline($sock);
    if ( not defined $first_line ) {
        log_msg('connection lost during read');
        cube_disconnect();
        return ( 0, 'connection lost' );
    }

    my ( $reply_type, $reply_data ) = split( m|\s+|, $first_line, 2 );
    $reply_type //= '';
    $reply_data //= '';

    log_msg( 'reply type: %s', $reply_type );

    return ( 1, $reply_data ) if $reply_type eq 'TRUE';
    return ( 0, $reply_data ) if $reply_type eq 'FALSE';
    return ( 0, "command not acknowledged: $reply_data" )
        if $reply_type eq 'NACK';

    if ( $reply_type eq 'SIZE' ) {
        my $byte_count = $reply_data + 0;
        my $data       = sock_read_bytes( $sock, $byte_count );
        if ( not defined $data ) {
            log_msg('connection lost during SIZE read');
            cube_disconnect();
            return ( 0, 'connection lost during read' );
        }
        $data =~ s{\n\z}{};
        return ( 1, $data );
    }

    ## STRM / STRM-SIZE stream reply -- drain all frames                    ##
    ## [ prefix- tolerant : '(5)STRM open' and '(5) STRM open' both match ] ##
    if ( $first_line =~ m{^(?:\( \d+ \)\s*)?STRM(?:-SIZE)?\s+open\b}x ) {
        return drain_strm_stream( $sock, $first_line );
    }

    ## unknown reply type -- disconnect before returning raw : any type    ##
    ## with trailing frames [ CHRSIZE, future types ] would leave bytes in ##
    ## this cached socket and corrupt the next unrelated call              ##
    cube_disconnect();
    return ( 1, $first_line );
}

sub cube_disconnect {
    if ( defined $cube_sock ) {
        sock_write( $cube_sock, "close\n" ) if $cube_sock->connected;
        close($cube_sock);
        $cube_sock = undef;
    }
}

##[ strm safety valve bounds ]##
##
## idle-primary, bytes-secondary [ task: mcp-server-p7-strm-support ] : an  ##
## idle bound distinguishes [ still producing ] from                        ##
## [ parked open indefinitely ] without truncating legitimately slow        ##
## bounded streams ; the byte cap stops a fast runaway producer from        ##
## ballooning one tool result without limit. both env-overridable for       ##
## callers expecting a long quiet stretch. initialized in the configuration ##
## section above the main loop                                              ##
## [ file-scope assignments after it never execute ]                        ##

## drain an STRM / STRM-SIZE reply stream                                   ##
## [ frames : open / push / close per src/base.stream.* ]. hard invariant : ##
## every exit either reaches a clean close with the socket left byte-clean, ##
## or tears the socket down via cube_disconnect -- never a partial-return   ##
## with frames left in the cached socket's receive buffer. never retries :  ##
## server-side effects of the command already happened once the first reply ##
## line arrived                                                             ##
sub drain_strm_stream {
    my ( $sock, $first_line, $opt ) = @ARG;
    $opt //= {};
    my $idle_timeout = $opt->{'idle_timeout'} // $strm_idle_timeout;
    my $max_bytes    = $opt->{'max_bytes'}    // $strm_max_bytes;

    ## parse the already-read open frame [ strip (N) cmd-id prefix first, ##
    ## both spacings : '(5)STRM open' and '(5) STRM open' ]               ##
    ( my $open_line = $first_line ) =~ s{^\( \d+ \)\s*}{}x;
    my ($total) = $open_line =~ m{^STRM(?:-SIZE)?\s+open\s+(\d+)\s*$};
    ## bare 'open' carries no total : unbounded stream, close frame is its ##
    ## only terminator [ declared totals are always > 0, so defined vs     ##
    ## undef is a clean two-way test ]                                     ##

    log_msg( 'STRM stream open [ %s ] -- draining',
        defined $total ? "bounded, $total bytes" : 'unbounded' );

    my $payload        = '';
    my $received_bytes = 0;
    my $last_frame_at  = Time::HiRes::time();

    while (1) {
        my ( $header, $hdr_err )
            = sock_readline_timed( $sock, $idle_timeout );

        if ( not defined $header ) {
            cube_disconnect();    ## invariant : no partial-return
            if ( $hdr_err eq 'timeout' ) {
                my $idle_secs = Time::HiRes::time() - $last_frame_at;
                log_msg( 'STRM valve trip : %.0f s idle, %d bytes collected',
                    $idle_secs, $received_bytes );
                return (
                    1,
                    $payload
                        . sprintf(
                        "\n[stream still open, %d bytes collected, "
                            . '%.0f seconds idle]',
                        $received_bytes, $idle_secs
                        )
                );
            }
            log_msg('connection lost during STRM header read');
            return ( 0, 'connection lost during STRM read' );
        }

        $last_frame_at = Time::HiRes::time();
        $header =~ s{^\( \d+ \)\s*}{}x;    ## (N) prefix, both spacings

        ## close frame : the only exit that keeps the socket cached ##
        if ( $header =~ m{^STRM(?:-SIZE)?\s+close\s*$} ) {
            if ( defined $total and $received_bytes != $total ) {
                ## bounded-total mismatch is a real failure    ##
                ## [ p7c.c mirrors this check ] ; socket state ##
                ## indeterminate                               ##
                log_msg( 'STRM total mismatch : %d of %d bytes received',
                    $received_bytes, $total );
                cube_disconnect();
                return (
                    0,
                    sprintf(
                        'incomplete STRM stream : %d of %d bytes received',
                        $received_bytes, $total
                    )
                );
            }
            log_msg( 'STRM stream closed : %d bytes', $received_bytes );
            return ( 1, $payload );    ## clean exit, socket stays cached
        }

        ## abnormal termination from a gated upstream relay ##
        if ( $header =~ m{^!TRM!} ) {
            log_msg( 'STRM !TRM! after %d bytes', $received_bytes );
            cube_disconnect();
            return (
                1,
                $payload
                    . sprintf(
                    "\n[stream terminated abnormally by !TRM!, "
                        . '%d bytes collected]',
                    $received_bytes
                    )
            );
        }

        ## push frame : exact chunk_len header, then exactly that many    ##
        ## payload bytes [ framing is never guesswork, unbounded or not ] ##
        if ( my ($chunk_len) = $header =~ m{^STRM(?:-SIZE)?\s+(\d+)\s*$} ) {
            my ( $chunk, $chk_err ) = ( '', undef );
            if ( $chunk_len > 0 ) {
                ( $chunk, $chk_err )
                    = sock_read_bytes_timed( $sock, $chunk_len,
                    $idle_timeout );
            }
            if ( not defined $chunk ) {
                cube_disconnect();    ## invariant : no partial-return
                if ( $chk_err eq 'timeout' ) {
                    my $idle_secs = Time::HiRes::time() - $last_frame_at;
                    log_msg(
                        'STRM valve trip mid-frame : '
                            . '%.0f s idle, %d bytes collected',
                        $idle_secs, $received_bytes
                    );
                    return (
                        1,
                        $payload
                            . sprintf(
                            "\n[stream still open, %d bytes collected, "
                                . '%.0f seconds idle]',
                            $received_bytes, $idle_secs
                            )
                    );
                }
                log_msg('connection lost during STRM payload read');
                return ( 0, 'connection lost during STRM payload read' );
            }
            $payload .= $chunk;
            $received_bytes += $chunk_len;
            $last_frame_at = Time::HiRes::time();

            ## secondary bound : byte cap against runaway producers ##
            if ( $received_bytes > $max_bytes ) {
                log_msg(
                    'STRM valve trip : byte cap %d exceeded [ %d bytes ]',
                    $max_bytes, $received_bytes );
                cube_disconnect();
                return (
                    1,
                    $payload
                        . sprintf(
                        "\n[stream still open, %d bytes collected, "
                            . 'byte cap %d reached]',
                        $received_bytes, $max_bytes
                        )
                );
            }
            next;
        }

        ## unrecognised frame header : position in the byte stream is ##
        ## unknown, so the socket cannot stay cached                  ##
        log_msg( 'unrecognised STRM frame : %s', $header );
        cube_disconnect();
        return ( 0, "unrecognised STRM frame: $header" );
    }
}

sub cube_command {
    my $command = shift;
    my $retry   = shift // 1;    ## allow one reconnect attempt

    my $sock = cube_connect();
    if ( not defined $sock ) {
        return ( 0, 'not connected to protocol-7 network' );
    }

    my $log_cmd = $command;
    $log_cmd =~ s|(:B32:)([A-Z2-7]{20})[A-Z2-7]*|$1$2...|s;
    log_msg( 'sending: %s', $log_cmd );

    ## send command
    my $written = sock_write( $sock, "$command\n" );
    if ( not defined $written ) {
        log_msg('write failed — connection stale');
        cube_disconnect();
        return cube_command( $command, 0 ) if $retry;
        return ( 0, 'connection lost during write' );
    }

    ## read first response line [ unbuffered ]
    my $first_line = sock_readline($sock);
    if ( not defined $first_line ) {
        log_msg('connection lost during read');
        cube_disconnect();
        return cube_command( $command, 0 ) if $retry;
        return ( 0, 'connection lost' );
    }

    ## parse reply type
    my ( $reply_type, $reply_data ) = split( m|\s+|, $first_line, 2 );
    $reply_type //= '';
    $reply_data //= '';

    log_msg( 'reply type: %s', $reply_type );

    if ( $reply_type eq 'TRUE' ) {
        return ( 1, $reply_data );
    }

    if ( $reply_type eq 'FALSE' ) {
        return ( 0, $reply_data );
    }

    if ( $reply_type eq 'SIZE' ) {
        ## SIZE <byte_count> — next N bytes are payload
        my $byte_count = $reply_data + 0;
        my $data       = sock_read_bytes( $sock, $byte_count );

        if ( not defined $data ) {
            log_msg('connection lost during SIZE read');
            cube_disconnect();
            return ( 0, 'connection lost during read' );
        }

        ## trim trailing newline from sized payload
        $data =~ s{\n\z}{};

        return ( 1, $data );
    }

    if ( $reply_type eq 'NACK' ) {
        return ( 0, "command not acknowledged: $reply_data" );
    }

    ## STRM / STRM-SIZE stream reply -- drain all frames                    ##
    ## [ prefix- tolerant : '(5)STRM open' and '(5) STRM open' both match ] ##
    if ( $first_line =~ m{^(?:\( \d+ \)\s*)?STRM(?:-SIZE)?\s+open\b}x ) {
        return drain_strm_stream( $sock, $first_line );
    }

    ## unknown reply type — disconnect before returning raw : unread     ##
    ## trailing frames would corrupt the next call on this cached socket ##
    cube_disconnect();
    return ( 1, $first_line );
}

## =========================================================================
## json-rpc helpers
## =========================================================================

sub send_result {
    my ( $id, $result ) = @ARG;

    my $msg = $json->encode(
        {   'jsonrpc' => '2.0',
            'id'      => $id,
            'result'  => $result
        }
    );
    print STDOUT "$msg\n";
}

sub send_error {
    my ( $id, $code, $message ) = @ARG;

    my $msg = $json->encode(
        {   'jsonrpc' => '2.0',
            'id'      => $id,
            'error'   => { 'code' => $code, 'message' => $message }
        }
    );
    print STDOUT "$msg\n";
}

sub send_tool_result {
    my ( $id, $text, $is_error, $extra ) = @ARG;

    ## cube returns raw utf-8 bytes — decode to perl chars before json ##
    ## encoding                                                        ##
    utf8::decode($text) if defined $text and not utf8::is_utf8($text);

    my $result = {
        'content' => [ { 'type' => 'text', 'text' => $text } ],
        'isError' => $is_error ? \1 : \0
    };
    ## optional structured fields merged alongside content/isError ##
    @{$result}{ keys %{$extra} } = values %{$extra}
        if ref $extra eq 'HASH';

    send_result( $id, $result );
}

## =========================================================================
## kimi-web tool implementations
## =========================================================================

sub tool_agent_spawn {
    my ( $id, $args ) = @ARG;

    my $template = $args->{'template'} // '';
    my $work_dir = $args->{'work_dir'} // '';
    my $priority = $args->{'priority'} // 5;

    my $cmd = 'kimi-web.spawn_agent';
    $cmd .= " template=$template" if length $template;
    $cmd .= " work_dir=$work_dir" if length $work_dir;
    $cmd .= " priority=$priority";

    my ( $ok, $response ) = cube_command($cmd);
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

sub tool_agent_list {
    my ( $id, $args ) = @ARG;

    my $status = $args->{'status'} // '';
    my $cmd    = 'kimi-web.list_agents';
    $cmd .= " status=$status" if length $status;

    my ( $ok, $response ) = cube_command($cmd);
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

sub tool_agent_dispatch {
    my ( $id, $args ) = @ARG;

    my $agent_id = $args->{'agent_id'} // '';
    my $prompt   = $args->{'prompt'}   // '';
    my $timeout  = $args->{'timeout'}  // 300;

    if ( not length $agent_id ) {
        return send_tool_result( $id, 'agent_id is required', 1 );
    }
    if ( not length $prompt ) {
        return send_tool_result( $id, 'prompt is required', 1 );
    }

    ## collapse newlines for single-line IPC ##
    ( my $safe_prompt = $prompt ) =~ s{\n}{ }g;

    my $cmd
        = "kimi-web.dispatch agent_id=$agent_id "
        . "prompt=\"$safe_prompt\" timeout=$timeout";

    my ( $ok, $response ) = cube_command($cmd);
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

sub tool_template_resolve {
    my ( $id, $args ) = @ARG;

    my $template = $args->{'template'} // '';
    my $budget   = $args->{'budget'}   // 8000;

    if ( not length $template ) {
        return send_tool_result( $id, 'template is required', 1 );
    }

    my $cmd = "kimi-web.resolve_template template=$template budget=$budget";

    my ( $ok, $response ) = cube_command($cmd);
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

sub tool_zenka_start {
    my ( $id, $args ) = @ARG;

    my $zenka_name = $args->{'zenka_name'} // '';

    if ( not length $zenka_name ) {
        return send_tool_result( $id, 'zenka_name is required', 1 );
    }

    my ( $ok, $response ) = cube_command("v7-zenki.start $zenka_name");
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

sub tool_list_tools {
    my ( $id, $args ) = @ARG;

    my $filter = $args->{'filter'} // '';
    my $cmd    = 'coding.list-tools';
    $cmd .= " $filter" if length $filter;

    my ( $ok, $response ) = cube_command($cmd);
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

sub tool_call_tool {
    my ( $id, $args ) = @ARG;

    my $tool_name = $args->{'tool_name'} // '';
    my $tool_args = $args->{'arguments'} // {};

    if ( not length $tool_name ) {
        return send_tool_result( $id, 'tool_name is required', 1 );
    }

    ## encode arguments as JSON if provided ##
    my $args_json = '{}';
    if ( ref $tool_args eq 'HASH' and keys %$tool_args ) {
        $args_json = encode_json($tool_args);
    }

    my $cmd = "coding.call-tool $tool_name $args_json";
    my ( $ok, $response ) = cube_command($cmd);
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

## =========================================================================
## coding summarize tool
## =========================================================================

sub tool_coding_summarize {
    my ( $id, $args ) = @ARG;

    my $text        = $args->{'text'}      // '';
    my $file        = $args->{'file'}      // '';
    my $task_file   = $args->{'task_file'} // '';
    my $instruction = $args->{'instruction'}
        // 'summarize the following text concisely';
    my $max_tokens = $args->{'max_tokens'} // 500;

    my $auto_followup = $args->{'auto_followup'} // '';
    $auto_followup
        = length($auto_followup)
        && lc($auto_followup) ne 'false'
        && $auto_followup ne '0' ? 1 : 0;

    return send_tool_result( $id, 'text or file is required', 1 )
        if not length $text and not length $file;

    ## checklist mode: build the verification instruction from the task ##
    ## file's '## acceptance criteria' / '## verification' section      ##
    my $checklist = 0;
    if ( length $task_file ) {
        my $criteria = _task_criteria_from_file($task_file);
        return send_tool_result(
            $id,
            "no '## acceptance criteria' or '## "
                . "verification' section found in $task_file",
            1
        ) if not length $criteria;
        $instruction = _checklist_instruction($criteria);
        $checklist   = 1;
    } elsif ( $instruction =~ m{DISPATCH_NEEDED|acceptance criteria}i ) {
        $checklist = 1;
    }
    $checklist = 1 if $auto_followup;    ## opt-in implies checklist mode

    my $result = '';
    my $error  = '';
    eval {
        local $SIG{ALRM} = sub { die "timeout\n" };
        alarm(590);
        if ( length $file ) {
            $result = _do_summarize_file( $file, $instruction, $max_tokens );
        } else {
            $result = _do_summarize( $text, $instruction, $max_tokens );
        }
        alarm(0);
    };
    if ($@) {
        cube_disconnect();    ## socket may be mid-write — force fresh connect
        $error
            = $@ eq "timeout\n"
            ? 'summarization timed out after '
            . '590s — model may still be loading'
            : "error: $@";
    }

    return send_tool_result( $id, $error, 1 ) if length $error;

    $result //= 'summarization failed — coding zenka may not be running';

    ## checklist routing: surface the DISPATCH_NEEDED marker as a flag ##
    return send_tool_result( $id, $result, 0 )
        if not $checklist or $result !~ m{DISPATCH_NEEDED:};

    my $followup_note = '';
    if ($auto_followup) {
        my ($failures) = $result =~ m{DISPATCH_NEEDED:\s*(.+)}s;
        $failures = $result if not length( $failures // '' );
        $failures =~ s{^\s+|\s+$}{}g;
        my $prompt
            = 'a dispatched task failed verification against its '
            . "acceptance criteria. fix these items:\n\n$failures";
        $prompt = "task file: $task_file\n\n$prompt" if length $task_file;
        $followup_note
            = _dispatch_followup($prompt)
            ? ' [ auto-followup dispatched ]'
            : ' [ auto-followup dispatch FAILED ]';
    }

    $result .= "\n\nneeds_followup: true$followup_note";
    send_tool_result( $id, $result, 0, { 'needs_followup' => \1 } );
}

## extract the '## acceptance criteria' / '## verification' section body from
## a task file [ bullets up to the next header or signature block ]
sub _task_criteria_from_file {
    my ($path) = @ARG;

    return '' if not -f $path;
    open( my $fh, '<:encoding(UTF-8)', $path ) or return '';
    my $section   = '';
    my $in_target = 0;
    while ( my $line = <$fh> ) {
        if ( $line =~ m{^##\s+(acceptance criteria|verification)\s*$}i ) {
            $in_target = 1;
            next;
        }
        last              if $in_target and $line =~ m{^#};
        $section .= $line if $in_target;
    }
    close $fh;
    $section =~ s{^\s+|\s+$}{}g;
    return $section;
}

sub _checklist_instruction {
    my ($criteria) = @ARG;
    return
          'check the following acceptance criteria against the output. '
        . "for each criterion, output PASS or FAIL with a brief reason:"
        . "\n\n$criteria\n\n"
        . 'if any FAIL: output DISPATCH_NEEDED: <what to fix>';
}

## background kimi-legacy follow-up dispatch — forks and detaches, never
## blocks the mcp loop
## [ child stdio redirected away from the protocol channel ]
sub _dispatch_followup {
    my ($prompt) = @ARG;

    my $model = 'kimi-code/kimi-for-coding'
        ;    ## same default as kimi_dispatch [ 2026-09-15 ]
    my $log_path = "$ROOT_PATH/data/state/auto-followup.log";

    local $SIG{'CHLD'} = 'IGNORE';    ## auto-reap the background child
    my $pid = fork();
    if ( not defined $pid ) {
        log_msg( '[followup] fork failed: %s', $OS_ERROR );
        return 0;
    }
    if ( $pid == 0 ) {
        eval { make_path("$ROOT_PATH/data/state") };
        open( STDIN,  '<',  '/dev/null' );
        open( STDOUT, '>>', $log_path );
        open( STDERR, '>>', $log_path );
        exec( 'kimi-legacy', '-y', '--afk', '-p', $prompt, '--model',
            $model );
        exit(1);    ## exec failed
    }
    log_msg( '[followup] background kimi-legacy dispatched [ pid=%d ]',
        $pid );
    return 1;
}

sub tool_store_summary_focus {
    my ( $id, $args ) = @ARG;
    my $instruction = $args->{'instruction'} // '';
    my $keep        = $args->{'keep'}        // 0;

    if ( length $instruction ) {
        $pending_summary_focus = $instruction;
        if ($keep) {
            $summary_focus_sticky = 1;
            eval {
                make_path("$ROOT_PATH/data/state")
                    unless -d "$ROOT_PATH/data/state";
                if ( open( my $fh, '>:encoding(UTF-8)', $FOCUS_FILE ) ) {
                    print $fh $instruction;
                    close $fh;
                } else {
                    warn "cannot write focus file: $OS_ERROR";
                }
            };
            warn "failed to persist focus: $@" if $@;
            send_tool_result( $id,
                "summary focus stored (sticky — persists to next session)",
                0 );
        } else {
            $summary_focus_sticky = 0;
            unlink $FOCUS_FILE if -f $FOCUS_FILE;
            send_tool_result(
                $id,
                "summary focus stored — will apply "
                    . "to next dispatch auto_summarize",
                0
            );
        }
    } else {
        $pending_summary_focus = undef;
        $summary_focus_sticky  = 0;
        unlink $FOCUS_FILE if -f $FOCUS_FILE;
        send_tool_result( $id, "summary focus cleared", 0 );
    }
}

## =========================================================================
## memory summary tool
## =========================================================================

sub tool_p7_memory_summary {
    my ( $id, $args ) = @ARG;

    my $agent      = $args->{'agent'}      // 'auto';
    my $focus      = $args->{'focus'}      // '';
    my $max_tokens = $args->{'max_tokens'} // 600;

    ## resolve auto → caller's own memory
    $agent = resolve_agent_auto('both') if $agent eq 'auto';

    my $default_focus
        = 'optimize handover context between sessions: identify critical '
        . 'unfinished work, recent architectural decisions, and what '
        . 'the next session absolutely needs to know to be productive '
        . 'immediately.';
    my $instruction = length($focus) ? $focus : $default_focus;

    my $claude_mem = "$ROOT_PATH/data/ai-mem/claude/MEMORY.md";
    my $kimi_mem   = "$ROOT_PATH/data/ai-mem/kimi/MEMORY.md";

    my @parts;
    my $error = '';

    eval {
        local $SIG{ALRM} = sub { die "timeout\n" };
        alarm(590);

        if ( $agent eq 'claude' or $agent eq 'both' ) {
            if ( -f $claude_mem ) {
                my $s = _do_summarize_file( $claude_mem, $instruction,
                    $max_tokens );
                push @parts, ":. claude memory .:\n\n"
                    . ( $s // 'summarization failed' );
            } else {
                push @parts, ":. claude memory .:\n\n[file not found]";
            }
        }

        if ( $agent eq 'kimi' or $agent eq 'both' ) {
            if ( -f $kimi_mem ) {
                my $s = _do_summarize_file( $kimi_mem, $instruction,
                    $max_tokens );
                push @parts, ":. kimi memory .:\n\n"
                    . ( $s // 'summarization failed' );
            } else {
                push @parts, ":. kimi memory .:\n\n[file not found]";
            }
        }

        alarm(0);
    };
    if ($@) {
        cube_disconnect();
        $error
            = $@ eq "timeout\n"
            ? 'summarization timed out after 590s'
            : "error: $@";
    }

    if ( length $error ) {
        send_tool_result( $id, $error, 1 );
    } else {
        send_tool_result( $id, join( "\n\n", @parts ), 0 );
    }
}

## =========================================================================
## memory update tool
## =========================================================================

sub tool_p7_memory_update {
    my ( $id, $args ) = @ARG;

    my $agent       = $args->{'agent'}       // 'auto';
    my $sessions_n  = $args->{'sessions'}    // 1;
    my $git_changes = $args->{'git_changes'} // 1;
    my $mode        = $args->{'mode'}        // 'review';
    my $content     = $args->{'content'}     // '';
    my $focus       = $args->{'focus'}       // '';

    ## resolve auto → caller's own memory
    $agent = resolve_agent_auto('claude') if $agent eq 'auto';

    my $mem_dir
        = $agent eq 'claude'
        ? "$ROOT_PATH/data/ai-mem/claude"
        : "$ROOT_PATH/data/ai-mem/kimi";
    my $mem_path = "$mem_dir/MEMORY.md";

    ## apply mode: delegate append to coding zenka, return response for ##
    ## review                                                           ##
    if ( $mode eq 'apply' ) {
        if ( not length $content ) {
            return send_tool_result( $id,
                'content is required for apply mode', 1 );
        }

        ## detect "UPDATE FILE: <filename>" directive and route there ##
        my $update_target = '';
        if ( $content =~ s{^\s*UPDATE\s+FILE:\s*(\S+)\s*\n?}{}i ) {
            $update_target = $1;
            ## strip common boilerplate that follows the directive ##
            $content
                =~ s{^\s*Replace the entire file content with the following[^\n]*\n}{}i;
            $content
                =~ s{^\s*\(preserve existing signature block[^\n]*\n?}{}i;
            $content =~ s{^\s*\n+}{}s;
        }

        my $dest_file;
        if ( length $update_target ) {
            $dest_file = $update_target;
        } elsif ( length $args->{'target'} ) {
            $dest_file = $args->{'target'};
        } else {
            $dest_file = 'MEMORY.md';
        }

        ## keep destination inside the agent memory directory ##
        if ( $dest_file =~ m|\.\./| ) {
            return send_tool_result( $id,
                "refused: target path escapes memory directory", 1 );
        }
        my $dest_path
            = $dest_file =~ m{^/}
            ? $dest_file
            : "$mem_dir/$dest_file";

        ## length guard for the main MEMORY.md index ##
        my $is_main_memory
            = ( $dest_file eq 'MEMORY.md' or $dest_path eq $mem_path );
        if ($is_main_memory) {
            if ( not -f $dest_path ) {
                return send_tool_result( $id,
                    "memory file not found: $dest_path", 1 );
            }
            my $current_lines = 0;
            if ( open my $fh, '<:encoding(UTF-8)', $dest_path ) {
                $current_lines++ while <$fh>;
                close $fh;
            }
            my $content_lines = ( $content =~ tr/\n// ) || 0;
            $content_lines++
                if length $content and substr( $content, -1 ) ne "\n";
            my ( $MEMORY_MAX_LINES, $MEMORY_WARN_LINES )
                = $agent eq 'claude'
                ? ( 200, 180 )
                : ( 400, 300 );
            if ( $current_lines + $content_lines > $MEMORY_MAX_LINES ) {
                return send_tool_result(
                    $id,
                    "refused: append would push MEMORY.md to "
                        . ( $current_lines + $content_lines )
                        . " lines (limit $MEMORY_MAX_LINES). externalize "
                        . "this update to a topic file via 'target' or "
                        . "start content with 'UPDATE FILE: "
                        . "topic-<name>.md'.",
                    1
                );
            }
            if ( $current_lines + $content_lines > $MEMORY_WARN_LINES ) {
                $content
                    = ":warning: MEMORY.md will be at "
                    . ( $current_lines + $content_lines )
                    . " lines (soft limit $MEMORY_WARN_LINES). "
                    . "consider externalizing future updates.\n\n"
                    . $content;
            }
        }

        my $rel_path = $dest_path;
        $rel_path =~ s{^\Q$ROOT_PATH/\E}{};

        my ( $ok, $response );
        if ( -f $dest_path ) {
            my $args_json = encode_json(
                {   'path'    => $rel_path,
                    'content' => $content
                }
            );
            my $cmd = "coding.call-tool write_append $args_json";
            ( $ok, $response ) = cube_command($cmd);
        } else {
            ## new topic file: create it with the full content ##
            my $args_json = encode_json(
                {   'path'    => $rel_path,
                    'content' => $content
                }
            );
            my $cmd = "coding.call-tool write_new_file $args_json";
            ( $ok, $response ) = cube_command($cmd);
        }

        if ($ok) {
            send_tool_result(
                $id,
                "wrote to $agent/$dest_file:\n\n$content\n\n[coding "
                    . "zenka response: $response]",
                0
            );
        } else {
            send_tool_result( $id, "write failed: $response", 1 );
        }
        return;
    }

    ## review mode: gather context for gap analysis ##
    my @parts;
    my $error = '';

    my $review_target
        = length $args->{'target'}
        ? $args->{'target'}
        : 'MEMORY.md';
    my $review_path
        = $review_target =~ m{^/}
        ? $review_target
        : "$mem_dir/$review_target";

    eval {
        local $SIG{ALRM} = sub { die "timeout\n" };
        ## ~9.8 minutes — memory review fetches git + summarizes file + ##
        ## sessions                                                     ##
        alarm(590);

        ## 1. recent git changes ##
        if ($git_changes) {
            my ( $ok, $git_out )
                = cube_command('coding.call-tool recent_changes');
            if ( $ok and length $git_out ) {
                push @parts, ":. recent git changes .:\n\n$git_out";
            } else {
                push @parts,
                    ":. recent git changes .:\n\n[no "
                    . "changes or unable to fetch]";
            }
        }

        ## 2. current memory summary ##
        if ( -f $review_path ) {
            my $mem_focus
                = length($focus)
                ? $focus
                : 'summarize what is currently '
                . 'documented in this development memory';
            my $s = _do_summarize_file( $review_path, $mem_focus, 600 );
            push @parts, ":. current $agent/$review_target .:\n\n"
                . ( $s // 'summarization failed' );
        } else {
            push @parts,
                ":. current $agent/$review_target "
                . ".:\n\n[file not found: $review_path]";
        }

        ## 3. recent session summaries ##
        if ( $sessions_n > 0 ) {
            my @session_summaries;
            my @session_list
                = $agent eq 'claude'
                ? _list_claude_sessions($sessions_n)
                : _list_kimi_sessions($sessions_n);

            for my $s ( @session_list[ 0 .. $sessions_n - 1 ] ) {
                last unless defined $s;
                my $text = _extract_session_text( $s->{'file'}, $agent );
                next unless length $text;
                my $sum = _do_summarize(
                    $text,
                    'summarize what was accomplished, '
                        . 'key decisions, and open issues',
                    400
                );
                my $header = sprintf ":. %s session %s .[ %s ]:.\n",
                    $agent, $s->{'uuid'},
                    POSIX::strftime( '%Y-%m-%d %H:%M',
                    localtime( $s->{'mtime'} ) );
                push @session_summaries,
                    $header . ( $sum // '[summarization failed]' );
            }

            if (@session_summaries) {
                push @parts, ":. recent $agent sessions .:\n\n"
                    . join( "\n\n", @session_summaries );
            } else {
                push @parts,
                    ":. recent $agent sessions .:\n\n[no sessions found]";
            }
        }

        alarm(0);
    };
    if ($@) {
        cube_disconnect();
        $error
            = $@ eq "timeout\n"
            ? 'review timed out after 300s'
            : "error: $@";
    }

    if ( length $error ) {
        send_tool_result( $id, $error, 1 );
    } else {
        send_tool_result( $id, join( "\n\n", @parts ), 0 );
    }
}

## =========================================================================
## detected-agent debug tool — reports what agent='auto' resolves to now
## =========================================================================

sub tool_p7_detected_agent {
    my ( $id, $args ) = @ARG;

    my $env_agent_raw = $ENV{'AI_AGENT'} // '';
    my $client_raw    = $mcp_client_name // '';
    my $ancestry_raw  = _ancestor_cmdlines();

    my $resolved_update  = resolve_agent_auto('claude');
    my $resolved_summary = resolve_agent_auto('both');

    my $out = sprintf(
        "resolved (p7_memory_update default) : %s\nresolved "
            . "(p7_memory_summary default) : %s\nAI_AGENT env : %s\nprocess "
            . "ancestry (/proc cmdlines) : %s\nclientInfo.name (MCP "
            . "handshake) : %s",
        $resolved_update,
        $resolved_summary,
        length($env_agent_raw) ? $env_agent_raw : '[unset]',
        length($ancestry_raw)  ? $ancestry_raw  : '[unavailable]',
        length($client_raw)    ? $client_raw    : '[unset]'
    );

    send_tool_result( $id, $out, 0 );
}

## =========================================================================
## memory search tool — scored tree, synchronous SIZE reply
## =========================================================================

sub tool_p7_memory_search {
    my ( $id, $args ) = @ARG;

    my $terms = $args->{'terms'} // '';
    if ( not length $terms ) {
        return send_tool_result( $id, 'terms is required', 1 );
    }

    my ( $ok, $response ) = cube_command("memory.search $terms");
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

## =========================================================================
## memory digest tool — scored search + prose summary via coding zenka
## =========================================================================

sub tool_p7_memory_digest {
    my ( $id, $args ) = @ARG;

    my $terms      = $args->{'terms'}      // '';
    my $max_tokens = $args->{'max_tokens'} // 400;

    if ( not length $terms ) {
        return send_tool_result( $id, 'terms is required', 1 );
    }

    ## [ get scored tree from memory zenka — synchronous SIZE reply ]##
    my ( $ok, $tree ) = cube_command("memory.search $terms");
    if ( not $ok or not length $tree ) {
        return send_tool_result( $id,
            'memory.search failed or returned empty', 1 );
    }

    ## [ prose-summarize via coding zenka ]##
    my $instruction
        = "summarize the following memory tree sections relevant to: $terms";
    my $result = '';
    my $error  = '';
    eval {
        local $SIG{ALRM} = sub { die "timeout\n" };
        alarm(590);
        $result = _do_summarize( $tree, $instruction, $max_tokens );
        alarm(0);
    };
    if ($@) {
        cube_disconnect();
        $error
            = $@ eq "timeout\n"
            ? 'digest timed out after 590s'
            : "error: $@";
    }

    if ( length $error ) {
        send_tool_result( $id, $error, 1 );
    } else {
        $result //= 'digest failed — coding zenka may not be running';
        send_tool_result( $id, $result, 0 );
    }
}

sub _model_chunk_size {
    ## query VRAM-safe calculated context size fresh each call -- the    ##
    ## active model [ and its auto-expanded context ] can change between ##
    ## summarize calls within this long-lived process's lifetime, so a   ##
    ## cached value silently ignores model switches                      ##
    my ( $ok, $val ) = cube_command('coding.safe-context-size');
    my $model_context_tokens
        = ( $ok and $val =~ m{^(\d+)$} ) ? $1 + 0 : 18267;
    ## leave headroom for system prompt + instruction + rolling summary + ##
    ## output tokens + tokenizer variance (dense code/json can tokenize   ##
    ## more efficiently than the 3.2 chars/token heuristic)               ##
    my $overhead_tokens = 4500;   ## system + instruction + output reserve  ##
    my $safe_tokens     = $model_context_tokens - $overhead_tokens;
    my $chunk           = int( $safe_tokens * 3.2 / 2.2 );
    $chunk = 8000 if $chunk < 8000;    ## floor for safety ##
    return $chunk;
}

sub _extract_stream_content {
    my ($text) = @ARG;

    ## primary: extract result field from final {"type":"result",...} line ##
    for my $line ( split m|\n|, $text ) {
        next unless $line =~ m{^\{.*"type"\s*:\s*"result"};
        my $decoded = eval { decode_json($line) };
        next if $@;
        my $result = $decoded->{'result'} // '';
        return $result if length($result) > 10;
    }

    ## fallback: concatenate text from {"type":"assistant",...} message ##
    ## lines                                                            ##
    my @parts;
    for my $line ( split m|\n|, $text ) {
        next unless $line =~ m{^\{.*"type"\s*:\s*"assistant"};
        my $decoded = eval { decode_json($line) };
        next if $@;
        my $msg = $decoded->{'message'} // {};
        for my $block ( @{ $msg->{'content'} // [] } ) {
            push @parts, $block->{'text'}
                if ( $block->{'type'} // '' ) eq 'text'
                and length( $block->{'text'} // '' );
        }
    }
    return join( "\n", @parts ) if @parts;

    ## last resort: return original — do not lose data ##
    return $text;
}

## summary-tree cache key : content-addressed over instruction+text, so     ##
## growing content [ same session, more days of conversation ] always       ##
## misses and re-summarizes rather than returning a stale cached answer     ##
## bmw-L13 harmony loop, ported from src/base.chk-sum.bmw.harmonize_L13 +   ##
## calculate_L13_sum + L13-str. computed LOCALLY — see the BEGIN block note ##
## above for why this must never go over the cube wire as one command line  ##
sub _bmw_l13_harmonize {
    my ( $bmw_512_bin, $validator ) = @ARG;
    return undef unless length( $bmw_512_bin // '' ) == 64;

    state $start_seed_num;
    $start_seed_num //= unpack qw| Q |, pack qw| B64 |, '10000000' x 8;
    my $bits_num = $start_seed_num;

    foreach my $segment_num ( unpack qw| Q8 |, $bmw_512_bin ) {
        while ( not AMOS7::Assert::Truth::true_int($segment_num) ) {
            $segment_num = sprintf qw| %u |, $segment_num / 13;
        }
        $bits_num ^= $segment_num;
        while ( not AMOS7::Assert::Truth::true_int($bits_num) ) {
            $bits_num <<= 1;
        }
    }

    my $result_str_B32 = encode_b32r( pack qw| Q |, $bits_num );

    my $time_start;
    $time_start = sprintf qw| %.1f |, Time::HiRes::time
        if AMOS7::TEMPLATE::template_count() > 0;

    ## fallback cap : guards cycles that never satisfy                 ##
    ## [ validator AND true_int ] when no truth template is assigned   ##
    ## [ matches the original module's iteration cap, same rationale ] ##
    my $max_iterations_num = 100_000;
    my $iteration_num      = 0;

    while (not $validator->( $result_str_B32, $bits_num )
        or not AMOS7::Assert::Truth::true_int($bits_num) ) {

        if ( AMOS7::TEMPLATE::template_count()
            and sprintf( qw| %.1f |, Time::HiRes::time ) - $time_start
            > AMOS7::TEMPLATE::template_timeout() ) {
            return undef;
        }
        if ( ++$iteration_num > $max_iterations_num ) {
            return undef;
        }

        $bits_num = sprintf qw| %u |, $bits_num / 13;
        $bits_num <<= 5;
        $bits_num       = 13 if $bits_num == 0;
        $result_str_B32 = encode_b32r( pack qw| Q |, $bits_num );
    }

    return $result_str_B32;    ## 13 characters ##
}

sub _bmw_l13 {
    my ($input) = @ARG;
    return undef unless length( $input // '' );
    return _bmw_l13_harmonize( Digest::BMW::bmw_512($input),
        sub { AMOS7::Assert::Truth::is_true( $ARG[0], 0, 1 ) } );
}

## bmw-L13 : 13-char base32 [ ~65 bits ], far lower collision risk than the ##
## 7-char amos chksum cap. computed locally — never shipped over the wire   ##
sub _tree_chk {
    my ( $instruction, $text ) = @ARG;
    my $input = ( $instruction // '' ) . "\x00" . ( $text // '' );
    return _bmw_l13($input);
}

## best-effort cache lookup : short alarm, any failure is a plain miss — ##
## never let a slow/unreachable task zenka delay or break the catch-up   ##
sub _tree_query {
    my ($chk) = @ARG;
    return undef unless length $chk;
    my $result;
    ## alarm() is one global process-wide timer, not stackable — a caller   ##
    ## further up the stack (e.g. _do_summarize's session_catchup path) may ##
    ## already have its own longer alarm pending. save + cancel it before   ##
    ## setting ours, restore it after, so our short best-effort timeout can ##
    ## never silently destroy an outer caller's deadline                    ##
    my $outer_remaining = alarm(0);
    eval {
        local $SIG{'ALRM'} = sub { die "timeout\n" };
        alarm(3);
        my ( $ok, $data ) = cube_command("task.summary-tree-query chk=$chk");
        alarm(0);
        $result = $data if $ok;
    };
    alarm($outer_remaining) if $outer_remaining and $outer_remaining > 0;
    if ($@) {
        cube_disconnect() if $@ eq "timeout\n";
        log_msg( '[tree] query failed/timed out [ chk=%s ] : %s', $chk, $@ );
        return undef;
    }
    return $result;
}

## best-effort delta notify : fired after the final summary already exists, ##
## never on the hot path of returning it to the caller                      ##
sub _tree_notify {
    my ( $chk, $origin, $focus, $result ) = @ARG;
    return unless length $chk and length( $result // '' );
    ## same global-alarm save/restore as _tree_query -- see its comment ##
    my $outer_remaining = alarm(0);
    eval {
        local $SIG{'ALRM'} = sub { die "timeout\n" };
        alarm(5);
        ## $origin_json [ JSON::XS ->utf8 encode ] and $result             ##
        ## [ raw bytes back from cube_command ] are already byte strings — ##
        ## do NOT Encode::encode them again, that double-encodes any       ##
        ## non-ASCII char [ classic "Ã©" corruption ]. only $focus is real ##
        ## perl character text                                             ##
        ## [ decoded from the incoming MCP JSON-RPC args ] and needs the   ##
        ## one real encode                                                 ##
        my $origin_json = $json->encode( $origin // {} );
        my $args        = join(
            ' ',
            "chk=$chk",
            'source=mcp',
            ## focus is free text                                    ##
            ## [ the full instruction, may contain spaces ] : always ##
            ## B32-wrap, never pass as a bare \S+ token              ##
            (   length($focus)
                ? 'focus=:B32:' . encode_b32r( encode( 'UTF-8', $focus ) )
                : ()
            ),
            'origin=:B32:' . encode_b32r($origin_json),
            ':B32:' . encode_b32r($result),
        );
        cube_command("task.summary-tree-notify $args");
        alarm(0);
    };
    alarm($outer_remaining) if $outer_remaining and $outer_remaining > 0;
    if ($@) {
        cube_disconnect() if $@ eq "timeout\n";
        log_msg( '[tree] notify failed/timed out [ chk=%s ] : %s', $chk, $@ );
    }
    return;
}

sub _do_summarize {
    my ( $text, $instruction, $max_tokens, $origin ) = @ARG;
    $instruction //= 'summarize concisely';
    $max_tokens  //= 500;

    ## tree caching only when the caller opted in [ $origin defined ] —   ##
    ## every other _do_summarize caller is unaffected, behavior unchanged ##
    my $chk;
    if ( defined $origin ) {
        $chk = _tree_chk( $instruction, $text );
        my $cached = _tree_query($chk);
        if ( defined $cached and length $cached ) {
            log_msg( '[tree] cache hit [ chk=%s ]', $chk );
            return $cached;
        }
    }

    my $chunk_size = _model_chunk_size();
    my $threshold  = int( $chunk_size * 1.1 );

    my $_b32_cmd = sub {
        my ($content) = @ARG;
        my $encoded = encode_b32r( encode( 'UTF-8', $content ) );
        return cube_command(
            "coding.summarize-context max_len=$max_tokens :B32:$encoded");
    };

    my $final_result;

    if ( length($text) > $threshold ) {
        ## rolling-window: each chunk carries forward the previous summary ##
        my $running = '';
        my $pos     = 0;
        my $chunk_n = 0;
        ## cap rolling summary so the combined prompt never nears context ##
        my $max_running_chars = 20000;
        while ( $pos < length($text) ) {
            $chunk_n++;
            my $chunk = substr( $text, $pos, $chunk_size );
            $pos += $chunk_size;

            ## keep rolling summary bounded: older details fade out        ##
            if ( length($running) > $max_running_chars ) {
                $running = substr( $running, -$max_running_chars );
                $running =~ s{^[^\n]*\n}{}s;    ## start at clean boundary ##
            }

            my $content
                = length($running)
                ? "previous summary:\n$running\n\nnew "
                . "content to integrate:\n$chunk"
                : "$instruction:\n\n$chunk";
            my ( $ok, $chunk_result ) = $_b32_cmd->($content);
            return undef unless $ok;
            $running = $chunk_result;
            log_msg(
                '[summarize] chunk %d/%d done [running=%d chars]',
                $chunk_n, int( length($text) / $chunk_size ) + 1,
                length($running)
            );
        }
        $final_result = $running;
    } else {
        my ( $ok, $result ) = $_b32_cmd->("$instruction:\n\n$text");
        return undef unless $ok;
        $final_result = $result;
    }

    ## best-effort : never block/break the return on a down task zenka ##
    _tree_notify( $chk, $origin, $instruction, $final_result )
        if defined $origin and length( $chk // '' );

    return $final_result;
}

## =========================================================================
## session catchup tool
## =========================================================================

sub _claude_session_dir {
    my $home = $ENV{'HOME'} // '/home/' . ( $ENV{'USER'} // 'taeki' );
    return "$home/.claude/projects/-data-projects-protocol-7";
}

sub _kimi_session_dir {
    my $home = $ENV{'HOME'} // '/home/' . ( $ENV{'USER'} // 'taeki' );
    return "$home/.kimi/sessions";
}

sub _list_claude_sessions {
    my ($limit) = @ARG;
    my $dir = _claude_session_dir();
    return () unless -d $dir;

    my @files = glob("$dir/*.jsonl");
    my @sessions;
    for my $file (@files) {
        my $mtime = ( stat($file) )[9] // 0;
        my $uuid  = $file;
        $uuid             =~ s{.*/}{};
        $uuid             =~ s{\.jsonl$}{};
        next unless $uuid =~ m|^[0-9a-f-]{36}$|;

        my $title = _extract_claude_session_title($file);
        push @sessions,
            {
            mtime  => $mtime,
            uuid   => $uuid,
            title  => $title,
            client => 'claude',
            file   => $file,
            };
    }
    return sort { $b->{'mtime'} <=> $a->{'mtime'} } @sessions;
}

sub _list_kimi_sessions {
    my ($limit) = @ARG;
    my $base = _kimi_session_dir();
    return () unless -d $base;

    my @sessions;
    for my $outer_dir ( glob("$base/*") ) {
        next unless -d $outer_dir;
        for my $inner_dir ( glob("$outer_dir/*") ) {
            my $state_file = "$inner_dir/state.json";
            next unless -f $state_file;
            my $uuid = $inner_dir;
            $uuid =~ s{.*/}{};

            my $file_mtime = ( stat($state_file) )[9] // 0;
            my ( $title, $mtime ) = ( '', $file_mtime );
            eval {
                open( my $fh, '<:raw', $state_file ) or die;
                my $raw = do { local $/; <$fh> };
                close $fh;
                my $d = $json->decode($raw);
                $title = $d->{'custom_title'} // '';
                my $t = $d->{'wire_mtime'} // $d->{'archived_at'} // 0;
                $mtime = int($t) if $t;
            };
            $title ||= '(no title)';
            $title =~ s|\s+| |g;
            $title = substr( $title, 0, 80 )
                . ( length($title) > 80 ? '...' : '' );
            push @sessions,
                {
                mtime  => $mtime,
                uuid   => $uuid,
                title  => $title,
                client => 'kimi',
                file   => "$inner_dir/context.jsonl",
                };
        }
    }
    return sort { $b->{'mtime'} <=> $a->{'mtime'} } @sessions;
}

sub _find_session_by_id {
    my ( $session_id, $client ) = @ARG;
    return undef unless length $session_id;

    my $is_full_uuid = $session_id =~ m|^[0-9a-f-]{36}$|;

    ## claude direct lookup ##
    if ( $client eq 'all' or $client eq 'claude' ) {
        my $dir  = _claude_session_dir();
        my $file = "$dir/$session_id.jsonl";
        if ( -f $file ) {
            my $mtime = ( stat($file) )[9] // 0;
            return {
                mtime  => $mtime,
                uuid   => $session_id,
                title  => _extract_claude_session_title($file),
                client => 'claude',
                file   => $file,
            };
        }
        if ( not $is_full_uuid ) {
            my ($found) = glob("$dir/*$session_id*.jsonl");
            if ( defined $found and -f $found ) {
                my $uuid = $found;
                $uuid =~ s{.*/}{};
                $uuid =~ s{\.jsonl$}{};
                my $mtime = ( stat($found) )[9] // 0;
                return {
                    mtime  => $mtime,
                    uuid   => $uuid,
                    title  => _extract_claude_session_title($found),
                    client => 'claude',
                    file   => $found,
                };
            }
        }
    }

    ## kimi direct lookup ##
    if ( $client eq 'all' or $client eq 'kimi' ) {
        my $base = _kimi_session_dir();
        my $pattern
            = $is_full_uuid
            ? "$base/*/$session_id/state.json"
            : "$base/*/*$session_id*/state.json";
        my ($state_file) = glob($pattern);
        if ( defined $state_file and -f $state_file ) {
            my $context_file = $state_file;
            $context_file =~ s{/state\.json$}{/context.jsonl};
            my $uuid = $state_file;
            $uuid =~ s{.*/}{};
            $uuid =~ s{/state\.json$}{};
            my ( $title, $mtime ) = ( '', ( stat($state_file) )[9] // 0 );
            eval {
                open( my $fh, '<:raw', $state_file ) or die;
                my $raw = do { local $/; <$fh> };
                close $fh;
                my $d = $json->decode($raw);
                $title = $d->{'custom_title'} // '';
                my $t = $d->{'wire_mtime'} // $d->{'archived_at'} // 0;
                $mtime = int($t) if $t;
            };
            $title ||= '(no title)';
            $title =~ s|\s+| |g;
            $title = substr( $title, 0, 80 )
                . ( length($title) > 80 ? '...' : '' );
            return {
                mtime  => $mtime,
                uuid   => $uuid,
                title  => $title,
                client => 'kimi',
                file   => $context_file,
            };
        }
    }

    return undef;
}

sub _extract_claude_session_title {
    my ($file) = @ARG;
    my $title = '';
    return $title unless -f $file;
    if ( open( my $fh, '<:raw', $file ) ) {
        while ( my $line = <$fh> ) {
            eval {
                my $d = $json->decode($line);
                if (    ( $d->{'type'} // '' ) eq 'user'
                    and ( $d->{'message'}{'role'} // '' ) eq 'user' ) {
                    my $c = $d->{'message'}{'content'} // '';
                    if ( ref $c eq 'ARRAY' ) {
                        for my $block (@$c) {
                            if ( ( $block->{'type'} // '' ) eq 'text' ) {
                                $title = $block->{'text'};
                                last;
                            }
                        }
                    } elsif ( not ref $c ) {
                        $title = $c;
                    }
                }
            };
            last if length $title;
        }
        close $fh;
    }
    $title =~ s|\s+| |g;
    $title = substr( $title, 0, 80 ) . ( length($title) > 80 ? '...' : '' );
    return $title || '(no title)';
}

sub tool_session_catchup {
    my ( $id, $args ) = @ARG;

    my $client      = lc( $args->{'client'} // 'all' );
    my $session_id  = $args->{'session_id'}  // '';
    my $instruction = $args->{'instruction'} // '';
    my $limit       = $args->{'limit'}       // 10;
    my $tail_chars  = $args->{'tail_chars'}  // 0;
    my $no_tree     = $args->{'no_tree'}     // 0;
    my $subagents   = $args->{'subagents'}   // 0;
    my $subagent_id = $args->{'subagent_id'} // '';
    my $scratchpad  = $args->{'scratchpad'}  // 0;

    ## an explicit agent filter implies subagents-only mode ##
    $subagents = 2 if length $subagent_id and not $subagents;

    ## summarize mode: direct lookup first, avoid scanning all sessions ##
    my $s;
    if ( length $session_id ) {
        $s = _find_session_by_id( $session_id, $client );
    }

    ## list mode (or fallback if direct lookup failed) ##
    unless ( defined $s and length $session_id ) {
        my @sessions;
        push @sessions, _list_claude_sessions()
            if $client eq 'all' or $client eq 'claude';
        push @sessions, _list_kimi_sessions()
            if $client eq 'all' or $client eq 'kimi';
        @sessions = sort { $b->{'mtime'} <=> $a->{'mtime'} } @sessions;

        if ( length $session_id ) {
            ($s) = grep { $_->{'uuid'} eq $session_id } @sessions;
            return send_tool_result( $id, "session not found: $session_id",
                1 )
                unless defined $s;
        } else {
            ## summarize-only params given without a session_id usually   ##
            ## mean the caller mistyped/omitted session_id — warn instead ##
            ## of silently falling back to list mode                      ##
            if (   length($instruction)
                or $tail_chars > 0
                or $subagents
                or length $subagent_id ) {
                return send_tool_result(
                    $id,
                    'no session_id given — instruction/tail_chars/'
                        . 'subagents/subagent_id/scratchpad are '
                        . 'ignored in list mode; pass session_id to '
                        . 'summarize a specific session',
                    1
                );
            }
            my @out;
            push @out, '.:[ recent sessions ]:.';
            my $n = 0;
            for my $entry (@sessions) {
                last if $n++ >= $limit;
                my @subs = _list_subagent_transcripts($entry);
                $entry->{'title'} .= sprintf ' [+%d sub]', scalar @subs
                    if @subs;
                if ( $entry->{'client'} eq 'claude' ) {
                    my $sdir = _claude_scratchpad_dir( $entry->{'uuid'} );
                    my @scr  = -d $sdir ? grep {-f} glob("$sdir/*") : ();
                    $entry->{'title'} .= sprintf ' [+%d scr]', scalar @scr
                        if @scr;
                }
                my $ts
                    = POSIX::strftime( '%m-%d %H:%M',
                    localtime( $entry->{'mtime'} ) );
                push @out, sprintf "  %-5s  %s  :. %s",
                    $entry->{'client'}, $entry->{'uuid'}, $entry->{'title'};
                $out[-1] =~ s|$| [ $ts ]|;
            }
            return send_tool_result( $id,
                @out > 1 ? join( "\n", @out ) : 'no sessions found', 0 );
        }
    }

    ## summarize mode ##
    return send_tool_result( $id, "session file missing: $s->{'file'}", 1 )
        unless -f $s->{'file'};

    ## explicit instruction wins; otherwise fall back to a primed          ##
    ## store_summary_focus                                                 ##
    ## [ same one-shot/sticky consumption as tool_external_command ], then ##
    ## the generic default                                                 ##
    my $inst
        = length($instruction)           ? $instruction
        : defined $pending_summary_focus ? $pending_summary_focus
        : 'summarize what was accomplished, key '
        . 'decisions, open issues, and next steps';
    $pending_summary_focus = undef
        if not length($instruction)
        and defined $pending_summary_focus
        and not $summary_focus_sticky;

    ## session files are in user home — coding zenka (different user) can't ##
    ## read them directly; extract conversation text here and pass as       ##
    ## content                                                              ##
    my $text = _extract_session_text( $s->{'file'}, $s->{'client'} );

    ## subagent transcripts : 0 = exclude, 1 = append, 2 = only ##
    my $sub_note = '';
    if ($subagents) {
        my ( $sub_text, $sub_count )
            = _extract_subagent_text( $s, $subagent_id );
        my $match_note
            = length($subagent_id) ? " matching '$subagent_id'" : '';
        if ( $subagents == 2 ) {
            return send_tool_result(
                $id,
                sprintf(
                    'no subagent transcripts found for %s%s',
                    $s->{'uuid'}, $match_note
                ),
                1
            ) unless length $sub_text;
            $text     = $sub_text;
            $sub_note = sprintf "[subagents only: %d transcript%s%s]\n\n",
                $sub_count, $sub_count == 1 ? '' : 's', $match_note;
        } elsif ( length $sub_text ) {
            $text .= $sub_text;
            $sub_note
                = sprintf "[includes %d subagent transcript%s%s]\n\n",
                $sub_count, $sub_count == 1 ? '' : 's', $match_note;
        }
    }

    ## claude scratchpad artifacts [ /tmp session dir, not persistent ] ##
    if ( $scratchpad and $s->{'client'} eq 'claude' ) {
        my ( $scr_text, $scr_count, $scr_skipped )
            = _extract_claude_scratchpad_text( $s->{'uuid'} );
        if ( length $scr_text ) {
            $text .= $scr_text;
            $sub_note
                .= sprintf "[includes scratchpad: %d file%s%s]\n\n",
                $scr_count, $scr_count == 1 ? '' : 's',
                $scr_skipped ? ", $scr_skipped skipped/capped" : '';
        }
    }
    return send_tool_result( $id, 'failed to read session file', 1 )
        unless length $text;

    ## for very large sessions, default to the recent tail so summarization ##
    ## finishes inside the MCP timeout window                               ##
    my $truncated_note = '';
    if ( $tail_chars > 0 and length($text) > $tail_chars ) {
        my $cut = index( $text, "\n", length($text) - $tail_chars );
        $cut  = length($text) - $tail_chars if $cut < 0;
        $text = substr( $text, $cut );
        $text =~ s|^\n+||;
        $truncated_note
            = sprintf "[summarized last %d chars of %d total]\n\n",
            $tail_chars, length($text) + $cut;
    } elsif ( $tail_chars == 0 and length($text) > 600000 ) {
        my $auto_tail = 400000;
        my $cut       = index( $text, "\n", length($text) - $auto_tail );
        $cut  = length($text) - $auto_tail if $cut < 0;
        $text = substr( $text, $cut );
        $text =~ s|^\n+||;
        $truncated_note
            = sprintf "[session was large; auto-summarized last %d chars "
            . "of %d total — use tail_chars=N to override]\n\n",
            $auto_tail, length($text) + $cut;
    }

    ## summary-tree origin : on by default, opt-out via no_tree=1 ##
    my $origin
        = $no_tree
        ? undef
        : { 'session_id' => $session_id, 'client' => $s->{'client'} };

    my $result = '';
    my $error  = '';
    eval {
        local $SIG{ALRM} = sub { die "timeout\n" };
        alarm(590);
        ## 600 was too tight for the ROLLING carried-forward summary        ##
        ## [ not just the final answer ] -- each chunking round forces      ##
        ## whatever state is being tracked through this same cap as         ##
        ## "previous summary" input to the next round, so a too-small value ##
        ## causes lossy re-compression every round instead of genuine       ##
        ## accumulation. bumped 5x ; still a real bound, just not one that  ##
        ## starves multi-round tracking on a long transcript                ##
        $result = _do_summarize( $text, $inst, 3000, $origin );
        alarm(0);
    };
    if ($@) {
        cube_disconnect();
        $error
            = $@ eq "timeout\n"
            ? 'summarization timed out after 590s'
            : "error: $@";
    }
    if ( length $error ) {
        return send_tool_result( $id, $error, 1 );
    }
    $result //= 'summarization failed';
    my $header = sprintf ":. %s .[ %s ]:. %s\n\n",
        $s->{'client'}, $session_id,
        POSIX::strftime( '%Y-%m-%d %H:%M', localtime( $s->{'mtime'} ) );
    return send_tool_result( $id,
        $header . $sub_note . $truncated_note . $result, 0 );
}

sub _extract_session_text {
    my ( $file, $client ) = @ARG;
    my $text = '';
    return $text unless -f $file;
    open( my $fh, '<:raw', $file ) or return $text;
    while ( my $line = <$fh> ) {
        eval {
            my $d = $json->decode($line);
            if ( $client eq 'claude' ) {
                ## claude: type=user or type=assistant entries ##
                my $role = $d->{'type'} // '';
                if ( $role eq 'user' or $role eq 'assistant' ) {
                    my $msg = $d->{'message'}   // {};
                    my $c   = $msg->{'content'} // '';
                    if ( ref $c eq 'ARRAY' ) {
                        for my $b (@$c) {
                            next unless ref $b eq 'HASH';
                            $text .= $b->{'text'} . "\n"
                                if ( $b->{'type'} // '' ) eq 'text';
                        }
                    } elsif ( not ref $c and length $c ) {
                        $text .= $c . "\n";
                    }
                }
            } else {
                ## kimi context.jsonl: role=user or role=assistant ##
                my $role = $d->{'role'} // '';
                if ( $role eq 'user' or $role eq 'assistant' ) {
                    my $c = $d->{'content'} // '';
                    if ( ref $c eq 'ARRAY' ) {
                        for my $b (@$c) {
                            next unless ref $b eq 'HASH';
                            $text .= $b->{'text'} . "\n"
                                if ( $b->{'type'} // '' ) eq 'text';
                        }
                    } elsif ( not ref $c and length $c ) {
                        $text .= $c . "\n";
                    }
                }
            }
        };
    }
    close $fh;
    ## ensure decoded perl chars before returning ##
    utf8::decode($text) if length $text and not utf8::is_utf8($text);
    return $text;
}

sub _list_subagent_transcripts {
    my ($s) = @ARG;
    my @agents;

    if ( $s->{'client'} eq 'claude' ) {
        ## claude : <session-dir>/<uuid>/subagents/agent-<id>.jsonl ##
        my $dir = _claude_session_dir() . q{/} . $s->{'uuid'} . q{/subagents};
        return () unless -d $dir;
        for my $file ( glob("$dir/agent-*.jsonl") ) {
            my $id = $file;
            $id =~ s{.*/agent-}{};
            $id =~ s{\.jsonl$}{};
            my ( $type, $descr, $model ) = ( 'agent', '', '' );
            my $meta_file = $file;
            $meta_file =~ s{\.jsonl$}{.meta.json};
            if ( -f $meta_file ) {
                eval {
                    open( my $fh, '<:raw', $meta_file ) or die;
                    my $raw = do { local $/; <$fh> };
                    close $fh;
                    my $m = $json->decode($raw);
                    $type  = $m->{'agentType'}   // $type;
                    $descr = $m->{'description'} // '';
                    $model = $m->{'model'}       // '';
                };
            }
            push @agents,
                {
                id    => $id,
                type  => $type,
                descr => $descr,
                model => $model,
                file  => $file,
                mtime => ( stat($file) )[9] // 0,
                };
        }
    } elsif ( $s->{'client'} eq 'kimi' ) {
        ## kimi : <session-dir>/subagents/<agent-id>/context.jsonl ##
        my $sdir = $s->{'file'};
        $sdir =~ s{/context\.jsonl$}{};
        my $dir = "$sdir/subagents";
        return () unless -d $dir;
        for my $adir ( grep {-d} glob("$dir/*") ) {
            my $file = "$adir/context.jsonl";
            next unless -f $file;
            my $id = $adir;
            $id =~ s{.*/}{};
            my ( $type, $descr ) = ( 'agent', '' );
            my $mtime     = ( stat($file) )[9] // 0;
            my $meta_file = "$adir/meta.json";
            if ( -f $meta_file ) {
                eval {
                    open( my $fh, '<:raw', $meta_file ) or die;
                    my $raw = do { local $/; <$fh> };
                    close $fh;
                    my $m = $json->decode($raw);
                    $type  = $m->{'subagent_type'} // $type;
                    $descr = $m->{'description'}   // '';
                    $mtime = int( $m->{'created_at'} )
                        if $m->{'created_at'};
                };
            }
            push @agents,
                {
                id    => $id,
                type  => $type,
                descr => $descr,
                model => '',
                file  => $file,
                mtime => $mtime,
                };
        }
    }
    return sort { $a->{'mtime'} <=> $b->{'mtime'} } @agents;
}

sub _extract_subagent_text {
    my ( $s, $filter ) = @ARG;
    $filter //= '';
    my ( $text, $count ) = ( '', 0 );
    for my $a ( _list_subagent_transcripts($s) ) {
        if ( length $filter ) {
            my $hay = join "\x00", $a->{'id'}, $a->{'type'},
                $a->{'model'}, $a->{'descr'};
            next unless index( lc($hay), lc($filter) ) >= 0;
        }
        my $body = _extract_session_text( $a->{'file'}, $s->{'client'} );
        next unless length $body;
        $count++;
        $text .= sprintf "\n.:[ subagent %d .[ %s ]:. %s%s ]:.\n",
            $count, $a->{'type'}, $a->{'descr'},
            length( $a->{'model'} ) ? " [ model: $a->{'model'} ]" : '';
        $text .= $body;
    }
    return ( $text, $count );
}

sub _claude_scratchpad_dir {
    my ($uuid) = @ARG;
    my $proj = _claude_session_dir();
    $proj =~ s{.*/}{};
    return sprintf "/tmp/claude-%d/%s/%s/scratchpad",
        $REAL_USER_ID, $proj, $uuid;
}

sub _chmod_dir_if_mine {
    my ( $path, $mode ) = @ARG;
    return unless -d $path;
    my ( $uid, $cur ) = ( stat($path) )[ 4, 2 ];
    return unless defined $uid and $uid == $REAL_USER_ID;
    $cur &= 07777;
    chmod( $cur | $mode, $path ) if ( $cur & $mode ) != $mode;
    return;
}

sub _scratchpad_group_grant {
    my ($dir) = @ARG;
    ## permission bridge for the coding zenka [ supplementary taeki group ] :
    ## g+rx on the scratchpad dir itself, traverse-only g+x on the session
    ## uuid dir [ tasks/ etc. stay unlistable ], g+rx on the fixed-name
    ## parents [ project dir + /tmp/claude-<uid> ] so glob enumeration of uuid
    ## dirs works [ best-effort, silently skipped if not owner ]
    return unless -d $dir;
    _chmod_dir_if_mine( $dir, 0750 );
    my $depth = 0;
    my $p     = $dir;
    while ( $p =~ s{/[^/]+$}{} ) {
        last if $p eq '/tmp' or length($p) < 5;
        _chmod_dir_if_mine( $p, $depth == 0 ? 0710 : 0750 );
        $depth++;
    }
    return;
}

sub _extract_claude_scratchpad_text {
    my ($uuid) = @ARG;
    my $dir = _claude_scratchpad_dir($uuid);
    _scratchpad_group_grant($dir) if -d $dir;
    return ( '', 0, 0 ) unless -d $dir;

    my $file_cap  = 24576;     ## per-file content cap ##
    my $total_cap = 122880;    ## overall scratchpad text cap ##

    my @files = sort { ( stat($a) )[9] <=> ( stat($b) )[9] }
        grep {-f} glob("$dir/*");
    my ( $text, $count, $skipped ) = ( '', 0, 0 );
    ## record the volatile source path in-band so summaries keep it ##
    $text = ".:[ scratchpad source :. $dir ]:.\n" if @files;
    for my $file (@files) {
        my $name = $file;
        $name =~ s{.*/}{};
        my $size = ( stat($file) )[7] // 0;
        if ( not -T $file ) {    ## binary : list name+size only ##
            $text .= sprintf "\n.:[ scratchpad .[ %s ]:. binary, %d bytes "
                . "— content skipped ]:.\n", $name, $size;
            $skipped++;
            next;
        }
        if ( length($text) >= $total_cap ) {
            $skipped++;
            next;
        }
        my $content = '';
        eval {
            open( my $fh, '<:raw', $file ) or die;
            my $raw = do { local $/; <$fh> };
            close $fh;
            $content = $raw // '';
        };
        next unless length $content;
        if ( length($content) > $file_cap ) {
            $content = substr( $content, 0, $file_cap )
                . "\n[.. truncated at $file_cap chars of $size bytes ..]";
            $skipped++;
        }
        utf8::decode($content)
            if length $content and not utf8::is_utf8($content);
        $count++;
        $text .= sprintf "\n.:[ scratchpad .[ %s ]:. ]:.\n%s\n",
            $name, $content;
    }
    return ( $text, $count, $skipped );
}

sub tool_scratchpad_import {
    my ( $id, $args ) = @ARG;

    my $session_id = $args->{'session_id'} // '';
    my $only_file  = $args->{'file'}       // '';

    ## list mode : no session_id — show imported and/or available ##
    return _scratchpad_list( $id, $args->{'list'} // 'all' )
        unless length $session_id;

    my $s = _find_session_by_id( $session_id, 'claude' );
    return send_tool_result( $id, "claude session not found: $session_id", 1 )
        unless defined $s;

    my $src_dir = _claude_scratchpad_dir( $s->{'uuid'} );
    _scratchpad_group_grant($src_dir) if -d $src_dir;
    return send_tool_result( $id,
        "no scratchpad dir for $s->{'uuid'} [ $src_dir ]", 1 )
        unless -d $src_dir;

    my @files = sort { ( stat($a) )[9] <=> ( stat($b) )[9] }
        grep {-f} glob("$src_dir/*");
    return send_tool_result( $id,
        "scratchpad is empty for $s->{'uuid'} [ $src_dir ]", 1 )
        unless @files;

    ## raw single-file read mode : no import ##
    if ( length $only_file ) {
        my ($match) = grep {m{/\Q$only_file\E$}} @files;
        return send_tool_result( $id,
            "scratchpad file not found: $only_file [ $src_dir ]", 1 )
            unless defined $match;
        my $size    = ( stat($match) )[7] // 0;
        my $content = '';
        eval {
            open( my $fh, '<:raw', $match ) or die;
            $content = do { local $/; <$fh> }
                // '';
            close $fh;
        };
        return send_tool_result( $id, "cannot read $match", 1 )
            unless length $content;
        my $cap  = 102400;
        my $note = '';
        if ( length($content) > $cap ) {
            $content = substr( $content, 0, $cap );
            $note    = "[truncated at $cap of $size bytes]\n";
        }
        utf8::decode($content)
            if length $content and not utf8::is_utf8($content);
        return send_tool_result(
            $id,
            sprintf( ":. %s [ %d bytes ]:.\n%s\n", $match, $size, $note )
                . $content,
            0
        );
    }

    ## import mode : data/scratchpad/<bmw-L13 of the session tmp path with  ##
    ## trailing slash — same string bin/bmw-L13 users get when checksumming ##
    ## /tmp/claude-*/<proj>/<uuid>/                                         ##
    my $session_tmp = $src_dir;
    $session_tmp =~ s{/scratchpad$}{/};
    my $bmw      = _bmw_l13($session_tmp) // qw| NOCHECKSUM13 |;
    my $dest_dir = $ROOT_PATH . "/data/scratchpad/$bmw";
    eval { make_path($dest_dir) if not -d $dest_dir };
    return send_tool_result( $id, "cannot create $dest_dir : $@", 1 )
        if $EVAL_ERROR or not -d $dest_dir;

    my @out;
    push @out, '.:[ scratchpad imported ]:.';
    push @out, "  source : $src_dir";
    push @out, "  dest   : $dest_dir";
    push @out, "  bmw    : $bmw";
    my $copied = 0;
    for my $file (@files) {
        my $name = $file;
        $name =~ s{.*/}{};
        if ( copy( $file, "$dest_dir/$name" ) ) {
            my $mtime = ( stat($file) )[9];
            utime( time, $mtime, "$dest_dir/$name" ) if defined $mtime;
            $copied++;
            push @out, sprintf "  %8d  %s", ( stat($file) )[7] // 0, $name;
        } else {
            push @out, "  FAILED   $name : $OS_ERROR";
        }
    }

    ## IMPORT-INFO records the volatile source path ##
    eval {
        open( my $fh, '>:raw', "$dest_dir/IMPORT-INFO" ) or die;
        print $fh join( '',
            "original_path : $src_dir\n",
            "session_tmp   : $session_tmp [ bmw-L13 key source ]\n",
            "session_uuid  : $s->{'uuid'}\n",
            "bmw_l13       : $bmw\n",
            "imported_at   : "
                . POSIX::strftime( '%Y-%m-%d %H:%M:%S %z', localtime ) . "\n",
            "files         : $copied\n" );
        close $fh;
    };
    push @out, '  IMPORT-INFO written [ source path recorded ]';
    return send_tool_result( $id, join( "\n", @out ), 0 );
}

sub _scratchpad_list {
    my ( $id, $which ) = @ARG;
    $which //= 'all';
    my %rows;    ## keyed by bmw id : merges repo + /tmp state ##

    if ( $which ne 'imported' ) {
        ## available in /tmp [ import candidates, volatile ] ##
        my $proj = _claude_session_dir();
        $proj =~ s{.*/}{};
        my $tmp_base = sprintf "/tmp/claude-%d/%s", $REAL_USER_ID, $proj;
        for my $sdir ( grep {-d} glob("$tmp_base/*") ) {
            my $scr = "$sdir/scratchpad";
            next unless -d $scr;
            _scratchpad_group_grant($scr);
            my @f = grep {-f} glob("$scr/*");
            next unless @f;
            my $uuid = $sdir;
            $uuid =~ s{.*/}{};
            my $bmw = _bmw_l13("$sdir/") // qw| ? |;    ## trailing slash ##
            $rows{$bmw}->{'uuid'}      = $uuid;
            $rows{$bmw}->{'tmp_files'} = scalar @f;
            $rows{$bmw}->{'tmp_mtime'}
                = max( map { ( stat($_) )[9] // 0 } @f );
        }
    }

    if ( $which ne 'tmp' ) {
        ## imported into the repository ##
        my $base = $ROOT_PATH . qw| /data/scratchpad |;
        for my $dir ( grep {-d} glob("$base/*") ) {
            my $bmw = $dir;
            $bmw =~ s{.*/}{};
            my $info = "$dir/IMPORT-INFO";
            if ( -f $info ) {
                eval {
                    open( my $fh, '<:raw', $info ) or die;
                    while ( my $line = <$fh> ) {
                        $rows{$bmw}->{'uuid'} = $1
                            if $line =~ m{^session_uuid\s*:\s*(\S+)};
                        $rows{$bmw}->{'repo_files'} = $1
                            if $line =~ m{^files\s*:\s*(\d+)};
                        $rows{$bmw}->{'imported'} = $1
                            if $line =~ m{^imported_at\s*:\s*(.+)$};
                    }
                    close $fh;
                };
            }
            $rows{$bmw}->{'repo_files'}
                //= scalar grep {-f} glob("$dir/*");
            $rows{$bmw}->{'repo_mtime'} = ( stat($dir) )[9] // 0;
        }
    }

    return send_tool_result( $id, "no scratchpads found [ $which ]", 0 )
        unless %rows;

    my @out = ".:[ scratchpads .[ $which ]:. ]:.";
    for my $bmw (
        sort {
            max($rows{$b}->{'tmp_mtime'}  // 0,
                $rows{$b}->{'repo_mtime'} // 0
            ) <=> max(
                $rows{$a}->{'tmp_mtime'}  // 0,
                $rows{$a}->{'repo_mtime'} // 0
            )
        } keys %rows
    ) {
        my $r      = $rows{$bmw};
        my $status = join '+',
            grep {length} (
            $r->{'repo_files'} ? 'repo'     : '',
            $r->{'tmp_files'}  ? qw| /tmp | : ''
            );
        my $ts
            = $r->{'imported'}
            ? "imported $r->{'imported'}"
            : POSIX::strftime( '%Y-%m-%d %H:%M',
            localtime( $r->{'tmp_mtime'} // 0 ) );
        $ts =~ s{\s+\S+$}{} if $r->{'imported'};    ## drop tz suffix ##
        my $files
            = ( $r->{'repo_files'} and $r->{'tmp_files'} )
            ? "$r->{'repo_files'} repo / $r->{'tmp_files'} tmp"
            : ( $r->{'repo_files'} // $r->{'tmp_files'} // 0 );
        push @out, sprintf ':: %s :. %s :. %s :. %s files [ %s ]',
            $bmw, $r->{'uuid'} // '?', $status, $files, $ts;
    }
    return send_tool_result( $id, join( "\n", @out ), 0 );
}

sub _do_summarize_file {
    my ( $path, $instruction, $max_tokens ) = @ARG;
    $instruction //= 'summarize concisely';
    $max_tokens  //= 500;

    ## coding zenka reads the file directly — content never enters mcp ##
    ## context                                                         ##
    my $focus   = '';
    my $cmd_opt = "max_len=$max_tokens path=$path";
    $cmd_opt .= " focus=$focus" if length $focus;
    my ( $ok, $result ) = cube_command("coding.summarize-context $cmd_opt");
    return $ok ? $result : undef;
}

## =========================================================================
## external command tool implementations
## =========================================================================

sub tool_external_command {
    my ( $id, $args, $ext ) = @ARG;

    ## claude-specific defaults and model alias resolution
    if ( $ext->{'name'} =~ m{^claude_} ) {
        $args->{'model'}      //= 'sonnet';
        $args->{'max_budget'} //= '1.00';

        my %model_map = (
            'haiku'  => 'claude-haiku-4-5-20251001',
            'sonnet' => 'claude-sonnet-5-5',
            'opus'   => 'claude-opus-5-5',
            'fable'  => 'claude-fable-5-1',
        );
        if ( defined $args->{'model'} ) {
            my $resolved = $model_map{ lc $args->{'model'} };
            ## not a recognised alias -- passed through AS-IS on purpose [ a
            ## caller may legitimately want a raw underlying model string not
            ## yet in this table ], but silently doing so is exactly what let
            ## a real dispatch quietly run on the wrong [ costlier ] kimi
            ## model, 2026-08-16 -- log it so a typo/drift is visible instead
            ## of invisible
            log_msg(
                'warning: unrecognised %s model '
                    . 'alias %s, passing through as-is',
                'claude', $args->{'model'}
            ) if not defined $resolved;
            $args->{'model'} = $resolved // $args->{'model'};
        }
    }

    ## kimi-specific defaults and model alias resolution
    if ( $ext->{'name'} =~ m{^kimi_} ) {
        ## default changed 2026-09-15, per user + a real observed data point
        ## -- superseded the 2026-08-16 k3-256k-by-default reasoning below
        ## [ kept for history, not current advice ]. 'kimi-for-coding'
        ## [ our 'k2.7' alias ] now runs K2.8 Preview under the hood [ a
        ## 2026-09 Kimi-side upgrade, "performance close to K3" per Kimi's own
        ## docs ]
        ## -- and a real multi-hour, moderately complex dispatch this session
        ## [ GGUF conversion + running python probes + orchestrating a
        ## validation sweep + write-up ] used only ~35% of the rate-limit
        ## window doing it, well under what k3/k3-256k would have cost for
        ## comparable work.  one strong data point, not a large sample -- if
        ## quality problems show up on a k2.7-default dispatch, that's real
        ## signal to revisit, not something to explain away.
        ##
        ## previous reasoning [ 2026-08-16, no longer the live default ]:
        ## defaulted to k3-256k over full k3 for the same reasoning quality at
        ## roughly half the quota cost within a 256k context ceiling.  still
        ## pass model=k3 explicitly when K3's specifically stronger reasoning
        ## genuinely matters [ permission models, concurrency, protocol design
        ## -- see project-kimi-k2.7-vs-k3-tier-economics.md's "how to apply"
        ## ], and model=k3-1m only on the rare task whose CONTEXT
        ## [ not reasoning difficulty ] genuinely exceeds 256k or needs video
        ## input
        ## -- see the 2026-09-17 alias rename note on %model_map below : 'k3'
        ## bare now points at the 256k variant, not the 1M one, on purpose
        ## [ the usually-correct choice should be the short name ]
        $args->{'model'} //= 'k2.8';

        my %model_map = (
            ## renamed 2026-09-17, per user : 'k3' used bare almost always  ##
            ## meant "k3-tier reasoning", not "i specifically need the full ##
            ## 1M context" -- the old bare 'k3' pointing at the 1M variant  ##
            ## made the expensive choice the SHORT, easy-to-type one and    ##
            ## the usually-correct 256k variant the one you had to remember ##
            ## to ask for. flipped : 'k3' now IS the 256k-ceiling variant   ##
            ## [ same reasoning tier, ~1/2 the quota ], and the full        ##
            ## 1M-context variant needs its size spelled out in the name    ##
            ## you type                                                     ##
            'k3' => 'kimi-code/k3-256k',
            ## explicit alias, unchanged ##
            'k3-256k' => 'kimi-code/k3-256k',
            'k3-1m'   => 'kimi-code/k3',        ## the old bare 'k3' target ##
            ## canonical name, matches the model actually running ##
            ## [ K2.8 Preview, 2026-09 Kimi-side upgrade ]        ##
            'k2.8' => 'kimi-code/kimi-for-coding',
            ## deprecated alias, kept working for anyone's existing typed ##
            ## 'model=k2.7' -- same target as 'k2.8', don't diverge these ##
            ## two                                                        ##
            'k2.7'      => 'kimi-code/kimi-for-coding',
            'k2.7-fast' => 'kimi-code/kimi-for-coding-highspeed',
        );
        if ( defined $args->{'model'} ) {
            my $resolved = $model_map{ lc $args->{'model'} };
            log_msg(
                'warning: unrecognised %s model '
                    . 'alias %s, passing through as-is',
                'kimi', $args->{'model'}
            ) if not defined $resolved;
            $args->{'model'} = $resolved // $args->{'model'};
        }
    }

    ## params handled here, not forwarded to the shell command ##
    my %skip_in_cmd
        = map { $_ => 1 } qw( auto_summarize keep template create_template );

    ## template: resolve and prepend to prompt before dispatch ##
    if ( length( $args->{'template'} // '' ) ) {
        my $tname = $args->{'template'};
        my ( $tok, $tresult )
            = cube_command(
            "kimi-web.resolve_template template=$tname budget=4000");
        if ( $tok and length $tresult ) {
            $args->{'prompt'}
                = "$tresult\n\n---\n\n" . ( $args->{'prompt'} // '' );
        } else {
            ## non-fatal: log and continue without template ##
            log_msg( "template resolve failed for '%s' — dispatching without",
                $tname );
        }
    }

    ## build command from params
    my @cmd_args;
    if ( defined $ext->{'params'} ) {
        for my $p ( @{ $ext->{'params'} } ) {
            my ( $name, undef, $required ) = @$p;
            my $val = $args->{$name} // '';
            if ( $required and not length $val ) {
                return send_tool_result( $id, "$name is required", 1 );
            }
            next if $skip_in_cmd{$name};
            push @cmd_args, quotemeta($val);
        }
    } else {
        ## legacy format (1-2 params)
        my $param = $args->{ $ext->{'param_name'} } // '';
        push @cmd_args, quotemeta($param);
        if ( defined $ext->{'param2_name'} ) {
            push @cmd_args,
                quotemeta( $args->{ $ext->{'param2_name'} } // '' );
        }
    }

    my $cmd    = sprintf( $ext->{'command'}, @cmd_args );
    my $output = '';
    my $error  = '';

    if ( $ext->{'name'} =~ m{^kimi_(?:dispatch|continue)$} ) {
        ## kimi dispatch/continue run DETACHED [ _kimi_fork_run ] : the     ##
        ## unconditional qx() below blocked this whole single-threaded      ##
        ## server — one blocking STDIN read loop, no fork/threads for       ##
        ## request handling — for the entire kimi run                       ##
        ## [ up to the 4620s alarm ], so kimi_check_status                  ##
        ## [ and every other tool call ] queued behind it and could never   ##
        ## get a turn while a dispatch was in flight                        ##
        ## [ root-caused 2026-09-08 ]. kimi is the ONLY tool family on this ##
        ## path with a dedicated result-recovery tool                       ##
        ## [ kimi_check_status reads the session's wire.jsonl back ], which ##
        ## is why returning early here is safe — doing the same for         ##
        ## claude_* would be a regression                                   ##
        ## [ no claude_check_status exists to ever retrieve the result ],   ##
        ## so claude_dispatch / claude_continue / everything else keeps the ##
        ## exact blocking qx() behavior in the else branch, deliberately    ##
        my $run = _kimi_fork_run( $cmd, $ext );
        if ( length( $run->{'error'} // '' ) ) {
            $error = $run->{'error'};
        } elsif ( $run->{'finished'} ) {
            ## near-instant completion [ in practice almost always an       ##
            ## immediate CLI failure — real kimi runs take minutes ] : feed ##
            ## the real output through the exact same synchronous           ##
            ## post-processing below as a qx() result gets today            ##
            $output = $run->{'output'};
        } else {
            ## still running past the bounded window : reply immediately ##
            ## and let the caller poll kimi_check_status for the result  ##
            return _kimi_dispatch_async_reply( $id, $args, $ext, $run );
        }
    } else {
        ## run with timeout, capture stdout+stderr
        eval {
            local $SIG{ALRM} = sub { die "timeout\n" };
            alarm( $ext->{'timeout'} // 120 );
            $output = qx($cmd 2>/dev/null);
            alarm(0);
        };
        if ($@) {
            $error
                = $@ eq "timeout\n"
                ? "command timed out after $ext->{'timeout'}s"
                : "error: $@";
        }
    }

    ## claude session id extraction
    if (    not length($error)
        and $ext->{'name'} eq 'claude_dispatch'
        and $output =~ m|"session_id"\s*:\s*"([a-f0-9-]{36})"| ) {
        my $session_id = $1;
        $output .= "\nTo resume this session: claude -r $session_id\n";
    }

    ## auto_summarize: compress large dispatch output via local 9B model ##
    if ( not length($error)
        and $ext->{'name'} =~ m{^(?:claude|kimi)_(?:dispatch|continue)$} ) {
        my $auto_sum = $args->{'auto_summarize'} // '';
        my $do_sum
            = !length($auto_sum)                                ? 1
            : ( lc($auto_sum) ne 'false' and $auto_sum ne '0' ) ? 1
            :                                                     0;
        log_msg( '[auto_summarize] %s: raw_output_len=%d do_sum=%d',
            $ext->{'name'}, length($output), $do_sum );
        if ($do_sum) {
            ## preserve resume line verbatim — keep UUID out of model ##
            ## round-trip                                             ##
            my $resume_line = '';
            if ( $output =~ s{(\nTo resume this session: \S+ -r \S+)\n*$}{} )
            {
                $resume_line = $1;
            }
            ## use stored focus if primed, then clear it (one-shot) ##
            my $instruction = $pending_summary_focus
                // 'extract: status (completed/partial/errored), '
                . 'files_created (list), files_modified (list), '
                . 'issues (list), resume_uuid (if present), '
                . 'next_steps (explicit next actions)';
            $pending_summary_focus = undef
                if not $summary_focus_sticky and not $args->{'keep'};
            $output = _extract_stream_content($output);
            log_msg( '[auto_summarize] %s: extracted_len=%d resume_line=%d',
                $ext->{'name'}, length($output), length($resume_line) );
            cube_disconnect()
                ;    ## flush any stale socket state from subprocess ##
            my $t0 = time;
            ## this call site previously had NO timeout at all -- unlike    ##
            ## every other _do_summarize call site in this file, nothing    ##
            ## wrapped it in alarm(). since this whole server is            ##
            ## single-threaded [ one blocking STDIN read loop, no           ##
            ## fork/threads for request handling ], a stuck summarize here  ##
            ## blocked every other MCP tool call indefinitely, not just     ##
            ## this one.  also bumped 600->3000 : see the matching fix +    ##
            ## comment on the session_catchup call site for why 600 was too ##
            ## tight for a rolling carried-forward summary specifically     ##
            my $summary;
            eval {
                local $SIG{ALRM} = sub { die "timeout\n" };
                alarm(590);
                $summary = _do_summarize( $output, $instruction, 3000 );
                alarm(0);
            };
            if ($@) {
                cube_disconnect();
                log_msg(
                    '[auto_summarize] %s: summarize timed out/errored : %s',
                    $ext->{'name'}, $@ );
                $summary = undef;
            }
            log_msg(
                '[auto_summarize] %s: summary_defined=%d '
                    . 'summary_len=%d elapsed=%ds',
                $ext->{'name'},
                defined $summary ? 1                : 0,
                defined $summary ? length($summary) : 0,
                time - $t0
            );

            if ( defined $summary and length $summary ) {
                $output = $summary;
            } else {
                log_msg(
                    '[auto_summarize] %s: FALLBACK to '
                        . 'raw output (summary missing/empty)',
                    $ext->{'name'}
                );
            }
            $output .= $resume_line if length $resume_line;
        }
    }

    ## create_template: distill session into a reusable context template ##
    if (    not length($error)
        and length( $args->{'create_template'} // '' )
        and $ext->{'name'} =~ m{^(?:claude|kimi)_dispatch$} ) {

        my $tslug = $args->{'create_template'};
        $tslug =~ s{[^a-z0-9\-]}{}gi;    ## sanitize: slug chars only ##

        if ( length $tslug ) {
            ## use summarized output if available, else raw session text ##
            my $session_text = $output;

            my $inst
                = "you are generating a reusable YAML context template. "
                . "based on the session below, produce a template that "
                . "would help an AI agent perform the same kind of "
                . "task more efficiently in the future. capture: what "
                . "the task pattern is, key files and modules "
                . "involved, conventions to follow, common pitfalls "
                . "observed, and any useful examples. output ONLY "
                . "valid YAML with this structure:\n---\nname: "
                . "$tslug\ndescr: <one line description>\nbudget: "
                . "3000\nsections:\n  - static: |\n      ## <template "
                . "title> ##\n      <content here, indented 6 "
                . "spaces>\n";

            my $tresult = _do_summarize( $session_text, $inst, 1200 );

            if ( defined $tresult and length $tresult ) {
                ## strip any markdown fences the model may have added ##
                $tresult =~ s{^```(?:yaml)?\n?}{}m;
                $tresult =~ s{\n?```\s*$}{}m;

                my $tpath
                    = "$ROOT_PATH/data/yaml/context-templates/$tslug.yaml";

                ## overwriting an existing template is expected/intended
                ## [ a later dispatch's insight replaces an earlier one ], but
                ## stay loud about it rather than clobbering silently
                log_msg( "create_template: overwriting existing %s", $tpath )
                    if -e $tpath;

                if ( open my $fh, '>:encoding(UTF-8)', $tpath ) {
                    print $fh $tresult;
                    close $fh;
                    log_msg( "create_template: wrote %s", $tpath );
                } else {
                    log_msg( "create_template: failed to write %s : %s",
                        $tpath, $! );
                }
            } else {
                log_msg(
                    "create_template: summarization returned empty — skipped"
                );
            }
        }
    }

    my $result = length($error) ? $error : $output;
    send_tool_result( $id, $result, length($error) ? 1 : 0 );
}

##[ claude cloud session tools ]##

## run @cmd strictly LIST-FORM                                             ##
## [ never a shell string — the cloud prompt is untrusted text ] with      ##
## stdout+stderr merged, stdin from /dev/null, optional working directory, ##
## and an alarm() timeout. returns ( output, error, exit_code ) ; error    ##
## undef on clean runs                                                     ##
sub _cloud_run_list {
    my ( $cmd, $timeout, $cwd ) = @ARG;

    my ( $rdr, $wtr );
    pipe( $rdr, $wtr ) or return ( undef, "pipe failed: $OS_ERROR", undef );

    my $pid = fork();
    if ( not defined $pid ) {
        close $rdr;
        close $wtr;
        return ( undef, "fork failed: $OS_ERROR", undef );
    }
    if ( $pid == 0 ) {    ## child : redirect stdio, chdir, exec list-form ##
        close $rdr;
        chdir($cwd) if defined $cwd and length $cwd;
        open( STDIN,  '<',  '/dev/null' );
        open( STDOUT, '>&', $wtr ) or POSIX::_exit(127);
        open( STDERR, '>&', $wtr ) or POSIX::_exit(127);
        close $wtr;
        exec( @{$cmd} );      ## one arg = program, rest = argv : no shell ##
        POSIX::_exit(127);    ## reached only when exec itself fails   ##
    }
    close $wtr;

    my $output = '';
    eval {
        local $SIG{ALRM} = sub { die "timeout\n" };
        alarm( $timeout // 120 );
        $output = do { local $/ = undef; <$rdr> }
            // '';
        close $rdr;
        alarm(0);
    };
    if ($EVAL_ERROR) {
        alarm(0);
        kill 'KILL', $pid;
        waitpid( $pid, 0 );
        close $rdr;
        return ( $output, "command timed out after ${timeout}s", undef )
            if $EVAL_ERROR eq "timeout\n";
        return ( $output, "error: $EVAL_ERROR", undef );
    }
    waitpid( $pid, 0 );
    return ( $output, undef, $? >> 8 );
}

## github-url check, mirroring what claude --cloud accepts for cloning [   ##
## https \ ssh \ git@ forms of github.com — verified in the 2.1.301 bundle ##
## ]. PROTOCOL_7_MCP_CLOUD_GITHUB_HOSTS is a TEST-ONLY escape hatch [      ##
## comma-separated extra url prefixes — the tests substitute a local bare  ##
## repo for github ] ; never set it outside the test harness               ##
sub _cloud_is_github_url {
    my ($url) = @ARG;
    return 0 if not defined $url or not length $url;
    return 1 if $url =~ m{\A(?:https?://|git@)(?:www\.)?github\.com[:/]}i;
    for my $prefix ( split m{,},
        $ENV{'PROTOCOL_7_MCP_CLOUD_GITHUB_HOSTS'} // '' ) {
        $prefix =~ s{^\s+|\s+$}{}g;
        return 1 if length $prefix and index( $url, $prefix ) == 0;
    }
    return 0;
}

## dispatch a task to a BILLED claude.ai cloud session. the CLI form is     ##
## fixed by its own help + docs : --cloud [description] creates a NEW cloud ##
## session whose description IS the task, and -p is REJECTED with a         ##
## description [ verified against installed 2.1.301 : "With --print,        ##
## --cloud sends the prompt to an existing cloud session ... To start a new ##
## cloud session from a description instead, drop --print" ; the headless   ##
## docs confirm ]. so the whole preamble + task goes into ONE               ##
## '--cloud=<task>' argv element                                            ##
## [ value form : optional-value flags need it ], and non-interactivity     ##
## comes from stdout being a captured pipe                                  ##
## [ the -p help : the trust dialog is skipped "when stdout is not a TTY" ] ##
## + stdin from /dev/null. NO --bg : a background start only prints the     ##
## short id, with no claude.ai/code url to parse, and the spec wants the    ##
## url in the reply — so the call blocks [ alarm-capped ] until the session ##
## reports back, exactly like claude_dispatch does on this single-threaded  ##
## server                                                                   ##
sub tool_claude_cloud_dispatch {
    my ( $id, $args ) = @ARG;

    my $prompt = $args->{'prompt'} // '';
    return send_tool_result( $id, 'prompt is required', 1 )
        if not length $prompt;

    ## tuning param validation FIRST — before any git call or dispatch :   ##
    ## effort is a closed enum, model is restricted to ^[A-Za-z0-9._-]+$ [ ##
    ## both end up inside slash commands sent to a remote session, so      ##
    ## anything outside those shapes is refused here rather than shipped ] ##
    my %valid_effort = map { $ARG => 1 } qw| low medium high xhigh max |;
    my $effort       = lc( $args->{'effort'} // '' );
    return send_tool_result( $id,
        "invalid effort '$effort' : use low|medium|high|xhigh|max", 1 )
        if length $effort and not $valid_effort{$effort};

    my $model = $args->{'model'} // '';
    return send_tool_result( $id,
        "invalid model '$model' : must match ^[A-Za-z0-9._-]+\$", 1 )
        if length $model and $model !~ m{\A[A-Za-z0-9._-]+\z};

    my $fast
        = (
        lc( $args->{'fast'} // '' ) eq 'true'
            or ( $args->{'fast'} // '' ) eq '1'
        )
        ? 1
        : 0;
    my $allow_dirty
        = (
        lc( $args->{'allow_dirty'} // '' ) eq 'true'
            or ( $args->{'allow_dirty'} // '' ) eq '1'
        )
        ? 1
        : 0;
    my @dirty_warning;    ## populated by the dirty check, printed late ##

    ## repo the cloud session clones : this server's repo unless told       ##
    ## otherwise [ the env override exists so tests can point the tool at a ##
    ## throwaway git repo ]                                                 ##
    my $repo = $ENV{'PROTOCOL_7_MCP_CLOUD_REPO'} // $ROOT_PATH;
    return send_tool_result( $id, "cloud repo not found: $repo", 1 )
        if not -d $repo;

    ## github remote : the CLI decides clone-vs-upload by `git remote       ##
    ## get-url origin` in ITS cwd [ verified in the 2.1.301 bundle : "no    ##
    ## GitHub remote was detected … Check that `git remote get-url origin`  ##
    ## returns a GitHub URL." ] — this checkout has no 'origin' on purpose  ##
    ## [ the github remote is 'hub' ] and >100MB, so a session started here ##
    ## would upload a single squashed snapshot without history or remote.   ##
    ## the dispatch therefore runs from a small dedicated launch clone      ##
    ## [ prepared below ] whose origin IS the github url.                   ##
    my $remote = $args->{'remote'} // $ENV{'PROTOCOL_7_MCP_CLOUD_REMOTE'}
        // 'hub';
    return send_tool_result( $id, "invalid remote '$remote'", 1 )
        if $remote !~ m{\A[A-Za-z0-9][A-Za-z0-9._/-]*\z}
        or index( $remote, '..' ) >= 0;

    my ( $url_out, $url_err )
        = _cloud_run_list( [ qw| git remote get-url |, $remote ], 30, $repo );
    my ($hub_url) = split m{\n}, $url_out // '';
    return send_tool_result(
        $id,
        "cannot read the url of remote '$remote' — is "
            . "this a checkout of the github repo? [ $url_err ]",
        1
    ) if defined $url_err or not length $hub_url;
    return send_tool_result(
        $id,
        "remote '$remote' is '$hub_url', not a GitHub URL — claude "
            . '--cloud checks `git remote get-url origin` and would not '
            . 'clone from github, falling back to uploading the local '
            . 'tree as a squashed snapshot ; refusing',
        1
    ) if not _cloud_is_github_url($hub_url);

    ## branch : param, else the repo current branch [ detached HEAD has ##
    ## none — then the caller must pass branch explicitly ]             ##
    my $branch = $args->{'branch'} // '';
    if ( length $branch
        and $branch !~ m{\A[A-Za-z0-9][A-Za-z0-9._/-]*\z} ) {
        return send_tool_result( $id,
            "branch '$branch' does not look like a git branch name", 1 );
    }
    if ( not length $branch ) {
        my ( $b_out, $b_err )
            = _cloud_run_list( [qw| git branch --show-current |], 30, $repo );
        return send_tool_result( $id,
            "cannot determine current branch : $b_err", 1 )
            if defined $b_err;
        ($branch) = split m{\n}, $b_out // '';
        $branch //= '';
    }
    return send_tool_result( $id,
        'cannot determine the branch — pass branch explicitly', 1 )
        if not length $branch;

    ## start commit : the branch tip                  ##
    ## [ HEAD when defaulting to the current branch ] ##
    my $verify_ref = length( $args->{'branch'} // '' ) ? $branch : 'HEAD';
    my ( $sha_out, $s_err )
        = _cloud_run_list(
        [ qw| git rev-parse --verify --quiet |, $verify_ref ],
        30, $repo );
    my $sha
        = ( not defined $s_err )
        ? ( split m{\n}, $sha_out // '' )[0] // ''
        : '';
    return send_tool_result(
        $id,
        "cannot resolve a commit for branch '$branch'"
            . ' [ is it fetched locally? ]',
        1
    ) if not length $sha;

    ## cloud sessions clone the REMOTE repo : local-only commits would   ##
    ## silently vanish there, so refuse instead of dispatching a session ##
    ## that works on stale code                                          ##
    my $range
        = length( $args->{'branch'} // '' )
        ? "$branch\@{u}..$branch"
        : '@{u}..HEAD';
    my ( $unpushed, $u_err )
        = _cloud_run_list(
        [ qw| git -c color.ui=false log --oneline --no-color |, $range ],
        30, $repo );
    return send_tool_result(
        $id,
        "push first : branch '$branch' has no upstream on the remote — "
            . 'push it before dispatching [ a cloud session clones the '
            . 'remote and would not even see the branch ]',
        1
    ) if defined $u_err;
    return send_tool_result(
        $id,
        "push first : branch '$branch' has local commits the remote "
            . "has not seen — push them before dispatching :\n$unpushed",
        1
    ) if length $unpushed;

    ## dirty-tree refusal : without the Claude GitHub App on the repo,      ##
    ## claude --cloud does not clone — it UPLOADS the local tree as a       ##
    ## bundle, uncommitted tracked changes included, so refuse by default ; ##
    ## allow_dirty=true is the explicit opt-in [ warned in the reply ]      ##
    my ( $dirty, $d_err ) = _cloud_run_list(
        [qw| git -c color.ui=false status --porcelain --untracked-files=no |],
        30, $repo
    );
    return send_tool_result(
        $id,
        'uncommitted changes in tracked files : commit or stash them '
            . 'first [ without the Claude GitHub App on the repo, '
            . "claude --cloud uploads the local tree including them ]"
            . (
            defined $d_err
            ? " [ cleanliness check itself failed: $d_err — refusing "
                . 'rather than risk leaking uncommitted work ]'
            : "\n$dirty"
            ),
        1
        )
        if ( not $allow_dirty and length $dirty )
        or defined $d_err;
    push @dirty_warning,
        'warning: allow_dirty=true with uncommitted changes in tracked files '
        . '— without the Claude GitHub App, claude --cloud can upload '
        . 'the local tree including them'
        if $allow_dirty and length $dirty;

    ## launch clone prepare [ see the remote check above ] : created on     ##
    ## first use as a blobless no-checkout clone [ --filter=blob:none —     ##
    ## commits+trees only : the cheapest clone that still is a real repo    ##
    ## with full history ; the blob a sparse CLAUDE.md checkout needs       ##
    ## arrives on demand. against a local test remote the filter is ignored ##
    ## with a warning — harmless ]. before EVERY dispatch : fetch the       ##
    ## branch, point HEAD at exactly the dispatched commit                  ##
    ## [ update-ref + symbolic-ref — no full checkout ], keep a sparse      ##
    ## one-file worktree so the repo looks ordinary [ clean `git status` ], ##
    ## then CONFIRM origin is a github url and HEAD is the dispatched       ##
    ## commit — refuse with nothing started otherwise                       ##
    ## PROTOCOL_7_MCP_CLOUD_LAUNCH_DIR : another place                      ##
    ## [ tests -- they never touch the real launch clone ]                  ##
    my $launch_dir = $ENV{'PROTOCOL_7_MCP_CLOUD_LAUNCH_DIR'}
        // "$ROOT_PATH/data/state/cloud-launch/protocol-7";
    if ( not -d "$launch_dir/.git" ) {
        ( my $launch_parent = $launch_dir ) =~ s{/+[^/]+/*\z}{};
        eval { make_path($launch_parent) } if not -d $launch_parent;
        my ( $clone_out, $clone_err, $clone_code ) = _cloud_run_list(
            [   'git',                'clone',
                '--filter=blob:none', '--no-checkout',
                $hub_url,             $launch_dir
            ],
            300
        );
        return send_tool_result(
            $id,
            "failed to create the launch clone at $launch_dir : "
                . (
                defined $clone_err
                ? $clone_err
                : 'exit code ' . ( $clone_code // '?' )
                ),
            1
        ) if not -d "$launch_dir/.git";
    }

    ## the launch dir outlives remote url changes                          ##
    ## [ tests point the tool at different throwaway repos ] — keep origin ##
    ## in sync ; a failure here still trips the pre-start confirm below    ##
    my ( $lo_out, $lo_err )
        = _cloud_run_list( [qw| git remote get-url origin |], 30,
        $launch_dir );
    my ($launch_origin) = split m{\n}, $lo_out // '';
    _cloud_run_list( [ qw| git remote set-url origin |, $hub_url ],
        30, $launch_dir )
        if not defined $lo_err
        and length $launch_origin
        and $launch_origin ne $hub_url;

    my ( $lf_out, $lf_err, $lf_code )
        = _cloud_run_list( [ qw| git fetch origin |, $branch ],
        120, $launch_dir );
    return send_tool_result(
        $id,
        "launch clone could not fetch '$branch' : "
            . ( defined $lf_err ? $lf_err : "exit code $lf_code" ),
        1
        )
        if defined $lf_err
        or ( $lf_code // 1 ) != 0;

    my ( $lu_out, $lu_err, $lu_code )
        = _cloud_run_list(
        [ qw| git update-ref |, "refs/heads/$branch", $sha ],
        30, $launch_dir );
    return send_tool_result(
        $id,
        "launch clone could not be pointed at '$sha' : "
            . ( defined $lu_err ? $lu_err : "exit code $lu_code" ),
        1
        )
        if defined $lu_err
        or ( $lu_code // 1 ) != 0;

    _cloud_run_list( [ qw| git symbolic-ref HEAD |, "refs/heads/$branch" ],
        30, $launch_dir );

    ## sparse one-file worktree : the cloud session clones from github    ##
    ## itself — the launch repo only needs to look ordinary               ##
    ## [ clean `git status` ] and carry CLAUDE.md for the conventions. -f ##
    ## keeps the file in sync when the branch moves                       ##
    ## [ a plain checkout preserves the stale file as a local change ]    ##
    _cloud_run_list( [qw| git sparse-checkout set CLAUDE.md |],
        60, $launch_dir );
    _cloud_run_list( [ qw| git checkout -qf |, $branch ], 120, $launch_dir );

    ## pre-start confirm : refuse with nothing started unless the launch ##
    ## clone's origin is a github url and HEAD is exactly the dispatched ##
    ## commit [ the whole point of the launch clone ]                    ##
    my ( $o_out, $o_err )
        = _cloud_run_list( [qw| git remote get-url origin |], 30,
        $launch_dir );
    my ($origin_now) = split m{\n}, $o_out // '';
    return send_tool_result(
        $id,
        "launch clone origin '"
            . ( $origin_now // '' )
            . "' is not a GitHub URL — refusing to start anything "
            . '[ claude --cloud would fall back to uploading the local '
            . 'tree as a squashed snapshot ]',
        1
        )
        if defined $o_err
        or not _cloud_is_github_url( $origin_now // '' );
    my ( $h_out, $h_err )
        = _cloud_run_list( [qw| git rev-parse HEAD |], 30, $launch_dir );
    my ($launch_head) = split m{\n}, $h_out // '';
    return send_tool_result(
        $id,
        "launch clone HEAD '"
            . ( $launch_head // '' )
            . "' is not the dispatched commit '$sha' "
            . '— refusing to start anything',
        1
    ) if ( $launch_head // '' ) ne $sha;

    ## fixed preamble + the untrusted task : the WHOLE text is the cloud ##
    ## session description — one argv element, list-form exec keeps it   ##
    ## intact all the way into the claude process                        ##
    my $full_prompt = join "\n",
        '[ protocol-7 cloud dispatch ]',
        'you are working in a cloud clone of the protocol-7 '
        . 'repository [ github nailara-technologies/protocol-7 ].',
        "start from branch '$branch' at commit '$sha'.",
        'BEFORE any work, prove the push path [ a session once worked '
        . 'on a snapshot without a remote and could not deliver ] :',
        '1. `git remote -v` : without a remote that has write '
        . 'access, attach the github repository with write access first.',
        "2. fetch '$branch' and confirm commit '$sha' is in the history -- "
        . 'on a single snapshot commit without history, stop and report.',
        "3. create the branch 'dev/<topic>' from '$sha' and push it right "
        . 'away, still empty -- only then start the task.',
        'read CLAUDE.md first and follow its conventions.',
        "note: push only to 'dev/<topic>', never to '$branch' ; do not "
        . 'merge to the default branch.',
        'finish with the pushed dev branch plus a summary of what changed.',
        '',
        'task :',
        $prompt;

    my @cmd = ( 'claude', sprintf( '--cloud=%s', $full_prompt ) );
    push @cmd, '--environment', $args->{'environment'}
        if length( $args->{'environment'} // '' );

    ## claude --cloud refuses without a terminal [ '--cloud requires an    ##
    ## interactive terminal' -- piped stdout counts as non-interactive ] : ##
    ## run it inside a pseudo-terminal via script                          ##
    ## [ bsdutils, debian priority required ]. script -c takes ONE shell   ##
    ## string, so every argv element is single-quoted, a quote inside      ##
    ## becomes '\'' -- the task text never reaches the shell unquoted      ##
    my ($script_bin) = grep { -f and -x }
        map {"$_/script"} grep {length} split m{:}, $ENV{'PATH'} // '';
    if ( defined $script_bin ) {
        my $shell_cmd = join q{ }, map {
            ( my $arg = $_ ) =~ s{'}{'\\''}g;
            "'$arg'"
        } @cmd;
        @cmd = ( $script_bin, qw| -q -e -c |, $shell_cmd, qw| /dev/null | );
    }

    log_msg( '[claude_cloud] dispatch : branch=%s sha=%s repo=%s launch=%s',
        $branch, $sha, $repo, $launch_dir );

    ## DETACHED start [ kimi_dispatch model ] : the claude process gets its ##
    ## own session, stdin from /dev/null, stdout+stderr to a capture file   ##
    ## under data/state/ — it is NEVER killed by this server and keeps      ##
    ## running after this tool returns, so this single-threaded server is   ##
    ## not held hostage for the whole cloud run [ the old qx()-until-EOF    ##
    ## shape would have blocked every other tool call for up to 30 minutes  ##
    ## and then killed the cloud client at the alarm ]  script runs its -c  ##
    ## string with $SHELL : a plain posix sh                                ##
    local $ENV{'SHELL'} = '/bin/sh';
    my $run = _cloud_fork_run( \@cmd, $launch_dir );
    return send_tool_result( $id, $run->{'error'}, 1 )
        if length( $run->{'error'} // '' );
    my $gpid = $run->{'gpid'};
    my $path = $run->{'tmp_out'};

    ## bounded early-return poll : read the capture file and return AS SOON ##
    ## AS a session id / claude.ai/code url is parseable from it ; after    ##
    ## the cap, hand the capture file to claude_cloud_status instead of     ##
    ## blocking on                                                          ##
    my $poll_cap = $ENV{'PROTOCOL_7_MCP_CLOUD_POLL'} // 60;
    $poll_cap = 1 if $poll_cap < 1;
    my $t0     = Time::HiRes::time();
    my $raw    = '';
    my $status = 'starting';
    my ( $url, $session_id );
    while (1) {
        $raw = _slurp_raw($path);
        ( $url, $session_id ) = _cloud_parse_ids($raw);
        if ( defined $url or length $session_id ) {
            $status = 'started';
            last;
        }
        ## the trust dialog blocks forever on stdin /dev/null and never     ##
        ## creates a session : kill the spawned process                     ##
        ## [ its own session — the negative pid takes the whole group ] and ##
        ## report not started                                               ##
        if ( _cloud_trust_prompt_seen($raw) ) {
            $status = 'trust_prompt';
            kill( 'TERM', -$gpid );
            select( undef, undef, undef, 0.2 );
            kill( 'KILL', -$gpid ) if kill( 0, $gpid );
            log_msg( '[claude_cloud] trust dialog seen — killed %d', $gpid );
            last;
        }
        if ( not kill( 0, $gpid ) ) {
            $status = 'finished_no_id';
            last;
        }
        last if Time::HiRes::time() - $t0 >= $poll_cap;
        select( undef, undef, undef, 0.25 );
    }

    my @lines = (
        sprintf(
            'status=%s tool=claude_cloud_dispatch pid=%d',
            $status, $gpid
        ),
        $status eq 'trust_prompt'
        ? 'claude is waiting on the ONE-TIME workspace trust dialog — NOT '
            . 'STARTED, NOTHING BILLED [ the spawned process was killed ]'
        : (         $status eq 'finished_no_id'
                and $raw =~ m{requires an interactive terminal} )
        ? 'claude refused BEFORE creating a session [ no '
            . 'terminal ] — nothing started, nothing billed.'
        : $status eq 'finished_no_id'
        ? 'claude exited without a session id — check claude.ai/code before '
            . 'any retry [ a session may exist ; never retry blindly ].'
        : ( $status eq 'started' and length $session_id )
        ? 'cloud session dispatched via `claude --cloud <task>` '
            . '— this STARTED A BILLED claude.ai cloud session.'
        : $status eq 'started'
        ? 'a claude.ai/code url was seen but no session id parsed — a cloud '
            . 'session very likely EXISTS and IS BILLED ; confirm via '
            . 'claude_cloud_status(capture_file="'
            . $path . '").'
        : 'the session MAY BE STARTING — no claude.ai/code url or session id '
            . 'was parsed within the poll cap ; check with '
            . 'claude_cloud_status(capture_file="'
            . $path
            . '") before assuming anything started '
            . '[ nothing confirmed billed ].',
        "branch: $branch",
        "commit: $sha",
        "launch_clone: $launch_dir",
        "launch_clone_head: $launch_head",
        "capture_file: $path",
        'the claude process is DETACHED [ own session, stdin /dev/null ] — '
            . 'it keeps running after this reply and is never killed by this '
            . 'server.',
    );
    if ( $status eq 'starting' ) {
        push @lines,
            sprintf(
            'no claude.ai/code url or session id in the '
                . 'capture file yet [ polled %.1fs of the %ds cap ]',
            Time::HiRes::time() - $t0, $poll_cap
            ),
            'recover the url later: claude_cloud_status(capture_file="'
            . $path . '")';
    } elsif ( $status eq 'trust_prompt' ) {
        push @lines, '',
            'one-time fix : run, as the repo '
            . 'owner, ONCE, in the launch clone :', '',
            "    cd $launch_dir \&\& claude", '',
            "answer the folder prompt with '1' [ Yes, proceed ] and the "
            . 'project MCP server prompt with No',
            '[ the launch claude only creates the session '
            . '— it never runs the project mcp server ]',
            'then re-run claude_cloud_dispatch.';
    } elsif ( $status eq 'finished_no_id' ) {
        push @lines,
            'the claude process already exited without '
            . 'producing a session id — see the raw output below';
    }
    push @lines, length $session_id
        ? "session_id: $session_id"
        : 'session_id: NOT parsed from output [ tolerant regexes, '
        . 'exact format not guaranteed — see raw output below ]';
    push @lines, defined $url
        ? "url: $url"
        : 'url: NOT parsed from output [ tolerant regexes, '
        . 'exact format not guaranteed — see raw output below ]';

    ## per-session tuning follow-ups : each requested setting is its own    ##
    ## message [ `claude -p "/<cmd>" --cloud <id> --output-format json` —   ##
    ## documented to queue one message into the running session and exit ;  ##
    ## json shapes {ok,...} / {ok:false, session_id, error} ]. only when an ##
    ## id was parsed : a still-starting session gets the exact commands to  ##
    ## send later instead. order : effort, model, fast                      ##
    ## [ fast last because it toggles — irreversible blind flip ]           ##
    my @tuning_report;
    if (    $status ne 'trust_prompt'
        and not length $session_id
        and ( length $effort or length $model or $fast ) ) {
        my @later;
        push @later, "/effort $effort" if length $effort;
        push @later, "/model $model"   if length $model;
        push @later, "/fast"           if $fast;
        push @lines, '',
            'session tuning SKIPPED : no session id '
            . 'parsed yet — the session is still starting.',
            'send later, one message per command, in this order :', map {
            sprintf 'claude -p "%s" --cloud '
                . '<session-id> --output-format json', $_
            } @later;
    } elsif ( length $session_id
        and ( length $effort or length $model or $fast ) ) {
        my @followups;
        push @followups, "/effort $effort" if length $effort;
        push @followups, "/model $model"   if length $model;
        push @followups, "/fast"           if $fast;
        for my $slash (@followups) {
            my ( $out, $f_err ) = _cloud_run_list(
                [   'claude',    '-p',
                    $slash,      '--cloud',
                    $session_id, '--output-format',
                    'json'
                ],
                60, $repo
            );
            my $data
                = ( not defined $f_err and length $out )
                ? eval { $json->decode($out) }
                : undef;
            my $verdict;
            if ( defined $f_err ) {
                $verdict = "error [ $f_err ]";
            } elsif ( ref $data eq 'HASH' and defined $data->{'ok'} ) {
                $verdict
                    = $data->{'ok'}
                    ? 'ok'
                    : 'error [ '
                    . ( $data->{'error'} // 'no error detail' ) . ' ]';
            } else {
                $verdict = "unparseable reply [ $out ]";
            }
            push @tuning_report,
                sprintf( 'follow-up %s : %s', $slash, $verdict );
            log_msg( '[claude_cloud] follow-up %s : %s', $slash, $verdict );
        }
        push @lines, '', 'session tuning follow-ups :', @tuning_report;
    }

    push @lines, @dirty_warning if @dirty_warning;
    push @lines, '', 'raw output :', _cloud_plain_text($raw);

    ## error only when the CLI itself reported an Error and nothing ##
    ## parseable came out — a bare parse miss                       ##
    ## [ or a still-starting session ] is never an error            ##
    my $is_err
        = ( $status eq 'finished_no_id' and $raw =~ m{^\s*Error:}m )
        ? 1
        : 0;
    send_tool_result( $id, join( "\n", @lines ), $is_err );
}

## double-fork a claude cloud worker DETACHED                              ##
## [ _kimi_fork_run shape, minus the session-dir scan ] : the intermediate ##
## child is reaped at once, the real worker is orphaned to init            ##
## [ no zombies, no SIGCHLD games ] and gets its own session via setsid so ##
## it survives anything that happens to this server ; its pid lands in     ##
## <capture>.pid for liveness checks                                       ##
sub _cloud_fork_run {
    my ( $cmd, $cwd ) = @ARG;

    my $state_dir = "$ROOT_PATH/data/state";
    eval { make_path($state_dir) } if not -d $state_dir;

    ## per-dispatch capture file, named like the kimi capture files [      ##
    ## kimi-dispatch-<pid>-<epoch>.out -> claude-cloud-<pid>-<epoch>.out ] ##
    my $tmp_out = sprintf '%s/claude-cloud-%d-%.6f.out',
        $state_dir, $PID, Time::HiRes::time();
    my $pid_file = "$tmp_out.pid";

    my $pid = fork();
    if ( not defined $pid ) {
        return { 'error' => "fork failed: $OS_ERROR" };
    }
    if ( $pid == 0 ) {
        my $gpid = fork();
        POSIX::_exit(1) if not defined $gpid;
        if ( $gpid == 0 ) {
            ## worker : own session, stdio to the capture file, then  ##
            ## straight into claude — never returns to perl code here ##
            POSIX::setsid();
            open( STDIN,  '<',  '/dev/null' );
            open( STDOUT, '>',  $tmp_out ) or POSIX::_exit(1);
            open( STDERR, '>&', \*STDOUT );
            chdir($cwd) if defined $cwd and length $cwd;
            exec( @{$cmd} );      ## list-form : no shell, no requoting ##
            POSIX::_exit(127);    ## reached only when exec fails    ##
        }
        ## intermediate child : hand the worker pid to the parent, exit  ##
        if ( open( my $pfh, '>', $pid_file ) ) {
            print $pfh $gpid;
            close $pfh;
        }
        POSIX::_exit(0);
        ## in a forked child of the mcp server process ##
    }
    waitpid( $pid, 0 );    ## intermediate child exits immediately ##

    my $gpid = '';
    if ( open( my $pfh, '<', $pid_file ) ) {
        $gpid = <$pfh> // '';
        close $pfh;
    }
    chomp $gpid;
    if ( $gpid !~ m{^\d+$} or $gpid < 2 ) {
        unlink $tmp_out, $pid_file;
        return { 'error' => 'failed to start detached claude cloud worker' };
    }
    return {
        'gpid'     => $gpid,
        'tmp_out'  => $tmp_out,
        'pid_file' => $pid_file
    };
}

## raw-byte slurp of a capture file [ tolerant of a missing or still-open ##
## file : both yield whatever exists, possibly '' ]                       ##
sub _slurp_raw {
    my ($path) = @_;
    return '' if not defined $path or not -f $path;
    if ( open( my $fh, '<:raw', $path ) ) {
        local $/ = undef;
        my $content = <$fh> // '';
        close $fh;
        return $content;
    }
    return '';
}

## tolerant session id + url extraction, shared by the dispatch poll and   ##
## claude_cloud_status : the exact --cloud output format is not guaranteed ##
## [ and unobserved without a real billed run ], so this accepts the       ##
## documented url shape, the documented session_/cse_ id shapes, a plain   ##
## uuid, and a loose 'session id : X' line — and happily returns nothing   ##
## terminal output -> plain text : csi \ osc escape sequences and carriage ##
## returns go [ claude runs inside a pseudo-terminal via script ]          ##
sub _cloud_plain_text {
    my ($text) = @_;
    $text //= q{};
    ## the capture is raw bytes off the pty : decode first so valid utf-8 ##
    ## survives intact                                                    ##
    ## [ no mojibake or mangled multibyte chars in the reply ] ; lone     ##
    ## invalid bytes fall back to the replacement char. already-decoded   ##
    ## input [ cloud_status runs the capture through this twice ] is left ##
    ## untouched — pure-ascii stays flag-off and re-decodes harmlessly    ##
    $text = decode( 'UTF-8', $text, Encode::FB_DEFAULT )
        if not utf8::is_utf8($text);
    ## cursor-forward BEFORE the generic csi strip : the cli redraws reach ##
    ## past earlier columns with it — dropping the escape would glue the   ##
    ## redrawn text onto stale columns. bare \e[C is one column            ##
    $text =~ s{\e\[([0-9]*)C}{ ' ' x ( length $1 ? $1 : 1 ) }ge;
    ## osc [ titles, links ] ##
    $text =~ s{\e\][^\a\e]*(?:\a|\e\\)}{}g;
    ## csi [ colour, cursor ] ##
    $text =~ s{\e\[[0-9;?<>=]*[ -/]*[\x40-\x7e]}{}g;
    ## charset selection      ##
    $text =~ s{\e[()][0-9A-Za-z]}{}g;
    ## keypad \ cursor save   ##
    $text =~ s{\e[=>78]}{}g;
    $text =~ s{\r\n?}{\n}g;
    return $text;
}

## the ONE-TIME workspace trust dialog : claude prints it the first time it ##
## runs from a directory it has not seen [ the pty makes it interactive ;   ##
## with stdin /dev/null it would wait forever, no session created, nothing  ##
## billed ]. exact prompt text verified in the installed cli bundle [ "Do   ##
## you trust the files in this folder?" with "Yes, proceed" \ "No, exit"    ##
## options ]. when the dispatch poll sees it, the spawned process is killed ##
## and the reply tells the owner the one-time fix                           ##
sub _cloud_trust_prompt_seen {
    my ($raw) = @_;
    return 0 if not length $raw;
    return _cloud_plain_text($raw)
        =~ m{Do you trust the files in this folder\?} ? 1 : 0;
}

sub _cloud_parse_ids {
    my ($raw) = @_;
    $raw = _cloud_plain_text($raw);    ## a pty adds colour \ cursor codes ##
    my ($url) = $raw =~ m{(https?://claude\.ai/code/[^\s"'<>)]*)}i;
    my $session_id = '';
    if ( defined $url and $url =~ m{/code/([A-Za-z0-9._-]+)} ) {
        $session_id = $1;
    } elsif ( $raw =~ m{\b((?:session|cse)_[A-Za-z0-9][A-Za-z0-9._-]{5,})\b} )
    {
        $session_id = $1;    ## documented cloud session id shapes      ##
    } elsif ( $raw
        =~ m|\b([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\b|i
    ) {
        $session_id = $1;
    } elsif ( $raw
        =~ m{\b(?:session[ _-]*id|id)\s*[:=]\s*([A-Za-z0-9][A-Za-z0-9._-]{5,})\b}i
    ) {
        $session_id = $1;
    }
    return ( $url, $session_id );
}

## read a cloud session back, two independent read-only readers : [ 1 ]     ##
## capture_file [ a path from a claude_cloud_dispatch reply ] — its size,   ##
## any id/url parsed from it so far, and its tail ; recovers the url of a   ##
## session that was still starting when the dispatch returned [ 2 ]         ##
## session_id — for ids that are NOT cloud ids : state from  `claude agents ##
## --json` [ documented as "for scripting; does not require a tty" ] +      ##
## recent terminal output from `claude logs <id>`                           ##
## [ prints the session recent terminal output ]. a CLOUD session id        ##
## [ session_… / cse_… ] never reaches those readers — they only know LOCAL ##
## background sessions and answer misleadingly for a cloud id [ observed    ##
## 2026-10-16 on the first real cloud run : "no active or completed         ##
## background session matched this id" on a healthy session ] — the reply   ##
## says so plainly and prints the url + teleport hint instead.  nothing     ##
## here creates or bills anything                                           ##
sub tool_claude_cloud_status {
    my ( $id, $args ) = @ARG;

    my $session_id   = $args->{'session_id'}   // '';
    my $capture_file = $args->{'capture_file'} // '';
    return send_tool_result( $id,
        'session_id or capture_file is required', 1 )
        if not length $session_id and not length $capture_file;

    my $max_lines = $args->{'lines'} // 40;
    $max_lines = 200 if $max_lines > 200;
    $max_lines = 1   if $max_lines < 1;

    my @lines;

    ## [ 1 ] capture-file tail — the late-url recovery path ##
    if ( length $capture_file ) {
        if ( not -f $capture_file ) {
            push @lines, "capture_file: NOT found [ $capture_file ]";
        } else {
            my $raw = _cloud_plain_text( _slurp_raw($capture_file) );
            my ( $url, $parsed_id ) = _cloud_parse_ids($raw);
            my @all   = split m{\n}, $raw, -1;
            my $start = @all > $max_lines ? @all - $max_lines : 0;
            push @lines,
                sprintf(
                'capture_file: %s [ %d bytes ]',
                $capture_file, length $raw
                ),
                (
                length $parsed_id ? "session_id: $parsed_id"
                : 'session_id: NOT parsed from capture file yet'
                ),
                (
                defined $url ? "url: $url"
                : 'url: NOT parsed from capture file yet'
                ),
                sprintf( 'last %d lines:', $max_lines ),
                @all[ $start .. $#all ];
        }
    }

    ## [ 2 ] session_id — cloud ids are invisible to the local readers : ##
    ## say so plainly with the url + takeover hint instead of the        ##
    ## misleading "no session matched" the local readers answer for them ##
    if ( length $session_id
        and $session_id =~ m{\A(?:session|cse)_[A-Za-z0-9][A-Za-z0-9._-]*\z} )
    {
        push @lines, '' if @lines;
        push @lines,
              'cloud sessions are NOT visible to the local readers [ `claude '
            . 'agents` / `claude logs` only know LOCAL background '
            . 'sessions — querying them for a cloud id just yields the '
            . 'misleading "no session matched" reply ] : skipping ' . 'both.',
            "follow the session live : https://claude.ai/code/$session_id",
            "take it over interactively : claude --teleport $session_id "
            . '[ needs a clean tree + a real terminal — a manual step ]',
            'fetch the branch it pushed : claude_cloud_result( remote=…,',
            "    branch=… ) [ base defaults to the dispatch branch ]";
    } elsif ( length $session_id ) {
        my $repo = $ENV{'PROTOCOL_7_MCP_CLOUD_REPO'} // $ROOT_PATH;

        my $state = '';
        my ( $agents, $agents_err )
            = _cloud_run_list( [qw| claude agents --json |], 60, $repo );
        if ( not defined $agents_err and length $agents ) {
            ## agents output is raw bytes off the pipe ; $json is in ->utf8 ##
            ## mode and expects exactly that [ same contract as the other   ##
            ## $json->decode() call sites in this file ]                    ##
            my $list = eval { $json->decode($agents) };
            if ( not $EVAL_ERROR and ref $list eq 'ARRAY' ) {
                for my $entry ( @{$list} ) {
                    next unless ref $entry eq 'HASH';
                    my $blob = join ' ', map { $entry->{$ARG} // '' }
                        keys %{$entry};
                    next unless index( $blob, $session_id ) >= 0;
                    $state = sprintf 'active [ %s ]',
                        join ', ',
                        map { sprintf '%s=%s', $ARG, $entry->{$ARG} }
                        grep { not ref $entry->{$ARG} } sort keys %{$entry};
                    last;
                }
                $state
                    = 'no active or completed background session matched '
                    . 'this id [ yet — a just-started session appears '
                    . 'in the listing a moment after creation ]'
                    if not length $state;
            }
        }
        $state
            = 'unavailable [ claude agents --json failed: '
            . ( defined $agents_err ? $agents_err : 'unparseable output' )
            . ' ]'
            if not length $state;

        my ( $logs, $logs_err )
            = _cloud_run_list( [ qw| claude logs |, $session_id ], 60,
            $repo );

        push @lines, '' if @lines;
        push @lines, "state: $state";
        if ( defined $logs_err ) {
            push @lines, "recent output: failed to read [ $logs_err ]";
        } else {
            push @lines, 'recent output [ claude logs ] :', $logs;
        }
    }
    send_tool_result( $id, join( "\n", @lines ), 0 );
}

## fetch the RESULT of a cloud session : the dispatch preamble demands the  ##
## session finish with a pushed branch, so its work product shows up ONLY   ##
## as remote refs — nothing the local readers [ claude agents / logs ] can  ##
## see. read-only for the working tree : `git fetch <remote>`               ##
## [ list-form, remote-tracking refs only ] is the SOLE write allowed here  ##
## ; checkout / merge / reset are NEVER run. without branch : newest remote ##
## branches first [ name, date, subject ] so the session's branch can be    ##
## picked ; with branch : commits ahead, diffstat, and the newest commit    ##
## message in full [ the session summary often lives there ]                ##
sub tool_claude_cloud_result {
    my ( $id, $args ) = @ARG;

    my $branch = $args->{'branch'} // '';
    my $base   = $args->{'base'}   // '';
    my $remote = $args->{'remote'} // qw| hub |;

    ## repo the session cloned — same override as the other cloud tools   ##
    my $repo = $ENV{'PROTOCOL_7_MCP_CLOUD_REPO'} // $ROOT_PATH;
    return send_tool_result( $id, "cloud repo not found: $repo", 1 )
        if not -d $repo;

    ## name validation BEFORE any git call [ all three end up verbatim in ##
    ## git argv ; list-form exec keeps each one a single argument, but a  ##
    ## '..' range slip or a dash-led name would still confuse git itself  ##
    for my $pair (
        [ 'branch', $branch ],
        [ 'base',   $base ],
        [ 'remote', $remote ]
    ) {
        my ( $what, $name ) = @{$pair};
        next unless length $name;
        return send_tool_result(
            $id,
            "invalid $what '$name' : must match ^[A-Za-z0-9._/-]+\$, "
                . 'contain no .. and not start with a dash',
            1
            )
            if $name !~ m{\A[A-Za-z0-9._/-]+\z}
            or index( $name, q{..} ) >= 0
            or index( $name, q{-} ) == 0;
    }

    ## base default : the branch the dispatch started from                  ##
    ## [ the repo's current branch — claude_cloud_dispatch's own default ], ##
    ## else 'base'                                                          ##
    if ( not length $base and length $branch ) {
        my ( $b_out, $b_err )
            = _cloud_run_list( [qw| git branch --show-current |], 30, $repo );
        ($base) = split m{\n}, $b_out // '' if not defined $b_err;
        $base //= '';
        $base = qw| base | if not length $base;
    }

    ## the SOLE write : fetch brings the session's pushed branch into the ##
    ## remote-tracking refs ; the working tree + HEAD are never touched   ##
    my ( $f_out, $f_err, $f_code )
        = _cloud_run_list( [ qw| git -c color.ui=false fetch |, $remote ],
        60, $repo );
    return send_tool_result(
        $id,
        "git fetch $remote failed : " . ( defined $f_err ? $f_err : $f_out ),
        1
        )
        if defined $f_err
        or ( $f_code // 0 ) != 0;

    if ( not length $branch ) {
        ## branch picker : newest remote branches first, one per line    ##
        my $fmt = '%(refname:short)%09%(committerdate:iso8601)%09%(subject)';
        my ( $l_out, $l_err, $l_code ) = _cloud_run_list(
            [   'git',                   '-c',
                'color.ui=false',        'for-each-ref',
                '--sort=-committerdate', '--no-color',
                "refs/remotes/$remote/", '--count=15',
                "--format=$fmt"
            ],
            60, $repo
        );
        return send_tool_result(
            $id,
            'git for-each-ref failed : '
                . ( defined $l_err ? $l_err : $l_out ),
            1
            )
            if defined $l_err
            or ( $l_code // 0 ) != 0;
        send_tool_result(
            $id,
            join( "\n",
                "remote '$remote' : newest remote branches "
                    . '[ newest first — pick the session branch, then re-run',
                'with branch=<name> ] :',
                $l_out ),
            0
        );
        return;
    }

    my $remote_branch = "$remote/$branch";
    my @lines         = (
        "remote: $remote",
        "branch: $branch",
        "base: $base [ range $base..$remote_branch ]"
    );

    ## commits the session added on top of the base                     ##
    my ( $l_out, $l_err, $l_code ) = _cloud_run_list(
        [   qw| git -c color.ui=false log --oneline --no-color |,
            "$base..$remote_branch"
        ],
        60, $repo
    );
    if ( defined $l_err or ( $l_code // 0 ) != 0 ) {
        send_tool_result(
            $id,
            "git log failed [ bad base or branch? ] : "
                . ( defined $l_err ? $l_err : $l_out ),
            1
        );
        return;
    }
    push @lines, '', "commits ahead of $base :",
        ( length $l_out ? $l_out : '[ none — the branch is not ahead ]' );

    ## what changed relative to the merge-base                            ##
    my ( $d_out, $d_err ) = _cloud_run_list(
        [   qw| git -c color.ui=false diff --stat --no-color |,
            "$base...$remote_branch"
        ],
        60, $repo
    );
    push @lines, '', "diffstat $base...$remote_branch :";
    push @lines,
          defined $d_err ? "[ diffstat " . "failed : $d_err ]"
        : length $d_out  ? $d_out
        :                  '[ no changes ]';

    ## the newest commit message in full : the session summary often lives ##
    ## there                                                               ##
    my ( $m_out, $m_err ) = _cloud_run_list(
        [   qw| git -c color.ui=false log -1 --format=%B --no-color |,
            $remote_branch
        ],
        60, $repo
    );
    push @lines, '', "newest commit message [ $remote_branch ] :";
    push @lines,
          defined $m_err ? "[ message read failed : $m_err ]"
        : length $m_out  ? $m_out
        :                  '[ unreadable ]';

    send_tool_result( $id, join( "\n", @lines ), 0 );
}

## fork + detach a kimi-legacy dispatch WITHOUT blocking this server's      ##
## request loop, then give it a short bounded window to fail fast           ##
##                                                                          ##
## shape follows the established _dispatch_followup idiom [ redirect stdio, ##
## exec straight into kimi-legacy, never return to perl code in the worker  ##
## ], adapted to a DOUBLE fork : the intermediate child is reaped by the    ##
## parent at once and the real worker is orphaned to init.  that achieves   ##
## what _dispatch_followup's local $SIG{'CHLD'}='IGNORE' does               ##
## [ no zombies ] while still allowing liveness polling — a SIGCHLD         ##
## disposition of IGNORE only auto-reaps if it is still in effect when the  ##
## child dies, so a 'local'ed one would leak a zombie per dispatch once     ##
## restored, and a permanent one would break qx()/system() exit- status     ##
## handling elsewhere in this server. no SIGCHLD games at all here : init   ##
## reaps the worker, the parent never has to                                ##
sub _kimi_fork_run {
    my ( $cmd, $ext ) = @ARG;

    my $state_dir = "$ROOT_PATH/data/state";
    eval { make_path($state_dir) } if not -d $state_dir;

    ## per-dispatch capture file [ NOT the shared followup log ] : read    ##
    ## back on the synchronous fast-completion path, and pointed at in the ##
    ## async reply so the raw stream stays findable while it grows         ##
    my $tmp_out = sprintf '%s/kimi-dispatch-%d-%.6f.out',
        $state_dir, $PID, Time::HiRes::time();
    my $pid_file = "$tmp_out.pid";

    ## snapshot existing kimi session dirs : a FRESH kimi_dispatch makes   ##
    ## kimi-legacy create ~/.kimi/sessions/<hash>/<uuid>/ about a second   ##
    ## after start                                                         ##
    ## [ measured 2026-09-08 : dir at 1.1s vs first real stdout at 16.6s ] ##
    ## — long before its first output line and well inside the bounded     ##
    ## window below, so the new session's uuid is recoverable by diffing   ##
    ## against this snapshot instead of grepping logs afterwards           ##
    my $home = $ENV{'HOME'} // ( getpwuid($<) )[7] // '';
    my $sess_glob
        = "$home/.kimi/sessions/*/????????-????-????-????-????????????";
    my %sessions_before = map { $ARG => 1 } glob($sess_glob);

    my $pid = fork();
    if ( not defined $pid ) {
        return { 'error' => "fork failed: $OS_ERROR" };
    }
    if ( $pid == 0 ) {
        my $gpid = fork();
        POSIX::_exit(1) if not defined $gpid;
        if ( $gpid == 0 ) {
            ## worker : same stdio setup as _dispatch_followup, but ##
            ## stdout+stderr go to this dispatch's OWN capture file ##
            open( STDIN,  '<',  '/dev/null' );
            open( STDOUT, '>',  $tmp_out ) or POSIX::_exit(1);
            open( STDERR, '>&', \*STDOUT );
            ## alarm() survives exec [ ITIMER_REAL is kept across exec, the ##
            ## handler resets to SIG_DFL = terminate ] : preserves the old  ##
            ## qx()+alarm cap so a detached runaway still dies at the       ##
            ## tool's configured timeout instead of forever                 ##
            alarm( $ext->{'timeout'} // 120 );
            ## single-string exec = same shell run as qx($cmd) ; only  ##
            ## returns on failure [ 'or' form also keeps perl -c quiet ##
            ## about the intentional unreachable-after-success _exit ] ##
            exec($cmd) or POSIX::_exit(127);
        }
        ## intermediate child : hand the worker's pid to the parent, then   ##
        ## exit immediately [ the parent waitpid()s us below; the worker is ##
        ## orphaned and reaped by init when it finishes ]                   ##
        if ( open( my $pfh, '>', $pid_file ) ) {
            print $pfh $gpid;
            close $pfh;
        }
        POSIX::_exit(0);    ## _exit, not exit : never flush/run destructors
        ## in a forked child of the protocol process
    }
    waitpid( $pid, 0 );     ## returns at once : intermediate child exits fast

    my $gpid = '';
    if ( open( my $pfh, '<', $pid_file ) ) {
        $gpid = <$pfh> // '';
        close $pfh;
        chomp $gpid;
    }
    if ( $gpid !~ m{^\d+$} or $gpid < 2 ) {
        unlink $tmp_out, $pid_file;
        return { 'error' => 'failed to start detached kimi-legacy worker' };
    }

    ## bounded fast-fail window [ 6s ] : exists ONLY so a near-instant     ##
    ## failure [ exec failure, immediate CLI usage error ] returns         ##
    ## synchronously with its real output instead of falsely claiming      ##
    ## "dispatched". it is NOT meant to catch normal completion — every    ##
    ## real kimi run takes minutes                                         ##
    ## [ even a one-word-prompt run took ~17s on 2026-09-08 ], so this cap ##
    ## should almost always be exceeded. 6s is long enough for a fresh     ##
    ## session's directory + uuid to appear [ ~1s, measured ] with wide    ##
    ## margin, short enough to be irrelevant next to any real run          ##
    my $wait_cap       = 6;
    my $wait_start     = Time::HiRes::time();
    my $finished       = 0;
    my $uuid           = '';
    my $uuid_ambiguous = 0;
    while ( Time::HiRes::time() - $wait_start < $wait_cap ) {
        if ( not kill( 0, $gpid ) ) {
            $finished = 1;
            last;
        }
        if ( not length $uuid and not $uuid_ambiguous ) {
            my @new_dirs
                = grep { not $sessions_before{$ARG} } glob($sess_glob);
            if ( @new_dirs == 1 ) {
                ($uuid) = $new_dirs[0] =~ m{/([^/]+)$};
            } elsif ( @new_dirs > 1 ) {
                ## a concurrent unrelated dispatch created a session in the ##
                ## same window — cannot attribute ours, stop trying         ##
                $uuid_ambiguous = 1;
            }
        }
        select( undef, undef, undef, 0.2 );
    }

    if ($finished) {
        ## worker already gone [ fast-fail path ] : its capture file is ##
        ## complete [ process exit flushed it ], read it back as the    ##
        ## synchronous result and clean up                              ##
        my $output = '';
        if ( open( my $fh, '<:raw', $tmp_out ) ) {
            local $/ = undef;
            $output = <$fh> // '';
            close $fh;
        }
        unlink $tmp_out, $pid_file;
        return { 'finished' => 1, 'output' => $output };
    }

    return {
        'finished' => 0,
        'gpid'     => $gpid,
        'tmp_out'  => $tmp_out,
        'uuid'     => $uuid,
    };
}

## immediate reply for a still-running detached kimi dispatch : makes the   ##
## session's resumability + polling path discoverable right away, since the ##
## real result only arrives later via kimi_check_status                     ##
sub _kimi_dispatch_async_reply {
    my ( $id, $args, $ext, $run ) = @ARG;

    ## kimi_continue already knows its uuid [ a required input param ] ; a ##
    ## fresh kimi_dispatch gets one from _kimi_fork_run's session-dir scan ##
    ## when it became visible inside the bounded window                    ##
    my $uuid
        = $ext->{'name'} eq 'kimi_continue'
        ? ( $args->{'session_id'} // '' )
        : ( $run->{'uuid'} // '' );

    my @lines = (
        sprintf(
            'status=dispatched_async tool=%s pid=%d',
            $ext->{'name'}, $run->{'gpid'}
        ),
        'the dispatch is running DETACHED — this call did not block the '
            . 'server waiting for it; other tool calls [ including '
            . 'kimi_check_status ] run normally while it works.',
        sprintf(
            'for proactive completion awareness instead of polling blind: '
                . 'bin/dev/notify-pid-gone %d & then verify with '
                . 'kimi_check_status once it reports the pid gone — a '
                . 'notification is a cue to check, never proof of success on '
                . 'its own.',
            $run->{'gpid'}
        ),
        'captured output [ raw kimi-legacy '
            . 'stdout+stderr, grows while it runs ]: '
            . $run->{'tmp_out'},
    );
    if ( length $uuid ) {
        push @lines,
            "session uuid: $uuid",
            "poll progress / recover the final result: "
            . "kimi_check_status(session_id=\"$uuid\")",
            "To resume this session: kimi -r $uuid";
    } else {
        ## fresh dispatch whose session dir was not attributable in time ##
        ## [ e.g. a concurrent unrelated dispatch in the same window ]   ##
        push @lines,
              'session uuid: not attributable yet at reply time. it shows up '
            . '~1s after kimi-legacy starts as the NEWEST directory '
            . 'under ~/.kimi/sessions/*/ [ match by creation time ], '
            . 'or in fresh lines of ~/.kimi/logs/kimi.log, and the '
            . 'capture file above ends with "To resume this session: '
            . 'kimi -r <uuid>" once the run finishes. then poll '
            . 'kimi_check_status(session_id=...) for the final result.';
    }
    push @lines,
          'note: auto_summarize/keep/template/create_template params only '
        . 'apply to a synchronously-finished run — there is nothing to '
        . 'summarize yet here, and kimi_check_status recovers the raw '
        . 'final text from the session wire.jsonl instead [ '
        . 'summarize-on-recovery is a noted follow-up, deliberately '
        . 'not half-implemented ].';

    log_msg( '[kimi_async] %s running detached [ pid=%d uuid=%s ]',
        $ext->{'name'}, $run->{'gpid'}, length $uuid ? $uuid : 'unknown' );
    send_tool_result( $id, join( "\n", @lines ), 0 );
    return;
}

## quick poll on a kimi session — the fast recovery path when the outer  ##
## harness reports a kimi_dispatch / kimi_continue call as failed at its ##
## ~1800s idle-silence watchdog while kimi-legacy keeps running. must    ##
## return well under 1800s : no blocking waits here at all               ##
sub tool_kimi_check_status {
    my ( $id, $args ) = @ARG;

    my $session_id = $args->{'session_id'} // '';
    return send_tool_result( $id, 'session_id is required', 1 )
        if not length $session_id;

    my $max_lines = $args->{'lines'} // 40;
    $max_lines = 200 if $max_lines > 200;
    $max_lines = 1   if $max_lines < 1;

    my $home     = $ENV{'HOME'} // ( getpwuid($<) )[7] // '';
    my $log_file = "$home/.kimi/logs/kimi.log";

    ## locate persisted session state : ~/.kimi/sessions/<hash>/<uuid>/ ##
    my ($session_dir)
        = grep { -d $ARG } glob("$home/.kimi/sessions/*/$session_id");
    my $wire_file = defined $session_dir ? "$session_dir/wire.jsonl" : undef;

    ## liveness, approach [a] : scan the process table — a resumed session  ##
    ## carries its uuid in argv  [ kimi-legacy -y --afk -r <uuid> -p ... ]. ##
    ## known false-positive window : an unrelated fresh dispatch whose      ##
    ## prompt text mentions the uuid also matches — acceptable, it is still ##
    ## a live kimi process referencing this session                         ##
    my $running_pid = 0;
    my $kimi_procs  = 0;
    for my $proc_line (qx| ps -eo pid,args 2>/dev/null |) {
        next unless index( $proc_line, 'kimi-legacy' ) >= 0;
        $kimi_procs++;
        if (    not $running_pid
            and $proc_line =~ m{^\s*(\d+)\s}
            and index( $proc_line, $session_id ) >= 0 ) {
            $running_pid = $1;
        }
    }

    ## unified activity corroboration : a live process alone is not proof   ##
    ## of an active session — a lingering idle sh -c wrapper can outlive    ##
    ## its completed turn by hours [ observed 2026-07-17 : zero cpu, idle   ##
    ## 4h40m after the result had already landed ]. both the argv pid-match ##
    ## and the fresh-dispatch fallback below funnel through the same        ##
    ## freshness gate : the session's own wire.jsonl must have been written ##
    ## recently, and a trailing TurnEnd event means done regardless of      ##
    ## process state                                                        ##
    my $wire_age;
    my $wire_fresh = 0;
    my $turn_ended = 0;
    if ( defined $wire_file and -f $wire_file ) {
        $wire_age   = time - ( stat($wire_file) )[9];
        $wire_fresh = $wire_age < 180 ? 1 : 0;
        my $tail_cmd   = sprintf 'tail -n 1 %s', quotemeta($wire_file);
        my $last_event = qx( $tail_cmd 2>/dev/null );
        $turn_ended = 1
            if index( $last_event // '', '"type": ' . '"TurnEnd"' ) >= 0;
    }

    ## fresh dispatches have no uuid in argv [ session created at runtime ] ##
    ## : fall back to any live kimi-legacy process, still subject to the    ##
    ## same freshness gate below                                            ##
    my $running = 0;
    $running = 1 if $running_pid;
    $running = 1 if not $running and $kimi_procs and $wire_fresh;

    ## the freshness gate itself : process alive but wire.jsonl stale or ##
    ## turn already ended = lingering wrapper, not a working session     ##
    my $stale_wrapper = 0;
    if ( $running
        and ( $turn_ended or ( defined $wire_age and not $wire_fresh ) ) ) {
        $stale_wrapper = 1 if $running_pid;
        $running       = 0;
    }

    my $resume_line = "To resume this session: kimi -r $session_id";

    if ($running) {
        ## still in progress : return recent session activity so the caller ##
        ## can see what it is doing without waiting it out                  ##
        my $log_tail = '';
        if ( -f $log_file ) {
            my $tail_cmd = sprintf 'grep -F -- %s %s | tail -n %d',
                quotemeta($session_id), quotemeta($log_file), $max_lines;
            $log_tail = qx( $tail_cmd 2>/dev/null );
        }
        my $header = sprintf 'status=running session=%s%s',
            $session_id,
            $running_pid ? " pid=$running_pid" : '';
        $header .= sprintf ' wire_last_write=%ds_ago', $wire_age
            if defined $wire_age;
        my $output = "$header\nrecent activity [ last $max_lines "
            . "lines ]:\n$log_tail\n$resume_line\n";
        return send_tool_result( $id, $output, 0 );
    }

    return send_tool_result(
        $id,
        "status=unknown session=$session_id : no live process and "
            . "no session state found under ~/.kimi/sessions/*/$session_id",
        1
    ) if not defined $session_dir;

    ## process gone : recover the final result from the session's own    ##
    ## persisted wire.jsonl — last ContentPart of payload type 'text' is ##
    ## the closing assistant message of the completed turn               ##
    my $final_text = '';
    if ( defined $wire_file and -f $wire_file ) {
        my $grep_cmd = sprintf
            'grep -F %s %s | grep -F %s | tail -n 1',
            quotemeta('"type": "ContentPart"'), quotemeta($wire_file),
            quotemeta('"type": "text"');
        my $last_text_line = qx( $grep_cmd 2>/dev/null );
        if ( length $last_text_line ) {
            ## qx under -C31 already utf8-decodes its output, but $json is ##
            ## in ->utf8 mode and expects raw bytes on decode [ same as    ##
            ## every other $json->decode() call in this file, which reads  ##
            ## its source via '<:raw' filehandles ] — re-encode first      ##
            my $event
                = eval { $json->decode( encode( 'UTF-8', $last_text_line ) ) };
            $final_text = $event->{'message'}{'payload'}{'text'} // ''
                if not $EVAL_ERROR and ref $event eq 'HASH';
        }
    }

    my $header = sprintf 'status=completed session=%s', $session_id;
    $header .= sprintf ' wire_last_write=%ds_ago', $wire_age
        if defined $wire_age;
    $header .= ' note=stale_wrapper_process_ignored' if $stale_wrapper;
    my $output
        = length $final_text
        ? "$header\n$final_text\n$resume_line\n"
        : "$header\n[ no final assistant text found in wire.jsonl — session "
        . "may have died mid-turn; resume to continue "
        . "]\n$resume_line\n";
    send_tool_result( $id, $output, 0 );
}

## =========================================================================
## logging [ stderr only — stdout is mcp protocol ]
## =========================================================================

sub log_msg {
    my $fmt = shift;
    my $msg = sprintf $fmt, @ARG;
    printf STDERR "[mcp-server-p7] %s\n", $msg;
}

