                    'type'        => 'integer',
                    'description' =>
                        'target summary length in tokens (default: 600)'
                }
            },
            'additionalProperties' => \0
        }
    },
    {   'name'        => 'p7_memory_update',
        'description' =>
            'review and update the protocol-7 development memory. '
