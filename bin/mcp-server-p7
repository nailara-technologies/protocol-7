            'type'       => 'object',
            'properties' => {
                'template' => {
                    'type'        => 'string',
                    'description' => 'optional context template '
                        . '[ e.g. "code-review", "integrate-recent" ]'
                },
                'work_dir' => {
                    'type'        => 'string',
                    'description' => 'working directory for agent '
                        . '[ default: system root path ]'
                },
                'priority' => {
                    'type'        => 'integer',
                    'description' =>
                        'scheduling priority (1-10, lower=higher)',
                    'default' => 5
                }
            },
            'additionalProperties' => \0
        }
    },
    {   'name'        => 'p7_agent_list',
        'description' =>
            'list active kimi-web sub-agents with status and metrics',
        'inputSchema' => {
            'type'       => 'object',
            'properties' => {
                'status' => {
                    'type'        => 'string',
                    'description' => 'optional status filter '
                        . '[ ready | starting | error ]'
                }
            },
            'additionalProperties' => \0
        }
    },
