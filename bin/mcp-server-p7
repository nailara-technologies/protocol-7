                    'enum'        => [ 'claude', 'kimi', 'both', 'auto' ],
                    'description' =>
                        'which memory to summarize [ claude | kimi | both | '
                        . 'auto ]. '
                        . 'auto detects from MCP client identity and '
                        . 'returns caller\'s own memory.'
                },
                'focus' => {
                    'type'        => 'string',
