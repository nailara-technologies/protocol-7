##[ load chat tool definitions ]##
{
    my $chat_tools_fn = do "$ROOT_PATH/modules/mcp.tools.chat";
    if ( ref $chat_tools_fn eq qw| CODE | ) {
        $chat_tools_fn->( \@tools );
    } elsif ($@) {
        log_msg( 'chat tools load error: %s', $@ );
    }
}

##[ register external tools ]##

for my $ext (@external_tools) {
    next if grep { $_->{'name'} eq $ext->{'name'} } @tools;

    my ( %props, @required );

    if ( defined $ext->{'params'} ) {
        for my $p ( @{ $ext->{'params'} } ) {
            my ( $name, $desc, $req ) = @$p;
            $props{$name} = {
                'type'        => 'string',
                'description' => $desc // '',
            };
            push @required, $name if $req;
        }
    } else {
        ## legacy format (1-2 params)
        $props{ $ext->{'param_name'} } = {
            'type'        => 'string',
            'description' => $ext->{'param_desc'} // '',
        };
        push @required, $ext->{'param_name'};
        if ( defined $ext->{'param2_name'} ) {
            $props{ $ext->{'param2_name'} } = {
                'type'        => 'string',
                'description' => $ext->{'param2_desc'} // '',
            };
            push @required, $ext->{'param2_name'};
        }
    }

    push @tools,
        {
        'name'        => $ext->{'name'},
        'description' => $ext->{'description'},
        'inputSchema' => {
            'type'                 => 'object',
            'properties'           => \%props,
            'required'             => \@required,
            'additionalProperties' => \0,
        },
        };
}

##[ main loop ]##

load_sticky_focus();

log_msg( 'mcp-server-p7 starting [ auth=%s socket=%s ]',
    $auth_user, $socket_path );

while ( my $line = <STDIN> ) {
    chomp $line;
    next unless length $line;

    my $msg = eval { $json->decode($line) };
    if ($EVAL_ERROR) {
        send_error( undef, -32700, 'parse error' );
        next;
    }

    my $id     = $msg->{'id'};
    my $method = $msg->{'method'} // '';
    my $params = $msg->{'params'} // {};

    ## notifications [ no id ] — absorb silently
    if ( not defined $id ) {
        log_msg( 'notification: %s', $method );
        next;
    }

    if ( $method eq 'initialize' ) {
        handle_initialize( $id, $params );
    } elsif ( $method eq 'tools/list' ) {
        handle_tools_list( $id, $params );
    } elsif ( $method eq 'tools/call' ) {
        handle_tools_call( $id, $params );
    } elsif ( $method eq 'ping' ) {
        send_result( $id, {} );
    } else {
        send_error( $id, -32601, "method not found: $method" );
    }

    check_chat_pending($last_tool_name);
}

log_msg('stdin closed, exiting');
cube_disconnect();
exit(0);

## =========================================================================
## mcp protocol handlers
## =========================================================================

sub handle_initialize {
    my ( $id, $params ) = @ARG;

    log_msg('initialize request received');
    $mcp_client_name = $params->{'clientInfo'}{'name'} // '';

    send_result(
        $id,
        {   'protocolVersion' => '2025-11-25',
            'capabilities'    => { 'tools' => {} },
            'serverInfo'      => {
                'name'    => 'mcp-server-p7',
                'version' => '0.1.0',
            }
        }
    );
}

sub handle_tools_list {
    my ( $id, $params ) = @ARG;
    send_result( $id, { 'tools' => \@tools } );
}

sub handle_tools_call {
    my ( $id, $params ) = @ARG;

    my $name = $params->{'name'}      // '';
    my $args = $params->{'arguments'} // {};

    check_chat_pending($name);
    $last_tool_name = $name;

    log_msg( 'tools/call: %s', $name );

    if ( $name eq 'p7_command' ) {
        tool_p7_command( $id, $args );
    } elsif ( $name eq 'p7_task_create' ) {
        tool_task_create( $id, $args );
    } elsif ( $name eq 'p7_task_show' ) {
        tool_task_show( $id, $args );
    } elsif ( $name eq 'p7_task_queue' ) {
        tool_task_queue( $id, $args );
    } elsif ( $name eq 'p7_task_complete' ) {
        tool_task_complete( $id, $args );
    } elsif ( $name eq 'p7_task_continue' ) {
        tool_task_continue( $id, $args );
    } elsif ( $name eq 'p7_agent_spawn' ) {
        tool_agent_spawn( $id, $args );
    } elsif ( $name eq 'p7_agent_list' ) {
        tool_agent_list( $id, $args );
    } elsif ( $name eq 'p7_agent_dispatch' ) {
        tool_agent_dispatch( $id, $args );
    } elsif ( $name eq 'p7_template_resolve' ) {
        tool_template_resolve( $id, $args );
    } elsif ( $name eq 'p7_zenka_start' ) {
        tool_zenka_start( $id, $args );
    } elsif ( $name eq 'p7_list_tools' ) {
        tool_list_tools( $id, $args );
    } elsif ( $name eq 'p7_call_tool' ) {
        tool_call_tool( $id, $args );
    } elsif ( $name eq 'p7_detected_agent' ) {
        tool_p7_detected_agent( $id, $args );
    } elsif ( $name eq 'p7_chat_send' ) {
        tool_p7_chat_send( $id, $args );
    } elsif ( $name eq 'p7_chat_read' ) {
        tool_p7_chat_read( $id, $args );
    } elsif ( $name eq 'p7_chat_summary' ) {
        tool_p7_chat_summary( $id, $args );
    } elsif ( $name eq 'p7_chat_search' ) {
        tool_p7_chat_search( $id, $args );
    } elsif ( $name eq 'p7_chat_channels' ) {
        tool_p7_chat_channels( $id, $args );
    } elsif ( $name eq 'p7_chat' ) {
        tool_p7_chat( $id, $args );
    } elsif ( $name eq 'coding_summarize' ) {
        tool_coding_summarize( $id, $args );
    } elsif ( $name eq 'session_catchup' ) {
        tool_session_catchup( $id, $args );
    } elsif ( $name eq 'store_summary_focus' ) {
        tool_store_summary_focus( $id, $args );
    } elsif ( $name eq 'p7_memory_summary' ) {
        tool_p7_memory_summary( $id, $args );
    } elsif ( $name eq 'p7_memory_update' ) {
        tool_p7_memory_update( $id, $args );
    } elsif ( $name eq 'p7_memory_search' ) {
        tool_p7_memory_search( $id, $args );
    } elsif ( $name eq 'p7_memory_digest' ) {
        tool_p7_memory_digest( $id, $args );
    } elsif ( my ($ext) = grep { $_->{'name'} eq $name } @external_tools ) {
        tool_external_command( $id, $args, $ext );
    } else {
        send_error( $id, -32602, "unknown tool: $name" );
    }
}

## =========================================================================
## chat tool implementations
## =========================================================================

sub tool_p7_chat_send {
    my ( $id, $args ) = @ARG;

    my $message = $args->{'message'} // '';
    return send_tool_result( $id, 'message is required', 1 )
        if not length $message;

    my $channel    = $args->{'channel'}    // '';
    my $model      = $args->{'model'}      // '';
    my $wait_reply = $args->{'wait_reply'} // undef;

    ( my $safe_msg = $message ) =~ s{\n}{ }g;

    my @cmd = ( "$ROOT_PATH/bin/chat", qw| -q | );
    push @cmd, '-channel', $channel if length $channel;
    push @cmd, '-model',   $model   if length $model;
    if ( defined $wait_reply ) {
        push @cmd, '-wait-reply';
        push @cmd, $wait_reply if length $wait_reply;
    }
    push @cmd, '--', $safe_msg;

    local $ENV{'P7_CHAT_CALLER'} = qw| mcp |;
    open( my $fh, '-|', @cmd )
        or
        return send_tool_result( $id, 'failed to run chat: ' . $OS_ERROR, 1 );
    my $output = do { local $/; <$fh> };
    close $fh;
    chomp( $output //= '' );
    send_tool_result( $id, $output, 0 );
}

sub tool_p7_chat_read {
    my ( $id, $args ) = @ARG;

    my $channel = $args->{'channel'} // qw| main |;
    my $lines   = $args->{'lines'}   // 20;
    $lines = 200 if $lines > 200;
    $lines = 1   if $lines < 1;

    my $path = "$ROOT_PATH/data/chat/channel/$channel/history";
    return send_tool_result( $id, "channel '$channel' has no history", 0 )
        if not -f $path;

    open( my $fh, '<:encoding(UTF-8)', $path )
        or return send_tool_result( $id,
        'cannot read history: ' . $OS_ERROR, 1 );
    my @all = <$fh>;
    close $fh;
    my $start = @all > $lines ? @all - $lines : 0;
    send_tool_result( $id, join( '', @all[ $start .. $#all ] ), 0 );
}

sub tool_p7_chat_summary {
    my ( $id, $args ) = @ARG;

    my $channel      = $args->{'channel'}      // '';
    my $all_channels = $args->{'all_channels'} // 0;

    my @cmd = ( "$ROOT_PATH/bin/chat", qw| -q -summary | );
    push @cmd, '-channel', $channel if length $channel;
    push @cmd, '-all-channels' if $all_channels;

    local $ENV{'P7_CHAT_CALLER'} = qw| mcp |;
    open( my $fh, '-|', @cmd )
        or
        return send_tool_result( $id, 'failed to run chat: ' . $OS_ERROR, 1 );
    my $output = do { local $/; <$fh> };
    close $fh;
    chomp( $output //= '' );
    send_tool_result( $id, $output, 0 );
}

sub tool_p7_chat_search {
    my ( $id, $args ) = @ARG;

    my $term         = $args->{'term'}         // '';
    my $regex        = $args->{'regex'}        // 0;
    my $channel      = $args->{'channel'}      // '';
    my $all_channels = $args->{'all_channels'} // 0;

    return send_tool_result( $id, 'term is required', 1 )
        if not length $term;

    my @cmd = ( "$ROOT_PATH/bin/chat", qw| -q | );
    push @cmd, ( $regex ? '-grep' : '-search' ), $term;
    push @cmd, '-channel', $channel if length $channel;
    push @cmd, '-all-channels' if $all_channels;

    local $ENV{'P7_CHAT_CALLER'} = qw| mcp |;
    open( my $fh, '-|', @cmd )
        or
        return send_tool_result( $id, 'failed to run chat: ' . $OS_ERROR, 1 );
    my $output = do { local $/; <$fh> };
    close $fh;
    chomp( $output //= '' );
    send_tool_result( $id, $output, 0 );
}

sub tool_p7_chat_channels {
    my ( $id, $args ) = @ARG;

    local $ENV{'P7_CHAT_CALLER'} = qw| mcp |;
    open( my $fh, '-|', "$ROOT_PATH/bin/chat", qw| -q -channels | )
        or
        return send_tool_result( $id, 'failed to run chat: ' . $OS_ERROR, 1 );
    my $output = do { local $/; <$fh> };
    close $fh;
    chomp( $output //= '' );
    send_tool_result( $id, $output, 0 );
}

sub check_chat_pending {
    my $current_tool = shift // '';

    my $chat_dir = "$ROOT_PATH/data/chat/channel";
    return if not -d $chat_dir;

    my $newest_mtime = 0;
    if ( opendir my $dh, $chat_dir ) {
        my @ch = grep {
            $_ !~ m{^\.\.?$}
                and -d File::Spec->catdir( $chat_dir, $_ )
        } readdir $dh;
        closedir $dh;

        for my $name (@ch) {
            my $hpath = File::Spec->catfile( $chat_dir, $name, 'history' );
            next if not -f $hpath;
            my $mtime = ( stat($hpath) )[9] // 0;
            $newest_mtime = $mtime if $mtime > $newest_mtime;
        }
    }

    if ( $current_tool =~ m{^p7_chat} ) {
        $last_chat_mtime = $newest_mtime if $newest_mtime > 0;
        return;
    }

    my $now = time();
    return if $now - $last_hint_time < 30;

    if ( $newest_mtime > $last_chat_mtime ) {
        $last_chat_mtime = $newest_mtime;
        $last_hint_time  = $now;
        print STDERR
            "[chat] new message(s) — call p7_chat_channels to see active "
            . "channels\n";
    }
}

sub tool_p7_chat {
    my ( $id, $args ) = @ARG;

    my $message = $args->{'message'} // '';
    my $channel = $args->{'channel'} // '';

    if ( length $message ) {
        return tool_p7_chat_send( $id, $args );
    }

    if ( length $channel ) {
        return tool_p7_chat_read( $id, $args );
    }

    my $width  = 72;
    my $top    = '.:[ ]' . ( ':' x ( $width - 12 ) ) . '::[ chat ]:.';
    my $bottom = ':' . ( '.' x ( $width - 2 ) ) . ':';

    local $ENV{'P7_CHAT_CALLER'} = qw| mcp |;
    open( my $fh, '-|', "$ROOT_PATH/bin/chat", qw| -q | )
        or
        return send_tool_result( $id, 'failed to run chat: ' . $OS_ERROR, 1 );
    my $output = do { local $/; <$fh> };
    close $fh;
    chomp( $output //= '' );

    my @out = ($top);
    if ( length $output and $output !~ m{^:\s*no channels} ) {
        $output =~ s{^\.:\s*active channels\s*:\.\s*\n}{};
        push @out, split( /\n/, $output );
    } else {
        push @out, '(no channels)';
    }
    push @out, $bottom;

    send_tool_result( $id, join( "\n", @out ), 0 );
}

## =========================================================================
## tool implementations
## =========================================================================

sub tool_p7_command {
    my ( $id, $args ) = @ARG;

    my $command = $args->{'command'} // '';
    if ( not length $command ) {
        return send_tool_result( $id, 'command is required', 1 );
    }

    my ( $ok, $response ) = cube_command($command);
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

sub tool_task_create {
    my ( $id, $args ) = @ARG;

    my $desc    = $args->{'description'} // '';
    my $context = $args->{'context'}     // '';

    if ( not length $desc ) {
        return send_tool_result( $id, 'description is required', 1 );
    }

    my ( $ok, $response );
    if ( $desc =~ /\n/ or length($desc) > 200 ) {
        ( $ok, $response )
            = cube_command_multiline( 'task.create', {}, $desc );
    } else {
        ( $ok, $response ) = cube_command("task.create $desc");
    }
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

sub tool_task_show {
    my ( $id, $args ) = @ARG;

    my $task_id = $args->{'task_id'} // '';
    if ( not length $task_id ) {
        return send_tool_result( $id, 'task_id is required', 1 );
    }

    my ( $ok, $response ) = cube_command("task.show $task_id");
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

sub tool_task_queue {
    my ( $id, $args ) = @ARG;

    my $status = $args->{'status'} // '';
    my $cmd    = 'task.queue';
    $cmd .= " status=$status" if length $status;

    my ( $ok, $response ) = cube_command($cmd);
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

sub tool_task_complete {
    my ( $id, $args ) = @ARG;

    my $task_id = $args->{'task_id'} // '';
    my $result  = $args->{'result'}  // '';

    if ( not length $task_id or not length $result ) {
        return send_tool_result( $id, 'task_id and result are required', 1 );
    }

    my ( $ok, $response );
    if ( $result =~ /\n/ or length($result) > 200 ) {
        ( $ok, $response )
            = cube_command_multiline( 'task.complete', { 'id' => $task_id },
            $result );
    } else {
        ( $ok, $response ) = cube_command("task.complete $task_id $result");
    }
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

sub tool_task_continue {
    my ( $id, $args ) = @ARG;

    my $task_id = $args->{'task_id'} // '';
    my $message = $args->{'message'} // '';

    if ( not length $task_id or not length $message ) {
        return send_tool_result( $id, 'task_id and message are required', 1 );
    }

    my ( $ok, $response );
    if ( $message =~ /\n/ or length($message) > 200 ) {
        ( $ok, $response )
            = cube_command_multiline( 'task.continue', { 'id' => $task_id },
            $message );
    } else {
        ( $ok, $response ) = cube_command("task.continue $task_id $message");
    }
    send_tool_result( $id, $response, $ok ? 0 : 1 );
}

## =========================================================================
## cube socket communication [ unbuffered sysread/syswrite throughout ]
## =========================================================================

## read a single line from socket via sysread [ byte-by-byte, no buffering ]
sub sock_readline {
    my $sock = shift;
    my $line = '';
    my $byte;
    while (1) {
        my $n = sysread( $sock, $byte, 1 );
        return undef if not defined $n or $n == 0;
        $line .= $byte;
        last if $byte eq "\n";
    }
    chomp $line;
    return $line;
}

## write string to socket via syswrite
sub sock_write {
    my ( $sock, $data ) = @ARG;
    ## syswrite operates on bytes — length() returns characters with -C31 ##
    utf8::encode($data) if utf8::is_utf8($data);
    my $offset = 0;
    my $len    = length $data;
    while ( $offset < $len ) {
        my $n = syswrite( $sock, $data, $len - $offset, $offset );
        return undef if not defined $n;
        $offset += $n;
    }
    return $offset;
}

## read exactly N bytes from socket via sysread
sub sock_read_bytes {
    my ( $sock, $count ) = @ARG;
    my $data      = '';
    my $remaining = $count;
    while ( $remaining > 0 ) {
        my $chunk;
        my $n = sysread( $sock, $chunk, $remaining );
        return undef if not defined $n or $n == 0;
        $data .= $chunk;
        $remaining -= $n;
    }
    return $data;
}

sub cube_connect {
    if ( defined $cube_sock ) {
        ## verify socket is still alive [ connected() is unreliable for
        ## half-closed sockets — probe with zero-length non-blocking read ]
        my $probe;
        $cube_sock->blocking(0);
        my $n = sysread( $cube_sock, $probe, 1 );
        $cube_sock->blocking(1);
        if ( defined $n and $n == 0 ) {
            ## EOF — remote closed
            log_msg('cube socket EOF detected — reconnecting');
            cube_disconnect();
        } elsif ( $cube_sock->connected ) {
            return $cube_sock;
        } else {
            log_msg('cube socket no longer connected — reconnecting');
            cube_disconnect();
        }
    }

    log_msg( 'connecting to cube [ %s ]', $socket_path );

    $cube_sock = IO::Socket::UNIX->new(
        Type => SOCK_STREAM(),
        Peer => $socket_path,
    );

    if ( not defined $cube_sock ) {
        log_msg( 'connection failed: %s', $OS_ERROR );
        return undef;
    }

    ## read banner
    my $banner = sock_readline($cube_sock);
    if ( not defined $banner
        or $banner !~ m{^\\\\PROTOCOL-7-VERSION\\\\} ) {
        log_msg( 'protocol mismatch: %s', $banner // 'no banner' );
        close($cube_sock);
        $cube_sock = undef;
        return undef;
    }

    ## authenticate via unix method
    sock_write( $cube_sock, "select unix\n" );
    my $sel_reply = sock_readline($cube_sock);
    if ( not defined $sel_reply or $sel_reply !~ m{^TRUE} ) {
        log_msg( 'unix auth not available: %s', $sel_reply // 'no reply' );
        close($cube_sock);
        $cube_sock = undef;
        return undef;
    }

    sock_write( $cube_sock, "auth $auth_user\n" );
    my $auth_reply = sock_readline($cube_sock);
    if ( not defined $auth_reply or $auth_reply !~ m{^AUTH_TRUE} ) {
        log_msg( 'authentication failed: %s', $auth_reply // 'no reply' );
        close($cube_sock);
        $cube_sock = undef;
        return undef;
    }

    ## close-on-exec: subprocesses must not inherit the cube socket ##
    ## inherited fds closed by child processes desync the protocol   ##
    my $fd    = fileno($cube_sock);
    my $flags = fcntl( $cube_sock, F_GETFD, 0 ) // 0;
    fcntl( $cube_sock, F_SETFD, $flags | FD_CLOEXEC );

    log_msg('connected and authenticated');
    return $cube_sock;
}

## send a multiline command [ command+\n headers\n\n body\n.\n ]
## headers: hashref of key=>value, body: string (may contain newlines)
sub cube_command_multiline {
    my ( $command, $headers, $body ) = @ARG;
    $headers //= {};
    $body    //= '';

    my $sock = cube_connect();
    if ( not defined $sock ) {
        return ( 0, 'not connected to protocol-7 network' );
    }

    ## build header block ##
    my $header_block = '';
    if ( keys %{$headers} ) {
        my $max_w = max( map {length} keys %{$headers} );
        for my $key ( sort keys %{$headers} ) {
            $header_block .= sprintf " %*s : %s\n", $max_w, $key,
                $headers->{$key};
        }
    }

    ## ensure body is newline-terminated ##
    $body .= "\n" if length($body) and $body !~ /\n\z/;

    ## downgrade to bytes for syswrite — json decode leaves utf8 flag on ##
    utf8::encode($body)         if utf8::is_utf8($body);
    utf8::encode($header_block) if utf8::is_utf8($header_block);

    my $packet = sprintf "%s+\n%s\n%s.\n", $command, $header_block, $body;

    log_msg( 'sending multiline: %s (%d bytes)', $command, length($packet) );

    my $written = sock_write( $sock, $packet );
    if ( not defined $written ) {
        log_msg('write failed — connection stale');
        cube_disconnect();
        return ( 0, 'connection lost during write' );
    }

    ## read response — same as cube_command ##
    my $first_line = sock_readline($sock);
    if ( not defined $first_line ) {
        log_msg('connection lost during read');
        cube_disconnect();
        return ( 0, 'connection lost' );
    }

    my ( $reply_type, $reply_data ) = split( /\s+/, $first_line, 2 );
    $reply_type //= '';
    $reply_data //= '';

    log_msg( 'reply type: %s', $reply_type );

    return ( 1, $reply_data ) if $reply_type eq 'TRUE';
    return ( 0, $reply_data ) if $reply_type eq 'FALSE';
    return ( 0, "command not acknowledged: $reply_data" )
        if $reply_type eq 'NACK';

    if ( $reply_type eq 'SIZE' ) {
        my $byte_count = $reply_data + 0;
        my $data       = sock_read_bytes( $sock, $byte_count );
        if ( not defined $data ) {
            log_msg('connection lost during SIZE read');
            cube_disconnect();
            return ( 0, 'connection lost during read' );
        }
        $data =~ s{\n\z}{};
        return ( 1, $data );
    }

    return ( 1, $first_line );
}

sub cube_disconnect {
    if ( defined $cube_sock ) {
        sock_write( $cube_sock, "close\n" ) if $cube_sock->connected;
        close($cube_sock);
        $cube_sock = undef;
    }
}

sub cube_command {
    my $command = shift;
    my $retry   = shift // 1;    ## allow one reconnect attempt

    my $sock = cube_connect();
    if ( not defined $sock ) {
        return ( 0, 'not connected to protocol-7 network' );
    }

    my $log_cmd = $command;
    $log_cmd =~ s{(:B32:)([A-Z2-7]{20})[A-Z2-7]*}{$1$2...}s;
    log_msg( 'sending: %s', $log_cmd );

    ## send command
    my $written = sock_write( $sock, "$command\n" );
    if ( not defined $written ) {
        log_msg('write failed — connection stale');
        cube_disconnect();
        return cube_command( $command, 0 ) if $retry;
        return ( 0, 'connection lost during write' );
    }

    ## read first response line [ unbuffered ]
    my $first_line = sock_readline($sock);
    if ( not defined $first_line ) {
        log_msg('connection lost during read');
        cube_disconnect();
        return cube_command( $command, 0 ) if $retry;
        return ( 0, 'connection lost' );
    }

    ## parse reply type
    my ( $reply_type, $reply_data ) = split( /\s+/, $first_line, 2 );
    $reply_type //= '';
    $reply_data //= '';

    log_msg( 'reply type: %s', $reply_type );

    if ( $reply_type eq 'TRUE' ) {
        return ( 1, $reply_data );
    }

    if ( $reply_type eq 'FALSE' ) {
        return ( 0, $reply_data );
    }

    if ( $reply_type eq 'SIZE' ) {
        ## SIZE <byte_count> — next N bytes are payload
        my $byte_count = $reply_data + 0;
        my $data       = sock_read_bytes( $sock, $byte_count );

        if ( not defined $data ) {
            log_msg('connection lost during SIZE read');
            cube_disconnect();
            return ( 0, 'connection lost during read' );
        }

        ## trim trailing newline from sized payload
        $data =~ s{\n\z}{};

        return ( 1, $data );
    }

    if ( $reply_type eq 'NACK' ) {
        return ( 0, "command not acknowledged: $reply_data" );
    }

    ## unknown reply type — return raw
    return ( 1, $first_line );
}

## =========================================================================
## json-rpc helpers
## =========================================================================

sub send_result {
    my ( $id, $result ) = @ARG;

    my $msg = $json->encode(
        {   'jsonrpc' => '2.0',
            'id'      => $id,
            'result'  => $result
        }
    );
    print STDOUT "$msg\n";
}

sub send_error {
    my ( $id, $code, $message ) = @ARG;

    my $msg = $json->encode(
        {   'jsonrpc' => '2.0',
            'id'      => $id,
            'error'   => { 'code' => $code, 'message' => $message }
        }
    );
    print STDOUT "$msg\n";
}

sub send_tool_result {
    my ( $id, $text, $is_error, $extra ) = @ARG;

    ## cube returns raw utf-8 bytes — decode to perl chars before json
    ## encoding ##
    utf8::decode($text) if defined $text and not utf8::is_utf8($text);

    my $result = {
        'content' => [ { 'type' => 'text', 'text' => $text } ],
        'isError' => $is_error ? \1 : \0
    };
    ## optional structured fields merged alongside content/isError ##
    @{$result}{ keys %{$extra} } = values %{$extra}
        if ref $extra eq 'HASH';

    send_result( $id, $result );
}

