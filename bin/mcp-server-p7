                        'name of the tool to call [ e.g. "read_file", "search_code" ]'
                },
                'arguments' => {
                    'type'        => 'object',
                    'description' => 'tool arguments as a JSON object'
                }
            },
            'required'             => ['tool_name'],
            'additionalProperties' => \0
        }
