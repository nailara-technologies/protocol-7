#!/usr/bin/env -S perl -C31

use utf8;
use strict;
use v5.10.0;
use English;
use warnings;

$PROGRAM_NAME = qw| [mcp-server-p7] |;

use JSON;
use POSIX       qw| strftime |;
use List::Util  qw| max |;
use Encode      qw| encode decode |;
use Fcntl       qw| FD_CLOEXEC F_SETFD F_GETFD |;
use Crypt::Misc qw| encode_b32r |;
use IO::Socket::UNIX;
use IO::Select;
use FindBin qw| $RealBin |;
use File::Spec;
use Cwd        qw| abs_path |;
use File::Path qw| make_path |;
use File::Copy qw| copy |;

BEGIN {
    use File::Spec;
    use Cwd     qw| abs_path |;
    use FindBin qw| $RealBin |;
    sub c_dir  { File::Spec->catdir(@ARG) }
    sub r2_abs { File::Spec->rel2abs(@ARG) }

    ## local AMOS7 lib path : standalone bmw-L13 use, same pattern as       ##
    ## bin/amos-chksum. computed LOCALLY, never sent over the wire — cube's ##
    ## single-line command buffer caps at 242707 bytes                      ##
    ## [  base.handler.command ], and tail-truncated session content can    ##
    ## run to ~400KB                                                        ##
    my $root_path
        = abs_path( r2_abs( c_dir( $RealBin, File::Spec->updir ) ) );
    my $local_lib_path
        = abs_path( c_dir( $root_path, qw| data/lib-path/pm | ) );
    unshift( @INC, $local_lib_path )
        if defined $local_lib_path and -d $local_lib_path;
}

use Digest::BMW;
use AMOS7::Assert::Truth;
use AMOS7::TEMPLATE;
use Time::HiRes;

my $ROOT_PATH = abs_path( r2_abs( c_dir( $RealBin, File::Spec->updir ) ) );

## mcp-server-p7 — model context protocol server for protocol-7 network
##
## stdio-based MCP server exposing protocol-7 zenka commands as tool calls
## connects to cube via unix socket, authenticates as unix-$USER

use constant TRUE  => 5;
use constant FALSE => 0;

##[ configuration ]##

my $socket_path = $ENV{'PROTOCOL_7_UNIX_PATH'} // eval {
    chomp( my $p = qx| p7c unix-path 2>/dev/null | );
    length $p ? $p : undef;
} // '/var/run/.7/UNIX/NIW7OAQ';

my $auth_user = sprintf 'unix-%s',
    ( $ENV{'PROTOCOL_7_BIN_P7_USER'} // $ENV{'USER'} // $ENV{'LOGNAME'}
        // 'root' );

## strm drain safety valve bounds [ used by drain_strm_stream below ; must ##
## live before the main loop -- file-scope assignments positioned after it ##
## never execute ]                                                         ##
my $strm_idle_timeout = $ENV{'PROTOCOL_7_MCP_STRM_IDLE_TIMEOUT'} // 120;
my $strm_max_bytes    = $ENV{'PROTOCOL_7_MCP_STRM_MAX_BYTES'}    // 1048576;

## extend PATH with known per-user tool install dirs not present in mcp env ##
do {
    my $home = $ENV{'HOME'} // ( getpwuid($<) )[7] // '';
    for my $d ( "$home/.kimi-code/bin", "$home/.local/bin",
        "$home/.cargo/bin", ) {
        $ENV{'PATH'} = "$d:$ENV{PATH}" if -d $d and $ENV{'PATH'} !~ m{\Q$d\E};
    }
};

