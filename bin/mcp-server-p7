            . 'fits in a single context read. long or topic-specific updates '
            . 'must be written to an external topic file in the same '
            . 'data/ai-mem/<agent>/ directory and only linked from '
            . 'MEMORY.md. '
            . 'review mode gathers recent git changes, memory summary, and '
            . 'session summaries so the parent model can identify gaps. '
            . 'apply mode delegates to the coding zenka to append or write '
            . 'specific content to the memory file or a topic file.',
        'inputSchema' => {
            'type'       => 'object',
            'properties' => {
                'agent' => {
                    'type'        => 'string',
                    'enum'        => [ 'claude', 'kimi', 'auto' ],
                    'description' =>
                        'which agent memory to target [ claude | kimi | '
                        . 'auto ]. '
                        . 'auto detects from MCP client identity.'
                },
                'sessions' => {
                    'type'        => 'integer',
