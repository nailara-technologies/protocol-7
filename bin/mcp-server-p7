            'search the focus-scored memory tree for relevant topics. boosts '
            . 'query terms in the focus vector, re-scores the tree, and '
            . 'returns the top-ranked branches as compact ASCII output. '
            . 'use when you need to find memory about a specific topic.',
        'inputSchema' => {
            'type'       => 'object',
            'properties' => {
                'terms' => {
                    'type'        => 'string',
                    'description' =>
                        'one or more space-separated search terms'
                },
            },
            'required'             => ['terms'],
            'additionalProperties' => \0
        }
    },
    {   'name'        => 'p7_memory_digest',
        'description' =>
            'search the focus-scored memory tree and return a prose digest. '
            . 'runs memory.search to score the tree by relevance, then '
            . 'summarizes the top leaves via the local coding zenka. '
            . 'slower than p7_memory_search but returns a concise '
            . 'summary.',
        'inputSchema' => {
            'type'       => 'object',
            'properties' => {
                'terms' => {
                    'type'        => 'string',
                    'description' =>
                        'one or more space-separated search terms'
                },
                'max_tokens' => {
                    'type'        => 'integer',
                    'description' =>
                        'target summary length in tokens (default: 400)'
                },
            },
            'required'             => ['terms'],
            'additionalProperties' => \0
        }
    },
);

##[ load chat tool definitions ]##
{
    my $chat_tools_fn = do "$ROOT_PATH/src/mcp.tools.chat";
    if ( ref $chat_tools_fn eq qw| CODE | ) {
        $chat_tools_fn->( \@tools );
    } elsif ($@) {
        log_msg( 'chat tools load error: %s', $@ );
    }
}

##[ register external tools ]##

for my $ext (@external_tools) {
    next if grep { $_->{'name'} eq $ext->{'name'} } @tools;

    my ( %props, @required );

    if ( defined $ext->{'params'} ) {
        for my $p ( @{ $ext->{'params'} } ) {
            my ( $name, $desc, $req ) = @$p;
            $props{$name} = {
                'type'        => 'string',
                'description' => $desc // '',
            };
            push @required, $name if $req;
        }
    } else {
        ## legacy format (1-2 params)
        $props{ $ext->{'param_name'} } = {
            'type'        => 'string',
            'description' => $ext->{'param_desc'} // '',
        };
        push @required, $ext->{'param_name'};
        if ( defined $ext->{'param2_name'} ) {
            $props{ $ext->{'param2_name'} } = {
                'type'        => 'string',
                'description' => $ext->{'param2_desc'} // '',
            };
            push @required, $ext->{'param2_name'};
        }
    }

    push @tools,
        {
        'name'        => $ext->{'name'},
        'description' => $ext->{'description'},
        'inputSchema' => {
            'type'                 => 'object',
            'properties'           => \%props,
            'required'             => \@required,
            'additionalProperties' => \0,
        },
        };
}

##[ main loop ]##

load_sticky_focus();

log_msg( 'mcp-server-p7 starting [ auth=%s socket=%s ]',
    $auth_user, $socket_path );

while ( my $line = <STDIN> ) {
    chomp $line;
    next unless length $line;

    my $msg = eval { $json->decode($line) };
    if ($EVAL_ERROR) {
        send_error( undef, -32700, 'parse error' );
        next;
    }

    my $id     = $msg->{'id'};
    my $method = $msg->{'method'} // '';
    my $params = $msg->{'params'} // {};

    ## notifications [ no id ] — absorb silently
    if ( not defined $id ) {
        log_msg( 'notification: %s', $method );
        next;
    }

    if ( $method eq 'initialize' ) {
        handle_initialize( $id, $params );
    } elsif ( $method eq 'tools/list' ) {
        handle_tools_list( $id, $params );
    } elsif ( $method eq 'tools/call' ) {
        handle_tools_call( $id, $params );
    } elsif ( $method eq 'ping' ) {
        send_result( $id, {} );
    } else {
        send_error( $id, -32601, "method not found: $method" );
    }

    check_chat_pending($last_tool_name);
}

log_msg('stdin closed, exiting');
cube_disconnect();
exit(0);

## =========================================================================
## mcp protocol handlers
## =========================================================================

sub handle_initialize {
    my ( $id, $params ) = @ARG;

    log_msg('initialize request received');
    $mcp_client_name = $params->{'clientInfo'}{'name'} // '';

    send_result(
        $id,
        {   'protocolVersion' => '2025-11-25',
            'capabilities'    => { 'tools' => {} },
            'serverInfo'      => {
                'name'    => 'mcp-server-p7',
                'version' => '0.1.0',
            }
        }
    );
}

sub handle_tools_list {
    my ( $id, $params ) = @ARG;
    send_result( $id, { 'tools' => \@tools } );
}

sub handle_tools_call {
    my ( $id, $params ) = @ARG;

    my $name = $params->{'name'}      // '';
    my $args = $params->{'arguments'} // {};

    check_chat_pending($name);
    $last_tool_name = $name;

    log_msg( 'tools/call: %s', $name );

    if ( $name eq 'p7_command' ) {
        tool_p7_command( $id, $args );
    } elsif ( $name eq 'p7_task_create' ) {
        tool_task_create( $id, $args );
    } elsif ( $name eq 'p7_task_show' ) {
        tool_task_show( $id, $args );
    } elsif ( $name eq 'p7_task_queue' ) {
        tool_task_queue( $id, $args );
    } elsif ( $name eq 'p7_task_complete' ) {
        tool_task_complete( $id, $args );
    } elsif ( $name eq 'p7_task_continue' ) {
        tool_task_continue( $id, $args );
    } elsif ( $name eq 'p7_task_stop' ) {
        tool_task_stop( $id, $args );
    } elsif ( $name eq 'p7_task_restart_round' ) {
        tool_task_restart_round( $id, $args );
    } elsif ( $name eq 'p7_agent_spawn' ) {
        tool_agent_spawn( $id, $args );
    } elsif ( $name eq 'p7_agent_list' ) {
        tool_agent_list( $id, $args );
    } elsif ( $name eq 'p7_agent_dispatch' ) {
        tool_agent_dispatch( $id, $args );
    } elsif ( $name eq 'p7_template_resolve' ) {
        tool_template_resolve( $id, $args );
    } elsif ( $name eq 'p7_zenka_start' ) {
        tool_zenka_start( $id, $args );
    } elsif ( $name eq 'p7_list_tools' ) {
        tool_list_tools( $id, $args );
    } elsif ( $name eq 'p7_call_tool' ) {
        tool_call_tool( $id, $args );
    } elsif ( $name eq 'p7_detected_agent' ) {
        tool_p7_detected_agent( $id, $args );
    } elsif ( $name eq 'p7_chat_send' ) {
        tool_p7_chat_send( $id, $args );
    } elsif ( $name eq 'p7_chat_read' ) {
        tool_p7_chat_read( $id, $args );
    } elsif ( $name eq 'p7_chat_summary' ) {
        tool_p7_chat_summary( $id, $args );
    } elsif ( $name eq 'p7_chat_search' ) {
        tool_p7_chat_search( $id, $args );
    } elsif ( $name eq 'p7_chat_channels' ) {
        tool_p7_chat_channels( $id, $args );
    } elsif ( $name eq 'p7_chat' ) {
        tool_p7_chat( $id, $args );
    } elsif ( $name eq 'coding_summarize' ) {
        tool_coding_summarize( $id, $args );
    } elsif ( $name eq 'session_catchup' ) {
        tool_session_catchup( $id, $args );
    } elsif ( $name eq 'scratchpad_import' ) {
        tool_scratchpad_import( $id, $args );
    } elsif ( $name eq 'store_summary_focus' ) {
        tool_store_summary_focus( $id, $args );
    } elsif ( $name eq 'p7_memory_summary' ) {
        tool_p7_memory_summary( $id, $args );
    } elsif ( $name eq 'p7_memory_update' ) {
        tool_p7_memory_update( $id, $args );
    } elsif ( $name eq 'p7_memory_search' ) {
        tool_p7_memory_search( $id, $args );
    } elsif ( $name eq 'p7_memory_digest' ) {
        tool_p7_memory_digest( $id, $args );
    } elsif ( $name eq 'kimi_check_status' ) {
        tool_kimi_check_status( $id, $args );
    } elsif ( $name eq 'claude_cloud_dispatch' ) {
        tool_claude_cloud_dispatch( $id, $args );
    } elsif ( $name eq 'claude_cloud_status' ) {
        tool_claude_cloud_status( $id, $args );
    } elsif ( $name eq 'claude_cloud_result' ) {
        tool_claude_cloud_result( $id, $args );
    } elsif ( my ($ext) = grep { $_->{'name'} eq $name } @external_tools ) {
        tool_external_command( $id, $args, $ext );
    } else {
        send_error( $id, -32602, "unknown tool: $name" );
    }
}

## =========================================================================
## chat tool implementations
## =========================================================================

sub tool_p7_chat_send {
    my ( $id, $args ) = @ARG;

    my $message = $args->{'message'} // '';
    return send_tool_result( $id, 'message is required', 1 )
        if not length $message;

    my $channel    = $args->{'channel'}    // '';
    my $model      = $args->{'model'}      // '';
    my $wait_reply = $args->{'wait_reply'} // undef;

    ( my $safe_msg = $message ) =~ s{\n}{ }g;

    my @cmd = ( "$ROOT_PATH/bin/chat", qw| -q | );
    push @cmd, '-channel', $channel if length $channel;
    push @cmd, '-model',   $model   if length $model;
    if ( defined $wait_reply ) {
        push @cmd, '-wait-reply';
        push @cmd, $wait_reply if length $wait_reply;
    }
    push @cmd, '--', $safe_msg;

    local $ENV{'P7_CHAT_CALLER'} = qw| mcp |;
    open( my $fh, '-|', @cmd )
        or
        return send_tool_result( $id, 'failed to run chat: ' . $OS_ERROR, 1 );
    my $output = do { local $/; <$fh> };
    close $fh;
    chomp( $output //= '' );
    send_tool_result( $id, $output, 0 );
}

sub tool_p7_chat_read {
    my ( $id, $args ) = @ARG;

    my $channel = $args->{'channel'} // qw| main |;
    my $lines   = $args->{'lines'}   // 20;
    $lines = 200 if $lines > 200;
    $lines = 1   if $lines < 1;

    my $path = "$ROOT_PATH/data/development/chat/channel/$channel/history";
    return send_tool_result( $id, "channel '$channel' has no history", 0 )
        if not -f $path;

    open( my $fh, '<:encoding(UTF-8)', $path )
        or return send_tool_result( $id,
        'cannot read history: ' . $OS_ERROR, 1 );
    my @all = <$fh>;
    close $fh;
    my $start = @all > $lines ? @all - $lines : 0;
    send_tool_result( $id, join( '', @all[ $start .. $#all ] ), 0 );
}

sub tool_p7_chat_summary {
    my ( $id, $args ) = @ARG;

    my $channel      = $args->{'channel'}      // '';
    my $all_channels = $args->{'all_channels'} // 0;

    my @cmd = ( "$ROOT_PATH/bin/chat", qw| -q -summary | );
    push @cmd, '-channel', $channel if length $channel;
    push @cmd, '-all-channels' if $all_channels;

    local $ENV{'P7_CHAT_CALLER'} = qw| mcp |;
    open( my $fh, '-|', @cmd )
        or
        return send_tool_result( $id, 'failed to run chat: ' . $OS_ERROR, 1 );
    my $output = do { local $/; <$fh> };
    close $fh;
    chomp( $output //= '' );
    send_tool_result( $id, $output, 0 );
}

sub tool_p7_chat_search {
    my ( $id, $args ) = @ARG;

    my $term         = $args->{'term'}         // '';
    my $regex        = $args->{'regex'}        // 0;
    my $channel      = $args->{'channel'}      // '';
    my $all_channels = $args->{'all_channels'} // 0;

    return send_tool_result( $id, 'term is required', 1 )
        if not length $term;

    my @cmd = ( "$ROOT_PATH/bin/chat", qw| -q | );
    push @cmd, ( $regex ? '-grep' : '-search' ), $term;
    push @cmd, '-channel', $channel if length $channel;
    push @cmd, '-all-channels' if $all_channels;

    local $ENV{'P7_CHAT_CALLER'} = qw| mcp |;
    open( my $fh, '-|', @cmd )
        or
        return send_tool_result( $id, 'failed to run chat: ' . $OS_ERROR, 1 );
    my $output = do { local $/; <$fh> };
    close $fh;
    chomp( $output //= '' );
    send_tool_result( $id, $output, 0 );
}

sub tool_p7_chat_channels {
    my ( $id, $args ) = @ARG;

    local $ENV{'P7_CHAT_CALLER'} = qw| mcp |;
    open( my $fh, '-|', "$ROOT_PATH/bin/chat", qw| -q -channels | )
        or
        return send_tool_result( $id, 'failed to run chat: ' . $OS_ERROR, 1 );
    my $output = do { local $/; <$fh> };
    close $fh;
    chomp( $output //= '' );
    send_tool_result( $id, $output, 0 );
}

sub check_chat_pending {
    my $current_tool = shift // '';

    my $chat_dir = "$ROOT_PATH/data/development/chat/channel";
    return if not -d $chat_dir;

    my $newest_mtime = 0;
    if ( opendir my $dh, $chat_dir ) {
        my @ch = grep {
            $_ !~ m{^\.\.?$}
                and -d File::Spec->catdir( $chat_dir, $_ )
        } readdir $dh;
        closedir $dh;

        for my $name (@ch) {
            my $hpath = File::Spec->catfile( $chat_dir, $name, 'history' );
            next if not -f $hpath;
            my $mtime = ( stat($hpath) )[9] // 0;
            $newest_mtime = $mtime if $mtime > $newest_mtime;
        }
    }

    if ( $current_tool =~ m{^p7_chat} ) {
        $last_chat_mtime = $newest_mtime if $newest_mtime > 0;
        return;
    }

    my $now = time();
    return if $now - $last_hint_time < 30;

    if ( $newest_mtime > $last_chat_mtime ) {
        $last_chat_mtime = $newest_mtime;
        $last_hint_time  = $now;
        print STDERR "[chat] new message(s) — call "
            . "p7_chat_channels to see active channels\n";
    }
}

sub tool_p7_chat {
    my ( $id, $args ) = @ARG;

    my $message = $args->{'message'} // '';
    my $channel = $args->{'channel'} // '';

    if ( length $message ) {
        return tool_p7_chat_send( $id, $args );
    }

    if ( length $channel ) {
        return tool_p7_chat_read( $id, $args );
    }

    my $width  = 72;
    my $top    = '.:[ ]' . ( ':' x ( $width - 12 ) ) . '::[ chat ]:.';
    my $bottom = ':' . ( '.' x ( $width - 2 ) ) . ':';

    local $ENV{'P7_CHAT_CALLER'} = qw| mcp |;
    open( my $fh, '-|', "$ROOT_PATH/bin/chat", qw| -q | )
        or
        return send_tool_result( $id, 'failed to run chat: ' . $OS_ERROR, 1 );
    my $output = do { local $/; <$fh> };
    close $fh;
    chomp( $output //= '' );

    my @out = ($top);
    if ( length $output and $output !~ m{^:\s*no channels} ) {
        $output =~ s{^\.:\s*active channels\s*:\.\s*\n}{};
        push @out, split( m|\n|, $output );
    } else {
        push @out, '(no channels)';
    }
    push @out, $bottom;

    send_tool_result( $id, join( "\n", @out ), 0 );
}

