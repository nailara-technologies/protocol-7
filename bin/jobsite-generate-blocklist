#!/usr/bin/perl
use v5.24;
use strict;
use warnings;
use English;
use File::Spec;
use Cwd     qw| abs_path |;
use FindBin qw| $RealBin |;

## generate / refresh jobsite pre-fetch block-list
## usage: jobsite-generate-blocklist [<jobs-root> ...] [<out-file>]
## defaults: /var/protocol-7/jobsite/jobs  /var/protocol-7/jobsite/block-list
##
## directories are treated as job roots; a non-directory path argument is used
## as the output file.  examples:  jobsite-generate-blocklist
## jobsite-generate-blocklist /tmp/jobs-recovery/var/protocol-7/jobsite/jobs
## jobsite-generate-blocklist /tmp/.../jobs /var/protocol-7/jobsite/jobs
## /var/protocol-7/jobsite/block-list

BEGIN {
    my $up_dir       = File::Spec->updir;
    my $data_pm_path = qw| data/lib-path/pm |;
    my $root_path    = abs_path( File::Spec->catdir( $RealBin, $up_dir ) );
    my $local_lib_path
        = abs_path( File::Spec->catdir( $root_path, $data_pm_path ) );
    die "\n:\n:: not found : $local_lib_path\n:\n" if !-d $local_lib_path;
    unshift( @INC, $local_lib_path )               if -d $local_lib_path;
}

use AMOS7::Assert::Truth qw| is_true |;
use Crypt::Misc          qw| encode_b32r |;
use Digest::BMW;
use YAML::XS;
use File::Find;

my $out_file = '/var/protocol-7/jobsite/block-list';
my @roots;
for my $arg (@ARGV) {
    if ( -d $arg ) {
        push @roots, $arg;
    } elsif ( $arg =~ m{/} ) {
        $out_file = $arg;
    } else {
        warn ":: ignoring unknown argument '$arg'\n";
    }
}
push @roots, '/var/protocol-7/jobsite/jobs' if not @roots;

for my $root (@roots) {
    die "\n:: jobs root not found : $root\n:\n" if !-d $root;
}

sub L13_checksum {
    my $input = shift // '';
    return undef if not length $input;

    my $bmw_512_bin = Digest::BMW::bmw_512($input);

    state $start_seed_num;
    $start_seed_num //= unpack qw| Q |, pack qw| B64 |, '10000000' x 8;
    my $bits_num = $start_seed_num;

    foreach my $segment_num ( unpack qw| Q8 |, $bmw_512_bin ) {
        while ( not AMOS7::Assert::Truth::true_int($segment_num) ) {
            $segment_num = sprintf qw| %u |, $segment_num / 13;
        }
        $bits_num ^= $segment_num;
        while ( not AMOS7::Assert::Truth::true_int($bits_num) ) {
            $bits_num <<= 1;
        }
    }

    my $result_str_B32 = encode_b32r( pack qw| Q |, $bits_num );

    while (not is_true( $result_str_B32, 0, 1 )
        or not AMOS7::Assert::Truth::true_int($bits_num) ) {
        $bits_num = sprintf qw| %u |, $bits_num / 13;
        $bits_num <<= 5;
        $bits_num       = 13 if $bits_num == 0;
        $result_str_B32 = encode_b32r( pack qw| Q |, $bits_num );
    }

    return $result_str_B32;
}

## current V7 network epoch string (matches base.ntime.epoch_timestamp) ##
sub current_epoch_v7 {
    state $ustart       //= 1023228000;   ## protocol-7 network epoch start ##
    state $epochs_total //= 385280;       ## matches base.ntime.epoch_dec ##
    my $epoch = int( ( time - $ustart ) / ( 86400 * 365 / 13 ) );
    $epoch %= $epochs_total;              ## overflow reset ##
    return encode_b32r( pack qw| w |, 99999999 - $epoch );
}

## stepstone / similar posting id: prefer numeric id field, else url slug ##
sub source_id {
    my $job = shift // {};

    my $id = $job->{'id'} // '';
    return $id if $id =~ m{^\d+$} and $id > 1000000;

    my $url = $job->{'url'} // '';
    return $1 if $url =~ m{--(\d+)-inline\.html};

    return '';
}

sub add_line {
    my ( $key, $value, $seen, $lines ) = @_;
    return if not length $value;
    my $sum = L13_checksum($value);
    return if not defined $sum;
    my $line = current_epoch_v7() . ":" . uc($key) . ":$sum";
    return if $seen->{$line}++;
    push @{$lines}, $line;
}

my %seen;
my @lines;
my $count = 0;
for my $root (@roots) {
    find(
        sub {
            return if not -f $ARG or $ARG !~ m{\.yaml$};

            my $file = $File::Find::name;
            my $job  = eval { YAML::XS::LoadFile($file) };
            if ($EVAL_ERROR) {
                warn ":: load error $file : $EVAL_ERROR\n";
                return;
            }

            add_line( 'ID',  source_id($job),     \%seen, \@lines );
            add_line( 'URL', $job->{'url'} // '', \%seen, \@lines );

            $count++;
        },
        $root
    );
}

open( my $out, qw| > |, $out_file )
    or die "\n:: cannot write $out_file : $!\n:\n";
say {$out} $_ for sort @lines;
close($out);

printf ":\n: generated %s from %d jobs (%d unique field checksums)\n:\n",
    $out_file, $count, scalar @lines;

#,,,,,,.,,,..,.,,,...,.,.,,.,,..,,.,,,,,.,.,,,..,,...,...,..,,..,,...,.,,,,.,,
#C4HX57HK4SZTYCD5XVUT7KOCRYD4FSG6UQMTOGSKHLTSQXJNBMCIOH7COMQ7RR3ZMFQ7MPGPP43R6
#\\\|H2LSOOOZOKIRVXSE6U2X4H4GGCTABCJX74AJLYQDEXCDIGYU2UB \ / AMOS7 \ YOURUM ::
#\[7]P4DCY4257SBKCR42C3ROHVJ6YCOLACCXROYEYANCGHLHWQ5UVQBA 7  DATA SIGNATURE ::
#:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
