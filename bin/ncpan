#!/usr/bin/perl

use strict;
use warnings;
use English;
use File::Path qw| make_path remove_tree |;

my $pager_cmd         = $ENV{'PAGER'} // 'less -XE';
my $CPAN_server       = 'www.cpan.org';
my $CPAN_https_port   = 443;
my $CPAN_file_list    = '/modules/02packages.details.txt.gz';
my $CPAN_module_dir   = '/authors/id/';
my $CPAN_http_timeout = 10;
my $CPAN_tmp_dir
    = ( $ENV{'XDG_CACHE_HOME'}
        // ( ( $ENV{'HOME'} // '/var/tmp' ) . '/.cache' ) )
    . '/protocol-7/cpan';
my $CPAN_local_modlist_tgz    = $CPAN_tmp_dir . '/CPAN_modules.tgz';
my $CPAN_local_modlist        = $CPAN_tmp_dir . '/CPAN_modules.asc';
my $CPAN_modlist_max_age_days = 1;

## tracks module names currently being installed in this run's recursive
## dependency chain [ guards against a circular dependency looping forever ]
my %install_in_progress;

print "\n :\n";

if    ( !@ARGV )                           {&show_commands}
elsif ( $ARGV[0] eq 'update' )             {&update}
elsif ( $ARGV[0] eq 'search' && $ARGV[1] ) { &search( $ARGV[1] ) }
elsif ( $ARGV[0] eq 'search' ) {
    print " :: usage: ncpan search <keyword>\n :\n";
    exit;
} elsif ( $ARGV[0] eq 'readme' ) {
    &show_readme( $ARGV[1] );
} elsif ( $ARGV[0] eq 'install' ) {
    &install( $ARGV[1] );
} elsif ( $ARGV[0] eq 'force-install' ) {
    &install( $ARGV[1], 1 );
} elsif ( $ARGV[0] eq 'clean' ) {
    &clean;
}

print " :: done\n :\n" if @ARGV and $ARGV[0] =~ m|^(force-)?install$|;
print "\n";

exit;

sub update {
    if ( !-d $CPAN_tmp_dir . '/src' ) {
        print " :: creating dir '$CPAN_tmp_dir/src'\n";
        make_path( $CPAN_tmp_dir . '/src' )
            or die " :: [error] cannot create tmp dir '$CPAN_tmp_dir/src'\n";
    }
    my $buffer = '';
    my ( $file_handle, $file_size ) = open_cpan_file($CPAN_file_list);
    print " :: creating tmp file '$CPAN_local_modlist_tgz'\n";
    open( TGZ_file, '>', $CPAN_local_modlist_tgz )
        or die " :: [error] cannot create module list file "
        . "'$CPAN_local_modlist_tgz' [ \l$OS_ERROR ]\n";
    print " :: downloading module list ($file_size bytes)...\n";

    my $bytes_read = 0;
    while ( $bytes_read < $file_size
        and $bytes_read += read_with_timeout( $file_handle, $buffer, 16384 ) )
    {
        syswrite( TGZ_file, $buffer );
    }
    close($file_handle);
    close(TGZ_file);

    print " :: creating module list '$CPAN_local_modlist'\n";

    open( TMP_file, '>', $CPAN_local_modlist )
        or die " :: [error] cannot create module list file "
        . "'$CPAN_local_modlist' [ \l$OS_ERROR ]\n";
    print " :: extracting module data ...\n";
    open( ZCAT, "zcat $CPAN_local_modlist_tgz |" )
        or die
        " :: [error] cannot extract files from module list [ \l$OS_ERROR ]\n";

    while ( sysread( ZCAT, $buffer, 23542 ) ) {
        print TMP_file $buffer;
    }
    close($file_handle);
    close(ZCAT);
    print " :: deleting file '$CPAN_local_modlist_tgz'.,\n :\n";
    print " : :: module list updated ::\n\n";
    unlink($CPAN_local_modlist_tgz);
}

sub ensure_modlist_fresh {
    if ( !-f $CPAN_local_modlist ) {
        print " :: no module list found, fetching one first ..\n :\n";
        update();
    } elsif ( -M $CPAN_local_modlist > $CPAN_modlist_max_age_days ) {
        print " :: module list is over $CPAN_modlist_max_age_days day"
            . ( $CPAN_modlist_max_age_days == 1 ? '' : 's' )
            . " old, refreshing ..\n :\n";
        update();
    }
}

sub search {
    my $keyword = shift || '';
    if ( !$keyword ) {
        print " :: usage: ncpan search <keyword>\n :\n";
        exit;
    }
    ensure_modlist_fresh();
    my $mod_name_len    = 33;
    my $mod_version_len = 3;
    print " ::[ search results for '$keyword' ]:.\n :\n";
    open( MOD_list, $CPAN_local_modlist )
        or die " :: [error] cannot open module list file "
        . "'$CPAN_local_modlist' [ \l$OS_ERROR ]\n";
    foreach my $mod_line (<MOD_list>) {
        if ( $mod_line =~ m|^([^\s]+)\s+([^\s]+)\s+([^\s]+)$| ) {
            my ( $mod_name, $mod_version, $mod_url ) = ( $1, $2, $3 );
            if ( $mod_name =~ m|$keyword|i ) {
                $mod_url = "https://$CPAN_server$CPAN_module_dir$mod_url";

                $mod_version_len = 5 if $mod_version_len > 5;
                if ( length($mod_version) > $mod_version_len ) {
                    $mod_version_len = length($mod_version) - 1;
                }
                $mod_name_len = 70 - $mod_version_len
                    if $mod_name_len + $mod_version_len >= 70;
                if ( length($mod_name) > $mod_name_len ) {
                    $mod_name_len = length($mod_name);
                }

                if ( $mod_version ne 'undef' ) {
                    print " : "
                        . pack( "A$mod_name_len",    $mod_name ) . " ( v"
                        . pack( "A$mod_version_len", $mod_version ) . " )\n";
                } else {
                    print " : $mod_name\n";
                }

     #                if ( length($mod_name) > $mod_name_len ) {
     #                    $mod_name_len = length($mod_name);
     #                }
     #                if ( length($mod_version) > $mod_version_len ) {
     #                    $mod_version_len = length($mod_version);
     #                }
     #                print ' :  '
     #                  . pack( " A $mod_name_len",    $mod_name ) . ' .: v.'
     #                  . pack( " A $mod_version_len", $mod_version ) . ' :: '
     #                  . $mod_url . " \n ";
            }
        }
    }
    print " :\n";
    close(MOD_list);
}

sub install {
    my $install_mod_name = $_[0];
    my $force_install    = $_[1] || 0;
    my $mod_name_len     = 33;
    my $mod_version_len  = 5;

    if ( $install_in_progress{ lc $install_mod_name } ) {
        print " :: skipping '$install_mod_name' -- already being "
            . "installed (circular or duplicate dependency)\n";
        return;
    }
    local $install_in_progress{ lc $install_mod_name } = 1;

    ensure_modlist_fresh();
    print " :: installation results for module '$install_mod_name':\n :\n";
    open( MOD_list, $CPAN_local_modlist )
        or die " :: [error] cannot open module list file "
        . "'$CPAN_local_modlist' [ \l$OS_ERROR ]\n";

    my $found = 0;

    print " : parsing module list ..\n";

    foreach my $mod_line (<MOD_list>) {
        if ( $mod_line =~ m|^([^\s]+)\s+([^\s]+)\s+([^\s]+)$| ) {
            my ( $mod_name, $mod_version, $mod_url ) = ( $1, $2, $3 );
            if ( $mod_name =~ m|^$install_mod_name$|i ) {
                my $mod_file_name = $mod_url;
                $mod_file_name =~ s|^.+/([^/]+)$|$1|g;
                $found = 1;
                my $mod_uri = "$CPAN_module_dir$mod_url";
                $mod_version_len = 5 if $mod_version_len > 5;
                if ( length($mod_version) > $mod_version_len ) {
                    $mod_version_len = length($mod_version) - 1;
                }
                $mod_name_len = 70 - $mod_version_len
                    if $mod_name_len + $mod_version_len >= 70;
                if ( length($mod_name) > $mod_name_len ) {
                    $mod_name_len = length($mod_name);
                }
                my ( $txt_handle, $buffer );
                my ( $MOD_handle, $MOD_size ) = open_cpan_file($mod_uri);
                if ($MOD_size) {
                    my $tgz_file    = "$CPAN_tmp_dir/src/$mod_file_name";
                    my $ext_mod_dir = $tgz_file;
                    $ext_mod_dir =~ s|\.tar\.gz$||;

                    print " : downloading module '$mod_name' [version "
                        . "$mod_version] ($MOD_size bytes) ...\n";
                    open( my $file_handle, ">$tgz_file" )
                        or die " :: [error] cannot open file "
                        . "'$CPAN_tmp_dir/src/$mod_file_name' [ "
                        . "\l$OS_ERROR ]\n";

                    my $bytes_read = 0;
                    while (
                        $bytes_read < $MOD_size
                        and $bytes_read += read_with_timeout(
                            $MOD_handle, $buffer, $MOD_size - $bytes_read
                        )
                    ) {
                        syswrite( $file_handle, $buffer );
                    }

                    close($file_handle);
                    close($MOD_handle);

                    print " : extracting files ..\n";
                    chdir( $CPAN_tmp_dir . '/src/' );

                    my $list_file = $CPAN_tmp_dir . '/current_extracted.list';
                    if (!system(
                            'tar',     'zxvf',
                            $tgz_file, "--index-file=$list_file"
                        )
                    ) {
                        if ( open( my $list_fh, $list_file ) ) {
                            ( my $stripped_mod_dir = $ext_mod_dir )
                                =~ s|^(.+/)||g;
                            my $mod_dir_parent = $1 || '';
                            ( my $first_entry = <$list_fh> ) =~ s|/\n$||;
                            if (    length($first_entry)
                                and $first_entry ne $ext_mod_dir
                                and -d "./$first_entry" ) {
                                $ext_mod_dir = $mod_dir_parent . $first_entry;
                            }
                            close($list_fh);
                        }
                        unlink($list_file) if -f $list_file;
                        if ( -d $ext_mod_dir ) {
                            unlink($tgz_file);
                            foreach my $dep_mod (
                                return_dependencies($ext_mod_dir) ) {
                                if ( eval("require $dep_mod") ) {
                                    print " :: ok :. '$dep_mod'\n";
                                } else {
                                    print " :: not found :. '$dep_mod'\n :\n";
                                    &install($dep_mod);
                                }
                            }

                            my $makefile_pl = "$ext_mod_dir/Makefile.PL";
                            my $makefile    = "$ext_mod_dir/Makefile";
                            my $build_pl    = "$ext_mod_dir/Build.PL";

                            chdir($ext_mod_dir) or die lcfirst($OS_ERROR);

                            if ( -f $makefile_pl ) {
                                print " : writing makefile ..\n.:\n\n";
                                if ( !system( 'perl', $makefile_pl ) ) {
                                    print "..\n";
                                    if ( -f $makefile ) {
                                        die " :\n :: [error] "
                                            . "'make' not found!\n\n"
                                            if qx(make -h) !~ m|Usage|;
                                        print " : running 'make' ...\n.:\n\n";
                                        if ( !system('make') ) {
                                            print "..\n : running 'make "
                                                . "test' ..\n.:\n\n"
                                                if !$force_install;
                                            if ( $force_install
                                                or !system( 'make', 'test' ) )
                                            {
                                                run_privileged_install(
                                                    [ 'make', 'install' ],
                                                    $force_install );
                                            } else {
                                                die "..\n :: [error] 'make "
                                                    . "test' failed !\n "
                                                    . ":\n\n";
                                            }
                                        } else {
                                            die "..\n :: [error] no clean "
                                                . "exit from 'make'\n "
                                                . ":\n\n";
                                        }
                                    }
                                } else {
                                    die " :: [error] cannot execute "
                                        . "'$makefile_pl'. [ \l$OS_ERROR "
                                        . "]\n :\n\n";
                                }
                            } elsif ( -f $build_pl ) {
                                print " : running Build.PL ..\n.:\n\n";
                                if ( !system( 'perl', $build_pl ) ) {
                                    print "..\n";
                                    if ( -f 'Build' ) {
                                        print " : running "
                                            . "'./Build' ...\n.:\n\n";
                                        if ( !system('./Build') ) {
                                            print "..\n : running './Build "
                                                . "test' ..\n.:\n\n"
                                                if !$force_install;
                                            if ( $force_install
                                                or !
                                                system( './Build', 'test' ) )
                                            {
                                                run_privileged_install(
                                                    [ './Build', 'install' ],
                                                    $force_install
                                                );
                                            } else {
                                                die "..\n :: [error] "
                                                    . "'./Build test' "
                                                    . "failed !\n :\n\n";
                                            }
                                        } else {
                                            die "..\n :: [error] no clean "
                                                . "exit from './Build'\n "
                                                . ":\n\n";
                                        }
                                    } else {
                                        die " :: [error] Build.PL did not "
                                            . "produce a 'Build' "
                                            . "script\n :\n\n";
                                    }
                                } else {
                                    die " :: [error] cannot execute "
                                        . "'$build_pl'. [ \l$OS_ERROR "
                                        . "]\n :\n\n";
                                }
                            } else {
                                die " :: [error] no Makefile.PL or Build.PL "
                                    . "found in '$ext_mod_dir' -- don't "
                                    . "know how to build this module\n "
                                    . ":\n\n";
                            }

                        } else {
                            die " :: [error] expected new module directory "
                                . "'$ext_mod_dir' not found.\n :\n\n";
                        }
                    } else {
                        die " :\n :: [error] cannot extract files "
                            . "from '$tgz_file' [ \l$OS_ERROR ]\n :\n\n";
                    }
                }
            }
        }
    }
    if ( not $found ) {
        print " :: module not found! (try 'search <keyword>')\n";
    }
    print " :\n";
    close(MOD_list);

}

## run_privileged_install : run the final install command [ make install or ##
## ./Build install, both share the same root-or-su fallback ]               ##

sub run_privileged_install {
    my ( $cmd, $force_install ) = @_;
    my $cmd_str = join ' ', @$cmd;

    if ( $force_install or $EUID == 0 ) {
        print "..\n : running '$cmd_str' ..\n.:\n\n";
        if ( !system(@$cmd) ) {
            print "..\n";
        } else {
            die "..\n :: [error] no clean exit from '$cmd_str'\n :\n\n";
        }
    } else {
        print "..\n : need root priviledges to '$cmd_str'\n";
        print " : running 'su root -c \"$cmd_str\"' ..\n.:\n\n";
        if ( !system( 'su', 'root', '-c', $cmd_str ) ) {
            print "..\n";
        } else {
            die "..\n :: [error] no clean exit from "
                . "'su root -c \"$cmd_str\"'\n :\n\n";
        }
    }
}

sub show_readme {
    my $readme_mod_name = $_[0];
    print " ::[ \"$readme_mod_name\" ]:.\n :\n";
    open( MOD_list, $CPAN_local_modlist )
        or die " :: [ERR] cannot open module list file "
        . "'$CPAN_local_modlist' [ \l$OS_ERROR ]\n";
    my $found = 0;
    print " : parsing module list ..\n";
    foreach my $mod_line (<MOD_list>) {
        my ( $mod_name_len, $mod_version_len ) = ( 33, 5 );
        if ( $mod_line =~ m|^([^\s]+)\s+([^\s]+)\s+([^\s]+)$| ) {
            my ( $mod_name, $mod_version, $mod_url ) = ( $1, $2, $3 );
            if ( $mod_name =~ m|^$readme_mod_name$|i ) {
                my $readme_file_name = $mod_url;
                $readme_file_name =~ s|^(.+)\.tar\.gz$|$1.readme|g;
                $found = 1;
                my $mod_uri = "$CPAN_module_dir$readme_file_name";
                $mod_version_len = 5 if $mod_version_len > 5;
                if ( length($mod_version) > $mod_version_len ) {
                    $mod_version_len = length($mod_version) - 1;
                }
                $mod_name_len = 70 - $mod_version_len
                    if $mod_name_len + $mod_version_len >= 70;
                if ( length($mod_name) > $mod_name_len ) {
                    $mod_name_len = length($mod_name);
                }
                my $buffer;
                my ( $txt_handle, $size ) = open_cpan_file($mod_uri);

                if ( fileno($txt_handle) ) {
                    print ".: : found '$mod_name' (v.$mod_version) "
                        . "..:. readme .:.. [$size bytes]\n";
                    my $pager_ok = open( PAGER, "| $pager_cmd" ) ? 1 : 0;
                    my $chnk_str = qr/\015\012/;
                    print "\n" if !$pager_ok;
                    while ( $size and my $buffer = <$txt_handle> ) {
                        next if not defined $buffer;
                        $size -= length($buffer);
                        $buffer =~ s|\d+$chnk_str([^\015]+)$chnk_str|$1|g;
                        if ($pager_ok) {
                            print PAGER $buffer;
                        } else {
                            print $buffer;
                        }
                    }
                    close(PAGER) if $pager_ok;
                }
                close($txt_handle) if defined $txt_handle;
                last;
            }
        }
    }
    if ( not $found ) {
        print " :: module not found. try 'search <keyword>' "
            . "to determine the correct module name.\n";
    }
    close(MOD_list);

}

sub return_dependencies {
    my $mod_dir   = $_[0];
    my $make_file = "$mod_dir/Makefile.PL";
    my @dependencies;

    ## Build.PL-only modules [ no Makefile.PL ] have no PREREQ_PM to parse ##
    ## here -- their build step below still surfaces any real missing      ##
    ## prereq itself, this just skips the pre-fetch pass for that case     ##
    return @dependencies unless -f $make_file;

    print " : checking dependencies ..\n";
    open( my $make_file_handle, " < $make_file " )
        or die " :: [error] cannot open makefile "
        . "'$make_file'. [ \l$OS_ERROR ]\n :\n\n";
    my $found_section_prereq   = 0;
    my $found_section_requires = 0;
    while (<$make_file_handle>) {
        s|#.+$||g;
        next if m|^\s*$|;
        if (s|^\s+'?PREREQ_PM'?\s+=>\s+\{||) { $found_section_prereq   = 1 }
        if (m|^requires\s|)                  { $found_section_requires = 1 }
        if ($found_section_prereq) {
            s|\s+||g;
            s|,?\n$||g;
            if (m|^\}$|) { $found_section_prereq = 0; last }
            else {
                if (m{^'?([^']+)'?=>'?([\d|\.]+)'?,?$}) {
                    push( @dependencies, $1 );
                }
            }
        }
        if ($found_section_requires) {
            s|\s+||g;
            s|;?\n$||g;
            unless (m|^requires|) { $found_section_requires = 0; last }
            else {
                s|^requires||g;
                if (m|^'?([^']+)'?=>|) {
                    push( @dependencies, $1 );
                }
            }
        }
    }
    return @dependencies;
}

sub clean {
    if ( -f $CPAN_local_modlist ) {
        print " :: deleting module list\n";
        unlink($CPAN_local_modlist)
            or die " :: [error] cannot delete module list "
            . "'$CPAN_local_modlist' [ \l$OS_ERROR ]\n";
    }

    if ( -d $CPAN_tmp_dir ) {
        print " :: deleting cache dir '$CPAN_tmp_dir'\n";
        remove_tree( $CPAN_tmp_dir, { error => \my $errs } );
        if (@$errs) {
            for my $err (@$errs) {
                my ( $file, $msg ) = %$err;
                print STDERR " :: [error] $file: $msg\n";
            }
            die " :: [error] cannot fully delete cache dir '$CPAN_tmp_dir'\n";
        }
    }

    print " :: done.\n :\n\n";
}

## read_with_timeout : sysread wrapper with a per-chunk stall timeout ##
##
## the initial GET's header wait already has its own alarm-based timeout in
## open_cpan_file [ disarmed once headers finish, since the socket is handed
## back to the caller for the body transfer ] -- this covers that body
## transfer, so a connection that stalls mid-download (not just at connect)
## still dies with a clear error instead of hanging forever. $_[1] is aliased
## through @_ to the caller's buffer, same as sysread itself.

sub read_with_timeout {
    my ( $handle, undef, $len ) = @_;
    local $SIG{'ALRM'} = sub {
        die " :: [error] network read stalled "
            . "(no data for ${CPAN_http_timeout}s)\n";
    };
    alarm($CPAN_http_timeout);
    my $bytes_read = sysread( $handle, $_[1], $len );
    alarm(0);
    return $bytes_read;
}

# sub download_cpan_file
# {}

sub open_cpan_file {
    use IO::Socket::SSL;
    my $file = $_[0];
    if (my $sock = IO::Socket::SSL->new(
            PeerAddr => $CPAN_server,
            PeerPort => $CPAN_https_port,
            Proto    => 'tcp',
            Blocking => 1
        )
    ) {
        my $url = "https://$CPAN_server$file";
        my ( $buffer, $ok ) = ( '', 0 );
        my $status_line;    ## real status line, for a useful error below ##
        $SIG{'ALRM'} = sub {
            die " :: [error] HTTP timeout( file: '$url' )\n";
        };
        alarm($CPAN_http_timeout);
        print $sock "GET $file HTTP/1.1\r\n";
        print $sock "Host: $CPAN_server\r\n\r\n";
        my $done        = 0;
        my $size        = undef;
        my $header_read = 0;
        while ( !$done ) {
            my $buffer = '';
            while ( $buffer !~ m{^[^\n|^\r]*\r?\n$} ) {
                sysread( $sock, $buffer, 1, length($buffer) );
            }
            $header_read = 1 if $buffer eq "\r\n";
            $buffer =~ s|\r?\n$||;
            $status_line //= $buffer;
            if ( !$ok and $buffer eq 'HTTP/1.1 200 OK' ) {
                $ok     = 1;
                $buffer = '';
            } elsif ( $ok and $buffer eq '' and $header_read ) {
                alarm(0);
                binmode($sock);
                my $old_fh = select($sock);
                $OUTPUT_AUTOFLUSH = 1;
                select($old_fh);
                return ( $sock, $size );
            } elsif ( $ok and $buffer ne '' ) {
                if ( $buffer =~ m|^Content-Length: (\d+)$| ) { $size = $1 }
                $buffer = undef;
            } else {
                die " :: [ERR] failed to GET '$url' -- "
                    . "server responded '$status_line'\n\n";
                return undef;
            }
        }
    } else {
        die " :: cannot connect to CPAN server at "
            . "'$CPAN_server:$CPAN_https_port' [ \l$OS_ERROR ]\n";
    }

}

sub show_commands {
    print " :: [ available commands ] \n :\n : update                 :. "
        . "download fresh module list\n : search <keyword>       :. "
        . "search for a specific module\n : readme <module>        :. "
        . "show readme file for <module> [ if available.. ]\n : "
        . "install <module>       :. download and install <module> [ + "
        . "dependencies ]\n : force-install <module> :. download and "
        . "install <module> [ no 'make test' ]\n : clean               "
        . "   :. delete module list and cache dir [ incl. extracted "
        . "sources ]\n :\n";
}

