#!/usr/bin/perl
use v5.32.0;
use utf8;
use strict;
use English;
use warnings;

## n7fs-receive : the only command a relay key may run on a durable holder.
## it adds new ciphertext blobs and never replaces, reads or deletes one.
##
## authorized_keys on the receiving host [ one line, the sending host's key ]
## : command="<repo>/bin/n7fs-receive <holder-dir>",restrict ssh-ed25519
## AAAA..
##
## the sender asks through the ssh command line [ SSH_ORIGINAL_COMMAND ] :
##   has <name> ..        prints '<name> <size>' for those present
##   put <name> <size>    reads exactly <size> bytes from stdin
##   scrub [ -nonce <b32> ] [ <name> .. ]
##                        keyless : recomputes the name checksum of every
##                        listed blob, or of every checksum-named file with
##                        no list. one line per blob : 'ok <name>',
##                        'bad <name>', 'missing <name>' ; with -nonce every
##                        present blob answers 'ans <name> <digest>', the
##                        digest over nonce-bytes + blob-bytes, so home
##                        compares two holders' answers to one challenge
##                        without reading the blobs. exit 0 when clean, 7
##                        when a blob is bad or missing.
##                        the head is never named by its checksum : a
##                        list-less scrub reports it as bad by design, so
##                        verification always passes the map's blob names
##
## a blob is accepted only when its bytes match its checksum name. the head of
## a store is not named by its checksum, so it can never be written here.
## [ -max-bytes <n> ] refuses a put that would grow the directory past n ;
## before or after the directory
##
## a name may also be r-<tag>/<name> : one level of a per-root holder's root
## subdirectory, created on first put [ review finding 2 ]. the tag is r- plus
## seven base32 characters, nothing else -- no second level, no dot-dot, no
## absolute path. .trash/ is never read or written here, and a blob that sits
## only in the trash counts as missing

use FindBin;
BEGIN { unshift @INC, "$FindBin::Bin/../data/lib-path/pm" }
use Fcntl            qw| O_WRONLY O_CREAT O_EXCL |;
use AMOS7::N7FS      qw| sync_dir |;
use AMOS7::N7FS::Sum qw| bmw_b32 |;
use Digest::BMW;

my $NAME = qr|\A[A-Z2-7]{77}\z|;
## a blob name, optionally under one per-root subdirectory level : the tag ##
## form is fixed, so no dot-dot, no second level, no absolute path passes  ##
my $PATHNAME = qr|\A(?:r-[A-Z2-7]{7}/)?[A-Z2-7]{77}\z|;

sub out { print STDERR "n7fs-receive : $ARG[0]\n"; exit( $ARG[1] // 2 ) }

## <holder-dir> and -max-bytes <n> in either order ##
my ( $dir, $max );
while (@ARGV) {
    my $arg = shift;
    if ( $arg eq '-max-bytes' ) {
        $max = shift // '';
        out('-max-bytes needs a number') if $max !~ m|\A\d+\z|;
    } elsif ( not defined $dir and $arg !~ m|\A-| ) {
        $dir = $arg;
    } else {
        out('unexpected arguments');
    }
}
out('needs the holder directory')      if not defined $dir;
out('holder directory does not exist') if not -d $dir;

my @word = split ' ', $ENV{'SSH_ORIGINAL_COMMAND'} // '';
my $verb = shift @word // '';

## a killed put leaves its temporary forever : drop those older than 1 ##
## hour, in the holder directory and in every root subdirectory        ##
sub sweep_stale {
    opendir( my $top, $dir ) or return;
    my @sub = grep { m|\Ar-[A-Z2-7]{7}\z| and -d "$dir/$ARG" } readdir $top;
    closedir $top;
    foreach my $d ( $dir, map {"$dir/$ARG"} @sub ) {
        opendir( my $dh, $d ) or next;
        my @stale = grep {m|\A\.receive\.[A-Z2-7]{77}\.\d+\z|}
            grep { -M "$d/$ARG" > 1 / 24 } readdir $dh;
        closedir $dh;
        foreach my $tmp (@stale) { unlink "$d/$tmp" }
    }
}
sweep_stale();

if ( $verb eq 'has' ) {
    foreach my $name (@word) {
        out('invalid blob name') if $name !~ $PATHNAME;
        my $size = -s "$dir/$name";
        print "$name $size\n" if defined $size;
    }
    exit 0;
}
out('unknown request') if $verb ne 'put' and $verb ne 'scrub';

if ( $verb eq 'scrub' ) {
    my $nonce = '';
    if ( @word and $word[0] eq '-nonce' ) {
        shift @word;
        $nonce = shift @word // '';
        out('invalid nonce') if $nonce !~ m|\A[A-Z2-7]{1,64}\z|;
    }
    out('invalid blob name') if grep { $ARG !~ $PATHNAME } @word;
    my @list = @word;
    if ( not @list ) {
        opendir( my $dh, $dir ) or out('cannot list the holder');
        @list = sort grep {m|$NAME|} readdir $dh;
        closedir $dh;
    }
    my ( $ok, $bad, $missing ) = ( 0, 0, 0 );
    foreach my $name (@list) {
        my $path = "$dir/$name";
        ## the checksum names the blob, not the subdirectory prefix ##
        my ($bare) = $name =~ m|\A(?:r-[A-Z2-7]{7}/)?([A-Z2-7]{77})\z|;
        if ( not -e $path ) { say "missing $name"; $missing++; next }
        ## stream in 1 MiB reads : blobs can be far larger than memory ##
        open( my $fh, '<:raw', $path ) or do {
            say "missing $name";
            $missing++;
            next;
        };
        my $ctx = Digest::BMW->new(384);
        $ctx->add($nonce) if length $nonce;
        while (1) {
            my $got = sysread( $fh, my $buf, 1048576 );
            if ( not defined $got ) {
                close $fh;
                out("cannot read $name");
            }
            last if $got == 0;
            $ctx->add($buf);
        }
        close $fh;
        my $digest = bmw_b32( $ctx->digest );
        if ( length $nonce ) {
            ## the answer is the digest : home compares two holders ##
            $ok++;
            say "ans $name $digest";
        } elsif ( $digest eq $bare ) {
            $ok++;
            say "ok $name";
        } else {
            $bad++;
            say "bad $name";
        }
    }
    print STDERR "n7fs-receive : scrub : $ok ok, "
        . "$bad bad, $missing missing\n";
    exit( $bad || $missing ? 7 : 0 );
}
out('put needs a name and a size') if @word != 2;
my ( $name, $size ) = @word;
out('invalid blob name') if $name !~ $PATHNAME;
out('invalid size')      if $size !~ m|\A\d+\z|;
## a per-root put lands in the root's subdirectory, created on first put ##
my $target = $dir;
if ( $name =~ s|\A(r-[A-Z2-7]{7})/|| ) {
    $target = "$dir/$1";
    if ( not -d $target ) {
        mkdir $target, 0700;
        out("cannot create $1 : $OS_ERROR") if not -d $target;
        ## the new directory's name lives in the holder directory ##
        print STDERR "n7fs-receive : warning : directory sync failed\n"
            if not sync_dir($dir);
    }
}
if ( -e "$target/$name" ) {
    out( 'blob exists with another size', 4 )
        if -s "$target/$name" != $size;
    exit 0;
}
if ( defined $max ) {
    my $used = 0;
    ## the cap is for the whole holder : the top level and every root ##
    ## subdirectory, or a sender splits its puts over new subdirs     ##
    opendir( my $top, $dir ) or out('cannot list the holder');
    my @sub = grep { m|\Ar-[A-Z2-7]{7}\z| and -d "$dir/$ARG" } readdir $top;
    closedir $top;
    foreach my $d ( $dir, map {"$dir/$ARG"} @sub ) {
        opendir( my $dh, $d ) or out('cannot list the holder');
        ## count finished blobs, in-progress temporaries and the incoming ##
        ## declared size together, so parallel puts cannot pass the cap   ##
        $used += -s "$d/$ARG" // 0
            for grep { m|$NAME| or m|\A\.receive\.[A-Z2-7]{77}\.\d+\z| }
            readdir $dh;
        closedir $dh;
    }
    out( 'holder is full', 5 ) if $used + $size > $max;
}

my $tmp = "$target/.receive.$name.$PID";
sysopen( my $fh, $tmp, O_WRONLY | O_CREAT | O_EXCL, 0600 )
    or out("cannot create a temporary : $OS_ERROR");
binmode $fh;
binmode STDIN;
my $ctx  = Digest::BMW->new(384);
my $left = $size;
while ( $left > 0 ) {
    my $got = sysread( STDIN, my $buf, $left < 1048576 ? $left : 1048576 );
    if ( not $got ) {
        unlink $tmp;
        out( 'input ended early', 6 );
    }
    $ctx->add($buf);
    print {$fh} $buf or do { unlink $tmp; out("write failed : $OS_ERROR") };
    $left -= $got;
}
if ( not close $fh ) {
    unlink $tmp;
    out("close failed : $OS_ERROR");
}
if ( bmw_b32( $ctx->digest ) ne $name ) {
    unlink $tmp;
    out( 'bytes do not match the blob name', 3 );
}
## link, not rename : an existing name is never replaced ##
if ( not link $tmp, "$target/$name" ) {
    my $err = $OS_ERROR;
    unlink $tmp;
    exit 0 if -e "$target/$name" and -s "$target/$name" == $size;
    out("cannot publish : $err");
}
unlink $tmp;
system( 'sync', '--', "$target/$name" );
## the file is durable, the directory entry that names it is not yet ##
print STDERR "n7fs-receive : warning : directory sync failed\n"
    if not sync_dir($target);
exit 0;

#,,..,,,.,.,,,,,,,,,,,,.,,,,,,,.,,,,,,,..,,,,,..,,...,...,,..,..,,,.,,..,,,..,
