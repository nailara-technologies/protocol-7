#!/usr/bin/perl
## [:< ##
# name  = invoke-model-recover
# descr = recover invoke.ai models from database metadata — all types
# usage = invoke-model-recover [--batch|--download|--dry-run] [--type TYPE] [name...]

use strict;
use warnings;
use utf8;
use v5.24;
use open ':std', ':encoding(UTF-8)';

use JSON::PP;
use Getopt::Long;
use LWP::UserAgent;
use File::Path qw(make_path);
use File::Basename;

my ($opt_dry_run, $opt_download, $opt_batch,
    $opt_list,    $opt_type,     $opt_help
);
GetOptions(
    'dry-run'  => \$opt_dry_run,
    'download' => \$opt_download,
    'batch'    => \$opt_batch,
    'list'     => \$opt_list,
    'type=s'   => \$opt_type,
    'help'     => \$opt_help,
) or usage();

usage() if $opt_help;

my $DB_FILE    = $ENV{'INVOKE_DB'} // "$ENV{HOME}/.invokeai/db/invokeai.db";
my $OUTPUT_DIR = $ENV{'INVOKE_MODELS_DIR'}
    // '/mnt/ext-xfs-data/models-invoke';
my $HF_TOKEN = $ENV{'HF_TOKEN'} // read_hf_token_from_invoke()
    // read_hf_token_from_lmstudio();

## query database for all models ##
my $models = query_database();

## filter by --type if specified ##
if ($opt_type) {
    my %types = map { $_ => 1 } split /,/, $opt_type;
    $models = [ grep { $types{ $_->{'type'} // '' } } @$models ];
}

## filter by name if specified ##
if (@ARGV) {
    my %wanted = map { $_ => 1 } @ARGV;
    $models = [ grep { $wanted{ $_->{'name'} } } @$models ];
}

## --batch: non-main types only ##
if ($opt_batch) {
    my $batch_models
        = [ grep { ( $_->{'type'} // '' ) ne 'main' } @$models ];
    download_models($batch_models);
    exit(0);
}

## default: list ##
if ( !$opt_dry_run && !$opt_download ) {
    list_models($models);
    exit(0);
}

if ($opt_dry_run) {
    dry_run($models);
} elsif ($opt_download) {
    download_models($models);
}

##===========================================================================##

sub query_database {
    my $sql
        = "SELECT name, type, source, source_type,"
        . " json_extract(config, '\$.description') as description,"
        . " json_extract(config, '\$.file_size') as size,"
        . " json_extract(config, '\$.path') as path,"
        . " json_extract(config, '\$.format') as format"
        . " FROM models ORDER BY type, name;";

    my $cmd  = qq{sqlite3 "$DB_FILE" ".mode json" "$sql" 2>/dev/null};
    my $json = `$cmd`;
    unless ($json) {
        die "Cannot query database: $DB_FILE\n"
            . "Make sure Invoke.ai database exists.\n";
    }

    my $models = eval { JSON::PP::decode_json($json) };
    if ($@) {
        die "Failed to parse database output: $@\n";
    }

    return $models;
}

sub list_models {
    my ($models) = @_;

    ## group by type ##
    my %by_type;
    for my $m (@$models) {
        push @{ $by_type{ $m->{'type'} // 'unknown' } }, $m;
    }

    ## main first, rest alphabetical ##
    my @order = ( 'main', sort grep { $_ ne 'main' } keys %by_type );

    my ( $grand_count, $grand_size ) = ( 0, 0 );

    for my $type (@order) {
        next unless exists $by_type{$type};
        my @ms       = @{ $by_type{$type} };
        my $grp_size = 0;

        print "\n [ $type ]\n";
        print " " . "-" x 72 . "\n";
        printf "  %-40s %10s  %s\n", 'name', 'size', 'source_type';
        print " " . "-" x 72 . "\n";

        for my $m ( sort { $a->{'name'} cmp $b->{'name'} } @ms ) {
            my $size = human_size( $m->{'size'} // 0 );
            $grp_size += ( $m->{'size'} // 0 );
            printf "  %-40s %10s  %s\n",
                substr( $m->{'name'}, 0, 38 ),
                $size,
                $m->{'source_type'} // '-';
        }

        printf "  %d file%s, %s total\n",
            scalar @ms, ( scalar @ms == 1 ? '' : 's' ),
            human_size($grp_size);
        $grand_count += scalar @ms;
        $grand_size  += $grp_size;
    }

    print "\n " . "=" x 72 . "\n";
    printf " %d models, %s total\n", $grand_count, human_size($grand_size);
    print
        " run --batch to download all non-main types, --download for main\n";
}

sub dry_run {
    my ($models) = @_;
    my ( $total, $have, $missing ) = ( 0, 0, 0 );
    my $total_size = 0;

    print "DRY RUN - Checking what needs recovery:\n";
    print "=" x 80 . "\n";

    for my $m (@$models) {
        $total++;
        my $filename = get_filename($m);
        my $filepath = "$OUTPUT_DIR/$filename";
        $total_size += ( $m->{size} // 0 );

        if ( -f $filepath ) {
            my $size = -s $filepath;
            if ( $size >= ( $m->{size} // 0 ) * 0.99 ) {
                print "✓ $m->{name} (already have: "
                    . human_size($size) . ")\n";
                $have++;
            } else {
                print "~ $m->{name} (partial: "
                    . human_size($size) . "/"
                    . human_size( $m->{size} ) . ")\n";
                $missing++;
            }
        } else {
            print "✗ $m->{name} (MISSING: "
                . human_size( $m->{size} ) . ")\n";
            print "  Source: $m->{source}\n";
            $missing++;
        }
    }

    print "=" x 80 . "\n";
    print "Summary: $total total, $have have, $missing need download\n";
    print "Total size to download: " . human_size($total_size) . "\n";
    print "\nRun with -download to fetch missing models.\n";
}

sub download_models {
    my ($models) = @_;
    my $ua = LWP::UserAgent->new(
        timeout => 600,
        agent   => 'invoke-model-recover/1.0',
    );

    ## Add HF auth if available
    if ($HF_TOKEN) {
        $ua->default_header( 'Authorization' => "Bearer $HF_TOKEN" );
        print "Using HuggingFace token for authenticated downloads\n";
    } else {
        print "Warning: No HF_TOKEN found - some models may fail\n";
    }

    make_path( $OUTPUT_DIR, { verbose => 0 } );

    print "Downloading models to: $OUTPUT_DIR\n";
    print "=" x 80 . "\n";

    my ( $downloaded, $skipped, $failed ) = ( 0, 0, 0 );

    for my $m (@$models) {
        my $filename = get_filename($m);
        my $filepath = "$OUTPUT_DIR/$filename";

        ## Check if already exists
        if ( -f $filepath && -s $filepath >= ( $m->{size} // 0 ) * 0.99 ) {
            print "• $m->{name} (already have)\n";
            $skipped++;
            next;
        }

        ## Get download URL
        my $url_info = get_download_url($m);
        unless ($url_info) {
            print "✗ $m->{name} - Cannot determine download URL\n";
            $failed++;
            next;
        }

        print "↓ $m->{name} (" . human_size( $m->{size} ) . ")\n";

        ## Handle different source types
        my $success;
        if ( ref $url_info eq 'HASH' && $url_info->{type} eq 'hf_repo' ) {
            ## HuggingFace repo - need to find model file
            $success = download_from_hf_repo( $ua, $url_info, $filepath,
                $m->{size}, $m );
        } else {
            ## Direct URL
            print "  From: $url_info\n";
            $success = download_file( $ua, $url_info, $filepath, $m->{size} );
        }

        if ($success) {
            $downloaded++;
        } else {
            $failed++;
        }
    }

    print "=" x 80 . "\n";
    print
        "Complete: $downloaded downloaded, $skipped skipped, $failed failed\n";
}

sub get_hf_repo_files {
    my ( $ua, $repo ) = @_;
    my $api_url  = "https://huggingface.co/api/models/$repo";
    my $response = $ua->get($api_url);
    return () unless $response->is_success;
    my $data = eval { JSON::PP::decode_json( $response->decoded_content ) };
    return () if $@;
    return map { $_->{'rfilename'} }
        grep { $_->{'rfilename'} =~ /\.(safetensors|ckpt|bin|pt)$/i }
        @{ $data->{'siblings'} // [] };
}

sub get_all_hf_repo_files {
    my ( $ua, $repo ) = @_;
    my $api_url  = "https://huggingface.co/api/models/$repo";
    my $response = $ua->get($api_url);
    return () unless $response->is_success;
    my $data = eval { JSON::PP::decode_json( $response->decoded_content ) };
    return () if $@;
    ## return all non-hidden files (skip .gitattributes etc.) ##
    return map { $_->{'rfilename'} }
        grep { $_->{'rfilename'} !~ m|^\.| } @{ $data->{'siblings'} // [] };
}

sub download_diffusers_model {
    my ( $ua, $repo, $dest_dir, $expected_size, $subfolder ) = @_;
    my @files = get_all_hf_repo_files( $ua, $repo );
    ## filter to subfolder if specified ##
    if ( defined $subfolder ) {
        @files = grep {m|^\Q$subfolder\E/|} @files;
    }

    unless (@files) {
        print "  ✗ Could not list repo files\n";
        return 0;
    }

    print "  Downloading diffusers model ("
        . scalar(@files)
        . " files) to: $dest_dir\n";

    my ( $ok, $fail ) = ( 0, 0 );
    for my $filename (@files) {
        my $url      = "https://huggingface.co/$repo/resolve/main/$filename";
        my $out_path = "$dest_dir/$filename";
        make_path( dirname($out_path), { verbose => 0 } );

        ## skip if already present
        if ( -f $out_path && -s $out_path > 0 ) {
            print "  • $filename (already have)\n";
            $ok++;
            next;
        }

        print "  ↓ $filename\n";
        my $success = download_file( $ua, $url, $out_path, undef );
        $success ? $ok++ : $fail++;
    }

    print "  "
        . ( $fail ? "✗" : "✓" )
        . " $ok/${\scalar @files} files downloaded"
        . ( $fail ? ", $fail failed" : '' ) . "\n";
    return $fail == 0 ? 1 : 0;
}

sub download_from_hf_repo {
    my ( $ua, $url_info, $filepath, $expected_size, $model ) = @_;
    my $repo       = $url_info->{'repo'};
    my $subfolder  = $url_info->{'subfolder'};    ## undef if no :: present
    my $model_name = $url_info->{'model_name'};
    my $outdir     = dirname($filepath);

    ## query HF API for file list (always main branch) ##
    my @all_files = get_hf_repo_files( $ua, $repo );

    ## if subfolder set, filter to files within it ##
    ## :: means subdir, not git revision — urls always use resolve/main/ ##
    if ( defined $subfolder ) {
        @all_files = grep {m|^\Q$subfolder\E/|} @all_files;
    }

    my @top_files  = grep { !m|/| } @all_files;
    my @comp_files = grep {m|/|} @all_files;

    if (@top_files) {
        print "  Found "
            . scalar(@top_files)
            . " top-level model file(s) via API\n";
        for my $filename (@top_files) {
            my $url = "https://huggingface.co/$repo/resolve/main/$filename";
            my $out_path = "$outdir/$filename";
            print "  Trying: $url\n";
            my $success
                = download_file( $ua, $url, $out_path, $expected_size );
            return 1 if $success;
        }
    } elsif (@comp_files) {
        ## repo is diffusers-format — download full directory tree ##
        ## use stored path (UUID) if available, otherwise model name ##
        my $dest_name = $model->{'path'} // $model_name;
        my $dest_dir  = "$OUTPUT_DIR/$dest_name";
        ## pass subfolder so diffusers download uses correct paths ##
        return download_diffusers_model( $ua, $repo, $dest_dir,
            $expected_size, $subfolder );
    }

    ## fall back to guessing common filenames (covers API failure + empty repo) ##
    my $prefix           = defined $subfolder ? "$subfolder/" : '';
    my @filenames_to_try = (
        "${prefix}$model_name.safetensors",
        "${prefix}model.safetensors",
        "${prefix}diffusion_pytorch_model.safetensors",
        "${prefix}pytorch_model.safetensors",
    );
    if ( $model_name =~ /^(.*?)_v?\d+/ ) {
        push @filenames_to_try, "${prefix}$1.safetensors";
    }

    for my $filename (@filenames_to_try) {
        my $url = "https://huggingface.co/$repo/resolve/main/$filename";
        print "  Trying: $url\n";
        my $success = download_file( $ua, $url, $filepath, $expected_size );
        return 1 if $success;
    }

    print "  ✗ Failed to find model file in repo: $repo\n";
    return 0;
}

sub get_filename {
    my ($m) = @_;

    ## use stored path if it looks like a relative filename ##
    if (   $m->{'path'}
        && $m->{'path'} !~ m|^/|
        && $m->{'path'} =~ /\.\w+$/ ) {
        return $m->{'path'};
    }

    ## extract from source url ##
    for my $ext (qw( safetensors ckpt bin pt gguf )) {
        if ( ( $m->{'source'} // '' ) =~ m|/([^/?]+\.$ext)|i ) {
            return $1;
        }
    }

    ## fallback to name ##
    return "$m->{'name'}.safetensors";
}

sub read_hf_token_from_lmstudio {
    ## Try to read HF token from LM Studio config
    my $lmstudio_config = "$ENV{HOME}/.cache/lm-studio/config.json";
    if ( -f $lmstudio_config ) {
        open( my $fh, '<', $lmstudio_config ) or return undef;
        my $content = do { local $/; <$fh> };
        close($fh);
        if ( $content =~ /"hfToken"\s*:\s*"([^"]+)"/ ) {
            return $1;
        }
    }
    ## Try environment file
    my $env_file = "$ENV{HOME}/.config/lmstudio/.env";
    if ( -f $env_file ) {
        open( my $fh, '<', $env_file ) or return undef;
        while (<$fh>) {
            if (/HF_TOKEN[=:](.+)/) {
                close($fh);
                return $1;
            }
        }
        close($fh);
    }
    return undef;
}

sub read_hf_token_from_invoke {
    ## try invokeai.yaml — supports both ~/invokeai/ and ~/.invokeai/ locations
    for my $invoke_yaml (
        "$ENV{HOME}/.invokeai/invokeai.yaml",
        "$ENV{HOME}/invokeai/invokeai.yaml",
    ) {
        next unless -f $invoke_yaml;
        open( my $fh, '<', $invoke_yaml ) or next;
        my $content = do { local $/; <$fh> };
        close($fh);
        ## match remote_api_tokens entry with huggingface url_regex
        ## yaml structure: url_regex: huggingface.co\n  token: hf_xxx
        if ( $content
            =~ /url_regex[^\n]*huggingface[^\n]*\n\s*token:\s*(\S+)/i ) {
            return $1;
        }
        ## fallback: any bare token: hf_xxx line
        if ( $content =~ /^\s*token:\s*(hf_[a-zA-Z0-9_-]+)/m ) {
            return $1;
        }
    }

    ## check database — client_state.data is JSON blob in newer invokeai
    my $db_file = "$ENV{HOME}/.invokeai/db/invokeai.db";
    if ( -f $db_file ) {
        my $token
            = `sqlite3 "$db_file" "SELECT data FROM client_state LIMIT 1;" 2>/dev/null`;
        chomp($token);
        if ( $token && $token =~ /(hf_[a-zA-Z0-9_-]{10,})/ ) {
            return $1;
        }
    }

    ## Check systemd service environment
    my $systemd_env = "/etc/systemd/system/invokeai.service";
    if ( -f $systemd_env ) {
        open( my $fh, '<', $systemd_env ) or return undef;
        while (<$fh>) {
            if (/Environment="?HF_TOKEN=(.+?)"?\s*$/i) {
                close($fh);
                return $1;
            }
            if (/Environment="?HUGGINGFACE_TOKEN=(.+?)"?\s*$/i) {
                close($fh);
                return $1;
            }
        }
        close($fh);
    }

    return undef;
}

sub get_download_url {
    my ($m) = @_;

    ## Direct URL
    if ( $m->{source_type} eq 'url' ) {
        return $m->{source};
    }

    ## HuggingFace repo ID - construct download URL for main model file
    if ( $m->{'source_type'} eq 'hf_repo_id' ) {
        my $source = $m->{'source'};
        ## invokeai appends ::subfolder to select a subdirectory, not a git ref ##
        ## e.g. InvokeAI/clip-vit-large-patch14-text-encoder::bfloat16 means ##
        ##      the bfloat16/ subdirectory within the main branch of the repo  ##
        my ( $repo, $subfolder ) = split /::/, $source, 2;
        return {
            'type'       => 'hf_repo',
            'repo'       => $repo,
            'subfolder'  => $subfolder,       ## undef if no :: present
            'model_name' => $m->{'name'},
            'path'       => $m->{'path'},
            'format'     => $m->{'format'},
        };
    }

    return undef;
}

sub download_file {
    my ( $ua, $url, $filepath, $expected_size ) = @_;
    my $tmpfile = "$filepath.tmp";

    make_path( dirname($tmpfile), { verbose => 0 } );

    ## resume partial download if .tmp exists ##
    my $offset = ( -f $tmpfile ) ? ( -s $tmpfile ) : 0;

    if ( $offset > 0 ) {
        print "    resuming from " . human_size($offset) . "\n";
    }

    open my $fh, $offset ? '>>' : '>', $tmpfile
        or do { print "    ✗ Cannot open tmpfile: $!\n"; return 0 };

    my %extra_headers = $offset ? ( 'Range' => "bytes=$offset-" ) : ();

    my $response = $ua->get( $url, %extra_headers,
        ':content_cb' => sub { print $fh $_[0] }, );
    close $fh;

    ## server ignored range request — restart from scratch ##
    if ( $offset > 0 && $response->code == 200 ) {
        print "    server does not support resume, restarting\n";
        unlink $tmpfile;
        open $fh, '>', $tmpfile
            or do { print "    ✗ Cannot open tmpfile: $!\n"; return 0 };
        $response
            = $ua->get( $url, ':content_cb' => sub { print $fh $_[0] } );
        close $fh;
    }

    if ( ( $response->is_success || $response->code == 206 ) && -f $tmpfile )
    {
        my $size = -s $tmpfile;

        ## warn only if file is smaller than expected — larger is fine ##
        ## (db metadata may be stale; hf may have updated to higher precision) ##
        if ( $expected_size && $size < $expected_size * 0.99 ) {
            print "    Warning: possibly truncated (got "
                . human_size($size)
                . ", expected "
                . human_size($expected_size) . ")\n";
        }

        rename( $tmpfile, $filepath ) or die "Cannot rename: $!";
        print "    ✓ Complete (" . human_size($size) . ")\n";
        return 1;
    } else {
        my $reason
            = !$response->is_success
            ? $response->status_line
            : 'file not written';
        print "    ✗ Failed: $reason\n";
        unlink($tmpfile) if -f $tmpfile;
        return 0;
    }
}

sub human_size {
    my ($bytes) = @_;
    return '0 B' unless $bytes;
    my @units = ( 'B', 'KB', 'MB', 'GB', 'TB' );
    my $unit  = 0;
    while ( $bytes >= 1024 && $unit < @units - 1 ) {
        $bytes /= 1024;
        $unit++;
    }
    return sprintf( '%.1f %s', $bytes, $units[$unit] );
}

sub usage {
    print <<'USAGE';
usage: invoke-model-recover [options] [model_name...]

options:
    -list          list all models grouped by type (default)
    -dry-run       check what needs recovery, no download
    -download      download missing main models
    -batch         download all missing non-main types (vae, lora, controlnet, ...)
    -type TYPE     filter by type, comma-separated (e.g. vae,lora,controlnet)
    -help          show this help

environment:
    INVOKE_DB           path to invokeai.db (default: ~/.invokeai/db/invokeai.db)
    INVOKE_MODELS_DIR   output directory   (default: /mnt/ext-xfs-data/models-invoke)
    HF_TOKEN            huggingface api token

examples:
    invoke-model-recover                        # list all models grouped by type
    invoke-model-recover -batch                 # download all non-main types
    invoke-model-recover -download              # download missing main models
    invoke-model-recover -type vae -download    # download only vae models
    invoke-model-recover -dry-run my-model      # check specific model
USAGE
    exit(0);
}

