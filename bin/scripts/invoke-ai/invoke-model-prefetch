#!/usr/bin/perl
## [:< ##
# name  = invoke-model-prefetch
# descr = Pre-download Invoke.ai model dependencies from HuggingFace
# usage = invoke-model-prefetch [-check|-download|-cache-dir PATH] [model_id...]
#
# This script ensures Invoke.ai can render offline by pre-downloading
# model configs, tokenizers, and metadata from huggingface.io
#
# Examples:
#   invoke-model-prefetch -check                   # Verify all cached
#   invoke-model-prefetch -download                # Download all models
#   invoke-model-prefetch sd-xl-base sd-1.5        # Specific models only
#   invoke-model-prefetch -cache-dir /mnt/cache    # Custom cache location

use strict;
use warnings;
use utf8;
use v5.24;

use open ':std', ':encoding(UTF-8)';

use File::Path qw(make_path);
use File::Spec;
use Getopt::Long;
use JSON::PP;
use LWP::UserAgent;
use Digest::SHA qw(sha256_hex);

## Configuration
## IMPORTANT: Use a SEPARATE directory from Invoke.ai's model directory!
## This prevents accidental deletion of your single-file models.
my $CACHE_DIR = $ENV{'INVOKE_CACHE_DIR'}
    // '/var/cache/invoke-ai/huggingface';
my $HF_ENDPOINT = 'https://huggingface.co';
my $HF_API      = 'https://huggingface.co/api';
my $TIMEOUT     = 300;
my $MAX_RETRIES = 3;

## Model registry - maps Invoke.ai model names to HuggingFace repos
my $MODEL_REGISTRY = {
    ## Base models - public
    'sd-xl-base' => {
        'repo_id' => 'stabilityai/stable-diffusion-xl-base-1.0',
        'files'   => [
            'model_index.json',
            'scheduler/scheduler_config.json',
            'text_encoder/config.json',
            'text_encoder/model.safetensors',
            'text_encoder_2/config.json',
            'text_encoder_2/model.safetensors',
            'tokenizer/merges.txt',
            'tokenizer/vocab.json',
            'tokenizer_2/merges.txt',
            'tokenizer_2/vocab.json',
            'unet/config.json',
            'unet/diffusion_pytorch_model.safetensors',
            'vae/config.json',
            'vae/diffusion_pytorch_model.safetensors',
        ],
        'description' => 'Stable Diffusion XL Base 1.0',
    },
    'sd-1.5' => {
        'repo_id' => 'runwayml/stable-diffusion-v1-5',
        'files'   => [
            'model_index.json',         'scheduler/scheduler_config.json',
            'text_encoder/config.json', 'tokenizer/merges.txt',
            'tokenizer/vocab.json',     'unet/config.json',
            'vae/config.json',
        ],
        'description' => 'Stable Diffusion 1.5',
    },

    ## Models requiring HuggingFace authentication
    'sd-2.1' => {
        'repo_id' => 'stabilityai/stable-diffusion-2-1',
        'files' => [ 'model_index.json', 'scheduler/scheduler_config.json' ],
        'description'   => 'Stable Diffusion 2.1 [REQUIRES HF_TOKEN]',
        'requires_auth' => 1,
    },

    ## Placeholder for user-provided LoRAs
    'cute-style' => {
        'repo_id'       => 'USER_PROVIDED',
        'files'         => ['pytorch_lora_weights.safetensors'],
        'description'   => 'Cute style LoRA [USER PROVIDED - not downloaded]',
        'user_provided' => 1,
    },
};

## Parse arguments
my ($opt_check,     $opt_download, $opt_list,
    $opt_cache_dir, $opt_verbose,  $opt_help
);
GetOptions(
    'check'       => \$opt_check,
    'download'    => \$opt_download,
    'list'        => \$opt_list,
    'cache-dir=s' => \$opt_cache_dir,
    'verbose'     => \$opt_verbose,
    'help'        => \$opt_help,
) or usage_exit();

usage_exit() if $opt_help;

$CACHE_DIR = $opt_cache_dir if $opt_cache_dir;

## Action dispatch
if ($opt_list) {
    list_models();
    exit(0);
}

my @models = @ARGV;
@models = sort keys %$MODEL_REGISTRY unless @models;

if ($opt_check) {
    my $missing = check_models(@models);
    exit( $missing ? 1 : 0 );
}

if ($opt_download) {
    download_models(@models);
    exit(0);
}

## Default: check and report
my $missing = check_models(@models);
if ($missing) {
    print "\nRun with -download to fetch missing files.\n";
    exit(1);
}
exit(0);

##===========================================================================##
## Subroutines

sub usage_exit {
    print <<'USAGE';
Usage: invoke-model-prefetch [options] [model_id...]

Options:
    -check         Verify all model files are cached
    -download      Download missing model files
    -list          List available models
    -cache-dir PATH    Custom cache directory (default: /var/cache/invoke-ai/models)
    -verbose       Verbose output
    -help          Show this help

Environment:
    INVOKE_CACHE_DIR    Default cache directory

Examples:
    invoke-model-prefetch -check                    # Verify cache
    invoke-model-prefetch -download                 # Download all
    invoke-model-prefetch sd-xl-base sd-1.5         # Specific models
    invoke-model-prefetch -cache-dir /mnt/models   # Custom location
USAGE
    exit(0);
}

sub list_models {
    print "Available models:\n";
    print "=" x 60 . "\n";
    for my $id ( sort keys %$MODEL_REGISTRY ) {
        my $model    = $MODEL_REGISTRY->{$id};
        my $optional = $model->{'optional'} ? ' [optional]' : '';
        printf "  %-20s %s%s\n", $id, $model->{'description'}, $optional;
        printf "    Repo: %s\n", $model->{'repo_id'};
    }
}

sub check_models {
    my (@models) = @_;
    my $missing = 0;

    print "Checking model cache in: $CACHE_DIR\n";
    print "=" x 60 . "\n";

    for my $model_id (@models) {
        unless ( exists $MODEL_REGISTRY->{$model_id} ) {
            warn "Unknown model: $model_id\n";
            $missing++;
            next;
        }

        my $model     = $MODEL_REGISTRY->{$model_id};
        my $model_dir = File::Spec->catdir( $CACHE_DIR, $model_id );

        print "\n[$model_id] $model->{'description'}\n";
        print "  Location: $model_dir\n";

        my $model_missing = 0;
        for my $file ( @{ $model->{'files'} } ) {
            my $filepath = File::Spec->catfile( $model_dir, $file );
            if ( -f $filepath ) {
                my $size = -s $filepath;
                printf "  ✓ %-50s (%s)\n", $file, human_size($size)
                    if $opt_verbose;
            } else {
                printf "  ✗ %-50s MISSING\n", $file;
                $model_missing++;
                $missing++;
            }
        }

        if ( $model_missing == 0 ) {
            print "  Status: ✓ Complete\n";
        } else {
            print "  Status: ✗ $model_missing files missing\n";
        }
    }

    print "\n" . "=" x 60 . "\n";
    if ($missing) {
        print "Result: $missing files missing\n";
    } else {
        print "Result: All models cached ✓\n";
    }

    return $missing;
}

sub download_models {
    my (@models) = @_;
    my $ua = LWP::UserAgent->new(
        timeout => $TIMEOUT,
        agent   => 'invoke-model-prefetch/1.0',
    );

    print "Downloading models to: $CACHE_DIR\n";
    print "=" x 60 . "\n";

    my ( $downloaded, $failed, $skipped ) = ( 0, 0, 0 );

    for my $model_id (@models) {
        unless ( exists $MODEL_REGISTRY->{$model_id} ) {
            warn "Skipping unknown model: $model_id\n";
            $failed++;
            next;
        }

        my $model     = $MODEL_REGISTRY->{$model_id};
        my $model_dir = File::Spec->catdir( $CACHE_DIR, $model_id );

        print "\n[$model_id] $model->{'description'}\n";

        ## Handle special cases
        if ( $model->{'user_provided'} ) {
            print "  ⊘ User must provide: $model->{'files'}[0]\n";
            print "    Place in: $model_dir/\n";
            $skipped++;
            next;
        }

        if ( $model->{'requires_auth'} && !$ENV{'HF_TOKEN'} ) {
            print "  ⚠ Requires HF_TOKEN environment variable\n";
            print "    Set with: export HF_TOKEN=your_token\n";
            $failed++;
            next;
        }

        ## Create directory
        make_path( $model_dir, { verbose => 0 } );

        for my $file ( @{ $model->{'files'} } ) {
            my $filepath = File::Spec->catfile( $model_dir, $file );

            ## Skip if already exists
            if ( -f $filepath ) {
                print "  • $file (cached)\n" if $opt_verbose;
                $skipped++;
                next;
            }

            ## Create subdirectory if needed
            my ( $volume, $dir, $filename )
                = File::Spec->splitpath($filepath);
            make_path( File::Spec->catpath( $volume, $dir, '' ),
                { verbose => 0 } );

            ## Download
            my $url
                = "$HF_ENDPOINT/"
                . $model->{'repo_id'}
                . "/resolve/main/$file";
            print "  ↓ $file\n";

            my $success = download_file( $ua, $url, $filepath );
            if ($success) {
                $downloaded++;
            } else {
                $failed++;
                warn "    Failed to download: $file\n";
            }
        }
    }

    print "\n" . "=" x 60 . "\n";
    print "Download complete:\n";
    print "  Downloaded: $downloaded\n";
    print "  Skipped (cached): $skipped\n";
    print "  Failed: $failed\n";

    exit( $failed ? 1 : 0 );
}

sub download_file {
    my ( $ua, $url, $filepath ) = @_;
    my $tmpfile = "$filepath.tmp";

    for my $try ( 1 .. $MAX_RETRIES ) {
        my $response = $ua->get( $url, ':content_file' => $tmpfile );

        if ( $response->is_success ) {
            ## Verify it's not an error page
            my $size = -s $tmpfile;
            if ( $size < 100 ) {
                ## Might be a redirect or error
                open( my $fh, '<', $tmpfile )
                    or die "Cannot read $tmpfile: $!";
                my $content = do { local $/; <$fh> };
                close($fh);
                if ( $content =~ /error|not found|redirect|401|403/i ) {
                    print "    Error: " . substr( $content, 0, 80 ) . "\n"
                        if $opt_verbose;
                    unlink($tmpfile);
                    sleep( 2**$try );    ## Exponential backoff
                    next;
                }
            }

            rename( $tmpfile, $filepath ) or die "Cannot rename $tmpfile: $!";
            return 1;
        }

        ## Report actual error
        if ( $opt_verbose || $try == $MAX_RETRIES ) {
            print "    HTTP "
                . $response->code . ": "
                . $response->message . "\n";
        }

        if ( $try < $MAX_RETRIES ) {
            my $delay = 2**$try;
            print "    Retry $try/$MAX_RETRIES after ${delay}s...\n"
                if $opt_verbose;
            sleep($delay);
        }
    }

    unlink($tmpfile) if -f $tmpfile;
    return 0;
}

sub human_size {
    my ($bytes) = @_;
    return '0 B' unless $bytes;

    my @units = ( 'B', 'KB', 'MB', 'GB', 'TB' );
    my $unit  = 0;

    while ( $bytes >= 1024 && $unit < @units - 1 ) {
        $bytes /= 1024;
        $unit++;
    }

    return sprintf( '%.1f %s', $bytes, $units[$unit] );
}

