#!/usr/bin/perl
use v5.24;
use strict;
use English;
use warnings;
use utf8;
use Encode          qw| decode_utf8 encode_utf8 |;
use Text::Wrap      qw| wrap |;
use File::Basename  qw| dirname basename |;
use Cwd             qw| abs_path |;
use List::MoreUtils qw| minmax uniq |;
use File::Temp      qw| tempfile |;
use PPI;

##[ LOCAL PM LIB PATH ]#######################################################

BEGIN {
    use English;
    use File::Spec;
    use Cwd     qw| abs_path |;
    use FindBin qw| $RealBin |;
    my $up_dir         = File::Spec->updir;
    my $data_pm_path   = qw| data/lib-path/pm |;
    my $root_path      = abs_path( r2_abs( c_dir( $RealBin, $up_dir ) ) );
    my $local_lib_path = abs_path( c_dir( $root_path, $data_pm_path ) );
    $local_lib_path //= $data_pm_path;
    die "\n:\n:: not found : $local_lib_path\n:\n" if !-d $local_lib_path;
    unshift( @INC, $local_lib_path )               if -d $local_lib_path;
    sub c_dir  { File::Spec->catdir(@ARG) }
    sub r2_abs { File::Spec->rel2abs(@ARG) }
}

use AMOS7::Protocol::P7Syntax qw| p7_syntax__translate |;
## Perl::Tidy required conditionally below [ not -n mode ] : its in-memory ##
## API [ source/destination scalar refs ] replaces the old perltidy CLI    ##
## subprocess entirely -- no temp files, no Term::ReadKey/ioctl dance      ##
## around a tty-suspend that never applied when stdin wasn't a tty anyway  ##

##[ global constants ]##
use constant TRUE  => 5;    ##  TRUE.  ##
use constant FALSE => 0;    ##  false  ##

use constant LINE_MAX => 78;

## narrower than LINE_MAX on purpose : error reasons in color_msg wrap for ##
## terminal readability, not for source-code column budget -- a full 78    ##
## still reads as one dense wall of text for a run's worth of diagnostics  ##
use constant ERR_WRAP_MAX => 42;

## perltidy runs AFTER this tool and re-indents continuation lines to its   ##
## own convention, which can land deeper than the quote's original column [ ##
## what this tool's own split-width budget assumes ] -- reserve this much   ##
## headroom on any continuation line's budget so a split that looks         ##
## tight-but-fitting here doesn't overflow once perltidy re-indents it      ##
use constant CONT_MARGIN => 4;

$OUTPUT_AUTOFLUSH = TRUE;

##[ argv parsing ]##
my $check_only = FALSE;
my $no_ptd     = FALSE;
my $no_utf8    = FALSE;

while ( @ARGV and defined $ARGV[0] and $ARGV[0] =~ m|^-| ) {
    my $opt = $ARGV[0];
    if    ( $opt eq qw| -c | )       { $check_only = TRUE; shift @ARGV; }
    elsif ( $opt eq qw| -n | )       { $no_ptd = TRUE; shift @ARGV; }
    elsif ( $opt eq qw| :noutf8: | ) { $no_utf8 = TRUE; shift @ARGV; }
    else                             { last; }
}

##[ exclusion pattern [ same as ptd ] ]##
my @exclude_pattern = qw|  ~  .md  .yaml  .yml  .asc  |;

##[ colors ]##
my $reset             = "\e[0m";
my $nailara_bg        = "\e[48;2;9;5;42m";
my $blacklight        = "\e[38;2;68;39;172m";
my $nailara_fg        = "\e[38;2;38;46;153m";
my $TRUE_color        = "\e[38;2;6;71;195m";
my $NEON_orange       = "\e[38;2;197;141;7m";
my $NEON_green_yellow = "\e[38;2;71;195;6m";

$SIG{'INT'} = \&sig_int;

##[ perltidy args : no -o / -b / -bext needed, in-memory API takes care of ##
## both output capture and never touching the real file until we choose to ]##
my @perltidy_args = qw|
    -q -pbp
    -wc=13 -cs
    -utf8 -l=78
    -bar -sot -ce
    -nst -sil=0
    |;
@perltidy_args = grep { $ARG ne qw| -utf8 | } @perltidy_args if $no_utf8;

if ( not $no_ptd ) {
    eval { require Perl::Tidy };
    die ":\n:: < format-code > : 'Perl::Tidy' not installed .,\n\n"
        if $EVAL_ERROR;
}

##[ filename selection ]##
my @clean_argv
    = grep { not $ARG =~ m{(?:~$|\.md$|\.yaml$|\.yml$|\.asc$)} } @ARGV;

## existence check comes first, with its own message : is_perl_code()       ##
## returns FALSE for a missing path the same way it does for "exists but    ##
## isn't perl/P7 code" [ its own -f check, line ~1300 below ], so a missing ##
## file would otherwise vanish silently and surface as the generic          ##
## "expected [perl] file name(s)" error instead of "not present"            ##
map {
    die ":\n:: < ${NEON_green_yellow}format-code$reset > $reset:$NEON_orange "
        . "not present $reset : "
        . "'$NEON_green_yellow$ARG$reset' $reset\n:\n"
        if not -f $ARG
} @clean_argv;

## remaining check : does it actually look like perl/P7 module code      ##
## [ starts with '## [:< ##' , a shebang , 'package ...;' , or is a .pm ] ##
my @files = grep { is_perl_code($ARG) }
    uniq sort { length $a <=> length $b } reverse sort @clean_argv;

die ":\n:: < ${NEON_green_yellow}format-code$reset > $reset:$NEON_orange "
    . "expected ${NEON_green_yellow}[${NEON_orange}perl"
    . "${NEON_green_yellow}]${NEON_orange} file name${NEON_green_yellow}"
    . "[${NEON_orange}s${NEON_green_yellow}]${NEON_orange}.,$reset\n:\n"
    if not @files;

my $file_count = scalar @files;
( undef, my $file_maxlen ) = minmax map {length} @files;

say $blacklight, qw| : |;

## show_progress's line ends with \r, not \n -- deliberately left open so   ##
## the NEXT file's progress line overwrites it in place [ single animated   ##
## status line ] when nothing gets printed for this file at all. the first  ##
## color_msg call for a file needs to close it with a real \n first, but a  ##
## second call for the same file must NOT re-close an already-\n-terminated ##
## line -- that's the extra blank line bug ] this flag lets color_msg tell  ##
## those two cases apart                                                    ##
my $progress_line_open = FALSE;

while ( my $file_path = shift @files ) {
    show_progress( $file_path, $file_count - scalar @files, $file_count );
    $progress_line_open = TRUE;

    my $orig_text = slurp_file($file_path);
    my $new_text  = eval { preprocess_source( $orig_text, $file_path ) };
    if ( not defined $new_text ) {
        my $err_msg = lcfirst( $EVAL_ERROR // 'preprocess failed' );
        chomp $err_msg;
        warn color_msg( $err_msg, $file_path );
        next;
    }

    if ($check_only) {
        my $final_text = $new_text;    ## best-effort fallback under -n ##
        my $tidy_rc;

        if ( not $no_ptd ) {
            my ( $tidy_out, $tidy_err, $tidy_errfile );
            $tidy_rc = Perl::Tidy::perltidy(
                source      => \$new_text,
                destination => \$tidy_out,
                stderr      => \$tidy_err,
                errorfile   => \$tidy_errfile,
                argv        => [@perltidy_args],
            );
            $final_text = $tidy_out
                if not $tidy_rc and defined $tidy_out;
        }

        ## the real syntax check still needs an actual 'perl' process --   ##
        ## keep exactly one small temp file for that alone. piping the     ##
        ## source into 'perl -c -' via an in-memory pipe risks a deadlock  ##
        ## once the child's output fills the OS pipe buffer before we're   ##
        ## done writing its input -- not theoretical here, this file's own ##
        ## ~57K is already close to a typical 64K buffer                   ##
        my $dir      = dirname($file_path) || qw| . |;
        my $chk_file = "$dir/.chk." . basename($file_path);
        if ( -e $chk_file ) {
            warn color_msg( "temp file collision [ $chk_file ]", $file_path );
            next;
        }
        open my $chk_fh, '>', $chk_file or do {
            warn color_msg( lcfirst $OS_ERROR, $file_path );
            next;
        };
        binmode $chk_fh, qw| :raw |;
        print $chk_fh( $no_utf8 ? $new_text : encode_utf8($new_text) );
        close $chk_fh;

        my @real_errors = real_syntax_errors($chk_file);

        ## perltidy itself failing is often just a symptom of a real syntax ##
        ## error -- prefer the perl -c detail over a generic status message ##
        ## when one is available (e.g. "unmatched right curly")             ##
        if ( not $no_ptd and $tidy_rc ) {
            my $err_msg
                = @real_errors
                ? join_real_errors( $file_path, @real_errors )
                : perltidy_fail_reason($tidy_rc);
            warn color_msg( $err_msg, $file_path );
            unlink $chk_file;
            next;
        }

        ## real reflow verdict : compare perltidy's ACTUAL output against ##
        ## the original -- comparing the pre-perltidy intermediate text   ##
        ## instead [ as an earlier version did ] false-positives on every ##
        ## continuation-line indent this tool's own split guesses         ##
        ## differently than perltidy itself will re-indent it to right    ##
        ## afterward [ see CONT_MARGIN note near the top of this file --  ##
        ## that guess was never meant to be authoritative ]               ##
        if ( $final_text ne $orig_text ) {
            print color_msg(
                'would reflow', $file_path,
                $NEON_orange,   $NEON_green_yellow
            );
        }

        if (@real_errors) {
            warn color_msg( join_real_errors( $file_path, @real_errors ),
                $file_path );
        } else {
            print color_msg( 'syntax valid', $file_path, $NEON_green_yellow );
        }

        unlink $chk_file;
        next;
    }

    if ( $new_text eq $orig_text and $no_ptd ) {
        ##  nothing to do , skip  ##
        next;
    }

    my $final_text = $new_text;

    if ( not $no_ptd ) {
        my ( $tidy_out, $tidy_err, $tidy_errfile );
        my $tidy_rc = Perl::Tidy::perltidy(
            source      => \$new_text,
            destination => \$tidy_out,
            stderr      => \$tidy_err,
            errorfile   => \$tidy_errfile,
            argv        => [@perltidy_args],
        );
        if ($tidy_rc) {
            ## terse, like ptd's non-check-only path : detail is a -c thing ##
            warn color_msg( perltidy_fail_reason($tidy_rc), $file_path );
            next;
        }
        $final_text = $tidy_out;
    }

    next if $final_text eq $orig_text;    ##  nothing changed , skip  ##

    open my $fh, '>', $file_path or do {
        warn color_msg( lcfirst $OS_ERROR, $file_path );
        next;
    };
    binmode $fh, qw| :raw |;
    print $fh( $no_utf8 ? $final_text : encode_utf8($final_text) );
    close $fh;
}

say "\n$blacklight:$reset";
exit 0;

##[ preprocessing pipeline ]##
sub preprocess_source {
    my $text = shift;
    my $path = shift;

    ##  parse with PPI for safe quote token + heredoc + pod identification  ##
    my $doc = PPI::Document->new( \$text );
    die "ppi parse failed\n" if not defined $doc;

    ##  classify lines : signature footer , pod region , heredoc body  ##
    my @lines = split m{(?<=\n)}, $text;    ## keep trailing newlines ##

    my $sig_start = detect_signature_start( \@lines );

    my %skip;    ## line-number [ 1-based ] => reason ##
    mark_pod_regions( \@lines, \%skip );
    mark_heredoc_regions( $doc, \%skip );

    ##  collect single/double quote tokens with line/col positions  ##
    my @quote_tokens = collect_quote_tokens($doc);

    ##  group tokens by line for fast lookup  ##
    my %quotes_by_line;
    for my $tok (@quote_tokens) {
        push @{ $quotes_by_line{ $tok->{line} } }, $tok;
    }

    ## find existing multi-line '.'-concatenation chains -- once split , a ##
    ## fragment that individually fits is never reconsidered by step1 , so ##
    ## a suboptimal split [ manual, an older tool, .. ] is otherwise stuck ##
    ## forever ; rejoin-then-resplit-from-scratch on every run fixes that  ##
    ## the same way step4 does for comment blocks                          ##
    my %concat_chain_by_start_line;
    for my $chain ( collect_concat_chains($doc) ) {
        my $start_line = $chain->[0]->location->[0];
        my $end_line   = $chain->[-1]->location->[0];
        next if $start_line == $end_line;    ## already one physical line ##
        $concat_chain_by_start_line{$start_line} //= $chain;
    }

    ##  output buffer  ##
    my @out;

    my $lnum = 1;
    while ( $lnum <= scalar @lines ) {
        my $line = $lines[ $lnum - 1 ];

        ##  pass-through signature footer  ##
        if ( defined $sig_start and $lnum >= $sig_start ) {
            push @out, $line;
            $lnum++;
            next;
        }

        ##  pass-through pod , heredoc body  ##
        if ( $skip{$lnum} ) {
            push @out, $line;
            $lnum++;
            next;
        }

        ##  step 0 : rejoin+resplit an existing multi-line '.'-concat chain ##
        if ( my $chain = $concat_chain_by_start_line{$lnum} ) {
            my $end_line   = $chain->[-1]->location->[0];
            my $spans_skip = 0;
            for my $ln ( $lnum .. $end_line ) {
                $spans_skip = 1
                    if $skip{$ln}
                    or ( defined $sig_start and $ln >= $sig_start );
            }
            if ( not $spans_skip ) {
                my $result = step0_rejoin_concat_chain( \@lines, $chain );
                if ( defined $result ) {
                    push @out, @$result;
                    $lnum = $end_line + 1;
                    next;
                }
            }
        }

        ## step 4 : realign a contiguous block of '##  text  ##' lines --   ##
        ## also routes a single over-budget '##'-line here instead of step2 ##
        ## : step2's own wrap doesn't know step4's any_close                ##
        ## padded-both-sides rendering, so a single long bracketed line     ##
        ## wrapped by step2 produced 2 lines that only THEN qualified as a  ##
        ## step4 block on the next run and got re-rendered padded -- an     ##
        ## oscillating fixed point instead of a converged one. sending a    ##
        ## lone over-budget line through the same renderer as a real        ##
        ## multi-line block closes that gap at the source ; an              ##
        ## already-fitting single line is untouched either way [ step4 only ##
        ## rewraps when the content needs it ]                              ##
        my $block_len = comment_block_length( \@lines, $lnum, \%skip );
        if ( $block_len >= 2
            or ( $block_len == 1 and length_no_nl($line) > LINE_MAX ) ) {
            push @out,
                @{ step4_align_comment_block( \@lines, $lnum, $block_len ) };
            $lnum += $block_len;
            next;
        }

        ##  step 5 : normalize a '##[ title ]###...' fill-bar to LINE_MAX  ##
        my $bar_fixed = step5_normalize_bracket_bar($line);
        if ( defined $bar_fixed ) {
            push @out, $bar_fixed;
            $lnum++;
            next;
        }

        ##  step 3 : trailing inline comment relocation  ##
        my @produced = step3_relocate_trailing_comment($line);
        if ( @produced > 1 ) {
            push @out, @produced;
            $lnum++;
            next;
        }
        $line = $produced[0];

        ##  step 1 : split long quoted strings  ##
        my $split_result
            = step1_split_long_string( $line, $quotes_by_line{$lnum} );
        if ( defined $split_result ) {
            push @out, @$split_result;
            $lnum++;
            next;
        }

        ##  step 2 : reflow long comment lines  ##
        my $reflowed = step2_reflow_comment($line);
        if ( defined $reflowed ) {
            push @out, @$reflowed;
            $lnum++;
            next;
        }

        push @out, $line;
        $lnum++;
    }

    return join( '', @out );
}

##[ shared : does line $lnum start/continue a '##  text  ##' comment block ]##
sub comment_block_line_parts {
    my $line = shift;

    ## only the leading '##  ' marker is required -- authors [ and LLMs ] ##
    ## often forget the trailing '##' on interior lines of a multi-line   ##
    ## paragraph while still closing the block on its last line , so a    ##
    ## per-line open+close requirement misses those and mangles them      ##
    return undef if $line !~ m{^(\s*)\#\#\ (.*?)\s*(\r?\n)?$};
    my ( $indent, $content ) = ( $1, $2 );

    ## closing marker width varies -- '##' is the norm, but this codebase  ##
    ## also uses '###' [ one extra hash ] as a closer, e.g. section-header ##
    ## style '## title ###' and box borders built from it. match 2-or-more ##
    ## trailing hashes as one unit so no stray '#' is left glued to        ##
    ## $content -- a leftover stray hash on a blank framing line was       ##
    ## exactly what broke box detection [ content stopped being truly '' ] ##
    my $has_close = 0;
    if ( $content =~ s{\s*\#{2,}\s*$}{} ) {
        $has_close = 1;
    }

    return undef if $content eq qw| [:< |;    ## module header ##

    ## bracket annotation [ '## [ short remark ] ##' ] is a deliberate,     ##
    ## widely-used atomic-remark convention -- protect it from reflow ONLY  ##
    ## while it already fits ; once it exceeds LINE_MAX there's no fallback ##
    ## that ever wraps it otherwise, so it would overflow forever instead   ##
    ## of just this once                                                    ##
    return undef
        if $content =~ m{^\[.*\]$}
        and length_no_nl($line) <= LINE_MAX;
    ## strip only leading/trailing whitespace -- the has_close branch above ##
    ## already consumed any right-padding that sat before a misaligned '##' ##
    ## [ '\s*\#\#\s*$' ] , so nothing but true edge whitespace is left here ##
    ## ; internal whitespace runs must survive untouched now, since a       ##
    ## double-space can carry real  sentence/paragraph-boundary meaning [   ##
    ## see step4 ] that a blanket collapse would destroy the moment it      ##
    ## lands mid-line after wrapping, breaking convergence on a second      ##
    ## reformatting pass  capture the padding depth BEFORE stripping --     ##
    ## needed to preserve a symmetric box style's chosen padding [ e.g. '## ##
    ## title  ##' ] on reconstruction rather than always collapsing to the  ##
    ## bare minimum                                                         ##
    my ($lead_pad) = $content =~ m{^(\s*)};
    $content =~ s{^\s+}{};
    $content =~ s{\s+$}{};
    return {
        indent    => $indent,
        content   => $content,
        has_close => $has_close,
        lead_pad  => length($lead_pad),
    };
}

##[ step 4 helper : count contiguous same-indent block lines from $lnum ]##
sub comment_block_length {
    my ( $lines, $start_lnum, $skip ) = @_;
    my $first = comment_block_line_parts( $lines->[ $start_lnum - 1 ] );
    return 0 if not $first;

    ## any maximal contiguous same-indent run of 2+ '##'-prefixed lines is ##
    ## one reflow unit , whether or not any line individually closes with  ##
    ## '##' -- a loose , unbracketed multi-line comment [ several plain    ##
    ## '##' lines forming one paragraph, no closing marker anywhere ] is   ##
    ## just as real a block as the bracketed style , see                   ##
    ## step4_align_comment_block for how the two styles diverge on output  ##
    my $count = 1;
    my $lnum  = $start_lnum + 1;
    while ( $lnum <= scalar @$lines and not $skip->{$lnum} ) {
        my $parts = comment_block_line_parts( $lines->[ $lnum - 1 ] );
        last if not $parts;
        last if $parts->{indent} ne $first->{indent};
        $count++;
        $lnum++;
    }
    return $count;
}

##[ step 4 : reflow a comment block as one paragraph , right-align '##' ]##
sub step4_align_comment_block {
    my ( $lines, $start_lnum, $block_len ) = @_;

    my $first  = comment_block_line_parts( $lines->[ $start_lnum - 1 ] );
    my $indent = $first->{indent};

    my @content_parts;
    my @content_lens;    ## stripped content length , not physical line len ##
    my @lead_pads;       ## original padding depth , non-blank lines only ##
    my $any_close = 0;
    for my $i ( 0 .. $block_len - 1 ) {
        my $parts
            = comment_block_line_parts( $lines->[ $start_lnum - 1 + $i ] );
        push @content_parts, $parts->{content};
        push @content_lens,  length( $parts->{content} );
        push @lead_pads,     $parts->{lead_pad} if length $parts->{content};
        $any_close ||= $parts->{has_close};
    }

    ## commented-out code detection : a '##'-block containing recognizable ##
    ## perl code shapes [ trailing '{' '}' ';' , control-flow keywords ,   ##
    ## '$var->' / '$var{' dereference chains .. ] is a snippet the author  ##
    ## deliberately preserved, not prose -- reflowing/joining it would     ##
    ## scramble its structure the same way running a prose wrapper over it ##
    ## would. same repetition threshold as list detection below : one      ##
    ## incidental code-shaped line elsewhere in real prose should not      ##
    ## trigger this, two or more confirms a genuine snippet -- pass the    ##
    ## whole block through completely untouched rather than realign it,    ##
    ## since even indentation is part of what the author is preserving     ##
    my $code_marker_re = qr{
        [;{}]\s*$
      | ^(?:if|elsif|else|unless|while|until|for|foreach|sub
        |my|our|local|return|package)\b
      | \$\w+\s*(?:->|=>|\{|\[)
      | ->\s*\w+\s*\(
    }x;
    my $code_line_count = grep { $ARG =~ $code_marker_re } @content_parts;
    return [ @{$lines}[ $start_lnum - 1 .. $start_lnum + $block_len - 2 ] ]
        if $code_line_count >= 2;

    ## third list style : column-aligned marker + description, no           ##
    ## numbering/bullet/'Label:' punctuation at all -- e.g. '## [:< ##      ##
    ## module header' / '#!                shebang' , a run of 3+ spaces is ##
    ## the only signal separating the marker from its description.  same    ##
    ## repetition threshold as the code-snippet check above : found on      ##
    ## `step2_reflow_comment`'s own doc comment reflowing itself into       ##
    ## flowing prose and losing convergence pass-to-pass -- author's column ##
    ## alignment is exactly the kind of deliberate structure reflow/join    ##
    ## would scramble, so pass the whole block through untouched rather     ##
    ## than try to preserve alignment through Text::Wrap [ which normalizes ##
    ## internal whitespace runs when it rejoins words, destroying the       ##
    ## alignment even if the lines were correctly kept separate ]           ##
    my $column_align_re   = qr{\S\s{3,}\S};
    my $column_line_count = grep { $ARG =~ $column_align_re } @content_parts;
    return [ @{$lines}[ $start_lnum - 1 .. $start_lnum + $block_len - 2 ] ]
        if $column_line_count >= 2;

    ## a symmetric box [ blank top/bottom '##   ##' border lines framing a ##
    ## centered title ] gets its author's chosen padding depth preserved   ##
    ## instead of always collapsing to the bare minimum single space --    ##
    ## ordinary prose blocks [ no blank framing line present ] keep the    ##
    ## minimal default                                                     ##
    my $is_box = grep { $_ eq '' } @content_parts;
    ## lead_pad only measures padding BEYOND the one mandatory space the   ##
    ## '## ' match already consumed [ '\#\#\ ' in comment_block_line_parts ##
    ## ] , so the true total padding is 1 + that extra                     ##
    my $box_pad
        = $is_box && @lead_pads
        ? 1 + ( sort { $b <=> $a } @lead_pads )[0]
        : 1;

    ## bracketed style [ any original line closed with '##' ] budgets '##' ##
    ## + $box_pad + text + $box_pad + '##' ; loose style [ no closing      ##
    ## marker anywhere in the original ] only needs the '## ' prefix       ##
    my $overhead = $any_close ? ( 4 + 2 * $box_pad ) : 3;
    my $width    = LINE_MAX - length($indent) - $overhead;
    return [ @{$lines}[ $start_lnum - 1 .. $start_lnum + $block_len - 2 ] ]
        if $width < 10;    ##  too narrow , leave untouched  ##

    ## list detection : a marker [ '1.', '2)', 'a.', '-', '*', bullet , or  ##
    ## a short 'Label:' prefix -- 'Phase 1:', 'tree_read:', 'port           ##
    ## resolution:' .. ] recurring at the START of 2+ lines confirms a      ##
    ## genuine list rather than a one-off reference elsewhere in the text [ ##
    ## "item 1." mid-sentence , or a single "Note: ..." aside, should NOT   ##
    ## trigger this ] -- 2+ is the dividing line between "list" and "not    ##
    ## everything is a group parent". the label form was found via real     ##
    ## damage : two colon-labeled items [ 'tree_read:' / 'grep:' , or two   ##
    ## repeated 'port resolution:' lines ] getting merged into run-on prose ##
    ## because only numeric/bullet markers were recognized -- the colon     ##
    ## must directly follow a word character [ no space before it ] , or    ##
    ## ordinary prose using ' : ' as punctuation [ "trigger : only true     ##
    ## stuck retries .." ] false-triggers this too                          ##
    my $list_marker_re = qr{
        ^(?: (?:\d+|[a-zA-Z]) [.\)]
           | [-*\x{2022}]
           | [A-Za-z][\w\- ]{0,23} \w : \s
        ) \s*
    }x;
    my @is_marker = map { m{$list_marker_re} ? 1 : 0 } @content_parts;
    my $has_list  = ( grep {$_} @is_marker ) >= 2;

    ## split into segments : a detected marker line is a hard anchor --     ##
    ## like '##' itself, it always starts a fresh output line and never     ##
    ## gets folded into the previous item's text. everything before the     ##
    ## first marker [ e.g. an intro sentence ending in ':' ] is its own     ##
    ## leading segment. an EMPTY content line [ e.g. the blank top/bottom   ##
    ## border of a symmetric '##   ##' / '##  title  ##' / '##   ##' box ]  ##
    ## is pure visual framing, not joinable prose -- it becomes its own     ##
    ## standalone blank segment [ marked undef ] instead of contributing    ##
    ## zero-length "content" to the sentence-join, which otherwise produced ##
    ## lopsided padding around the real text                                ##
    my ( @segments, @cur );
    for my $i ( 0 .. $#content_parts ) {
        if ( $content_parts[$i] eq '' ) {
            push @segments, [@cur] if @cur;
            @cur = ();
            push @segments, undef;
            next;
        }
        if ( $has_list and $is_marker[$i] and @cur ) {
            push @segments, [@cur];
            @cur = ();
        }
        push @cur, $i;
    }
    push @segments, [@cur] if @cur;

    local $Text::Wrap::columns  = $width + 1;    ##  Text::Wrap : "+ 1" ##
    local $Text::Wrap::break    = qr/\s+/;
    local $Text::Wrap::huge     = 'overflow';
    local $Text::Wrap::unexpand = 0;

    ## canonicalize each segment independently : re-derive structure from   ##
    ## the content itself rather than trusting where the incoming line      ##
    ## breaks happened to sit -- what makes repeated reformatting passes    ##
    ## converge instead of drift. a break is treated as intentional [       ##
    ## double-space , like a sentence boundary ] when EITHER the line ends  ##
    ## in terminal punctuation OR the line ends well short of the width     ##
    ## budget [ a forced wrap fills close to budget by definition ;         ##
    ## stopping well short of it with no punctuation is still a real signal ##
    ## the author meant to break there ] ; otherwise single-space [         ##
    ## ordinary forced wrap ]                                               ##
    my $short_margin = 15;
    my @wrapped_lines;
    for my $seg (@segments) {
        if ( not defined $seg ) {    ## blank framing line -- pass through ##
            push @wrapped_lines, '';
            next;
        }
        my $joined = '';
        for my $j ( 0 .. $#$seg ) {
            my $i = $seg->[$j];
            $joined .= $content_parts[$i];
            next if $j == $#$seg;
            my $ends_sentence = $content_parts[$i] =~ m{[.!?]$};
            my $ends_short = ( $width - $content_lens[$i] ) > $short_margin;
            $joined .= ( $ends_sentence or $ends_short ) ? '  ' : ' ';
        }
        my $wrapped = Text::Wrap::wrap( '', '', $joined );
        push @wrapped_lines, map { s{\s+$}{}; $_ } split m{\n}, $wrapped;
    }

    my @out;
    if ($any_close) {
        ## right-align the closing '##' to the longest wrapped line's width ##
        ## -- blank entries [ length 0 ] don't affect that max , and come   ##
        ## out as a properly centered blank framing line for free           ##
        my ($target_width)
            = ( sort { $b <=> $a } map {length} @wrapped_lines );
        my $pad = ' ' x $box_pad;
        for my $part (@wrapped_lines) {
            push @out,
                sprintf( "%s##%s%-*s%s##\n",
                $indent, $pad, $target_width, $part, $pad );
        }
    } else {
        for my $part (@wrapped_lines) {
            push @out, length($part) ? "$indent## $part\n" : "$indent##\n";
        }
    }
    return \@out;
}

##[ step 5 : recompute a '##[ title ]###...' fill-bar's hash-run so the
## line lands exactly on LINE_MAX -- this convention has no legitimate      ##
## alternate width to preserve : across the corpus the fill-run length      ##
## clusters overwhelmingly at LINE_MAX with only single-off drift around it ##
## [ manual title edits that never recalculated the trailing hashes ] ,     ##
## unlike box padding where multiple depths genuinely recur. matched        ##
## separately from the short '##[ title ]##' label style [ exactly 2        ##
## closing hashes, never meant to fill -- the corpus shows a hard gap       ##
## between 2-3 and 8+ trailing hashes, so requiring 4+ cleanly separates    ##
## the two conventions ]                                                    ##
sub step5_normalize_bracket_bar {
    my $line = shift;
    return undef
        if $line !~ m{^(\s*)\#\#\[\ (.*?)\ \]\#{4,}\s*(\r?\n)?$};
    my ( $indent, $title, $nl ) = ( $1, $2, $3 // "\n" );

    my $fixed_len
        = length($indent) + length('##[ ') + length($title) + length(' ]');
    my $fill_len = LINE_MAX - $fixed_len;
    return undef if $fill_len < 1;    ## title alone exceeds budget ##

    my $rebuilt
        = $indent . '##[ ' . $title . ' ]' . ( '#' x $fill_len ) . $nl;
    return undef if $rebuilt eq $line;    ## already exact -- no change ##
    return $rebuilt;
}

##[ step 3 : move trailing comment above when it pushes line past 78 ]##
sub step3_relocate_trailing_comment {
    my $line = shift;
    return ($line) if length_no_nl($line) <= LINE_MAX;

    ## match : code ws ## comment ## newline  only safe with the ## .. ## ##
    ## p7 annotation form                                                 ##
    if ( $line
        =~ m{^(\s*)([^\#\n].*?\S)(\s{2,})(\#\#\s.*?\s\#\#)\s*(\r?\n)?$} ) {
        my $indent    = $1;
        my $code      = $2;
        my $comment   = $4;
        my $nl        = $5 // "\n";
        my $code_line = "$indent$code$nl";
        ## relocating doesn't help -- leave line untouched rather than ##
        ## silently dropping the comment                               ##
        return ($line) if length_no_nl($code_line) > LINE_MAX;
        my $comment_line = "$indent$comment$nl";
        return ( $comment_line, $code_line );
    }
    return ($line);
}

##[ step 0 helper : is this a Quote::Single or Quote::Double token ]##
sub is_quote_token {
    my $t = shift;
    return $t->isa('PPI::Token::Quote::Single')
        || $t->isa('PPI::Token::Quote::Double');
}

##[ step 0 helper : find '.'-concatenation chains of quote tokens , via
##  PPI's own token stream [ robust against line-based false positives ] ]##
sub collect_concat_chains {
    my $doc = shift;
    my @all = $doc->tokens;
    my @chains;
    my $i = 0;
    while ( $i < @all ) {
        if ( is_quote_token( $all[$i] ) ) {
            my @chain = ( $all[$i] );
            my $j     = $i + 1;
            while (1) {
                my $k = $j;
                $k++
                    while $k < @all
                    and $all[$k]->isa('PPI::Token::Whitespace');
                last if $k >= @all;
                last
                    if not $all[$k]->isa('PPI::Token::Operator')
                    or $all[$k]->content ne '.';
                $k++;
                $k++
                    while $k < @all
                    and $all[$k]->isa('PPI::Token::Whitespace');
                last if $k >= @all;
                last if not is_quote_token( $all[$k] );
                push @chain, $all[$k];
                $j = $k + 1;
            }
            if ( @chain >= 2 ) {
                push @chains, \@chain;
                $i = $j;
                next;
            }
        }
        $i++;
    }
    return @chains;
}

##[ shared : split $flat_value across as many physical lines as it actually
## needs. tries the original balanced 2-way split first [ same tested logic ##
## that already fixed "unbalanced split" earlier -- only accepted when BOTH ##
## resulting lines are verified to fit ] ; falls back to greedy-maximal     ##
## repeated fill for 3+ lines. an earlier version of this used a separate   ##
## up-front pass to COUNT how many lines were needed , then a second        ##
## balanced pass to fill them -- those two passes could disagree [ balance  ##
## takes smaller-than-max chunks, so the precomputed count came up short ]  ##
## and the forced-final line silently absorbed the overflow instead of      ##
## erroring. greedy-maximal never has that gap : it only ever stops once    ##
## the actual remainder is verified to fit                                  ##
sub split_into_lines {
    my ( $flat_value, $quote_ch, $before, $after, $nl, $cont_indent ) = @_;

    my $prefix_len_first = length($before);

    ##  does it fit fully on one line ?  ##
    my $one_line_len
        = $prefix_len_first + 1 + length($flat_value) + 1 + length($after);
    if ( $one_line_len <= LINE_MAX ) {
        return [  $before
                . $quote_ch
                . $flat_value
                . $quote_ch
                . $after
                . ( $nl || "\n" ) ];
    }

    ##  try the balanced 2-way split  ##
    my $max_inner1 = LINE_MAX - $prefix_len_first - 3;
    if ( $max_inner1 >= 1 ) {
        my $max_inner2
            = LINE_MAX - $prefix_len_first - 4 - length($after) - CONT_MARGIN;
        if ( $max_inner2 >= 1 ) {
            my $lower_bound = length($flat_value) - $max_inner2;
            my @safe_splits = find_split_positions( $flat_value, $quote_ch );
            my $target      = length($flat_value) / 2;
            my ( $best, $best_dist );
            for my $p (@safe_splits) {
                next if $p > $max_inner1;
                next if $p < $lower_bound;
                my $dist = abs( $p - $target );
                if ( not defined $best_dist or $dist < $best_dist ) {
                    $best      = $p;
                    $best_dist = $dist;
                }
            }
            if ( defined $best ) {
                my $part1 = substr( $flat_value, 0, $best );
                my $part2 = substr( $flat_value, $best );
                return [
                    $before . $quote_ch . $part1 . $quote_ch . "\n",
                    $cont_indent
                        . qw| . | . ' '
                        . $quote_ch
                        . $part2
                        . $quote_ch
                        . $after
                        . ( $nl || "\n" ),
                ];
            }
        }
    }

    ## 2 lines isn't enough -- greedy-maximal repeated fill for however ##
    ## many [ 3 , 4 , .. ] it actually takes ; always verified to fit   ##
    ## before stopping , so it can never overflow the way the two-pass  ##
    ## approach did                                                     ##
    my @out;
    my $remaining = $flat_value;
    my $is_first  = 1;
    my $guard     = 0;
    while (1) {
        return undef if $guard++ > 1000;    ## runaway-loop safety guard ##
        my $prefix = $is_first ? $before : ( $cont_indent . qw| . | . ' ' );
        my $prefix_len = length($prefix);
        my $margin     = $is_first ? 0 : CONT_MARGIN;

        my $final_len
            = $prefix_len + 1
            + length($remaining)
            + 1 + length($after)
            + $margin;
        if ( $final_len <= LINE_MAX ) {
            push @out,
                  $prefix
                . $quote_ch
                . $remaining
                . $quote_ch
                . $after
                . ( $nl || "\n" );
            last;
        }

        my $max_inner
            = LINE_MAX - $prefix_len - 2 - $margin;    ## open+close quote ##
        return undef if $max_inner < 1;

        my @safe_splits = find_split_positions( $remaining, $quote_ch );
        return undef if not @safe_splits;

        my $best;
        for my $p (@safe_splits) {
            next if $p > $max_inner;
            $best = $p;    ## greedy-maximal , always safe , makes progress ##
        }
        return undef if not defined $best;

        push @out,
              $prefix
            . $quote_ch
            . substr( $remaining, 0, $best )
            . $quote_ch . "\n";
        $remaining = substr( $remaining, $best );
        $is_first  = 0;
    }
    return \@out;
}

##[ step 0 : rejoin an existing multi-line '.'-concat chain , then re-split
## it from scratch at the ideal balanced point -- once each fragment of an  ##
## existing split individually fits under LINE_MAX, step1 never reconsiders ##
## it, so a suboptimal split [ manual edit, an older tool version, .. ]     ##
## would otherwise be stuck forever ; this fixes that the same way step4    ##
## does for comment blocks -- collapse to canonical form first, then        ##
## re-derive, so repeated runs converge instead of drifting                 ##
sub step0_rejoin_concat_chain {
    my ( $lines, $chain ) = @_;

    my @toks       = @$chain;
    my $start_line = $toks[0]->location->[0];
    my $end_line   = $toks[-1]->location->[0];
    return undef if $start_line == $end_line;

    ## same quote char throughout , no embedded raw newlines in any     ##
    ## fragment -- otherwise too risky to rejoin reliably , leave alone ##
    my $quote_ch;
    for my $t (@toks) {
        my $c = $t->content;
        return undef if $c =~ m{\n};
        my $q = substr( $c, 0, 1 );
        return undef if $q ne q|'| and $q ne q|"|;
        $quote_ch //= $q;
        return undef if $q ne $quote_ch;
    }

    my $first_line_text = $lines->[ $start_line - 1 ];
    my $last_line_text  = $lines->[ $end_line - 1 ];

    my $start_col = $toks[0]->location->[1];    ## 1-based ##
    my $before    = substr( $first_line_text, 0, $start_col - 1 );

    my $end_col      = $toks[-1]->location->[1];
    my $last_tok_len = length( $toks[-1]->content );
    my $after = substr( $last_line_text, $end_col - 1 + $last_tok_len );
    my $nl    = '';
    if ( $after =~ s{(\r?\n)$}{} ) { $nl = $1 }

    ## flat value : direct concatenation of each fragment's inner text , ##
    ## exactly what perl's own '.' operator produces at runtime          ##
    my $flat_value = join '', map { substr( $_->content, 1, -1 ) } @toks;

    my $prefix_len          = $start_col - 1;
    my $continuation_indent = ' ' x $prefix_len;

    ## re-derive however many physical lines this actually needs from       ##
    ## scratch -- covers the already-fits-on-one-line case too [ that comes ##
    ## back as a single-element result ]                                    ##
    return split_into_lines( $flat_value, $quote_ch, $before, $after, $nl,
        $continuation_indent );
}

##[ step 1 : split a long-line quoted string at whitespace boundary ]##
sub step1_split_long_string {
    my $line   = shift;
    my $quotes = shift;
    return undef if length_no_nl($line) <= LINE_MAX;
    return undef if not $quotes or not @$quotes;

    ## pick longest quote token on the line that contains a splittable ##
    ## whitespace position and whose split fits within LINE_MAX        ##
    my @candidates = sort { $b->{length} <=> $a->{length} } @$quotes;
    for my $tok (@candidates) {
        my $col      = $tok->{col};
        my $content  = $tok->{content};
        my $quote_ch = substr( $content, 0, 1 );
        next if $quote_ch ne q|'| and $quote_ch ne q|"|;
        my $inner = substr( $content, 1, -1 );
        next if $inner !~ m{\s};

        my $prefix_len = $col - 1;    ## 0-based column of first char ##

        ##  what follows the token on the source line  ##
        my $tok_start_idx = $tok->{idx};    ##  0-based start of token
        my $tok_end_idx   = $tok->{idx} + $tok->{length};
        my $before        = substr( $line, 0, $tok_start_idx );
        my $after         = substr( $line, $tok_end_idx );

        ##  trailing newline preserved on $after if present  ##
        my $nl = '';
        if ( $after =~ s{(\r?\n)$}{} ) { $nl = $1 }

        my $continuation_indent = ' ' x ($prefix_len);

        ## re-derive however many physical lines this actually needs from ##
        ## scratch -- generalizes the old single 2-way split, which       ##
        ## silently produced an over-budget line whenever the content     ##
        ## needed 3+ lines instead of 2                                   ##
        my $result = split_into_lines( $inner, $quote_ch, $before, $after,
            $nl, $continuation_indent );
        next if not defined $result;
        next if @$result < 2;    ## this token alone didn't need splitting ##

        return $result;
    }
    return undef;
}

##[ find positions in $inner where a split keeps interpolation intact ]##
sub find_split_positions {
    my ( $inner, $quote ) = @_;
    my @positions;
    my $len = length $inner;
    my $i   = 0;
    ##  build a mask of "in interpolation" for double-quoted  ##
    my @in_interp = (0) x $len;
    if ( $quote eq q|"| ) {
        while ( $i < $len ) {
            my $c = substr( $inner, $i, 1 );
            if ( $c eq qw| \\ | ) {
                $in_interp[$i] = 1;
                $in_interp[ $i + 1 ] = 1 if $i + 1 < $len;
                $i += 2;
                next;
            }
            if ( $c eq qw| $ | or $c eq qw| @ | ) {
                ##  start interp : ${expr} , $var , @arr , @{expr}  ##
                my $start = $i;
                $in_interp[$i] = 1;
                $i++;
                if ( $i < $len and substr( $inner, $i, 1 ) eq '{' ) {
                    ##  bracketed - find matching brace  ##
                    my $depth = 1;
                    $in_interp[$i] = 1;
                    $i++;
                    while ( $i < $len and $depth > 0 ) {
                        my $cc = substr( $inner, $i, 1 );
                        $in_interp[$i] = 1;
                        if    ( $cc eq '{' ) { $depth++ }
                        elsif ( $cc eq '}' ) { $depth-- }
                        $i++;
                    }
                    next;
                }
                ##  bareword variable name [ + optional [] {} -> chain ]  ##
                while ( $i < $len and substr( $inner, $i, 1 ) =~ m{\w} ) {
                    $in_interp[$i] = 1;
                    $i++;
                }
                ##  allow subscript/method chain to remain protected  ##
                while ( $i < $len ) {
                    my $cc = substr( $inner, $i, 1 );
                    if ( $cc eq '[' or $cc eq '{' ) {
                        my $open  = $cc;
                        my $close = $cc eq '[' ? ']' : '}';
                        my $depth = 1;
                        $in_interp[$i] = 1;
                        $i++;
                        while ( $i < $len and $depth > 0 ) {
                            my $cc2 = substr( $inner, $i, 1 );
                            $in_interp[$i] = 1;
                            if    ( $cc2 eq $open )  { $depth++ }
                            elsif ( $cc2 eq $close ) { $depth-- }
                            $i++;
                        }
                        next;
                    }
                    if ( substr( $inner, $i, 2 ) eq '->' ) {
                        $in_interp[$i] = 1;
                        $in_interp[ $i + 1 ] = 1;
                        $i += 2;
                        next;
                    }
                    last;
                }
                next;
            }
            $i++;
        }
    } else {
        ##  single-quoted : only \' and \\ are escapes  ##
        while ( $i < $len ) {
            my $c = substr( $inner, $i, 1 );
            if ( $c eq qw| \\ | and $i + 1 < $len ) {
                my $nx = substr( $inner, $i + 1, 1 );
                if ( $nx eq qw| \\ | or $nx eq qw| ' | ) {
                    $in_interp[$i] = 1;
                    $in_interp[ $i + 1 ] = 1;
                    $i += 2;
                    next;
                }
            }
            $i++;
        }
    }

    ## collect split points : just after a whitespace , when neither side ##
    ## is inside an interpolation segment                                 ##
    for ( my $p = 1; $p < $len; $p++ ) {
        my $prev = substr( $inner, $p - 1, 1 );
        next if $prev !~ m{\s};
        next if $in_interp[ $p - 1 ];
        next if $in_interp[$p];
        push @positions, $p;
    }
    return @positions;
}

##[ step 2 : reflow over-long ## comment lines using Text::Wrap ]##
sub step2_reflow_comment {
    my $line = shift;
    return undef if length_no_nl($line) <= LINE_MAX;

    ##  detect ## comment line [ pure comment ]  ##
    ##  exclusions :
    ##    ## [:< ##         module header
    ##    #!                shebang
    ##    #,                signature
    ##  any leading code disqualifies [ handled by step 3 instead ]  ##

    if ( $line !~ m{^(\s*)(\#\#\s)(.*?)\s*(\r?\n)?$} ) {
        return undef;
    }
    my $indent  = $1;
    my $prefix  = $2;
    my $content = $3;
    my $nl      = $4 // "\n";

    ##  exclusion patterns  ##
    return undef if $content =~ m{^\[:< \#\#$};    ## module header ##

    ## NOTE : no bracket-annotation exclusion here -- this function is only ##
    ## ever called once the line is ALREADY over LINE_MAX [ see the guard   ##
    ## at the top ], so an annotation reaching this point is by definition  ##
    ## too long to leave untouched ; a within-budget one never gets here at ##
    ## all and stays fully protected as intended                            ##

    my $width = LINE_MAX - length($indent) - length($prefix);
    return undef if $width < 20;    ##  too narrow , skip  ##

    ##  preserve trailing ## marker if present  ##
    my $trailing = '';
    if ( $content =~ s{\s*(\#\#)\s*$}{} ) {
        $trailing = " $1";
    }

    ## the trailing marker gets reattached to the LAST wrapped line only , ##
    ## so wrap at the tighter budget everywhere -- otherwise a line can    ##
    ## look like it "fits" and skip wrapping , then exceed LINE_MAX once   ##
    ## the marker comes back                                               ##
    my $wrap_width = $width - length($trailing);
    return undef if $wrap_width < 20;    ##  too narrow , skip  ##

    local $Text::Wrap::columns  = $wrap_width + 1;    ##  Text::Wrap : "+1" ##
    local $Text::Wrap::break    = qr/\s/;
    local $Text::Wrap::huge     = 'overflow';
    local $Text::Wrap::unexpand = 0;
    my $wrapped = Text::Wrap::wrap( '', '', $content );
    my @parts   = split m{\n}, $wrapped;
    return undef if @parts <= 1;    ##  did not need wrapping  ##

    my @out;
    for my $p ( 0 .. $#parts ) {
        my $part   = $parts[$p];
        my $suffix = ( $p == $#parts ) ? $trailing : '';
        push @out, "$indent$prefix$part$suffix$nl";
    }
    return \@out;
}

##[ utilities ]##
sub length_no_nl {
    my $s = shift;
    $s =~ s{\r?\n\z}{};
    return length $s;
}

sub slurp_file {
    my $f = shift;
    open my $fh, qw| < |, $f or die "cannot read $f : $OS_ERROR\n";
    binmode $fh, qw| :raw |;
    local $/;
    my $data = <$fh>;
    close $fh;
    ## decode to characters -- everything downstream [ length() , substr()  ##
    ## , Text::Wrap column budgets ] must count characters , not bytes , or ##
    ## a multi-byte utf8 char [ em-dash, arrows, .. ] silently wrecks the   ##
    ## wrap-width arithmetic on any line that contains one                  ##
    $data = decode_utf8($data) if not $no_utf8;
    return $data;
}

##[ detect signature footer : trailing block of #-prefixed lines ending in
## a line of colons . returns 1-based line number of first sig line , or ##
## undef if no signature footer found ]                                  ##
sub detect_signature_start {
    my $lines = shift;
    my $n     = scalar @$lines;
    return undef if $n < 5;
    my $idx = $n - 1;
    ##  trim trailing blank line  ##
    while ( $idx >= 0 and $lines->[$idx] =~ m{^\s*$} ) { $idx-- }
    return undef if $idx < 4;
    return undef if $lines->[$idx] !~ m{^\#:{10,}};

    my $start = $idx;
    while ( $start > 0
        and $lines->[ $start - 1 ] =~ m{^\#(?:[,\\\[].*|:{10,})} ) {
        $start--;
    }
    return $start + 1;
}

##[ mark =pod ... =cut regions in %skip [ 1-based line numbers ] ]##
sub mark_pod_regions {
    my ( $lines, $skip ) = @_;
    my $in_pod = 0;
    for my $i ( 0 .. $#$lines ) {
        my $l = $lines->[$i];
        if ( not $in_pod and $l =~ m{^=\w+} and $l !~ m{^=cut\b} ) {
            $in_pod = 1;
        }
        if ($in_pod) {
            $skip->{ $i + 1 } = 'pod';
        }
        if ( $in_pod and $l =~ m{^=cut\b} ) {
            $in_pod = 0;
        }
    }
}

##[ mark heredoc body lines using PPI heredoc tokens ]##
sub mark_heredoc_regions {
    my ( $doc, $skip ) = @_;
    my $heredocs = $doc->find(qw| PPI::Token::HereDoc |);
    return if not $heredocs;
    for my $h (@$heredocs) {
        ##  PPI exposes the heredoc body lines via ->heredoc method  ##
        my @body = $h->heredoc;
        ## location of heredoc token is at the << on the source line .    ##
        ## body begins on the line AFTER the line containing << , and the ##
        ## terminator follows the body                                    ##
        my $loc = $h->location;
        next if not $loc;
        my $start = $loc->[0] + 1;
        my $end   = $start + scalar(@body);    ## terminator inclusive ##
        for my $ln ( $start .. $end ) {
            $skip->{$ln} = 'heredoc';
        }
    }
}

##[ collect single + double quoted tokens with line/col info ]##
sub collect_quote_tokens {
    my $doc = shift;
    my @result;
    my $toks = $doc->find(
        sub {
            my ( $top, $node ) = @_;
            return 1 if $node->isa(qw| PPI::Token::Quote::Single |);
            return 1 if $node->isa(qw| PPI::Token::Quote::Double |);
            return 0;
        }
    );
    return () if not $toks;
    for my $t (@$toks) {
        my $loc = $t->location;
        next if not $loc;
        my $content = $t->content;
        push @result, {
            line    => $loc->[0],
            col     => $loc->[1],
            idx     => $loc->[1] - 1,     ## 0-based column ##
            length  => length $content,
            content => $content,
        };
    }
    return @result;
}

##[ shared utilities adapted from bin/dev/ptd ]##

##[ explain a system() wait status without touching stale $! ]##
## $! only reflects a fork/exec failure [ $rc == -1 ] -- once the child     ##
## actually ran, a nonzero $rc is a wait status, and $! may still hold      ##
## errno from something unrelated earlier in this run [ e.g. ReadMode's own ##
## ioctl() failing with ENOTTY under a non-tty stdin, as under xargs --     ##
## that stays set until the next syscall failure, not the next call ] $rc   ##
## here is Perl::Tidy::perltidy()'s own plain error flag [ in-memory API,   ##
## not a wait status -- no fork/exec, no signal/exit-code decoding needed   ##
## any more ] : 1 = could not run to completion [ severe/fatal ], 2 = ran   ##
## to completion but reported error messages -- almost always a real syntax ##
## error in the input, see real_syntax_errors for the detail                ##
sub perltidy_fail_reason {
    my $rc = shift;
    ## same wording as bin/dev/ptd's non-check-only path [ return_code 512 ##
    ## ]                                                                   ##
    return 'syntax error in perl code'                if $rc and $rc >= 2;
    return 'perltidy could not complete [ status 1 ]' if $rc and $rc == 1;
    return sprintf( 'perltidy failed [ status %s ]', $rc // 'undef' );
}

## compact multi-line perl -c output the same way base.format_error         ##
## compacts die/warn text : strip each line's trailing "at FILE line N"     ##
## clause and re-anchor it as a short "[file:line]" tag on the REAL source  ##
## path [ not the throwaway .chk./.tmp. copy perl -c actually saw ],        ##
## normalize quotes, then join everything onto one line -- same regex ideas ##
## as base.format_error, ported standalone since this script has no zenka   ##
## context [ %code / %data / base.caller ] for the real subroutine          ##
sub join_real_errors {
    my ( $real_path, @raw_lines ) = @_;

    ## first pass : pull the location out of each fragment WITHOUT          ##
    ## inserting the [file:line] tag yet -- inserted once per MERGED group  ##
    ## below, not once per raw perl -c line ; not end-anchored : perl -c    ##
    ## routinely appends more context after "line N" [ ", at end of line" / ##
    ## ", near ..." ], so a trailing-only match [ like base.format_error's, ##
    ## which assumes die/warn's plain "at FILE line N." tail ] would never  ##
    ## fire                                                                 ##
    my @parsed;
    for my $line (@raw_lines) {
        chomp $line;
        my $lineno;
        $line =~ s| at \S+ line (\d+)|| and $lineno = $1;
        $line =~ s,\",\',g;    ## quotes -> single [ same as format_error ] ##
        push @parsed, [ $line, $lineno ];
    }

    ## merge consecutive fragments sharing a line number : perl -c          ##
    ## routinely emits two sentences for ONE problem [ "Unmatched ...       ##
    ## bracket ..., at end of line" + "syntax error ..., near '...'" ],     ##
    ## each redundantly carrying the same location -- collapse those into   ##
    ## one concise message via merge_fragment ; anything else with the same ##
    ## location just gets joined, still only tagged once                    ##
    my @merged;
    for my $p (@parsed) {
        my ( $text, $lineno ) = @$p;
        if (    @merged
            and defined $lineno
            and defined $merged[-1][1]
            and $lineno == $merged[-1][1] ) {
            $merged[-1][0] = merge_fragment( $merged[-1][0], $text );
        } else {
            push @merged, [ $text, $lineno ];
        }
    }

    my $detail = join( '; ',
        map { defined $_->[1] ? "$_->[0] [$real_path:$_->[1]]" : $_->[0] }
            @merged );
    $detail =~ s|\s+BEGIN failed.+$||s;
    $detail =~ s|(?<=in \@INC).+$||s;
    return $detail;
}

## merge two same-location perl -c fragments into one concise message : the ##
## extremely common "Unmatched ... bracket ..., at end of line" + "syntax   ##
## error ..., near '...'" pairing is really ONE diagnostic said twice --    ##
## drop the filler and keep just the specific "near" detail                 ##
sub merge_fragment {
    my ( $first, $second ) = @_;
    ## no /x here : it strips the literal spaces inside "curly bracket"     ##
    ## etc, silently turning the alternation into un-matchable joined words ##
    ## instead of ignoring insignificant whitespace as intended             ##
    my $bracket_kind = 'curly bracket|square bracket|parenthesis';
    ## two SEPARATE matches don't share $1/$2 numbering -- each capture ##
    ## into its own lexical, or the second match's own $1 clobbers the  ##
    ## first's before either gets read                                  ##
    my ($kind)
        = $first =~ m{^(Unmatched \S+ (?:$bracket_kind)), at end of line$};
    my ($near) = $second =~ m{^syntax error, (near .+)$};
    return "$kind $near" if defined $kind and defined $near;
    return "$first; $second";    ## unknown pairing : keep both, fallback ##
}

##[ run perl -c and strip P7-specific false positives, return real errors ]##
## ported from bin/dev/ptd -- not required to stay in lockstep with it    ##
## going forward, this tool's own syntax reporting may grow independently ##
sub real_syntax_errors {
    my $file_path = shift;

    ## translate P7 macro syntax [ <data.key>, <[module.name]> ] to real    ##
    ## perl BEFORE checking -- raw 'perl -c' has no idea what those mean    ##
    ## and misparses them as glob derefs/subtraction, the actual root cause ##
    ## of the false positives the two filters below patch over.             ##
    ## translation is newline-preserving so line numbers still line up.     ##
    open( my $src_fh, qw| < |, $file_path )
        or die ":\n:: \l$OS_ERROR :: $file_path\n:\n";
    my $src = do { local $RS = undef; <$src_fh> };
    close $src_fh;
    my $translated = p7_syntax__translate($src);
    my ( $tmp_fh, $tmp_path ) = tempfile( SUFFIX => qw| .p7chk.pl | );
    print {$tmp_fh} $translated;
    close $tmp_fh;

    ## -Mfeature=:5.24 : P7 modules have no 'use v5.10'/'use feature' of   ##
    ## their own [ no standard 'use' header, custom [:< format instead ],  ##
    ## so a bare 'perl -c' doesn't recognize 'state'/'say'/etc and         ##
    ## misparses everything after the first use -- the colon-prefixed      ##
    ## version bundle enables the full modern feature set WITHOUT the side ##
    ## effect plain '-Mv5.24'/'use v5.24' has of also turning on strict,   ##
    ## which these files were never written to pass                        ##
    my @perl_c_output = qx{ perl -Mfeature=:5.24 -c "$tmp_path" 2>&1 };
    unlink $tmp_path;
    ## errors report the temp path -- swap in the real one for display ##
    s{\Q$tmp_path\E}{$file_path}g for @perl_c_output;
    my @real_errors;
    for my $line (@perl_c_output) {
        ## p7 data/module macro syntax [ <data.key>, <[module.name]> ]      ##
        ## triggers glob-modification false positives under perl -c --      ##
        ## should no longer fire now that translation runs first, kept as a ##
        ## defense net in case a macro form slips past the regex            ##
        next if $line =~ m{Can't modify glob in .*assignment};
        ## same macro syntax on a bare 'delete <data.key>;' line -- raw ##
        ## perl -c sees an undeclared glob deref, not a hash/array elem ##
        next if $line =~ m{delete argument is not a HASH or ARRAY};
        ## cascading noise once compilation aborts on the line above   ##
        next if $line =~ m{BEGIN not safe after errors};
        next if $line =~ m{syntax OK\s*$};
        next if $line =~ m{^\s*$};
        push @real_errors, $line;
    }

    ## drop the trailing "had compilation errors" restatement whenever it  ##
    ## is the last line -- with a detailed error already present it's pure ##
    ## noise, and on its own it leaves nothing meaningful to report        ##
    pop @real_errors
        if @real_errors
        and $real_errors[-1] =~ m{had compilation errors\.?$};

    return @real_errors;
}

sub color_msg {
    my $err_msg    = shift;
    my $file_path  = shift;
    my $color      = shift // $NEON_orange;
    my $file_color = shift // $color;    ## lets a caller decouple the two ##

    ## wrap a long reason the same way base.wrap_text wraps zenki log lines ##
    ## : practical necessity, not cosmetic -- the compacted perl -c detail  ##
    ## from join_real_errors routinely runs well past LINE_MAX on its own,  ##
    ## and an unwrapped line is unreadable/unusable in a terminal --        ##
    ## ERR_WRAP_MAX , not LINE_MAX : source-code width is too wide here     ##
    my $lead_in = qw| ::[ |;    ## visible prefix before $err_msg starts ##
    my $indent  = ' ' x ( length($lead_in) + 1 );    ## +1 : the space too ##
    local $Text::Wrap::columns  = ERR_WRAP_MAX - length($indent) + 1;
    local $Text::Wrap::break    = qr/\s+/;
    local $Text::Wrap::huge     = qw| overflow |;
    local $Text::Wrap::unexpand = 0;
    my $wrapped_msg = Text::Wrap::wrap( '', $indent, $err_msg );

    ## close the \r-based progress line with a real \n only the FIRST time ##
    ## something prints for this file -- a second call finds the line      ##
    ## already closed and must not add another blank one                   ##
    my $lead = $progress_line_open ? "\n" : '';
    $progress_line_open = FALSE;

    my $colored_msg
        = "$lead$blacklight:\n$lead_in$color $wrapped_msg $blacklight] "
        . ".: $file_color$file_path$blacklight ::\n:$reset\n";
}

sub is_perl_code {
    my $file = shift;
    return FALSE if not -f $file or -z $file;
    my $is_code = 0;
    open( my $fh, qw| < |, $file ) or die ":\n:: \l$OS_ERROR :: $file\n:\n";
    my $first_line = '';
    while ( $first_line ne '## [:< ##'
        and $first_line =~ m{^\s*($|(use|my|our)\s.+;|#(*nla:!))} ) {
        $first_line = readline($fh);
        if   ( not defined $first_line ) { last; }
        else                             { chomp($first_line); }
    }
    if ( defined $first_line ) {
        $is_code = TRUE
            if $first_line eq '## [:< ##'
            or $first_line =~ m|^#!.*perl|
            or $first_line =~ m|^package .+;(\s*#.*)?$|
            or $file       =~ m|\.pm$|;
    }
    print color_msg( 'skipping config.,', $file, $blacklight )
        and return FALSE
        if $is_code
        and index( abs_path($file), qw| /configuration/ |, 0 ) != -1;
    close($fh) or die ":\n:: \l$OS_ERROR :: $file\n:\n";
    return $is_code;
}

sub sig_int {
    print "\b\b::\b\b\r$blacklight\:::\n:\n:: "
        . "[ ${NEON_orange}SIGINT$blacklight ] $NEON_green_yellow "
        . "format-code run aborted$blacklight ..,\n:$reset\n";
    exit('000113');
}

sub show_progress {
    my $filename    = shift;
    my $file_num    = shift;
    my $files_total = shift;
    my $chars_max   = 13;
    my $character   = qw| : |;
    my $char_count  = int( $chars_max * $file_num / $files_total );
    my $perc_chars  = $character x $char_count;
    printf( "\r${blacklight}:::[$nailara_bg$TRUE_color%-${chars_max}s"
            . "$reset$blacklight]:"
            . "::[$nailara_bg$TRUE_color %-${file_maxlen}s"
            . " $reset$blacklight]:.$reset\r",
        $perc_chars, $filename );
}

