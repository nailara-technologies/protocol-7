#!/usr/bin/perl
use v5.32.0;
use utf8;
use strict;
use English;
use warnings;

###      ###
##  n7fs  ##
###      ###

## N7FS : checksum-addressed store, standalone
## [ like p7-vault -- no zenka, no running network ]. new disks use format 3 :
## the delegated store key signs meta, state, references and the journal.
## format : data/md/design/N7FS-SPEC.md + N7FS-FORMAT-3.md [ as built ].
##
## n7fs keygen <file>                     new ed25519 key file [ 0600 ]
## n7fs pubkey <file>                     its public key [ base32 ]
## n7fs init -name <n> -intent <text>    a new disk under the root
## n7fs list                              disks under the root
## n7fs attach <disk> [ -allow-rollback ]
## n7fs detach <disk>
## n7fs status <disk> [ -allow-rollback ]
## n7fs verify <disk>                     every node of the active epochs
## n7fs get <disk> <address|path-name> [ -out <file> ] [ -all ]
##                       verified content [ raw stdout ; -all includes drops ]
## n7fs find <disk> [ -name <regex> ] [ -format <fmt> ]
##                  [ -chksum <prefix> ] [ -all ]
##                  live references by default ; -all adds dropped history
## n7fs drop <disk> <address> -holder <name>
##                  sign and journal a reference drop ; removes nothing
## n7fs release <disk> <address> [ -force ] [ -reason <text> ]
##                  tombstone, journal and remove now ; live references refuse
## n7fs reclaim <disk> [ -free <size> ] [ -older <age> ] [ -dry-run ]
##                  oldest garbage first ; sizes accept K/M/G, ages s/m/h/d/w
## n7fs release-epoch <disk> <epoch> -now
##                  end rollback to a confirmed conversion's previous form
## n7fs repair <disk>                  finish releases, adopt unjournaled data
## n7fs trees <disk>                   list live tree manifests
## n7fs tree-drop <disk> <name>        journal tree removal ; removes no bytes
## n7fs restore <disk> <tree> <target> [ -owners ] [ -dry-run ]
## n7fs category <disk> set <name>     [ -local-encryption none|cascade ]
##                  [ -copies <n> ] [ -priority <n> ] [ -replica full|manifest ]
##                  [ -want <holder,..> ] [ -foreign-work no|yes ]
##                  [ -layer private|generic ]
## n7fs category <disk> list           category definitions
## n7fs category <disk> show <address> reference and effective policies
## n7fs set-category <disk> <address|tree:path-prefix> <name>
## n7fs incoming <disk> list [ -under <prefix> ] [ -depth <n> ] [ -limit <n> ]
## n7fs incoming <disk> tag <prefix|glob|address> <category>
## n7fs incoming <disk> tag -from <file>  lines of <selector> <category> ; one run
## n7fs incoming <disk> list -group-by name:<n>  buckets by filename start
## n7fs incoming <disk> done         exit 0 when empty, 1 while nonempty
## n7fs sync <from-disk> <to-disk> [ -dry-run ] [ -trees-only ]
## n7fs sync-conflicts <disk>         unresolved concurrent sync changes
## n7fs sync-conflicts <disk> resolve <record-name> [ keep receiver value ]
## n7fs assimilate -disk <disk> [ -remove | -keep ] [ -prune ] [ -dry-run ]
##                 [ -incoming ]    unclassified roots, each gets its own tree
##                 [ -tree <name> ] [ -category <name> ]
##                 [ -category-rule <glob>=<name> ] [ first match wins ]
##                 [ -index <image-index.db> [ -index-base <dir> ] ]
##                 [ <path> .. ]   index + -remove needs -index-base
##                 -prune removes empty dirs below named roots, never roots
## n7fs upgrade <disk> [ -epoch <n> ]     convert into the next epoch of
##                                         the window [ -epoch : tests ]
## n7fs confirm <disk>                    confirm an upgrade
## n7fs root init <file|vault:<name>>      [ -vault-dir <dir> ]
## n7fs root convert <from> <to>           file or vault:<name> ; rewraps only
## n7fs root export-check <file>           open a copy with the passphrase
## n7fs seal <disk> -root-key <file> -out <dir> [ -category <name> |
##                  -tree <name> .. | -all-trees | <address>.. ]
## n7fs unseal <disk> -root-key <file> -from <dir> <tree-or-address> <target>
## n7fs seal-recover -root-key <file> -from <dir> [ -tree <name> ] <target-dir>
## n7fs shred <disk> -root-key <file> -out <dir> <address>
## n7fs holder-check <holder> -root-key <file>   also writes a receipt
## n7fs holder add <name> <holder> -role durable|intake -domain <label>
##                 [ -owned ] [ -quota <size> ] [ -reserve <size> ]
##                 [ -categories <a,b> ] [ -min-priority <n> ]  what place
##                 may put there ; one passing category is enough
## n7fs holder list | remove <name>         registry in the vault
## n7fs holder-drain <disk> <name> -root-key <key> [ -dry-run ]
##                 drop what is safely held elsewhere ; never below a target
## n7fs holder-gc <holder> -root-key <key> -only-root [ -delete ]
##                 unreferenced blobs of a one-root holder ; dry run by default
## n7fs relay <from> <to> -root-key <key> [ -dry-run ]  registered holders :
##                 copy sealed nodes blind, rewrap their keys at home, map
##                 them on <to> ; they count after its next holder-check
##                 -list : only write the blob list for n7fs-push on <from>
##                 -adopt : only map what a push delivered to <to>
## n7fs placement <disk> -root-key <key>    copies per category, report only
## n7fs place <disk> -root-key <key> [ -dry-run ]  seal what is missing
##                 -exclude <holder> : do not count it [ before draining it ]
## -bwlimit <size>                         cap uploads to ssh holders, per second
##
## sealing : -pass-fd <n> reads the passphrase from that descriptor -argon-m
## <KiB> -argon-t <n> -argon-p <n> override root init
##
## common : -root <dir>        [ N7FS_ROOT, default /N7FS -- never created ]
##          -host-dir <dir>    [ N7FS_HOST_DIR, default ~/.n/n7fs ]
##          -host-key <file>   [ default <host-dir>/host.key ]
##          -parent-key <file> [ default <host-dir>/parent.key ]
##          -parent-cmd <cmd>  external parent signer [ words, list-form
##                              exec, no shell -- the host-root plug ]
##          -trust <b32 key>   trusted parent key [ repeatable ; else
##                              <host-dir>/trusted-parents ]
##
## assimilate KEEPS the sources unless -remove is given ; a source is only
## removed after its stored copy and the source itself verified again.
##
## single-dash long options, the house form -- no -- forms exist.

use FindBin;
use Cwd qw| abs_path |;
use Digest::BMW;
use Getopt::Long qw| GetOptionsFromArray |;

## our own long options take ONE dash : the prefix pattern rejects the gnu
## '--' form for every option of this cli
Getopt::Long::Configure('prefix_pattern=^-');

BEGIN {
    ## repo layout first, then a copy [ AMOS7/ beside the script ] ##
    unshift @INC, "$FindBin::Bin/../data/lib-path/pm", "$FindBin::Bin";
    unshift @INC, $ENV{'N7FS_TEST_LIB'} if $ENV{'N7FS_TEST_LIB'};
}

use AMOS7::N7FS qw| root_dir host_dir b32 unb32 write_new_file_stream
    ntime_now ntime14 |;
use AMOS7::N7FS::Sum  qw| bmw_b32 epoch_from_b32 |;
use AMOS7::N7FS::Sign qw| key_file_signer key_file_write command_signer |;
use AMOS7::N7FS::Disk qw| disk_init disk_attach disk_detach disk_status
    disk_read_id disk_lock state_read witness_check_format witness_check_journal |;
use AMOS7::N7FS::Store qw| assimilate store_verify meta_entries node_path
    node_verify reference_entries reference_drop store_repair |;
use AMOS7::N7FS::Journal qw| journal_head journal_replay |;
use AMOS7::N7FS::Category
    qw| category_set category_list category_set_reference
    category_report |;
use AMOS7::N7FS::Incoming qw| incoming_refs incoming_summary incoming_groups
    incoming_tag |;

$AMOS7::N7FS::FAULT = sub {
    my $point = shift;
    die "n7fs : injected fault $point\n"
        if ( $ENV{'N7FS_TEST_FAULT'} // '' ) eq $point;
    }
    if defined $ENV{'N7FS_TEST_FAULT'};

##[ global constants ]##
use constant TRUE  => 5;    ##  TRUE.  ##
use constant FALSE => 0;    ##  false  ##

binmode STDOUT, qw| :encoding(UTF-8) |;
binmode STDERR, qw| :encoding(UTF-8) |;

my @args = @ARGV;
my %o    = ( qw| trust | => [] );
GetOptionsFromArray(
    \@args, \%o,
    qw| root=s root-key=s vault-dir=s host-dir=s host-key=s parent-key=s parent-cmd=s trust=s@
        name=s intent=s disk=s index=s index-base=s epoch=s remove keep prune
        dry-run out=s format=s chksum=s holder=s all allow-rollback force reason=s
        free=s older=s now tree=s@ all-trees category=s category-rule=s@ owners
        local-encryption=s copies=i priority=i replica=s want=s foreign-work=s
        layer=s incoming under=s depth=i limit=i group-by=s trees-only help
        from=s pass-fd=i argon-m=i argon-t=i argon-p=i samples=i
        role=s domain=s owned quota=s reserve=s bwlimit=s only-root delete exclude=s@
        categories=s min-priority=s
        list adopt |
) or usage(2);
usage(0) if $o{'help'};

my $command = shift @args // usage(2);
$o{'tree'} = $o{'tree'}[-1]
    if ref $o{'tree'} and $command ne qw| seal |;

my %common;
$common{'root'}     = $o{'root'}     if defined $o{'root'};
$common{'host_dir'} = $o{'host-dir'} if defined $o{'host-dir'};
if ( $o{'trust'}->@* ) {
    $common{'anchors'} = [
        map {
            my $pub = unb32($ARG);
            fail("-trust : not a base32 public key [ $ARG ]")
                if not defined $pub
                or length $pub != 32;
            $pub
        } $o{'trust'}->@*
    ];
}

my %run = (
    qw| keygen |         => \&cmd_keygen,
    qw| pubkey |         => \&cmd_pubkey,
    qw| init |           => \&cmd_init,
    qw| list |           => \&cmd_list,
    qw| attach |         => \&cmd_attach,
    qw| detach |         => \&cmd_detach,
    qw| status |         => \&cmd_status,
    qw| verify |         => \&cmd_verify,
    qw| get |            => \&cmd_get,
    qw| find |           => \&cmd_find,
    qw| drop |           => \&cmd_drop,
    qw| release |        => \&cmd_release,
    qw| reclaim |        => \&cmd_reclaim,
    qw| release-epoch |  => \&cmd_release_epoch,
    qw| repair |         => \&cmd_repair,
    qw| trees |          => \&cmd_trees,
    qw| tree-drop |      => \&cmd_tree_drop,
    qw| restore |        => \&cmd_restore,
    qw| category |       => \&cmd_category,
    qw| set-category |   => \&cmd_set_category,
    qw| incoming |       => \&cmd_incoming,
    qw| sync |           => \&cmd_sync,
    qw| sync-conflicts | => \&cmd_sync_conflicts,
    qw| assimilate |     => \&cmd_assimilate,
    qw| upgrade |        => \&cmd_upgrade,
    qw| confirm |        => \&cmd_confirm,
    qw| root |           => \&cmd_seal_root,
    qw| seal |           => \&cmd_seal,
    qw| unseal |         => \&cmd_unseal,
    qw| seal-recover |   => \&cmd_seal_recover,
    qw| shred |          => \&cmd_shred,
    qw| holder-check |   => \&cmd_holder_check,
    qw| holder |         => \&cmd_holder,
    qw| holder-gc |      => \&cmd_holder_gc,
    qw| holder-drain |   => \&cmd_holder_drain,
    qw| relay |          => \&cmd_relay,
    qw| placement |      => \&cmd_placement,
    qw| place |          => \&cmd_place,
);
usage(2) if not exists $run{$command};

if ( defined $o{'bwlimit'} ) {
    require AMOS7::N7FS::Placement;
    require AMOS7::N7FS::Holder;
    no warnings qw| once |;
    $AMOS7::N7FS::Holder::BWLIMIT
        = AMOS7::N7FS::Placement::parse_size( $o{'bwlimit'} );
}

## the process list shows the tool and its command, never its arguments ##
our $SCRIPT = $PROGRAM_NAME;
$PROGRAM_NAME = "n7fs $command";

## commands that write to holders run one at a time per host : a gc must ##
## never delete what a running place \ seal \ relay just published       ##
my %holder_writer
    = map { $ARG => 1 } qw| seal place relay holder-drain holder-gc shred |;
our $HOLDER_LOCK;
if ( $holder_writer{$command} and not $o{'dry-run'} ) {
    require Fcntl;
    my $dir = host_dir(%common);
    AMOS7::N7FS::make_dirs( $dir, 0700 ) if not -d $dir;
    open( $HOLDER_LOCK, '>>', "$dir/holders.lock" )
        or fail("cannot open the holder lock : $OS_ERROR");
    flock( $HOLDER_LOCK, Fcntl::LOCK_EX() | Fcntl::LOCK_NB() )
        or fail( 'another n7fs command is writing to holders on this host [ '
            . 'seal, place, relay, holder-drain, holder-gc, shred ] '
            . ': wait for it to finish' );
}

my $code = eval { $run{$command}->(@args) };
if ( not defined $code ) {
    my $err = $EVAL_ERROR || "n7fs : failed\n";
    print STDERR $err;
    exit 1;
}
exit $code;

##[ HELPERS ]#################################################################

sub usage {
    my $exit = shift;
    open( my $fh, '<', $main::SCRIPT // $PROGRAM_NAME ) or exit $exit;
    while ( my $line = <$fh> ) {
        last                  if $line =~ m|^use FindBin|;
        print {*STDERR} $line if $line =~ m|^## |;
    }
    exit $exit;
}

sub fail { die "n7fs : $ARG[0]\n" }

sub say_line { say ': ', @ARG }

sub warn_unsigned_names {
    my ( $disk, $state ) = @ARG;
    print STDERR "n7fs : warning : disk $disk uses store "
        . "format 1 ; meta names are unsigned\n"
        if $state->{'store_format'} == 1;
    return;
}

sub host_signer {
    my $file = $o{'host-key'} // host_dir(%common) . '/host.key';
    fail("no host key $file [ n7fs keygen $file ]") if not -e $file;
    return key_file_signer($file);
}

sub optional_host_signer {
    my $file = $o{'host-key'} // host_dir(%common) . '/host.key';
    return undef if not -e $file and not defined $o{'host-key'};
    return host_signer();
}

sub read_common {
    my %read = %common;
    my $host = optional_host_signer();
    $read{'host'}           = $host if defined $host;
    $read{'allow_rollback'} = $o{'allow-rollback'} ? TRUE : FALSE;
    return %read;
}

sub parent_signer {
    if ( defined $o{'parent-cmd'} ) {
        return command_signer( split m|\s+|, $o{'parent-cmd'} );
    }
    my $file = $o{'parent-key'} // host_dir(%common) . '/parent.key';
    fail("no parent key $file [ n7fs keygen $file, or -parent-cmd ]")
        if not -e $file;
    return key_file_signer($file);
}

sub disk_arg {
    my $disk = shift // $o{'disk'} // fail('which disk ?');
    return $disk;
}

sub _latest_meta {
    my %latest;
    foreach my $entry (@ARG) {
        my $key = join "\0", $entry->{'address'},
            $entry->{'source'} // $entry->{'name'} // '';
        if ( not exists $latest{$key}
            or $entry->{'import_ntime'} gt $latest{$key}{'import_ntime'} ) {
            $latest{$key} = $entry;
        }
    }
    return values %latest;
}

sub _name_regex {
    my $pattern = shift // return undef;
    my $regex   = eval {qr/$pattern/};
    if ( not defined $regex ) {
        my $err = $EVAL_ERROR // 'invalid regex';
        chomp $err;
        fail("find : invalid -name regex [ $err ]");
    }
    return $regex;
}

sub _address_arg {
    my ( $target, $state ) = @ARG;
    return undef
        if $target !~ m|\A(V7[A-Z2-7]{5})/([A-Z2-7]{7})/([A-Z2-7]{77})\z|;
    my ( $epoch_name, $amos, $bmw ) = ( $1, $2, $3 );
    my $epoch = epoch_from_b32($epoch_name);
    fail("get : not a canonical address [ $target ]") if not defined $epoch;
    fail("get : address epoch is not active [ $target ]")
        if not grep { $ARG == $epoch } $state->{'epochs'}->@*;
    return { qw| epoch | => $epoch, qw| amos | => $amos, qw| bmw | => $bmw };
}

##[ COMMANDS ]################################################################

sub cmd_keygen {
    my $file = shift // fail('keygen needs a file');
    my $s    = key_file_write($file);
    say_line( 'key file ', $file );
    say_line( 'public   ', b32( $s->public ) );
    return 0;
}

sub cmd_pubkey {
    my $file = shift // fail('pubkey needs a file');
    say b32( key_file_signer($file)->public );
    return 0;
}

sub cmd_init {
    my $disk = disk_init(
        %common,
        qw| parent | => parent_signer(),
        qw| name |   => $o{'name'},
        qw| intent | => $o{'intent'},
    );
    say_line( 'disk ', $disk, ' created under ', root_dir(%common) );
    return 0;
}

sub cmd_list {
    my $root = root_dir(%common);
    fail("root $root is not a directory") if not -d $root;
    opendir( my $dh, $root ) or fail("cannot read $root : $OS_ERROR");
    say for sort grep {m|\A[A-Z2-7]{7}\z|} readdir $dh;
    closedir $dh;
    return 0;
}

sub cmd_attach {
    my $done = disk_attach(
        %common,
        qw| disk |           => disk_arg(shift),
        qw| host |           => host_signer(),
        qw| allow_rollback | => $o{'allow-rollback'} ? TRUE : FALSE,
    );
    say_line(
        sprintf '%s:%s attached [ %s, %s ]',
        $done->{'mount'}, $done->{'disk'},
        $done->{'ntime'}, $done->{'window'}
    );
    return 0;
}

sub cmd_detach {
    my $done = disk_detach(
        %common,
        qw| disk | => disk_arg(shift),
        qw| host | => host_signer(),
    );
    say_line(
        sprintf '%s:%s detached [ %s ]', $done->{'mount'},
        $done->{'disk'},                 $done->{'ntime'}
    );
    return 0;
}

sub cmd_status {
    my $disk = disk_arg(shift);
    my $s    = disk_status(
        %common,
        qw| disk |           => $disk,
        qw| host |           => host_signer(),
        qw| allow_rollback | => $o{'allow-rollback'} ? TRUE : FALSE,
    );
    warn_unsigned_names( $s->{'disk'}, $s->{'state'} );
    say_line( 'disk      ', $s->{'disk'} );
    say_line( 'name      ', $s->{'name'} );
    say_line( 'intent    ', $s->{'intent'} );
    say_line( 'init      ', $s->{'init'} );
    say_line( 'parent    ',
        $s->{'anchored'} ? 'trusted anchor' : 'not anchored [ tofu ]' );
    say_line( 'records   ', $s->{'records'} );
    say_line( 'window    ', $s->{'window'},
        defined $s->{'first'} ? " [ $s->{'first'} .. $s->{'last'} ]" : '' );
    say_line( 'attached  ', $s->{'attached'} // 'no' );
    say_line(
        'format    ',
        $s->{'state'}{'store_format'},
        $s->{'state'}{'previous'}
        ? ( ' [ from ',
            $s->{'state'}{'previous'}{'store_format'},
            $s->{'state'}{'confirmed'}
            ? ', confirmed ]'
            : ', unconfirmed ]'
            )
        : ()
    );
    say_line( 'epochs    ', join ' ', $s->{'state'}{'epochs'}->@* );

    if ( $s->{'state'}{'store_format'} == 3 ) {
        say_line( 'journal   ', $s->{'journal_seq'} );
        say_line( 'baseline  ', $s->{'journal_baseline'} ? 'yes' : 'no' );
        my ( $id, $state, $replay ) = _tree_context($disk);
        ## status is what one reads on a damaged disk : never die for this ##
        my $refs = eval {
            incoming_refs(
                read_common(),
                qw| disk |    => $disk,
                qw| _id |     => $id,
                qw| _replay | => $replay
            );
        };
        if ( not $refs ) {
            say_line('incoming  unavailable [ run verify ]');
            return 0;
        }
        my $pool = incoming_summary($refs);
        say_line(
            'incoming  ',
            $pool->{'count'},
            ' references, ',
            $pool->{'bytes'},
            ' bytes'
        );
    }
    return 0;
}

sub cmd_verify {
    my %read = read_common();
    my $r    = store_verify( %read, qw| disk | => disk_arg(shift) );
    say_line( sprintf '%d nodes verified [ format %d ]',
        $r->{'nodes'}, $r->{'state'}{'store_format'} );
    return 0;
}

sub cmd_get {
    my $disk   = disk_arg(shift);
    my $target = shift // fail('get needs an address or path name');
    fail('get : unexpected arguments') if @ARG;
    my %read  = read_common();
    my $id    = disk_read_id( %read, qw| disk | => $disk );
    my $lock  = disk_lock( $id, qw| shared | );
    my $state = state_read( $id->{'path'}, $id->{'store_pub'} );
    if ( ref $read{'host'} ) {
        witness_check_format( %read, qw| id | => $id, qw| state | => $state );
        if ( $state->{'store_format'} == 3 ) {
            my $head = journal_head($id);
            witness_check_journal(
                %read,
                qw| id |          => $id,
                qw| journal_seq | => $head->{'seq'}
            );
        }
    }
    warn_unsigned_names( $disk, $state );
    my $addr = _address_arg( $target, $state );

    if ( not defined $addr ) {
        my %nodes;
        ## sources are stored absolute ##
        my $absolute = abs_path($target) // $target;
        if ( $state->{'store_format'} == 3 ) {
            my @matching = grep {
                       ( $ARG->{'name'}   // '' ) eq $target
                    or ( $ARG->{'holder'} // '' ) eq $target
                    or ( $ARG->{'holder'} // '' ) eq $absolute
            } reference_entries( %read, qw| disk | => $disk );
            my @live
                = grep { not $ARG->{'dropped'} and not $ARG->{'released'} }
                @matching;
            fail("get : name [ $target ] was released")
                if not @live and grep { $ARG->{'released'} } @matching;
            fail(     "get : name [ $target ] was "
                    . "dropped ; use -all or an address" )
                if not $o{'all'}
                and not @live
                and @matching;
            foreach my $ref ( $o{'all'} ? @matching : @live ) {
                next if $ref->{'released'};
                my ( $epoch_name, $amos, $bmw ) = split m|/|, $ref->{'node'};
                $nodes{ $ref->{'node'} } = {
                    qw| epoch | => epoch_from_b32($epoch_name),
                    qw| amos |  => $amos,
                    qw| bmw |   => $bmw,
                };
            }
        } else {
            foreach my $entry (
                _latest_meta( meta_entries( %read, qw| disk | => $disk ) ) ) {
                next
                    if ( $entry->{'name'} // '' ) ne $target
                    and ( $entry->{'source'} // '' ) ne $target
                    and ( $entry->{'source'} // '' ) ne $absolute;
                $nodes{ $entry->{'address'} } = {
                    qw| epoch | => $entry->{'epoch'},
                    qw| amos |  => $entry->{'amos'},
                    qw| bmw |   => $entry->{'bmw'},
                };
            }
        }
        fail("get : no live reference named [ $target ]")
            if not keys %nodes and $state->{'store_format'} == 3;
        fail("get : no node named [ $target ]") if not keys %nodes;
        fail( "get : name resolves to several nodes [ $target ] :\n  "
                . join( "\n  ", sort keys %nodes ) )
            if keys %nodes > 1;
        ($addr) = values %nodes;
    }

    if ( $state->{'store_format'} == 3
        and not -e node_path( $id->{'path'}, $addr ) ) {
        my $replay = journal_replay($id);
        fail(     "get : address [ $target ] was released ; "
                . 'import the same content to revive it' )
            if $replay->{'released'}{$target};
    }
    node_verify( $id->{'path'}, $addr, $state->{'store_format'}, $id );
    my $content = node_path( $id->{'path'}, $addr ) . '/content';

    if ( defined $o{'out'} ) {
        my $out = $o{'out'};
        fail('get : -out needs a file') if not length $out;
        fail("get : $out exists")       if -e $out or -l $out;
        write_new_file_stream(
            $out,
            sub {
                my $out_fh = shift;
                open( my $in, '<:raw', $content )
                    or die "cannot open $content : $OS_ERROR\n";
                my $ctx = Digest::BMW->new(384);
                while (1) {
                    my $got = sysread( $in, my $buf, 1048576 );
                    die "read $content : $OS_ERROR\n" if not defined $got;
                    last                              if $got == 0;
                    $ctx->add($buf);
                    print {$out_fh} $buf or die "$OS_ERROR\n";
                }
                close $in or die "close $content : $OS_ERROR\n";
                die "content does not match its address [ $target ]\n"
                    if bmw_b32( $ctx->digest ) ne $addr->{'bmw'};
            }
        );
        say_line( 'get ', $target, ' -> ', $out, ' [ verified ]' );
        return 0;
    }

    ## the second read can race a writer ; bytes already on stdout cannot be
    ## withdrawn, so verification must finish before streaming starts
    binmode STDOUT, qw| :raw |;
    open( my $in, '<:raw', $content )
        or fail("cannot open $content : $OS_ERROR");
    while (1) {
        my $got = sysread( $in, my $buf, 1048576 );
        fail("read $content : $OS_ERROR") if not defined $got;
        last                              if $got == 0;
        print {*STDOUT} $buf or fail("stdout : $OS_ERROR");
    }
    close $in or fail("close $content : $OS_ERROR");
    return 0;
}

sub cmd_find {
    my $disk = disk_arg(shift);
    fail('find : unexpected arguments') if @ARG;
    my %read  = read_common();
    my $id    = disk_read_id( %read, qw| disk | => $disk );
    my $state = state_read( $id->{'path'}, $id->{'store_pub'} );
    witness_check_format( %read, qw| id | => $id, qw| state | => $state )
        if ref $read{'host'};
    warn_unsigned_names( $disk, $state );
    my $regex = _name_regex( $o{'name'} );
    my @entries;

    if ( $state->{'store_format'} == 3 ) {
        foreach my $ref ( reference_entries( %read, qw| disk | => $disk ) ) {
            next
                if ( $ref->{'dropped'} or $ref->{'released'} )
                and not $o{'all'};
            my @meta
                = $o{'all'}
                ? $ref->{'meta'}->@*
                : ( $ref->{'meta'}[-1] );
            push @entries,
                {
                %{$ARG},
                qw| dropped |   => $ref->{'dropped'},
                qw| converted | => $ref->{'converted'},
                qw| released |  => $ref->{'released'},
                qw| ref_path |  => $ref->{'path'},
                }
                for @meta;
        }
    } else {
        @entries
            = $o{'all'}
            ? meta_entries( %read, qw| disk | => $disk )
            : _latest_meta( meta_entries( %read, qw| disk | => $disk ) );
    }

    @entries = grep {
        my $entry = $ARG;
        (          not defined $regex
                or ( $entry->{'name'}   // '' ) =~ $regex
                or ( $entry->{'source'} // '' ) =~ $regex
            )
            and ( not defined $o{'format'}
            or ( $entry->{'format'} // '' ) eq $o{'format'} )
            and ( not defined $o{'chksum'}
            or index( $entry->{'amos'}, $o{'chksum'} ) == 0
            or index( $entry->{'bmw'},  $o{'chksum'} ) == 0 )
    } @entries;

    @entries = sort {
        ( $a->{'source'} // $a->{'name'} // '' )
            cmp( $b->{'source'} // $b->{'name'} // '' )
            or $a->{'address'} cmp $b->{'address'}
            or $a->{'import_ntime'} cmp $b->{'import_ntime'}
            or ( $a->{'ref_path'} // '' ) cmp( $b->{'ref_path'} // '' )
    } @entries;
    foreach my $entry (@entries) {
        my $label
            = length( $entry->{'source'} // '' )
            ? $entry->{'source'}
            : $entry->{'name'} // '?';
        my @stamp = (
            $entry->{'import_ntime'},
            $entry->{'converted_from_unsigned'}
            ? 'converted_from_unsigned'
            : (),
            $entry->{'converted'} ? 'converted' : (),
            $entry->{'dropped'}   ? 'dropped'   : (),
            $entry->{'released'}  ? 'released'  : (),
        );
        say join ' ', $entry->{'address'}, $entry->{'size'} // '?',
            $entry->{'format'} // 'unknown', $label,
            $o{'all'} ? '[ ' . join( ' ', @stamp ) . ' ]' : ();
    }
    return 0;
}

sub cmd_drop {
    my $disk    = disk_arg(shift);
    my $address = shift // fail('drop needs an address');
    fail('drop : unexpected arguments') if @ARG;
    my $r = reference_drop(
        %common,
        qw| disk |    => $disk,
        qw| host |    => host_signer(),
        qw| address | => $address,
        qw| holder |  => $o{'holder'},
    );
    say_line( 'dropped ', $r->{'reference'}{'path'},
        ' [ journal ', $r->{'seq'}, ' ; content and meta kept ]' );
    return 0;
}

sub _size_value {
    my $value = shift // return undef;
    fail("bad size [ $value ]")
        if $value !~ m|\A(\d+(?:\.\d+)?)([KMGT]?)B?\z|i;
    my %factor = (
        '' => 1,
        K  => 1024,
        M  => 1024**2,
        G  => 1024**3,
        T  => 1024**4
    );
    return $1 * $factor{ uc $2 };
}

sub _age_value {
    my $value = shift // return undef;
    fail("bad age [ $value ]")
        if $value !~ m|\A(\d+(?:\.\d+)?)([smhdw]?)\z|i;
    my %seconds = (
        '' => 1,
        s  => 1,
        m  => 60,
        h  => 3600,
        d  => 86400,
        w  => 604800
    );
    return $1 * $seconds{ lc $2 } * 4200;
}

sub cmd_release {
    require AMOS7::N7FS::Release;
    AMOS7::N7FS::Release->import(qw| release_node store_reclaim |);
    my $disk    = disk_arg(shift);
    my $address = shift // fail('release needs an address');
    fail('release : unexpected arguments') if @ARG;
    my $r = release_node(
        %common,
        qw| disk |    => $disk,
        qw| host |    => host_signer(),
        qw| address | => $address,
        qw| force |   => $o{'force'} ? TRUE : FALSE,
        qw| reason |  => $o{'reason'} // 'explicit release',
    );
    warn "n7fs : warning : release breaks live reference $_\n"
        for $r->{'live'}->@*;
    warn "n7fs : warning : release drops live tree $_\n"
        for ( $r->{'trees'} // [] )->@*;
    warn "n7fs : warning : the previous form still holds these "
        . "bytes at $_ [ n7fs release-epoch $disk <epoch> -now ]\n"
        for $r->{'copies'}->@*;
    say_line( 'released ', $address, ' [ journal ', $r->{'seq'}, ' ]' );
    say_line( 'release does not prove the bytes unrecoverable ; copies, '
            . 'backups and filesystem history may retain them' );
    return 0;
}

sub cmd_reclaim {
    require AMOS7::N7FS::Release;
    AMOS7::N7FS::Release->import(qw| release_node store_reclaim |);
    my $disk = disk_arg(shift);
    fail('reclaim : unexpected arguments') if @ARG;
    my $r = store_reclaim(
        %common,
        qw| disk |    => $disk,
        qw| host |    => host_signer(),
        qw| free |    => _size_value( $o{'free'} ),
        qw| older |   => _age_value( $o{'older'} ),
        qw| dry_run | => $o{'dry-run'} ? TRUE : FALSE,
    );
    foreach my $item ( $r->{'released'}->@* ) {
        say_line( $o{'dry-run'} ? 'would release ' : 'released ',
            $item->{'address'}, ' [ ', $item->{'size'}, ' content bytes ]' );
    }
    say_line('dry run : nothing was changed') if $o{'dry-run'};
    say_line( 'release does not prove the bytes unrecoverable ; copies, '
            . 'backups and filesystem history may retain them' );
    return 0;
}

sub cmd_release_epoch {
    require AMOS7::N7FS::Convert;
    AMOS7::N7FS::Convert->import(qw| upgrade confirm release_epoch |);
    my $disk  = disk_arg(shift);
    my $epoch = shift // fail('release-epoch needs a previous epoch');
    fail('release-epoch : unexpected arguments') if @ARG;
    my $r = release_epoch(
        %common,
        qw| disk |  => $disk,
        qw| host |  => host_signer(),
        qw| epoch | => $epoch,
        qw| now |   => $o{'now'} ? TRUE : FALSE,
    );
    say_line( 'released previous epoch ',
        $r->{'epoch'}, ' ; rollback to that form has ended' );
    return 0;
}

sub cmd_repair {
    my $r = store_repair(
        %common,
        qw| disk | => disk_arg(shift),
        qw| host | => host_signer(),
    );
    say_line( 'finished release ', $ARG ) for ( $r->{'finished'} // [] )->@*;
    say_line( 'quarantined ', $ARG->{'type'}, ' ', $ARG->{'path'}, ' -> ',
        $ARG->{'quarantine'} )
        for ( $r->{'quarantined'} // [] )->@*;
    if ( not $r->{'adopted'}->@* ) {
        say_line('repair : no unjournaled data')
            if not @{ $r->{'quarantined'} // [] };
        return 0;
    }
    foreach my $item ( $r->{'adopted'}->@* ) {
        say_line( 'adopted ', $item->{'type'}, ' ', $item->{'node'}, ' ',
            $item->{'path'} // $item->{'name'} // '' );
    }
    say_line( 'repair journal ', $r->{'seq'} );
    return 0;
}

sub _tree_context {
    my $disk  = shift;
    my %read  = read_common();
    my $id    = disk_read_id( %read, qw| disk | => $disk );
    my $lock  = disk_lock( $id, qw| shared | );
    my $state = state_read( $id->{'path'}, $id->{'store_pub'} );
    fail('trees and categories are only available for store format 3')
        if $state->{'store_format'} != 3;
    my $replay = journal_replay($id);
    return ( $id, $state, $replay );
}

sub cmd_trees {
    require AMOS7::N7FS::Tree;
    AMOS7::N7FS::Tree->import(qw| tree_list tree_drop tree_restore |);
    my ( $id, $state, $replay ) = _tree_context( disk_arg(shift) );
    fail('trees : unexpected arguments') if @ARG;
    say join ' ', $ARG->{'name'}, $ARG->{'manifest'}, $ARG->{'created'}
        for tree_list( $id, $state, $replay );
    return 0;
}

sub cmd_tree_drop {
    require AMOS7::N7FS::Tree;
    AMOS7::N7FS::Tree->import(qw| tree_list tree_drop tree_restore |);
    my $disk = disk_arg(shift);
    my $name = shift // fail('tree-drop needs a tree name');
    fail('tree-drop : unexpected arguments') if @ARG;
    my $r = tree_drop(
        %common,
        qw| disk | => $disk,
        qw| host | => host_signer(),
        qw| name | => $name
    );
    say_line( 'dropped tree ',
        $name, ' [ journal ', $r->{'seq'}, ' ; content kept ]' );
    return 0;
}

sub cmd_restore {
    require AMOS7::N7FS::Tree;
    AMOS7::N7FS::Tree->import(qw| tree_list tree_drop tree_restore |);
    my $disk   = disk_arg(shift);
    my $name   = shift // fail('restore needs a tree name');
    my $target = shift // fail('restore needs a target');
    fail('restore : unexpected arguments') if @ARG;
    my $r = tree_restore(
        %common,
        qw| disk |    => $disk,
        qw| name |    => $name,
        qw| target |  => $target,
        qw| owners |  => $o{'owners'}  ? TRUE : FALSE,
        qw| dry_run | => $o{'dry-run'} ? TRUE : FALSE,
    );
    say_line(
        $r->{'dry_run'} ? 'would restore ' : 'restored ',
        sprintf '%d files, %d directories, %d symlinks [ verified ]',
        $r->{'files'},
        $r->{'directories'},
        $r->{'symlinks'}
    );
    say_line( 'not applied ', "$ARG $r->{'omitted'}{$ARG}" )
        for grep { $r->{'omitted'}{$ARG} } sort keys $r->{'omitted'}->%*;
    return 0;
}

sub _policy_line {
    my $p = shift;
    return join ' ', $p->{'name'},
        "local-encryption=" . "$p->{'local_encryption'}",
        "copies=$p->{'copies'}",   "priority=$p->{'priority'}",
        "replica=$p->{'replica'}", 'want=' . join( ',', $p->{'want'}->@* ),
        "foreign-work=$p->{'foreign_work'}", "layer=$p->{'layer'}";
}

sub cmd_category {
    my $disk   = disk_arg(shift);
    my $action = shift // fail('category needs set, list or show');
    if ( $action eq qw| set | ) {
        my $name = shift // fail('category set needs a name');
        fail('category set : unexpected arguments') if @ARG;
        my $r = category_set(
            %common,
            qw| disk |             => $disk,
            qw| host |             => host_signer(),
            qw| name |             => $name,
            qw| local_encryption | => $o{'local-encryption'},
            qw| copies |           => $o{'copies'},
            qw| priority |         => $o{'priority'},
            qw| replica |          => $o{'replica'},
            defined $o{'want'}
            ? ( qw| want | => [ grep {length} split m|,|, $o{'want'} ] )
            : (),
            qw| foreign_work | => $o{'foreign-work'},
            qw| layer |        => $o{'layer'},
        );
        say_line( 'category ', _policy_line( $r->{'category'} ),
            ' [ journal ', $r->{'seq'}, ' ]' );
        say_line( 'cascade is stored policy only '
                . '; no encryption is enforced yet' )
            if $r->{'category'}{'local_encryption'} eq qw| cascade |;
        return 0;
    }
    my ( $id, $state, $replay ) = _tree_context($disk);
    if ( $action eq qw| list | ) {
        fail('category list : unexpected arguments') if @ARG;
        say _policy_line($ARG) for category_list( $id, $replay );
        return 0;
    }
    if ( $action eq qw| show | ) {
        my $address = shift // fail('category show needs an address');
        fail('category show : unexpected arguments') if @ARG;
        my $r = category_report( $id, $replay, $address );
        foreach my $item ( $r->{'references'}->@* ) {
            say join ' ', $item->{'reference'}{'path'}, $item->{'category'},
                $item->{'reference'}{'holder'};
        }
        say 'effective ', _policy_line( $r->{'effective'} );
        return 0;
    }
    fail('category needs set, list or show');
}

sub cmd_set_category {
    my $disk   = disk_arg(shift);
    my $target = shift
        // fail('set-category needs an address or tree prefix');
    my $name = shift // fail('set-category needs a category');
    fail('set-category : unexpected arguments') if @ARG;
    my $r = category_set_reference(
        %common,
        qw| disk |     => $disk,
        qw| host |     => host_signer(),
        qw| target |   => $target,
        qw| category | => $name,
    );
    say_line(
        'assigned ', $name, ' to ',
        scalar $r->{'assignments'}->@*,
        ' references [ journal ',
        $r->{'seq'}, ' ]'
    );
    return 0;
}

sub cmd_incoming {
    my $disk   = disk_arg(shift);
    my $action = shift // fail('incoming needs list, tag or done');
    my ( $id, $state, $replay ) = _tree_context($disk);
    my %read = read_common();
    my $refs = incoming_refs(
        %read,
        qw| disk |    => $disk,
        qw| _id |     => $id,
        qw| _replay | => $replay
    );
    my $summary = incoming_summary($refs);
    if ( $action eq qw| done | ) {
        fail('incoming done : unexpected arguments') if @ARG;
        say_line( 'incoming ', $summary->{'count'}, ' references, ',
            $summary->{'bytes'}, ' bytes',
            $summary->{'count'} ? '' : ' [ empty ]' );
        return $summary->{'count'} ? 1 : 0;
    }
    if ( $action eq qw| list | ) {
        fail('incoming list : unexpected arguments') if @ARG;
        binmode STDOUT, qw| :raw |;
        my $name_len;
        if ( defined $o{'group-by'} ) {
            ($name_len) = $o{'group-by'} =~ m|\Aname:([1-9]\d*)\z|;
            fail('incoming list : -group-by takes name:<n>')
                if not defined $name_len;
        }
        my $groups
            = incoming_groups( $refs, $o{'under'}, $o{'depth'}, $o{'limit'},
            $name_len );
        say join ' ', $ARG->{'count'}, $ARG->{'bytes'}, $ARG->{'path'}
            for @{$groups};
        say_line( 'incoming ', $summary->{'count'}, ' references, ',
            $summary->{'bytes'}, ' bytes' );
        return 0;
    }
    if ( $action eq qw| tag | ) {
        my ( $selector, $category, @rules );
        if ( defined $o{'from'} ) {
            fail('incoming tag : -from takes no selector') if @ARG;
            open( my $fh, '<:raw', $o{'from'} )
                or fail("cannot read $o{'from'} : $OS_ERROR");
            while ( my $line = <$fh> ) {
                $line =~ s|\r?\n\z||;
                next if $line =~ m|\A\s*(?:#.*)?\z|;
                my ( $sel, $cat ) = $line =~ m|\A\s*(.*\S)\s+(\S+)\s*\z|;
                fail("incoming tag : bad line [ $line ]") if not defined $cat;
                push @rules, [ $sel, $cat ];
            }
            close $fh;
            fail('incoming tag : no rules in the file') if not @rules;
        } else {
            $selector = shift // fail('incoming tag needs a selector');
            $category = shift // fail('incoming tag needs a category');
            fail('incoming tag : unexpected arguments') if @ARG;
        }
        my $r = incoming_tag(
            %common,
            qw| disk | => $disk,
            qw| host | => host_signer(),
            @rules
            ? ( qw| rules | => \@rules )
            : ( qw| selector | => $selector, qw| category | => $category ),
        );
        say_line( 'rule matched nothing : ', $ARG ) for $r->{'empty'}->@*;
        say_line(
            'tagged ',
            $r->{'count'},
            ' references, ',
            $r->{'bytes'},
            ' bytes as ',
            $r->{'category'},
            ' [ journal ',
            $r->{'seq'},
            ' ]'
        );
        return 0;
    }
    fail('incoming needs list, tag or done');
}

sub cmd_sync {
    require AMOS7::N7FS::Sync;
    AMOS7::N7FS::Sync->import(qw| store_sync sync_conflict_list |);
    my $from = shift // fail('sync needs a source disk');
    my $to   = shift // fail('sync needs a receiver disk');
    fail('sync : unexpected arguments') if @ARG;
    my $r = eval {
        store_sync(
            %common,
            qw| from |           => $from,
            qw| to |             => $to,
            qw| host |           => host_signer(),
            qw| allow_rollback | => $o{'allow-rollback'} ? TRUE : FALSE,
            qw| dry_run |        => $o{'dry-run'}        ? TRUE : FALSE,
            qw| trees_only |     => $o{'trees-only'}     ? TRUE : FALSE,
        );
    };
    if ( not defined $r ) {
        my $err = $EVAL_ERROR // "sync failed\n";
        print STDERR "n7fs : run n7fs repair $to before retrying the sync\n";
        die $err;
    }
    say_line($ARG) for $r->{'messages'}->@*;
    foreach my $field (
        qw| nodes bytes references trees categories assignments
        drops conflicts |
    ) {
        say_line( $field, $r->{'count'}{$field} // 0 );
    }
    say_line( 'journal ', $r->{'journal_seq'} )
        if defined $r->{'journal_seq'};
    say_line('dry run : nothing was changed') if $r->{'dry_run'};
    say_line('no changes ; no journal entry') if not $r->{'changed'};
    my ( $id, $state, $replay ) = _tree_context($to);
    my $remaining = scalar sync_conflict_list( $id, $replay );
    return ( $r->{'count'}{'conflicts'} or $remaining ) ? 1 : 0;
}

sub cmd_sync_conflicts {
    require AMOS7::N7FS::Sync;
    AMOS7::N7FS::Sync->import(
        qw| store_sync sync_conflict_list
            sync_conflict_resolve |
    );
    my $disk = disk_arg(shift);
    if ( @ARG and $ARG[0] eq qw| resolve | ) {
        shift @ARG;
        my $name = shift
            // fail('sync-conflicts resolve needs a record name');
        fail('sync-conflicts resolve : unexpected arguments') if @ARG;
        my $r = sync_conflict_resolve(
            %common,
            qw| disk | => $disk,
            qw| host | => host_signer(),
            qw| name | => $name,
        );
        say_line( 'resolved ', $name, ' [ journal ', $r->{'seq'},
            ' ; receiver value kept ]' );
        return 0;
    }
    my ( $id, $state, $replay ) = _tree_context($disk);
    fail('sync-conflicts : unexpected arguments') if @ARG;
    my @conflicts = sync_conflict_list( $id, $replay );
    foreach my $conflict (@conflicts) {
        say join ' ', $conflict->{'path'}, $conflict->{'kind'},
            $conflict->{'origin'}{'disk'}, $conflict->{'origin'}{'id'},
            'receiver=' . ( $conflict->{'receiver'} // '' ),
            'source=' .   ( $conflict->{'source'}   // '' );
    }
    say_line( 'conflicts ', scalar @conflicts );
    return 0;
}

sub _assimilate_options {
    my ( $paths, $tree, $category ) = @ARG;
    return (
        %common,
        qw| disk |       => disk_arg(),
        qw| host |       => host_signer(),
        qw| paths |      => $paths,
        qw| index |      => $o{'index'},
        qw| index_base | => $o{'index-base'},
        qw| protect | => [ grep {defined} $o{'host-key'}, $o{'parent-key'} ],
        qw| remove |  => $o{'remove'}  ? TRUE : FALSE,
        qw| prune |   => $o{'prune'}   ? TRUE : FALSE,
        qw| dry_run | => $o{'dry-run'} ? TRUE : FALSE,
        qw| tree |           => $tree,
        qw| category |       => $category,
        qw| category_rules | => $o{'category-rule'} // [],
    );
}

sub _assimilate_report {
    my $r = shift;
    foreach my $e ( $r->{'entries'}->@* ) {
        say_line(
            join ' ',
            $e->{'status'},
            $e->{'source'} // '?',
            defined $e->{'addr'} ? ( '->', $e->{'addr'} ) : (),
            defined $e->{'then'} ? "[ $e->{'then'} ]"     : (),
            defined $e->{'why'}  ? "[ $e->{'why'} ]"      : ()
        );
    }
    if ( $r->{'tree'} ) {
        say_line(
            'tree ', $r->{'tree'}{'record'}{'name'},
            ' -> ',  $r->{'tree'}{'address'}
        );
        say_line( 'skipped special ', $ARG ) for $r->{'tree'}{'skipped'}->@*;
        say_line(
            'skipped source errors ',
            $r->{'tree'}{'skipped_errors'},
            ' ; tree completed with a nonzero status'
        ) if $r->{'tree'}{'skipped_errors'};
        say_line( 'xattr read failures ', $r->{'tree'}{'xattr_errors'} )
            if $r->{'tree'}{'xattr_errors'};
    }
    say_line( $r->{'dry_run'} ? 'would prune ' : 'pruned ', $ARG )
        for ( $r->{'pruned'} // [] )->@*;
    say_line('dry run : nothing was changed') if $r->{'dry_run'};
    return $r->{'failed'} ? 1 : 0;
}

sub cmd_assimilate {
    fail('assimilate : -keep and -remove exclude each other')
        if $o{'keep'} and $o{'remove'};
    fail('assimilate : -prune needs -remove')
        if $o{'prune'} and not $o{'remove'};
    fail('assimilate : no paths and no -index')
        if not @args and not defined $o{'index'};
    if ( $o{'incoming'} ) {
        fail('assimilate : -incoming excludes -tree, -category and -index')
            if defined $o{'tree'}
            or defined $o{'category'}
            or defined $o{'index'};
        fail('assimilate : -incoming needs paths') if not @args;
        my $failed = 0;
        foreach my $path (@args) {
            my $tree;
            my @st = lstat $path;
            if ( not @st ) {
                print STDERR "n7fs : $path : $OS_ERROR\n";
                $failed = 1;
                next;
            }
            if ( not -l _ and -d _ ) {
                ## the name is a label : the manifest keeps the true path ##
                require Cwd;
                my $base = Cwd::abs_path($path) // $path;
                $base =~ s|/+\z||;
                $base =~ s|.*/||s;
                $base =~ s|[^A-Za-z0-9._-]+|_|g;
                $base = substr( $base, 0, 64 );
                $base = 'root' if not length $base;
                $tree = join ':', 'incoming', ntime14( ntime_now() ), $base;
            }
            my $r = eval {
                assimilate(
                    _assimilate_options( [$path], $tree, 'incoming' ) );
            };
            if ( not $r ) {
                my $err = $EVAL_ERROR;
                print STDERR $err;
                $failed = 1;
                next;
            }
            my $path_failed = _assimilate_report($r);
            $failed = 1 if $path_failed;
        }
        return $failed;
    }
    my $r = assimilate(
        _assimilate_options( [@args], $o{'tree'}, $o{'category'} ) );
    return _assimilate_report($r);
}

sub cmd_upgrade {
    require AMOS7::N7FS::Convert;
    AMOS7::N7FS::Convert->import(qw| upgrade confirm release_epoch |);
    my $r = upgrade(
        %common,
        qw| disk | => disk_arg(shift),
        qw| host | => host_signer(),
        defined $o{'epoch'} ? ( qw| epoch | => $o{'epoch'} ) : (),
    );
    if ( $r->{'from'} == $r->{'to'} ) {
        say_line("format $r->{'from'} is the newest this n7fs converts to");
        return 0;
    }
    say_line(
        sprintf 'format %d -> %d : %d nodes written into epoch %d [ %d '
            . 'linked, %d copied ] ; the old form stays -- check, '
            . 'then n7fs confirm',
        $r->{'from'},  $r->{'to'},     $r->{'nodes'},
        $r->{'epoch'}, $r->{'linked'}, $r->{'copied'}
    );
    say_line( 'copy note ', $ARG ) for $r->{'notes'}->@*;
    return 0;
}

sub cmd_confirm {
    require AMOS7::N7FS::Convert;
    AMOS7::N7FS::Convert->import(qw| upgrade confirm release_epoch |);
    my $r = confirm(
        %common,
        qw| disk | => disk_arg(shift),
        qw| host | => host_signer(),
    );
    say_line( sprintf 'format %d confirmed [ %d nodes verified ]',
        $r->{'format'}, $r->{'nodes'} );
    return 0;
}

sub _seal_root {
    require AMOS7::N7FS::Keys;
    return AMOS7::N7FS::Keys::root_open(
        qw| path | => $o{'root-key'}
            // fail('sealing needs -root-key <file>'),
        qw| pass_fd |   => $o{'pass-fd'},
        qw| vault_dir | => $o{'vault-dir'},
    );
}

sub cmd_seal_root {
    require AMOS7::N7FS::Keys;
    my $action = shift // fail('root needs init, convert or export-check');
    my $file   = shift // fail('root needs a file or vault:<name>');
    if ( $action eq qw| convert | ) {
        my $to = shift // fail('root convert needs a target');
        fail('root : unexpected arguments') if @ARG;
        AMOS7::N7FS::Keys::root_convert(
            qw| from |      => $file,
            qw| to |        => $to,
            qw| pass_fd |   => $o{'pass-fd'},
            qw| vault_dir | => $o{'vault-dir'},
            qw| argon_m |   => $o{'argon-m'},
            qw| argon_t |   => $o{'argon-t'},
            qw| argon_p |   => $o{'argon-p'},
        );
        say_line( 'root converted to ',
            $to, ' ; data and holders unchanged' );
        say_line( 'the source key still exists ; '
                . 'remove it yourself when ready' );
        return 0;
    }
    fail('root : unexpected arguments') if @ARG;
    if ( $action eq qw| init | ) {
        AMOS7::N7FS::Keys::root_init(
            qw| path |      => $file,
            qw| pass_fd |   => $o{'pass-fd'},
            qw| vault_dir | => $o{'vault-dir'},
            qw| argon_m |   => $o{'argon-m'},
            qw| argon_t |   => $o{'argon-t'},
            qw| argon_p |   => $o{'argon-p'},
        );
        say_line( 'sealed root ', $file );
        return 0;
    }
    if ( $action eq qw| export-check | ) {
        require File::Temp;
        my $tmp = File::Temp::tempdir(
            qw| n7fs-root-check-XXXXXX |,
            qw| TMPDIR |  => 1,
            qw| CLEANUP | => 1
        );
        require File::Copy;
        File::Copy::copy( $file, "$tmp/root" )
            or fail("cannot copy root file : $OS_ERROR");
        chmod 0600, "$tmp/root";
        AMOS7::N7FS::Keys::root_open(
            qw| path |    => "$tmp/root",
            qw| pass_fd | => $o{'pass-fd'},
        );
        say_line('root copy opens with the supplied passphrase');
        return 0;
    }
    fail('root needs init, convert or export-check');
}

sub cmd_seal {
    require AMOS7::N7FS::Seal;
    my $disk  = disk_arg(shift);
    my @nodes = @ARG;
    fail('seal needs -out <holder-dir>') if not defined $o{'out'};
    fail('seal needs -category, -tree, -all-trees or addresses')
        if not defined $o{'category'}
        and not @nodes
        and not $o{'all-trees'}
        and not @{ $o{'tree'} // [] };
    my $r = AMOS7::N7FS::Seal::seal_nodes(
        qw| disk | => $disk,
        defined $o{'root'}     ? ( qw| disk_root | => $o{'root'} )     : (),
        defined $o{'host-dir'} ? ( qw| host_dir |  => $o{'host-dir'} ) : (),
        qw| root |      => _seal_root(),
        qw| holder |    => $o{'out'},
        qw| category |  => $o{'category'},
        qw| trees |     => $o{'tree'} // [],
        qw| all_trees | => $o{'all-trees'} ? TRUE : FALSE,
        qw| addresses | => \@nodes,
    );
    say_line( 'sealed ', $r->{'sealed'}, ' new nodes [ head ',
        $r->{'version'}, ' ]' );
    say_line( 'new writer on a clean holder starts at the '
            . 'local counter ; no newer head was visible' )
        if $r->{'new_holder'};
    return 0;
}

sub cmd_unseal {
    require AMOS7::N7FS::Seal;
    my $disk    = disk_arg(shift);
    my $address = shift // fail('unseal needs an address');
    my $target  = shift // fail('unseal needs a target');
    fail('unseal : unexpected arguments')   if @ARG;
    fail('unseal needs -from <holder-dir>') if not defined $o{'from'};
    AMOS7::N7FS::Seal::unseal_address(
        qw| disk |    => $disk,
        qw| root |    => _seal_root(),
        qw| holder |  => $o{'from'},
        qw| address | => $address,
        qw| target |  => $target,
        qw| owners |  => $o{'owners'} ? TRUE : FALSE,
    );
    say_line( 'unsealed ', $address, ' [ verified ]' );
    return 0;
}

sub cmd_seal_recover {
    require AMOS7::N7FS::Seal;
    my $target = shift // fail('seal-recover needs a target directory');
    fail('seal-recover : unexpected arguments')   if @ARG;
    fail('seal-recover needs -from <holder-dir>') if not defined $o{'from'};
    my $r = AMOS7::N7FS::Seal::seal_recover(
        qw| root |   => _seal_root(),
        qw| holder | => $o{'from'},
        qw| target | => $target,
        qw| tree |   => $o{'tree'},
        qw| owners | => $o{'owners'} ? TRUE : FALSE,
    );
    say_line(
        'recovered ',
        $r->{'nodes'} // $r->{'files'} // 0,
        ' nodes [ head ',
        $r->{'version'}, ' ]'
    );
    say_line( 'clean recovery accepts the reachable signed '
            . 'head ; a holder can withhold newer versions' );
    return 0;
}

sub cmd_holder_check {
    require AMOS7::N7FS::Seal;
    my $holder = shift // fail('holder-check needs a holder');
    fail('holder-check : unexpected arguments') if @ARG;
    my $r = AMOS7::N7FS::Seal::holder_check(
        qw| root |    => _seal_root(),
        qw| holder |  => $holder,
        qw| samples | => $o{'samples'},
    );
    say_line( 'holder ok : ', $r->{'nodes'}, ' nodes in ', $r->{'blobs'},
        ' blobs, ', $r->{'chunks'}, ' chunks checked' );
    ## a receipt needs this host's key ; a recovery machine may have none ##
    my $signer = optional_host_signer();
    if ( not $signer ) {
        say_line('no host key here : no receipt written');
        return 0;
    }
    require AMOS7::N7FS::Placement;
    require AMOS7::N7FS::Holder;
    AMOS7::N7FS::Placement::receipt_write(
        qw| host_dir | => host_dir(%common),
        qw| signer |   => $signer,
        qw| spec |     => AMOS7::N7FS::Holder::holder_canonical($holder),
        qw| root_id |  => $r->{'root_id'},
        qw| version |  => $r->{'version'},
        qw| nodes |    => $r->{'nodes'},
        qw| samples |  => $r->{'samples'},
    );
    say_line('receipt written [ counts for placement for 7 days ]');
    return 0;
}

sub cmd_holder_drain {
    require AMOS7::N7FS::Placement;
    my $disk = disk_arg(shift);
    my $name = shift // fail('holder-drain needs a holder name');
    fail('holder-drain : unexpected arguments') if @ARG;
    my $r = AMOS7::N7FS::Placement::holder_drain(
        _placement_opt($disk),
        qw| name |    => $name,
        qw| dry_run | => $o{'dry-run'} ? TRUE : FALSE
    );
    say_line(
        $o{'dry-run'} ? 'would drop ' : 'dropped ',
        $r->{'drop'},
        ' nodes, ',
        $r->{'bytes'},
        ' bytes from ',
        $name,
        $r->{'trees'} ? " and $r->{'trees'} trees" : ''
    );
    say_line( 'kept ', $r->{'kept'}, ' nodes, ', $r->{'kept_bytes'},
        ' bytes : too few counted copies elsewhere' )
        if $r->{'kept'};
    say_line('bytes stay until holder-gc')
        if $r->{'drop'} and not $o{'dry-run'};
    return 0;
}

sub cmd_relay {
    require AMOS7::N7FS::Placement;
    require AMOS7::N7FS::Seal;
    my $from = shift // fail('relay needs a source holder name');
    my $to   = shift // fail('relay needs a target holder name');
    fail('relay : unexpected arguments') if @ARG;
    my $holders = AMOS7::N7FS::Placement::holders_load( _vault_opt() );
    foreach my $name ( $from, $to ) {
        fail("no holder named $name") if not $holders->{$name};
    }
    fail('relay target must be a durable holder')
        if $holders->{$to}{'role'} ne qw| durable |;
    fail('relay : -list and -adopt exclude each other')
        if $o{'list'} and $o{'adopt'};
    my $r = AMOS7::N7FS::Seal::relay_nodes(
        qw| root |       => _seal_root(),
        qw| from |       => $holders->{$from}{'spec'},
        qw| to |         => $holders->{$to}{'spec'},
        qw| dry_run |    => $o{'dry-run'} ? TRUE : FALSE,
        qw| list_only |  => $o{'list'}    ? TRUE : FALSE,
        qw| adopt_only | => $o{'adopt'}   ? TRUE : FALSE,
        qw| room |       => sub {
            AMOS7::N7FS::Placement::holder_room( $holders->{$to}, shift );
        },
    );
    my $tag = _relay_tag( $holders->{$to}{'spec'} );
    if ( $o{'list'} ) {
        _relay_list_write(
            $holders->{$from}{'spec'},
            $holders->{$to}{'spec'},
            $tag, $r->{'names'}
        ) if not $o{'dry-run'};
        say_line(
            $o{'dry-run'} ? 'would list ' : 'listed ',
            scalar $r->{'names'}->@*,
            " blobs, $r->{'bytes'} bytes for $to on $from"
        );
        say_line("on $from : n7fs-push <holder-dir> relay-list.$tag <alias>")
            if not $o{'dry-run'};
        say_line("then : n7fs relay $from $to -adopt") if not $o{'dry-run'};
        return 0;
    }
    _relay_pending_clear( $holders->{$to}{'spec'}, $tag )
        if $o{'adopt'}
        and not $o{'dry-run'}
        and not $r->{'waiting'};
    say_line( $r->{'waiting'}, ' nodes wait : their blobs have not arrived' )
        if $r->{'waiting'};
    say_line(
        $o{'dry-run'} ? 'would relay ' : 'relayed ',
        $r->{'nodes'},
        ' nodes in ',
        $r->{'blobs'},
        ' blobs, ',
        $r->{'bytes'},
        " bytes from $from to $to",
        $r->{'trees'} ? " with $r->{'trees'} trees" : ''
    );
    say_line( 'skipped ', $r->{'missing'},
        ' nodes : their blob is missing on the source' )
        if $r->{'missing'};
    say_line("copies count after the next holder-check of $to")
        if $r->{'nodes'} and not $o{'dry-run'};
    return 0;
}

## a relay list is named by a tag of its target, not the target's name ##
sub _relay_tag {
    require AMOS7::N7FS::Sum;
    require AMOS7::N7FS::Holder;
    my $spec = AMOS7::N7FS::Holder::holder_canonical(shift);
    return substr(
        bmw_b32(
            AMOS7::N7FS::Sum::bmw384_bytes( "p7 n7fs relay v1\0" . $spec )
        ),
        0, 13
    );
}

sub _relay_pending_path {
    my $tag = shift;
    return host_dir(%common) . "/relay-pending/$tag.json";
}

## the list goes onto the sending holder ; home keeps the same names as
## pending, so holder-gc on the target leaves them until they are adopted
sub _relay_list_write {
    my ( $from, $to, $tag, $names ) = @ARG;
    require AMOS7::N7FS::Holder;
    require JSON::PP;
    my $json = JSON::PP->new->canonical;
    my $dir  = host_dir(%common) . '/relay-pending';
    AMOS7::N7FS::make_dirs( $dir, 0700 );
    my $pending = _relay_pending_path($tag);
    my %all;

    if ( -f $pending ) {
        my $old = eval { $json->decode( AMOS7::N7FS::read_file($pending) ) };
        $all{$ARG} = TRUE for @{ $old->{'blobs'} // [] };
    }
    $all{$ARG} = TRUE for @{$names};
    my $tmp = "$pending.new";
    unlink $tmp;
    AMOS7::N7FS::write_new_file(
        $tmp,
        $json->encode(
            { qw| holder | => $to, qw| blobs | => [ sort keys %all ] }
        )
    );
    rename $tmp, $pending or fail("cannot keep the pending list : $OS_ERROR");
    my $body = $json->encode( { qw| blobs | => $names } );
    my $h    = AMOS7::N7FS::Holder::holder_parse($from);

    if ( $h->{'type'} eq qw| local | ) {
        my $final = "$h->{'dir'}/relay-list.$tag";
        unlink "$final.new";
        AMOS7::N7FS::write_new_file( "$final.new", $body );
        rename "$final.new", $final
            or fail("cannot write the list : $OS_ERROR");
        return;
    }
    my $list = "$dir/relay-list.$tag";
    unlink $list;
    AMOS7::N7FS::write_new_file( $list, $body );
    AMOS7::N7FS::Holder::holder_put( $from, $list, "relay-list.$tag",
        qw| list |, TRUE );
    unlink $list;
    return;
}

sub _relay_pending_clear {
    my ( $to, $tag ) = @ARG;
    unlink _relay_pending_path($tag);
    return;
}

## blob names a push may have delivered to this holder, not yet adopted ##
sub _relay_pending_names {
    my $spec = shift;
    require JSON::PP;
    my $path = _relay_pending_path( _relay_tag($spec) );
    return () if not -f $path;
    my $data = eval { JSON::PP::decode_json( AMOS7::N7FS::read_file($path) ) }
        // fail("pending relay list is invalid : $path");
    return @{ $data->{'blobs'} // [] };
}

sub cmd_holder_gc {
    require AMOS7::N7FS::Seal;
    my $holder = shift // fail('holder-gc needs a holder');
    fail('holder-gc : unexpected arguments') if @ARG;
    my $r = AMOS7::N7FS::Seal::holder_gc(
        qw| root |      => _seal_root(),
        qw| holder |    => $holder,
        qw| keep |      => [ _relay_pending_names($holder) ],
        qw| only_root | => $o{'only-root'} ? TRUE : FALSE,
        qw| delete |    => $o{'delete'}    ? TRUE : FALSE,
    );
    say_line(
        $r->{'deleted'} ? 'removed ' : 'would remove ',
        $r->{'removed'},
        ' unreferenced blobs, ',
        $r->{'bytes'},
        ' bytes ; ',
        $r->{'kept'},
        ' kept'
    );
    say_line('dry run : add -delete to remove them') if not $r->{'deleted'};
    return 0;
}

sub _vault_opt {
    return (
        qw| pass_fd |   => $o{'pass-fd'},
        qw| vault_dir | => $o{'vault-dir'}
    );
}

sub cmd_holder {
    require AMOS7::N7FS::Placement;
    my $action = shift // fail('holder needs add, list or remove');
    if ( $action eq qw| add | ) {
        my $name = shift // fail('holder add needs a name');
        my $spec = shift // fail('holder add needs a holder');
        fail('holder add : unexpected arguments') if @ARG;
        my $h = AMOS7::N7FS::Placement::holder_add(
            _vault_opt(),
            qw| name |         => $name,
            qw| spec |         => $spec,
            qw| role |         => $o{'role'},
            qw| domain |       => $o{'domain'},
            qw| owned |        => $o{'owned'},
            qw| quota |        => $o{'quota'},
            qw| reserve |      => $o{'reserve'},
            qw| categories |   => $o{'categories'},
            qw| min_priority | => $o{'min-priority'},
        );
        say_line( 'holder ', $name, ' : ', $h->{'role'}, ' in ',
            $h->{'domain'}, $h->{'owned'} ? ' [ owned ]' : '' );
        return 0;
    }
    if ( $action eq qw| list | ) {
        fail('holder list : unexpected arguments') if @ARG;
        my $holders = AMOS7::N7FS::Placement::holders_load( _vault_opt() );
        foreach my $name ( sort keys %{$holders} ) {
            my $h = $holders->{$name};
            say join ' ', $name, $h->{'role'}, $h->{'domain'},
                $h->{'owned'} ? 'owned' : 'foreign', $h->{'spec'},
                defined $h->{'quota'} ? "quota=$h->{'quota'}" : (),
                $h->{'categories'}
                ? 'categories=' . join( ',', @{ $h->{'categories'} } )
                : (),
                defined $h->{'min_priority'}
                ? "min-priority=$h->{'min_priority'}"
                : ();
        }
        return 0;
    }
    if ( $action eq qw| remove | ) {
        my $name = shift // fail('holder remove needs a name');
        fail('holder remove : unexpected arguments') if @ARG;
        AMOS7::N7FS::Placement::holder_remove( _vault_opt(),
            qw| name | => $name );
        say_line( 'holder ', $name, ' removed from the registry' );
        return 0;
    }
    fail('holder needs add, list or remove');
}

sub _placement_opt {
    my $disk = shift;
    return (
        %common, _vault_opt(),
        qw| disk | => $disk,
        defined $o{'root'} ? ( qw| disk_root | => $o{'root'} ) : (),
        qw| root |     => _seal_root(),
        qw| host_dir | => host_dir(%common),
        qw| host_pub | => host_signer()->public,
        qw| exclude |  => $o{'exclude'} // [],
    );
}

sub cmd_placement {
    require AMOS7::N7FS::Placement;
    my $disk = disk_arg(shift);
    fail('placement : unexpected arguments') if @ARG;
    my $r = AMOS7::N7FS::Placement::placement_report( _placement_opt($disk) );
    foreach my $name ( sort keys $r->{'holders'}->%* ) {
        my $h = $r->{'holders'}{$name};
        say_line(
            'holder ',
            $name,
            ' [ ',
            $h->{'domain'},
            ' ] ',
            $h->{'state'},
            ' : ',
            $h->{'count'} // 0,
            ' nodes, ',
            $h->{'used'} // 0,
            ' bytes'
        );
    }
    foreach my $c ( sort keys $r->{'categories'}->%* ) {
        my $x = $r->{'categories'}{$c};
        say_line(
            'category ',
            $c,
            ' target ',
            $x->{'target'},
            ' : ',
            join ', ',
            map {"$x->{'count'}{$ARG}{'nodes'} nodes at $ARG"}
                sort { $a <=> $b } keys $x->{'count'}->%*
        );
        say_line(
            '  under-replicated ',
            $x->{'missing_nodes'},
            ' nodes, ',
            $x->{'missing_bytes'},
            ' bytes missing'
        ) if $x->{'missing_nodes'};
    }
    return 0;
}

sub cmd_place {
    require AMOS7::N7FS::Placement;
    my $disk = disk_arg(shift);
    fail('place : unexpected arguments') if @ARG;
    my $r = AMOS7::N7FS::Placement::place_missing( _placement_opt($disk),
        qw| dry_run | => $o{'dry-run'} ? TRUE : FALSE );
    foreach my $name ( sort keys $r->{'plan'}->%* ) {
        say_line(
            $o{'dry-run'} ? 'would place ' : 'placed ',
            $r->{'plan'}{$name},
            ' nodes on ', $name
        );
    }
    say_line( 'still under-replicated : ', $r->{'unplaced'}, ' nodes' )
        if $r->{'unplaced'};
    say_line('run holder-check on each holder so the new copies count')
        if not $o{'dry-run'} and keys $r->{'plan'}->%*;
    return 0;
}

sub cmd_shred {
    require AMOS7::N7FS::Seal;
    my $disk    = disk_arg(shift);
    my $address = shift // fail('shred needs an address');
    fail('shred : unexpected arguments')  if @ARG;
    fail('shred needs -out <holder-dir>') if not defined $o{'out'};
    my $version = AMOS7::N7FS::Seal::shred_node(
        qw| disk |    => $disk,
        qw| root |    => _seal_root(),
        qw| holder |  => $o{'out'},
        qw| address | => $address,
    );
    say_line( 'shred step 1 : wrap dropped [ head ',
        $version, ' ; local content and old maps retained ]' );
    return 0;
}

