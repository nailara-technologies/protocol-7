#!/usr/bin/perl
use v5.32.0;
use utf8;
use strict;
use English;
use warnings;

###      ###
##  n7fs  ##
###      ###

## N7FS : checksum-addressed store, standalone
## [ like p7-vault -- no zenka, no running network ]. new disks use format 2 :
## the delegated store key signs meta and state. format :
## data/md/design/N7FS-SPEC.md + data/md/design/N7FS-FORMAT-2.md [ as built ].
##
## n7fs keygen <file>                     new ed25519 key file [ 0600 ]
## n7fs pubkey <file>                     its public key [ base32 ]
## n7fs init -name <n> -intent <text>    a new disk under the root
## n7fs list                              disks under the root
## n7fs attach <disk> [ -allow-rollback ]
## n7fs detach <disk>
## n7fs status <disk> [ -allow-rollback ]
## n7fs verify <disk>                     every node of the active epochs
## n7fs get <disk> <address|path-name> [ -out <file> ]
##                                       verified content [ raw stdout ]
## n7fs find <disk> [ -name <regex> ] [ -format <fmt> ]
##                  [ -chksum <prefix> ] [ -all ]
## n7fs assimilate -disk <disk> [ -remove | -keep ] [ -dry-run ]
##                 [ -index <image-index.db> [ -index-base <dir> ] ]
##                 [ <path> .. ]   index + -remove needs -index-base
## n7fs upgrade <disk> [ -epoch <n> ]     convert into the next epoch of
##                                         the window [ -epoch : tests ]
## n7fs confirm <disk>                    confirm an upgrade
##
## common : -root <dir>        [ N7FS_ROOT, default /N7FS -- never created ]
##          -host-dir <dir>    [ N7FS_HOST_DIR, default ~/.n/n7fs ]
##          -host-key <file>   [ default <host-dir>/host.key ]
##          -parent-key <file> [ default <host-dir>/parent.key ]
##          -parent-cmd <cmd>  external parent signer [ words, list-form
##                              exec, no shell -- the host-root plug ]
##          -trust <b32 key>   trusted parent key [ repeatable ; else
##                              <host-dir>/trusted-parents ]
##
## assimilate KEEPS the sources unless -remove is given ; a source is only
## removed after its stored copy and the source itself verified again.
##
## single-dash long options, the house form -- no -- forms exist.

use FindBin;
use Cwd qw| abs_path |;
use Digest::BMW;
use Getopt::Long qw| GetOptionsFromArray |;

## our own long options take ONE dash : the prefix pattern rejects the gnu
## '--' form for every option of this cli
Getopt::Long::Configure('prefix_pattern=^-');

BEGIN {
    ## repo layout first, then a copy [ AMOS7/ beside the script ] ##
    unshift @INC, "$FindBin::Bin/../data/lib-path/pm", "$FindBin::Bin";
    unshift @INC, $ENV{'N7FS_TEST_LIB'} if $ENV{'N7FS_TEST_LIB'};
}

use AMOS7::N7FS       qw| root_dir host_dir b32 unb32 write_new_file_stream |;
use AMOS7::N7FS::Sum  qw| bmw_b32 epoch_from_b32 |;
use AMOS7::N7FS::Sign qw| key_file_signer key_file_write command_signer |;
use AMOS7::N7FS::Disk qw| disk_init disk_attach disk_detach disk_status
    disk_read_id state_read witness_check_format |;
use AMOS7::N7FS::Store qw| assimilate store_verify meta_entries node_path
    node_verify |;
use AMOS7::N7FS::Convert qw| upgrade confirm |;

##[ global constants ]##
use constant TRUE  => 5;    ##  TRUE.  ##
use constant FALSE => 0;    ##  false  ##

binmode STDOUT, qw| :encoding(UTF-8) |;
binmode STDERR, qw| :encoding(UTF-8) |;

my @args = @ARGV;
my %o    = ( qw| trust | => [] );
GetOptionsFromArray(
    \@args, \%o,
    qw| root=s host-dir=s host-key=s parent-key=s parent-cmd=s trust=s@
        name=s intent=s disk=s index=s index-base=s epoch=s remove keep dry-run
        out=s format=s chksum=s all allow-rollback help |
) or usage(2);
usage(0) if $o{'help'};

my $command = shift @args // usage(2);

my %common;
$common{'root'}     = $o{'root'}     if defined $o{'root'};
$common{'host_dir'} = $o{'host-dir'} if defined $o{'host-dir'};
if ( $o{'trust'}->@* ) {
    $common{'anchors'} = [
        map {
            my $pub = unb32($ARG);
            fail("-trust : not a base32 public key [ $ARG ]")
                if not defined $pub
                or length $pub != 32;
            $pub
        } $o{'trust'}->@*
    ];
}

my %run = (
    qw| keygen |     => \&cmd_keygen,
    qw| pubkey |     => \&cmd_pubkey,
    qw| init |       => \&cmd_init,
    qw| list |       => \&cmd_list,
    qw| attach |     => \&cmd_attach,
    qw| detach |     => \&cmd_detach,
    qw| status |     => \&cmd_status,
    qw| verify |     => \&cmd_verify,
    qw| get |        => \&cmd_get,
    qw| find |       => \&cmd_find,
    qw| assimilate | => \&cmd_assimilate,
    qw| upgrade |    => \&cmd_upgrade,
    qw| confirm |    => \&cmd_confirm,
);
usage(2) if not exists $run{$command};

my $code = eval { $run{$command}->(@args) };
if ( not defined $code ) {
    my $err = $EVAL_ERROR || "n7fs : failed\n";
    print STDERR $err;
    exit 1;
}
exit $code;

##[ HELPERS ]#################################################################

sub usage {
    my $exit = shift;
    open( my $fh, '<', $PROGRAM_NAME ) or exit $exit;
    while ( my $line = <$fh> ) {
        last                  if $line =~ m|^use FindBin|;
        print {*STDERR} $line if $line =~ m|^## |;
    }
    exit $exit;
}

sub fail { die "n7fs : $ARG[0]\n" }

sub say_line { say ': ', @ARG }

sub warn_unsigned_names {
    my ( $disk, $state ) = @ARG;
    print STDERR "n7fs : warning : disk $disk uses store "
        . "format 1 ; meta names are unsigned\n"
        if $state->{'store_format'} == 1;
    return;
}

sub host_signer {
    my $file = $o{'host-key'} // host_dir(%common) . '/host.key';
    fail("no host key $file [ n7fs keygen $file ]") if not -e $file;
    return key_file_signer($file);
}

sub optional_host_signer {
    my $file = $o{'host-key'} // host_dir(%common) . '/host.key';
    return undef if not -e $file and not defined $o{'host-key'};
    return host_signer();
}

sub read_common {
    my %read = %common;
    my $host = optional_host_signer();
    $read{'host'}           = $host if defined $host;
    $read{'allow_rollback'} = $o{'allow-rollback'} ? TRUE : FALSE;
    return %read;
}

sub parent_signer {
    if ( defined $o{'parent-cmd'} ) {
        return command_signer( split m|\s+|, $o{'parent-cmd'} );
    }
    my $file = $o{'parent-key'} // host_dir(%common) . '/parent.key';
    fail("no parent key $file [ n7fs keygen $file, or -parent-cmd ]")
        if not -e $file;
    return key_file_signer($file);
}

sub disk_arg {
    my $disk = shift // $o{'disk'} // fail('which disk ?');
    return $disk;
}

sub _latest_meta {
    my %latest;
    foreach my $entry (@ARG) {
        my $key = join "\0", $entry->{'address'},
            $entry->{'source'} // $entry->{'name'} // '';
        if ( not exists $latest{$key}
            or $entry->{'import_ntime'} gt $latest{$key}{'import_ntime'} ) {
            $latest{$key} = $entry;
        }
    }
    return values %latest;
}

sub _name_regex {
    my $pattern = shift // return undef;
    my $regex   = eval {qr/$pattern/};
    if ( not defined $regex ) {
        my $err = $EVAL_ERROR // 'invalid regex';
        chomp $err;
        fail("find : invalid -name regex [ $err ]");
    }
    return $regex;
}

sub _address_arg {
    my ( $target, $state ) = @ARG;
    return undef
        if $target !~ m|\A(V7[A-Z2-7]{5})/([A-Z2-7]{7})/([A-Z2-7]{77})\z|;
    my ( $epoch_name, $amos, $bmw ) = ( $1, $2, $3 );
    my $epoch = epoch_from_b32($epoch_name);
    fail("get : not a canonical address [ $target ]") if not defined $epoch;
    fail("get : address epoch is not active [ $target ]")
        if not grep { $ARG == $epoch } $state->{'epochs'}->@*;
    return { qw| epoch | => $epoch, qw| amos | => $amos, qw| bmw | => $bmw };
}

##[ COMMANDS ]################################################################

sub cmd_keygen {
    my $file = shift // fail('keygen needs a file');
    my $s    = key_file_write($file);
    say_line( 'key file ', $file );
    say_line( 'public   ', b32( $s->public ) );
    return 0;
}

sub cmd_pubkey {
    my $file = shift // fail('pubkey needs a file');
    say b32( key_file_signer($file)->public );
    return 0;
}

sub cmd_init {
    my $disk = disk_init(
        %common,
        qw| parent | => parent_signer(),
        qw| name |   => $o{'name'},
        qw| intent | => $o{'intent'},
    );
    say_line( 'disk ', $disk, ' created under ', root_dir(%common) );
    return 0;
}

sub cmd_list {
    my $root = root_dir(%common);
    fail("root $root is not a directory") if not -d $root;
    opendir( my $dh, $root ) or fail("cannot read $root : $OS_ERROR");
    say for sort grep {m|\A[A-Z2-7]{7}\z|} readdir $dh;
    closedir $dh;
    return 0;
}

sub cmd_attach {
    my $done = disk_attach(
        %common,
        qw| disk |           => disk_arg(shift),
        qw| host |           => host_signer(),
        qw| allow_rollback | => $o{'allow-rollback'} ? TRUE : FALSE,
    );
    say_line(
        sprintf '%s:%s attached [ %s, %s ]',
        $done->{'mount'}, $done->{'disk'},
        $done->{'ntime'}, $done->{'window'}
    );
    return 0;
}

sub cmd_detach {
    my $done = disk_detach(
        %common,
        qw| disk | => disk_arg(shift),
        qw| host | => host_signer(),
    );
    say_line(
        sprintf '%s:%s detached [ %s ]', $done->{'mount'},
        $done->{'disk'},                 $done->{'ntime'}
    );
    return 0;
}

sub cmd_status {
    my $s = disk_status(
        %common,
        qw| disk |           => disk_arg(shift),
        qw| host |           => host_signer(),
        qw| allow_rollback | => $o{'allow-rollback'} ? TRUE : FALSE,
    );
    warn_unsigned_names( $s->{'disk'}, $s->{'state'} );
    say_line( 'disk      ', $s->{'disk'} );
    say_line( 'name      ', $s->{'name'} );
    say_line( 'intent    ', $s->{'intent'} );
    say_line( 'init      ', $s->{'init'} );
    say_line( 'parent    ',
        $s->{'anchored'} ? 'trusted anchor' : 'not anchored [ tofu ]' );
    say_line( 'records   ', $s->{'records'} );
    say_line( 'window    ', $s->{'window'},
        defined $s->{'first'} ? " [ $s->{'first'} .. $s->{'last'} ]" : '' );
    say_line( 'attached  ', $s->{'attached'} // 'no' );
    say_line(
        'format    ',
        $s->{'state'}{'store_format'},
        $s->{'state'}{'previous'}
        ? ( ' [ from ',
            $s->{'state'}{'previous'}{'store_format'},
            $s->{'state'}{'confirmed'}
            ? ', confirmed ]'
            : ', unconfirmed ]'
            )
        : ()
    );
    say_line( 'epochs    ', join ' ', $s->{'state'}{'epochs'}->@* );
    return 0;
}

sub cmd_verify {
    my %read = read_common();
    my $r    = store_verify( %read, qw| disk | => disk_arg(shift) );
    say_line( sprintf '%d nodes verified [ format %d ]',
        $r->{'nodes'}, $r->{'state'}{'store_format'} );
    return 0;
}

sub cmd_get {
    my $disk   = disk_arg(shift);
    my $target = shift // fail('get needs an address or path name');
    fail('get : unexpected arguments') if @ARG;
    my %read  = read_common();
    my $id    = disk_read_id( %read, qw| disk | => $disk );
    my $state = state_read( $id->{'path'}, $id->{'store_pub'} );
    witness_check_format( %read, qw| id | => $id, qw| state | => $state )
        if ref $read{'host'};
    warn_unsigned_names( $disk, $state );
    my $addr = _address_arg( $target, $state );

    if ( not defined $addr ) {
        my %nodes;
        ## sources are stored absolute ##
        my $absolute = abs_path($target) // $target;
        foreach my $entry (
            _latest_meta( meta_entries( %read, qw| disk | => $disk ) ) ) {
            next
                if ( $entry->{'name'} // '' ) ne $target
                and ( $entry->{'source'} // '' ) ne $target
                and ( $entry->{'source'} // '' ) ne $absolute;
            $nodes{ $entry->{'address'} } = {
                qw| epoch | => $entry->{'epoch'},
                qw| amos |  => $entry->{'amos'},
                qw| bmw |   => $entry->{'bmw'},
            };
        }
        fail("get : no node named [ $target ]") if not keys %nodes;
        fail( "get : name resolves to several nodes [ $target ] :\n  "
                . join( "\n  ", sort keys %nodes ) )
            if keys %nodes > 1;
        ($addr) = values %nodes;
    }

    node_verify( $id->{'path'}, $addr, $state->{'store_format'}, $id );
    my $content = node_path( $id->{'path'}, $addr ) . '/content';

    if ( defined $o{'out'} ) {
        my $out = $o{'out'};
        fail('get : -out needs a file') if not length $out;
        fail("get : $out exists")       if -e $out or -l $out;
        write_new_file_stream(
            $out,
            sub {
                my $out_fh = shift;
                open( my $in, '<:raw', $content )
                    or die "cannot open $content : $OS_ERROR\n";
                my $ctx = Digest::BMW->new(384);
                while (1) {
                    my $got = sysread( $in, my $buf, 1048576 );
                    die "read $content : $OS_ERROR\n" if not defined $got;
                    last                              if $got == 0;
                    $ctx->add($buf);
                    print {$out_fh} $buf or die "$OS_ERROR\n";
                }
                close $in or die "close $content : $OS_ERROR\n";
                die "content does not match its address [ $target ]\n"
                    if bmw_b32( $ctx->digest ) ne $addr->{'bmw'};
            }
        );
        say_line( 'get ', $target, ' -> ', $out, ' [ verified ]' );
        return 0;
    }

    ## the second read can race a writer ; bytes already on stdout cannot be
    ## withdrawn, so verification must finish before streaming starts
    binmode STDOUT, qw| :raw |;
    open( my $in, '<:raw', $content )
        or fail("cannot open $content : $OS_ERROR");
    while (1) {
        my $got = sysread( $in, my $buf, 1048576 );
        fail("read $content : $OS_ERROR") if not defined $got;
        last                              if $got == 0;
        print {*STDOUT} $buf or fail("stdout : $OS_ERROR");
    }
    close $in or fail("close $content : $OS_ERROR");
    return 0;
}

sub cmd_find {
    my $disk = disk_arg(shift);
    fail('find : unexpected arguments') if @ARG;
    my %read  = read_common();
    my $id    = disk_read_id( %read, qw| disk | => $disk );
    my $state = state_read( $id->{'path'}, $id->{'store_pub'} );
    witness_check_format( %read, qw| id | => $id, qw| state | => $state )
        if ref $read{'host'};
    warn_unsigned_names( $disk, $state );
    my $regex = _name_regex( $o{'name'} );
    my @entries
        = $o{'all'}
        ? meta_entries( %read, qw| disk | => $disk )
        : _latest_meta( meta_entries( %read, qw| disk | => $disk ) );

    @entries = grep {
        my $entry = $ARG;
        (          not defined $regex
                or ( $entry->{'name'}   // '' ) =~ $regex
                or ( $entry->{'source'} // '' ) =~ $regex
            )
            and ( not defined $o{'format'}
            or ( $entry->{'format'} // '' ) eq $o{'format'} )
            and ( not defined $o{'chksum'}
            or index( $entry->{'amos'}, $o{'chksum'} ) == 0
            or index( $entry->{'bmw'},  $o{'chksum'} ) == 0 )
    } @entries;

    @entries = sort {
        ( $a->{'source'} // $a->{'name'} // '' )
            cmp( $b->{'source'} // $b->{'name'} // '' )
            or $a->{'address'} cmp $b->{'address'}
            or $a->{'import_ntime'} cmp $b->{'import_ntime'}
    } @entries;
    foreach my $entry (@entries) {
        my $label
            = length( $entry->{'source'} // '' )
            ? $entry->{'source'}
            : $entry->{'name'} // '?';
        my @stamp = (
            $entry->{'import_ntime'},
            $entry->{'converted_from_unsigned'}
            ? 'converted_from_unsigned'
            : ()
        );
        say join ' ', $entry->{'address'}, $entry->{'size'} // '?',
            $entry->{'format'} // 'unknown', $label,
            $o{'all'} ? '[ ' . join( ' ', @stamp ) . ' ]' : ();
    }
    return 0;
}

sub cmd_assimilate {
    fail('assimilate : -keep and -remove exclude each other')
        if $o{'keep'} and $o{'remove'};
    fail('assimilate : no paths and no -index')
        if not @args and not defined $o{'index'};
    my $r = assimilate(
        %common,
        qw| disk |       => disk_arg(),
        qw| host |       => host_signer(),
        qw| paths |      => [@args],
        qw| index |      => $o{'index'},
        qw| index_base | => $o{'index-base'},
        qw| protect | => [ grep {defined} $o{'host-key'}, $o{'parent-key'} ],
        qw| remove |  => $o{'remove'}  ? TRUE : FALSE,
        qw| dry_run | => $o{'dry-run'} ? TRUE : FALSE,
    );
    foreach my $e ( $r->{'entries'}->@* ) {
        say_line(
            join ' ',
            $e->{'status'},
            $e->{'source'} // '?',
            defined $e->{'addr'} ? ( '->', $e->{'addr'} ) : (),
            defined $e->{'then'} ? "[ $e->{'then'} ]"     : (),
            defined $e->{'why'}  ? "[ $e->{'why'} ]"      : ()
        );
    }
    say_line('dry run : nothing was changed') if $r->{'dry_run'};
    return $r->{'failed'} ? 1 : 0;
}

sub cmd_upgrade {
    my $r = upgrade(
        %common,
        qw| disk | => disk_arg(shift),
        qw| host | => host_signer(),
        defined $o{'epoch'} ? ( qw| epoch | => $o{'epoch'} ) : (),
    );
    if ( $r->{'from'} == $r->{'to'} ) {
        say_line("format $r->{'from'} is the newest this n7fs converts to");
        return 0;
    }
    say_line(
        sprintf 'format %d -> %d : %d nodes written into epoch %d '
            . '; the old form stays -- check, then n7fs confirm',
        $r->{'from'}, $r->{'to'}, $r->{'nodes'}, $r->{'epoch'} );
    return 0;
}

sub cmd_confirm {
    my $r = confirm(
        %common,
        qw| disk | => disk_arg(shift),
        qw| host | => host_signer(),
    );
    say_line( sprintf 'format %d confirmed [ %d nodes verified ]',
        $r->{'format'}, $r->{'nodes'} );
    return 0;
}

