#!/usr/bin/perl
use v5.32.0;
use utf8;
use strict;
use English;
use warnings;

###                  ###
##  p7-sign-agent     ##
###                  ###

## sourcecode signing agent
## [ todo HX4, data/md/design/VAULT-AGENT-SIGNING.md ] -- ssh-agent model for
## the 'proto-7.sourcecode' C25519 key. Runs as the USER, in the user's own
## login context, never a protocol-7-uid process and never a zenka child
## [ CREDENTIAL-LAYERS.md : the signing key is never handed to a zenka ]. The
## unlocked private key lives in THIS process's memory only and is wiped on
## every way out.
##
## p7-sign-agent [ --key <name> ] [ --socket <path> ] [ --key-dir <dir> ]
## [ --run-dir <dir> ] [ --test-stdin-approval ] [ -key-fd <n> ]
##
## ctrl-r on the agent's terminal while idle restarts it into the code on disk
## WITHOUT the passphrase : the unlocked key goes through a pipe kept open
## across exec [ -key-fd ], same pid and terminal. only when every repo file
## the agent loads [ itself, data/lib-path/pm ] carries a valid signature by
## this key -- otherwise a passphrase start is needed.
##
## standalone on purpose : needs perl, CryptX, Digest::BMW and the AMOS7
## modules in data/lib-path/pm [ AMOS7::13 + AMOS7::Twofish for the encrypted
## private key, AMOS7::TERM for the hidden passphrase prompt ].  nothing from
## a running protocol-7.  --test-stdin-approval
## [ or  P7_SIGN_AGENT_TEST_STDIN=1 ] is the ONLY case where the approval
## prompt may fall back to stdin -- tests, never production.
##
## line protocol, one op per connection [ see the design note ] :
##   HELLO                         -> OK <proto> <public-b32>
##   RUN <run> <tree-b32> <count>  -> then 'F <rel-b32> <chk-b32> <len>'
##                                    lines + 'GO'
##                                 -> OK | NO denied [ <reason-b32> ]
##   SIGN <run> <rel-b32> <body-chksum-b32> <body-len> <buffer-b32>
##                                 -> OK <signature-b32> | NO <reason>
##   END <run>                     -> OK <ntime-b32> <end-sig-b32>
## relative paths only on the wire -- the agent joins them under the
## approved work tree and validates every component. the F line's chksum
## + length bind the approval to the file CONTENTS [ BMW-512 over the
## signature-stripped body, the same value get-code-signed computes ]. the
## agent re-reads every file itself at RUN and again at SIGN and refuses
## the moment its own checksum disagrees -- an approved PATH alone signs
## nothing. the gate is the SO_PEERCRED same-uid check PLUS the per-run
## approval prompt in this process's own terminal.

use FindBin;
use Getopt::Long ();
use IO::File     ();
use IO::Select;
use IO::Socket::UNIX;
use Socket qw| SOL_SOCKET |;
use Cwd    ();
use Fcntl
    qw| :mode O_WRONLY O_CREAT O_EXCL O_APPEND F_GETFD F_SETFD FD_CLOEXEC |;
use File::Basename qw| dirname |;
use File::Path     qw| make_path |;
use File::Spec     ();
use Time::HiRes    ();
use POSIX          ();

##[ global constants ]##
use constant TRUE  => 5;    ##  TRUE.  ##
use constant FALSE => 0;    ##  false  ##

BEGIN {
    ## repo layout first [ bin/ + data/lib-path/pm ] ##
    unshift @INC, "$FindBin::Bin/../data/lib-path/pm", "$FindBin::Bin";
    ## no Inline C object in this process, ever : the compiled cache under ##
    ## ~/.7/inline-code is user-writable and carries no signature          ##
    ## [ todo RCM ] -- this process holds the unlocked signing key, so     ##
    ## every AMOS7 module takes its pure-perl alternative. set in BEGIN,   ##
    ## before the first AMOS7 module compiles ; the ctrl-r restart re-runs ##
    ## this block in the new process                                       ##
    $AMOS7::INLINE::force_pure_perl = TRUE;
}

use AMOS7::NTIME   qw| ntime_b32_now |;
use Crypt::Ed25519 ();
use Crypt::Misc    qw| encode_b32r decode_b32r |;
use Digest::BMW    ();
use AMOS7::13      qw| key_32 |;
use AMOS7::Twofish ();
use AMOS7::TERM
    qw| read_password_single confirm_key progress_line wipe_secret |;

binmode STDOUT, ':encoding(UTF-8)';
binmode STDERR, ':encoding(UTF-8)';
## the encoding layer buffers -- show the request now ##
STDERR->autoflush(1);
STDOUT->autoflush(1);

## linux SO_PEERCRED [ Socket.pm exports it there ; 17 is the arch value ] ##
my $SO_PEERCRED = eval { Socket::SO_PEERCRED() } // 17;

my $protocol_name    = qw| p7-sign-agent:002 |;    ## wire version, HELLO ##
my $key_name         = qw| proto-7.sourcecode |;
my $request_timeout  = 13;     ## seconds : client header + list lines ##
my $run_idle_seconds = 120;    ## approved runs expire when idle past this ##

## runtime dir : socket + runs.log. XDG_RUNTIME_DIR only when it exists and is
## writable [ wsl sets it to a /run/user/<uid> nobody created ] -- the client
## [ sourcecode.agent.sign ] resolves the same way
my $run_base
    = (     length( $ENV{'XDG_RUNTIME_DIR'} // '' )
        and -d $ENV{'XDG_RUNTIME_DIR'}
        and -w _ )
    ? $ENV{'XDG_RUNTIME_DIR'} =~ s|/+$||r
    : sprintf( qw| %s/.n/run |, $ENV{'HOME'} // ( getpwuid($EUID) )[7] );
my $socket_path = $ENV{'P7_SIGN_AGENT_SOCKET'}
    // sprintf qw| %s/p7-sign-agent.sock |, $run_base;
## the C25519 keypair store [ crypt.C25519.get_usr_keys_dir ] ##
my $key_dir
    = sprintf( qw| %s/.n/user-keys |,
    $ENV{'HOME'} // ( getpwuid($EUID) )[7] );

my $test_stdin_approval;    ## tests only : --test-stdin-approval ##
## or P7_SIGN_AGENT_TEST_STDIN=1      ##

## the restart re-runs this script with the same options                   ##
## [ minus a handed over -key-fd ] -- both kept before GetOptions consumes ##
## @ARGV                                                                   ##
my $script_path   = Cwd::abs_path($PROGRAM_NAME);
my @argv_original = @ARGV;
my $key_fd;    ## -key-fd <n> : the unlocked key from a restart [ ctrl-r ] ##

Getopt::Long::GetOptions(
    'key=s'               => \$key_name,
    'socket=s'            => \$socket_path,
    'key-dir=s'           => \$key_dir,
    'run-dir=s'           => \$run_base,
    'test-stdin-approval' => \$test_stdin_approval,
    'key-fd=i'            => \$key_fd,
) or die "p7-sign-agent : option error\n";

$test_stdin_approval = TRUE
    if not $test_stdin_approval
    and defined $ENV{'P7_SIGN_AGENT_TEST_STDIN'}
    and $ENV{'P7_SIGN_AGENT_TEST_STDIN'} eq '1';

## unlocked key material [ wiped on every exit path ] ##
my ( $key_public, $key_private );
my $runs_log_path = sprintf qw| %s/runs.log |, $run_base;
my $run_log_fh;
my %run_approved;    ## run id -> { tree, paths, last, peer_pid } ##

##[ terminal display ]########################################################

## the bin/ncode \ format-code palette [ NO_COLOR : plain ] ##
my %C = (
    qw|  T  | => "\e[38;2;6;71;195m",     ## bright blue : values ##
    qw|  0  | => "\e[38;2;68;39;172m",    ## blacklight : frame   ##
    qw|  1  | => "\e[38;2;38;46;153m",    ## blue : labels        ##
    qw|  2  | => "\e[38;2;170;94;2m",     ## orange : attention   ##
    qw|  3  | => "\e[38;2;9;170;94m",     ## green : done         ##
    qw|  B  | => "\e[1m",
    qw|  R  | => "\e[0m",
);
%C = map { $ARG => '' } keys %C if length( $ENV{'NO_COLOR'} // '' );

my $progress_open = FALSE;    ## a \r progress line waits for its \n ##

## the idle terminal watch [ ctrl-r ] and its saved mode ##
my ( $tty_watch, $tty_termios, $tty_lflag_saved );

sub progress_close {
    print STDERR "\n" if $progress_open;
    $progress_open = FALSE;
    return;
}

sub out_line {
    progress_close();
    return say STDERR sprintf '%s: %s%s%s', $C{'0'}, $C{'1'},
        join( '', @ARG ), $C{'R'};
}

sub ui_head {
    my $title = shift;
    progress_close();
    return print STDERR sprintf "\n%s.:[ %s%s%s%s%s ]:.%s\n%s:%s\n",
        $C{'0'}, $C{'T'}, $C{'B'}, $title, $C{'R'}, $C{'0'}, $C{'R'},
        $C{'0'}, $C{'R'};
}

sub ui_field {
    my ( $label, $value, $note ) = @ARG;
    return printf STDERR "%s:  %s%-10s%s: %s%s%s%s\n", $C{'0'}, $C{'1'},
        $label, $C{'0'}, $C{'T'}, $value,
        defined $note
        ? sprintf( ' %s[ %s%s %s]', $C{'0'}, $C{'1'}, $note, $C{'0'} )
        : '',
        $C{'R'};
}

sub ui_rule { return print STDERR sprintf "%s:%s\n", $C{'0'}, $C{'R'} }

## the agent at rest : startup and after every run           ##
## [ a 0.7s look at the summary first, then a clean screen ] ##
sub idle_show {
    ui_head(qw| p7-sign-agent |);
    ui_field(
        qw| key |,
        $key_name,
        sprintf( 'unlocked : pub %s',
            substr( encode_b32r($key_public), 0, 13 ) )
    );
    ui_field( qw| socket |, $socket_path, "uid $EUID only" );
    ui_field( 'run log', $runs_log_path );
    ui_rule();
    printf STDERR "%s:. %swaiting for requests%s\n",
        $C{'0'}, $C{'1'}, $C{'R'};
    return;
}

sub idle_return {
    Time::HiRes::sleep(0.7);
    print STDERR "\e[H\e[2J";
    return idle_show();
}

## a run's end on screen : the open progress line closed, then n of m ##
sub run_summary {
    my $run    = shift;
    my $reason = shift;
    return if ref $run ne qw| HASH |;
    my $signed = scalar keys $run->{'signed'}->%*;
    my $total  = $run->{'count'};
    progress_close();
    return printf STDERR "%s:\n%s:.[ %s%ssigned %d "
        . "of %d files%s%s : %s ]:.%s\n",
        $C{'0'}, $C{'0'}, $signed == $total ? $C{'3'} : $C{'2'},
        $C{'B'}, $signed, $total, $C{'R'}, $C{'0'}, $reason, $C{'R'};
}

## AMOS7::TERM::wipe_secret : in place random overwrite x2, then truncate
sub secret_wipe { return wipe_secret(@ARG) }

sub cleanup_exit {
    my $code = shift // 0;
    tty_watch_mode(FALSE);
    run_close( $ARG, 'agent exit' ) foreach sort keys %run_approved;
    secret_wipe( \$key_private ) if defined $key_private;
    unlink $socket_path          if -S $socket_path;
    exit $code;
}

$SIG{'INT'}  = sub { cleanup_exit(130) };
$SIG{'TERM'} = sub { cleanup_exit(130) };
$SIG{'HUP'}  = sub { cleanup_exit(130) };

END {    ## a signal's exit wipes the key too ##
    tty_watch_mode(FALSE);
    secret_wipe( \$key_private ) if defined $key_private;
}

##[ key loading ]#############################################################

sub passphrase_prompt {
    my $label = shift;
    foreach my $try ( 1 .. 3 ) {
        ## list context : the no-tty fallback returns ( pass, abort ) ##
        my ( $typed, undef ) = read_password_single($label);
        return undef                         if not defined $typed;
        return $typed                        if length $typed;
        say STDERR '  << empty -- try again' if $try < 3;
    }
    return undef;
}

sub key_load {

    my $pub_file  = sprintf qw| %s/%s.public |,  $key_dir, $key_name;
    my $priv_file = sprintf qw| %s/%s.private |, $key_dir, $key_name;

    die sprintf "p7-sign-agent : no key '%s' [ %s ]\n", $key_name, $key_dir
        if not -r $pub_file or not -r $priv_file;

    my $pub_b32  = read_key_file($pub_file);
    my $priv_b32 = read_key_file($priv_file);
    $key_public = decode_b32r($pub_b32);

    die "p7-sign-agent : public key decoding failed\n"
        if not defined $key_public
        or length $key_public != 32;

    ## encrypted private keys are b32-prefixed 'FY5', unencrypted 'KU5'
    ## [ crypt.C25519.get_type_from_key_str ] ; the 2-octet prefix comes off
    ## after decoding [ prefixed key material ]
    my $encrypted = index( $priv_b32, qw| FY5 |, 0 ) == 0 ? TRUE : FALSE;
    my $priv_dec  = decode_b32r($priv_b32);
    die "p7-sign-agent : private key decoding failed\n"
        if not defined $priv_dec
        or length $priv_dec < 64;
    substr( $priv_dec, 0, 2, '' ) if length $priv_dec == 66;    ## prefix ##

    if ( defined $key_fd ) {

        ## a restart [ ctrl-r ] : the previous process wrote the unlocked ##
        ## key into a pipe it kept open across exec -- no passphrase. the ##
        ## test signature below still proves it is the key of this public ##
        ## half. the gate ran before the exec [ restart_files_check ]     ##
        secret_wipe( \$priv_dec );
        open( my $key_fh, '<&=', $key_fd )
            or die "p7-sign-agent : -key-fd $key_fd : $OS_ERROR\n";
        binmode $key_fh;
        my $handed = '';
        read( $key_fh, $handed, 65 );
        close $key_fh;
        die "p7-sign-agent : -key-fd : no key handed over\n"
            if length $handed != 64;
        $key_private = $handed;
        secret_wipe( \$handed );
    } elsif ( not $encrypted ) {
        $key_private = $priv_dec;
    } else {
        my $pass = passphrase_prompt(
            sprintf "signing key '%s' decryption password", $key_name );
        die "p7-sign-agent : no passphrase, locked\n"
            if not defined $pass;
        my $enc_key = key_32( \$pass );
        secret_wipe( \$pass );
        die "p7-sign-agent : key derivation failed\n"
            if not defined $enc_key
            or length $enc_key != 32;

        my $status
            = AMOS7::Twofish::key_init( $enc_key, qw| decryption C25519 | );
        die "p7-sign-agent : twofish init failed\n"
            if not defined $status or not $status;
        my $dec_ref = AMOS7::Twofish::decrypt( qw| C25519 |, \$priv_dec );
        AMOS7::Twofish::delete_table_entry(qw| decryption C25519 |);
        secret_wipe( \$priv_dec );
        die "p7-sign-agent : private key decryption "
            . "failed [ wrong passphrase ? ]\n"
            if ref $dec_ref ne qw| SCALAR |
            or length $dec_ref->$* != 64;
        $key_private = $dec_ref->$*;
    }

    ## a test signature proves the passphrase opened the RIGHT key ##
    my $probe = Crypt::Ed25519::sign( qw| p7-sign-agent |,
        $key_public, $key_private );
    die "p7-sign-agent : decrypted key does not match the public half\n"
        if not Crypt::Ed25519::verify( qw| p7-sign-agent |,
        $key_public, $probe );

    return TRUE;
}

sub read_key_file {
    my $path = shift;
    open( my $key_fh, qw| < |, $path ) or return undef;
    my $line = <$key_fh>;
    close $key_fh;
    chomp $line;
    return $line;
}

##[ footer strip : same strict-mode rules as the signer ]#####################

## a focused port of source.extract_sig_body's strict strip path : the stub
## strips, then the end-anchored footer block with the separator restore.  it
## must byte-match the worker's strip -- drift fails closed, a refused file,
## never a wrong signature [ design note, 'what it signs' ]
sub strip_signature_footer {
    my $str_ref = shift;    ## raw file content, modified in place ##

    my $placeholder = qw| PLACEHOLDER |;

    ## old format stub : block ending with #[:]{70,} ##
    $str_ref->$*
        =~ s|\n?#[\.,]{70,}\n(?:#[^\n]*$placeholder[^\n]*\n)+#[:]{70,}\n?||sg;

    ## new format stub : comma-line + checksum + pipe + bracket-7 + colon ##
    $str_ref->$* =~ s{
            \n? \# [,\.]+ \n
            \# [A-Z0-9]{60,} \n
            \#+ \\+ \| PLACEHOLDER [^\n]* \n
            \#+ \\+ \[7] PLACEHOLDER [^\n]* \n
            \# :+
        }{}sgx;

    ## AMOS7 perl module stub : bare placeholder lines ##
    $str_ref->$* =~ s{
            \n? \# PLACEHOLDER_FOR_AMOS7_SIGNATURE_LINE_1 \n
            \#+ \\+ \| PLACEHOLDER_FOR_AMOS7_SIGNATURE_LINE_2 \n
            \#+ \\+ \[7] PLACEHOLDER_FOR_AMOS7_SIGNATURE_LINE_3 \n
            \# :+
        }{}sgx;

    ## llm-hallucinated fake footer : sequential letter+digit checksum ##
    $str_ref->$* =~ s{
            \n? \# [,\.]{70,} \n
            \# (?:[A-Z]\d){15,} [A-Z0-9]* \n
            \# \\+ \| [^\n]* \n
            \# \\+ \[7\] [^\n]* \n
            \n?
            \# :{70,} \n?
        }{}sgx;

    ## the footer block itself, anchored at end of string ##
    my $pattern = qr/(\n)?(# _{78}|#[\.,]{70,})\n((?:#[^\n]+\n)+)$/;

    if ( $str_ref->$* =~ m|$pattern| ) {
        my $separator = $1 // '';
        my $body      = $3 // '';
        return TRUE    ## nothing extractable : treat as unsigned content ##
            if index( $body, $placeholder, 0 ) != -1;
        my $header_line = $2;
        $str_ref->$* =~ s|$pattern||s;
        if ( length $separator ) {
            $str_ref->$* .= "\n";    ## separator restore ##
            endline_state_restore( $str_ref, $header_line );
        }
        return TRUE;
    }

    return TRUE;    ## no footer present : content is the body ##
}

## the endline state recorded at signing time : octal digit 11 of the footer's
## first line [ amos7.decode_octal_bit_header : '#,' + 19 'xxx,' groups, ',' =
## 0 '.' = 1 ], undone the way source.restore_payload_endline_state does
## [ 7 : 2 added, 5 : untouched, 0 : 4 removed ] -- so the agent's body is the
## same body the client's strict strip checksums. a header that does not
## decode leaves the body as it is [ the checksums then disagree : refused ]
sub endline_state_restore {
    my $str_ref     = shift;
    my $header_line = shift // return;
    return if $header_line !~ m|^#,(?:[,\.]{3},){19}$|;
    my $digit_bits = substr $header_line, 2 + 4 * 11, 3;
    $digit_bits =~ tr|,.|01|;
    my $state = oct qq|0b$digit_bits|;
    ## 0 : disallowed, decoder errs ##
    return if $state == 0 or $state == 5;
    my $delta = $state - 5;
    if ( $delta > 0 ) {    ## n newlines added at signing : remove n ##
        my $trailing = $str_ref->$* =~ m{(\n+)$} ? length $1 : 0;
        ## clamp, as the source ##
        $delta = $trailing               if $trailing < $delta;
        $str_ref->$* =~ s|\n{$delta}$||s if $delta > 0;
    } else {               ## n newlines removed at signing : add n back ##
        $str_ref->$* .= "\n" x abs $delta;
    }
    return;
}

##[ checksum helpers ]########################################################

sub bmw_b32 {
    my $bits = shift;
    my $data = shift;
    my $ctx  = Digest::BMW->new($bits);
    $ctx->add($data);
    return encode_b32r( $ctx->digest );
}

## the footer BMW-384 the sign buffer commits to : BMW-384 over the stripped
## body followed by '<header-line>#' [ the exact composition of
## source.create_harmonic_footer's cloned ctx + add ]
sub footer_bmw_b32 {
    my $body        = shift;
    my $header_line = shift;    ## includes its trailing newline ##
    my $ctx         = Digest::BMW->new(384);
    $ctx->add($body);
    $ctx->add( sprintf '%s#', $header_line );
    return encode_b32r( $ctx->digest );
}

sub slurp_file {
    my $path = shift;
    open( my $fh, qw| < |, $path ) or return undef;
    binmode $fh;
    my $data = do { local $INPUT_RECORD_SEPARATOR = undef; <$fh> };
    close $fh;
    return $data;
}

## a file's footer signature by THIS agent's key : the footer BMW over the
## stripped body, then Ed25519 over the signed buffer [ header line, '#', BMW,
## newline, the template's "#\\\|" -- source.fill_source_template ]
sub file_signature_valid {
    my $file = shift;
    my $raw  = slurp_file($file) // return FALSE;
    my ( $header_line, $footer_bmw, $sig_part_0, $sig_part_1 ) = $raw =~ m{
            (?:\A|\n) (\#[,\.]{70,}\n)
            \#([0-9A-Z]+)\n
            \#\\\\\\\x7C([0-9A-Z]+)\x20[^\n]*\n
            \#\\\[7\]([0-9A-Z]+)\x20[^\n]*\n
            \#:+\n?\z
        }x or return FALSE;

    my $body = $raw;
    strip_signature_footer( \$body );
    return FALSE if footer_bmw_b32( $body, $header_line ) ne $footer_bmw;

    my $signature = decode_b32r( $sig_part_0 . $sig_part_1 );
    return FALSE if not defined $signature or length $signature != 64;
    my $buffer = sprintf "%s#%s\n#\\\\\\|", $header_line, $footer_bmw;
    return Crypt::Ed25519::verify( $buffer, $key_public, $signature )
        ? TRUE
        : FALSE;
}

## the approved-content read : a run file's stripped body, derived from the
## AGENT's own disk read [ both at RUN and at SIGN ]. returns a scalar ref or
## undef when the path is not a readable regular file
sub run_file_body {
    my $run = shift;
    my $rel = shift;
    my $full_path
        = File::Spec->catfile( $run->{'work_tree'}, split m|/|, $rel );
    my @st = lstat $full_path;
    return undef if not @st or not S_ISREG( $st[2] );
    my $raw = slurp_file($full_path);
    return undef if not defined $raw;
    my $body = $raw;
    strip_signature_footer( \$body );
    return \$body;
}

##[ run log + signed end ]####################################################

sub run_log_open {
    ## the runtime dir may not exist yet                                  ##
    ## [ first start on the ~/.n/run fallback ] -- and no audit log means ##
    ## no signing : fail closed                                           ##
    if ( not -d $run_base ) {
        make_path( $run_base, { qw| mode | => 0700 } );
        chmod 0700, $run_base;
    }
    open( $run_log_fh, qw| >> |, $runs_log_path )
        or die "p7-sign-agent : cannot open $runs_log_path : $OS_ERROR\n";
    chmod 0600, $runs_log_path;
    $run_log_fh->autoflush(1);
    return TRUE;
}

sub run_log_line {
    return if not defined $run_log_fh;
    print {$run_log_fh} join( ' ', ntime_b32_now(5), @ARG ) . "\n";
    return;
}

## the signed end : an immutable capability-reduction statement. anyone with
## the public key verifies when a run's signing window closed
## [ todo PBS window audit ]
sub sign_end {
    my $run_id = shift;
    my $ntime  = ntime_b32_now(5);
    my $record = sprintf qw| p7-sign-agent:end:%s:%s |, $run_id, $ntime;
    my $sig    = Crypt::Ed25519::sign( $record, $key_public, $key_private );
    run_log_line( qw| end |, $run_id, $ntime, encode_b32r($sig) );
    return ( $ntime, encode_b32r($sig) );
}

sub run_close {
    my $run_id = shift;
    my $reason = shift // qw| ended |;
    return if not exists $run_approved{$run_id};
    sign_end($run_id);
    run_summary( $run_approved{$run_id}, "closed : $reason" );
    delete $run_approved{$run_id};
    idle_return() if $reason ne 'agent exit';
    return;
}

sub runs_expire {
    my $now = Time::HiRes::time();
    foreach my $run_id ( sort keys %run_approved ) {
        run_close( $run_id, qw| idle | )
            if $now - $run_approved{$run_id}{'last'} > $run_idle_seconds;
    }
    return;
}

## the request against HEAD for the 'd' key : tracked files through git diff,
## untracked ones as whole-file additions. list-form git commands
## [ no shell ]. with a core.pager [ 'diff-modified | less ..' here ] the diff
## comes colored and goes through that pager, as git diff would show it ;
## without one it comes plain for AMOS7::TERM::diff_page's own colors. returns
## ( text, diff_page options )
sub run_diff {
    my $work_tree = shift;
    my $paths     = shift;
    my @git_base  = ( qw| git -C |, $work_tree );

    my $read = sub {
        open( my $fh, '-|', @ARG ) or return '';
        local $INPUT_RECORD_SEPARATOR;
        my $out = <$fh> // '';
        close $fh;
        return $out;
    };

    return " :. not a git work tree, no diff .:\n"
        if $read->( @git_base, qw| rev-parse --is-inside-work-tree | )
        !~ m|^true|;

    my $pager = $read->( @git_base, qw| config --get core.pager | );
    $pager =~ s|\s+$||;
    my $color = length $pager ? qw| always | : qw| never |;
    my @git   = ( @git_base[ 0 .. 2 ], qw| -c |, "color.ui=$color" );
    my @flags = ( "--color=$color", qw| HEAD -- | );

    my $diff = $read->( @git, qw| diff |, @flags, $paths->@* );
    foreach my $untracked (
        split m|\n|,
        $read->(
            @git, qw| ls-files --others --exclude-standard -- |,
            $paths->@*
        )
    ) {
        $diff .= $read->(
            @git, qw| diff |, "--color=$color",
            qw| --no-index -- /dev/null |, $untracked
        );
    }
    return ( $diff, { qw| pager | => $pager } );
}

##[ approval ]################################################################

## the request block : once before the prompt, again after a diff
## [ the prompt clears the screen and calls it back through redraw ]
sub request_show {
    my $info = shift;
    ui_head('p7-sign-agent : signing request');
    ui_field( qw| key |,   $key_name );
    ui_field( qw| run |,   $info->{'run_id'} );
    ui_field( qw| tree |,  $info->{'work_tree'} );
    ui_field( qw| files |, $info->{'count'} );
    ui_field(
        qw| requester |,
        "pid $info->{'peer_pid'}",
        "uid $info->{'peer_uid'}"
    );
    ui_rule();

    foreach my $entry ( sort { $a->{'path'} cmp $b->{'path'} }
        $info->{'entries'}->@* ) {
        printf STDERR "%s:    %s./%s  %s%s%s\n", $C{'0'}, $C{'T'},
            $entry->{'path'}, $C{'1'}, substr( $entry->{'chksum'}, 0, 13 ),
            $C{'R'};
    }
    ui_rule();
    return;
}

## the approval seam : slice 1 is this terminal prompt. the later slices
## [ menu click, PIN, sized delegations, todo B2K ] replace this function
## behind the same name and leave everything else untouched
sub approve_run {
    my $info = shift;    ## { run_id, work_tree, count, entries, peer_pid } ##
    ## entries : aref of { path, chksum, length } -- the chksum prefix is ##
    ## shown next to each path so the approving eye binds to content, not ##
    ## just to a list of names [ todo HX4 follow-up ]                     ##

    request_show($info);
    ## one key on /dev/tty [ AMOS7::TERM::confirm_key, the ncode prompt ] ##
    my ( $answer, $reason ) = confirm_key(
        {   qw| question | =>
                sprintf( 'sign these %d files ?', $info->{'count'} ),
            qw| reason | => TRUE,
            qw| redraw | => sub { request_show($info) },
            qw| diff   | => sub {
                run_diff( $info->{'work_tree'},
                    [ map { $ARG->{'path'} } $info->{'entries'}->@* ] );
            }
        }
    );
    return ( $answer ? TRUE : FALSE, $reason ) if defined $answer;

    if ($test_stdin_approval) {
        print STDERR q|: sign ? [y/n] : |;
        $answer = <STDIN>;    ## test flag only -- never in production ##
    } else {
        out_line('approval refused : no controlling terminal');
        return FALSE;
    }
    return FALSE if not defined $answer;
    chomp $answer;
    return $answer eq qw| y | ? TRUE : FALSE;
}

##[ socket + peer gate ]######################################################

sub socket_set_up {
    if ( -e $socket_path ) {
        my ( undef, undef, undef, undef, $uid ) = lstat $socket_path;
        my $mode = ( lstat $socket_path )[2];
        die "p7-sign-agent : $socket_path exists and is not a socket\n"
            if not defined $mode
            or not S_ISSOCK($mode);
        die "p7-sign-agent : $socket_path is not owned by uid $EUID\n"
            if $uid != $EUID;
        ## a socket that still ANSWERS belongs to a live agent -- stop ; a
        ## dead one is stale and gets replaced [ crash residue ]
        if (IO::Socket::UNIX->new(
                'Type' => SOCK_STREAM,
                'Peer' => $socket_path
            )
        ) {
            die "p7-sign-agent : $socket_path is already served\n";
        }
        unlink $socket_path
            or die "p7-sign-agent : cannot replace "
            . "$socket_path : $OS_ERROR\n";
    }
    if ( not -d $run_base ) {
        make_path( $run_base, { qw| mode | => 0700 } );
        chmod 0700, $run_base;
    }
    my $server = IO::Socket::UNIX->new(
        qw| Type   | => SOCK_STREAM,
        qw| Listen | => 64,
        qw| Local  | => $socket_path,
    ) or die "p7-sign-agent : cannot bind $socket_path : $OS_ERROR\n";
    chmod 0600, $socket_path;
    return $server;
}

## the gate : SO_PEERCRED, and the peer uid must equal our euid -- that is the
## whole check in this slice [ design note, 'the gate' ]. pid + uid are logged
## for the record, never enforced
sub peer_uid_check {
    my $client   = shift;
    my @peercred = eval {
        no strict;
        unpack( qw| i* |, $client->sockopt($SO_PEERCRED) );
    };
    return undef if $@ or @peercred != 3;
    my ( $pid, $uid, undef ) = @peercred;
    return undef if $uid != $EUID;
    return ( $pid, $uid );
}

##[ protocol ]################################################################

sub respond_ok {
    my $client = shift;
    print {$client} join( ' ', qw| OK |, @ARG ) . "\n";
    return TRUE;
}

sub respond_no {
    my $client = shift;
    my $reason = join q| |, @ARG;
    $reason = qw| refused | if not length $reason;
    $reason =~ s|\s|_|g;
    print {$client} "NO $reason\n";
    return FALSE;
}

sub b32_field_valid {
    my $field = shift;
    return ( defined $field and length $field and $field =~ m|^[0-9A-Z]+$| )
        ? TRUE
        : FALSE;
}

## relative path check : no absolute, no .., no empty components ##
sub rel_path_valid {
    my $rel = shift;
    return FALSE if not defined $rel or not length $rel;
    return FALSE if index( $rel, qw| / |, 0 ) == 0;
    return FALSE if index( $rel, "\0" ) != -1;
    foreach my $part ( split m|/|, $rel ) {
        return FALSE if $part eq qw| .. | or not length $part;
    }
    return TRUE;
}

sub op_hello {
    my $client = shift;
    respond_ok( $client, $protocol_name, encode_b32r($key_public) );
    return;
}

sub op_run {
    my ( $client, $args_aref, $peer_pid, $peer_uid ) = @ARG;

    my ( $run_id, $work_tree_b32, $count ) = $args_aref->@*;
    return respond_no( $client, qw| run arguments | )
        if not defined $run_id
        or $run_id !~ m|^[0-9A-Za-z_.-]{1,80}$|
        or not b32_field_valid($work_tree_b32)
        or not defined $count
        or $count !~ m|^\d+$|
        or $count < 1;
    return respond_no( $client, qw| run already open | )
        if exists $run_approved{$run_id};

    my $work_tree = decode_b32r($work_tree_b32);
    return respond_no( $client, qw| work tree | )
        if not defined $work_tree
        or not length $work_tree
        or index( $work_tree, "\0" ) != -1
        or not -d $work_tree;

    my @entries;
    foreach my $n ( 1 .. $count ) {
        my $f_line = read_line_alarm( $client, $request_timeout );
        return respond_no( $client, qw| file list truncated | )
            if not defined $f_line;
        chomp $f_line;
        my ( $tag, $path_b32, $chk_b32, $len ) = split m| |, $f_line, 4;
        return respond_no( $client, qw| file list format | )
            if ( $tag // '' ) ne qw| F |
            or not b32_field_valid($path_b32)
            or not b32_field_valid($chk_b32)
            or not defined $len
            or $len !~ m|^\d+$|;
        my $rel = decode_b32r($path_b32);
        return respond_no( $client, qw| file list path | )
            if not rel_path_valid($rel);
        push @entries,
            {
            qw| path |   => $rel,
            qw| chksum | => $chk_b32,
            qw| length | => $len + 0
            };
    }

    my $go_line = read_line_alarm( $client, $request_timeout );
    return respond_no( $client, qw| file list go | )
        if not defined $go_line or $go_line ne "GO\n";

    ## content binding : read every file NOW, derive the stripped body from ##
    ## the agent's own disk read and compare against the client's chksum +  ##
    ## len -- approval binds to CONTENT, so a file that changed between the ##
    ## client's read and this prompt never enters the run [ todo HX4 ]      ##
    my $probe_run = { qw| work_tree | => $work_tree };
    my ( @mismatch, @unreadable );
    foreach my $entry (@entries) {
        my $body = run_file_body( $probe_run, $entry->{'path'} );
        if ( not defined $body ) {
            push @unreadable, $entry->{'path'};
        } elsif ( length $body->$* != $entry->{'length'}
            or bmw_b32( 512, $body->$* ) ne $entry->{'chksum'} ) {
            push @mismatch, $entry->{'path'};
        }
    }
    return respond_no( $client, sprintf 'content changed %d',
        scalar @mismatch )
        if @mismatch;
    return respond_no(
        $client,
        sprintf 'content unreadable %d',
        scalar @unreadable
    ) if @unreadable;

    ## the request is on screen now                                      ##
    ## [ p7-sign-run : preparing -> awaiting approval ] -- logged before ##
    ## the answer, so a denial has it too                                ##
    run_log_line( qw| request |, $run_id, scalar @entries,
        qw| pid |, $peer_pid );
    tty_watch_mode(FALSE);    ## the prompt \ reason line read cooked ##
    my ( $approved, $deny_reason ) = approve_run(
        {   qw| run_id    | => $run_id,
            qw| work_tree | => $work_tree,
            qw| count     | => scalar @entries,
            qw| entries   | => \@entries,
            qw| peer_pid  | => $peer_pid,
            qw| peer_uid  | => $peer_uid
        }
    );
    tty_watch_mode(TRUE);
    ## the reason travels base32 [ line protocol ] ##
    if ( not $approved ) {
        my @reason
            = length( $deny_reason // '' )
            ? encode_b32r($deny_reason)
            : ();
        run_log_line( qw| denied |, $run_id, scalar @entries, @reason );
        return respond_no( $client, qw| denied |, @reason );
    }

    ## what was approved is what the RUN read : a file swapped while the ##
    ## prompt [ or its diff ] was open is refused here, before any SIGN  ##
    my @changed_since = grep {
        my $body = run_file_body( $probe_run, $ARG->{'path'} );
        not defined $body
            or length $body->$* != $ARG->{'length'}
            or bmw_b32( 512, $body->$* ) ne $ARG->{'chksum'}
    } @entries;
    if (@changed_since) {
        run_log_line( qw| changed |, $run_id, scalar @changed_since );
        return respond_no(
            $client,
            sprintf 'content changed %d',
            scalar @changed_since
        );
    }

    $run_approved{$run_id} = {
        qw| work_tree | => $work_tree,
        qw| paths     | => {
            map {
                $ARG->{'path'} => {
                    qw| chksum | => $ARG->{'chksum'},
                    qw| length | => $ARG->{'length'}
                }
            } @entries
        },
        qw| last      | => Time::HiRes::time(),
        qw| peer_pid  | => $peer_pid,
        qw| count     | => scalar @entries,      ## display : n of m signed ##
        qw| signed    | => {},
    };
    my $list_chksum = bmw_b32(
        512,
        join( "\n",
            map  { sprintf '%s %s', $ARG->{'path'}, $ARG->{'chksum'} }
            sort { $a->{'path'} cmp $b->{'path'} } @entries )
    );
    run_log_line( qw| begin |, $run_id, scalar @entries,
        $list_chksum, qw| pid |, $peer_pid );

    ## the approved run takes the screen : request + diff cleared, a header ##
    ## and the format-code progress line until END                          ##
    print STDERR "\e[H\e[2J";
    ui_head('p7-sign-agent : signing');
    ui_field( qw| run |,   $run_id );
    ui_field( qw| files |, scalar @entries );
    ui_rule();
    ## label width : the longest path of the run, capped to the terminal ##
    ## [ the bar frame takes 28 columns ]                                ##
    my ( $columns, undef ) = AMOS7::TERM::terminal_size( \*STDERR );
    my $longest = 0;
    foreach my $entry (@entries) {
        $longest = length $entry->{'path'}
            if length $entry->{'path'} > $longest;
    }
    $run_approved{$run_id}{'label_width'}
        = $longest < $columns - 28 ? $longest : $columns - 28;
    print STDERR progress_line(
        '', 0,
        scalar @entries,
        $run_approved{$run_id}{'label_width'}
    );
    $progress_open = TRUE;

    return respond_ok($client);
}

sub op_sign {
    my ( $client, $args_aref, $peer_pid ) = @ARG;

    my ( $run_id, $path_b32, $body_chksum, $body_len, $buffer_b32 )
        = $args_aref->@*;
    return respond_no( $client, qw| sign arguments | )
        if not defined $run_id
        or not b32_field_valid($path_b32)
        or not b32_field_valid($body_chksum)
        or not defined $body_len
        or $body_len !~ m|^\d+$|
        or not b32_field_valid($buffer_b32);

    my $run = $run_approved{$run_id};
    return respond_no( $client, qw| unknown run | ) if not defined $run;

    ## the run dies with its requester : the pid approved at RUN is gone --
    ## close the run. cheap [ one kill 0 ] and safe enough : a same-uid peer
    ## only, ESRCH means truly gone, and a recycled pid number merely keeps
    ## the window open for the short idle budget instead of closing early
    if ( defined $run->{'peer_pid'} and not kill 0, $run->{'peer_pid'} ) {
        run_close( $run_id, 'requester gone' );
        return respond_no( $client, qw| run closed | );
    }

    my $rel = decode_b32r($path_b32);
    return respond_no( $client, qw| path | )
        if not rel_path_valid($rel);
    my $approved = $run->{'paths'}{$rel};
    return respond_no( $client, qw| path not in run | )
        if not defined $approved;

    my $body_ref = run_file_body( $run, $rel );
    return respond_no( $client, qw| not a regular file | )
        if not defined $body_ref;
    my $body = $body_ref->$*;

    ## approved-content binding : the disk body must still match what RUN   ##
    ## approved -- not only what this request claims [ todo HX4 follow-up ] ##
    return respond_no( $client, qw| content changed | )
        if length $body != $approved->{'length'};
    return respond_no( $client, qw| content changed | )
        if bmw_b32( 512, $body ) ne $approved->{'chksum'};

    ## request binding : the requester's checksum of the unsigned content ##
    return respond_no( $client, qw| content changed | )
        if length $body != $body_len;
    return respond_no( $client, qw| content changed | )
        if bmw_b32( 512, $body ) ne $body_chksum;

    ## buffer binding : data-chksum must be BMW-384 over exactly these ##
    ## stripped bytes + the presented header line [ design note ]      ##
    my $buffer = decode_b32r($buffer_b32);
    return respond_no( $client, qw| buffer format | )
        if not defined $buffer;
    ## the 5 tail bytes are fill_source_template's constant
    ## sig_template_prefix = substr( sign_template, 158, 5 ) -- the real
    ## template's "#\\\\\\|"
    ## [ '#', three backslashes, '|' : the start of footer line 3 ], so they
    ## are constrained to exactly that shape instead of any 5 bytes
    my ( $header_line, $footer_bmw, undef )
        = $buffer =~ m|^(\#[,\.]+\n)\#([0-9A-Z]+)\n(\#\\\\\\\x7C)\z|s;
    return respond_no( $client, qw| buffer format | )
        if not defined $header_line;
    return respond_no( $client, qw| binding mismatch | )
        if footer_bmw_b32( $body, $header_line ) ne $footer_bmw;

    $run->{'last'} = Time::HiRes::time();

    ## sign exactly the presented buffer bytes -- the key stays here ##
    my $signature
        = Crypt::Ed25519::sign( $buffer, $key_public, $key_private );
    run_log_line( qw| sign |, $run_id, $rel, $peer_pid );
    ## one redraw per FILE : a file takes hundreds of iteration signs and a ##
    ## redraw on each one floods the terminal                               ##
    if ( not $run->{'signed'}{$rel} ) {
        $run->{'signed'}{$rel} = TRUE;
        print STDERR progress_line( $rel, scalar keys $run->{'signed'}->%*,
            $run->{'count'}, $run->{'label_width'} );
        $progress_open = TRUE;
    }
    return respond_ok( $client, encode_b32r($signature) );
}

sub op_end {
    my ( $client, $args_aref ) = @ARG;
    my ($run_id) = $args_aref->@*;
    return respond_no( $client, qw| unknown run | )
        if not defined $run_id
        or not exists $run_approved{$run_id};
    my ( $ntime, $sig_b32 ) = sign_end($run_id);
    run_summary( $run_approved{$run_id}, 'run closed' );
    delete $run_approved{$run_id};
    my $responded = respond_ok( $client, $ntime, $sig_b32 );
    idle_return();    ## after the reply : the client never waits for it ##
    return $responded;
}

sub read_line_alarm {
    my ( $handle, $seconds ) = @ARG;
    my $timed_out = FALSE;
    my $line      = eval {
        local $SIG{'ALRM'} = sub { $timed_out = TRUE; die "alarm\n" };
        alarm $seconds;
        my $read = <$handle>;
        alarm 0;
        $read;
    };
    alarm 0;
    return undef if $timed_out;
    return $line;
}

sub request_handle {
    my ( $client, $peer_pid, $peer_uid ) = @ARG;

    my $line = read_line_alarm( $client, $request_timeout );
    return respond_no( $client, qw| empty | )
        if not defined $line or not length $line;
    chomp $line;

    my ( $op, @args ) = split m| |, $line;
    if ( $op eq qw| HELLO | ) {
        op_hello($client);
    } elsif ( $op eq qw| PING | ) {
        respond_ok($client);
    } elsif ( $op eq qw| RUN | ) {
        op_run( $client, \@args, $peer_pid, $peer_uid );
    } elsif ( $op eq qw| SIGN | ) {
        op_sign( $client, \@args, $peer_pid );
    } elsif ( $op eq qw| END | ) {
        op_end( $client, \@args );
    } else {
        respond_no( $client, qw| unknown op | );
    }
    return;
}

##[ restart : ctrl-r ]########################################################

## the agent's terminal while idle : single keys, no echo [ ctrl-r ]. the
## approval prompt [ its reason line ] and every way out get cooked mode back
sub tty_watch_open {
    open( $tty_watch, '<', qw| /dev/tty | ) or return undef $tty_watch;
    $tty_termios = POSIX::Termios->new;
    if ( not $tty_termios->getattr( fileno $tty_watch ) ) {
        close $tty_watch;
        return undef $tty_watch;
    }
    $tty_lflag_saved = $tty_termios->getlflag;
    return tty_watch_mode(TRUE);
}

sub tty_watch_mode {
    my $single_keys = shift;
    return if not defined $tty_watch or not defined $tty_lflag_saved;
    $tty_termios->setlflag(
          $single_keys
        ? $tty_lflag_saved & ~( POSIX::ICANON() | POSIX::ECHO() )
        : $tty_lflag_saved
    );
    $tty_termios->setcc( POSIX::VMIN(),  1 );
    $tty_termios->setcc( POSIX::VTIME(), 0 );
    $tty_termios->setattr( fileno $tty_watch, POSIX::TCSANOW() );
    ## the cursor only where input is typed : hidden while idle and while the
    ## progress runs, back for the prompt, every exit and the restart
    print STDERR $single_keys ? "\e[?25l" : "\e[?25h";
    return TRUE;
}

## the files a restart runs : the agent itself and its repo modules under
## data/lib-path/pm [ what the new process will load ]
sub restart_files {
    my $lib_root
        = Cwd::abs_path( sprintf qw| %s/../data/lib-path/pm |, $FindBin::Bin )
        // '';
    my %files = ( $script_path => TRUE );
    foreach my $loaded ( values %INC ) {
        my $abs = Cwd::abs_path($loaded) // next;
        $files{$abs} = TRUE
            if length $lib_root and index( $abs, "$lib_root/", 0 ) == 0;
    }
    return sort keys %files;
}

## the gate : the new process gets the unlocked key WITHOUT a passphrase.
## files signed by THIS key pass silently ; the others need an approval with
## their diff [ restart_agent ]. returns the unsigned ones
sub restart_files_check {
    return grep { not file_signature_valid($ARG) } restart_files();
}

## the code this process RUNS, kept at start : an unsigned restart shows
## exactly what changes between it and the files on disk now
my %code_snapshot;

sub code_snapshot_take {
    $code_snapshot{$ARG} = slurp_file($ARG) // '' foreach restart_files();
    return;
}

## running copy vs disk as a unified diff
## [ git diff --no-index, colored for a core.pager like run_diff ]. returns (
## text, diff_page options )
sub code_snapshot_diff {
    my @paths = @ARG;
    my $read  = sub {
        open( my $fh, '-|', @ARG ) or return '';
        local $INPUT_RECORD_SEPARATOR;
        my $out = <$fh> // '';
        close $fh;
        return $out;
    };
    my $tree  = Cwd::abs_path( sprintf qw| %s/.. |, $FindBin::Bin );
    my $pager = $read->( qw| git -C |, $tree, qw| config --get core.pager | );
    $pager =~ s|\s+$||;
    my $color = length $pager ? qw| always | : qw| never |;

    my $diff = '';
    foreach my $path (@paths) {
        my $running = sprintf qw| %s/running-copy.%d |, $run_base, $PID;
        sysopen( my $fh, $running, O_WRONLY | O_CREAT | O_EXCL, 0600 )
            or next;
        binmode $fh;
        print {$fh} $code_snapshot{$path} // '';
        close $fh;
        my $one = $read->(
            qw| git -c |, "color.ui=$color",
            qw| diff --no-index --no-prefix |,
            "--color=$color", qw| -- |, $running, $path
        );
        unlink $running;
        ( my $label = $path ) =~ s|^\Q$tree\E/||;
        ## headers : running/<path> vs disk/<path> ##
        ## [ git drops the leading / ]             ##
        ( my $running_bare = $running ) =~ s|^/||;
        ( my $path_bare = $path )       =~ s|^/||;
        $one =~ s|\Q$running_bare\E|running/$label|g;
        $one =~ s|\Q$path_bare\E|disk/$label|g;
        $diff .= $one;
    }
    return ( $diff, { qw| pager | => $pager } );
}

## exec into the code on disk, same pid and terminal. the key goes through a
## pipe whose read end survives the exec [ FD_CLOEXEC cleared ] : never argv,
## environment or a file
sub restart_agent {
    my $server = shift;

    if (%run_approved) {
        out_line('restart refused : a signing run is open');
        return;
    }
    ## unsigned code : the user sees the change and decides              ##
    ## [ the same y \ n \ d prompt as a signing request ] -- the upgrade ##
    ## path stays open, but never silently                               ##
    my @unsigned = restart_files_check();
    if (@unsigned) {
        ui_head('p7-sign-agent : restart into unsigned code');
        foreach my $path (@unsigned) {
            printf STDERR "%s:    %s%s%s\n", $C{'0'}, $C{'2'}, $path, $C{'R'};
        }
        ui_rule();
        tty_watch_mode(FALSE);
        my $approved = confirm_key(
            {   qw| question | => sprintf(
                    'restart into %d unsigned file%s ?',
                    scalar @unsigned,
                    @unsigned == 1 ? '' : 's'
                ),
                qw| diff | => sub { code_snapshot_diff(@unsigned) },
            }
        );
        tty_watch_mode(TRUE);
        if ( not $approved ) {
            out_line('restart cancelled -- the running agent goes on');
            return idle_return();
        }
        run_log_line(
            qw| agent-restart unsigned |,
            scalar @unsigned,
            bmw_b32( 512, join( "\n", @unsigned ) )
        );
    }

    pipe( my $key_read, my $key_write ) or do {
        out_line("restart refused : no pipe [ $OS_ERROR ]");
        return;
    };
    my $fd_flags = fcntl( $key_read, F_GETFD, 0 ) // 0;
    fcntl( $key_read, F_SETFD, $fd_flags & ~FD_CLOEXEC );
    binmode $key_write;
    print {$key_write} $key_private;
    close $key_write;

    run_log_line( qw| agent-restart |, $PID );
    close $server;
    unlink $socket_path if -S $socket_path;
    tty_watch_mode(FALSE);
    print STDERR "\e[H\e[2J";

    ## the same options, a handed over -key-fd replaced ##
    my @argv_kept;
    for ( my $i = 0; $i < @argv_original; $i++ ) {
        if ( $argv_original[$i] =~ m|^--?key-fd$| ) { $i++; next }
        next if $argv_original[$i] =~ m|^--?key-fd=|;
        push @argv_kept, $argv_original[$i];
    }
    exec(
        $EXECUTABLE_NAME, $script_path, @argv_kept,
        qw| -key-fd |,    fileno $key_read
        )
        or do {    ## exec failed : nothing is served any more ##
        out_line("restart failed : $OS_ERROR");
        cleanup_exit(1);
        };
    return;
}

##[ main ]####################################################################

key_load();
run_log_open();
my $server = socket_set_up();

code_snapshot_take();    ## the code this process runs [ restart diff ] ##
idle_show();
run_log_line(
    qw| agent-start |,
    $PID,
    encode_b32r($key_public),
    defined $key_fd ? qw| restarted | : ()
);

## the agent's own terminal : single keys while idle [ ctrl-r restarts ] ##
tty_watch_open();

my $select = IO::Select->new($server);
$select->add($tty_watch) if defined $tty_watch;

while (TRUE) {
    my @ready = $select->can_read(13);
    runs_expire();
    foreach my $ready_fh (@ready) {
        if ( defined $tty_watch and $ready_fh == $tty_watch ) {
            my $got = sysread( $tty_watch, my $key, 1 );
            cleanup_exit(0)        if not $got;   ## the terminal went away ##
            restart_agent($server) if $key eq "\x12";    ## ctrl-r ##
            next;
        }
        my $client = $server->accept() // next;
        my ( $peer_pid, $peer_uid ) = peer_uid_check($client);
        if ( not defined $peer_pid ) {
            print {$client} "NO peer refused\n";
            close $client;
            next;
        }
        request_handle( $client, $peer_pid, $peer_uid );
        close $client;
    }
}

## footer note : this file is unsigned until the owner's next
## update-signatures run -- no signing happens in the HX4 slice

