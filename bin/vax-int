#\\\|RQIFG4BW3XSVVI6JLVCNCV4I6TYZNLU5FH3PXWGQ23L5ACQKUAB \ / AMOS7 \ YOURUM ::
#\[7]Z4HXJGSIPPBYDEZCH4ENSWY5NGNLAHJQ7DGKYYX5DPRDR6EBJQBA 7  DATA SIGNATURE ::
