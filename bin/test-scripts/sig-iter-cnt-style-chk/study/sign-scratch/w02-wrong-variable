# name  = coding.cmd.complete-analysis
# descr = submit code task with auto-resume on incomplete
# param = <task_description>

# Parse task description from arguments
my $task_description = $call->{'args'} // '';

# Parameter validation
return { 'mode' => qw| false |, 'data' => 'task description required' }
    if not defined $task_description || not length $task_description;

return { 'mode' => qw| false |, 'data' => 'task description is empty' }
    if $task_description =~ /^\s*$/;

# Initialize jobs store if needed
<coding.complete_analysis_jobs> //= {};

# Parse task description (same format as submit command expects)
my $intake_result = <[coding.task.intake]>->($task_description);

if ( !$intake_result->{success} ) {
    return {
        'mode' => qw| false |,
        'data' => "Failed to parse task: "
            . ( $intake_result->{error} // 'unknown error' )
    };
}

my $task = $intake_result->{task};

# Analyze the task
my $analysis = <[coding.task.analyze]>->( 'full', $task );

if ( !$analysis->{success} ) {
    return {
        'mode' => qw| false |,
        'data' => "Failed to analyze task: "
            . ( $analysis->{error} // 'unknown error' )
    };
}

my $analyzed_task = $analysis->{task};

# Make routing decision
my $routing = <[coding.routing.decide_service]>->( 'route', $analyzed_task );

if ( !$routing->{success} ) {
    return {
        'mode' => qw| false |,
        'data' => "Failed to determine routing: "
            . ( $routing->{error} // 'unknown error' )
    };
}

my $routed_task = $routing->{task};

# Enqueue the task for execution (uses jobqueue backend)
my $queue_result = <[coding.task.enqueue]>->($routed_task);

if ( !$queue_result->{success} ) {
    return {
        'mode' => qw| false |,
        'data' => "Failed to enqueue task: "
            . ( $queue_result->{error} // 'unknown error' )
    };
}

# Create meta-job to track the completion chain
my $meta_id  = <[base.gen_id]>->(<coding.complete_analysis_jobs>);
my $meta_job = {
    'meta_id'      => $meta_id,
    'reply_id'     => $call->{'reply_id'},
    'task_id'      => $task->{id},
    'task'         => $routed_task,
    'description'  => $task_description,
    'status'       => qw| analyzing |,
    'accumulated'  => '',
    'resume_count' => 0,
    'max_resumes'  => 5,                     # Safety limit
    'start_time'   => <[base.time]>->(3),
};

<coding.complete_analysis_jobs>->{$meta_id} = $meta_job;

<[base.logs]>->(
    1,        "[complete-analysis] created meta-job=%s for task=%s",
    $meta_id, $routed_task->{id}
);

# Set up variable watcher to detect continuation requests
# Note: repeat => FALSE because handler sets continue_analysis = FALSE,
# which would trigger again
$meta_job->{'continuation_watcher'} = <[event.add_var]>->(
    {   'var'     => \$meta_job->{'continue_analysis'},
        'poll'    => qw| w |,
        'handler' => qw| coding.handler.check-completion-chain |,
        'repeat'  => FALSE,
        'data'    => $meta_id,
        'desc'    => sprintf( '[%s] continuation trigger', $meta_id )
    }
);

# Task will execute via coding.task.execute (uses async when enabled)
# The timer was removed because:
# - coding.task.execute now handles async mode exclusively
# - Blocking fallback is dead code
# - Timer was unnecessary; task goes through async path directly

<[base.logs]>->(
    1, "[complete-analysis] returning deferred, monitoring for completion"
);

return { 'mode' => qw| deferred | };

