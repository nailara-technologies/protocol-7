#!/usr/bin/perl

## coding-task — submit prompt to coding zenka via p7c with base32r encoding ##
##
## usage:
##   bin/coding-task "short prompt here"
##   bin/coding-task < prompt-file.txt
##   echo "prompt" | bin/coding-task
##   bin/coding-task -file task.md        ## read prompt from file
##   bin/coding-task -wait "prompt"       ## wait for result (blocking)
##   bin/coding-task                      ## interactive mode with readline

use strict;
use warnings;
use Crypt::Misc qw| encode_b32r |;

my $prompt       = '';
my $wait         = 0;
my $use_readline = 0;

## parse args ##
while ( my $arg = shift @ARGV ) {
    if ( $arg eq '-file' ) {
        my $file = shift @ARGV // die ":: -file requires a path\n";
        open my $fh, '<', $file or die ":: cannot read $file: $!\n";
        local $/;
        $prompt = <$fh>;
        close $fh;
    } elsif ( $arg eq '-wait' ) {
        $wait = 1;
    } elsif ( $arg eq '-help' or $arg eq '--help' ) {
        print <<~'USAGE';
        usage: coding-task [options] [prompt]

        options:
          -file PATH    read prompt from file
          -wait         block and wait for result (default: submit and exit)
          -help         show this help

        if no prompt arg:
          - checks X11 selection (if xsel available)
          - reads from stdin if piped
          - interactive readline mode if TTY

        prompt is base32r-encoded to avoid protocol framing issues.

        examples:
          coding-task "review module coding.validate.module"
          coding-task "improve-system-prompt: add note_search guidance"
          echo "fix bug in file.read" | coding-task
          coding-task -file task-description.md -wait
        USAGE
        exit 0;
    } elsif ( not length $prompt ) {
        $prompt = $arg;
    }
}

## get input from various sources ##
unless ( length $prompt ) {

    # Try X11 selection first (like vc_commit)
    if ( -x '/usr/bin/xsel' ) {
        my $selection = qx| /usr/bin/xsel -o 2>/dev/null |;
        if ( defined $selection && length $selection > 0 ) {
            chomp $selection;
            $prompt = $selection;
            print ":: using X11 selection\n" if -t STDERR;
        }
    }

    # If still no prompt, check stdin
    unless ( length $prompt ) {
        if ( -t STDIN ) {

            # Interactive mode - use readline like vc_commit
            $use_readline = 1;
        } else {

            # Piped input
            local $/;
            $prompt = <STDIN> // '';
        }
    }
}

## interactive mode with readline ##
if ( $use_readline && !length $prompt ) {
    require Term::ReadLine;

    my $term = Term::ReadLine->new('coding-task');
    $term->ornaments('mh,md') if $term->can('ornaments');
    $term->enableUTF8()       if $term->can('enableUTF8');

    print ":: enter coding task prompt (Ctrl-D to cancel):\n";

    my $min_len   = 5;
    my $max_len   = 4000;
    my $last_line = '';

    while ( not length $prompt ) {
        my $line = $term->readline( ' :. ', $last_line );

        last unless defined $line;    # Ctrl-D

        $term->add_history($line) if $line ne $last_line;

        my $len = length $line;
        if ( $len < $min_len ) {
            print ":: prompt too short (min $min_len chars)\n" if $len > 0;
        } elsif ( $len > $max_len ) {
            print ":: prompt too long (max $max_len chars)\n";
        } else {
            $prompt = $line;
        }
        $last_line = $line;
    }

    print "\n" unless length $prompt;
}

chomp $prompt if length $prompt;

die ":: empty prompt\n" unless length $prompt;

## encode ##
my $encoded = encode_b32r($prompt);

## build command with B32: prefix ##
my $cmd = sprintf "p7c coding.submit 'B32:%s'", $encoded;
$cmd .= ' -wait' if $wait;

## show summary ##
my $preview = substr( $prompt, 0, 80 );
$preview .= '...' if length $prompt > 80;
printf ":: prompt: %s\n", $preview;
printf ":: encoded: %d bytes → %d b32r chars\n",
    length($prompt), length($encoded);

## dispatch ##
exec $cmd;

#,,.,,,,,,,..,,,,,,,.,,.,,,..,.,.,,.,,,,.,.,,,.,.,...,...,,.,,.,,,...,...,..,,
#6LDODR42WZPULN2YI4L3GD55ITXPAMV33I6DBA4N3QI676LOAHKBWEJ5BAXMFN3Y5R7DFB4JMFBDK
#\\\|I7F7QSXHV4NFDYD633ATRPCUF7OTKQN7SGVEA2H5AJ6GVVSZYN3 \ / AMOS7 \ YOURUM ::
#\[7]VGFNS6OJREMPKVBYZ5RFOXEJ6XYQYPORWQ3UESYLLJ4VP3M5FIAA 7  DATA SIGNATURE ::
#:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
