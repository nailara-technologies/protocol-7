## [:< ##

# name = screenshot.init_code

<[base.perlmod.load]>->( 'Imager::Screenshot', qw| screenshot | );

<x11.display> //= $ENV{'DISPLAY'};
<x11.display> //= ':0.0';

$ENV{'DISPLAY'} = <x11.display>;

<screenshot.cfg.output_dir>
    //= catdir( <system.path.zenka-dirs.var_P7>, <system.zenka.name> );

## native x11 capture is silently non-functional under WSLg                  ##
## [ no error, no hang detection possible - exhaustively proven elsewhere ]; ##
## /proc/version is a stable, env-independent WSL marker, unlike             ##
## $ENV{WSL_DISTRO_NAME} which is absent when v7 itself was started from a   ##
## non-interactive root shell. detected once here rather than per-call,      ##
## since there is no reliable failure signal to fall back on after the fact  ##
<screenshot.cfg.use_powershell_passthrough> //= FALSE;
if ( -r '/proc/version' ) {
    my $version_sref = <[file.slurp]>->( '/proc/version', qw| :raw | );
    <screenshot.cfg.use_powershell_passthrough> = TRUE
        if defined $version_sref and $version_sref->$* =~ m|microsoft|i;
}

return FALSE;

