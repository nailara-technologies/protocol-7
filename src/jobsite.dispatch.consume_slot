## [:< ##

# name  = jobsite.dispatch.consume_slot
# descr = decrement pending_count for a queue entry skipped without dispatch

## a queue entry can be dropped before task.create ever fires             ##
## [ trashed job, stale generation ] -- it still occupied a pending_count ##
## slot from when the batch was enqueued, so that slot must be released   ##
## here or pending_count never reaches 0 and the cycle sticks on          ##
## 'assessing' forever, same failure class as                             ##
## jobsite.handler.task-created's decrement. with parallel dispatch more  ##
## than one release can race the drain -- the guard keeps the cycle-end   ##
## [ 'all assessments complete, cycle=idle' ] exactly once                ##

return if ( <jobsite.pending_count> // 0 ) <= 0;    ## already drained ##

<jobsite.pending_count>--;
if ( <jobsite.pending_count> <= 0 ) {
    <jobsite.pending_count> = 0;
    <jobsite.cycle>         = 'idle';
    <[base.logs]>->( 1, 'all assessments complete, cycle=idle' );
    ## a rescan skipped while assessing runs now                   ##
    ## [ a short delay : the result push below goes first ] -- see ##
    ## handler.rescan-timer                                        ##
    if (<jobsite.rescan_due>) {
        <[base.logs]>->( 1, 'dispatch.consume_slot: owed rescan in 30 s' );
        <[event.add_timer]>->(
            {   'after'   => 30,
                'handler' => 'jobsite.handler.rescan-timer',
            }
        );
    }
    if (<jobsite.sync.push_in_progress>) {
        ## current push already collected its job list; schedule follow-up ##
        <jobsite.sync.push_after_assess> = TRUE;
        <[base.logs]>->(
            1,
            'dispatch.consume_slot: sync push '
                . 'in progress, scheduling follow-up'
        );
    } else {
        <[jobsite.sync.push]>->( undef, FALSE )
            ;    ## push results to web immediately ##
    }
}

