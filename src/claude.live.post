## [:< ##

# name   = claude.live.post
# descr  = one message into a registered live session
# args   = { text from name [ needed when several ] sid }
# return = { name } or { error }

## a vanished socket path or a failed connect \ write drops the session     ##
## [ its token with it ] : the mcp server registers it again. without a     ##
## name only a single registration is used, never picked by age a sid finds ##
## its session under any name, and never reaches another one ; an old name  ##
## of a sid reaches the name that sid has now                               ##

my $arg      = shift // {};
my $sessions = <[claude.live.sessions]>;
my $name     = $arg->{'name'};
my $sid      = $arg->{'sid'};
my $holds    = sub {
    my $want = shift // return undef;
    my ($key)
        = CORE::grep { ( $sessions->{$ARG}{'sid'} // '' ) eq $want }
        CORE::sort CORE::keys %{$sessions};
    return $key;
};
if ( defined( my $current = $holds->($sid) ) ) {
    $name = $current;
} elsif ( defined $name and not CORE::exists $sessions->{$name} ) {
    $name = $holds->( <[claude.live.sessions]>->(qw| names |)->{$name} )
        // $name;
}
if ( not defined $name ) {
    ## among several a gone socket is no candidate [ claude.sessions ] ; a ##
    ## single one is dropped below, with its reason                        ##
    my @gone
        = CORE::keys %{$sessions} > 1
        ? CORE::grep { not -S $sessions->{$ARG}{'socket'} }
        CORE::keys %{$sessions}
        : ();
    foreach my $gone (@gone) {
        CORE::delete $sessions->{$gone};
        <[base.log]>->( 1, ": live session $gone dropped [ socket gone ]" );
    }
    my @names = CORE::sort CORE::keys %{$sessions};
    return {
        'error' => CORE::sprintf 'several live sessions [ %s ] : to=<name>',
        CORE::join( ', ', @names )
        }
        if @names > 1;
    $name = $names[0];
}
return { 'error' => 'no live session registered' } if not defined $name;
my $session = $sessions->{$name}
    // return { 'error' => "no live session '$name'" };
return { 'error' => "live session $name is another one [ sid ]" }
    if defined $sid
    and ( $session->{'sid'} // $sid ) ne $sid;

my $drop = sub {
    my $why = shift;
    CORE::delete $sessions->{$name};
    <[base.log]>->( 1, ": live session $name dropped [ $why ]" );
    return { 'error' => "live session $name dropped [ $why ]" };
};
return $drop->('socket gone') if not -S $session->{'socket'};

require IO::Socket::UNIX;
my $sock = IO::Socket::UNIX->new(
    'Peer'    => $session->{'socket'},
    'Timeout' => 2
) // return $drop->('connect failed');
my $octets = <[claude.live.wire]>->(
    {   'socket' => $session->{'socket'},
        'token'  => $session->{'token'},
        'text'   => $arg->{'text'},
        'from'   => $arg->{'from'},
    }
);
my $wrote = CORE::syswrite( $sock, $octets );
CORE::close($sock);
return $drop->('write failed')
    if not defined $wrote
    or $wrote != CORE::length $octets;
<[base.log]>->( 1, ": live session $name : message posted" );
return { 'name' => $name };

