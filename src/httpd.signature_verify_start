# name  = httpd.signature_verify_start
# descr = verify and strip a served text file in a child process

my $id           = shift;
my $file_path    = shift;
my $identity     = shift;
my $handler_args = shift;

my $session = $data{'session'}{$id};
return FALSE if not defined $session;

my $key_name = <httpd.cfg.signature_key_name> // qw| proto-7.sourcecode |;
my $debug    = <httpd.cfg.signature_debug>    // FALSE;
my $key_origin
    = exists $keys{'C25519'}{$key_name}{'public'}
    ? qw| pre-existing |
    : qw| embedded |;
if ( not exists $keys{'C25519'}{$key_name}{'public'} ) {
    <[crypt.C25519.load_from_string]>->(
        $key_name, <[protocol-7.source-key]>
    );
}
if ( not exists $keys{'C25519'}{$key_name}{'public'} ) {
    <[base.logs]>->( 1, '[%d] signed-file public key unavailable', $id );
    <[httpd.send_error_page]>->( $id, 500 );
    return 0;
}

pipe( my $result_r, my $result_w ) or do {
    <[base.logs]>->( 1, '[%d] signed-file pipe failed : %s', $id, $OS_ERROR );
    <[httpd.send_error_page]>->( $id, 500 );
    return 0;
};
binmode($result_r);
binmode($result_w);

my ( $body_fh, $body_path ) = <[file.temp]>->(
    qw| signed-body-XXXXXXXXXXXXX |,
    [qw| /var/protocol-7 /var/tmp |], TRUE
);
if ( not defined $body_fh ) {
    close $result_r;
    close $result_w;
    <[base.logs]>->( 1, '[%d] signed-file temporary file failed', $id );
    <[httpd.send_error_page]>->( $id, 500 );
    return 0;
}
close $body_fh;

my $pid = <[base.fork]>;
if ( not defined $pid ) {
    close $result_r;
    close $result_w;
    unlink $body_path;
    <[base.logs]>->( 1, '[%d] signed-file fork failed : %s', $id, $OS_ERROR );
    <[httpd.send_error_page]>->( $id, 500 );
    return 0;
}

if ( $pid == 0 ) {
    require POSIX;
    close $result_r;
    my $payload;
    my $payload_bytes = -1;
    my $result;
    my $verification;
    if ( not defined <[file.slurp]>->( $file_path, \$payload, qw| :raw | ) ) {
        $result = "invalid file-read\n";
    } else {
        $payload_bytes = length $payload;
        $verification = <[source.verify_and_strip]>->( \$payload, $key_name );
        if ( $verification->{'status'} eq qw| valid | ) {
            if ( open( my $output_fh, '>', $body_path ) ) {
                binmode $output_fh;
                print $output_fh $verification->{'body'}->$*;
                close $output_fh;
                $result = "valid source\n";
                if ( defined $verification->{'generator_public_key'} ) {
                    my $public_b32 = encode_b32r(
                        $verification->{'generator_public_key'} );
                    my $chain = $verification->{'generator_chain'} // '';
                    $result = "valid generated\n$public_b32\n$chain\n";
                }
            } else {
                $result = "invalid temporary-write\n";
            }
        } elsif ( $verification->{'status'} eq qw| unsigned | ) {
            $result = "unsigned\n";
        } else {
            my $error = $verification->{'error'} // qw| verification |;
            $error =~ s|[\r\n]| |g;
            $result = "invalid $error\n";
        }
    }
    if ($debug) {
        my $report
            = ref $verification->{'report'} eq qw| HASH |
            ? $verification->{'report'}
            : {};
        my $footer
            = ref $verification->{'footer'} eq qw| HASH |
            ? $verification->{'footer'}
            : {};
        my $truth
            = ref $report->{'entire-payload'} eq qw| HASH |
            ? $report->{'entire-payload'}
            : {};
        my $signed_data
            = substr( $footer->{'signature-footer-str'} // '', 0, 163 );
        my $public_key   = $keys{'C25519'}{$key_name}{'public'};
        my $report_value = sub {
            my $name = shift;
            return qw| na |    if not exists $report->{$name};
            return qw| undef | if not defined $report->{$name};
            return $report->{$name};
        };
        my @debug_values = (
            qw| status= | . ( $verification->{'status'} // qw| file-read | ),
            qw| check= | .  ( $verification->{'error'}  // qw| none | ),
            qw| key= | . $key_name,
            qw| key-origin= | . $key_origin,
            qw| public= |
                . (
                defined $public_key ? encode_b32r($public_key) : qw| na |
                ),
            qw| payload-bytes= | . $payload_bytes,
            qw| payload-utf8= |
                . ( defined $payload and utf8::is_utf8($payload) ? 1 : 0 ),
            qw| signed-bytes= | . length($signed_data),
            qw| signed-bmw384= |
                . (
                length $signed_data
                ? <[chk-sum.bmw.strsum]>->( $signed_data, 384 )
                : qw| na |
                ),
            qw| AMOS-checksum= | . $report_value->('AMOS-chksum-matches'),
            qw| BMW-checksum= | . $report_value->('bmw-chksum-matches'),
            qw| ELF-truth-4= | . ( $truth->{4} // qw| na | ),
            qw| ELF-truth-7= | . ( $truth->{7} // qw| na | ),
            qw| signature= | . $report_value->('signature-is-valid'),
            qw| signature-unverifiable= |
                . $report_value->('signature-unverifiable'),
            qw| signature-error= | . $report_value->('signature-error')
        );
        foreach my $value (@debug_values) {
            $value =~ s|[\r\n;]| |g;
        }
        $result .= join( '', 'debug ', join( ';', @debug_values ), "\n" );
    }
    print $result_w $result;
    close $result_w;
    POSIX::_exit(0);
}

close $result_w;
<[httpd.base.file.nonblocking]>->($result_r);
$session->{'signature_pending'} = {
    qw| pid          | => $pid,
    qw| identity     | => $identity,
    qw| file_path    | => $file_path,
    qw| body_path    | => $body_path,
    qw| handler_args | => $handler_args,
    qw| result       | => ''
};
$session->{'watcher'}->{'signature_handler'} = <[event.add_io]>->(
    {   qw| fd      | => $result_r,
        qw| handler | => qw| httpd.handler.signature_verify |,
        qw| poll    | => qw| r |,
        qw| data    | => { qw| id | => $id }
    }
);

return 0;

