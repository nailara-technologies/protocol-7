## [:< ##

# name  = ticker.cmd.status-clear
# param = <key>
# descr = remove a status line [ by key ]

my $key = $call->{'args'} // '';
$key =~ s{\A\s+|\s+\z}{}g;
return { 'mode' => qw| false |, 'data' => 'status line key expected' }
    if $key !~ m|\A[\w.:-]{1,80}\z|;

my $lines = <ticker.status.lines> //= {};
return { 'mode' => qw| true |, 'data' => "no status line '$key'" }
    if not exists $lines->{$key};
delete $lines->{$key};

<[ticker.status.apply]>;
return { 'mode' => qw| true |, 'data' => "status line '$key' cleared" };

