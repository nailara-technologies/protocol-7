## [:< ##

# name  = editor.buffer.memory.load
# descr = load text into in-memory editor buffer

my ( $buffer, $source ) = @ARG;

return undef if ref $buffer ne qw| HASH |;
return undef if $buffer->{'readonly'};

my $text = $source // '';
$text = $$text if ref $text eq qw| SCALAR |;
utf8::decode($text) if length $text and not utf8::is_utf8($text);

$buffer->{'text'}   = $text;
$buffer->{'cursor'} = 0;

## an external rewrite bypasses insert/delete entirely -- resync the parallel
## star-count array here too, or a masked field's mask_stars goes stale [
## mismatched against the new text ] and stays that way forever, since neither
## insert nor delete ever rebuilds it wholesale, only trims at a given
## position -- editor.control.get_display_value's own mismatch guard would
## then permanently fall back to flat, length-revealing masking for the rest
## of the session
$buffer->{'mask_stars'} = [ map { int( 1 + rand(3) ) } 1 .. length $text ]
    if ( $buffer->{'type'} // '' ) eq qw| masked |;

return TRUE;

