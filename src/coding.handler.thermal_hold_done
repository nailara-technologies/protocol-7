# name  = coding.handler.thermal_hold_done
# descr = event-timer : a thermal round hold ran out, enqueue the round
#         again [ it passes the hover gate once more ]

my $timer_data = eval { shift->w->data } // {};
my $task_id    = $timer_data->{'task_id'};
my $round      = $timer_data->{'round'};

return unless defined $task_id and defined $round;

delete <coding.thermal.held>->{$task_id};

<[coding.task.enqueue_round]>->( $task_id, $round );

return;

