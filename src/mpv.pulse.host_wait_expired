# name = mpv.pulse.host_wait_expired
# descr = powershell.pulse-start gave no reply in time : try the host anyway

delete <mpv.pulse.host_wait_timer>;
return if not defined <mpv.pulse.pending_host_server>;

## same path as a failed reply : log it , set the server , start mpv ##
<[mpv.pulse.handler.host_started]>
    ->( { 'data' => 'no reply from powershell.pulse-start in time' } );

