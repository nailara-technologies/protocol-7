## [:< ##

# name  = nameserv.entry.identity
# descr = canonical identity key of a dns record
# param = $zone_name, $record -> identity string

my $zone_name = shift // '';
my $record    = shift;

return undef if ref $record ne qw| HASH |;

my $type = uc( $record->{'type'} // '' );

## single-value types key on zone + name + type                           ##
## [ design :  timestamp delta sync ] ; every other type keys on value as ##
## well, so distinct values of the same name never collide                ##
my $single_value = ( $type eq qw| SOA | or $type eq qw| CNAME | );

return join( "\0",
    lc($zone_name), lc( $record->{'name'} // '' ),
    $type, ( $single_value ? () : ( $record->{'value'} // '' ) ) );

