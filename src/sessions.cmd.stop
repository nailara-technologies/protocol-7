## [:< ##

# name  = sessions.cmd.stop
# descr = terminate the key-holding child [ SIGTERM triggers a
#         secure key erase before exit ], clear parent-side state

my $pid = <sessions.holder.pid>;

if ( not defined $pid ) {
    return { 'mode' => qw| size |, 'data' => "<< nothing running >>\n" };
}

kill qw| TERM |, $pid;

my $sock = <sessions.holder.client_sock>;
close($sock) if defined $sock;
my $listen_sock = <sessions.holder.listen_sock>;
close($listen_sock) if defined $listen_sock;

<sessions.holder.pid>         = undef;
<sessions.holder.client_sock> = undef;
<sessions.holder.listen_sock> = undef;
<sessions.holder.state>       = qw| unspawned |;

return { 'mode' => qw| size |, 'data' => "<< stopped >>\n" };

