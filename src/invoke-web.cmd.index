## [:< ##

# name  = invoke-web.cmd.index
# descr = image index job [ start | stop | status ]
# param = start | stop | status [ default status ]

my $arg = lc( $call->{'args'} // '' );
$arg =~ s{^\s+|\s+$}{}g;
$arg = qw| status | if not length $arg;

return { mode => qw| false |, data => 'expected : start | stop | status' }
    if $arg !~ m{^(?:start|stop|status)$};

if ( $arg eq qw| start | ) {
    return { mode => qw| false |, data => 'image index job already running' }
        if <invoke-web.index.running>;
    return { mode => qw| false |, data => 'image index db not available' }
        if not defined <[invoke-web.index.db]>;

    <invoke-web.index.running> = TRUE;
    <invoke-web.index.cursor>  = 0;
    <invoke-web.index.stats>
        = { 'indexed' => 0, 'skipped' => 0, 'failed' => 0 };
    <[base.zenki.pause_ondemand_timeout]>;    ## the job keeps the zenka ##
    ## idle watcher [ index zenka pattern, index.tick.start ] : a step runs
    ## only when the event loop has nothing else to do -- heartbeats and
    ## replies always come first, idle time goes to the job
    <invoke-web.index.idle_watcher> //= <[event.add_idle]>->(
        {   'handler'   => 'invoke-web.index.step',
            'repeat'    => TRUE,
            'reentrant' => FALSE,    ## event.once turns inside a step ##
            'desc'      => 'invoke-web image index',
        }
    );
    return { mode => qw| size |, data => "image index job started\n" };
}

if ( $arg eq qw| stop | ) {
    return { mode => qw| false |, data => 'image index job not running' }
        if not <invoke-web.index.running>;
    <[invoke-web.index.finish]>->('stopped');
    return { mode => qw| size |, data => "image index job stopped\n" };
}

## status ##
my $index = <[invoke-web.index.db]>;
my ( $images, $sources )
    = defined $index
    ? (
    $index->selectrow_array('SELECT COUNT(*) FROM images'),
    $index->selectrow_array('SELECT COUNT(*) FROM sources')
    )
    : ( '?', '?' );
my $source_db = <[invoke-web.queue.db]>;
my ($total)
    = defined $source_db
    ? $source_db->selectrow_array( 'SELECT COUNT(*) FROM images WHERE '
        . 'is_intermediate = 0 AND deleted_at '
        . 'IS NULL' )
    : ('?');
my $stats = <invoke-web.index.stats> // {};

return {
    mode => qw| size |,
    data => sprintf(
        "job     : %s%s\nindexed : %s sources of %s "
            . "invoke.ai images [ %s distinct contents ]\n",
        <invoke-web.index.running> ? 'running' : 'idle',
        <invoke-web.index.running>
        ? sprintf(
            ' [ %d new, %d skipped, %d missing, %d failed ]',
            $stats->{'indexed'} // 0,
            $stats->{'skipped'} // 0,
            $stats->{'missing'} // 0,
            $stats->{'failed'}  // 0
            )
        : '',
        $sources, $total, $images
    )
};

