## [:< ##

# name  = base.dependency.install_callbacks
# descr = install per-type dependency check + resolve callbacks

my $name_prefix = shift;
$name_prefix //= <system.zenka.name>;

<[base.log]>
    ->( 2, "installing '$name_prefix' dependency object callbacks.." );

## object_type => { callback => sub_name, resolve => sub_name } ##
my %by_type;
foreach my $sub_name ( sort keys %code ) {
    if ( $sub_name =~ m{^$name_prefix\.callback\.object\.([\w\.]+)$} ) {
        my $object_type = $1;
        <[base.log]>->( 2, ": found object type '$object_type' [callback]" );
        $by_type{$object_type}->{'callback'} = $sub_name;
    } elsif ( $sub_name =~ m{^$name_prefix\.resolve\.object\.([\w\.]+)$} ) {
        my $object_type = $1;
        <[base.log]>->( 2, ": found object type '$object_type' [resolve]" );
        $by_type{$object_type}->{'resolve'} = $sub_name;
    }
}

<[base.log]>->(
    0, ": no dependency object callbacks found for '$name_prefix'"
) if !keys %by_type;

foreach my $object_type ( sort keys %by_type ) {
    my $type_setup = {};
    $type_setup->{'callback'} = $code{ $by_type{$object_type}->{'callback'} }
        if defined $by_type{$object_type}->{'callback'};
    $type_setup->{'resolve'} = $code{ $by_type{$object_type}->{'resolve'} }
        if defined $by_type{$object_type}->{'resolve'};
    <[dependency.setup]>->( $object_type, $type_setup );
}

return scalar keys %by_type;

