## [:< ##

# name  = nameserv.enc.active
# descr = is the encrypted path in use : [ flag, sources, fallback servers ]

## a network whose stored behaviour is intercepting or blocking-outside     ##
## moves the default route to the encrypted upstreams ; the dhcp servers of ##
## those networks are the degraded fallback [ the held server ]             ##

my $by = <nameserv.upstreams.behaviour_by_source> // {};
my ( @sources, @fallback, %seen );
for my $source ( sort keys %{$by} ) {
    next
        if ( $by->{$source}{'behaviour'} // '' )
        !~ m{^(?:intercepting|blocking-outside)$};
    push @sources, $source;
    push @fallback,
        grep { not $seen{ lc $ARG }++ } @{ $by->{$source}{'dhcp'} // [] };
}
return ( scalar(@sources) ? TRUE : FALSE, \@sources, \@fallback );

