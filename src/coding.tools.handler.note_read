## [:< ##

# name  = coding.tools.handler.note_read
# descr = read notes from current or previous task at specified level

my $args = shift // {};

my $task_id     = $args->{'task_id'}     // <system.task_id> // 'unknown';
my $level       = $args->{'level'}       // 'L3';    ## L1, L2, or L3 ##
my $offset      = $args->{'offset'}      // 0;
my $max_results = $args->{'max_results'} // 20;

## validate level ##
$level = 'L3' unless $level =~ /^(L1|L2|L3)$/;

## clamp offset ##
$offset = 0 if $offset < 0;

my $result = <[note.read]>->( $task_id, $level );

my $output;
if ( $result->{'mode'} eq qw| true | ) {
    my $data = $result->{'data'};
    $output = "Notes for task $task_id (level $level):\n\n";

    if ( $level eq 'L1' || $level eq 'L2' ) {
        $output .= $data->{'summary'} // '[no summary]';
    } else {
        ## L3 - list sections with offset/max_results pagination ##
        my $sections = $data->{'sections'} // {};
        my @names    = sort keys %$sections;
        my $total    = scalar @names;

        if ( $total == 0 ) {
            $output .= '[no notes found]';
        } elsif ( $offset >= $total ) {
            $output .= sprintf
                "offset %d is past end [ %d sections total ]",
                $offset, $total;
        } else {
            my $end = $offset + $max_results - 1;
            $end = $total - 1 if $end >= $total;
            my @visible = @names[ $offset .. $end ];
            my $shown   = scalar @visible;

            $output .= sprintf "[ sections %d-%d of %d ]\n\n",
                $offset + 1, $offset + $shown, $total;

            for my $name (@visible) {
                $output .= "=== $name ===\n" . $sections->{$name} . "\n";
            }

            ## truncation hint when more remain ##
            if ( $offset + $shown < $total ) {
                my $remaining   = $total - ( $offset + $shown );
                my $next_offset = $offset + $shown;
                $output
                    .= sprintf "\n[ %d section(s) remaining "
                    . "-- next: note_read offset=%d ]",
                    $remaining, $next_offset;
            }
        }
    }
} else {
    $output = "Error: " . ( $result->{'data'} // 'unknown' );
}

return { 'content' => $output };

