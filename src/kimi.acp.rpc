## [:< ##

# name   = kimi.acp.rpc
# descr  = send a json-rpc request, remember what it was
# param  = method, params, kind, extra
# return = the request id

my ( $method, $params, $kind, $extra ) = @ARG;
my $st = <[kimi.acp.state]>;

my $id = ++$st->{'next_id'};
$st->{'pending'}{$id}
    = { 'method' => $method, 'kind' => $kind, 'extra' => $extra // {} };
<[kimi.acp.write]>
    ->( { 'id' => 0 + $id, 'method' => $method, 'params' => $params // {} } );
return $id;

