## [:< ##

# name   = invoke-web.queue.release
# descr  = held items -> 'pending' again [ after the startup pause, or when
#          the start failed ] ; retries on a locked db [ 2s, 10x ]
# param  = [ attempt ]
# return = number of released items | undef [ retry armed \ no db ]

my $attempt = shift // 1;

my $dbh = <[invoke-web.queue.db]>;
my $released
    = defined $dbh
    ? $dbh->do(
    "UPDATE session_queue SET status = 'pending' WHERE status = 'held'")
    : undef;

if ( not defined $released ) {
    my $reason = defined $dbh ? $dbh->errstr : 'no queue db';
    if ( $attempt >= 10 ) {
        <[base.logs]>->(
            0,
            'queue release failed [ %s ] -- items stay '
                . 'held, released at the next zenka start',
            $reason
        );
        return undef;
    }
    <[base.logs]>->( 2, 'queue release retry [ %s ]', $reason );
    <[event.add_timer]>->(
        {   'after'   => 2,
            'handler' => 'invoke-web.handler.queue_release_retry',
            'data'    => { 'attempt' => $attempt + 1 },
        }
    );
    return undef;
}

$released += 0;
<[file.zenka_dir.unlink_file]>->(
    <[invoke-web.state_name]>->('held-items'), TRUE
);
<[base.logs]>->(
    1,         'queue : %d held item%s released',
    $released, $released == 1 ? '' : 's'
) if $released;

return $released;

