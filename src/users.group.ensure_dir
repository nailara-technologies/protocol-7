## [:< ##

# name  = users.group.ensure_dir
# param = <namespace> <group-name>
# descr = create a group record directory if it is absent

my ( $namespace, $group_name ) = @ARG;

return FALSE if not defined <[users.group.path]>->( $namespace, $group_name );

my $record_dir = <[base.path.resolve_keywords]>
    ->( sprintf( qw| [USERS_HOST]/groups/%s/%s |, $namespace, $group_name ) );

return TRUE if -d $record_dir;

<[file.make_path]>->(
    $record_dir, 0770, <system.amos-zenka-user>, <system.amos-zenka-user>
);

return -d $record_dir ? TRUE : FALSE;

