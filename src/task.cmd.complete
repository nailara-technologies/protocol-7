## [:< ##

# name  = task.cmd.complete
# param = <task_id> [result]
# descr = mark a claimed task as done with result

my ( $task_id, $result ) = ( '', '' );

## parse params
if ( defined $call->{'param'} and ref $call->{'param'} eq 'HASH' ) {
    $task_id = $call->{'param'}->{'id'}     // '';
    $result  = $call->{'param'}->{'result'} // '';
} else {
    my $args = $call->{'args'} // '';
    ## try to split on first whitespace
    if ( $args =~ m{^(\S+)\s+(.*)$}s ) {
        $task_id = $1;
        $result  = $2;
    } else {
        $task_id = $args;
    }
    ## decode b32 result if prefixed : preserves newlines across protocol ##
    if ( $result =~ s{^:B32:}{}i ) {
        my $decoded = <[base32.decode]>->($result);
        $result = Encode::decode( 'UTF-8', $decoded ) if defined $decoded;
    }
    ## multiline body takes precedence for result ##
    $result = $call->{'data'} if length( $call->{'data'} // '' );
}

$task_id = uc( substr( $task_id, 0, 7 ) );

return { 'mode' => 'false', 'data' => 'task id required' }
    unless length $task_id;

my $task = <task.queue>->{$task_id};

return {
    'mode' => 'false',
    'data' => sprintf( 'task %s not found', $task_id )
    }
    unless defined $task;

## claimed or in_progress tasks can be completed
if ( $task->{'status'} ne 'claimed' and $task->{'status'} ne 'in_progress' ) {
    return {
        'mode' => 'false',
        'data' => sprintf(
            'task %s is %s, not claimed',
            $task_id, $task->{'status'}
        )
    };
}

## update task
my $ntime_b32 = <[base.ntime.b32]>;

$task->{'status'}     = 'done';
$task->{'result'}     = $result;
$task->{'updated_at'} = $ntime_b32;

## move to history, then persist ##
<[task.persist.archive]>->($task_id);
<[task.persist.save]>;

## propagate completion upward in valued tree [ only if linked to a node ] ##
if ( length( $task->{'node_id'} // '' ) ) {
    <[valued.tree.record_outcome]>
        ->( { 'node_id' => $task->{'node_id'}, 'outcome' => 'completed' } );
}

## fire deferred reply for any pending wait-done ##
my $wait_reply_id = delete <task.wait.pending>->{$task_id};
if ( defined $wait_reply_id ) {
    <[base.callback.cmd_reply]>->(
        $wait_reply_id, { 'mode' => 'size', 'data' => $result }
    );
}

<[base.logs]>->( 1, ':. task %s completed', $task_id );

return { 'mode' => 'true', 'data' => "completed $task_id" };

