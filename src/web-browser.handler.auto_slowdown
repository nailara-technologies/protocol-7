## [:< ##

# name = web-browser.handler.auto_slowdown

<web-browser.cfg.gpu_load_secs> //= 15;    # [ 1, 5, 15, 30 ]s

<[base.zenki.resolve_primary_sid]>->(
    'X-11',
    sub {
        my $sid = shift;
        return if not defined $sid;
        <[protocol-7.route-send]>->(
            {   'command'   => "$sid.gpu_load",
                'call_args' => { 'args' => <web-browser.cfg.gpu_load_secs> },
                'reply'     =>
                    { 'handler' => 'web-browser.handler.gpu_load_reply' }
            }
        );
    }
);

