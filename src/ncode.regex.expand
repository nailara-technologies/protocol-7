## [:< ##

# name  = ncode.regex.expand
# descr = add new patterns to the dynamic regex library

my $params = shift // {};

my $candidates = $params->{'candidates'} // [];
my $merge_mode = $params->{'merge_mode'} // qw| add |;

return { 'mode' => qw| false |, 'data' => 'candidates must be arrayref' }
    unless ref $candidates eq qw| ARRAY |;

## ensure pattern storage exists ##
<ncode.patterns> //= {};
my $patterns = <ncode.patterns>;

## config values ##
my $max_patterns = <ncode.cfg.max_patterns>         // 500;
my $threshold    = <ncode.cfg.confidence_threshold> // 0.70;

## result tracking ##
my @details;
my $added_count    = 0;
my $merged_count   = 0;
my $rejected_count = 0;

## handle merge modes ##
if ( $merge_mode eq qw| replace | ) {
    ## clear existing patterns ##
    <ncode.patterns> = {};
    $patterns = <ncode.patterns>;
}

## process each candidate ##
foreach my $candidate (@$candidates) {
    my $detail = <[ncode.regex.expand.util.process_candidate]>->(
        $candidate, $patterns, $max_patterns, $threshold
    );
    push @details, $detail;

    if ( $detail->{'status'} eq qw| added | ) {
        $added_count++;
    } elsif ( $detail->{'status'} eq qw| merged | ) {
        $merged_count++;
    } else {
        $rejected_count++;
    }
}

return {
    'mode' => qw| true |,
    'data' => {
        'added'    => $added_count,
        'merged'   => $merged_count,
        'rejected' => $rejected_count,
        'details'  => \@details
    }
};

