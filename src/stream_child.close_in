## [:< ##

# name  = stream_child.close_in
# descr = end of input : flush once, close the child's stdin
# param = handle

my $handle = shift;
return FALSE if not defined $handle or not defined $handle->{'in'};
<[stream_child.flush]>->($handle);
my $watcher = delete $handle->{'w_in'};
eval { $watcher->cancel } if ref $watcher;
CORE::close( $handle->{'in'} );
$handle->{'in'}      = undef;
$handle->{'pend_in'} = '';
return TRUE;

