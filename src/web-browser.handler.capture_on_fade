## [:< ##

# name  = web-browser.handler.capture_on_fade
# descr = fires on every write to <web-browser.slideshow.url_index> [ armed
#         by web-browser.cmd.start-capture-slideshow ]. DEPRECATED for new
#         code: start-capture-slideshow now arms the paged multi-position
#         capture loop instead. this handler is kept as a defensive fallback
#         for any pre-existing watcher; it is a no-op while paged capture is
#         armed to avoid duplicate/stale snapshots.

return unless defined <web-browser.capture.manifest_path>;
return if <web-browser.capture.paged.armed>;

my $view_index = <web-browser.overlay.index.fg> // 1;
my $view       = <web-browser.gtk_obj.view>->{$view_index};
return unless defined $view;

my $uri = $view->get_uri // '';
return unless length $uri;

my $snap_dir = <web-browser.capture.snapshot_dir>;
<web-browser.capture.counter>++;
my $short_id = sprintf( '%04d', <web-browser.capture.counter> );
my $out_path = sprintf( '%s/capture.%s.%s.png',
    $snap_dir, $short_id, <[chk-sum.elf.vax-BASE32]>->($uri) );

<web-browser.snapshot.pending_path>  = $out_path;
<web-browser.snapshot.pending_reply> = undef;      ## no caller to reply to ##

my $region = <web-browser.cfg.snapshot_region> // 'visible';

eval {
    $view->get_snapshot(
        $region,
        'WEBKIT_SNAPSHOT_OPTIONS_NONE',
        undef,    ## cancellable
        $code{'web-browser.handler.snapshot_result'},
        undef     ## user_data
    );
};

if ($EVAL_ERROR) {
    <[base.logs]>->(
        0, "capture_on_fade: snapshot request failed: %s",
        <[base.str.eval_error]>
    );
    return;
}

## manifest line written immediately -- the output path is already fully
## determined, no need to wait on the async save to complete before recording
## it
open( my $fh, '>>', <web-browser.capture.manifest_path> ) or do {
    <[base.logs]>->(
        0, "capture_on_fade: " . "cannot open manifest: %s", $OS_ERROR
    );
    return;
};
print {$fh} "$short_id\t$uri\t$out_path\n";
close($fh);

