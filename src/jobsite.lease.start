## [:< ##

# name  = jobsite.lease.start
# descr = start token renewal when both lease settings are configured

my $issuer = <jobsite.cfg.lease.issuer> // '';
my $user   = <jobsite.cfg.lease.user>   // '';
return TRUE if not length $issuer and not length $user;

if ( not length $issuer or $user !~ m|^[\w.+-]+$| ) {
    <[base.logs]>->( 0, 'jobsite.lease : incomplete lease configuration' );
    return FALSE;
}

<jobsite.lease.state>       //= {};
<jobsite.lease.retry_state> //= {};
<jobsite.lease.in_progress> = FALSE;
<jobsite.lease.warned> //= FALSE;
return <[jobsite.lease.schedule]>->( qw| retry |, TRUE );

