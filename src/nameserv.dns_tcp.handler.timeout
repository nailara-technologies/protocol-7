## [:< ##

# name  = nameserv.dns_tcp.handler.timeout
# descr = close an idle dns tcp connection

my $id = shift->w->data;

my $conns = <nameserv.dns_tcp.conns> // return;
my $conn  = $conns->{$id}            // return;

<[base.logs]>->(
    2,
    ': dns tcp connection idle timeout [ %s ]',
    $conn->{'peer'} // 'unknown'
);

<[nameserv.dns_tcp.close]>->($conn);

return;

