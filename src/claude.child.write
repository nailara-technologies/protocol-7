## [:< ##

# name   = claude.child.write
# descr  = send one stream-json line to the child [ non-blocking ]
# args   = hash ref [ the input message ]
# return = TRUE, or FALSE without a running child

my $message = shift;
my $child   = <claude.child>;
return FALSE if not defined $child or not defined $child->{'in'};
return <[stream_child.write]>->( $child, <[claude.wire.encode]>->($message) );

