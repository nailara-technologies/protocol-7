## [:< ##
# name  = plan-9.server
# descr = 9P protocol server for exporting amos-term buffers

# Server state
$data{'plan-9'}{'server'} = {
    'buffers'  => {},
    'clients'  => {},
    'next_qid' => 1,
    'port'     => undef,
    'listener' => undef,
};

## Start server ##
my ($options) = @ARG;
$options //= {};

my $port = $options->{port} // <plan-9.config.port> // 15640;
my $host = $options->{host} // '127.0.0.1';

if ( defined $data{'plan-9'}{'server'}{'listener'} ) {
    return {
        'mode' => 'true',
        'data' => "9P server already running on "
            . "port $data{'plan-9'}{'server'}{'port'}"
    };
}

$data{'plan-9'}{'server'}{'port'} = $port;

my $lsock = <[io.ip.tcp.input.open]>->( $host, $port );

if ( not defined $lsock ) {
    return {
        'mode' => 'false',
        'data' => "Failed to start 9P server on $host:$port"
    };
}

$data{'plan-9'}{'server'}{'listener'} = $lsock;

## nothing accepted connections on this listener before -- see         ##
## data/tasks/plan-9-server-event-loop-wiring.md for the full history. ##
## mirrors proxy.listen's registration of proxy.handler.accept.        ##
<[event.add_io]>->(
    {   fd      => $lsock,
        poll    => 'r',
        handler => 'plan-9.server.handler.accept',
        data    => $lsock,
        desc    => '9P server accept handler'
    }
);

<[base.logs]>->("9P server listening on $host:$port");

return {
    'mode' => 'true',
    'data' => "9P server started on $host:$port"
};

