# name  = base.log.console_minimum
# descr = raises console verbosity to at least [level], never lowers it
#          [ -vv stays 2 ] -- for console zenki whose command results
#          must show without -v, called after [init_modules] so the init
#          noise stays at the configured level
# param = [level] [ default 1 ]

my $level = shift // 1;
die "expected numerical verbosity level parameter" if $level !~ m|^\d+$|;

<system.zenka.verbosity.console> = $level
    if not defined <system.zenka.verbosity.console>
    or <system.zenka.verbosity.console> < $level;

