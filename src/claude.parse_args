## [:< ##

# name   = claude.parse_args
# descr  = key=value arguments of claude.start
# args   = text
# return = { pairs => { .. } } or { error }

my $text  = shift // '';
my %known = map { $ARG => 1 } qw| model resume |;
my %pairs;
foreach my $word ( grep {length} CORE::split m{\s+}, $text ) {
    my ( $key, $value ) = $word =~ m{\A([a-z]+)=(\S*)\z};
    return { 'error' => "'$word' : key=value expected [ model resume ]" }
        if not defined $key
        or not $known{$key};
    return { 'error' => "key '$key' given twice" } if exists $pairs{$key};
    $pairs{$key} = $value;
}
return { 'pairs' => \%pairs };

