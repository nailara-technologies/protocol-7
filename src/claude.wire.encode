## [:< ##

# name   = claude.wire.encode
# descr  = one stream-json input line [ external format ]
# args   = hash ref
# return = json octets with a newline

## stream-json is the external wire format of claude code : encoded here at ##
## the edge only, never stored. one line, utf-8 octets                      ##

my $data = shift;
state $json;
if ( not defined $json ) {
    require JSON::XS;
    $json = JSON::XS->new->utf8->canonical;
}
return $json->encode($data) . "\n";

