## [:< ##

# name  = network.interfaces.ip_addr_text
# descr = output of 'ip -o addr show' [ empty when ip is not installed ]

my $ip = <[file.which]>->(qw| ip |);
$ip = ( grep { -x $ARG } qw| /usr/sbin/ip /sbin/ip /usr/bin/ip /bin/ip | )[0]
    if not defined $ip or not length $ip;
return '' if not defined $ip;
open( my $fh, '-|', $ip, qw| -o addr show | ) or return '';
local $INPUT_RECORD_SEPARATOR;
my $text = readline($fh) // '';
close($fh);
return $text;

