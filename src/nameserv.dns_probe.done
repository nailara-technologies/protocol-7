## [:< ##

# name  = nameserv.dns_probe.done
# param = <query hash>
# descr = close one probe query, finish the probe after the last

my $q = shift // return FALSE;
return FALSE if $q->{'done'};
$q->{'done'} = TRUE;
$q->{'answered'} //= FALSE;
for my $name (qw| watcher timer |) {
    next if not ref $q->{$name};
    $q->{$name}->cancel
        if $q->{$name}->can('is_active')
        and $q->{$name}->is_active;
    delete $q->{$name};
}
close delete $q->{'sock'} if defined $q->{'sock'};

my $probe = $q->{'probe'} // return FALSE;
return TRUE if --$probe->{'open'} > 0 or $probe->{'starting'};
return <[nameserv.dns_probe.finish]>->($probe);

