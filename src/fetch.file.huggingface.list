## [:< ##

# name  = fetch.file.huggingface.list
# descr = list available GGUF quantizations for a HuggingFace repo
# param = { repo => 'user/repo-GGUF' }

my $call = shift;
my $args = $call->{'args'} // {};
$args = {} if ref $args ne qw| HASH |;

my $repo = $args->{'repo'} // '';

return { 'mode' => qw| false |, 'data' => 'repo parameter required' }
    if !length($repo);

my $reply_id = $call->{'reply_id'} // '';

## store pending request ##
<fetch.file.hf_pending> //= {};
my $req_id = <[base.gen_id]>->(<fetch.file.hf_pending>);
<fetch.file.hf_pending>->{$req_id} = {
    'reply_id' => $reply_id,
    'type'     => qw| list |,
    'repo'     => $repo,
};

## query HuggingFace API (no auth needed for public models)  blobs=true : ##
## siblings carry file sizes                                              ##
my $api_url
    = sprintf( 'https://huggingface.co/api/models/%s?blobs=true', $repo );

<[clients.https.get]>->(
    {   'url'     => $api_url,
        'timeout' => 30,
        'on_done' => qw| huggingface.handler.list_response |,
        'params'  => { 'req_id' => $req_id },
    }
);

<[base.logs]>->( 2, "[hf.list] querying repo: %s", $repo );

return { 'mode' => qw| deferred | };

