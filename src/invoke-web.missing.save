## [:< ##

# name   = invoke-web.missing.save
# descr  = persist <invoke-web.missing_at_render> [ state/missing-at-render ]
#          -- models a render failed on, with the failed item : survives a
#          zenka restart, read back in init_code

my $json = JSON::PP->new->canonical->pretty->encode(
    <invoke-web.missing_at_render> // {} );

return <[file.zenka_dir.write]>->( 'state/missing-at-render', \$json );

