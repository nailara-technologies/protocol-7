## [:< ##

# name  = site-yaml.cmd.import
# descr = queue search results for async detail fetching
#
# args format (single line, key=value pairs):
#   url=<search-url> handler=<reply-module> skip=<space-separated-ids>
#   [block_file=<path>] [full=1]
# legacy bare url is also accepted.
#
# The reply handler is restricted to a small allow-list to avoid routing
# fetched records to arbitrary or destructive subroutines.

my $args_str = $call->{'args'} // '';
$args_str =~ s{^\s+|\s+$}{}g;

## parse key=value pairs; values are non-whitespace ##
my %param = ( $args_str =~ m|(\w+)=([^\s]+)|g );

my $url = $param{'url'} // $param{'search_url'} // '';
if ( not length $url ) {
    ## legacy: bare url as the whole argument line ##
    $url = $args_str;
}
$url = <site-yaml.cfg.stepstone_search_url> // ''
    if not length $url;

return { 'mode' => 'false', 'data' => 'no url' }
    if not length $url;

my $full_mode = $param{'full'} // 0;

my $reply_handler = $param{'handler'} // $param{'reply_handler'} // '';
if ( length $reply_handler ) {
    my %allowed_handler = map { $ARG => 1 } qw| jobsite.job-upsert |;
    if ( not $allowed_handler{$reply_handler} ) {
        <[base.logs]>->(
            0, 'site-yaml.import: disallowed reply handler %s',
            $reply_handler
        );
        return { 'mode' => 'false', 'data' => 'disallowed reply handler' };
    }
} else {
    <[base.logs]>->(
        0,
        'site-yaml.import: no reply_handler '
            . 'set, fetched records will be dropped'
    );
}

my $skip_ids_str = $param{'skip'} // $param{'skip_ids'} // '';
my %skip;
if ( length $skip_ids_str ) {
    %skip = map { $ARG => 1 } split m|\s+|, $skip_ids_str;
}

## optional pre-fetch field-block file  [ generic: caller provides ##
## [<EPOCH>:]<FIELD>:<chksum> ]                                    ##
my $block_file = $param{'block_file'} // '';
my %block;
if ( length $block_file and -r $block_file ) {
    if ( open my $fh, '<', $block_file ) {
        while ( my $line = <$fh> ) {
            chomp $line;
            next if $line =~ m{^\s*$};
            my ( $field, $sum );
            if ( $line =~ m{^([A-Z2-7]+):(\w+):([A-Z2-7]+)$} ) {
                ( $field, $sum ) = ( lc($2), $3 );    ## epoch-prefixed ##
            } elsif ( $line =~ m{^(\w+):([A-Z2-7]+)$} ) {
                ( $field, $sum ) = ( lc($1), $2 );    ## legacy ##
            } else {
                next;
            }
            $block{"$field:$sum"} = 1;
        }
        close $fh;
    }
}

## drop stale queue entries that predate the generic fetch refactor
my $queue = <site-yaml.fetch_queue> // [];
if ( @{$queue} ) {
    my $stale = scalar grep { not length( $ARG->{'reply_handler'} // '' ) }
        @{$queue};
    if ( $stale == @{$queue} ) {
        <[base.logs]>->(
            1,
            'site-yaml.import: dropping %d stale fetch-queue entries',
            scalar @{$queue}
        );
        <site-yaml.fetch_queue> = [];
    }
}

## if queue already has items from a prior scan, keep fetching
my $queue_preload     = scalar @{ <site-yaml.fetch_queue> // [] };
my $allow_early_break = ( not $full_mode and not $queue_preload ) ? 1 : 0;

my $max_pages = <site-yaml.import_max_pages> // 1;
$max_pages = 1 if $max_pages < 1;
$max_pages = 5 if $max_pages > 5;    ## safety cap

my $delay_search = <site-yaml.import_delay_search> // 1.5;

my $import_id = <[base.gen_id]>->( <site-yaml.import_state> //= {} );

<site-yaml.import_state>->{$import_id} = {
    'reply_id'          => $call->{'reply_id'},
    'url'               => $url,
    'reply_handler'     => $reply_handler,
    'skip'              => \%skip,
    'block'             => \%block,
    'full_mode'         => $full_mode,
    'allow_early_break' => $allow_early_break,
    'max_pages'         => $max_pages,
    'delay_search'      => $delay_search,
    'page'              => 1,
    'queued_count'      => 0,
    'skip_count'        => 0,
    'err_count'         => 0,
};

<[site-yaml.import.fetch_page]>->($import_id);

return { 'mode' => qw| deferred | };

