## [:< ##

# name  = jobsite.index.rebuild
# descr = rebuild index.yaml from all job files in status directories

my $jobs_dir
    = catdir( <system.path.zenka-dirs.var_P7>, <system.zenka.name>, 'jobs' );
my $index_file = catfile( <system.path.zenka-dirs.var_P7>,
    <system.zenka.name>, 'index.yaml' );

my $index = {};

## epoch-bucketed [ terminal ] statuses scanned FIRST : an orphaned       ##
## blocked/deleted remnant must never win over a legitimate active record ##
## for the same id -- active statuses scanned second, win below           ##
for my $status (qw| blocked deleted |) {
    my $dir = "$jobs_dir/$status";
    next if not -d $dir;
    opendir my $dh, $dir or next;
    for my $epoch_dir ( grep { !/^\./ && -d "$dir/$_" } readdir($dh) ) {
        opendir my $edh, "$dir/$epoch_dir" or next;
        for my $file ( grep { /\.yaml$/ && !/^\./ } readdir($edh) ) {
            my $job_id = $file;
            $job_id =~ s/\.yaml$//;
            my $job = eval { YAML::XS::LoadFile("$dir/$epoch_dir/$file") };
            next if $@ or ref $job ne 'HASH';
            $index->{$job_id} = {
                'status' => $job->{'status'} // '',
                'score'  => $job->{'score'}  // '',
                'stage'  => $job->{'stage'}  // '',
            };
        }
        closedir $edh;
    }
    closedir $dh;
}

## active statuses scanned SECOND : wins on collision, see above ##
for my $status (
    qw| new assessed review apply applied interviewed rejected skipped |) {
    my $dir = "$jobs_dir/$status";
    next if not -d $dir;
    opendir my $dh, $dir or next;
    for my $file ( grep { /\.yaml$/ && !/^\./ } readdir($dh) ) {
        my $job_id = $file;
        $job_id =~ s/\.yaml$//;
        my $job = eval { YAML::XS::LoadFile("$dir/$file") };
        next if $@ or ref $job ne 'HASH';
        $index->{$job_id} = {
            'status' => $job->{'status'} // '',
            'score'  => $job->{'score'}  // '',
            'stage'  => $job->{'stage'}  // '',
        };
    }
    closedir $dh;
}

my $tmp_file = "$index_file.tmp";
eval { YAML::XS::DumpFile( $tmp_file, $index ) };
if ($@) {
    <[base.logs]>->( 0, 'jss.index.rebuild: dump error: %s', $@ );
    return FALSE;
}

if ( not rename( $tmp_file, $index_file ) ) {
    <[base.logs]>->( 0, 'jss.index.rebuild: rename failed: %s', $! );
    return FALSE;
}

<[base.logs]>->(
    1,
    'jss.index.rebuild: rebuilt index with %d entries',
    scalar keys %{$index}
);

return TRUE;

