## [:< ##

# name  = letsencr.child.dns.handler.txt_timeout
# descr = time out pending async txt queries

## timer handler : the event carries the whole query state at ->w->data ##

my $q = shift->w->data;

return if ref $q ne qw| HASH |;
return if not keys %{ $q->{'pending'} // {} };    ## finished already ##

## every server still pending gets a timeout result ##
for my $server ( keys %{ $q->{'pending'} } ) {
    my $sq = $q->{'pending'}->{$server};
    eval { $sq->{'watcher'}->cancel } if defined $sq->{'watcher'};
    eval { $sq->{'sock'}->close }     if defined $sq->{'sock'};
    $q->{'results'}->{$server} = {
        'ok'     => FALSE,
        'rcode'  => qw| TIMEOUT |,
        'values' => [],
    };
}
$q->{'pending'} = {};
delete $q->{'timer'};    ## this very timer : fired, non-repeating ##

$code{ $q->{'on_done'} }->(
    {   'name'    => $q->{'name'},
        'results' => $q->{'results'},
        'params'  => $q->{'params'},
    }
);

return;

