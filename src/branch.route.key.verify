# name  = branch.route.key.verify
# descr = verify key material for a hop
# param = { route_id, hop_id, pubkey }

my $params   = shift                 // {};
my $route_id = $params->{'route_id'} // '';
my $hop_id   = $params->{'hop_id'}   // '';
my $pubkey   = $params->{'pubkey'}   // '';

return { 'mode' => 'false', 'data' => 'route id required' }
    unless length $route_id;
return { 'mode' => 'false', 'data' => 'hop id required' }
    unless length $hop_id;
return { 'mode' => 'false', 'data' => 'pubkey required' }
    unless length $pubkey;

my $route = $data{'branch.routes'}{$route_id};
return { 'mode' => 'false', 'data' => 'route not found' }
    unless defined $route;

my $expected = $route->{'keys'}{$hop_id} // '';

if ( length $expected and $pubkey eq $expected ) {
    return { 'mode' => 'true', 'data' => 'verified' };
}

return { 'mode' => 'false', 'data' => 'mismatch' };

