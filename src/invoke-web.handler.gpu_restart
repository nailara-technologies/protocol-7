## [:< ##

# name  = invoke-web.handler.gpu_restart
# descr = start invoke.ai again after a cuda error once the old process is
#         gone [ it frees the gpu memory on exit ; 5s steps, 12x ]

my $event   = shift;
my $attempt = eval { $event->w->data->{'attempt'} } // 1;
my $recover = <invoke-web.gpu_recover>              // return;
my $old     = $recover->{'old_pid'};

if ( defined $old and <[invoke-web.is_alive]>->($old) ) {
    if ( $attempt >= 12 ) {
        <[base.logs]>->(
            0, 'gpu : old invoke.ai [pid:%d] still alive -- no restart', $old
        );
        delete <invoke-web.gpu_recover>;
        return;
    }
    <[event.add_timer]>->(
        {   'after'   => 5,
            'handler' => 'invoke-web.handler.gpu_restart',
            'data'    => { 'attempt' => $attempt + 1 },
        }
    );
    return;
}

my $result = <[invoke-web.cmd.start]>->( { 'args' => '' } );
<[base.logs]>->( 1, 'gpu : %s', $result->{'data'} =~ s|\n.*||sr )
    if ref $result;

