## [:< ##

# name  = transport.probe.timer
# descr = global timer: walk demoted transports and probe them

my $event    = shift;
my $demoted  = <transport.registry>->{'demoted'} // {};
my $now      = <[base.time]>->(4);
my $interval = <transport.probe_interval_state>->{'last'} // 0;

for my $dest ( keys %$demoted ) {
    my $exits = $demoted->{$dest};
    for my $exit ( keys %$exits ) {
        my $types = $exits->{$exit};
        for my $type ( keys %$types ) {
            my $demote_time = $types->{$type};

            ## only probe if enough time has passed since last probe ##
            next if $now - $demote_time < $interval;

            ## find the profile and transport entry ##
            my $profile_name = <[transport.profile.match]>
                ->( { 'session' => { 'destination' => $dest } } );
            my $profile = <[transport.profile.load]>->($profile_name);
            next unless defined $profile;

            my $entry;
            for my $t ( @{ $profile->{'transports'} // [] } ) {
                if (    ( $t->{'type'} // '' ) eq $type
                    and ( $t->{'endpoint'} // $dest ) eq $exit ) {
                    $entry = $t;
                    last;
                }
            }
            $entry //= { 'type' => $type, 'endpoint' => $exit };

            <[transport.quality.probe]>->( $dest, $type, $entry );
        }
    }
}

$event->w->stop if defined $event and defined $event->w;
<transport.probe_timer> = <[event.add_timer]>->(
    {   'after' => <[base.interval.next]>->(
            {   'type'  => qw| transport-probe |,
                'state' => <transport.probe_interval_state>,
            }
        ),
        'handler' => qw| transport.probe.timer |,
    }
);

return 1;

