## [:< ##

# name  = base.handler.deferred_compile
# descr = placeholder for deferred module compilation on first call
#
# install as $code{$name} compiled with '# line 1 "$name"' filename
# hint so base.caller can self-identify and load the actual source

my $sub_name = [<[base.caller]>]->[0];    ##  own name via filename hint  ##

## a stub is a CODE ref too : only its identity tells it from compiled     ##
## code. the loader marks the stub's refaddr in deferred_stub              ##
## [ swap_subs copies it to an alias ]. no mark + a compile status : real  ##
## code, a caller held a stale stub ref. a plain TRUE mark                 ##
## [ loader before the refaddr mark, src reloaded since ] or neither : the ##
## sub at the key now is the stub                                          ##
my $stub_mark   = $data{'code'}{$sub_name}{'deferred_stub'};
my $compiled_ok = ( $data{'code'}{$sub_name}{'status'} // '' )
    =~ m{^(?:no-error|warned)$};
my $stub_addr
    = ( defined $stub_mark and $stub_mark ne TRUE ) ? $stub_mark
    : ( not defined $stub_mark and $compiled_ok ) ? undef
    : ref $code{$sub_name} eq qw| CODE |
    ? Scalar::Util::refaddr( $code{$sub_name} )
    : undef;
my $is_compiled = sub {
    return FALSE if ref $code{$sub_name} ne qw| CODE |;
    return TRUE  if not defined $stub_addr;
    return Scalar::Util::refaddr( $code{$sub_name} ) != $stub_addr;
};

## a caller held a stale stub ref and real code already sits at the key : ##
## hand off, no recompile                                                 ##
goto &{ $code{$sub_name} } if $is_compiled->();

<[base.logs]>->( 2, '..: deferred compile : %s ..,', $sub_name );

##  bypass whitelist : deferred stubs are for non-whitelisted modules  ##
<[base.load_runtime_modules]>->($sub_name);

## self-heal swapped-namespace aliases : if $sub_name was moved by         ##
## swap_subs before this stub ever got compiled                            ##
## [ e.g. base.base32.* -> base32.* ], the short-name key still holds this ##
## very stub and would recompile from scratch on every future call -- copy ##
## the freshly compiled sub there too so it stops re-entering here         ##
if ( $is_compiled->() ) {
    delete $data{'code'}{$sub_name}{'deferred_stub'};    ## real code now ##
    my $moved_to = $data{'code'}{$sub_name}{'moved_to'};
    if ( defined $moved_to and $moved_to ne $sub_name ) {
        $code{$moved_to} = $code{$sub_name};
        ## the target key carries the stub flag too when swap_subs aliased ##
        ## rather than moved it -- clear it there as well, or a later swap ##
        ## keeps reading real compiled code as "just a stub"               ##
        delete $data{'code'}{$moved_to}{'deferred_stub'};
    }
}

goto &{ $code{$sub_name} }    ##  transparent hand-off on first call  ##
    if $is_compiled->();

##  self-healing : attempt recovery via dep-graph scan  ##
if ( length( <whitelist.miss.policy> // '' ) ) {
    <[base.handler.whitelist_miss]>->($sub_name);

    if ( $is_compiled->() ) {
        delete $data{'code'}{$sub_name}{'deferred_stub'};
        goto &{ $code{$sub_name} };
    }
}

##  install broken stub : prevents retry loop, clears itself on reload  ##
$data{'code'}{$sub_name}{'status'} = 'error';    ##
$code{$sub_name} = eval(                         ##
    "sub { if ( ( \$data{'code'}{'$sub_name'}{'status'} // '' )"       ##
        . " ne 'error' ) {"                                            ##
        . " goto &{ \$code{'$sub_name'} } }"                           ##
        . " \$code{'base.log'}->(0,"                                   ##
        . "'..: broken sub called [ $sub_name ] : compile failed')"    ##
        . " }"
);                                                                     ##

<[base.logs]>->( 0, '..: deferred compile failed [ %s ]', $sub_name );

