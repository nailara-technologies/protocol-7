## [:< ##

# name   = invoke-web.render.check_images
# descr  = result images of a finished render item [ by session ] through
#          the lightweight analysis : catches SILENT failures the graph
#          stats do not show [ e.g. vae fp16 NaN -> black image ]
# param  = session id
# return = { images => [ { name, flags, hsv, entropy } ], bad => [ reasons ] }
#          | undef [ no image found or no db ]

my $session = shift // return undef;

my $dbh   = <[invoke-web.queue.db]> // return undef;
my $names = $dbh->selectcol_arrayref(
    'SELECT image_name FROM images WHERE session_id = ? '
        . 'AND is_intermediate = 0 AND deleted_at IS NULL',
    undef, $session
) // [];
return undef if not @$names;

my $dir = sprintf '%s/outputs/images', <invoke-web.root> // '';
my %check = ( 'images' => [], 'bad' => [] );

foreach my $name (@$names) {
    my $analysis = <[image.analyze.file]>->("$dir/$name") // next;
    my @flags    = sort grep { $ARG ne 'tiny_file' } keys $analysis->{'flags'}->%*;
    push $check{'images'}->@*, {
        'name'    => $name,
        'flags'   => \@flags,
        'hsv'     => $analysis->{'hsv'},
        'entropy' => $analysis->{'luma'}->{'entropy'},
        'tile1'   => $analysis->{'tiles'}->{1}->[0],
    };
    ## black \ flat = nothing usable was decoded ##
    push $check{'bad'}->@*, sprintf( '%s [ %s ]', $name, join ', ', @flags )
        if grep { m{^(?:black|flat)$} } @flags;
}

return \%check;

