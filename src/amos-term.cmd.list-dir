## [:< ##
# name  = amos-term.cmd.list-dir
# descr = List a directory over 9P (plan-9.client)

my $args = $call->{'args'} // '';
my ( $name, $path ) = split m|\s+|, $args, 2;

if ( not length( $name // '' ) or not length( $path // '' ) ) {
    return {
        'mode' => 'false',
        'data' => 'usage: list-dir <connection-name> <path>'
    };
}

my $result = <[plan-9.client.list-dir]>->( $name, $path );
return $result if $result->{'mode'} eq 'false';

return {
    'mode' => 'size',
    'data' => join( "\n", @{ $result->{'data'} } ) . "\n"
};

