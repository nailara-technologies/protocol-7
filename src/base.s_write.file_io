## [:< ##

# name = base.s_write.file_io
# descr = utf8 safe IO::AIO write for file handles [ with optional fh_offset ]
# note = use base.s_write for socket and pipe writes [ non-blocking path ]

my $write_fh         = $ARG[0];
my $write_string_ref = $ARG[1];
my $write_len        = $ARG[2];
my $str_offset       = $ARG[3] // 0;
my $fh_offset        = $ARG[4];

if ( not defined $write_fh ) {
    warn 'write_fh param not defined <{C1}>';
    return undef;
} elsif ( not defined $write_string_ref ) {
    warn 'write_string param not defined <{C1}>';
    return undef;
} elsif ( not length ref $write_string_ref ) {
    $write_string_ref = \$ARG[1];    ## scalar reference to argument ##
}

## utf8 safety : encode in-place before computing byte count ##
if ( utf8::is_utf8( $write_string_ref->$* ) ) {
    utf8::encode( $write_string_ref->$* )
        if $write_string_ref->$* =~ m|[^\p{ASCII}]|;
    utf8::downgrade( $write_string_ref->$*, 1 );    ## strip internal flag ##
}

$write_len //= bytes::length( $write_string_ref->$* );

my $size_written = undef;    ##  until write attempt  ##

IO::AIO::aio_write( $write_fh, $fh_offset, $write_len, $write_string_ref->$*,
    $str_offset, sub { $size_written = $ARG[0] } );

## blocking until write request has been completed  [ $@ cleared : a     ##
## request without a callback, the C25519 loaders' aio_mlock, makes poll ##
## die with any $@ still set from an earlier failed eval ]               ##
{
    local $EVAL_ERROR;
    while ( not defined $size_written ) { IO::AIO::poll() }
}

return $size_written;    ## [ returns -1 on error ] ##

