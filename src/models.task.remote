## [:< ##

# name  = models.task.remote
# descr = TRUE when tasks come from a remote task zenka
# note  = TRUE when tasks come from a task zenka other than the local one
# notes = remote mode : peek before claim [ models.task.dispatch-id ], the
#         notice stream + fallback poll [ models.task.startup ]

my $task_zenka = <models.cfg.task_zenka> // qw| task |;
$task_zenka =~ s{^\s+|\s+$}{}g;

return ( length $task_zenka and $task_zenka ne qw| task | ) ? TRUE : FALSE;

