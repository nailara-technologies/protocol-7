## [:< ##

# name  = models.task.remote
# descr = TRUE when any listed task zenka is remote
# note  = TRUE when the task zenka list holds more than the local 'task'
# notes = with a single external name this behaves exactly as before.
#         remote mode per source zenka : peek before claim
#         [ models.task.dispatch-id ], a notice stream + fallback poll
#         for every listed remote zenka [ models.task.startup ]

my @zenki = <[models.task.zenki]>;
return ( grep { $ARG ne qw| task | } @zenki ) ? TRUE : FALSE;

