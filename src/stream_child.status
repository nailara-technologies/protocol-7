## [:< ##

# name   = stream_child.status
# descr  = state of one child, or of every running one
# param  = handle | undef
# return = hash ref, or a list ref of them

my $handle = shift;
my $one    = sub {
    my $h = shift;
    return {
        'id'    => $h->{'id'},
        'pid'   => $h->{'pid'},
        'state' => $h->{'gone'} ? qw| gone |
        : $h->{'stopping'} ? qw| stopping |
        : qw| running |,
        'exit'    => $h->{'exit'},
        'signal'  => $h->{'signal'},
        'pend_in' => length( $h->{'pend_in'} // '' ),
        'started' => $h->{'started'},
        'group'   => $h->{'group'},
    };
};
return $one->($handle) if defined $handle;
return [
    map  { $one->($ARG) }
    sort { $a->{'id'} <=> $b->{'id'} }
        values %{ <stream_child.handles> // {} }
];

