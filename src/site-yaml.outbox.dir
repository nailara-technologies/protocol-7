## [:< ##

# name  = site-yaml.outbox.dir
# descr = return this zenka's fetched-jobs outbox dir [ created mode 0750 ]

my $outbox_dir = <[file.zenka_dir.data_path]> . '/outbox';

if ( not -d $outbox_dir and not mkdir $outbox_dir, 0750 ) {
    <[base.logs]>->(
        0,           'site-yaml.outbox: cannot create %s [ %s ]',
        $outbox_dir, $!
    );
    return undef;
}

return $outbox_dir;

