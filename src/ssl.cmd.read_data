## [:< ##

# name = ssl.cmd.read_data

my ( $id, $com_id, $name, $mode, $count ) = @_;
if ( -S $data{'link'}{$name}{'handle'} ) {
    if ( $mode eq qw| bytes | ) {
        if (<[base.s_read]>->(
                $data{'link'}{$name}{'handle'},
                my \$buffer, $count
            )
        ) {
            <[base.logs]>->( 0, 'length : %d', length($buffer) );
            <[base.net.send_to_socket]>->( $buffer, $com_id );
            <[base.log]>->( 1, 'success - wrote' );
            $data{'link'}{$name}{'handle'}->flush();
            <[base.log]>->( 1, 'success - flushed' );
        } else {
            $data{'link'}{$name}{'status'} = qw| closed |;
            <[base.logs]>->( 0, "link '%s' terminated", $name );
            return {
                mode => qw| false |,
                sprintf( 'link [%s] terminated', $name )
            };
        }
    }
} else {
    <[base.logs]>
        ->( 0, "[%d] read_data : not a valid link '%s'", $id, $name );
    return {
        mode => qw| false |,
        sprintf( 'link [ %s ] not valid', $name )
    };
}

