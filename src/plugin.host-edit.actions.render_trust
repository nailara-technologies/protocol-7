## [:< ##

# name  = plugin.host-edit.actions.render_trust
# descr = 'trust' \ 'owner trust' rows, recomputed on every render
# param = $editor_state, $field

## user-edit's live-render pattern
## [ address-cluster.resolve_state reads the current value on every render ] :
## host-edit.source.value_get computes the trust columns ONCE, when the record
## loads, so a pin written by add host or a newly typed owner did not show
## until the form was reopened [ found live, pri and atom ].  recomputed here
## from the saved record with the form's current values over it
## [ host-edit.flow.form_values ] -- every flow step repaints, so the pin
## shows the moment it is written

my ( $editor_state, $field ) = @ARG;

my $name   = <form.username>                                 // '';
my $record = <form.record>                                   // {};
my $saved  = ref $record eq qw| HASH | ? $record->{'fields'} // {} : {};

my %fields = (
    %{$saved}, %{ <[host-edit.flow.form_values]>->($editor_state) // {} }
);

my $columns = <[host-edit.trust.pin_state]>->( $name, \%fields );

return ref $columns eq qw| HASH | ? $columns->{$field} // '' : '';

