## [:< ##

# name    = base.cmd.whoami
# descr   = return current user name and session id

return {
    'mode' => qw| true |,
    'data' => <[base.session.user]>->( ${ $_[0] }{'session_id'} ) . ' '
        . ${ $_[0] }{'session_id'}
    }

