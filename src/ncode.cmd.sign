## [:< ##

# name  = ncode.cmd.sign
# descr = sign a single source file with sourcecode key

my $args = $call->{'args'} // '';

my @parts = split m|\s+|, $args;
my $file  = shift @parts // '';

return { 'mode' => qw| false |, 'data' => 'usage: sign <file-path>' }
    if not length $file;

my $protocol7_bin = <system.root_path> . '/bin/Protocol-7';

return {
    'mode' => qw| false |,
    'data' => 'bin/Protocol-7 not found or not executable'
    }
    if not -x $protocol7_bin;

my @cmd = ( $protocol7_bin, qw| sourcecode sign |, $file );

my $output = <[ncode.util.run_cmd]>->(@cmd);

if ( $output =~ m|success|i or $output =~ m|signature|i or $? == 0 ) {
    return { 'mode' => qw| true |, 'data' => $output };
} else {
    return { 'mode' => qw| false |, 'data' => $output };
}

