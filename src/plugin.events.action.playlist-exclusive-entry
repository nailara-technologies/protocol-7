# name  = plugin.events.action.playlist-exclusive-entry
# descr = playlist entry exclusive for the span of the event

return {
    'name'     => qw| playlist-exclusive-entry |,
    'kind'     => qw| action |,
    'describe' => 'playlist entry exclusive for the span of the event',
    'run'      => sub {
        my $fire        = shift;
        my $ev_type     = $fire->{'ev_type'};
        my $action      = $fire->{'action'};
        my $action_type = $action->{'type'};

        my $b32id = $action->{'b32id'};    # EXCLUSIVE event
        die "'b32id' parameter is missing from '$action_type' setup"
            if not defined $b32id;
        <events.stack.exclusive>->{$b32id} //= 0;
        if ( $ev_type eq qw| start | ) {
            <events.stack.exclusive>->{$b32id}++;
        } elsif ( $ev_type eq qw| end | ) {
            <events.stack.exclusive>->{$b32id}--;
            delete <events.stack.exclusive>->{$b32id}
                if !<events.stack.exclusive>->{$b32id};
        }

        <[protocol-7.command.send.local]>
            ->( { 'command' => qw| cube.content.update | } );
        return TRUE;
    }
};

