## [:< ##

# name  = format.json.init_code
# descr = initialize JSON handling for shared use across zenki

<[base.perlmod.autoload]>->('JSON::XS');

<format.json.parser> = JSON::XS->new();
<format.json.parser>->convert_blessed(1);
<format.json.parser>->allow_nonref(1);
<format.json.parser>->canonical(1);
<format.json.parser>->relaxed(1);
<format.json.parser>->pretty(1);
## keep utf8 capable for logging and standard operations  only use utf8(0) in
## format.json.encode for octets mode output

return FALSE;

0;

