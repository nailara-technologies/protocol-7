# name  = tile.cmd.get-underscan
# descr = show underscan values for current setup

my @values;
map {
    push( @values, sprintf( '%s:%s', $1, <tile.setup.screen>->{$ARG} ) )
        if $ARG =~ m|^underscan\.(\w+)|
} reverse sort { $a cmp $b } keys <tile.setup.screen>->%*;

return { 'mode' => qw| true |, 'data' => join( ' ', @values ) }

