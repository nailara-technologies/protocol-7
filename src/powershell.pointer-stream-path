## [:< ##

# name  = powershell.pointer-stream-path
# descr = grant read access to caller's pubkey, return shm path

my $requester_b32r = shift;

return undef unless defined $requester_b32r and length $requester_b32r;

my $mount = <powershell.pointer.mount>;
if ( not defined $mount ) {
    <[base.log]>->( 1, 'pointer-stream-path : stream not running' );
    return undef;
}

<[base.perlmod.autoload]>->( 'Crypt::Misc', qw| decode_b32r | );
<[base.perlmod.autoload]>->(
    'AMOS7::SHM', qw| header_read header_write sign_permission |
);

my $requester_raw = Crypt::Misc::decode_b32r($requester_b32r);
if ( not defined $requester_raw or not length $requester_raw ) {
    <[base.log]>->( 1, 'pointer-stream-path : invalid pubkey' );
    return undef;
}

my $header = AMOS7::SHM::header_read( $mount->{'mmap_ptr'} );

## recover a legacy or externally damaged header from the original template ##
## [ current header_write never truncates or partially writes on overflow ] ##
if ( not defined $header ) {
    my $tmpl = $mount->{'header'};
    if ( not defined $tmpl ) {
        <[base.log]>->(
            0,
            'pointer-stream-path : corrupted shm header and no '
                . 'template available [ restart powershell zenka to recover ]'
        );
        return undef;
    }
    <[base.log]>->(
        1, 'pointer-stream-path : repairing corrupted shm header'
    );
    $header = { %$tmpl, 'permissions' => [] };
    AMOS7::SHM::header_write( $mount->{'mmap_ptr'}, $header );
}

## skip if already granted to this session key
return $mount->{'path'}
    if grep { $_->{'to'} eq $requester_raw } @{ $header->{'permissions'} };

## expired grants are explicitly purged ; live grants are never dropped ##
my $now = time();
@{ $header->{'permissions'} }
    = grep { $_->{'expiry'} > $now } @{ $header->{'permissions'} };

if ( @{ $header->{'permissions'} } >= AMOS7::SHM::MAX_PERMISSIONS() ) {
    <[base.log]>->( 0, 'pointer-stream-path : permissions full' );
    return undef;
}

my $session_key = $keys{'C25519'}{'session:powershell'};
if (   not defined $session_key
    or not defined $session_key->{'private'}
    or not defined $session_key->{'public'} ) {
    <[base.log]>->( 0, 'pointer-stream-path : session key pair missing' );
    return undef;
}

my $perm = {
    'to'      => $requester_raw,
    'branch'  => '*',
    'rights'  => ['read'],
    'expiry'  => time() + 86400,    ## 24h grant
    'granted' => time(),
};
$perm->{'sig'} = AMOS7::SHM::sign_permission( $perm, $session_key, $header,
    $mount->{'sub_path'} // '' );
if ( not defined $perm->{'sig'} ) {
    <[base.log]>->( 0, 'pointer-stream-path : grant signing failed' );
    return undef;
}

push @{ $header->{'permissions'} }, $perm;
my $written = AMOS7::SHM::header_write( $mount->{'mmap_ptr'}, $header );
if ( not defined $written ) {
    pop @{ $header->{'permissions'} };
    <[base.log]>->( 0, 'pointer-stream-path : header overflow refused' );
    return undef;
}
$mount->{'header'} = $header;

<[base.logs]>->(
    1, 'pointer-stream-path : granted read to %s',
    $requester_b32r
);

return $mount->{'path'};

