## [:< ##

# name  = jobsite.cmd.progress
# descr = progress bar : assessed|total with cycle stats

my $reset      = "\e[0m";
my $blacklight = "\e[38;2;68;39;172m";
my $nailara_bg = "\e[48;2;9;5;42m";
my $TRUE_color = "\e[38;2;6;71;195m";

my %by_status;
for my $id ( keys %{ <jobsite.job.index> // {} } ) {
    my $st = <jobsite.job.index>->{$id} // '';
    $st =~ s{^(blocked|deleted):.*}{$1};
    $by_status{$st}++;
}

my $new_c    = $by_status{'new'}      // 0;
my $assessed = $by_status{'assessed'} // 0;
my $review   = $by_status{'review'}   // 0;
my $apply    = $by_status{'apply'}    // 0;
my $applied  = $by_status{'applied'}  // 0;
my $rejected = $by_status{'rejected'} // 0;
my $total    = scalar keys %{ <jobsite.job.index> // {} };
my $pending  = <jobsite.pending_count> // 0;

my $done      = $total - $new_c;
my $chars_max = 13;
my $filled    = $total > 0 ? int( $chars_max * $done / $total ) : 0;
my $bar       = ':' x $filled;

my $cycle = <jobsite.cycle> // qw| idle |;

my $right = do {
    if ( $cycle eq qw| assessing | and $pending > 0 ) {
        "assessing : $pending remaining";
    } elsif ( $cycle eq qw| scanning | ) {
        'scanning sites..';
    } else {
        "new : $new_c | rev : $review | assessed : $assessed | "
            . "apply : $apply | applied : $applied | rejected : $rejected";
    }
};

my $rw = length $right;

my $output_str
    = sprintf( "${blacklight}:::[${nailara_bg}${TRUE_color}%-13s"
        . "${reset}${blacklight}]::"
        . "[${nailara_bg}${TRUE_color} %-${rw}s "
        . "${reset}${blacklight}]:.${reset}",
    $bar, $right );

return {
    'mode' => qw| true |,
    'data' => $output_str,
};

