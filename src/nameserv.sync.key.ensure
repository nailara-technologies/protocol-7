## [:< ##

# name   = nameserv.sync.key.ensure
# descr  = load nameserv's sync key, or create it once
# return = TRUE [ key loaded ], FALSE [ logged why ]
#
# data/md/design/TIMESTAMP-DELTA-SYNC.md [ 'stage 3 decisions' ] : one
# long-lived key per host, 'nameserv-sync', in the backend user's key
# dir. created once and never regenerated -- every entry signed with it
# is relayed unchanged. called from cfg/zenki/nameserv/zenka.v7 AFTER
# [root.drop_privs] : the files are written as the backend user. the
# host-root delegation [ nameserv-sync.dlg ] is issued by v7-zenki ;
# after creating the key nameserv asks for it at once.

my $key_name = qw| nameserv-sync |;

my $key_path = <[crypt.C25519.key_path]>->($key_name);
if ( ref $key_path ne qw| HASH | or $key_path->{'holder'} ne qw| user | ) {
    <[base.logs]>->( 0, ': sync key : no user key path for %s', $key_name );
    return FALSE;
}

my $files = $key_path->{'key_filename'};
my $present
    = grep { -e $files->{$ARG} or -l $files->{$ARG} } qw| public private |;

if ( $present == 2 ) {
    if ( not exists $keys{'C25519'}->{$key_name} ) {
        <[crypt.C25519.load_keypair]>->( $key_name, undef, FALSE );
    }
    if ( not exists $keys{'C25519'}->{$key_name}->{'private'} ) {
        <[base.logs]>->( 0, ': sync key : %s not loaded', $key_name );
        return FALSE;
    }
    return TRUE;
}

## one file without the other : never replaced silently ##
if ($present) {
    <[base.logs]>->(
        0, ': sync key : %s incomplete [ public \ private ], not replaced',
        $key_name
    );
    return FALSE;
}

<[base.logs]>->( 1, ": sync key : creating '%s' [ random ] .,", $key_name );
<[crypt.C25519.gen_keys]>->($key_name);
if ( not exists $keys{'C25519'}->{$key_name}->{'private'} ) {
    <[base.logs]>->( 0, ': sync key : generating %s failed', $key_name );
    return FALSE;
}
if ( not <[crypt.C25519.write_keys]>->( $key_name, undef, FALSE ) ) {
    <[base.logs]>->( 0, ': sync key : writing %s failed', $key_name );
    return FALSE;
}

## host-root delegation now instead of at v7-zenki's next daily pass ##
<[protocol-7.route-send]>
    ->( { 'command' => qw| v7-zenki.delegation-issue | } );

return TRUE;

