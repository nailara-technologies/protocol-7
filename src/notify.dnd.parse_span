## [:< ##

# name   = notify.dnd.parse_span
# descr  = a span like 90s 13m 1h30m 2d into seconds
# return = seconds, undef when not a span [ or under one second ]

my $span    = shift // '';
my $seconds = 0;
my $pos     = 0;
my %unit = ( 's' => 1, 'm' => 60, 'h' => 3600, 'd' => 86400, 'w' => 604800 );
while ( $span =~ m{\G(\d+)([smhdw])?}gc ) {
    $seconds += $1 * $unit{ $2 // 's' };
    $pos = pos $span;
}
return undef if $pos != length $span or $seconds < 1;
return $seconds;

