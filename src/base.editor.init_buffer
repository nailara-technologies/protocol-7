## [:< ##

# name  = base.editor.init_buffer
# descr = initialize amos-term editor buffer

## [ stub ] create virtual editor buffer for pager integration ##

my ($args) = @ARG;

my $buffer_id = $args->{'buffer_id'};
my $virtual   = $args->{'virtual'}   // 0;
my $read_only = $args->{'read_only'} // 0;

## TODO: allocate editor buffer structure in amos-term ##

<editor.buffers>->{$buffer_id} = {
    'virtual'   => $virtual,
    'read_only' => $read_only,
    'pager_id'  => $args->{'pager_id'},
};

return $buffer_id;

