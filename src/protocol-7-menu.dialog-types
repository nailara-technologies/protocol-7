## [:< ##

# name  = protocol-7-menu.dialog-types
# descr = Dialog-type registry for protocol-7-menu plugin surfaces

## === dialog registry === ##
<protocol-7-menu.dialog-registry> //= {};

## === built-in dialog types === ##
<protocol-7-menu.dialog-types> = {
    qw| input-text | => {
        qw| desc | => qw| Single-line text input dialog |,
        qw| dir |  => qw| src/protocol-7-menu.dialog-input-text |,
    },
    qw| input-password | => {
        qw| desc | => qw| Masked password input dialog |,
        qw| dir |  => qw| src/protocol-7-menu.dialog-input-password |,
    },
    qw| input-choice | => {
        qw| desc | => qw| Pre-generated option selection dialog |,
        qw| dir |  => qw| src/protocol-7-menu.dialog-input-choice |,
    },
    qw| notification | => {
        qw| desc | => qw| Non-urgent notification surface |,
        qw| dir |  => qw| src/protocol-7-menu.dialog-notification |,
    }
};

<[base.logs]>->( 2, ":: protocol-7-menu dialog-type registry initialized" );

return 0;

