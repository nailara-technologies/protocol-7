## [:< ##

# name  = editor.control.list.window_info
# descr = the 'start-end of total' text a capped list field's window shows
# param = $start, $end, $total [ all 1-indexed / plain counts ]

## the scroll-position readout that replaces the trailing 'new entry' row's
## worth of space once a list has been windowed [ editor.control.list.expand ]
## -- factored out for the same reason editor.control.list.summary is :
## user-edit.form.build_frame has to measure this text's width to reserve the
## frame across a scroll step, and a second implementation of the same
## sentence would drift.
##
## bracket convention matches list.summary's ':..N.entries..:' -- the two read
## as one family, both marking "this row is a count/position, not a value"

my ( $start, $end, $total ) = @ARG;

return '' if not defined $total;

return sprintf( ':..%d-%d.of.%d..:', $start // 0, $end // 0, $total );

