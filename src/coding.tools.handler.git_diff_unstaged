# name  = coding.tools.handler.git_diff_unstaged
# descr = show unstaged git changes (git diff)
# param = $args hashref with optional git_args and max_lines

my $args = shift // {};

my $git_args  = $args->{'git_args'}  // '';
my $max_lines = $args->{'max_lines'} // 50;

$max_lines = int($max_lines);
$max_lines = 0    if $max_lines < 0;
$max_lines = 5000 if $max_lines > 5000;

my $result
    = <[coding.tools.handler.git_diff_output]>->( $git_args, 'unstaged' );

if ( !defined $result || !$result->{'mode'} ) {
    return $result->{'data'} // 'error: git diff unstaged failed';
}

my $output = $result->{'data'};

if ( $max_lines > 0 ) {
    my @lines = split m|\n|, $output;
    if ( scalar @lines > $max_lines ) {
        splice @lines, $max_lines;
        push @lines, "... (truncated to $max_lines lines)";
        $output = join "\n", @lines;
    }
}

return $output;

