## [:< ##

# name   = host-edit.flow.start
# descr  = start the add-host flow for a record [ data/md/design/HOST-SETUP ]
# param  = <record name> [ , \%form_values ]
# return = TRUE started, or ( undef, reason )
#
# connect [ ssh forward or a direct address ] -> probe -> pin -> [ when
# owner_key is set : fetch chain -> certify -> install ] -> done. the
# state lives in <host-edit.flow>->{<name>} ; every step runs from a timer
# [ host-edit.flow.step ] so the frame repaints in between ; progress goes
# to the form's status line. a passphrase-protected owner key stops at
# 'need_passphrase' until host-edit.flow.passphrase resumes it.

my $name        = shift // '';
my $form_values = shift // {};

return ( undef, 'record name not valid' )
    if not <[host-edit.record.name_valid]>->($name);

my $envelope = <[host-edit.record.read]>->($name);
return ( undef, "no host record '$name'" ) if ref $envelope ne qw| HASH |;

## the form's current values [ host-edit.flow.form_values ] win over the saved
## record : the flow runs on what the user sees.  a COPY -- the record itself
## is only changed by submitting the form
my $f       = { %{ $envelope->{'fields'} // {} } };
my $unsaved = FALSE;
my $as_text = sub {
    ref $ARG[0] eq qw| ARRAY | ? join( ' ', $ARG[0]->@* ) : $ARG[0] // '';
};
if ( ref $form_values eq qw| HASH | ) {
    foreach my $field ( keys %{$form_values} ) {
        $unsaved = TRUE
            if $as_text->( $form_values->{$field} ) ne
            $as_text->( $f->{$field} );
        $f->{$field} = $form_values->{$field};
    }
}

<host-edit.flow> //= {};
my $running = <host-edit.flow>->{$name};
return ( undef, "the flow for '$name' is already running" )
    if ref $running eq qw| HASH |
    and $running->{'step'} !~ m{\A(?:done|error)\z};

## the cube address : the record's first address [ host[:port], 42 ] ##
my ($address)
    = grep { defined and length }
    ( ref $f->{'addresses'} eq qw| ARRAY | ? $f->{'addresses'}->@* : () );

## no address, but the record is named after its host : dial the name [
## host-edit.record.name_is_host ] -- the status below says so
my $address_from_name = FALSE;
if ( not defined $address and <[host-edit.record.name_is_host]>->($name) ) {
    $address           = $name;
    $address_from_name = TRUE;
}
return ( undef, 'the record has no address' ) if not defined $address;
my ( $host, $cube_port ) = split m|:|, $address, 2;
$cube_port = 42 if not defined $cube_port or not length $cube_port;
return ( undef, "address '$address' not valid" )
    if $host !~ m|\A[A-Za-z0-9][A-Za-z0-9.-]{0,252}\z|
    or $cube_port !~ m|\A[0-9]{1,5}\z|;

my $ssh = $f->{'ssh'} // '';
my $ssh_port
    = ( $f->{'ssh_port'} // '' ) =~ m|\A[0-9]{1,5}\z| ? $f->{'ssh_port'} : 22;

<host-edit.flow>->{$name} = {
    qw| step |      => qw| connect |,
    qw| host |      => $host,
    qw| cube_port | => $cube_port,
    qw| ssh |       => $ssh,
    qw| ssh_port |  => $ssh_port,
    qw| owner_key | => $f->{'owner_key'} // '',
    qw| owner |     => $f->{'owner'}     // '',    ## the owner PIN name ##
    qw| started |   => time,
};

my $start_note = q{starting};
$start_note .= sprintf( q{ [ no address : dialling %s ]}, $name )
    if $address_from_name;
$start_note .= q{ [ unsaved form values used -- submit to keep them ]}
    if $unsaved;
<[host-edit.flow.status]>->( $name, $start_note );
<[host-edit.flow.schedule]>->( $name, 0 );
return TRUE;

