## [:< ##

# name  = jobsite.sync.push_chunk
# descr = send next chunk from queue, or finish cycle when all chunks sent

my $queue = <jobsite.sync.push_queue> // [];
my $item  = shift $queue->@*;

if ( not defined $item ) {
    ## all chunks done : advance per-url watermark  a url with zero chunk  ##
    ## failures this cycle advances fully to cycle start ntime, as before. ##
    ## a url that had ANY chunk fail does not advance at all this cycle :  ##
    ## chunks are not built in timestamp order, so a later [ newer ] chunk ##
    ## can succeed while an earlier [ older ] one fails -- capping to      ##
    ## "highest confirmed" would still silently skip that older failed job ##
    ## forever. leaving the watermark untouched instead re-sends the whole ##
    ## cycle's batch next round, which is safe because the receiving write ##
    ## is idempotent                                                       ##
    my $cycle_ntime = delete <jobsite.sync.push_cycle_ntime>     // '';
    my $urls        = delete <jobsite.sync.push_urls>            // [];
    my $had_failure = delete <jobsite.sync.push_had_failure>     // {};
    my $attempted   = delete <jobsite.sync.push_total_attempted> // 0;
    my $confirmed   = delete <jobsite.sync.push_total_confirmed> // 0;

    for my $url ( $urls->@* ) {
        if ( $had_failure->{$url} ) {
            <[base.logs]>->(
                1,
                'jss.sync: %s had failures this cycle, watermark '
                    . 'unchanged [ retrying whole batch next cycle ]',
                $url
            );
        } elsif ( length $cycle_ntime ) {
            <jobsite.sync.last_ntime>->{$url} = $cycle_ntime;
        }
    }
    <jobsite.sync.last_server_ntime> = $cycle_ntime if length $cycle_ntime;

    if ( $attempted and $attempted != $confirmed ) {
        <[base.logs]>->(
            1,
            'jss.sync: reconciliation mismatch [ attempted:%d '
                . 'confirmed:%d ] : %d job%s will retry next cycle',
            $attempted,
            $confirmed,
            $attempted - $confirmed,
            <[base.cnt_s]>->( $attempted - $confirmed )
        );
    }

    my $reverse = delete <jobsite.sync.push_reverse> // [];
    delete <jobsite.sync.push_queue>;
    delete <jobsite.sync.url_tokens>;
    <jobsite.sync.push_in_progress> = FALSE;
    <[jobsite.state.persist]>;
    my $log_level = scalar $reverse->@* ? 1 : 2;
    <[base.logs]>->(
        $log_level,
        'sync push complete [reverse:%d]',
        scalar $reverse->@*
    );
    <[jobsite.sync.apply_reverse]>->($reverse);

    ## if assessments completed while a push was running, the updated jobs ##
    ## were not included in that push; trigger a follow-up push now.       ##
    if ( delete <jobsite.sync.push_after_assess> ) {
        <[base.logs]>->(
            1, 'sync push complete, triggering follow-up after assessment'
        );
        <[jobsite.sync.push]>->( undef, FALSE );
    }
    return;
}

my $url   = $item->{'url'};
my $since = $item->{'since'} // '';
my $chunk = $item->{'chunk'};

## carry the local client prefs on every batch [ and ping ] body so each    ##
## receiving web can max-merge and hand them back : only last_export_at for ##
## now [ QLK ] -- the rest of the prefs fan-out belongs to 3MK              ##
my %prefs_out;
my $export_at = <[jobsite.client_prefs.read]>->{'last_export_at'} // '';
$prefs_out{'last_export_at'} = $export_at + 0
    if $export_at =~ m{^\d+(?:\.\d+)?$};

my $body = eval {
    JSON::XS::encode_json(
        {   'since' => $since,
            'jobs'  => $chunk,
            ( %prefs_out ? ( 'prefs' => \%prefs_out ) : () ),
        }
    );
} // '';

if ( not length $body ) {
    <[base.logs]>
        ->( 0, 'jss.sync.push_chunk: encode failed, skipping chunk' );
    <[jobsite.sync.push_chunk]>;
    return;
}

<jobsite.sync.push_total_attempted> += scalar $chunk->@*;

## signed shm content-hash headers [ large body streams to disk at the      ##
## receiving httpd instead of traversing call_args buffers ] : commitment   ##
## header '<ntime>:<bytes>:<lines>:<B32-BMW384>' signed with the zenka host ##
## key. when no signing key is loaded, fall back to the plain inline-body   ##
## request [ backwards compatible ]                                         ##
my $headers = {};
if ( exists $code{'crypt.C25519.sign_data'} ) {
    my $key_vars = <[crypt.C25519.key_vars]>;
    my $key_name = ref $key_vars ? $key_vars->{'key_name'} : undef;
    if (    defined $key_name
        and exists $keys{'C25519'}{$key_name}{'private'}
        and exists $keys{'C25519'}{$key_name}{'public'} ) {
        my $ntime    = <[base.ntime.b32]>->( 3, TRUE );
        my $b32_hash = <[chk-sum.bmw.strsum]>->( $body, 384 );
        my $bytes    = length($body);
        my $lines    = () = $body =~ m|\n|g;
        my $header   = join ':', $ntime, $bytes, $lines, $b32_hash;
        my $sig_bin  = <[crypt.C25519.sign_data]>->( \$header );
        if ( defined $sig_bin ) {
            $headers = {
                'X-P7-Content-Hash' => $header,
                'X-P7-Signature'    => encode_b32r($sig_bin),
                'X-P7-Host-Key'     =>
                    encode_b32r( $keys{'C25519'}{$key_name}{'public'} ),
            };
            ##  optional parent key cert [ cross-host trust topology ]  ##
            $headers->{'X-P7-Key-Cert'} = <jobsite.cfg.sync_key_cert>
                if length( <jobsite.cfg.sync_key_cert> // '' );
            <[base.logs]>->(
                2,
                'jss.sync.push_chunk: signed shm '
                    . 'headers [ %d bytes, %d lines ]',
                $bytes,
                $lines
            );
        }
    }
}

## bearer token [ resolved once per cycle in jobsite.sync.push : host ##
## config jobsite.cfg.sync_token / jobsite.cfg.sync_tokens ]          ##
my $auth_token = <jobsite.sync.url_tokens>->{$url} // '';
$headers->{'Authorization'} = "Bearer $auth_token" if length $auth_token;

<[clients.http.post]>->(
    {   'url'     => $url,
        'body'    => $body,
        'headers' => $headers,
        'timeout' => 32,
        'on_done' => qw| jobsite.handler.sync-response |,
        'params'  => {
            'url'        => $url,
            'chunk_size' => scalar $chunk->@*,
        },
    }
);

