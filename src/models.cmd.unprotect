## [:< ##

# name  = models.cmd.unprotect
# param = <checksum>
# descr = remove a checksum from the delete-protection list
# note  = see models.cmd.protect

my $checksum = $call->{'args'} // '';
$checksum =~ s|^\s+||;
$checksum =~ s|\s+$||;

unless ( length $checksum ) {
    return {
        'mode' => qw| size |,
        'data' => "Usage: unprotect <checksum>\n"
    };
}

<models.protected_checksums> //= <[models.trash.load_protected]>;

unless ( delete <models.protected_checksums>->{$checksum} ) {
    return {
        'mode' => qw| size |,
        'data' => "$checksum was not protected\n"
    };
}

unless (<[models.trash.save_protected]>) {
    return {
        'mode' => qw| size |,
        'data' => "error: failed to persist protect-list\n"
    };
}

<[base.logs]>->(
    1, '[unprotect] %s is no ' . 'longer delete-protected', $checksum
);

return {
    'mode' => qw| size |,
    'data' => "unprotected: $checksum\n"
};

