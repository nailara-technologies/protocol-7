## [:< ##

# name  = power.cmd.get_states
# descr = return power socket states
# param = <device_id>

<power.cfg.devices> //= {};
my $device_id = $call->{'args'} // '';

return { 'mode' => qw| false |, 'data' => 'numerical device id expected' }
    if !length($device_id)
    or $device_id !~ m|\d+|;

return {
    'mode' => qw| false |,
    'data' => "device '$device_id' does not exist"
    }
    if not exists <power.cfg.devices>->{$device_id};

my ( $dev, $driver ) = <[power.dev_obj]>->($device_id);

## dev_obj logged the reason once : a missing driver module, no connection ##
if ( not defined $dev ) {
    <[base.log]>->( 0, "connection to device $device_id failed" );
    return {
        'mode' => qw| false |,
        'data' => <power.open_error>->{$device_id} // 'connection failed'
    };
}

my $states = $code{"power.plugin.$driver.get"}->($dev);

return { 'mode' => qw| false |, 'data' => 'unable to read states' }
    if ref $states ne qw| ARRAY |;

return { 'mode' => qw| TRUE |, 'data' => join( ' ', $states->@* ) }

