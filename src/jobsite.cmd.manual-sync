## [:< ##

# name  = jobsite.cmd.manual-sync
# descr = perform a full sync push to the web cache

if (<jobsite.sync.push_in_progress>) {
    return { 'mode' => 'false', 'data' => 'sync already in progress' };
}

my $jobs  = <[jobsite.job.load_all]>;
my $count = scalar keys %{ $jobs // {} };

<[base.logs]>->( 1, 'jss.manual-sync: forcing full push of %d jobs', $count );

<[jobsite.sync.push]>->( undef, TRUE );    ## force sync ##

return {
    'mode' => 'true',
    'data' => "manual sync triggered [ $count jobs ]"
};

