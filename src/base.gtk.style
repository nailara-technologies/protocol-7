## [:< ##

# name  = base.gtk.style
# param = <screen> [ { color => { role => hex }, font_family, font_size, css } ]
# descr = shared protocol-7 gtk3 style [ greeter, lock, menu dialogs ]

## one palette for every protocol-7 gtk window, installed at application ##
## priority : the default theme never shows through                      ##
## [ grey buttons, gradients, shadows, bright selections ]               ##

my ( $screen, $opt ) = @ARG;
return undef if not defined $screen;
$opt //= {};

<[base.perlmod.autoload]>->('AMOS7::Desktop::Theme');
my $theme = AMOS7::Desktop::Theme::read(
    {   'root'    => <system.root_path>,
        'zenka'   => <system.zenka.name>,
        'etc_dir' => ( <system.path.zenka-dirs> // {} )->{'etc_P7'}
            // '/etc/protocol-7',
        'zenka_user' => <system.amos-zenka-user> // 'protocol-7',
    }
);

my %role_token = (
    'background' => 'color.background',
    'panel'      => 'color.background_mid',
    'text'       => 'color.foreground',
    'hover'      => 'color.foreground_bright',
    'focus'      => 'color.background_focus',
    'border'     => 'color.foreground',
    'muted'      => 'color.foreground_dim',
    'selection'  => 'color.selection',
);
foreach my $role ( keys %{ $opt->{'color'} // {} } ) {
    my $hex = $opt->{'color'}->{$role} // next;
    next if $hex !~ m|^#?([0-9a-fA-F]{6})$|;
    $theme->{ $role_token{$role} } = ${^CAPTURE}[0]
        if defined $role_token{$role};
}

my $css_text = AMOS7::Desktop::Theme::gtk_css( $theme, $opt );
$css_text .= $opt->{'css'} if defined $opt->{'css'};

my $provider = Gtk3::CssProvider->new();
$provider->load_from_data($css_text);
Gtk3::StyleContext::add_provider_for_screen( $screen, $provider, 600 );
return $provider;

