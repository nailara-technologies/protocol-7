## [:< ##

# name  = plugin.events.source.timetable
# descr = events source plugin : clock times for static and bucket entries

## registration [ no arguments ] : name, kind, describe, keys              ##
## [ the timetable keys this source owns ], arm \ disarm [ each gets an    ##
## array ref of entry references : numeric static ids or <owner>/<id> ].   ##
## static entries keep the calculated unix table ; bucket times are stored ##

return {
    'name'     => qw| timetable |,
    'kind'     => qw| source |,
    'describe' => 'clock times : at, or start and end [ jitter, duration ]',
    'keys'     => [qw| at start end duration jitter |],
    'arm'      => sub {
        my $ev_ids = shift // [];
        my @static = grep { $_ !~ m{/} } @{$ev_ids};
        if ( @static or not @{$ev_ids} ) {
            <[events.calc_unix_table]>;
            <[events.set_up_timers]>;
        }
        foreach my $key ( grep { $_ =~ m{/} } @{$ev_ids} ) {
            my ( $owner, $id ) = split m{/}, $key, 2;
            my $e = <events.buckets>->{$owner}->{'entries'}{$id} // next;
            for my $timer ( values %{ <events.timers>->{$key} // {} } ) {
                $timer->cancel if defined $timer and $timer->is_active;
            }
            delete <events.timers>->{$key};
            next if ( $e->{'state'} // '' ) ne qw| waiting | or $e->{'met'};
            next if not defined $e->{'at'};
            <events.timers>->{$key}{'at'} = <[event.add_timer]>->(
                {   'at'      => $e->{'at'},
                    'handler' => qw| events.handler.event_triggered |,
                    'data'    => {
                        'type' => qw| at |,
                        'at'   => $e->{'at'},
                        'id'   => $key
                    }
                }
            );
        }
        return TRUE;
    },
    'disarm' => sub {
        my $ev_ids = shift // [];
        foreach my $ev_id ( @{$ev_ids} ) {
            for my $timer ( values %{ <events.timers>->{$ev_id} // {} } ) {
                $timer->cancel if defined $timer and $timer->is_active;
            }
            delete <events.timers>->{$ev_id};
            delete <events.unix.timetable>->{$ev_id};
        }
        return TRUE;
    }
};

