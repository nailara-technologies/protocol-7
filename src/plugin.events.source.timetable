## [:< ##

# name  = plugin.events.source.timetable
# descr = events source plugin : clock times [ at, start \ end ] -- today's timetable

## registration [ no arguments ] : name, kind, describe, keys               ##
## [ the timetable keys this source owns ], arm \ disarm [ each gets an     ##
## array ref of entry ids : the unix table is calculated for every entry at ##
## once, so a source is armed as a batch ]                                  ##

return {
    'name'     => qw| timetable |,
    'kind'     => qw| source |,
    'describe' => 'clock times : at, or start and end [ jitter, duration ]',
    'keys'     => [qw| at start end duration jitter |],
    'arm'      => sub {
        my $ev_ids = shift // [];
        <[events.calc_unix_table]>;
        <[events.set_up_timers]>;
        return TRUE;
    },
    'disarm' => sub {
        my $ev_ids = shift // [];
        foreach my $ev_id ( @{$ev_ids} ) {
            for my $timer ( values %{ <events.timers>->{$ev_id} // {} } ) {
                $timer->cancel if defined $timer and $timer->is_active;
            }
            delete <events.timers>->{$ev_id};
            delete <events.unix.timetable>->{$ev_id};
        }
        return TRUE;
    }
};

