## [:< ##

# name   = nameserv.sync.accept
# descr  = check one received sync entry against the accept rules
# param  = <body b32>, <sig b32>, <writer key id>
# return = entry hash [ incl. body sig writer ] or ( undef, reason )
#
# data/md/design/TIMESTAMP-DELTA-SYNC.md [ 'accepting an entry' ], each a
# hard reject : the body parses ; the writer's chain was verified
# [ WRITER line ] and has not expired ; the signature verifies ; the
# writer's grant covers zone + name [ tombstones too ] ; ts not too far
# ahead [ sync.max_future ] nor older than the tombstone window
# [ sync.max_age ]. newest-wins per identity is nameserv.sync.apply.entry.
# a zone: grant item with a '*' label covers the acme challenge subzones
# below a domain [ zone:acme.*.example.org : exactly acme.<one or more
# labels>.example.org ] -- nameserv.sync.grants.zone_match. zones refused
# for lack of a grant are remembered [ nameserv.sync.refused_zones ] :
# a grant change re-pulls them once [ nameserv.sync.grants.renew ].

my $body_b32 = shift // '';
my $sig_b32  = shift // '';
my $writer   = shift // '';

my $refuse = sub { return wantarray ? ( undef, shift ) : undef };

my $entry = <[nameserv.sync.entry.decode]>->($body_b32)
    // return $refuse->('entry body not valid');

my $info = <nameserv.sync.writers>->{$writer};
if ( ref $info ne qw| HASH | or $info->{'not_after'} <= time ) {
    ## remembered : a grant change may verify this writer later ##
    my $refused_zone = lc $entry->{'zone'};
    $refused_zone =~ s{\.+$}{};
    <nameserv.sync.refused_zones>->{$refused_zone} = TRUE;
    return $refuse->('writer not verified');
}

my $body = <[base32.decode]>->($body_b32);
my $sig  = <[base32.decode]>->($sig_b32);
return $refuse->('signature not valid')
    if not defined $sig
    or length $sig != 64
    or not Crypt::Ed25519::verify( $body, $info->{'pub'}, $sig );

## grants : receiver config, keyed by the writer's host-root id ##
my $zone = lc $entry->{'zone'};
my $name = lc $entry->{'name'};
$zone =~ s{\.+$}{};
$name =~ s{\.+$}{};
my $grant = ( <nameserv.cfg.sync.writer> // {} )->{ $info->{'anchor'} } // '';
my $allowed = FALSE;
foreach my $item ( split m|\s+|, $grant ) {
    if ( $item =~ m|\Azone:(.+)\z| ) {
        my $granted = $1;
        next if not <[nameserv.sync.grants.zone_match]>->( $zone, $granted );
        ## a pattern covers the entry's own zone : the name must be the ##
        ## zone itself or below it, never outside the matched zone      ##
        my $base = $zone;
        if ( index( lc $granted, '*' ) < 0 ) {
            $base = lc $granted;
            $base =~ s{\.+$}{};
        }
        $allowed = TRUE if $name eq $base or $name =~ m|\.\Q$base\E\z|;
    } elsif ( $item =~ m|\Aname:(.+)\z| ) {
        $allowed = TRUE
            if $name eq lc $1
            and uc $entry->{'type'} eq qw| TXT |
            and $name =~ m|\.\Q$zone\E\z|;
    }
    last if $allowed;
}
if ( not $allowed ) {
    ## remembered : a grant change re-pulls this zone once ##
    ## [ nameserv.sync.grants.renew ]                      ##
    <nameserv.sync.refused_zones>->{$zone} = TRUE;
    return $refuse->("no grant for $name in $zone");
}

## ts window : not ahead of local time beyond the skew, not older than the ##
## tombstone window [ replay of long-deleted records ]                     ##
my $age = <[base.ntime.delta_seconds]>->( $entry->{'ts'} )
    // return $refuse->('ts not valid');
my $max_future = <nameserv.cfg.sync.max_future> // 300;
my $max_age    = <nameserv.cfg.sync.max_age>
    // <nameserv.cfg.sync.tombstone_keep> // 1123200;
return $refuse->('ts too far ahead') if $age < -$max_future;
return $refuse->('ts too old')       if $age > $max_age;

$entry->{'body'}   = $body_b32;
$entry->{'sig'}    = $sig_b32;
$entry->{'writer'} = $writer;

return $entry;

#,,.,,...,,..,..,,,,,,,..,.,,,.,,,,,,,,.,,,,,,..,,...,...,.,,,,,.,,,.,,..,,..,
