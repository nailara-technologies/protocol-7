## [:< ##

# name = tree.route.page.decode_56
# descr = decode 8-byte routing word into 8 groups of 7 bits

my $input = shift // '';

return undef if length($input) != 8;

my $bits_64 = unpack qw| B* |, $input;

my @groups;
my @leading;

for my $i ( 0 .. 7 ) {
    my $byte_bits = substr( $bits_64, $i * 8, 8 );
    push @leading, substr( $byte_bits, 0, 1 );
    push @groups,  substr( $byte_bits, 1, 7 );
}

return { groups => \@groups, leading => \@leading };

