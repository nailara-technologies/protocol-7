## [:< ##

# name  = branch.detach
# descr = detach node from parent; node identity and subtree preserved
# param = node_id [ string or { id => ... } ]
#
# detached node retains checksum identity and all children
# can be reattached anywhere with branch.attach

my $params = shift // '';
my $node_id
    = ref $params eq 'HASH'
    ? $params->{'id'} // ''
    : $params;

return { 'mode' => 'false', 'data' => 'node id required' }
    unless length $node_id;
return { 'mode' => 'false', 'data' => 'node not found' }
    unless exists $data{'branch.nodes'}{$node_id};

my $node        = $data{'branch.nodes'}{$node_id};
my $prev_parent = $node->{'parent'};

return { 'mode' => 'false', 'data' => 'node has no parent' }
    unless defined $prev_parent;

my $prev_name = $node->{'name'};
delete $data{'branch.children'}{$prev_parent}{$prev_name};
$node->{'parent'} = undef;

<[base.logs]>->(
    2, 'branch.detach: %s from %s [%s]',
    $node_id, $prev_parent, $prev_name
);

return { 'mode' => 'true', 'data' => $node_id };

