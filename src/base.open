## [:< ##

# name  = base.open

my ( $type, $mode, @params ) = @ARG;

if ( not defined <io.type>->{$type} ) {
    <[base.logs]>->(
        0, "base.open: io type '%s' not defined [ module loaded ? ]", $type
    );
    return undef;
} elsif ( not defined <io.type>->{$type}{'handler'}{$mode} ) {
    <[base.logs]>->(
        0,     "base.open: unknown io mode '%s' for type '%s'",
        $mode, $type
    );
    return undef;
} elsif ( not defined $code{ <io.type>->{$type}{'handler'}{$mode}{'open'} }
    or
    ref $code{ <io.type>->{$type}{'handler'}{$mode}{'open'} ne qw| CODE | } )
{
    <[base.logs]>->(
        0,     "base.open: '%s'-handler for mode '%s' not defined",
        $type, $mode
    );
    return undef;
}

return $code{ <io.type>->{$type}{'handler'}{$mode}{'open'} }->(@params);

