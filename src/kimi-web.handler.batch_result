## [:< ##

# name  = kimi-web.handler.batch_result
# descr = collect results from parallel agent dispatch

my $data     = shift;
my $agent_id = <params.agent_id> // '';
my $batch_id = <params.batch_id> // '';
my $result   = $data->{'body'}   // '';
my $is_error = $data->{'ok'} ? 0 : 1;

my $batches = <kimi-web.agent.batches> // {};
my $batch   = $batches->{$batch_id};

## batch may have timed out ##
if ( not defined $batch ) {
    <[base.logs]>->(
        3,         ': batch %s result from %s after timeout/complete',
        $batch_id, $agent_id
    );
    return;
}

## store result ##
$batch->{'results'}{$agent_id} = {
    'content'  => $result,
    'is_error' => $is_error,
    'received' => <[base.ntime]>,
};
$batch->{'completed'}++;

## check if all done ##
if ( $batch->{'completed'} >= $batch->{'total'} ) {
    ## aggregate results ##
    my $aggregated = <[kimi-web.internal.aggregate_results]>->($batch);

    ## send reply if we have reply_id ##
    my $reply_id = $batch->{'reply_id'};
    if ( length $reply_id ) {
        <[base.callback.cmd_reply]>->(
            $reply_id,
            {   'mode' => qw| true |,
                'data' => $aggregated,
                'meta' => {
                    'batch_id'    => $batch_id,
                    'agents'      => $batch->{'total'},
                    'aggregation' => $batch->{'aggregation'},
                }
            }
        );
    }

    ## clean up batch ##
    delete $batches->{$batch_id};
    <kimi-web.agent.batches> = $batches;

    <[base.logs]>->(
        2, ': batch %s complete [ %d agents, %s agg ]',
        $batch_id, $batch->{'total'}, $batch->{'aggregation'}
    );
}

