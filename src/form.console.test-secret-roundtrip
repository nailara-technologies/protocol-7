## [:< ##

# name  = form.console.test-secret-roundtrip
# descr = proves the sessions.hold/release cross-zenka round trip with
#         synthetic values -- NOT the masked-field secret-entry widget
#         [ still unbuilt, separate problem ]. two cases run in
#         sequence: 32 random bytes, and a fixed pathological string
#         [ embedded NUL/newline/space/0xFF and a literal "OK " prefix,
#         probing the child's own line framing ] -- a value that would
#         pass by accident is not proof.

## same hybrid-console-command shape as form.console.show-form: the reply is
## asynchronous, so this command enters the zenka event loop itself rather
## than the start file doing it
##
my ($cube_sid) = keys <user.cube.session>->%*;

if ( not defined $cube_sid or not exists $data{'session'}{$cube_sid} ) {
    print "\n  << no cube session -- cannot reach the sessions zenka >>\n\n";
    return FALSE;
}

<form.cube_sid> = $cube_sid;

my $prng = Crypt::PRNG::Fortuna->new();
<form.test.cases> = [
    {   'name' =>
            sprintf( 'user-edit-test-%s', <[base.prng.chars-anum]>->(8) ),
        'value' => $prng->bytes(32),
        'label' => qw| 32-random-bytes |,
    },
    {   'name' =>
            sprintf( 'user-edit-test-%s', <[base.prng.chars-anum]>->(8) ),
        'value' => "OK \x00\x0Aspace\x20end\xFF",
        'label' => qw| pathological-string |,
    },
];
<form.test.index> = 0;

<[form.test.secret_send_hold]>;

<[base.init-done]>->(TRUE);    ## standalone zenka: not v7-managed ##

<[base.zenka.loop]>;

return TRUE;

