## [:< ##

# name  = coding.task.ensure_model_pinned
# descr = check a pinned model against what's currently loaded; if it
#         mismatches, trigger a switch (once, guarded against redundant
#         firing) and return a dependency object id the caller should
#         re-queue the task against. returns undef if no defer is
#         needed [ already correct, or no checksum given ].

my $params   = shift                 // {};
my $checksum = $params->{'checksum'} // '';
my $backend  = $params->{'backend'}  // qw| gpu |;

return undef if !length $checksum;

my $server = ( <coding.inference_servers> // {} )->{$backend} // {};
if (    ( $server->{'status'} // '' ) eq qw| ready |
    and ( $server->{'model'} // '' ) eq $checksum ) {
    delete <coding.model_switch_in_flight>->{$checksum};    ## hygiene ##
    return undef;
}

## get-or-create a dependency object for this specific checksum+backend - ##
## reused across future pins of the same checksum, never recreated        ##
<coding.dep.model_checksum> //= {};
<coding.dep.model_checksum>->{$backend} //= {};
my $dep_id = <coding.dep.model_checksum>->{$backend}{$checksum};

unless ( defined $dep_id ) {
    $dep_id = <[dependency.add_object]>->(
        {   'type'     => qw| model_checksum_loaded |,
            'checksum' => $checksum,
            'backend'  => $backend,
        }
    );
    <[dependency.add]>->( $dep_id, $dep_id )
        ;    ## self-chain : invokes the callback ##
    <coding.dep.model_checksum>->{$backend}{$checksum} = $dep_id;
}

## fire switch-model only if not already in flight for this checksum - ##
## avoids redundant respawns when multiple tasks pin the same not-yet- ##
## loaded model concurrently                                           ##
unless ( <coding.model_switch_in_flight>->{$checksum} ) {

    ## a running [ or already yielding ] sweep on this backend wins the     ##
    ## switch : firing here would kill the sweep's candidate mid-cycle [ or ##
    ## vice versa ]. defer instead -- the parked task already counts as     ##
    ## active in the idle predicate, so a yield-aware sweep discovers the   ##
    ## collision and yields on its own next tick, and its drain [           ##
    ## coding.helper.drain_model_pin_deferrals ] re-fires this exact        ##
    ## switch. deferral applies to :no_yield: runs just the same -- there   ##
    ## the sweep never yields by definition [ that is the token's whole     ##
    ## point ], so the pin stays deferred for the sweep's full duration and ##
    ## drains at finish_sweep / model-sweep-cancel.  a paused sweep does    ##
    ## not block : no candidates fire while paused, and any later resume    ##
    ## re-arms the yield path as usual.                                     ##
    my $sweep = <coding.model_sweep_state>->{$backend};
    my $sweep_blocks
        = defined $sweep
        && ref $sweep eq qw| HASH |
        && ( $sweep->{'state'} // qw| running | ) =~ m{^(running|yielding)$};

    if ($sweep_blocks) {
        ## record the deferral, do NOT fire, and do NOT set              ##
        ## <coding.model_switch_in_flight>->{$checksum} on this path --  ##
        ## that flag suppresses every future attempt for this checksum,  ##
        ## including the drain's eventual real one, which would park the ##
        ## task permanently                                              ##
        <coding.model_pin_deferred> //= {};
        <coding.model_pin_deferred>->{$backend} //= {};
        <coding.model_pin_deferred>->{$backend}{$checksum} = TRUE;
        <[base.logs]>->(
            1,
            '[model_pin] deferring switch to %s on %s : model sweep active '
                . '[ task parks in depending, sweep will yield and drain ]',
            $checksum,
            $backend
        );
        return $dep_id;
    }

    <coding.model_switch_in_flight>->{$checksum} = TRUE;
    <[base.logs]>->(
        1,         '[model_pin] switching to %s on %s for pinned task',
        $checksum, $backend
    );
    eval {
        <[coding.cmd.switch-model]>
            ->( { 'args' => "$checksum backend=$backend" } );
        1;
    } or do {
        my $err = $@ || 'unknown error';
        <[base.logs]>->(
            0, '[model_pin] switch-model call failed : %s', $err
        );
        delete <coding.model_switch_in_flight>->{$checksum};
    };
}

return $dep_id;

