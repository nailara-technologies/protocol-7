# name = coding.routing.can_use_local_rules
# descr = check if task can be handled with simple local rules
# purpose = routing : identify simple tasks that don't need LLM

my ($task) = @ARG;

my $desc = lc( $task->{request}->{description} // '' );

# Examples of tasks that don't need LLM
if ( $desc =~ m{^(format|convert|validate|check|list|count)}i ) {
    return {
        applicable => 1,
        rule       => 'simple-transformation',
        cost       => 0
    };
}

# Check type - some types never need LLM
my $type = $task->{type} // '';
if ( $type eq 'transcription' ) {
    return { applicable => 1, rule => 'transcription-direct', cost => 0 };
}

return { applicable => 0 };

