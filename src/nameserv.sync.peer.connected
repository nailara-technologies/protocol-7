## [:< ##

# name  = nameserv.sync.peer.connected
# descr = finish a peer long-poll connect and hold next-data-timestamp

my $key = shift // return;

my $peers = <nameserv.sync.peers> // return;
my $peer  = $peers->{$key}        // return;

if ( ref $peer->{'watcher'} ) {
    $peer->{'watcher'}->cancel
        if $peer->{'watcher'}->can('is_active')
        and $peer->{'watcher'}->is_active;
    $peer->{'watcher'} = undef;
}

if ( ref $peer->{'conn_timer'} ) {
    $peer->{'conn_timer'}->cancel
        if $peer->{'conn_timer'}->can('is_active')
        and $peer->{'conn_timer'}->is_active;
    $peer->{'conn_timer'} = undef;
}

## remember the address that worked : it is tried first next time ##
my $addrs = $peer->{'addrs'};
$peer->{'addr_worked'} = $addrs->[ $peer->{'addr_idx'} ]{'host'}
    if ref $addrs eq qw| ARRAY |
    and $peer->{'addr_idx'} >= 0
    and ref $addrs->[ $peer->{'addr_idx'} ] eq qw| HASH |;

syswrite $peer->{'sock'},
    sprintf 'next-data-timestamp since:%s', $peer->{'ts'} . "\n";

$peer->{'state'} = qw| waiting |;

## bounded hold : a silent half-open socket would wait forever   ##
## [ conn_timer slot : peer.release cancels it with the socket ] ##
$peer->{'conn_timer'} = <[event.add_timer]>->(
    {   after   => <nameserv.cfg.sync.max_hold> // 390,
        handler => qw| nameserv.sync.peer.handler.hold-timeout |,
        data    => $key,
        desc    => "sync peer hold [ $key ]"
    }
);

$peer->{'watcher'} = <[event.add_io]>->(
    {   fd      => $peer->{'sock'},
        poll    => 'r',
        handler => qw| nameserv.sync.peer.handler.read |,
        data    => $key,
        desc    => "sync peer wait [ $key ]"
    }
);

return TRUE;

