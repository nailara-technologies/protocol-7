## [:< ##

# name  = osf-cache.fetch.lookup_done
# descr = continue a fetch from the merged lookup result
# param = { anchor => \@anchors, result => { mode, merged | data } }
#
# the on_done target of the internal lookup osf-cache.cmd.fetch runs [
# see osf-cache.lookup.complete : explicit dispatch, never a text
# reply ]. the merged result carries { holders, bmw384, missing,
# failed_nodes, conflicts, bmw_conflicts } : an anchor in bmw_conflicts
# fails the fetch mode false [ stage 4 keeps this refusal ] and no
# holder fails with the missing \ failed summary. otherwise the
# holders are stored sorted [ osf-cache.holder.cmp : local first,
# then remote by link + sid - holders are ROUTE STRINGS since
# stage 4b ] and stage 4 begins : the merkle root
# agreement over the holders [ osf-cache.fetch.merkle_start ] - the
# partial file is only opened once a tree is agreed and its leaves
# verified [ osf-cache.fetch.start_segments ]. a lookup the fetch
# state no longer knows does nothing.

my $args    = shift             // {};
my $anchors = $args->{'anchor'} // [];
my $result  = $args->{'result'} // {};

my $anchor = $anchors->[0] // return;

my $state = <osf-cache.fetch.pending>->{$anchor};
return unless ref $state eq qw| HASH |;

if ( $result->{'mode'} ne qw| true | ) {
    <[osf-cache.fetch.fail]>->(
        {   'fetch_key' => $anchor,
            'reason'    => sprintf 'lookup failed : %s',
            $result->{'data'} // ''
        }
    );
    return;
}

my $merged = $result->{'merged'} // {};

## two holders reporting different bmw384 for the same anchor : the fetch ##
## refuses [ the stage 3 rule, kept ]                                     ##
if ( exists $merged->{'bmw_conflicts'}{$anchor} ) {
    <[osf-cache.fetch.fail]>->(
        {   'fetch_key' => $anchor,
            'reason'    => "bmw conflict : $anchor [ stage 4 resolves ]"
        }
    );
    return;
}

my $holders = $merged->{'holders'}{$anchor} // [];

if ( !scalar @$holders ) {
    my $summary = "no holders : $anchor";
    my $missing = join ' ', @{ $merged->{'missing'}      // [] };
    my $failed  = join ' ', @{ $merged->{'failed_nodes'} // [] };
    $summary .= " [ missing $missing ]" if length $missing;
    $summary .= " [ failed $failed ]"   if length $failed;
    <[osf-cache.fetch.fail]>->(
        {   'fetch_key' => $anchor,
            'reason'    => $summary
        }
    );
    return;
}

$state->{'holders'}
    = [ sort { <[osf-cache.holder.cmp]>->( $a, $b ) } @$holders ];
$state->{'bmw384'} = $merged->{'bmw384'}{$anchor} // '';

## stage 4 : root agreement first - segments follow the verified tree ##
<[osf-cache.fetch.merkle_start]>->( { 'fetch_key' => $anchor } );

return;

