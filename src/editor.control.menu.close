## [:< ##

# name  = editor.control.menu.close
# descr = leave a menu, returning to the state it opened over
# param = $editor_state

## the inverse of editor.control.menu.open.  returns the state the menu was
## opened OVER, so a nested menu [ namespace -> records -> form ] unwinds one
## level per call -- which is exactly what Esc means via
## user-edit.form.escape's non-base-mode branch.
##
## returns undef when there is nothing to return to : the caller decides
## whether that means "leave the form entirely" [ top-level menu ] or
## something else.
##
## the caller MUST rebuild the frame afterwards.

my ($editor_state) = @ARG;

return undef if ref $editor_state ne qw| HASH |;

my $source = $editor_state->{'menu_source'};

return undef if ref $source ne qw| HASH |;

return $source->{'return_state'};

