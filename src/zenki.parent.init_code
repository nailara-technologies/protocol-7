## [:< ##

# name = zenki.parent.init_code
# descr = initialize zenki dependency resolution and smart launcher

<[base.log]>->( 2, 'initializing zenki dependency resolution system..,' );

## configuration ##
<zenki.cfg.v7_binary> //= catfile( <system.root_path>, qw| bin Protocol-7 | );
<zenki.cfg.v7_startup_timeout>    //= 10;   ## seconds to wait for v7 start ##
<zenki.cfg.cube_startup_timeout>  //= 5;    ## seconds to wait for cube ##
<zenki.cfg.zenka_startup_timeout> //= 8;    ## seconds to wait for a zenka ##
<zenki.cfg.reply_timeout>         //= 24;   ## seconds to wait for a reply ##
<zenki.cfg.auto_start_v7>
    //= ( $UID == 0 ? 1 : 0 );              ## auto-start v7-zenki as root ##
<zenki.cfg.cube_socket_path> //= '/var/run/.7/UNIX';    ## cube socket dir ##

## a standalone console invocation has no cube-issued zenka key, so it    ##
## authenticates over the unix link instead -- but under this zenka's OWN ##
## identity [ cfg/zenki/cube/auth.zenki : ':unix:<unix-admin>' alongside  ##
## ':zenka:', the coding \ amos-term \ mpv precedent ], not as the human  ##
## user.  that keeps its blast radius at exactly what                     ##
## 'access.cmd.usr.zenki' grants, instead of inheriting the admin's '**   ##
## ..*.**' wildcard from access.users                                     ##
##                                                                        ##
## '<zenka>[<unix-user>]' -- the subname is a routing label only [ split  ##
## off before any access decision by plugin.auth.unix ] and keeps a       ##
## short-lived front-door session addressable apart from the resident,    ##
## v7-zenki managed instance of the same name                             ##
<zenki.unix_user> //= $ENV{'USER'} // scalar getpwuid($EUID);
<zenki.auth_name> //= sprintf( qw| zenki[%s] |, <zenki.unix_user> );

## registries for tracking running processes ##
<zenki.running.v7>    //= {};    ## v7-zenki info ##
<zenki.running.cube>  //= {};    ## cube info ##
<zenki.running.zenki> //= {};    ## other zenki ##

## note: dependency resolution is handled by v7-zenki's existing system [ ##
## see v7-zenki.zenka.cmd.start and the per zenka start.cfg files ] -- we ##
## integrate with it rather than duplicating the logic                    ##
##
## two integration modes:
## 1. inside v7-zenki : direct call to v7-zenki.zenka.cmd.start
## 2. outside v7-zenki : ipc via cube using protocol-7.route-send

## initialize statistics ##
<zenki.stats> = {
    v7_starts         => 0,
    cube_starts       => 0,
    zenka_starts      => 0,
    start_requests    => 0,
    successful_starts => 0,
    failed_starts     => 0
};

<[base.log]>->( 2, 'zenki dependency resolution system initialized' );

0;

