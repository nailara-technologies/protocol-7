## [:< ##

# name = zenki.parent.init_code
# descr = initialize zenki dependency resolution and smart launcher

<[base.log]>->( 2, 'initializing zenki dependency resolution system..,' );

## Configuration
<zenki.cfg.v7_binary> //= '/data/projects/protocol-7/bin/Protocol-7';
<zenki.cfg.v7_startup_timeout>    //= 10; ## Seconds to wait for v7 startup
<zenki.cfg.cube_startup_timeout>  //= 5;  ## Seconds to wait for cube startup
<zenki.cfg.zenka_startup_timeout> //= 8;  ## Seconds to wait for zenka startup
<zenki.cfg.auto_start_v7>
    //= ( $UID == 0 ? 1 : 0 );            ## Auto-start v7 when root
<zenki.cfg.cube_socket_path> //= '/var/run/.7/UNIX';  ## Cube socket directory

## Registries for tracking running processes
<zenki.running.v7>    //= {};                         ## v7 process info
<zenki.running.cube>  //= {};                         ## cube process info
<zenki.running.zenki> //= {};                         ## Other zenki processes

## NOTE: Dependency resolution is handled by v7's existing system (see
## v7.zenka.cmd.start:105-141 and start.cfg files)  We integrate with it
## rather than duplicating the logic
##
## Two integration modes:
## 1. Inside v7: Direct call to zenka.cmd.start
## 2. Outside v7: IPC via cube using protocol-7.command.send.local

## Initialize statistics
<zenki.stats> = {
    v7_starts         => 0,
    start_requests    => 0,
    successful_starts => 0,
    failed_starts     => 0
};

<[base.log]>->( 2, 'zenki dependency resolution system initialized' );

0;

