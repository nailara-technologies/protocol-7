## [:< ##

# name  = jobsite.handler.repair-created
# descr = receive repair task id, register wait-done watcher

my $call = shift // {};

## TRUE \ FALSE replies carry no mode \ data [ base.reply.mode_text ] ##
my ( $mode, $task_id ) = <[base.reply.mode_text]>->($call);
my $job_id   = ( $call->{'params'}{'job_id'} // '' );
my $attempt  = $call->{'params'}{'attempt'}                      // 0;
my $cur_attt = ( <jobsite.tasks>->{$job_id} // {} )->{'attempt'} // 0;

if ( $attempt and $attempt != $cur_attt ) {
    ## stale reply : watchdog already gave up on this attempt -- see ##
    ## task-created's identical guard for the full rationale         ##
    <[base.logs]>->(
        1,
        'jss.repair-created: stale reply for job '
            . '%s [ attempt %s, current %s ], ignoring',
        $job_id,
        $attempt,
        $cur_attt
    );
    return;
}

if ( lc($mode) eq qw| false | ) {
    <[base.logs]>->(
        0,       'jss.repair-created: failed for job %s: %s',
        $job_id, $task_id
    );
    ## repair task itself never got created : no watcher will ever fire for ##
    ## this job, so it must be decremented here or it orphans pending_count ##
    ## forever [ mirrors task-created's false branch ]                      ##
    <jobsite.tasks>->{$job_id}{'repair_failed'} = TRUE;
    my $rec = <jobsite.tasks>->{$job_id};
    $rec->{'stage'} = 'timeout'
        if ( $rec->{'stage'} // '' ) =~ m{^(?:queued|assessing)$};
    <[jobsite.state.persist]>;
    <[jobsite.dispatch.release_slot]>->($job_id);
    return;
}

$task_id = uc( substr( $task_id, 0, 7 ) );
<[base.logs]>->( 1, 'job %s → repair task %s', $job_id, $task_id );

<jobsite.tasks>->{$job_id}{'repair_task_id'} = $task_id;
<[jobsite.state.persist]>;

## register wait-done : repair-done will decrement pending_count ##
<[protocol-7.route-send]>->(
    {   'command'   => 'task.wait-done',
        'call_args' => { 'args' => $task_id },
        'reply'     => {
            'handler' => 'jobsite.handler.repair-done',
            'params'  => {
                'job_id'  => $job_id,
                'task_id' => $task_id,
                'attempt' => $attempt
            },
        },
    }
);

