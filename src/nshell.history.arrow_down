## [:< ##

# name = nshell.history.arrow_down
# descr = Down arrow navigation with duplicate skipping

my ( $state_ref, $editor, $colors ) = @ARG;

my $target_index = -1;
my $lines_ref    = undef;

## Get current entry for duplicate comparison
my $current_entry_text = $state_ref->{'display_buffer'} // '';

if ( $state_ref->{'current_history_index'} >= 0 ) {
    ## [ we're viewing history - navigate relative to current position ]
    ## [ Down = newer = higher index, skip duplicates ]
    my $attempts     = 0;
    my $search_index = $state_ref->{'current_history_index'} + 1;

    while ( $attempts < @AMOS7::TERM::history_entries ) {
        if (   $search_index >= 0
            && $search_index < @AMOS7::TERM::history_entries ) {
            my $entry = $AMOS7::TERM::history_entries[$search_index];
            if ( ref($entry) eq 'ARRAY' && $entry->[1] ) {
                my $entry_text = join "\n", $entry->[1]->@*;
                if ( $entry_text ne $current_entry_text ) {
                    $target_index = $search_index;
                    $lines_ref    = $entry->[1];
                    last;
                }
            }
        }
        $search_index++;
        $attempts++;
    }

    ## If no different entry found going forward, clear history view
    unless ( defined $lines_ref ) {
        $state_ref->{'current_history_index'} = -1;
        $state_ref->{'paging_index_stack'}    = [];    # Clear paging stack
        <[nshell.render.empty_prompt]>->( $state_ref, $editor, $colors );
        return;
    }
} else {
    ## [ not in tracked history - clear any stray init cursor ]
    <[nshell.render.empty_prompt]>->( $state_ref, $editor, $colors );
    return;
}

## clear current line before showing new one  [ \e[2K avoids wrap on long
## lines ]
print "\r\e[2K";

$state_ref->{'display_buffer'} = join "\n", $lines_ref->@*;

## [ validate and update history index ]
if ( $target_index >= 0 && $target_index < @AMOS7::TERM::history_entries ) {
    $state_ref->{'current_history_index'} = $target_index;
} elsif ( $target_index >= @AMOS7::TERM::history_entries ) {
    $state_ref->{'current_history_index'} = $#AMOS7::TERM::history_entries;
} else {
    $state_ref->{'current_history_index'} = -1;
}

## Load into editor to sync editor buffer
<[editor.control.load_field]>->(
    $editor, 'command', $state_ref->{'display_buffer'}
);

my $display_buffer = $colors{'p7_fg_0004'} . $state_ref->{'display_buffer'};

## Redraw full line with cursor
<[nshell.render.full_line]>->( $editor, $display_buffer, $colors );

## Enter VIEWING_HISTORY mode
$state_ref->{'current_mode'} = 2;    # VIEWING_HISTORY

return;

