# name  = base.devmod.unsafe_commands
# descr = every devmod command not classified as safe

my %safe = map { $ARG => TRUE } <[base.devmod.safe_commands]>;

return <[base.sort]>->(
    [   grep { not exists $safe{$ARG} }
        map  { $ARG =~ s|^devmod\.cmd\.||r }
        grep {m|^devmod\.cmd\.|} <[base.code.file_list]>
    ]
);

