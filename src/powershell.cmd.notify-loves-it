## [:< ##

# name  = powershell.cmd.notify-loves-it
# param = '<title>' '<message>'
# descr = native windows toast [ 'loves it' icon by default ]
#         thin wrapper over powershell.cmd.notify-msg's shared parsing,
#         see powershell.notify_from_args. icon tags still work here too;
#         the loves-it artwork itself is expected to be amended later with
#         extracted/categorized elf-avatar renderings

return <[powershell.notify_from_args]>->(
    {   'txt_param'    => $call->{'args'} // '',
        'default_icon' => qw| loves-it |
    }
);

