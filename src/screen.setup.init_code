## [:< ##

# name = screen.setup.init_code

## create [ + own + mode ] the zenka output dir while still root, with ##
## group-write so the dropped-privilege user can later write its files ##
<[base.path-set-up.check-zenka-paths]>->( TRUE, 0770 );

<[base.perlmod.autoload]>->('Gtk3');
<[base.perlmod.autoload]>->('Cairo');
<[base.perlmod.autoload]>->('Glib');
<[base.perlmod.autoload]>->('Glib::Object::Introspection');

<[base.gtk.attempt_load.glib_event]>;  ##  load Glib::Event when installed  ##

## subscribe to X-11 screen-change events once connected to cube - lets a ##
## monitor reconfigure retry any pending window-intent moves              ##
push @{ <system.callbacks.initialized> //= [] },
    'screen.setup.subscribe-screen-change';

Gtk3->init;    ## initialize explicitly, required before Gtk3->main ##

return 0;

