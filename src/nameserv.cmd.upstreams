## [:< ##

# name  = nameserv.cmd.upstreams
# descr = show active upstream addresses and their sources

my @entries = <[nameserv.upstream_entries]>;
return { mode => 'size', data => "active upstreams:\n  [none]" }
    if not @entries;

return {
    mode => 'size',
    data => "active upstreams:\n"
        . join( "\n",
        map { sprintf '  %s [%s]', $ARG->{'address'}, $ARG->{'source'} }
            @entries )
};

