## [:< ##

# name  = nameserv.cmd.upstreams
# descr = show active scoped and held upstream source addresses

my @entries = <[nameserv.upstream_entries]>;
my @lines   = map { sprintf '  %s [%s]', $ARG->{'address'}, $ARG->{'source'} }
    @entries;

my $domain = <nameserv.upstreams.domain_by_source> // {};
foreach my $source ( sort keys $domain->%* ) {
    my $route = $domain->{$source};
    push @lines,
        sprintf '  %s [%s : %s]',
        $ARG, $source, join( ',', $route->{'domains'}->@* )
        for $route->{'addresses'}->@*;
}
my $held = <nameserv.upstreams.held_by_source> // {};
foreach my $source ( sort keys $held->%* ) {
    push @lines, sprintf '  %s [%s : held]', $ARG, $source
        for $held->{$source}->@*;
}
return { mode => 'size', data => "upstreams:\n  [none]" } if not @lines;
return { mode => 'size', data => "upstreams:\n" . join( "\n", @lines ) };

