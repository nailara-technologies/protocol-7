#\\\|ULXDBIJXEOZQHEO3AWBMISGWUPGUMXK2VM3VNYK6Q5UF2N6ZHDR \ / AMOS7 \ YOURUM ::
#\[7]BMEJNNU5EFABN7KSQX3VWEK6XI2UUV3KU6Z3H2YNQA4QIPWUJCDY 7  DATA SIGNATURE ::
