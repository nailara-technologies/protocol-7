## [:< ##

# name  = base.stream.emit
# descr = single-frame reply emit [ TRUE | FALSE | WAIT | SIZE | CHRSIZE ]
#         honors cancel + session liveness ; records SIZE / CHRSIZE frames
#         for cmd_id > 0 so cancel-stream can excise them later
# param = { sid => .., cmd_id => .., mode => .., data => ..,
#           [ cmd_id_str => '(NNN) ' ] }
# return = bytes appended, 0 if gated

my $arg = shift;

my $sid      = $arg->{'sid'};
my $cmd_id   = $arg->{'cmd_id'};
my $mode     = uc( $arg->{'mode'} // '' );
my $data     = $arg->{'data'} // '';
my $data_str = ref $data eq qw| SCALAR | ? $$data : $data;

my $cmd_id_str
    = defined $arg->{'cmd_id_str'}        ? $arg->{'cmd_id_str'}
    : ( defined $cmd_id and $cmd_id > 0 ) ? sprintf( '(%d)', $cmd_id )
    :                                       '';

my $session = <[base.stream.gate]>->( $sid, $cmd_id );
return 0 if not defined $session;

my $frame;

if ( $mode =~ m,^(?:TRUE|FALSE|WAIT|GET|TERM)$, ) {

    my $msg = $data_str;
    $msg =~ s|\n|\\n|go if $mode =~ m,^(?:TRUE|FALSE|WAIT)$,;
    $frame = <[base.sprint_t]>->( qw| J4UEBUA |, $cmd_id_str, $mode, $msg );

} elsif ( $mode eq qw| SIZE | ) {

    ## normalize to a byte string BEFORE measuring or chunking --          ##
    ## utf8::encode never fails [ unlike utf8::downgrade with fail_ok,     ##
    ## which silently leaves non-Latin1 content wide-character-flagged ],  ##
    ## so bytes::length and what bytes::substr actually consumes can never ##
    ## diverge. confirmed live 2026-09-14 : coding.dump silently dropped a ##
    ## whole ~8K chunk with no error anywhere -- box-drawing characters [  ##
    ## used throughout coding.buffer.task_write/nshell.render, well past   ##
    ## Latin-1 ] elsewhere in the dumped namespace made downgrade fail,    ##
    ## `length($data_str)` [ character count ] hit zero before             ##
    ## bytes::substr had actually consumed every byte, and the loop below  ##
    ## exited with real data still unconsumed -- never sent at all, so     ##
    ## nothing on the receiving end had anything to log as incomplete      ##
    utf8::encode($data_str) if utf8::is_utf8($data_str);
    my $count = bytes::length($data_str);

    ## forward as chunked STRM-SIZE to clients that declared support,       ##
    ## instead of one atomic SIZE body a receiving session's own            ##
    ## size.buffer.input can never hold once count exceeds that cap --      ##
    ## confirmed live 2026-09-14 : coding.dump [ base.devmod.dump_var's     ##
    ## Dumper output, routed through this single-frame emitter since it's a ##
    ## LOCAL command reply, never process_reply's relay path ] permanently  ##
    ## paused nshell's own read handler [ 'input handler paused [ buffer    ##
    ## full ]' ] against a 242707-byte size.buffer.input.  sibling fix to   ##
    ## process_reply's STRM-SIZE relay path, which already honors the same  ##
    ## flag for replies forwarded from a routed target                      ##
    if ( $session->{'strm_size_support'} and $count > <size.buffer.input> ) {
        my $chunk_size = 8192;
        my $frame_out  = sprintf "%sSTRM-SIZE open %d\n", $cmd_id_str, $count;
        while ( bytes::length($data_str) ) {
            my $this_chunk = bytes::substr( $data_str, 0, $chunk_size, '' );
            $frame_out .= sprintf "%sSTRM-SIZE %d\n%s", $cmd_id_str,
                bytes::length($this_chunk), $this_chunk;
        }
        $frame_out .= sprintf "%sSTRM-SIZE close\n", $cmd_id_str;
        $frame = $frame_out;
    } else {
        $frame = <[base.sprint_t]>->(
            qw| X3QVAWA |, $cmd_id_str, $count, $data_str
        );
    }

} elsif ( $mode eq qw| CHRSIZE | ) {

    my $test = $data_str;
    utf8::upgrade($test);
    my $count = length($test);
    $frame = sprintf "%sCHRSIZE %04d\n%s", $cmd_id_str, $count, $data_str;

} else {

    <[base.logs]>->( 0, 'base.stream.emit : unknown mode [ %s ]', $mode );
    return 0;
}

my $written = bytes::length($frame);
utf8::downgrade( $session->{'buffer'}->{'output'}, 1 )
    if utf8::is_utf8( $session->{'buffer'}->{'output'} );
$session->{'buffer'}->{'output'} .= $frame;

<[base.stream.record_emission]>->( $sid, $cmd_id, $written, $mode )
    if defined $cmd_id
    and $cmd_id > 0
    and $mode =~ m,^(?:SIZE|CHRSIZE)$,;

return $written;

