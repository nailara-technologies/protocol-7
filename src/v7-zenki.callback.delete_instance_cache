## [:< ##

# name  = v7-zenki.callback.delete_instance_cache

my $w = shift->w;
$w->cancel if $w->is_active;
<v7-zenki.watchers.instance_cache>->stop;    ## prevent deep recusion ##

if ( not defined <v7-zenki.process.instance_cache>
    or keys <v7-zenki.process.instance_cache>->%* ) {

    ##  resetting instance cache  ##
    <v7-zenki.process.instance_cache> = {};
}

delete <v7-zenki.timer.reset_instance_cache>;
<[base.clean_hashref]>->(<v7-zenki.timer>);

<v7-zenki.watchers.instance_cache>->start;    ##  restarting watcher  ##

