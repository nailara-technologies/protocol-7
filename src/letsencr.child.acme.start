## [:< ##

# name  = letsencr.child.acme.start
# param = <request hash>
# descr = create the order record, then fetch the directory

my $req = shift // {};

my $order_id = <[base.gen_id]>->( <letsencr.child.orders> //= {} );

my $timeout = <letsencr.cfg.order_timeout> // 900;    ## 15 min ##

<letsencr.child.orders>->{$order_id} = {
    'order_id'       => $order_id,
    'reply_id'       => $req->{'reply_id'},
    'domains'        => $req->{'domains'},
    'primary_domain' => $req->{'domains'}->[0],
    'authz'          => {},
    'authz_urls'     => [],
    'deadline'       => time + $timeout,
    'step'           => qw| directory |,
    'polls'          => 0,
};
<letsencr.child.acme.active> = $order_id;

## the deadline also fires when no reply ever comes back ##
<letsencr.child.orders>->{$order_id}->{'deadline_timer'}
    = <[event.add_timer]>->(
    {   'after'   => $timeout,
        'handler' => qw| letsencr.child.acme.on_deadline |,
        'data'    => { 'order_id' => $order_id },
    }
    );

<[letsencr.child.acme.step_directory]>->($order_id);

return $order_id;

