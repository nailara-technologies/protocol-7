## [:< ##

# name  = thermal.override.set
# descr = store a forced verdict for the current schedule window

my ( $store, $verdict, $now ) = @ARG;

return FALSE if ref $store ne qw| HASH |;

$store->{'verdict'} = $verdict;
$store->{'window'}  = <[thermal.window.current]>->($now);
$store->{'set_at'}  = $now;

return TRUE;

