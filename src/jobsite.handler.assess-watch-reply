## [:< ##

# name  = jobsite.handler.assess-watch-reply
# descr = the watchdog's task.show answer : keep waiting or give up

## jobsite.handler.assess-timeout asked task about the job's task and     ##
## re-armed the watchdog meanwhile. a task still pending, claimed or in   ##
## progress keeps its slot ; done too, its wait-done reply is on the way. ##
## failed, unknown or no answer : jobsite.dispatch.give_up                ##

my $call = shift // {};

my ( $mode, $text ) = <[base.reply.mode_text]>->($call);
my $job_id  = $call->{'params'}{'job_id'}  // '';
my $attempt = $call->{'params'}{'attempt'} // 0;
my $task_id = $call->{'params'}{'task_id'} // '';

## resolved meanwhile [ the real reply came ], or a newer dispatch ##
my $job_rec = <jobsite.tasks>->{$job_id};
return if not defined $job_rec;
return if not exists <jobsite.assess_timer>->{$job_id};
return if $attempt and $attempt != ( $job_rec->{'attempt'} // 0 );

my ($status) = $text =~ m{^status\s*:\s*(\S+)}m;
$status //= '';

## done but no result arrived : the wait-done reply was lost               ##
## [ route collapsed : link drop, heartbeat kill ] -- waiting on can never ##
## end.  ask again, a done task answers at once into the normal done       ##
## handler                                                                 ##
if ( $mode ne qw| false | and $status eq qw| done | and length $task_id ) {
    my $kind = $job_rec->{'watch_kind'} // qw| assess |;
    <[base.logs]>->(
        1, 'jss.assess-watch : job %s task %s is done, fetching its result',
        $job_id, $task_id
    );
    <[protocol-7.route-send]>->(
        {   'command'   => 'task.wait-done',
            'call_args' => { 'args' => $task_id },
            'reply'     => {
                  'handler' => $kind eq qw| repair |
                ? 'jobsite.handler.repair-done'
                : 'jobsite.handler.assess-done',
                'params' => {
                    'job_id'  => $job_id,
                    'task_id' => $task_id,
                    'attempt' => $attempt
                },
            },
        }
    );
    return;
}

if (    $mode ne qw| false |
    and $status =~ m{^(?:pending|claimed|in_progress)$} ) {
    <[base.logs]>->(
        1, 'jss.assess-watch : job %s task %s is %s, waiting on',
        $job_id, $task_id, $status
    );

    ## a claimed \ in_progress task ends done or failed : its claim expiry ##
    ## [ task.claim_expire ] owns that -- the round does not count against ##
    ## the watch limit, a never claimed 'pending' task still does          ##
    $job_rec->{'watch_extensions'}--
        if $status ne qw| pending | and $job_rec->{'watch_extensions'};
    return;
}

<[base.logs]>->(
    1, 'jss.assess-watch : job %s task %s %s',
    $job_id, $task_id, length $status ? "is $status" : "unknown [ $text ]"
);
<[jobsite.dispatch.give_up]>->($job_id);

return;

