## [:< ##

# name  = forensics.event.rule-synthesis
# descr = anomaly -> llm rule synthesis : take unprocessed sweep anomalies,
#         ask the local coding zenka for a detection rule, dispatch replies
#         to forensics.handler.rule-proposal [ candidate written there ]
# param = { sweep_date => YYYY-MM-DD [ default : latest ], max => N }

##      phase 2 [ data/tasks/forensics-agent.md task 2.2 ] : the LLM        ##
##      rule-synthesis loop from                                            ##
##      CONCEPT-SECURITY-AND-FORENSICS-ARCHITECTURE : anomaly -> llm        ##
##      analysis -> generated detection rule -> next occurrence caught      ##
##      deterministically. candidates are written as auditable yaml on      ##
##      disk [ schema mirrors the ncode pattern store, see                  ##
##      data/ai-mem/claude/topic-ncode-pattern-learning-loop.md ] and       ##
##      gated : status 'candidate' requires manual review + move to         ##
##      rules/active/ before any activation.                                ##
##                                                                          ##
##      local models only [ HYBRID-LLM-GOVERNANCE ] : inference goes        ##
##      to the coding zenka via cube.coding.ask-reply [ ':simple:'          ##
##      marker : single round, no tools, no file access ].                  ##
##                                                                          ##
##      manually triggered [ forensics.cmd.rules.synthesize ] -- not        ##
##      chained into the 04:07 sweep yet : candidates need a review         ##
##      habit before the loop runs unattended.                              ##

my $params = shift // {};
$params = {} if ref $params ne qw| HASH |;

require Crypt::Misc;
require Digest::SHA;

my $var_p7 = <system.path.zenka-dirs.var_P7> // qw| /var/protocol-7 |;
my $zenka  = <system.zenka.name>;

my $sweep_dir = <forensics.cfg.sweep_dir> // sprintf qw| %s/%s/sweeps |,
    $var_p7, $zenka;
my $rule_dir = <forensics.cfg.rule_dir> // sprintf qw| %s/%s/rules |,
    $var_p7, $zenka;
my $max_per_run = $params->{'max'} // <forensics.cfg.synthesis_max_per_run>
    // 3;

my $state_path = sprintf qw| %s/synthesis-state.yaml |, $rule_dir;

return {
    'mode' => qw| false |,
    'data' => sprintf( 'rule dir missing [ %s ] -- created at zenka init',
        $rule_dir )
    }
    if not -d sprintf( qw| %s/candidates |, $rule_dir );

## --- locate sweep record --------------------------------------------- ##

my $sweep_date = $params->{'sweep_date'} // '';
if ( not length $sweep_date ) {
    my @records = sort glob( sprintf qw| %s/????-??-??.yaml |, $sweep_dir );
    return {
        'mode' => qw| false |,
        'data' => sprintf( 'no sweep records in [ %s ]', $sweep_dir )
        }
        if not @records;
    ( $sweep_date = $records[-1] ) =~ s{^.*/|\.yaml$}{}g;
}

return {
    'mode' => qw| false |,
    'data' => sprintf( 'invalid sweep date [ %s ]', $sweep_date )
    }
    if $sweep_date !~ m|^\d{4}-\d{2}-\d{2}$|;

my $sweep_path = sprintf qw| %s/%s.yaml |, $sweep_dir, $sweep_date;
my $sweep      = <[format.yaml.load_file]>->($sweep_path);
return {
    'mode' => qw| false |,
    'data' => sprintf( 'cannot load sweep record [ %s ]', $sweep_path )
    }
    if ref $sweep ne qw| HASH |;

my $entries = $sweep->{'entries'} // [];
return {
    'mode'       => qw| true |,
    'data'       => sprintf( 'sweep %s has no anomaly entries', $sweep_date ),
    'dispatched' => 0,
    }
    if not @{$entries};

## --- synthesis state [ processed anomaly registry ] ------------------- ##

my $state = -r $state_path ? <[format.yaml.load_file]>->($state_path) : {};
$state = {} if ref $state ne qw| HASH |;
$state->{'processed'} //= {};

## --- dispatch unprocessed anomalies to the coding zenka --------------- ##

my $dispatched = 0;
my @skipped;

foreach my $entry ( @{$entries} ) {
    last if $dispatched >= $max_per_run;
    next if ref $entry ne qw| HASH |;

    my $class   = $entry->{'class'}   // qw| ? |;
    my $e_zenka = $entry->{'zenka'}   // qw| ? |;
    my $message = $entry->{'message'} // '';
    next if not length $message;

    my $anomaly_key
        = Digest::SHA::sha1_hex( join "\x00", $class, $e_zenka, $message );

    if ( exists $state->{'processed'}{$anomaly_key} ) {
        push @skipped, sprintf qw| %s [%s] |, $class,
            substr( $anomaly_key, 0, 7 );
        next;
    }

    ( my $msg_oneline = $message ) =~ s|\s+| |g;
    $msg_oneline = substr( $msg_oneline, 0, 400 );

    my $prompt = <<'EOP_HDR';
:simple:
You are a detection-rule synthesizer for the protocol-7 forensics zenka.
Given one anomalous log line, generalize a single Perl-compatible regular
expression that detects this anomaly CLASS in future log lines.
Rules: match the invariant structure, not volatile data [ timestamps, pids,
session ids ]. Keep it one line. No delimiters, no /x modifiers.
Answer EXACTLY in this four-line format, nothing else:
NAME: <lower-case-dash-name, 3-60 chars>
DESCR: <one line: what the rule detects>
REGEX: <the perl regex, one line>
CONFIDENCE: <0.0-1.0>

EOP_HDR

    $prompt
        .= sprintf "Anomaly class: %s\nSource zenka log: %s\nOccurrences "
        . "in sweep: %d\nAnomalous log line:\n%s\n",
        $class, $e_zenka, $entry->{'count'} // 1, $msg_oneline;

    my $encoded_prompt = eval { Crypt::Misc::encode_b32r($prompt) };
    if ( $EVAL_ERROR or not length $encoded_prompt // '' ) {
        <[base.logs]>->(
            0,
            'rule-synthesis : base32r encode failed [ %s ]',
            $EVAL_ERROR // qw| empty |
        );
        next;
    }

    my $sent = <[protocol-7.command.send.local]>->(
        {   'command'   => qw| cube.coding.ask-reply |,
            'call_args' => { 'args' => $encoded_prompt },
            'reply'     => {
                'handler' => qw| forensics.handler.rule-proposal |,
                'params'  => {
                    'anomaly_key' => $anomaly_key,
                    'class'       => $class,
                    'zenka'       => $e_zenka,
                    'message'     => $msg_oneline,
                    'count'       => $entry->{'count'} // 1,
                    'sweep_date'  => $sweep_date,
                    'first_seen'  => $entry->{'first_seen'} // '',
                    'last_seen'   => $entry->{'last_seen'}  // '',
                },
            },
        }
    );

    if ( not $sent or $sent <= 0 ) {
        <[base.logs]>->(
            0, 'rule-synthesis : send to coding zenka failed [ %s ]', $class
        );
        next;
    }

    $state->{'processed'}{$anomaly_key} = {
        'status'     => qw| pending |,
        'class'      => $class,
        'zenka'      => $e_zenka,
        'sweep_date' => $sweep_date,
        'dispatched' => time,
    };
    $dispatched++;
}

if ($dispatched) {
    my ( $ok, $err ) = <[format.yaml.write_file]>->( $state_path, $state );
    <[base.logs]>->(
        0,
        'rule-synthesis : state write failed [ %s ]',
        $err // qw| ? |
    ) if not $ok;
}

<[base.logs]>->(
    1, 'rule-synthesis : sweep %s : %d dispatched, %d already processed',
    $sweep_date, $dispatched, scalar @skipped
);

return {
    'mode'       => qw| true |,
    'sweep_date' => $sweep_date,
    'dispatched' => $dispatched,
    'skipped'    => \@skipped,
};

