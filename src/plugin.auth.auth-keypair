## [:< ##

# name    = plugin.auth.auth-keypair
# descr   = auth-keypair authentication (ephemeral session key signed by Ed25519 master key)
# args    = int(session id)
# return  = str(user name) (success), undef [error]
#
# protocol = auth <username> <c25519_pubkey_b32> <ed25519_signature_b32>
#           Client signs C25519 session pubkey with Ed25519 master private key
#           Server verifies signature using stored Ed25519 master public key

my $id = $_[0]->w->data;
my $re = <regex.base>;

my $input  = \$data{'session'}{$id}{'buffer'}{'input'};
my $output = \$data{'session'}{$id}{'buffer'}{'output'};

## Parse: auth <username> <c25519_pubkey_b32> <ed25519_signature_b32>
if ( $input->$* =~ s|^auth ($re->{usr_str}) (\S+) (\S+)\n|| ) {

    my ( $username, $pubkey_b32, $sig_b32 )
        = ( ${^CAPTURE}[0], ${^CAPTURE}[1], ${^CAPTURE}[2] );

    ## Get authorized remote user's Ed25519 public key for signature
    ## verification Username must be in authorized-remote registry with public
    ## key
    my $authorized_user_ref = $keys{'authorized-remote'}{$username};

    unless ( defined $authorized_user_ref
        and ref $authorized_user_ref eq qw| HASH | ) {
        $output->$* .= "AUTH_ERROR user not authorized\n";
        <[base.logs]>->(
            0,   '[%d] auth-keypair failed: user \'%s\' not authorized',
            $id, $username
        );
        return 2;    ## access denied - user not authorized ##
    }

    my $master_pubkey_b32 = $authorized_user_ref->{'public_b32'};
    my $master_pubkey_bin = $authorized_user_ref->{'public'};

    unless ( defined $master_pubkey_bin and length($master_pubkey_bin) == 32 )
    {
        $output->$* .= "AUTH_ERROR invalid master key format\n";
        <[base.logs]>->(
            0, '[%d] auth-keypair failed: invalid master key for user \'%s\'',
            $id, $username
        );
        return 2;    ## access denied - invalid master key ##
    }

    ## Decode client's C25519 session pubkey
    my $c25519_pubkey_bin
        = eval { Crypt::Misc::decode_b32r($pubkey_b32) } // undef;

    unless ( defined $c25519_pubkey_bin and length($c25519_pubkey_bin) == 32 )
    {
        $output->$* .= "AUTH_ERROR invalid session pubkey format\n";
        <[base.logs]>->(
            0,
            '[%d] auth-keypair failed: invalid '
                . 'session pubkey for user \'%s\'',
            $id,
            $username
        );
        return 2;    ## access denied - invalid pubkey ##
    }

    ## Decode signature
    my $signature_bin = eval { Crypt::Misc::decode_b32r($sig_b32) } // undef;

    unless ( defined $signature_bin and length($signature_bin) == 64 ) {
        $output->$* .= "AUTH_ERROR invalid signature format\n";
        <[base.logs]>->(
            0, '[%d] auth-keypair failed: invalid signature for user \'%s\'',
            $id, $username
        );
        return 2;    ## access denied - invalid signature ##
    }

    ## Verify Ed25519 signature on the C25519 pubkey  Signature must be over
    ## the raw C25519 public key bytes
    my $signature_valid = FALSE;

    eval {
        $signature_valid = Crypt::Ed25519::verify(
            $c25519_pubkey_bin,    ## message (C25519 pubkey that was signed)
            $master_pubkey_bin,    ## public key (Ed25519 master pubkey)
            $signature_bin         ## signature (64 bytes)
        ) // 0;
    };

    if ( length $EVAL_ERROR ) {
        <[base.logs]>->(
            0,   '[%d] auth-keypair failed: signature verification error: %s',
            $id, <[base.str.eval_error]>
        );
        $output->$* .= "AUTH_ERROR signature verification error\n";
        return 2;    ## access denied - verification error ##
    }

    if ($signature_valid) {
        ## Signature verified - validate/pin incoming client TOFU key
        my $client_sock_fd = $data{'session'}{$id}{'handle'};
        my $tofu_result    = 0;

        ## Validate TOFU for TCP connections (not for unix domain sockets) ##
        if (    defined $client_sock_fd
            and defined $data{'handle'}{$client_sock_fd}
            and $data{'handle'}{$client_sock_fd}{'link'} eq 'ip.tcp' ) {

            my $peerhost   = $data{'handle'}{$client_sock_fd}{'peerhost'};
            my $peerport   = $data{'handle'}{$client_sock_fd}{'peerport'};
            my $zenka_name = <system.zenka.name> // 'unknown';

            $tofu_result
                = <[plugin.auth.auth-keypair.validate-incoming-tofu]>->(
                $id, $zenka_name, $username, $master_pubkey_b32, $peerhost,
                $peerport
                );

            if ( $tofu_result == 0 ) {
                ##  TOFU validated and authorized - allow access  ##
            } elsif ( $tofu_result == 1 ) {
                ##  TOFU pinned but awaiting authorization  ##
                $output->$*
                    .= "AUTH_ERROR TOFU: key pinned, "
                    . "awaiting authorization\n";
                <[base.logs]>->(
                    1,
                    '[%d] auth-keypair: TOFU awaiting '
                        . 'auth for \'%s\' from %s:%s',
                    $id,
                    $username,
                    $peerhost,
                    $peerport
                );
                return 2;    ## access denied - not yet authorized ##
            } elsif ( $tofu_result == 2 ) {
                ##  TOFU mismatch - key compromise suspected!  ##
                $output->$*
                    .= "AUTH_ERROR TOFU mismatch - "
                    . "key compromise suspected\n";
                <[base.logs]>->(
                    0,
                    '[%d] auth-keypair: TOFU violation for \'%s\' from %s:%s',
                    $id,
                    $username,
                    $peerhost,
                    $peerport
                );
                return 2;    ## access denied - TOFU violation ##
            } elsif ( $tofu_result == 4 ) {
                ##  TOFU processing error  ##
                $output->$* .= "AUTH_ERROR TOFU processing failed\n";
                <[base.logs]>->(
                    0,   '[%d] auth-keypair: TOFU error for \'%s\'',
                    $id, $username
                );
                return 2;    ## access denied - TOFU error ##
            }
        }

        ## Signature verified and TOFU validated - authenticate user with
        ## C25519 session key
        $output->$* .= "AUTH_TRUE =)\n";

        ## Store C25519 session key for this user
        $keys{'auth'}{'c25519-session'}{$id} = {
            'username'   => $username,
            'pubkey_b32' => $pubkey_b32,
            'pubkey_bin' => $c25519_pubkey_bin,
            'timestamp'  => <[base.ntime]>,
        };

        <[base.logs]>->(
            1, '[remote] user \'%s\' session authorized.', $username
        );
        return ( 0, $username );    ## success with username ##
    } else {
        $output->$* .= "AUTH_ERROR signature verification failed\n";
        <[base.logs]>->(
            0, '[%d] auth-keypair : signature verification failed for \'%s\'',
            $id, $username
        );
        return 2;    ## access denied - signature verification failed ##
    }

} elsif ( $input->$* =~ m|\n| ) {
    $output->$* .= ">:[\n";
    <[base.logs]>->(
        0, '[%d] authentication protocol mismatch [ auth-keypair ] >:[', $id
    );
    return 2;    ## no access [ protocol error ] ##
} else {
    return 1;    ## continue [ incomplete line ] ##
}

1;

