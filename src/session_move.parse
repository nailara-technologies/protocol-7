## [:< ##

# name   = session_move.parse
# descr  = p7 config style text [ = and : are equal ]
# args   = text
# return = hash ref [ 'file' lines : array ref ]

my $text = shift // '';
my %cfg  = ( 'file' => [] );
foreach my $line ( CORE::split m{\n}, $text ) {
    next if $line =~ m{\A\s*(?:#|\z)};
    my ( $key, $value ) = $line =~ m{\A\s*([\w.-]+)\s*[=:]\s*(.*?)\s*\z}
        or next;
    if ( $key eq qw| file | ) { push @{ $cfg{'file'} }, $value }
    else                      { $cfg{$key} = $value }
}
return \%cfg;

