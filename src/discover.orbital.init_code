## [:< ##

# name  = discover.orbital.init_code
# descr = schedule initial orbital p7ref fetch from nodes zenka

## fetch after short delay to allow nodes zenka to connect first ##
<[event.add_timer]>->(
    {   qw| after   | => 7,
        qw| handler | => qw| discover.orbital.get_local_p7ref |,
    }
);

<[base.log]>->( 2, 'orbital p7ref fetch scheduled' );

