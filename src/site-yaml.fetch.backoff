## [:< ##

# name  = site-yaml.fetch.backoff
# descr = adjust fetch delay based on success/error history

my $result = shift // 'success';

my $delay     = <site-yaml.fetch_delay>     // 1.5;
my $delay_min = <site-yaml.fetch_delay_min> // 0.5;
my $delay_max = <site-yaml.fetch_delay_max> // 10.0;
my $errors    = <site-yaml.fetch_errors>    // 0;
my $successes = <site-yaml.fetch_successes> // 0;

## growth \ reset come from the shared helper, type 'site-yaml-fetch' [ cfg ##
## <base.interval.cfg.type.site-yaml-fetch.*> in zenka.v7 : start 1.5,      ##
## factor 1.75, cap 10 ] ; the helper has no decay, so after 3 consecutive  ##
## successes the delay decays x0.9 per fetch, the state resets at the floor ##
## [ never below fetch_delay_min ] ; fetch_delay_min \ _max clamp the       ##
## result                                                                   ##
my $state = <site-yaml.fetch_interval_state> //= {};
my $next  = sub {
    my $reset = shift;
    my $v     = <[base.interval.next]>->(
        {   qw| type |  => qw| site-yaml-fetch |,
            qw| state | => $state,
            qw| reset | => $reset ? TRUE : FALSE
        }
    );
    return $v // $delay;    ## helper refused : keep the delay ##
};

my $new_delay;
if ( $result eq qw| error | ) {
    $errors++;
    $successes = 0;
    ## prime : fresh state ##
    $next->(FALSE) if not defined $state->{'current'};
    $new_delay = $next->(FALSE);
    ## an error never speeds up ##
    $new_delay = $delay     if $new_delay < $delay;
    $new_delay = $delay_max if $new_delay > $delay_max;
} else {
    $successes++;
    ## gradual decay, rhythm state reset at the floor ##
    if ( $successes >= 3 ) {
        $new_delay = $delay * 0.9;
        if ( $new_delay <= $delay_min ) {
            $successes = 0;
            $next->(TRUE);
        }
    } else {
        $new_delay = $delay;
    }
    $new_delay = $delay_min if $new_delay < $delay_min;
}

<site-yaml.fetch_delay>     = $new_delay;
<site-yaml.fetch_errors>    = $errors;
<site-yaml.fetch_successes> = $successes;

my $tag = $result eq 'error' ? '↑' : '↓';
<[base.logs]>->(
    1,    'backoff: %s %.2f→%.2fs err=%d ok=%d',
    $tag, $delay, $new_delay, $errors, $successes
);

return $new_delay;

