## [:< ##

# name  = models.task.subscribe
# descr = open a task zenka's notice stream when none is open
# note  = open the '<zenka>.subscribe' notice stream of one listed task
#         zenka when none is open for it
# param = <zenka>
# notes = idempotent, per listed zenka [ models.task.zenki ] -- one
#         zenka down never blocks the others. the reply handler
#         models.handler.task-stream registers the STRM consumer ; a
#         refusal, a closed stream or no answer within 90 s retries
#         with backoff [ models.task.subscribe-retry ]

my $zenka = shift // '';

return FALSE if not length $zenka or $zenka eq qw| task |;

my $state = <models.task.streams>->{$zenka} //= {};

return TRUE if $state->{'subscribed'};

if ( defined $state->{'since'} ) {
    return TRUE if time - $state->{'since'} < 90;

    <[base.logs]>->(
        1, ': task notice stream %s : subscribe unanswered, retrying later',
        $zenka
    );
    $state->{'since'} = undef;
    <[models.task.subscribe-retry]>->($zenka);
}

return FALSE if time < ( $state->{'retry_at'} // 0 );

$state->{'since'} = time;

my $sent = <[protocol-7.route-send]>->(
    {   'command' => sprintf( qw| %s.subscribe |, $zenka ),
        'reply'   => {
            'handler' => qw| models.handler.task-stream |,
            'params'  => { 'zenka' => $zenka }
        }
    }
);

if ( not $sent or $sent <= 0 ) {
    $state->{'since'} = undef;
    <[models.task.subscribe-retry]>->($zenka);
    <[base.logs]>->(
        1,      ': task notice stream %s : %s.subscribe not routed',
        $zenka, $zenka
    );
    return FALSE;
}

return TRUE;

