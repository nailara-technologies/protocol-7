## [:< ##

# name  = ui.cmd.ui-show
# descr = base ui-show command
# param = { address?, view? }
# note  = [ overridden by zenka-specific <namespace>.cmd.ui-show ]

my $args_str = $call->{'args'} // '';
$args_str =~ s|^\s+||;
$args_str =~ s|\s+$||;

## default to the current zenka name [ cube strips prefix before dispatch ] ##
my $address = <system.zenka.name> // '';
my $view    = '';

## allow explicit override from argument tokens ##
if ( length $args_str ) {
    foreach my $token ( split qr|\s+|, $args_str ) {
        if ( $token =~ m|^address=(.+)$| ) {
            $address = $1;
        } elsif ( $token =~ m|^view=(.+)$| ) {
            $view = $1;
        }
    }
}

return { 'mode' => qw| false |, 'data' => 'address required' }
    if not length $address;

## derive slot budget from current tty ##
my $slot_budget = eval {<[ui.budget.tty]>} // { 'cols' => 80, 'rows' => 24 };

## render the address using the generic unfold primitive.  raw_args is the
## FULL original args string [ address=/view= tokens included, since a
## zenka-specific override is free to define its own vocabulary -- cred-
## mesh's own override never uses address=/view= tokens at all, it takes bare
## positional args plus a trailing session_id=NNN ] -- forwarded through
## unparsed so ui.unfold's own delegation to a zenka-specific
## <namespace>.cmd.ui-show override [ its own "[ 2 ] specific ui-show command"
## branch ] has something to pass it. found live : without this, that
## delegation called the  override with ZERO arguments, silently dropping
## view/session_id and leaving it unable to ever resolve per-session UI state
## [ data/tasks/credential-fabric-ui-interactive.md ]
my $unfolded = eval {
    <[ui.unfold]>->(
        {   'address'     => $address,
            'slot_budget' => $slot_budget,
            'raw_args'    => $args_str,
        }
    );
} // { 'mode' => qw| true |, 'data' => '' };

my $body
    = ( ref $unfolded eq qw| HASH | and exists $unfolded->{'data'} )
    ? $unfolded->{'data'}
    : '';

## one-line header frame using the .:[ ]:. idiom ##
my $header      = '';
my $frame_entry = eval { <[ascii.frame.load]>->('ui-show-fallback-header') };

if ( defined $frame_entry ) {
    my $descriptor;
    if ( exists $frame_entry->{'descriptor'} ) {
        $descriptor = $frame_entry->{'descriptor'};
    } elsif ( exists $frame_entry->{'descriptors'} ) {
        my $mode = $frame_entry->{'modes'}[0] // 'expanded';
        $descriptor = $frame_entry->{'descriptors'}{$mode};
    }

    if ( defined $descriptor ) {
        $header = eval {
            <[ascii.frame.render]>->(
                {   descriptor => $descriptor,
                    values     => { 'TITLE' => $address }
                }
            );
        } // '';
    }
}

my $output
    = length $header && length $body ? "$header\n$body"
    : length $header                 ? $header
    :                                  $body;

return { 'mode' => qw| size |, 'data' => $output };

