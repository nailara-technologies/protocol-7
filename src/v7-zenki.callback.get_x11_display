## [:< ##

# name = v7-zenki.callback.get_x11_display

## called with the SPECIFIC instance_id whose v7-post-init just fired       ##
## [see zenki/X-11/zenka.v7] -- this identifies exactly which X-11 instance ##
## to ask, so no subname-group resolution is needed [or correct]: v7 itself ##
## has no subname, so resolve_primary_sid('X-11') would match the           ##
## subname-less/host instance regardless of which instance is actually      ##
## starting up right now.                                                   ##
my $instance_id = shift;
my $inst        = <v7-zenki.zenka.instance>->{$instance_id};
my $cube_sid    = $inst->{'cube_sid'};

if ( not defined $cube_sid ) {
    <[base.logs]>->(
        1, '[get_x11_display] instance %s has no cube_sid yet', $instance_id
    );
    return;
}

<[base.log]>->( 1, "requesting x11.display from X-11 zenka.," );

<[protocol-7.route-send]>->(
    {   'command' => "$cube_sid.get_display",
        'reply'   => {
            'handler' => qw| v7-zenki.handler.get_display_reply |,
            'params'  => { 'cube_sid' => $cube_sid }
        }
    }
);

