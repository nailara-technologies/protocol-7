## [:< ##

# name  = screen.setup.dpi.place-windows
# descr = rerun placement after confirmed dpi change

<[base.zenki.resolve_primary_sid]>->(
    'X-11',
    sub {
        my $sid = shift;
        return if not defined $sid;
        <[protocol-7.route-send]>->(
            {   'command'   => "$sid.get-windows",
                'call_args' => { 'args' => '' },
                'reply'     =>
                    { 'handler' => qw| screen.setup.dpi.handler.windows |, },
            }
        );
    }
);
return TRUE;

