## [:< ##

# name  = screen.setup.handler.button_release
# descr = on the end of a window-intent drag, ask X-11 to move the window;
#         on the end of a border drag, persist the minimap's new position

my ( $id, $widget, $event ) = @ARG;

return TRUE if not defined $id;

my $inst = $data{'screen-setup'}{'instances'}{$id};
return TRUE if not defined $inst;

## window-intent drag end : attempt to apply the intended position        ##
my $idx = delete $inst->{'drag_win_idx'};
if ( defined $idx ) {
    my $start = delete $inst->{'drag_start_minimap'};
    my $base  = delete $inst->{'drag_start_geo'};

    my $win = $inst->{'windows'}[$idx];
    if ( defined $win and defined $win->{'intended_geo'} ) {
        my $ig    = $win->{'intended_geo'};
        my $winid = $win->{'winid'};
        my $x     = int( $ig->{'x'} + 0.5 );
        my $y     = int( $ig->{'y'} + 0.5 );

        <[base.logs]>->(
            1,
            '[screen-setup.button_release] '
                . 'id=%s winid=%s move intent x=%d y=%d',
            $id,
            $winid,
            $x,
            $y
        );

        <[base.zenki.resolve_primary_sid]>->(
            'X-11',
            sub {
                my $sid = shift;
                return if not defined $sid;
                <[protocol-7.route-send]>->(
                    {   'command'   => "$sid.move-window",
                        'call_args' => { 'args' => "$winid $x $y" },
                        'reply'     => {
                            'handler' =>
                                qw| screen.setup.handler.move_reply |,
                            'params' => { 'id' => $id, 'winid' => $winid }
                        }
                    }
                );
            }
        );
    }

    return TRUE;
}

## only persist if this release ends a border drag we started ##
return TRUE if not $inst->{'dragging'};
$inst->{'dragging'} = FALSE;

my $caller = $inst->{'caller'};
return TRUE if not defined $caller or not length $caller;

## read the real geometry the compositor settled on after the grab ##
my ( $x, $y ) = $widget->get_position;
my ( $w, $h ) = $widget->get_size;

return TRUE
    if not defined $x
    or not defined $y
    or not defined $w
    or not defined $h;

<[base.logs]>->(
    1,  '[screen-setup.button_release] saving position x=%d y=%d w=%d h=%d',
    $x, $y, $w, $h
);

<[window.profile.save]>->( $caller, $x, $y, $w, $h );

return TRUE;

