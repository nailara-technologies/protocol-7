## [:< ##

# name  = graphics-matrix.glow.query
# descr = return glow intensity at a specific hop distance

my $hop = shift // 0;
$hop = int($hop);

my $glow = $data{'graphics-matrix'}{'glow'};

## return intensity value for this shell ##
return $glow->{'shells'}{$hop}{'intensity'} // 0.0;

