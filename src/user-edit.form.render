## [:< ##

# name  = user-edit.form.render
# descr = render the active user-edit form to the terminal

## doubles as the base.event.add_var watcher handler for
## <user-edit.form.dirty> [ see user-edit.handler.value_get_reply ] : both a
## keystroke edit and an async out-of-band field update just bump that
## counter, and this module is what turns either into an actual redraw.
##
## it must never write <user-edit.form.dirty> itself — base.event.add_var
## registers reentrant watchers by default, so a write from inside the handler
## would re-fire it immediately.

my $editor_state = <user-edit.form.state>;

return FALSE if ref $editor_state ne qw| HASH |;

my $frame_name = <user-edit.form.frame_name> // qw| user-edit-form |;

## the frame is generated in memory, and ascii.frame.init_code wipes that ##
## cache on every source reload — regenerate rather than render nothing   ##
if ( not exists <ascii.frame.cache>->{$frame_name} ) {
    <[user-edit.form.build_frame]>->(
        $editor_state, $frame_name, <user-edit.form.title>
    );
}

## SOH placeholder for the cursor : one character wide so render_form's width
## and fill maths stay exact, substituted for a coloured '|' after
## colourisation below [ an ansi sequence passed in directly would break row
## alignment ]  one-character placeholders, substituted for coloured glyphs
## after colourisation below.  they must be single characters : render_form's
## width and fill maths measure them with length(), so passing ansi directly
## would break row alignment
my $rendered = <[editor.ui.ascii_frame.render_form]>->(
    $editor_state,
    $frame_name,
    undef,
    {   qw| cursor |  => qq|\x01|,
        qw| focus_l | => qq|\x02|,
        qw| focus_r | => qq|\x03|,
    }
);

if ( not defined $rendered ) {
    <[base.logs]>->( 0, ': form render failed [ %s ]', $frame_name );
    return FALSE;
}

my @frame_lines = split m|\n|, $rendered;

## filled in below when the hint applies ; substituted back in AFTER
## colourisation [ see the \x06 sentinel note below it ], so this starts empty
## and the later substitution is a harmless no-op on every other paint
my $hint_row_colored = '';

my $total_lines    = scalar @frame_lines;
my $scroll_top     = 0;
my $bottom_visible = TRUE;

## interactive mode on a real terminal : vertical viewport so a tall form
## never exceeds the screen and the active field always stays visible.
## one-shot and -no-tty modes render the whole frame unchanged.
if ( <user-edit.form.interactive> and not <user-edit.mode.no_tty_debug> ) {

    ## lines reserved below the frame for the cmd-list hint block ; 0 when the
    ## discovery hint is used instead (that hint lives inside the frame
    ## border)
    my $hint_lines = 0;
    if (<user-edit.form.help_visible>) {
        my $in_menu
            = ( $editor_state->{'mode'} // '' ) =~ m|^menu:| ? TRUE : FALSE;
        my $hint_count = $in_menu ? 3 : 5;
        $hint_lines = $hint_count + 2;    ## blank + hints + blank ##
    }

    my $term_rows = <user-edit.form.term_rows> // (
        eval {
            <[base.perlmod.load]>->('AMOS7::TERM')
                if not <[base.perlmod.loaded]>->('AMOS7::TERM');
            ( AMOS7::TERM::terminal_size() )[1];
        } // 24
    );
    $term_rows = 10 if $term_rows < 10;

    my $budget = $term_rows - $hint_lines;
    $budget = 5 if $budget < 5;

    if ( $total_lines > $budget ) {

        ## find which rendered lines belong to the active field by walking the
        ## frame descriptor's slots. a slot belongs to the active field when
        ## its name equals the field name or starts with '<name>_' -- this
        ## covers multiline synthetic rows (<name>_0.._N), expanded list rows
        ## and the list_info row, detail checksum rows, etc.
        my $entry      = <[ascii.frame.load]>->($frame_name);
        my $descriptor = $entry->{'descriptor'}          // {};
        my $slots      = $descriptor->{'slots'}          // {};
        my $tpad       = $descriptor->{'padding'}{'top'} // 0;

        my $active_index = $editor_state->{'active_field'} // 0;
        my $active_name
            = $editor_state->{'schema'}{'fields'}[$active_index]{'name'}
            // '';

        my ( $active_start, $active_end );
        foreach my $slot_name ( keys %{$slots} ) {
            next
                unless $slot_name eq $active_name
                || ( length $active_name
                && $slot_name =~ m|^\Q$active_name\E_| );

            my $row = $slots->{$slot_name}{'row'} // 0;
            next unless $row > 0;

            ## 0-based index in @frame_lines ##
            my $line_idx = $tpad + $row;
            $active_start = $line_idx
                if not defined $active_start
                or $line_idx < $active_start;
            $active_end = $line_idx
                if not defined $active_end
                or $line_idx > $active_end;
        }

        $scroll_top = <user-edit.form.scroll_top> // 0;

        ## keep the active field inside the viewport ; if the field range was
        ## not found (should not happen), keep the existing scroll_top
        if ( defined $active_start and defined $active_end ) {
            if ( $active_end >= $scroll_top + $budget ) {
                $scroll_top = $active_end - $budget + 1;
            }
            if ( $active_start < $scroll_top ) {
                $scroll_top = $active_start;
            }
        }

        $scroll_top = 0 if $scroll_top < 0;
        $scroll_top = $total_lines - $budget
            if $scroll_top > $total_lines - $budget;

        <user-edit.form.scroll_top> = $scroll_top;

        my $end_idx = $scroll_top + $budget - 1;
        $end_idx = $#frame_lines if $end_idx > $#frame_lines;

        ## when the title/header has scrolled out of view, keep one empty
        ## content row as top padding so the first visible field does not sit
        ## flush against the terminal top edge
        my $top_pad_line = '';
        if (    $scroll_top > 0
            and defined $frame_lines[1]
            and $frame_lines[1] =~ m|^\s*:\s+:\s*$| ) {
            $top_pad_line = $frame_lines[1];
            $end_idx-- if $end_idx > $scroll_top;
        }

        @frame_lines = @frame_lines[ $scroll_top .. $end_idx ];
        unshift @frame_lines, $top_pad_line if length $top_pad_line;

        $bottom_visible = FALSE;

    } else {
        <user-edit.form.scroll_top> = 0;
    }
}

## the discovery hint REPLACES the card's own closing border row rather than
## adding a line below it -- two dotted rows in a column read as a doubled
## border, not as one border carrying a message.  done here, on the PLAIN
## render, before colourisation, so length() on plain text is what keeps the
## substitution at the card's own width with no separate reservation needed
## anywhere in user-edit.form.build_frame
##
## when a vertical viewport is active, the hint only appears if the bottom
## border is actually visible in the current slice
if (    $bottom_visible
    and <user-edit.form.interactive>
    and not <user-edit.form.help_visible>
    and not <user-edit.form.hint_seen> ) {

    my ($margin) = ( $frame_lines[-1] // '' ) =~ m|^( *):|;
    $margin //= '';
    my $frame_width = length( $frame_lines[-1] // '' );
    my $inner_width = $frame_width - length($margin) - 2;
    $inner_width = 0 if $inner_width < 0;

    ## hand-spaced to match the mockup exactly [ per user ] rather than a
    ## generated per-character rule : the leading dot echoes the border's own
    ## fill rhythm right after the ':', and 'ctrl-?' keeps its hyphen and '?'
    ## glued to the 'l' instead of dot-separated -- it reads as one glyph for
    ## the key combo -- while every other character, including the ':' that
    ## follows, gets its own trailing dot.  a real space between words gets
    ## TWO dots, so the gap still reads as a gap
    my $spaced = q{.c.t.r.l-?.:.t.o.g.g.l.e..c.m.d..l.i.s.t};

    $spaced = substr( $spaced, 0, $inner_width )
        if length($spaced) > $inner_width;
    $spaced .= q{.} x ( $inner_width - length($spaced) );

    ## coloured HERE, by hand, rather than left to the shared colouriser below
    ## : that classifier decides border-vs-content by DOT DENSITY across the
    ## whole line, which a letter-heavy message can tip either way depending
    ## on how much of the frame it fills, and even on the border path
    ## border_line has no case for a bare LETTER inside a fill run -- it
    ## passes those through with no colour at all, which is what showed up as
    ## plain white text.  matches cfg/ascii-frame's own fill.single / fill.dot
    ## mapping, so it reads as the same border tone as every other ':' and '.'
    ## on the card
    my $colon_color = length $colors{'reset'} ? $colors{'p7_fg_0000'} : '';
    my $fill_color  = length $colors{'reset'} ? $colors{'p7_fg_0001'} : '';
    my $reset_color = $colors{'reset'} // '';

    $hint_row_colored
        = $margin
        . $colon_color . q{:}
        . $reset_color
        . $fill_color
        . $spaced
        . $reset_color
        . $colon_color . q{:}
        . $reset_color;

    ## \x06 : an otherwise-unused single byte standing in for the finished row
    ## above.  a length-1 line survives ascii.frame.render.color.
    ## content_line completely untouched -- its first/last/body slicing all
    ## degrade to returning that one raw character when length <= 1 -- so
    ## nothing the classifier does needs undoing after the substitution below
    $frame_lines[-1] = "\x06";
}

$rendered = join( "\n", @frame_lines );

## colourise by character class through the shared frame colouriser --
## config-driven from cfg/ascii-frame [ purple structure, TRUE blue slot
## values ], the same call memory.render.term and  context.provider.frame
## already use
$rendered = <[ascii.frame.render.color]>->($rendered) // $rendered;

$rendered =~ s{\x06}{$hint_row_colored}ge;

## which field the cursor sits in -- active_field is an INDEX into the
## schema's field list, the same resolution render_form does internally
my $active_index = $editor_state->{'active_field'} // 0;
my $active_name  = $editor_state->{'schema'}{'fields'}[$active_index]{'name'}
    // '';

## restore the character the marker overlaid, in nshell.render.cursor's two
## forms : a real character comes back in INVERSE VIDEO so it stays readable,
## and an empty cell [ cursor past the end, or sitting on a space ] becomes a
## phosphor green underscore.  both are exactly one column wide, so the row
## keeps the width ascii.frame.render computed
##
## a PLUGIN field's raw-buffer cursor offset has no relationship to its own
## restructured display text [ get_display_value returns the plugin's OWN
## rendering, not the stored value -- see editor.ui.ascii_frame.render_form's
## cursor_bearing note on why that field never gets the generic \x01 overlay
## at all ], so substr() against $active_value/$active_cursor below would be
## meaningless for one. a plugin field that wants this same styling exposes
## '<plugin>.cursor_char' instead [ e.g. plugin.user-edit.address-cluster.
## cursor_char ] -- given the same $editor_state/$active_name pair, it returns
## just the character ITS OWN cursor sits on. absent that sub, a plugin field
## gets no styling here at all, same as before this existed
my $active_plugin = <user-edit.plugin.registry> {'by_key'}{$active_name};
my $plugin_cursor_char_sub
    = defined $active_plugin
    ? sprintf( qw| %s.cursor_char |, $active_plugin )
    : undef;

my $cursor_char;
if ( defined $plugin_cursor_char_sub
    and exists $code{$plugin_cursor_char_sub} ) {

    $cursor_char
        = $code{$plugin_cursor_char_sub}->( $editor_state, $active_name )
        // '';

} else {

    my $active_value
        = <[editor.control.get_display_value]>
        ->( $editor_state, $active_name ) // '';
    my $active_cursor
        = <[editor.control.get_display_cursor]>
        ->( $editor_state, $active_name ) // 0;

    $cursor_char
        = $active_cursor < length $active_value
        ? substr( $active_value, $active_cursor, 1 )
        : '';
}

## a MULTILINE field's cursor can legitimately sit right before an embedded
## '\n' [ end of any line but the last ] -- substr would then hand back the
## newline itself, and every branch below would splice that raw byte straight
## into an ansi-colored render, corrupting this row's alignment exactly like
## an un-windowed '\n' reaching a slot does [  user-edit-multiline-note.yaml
## ].  treated the same as "nothing here" -- same as $cursor_char already
## being empty
$cursor_char = '' if $cursor_char eq "\n";

## THREE cases, not two.  '-nc' blanks the COLOUR palette but is not a request
## for plain text -- bin/Protocol-7 keeps clear_screen as a real escape in
## that same branch -- and inverse video is an ATTRIBUTE, not a colour, so it
## stays available and keeps the cursor visible.  only a non-terminal STDOUT
## must be free of escapes entirely
my $on_terminal = -t STDOUT ? TRUE : FALSE;

my $cursor_render;
if ( not $on_terminal ) {
    ## piped : show the CHARACTER, i.e. no cursor at all.  nothing is
    ## navigating a captured render, so a cursor marks nothing -- while
    ## overlaying it silently CORRUPTS the value, which is what a capture is
    ## actually for.  the reserved cell shows as a space when the cursor sits
    ## past the end
    $cursor_render = length $cursor_char ? $cursor_char : q{ };
} elsif ( not length $colors{'reset'} ) {
    ## -nc : no colour, but inverse video still marks the position and keeps
    ## the character underneath readable
    $cursor_render
        = length $cursor_char && $cursor_char ne q{ }
        ? "\e[7m" . $cursor_char . "\e[27m"
        : q{_};
} elsif ( not length $cursor_char or $cursor_char eq q{ } ) {
    $cursor_render = $colors{'p7_fg_0003'} . q{_} . $colors{'p7_fg_0004'};
} else {
    ## \e[7m / \e[27m : inverse video on and off, zero columns each ##
    $cursor_render
        = "\e[7m" . $cursor_char . "\e[27m" . $colors{'p7_fg_0004'};
}

$rendered =~ s{\x01}{$cursor_render}ge;

## focus brackets in the DARKER structural tone, so they read as framing
## rather than as part of the payload text -- then back to the content colour
## for the value between them
my $bracket_color = length $colors{'reset'} ? $colors{'p7_fg_0001'} : '';
my $content_color = length $colors{'reset'} ? $colors{'p7_fg_0004'} : '';

$rendered =~ s{\x02}{$bracket_color . q{[} . $content_color}ge;
$rendered =~ s{\x03}{$bracket_color . q{]} . $content_color}ge;

## title : the 'user-edit : ' part is framing, the username is payload, so
## only the username keeps the content colour.  substituting ANSI into the
## already-colourised label costs ZERO columns, so the border width is
## untouched -- the label is contiguous in the colourised output, with no ansi
## inside it, which is what makes a literal match safe here
if ( length $colors{'reset'} ) {

    my $title    = <user-edit.form.title>    // '';
    my $username = <user-edit.form.username> // '';

    ( my $title_prefix = $title ) =~ s|\Q$username\E$||
        if length $username;

    $rendered =~ s{\Q$title_prefix\E\Q$username\E}
        {$bracket_color . $title_prefix . $content_color . $username}e
        if length $title_prefix;
}

## interactive mode owns the whole screen ; the one-shot render just adds the
## frame to whatever is already on the terminal  $colors{'clear_screen'}
## rather than a literal : it survives the -nc palette blanking, which is
## exactly where a hardcoded escape would have been inconsistent with the rest
## of this module
print $colors{'clear_screen'} // '' if <user-edit.form.interactive>;

## leading reset is not cosmetic : bin/Protocol-7 leaves STDERR set to
## p7_fg_0002 [ amber ], and without this the whole frame inherits it.
## $colors{'reset'}, NOT a literal "\e[0m" : bin/Protocol-7 blanks the whole
## palette when output is piped, and a hardcoded sequence would put escape
## codes into a pipe that deliberately asked for none
##
## interactive mode : no leading newline -- clear_screen already homes the
## cursor, and a viewport-sliced frame must start at the top-left to fill the
## terminal exactly. the trailing newline is only emitted when the help block
## is visible, because a bare newline after a frame that already fills the
## screen scrolls the top line and produces the one-line flicker/jump.
## one-shot mode keeps the original framing newlines.
if (<user-edit.form.interactive>) {
    print $colors{'reset'}
        . $rendered
        . $colors{'reset'}
        . ( <user-edit.form.help_visible> ? "\n" : '' );
} else {
    print $colors{'reset'} . "\n" . $rendered . $colors{'reset'} . "\n";
}

if (<user-edit.form.interactive>) {
    ## multi-line under the card, on the same ':' gutter the frame border
    ## uses, so the hint reads as part of the same object -- one line ran to
    ## roughly twice the card's width and overhung it badly.  keys in the dim
    ## structural tone, actions in content blue, aligned on a separator
    my $gutter = $colors{'p7_fg_0000'} // '';
    my $key    = $colors{'p7_fg_0001'} // '';
    my $action = $colors{'p7_fg_0001'} // '';
    my $done   = $colors{'reset'}      // '';

    ## the full cmd-list block is HIDDEN by default -- per user, it crowds a
    ## card that is otherwise just a handful of fields.  ctrl-? [
    ## user-edit.handler.stdin_key ] toggles it back on ; until either that
    ## happens or the block is showing, a one-line discovery hint stands in
    ## for it, shown exactly once per opened card [ hint_seen reset in
    ## user-edit.handler.value_get_reply, set on the first key of the card ]
    if (<user-edit.form.help_visible>) {

        ## the hint describes what the CURRENT mode does : a menu selects and
        ## descends, a form edits and submits -- offering 'submit' over a
        ## read-only row list would simply be wrong
        my $in_menu
            = ( $editor_state->{'mode'} // '' ) =~ m|^menu:| ? TRUE : FALSE;

        ## q{} not qw| | : these contain a '/' and a space, and a '|' here
        ## would terminate the qw delimiter early
        my @hints
            = $in_menu
            ? (
            [ q{arrows},       q{select} ],
            [ q{enter},        q{open} ],
            [ q{esc / ctrl-c}, q{back} ]
            )
            : (
            [ q{tab / arrows}, q{field} ],
            [ q{del},          q{drop empty field} ],
            [ q{enter},        q{submit} ],
            [ q{esc / ctrl-c}, q{quit} ],
            [ q{ctrl-?},       q{hide cmd list} ]
            );

        foreach my $hint (@hints) {
            printf " %s:%s  %-13s%s\x{b7}%s  %s%s\n",
                $gutter, $key, $hint->[0], $gutter, $action, $hint->[1],
                $done;
        }

        print "\n";
    }

    ## no elsif / discovery-hint branch here any more : that hint is now
    ## spliced into the card's own closing border row above, before
    ## colourisation, instead of being a separate line printed down here --
    ## see the block right after render_form's call
}

STDOUT->flush();

return TRUE;

