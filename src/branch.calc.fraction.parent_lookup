# name  = branch.calc.fraction.parent_lookup
# descr = map period string to known P7 group name
# param = period_string
#
# return undef if period not in known set

my ($period_str) = @ARG;

return undef
    if not defined $period_str
    or not length $period_str;

my $yaml_path = 'data/yaml/harmonic/fraction-period-groups.yaml';
my $yaml_data = <[format.yaml.load_file]>->($yaml_path);

return undef if not defined $yaml_data;

my $periods = $yaml_data->{'periods'} // {};
return $periods->{$period_str}{'group'} // undef;

