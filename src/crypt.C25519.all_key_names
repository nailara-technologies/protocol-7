# name  = crypt.C25519.all_key_names

my %keynames;

foreach my $file (<[crypt.C25519.keyfiles]>) {
    ## skip TOFU pinned hostkey files (remote-host.*.public) - handled ##
    ## separately in list_remote_keys                                  ##
    next if $file =~ m|remote-host\.[0-9a-z\.\-_]+\.public$|;

    my $name = <[crypt.C25519.get_keyname]>->($file);
    ##  unrecognized key file, already warned  ##
    next unless defined $name;
    next if exists $keynames{$name};
    $keynames{$name}++;
}

return <[base.sort]>->( \%keynames );

