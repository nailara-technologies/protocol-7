## [:< ##

# name  = plugin.user-edit.example.handler.key
# descr = minimal reference plugin's key handling -- verifies the entered-mode dispatch
# param = $editor_state, $field, $key

## THROWAWAY / reference only -- see plugin.user-edit.example.init_code's own
## note.  deliberately trivial : printable characters append to the end of the
## stored value, Backspace/Delete drop the last character.  proves
## user-edit.handler.stdin_key's plugin-mode short-circuit really does hand
## full key control to the plugin [ readonly on the field def would block this
## via editor.control.process_key's own guard -- this bypasses that guard
## entirely by calling editor.control.commands.* directly, exactly as designed
## ], not a real editing UI.

my ( $editor_state, $field, $key ) = @ARG;

my $buffer = $editor_state->{'fields'}{$field} // return undef;
my $len    = <[editor.buffer.memory.length]>->($buffer);

if ( $key eq "\x08" or $key eq "\x7f" ) {    ## backspace ##
    <[editor.control.commands.delete]>->(
        $editor_state, $field, $len - 1, $len
    ) if $len > 0;
    return TRUE;
}

if ( length $key and ord( substr( $key, 0, 1 ) ) >= 32 ) {    ## printable ##
    <[editor.control.commands.insert]>->( $editor_state, $field, $len, $key );
    return TRUE;
}

return FALSE;

