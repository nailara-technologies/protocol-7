## [:< ##

# name  = coding.validate.module
# descr = validate P7 module for common errors and format issues

my $module = shift // '';

return { 'mode' => qw| false |, 'data' => 'module name required' }
    unless length $module;

my @errors;
my @warnings;

## 1. Check module file exists ##
my $module_path = catfile( <system.code_path>, $module );

if ( !-f $module_path ) {
    push @errors, "module file not found: $module_path";
    return { 'mode' => qw| false |, 'errors' => \@errors };
}

my $content = <[file.read]>->($module_path);

## 2. Header format check ##
if ( $content !~ m|^## \[:< ##|m ) {
    push @errors, "missing or invalid header format [ expected '## [:< ##' ]";
}

## 3. Metadata fields ##
if ( $content !~ m|^# name\s+=\s+(.+)$|m ) {
    push @errors, "missing or invalid metadata field 'name'";
} elsif ( $1 ne $module ) {
    push @warnings, "metadata name '$1' doesn't match module '$module'";
}

if ( $content !~ m|^# descr\s+=\s+(.+)$|m ) {
    push @errors, "missing or invalid metadata field 'descr'";
}

## 4-6, 8. structural idiom checks : DELEGATED to coding.idiom.scan.       ##
##                                                                         ##
## these were four hand-rolled regexes [ sub {} declarations, bracket      ##
## syntax, base.log vs base.logs, 1/0 vs TRUE/FALSE ]. they now come from  ##
## data/idioms/rules.yaml so there is ONE rule table instead of two that   ##
## drift apart -- the same table the write-tool boundary and the async     ##
## completion path use, and the same one calibrated against all 5462 src/  ##
## files [ data/idioms/offline_check.py ].                                 ##
##                                                                         ##
## the old bracket check flagged a bare `<[module.name]>` as an error, but ##
## that form is LEGAL -- bin/Protocol-7's parser expands it with an        ##
## implicit ->() when no args are passed. the calibrated rule only flags   ##
## `<[name]>(`, which really is malformed.                                 ##
if ( exists $code{'coding.idiom.scan'} ) {
    my $scan = <[coding.idiom.scan]>->( { 'text' => $content } );

    if ( ref $scan eq qw| HASH | and $scan->{'mode'} eq qw| true | ) {

        my %seen;
        foreach my $violation ( $scan->{'data'}{'violations'}->@* ) {

            ## one line per rule, with a count -- not one per occurrence ##
            $seen{ $violation->{'id'} }{'count'}++;
            $seen{ $violation->{'id'} }{'class'} = $violation->{'class'};
            $seen{ $violation->{'id'} }{'line'} //= $violation->{'line'};
        }

        foreach my $id ( sort keys %seen ) {
            my $hit = $seen{$id};
            my $msg = sprintf(
                '%s : %d occurrence%s [ first at line %d ]',
                $id, $hit->{'count'}, ( $hit->{'count'} == 1 ? '' : 's' ),
                $hit->{'line'}
            );

            ## auto and gate are real problems ; report-class rules are   ##
            ## conventions the codebase itself does not keep consistently ##
            ## and must not fail a validation                             ##
            if ( $hit->{'class'} eq qw| report | ) {
                push @warnings, $msg;
            } else {
                push @errors, $msg;
            }
        }
    }
}

## 7. Check qw syntax [ should use || not () or // ] ##
if ( $content =~ m|\bqw\s*\(| || $content =~ m|\bqw\s*/| ) {
    push @warnings,
        "qw should use pipe delimiters: qw| word | not qw() or qw//";
}

## 8. [ moved into the coding.idiom.scan delegation above -- the bare      ##
## `return 1;` / `return 0;` shape is explicitly NOT flagged there : it    ##
## occurs 34 times in real committed src/coding.* as a handler-final truth ##
## value, and warning on it was noise ]                                    ##

## 9. Check return format ##
if (   $content =~ m|\breturn\s*\{\s*['"]mode['"]\s*=>|i
    || $content =~ m|\breturn\s*\{\s*mode\s*=>| ) {
    if ( $content !~ m|return\s*\{\s*mode\s*=>\s*qw\|| ) {
        push @warnings,
            "return format should use: { 'mode' "
            . "=> qw| true |, 'data' => ... }";
    }
}

## 10. Check signature footer present ##
if ( $content !~ m|#,,\.,.*,,| ) {
    push @errors, "missing signature footer";
}

## 11. Check whitelist registration ##
my $zenka_name     = <system.zenka.name> // 'unknown';
my $whitelist_path = catfile( <system.conf_path>, qw| zenki |,
    $zenka_name, 'subroutines.load-early' );

if ( -f $whitelist_path ) {
    my $wl_content = <[file.read]>->($whitelist_path);
    if ( $wl_content !~ m|^$module$|m ) {
        push @warnings, "module not found in subroutine whitelist";
    }
}

## 12. Syntax check with ptd [ if available ] ##
my $ptd_bin = catfile( <system.root_path>, qw| bin ptd | );
if ( -x $ptd_bin ) {
    my $check_result = qx|$ptd_bin -c "$module_path" 2>&1|;
    if ( $? != 0 ) {
        chomp $check_result;
        push @errors, "ptd syntax check failed: $check_result";
    }
}

## Build result ##
my $result = {
    'module'   => $module,
    'path'     => $module_path,
    'valid'    => ( @errors ? 0 : 1 ),
    'errors'   => \@errors,
    'warnings' => \@warnings,
    'summary'  => sprintf(
        "%s: %d errors, %d warnings",
        $module, scalar(@errors), scalar(@warnings)
    ),
};

return {
    'mode' => $result->{'valid'} ? qw| true | : qw| false |,
    'data' => $result,
};

