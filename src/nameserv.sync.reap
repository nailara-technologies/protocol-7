## [:< ##

# name  = nameserv.sync.reap
# descr = close idle sync connections [ waiting conns exempt ]

my $idle = <nameserv.cfg.sync.idle_timeout> // 390;    ## seconds ##

my $conns = <nameserv.sync.conns> // return TRUE;
my $now   = time;

for my $conn ( values %$conns ) {
    ## holding next-data-timestamp ##
    next if ref $conn->{'wait'} eq qw| HASH |;
    next if $now - ( $conn->{'last_active'} // $now ) < $idle;
    <[base.logs]>->(
        2,
        ': sync connection idle timeout [ %s ]',
        $conn->{'peer'} // 'unknown'
    );
    <[nameserv.sync.conn.close]>->($conn);
}

return TRUE;

