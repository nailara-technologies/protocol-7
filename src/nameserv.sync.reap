## [:< ##

# name  = nameserv.sync.reap
# descr = close idle sync connections [ waits after 2 holds ]

my $idle = <nameserv.cfg.sync.idle_timeout> // 390;    ## seconds ##

my $conns = <nameserv.sync.conns> // return TRUE;
my $now   = time;

for my $conn ( values %$conns ) {
    ## holding next-data-timestamp : the peer re-arms after max_hold, a ##
    ## wait held twice as long has no live peer behind it [ half-open ] ##
    if ( ref $conn->{'wait'} eq qw| HASH | ) {
        my $max_wait = 2 * ( <nameserv.cfg.sync.max_hold> // 390 );
        next if $now - ( $conn->{'wait'}->{'started'} // $now ) < $max_wait;
        <[base.logs]>->(
            2,         ': sync wait held over %d s, closed [ %s ]',
            $max_wait, $conn->{'peer'} // 'unknown'
        );
        <[nameserv.sync.conn.close]>->($conn);
        next;
    }
    next if $now - ( $conn->{'last_active'} // $now ) < $idle;
    <[base.logs]>->(
        2,
        ': sync connection idle timeout [ %s ]',
        $conn->{'peer'} // 'unknown'
    );
    <[nameserv.sync.conn.close]>->($conn);
}

return TRUE;

