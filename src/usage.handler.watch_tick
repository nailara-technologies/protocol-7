## [:< ##

# name   = usage.handler.watch_tick
# descr  = periodic usage read : thresholds and reset times
#
# a timer handler gets the event. every loaded provider is read [ quietly,
# no waiting command ] on the usage-watch rhythm ; the numbers go through
# usage.watch.observe like any other fetch

my @providers = <[usage.provider_list]>;
<[usage.query]>->( \@providers, '', qw| compact | ) if @providers;
<usage.watch.tick_state> //= {};
my $delay
    = <[base.interval.next]>
    ->( { 'type' => qw| usage-watch |, 'state' => <usage.watch.tick_state> } )
    // 900;
<usage.watch.tick_timer> = <[event.add_timer]>->(
    {   'after'   => $delay,
        'handler' => qw| usage.handler.watch_tick |,
        'data'    => {}
    }
);
return TRUE;

