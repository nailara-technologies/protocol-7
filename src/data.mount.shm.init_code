## [:< ##

# name  = data.mount.shm.init_code
# descr = Initialize SHM mounting subsystem for data zenka
#         Registers autoload hooks and initializes namespaces

<[base.log]>->( 2, "initializing SHM mounting subsystem" );

##[ AUTOLOAD PERL MODULES ]###################################################

# Load required Perl modules via base.perlmod.autoload
# Note: IO::AIO and BSD::Resource already loaded by base.init_code
# Note: Using file-based SHM in /dev/shm (tmpfs) - no POSIX::shm_open needed

<[base.perlmod.autoload]>->('Sys::Mmap')
    unless exists $INC{'Sys/Mmap.pm'};

## standalone-loadable core : mmap / header / permission mechanics [ same ##
## hybrid precedent as AMOS7::CHKSUM ; wrappers call into it ]            ##
<[base.perlmod.autoload]>->('AMOS7::SHM')
    unless exists $INC{'AMOS7/SHM.pm'};

## paging layer : pure computation over an already-created AMOS7::SHM ##
## segment, no zenka/standalone branching of its own                  ##
<[base.perlmod.autoload]>->('AMOS7::SHM::Page')
    unless exists $INC{'AMOS7/SHM/Page.pm'};

## feedback layer : reverse-flow single-writer region + native fifo notify, ##
## same branch-free-mechanics style as the page layer                       ##
<[base.perlmod.autoload]>->('AMOS7::SHM::Feedback')
    unless exists $INC{'AMOS7/SHM/Feedback.pm'};

## inject the zenka log handler into the package logging shim ##
$AMOS7::SHM::log_handler = sub { <[base.log]>->( $ARG[0], $ARG[1] ) };

##[ NAMESPACE INITIALIZATION ]################################################

# SHM mount registry
<mount.shm.segments>    //= {};    # Active mounts by path
<mount.shm.by_pubkey>   //= {};    # Index by owner pubkey
<mount.shm.groups>      //= {};    # Group definitions
<mount.shm.permissions> //= {};    # Cached permission lookups

# Statistics
<mount.shm.stats.created>  //= 0;
<mount.shm.stats.opened>   //= 0;
<mount.shm.stats.locked>   //= 0;
<mount.shm.stats.rejected> //= 0;

##[ CONSTANTS ]###############################################################

<mount.shm.const.header_size>     //= 512;
<mount.shm.const.default_size>    //= 63 * 1024;    # 63K
<mount.shm.const.max_permissions> //= 16;
<mount.shm.const.magic>           //= 'P7SH';

##[ LOCKING BACKEND DETECTION ]###############################################

# Detect available memory locking mechanisms
<mount.shm.capabilities.mlock> = 0;

if ( eval { require IO::AIO } ) {
    <mount.shm.capabilities.mlock>         = 1;
    <mount.shm.capabilities.mlock_backend> = 'IO::AIO';
} elsif ( eval { require BSD::Resource } ) {
    <mount.shm.capabilities.mlock>         = 1;
    <mount.shm.capabilities.mlock_backend> = 'BSD::Resource';
} else {
    <mount.shm.capabilities.mlock_backend> = 'none';
}

# Detect mmap capabilities
<mount.shm.capabilities.mmap> = 0;
if ( eval { require Sys::Mmap } ) {
    <mount.shm.capabilities.mmap> = 1;
}

##[ POSIX SHM AVAILABILITY ]##################################################

<mount.shm.capabilities.posix_shm> = 0;
if ( eval { require POSIX } ) {

    # Check if shm_open is available
    if ( defined &POSIX::shm_open ) {
        <mount.shm.capabilities.posix_shm> = 1;
    }
}

##[ CLEANUP HANDLER ]#########################################################

## phase 4 : register a normal end_code callback rather than assigning      ##
## $SIG{'INT'}/$SIG{'TERM'} directly — direct assignment would clobber      ##
## base.sig_int / base.sig_term [ v7 teardown, cross-zenka shutdown notify, ##
## <system.kill_list> killing ]. end_code callbacks run on every exit path  ##
## via bin/Protocol-7's own END block regardless of how exit was reached,   ##
## same precedent as v7-zenki.setup_stdout_redir ->                         ##
## v7-zenki.stdout_log.close                                                ##
push <callbacks.end_code>->@*, qw| data.mount.shm.cleanup |;

<[base.log]>->( 2, "SHM mounting subsystem initialized" );

# Init codes must return 0 or 5 for success
return TRUE;

