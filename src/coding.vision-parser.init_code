## [:< ##

# name  = coding.vision-parser.init_code
# descr = initialize vision-text-extraction state machine and variable watchers

my $reinit = shift // TRUE;   ### provided by 'base.init_modules' [TRUE|FALSE]

# a reload re-runs init_code while a job may still be in-flight from     ##
# before it -- only seed fresh state on a genuine first init, never      ##
# stomp an already-initialized jobs/timers table                        ##
if ( not $reinit ) {
    <coding.vision-parser.state>  = 'pending';
    <coding.vision-parser.jobs>   = {};
    <coding.vision-parser.timers> = {};

    <[base.logs]>->( 1, '[vision-parser] state machine initialized' );
} else {
    <[base.logs]>->(
        1, '[vision-parser] reinit : keeping existing state machine'
    );
}

# cancel a surviving prior-load watcher before registering a fresh one -- ##
# on reinit the state='pending' seed above is skipped, but a stray later  ##
# write would otherwise still re-trigger every watcher stacked up across  ##
# past reloads; same precedent as coding.spawn_inference_server's watcher ##
# cleanup before respawn                                                  ##
my $prior_watcher = <coding.vision-parser.watcher.state>;
$prior_watcher->cancel()
    if defined $prior_watcher and $prior_watcher->is_active();

# Register variable watcher on state variable
# This watcher triggers state_transition handler whenever state is written to
<coding.vision-parser.watcher.state> = <[event.add_var]>->(
    {   'var' => \$data{'coding'}{'vision-parser'}{'state'},
        'poll'    => qw| w |,                         # Watch for writes
        'handler' => qw| coding.vision-parser.handler.state_transition |,
        'repeat'  => TRUE,                                     # Keep watching
        'data'    => undef,
        'desc'    => '[vision-parser] state machine watcher'
    }
);

<[base.logs]>->( 1, '[vision-parser] state transition watcher registered' );

return TRUE;

