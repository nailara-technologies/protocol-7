## [:< ##

# name  = nameserv.cmd.get-record
# descr = lookup a specific dns record

my $args_str = $call->{'args'} // '';

## parse args: name=<name> [type=<type>] [zone=<zone>]
## or positional: <name> [type] ; without a zone, search every zone
my %args;
if ( $args_str =~ m|=| ) {
    while ( $args_str =~ m|(\w+)=(\S+)|g ) {
        $args{$1} = $2;
    }
} else {
    my @parts = split m|\s+|, $args_str;
    $args{'name'} = $parts[0] if @parts;
    $args{'type'} = $parts[1] if @parts > 1;
}

my $rec_input = lc( $args{'name'} // '' );
my $rec_type  = uc( $args{'type'} // '' );
my $zone_arg  = lc( $args{'zone'} // '' );
$zone_arg =~ s{\.+$}{};

if ( not $rec_input ) {
    return {
        mode => 'false',
        data => 'usage: get-record name=<name> [type=<type>] [zone=<zone>]'
    };
}

my $zones = <nameserv.zones>;
return { mode => 'false', data => "zone not found: $zone_arg" }
    if length $zone_arg and not exists $zones->{$zone_arg};

my $rec_name;
if ( length $zone_arg ) {
    $rec_name = <[nameserv.name.normalize]>->( $zone_arg, $rec_input );
    return {
        mode => 'false',
        data => "record name outside zone $zone_arg: $rec_input"
        }
        if not defined $rec_name;
}

my @matches;
for my $zone_name ( length $zone_arg ? ($zone_arg) : sort keys %$zones ) {
    my $zone_rec_name
        = length $zone_arg
        ? $rec_name
        : <[nameserv.name.normalize]>->( $zone_name, $rec_input );
    next if not defined $zone_rec_name;
    my $zone = $zones->{$zone_name};
    for my $rec ( @{ $zone->{'records'} } ) {
        next if lc( $rec->{'name'} ) ne $zone_rec_name;
        next if $rec_type and $rec->{'type'} ne $rec_type;
        push @matches,
            sprintf( "%s %s %s (zone: %s)",
            $rec->{'name'}, $rec->{'type'}, $rec->{'value'}, $zone_name );
    }
}

if ( not @matches ) {
    return { mode => 'false', data => "no records found for: $rec_input" };
}

my $data_str = "records found:\n  " . join( "\n  ", @matches );
return { mode => 'size', data => $data_str };

