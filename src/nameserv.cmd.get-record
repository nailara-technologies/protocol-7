## [:< ##

# name  = nameserv.cmd.get-record
# descr = lookup a specific dns record

my $args_str = $call->{'args'} // '';

## parse args: name=<name> [type=<type>]
## or positional: <name> [type]
my %args;
if ( $args_str =~ m|=| ) {
    while ( $args_str =~ m|(\w+)=(\S+)|g ) {
        $args{$1} = $2;
    }
} else {
    my @parts = split m|\s+|, $args_str;
    $args{'name'} = $parts[0] if @parts;
    $args{'type'} = $parts[1] if @parts > 1;
}

my $rec_name = lc( $args{'name'} // '' );
my $rec_type = uc( $args{'type'} // '' );

if ( not $rec_name ) {
    return {
        mode => 'false',
        data => 'usage: get-record name=<name> [type=<type>]'
    };
}

my $zones = <nameserv.zones>;
my @matches;

for my $zone_name ( keys %$zones ) {
    my $zone = $zones->{$zone_name};
    for my $rec ( @{ $zone->{'records'} } ) {
        next if lc( $rec->{'name'} ) ne $rec_name;
        next if $rec_type and $rec->{'type'} ne $rec_type;
        push @matches,
            sprintf( "%s %s %s (zone: %s)",
            $rec->{'name'}, $rec->{'type'}, $rec->{'value'}, $zone_name );
    }
}

if ( not @matches ) {
    return { mode => 'false', data => "no records found for: $rec_name" };
}

my $data_str = "records found:\n  " . join( "\n  ", @matches );
return { mode => 'size', data => $data_str };

