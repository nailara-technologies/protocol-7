## [:< ##

# name  = cred-mesh.decrypt
# descr = decrypt a credential blob for a given slot using the key-holder child

my $slot = shift // '';
my $data = shift // '';

return undef unless length $slot and length $data;

return <[cred-mesh.key_holder.parent]>->( qw| DECRYPT |, $slot, $data );

