## [:< ##

# name  = base.stdio.transport.emit.disconnect
# param = $socket, $reason
# descr = disconnect a stdio socket and clean up

my ( $socket, $reason ) = @ARG;

my $conn = delete <stdio_transport.connections>->{$socket};
return if not defined $conn;

## [ synthesize scope-leave for unmatched scope-enters ] ##
for my $origin ( reverse $conn->{'scope_stack'}->@* ) {
    my $synth_rec = {
        qw| tag        | => qw| META |,
        qw| encoding   | => qw| nibble |,
        qw| header     | => {
            qw| subtype | => qw| scope-leave |,
            qw| origin  | => $origin,
        },
        qw| payload_sref | => \'',
    };
    $conn->{'on_record'}->( $synth_rec, $socket );
}

for my $wk (qw| read write error |) {
    my $w = $conn->{'watchers'}{$wk} // undef;
    $w->cancel if defined $w and $w->is_active;
}

eval { shutdown( $socket, 2 ) };
close($socket);

<[base.logs]>->(
    2,       'stdio transport disconnected [%s]: %s',
    $socket, $reason // 'unknown'
);

return;

