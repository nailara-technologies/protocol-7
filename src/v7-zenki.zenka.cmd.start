## [:< ##

# name  = v7-zenki.zenka.cmd.start
# param = <zenka-id|name> [ :ignore-disabled: ]
# descr = start a new zenka instance

my $zenka_id;
my $zenka_name;
my $zenka_subname;
my $env_override_key;
my $env_override_value;

my $call_params = shift // {};
my $zenka_param = $call_params->{'args'} // $call->{'args'} // '';

return { 'mode' => qw| false |, 'data' => 'zenka name or id expected' }
    if not length $zenka_param;

## optional caller-supplied env override tag :env:KEY=VALUE:  ( stripped
## before subname / iid parsing; trailing position is canonical )
if ( $zenka_param =~ s|\s*:env:([A-Z_][A-Z0-9_]*)=([^:]*):\s*|| ) {
    $env_override_key   = $1;
    $env_override_value = $2;
}

return {
    'mode' => qw| false |,
    'data' => sprintf( "env override key '%s' is not a valid identifier",
        $env_override_key )
    }
    if defined $env_override_key
    and $env_override_key !~ m|^[A-Z_][A-Z0-9_]*$|;

## ':ignore-disabled:' : start even when the profile excludes this zenka ##
my $ignore_disabled
    = $zenka_param =~ s{\s*:ignore-disabled:\s*}{ }g ? TRUE : FALSE;
$zenka_param =~ s{^\s+|\s+$}{}g;

return { 'mode' => qw| false |, 'data' => 'zenka name or id expected' }
    if not length $zenka_param;

my $recursion = $call_params->{'recursion'} // 0;
my $once      = $call_params->{'once'}      // 0;

## parenthesized : '//' binds tighter than '?:' [ a passed mode made the  ##
## whole expression truthy -> always 'implicit' ; harmless today, callers ##
## only pass 'implicit' ]                                                 ##
my $start_mode = $call->{'mode'}
    // ( $recursion ? qw| implicit | : qw| manual | );

if ( $zenka_param =~ <regex.base.iid> ) {
    $zenka_id   = $zenka_param;
    $zenka_name = <v7-zenki.zenka.setup>->{$zenka_id}->{'name'}
        if exists <v7-zenki.zenka.setup>->{$zenka_id};
    return {
        'mode' => qw| false |,
        'data' => "found no zenka with id $zenka_id"
        }
        if not defined $zenka_name;
} else {
    $zenka_name    = $zenka_param;
    $zenka_subname = $LAST_PAREN_MATCH if $zenka_name =~ s|\[([^\]]+)\]$||;
    my $sn_regex = <regex.base.subname>;
    ( my $chars = $zenka_subname // '' ) =~ s|$sn_regex||g;
    if ( length($chars) and length($chars) != length($zenka_subname) ) {
        return {
            'mode' => qw| false |,
            'data' => sprintf( 'not valid characters in zenka subname [ %s ]',
                $chars )
        };
    }
}

my $zenka_config = <v7-zenki.start_setup.zenki.config>->{$zenka_name};

if ( not defined $zenka_config ) {
    ## check if zenka directory exists but start.cfg is missing
    my $zenka_dir    = <system.conf_path> . "/zenki/$zenka_name";
    my $startup_file = "$zenka_dir/zenka.v7";

    if ( -d $zenka_dir and not -f $startup_file ) {
        my $root_path = <system.root_path>;
        ( my $startup_file_rel = $startup_file ) =~ s{^$root_path/*}{};
        map { <[base.logs]>->( 0, ': %s', $ARG ) }
            ( split( m{\n}s, <<~"EOL" ), '' );

        ::[ attempted to start '$zenka_name' zenka from 'v7-zenki' zenka ]:.

        . . not configured for v7 start-up . .

        . . required file 'start.cfg' not present
        .   :. $startup_file_rel
        . . . see 'p7c v7-zenki.list available' for zenki-examples

        EOL
        return {
            'mode' => qw| false |,
            'data' => sprintf(
                "zenka '%s' not configured for "
                    . "'v7-zenki'-managed start-up, see log-buffer.,",
                $zenka_name
            )
        };
    }

    return {
        'mode' => qw| false |,
        'data' =>
            sprintf( "zenka %s not found in start set-up ..,", $zenka_name )
    };
}

if ( defined $env_override_key ) {
    my $allowed_str = $zenka_config->{'env_override_allowed'} // '';
    my %allowed     = map { $ARG => 1 } split( m| +|, $allowed_str );
    if ( not exists $allowed{$env_override_key} ) {
        <[base.s_warn]>->(
            "env override '%s' not permitted for zenka '%s'",
            $env_override_key, $zenka_name
        );
        return {
            'mode' => qw| false |,
            'data' => sprintf(
                "env override '%s' not permitted for zenka '%s'",
                $env_override_key, $zenka_name
            )
        };
    }
}

## zenki.disabled : checked with the allow list below  ##
## [ one message, ':ignore-disabled:' overrides both ] ##

return {
    'mode' => qw| true |,
    'data' => sprintf( "zenka '%s' already running [ 'start-once' mode ]",
        $zenka_name )
    }
    if $once
    and ( defined $zenka_subname
    and <[v7-zenki.start_count]>->( $zenka_name . "[$zenka_subname]" )
    or not defined $zenka_subname
    and <[v7-zenki.start_count]>->($zenka_name) );

## check max concurrency (with exception for concurrent handover)
if ( exists $zenka_config->{'max_concurrency'}
    and <[v7-zenki.start_count]>->($zenka_name)
    >= $zenka_config->{'max_concurrency'} ) {
    ## allow one expansion slot for concurrent handover mode
    my $is_handover
        = ( defined $call->{'mode'}
            and $call->{'mode'} eq qw| concurrent-handover | );
    my $at_exact_limit
        = <[v7-zenki.start_count]>->($zenka_name)
        == $zenka_config->{'max_concurrency'};
    my $handover_already_active = defined $zenka_id
        ? grep {
        exists <v7-zenki.zenka.instance>->{$ARG}->{'handover_expansion'}
        } <[zenka.instance.get_ids]>->($zenka_id)->@*
        : 0;

    if ( $is_handover and $at_exact_limit and not $handover_already_active ) {
        <[base.logs]>->(
            2,           'allowing handover expansion slot for %s [max:%d]',
            $zenka_name, $zenka_config->{'max_concurrency'}
        );
        ## proceed with expansion slot
    } else {
        return {
            'mode' => qw| false |,
            'data' =>
                sprintf(
                "reached configured maximum concurrency for zenka '%s'",
                $zenka_name )
        };
    }
}

if ( defined $zenka_subname
    and exists $zenka_config->{'max_subname_concurrency'} ) {
    return {
        'mode' => qw| false |,
        'data' => sprintf(
            'maximum concurrency reached for %s[%s]',
            $zenka_name, $zenka_subname
        )
        }
        if <[v7-zenki.start_count]>
        ->( sprintf( '%s[%s]', $zenka_name, $zenka_subname ) )
        >= $zenka_config->{'max_subname_concurrency'};
}

return {
    'mode' => qw| false |,
    'data' => sprintf( "zenka '%s' was 'manually stopped'", $zenka_name )
    }
    if $start_mode eq qw| implicit |
    and exists <v7-zenki.zenka.manually_stopped>->{$zenka_name};

delete <v7-zenki.zenka.manually_stopped>->{$zenka_name}
    if $start_mode eq qw| manual |;

## the start profile decides for EVERY start                                ##
## [ by hand, start_once, as a dependency, notify_online :start: ] : a      ##
## zenka in zenki.disabled, or -- with an allow list                        ##
## [ zenki.on-demand, the -lowram profiles ] -- one that is neither enabled ##
## nor listed, is refused. ':ignore-disabled:' starts it anyway             ##
## [ deliberate, per call ; dependencies are checked on their own ]. a      ##
## mistake on the wrong host                                                ##
## [ dist-upgrade on a 1 GB server with the full zenki set ] is refused     ##
## instead of crashing the backend. exempt : a concurrent handover, which   ##
## replaces an instance already running.  was : only automatic starts were  ##
## checked [ start_once from a session, dependencies ] -- 'v7-zenki.start'  ##
## always started [ until 2026-10-15 ]                                      ##
if ( not $ignore_disabled
    and ( $call->{'mode'} // '' ) ne qw| concurrent-handover | ) {
    my $reason = <[zenka.profile_refusal]>->($zenka_name);
    if ( defined $reason ) {
        <[base.logs]>->(
            1,           ": zenka '%s' not started -- %s",
            $zenka_name, $reason
        );
        return {
            'mode' => qw| false |,
            'data' => sprintf(
                "zenka '%s' not started : %s -- ':ignore-disabled:' "
                    . 'starts it anyway',
                $zenka_name, $reason
            )
        };
    }
}

<[base.logs]>->( "starting zenka '%s' .,", $zenka_name ) if not $recursion;

my $a_dep_str = <[zenka.get_dependencies]>->($zenka_name);
my @dependencies
    = defined $a_dep_str
    ? split( m| +|, $a_dep_str )
    : ();
foreach my $dep_name (@dependencies) {
    delete <v7-zenki.zenka.manually_stopped>->{$dep_name}
        and <[base.logs]>->(
        1, ': %s-zenka .: reset manually stopped status', $dep_name
        )
        if exists <v7-zenki.zenka.manually_stopped>->{$dep_name}
        and $start_mode eq qw| manual |;  ## <-- forced dependency start-up .,

    next
        if exists <v7-zenki.zenka.manually_stopped>->{$dep_name}
        ;                                 # .. or skipped.

    if ( !<[zenka.is_enabled]>->($dep_name) ) {
        <[base.logs]>->( ":. zenka enabled by dependency [ %s ]", $dep_name );

        my $start_name_str = $dep_name;

        $start_name_str .= sprintf( '[%s]', $zenka_subname )
            if defined $zenka_subname
            and defined <v7-zenki.start_setup.zenki.config>
            ->{$dep_name}->{'inherit_subname'}
            and <v7-zenki.start_setup.zenki.config>
            ->{$dep_name}->{'inherit_subname'};

        my $reply = <[zenka.cmd.start_once]>->(
            { 'args' => $start_name_str, 'recursion' => $recursion + 1 } );

        ## a dependency the start profile refuses never comes up         ##
        ## [ disabled, or not in the on-demand allow list ] : refuse now ##
        ## with the reason instead of a start that waits forever         ##
        ## [ an on-demand caller gets the refusal as its answer ]        ##
        my $dep_refusal = <[zenka.profile_refusal]>->($dep_name);
        if ( ( $reply->{'mode'} // '' ) eq qw| false |
            and defined $dep_refusal ) {
            my $reason = sprintf "dependency '%s' is %s", $dep_name,
                $dep_refusal;
            <[base.logs]>->(
                0,           "zenka '%s' not started : %s",
                $zenka_name, $reason
            );
            return {
                'mode' => qw| false |,
                'data' => sprintf(
                    "zenka '%s' not started : %s",
                    $zenka_name, $reason
                )
            };
        }

        <v7-zenki.zenka.auto_cleanup>->{$dep_name} = $LAST_PAREN_MATCH
            if $reply->{'data'} =~ m| id (\d+)$|;
    }
    <v7-zenki.zenka.dependency>->{$dep_name}->{$zenka_name} = 1
        if not exists <v7-zenki.zenka.autostart>->{$dep_name};
}

## a start with ':ignore-disabled:' is not added : the override is per call ##
## -- as 'enabled' it would let every later automatic start through         ##
<v7-zenki.start_setup.globals.zenki.enabled> .= sprintf( ' %s', $zenka_name )
    if not $ignore_disabled
    and not <[zenka.is_enabled]>->($zenka_name);

if ( not defined $zenka_id ) {
    foreach my $id ( keys <v7-zenki.zenka.setup>->%* ) {
        if ( not defined <v7-zenki.zenka.setup>->{$id}->{'name'} ) {
            <[base.s_warn]>->(
                'v7-zenki.zenka.setup.%d has an undefined name key', $id
            );
        } elsif ( <v7-zenki.zenka.setup>->{$id}->{'name'} eq $zenka_name ) {
            $zenka_id = $id;    ## has name match ##
        }
    }
}

my $obj_id = <[zenka.get_object_id]>->($zenka_id);

my $target_queue
    = <[dependency.ok_resolve]>->($obj_id) ? qw|queued| : qw|depending|;

my $sn_str = defined $zenka_subname ? sprintf( '[%s]', $zenka_subname ) : '';
my $env_str
    = defined $env_override_key
    ? sprintf( ' :env:%s=%s:', $env_override_key, $env_override_value )
    : '';

my $job_id = <[jobqueue.add_job]>->(
    {   'object_id'       => $obj_id,
        'job_callback'    => qw| zenka.start |,
        'callback_params' =>
            sprintf( qw| %s%s%s |, $zenka_name, $sn_str, $env_str ),
        'target_queue' => $target_queue
    }
);

## start gate flag [ v7-zenki.pressure.start_gate ] : on-demand path =    ##
## cube's ondemand routing sends 'v7-zenki.start_once' over the network   ##
## [ session_id set ] for a zenka configured start.on-demand. internal    ##
## calls [ dependency \ resolve cascade, restart, notify_online :start: ] ##
## carry no session_id. a user typing 'v7-zenki.start_once <on-demand>'   ##
## takes the same path and is gated too [ 'v7-zenki.start' is not ]       ##
<jobqueue.joblist.by_id>->{$job_id}->{'pressure_gate'}
    = { 'origin' => qw| on-demand | }
    if defined $job_id
    and ref <jobqueue.joblist.by_id>->{$job_id} eq qw| HASH |
    and $once
    and not $recursion
    and defined $call->{'session_id'}
    and grep { $ARG eq $zenka_name } ( <v7-zenki.ondemand_zenki> // [] )->@*;

return {
    'mode' => qw| true |,
    'data' => sprintf( "job queued [ID=%d]", $job_id )
    }

