## [:< ##

# name  = models.trash.root_path
# descr = the configured lmstudio models root -- single canonical accessor
#         so the path-escape check in delete-model and the trash location
#         in every trash.* helper can never drift apart. same default the
#         lmstudio storage adapter itself uses [ models.storage.adapter.
#         lmstudio.discover ]

$data{'models'}{'external.models.lmstudio.path'}
    // '/mnt/ext-xfs-data/models-lmstudio';

