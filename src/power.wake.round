## [:< ##

# name  = power.wake.round
# param = <wake job>
# descr = one wake round : every try at once, deduplicated

## a try is sent only while its local iface is still attached with the same ##
## broadcast and not external [ the network may change between rounds ] ;   ##
## one packet per mac + broadcast                                           ##
my $job      = shift;
my $networks = <[netinfo.local_networks]>;
my ( %done, @where, $error );
my $sent = 0;
foreach my $try ( $job->{'tries'}->@* ) {
    next if $done{"$try->{'mac'} $try->{'broadcast'}"}++;
    my ($net) = grep {
                $ARG->{'iface'} eq $try->{'local'}
            and $ARG->{'role'} ne qw| external |
            and $ARG->{'broadcast'} eq $try->{'broadcast'}
    } $networks->@*;
    if ( not defined $net ) {
        $error = "$try->{'local'} no longer attached";
        next;
    }
    my $why = <[power.wake.send]>->( $try->{'mac'}, $try->{'broadcast'} );
    if ( defined $why ) {
        $error = $why;
        next;
    }
    $sent++;
    push @where, "$try->{'iface'} $try->{'mac'} via $try->{'local'}";
}
<[base.logs]>->(
    1,              ': wake %s round : %s',
    $job->{'host'}, @where ? join( ', ', @where ) : "nothing sent [ $error ]"
);
return { sent => $sent, where => \@where, error => $error // 'no try' };

