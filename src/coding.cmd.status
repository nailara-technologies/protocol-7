## [:< ##

# name  = coding.cmd.status
# descr = show coding zenka status and queue information
# param = [task_id]

my $task_id = length( $call->{'args'} ) ? $call->{'args'} : undef;

# Get queue statistics
my $queue_stats = <[coding.task.queue]>->( 'status', $task_id );

# If requesting specific task status but not found
if ( defined $task_id && !$queue_stats->{'success'} ) {
    return {
        'mode' => qw| false |,
        'data' => "task not found : $task_id"
    };
}

if ( defined $task_id ) {

    # Specific task status
    my $task_status = $queue_stats;

    if ( !$task_status->{'success'} ) {
        return {
            'mode' => qw| false |,
            'data' => "task not found : $task_id"
        };
    }

    return {
        'mode' => qw| size |,
        'data' => ":: task Status : $task_id ::\n\n: status   : "
            . $task_status->{'status'}
            . "\n: started  : "
            . (
            $task_status->{'started'}
            ? scalar( localtime( $task_status->{'started'} ) )
            : 'pending'
            )
            . "\n: completed : "
            . (
            $task_status->{'completed'}
            ? scalar( localtime( $task_status->{'completed'} ) )
            : 'in progress'
            )
            . "\n:  success  : "
            . ( $task_status->{'success'} ? 'yes' : 'no' ) . "\n"
    };
}

# General statistics
my $stats = $queue_stats;

# Get budget status
my $budget = <[coding.budget.track_tokens]>->('status');

return {
    'mode' => qw| size |,
    'data' => "\n:: coding zenka status ::\n\n: "
        . "queue stats :\n:  failed    : "
        . $stats->{failed}
        . "\n:  pending   : "
        . $stats->{pending}
        . "\n:  progress  : "
        . $stats->{in_progress}
        . "\n:  completed : "
        . $stats->{completed}
        . "\n\n: budget info :\n:  used      : "
        . $budget->{total_used}
        . " tokens ("
        . $budget->{percentage_used}
        . "%)\n:  status    : "
        . $budget->{status}
        . "\n:  allocated : "
        . $budget->{total_allocated}
        . " tokens\n:  remaining : "
        . $budget->{remaining}
        . " tokens"
};

