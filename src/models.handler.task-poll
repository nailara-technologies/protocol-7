## [:< ##

# name  = models.handler.task-poll
# descr = remote task tick : keep the streams, poll for work
# note  = remote task zenki tick : keep every notice stream, poll for
#         work
# notes = timer handler [ models.task.startup ], once per listed remote
#         task zenka per tick. the poll also covers tasks created while
#         the link or the stream was down. one '.next' in flight per
#         zenka -- one unanswered for 90 s means that link is presumed
#         down : the slot is freed and its notice stream dropped too
#         [ a link gone without a STRM close frame never calls its
#         on_eof ], its next subscribe follows the backoff. every zenka
#         ticks independently : one down never blocks the others

return FALSE if not <[models.task.remote]>;

foreach my $zenka (<[models.task.zenki]>) {
    next if $zenka eq qw| task |;    ## local task zenka notifies itself ##

    my $state   = <models.task.streams>->{$zenka} //= {};
    my $sent_at = $state->{'poll_sent_at'};

    if ( defined $sent_at and time - $sent_at >= 90 ) {
        $state->{'poll_sent_at'} = $sent_at = undef;

        <[base.logs]>->(
            1, ': task poll %s : no answer ' . 'in 90 s, link presumed down',
            $zenka
        );

        if ( $state->{'subscribed'} ) {
            <[strm.local.cancel]>->( $state->{'cmd_id'} )
                if defined $state->{'cmd_id'};
            $state->{'subscribed'} = FALSE;
            $state->{'cmd_id'}     = undef;
            <[models.task.subscribe-retry]>->($zenka);
        }
    }

    ## notice stream : [re]subscribe once its backoff allows ##
    <[models.task.subscribe]>->($zenka);

    ## fallback poll ##
    next if defined $sent_at;

    $state->{'poll_sent_at'} = time;

    my $sent = <[protocol-7.route-send]>->(
        {   'command' => sprintf( qw| %s.next |, $zenka ),
            'reply'   => {
                'handler' => 'models.handler.task-poll-step',
                'params'  => { 'step' => 'poll-next', 'zenka' => $zenka }
            }
        }
    );

    if ( not $sent or $sent <= 0 ) {
        $state->{'poll_sent_at'} = undef;
        <[base.logs]>->(
            1,      ': task poll %s : %s.next not routed',
            $zenka, $zenka
        );
    }
}

return TRUE;

