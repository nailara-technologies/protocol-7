# name  = pager.util.filter.is_true_state
# descr = Simplified true state check for numeric value

my ( $num, $main_42 ) = @ARG;

# Would use AMOS7::Assert::Truth::is_true in production
# For now, check basic bit balance
my $bits  = sprintf( '%b', $num );
my $ones  = $bits =~ tr/1//;
my $zeros = length($bits) - $ones;
return abs( $ones - $zeros ) < length($bits) * 0.3;    # Roughly balanced

