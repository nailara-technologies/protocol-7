## [:< ##

# name = data.mount.shm.permission.add
# descr = Add sticky permission to SHM header

my $mount          = shift;
my $permission     = shift;
my $owner_priv_key = shift;

return undef unless defined $mount && defined $permission;

$permission->{'to'}     // return undef;
$permission->{'branch'} // return undef;
$permission->{'rights'} //= ['read'];
$permission->{'expiry'} //= time() + 3600;

my $header = <[data.mount.shm.header.read]>->( $mount->{'mmap_ptr'} );
return undef unless defined $header;

if ( @{ $header->{'permissions'} } >= AMOS7::SHM::MAX_PERMISSIONS() ) {
    return {
        'error'   => 'max_permissions_reached',
        'max'     => AMOS7::SHM::MAX_PERMISSIONS(),
        'current' => scalar( @{ $header->{'permissions'} } ),
    };
}

$permission->{'granted'} = time();
$permission->{'sig'} = <[data.mount.shm.permission.add.sign_permission]>->(
    $permission, $owner_priv_key, $header, $mount->{'sub_path'} // ''
);
return { 'error' => 'signing_failed' }
    unless defined $permission->{'sig'};

push @{ $header->{'permissions'} }, $permission;

my $result
    = <[data.mount.shm.header.write]>->( $mount->{'mmap_ptr'}, $header );

if ( not defined $result ) {
    pop @{ $header->{'permissions'} };
    return { 'error' => 'header_overflow' };
}

$mount->{'header'} = $header;

return {
    'added'      => 1,
    'permission' => $permission,
    'total'      => scalar( @{ $header->{'permissions'} } ),
};

