## [:< ##

# name  = jobsite.cmd.set-status
# descr = set job status: args = "<id> <status>"

my $args = $call->{'args'} // '';
$args =~ s{^\s+|\s+$}{}g;

my ( $id_in, $status ) = split m|\s+|, $args, 2;
my $id = <[base.vax-int.decode]>->( $id_in // '' );

return { 'mode' => 'false', 'data' => 'usage: set-status <id> <status>' }
    if not( defined $id and defined $status );

my %valid
    = map { $ARG => 1 }
    qw| new assessed applied interviewed rejected skipped archived |;
return {
    'mode' => 'false',
    'data' => "invalid status '$status'; valid: "
        . join( ' ', sort keys %valid )
    }
    if not $valid{$status};

my $store = <jobs.store> // <[jobsite.job.load_all]>;
return { 'mode' => 'false', 'data' => "unknown job id: $id" }
    if not exists $store->{$id};

$store->{$id}{'status'}     = $status;
$store->{$id}{'applied_at'} = time if $status eq 'applied';

<[jobsite.job.write]>->( $id, $store->{$id} );

return { 'mode' => 'true', 'data' => "ok: $id => $status" };

