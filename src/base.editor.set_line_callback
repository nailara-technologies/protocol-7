## [:< ##

# name  = base.editor.set_line_callback
# descr = set line content callback for virtual editor buffer

## [ stub ] register callback for fetching line content ##

my ($args) = @ARG;

my $buffer_id = $args->{'buffer_id'};
my $callback  = $args->{'callback'};
my $buf       = $data{'editor'}{'buffers'}{$buffer_id};

return undef unless $buf;

$buf->{'line_callback'} = $callback;

return 1;

