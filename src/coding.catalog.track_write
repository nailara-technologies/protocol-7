## [:< ##

# name  = coding.catalog.track_write
# descr = note which module a task wrote, for the retrieval corpus
# param = { target => '<path or module name>' }

##      half of the harvesting instrument for the catalog-retrieval         ##
##      work [ data/tasks/coding-catalog-retrieval-phase2.md ]. every       ##
##      write a task performs is accumulated in memory against that         ##
##      task's id ; coding.catalog.corpus.record flushes the set to         ##
##      disk once the task completes.                                       ##
##                                                                          ##
##      why this exists : both gate runs so far evaluated retrieval         ##
##      using COMMIT MESSAGES as the query, and the fixed leakage           ##
##      probe showed that population is contaminated -- 43% of recent       ##
##      commits wrote the very descr line they were then asked to           ##
##      retrieve, and clean commits score 9.4% against 22.7% for            ##
##      contaminated ones. commit messages are the wrong query source.      ##
##      the RIGHT one is the task text the auto-inject provider would       ##
##      actually see, paired with what that task really touched -- and      ##
##      that data does not exist anywhere yet. it only starts existing      ##
##      once something records it, which is this.                           ##
##                                                                          ##
##      off unless <coding.cfg.catalog_harvest> is enabled : with the       ##
##      key absent this module returns immediately and changes              ##
##      nothing.                                                            ##

my $params = shift // {};

return { 'mode' => qw| true |, 'data' => 'disabled' }
    if not <[base.cfg_bool]>->(<coding.cfg.catalog_harvest>);

my $target = $params->{'target'} // '';

return { 'mode' => qw| true |, 'data' => 'no target' } if not length $target;

## the module name is the basename : src/base.log -> base.log, and the ##
## filesystem-as-index property means no lookup table is needed        ##
my $module = $target;
$module =~ s{^.*/}{};

## only track modules that actually exist under src/ -- a write to a ##
## scratch path or a data file is not a retrieval target             ##
my $root = <system.root_path> // '';
return { 'mode' => qw| true |, 'data' => 'not a src module' }
    if not length $module
    or not -f sprintf( qw| %s/src/%s |, $root, $module );

## resolve the task this write belongs to. primary : the tool-executor      ##
## context key <coding.catalog.active_task>, set by                         ##
## coding.async.tool_executor tightly around each synchronous tool dispatch ##
## -- exact attribution, no guessing. fallback [ callers without executor   ##
## context, e.g. coding.cmd.call-tool ] : the in-progress queue scan        ##
## record_observation also uses, but a bare 'first in_progress task' scan   ##
## is WRONG under concurrency : coding.task.execute sets the status before  ##
## backend acquisition, so a queued-behind task already reads as            ##
## in_progress [ cross-task misattribution confirmed live 2026-09-09 ].     ##
## when several tasks are in_progress, only the one actually holding a      ##
## backend lock [ coding.async.backend_acquire ] can be executing tools     ##
my $task_id = <coding.catalog.active_task> // '';

if ( not length $task_id ) {
    my @in_progress;
    foreach my $tid ( keys <coding.task.queue>->%* ) {
        my $task = <coding.task.queue>->{$tid};
        next if ref $task ne qw| HASH |;
        next if ( $task->{'execution'}{'status'} // '' ) ne qw| in_progress |;
        push @in_progress, $tid;
    }
    if ( @in_progress == 1 ) {
        $task_id = $in_progress[0];
    } elsif ( @in_progress > 1 ) {
        my $backend_state = <coding.state.backend> // {};
        foreach my $tid (@in_progress) {
            foreach my $backend ( keys $backend_state->%* ) {
                my $bs = $backend_state->{$backend};
                next if ref $bs ne qw| HASH |;
                next if ( $bs->{'lock'} // '' ) ne $tid;
                $task_id = $tid;
                last;
            }
            last if length $task_id;
        }
    }
}

return { 'mode' => qw| true |, 'data' => 'no active task' }
    if not length $task_id;

<coding.catalog.touched> //= {};
<coding.catalog.touched>->{$task_id}{$module} = TRUE;

<[base.logs]>->( 3, ':. catalog.track : %s <- %s', $task_id, $module );

return { 'mode' => qw| true |, 'data' => $module };

