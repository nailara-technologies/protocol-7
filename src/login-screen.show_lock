## [:< ##

# name  = login-screen.show_lock
# descr = show the greeter as a fullscreen grabbed session lock

my $username = shift // <login-screen.session_user> // '';
return FALSE if $username !~ m|^[a-z_][a-z0-9_-]{0,31}$|;
my $window = <login-screen.window> // return FALSE;

<login-screen.session_user>             = $username;
<login-screen.state>                    = qw| locked |;
<login-screen.auth_in_flight>           = FALSE;
<login-screen.lock.grabbed>             = FALSE;
<login-screen.lock.grab_failure_logged> = FALSE;
<login-screen.lock.panel_fading>        = FALSE;
foreach my $timer (qw| blank_timer time_timer grab_timer raise_timer |) {
    Glib::Source->remove( $data{'login-screen'}{'lock'}{$timer} )
        if defined $data{'login-screen'}{'lock'}{$timer};
    delete $data{'login-screen'}{'lock'}{$timer};
}
<[login-screen.unwatch_root]>;
<login-screen.lock.unlock_fading> = FALSE;
foreach my $curve (
    qw| login_screen_lock_fade login_screen_lock_snapshot_fade
    login_screen_lock_controls_fade login_screen_lock_panel_fade
    login_screen_lock_feedback login_screen_unlock_controls_fade
    login_screen_unlock_background_fade |
) {
    <[base.curve.cancel]>->($curve);
}

my $user       = <login-screen.widget.user>;
my $panel      = <login-screen.widget.panel>;
my $background = <login-screen.widget.background>;
my $snapshot   = <login-screen.widget.snapshot>;
$user->set_text($username);
$user->set_editable(FALSE);
$user->set_sensitive(FALSE);
<login-screen.widget.user_label>->set_text($username);
<login-screen.widget.password>->set_text('');
<login-screen.widget.password>->set_sensitive(FALSE);
<login-screen.widget.button>->set_label('unlock');
<login-screen.widget.button>->set_sensitive(FALSE);
<login-screen.widget.status>->set_text('');
$panel->set_opacity(0)      if defined $panel;
$background->set_opacity(0) if defined $background;

my $snapshot_pixbuf = <[login-screen.capture_snapshot]>;
<login-screen.lock.snapshot> = $snapshot_pixbuf;
if ( defined $snapshot ) {
    $snapshot->set_from_pixbuf($snapshot_pixbuf) if defined $snapshot_pixbuf;
    $snapshot->set_opacity( defined $snapshot_pixbuf ? 1 : 0 );
}

my $show_user = ( <login-screen.lock.show_user> // qw| yes | ) ne qw| no |;
my $show_time = ( <login-screen.lock.show_time> // qw| yes | ) ne qw| no |;
<login-screen.lock.idle_pending> //= FALSE;
## lock blanking has its own exact fade endpoint, not the server idle timer ##
<[protocol-7.route-send]>
    ->( { 'command' => qw| X-11.dpms-blanking-disable | } );
$window->set_keep_above(TRUE);
$window->fullscreen();
$window->set_opacity(0.995);
$window->show_all();
$window->present();
$snapshot->set_visible( defined $snapshot_pixbuf ? TRUE : FALSE )
    if defined $snapshot;
$user->set_visible(FALSE);    ## the dimmed name label already says who ##
<login-screen.widget.user_label>->set_visible($show_user);
<login-screen.widget.time>->set_visible($show_time);
## no root watch : fall back to the raise poll, the lock must stay on top ##
if ( not <[login-screen.watch_root]> ) {
    <[login-screen.handler.lock_raise_poll]>;
}

my $update_time = sub {
    return FALSE if <login-screen.state> ne qw| locked |;
    <login-screen.widget.time>
        ->set_text( POSIX::strftime( '%H:%M', localtime ) );
    return TRUE;
};
$update_time->();
<login-screen.lock.time_timer> = Glib::Timeout->add( 30000, $update_time );

## fade duration [ login-screen.lock.fade_duration, seconds, 0.2 .. 10 ] ##
my $fade_duration = <login-screen.lock.fade_duration> // 1.7;
$fade_duration = 1.7
    if $fade_duration !~ m|^\d+(?:[.]\d+)?$|
    or $fade_duration < 0.2
    or $fade_duration > 10;

<[base.curve.register]>->(
    {   id       => qw| login_screen_lock_fade |,
        from     => 0,
        to       => 0.995,
        duration => $fade_duration,
        type     => qw| ease-in-out |,
        callback => sub {
            my $value = shift;
            $background->set_opacity($value)
                if <login-screen.state> eq qw| locked |
                and defined $background;
        },
        on_done => sub {
            return if <login-screen.state> ne qw| locked |;
            <login-screen.lock.idle_pending> = FALSE;
            $background->set_opacity(0.995) if defined $background;
            <[base.curve.register]>->(
                {   id       => qw| login_screen_lock_controls_fade |,
                    from     => $panel->get_opacity(),
                    to       => 1,
                    duration => 0.3,
                    type     => qw| ease-in-out |,
                    callback => sub {
                        my $value = shift;
                        $panel->set_opacity($value)
                            if <login-screen.state> eq qw| locked |;
                    },
                    on_done => sub {
                        return if <login-screen.state> ne qw| locked |;
                        $panel->set_opacity(1);
                        my $schedule = <login-screen.policy.schedule_blank>;
                        $schedule->() if defined $schedule;
                    },
                }
            ) if defined $panel;
        },
    }
);
<[base.curve.register]>->(
    {   id       => qw| login_screen_lock_snapshot_fade |,
        from     => 1,
        to       => 0,
        duration => $fade_duration,
        type     => qw| ease-in-out |,
        callback => sub {
            my $value = shift;
            $snapshot->set_opacity($value)
                if <login-screen.state> eq qw| locked | and defined $snapshot;
        },
        on_done => sub {
            return if <login-screen.state> ne qw| locked |;
            if ( defined $snapshot ) {
                $snapshot->clear();
                $snapshot->set_opacity(0);
                $snapshot->hide();
            }
            <login-screen.lock.snapshot> = undef;
        },
    }
);

<login-screen.lock.grab_timer>
    = Glib::Timeout->add( 200, $code{'login-screen.handler.lock_grab'} )
    if <[login-screen.handler.lock_grab]>;
TRUE;

