## [:< ##

# name  = ncode.cmd.replace
# descr = replace pattern in a source file via ncode

my $args = $call->{'args'} // '';

my @parts = split m|\s+|, $args;

return {
    'mode' => qw| false |,
    'data' => 'usage: replace <file> <old-pattern> <new-string>'
    }
    if @parts < 3;

my $file = shift @parts;
my $old  = shift @parts;
my $new  = join ' ', @parts;

## map file path to ncode target ##
my $target;
if ( $file =~ m|^src/| ) {
    ( my $base = $file ) =~ s|^.*/||;
    $target = "src:$base";
} elsif ( $file =~ m|^bin/| ) {
    ( my $base = $file ) =~ s|^.*/||;
    $target = "bin:$base";
} elsif ( $file =~ m|^cfg/| ) {
    ( my $base = $file ) =~ s|^.*/||;
    $target = "cfg:$base";
} elsif ( $file =~ m|^data/md/| ) {
    ( my $base = $file ) =~ s|^.*/||;
    $target = "docs:$base";
} elsif ( $file =~ m|^data/tasks/| ) {
    ( my $base = $file ) =~ s|^.*/||;
    $target = "tasks:$base";
} elsif ( $file !~ m|/| ) {
    $target = "src:$file";
} else {
    return {
        'mode' => qw| false |,
        'data' => "unsupported file path: $file"
    };
}

my @cmd = (
    <ncode.bin>, qw| -ai-friendly -confirm -no-color replace |,
    $target,     $old, $new
);

my $output = <[ncode.util.run_cmd]>->(@cmd);

if ( $output =~ m|\[SUCCESS\]| or $output =~ m|Changes applied| ) {
    return { 'mode' => qw| true |, 'data' => $output };
} else {
    return { 'mode' => qw| false |, 'data' => $output };
}

