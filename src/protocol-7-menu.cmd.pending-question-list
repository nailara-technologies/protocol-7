# name  = protocol-7-menu.cmd.pending-question-list
# param = [ decisions ]
# descr = list the pending questions [ p7 config lines ]
#
# one block per question : question.<id>.<key> = value [ type, question,
# options, added, decision ] ; `decisions` : only the coding.ask ones.
# nothing is removed or opened

my $only = ( $call->{'args'} // '' ) =~ m|\bdecisions\b|;
my @out  = <[protocol-7-menu.pending-lines]>->($only);
return {
    'mode' => qw| true |,
    'data' => @out ? join( "\n", @out ) . "\n" : "no pending questions\n"
};

