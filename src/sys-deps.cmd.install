## [:< ##

# name  = sys-deps.cmd.install
# descr = install missing debian deps via debian zenka bridge
# param = [zenka=<name>]

my $param = shift;
my $args  = $param->{'args'} // '';

my $zenka_filter;
if ( $args =~ m|zenka=(\S+)| ) {
    $zenka_filter = $1;
}

## no privilege check here : sys-deps always runs unprivileged [ root      ##
## dropped right after init ] - the actual install is routed to the debian ##
## zenka's privileged apt_child bridge further below                       ##

my $pm_deps = <sys-deps.pm_deps>;
my $os_deps = <sys-deps.os_deps>;

## Collect missing debian packages ##
my @to_install;

for my $type ( keys %$os_deps ) {
    next if $type eq 'binary';
    next unless $type eq 'debian';
    for my $pkg ( sort keys %{ $os_deps->{$type} } ) {
        next
            if defined $zenka_filter
            and !grep { $ARG eq $zenka_filter } @{ $os_deps->{$type}{$pkg} };
        push @to_install, $pkg
            unless AMOS7::deps::os_package::probe_os_pkg( $pkg, $type );
    }
}

## Resolve missing perl modules to debian packages ##
my $known_deps = AMOS7::deps::module::load_known_deps(<system.root_path>)
    // {};

for my $module ( sort keys %$pm_deps ) {
    next
        if defined $zenka_filter
        and !grep { $ARG eq $zenka_filter } @{ $pm_deps->{$module} };
    next if AMOS7::deps::module::probe_module($module);
    my $resolved
        = AMOS7::deps::module::resolve_install( $module, $known_deps );
    push @to_install, $resolved->{'pkg'}
        if $resolved->{'method'} eq qw| debian |;
}

my %seen;
@to_install = grep { !$seen{$ARG}++ } @to_install;

unless (@to_install) {
    return { 'mode' => qw| true |, 'data' => 'no missing debian packages' };
}

<[base.logs]>->(
    1,                   'sys-deps: requesting %d package%s from debian ..',
    scalar(@to_install), @to_install == 1 ? '' : 's'
);

## route the privileged install through debian zenka's apt_child bridge : a ##
## direct AMOS7::deps::debp::install_apt call here can never succeed [      ##
## install_apt hard-fails when $EUID != 0, and sys-deps has already dropped ##
## root before any command runs ]. the reply arrives async via              ##
## sys-deps.handler.install_reply, which completes this command's reply     ##
my $sent = <[protocol-7.route-send]>->(
    {   'command'   => qw| debian.install-packages |,
        'call_args' => { 'args' => join( ' ', @to_install ) },
        'reply'     => {
            'handler' => qw| sys-deps.handler.install_reply |,
            'params'  => {
                'packages' => \@to_install,
                'zenka'    => $zenka_filter,
                'reply_id' => $param->{'reply_id'}
            }
        }
    }
);

return {
    'mode' => qw| false |,
    'data' => 'could not reach debian zenka [ route-send failed ]'
    }
    if not $sent;

return { 'mode' => qw| deferred | };

