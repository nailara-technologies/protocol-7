## [:< ##

# name  = jobsite.client_prefs.read
# descr = load browser-shared client prefs blob [ small numeric-value map ]

my $sref = <[file.zenka_dir.load]>->('client-prefs.yaml');
return {} if not defined $sref;

my ( $saved, $yaml_err ) = <[format.yaml.load_str]>->( $sref->$* );
if ($yaml_err) {
    <[base.logs]>->( 0, 'jss.client_prefs.read: parse error: %s', $yaml_err );
    return {};
}
return ref $saved eq 'HASH' ? $saved : {};

