## [:< ##

# name = models.chat.format_buffer
# descr = format chat buffer entries for display with escape interpretation
# param = $entries - arrayref of chat entries
# return = formatted string

my $entries = shift;

return '' unless defined $entries and ref($entries) eq 'ARRAY';

my $output = '';

for my $entry (@$entries) {
    ## format timestamp (HH:MM:SS)
    my $timestamp = <[base.parser.timestamp]>->( 'time', $entry->{'time'} );

    ## interpret escapes for display
    my $message = <[models.escape.interpret]>->( $entry->{'message'} );

    ## format entry
    $output .= sprintf "[%s] [%s]: %s\n", $timestamp, $entry->{'sender'},
        $message;
}

return $output;

0;

