## [:< ##

# name   = events.bucket.unless.parse
# descr  = normalize the value of an unless= argument
# args   = text [ condition,.. ]
# return = { unless => normalized text } or { error => text }

my @conditions = grep {length} split m{,}, shift // '';
return { 'error' => 'unless : at least one condition expected' }
    if not @conditions;
my @parsed;
foreach my $condition (@conditions) {
    my $gate = <[events.bucket.gate.parse]>->($condition);
    return { 'error' => $gate->{'error'} } if defined $gate->{'error'};
    push @parsed, $gate->{'kind'} eq qw| budget |
        ? "budget:$gate->{'text'}"
        : $gate->{'text'};
}
return { 'unless' => join ',', @parsed };

