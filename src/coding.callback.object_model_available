## [:< ##

# name  = coding.callback.object_model_available
# descr = Dependency callback to check if specific model is available

my $object_id = shift;
return undef unless exists <dependency.object>->{$object_id};

my $object  = <dependency.object>->{$object_id};
my $backend = $object->{'backend'} // 'gpu';

## Get configured model for this backend ##
my $model_name
    = $backend eq 'cpu'
    ? ( <inference.backend.cpu.model_id> // '' )
    : ( <inference.backend.gpu.model_id> // '' );

return FALSE unless length $model_name;

## Check if model exists in coding metadata cache ##
my $metadata   = <coding.model_metadata> // {};
my $meta_count = scalar keys %$metadata;

<[base.logs]>->(
    3, '[callback.model_available] backend=%s model=%s cache_count=%d',
    $backend, $model_name, $meta_count
);

return FALSE unless $meta_count;

my $search_term = lc($model_name);
$search_term =~ s|[-_\s]+||g;    ## Normalize

foreach my $cache_name ( keys %$metadata ) {
    my $entry = $metadata->{$cache_name};

    ## Check amos field (primary ID) - this is the most likely match ##
    my $entry_amos = $entry->{'amos'} // '';
    if ( $entry_amos eq $model_name ) {
        <[base.logs]>->(
            2, '[callback.model_available] amos match: %s', $cache_name
        );
        return TRUE;
    }

    ## Check model_id field ##
    if ( ( $entry->{'model_id'} // '' ) eq $model_name ) {
        <[base.logs]>->(
            2, '[callback.model_available] model_id match: %s', $cache_name
        );
        return TRUE;
    }

    ## Check exact name match ##
    if ( $cache_name eq $model_name ) {
        <[base.logs]>->(
            2, '[callback.model_available] name match: %s', $cache_name
        );
        return TRUE;
    }

    ## Partial normalized match ##
    my $cache_norm = lc($cache_name);
    $cache_norm =~ s|[-_\s]+||g;
    my $amos_norm = lc($entry_amos);
    $amos_norm =~ s|[-_\s]+||g;

    if (   index( $cache_norm, $search_term ) >= 0
        || index( $search_term, $cache_norm ) >= 0
        || index( $amos_norm,   $search_term ) >= 0
        || index( $search_term, $amos_norm ) >= 0 ) {
        <[base.logs]>->(
            2, '[callback.model_available] partial match: %s', $cache_name
        );
        return TRUE;
    }
}

<[base.logs]>->(
    3, '[callback.model_available] model not available: %s', $model_name
);
return FALSE;

