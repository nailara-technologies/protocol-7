## [:< ##

# name  = nameserv.zone.save
# descr = save a zone to yaml file

my $zone_name = shift;

my $zones = <nameserv.zones>;

return if not exists $zones->{$zone_name};

my $zone = $zones->{$zone_name};

## drop expired tombstones before writing ##
<[nameserv.zone.tombstone.purge]>->($zone_name);

my $data = {
    serial  => $zone->{'serial'},
    ttl     => $zone->{'ttl'},
    records => $zone->{'records'},
};

my $yaml_str = <[format.yaml.dump_str]>->($data);
if ( not defined $yaml_str ) {
    <[base.logs]>->( 0, "failed to serialize zone: %s", $zone_name );
    return;
}

## write to zone directory (relative to zenka var path)
my $filepath = sprintf( "zones/%s.yaml", $zone_name );
my $result   = <[file.zenka_dir.write]>->( $filepath, \$yaml_str );

if ( defined $result ) {

    ## tombstones live next to the zone file                               ##
    ## [ design : timestamp delta sync ] ; the zone yaml itself keeps only ##
    ## live records                                                        ##
    my $tomb_data = { tombstones => $zone->{'tombstones'} // [], };
    my $tomb_yaml = <[format.yaml.dump_str]>->($tomb_data);
    if ( defined $tomb_yaml ) {
        <[file.zenka_dir.write]>->(
            sprintf( "zones/%s.tombstones.yaml", $zone_name ),
            \$tomb_yaml
        );
    } else {
        <[base.logs]>
            ->( 0, "failed to serialize tombstones: %s", $zone_name );
    }

    <[base.logs]>->( 2, "saved zone: %s", $zone_name );
} else {
    <[base.logs]>->( 0, "failed to save zone: %s", $zone_name );
}

return $result;

