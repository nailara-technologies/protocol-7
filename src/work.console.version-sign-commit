## [:< ##

# name  = work.console.version-sign-commit
# param = [commit-message]
# descr = update version, sign, commit and push

my $message         = shift // '';
my $no_push         = 0;
my $specific_remote = '';

# Check for flags
if ( $message eq '--no-push' ) {
    $no_push = 1;
    $message = '';
} elsif ( $message =~ /^--remote=(.+)$/ ) {
    $specific_remote = $1;
    $message         = '';
}

say '';
say ' .:[ WORKFLOW: VERSION-SIGN-COMMIT-PUSH ]:.';
say '';

## Prompt for message if not provided
unless ( length $message ) {
    print ' : Commit message (or Enter for default): ';
    $message = <STDIN>;
    chomp $message if defined $message;
    $message //= '';
}

## Step 0: Update version
say ' .:[ STEP 0: UPDATE VERSION ]:.';
say '';

system('./bin/dev/update-version');
my $version_exit = $? >> 8;

if ( $version_exit != 0 ) {
    say '';
    say sprintf ' : ✗ Version update failed (exit: %d)', $version_exit;
    say '';
    return TRUE;
}

say '';
say ' : ✓ Version updated';
say '';

## Explicitly load crypto keys (since auto_load_keys is disabled for workflow
## zenka)
my $sig_key_name  = qw| proto-7.sourcecode |;
my $test_key_name = qw| test-proto7-sourcecode |;

# Attempt to load user's base key if not already loaded
my $base_key_name = <[crypt.C25519.key_vars]>->{'key_name'};
if ( $base_key_name && !exists $keys{'C25519'}{$base_key_name} ) {
    if ( <[crypt.C25519.key_exists]>->($base_key_name) ) {
        <[crypt.C25519.load_keypair]>->($base_key_name);
    }
}

# Attempt to load production key if it exists
if ( !exists $keys{'C25519'}{$sig_key_name}
    && <[crypt.C25519.key_exists]>->($sig_key_name) ) {
    <[crypt.C25519.load_keypair]>->($sig_key_name);
}

## Detect signing mode based on key presence
my $use_production_key = 0;
my $use_test_key       = 0;
my $key_mode           = 'unknown';

# Check if production key is loaded
if ( exists $keys{'C25519'}{$sig_key_name}
    && defined $keys{'C25519'}{$sig_key_name} ) {
    $use_production_key = 1;
    $key_mode           = 'production';
    say ' : ✓ Production key detected';
    say sprintf ' : Using key: %s', $sig_key_name;
    say '';
} else {

    # Production key not available - use test key mode
    $use_test_key = 1;
    $key_mode     = 'test';
    say ' : Production key not loaded - using test key mode';

    # Check if test key exists
    unless ( exists $keys{'C25519'}{$test_key_name}
        && defined $keys{'C25519'}{$test_key_name} ) {
        say ' : Test key not found';

        # Check if crypt.C25519.gen_keys is available
        if ( exists $code{'crypt.C25519.gen_keys'} ) {
            say ' : Creating test key...';

            my ( $new_key, $created_name )
                = <[crypt.C25519.gen_keys]>->($test_key_name);

            unless ( defined $new_key ) {
                say ' : ⚠ WARNING: Failed to generate test key';
                say ' : Continuing without signature capability';
                say '';
                say ' : ✓ Task completed (no signatures applied)';
                say '';
                return 0;    # Return success anyway
            }

            say sprintf ' : ✓ Created test key: %s', $test_key_name;
        } else {
            say ' : ⚠ WARNING: crypt.C25519 module not loaded';
            say ' : Cannot generate or use signing keys';
            say ' : Continuing without signature capability';
            say '';
            say ' : ✓ Task completed (no signatures applied)';
            say '';
            return
                0;  # Return success - workflow completed even without signing
        }
    } else {
        say sprintf ' : ✓ Test key loaded: %s', $test_key_name;
    }
    say '';
}

## Step 1: Update signatures with appropriate key
say ' .:[ STEP 1: UPDATING SIGNATURES ]:.';
say '';

if ($use_test_key) {

    # Backup original key and use test key
    my $original_key = $keys{'C25519'}{$sig_key_name};
    $keys{'C25519'}{$sig_key_name} = $keys{'C25519'}{$test_key_name};

    system( './bin/Protocol-7', 'sourcecode', 'update-signatures' );
    my $sign_exit = $? >> 8;

    # Restore original key
    $keys{'C25519'}{$sig_key_name} = $original_key if defined $original_key;

    if ( $sign_exit != 0 ) {
        say '';
        say sprintf ' : ⚠ WARNING: Signature update failed (exit: %d)',
            $sign_exit;
        say ' : Continuing without signatures';
        say '';
        $key_mode = 'none';
    }
} else {

    # Use production key directly
    system( './bin/Protocol-7', 'sourcecode', 'update-signatures' );
    my $sign_exit = $? >> 8;

    if ( $sign_exit != 0 ) {
        say '';
        say sprintf ' : ⚠ WARNING: Signature update failed (exit: %d)',
            $sign_exit;
        say ' : Continuing without signatures';
        say '';
        $key_mode = 'none';
    }
}

unless ( $key_mode eq 'none' ) {
    say '';
    say ' : ✓ Signatures updated';
    say '';
}

## Step 2: Git add all changes
say ' .:[ STEP 2: STAGING CHANGES ]:.';
say '';

system( 'git', 'add', '-A' );
my $add_exit = $? >> 8;

if ( $add_exit != 0 ) {
    say ' : ✗ Failed to stage changes';
    say '';
    return TRUE;
}

# Show what will be committed
system( 'git', 'status', '--short' );

say '';
say ' : ✓ Changes staged';
say '';

## Step 3: Commit with message
say ' .:[ STEP 3: COMMITTING ]:.';
say '';

my $commit_message = $message;
unless ( length $commit_message ) {

    # Generate default message
    $commit_message = "chore: Update signatures with $key_mode key";
}

# Add key mode context to commit message
$commit_message .= "\n\nSigned-by: $key_mode-key" if $use_test_key;

my $commit_cmd = sprintf( 'git commit --no-gpg-sign -m "%s"',
    $commit_message =~ s|"|\\"|gr );

system($commit_cmd);
my $commit_exit = $? >> 8;

if ( $commit_exit != 0 ) {
    say ' : ✗ Commit failed';
    say '';
    return TRUE;
}

say '';
say ' : ✓ Changes committed';
say '';

## Step 4: Push to remote(s)
unless ($no_push) {
    say ' .:[ STEP 4: PUSHING TO REMOTE(S) ]:.';
    say '';

    # Get current branch
    my $branch = `git branch --show-current`;
    chomp $branch if defined $branch;

    unless ( length $branch ) {
        say ' : ⚠ WARNING: Could not determine current branch';
        say ' : Skipping push';
        say '';
    } else {
        my @remotes_to_push;

        # Determine which remotes to push to
        if ( length $specific_remote ) {

            # Specific remote requested
            @remotes_to_push = ($specific_remote);
            say sprintf ' : Pushing to specific remote: %s', $specific_remote;
        } elsif ( ref(<work.git.remotes>) eq 'ARRAY'
            && @{<work.git.remotes>} ) {

            # Multiple remotes configured
            @remotes_to_push = @{<work.git.remotes>};
            say sprintf ' : Pushing to %d configured remotes: %s',
                scalar(@remotes_to_push), join( ', ', @remotes_to_push );
        } else {

            # Auto-detect available remotes with priority order
            my $remotes_output = `git remote 2>/dev/null`;
            chomp $remotes_output if defined $remotes_output;
            my @available_remotes = split( /\n/, $remotes_output // '' );

            if (@available_remotes) {

                # Priority order: hub > origin > first available
                my $selected_remote;
                if ( grep { $_ eq 'hub' } @available_remotes ) {
                    $selected_remote = 'hub';
                    say ' : Auto-detected remote: hub';
                } elsif ( grep { $_ eq 'origin' } @available_remotes ) {
                    $selected_remote = 'origin';
                    say ' : Auto-detected remote: origin';
                } else {
                    $selected_remote = $available_remotes[0];
                    say sprintf ' : Auto-detected remote: %s',
                        $selected_remote;
                }
                @remotes_to_push = ($selected_remote);
            } else {

                # No remotes configured - skip push gracefully
                say ' : ⚠ WARNING: No git remotes configured';
                say ' : Skipping push';
                say '';
                goto SKIP_PUSH;
            }
        }

        say sprintf ' : Branch: %s', $branch;
        say '';

        my $all_success = 1;
        my @failed_remotes;

        foreach my $remote (@remotes_to_push) {
            say sprintf ' : → Pushing to %s...', $remote;

            system( 'git', 'push', '-u', $remote, $branch );
            my $push_exit = $? >> 8;

            if ( $push_exit != 0 ) {
                say sprintf '   ✗ Failed to push to %s (exit: %d)', $remote,
                    $push_exit;
                push @failed_remotes, $remote;
                $all_success = 0;
            } else {
                say sprintf '   ✓ Successfully pushed to %s', $remote;
            }
        }

        say '';

        if ($all_success) {
            say sprintf ' : ✓ Successfully pushed to all %d remote(s)',
                scalar(@remotes_to_push);
            say '';
        } else {
            say sprintf ' : ⚠ WARNING: Failed to push to %d remote(s): %s',
                scalar(@failed_remotes), join( ', ', @failed_remotes );
            say ' : Note: Changes are committed locally '
                . 'and may be pushed to some remotes';
            say '';
            return TRUE;
        }
    SKIP_PUSH:
    }
} else {
    say ' : [Skipped push - --no-push flag]';
    say '';
}

## Summary
say ' .:[ COMPLETE ]:.';
say '';
say sprintf ' : Key mode: %s', $key_mode;
say sprintf ' : Key used: %s', $use_test_key ? $test_key_name : $sig_key_name;
say sprintf ' : Commit message: %s', $commit_message;

if ($no_push) {
    say ' : Pushed: no (--no-push flag)';
} elsif ( length $specific_remote ) {
    say sprintf ' : Pushed to: %s', $specific_remote;
} elsif ( ref(<work.git.remotes>) eq 'ARRAY'
    && @{<work.git.remotes>} ) {
    say sprintf ' : Pushed to: %s', join( ', ', @{<work.git.remotes>} );
} else {
    say ' : Pushed to: origin';
}

say '';

return FALSE;

