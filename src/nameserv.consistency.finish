## [:< ##

# name  = nameserv.consistency.finish
# descr = log new \ resolved findings, store the run result

## a finding logs at level 1 only when it is new or changed since the previous
## run ; a finding that disappeared logs ': resolved :' once.  the last run is
## kept for the nameserv.consistency command.

my $state = shift;

my $new_findings = $state->{'findings'};
my $previous     = <nameserv.consistency.last_findings> // {};

for my $text ( sort keys %$new_findings ) {
    next if $previous->{$text};
    <[base.logs]>->( 1, ': consistency : %s', $text );
}

for my $text ( sort keys %$previous ) {
    next if $new_findings->{$text};
    <[base.logs]>->( 1, ': consistency : resolved : %s', $text );
}

my @findings = sort keys %$new_findings;

<nameserv.consistency.last_findings> = {%$new_findings};
<nameserv.consistency.last_run>      = {
    'time'     => $state->{'started'},
    'findings' => \@findings,
};
$state->{'active'} = FALSE;

return TRUE;

