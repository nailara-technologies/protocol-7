## [:< ##

# name  = coding.gpu_lease.handler.renew
# descr = renew the coding gpu lease before its models-side timeout

return FALSE if ( <coding.gpu_lease.holder> // '' ) ne qw| coding |;

<[protocol-7.route-send]>->(
    {   'command'   => qw| models.gpu-lease-renew |,
        'call_args' => { 'args' => qw| coding | },
        'reply'     => {
            'handler' => qw| coding.gpu_lease.handler.renew_reply |,
            'params'  => {},
        },
    }
);
my $timeout = <models.cfg.gpu_lease.timeout> // 45;
$timeout = 45 if $timeout !~ m|^\d+$| or $timeout < 5;
<coding.gpu_lease.renew_timer> = <[event.add_timer]>->(
    {   'after'   => $timeout / 3,
        'handler' => qw| coding.gpu_lease.handler.renew |,
    }
);
return TRUE;

