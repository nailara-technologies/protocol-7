## [:< ##

# name  = branch.resource.task
# descr = task reference convenience wrapper
# param = { node, op, task_id }
#
# op = 'attach' | 'get' | 'detach'
# data is a task_id string

my $params  = shift                // {};
my $node    = $params->{'node'}    // '';
my $op      = $params->{'op'}      // '';
my $task_id = $params->{'task_id'} // '';

return { 'mode' => 'false', 'data' => 'node id required' }
    unless length $node;
return { 'mode' => 'false', 'data' => 'operation required' }
    unless length $op;

if ( $op eq 'attach' ) {
    return { 'mode' => 'false', 'data' => 'task_id required' }
        unless length $task_id;

    return <[branch.resource.attach]>->(
        {   'node' => $node,
            'type' => 'task',
            'data' => $task_id,
            'id'   => $task_id
        }
    );
} elsif ( $op eq 'get' ) {
    my $get_params = {
        'node' => $node,
        'type' => 'task'
    };
    $get_params->{'id'} = $task_id if length $task_id;

    return <[branch.resource.get]>->($get_params);
} elsif ( $op eq 'detach' ) {
    my $detach_params = {
        'node' => $node,
        'type' => 'task'
    };
    $detach_params->{'id'} = $task_id if length $task_id;

    return <[branch.resource.detach]>->($detach_params);
}

return { 'mode' => 'false', 'data' => 'unknown operation' };

