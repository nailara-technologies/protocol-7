## [:< ##

# name  = osf-cache.handler.segment_reply
# descr = write one arrived segment, continue or verify
#
# reply handler for the '<sid>.segment' requests of the fetch flow [
# one outstanding at a time ]. a TRUE reply carries '<offset> <bytes>
# <b32>' in call_args.args, a SIZE reply in data ; FALSE or anything
# else is a failed segment. the payload must match what was asked :
# the offset equals the fetch offset, the byte count equals the
# request length [ the last segment may be shorter only in that the
# request itself was shorter ] and decode_b32r must return exactly
# that many bytes - anything else retries [ osf-cache.fetch.retry ].
# a good segment is written to the partial file raw, the offset
# advances and the next segment is requested ; when the size is
# reached the partial is closed and osf-cache.fetch.complete verifies
# it. a fetch the failure path already cleaned up is gone from
# <osf-cache.fetch.pending> and this reply is dropped ; so is a late
# reply to a timed-out request [ its seq is no longer current ].

my $reply     = shift                 // {};
my $params    = $reply->{'params'}    // {};
my $fetch_key = $params->{'fetch_key'} // return;

my $state = <osf-cache.fetch.pending>->{$fetch_key};
return unless ref $state eq qw| HASH |;

## a reply to an earlier, timed-out request : the retry already owns ##
## the offset and the timer - dropped, never written or retried      ##
return unless ( $params->{'seq'} // -1 ) == ( $state->{'seq'} // 0 );

## the reply arrived : the per-segment timer is done ##
if ( defined $state->{'timer'}
    and eval { $state->{'timer'}->is_active } ) {
    $state->{'timer'}->cancel;
}

my $cmd     = $reply->{'cmd'} // '';
my $payload = '';
if ( $cmd eq qw| TRUE | ) {
    $payload = $reply->{'call_args'}{'args'} // '';
} elsif ( $cmd eq qw| SIZE | ) {
    $payload = $reply->{'data'} // '';
} else {
    <[base.logs]>->(
        0,
        ': osf-cache : segment reply %s from %s [ %s ]',
        length $cmd ? $cmd : 'no cmd',
        $state->{'current_sid'} // '',
        $reply->{'call_args'}{'args'} // $reply->{'data'} // ''
    );
}

my ( $offset, $bytes, $b32 );
my $decoded;
my $good = 0;
if (    length $payload
    and ( $offset, $bytes, $b32 )
    = $payload =~ m{^(\d+) (\d+) ([A-Z2-7]+)$}o ) {
    <[base.perlmod.autoload]>->( 'Crypt::Misc', qw| decode_b32r | );
    $decoded = eval { decode_b32r($b32) };
    $good = 1
        if $offset == $state->{'offset'}
        and $bytes == $state->{'want'}
        and defined $decoded
        and length $decoded == $bytes;
    if ($good) {
        print { $state->{'fh'} } $decoded
            or $good = 0;
    }
}

if ( !$good ) {
    <[osf-cache.fetch.retry]>->( { 'fetch_key' => $fetch_key } );
    return;
}

$state->{'offset'}  += $bytes;
$state->{'segments'}++;

if ( $state->{'offset'} >= $state->{'size'} ) {
    close( $state->{'fh'} );
    delete $state->{'fh'};
    <[osf-cache.fetch.complete]>->( { 'fetch_key' => $fetch_key } );
} else {
    <[osf-cache.fetch.request]>->( { 'fetch_key' => $fetch_key } );
}

return;

