## [:< ##

# name  = events.signal.access
# descr = may a zenka raise this signal [ access.signals ]
# the names come from cfg/zenki/events/access.signals [ events.signal.grants ]
#   signal.<zenka> = <name> .. ; a name, <prefix>.* or * [ every name ]
# the cube routes `events.signal` [ access.zenki ] ; this decides the names.
# `signal.*` [ the wildcard zenka ] applies to everyone.
#
# args   = source zenka, signal name
# return = TRUE \ FALSE

my ( $source, $name ) = @ARG;
return FALSE if not defined $source or not defined $name;

my $grants = <[events.signal.grants]>->() // return FALSE;
foreach my $who ( $source, qw| * | ) {
    foreach my $grant ( @{ $grants->{$who} // [] } ) {
        return TRUE if $grant eq $name or $grant eq qw| * |;
        if ( $grant =~ m{\A(.+)\.\*\z} ) {
            my $prefix = $1;
            return TRUE if index( $name, $prefix . qw| . | ) == 0;
        }
    }
}

return FALSE;

