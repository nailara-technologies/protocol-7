## [:< ##

# name  = events.signal.access
# descr = may a zenka raise this signal [ access.zenki ]
# a signal is granted like a command : in the raising zenka's list
# [ access.cmd.usr.<zenka> ] of cfg/zenki/cube/access.zenki, as a token
#   events.signal.<signal name>      exactly that signal
#   events.signal.<prefix>.*         every signal under that prefix
#   events.signal.*                  every signal
# the generic `events.signal` token lets the cube route the call ; the
# per-name tokens decide here which names pass. a zenka list under the
# wildcard user [ access.cmd.usr.* ] applies to everyone.
#
# args   = source zenka, signal name
# return = TRUE \ FALSE

my ( $source, $name ) = @ARG;
return FALSE if not defined $source or not defined $name;

my $grants = <[events.access.grants]>->() // return FALSE;
foreach my $who ( $source, qw| * | ) {
    foreach my $token ( @{ $grants->{$who} // [] } ) {
        next if $token !~ m{\Aevents\.signal\.(.+)\z};
        my $grant = $1;
        return TRUE if $grant eq $name or $grant eq qw| * |;
        if ( $grant =~ m{\A(.+)\.\*\z} ) {
            my $prefix = $1;
            return TRUE if index( $name, $prefix . qw| . | ) == 0;
        }
    }
}

return FALSE;

