## [:< ##

# name  = models.handler.task-touch
# descr = timer : renews each leased claim [ task.touch ] a third
#         of its lease after the last renewal -- while its work
#         lives : a claim whose coding instance is gone [ restart ]
#         is dropped, not renewed [ models.task.drop-claim ]

my $claimed = <models.task.claimed>         // {};
my $agent   = <models.cfg.task_agent>       // qw| models |;
my $coding  = <models.task.coding_instance> // '';

foreach my $task_id ( keys $claimed->%* ) {
    my $claim = $claimed->{$task_id};
    next if ref $claim ne qw| HASH | or not defined $claim->{'lease'};

    my $since = time - ( $claim->{'touched'} // $claim->{'at'} // time );
    next if $since < $claim->{'lease'} / 3;

    if ( length( $claim->{'owner_instance'} // '' )
        and $claim->{'owner_instance'} ne $coding ) {
        <[base.logs]>->(
            0,        ': task %s : coding instance %s gone, claim dropped',
            $task_id, $claim->{'owner_instance'}
        );
        ## the claim is still active at the task zenka : hand it back ##
        <[protocol-7.route-send]>->(
            {   'command' => <[models.task.cmd]>->( qw| release |, $task_id ),
                'call_args' =>
                    { 'args' => "$task_id $agent coding instance gone" },
            }
        );
        <[models.task.drop-claim]>->( $task_id, 'coding instance gone' );
        next;
    }

    ## one renewal in flight -- a lost reply [ route collapsed ] stops ##
    ## blocking after a third of the lease                             ##
    next
        if $claim->{'touch_pending'}
        and time - $claim->{'touch_pending'} < $claim->{'lease'} / 3;
    $claim->{'touch_pending'} = time;

    <[protocol-7.route-send]>->(
        {   'command'   => <[models.task.cmd]>->( qw| touch |, $task_id ),
            'call_args' => { 'args' => "$task_id $agent" },
            'reply'     => {
                'handler' => qw| models.handler.task-touch-reply |,
                'params'  => { 'task_id' => $task_id },
            },
        }
    );
}

return;

