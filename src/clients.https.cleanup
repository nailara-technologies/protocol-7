## [:< ##

# name  = clients.https.cleanup
# descr = cancel watchers and close ssl socket for a request state

my $state = shift // {};

for my $key (qw| timeout_watcher io_watcher |) {
    if ( defined $state->{$key} ) {
        eval { $state->{$key}->cancel };
        delete $state->{$key};
    }
}

## break state <-> http/2 codec reference cycle, if any ##
delete $state->{'h2'} if defined $state->{'h2'};

if ( defined $state->{'sock'} ) {
    eval { $state->{'sock'}->close( SSL_no_shutdown => 1 ) };
    delete $state->{'sock'};
}

