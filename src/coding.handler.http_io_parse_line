## [:< ##

# name  = coding.handler.http_io_parse_line
# descr = parse a single SSE or raw JSON line from HTTP stream

my ( $line, $state, $callbacks ) = @ARG;

return unless length($line);

## strip trailing \r ##
$line =~ s|\r$||;

## skip hex chunk size lines [ chunked encoding ] ##
return if $line =~ m|^[0-9a-fA-F]+$|;

## skip SSE headers and empty lines ##
return if $line =~ m|^:$|;         # keep-alive comment
return if $line =~ m|^event:|i;    # event type header
return if $line =~ m|^id:|i;       # event ID

<[base.logs]>->( 2, "async.http_io: processing line [%s]", $line );

## extract data from SSE format ##
my $json_str;
if ( $line =~ m|^data:\s*(.+)| ) {
    $json_str = $1;
} else {
    ## try parsing as raw JSON [ fallback ] ##
    $json_str = $line;
}

## handle [DONE] marker ##
return if $json_str eq '[DONE]';

## skip empty JSON strings ##
return unless length($json_str);

$state->{'chunks_received'}++;

## cancel data-start timeout on first chunk ##
if ( $state->{'chunks_received'} == 1
    and defined $state->{'data_start_watcher'} ) {
    eval { $state->{'data_start_watcher'}->cancel() };
    delete $state->{'data_start_watcher'};
    <[base.logs]>->( 2, "async.http_io: data-start timeout cancelled" );
}

## parse JSON ##
my $data = eval { $state->{'json_decoder'}->decode($json_str) };
if ($@) {
    <[base.logs]>->(
        0,         "async.http_io: JSON parse error [%s]: %s",
        $json_str, $@ // 'unknown'
    );
    return;
}

## debug: log data type ##
if ( $state->{'chunks_received'} < 3 ) {
    my $type = ref($data) || qw| SCALAR |;
    <[base.logs]>->( 2, "async.http_io: decoded data type=%s", $type );
}

## abort-pattern check : terminate stream immediately on match ##
my $abort_match = <[coding.abort.check_stream]>->( $state, $data );
if ( defined $abort_match ) {
    $state->{'abort_triggered'} = TRUE;
    $state->{'abort_match'}     = $abort_match;
    <[base.logs]>->(
        0,
        "async.http_io: abort triggered for task %s by pattern %s",
        $abort_match->{'task_id'}    // '',
        $abort_match->{'pattern_id'} // ''
    );
    $callbacks->{'on_abort'}->($state)
        if exists $callbacks->{'on_abort'};
    <[coding.async.http_cleanup]>->($state);
    return;
}

## degenerate repetition check : cheap regex against a bounded tail window  ##
## regardless of total accumulated length - catches a model looping on its  ##
## own output while technically still "alive" [ chunks flowing ], a case    ##
## the total-duration timeout no longer catches early on its own now that   ##
## it extends whenever the stream shows activity [ see                      ##
## coding.handler.http_timeout ]. lives here rather than per-caller so both ##
## self-test's probes [ no task_id, no abort patterns configured ] and real ##
## tasks get it uniformly                                                   ##
my $choice0
    = ref( $data->{'choices'} ) eq qw| ARRAY |
    ? $data->{'choices'}[0] // {}
    : {};
my $delta0 = $choice0->{'delta'} // $choice0->{'message'} // {};
my $piece  = ( $delta0->{'content'} // '' )
    . ( $delta0->{'reasoning_content'} // '' );

if ( length $piece ) {
    my $rc = $state->{'repetition_ctx'} //= { accumulated => '' };
    $rc->{'accumulated'} .= $piece;

    ## only the tail matters for detection - cap retained history so a ##
    ## long-but-healthy response never grows this unbounded            ##
    substr( $rc->{'accumulated'}, 0, length( $rc->{'accumulated'} ) - 1200,
        '' )
        if length( $rc->{'accumulated'} ) > 2000;

    my $rep_match
        = <[coding.detect_stream_repetition]>->( $rc->{'accumulated'} );
    if ( defined $rep_match ) {
        <[base.logs]>->(
            0,
            "async.http_io: degenerate repetition "
                . "detected for task %s [unit=%d chars]",
            $state->{'task_id'} || '[none]',
            $rep_match->{'unit_len'} // 0
        );
        $state->{'abort_triggered'} = TRUE;
        $state->{'abort_match'}     = {
            pattern_id => qw| degenerate_repetition |,
            matched    => $rep_match->{'matched'},
            task_id    => $state->{'task_id'} // '',
        };
        if ( exists $callbacks->{'on_abort'} ) {
            ## real tasks : same recovery path already trusted for a ##
            ## pattern-based abort match                             ##
            $callbacks->{'on_abort'}->($state);
        } elsif ( exists $callbacks->{'on_error'} ) {
            ## no task machinery [ eg self-test probes ] : report through   ##
            ## on_error same as any other stream failure - self_test.run's  ##
            ## own retry classification treats this as non-retryable [      ##
            ## correctly - see coding.handler.http_timeout's history ], and ##
            ## for the cat-test prompt specifically it flows straight into  ##
            ## monitor_inference_startup's existing seed-restart path the   ##
            ## same as any other prompt-2 failure                           ##
            $callbacks->{'on_error'}->('degenerate_stream');
        }
        <[coding.async.http_cleanup]>->($state);
        return;
    }
}

## call on_chunk callback ##
if ( exists $callbacks->{'on_chunk'} ) {
    <[base.logs]>->( 2, "async.http_io: calling on_chunk callback" );
    $callbacks->{'on_chunk'}->($data);
}

return;

