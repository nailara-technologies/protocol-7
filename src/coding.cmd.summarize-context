## [:< ##

# name  = coding.cmd.summarize-context
# descr = summarize content via inference [ model-pinned ]

my $args_str = $call->{'args'} // '';

## parse options from args first, then remainder is bare content ##
my $focus   = '';
my $model   = '';
my $backend = qw| cpu |;
my $store   = 0;
my $node_id = '';
my $max_len = 800;
my $path    = '';

my $callback_id = '';
my $tree        = 0;
my $origin      = '';
my $thinking    = '';

if ( $args_str =~ s|focus=(\S+)|| )         { $focus       = $1 }
if ( $args_str =~ s|model=(\S+:\S+)|| )     { $model       = $1 }
if ( $args_str =~ s{backend=(cpu\|gpu)}{} ) { $backend     = $1 }
if ( $args_str =~ s|store=(\d+)|| )         { $store       = $1 }
if ( $args_str =~ s|node_id=(\S+)|| )       { $node_id     = $1 }
if ( $args_str =~ s|max_len=(\d+)|| )       { $max_len     = $1 }
if ( $args_str =~ s|path=(\S+)|| )          { $path        = $1 }
if ( $args_str =~ s|callback_id=(\S+)|| )   { $callback_id = $1 }
if ( $args_str =~ s|tree=(\d+)|| )          { $tree        = $1 }
if ( $args_str =~ s|origin=(\S+)|| )        { $origin      = $1 }
if ( $args_str =~ s|thinking=(\d)|| )       { $thinking    = $1 }
$args_str =~ s{^\s+|\s+$}{}g;    ## trim remaining whitespace ##

## content: multiline data takes precedence, else remaining args ##
my $content = $call->{'data'} // $args_str;

## summaries take larger input than prompts [ 4 MiB default ] ##
my $max_size = <coding.cfg.summarize-max-size> // 4194304;

## path=<path> option : same confined read as ':file:' [ repo tree only ; ##
## outside it the caller reads the file and sends ':B32:' content ]       ##
$content = ":file:$path" if length $path;

## shared input decoder : explicit prefixes only [ :B32:, :file:, :path: ] ##
if ( length $content ) {
    my $decoded = <[coding.input.decode]>->(
        {   'input'    => $content,
            'caller'   => qw| coding.cmd.summarize-context |,
            'max_size' => $max_size
        }
    );
    return { mode => qw| false |, data => $decoded->{'error'} }
        unless $decoded->{'success'};
    $content = $decoded->{'content'};
}

return { mode => qw| false |, data => 'content required' }
    unless length $content;

## tree=0 [ default ] : unchanged direct path, byte-for-byte as before ##
unless ($tree) {
    return <[coding.tools.handler.summarize_enqueue]>->(
        {   content     => $content,
            focus       => $focus,
            reply_id    => $call->{'reply_id'},
            callback_id => $callback_id,
            ( length $thinking ? ( thinking => $thinking ) : () ),
        }
    );
}

## tree=1 : best-effort cache query against the task-zenka summary tree    ##
## before spending an inference call. content-addressed so growing content ##
## [ same session, more days of conversation ] always misses and           ##
## re-summarizes                                                           ##
my $chk_input = "$focus\x00$content";
## bmw-L13 : 13-char base32 [ ~65 bits ], far lower collision risk than the ##
## 7-char amos chksum cap                                                   ##
my $chk = <[chk-sum.bmw.L13-str]>->($chk_input);

<coding.tree_query_pending> //= {};
my $query_id = <[base.gen_id]>->(<coding.tree_query_pending>);

my $pending = {
    'query_id'    => $query_id,
    'reply_id'    => $call->{'reply_id'},
    'callback_id' => $callback_id,
    'chk'         => $chk,
    'origin'      => $origin,
    'enqueue'     => {
        content => $content,
        focus   => $focus,
        ( length $thinking ? ( thinking => $thinking ) : () ),
    },
};

## fallback timer : query is best-effort, never block the caller on a    ##
## slow/unreachable task zenka — proceed to inference exactly as if tree ##
## had been absent                                                       ##
$pending->{'timeout_timer'} = <[event.add_timer]>->(
    {   'after'   => 3,
        'repeat'  => FALSE,
        'handler' => qw| coding.handler.tree_query_timeout |,
        'data'    => { 'query_id' => $query_id },
    }
);

<coding.tree_query_pending>->{$query_id} = $pending;

my $sent = <[protocol-7.route-send]>->(
    {   'command'   => 'task.summary-tree-query',
        'call_args' => { 'args' => "chk=$chk callback_query_id=$query_id", },
    }
);

## task zenka unreachable right now : don't wait on the timer, miss now ##
unless ($sent) {
    if ( eval { $pending->{'timeout_timer'}->is_active } ) {
        $pending->{'timeout_timer'}->cancel;
    }
    delete <coding.tree_query_pending>->{$query_id};
    return <[coding.tools.handler.summarize_enqueue]>->(
        {   content     => $content,
            focus       => $focus,
            reply_id    => $call->{'reply_id'},
            callback_id => $callback_id,
            chk         => $chk,
            origin      => $origin,
            ( length $thinking ? ( thinking => $thinking ) : () ),
        }
    );
}

return { mode => qw| deferred | };

