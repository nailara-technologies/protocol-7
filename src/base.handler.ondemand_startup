## [:< ##

# name  = base.handler.ondemand_startup
# param = error reason [ FALSE reply ]

my $reply = shift;
my $v_id  = $reply->{'params'}->{'v_id'};

if ( $reply->{'cmd'} eq qw| FALSE | ) {
    delete <zenki.virtual>->{$v_id}->{'starting'};
    delete <zenki.virtual>->{$v_id}->{'starting_since'};
    <zenki.virtual>->{$v_id}->{'start_status'} = qw| failed |;
    if ( defined <zenki.virtual>->{$v_id}->{'timer'}->{'starting_watchdog'} )
    {
        <zenki.virtual>->{$v_id}->{'timer'}->{'starting_watchdog'}->cancel;
        delete <zenki.virtual>->{$v_id}->{'timer'}->{'starting_watchdog'};
    }
    my $reason = $reply->{'call_args'}->{'args'};
    ## 'blocked :' = a deliberate refusal by the starter, not a failure ##
    if ( $reason =~ s{^blocked : }{} ) {
        <[base.log]>->( 1, "ondemand zenka startup blocked [ $reason ]" );
    } else {
        <[base.log]>->(
            0, "ondemand zenka startup not successful [ $reason ]"
        );
    }
    while ( my $element = shift @{ <zenki.virtual>->{$v_id}->{'queue'} } ) {
        my $sid    = $element->{'source_id'};
        my $cmd_id = $element->{'src_cmd_id'} // 0;
        next if not exists $data{'session'}{$sid};

        my $cmd_id_str = $cmd_id > 0 ? sprintf( '(%d)', $cmd_id ) : '';
        $data{'session'}{$sid}{'buffer'}{'output'}
            .= <[base.sprint_t]>->( qw| IRW7V6A |, $cmd_id_str );
    }
} else {
    <[protocol-7.command.send.local]>->(
        {   'command'   => qw| v7-zenki.notify_online |,
            'call_args' => { qw|args| => <zenki.virtual>->{$v_id}->{'name'} },
            'reply'     => {
                'handler' => qw| base.zenki.ondemand.handler.startup_reply |,
                'params'  => { qw| v_id | => $v_id }
            }
        }
    );
}

