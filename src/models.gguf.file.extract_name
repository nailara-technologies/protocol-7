## [:< ##

# name = models.gguf.file.extract_name
# descr = Extract canonical model name from GGUF file metadata
# param = $file_path
# return = $canonical_name (string) or ($name, $quantization) in list context
#
# Name composition strategy (in priority order):
#   1. If general.name is valid (not garbage) -> use it
#   2. If general.basename + general.size_label exist -> "basename size_label"
#   3. If general.basename exists -> use basename
#   4. Fallback to cleaned filename with file_type quantization
#   5. Fallback to cleaned filename only

my $file_path = shift;
return undef unless defined $file_path && -f $file_path;

## Get filename for fallback
my $filename = $file_path;
$filename =~ s|.*/||;
$filename =~ s|\.gguf$||i;

## Clean filename (strip quantization suffix) [ '.' separates it too : ##
## unsloth exports are named 'Qwen3.5-9B.Q8_0.gguf' ]                   ##
my $clean_filename = $filename;
$clean_filename =~ s|[-_.]?[IQ][0-8](?:_[A-Z0-9_]+)?\s*$||i;
$clean_filename =~ s|[-_.]$||;
$clean_filename =~ s|_| |g;

## Strip mmproj references and trailing precision indicators
$clean_filename =~ s|\s*\.?mmproj[-_\s]?[a-z0-9]*\s*||gi;
$clean_filename =~ s|\s+| |g;
$clean_filename =~ s{^\s+|\s+$}{}g;

## a '<name>-GGUF' repo directory names one model : preferred over the ##
## file name below once the metadata has no usable name -- export tools ##
## name files after the base model, three different 9b finetunes were   ##
## all registered as 'Qwen3.5-9B' from 'Qwen3.5-9B.Q8_0.gguf'           ##
if ( $file_path =~ m{/([^/]+)-GGUF/[^/]+\.gguf$}i ) {
    ( my $repo_name = $1 ) =~ s{[-_\s]+}{ }g;
    $repo_name =~ s{^\s+|\s+$}{}g;
    $clean_filename = $repo_name if length $repo_name > 5;
}

## a bare projector file [ 'mmproj.gguf', 'mmproj-BF16.gguf' ] cleans to ##
## nothing : the repo directory names it instead [ e.g. Jackrong/<model> ##
## -GGUF/mmproj-BF16.gguf was registered with an empty name ]            ##
if ( !length $clean_filename
    and $file_path =~ m{/([^/]+?)(?:-GGUF)?/[^/]+\.gguf$}i ) {
    ( $clean_filename = $1 ) =~ s{[-_\s]+}{ }g;
    $clean_filename =~ s{^\s+|\s+$}{}g;
}

## Extract metadata using external module
my $meta = <[models.gguf.file.extract_metadata]>->($file_path);

## Strategy 1: Use general.name if valid
if ( $meta && $meta->{'general.name'} ) {
    my $name = $meta->{'general.name'};

    ## Basic cleanup
    $name =~ s|_| |g;
    $name =~ s|\s+| |g;
    $name =~ s{^\s+|\s+$}{}g;

    ## Strip mmproj references (clean metadata artifacts)
    $name =~ s|\s*\.?mmproj[-_\s]?\w*\s*||gi;
    $name =~ s|\s+| |g;
    $name =~ s{^\s+|\s+$}{}g;

    ## Check if name is valid (not garbage)
    unless ( <[models.gguf.file.is_garbage_name]>->($name) ) {

        ## community gguf conversions -- especially finetunes, loras, and
        ## merges -- routinely leave general.name at the BASE model's name,
        ## carried over unchanged from the conversion template [ confirmed on
        ## real files 2026-09-20 : general.name = "Qwen2.5 7B Instruct" for a
        ## file whose actual identity, per its own  general.source.url, is
        ## "qwen_openthoughts_science_claude" ] -- the source/gguf-repo url is
        ## the one field that's mechanically accurate, so prefer a name
        ## derived from it when it diverges meaningfully from general.name
        my $url = $meta->{'general.source.url'} || $meta->{'general.url'};
        if ($url) {
            my ($slug)
                = $url =~ m{^https?://huggingface\.co/[^/]+/([^/]+?)/?$}i;
            if ( defined $slug ) {

                ## only the gguf-repackaging repo [ general.url ] carries a
                ## quantizer suffix -- the original source repo never does
                $slug =~ s|-i?\d*-GGUF$||i;
                $slug =~ s|-GGUF$||i;
                $slug =~ s|-GGML$||i;

                my $slug_name = $slug;
                $slug_name =~ s|[-_]| |g;
                $slug_name =~ s|\s+| |g;
                $slug_name =~ s{^\s+|\s+$}{}g;

                ## repo slugs are typically all-lowercase [ unlike
                ## general.name, which usually already arrives title-cased
                ## from the writer ] -- match that display convention
                $slug_name = join ' ', map { ucfirst( lc($_) ) }
                    split m|\s+|, $slug_name;

                if ( not <[models.gguf.file.is_garbage_name]>->($slug_name)
                    and
                    <[models.gguf.file.name_diverges]>->( $name, $slug_name )
                ) {
                    return $slug_name;
                }
            }
        }

        return $name;
    }
}

## Strategy 2: Combine basename + size_label
if ( $meta && $meta->{'general.basename'} && $meta->{'general.size_label'} ) {
    my $base = $meta->{'general.basename'};
    my $size = $meta->{'general.size_label'};

    $base =~ s|_| |g;
    $base =~ s|-| |g;
    $base =~ s|\s+| |g;
    $base =~ s|\s*\.?mmproj[-_\s]?\w*\s*||gi;    ## Strip mmproj
    $base =~ s|\s+| |g;

    ## a basename of only 'mmproj' leaves nothing : fall through ##
    return "$base $size" if $base =~ m|\S|;
}

## Strategy 3: Use basename only
if ( $meta && $meta->{'general.basename'} ) {
    my $base = $meta->{'general.basename'};
    $base =~ s|_| |g;
    $base =~ s|-| |g;
    $base =~ s|\s+| |g;
    $base =~ s|\s*\.?mmproj[-_\s]?\w*\s*||gi;    ## Strip mmproj
    $base =~ s|\s+| |g;

    ## a basename of only 'mmproj' leaves nothing : fall through ##
    if ( $base =~ m|\S| ) {
        ## Include file_type quantization if available
        if ( defined $meta->{'general.file_type'} ) {
            my $quant = <[models.gguf.file.file_type_to_quant]>
                ->( $meta->{'general.file_type'} );
            return wantarray ? ( $base, $quant ) : $base;
        }
        return $base;
    }
}

## Strategy 4: Fallback to cleaned filename with file_type quantization
if ( $meta && defined $meta->{'general.file_type'} ) {
    my $quant = <[models.gguf.file.file_type_to_quant]>
        ->( $meta->{'general.file_type'} );
    return wantarray ? ( $clean_filename, $quant ) : $clean_filename;
}

## Strategy 5: Try parent directory name if it looks like a model name
## e.g., "/path/Qwen3.5-9B-Claude-Distilled-v2-GGUF/model-Q8.gguf"
my $parent_name = '';
if ( $file_path =~ m|/([^/]+)-GGUF/[^/]+\.gguf$|i ) {
    $parent_name = $1;
    $parent_name =~ s|-| |g;
    $parent_name =~ s|_| |g;
    $parent_name =~ s|\s+| |g;
    $parent_name =~ s{^\s+|\s+$}{}g;
    ## Append quantization if extracted from filename
    my $parent_quant;
    if ( $clean_filename =~ m|([IQ][0-8](?:_[A-Z0-9_]+)?)|i ) {
        $parent_quant = uc($1);
        $parent_name .= ' ' . $parent_quant;
    }
    return wantarray ? ( $parent_name, $parent_quant ) : $parent_name
        if length($parent_name) > 5;
}

## Strategy 6: Fallback to cleaned filename only
return $clean_filename;

