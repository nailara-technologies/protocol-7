## [:< ##

# name = X-11.start_gpu_top

return if defined <X-11.gpu_top.process_started>;

my $vendor = <X-11.gpu_vendor> // 'none';

return <[base.log]>->( 2, 'gpu monitoring disabled [ no supported tool ]' )
    if $vendor eq 'none';

if ( $vendor eq 'nvidia' ) {
    my $nvidia_bin = <X-11.bin_path>->{'nvidia-smi'};

    <[base.log]>->( 1, "starting 'nvidia-smi' gpu monitor .," );

    <X-11.gpu_top.pid> = open3(
        undef, my $out_fh, undef, $nvidia_bin,
        qw| --query-gpu=utilization.gpu |,
        '--format=csv,noheader,nounits',
        qw| -l 1 |
    );

    if ( !<X-11.gpu_top.pid> ) {
        <[base.log]>->(
            0, "<< cannot open 'nvidia-smi' pipe [ \l$OS_ERROR ] >>"
        );
        return;
    }
    push( <system.kill_list>->@*, <X-11.gpu_top.pid> );

    <X-11.gpu_top.process_started> = <[base.ntime]>;
    <X-11.gpu_top.out_fh>          = $out_fh;   ## keep fh alive past scope ##

    <[event.add_io]>->(
        {   'fd'      => $out_fh,
            'handler' => qw| X-11.handler.read_gpu_nvidia |,
            'data'    => { 'pid' => <X-11.gpu_top.pid> }
        }
    );

    ## parallel feeds for additional single-value metrics [ generic ] ##
    <[X-11.start_gpu_metric_feed]>->(
        { 'metric' => qw| temp |, 'query_field' => qw| temperature.gpu | } );
    <[X-11.start_gpu_metric_feed]>
        ->( { 'metric' => qw| clock |, 'query_field' => qw| clocks.sm | } );
    <[X-11.start_gpu_metric_feed]>
        ->( { 'metric' => qw| power |, 'query_field' => qw| power.draw | } );

    ## clock throttle reason bits                                         ##
    ## [ hex ; thermal 0x20 \ 0x40, power cap 0x04 \ 0x80, idle 0x01 ] -- ##
    ## averages of a bitmask mean nothing, consumers use the 1s value     ##
    <[X-11.start_gpu_metric_feed]>->(
        {   'metric'      => qw| throttle |,
            'query_field' => qw| clocks_throttle_reasons.active |
        }
    );

} elsif ( $vendor eq 'intel' ) {
    my $refresh_period
        = 1137;    # def: 1000 [ careful with too low values --> CPU ]
    my $gpu_top_bin  = <X-11.bin_path.intel_gpu_top>;
    my $gpu_freq_bin = <X-11.bin_path.intel_gpu_frequency>;
    return <[base.log]>->(
        0,
        "<< not found : 'intel_gpu_top' [ 'intel-gpu-tools' installed ? ] >>"
    ) if !-x $gpu_top_bin;

    my $top_probe = <[base.exec.with_timeout]>->( 5, [ $gpu_top_bin, '-h' ] );
    return <[base.log]>->( 0, "<< cannot run 'intel_gpu_top' >>" )
        if not defined $top_probe or $top_probe !~ m|usage|;

    if ( length($gpu_freq_bin) and -x $gpu_freq_bin ) {
        my $freq_probe = <[base.exec.with_timeout]>->( 5, [$gpu_freq_bin] );
        return <[base.log]>->(
            0, '<< apparently no intel GPU [intel_gpu_frequency] >>'
            )
            if defined $freq_probe and $freq_probe =~ m|no intel gpu found|i;
    }

    <[base.log]>->( 1, "starting 'intel_gpu_top' process .," );

    <X-11.gpu_top.pid>
        = open3( undef, my $out_fh, undef,
        $gpu_top_bin, qw| -s |, $refresh_period, qw| -o - | );

    if ( !<X-11.gpu_top.pid> ) {
        <[base.log]>->(
            0, "<< cannot open 'intel_gpu_top' pipe [ \l$OS_ERROR ] >>"
        );
        return;
    }
    push( <system.kill_list>->@*, <X-11.gpu_top.pid> );

    <X-11.gpu_top.process_started> = <[base.ntime]>;

    <[event.add_io]>->(
        {   'fd'      => $out_fh,
            'handler' => qw| X-11.handler.read_gpu_top |,
            'data'    => { 'pid' => <X-11.gpu_top.pid> }
        }
    );
}

