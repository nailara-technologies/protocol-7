# name  = models.gpu_lease.llama_compute_pids
# descr = live llama compute processes [ invoke python is memory-judged ]

my @pids;
my $output
    = qx{ nvidia-smi --query-compute-apps=pid --format=csv,noheader,nounits 2>/dev/null };
return [] if $CHILD_ERROR != 0;

for my $pid ( $output =~ m|(\d+)|g ) {
    next unless open my $fh, '<', "/proc/$pid/cmdline";
    my $cmdline = do { local $INPUT_RECORD_SEPARATOR; <$fh> }
        // '';
    close $fh;
    push @pids, $pid if $cmdline =~ m{llama-(?:server|mtmd-cli)};
}
return \@pids;

