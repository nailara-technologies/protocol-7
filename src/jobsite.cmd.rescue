## [:< ##

# name  = jobsite.cmd.rescue
# descr = restore a job out of trash : args = "<id> [stage]"

my $args = $call->{'args'} // '';
$args =~ s{^\s+|\s+$}{}g;

my ( $id_in, $target_stage ) = split m|\s+|, $args, 2;
$target_stage //= 'review';

my $result = <[jobsite.job.rescue]>->( $id_in, $target_stage );

return {
    'mode' => $result->{'ok'} ? 'true' : 'false',
    'data' => $result->{'message'},
};

