## [:< ##

# name   = invoke-web.recover.requeue
# descr  = after the restart of a recovery [ cuda error \ zenka crash ] :
#          retry its victims, then resume the queue [ through
#          invoke-web.handler.recover_requeue_reply ]
# note   = victims : failed on 'CUDA error' since 15 minutes before the
#          recovery started, or canceled since then [ invoke.ai cancels
#          an interrupted in_progress item at its next start -- a manual
#          cancel from before the recovery stays untouched ]. never an
#          item that has a copy already

my $recover = <invoke-web.recover> // return;

## queue db times are utc ##
my $utc = sub { POSIX::strftime( '%Y-%m-%d %H:%M:%S', gmtime shift ) };

my $dbh = <[invoke-web.queue.db]>;
my $ids
    = defined $dbh
    ? $dbh->selectcol_arrayref(
    'SELECT q.item_id FROM session_queue q WHERE ( ( '
        . "q.status = 'failed' AND q.error_message LIKE 'CUDA error%' "
        . "AND q.updated_at >= ? ) OR ( q.status = 'canceled' "
        . "AND COALESCE( q.error_type, '' ) = '' AND q.updated_at >= ? ) ) "
        . 'AND NOT EXISTS ( SELECT 1 FROM session_queue c '
        . 'WHERE c.retried_from_item_id = q.item_id ) ORDER BY q.item_id',
    undef,
    $utc->( $recover->{'time'} - 900 ),
    $utc->( $recover->{'time'} )
    )
    : undef;

if ( not defined $ids or not @$ids ) {
    <[base.logs]>->(
        1, '%s : no interrupted items to retry',
        $recover->{'kind'}
    );
    return <[invoke-web.handler.recover_requeue_reply]>->( { 'ok' => TRUE } );
}

<[invoke-web.api_async]>->(
    'PUT',                      '/api/v1/queue/default/retry_items_by_id',
    [ map { $ARG + 0 } @$ids ], 'invoke-web.handler.recover_requeue_reply',
    { 'count' => scalar @$ids }
);

