## [:< ##

# name   = invoke-web.recover.requeue
# descr  = after the restart of a recovery [ cuda error \ zenka crash ] :
#          retry its victims, then resume the queue [ through
#          invoke-web.handler.recover_requeue_reply ]
# note   = victims : the items interrupted by the restart [ recorded by
#          invoke-web.queue.hold while invoke.ai was down ] and, for a cuda
#          recovery, the items that failed on 'CUDA error' since 15 minutes
#          before it. never an item retried before [ copy \ own record ] --
#          earlier cancels, manual ones included, are never touched

my $recover = <invoke-web.recover> // return;

my $dbh = <[invoke-web.queue.db]>;
my @ids = ( $recover->{'interrupted'} // [] )->@*;

if ( $recover->{'kind'} eq qw| gpu | and defined $dbh ) {
    my $since = POSIX::strftime( '%Y-%m-%d %H:%M:%S',
        gmtime( $recover->{'time'} - 900 ) );
    push @ids,
        (
        $dbh->selectcol_arrayref(
            "SELECT q.item_id FROM session_queue q WHERE q.status = 'failed' "
                . "AND q.error_message LIKE 'CUDA "
                . "error%' AND q.updated_at >= ? "
                . 'AND NOT EXISTS ( SELECT 1 FROM session_queue c '
                . 'WHERE c.retried_from_item_id = q.item_id )',
            undef, $since
        ) // []
        )->@*;
}

my $retried = <[invoke-web.retried]>;
my %seen;
@ids = sort { $a <=> $b }
    grep { not $retried->{$ARG} and not $seen{$ARG}++ } @ids;

if ( not @ids ) {
    <[base.logs]>->(
        1, '%s : no interrupted items to retry',
        $recover->{'kind'}
    );
    return <[invoke-web.handler.recover_requeue_reply]>->( { 'ok' => TRUE } );
}

<[invoke-web.api_async]>->(
    'PUT',
    '/api/v1/queue/default/retry_items_by_id',
    [ map { $ARG + 0 } @ids ],
    'invoke-web.handler.recover_requeue_reply',
    { 'count' => scalar @ids, 'ids' => [@ids] }
);

