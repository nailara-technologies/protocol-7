# name  = v7-zenki.sub-process.retrieve_cached_iid

my $pid = shift // '';
if ( $pid !~ m|^\d+$| ) {
    warn 'expected process id <{C1}>';
    return undef;
}

my $cache_ref   = <v7-zenki.process.instance_cache> // {};
my $instance_id = $cache_ref->{$pid};

foreach my $pid ( keys $cache_ref->%* ) {
    my $pid_stat = <[base.waitpid]>->($pid);    ##  WNOHANG  ##

    if ( $pid_stat <=> 0 ) {
        <[base.logs]>->(
            2, 'removing process %d from instance id cache.,', $pid
        );
        delete $cache_ref->{$pid};
    }
}

delete <v7-zenki.process.instance_cache> and undef $cache_ref
    if not keys $cache_ref->%*;

return $instance_id;

