## [:< ##

# name  = v7-zenki.callback.object.unix_group
# descr = start condition : a unix group exists [ unix_group.<name> ]
# note  = in a start.cfg : 'dependencies = cube unix_group.<name>' -- waits
#         for a condition, not for a whole zenka [ e.g. letsencr needs the
#         httpsd group, which appears when the httpsd zenka drops privs ;
#         a hard dependency on httpsd would block a dns-01-only host ]

my $object_id = shift;
return undef if not exists <dependency.object>->{$object_id};

my $name = <dependency.object>->{$object_id}->{'name'} // '';
return FALSE if not length $name;

return TRUE if defined scalar getgrnam($name);

## unmet : look again in a few seconds    ##
## [ no job move may come to trigger it ] ##
<[v7-zenki.condition.recheck_later]>;
return FALSE;

