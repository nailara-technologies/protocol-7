## [:< ##

# name = login-screen.authenticate
# descr = one framed password check, then a granted session or an unlock

my $locked = <login-screen.state> eq qw| locked |;
return FALSE if not $locked and <login-screen.state> ne qw| greeter |;
return FALSE if <login-screen.auth_in_flight>;
my $username
    = $locked
    ? <login-screen.session_user> // ''
    : <login-screen.widget.user>->get_text();
my $password = <login-screen.widget.password>->get_text();
my $wipe     = sub {
    return if not defined $_[0];
    $_[0] = "\0" x length( $_[0] );
};
my $fail = sub {
    my ( $message, $pulse ) = @ARG;
    <login-screen.auth_in_flight> = FALSE;
    if ($locked) {
        return FALSE if <login-screen.state> ne qw| locked |;
        my $sensitive = <login-screen.lock.grabbed> ? TRUE : FALSE;
        <login-screen.widget.password>->set_sensitive($sensitive);
        <login-screen.widget.button>->set_sensitive($sensitive);
        if ($pulse) {
            <[login-screen.lock_feedback]>->($message);
        } else {
            <login-screen.widget.status>->set_text($message);
        }
    } else {
        <[login-screen.show_greeter]>;
        <login-screen.widget.status>->set_text($message);
    }
    return FALSE;
};

if (   $username !~ m|^[a-z_][a-z0-9_-]{0,31}$|
    or $locked and $username ne ( <login-screen.session_user> // '' )
    or length($password) > 1024 ) {
    $wipe->($password);
    <login-screen.widget.password>->set_text('');
    return $fail->( 'authentication failed', TRUE );
}

<login-screen.auth_in_flight> = TRUE;
<login-screen.state>          = qw| authenticating | if not $locked;
<login-screen.widget.user>->set_sensitive(FALSE);
<login-screen.widget.password>->set_sensitive(FALSE);
<login-screen.widget.button>->set_sensitive(FALSE);
<login-screen.widget.status>->set_text('authenticating ..,');

Glib::Timeout->add(
    30,
    sub {
        my $reply = '';
        my $fh    = <login-screen.auth_helper.fh>;
        if ( defined $fh ) {
            my $frame = pack( 'n/a* n/a* C',
                $username, $password, $locked ? 1 : 0 );
            my $request = pack( 'N', length($frame) ) . $frame;
            $wipe->($frame);
            my $offset = 0;
            while ( defined $request and $offset < length($request) ) {
                my $written = syswrite( $fh, $request,
                    length($request) - $offset, $offset );
                last if not defined $written or $written == 0;
                $offset += $written;
            }
            $wipe->($request) if defined $request;
            if (
                $offset == 5 + 2 + length($username) + 2 + length($password) )
            {
                while ( $reply !~ m|\n$| and length($reply) < 128 ) {
                    my $read = sysread( $fh, my $part, 128 - length($reply) );
                    last if not defined $read or $read == 0;
                    $reply .= $part;
                }
            }
        }
        $wipe->($password);
        <login-screen.widget.password>->set_text('');
        if ( $locked and <login-screen.state> ne qw| locked |
            or not $locked and <login-screen.state> ne qw| authenticating | )
        {
            $wipe->($reply);
            $wipe->($username);
            return FALSE;
        }

        if ( $locked and $reply eq "OK\n" ) {
            <[login-screen.release_lock]>;
            <[protocol-7.route-send]>
                ->( { 'command' => 'v7-zenki.login-session-locked no' } );
            <login-screen.state> = qw| session |;
            <login-screen.widget.status>->set_text('');
            <login-screen.window>->hide()
                if not <login-screen.lock.unlock_fading>;
        } elsif ( not $locked and $reply =~ m|^OK ([0-9a-f]{64})\n$| ) {
            my $ticket = ${^CAPTURE}[0];
            <login-screen.state>        = qw| starting |;
            <login-screen.session_user> = $username;
            <login-screen.ticket>       = $ticket;
            <login-screen.widget.status>->set_text('starting session ..,');
            <[protocol-7.route-send]>->(
                {   'command' =>
                        "v7-zenki.login-session-start $username $ticket",
                    'reply' => {
                        'handler' =>
                            qw| login-screen.handler.session_start_reply |
                    }
                }
            );
            $wipe->($ticket);
        } elsif ( $reply =~ m|^WAIT (\d+)\n$| ) {
            $fail->( sprintf 'try again in %d s', ${^CAPTURE}[0] );
        } else {
            $fail->( 'authentication failed', TRUE );
        }
        $wipe->($reply);
        $wipe->($username);
        return FALSE;
    }
);
TRUE;

