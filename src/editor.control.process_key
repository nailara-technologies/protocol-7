## [:< ##

# name  = editor.control.process_key
# descr = dispatch one key against editor state ; SEMANTICS ONLY result

## ported from AMOS7::TERM::editor_process_key [ key dispatch only ]:
## - result is { action, field, dirty, signal?, passthrough? } — NO {output},
## no ANSI bytes, no %colors [ design: control_ui_boundary ]
## - all cursor arithmetic in CHARACTERS via editor.buffer.memory and
## editor.control.commands.* [ design: position_units ]
## - action=signal is ADVISORY: never kill() here, the host decides

my ( $editor_state, $key ) = @ARG;

return undef if !defined $editor_state or !defined $key;

my $schema    = $editor_state->{'schema'}       // return undef;
my $index     = $editor_state->{'active_field'} // 0;
my $field_def = $schema->{'fields'}[$index]     // return undef;
my $field     = $field_def->{'name'}            // return undef;
my $buffer    = <[editor.control.active_buffer]>->($editor_state)
    // return undef;

my $result = {
    'action' => 'none',
    'field'  => $field,
    'dirty'  => 'none',
};

my $multi_field = scalar $schema->{'fields'}->@* > 1 ? TRUE : FALSE;

## READONLY : block every MUTATING key, not just insertion.  the printable
## branch far below already checked $buffer->{'readonly'}, but delete,
## backspace, the kill commands and yank did not -- so a "read-only" field
## could still be emptied with Backspace.  navigation [ Tab, arrows, Ctrl-a /
## Ctrl-e ], submit and the advisory signal stay allowed, which is what makes
## a read-only row usable as a selectable MENU entry
state %mutating_key = map { $ARG => TRUE } (
    "\x04",     ## ctrl-d  delete at cursor  ##
    "\x0b",     ## ctrl-k  kill to end       ##
    "\x15",     ## ctrl-u  kill to start     ##
    "\x17",     ## ctrl-w  kill word back    ##
    "\x19",     ## ctrl-y  yank              ##
    "\x08",     ## backspace                 ##
    "\x7f",     ## backspace [ DEL ]         ##
    "\e[3~",    ## delete key                ##
    "\x1b[3~",
);

return $result if $buffer->{'readonly'} and $mutating_key{$key};

## Tab / Shift-Tab : field_next / field_prev — never fires for a ##
## single-field schema [ design: editor.control.process_key ]    ##
if ( $key eq "\x09" and $multi_field ) {
    $result->{'action'} = 'field_next';
    $result->{'dirty'}  = 'form';
    return $result;
}
if ( $key eq "\e[Z" and $multi_field ) {    ## Shift-Tab ##
    $result->{'action'} = 'field_prev';
    $result->{'dirty'}  = 'form';
    return $result;
}

## newline / enter : a MULTILINE field's own Enter inserts a line break rather
## than submitting -- checked before the schema-level submit_on, since
## submit_on is a FORM-wide default and this is a per-field override [
## user-edit-multiline-note.yaml's editing_model : narrower than wiring up the
## schema design doc's general per-field submit_on, which nothing else reads
## yet ].  '\n' is ord 10, which the printable-character branch far below (ord
## >= 32) already excludes, so this needs its own insert call rather than
## falling through to that one
if ( $key eq "\n" or $key eq "\r" ) {
    if ( $field_def->{'multiline'} ) {
        return $result if $buffer->{'readonly'};
        ## $buffer->{cursor}, not $cursor_pos -- that local is not declared
        ## until further down this function, past every branch above it
        <[editor.control.commands.insert]>->(
            $editor_state, $field, $buffer->{'cursor'}, "\n"
        );
        $result->{'action'} = 'newline';
        $result->{'dirty'}  = 'field';
        return $result;
    }
    ## a PLUGIN-PINNED field's Enter must never fall through to a form-wide
    ## submit, even before the field has been ENTERED into plugin mode [ the
    ## caller's own Right-entry trigger, not handled here ] : per-field
    ## override, same reasoning and same "checked before the schema-level
    ## submit_on" placement as the multiline branch just above.  found live,
    ## 2026-08-15, on plugin.user-edit.key-actions -- landing on the field and
    ## pressing Enter out of habit [ its normal meaning everywhere else in
    ## this form ] silently submitted the WHOLE record instead of doing
    ## nothing, before Right had ever been pressed to enter the tab.  applies
    ## to every plugin-pinned field generically, not a key-actions-only patch
    ## -- plugin.user-edit.address-cluster's own 'address' field had the
    ## identical latent gap, just never noticed because that field's own
    ## content rarely sits on Enter's own submit path unremarked
    return $result if $field_def->{'plugin'};

    my $submit_on = $schema->{'submit_on'} // qw| enter |;
    if ( $submit_on eq qw| enter | ) {
        $result->{'action'} = 'submit';
        $result->{'dirty'}  = 'form';
    }
    return $result;
}

## Ctrl-C : advisory signal, host acts on it [ or not ]
if ( $key eq "\x03" ) {
    $result->{'action'} = 'signal';
    $result->{'signal'} = 'INT';
    return $result;
}

my $cursor_pos = $buffer->{'cursor'};
my $buf_len    = <[editor.buffer.memory.length]>->($buffer);

## a masked field's DISPLAY cursor is always pinned to the END [ editor.
## control.get_display_cursor ] -- the real cursor a forward-delete [ Ctrl-D,
## Delete key ] would act on is therefore never visible on screen, even in the
## common case where the real cursor genuinely IS at the end. silently
## removing whatever real character sits at an invisible position, with no way
## to see it happened, is unsafe -- so for a masked field, forward- delete and
## backspace collapse into the SAME function : both always remove the
## character immediately before the cursor, exactly as backspace does.  every
## other field type keeps its real, visible cursor and is unaffected
my $is_masked = ( $buffer->{'type'} // '' ) eq qw| masked |;
my $backspace = sub {
    return if $cursor_pos <= 0;
    <[editor.control.commands.delete]>->(
        $editor_state, $field, $cursor_pos - 1, $cursor_pos
    );
    $result->{'action'} = 'backspace';
    $result->{'dirty'}  = 'field';
};

## Ctrl-D : delete char at cursor [ masked : same as backspace, see above ]
if ( $key eq "\x04" ) {
    if ($is_masked) {
        $backspace->();
    } elsif ( $cursor_pos < $buf_len ) {
        <[editor.control.commands.delete]>->(
            $editor_state, $field, $cursor_pos, $cursor_pos + 1
        );
        $result->{'action'} = 'delete';
        $result->{'dirty'}  = 'field';
    }
    return $result;
}

## Ctrl-A : cursor to start of line [ masked : same as backspace -- moving the
## real cursor away from the end with no visible feedback is the exact hazard
## the note above Ctrl-D describes ; a MOVE only makes it worse than a
## single-character DELETE does, since it strands everything after the jump at
## once, unreachable by backspace and invisible on screen ]
if ( $key eq "\x01" ) {
    if ($is_masked) {
        $backspace->();
    } elsif ( $cursor_pos > 0 ) {
        <[editor.control.commands.move_cursor]>->(
            $editor_state, $field, -$cursor_pos
        );
        $result->{'action'} = 'cursor_left';
        $result->{'dirty'}  = 'cursor';
    }
    return $result;
}

## Ctrl-E : cursor to end of line
if ( $key eq "\x05" ) {
    if ( $cursor_pos < $buf_len ) {
        <[editor.control.commands.move_cursor]>->(
            $editor_state, $field, $buf_len - $cursor_pos
        );
        $result->{'action'} = 'cursor_right';
        $result->{'dirty'}  = 'cursor';
    }
    return $result;
}

## Ctrl-K : kill to end of line [ save to kill buffer ]
if ( $key eq "\x0b" ) {
    if ( $cursor_pos < $buf_len ) {
        my $text = <[editor.buffer.memory.get_text]>->($buffer);
        $editor_state->{'kill_buffer'}
            = substr( $text, $cursor_pos, $buf_len - $cursor_pos );
        <[editor.control.commands.delete]>->(
            $editor_state, $field, $cursor_pos, $buf_len
        );
        $result->{'action'} = 'kill_to_end';
        $result->{'dirty'}  = 'field';
    }
    return $result;
}

## Ctrl-U : kill from start of line to cursor [ save to kill buffer ]
if ( $key eq "\x15" ) {
    if ( $cursor_pos > 0 ) {
        my $text = <[editor.buffer.memory.get_text]>->($buffer);
        $editor_state->{'kill_buffer'} = substr( $text, 0, $cursor_pos );
        <[editor.control.commands.delete]>->(
            $editor_state, $field, 0, $cursor_pos
        );
        $result->{'action'} = 'kill_from_start';
        $result->{'dirty'}  = 'field';
    }
    return $result;
}

## Ctrl-W : kill word backward [ save to kill buffer ]
if ( $key eq "\x17" ) {
    if ( $cursor_pos > 0 ) {
        my $text      = <[editor.buffer.memory.get_text]>->($buffer);
        my $start_pos = $cursor_pos;

        ## skip trailing whitespace
        while ( $start_pos > 0
            and substr( $text, $start_pos - 1, 1 ) =~ m|\s| ) {
            $start_pos--;
        }
        ## skip word characters [ non-whitespace ]
        while ( $start_pos > 0
            and substr( $text, $start_pos - 1, 1 ) !~ m|\s| ) {
            $start_pos--;
        }

        if ( $start_pos < $cursor_pos ) {
            $editor_state->{'kill_buffer'}
                = substr( $text, $start_pos, $cursor_pos - $start_pos );
            <[editor.control.commands.delete]>->(
                $editor_state, $field, $start_pos, $cursor_pos
            );
            $result->{'action'} = 'kill_word';
            $result->{'dirty'}  = 'field';
        }
    }
    return $result;
}

## Ctrl-Y : yank [ paste kill buffer at cursor position ]
if ( $key eq "\x19" ) {
    if ( length $editor_state->{'kill_buffer'} ) {
        <[editor.control.commands.insert]>->(
            $editor_state, $field, $cursor_pos, $editor_state->{'kill_buffer'}
        );
        $result->{'action'} = 'yank';
        $result->{'dirty'}  = 'field';
    }
    return $result;
}

## left arrow : move cursor left one CHARACTER [ ANSI: \e[D ] [ masked : same
## as backspace, per user -- see the note above Ctrl-D ]
if ( $key eq "\e[D" or $key eq "\x1b[D" ) {
    if ($is_masked) {
        $backspace->();
    } elsif ( $cursor_pos > 0 ) {
        <[editor.control.commands.move_cursor]>
            ->( $editor_state, $field, -1 );
        $result->{'action'} = 'cursor_left';
        $result->{'dirty'}  = 'cursor';
    }
    return $result;
}

## right arrow : move cursor right one CHARACTER [ ANSI: \e[C ]
if ( $key eq "\e[C" or $key eq "\x1b[C" ) {
    if ( $cursor_pos < $buf_len ) {
        <[editor.control.commands.move_cursor]>->( $editor_state, $field, 1 );
        $result->{'action'} = 'cursor_right';
        $result->{'dirty'}  = 'cursor';
    }
    return $result;
}

## delete key [ ANSI: \e[3~ ] : delete character at cursor [ masked : same as
## backspace, see the note above Ctrl-D ]
if ( $key eq "\e[3~" or $key eq "\x1b[3~" ) {
    if ($is_masked) {
        $backspace->();
    } elsif ( $cursor_pos < $buf_len ) {
        <[editor.control.commands.delete]>->(
            $editor_state, $field, $cursor_pos, $cursor_pos + 1
        );
        $result->{'action'} = 'delete';
        $result->{'dirty'}  = 'field';
    }
    return $result;
}

## backspace [ \x08 and \x7f ] : delete character before cursor
if ( $key eq "\x08" or $key eq "\x7f" ) {
    $backspace->();
    return $result;
}

## printable character [ possibly multi-byte utf-8 sequence ] : check first
## byte/char exactly like AMOS7::TERM does, then insert — byte->char decoding
## happens inside the buffer adapter
if ( length $key and ord( substr( $key, 0, 1 ) ) >= 32 ) {
    return $result if $buffer->{'readonly'};
    <[editor.control.commands.insert]>->(
        $editor_state, $field, $cursor_pos, $key
    );
    $result->{'action'} = 'echo';
    $result->{'dirty'}  = 'field';
    return $result;
}

## unclaimed key : host may claim it [ arrows up/down, ctrl-o, ctrl-r .. ]
$result->{'passthrough'} = $key;
return $result;

#,,.,,,,,,.,.,..,,...,..,,,,,,.,,,,.,,,,.,.,,,..,,...,...,..,,,..,,,,,...,...,
