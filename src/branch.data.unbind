## [:< ##

# name  = branch.data.unbind
# descr = unbind data zenka namespace from branch node
# param = { node }

my $params = shift // {};

my $node = $params->{'node'} // '';
return { 'mode' => 'false', 'data' => 'node required' }
    unless length $node;

my $binding = $data{'branch.data.bindings'}{$node} // {};
my $zenka   = $binding->{'zenka'}                  // 'data';

my $args_yaml;
eval {
    <[base.perlmod.autoload]>->('YAML::XS');
    $args_yaml = YAML::XS::Dump( { 'node_id' => $node } );
    1;
} or do {
    my $err = $@ // 'unknown';
    <[base.logs]>->(
        0, 'branch.data.unbind: yaml serialize error [ %s ]', $err
    );
    return { 'mode' => 'false', 'data' => 'yaml serialization failed' };
};

my $sent = <[protocol-7.route-send]>->(
    {   'command'   => 'data.branch.unbind',
        'call_args' => { 'args' => $args_yaml },
    }
);

## clear binding ##
delete $data{'branch.data.bindings'}{$node};

<[base.logs]>->(
    2, 'branch.data.unbind: %s [ zenka=%s sent=%s ]',
    $node, $zenka, $sent ? 'yes' : 'no'
);

return { 'mode' => 'true', 'data' => $node };

