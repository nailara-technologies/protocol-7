## [:< ##

# name = login-screen.show_greeter
# descr = clear admission state and show the dark login form

<[login-screen.release_lock]>;
my $password = <login-screen.widget.password>;
my $user     = <login-screen.widget.user>;
$password->set_text('')        if defined $password;
$user->set_sensitive(TRUE)     if defined $user;
$password->set_sensitive(TRUE) if defined $password;
<login-screen.widget.button>->set_sensitive(TRUE);
<login-screen.widget.status>->set_text('');
<login-screen.ticket>       = undef;
<login-screen.session_user> = undef;
<login-screen.state>        = qw| greeter |;
my $window = <login-screen.window>;

if ( defined $window ) {
    $window->show_all();
    $window->present();
}
$user->grab_focus() if defined $user;
TRUE;

