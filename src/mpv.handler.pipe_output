## [:< ##

# name  = mpv.handler.pipe_output
# descr = reads and processes output from mpv control pipe

my $bytes;
my $event   = shift->w;
my $read_fh = $event->fd;
my $process = $event->data;
my $pid     = $process->{'pid'};

<mpv.pipe.buffer> //= '';
if ( defined $read_fh ) {
    ## needs 'safer' read method [read len] [ LLL ]
    $bytes = <[base.s_read]>->( $read_fh, \<mpv.pipe.buffer>, 16 * 1024 )
        // 0;
}

if ( $bytes <= 0 or not defined <mpv.pipe.buffer> ) {
    $event->cancel;
    close($read_fh);
    my $exit_code = 2;
    my $log_level = 0;
    if ( not <zenka.shutdown> ) {
        <[base.log]>->( 0, 'mpv control pipe closed unexpectedly >:|' );
        <[base.logs]>->(
            'sent kill signal to mpv-process [PID:%d] ..,', $pid
        ) if kill( 9, $pid );
    } else {
        kill( 9, $pid );
        $exit_code = 0;
        $log_level = 1;
    }
    <[base.logs]>
        ->( $log_level, 'stopping %s-zenka..,', <system.zenka.name> );
    exit($exit_code);
}

while ( <mpv.pipe.buffer> =~ s|^([^\n]*)\n||s ) {
    my $output_line = $LAST_PAREN_MATCH;
    my $decoded     = <mpv.json.parser>->decode($output_line);

    if (    defined $decoded
        and ref($decoded) eq qw| HASH |
        and exists $decoded->{'event'} ) {
        <[mpv.handler.event]>->($decoded);
    }

    ## match replies by request_id, not arrival order -- a dropped,     ##
    ## deferred, or reordered reply can no longer desync unrelated      ##
    ## in-flight commands the way shift()-based FIFO matching used to., ##
    my $pending
        = defined $decoded->{'request_id'}
        ? delete <mpv.pending_reply>->{ $decoded->{'request_id'} }
        : undef;

    if (    exists $decoded->{'error'}
        and $decoded->{'error'} ne qw| success |
        and $pending
        and defined $pending->{'reply_id'} ) {

        my $reply_id = $pending->{'reply_id'};

        <[base.logs]>->(
            0,         '[%s] pipe-FALSE [%s]',
            $reply_id, $decoded->{'error'}
        );
        <[base.callback.cmd_reply]>->(
            $reply_id,
            {   'mode' => qw| false |,
                'data' => sprintf( "player child replied '%s'.,",
                    $decoded->{'error'} )
            }
        );
        next;
    } elsif ( exists $decoded->{'error'}
        and $pending
        and $pending->{'reply_setup'} ) {
        my $reply_setup = $pending->{'reply_setup'};

        my $command_handler  = $reply_setup->{'handler'}  // '';
        my $command_callback = $reply_setup->{'callback'} // '';

        $code{$command_handler}
            ->( $decoded->{'data'}, $pending->{'reply_id'} )
            if $decoded->{'error'} eq qw| success |
            and exists $code{$command_handler};

        $code{$command_callback}
            ->( $decoded->{'error'}, $pending->{'reply_id'} )
            if defined $code{$command_callback};

        next;
    } elsif ( exists $decoded->{'error'}
        and $decoded->{'error'} eq qw| success |
        and $pending
        and defined $pending->{'success_reply_str'}
        and defined $pending->{'reply_id'} ) {

        my $reply_id    = $pending->{'reply_id'};
        my $success_str = $pending->{'success_reply_str'};

        <[base.logs]>->( 2, '[%s] pipe-TRUE [%s]', $reply_id, $success_str );
        <[base.callback.cmd_reply]>->(
            $reply_id, { 'mode' => qw| true |, 'data' => $success_str }
        );
        next;
    }

    # log output [ no reply_id case ]
    my $log_level
        = ( defined $decoded->{'error'}
            and $decoded->{'error'} ne qw| success | )
        ? 0
        : 2;
    $output_line =~ s|[\r\n]+||sg;
    <[base.logs]>->( $log_level, '< mpv > %s', $output_line );
}

