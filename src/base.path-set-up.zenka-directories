# name  = base.path-set-up.zenka-directories

my $var_P7_path = $ENV{'PROTOCOL_7_VAR'} // '/var/protocol-7';

my %default_dirs = (
    qw| var_run         | => qw|  /var/run/.7            |,
    qw| var_P7          | => $var_P7_path,
    qw| etc_P7          | => qw|  /etc/protocol-7        |,
    qw| UNIX            | => qw|  /var/run/.7/UNIX       |,
    qw| cache_protocol7 | => qw|  /var/cache/protocol-7  |,
);

## per key : an early reader may have created the hash already ##
<system.path.zenka-dirs> //= {};
<system.path.zenka-dirs>->{$ARG} //= $default_dirs{$ARG}
    foreach keys %default_dirs;

my %default_modes = (
    qw| var_run         | => 0775,
    qw| var_P7          | => 0775,
    qw| etc_P7          | => 0775,
    qw| UNIX            | => 0775,
    qw| cache_protocol7 | => 0775,
);

## per key : an early reader may have created the hash already ##
<system.path.zenka-dir-modes> //= {};
<system.path.zenka-dir-modes>->{$ARG} //= $default_modes{$ARG}
    foreach keys %default_modes;

