# name  = jobsite.cmd.set-threshold
# descr = update minimum score threshold for review

my $val = $call->{'args'} // '';
$val =~ s{^\s+|\s+$}{}g;

return { 'mode' => 'false', 'data' => 'usage: set-threshold <0-10>' }
    if not length $val
    or $val !~ m{^\d+(?:\.\d+)?$}
    or $val > 10;

<jobsite.cfg.threshold> = $val + 0;

return { 'mode' => 'true', 'data' => "threshold set to $val" };

