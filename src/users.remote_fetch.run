## [:< ##

# name  = users.remote_fetch.run
# param = <host> <port> <as_username> <target_username> <orig_reply_id>
# descr = connect + auth-keypair authenticate to a peer, bind it to the
#         link-upgrade [ encrypted, state 3 ], then register the socket
#         as a normal event-driven client session
#         and send users.remote-get through the standard async command/
#         reply machinery -- NOT a hand-rolled blocking read loop.
#
# real incident 2026-08-11, root-caused and fixed: an earlier version of
# this module did the ENTIRE handshake AND the subsequent command/reply
# via manual blocking socket reads. Self-testing it via loopback (this
# same 'users' zenka authenticating to its own host's cube, then asking
# for users.remote-get on itself) deadlocked the whole zenka: cube routed
# the command back to this SAME process's own pre-existing link session,
# which could not be serviced because this process was blocked waiting
# on its own reply, on its own single-threaded event loop. v7-zenki.restart
# could not even recover it, since the stuck process couldn't process
# ITS OWN restart/terminate command either -- required v7-zenki.terminate (TERM then
# KILL) to recover. Fixed by modeling this on how EVERY regular protocol-7
# session already works: base.session.init + explicit promotion to
# state 1 (base.session.init_state) hands the connection to the normal
# event-driven command-dispatch machinery for the actual query, so this
# zenka's event loop is never blocked waiting on itself. Only the initial
# connect + auth-keypair handshake remains a brief, bounded blocking
# call -- the same accepted shape as base.net.connect's own
# auth.client.zenka.authenticate precedent.

my ( $host, $port, $as_username, $target_username, $orig_reply_id ) = @ARG;

my $session_key_name = qw| remote-fetch-client |;
my $base_key_name
    = sprintf( qw| %s.base |, $ENV{'USER'} // getpwuid($EUID) );

my $fail = sub {
    my ($msg) = @ARG;
    <[base.callback.cmd_reply]>->(
        $orig_reply_id, { 'mode' => qw| false |, 'data' => $msg }
    );
    return;
};

my $sock = <[base.open]>->( qw| ip.tcp output |, $host, $port );
return $fail->( sprintf( "cannot connect to %s:%s", $host, $port ) )
    if not defined $sock;

## the binding context [ server pinned per host + port ] : the server keeps ##
## the session binding-PENDING [ link-upgrade only ] until the handshake    ##
## below binds this identity to the encrypted link                          ##
my $binding = eval {
    <[auth.client.auth-keypair.authenticate]>->(
        $sock, $as_username, $session_key_name, $base_key_name,
        { qw| host | => $host, qw| port | => $port }
    );
};
if ( length $EVAL_ERROR ) {
    close($sock);
    die $EVAL_ERROR;
}
if ( ref $binding ne qw| HASH | ) {
    close($sock);
    return $fail->('auth-keypair handshake failed [ see logs ]');
}

## link-upgrade BEFORE anything else [ the external.link.open shape ] ##
my ( $upgraded, $link ) = eval {
    <[protocol.protocol-7.link-upgrade.handshake]>->(
        $sock, { 'timeout' => 5, 'binding' => $binding }
    );
};
if ( length $EVAL_ERROR ) {
    close($sock);
    die $EVAL_ERROR;
}
if ( not $upgraded ) {
    close($sock);
    return $fail->("link-upgrade failed : $link->{'error'}");
}

## session 'name' must satisfy base.regex's usr_str_re -- alnum/hyphen/
## underscore only, max 32 chars, no colons/dots [ real gap found 2026-08-11:
## "remote-fetch:<host>:<port>" fails this and made base.session.init return
## undef unconditionally ]
my $id = <[base.session.init]>->(
    $sock, qw| protocol-7 client |,
    $session_key_name
);

if ( not defined $id ) {
    close($sock);
    return $fail->('failed to register client session');
}

## promote straight to state 1 [ authenticated/operational ] -- we already did
## the auth-keypair exchange ourselves as the client, so there is no
## select/auth line left for base.handler.auth to process; without this the
## session stays stuck at state 0 forever [ same generic promotion
## base.handler.auth itself calls after a SERVER-side auth succeeds ] ; then
## the encrypted state 3 [ link-upgrade.client_activate, link_role client ]
<[base.session.init_state]>->( $id, 1 );

if (
    not <[protocol.protocol-7.link-upgrade.client_activate]>->( $id, $link ) )
{
    <[base.session.shutdown]>->($id);
    return $fail->('encryption activation failed');
}

## non-prefixed swap-family form -- base.protocol-7.command.send.local itself
## calls under this stripped name internally too (see
## base.protocol-7.route-send's own call site); the base.-prefixed form is not
## guaranteed registered under that exact name after swap_subs
<[protocol-7.command.send.local]>->(
    {   'command'   => sprintf( '%d.users.remote-get', $id ),
        'call_args' => { 'args' => $target_username },
        'reply'     => {
            'handler' => qw| users.handler.remote_fetch_reply |,
            'params'  => { 'orig_reply_id' => $orig_reply_id }
        }
    }
);

return;

