## [:< ##

# name = system.handler.X-11_stopped

delete <system.gfx_reload.xorg_pid>;

<[protocol-7.command.send.local]>->(
    {   'command'   => qw| cube.v7-zenki.forced-mod-reload |,
        'call_args' => { 'args'    => <system.gfx_reload.module_name> },
        'reply'     => { 'handler' => 'system.handler.mod_reload_reply' }
    }
);

