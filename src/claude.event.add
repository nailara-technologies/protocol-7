## [:< ##

# name  = claude.event.add
# descr = keep one readable event line : buffer and log
# args  = kind, text

## the buffer is bounded [ claude.cfg.buffer_lines ] ; the log file in the ##
## var dir keeps every line [ plain lines : time kind : text ]             ##

my ( $kind, $text ) = @ARG;
$text //= '';
$text =~ s{[\r\n]+}{ / }g;
my $line = sprintf '%s %s : %s', <[base.ntime]>, $kind // qw| out |, $text;

my $events = <claude.events> //= [];
push @{$events}, $line;
my $keep = <claude.cfg.buffer_lines> // 377;
CORE::splice( @{$events}, 0, @{$events} - $keep ) if @{$events} > $keep;

my $dir = <[claude.var_dir]>->(TRUE);
if ( defined $dir
    and CORE::open( my $fh, '>>:encoding(UTF-8)', "$dir/events.log" ) ) {
    print {$fh} "$line\n";
    CORE::close($fh);
}
return $line;

