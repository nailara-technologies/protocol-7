## [:< ##

# name   = events.bucket.gate.parse
# descr  = split a budget gate : provider, window, op, percent
# args   = text [ e.g. claude:5h<60 ]
# return = { provider, window, op, percent, text } or { error }
#
# the gate compares the used percent of one usage window : `<` `<=` `>`
# `>=` against 0 .. 100. the text is kept as given [ normalised spaces ]

my $text = shift // '';
$text =~ s{\s+}{}g;
return {  'error' => 'budget : <provider>:<window><op><percent> '
        . '[ e.g. claude:5h<60 ]' }
    if $text !~ m{\A([a-z][\w-]{0,31}):([0-9a-z][\w-]{0,15})(<=|>=|<|>)
        (\d{1,3}(?:\.\d{1,2})?)\z}x;
my ( $provider, $window, $op, $percent ) = ( $1, $2, $3, $4 + 0 );
return { 'error' => "budget : percent $percent is over 100" }
    if $percent > 100;
return {
    'provider' => $provider,
    'window'   => $window,
    'op'       => $op,
    'percent'  => $percent,
    'text'     => "$provider:$window$op$percent"
};

