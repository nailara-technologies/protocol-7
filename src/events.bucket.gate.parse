## [:< ##

# name   = events.bucket.gate.parse
# descr  = parse a budget gate or an unless condition
# args   = text [ e.g. claude:5h<60, task:ABC1234=done ]
# return = { kind, text, .. } or { error }
#
# the budget gate compares the used percent of one usage window. unless
# conditions name a budget, task state, signal or an empty coding sign queue

my $text = shift // '';
$text =~ s{\s+}{}g;
my $prefixed = $text              =~ s{\Abudget:}{};
my $budget   = $prefixed || $text !~ m{\A(?:task:|seen:|sign-queue:)};
return {  'error' => 'budget : <provider>:<window><op><percent> '
        . '[ e.g. claude:5h<60 ]' }
    if $budget
    and $text !~ m{\A([a-z][\w-]{0,31}):([0-9a-z][\w-]{0,15})(<=|>=|<|>)
        (\d{1,3}(?:\.\d{1,2})?)\z}x;
if ($budget) {
    my ( $provider, $window, $op, $percent ) = ( $1, $2, $3, $4 + 0 );
    return { 'error' => "budget : percent $percent is over 100" }
        if $percent > 100;
    return {
        'kind'     => qw| budget |,
        'provider' => $provider,
        'window'   => $window,
        'op'       => $op,
        'percent'  => $percent,
        'text'     => "$provider:$window$op$percent"
    };
}
return {
    'kind'  => qw| task |,
    'id'    => uc $1,
    'state' => $2,
    'text'  => sprintf 'task:%s=%s',
    uc($1), $2
    }
    if $text =~ m{\Atask:([a-z0-9-]{1,63})=(done|failed|parked)\z}i;
return {
    'kind'  => qw| seen |,
    'name'  => $1,
    'key'   => $2,
    'value' => $3,
    'text'  => $text
    }
    if $text =~ m{\Aseen:([a-z0-9][a-z0-9._-]{0,79})
        (?::([\w.-]+)=([^,\s]*))?\z}x;
return { 'kind' => qw| sign-queue |, 'text' => $text }
    if $text eq qw| sign-queue:empty |;
return {  'error' => 'unless : budget:<provider>:<window><op><pct>, '
        . 'task:<id>=<state>, seen:<signal>[:<key>=<value>] '
        . 'or sign-queue:empty' };

