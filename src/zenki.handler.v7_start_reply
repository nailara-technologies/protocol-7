# name = zenki.handler.v7_start_reply
# descr = handle the v7-zenki reply to a relayed zenka start request

## reply-handler call signature is a SINGLE hashref { sid, cmd, call_args,  ##
## params } -- 'cmd' is the wire-level mode keyword and the payload sits in ##
## call_args->{args} [ see base.handler.command.process_reply ]             ##

my ($info) = @ARG;

my $mode       = uc( $info->{'cmd'} // '' );
my $params     = $info->{'params'}              // {};
my $reply_data = $info->{'call_args'}->{'args'} // '';

my $zenka_name = $params->{'zenka_name'} // 'unknown';
my $reply_id   = $params->{'reply_id'};

$reply_data =~ s|^\s+||;
$reply_data =~ s|\s+$||;

return TRUE if $mode eq qw| WAIT |;    ## interim reply : keep waiting ##

<[base.logs]>->(
    2,           "v7-zenki start reply for '%s' : %s",
    $zenka_name, lc($mode)
);

my $success = ( $mode eq qw| TRUE | ) ? TRUE : FALSE;

if ($success) {
    <[base.logs]>->( 1, '  ✓ v7-zenki confirmed : %s', $reply_data );
    <zenki.stats.successful_starts>++ if exists <zenki.stats>;
} else {
    <[base.logs]>->( 0, '  ✗ v7-zenki start failed : %s', $reply_data );
    <zenki.stats.failed_starts>++ if exists <zenki.stats>;
}

## result pick-up point for the console command that owns the event loop ##
<zenki.start.reply> = {
    'zenka'   => $zenka_name,
    'mode'    => lc($mode),
    'success' => $success,
    'data'    => $reply_data
};

## deferred reply of a network 'start' call                              ##
## [ zenki.cmd.start returned 'deferred' and left its reply id with us ] ##
<[base.callback.cmd_reply]>->(
    $reply_id,
    {   'mode' => $success ? qw| true | : qw| false |,
        'data' => length($reply_data)
        ? $reply_data
        : sprintf( "no detail returned for '%s'", $zenka_name )
    }
) if defined $reply_id;

## hand control back out of the event loop : a one-shot console call has   ##
## nothing left to wait for once the relay completed [ the console command ##
## resumes right after its own <[base.zenka.loop]> ]                       ##
Event::unloop()
    if ( <zenki.start-up.mode> // '' ) eq qw| one-shot |
    and defined &Event::unloop;

return TRUE;

