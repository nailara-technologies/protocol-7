# name  = v7-zenki.parser.latency_ms
# descr = latency in seconds as milliseconds [ list filter, no unit ]

my $seconds = shift;

return qw| - | if not defined $seconds or $seconds !~ m|^\d+(\.\d+)?$|;
return sprintf( qw| %.2f |, $seconds * 1000 );

