# name  = v7-zenki.parser.latency_ms
# descr = format a latency in seconds as milliseconds [ list filter ]

my $seconds = shift;

return qw| - | if not defined $seconds or $seconds !~ m|^\d+(\.\d+)?$|;
return sprintf( qw| %.2fms |, $seconds * 1000 );

