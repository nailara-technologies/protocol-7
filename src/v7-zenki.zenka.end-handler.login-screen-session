# name = v7-zenki.zenka.end-handler.login-screen-session
# descr = any session end : revoke x access, drop xauth, show greeter

my $instance_id = shift;
my $instance    = <v7-zenki.zenka.instance>->{$instance_id} // return FALSE;
my $username    = $instance->{'subname'}                    // '';
delete <v7-zenki.login-session.locked>;
<[base.logs]>->(
    0,
    'login session ended [ %s ] : revoking X access, greeter back',
    length $username ? $username : 'unknown user'
);
if ( $username =~ m|^[a-z_][a-z0-9_-]{0,31}$| ) {
    <[protocol-7.route-send]>->(
        {   'command'   => qw| X-11.revoke_session_user |,
            'call_args' => { 'args' => $username },
        }
    );
    my $path = sprintf( qw| /var/run/.7/login-screen/sessions/%s.Xauthority |,
        $username );
    unlink($path) if -f $path and not -l $path;
}
<[zenka.cmd.terminate]>->( { 'args' => $ARG } )
    foreach reverse <[v7-zenki.login-session.zenki]>;
<[protocol-7.route-send]>
    ->( { 'command' => qw| login-screen.session-ended | } );
TRUE;

