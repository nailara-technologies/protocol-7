# name  = jobsite.handler.liveness-timeout
# descr = no liveness verdict in time : unknown, slot released

my $event = shift;
my $wdata = eval { $event->w->data } // {};

<[jobsite.liveness.apply]>->(
    $wdata->{'job_id'} // '',
    $wdata->{'token'}  // '',
    { 'verdict' => qw| unknown |, 'why' => 'timeout' }
);
return;

