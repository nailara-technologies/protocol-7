## [:< ##

# name  = kimi.handler.acp_stderr
# descr = log one stderr line of the child
# param = line [ octets ], handle

my $line = shift // return;
utf8::decode($line);
<[kimi.acp.event]>->( qw| stderr |, $line ) if $line =~ m{\S};
return TRUE;

