## [:< ##

# name  = kimi.handler.acp_stderr
# descr = log the child's stderr lines

my $event = shift;
my $st    = <[kimi.acp.state]>;

my $chunk = '';
my $bytes = <[base.s_read]>->( $event->w->fd, \$chunk, 65536 );
if ( $bytes <= 0 ) {
    eval { $event->w->cancel };
    delete $st->{'watchers'}{'err'};
    return;
}

$st->{'ebuf'} .= $chunk;
$st->{'ebuf'} = '' if length $st->{'ebuf'} > 1_000_000;
while ( $st->{'ebuf'} =~ s{\A([^\n]*)\n}{} ) {
    my $line = $1;
    utf8::decode($line);
    <[kimi.acp.event]>->( qw| stderr |, $line ) if $line =~ m{\S};
}
return TRUE;

