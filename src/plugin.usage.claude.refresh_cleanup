## [:< ##

# name  = plugin.usage.claude.refresh_cleanup
# descr = final teardown of a claude refresh cycle : cancel any watcher still
#         armed, close the pty, clear the single-slot state, log [ including a
#         preview of the child's captured pty output, the only way to tell
#         from outside whether claude actually reached its normal startup
#         screen and refreshed its token, or got stuck on something first --
#         this preview is what caught both the unconfirmed trust-dialog bug
#         and the stale-binary bug fixed in refresh_token's history notes ],
#         then invoke every queued on_done [ named handler + params, same
#         reload-safety contract as the event callbacks themselves -- one
#         entry per caller that arrived while this cycle was already
#         running, see plugin.usage.claude.refresh_token's single-slot-busy
#         branch ].
# param = <how> : eof | ctrl_d | sigterm | killed | gone

use Encode ();

my $how = shift // qw| done |;

my $provider = <usage.provider.claude>;
my $state    = delete $provider->{'refresh_state'} // return TRUE;

foreach
    my $w ( $state->{'io_w'}, $state->{'timer_w'}, $state->{'reap_timer'} ) {
    $w->cancel if defined $w;
}

close( $state->{'fh'} )
    if defined $state->{'fh'} and defined fileno $state->{'fh'};

<[base.logs]>->(
    2, '[usage.claude.refresh_token] claude startup cycle complete [ %s ]',
    $how
);

if ( length $state->{'buffer'} // '' ) {
    ## decode + strip before logging, not just truncate -- base.s_read
    ## deliberately downgrades the utf8 flag for binary safety, so a pty's own
    ## multi-byte utf8 output [ box-drawing lines, colored glyphs ] would
    ## otherwise come out as mojibake ; found live 2026-09-16 diagnosing this
    ## exact refresh path, kept permanently since it's a real readability fix,
    ## not a diagnostic-only aid
    my $decoded
        = Encode::decode( qw| UTF-8 |, $state->{'buffer'},
        Encode::FB_DEFAULT );
    ##  strip ansi csi sequences  ##
    $decoded =~ s{\e\[[0-9;?]*[A-Za-z]}{}g;
    ( my $preview = substr( $decoded, 0, 300 ) ) =~ s{[\r\n]+}{ }g;
    <[base.logs]>->(
        2, '[usage.claude.refresh_token] pty output preview : %s', $preview
    );
}

foreach my $done ( @{ $state->{'on_done_list'} // [] } ) {
    next if ref $done ne qw| HASH |;
    $code{ $done->{'handler'} }->( $done->{'params'} // {} )
        if length( $done->{'handler'} // '' )
        and exists $code{ $done->{'handler'} };
}

return TRUE;

