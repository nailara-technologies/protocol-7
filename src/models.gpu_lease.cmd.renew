## [:< ##

# name  = models.gpu_lease.cmd.renew
# descr = renew the gpu residency lease

my ($owner) = split m|\s+|, $call->{'args'} // '';
return {
    'mode' => <[models.gpu_lease.renew]>->( $owner // '' )
    ? qw| true |
    : qw| false |
};

