# name  = ticker.cmd.select_monitor
# descr = report Gdk monitor geometry selected for ticker swap

my $monitor = <[ticker.select_monitor]>;

return { 'mode' => qw| false |, 'data' => 'no monitor selected' }
    if not defined $monitor;

return {
    'mode' => qw| true |,
    'data' => sprintf(
        'x=%d y=%d width=%d height=%d source=%s',
        $monitor->{'x'},      $monitor->{'y'}, $monitor->{'width'},
        $monitor->{'height'}, $monitor->{'source'}
    )
};

