#\\\|XNFUPEDIEF3KHSB635RBYXG7S6XOBOGSVACX5PGADFWPTW7MNE5 \ / AMOS7 \ YOURUM ::
#\[7]FCVZHVEAIEWGFTJ5DJJHWLJB5EWMR4PN2CRNM6MHF4N4SUQFMOCI 7  DATA SIGNATURE ::
