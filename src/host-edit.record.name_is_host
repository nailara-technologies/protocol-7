#\\\|LPHMHHOUYLJOX7O5IXEUUZZGQPLBOJ2U7TP3LICZWONUQWV7O2H \ / AMOS7 \ YOURUM ::
#\[7]GAEPHJYLLZQNLYNA5WR6WD4NNHMWE5XVDWL3F3FXNO2R5XPPTUDI 7  DATA SIGNATURE ::
