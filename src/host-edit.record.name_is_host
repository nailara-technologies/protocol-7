## [:< ##

# name  = host-edit.record.name_is_host
# descr = is a record name also a dialable host name [ dotted, no '_' ]
# param = $name
# return = TRUE | FALSE

## a record name is a LABEL [ host-edit.record.name_valid allows '_' and
## undotted names like 'pri' ] -- only a dotted name made of host-name labels
## is taken as the address too : record.default_fields prefills it, and
## flow.start falls back to it for a record that has no address

my ($name) = @ARG;

return FALSE if not defined $name or not length $name;

return $name =~ m{\A(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+
                  [a-z0-9](?:[a-z0-9-]*[a-z0-9])?\z}x ? TRUE : FALSE;

