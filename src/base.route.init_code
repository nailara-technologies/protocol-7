## [:< ##

# name = base.route.init_code

$data{'route'} //= {};

<limits.routes.combined>   //= 42777;
<limits.routes.per_client> //= 13747;

## route history : the last issued routes per 'target sid : cmd id', for    ##
## unknown-route replies [ base.handler.command.process_reply ] -- one hash ##
## entry per route ; high-throughput zenki can switch it off                ##
<base.route_history.enabled> //= TRUE;
<base.route_history.size>    //= 1024;
<base.route_history.ttl>     //= 900;    ##  seconds  ##

<[base.list.init]>->(
    {   'name'         => 'routes',
        'key_ref'      => \$data{'route'},
        'max_elements' => <limits.routes.combined>,
    }
);

return FALSE;

