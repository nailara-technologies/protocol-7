## [:< ##

# name  = X-11.cmd.xvfb-stop
# param = <display_num>
# descr = stop a running xvfb instance

my @args
    = ref( $call->{'args'} ) eq qw| ARRAY |
    ? $call->{'args'}->@*
    : split( m| +|, $call->{'args'} );
my ($display_num) = @args;

return { 'mode' => qw| false |, 'data' => 'display number required' }
    if not defined $display_num;
return { 'mode' => qw| false |, 'data' => 'invalid display number' }
    if $display_num !~ m|^\d+$|;

my $stored_pid = <X-11.xvfb.pid>->{$display_num};

return {
    'mode' => qw| true |,
    'data' => sprintf( 'xvfb :%s not running', $display_num )
    }
    if not defined $stored_pid
    or not kill 0, $stored_pid;

if ( kill 15, $stored_pid ) {
    delete <X-11.xvfb.pid>->{$display_num};
    return {
        'mode' => qw| true |,
        'data' => sprintf(
            'xvfb :%s stopped [ pid %d ]',
            $display_num, $stored_pid
        )
    };
}

return {
    'mode' => qw| false |,
    'data' => sprintf(
        'failed to stop xvfb :%s [ pid %d ]',
        $display_num, $stored_pid
    )
};

