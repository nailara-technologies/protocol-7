## [:< ##

# name  = X-11.cmd.xvfb-stop
# param = <display_num>
# descr = stop a running xvfb instance

my @args
    = ref( $call->{'args'} ) eq qw| ARRAY |
    ? $call->{'args'}->@*
    : split( m| +|, $call->{'args'} // '' );
my ($display_arg) = @args;

return { 'mode' => qw| false |, 'data' => 'display number required' }
    if not defined $display_arg;

my $display_num = <[X-11.helper.resolve_display_id]>->($display_arg);
return { 'mode' => qw| false |, 'data' => 'invalid display number' }
    if not defined $display_num;

my $display_str = sprintf qw| :%s |, $display_num;
my $entry       = <X-11.servers>->{$display_str};

## only an xvfb-mode entry may be stopped here -- <X-11.servers> is shared ##
## across all display modes [xorg\xvfb\..], and this must never be able to ##
## kill the primary\host display server .,                                 ##
my $stored_pid
    = ( defined $entry and ( $entry->{'mode'} // '' ) eq qw| xvfb | )
    ? $entry->{'pid'}
    : undef;

return {
    'mode' => qw| true |,
    'data' => sprintf( 'xvfb :%s not running', $display_num )
    }
    if not defined $stored_pid
    or not kill 0, $stored_pid;

## mark this pid as an intentional stop before signalling it -- lets       ##
## X-11.handler.server_output tell a requested stop apart from a genuine   ##
## crash when it sees the pipe close [ same $pid key, since the io watcher ##
## registered in finalize_server carries its own fresh 'data' hash, not a  ##
## reference back into <X-11.servers> ], instead of always logging "shut   ##
## down unexpectedly" .,                                                   ##
<X-11.intentional_stop>->{$stored_pid} = TRUE;

if ( kill 15, $stored_pid ) {
    delete <X-11.servers>->{$display_str};
    return {
        'mode' => qw| true |,
        'data' => sprintf(
            'xvfb :%s stopped [ pid %d ]',
            $display_num, $stored_pid
        )
    };
}

## signal delivery itself failed -- no pipe-close will ever come for this ##
## pid, so don't leave the flag behind .,                                 ##
delete <X-11.intentional_stop>->{$stored_pid};

return {
    'mode' => qw| false |,
    'data' => sprintf(
        'failed to stop xvfb :%s [ pid %d ]',
        $display_num, $stored_pid
    )
};

