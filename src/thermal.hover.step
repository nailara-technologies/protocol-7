## [:< ##

# name  = thermal.hover.step
# descr = one hold step : the gap, at most thermal.cfg.hover.step seconds,
#         so a held round looks at the temperature again while it cools
#         [ a hold sized at the hot start overshoots far below the mark ]

my ($gap) = @ARG;

my $step = <thermal.cfg.hover.step> // 20;
$step = 20 if $step !~ m|^\d+(?:\.\d+)?$| or $step <= 0;

return $gap < $step ? $gap : $step;

