## [:< ##

# name  = coding.cmd.remind
# param = at=<time> | after=<type> <text> [ to= unless= ]
# descr = a reminder : a bucket entry, a message
#
# to=session [ default ] : claude.session-post into the registered live
# session, its name recorded now ; several registered : to=session:<name>.
# notify when none takes it ; to=panel \ notify : notify.message,
# the session when the notify zenka is not there. the entry is the
# reminder [ events bucket, kept over restarts ] : coding.reminders lists,
# coding.remind-drop <id> removes. unless=condition,.. skips it when any
# condition holds just before delivery ; an unreadable source does not hold

my $parsed = <[park.parse_args]>->( $call->{'args'} // '' );
my $fail   = sub { return { 'mode' => qw| false |, 'data' => shift } };
return $fail->( $parsed->{'error'} ) if defined $parsed->{'error'};
my $pairs = $parsed->{'pairs'};
my @bad   = grep { not m{\A(?:at|after|to|unless)\z} } sort keys %{$pairs};
return $fail->("unknown key : @bad [ at after to unless ]") if @bad;
my @when = grep { defined $pairs->{$ARG} } qw| at after |;
return $fail->('one of at= or after=') if @when != 1;
## at=<date> <time> : p7c split it at the space, the time would land in the ##
## text and the bare date be due at once                                    ##
return $fail->( "at : '$pairs->{'at'} $parsed->{'words'}[0]' was split at "
        . "the space -- write "
        . "at=$pairs->{'at'}T$parsed->{'words'}[0]" )
    if defined $pairs->{'at'}
    and $pairs->{'at'} =~ m|\A\d{4}-\d\d-\d\d\z|
    and ( $parsed->{'words'}[0] // '' ) =~ m{\A\d\d?:\d\d(?::\d\d)?\z};
my $to = $pairs->{'to'} // qw| session |;
return $fail->('to : session[:<name>] \ panel \ notify')
    if $to !~ m{\A(?:session(?::[\w.\-]{1,64})?|panel|notify)\z};
my $text = join ' ', @{ $parsed->{'words'} };
$text =~ s{\s+}{ }g;
return $fail->('reminder text required') if $text !~ m{\S};

my $in = {
    'when'     => "$when[0]",
    'time'     => $pairs->{ $when[0] },
    'to'       => $to,
    'text'     => $text,
    'unless'   => $pairs->{'unless'},
    'reply_id' => $call->{'reply_id'} // ''
};
## to=session without a name : the claude zenka names the registered one. ##
## not routable : kept unnamed, the post then takes a single one only     ##
if ( $to eq qw| session | ) {
    my $asked = <[protocol-7.route-send]>->(
        {   'command' => qw| claude.sessions |,
            'reply'   => {
                'handler' => qw| coding.handler.remind_target |,
                'params'  => $in
            }
        }
    );
    return $in->{'reply_id'} =~ m{\A\d+\z}
        ? { 'mode' => qw| deferred | }
        : { 'mode' => qw| true |, 'data' => 'reminder requested' }
        if $asked;
}
return <[coding.remind.add]>->($in);

