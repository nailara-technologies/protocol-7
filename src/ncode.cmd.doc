## [:< ##

# name  = ncode.cmd.doc
# descr = look up documentation for a p7 module or perl symbol

my $args = $call->{'args'} // '';

my @parts = split m|\s+|, $args;
my $arg   = shift @parts // '';

return { 'mode' => qw| false |, 'data' => 'usage: doc <module-or-symbol>' }
    if not length $arg;

my @cmd = ( <ncode.bin>, qw| doc |, $arg );

my $output = $code{'ncode.util.run_cmd'}->(@cmd);

return { 'mode' => qw| size |, 'data' => $output };

