## [:< ##

# name  = v7-zenki.set_up_zenka_dependencies
# descr = configures zenka dependency chains
# param = [zenka_name ..] [ new zenki : setup data + dependency objects ]

## called on every [re-]init : objects only for the zenki passed            ##
## [ new since the last run -- their ids must stay stable ], chains rebuilt ##
## for ALL known zenki from their current config [ a dependency removed     ##
## from a start.cfg survived a reload before, 2026-09-30 ]                  ##
my @zenki = @ARG;

# callbacks for dependency validation
<[dependency.install_callbacks]>->('v7-zenki') if @zenki;

# set up dependency objects ..,
foreach my $zenka_name (@zenki) {

    <[base.log]>->( 2, ": dependency object : zenka '$zenka_name'" );

    # install zenka setup data
    my $zenka_id = <[zenka.setup.add]>->( { 'name' => $zenka_name } );

    # create dependency objects for the zenki
    <[dependency.add_object]>->(
        {   'type'       => 'zenka',
            'zenka_id'   => $zenka_id,
            'zenka_name' => $zenka_name,
        }
    );
}

<[base.log]>->( 1, 'setting up zenka dependency chains.,' );

## an empty id is no zenka : a ->{$zenka_id}->{'name'} read with an empty ##
## id autovivified it, and its undef name failed every reinit [ pri ]     ##
delete <v7-zenki.zenka.setup>->{''};

foreach my $s_id (
    sort {
        <v7-zenki.zenka.setup>->{$a}->{'name'} cmp
            <v7-zenki.zenka.setup>->{$b}->{'name'}
    } keys( <v7-zenki.zenka.setup>->%* )
) {
    my $zenka_name = <v7-zenki.zenka.setup>->{$s_id}->{'name'};
    next if not defined $zenka_name;
    my $source_object = <[zenka.get_object_id]>->($s_id);

    ## rebuilt from config : a missing chain means 'no dependencies' to the ##
    ## readers [ dependency.ok \ get_missing \ parser.dependency_chain ]    ##
    delete <dependency.chain>->{$source_object} if defined $source_object;

    my $dependencies = <[zenka.get_dependencies]>->($zenka_name);

    ## optional dependencies disabled on this host : left out, said once ##
    foreach my $optional (
        split m|\s+|,
        (   ( <v7-zenki.start_setup.zenki.config> // {} )->{$zenka_name} // {}
        )->{'optional_dependencies'} // ''
    ) {
        next
            if not length $optional
            or not <[zenka.is_disabled]>->($optional);
        <[base.logs]>->(
            1,
            ": optional dependency '%s' of '%s' skipped : disabled "
                . 'on this host',
            $optional,
            $zenka_name
        );
    }

    if ( defined $dependencies ) {
        <[base.log]>->(
            2, ": zenka '$zenka_name' dependencies [ $dependencies ]"
        );

        foreach my $dep_zenka_name ( split m| +|, $dependencies ) {
            my $object_id;
            if ( $dep_zenka_name =~ m|^([\w-]+):([\w-]+)$| ) {
                my ( $type, $name ) = ( $1, $2 );
                foreach my $id ( keys <dependency.object>->%* ) {
                    next if <dependency.object>->{$id}->{'type'} ne $type;
                    if ( ( <dependency.object>->{$id}->{'name'} // '' ) eq
                        $name ) {
                        $object_id = $id;
                        last;
                    }
                }
                ## a condition type with a callback [ unix_user:name,     ##
                ## unix_group:name .. : v7-zenki.callback.object.<type> ] ##
                ## gets its object on first use -- a start.cfg names the  ##
                ## condition, nothing else to set                         ##
                if ( not defined $object_id
                    and exists $code{"v7-zenki.callback.object.$type"} ) {
                    $object_id = <[dependency.add_object]>
                        ->( { 'type' => $type, 'name' => $name } );
                    <[base.log]>->(
                        2,     ": condition object : %s:%s",
                        $type, $name
                    ) if defined $object_id;
                }
                if ( not defined $object_id ) {
                    <[base.log]>->(
                        0,
                        "a '$type' type object named '$name' does not exist."
                    );
                    <[base.log]>->(
                        0,
                        "[WARNING] skipping invalid $type "
                            . "dependency for object $source_object"
                    );
                    next;
                }
            } else {

                if ( !<[zenka.is_enabled]>->($dep_zenka_name) ) {
                    <[base.log]>->(
                        2,
                        "<< ! >> zenka '$dep_zenka_name' listed "
                            . "as dependency but is not enabled!"
                    );

                    #                <[v7-zenki.teardown]>;
                }

                # choosing first zenka with such a name (for now)
                my $first_id = <[zenka.get_id]>->($dep_zenka_name);
                if ( not defined $first_id ) {
                    <[base.log]>->(
                        0,
                        "[obj.dependency:'$source_object'] "
                            . "unknown zenka '$dep_zenka_name'"
                    );
                    next;
                } else {
                    $object_id = <[zenka.get_object_id]>->($first_id);
                }
            }
            <[dependency.add]>->( $source_object, $object_id );
        }
    }

    ## implicit sys_deps condition per zenka [ auto_install_deps feature ]  ##
    ## [ also zenki without a dependencies line ] -- off : no change at all ##
    ## exempt : the install path itself                                     ##
    ## [ routing, logging, the installers ] -- debian waiting for an        ##
    ## install only debian can do never starts                              ##
    my $sys_deps_exempt = <v7-zenki.cfg.sys_deps.exempt>
        // 'cube p7-log debian os-pkg';
    if (<[base.cfg_bool]>->( <v7-zenki.cfg.auto_install_deps> // FALSE )
        and not grep { $ARG eq $zenka_name } split m|\s+|,
        $sys_deps_exempt
    ) {
        my $type = qw| sys_deps |;
        my $name = $zenka_name;
        my $object_id;
        foreach my $id ( keys <dependency.object>->%* ) {
            next if <dependency.object>->{$id}->{'type'} ne $type;
            if ( ( <dependency.object>->{$id}->{'name'} // '' ) eq $name ) {
                $object_id = $id;
                last;
            }
        }
        ## a condition type with a callback gets its object on first use -- ##
        ## one sys_deps object per zenka name                               ##
        ## [ same as start.cfg named conditions ]                           ##
        if ( not defined $object_id
            and exists $code{"v7-zenki.callback.object.$type"} ) {
            $object_id = <[dependency.add_object]>
                ->( { 'type' => $type, 'name' => $name } );
            <[base.log]>->( 2, ": condition object : %s:%s", $type, $name )
                if defined $object_id;
        }
        <[dependency.add]>->( $source_object, $object_id )
            if defined $object_id;
    }
}

