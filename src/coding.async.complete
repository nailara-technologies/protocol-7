## [:< ##

# name  = coding.async.complete
# descr = handle completion of async coding task
# purpose = Phase 1: Callback when deferred inference finishes

my ( $task_id, $result ) = @ARG;

return { success => FALSE, error => 'task_id required' }
    unless defined $task_id;

## retrieve stored state ##
my $state = <[coding.async.state_manager]>->( 'get', $task_id );

## state may have been deleted by a prior timeout requeue  for compaction ##
## subtasks we must still unblock the parent                              ##
if ( not defined $state ) {
    my $task_rec  = <coding.task.queue>->{$task_id} // {};
    my $meta      = $task_rec->{'metadata'}         // {};
    my $parent_id = <coding.task.parent>->{$task_id}
        // $meta->{'parent_task_id'};
    if ( $meta->{'is_compaction'} and defined $parent_id ) {
        my $pstate = <[coding.async.state_manager]>->( 'get', $parent_id );
        if ( defined $pstate
            and ( $pstate->{'compaction_pending'} // '' ) eq $task_id ) {
            delete $pstate->{'compaction_pending'};
            delete $pstate->{'compact_start'};
            delete $pstate->{'compact_end'};
            $pstate->{'compaction_applied_round'} = $pstate->{'round'} // 0;
            $pstate->{'pending_subtask'}          = undef;
            $pstate->{'state'}                    = qw| running |;
            <coding.async.task_state>->{$parent_id} = $pstate;
            <[base.logs]>->(
                1,
                "async.complete: compaction %s had no state "
                    . "— unblocked parent %s [ heuristic fallback ]",
                $task_id,
                $parent_id
            );
            <[event.add_timer]>->(
                {   after   => 0.1,
                    handler => qw| coding.handler.process-queued-task |,
                }
            );
        }
    } elsif ( $meta->{'is_chunked_summary'} and defined $parent_id ) {
        my $pstate = <[coding.async.state_manager]>->( 'get', $parent_id );
        if ( defined $pstate
            and ( $pstate->{'chunked_summary_pending'} // '' ) eq $task_id ) {
            delete $pstate->{'chunked_summary_pending'};
            $pstate->{'pending_subtask'} = undef;
            $pstate->{'state'}           = qw| running |;
            <coding.async.task_state>->{$parent_id} = $pstate;
            <[base.logs]>->(
                1,
                "async.complete: chunked summary %s had no state "
                    . "— unblocked parent %s [ heuristic fallback ]",
                $task_id,
                $parent_id
            );
            <[event.add_timer]>->(
                {   after   => 0.1,
                    handler => qw| coding.handler.process-queued-task |,
                }
            );
        }
    }
    return { success => FALSE, error => "no state for task $task_id" };
}

my $job_id = $state->{'job_id'};

## release backend lock : wakes next queued task if any ##
my $backend = $state->{'backend'} // '';
<[coding.async.backend_release]>->( $task_id, $backend ) if length $backend;

## save conversation state before cleanup  : needed for task-append ##
## resumption                                                       ##
my $task_rec = <coding.task.queue>->{$task_id};
if ( defined $task_rec ) {
    $task_rec->{'execution'}->{'messages'} = $state->{'messages'}
        if defined $state->{'messages'};
    $task_rec->{'execution'}->{'tools'} = $state->{'tools'}
        if defined $state->{'tools'};
}

## clean up async state ##
<[coding.async.state_manager]>->( 'delete', $task_id );

## handle completion (mirrors coding.task.execute logic) ##
if ( defined $result && $result->{'success'} ) {
    my $result_text = $result->{'result'} // '';

    ## move job to completed ##
    <[jobqueue.move_job]>->( $job_id, 'completed' )
        if defined $job_id;

    ## skip lifecycle hooks for internal compaction subtasks ##
    my $is_compaction
        = ( ( <coding.task.queue>->{$task_id} // {} )->{'metadata'} // {} )
        ->{'is_compaction'} // 0;

    ## complete the task ##
    <[coding.task.complete]>->( $task_id, $result_text )
        unless $is_compaction;

    ## resume parent if this task is a subtask ##
    my $parent_id = <coding.task.parent>->{$task_id};
    if ( defined $parent_id ) {
        my $parent_state
            = <[coding.async.state_manager]>->( qw| get |, $parent_id );
        if (    defined $parent_state
            and $parent_state->{'state'} eq qw| subtask |
            and ( $parent_state->{'pending_subtask'} // '' ) eq $task_id ) {

            my $skip_standard_resume = 0;

            ## compaction sub-task: splice summary into messages, no user ##
            ## msg                                                        ##
            if ( ( $parent_state->{'compaction_pending'} // '' ) eq $task_id )
            {
                my $c_start     = $parent_state->{'compact_start'} // 2;
                my $c_end       = $parent_state->{'compact_end'}   // 2;
                my $msgs        = $parent_state->{'messages'};
                my $round       = $parent_state->{'round'} // 0;
                my $n_compacted = $c_end - $c_start;

                if ( $n_compacted > 0 and $c_end <= scalar @{$msgs} ) {
                    splice @{$msgs}, $c_start, $n_compacted,
                        {
                        'role'    => 'assistant',
                        'content' => "[ compaction summary | round $round ]\n"
                            . $result_text,
                        };
                    <[base.logs]>->(
                        1, "[%s] compaction applied : msgs : %d -> 1",
                        $parent_id, $n_compacted
                    );
                }
                delete $parent_state->{'compaction_pending'};
                delete $parent_state->{'compact_start'};
                delete $parent_state->{'compact_end'};
                ## prevent re-triggering on same round  if still near ##
                ## threshold                                          ##
                $parent_state->{'compaction_applied_round'} = $round;
            }
            ## chunked summary sub-task: fold result, enqueue next or ##
            ## complete                                               ##
            elsif ( ( $parent_state->{'chunked_summary_pending'} // '' ) eq
                $task_id ) {
                my $parent_task = <coding.task.queue>->{$parent_id} // {};
                my $chunk_state
                    = $parent_task->{'metadata'}->{'chunked_summary_state'}
                    // {};

                my $current_idx  = ( $chunk_state->{'current_idx'} // 0 ) + 1;
                my $total_chunks = $chunk_state->{'total_chunks'} // 1;
                my $running_summary = $result_text;
                my $backend = $parent_state->{'backend'}      // qw| gpu |;
                my $sys     = $chunk_state->{'system_prompt'} // '';

                $chunk_state->{'current_idx'}     = $current_idx;
                $chunk_state->{'running_summary'} = $running_summary;

                if ( $current_idx < $total_chunks ) {
                    ## enqueue next chunk child ##
                    my $next_chunk = $chunk_state->{'chunks'}[$current_idx];
                    my $child_prompt
                        = "running summary so far:\n$running_summary\n\nnew "
                        . "text to fold in:\n$next_chunk\n\nproduce an "
                        . "updated running summary that preserves "
                        . "information from both, information-dense, "
                        . "no preamble.";

                    ## guard: if still too big once wrapped, split the    ##
                    ## excess back into the chunk queue as an additional  ##
                    ## chunk instead of discarding it -- mirrors the      ##
                    ## chunk-0 guard in coding.task.chunk_and_summarize : ##
                    ## same 1.4 conservative factor, same "never lose     ##
                    ## content" rule.  also include the system prompt's   ##
                    ## length -- it rides in the same messages array      ##
                    ## coding.task.execute measures, and omitting it      ##
                    ## understated the real cost                          ##
                    my $chars_per_token = 3.2;
                    my $prompt_est      = int(
                        (   ( bytes::length($child_prompt) + length($sys) )
                            * 1.6
                        ) / $chars_per_token
                    );
                    my $p_srv_key = $parent_state->{'backend'} // qw| gpu |;
                    my $p_srv_info
                        = ( <coding.inference_servers> // {} )->{$p_srv_key}
                        // {};
                    my $p_n_ctx = $p_srv_info->{'n_ctx'}
                        // <inference.model.context_length> // 7777;
                    if ( $prompt_est > $p_n_ctx - 1000 ) {
                        my $overrun = $prompt_est - ( $p_n_ctx - 1000 );
                        my $head
                            = "running summary so far:\n$running_summary\n\n";
                        my $split_at
                            = length($next_chunk)
                            - int( $overrun * $chars_per_token / 1.6 )
                            - 100;
                        $split_at = 500 if $split_at < 500;

                        my $overflow_text = substr( $next_chunk, $split_at );
                        $next_chunk = substr( $next_chunk, 0, $split_at );

                        ## re-insert the overflow as the next chunk in the ##
                        ## queue -- never lost, just deferred one pass     ##
                        splice(
                            @{ $chunk_state->{'chunks'} },
                            $current_idx + 1,
                            0, $overflow_text
                        );
                        $total_chunks = scalar @{ $chunk_state->{'chunks'} };
                        $chunk_state->{'total_chunks'} = $total_chunks;

                        $child_prompt
                            = $head
                            . "new text to fold in:\n$next_chunk\n\nproduce "
                            . "an updated running summary that "
                            . "preserves information from both, "
                            . "information-dense, no preamble.";
                        <[base.logs]>->(
                            0,
                            "chunk_and_summarize: chunk %d split at %d chars "
                                . "[ overrun %d tokens, %d bytes carried "
                                . "forward as a new chunk, now %d total "
                                . "chunks ]",
                            $current_idx + 1,
                            length($next_chunk),
                            $overrun,
                            length($overflow_text),
                            $total_chunks
                        );
                    }

                    my $child_task_id
                        = <[coding.helper.task_id_generator]>->(qw| chunk |);
                    my $enqueue_result = <[coding.task.enqueue]>->(
                        {   id       => $child_task_id,
                            type     => qw| general |,
                            request  => { description => $child_prompt },
                            metadata => {
                                raw_request => {
                                    type        => $backend,
                                    description => $child_prompt
                                },
                                parent_task_id     => $parent_id,
                                is_chunked_summary => 1,
                            },
                            analysis   => { routed_to => $backend },
                            execution  => { status    => qw| pending | },
                            created_at => <[base.ntime]>,
                            system     => $sys,
                            no_tools   => 1,
                            max_rounds => 1,
                        }
                    );

                    my $child_id
                        = ( ref $enqueue_result eq qw| HASH |
                            and $enqueue_result->{'success'} )
                        ? $enqueue_result->{'task_id'}
                        : undef;

                    if ( defined $child_id and length $child_id ) {
                        <coding.task.parent>->{$child_id} = $parent_id;
                        $parent_state->{'chunked_summary_pending'}
                            = $child_id;
                        $parent_state->{'pending_subtask'} = $child_id;
                        <coding.async.task_state>->{$parent_id}
                            = $parent_state;
                        <[base.logs]>->(
                            1,
                            "chunk_and_summarize: chunk %d/%d → child %s",
                            $current_idx + 1,
                            $total_chunks, $child_id
                        );
                    } else {
                        ## enqueue failed: complete parent with what we ##
                        ## have                                         ##
                        <[base.logs]>->(
                            0,
                            "chunk_and_summarize: enqueue of chunk %d "
                                . "failed, completing parent with partial "
                                . "summary",
                            $current_idx + 1
                        );
                        delete $parent_state->{'chunked_summary_pending'};
                        $parent_state->{'pending_subtask'} = undef;
                        <coding.async.task_state>->{$parent_id}
                            = $parent_state;
                        <[jobqueue.move_job]>->(
                            $chunk_state->{'parent_job_id'}, 'completed'
                        ) if defined $chunk_state->{'parent_job_id'};
                        <[coding.task.complete]>->(
                            $parent_id, $running_summary
                        );
                    }
                } else {
                    ## all chunks done ##
                    delete $parent_state->{'chunked_summary_pending'};
                    $parent_state->{'pending_subtask'} = undef;
                    <coding.async.task_state>->{$parent_id} = $parent_state;
                    <[jobqueue.move_job]>->(
                        $chunk_state->{'parent_job_id'}, 'completed'
                    ) if defined $chunk_state->{'parent_job_id'};
                    <[coding.task.complete]>
                        ->( $parent_id, $running_summary );
                }
                $skip_standard_resume = 1;
            } else {
                ## regular subtask: append result as user message ##
                push @{ $parent_state->{'messages'} },
                    {
                    'role'    => 'user',
                    'content' => "[SUBTASK RESULT: $task_id]\n\n"
                        . $result_text
                    };
            }

            unless ($skip_standard_resume) {
                ## check subtask queue for more work ##
                my $queue = <coding.task.subtask_queue>->{$parent_id} // [];
                ## remove completed subtask from front of queue ##
                while ( @$queue && $queue->[0] eq $task_id ) {
                    shift @$queue;
                }
                <coding.task.subtask_queue>->{$parent_id} = $queue;

                if (@$queue) {
                    ## check if parent was stopped while this subtask ran ##
                    my $parent_task_rec = <coding.task.queue>->{$parent_id};
                    if ( defined $parent_task_rec
                        && $parent_task_rec->{'stop_requested'} ) {
                        <[base.logs]>->(
                            1,
                            "async.complete: parent %s was stopped, "
                                . "clearing %d remaining subtask(s)",
                            $parent_id,
                            scalar @$queue
                        );
                        ## clear remaining queue so they don't start later ##
                        for my $orphan_id (@$queue) {
                            my $orphan
                                = delete <coding.task.queue>->{$orphan_id};
                            if ( defined $orphan ) {
                                $orphan->{'execution'}->{'status'}
                                    = qw| cancelled |;
                                push @{ <coding.task.completed> //= [] },
                                    $orphan_id;
                            }
                            delete <coding.task.parent>->{$orphan_id};
                        }
                        <coding.task.subtask_queue>->{$parent_id} = [];
                        $parent_state->{'pending_subtask'} = undef;
                        $parent_state->{'state'}           = qw| streaming |;
                        <coding.async.task_state>->{$parent_id}
                            = $parent_state;
                    } else {
                        my $next_subtask = $queue->[0];
                        $parent_state->{'pending_subtask'} = $next_subtask;
                        ## stay in subtask state : next queued task will ##
                        ## run                                           ##
                        <coding.async.task_state>->{$parent_id}
                            = $parent_state;
                        ## enqueue the next subtask so the task queue picks ##
                        ## it up [ remove from queue first to avoid         ##
                        ## duplicate rejection ]                            ##
                        my $next_task
                            = delete <coding.task.queue>->{$next_subtask};
                        if ( defined $next_task ) {
                            my $enq = <[coding.task.enqueue]>->($next_task);
                            if ( !$enq->{'success'} ) {
                                ## restore if enqueue failed ##
                                <coding.task.queue>->{$next_subtask}
                                    = $next_task;
                                <[base.logs]>->(
                                    0,
                                    "async.complete: "
                                        . "enqueue of %s failed: %s",
                                    $next_subtask,
                                    $enq->{'error'} // 'unknown'
                                );
                            }
                        } else {
                            <[base.logs]>->(
                                0,
                                "async.complete: next "
                                    . "subtask %s not found in queue",
                                $next_subtask
                            );
                        }
                        <[base.logs]>->(
                            1,
                            "async.complete: parent %s "
                                . "starting next queued subtask %s",
                            $parent_id,
                            $next_subtask
                        );
                    }
                } else {
                    $parent_state->{'pending_subtask'} = undef;
                    ## transition parent from subtask back to streaming ##
                    $parent_state->{'state'} = qw| streaming |;
                    <coding.async.task_state>->{$parent_id} = $parent_state;
                    <[coding.task.enqueue_round]>->(
                        $parent_id, $parent_state->{'round'}
                    );
                    <[base.logs]>->(
                        1,
                        "async.complete: resumed parent %s from subtask %s",
                        $parent_id, $task_id
                    );
                }
            }
        } elsif ( defined $parent_state
            and $parent_state->{'state'} eq qw| subtask | ) {
            <[base.logs]>->(
                1,
                "async.complete: subtask %s "
                    . "completed but parent %s waits for %s",
                $task_id,
                $parent_id,
                $parent_state->{'pending_subtask'} // qw| none |
            );
        }
    }

    <[base.logs]>->( 2, "async.complete: task %s completed", $task_id );

    return { success => TRUE, task_id => $task_id };
} else {
    my $error_msg = $result->{'error'} // 'unknown error';
    my $err_short = <[base.parser.center_ellipse_string]>->( $error_msg, 72 );

    <[base.logs]>->(
        0,        "async.complete: task %s failed: %s",
        $task_id, $err_short
    );

    ## move job to error ##
    <[jobqueue.move_job]>->( $job_id, qw| error | )
        if defined $job_id;

    ## mark task failed and remove from active/pending lists      ##
    ## coding.task.fail has a P7 data-path bug, so we inline this ##
    my $task_obj_fail = <coding.task.queue>->{$task_id};
    if ( defined $task_obj_fail ) {
        $task_obj_fail->{'execution'}->{'status'}    = qw| failed |;
        $task_obj_fail->{'execution'}->{'error'}     = $error_msg;
        $task_obj_fail->{'execution'}->{'failed_at'} = <[base.time]>->(3);
    }
    my $aref_pending_f = <coding.task.pending> // [];
    my $aref_active_f  = <coding.task.active>  // [];
    my $aref_failed_f  = <coding.task.failed> //= [];
    $aref_pending_f->@* = grep { $ARG ne $task_id } $aref_pending_f->@*;
    $aref_active_f->@*  = grep { $ARG ne $task_id } $aref_active_f->@*;
    push $aref_failed_f->@*, $task_id
        unless grep { $ARG eq $task_id } $aref_failed_f->@*;

    ## resolve reasoning branch as failed [ else it stays 'running' forever ##
    ## ]                                                                    ##
    <[reasoning.branch.resolve]>
        ->( { id => $task_id, output => "failed: $error_msg" } );

    ## fire any deferred reply waiting on this task (ask-reply, etc.) ##
    my $deferred_replies = <coding.deferred_replies> // {};
    for my $did ( keys %{$deferred_replies} ) {
        my $dr = $deferred_replies->{$did};
        if ( defined $dr && ( $dr->{'task_id'} // '' ) eq $task_id ) {
            <[coding.handler.deferred_reply]>->($did);
            last;
        }
    }

    ## notify parent if this task is a subtask ##
    my $parent_id_fail = <coding.task.parent>->{$task_id};
    if ( defined $parent_id_fail ) {
        my $parent_state
            = <[coding.async.state_manager]>->( qw| get |, $parent_id_fail );
        if (    defined $parent_state
            and $parent_state->{'state'} eq qw| subtask |
            and ( $parent_state->{'pending_subtask'} // '' ) eq $task_id ) {
            my $skip_standard_resume_fail = 0;

            if ( ( $parent_state->{'compaction_pending'} // '' ) eq $task_id )
            {
                ## compaction child failed: clear markers, let parent ##
                ## resume                                             ##
                delete $parent_state->{'compaction_pending'};
                delete $parent_state->{'compact_start'};
                delete $parent_state->{'compact_end'};
            } elsif ( ( $parent_state->{'chunked_summary_pending'} // '' ) eq
                $task_id ) {
                ## chunked summary child failed ##
                my $parent_task = <coding.task.queue>->{$parent_id_fail}
                    // {};
                my $chunk_state
                    = $parent_task->{'metadata'}->{'chunked_summary_state'}
                    // {};
                my $running_summary = $chunk_state->{'running_summary'} // '';

                delete $parent_state->{'chunked_summary_pending'};
                $parent_state->{'pending_subtask'} = undef;
                <coding.async.task_state>->{$parent_id_fail} = $parent_state;

                if ( length $running_summary ) {
                    <[jobqueue.move_job]>->(
                        $chunk_state->{'parent_job_id'}, 'completed'
                    ) if defined $chunk_state->{'parent_job_id'};
                    <[coding.task.complete]>->(
                        $parent_id_fail, $running_summary
                    );
                    <[base.logs]>->(
                        1,
                        "async.complete: chunked summary parent %s completed "
                            . "with partial summary after child %s failed",
                        $parent_id_fail,
                        $task_id
                    );
                } else {
                    my $err = "chunked summary failed: $error_msg";
                    if ( defined $parent_task ) {
                        $parent_task->{'execution'}->{'status'}
                            = qw| failed |;
                        $parent_task->{'execution'}->{'error'} = $err;
                    }
                    my $pending_f = <coding.task.pending> // [];
                    my $active_f  = <coding.task.active>  // [];
                    $pending_f->@*
                        = grep { $ARG ne $parent_id_fail } $pending_f->@*;
                    $active_f->@*
                        = grep { $ARG ne $parent_id_fail } $active_f->@*;
                    <[jobqueue.move_job]>->(
                        $chunk_state->{'parent_job_id'},
                        qw| error |
                    ) if defined $chunk_state->{'parent_job_id'};
                    <[base.logs]>->(
                        0,
                        "async.complete: chunked summary parent "
                            . "%s failed after child %s failed: %s",
                        $parent_id_fail,
                        $task_id,
                        $error_msg
                    );
                }
                $skip_standard_resume_fail = 1;
            } else {
                push @{ $parent_state->{'messages'} },
                    {
                    'role'    => 'user',
                    'content' => "[SUBTASK FAILED: $task_id]\n\n"
                        . $error_msg
                    };
            }

            unless ($skip_standard_resume_fail) {
                ## check subtask queue for more work ##
                my $queue = <coding.task.subtask_queue>->{$parent_id_fail}
                    // [];
                while ( @$queue && $queue->[0] eq $task_id ) {
                    shift @$queue;
                }
                <coding.task.subtask_queue>->{$parent_id_fail} = $queue;

                if (@$queue) {
                    ## check if parent was stopped while this subtask ran ##
                    my $parent_task_rec
                        = <coding.task.queue>->{$parent_id_fail};
                    if ( defined $parent_task_rec
                        && $parent_task_rec->{'stop_requested'} ) {
                        <[base.logs]>->(
                            1,
                            "async.complete: parent %s was stopped, clearing "
                                . "%d remaining subtask(s) after failure",
                            $parent_id_fail,
                            scalar @$queue
                        );
                        for my $orphan_id (@$queue) {
                            my $orphan
                                = delete <coding.task.queue>->{$orphan_id};
                            if ( defined $orphan ) {
                                $orphan->{'execution'}->{'status'}
                                    = qw| cancelled |;
                                push @{ <coding.task.completed> //= [] },
                                    $orphan_id;
                            }
                            delete <coding.task.parent>->{$orphan_id};
                        }
                        <coding.task.subtask_queue>->{$parent_id_fail} = [];
                        $parent_state->{'pending_subtask'} = undef;
                        $parent_state->{'state'}           = qw| streaming |;
                        <coding.async.task_state>->{$parent_id_fail}
                            = $parent_state;
                    } else {
                        my $next_subtask = $queue->[0];
                        $parent_state->{'pending_subtask'} = $next_subtask;
                        ## stay in subtask state : next queued task will ##
                        ## run                                           ##
                        <coding.async.task_state>->{$parent_id_fail}
                            = $parent_state;
                        ## enqueue the next subtask so the task queue picks ##
                        ## it up [ remove from queue first to avoid         ##
                        ## duplicate rejection ]                            ##
                        my $next_task
                            = delete <coding.task.queue>->{$next_subtask};
                        if ( defined $next_task ) {
                            my $enq = <[coding.task.enqueue]>->($next_task);
                            if ( !$enq->{'success'} ) {
                                ## restore if enqueue failed ##
                                <coding.task.queue>->{$next_subtask}
                                    = $next_task;
                                <[base.logs]>->(
                                    0,
                                    "async.complete: enqueue "
                                        . "of %s failed : %s",
                                    $next_subtask,
                                    $enq->{'error'} // qw| unknown |
                                );
                            }
                        } else {
                            <[base.logs]>->(
                                0,
                                "async.complete: next "
                                    . "subtask %s not found in queue",
                                $next_subtask
                            );
                        }
                        <[base.logs]>->(
                            1,
                            "async.complete: parent %s starting "
                                . "next queued subtask %s after failure",
                            $parent_id_fail,
                            $next_subtask
                        );
                    }
                } else {
                    $parent_state->{'pending_subtask'} = undef;
                    ## transition parent from subtask back to streaming ##
                    $parent_state->{'state'} = qw| streaming |;
                    <coding.async.task_state>->{$parent_id_fail}
                        = $parent_state;
                    <[coding.task.enqueue_round]>->(
                        $parent_id_fail, $parent_state->{'round'}
                    );
                    <[base.logs]>->(
                        1,
                        "async.complete: resumed parent "
                            . "%s after subtask %s failed",
                        $parent_id_fail,
                        $task_id
                    );
                }
            }
        } elsif ( defined $parent_state
            and $parent_state->{'state'} eq qw| subtask | ) {
            <[base.logs]>->(
                1,
                "async.complete: subtask %s "
                    . "failed but parent %s waits for %s",
                $task_id,
                $parent_id_fail,
                $parent_state->{'pending_subtask'} // qw| none |
            );
        }
    }

    return { success => FALSE, error => $error_msg, task_id => $task_id };
}

