## [:< ##

# name  = jobsite.job.read
# descr = read a single job record from per-file storage via status index

my $job_id = shift // '';
return undef if not length $job_id;

my $status = <jobsite.job.index>->{$job_id} // '';
return undef unless length $status;

my $enc_id = <[base.vax-int.encode]>->($job_id);

my ( $rel_path, $is_trash ) = do {
    if ( $status =~ m{^(blocked|deleted):(.+)$} ) {
        ( "jobs/$1/$2/$enc_id.yaml", 0 );
    } elsif ( $status =~ m{^trash:(.+)$} ) {
        ( "jobs/trash/$1/$enc_id.yxz.B32", 1 );
    } else {
        ( "jobs/$status/$enc_id.yaml", 0 );
    }
};

my $raw = <[file.zenka_dir.load]>->($rel_path);
return undef unless defined $raw;

my $bytes = $$raw;
utf8::encode($bytes) if utf8::is_utf8($bytes);

if ($is_trash) {
    my $compressed = <[base32.decode]>->($bytes);
    if ( not defined $compressed ) {
        <[base.logs]>->(
            0,       'jss.job.read: base32 decode error for %s : %s',
            $job_id, $@ // 'unknown'
        );
        return undef;
    }
    my $yaml;
    IO::Uncompress::UnXz::unxz( \$compressed, \$yaml )
        or return <[base.logs]>->(
        0,       'jss.job.read: xz decompress error for %s : %s',
        $job_id, $IO::Uncompress::UnXz::UnXzError
        );
    $bytes = $yaml;
}

my ( $job, $yaml_err ) = <[format.yaml.load_str]>->($bytes);
if ($yaml_err) {
    <[base.logs]>->(
        0,       'jss.job.read: load error for %s: %s',
        $job_id, $yaml_err
    );
    return undef;
}
return undef if ref $job ne 'HASH';

## normalize all scalar values to unicode strings ##
for my $v ( values %$job ) {
    next             if not defined $v or ref $v;
    utf8::decode($v) if not utf8::is_utf8($v) and utf8::valid($v);
}

return $job;

