## [:< ##

# name  = coding.task.enqueue_round
# descr = schedule next inference round for task
# param = <task_id> <round>

my ( $task_id, $round ) = @ARG;

return { success => FALSE, error => 'task_id required' }
    unless defined $task_id;

return { success => FALSE, error => 'round required' }
    unless defined $round;

my $task = <coding.task.queue>->{$task_id};

return { success => FALSE, error => "task not found: $task_id" }
    unless defined $task;

## acquire backend lock or queue : backend_release wakes us if busy. a     ##
## round continuation inside the holder's own callback chain presents the  ##
## current token [ via lock_ctx ] and re-enters ; a token-less caller      ##
## [ task-append, timers, complete's recovery / parent-resume ] is a fresh ##
## acquire and queues while the lock is held -- even by this same task     ##
my $backend = ( <coding.async.task_state>->{$task_id} // {} )->{'backend'}
    // qw| gpu |;
my $lock_result = <[coding.async.backend_acquire]>->( $task_id, $backend );

<[base.logs]>->(
    1, "enqueue_round: %s round=%d [backend %s: %s]",
    $task_id, $round, $backend,
    $lock_result->{'acquired'} ? 'acquired' : 'queued'
);

## proceed immediately if lock acquired                                     ##
## [ backend_release handles the queued case ] : send inside a lock context ##
## presenting the token just granted, async.request's own acquire re-enters ##
## and rotates it                                                           ##
if ( $lock_result->{'acquired'} ) {
    local <coding.async.lock_ctx> = {
        'task_id' => $task_id,
        'backend' => $backend,
        'token'   => $lock_result->{'token'}
    };
    my $sent = <[coding.async.send_request]>->($task_id);

    ## send_request bailed before a request took the lock over ##
    ## [ token unchanged ] : release instead of leaking it     ##
    my $bs = ( <coding.state.backend> // {} )->{$backend} // {};
    if (    ref $sent eq qw| HASH |
        and not $sent->{'success'}
        and ( $bs->{'lock'}       // '' ) eq $task_id
        and ( $bs->{'lock_token'} // 0 ) == $lock_result->{'token'} ) {
        <[base.logs]>->(
            1, 'enqueue_round: %s send bailed [%s], releasing %s lock',
            $task_id, $sent->{'error'} // 'unknown', $backend
        );
        <[coding.async.backend_release]>->(
            $task_id, $backend, $lock_result->{'token'}
        );
    }
}

return {
    success  => TRUE,
    task_id  => $task_id,
    round    => $round,
    deferred => TRUE,
};

