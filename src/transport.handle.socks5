## [:< ##

# name  = transport.handle.socks5
# descr = shared SOCKS5 client for external tunnel proxies
# args  = $proxy_host, $proxy_port, $target_host, $target_port, \%opts
# returns connected socket or undef

my ( $proxy_host, $proxy_port, $target_host, $target_port, $opts ) = @ARG;

$opts //= {};

## try IO::Socket::Socks first ##
my $sock;
my $has_socks = <[base.perlmod.loaded]>->('IO::Socket::Socks')
    || <[base.perlmod.autoload]>->('IO::Socket::Socks');

if ($has_socks) {
    $sock = IO::Socket::Socks->new(
        ProxyAddr    => $proxy_host,
        ProxyPort    => $proxy_port,
        ConnectAddr  => $target_host,
        ConnectPort  => $target_port,
        SocksVersion => 5,
        Timeout      => $opts->{'timeout'} // 10,
    );
    if ($sock) {
        $sock->blocking(0) if $sock->can('blocking');
        return $sock;
    }
}

## fallback: connect to proxy, do minimal SOCKS5 handshake manually ##
$sock = IO::Socket::IP->new(
    PeerHost => $proxy_host,
    PeerPort => $proxy_port,
    Type     => SOCK_STREAM(),
    Timeout  => 7,
);

if ( not $sock ) {
    <[base.logs]>->(
        0, 'transport.handle.socks5: proxy connect to %s:%d failed: %s',
        $proxy_host, $proxy_port, $OS_ERROR
    );
    return undef;
}

## minimal SOCKS5 connect handshake  greeting: version=5, nmethods=1, ##
## methods=[0x00 no auth]                                             ##
my $greeting = pack( 'C3', 0x05, 0x01, 0x00 );
my $written  = syswrite( $sock, $greeting );
if ( not defined $written or $written != 3 ) {
    eval { $sock->close };
    return undef;
}

## read greeting response: version, method ##
my $resp;
my $n = sysread( $sock, $resp, 2 );
if ( not defined $n or $n != 2 ) {
    eval { $sock->close };
    return undef;
}
my ( $ver, $method ) = unpack( 'C2', $resp );
if ( $ver != 0x05 or $method == 0xFF ) {
    eval { $sock->close };
    return undef;
}

## request: ver=5, cmd=connect=1, rsv=0, atype=domain=3 ##
my $req = pack( 'C4', 0x05, 0x01, 0x00, 0x03 );
$req .= pack( 'C', length($target_host) ) . $target_host;
$req .= pack( 'n', $target_port );

$written = syswrite( $sock, $req );
if ( not defined $written or $written != length($req) ) {
    eval { $sock->close };
    return undef;
}

## read response header: ver, rep, rsv, atype ##
$n = sysread( $sock, $resp, 4 );
if ( not defined $n or $n != 4 ) {
    eval { $sock->close };
    return undef;
}
my ( $rver, $rep, $rrsv, $ratype ) = unpack( 'C4', $resp );
if ( $rver != 0x05 or $rep != 0x00 ) {
    eval { $sock->close };
    return undef;
}

## read bind address based on atype ##
if ( $ratype == 0x01 ) {    ## IPv4 ##
    $n = sysread( $sock, $resp, 6 );
} elsif ( $ratype == 0x03 ) {    ## domain ##
    $n = sysread( $sock, $resp, 1 );
    my $alen = unpack( 'C', $resp );
    $n = sysread( $sock, $resp, $alen + 2 );
} elsif ( $ratype == 0x04 ) {    ## IPv6 ##
    $n = sysread( $sock, $resp, 18 );
}

$sock->blocking(0);
return $sock;

