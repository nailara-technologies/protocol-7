## [:< ##

# name = v7-zenki.handler.heartbeat_timer_response

my $response    = shift;
my $instance_id = $response->{'params'}->{'instance_id'};
if ( not exists <v7-zenki.zenka.instance>->{$instance_id} ) {
    <[base.logs]>->(
        1, "instance %d gone, skipping response timer", $instance_id
    );
    return;
}
my $instance      = <v7-zenki.zenka.instance>->{$instance_id};
my $is_cube_zenka = $instance->{'is-cube'};
my $zenka_name    = $instance->{'zenka_name'};

$instance->{'timer'}->{'heartbeat-timeout'}->cancel
    if defined $instance->{'timer'}->{'heartbeat-timeout'}
    and not $instance->{'timer'}->{'heartbeat-timeout'}->is_cancelled;

## cube answered FALSE 'client not present' : the zenka's session at cube   ##
## is gone. between a zenka ending [ its cube session closes the moment the ##
## process exits ] and our own end processing [ sig_chld ->                 ##
## process_zenka_end ] there is a window where a heartbeat in flight gets   ##
## exactly this reply -- that is not a heartbeat error. ending states are   ##
## left to the end path ; only 'still online, no zombie, still no session   ##
## after one 1s re-check [ no loop ]' falls through as a real problem       ##
if ( $response->{'cmd'} eq qw| FALSE |
    and ( $response->{'call_args'}->{'args'} // '' )
    =~ m{^client not present} ) {

    my $current_status = $instance->{'status'} // '';
    my $process_id     = $instance->{'process'}->{'id'};
    my $process_ending = FALSE;

    ##  zombie : process exited, sig_chld -> process_zenka_end pending  ##
    if (    defined $process_id
        and <[v7-zenki.sub-process.pid_alive]>->($process_id)
        and open( my $stat_fh, '<', "/proc/$process_id/stat" ) ) {
        my $stat_line = <$stat_fh> // '';
        close($stat_fh);
        $process_ending = TRUE if $stat_line =~ m{^.*\)\s+[XZx]\s};
    }

    if ( $current_status ne qw| online | or $process_ending ) {
        <[base.logs]>->(
            2,
            'instance %d [ %s ] heartbeat : session gone, zenka '
                . 'ending [ status : %s ] -- left to the end path',
            $instance_id,
            $zenka_name,
            $current_status
        );
        return;
    }

    my $recheck_pid = $response->{'params'}->{'offline_recheck'} // 0;
    if ( not $recheck_pid ) {
        $response->{'params'}->{'offline_recheck'} = $process_id // -1;
        <[base.logs]>->(
            2,
            'instance %d [ %s ] heartbeat : session gone at '
                . 'cube [ status : %s ] -- re-checking once in 1s',
            $instance_id,
            $zenka_name,
            $current_status
        );
        <[event.add_timer]>->(
            {   'after' => 1,
                'desc'  => qw| v7-zenki heartbeat offline re-check |,
                'cb'    => sub {
                    $code{'v7-zenki.handler.heartbeat_timer_response'}
                        ->($response);
                }
            }
        );
        return;
    }
    if ( defined $process_id and $process_id != $recheck_pid ) {
        <[base.logs]>->(
            2,
            'instance %d [ %s ] heartbeat : process changed during '
                . 'offline re-check [ %d -> %d ] -- left to the end path',
            $instance_id,
            $zenka_name,
            $recheck_pid,
            $process_id
        );
        return;
    }
    ## re-check done : same process still online with no cube session -- ##
    ## falling through to the normal error path below [ real problem ]   ##
}

my $fail_count      = $instance->{'heartbeat'}->{'errors'}++;
my $heartbeat_retry = $fail_count ? 0 : 1;                      # retry once

if (    $response->{'cmd'} eq qw| TRUE |
    and $response->{'call_args'}->{'args'} =~ m|^beating| ) {  # success again
    delete $instance->{'heartbeat'}->{'errors'};
    delete $instance->{'heartbeat'}->{'pressure_ext'};    ## answered again ##

    ##  latency stats [ zenka-stamped, cube : v7 round trip ]  ##
    my ( $latency, $source );
    if ( $response->{'call_args'}->{'args'} =~ m|\[ ([\d.]+) secs \]| ) {
        ( $latency, $source ) = ( $1, qw| zenka | );
    } elsif ( defined $instance->{'heartbeat'}->{'sent_at'} ) {
        ( $latency, $source ) = (
            sprintf( qw| %.4f |,
                <[base.time]>->(4) - $instance->{'heartbeat'}->{'sent_at'} ),
            qw| v7-rtt |
        );
    }
    if ( defined $latency ) {
        my $stats_tree = <v7-zenki.stats.heartbeat>  //= {};
        my $stats      = $stats_tree->{$instance_id} //= {};
        $stats->{'zenka_name'} = $zenka_name;    ##  list sort key  ##

        ##  clean-up for instances no longer present  ##
        map { delete $stats_tree->{$ARG} }
            grep { not exists <v7-zenki.zenka.instance>->{$ARG} }
            keys $stats_tree->%*;

        ##  outliers : to average, before first average to minimum  ##
        my ( $ref_value, $ref_name )
            = defined $stats->{'average'}
            ? ( $stats->{'average'}, qw| average | )
            : ( $stats->{'min'}, qw| min | );
        ## an outlier is counted [ list heartbeat ] ; logged only above an ##
        ## absolute floor too -- 10x a ~2ms average is ~20ms, under memory ##
        ## pressure nearly every heartbeat, which filled the log file at   ##
        ## level 1 every few seconds [ c9ffcacca ]. logfile at level 2     ##
        if (    defined $ref_value
            and $ref_value > 0
            and $latency > 10 * $ref_value ) {
            $stats->{'outliers'}++;
            <[base.logs]>->(
                '3:2', '%s heartbeat latency %.5f s [ %s %.5f s, %s ]',
                $zenka_name, $latency, $ref_name, $ref_value, $source
                )
                if $latency
                >= ( <v7-zenki.cfg.heartbeat.log_latency_min> // 1 );
        }
        $stats->{'count'}++;
        $stats->{'last'} = $latency;
        $stats->{'min'}  = $latency
            if !defined $stats->{'min'}
            or $latency < $stats->{'min'};
        if ( !defined $stats->{'max'} or $latency > $stats->{'max'} ) {
            $stats->{'max'}    = $latency;
            $stats->{'max_at'} = <[base.time]>->(0);
        }

        ##  outlier filtered average [ reload stalls etc. ] in batches  ##
        push $stats->{'recent'}->@*, $latency;
        if ( $stats->{'recent'}->@* >= 7 ) {
            <[base.balanced-average]>->(
                \$stats->{'average'},
                $stats->{'recent'}->@*
            );
            $stats->{'recent'} = [];
        }
        $stats->{'last_at'} = <[base.time]>->(0);
        $stats->{'source'}  = $source;
    }
    <[base.logs]>->(
        3, "instance $instance_id [success] heartbeat : =) :: %s ::",
        $zenka_name
    );

} elsif ( !$heartbeat_retry ) {

    return if $instance->{'status'} eq qw| error |;

    <[base.logs]>->(
        0, "instance $instance_id [:error:] heartbeat : :| :. %s .:",
        $zenka_name
    );
    delete <callback.session.closing_last>
        if $is_cube_zenka;    # for safe restart

    <[v7-zenki.stop_heartbeat_timer]>->($instance_id);
    $instance->{'heartbeat'}->{'errors'} = 0;    # <-- resetting error counter
    <[zenka.change_status]>->( $instance_id, qw| error | );

} else {
    <[base.logs]>->(
        0, "instance %d [%s] heartbeat response ( error ) [..retrying..]",
        $instance_id, $zenka_name
    );

    # setting shorter heartbeat timeout..,
    $instance->{'timer'}->{'heartbeat-timeout'}->cancel
        if defined $instance->{'timer'}->{'heartbeat-timeout'}
        and $instance->{'timer'}->{'heartbeat-timeout'}->is_active;
    $instance->{'timer'}->{'heartbeat-timeout'} = <[event.add_timer]>->(
        {   'after'   => $instance->{'heartbeat'}->{'retry_timeout'} // 2,
            'handler' => qw| v7-zenki.handler.heartbeat_response_timeout |,
            'data'    => $instance_id
        }
    );
}

