## [:< ##

# name = v7-zenki.handler.heartbeat_timer_response

my $response    = shift;
my $instance_id = $response->{'params'}->{'instance_id'};
if ( not exists <v7-zenki.zenka.instance>->{$instance_id} ) {
    <[base.logs]>->(
        1, "instance %d gone, skipping response timer", $instance_id
    );
    return;
}
my $instance        = <v7-zenki.zenka.instance>->{$instance_id};
my $is_cube_zenka   = $instance->{'is-cube'};
my $zenka_name      = $instance->{'zenka_name'};
my $fail_count      = $instance->{'heartbeat'}->{'errors'}++;
my $heartbeat_retry = $fail_count ? 0 : 1;                        # retry once

$instance->{'timer'}->{'heartbeat-timeout'}->cancel
    if defined $instance->{'timer'}->{'heartbeat-timeout'}
    and not $instance->{'timer'}->{'heartbeat-timeout'}->is_cancelled;

if (    $response->{'cmd'} eq qw| TRUE |
    and $response->{'call_args'}->{'args'} =~ m|^beating| ) {  # success again
    delete $instance->{'heartbeat'}->{'errors'};

    ##  latency stats [ zenka-stamped, cube : v7 round trip ]  ##
    my ( $latency, $source );
    if ( $response->{'call_args'}->{'args'} =~ m|\[ ([\d.]+) secs \]| ) {
        ( $latency, $source ) = ( $1, qw| zenka | );
    } elsif ( defined $instance->{'heartbeat'}->{'sent_at'} ) {
        ( $latency, $source ) = (
            sprintf( qw| %.4f |,
                <[base.time]>->(4) - $instance->{'heartbeat'}->{'sent_at'} ),
            qw| v7-rtt |
        );
    }
    if ( defined $latency ) {
        my $stats_tree = <v7-zenki.stats.heartbeat>  //= {};
        my $stats      = $stats_tree->{$instance_id} //= {};
        $stats->{'zenka_name'} = $zenka_name;    ##  list sort key  ##

        ##  clean-up for instances no longer present  ##
        map { delete $stats_tree->{$ARG} }
            grep { not exists <v7-zenki.zenka.instance>->{$ARG} }
            keys $stats_tree->%*;

        ##  outliers : to average, before first average to minimum  ##
        my ( $ref_value, $ref_name )
            = defined $stats->{'average'}
            ? ( $stats->{'average'}, qw| average | )
            : ( $stats->{'min'}, qw| min | );
        if (    defined $ref_value
            and $ref_value > 0
            and $latency > 10 * $ref_value ) {
            $stats->{'outliers'}++;
            <[base.logs]>->(
                '3:1', '%s heartbeat latency %.5f s [ %s %.5f s, %s ]',
                $zenka_name, $latency, $ref_name, $ref_value, $source
            );
        }
        $stats->{'count'}++;
        $stats->{'last'} = $latency;
        $stats->{'min'}  = $latency
            if !defined $stats->{'min'}
            or $latency < $stats->{'min'};
        if ( !defined $stats->{'max'} or $latency > $stats->{'max'} ) {
            $stats->{'max'}    = $latency;
            $stats->{'max_at'} = <[base.time]>->(0);
        }

        ##  outlier filtered average [ reload stalls etc. ] in batches  ##
        push $stats->{'recent'}->@*, $latency;
        if ( $stats->{'recent'}->@* >= 7 ) {
            <[base.balanced-average]>->(
                \$stats->{'average'},
                $stats->{'recent'}->@*
            );
            $stats->{'recent'} = [];
        }
        $stats->{'last_at'} = <[base.time]>->(0);
        $stats->{'source'}  = $source;
    }
    <[base.logs]>->(
        3, "instance $instance_id [success] heartbeat : =) :: %s ::",
        $zenka_name
    );

} elsif ( !$heartbeat_retry ) {

    return if $instance->{'status'} eq qw| error |;

    <[base.logs]>->(
        0, "instance $instance_id [:error:] heartbeat : :| :. %s .:",
        $zenka_name
    );
    delete <callback.session.closing_last>
        if $is_cube_zenka;    # for safe restart

    <[v7-zenki.stop_heartbeat_timer]>->($instance_id);
    $instance->{'heartbeat'}->{'errors'} = 0;    # <-- resetting error counter
    <[zenka.change_status]>->( $instance_id, qw| error | );

} else {
    <[base.logs]>->(
        0, "instance %d [%s] heartbeat response ( error ) [..retrying..]",
        $instance_id, $zenka_name
    );

    # setting shorter heartbeat timeout..,
    $instance->{'timer'}->{'heartbeat-timeout'}->cancel
        if defined $instance->{'timer'}->{'heartbeat-timeout'}
        and $instance->{'timer'}->{'heartbeat-timeout'}->is_active;
    $instance->{'timer'}->{'heartbeat-timeout'} = <[event.add_timer]>->(
        {   'after'   => $instance->{'heartbeat'}->{'retry_timeout'} // 2,
            'handler' => qw| v7-zenki.handler.heartbeat_response_timeout |,
            'data'    => $instance_id
        }
    );
}

