## [:< ##

# name   = system.watch.unless.get
# descr  = unless hook : the pending checks as a bucket
# args   = owner
# return = { entries => { <watch id> => gate } }

my %entries;
foreach my $w ( values <system.watch.entries>->%* ) {
    $entries{ $w->{'id'} } = $w->{'gate'} if defined $w->{'gate'};
}
return { 'entries' => \%entries };

