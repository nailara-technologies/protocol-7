# name  = X-11.handler.server_output
# descr = reads output from X-11 process

<v7-zenki.patterns.zenka_output> //= {};

my $event       = shift->w;
my $read_fh     = $event->fd;
my $server      = $event->data;
my $bin         = $server->{'bin'};
my $pid         = $server->{'pid'};
my $display_str = $server->{'display'}       // '';
my $whitelist   = $server->{'log_whitelist'} // [];
my $is_primary
    = (     $display_str ne ''
        and defined <X-11.primary_display>
        and $display_str eq <X-11.primary_display> );

## per-server state, keyed onto $event->data [ the SAME hashref for the     ##
## lifetime of this fd's watcher, registered once in finalize_server ] --   ##
## NOT the shared <X-11.output_buffer>\<X-11.first_error> globals this used ##
## before 2026-09-06 : those were fine when this handler only ever watched  ##
## one [ primary ] server, but with concurrent auxiliary xvfb displays now  ##
## actually reachable [ bugs 2 \ 3 fixed the same day ], a shared           ##
## buffer\error slot would interleave different servers' output and         ##
## misattribute error messages across displays .,                           ##
$server->{'output_buffer'} //= '';

my $read_bytes
    = <[base.s_read]>->( $read_fh, \$server->{'output_buffer'}, 4096 );

if ( $read_bytes < 1 ) {    ## [ assumed filehandle exception ] ##
    $event->cancel;
    close($read_fh);
    <[base.logs]>
        ->( '%s-server [ PID %d ] filehandle closed .,', $bin, $pid );
    kill( 9, $pid );        ## making sure it is gone ##

    ## a requested stop [ eg. xvfb-stop ] marks its own pid before      ##
    ## signalling it -- tell that apart from a genuine crash instead of ##
    ## always logging the more alarming "shut down unexpectedly" .,     ##
    if ( delete <X-11.intentional_stop>->{$pid} ) {
        <[base.logs]>->( 1, "%s-server stopped [ requested ]", $bin );
    } else {
        my $err_str
            = defined $server->{'first_error'}
            ? ': "' . $server->{'first_error'} . '"'
            : ' unexpectedly. [ unknown reason ]';
        <[base.logs]>->( 0, "%s-server shut down%s", $bin, $err_str );
    }

    ## "done." is a zenka-shutdown idiom elsewhere in this codebase [ see   ##
    ## X-11.connect_X11's base.exit(3,'done.',1) ] -- only log it when this ##
    ## call is actually about to exit; an auxiliary server going away is    ##
    ## not the zenka being done. [ this was unconditional before 2026-09-06 ##
    ## -- a leftover from before multi-server support, when this branch     ##
    ## always exited -- see 55787d320 ]                                     ##
    if ($is_primary) {
        <[base.log]>->( 1, "done." );
        exit(2);
    }
    return;    ## auxiliary server: do not terminate zenka ##
}

while ( $server->{'output_buffer'} =~ s|^([^\n]*)\n||s ) {
    my $output_line = $1;
    $server->{'first_error'} = $1
        if $output_line =~ m|\(EE\) +(.+)$|
        and not defined $server->{'first_error'};
    $output_line =~ s|\r||sg;

    ## known-benign chatter [ eg. Xvfb's xkbcomp keymap-conflict warnings, ##
    ## harmless per Xvfb's own "not fatal to the X server" wording ] drops ##
    ## to level 3 instead of the normal level 2 -- keeps a level-2         ##
    ## diagnostic session clean, showing only output that isn't already    ##
    ## known-safe .,                                                       ##
    my $log_level = 2;
    for my $pattern ( $whitelist->@* ) {
        if ( $output_line =~ m|$pattern|i ) {
            $log_level = 3;
            last;
        }
    }
    <[base.logs]>->( $log_level, "< %s > %s", $bin, $output_line );

    # LLL: terminate server here ?
}

