## [:< ##

# name  = httpsd.cmd.drain
# descr = stop accepting connections + wait for sessions to close
# note  = called via cube command during concurrent restart handover

<[base.logs]>->(
    'httpsd draining: stopping accept on port %d',
    <httpsd.port> // 443
);

## remove socket from event loop - stop accepting new connections
if ( exists <httpsd.listen_socket> and defined <httpsd.listen_socket> ) {
    <[event.del_io]>->(<httpsd.listen_socket>);
    <[base.log]>->( 2, 'httpsd: removed listen socket from event loop' );
}

## mark as draining [ prevents new session acceptance ]
<httpsd.draining> = TRUE;

## check remaining sessions
my $remaining = 0;
if ( exists <base.session.ids> ) {
    $remaining = scalar keys <base.session.ids>->%*;
}

<[base.logs]>->( 'httpsd draining: %d sessions remaining', $remaining );

if ( $remaining == 0 ) {
    ## no sessions - can terminate immediately
    <[base.log]>->('httpsd: no active sessions, initiating self-termination');
    <[httpsd.cmd.self_terminate]>;
} else {
    ## set up session check timer  when sessions reach zero, self-terminate
    <httpsd.drain_check_timer> = <[event.add_timer]>->(
        {   'after'    => 0.5,
            'interval' => 0.5,
            'handler'  => qw| httpsd.handler.drain_check |,
            'data'     => {}
        }
    );
}

return { 'mode' => qw| true |, 'data' => 'draining initiated' };

