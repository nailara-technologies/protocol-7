## [:< ##

# name  = sourcecode.console.update-signatures
# descr = regenerate source code signature sections

my $command_params = shift // '';

my $sign_verbosity = 2;    ## [ 0 | 1 | 2 ] ##

$sign_verbosity = 0
    if $command_params =~ s| *:sign-silent: *| |
    or exists $ENV{'SIGN_SILENT'}
    and <[base.cfg_bool]>->( $ENV{'SIGN_SILENT'} ) == TRUE;

## :stage: re-stages [ via git add ] exactly the files this run signs, and ##
## no others -- leaves other already-staged/unstaged batches untouched     ##
my $stage_files = $command_params =~ s| *:stage: *| |;

## :workers=N: overrides the parallel-worker count [ default : auto, based ##
## on cpu count, see below ]. :workers=1: forces the plain sequential path ##
my $workers_override;
$workers_override = $1
    if $command_params =~ s| *:workers=(\d+): *| |;
$command_params =~ s,^ *| *$,,;

my $signature_key_name = qw| proto-7.sourcecode |;

<[source.load_signature_key]>->($signature_key_name);

if (   not exists $keys{'C25519'}{$signature_key_name}
    or not exists $keys{'C25519'}{$signature_key_name}->{'private'}
    or not exists $keys{'C25519'}{$signature_key_name}->{'public'} ) {
    <[base.log]>->( 0, ".: source signature key :." );
    <[base.logs]>->( 0, ":  : %s", $signature_key_name );
    <[base.log]>->( 0, ":. not loaded, aborting .:" );
    <[base.exit]>->(qw| 0110 |);
}

my $source_version  = <protocol-7.src-ver>;
my $release_version = <protocol-7.rel-ver>;

my $paths     = <sourcecode.path>;    # <-- prepared in 'sourcecode.init_code'
my $work_tree = $paths->{'work_tree'};

my @source_paths;

if ( length $command_params ) {

    if ( not @source_paths
        = <[base.source.collect_file_list]>->($command_params) ) {
        <[base.logs]>->( 0, ": no files found for '%s'", $command_params );
        <[base.exit]>;
    } else {
        my $file_count = scalar @source_paths;
        <[base.logs]>->(
            ": %d file%s match%s '%s'",
            $file_count,
            <[base.cnt_s]>->($file_count),
            <[base.cnt_s]>->( $file_count, '', 'es' ),
            <[base.parser.ellipse_center]>->( $command_params, 19 )
        );
    }
} else {
    @source_paths = <[sourcecode.source_path_set_up]>;
}

if (   @source_paths == 0
    or @source_paths == 1 and not defined $source_paths[0] ) {
    <[base.log]>->(
        0, 'no matching source files, cannot update signatures..,'
    );
    <[base.exit]>->('0110');
}

<[base.log]>->( 1, '.:[ UPDATING SOURCE SIGNATURES ]:.' );

map {
    <[base.logs]>->( 0, 'file ./%s is not writable', $ARG )
        if not -w catfile( $work_tree, $ARG )
} @source_paths;

my $file_count = scalar @source_paths;
my @staged_paths;

## below this many files, forking workers just adds overhead for no real ##
## gain -- run the plain sequential path, unchanged behaviour            ##
my $parallel_sign_threshold   = 200;
my $parallel_sign_max_workers = 8;

my $workers = $workers_override;

if ( not defined $workers ) {
    $workers = 1;
    if ( $file_count >= $parallel_sign_threshold ) {
        my $cpu_count = 0;
        my $cpuinfo;
        if ( <[file.slurp]>->( '/proc/cpuinfo', \$cpuinfo ) ) {
            $cpu_count++ while $cpuinfo =~ m|^processor\s*:|mg;
        }
        $workers = $cpu_count > 1 ? $cpu_count : 1;
        $workers = $parallel_sign_max_workers
            if $workers > $parallel_sign_max_workers;
    }
}
$workers = 1           if $workers < 1;
$workers = $file_count if $workers > $file_count;

<[base.logs]>->( '* updating %s source file signatures..,', $file_count );

if ( $workers <= 1 ) {

    my $result_href = <[sourcecode.sign_file_list]>->(
        \@source_paths, $work_tree, $sign_verbosity
    );

    @staged_paths = $result_href->{'staged'}->@*;
    $file_count -= $result_href->{'written_count'};

} else {

    <[base.logs]>->( 2, ': signing with %d parallel workers..,', $workers );

    ## round-robin sharding : disjoint shards keep the existing per-file   ##
    ## TOCTOU guard [ in sourcecode.sign_file_list ] valid unchanged -- no ##
    ## file is ever touched by more than one worker                        ##
    my @shards   = map { [] } 1 .. $workers;
    my $shard_ix = 0;
    foreach my $path_rel (@source_paths) {
        push $shards[ $shard_ix % $workers ]->@*, $path_rel;
        $shard_ix++;
    }

    my $run_tag = sprintf( qw| %d-%d |, $PID, time() );
    my @worker_pid;
    my @worker_result_file;

    foreach my $w ( 0 .. $#shards ) {

        my $result_file
            = sprintf( qw| /tmp/p7-sourcecode-sign.%s.w%d.tmp |, $run_tag,
            $w );

        my $pid = <[base.fork]>;

        if ( not defined $pid ) {
            <[base.logs]>->( 0, ':E: fork failed for worker %d <{C1}>', $w );
            <[base.exit]>->(
                qw| 0110 |, 'aborting signature update, fork failed', 0
            );
        }

        if ( $pid == 0 ) {    ## child : sign this shard, report, exit ##

            my $result_href = <[sourcecode.sign_file_list]>->(
                $shards[$w], $work_tree, $sign_verbosity, $w
            );

            my @report_lines
                = map {"STAGED\t$ARG"} $result_href->{'staged'}->@*;
            push @report_lines,
                sprintf( "DONE\t%d\t%d",
                $result_href->{'true_count'},
                $result_href->{'written_count'} );

            <[file.put]>
                ->( $result_file, join( "\n", @report_lines ) . "\n" );

            <[base.exit]>->(
                0,
                sprintf(
                    'worker %d done, %d staged',
                    $w, scalar $result_href->{'staged'}->@*
                ),
                2
            );
        }

        ## parent : register with the emergency kill-list [ the existing ##
        ## base.sig_int / base.sig_term handlers already sweep this on a ##
        ## SIGINT/SIGTERM shutdown -- same interrupt-safety the original ##
        ## single-process loop had via event.once, no new plumbing ]     ##
        push( <system.kill_list>->@*, $pid );
        push @worker_pid,         $pid;
        push @worker_result_file, $result_file;
    }

    ## poll for completion : DONE sentinel in the result file means        ##
    ## success. a dead pid with no sentinel means the worker crashed --    ##
    ## never trust process-exit alone [ this zenka's own base.sig_chld     ##
    ## reaps children asynchronously via its own Event watcher, racing any ##
    ## waitpid we'd do here, so pid-liveness + result-file content is the  ##
    ## only race-free signal available to the parent ]                     ##
    my %pending = map { $ARG => 1 } 0 .. $#worker_pid;
    my %crashed;
    my @true_counts;
    my @written_counts;

    while ( keys %pending ) {
        foreach my $w ( <[base.sort]>->( keys %pending ) ) {

            my $report;
            <[file.slurp]>->( $worker_result_file[$w], \$report )
                if -f $worker_result_file[$w];

            if ( defined $report and $report =~ m|^DONE\t(\d+)\t(\d+)|m ) {
                $true_counts[$w]    = $1;
                $written_counts[$w] = $2;
                push @staged_paths, ( $report =~ m|^STAGED\t(.+)$|mg );
                delete $pending{$w};
            } elsif ( not kill( 0, $worker_pid[$w] ) ) {
                $crashed{$w} = TRUE;
                delete $pending{$w};
            }
        }

        if ( keys %pending ) {
            <[event.once]>;    ## keep SIGINT responsive [ safe : parent ##
            ## process, not a forked child ]         ##
            select( undef, undef, undef, 0.1 );
        }
    }

    ##  tidy the kill-list and result files now that every worker is gone ##
    my %spawned_pid = map { $ARG => TRUE } @worker_pid;
    <system.kill_list>->@*
        = grep { not $spawned_pid{$ARG} } <system.kill_list>->@*;
    unlink grep {-f} @worker_result_file;

    if (%crashed) {
        <[base.logs]>->(
            0,
            ':E: worker%s %s crashed mid-signing, '
                . 'aborting -- nothing staged',
            <[base.cnt_s]>->( scalar keys %crashed ),
            join( ', ', <[base.sort]>->( keys %crashed ) )
        );
        <[base.exit]>->(
            qw| 0110 |, 'aborting signature update due to worker crash', 0
        );
    }

    my $total_written = 0;
    $total_written += $ARG // 0 foreach @written_counts;
    $file_count    -= $total_written;
}

if ( $stage_files and @staged_paths ) {
    <[base.logs]>->(
        '* staging %d signed file%s..,',
        scalar @staged_paths,
        <[base.cnt_s]>->( scalar @staged_paths )
    );
    system( qw| git |, '-C', $work_tree, qw| add -- |, @staged_paths );
    <[base.logs]>->( 0, ':E: git add failed [ exit %d ]', $CHILD_ERROR >> 8 )
        if $CHILD_ERROR;
}

## clear eventual numbers on console ##
printf( "%s\r", ' ' x 18 ) if <system.zenka.verbosity.console> == 1;

<[base.log]>->( 1, ': : success =)' ) if $file_count == 0;
