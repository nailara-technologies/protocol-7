## [:< ##

# name  = sourcecode.console.update-signatures
# descr = regenerate source code signature sections

my $command_params = shift // '';

## silent by default : the per-iteration octal header lines only with  ##
## :verbose: \ SIGN_VERBOSE. :sign-silent: \ SIGN_SILENT stay accepted ##
## [ the former opt-out, now the default -- callers still pass it ]    ##
my $sign_verbosity = 0;    ## [ 0 | 1 | 2 ] ##

$command_params =~ s| *:sign-silent: *| |;

$sign_verbosity = 2
    if $command_params =~ s| *:verbose: *| |
    or exists $ENV{'SIGN_VERBOSE'}
    and <[base.cfg_bool]>->( $ENV{'SIGN_VERBOSE'} ) == TRUE;

## :stage: re-stages [ via git add ] exactly the files this run signs, and ##
## no others -- leaves other already-staged/unstaged batches untouched     ##
my $stage_files = $command_params =~ s| *:stage: *| |;

## :strip: removes a signature FRAGMENT left directly above a file's real
## footer [ a lone separator, an agent's PLACEHOLDER line or block,
## '</content>' -- AMOS7::Protocol::P7Syntax p7_syntax__sig_fragment_rx ].
## without it such a fragment is only REPORTED : the narrow rule never
## guesses, but removing is still the user's explicit choice
my $strip_fragments = $command_params =~ s| *:strip: *| |;

## :workers=N: overrides the parallel-worker count                       ##
## [ default : auto, based on cpu count, see below ]. :workers=1: forces ##
## the plain sequential path                                             ##
my $workers_override;
$workers_override = $1
    if $command_params =~ s| *:workers=(\d+): *| |;

## :agent: signs through p7-sign-agent                                     ##
## [ todo HX4,  data/md/design/VAULT-AGENT-SIGNING.md ] instead of loading ##
## the key into this process -- the agent holds the unlocked key and signs ##
## over a local socket after ONE approval per run. :agent=<socket path>:   ##
## overrides the socket location. WITHOUT ':agent:' nothing changes : the  ##
## key loads, the passphrase prompt happens, the agent is never contacted  ##
my $agent_socket_opt;
$agent_socket_opt = $1 if $command_params =~ s| *:agent=(\S+?):?| |;
my $agent_mode = $command_params =~ s| *:agent: *| |;

## :inlist: treats the remaining params as candidates to intersect against ##
## the authoritative signed corpus [ sourcecode.source_path_set_up ],      ##
## rather than as a stand-alone file set -- exclusion patterns and corpus  ##
## membership are honoured, so e.g. a staged file under an excluded path   ##
## [ test-fixtures, cfg/backup, ... ] is silently skipped instead of       ##
## getting a signature footer appended for nothing. see                    ##
## sourcecode.console.verify-p7-signatures for the matching flag           ##
my $restrict_to_corpus = $command_params =~ s| *:inlist: *| |;
$command_params =~ s,^ *| *$,,;

## :inlist: with nothing left to intersect against means "nothing was      ##
## given" -- falling through to the no-params branch below would sign the  ##
## entire corpus instead, the opposite of what a caller asking for scoping ##
## wants                                                                   ##
if ( $restrict_to_corpus and not length $command_params ) {
    <[base.log]>->( 1, ': :inlist: empty file list, nothing to sign' );
    <[base.exit]>->(0);
}

my $signature_key_name = qw| proto-7.sourcecode |;

my $agent_socket;

if ($agent_mode) {

    ## agent mode : the key is DELIBERATELY not loaded here -- identity is ##
    ## proven by comparing the agent's public half with the on-disk        ##
    ## '.public' file [ public material only, design note ]                ##
    $agent_socket
        = length $agent_socket_opt
        ? $agent_socket_opt
        : <[sourcecode.agent.sign]>->( { 'op' => qw| socket-path | } );

    <sourcecode.cfg.sign_agent_socket> = $agent_socket;

    my $agent_pub = <[sourcecode.agent.sign]>
        ->( { 'op' => qw| hello |, 'socket' => $agent_socket } );

    my $disk_pub;
    my $agent_key_vars = <[crypt.C25519.key_vars]>->($signature_key_name);
    if ( ref $agent_key_vars eq qw| HASH |
        and defined $agent_key_vars->{'key_filename'}{'public'} ) {
        $disk_pub
            = <[file.slurp]>
            ->( $agent_key_vars->{'key_filename'}{'public'} )->$*;
        chomp $disk_pub;
    }

    if (   not defined $agent_pub
        or not defined $disk_pub
        or $agent_pub ne $disk_pub ) {
        <[base.log]>->( 0, '.: agent identity check FAILED :.' );
        <[base.logs]>->(
            0,
            ':  : %s',
            not defined $agent_pub
            ? 'agent unreachable'
            : 'agent key does not match the on-disk public key'
        );
        <[base.log]>->( 0, ':. not signing through a stranger .:' );
        <[base.exit]>->(qw| 0110 |);
    }

    ## the PUBLIC half only [ just proven equal to the agent's ] :         ##
    ## verifying existing footers needs it, and the identity switch        ##
    ## source.load_ signature_key makes -- without both, verification fell ##
    ## back to the '<user>.base' identity                                  ##
    ## [ 'found no public key named taeki.base' ]                          ##
    $keys{'C25519'}{$signature_key_name}{'public'} = decode_b32r($disk_pub);
    <crypt.C25519.base_key_name> = $signature_key_name;
    delete <crypt.C25519.key_vars>;    ## the cache, as load_signature_key ##

    <[base.logs]>->(
        1,             ': signing through agent %s [ key %s ]',
        $agent_socket, $signature_key_name
    );

} else {

    <[source.load_signature_key]>->($signature_key_name);

    if (   not exists $keys{'C25519'}{$signature_key_name}
        or not exists $keys{'C25519'}{$signature_key_name}->{'private'}
        or not exists $keys{'C25519'}{$signature_key_name}->{'public'} ) {
        <[base.log]>->( 0, ".: source signature key :." );
        <[base.logs]>->( 0, ":  : %s", $signature_key_name );
        <[base.log]>->( 0, ":. not loaded, aborting .:" );
        <[base.exit]>->(qw| 0110 |);
    }
}

my $source_version  = <protocol-7.src-ver>;
my $release_version = <protocol-7.rel-ver>;

my $paths     = <sourcecode.path>;    # <-- prepared in 'sourcecode.init_code'
my $work_tree = $paths->{'work_tree'};

my @source_paths;

if ( length $command_params ) {

    my @candidates = <[base.source.collect_file_list]>->($command_params);
    my $candidate_count = scalar @candidates;

    if ( $restrict_to_corpus and @candidates ) {
        my %corpus_ok
            = map { $ARG => TRUE } <[sourcecode.source_path_set_up]>;
        @candidates = grep { $corpus_ok{$ARG} } @candidates;
        <[base.logs]>->(
            2,
            ': :inlist: %d of %d given file%s are part of the signed corpus',
            scalar @candidates,
            $candidate_count,
            <[base.cnt_s]>->($candidate_count)
        ) if scalar @candidates != $candidate_count;
    }

    if ( not @candidates ) {
        if ( $restrict_to_corpus and $candidate_count ) {
            <[base.logs]>->(
                1,
                ': :inlist: none of %d given file%s are '
                    . 'part of the signed corpus, nothing to sign',
                $candidate_count,
                <[base.cnt_s]>->($candidate_count)
            );
            <[base.exit]>->(0);
        }
        <[base.logs]>->( 0, ": no files found for '%s'", $command_params );
        <[base.exit]>;
    } else {
        @source_paths = @candidates;
        my $file_count = scalar @source_paths;
        <[base.logs]>->(
            ": %d file%s match%s '%s'",
            $file_count,
            <[base.cnt_s]>->($file_count),
            <[base.cnt_s]>->( $file_count, '', 'es' ),
            <[base.parser.ellipse_center]>->( $command_params, 19 )
        );
    }
} else {
    @source_paths = <[sourcecode.source_path_set_up]>;
}

if (   @source_paths == 0
    or @source_paths == 1 and not defined $source_paths[0] ) {
    <[base.log]>->(
        0, 'no matching source files, cannot update signatures..,'
    );
    <[base.exit]>->('0110');
}

<[base.log]>->( 1, '.:[ UPDATING SOURCE SIGNATURES ]:.' );

map {
    <[base.logs]>->( 0, 'file ./%s is not writable', $ARG )
        if not -w catfile( $work_tree, $ARG )
} @source_paths;

## signature fragments above the footer : reported, or stripped [ :strip: ]
## BEFORE signing, so the new signature covers the cleaned file
<[base.perlmod.load]>->(qw| AMOS7::Protocol::P7Syntax |)
    if not <[base.perlmod.loaded]>->(qw| AMOS7::Protocol::P7Syntax |);
my $fragment_rx = AMOS7::Protocol::P7Syntax::p7_syntax__sig_fragment_rx();
my $fragments   = 0;
foreach my $path_rel (@source_paths) {
    my $path_abs = catfile( $work_tree, $path_rel );
    my $text;
    next if not <[file.slurp]>->( $path_abs, \$text, qw| :raw | );
    next if $text !~ $fragment_rx;
    my $line = 1 + ( substr( $text, 0, $LAST_MATCH_START[0] ) =~ tr|\n|| );
    $fragments++;
    if ( not $strip_fragments ) {
        <[base.logs]>->(
            0, 'signature fragment above the footer : ./%s:%d [ :strip: ]',
            $path_rel, $line
        );
        next;
    }
    $text =~ s|$fragment_rx||;
    my $mode = ( stat $path_abs )->mode & 07777;
    if ( open( my $fh, qw| > |, $path_abs ) ) {
        binmode $fh;
        print {$fh} $text;
        close $fh;
        chmod $mode, $path_abs;
        <[base.logs]>->(
            1,         'stripped a signature fragment : ./%s:%d',
            $path_rel, $line
        );
    } else {
        <[base.logs]>->(
            0,         'cannot strip ' . './%s [ %s ]',
            $path_rel, $OS_ERROR
        );
    }
}
<[base.logs]>->(
    1,
    '%d file%s with a signature fragment%s',
    $fragments,
    <[base.cnt_s]>->($fragments),
    $strip_fragments ? ' [ stripped ]' : ' -- sign with :strip: to remove'
) if $fragments;

if ($agent_mode) {

    ## content binding for the approval : per-path BMW-512 + length over   ##
    ## the strict-stripped body, computed with the same pipeline the sign  ##
    ## path uses [ extract_sig_body strip mode + chk-sum.bmw.strsum ]. the ##
    ## agent re-reads each file itself at RUN and at SIGN and refuses on   ##
    ## any mismatch. this runs AFTER the fragment pass above so :strip:    ##
    ## rewrites are inside the approved content -- hence the run begins    ##
    ## here and not earlier                                                ##
    my @agent_paths;
    foreach my $path_rel (@source_paths) {
        my $path_abs = catfile( $work_tree, $path_rel );
        my $text;
        if ( not <[file.slurp]>->( $path_abs, \$text, qw| :raw | ) ) {
            <[base.logs]>->( 0, ': cannot read ./%s, aborting', $path_rel );
            <[base.exit]>->(qw| 0110 |);
        }
        <[source.extract_sig_body]>->( \$text, qw| strip | );
        push @agent_paths,
            {
            qw| path |        => $path_rel,
            qw| body-chksum | => <[chk-sum.bmw.strsum]>->( \$text ),
            qw| body-length | => length $text
            };
    }

    ## one run id for the whole signing run -- it carries a checksum of the ##
    ## sorted path list, so a changed file set IS a different run and       ##
    ## prompts anew [ design note ]. The workers inherit both knobs through ##
    ## the fork, and the agent serializes approval ONCE per run             ##
    <sourcecode.cfg.sign_agent_tree> = $work_tree;
    <sourcecode.cfg.sign_agent_run>  = sprintf qw| %d-%d-%s |, $PID, time(),
        substr(
        <[chk-sum.bmw.strsum]>->(
            join( "\n", <[base.sort]>->(@source_paths) )
        ) // '0',
        0, 13
        );

    my $begin_ok = <[sourcecode.agent.sign]>->(
        {   'op'        => qw| begin |,
            'socket'    => $agent_socket,
            'run'       => <sourcecode.cfg.sign_agent_run>,
            'work-tree' => $work_tree,
            'paths'     => \@agent_paths
        }
    );

    if ( not $begin_ok ) {
        <[base.log]>->( 0, ':. agent run denied, aborting .:' );
        <[base.exit]>->(qw| 0110 |);
    }
}

my $file_count = scalar @source_paths;
my @staged_paths;

## below this many files, forking workers just adds overhead for no real ##
## gain -- run the plain sequential path, unchanged behaviour            ##
my $parallel_sign_threshold = 200;

## workers per cpu [ default 2 : signing waits on i\o too, one worker per ##
## cpu left half of the machine idle ] -- lower it to reduce the load     ##
<sourcecode.cfg.sign_workers_per_cpu> //= 2;

my $workers = $workers_override;

if ( not defined $workers ) {
    $workers = 1;
    if ( $file_count >= $parallel_sign_threshold ) {
        my $cpu_count = 0;
        my $cpuinfo;
        if ( <[file.slurp]>->( '/proc/cpuinfo', \$cpuinfo ) ) {
            $cpu_count++ while $cpuinfo =~ m|^processor\s*:|mg;
        }
        my $per_cpu = <sourcecode.cfg.sign_workers_per_cpu>;
        $per_cpu = 1 if $per_cpu !~ m|^\d+(\.\d+)?$| or $per_cpu <= 0;
        $workers = int( ( $cpu_count || 1 ) * $per_cpu + 0.5 );
    }
}
$workers = 1           if $workers < 1;
$workers = $file_count if $workers > $file_count;

<[base.logs]>->( '* updating %s source file signatures..,', $file_count );

if ( $workers <= 1 ) {

    my $result_href = <[sourcecode.sign_file_list]>->(
        \@source_paths, $work_tree, $sign_verbosity
    );

    @staged_paths = $result_href->{'staged'}->@*;
    $file_count -= $result_href->{'written_count'};

} else {

    <[base.logs]>->( 2, ': signing with %d parallel workers..,', $workers );

    ## round-robin sharding : disjoint shards keep the existing per-file    ##
    ## TOCTOU guard [ in sourcecode.sign_file_list ] valid unchanged -- no  ##
    ## file is ever touched by more than one worker  chunks, not one share  ##
    ## per worker : ~4 chunks per worker, balanced by size, largest first.  ##
    ## a pool keeps $workers running and starts the next chunk whenever one ##
    ## ends -- fixed shares left a long tail                                ##
    ## [ size is a weak cost estimate ], small chunks shorten it to one     ##
    my $chunk_count = $workers * 4;
    $chunk_count = $file_count if $chunk_count > $file_count;
    my @shards = map { [] } 1 .. $chunk_count;

    my %file_size = map {
        $ARG => -s ( m|^/| ? $ARG : catfile( $work_tree, $ARG ) ) // 0
    } @source_paths;
    my @shard_bytes = (0) x $chunk_count;
    foreach
        my $path_rel ( sort { $file_size{$b} <=> $file_size{$a} or $a cmp $b }
        @source_paths ) {
        my $lightest = 0;
        foreach my $c ( 1 .. $chunk_count - 1 ) {
            $lightest = $c if $shard_bytes[$c] < $shard_bytes[$lightest];
        }
        push $shards[$lightest]->@*, $path_rel;
        $shard_bytes[$lightest] += $file_size{$path_rel};
    }
    my @chunk_order = sort { $shard_bytes[$b] <=> $shard_bytes[$a] }
        grep { scalar $shards[$ARG]->@* } 0 .. $#shards;

    my $run_tag = sprintf( qw| %d-%d |, $PID, time() );
    my @worker_pid;
    my @worker_result_file;

    my $launch = sub {
        my $w = shift;

        my $result_file
            = sprintf( qw| /tmp/p7-sourcecode-sign.%s.w%d.tmp |, $run_tag,
            $w );

        my $pid = <[base.fork]>;

        if ( not defined $pid ) {
            <[base.logs]>->( 0, ':E: fork failed for worker %d <{C1}>', $w );
            <[base.exit]>->(
                qw| 0110 |, 'aborting signature update, fork failed', 0
            );
        }

        if ( $pid == 0 ) {    ## child : sign this chunk, report, exit ##

            my $result_href = <[sourcecode.sign_file_list]>->(
                $shards[$w], $work_tree, $sign_verbosity, $w
            );

            my @report_lines
                = map {"STAGED\t$ARG"} $result_href->{'staged'}->@*;
            push @report_lines,
                sprintf( "DONE\t%d\t%d",
                $result_href->{'true_count'},
                $result_href->{'written_count'} );

            <[file.put]>
                ->( $result_file, join( "\n", @report_lines ) . "\n" );

            <[base.exit]>->(
                0,
                sprintf(
                    'worker %d done, %d staged',
                    $w, scalar $result_href->{'staged'}->@*
                ),
                2
            );
        }

        ## parent : register with the emergency kill-list [ the existing ##
        ## base.sig_int / base.sig_term handlers already sweep this on a ##
        ## SIGINT/SIGTERM shutdown -- same interrupt-safety the original ##
        ## single-process loop had via event.once, no new plumbing ]     ##
        push( <system.kill_list>->@*, $pid );
        $worker_pid[$w]         = $pid;
        $worker_result_file[$w] = $result_file;
    };

    ## poll for completion : DONE sentinel in the result file means        ##
    ## success. a dead pid with no sentinel means the worker crashed --    ##
    ## never trust process-exit alone [ this zenka's own base.sig_chld     ##
    ## reaps children asynchronously via its own Event watcher, racing any ##
    ## waitpid we'd do here, so pid-liveness + result-file content is the  ##
    ## only race-free signal available to the parent ]                     ##
    my %pending;
    my %crashed;
    my @true_counts;
    my @written_counts;

    while ( @chunk_order or keys %pending ) {

        ##  top up the pool [ no new chunk once a worker crashed ]  ##
        while ( @chunk_order and keys(%pending) < $workers and not %crashed )
        {
            my $w = shift @chunk_order;
            $launch->($w);
            $pending{$w} = 1;
        }
        @chunk_order = () if %crashed;

        foreach my $w ( <[base.sort]>->( keys %pending ) ) {

            my $report;
            <[file.slurp]>->( $worker_result_file[$w], \$report )
                if -f $worker_result_file[$w];

            if ( defined $report and $report =~ m|^DONE\t(\d+)\t(\d+)|m ) {
                $true_counts[$w]    = $1;
                $written_counts[$w] = $2;
                push @staged_paths, ( $report =~ m|^STAGED\t(.+)$|mg );
                delete $pending{$w};
            } elsif ( not kill( 0, $worker_pid[$w] ) ) {
                $crashed{$w} = TRUE;
                delete $pending{$w};
            }
        }

        if ( keys %pending ) {
            <[event.once]>;    ## keep SIGINT responsive [ safe : parent ##
            ## process, not a forked child ]         ##
            select( undef, undef, undef, 0.1 );
        }
    }

    ##  tidy the kill-list and result files now that every worker is gone ##
    my %spawned_pid = map { $ARG => TRUE } grep {defined} @worker_pid;
    <system.kill_list>->@*
        = grep { not $spawned_pid{$ARG} } <system.kill_list>->@*;
    unlink grep { defined and -f } @worker_result_file;

    if (%crashed) {
        <[base.logs]>->(
            0,
            ':E: worker%s %s crashed mid-signing, aborting -- nothing staged',
            <[base.cnt_s]>->( scalar keys %crashed ),
            join( ', ', <[base.sort]>->( keys %crashed ) )
        );
        <[base.exit]>->(
            qw| 0110 |, 'aborting signature update due to worker crash', 0
        );
    }

    my $total_written = 0;
    $total_written += $ARG // 0 foreach @written_counts;
    $file_count    -= $total_written;
}

if ($agent_mode) {

    ## the signed end timestamp : the agent's capability-reduction record ##
    my ( $end_ntime, $end_sig ) = <[sourcecode.agent.sign]>->(
        {   'op'     => qw| end |,
            'socket' => $agent_socket,
            'run'    => <sourcecode.cfg.sign_agent_run>
        }
    );
    <[base.logs]>->(
        2,
        ': agent run %s closed [ end %s ]',
        <sourcecode.cfg.sign_agent_run>,
        $end_ntime // 'no end record'
    );
}

if ( $stage_files and @staged_paths ) {
    <[base.logs]>->(
        '* staging %d signed file%s..,',
        scalar @staged_paths,
        <[base.cnt_s]>->( scalar @staged_paths )
    );
    system( qw| git |, '-C', $work_tree, qw| add -- |, @staged_paths );
    <[base.logs]>->( 0, ':E: git add failed [ exit %d ]', $CHILD_ERROR >> 8 )
        if $CHILD_ERROR;
}

## clear eventual numbers on console ##
printf( "%s\r", ' ' x 18 ) if <system.zenka.verbosity.console> == 1;

<[base.log]>->( 1, ': : success =)' ) if $file_count == 0;
