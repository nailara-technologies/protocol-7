## [:< ##

# name   = session_move.lease.describe
# descr  = one readable line for a lease
# args   = session dir
# return = text

my $base  = shift;
my $lease = <[session_move.lease.read]>->($base);
return "$base : free"                  if not defined $lease;
return "$base : unreadable lease file" if $lease->{'broken'};
return sprintf '%s : host %s pid %s since %s until %s [ %s ]',
    $base, $lease->{'host'}, $lease->{'pid'}, $lease->{'since'},
    $lease->{'until'},
    $lease->{'until'} > CORE::time() ? qw| held | : qw| expired |;

