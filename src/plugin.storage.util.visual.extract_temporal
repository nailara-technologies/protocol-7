# name  = plugin.storage.util.visual.extract_temporal
# descr = Extract temporal properties from P7REF data for visual positioning

my ($data) = @ARG;
my $path = $data->{path} // '';
my %metrics;

if ( -f $path ) {
    my $st = File::stat::stat($path);
    my ( $atime, $mtime, $ctime ) = ( $st->atime, $st->mtime, $st->ctime );
    my $now = time();

    # Age in days (normalized)
    $metrics{age} = ( $now - $ctime ) / 86400.0 / 365.0;    # Years
    $metrics{age} = 1.0 if $metrics{age} > 1.0;

    # Access decay (exponential)
    my $days_since_access = ( $now - $atime ) / 86400.0;
    $metrics{decay} = exp( -$days_since_access / 30.0 );    # 30-day half-life

    # Time of day preference (0-24 normalized)
    my ($hour) = ( CORE::localtime($atime) )[2];
    $metrics{time_pref} = $hour / 24.0;
}

return \%metrics;

