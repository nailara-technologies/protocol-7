## [:< ##

# name  = nameserv.sync.client.timeout
# descr = finish a sync pull that ran too long

my $id = shift->w->data;

my $pending = <nameserv.sync.client.pending> // return;
my $state   = $pending->{$id}                // return;

<[nameserv.sync.client.finish]>->(
    $state, { mode => qw| false |, data => 'sync pull timeout' }
);

return;

