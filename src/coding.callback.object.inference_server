# name = coding.callback.object.inference_server
# descr = dependency callback to check if inference server is HTTP ready

my $object_id = shift;
return undef if not exists <dependency.object>->{$object_id};

my $object = <dependency.object>->{$object_id};

## check if permanently failed [ flagged by monitor_inference_startup ] ##
if ( $object->{'failed'} ) {
    <[base.logs]>->(
        1,
        "[dep_check] backend=%s dependency marked as failed: %s",
        $object->{'backend'} // 'unknown',
        $object->{'error'}   // 'unknown error'
    );
    return FALSE;
}

my $backend = $object->{'backend'} // 'gpu';

## read server status set by monitor_inference_startup [ non-blocking ] ##
my $server = ( <coding.inference_servers> // {} )->{$backend};

return undef unless defined $server;    ## not spawned yet ##

my $status = $server->{'status'} // 'starting';

## 'crashed' is NOT terminal -- it's the same in-progress state as          ##
## 'starting', bridged by real backoff/retry infra [ up to 5 attempts, see  ##
## inference_server_sigchld / verify_inference_startup ]. hard-failing      ##
## dependents here meant ANY dependency check landing during the brief      ##
## window between crash-detection and restart-completion wrongly failed the ##
## waiting job outright, even on a clean single crash+restart cycle with no ##
## race involved -- confirmed live : a task survived its own                ##
## crash+restart+retry and got a real response, yet coding.status still     ##
## showed it as failed because SOMETHING checked this dependency while      ##
## status was still 'crashed'. 'failed' is the only genuinely terminal      ##
## state [ set once restart_count is exhausted ] -- only that should        ##
## hard-fail a waiting job; 'crashed' waits through recovery like           ##
## 'starting' does                                                          ##
return FALSE if $status eq qw| failed |;
return TRUE  if $status eq qw| ready |;
return undef;    ## still starting / crashed / restarting ##

