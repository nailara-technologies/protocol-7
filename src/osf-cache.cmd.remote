## [:< ##

# name  = osf-cache.cmd.remote
# descr = send one command over an encrypted remote link
# param = <host[:port]> <command> [ args ]
#
# diagnostic + transport test for the cross-host layer : opens or
# reuses the encrypted client session to the host's cube
# [ osf-cache.remote.open ] and sends '<session id>.<command> [ args ]'
# over it, the reply relayed as it arrives [ deferred,
# osf-cache.handler.remote_reply ]. the setup runs from a same-tick
# timer [ users.cmd.remote-fetch shape ] so this command's own dispatch
# never waits on the connect. port //= <protocol-7.remote.default-port>
# // 42.

my $args     = $call->{'args'}     // '';
my $reply_id = $call->{'reply_id'} // '';

my ( $host_port, $command ) = split m{\s+}, $args =~ s{^\s+}{}r, 2;

return {
    'mode' => qw| false |,
    'data' => 'usage : remote <host[:port]> <command> [ args ]'
    }
    if not length( $host_port // '' )
    or not length( $command   // '' );

return { 'mode' => qw| false |, 'data' => 'remote needs a reply route' }
    if not length $reply_id;

my ( $host, $port ) = split m{:}, $host_port, 2;
$port //= <protocol-7.remote.default-port> // 42;

<[event.add_timer]>->(
    {   'after' => 0,
        'cb'    => sub {
            my $link = <[osf-cache.remote.open]>
                ->( { 'host' => $host, 'port' => $port } );
            if ( $link->{'mode'} ne qw| true | ) {
                <[base.callback.cmd_reply]>->( $reply_id, $link );
                return;
            }
            <[protocol-7.command.send.local]>->(
                {   'command' =>
                        sprintf( '%d.%s', $link->{'data'}, $command ),
                    'reply' => {
                        'handler' => qw| osf-cache.handler.remote_reply |,
                        'params'  => { 'reply_id' => $reply_id }
                    }
                }
            );
        }
    }
);

return { 'mode' => qw| deferred | };

