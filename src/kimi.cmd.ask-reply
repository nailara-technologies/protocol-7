## [:< ##

# name  = kimi.cmd.ask-reply
# descr = send prompt to kimi-web and return response
# param = <prompt>

## extract prompt from call args [ supports base32r-encoded multiline prompts
## ]
my $prompt;

if ( defined $call->{'param'} and ref $call->{'param'} eq qw| HASH | ) {
    $prompt = $call->{'param'}->{'prompt'} // $call->{'param'}->{'request'}
        // $call->{'param'}->{'question'} // '';
} else {
    $prompt = $call->{'args'} // '';
}

unless ( length $prompt ) {
    return { 'mode' => qw| false |, 'data' => 'prompt required' };
}

## check for :next: prefix : fresh session before dispatch
my $wants_next = $prompt =~ s{^:next:\s*}{};

## decode base32r if the string looks encoded
if ( $prompt =~ m{^[2-9A-Z]+$} ) {
    my $decoded = eval { Crypt::Misc::decode_b32r($prompt) };
    $prompt = $decoded if defined $decoded and length $decoded;
}

if ($wants_next) {
    ## store deferred FIRST : before any calls that might trigger event loop
    ## reset_and_reconnect processes WebSocket frames synchronously so the
    ## watcher can fire before we return : deferred must already be present
    <kimi.next.deferred> = {
        'prompt'   => $prompt,
        'reply_id' => $call->{'reply_id'},
        'task_id'  => undef,    ## task_id filled in below after intake
    };
    <[base.logs]>->(
        1, '[ask-reply] deferred pre-stored, prompt len=%d',
        length($prompt)
    );

    ## mark not-ready before reset : cancels any in-flight reconnect timer
    <kimi.ws.status> = qw| connecting |;

    ## trigger session reset + reconnect : stamps for_session_id on deferred
    <[kimi.session.reset_and_reconnect]>;

    <[base.logs]>->(
        1,
        '[ask-reply] after reset, deferred=%s status=%s',
        defined <kimi.next.deferred> ? 'present' : 'GONE',
        <kimi.ws.status> // 'undef'
    );

    ## create task entry after reset (won't trigger event loop)
    my $def_intake = <[kimi.intake.process]>->( { 'prompt' => $prompt } );
    if ( $def_intake->{'success'} and defined <kimi.next.deferred> ) {
        <kimi.next.deferred>->{'task_id'} = $def_intake->{'task_id'};
    }

    return { 'mode' => qw| deferred | };
}

my $reply_id = $call->{'reply_id'};

## move current result to previous : new prompt displaces it ##
<kimi.result.previous> = delete <kimi.last.result>
    if defined <kimi.last.result>;

## create task entry for queue tracking ##
my $intake_result = <[kimi.intake.process]>
    ->( { 'prompt' => $prompt, 'reply_id' => $reply_id } );
my $task_id;
if ( $intake_result->{'success'} ) {
    $task_id = $intake_result->{'task_id'};
}

## reconnect on demand if disconnected [ idle disconnect or first use ]
if ( not <kimi.ws.connected> or <kimi.ws.status> eq qw| disconnected | ) {
    <kimi.next.deferred> = {
        'prompt'   => $prompt,
        'reply_id' => $reply_id,
        'task_id'  => $task_id
    };
    <[kimi.connect]>;
    return { 'mode' => qw| deferred | };
}

## if busy, defer : task is already in pending queue  dispatch_next_task will
## start it when current work completes
if ( <kimi.ws.status> ne qw| ready | ) {
    if ( defined $task_id ) {
        <[base.logs]>->(
            2,        '[ask-reply] task %s deferred [ status=%s ]',
            $task_id, <kimi.ws.status>
        );
    }
    return { 'mode' => qw| deferred | };
}

## ready : submit directly ##
if ( defined $task_id ) {
    <kimi.task.active_id> = $task_id;

    ## mark as in_progress ##
    my $task = <kimi.task.queue>->{$task_id};
    if ( defined $task ) {
        $task->{'execution'}->{'status'}  = qw| in_progress |;
        $task->{'execution'}->{'started'} = <[base.ntime]>;
    }

    ## move from pending to active ##
    my $aref_pending = <kimi.task.pending> //= [];
    my $aref_active  = <kimi.task.active>  //= [];
    $aref_pending->@* = grep { $ARG ne $task_id } $aref_pending->@*;
    push $aref_active->@*, $task_id;
}

my $msg_id = <[kimi.wire.prompt]>->( $prompt, $reply_id );

unless ( defined $msg_id ) {
    ## roll back task state on prompt failure ##
    <[base.logs]>->(
        0,
        '[ask-reply] wire.prompt failed [ reply_id=%s task=%s status=%s ]',
        $reply_id // 'none',
        $task_id  // 'none',
        <kimi.ws.status>
    );
    if ( defined $task_id ) {
        <kimi.task.active_id> = undef;
        <[kimi.task.queue_fail]>->( $task_id, 'wire.prompt failed' );
    }
    return { 'mode' => qw| false |, 'data' => 'kimi.wire.prompt failed' };
}

## inject task_id into pending entry for TurnEnd completion detection ##
if ( defined $task_id ) {
    <kimi.wire.pending>->{$msg_id}->{'task_id'} = $task_id;
}

<[base.logs]>->(
    2, '[ask-reply] submitted [ msg_id=%s reply_id=%s task=%s ]',
    $msg_id, $reply_id, $task_id // 'none'
);

return { 'mode' => qw| deferred | };

