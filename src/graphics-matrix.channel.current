## [:< ##

# name  = graphics-matrix.channel.current
# descr = return currently selected channel definition

my $channel_data = <graphics-matrix.channel>;
my $active       = $channel_data->{'active'};
my $channels     = $channel_data->{'channels'};

return {
    qw| index | => $active,
    %{ $channels->{$active} },
};

