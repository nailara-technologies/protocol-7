## [:< ##

# name  = osf-cache.handler.peers_list
# descr = parse one peer listing into the collect \ the callback
#
# reply handler for the peer queries osf-cache.peers.list sends [
# the local cube listing and, per configured remote link,
# 'external.<link>.list sessions osf-cache' ]. the table parsing
# itself lives in osf-cache.peers.parse [ one parser, every
# listing ] : rows whose uname is osf-cache [ with or without a
# [subname] ] become holders - '<usid>' local, 'external.<link>.
# <usid>' remote - and the own-sid filter applies to the LOCAL
# listing only. a failed query [ cmd not SIZE or TRUE ] logs [
# with the listing name ] - a failed remote link is also recorded
# in the collect's failed list [ reported like a failed peer ].
# single-listing discovery [ no links configured ] : the sorted
# holders go straight to the callback [ the stage 2c behavior,
# kept ]. multi-listing : the holders join the collect state and
# osf-cache.peers.deliver fires the callback once the LAST listing
# answered - or the collect timeout did.

my $reply    = shift                 // {};
my $params   = $reply->{'params'}    // {};
my $callback = $params->{'callback'} // '';

return unless length $callback;

my $collect_id = $params->{'collect_id'} // '';
my $link       = $params->{'link'}       // '';

## this instance's own cube session id [ stored by base.get_session_id ] ##
my $cube_sessions = <user.cube.session> // {};
my ($local_sid) = keys %$cube_sessions;
my $own_sid
    = defined $local_sid
    ? ( $data{'session'}{$local_sid}{'cube_sid'} // '' )
    : '';

my ( @holders, $failed );
my $cmd = $reply->{'cmd'} // '';
if ( $cmd eq qw| SIZE | or $cmd eq qw| TRUE | ) {
    my $table  = $reply->{'data'} // $reply->{'call_args'}{'args'} // '';
    my $parsed = <[osf-cache.peers.parse]>->(
        {   'table'   => $table,
            'link'    => $link,
            'own_sid' => $own_sid,
        }
    );
    @holders = @{ $parsed->{'data'} // [] };
} else {
    $failed = 1;
    <[base.logs]>->(
        0,
        ': osf-cache : peer query failed [ %s ] [ %s ]',
        length $cmd  ? $cmd         : 'no reply',
        length $link ? "link $link" : qw| local |
    );
}

if ( length $collect_id ) {
    my $collect = <osf-cache.peers.collecting>->{$collect_id};
    return unless ref $collect eq qw| HASH |;    ## the timeout won ##

    push @{ $collect->{'holders'} }, @holders;
    push @{ $collect->{'failed'} }, "external.$link"
        if $failed and length $link;

    delete $collect->{'remaining'}{ length $link ? $link : qw| local | };

    <[osf-cache.peers.deliver]>->( { 'collect_id' => $collect_id } )
        unless scalar keys %{ $collect->{'remaining'} // {} };
} else {
    ## single listing [ no links configured ] : the stage 2c path ##
    @holders = sort { <[osf-cache.holder.cmp]>->( $a, $b ) } @holders;

    ## explicit dispatch : the callback modules stay visible to the static ##
    ## dependency graph [ dynamic $code{$name} calls are not ]             ##
    if ( $callback eq qw| osf-cache.lookup.with_peers | ) {
        <[osf-cache.lookup.with_peers]>->(
            {   'peers'  => \@holders,
                'params' => $params->{'params'} // {},
            }
        );
    } else {
        <[base.logs]>->(
            0, ': osf-cache : unknown peers callback : %s', $callback
        );
    }
}

return;

