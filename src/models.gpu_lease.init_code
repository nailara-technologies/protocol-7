## [:< ##

# name  = models.gpu_lease.init_code
# descr = arm gpu lease expiry and handover processing

my $timer = delete <models.gpu_lease.timer>;
$timer->cancel if defined $timer and $timer->is_active;
return TRUE
    if not <[base.cfg_bool]>->( <models.cfg.gpu_lease.enabled> // FALSE );

<models.gpu_lease.timer> = <[event.add_timer]>->(
    {   'after'    => 1,
        'interval' => 1,
        'repeat'   => TRUE,
        'handler'  => qw| models.gpu_lease.handler.tick |,
        'desc'     => 'gpu residency lease expiry and handover',
    }
);

return TRUE;

