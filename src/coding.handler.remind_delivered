# name  = coding.handler.remind_delivered
# descr = a reminder path answered : done or next

my $reply = shift              // {};
my $p     = $reply->{'params'} // {};
my ( $mode, $text ) = <[base.reply.mode_text]>->($reply);
$text =~ s{\s+\z}{};
if ( $mode eq qw| true | or $mode eq qw| size | ) {
    <[base.logs]>->(
        1,          ':. reminder %s delivered [ %s ]',
        $p->{'id'}, $p->{'path'}
    );
    return TRUE;
}
<[base.logs]>->(
    1, ':. reminder %s : %s refused [ %s ]',
    $p->{'id'}, $p->{'path'}, $text
);
return TRUE if <[coding.remind.deliver]>->($p);
<[base.logs]>->(
    0,          '<< reminder %s not delivered : %s >>',
    $p->{'id'}, $p->{'text'}
);
return FALSE;

