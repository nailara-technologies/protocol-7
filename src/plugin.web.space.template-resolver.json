## [:< ##

# name  = plugin.web.space.template-resolver.json
# descr = return current resolved template state as JSON

my $context = <web.space.templates.context>;

my $available_data = <[plugin.web.space.template-resolver.available_data]>;

my $payload = {
    qw| zoom           | => ( $context->{'zoom'}          // 1.0 ),
    qw| intent         | => ( $context->{'intent'}        // qw| navigate | ),
    qw| active_layers  | => ( $context->{'active_layers'} // [] ),
    qw| available_data | => $available_data,
    qw| history_depth  | => scalar( ( $context->{'history'} // [] )->@* ),
};

return eval { JSON::XS::encode_json($payload) } // '{}';

0;

