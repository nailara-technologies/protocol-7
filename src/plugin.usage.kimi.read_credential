# name  = plugin.usage.kimi.read_credential
# descr = read the newest kimi oauth credential file from disk and return
#         its access_token + expires_at -- shared by plugin.usage.kimi.fetch
#         and plugin.usage.kimi.refresh_token's own fresh-on-disk check, so
#         both agree on exactly what "the current credential" means
# return = { token => '', expires_at => undef, error => '' } -- token is
#          empty and error is set on any failure, expires_at may be undef
#          even with a valid token if the credential file itself omits it

my $provider = <usage.provider.kimi>;

my $home_dir = ( getpwuid($UID) )[7] // $ENV{'HOME'} // '';
return {
    'token'      => '',
    'expires_at' => undef,
    'error'      => 'cannot resolve ' . 'home ' . 'directory'
    }
    if not length $home_dir;

## credential directories : the configured one and the kimi cli's current ##
## one [ it moved to ~/.kimi -- the refresh cycle writes there, while     ##
## ~/.kimi-code kept an expired per-environment file : the watchdog never ##
## saw its own refresh and looped every 21s, 2026-09-30 ]                 ##
my @cred_dirs = grep { -d $ARG }
    map { catfile( $home_dir, $ARG ) } uniq( $provider->{'cred_rel_dir'},
    ( $provider->{'cred_rel_dirs_extra'} // [qw| .kimi/credentials |] )->@* );

return {
    'token'      => '',
    'expires_at' => undef,
    'error'      => 'no kimi ' . 'credential ' . 'directory found'
    }
    if not @cred_dirs;

my @cred_files;
foreach my $cred_dir (@cred_dirs) {
    my $cred_dh;
    next if not opendir( $cred_dh, $cred_dir );
    push @cred_files, map { catfile( $cred_dir, $ARG ) }
        grep {m{^kimi-code.*\.json$}} readdir($cred_dh);
    closedir($cred_dh);
}

return {
    'token'      => '',
    'expires_at' => undef,
    'error'      => 'no kimi ' . 'credential ' . 'file found'
    }
    if not @cred_files;

## the credential that stays valid longest wins [ not the newest file : a  ##
## per-environment file can be newer and already expired ]. the token only ##
## ever travels into the request header, never into a log line, never into ##
## %data                                                                   ##
my $token      = '';
my $expires_at = undef;

foreach my $cred_file (@cred_files) {
    my $cred_fh;
    next if not open( $cred_fh, '<', $cred_file );
    my $cred_str = do { local $INPUT_RECORD_SEPARATOR = undef; <$cred_fh> };
    close($cred_fh);
    my $cred_data = <[format.json.decode]>->($cred_str);
    undef $cred_str;    ##  no credential material left lying around  ##
    next if ref $cred_data ne qw| HASH |;
    next if not length( $cred_data->{'access_token'} // '' );
    my $file_expires = $cred_data->{'expires_at'} // 0;

    if ( not length $token or $file_expires > ( $expires_at // 0 ) ) {
        $token      = $cred_data->{'access_token'};
        $expires_at = $cred_data->{'expires_at'};
    }
    undef $cred_data;
}

return {
    'token'      => $token,
    'expires_at' => $expires_at,
    'error'      => length $token
    ? ''
    : 'no parseable kimi ' . 'credential with access token',
};

