## [:< ##

# name  = claude.child.gone
# descr = the child's stdout ended : state, the turn
# args  = reason, handle

## a stop asked for it [ stopped ] or it ended by itself [ crashed ] ; a ##
## turn that was running ends failed. closing, reaping and the group are ##
## done by stream_child.gone                                             ##

my ( $reason, $child ) = @ARG;
$reason //= qw| eof |;
$child  //= <claude.child>;
return if not defined $child;
return if not defined <claude.child> or <claude.child> != $child;

my $stopping = $child->{'stopping'} ? TRUE : FALSE;
<claude.state> = $stopping ? qw| stopped | : qw| crashed |;
<[claude.event.add]>->(
    qw| end |, sprintf 'pid %d %s [ %s ]',
    $child->{'pid'}, <claude.state>, $reason
);

<[claude.session.hold]>->( qw| release |, <claude.session> )
    if $stopping;

<[claude.turn.done]>->( { 'failed' => $stopping ? 'stopped' : 'crashed' } )
    if <claude.turn_active>;
<[base.zenki.resume_ondemand_timeout]>
    if defined $code{'base.zenki.resume_ondemand_timeout'};

