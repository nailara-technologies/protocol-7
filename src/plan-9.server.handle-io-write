## [:< ##
# name  = plan-9.server.handle-io-write
# descr = Handle 9P Twrite/Rwrite

my ( $client, $tag, $data ) = @ARG;

my $fid = <[plan-9.protocol.codec.decode-uint32]>->( substr( $data, 0, 4 ) );
my $offset
    = <[plan-9.protocol.codec.decode-uint64]>->( substr( $data, 4, 8 ) );
my $count
    = <[plan-9.protocol.codec.decode-uint32]>->( substr( $data, 12, 4 ) );
my $content = substr( $data, 16, $count );

my $f = $client->{fids}{$fid};
return <[plan-9.protocol.error]>->( $tag, "invalid fid" ) unless $f;
return <[plan-9.protocol.error]>->( $tag, "fid not open" )
    unless $f->{open};

## OREAD=0 / OWRITE=1 / ORDWR=2 / OEXEC=3 -- only OWRITE/ORDWR may write; a ##
## plain "& 0x03 == 0" check lets OEXEC(3) through too, since 3 & 3 == 3    ##
my $base_mode = $f->{omode} & 0x03;
unless ( $base_mode == <plan-9.protocol.constants.OWRITE>
    or $base_mode == <plan-9.protocol.constants.ORDWR> ) {
    return <[plan-9.protocol.error]>->( $tag, "read only" );
}

my $written = 0;

if ( $f->{type} eq 'layer' ) {
    $written = <[plan-9.server.buffer-write]>->(
        $f->{buffer}, $f->{z}, $offset, $content
    );
} elsif ( $f->{type} eq 'realpath' ) {
    return <[plan-9.protocol.error]>->( $tag, "export is read-only" )
        unless $f->{writable};
    return <[plan-9.protocol.error]>->( $tag, "cannot write to a directory" )
        if -d $f->{realpath};

    open( my $fh, '+<:raw', $f->{realpath} )
        or return
        <[plan-9.protocol.error]>->( $tag, "cannot open for write: $!" );
    seek( $fh, $offset, 0 );
    print {$fh} $content;
    $written = length $content;
    close($fh);
} else {
    return <[plan-9.protocol.error]>->( $tag, "cannot write to this file" );
}

my $resp = <[plan-9.protocol.codec.encode-uint32]>->($written);

return <[plan-9.protocol.codec.encode-message]>->(
    <plan-9.protocol.constants.Rwrite>,
    $tag, $resp
);

