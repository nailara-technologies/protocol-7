## [:< ##

# name  = plugin.web.jobs.prefs.write
# descr = persist web-side jobs prefs relay copy

my $prefs = shift // {};
return FALSE if ref $prefs ne qw| HASH |;

my $yaml = eval { YAML::XS::Dump($prefs) };
if ( $EVAL_ERROR or not defined $yaml ) {
    <[base.logs]>->(
        0,
        '[web.jobs.prefs] serialize error : %s',
        $EVAL_ERROR // 'unknown'
    );
    return FALSE;
}

my $cache_dir  = <[plugin.web.jobs.cache.path]>;
my $prefs_file = "$cache_dir/jobs-prefs.yaml";
my $tmp_file   = "$prefs_file.tmp";
eval { YAML::XS::DumpFile( $tmp_file, $prefs ) };
if ( $EVAL_ERROR or not -f $tmp_file ) {
    <[base.logs]>->(
        0,
        '[web.jobs.prefs] write error : %s',
        $EVAL_ERROR // 'unknown'
    );
    return FALSE;
}
rename $tmp_file,
    $prefs_file
    or <[base.logs]>->(
    0, '[web.jobs.prefs] rename %s -> %s failed : %s',
    $tmp_file, $prefs_file, $OS_ERROR
    );
return -f $prefs_file ? TRUE : FALSE;

