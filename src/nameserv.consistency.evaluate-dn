## [:< ##

# name  = nameserv.consistency.evaluate-dn
# descr = compare one dn name with the real addresses

## runs once the A and AAAA answers and the glue expectation are all in
## [ check 1 ] : the public records of this dn name against the real addresses
## of this host. [ check 2 ] : the same public values are the glue the parent
## zone publishes for a delegated dn name -- compared again when glue is
## expected, pointing at the registrar this time.  addresses compare in binary
## form [ text forms of the same address differ ] and findings print the
## compressed form.

my $state = shift;
my $dn    = shift;

require Socket;    ## inet_pton \ inet_ntop : not imported into a zenka ##

my $d = $state->{'dn'}->{$dn} // return FALSE;
return FALSE if grep { not defined $d->{$ARG} } qw| a aaaa glue |;

for my $family (
    [ qw| A |,    Socket::AF_INET(),  'a',    $state->{'real'}->{'v4'} ],
    [ qw| AAAA |, Socket::AF_INET6(), 'aaaa', $state->{'real'}->{'v6'} ]
) {
    my ( $type, $af, $key, $real ) = @$family;
    next unless @$real;

    my %dns_bin;
    for my $value ( @{ $d->{$key} // [] } ) {
        my $bin = Socket::inet_pton( $af, $value );
        $dns_bin{$bin} = TRUE if defined $bin;
    }
    my %real_bin;
    for my $value (@$real) {
        my $bin = Socket::inet_pton( $af, $value );
        $real_bin{$bin} = TRUE if defined $bin;
    }
    next unless %real_bin;

    my $same = TRUE;
    for my $bin ( keys %dns_bin )  { $same = FALSE if not $real_bin{$bin} }
    for my $bin ( keys %real_bin ) { $same = FALSE if not $dns_bin{$bin} }
    next if $same;

    my ($old_bin) = sort keys %dns_bin;
    my ($new_bin) = sort keys %real_bin;
    my $old_text = defined $old_bin ? Socket::inet_ntop( $af, $old_bin ) : '';
    my $new_text = Socket::inet_ntop( $af, $new_bin );

    if ( defined $old_bin ) {
        $state->{'findings'}->{
            sprintf 'update %s %s : %s -> %s',
            $type, $dn, $old_text, $new_text
        } = TRUE;
    } else {
        $state->{'findings'}
            ->{ sprintf 'add %s %s : %s', $type, $dn, $new_text } = TRUE;
    }

    next if $d->{'glue'} ne qw| expected |;
    if ( defined $old_bin ) {
        $state->{'findings'}->{
            sprintf 'update glue %s : %s %s -> %s [ registrar ]',
            $dn, $type, $old_text, $new_text
        } = TRUE;
    } else {
        $state->{'findings'}->{
            sprintf 'add glue %s %s : %s [ registrar ]',
            $dn, $type, $new_text
        } = TRUE;
    }
}

return TRUE;

