## [:< ##

# name  = screen.setup.close
# descr = destroy a layout-map window instance [ leaves the gtk main loop
#         running so later display-layouts calls reuse it ]

my $id = shift;
return undef if not defined $id;

my $inst = delete $data{'screen-setup'}{'instances'}{$id};
return undef if not defined $inst;

my $timer = delete $inst->{'placement_timer'};
eval { $timer->cancel } if defined $timer;

my $window = $inst->{'window'};
eval { $window->destroy } if defined $window;

return TRUE;

