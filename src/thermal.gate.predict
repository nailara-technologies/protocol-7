## [:< ##

# name  = thermal.gate.predict
# descr = predict temperature from learned power above the idle draw

my ( $gate, $watts ) = @ARG;

return undef if not <[thermal.gate.k_trusted]>->($gate);
return undef if not defined $gate->{'idle_watts'};
$watts //= $gate->{'power_avg'};
return undef if not defined $watts;

my $delta_w = $watts - $gate->{'idle_watts'};
$delta_w = 0 if $delta_w < 0;

return $gate->{'baseline'} + $gate->{'k'} * $delta_w;

