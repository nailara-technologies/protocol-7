# name  = coding.handler.tree_query_timeout
# descr = summary-tree cache query fallback : treat as a miss and proceed
#         to inference exactly as if tree had been absent

my $event = shift;
my $data  = eval { $event->data } // {};

my $query_id = $data->{'query_id'} // '';
return unless length $query_id;

## remove pending entry so a late reply finds nothing and is ignored ##
my $pending = delete $data{'coding'}{'tree_query_pending'}->{$query_id};
return unless defined $pending;

<[base.logs]>->(
    1,
    'tree_query_timeout: chk=%s query_id=%s : treating as miss',
    $pending->{'chk'} // '?', $query_id
);

<[coding.tools.handler.summarize_enqueue]>->(
    {   content     => $pending->{'enqueue'}{'content'},
        focus       => $pending->{'enqueue'}{'focus'},
        reply_id    => $pending->{'reply_id'},
        callback_id => $pending->{'callback_id'},
        chk         => $pending->{'chk'},
        origin      => $pending->{'origin'},
        thinking    => $pending->{'enqueue'}{'thinking'},
    }
);

return;

