## [:< ##

# name  = nameserv.cache.forward.next
# descr = advance a cache-miss state to the next upstream

my $state = shift // return FALSE;

$state->{'upstream_idx'}++;
$state->{'usevc'} = FALSE;

return <[nameserv.cache.forward.try]>->($state);

