# name   = kimi.acp.session_transcript
# descr  = this host's transcript of a held session
# args   = session id
# return = path, or undef [ no hold : nothing to check ]

my $id = shift // '';
return undef if $id !~ m|\A[\w-]{8,80}\z|;
my $sref = <[file.zenka_dir.load]>->("acp.hold.$id");
return undef if not defined $sref or $sref->$* !~ m{^lease\s*[=:]}m;
my $at = <[kimi.acp.session_paths]>;
return undef if defined $at->{'error'};
return "$at->{'home'}/sessions/$at->{'key'}/$id/agents/main/wire.jsonl";

