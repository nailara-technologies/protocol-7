## [:< ##

# name  = forensics.cmd.sweep-run
# descr = manually run nightly sweep [ same path as 04:07 slot ]

## the sweep runs in steps [ forensics.sweep.step ] : the reply follows ##
## once the record is written -- a running sweep is joined, not doubled ##

return { 'mode' => qw| false |, 'data' => 'sweep failed [ see zenka log ]' }
    if not <[forensics.event.nightly-sweep]>;

my $state = <forensics.sweep.state>;
return {    ## finished within the call [ nothing to read ] -- not expected ##
    'mode' => qw| true |,
    'data' => 'sweep record written [ see zenka var-dir sweeps/ ]'
    }
    if ref $state ne qw| HASH |;

push @{ $state->{'waiters'} }, $call->{'reply_id'};
return { 'mode' => qw| deferred | };

