## [:< ##

# name = base.session.cancel_route

( my $sid, my $msg, my @route_cids ) = @_;
return warn "expected session id" if not defined $sid or $sid !~ /^\d+$/;
return warn "[cancel_route] expected termination message"
    if !length $msg // '';

foreach my $s_cid (@route_cids) {
    next
        if not exists $data{'session'}->{$sid}
        or not exists $data{'session'}{$sid}{'route'}->{$s_cid};
    my $route_id = $data{'session'}{$sid}{'route'}{$s_cid};
    next if not exists $data{'route'}->{$route_id};
    my $s_sid = $data{'route'}{$route_id}{'source'}{'sid'};
    next if not defined $s_sid;

    my $t_sid    = $data{'route'}{$route_id}{'target'}{'sid'};
    my $t_cmd_id = $data{'route'}{$route_id}{'target'}{'cmd_id'} // 0;

    my $s_cid     = $data{'route'}{$route_id}{'source'}{'cmd_id'};
    my $reply_str = $s_cid ? "($s_cid)" : '';
    $reply_str .= "FALSE command route collapsed\n";
    if ( exists $data{'session'}{$s_sid} ) {
        $data{'session'}{$s_sid}{'buffer'}{'output'} .= $reply_str;

        ##  set sticky stream cancel so producer's next push returns 0  ##
        $data{'session'}{$s_sid}{'stream_cancelled'}{$s_cid} = TRUE
            if $s_cid > 0;
    }

    ##  notify STRM producer that its consumer is gone  ##
    if (    $t_cmd_id > 0
        and defined $t_sid
        and exists $data{'session'}{$t_sid}
        and ref $data{'session'}{$t_sid}{'streams'} eq 'HASH'
        and ref $data{'session'}{$t_sid}{'streams'}{$t_cmd_id} eq 'HASH'
        and not $data{'session'}{$t_sid}{'stream_cancelled'}{$t_cmd_id} ) {
        $data{'session'}{$t_sid}{'buffer'}{'output'} .= sprintf "(%d)!TRM!\n",
            $t_cmd_id;
        $data{'session'}{$t_sid}{'stream_cancelled'}{$t_cmd_id} = TRUE;
    }

    ## clean up stale route entry in target session to prevent crash on ##
    ## next push attempt when handler looks up the deleted route        ##
    if (    defined $t_sid
        and $t_cmd_id > 0
        and exists $data{'session'}{$t_sid} ) {
        delete $data{'session'}{$t_sid}{'route'}{$t_cmd_id};

        ## clean up STRM-SIZE stream state immediately on route cancel    ##
        ## avoids orphaned blocked_by_stream + lingering absolute timeout ##
        if ( ref $data{'session'}{$t_sid}{'streams'} eq 'HASH'
            and exists $data{'session'}{$t_sid}{'streams'}{$t_cmd_id} ) {
            my $stream = $data{'session'}{$t_sid}{'streams'}{$t_cmd_id};
            for my $timer_key (qw| idle_timeout absolute_timeout |) {
                $stream->{'timer'}{$timer_key}->cancel
                    if defined $stream->{'timer'}{$timer_key}
                    and not $stream->{'timer'}{$timer_key}->is_cancelled;
            }
            delete $data{'session'}{$t_sid}{'blocked_by_stream'}
                if ( $data{'session'}{$t_sid}{'blocked_by_stream'} // -1 )
                == $t_cmd_id;
            delete $data{'session'}{$t_sid}{'streams'}{$t_cmd_id};
            <[base.logs]>->(
                2, '[%d] STRM-SIZE stream %d cleaned up [ route cancel ]',
                $t_sid, $t_cmd_id
            );
        }
    }

    delete $data{'route'}{$route_id};
}

