## [:< ##

# name  = web-browser.start-up.raise_window

<[base.log]>->( 1, 'initialization complete, ..raising window..,' );

my $window = <web-browser.gtk_obj.window>;
if (<web-browser.start-up.opacity_hidden>) {
    $window->set_opacity( <web-browser.fg_opacity> // 1 );
    <web-browser.start-up.opacity_hidden> = FALSE;
}
$window->present;

