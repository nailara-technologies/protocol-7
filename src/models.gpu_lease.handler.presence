## [:< ##

# name  = models.gpu_lease.handler.presence
# descr = present reply : yield only to a connected previous holder

my $reply     = shift                  // {};
my $params    = $reply->{'params'}     // {};
my $from      = $params->{'from'}      // '';
my $requester = $params->{'requester'} // '';
my $pending   = <models.gpu_lease.pending>;

return FALSE
    if ref $pending ne qw| HASH |
    or ( $pending->{'from'}      // '' ) ne $from
    or ( $pending->{'requester'} // '' ) ne $requester
    or not $pending->{'presence'};

$pending->{'presence'} = FALSE;
my ($mode) = <[base.reply.mode_text]>->($reply);
if ( $mode ne qw| true | ) {
    $pending->{'unloaded'}    = TRUE;
    $pending->{'wait_reason'} = 'previous side disconnected : checking vram';
    <[base.logs]>->(
        1, ': gpu lease previous side %s is disconnected : no yield sent',
        $from
    );
    return <[models.gpu_lease.handler.tick]>;
}

$pending->{'wait_reason'} = 'waiting for unload acknowledgement';
my $sent = <[protocol-7.route-send]>->(
    {   'command'   => "$from.gpu-lease-yield",
        'call_args' => { 'args' => $requester },
    }
);
$pending->{'wait_reason'} = 'yield route failed : waiting for vram timeout'
    if not $sent;
<[base.logs]>->(
    $sent ? 1 : 0,
    ': gpu lease handover requested : %s -> %s%s',
    $from, $requester, $sent ? '' : ' [ route failed ]'
);
return TRUE;

