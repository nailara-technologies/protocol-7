## [:< ##

# name = models.memory.exists
# descr = check if memory item exists by checksum
# param = $checksum
# return = TRUE if exists, FALSE otherwise

my $checksum = shift;

return FALSE unless defined $checksum;
return FALSE unless $checksum =~ m|^[A-Z0-9]{7}$|;

## memory storage path
my $memory_dir = catdir( '/var/protocol-7', <system.zenka.name>, 'memory' );

return FALSE unless -d $memory_dir;

## tie directory for efficient file existence check
tie my %memory_files, 'Tie::Dir', $memory_dir or return FALSE;

## check if any file exists for this checksum
my @matching = grep {m|^${checksum}\.|} keys %memory_files;

return scalar(@matching) > 0 ? TRUE : FALSE;

0;

