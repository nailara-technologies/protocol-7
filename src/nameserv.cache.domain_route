## [:< ##

# name  = nameserv.cache.domain_route
# param = <qname>
# descr = longest matching domain route : [ match length, addresses ]

## a split network's domain list wins over the default route ; length 0 ##
## means no domain route matches                                        ##

my $name = lc( shift // '' );
$name =~ s|\.$||;

my $domain  = <nameserv.upstreams.domain_by_source> // {};
my $longest = 0;
my @addresses;
foreach my $source ( sort keys $domain->%* ) {
    my $route = $domain->{$source};
    foreach my $suffix ( $route->{'domains'}->@* ) {
        next
            if $name ne $suffix
            and $name !~ m|\.\Q$suffix\E$|;
        if ( length($suffix) > $longest ) {
            $longest   = length($suffix);
            @addresses = ();
        }
        push @addresses, $route->{'addresses'}->@*
            if length($suffix) == $longest;
    }
}
return ( $longest, @addresses );

