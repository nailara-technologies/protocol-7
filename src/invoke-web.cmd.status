## [:< ##

# name  = invoke-web.cmd.status
# descr = show invoke-web zenka and process status

my $status = <invoke-web.status> // 'idle';
my $pid    = <invoke-web.pid>    // '-';
my $url    = <invoke-web.url>    // '-';

## verify pid is still alive if we think it is running
if ( $status eq 'running' and defined <invoke-web.pid> ) {
    unless ( kill( 0, <invoke-web.pid> ) ) {
        $status = 'crashed';
        <invoke-web.status> = 'crashed';
    }
}

my $uptime = '';
if ( defined <invoke-web.start_time> ) {
    my $elapsed = <[base.time]>->(3) - <invoke-web.start_time>;
    $uptime = sprintf " [uptime: %ds]", $elapsed;
}

my $out = sprintf "status : %s%s\npid    : %s\nurl    : %s\n",
    $status, $uptime, $pid, $url;

return { mode => qw| size |, data => $out };

