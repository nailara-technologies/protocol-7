## [:< ##

# name  = invoke-web.cmd.status
# descr = show invoke-web zenka and process status

my $status = <invoke-web.status> // 'idle';
my $pid    = <invoke-web.pid>    // '-';
my $url    = <invoke-web.url>    // '-';

## verify pid is still alive if we think it is running
if ( $status eq 'running' and defined <invoke-web.pid> ) {
    unless ( <[invoke-web.is_alive]>->(<invoke-web.pid>) ) {
        $status = 'crashed';
        <invoke-web.status> = 'crashed';
        <[base.zenki.resume_ondemand_timeout]>;
    }
}

my $uptime = '';
if ( defined <invoke-web.start_time> ) {
    my $elapsed = <[base.time]>->(3) - <invoke-web.start_time>;
    $uptime = sprintf " [uptime: %ds]", $elapsed;
}

my $out = sprintf "status : %s%s\npid    : %s\nurl    : %s\n",
    $status, $uptime, $pid, $url;

$out .= sprintf "render : %s\n", <invoke-web.progress>
    if defined <invoke-web.progress>;
if ( my $last = <invoke-web.last_render> ) {
    $out .= sprintf "last   : item %s [ %s, ram %s ]\n", $last->{'item'} // '?',
        $last->{'stats'}->{'TOTAL GRAPH EXECUTION TIME'}   // '?',
        $last->{'stats'}->{'RAM used by InvokeAI process'} // '?';
}
$out .= sprintf "models : %d missing [ invoke-web.log ]\n",
    <invoke-web.missing_models>
    if <invoke-web.missing_models>;

if ( my $err = <invoke-web.last_error> ) {
    $out .= sprintf "error  : [%s, %ds ago] %s\n", $err->{'kind'},
        <[base.time]>->(3) - $err->{'time'}, $err->{'line'};
}

return { mode => qw| size |, data => $out };

