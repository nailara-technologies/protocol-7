## [:< ##

# name  = coding.round_chain.append
# param = <task_id> <round> <type> <delta_aref> [<masks_from>]
# descr = append one node to a task's round_chain. pure-ish : mutates only
#         the named task's round_chain array plus round_chain_current [ the
#         movable tip -- see below ], never touches async/task state.
#         called from coding.async.state_machine's tools_done/user_responded/
#         loop-assertion branches and from coding.async.complete's success
#         path.
#
#         type is 'round' [ ordinary tool-call round, delta = messages that
#         round appended ] or 'compaction' [ delta = the summary message(s)
#         that now stand in for everything in [masks_from, this round) --
#         see coding.round_chain.reconstruct for how masks_from is consumed ].
#
#         checksum = chain_L13( parent_checksum // '', canonical_json(delta) )
#         -- chained from round_chain_current, the movable tip [ NOT always
#         $chain->[-1] -- coding.round_chain.rewind can move this pointer to
#         an earlier node without touching the array, so the next append
#         after a rewind forks off the rewound-to node instead of silently
#         re-parenting off whatever the array's physical last entry happens
#         to be ]. not resumed/continued BMW state [ see base.chk-sum.bmw.
#         chain_L13 for why ].

my ( $task_id, $round, $type, $delta_aref, $masks_from ) = @ARG;

if ( not defined $task_id or not length $task_id ) {
    warn 'expected defined task_id <{C1}>';
    return undef;
}

if ( not defined $round or $round !~ m|^\d+$| ) {
    warn 'expected non-negative integer round <{C1}>';
    return undef;
}

if ( not defined $type or $type !~ m{^(?:round|compaction)$} ) {
    warn 'expected type of "round" or "compaction" <{C1}>';
    return undef;
}

if ( ref $delta_aref ne qw| ARRAY | ) {
    warn 'expected delta_aref as an ARRAY ref <{C1}>';
    return undef;
}

my $task = <coding.task.queue>->{$task_id};
if ( not defined $task ) {
    warn "task not found : '$task_id' <{C1}>";
    return undef;
}

$task->{'round_chain'} //= [];
my $chain = $task->{'round_chain'};

## round_chain_current is the movable tip new appends parent off of --   ##
## NOT necessarily $chain->[-1]. after a rewind [ coding.round_chain.    ##
## rewind moves this pointer without touching the array ], the next     ##
## append here parents off the rewound-to node instead of the array's    ##
## physical last entry, creating a fork rather than overwriting history. ##
## falls back to $chain->[-1] for chains that predate this field, then   ##
## to '' for a genuinely fresh chain. NOT qw|| for the fresh-chain case  ##
## -- that's an empty LIST, which collapses to undef in scalar context,  ##
## not '' ; chain_L13 requires a real empty string for genesis.          ##
my $parent_checksum = $task->{'round_chain_current'}
    // ( @{$chain} ? $chain->[-1]->{'checksum'} : '' );

my $checksum = <[chk-sum.bmw.chain_L13]>->(
    $parent_checksum, <[context.util.tree.canonical_json]>->($delta_aref),
);
return undef unless defined $checksum;

my $node = {
    round     => $round,
    type      => $type,
    parent    => $parent_checksum,
    checksum  => $checksum,
    delta     => $delta_aref,
    timestamp => <[base.ntime]>,
};

$node->{'masks_from'} = $masks_from
    if $type eq qw| compaction | and defined $masks_from;

push @{$chain}, $node;
$task->{'round_chain_current'} = $checksum;

return $node;

