## [:< ##

# name  = letsencr.parent.renewal_idle_release
# descr = mark one renewal as done [ success or failure ] and resume the
#         on-demand idle timeout once none are in flight anymore [ pairs
#         with letsencr.parent.renewal_idle_hold ]

<letsencr.parent.renewals_in_flight> //= 0;
<letsencr.parent.renewals_in_flight>--
    if <letsencr.parent.renewals_in_flight> > 0;
<letsencr.parent.renewals_in_flight> = 0
    if <letsencr.parent.renewals_in_flight> < 0;

<[base.zenki.resume_ondemand_timeout]>
    if <letsencr.parent.renewals_in_flight> == 0;

