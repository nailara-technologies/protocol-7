## [:< ##

# name  = dbus.handler.process_output
# descr = reads output from dbus process

<v7-zenki.patterns.zenka_output> //= {};

my $event   = shift->w;
my $read_fh = $event->fd;
my $server  = $event->data;
my $bin     = $server->{'bin'};
my $pid     = $server->{'pid'};

<dbus.output_buffer> //= '';

my $read_bytes
    = <[base.s_read]>->( $read_fh, \$data{'dbus'}{'output_buffer'}, 4096 );
if ( $read_bytes < 1 ) {    ## [ assumed filehandle exception ] ##
    $event->cancel;
    close($read_fh);
    <[base.logs]>->( '%s [PID:%d] output filehandle closed.', $bin, $pid );
    kill( 9, $pid );        ## making sure it is gone ##
    my $err_str
        = defined <dbus.first_error>
        ? ': "' . <dbus.first_error> . '"'
        : ' unexpectedly! (reason unknown)';
    <[base.logs]>->( 0, '%s terminated%s', $bin, $err_str );
    <[base.log]>->( 1, "done." );
    exit(2);
}

while ( <dbus.output_buffer> =~ s|^([^\n]*)\n||s ) {
    my $output_line = $LAST_PAREN_MATCH;
    $output_line =~ s|\r||sg;
    if ( $output_line =~ m{^(unix:(?:abstract|path)=([^\n,]+),[^\n]+)$} ) {
        <dbus.socket_addr> = ${^CAPTURE}[0];
        <dbus.socket_path> = ${^CAPTURE}[1];
        my $privs_user = <dbus.privs_user>;
        <[base.logs]>->(
            ": socket path : %s [owner:'%s']",
            ${^CAPTURE}[1], $privs_user
        );

        ## dbus-daemon doesn't remove its own socket file on a hard kill   ##
        ## [confirmed live -- stale /tmp/dbus-* files from prior sessions  ##
        ## accumulate], so register it with v7 for automatic clean-up on   ##
        ## this zenka's own exit/restart. this fires long before the cube  ##
        ## session id / instance verification round-trip completes, so a   ##
        ## direct report-temp-path call here loses the race [ confirmed    ##
        ## live -- v7 logs 'no instance matches cube-sid', it hasn't       ##
        ## learned this instance's cube_sid yet ] ; queueing it as an init ##
        ## report instead defers actual sending to base.session.           ##
        ## send_init_reports, which already waits for                      ##
        ## system.zenka.initialized before flushing -- same pattern        ##
        ## io.unix.socket.input.open uses for its own socket file          ##
        push(
            <system.init_reports>->@*,
            {   'target_command' => qw| v7-zenki.report-temp-path |,
                'param'          => <dbus.socket_path>,
                'descr'          => 'registering dbus session socket file'
            }
        );

        <[base.async.get_session_id]>;
    } else {
        my $log_level = $output_line =~ m{ctivat(ing|ed) service} ? 2 : 0;
        <[base.logs]>->( $log_level, '< %s > %s', $bin, $output_line );
    }
}

