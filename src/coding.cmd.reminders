## [:< ##

# name  = coding.cmd.reminders
# descr = the waiting reminders [ events bucket ]

my $reply_id = $call->{'reply_id'} // '';
<[park.send]>->(
    qw| bucket-show |,
    '',
    qw| coding.handler.remind_reply |,
    { 'reply_id' => $reply_id, 'label' => qw| list | }
    )
    or do {
    my @kept = <[coding.remind.lines]>;
    return {
        'mode' => qw| false |,
        'data' => 'events zenka not reachable'
        }
        if not @kept;
    return {
        'mode' => qw| size |,
        'data' => join( "\n", @kept, 'events zenka not reachable' ) . "\n"
    };
    };
return { 'mode' => qw| deferred | } if $reply_id =~ m{\A\d+\z};
return { 'mode' => qw| true |, 'data' => 'reminders requested' };

