## [:< ##

# name   = session_move.host
# descr  = the host name a lease and a manifest carry
# return = name

my $name = <session_move.cfg.host>;
if ( not defined $name ) {
    <[base.perlmod.load]>->(qw| POSIX |);
    $name = ( POSIX::uname() )[1] // '';
}
$name =~ s{[^\w.-]+}{-}g;
return length $name ? $name : qw| unknown |;

