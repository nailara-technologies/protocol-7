## [:< ##

# name  = web-browser.cmd.set-zoom
# descr = set browser zoom factor, absolute or relative
# param = <value> | +<value> | -<value>

my $args = $call->{'args'} // '';
my ( $sign, $num ) = $args =~ m|^\s*([+-]?)(\d*\.?\d+)\s*$|;

return {
    'mode' => qw| false |,
    'data' => 'usage: set-zoom <value>  [ absolute, eg. 1.5 ] '
        . ' |  set-zoom +<value> / -<value>  [ relative ]'
    }
    unless defined $num;

<web-browser.zoom_factor> //= 1;

my $new_factor
    = length($sign)
    ? <web-browser.zoom_factor> + ( $sign eq qw| - | ? -1 : 1 ) * $num
    : 0 + $num;

## defensive floor only : a zero/negative zoom_level crashes WebKit's zoom  ##
## call. deliberately NOT <web-browser.min_zoom> -- that's the auto_zoom    ##
## recalculation's floor on zoom_level, exactly what this command exists to ##
## manually override [ eg. correcting an auto_zoom overshoot ]              ##
my $min_factor = 0.05;
$new_factor = $min_factor if $new_factor < $min_factor;

<web-browser.zoom_factor> = $new_factor;

my $effective_zoom
    = sprintf( '%.3f', <web-browser.zoom_level> * <web-browser.zoom_factor> );

foreach my $id ( 1 .. 2 ) {
    my $view = <web-browser.gtk_obj.view>->{$id};
    next unless defined $view;
    $view->set_zoom_level($effective_zoom);
}

return {
    'mode' => qw| true |,
    'data' => sprintf(
        ": zoom factor %s : effective zoom %s%%",
        <web-browser.zoom_factor>, $effective_zoom * 100
    )
};

