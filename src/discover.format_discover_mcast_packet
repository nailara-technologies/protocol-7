## [:< ##

# name  = discover.format_discover_mcast_packet
# descr = format and sign mcast broadcast packet string

my $broadcast_packet_type = shift // '';     ##[  packet type name  ]##
my $payload_str           = shift // '';     ## packet content string ##
my $host_key = <discover.crypt.key_name>;    ##  loaded host key name  ##

if ( not length $broadcast_packet_type ) {
    warn 'expecting packet type param <{C1}>';
    return undef;
} elsif ( not length $payload_str ) {
    warn 'expected payload str param <{C1}>';
    return undef;
} elsif ( not exists $keys{'C25519'}->{$host_key}
    or not exists $keys{'C25519'}->{$host_key}->{'public'} ) {
    <[base.logs]>->(
        "C25519 key '%s' not loaded [ cannot sign packet ]", $host_key
    );
    return undef;
}

##[ packet header cached ]##
##
if (   not defined <discover.announce_msg_header>
    or not defined <discover.announce_msg_header>->{$broadcast_packet_type} )
{    ## reset in 'discover.post_init' ##
    my $packet_stemplate = "[:<|%s|%s\n";    ## header template ##
    <discover.announce_msg_header>->{$broadcast_packet_type}
        = sprintf $packet_stemplate,
        uc($broadcast_packet_type),          ##  packet type is uppercase  ##
        Crypt::Misc::encode_b32r( $keys{'C25519'}->{$host_key}->{'public'} );
}    ## the old '.sig.*' raw-pubkey signature lines are no longer emitted ##

## host-root delegation [ data/md/design/HOST-ROOT-DELEGATION.md ] : the    ##
## '<S>.dlg' statement sits next to S [ a public artefact outside root/ ] ; ##
## read it FRESH every packet so renewals \ rotations take effect, and ship ##
## it as a 3-space 'dlg:' field BEFORE the payload so the packet signature  ##
## below covers it                                                          ##
##
my $deleg_line = '';
my $dlg_wire;
my $dlg_path = <[crypt.C25519.delegation_file]>->($host_key);
if ( defined $dlg_path and -f $dlg_path and open my $dlg_fh, '<', $dlg_path )
{
    my $line = readline($dlg_fh);
    close $dlg_fh;
    if ( defined $line ) {
        $line =~ s|\s+\z||;    ##  strip the trailing newline \ space  ##
        $dlg_wire = $line
            if length $line
            and length $line <= 2048
            and $line =~ m|\A[A-Z2-7]+\z|;
    }
}
if ( defined $dlg_wire ) {
    $deleg_line = sprintf "   dlg:%s\n", $dlg_wire;    ## 3 space prefix ##
}

## level 1 log once per change [ the no-delegation case the task names ; a ##
## newly seen \ renewed statement is noted at level 2 ]                    ##
my $dlg_state = defined $dlg_wire ? $dlg_wire : '';
if ( ( <discover.dlg.last_state> // "\x00unset" ) ne $dlg_state ) {
    if ( not defined $dlg_wire ) {
        <[base.logs]>->(
            1,
            "host delegation not readable for "
                . "key '%s' [ announcing without it ]",
            $host_key
        );
    } else {
        <[base.logs]>->(
            2, "announcing host delegation for key '%s' .,", $host_key
        );
    }
    <discover.dlg.last_state> = $dlg_state;
}

## append orbital p7ref if available : triggers async fetch if not cached ##
my $local_p7ref = <[discover.orbital.get_local_p7ref]>;
if ( defined $local_p7ref and length $local_p7ref ) {
    $payload_str .= sprintf "p7ref %s\n", $local_p7ref;
}

$payload_str =~ s|^|      |mg;    ##  payload has 6 spaces prefix  ##
$payload_str =~ s|\n+$||;         ##  striping trailing linefeed[s]  ##

##  adding network time-stamp  ##
##
my $packet_str = sprintf "%s%s%s\n%s:",
    <discover.announce_msg_header>->{$broadcast_packet_type},
    $deleg_line,    ##  host-root delegation field [ or empty ]  ##
    $payload_str, <[base.ntime.b32]>->( 3, TRUE );

## signing packet with host key ##
##
my $signature_str = <[crypt.C25519.sign_data]>->( \$packet_str, $host_key );
if ( not defined $signature_str ) {
    warn 'mcast packet signing failed <{C1}>';
    return undef;
}

##  returning formatted mcast packet string  ##
##
return sprintf "%s%s\n", $packet_str,    ## appending packet signature ##
    Crypt::Misc::encode_b32r($signature_str);

