## [:< ##

# name  = ticker.subscribe-screen-change
# descr = initialized callback — subscribe ticker to X-11 screen-change STRM events

<[base.log]>->( 1, 'subscribing ticker to X-11 screen-change events .,' );

<[base.zenki.resolve_primary_sid]>->(
    'X-11',
    sub {
        my $sid = shift;
        return if not defined $sid;
        <[protocol-7.route-send]>->(
            {   'command' => "$sid.subscribe-screen-change",
                'reply'   => {
                    'handler' => qw| ticker.handler.screen-change_strm_open |,
                }
            }
        );
    }
);

return TRUE;

