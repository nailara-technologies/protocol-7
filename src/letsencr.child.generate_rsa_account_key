## [:< ##

# name  = letsencr.child.generate_rsa_account_key
# descr = generate RSA 2048-bit account key for ACME operations (RS256)

<[base.log]>->( 2, 'generating new RSA 2048-bit account key for ACME' );

my $start_time = time();

## generate RSA 2048-bit keypair using Crypt::OpenSSL::RSA  [ OpenSSL library
## with proper PKCS#1 v1.5 padding for RS256 ]
my $rsa = Crypt::OpenSSL::RSA->generate_key(2048);

<[base.log]>->(
    2,
    'RSA 2048-bit account key generated in '
        . ( time() - $start_time )
        . ' seconds'
);

## get private key in PEM format for caching
my $pem_private = $rsa->get_private_key_string;
my $pem_public  = $rsa->get_public_key_string;

## extract modulus and exponent via Crypt::PK::RSA [ CryptX ]
my $pk_rsa   = Crypt::PK::RSA->new( \$pem_public );
my $key_hash = $pk_rsa->key2hash;

my $modulus_b64;
my $exponent_b64;

if ( $key_hash->{'N'} ) {
    my $modulus_bin = pack( 'H*', $key_hash->{'N'} );
    $modulus_bin =~ s{^\x00}{};    ## strip leading null byte
    $modulus_b64 = encode_base64url($modulus_bin);
    <[base.logs]>
        ->( 3, 'modulus_b64 length: %d chars', length($modulus_b64) );
}

## exponent from key hash [ hex → binary → base64url ]
my $exponent_bin = pack( 'H*', $key_hash->{'e'} );
$exponent_b64 = encode_base64url($exponent_bin);

<[base.logs]>->(
    3,             'exponent_b64: %s (length %d)',
    $exponent_b64, length($exponent_b64)
);

## check modulus extraction
unless ($modulus_b64) {
    <[base.log]>->( 1, 'warning: could not extract modulus from RSA key' );
    return undef;
}

## generate unique key identifier
my $key_name = 'acme-account-' . <[base.prng.chars-anum]>->(8);

## store in global %keys{'RSA'} hash
$keys{'RSA'}->{$key_name} = {
    'rsa_object'  => $rsa,
    'modulus'     => $modulus_b64,
    'exponent'    => $exponent_b64,
    'pem_private' => $pem_private,
    'time-loaded' => <[base.ntime]>,
};

## cache private key to disk [ separate account key per ACME server ] ##
my $key_cache
    = <[letsencr.child.account_file_paths]>
    ->( <letsencr.child.acme_client>->{'server'} // <letsencr.acme.server> )
    ->{'key_rsa'};

<[file.put_bin]>->( $key_cache, \$pem_private );
chmod( 0600, $key_cache );

<[base.logs]>->(
    2, "RSA account key saved to %s [ PEM encoded ]", $key_cache
);

## store in child state
<letsencr.child.acme_client>->{account_key_name} = $key_name;
<letsencr.child.acme_client>->{account_key_type} = 'RSA';

<[base.log]>->( 2, 'RSA account key ready for ACME operations' );

return {
    'key_name' => $key_name,
    'rsa'      => $rsa,
    'modulus'  => $modulus_b64,
    'exponent' => $exponent_b64,
};

