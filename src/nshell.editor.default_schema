## [:< ##

# name  = nshell.editor.default_schema
# descr = nshell's single-field editor schema [ shared literal ]

## one freeform_line field named 'command', submit on enter.  used at every
## editor.control.create call site in nshell.* — single source so the literal
## cannot drift between call sites.

return {
    'fields' => [
        {   'name' => 'command',
            'type' => 'freeform_line',
        },
    ],
    'submit_on'    => 'enter',
    'active_field' => 0,
};

