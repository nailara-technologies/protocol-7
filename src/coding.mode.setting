## [:< ##

# name  = coding.mode.setting
# descr = look up one setting of a work mode, walking up the mode tree
# param = $mode [ dotted path, e.g. code.new.parser ], $key [ model,
#         template, system, tool_set, max_rounds .. ] -> value | undef
# note  = modes are dotted config keys : coding.cfg.mode.<path>.<key>.
#         the most specific mode that sets the key wins : code.new.parser
#         -> code.new -> code -> default. a sub-mode lists only what
#         differs [ todo WNF ]

my $mode = shift // '';
my $key  = shift // '';

return undef unless length $key;

my $tree = <coding.cfg.mode>;
return undef unless ref $tree eq qw| HASH |;

## default first, then each level of the path overrides it ##
my $value
    = ( ref $tree->{'default'} eq qw| HASH |
        and !ref $tree->{'default'}{$key} )
    ? $tree->{'default'}{$key}
    : undef;

my $node = $tree;
for my $part ( grep {length} split m|\.|, $mode ) {
    $node = $node->{$part};
    last unless ref $node eq qw| HASH |;
    $value = $node->{$key} if defined $node->{$key} and !ref $node->{$key};
}

return $value;

