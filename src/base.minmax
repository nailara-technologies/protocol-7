## [:< ##

# name  = base.minmax

return unless @ARG;

my ( $min, $max ) = ( $ARG[0], $ARG[0] );

for ( @ARG[ 1 .. $#ARG ] ) {
    $min = $ARG if $ARG < $min;
    $max = $ARG if $ARG > $max;
}

return ( $min, $max );

