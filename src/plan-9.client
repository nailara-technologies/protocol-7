## [:< ##
# name  = plan-9.client
# descr = 9P protocol client for mounting remote filesystems

use IO::Socket::INET;

# Client state per connection -- must survive across calls, or a second
# connect silently discards every prior connection's registry entry
<plan-9.client> //= {};

## Connect to 9P server ##
my ($options) = @ARG;
$options //= {};

my $host = $options->{host} // '127.0.0.1';
my $port = $options->{port} // <plan-9.default_port> // 15640;
my $name = $options->{name} // "$host:$port";

my $socket = IO::Socket::INET->new(
    PeerAddr => $host,
    PeerPort => $port,
    Proto    => 'tcp',
    Timeout  => 5,
);

if ( not defined $socket ) {
    return {
        'mode' => 'false',
        'data' => "Cannot connect to $host:$port: $!"
    };
}

$socket->autoflush(1);

my $client = {
    'socket'   => $socket,
    'host'     => $host,
    'port'     => $port,
    'msize'    => 8192,
    'root_fid' => 0,
    'next_fid' => 1,
    'fids'     => {},
};

<plan-9.client>->{$name} = $client;

# Version negotiation
my $version_result = <[plan-9.client.version]>->($client);
return $version_result if $version_result->{'mode'} eq 'false';

# Attach to root
my $attach_result
    = <[plan-9.client.attach]>->( $client, $options->{aname} // '' );
return $attach_result if $attach_result->{'mode'} eq 'false';

<[base.logs]>->("9P client connected to $host:$port");

return {
    'mode' => 'true',
    'data' => $name
};

