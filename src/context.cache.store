## [:< ##

# name  = context.cache.store
# descr = store context result with key and ttl

my $params = shift // {};

my $key    = $params->{'key'}    // '';
my $data   = $params->{'data'}   // '';
my $ttl    = $params->{'ttl'}    // 300;
my $tags   = $params->{'tags'}   // [];
my $source = $params->{'source'} // '';

return { 'mode' => qw| false |, 'data' => 'cache key required' }
    unless length $key;

## initialize cache store if needed ##
<context.cache> //= {};

my $now = time();

<context.cache>->{$key} = {
    'data'       => $data,
    'stored_at'  => $now,
    'expires_at' => $now + $ttl,
    'ttl'        => $ttl,
    'tags'       => $tags,
    'source'     => $source,
    'hits'       => 0
};

<[base.logs]>->(
    3,    ':. cache.store: key=%s ttl=%d source=%s :.',
    $key, $ttl, $source
);

return {
    'mode' => qw| true |,
    'data' => {
        'key'        => $key,
        'expires_at' => $now + $ttl,
        'stored'     => TRUE
    }
};

