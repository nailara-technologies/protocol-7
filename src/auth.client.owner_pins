## [:< ##

# name   = auth.client.owner_pins
# descr  = owner pin key ids [ <remote-keys>/owners/*.public ]
# param  = <remote-keys dir> [ e.g. ~/.n/remote-keys ]
# return = [ <77 char key id>, .. ] [ empty when none ]
#
# data/md/design/TRUST-CHAIN-STEP2.md [ 'pins' ] : line 1 of each file is
# the key id. written ONLY by an explicit command, never on contact.
# symlinks \ malformed \ unreadable entries are skipped -- never trusted.
# twin : owner_pins in bin/p7-auth-keypair-helper.pl.

my $keys_dir = shift;

my @owner;
return \@owner if not defined $keys_dir or ref $keys_dir;

my $owner_dir = join( qw| / |, $keys_dir, qw| owners | );
opendir( my $dir_fh, $owner_dir ) or return \@owner;
foreach my $entry ( sort readdir $dir_fh ) {
    next if $entry !~ m|\A[^/]+\.public\z|;
    my $path = join qw| / |, $owner_dir, $entry;
    next if -l $path           or not -f $path;
    open( my $fh, '<', $path ) or next;
    my $line = readline($fh) // '';
    close($fh);
    $line =~ s{\s+\z}{};
    push @owner, $line if $line =~ m|\A[A-Z2-7]{77}\z|;
}
closedir $dir_fh;

return \@owner;

