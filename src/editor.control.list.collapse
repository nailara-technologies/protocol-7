## [:< ##

# name  = editor.control.list.collapse
# descr = collapse an expanded list back to its count summary
# param = $editor_state

## the inverse of editor.control.list.expand : reads the row buffers back into
## the list field's 'entries', drops EMPTY rows -- which is what makes the
## trailing 'new entry' row disappear again rather than accumulate -- and
## rebuilds the original schema.
##
## WINDOWED lists [ more entries than editor.control.list.window_cap ] only
## ever have their CURRENT window's rows materialised -- collapsing must
## therefore MERGE those rows into list_source's working copy at the offset
## they were shown at, not treat them as the whole list, or every entry
## scrolled off-screen at the moment of collapse would be silently dropped.
## below the cap this is exactly equivalent to a full rebuild, since the
## window then covers everything and the offset is always 0.
##
## returns the ORIGINAL state unchanged when no list is expanded, so callers
## can invoke it unconditionally.  user-edit.form.submit relies on that :
## submitting while expanded would otherwise write '<field>_0', '<field>_1' as
## separate top-level record fields and permanently replace the array, and
## Enter submits from ANY field.
##
## the caller MUST rebuild the frame afterwards [ see .expand's note ].

my ($editor_state) = @ARG;

return $editor_state if ref $editor_state ne qw| HASH |;

my $source = $editor_state->{'list_source'};

return $editor_state if ref $source ne qw| HASH |;

my $field_name    = $source->{'field'}  // return $editor_state;
my $source_fields = $source->{'schema'} // return $editor_state;

## gather the CURRENT WINDOW's rows in schema order, trimmed but NOT yet
## filtered -- position within the window still matters, since it is about to
## be spliced back into the working copy at the offset the window was shown
## at.  list_info [ the position readout row ] is not an entry and is skipped
my @window_values;
foreach my $field_def ( ( $editor_state->{'schema'}{'fields'} // [] )->@* ) {

    my $name = $field_def->{'name'} // next;

    next if ( $field_def->{'list_row_of'} // '' ) ne $field_name;
    next if $field_def->{'list_info'};

    my $value = <[editor.control.get_value]>->( $editor_state, $name ) // '';
    $value =~ s|^\s+||;
    $value =~ s|\s+$||;

    push @window_values, $value;
}

## MERGE, not replace : splicing the window into the working copy at the
## offset it was shown at -- rather than treating it as the whole list -- is
## what keeps an off-window entry from ever being tested against "is it blank"
## in the first place.  blanks fall out only AFTER the splice
my @virtual = ( ( $source->{'entries'} // [] )->@*, '' );
splice( @virtual, $source->{'offset'} // 0,
    scalar(@window_values), @window_values );
my @entries = grep {length} @virtual;

## per-field OPT-IN, same 'sort_on_focus' flag and reasoning as
## editor.control.list.expand : sort the merged entries before storing them
## back, so LEAVING the list [ this module ] normalises immediately, exactly
## like ENTERING it already does, rather than only showing sorted order the
## next time the field happens to be re-expanded
my ($list_def)
    = grep { ( $ARG->{'name'} // '' ) eq $field_name } $source_fields->@*;
@entries = <[base.sort]>->( \@entries )
    if ref $list_def eq qw| HASH | and $list_def->{'sort_on_focus'};

## rebuild the original field list, carrying current values across ##
my @restored;
foreach my $field_def ( $source_fields->@* ) {

    my $name = $field_def->{'name'} // next;

    if ( $name eq $field_name ) {
        push @restored, { %{$field_def}, qw| entries | => \@entries };
        next;
    }

    push @restored,
        {
        %{$field_def},
        qw| default | =>
            <[editor.control.get_value]>->( $editor_state, $name ) // ''
        };
}

my $new_state = <[editor.control.create]>
    ->( { qw| fields | => \@restored, qw| active_field | => 0 } );

return $editor_state if not defined $new_state;

$new_state->{'kill_buffer'} = $editor_state->{'kill_buffer'} // '';
$new_state->{'mode'}        = qw| insert |;

## put the cursor back ON the collapsed field, by NAME ##
my $position = 0;
foreach my $field_def (@restored) {
    $new_state->{'active_field'} = $position, last
        if ( $field_def->{'name'} // '' ) eq $field_name;
    $position++;
}

return $new_state;

