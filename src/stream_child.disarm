## [:< ##

# name  = stream_child.disarm
# descr = cancel the pending stop step timer
# param = handle

my $handle = shift;
$handle->{'serial'}++;
my $timer = delete $handle->{'timer'};
eval { $timer->cancel } if ref $timer and eval { $timer->can('cancel') };
return TRUE;

