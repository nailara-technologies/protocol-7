## [:< ##

# name  = zenki.console.start
# param = <zenka_name>
# descr = start zenka with automatic dependency resolution

my $zenka_name = shift;

$zenka_name //= '';
$zenka_name =~ s|^\s+||;
$zenka_name =~ s|\s.*$||;

unless ( length $zenka_name ) {
    <[base.log]>->( 0, 'error : zenka name required' );
    return say "::\n: usage : start <zenka_name>\n::";
}

<[base.logs]>->( 1, "starting zenka : %s [ auto-resolution ]", $zenka_name );

<zenki.start.reply> = undef;

my $result = <[zenki.parent.start]>->( { 'zenka' => $zenka_name } );

if ( not $result->{'success'} ) {
    my $error = $result->{'error'} || 'unknown error';
    <[base.logs]>->( 0, "✗ failed to start '%s' : %s", $zenka_name, $error );
    return say "::\n: ✗ failed to start zenka\n: error : $error\n::";
}

## a direct [ in-v7-zenki ] start already carries its result ##
if ( not $result->{'via_ipc'} ) {
    my $message = $result->{'message'} // 'started';
    return say "::\n: ✓ zenka '$zenka_name' : $message\n::";
}

## the relayed reply arrives asynchronously : this console command owns the ##
## event loop until zenki.handler.v7_start_reply unloops, or until the      ##
## timeout expires [ user-edit.console.show-form precedent -- the start     ##
## file deliberately has no [zenka.loop] of its own ]                       ##

<[base.init-done]>->(TRUE);    ## one-shot zenka : not v7-zenki managed ##

<[base.zenka.loop]>->(<zenki.cfg.reply_timeout>);

my $reply = <zenki.start.reply>;

if ( not defined $reply ) {
    my $waited = <zenki.cfg.reply_timeout>;
    <[base.logs]>->(
        0,           "✗ no reply from v7-zenki for '%s' [ %ds ]",
        $zenka_name, $waited
    );
    return say "::\n: ✗ no reply from v7-zenki within ${waited}s\n::";
}

return say sprintf(
    "::\n: %s zenka '%s'\n: %s\n::",
    $reply->{'success'} ? '✓' : '✗',
    $zenka_name, $reply->{'data'}
);

