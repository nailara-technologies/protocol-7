## [:< ##

# name  = coding.cmd.subscribe-session
# descr = live STRM subscription to a running coding task
# param = <task_id>

my $task_id = $call->{'args'} // '';

return { 'mode' => qw| false |, 'data' => 'task_id required' }
    unless length $task_id;

return { 'mode' => qw| false |, 'data' => "task not found : $task_id" }
    unless exists <coding.task.queue>->{$task_id};

## dedupe : this session may already hold a listener for this task [ e.g.   ##
## task-append's resume branch re-subscribing while a message sent right as ##
## the previous round finished raced the state machine's own STATE_COMPLETE ##
## listener cleanup -- leaving both handles in place would double-deliver   ##
## every future chunk, including tool-call frames, to this session. close + ##
## drop any prior handle for this sid rather than skip the resubscribe      ##
## outright : escape/ctrl-c never clear this array on their own, so a dead  ##
## entry from an earlier cancelled stream must not be able to block a fresh ##
## subscribe forever ]                                                      ##
my $existing = <coding.session.listeners>->{$task_id} //= [];
if ( my @stale = grep { $ARG->{'sid'} eq $call->{'session_id'} } @$existing )
{
    <[base.stream.close]>->($ARG) for @stale;
    @$existing = grep { $ARG->{'sid'} ne $call->{'session_id'} } @$existing;
    <[base.logs]>->(
        2,
        'coding: replaced stale session-viewer listener [ task=%s sid=%s ]',
        $task_id, $call->{'session_id'}
    );
}

my $h = <[base.stream.open]>->(
    {   'sid'    => $call->{'session_id'},
        'cmd_id' => $call->{'command_id'},
        'type'   => qw| STRM |,
        'total'  => undef,
    }
);

return { 'mode' => qw| false |, 'data' => 'stream open refused' }
    unless defined $h;

push @{ <coding.session.listeners>->{$task_id} //= [] }, $h;

<[base.logs]>->(
    2,        'coding: session-viewer listener added [ task=%s sid=%s ]',
    $task_id, $call->{'session_id'}
);

return { 'mode' => qw| deferred | };

