## [:< ##

# name  = network.init_code
# descr = net zenka defaults and the wlan helper start

## paths stay configurable so tests point them at a fake tree ##
<network.cfg.sys_class_net>  //= qw| /sys/class/net |;
<network.cfg.proc_root>      //= qw| /proc |;
<network.cfg.resolv_conf>    //= qw| /etc/resolv.conf |;
<network.cfg.ifupdown_conf>  //= qw| /etc/network/interfaces |;
<network.cfg.ifupdown_state> //= qw| /run/network/ifstate |;

## last dhcpcd event per interface [ memory only, net.leases ] ##
<network.lease> //= {};

## wlan : the root helper [ bin/p7-wlan-helper ] and the vault tool ##
<network.cfg.wlan_helper>  //= <system.root_path> . qw| /bin/p7-wlan-helper |;
<network.cfg.wpa_ctrl_dir> //= qw| /run/wpa_supplicant |;
<network.cfg.vault_bin>    //= <system.root_path> . qw| /bin/p7-vault |;

## still root here : root.drop_privs comes after init_modules ##
<[network.wlan.start_helper]>;

0;

