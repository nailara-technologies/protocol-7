## [:< ##

# name = zenki.parent.start
# descr = smart zenka launcher with automatic dependency resolution

my $params = shift || {};

my $zenka_name = $params->{'zenka'} || $params->{'name'};

unless ($zenka_name) {
    return {
        success => FALSE,
        error   => 'zenka name required'
    };
}

<[base.logs]>->( 2, "zenki.start: launching '%s'..,", $zenka_name );

## statistics ##
<zenki.stats.start_requests>++;

## use v7-zenki's dependency resolution system, which already handles: ##
## - ensuring v7-zenki is running [ if needed ]                        ##
## - resolving all dependencies [ cube, .. ]                           ##
## - starting the zenka through the proper jobqueue mechanism          ##
my $result = <[zenki.parent.start_via_v7]>->(
    {   'zenka_name' => $zenka_name,
        'reply_id'   => $params->{'reply_id'}
    }
);

if ( $result->{'success'} ) {
    ## a relayed request is only counted once its reply lands ##
    <zenki.stats.successful_starts>++ if not $result->{'via_ipc'};
} else {
    <zenki.stats.failed_starts>++;
}

return $result;

0;

