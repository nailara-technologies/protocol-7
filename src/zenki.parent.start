## [:< ##

# name = zenki.parent.start
# descr = smart zenka launcher with automatic dependency resolution

my $params = shift || {};

my $zenka_name = $params->{zenka} || $params->{name};

unless ($zenka_name) {
    return {
        success => FALSE,
        error   => 'zenka name required'
    };
}

<[base.log]>->( 2, "zenki.start: launching '$zenka_name'..." );

## Increment statistics
$data{'zenki'}{'stats'}{'start_requests'}++;

## Use v7's dependency resolution system  This automatically handles:
## - Ensuring v7 is running (if needed)
## - Resolving all dependencies (cube, etc.)
## - Starting zenka via proper jobqueue mechanism
my $result = <[zenki.parent.start_via_v7]>->( { zenka_name => $zenka_name } );

if ( $result->{success} ) {
    $data{'zenki'}{'stats'}{'successful_starts'}++;
    return $result;
} else {
    $data{'zenki'}{'stats'}{'failed_starts'}++;
    return $result;
}

0;

