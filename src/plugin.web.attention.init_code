## [:< ##

# name  = plugin.web.attention.init_code
# descr = initialize attention state machine registry and stack

## state stack : ordered list of active states, top is current ##
<web.attention.stack> //= [];

## current blended parameters : updated each tick by blend ##
<web.attention.current_blend> //= {};

## transition state : for smooth interpolation between states ##
<web.attention.transition> //= {
    qw| start_time | => 0,
    qw| from_state | => undef,
    qw| to_state   | => undef,
    qw| t          | => 1.0,
};

## load state definitions ##
my $states = <[plugin.web.attention.states]>;
<web.attention.states> = $states;

## ensure ambient is always at bottom of stack ##
push <web.attention.stack>->@*,
    { qw| name | => qw| ambient |, qw| params | => {} }
    unless <web.attention.stack>->@*;

<[base.log]>->( 2, qq| attention state machine initialized | );

0;

