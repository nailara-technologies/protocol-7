## [:< ##

# name  = plugin.usage.claude.init_code
# descr = claude usage provider plugin : configuration and result cache set-up

my $reinit = shift;

## provider configuration [ never holds credential values -- only where to ##
## read them from at query time ]                                          ##

<usage.provider.claude> //= {};

my $provider = <usage.provider.claude>;

$provider->{'label'}   //= 'Claude rate limits';
$provider->{'enabled'} //= TRUE;
## same reasoning as plugin.usage.kimi.init_code's identical bump : a plain
## successful probe is fast, but the token-rejected path now does a full
## refresh-and-retry cycle inside this same window -- original request + up to
## ~18s for plugin.usage.claude.refresh_token to spawn claude on a real pty
## and let it actually finish refreshing its oauth token + the retried probe.
## usage.query's own guard timer takes the SLOWEST requested provider's
## timeout [ plus a shared grace ], so this only ever widens the overall wait
## when a claude refresh is actually in flight
$provider->{'timeout'}   //= 25;
$provider->{'pending'}   //= {};       ##  in-flight requests by req_id  ##
$provider->{'last'}      //= undef;    ##  parsed numbers, last good query  ##
$provider->{'last_time'} //= 0;

## credential file, relative to the home directory of the unix user this ##
## zenka runs as [ taeki ] -- resolved at query time, not stored here    ##
$provider->{'cred_rel'} //= '.claude/.credentials.json';

## claude cli binary, same relative-to-home convention as
## plugin.usage.kimi.init_code's cli_rel_path -- bin/Protocol-7 cleans
## $ENV{PATH} at zenka startup, so a bare file.which lookup hits the same
## cleaned-PATH wall kimi's does and comes up empty here too
$provider->{'cli_rel_path'} //= '.local/bin/claude';

$provider->{'api_base'} //= $ENV{'ANTHROPIC_BASE_URL'}
    // 'https://api.anthropic.com';

##  cheapest model : the response is discarded, only the headers matter  ##
$provider->{'model'} //= $ENV{'CHECK_USAGE_CLAUDE_MODEL'}
    // 'claude-haiku-4-5-20251001';

## proactive refresh watchdog : best-effort, see plugin.usage.claude.       ##
## refresh_watchdog's note on why claude's expiresAt isn't fully            ##
## trustworthy the way kimi's is -- the reactive 401 path stays the real    ##
## safety net regardless, this just reduces how often it has to fire.  the  ##
## FIRST arm happens in usage.startup instead -- same reasoning as          ##
## plugin.usage.kimi.init_code's identical guard, see its note. on a RELOAD ##
## [ $reinit TRUE, passed directly by base.init_modules ], cancel whatever  ##
## timer is already running and install a fresh one                         ##
$provider->{'proactive_refresh_margin'} //= 60;

if ($reinit) {
    my $old_timer = $provider->{'watchdog_timer'};
    $old_timer->cancel if defined $old_timer and $old_timer->is_active;
    $provider->{'watchdog_timer'} = <[event.add_timer]>->(
        {   'after'   => 0,
            'handler' => qw| plugin.usage.claude.refresh_watchdog |,
            'data'    => {},
        }
    );
}

<[base.log]>->( 1, ': usage provider [ claude ] initialized' );

0;

