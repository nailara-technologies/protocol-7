## [:< ##

# name  = invoke-web.gpu_lease.cmd.yield
# descr = pause rendering and empty the invoke.ai model cache

my ($requester) = split m|\s+|, $call->{'args'} // '';
return { 'mode' => qw| false | } if not length $requester;
my $ok = <[invoke-web.gpu_lease.unload]>->( $requester, qw| handover | );
return { 'mode' => $ok ? qw| true | : qw| false | };

