## [:< ##

# name  = jobsite.handler.assess-timeout
# descr = abort a stalled assessment/repair round-trip, keep the queue draining

my $event = shift;

my $wdata   = eval { $event->w->data } // {};
my $job_id  = $wdata->{'job_id'}       // '';
my $attempt = $wdata->{'attempt'}      // 0;

return unless length $job_id;

## already resolved by a real reply                                        ##
## [ or a newer dispatch already re-armed this job_id's slot in the hash ] ##
## : nothing to do -- this stray fire should be unreachable once ->cancel  ##
## is called at every release/re-arm point, but the check is cheap         ##
## insurance against a firing that was already queued by the event loop    ##
## before cancel took effect                                               ##
return unless delete <jobsite.assess_timer>->{$job_id};

my $job_rec = <jobsite.tasks>->{$job_id};
if (    defined $job_rec
    and $attempt
    and $attempt != ( $job_rec->{'attempt'} // 0 ) ) {
    ## superseded by a newer dispatch [ shouldn't happen given the cancel ##
    ## discipline above, but the newer attempt owns pending_count now ]   ##
    return;
}

## a slow backend is not a lost reply : a cpu-only server needs 8-9 min per ##
## assessment, and giving up while coding still worked on the task made the ##
## next rescan dispatch it a second time [ 2026-10-23 ]. ask task first ;   ##
## the watchdog is re-armed meanwhile, so the job keeps its slot.           ##
## jobsite.handler.assess-watch-reply decides, up to                        ##
## jobsite.cfg.assess_watch_extensions rounds                               ##
if ( defined $job_rec ) {
    my $kind = $job_rec->{'watch_kind'} // qw| assess |;
    my $task_id
        = $kind eq qw| repair |
        ? ( $job_rec->{'repair_task_id'} // '' )
        : ( $job_rec->{'task_id'} // '' );
    my $extensions = $job_rec->{'watch_extensions'}        // 0;
    my $max_ext    = <jobsite.cfg.assess_watch_extensions> // 24;

    if ( length $task_id and $extensions < $max_ext ) {
        <[jobsite.dispatch.arm_watchdog]>->( $job_id, $attempt, $kind );
        $job_rec->{'watch_extensions'} = $extensions + 1;
        <[base.logs]>->(
            1,
            'jss.assess-timeout: job %s no reply '
                . 'yet, asking task %s [ %d of %d ]',
            $job_id,
            $task_id,
            $extensions + 1,
            $max_ext
        );
        <[protocol-7.route-send]>->(
            {   'command'   => 'task.show',
                'call_args' => { 'args' => $task_id },
                'reply'     => {
                    'handler' => 'jobsite.handler.assess-watch-reply',
                    'params'  => {
                        'job_id'  => $job_id,
                        'attempt' => $attempt,
                        'task_id' => $task_id,
                    },
                },
            }
        );
        return;
    }
}

<[jobsite.dispatch.give_up]>->($job_id);

