## [:< ##

# name  = task.fail_task
# param = <task_id> <error>
# descr = mark a pending, claimed or in_progress task as failed : archive,
#         persist, answer a waiting wait-done, record the outcome
# return = { mode, data } [ the task.cmd.fail reply ]

my ( $task_id, $error ) = @ARG;
$error //= '';

my $task = <task.queue>->{$task_id};

return {
    'mode' => 'false',
    'data' => sprintf( 'task %s not found', $task_id )
    }
    unless defined $task;

## pending, claimed, or in_progress tasks can be failed
if (    $task->{'status'} ne 'claimed'
    and $task->{'status'} ne 'pending'
    and $task->{'status'} ne 'in_progress' ) {
    return {
        'mode' => 'false',
        'data' => sprintf(
            'task %s is %s, cannot fail',
            $task_id, $task->{'status'}
        )
    };
}

## update task
my $ntime_b32 = <[base.ntime.b32]>;

$task->{'status'}     = 'failed';
$task->{'result'}     = $error || 'failed';
$task->{'updated_at'} = $ntime_b32;

## move to history, then persist ##
<[task.persist.archive]>->($task_id);
<[task.persist.save]>;

## fire deferred reply for any pending wait-done ##
my $wait_reply_id = delete <task.wait.pending>->{$task_id};
if ( defined $wait_reply_id ) {
    <[base.callback.cmd_reply]>->(
        $wait_reply_id, { 'mode' => 'false', 'data' => "failed: $error" }
    );
}

## record blocked/failed outcome in valued tree ##
## [ only if linked to a node ]                 ##
if ( length( $task->{'node_id'} // '' ) ) {
    <[valued.tree.record_outcome]>
        ->( { 'node_id' => $task->{'node_id'}, 'outcome' => 'blocked' } );
}

<[base.logs]>->( 1, ':. task %s failed: %s', $task_id, $error || 'no error' );

return { 'mode' => 'true', 'data' => "failed $task_id" };

