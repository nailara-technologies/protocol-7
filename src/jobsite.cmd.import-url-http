# name  = jobsite.cmd.import-url-http
# param = url=<url>
# descr = http-facing manual url import : strm+json reply
# note  = bare POST body also accepted, plain text, same format as the
#         console command. same queueing logic as jobsite.cmd.import-url --
#         the httpd web-relay reply handler only builds a real HTTP
#         response for a strm [ or legacy SIZE ] reply, a true/false reply
#         502s over that path

my $args = $call->{'args'} // '';
$args =~ s/^\s+|\s+$//g;

my $result = <[jobsite.cmd.import-url]>->( { 'args' => $args } );

my $ok = ( lc( $result->{'mode'} // '' ) eq qw| true | ) ? 1 : 0;

my $json = eval {
    JSON::XS::encode_json(
        {   'ok'      => $ok ? JSON::XS::true() : JSON::XS::false(),
            'message' => $result->{'data'} // '',
        }
    );
} // '{"ok":false,"message":"encode failed"}';

return {
    'mode'         => qw| strm |,
    'data'         => $json,
    'content_type' => qw| application/json |,
};

