## [:< ##

# name  = models.chat.expand_refs.format_code
# descr = format file content with line numbers for inline expansion
# param = $path    - file path label
# param = $content - file content string
# return = formatted string with numbered lines

my ( $path, $content ) = @ARG;

return $content if $content =~ m{^\[ERROR:};

my @lines  = split( m{\n}, $content );
my $width  = length( scalar(@lines) );
my $result = "\n=== CODE: $path ===\n";

my $line_num = 1;
for my $line (@lines) {
    $result .= sprintf( "%${width}d: %s\n", $line_num++, $line );
}
$result .= "=== END: $path ===\n";

return $result;

0;

