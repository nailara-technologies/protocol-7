## [:< ##

# name  = jobsite.handler.rewire-all
# descr = re-register task.wait-done for all orphaned assessing jobs

my $queue = <jobsite.rewire_queue> // [];

<[base.logs]>->(
    1,
    'rewire-all: processing %d orphaned tasks',
    scalar @{$queue}
);

for my $entry ( @{$queue} ) {
    my $job_id  = $entry->{'job_id'}  // '';
    my $task_id = $entry->{'task_id'} // '';
    next if not length $job_id or not length $task_id;

    <[base.logs]>->( 2, 're-wiring job %s → task %s', $job_id, $task_id );

    ## holds its slot : no watchdog timer survives a restart to say so ##
    ## [ jobsite.dispatch.release_slot ]                               ##
    <jobsite.tasks>->{$job_id}{'rewired'} = TRUE;

    <[protocol-7.route-send]>->(
        {   'command'   => 'task.wait-done',
            'call_args' => { 'args' => $task_id },
            'reply'     => {
                'handler' => 'jobsite.handler.assess-done',
                'params'  => { 'job_id' => $job_id, 'task_id' => $task_id },
            },
        }
    );
}

<jobsite.rewire_queue> = [];

