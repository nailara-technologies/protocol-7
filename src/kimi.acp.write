## [:< ##

# name   = kimi.acp.write
# descr  = send one json-rpc message to the child
# param  = message [ hash ref ]
# return = TRUE | FALSE [ no child ]

## json is an EXTERNAL wire format : encoded here, at the edge, as utf-8 ##
## octets, one message per line                                          ##

my $message = shift;
my $st      = <[kimi.acp.state]>;
return FALSE
    if not defined $st->{'child'}
    or not defined $st->{'child'}{'in'};

$st->{'json'} //= JSON::XS->new->utf8->canonical;
my $line = $st->{'json'}->encode( { 'jsonrpc' => '2.0', %{$message} } );
return <[stream_child.write]>->( $st->{'child'}, "$line\n" );

