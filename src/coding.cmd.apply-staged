## [:< ##

# name  = coding.cmd.apply-staged
# descr = apply staged edits to project source files
# param = [filter]

my $filter = $call->{'args'} // '';

my $staged_dir
    = <system.path.zenka-dirs>->{'var_P7'} . '/'
    . <system.zenka.name>
    . '/staged';

return { 'mode' => qw| false |, 'data' => 'no staged directory' }
    unless -d $staged_dir;

my $dh;
if ( not opendir $dh, $staged_dir ) {
    <[base.logs]>->( 0, ':. apply-staged: cannot open %s', $staged_dir );
    return {
        'mode' => qw| false |,
        'data' => 'cannot read staged directory'
    };
}

my @files = sort grep { $ARG ne '.' and $ARG ne '..' } readdir $dh;
closedir $dh;

return { 'mode' => qw| false |, 'data' => 'no staged edits' } unless @files;

my $root       = <system.root_path>;
my $applied    = 0;
my $skipped    = 0;
my $output     = '';
my $shell_cmds = '';

my $chmod_fh = <coding.chmod_child.w_fh>;    ## privileged child handle ##

for my $staged_name (@files) {
    ## convert staged name back to source path ##
    my $src_rel = $staged_name;
    $src_rel =~ s|__|/|g;

    ## optional filter ##
    next if length $filter and $src_rel !~ m|\Q$filter\E|;

    my $src_path    = "$root/$src_rel";
    my $staged_path = "$staged_dir/$staged_name";

    ## read staged content ##
    my $content_ref = <[file.slurp]>->($staged_path);
    unless ( defined $content_ref ) {
        $output .= sprintf ":. %s : cannot read staged file\n", $src_rel;
        $skipped++;
        next;
    }

    ## create parent directory via chmod child if it doesn't exist ##
    my $src_dir = $src_path;
    $src_dir =~ s|/[^/]+$||;
    if ( !-d $src_dir ) {
        if ( defined $chmod_fh ) {
            print {$chmod_fh} "mkdir $src_dir\n";
            select undef, undef, undef, 0.05;    ## yield for child ##
        } else {
            <[file.make_path]>->($src_dir);
        }
        <[base.logs]>->( 1, "apply-staged: created directory %s", $src_dir )
            if -d $src_dir;
    }

    ## request group-write via privileged chmod child if needed ##
    my $mode_restore;
    if ( defined $chmod_fh and -f $src_path and not -w $src_path ) {
        my $fstat    = File::stat::stat($src_path);
        my $cur_mode = $fstat->mode & 07777;
        print {$chmod_fh} "gw $src_path\n";
        ## brief yield for child to process chmod ##
        select undef, undef, undef, 0.01;
        if ( -w $src_path ) {
            $mode_restore = $cur_mode;
        }
    }

    ## write to source path ##
    my $written = <[file.put]>->( $src_path, $content_ref );

    ## restore original file permissions via chmod child ##
    if ( defined $mode_restore and defined $chmod_fh ) {
        print {$chmod_fh} sprintf "restore %04o %s\n",
            $mode_restore, $src_path;
    }

    if ($written) {
        $output .= sprintf ":. %s : applied [ %d bytes ]\n",
            $src_rel, length $content_ref->$*;
        $applied++;
        ## remove staged file after successful apply ##
        unlink $staged_path;
    } else {
        ## direct write failed - emit shell command as fallback ##
        $output .= sprintf ":. %s : no write access [ %d bytes ]\n",
            $src_rel, length $content_ref->$*;
        $shell_cmds .= sprintf "cp -v '%s' '%s'\n", $staged_path, $src_path;
        $skipped++;
    }
}

if ( length $shell_cmds ) {
    $output .= sprintf "\n## run as project owner to apply %d file%s ##\n",
        $skipped, $skipped == 1 ? '' : 's';
    $output .= $shell_cmds;
}

$output .= sprintf "\n## %d applied, %d skipped ##\n", $applied, $skipped;

return { 'mode' => qw| size |, 'data' => $output };

