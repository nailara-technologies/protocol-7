## [:< ##

# name  = nameserv.dns_probe.address
# param = <addr> | <a.b.c.d:port> | <[v6]:port>
# descr = canonical probe server address with optional port

my $server  = shift // return undef;
my $address = $server;
my $suffix  = '';
if ( $server =~ m{^\[(.+)\](:\d+)$} ) {
    ( $address, $suffix ) = ( $1, $2 );
} elsif ( $server =~ m{^([\d.]+)(:\d+)$} ) {
    ( $address, $suffix ) = ( $1, $2 );
}
my $canonical = <[nameserv.upstream_address]>->($address) // return undef;
return $canonical if not length $suffix;
return index( $canonical, qw| : | ) >= 0
    ? "[$canonical]$suffix"
    : "$canonical$suffix";

