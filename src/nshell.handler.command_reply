## [:< ##

# name = nshell.handler.command_reply
# descr = process and display cube command replies to terminal and history

my $reply = shift // return FALSE;

return FALSE unless defined $reply;

my $cmd = $reply->{'cmd'} // '';

## delegate STRM replies to dedicated stream handler
return <[nshell.handler.strm_reply]>->($reply)
    if $cmd =~ m|^STRM\b|;

## extract reply components [ already parsed by base.handler.command ]
my $args = $reply->{'call_args'}->{'args'} // '';    # content from call_args
my $payload_str = $reply->{'data'};    # raw payload for multi-line replies

### logging to terminal-history with endline padding ###
## precede with blank line, log reply type and args with two-space prefix,
## then payload [if present], then blank line

## encode control characters for safe history storage
my $encoded_args = <[nshell.parser.term_encode]>->($args);
my $encoded_payload
    = defined $payload_str
    ? <[nshell.parser.term_encode]>->($payload_str)
    : undef;

## blank line before reply
<[base.buffer.add_line]>->( qw| terminal-history |, '' );

## reply type and args with two-space prefix
<[base.buffer.add_line]>->(
    qw| terminal-history |,
    sprintf '  %s %s',
    $cmd, $encoded_args
);

## log data payload if present [SIZE, STRM, ..] - also with two-space prefix
if ( defined $encoded_payload ) {
    map {
        <[base.buffer.add_line]>->(
            qw| terminal-history |,
            sprintf '  %s', $ARG
        )
    } split "\n", $encoded_payload;
}
## blank line after reply
<[base.buffer.add_line]>->( qw| terminal-history |, '' );

## print to console [STDOUT] and handle cursor display
#
## [ clear current line if a history entry is displayed, so reply appears
## clean -- skipped in split mode : \r-relative, would clear whatever row the
## cursor currently rests on [ the input row ], not a history display ]
my $_nshell_state = <nshell.state> // {};
print "\r\e[2K"
    if $_nshell_state->{'current_mode'} == 2
    and length( $_nshell_state->{'display_buffer'} // '' )
    and not $_nshell_state->{'split_active'};

my $cursor_mode = <nshell.cfg.cursor_after_reply> // 'all';

## if the current display mode declares a plugin, let it react to this      ##
## reply BEFORE anything prints -- e.g. plugin.nshell.coding-session        ##
## catches a coding.submit ack here, binds the task id to this tab, and     ##
## queues the follow-up subscribe-session command. core stays               ##
## plugin-agnostic.                                                         ##
##                                                                          ##
## MUST run regardless of which branch below fires : coding.submit's own    ##
## ack is a SIZE-mode reply, not a TRUE-mode one [ confirmed via            ##
## base.handler.command.process_reply's unknown-reply-route hook call -- it ##
## only passes 'data' => undef for TRUE/FALSE/WAIT/GET/TERM, but a real     ##
## extracted payload for SIZE/STRM/CHRSIZE/STRM-SIZE ], so it always took   ##
## the payload_str-defined [ else ] branch below and never reached the      ##
## plugin call that used to live only in the single-line branch -- task_id  ##
## was never bound, so neither auto-subscribe nor Esc-abort ever fired.  a  ##
## truthy result means the plugin fully claimed this reply's own display [  ##
## e.g. hide the raw ack, subscribe-session's own STRM reply takes over the ##
## content area next ] -- suppress the normal print in that case.           ##
## session-wide suppress, checked BEFORE the mode-scoped plugin dispatch    ##
## below -- on_ctrl_c switches display_mode_index back to shell             ##
## SYNCHRONOUSLY, right after queuing its own abort-inference command, but  ##
## that command's reply only arrives LATER [ async ] -- by then the current ##
## mode has no plugin at all, so a suppress flag living on the              ##
## coding-session mode object [ as on_escape's still does, safely, since    ##
## on_escape never changes the mode ] would never get consulted. a flag on  ##
## shared nshell state survives the mode switch instead. confirmed live     ##
## 2026-09-14 : Ctrl+C between rounds still printed "no active inference    ##
## task" despite on_ctrl_c setting a suppress flag -- it was on the wrong   ##
## object.                                                                  ##
my $plugin_claimed = delete $_nshell_state->{'suppress_next_wire_reply'};

my $modes = $_nshell_state->{'display_modes'};
my $mode
    = ref $modes eq 'ARRAY'
    ? $modes->[ $_nshell_state->{'display_mode_index'} // 0 ]
    : undef;
my $plugin_name = defined $mode ? $mode->{'plugin'} : undef;

if ( not $plugin_claimed and length( $plugin_name // '' ) ) {
    $plugin_claimed = $code{$plugin_name}->(
        {   'hook' => 'on_reply',
            'mode' => $mode,
            'text' => ( defined $payload_str ? $payload_str : $args )
        }
    );
}

## route all reply text through nshell.render.content_print rather than a   ##
## bare print : in split mode the real cursor rests at the pinned input row ##
## between renders [ nshell.render.viewport's convention -- it jumps there  ##
## and never restores away ], so a bare print here would land on top of the ##
## input line instead of the content area above it. plain print when not in ##
## split mode, identical to the old behaviour.                              ##
if ( not defined $payload_str ) {

    ## single-line reply : colorize and print to console for immediate display
    ## TRUE replies  : standard text color [p7_fg_0004]  FALSE replies :
    ## emphasis color [p7_fg_0003]
    my $reply_color
        = ( $cmd eq 'FALSE' ) ? $colors{'p7_fg_0003'} : $colors{'p7_fg_0004'};

    ## suppressed when the plugin fully claimed this reply -- e.g. a       ##
    ## coding.submit ack whose only useful content [ the task id ] the     ##
    ## plugin already consumed to bind the tab and queue subscribe-session ##
    <[nshell.render.content_print]>->(
        sprintf "\n%s%s\e[0m%s\n\n",
        $reply_color, $args, $colors{'p7_fg_0004'}
    ) unless $plugin_claimed;

    ## re-display cursor after single-line reply output
    if ( $cursor_mode eq 'line' or $cursor_mode eq 'all' ) {
        if ( $_nshell_state->{'split_active'} ) {
            <[nshell.render.viewport]>->(
                $_nshell_state->{'editor'}, \%colors
            );
        } else {
            print "\r"
                . $colors{'p7_fg_0003'}
                . "_\e[K\r" . "\e[0m"
                . $colors{'p7_fg_0004'};
        }
    }

} else {    ## print multi-line output directly without padding to console

    ## suppressed when the plugin fully claimed this reply -- this is the ##
    ## branch coding.submit's own SIZE-mode ack actually takes [ see the  ##
    ## plugin-dispatch comment above ], so this is the case that matters  ##
    ## most for hiding the raw ack in favour of the live stream that      ##
    ## follows it                                                         ##
    unless ($plugin_claimed) {

        ## payload printed bare relied on ambient SGR rather than carrying  ##
        ## its own color -- looked fine live [ ambient really was blue at   ##
        ## print time ] but nshell.render.content_print also accumulates    ##
        ## every string it's given into the mode's own replay buffer [      ##
        ## $modes->[$index]{buffer} ], and THAT gets blasted out in one     ##
        ## `print $replay` shot by nshell.handler.term_resize [ and by      ##
        ## nshell.display.cycle on a focus switch ] -- no per-call ambient  ##
        ## reassertion in between, so a bare colorless payload sitting      ##
        ## after an earlier bare-reset [ same sibling fix as the            ##
        ## 'true'/'false' branch above ] replays permanently colorless on   ##
        ## the NEXT resize even though it looked correct up to that point.  ##
        ## confirmed live 2026-09-14 : a redo-round replay lost its blue    ##
        ## specifically after a terminal font-size change, restored only by ##
        ## doing another fresh redo [ new live print, not a fix to the      ##
        ## already-corrupted buffered copy ]. same failure shape            ##
        ## nshell.handler.strm_reply's round-marker fix already found for   ##
        ## STRM chunks -- never assume ambient, always carry payload color  ##
        ## explicitly                                                       ##
        <[nshell.render.content_print]>->( $colors{'p7_fg_0004'}
                . $payload_str . "\e[0m"
                . $colors{'p7_fg_0004'} );

        ## track whether payload had no trailing newline  next prompt will add
        ## separation if needed
        if ( $payload_str !~ m{\n\z} ) {
            <nshell.state>->{'needs_newline_prefix'} = TRUE;
        } else {
            delete <nshell.state>->{'needs_newline_prefix'};
        }
    }

    ## redraw cursor after SIZE/payload reply if configured -- skipped      ##
    ## entirely when claimed : nothing was printed above to reposition      ##
    ## past, and the subscribe-session dispatch the plugin just queued will ##
    ## render [ and redraw the cursor itself ] as soon as its own reply     ##
    ## arrives                                                              ##
    if ( $cursor_mode eq 'all' and not $plugin_claimed ) {
        if ( $_nshell_state->{'split_active'} ) {
            <[nshell.render.viewport]>->(
                $_nshell_state->{'editor'}, \%colors
            );
            delete <nshell.state>->{'needs_newline_prefix'};
        } else {
            print "\n"
                if $payload_str !~ m{\n\z};
            print "\r"
                . $colors{'p7_fg_0003'}
                . "_\e[K\r" . "\e[0m"
                . $colors{'p7_fg_0004'};
            delete <nshell.state>->{'needs_newline_prefix'};
        }
    }
}

## [ re-display history entry if reply arrived while in VIEWING_HISTORY mode ]
my $nshell_state = <nshell.state> // {};
if ( $nshell_state->{'current_mode'} == 2
    and length( $nshell_state->{'display_buffer'} // '' ) ) {
    print "\r\e[2K" unless $nshell_state->{'split_active'};
    $nshell_state->{'view_offset'} = 0;
    <[nshell.render.viewport]>->( $nshell_state->{'editor'}, \%colors );
}

STDOUT->flush();

return TRUE;

