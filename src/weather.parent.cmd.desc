## [:< ##

# name  = weather.parent.cmd.desc
# descr = return local weather short description text

my $stid = <weather.station_id>;

## first data still pending [ on-demand start ] : answer when it lands ##
my $parked = <[weather.parent.park_pending]>->( $call, qw| desc | );
return $parked if defined $parked;

my $current = <weather.data>->{$stid}->{'current'};

return {
    'mode' => qw| false |,
    'data' => 'no city selected (undefined station id)'
    }
    if not defined $stid;

my $descr = $current->{'descr'} // 'n|a';

return { 'mode' => qw| true |, 'data' => $descr }

