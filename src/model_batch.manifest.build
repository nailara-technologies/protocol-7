## [:< ##

# name  = model_batch.manifest.build
# descr = checksum manifest of the repo tree : { relpath => checksum }
# note  = checksum only, no packing -- packing happens lazily via
#         model_batch.blob.store for paths a capture actually needs

my $root_path = shift // <system.root_path>;

$root_path = canonpath($root_path);

## walk primitive reused from the sourcecode/ncode corpus family :
## base.file.all_files is the same recursive opendir/readdir walk
## base.source.collect_file_list delegates its directory recursion to.
## collect_file_list's own git check-ignore stage is deliberately NOT reused
## -- this harness never invokes git [ option D, 2026-09-21 ].
my $files_aref = <[file.all_files]>->( $root_path, qw| recursive | ) // [];

my %manifest;
my %real_dir;    ## dir -> its realpath, cached [ one lookup per dir ] ##
my $real_root = Cwd::abs_path($root_path) // $root_path;

for my $abs_path ( $files_aref->@* ) {
    my $rel_path = $abs_path;
    $rel_path =~ s|^\Q$root_path\E/||;

    ## symlinks are out of scope : a symlinked file or a path below a     ##
    ## symlinked dir [ context.yaml -> data/yaml ] hashes its target a    ##
    ## second time, and a restore through rename replaced the link with a ##
    ## regular file [ README.md, 2026-10-10 ]. the target is in the       ##
    ## manifest under its own path                                        ##
    next if -l $abs_path;
    my ($dir_path) = $abs_path =~ m|^(.*)/[^/]+$|;
    $real_dir{$dir_path} //= Cwd::abs_path($dir_path) // '';
    ## compared below the real root : a symlinked checkout root is fine ##
    ( my $expect_dir = $dir_path ) =~ s|^\Q$root_path\E|$real_root|;
    next if $real_dir{$dir_path} ne $expect_dir;

    ## exclude .git/ [ and every other dot-dir or dotted file, matching the ##
    ## corpus walker's own filter ] and backup-editor tails                 ##
    next if $rel_path =~ m{(?:^|/)\.[^/]*} or $rel_path =~ m{~$};

    ## exclude the state/ dir itself : batch state never belongs to the ##
    ## tree it describes                                                ##
    next if $rel_path =~ m{^state/};

    ## unreadable paths are out of scope, same as .git/state above --       ##
    ## cleanly caught here [ house policy: every warning is a bug to fix or ##
    ## a condition to catch, never routine noise ] so filesum is never      ##
    ## called on a path it would have to warn about. a                      ##
    ## permanently-unreadable file [ wrong owner/mode ] would otherwise     ##
    ## warn on EVERY gate/manifest walk -- batch start and every candidate  ##
    ## boundary -- found live 2026-09-21 against a stray owner-private      ##
    ## editor-crash file                                                    ##
    next unless -r $abs_path;

    ## large files are out of scope [ model files up to ~1 GB live in the ##
    ## tree, a task never edits them ] : not hashed at every gate, never  ##
    ## packed -- same cap as model_batch.blob.store                       ##
    next
        if -s $abs_path > ( <model_batch.cfg.blob_max_bytes> // 8 * 1024**2 );

    my $checksum = <[chk-sum.bmw.filesum]>->( 384, $abs_path );
    next unless defined $checksum and length $checksum;

    $manifest{$rel_path} = $checksum;
}

return \%manifest;

