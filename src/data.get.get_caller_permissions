# name = data.get.get_caller_permissions
# descr = Determine calling zenka's permissions

my $caller_zenka = <caller.zenka> // 'unknown';
return ['all']                   if $caller_zenka eq 'root';
return [ $caller_zenka, 'auth' ] if <caller.authenticated>;
return ['public'];

