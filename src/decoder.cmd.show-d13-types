# name  = decoder.cmd.show-d13-types
# descr = show d13 type-prefix decode histogram

my $types = $data{'decoder'}{'d13_types'} // {};

return { 'mode' => qw| false |, 'data' => 'no d13 chunks decoded yet' }
    unless keys %{$types};

my $total = 0;
$total += $ARG for values %{$types};

my @lines
    = sprintf( "d13 type-prefix histogram " . ": %d decoded chunks", $total );
push @lines, '';

for my $type ( sort keys %{$types} ) {
    push @lines,
        sprintf( "  %-4s : %6d  [ %.1f%% ]",
        $type, $types->{$type}, 100 * $types->{$type} / $total );
}

return { 'mode' => qw| size |, 'data' => join( "\n", @lines ) };

