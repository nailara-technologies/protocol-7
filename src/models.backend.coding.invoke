## [:< ##

# name  = models.backend.coding.invoke
# descr = submit to coding zenka with dynamic system message
# param = $params [messages, reply_id, handler, sender, model, template]
# return = nothing (response handled by callback)

my $params = shift;

my $messages        = $params->{'messages'}       // [];
my $participant     = $params->{'participant_id'} // 'unknown';
my $reply_id        = $params->{'reply_id'}       // '';
my $handler         = $params->{'handler'}        // '';
my $sender          = $params->{'sender'}         // '';
my $model           = $params->{'model'}          // $participant;
my $system_template = $params->{'system_template'}
    // 'cfg/models/system-messages/coding-assistant.tmpl';

## render dynamic system message from template ##
my $system_message  = '';
my $template_result = <[web.cmd.render-template]>->(
    {   template_path => $system_template,
        meta          => { model => $model, sender => $sender },
        budget        => 2000,    ## ~2000 tokens for system message
        session_id    => "coding_invoke_$reply_id",
    }
);

if ( $template_result->{status} eq qw| success | ) {
    $system_message = $template_result->{content};
    <[base.log]>->(
        2,
        "[coding.invoke] system message rendered "
            . "($template_result->{elapsed_ms}ms, "
            . length($system_message)
            . " chars)"
    );
} else {
    <[base.log]>->(
        1, "[coding.invoke] render failed: " . $template_result->{message}
    );
    ## fall back to minimal system message ##
    $system_message = 'you are a protocol-7 coding assistant.';
}

## prepend system message to messages array ##
my @enhanced_messages
    = ( { role => 'system', content => $system_message }, @$messages );

# Convert messages array to prompt string for coding
my $prompt = <[models.chat.messages_to_prompt]>->( \@enhanced_messages );

# Base32r encode to handle multiline prompts via single-line command
my $encoded_prompt = '';
if ( length($prompt) ) {
    ## Use Crypt::Misc for base32r encoding
    eval { $encoded_prompt = Crypt::Misc::encode_b32r($prompt); };
    if ( $@ || !length($encoded_prompt) ) {
        <[base.logs]>->(
            0,
            '[coding.invoke] base32r encoding failed: %s',
            $@ // 'unknown'
        );
        $encoded_prompt = '';    # Will trigger error below
    }
}

unless ( length($encoded_prompt) ) {
    my $error = ':. error: empty prompt :.';
    <[models.chat.append]>->( undef, $model, $error );
    my $entries = <[models.chat.get_recent]>->(3);
    my $output  = <[models.chat.format_buffer]>->($entries);
    if ( length($reply_id) ) {
        <[base.callback.cmd_reply]>->(
            $reply_id, { 'mode' => 'size', 'data' => $output }
        );
    }
    return;
}

# Submit to coding via ask-reply command
# The reply will come to coding_result_forward which will call our handler
my $sent_count = <[protocol-7.command.send.local]>->(
    {   'command'   => qw| cube.coding.ask-reply |,
        'call_args' => { 'args' => $encoded_prompt },
        'reply'     => {
            'handler' => 'models.handler.coding_result_forward',
            'params'  => {
                'original_reply_id' => $reply_id,
                'sender'            => $sender,
                'model'             => $model,
                'participant_id'    => $participant,
            }
        }
    }
);

if ( $sent_count <= 0 ) {
    <[base.logs]>->(
        0, '[coding.invoke] failed to send: sent_count=%d', $sent_count
    );
    my $error = ':. error: coding system not reachable :.';
    <[models.chat.append]>->( undef, $model, $error );
    my $entries = <[models.chat.get_recent]>->(3);
    my $output  = <[models.chat.format_buffer]>->($entries);
    if ( length($reply_id) ) {
        <[base.callback.cmd_reply]>->(
            $reply_id, { 'mode' => 'size', 'data' => $output }
        );
    }
    return;
}

<[base.logs]>->(
    2, '[coding.invoke] submitted: participant=%s handler=%s sent_to=%d',
    $participant, $handler, $sent_count
);

return;

