## [:< ##

# name  = v7-zenki.sys_deps.scan
# descr = cached zenki dependency scan [ pm + os ] : one tree scan per
#         v7-zenki init [ dropped on reinit by v7-zenki.init_code ]

my $cached = <v7-zenki.sys_deps.scan>;
return $cached if defined $cached;

<[base.perlmod.load]>->('AMOS7::deps::module')
    if not <[base.perlmod.loaded]>->('AMOS7::deps::module');
<[base.perlmod.load]>->('AMOS7::deps::os_package')
    if not <[base.perlmod.loaded]>->('AMOS7::deps::os_package');

my $scan = {
    qw| pm | => AMOS7::deps::module::scan_zenki_pm_deps(<system.root_path>),
    qw| os | => AMOS7::deps::os_package::scan_zenki_os_deps(
        <system.conf_path> . qw| /zenki |
    )
};

<v7-zenki.sys_deps.scan> = $scan;

return $scan;

