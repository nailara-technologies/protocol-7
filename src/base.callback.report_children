## [:< ##

# name = base.callback.report_children

return if not exists <system.report_children> or !@{<system.report_children>};

return warn 'zenka not initialized' if !<system.zenka.initialized>;

my $route_str = <system.net.cube_route> // qw| cube |;
$route_str .= '.' if length($route_str);

my @pending = <system.report_children>->@*;
<system.report_children>->@* = ();    ## clear before sending ##

map {
    <[base.logs]>->( 1, "reporting child process [PID:%d] to 'v7'", $ARG );
    <[protocol-7.command.send.local]>->(   ## [LLL] use new route-send command
        {   'command'   => "${route_str}v7.register_child",
            'call_args' => { 'args' => $ARG }
        }
    );
} @pending;

