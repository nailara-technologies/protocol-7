## [:< ##

# name = base.callback.report_children

return
    if not exists <system.report_children> or !<system.report_children>->@*;

return warn 'zenka not initialized' if !<system.zenka.initialized>;

my $route_str = <system.net.cube_route> // qw| cube |;
$route_str .= '.' if length($route_str);

my @pending = <system.report_children>->@*;
<system.report_children>->@* = ();    ## clear before sending ##

map {
    <[base.logs]>->(
        1, "reporting child process " . "[PID:%d] to 'v7-zenki'", $ARG
    );
    <[protocol-7.command.send.local]>->(   ## [LLL] use new route-send command
        {   'command' => "${route_str}v7-zenki.register_child",
            ## parent_pid is THIS process's own pid, given directly rather
            ## than left for v7 to re-derive later via a live /proc lookup --
            ## the round trip through cube is async, and if the immediate
            ## parent [ eg a transient shell wrapping a piped-open spawn ]
            ## exits before v7 gets to look, the child has already been
            ## reparented to init and the real relationship is unrecoverable
            'call_args' => { 'args' => "$ARG $PID" },  ## child_pid parent_pid
            'reply'     => {
                'handler' => qw| base.callback.report_children_reply |,
                'params'  => { 'pid' => $ARG }
            }
        }
    );
} @pending;

