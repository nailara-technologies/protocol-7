## [:< ##

# name  = cube.cmd.zenka-heartbeat
# param = set <sid> <name> <timeout_secs> | del <sid>
# descr = register sessions v7-zenki already monitors

my $re = <regex.base>;

my $args = defined $call->{'args'} ? $call->{'args'} : '';
$args =~ s{^\s+|\s+$}{}g;

return {
    'mode' => qw| false |,
    'data' => 'expected set <sid> <name> <timeout_secs> or del <sid>'
    }
    if !length $args;

my ( $cmd, $sid, $zenka_name, $timeout, $extra ) = split m|\s+|, $args;

return { 'mode' => qw| false |, 'data' => 'too many arguments' }
    if defined $extra;

return { 'mode' => qw| false |, 'data' => 'invalid session id' }
    if not defined $sid
    or $sid !~ m|^\d+$|;

if ( $cmd eq qw| set | ) {
    return { 'mode' => qw| false |, 'data' => 'invalid zenka name' }
        if not defined $zenka_name
        or $zenka_name !~ m|^$re->{'usr_str'}$|;
    return {
        'mode' => qw| false |,
        'data' => 'timeout must be zero [ no heartbeat ] or a positive number'
        }
        if not defined $timeout
        or $timeout !~ m{^(?:\d+(?:\.\d+)?|\.\d+)$};

    <zenki.heartbeat>->{$sid} = {
        'name'    => $zenka_name,
        'timeout' => $timeout,
        'set_at'  => time
    };
    return {
        'mode' => qw| true |,
        'data' => "heartbeat registration set for session $sid"
    };
} elsif ( $cmd eq qw| del | ) {
    return { 'mode' => qw| false |, 'data' => 'invalid arguments' }
        if defined $zenka_name;
    return {
        'mode' => qw| false |,
        'data' => "session $sid is not registered"
        }
        if not exists <zenki.heartbeat>->{$sid};

    delete <zenki.heartbeat>->{$sid};
    return {
        'mode' => qw| true |,
        'data' => "heartbeat registration removed for session $sid"
    };
}

return { 'mode' => qw| false |, 'data' => 'expected set or del' };

