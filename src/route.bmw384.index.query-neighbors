# name  = route.bmw384.index.query-neighbors
# args  = $name, $radius
# descr = find nodes near given node excluding the node itself

my $name   = shift;
my $radius = shift;

if ( not defined $name or not defined $radius ) {
    <[base.logs]>->( 1, 'node name and radius required <{C1}>' );
    return undef;
}

my $coord = <[route.bmw384.index.lookup]>->($name);

if ( not defined $coord ) {
    <[base.logs]>->( 1, "node '%s' not found in index <{C1}>", $name );
    return undef;
}

my $all = <[route.bmw384.index.query-radius]>->( $coord, $radius );

my @filtered;
for my $ARG (@$all) {
    push @filtered, $ARG if $ARG->{'name'} ne $name;
}

return \@filtered;

