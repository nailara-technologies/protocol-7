## [:< ##

# name  = mpv.cmd.append-play
# param = <file|url>
# descr = add a file to current playlist [starts playback]

my $file = $call->{'args'} // '';

return { 'mode' => qw| false |, 'data' => 'expected path or url' }
    if !length($file);

push <mpv.reply_ids>->@*, $call->{'reply_id'};
<mpv.success_reply_str> = 'added to playlist';

<[mpv.send_command]>->( qw| loadfile |, $file, qw| append-play | );

return { 'mode' => qw| deferred | };

