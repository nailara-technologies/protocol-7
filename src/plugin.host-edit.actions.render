## [:< ##

# name  = plugin.host-edit.actions.render
# descr = host-actions tab display -- the fixed add-host \ cancel row
# param = $editor_state, $field

## fires on EVERY render regardless of mode [ editor.control.
## get_display_value calls display_override unconditionally ].  the running
## flow is shown by the 'action state' row [ render_state ], not here.  while
## an in-frame  prompt anchored to THIS field is open [ the masked owner-key
## passphrase stage ], the row IS the prompt : label + live buffer content +
## cursor, drawn by prompt.render -- same delegation
## plugin.user-edit.key-actions.render makes.
##
## ONE composed line, no leading/trailing space : render_form's generic body
## wrap plus its pad_l/pad_r framing already supply that

my ( $editor_state, $field ) = @ARG;

my $prompt_display
    = <[editor.control.prompt.render]>->( $editor_state, $field );

return $prompt_display if defined $prompt_display;

my $in_tab_mode
    = (
    ( $editor_state->{'mode'} // '' ) eq sprintf( qw| plugin:%s |, $field ) );

## a FIXED row : the flow step \ status and the pin are the 'action state' row
## below [ plugin.host-edit.actions.render_state ] -- changing text here
## widened the whole frame on every status [ found live ]
my $body = join q| .:. |,
    sprintf( q|%s [Enter]|, $in_tab_mode ? q|*add host*| : q|add host| ),
    q|[c]ancel|;

return sprintf( q{<<< %s >>>}, $body ) if $in_tab_mode;

return sprintf( q{'->  %s}, $body );

