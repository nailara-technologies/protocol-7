## [:< ##

# name  = valued.cmd.stats
# descr = valued tree stats [ total, avg, highest, lowest ]

my @nodes;

## iterate all nodes in valued.index ##
foreach my $id ( keys %{<valued.index>} ) {
    my $priority = <[valued.resolve]>->($id);
    push @nodes, { 'id' => $id, 'priority' => $priority };
}

my $total = scalar @nodes;

return { 'mode' => 'size', 'data' => 'no nodes' } unless $total;

my @sorted = sort { $b->{'priority'} <=> $a->{'priority'} } @nodes;

my $sum = 0.0;
$sum += $ARG->{'priority'} foreach @sorted;

my $avg     = $sum / $total;
my $highest = $sorted[0];
my $lowest  = $sorted[-1];

my $output = sprintf
    'nodes : %d  avg : %.2f  highest : %s [%.2f]  lowest : %s [%.2f]',
    $total, $avg,
    $highest->{'id'}, $highest->{'priority'},
    $lowest->{'id'},  $lowest->{'priority'};

return { 'mode' => qw| true |, 'data' => $output };

