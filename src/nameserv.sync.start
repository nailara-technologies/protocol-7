## [:< ##

# name  = nameserv.sync.start
# descr = start stage-2 sync sides enabled by config [ silent otherwise ]

## listener side : only with sync.listen = yes [ checked there ] ##
<[nameserv.sync.listen]>;

## peer side : one long-poll per configured peer  always called : an empty ##
## list ends every running peer loop                                       ##
my $peers = <nameserv.cfg.sync.peers> // '';
<[nameserv.sync.peers.start]>->($peers);

## a config reload rebuilds the peer loops from the new value ##
<callbacks.config_reloaded> //= [];
push <callbacks.config_reloaded>->@*, qw| nameserv.sync.peers.start |
    if not grep { $ARG eq qw| nameserv.sync.peers.start | }
    <callbacks.config_reloaded>->@*;

## a grant-set change re-pulls once the zones it newly covers ##
<[nameserv.sync.grants.renew]>;

return TRUE;

