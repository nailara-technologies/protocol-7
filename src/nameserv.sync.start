## [:< ##

# name  = nameserv.sync.start
# descr = start stage-2 sync sides enabled by config [ silent otherwise ]

## listener side : only with sync.listen = yes [ checked there ] ##
<[nameserv.sync.listen]>->();

## peer side : one long-poll per configured peer ##
my $peers = <nameserv.cfg.sync.peers> // '';
<[nameserv.sync.peers.start]>->($peers) if length $peers;

return TRUE;

