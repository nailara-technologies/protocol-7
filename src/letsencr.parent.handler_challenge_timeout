## [:< ##

# name  = letsencr.parent.handler_challenge_timeout
# descr = handle challenge timeout - clean up unvalidated challenges

my $challenge_data = shift;

my $token  = $challenge_data->{'token'}  // '';
my $domain = $challenge_data->{'domain'} // '';

<[base.s_warn]>->('expected hash ref with token and domain parameter')
    if not length $token or not length $domain;

<[base.logs]>->(
    2,      'challenge timeout handler : token=%s domain=%s',
    $token, $domain
);

if ( exists <letsencr.parent.pending_challenges>->{$token} ) {
    my $challenge = <letsencr.parent.pending_challenges>->{$token};

    ## check if challenge has been validated
    if ( $challenge->{status} eq qw| valid | ) {
        <[base.logs]>->(
            2, 'challenge was validated before timeout, keeping record'
        );
        return FALSE;
    }

    ## challenge has timed out - remove it
    <[base.logs]>->(
        1,      'challenge timeout: token=%s domain=%s [ no validation ]',
        $token, $domain
    );

    <[letsencr.parent.activity_logger]>->(
        'challenge', $domain, 'failed',
        'challenge validation timeout [ 5 minutes ]'
    );

    delete <letsencr.parent.pending_challenges>->{$token};

    ## notify HTTPd to remove the challenge file
    <[base.logs]>->(
        2, 'requesting HTTPd to clean up challenge for %s', $domain
    );

    ## [ parameters as space-separated args: domain token ]
    <[protocol-7.command.send.local]>->(
        {   'command'   => qw| httpd.cmd.remove-acme-challenge |,
            'call_args' => { 'args' => join ' ', $domain, $token }
        }
    );

} else {
    <[base.logs]>->( 3, 'token %s not found in pending challenges', $token );
}

return FALSE;

