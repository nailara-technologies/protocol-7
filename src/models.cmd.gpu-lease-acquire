# name  = models.cmd.gpu-lease-acquire
# descr = request the gpu residency lease

my ( $owner, $need_mb ) = split m|\s+|, $call->{'args'} // '';
my $ok = <[models.gpu_lease.acquire]>->( $owner // '', $need_mb // 0 );
return {
    'mode' => $ok ? qw| true | : qw| false |,
    'data' => $ok ? 'granted'  : 'pending or refused'
};

