# name  = nameserv.cache.client_allowed
# descr = loopback-only client check for the forwarding dns cache

## enforced in code for every query : no open resolver, ever ##

my $ip = shift // return FALSE;

return TRUE if $ip =~ m|^127\.\d{1,3}\.\d{1,3}\.\d{1,3}$|;
return TRUE if $ip eq qw| ::1 |;
return TRUE if $ip =~ m|^::ffff:127\.\d{1,3}\.\d{1,3}\.\d{1,3}$|i;

return FALSE;

