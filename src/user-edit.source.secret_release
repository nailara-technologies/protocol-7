# name  = user-edit.source.secret_release
# descr = sessions-zenka sender : release a held secret back
# param = $hold_name, $reply_handler

## the secret half of the record source behind <form.source> -- releases a
## name previously held via user-edit.source.secret_hold.  today only the
## standalone roundtrip harness [ form.console.test-secret-roundtrip ] sends
## releases ; a real form submit only ever HOLDS

my ( $hold_name, $reply_handler ) = @ARG;

my $cube_sid = <form.cube_sid> // return FALSE;

return <[protocol-7.command.send.local]>->(
    {   qw| command |   => sprintf( '%d.sessions.release', $cube_sid ),
        qw| call_args | => { qw| args |    => $hold_name // '' },
        qw| reply |     => { qw| handler | => $reply_handler }
    }
);

