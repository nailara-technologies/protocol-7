## [:< ##

# name  = nameserv.sync.peer.arm
# descr = open the long-poll connection of one sync peer

my $key = shift // return;
$key = $key->w->data if ref $key;    ## timer handlers get the event ##

my $peers = <nameserv.sync.peers> // return;
my $peer  = $peers->{$key}        // return;

return if $peer->{'state'} ne qw| idle |;

## resolve to an ordered address list [ ipv6 first ] : one getaddrinfo per ##
## connect attempt is acceptable [ see nameserv.sync.addresses ]           ##
my $addrs = <[nameserv.sync.addresses]>->( $peer->{'host'}, $peer->{'port'} );

if ( not scalar @$addrs ) {
    <[nameserv.sync.peer.fail]>->(
        $key, sprintf 'resolve : %s',
        <[base.str.os_err]>
    );
    return;
}

## the address that worked last time is tried first ##
my $worked = $peer->{'addr_worked'};
if ( length( $worked // '' ) ) {
    @$addrs = (
        ( grep { $ARG->{'host'} eq $worked } @$addrs ),
        ( grep { $ARG->{'host'} ne $worked } @$addrs )
    );
}

$peer->{'addrs'}    = $addrs;
$peer->{'addr_idx'} = -1;       ## next-addr advances before each attempt ##

<[nameserv.sync.peer.next-addr]>->($key);

return TRUE;

