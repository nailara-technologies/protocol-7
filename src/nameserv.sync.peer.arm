## [:< ##

# name  = nameserv.sync.peer.arm
# descr = open the long-poll connection of one sync peer

my $key = shift // return;

my $peers = <nameserv.sync.peers> // return;
my $peer  = $peers->{$key}        // return;

return if $peer->{'state'} ne qw| idle |;

require IO::Socket::IP;

my $sock = IO::Socket::IP->new(
    PeerHost  => $peer->{'host'},
    PeerPort  => $peer->{'port'},
    Type      => SOCK_STREAM(),
    Blocking  => 0,
    ReuseAddr => 1
);

if ( not defined $sock ) {
    <[nameserv.sync.peer.fail]>->(
        $key, sprintf 'connect : %s',
        <[base.str.os_err]>
    );
    return;
}

$peer->{'sock'}  = $sock;
$peer->{'state'} = qw| connecting |;
$peer->{'buf'}   = '';

if ( $sock->connected ) {
    <[nameserv.sync.peer.connected]>->($key);
} else {
    $peer->{'watcher'} = <[event.add_io]>->(
        {   fd      => $sock,
            poll    => 'w',
            handler => qw| nameserv.sync.peer.handler.connect |,
            data    => $key,
            desc    => "sync peer connect [ $key ]"
        }
    );
}

return TRUE;

