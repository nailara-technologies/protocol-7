## [:< ##

# name  = coding.tools.handler.module_convention_check
# descr = audit module headers for convention violations
# param = path, max_line, max_descr

use File::Find qw| find |;

my $args = shift // {};

my $path      = $args->{'path'}      // qw| src |;
my $max_line  = $args->{'max_line'}  // 78;
my $max_descr = $args->{'max_descr'} // 55;

my $root = <system.root_path> // '.';

## resolve path ##
my $scan_path = $path =~ m|^/| ? $path : "$root/$path";
$scan_path = Cwd::abs_path($scan_path) // $scan_path;

return 'error: path not found' unless -e $scan_path;

## collect files ##
my @files;
if ( -f $scan_path ) {
    push @files, $scan_path;
} else {
    find(
        sub {
            return if -d $ARG;
            return if $ARG =~ m{\.(orig|bak|~|tmp|swp)$};
            return if $ARG =~ m{^\.#};                      ## emacs locks ##
            push @files, $File::Find::name;
        },
        $scan_path
    );
}

my @violations;

for my $fpath ( sort @files ) {
    my $rel = $fpath;
    $rel =~ s|^\Q$root/\E||;

    my $is_cmd    = ( $rel =~ m{\.(cmd|console)\.} );
    my $fname_len = length($rel);

    open( my $fh, qw| <:encoding(UTF-8) |, $fpath ) or next;
    my $line_num  = 0;
    my $in_header = 1;

    while ( my $line = <$fh> ) {
        $line_num++;
        chomp $line;

        ## detect end of header block ##
        if ( $in_header && $line !~ m{^\s*#} && $line =~ m{\S} ) {
            $in_header = 0;
        }

        my $len = length($line);

        ## check 1: overall line length [ header lines only ] ##
        if ( $in_header && $len > $max_line ) {
            push @violations,
                {
                'file'      => $rel,
                'fname_len' => $fname_len,
                'line'      => $line_num,
                'len'       => $len,
                'type'      => 'line_too_long',
                'text'      => substr( $line, 0, 70 ),
                };
        }

        ## check 2: descr length for cmd/console modules          ##
        ## match original parser: bin/Protocol-7 [ p7_load_code ] ##
        if ( $is_cmd && $line =~ m{^\s*#\s*descr\s*=\s*(\S.*)} ) {
            my $descr_text = $1;
            $descr_text =~ s{\s+$}{};
            my $dlen = length($descr_text);
            if ( $dlen > $max_descr ) {
                push @violations,
                    {
                    'file'      => $rel,
                    'fname_len' => $fname_len,
                    'line'      => $line_num,
                    'len'       => $dlen,
                    'type'      => 'descr_too_long',
                    'text'      => substr( $descr_text, 0, 60 ),
                    };
            }
        }
    }
    close($fh);
}

## sort: longest lines first, then shorter filenames first ##
my @sorted = sort {
           $b->{'len'} <=> $a->{'len'}
        || $a->{'fname_len'} <=> $b->{'fname_len'}
        || $a->{'file'} cmp $b->{'file'}
        || $a->{'line'} <=> $b->{'line'}
} @violations;

## format output ##
return sprintf
    "<!-- no violations found in %d files [ max_line=%d max_descr=%d ] -->",
    scalar @files, $max_line, $max_descr
    unless @sorted;

my $out = sprintf
    "## convention violations [ %d files scanned, %d issues ] ##\n",
    scalar @files, scalar @sorted;

my $prev_file = '';
for my $v (@sorted) {
    if ( $v->{'file'} ne $prev_file ) {
        $out .= sprintf "\n[%s]\n", $v->{'file'};
        $prev_file = $v->{'file'};
    }
    $out .= sprintf "  L%-4d  %-16s  %2d>%-2d  %s\n",
        $v->{'line'}, $v->{'type'}, $v->{'len'},
        ( $v->{'type'} eq 'descr_too_long' ? $max_descr : $max_line ),
        $v->{'text'};
}

return $out;

