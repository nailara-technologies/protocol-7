## [:< ##

# name   = invoke-web.index.backup
# descr  = lazy copy of the image index to the external path [ sqlite
#          online backup : consistent while the index is in use ]
# note   = the local index [ zenka data dir ] is the fast primary ; the
#          external copy is optional [ invoke-web.index.backup_path, empty
#          = off ]

<invoke-web.index.last_backup> = time;

my $target = <invoke-web.index.backup_path> // '';
return FALSE if not length $target;

( my $target_dir = $target ) =~ s|/[^/]+$||;
if ( not -d $target_dir and not mkdir $target_dir ) {
    <[base.logs]>->(
        1, 'image index backup ' . ': no directory [ %s ]', $target_dir
    );
    return FALSE;
}

## one backup at a time ; reap a finished one [ no zombie ] ##
my $running = <invoke-web.index.backup_pid>;
if ( defined $running ) {
    return FALSE if waitpid( $running, POSIX::WNOHANG() ) == 0;
    delete <invoke-web.index.backup_pid>;
}

## in a short-lived child : the copy to a busy external disk can take seconds
## -- the zenka's event loop must not wait for it. the child opens its own
## connection [ never shares the parent's handle ]
my $source = sprintf '%s/state/image-index.db', <[file.zenka_dir.data_path]>;
my $pid    = fork;
if ( not defined $pid ) {
    <[base.logs]>->(
        1, 'image index backup ' . ': fork failed [ %s ]', "$OS_ERROR"
    );
    return FALSE;
}
if ( $pid == 0 ) {
    my $ok = eval {
        my $dbh = DBI->connect( "dbi:SQLite:dbname=$source", '', '',
            { 'RaiseError' => 1, 'PrintError' => 0 } );
        $dbh->sqlite_busy_timeout(5000);
        $dbh->sqlite_backup_to_file($target) or die;
        $dbh->disconnect;
        1;
    };
    POSIX::_exit( $ok ? 0 : 1 );
}

<invoke-web.index.backup_pid> = $pid;
<[base.logs]>->( 2, 'image index backup -> %s [ child %d ]', $target, $pid );
return TRUE;

