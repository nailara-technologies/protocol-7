## [:< ##

# name  = graphics-matrix.glow.init
# descr = initialize glow intensity state

## set up glow state with defaults ##
<graphics-matrix.glow> = {
    qw| base_intensity | => <graphics-matrix.glow.base_intensity> // 1.0,
    qw| falloff        | => <graphics-matrix.glow.falloff> // 'inverse',
    qw| shells         | => {},    ## hop => { count => N, intensity => F }
    qw| active         | => 0,     ## boolean - glow computation enabled
};

my $glow = <graphics-matrix.glow>;

<[base.logs]>->(
    2,                  'glow initialized [falloff=%s base=%.2f]',
    $glow->{'falloff'}, $glow->{'base_intensity'}
);

