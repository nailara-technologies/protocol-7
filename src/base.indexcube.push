## [:< ##

# name  = base.indexcube.push
# descr = Sign and push P7REF onto @INDEXCUBE routing stack
# param = p7ref string (TYPE:CHKSUM7:ADDR_B32)

my $params = shift // {};
my $p7ref  = $params->{'p7ref'} // $params->{'args'} // '';

return {
    'mode' => qw| false |,
    'data' => 'p7ref required'
    }
    unless length($p7ref) && $p7ref =~ m{^\w+:\w+:\w+$};

## validate p7ref format ##
my ( $type, $chksum7, $addr_b32 ) = split( m|:|, $p7ref, 3 );
return {
    'mode' => qw| false |,
    'data' => 'invalid P7REF format'
    }
    unless length($type) && length($chksum7) && length($addr_b32);

my $key_vars = <[crypt.C25519.key_vars]>;
my $key_name = ref $key_vars eq qw| HASH | ? $key_vars->{'key_name'} : '';
return { 'mode' => qw| false |, 'data' => 'C25519 private key not loaded' }
    unless length($key_name)
    and ref $keys{'C25519'}{$key_name} eq qw| HASH |
    and defined $keys{'C25519'}{$key_name}{'public'}
    and defined $keys{'C25519'}{$key_name}{'private'};

my $sign_entry = sub {
    my $entry     = shift;
    my $entry_str = sprintf '%s:%s:%d',
        $entry->{'p7ref'}, $entry->{'timestamp'}, $entry->{'depth'};
    my $digest = Digest::BMW::bmw_384(
        join( "\0",
            qw| protocol-7.indexcube.entry.v1 |, $entry_str,
            $entry->{'prev'} )
    );
    return undef unless defined $digest;
    my $signature = <[crypt.C25519.sign_data]>->( \$digest, $key_name );
    return undef unless defined $signature and length($signature) == 64;
    return encode_b32r($signature);
};

## the startup anchor predates key loading ; sign only that known anchor ##
if ( @INDEXCUBE == 1 ) {
    my $anchor = $INDEXCUBE[0];
    if (    ref $anchor eq qw| HASH |
        and ( $anchor->{'signature'} // '' ) eq ''
        and ( $anchor->{'prev'}      // '' ) eq ''
        and ( $anchor->{'depth'}     // -1 ) == 0
        and ( $anchor->{'p7ref'}     // '' ) eq <[base.p7ref.self]> ) {
        $anchor->{'prev'}      = '';
        $anchor->{'signature'} = $sign_entry->($anchor);
        return { 'mode' => qw| false |, 'data' => 'anchor signing failed' }
            unless defined $anchor->{'signature'};
    }
}

if (@INDEXCUBE) {
    my $verification = <[base.indexcube.verify]>;
    return {
        'mode' => qw| false |,
        'data' => 'refusing to extend an invalid chain'
        }
        unless ref $verification eq qw| HASH |
        and $verification->{'mode'} eq qw| true |;
}

my $entry = {
    'p7ref'     => $p7ref,
    'timestamp' => <[base.ntime]>,
    'depth'     => scalar(@INDEXCUBE),
    'prev'      => @INDEXCUBE ? $INDEXCUBE[-1]{'signature'} : '',
};
$entry->{'signature'} = $sign_entry->($entry);
return { 'mode' => qw| false |, 'data' => 'entry signing failed' }
    unless defined $entry->{'signature'};

push @INDEXCUBE, $entry;

my $new_depth = scalar(@INDEXCUBE);

<[base.logs]>->( 2, "[indexcube.push] %s at depth %d", $p7ref, $new_depth );

return {
    'mode' => qw| true |,
    'data' => {
        'p7ref'     => $p7ref,
        'depth'     => $new_depth,
        'prev'      => $entry->{'prev'},
        'signature' => $entry->{'signature'},
    }
};

