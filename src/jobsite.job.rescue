## [:< ##

# name  = jobsite.job.rescue
# descr = shared restore-out-of-trash logic : used by both the console and
#         http-facing rescue commands so the reply-format split between them
#         [ p7c wants mode=true/false text, the browser wants strm+json ]
#         doesn't duplicate the actual restore logic

my $id_in        = shift // '';
my $target_stage = shift // 'review';

my $job_id = $id_in;
return {
    'ok'      => FALSE,
    'message' => 'usage: rescue <id> [target stage, default review]'
    }
    if not length $job_id;

my %valid
    = map { $ARG => 1 }
    qw| new review to_apply applied interviewed responded rejected skipped archived |;
return {
    'ok'      => FALSE,
    'message' => "invalid target stage '$target_stage'; valid: "
        . join( ' ', sort keys %valid )
    }
    if not $valid{$target_stage};

my %stage_to_status = (
    'new'         => 'new',
    'review'      => 'review',
    'to_apply'    => 'apply',
    'applied'     => 'applied',
    'interviewed' => 'interviewed',
    'responded'   => 'applied',
    'rejected'    => 'rejected',
    'skipped'     => 'skipped',
    'archived'    => 'rejected',
);

## job.read works off the on-disk index regardless of in-memory task state ##
my $job = <[jobsite.job.read]>->($job_id);
return { 'ok' => FALSE, 'message' => "unknown job: $job_id" }
    if not defined $job;

my $prev_status = $job->{'status'} // '';

$job->{'status'} = $stage_to_status{$target_stage} // $target_stage;
$job->{'stage'}  = $target_stage;
delete $job->{'trash_epoch'};
delete $job->{'deleted_epoch'};
delete $job->{'blocked_epoch'};

<[jobsite.job.write]>->( $job_id, $job );

## keep in-memory task record consistent, if one still exists ##
my $rec = <jobsite.tasks>->{$job_id};
if ( defined $rec ) {
    $rec->{'stage'}  = $target_stage;
    $rec->{'status'} = $job->{'status'};
}

<[jobsite.state.persist]>;
<[jobsite.sync.push_soon]>;

<[base.logs]>->(
    1, 'jobsite.rescue: %s %s -> stage=%s status=%s',
    $job_id, $prev_status, $target_stage, $job->{'status'}
);

return {
    'ok'          => TRUE,
    'message'     => "rescued: $job_id ($prev_status -> $target_stage)",
    'job_id'      => $job_id,
    'prev_status' => $prev_status,
    'stage'       => $target_stage,
};

