## [:< ##

# name = base.register_pm_deps

## an installed tree                                                        ##
## [ the real /usr/local/protocol-7, not a link to a development tree ]     ##
## records no deps : a development record, there it blocks pulls as         ##
## untracked files [ system.src_deps.on_install = yes records them anyway ] ##
## -- inline : a helper sub compiled on demand would register its own deps  ##
## here first [ recursion ]                                                 ##
return TRUE
    if ( Cwd::abs_path( <system.root_path> // '' ) // '' ) eq
    qw| /usr/local/protocol-7 |
    and not <[base.cfg_bool]>->( <system.src_deps.on_install> // qw| no | );

my %pmods     = map { $ARG => TRUE } grep { !m,^AMOS(::.+|$)$, } @ARG;
my $zenka     = <system.zenka.name>;
my $root_path = <system.root_path>;

state $access_warned = FALSE;

my $file_perm = 0664;    ##  zenka group gets write access  ##

## load Module::CoreList if not present yet ##
if ( not <[base.perlmod.loaded]>->('Module::CoreList') ) {
    <[base.perlmod.load]>->(qw[ Module::CoreList ]);
    $pmods{'Module::CoreList'} = TRUE;    ## adding it to the list ##
}
#

my $mod_dir = sprintf qw| %s/var/zenki-deps/p-mod/%s |, $root_path, $zenka;

my @not_registered;

## ensure runtime-owned directory path [ 0775, protocol-7 group writable ] ##
my $zenka_user = <system.amos-zenka-user> // qw| protocol-7 |;
my ( $zenka_uid, $zenka_gid ) = ( getpwnam($zenka_user) )[ 2, 3 ];
$zenka_gid = getgrnam($zenka_user) if not defined $zenka_gid;

if ( not -d $mod_dir ) {
    eval {
        require File::Path;
        File::Path::make_path($mod_dir);
    };
}

## normalize perms/ownership for the entire var/zenki-deps path ##
if ( -d $mod_dir ) {
    my $deps_base = sprintf qw| %s/var/zenki-deps |,       $root_path;
    my $pm_base   = sprintf qw| %s/var/zenki-deps/p-mod |, $root_path;
    foreach my $dir ( $deps_base, $pm_base, $mod_dir ) {
        next if not -d $dir;
        chmod( 0775, $dir );
        if ( $EUID == 0 and defined $zenka_uid and defined $zenka_gid ) {
            chown( $zenka_uid, $zenka_gid, $dir );
        }
    }
}

## skip if dependencies already registered ##
my $already_registered = TRUE;
foreach my $pm ( keys %pmods ) {
    my $placeholder = catfile( $mod_dir, $pm );
    $placeholder =~ s|::|__|g;    ## AMOS7::CHKSUM -> AMOS7__CHKSUM ##
    if ( not -e $placeholder ) {
        $already_registered = 0;
        last;
    }
}
return TRUE if $already_registered;

if ( -d $mod_dir and -r $mod_dir and -w $mod_dir ) {

    ## skip chmod only when running standalone, not under v7 control ##
    my $skip_chmod = !<[base.zenka.is_v7_started]>;

    foreach my $mod_name ( <[base.reverse-sort]>->( \%pmods ) ) {
        ## Convert :: to __ for Windows filesystem compatibility
        ( my $mod_name_fs = $mod_name ) =~ s|::|__|g;
        next if Module::CoreList::is_core($mod_name);
        if ( -w $mod_dir ) {
            my $path_abs = catfile( $mod_dir, $mod_name_fs );
            ( my $relpath = $path_abs ) =~ s|^.*/||;

            ## create file if it doesn't exist ##
            if ( !-e $path_abs ) {
                my $fh;
                open( $fh, qw| > |, $path_abs )
                    and close($fh);
            }

            ## normalize runtime state ownership when running as root ##
            if (    $EUID == 0
                and defined $zenka_uid
                and defined $zenka_gid ) {
                chown( $zenka_uid, $zenka_gid, $path_abs );
            }

            ## skip chmod only [ root + standalone ] ##
            next if $skip_chmod;

            ## chmod ##
            chmod( $file_perm, $path_abs )
                or <[base.logs]>->(
                2,        ":. : '%s' : chmod : %s .:",
                $relpath, <[base.str.os_err]>
                );

        } else {
            push @not_registered, $mod_name;
        }
    }

}
if (    @not_registered
    and not <system.zenka.initialized>
    and not $access_warned++ ) {
    my $root_path = <system.root_path>;
    ( my $mod_dir_rel = $mod_dir ) =~ s|^$root_path/?||g;
    <[base.logs]>->( 0, '<< no write access to %s >>', $mod_dir_rel );
    map { <[base.logs]>->( 0, ': not registered :. %s .:', $ARG ) }
        @not_registered;
}

