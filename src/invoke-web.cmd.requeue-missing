# name  = invoke-web.cmd.requeue-missing
# descr = retry items whose model is back [ no param : list ]
# param = [ model | all ]

my $arg = $call->{'args'} // '';
$arg =~ s{^\s+|\s+$}{}g;

my $list_only = length $arg ? FALSE : TRUE;
my $results   = <[invoke-web.requeue_missing]>->(
    ( $arg eq 'all' or not length $arg ) ? undef : $arg, $list_only
);

return { mode => qw| false |, data => 'queue db not available' }
    if not defined $results;
return {
    mode => qw| false |,
    data => length $arg && $arg ne 'all'
    ? "no failed render on model '$arg'"
    : 'no renders failed on a missing model'
    }
    if not @$results;

return {
    mode => qw| size |,
    data => join(
        '',
        map {
            sprintf "%-40s %3d item%s  %s\n", $ARG->{'name'},
                scalar $ARG->{'items'}->@*,
                $ARG->{'items'}->@* == 1 ? ' ' : 's', $ARG->{'result'}
        } @$results
    )
};

