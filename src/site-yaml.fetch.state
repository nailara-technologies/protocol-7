## [:< ##

# name  = site-yaml.fetch.state
# descr = load/save fetch queue state from zenka_dir

my $op = shift // 'load';

my $state_file = 'fetch-state.yaml';

if ( $op eq qw| load | ) {
    my $sref = <[file.zenka_dir.load]>->($state_file);
    return if not defined $sref;

    my $loaded;
    eval { $loaded = YAML::XS::Load( $sref->$* ) };
    if ($@) {
        <[base.logs]>->( 0, 'fetch.state: load error: %s', $@ );
        return;
    }
    return if ref $loaded ne 'HASH';

    my $queue = $loaded->{'queue'} // [];
    for my $item ( @{$queue} ) {
        next if ref $item ne 'HASH';
        $item->{'id'} = <[base.vax-int.decode]>->( $item->{'id'} // '' );
    }

    <site-yaml.fetch_delay>     = $loaded->{'delay'}     // 1.5;
    <site-yaml.fetch_delay_min> = $loaded->{'delay_min'} // 0.5;
    <site-yaml.fetch_delay_max> = $loaded->{'delay_max'} // 10.0;
    <site-yaml.fetch_errors>    = $loaded->{'errors'}    // 0;
    <site-yaml.fetch_successes> = $loaded->{'successes'} // 0;
    <site-yaml.fetch_queue>     = $queue;
    <site-yaml.fetch_drain_cb>  = $loaded->{'drain_cb'} // '';
    <site-yaml.fetch_timer>     = undef;

    <[base.logs]>->(
        1,                       'fetch: state loaded delay=%.1fs queue=%d',
        <site-yaml.fetch_delay>, scalar @{<site-yaml.fetch_queue>}
    );
    return TRUE;
}

if ( $op eq qw| save | ) {
    my $queue = [];
    for my $item ( @{ <site-yaml.fetch_queue> // [] } ) {
        my $enc_item = { %{$item} };
        $enc_item->{'id'}
            = <[base.vax-int.encode]>->( $enc_item->{'id'} // '' );
        push @{$queue}, $enc_item;
    }

    my $payload = {
        'delay'     => <site-yaml.fetch_delay>     // 1.5,
        'delay_min' => <site-yaml.fetch_delay_min> // 0.5,
        'delay_max' => <site-yaml.fetch_delay_max> // 10.0,
        'errors'    => <site-yaml.fetch_errors>    // 0,
        'successes' => <site-yaml.fetch_successes> // 0,
        'queue'     => $queue,
        'drain_cb'  => <site-yaml.fetch_drain_cb> // '',
    };

    my $yaml;
    eval { $yaml = YAML::XS::Dump($payload) };
    if ($@) {
        <[base.logs]>->( 0, 'fetch.state: save error: %s', $@ );
        return FALSE;
    }

    my $written = <[file.zenka_dir.write]>->( $state_file, \$yaml );
    return defined $written ? TRUE : FALSE;
}

return FALSE;

