## [:< ##

# name  = proxy.handler.accept
# descr = accept new proxy connection, register read handler

my $listen_sock = shift->w->data;

my $client_sock = $listen_sock->accept;
return if not $client_sock;

$client_sock->blocking(0);

my $client_id = <[base.gen_id]>->( <proxy.clients>, 99999, '0123456789', 0 );

my $client_addr = $client_sock->peerhost // 'unknown';
my $client_port = $client_sock->peerport // 0;

<proxy.clients>->{$client_id} = {
    sock        => $client_sock,
    buffer      => '',
    request     => undef,
    context     => undef,
    state       => 'reading',
    client_addr => $client_addr,
    client_port => $client_port,
};

<proxy.clients>->{$client_id}{'watcher'} = <[event.add_io]>->(
    {   fd      => $client_sock,
        poll    => 'r',
        handler => 'proxy.handler.connection',
        data    => $client_id,
    }
);

<[base.logs]>->(
    2, 'proxy accept from %s:%d [%s]',
    $client_addr, $client_port, $client_id
);

return;

