## [:< ##

# name  = coding.cmd.remind-fire
# param = <id> <session | panel | notify> <text>
# descr = a reminder is due : deliver it

my ( $id, $to, $text )
    = ( $call->{'args'} // '' )
    =~ m{\A\s*(remind-\d+)\s+(session|panel|notify)\s+(\S.*?)\s*\z}s;
return { 'mode' => qw| false |, 'data' => 'remind-fire <id> <to> <text>' }
    if not defined $text;
my $paths
    = $to eq qw| session |
    ? [ qw| session |, qw| notify | ]
    : [ qw| notify |, qw| session | ];
<[coding.remind.deliver]>
    ->( { 'id' => $id, 'text' => $text, 'paths' => $paths } )
    or return { 'mode' => qw| false |, 'data' => "reminder $id : no path" };
return { 'mode' => qw| true |, 'data' => "reminder $id sent [ $to ]" };

