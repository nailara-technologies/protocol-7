## [:< ##

# name  = coding.cmd.remind-fire
# param = <id> <session | panel | notify> <text>
# descr = a reminder is due : deliver it

my ( $id, $to, $text )
    = ( $call->{'args'} // '' )
    =~ m{\A\s*(remind-(?:\d+|[A-Z2-7]+\d{2}))\s+
    (session(?::[\w.\-]{1,64}(?:\@[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})?)?|panel|notify)
    \s+(\S.*?)\s*\z}xs;
return { 'mode' => qw| false |, 'data' => 'remind-fire <id> <to> <text>' }
    if not defined $text;
my $sid = $to =~ s|\@([0-9a-f\-]{36})\z|| ? $1 : undef;
## kept first : it leaves the store only when a path took it ##
my $r = <[coding.remind.store]>->( qw| get |, $id );
<[coding.remind.store]>->(
    qw| set |,
    $id,
    {   'text'   => $text,
        'to'     => $to,
        'status' => qw| new |,
        'tries'  => 0,
        defined $sid ? ( 'sid' => $sid ) : ()
    }
) if not defined $r;
<[coding.remind.arm]>;    ## covers an answer that never comes ##
my $sent = <[coding.remind.send]>->($id);
return {
    'mode' => qw| true |,
    'data' => $sent
    ? "reminder $id sent [ $to ]"
    : "reminder $id kept : not delivered yet"
};

