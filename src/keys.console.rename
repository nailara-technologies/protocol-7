## [:< ##

# name  = keys.console.rename
# param = <from> <to> [::yes::]
# descr = change a user key name [ 'list' cmd for names ]

my $param_str = shift // '';

( my $srckey, my $to_keyname, my $confirm ) = split m| +|, $param_str;

if ( not defined $srckey or not defined $to_keyname ) {
    say "\n  << expected <from> and <to> parameters >>\n";
    <[base.exit]>->(qw| 0110 |);
} elsif ( not <[crypt.C25519.validate_keyname]>->($srckey) ) {
    say "\n  <<  source key name is not valid  >>\n";
    <[base.exit]>->(qw| 0113 |);
} elsif ( not <[crypt.C25519.validate_keyname]>->($to_keyname) ) {
    say "\n  <<  target key name is not valid  >>\n";
    <[base.exit]>->(qw| 0113 |);
}

## root-held key : only root may operate on it [ host-root delegation ] the ##
## source key's own vars : its directory is the root key dir when root-held ##
## [ a bare key_vars call is the BASE key's, not the source's ]             ##
my $key_path_ref = <[crypt.C25519.key_path]>->($srckey);
if ( not defined $key_path_ref ) {
    printf "\n  << key '%s' : key path not resolvable, see log >>\n\n",
        $srckey;
    <[base.exit]>->(qw| 0110 |);
} elsif ( $key_path_ref->{'holder'} eq qw| root |
    and $EFFECTIVE_USER_ID != 0 ) {
    printf "\n  << key '%s' is root-held : "
        . "refused, not running as root >>\n\n", $srckey;
    <[base.exit]>->(qw| 0020 |);
}

my $key_vars_ref = <[crypt.C25519.key_vars]>->($srckey);

my $keys_re = <keys.regex>;
my $key_dir = $key_vars_ref->{'key_dir'};

my $re_kfiles      = $keys_re->{'key_files'};
my $re_public      = $keys_re->{'key_file'}->{'public'};
my $key_re_private = $keys_re->{'key_file'}->{'private'};

return printf "\n  << key with name '%s' not found >>\n\n", $srckey
    if not <[crypt.C25519.key_exists]>->($srckey);

my $key_filename_ref = $key_vars_ref->{'key_filename'};

my @k_files = grep {s|^.+/||}
    grep { -e $ARG }
    <[base.sort]>->( map { $key_filename_ref->{$ARG} }
        <[base.sort]>->($key_filename_ref) );

return print "\n  <<  specified keys identical  >>\n\n"
    if $srckey eq $to_keyname;
return print "\n  <<  target key name contains not valid characters  >>\n\n"
    if $to_keyname !~ m|^[\w\.\-\_]+$|;

return printf "\n  << key with name '%s' not found >>\n\n", $srckey
    if not <[crypt.C25519.key_exists]>->($srckey);

return say sprintf "\n  << destination name '%s' exists >>\n", $to_keyname
    if <[crypt.C25519.key_exists]>->($to_keyname);

## a key DERIVED from its passphrase [ or a virtual seed-phrase key ] has ##
## its NAME in the derivation [ crypt.C25519.gen_keys : AMOS7::13::key_32 ##
## over passphrase + name ] -- under another name the same phrase makes a ##
## different key : warned, done only with '::yes::' [ the prune-backups   ##
## convention ], never refused                                            ##
my $on_disk = grep { defined $ARG and -f $ARG }
    @{$key_filename_ref}{qw| secret private |};
my $derived = <[crypt.C25519.key_is_virtual]>->($srckey)
    || ( not $on_disk and not <[crypt.C25519.encrypted_key]>->($srckey) );

if ( $derived and ( $confirm // '' ) ne qw| ::yes:: | ) {
    printf "\n  << WARNING : '%s' is derived from its passphrase AND its "
        . "name -- under '%s'\n     the same passphrase regenerates a "
        . "DIFFERENT key ; its public key,\n     pins and "
        . "certifications of the old key id no longer match >>\n\n  "
        . "add '::yes::' to rename anyway\n\n", $srckey, $to_keyname;
    <[base.exit]>->(qw| 0010 |);
}

map {
    my $k_path = catfile( $key_dir, $ARG );
    return printf "\n << no write access to %s >>\n\n", $k_path
        if not -w $k_path;
} @k_files;

my $maxlen = max map {length} @k_files;

print "\n :\n";

my $ren_count = 0;

foreach my $file_name (@k_files) {
    my $target_name = $file_name;
    next if $target_name !~ s|^$srckey|$to_keyname|;
    printf( " : %-*s  -->  %s\n", $maxlen, $file_name, $target_name );
    return printf "\n rename failed : %s\n\n",
        <[base.str.os_err]>
        unless rename(
        catfile( $key_dir, $file_name ),
        catfile( $key_dir, $target_name )
        );
    $ren_count++;
}

<[crypt.C25519.clear_chksums]>;    ##  cleaning key chksum cache  ##

printf " :\n  .: successfully renamed %02d file%s\n\n", $ren_count,
    <[base.cnt_s]>->($ren_count);

#,,,.,.,.,,,.,.,.,.,.,,..,..,,..,,,,,,,.,,,.,,..,,...,...,,..,,,,,,..,,,.,,,.,
#I7TXWJ4RVSEXL47JGEKHI5JSQBYFPF7OX7ZL2XBIJHKKVRQRD4WJ2MPFDMKCK5BEKKCZXUONGITF6
#\\\|ASJBMTAY3ESHASZZHEC7C4DDM3W3BYTDSIDUTWJBMGSACLTHCEF \ / AMOS7 \ YOURUM ::
#\[7]NL3ZGK7B57M6K35CTJVKYFDQ3VGVI6QHAQYCNAR7XFKDVAQ6FUAY 7  DATA SIGNATURE ::
