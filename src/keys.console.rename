#SOJPVYX72IPJPMQEKVKBFT3I3ACSR35OGAJLHC2K7I35ZB7FPN2ZJODLUUNHC4C6FKW3QT4HGOYEG
#\\\|4VPGIFZ5NKFFGWYE7WRG34FZNFXAFEQJ6YAGKI53CRDX7DNHZDQ \ / AMOS7 \ YOURUM ::
#\[7]YIVZVBBNV66UYOX62QL72IMCSD7LUVICY65KQGQJRHWUUEMTUQBY 7  DATA SIGNATURE ::
