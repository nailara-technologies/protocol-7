## [:< ##

# name   = base.cmd.cpu-time
# descr  = return used cpu time of current zenka

<[base.read_proc_times]>;

$$reply{'mode'} = qw| true |;

$$reply{'data'} = join( ' ',
    <system.times.last_read>,   <system.times.proc_user>,
    <system.times.proc_system>, <system.times.child_user>,
    <system.times.child_system> );

