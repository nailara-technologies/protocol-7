## [:< ##

# name  = coding.cmd.rewind-round
# descr = rewind to an earlier round-chain node
# param = <task_id> [checksum]
# note  = task must be completed or failed, not in_progress. non-
#         destructive : round_chain is append-only, this only moves
#         round_chain_current [ via coding.round_chain.rewind ] and syncs
#         execution.messages to match [ coding.round_chain.
#         navigate_to_node ] -- no inference is triggered, confirmed live
#         that always resuming generation here was a real design error :
#         the content at an existing node is already there, nothing needs
#         regenerating just to look at it. coding.cmd.round-regen is
#         the separate, deliberate action for actually regenerating the
#         round at the current position via fresh inference. checksum is
#         optional : omitted means "one round back from the current tip"
#         [ coding.round_chain.step_target ], for a plain Esc-press-to-
#         rewind UI binding that never needs to know a checksum. pass one
#         explicitly to jump straight to a specific node instead.

my $args_str = $call->{'args'} // '';
my ( $task_id, $checksum ) = split m{ +}, $args_str, 2;

return { 'mode' => qw| false |, 'data' => 'task_id required' }
    unless defined $task_id and length $task_id;

my $task = <coding.task.queue>->{$task_id};

## buffer names use T- prefix; queue keys use task- prefix : normalize [ ##
## same normalization coding.cmd.task-append applies ]                   ##
if ( !defined $task and $task_id =~ s|^T-|task-|i ) {
    $task = <coding.task.queue>->{$task_id};
}

return { 'mode' => qw| false |, 'data' => "task not found: $task_id" }
    unless defined $task;

my $status = $task->{'execution'}->{'status'} // 'unknown';

## only completed/failed tasks : rewinding a live in_progress task would ##
## race the state machine mid-round. use stop-task first, same guidance  ##
## restart-round gives for the analogous "task must not be mid-flight"   ##
## constraint.                                                           ##
return {
    'mode' => qw| false |,
    'data' => "cannot rewind task $task_id [status: $status] "
        . '-- stop it first if it is still in progress'
    }
    unless $status eq qw| completed | or $status eq qw| failed |;

if ( not defined $checksum or not length $checksum ) {
    $checksum = <[coding.round_chain.step_target]>->( $task_id, qw| back | );
    return {
        'mode' => qw| false |,
        'data' => "already at the earliest round for $task_id"
        }
        unless defined $checksum;
}

my $node = <[coding.round_chain.rewind]>->( $task_id, $checksum );
return {
    'mode' => qw| false |,
    'data' => "checksum not found in round_chain for $task_id: $checksum"
    }
    unless defined $node;

## plain inclusive reconstruct -- NOT resolve_resume's parent-exclusion   ##
## logic, that's only needed when immediately feeding this back in for    ##
## generation [ coding.cmd.round-regen ]. pure navigation shows exactly   ##
## what's at this node, trailing assistant turn and all : a later         ##
## task-append appends a real user message after it, which is a perfectly ##
## normal conversation shape, not the "prefill" problem                   ##
my $messages = <[coding.round_chain.reconstruct]>->( $task_id, $checksum );
return {
    'mode' => qw| false |,
    'data' => "failed to reconstruct messages for checksum $checksum"
    }
    unless ref $messages eq qw| ARRAY |;

my $navigated
    = <[coding.round_chain.navigate_to_node]>->( $task_id, $messages );
return { 'mode' => qw| false |, 'data' => "failed to navigate $task_id" }
    unless $navigated;

## replay embedded directly in THIS reply, NOT pushed via coding.round_     ##
## chain.restream/session.listeners -- confirmed live that repeated pure    ##
## navigation calls each adding a fresh subscribe-session listener [ that a ##
## real round's own completion never gets a chance to clean up, since       ##
## navigation never completes a round ] accumulated stale handles that      ##
## broke a LATER real round's actual content streaming. the plain reply     ##
## text already renders multi-line content cleanly through the normal       ##
## single-command-reply path [ nshell.handler.command_reply's content_      ##
## print branch ] -- no persistent listener state needed for this at all.   ##
## coding.cmd.restream still exists standalone for an explicit, one-off     ##
## "resync my view" ask -- just no longer auto-called from here.            ##
my $replay
    = <[coding.round_chain.format_node_for_display]>->( $task_id, $node );

<[base.logs]>->(
    1,        "rewind-round : %s rewound to %s [round %d, %d messages]",
    $task_id, $checksum,
    $node->{'round'} // 0,
    scalar @{$messages}
);

## 'size' mode, NOT 'true' : confirmed live that a 'true'-mode reply's      ##
## embedded real newlines don't survive to the terminal as actual line      ##
## breaks [ that mode is a short single-line human message, same as 'false' ##
## -- genuine multi-line content needs 'size', the same mode                ##
## base.cmd.show-buffer/devmod.cmd.eval-code already use for exactly this   ##
return {
    'mode' => qw| size |,
    'data' => "task $task_id rewound to round $node->{'round'} "
        . "[${\scalar @{$messages}} messages]\n\n$replay\n"
};

