## [:< ##

# name = memory.cmd.focus
# descr = focus sub-commands: set boost get clear apply

my $args_str = $call->{'args'} // '';
my @args     = split m|\s+|, $args_str;
my $cmd      = shift @args // 'get';
$cmd = lc $cmd;

## [ guard not-ready state ]##
if ( not <memory.ready> ) {
    return { 'mode' => 'size', 'data' => "memory tree loading..\n" };
}

if ( $cmd eq 'set' ) {
    my $topic = shift @args;
    my $score = shift @args;

    my $ok = <[memory.focus.set]>->( $topic, $score );
    return { 'mode' => qw| false |, 'data' => 'focus set failed' } if not $ok;

    <[memory.tree.flow]>->( { node => <memory.tree> } );
    <[memory.tree.score]>->( { node => <memory.tree> } );
    return { 'mode' => qw| true |, 'data' => "$topic = $score" };

} elsif ( $cmd eq 'boost' ) {
    my $topic = shift @args;
    my $mult  = shift @args;

    my $ok = <[memory.focus.boost]>->( $topic, $mult );
    return { 'mode' => qw| false |, 'data' => 'focus boost failed' }
        if not $ok;

    <[memory.tree.flow]>->( { node => <memory.tree> } );
    <[memory.tree.score]>->( { node => <memory.tree> } );
    my $new_val = <memory.focus>->{$topic} // '?';
    return { 'mode' => qw| true |, 'data' => "$topic = $new_val" };

} elsif ( $cmd eq 'apply' ) {
    <[memory.focus.apply]>;
    <[memory.tree.flow]>->( { node => <memory.tree> } );
    <[memory.tree.score]>->( { node => <memory.tree> } );
    return { 'mode' => qw| true |, 'data' => 'focus applied' };

} elsif ( $cmd eq 'clear' ) {
    my $topic = shift @args;

    if ( defined $topic and length $topic ) {
        delete <memory.focus>->{$topic};
        delete <memory.focus_floor>->{$topic};
    } else {
        <memory.focus>       = {};
        <memory.focus_floor> = {};
    }

    <[memory.tree.flow]>->( { node => <memory.tree> } );
    <[memory.tree.score]>->( { node => <memory.tree> } );
    return { 'mode' => qw| true |, 'data' => 'focus cleared' };

} else {    ## [ get or unknown — treat as get ] ##
    my $focus  = <memory.focus> // {};
    my @topics = sort { $focus->{$b} <=> $focus->{$a} } keys %$focus;

    if ( not @topics ) {
        return { 'mode' => 'size', 'data' => "[ no focus set ]\n" };
    }

    my $out = '';
    for my $topic (@topics) {
        $out .= sprintf "%s = %s\n", $topic, $focus->{$topic};
    }

    return { 'mode' => 'size', 'data' => $out };
}

