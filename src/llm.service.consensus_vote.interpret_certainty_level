# name  = llm.service.consensus_vote.interpret_certainty_level
# descr = decode harmonic certainty level to human-readable string
# param = $level

my ($level) = @ARG;

my @levels = (
    'Very Low', 'Low',       'Moderate', 'Good',
    'High',     'Very High', 'Excellent'
);

return $levels[$level] // 'Unknown';

