## [:< ##

# name  = models.callback.object_dispatch_slot
# descr = check if task dispatch slot is available

## returns TRUE when no task is actively being dispatched ##

my $object_id = shift;

if ( defined <models.task.active_id> ) {
    <[base.logs]>->(
        3, ': dispatch slot busy [ active task %s ]',
        <models.task.active_id>
    );
    return FALSE;
}

return TRUE;

