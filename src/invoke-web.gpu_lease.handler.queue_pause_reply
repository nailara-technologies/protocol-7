# name  = invoke-web.gpu_lease.handler.queue_pause_reply
# descr = log the render queue pause while the lease is pending

my $reply = shift // {};
<[base.logs]>->(
    $reply->{'ok'} ? 1 : 0,
    ': render queue pause for gpu lease : %s',
    $reply->{'ok'} ? 'done' : $reply->{'status'}
);
return TRUE;

