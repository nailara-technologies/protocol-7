## [:< ##

# name  = kimi.acp.flush_chunk
# descr = turn the collected message chunks into event lines

my $st    = <[kimi.acp.state]>;
my $chunk = delete $st->{'chunk'};
return FALSE if not defined $chunk or not length $chunk->{'text'};
<[kimi.acp.event]>->( $chunk->{'kind'}, $chunk->{'text'} );
return TRUE;

