## [:< ##

# name  = invoke-web.gpu_lease.handler.grace
# descr = empty-queue grace expired : unload and release the gpu lease

delete <invoke-web.gpu_lease.grace_timer>;
return <[invoke-web.gpu_lease.unload]>->( '', qw| release | );

