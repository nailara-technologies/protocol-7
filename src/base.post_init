## [:< ##

# name  = base.post_init

<system.zenka.type> //= qw| unknown |;

##[ COMMAND NAME ANOMALY SCAN ]###############################################

$data{'diag'}{'cmd_anomalies'} //= {};

my $valid_cmd_re = qr|^[^.]+\.cmd\.[^.]+$|;

foreach my $name ( keys %code ) {
    next if index( $name, qw| .cmd. | ) < 0;

    if ( $name !~ $valid_cmd_re ) {
        $data{'diag'}{'cmd_anomalies'}{$name} = 'extra dots after .cmd.';
    } elsif ( not defined $data{'base'}{'cmd'}{$name} ) {
        $data{'diag'}{'cmd_anomalies'}{$name}
            = 'internal subroutine, not whitelisted command';
    }
}

foreach my $name ( keys %{ $data{'base'}{'cmd'} // {} } ) {
    next if index( $name, qw| .cmd. | ) < 0;
    $data{'diag'}{'cmd_anomalies'}{$name} = 'extra dots after .cmd.'
        if $name !~ $valid_cmd_re;
}

return FALSE;

