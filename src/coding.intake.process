## [:< ##

# name = coding.intake.process
# descr = intake orchestrator - validates and normalizes tasks
# purpose = Main entry point for task intake workflow

my $result = <[coding.intake.work]>->(@ARG);

if ( $result->{'success'} && $result->{'task'} ) {

    # Validate the structured task
    my $validation = <[coding.intake.validate_task]>->( $result->{'task'} );
    if ( !$validation->{'valid'} ) {
        return {
            success => FALSE,
            error   => sprintf( "Task validation failed: %s",
                join( ", ", $validation->{'errors'}->@* ) )
        };
    }

    # Normalize the task
    my $normalized = <[coding.intake.normalize_task]>->( $result->{'task'} );

    return {
        success => TRUE,
        task    => $normalized,
        message => $result->{'message'}
    };
}

return $result;

