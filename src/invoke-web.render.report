## [:< ##

# name   = invoke-web.render.report
# descr  = log the outcome of a finished render item [ done : level 1 with
#          time \ ram \ vram ; failed \ suspicious : level 0 with reason ]
# param  = render hashref [ <invoke-web.render> of that item ]

my $render = shift               // return;
my $result = $render->{'result'} // qw| suspicious |;

## render statistics row : every outcome, the result is final here ##
## [ out of the output handler : it reads the queue db ]           ##
<[event.add_timer]>->(
    {   'after'   => 0.2,
        'handler' => qw| invoke-web.handler.stats_record |,
        'data'    => { 'render' => $render },
    }
) if defined $render->{'session'} and not $render->{'stats_armed'}++;

if ( $result ne qw| done | ) {
    <[base.logs]>->(
        0, 'render %s [ item %s%s ]',
        $result,
        $render->{'item'} // '?',
        $result eq qw| failed | ? " : $render->{'failed'}" : ''
    );
    return;
}

<[base.logs]>->(
    1,
    'render done [ item %s : %s, ram %s, vram %s ]',
    $render->{'item'}                                    // '?',
    $render->{'stats'}->{'TOTAL GRAPH EXECUTION TIME'}   // '?',
    $render->{'stats'}->{'RAM used by InvokeAI process'} // '?',
    $render->{'stats'}->{'VRAM in use'}                  // '?'
);

