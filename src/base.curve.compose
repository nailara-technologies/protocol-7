## [:< ##

# name  = base.curve.compose
# descr = Combine factor curves into a single output callback

my $params = shift;

my $id = $params->{'id'} // do {
    state $auto_id = 0;
    'compose_' . ++$auto_id;
};

<base.curve.compose>->{$id} = {
    factors  => $params->{'factors'} // [],
    mode     => $params->{'mode'}    // 'product',
    clamp    => $params->{'clamp'},
    callback => $params->{'callback'},
};

<[base.curve.init]>
    if not defined <base.curve.timer>
    or not <base.curve.timer>->is_active;

return $id;

