## [:< ##

# name  = nameserv.dns_probe.handler.timeout
# descr = mark one probe query as unanswered

my $q = shift->w->data;
return if ref $q ne qw| HASH | or $q->{'done'};
$q->{'answered'} = FALSE;
return <[nameserv.dns_probe.done]>->($q);

