## [:< ##

# name  = coding.helper.dry_last_n
# descr = dry_penalty_last_n for a request : -1 [ full context ] as the
#         running server's n_ctx
# param = $backend [ gpu | cpu, default gpu ]
# note  = mainline-based builds [ prismml fork ] refuse -1 with http 400
#         [ 'Value must be between 0 <= value' ] -- the context size means
#         the same on every build

my $backend = shift // qw| gpu |;
$backend = qw| gpu | if $backend ne qw| cpu |;

my $last_n = <inference.model.dry_penalty_last_n> // -1;
return $last_n if $last_n >= 0;

my $srv = ( <coding.inference_servers> // {} )->{$backend} // {};
return $srv->{'n_ctx'} // <inference.model.context_length> // 0;

