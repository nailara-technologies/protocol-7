## [:< ##

# name  = models.gpu_lease.renew
# descr = renew a live holder's gpu lease timeout
# param = owner name

my $owner = shift // '';
my $lease = <models.gpu_lease> //= {};
return FALSE if ( $lease->{'holder'} // '' ) ne $owner;

my $timeout = <models.cfg.gpu_lease.timeout> // 45;
$timeout = 45 if $timeout !~ m|^\d+$| or $timeout < 5;
return FALSE if <[base.time]> - ( $lease->{'touched'} // 0 ) > $timeout;

$lease->{'touched'} = <[base.time]>;
return TRUE;

