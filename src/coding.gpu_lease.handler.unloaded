## [:< ##

# name  = coding.gpu_lease.handler.unloaded
# descr = acknowledge coding gpu process exit without a blocking wait

my $event     = shift;
my $params    = $event->w->data        // {};
my $pid       = $params->{'pid'}       // 0;
my $requester = $params->{'requester'} // '';
my $attempt   = $params->{'attempt'}   // 1;

if ( $pid and kill( 0, $pid ) and $attempt < 40 ) {
    <[event.add_timer]>->(
        {   'after'   => 0.25,
            'handler' => qw| coding.gpu_lease.handler.unloaded |,
            'data'    => { %{$params}, 'attempt' => $attempt + 1 },
        }
    );
    return TRUE;
}

<[base.logs]>->(
    $pid && kill( 0, $pid ) ? 0 : 1,
    ': gpu llama-server %s : unload acknowledgement sent',
    $pid && kill( 0, $pid ) ? 'still exiting' : 'stopped'
);
<[protocol-7.route-send]>->(
    {   'command'   => qw| models.gpu-lease-released |,
        'call_args' => { 'args' => "coding $requester" },
    }
);

## queue up again : nothing spawns while held, so nothing else would ask ##
<[coding.gpu_lease.request]>;

return TRUE;

