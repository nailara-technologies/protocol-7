## [:< ##

# name  = thermal.idle.held
# descr = check whether the system stayed idle long enough

my ( $idle_gate, $now, $secs ) = @ARG;

return FALSE if ref $idle_gate ne qw| HASH |;
return FALSE if not defined $idle_gate->{'idle_since'};
return FALSE if $now - $idle_gate->{'idle_since'} < $secs;

return TRUE;

