## [:< ##

# name  = radio.audio.watchdog.tick
# descr = periodic mpv playback health check while radio is playing

##  no point polling if mpv is already known offline  ##
return if not <radio.audio.active>;

<[protocol-7.route-send]>->(
    {   'command'   => qw| mpv[audio-0].is-idle |,
        'call_args' => {},
        'reply'     => {
            'handler' => qw| radio.audio.watchdog.handler.reply |,
            'params'  => { 'instance' => 'mpv[audio-0]' },
        }
    }
);

0;

