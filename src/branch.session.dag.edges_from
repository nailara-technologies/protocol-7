## [:< ##

# name = branch.session.dag.edges_from
# descr = list all child checksums from a given node

my $checksum = shift // return undef;

return warn 'checksum required <{C1}>'
    if not length $checksum;

my $node_key = 'branch.session.dag.' . $checksum;
return [] if not exists $data{$node_key};

my $children = $data{$node_key}{'children'} // [];
return [ @{$children} ];

