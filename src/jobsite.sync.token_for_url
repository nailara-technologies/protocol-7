## [:< ##

# name  = jobsite.sync.token_for_url
# descr = resolve the bearer token for a sync url [ host config ]
# param = url string
#
# config [ /etc/protocol-7/jobsite/host.cfg ] :
#   jobsite.cfg.sync_token  = <token>           ## one token for all urls ##
#   jobsite.cfg.sync_tokens = <url>=<token> ... ## per-url overrides       ##
#
# the token is minted on the httpd host : p7c web.auth-issue jobsite-push \
#     -ttl 31536000    [ one year ]

my $url = shift // '';
return '' if not length $url;

## per-url mapping [ space separated url=token pairs ] ##
my $map_str = <jobsite.cfg.sync_tokens> // '';
if ( length $map_str ) {
    for my $pair ( split m|\s+|, $map_str ) {
        my ( $map_url, $map_token ) = split m|=|, $pair, 2;
        next unless defined $map_url and length $map_url;
        return $map_token // '' if $map_url eq $url;
    }
}

## single token applying to every sync url ##
return <jobsite.cfg.sync_token> // '';

