# name = v7-zenki.instance_count

my $zenka_name = shift;

my @instances = <[v7-zenki.instance_ids]>;

return scalar @instances if not defined $zenka_name;

my $zenka_subname;
my $re_sn = <regex.base.subname>;
$zenka_subname = ${^CAPTURE}[0] if $zenka_name =~ s|\[($re_sn)\]$||;

## an 'error' instance still occupies its concurrency slot while a restart ##
## is actually coming for it [ 'restart_pending', set the instant          ##
## handler.zenka_status transitions anything into 'error' -- see its own   ##
## comment ] -- excluding 'error' unconditionally left a real window [     ##
## online --> error, TERM sent, still waiting on process_zenka_end to      ##
## confirm the children are dead before init_restart_timer ever runs ]     ##
## where start_count/max_concurrency saw 0 live instances and let a second ##
## one start : confirmed live 2026-09-17, duplicate 'coding' instances     ##
## fighting over the same gpu/cpu ports. a genuinely abandoned 'error'     ##
## instance [ startup retries exhausted ] transitions synchronously to     ##
## 'offline' in the same call that set 'error', so it never lingers here   ##
## with a stale restart_pending flag                                       ##
my $num_instances = 0;
map {
    my $inst = <v7-zenki.zenka.instance>->{$ARG};
    $num_instances++
        if $inst->{'zenka_name'} eq $zenka_name
        and ( ( $inst->{'status'} // '' ) ne qw| error |
        or $inst->{'restart_pending'} )
        and ( not defined $zenka_subname
        or defined $zenka_subname
        and defined $inst->{'subname'}
        and $zenka_subname eq $inst->{'subname'} )
} @instances;

return $num_instances;

