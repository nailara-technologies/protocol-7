## [:< ##

# name  = radio.post_init
# descr = notify httpd that radio stream endpoint is available

## deferred via <system.callbacks.initialized> -- post_init runs before    ##
## this zenka's own cube connection exists, so a direct route-send here    ##
## reliably hits send.local's "no clients in session" drop.                ##
## <system.init_reports> flushes once around the initial connect and may   ##
## miss a deferred item; this callback fires once this zenka's own session ##
## is genuinely up.                                                        ##
push @{ <system.callbacks.initialized> //= [] }, sub {
    <[protocol-7.route-send]>->(
        {   'command'   => qw| httpd.radio_online |,
            'call_args' =>
                { 'args' => <radio.stream.path> // '/radio/stream' },
        }
    );
};

0;

