## [:< ##

# name  = claude.child.stderr
# descr = keep one stderr line of the child as an event
# args  = line [ octets ], handle

my $line = shift // return;
utf8::decode($line);
<[claude.event.add]>->( qw| stderr |, $line ) if $line =~ m{\S};

