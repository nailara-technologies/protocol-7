## [:< ##

# name  = radio.cmd.status
# descr = current track, listener count, connection status

my $icy           = <radio.stream.icy>;
my $current_title = $icy->{'current_title'} // '';
my $listeners     = scalar( <radio.listeners>->@* );
my $connected
    = defined <radio.stream.sock>
    ? qw| yes |
    : qw| no |;
my $jingle_state = $icy->{'is_jingle'} ? qw| yes | : qw| no |;

my $duration_str = '';
if ( defined $icy->{'track_started'} ) {
    my $dur = <[base.time]>->(3) - $icy->{'track_started'};
    $duration_str = sprintf "\ntrack duration: %.0f seconds", $dur;
}

my $gap_fill_state = <radio.gap_fill.active> ? qw| yes | : qw| no |;

my $library_str = '';
my $lib_dir     = <radio.keep_library.path> // '';
if ( -d $lib_dir ) {
    my @files = glob("$lib_dir/*.mp3");
    $library_str = sprintf "\nlibrary: %d track%s", scalar @files,
        @files == 1 ? '' : 's';
}

my $idle_streak_str = '';
if (<radio.audio.active>) {
    $idle_streak_str = sprintf "\nmpv idle streak: %d",
        <radio.audio.watchdog.idle_count> // 0;
}

return {
    'mode' => qw| true |,
    'data' => sprintf(
        "current track: %s\nlisteners: %d\nconnected: "
            . "%s\njingle: %s\ngap filler: %s%s%s%s",
        length $current_title ? $current_title : '(none)', $listeners,
        $connected,                                        $jingle_state,
        $gap_fill_state,                                   $duration_str,
        $library_str,                                      $idle_streak_str
    )
};

