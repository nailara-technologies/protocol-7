## [:< ##

# name  = coding.helper.task_chain
# descr = a task id followed by its subtask ancestors [ parent, grandparent .. ]
# param = $task_id
# return = aref

my $task_id = shift // '';
my @chain;
my %seen;
while ( length $task_id and not $seen{$task_id}++ ) {
    push @chain, $task_id;
    $task_id = <coding.task.parent>->{$task_id} // '';
}
return \@chain;

