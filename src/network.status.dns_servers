## [:< ##

# name  = network.status.dns_servers
# descr = nameserver lines of resolv.conf, in order

open( my $fh, '<', <network.cfg.resolv_conf> ) or return [];
my @servers;
while ( my $line = readline($fh) ) {
    push @servers, ${^CAPTURE}[0] if $line =~ m|^\s*nameserver\s+(\S+)|;
}
close($fh);
return \@servers;

