## [:< ##

# name  = mpv.startup.handler.socket_timeout
# descr = one-shot deadline: mpv's ipc socket never appeared in time
#          [ the only remaining timer in the startup path -- fires once,
#          not a repeating poll ; mpv dying outright is caught separately
#          by the stdout/stderr io watchers, this only covers the
#          still-alive-but-stuck case ]

delete <mpv.startup.socket_deadline_timer>;

## socket opened in the gap right before this timer fired ##
return if defined <mpv.socket>;

if ( defined <mpv.startup.socket_watch> ) {
    <mpv.startup.socket_watch>->cancel;
    delete <mpv.startup.socket_watch>;
}

<[base.log]>->(
    0,
    "[!] mpv socket creation error [ '%s' does not exist ]",
    <mpv.path.ipc_socket> // ''
);
<[mpv.callback.abort_startup]>;

