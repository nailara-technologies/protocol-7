## [:< ##

# name  = plugin.v7-zenki.hotspot.gone_check
# descr = finish the job once every instance of it is done
# args  = job name

my $job_name = shift                                // return;
my $job      = <v7-zenki.hotspot.jobs>->{$job_name} // return;

return
    if grep { ref $ARG ne qw| HASH | or not $ARG->{'done'} }
    values $job->{'instances'}->%*;

delete <v7-zenki.hotspot.jobs>->{$job_name};

my $reply = <[plugin.v7-zenki.hotspot.report]>->($job);

if ( length $job->{'reply_id'} ) {
    <[base.callback.cmd_reply]>->( $job->{'reply_id'}, $reply );
} else {
    <[base.logs]>->( 1, "hotspot %s :\n%s", $job_name, $reply->{'data'} );
}
return;

