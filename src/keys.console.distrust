## [:< ##

# name  = keys.console.distrust
# param = <fp> [comment]
# descr = distrust a key locally [ refused anywhere in a chain ]
# note  = <fp> : 77 char key id or 52 char public key ;
#         ~/.n/remote-keys/distrust [ data/md/design/TRUST-CHAIN-STEP2.md
#         'revocation' ] -- emergency, local only, checked on every connect

my ( $key_arg, $comment ) = split m|[\t ]+|, shift // '', 2;

my ( $fp, $why ) = <[keys.key_id_arg]>->($key_arg);
if ( not defined $fp ) {
    printf "\n  << %s >>\n\n", $why;
    <[base.exit]>->(qw| 0010 |);
}

my ( $list, $read_why ) = <[keys.distrust_file]>->(qw| read |);
if ( not defined $list ) {
    printf "\n  << distrust list : %s >>\n\n", $read_why;
    <[base.exit]>->(qw| 0110 |);
}
if ( exists $list->{'fps'}->{$fp} ) {
    say "\n  << already distrusted >>\n";
    <[base.exit]>->(qw| 0010 |);
}

$comment //= '';
$comment =~ s{[\r\n]+}{ }g;
$comment =~ s{\A\s+|\s+\z}{}g;
my $line = length $comment ? "$fp  # $comment" : $fp;

my ( $ok, $write_why )
    = <[keys.distrust_file]>
    ->( qw| write |, [ $list->{'lines'}->@*, $line ] );
if ( not $ok ) {
    printf "\n  << distrust list : %s >>\n\n", $write_why;
    <[base.exit]>->(qw| 0110 |);
}

my $fp_half = int( ( length($fp) + 1 ) / 2 );
printf " :\n :: distrusted\n :. %s\n :. %s\n :. every "
    . "chain holding this key is refused from now on\n",
    substr( $fp, 0, $fp_half ), substr( $fp, $fp_half );
<[keys.store_note]>->( $list->{'path'} );
say " :.\n";

#,,,.,,..,,.,,.,,,.,.,..,,,.,,.,.,..,,.,,,.,,,..,,...,..,,..,,.,,,...,.,.,.,.,
