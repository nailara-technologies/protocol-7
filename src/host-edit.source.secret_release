## [:< ##

# name  = host-edit.source.secret_release
# descr = local record source : release a held secret -- NOT SUPPORTED
# param = $hold_name, $reply_handler

## host records hold no secrets -- see host-edit.source.secret_hold.  the
## release half of the reply shape differs only in the engine's handler :
## form.handler.secret_release_reply also keys on the '<<' prefix.

my ( $hold_name, $reply_handler ) = @ARG;

my $msg = '<< host records hold no secrets : release not supported >>';

my $info = {
    qw| sid |       => <form.cube_sid> // 0,
    qw| cmd |       => qw| SIZE |,
    qw| call_args | => { qw| args | => '' },
    qw| data |      => $msg
};

<[event.add_timer]>->(
    {   qw| after | => 0,
        qw| desc |  => 'host-edit.source.secret_release deferred reply',
        qw| cb |    => sub { <[$reply_handler]>->($info) },
    }
);

return TRUE;

