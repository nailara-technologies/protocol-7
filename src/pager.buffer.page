## [:< ##

# name  = pager.buffer.page
# descr = page operations for virtual buffers

my ($args) = @ARG;

my $buffer_id = $args->{'buffer_id'};
my $op        = $args->{'operation'};
my $buf       = $data{'pager'}{'buffers'}{$buffer_id};

return undef unless $buf;

if ( $op eq 'get' ) {
    my $page_num = $args->{'page_num'} // 0;
    return <[pager.buffer.page.get]>->( $buf, $page_num );
} elsif ( $op eq 'invalidate' ) {
    my $page_num = $args->{'page_num'};
    return <[pager.buffer.page.invalidate]>->( $buf, $page_num );
} elsif ( $op eq 'invalidate_all' ) {
    return <[pager.buffer.page.invalidate-all]>->($buf);
} elsif ( $op eq 'stats' ) {
    return $buf->{'stats'};
} elsif ( $op eq 'resize' ) {
    my $new_size = $args->{'page_size'};
    return <[pager.buffer.page.resize]>->( $buf, $new_size );
}

return undef;

