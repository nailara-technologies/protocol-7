## [:< ##

# name  = window.profile.load
# descr = load saved window position from zenka-local yaml

<[base.perlmod.load]>->( 'YAML::XS', qw| Load | );

my $caller = shift;

unless ( defined $caller and length $caller ) {
    <[base.s_warn]>->( 'caller required for load <{C1}>', '' );
    return undef;
}

## same per-caller path as window.profile.save ##
my $caller_chksum = <[chk-sum.amos]>->($caller);
my $position_path = sprintf 'window/position.%s.yaml', $caller_chksum;

<[base.logs]>->( 2, '[profile.load] attempting to load %s', $position_path );

my $yaml_content_ref = <[file.zenka_dir.load]>->($position_path);

unless ( defined $yaml_content_ref ) {
    <[base.log]>->( 1, "[profile.load] file not found or unreadable" );
    return undef;
}

my $yaml_content
    = ref($yaml_content_ref) eq qw| SCALAR |
    ? $$yaml_content_ref
    : $yaml_content_ref;

my $position = undef;
if ( defined $yaml_content and length $yaml_content ) {
    eval {
        my $parsed = Load($yaml_content);
        if ( ref($parsed) eq qw| HASH | ) {
            $position = $parsed;
        }
    };
    if ($EVAL_ERROR) {
        <[base.logs]>->(
            0, '[profile.load] YAML parse error: %s',
            <[base.str.eval_error]>
        );
        return undef;
    }
}

if ( defined $position and ref($position) eq qw| HASH | ) {
    if (    defined $position->{'x'}
        and defined $position->{'y'}
        and defined $position->{'width'}
        and defined $position->{'height'} ) {
        <[base.logs]>->(
            2,
            '[profile.load] loaded position: x=%d y=%d w=%d h=%d',
            $position->{'x'},
            $position->{'y'},
            $position->{'width'},
            $position->{'height'}
        );
        return $position;
    } else {
        <[base.log]>->(
            1, "[profile.load] position hash missing required coordinates"
        );
        return undef;
    }
}

<[base.log]>->(
    1, "[profile.load] position data is not a hash or is undefined"
);
return undef;

