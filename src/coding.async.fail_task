## [:< ##

# name  = coding.async.fail_task
# descr = wrapper for failing async task (state machine interface)

my ( $task_id, $error ) = @ARG;

return { success => FALSE, error => 'task_id required' }
    unless defined $task_id;

$error //= 'unknown error';

## build error result ##
my $result = {
    success => FALSE,
    error   => $error,
};

## call completion handler with error ##
return <[coding.async.complete]>->( $task_id, $result );

