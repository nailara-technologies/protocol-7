## [:< ##

# name  = base.perlmod.all_registered
# descr = return all registered perl module names from deps/p-mod

my $zenka_name = shift;

my $root_path = <system.root_path>;
my $conf_path = <system.conf_path>;

my $perlmods_found_aref = [];

if ( not -d $conf_path ) {
    <[base.s_warn]>->( 'configuration path not found [ %s ]', $conf_path );
    return undef;
} elsif ( defined $zenka_name and $zenka_name =~ <regex.base.usr> ) {
    my @paths;

    ##  runtime-owned registration location [ authoritative ]  ##
    my $var_cfg_path = sprintf qw| %s/var/zenki-deps/p-mod/%s |, $root_path,
        $zenka_name;
    push @paths, $var_cfg_path if -d $var_cfg_path;

    ##  legacy tracked-tree location [ transition merge ]  ##
    my $legacy_cfg_path = sprintf qw| %s/zenki/%s/deps/p-mod |,
        $conf_path, $zenka_name;
    if ( not -d $legacy_cfg_path ) {
        <[base.s_warn]>->(
            'no modules registered ' . 'yet for zenka %s', $zenka_name
        );
        return undef unless @paths;
    } else {
        push @paths, $legacy_cfg_path;
    }

    ##  specified zenka only  ##
    foreach my $path (@paths) {
        push @$perlmods_found_aref, <[file.all_files]>->($path)->@*;
    }

} elsif ( defined $zenka_name ) {
    <[base.s_warn]>->( 'not a valid zenka name [ %s ]', $zenka_name );
    return undef;
} else {
    ##  runtime-owned registration location [ authoritative ]  ##
    my $var_zenki_path = sprintf qw| %s/var/zenki-deps/p-mod |, $root_path;
    $perlmods_found_aref
        = <[file.all_files]>->( $var_zenki_path, qw| recursive | )
        if -d $var_zenki_path;

    ## legacy tracked-tree location [ transition merge ]  all zenki ##
    my $legacy_zenki_path = sprintf qw| %s/zenki |, $conf_path;
    push @$perlmods_found_aref,
        <[file.match_files]>
        ->( $legacy_zenki_path, qw|  recursive p-mod  | )->@*;
}

foreach my $path_abs ( $perlmods_found_aref->@* ) {
    $path_abs =~ s|^.+/||;     ##  strip directory path  ##
    $path_abs =~ s|__|::|g;    ##  convert __ back to :: for module names  ##
}

$perlmods_found_aref->@*       ##  exclude .placeholder  ##
    = uniq grep { index( $ARG, qw| . |, 0 ) != 0 } $perlmods_found_aref->@*;

if (wantarray) {    ##  perlmod list  ##
    return <[base.sort]>->($perlmods_found_aref);
} else {
    return [ <[base.sort]>->($perlmods_found_aref) ];    ##  ARRAY ref  ##
}

