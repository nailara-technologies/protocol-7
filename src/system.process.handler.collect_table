## [:< ##

# name = system.process.handler.collect_table

<process.limits> //= {};

<process.count>     = 0;
<process.table.top> = {};
<process.poll.last> = <[base.ntime]>;

## used memory from the kernel's MemAvailable : realfreeper counts only    ##
## free + buffers + cached, reclaimable slab                               ##
## [ dentries \ inodes of a tree walk, 8.6 GB on a 16 GB host ] read as    ##
## used and the autokill killed an n7fs run at a real 35 % [ 2026-11-23 ]. ##
## realfreeper stays the fallback for a kernel without the line            ##
my $mem_statistics = <system.statistics>->get->memstats;
my $mem_free_pct   = $mem_statistics->{'realfreeper'};
if ( open( my $mi_fh, '<', '/proc/meminfo' ) ) {
    my %mi;
    while ( my $line = <$mi_fh> ) {
        $mi{$1} = $2 if $line =~ m|^(MemTotal\|MemAvailable):\s+(\d+)|;
    }
    close $mi_fh;
    $mem_free_pct = 100 * $mi{'MemAvailable'} / $mi{'MemTotal'}
        if defined $mi{'MemAvailable'} and $mi{'MemTotal'};
}
<system.mem.used_percent> = my $mem_used_pct
    = sprintf( '%.2f', 100 - $mem_free_pct );

## $p->pctcpu averages over the process's whole life : a spinning old one ##
## barely moves it. cpu % is the cpu time used since the previous poll    ##
## [ 100 = one core ], a process first seen shows its lifetime average    ##
my $poll_at   = <[base.time]>->(2);
my $cpu_prev  = <system.process.cpu_prev> // {};
my %cpu_taken = ();

## full records for the watches [ the top table cuts command lines ] ##
my $watching = (
    defined $code{'system.watch.sweep'}
        and ( keys %{ <system.watch.entries> // {} }
        or keys %{ <system.watch.outbox> // {} } )
);
my @watch_procs;
## nobody watching : child statuses are not kept ##
<base.child_exit>->%* = ()
    if not $watching and ref <base.child_exit> eq qw| HASH |;

foreach my $p ( @{ <system.process.pt>->table } ) {
    <process.count>++;
    my $cpu_time = $p->time // 0;            ## [ microseconds ] ##
    my $prev     = $cpu_prev->{ $p->pid };
    my $elapsed  = defined $prev ? $poll_at - $prev->{'at'} : 0;
    my $pct_cpu
        = ( $elapsed > 0 and $prev->{'start'} == $p->start )
        ? ( $cpu_time - $prev->{'time'} ) / 1_000_000 / $elapsed * 100
        : $p->pctcpu;
    $pct_cpu = 0 if defined $pct_cpu and $pct_cpu =~ m|^-|;
    $cpu_taken{ $p->pid }
        = { 'at' => $poll_at, 'start' => $p->start, 'time' => $cpu_time };

    ( my $cpu = sprintf( '%.2f', $pct_cpu ) )   =~ s|^ +||;
    ( my $mem = sprintf( '%.2f', $p->pctmem ) ) =~ s|^ +||;
    $cpu = 0 if $cpu !~ m|^\d+(\.\d+)?$|;
    $cpu =~ s|^(\d+\.\d+)0+$|$1|;
    $mem =~ s|^(\d+\.\d+)0+$|$1|;

    my $p_name
        = (
               not defined $p->cmndline
            or !length( $p->cmndline )
            or length( $p->cmndline ) > 42
        )
        ? $p->fname
        : $p->cmndline;

    <process.table.top>->{ $p->pid } = {
        'fname'  => $p_name,
        'state'  => $p->state,
        'start'  => $p->start,
        'pctcpu' => $cpu,
        'pctmem' => $mem,
    };

    push @watch_procs,
        {
        'pid'   => $p->pid,
        'ppid'  => $p->ppid,
        'start' => $p->start,
        'uid'   => $p->uid,
        'state' => $p->state,
        'cmd'   => $p->cmndline,
        'fname' => $p->fname
        }
        if $watching;

    ## process name blacklist ( not to be killed ) ##
    my $bl_match = 0;
    map {
        if ( $p_name =~ $ARG ) {
            $bl_match = 1;
            <system.process.blacklist_match>->{$p_name} //= $ARG;
        }
    } <system.blacklist.autokill>->@*;
    next if $bl_match;

    ## custom process limits                            ##
    ## [ currently 'max_mem' and 'max_cpu' in percent ] ##
    foreach my $lp_name ( keys <process.limits>->%* ) {
        next
            if $p->fname !~ m|\Q$lp_name\E|
            and ( not defined $p->cmndline
            or $p->cmndline !~ m|^[^\s]*\Q$lp_name\E| );
        my $lp = <process.limits>->{$lp_name};
        ( my $rl_name = $p->fname // $p->cmndline ) =~ s| .*$||;

        if (    defined $lp->{'max_mem'}
            and $lp->{'max_mem'} =~ m|^\d+(\.\d+)?$|
            and $lp->{'max_mem'} != 0 ) {
            $lp->{'condition_start'} //= <[base.time]>->(2)
                if $mem >= $lp->{'max_mem'};
            if ($mem >= $lp->{'max_mem'}
                and ( not defined $lp->{'seconds'}
                    or ( <[base.time]>->(2) - $lp->{'condition_start'} )
                    >= $lp->{'seconds'} )
            ) {
                <[base.log]>->(
                    0,
                    sprintf(
                        "<< ! >> MEMORY USAGE ALERT: (( "
                            . "%s )) [ .. %s%% .. limit=%s%% ]",
                        $rl_name, $mem, $lp->{'max_mem'}
                    )
                );
                if ( defined $lp->{'action'} and $lp->{'action'} eq 'kill' ) {
                    my $term_pid = $p->pid;

                    my $log_msg
                        = sprintf( " : << killing '%s' process >> [PID=%d]",
                        $rl_name, $term_pid );

                    <[system.process.autokill]>->( $term_pid, $log_msg );

                    delete $lp->{'condition_start'};
                }
            }
        }

        next
            if not defined $lp->{'max_cpu'}
            or $lp->{'max_cpu'} !~ m|^\d+(\.\d+)?$|
            or $lp->{'max_cpu'} == 0;
        delete $lp->{'condition_start'} if $cpu < $lp->{'max_cpu'};

        $lp->{'condition_start'} //= <[base.time]>->(2)
            if $cpu >= $lp->{'max_cpu'};

        if ($cpu >= $lp->{'max_cpu'}
            and ( not defined $lp->{'seconds'}
                or ( <[base.time]>->(2) - $lp->{'condition_start'} )
                >= $lp->{'seconds'} )
        ) {
            <[base.log]>->(
                0,
                "<< ! >> CPU LOAD ALERT: (( $rl_name )) [now $cpu%, limit "
                    . $lp->{'max_cpu'} . " ]"
            );
            if ( defined $lp->{'action'} and $lp->{'action'} eq 'kill' ) {
                my $term_pid = $p->pid;

                my $log_msg
                    = sprintf( " : << killing '%s' process >> [PID=%d]",
                    $rl_name, $term_pid );

                <[system.process.autokill]>->( $term_pid, $log_msg );

                delete $lp->{'condition_start'};
            }
        }
    }
}

## exited processes leave the table with this ##
<system.process.cpu_prev> = \%cpu_taken;

## memory limit alerts ##

my $mem_limit_reached = 0;
<system.memory_alert.warned> //= 0;
if ( $mem_used_pct >= <mem.max_used> ) {    # system memory alert limit
    $mem_limit_reached = 1;
    my $reached = $mem_used_pct == <mem.max_used> ? 'reached' : 'exceeded';

    my $warn_str
        = "<< WARNING >> used memory $reached " . <mem.max_used> . "% limit";
    $warn_str .= " ( now $mem_used_pct% )" if $reached eq 'exceeded';
    <[base.log]>->( 0, $warn_str ) if !<system.memory_alert.warned>;
    <system.memory_alert.warned>++;
} elsif (<system.memory_alert.warned>) {
    <[base.log]>->(
        1,
        " : memory usage dropped below "
            . <mem.max_used>
            . "% limit ( now $mem_used_pct% )"
    );
    <system.memory_alert.warned> = 0;
}
if ( $mem_limit_reached and <mem.autokill> )
{    # automatic mem. load mitigation!
    foreach my $pid (
        sort {
            <process.table.top>->{$b}->{'pctmem'} <=>
                <process.table.top>->{$a}->{'pctmem'}
        } keys( <process.table.top>->%* )
    ) {
        my $process = <process.table.top>->{$pid};
        next
            if defined <mem.kill_min>
            and $process->{'pctmem'} < <mem.kill_min>;

        my $log_msg
            = sprintf(
            " :. killing highest memory user (PID %d '%s') [ %s %% ]",
            $pid, $process->{'fname'}, $process->{'pctmem'} );

        <[system.process.autokill]>->( $pid, $log_msg );

        last;
    }
}

## watches ride on this poll : a fault there must not stop the memory guard ##
## or the re-arm below                                                      ##
if ($watching) {
    eval { <[system.watch.sweep]>->( \@watch_procs, $poll_at ) };
    <[base.logs]>->(
        0,
        '<< watch sweep failed : %s >>',
        $EVAL_ERROR =~ s{\s+\z}{}r
    ) if $EVAL_ERROR;
}

## dynamic poll acceleration [ re-arm status timer under rising pressure ] ##

my $accel_threshold = <mem.accel_threshold>    // 0;
my $interval_min    = <mem.accel_min_interval> // 1;
my $target_interval = <process.poll.interval>;

if ( $accel_threshold and $mem_used_pct >= $accel_threshold ) {
    ## linear curve : flat interval at accel_threshold down to floor at  ##
    ## mem.max_used [ monotonic , clamped , not derived from live data ] ##
    my $pressure_range = ( <mem.max_used> - $accel_threshold ) || 1;
    my $pressure       = $mem_used_pct - $accel_threshold;
    $pressure        = $pressure_range if $pressure > $pressure_range;
    $target_interval = sprintf '%.2f',
        <process.poll.interval>
        - ( <process.poll.interval> - $interval_min )
        * ( $pressure / $pressure_range );
    $target_interval = $interval_min if $target_interval < $interval_min;
}

<system.process.poll.current_interval> //= <process.poll.interval>;

if (sprintf( '%.2f', <system.process.poll.current_interval> ) ne
    sprintf( '%.2f', $target_interval ) )
{    ## re-arm only when the interval actually changes ##
    <system.process.status_timer>->cancel
        if defined <system.process.status_timer>;
    <system.process.status_timer> = <[event.add_timer]>->(
        {   'after'    => $target_interval,
            'interval' => $target_interval,
            'handler'  => qw| system.process.handler.collect_table |,
            'repeat'   => 1
        }
    );
    <system.process.poll.current_interval> = $target_interval;
    <[base.logs]>->(
        2, ' : process poll interval re-armed [ %.2fs <- mem %s%% ]',
        $target_interval, $mem_used_pct
    );
}

