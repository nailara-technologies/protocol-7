# name  = power.cmd.remove-wol-device
# descr = remove a wake on lan device from the power config
# param = <name>

my $name = $call->{'args'} // '';

return { 'mode' => qw| false |, 'data' => 'device name expected' }
    if not length $name;

return {
    'mode' => qw| false |,
    'data' => "invalid device name '$name' [ word chars and dash expected ]"
    }
    if $name !~ m|^[\w-]+$|;

return {
    'mode' => qw| false |,
    'data' => "wol device '$name' does not exist"
    }
    if not exists <power.cfg.devices>->{$name};

delete <power.cfg.devices>->{$name};

<[power.save_config]>;

return { 'mode' => qw| true |, 'data' => "wol device '$name' removed" };

