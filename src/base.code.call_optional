# name  = base.code.call_optional
# descr = call a %code sub only if present, else silent skip

## no expectation either way : presence and absence are both fine ##
my $sub_name  = shift // '';
my @call_args = @ARG;

return undef if not length $sub_name;

return undef if not defined $code{$sub_name};

return $code{$sub_name}->(@call_args);

