## [:< ##

# name  = space.template.apply
# descr = resolve template chain_format against params and compute checksum
# param = { template, params }

my $call_params = shift // {};

my $template_name = $call_params->{'template'} // '';
return { 'mode' => qw| false |, 'data' => 'template required' }
    unless length $template_name;

my $template = <space.templates>->{$template_name};
return { 'mode' => qw| false |, 'data' => 'template not found' }
    unless defined $template;

my $params = $call_params->{'params'} // {};
return { 'mode' => qw| false |, 'data' => 'params required' }
    unless ref $params eq qw| HASH |;

my @fields = split /:/, $template->{'chain_format'};
my @values;
for my $field (@fields) {
    push @values, $params->{$field} // '';
}

my $chain_string = join ':', @values;

my $chksum_fn = $code{'chk-sum.amos'} // $code{'base.chk-sum.amos'};
my $checksum  = $chksum_fn->( \$chain_string );

return {
    'checksum'     => $checksum,
    'parent'       => $params->{'parent'} // '',
    'coordinate'   => $checksum,
    'chain_string' => $chain_string,
};

