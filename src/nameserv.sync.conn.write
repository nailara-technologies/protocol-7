## [:< ##

# name  = nameserv.sync.conn.write
# descr = append output to a sync connection and try to flush it

my $conn = shift // return undef;
my $str  = shift // '';

my $conns = <nameserv.sync.conns> //= {};
$conn = $conns->{$conn} if not ref $conn and defined $conns->{$conn};
return undef if ref $conn ne qw| HASH |;

$conn->{'out'} .= $str;

return <[nameserv.sync.conn.flush]>->($conn);

