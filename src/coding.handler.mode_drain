## [:< ##

# name  = coding.handler.mode_drain
# descr = timer : fire deferred pinned-model switches once the loaded
#         model's open work is done [ queue grouping, todo WNF ]

my $event   = shift;
my $backend = $event->w->data // qw| gpu |;

<[coding.helper.drain_model_pin_deferrals]>->($backend);

## nothing left to switch : stop until the next deferral re-arms it ##
if ( !%{ ( <coding.model_pin_deferred> // {} )->{$backend} // {} } ) {
    delete <coding.mode_drain_timer>->{$backend};
    $event->w->cancel;
}

return TRUE;

