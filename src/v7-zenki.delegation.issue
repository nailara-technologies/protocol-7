## [:< ##

# name   = v7-zenki.delegation.issue
# descr  = host-root delegates cube's S and nameserv's sync key
# return = TRUE [ cube's S has a valid delegation ], FALSE [ logged why ]
#
# cube's S decides the result [ the retry timer of
# v7-zenki.delegation.startup runs until it is in place ] ; the sync key
# is optional and logged on its own [ data/md/design/TIMESTAMP-DELTA-
# SYNC.md 'stage 3 decisions' ]. also an event.add_timer handler : the
# event argument is ignored.

my $backend_user = <system.amos-zenka-user> // '';

my $issued = <[v7-zenki.delegation.issue_key]>->(
    sprintf( qw| %s.base |, $backend_user ),
    qw| cube |
);

<[v7-zenki.delegation.issue_key]>->(
    qw| nameserv-sync |,
    qw| nameserv-sync |, TRUE
);

return $issued;

