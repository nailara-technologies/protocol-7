# name  = pager.source.checksum-list
# descr = Pager data source: checksum list files with index support

my ($args) = @ARG;

my $file       = $args->{'file'} or return undef;
my $format     = $args->{'format'} // 'bmw-base32';    # bmw-base32, amos, hex
my $index_file = $args->{'index'};    # Optional index for random access
my $batch_size = $args->{'batch_size'} // 1000;

# Determine checksum length based on format
my $checksum_len = {
    'bmw-base32'  => 32,
    'bmw-L13-b32' => 27,
    'bmw-224'     => 36,
    'amos'        => 24,
    'hex'         => 64,
}->{$format} // 32;

my $line_len = $checksum_len + 1;     # +1 for newline

# Open file
open( my $fh, '<', $file ) or return undef;

# Get total count from file size or index
my $total;
if ( $index_file && -f $index_file ) {

    # Read index header
    open( my $idx, '<', $index_file ) or return undef;
    my $header = <$idx>;
    close($idx);
    if ( $header =~ /count:(\d+)/ ) {
        $total = $1;
    }
}

if ( !$total ) {
    my $size = -s $file;
    $total = int( $size / $line_len ) if $size && $line_len;
}

my $current_pos = 0;

return {
    'type'   => 'checksum-list',
    'file'   => $file,
    'format' => $format,
    'total'  => $total,
    'cursor' => 0,
    'fh'     => $fh,

    'next_batch' => sub {
        my $batch = [];
        my $count = 0;

        while ( $count < $batch_size && !eof($fh) ) {
            my $line = <$fh>;
            next unless defined $line;
            chomp $line;
            next unless length($line) >= $checksum_len;

            my $checksum = substr( $line, 0, $checksum_len );
            my $path     = '';

            # Format: <checksum>  <path>  or just <checksum>
            if ( length($line) > $checksum_len + 2 ) {
                $path = substr( $line, $checksum_len + 2 );
            }

            push @$batch,
                {
                'checksum'  => $checksum,
                'algorithm' => $format,
                'path'      => $path,
                'index'     => $current_pos++,
                };
            $count++;
        }

        return $batch;
    },

    'get_item_at' => sub {
        my ($idx) = @ARG;
        return undef unless $idx >= 0;

        # Seek to position if possible
        my $seek_pos = $idx * $line_len;
        return undef unless seek( $fh, $seek_pos, 0 );

        my $line = <$fh>;
        return undef unless defined $line;
        chomp $line;

        my $checksum = substr( $line, 0, $checksum_len );
        my $path
            = length($line) > $checksum_len + 2
            ? substr( $line, $checksum_len + 2 )
            : '';

        return {
            'checksum'  => $checksum,
            'algorithm' => $format,
            'path'      => $path,
            'index'     => $idx,
        };
    },

    'close' => sub {
        close($fh) if $fh;
    },
};

