## [:< ##

# name  = claude.handler.stderr
# descr = keep the child's stderr lines as events

my $event = shift->w;
my $child = <claude.child>;
if (   not defined $child
    or not defined $child->{'err'}
    or $child->{'pid'} != ( $event->data->{'pid'} // 0 ) ) {
    $event->cancel if $event->is_active;
    return;
}
my $got = CORE::sysread( $child->{'err'}, my $chunk, 16384 );
if ( not defined $got ) {
    return if $OS_ERROR{'EAGAIN'} or $OS_ERROR{'EWOULDBLOCK'};
    return if $OS_ERROR{'EINTR'};
}
if ( not $got ) {    ## eof : stdout eof ends the child ##
    $event->cancel if $event->is_active;
    CORE::close( $child->{'err'} );
    $child->{'err'} = undef;
    return;
}
$child->{'pend_err'} .= $chunk;
while ( $child->{'pend_err'} =~ s|\A([^\n]*)\n|| ) {
    my $line = $1;
    utf8::decode($line);
    <[claude.event.add]>->( qw| stderr |, $line ) if $line =~ m{\S};
}

