## [:< ##

# name  = httpd.cmd.vhost-list
# descr = return list of all active known vhosts

return { 'mode' => 'false', 'data' => 'no vhosts are currently configured' }
    if not keys <httpd.cfg.hostnames>->%*;

my $reply_string;

foreach my $vhost_name (
    sort { length $a <=> length $b } sort { $b cmp $a }
    keys <httpd.cfg.hostnames>->%*
) {
    next if not length $vhost_name;
    $reply_string .= sprintf "%s\n", $vhost_name;
}

return { 'mode' => 'size', 'data' => $reply_string }

