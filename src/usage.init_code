## [:< ##

# name  = usage.init_code
# descr = usage tracking zenka : in-flight query registry set-up
# note  = provider specifics live in the plugin.usage.* plugins, this zenka
#         only dispatches to them and aggregates their parsed numbers

<usage.requests> //= {};    ##  in-flight aggregate queries by req_id  ##

## seconds added on top of the slowest provider before a query is cut short ##
## and answered with whatever did arrive                                    ##
<usage.cfg.query_grace> //= 10;

<[base.log]>->( 1, ': usage zenka initialized' );

0;

