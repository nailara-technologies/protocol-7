## [:< ##

# name  = jobsite.sync.role_for_url
# descr = resolve the sync role for a sync url [ host config ]
# param = url string
#
# config [ /etc/protocol-7/host-config/jobsite.cfg ] :
#   jobsite.cfg.sync_url_roles = <url>=<role> [<url>=<role> ..]
#
# roles : owner [ default for every url ] = today's full behaviour
#         marks = export marks + prefs only, never job state or removals

my $url = shift // '';
return qw| owner | if not length $url;

## per-url mapping [ space separated url=role pairs ] ##
my $map_str = <jobsite.cfg.sync_url_roles> // '';
if ( length $map_str ) {
    for my $pair ( split m|\s+|, $map_str ) {
        my ( $map_url, $map_role ) = split m|=|, $pair, 2;
        next unless defined $map_url and length $map_url;
        next unless $map_url eq $url;
        return ( defined $map_role and $map_role eq qw| marks | )
            ? qw| marks |
            : qw| owner |;
    }
}

## no mapping for this url : full behaviour ##
return qw| owner |;

