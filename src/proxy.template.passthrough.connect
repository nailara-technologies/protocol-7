## [:< ##

# name  = proxy.template.passthrough.connect
# descr = handle CONNECT method tunnel

my $client_id = shift;
my $context   = shift;

my $client = <proxy.clients>->{$client_id};
return if not defined $client;

my $url = $context->{'request'}{'url'};    ## host:port ##
my ( $host, $port ) = split m|:|, $url, 2;
$port //= 443;

## set target in context so helper resolves correctly ##
$context->{'request'}{'domain'} = $host if length $host;

## get outbound socket via helper ##
my $conn = <[proxy.outbound.connect_or_use]>->($context);

if ( not defined $conn or not defined $conn->{'socket'} ) {
    <[proxy.client.send_error]>->(
        $client_id, 502, "Cannot connect to $host:$port"
    );
    return;
}

my $target_sock = $conn->{'socket'};

## send 200 to client ##
my $established = "HTTP/1.1 200 Connection Established\r\n\r\n";
my $w           = <[base.s_write]>->( $client->{'sock'}, \$established );
if ( $w < 0 ) {
    eval { $target_sock->close };
    <[proxy.client.close]>->($client_id);
    return;
}

## store target socket ##
$client->{'target_sock'} = $target_sock;
$client->{'state'}       = 'tunneling';

## register relay watchers ##
<[event.add_io]>->(
    {   fd      => $client->{'sock'},
        poll    => 'r',
        handler => 'proxy.handler.tunnel_client_to_target',
        data    => $client_id,
    }
);

<[event.add_io]>->(
    {   fd      => $target_sock,
        poll    => 'r',
        handler => 'proxy.handler.tunnel_target_to_client',
        data    => $client_id,
    }
);

return;

