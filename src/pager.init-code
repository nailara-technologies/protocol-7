## [:< ##

# name  = pager.init-code
# descr = Pager zenka - virtual buffer initialization

$data{'pager'} = {
    'buffers' => {},    # buffer_id -> buffer config
    'sources' => {},    # source_type -> handler
    'next_id' => 1,
};

return 1;

