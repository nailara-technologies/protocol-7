# name = v7-zenki.handler.start-time-out

my $watcher     = shift->w;
my $params      = $watcher->data;
my $timeout     = $params->{'timeout'};
my $instance_id = $params->{'instance_id'};
my $instance    = <v7-zenki.zenka.instance>->{$instance_id};
my $zenka_name  = $instance->{'zenka_name'};

$watcher->cancel if $watcher->is_active;

if ( defined $instance->{'timer'}->{'start-time-out'} ) {
    delete $instance->{'timer'}->{'start-time-out'};
    delete $instance->{'timer'} if not keys %{ $instance->{'timer'} };
}

return
    if not defined $instance->{'status'}
    or $instance->{'status'} ne qw| starting |;

## host memory pressure : a start stalled in reclaim is slow, not broken -- ##
## same rule as v7-zenki.handler.heartbeat_response_timeout : while the     ##
## level is elevated \ critical                                             ##
## [ or the latest sample already crosses the critical avg10 ] wait again,  ##
## up to heartbeat_ext.<level> times                                        ##
my $level  = <v7-zenki.pressure.level>  // qw| calm |;
my $latest = <v7-zenki.pressure.latest> // {};
$level = qw| critical |
    if $level eq qw| calm |
    and ( $latest->{'mem_full_avg10'} // 0 )
    >= ( <v7-zenki.cfg.pressure.critical.mem_full_avg10> // 5.0 );

my $ext_max
    = $level eq qw| critical |
    ? <v7-zenki.cfg.pressure.heartbeat_ext.critical> // 6
    : $level eq qw| elevated |
    ? <v7-zenki.cfg.pressure.heartbeat_ext.elevated> // 3
    : 0;
my $ext_count = $params->{'pressure_ext'} // 0;
if ( $ext_max and $ext_count < $ext_max ) {
    my $ext_secs = <v7-zenki.cfg.pressure.heartbeat_ext.secs> // 17;
    <[base.logs]>->(
        $ext_count ? 2 : 1,
        "instance %d ['%s'] start slow under %s memory pressure -- "
            . 'waiting [ %d \ %d ]',
        $instance_id,
        $zenka_name,
        $level,
        $ext_count + 1,
        $ext_max
    );
    $instance->{'timer'}->{'start-time-out'} = <[event.add_timer]>->(
        {   'after'   => $ext_secs,
            'handler' => qw| v7-zenki.handler.start-time-out |,
            'data'    => {
                'instance_id'  => $instance_id,
                'timeout'      => $timeout + $ext_secs,
                'pressure_ext' => $ext_count + 1,
            }
        }
    );
    return;
}

<[base.logs]>->(
    0, "instance %d ['%s'] start timed out after %.1fs",
    $instance_id, $zenka_name, $timeout
);
<[zenka.change_status]>->( $instance_id, qw| error | );

