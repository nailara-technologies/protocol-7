## [:< ##

# name  = coding.callback.object.model_path
# descr = dependency callback : true once the model file path has been
#         resolved via coding.resolve_model_path [ per-backend ]

my $object_id = shift;
return undef unless exists <dependency.object>->{$object_id};

## backend comes from the dependency object's own field : gpu stays on the ##
## shared <inference.model.path> slot                                      ##
## [ zero blast radius on existing readers ], cpu gets its own             ##
## <inference.backend.cpu.path> slot                                       ##
my $backend = <dependency.object>->{$object_id}->{'backend'} // 'gpu';
my $path
    = $backend eq 'cpu'
    ? ( <inference.backend.cpu.path> // '' )
    : ( <inference.model.path> // '' );

return length($path) ? TRUE : FALSE;

