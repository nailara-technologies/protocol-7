# name  = coding.callback.object.model_path
# descr = dependency callback : true once the model file path has been
#         resolved via coding.resolve_model_path

my $object_id = shift;
return undef unless exists <dependency.object>->{$object_id};

my $model_path = <inference.model.path> // '';
return length($model_path) ? TRUE : FALSE;

