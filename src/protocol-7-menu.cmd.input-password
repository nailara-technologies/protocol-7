# name = protocol-7-menu.cmd.input-password
# param = [label_text]
# descr = Display styled password input dialog with character masking

return { 'mode' => qw| false |, 'data' => 'graphical mode not enabled' }
    unless <protocol-7-menu.init-graphical>;

my $label_text = $call->{'args'} // 'Enter password:';

# Disable GTK error beep sounds [ the backspace sound, etc. ]
my $settings = Gtk3::Settings::get_default();
$settings->set_property( 'gtk-error-bell', 0 );

# Suppress Gdk warnings during dialog creation
<[base.stderr_redir]>;

# Create dialog window - modal to capture input reliably
my $parent_window = <protocol-7-menu.graphical-window>;
my $dialog        = Gtk3::Window->new('toplevel');
$dialog->set_type_hint('dialog');
$dialog->set_transient_for($parent_window) if $parent_window;
$dialog->set_modal(1);    # Modal captures all input
$dialog->set_decorated(0);
$dialog->set_border_width(8);
$dialog->set_app_paintable(1);

# Apply styling
my $screen           = $dialog->get_screen;
my $use_transparency = $dialog->is_composited ? 1 : 0;
$dialog->set_opacity(1) if $use_transparency;

if ($use_transparency) {
    my $rgba = $screen->get_rgba_visual();
    $dialog->set_visual($rgba);
}

my $css_prov = Gtk3::CssProvider->new();
$css_prov->load_from_data(<<'EOT');
window { background-color:#000013; color:#0055CC; font-size:large; }
entry { background-color:#000042; color:#0055CC; padding:4px; }
entry:focus { background-color:#001066; }
label { color:#0055CC; }
EOT
Gtk3::StyleContext::add_provider_for_screen( $screen, $css_prov, -1 );

# Create container
my $vbox = Gtk3::Box->new( 'vertical', 6 );
$dialog->add($vbox);

# Add label
my $label = Gtk3::Label->new($label_text);
$label->set_halign('start');
$vbox->pack_start( $label, 0, 0, 0 );

# Create password entry field (masked)
my $entry = Gtk3::Entry->new();
$entry->set_visibility(0);    # Hide characters
$entry->set_placeholder_text('••••••••');
$entry->set_size_request( 300, -1 );
$vbox->pack_start( $entry, 0, 0, 0 );

# Store result
my $result          = '';
my $dialog_finished = 0;

# Handle Enter key [ activate signal is proper GTK3 way ]
$entry->signal_connect(
    'activate' => sub {
        $result          = $entry->get_text;
        $dialog_finished = 1;
        $dialog->destroy;
    }
);

# Handle Escape key on dialog
$dialog->signal_connect(
    'key-press-event' => sub {
        my ( $widget, $event ) = @ARG;
        if ( $event->keyval == 65307 ) {    # Escape key
            $result          = '';
            $dialog_finished = 1;
            $dialog->destroy;
            return 1;
        }
        return 0;
    }
);

## Center dialog on screen ##
# [ do not try to center on parent window which might be off-screen ]

$dialog->set_position('center-always');

# Show and focus
$dialog->show_all;
$dialog->present;
$entry->grab_focus;

# Process events until dialog closes
while ( !$dialog_finished ) {
    <[event.once]>->(0.07);
    Gtk3::main_iteration_do(1);
}

# Restore stderr
<[base.stderr_restore]>;

# Return result
if ($result) {
    <[base.logs]>->( 1, "password input : %d chars", length($result) );
    return { 'mode' => qw| true |, 'data' => $result };
} else {
    return { 'mode' => qw| false |, 'data' => 'input cancelled' };
}

