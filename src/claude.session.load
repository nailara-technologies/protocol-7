## [:< ##

# name   = claude.session.load
# descr  = the recorded session id of the last run
# return = session id, or undef

my $dir = <[claude.var_dir]>;
return undef if not defined $dir;
CORE::open( my $fh, '<:encoding(UTF-8)', "$dir/session.cfg" ) or return undef;
my $session;
while ( my $line = <$fh> ) {
    $session = $1 if $line =~ m|\A\s*session\s*[=:]\s*([\w-]{8,80})\s*\z|;
}
CORE::close($fh);
return $session;

