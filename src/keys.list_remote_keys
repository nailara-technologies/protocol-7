## [:< ##

# name   = keys.list_remote_keys
# descr  = collect the host pins [ servers/ ] for display \ remove
# return = { <display name> => { hostname port key_id label name since
#          file_path stem type } }
#
# data/md/design/TRUST-CHAIN-STEP2.md [ 'pins' ] : <known_hosts_dir> =
# ~/.n/remote-keys/servers, '<host>_<port>.public' -- line 1 the 77 char
# key id of the host-root, line 2 the leaf name, line 3 since [ lines 2 \
# 3 optional ]. label = the first 7 chars of the key id [ a hash : a
# recognition label, NOT a verification -- compare the full key id ].
# malformed \ symlinked files are skipped.

my $key_vars_ref = <[crypt.C25519.key_vars]>;
my $known_dir    = $key_vars_ref->{'known_hosts_dir'};

return {} if not defined $known_dir or not -d $known_dir;

my $default_port = 42;    ## hidden in the display name ##

my %remote_keys;
foreach my $file ( <[file.all_files]>->($known_dir)->@* ) {
    next if $file !~ m|^.*/([^/]+)\.public$|;
    my $stem = $1;
    next if -l $file or not -f $file or not -r $file;

    open( my $fh, '<', $file ) or next;
    my @line;
    foreach ( 1 .. 3 ) {
        my $line = readline($fh);
        last if not defined $line;
        push @line, $line =~ s{\s+\z}{}r;
    }
    close($fh);
    my ( $key_id, $name, $since ) = @line;
    next if not defined $key_id or $key_id !~ m|\A[A-Z2-7]{77}\z|;

    ## '<host>_<port>' [ ':' was stored as '_' ] ##
    my ( $safe_hostname, $port ) = $stem =~ m|^(.+)_(\d+)$|;
    next if not defined $safe_hostname;
    ( my $hostname = $safe_hostname ) =~ tr|_|:|;

    my $display_name
        = $port == $default_port
        ? $hostname
        : sprintf( '%s:%d', $hostname, $port );

    $remote_keys{$display_name} = {
        'hostname'  => $hostname,
        'port'      => $port,
        'key_id'    => $key_id,
        'label'     => substr( $key_id, 0, 7 ),
        'name'      => ( defined $name and length $name ) ? $name : undef,
        'since'     => $since,
        'file_path' => $file,
        'stem'      => $stem,        ## alt. lookup key for remove ##
        'type'      => 'host-root'
    };
}

return \%remote_keys;

