## [:< ##

# name  = keys.list_remote_keys
# descr = collect and structure remote [hostkey] entries for display
# return = hash of remote key info organized by hostname:port

my $key_vars_ref = <[crypt.C25519.key_vars]>;
my $known_dir    = $key_vars_ref->{'known_hosts_dir'};

return {} if not -d $known_dir;

##  Scan for known-host *.public files  ##

my %remote_keys;

foreach my $file ( <[file.all_files]>->($known_dir)->@* ) {
    next if $file !~ m|^.*/(.+)\.public$|;

    my $key_name = $1;    ## e.g., "localhost_42" from "localhost_42.public"

    ##  Read key file  ##
    next if not -f $file or not -r $file;

    my $key_content = <[file.slurp]>->($file)->$*;
    next if not defined $key_content or not length $key_content;

    chomp $key_content;

    ##  Parse format: NTIME_B32:PUBKEY_B32  ##
    my ( $ntime_b32, $pubkey_b32 ) = split m|:|, $key_content, 2;

    next
        if not defined $ntime_b32
        or not defined $pubkey_b32
        or not length $ntime_b32
        or not length $pubkey_b32;

    ## Extract hostname and port from key_name  Format: hostname_safe_port ##
    ## (e.g., "localhost_42", "fe80__1_42" for IPv6) From                  ##
    ## hostname_port.public, extract hostname_port part                    ##

    my ( $safe_hostname, $port ) = $key_name =~ m|^(.+)_(\d+)$|;

    next if not defined $safe_hostname or not defined $port;

    ##  Restore original hostname (reverse the unsafe char replacement)  ##
    my $hostname = $safe_hostname;
    $hostname
        =~ tr|_|:|;    ## primary restore (colons for IPv6 and unsafe chars)

    ## Store remote key info with smart display name  Hide port if it ##
    ## matches default (42) to reduce clutter                         ##
    my $DEFAULT_PORT = 42;
    my $display_name
        = ( $port == $DEFAULT_PORT )
        ? $hostname
        : sprintf( '%s:%d', $hostname, $port );

    $remote_keys{$display_name} = {
        'hostname'   => $hostname,
        'port'       => $port,
        'pubkey_b32' => $pubkey_b32,
        'ntime_b32'  => $ntime_b32,
        'file_path'  => $file,
        'type'       => 'hostkey'
    };
}

return \%remote_keys;

