## [:< ##

# name  = index.cmd.export
# descr = export index tree to YAML

my $path   = $call->{'args'} // '';
my $result = <[index.export]>->( length $path ? $path : undef );

return { 'mode' => 'size', 'data' => $result // 'exported' };

