# name  = ncode.cmd.diff
# descr = show git diff for a file against a ref

my $args = $call->{'args'} // '';

my @parts = split m|\s+|, $args;

return { 'mode' => qw| false |, 'data' => 'usage: diff <file> [ref]' }
    if @parts < 1;

my $file = shift @parts;
my $ref  = shift @parts // qw| HEAD |;

my $root = <system.root_path> // '.';
my @cmd  = ( qw| git |, '-C', $root, qw| diff |, $ref, qw| -- |, $file );

my $output = <[ncode.util.run_cmd]>->(@cmd);

return { 'mode' => qw| size |, 'data' => $output };

