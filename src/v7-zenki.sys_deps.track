## [:< ##

# name  = v7-zenki.sys_deps.track
# descr = record installed dep entries in var/sys-deps/tracked.yaml
#         [ shared by check_zenka_deps, handler.deps_install_reply and the
#           sys_deps reply handler -- thin call to the shared
#           AMOS7::deps::tracked::record implementation ]
# param = <zenka_name> [ <item> .. ] , <item> = { name => .., type => .. }

my $zenka_name = shift // '';
my $items      = shift // [];

return if not @$items;

## small + core-only module : safe to load in-process ##
<[base.perlmod.load]>->('AMOS7::deps::tracked')
    if not <[base.perlmod.loaded]>->('AMOS7::deps::tracked');

my $track_file = AMOS7::deps::tracked::track_file(<system.root_path>);
my $track_dir  = <system.root_path> . '/var/sys-deps';

AMOS7::deps::tracked::record(
    <system.root_path>,
    [   map {
            {   'pkg'          => $ARG->{'name'},
                'type'         => $ARG->{'type'}     // qw| debian |,
                'installed_at' => <[base.ntime.b32]> // '',
                'source'       => 'v7-prestart',
                'zenka'        => $zenka_name,
                'declared'     => 0
            }
        } @$items
    ]
);

## normalize ownership for sys-deps zenka \ os-pkg access ##
if ( -f $track_file and $UID == 0 ) {
    my ( $track_uid, $track_gid )
        = ( getpwnam(<system.amos-zenka-user>) )[ 2, 3 ];
    chown( $track_uid, $track_gid, $track_dir, $track_file )
        if defined $track_uid;
    chmod( 0775, $track_dir );
    chmod( 0664, $track_file );
}

return TRUE;

