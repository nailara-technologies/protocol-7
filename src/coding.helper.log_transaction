# name = coding.helper.log_transaction
# descr = log a budget transaction

my ( $task_id, $service, $tokens_used, $success, $result ) = @ARG;

my $transaction = {
    timestamp     => <[base.ntime]>,
    task_id       => $task_id,
    service       => $service,
    tokens_used   => $tokens_used,
    success       => $success // 1,
    result        => $result,
    balance_after => <coding.budget.allocated>
        - ( <coding.budget.used> + $tokens_used )
};

push @{<coding.budget.transactions>}, $transaction;
<coding.budget.used> += $tokens_used;

return {
    success       => TRUE,
    transaction   => $transaction,
    budget_status => {
        total_allocated => <coding.budget.allocated>,
        total_used      => <coding.budget.used>,
        remaining       => <coding.budget.allocated> - <coding.budget.used>,
        percentage_used => sprintf( "%.1f",
            ( <coding.budget.used> / <coding.budget.allocated> ) * 100 ),
        status => <[coding.helper.budget_status]>->(
            ( <coding.budget.used> / <coding.budget.allocated> ) * 100
        )
    }
};

