## [:< ##

# name  = v7-zenki.login-session.zenki
# descr = the configured login session zenki list [ start order ]

my @zenki = grep {m{^[a-z0-9][a-z0-9_.-]*(?:\[[a-z0-9_.-]+\])?$}}
    split( m| +|, <v7-zenki.cfg.login_session_zenki> // qw| compton | );
return @zenki;

