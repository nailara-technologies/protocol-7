## [:< ##

# name   = invoke-web.gpu.requeue
# descr  = after the restart of a cuda error recovery : retry the items that
#          failed on 'CUDA error' since shortly before it [ no copy of them
#          yet ], then resume the queue [ invoke-web.handler.gpu_requeue_reply ]

my $recover = <invoke-web.gpu_recover> // return;

## queue db times are utc ; 15 minutes before the first error ##
my $since = POSIX::strftime( '%Y-%m-%d %H:%M:%S',
    gmtime( $recover->{'time'} - 900 ) );

my $dbh = <[invoke-web.queue.db]>;
my $ids
    = defined $dbh
    ? $dbh->selectcol_arrayref(
    "SELECT q.item_id FROM session_queue q WHERE q.status = 'failed' "
        . "AND q.error_message LIKE 'CUDA error%' AND q.updated_at >= ? "
        . 'AND NOT EXISTS ( SELECT 1 FROM session_queue c '
        . 'WHERE c.retried_from_item_id = q.item_id ) ORDER BY q.item_id',
    undef, $since
    )
    : undef;

if ( not defined $ids or not @$ids ) {
    <[base.logs]>->( 1, 'gpu : no cuda-failed items to retry' );
    return <[invoke-web.handler.gpu_requeue_reply]>->( { 'ok' => TRUE } );
}

<[invoke-web.api_async]>->(
    'PUT',                      '/api/v1/queue/default/retry_items_by_id',
    [ map { $ARG + 0 } @$ids ], 'invoke-web.handler.gpu_requeue_reply',
    { 'count' => scalar @$ids }
);

