## [:< ##

# name  = coding.tools.handler.note_history
# descr = show modification history for a note section

my $args = shift // {};

my $section = $args->{'section'} // '';
my $task_id = $args->{'task_id'} // '';
my $count   = $args->{'count'}   // 5;

return { 'content' => 'section required' }
    unless length $section;

## call backend ##
my $result = <[note.history]>->(
    $section, length $task_id ? $task_id : undef, $count,
);

return {
    'content' => $result->{'mode'} ne qw| false |
    ? $result->{'data'}
    : "Failed: " . ( $result->{'data'} // 'unknown' ),
};

