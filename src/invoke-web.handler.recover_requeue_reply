# name  = invoke-web.handler.recover_requeue_reply
# descr = interrupted items retried : resume the queue, recovery done
# note  = cuda recovery : always resumed [ it was rendering ]. crash
#         recovery : resumed only when an item was interrupted -- a queue
#         that was paused before the crash stays paused [ start_paused ]

my $reply   = shift // {};
my $count   = $reply->{'params'}->{'count'};
my $recover = delete <invoke-web.recover> // {};
my $kind    = $recover->{'kind'}          // qw| recover |;

<[base.logs]>->(
    $reply->{'ok'} ? 1 : 0,
    '%s : %s',
    $kind,
    $reply->{'ok'}
    ? sprintf( '%d interrupted ' . 'item%s re-queued',
        $count, $count == 1 ? '' : 's' )
    : "retry failed [ $reply->{'status'} ] -- queue stays paused"
) if defined $count;

<[invoke-web.retried]>->( $reply->{'params'}->{'ids'} )
    if $reply->{'ok'} and defined $reply->{'params'}->{'ids'};

return if not $reply->{'ok'};
if ( $kind eq qw| crash | and not $count ) {
    <[base.logs]>->( 1, 'crash : invoke.ai back, queue stays paused' );
    return;
}

<[invoke-web.api_async]>->(
    'PUT', '/api/v1/queue/default/processor/resume',
    undef,
    'invoke-web.handler.recover_resume_reply',
    { 'kind' => $kind }
);

