## [:< ##

# name  = index.source.register
# descr = register source_id with its HEAD checksum and activate

my ( $source_id, $chk, $policy ) = @ARG;
$policy //= 'snapshot';
<index.sources>->{$source_id}      = $chk;
<index.chain_policy>->{$source_id} = $policy;
<[index.activate]>->($chk);
return TRUE;

