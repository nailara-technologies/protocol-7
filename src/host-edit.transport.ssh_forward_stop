# name   = host-edit.transport.ssh_forward_stop
# descr  = stop a record's ssh forward [ or all of them ]
# param  = [ <record name> ]
# return = number of forwards stopped

my $only = shift;

require POSIX;
my $forwards = <host-edit.forwards> // {};
my $stopped  = 0;
foreach my $name ( sort keys $forwards->%* ) {
    next if defined $only and $name ne $only;
    my $pid = $forwards->{$name}->{'pid'};
    if ( defined $pid and $pid > 1 ) {
        kill( qw| TERM |, $pid );
        ## reap without a $SIG handler [ give it a moment, never block ] ##
        foreach ( 1 .. 20 ) {
            last if waitpid( $pid, POSIX::WNOHANG() ) != 0;
            select( undef, undef, undef, 0.05 );
        }
    }
    delete $forwards->{$name};
    $stopped++;
}
return $stopped;

