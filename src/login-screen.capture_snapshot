# name  = login-screen.capture_snapshot
# descr = capture the live root window into an in-memory pixbuf

my $window = <login-screen.window>      // return undef;
my $screen = $window->get_screen()      // return undef;
my $root   = $screen->get_root_window() // return undef;

my $pixbuf = eval {
    Gtk3::Gdk::pixbuf_get_from_window( $root, 0, 0, $root->get_width(),
        $root->get_height() );
};
if ( length $EVAL_ERROR or not defined $pixbuf ) {
    <[base.log]>
        ->( 0, 'lock snapshot capture failed; using dark background' );
    return undef;
}
$pixbuf;

