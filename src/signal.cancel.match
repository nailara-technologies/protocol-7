## [:< ##

# name  = signal.cancel.match
# descr = apply signal cancellation library to one log line

my $line = $ARG[0] // '';

return { 'matched' => 0 } if not length $line;

if ( ref(<signal.cancel.library>) ne qw| HASH |
    or not exists <signal.cancel.library.compiled> ) {
    <[signal.cancel.load]>;
}

my $library = <signal.cancel.library>;

foreach my $entry ( $library->{'compiled'}->@* ) {
    next if not defined $entry->{'compiled'};
    if ( $line =~ $entry->{'compiled'} ) {
        my $pattern_id = sprintf qw| %s.%s |, $entry->{'category'},
            $entry->{'name'};
        return {
            'matched'    => 1,
            'category'   => $entry->{'category'},
            'pattern'    => $entry->{'name'},
            'pattern_id' => $pattern_id,
            'label'      => $pattern_id
        };
    }
}

return { 'matched' => 0 };

