## [:< ##

# name  = mpv.handler.event.end-file
# descr = mpv 'end-file' event : surface playback failures loudly when this
#         instance is audio-only [ playback IS the entire intent there ]

my $params = shift;

return 0 if ( $params->{'reason'} // '' ) ne qw| error |;

my $file_error = $params->{'file_error'} // 'unknown error';

## audio-only zenka : nothing else was ever going to happen with this file  ##
## besides play its audio, so any end-file error here is a total failure of ##
## the only intent -- always surface it, not just at debug                  ##
if (<mpv.audio_only>) {
    <[base.log]>->(
        0, sprintf( 'playback failed [ ' . 'audio-only ] : %s', $file_error )
    );
} else {
    <[base.log]>->( 1, sprintf( 'playback failed : %s', $file_error ) );
}

0;

