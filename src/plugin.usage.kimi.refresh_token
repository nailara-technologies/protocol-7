## [:< ##

# name  = plugin.usage.kimi.refresh_token
# descr = start `kimi` fully detached from any controlling terminal, chdir'd
#         into an already-trusted directory, stdin pre-loaded with a single
#         enter keypress then eof, let it run undisturbed for the full
#         timeout, then ask it to exit gracefully [ sigterm, sigkill only as
#         a last resort ] -- the kimi cli refreshes its own oauth token
#         during startup, before it ever reaches a point that would cost a
#         real inference token.
# param = [ timeout ] [ { on_done => { handler => <name>, params => {} } } ]
# note  = NON-BLOCKING since 2026-09-15 : the child side and the kill
#         discipline are unchanged, but the parent's full-timeout wait runs
#         as Event watchers [ io on the child's stdout + deadline timer +
#         reap polling ] instead of the original blocking select loop --
#         that loop stalled the whole usage zenka event loop for up to
#         ~21 seconds, and a concurrent claude rate-limit probe [ 15s
#         timeout ] fired its deadline the moment the loop resumed : first
#         combined query after a kimi token expiry always killed the claude
#         side while kimi itself recovered via the transparent retry.
# note  = all event callbacks are NAMED HANDLERS [ plugin.usage.kimi.
#         refresh_io / refresh_timeout / refresh_reap ], not coderef
#         closures -- the timer/io watchers outlive any single refresh
#         cycle and a source reload mid-cycle must not leave stale compiled
#         closures registered ; the shared per-cycle state lives in the
#         single-slot <usage.provider.kimi>{'refresh_state'} and every
#         handler resolves it from there. see the reload-safety rationale
#         in base.event.add_timer's handler branch.
# note  = the actual root cause, found the hard way 2026-09-15 : kimi shows a
#         one-time "Trust this folder?" prompt for any working directory it
#         hasn't seen before [ tracked in ~/.kimi-code/workspaces.json ], and
#         a plain /dev/null stdin gave it nothing to confirm that prompt with
#         -- never reaching the oauth refresh at all. a diagnostic capture of
#         raw stdout confirmed the prompt text directly. this zenka's own cwd
#         was never confirmed [ /proc/<pid>/cwd reads were permission-denied
#         from outside the process ] and evidently isn't a trusted workspace
#         -- chdir to <system.root_path> [ falls back to $home_dir if that's
#         ever unset ], both already trusted, is the real fix ; the enter-
#         keypress-then-eof stdin is a belt-and-suspenders second line of
#         defense in case a prompt shows up for some other reason anyway
# note  = this zenka process itself also runs attached to a real pty
#         [ confirmed live 2026-09-15 via ps -ef ], most likely because it was
#         originally started interactive -- and neither IPC::Open3 nor a
#         plain fork+exec detaches a child from an inherited controlling
#         terminal on its own. setsid() below sheds it. real, independently
#         justified hardening, but confirmed NOT sufficient by itself to fix
#         the actual bug above
# note  = sigkill cannot be caught -- if the refreshed credential is written
#         on a deferred \ on-exit flush path rather than immediately after
#         the network call, sigkill would silently discard it no matter how
#         long the timeout was. sigterm first, sigkill only as a fallback
# note  = a real pty [ via pty.spawn ] was also tried live 2026-09-15, on the
#         theory kimi might be blocking on a terminal capability query a pipe
#         can't answer. it wasn't the issue, and made things worse : giving
#         the child an even more explicit terminal only reinforced whatever
#         code path the inherited-tty problem above was already triggering
# note  = manual fork [ not IPC::Open3 ] specifically so the child can call
#         setsid() between fork and exec -- open3 gives no hook for that

use POSIX ();

## the proven-working test used 15s, undisturbed for the full duration -- this
## is not a rarely-hit ceiling, it's the actual normal run length
my $timeout = shift // 18;
my $args    = shift // {};

##  caller passes { on_done => { handler => <name>, params => {} } }  [ this
##  module's own documented interface ] -- unwrap ; a bare { handler, params }
##  hash is also accepted so both call shapes keep working. found live
##  2026-09-16 : reading $args->{'handler'} directly, on the outer hash, made
##  the on_done test fail on EVERY call [ the key lives one level down ] --
##  refresh_state->{'on_done'} silently stayed undef, the transparent retry
##  after a token refresh was never scheduled, and every first request with an
##  expired token fell into the query guard timeout [ 'provider did not
##  report back in time' ] while the still-running kimi child refreshed the
##  credential on disk -- which is exactly why the SECOND query always worked
my $on_done = $args;
$on_done = $args->{'on_done'}
    if ref $args eq qw| HASH |
    and ref $args->{'on_done'} eq qw| HASH |;

my $provider = <usage.provider.kimi>;

## reload from disk before spawning anything : another process [ a running  ##
## kimi_dispatch, a prior refresh cycle from this same zenka, or anything   ##
## else that touches the same credential file ] may have already refreshed  ##
## it between the failed request that got us here and this call --          ##
## confirmed live 2026-09-17 : a running kimi_dispatch overlapped exactly   ##
## this path, and there is no locking between this zenka's own refresh      ##
## spawn and any other process writing the same file [ see                  ##
## plugin.usage.kimi.read_credential's module note ]. spawning a whole      ##
## extra `kimi` process costs a real ~15-21s [ see this module's own header ##
## note ] for nothing if the file is already fresh -- skip the fork         ##
## entirely and go straight to on_done, same completion contract the real   ##
## fork path uses via plugin.usage.kimi.refresh_cleanup                     ##
my $now  = time;
my $cred = <[plugin.usage.kimi.read_credential]>;

<[base.logs]>->(
    2,
    '[usage.kimi.refresh_token] on-disk credential check : '
        . 'token=%s expires_at=%s [ %ds from now ] margin=%ds error=%s',
    length $cred->{'token'} ? 'present' : 'MISSING',
    $cred->{'expires_at'} // 'undef',
    defined $cred->{'expires_at'} ? $cred->{'expires_at'} - $now : -1,
    $provider->{'expiry_warn'} // 0,
    length $cred->{'error'} ? $cred->{'error'} : 'none'
);

if (    length $cred->{'token'}
    and defined $cred->{'expires_at'}
    and $cred->{'expires_at'} > $now + $provider->{'expiry_warn'} ) {
    <[base.logs]>->(
        1,
        '[usage.kimi.refresh_token] on-disk credential already '
            . 'fresh [ expires in %ds ] : skipping refresh spawn',
        $cred->{'expires_at'} - $now
    );
    $code{ $on_done->{'handler'} }->( $on_done->{'params'} // {} )
        if ref $on_done eq qw| HASH |
        and length( $on_done->{'handler'} // '' )
        and exists $code{ $on_done->{'handler'} };
    return TRUE;
}

## single slot : never stack two refresh children on top of each other -- but
## a caller arriving while one is already in flight still needs to know when
## THAT cycle finishes, not fire its own uncoordinated fallback. found live
## 2026-09-17 : plugin.usage.kimi.handler.response used to treat this branch's
## old FALSE return as "nothing will ever call me back" and fired an immediate
## retry fetch of its own -- which almost always raced the already-running
## refresh child (a real kimi startup cycle takes the full ~15-18s this
## module's own timeout accounts for) and reported a false "refresh already
## attempted and did not help" error moments before the SAME in-flight refresh
## would have succeeded on its own. queuing onto the existing cycle's on_done
## list instead means every waiter [ the original starter, a
## proactive-watchdog trigger, any number of reactive 401s that land while
## it's running ] gets notified exactly once, when the one real refresh
## actually completes -- TRUE now means "on_done WILL fire, now or later", not
## "I personally started a child"
if ( ref $provider->{'refresh_state'} eq qw| HASH | ) {
    <[base.logs]>->(
        1,
        '[usage.kimi.refresh_token] refresh already in progress '
            . '[ pid %d ] : queuing onto it instead of starting another',
        $provider->{'refresh_state'}->{'pid'} // 0
    );
    push @{ $provider->{'refresh_state'}->{'on_done_list'} //= [] },
        {
        'handler' => $on_done->{'handler'},
        'params'  => $on_done->{'params'} // {}
        }
        if ref $on_done eq qw| HASH |
        and length( $on_done->{'handler'} // '' );
    return TRUE;
}

## PATH lookup first [ base.file.which -> File::Which ] -- kept as the
## general-case-correct approach, but confirmed live 2026-09-15 that it will
## always come up empty in THIS deployment specifically: bin/Protocol-7
## deliberately cleans $ENV{PATH} at zenka startup, so it never carries the
## ~/.kimi-code/bin entry an interactive shell's rc files add. the
## home-relative fallback below is what actually locates the binary here,
## every time -- not a rarely-needed backup for an edge case
my $kimi_bin = <[file.which]>->(qw| kimi |);

## needed regardless of how kimi_bin was found : see the chdir before exec
## below
my $home_dir = ( getpwuid($UID) )[7] // $ENV{'HOME'} // '';

if ( not length $kimi_bin ) {
    if ( length $home_dir and length $provider->{'cli_rel_path'} ) {
        my $candidate = catfile( $home_dir, $provider->{'cli_rel_path'} );
        $kimi_bin = $candidate if -x $candidate;
    }
}

if ( not length $kimi_bin ) {
    <[base.logs]>->(
        0,
        '[usage.kimi.refresh_token] cannot locate kimi binary '
            . '[ PATH lookup and known install path both failed ]'
    );
    return FALSE;
}

my ( $stdin_read, $stdin_write, $out_read, $out_write, $err_read,
    $err_write );

if (not(    pipe( $stdin_read, $stdin_write )
        and pipe( $out_read, $out_write )
        and pipe( $err_read, $err_write ) )
) {
    <[base.logs]>->(
        0, '[usage.kimi.refresh_token] cannot create pipes : %s',
        <[base.str.os_err]>
    );
    ## whichever pipe succeeded before the other failed is still open ##
    foreach my $fh (
        $stdin_read, $stdin_write, $out_read,
        $out_write,  $err_read,    $err_write
    ) {
        close($fh) if defined $fh and defined fileno($fh);
    }
    return FALSE;
}

## belt-and-suspenders alongside the chdir below : pre-load a single enter
## keypress on stdin, in case a first-run confirmation prompt [ "trust this
## folder?" or similar ] shows up despite chdir'ing into an already-trusted
## directory. the write end is closed right after, so the child sees this one
## line and then eof after it -- same effective behavior /dev/null had from
## that point on
print $stdin_write "\n";
close($stdin_write);

my $pid = fork();

if ( not defined $pid ) {
    <[base.logs]>->(
        0, '[usage.kimi.refresh_token] fork failed : %s',
        <[base.str.os_err]>
    );
    foreach
        my $fh ( $stdin_read, $out_read, $out_write, $err_read, $err_write ) {
        close($fh) if defined $fh and defined fileno($fh);
    }
    return FALSE;
}

if ( $pid == 0 ) {
    ## detach from whatever controlling terminal this zenka process itself
    ## happens to be attached to -- the actual fix, see the module note above
    POSIX::setsid();

    ## the actual root cause, found the hard way 2026-09-15 : kimi shows a
    ## first-run "Trust this folder?" prompt for any cwd it hasn't seen before
    ## [ tracked in ~/.kimi-code/workspaces.json ], and blocks on it forever
    ## since stdin gives it nothing to confirm with -- never reaching the
    ## oauth refresh at all. this zenka's own cwd was never confirmed [
    ## /proc/<pid>/cwd reads were permission-denied from outside the process ]
    ## and evidently isn't a trusted workspace. <system.root_path> [ this
    ## project's own root, set once at process bootstrap in bin/Protocol-7,
    ## identical for every zenka ] already is one -- more correct than a
    ## hardcoded path or $home_dir, which would pollute the user's own
    ## interactive kimi workspace list with a background ping
    chdir( <system.root_path> // $home_dir );

    close($out_read);
    close($err_read);
    open( STDIN,  '<&', $stdin_read ) or POSIX::_exit(1);
    open( STDOUT, '>&', $out_write )  or POSIX::_exit(1);
    open( STDERR, '>&', $err_write )  or POSIX::_exit(1);
    close($stdin_read);
    close($out_write);
    close($err_write);
    { exec($kimi_bin) };
    POSIX::_exit(1);    ##  exec itself failed  ##
}

close($stdin_read);
close($out_write);
close($err_write);

## from here on the parent NEVER BLOCKS, and no event callback is a coderef ##
## closure : the io watcher, the deadline timer and the reap poll are all   ##
## named handlers resolving the single-slot per-cycle state below           ##
## on_done_list, not a single on_done : any number of callers can queue     ##
## onto this one real cycle via the single-slot-busy branch above, this     ##
## call's own on_done [ if any ] is simply the list's first entry           ##
$provider->{'refresh_state'} = {
    'pid'          => $pid,
    'fh'           => $out_read,
    'err_fh'       => $err_read,
    'buffer'       => '',
    'deadline'     => <[base.time]> + $timeout,
    'on_done_list' => (
        ref $on_done eq qw| HASH | and length( $on_done->{'handler'} // '' )
        )
    ? [
        {   'handler' => $on_done->{'handler'},
            'params'  => $on_done->{'params'} // {},
        }
        ]
    : [],
    'io_w'       => undef,
    'timer_w'    => undef,
    'reap_timer' => undef,
};

$provider->{'refresh_state'}->{'io_w'} = <[event.add_io]>->(
    {   'fd'      => fileno($out_read),
        'poll'    => qw| r |,
        'desc'    => 'kimi refresh stdout',
        'handler' => qw| plugin.usage.kimi.refresh_io |,
    }
);

## the tui keeps redrawing rather than ever closing its own stdout, so this
## deadline firing is the normal, expected outcome -- not a failure signal
$provider->{'refresh_state'}->{'timer_w'} = <[event.add_timer]>->(
    {   'after'   => $timeout,
        'desc'    => 'kimi refresh deadline',
        'handler' => qw| plugin.usage.kimi.refresh_timeout |,
    }
);

return TRUE;

