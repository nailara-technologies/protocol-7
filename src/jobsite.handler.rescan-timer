## [:< ##

# name  = jobsite.handler.rescan-timer
# descr = periodic rescan timer : triggers fetch when idle

return if <[jobsite.replica.enabled]>;

## a busy cycle [ a long assessment run ] used to DROP the scan : the next ##
## try came a full rescan_interval later, and failed assessments waited    ##
## that long for their retry. now it is owed : dispatch.consume_slot runs  ##
## it as soon as the cycle turns idle                                      ##
if ( <jobsite.cycle> ne 'idle' ) {
    <jobsite.rescan_due> = TRUE;
    <[base.logs]>->(
        1, 'rescan timer : cycle %s, scan owed for idle',
        <jobsite.cycle>
    );
    return;
}
<jobsite.rescan_due> = FALSE;

<[jobsite.store.prune]>;

<[base.logs]>->( 1, 'rescan timer : starting fetch' );
<[jobsite.stage.fetch]>;

