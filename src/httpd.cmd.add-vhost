## [:< ##

# name = httpd.cmd.add-vhost
# descr = add virtual host directory with default index

my $args       = $call->{'args'} // '';
my @args       = split m{\ +}, $args;
my $domain     = $args[0];
my $index_mode = grep {m{^:index:$}} @args;

unless ($domain) {
    return {
        'mode' => qw| false |,
        'data' => 'domain parameter required'
    };
}

## Validate domain format
if ($domain !~ m{^
    [a-zA-Z0-9]                             ## first character [ alphanumeric ]
    (?:[a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?    ## middle section [ optional, 0-61 chars ]
    (?:
        \.                                  ## dot separator
        [a-zA-Z0-9]                         ## label first character
        (?:[a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])? ## label middle section [ optional ]
    )*                                      ## repeat for each subdomain
    $
}x
) {
    return {
        'mode' => qw| false |,
        'data' => sprintf 'domain format not valid : %s',
        $domain
    };
}

<[base.logs]>->( 2, 'adding vhost for domain: %s', $domain );

## Configuration
my $site_dir             = <httpd.site_dir>     // qw| /var/httpd |;
my $httpd_user           = <httpd.system.user>  // qw| httpd |;
my $httpd_group          = <httpd.system.group> // qw| httpd |;
my $create_default_index = <httpd.cfg.create_default_index> // FALSE;

my ( undef, undef, $httpd_uid, $httpd_gid ) = getpwnam($httpd_user);

if ( !defined $httpd_uid ) {
    return {
        'mode' => qw| false |,
        'data' => sprintf "httpd user '%s' does not exist",
        $httpd_user
    };
}

## Paths
my $vhost_path = join qw| / |, $site_dir, $domain;

## Check if vhost already exists
if ( -e $vhost_path ) {
    <[base.logs]>->( 1, 'vhost already exists: %s', $domain );

    return {
        'mode'       => qw| true |,
        'data'       => 'vhost already exists',
        'domain'     => $domain,
        'vhost_path' => $vhost_path
    };
}

## Step 1: Create vhost directory
my $create_dir_result = <[httpd.path.create_vhost_dir]>->(
    $vhost_path, $httpd_uid, $httpd_gid, $httpd_user
);
unless ($create_dir_result) {
    <[base.logs]>->( 0, 'vhost directory creation failed: %s', $vhost_path );
    return {
        'mode' => qw| false |,
        'data' => 'failed to create vhost directory'
    };
}

## Step 2: Create default index page [ if configured or requested ]
if ( $create_default_index || $index_mode ) {
    my $create_index_result = <[httpd.path.create_default_index]>->(
        $vhost_path, $domain, $httpd_uid, $httpd_gid
    );
    unless ($create_index_result) {
        <[base.logs]>->(
            0, 'default index creation failed : %s', $vhost_path
        );
        return {
            'mode' => qw| false |,
            'data' => 'failed to create default index page'
        };
    }
}

## Step 3: Rescan site directory
<[base.logs]>->( 2, 'rescanning site directory for %s', $domain );
<[httpd.scan_site_dir]>;

## Verify vhost was discovered
if ( !exists <httpd.cfg.hostnames>->{$domain} ) {
    return {
        'mode' => qw| false |,
        'data' => 'vhost created but not discovered in scan'
    };
}

<[base.logs]>->( 2, ': vhost registered successfully : %s', $domain );

## Step 4: Add to vhost registry list
my $vhost_id = <[base.list.element.add]>->(
    {   'key_ref' => \<httpd.vhosts.registry>,
        'val_ref' => \{
            'domain'   => $domain,
            'path'     => $vhost_path,
            'cert'     => FALSE,
            'status'   => qw| active |,
            'added_at' => <[base.ntime]>
        }
    }
);

if ( !defined $vhost_id ) {
    <[base.log]>->( 0, 'failed to add vhost to registry list' );
} else {
    <httpd.vhosts.by_domain>->{$domain} = $vhost_id;
    <[base.logs]>->( 2, 'vhost added to registry : id=%s', $vhost_id );
}

my $result = {
    'mode'       => qw| true |,
    'data'       => 'vhost created successfully',
    'domain'     => $domain,
    'vhost_path' => $vhost_path,
    'vhost_id'   => $vhost_id
};

<[base.logs]>->( 1, ': vhost created successfully : %s', $domain );

return $result;

