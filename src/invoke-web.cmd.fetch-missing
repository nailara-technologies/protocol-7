# name  = invoke-web.cmd.fetch-missing
# descr = fetch a missing model [ no param : fetch states ]
# param = [ model ]

my $arg = $call->{'args'} // '';
$arg =~ s{^\s+|\s+$}{}g;

my $missing = <invoke-web.missing_at_render> // {};

if ( not length $arg ) {
    return {
        mode => qw| false |,
        data => 'no render failed on a missing model'
        }
        if not keys %$missing;
    return {
        mode => qw| size |,
        data => join(
            '',
            map {
                my $f = $missing->{$ARG}->{'fetch'} // {};
                sprintf "%-40s %-11s %s\n",
                    $ARG,
                    $f->{'state'} // qw| seen |,
                    $f->{'reason'} // $missing->{$ARG}->{'path'} // '';
            } sort keys %$missing
        )
    };
}

my $result = <[invoke-web.autofetch]>->( $arg, TRUE );

return { mode => qw| false |, data => 'autofetch failed' }
    if not defined $result;

return {
    mode => $result->{'ok'} ? qw| size | : qw| false |,
    data => $result->{'msg'} // 'no result'
};

