## [:< ##

# name  = invoke-web.handler.output_adopt
# descr = timer : follow the output of an adopted invoke.ai from the offset
#         the previous instance saved [ same pid ], else from the file end

my $event = shift;
my $pid   = eval { $event->w->data->{'pid'} } // return;

my $saved = <[file.zenka_dir.load]>->('state/invokeai.out.offset');
my ( $saved_pid, $offset ) = split m|\s+|, defined $saved ? $saved->$* : '';
$offset = undef if not defined $saved_pid or $saved_pid != $pid;

<[invoke-web.output.follow]>->( $pid, $offset, qw| reattached | );

