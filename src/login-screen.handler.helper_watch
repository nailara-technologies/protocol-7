## [:< ##

# name = login-screen.handler.helper_watch
# descr = a dead root helper is fatal : v7 restarts the greeter

my $pid  = <login-screen.auth_helper.pid> // return FALSE;
my $done = waitpid( $pid, POSIX::WNOHANG() );
return TRUE if $done == 0;

## a waitpid error is not itself proof of death ; EPERM also means alive ##
if ( $done < 0 ) {
    return TRUE if kill( 0, $pid ) or $ERRNO == POSIX::EPERM();
}

my $detail = $done == $pid ? sprintf( 'status %d', $CHILD_ERROR ) : $OS_ERROR;
<[base.logs]>->(
    0,    'login-screen root helper ended [ pid %d : %s ]',
    $pid, $detail
);
<login-screen.auth_helper.pid> = undef;
Gtk3->main_quit();
FALSE;

