## [:< ##

# name = login-screen.handler.helper_watch
# descr = a dead root helper is fatal : v7 restarts the greeter

my $pid  = <login-screen.auth_helper.pid> // return FALSE;
my $done = waitpid( $pid, POSIX::WNOHANG() );
return TRUE if $done == 0;

<[base.logs]>->( 0, 'login-screen root helper ended [ pid %d ]', $pid );
<login-screen.auth_helper.pid> = undef;
Gtk3->main_quit();
FALSE;

