## [:< ##

# name  = sessions.cmd.spawn
# descr = spawn the key-holding child

my $ok = <[sessions.holder.parent]>->('start');

return {
    'mode' => qw| size |,
    'data' => sprintf( "%s\n", $ok ? '<< spawned >>' : '<< spawn failed >>' )
};

