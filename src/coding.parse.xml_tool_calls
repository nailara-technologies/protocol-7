## [:< ##

# name  = coding.parse.xml_tool_calls
# descr = parse xml-format tool calls from model content or reasoning_content
# purpose = models emit <tool_call><function=name><parameter=k>v</parameter></function>
#           instead of structured tool_calls : extract as structured array

my ($text) = @ARG;

return [] unless defined $text && length $text;

my @tool_calls;
my $call_idx = 0;

## match each <tool_call>...</tool_call> or bare <function=...> block        ##
## pattern:                                                                  ##
## <tool_call>\n<function=NAME>\n<parameter=K>\nV\n</parameter>\n</function> ##
## also handles: content before/after, optional whitespace, missing          ##
## </tool_call>                                                              ##

while (
    $text =~ m{
        (?:<tool_call>\s*)?          ## optional <tool_call> wrapper
        <function\s*=\s*(\w+)\s*>    ## <function=TOOL_NAME>
        (.*?)                        ## parameters block
        </function>                  ## closing tag
        (?:\s*</tool_call>)?         ## optional closing wrapper
    }gsx
) {
    my $tool_name  = $1;
    my $params_raw = $2;

    ## extract parameters ##
    my %params;
    while (
        $params_raw =~ m{
            <parameter\s*=\s*(\w+)\s*>   ## <parameter=KEY>
            (.*?)                         ## value
            </parameter>                  ## closing tag
        }gsx
    ) {
        my $key = $1;
        my $val = $2;
        ## trim leading/trailing whitespace from value ##
        $val =~ s|^\s+||;
        $val =~ s|\s+$||;
        $params{$key} = $val;
    }

    ## build structured tool call  arguments as CHARACTER string          ##
    ## [ utf8(0) ] -- not encode_json octets : the model content arriving ##
    ## here is already decoded to characters, and octets would            ##
    ## Latin-1-mangle on any utf8(0) consumer downstream                  ##
    ## [ the 2026-10-25 double-encode : C3 A2 C2 80 C2 94 on disk ].      ##
    ## consumers parse layer-aware [ coding.async.tool_args_decode ] so   ##
    ## both forms work                                                    ##
    my $call_id = sprintf( 'xmlcall_%d_%d', $$, $call_idx );
    push @tool_calls,
        {
        'id'       => $call_id,
        'type'     => 'function',
        'function' => {
            'name'      => $tool_name,
            'arguments' => JSON::PP->new->utf8(0)->encode( \%params ),
        },
        };

    $call_idx++;
}

if (@tool_calls) {
    <[base.logs]>->(
        1,
        "parse.xml_tool_calls: extracted %d tool calls from xml content",
        scalar @tool_calls
    );
    for my $tc (@tool_calls) {
        <[base.logs]>->(
            2,
            "parse.xml_tool_calls: %s(%s)",
            $tc->{'function'}->{'name'},
            substr( $tc->{'function'}->{'arguments'}, 0, 80 )
        );
    }
}

return \@tool_calls;

