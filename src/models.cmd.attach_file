## [:< ##

# name = models.cmd.attach_file
# descr = attach file to conversation [ STRM-SIZE support ]

# Extract params - $call is set by code header
my $params = {};

if ( defined $call->{'param'} && ref $call->{'param'} eq qw| HASH | ) {
    $params = $call->{'param'};
} elsif ( defined $call->{'args'} && length $call->{'args'} ) {

    # Try parsing as JSON first, fall back to YAML
    eval { $params = JSON::PP::decode_json( $call->{'args'} ); };
    if ($EVAL_ERROR) {
        $params = <[format.yaml.load_str]>->( $call->{'args'} ) // {};
    }
}

my $job_id   = $params->{'job_id'}   // '';
my $filepath = $params->{'filepath'} // '';
my $checksum = $params->{'checksum'} // '';
my $context  = $params->{'context'}  // 'conversation';

if ( !length($job_id) ) {
    return {
        'mode' => 'false',
        'data' => "error: job_id required\n"
    };
}

if ( !length($filepath) ) {
    return {
        'mode' => 'false',
        'data' => "error: filepath required\n"
    };
}

my $result = <[models.attach_file]>->(
    {   'job_id'   => $job_id,
        'filepath' => $filepath,
        'checksum' => $checksum,
        'context'  => $context,
    }
);

if ( !$result->{'success'} ) {
    return {
        'mode' => 'false',
        'data' => "error: "
            . ( $result->{'error'} // 'unknown error' ) . "\n"
    };
}

my $yaml_data = YAML::XS::Dump($result);
return {
    'mode' => 'size',
    'data' => $yaml_data
};

