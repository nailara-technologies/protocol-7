## [:< ##

# name  = form.handler.secret_hold_reply
# descr = reply handler for sessions.hold. sessions.cmd.* uses
#         mode=>size UNIFORMLY for success and failure [ confirmed
#         against the actually-shipped sessions.cmd.* files -- not
#         mode=>false like users.cmd.* uses ], so failure is detected
#         from the '<<' prefix in the data string, not from 'cmd'.

my ($info) = @ARG;

my $reply_data = $info->{'data'} // '';

if ( $reply_data =~ m|^\s*<<| ) {
    print sprintf( "\n  << hold failed: %s >>\n\n", $reply_data );
    <[base.exit]>;
    return FALSE;
}

my $index = <form.test.index>;
my $case  = <form.test.cases>->[$index];

<[base.logs]>->(
    2,      ': secret roundtrip case %d [ %s ]: held ok, sending release',
    $index, $case->{'label'}
);

## immediately fires a SECOND cross-zenka call from inside this reply    ##
## handler, still inside the event loop -- the exact pattern             ##
## form.handler.value_get_reply already proves live for the SIZE branch, ##
## now used here on that same branch.  routed through the record source  ##
## like every other cross-zenka send                                     ##
my $source = <form.source>               // return FALSE;
my $sender = $source->{'secret_release'} // return FALSE;

<[$sender]>->( $case->{'name'}, qw| form.handler.secret_release_reply | );

return TRUE;

