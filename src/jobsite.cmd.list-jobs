## [:< ##

# name  = jobsite.cmd.list-jobs
# descr = list jobs, optional stage filter

my $filter = $call->{'args'} // '';

my $tasks = <jobsite.tasks> // {};
my @ids   = sort keys %{$tasks};

@ids = grep { ( $tasks->{$ARG}{'stage'} // '' ) eq $filter } @ids
    if length $filter;

if ( not @ids ) {
    return {
        'mode' => 'true',
        'data' => 'no jobs' . ( length $filter ? " (filter: $filter)" : '' ),
    };
}

my $store = <[jobsite.job.load_all]>;

my @lines;
for my $id (@ids) {
    my $rec = $tasks->{$id};
    my $job = $store->{$id} // {};
    my $score
        = length( $rec->{'score'} // '' )
        ? sprintf( ' [%s]', $rec->{'score'} )
        : '';
    push @lines, sprintf '%-14s %-11s%s  %s : %s (%s)',
        $id,
        $rec->{'stage'} // '?',
        $score,
        $job->{'title'}   // '',
        $job->{'company'} // '',
        $job->{'city'}    // '';
}

return { 'mode' => 'size', 'data' => join( "\n", @lines ) };

