## [:< ##

# name  = httpd.vhost.read_manifests
# descr = scan data/web-root/vhosts/ for .vhost-manifest files

my $vhosts_dir = <httpd.vhosts.source_dir>;
$vhosts_dir = <system.root_path> . "/$vhosts_dir"
    if defined <system.root_path> and $vhosts_dir !~ m|^/|;

<[base.logs]>->(
    1, 'vhost source dir: %s [ exists: %s ]',
    $vhosts_dir, ( -d $vhosts_dir ? 'yes' : 'no' )
);

unless ( -d $vhosts_dir ) {
    <[base.logs]>->( 1, 'vhost source dir not found: %s', $vhosts_dir );
    return [];
}

my $dir_fh;
if ( not opendir( $dir_fh, $vhosts_dir ) ) {
    <[base.logs]>->(
        1, 'cannot open vhost source dir [ %s ]',
        <[base.str.os_err]>
    );
    return [];
}

my @hostnames_found;

foreach my $entry ( <[base.sort]>->( readdir $dir_fh ) ) {
    next if $entry =~ m|^\.|;
    my $vhost_path = "$vhosts_dir/$entry";
    next unless -d $vhost_path;

    my $manifest_path = "$vhost_path/.vhost-manifest";
    next unless -f $manifest_path;

    my ( $manifest, $yaml_err ) = <[format.yaml.load_file]>->($manifest_path);
    if ( $yaml_err or not defined $manifest or ref $manifest ne 'HASH' ) {
        <[base.logs]>->(
            1,      'failed to parse manifest for %s [ %s ]',
            $entry, $yaml_err // qw| unknown error |
        );
        next;
    }

    ## wildcard/pattern vhosts: resolve against already-deployed vhost dirs
    if (    $manifest->{'install_matching'}
        and $manifest->{'install_path_pattern'} ) {
        my $pat = $manifest->{'install_path_pattern'};
        ## convert glob pattern to deployed hostnames (scan parent dir)
        my ( $parent, $glob ) = ( $pat =~ m|^(.*)/([^/]+)$| );
        $parent //= '/var/httpd';
        if ( -d $parent ) {
            my $ph;
            if ( opendir $ph, $parent ) {
                for my $name ( readdir $ph ) {
                    next if $name =~ m|^\.| or $name =~ m|\.bak-[A-Z2-7]+$|;
                    ## the manifest's own source name [ 'jobs.vhost' ] is ##
                    ## the template, not a deployment of it               ##
                    next if $name eq $entry;
                    my $pat_re = $glob =~ s|\.|\\.|gr =~ s|\*|[^/]*|r;
                    next unless $name =~ m|^$pat_re$|;
                    next unless -d "$parent/$name";
                    my $resolved = $name;
                    <httpd.vhosts.registry>->{$resolved} = {
                        'manifest' => {
                            %{$manifest},
                            'hostname'     => $resolved,
                            'install_path' => "$parent/$resolved"
                        },
                        'source_path'   => $vhost_path,
                        'hostname'      => $resolved,
                        'discovered_at' => <[base.time]>->(3)
                    };
                    push @hostnames_found, $resolved;
                }
                closedir $ph;
            }
        }
        next;    ## skip the literal pattern entry
    }

    my $hostname = $manifest->{'hostname'} // $entry;

    <httpd.vhosts.registry>->{$hostname} = {
        'manifest'      => $manifest,
        'source_path'   => $vhost_path,
        'hostname'      => $hostname,
        'discovered_at' => <[base.time]>->(3)
    };

    push @hostnames_found, $hostname;
}

closedir($dir_fh);

<[base.logs]>->(
    2,
    'found %d vhost manifest%s',
    scalar @hostnames_found,
    <[base.cnt_s]>->( scalar @hostnames_found )
);

return \@hostnames_found;

