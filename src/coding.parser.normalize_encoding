## [:< ##

# name  = coding.parser.normalize_encoding
# descr = converting encoding parameter to binmode-compatible value
my $encoding = shift // qw| :encoding(UTF-8) |;

## :raw and :bytes are already binmode-compatible ##
if ( $encoding eq qw| :raw | or $encoding eq qw| :bytes | ) {
    return $encoding;
}

## :encoding(UTF-8) requires explicit binmode specification ##
if ( $encoding =~ m|^:encoding\(UTF-8\)$|i or $encoding =~ m{utf\-?8}i ) {
    return qw| :encoding(UTF-8) |;
}

my $enc_name    ## other encodings with validity check ##
    = $encoding =~ m{^:encoding\(([^\)]+)\)$}
    ? $LAST_PAREN_MATCH
    : $encoding;

## encoding valid as PerlIO layer, returning it.. ##
my $found = Encode::find_encoding($enc_name);
return sprintf( qw| :encoding(%s) |, $enc_name )
    if defined $found and $found->perlio_ok;

## not found or not supported by PerlIO layer ##
<[base.logs]>->(
    2,
    ": error : invalid encoding format : '%s' [ use :raw, "
        . ":bytes, :encoding(UTF-8) or :encoding(<other_format>) ]",
    $encoding
);

return undef; ###[ error case : encoding not found or supported by PerlIO ]###

