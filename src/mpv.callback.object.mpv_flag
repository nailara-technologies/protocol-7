## [:< ##

# name  = mpv.callback.object.mpv_flag
# descr = dep callback: resolves TRUE when the named data key is defined

my $obj_id = shift                          // return FALSE;
my $obj    = <dependency.object>->{$obj_id} // return FALSE;
my @keys   = split m|\.|, ( $obj->{'flag_key'} // '' );
return FALSE if not @keys;

my $val = $data{ shift @keys };
$val = $val->{ shift @keys } while @keys and ref $val eq 'HASH';
return defined $val ? TRUE : FALSE;

