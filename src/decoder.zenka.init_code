## [:< ##

# name  = decoder.zenka.init_code
# descr = Initialize decoder : level-5 B32, level-6 D3, Term::VTerm surface

## load Term::VTerm for ANSI/VT sequence parsing ##
<[base.perlmod.autoload]>->('Term::VTerm');
<[base.perlmod.autoload]>->('Term::VTerm::Screen');
<[base.perlmod.autoload]>->('Term::VTerm::Pos');
<[base.perlmod.autoload]>->('Term::VTerm::Rect');

## load harmonic truth for /13 reduction jobs ##
<[base.perlmod.autoload]>->( 'AMOS7::Assert::Truth', qw| is_true | );

## level-5 accumulator state : keyed by stream_id ##
<decoder.level5> = {};

## level-6 D3 state : keyed by stream_id [ was global, now per-stream ] ##
<decoder.level6> = {};
delete $data{'decoder'}{'level6_acc'};    ## clean up old global if present ##

## boundary tracking ##
$data{'decoder'}{'boundary_count'} = 0;
$data{'decoder'}{'INDEXCUBE'}      = [];

## d13 type-prefix histogram : keyed by GFX/B32/DOC/RT/UNK ##
$data{'decoder'}{'d13_types'} = {};

## initialize level-5-B32 rolling buffer ##
if ( not exists <buffer.level-5-B32> ) {
    <buffer.level-5-B32.max_size> = 65536;
    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
    <[base.buffer.add_line]>->(
        qw| level-5-B32 |,
        join( ' ',
            $time_stamp, 0, 'level-5 base32 accumulator initialized .., ' ),
        0
    );
}

## initialize level-6-D3 rolling buffer ##
if ( not exists <buffer.level-6-D3> ) {
    <buffer.level-6-D3.max_size> = 65536;
    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
    <[base.buffer.add_line]>->(
        qw| level-6-D3 |,
        join( ' ',
            $time_stamp, 0,
            'level-6 d3 linguistic projection initialized .., ' ),
        0
    );
}

## initialize level-7-D13 rolling buffer ##
if ( not exists <buffer.level-7-D13> ) {
    <buffer.level-7-D13.max_size> = 65536;
    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
    <[base.buffer.add_line]>->(
        qw| level-7-D13 |,
        join( ' ',
            $time_stamp, 0,
            'level-7 d13 type-prefix decode initialized .., ' ),
        0
    );
}

## initialize Term::VTerm surface : 25×80 terminal [ matches xterm wrapper ##
## ]                                                                       ##
$data{'decoder'}{'vterm'} = Term::VTerm->new( rows => 25, cols => 80 );
my $screen = $data{'decoder'}{'vterm'}->obtain_screen;
$screen->set_damage_merge(2);    ## VTERM_DAMAGE_SCROLL ##
$data{'decoder'}{'vterm_screen'} = $screen;

## stream attachment registry ##
<decoder.attached_streams> = [];

## async job queue : entropy reduction and buffer analysis ##
<decoder.jobs> //= {};

<list.decoder-jobs> = {
    'var'   => qw| data |,
    'key'   => 'decoder.jobs',
    'mask'  => '<key>:job-id job-type stream_id total cursor',
    'align' => {
        'job-type'  => 'left',
        'stream_id' => qw| center-2 |,
    },
    'descr' => 'active [running] decoder jobs'
};

<[base.log]>->(
    2,
    "decoder initialized : level-5 B32, level-6 "
        . "D3, level-7 D13, vterm 25×80, jobs queue"
);

return TRUE;

