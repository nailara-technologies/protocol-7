## [:< ##

# name   = work.console.shortcuts
# descr  = display available workflow shorthand aliases and usage patterns

my $reset       = $colors{'reset'};
my $blacklight  = $colors{'p7_fg_0000'};
my $TRUE_blue   = $colors{'p7_fg_0004'};
my $neon_orange = $colors{'p7_fg_0002'};
my $neon_green  = $colors{'p7_fg_0003'};
my $dim_blue    = $colors{'p7_fg_0001'};

## the live shorthand table [ drives installation and expansion alike ] ##
my $shortcuts = <[path-template.console-shorthand]>;

say '';
say "$blacklight .:[ ${TRUE_blue}WORKFLOW SHORTCUTS${blacklight} ]:.$reset";
say '';

## console command shortcuts
say "${TRUE_blue}📋 Available Shortcuts:$reset";
say '';

foreach my $shorthand ( sort keys %{$shortcuts} ) {
    say sprintf "   ${neon_green}p7.%s${reset}  ${dim_blue}→${reset}  %s",
        $shorthand, $shortcuts->{$shorthand};
}

say '';
say "${TRUE_blue}💡 Usage Examples:$reset";
say '';
say "   # Show workflow overview";
say "   ${neon_orange}p7.wo$reset";
say '';
say "   # Commit with auto-signing";
say "   ${neon_orange}p7.ws$reset \"feat: Add new feature\"";
say '';
say "   # Verify dev signatures";
say "   ${neon_orange}p7.srcd$reset";
say '';
say "   # Update signatures to production";
say "   ${neon_orange}p7.srcu$reset";
say '';

say "${TRUE_blue}🔗 How Shortcuts Work:$reset";
say '';
say "   Shortcuts are 'p7.<shorthand>' -> 'p7-<zenka>' symlink chains in";
say "   /usr/local/bin, installed by v7-zenki.install_workflow_shortcuts.";
say "   The chain names the zenka; the alias name reaches it as launcher";
say "   context and expands into the console command words shown above.";
say '';
say "   The shorthand table lives in:";
say "   ${dim_blue}src/base.path-template.console-shorthand${reset}";
say '';

