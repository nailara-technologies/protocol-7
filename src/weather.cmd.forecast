## [:< ##

# name = weather.cmd.forecast
# descr = format weather forecast for web display

my $params = shift || {};

my $days = $params->{days} || 5;

## In future, fetch from weather zenka via IPC:
## <[protocol-7.command.send.local]>->(
##     { 'command' => 'weather.forecast', 'zenka' => 'weather', ... }
## );

## For now, use example data
my @forecast = (
    {   day      => qw| Mon |,
        temp_min => 12,
        temp_max => 19,
        desc     => qw| sunny |,
        clouds   => 20,
        icon     => qw| 01d |
    },
    {   day      => qw| Tue |,
        temp_min => 14,
        temp_max => 21,
        desc     => qw| clear |,
        clouds   => 15,
        icon     => qw| 01d |
    },
    {   day      => qw| Wed |,
        temp_min => 13,
        temp_max => 18,
        desc     => qw| cloudy |,
        clouds   => 75,
        icon     => qw| 03d |
    },
    {   day      => qw| Thu |,
        temp_min => 11,
        temp_max => 16,
        desc     => qw| rain |,
        clouds   => 90,
        icon     => qw| 10d |
    },
    {   day      => qw| Fri |,
        temp_min => 10,
        temp_max => 15,
        desc     => qw| light rain |,
        clouds   => 80,
        icon     => qw| 09d |
    },
);

## Limit to requested days
@forecast = @forecast[ 0 .. ( $days - 1 ) ] if $days < scalar(@forecast);

my $html = <[weather.forecast.util.format_forecast_widget]>->( \@forecast );

return $html;

0;

