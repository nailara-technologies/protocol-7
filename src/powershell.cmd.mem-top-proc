## [:< ##

# name  = powershell.cmd.mem-top-proc
# descr = top n windows host processes by working-set memory
# param = [count]

## lists the top memory consumers on the actual windows host [ pid, name,
## working-set in MB ] -- the per-process view that would have given advance
## warning about a growing firefox [ or the wsl vm's vmmemWSL allocation ]
## before it became host-wide pressure. pairs with  powershell.cmd.mem-used,
## same motivation : see  data/tasks/powershell-host-memory-commands.md

my $args = $call->{'args'} // '';
$args =~ s,^\s+|\s+$,,g;

my $top_count = length $args ? $args : 10;

return { 'mode' => qw| false |, 'data' => 'invalid count [ 1-50 ]' }
    if $top_count !~ m|^\d+$|
    or $top_count < 1
    or $top_count > 50;

## same single-line / try-catch / P7ERR discipline as
## powershell.cmd.get-event-log -- see there for the confirmed-live reasons [
## multi-line scripts break in the wsl-to-windows argv marshalling; the
## sentinel is parsed generically, not matched against specific error text ]
my $ps_script = <<'PS1';
$ErrorActionPreference = 'Stop'; try { Get-Process | Sort-Object WorkingSet64 -Descending | Select-Object -First __TOPN__ | ForEach-Object { "{0}`t{1}`t{2}" -f $_.Id, $_.ProcessName, [math]::Round($_.WorkingSet64 / 1MB) } } catch { Write-Output ('P7ERR:' + $_.Exception.Message) }
PS1

$ps_script =~ s|__TOPN__|$top_count|;
$ps_script =~ s|\n\z||;    ## heredoc adds a trailing newline -- strip it, ##
## keep the script content itself single-line   ##

my $raw_out = <[powershell.exec]>->($ps_script);

return { 'mode' => qw| false |, 'data' => 'powershell.exec failed' }
    if not defined $raw_out;

return { 'mode' => qw| false |, 'data' => $1 }
    if $raw_out =~ m|^P7ERR:(.+)|;

my @out_lines = split( m|\n|, $raw_out );
@out_lines = grep { length $ARG } @out_lines;

return { 'mode' => qw| false |, 'data' => 'no process data' }
    if not @out_lines;

## parse before formatting rather than passing PowerShell's raw tab-joined  ##
## text straight through -- a fixed-width table with an explicit rank makes ##
## the [ already-descending ] sort order visible at a glance, which bare    ##
## tabs of varying process-name length do not                               ##
my @rows;
for my $line (@out_lines) {
    my ( $pid, $name, $ws_mb ) = split( m|\t|, $line );
    push @rows,
        {
        pid   => $pid   // '',
        name  => $name  // '',
        ws_mb => $ws_mb // 0,
        };
}

## column widths sized off real content, not a guessed fixed width -- a     ##
## Windows pid or a large working-set MB figure can legitimately run past a ##
## hardcoded width [ confirmed live : a 5-digit pid did exactly that ],     ##
## throwing every row after it out of alignment with the header             ##
my $pid_width   = length(qw| pid |);
my $name_width  = length(qw| name |);
my $ws_mb_width = length(qw| ws-MB |);
for my $row (@rows) {
    $pid_width = length( $row->{'pid'} )
        if length( $row->{'pid'} ) > $pid_width;
    $name_width = length( $row->{'name'} )
        if length( $row->{'name'} ) > $name_width;
    $ws_mb_width = length( $row->{'ws_mb'} )
        if length( $row->{'ws_mb'} ) > $ws_mb_width;
}

my @table;
push @table,
    sprintf(
    '%3s  %*s  %-*s  %*s',
    '#',        $pid_width,   qw| pid |, $name_width,
    qw| name |, $ws_mb_width, qw| ws-MB |
    );
push @table,
    '-' x ( 3 + 2 + $pid_width + 2 + $name_width + 2 + $ws_mb_width );

my $rank = 0;
for my $row (@rows) {
    $rank++;
    push @table,
        sprintf(
        '%3d  %*s  %-*s  %*s',
        $rank,          $pid_width,   $row->{'pid'}, $name_width,
        $row->{'name'}, $ws_mb_width, $row->{'ws_mb'}
        );
}

return { 'mode' => qw| size |, 'data' => join( "\n", @table ) . "\n" };

