## [:< ##

# name  = mpv.startup.job.fork_player
# descr = fork mpv binary and register finalize job with socket dependency;
#          safe to call directly (as event-loop callback) or as a job callback

<[mpv.open_player]>;    ## forks binary + starts async socket poll ##

## finalize job waits for socket dep — runs observe_properties + ##
## get_playlist                                                  ##
<[jobqueue.add_job]>->(
    {   'name'         => 'mpv startup finalize',
        'job_callback' => 'mpv.startup.job.finalize',
        'object_id'    => <mpv.dep.socket>,
    }
);

