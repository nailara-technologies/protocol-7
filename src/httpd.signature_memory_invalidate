# name  = httpd.signature_memory_invalidate
# descr = invalidate cached verification results and bodies
# args  = <path>, [ <directory-prefix> ]

my $path   = shift // '';
my $prefix = shift // FALSE;
my $cache  = <httpd.signature.cache> //= {};
my @paths
    = length($path)
    ? grep { $prefix ? index( $ARG, "$path/" ) == 0 : $ARG eq $path }
    keys $cache->%*
    : keys $cache->%*;
my $removed = 0;
foreach my $cached_path (@paths) {
    my $entry = delete $cache->{$cached_path} // next;
    if ( defined $entry->{'body_ref'} ) {
        <httpd.signature.memory_bytes> -= $entry->{'body_size'} // 0;
        <httpd.signature.memory_bytes> = 0
            if <httpd.signature.memory_bytes> < 0;
    }
    unlink $entry->{'body_path'} if defined $entry->{'body_path'};
    $removed++;
}
return $removed;

