# name = web-browser.handler.snapshot_result

my ( $view, $async_result ) = @_;

my $out_path = delete <web-browser.snapshot.pending_path>;
my $reply_id = delete <web-browser.snapshot.pending_reply>;

my $surface = eval { $view->get_snapshot_finish($async_result) };

if ( $@ or not defined $surface ) {
    <[base.log]>->( 1, "snapshot failed: $@" );
    <[base.callback.cmd_reply]>->(
        $reply_id,
        {   'mode' => qw| false |,
            'data' => 'snapshot failed'
        }
    ) if defined $reply_id;
    return;
}

## save to PNG -- webkit2 returns Cairo::ImageSurface, not GdkPixbuf
my $save_ok = eval { $surface->write_to_png($out_path); 1 };

if ( not $save_ok ) {
    <[base.log]>->( 1, "snapshot save failed: $@" );
    <[base.callback.cmd_reply]>->(
        $reply_id,
        {   'mode' => qw| false |,
            'data' => "save failed: $@"
        }
    ) if defined $reply_id;
    return;
}

<[base.log]>->( 2, "snapshot saved: $out_path" );
<[base.callback.cmd_reply]>->(
    $reply_id,
    {   'mode' => qw| true |,
        'data' => $out_path
    }
) if defined $reply_id;

