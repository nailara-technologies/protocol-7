## [:< ##

# name  = plugin.v7-zenki.hotspot.init_code
# descr = hotspot sampler plugin : gdb detection and run state set-up

## evidence before action : sample a busy \ stuck zenka's perl interpreter ##
## position [ PL_curinterp->Icurcop ] with gdb, never a caller-given pid.  ##
## without gdb the plugin stays inactive : the command answers 'gdb not    ##
## installed' and nothing else in v7-zenki changes                         ##

my $reinit = shift;

<v7-zenki.hotspot.jobs> //= {};    ## one active job per zenka name ##

my $gdb = <[file.which]>->(qw| gdb |);
if ( defined $gdb and length $gdb and -x $gdb ) {
    <v7-zenki.hotspot.gdb> = $gdb;
    <[base.logs]>->( 1, ': hotspot plugin : gdb at %s', $gdb );
} else {
    <v7-zenki.hotspot.gdb> = undef;
    <[base.log]>->(
        1,
        ': hotspot plugin inactive : gdb not installed '
            . '[ p7-deps profile : v7-zenki-hotspot ]'
    );
}

## re-detect only : in-flight jobs keep their own resolved state ##

0;

