## [:< ##

# name  = nodes.orbital.push_position_if_subscribed
# descr = push current orbital position to STRM subscribers
#
# notes = called on its own slow timer [ see nodes.init_code ] since this
#         value has no discrete mutation event ; no-ops [ cheap check only ]
#         when nobody is subscribed

return unless <[base.cfg_bool]>->(<nodes.cfg.orbital_push_enabled>);
return
    unless defined <nodes.orbital.listeners>
    and <nodes.orbital.listeners>->@*;

my $result = <[nodes.orbital.current_position]>;
return unless ( $result->{'mode'} // '' ) eq qw| true |;

my $payload = <[nodes.orbital.format_strm_payload]>->( $result->{'data'} );
return unless length $payload;

my @keep;
for my $h ( <nodes.orbital.listeners>->@* ) {
    if ( <[base.stream.push]>->( $h, \$payload ) ) {
        push @keep, $h;
    } else {
        <[base.stream.close]>->($h);  ## clean up base-level producer state ##
    }
}
<nodes.orbital.listeners> = \@keep;

return TRUE;

