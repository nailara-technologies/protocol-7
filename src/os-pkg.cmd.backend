## [:< ##

# name  = os-pkg.cmd.backend
# descr = show selected package backend and distribution
# param = [ none ]

my $backend_type = <os-pkg.backend_type>;
my $os_release   = <os-pkg.os_release> // {};

unless ( defined $backend_type ) {
    my $id = $os_release->{'ID'} // 'unknown';
    return {
        'mode' => qw| false |,
        'data' => "unsupported distribution : $id"
    };
}

my $pretty = $os_release->{'PRETTY_NAME'} // '';

return {
    'mode' => qw| true |,
    'data' => "backend $backend_type  [ $pretty ]"
};

