## [:< ##

# name  = ncode.cmd.search
# param = <pattern> [scope]
# descr = regexp search across source, tasks or docs

my $args  = $call->{'args'} // '';
my @parts = split m|\s+|, $args;

my @known_targets = qw|
    . bin dev admin src cfg md zenki docs tasks
    pm-src amos amos-at amos-in amos-cs amos-elf
    |;
my %is_target = map { $ARG => 1 } @known_targets;

my $context = 0;
my ( $target, $pattern );

## detect old format: <target> [-C N] <pattern> ##
my $has_context_option = 0;
my @remaining;
my $i = 0;
while ( $i < @parts ) {
    if (    $parts[$i] =~ m|^-[Cc]$|
        and defined $parts[ $i + 1 ]
        and $parts[ $i + 1 ] =~ m|^\d+$| ) {
        $context            = 0 + $parts[ $i + 1 ];
        $has_context_option = 1;
        $i += 2;
    } elsif ( $parts[$i] =~ m|^-[Cc](\d+)$| ) {
        $context            = 0 + $LAST_PAREN_MATCH;
        $has_context_option = 1;
        $i++;
    } else {
        push @remaining, $parts[$i];
        $i++;
    }
}

if (@remaining
    and (  $has_context_option
        or $is_target{ $remaining[0] }
        or $remaining[0] =~ m|[:+]| )
    and @remaining > 1
) {
    ## old format ##
    $target  = shift @remaining;
    $pattern = join ' ', @remaining;
} elsif (@remaining) {
    ## new format: <pattern> [scope] ##
    $pattern = shift @remaining;
    $target  = shift @remaining // qw| src |;
    $target  = qw| src | if not length $target;
} else {
    return {
        'mode' => qw| false |,
        'data' => 'usage: search <pattern> [scope:src|tasks|docs|all]'
    };
}

return { 'mode' => qw| false |, 'data' => 'search pattern required' }
    if not length $pattern;

my @cmd = ( <ncode.bin>, qw| -no-color search |, $target, $pattern );

my $output = $code{'ncode.util.run_cmd'}->(@cmd);

return { 'mode' => qw| size |, 'data' => $output };

