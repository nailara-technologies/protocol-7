## [:< ##

# name  = impressive.screen-change
# descr = on X-11 screen-change, re-query placement geometry

my $args = shift // '';
my ( $w, $h ) = split( ' ', $args );
$w //= 0;
$h //= 0;

<[base.logs]>->( 1, '[screen-change] %dx%d', $w, $h );

return if not defined <x11.id>;

my $caller = <system.zenka.name> // qw| impressive |;

## re-query geometry through the placement infrastructure ;
## window-place.coords returns the saved profile instantly if one exists,
## otherwise opens the placement ui so the user can pick a new position.
<[protocol-7.route-send]>->(
    {   'command'   => qw| window-place.coords |,
        'call_args' => { 'args' => sprintf 'caller=%s', $caller },
        'reply' => { 'handler' => qw| impressive.handler.reposition_reply | }
    }
);

return;

