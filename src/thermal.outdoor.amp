## [:< ##

# name  = thermal.outdoor.amp
# descr = calculate the night offset amplifier from outdoor cold

my ( $temp_out, $at, $now ) = @ARG;

return 1.0
    if not <[base.cfg_bool]>->( <thermal.cfg.outdoor.enabled> // qw| yes | )
    or not defined $temp_out
    or not defined $at
    or $now - $at > ( <thermal.cfg.outdoor.max_age> // 3600 );

my $amp = 1 + ( ( <thermal.cfg.outdoor.t_ref> // 15.0 ) - $temp_out )
    * ( <thermal.cfg.outdoor.k> // 0.04 );
return 1.0 if $amp < 1.0;

my $max = <thermal.cfg.outdoor.max> // 1.5;
return $max if $amp > $max;
return $amp;

