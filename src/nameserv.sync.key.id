## [:< ##

# name   = nameserv.sync.key.id
# descr  = this host's sync key : id and public key
# return = ( key id [ 77 chars ], raw public key ) or () when not loaded

my $key = $keys{'C25519'}->{qw| nameserv-sync |};
return () if ref $key ne qw| HASH | or not defined $key->{'private'};

my $pub = $key->{'public'};
return () if not defined $pub or length $pub != 32;

<nameserv.sync.key_id_of> //= {};
my $id = <nameserv.sync.key_id_of>->{$pub} //= <[trust.key_id]>->($pub);

return defined $id ? ( $id, $pub ) : ();

