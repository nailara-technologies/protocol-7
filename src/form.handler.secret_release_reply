## [:< ##

# name  = form.handler.secret_release_reply
# descr = reply handler for sessions.release. compares the returned
#         bytes byte-for-byte against the stored original, prints a
#         diagnosable length+hexdump report [ not just PASS/FAIL ],
#         then either chains into the next test case or finishes.

my ($info) = @ARG;

my $reply_data = $info->{'data'} // '';

my $index = <form.test.index>;
my $case  = <form.test.cases>->[$index];

if ( $reply_data =~ m|^\s*<<| ) {
    print sprintf( "\n  << release failed [ case %d, %s ]: %s >>\n\n",
        $index, $case->{'label'}, $reply_data );
    <[base.exit]>;
    return FALSE;
}

$reply_data =~ s|\s+$||;
my $returned = eval { decode_b32r($reply_data) };

my $original = $case->{'value'};
my $match    = defined $returned && $returned eq $original;

my $hex_snip = sub {
    my ($str) = @ARG;
    return 'undef' if not defined $str;
    my $head = substr( $str, 0, 8 );
    my $tail = length($str) > 8 ? substr( $str, -8 ) : '';
    return sprintf(
        'len=%d head=%s tail=%s',
        length($str),
        unpack( qw| H* |, $head ),
        unpack( qw| H* |, $tail )
    );
};

print sprintf(
    "\n  case %d [ %s ]: %s\n    sent:     %s\n    returned: %s\n\n",
    $index, $case->{'label'},
    ( $match ? 'MATCH' : 'MISMATCH' ),
    $hex_snip->($original),
    $hex_snip->($returned)
);

<[base.buffer.erase_secure]>->( \$case->{'value'} );
<[base.buffer.erase_secure]>->( \$returned ) if defined $returned;

if ( not $match ) {
    <[base.exit]>;
    return FALSE;
}

$index++;
<form.test.index> = $index;

if ( $index < <form.test.cases>->@* ) {
    <[form.test.secret_send_hold]>;
    return TRUE;
}

print "\n  << all secret roundtrip cases passed >>\n\n";
<[base.exit]>;

return TRUE;

