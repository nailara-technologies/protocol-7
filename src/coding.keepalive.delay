## [:< ##

# name   = coding.keepalive.delay
# descr  = idle time until the next keep-alive is due
# return = seconds, below the prompt cache's idle hour
#
# interval type coding-keepalive. the rhythm's harmonic step may move a
# delay past the cache's life : kept under the ceiling [ downward only ]

my $delay = <[base.interval.next]>
    ->( { 'type' => qw| coding-keepalive |, 'state' => {} } );
my $ceiling = 60 * ( <coding.cfg.keepalive_ceiling_minutes> // 55 );
$delay = $ceiling - rand( $ceiling / 34 ) if $delay > $ceiling;
return $delay;

