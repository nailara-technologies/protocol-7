## [:< ##

# name    = plugin.auth.auth-keypair.load-authorized-users
# descr   = load authorized remote user public keys
#           from user-home and host-config authorized/<zenka>/ registries
# return  = count of loaded keys, or undef on error

my $zenka_name    = <system.zenka.name>;
my $key_vars_ref  = <[crypt.C25519.key_vars]>;
my $auth_base_dir = $key_vars_ref->{'auth_dir'};
my @auth_key_dir  = (
    catfile( $auth_base_dir, $zenka_name ),
    catfile(
        <[base.host.config_dir]>, qw| auth remote-keys authorized |,
        $zenka_name
    ),
);

## the table is REBUILT on every call [ startup, reinit ] : a removed or   ##
## replaced key file takes effect on reload, a revoked user never keeps an ##
## old entry. no directory \ unreadable : nobody authorized [ closed ]     ##
my $fresh        = {};
my $loaded_count = 0;
my $had_before   = scalar keys( ( $keys{'authorized-remote'} // {} )->%* );

foreach my $auth_key_dir (@auth_key_dir) {
    next if not -d $auth_key_dir;

    ## scan each user-home or host-local registry for <user>.public files ##
    if ( opendir( my $dh, $auth_key_dir ) ) {
        foreach my $filename ( sort readdir($dh) ) {
            next if $filename     =~ m|^\.|;         ## skip . and .. ##
            next unless $filename =~ m|\.public$|;

            my $username = $filename;
            $username =~ s|\.public$||;

            my $pubkey_file = catfile( $auth_key_dir, $filename );
            my $pubkey_b32  = <[file.slurp]>->($pubkey_file)->$*;

            if ( defined $pubkey_b32 and length $pubkey_b32 > 0 ) {
                chomp $pubkey_b32;

                my $pubkey_bin
                    = eval { Crypt::Misc::decode_b32r($pubkey_b32) };
                if ( defined $pubkey_bin and length $pubkey_bin == 32 ) {
                    $fresh->{$username} = {
                        'public_b32' => $pubkey_b32,
                        'public'     => $pubkey_bin,
                        'loaded_at'  => <[base.ntime]>,
                    };
                    $loaded_count++;
                    <[base.logs]>->(
                        2, ": authorized remote user '%s' loaded", $username
                    );
                } else {
                    <[base.logs]>->(
                        1,         ": key format not valid for '%s' [ %s ]",
                        $username, $pubkey_file
                    );
                }
            } else {
                <[base.logs]>->( 1, ": empty key file [ %s ]", $filename );
            }
        }
        closedir($dh);
    } else {
        <[base.logs]>->(
            0,             ": cannot read %s [ %s ] -- registry skipped",
            $auth_key_dir, "$OS_ERROR"
        );
    }
}
$keys{'authorized-remote'} = $fresh;

if ( $loaded_count > 0 ) {
    <[base.logs]>->(
        1,             ": loaded %d authorized remote user%s.",
        $loaded_count, $loaded_count == 1 ? '' : 's'           # , $zenka_name
    );
}

return $loaded_count;

