# name = mpv.callback.abort_startup

<[base.log]>->( 1, ': aborting zenka startup..,' );
<[base.logs]>->( ': terminated mpv process %u.,', <mpv.pid> )
    if kill( 9, <mpv.pid> );
<[base.exit]>->(qw| 0010 |);

