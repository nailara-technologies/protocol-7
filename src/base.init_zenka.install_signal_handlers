# name  = base.init_zenka.install_signal_handlers

my @registered_signals
    = qw| int term hup NUM37 NUM55 NUM41 chld PIPE NUM50 NUM51 NUM52 NUM53 |;

<[base.load_runtime_modules]>->(
    qw| base.sig_NUM50 base.sig_NUM51 base.sig_NUM52 |,
    qw| base.devmod.safe_commands base.devmod.unsafe_commands |,
    qw| base.devmod.unload_unsafe base.devmod.process_signal |,
    qw| base.sig_fault |
);

## [ setting logging signal handler for all others ]
##
my %ignored_sig   = map { uc $ARG => 5 } keys %SIG;
my %silent_signal = map { uc $ARG => 5 } qw| CLD WINCH |;
## synchronous fault signals never get an Event watcher : its handler      ##
## returns, the faulting instruction runs again -- an endless SIGSEGV loop ##
## at full cpu [ v7-zenki 2026-11-26 ]. base.sig_fault below               ##
foreach my $signal_name ( @registered_signals,
    qw|  KILL  STOP __WARN__  SEGV  BUS  FPE  ILL  | ) {
    $signal_name =~ s|^SIG|| if index( $signal_name, qw| SIG |, 0 ) == 0;
    delete $ignored_sig{ uc $signal_name };
}

## one watcher per signal number : %SIG carries aliases                     ##
## [ CLD = CHLD, IOT = ABRT, POLL = IO ]. a second Event watcher on the     ##
## same number keeps Event's count above zero, so a later add_signal for    ##
## that signal never re-installs the kernel handler -- once anything resets ##
## the disposition [ $SIG{CHLD} restore after a gcc compile ], the signal   ##
## is lost for good [ v7-zenki : 2026-10-07, no SIGCHLD ]                   ##
<[base.perlmod.load]>->('Config');
my %sig_num;
@sig_num{ split( ' ', $Config::Config{'sig_name'} ) }
    = split( ' ', $Config::Config{'sig_num'} );
my %num_taken;

foreach
    my $signal_name ( @registered_signals, <[base.sort]>->( \%ignored_sig ) )
{
    my $uc_sig = uc($signal_name);

    ## alias of a signal already set up : drop a watcher left from an ##
    ## earlier init, otherwise a reload still keeps the count up      ##
    my $num = $sig_num{$uc_sig};
    if ( defined $num and $num_taken{$num}++ ) {
        ( delete <watcher.signal>->{$uc_sig} )->cancel
            if defined <watcher.signal>
            and exists <watcher.signal>->{$uc_sig};
        next;
    }
    delete $SIG{$uc_sig} if defined $SIG{$uc_sig};

    my $signal_handler_name = sprintf( qw| base.sig_%s |, $signal_name );

    ##  install default handler for %ignored_sig keys  ##
    if ( exists $ignored_sig{$uc_sig}
        or not defined $code{$signal_handler_name} ) {

        my $signal_name_str
            = $signal_name =~ m|^\d+$|
            ? sprintf( qw| SIGNUM%d |, $signal_name )
            : sprintf( qw|   SIG%s  |, $uc_sig );

        if ( not exists $silent_signal{$uc_sig} ) { ## logged [ignored] sig ##

            $code{$signal_handler_name} = sub {
                <system.ignored_signals>->{$signal_name_str}++;

                <[base.logs]>->(
                    0, ':: received ignored signal [ %s ]', $uc_sig
                );
            }
        } else {    ##  silent signal [ignored]  ##

            $code{$signal_handler_name} = sub {
                <system.ignored_signals>->{$signal_name_str}++;
            }
        }
    }

    ##  register signal handlers  ##
    ##
    <[event.add_signal]>->(
        {   'signal'  => $uc_sig,
            'handler' => $signal_handler_name
        },
        3    ## <-- log level 3 ##
    );
}

## fault signals : plain %SIG, run at once inside the fault ##
<[base.perlmod.load]>->('POSIX');
foreach my $fault_sig (qw| SEGV BUS FPE ILL |) {
    $SIG{$fault_sig} = sub { $code{'base.sig_fault'}->($fault_sig) };
}

