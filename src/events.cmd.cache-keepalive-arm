# name  = events.cmd.cache-keepalive-arm
# descr = re-arm cache keep-alive after registry changes

return { 'mode' => qw| true |, 'data' => 'cache keep-alive not loaded' }
    if not defined $code{'plugin.events.cache-keepalive.arm'};
my $armed = <[plugin.events.cache-keepalive.arm]>;
return {
    'mode' => $armed ? qw| true |               : qw| false |,
    'data' => $armed ? 'cache keep-alive armed' : 'not armed'
};

