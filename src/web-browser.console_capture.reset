## [:< ##

# name  = web-browser.console_capture.reset
# descr = clear a view's js console ring buffer [ new page -> fresh buffer ]
# param = <view_id> <uri>

my $view_id = shift;
my $uri     = shift // '';

my $name = <[web-browser.console_capture.buffer_name]>->($view_id);
return undef unless defined $name;

$data{'buffer'}{$name}{'max_size'} //= 32768;    ## 32K per view console ##

undef $data{'buffer'}{$name}{'data'}->@*;
$data{'buffer'}{$name}{'data'} = [];
$data{'buffer'}{$name}{'size'} = 0;

<[base.buffer.add_line]>->(
    $name, sprintf( '.:[ console reset | %s ]:.', $uri )
);

return TRUE;

