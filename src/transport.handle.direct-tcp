## [:< ##

# name  = transport.handle.direct-tcp
# descr = direct TCP connection handler (baseline)
# args  = $entry, $context
# returns transport handle hashref or undef

my ( $entry, $ctx ) = @ARG;

my $endpoint = $entry->{'endpoint'} // $ctx->{'session'}{'destination'}
    // $ctx->{'request'}{'domain'} // '';
return undef unless length $endpoint;

my ( $host, $port ) = split m|:|, $endpoint, 2;
my $request_url = $ctx->{'request'}{'url'} // '';
if ( not defined $port
    and $request_url =~ m|^(?:https?://)?[^/:]+:([0-9]+)| ) {
    $port = $1;
}
$port
    //= ( $ctx->{'request'}{'method'} // '' ) eq qw| CONNECT | ? 443
    : $request_url =~ m|^https://|                             ? 443
    :                                                            80;

my $sock = IO::Socket::IP->new(
    PeerHost => $host,
    PeerPort => $port,
    Type     => SOCK_STREAM(),
    Timeout  => 7,
);

if ( not $sock ) {
    <[base.logs]>->(
        0, 'transport.handle.direct-tcp: connect to %s:%d failed: %s',
        $host, $port, $OS_ERROR
    );
    return undef;
}

$sock->blocking(0);

my $dest = $ctx->{'session'}{'destination'} // $ctx->{'request'}{'domain'}
    // $endpoint;
my $exit = $entry->{'endpoint'} // $endpoint;

my $handle = {
    'type'     => 'direct-tcp',
    'socket'   => $sock,
    'endpoint' => $endpoint,
    'quality' => <transport.registry>->{'quality'}{$exit}{'direct-tcp'}{$dest}
        // {},
};

## update stats ##
<transport.registry>->{'stats'}{'connections_ok'}++;
<transport.registry>->{'active'}{$dest}{$exit} = {
    'type'    => 'direct-tcp',
    'started' => <[base.ntime]>,
};

return $handle;

