## [:< ##

# name  = kimi.session.reset_and_reconnect
# descr = lightweight session reset : tear down, create fresh session, reconnect

## cancel all reconnect / retry / liveness timers before teardown prevents old
## session from resurrecting itself mid-reset
if ( defined <kimi.reconnect.timer> ) {
    <kimi.reconnect.timer>->cancel
        if <kimi.reconnect.timer>->is_active;
    <kimi.reconnect.timer> = undef;
}
if ( defined <kimi.init.retry_timer> ) {
    <kimi.init.retry_timer>->cancel
        if <kimi.init.retry_timer>->is_active;
    <kimi.init.retry_timer> = undef;
}
if ( defined <kimi.liveness.timer> ) {
    <kimi.liveness.timer>->cancel
        if <kimi.liveness.timer>->is_active;
    <kimi.liveness.timer> = undef;
}
<kimi.session.was_ready> = FALSE;

## tear down websocket if connected
if (<kimi.ws.connected>) {
    if ( defined <kimi.ws.io_watcher> ) {
        <kimi.ws.io_watcher>->cancel
            if <kimi.ws.io_watcher>->is_active;
        <kimi.ws.io_watcher> = undef;
    }
    if ( defined <kimi.ws.socket> ) {
        eval { shutdown( <kimi.ws.socket>, 2 ) };
        close <kimi.ws.socket>;
    }
    <kimi.ws.connected> = FALSE;
}

## clear session state
<kimi.session_id>            = undef;
<kimi.wire.accumulator>      = '';
<kimi.wire.pending>          = {};
<kimi.approval.auto_approve> = TRUE;    # [ restore on reconnect ]

## create fresh session via rest api
my $new_session_id = <[kimi.session.create]>;

if ( not defined $new_session_id ) {
    <[base.logs]>->(
        0, 'kimi.session.reset_and_reconnect: session create failed'
    );
    <kimi.ws.status> = qw| disconnected |;
    delete <kimi.next.deferred>->{'for_session_id'}
        if defined <kimi.next.deferred>;
    return;
}

<kimi.session_id> = $new_session_id;

## lock deferred prompt to this new session so an old session  that becomes
## ready first cannot consume it
<kimi.next.deferred>->{'for_session_id'} = <kimi.session_id>
    if defined <kimi.next.deferred>;

## websocket connect
my $ws_url = sprintf( '%s/api/sessions/%s/stream',
    <kimi.web.ws_base>, <kimi.session_id> );

my $sock = <[websocket.connect]>->($ws_url);

if ( not defined $sock ) {
    <[base.logs]>->(
        0,
        'kimi.session.reset_and_reconnect: websocket connect failed [ %s ]',
        $ws_url
    );
    <kimi.ws.status>  = qw| disconnected |;
    <kimi.session_id> = undef;
    delete <kimi.next.deferred>->{'for_session_id'}
        if defined <kimi.next.deferred>;
    return;
}

<kimi.ws.socket> = $sock;
<kimi.ws.frame>  = Protocol::WebSocket::Frame->new(
    max_payload_size => 16 * 1024
        * 1024    ## 16 MiB [ tool results can be large ]
);
<kimi.connect.retry_cur> = 2;

## register event.add_io for incoming frames
<kimi.ws.io_watcher> = <[event.add_io]>->(
    {   'fd'      => $sock,
        'handler' => qw| websocket.handler.read |,
        'data'    => {
            'frame'      => <kimi.ws.frame>,
            'on_message' => qw| kimi.handler.ws_message |,
            'context'    => { 'session_id' => <kimi.session_id> }
        },
        'poll' => qw| re |
    }
);

<kimi.ws.connected> = TRUE;

## status change triggers watcher : starts liveness timeout
<kimi.ws.status> = qw| connecting |;

<[base.logs]>->( 1, ': session reset complete : awaiting ready' );

