## [:< ##

# name   = invoke-web.json_octets
# descr  = request body for the invoke.ai api : json as utf-8 octets [
#          format.json.encode returns characters -- prompts can hold
#          non-ascii text ]
# param  = perl structure

my $json = <[format.json.encode]>->(shift);
utf8::encode($json);
return $json;

