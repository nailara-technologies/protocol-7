# name  = jobsite.replica.forward-endpoint-response
# descr = relay a primary endpoint response to the local http caller

my $result = shift               // {};
my $params = $result->{'params'} // {};
my $body
    = $result->{'ok'}
    ? ( $result->{'body'} // '{}' )
    : JSON::XS::encode_json(
    {   'ok'      => JSON::XS::false(),
        'message' => $result->{'error'} // 'primary unavailable'
    }
    );
<[base.callback.cmd_reply]>->(
    $params->{'reply_id'},
    {   'mode'         => qw| strm |,
        'data'         => $body,
        'content_type' => qw| application/json |
    }
);
<[jobsite.replica.pull_soon]>;

