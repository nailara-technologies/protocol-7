## [:< ##

# name  = p7-log.anon.init_code
# descr = log anonymization defaults + dotted command registration

<p7-log.anon.enabled>   //= FALSE;
<p7-log.anon.token_len> //= 13;

## dotted command alias : p7-log.anon.resolve \ .resolve-line ##
<base.cmd>->{qw| anon.resolve |}      //= qw| p7-log.anon.cmd.resolve |;
<base.cmd>->{qw| anon.resolve-line |} //= qw| p7-log.anon.cmd.resolve-line |;

## note : key derivation is lazy [ EUID final only after drop_privs ] ##

<[base.logs]>->(
    2,
    'log.anon : initialized [ enabled : %d ]',
    <p7-log.anon.enabled> ? 1 : 0
);

return TRUE;

