## [:< ##

# name   = coding.handover.refresh
# descr  = ask the handover sources again
# args   = source names [ none : all ]
# return = count of requests buffered
#
# route-send only buffers : coding.handler.handover_reply checks presence,
# sends the source query from its reply handler and stores each answer in
# <coding.handover.state> when the event loop has run

my @names   = @ARG;
my $sources = <[coding.handover.sources]>;
@names = sort keys %{$sources} if not @names;
my $sent = 0;
foreach my $name (@names) {
    my $src     = $sources->{$name} // next;
    my ($zenka) = split m{\.}, $src->[0], 2;
    $sent++
        if <[protocol-7.route-send]>->(
        {   'command'   => qw| present |,
            'call_args' => { 'args' => $zenka },
            'reply'     => {
                'handler' => qw| coding.handler.handover_reply |,
                'params'  => {
                    'source'   => $name,
                    'presence' => TRUE,
                    'command'  => $src->[0],
                    'args'     => $src->[1]
                }
            }
        }
        );
}
return $sent;

