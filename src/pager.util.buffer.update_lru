## [:< ##

# name  = pager.util.buffer.update_lru
# descr = update LRU list for a page access

my ( $buf, $page_num ) = @ARG;

my $lru = $buf->{'pages'}{'lru'};
@$lru = grep { $ARG != $page_num } @$lru;
push @$lru, $page_num;

