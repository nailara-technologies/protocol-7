## [:< ##

# name  = web.cmd.auth-issue
# descr = mint a web session token [ admin only ] :
#         web.auth-issue <user_id> [ -ttl <seconds> ]
# note  = the token is printed exactly once : only its hash is stored.
#         use a long -ttl for machine push tokens [ e.g. jobsite sync ]

my $args_str = ref $call eq qw| HASH | ? ( $call->{'args'} // '' ) : '';

## admin gate : one check for every admin-only web auth command ##
## [ plugin.web.auth.admin_caller ]                             ##
return { 'mode' => qw| false |, 'data' => 'denied : admin only' }
    if not defined <[plugin.web.auth.admin_caller]>->(qw| web.auth-issue |);

## parse : <user_id> [ -ttl <seconds> ] ##
my @tokens  = split m|[ \t]+|, $args_str;
my $user_id = shift @tokens;
return {
    'mode' => qw| false |,
    'data' => 'usage: web.auth-issue <user_id> [ -ttl <seconds> ]'
    }
    if not defined $user_id
    or not length $user_id
    or $user_id !~ m|^[\w.+-]+$|;

my $ttl;
while ( my $switch = shift @tokens ) {
    if ( $switch eq '-ttl' ) {
        $ttl = shift @tokens;
    }
}
return { 'mode' => qw| false |, 'data' => 'invalid -ttl value' }
    if defined $ttl and $ttl !~ m|^\d+$|;

my $result = <[plugin.web.auth.create_session]>->(
    {   'user_id' => $user_id,
        ( defined $ttl ? ( 'ttl' => $ttl ) : () ),
    }
);

if ( not defined $result ) {
    return {
        'mode' => qw| false |,
        'data' => 'token creation failed [ web.auth.secret in host config? ]'
    };
}

return {
    'mode' => qw| true |,
    'data' => sprintf 'token [ shown once ] : %s  '
        . 'user=%s expires_at_epoch=%d',
    $result->{'token'},
    $result->{'user_id'},
    $result->{'expires_at_epoch'},
};

