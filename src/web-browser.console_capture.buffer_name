## [:< ##

# name  = web-browser.console_capture.buffer_name
# descr = derive ring-buffer name for a view's js console [ view-id -> name ]
# param = <view_id>

my $view_id = shift;

return undef unless defined $view_id and $view_id =~ m|^\d+$|;

return sprintf( 'js-cons-view-%04d', $view_id - 1 );

