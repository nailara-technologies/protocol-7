## [:< ##
# name  = plugin.storage.p7ref.parse
# descr = Parse P7REF reference string into components

my ($args) = @ARG;

my $p7ref = $args->{p7ref}
    or return { 'mode' => 'false', 'data' => 'p7ref required' };

my $registry = <storage.mapping.p7ref>;
my $regex    = $registry->{'regex'};

# Check cache
if ( exists $registry->{'cache'}{$p7ref} and not $args->{nocache} ) {
    $registry->{'stats'}{'cached'}++;
    return {
        'mode'   => 'true',
        'data'   => $registry->{'cache'}{$p7ref},
        'cached' => 1,
    };
}

$registry->{'stats'}{'parsed'}++;

# Parse nested brackets first
my @nested;
my $remaining = $p7ref;
while ( $remaining =~ m|$regex->{'nested'}| ) {
    push @nested, $1;
    $remaining =~ s|\[[^\]]+\]|[NESTED]|;
}

# Parse main reference
if ( $remaining !~ m|$regex->{'full'}| ) {
    return { 'mode' => 'false', 'data' => 'Invalid P7REF format' };
}

my ( $type, $address ) = ( $1, $2 );

# Parse segments
my @segments;
while ( $address =~ m|$regex->{'segment'}|g ) {
    push @segments, $1;
}
$address =~ s{\|[^|]+\|}{}g;

# Parse authority
my $authority;
if ( $address =~ m|$regex->{'authority'}| ) {
    $authority = $1;
    $address =~ s|@[^/]+||;
}

# Parse query
my %query;
if ( $address =~ m|$regex->{'query'}| ) {
    my $qstr = $1;
    for my $pair ( split m|&|, $qstr ) {
        my ( $k, $v ) = split m|=|, $pair, 2;
        $query{$k} = $v // 1;
    }
    $address =~ s|\?.+$||;
}

my $parsed = {
    'original'  => $p7ref,
    'type'      => $type,
    'address'   => $address,
    'authority' => $authority,
    'segments'  => \@segments,
    'nested'    => \@nested,
    'query'     => \%query,
    'parsed_at' => <[base.ntime]>,
};

# Cache result
$registry->{'cache'}{$p7ref} = $parsed;

return {
    'mode'   => 'true',
    'data'   => $parsed,
    'cached' => 0,
};

