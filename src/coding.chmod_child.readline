## [:< ##

# name  = coding.chmod_child.readline
# descr = blocking read of one reply line from chmod child stdout

my $r_fh = <coding.chmod_child.r_fh>;
return 'no-channel' unless defined $r_fh;

## blocking readline : child always prints exactly one line per command ##
## child has autoflush ($|=1) so this never hangs on buffer             ##
my $reply = '';
eval {
    local $SIG{'ALRM'} = sub { die "timeout\n" };
    alarm(2);
    $reply = readline($r_fh) // '';
    alarm(0);
};
alarm(0);

chomp $reply;
return $reply;    ## 'ok', 'skip', or 'err' ##

