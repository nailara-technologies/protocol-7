# name  = web.cmd.jobs-sync-foreign
# descr = jobs sync from a foreign host : marks only
# note  = httpd.route.handler.web-relay picks it for a peer that is not
#         exempt [ not loopback, not web.auth.exempt_peers ] : a jobsite
#         batch from another host may only touch the export marks + prefs
#         [ plugin.web.jobs.sync marks mode ], whatever role it claims.
#         single browser updates pass as before

<web.jobs.sync_foreign> = TRUE;
my @reply = eval { <[plugin.web.jobs.sync]>->(@ARG) };
my $error = $EVAL_ERROR;
<web.jobs.sync_foreign> = FALSE;
die $error if length $error;

return wantarray ? @reply : $reply[0];

