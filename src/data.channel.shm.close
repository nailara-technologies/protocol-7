## [:< ##

# name = data.channel.shm.close
# descr = Close and cleanup SHM-backed channel

my ($channel_id) = @ARG;

my $channel = delete $data{'channel'}{'shm'}{'registry'}{$channel_id};
return 0 unless defined $channel;

my $shm = $channel->{'shm'};

# Unlink the SHM segment
<[data.mount.shm.unlink]>->(
    $channel->{'owner'}, $channel->{'name'} . ':channel'
);

# Also try direct path cleanup
my $path = sprintf( "/dev/shm/p7:M:%s:%s:channel",
    $channel->{'owner'}, $channel->{'name'} );
unlink($path) if -f $path;

return 1;

