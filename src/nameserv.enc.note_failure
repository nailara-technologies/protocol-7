## [:< ##

# name  = nameserv.enc.note_failure
# param = <upstream name> <reason>
# descr = remember a failed connect or handshake and set the back-off

## the delay comes from base.interval.next [ type dns-enc-reconnect ] : a   ##
## failed upstream is skipped until then, never hammered. the first success ##
## clears it                                                                ##

my ( $name, $reason ) = @ARG;
my $all   = <nameserv.enc.health> //= {};
my $h     = $all->{$name}         //= { 'state' => {} };
my $delay = <[base.interval.next]>
    ->( { 'type' => qw| dns-enc-reconnect |, 'state' => $h->{'state'} } );
$h->{'until'}  = time + ( $delay // 0 );
$h->{'reason'} = $reason;
$h->{'fails'}++;
return $delay;

