# name  = models.task.release-previous-instance
# descr = release claims left by an earlier coding instance
# param = <authenticated zenka> <current instance id>

my $zenka    = shift // '';
my $instance = shift // '';

return FALSE if $zenka ne qw| coding | or not length $instance;

my $claimed  = <models.task.claimed> // {};
my $released = 0;

foreach my $task_id ( keys %{$claimed} ) {
    my $claim = $claimed->{$task_id};
    next
        if ref $claim ne qw| HASH |
        or ( $claim->{'owner_zenka'} // '' ) ne $zenka
        or not length( $claim->{'owner_instance'} // '' )
        or $claim->{'owner_instance'} eq $instance
        ## only work coding runs : another backend's task outlives coding ##
        or ( $claim->{'target_cmd'} // '' ) !~ m|^coding\.|;

    my $age = time - ( $claim->{'at'} // 0 );
    <[base.logs]>->(
        1,
        ': previous coding instance claim %s [ task %s ] released after %d s',
        $task_id,
        $task_id,
        $age
    );
    <[models.task.release-claim]>->($task_id);
    $released++;
}

return $released;

