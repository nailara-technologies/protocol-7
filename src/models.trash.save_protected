# name  = models.trash.save_protected
# descr = persist the in-memory <models.protected_checksums> hash to disk --
#         called by protect/unprotect after mutating it

my $path = <[file.zenka_dir.data_path]> . '/protected_checksums.yaml';
my $dir  = $path;
$dir =~ s|/[^/]+$||;
<[file.path.make_dir]>->($dir) unless -d $dir;

return
    <[format.yaml.write_file]>->( $path, <models.protected_checksums> // {} );

