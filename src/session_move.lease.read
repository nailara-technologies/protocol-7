## [:< ##

# name   = session_move.lease.read
# descr  = the lease of a stored session
# args   = session dir in the store
# return = { host, pid, since, until } | undef [ none ]
#
# a lease file that cannot be read as one is returned with a host '?'
# and no end : it blocks until a person removed it

my $base = shift;
my $file = "$base/lease";
return undef if not -e $file and not -l $file;
my $cfg = <[session_move.parse]>->( <[session_move.read_text]>->($file) );
return { 'host' => '?', 'broken' => TRUE }
    if not length( $cfg->{'host'} // '' )
    or ( $cfg->{'until'} // '' ) !~ m{\A\d+\z};
return { map { ( $ARG => $cfg->{$ARG} // '' ) } qw| host pid since until | };

