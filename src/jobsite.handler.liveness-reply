# name  = jobsite.handler.liveness-reply
# descr = site-yaml liveness verdict for one job

my $call   = shift             // {};
my $params = $call->{'params'} // {};

my ( $ok, $verdict, $why ) = <[base.reply.value]>->( $call, qw| json | );
if ( not $ok or ref $verdict ne qw| HASH | ) {
    $verdict = { 'verdict' => qw| unknown |, 'why' => $why // 'no hash' };
}

<[jobsite.liveness.apply]>->(
    $params->{'job_id'} // '',
    $params->{'token'} // '', $verdict
);
return;

