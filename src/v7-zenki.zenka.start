## [:< ##

# name = v7-zenki.zenka.start
# descr = start nailara zenka and add it to process maintenance table

my $job_id     = $ARG[0]->{'job_id'};
my $zenka_name = $ARG[0]->{'params'};
my $stdin_mode = FALSE;
my @p_arg      = qw| -nb |;

my $zenka_subname;
my $env_override_key;
my $env_override_value;

##  optional env override tag threaded through by v7-zenki.zenka.cmd.start  ##
if ( $zenka_name =~ s|\s*:env:([A-Z_][A-Z0-9_]*)=([^:]*):\s*$|| ) {
    $env_override_key   = $1;
    $env_override_value = $2;
}

my $re_sn = <regex.base.subname>;
$zenka_subname = ${^CAPTURE}[0] if $zenka_name =~ s|\[($re_sn)\]$||;

if (<system.ansi_color>) {
    push @p_arg, qw| -c |;
} else {
    push @p_arg, qw| -nc |;
}

my $perl_bin    = <system.path.perl_bin>;
my $bin_p7_path = <system.start.exec_name>;

return warn 'expected zenka name <{C1}>' if not defined $zenka_name;

my $globals   = <v7-zenki.start_setup.globals> // {};
my $init_code = <v7-zenki.start_setup.zenki.startup.init_code>->{$zenka_name};
my $instances = <v7-zenki.zenka.instance>;
my $zenka_id  = <[zenka.get_id]>->($zenka_name);

# reuse instance id or create new one if none exists
my $instance_id = <jobqueue.joblist.by_id>->{$job_id}->{'instance_id'};
$instance_id //= <[zenka.instance.add]>->($zenka_id);

my $instance = $instances->{$instance_id};

<jobqueue.joblist.by_id>->{$job_id}->{'instance_id'} //= $instance_id;
$instance->{'job_id'} = $job_id;

## seed instance-level dependency exemptions from 'exempt-dependency.      ##
## by-subname.<n>.regex' / '.<n>.deps' [ e.g. mpv[audio-0] does not need   ##
## X-11/openbox ] -- indexed rule list, regex matched against this         ##
## instance's own subname, deps are space-separated dependency zenka names ##
## -- not a flat per-zenka setting                                         ##
if ( defined $zenka_subname ) {
    my $by_subname = <v7-zenki.start_setup.zenki.config>
        ->{$zenka_name}->{'exempt-dependency'}->{'by-subname'};
    if ( ref($by_subname) eq qw| HASH | ) {
        foreach my $rule_id ( keys %{$by_subname} ) {
            my $sn_regex = $by_subname->{$rule_id}->{'regex'};
            my $deps_str = $by_subname->{$rule_id}->{'deps'};
            next if not defined $sn_regex or not length $sn_regex;
            next if not defined $deps_str or not length $deps_str;
            next if $zenka_subname !~ m|$sn_regex|;
            map { $instance->{'dependency_exempt'}->{$ARG} = TRUE }
                split( m| +|, $deps_str );
        }
    }
}

my $starting = 0;    # check status of zenki with same name ..,
map { $starting++ if $instances->{$ARG}->{'status'} eq qw| starting | }
    <[zenka.instance.get_ids]>->($zenka_id)->@*;

## skip starting delay for handover expansion instances
if ($starting) {
    if ( $instance->{'handover_expansion'} ) {
        <[base.logs]>->(
            2,
            'handover instance %d starting '
                . 'alongside existing [concurrent mode]',
            $instance_id
        );
        ## proceed without delay - this is a concurrent restart
    } else {
        ## normal delay for non-handover instances
        <[base.logs]>->( 'delaying next %s zenka instance ..,', $zenka_name );
        <[zenka.change_status]>->( $instance_id, qw| delayed | );
        return;
    }
}

# initialize zenka instance start-up ..,
<[zenka.change_status]>->( $instance_id, qw| starting | );

### [ start-up timeout ]
my $start_timeout
    = <v7-zenki.start_setup.zenki.start-up.timeout>->{$zenka_name}
    // $globals->{'start-up'}->{'timeout'} // 64.707;    ##  <--  ##
<[base.log]>->(
    2,
    sprintf(
        "instance %d ['%s'] start timeout = %.1fs",
        $instance_id, $zenka_name, $start_timeout
    )
);

##  INCREASE START TIMEOUT WHEN LOG OUTPUT HAS HIGH LOAD  ##
if ( <system.zenka.verbosity.console> > 1 ) {
    my $verbosity_factor
        = 1.22420707 * ( <system.zenka.verbosity.console> - 1 );
    $start_timeout *= $verbosity_factor;
    <[base.logs]>->(
        ': increased instance start timeout to %.3f s [ verbosity ]',
        $start_timeout
    );
}

if ( defined $instance->{'timer'}->{'start-time-out'} ) {
    $instance->{'timer'}->{'start-time-out'}->cancel
        if $instance->{'timer'}->{'start-time-out'}->is_active();
}
$instance->{'timer'}->{'start-time-out'} = <[event.add_timer]>->(
    {   'after'   => $start_timeout,
        'handler' => qw| v7-zenki.handler.start-time-out |,
        'data'    => {
            'instance_id' => $instance_id,
            'timeout'     => $start_timeout
        }
    }
);
###

# execute v7-init code
my $init_result_data = {};
my $namespace_str
    = sprintf "\$data{'v7-zenki'}{'zenka'}{'instance'}{%d}{'init_data'}",
    $instance_id;
if ( defined $init_code->{'v7-init'} ) {
    <[base.logs]>->(
        2,            'executing start init-code for instance %d [%s]',
        $instance_id, $zenka_name
    );
    my @root_init_code
        = <[base.parser.config]>->( $init_code->{'v7-init'}, $namespace_str );
    map {
        $ARG =~ s|<instance_id>|$instance_id|g;
        $ARG =~ s|<zenka_name>|$zenka_name|g
    } @root_init_code;
    my $success = <[base.execute_zenka_code]>->(@root_init_code);
    $init_result_data = $instance->{'init_data'};

    if ( not $success ) {
        <[base.logs]>->(
            0, '<< errors in zenka %s init-code, aborting start-up >>',
            $zenka_name
        );
        <[zenka.change_status]>->( $instance_id, qw| error | );
        return undef;
    }
}

my $zenka_sn_str
    = defined $zenka_subname
    ? sprintf( qw| %s[%s] |, $zenka_name, $zenka_subname )
    : $zenka_name;

my ( $pid, $out_fh, $in_fh );

$instance->{'external'} = FALSE;

if ( exists $init_result_data->{'start_mode'}
    and $init_result_data->{'start_mode'} eq qw| exec-external | ) {

    $instance->{'external'} = TRUE;

    my $exec_bin = $init_result_data->{'exec_bin'};
    my $prog_usr = $init_result_data->{'exec_usr'};

    if ( defined $prog_usr and $prog_usr eq qw| <AMOS-user> | ) {
        if ( defined <system.AMOS-user> ) {
            $prog_usr = <system.AMOS-user>;
        } else {
            <[base.logs]>->(
                0, "<< '%s' exec_usr [\<system.AMOS-user>] is not defined >>",
                $zenka_name
            );
            <[zenka.change_status]>->( $instance_id, qw| error | );
            return undef;
        }
    }

    ## local ./bin/ path ## [ no /-es in exec_bin param ] ##
    map {
        $exec_bin = sprintf( qw|%s%s%s|, <system.root_path>, $ARG, $exec_bin )
            if $exec_bin !~ m|/|
            and -x sprintf qw| %s%s%s |, <system.root_path>, $ARG, $exec_bin;
    } qw| /bin/ /bin/admin/ /bin/dependencies/ |;

    if ( not defined $exec_bin or not defined $prog_usr ) {
        my $reason
            = sprintf "expected program-name [exec_bin] in '%s' start set-up",
            $zenka_name;
        $reason = sprintf( "expected 'exec_usr' for '%s' to be defined",
            $zenka_name )
            if defined $exec_bin and not defined $prog_usr;
        <[base.logs]>->( 0, '%s ., aborted.,', $reason );
        <[zenka.change_status]>->( $instance_id, qw| error | );
        <[zenka.cmd.terminate]>
            ->( { 'args' => $instance_id, qw| mode | => qw| implicit | } );
        return undef;
    } elsif ( $exec_bin =~ m|\s| or !-x $exec_bin ) {
        <[base.logs]>->(
            0,           "'%s' exec_bin '%s' not a valid executable",
            $zenka_name, $exec_bin
        );
        <[zenka.change_status]>->( $instance_id, qw| error | );
        return undef;
    } else {
        my $privs = <[base.root.drop_privs]>->( $prog_usr, qw| noop | );
        if ( not defined $privs or ref($privs) ne qw| HASH | ) {
            <[base.logs]>->(
                0, "exec_usr for '%s' is not valid", $zenka_name
            );
            <[zenka.change_status]>->( $instance_id, qw| error | );
            return undef;
        }
        map { $privs->{$ARG} =~ s|'||g }
            keys %{$privs};    # LLL: abort on match ?

        ## implement exec_args.., ##  [LLL]

        my $prepare_code = qw| %ENV=(); |;

        ## resolve the display for THIS zenka's own subname group [not a  ##
        ## flat global] -- e.g. tile[xvfb-0000] gets the xvfb-0000 X-11   ##
        ## instance's display, not whichever X-11 instance last replied.  ##
        ## resolves synchronously here: v7's own process always takes the ##
        ## local fast path in base.zenki.resolve_primary_sid [no real     ##
        ## network round-trip, callback fires before this returns].       ##
        ## <x11.display> used to be a flat scalar [pre-multi-instance]; a ##
        ## running v7 process that hasn't been restarted since may still  ##
        ## hold that old value -- coerce rather than crash dereferencing. ##
        <x11.display> = {} if ref(<x11.display>) ne qw| HASH |;

        my $display;
        <[base.zenki.resolve_primary_sid]>->(
            'X-11',
            sub {
                my $x11_sid = shift;
                $display = <x11.display>->{$x11_sid}
                    if defined $x11_sid;
            },
            $zenka_subname
        );
        $prepare_code .= "\$ENV{'DISPLAY'}='$display';"
            if defined $display;
        ## implement env set-up \ templates ? ##  [ <-- [LLL] ]
        $prepare_code .= <<~"EOT";
            \$EGID        = qw| $privs->{'all_gids'} |;
            \$GID         = qw| $privs->{'gid'} |;
            \$EUID        = qw| $privs->{'uid'} |;
            \$UID         = qw| $privs->{'uid'} |;
            \$ENV{'USER'} = qw| $prog_usr |;
            \$ENV{'HOME'} = qw| $privs->{'home'} |;
            \$ENV{'XDG_RUNTIME_DIR'} = qw| $privs->{'home'} |;
            \$ENV{'NO_AT_BRIDGE'} = 1;
            chdir( qw| $privs->{'home'} | );
        EOT

        if ( defined $env_override_key ) {
            ( my $env_val = $env_override_value ) =~ s|(['\\])|\\$1|g;
            $prepare_code .= "\$ENV{'$env_override_key'}='$env_val';";
            <[base.logs]>->(
                1,             "'%s' exec-external env_override : %s",
                $zenka_sn_str, $env_override_key
            );
        }

        ## %ENV is wiped above for exec-external zenki [ clean environment ##
        ## ]; env_include lets a zenka's v7-init config whitelist          ##
        ## additional keys to copy through from the live v7 process's own  ##
        ## environment                                                     ##
        my $env_include_str = $init_result_data->{'env_include'};
        if ( defined $env_include_str and length $env_include_str ) {
            my @included;
            for my $env_key ( split m| +|, $env_include_str ) {
                next if not defined $ENV{$env_key};
                ( my $env_val = $ENV{$env_key} ) =~ s|(['\\])|\\$1|g;
                $prepare_code .= "\$ENV{'$env_key'}='$env_val';";
                push @included, $env_key;
            }
            <[base.logs]>->(
                1,           "'%s' exec-external env_include : [ %s ]",
                $zenka_name, join( ' ', @included )
            );
        } else {
            <[base.logs]>->(
                2, "'%s' exec-external : no env_include configured",
                $zenka_name
            );
        }

        <[base.logs]>->(
            "starting external '%s' program as '%s' ..,",
            $zenka_sn_str, $prog_usr
        );
        eval {
            $pid
                = IPC::Open2::open2( $out_fh, $in_fh, $EXECUTABLE_NAME,
                qw| -e |,
                sprintf( "%s exec '%s'", $prepare_code, $exec_bin ) );
        };
        goto SKIP_OPEN2;
    }
}

## todo : initializing $ENV{'USER'} with EUID user ..,  ##  [LLL]

$stdin_mode = TRUE && push( @p_arg, qw| -stdin | )
    if exists $init_result_data->{'start_mode'}
    and $init_result_data->{'start_mode'} eq qw| stdin-zenka |
    and exists $init_code->{'zenka-init'};

my $apw_href = <v7-zenki.zenka.prefix_width> //= {};
push( @p_arg, join( '', qw| -lpw= |, $apw_href->{$zenka_name} ) )
    if defined $apw_href->{$zenka_name};

##                                       -v is min. [ zenka output patterns ]
my $zenka_verbosity = <system.zenka.verbosity.console> || 1;
push @p_arg, join( '', qw| - |, qw| v | x $zenka_verbosity );

<[base.logs]>->( 1, 'starting of %s zenka initiated ..,', $zenka_sn_str );
<[base.logs]>->( 2, ": exec args : ' %s '", join( ' ', @p_arg ) );

my @cmd_line_mods
    = defined $init_result_data->{'command_line_modules'}
    ? map { sprintf qw| -M%s |, $ARG }
    split( m| +|, $init_result_data->{'command_line_modules'} )
    : ();

{
    ##  caller-supplied env override for stdin-zenka mode  ##
    if ( defined $env_override_key ) {
        <[base.logs]>->(
            1,             "'%s' start env_override : %s",
            $zenka_sn_str, $env_override_key
        );
    }
    local $ENV{$env_override_key} = $env_override_value
        if defined $env_override_key;

    if (@cmd_line_mods) {
        my $_C = <system.perl_unicode>;
        push( @cmd_line_mods, sprintf( qw| -C%d |, $_C ) ) if defined $_C;

        $pid = eval {
            IPC::Open2::open2( $out_fh, $in_fh, $perl_bin, @cmd_line_mods,
                $bin_p7_path, $zenka_sn_str, @p_arg );
        };
    } else {
        $pid = eval {
            IPC::Open2::open2( $out_fh, $in_fh, $bin_p7_path, $zenka_sn_str,
                @p_arg );
        };
    }
}

SKIP_OPEN2:

if ( not defined $pid or length $EVAL_ERROR ) {
    $EVAL_ERROR =~ s,^open2: |\.?\n$,,g;
    my $err_reason
        = length($OS_ERROR)
        ? sprintf( " ['%s']", scalar <[base.str.os_err]> )
        : '';
    <[base.logs]>->(
        0, 'cannot start %s zenka %s [ %s ]',
        $zenka_name, $err_reason, scalar <[base.str.eval_error]>
    );
    <[zenka.change_status]>->( $instance_id, qw| error | );
    return undef;
}

### ZENKA CONSOLE OUTPUT ###

my $io = IO::Handle->new();
$io->fdopen( fileno($out_fh), qw| r | );
$io->blocking(0);

$instance->{'console-output'} = IO::Select->new();
$instance->{'console-output'}->add($io);    ## <-- [ can_read ] ##

## prio 0 : live-swept 0/1/2/3/4/-1/5 under full backend start [-vvvq] : 0  ##
## settled fastest, 1-4 all settled but slower, 5 and -1 both confirmed     ##
## broken. -1 [ "bypass the queue, invoke immediately" per Event.pm docs ]  ##
## reentrantly starved v7's own init-code-push step [ live hang at          ##
## "awaiting init-code on stdin" ] -- unlike base.handler.write's /         ##
## output_buffer's -1 usage, which is safe only because those are           ##
## repeat=>FALSE one-shot EAGAIN retries, not a fitting model for this      ##
## long-lived repeating drain. the prior 'prio => 5' sat inert for 11 years ##
## [ masked by the base.event.add_io prio-copy-paste bug ] until the        ##
## wrapper fix made it real and exposed the starvation the other way        ##
<[event.add_io]>->(
    {   'fd'      => $io,
        'handler' => qw| v7-zenki.handler.zenka_output |,
        'prio'    => 0,
        'data'    => $instance_id,
        'poll'    => qw| re |,
    }
);
###

<[v7-zenki.child.add]>->(
    $pid,
    { qw|instance_id| => $instance_id, qw|start_time| => <[base.ntime]> }
);

$instance->{'process'} = { qw| id | => $pid, };                      # ..,
$instance->{'subname'} = $zenka_subname if defined $zenka_subname;

<[zenka.change_status]>->( $instance_id, qw| extbin | )
    if defined $init_result_data->{'start_mode'}
    and $init_result_data->{'start_mode'} eq qw| exec-external |;

## pushing init-code to zenka <stdin> [ if in stdin-mode., ] ##
if ($stdin_mode) {
    <[base.logs]>->(
        ': pushing start-up init-code < %s zenka >', $zenka_name
    );
    foreach my $_line ( @{ $init_code->{'zenka-init'} } ) {
        my $code_line = $_line;    # <-- keeping copy
           # <{mod.cmd}> [ zenka instance namespace ] variable fetching syntax
        while ( $code_line =~ m|<\{([^\}]+)\}>| ) {
            ( my $var_str = "{'$LAST_PAREN_MATCH'}" ) =~ s|\.|'}{'|g;
            my $var_value;
            eval "\$var_value = $namespace_str$var_str";
            if ( length $EVAL_ERROR ) {
                $EVAL_ERROR =~ s|\n| |g;
                <[base.logs]>->(
                    0, '<< error in zenka init-code : %s >>',
                    <[base.str.eval_error]>
                );
                last;
            } else {
                $code_line =~ s|<\{([^\}]+)\}>|$var_value|;
            }
        }
        say {$in_fh} $code_line;
    }
}
close($in_fh);    ## <-- no further use for zenka stdin handle [ for now ] ##

<[base.logs]>->( '%s zenka started [ pid : %d ]', $zenka_sn_str, $pid );

