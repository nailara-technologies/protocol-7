## [:< ##

# name  = plugin.web.space.orbital.init_code
# descr = initialize orbital data endpoint cache and repeating fetch timer

## orbital data cache : populated by async fetch, read by json endpoint ##
<web.space.orbital.cache> = {
    qw| data            | => {},
    qw| timestamp       | => 0,
    qw| ttl             | => 13,
    qw| expected_fields | => [qw| self known connections gm_state |],
    qw| received_fields | => {},
};

## add nameserv to expected fields if configured ##
my $nameserv_domain = <nameserv.cfg.auto_publish_domain> // '';
if ( length $nameserv_domain ) {
    push <web.space.orbital.cache>->{'expected_fields'}->@*, qw| nameserv |;
}

## producers are subscribed on first use, not at start [ every host ran     ##
## discover \ external \ nodes \ graphics-matrix once httpd started, even   ##
## with nobody looking ] : plugin.web.space.orbital.activate, called by the ##
## space state endpoint. web.space.orbital.eager = yes keeps the old        ##
## start-time subscribing [ a desktop that always shows the view ]          ##
<web.space.orbital.active> = FALSE;
push <system.callbacks.initialized>->@*,
    qw| plugin.web.space.orbital.activate |
    if <[base.cfg_bool]>->( <web.space.orbital.eager> // FALSE );

<[base.log]>->( 2, qq| orbital data endpoint initialized | );

0;

