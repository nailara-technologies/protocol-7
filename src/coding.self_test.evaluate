## [:< ##

# name  = coding.self_test.evaluate
# descr = structural-check + tier-1 reformat step logic [ transport-free ]

## step API [ async transport rewrite 2026-07-31 ] : this module no longer  ##
## makes inference calls of its own. poll_probe drives it at each sub-phase ##
## boundary :  step 'init'       : tier0 + hint computation. returns  {     ##
## outcome=>'final', eval=>{...} } on a tier0  pass, or {                   ##
## outcome=>'request', request_prompt,  hint, state } when a tier1 reformat ##
## round-trip  is needed [ poll_probe fires it via async_probe ]  step      ##
## 'tier1_done' : a tier1 round completed. rechecks, bookkeeps @attempts,   ##
## and returns 'final' or the next  'request' [ strict-hint round ]  the    ##
## 'eval' payloads are byte-identical in shape to what this module returned ##
## synchronously before the rewrite                                         ##

my $params = shift             // {};
my $step   = $params->{'step'} // qw| init |;

if ( $step eq qw| init | ) {
    my $model_id   = $params->{'model_id'} // '';
    my $prompt     = $params->{'prompt'}   // '';
    my $answer     = $params->{'answer'}   // '';
    my $expected   = $params->{'expected'} // '';
    my $backend    = $params->{'backend'}  // 'gpu';
    my $constraint = $params->{'constraint'}
        // { type => 'exact', value => $expected };

    ## tier 0 : deterministic structural check, no inference ##
    my $check = <[coding.self_test.check_constraint]>->(
        {   answer     => $answer,
            constraint => $constraint,
            expected   => $expected,
        }
    );

    if ( $check && $check->{'mode'} eq qw| true | ) {
        return {
            outcome => qw| final |,
            eval    => {
                mode             => qw| true |,
                data             => $answer,
                tier             => 'literal',
                constraint_check => $check->{'data'} // '',
            },
        };
    }

    my $structural_reason = ( $check->{'data'} // 'mismatch' );

    ## did the ORIGINAL answer already contain every required token ?       ##
    ## tier0's word_count check short-circuits on over_word_limit BEFORE    ##
    ## ever testing must_contain, so structural_reason alone can't tell us  ##
    ## this - a verbose-but-substantively-correct answer [ eg "The cat.     ##
    ## Because it ate the mouse." ] and a genuinely wrong one both produce  ##
    ## over_word_limit. check independently : only a genuine content        ##
    ## problem should ever see the mismatch_hint challenge - confirmed      ##
    ## live: appending it to a purely format-only reformat second-guessed   ##
    ## an already-correct answer and flipped it to wrong during the restate ##
    my $content_already_correct = FALSE;
    {
        my $must_param = $constraint->{'must_contain'};
        my @required
            = ref $must_param eq qw| ARRAY |
            ? @$must_param
            : ( defined $must_param ? ($must_param) : () );
        if (@required) {
            my $folded = lc $answer;
            $content_already_correct = !grep {
                my $needle = lc $_;
                $folded !~ m{(?:^|[^a-z0-9])\Q$needle\E(?:[^a-z0-9]|$)}
            } @required;
        }
    }

    ## tier 1 : same-context reformat request to the same model, up to two ##
    ## attempts. neither hint may disclose $expected - only the constraint ##
    ## itself [ type / max_words / template ] and, on the retry, the prior ##
    ## violation [ eg "you used 56 words, limit is 2" ] may be cited, so a ##
    ## stricter retry can never amount to "the answer is X" - confirmed    ##
    ## acceptable scope with the user 2026-06-21.                          ##
    my $type = $constraint->{'type'} // 'exact';

    ## local reformat : skip the tier1 inference round-trip entirely when   ##
    ## the raw answer already contains every required token and the         ##
    ## constraint is word_count -- extracting the matching token is a       ##
    ## deterministic string op, not a second real inference call that can   ##
    ## independently fail for reasons unrelated to content [ confirmed live ##
    ## 2026-08-27 : a verbose-but-content-correct answer ["The cat. The     ##
    ## mouse is now a snack."] failed self-test because the tier1 reformat  ##
    ## request twice spent its whole reply on reasoning and emitted no      ##
    ## final content -- the seed-retry safety net recovered it, but the     ##
    ## round-trip was never needed at all ]. only word_count : that's the   ##
    ## constraint this failure mode was observed against, and the single-   ##
    ## scalar must_contain shape check_constraint's word_count branch reads ##
    ## makes a whole-token extraction unambiguous. numeric/sprintf/exact    ##
    ## keep going through tier1 unchanged - not the same simple shape       ##
    if ( $content_already_correct and $type eq qw| word_count | ) {
        my $must_scalar = $constraint->{'must_contain'} // $expected;
        if ( length $must_scalar
            and $answer
            =~ m{(?:^|[^a-z0-9])(\Q$must_scalar\E)(?:[^a-z0-9]|$)}i ) {
            my $local_answer = $1;

            ## re-verify through the SAME check the tier1 recheck path     ##
            ## uses, rather than assuming a single-token extraction always ##
            ## satisfies the full constraint [ eg an unusual max_words ]   ##
            my $local_check = <[coding.self_test.check_constraint]>->(
                {   answer     => $local_answer,
                    constraint => $constraint,
                    expected   => $expected,
                }
            );

            if ( $local_check and $local_check->{'mode'} eq qw| true | ) {
                <[base.logs]>->(
                    1,
                    '[self_test] local reformat : model %s '
                        . ': %s -> %s [ tier1 round-trip skipped ]',
                    $model_id,
                    $answer,
                    $local_answer
                );
                return {
                    outcome => qw| final |,
                    eval    => {
                        mode               => qw| true |,
                        data               => $local_answer,
                        tier               => qw| local_reformat |,
                        original_answer    => $answer,
                        reformatted_answer => $local_answer,
                        structural_reason  => $structural_reason,
                    },
                };
            }
        }
    }

    my $base_hint = sub {
        if ( $type eq 'numeric' ) {
            return 'Please restate your final answer as '
                . 'only the number, with no other text.';
        } elsif ( $type eq 'word_count' ) {
            my $max = $constraint->{'max_words'} // $constraint->{'max'} // 1;
            return $max <= 1
                ? 'Please restate your final answer in '
                . 'exactly one word, with no other text.'
                : sprintf 'Please restate your final answer in '
                . 'at most %d words, with no other text.', $max;
        } elsif ( $type eq 'sprintf' ) {
            my $tmpl = $constraint->{'template'} // '';
            return
                sprintf 'Please restate your final answer '
                . 'matching this exact format: %s', $tmpl;
        }
        return 'Please restate your final answer as only the '
            . 'short expected phrase, with no other text.';
    };

    ## stricter retry hint, built only from the prior structural violation ##
    ## - never from $expected                                              ##
    my $strict_hint = sub {
        my ($reason) = @ARG;
        if (   $type eq 'word_count'
            && $reason =~ m{over_word_limit:(\d+)>(\d+)} ) {
            my ( $got, $max ) = ( $1, $2 );
            return
                sprintf
                'Your reply still contained %d words and explanation - the '
                . 'limit is %d. Remove ALL explanation and reply with at '
                . 'most %d word%s and nothing else.', $got, $max, $max,
                $max == 1 ? '' : 's';
        }
        if ( $type eq 'numeric' ) {
            return
                  'Your reply still contained extra text. Reply with ONLY '
                . 'the digits of the number - no words, punctuation, '
                . 'or explanation.';
        }
        if ( $type eq 'sprintf' ) {
            my $tmpl = $constraint->{'template'} // '';
            return
                sprintf
                'Your reply still did not match the required format. Reply '
                . 'using EXACTLY this format and nothing else: %s', $tmpl;
        }
        return 'Your reply still contained extra text. Reply with '
            . 'nothing but the short phrase itself, no explanation.';
    };

    ## append the constraint's optional reasoning nudge [ never $expected ##
    ## itself ] to a base/strict hint - same scope rule as $base_hint /   ##
    ## $strict_hint : guides logic, never states the answer               ##
    my $with_mismatch_hint = sub {
        my ($hint) = @ARG;
        return $hint if $content_already_correct;    ## format-only fix, ##
        ## no logic challenge                                            ##
        my $extra = $constraint->{'mismatch_hint'} // '';
        return length $extra ? "$hint $extra" : $hint;
    };

    my $hint = $with_mismatch_hint->( $base_hint->() );

    return {
        outcome        => qw| request |,
        request_prompt => "For the question: $prompt\nYou "
            . "answered: $answer\n\n"
            . $hint,
        hint  => $hint,
        state => {
            model_id           => $model_id,
            prompt             => $prompt,
            answer             => $answer,
            expected           => $expected,
            backend            => $backend,
            constraint         => $constraint,
            structural_reason  => $structural_reason,
            strict_hint        => $strict_hint,
            with_mismatch_hint => $with_mismatch_hint,
            strict_rounds_used => 0,
            attempts           => [],
        },
    };
}

if ( $step eq qw| tier1_done | ) {
    my $eval_state = $params->{'state'} // {};
    my $hint       = $params->{'hint'}  // '';
    my $tier1      = $params->{'tier1'} // {};
    my $backend  = $params->{'backend'} // $eval_state->{'backend'} // 'gpu';
    my $model_id = $eval_state->{'model_id'} // '';
    my $attempts = $eval_state->{'attempts'} //= [];

    my $ok          = FALSE;
    my $reformatted = '';
    my $reason      = '';
    my $tail        = '';

    if ( !$tier1 || $tier1->{'mode'} ne qw| true | ) {
        $reason
            = 'tier1_inference_failed: ' . ( $tier1->{'data'} // 'no reply' );

        ## same server-output visibility as the probe's own failure path ##
        if ( ( $tier1->{'data'} // '' ) =~ m{^http_5\d\d$} ) {
            $tail
                = <[coding.self_test.helper.capture_server_tail]>->($backend)
                // '';
        }

        push @{$attempts},
            {
            hint        => $hint,
            reformatted => '',
            reason      => $reason,
            ok          => FALSE,
            server_tail => $tail,
            };
    } else {
        $reformatted = $tier1->{'data'} // '';
        $reformatted =~ s/[\x00-\x08\x0b\x0c\x0e-\x1f]//g;

        my $recheck = <[coding.self_test.check_constraint]>->(
            {   answer     => $reformatted,
                constraint => $eval_state->{'constraint'},
                expected   => $eval_state->{'expected'},
            }
        );

        $ok = $recheck && $recheck->{'mode'} eq qw| true |;
        $reason
            = $ok ? '' : ( $recheck->{'data'} // 'tier1_recheck_mismatch' );

        ## same "empty content but the model DID reason" signal poll_probe ##
        ## already logs for the tier0 answer [ confirmed live : whole      ##
        ## max_tokens budget went to the <think> trace ] -- this branch    ##
        ## never checked it for a tier1 reformat round, so an empty        ##
        ## reformat always surfaced as a bare missing_token/exact_mismatch ##
        ## with no visibility into why. reasoning/finish_reason are only   ##
        ## stored, not acted on here -- self-test-detail surfaces them     ##
        my $reasoning     = $tier1->{'reasoning'}     // '';
        my $finish_reason = $tier1->{'finish_reason'} // '';
        if ( !length $reformatted and length $reasoning ) {
            <[base.logs]>->(
                1,
                '[self_test] tier1 reformat : model %s : empty content, '
                    . 'reasoning present [ finish_reason=%s, %d chars ]',
                $model_id,
                $finish_reason || 'unknown',
                length $reasoning
            );
        }

        push @{$attempts},
            {
            hint          => $hint,
            reformatted   => $reformatted,
            reason        => $reason,
            ok            => $ok,
            reasoning     => $reasoning,
            finish_reason => $finish_reason,
            };
    }

    if ($ok) {
        <[base.logs]>->(
            1, '[self_test] tier1 reformat PASS : model %s : %s -> %s',
            $model_id, $eval_state->{'answer'} // '', $reformatted
        );
        return {
            outcome => qw| final |,
            eval    => {
                mode               => qw| true |,
                data               => $reformatted,
                tier               => 'tier1_reformat',
                original_answer    => $eval_state->{'answer'},
                reformatted_answer => $reformatted,
                structural_reason  => $eval_state->{'structural_reason'},
                tier1_attempts     => $attempts,
            },
        };
    }

    ## strict-hint round : only on a genuine mismatch, never on a transport ##
    ## failure [ same condition as the old blocking code ]. round count is  ##
    ## config-bounded [ coding.cfg.self_test_tier1_extra_rounds, default 1  ##
    ## -- matches the original single-strict-hint behaviour ] rather than a ##
    ## single boolean, so operators can trade more retries for slower       ##
    ## worst-case runs. poll_probe derives its watchdog budget from this    ##
    ## same config value -- see the comment there -- so raising it here     ##
    ## alone is safe and won't race the queue-resume ceiling fixed in       ##
    ## 4c3cf0e73. reusing $strict_hint for every round is deliberate, not   ##
    ## an oversight: it's not a static repeat -- $reason (and so the hint   ##
    ## text) reflects whatever the LATEST violation was, so round 3 nudges  ##
    ## on round 2's actual mistake, not round 1's. a model that flips its   ##
    ## own answer between rounds on an identical hint is itself useful      ##
    ## nondeterminism signal, not a bug to route around.                    ##
    my $extra_rounds_allowed = <coding.cfg.self_test_tier1_extra_rounds> // 1;
    if (    $eval_state->{'strict_rounds_used'} < $extra_rounds_allowed
        and $reason !~ m{^tier1_inference_failed} ) {
        <[base.logs]>->(
            1,
            '[self_test] tier1 reformat attempt %d failed : model %s : %s',
            $eval_state->{'strict_rounds_used'} + 1,
            $model_id, $reason
        );
        $eval_state->{'strict_rounds_used'}++;
        my $strict = $eval_state->{'with_mismatch_hint'}
            ->( $eval_state->{'strict_hint'}->($reason) );
        return {
            outcome        => qw| request |,
            request_prompt => "For the question: "
                . ( $eval_state->{'prompt'} // '' )
                . "\nYou answered: $reformatted\n\n"
                . $strict,
            hint  => $strict,
            state => $eval_state,
        };
    }

    ## tier 0 and tier 1 [ two attempts ] failed - defer to caller for tier ##
    ## 2                                                                    ##
    return {
        outcome => qw| final |,
        eval    => {
            mode               => qw| false |,
            data               => 'mismatch',
            needs_tier2        => TRUE,
            original_answer    => $eval_state->{'answer'},
            reformatted_answer => $reformatted,
            structural_reason  => $eval_state->{'structural_reason'},
            tier1_reason       => $reason // 'tier1_recheck_mismatch',
            tier1_attempts     => $attempts,
            server_tail        => $tail // '',
        },
    };
}

return {
    outcome => qw| final |,
    eval    => { mode => qw| false |, data => "unknown evaluate step $step" },
};

