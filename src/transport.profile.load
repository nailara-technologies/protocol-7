## [:< ##

# name  = transport.profile.load
# descr = load and cache a transport profile from yaml
# args  = $profile_name (e.g., 'atom', 'default')

my $name = shift // return undef;

## return cached ##
my $cached = <transport.registry>->{'profiles'}->{$name};
return $cached if defined $cached;

my $dir  = <transport.cfg.profile_dir> // 'data/yaml/transport/profiles';
my $path = sprintf '%s/%s.yaml', $dir, $name;

return undef if not -f $path;

my ( $profile, $yaml_err ) = <[format.yaml.load_file]>->($path);
if ( not defined $profile ) {
    <[base.logs]>->(
        0,     'transport.profile.load: failed to load %s: %s',
        $path, $yaml_err // 'unknown'
    );
    return undef;
}

## basic validation ##
if ( not exists $profile->{'transports'}
    or ref $profile->{'transports'} ne qw| ARRAY | ) {
    <[base.logs]>
        ->( 0, 'transport.profile.load: no transports in %s', $path );
    return undef;
}

## cache ##
<transport.registry>->{'profiles'}->{$name} = $profile;

return $profile;

