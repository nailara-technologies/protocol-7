## [:< ##

# name = protocol-7-menu.menu-structure-init
# descr = Initialize menu structure with change watcher for push-based updates

## Initialize canonical menu structure
<protocol-7-menu.menu-structure> //= {
    'last-changed' => <[base.ntime.b32]>,
    'providers'    => {},
};

my $menu_structure = <protocol-7-menu.menu-structure>;

## Install change watcher on menu structure  Fires when 'last-changed' is
## written to (indicating external update)
$menu_structure->{'watcher'} = <[event.add_var]>->(
    {   'var'     => \$menu_structure->{'last-changed'},
        'poll'    => qw| w |,
        'handler' => qw| protocol-7-menu.structure-changed |,
        'repeat'  => TRUE,
        'desc'    => 'protocol-7-menu structure change watcher'
    }
);

<[base.log]>->( 1, 'menu structure initialized with change watcher' );

return 0;

