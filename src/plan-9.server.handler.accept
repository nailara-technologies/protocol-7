## [:< ##
# name  = plan-9.server.handler.accept
# descr = event.add_io callback for the 9P listener socket -- accepts the
#         new connection, then registers a read handler on it. Mirrors
#         proxy.handler.accept's shape exactly; plan-9.server.client.accept
#         already does the per-client state init correctly, it was just
#         never called from anywhere.

my $listen_sock = shift->w->data;

my $client_sock = $listen_sock->accept;
return if not $client_sock;

$client_sock->blocking(0);

my $fd        = fileno($client_sock);
my $peer_addr = $client_sock->peerhost // 'unknown';

<[plan-9.server.client.accept]>->( $fd, $peer_addr );
$data{'plan-9'}{'server'}{'clients'}{$fd}{'sock'} = $client_sock;

$data{'plan-9'}{'server'}{'clients'}{$fd}{'watcher'} = <[event.add_io]>->(
    {   fd      => $client_sock,
        poll    => 'r',
        handler => 'plan-9.server.handler.read',
        data    => $fd,
        desc    => '9P client read handler'
    }
);

return;

