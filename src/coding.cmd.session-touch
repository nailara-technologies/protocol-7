## [:< ##

# name  = coding.cmd.session-touch
# param = name=<n> type=<t> [ via= dispatches= sid= ]
# descr = a session reports activity
#
# types : claude-live claude-zenka kimi-acp kimi-tui

my %in;
foreach my $word ( split m{\s+}, $call->{'args'} // '' ) {
    next if not length $word;
    my ( $key, $value ) = $word =~ m{\A(name|type|via|dispatches|sid)=(.*)\z};
    return { 'mode' => qw| false |, 'data' => "unexpected '$word'" }
        if not defined $key;
    $in{$key} = $value;
}
return { 'mode' => qw| false |, 'data' => 'name=<name> expected' }
    if ( $in{'name'} // '' ) !~ m|\A[\w.\-]{1,64}\z|;
return {
    'mode' => qw| false |,
    'data' => 'type : claude-live claude-zenka kimi-acp kimi-tui'
    }
    if ( $in{'type'} // '' )
    !~ m{\A(?:claude-live|claude-zenka|kimi-acp|kimi-tui)\z};
return { 'mode' => qw| false |, 'data' => 'via : a short word' }
    if ( $in{'via'} // '' ) !~ m|\A[\w.\-]{0,64}\z|;
return { 'mode' => qw| false |, 'data' => 'dispatches : a number' }
    if ( $in{'dispatches'} // 0 ) !~ m|\A\d{1,4}\z|;
return { 'mode' => qw| false |, 'data' => 'sid : a uuid' }
    if defined $in{'sid'}
    and ( $in{'sid'} = lc $in{'sid'} )
    !~ m|\A[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}\z|;

my $r = <[coding.sessions.touch]>->( \%in );
return {
    'mode' => qw| true |,
    'data' => defined $r ? "session $in{'name'} noted" : 'not registered'
};

