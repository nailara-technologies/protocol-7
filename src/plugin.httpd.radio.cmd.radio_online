## [:< ##

# name  = plugin.httpd.radio.cmd.radio_online
# descr = activate radio stream endpoint on radio_online
# param = stream path [ optional, default /radio/stream ]

my $call_args = shift;

my $path = ( $call_args // {} )->{'args'};
$path = '/radio/stream' if not defined $path or not length $path;

## already active : re-announcing the same endpoint must NOT re-subscribe   ##
## -- each call used to push another v7.notify_offline entry that never got ##
## cleared until an eventual real shutdown fired ALL of them at once        ##
my $already_active = <plugin.httpd.radio.active>;

<plugin.httpd.radio.stream.path> = $path;
<plugin.httpd.radio.active>      = 1;

##  invalidate any cached route for this path  ##
delete $data{'route_cache'}{ "GET:$path:" . $_ }
    for keys %{ $data{'session'} };
$data{'route_cache'} = {}
    if exists $data{'route_cache'};

<[base.logs]>->( 2, '[httpd.radio] endpoint active: %s', $path );

##  subscribe to notify_offline so endpoint disables on radio crash  ##
<[protocol-7.route-send]>->(
    {   'command'   => 'v7.notify_offline',
        'call_args' => { 'args' => 'radio' },
        'reply' => { 'handler' => 'plugin.httpd.radio.handler.radio_offline' }
    }
) if not $already_active;

return { 'mode' => qw| true |, 'data' => "radio endpoint active: $path" };

