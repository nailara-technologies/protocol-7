# name  = httpd.cmd.signature-mode
# param = <vhost> <off|verify|require>
# descr = set per-vhost signed-file mode

my ( $vhost, $mode ) = split( m|\s+|, $call->{'args'} // '', 2 );
$mode //= '';
return { qw| mode | => qw| false |, qw| data | => 'expected vhost and mode' }
    if not length( $vhost // '' )
    or not grep { $mode eq $ARG } qw| off verify require |;
return { qw| mode | => qw| false |, qw| data | => 'unknown vhost' }
    if not exists <httpd.cfg.hostnames>->{$vhost};
my $modes = <httpd.cfg.signature_mode> // qw| verify |;
<httpd.cfg.signature_mode> = { qw| default | => $modes }
    if ref $modes ne qw| HASH |;
<httpd.cfg.signature_mode>->{$vhost} = $mode;
return { qw| mode | => qw| true |, qw| data | => $mode };

