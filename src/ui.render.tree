## [:< ##

# name  = ui.render.tree
# descr = render a node as a fitted, foldable tree against a budget
# param = { address, slot_budget?, depth? = 0 }

my $address     = $ARG[0]->{'address'} // '';
my $slot_budget = $ARG[0]->{'slot_budget'};
my $depth       = $ARG[0]->{'depth'} // 0;

return '' if not length $address;

## derive budget from tty if omitted
if ( not defined $slot_budget ) {
    $slot_budget
        = eval { <[ui.budget.tty]>->( { 'reserve_rows' => 2 } ) }
        // { 'cols' => 80, 'rows' => 22 };
}

my $budget_rows = $slot_budget->{'rows'} // 22;
my $budget_cols = $slot_budget->{'cols'} // 80;

## [ frame overhead placeholder — baseline renders un-framed when no .ui.frame
## template is registered, satisfying pre-frame acceptance ]
my $frame_overhead = 0;
my $has_frame      = FALSE;

if ( defined $code{"$address.ui.frame"} ) {
    $has_frame      = TRUE;
    $frame_overhead = 2;      ## top + bottom border rows ##
}

my $inner_rows = $budget_rows - $frame_overhead;
$inner_rows = 1 if $inner_rows < 1;

my $inner_budget = {
    'cols' => $budget_cols,
    'rows' => $inner_rows
};

## decide layout
my $layout = eval {
    <[ui.layout.fit]>->(
        {   'address'     => $address,
            'slot_budget' => $inner_budget
        }
    );
} // [];

## leaf node — render as folded handle when no children exist
if ( not scalar @$layout ) {
    my $handle = eval { <[ui.fold]>->( { 'address' => $address } ) };
    if (    defined $handle
        and ref $handle eq 'HASH'
        and exists $handle->{'data'} ) {
        return $handle->{'data'};
    }
    return '';
}

my @unfold;
my @fold;

for my $entry ( $layout->@* ) {
    if ( $entry->{'mode'} eq qw| unfold | ) {
        push @unfold, $entry;
    } else {
        push @fold, $entry;
    }
}

## sub-budget allocation for unfolded children
my $total_unfold_cost = 0;
for my $entry (@unfold) {
    my $cost = eval {
        <[ui.estimate.cost]>->( { 'address' => $entry->{'child_address'} } );
    } // { 'rows' => 1, 'cols' => 40 };
    $entry->{'cost'} = $cost;
    $total_unfold_cost += $cost->{'rows'} // 1;
}

## reserve one row for the trailing handle when folded children exist
my $unfold_budget_rows = $inner_rows;
if ( scalar @fold > 0 ) {
    $unfold_budget_rows--;
    $unfold_budget_rows = 1 if $unfold_budget_rows < 1;
}

## pre-compute proportional allocations so sum equals unfold_budget_rows
my @allocations;
for my $entry (@unfold) {
    my $cost_rows = $entry->{'cost'}{'rows'} // 1;
    my $allocated
        = $total_unfold_cost > 0
        ? int( $unfold_budget_rows * $cost_rows / $total_unfold_cost + 0.5 )
        : 1;
    $allocated = 1 if $allocated < 1;
    push @allocations, $allocated;
}

my $sum_alloc = 0;
$sum_alloc += $ARG for @allocations;
my $deficit = $unfold_budget_rows - $sum_alloc;

if ( $deficit > 0 ) {
    for my $i ( reverse 0 .. $#allocations ) {
        last if $deficit <= 0;
        $allocations[$i] += 1;
        $deficit--;
    }
} elsif ( $deficit < 0 ) {
    for my $i ( 0 .. $#allocations ) {
        last if $deficit >= 0;
        next if $allocations[$i] <= 1;
        $allocations[$i] -= 1;
        $deficit++;
    }
}

my @lines;
my $pool_rows = 0;

for my $i ( 0 .. $#unfold ) {
    my $entry     = $unfold[$i];
    my $allocated = $allocations[$i] + $pool_rows;
    $pool_rows = 0;
    $allocated = 1 if $allocated < 1;

    my $rendered = eval {
        <[ui.render.tree]>->(
            {   'address'     => $entry->{'child_address'},
                'slot_budget' => {
                    'cols' => $budget_cols,
                    'rows' => $allocated
                },
                'depth' => $depth + 1
            }
        );
    } // '';

    my $actual_rows = ( $rendered =~ tr/\n// );
    $actual_rows++ if length $rendered and substr( $rendered, -1 ) ne "\n";

    $pool_rows += $allocated - $actual_rows;

    push @lines, $rendered;
}

## trailing handle for folded children [ grouped into one line ]
if ( scalar @fold > 0 ) {
    my $folded_count = scalar @fold;
    my $handle       = eval {
        <[ui.fold]>->(
            {   'address' => "$address.__more__",
                'kind'    => "+$folded_count more",
                'summary' => '...'
            }
        );
    };
    if (    defined $handle
        and ref $handle eq 'HASH'
        and exists $handle->{'data'} ) {
        push @lines, $handle->{'data'};
    } else {
        push @lines,
            sprintf '.:[ +%d more ]:[ __more__ ]:[ ... ]:.', $folded_count;
    }
}

my $output = join "\n", @lines;

## [ frame wrapping ]
if ($has_frame) {
    ## LLL: integrate with ascii.frame.render once frame templates exist
    $output = ".:[ $address ]:.\n" . $output . "\n:.:";
}

return $output;

