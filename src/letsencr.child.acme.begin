## [:< ##

# name  = letsencr.child.acme.begin
# param = <request hash>
# descr = start an acme order, or queue it behind the active one
# note  = request : { domains, email, server, reply_id, label }

my $req = shift // {};

## one order at a time : the client state [ server, account key, nonce, ##
## account url in <letsencr.child.acme_client> ] belongs to the active  ##
## order -- park the request, finish \ fail starts it                   ##
if ( defined <letsencr.child.acme.active> ) {
    push <letsencr.child.acme.queue>->@*, $req;
    <[base.logs]>->(
        2,
        ': acme : %s queued behind the active order [ %d waiting ]',
        $req->{'label'} // $req->{'domains'}->[0],
        scalar <letsencr.child.acme.queue>->@*
    );
    return { 'mode' => qw| deferred | };
}

if ( not ref $req->{'domains'} eq qw| ARRAY | or not $req->{'domains'}->@* ) {
    return { 'mode' => qw| false |, 'data' => 'domains required' };
}

## local + quick : server context [ resets the client state when the server ##
## changes ] and its account key [ separate per server ]                    ##
my $server = <[letsencr.child.acme_use_server]>->( $req->{'server'} );

my $key = <[letsencr.child.load_account_key]>->($server)
    // <[letsencr.child.generate_account_key]>;
return { 'mode' => qw| false |, 'data' => 'no acme account key' }
    if not $key;

<letsencr.child.acme_client>->{'contact_email'} = $req->{'email'}
    // <letsencr.admin.email>;

<[base.logs]>->(
    2,
    ': acme : order for %s [ %s ]',
    join( ' ', $req->{'domains'}->@* ), $server
);

my $order_id = <[letsencr.child.acme.start]>->($req);

return { 'mode' => qw| false |, 'data' => 'acme order could not start' }
    if not defined $order_id;

return { 'mode' => qw| deferred | };

