## [:< ##

# name  = user-edit.form.schema_from_record
# descr = derive an editor.control schema from a users.* record envelope
# param = $record [ , $submit_on ]

## the record's settings payload is deliberately open [ users-zenka.yaml : no
## declared settings field list exists anywhere yet ], so the form schema is
## DERIVED at runtime from whatever keys the record actually carries, rather
## than declared here.  when a real field list eventually exists this stays
## valid — typed/enum/validator field defs then merge on top of what this
## returns, they do not replace it.
##
## every field is a freeform_line : editor.control.create rejects every other
## type as interface-only, and no setting is known to be enum- or secret-
## shaped yet [ user-edit-console-zenka.yaml : field_types_needed ]

my ( $record, $submit_on ) = @ARG;

return undef if ref $record ne qw| HASH |;

my $fields = $record->{'fields'};
$fields = {} if ref $fields ne qw| HASH |;

my @field_defs;

## which list fields re-sort the moment focus ENTERS them, mid-session --
## editor.control.list.expand reads the per-field 'sort_on_focus' flag below
## and stays entirely unaware of WHY [ generic, zenka-agnostic machinery ].
##
## DUPLICATES users.record.sorted_fields's list rather than calling it :
## user-edit and users are SEPARATE zenka processes, each with its own
## compiled %code -- <[users.record.sorted_fields]> is not reachable from here
## at all [ confirmed live : 'subroutine not defined', the same reason
## user-edit talks to users only over the cube link, e.g.
## user-edit.console.show-form's N.users.value-get ], and loading the whole
## users.* module family into user-edit's deliberately narrow modules.load [
## see this zenka's start file header ] just to reach one two-item list would
## be a much larger coupling than the duplication it avoids.  keep the two
## lists in sync by hand if the vocabulary ever changes
my %sort_on_focus = map { $ARG => TRUE } qw| contact phone |;

## which SCALAR fields render/edit as multiple windowed display rows instead
## of one -- see user-edit-multiline-note.yaml.  NOT hand-duplicated like
## %sort_on_focus above : user-edit.form.add_field needs this SAME list too [
## found live -- a freshly-added field was single-line until save+reload, see
## that module's own name-list header for the full account ], and both call
## sites live in this one zenka's process, so one shared module is correct
## here rather than two copies drifting
my %multiline = map { $ARG => TRUE } <[user-edit.form.multiline_field_names]>;

## which SCALAR fields collapse to a ':..15.characters..:' length summary when
## not focused -- same shared-module reasoning as %multiline immediately
## above, see user-edit.form.collapse_summary_field_names' own header
my %collapse_summary
    = map { $ARG => TRUE } <[user-edit.form.collapse_summary_field_names]>;

## DISPLAY order, not storage order : base.reverse-sort [ length descending,
## alphabetical-descending tiebreak -- see base.each_sort / base.cmd.commands
## for the same idiom elsewhere ] rather than a plain alphabetical `sort`, per
## user.  applied ONCE, at the very end of this function, across the UNION of
## real field names and any synthesised ones [ identity_key / user_keys below
## ] -- per user, a synthesised field is just another named row for ordering
## purposes, not something pinned to a fixed trailing position regardless of
## its own name's length.  this loop therefore only COLLECTS field defs by
## name now, it does not decide row order itself
my %field_def_by_name;

foreach my $name ( keys %{$fields} ) {

    ## ascii.frame slot tokens are \w+ [ ascii.frame.parse's own token regex
    ## ], so a field name that cannot become a slot name is skipped loudly
    ## here instead of rendering as a silently blank row
    if ( $name !~ m|^\w+$| ) {
        <[base.logs]>->(
            2, ': field name is not slot-safe, skipped [ %s ]', $name
        );
        next;
    }

    my $value = $fields->{$name} // '';

    ## an ARRAY becomes a LIST field : collapsed it draws as a count summary [
    ## editor.control.get_display_value ] and expands into one editable row
    ## per entry when entered.  the type stays freeform_line because
    ## editor.control.create accepts no other -- 'list' is metadata on the
    ## field def, and 'entries' is the authoritative value
    if ( ref $value eq qw| ARRAY | ) {
        $field_def_by_name{$name} = {
            qw| name |    => $name,
            qw| type |    => qw| freeform_line |,
            qw| default | => '',
            qw| list |    => TRUE,
            qw| entries | =>
                [ grep { defined $ARG and length $ARG } $value->@* ],
            qw| noun |          => qw| entr |,
            qw| noun_plural |   => qw| ies |,
            qw| noun_singular | => qw| y |,
            qw| sort_on_focus | => $sort_on_focus{$name} ? TRUE : FALSE,
        };
        next;
    }

    ## other nested structures have no freeform_line representation ##
    if ( length ref $value ) {
        <[base.logs]>->(
            2, ': field value is not a scalar, skipped [ %s ]', $name
        );
        next;
    }

    ## PLUGIN-PINNED key : per design doc data/yaml/coding-tasks/user-edit-
    ## plugin-detail-tabs.yaml, a field a plugin has pinned itself to stays a
    ## PLAIN SCALAR buffer [ get_value / submit / draft / outbox all keep
    ## working completely unmodified ] with only DISPLAY customised, via the
    ## GENERIC display_override hook editor.control.get_display_value now
    ## honours -- that module stays unaware this is "a plugin," it just calls
    ## a coderef.  readonly blocks ORDINARY typing before the field is entered
    ## [ user-edit.handler.stdin_key's Tab/Right trigger ] ; once entered [
    ## mode = 'plugin:<name>' ], that same handler routes every key straight
    ## to the plugin's own handler.key, bypassing editor.control.  process_key
    ## -- and process_key's readonly guard -- entirely, so this never blocks
    ## the plugin's OWN edits, only a stray keystroke that landed here before
    ## Tab/Right was pressed
    my $pinned_plugin = <user-edit.plugin.registry> {'by_key'}{$name};

    if ( defined $pinned_plugin ) {

        my $render_sub = sprintf( qw| %s.render |, $pinned_plugin );

        $field_def_by_name{$name} = {
            qw| name |             => $name,
            qw| type |             => qw| freeform_line |,
            qw| default |          => "$value",
            qw| readonly |         => TRUE,
            qw| plugin |           => $pinned_plugin,
            qw| display_override | => sub {
                my ( $render_state, $render_field ) = @ARG;
                return
                    exists $code{$render_sub}
                    ? $code{$render_sub}->( $render_state, $render_field )
                    : <[editor.control.get_value]>->(
                    $render_state, $render_field
                    );
            },
        };
        next;
    }

    $field_def_by_name{$name} = {
        qw| name | => $name,
        qw| type | => qw| freeform_line |,
        ## editor.buffer.memory.create reads the initial text from 'default' —
        ## NOT from a 'value' key
        qw| default |          => "$value",
        qw| multiline |        => $multiline{$name}        ? TRUE : FALSE,
        qw| collapse_summary | => $collapse_summary{$name} ? TRUE : FALSE,
    };
}

## SYNTHESISED, self-record-only : the invoking Unix user's OWN C25519
## identity [ key name / checksum / public key ] is NOT record data -- it
## lives in crypt.C25519's in-process key state, not in users' storage -- so
## it cannot arrive through the $fields loop above and must never be added to
## users.record.default_fields/.optional_fields either.  appended ONLY when
## the open record IS the invoking user's own [ the same comparison
## user-edit.handler.value_get_reply's create-admin gate uses, against the
## record envelope's own 'name' ] -- a self-viewing bootstrap record with zero
## real fields yet still gets a form holding just these read-only tabs rather
## than the empty-guard below bailing out, since it checks the FINAL
## @field_defs after the combined sort, not this loop's own contribution.
## mirrors the pinned-plugin field_def shape above exactly, just synthesised
## instead of derived from a real $fields entry --  'identity_key' is
## deliberately unlikely to collide with any future real record field.  NOT
## registered in plugin.user-edit.registry's by_key : that lookup is for
## fields that exist in $fields, and stdin_key's Right-entry trigger gated on
## it staying absent is exactly what keeps this display-only row un-enterable
if ( <user-edit.unix_user> eq ( $record->{'name'} // '' ) ) {

    ## 'user identity key' [ the HUMAN's own key ] is a concept separate from
    ## the zenka PROCESS's own <crypt.C25519.base_key_name> -- user-edit
    ## represents exactly one human, so defaulting the former to the latter
    ## HERE [ the first place user-edit needs it ] is valid for this zenka
    ## specifically, while keeping the two overrideable independently [ see
    ## crypt.C25519.post_init's header notes ].  the identity_key tab and the
    ## user_keys exclusion below both read the USER pointer now.
    <crypt.C25519.user_key_name> //= <crypt.C25519.base_key_name>;
    my $identity_name = <crypt.C25519.user_key_name> // '';

    ## NO priming call here anymore : the base_key_name hijack this file's
    ## earlier `<[crypt.C25519.key_vars]>->($identity_name)` worked around is
    ## fixed at the root in crypt.C25519.key_vars itself -- base_key_name is
    ## now established ONCE by post_init's bare startup call, and explicit-
    ## name lookups [ key_checksums etc. below ] no longer mutate it, so there
    ## is nothing left to lock in.  the old priming call is dead code.

    ## SYNTHESISED, self-record-only : every OTHER named C25519 key the
    ## invoking Unix user holds.  MOVED to
    ## user-edit.form.build_user_keys_field, 2026-08-15, unchanged in
    ## behaviour -- factored out so user-edit.  key_actions.submit_passphrase
    ## can rebuild this one field's def+buffer after a successful key-create,
    ## without a full schema rebuild [ a create excursion was otherwise
    ## invisible in the list until the next full reload, read live as "did it
    ## even create anything" ].  the builder is self-contained [ re-derives
    ## its own key-file list and identity name ], so nothing from this
    ## function's own $identity_name above is passed in
    $field_def_by_name{'user_keys'}
        = <[user-edit.form.build_user_keys_field]>;

    ## SYNTHESISED, self-record-only : the 'key actions' tab -- the first
    ## INTERACTIVE key feature [ create a new named C25519 key without leaving
    ## the form ], unlike the display-only identity_key / user_keys above.
    ## carries plugin => 'plugin.user-edit.key-actions' directly on its own
    ## field def, the same way identity_key does -- but UNLIKE identity_key it
    ## is ALSO pinned in the plugin registry's by_key map [
    ## plugin.user-edit.key-actions.tab_info's pinned_keys ], which is exactly
    ## what makes stdin_key's Right-entry trigger able to fire on it.  its
    ## Enter handler opens the in-frame key-create prompt chain [ editor.
    ## control.prompt.* ] rendered into THIS row -- nothing leaves the event
    ## loop for it any more [ the blocking-excursion shape is retired ]
    $field_def_by_name{'key_actions'} = {
        qw| name |             => qw| key_actions |,
        qw| type |             => qw| freeform_line |,
        qw| default |          => '',
        qw| readonly |         => TRUE,
        qw| plugin |           => qw| plugin.user-edit.key-actions |,
        qw| separator_before | => TRUE,
        qw| display_override | => sub {
            my ( $render_state, $render_field ) = @ARG;
            return
                exists $code{'plugin.user-edit.key-actions.render'}
                ? $code{'plugin.user-edit.key-actions.render'}
                ->( $render_state, $render_field )
                : '';
        },
    };

    ## OPT-IN detail display for identity_key, per user 2026-08-15 : same
    ## shape as user_keys' own display type, but AUTOMATIC rather than a
    ## manual toggle -- switches on its own once the identity key's name
    ## exceeds a threshold, reusing the row's EXISTING separator_before blank
    ## row for the checksum instead of a manually-flipped config.  reads the
    ## SAME $identity_name already resolved above for the user_keys exclusion,
    ## no second resolution needed. the identity key is immutable for this
    ## zenka's own process lifetime [ see plugin.
    ## user-edit.key-details.render's own header ], so this decision, made
    ## once here at schema-build time, never needs re-checking per render the
    ## way a live-changing value would
    <user-edit.cfg.identity_key_name_threshold> //= 20;
    my $identity_detail_mode = length($identity_name)
        > <user-edit.cfg.identity_key_name_threshold>;

    $field_def_by_name{'identity_key'} = {
        qw| name |     => qw| identity_key |,
        qw| type |     => qw| freeform_line |,
        qw| default |  => '',
        qw| readonly | => TRUE,
        qw| plugin |   => qw| plugin.user-edit.key-details |,
        ## own identity, not a record field -- a blank row above it sets it
        ## apart from a real field the same way the add-a-field row already
        ## does, instead of reading as stuck to whichever field happens to
        ## render immediately above it.  in detail mode, that SAME row carries
        ## the checksum instead of staying blank -- see user-edit.
        ## form.build_frame and editor.ui.ascii_frame.render_form
        qw| separator_before |     => TRUE,
        qw| identity_detail_mode | => $identity_detail_mode ? TRUE : FALSE,
        qw| display_override |     => sub {
            my ( $render_state, $render_field ) = @ARG;
            return
                exists $code{'plugin.user-edit.key-details.render'}
                ? $code{'plugin.user-edit.key-details.render'}
                ->( $render_state, $render_field )
                : '';
        },
    };
}

## ONE combined pass, across every name collected above -- real fields and any
## synthesised ones alike -- so a synthesised field's row position is governed
## by the SAME rule as everything else, per user, rather than a fixed trailing
## spot regardless of its own name's length
@field_defs = map { $field_def_by_name{$_} }
    <[base.reverse-sort]>->( \%field_def_by_name );

if ( not @field_defs ) {
    <[base.logs]>->(
        1,
        ': record has no editable scalar fields [ %s ]',
        $record->{'name'} // '?'
    );
    return undef;
}

return {
    qw| fields |       => \@field_defs,
    qw| active_field | => 0,
    qw| submit_on |    => $submit_on // qw| enter |,
};

