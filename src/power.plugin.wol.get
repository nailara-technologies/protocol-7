## [:< ##

# name  = power.plugin.wol.get
# descr = power driver 'wol' : reachability of the host
# param = ( $handle ) -> states [ 1 reachable, 0 not, E unknown without ip ]

my $dev = shift;

return undef if ref $dev ne qw| HASH |;

return ['E']
    if not defined $dev->{'ip'}
    or not length $dev->{'ip'};

return [ <[power.host_reachable]>->( $dev->{'ip'} ) == TRUE ? '1' : '0' ];

