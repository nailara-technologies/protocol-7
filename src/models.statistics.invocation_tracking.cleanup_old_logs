# name  = models.statistics.invocation_tracking.cleanup_old_logs

my $cutoff = time() - ( 90 * 86400 );
@{ $data{models}{operation_log} } = grep { $_->{timestamp} > $cutoff }
    @{ $data{models}{operation_log} // [] };
return 1;

