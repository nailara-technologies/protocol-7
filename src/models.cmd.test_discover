# name = models.cmd.test_discover
# descr = Test discover_directory module

my $test_path = qw| /mnt/ext-xfs-data/models-lmstudio |;

# Test 1: Check if path exists
my $exists    = -d $test_path;
my $reply_str = "Test Results:\n";
$reply_str .= "Path exists: " . ( $exists ? "YES" : "NO" ) . "\n";

if ($exists) {

    # Test 2: Call discover_directory
    @ARG = ( $test_path, 1 );
    my $result = <[models.storage.discover_directory]>->($test_path);

    if ( defined $result ) {
        $reply_str .= "discover_directory returned: " . ref($result) . "\n";
        if ( ref($result) eq 'ARRAY' ) {
            $reply_str .= "Array contains " . scalar(@$result) . " items\n";
            if ( @$result > 0 ) {
                $reply_str .= "First item keys: "
                    . join( ", ", keys %{ $result->[0] } ) . "\n";
            }
        }
    } else {
        $reply_str .= "discover_directory returned undef\n";
    }
} else {
    $reply_str .= "Cannot test - path doesn't exist\n";
}

return { 'mode' => qw| size |, 'data' => $reply_str };

