## [:< ##

# name  = invoke-web.gpu_lease.request
# descr = asynchronously request sole gpu residency for rendering

return TRUE
    if not <[base.cfg_bool]>->( <models.cfg.gpu_lease.enabled> // FALSE );
return TRUE    if ( <invoke-web.gpu_lease.holder> // '' ) eq qw| invoke-web |;
return UNKNOWN if <invoke-web.gpu_lease.unavailable>;
return FALSE   if <invoke-web.gpu_lease.request_inflight>;

my $sent = <[protocol-7.route-send]>->(
    {   'command'   => qw| models.gpu-lease-acquire |,
        'call_args' => { 'args' => qw| invoke-web | },
        'reply'     => {
            'handler' => qw| invoke-web.gpu_lease.handler.acquire_reply |,
            'params'  => {},
        },
    }
);
<invoke-web.gpu_lease.request_inflight> = $sent ? TRUE : FALSE;
if ($sent) {
    <[event.add_timer]>->(
        {   'after'   => 5,
            'handler' => qw| invoke-web.gpu_lease.handler.acquire_timeout |,
            'data'    => { 'stage' => qw| timeout | },
        }
    );
} else {
    <invoke-web.gpu_lease.unavailable> = TRUE;
    <[event.add_timer]>->(
        {   'after'   => 30,
            'handler' => qw| invoke-web.gpu_lease.handler.acquire_timeout |,
            'data'    => { 'stage' => qw| retry | },
        }
    );
}
return $sent ? FALSE : UNKNOWN;

