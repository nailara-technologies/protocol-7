## [:< ##

# name  = nameserv.sync.grants.pulled
# descr = on_done of a grant-change re-pull : drop the zone from the
#         refused list once a pull ran
#
# a failed pull leaves the zone remembered : the next grant change --
# or any later change inside the zone, which mismatches the checksum
# and triggers a full fetch -- tries again.

my $state  = shift // return;
my $result = shift // {};

return if ( $result->{'mode'} // '' ) ne qw| true |;

my $zone = lc( $state->{'target'} // '' );
$zone =~ s{\.+$}{};
return if not length $zone;

delete <nameserv.sync.refused_zones>->{$zone};

return TRUE;

