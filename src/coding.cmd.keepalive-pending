## [:< ##

# name  = coding.cmd.keepalive-pending
# param = <session> <text> | <session> -
# descr = mark what a session waits for [ - : clear ]

my ( $name, $text )
    = ( $call->{'args'} // '' ) =~ m{\A\s*(\S+)\s+(.*?)\s*\z}s;
return {
    'mode' => qw| false |,
    'data' => 'keepalive-pending <session> <text> | -'
    }
    if not length( $text // '' );
$name = <[coding.sessions.resolve]>->($name);    ## an old name ##
my $r = <[coding.sessions.store]>->()->{$name} // return {
    'mode' => qw| false |,
    'data' => "no session '$name' [ coding.sessions ; session-touch first ]"
};
if ( $text eq '-' ) {
    delete $r->{'pending'};
} else {
    $text =~ s{\s+}{ }g;
    $r->{'pending'} = substr $text, 0, 233;
}
<[coding.sessions.store]>->(qw| save |);
return {
    'mode' => qw| true |,
    'data' => $text eq '-' ? "marker cleared : $name" : "marker set : $name"
};

