## [:< ##

# name  = powershell.handler.pointer-stream
# descr = read pointer coordinates from hook stdout, write packed x,y to shm

my $event   = shift;
my $fh      = $event->w->fd;
my $buf_key = 'buf_' . ( fileno($fh) // 'x' );

<powershell.pointer>->{$buf_key} //= '';
my $buf_ref = \$data{'powershell'}{'pointer'}{$buf_key};

my $bytes = <[base.s_read]>->( $fh, $buf_ref, 512 );

if ( not defined $bytes or $bytes < 1 ) {
    $event->w->cancel;
    close $fh;
    if ( defined <powershell.pointer.pid> ) {
        undef <powershell.pointer.pid>;
        delete <powershell.pointer.mount>;
        delete <powershell.pointer.shm>;
        ## restore ondemand timeout that was suspended during stream
        if ( defined <powershell.pointer.saved_timeout> ) {
            <system.ondemand_timeout>
                = delete <powershell.pointer.saved_timeout>;
        }
    }
    <[base.logs]>->( 1, 'pointer-stream : fd closed' );
    return;
}

$$buf_ref =~ s|\r||g;    ## normalize crlf before parsing

<powershell.pointer.coord_count> //= 0;
while ( $$buf_ref =~ s|^(-?\d+) (-?\d+)\n|| ) {
    my ( $x, $y ) = ( $1 + 0, $2 + 0 );
    my $shm_ref = <powershell.pointer.shm>;
    if ( not defined $shm_ref ) {
        <[base.logs]>->(
            1,  'pointer-stream : shm undef at coord %d %d',
            $x, $y
        ) if ++<powershell.pointer.coord_count> % 50 == 1;
        next;
    }
    substr( $$shm_ref, AMOS7::SHM::SHM_HEADER_SIZE(), 8 )
        = pack( 'l<l<', $x, $y );
    <[base.logs]>->( 2, 'pointer-stream : shm %d %d', $x, $y )
        if <powershell.pointer.coord_count>++ % 50 == 0;
}

$$buf_ref =~ s|^[^\n]*\n||g;    ## discard complete non-coord lines

