## [:< ##

# name  = space.route.decode
# descr = parse dot/comma string into hop sequence
# param = { route }

my $params = shift              // {};
my $route  = $params->{'route'} // '';

my @hops;
my $i   = 0;
my $len = length $route;

while ( $i < $len ) {
    my $char = substr( $route, $i, 1 );
    if ( $char eq '.' ) {
        my $distance = 0;
        while ( $i < $len and substr( $route, $i, 1 ) eq '.' ) {
            $distance++;
            $i++;
        }
        push @hops, { 'type' => 'straight', 'distance' => $distance };
    } elsif ( $char eq ',' ) {
        push @hops, { 'type' => 'turn' };
        $i++;
    } elsif ( $char =~ m|[A-Z2-7]| ) {
        my $address = '';
        while ( $i < $len and substr( $route, $i, 1 ) =~ m|[A-Z2-7]| ) {
            $address .= substr( $route, $i, 1 );
            $i++;
        }
        push @hops, { 'type' => 'landmark', 'address' => $address };
    } else {
        $i++;    ## skip unknown characters ##
    }
}

return \@hops;

