## [:< ##

# name  = events.signal.raise
# descr = raise a signal, wake the entries waiting on it
# args   = source zenka, signal name, values [ hash ref ]
# return = array ref of the names of the entries woken
#          [ bucket entries as '<owner>/<id>' ]
#
# the signal source owns matching and waking for both entry kinds. an action
# that dies is logged there and does not stop the others

my ( $source, $name, $values ) = @ARG;
$values //= {};

my $signal = <[events.plugin.registry]>->()->{'source'}{'signal'};
my $woken  = [];
if ( defined $signal and ref $signal->{'wake'} eq qw| CODE | ) {
    $woken = eval { $signal->{'wake'}->( $source, $name, $values ) } // [];
    <[base.logs]>->(
        0,     "<< entries woken by signal '%s' failed : %s >>",
        $name, $EVAL_ERROR =~ s{\s+\z}{}r
    ) if $EVAL_ERROR;
}
<[base.logs]>->(
    1, "signal '%s' from '%s' [ %d woken ]",
    $name, $source, scalar @{$woken}
);

## the notification map [ notify.map ] : one place for every signal ##
if ( defined $code{'events.notify.apply'} ) {
    eval { <[events.notify.apply]>->( $source, $name, $values ) };
    <[base.logs]>->(
        0,     "<< notification for signal '%s' failed : %s >>",
        $name, $EVAL_ERROR =~ s{\s+\z}{}r
    ) if $EVAL_ERROR;
}

<[events.signal.journal_write]>->(
    {   'time'   => time,
        'name'   => $name,
        'source' => $source,
        'values' => $values,
        'woken'  => $woken
    }
);

return $woken;

