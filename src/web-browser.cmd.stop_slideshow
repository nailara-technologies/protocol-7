## [:< ##

# name  = web-browser.cmd.stop_slideshow
# descr = stop the slideshow, force-clear the loaded page
# note  = also force-clears the currently loaded page so its JS/WebGL
#         execution actually terminates, not just future advancement

return { 'mode' => qw| false |, 'data' => 'slideshow is already disabled' }
    if ( <web-browser.slideshow.running> // 0 ) == 0;

<web-browser.slideshow.running> = 0;

## disarm the per-page watchdog ##
<web-browser.timer.capture_page_timeout>->cancel
    if defined <web-browser.timer.capture_page_timeout>
    and <web-browser.timer.capture_page_timeout>->is_active;
delete <web-browser.timer.capture_page_timeout>;

## terminate whatever page is currently loaded ##
<[web-browser.util.force_clear_current_view]>;

return { 'mode' => qw| true |, 'data' => 'stopping slideshow' }

