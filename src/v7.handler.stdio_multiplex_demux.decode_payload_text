# name  = v7.handler.stdio_multiplex_demux.decode_payload_text
# param = $payload_sref  [ scalar ref to raw bytes ]
# descr = decode a scalar-ref payload to utf8 text

my ($payload_sref) = @ARG;

return ''
    if not defined $payload_sref
    or ref $payload_sref ne qw| SCALAR |;

my $bytes = $payload_sref->$*;
return '' if not length $bytes;

my $text = $bytes;
utf8::decode($text);
return $text;

