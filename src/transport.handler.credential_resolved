## [:< ##

# name  = transport.handler.credential_resolved
# descr = reply handler for cred-mesh.resolve route-send issued by
#         transport.handle.* handlers; YAML-loads the SIZE reply, looks up
#         the pending entry, and invokes the stashed build continuation.

my $reply  = shift              // {};
my $params = $reply->{'params'} // {};
my $req_id = $params->{'req_id'};

return if not defined $req_id or not length $req_id;

my $pending = delete <transport.registry>->{'pending_resolve'}{$req_id};
return if not defined $pending or ref $pending ne qw| HASH |;

my $build = $pending->{'build'};

my $mode   = lc( $reply->{'cmd'} // '' );
my $data_r = $reply->{'data'};

my $cred;
if ( $mode eq qw| size | and defined $data_r and length $data_r ) {
    my $resolved = <[format.yaml.load_str]>->($data_r);
    if (    defined $resolved
        and ref $resolved eq qw| HASH |
        and ( $resolved->{'mode'} // '' ) eq qw| true | ) {
        $cred = $resolved;
    }
}

if ( ref $build eq qw| CODE | ) {
    $build->($cred);
} elsif ( ref $pending->{'continue'} eq qw| CODE | ) {
    ## defensive: no build closure, invoke continue with undef ##
    $pending->{'continue'}->(undef);
}

return;

