## [:< ##

# name  = nameserv.sync.peer.handler.timeout
# descr = connect timeout watch for a pending peer connect

my $key = shift->w->data;

my $peers = <nameserv.sync.peers> // return;
my $peer  = $peers->{$key}        // return;

return FALSE
    if $peer->{'state'} ne qw| connecting |;    ## connect already done ##

## the connect did not complete in time : close it, try the next address ##
<[nameserv.sync.peer.next-addr]>->( $key, 'connect timeout' );

return TRUE;

