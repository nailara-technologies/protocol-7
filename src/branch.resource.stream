## [:< ##

# name  = branch.resource.stream
# descr = STRM stream handle convenience wrapper
# param = { node, op, stream_handle }
#
# op = 'attach' | 'get' | 'detach'
# data is a stream handle ref

my $params        = shift             // {};
my $node          = $params->{'node'} // '';
my $op            = $params->{'op'}   // '';
my $stream_handle = $params->{'stream_handle'};

return { 'mode' => 'false', 'data' => 'node id required' }
    unless length $node;
return { 'mode' => 'false', 'data' => 'operation required' }
    unless length $op;

if ( $op eq 'attach' ) {
    return { 'mode' => 'false', 'data' => 'stream_handle required' }
        unless defined $stream_handle;

    return <[branch.resource.attach]>->(
        {   'node' => $node,
            'type' => 'stream',
            'data' => $stream_handle
        }
    );
} elsif ( $op eq 'get' ) {
    my $get_params = {
        'node' => $node,
        'type' => 'stream'
    };
    $get_params->{'id'} = $stream_handle if defined $stream_handle;

    return <[branch.resource.get]>->($get_params);
} elsif ( $op eq 'detach' ) {
    my $detach_params = {
        'node' => $node,
        'type' => 'stream'
    };
    $detach_params->{'id'} = $stream_handle if defined $stream_handle;

    return <[branch.resource.detach]>->($detach_params);
}

return { 'mode' => 'false', 'data' => 'unknown operation' };

