## [:< ##

# name  = user-edit.source.groups_field
# descr = build the read-only group membership row
# param = $record

my ($record) = @ARG;

my $groups = $record->{'fields'}{'group_memberships'} // [];
$groups = [] if ref $groups ne qw| ARRAY |;

return [
    {   qw| name |             => qw| group_memberships |,
        qw| type |             => qw| freeform_line |,
        qw| default |          => join( q{, }, $groups->@* ),
        qw| readonly |         => TRUE,
        qw| separator_before | => TRUE,
    }
];

