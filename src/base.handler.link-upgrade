## [:< ##

# name  = base.handler.link-upgrade
# descr = input handler for link-upgrade negotiation state (state 2)
#         processes encryption and transport-encoding handshake commands
#         negotiates C25519 key exchange, encryption algorithm, link-layer encoding
#
# handles = upgrade-init, key-exchange, capability-set, confirm-upgrade
# installs = link_encryption_key (derived from C25519 DH)
#            link_encoding_mode (utf7, base32, base32-xz - optional)
#            encryption/encoding wrappers if negotiated
#
# optional = state 2 is only entered if client explicitly requests link upgrade
#            normal operation stays in state 1 (unencrypted, no overhead)
#
# returns = 0 (upgrade complete, transition to state 3 encrypted)
#           1 (awaiting more negotiation data)
#           2 (negotiation failed : session disconnected)
#
# binding = an auth-keypair session arrives binding-PENDING : link-complete
#           then REQUIRES <nonce_sid> <client_bind_sig b32>, verified with
#           the client's master key before answering 'link-complete-ok
#           <server_bind_sig b32>' [ data/md/design/AUTH-LINK-BINDING.md ]

my $event   = shift;
my $id      = $event->w->data;
my $session = $data{'session'}{$id};
my $input   = \$session->{'buffer'}->{'input'};

## auth-keypair binding [ data/md/design/AUTH-LINK-BINDING.md ] : on a     ##
## binding-PENDING session every failure disconnects [ never a fallback to ##
## state 1 ] and drops the single-use server nonce with the rest of the    ##
## binding material                                                        ##
my $pending = ( $session->{'link_binding'} // '' ) eq qw| pending |;

my $drop_binding = sub {
    map { delete $session->{'auth'}{$ARG} }
        qw| server_nonce server_pub server_key_name client_pub |
        if ref $session->{'auth'} eq qw| HASH |;
    delete $session->{'link_client_eph'};
    return;
};
my $refuse = sub {
    my ( $format, @args ) = @ARG;
    <[base.logs]>->( 0, "[%d] link-upgrade : $format", $id, @args );
    $drop_binding->();
    return 2;    ## <-- disconnecting ##
};

## strict base32 [ encode_b32r alphabet ] decode of a fixed-length field ##
my $decode_b32 = sub {
    my ( $b32, $want_len ) = @ARG;
    return undef if not defined $b32 or $b32 !~ m{\A[A-Z2-7]+\z};
    my $bin = eval { Crypt::Misc::decode_b32r($b32) };
    return undef if not defined $bin or length($bin) != $want_len;
    return $bin;
};

## Check for negotiation timeout
if ( defined $session->{'link_upgrade_timeout'}
    and time() > $session->{'link_upgrade_timeout'} ) {
    return $refuse->('negotiation timeout');
}

## Parse link-upgrade negotiation protocol  Note: "link-upgrade" command was
## already processed by cube.cmd.link-upgrade and ephemeral pubkey was sent by
## protocol.protocol-7.link-upgrade.init Now we expect: link-pub-key,
## link-confirm-encoding, link-complete

## Process client's public key response
if ( $$input =~ s|^link-pub-key\s+(\S+)\n|| ) {
    my $client_pubkey_b32 = $1;
    <[base.logs]>->(
        2,   '[%d] received client pubkey (b32): %s...',
        $id, substr( $client_pubkey_b32, 0, 20 )
    );

    return $refuse->('client public key sent twice')
        if $pending and defined $session->{'link_client_eph'};

    ## Decode client's public key from BASE32 [ a curve25519 key : 32 bytes ;
    ## the strict alphabet check only binds pending sessions ]
    my $client_pubkey
        = $pending
        ? $decode_b32->( $client_pubkey_b32, 32 )
        : eval { Crypt::Misc::decode_b32r($client_pubkey_b32) };
    undef $client_pubkey
        if defined $client_pubkey and length($client_pubkey) != 32;

    if ( not defined $client_pubkey ) {
        return $refuse->('invalid client public key [ not 32 bytes b32 ]');
    }
    <[base.logs]>->(
        2,   '[%d] decoded client pubkey (%d bytes)',
        $id, length($client_pubkey)
    );

    ## Perform Diffie-Hellman with client pubkey  Get ephemeral keypair from
    ## session storage
    my $ephemeral_keypair = $session->{'link_ephemeral_keypair'};

    if ( not defined $ephemeral_keypair ) {
        return $refuse->('ephemeral keypair lost');
    }

    ## Compute shared secret: DH(our_private, client_public)  Use
    ## Crypt::Curve25519 for proper Diffie-Hellman (not Ed25519 signatures)
    use Crypt::Curve25519;
    my $shared_secret
        = Crypt::Curve25519::curve25519_shared_secret(
        $ephemeral_keypair->{'secret'},
        $client_pubkey );

    if ( not defined $shared_secret or not length $shared_secret ) {
        return $refuse->('DH computation failed');
    }

    ## Store shared secret for encryption key derivation
    $session->{'link_dh_shared_secret'} = $shared_secret;

    ## the client eph key is part of the bind transcript ##
    $session->{'link_client_eph'} = $client_pubkey;

    ## Send our public key back (in response to client's key)
    $session->{'buffer'}->{'output'}
        .= sprintf("SIZE 0\n");    ## Indicate ready for encoding negotiation

    <[base.logs]>->( 2, '[%d] DH completed, shared secret established', $id );

    return 1;                      ## Awaiting more negotiation

} elsif ( $$input =~ s|^link-confirm-encoding\s+(\S+)\n|| ) {
    my $client_encoding = $1;

    ## Validate encoding mode
    my $valid_encodings = $session->{'link_capabilities'}->{'encoding'} // [];
    my $encoding_ok     = 0;

    foreach my $valid (@$valid_encodings) {
        if ( $valid =~ m|^\Q$client_encoding\E$| ) {
            $encoding_ok = 1;
            last;
        }
    }

    if ( not $encoding_ok and $client_encoding !~ m|^none$| ) {
        return $refuse->(
            'client requested unsupported encoding: %s',
            $client_encoding
        );
    }

    ## Store negotiated encoding mode
    $session->{'link_encoding_mode'} = $client_encoding
        unless $client_encoding =~ m|^none$|;

    ## the exact string [ 'none' too ] is part of the bind transcript ##
    $session->{'link_confirmed_encoding'} = $client_encoding;

    <[base.logs]>->(
        2,   '[%d] encoding mode negotiated: %s',
        $id, $client_encoding
    );

    ## Send confirmation that encoding was negotiated
    $session->{'buffer'}->{'output'} .= "encoding-confirmed\n";

    return 1;    ## Awaiting completion confirmation

} elsif ( $$input =~ s|^link-complete(?:[ \t]+(\S+))?(?:[ \t]+(\S+))?\n|| ) {
    ## Handshake complete, transition to encrypted state (state 3)
    my ( $client_nonce_sid, $client_bind_sig_b32 )
        = ( ${^CAPTURE}[0], ${^CAPTURE}[1] );

    return $refuse->('nonce session id not numerical')
        if defined $client_nonce_sid
        and $client_nonce_sid !~ m|\A[0-9]{1,10}\z|;

    my $server_bind_sig_b32;

    if ($pending) {

        ## nonce sid REQUIRED, 1 .. 2**32-1 ##
        return $refuse->('nonce session id missing \\ out of range')
            if not defined $client_nonce_sid
            or $client_nonce_sid < 1
            or $client_nonce_sid > 4294967295;

        my $client_bind_sig = $decode_b32->( $client_bind_sig_b32, 64 );
        return $refuse->('client_bind_sig missing \\ not valid')
            if not defined $client_bind_sig;

        my $auth       = $session->{'auth'} // {};
        my %transcript = (
            qw| server_nonce | => $auth->{'server_nonce'},
            qw| server_pub |   => $auth->{'server_pub'},
            qw| server_eph |   => $session->{'link_ephemeral_pubkey'},
            qw| client_eph |   => $session->{'link_client_eph'},
            qw| nonce_sid |    => $client_nonce_sid,
            qw| encoding |     => $session->{'link_confirmed_encoding'},
            qw| username |     => $session->{'user'},
        );

        my $client_message
            = <[auth.binding.message]>->( qw| client |, \%transcript );
        my $client_pub = $auth->{'client_pub'};

        return $refuse->('bind transcript incomplete')
            if not defined $client_message
            or not defined $client_pub
            or length($client_pub) != 32;

        ## verify the client identity BEFORE answering ##
        my $client_sig_ok = eval {
            Crypt::Ed25519::verify( $client_message, $client_pub,
                $client_bind_sig );
        };
        return $refuse->(
            'client_bind_sig NOT valid for \'%s\'',
            $session->{'user'}
        ) if not $client_sig_ok;

        ## sign with exactly the key announced at select time ##
        my $s_name = $auth->{'server_key_name'} // '';
        my $s_key  = $keys{'C25519'}{$s_name};
        return $refuse->( 'announced server key \'%s\' not loaded', $s_name )
            if not length $s_name
            or ref $s_key ne qw| HASH |
            or not defined $s_key->{'public'}
            or not defined $s_key->{'private'}
            or $s_key->{'public'} ne $auth->{'server_pub'};

        my $server_message
            = <[auth.binding.message]>->( qw| server |, \%transcript );
        my $server_bind_sig = eval {
            Crypt::Ed25519::sign( $server_message, $s_key->{'public'},
                $s_key->{'private'} );
        };
        return $refuse->('cannot sign server_bind_sig')
            if not defined $server_message
            or not defined $server_bind_sig
            or length($server_bind_sig) != 64;

        $server_bind_sig_b32 = Crypt::Misc::encode_b32r($server_bind_sig);

        ## the server nonce is single-use ##
        $drop_binding->();

    } elsif ( defined $client_bind_sig_b32 ) {
        <[base.logs]>->(
            1, '[%d] link-complete : bind sig ignored [ no pending binding ]',
            $id
        );
    }

    <[base.logs]>->(
        2, '[%d] link-upgrade negotiation complete, transitioning to state 3',
        $id
    );

    ## client-selected nonce session id [ must match on both ends for the KDF
    ## + nonce construction or decryption fails on every frame ]
    if ( defined $client_nonce_sid and length $client_nonce_sid ) {
        $session->{'link_nonce_session_id'} = 0 + $client_nonce_sid;
        <[base.logs]>->(
            2,   '[%d] client nonce session id received: %d',
            $id, $session->{'link_nonce_session_id'}
        );
    }

    ## Send completion confirmation to client [ still plaintext ! ]
    $session->{'buffer'}->{'output'}
        .= defined $server_bind_sig_b32
        ? "link-complete-ok $server_bind_sig_b32\n"
        : "link-complete-ok\n";

    ## flush pending plaintext reply BEFORE the output path switches to
    ## encrypted framing [ client reads this line unencrypted ]
    <[base.handler.write]>->($id);

    ## Trigger state transition from state 2 to state 3
    if ( not <[base.session.init_state]>->( $id, 3 ) ) {
        return $refuse->('failed to initialize encryption state (state 3)');
    }

    ## binding complete : only now authenticated + registered ##
    if ($pending) {
        $session->{'link_binding'} = qw| done |;
        return $refuse->('cannot register bound session')
            if not <[base.session.register_authenticated]>->(
            $id, $session->{'user'}
            );
        <[base.logs]>->(
            1,   '[%d] link binding verified for \'%s\'',
            $id, $session->{'user'}
        );
    }

    return 0;    ## Complete, state transition done

} elsif ($pending) {
    ## binding pending : nothing but the negotiation lines ##
    return 1 if index( $$input, "\n" ) == -1;    ## incomplete line ##

    return $refuse->('unexpected line on binding-pending session');

} else {
    ## Unknown command in link-upgrade state
    my $buffer_sample = substr( $$input, 0, 100 );
    $buffer_sample =~ s|\n|\\n|g;
    <[base.logs]>->(
        1,
        '[%d] unknown link-upgrade command (buffer: "%s"), awaiting protocol',
        $id,
        $buffer_sample
    );
    return 1;    ## Keep waiting
}

1;

