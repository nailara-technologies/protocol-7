# name  = plugin.storage.visual.extract-floats
# descr = Extract float values from P7REFs for visual positioning

my ($args) = @ARG;

my $p7ref = $args->{p7ref}
    or return { 'mode' => 'false', 'data' => 'p7ref required' };
my $layers = $args->{layers} // ['intrinsic'];    # Array of layer names

my $registry = <storage.mapping.visual>;
my $result   = {};

# Resolve P7REF to get metadata
my $resolved = <[plugin.storage.p7ref.resolve]>->( { 'p7ref' => $p7ref } );
return $resolved if $resolved->{'mode'} eq 'false';

my $data = $resolved->{'data'};

for my $layer (@$layers) {
    given ($layer) {
        when ('intrinsic') {
            $result = {
                %$result,
                %{  <[plugin.storage.util.visual.extract_intrinsic]>->($data)
                }
            };
        }
        when ('temporal') {
            $result = {
                %$result,
                %{  <[plugin.storage.util.visual.extract_temporal]>->($data)
                }
            };
        }
        when ('network') {
            $result = {
                %$result,
                %{  <[plugin.storage.util.visual.extract_network]>->($data)
                }
            };
        }
        when ('L13') {
            $result = {
                %$result,
                %{ <[plugin.storage.util.visual.extract_L13]>->($data) }
            };
        }
    }
}

$registry->{'stats'}{'refs_processed'}++;

return {
    'mode' => 'true',
    'data' => $result,
};

