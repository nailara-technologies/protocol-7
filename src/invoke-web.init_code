## [:< ##

# name  = invoke-web.init_code
# descr = invoke-web zenka initialization

## load required modules [ one at a time per base.perlmod.autoload ]
map { <[base.perlmod.autoload]>->($ARG) } qw| IPC::Open3 Symbol Fcntl |;

## initialize state
<invoke-web.status> = 'idle';
<invoke-web.pid>    = undef;
<invoke-web.url> = <external.models.invokeai.url> // 'http://127.0.0.1:9090';
<invoke-web.binary> = '/home/taeki/miniconda3/envs/invokeai/bin/invokeai-web';
<invoke-web.root>   = '/home/taeki/.invokeai';
<invoke-web.output> = '';
<invoke-web.ready_logged> = FALSE;
<invoke-web.crash_logged> = FALSE;

## check for orphan invoke.ai process from previous run
my $saved_ref = <[file.zenka_dir.load]>->('state/invokeai.pid');
if ( defined $saved_ref ) {
    my ( $saved_pid, $saved_bin ) = split m|\n|, $saved_ref->$*;
    $saved_pid //= '';
    $saved_bin //= '';
    if ( $saved_pid =~ m|^\d+$| and kill( 0, $saved_pid ) ) {
        ## verify process name matches before adopting
        my $proc_cmd = '';
        if ( open my $cfh, '<', "/proc/$saved_pid/cmdline" ) {
            local $/;
            $proc_cmd = <$cfh>;
            close $cfh;
        }
        if ( $proc_cmd =~ m|invokeai-web| ) {
            ## adopt orphan process
            <invoke-web.pid>        = $saved_pid;
            <invoke-web.status>     = 'running';
            <invoke-web.start_time> = <[base.time]>->(3);
            <[base.zenki.report_child_pid]>->($saved_pid);
            <[base.logs]>->(
                1, 'adopted orphan invoke.ai process [pid:%d]', $saved_pid
            );
        } else {
            ## stale pid file : process is not invokeai-web
            <[file.zenka_dir.unlink_file]>->( 'state/invokeai.pid', TRUE );
            <[base.logs]>->(
                2, 'removed stale pid file [pid:%s]', $saved_pid
            );
        }
    } else {
        ## pid not running : remove stale file
        <[file.zenka_dir.unlink_file]>->( 'state/invokeai.pid', TRUE );
    }
}

## schedule periodic health check timer [ every 30 seconds ]
<[event.add_timer]>->(
    {   'after'    => 30,
        'interval' => 30,
        'repeat'   => TRUE,
        'handler'  => 'invoke-web.handler.check_health',
    }
);

<[base.logs]>->( 1, 'invoke-web zenka initialized' );

0;

