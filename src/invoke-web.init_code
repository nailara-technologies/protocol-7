## [:< ##

# name  = invoke-web.init_code
# descr = invoke-web zenka initialization

## load required modules [ one at a time per base.perlmod.autoload ]
map { <[base.perlmod.autoload]>->($ARG) }
    qw| IPC::Open3 Symbol Fcntl DBI LWP::UserAgent JSON::PP |;

my $reinit = shift // TRUE;    ## provided by 'base.init_modules' ##

## zenka output directory owned by the run user [ zenka.v7 sets            ##
## system.zenka-user.current ; recursive : fixes content created while the ##
## zenka still ran as the protocol-7 user ]                                ##
<[base.path-set-up.check-zenka-paths]>->( TRUE, 0750, FALSE, 0, '', TRUE );

## initialize state [ a reinit keeps track of a running process ]
<invoke-web.status>       //= 'idle';
<invoke-web.pid>          //= undef;
<invoke-web.output_tail>  //= [];       ## last lines [ invoke-web.log ] ##
<invoke-web.carry>        //= {};       ## incomplete line per stream ##
<invoke-web.ready_logged> //= FALSE;
delete <invoke-web.output>;    ## replaced by the bounded output tail ##

## models a render failed on [ invoke-web.missing.save ] : kept across ##
## restarts until the failed item is re-queued                         ##
if ( not defined <invoke-web.missing_at_render> ) {
    my $saved = <[file.zenka_dir.load]>->('state/missing-at-render');
    <invoke-web.missing_at_render> = (
        defined $saved
        ? eval { JSON::PP::decode_json( $saved->$* ) }
        : undef
    ) // {};
}

## invoke.ai output lines : first match wins, unmatched lines log at 3 ##
<invoke-web.output_tail_max> = 200;
<invoke-web.output_patterns> = [
    {   'kind'  => 'ready',
        'level' => 1,
        'match' =>
            qr{uvicorn running on|invoke running on|application startup complete}i
    },
    {   'kind'  => 'oom',
        'level' => 0,
        'match' => qr{out of memory|OutOfMemoryError|cannot allocate memory}i
    },
    ## order matters [ first match wins ] : the render error also reads ##
    ## 'model .. not found' -- it must be tested before the startup one ##
    {   'kind'  => 'model_render',    ## a render needs a missing model ##
        'level' => 1,
        ## the ERROR line only : the traceback's python source line reads ##
        ## "Files for model '{model_config.name}' .." and must not match  ##
        'match' =>
            qr{Error while invoking session \S+, .*Files for model '[^'{}]+' not found at }
    },
    ## startup : one line per missing file ##
    {   'kind'  => 'model',
        'level' => 2,
        'match' => qr{Missing model file:}
    },
    {   'kind'  => 'traceback',    ## detail : keeps the real error ##
        'level' => 2,
        'match' =>
            qr{::ERROR --> Traceback|^Traceback \(most recent call last\)}
    },
    {   'kind'  => 'error',
        'level' => 0,
        'match' =>
            qr{::ERROR\b|^Traceback \(most recent call last\)|\bError:\s}
    },
    {   'kind'  => 'progress',
        'level' => 3,
        'match' => qr{\d+%\|.*\|\s*\d+/\d+\s*\[}
    },
    {   'kind'  => 'item',
        'level' => 1,
        'match' =>
            qr{executing queue item|queue item \d+ (?:started|completed|failed)}i
    },
    {   'kind'  => 'item_done',    ## same session id as 'Executing ..' ##
        'level' => 2,
        'match' => qr{::INFO --> Graph stats: \S+}
    },
    ## graph stats row : node calls secs vram ##
    {   'kind'  => 'render_node',
        'level' => 3,
        'match' => qr{^\s*\w+\s+\d+\s+[\d.]+s\s+[\d.]+G\s*$}
    },
    {   'kind'  => 'render_stat',    ## graph stats table, summarized ##
        'level' => 3,
        'match' =>
            qr{^(?:TOTAL GRAPH EXECUTION TIME|RAM used by InvokeAI process|VRAM in use|\s*Cache high water mark):}
    },
    {   'kind'  => 'warning',
        'level' => 2,
        'match' => qr{::WARNING\b}
    },
    {   'kind'  => 'info',
        'level' => 2,
        'match' => qr{::INFO\b}
    },
];
<invoke-web.crash_logged> //= FALSE;
## the port invoke.ai reported [ parse_output_line ] wins over the config ##
<invoke-web.url> = <invoke-web.url_detected>
    // <external.models.invokeai.url> // 'http://127.0.0.1:9090';

## invoke.ai is installed below the home of the zenka's run user [ zenka.v7 ##
## ]                                                                        ##
my $run_user = <invoke-web.run_user> // <system.admin-user> // '';
my $run_home = length $run_user ? ( getpwnam $run_user )[7] : undef;
<invoke-web.binary> = <external.models.invokeai.binary> // (
    defined $run_home
    ? "$run_home/miniconda3/envs/invokeai/bin/invokeai-web"
    : undef
);
<invoke-web.root> = <external.models.invokeai.root>
    // ( defined $run_home ? "$run_home/.invokeai" : undef );

## binary check while still root [ init_code runs before the privilege drop ##
## ; the home directory may be 700 ]. unprivileged reinit : only a definite ##
## ENOENT changes the stored result                                         ##
if ( not defined <invoke-web.binary> ) {
    <invoke-web.binary_ok> = FALSE;
} elsif ( -x <invoke-web.binary> ) {
    <invoke-web.binary_ok> = TRUE;
} elsif ( not $reinit or $!{'ENOENT'} ) {
    <invoke-web.binary_ok> = FALSE;
    <[base.logs]>->(
        0,                   'invoke.ai binary not usable [ %s : %s ]',
        <invoke-web.binary>, "$OS_ERROR"
    );
}

## check for orphan invoke.ai process from previous run
my $saved_ref = <[file.zenka_dir.load]>->('state/invokeai.pid');
if ( defined $saved_ref ) {
    my ( $saved_pid, $saved_bin ) = split m|\n|, $saved_ref->$*;
    $saved_pid //= '';
    $saved_bin //= '';
    ## own process [ reinit ] ##
    if ( ( <invoke-web.pid> // -1 ) != $saved_pid
        and <[invoke-web.is_alive]>->($saved_pid) ) {
        ## verify process name matches before adopting
        my $proc_cmd = '';
        if ( open my $cfh, '<', "/proc/$saved_pid/cmdline" ) {
            local $/;
            $proc_cmd = <$cfh>;
            close $cfh;
        }
        if ( $proc_cmd =~ m|invokeai-web| ) {
            ## adopt orphan process
            <invoke-web.pid>    = $saved_pid;
            <invoke-web.status> = 'running';
            <[base.zenki.pause_ondemand_timeout]>;    ## see cmd.start ##
            <invoke-web.start_time> = <[base.time]>->(3);
            <[base.zenki.report_child_pid]>->($saved_pid);
            <[base.logs]>->(
                1, 'adopted orphan invoke.ai process [pid:%d]', $saved_pid
            );
        } else {
            ## stale pid file : process is not invokeai-web
            <[file.zenka_dir.unlink_file]>->( 'state/invokeai.pid', TRUE );
            <[base.logs]>->(
                2, 'removed stale pid file [pid:%s]', $saved_pid
            );
        }
    } else {
        ## pid not running : remove stale file
        <[file.zenka_dir.unlink_file]>->( 'state/invokeai.pid', TRUE );
    }
}

## start memory guard [ coding zenka pattern ] : dependency objects for   ##
## free RAM \ VRAM, gated with the cross-loaded coding callbacks. a start ##
## while memory is short waits [ invoke-web.handler.start_guard ] instead ##
## of spawning into an exhausted machine                                  ##
<[dependency.setup]>->(
    'memory_system',
    { 'callback' => $code{'coding.callback.object_memory_system'} }
);
<[dependency.setup]>->(
    'memory_gpu', { 'callback' => $code{'coding.callback.object_memory_gpu'} }
);

if ( not defined <invoke-web.dep.memory_system> ) {
    <invoke-web.dep.memory_system> = <[dependency.add_object]>->(
        {   'type'        => 'memory_system',
            'min_free_mb' => <invoke-web.start.min_free_ram_mb> // 8192,
            'description' => 'System RAM available for invoke.ai start'
        }
    );
    <invoke-web.dep.memory_gpu> = <[dependency.add_object]>->(
        {   'type'        => 'memory_gpu',
            'min_free_mb' => <invoke-web.start.min_free_vram_mb> // 4096,
            'description' => 'GPU VRAM available for invoke.ai start'
        }
    );

    ## self-chains so dependency.ok actually calls the callbacks ##
    <[dependency.add]>->(
        <invoke-web.dep.memory_system>,
        <invoke-web.dep.memory_system>
    );
    <[dependency.add]>->(
        <invoke-web.dep.memory_gpu>, <invoke-web.dep.memory_gpu>
    );
}

## refresh thresholds from config on every init [ reload config ] ##
my $ram_dep_id = <invoke-web.dep.memory_system>;
my $gpu_dep_id = <invoke-web.dep.memory_gpu>;
<dependency.object>->{$ram_dep_id}->{'min_free_mb'}
    = <invoke-web.start.min_free_ram_mb> // 8192;
<dependency.object>->{$gpu_dep_id}->{'min_free_mb'}
    = <invoke-web.start.min_free_vram_mb> // 4096;

## schedule periodic health check timer [ every 30 seconds ]
<[event.add_timer]>->(
    {   'after'    => 30,
        'interval' => 30,
        'repeat'   => TRUE,
        'handler'  => 'invoke-web.handler.check_health',
    }
);

<[base.logs]>->( 1, 'invoke-web zenka initialized' );

0;

