## [:< ##

# name  = invoke.cmd.health
# descr = quick invoke.ai HTTP health check

my $url  = <invoke.url> // 'http://127.0.0.1:9090';
my $ua   = LWP::UserAgent->new( timeout => 3 );
my $resp = $ua->get("$url/api/v1/app/version");

if ( $resp->is_success ) {
    my $ver_data = eval { JSON::decode_json( $resp->decoded_content ) };
    my $ver      = $ver_data->{'version'} // 'unknown';
    return {
        mode => qw| false |,
        data => sprintf( 'healthy: v%s', $ver )
    };
} else {
    return {
        mode => qw| false |,
        data => sprintf( 'unreachable: %s', $resp->status_line )
    };
}

