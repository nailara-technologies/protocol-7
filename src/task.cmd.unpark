## [:< ##

# name  = task.cmd.unpark
# param = <task_id>
# descr = unpark a task : its events entry is removed

my ($task_id) = ( $call->{'args'} // '' ) =~ m{\A\s*(\S+)};
$task_id = uc( substr( $task_id // '', 0, 7 ) );
return { 'mode' => 'false', 'data' => 'task id required' }
    unless length $task_id;
return <[park.stop]>->(
    {   'store'    => qw| task.park.store |,
        'task_id'  => $task_id,
        'reply_id' => $call->{'reply_id'}
    }
);

