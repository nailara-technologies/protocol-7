## [:< ##

# name  = keys.console.list
# param = [:nosums:|:sigs:]
# descr = list C25519 key names \ files for current user
# note  = Protocol-7 keys list | grep ' : .*:' | sed 's|.* : ||' # | grep -v :

my $param = shift;

## policy: normal-use console commands must not leak raw subroutine warn() ##
## calls to the user — collect anything unrecognized ourselves below and   ##
## report it as one specific, actionable note instead                      ##
<crypt.C25519.get_keyname.quiet> = TRUE;

( my $display_sigs, my $display_checksums ) = ( FALSE, TRUE );

if ( defined $param ) {
    $display_sigs      = TRUE  if $param eq qw| :sigs: |;
    $display_checksums = FALSE if $param eq qw| :nosums: |;
}

my %C            = %AMOS7::C;
my $key_vars_ref = <[crypt.C25519.key_vars]>;
my $name_regex   = qr|[0-9a-zA-Z\._\-]+|;
my $key_dir      = $key_vars_ref->{'key_dir'};
my $key_usr      = $key_vars_ref->{'usr_name'};

my $keys_re        = <keys.regex>;
my $key_re_public  = $keys_re->{'key_file'}->{'public'};
my $key_re_private = $keys_re->{'key_file'}->{'private'};
my $key_re_sig     = $keys_re->{'key_sig'}->{'signature'};

## root-held keys [ host-root delegation ] are listed as their own group  ##
## below, never mixed into the user key files whichever way keyfiles goes ##
my $root_key_dir = <[crypt.C25519.root_key_dir]> // '';

## warns when absent ##
my @k_files = grep {s|^.+/||}
    grep { not length $root_key_dir or index( $ARG, "$root_key_dir/" ) != 0 }
    <[base.reverse-sort]>->(<[keys.get_keyfiles]>)
    or return;

##  Load host pins [ servers/ ] + owner pins [ owners/ ]  ##
my $remote_keys_ref = <[keys.list_remote_keys]>;
my %owner_pins;
{
    my $owner_dir = <[keys.remote_keys_dir]>->( qw| owners |, FALSE );
    if ( defined $owner_dir and opendir( my $dh, $owner_dir ) ) {
        foreach my $entry ( readdir $dh ) {
            next if $entry !~ m|\A(.+)\.public\z|;
            my $owner = $1;
            my $path  = catfile( $owner_dir, $entry );
            next if -l $path           or not -f $path;
            open( my $fh, '<', $path ) or next;
            my $line = readline($fh) // '';
            close($fh);
            $line =~ s{\s+\z}{};
            $owner_pins{$owner} = $line if $line =~ m|\A[A-Z2-7]{77}\z|;
        }
        closedir $dh;
    }
}

my %key_chksums;
if ($display_checksums) {    ## calculating key checksums ##
    my $calculating_message = 'calculating C25519 key checksums ..,';
    <[base.log]>->( 1, $calculating_message );
    if ( not <system.zenka.verbosity.console> ) {
        $OUTPUT_AUTOFLUSH = TRUE;
        if ( <system.ansi_color> or <system.force_colors> ) {
            printf "\n: %s%s\r", $C{0}, $calculating_message;
        } else {
            printf "\n: %s\r", $calculating_message;  ## todo : detect pipe ##
        }
    }

    %key_chksums = ( <[keys.checksum_href]>->%* ); ##  uses cache look-ups  ##

    foreach my $name ( <[base.sort]>->( \%key_chksums ) ) {
        <[base.logs]>->( 0, "failed to acquire checksum for key '%s'", $name )
            if not defined $key_chksums{$name};
    }

}

my %key_signed_by;
foreach my $file (    ## collect signatures ##
    grep {m{$key_re_sig}}
    grep {s|^$key_dir/||} <[file.all_files]>->($key_dir)->@*
) {
    next if $file !~ $key_re_sig;    ## init capture ##

    $key_signed_by{ ${^CAPTURE}[0] } //= [];    ## key name ##
    ## root key name ##
    push $key_signed_by{ ${^CAPTURE}[0] }->@*, ${^CAPTURE}[1];
}

my @display_kfiles;
foreach my $file (@k_files) {
    push @display_kfiles, $file;
    if ( $file =~ m|([^/]+):seed-phrase$| ) { ## : todo :  add single keys  ##
        push @display_kfiles,
            sprintf( qw| :.virtual.::%s |, $LAST_PAREN_MATCH );
    }
}

## build one specific, user-facing note for whatever get_keyname can't      ##
## classify — instead of the raw per-file 'does not match any defined type' ##
## warn this command now suppresses. unrecognized files are kept out of the ##
## named-group listing below entirely; the note is the only place they're   ##
## mentioned, so they don't also show up under a confusing blank '' group   ##
## heading                                                                  ##
my %key_files;
my @unreadable_note;
foreach my $file (@display_kfiles) {
    my $name = <[crypt.C25519.get_keyname]>->($file);
    if ( not defined $name ) {
        push @unreadable_note, $file;
        next;
    }
    $key_files{$name} //= [];
    push $key_files{$name}->@*, $file;
}

## root-held group : readable only when running as root, a non-root process ##
## can see that the directory exists and nothing more [ 0700 ]              ##
my %root_key_files;
my $root_note;
if ( length $root_key_dir and -d $root_key_dir ) {
    if ( $EFFECTIVE_USER_ID != 0 ) {
        $root_note = sprintf 'root-held : not readable as %s', $key_usr;
    } elsif ( opendir( my $root_dir_fh, $root_key_dir ) ) {
        foreach my $file ( <[base.sort]>->( [ readdir($root_dir_fh) ] ) ) {
            next if not -f catfile( $root_key_dir, $file );
            my $name = <[crypt.C25519.get_keyname]>->($file);
            next if not defined $name;
            $root_key_files{$name} //= [];
            push $root_key_files{$name}->@*, $file;
        }
        closedir($root_dir_fh);
    } else {
        $root_note = sprintf 'root-held : not readable [ %s ]',
            <[base.str.os_err]>;
    }
}

delete <crypt.C25519.get_keyname.quiet>;

my @unreadable_note_lines;
foreach my $file (@unreadable_note) {
    ( my $stripped = $file ) =~ s{\.(?:secret|private|public)$}{};
    if ( $stripped ne $file
        and lc($stripped) =~ m|^<crypt.C25519.regex.key_name>$| ) {
        push @unreadable_note_lines,
            sprintf( "%-40s uppercase characters not allowed in key names",
            $file );
    } else {
        push @unreadable_note_lines,
            sprintf( "%-40s does not match <name>.private/.secret/.public",
            $file );
    }
}

my $names_len = 2 + max( map {length} keys %key_files, keys %root_key_files );
$names_len
    = max( $names_len, map { length( $_ // '' ) } values %key_chksums );

## root-held \ host pin \ owner headers : "'<name>' [ root-held ]" \ ##
## "'<name>' [<key id label>]"                                       ##
$names_len = max(
    $names_len,
    (   map { length sprintf( "'%s' [ root-held ]", $ARG ) }
            keys %root_key_files
    ),
    map {
        length sprintf( "'%s' [%s]",
            $ARG, $remote_keys_ref->{$ARG}->{'label'} // '' )
    } keys %{$remote_keys_ref},
    keys %owner_pins
);

<[base.logs]>->( "listing key files ['%s']", $key_dir );

my $linefeed
    = ( $display_checksums and not <system.zenka.verbosity.console> )
    ? ''
    : "\n";

my $key_list_string = join '', $linefeed,
    sprintf( "%40s\r :: %skeys for user %s :.\n",
    '', $display_sigs ? '[signed] ' : '', $key_usr );

my $displayed_files_count = 0;
foreach my $name ( <[base.sort]>->( \%key_files ) ) {

    next if $display_sigs and not exists $key_signed_by{$name};
    $displayed_files_count++;

    $key_list_string .= sprintf " : %*s .\n", $names_len, '';

    $key_list_string .= sprintf " : %*s .\n", $names_len,
        sprintf qw| '%s' |, $name;

    if ($display_sigs) {    ##  display signature [root] key names per key  ##

        foreach my $signature_key ( $key_signed_by{$name}->@* ) {
            if ( <[crypt.C25519.signature_exists]>->( $name, $signature_key )
                < 3 ) {
                $signature_key .= '  [incomplete]'; ##  some files missing  ##
            }
            $key_list_string .= sprintf " : %*s : %s\n", $names_len,
                '', $signature_key;
        }
        next;    ##  skip key filename listing  ##
    }

    my $shown_chksum = FALSE;    ##  otherwise listing key files  ##
    foreach my $file ( $key_files{$name}->@* ) {

        my $chksum_line
            = ( not $display_checksums or $shown_chksum )
            ? ( $file =~ $key_re_public and exists $key_signed_by{$name} )
                ? ': signed :'
                : ''
            : $key_chksums{$name} // '';

        $key_list_string .= sprintf " : %*s : %s\n", $names_len,
            $chksum_line, $file;

        $shown_chksum++ if length $chksum_line;
    }

}

##  Display root-held keys, a group of their own  ##
if ( not $display_sigs and ( keys %root_key_files or defined $root_note ) ) {
    foreach my $name ( <[base.sort]>->( \%root_key_files ) ) {
        $displayed_files_count++;

        $key_list_string .= sprintf " : %*s .\n", $names_len, '';
        $key_list_string .= sprintf " : %*s .\n", $names_len,
            sprintf( "'%s' [ root-held ]", $name );

        foreach my $file ( $root_key_files{$name}->@* ) {
            $key_list_string .= sprintf " : %*s : %s\n", $names_len, '',
                $file;
        }
    }

    if ( defined $root_note ) {
        $displayed_files_count++;
        $key_list_string .= sprintf " : %*s .\n", $names_len, '';
        $key_list_string .= sprintf " : %*s .\n", $names_len,
            sprintf( '[ %s ]', $root_note );
    }
}

##  Display host pins [ servers/ ] ##
if ( keys %{$remote_keys_ref} and not $display_sigs ) {

    foreach
        my $display_name ( <[base.sort]>->( [ keys %{$remote_keys_ref} ] ) ) {
        my $remote_info = $remote_keys_ref->{$display_name};

        $displayed_files_count++;

        $key_list_string .= sprintf " : %*s .\n", $names_len, '';

        ## the key id label [ a recognition aid, not a checksum ] goes next ##
        ## to the name, the checksum column names the type                  ##
        $key_list_string .= sprintf " : %*s .\n", $names_len,
            sprintf( "'%s' [%s]", $display_name, $remote_info->{'label'} );

        my $key_filename = $remote_info->{'file_path'};
        $key_filename =~ s|^.*/||;    ## extract just the filename ##

        $key_list_string
            .= sprintf " : %*s : %s%s\n", $names_len,
            qw| host-root |, $key_filename,
            defined $remote_info->{'name'}
            ? "  [ $remote_info->{'name'} ]"
            : '';
    }
}

##  Display owner pins [ owners/ ] ##
if ( %owner_pins and not $display_sigs ) {
    foreach my $owner ( sort keys %owner_pins ) {
        $displayed_files_count++;
        $key_list_string .= sprintf " : %*s .\n", $names_len, '';
        $key_list_string .= sprintf " : %*s .\n", $names_len,
            sprintf( "'%s' [%s]",
            $owner, substr( $owner_pins{$owner}, 0, 7 ) );
        $key_list_string .= sprintf " : %*s : %s\n", $names_len, qw| owner |,
            "$owner.public";
    }
}

if ( not $displayed_files_count ) {
    $key_list_string .= sprintf " : %*s\n", $names_len, '';
    $key_list_string .= sprintf " : %*s\n", $names_len,
        '[ no matching files ]';
} else {
    $key_list_string .= sprintf " : %*s .\n", $names_len, '';
}

$key_list_string .= "::\n";

## colorizing ##  [ NO WHITE TEXT ] ##
##
## Strategy: apply base teal FIRST, then specific colors, restore to teal
## after each colored element. Final reset at end only.
##
if ( <system.ansi_color> or <system.force_colors> ) {
    my $_sn = $names_len + 2;
    no warnings qw| experimental |;

    ##  1. base teal on everything  ##
    $key_list_string =~ s|^(.+)$|$C{T}$1|mg;

    ##  2. specific colors - always restore to teal after  ##

    ##  leading colons purple, back to teal  ##
    $key_list_string =~ s|^( *)(:{1,2})|$1$C{0}$2$C{T}|mg;

    ##  header line  ##
    $key_list_string =~ s|::(.+):.|$C{0}::$C{T}$1$C{0}:.$C{T}|m;

    ##  trailing dots and colons  ##
    $key_list_string =~ s|  (\.)$|  $C{b}$C{0}$1$C{T}|mg;
    $key_list_string =~ s|  (\:) |  $C{b}$C{0}$1$C{T} |mg;

    ##  checksums/marks purple  ##
    $key_list_string =~ s,(*plb:(\ {$_sn}|:\ signed\ :|[\>']))\ (?<n>[\.\:])
        , $C{0}$+{n}$C{T},mgx;

    ##  signed marker  ##
    $key_list_string =~ s|: signed \e\S+|$C{0}: signed :$C{T}|mg;

    ##  host pin \ owner marker  ##
    $key_list_string =~ s{( (?:host-root|owner))(?= : )}{$C{0}$C{b}$1$C{T}}gm;
    $key_list_string =~ s|(\[ [^\]]+ \])|$C{0}$1$C{T}|mg;

    ##  encrypted marker  ##
    $key_list_string =~ s,(<:.+:>|encrypted),$C{0}$C{b}$1$C{T},mg;

    ##  key names in quotes - name in teal, quotes purple  ##
    $key_list_string =~ s|'([^']+)'|$C{0}'$C{T}$1$C{0}'$C{T}|mg;

    ##  filename extensions in purple  ##
    $key_list_string =~ s{(\.(public|private|secret|sig))$}{$C{0}$1$C{T}}gm;
    $key_list_string =~ s{(\.(public|private|secret|sig))(:)}
        {$C{0}$1$C{T}$2}mg;

    ##  incomplete marker  ##
    $key_list_string =~ s<(\S+)  (\[incomplete\])>
        <$C{0}$C{b}$1$C{T}  $C{o}$2$C{T}>mg;

    ##  user name after 'user' text  ##
    $key_list_string =~ s|(?<=user)( \S+ )|$C{B}$C{b}$1$C{T}|gm;

    ##  seed-phrase and virtual  ##
    $key_list_string =~ s{($name_regex\Q:seed-phrase\E)}
        {$colors{'B01'}$1$C{T}}mg;
    $key_list_string =~ s{(:.virtual.::)}
        {$colors{'B01'}$1$C{T}$C{B}$colors{'B02'}}mg;

    ##  final reset ONLY at end  ##
    $key_list_string =~ s|$|$C{R}|mg;
}

if (@unreadable_note_lines) {
    my $err_count = scalar @unreadable_note_lines;
    $key_list_string .= $colors{'p7_fg_0003'};
    $key_list_string
        .= sprintf( " :: %d key file%s skipped — unrecognized name :.\n :\n",
        $err_count, <[base.cnt_s]>->($err_count) );
    $key_list_string .= sprintf( " :  %s\n", $ARG )
        for @unreadable_note_lines;
    $key_list_string .= ' :.';
    $key_list_string .= $colors{'reset'};
}

return say $key_list_string;

#,,.,,,,.,,,,,,..,,,.,..,,.,,,.,,,,,.,,,,,,,,,.,.,...,.,,,..,,...,...,.,.,,,.,
#UK6NOBRCWIGV562BNEZHCUXASCOQIHL7XD3XP4UFNVULQVZS5C432JUF523GC4LE2S3257SYSX236
#\\\|N5FIJJ4LPLYYEMF4QHDTNDHWYASFQBT7H6B36NASS2JR5YRPFJE \ / AMOS7 \ YOURUM ::
#\[7]E4JSNAQUKS3IXKBK6IKMLXM5XVF5WJYNKZKBY6A4LDKY3XRKFIAY 7  DATA SIGNATURE ::
#:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
