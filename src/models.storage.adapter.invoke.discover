## [:< ##

# name  = models.storage.adapter.invoke.discover
# descr = query invokeai.db and return list of model records

# [ input: optional hashref with db_path override ]
# [ output: arrayref of model hashrefs ]

my $params = $ARG // {};

# determine db path from config, params, or default
my $admin_user = <system.admin-user> // '';
my $admin_home = length $admin_user ? ( getpwnam $admin_user )[7] : undef;
## invoke.ai default db location : <root>/databases/invokeai.db [ an  ##
## older layout used <root>/db/ -- a stale copy may still sit there ] ##
my $invoke_root = <external.models.invokeai.root>
    // ( defined $admin_home ? "$admin_home/.invokeai" : undef );
my $db_path = $params->{'db_path'} // <external.models.invokeai.db>
    // ( defined $invoke_root ? "$invoke_root/databases/invokeai.db" : undef )
    // "$ENV{'HOME'}/.invokeai/databases/invokeai.db";

# check if db exists
unless ( -f $db_path ) {

    ## not readable after privilege drop [ e.g. a 700 home directory ] : ##
    ## fall back to the snapshot read as root during init_code           ##
    my $snapshot = <models.invoke.db_snapshot>;
    if ( $!{'EACCES'} and defined $snapshot ) {
        <[base.logs]>->(
            2, "discover: db not readable [ %s ], startup snapshot [ %d ]",
            $db_path, scalar $snapshot->{'records'}->@*
        );
        return [ $snapshot->{'records'}->@* ];
    }

    <[base.logs]>->(
        0,
        "discover: db %s [ %s ]",
        $!{'EACCES'} ? 'not readable' : 'not found', $db_path
    );
    return [];
}

# query database for all models
my $sql
    = "SELECT name, type, source, source_type, json_extract(config, "
    . "'\$.description') as description, json_extract(config, "
    . "'\$.file_size') as size, json_extract(config, '\$.path') as "
    . "path, json_extract(config, '\$.format') as format, "
    . "json_extract(config, '\$.base') as base FROM models ORDER BY "
    . "type, name;";

## read-only [ no journal rollback ]. as root [ init_code ] : run as the db ##
## owner -- a WAL mode reader creates missing -shm \ -wal files, and        ##
## root-owned ones would lock the owner's own process out                   ##
my $run_as    = '';
my $db_owner  = ( stat $db_path )[4] // 0;
my $owner_str = getpwuid $db_owner;
$run_as = qq{/usr/sbin/runuser -u "$owner_str" -- }
    if $EUID == 0
    and $db_owner != 0
    and defined $owner_str;
my $cmd
    = qq{${run_as}sqlite3 -readonly "file:$db_path?mode=ro" ".mode json" }
    . qq{"$sql" 2>/dev/null};
my $json = qx{$cmd};

unless ($json) {
    <[base.logs]>->( 0, "discover: failed to query db [ %s ]", $db_path );
    return [];
}

my $models = eval { JSON::PP::decode_json($json) };
if ($@) {
    <[base.logs]>->( 0, "discover: failed to parse json [ %s ]", $@ );
    return [];
}

# skip types that use non-standard paths
my %skip_types = map { $_ => 1 } qw(
    spandrel_image_to_image
    unknown
);

# filter models
my @filtered;
for my $m (@$models) {
    my $path = $m->{'path'} // '';
    my $type = $m->{'type'} // 'unknown';

    # skip certain types
    next if $skip_types{$type};

    # skip windows paths (drive letter)
    next if $path =~ m|^[A-Za-z]:[\\/]|;

    # skip absolute unix paths
    next if $path =~ m|^/|;

    # skip empty paths
    next if $path eq '';

    push @filtered,
        {
        'name'        => $m->{'name'},
        'type'        => $type,
        'base'        => $m->{'base'}   // 'any',
        'format'      => $m->{'format'} // '',
        'path'        => $path,
        'size'        => $m->{'size'}        // 0,
        'source'      => $m->{'source'}      // '',
        'source_type' => $m->{'source_type'} // '',
        };
}

<[base.logs]>->( 2, "discover: found %d models", scalar @filtered );

## snapshot for reads after the privilege drop [ see above ] ##
<models.invoke.db_snapshot> = {
    'records' => [@filtered],
    'path'    => $db_path,
    'time'    => <[base.time]>->(3),
};

return \@filtered;

