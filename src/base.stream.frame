## [:< ##

# name  = base.stream.frame
# descr = 3+1 bit frame encoder : payload + separator with inversion
# param = <payload> [ 0-7, 3 bits ]
# return = 4-bit frame [ payload shifted left 1, separator bit appended ]

my $payload = shift;

## an all-zero payload would collapse the field with no transitions, so the ##
## separator inverts from . [0] to , [1] to hold one open instead           ##
my $sep = ( $payload == 0 ) ? 1 : 0;

return ( $payload << 1 ) | $sep;

