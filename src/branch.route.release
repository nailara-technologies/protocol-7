## [:< ##

# name  = branch.route.release
# descr = release route [ tear down on-demand path ]
# param = route_id [ string or { id => ... } ]

my $params = shift // '';
my $route_id
    = ref $params eq 'HASH'
    ? $params->{'id'} // ''
    : $params;

return { 'mode' => 'false', 'data' => 'route id required' }
    unless length $route_id;

my $route = $data{'branch.routes'}{$route_id};
return { 'mode' => 'false', 'data' => 'route not found' }
    unless defined $route;

$route->{'state'} = 'released';

my $observer = $route->{'observer'};
my $target   = $route->{'target'};

delete $data{'branch.routes.by_observer'}{$observer}{$route_id}
    if exists $data{'branch.routes.by_observer'}{$observer};
delete $data{'branch.routes.by_target'}{$target}{$route_id}
    if exists $data{'branch.routes.by_target'}{$target};

<[base.logs]>->(
    2, 'branch.route.release: %s observer=%s target=%s',
    $route_id, $observer, $target
);

return { 'mode' => 'true', 'data' => $route_id };

