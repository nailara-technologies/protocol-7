# name  = plugin.nshell.coding-session
# descr = coding-zenka chat session logic : main dispatch
# param = { hook => 'on_submit' | 'on_reply' | 'on_escape' | 'on_ctrl_c' |
#           'on_redo', mode => $mode_href, ... }

my $args = shift           // {};
my $hook = $args->{'hook'} // '';

if ( $hook eq qw| on_submit | ) {
    return <[plugin.nshell.coding-session.on_submit]>->($args);
} elsif ( $hook eq qw| on_reply | ) {
    return <[plugin.nshell.coding-session.on_reply]>->($args);
} elsif ( $hook eq qw| on_escape | ) {
    return <[plugin.nshell.coding-session.on_escape]>->($args);
} elsif ( $hook eq qw| on_ctrl_c | ) {
    return <[plugin.nshell.coding-session.on_ctrl_c]>->($args);
} elsif ( $hook eq qw| on_redo | ) {
    return <[plugin.nshell.coding-session.on_redo]>->($args);
}

return undef;

