## [:< ##

# name  = system.watch.cmd.watch-remove
# param = <id>
# descr = remove a watch [ queued signals still go out ]

my $id = ( $call->{'args'} // '' ) =~ s{\A\s+|\s+\z}{}gr;
return { 'mode' => qw| false |, 'data' => "no watch '$id'" }
    if not exists <system.watch.entries>->{$id};
my $old = delete <system.watch.entries>->{$id};
if ( not <[system.watch.save]> ) {
    <system.watch.entries>->{$id} = $old;
    return {
        'mode' => qw| false |,
        'data' => 'watch registry cannot be written [ see log ]'
    };
}
return { 'mode' => qw| true |, 'data' => "watch '$id' removed" };

