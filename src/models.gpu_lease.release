## [:< ##

# name  = models.gpu_lease.release
# descr = release a holder's gpu residency lease
# param = owner name

my $owner = shift // '';
return FALSE if $owner ne qw| coding | and $owner ne qw| invoke-web |;

my $lease = <models.gpu_lease> //= {};
delete $lease->{'waiting'}->{$owner};

## a pending handover TO this owner ends with it : otherwise models waits   ##
## for vram on behalf of a zenka that is gone, and the other side's request ##
## is never granted [ coding terminated 2026-11-27 : no holder, invoke-web  ##
## rendering without a lease ]                                              ##
if ( ref $lease->{'pending'} eq qw| HASH |
    and ( $lease->{'pending'}->{'requester'} // '' ) eq $owner ) {
    delete $lease->{'pending'};
    <[base.logs]>->(
        1, ': gpu lease handover to %s dropped [ released ]', $owner
    );
    <[models.gpu_lease.handler.tick]>;
    return TRUE;
}

return FALSE if ( $lease->{'holder'} // '' ) ne $owner;

delete $lease->{'holder'};
delete $lease->{'touched'};
<[base.logs]>->( 1, ': gpu lease released by %s', $owner );
<[models.gpu_lease.handler.tick]>;
return TRUE;

