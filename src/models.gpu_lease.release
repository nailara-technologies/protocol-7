## [:< ##

# name  = models.gpu_lease.release
# descr = release a holder's gpu residency lease
# param = owner name

my $owner = shift // '';
return FALSE if $owner ne qw| coding | and $owner ne qw| invoke-web |;

my $lease = <models.gpu_lease> //= {};
delete $lease->{'waiting'}->{$owner};
return FALSE if ( $lease->{'holder'} // '' ) ne $owner;

delete $lease->{'holder'};
delete $lease->{'touched'};
<[base.logs]>->( 1, ': gpu lease released by %s', $owner );
<[models.gpu_lease.handler.tick]>;
return TRUE;

