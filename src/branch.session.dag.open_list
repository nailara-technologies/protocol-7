## [:< ##

# name = branch.session.dag.open_list
# descr = all nodes with state open

my @open;
for my $key ( keys %data ) {
    next if index( $key, 'branch.session.dag.' ) != 0;
    my $node = $data{$key};
    next if not defined $node;
    push @open, substr( $key, length('branch.session.dag.') )
        if ( $node->{'state'} // '' ) eq 'open';
}

return \@open;

