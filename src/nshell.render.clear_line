## [:< ##

# name = nshell.render.clear_line
# descr = Clear display line before redraw

my ( $display_length, $min_width ) = @_;
$min_width //= 20;

my $clear_len = length($display_length) + $min_width;
$clear_len = $min_width if $clear_len < $min_width;
print "\r" . ( ' ' x $clear_len ) . "\r";
STDOUT->flush();

return;

