## [:< ##

# name   = host-edit.action.probe
# descr  = probe a host's cube through a dial address, pin nothing
# param  = <record name> <cube port> <dial host> <dial port>
# return = { state, key_id, name } or undef [ list : ( undef, reason ) ]
#
# data/md/design/HOST-SETUP.md 'add-host flow' step 2 : `p-7-r -strict
# -host <name>:<cube port> <dial>` -- the pin is looked up under the
# RECORD's name [ never the forward's 127.0.0.1:<local> ], -strict writes
# nothing. states : 'unpinned' [ key id + leaf name offered ], 'pinned'
# [ matches the record's pin ], 'mismatch' [ another host-root than the
# pin -- never accepted here ], 'refused' [ delegation invalid ],
# 'error'. run through host-edit.action.run_p7r.

my ( $name, $cube_port, $dial_host, $dial_port ) = @ARG;

my $refuse = sub {
    my $reason = shift;
    return wantarray ? ( undef, $reason ) : undef;
};

return $refuse->('record name not valid')
    if not defined $name
    or $name !~ m|\A[a-z0-9][a-z0-9._-]{0,62}\z|;
return $refuse->('dial host not valid')
    if not defined $dial_host
    or $dial_host !~ m|\A[A-Za-z0-9][A-Za-z0-9.-]{0,252}\z|;
foreach my $port ( $cube_port, $dial_port ) {
    return $refuse->('port not valid')
        if not defined $port
        or $port !~ m|\A[0-9]{1,5}\z|
        or $port < 1
        or $port > 65535;
}

my ( $output, $status ) = <[host-edit.action.run_p7r]>->(
    [   qw| -v -strict -host |,  "$name:$cube_port",
        "$dial_host:$dial_port", qw| commands |
    ]
);
return $refuse->($status) if not defined $output;

my $re_id = qr|([A-Z2-7]{77})|;
my $re_nm = qr|([A-Za-z0-9][A-Za-z0-9._-]{0,254})|;

## strict + no pin [ exit 5 ] : the offer ##
if ( $output =~ m|offered host-root $re_id \[ $re_nm \]| ) {
    my ( $key_id, $leaf ) = ( $1, $2 );
    return {
        qw| state |  => $status == 6 ? qw| mismatch | : qw| unpinned |,
        qw| key_id | => $key_id,
        qw| name |   => $leaf,
    };
}
## the record's pin matched [ -v line ; whether the login after it     ##
## succeeded is a separate matter : this client may not be  authorized ##
## there yet -- the host-root check itself passed ]                    ##
if ( $output =~ m|host-root $re_id \[ $re_nm \] matches pin| ) {
    return {
        qw| state |  => qw| pinned |,
        qw| key_id | => $1,
        qw| name |   => $2,
        qw| login |  => $status == 0 ? TRUE : FALSE,
    };
}

return {
    qw| state |  => qw| refused |,
    qw| reason | => $1,
    }
    if $output =~ m|delegation refused \[ ([^\]]{1,200}) \]|;

my ($last) = grep {length} reverse split m|\n|, $output;
return $refuse->( sprintf 'p-7-r exit %d [ %s ]', $status, $last // '?' );

