## [:< ##

# name  = models.chat.expand_refs.format_tail
# descr = format last N lines of file content for inline expansion
# param = $path    - file path label
# param = $content - file content string
# param = $n       - number of lines from end
# return = formatted string with tail lines

my ( $path, $content, $n ) = @ARG;

return $content if $content =~ m{^\[ERROR:};

my @lines = split( m{\n}, $content );
my @tail  = @lines >= $n ? @lines[ -$n .. -1 ] : @lines;

return sprintf( "\n=== TAIL (%d lines): %s ===\n%s\n=== END ===\n",
    $n, $path, join( "\n", @tail ) );

0;

