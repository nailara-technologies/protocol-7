## [:< ##

# name  = screenshot.scale_image
# descr = scale an Imager object to given pixel dimensions

my ( $image, $width, $height ) = @ARG;

if ( ref( $image // '' ) ne qw| Imager | ) {
    warn 'expected image as Imager object <{C1}>';
    return undef;
}
if (   not defined $width
    or $width !~ m|^\d+$|
    or not defined $height
    or $height !~ m|^\d+$| ) {
    warn 'expected width and height in pixels <{C1}>';
    return undef;
}

my $scaled = $image->scale(
    'xpixels' => $width,
    'ypixels' => $height,
    'qtype'   => 'mixing',
    'type'    => 'nonprop'
);
return $scaled if $scaled;
return Imager->errstr;

