## [:< ##

# name  = nameserv.sync.client.connected
# descr = finish a sync pull connect : watch reads, ask the peer ts

my $state = shift // return;

if ( ref $state->{'watcher'} ) {
    $state->{'watcher'}->cancel
        if $state->{'watcher'}->can('is_active')
        and $state->{'watcher'}->is_active;
    $state->{'watcher'} = undef;
}

if ( ref $state->{'conn_timer'} ) {
    $state->{'conn_timer'}->cancel
        if $state->{'conn_timer'}->can('is_active')
        and $state->{'conn_timer'}->is_active;
    $state->{'conn_timer'} = undef;
}

## remember the address that worked : it is tried first next time ##
my $addrs = $state->{'addrs'};
my $addr  = undef;
if (    ref $addrs eq qw| ARRAY |
    and $state->{'addr_idx'} >= 0
    and ref $addrs->[ $state->{'addr_idx'} ] eq qw| HASH | ) {
    $addr = $addrs->[ $state->{'addr_idx'} ];
}
if ( defined $addr ) {
    my $worked = <nameserv.sync.client.addr_worked> //= {};
    $worked->{ sprintf '%s:%d', $state->{'host'}, $state->{'port'} }
        = $addr->{'host'};
}

my $zone_arg = length( $state->{'target'} // '' ) ? $state->{'target'} : '';
my $request
    = length $zone_arg
    ? "last-data-timestamp $zone_arg\n"
    : "last-data-timestamp\n";

syswrite $state->{'sock'}, $request;

$state->{'phase'} = 'last-ts';

$state->{'watcher'} = <[event.add_io]>->(
    {   fd      => $state->{'sock'},
        poll    => 'r',
        handler => qw| nameserv.sync.client.handler.read |,
        data    => $state->{'id'},
        desc    => "sync pull read [ $state->{'host'}:$state->{'port'} ]"
    }
);

return TRUE;

