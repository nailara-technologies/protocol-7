## [:< ##

# name  = base.load_section_code
# args  = [target_arrayref ,] <file_name> [,<file_name> [, <file_name>..]]
# descr = load one or more 'section' code files, return array ref to structure

## the files are matched under the config path and parsed into one        ##
## structure by base.parse_ncfg_code -- this held a copy of that parser,  ##
## with the same misplaced repeat check [ 2026-10-23 ]. the target, given ##
## or new, collects all files : a section a later file repeats continues  ##

my $conf_path       = <system.conf_path>;
my $code_data       = ref $ARG[0] eq qw| ARRAY | ? shift : [];
my @code_files      = @ARG;   ## file list data will be appended to $code_data
my @match_filenames = <[file.match_files]>->(
    $conf_path, map { sprintf qw| %s$ |, $ARG } @code_files
);
if ( @match_filenames == 0 ) {
    warn 'no cfg file names match <{C1}>';
    return undef;
}
foreach my $filename (@match_filenames) {
    my @cfg_lines;
    <[file.slurp]>->( $filename, \@cfg_lines );
    if ( @cfg_lines == 0 ) {
        <[base.logs]>->( 0, "cannot load config-file '%s'", $filename );
        return undef;
    }
    ( my $cfg_name = $filename ) =~ s|^.*/||g;
    <[base.parse_ncfg_code]>->( $cfg_name, $code_data, @cfg_lines );
}
return $code_data;

