## [:< ##

# name  = base.stdio_multiplex.emit_eout
# param = $fd, $bytes_sref
# descr = emit an EOUT typed run for the given fd [ 1 = stdout,
#         2 = stderr, >=3 = sub-tree ]

my ( $fd, $bytes_sref ) = @ARG;

my $conn_handle = <base.stdio_multiplex.conn> // undef;
return if not defined $conn_handle;
return if not defined $data{'stdio_transport'}{'connections'}{$conn_handle};

return if not defined $bytes_sref or ref $bytes_sref ne qw| SCALAR |;

return <[base.stdio.transport.emit]>->(
    $conn_handle,
    qw| EOUT |,
    qw| nibble |,
    $bytes_sref->$*,
    { fd => $fd }
);

