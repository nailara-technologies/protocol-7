## [:< ##

# name  = osf-cache.init_code
# descr = osf-cache config defaults [ runs before the privilege drop ]
# param = [ reinit ]
#
# runs during [init_modules], BEFORE [root.drop_privs] : config
# defaults only - no filesystem scan and no timers here, those need
# the post-drop home and rights [ see osf-cache.startup, called from
# zenka.v7 after the drop - same pattern usage.startup uses ].
# reinit guarding is a hard invariant in this repo : a reload must
# never break or duplicate state, so on reinit the existing holdings
# and any running scan are kept exactly as they are.

my $reinit = shift // FALSE;

if ( $reinit and defined <osf-cache.cfg.cache_dir> ) {
    <[base.log]>->( 2, 'skipping osf-cache re-init [ config already set ]' );
    return 0;
}

<[base.log]>->( 2, 'initializing osf-cache zenka..,' );

## per-subname instance config [ 'v7-zenki.start osf-cache[peer]' sets ##
## <system.zenka.subname> ; ticker.init_code pattern ] : the subname   ##
## selects the state file and may override the cache dir through       ##
## <osf-cache.cfg.by_subname.<subname>.cache_dir> - it never touches   ##
## authorization [ subname routing convention ].                       ##
my $subname = <system.zenka.subname> // '';
my $sub_cfg
    = length $subname
    ? ( <osf-cache.cfg.by_subname> // {} )->{$subname} // {}
    : {};

my $state_file
    = length $subname
    ? sprintf( qw| holdings.%s.yaml |, $subname )
    : qw| holdings.yaml |;

<osf-cache.cfg.cache_dir> //= $sub_cfg->{'cache_dir'}
    // qw| /var/cache/apt/archives |;
<osf-cache.cfg.lists_dir> //= qw| /var/lib/apt/lists |;
<osf-cache.cfg.state_path>
    //= <[file.zenka_dir.data_path]> . '/' . $state_file;
<osf-cache.cfg.scan_slice>     //= 4;
<osf-cache.cfg.lookup_timeout> //= 5;    ## seconds [ peer lookup ] ##

<[base.log]>->( 2, 'osf-cache zenka initialization complete' );

0;

