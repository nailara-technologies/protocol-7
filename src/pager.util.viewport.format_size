## [:< ##

# name  = pager.util.viewport.format_size
# descr = Format byte size for display with units

my ($bytes) = @ARG;

return '0' if $bytes == 0;

my @units    = qw(B KB MB GB TB);
my $unit_idx = 0;

while ( $bytes >= 1024 && $unit_idx < @units - 1 ) {
    $bytes /= 1024;
    $unit_idx++;
}

return
    sprintf( $bytes < 10 ? "%.1f%s" : "%.0f%s", $bytes, $units[$unit_idx] );

