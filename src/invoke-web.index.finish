## [:< ##

# name   = invoke-web.index.finish
# descr  = end the image index job [ done, stopped or an error ] : backup,
#          allow the idle shutdown again
# param  = reason

my $reason = shift // 'stopped';

<invoke-web.index.running> = FALSE;
my $timer = delete <invoke-web.timer.index_step>;
$timer->cancel if defined $timer and ref $timer and $timer->is_active;

my $stats = <invoke-web.index.stats> // {};
<[base.logs]>->(
    1,
    'image index %s : %d indexed, %d skipped, %d missing, %d failed',
    $reason,
    $stats->{'indexed'} // 0,
    $stats->{'skipped'} // 0,
    $stats->{'missing'} // 0,
    $stats->{'failed'}  // 0
);

<[invoke-web.index.backup]>;
<[base.zenki.resume_ondemand_timeout]>
    if ( <invoke-web.status> // 'idle' ) ne 'running';

return undef;

