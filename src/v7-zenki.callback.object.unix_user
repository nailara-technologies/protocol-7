## [:< ##

# name  = v7-zenki.callback.object.unix_user
# descr = start condition : a unix user exists [ unix_user:<name> ]
# note  = in a start.cfg : 'dependencies = cube unix_user:<name>' -- waits
#         for a condition, not for a whole zenka [ e.g. a zenka writing to
#         a service account's directory starts once the account exists ;
#         no root run or login needed to create it beforehand ]

my $object_id = shift;
return undef if not exists <dependency.object>->{$object_id};

my $name = <dependency.object>->{$object_id}->{'name'} // '';
return FALSE if not length $name;

return TRUE if defined scalar getpwnam($name);

## unmet : look again in a few seconds    ##
## [ no job move may come to trigger it ] ##
<[v7-zenki.condition.recheck_later]>;
return FALSE;

