## [:< ##
# name  = plugin.storage.p7ref.index
# descr = Index P7REF for parallel reference tracking

my ($args) = @ARG;

my $p7ref = $args->{p7ref}
    or return { 'mode' => 'false', 'data' => 'p7ref required' };
my $metadata = $args->{metadata} // {};

my $registry = $data{'storage'}{'mapping'}{'p7ref'};
my $index    = $registry->{'index'};

# Parse to extract components
my $parse_res = <[plugin.storage.p7ref.parse]>->( { 'p7ref' => $p7ref } );
return $parse_res if $parse_res->{'mode'} eq 'false';

my $parsed = $parse_res->{'data'};

# Index by type-specific keys
if ( $parsed->{'type'} eq 'checksum' ) {
    my $checksum = $parsed->{'address'};
    $index->{'by-checksum'}{$checksum} //= [];
    push @{ $index->{'by-checksum'}{$checksum} }, $p7ref
        unless grep { $ARG eq $p7ref }
        @{ $index->{'by-checksum'}{$checksum} };
} elsif ( $parsed->{'type'} eq '9p' ) {
    my $default_authority = 'localhost:' . ( <plan-9.default_port> // 15640 );
    my $key = ( $parsed->{'authority'} // $default_authority )
        . $parsed->{'address'};
    $index->{'by-9p'}{$key} //= [];
    push @{ $index->{'by-9p'}{$key} }, $p7ref
        unless grep { $ARG eq $p7ref } @{ $index->{'by-9p'}{$key} };
} elsif ( $parsed->{'type'} eq 'path' ) {
    $index->{'by-path'}{ $parsed->{'address'} } = $p7ref;
}

# Store metadata
$registry->{'cache'}{$p7ref}{'metadata'} = $metadata;

return {
    'mode' => 'true',
    'data' => {
        'indexed' => 1,
        'type'    => $parsed->{'type'},
        'p7ref'   => $p7ref,
    }
};

