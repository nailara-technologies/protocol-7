# name = coding.helper.task_id_generator
# descr = generate unique task identifiers with harmonic validation

my $type = shift @ARG // qw| unknown |;

# Create seed from type and harmonized network time
my $ntime = <[base.ntime.b32]>->(5);
my $seed  = join '-', $type, $ntime;

# Generate harmonized task ID with template
my $template = qw| task-%s |;
my $checksum = <[chk-sum.amos.truth_template_chksum]>->( $template, \$seed );

return sprintf $template, $checksum;

