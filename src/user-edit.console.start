## [:< ##

# name  = user-edit.console.start
# descr = interactive settings form for a user record
# param = [ <username> ]

## the interactive half of phase 3.  identical setup to
## user-edit.console.show-form — the record fetch, derived schema and
## generated frame are the same code — and differs only in setting interactive
## mode, which makes user-edit.handler.value_get_reply bring up raw terminal
## input and the redraw watcher instead of printing once and exiting.
##
## HYBRID LOOP MODE : [init-done:TRUE] + [zenka.loop] are called HERE rather
## than in the start file, so 'commands' and 'describe' still print and exit [
## see cfg/zenki/user-edit/zenka.v7 ].  unlike show-form this never leaves the
## loop on its own — every exit path funnels through user-edit.form.quit so
## the terminal is always restored

my $params = shift // '';

## '-no-tty' opens the form without a terminal : no raw mode, no STDIN
## watcher.  keys then arrive over the network via user-edit.cmd.char-add,
## which replies with the rendered form — so the interactive path can be
## driven and verified headlessly [ nshell's -no-tty-debug precedent ]
<user-edit.mode.no_tty_debug> = $params =~ s|\s*-no-tty\b|| ? TRUE : FALSE;

## ':tag:' tokens are a separate class from the '-no-tty' flag above, and are
## partitioned out BEFORE the username fallback -- otherwise 'start
## :create-admin:' would take the tag itself as the username
my $tags;
( $params, $tags ) = <[user-edit.parse_params]>->($params);

my $username = $params;
$username =~ s|^\s+||;
$username =~ s|\s+$||;
$username = <user-edit.unix_user> if not length $username;

my ($cube_sid) = keys <user.cube.session>->%*;

if ( not defined $cube_sid or not exists $data{'session'}{$cube_sid} ) {
    print "\n  << no cube session — cannot reach the users zenka >>\n\n";
    return FALSE;
}

if ( not -t STDIN and not <user-edit.mode.no_tty_debug> ) {
    ## NOTE : no quoted token directly after '<<' in these messages — "<<
    ## 'start' .." parses as a heredoc opener and breaks the module
    print "\n  << the start command needs a terminal "
        . "[ use show-form when piped ] >>\n\n";
    return FALSE;
}

<user-edit.cube_sid> = $cube_sid;
## this console command owns the event loop, so its reply handler is allowed
## to unloop and hand control back [ user-edit.offer_create ]
<user-edit.offer.create>     = TRUE;
<user-edit.form.username>    = $username;
<user-edit.form.interactive> = TRUE;
<user-edit.form.title>       = sprintf( 'user-edit : %s', $username );

## enter submits, matching editor.control.process_key's default ##
<user-edit.form.submit_on> = qw| enter |;

## the end_code terminal-restore callback is registered by user-edit.
## term_init, on success — NOT here.  registering it up front would leave a
## restore callback armed on a process that never went raw [ e.g. the record
## fetch fails ], and its no-saved-state fallback would then clear O_NONBLOCK
## and force ECHO/ICANON/ISIG on a descriptor nothing had touched

<[base.logs]>->( 2, ': starting interactive form [ %s ]', $username );

<[protocol-7.command.send.local]>->(
    {   qw| command |   => sprintf( '%d.users.value-get', $cube_sid ),
        qw| call_args | => { qw| args | => $username },
        qw| reply |     =>
            { qw| handler | => qw| user-edit.handler.value_get_reply | }
    }
);

<[base.init-done]>->(TRUE);    ## standalone zenka : not v7-managed ##

<[base.zenka.loop]>;

## resumes here only if the reply handler unlooped to offer a record ##
return <[user-edit.offer_create]>->( $username, $tags );

