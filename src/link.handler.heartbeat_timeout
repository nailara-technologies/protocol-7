## [:< ##

# name  = link.handler.heartbeat_timeout
# descr = no heartbeat reply within link.cfg.timeout
# param = <Event> [ the timer carries { name } ]
#
# the design : a heartbeat timeout closes the session AND the transport,
# then reconnects [ link.supervisor.link_down schedules the backoff ].
# only a still-'up' link acts : a teardown that already ran leaves the
# state 'down' and this fires into nothing.

my ($event) = @ARG;

my $name = $event->w->data->{'name'} // '';
return FALSE if not length $name;

my $entry = <external.links>->{$name} // return FALSE;
return FALSE if ( $entry->{'state'} // '' ) ne qw| up |;

<[base.logs]>->(
    0,     '<< link %s : heartbeat timeout after %d s : reconnecting >>',
    $name, <link.cfg.timeout> // 10
);

return <[link.supervisor.link_down]>->( $name, qw| heartbeat timeout | );

