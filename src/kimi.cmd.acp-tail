## [:< ##

# name  = kimi.cmd.acp-tail
# param = [ <n> ]
# descr = the last n event lines of the kimi acp session [ 30 ]

my ($count) = ( $call->{'args'} // '' ) =~ m|\A\s*(\d{1,4})\s*\z|;
$count ||= 30;
my @events = @{ <[kimi.acp.state]>->()->{'events'} };
@events = @events[ -$count .. -1 ] if @events > $count;

return { 'mode' => qw| true |, 'data' => 'no events' } if not @events;
return { 'mode' => qw| size |, 'data' => join( "\n", @events ) . "\n" };

