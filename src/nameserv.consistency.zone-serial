## [:< ##

# name  = nameserv.consistency.zone-serial
# descr = serial field of a zone's own SOA record

## the third field of the SOA rdata [ mname rname serial ... ] -- not the zone
## hash's serial field, which add-record \ set-record bump as a timestamp and
## which the dns answers never echo back.

my $zone      = shift                                  // return undef;
my $zone_recs = <nameserv.zones>->{$zone}->{'records'} // [];
for my $rec (@$zone_recs) {
    next if uc( $rec->{'type'} // '' ) ne qw| SOA |;
    my @fields = split m|\s+|, $rec->{'value'} // '';
    return $fields[2] if @fields > 2;
}
return undef;

