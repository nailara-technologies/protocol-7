## [:< ##

# name  = jobsite.handler.fetched-stream
# descr = reply handler for <fetch_zenka>.subscribe-fetched : register the
#         STRM consumer that feeds each frame to jobsite.fetched.frame

my $reply = shift // {};

## a reply to a subscribe sent before a reload carries no params ##
my $fetch_zenka = $reply->{'params'}{'fetch_zenka'}
    // <jobsite.cfg.fetch_zenka> // '';

if ( $reply->{'cmd'} eq qw| FALSE | ) {

    ## a refusal ends an OPEN stream too : a dropped link answers the      ##
    ## subscribe with 'command route collapsed', never with an eof -- drop ##
    ## its consumer, or 'subscribed' stays set and nothing ever            ##
    ## re-subscribes [ the outbox on the fetch host never drains ]         ##
    <[strm.local.cancel]>->(<jobsite.fetched.cmd_id>)
        if defined <jobsite.fetched.cmd_id>;
    <jobsite.fetched.cmd_id>      = undef;
    <jobsite.fetched.subscribed>  = FALSE;
    <jobsite.fetched.subscribing> = FALSE;

    ## the first refusal of a streak at level 0, its retries quieter ##
    <jobsite.fetched.last_refusal> = $reply->{'call_args'}->{'args'}
        // 'unknown error';
    <[base.logs]>->(
        defined <jobsite.fetched.retry_delay> ? 2 : 0,
        'jobsite.fetched-stream: subscribe refused : %s',
        <jobsite.fetched.last_refusal>
    );
    <[jobsite.fetched.subscribe-retry]>->($fetch_zenka);
    return;
}

return if $reply->{'cmd'} ne qw| STRM |;
return if ( $reply->{'args'} // '' ) ne qw| open |;

my $cmd_id = $reply->{'cmd_id'};
return if not defined $cmd_id or $cmd_id !~ m|^\d+$|;

my $registered = <[strm.local.register]>->(
    $cmd_id,
    {   'watcher' => sub {
            my $lc = shift;
            return if not length $lc->{'buf'};

            ## whole lines only : a frame split across stream chunks stays ##
            ## in the buffer until its newline arrives                     ##
            while ( $lc->{'buf'} =~ s|^([^\n]*)\n|| ) {
                my $line = $1;
                next if not length $line;
                <[jobsite.fetched.frame]>->($line);
            }
        },
        'on_eof' => sub {
            ## stream closed [ remote auto-terminate or peer gone ] : just ##
            ## forget it -- the next import re-subscribes. a close for an  ##
            ## older stream leaves the newer one                           ##
            return if ( <jobsite.fetched.cmd_id> // -1 ) != $cmd_id;
            <jobsite.fetched.cmd_id>      = undef;
            <jobsite.fetched.subscribed>  = FALSE;
            <jobsite.fetched.subscribing> = FALSE;
            <[base.logs]>->(
                1, 'jobsite.fetched-stream: closed [ cmd_id=%d ]', $cmd_id
            );
        },
    }
);

if ( not $registered ) {
    <jobsite.fetched.subscribing> = FALSE;
    <[jobsite.fetched.subscribe-retry]>->($fetch_zenka);
    return;
}

<jobsite.fetched.cmd_id>       = $cmd_id;
<jobsite.fetched.subscribed>   = TRUE;
<jobsite.fetched.subscribing>  = FALSE;
<jobsite.fetched.retry_delay>  = undef;     ## backoff starts over ##
<jobsite.fetched.last_refusal> = undef;

<[base.logs]>->(
    1, 'jobsite.fetched-stream: consumer registered [ cmd_id=%d ]', $cmd_id
);

return;

