## [:< ##

# name  = keys.console.undistrust
# param = <fp>
# descr = remove a key from the local distrust list
# note  = <fp> : 77 char fingerprint or 52 char public key ;
#         the old list is kept as distrust.<time>.bak

my ( $fp, $why ) = <[keys.fingerprint_arg]>->( shift // '' );
if ( not defined $fp ) {
    printf "\n  << %s >>\n\n", $why;
    <[base.exit]>->(qw| 0010 |);
}

my ( $list, $read_why ) = <[keys.distrust_file]>->(qw| read |);
if ( not defined $list ) {
    printf "\n  << distrust list : %s >>\n\n", $read_why;
    <[base.exit]>->(qw| 0110 |);
}
if ( not exists $list->{'fps'}->{$fp} ) {
    say "\n  << not distrusted >>\n";
    <[base.exit]>->(qw| 0010 |);
}

my @keep = grep {
    ( my $entry = $ARG ) =~ s{#.*}{};
    $entry =~ s{\A\s+|\s+\z}{}g;
    $entry ne $fp
} $list->{'lines'}->@*;

my ( $ok, $write_why ) = <[keys.distrust_file]>->( qw| write |, \@keep );
if ( not $ok ) {
    printf "\n  << distrust list : %s >>\n\n", $write_why;
    <[base.exit]>->(qw| 0110 |);
}

say " :\n :: removed from the distrust list";
<[keys.store_note]>->( $list->{'path'} );
say " :.\n";

