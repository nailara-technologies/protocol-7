## [:< ##

# name  = mpv.cmd.pid
# descr = return mpv player process id

return { 'mode' => qw| false |, 'data' => 'pid not set' }
    if not exists <mpv.pid>
    or not defined <mpv.pid>
    or !length(<mpv.pid>);

return { 'mode' => qw| true |, 'data' => <mpv.pid> }

