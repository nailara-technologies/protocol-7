## [:< ##

# name  = transport.handle.quic-hysteria
# descr = hysteria tunnel via local SOCKS5 proxy (external QUIC client)
# args  = $entry, $context, $continue
# invokes $continue->( $handle_or_undef ) once resolution + connect complete.

my ( $entry, $ctx, $continue ) = @ARG;

my $endpoint = $entry->{'endpoint'} // $ctx->{'request'}{'domain'} // '';
if ( not length $endpoint ) {
    $continue->(undef) if ref $continue eq qw| CODE |;
    return;
}

## finalize handle once credential resolution (if any) completes ##
my $build_handle = sub {
    my $cred = shift;

    if ( exists $entry->{'credential'}
        and defined $entry->{'credential'} ) {
        if (   not defined $cred
            or ref $cred ne qw| HASH |
            or ( $cred->{'mode'} // '' ) ne qw| true | ) {
            <[base.logs]>->(
                1,
                'transport.handle.quic-hysteria: '
                    . 'credential %s resolution failed',
                $entry->{'credential'}
            );
            $continue->(undef) if ref $continue eq qw| CODE |;
            return;
        }
    }

    my $proxy_host = $entry->{'proxy_host'} // '127.0.0.1';
    my $proxy_port = $entry->{'proxy_port'} // 1040;

    my $dest = $ctx->{'session'}{'destination'}
        // $ctx->{'request'}{'domain'} // '';
    my $target_host = $dest;
    my $target_port;
    if ( $target_host =~ s|:([0-9]+)$|| ) {
        $target_port = $1;
    }
    my $request_url = $ctx->{'request'}{'url'} // '';
    if ( not defined $target_port
        and $request_url =~ m|^(?:https?://)?[^/:]+:([0-9]+)| ) {
        $target_port = $1;
    }
    $target_port
        //= ( $ctx->{'request'}{'method'} // '' ) eq qw| CONNECT | ? 443
        : $request_url =~ m|^https://|                             ? 443
        :                                                            80;

    if ( not length $target_host ) {
        $continue->(undef) if ref $continue eq qw| CODE |;
        return;
    }

    my $sock = <[transport.handle.socks5]>->(
        $proxy_host, $proxy_port, $target_host, $target_port
    );
    if ( not defined $sock ) {
        <[base.logs]>->(
            1,
            'transport.handle.quic-hysteria: socks5 connect via %s:%d failed',
            $proxy_host,
            $proxy_port
        );
        $continue->(undef) if ref $continue eq qw| CODE |;
        return;
    }

    my $handle = {
        'type'       => 'quic-hysteria',
        'endpoint'   => $endpoint,
        'socket'     => $sock,
        'proxy_url'  => sprintf( 'socks5://%s:%d', $proxy_host, $proxy_port ),
        'proxy_host' => $proxy_host,
        'proxy_port' => $proxy_port,
        'quality'    => <transport.registry>
            ->{'quality'}{$endpoint}{'quic-hysteria'}{$dest} // {},
        'credential' => $cred,
    };

    <transport.registry>->{'stats'}{'connections_ok'}++;

    $continue->($handle) if ref $continue eq qw| CODE |;
    return;
};

## no credential to resolve: build synchronously ##
if (   not exists $entry->{'credential'}
    or not defined $entry->{'credential'} ) {
    $build_handle->(undef);
    return;
}

## async credential resolve via cred-mesh ##
my $req_id = sprintf( 'qh-%d-%d-%d',
    <[base.ntime.b32]> // 0,
    $PROCESS_ID, int( rand(1_000_000) ) );

<transport.registry>->{'pending_resolve'}{$req_id} = {
    'build'    => $build_handle,
    'continue' => $continue,
    'slot'     => $entry->{'credential'},
    'handler'  => qw| transport.handle.quic-hysteria |,
};

<[protocol-7.route-send]>->(
    {   'command'   => qw| cred-mesh.resolve |,
        'call_args' => { 'args' => $entry->{'credential'} },
        'reply'     => {
            'handler' => qw| transport.handler.credential_resolved |,
            'params'  => { 'req_id' => $req_id },
        },
    }
);

return;

