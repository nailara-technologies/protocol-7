## [:< ##

# name  = window.place.build_strip_candidates
# param = <monitors_aref> <preferred_profile> [<preferred_monitor_index>]
# descr = build an ordered top/bottom-strip candidate list across ALL given
#         monitors, for window.place.find_safe_position to try in order

## a same-monitor candidate list [ eg just the alternate strip + previous ##
## profile ] can't help if the WHOLE monitor it's anchored to becomes     ##
## unavailable - this expands that to cycle through every known monitor   ##
## too, reusing window.profile.calculate per monitor [ which already      ##
## accepts screen_x/screen_y offsets and returns absolute coordinates ].  ##
## ordering: preferred monitor first, preferred profile first within each ##
## monitor - so the common case [ same monitor, alternate edge ] is still ##
## tried before falling through to other monitors.                        ##

my ( $monitors, $preferred_profile, $preferred_index ) = @ARG;

return []
    if ref($monitors) ne qw| ARRAY |
    or not @$monitors;

$preferred_profile //= qw| bottom-strip |;
my $other_profile
    = $preferred_profile eq qw| top-strip |
    ? qw| bottom-strip |
    : qw| top-strip |;

## preferred monitor first, then the rest in given order ##
my @ordered_indices = ( 0 .. $#$monitors );
if ( defined $preferred_index and exists $monitors->[$preferred_index] ) {
    @ordered_indices = (
        $preferred_index, grep { $ARG != $preferred_index } @ordered_indices
    );
}

my @candidates;
for my $mon_idx (@ordered_indices) {
    my $mon = $monitors->[$mon_idx];
    next
        if ref($mon) ne qw| HASH |
        or not defined $mon->{'width'}
        or not defined $mon->{'height'};

    for my $profile ( $preferred_profile, $other_profile ) {
        my $geo = <[window.profile.calculate]>->(
            {   'profile'  => $profile,
                'screen_x' => $mon->{'x'} // 0,
                'screen_y' => $mon->{'y'} // 0,
                'screen_w' => $mon->{'width'},
                'screen_h' => $mon->{'height'},
            }
        );
        push @candidates,
            {
            'x'             => $geo->{'x'} + 0,
            'y'             => $geo->{'y'} + 0,
            'width'         => $geo->{'width'} + 0,
            'height'        => $geo->{'height'} + 0,
            'profile'       => $profile,
            'monitor_index' => $mon_idx,
            };
    }
}

return \@candidates;

