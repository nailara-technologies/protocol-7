# name  = coding.tools.handler.note_prune_trash
# descr = permanently remove trashed note sections past the recovery window

my $args = shift // {};

my $keep_days = $args->{'keep_days'} // undef;

my $result = <[note.trash.prune]>->($keep_days);

my $data = $result->{'data'} // {};

return {
    'content' => $result->{'mode'} eq qw| true |
    ? sprintf(
        "pruned %d trash entries older than %d days",
        $data->{'pruned'}    // 0,
        $data->{'keep_days'} // 0
        )
    : "Failed: " . ( $result->{'data'} // 'unknown' ),
};

