## [:< ##

# name  = system.watch.check.file
# descr = a path appears, changes or grows past a size
# args  = watch, [ unused ], now
#
# the first look is the baseline and never triggers. a path that cannot be
# looked at [ permissions ] is not 'absent' : the baseline stays

my ( $w, undef, $now ) = @ARG;

my @stat = CORE::stat( $w->{'pattern'} );
return FALSE
    if not @stat
    and not $OS_ERROR{'ENOENT'}
    and not $OS_ERROR{'ENOTDIR'};
my $state = @stat ? join( qw| : |, @stat[ 7, 9, 1 ] ) : qw| absent |;
my $old   = $w->{'base'};
return FALSE if defined $old and $old eq $state;
$w->{'base'} = $state;
<system.watch.dirty> = TRUE;
return FALSE if not defined $old or not @stat;

my $old_size = $old eq qw| absent | ? undef : ( split m{:}, $old )[0];
my $on       = $w->{'on'};
my $hit
    = $on eq qw| appear | ? $old eq qw| absent |
    : $on eq qw| change | ? $old ne qw| absent |
    : $stat[7] > $w->{'size'}
    && ( not defined $old_size or $old_size <= $w->{'size'} );
return FALSE if not $hit;

<[system.watch.trigger]>->(
    $w,
    {   'path'  => $w->{'pattern'},
        'event' => $on,
        'size'  => $stat[7]
    },
    $now
);
return TRUE;

