# name = models.cmd.list_attachments
# descr = list attachments in conversation

# Extract params - $call is set by code header
my $params = {};

if ( defined $call->{'param'} && ref $call->{'param'} eq qw| HASH | ) {
    $params = $call->{'param'};
} elsif ( defined $call->{'args'} && length $call->{'args'} ) {

    # Try parsing as JSON first, fall back to YAML
    eval { $params = JSON::PP::decode_json( $call->{'args'} ); };
    if ($EVAL_ERROR) {
        eval { $params = YAML::XS::Load( $call->{'args'} ); };
    }
    $params = {} if $EVAL_ERROR;
}

my $job_id  = $params->{'job_id'}  // '';
my $context = $params->{'context'} // 'conversation';

if ( !length($job_id) ) {
    return {
        'mode' => 'false',
        'data' => "error: job_id required\n"
    };
}

my $result = <[models.list_attachments]>->(
    {   'job_id'  => $job_id,
        'context' => $context,
    }
);

if ( !$result->{'success'} ) {
    return {
        'mode' => 'false',
        'data' => "error: "
            . ( $result->{'error'} // 'unknown error' ) . "\n"
    };
}

my $yaml_data = YAML::XS::Dump($result);
return {
    'mode' => 'size',
    'data' => $yaml_data
};

