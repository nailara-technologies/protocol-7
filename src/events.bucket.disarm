## [:< ##

# name  = events.bucket.disarm
# descr = cancel the clock timer of an entry
# args   = owner zenka, entry

my ( $owner, $e ) = @ARG;
my $key   = "$owner/" . $e->{'id'};
my $timer = delete( ( <events.bucket_timers> //= {} )->{$key} );
$timer->cancel if defined $timer and $timer->is_active;
return TRUE;

