## [:< ##

# name  = form.menu.show_key
# descr = show a key read-only ; keys are not editable
# param = $key_name

## the keys namespace is browsable but READ-ONLY -- a key is not a settings
## record and this form has no business writing one.  so a chosen key opens a
## read-only field set rather than the edit form.
##
## data comes from in-process crypt.C25519 / keys.* helpers that RETURN
## values.  keys.console.list is deliberately not used : it prints,
## autoflushes progress mid-flight and bakes ansi colour into its output,
## which would corrupt the raw-mode screen this runs on.

my ($key_name) = @ARG;

return FALSE if not defined $key_name or not length $key_name;

my $checksums = <[keys.checksum_href]> // {};

## keys.checksum_href is FLAT : { key name => chksum string } -- one checksum
## per key, never per file type [ same source keys.console.list reads ].  an
## encrypted key's entry is the '<:...:>' marker string, still just a value
my $sum = $checksums->{$key_name} // '';

my @rows = (
    {   qw| key |   => $key_name,
        qw| label | => sprintf( 'name       %s', $key_name )
    },
);

if ( length $sum ) {
    push @rows,
        {
        qw| key |   => sprintf( qw| %s.checksum |, $key_name ),
        qw| label | => sprintf( '%-10s %s', qw| checksum |, $sum )
        };
}

push @rows, { qw| key | => '', qw| label | => '[ read-only ]' };

return <[form.menu.open_rows]>->( \@rows, qw| keydetail |, <form.state> );

