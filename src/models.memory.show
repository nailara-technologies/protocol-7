## [:< ##

# name = models.memory.show
# descr = retrieve memory item content by checksum
# param = $checksum
# return = content string or undef if not found

my $checksum = shift;

return undef unless defined $checksum;
return undef unless $checksum =~ m|^[A-Z0-9]{7}$|;

## memory storage path
my $memory_dir = catdir( '/var/protocol-7', <system.zenka.name>, 'memory' );

## tie directory to find files
tie my %memory_files, 'Tie::Dir', $memory_dir or return undef;

## find files matching checksum [ skip .meta ]
my @files = sort { $b cmp $a }
    grep { m|^${checksum}\.| && $_ !~ m|\.meta$| } keys %memory_files;

untie %memory_files;

return undef unless scalar(@files) > 0;

## read latest file using relative path
my $relative_path = catfile( 'memory', $files[0] );
my $content       = <[file.zenka_dir.load]>->($relative_path);

return undef unless defined $content;

return $content->$*;

0;

