## [:< ##

# name  = events.remote.stderr
# descr = retain a bounded remote pull error for the completion log

my ( $line, $handle ) = @ARG;
my $alias = $handle->{'data'}{'alias'}     // return FALSE;
my $run   = <events.remote.runs>->{$alias} // return FALSE;
return FALSE if ( $run->{'handle'} // '' ) ne $handle;
utf8::decode($line);
$line =~ s{[^\x20-\x7e]}{?}g;
push @{ $run->{'stderr'} }, substr( $line, 0, 400 );
shift @{ $run->{'stderr'} } while @{ $run->{'stderr'} } > 13;
return TRUE;

