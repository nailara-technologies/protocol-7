## [:< ##

# name  = vterm.shm.path
# descr = generate SHM path for a layer

my ( $instance_id, $layer_id ) = @ARG;
return undef if not defined $instance_id or not defined $layer_id;

return sprintf( "%s:%s:%d", <vterm.shm.base_path>, $instance_id, $layer_id );

