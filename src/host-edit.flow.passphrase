## [:< ##

# name   = host-edit.flow.passphrase
# descr  = resume a waiting add-host flow with the owner key passphrase
# param  = <record name> <passphrase>
# return = TRUE resumed, FALSE not waiting

my ( $name, $passphrase ) = @ARG;

my $s = ( <host-edit.flow> // {} )->{ $name // '' };
return FALSE
    if ref $s ne qw| HASH |
    or $s->{'step'} ne qw| need_passphrase |
    or not defined $passphrase
    or not length $passphrase;

$s->{'passphrase'} = $passphrase;     ## dropped right after certify ##
$s->{'step'}       = qw| certify |;
<[host-edit.flow.schedule]>->( $name, 0 );
return TRUE;

