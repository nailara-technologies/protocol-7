## [:< ##

# name  = jobsite.replica.forward-endpoint
# descr = forward an http ui action to its primary endpoint

my ( $endpoint, $args, $reply_id ) = @ARG;
my $url = <jobsite.cfg.primary_url> // '';
$url =~ s{/jobs-sync/?$}{/$endpoint};
my $token   = <[jobsite.sync.token_for_url]>->(<jobsite.cfg.primary_url>);
my $headers = {};
$headers->{'Authorization'} = "Bearer $token" if length $token;
my $request = {
    'url'     => $url,
    'body'    => $args // '',
    'headers' => $headers,
    'timeout' => 32,
    'on_done' => qw| jobsite.replica.forward-endpoint-response |,
    'params'  => { 'reply_id' => $reply_id },
};

## a pull sent before this forward carries the old state : pull-response ##
## drops it [ jobsite.replica.pull_seq ]                                 ##
<jobsite.replica.forward_seq>++;
if ( $url =~ m{^https://}i ) {
    <[clients.https.post]>->($request);
} else {
    <[clients.http.post]>->($request);
}
return { 'mode' => qw| deferred | };

