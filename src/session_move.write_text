## [:< ##

# name   = session_move.write_text
# descr  = replace a text file [ tmp + rename, 0600 ]
# args   = path, text
# return = TRUE | FALSE

my ( $path, $text ) = @ARG;
my $tmp = "$path.new.$PID";
CORE::unlink($tmp);
CORE::sysopen( my $fh, $tmp,
    Fcntl::O_WRONLY() | Fcntl::O_CREAT() | Fcntl::O_EXCL(), 0600 )
    or return FALSE;
CORE::binmode( $fh, ':encoding(UTF-8)' );
my $ok = print {$fh} $text;
$ok = FALSE if not CORE::close($fh);
return TRUE if $ok and CORE::rename( $tmp, $path );
CORE::unlink($tmp);
return FALSE;

