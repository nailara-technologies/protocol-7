## [:< ##

# name  = sessions.holder.op.sign
# descr = Ed25519-sign a console-supplied string. binds a freshness
#         timestamp into the payload before signing [ bracket-delimited,
#         timestamp-first -- the SHAPE of crypt.C25519.create_signature_
#         request's convention, not its literal 3-field key-checksum
#         template, which signs a KEY, not arbitrary caller data ].
#         returns signed-string + signature together [ length-prefixed,
#         same convention as the old op.encrypt's counter-prepending ]
#         since an external verifier has no other way to reconstruct the
#         embedded timestamp independently.

my $public_key  = shift;
my $private_key = shift;
my $data        = shift // '';

my $signed_str = sprintf( '<%s:%s>', <[base.ntime.b32]>->( 1, TRUE ), $data );

my $signature
    = Crypt::Ed25519::sign( $signed_str, $public_key, $private_key );

return undef if not defined $signature;

return pack( qw| N |, length($signed_str) ) . $signed_str . $signature;

