## [:< ##

# name  = space.template.verify
# descr = recompute chain from params and verify against checksum
# param = { checksum, template, params }

my $params = shift // {};

my $checksum   = $params->{'checksum'} // '';
my $template   = $params->{'template'} // '';
my $tpl_params = $params->{'params'}   // {};

return { 'mode' => qw| false |, 'data' => 'checksum required' }
    unless length $checksum;
return { 'mode' => qw| false |, 'data' => 'template required' }
    unless length $template;

my $applied = <[space.template.apply]>
    ->( { 'template' => $template, 'params' => $tpl_params } );

return { 'mode' => qw| false |, 'data' => $applied->{'data'} }
    if exists $applied->{'mode'} and $applied->{'mode'} eq qw| false |;

return { 'mode' => qw| true |, 'data' => 'verified' }
    if $applied->{'checksum'} eq $checksum;

return { 'mode' => qw| false |, 'data' => 'mismatch' };

