## [:< ##

# name  = nameserv.sync.peers.start
# descr = start one long-poll loop per configured sync peer

my $peers_str = shift // <nameserv.cfg.sync.peers> // '';

my @tokens = grep {length} split m|\s+|, $peers_str;

my $peers = <nameserv.sync.peers> //= {};

for my $token (@tokens) {
    my ( $host, $port );
    if ( $token =~ m|^\[([^\]]+)\]:(\d+)$| ) {    ## [ ipv6 ]:port ##
        ( $host, $port ) = ( $1, $2 );
    } elsif ( $token =~ m|^([^:]+):(\d+)$| ) {
        ( $host, $port ) = ( $1, $2 );
    } else {
        <[base.logs]>->( 0, ': sync peer not understood : %s', $token );
        next;
    }

    $peers->{$token} //= {
        host    => $host,
        port    => $port,
        ts      => '0',
        backoff => 13,
        state   => qw| idle |,
        sock    => undef,
        watcher => undef,
        timer   => undef,
        buf     => '',
    };

    <[nameserv.sync.peer.arm]>->($token);
}

return TRUE;

