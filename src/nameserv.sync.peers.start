## [:< ##

# name  = nameserv.sync.peers.start
# descr = start one long-poll loop per configured sync peer

my $peers_str = shift // <nameserv.cfg.sync.peers> // '';

my @tokens = grep {length} split m|\s+|, $peers_str;

my $peers = <nameserv.sync.peers> //= {};

for my $token (@tokens) {
    my ( $host, $port );
    if ( $token =~ m|^\[([^\]]+)\]:(\d+)$| ) {    ## [ ipv6 ]:port ##
        ( $host, $port ) = ( $1, $2 );
    } elsif ( $token =~ m|^([^:]+):(\d+)$| ) {
        ( $host, $port ) = ( $1, $2 );
    } elsif ( $token =~ m|^\[([^\]]+)\]$| or $token =~ m|^([^:\[\]]+)$| ) {
        ## no port : the official sync port ##
        ( $host, $port ) = ( $1, <nameserv.cfg.sync.port> // 7753 );
    } else {
        <[base.logs]>->( 0, ': sync peer not understood : %s', $token );
        next;
    }

    $peers->{$token} //= {
        host    => $host,
        port    => $port,
        ts      => <[nameserv.sync.ts-oldest]>,    ## valid, older than all ##
        backoff => 13,
        state   => qw| idle |,
        sock    => undef,
        watcher => undef,
        timer   => undef,
        buf     => '',
    };

    <[nameserv.sync.peer.arm]>->($token);
}

## peers no longer configured : end their loop -- adding only kept a    ##
## renamed peer polling the old name next to the new one [ 2026-11-20 ] ##
my %wanted = map { $ARG => 1 } @tokens;
foreach my $token ( keys %{$peers} ) {
    next if $wanted{$token};
    <[nameserv.sync.peer.release]>->($token);
    my $timer = $peers->{$token}{'timer'};
    $timer->cancel
        if ref $timer
        and $timer->can('is_active')
        and $timer->is_active;
    delete $peers->{$token};
    <[base.logs]>->( 1, ': sync peer removed : %s', $token );
}

return TRUE;

