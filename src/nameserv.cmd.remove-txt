## [:< ##

# name  = nameserv.cmd.remove-txt
# descr = remove one txt value of a dns name [ acme dns-01 ]

my $args_str = $call->{'args'} // '';

## positional args: <fqdn> <value> -- an empty value never matches, it is
## refused outright [ removal of all values is never implied ]
my @parts = grep {length} split m|\s+|, $args_str;

if ( scalar(@parts) != 2 ) {
    return { mode => 'false', data => 'usage: remove-txt <fqdn> <value>' };
}

my $fqdn  = lc $parts[0];
my $value = $parts[1];

$fqdn =~ s{\.+$}{};    ## strip optional trailing dot

if ( not $fqdn or not $value ) {
    return { mode => 'false', data => 'usage: remove-txt <fqdn> <value>' };
}

## longest loaded zone suffixing the fqdn on a label boundary ##
my ( $zone, $zone_name ) = <[nameserv.zone.lookup]>->($fqdn);

if ( not defined $zone ) {
    return { mode => 'false', data => "no matching zone for: $fqdn" };
}

## remove only records matching name + type + value, tombstoning each ##
## removed one                                                        ##
my $orig_count = scalar @{ $zone->{'records'} };

my @kept = ();
for my $rec ( @{ $zone->{'records'} } ) {
    my $match = lc( $rec->{'name'} // '' ) eq $fqdn;
    $match &&= ( $rec->{'type'}  // '' ) eq 'TXT';
    $match &&= ( $rec->{'value'} // '' ) eq $value;
    if ($match) {
        <[nameserv.zone.tombstone.add]>->( $zone_name, $rec );
    } else {
        push @kept, $rec;
    }
}
$zone->{'records'} = \@kept;

my $removed = $orig_count - scalar @{ $zone->{'records'} };

if ( $removed == 0 ) {
    ## idempotent cleanup : the value is gone either way
    my $msg = sprintf "txt value not present: %s", $fqdn;
    return { mode => 'true', data => $msg };
}

$zone->{'serial'} = time();

<[nameserv.zone.save]>->($zone_name);

my $msg = sprintf "txt value removed: %s", $fqdn;
return { mode => 'true', data => $msg };

