## [:< ##

# name  = clients.http.handler.timeout
# descr = fired when http request exceeds timeout : cleans up and signals error

my $state = shift->w->data;

return if not defined $state->{'sock'};    ## already completed ##

<[base.logs]>->( 0, 'clients.http.handler.timeout: request timed out' );
<[clients.http.cleanup]>->($state);

$code{ $state->{'on_done'} }->(
    {   'ok'     => FALSE,
        'error'  => 'timeout',
        'params' => $state->{'params'},
    }
);

