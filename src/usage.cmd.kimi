## [:< ##

# name  = usage.cmd.kimi
# descr = current kimi plan usage [ parsed numbers only ]
# param = [ compact | details ]

my $args_str = $call->{'args'} // '';

my $format
    = $args_str =~ m{\bcompact\b}i ? qw| compact |
    : $args_str =~ m{\bdetails\b}i ? qw| box |
    :                                qw| pretty |;

my $query = <[usage.query]>->( [qw| kimi |], $call->{'reply_id'}, $format );

## a query that never started answers here, otherwise the reply travels ##
## back through usage.complete_query                                    ##
return $query if ref $query eq qw| HASH |;

return { 'mode' => qw| deferred | };

