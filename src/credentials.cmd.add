## [:< ##

# name  = credentials.cmd.add
# descr = add a new credential entry (password via nshell prompt,
#         encrypted at rest using archive format)

my $args = $call->{'args'} // '';

return { 'mode' => qw| false |, 'data' => 'missing arguments' }
    unless length $args;

## parse: name url username type zenka_list ##
my ( $name, $url, $username, $type, $zenka_list ) = split m|\s+|, $args, 5;

return { 'mode' => qw| false |, 'data' => 'missing credential name' }
    unless length $name;
return { 'mode' => qw| false |, 'data' => 'missing url' }
    unless length $url;
return { 'mode' => qw| false |, 'data' => 'missing username' }
    unless length $username;
return { 'mode' => qw| false |, 'data' => 'missing type' }
    unless length $type;
return {
    'mode' => qw| false |,
    'data' => 'missing authorized zenki list'
    }
    unless length $zenka_list;

my @authorized_zenki = split m|,|, $zenka_list;

my %valid_types
    = map { $ARG => 1 } qw| web-session api-key smtp imap ssh-key |;
return { 'mode' => qw| false |, 'data' => "invalid type '$type'" }
    unless exists $valid_types{$type};

## prompt for password via nshell ##
<[base.perlmod.load]>->('AMOS7::TERM')
    if not <[base.perlmod.loaded]>->('AMOS7::TERM');

my $password = AMOS7::TERM::read_password_single( 'credential password',
    sprintf( "adding credential '%s'", $name ) );

return { 'mode' => qw| false |, 'data' => 'password input cancelled' }
    unless defined $password and length $password;

## build credential entry ##
my $cred = {
    'name'             => $name,
    'url'              => $url,
    'username'         => $username,
    'password'         => $password,
    'type'             => $type,
    'authorized_zenki' => \@authorized_zenki,
};

## type-specific fields ##
if ( $type eq qw| api-key | ) {
    $cred->{'key'} = $password;
    delete $cred->{'password'};
} elsif ( $type =~ m{^(smtp|imap)$} ) {
    $cred->{'host'} = $url;
}

## save encrypted archive ##
my $saved = <[credentials.save]>->($cred);

return { 'mode' => qw| false |, 'data' => 'failed to save credential' }
    unless $saved;

## clear password from memory ##
$password = '';
undef $password;

return {
    'mode' => qw| true |,
    'data' => "credential '$name' stored"
};

