## [:< ##

# name  = osf-cache.cmd.rescan
# descr = start a sliced holdings rescan unless one is running
# param = [ none ]
#
# resets the scan progress and arms the rescan timer [ the first tick
# does the setup : work list, previous state, counters ]. when a scan
# is already running the command says so and leaves it alone - a
# rescan is never duplicated.

my $scan = <osf-cache.scan> // {};

if ( $scan->{'running'} ) {
    my $done
        = ( $scan->{'total'} // 0 ) - scalar @{ $scan->{'pending'} // [] };
    return {
        'mode' => qw| true |,
        'data' => sprintf 'rescan already running [ %d of %d ]',
        $done, $scan->{'total'} // 0,
    };
}

<osf-cache.scan> = {
    'running' => 0,
    'done'    => 0,
    'total'   => 0,
    'started' => undef,
};

<osf-cache.scan.timer> = <[event.add_timer]>->(
    {   'after'   => 0,
        'handler' => qw| osf-cache.holdings.rescan_step |,
        'data'    => {},
    }
);

return {
    'mode' => qw| true |,
    'data' => 'rescan started',
};

