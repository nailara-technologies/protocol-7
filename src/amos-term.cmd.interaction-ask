# name  = amos-term.cmd.interaction-ask
# descr = ask user a question via interaction buffer

my $question = $call->{'args'} // '';

return {
    'mode'     => 'false',
    qw| data | => "usage: interaction-ask " . "<question>\n"
    }
    unless length $question;

my $attach_id = <[amos-term.interaction.ask]>->(
    $question, qw| amos-term.handler.interaction-deliver |
);

return {
    'mode'     => defined($attach_id) ? 'true' : 'false',
    qw| data | => defined $attach_id
    ? sprintf( "question pending [%s]\n", $attach_id )
    : "Error: interaction ask failed\n"
};

0;

