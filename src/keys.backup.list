## [:< ##

# name  = keys.backup.list
# param = [ <key_name> ]  optional filter
# descr = enumerate key-file backups [ created by keys.backup.create ],
#         newest first. ordering is always by the DECODED timestamp,
#         never by string/glob sort -- the base32 ntime encoding is
#         variable-length [ BER-packed ], so plain sort is not
#         guaranteed chronological.

my $name_filter = shift;    ##  optional  ##

my $key_vars_ref
    = length( $name_filter // '' )
    ? <[crypt.C25519.key_vars]>->($name_filter)
    : <[crypt.C25519.key_vars]>;

my $key_dir = $key_vars_ref->{'key_dir'};

## directories to scan : the resolved key dir [ root/ for a root-held   ##
## filter name ] and, only when running as root, the root key dir too [ ##
## host-root delegation ] -- a non-root process never opens root/       ##
my $root_key_dir = <[crypt.C25519.root_key_dir]> // '';
my @scan_dirs    = ($key_dir);

if ( length $root_key_dir ) {
    if ( $EFFECTIVE_USER_ID != 0 ) {
        return []    ## a root-held name : nothing readable here ##
            if $key_dir eq $root_key_dir;
    } elsif ( not length( $name_filter // '' ) and -d $root_key_dir ) {
        push @scan_dirs, $root_key_dir;
    }
}

my $backup_re = qr{ ^ ( [A-Z2-7]+ ) \. (.+) \. (secret|private|public) $ }x;

my @backups;
foreach my $path ( map { <[file.all_files]>->($ARG)->@* } @scan_dirs ) {
    ( my $basename   = $path ) =~ s|^.*/||;
    ( my $holder_dir = $path ) =~ s|/[^/]+$||;
    next if $basename !~ $backup_re;
    my ( $tstamp_b32, $key_name, $type ) = ( $1, $2, $3 );

    next
        if length( $name_filter // '' )
        and $key_name ne $name_filter;

    my $tstamp_unix = <[base.ntime.B32_2_unix]>->($tstamp_b32);

    push @backups,
        {
        qw| key_name    | => $key_name,
        qw| type        | => $type,
        qw| tstamp_b32  | => $tstamp_b32,
        qw| tstamp_unix | => $tstamp_unix,
        qw| path        | => $path,
        qw| holder      | =>
            ( length $root_key_dir and $holder_dir eq $root_key_dir )
        ? qw| root |
        : qw| user |,
        qw| basename    | => $basename,
        };
}

## newest first ##
@backups
    = sort { ( $b->{'tstamp_unix'} // 0 ) <=> ( $a->{'tstamp_unix'} // 0 ) }
    @backups;

return \@backups;

