## [:< ##

# name  = calc.val.eval_bigrat
# param = $node  [ a Math::Symbolic tree node ]
# descr = recursively evaluate a Math::Symbolic tree as an exact
#         Math::BigRat, if every node is rational-representable;
#         return undef if any node isn't [ caller falls back to
#         $formula->value ]

<[base.perlmod.autoload]>->('Math::BigRat');

my $node = shift;

return undef if not defined $node;

my $term_type = $node->term_type;

## [ constant -> BigRat ] ##
return Math::BigRat->new( $node->value )
    if $term_type == 1;    ## [ Math::Symbolic::T_CONSTANT ] ##

## [ only operators remain ] ##
return undef if $term_type != 0;    ## [ not Math::Symbolic::T_OPERATOR ] ##

my $op_type = $node->{type};

## [ addition ] ##
if ( $op_type == 0 ) {    ## [ Math::Symbolic::B_SUM ] ##
    my $result;
    for my $operand ( @{ $node->{operands} } ) {
        my $value = <[calc.val.eval_bigrat]>->($operand);
        return undef if not defined $value;
        $result = defined $result ? $result + $value : $value;
    }
    return $result;
}

## [ subtraction ] ##
elsif ( $op_type == 1 ) {    ## [ Math::Symbolic::B_DIFFERENCE ] ##
    my @values
        = map { <[calc.val.eval_bigrat]>->($ARG) } @{ $node->{operands} };
    return undef if grep { not defined $ARG } @values;
    my $result = shift @values;
    $result = $result - $ARG for @values;
    return $result;
}

## [ multiplication ] ##
elsif ( $op_type == 2 ) {    ## [ Math::Symbolic::B_PRODUCT ] ##
    my $result;
    for my $operand ( @{ $node->{operands} } ) {
        my $value = <[calc.val.eval_bigrat]>->($operand);
        return undef if not defined $value;
        $result = defined $result ? $result * $value : $value;
    }
    return $result;
}

## [ division ] ##
elsif ( $op_type == 3 ) {    ## [ Math::Symbolic::B_DIVISION ] ##
    my $left  = <[calc.val.eval_bigrat]>->( $node->{operands}[0] );
    my $right = <[calc.val.eval_bigrat]>->( $node->{operands}[1] );
    return undef if not defined $left or not defined $right;
    return undef if $right->is_zero;
    return $left / $right;
}

## [ unary negation ] ##
elsif ( $op_type == 4 ) {    ## [ Math::Symbolic::B_NEG ] ##
    my $value = <[calc.val.eval_bigrat]>->( $node->{operands}[0] );
    return undef if not defined $value;
    return -$value;
}

## [ exponentiation, integer exponents only ] ##
elsif ( $op_type == 7 ) {    ## [ Math::Symbolic::B_EXP ] ##
    my $base = <[calc.val.eval_bigrat]>->( $node->{operands}[0] );
    my $exp  = <[calc.val.eval_bigrat]>->( $node->{operands}[1] );
    return undef if not defined $base or not defined $exp;
    return undef if not $exp->is_int;
    return $base->copy->bpow( $exp->numerator );
}

return undef;

