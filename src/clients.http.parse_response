# name  = clients.http.parse_response
# descr = split http response : status, headers, body

my $raw = shift // '';

if ( $raw =~ m|\A(.*?)\r?\n\r?\n(.*)\z|s ) {
    my ( $header_section, $body ) = ( $1, $2 );
    my @lines       = split m|\r?\n|, $header_section;
    my $status_line = shift @lines;
    my ($status)    = ( $status_line // '' ) =~ m{HTTP/\d\.\d\s+(\d+)};
    my %headers;
    my %headers_multi;
    for my $line (@lines) {
        if ( $line =~ m|^([^:]+):\s*(.+)| ) {
            my $name = lc $1;
            $headers{$name} = $2;    ## last value wins, as before ##
            push( @{ $headers_multi{$name} }, $2 );    ## all values ##
        }
    }
    return {
        'status'        => ( $status // 0 ) + 0,
        'headers'       => \%headers,
        'headers_multi' => \%headers_multi,        ## repeated headers kept ##
        'body'          => $body
    };
}

return {
    'status'        => 0,
    'headers'       => {},
    'headers_multi' => {},
    'body'          => $raw
};

