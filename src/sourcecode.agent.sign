#\\\|SSM4FLW63JBDRI7624X5KRZ7R6AMPV3DYFFIX7X6RSOH4AIIZKL \ / AMOS7 \ YOURUM ::
#\[7]3OFADYVLLFIQACYWUBLLD54SORGYII6EP63F65OR2FP4AVHQRCAI 7  DATA SIGNATURE ::
