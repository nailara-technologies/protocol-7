## [:< ##

# name  = jobsite.cmd.delete
# descr = move jobs to the recoverable trash
# param = <job id> [ <job id> .. ]
# note  = the same step as the web's delete [ jobsite.job.trash ] ;
#         undo with jobsite.rescue <job id>

my @ids = grep {length} split m|[,\s]+|, $call->{'args'} // '';
return { 'mode' => qw| false |, 'data' => 'usage: delete <job id> [ .. ]' }
    if not @ids;

my @lines;
my $failed = 0;
foreach my $id (@ids) {
    my ( $ok, $why ) = <[jobsite.job.trash]>->($id);
    push( @lines, $ok ? "trashed : $id" : "not trashed : $id [ $why ]" );
    $failed++ if not $ok;
}
<[jobsite.state.persist]> if $failed < @ids;

return {
    'mode' => $failed ? qw| false | : qw| true |,
    'data' => join( "\n", @lines ) . "\n"
};

