## [:< ##

# name  = invoke-web.handler.fetch_reply
# descr = fetch-files reply for an autofetch download [ deferred mode ]

my $reply = shift                        // {};
my $name  = $reply->{'params'}->{'name'} // return;

my $entry = <invoke-web.missing_at_render>->{$name} // return;
my $fetch = $entry->{'fetch'}                       // {};

## cancel the watchdog [ timer objects live outside the persisted record ] ##
if ( defined <invoke-web.autofetch.timers>->{$name} ) {
    <invoke-web.autofetch.timers>->{$name}->cancel;
    delete <invoke-web.autofetch.timers>->{$name};
}

## verified download [ lfs sha256 checked by fetch-files ] : move it to the ##
## db path and re-queue the failed item[s]                                  ##
if ( uc( $reply->{'cmd'} // '' ) eq qw| TRUE | ) {
    <[invoke-web.fetch_finalize]>->($name);
    return;
}

$fetch->{'state'} = qw| failed |;
$fetch->{'reason'}
    = sprintf( 'download failed : %s', $reply->{'data'} // 'unknown error' );
$fetch->{'time'} = <[base.time]>->(3);
<[invoke-web.missing.save]>;
<[base.logs]>->( 0, 'autofetch : %s : %s', $name, $fetch->{'reason'} );

return;

