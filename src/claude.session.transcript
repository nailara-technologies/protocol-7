## [:< ##

# name   = claude.session.transcript
# descr  = this host's transcript of a held session
# args   = session id
# return = path, or undef [ no hold : nothing to check ]

my $id  = shift;
my $dir = <[claude.var_dir]>;
return undef if not defined $dir or not -f "$dir/hold.$id.cfg";
my $at = <[claude.session.project_dir]>;
return defined $at->{'error'} ? undef : "$at->{'dir'}/$id.jsonl";

