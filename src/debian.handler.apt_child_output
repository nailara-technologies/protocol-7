## [:< ##

# name  = debian.handler.apt_child_output
# descr = event I/O handler : accumulate apt child output per-line, complete
#         the current install job on the terminating '< <exit_code>' line
#         [ the '= ok=..' result line before it names failed \ manual ]

my $event        = shift->w;
my $handler_data = $event->data;
my $job_id       = $handler_data->{'job_id'};

my $current = <debian.apt_child.current_job>;

## stale watcher guard : cancel if the job was replaced or cleared ##
if ( not defined $current or ( $current->{'job_id'} // 0 ) != $job_id ) {
    $event->cancel if $event->is_active;
    return;
}

## read available output [ non-blocking ] ##
my $bytes = <[base.s_read]>->( $event->fd, \$handler_data->{'buffer'}, 4096 );

## process complete lines : '> ..' is install output, '= ok=.. failed=.. ##
## manual=..' the backend's result, '< N' terminates the job -- keep     ##
## listening across multiple '>' lines of one install                    ##
## [ wire format : AMOS7::deps::root_runner ]                            ##
my $exit_code;
while ( $handler_data->{'buffer'} =~ s|^([^\n]*)\n|| ) {
    my $line = ${^CAPTURE}[0];
    if ( $line =~ m|^< (\d+)$| ) {
        $exit_code = ${^CAPTURE}[0] + 0;
        last;
    }
    if ( my $result = AMOS7::deps::root_runner::parse_result($line) ) {
        $handler_data->{'result'} = $result;
        next;
    }
    $line =~ s|^> ||;
    <[base.logs]>->( 1, 'apt: %s', $line ) if length $line;
}

## EOF without exit line : child died mid-job [ kill 0 guard against        ##
## spurious 0-byte reads on live pipes, same as monitor_inference_startup ] ##
if ( not defined $exit_code and $bytes <= 0 ) {
    my $child_pid = <debian.apt_child.pid> // 0;
    return if $child_pid and kill( 0, $child_pid );    ## alive : stay ##
    <[base.logs]>->(
        0, 'apt_child_output: ' . 'child exited mid-job %d', $job_id
    );
    $exit_code = 255;
}

return if not defined $exit_code;    ## not done yet : watcher stays armed ##

##[ job completion ]##########################################################

my $packages = $current->{'packages'} // [];
my $reply_id = $current->{'reply_id'};
my $result   = $handler_data->{'result'} // {};

## what did not install, by the backend's own result                      ##
## [ an exit without a result line : the whole request counts as failed ] ##
my @failed = @{ $result->{'failed'} // [] };
my @manual = @{ $result->{'manual'} // [] };
@failed = @$packages if $exit_code != 0 and not @failed and not @manual;

my $detail = join ' ; ',
    grep {length} (
    @failed ? sprintf( 'failed : %s', join( ' ', @failed ) ) : '',
    @manual ? sprintf( 'manual : %s', join( ' ', @manual ) ) : ''
    );

if ( $exit_code == 0 ) {
    <[base.logs]>->( 1, ':. successfully installed.' );
    <[jobqueue.move_job]>->( $job_id, qw| completed | );
} else {
    <[base.logs]>->(
        0,          '  ✗ install exited with code %d [ %s ]',
        $exit_code, $detail
    );
    <[jobqueue.move_job]>->( $job_id, qw| error | );
}

## resolve deferred caller [ cross-zenka replies flow back through the      ##
## existing cube route - no separate reply command or grant needed ] -- all ##
## or nothing, as the reply handlers of sys-deps \ os-pkg read              ##
if ( defined $reply_id ) {
    <[base.callback.cmd_reply]>->(
        $reply_id,
        $exit_code == 0
        ? { 'mode' => qw| true |,
            'data' => sprintf( 'installed : %s', join( ' ', @$packages ) )
            }
        : { 'mode' => qw| false |,
            'data' => sprintf(
                'install failed [ exit %d ] : %s [ %s ]',
                $exit_code, join( ' ', @$packages ), $detail
            )
        }
    );
}

## genuinely done with this job : cancel watcher, release the serialization ##
## slot, then advance the queue [ writes the next job's 'install ..' line ] ##
$event->cancel if $event->is_active;
<debian.apt_child.current_job> = undef;

## restore idle-shutdown tracking                                           ##
## [ paired with debian.job.apt_install's pause ] -- if apt_pump            ##
## immediately starts another queued job, that job re-pauses on its own, so ##
## this is always safe to run first                                         ##
<[base.zenki.resume_ondemand_timeout]>;

<[debian.apt_pump]>;

return;

