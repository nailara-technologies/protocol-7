# name  = model_batch.manifest.diff
# descr = diff two manifests : changed / added / removed path lists
# param = <baseline-href> <current-href> -> <diff-href>

my $baseline_href = shift // {};
my $current_href  = shift // {};

my ( @changed, @added, @removed );

for my $path ( sort keys $baseline_href->%* ) {
    my $base_sum = $baseline_href->{$path} // '';
    if ( !exists $current_href->{$path} ) {
        push @removed, $path;
    } elsif ( ( $current_href->{$path} // '' ) ne $base_sum ) {
        push @changed, $path;
    }
}

for my $path ( sort keys $current_href->%* ) {
    push @added, $path unless exists $baseline_href->{$path};
}

return {
    qw| changed | => \@changed,
    qw| added   | => \@added,
    qw| removed | => \@removed,
};

