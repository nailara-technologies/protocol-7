## [:< ##

# name  = mpv.cmd.clear-profile
# param = [caller]
# descr = clear saved window position profile [both sides]

my $args   = $call->{'args'} // '';
my $caller = length($args) ? $args : ( <mpv.startup.caller> // '' );

return { 'mode' => 'false', 'data' => 'caller name required' }
    if not length $caller;

## clear local mpv copy ##
my $result = <[window.profile.delete]>->($caller);

## clear window-place's copy — fire and forget ##
<[protocol-7.route-send]>->(
    {   'command'   => 'window-place.clear-profile',
        'call_args' => { 'args' => sprintf 'caller=%s', $caller }
    }
);

return {
    'mode' => ( defined $result and $result ) ? 'true' : 'false',
    'data' => ( defined $result and $result )
    ? sprintf( 'profile cleared [caller=%s]',        $caller )
    : sprintf( 'no local profile found [caller=%s]', $caller )
};

