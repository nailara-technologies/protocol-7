# name  = discover.cmd.inject-orbital
# param = <hostname> <pkey_b32> <p7ref>
# descr = inject a fake orbital node for visualization testing

my $args = $call->{'args'} // '';

my ( $hostname, $pkey_b32, $p7ref ) = split m| +|, $args, 3;

return { 'mode' => qw| false |, 'data' => 'usage: hostname pkey_b32 p7ref' }
    unless defined $hostname
    and length $hostname
    and defined $pkey_b32
    and length $pkey_b32
    and defined $p7ref
    and length $p7ref;

my $result
    = <[discover.orbital.store_remote]>->( $hostname, $pkey_b32, $p7ref );

return {
    'mode' => qw| false |,
    'data' => 'injection failed (invalid pkey?)'
    }
    unless $result;

return { 'mode' => qw| size |, 'data' => "orbital node injected: $hostname" };

