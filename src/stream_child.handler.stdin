## [:< ##

# name  = stream_child.handler.stdin
# descr = the child's stdin is writable : drain the queue

my $event  = shift->w;
my $handle = ( $event->data // {} )->{'handle'};
if ( not defined $handle or not defined $handle->{'in'} ) {
    $event->cancel if $event->is_active;
    return;
}
<[stream_child.flush]>->($handle);

