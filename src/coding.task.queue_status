## [:< ##

# name = coding.task.queue_status
# descr = get status of specific task or queue statistics
# purpose = Queue operation: Report task|queue state

my $task_id = shift;

# Get persistent storage refs
my $queue_href     = <coding.task.queue>     //= {};
my $aref_pending   = <coding.task.pending>   //= [];
my $aref_active    = <coding.task.active>    //= [];
my $aref_completed = <coding.task.completed> //= [];
my $aref_failed    = <coding.task.failed>    //= [];

# If specific task requested
if ( defined $task_id ) {
    return {
        success => FALSE,
        error   => "task not found : '$task_id'"
        }
        unless exists $queue_href->{$task_id};

    my $task = $queue_href->{$task_id};

    return {
        success   => TRUE,
        task_id   => $task_id,
        status    => $task->{'execution'}->{'status'},
        started   => $task->{'execution'}->{'started'},
        completed => $task->{'execution'}->{'completed'},
        result    => $task->{'execution'}->{'result'},
        success   => $task->{'execution'}->{'success'}
    };
}

# Return general queue statistics
my $in_progress = scalar( $aref_active->@* );
my $completed   = scalar( $aref_completed->@* );
my $pending     = scalar( $aref_pending->@* );
my $failed      = scalar( $aref_failed->@* );

return {
    total_tasks   => scalar( keys $queue_href->%* ),
    pending       => $pending,
    in_progress   => $in_progress,
    completed     => $completed,
    failed        => $failed,
    queue_updated => <[base.ntime]>
};

