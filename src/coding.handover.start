## [:< ##

# name  = coding.handover.start
# descr = after a start : arm watches, ask sources

## a timer handler [ gets the event, not used ] : the state is rebuilt from ##
## its sources, nothing of it is kept on disk                               ##

<coding.handover.state> = { 'source' => {}, 'watch' => {}, 'signal' => {} };
<[coding.handover.arm]>->($ARG)
    foreach sort keys <[coding.handover.watch]>->()->%*;
<[coding.handover.refresh]>;
return TRUE;

