## [:< ##

# name  = letsencr.child.acme.step_authz
# param = <order_id>
# descr = fetch the next authorization, then set them all up

my $order = <[letsencr.child.acme.order_of]>->( shift, qw| authz | )
    // return FALSE;

my $url = shift $order->{'todo'}->@*;

return <[letsencr.child.acme.step_setup]>->( $order->{'order_id'} )
    if not defined $url;

<[letsencr.child.acme.request]>->(
    {   'method'   => qw| POST-as-GET |,
        'url'      => $url,
        'order_id' => $order->{'order_id'},
        'on_done'  => qw| letsencr.child.acme.on_authz |,
        'params'   => { 'order_id' => $order->{'order_id'}, 'authz' => $url },
    }
);

return TRUE;

