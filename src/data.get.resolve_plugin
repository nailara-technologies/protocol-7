# name = data.get.resolve_plugin
# desc: Resolve plugin namespace paths

my ( $path, $args, $classification ) = @ARG;
my $handler = $classification->{'handler'};

# Plugin loading logic - simplified for now
my $core_fallback = $path;
$core_fallback =~ s|^plugin\.|data.|;

my $module_path = <[data.get.path_to_module]>->($core_fallback);
if ( -f $module_path ) {
    my $result = <[devmod.cmd.get]>->( $core_fallback, @$args );
    return {
        'value'       => $result,
        'module_path' => $module_path,
        'source'      => 'plugin_fallback',
    };
}

return {
    'value'    => undef,
    'error'    => 'plugin_not_found',
    'fallback' => $core_fallback
};

