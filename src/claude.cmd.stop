## [:< ##

# name  = claude.cmd.stop
# descr = end the claude code process [ the session is kept ]

CORE::splice( @{ <claude.queue> //= [] } );
if ( not <[claude.child.stop]> ) {
    <[claude.session.hold]>->( qw| release |, <claude.session> )
        if not <[claude.session.running]>;
    return { 'mode' => qw| false |, 'data' => 'claude is not running' };
}
return {
    'mode' => qw| true |,
    'data' => 'claude stopping [ session '
        . ( <claude.session> // '-' ) . ' ]'
};

