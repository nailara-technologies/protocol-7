## [:< ##

# name = nodes.init_code

<[base.perlmod.autoload]>->('Net::IP::Lite');
<[base.perlmod.autoload]>->('IO::Socket::IP');

##  1.42 x interval delay  ##
##[  ,..until host offline status is accepted \ applied  ]##
<nodes.local-network.offline_status_timeout> //= 44 * 1.42;

<nodes.cfg.host_details_command> //= qw| cube.discover.host_details |;

##  orbital STRM push : disable in zenki/nodes/zenka.v7 when required  ##
##
<nodes.cfg.orbital_push_enabled> //= TRUE;

## position has no discrete mutation event [ time-derived ] : poll our own ##
## listeners on a slow timer instead, gated to a no-op when nobody is      ##
## subscribed                                                              ##
<[event.add_timer]>->(
    {   qw| interval | => 45,
        qw| repeat   | => TRUE,
        qw| handler  | => qw| nodes.orbital.push_position_if_subscribed |,
    }
);

<nodes.local-network.online-hosts> //= {};

<list.lan-nodes> = {    ## todo : repair 'sort_key' param for '<key>' case ##
    'var'   => qw| data |,
    'key'   => qw| nodes.local-network.online-hosts |,
    'descr' => 'account group table',
    'mask'  => '<key>:host ip_addr:ip_address hwaddr pkey:host_key',
    'align' => {
        qw| pkey  |   => qw| left+2  |,
        qw| host  |   => qw| right-2 |,
        qw| ip_addr | => qw| left+2  |,
        qw| hwaddr |  => qw|  left   |,
        qw| pkey  |   => qw|  left   |,
    },
    'filters' => {
        qw| pkey |   => qw| base.parser.key_mem_chksum |,
        qw| hwaddr | => qw| base.parser.hwaddr |,
    },
    'descr' => 'protocol 7 nodes online in local network'
};

<[base.list.init]>->(
    {   'name'         => qw| lan-nodes |,
        'key_ref'      => \$data{'nodes'}{'local-network'}{'online-hosts'},
        'max_elements' => 247
    }
);

<nodes.trunc>        //= {};
<nodes.remote-nodes> //= {};    ## Remote nodes with TOFU pinning status ##
<nodes.group.by-id>  //= {};

<list.truncs> = {
    'var'      => qw| data |,
    'key'      => qw| nodes.trunc |,
    'sort_key' => 'alpha-len:name',
    'descr'    => 'protocol 7 node set-up',
    'mask'     => 'name:trunc_node addr:node_address '
        . 'pkey:public_key tofu:pinning_status',
    'align' => {
        'name' => 'right-2',
        'addr' => 'center',
        'pkey' => 'left+4',
        'tofu' => 'center'
    },
    'filters' => { 'pkey' => qw| nodes.parser.node_pkey |, }
};

<list.remote-nodes> = {
    'var'      => qw| data |,
    'key'      => qw| nodes.remote-nodes |,
    'sort_key' => 'alpha-len:node_name',
    'descr'    => 'remote nodes with TOFU pinning and authorization status',
    'mask'     => 'node:node_name host:remote_host port:node_port '
        . 'status:pinning_status auth:auth_status '
        . 'pinned:timestamp_pinned',
    'align' => {
        'node'   => 'right-2',
        'host'   => 'left+2',
        'port'   => 'center-1',
        'status' => 'center',
        'auth'   => 'center',
        'pinned' => 'left+1'
    },
    'filters' => {
        'status' => qw| base.parser.tofu_status |,
        'auth'   => qw| base.parser.auth_status |,
        'pinned' => qw| base.parser.timestamp_short |
    }
};

<[base.list.init]>->(
    {   'name'         => qw| truncs |,
        'key_ref'      => \$data{'nodes'}{'trunc'},
        'max_elements' => 4097
    }
);

<[base.list.init]>->(
    {   'name'         => qw| remote-nodes |,
        'key_ref'      => \$data{'nodes'}{'remote-nodes'},
        'max_elements' => 4097
    }
);

<list.groups> = {
    'var'      => qw| data |,
    'key'      => qw| nodes.group.by-id |,
    'sort_key' => 'alpha-len:name',
    'descr'    => 'account group table',
    'mask'     => 'name:group_name regex:account_regex',
    'align'    => { 'name'  => 'center', 'regex' => 'left+1' },
    'filters'  => { 'regex' => 'base.parser.quoted' }
};

<[base.list.init]>->(
    {   'name'         => qw| groups |,
        'key_ref'      => \$data{'nodes'}{'group'}{'by-id'},
        'max_elements' => 247
    }
);

0;

