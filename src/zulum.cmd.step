## [:< ##

# name  = zulum.cmd.step
# descr = Run one entropy generation cycle on specified stream
# param = [stream_id]

my $params = shift // {};
my $stream_id = $params->{'stream_id'} // $params->{'args'} // 1;

## Validate stream ID ##
return {
    'mode' => qw| false |,
    'data' => "stream_id must be 1-13, got: $stream_id"
    }
    unless $stream_id >= 1 && $stream_id <= 13;

## Run one entropy generation cycle ##
my $result
    = <[zulum.loop.generate_entropy]>->( { 'stream_id' => $stream_id } );

if ( $result->{'mode'} eq qw| true | ) {
    my $data = $result->{'data'};
    return {
        'mode' => qw| true |,
        'data' => sprintf(
            "stream %d: iteration %d, entropy %s... (%d bits)",
            $data->{'stream_id'},
            $data->{'iteration'},
            substr( $data->{'entropy'}, 0, 16 ),
            length( $data->{'entropy'} )
        )
    };
} else {
    return $result;
}

