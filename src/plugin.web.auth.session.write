## [:< ##

# name  = plugin.web.auth.session.write
# descr = write session data by token_hash
# param = token_hash string, session hashref

my $token_hash = shift // '';
my $session    = shift;

return FALSE if not length $token_hash;
return FALSE if ref $session ne qw| HASH |;

my $session_base = <[plugin.web.auth.session.path]>;
my $dir          = "$session_base/active/$token_hash";
my $file         = "$dir/session.yaml";

if ( not -d $dir ) {
    my $user  = <system.amos-zenka-user> // qw| protocol-7 |;
    my $group = <[plugin.web.auth.store.group]>;
    <[file.make_path]>->( $dir, 02770, $user, $group );
}

my $yaml_str = eval { YAML::XS::Dump($session) };
if ($@) {
    <[base.s_warn]>->(
        'plugin.web.auth.session.write : yaml dump error [ %s ] : %s',
        $token_hash, $@
    );
    return FALSE;
}

## direct write -- the shared store is zenka-independent [ web mints,       ##
## httpd/httpsd touch last_seen on verify : both must read and write ] 0660 ##
## as below : file.open chmods a file whose mode differs, and only the      ##
## owner may -- httpsd updating a session the web zenka minted got EPERM,   ##
## its open failed and no login could record its session [ 2026-10-23 ]     ##
my $fh = <[file.open]>->( $file, qw| :raw |, qw| > |, TRUE, 0660 );
if ( not defined $fh ) {
    <[base.s_warn]>->(
        'plugin.web.auth.session.write : open failed [ %s ]', $file
    );
    return FALSE;
}
print {$fh} $yaml_str;
close($fh)
    or <[base.s_warn]>->('plugin.web.auth.session.write : close error');

## umask-proof : readers run as other uid [ httpd, httpsd ] -- the file    ##
## MUST be group-readable/writable regardless of the writer's umask.  only ##
## when it is not yet : a chmod by a non-owner is EPERM even to the same   ##
## mode [ CORE::stat : File::stat is imported ]                            ##
my $file_mode = ( CORE::stat $file )[2] // 0;
if ( ( $file_mode & 07777 ) != 0660 and not chmod 0660, $file ) {
    <[base.s_warn]>->(
        'plugin.web.auth.session.write : chmod 0660 failed [ %s ]', $file
    );
}

return TRUE;

