## [:< ##

# name  = plugin.web.auth.session.write
# descr = write session data by token_hash
# param = token_hash string, session hashref

my $token_hash = shift // '';
my $session    = shift;

return FALSE if not length $token_hash;
return FALSE if ref $session ne qw| HASH |;

my $session_base = <[plugin.web.auth.session.path]>;
my $dir          = "$session_base/active/$token_hash";
my $file         = "$dir/session.yaml";

if ( not -d $dir ) {
    my $user  = <system.amos-zenka-user> // qw| protocol-7 |;
    my $group = <[plugin.web.auth.store.group]>;
    <[file.make_path]>->( $dir, 02770, $user, $group );
}

my $yaml_str = eval { YAML::XS::Dump($session) };
if ($@) {
    <[base.s_warn]>->(
        'plugin.web.auth.session.write : yaml dump error [ %s ] : %s',
        $token_hash, $@
    );
    return FALSE;
}

## atomic replace : readers and rollback see intact-old or intact-new,    ##
## never a truncated session ; the temp file stays on the same filesystem ##
state $write_sequence = 0;
my $tmp_file = join '', $file, qw| .tmp- |, $PROCESS_ID, '-',
    ++$write_sequence;
my $fh = <[file.open]>->( $tmp_file, qw| :raw |, qw| > |, TRUE, 0660 );
if ( not defined $fh ) {
    <[base.s_warn]>->(
        'plugin.web.auth.session.write : open failed [ %s ]', $tmp_file
    );
    return FALSE;
}
if ( not print {$fh} $yaml_str ) {
    <[base.s_warn]>->('plugin.web.auth.session.write : print error');
    close($fh);
    unlink($tmp_file);
    return FALSE;
}
if ( not close($fh) ) {
    <[base.s_warn]>->('plugin.web.auth.session.write : close error');
    unlink($tmp_file);
    return FALSE;
}

## umask-proof : readers run as other uid [ httpd, httpsd ]                 ##
my $file_mode = ( CORE::stat $tmp_file )[2] // 0;
if ( ( $file_mode & 07777 ) != 0660 and not chmod 0660, $tmp_file ) {
    <[base.s_warn]>->(
        'plugin.web.auth.session.write : chmod 0660 failed [ %s ]', $tmp_file
    );
    unlink($tmp_file);
    return FALSE;
}

if ( not rename( $tmp_file, $file ) ) {
    <[base.s_warn]>->(
        'plugin.web.auth.session.write : rename failed [ %s ] : %s',
        $file, <[base.str.os_err]>
    );
    unlink($tmp_file);
    return FALSE;
}

return TRUE;

