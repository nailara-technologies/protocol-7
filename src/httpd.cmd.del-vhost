## [:< ##

# name = httpd.cmd.del-vhost
# descr = remove virtual host directory or symlink

my $args        = $call->{'args'} // '';
my @args        = split m{\ +}, $args;
my $domain      = $args[0];
my $backup_mode = grep {m{^:backup:$}} @args;

unless ($domain) {
    return {
        'mode' => qw| false |,
        'data' => 'domain parameter required'
    };
}

<[base.logs]>->( 2, ': removing vhost for domain : %s', $domain );

## Configuration
my $site_dir   = <httpd.site_dir> // qw| /var/httpd |;
my $backup_dir = join qw| / |, $site_dir, qw| .vhost-backup |;

## Paths
my $vhost_path = join qw| / |, $site_dir, $domain;

## Check if vhost exists
unless ( -e $vhost_path ) {
    <[base.logs]>->( 1, 'vhost not found : %s', $domain );

    return {
        'mode' => qw| false |,
        'data' => sprintf "vhost '%s' does not exist",
        $domain
    };
}

my @actions = ();
my $symlink_error;
my $backup_path;

## Step 1: Remove vhost directory or symlink
if ( -l $vhost_path ) {
    <[base.logs]>->( 2, 'removing vhost symlink : %s', $vhost_path );

    if ( unlink($vhost_path) ) {
        push @actions, qw| symlink_removed |;
    } else {
        <[base.logs]>->(
            0, 'failed to remove symlink : %s',
            <[base.str.os_err]>
        );
        push @actions, qw| symlink_remove_failed |;
        $symlink_error = <[base.str.os_err]>;
    }
} elsif ( -d $vhost_path ) {
    ## Check if directory is empty
    my $dirh;
    my @entries;
    if ( opendir $dirh, $vhost_path ) {
        @entries
            = grep { $ARG ne qw| . | and $ARG ne qw| .. | } readdir $dirh;
        closedir $dirh;
    } else {
        ## Cannot read directory - assume not empty if no backup mode
        @entries = ('unknown') unless $backup_mode;
    }

    if ( @entries && !$backup_mode ) {
        return {
            'mode' => qw| false |,
            'data' => 'vhost directory is not empty, use '
                . ':backup: parameter to move to backup',
            'domain' => $domain
        };
    }

    if ($backup_mode) {
        ## Create backup directory if needed
        unless ( -d $backup_dir ) {
            <[file.make_path]>->( $backup_dir, 0750 )
                or return {
                'mode' => qw| false |,
                'data' => 'failed to create backup directory'
                };
            push @actions, qw| backup_dir_created |;
        }

        ## Get network timestamp and move directory to backup
        my $timestamp   = <[base.ntime.b32]>;
        my $backup_name = sprintf '%s,%s', $timestamp, $domain;
        $backup_path = join qw| / |, $backup_dir, $backup_name;

        <[base.logs]>->( 2, 'moving vhost to backup : %s', $backup_path );

        if ( rename( $vhost_path, $backup_path ) ) {
            push @actions, qw| directory_backed_up |;
        } else {
            <[base.logs]>->(
                0, 'failed to move vhost to backup : %s',
                <[base.str.os_err]>
            );
            push @actions, qw| backup_failed |;
        }
    } elsif ( <[httpd.path.remove_vhost_dir]>->($vhost_path) ) {
        push @actions, qw| directory_removed |;
    } else {
        <[base.log]>->( 0, 'failed to remove vhost directory' );
        push @actions, qw| directory_remove_failed |;
    }
}

## Step 2: Remove from vhost registry
my $vhost_id = <httpd.vhosts.by_domain>->{$domain};

if ( defined $vhost_id && exists <httpd.vhosts.registry>->{$vhost_id} ) {
    <[base.logs]>->( 2, 'removing from vhost registry : id=%s', $vhost_id );

    delete <httpd.vhosts.registry>->{$vhost_id};
    delete <httpd.vhosts.by_domain>->{$domain};

    push @actions, qw| registry_removed |;
}

## Step 3: Remove from httpd.cfg.hostnames
if ( exists <httpd.cfg.hostnames>->{$domain} ) {
    <[base.logs]>
        ->( 2, 'removing from hostname configuration : %s', $domain );

    delete <httpd.cfg.hostnames>->{$domain};

    push @actions, qw| hostname_removed |;
}

## Step 4: Rescan site directory
<[base.logs]>->( 2, ':: rescanning site directory for %s', $domain );
<[httpd.scan_site_dir]>;

## Build result with actual status
my $result = {
    'mode'    => qw| true |,
    'data'    => 'vhost removed successfully',
    'domain'  => $domain,
    'actions' => \@actions
};

if ( defined $symlink_error ) {
    $result->{'symlink_error'} = $symlink_error;
}

if ( defined $backup_path ) {
    $result->{'backup_path'} = $backup_path;
}

<[base.logs]>->( 1, ': vhost removed successfully : %s', $domain );

return $result;

0;

