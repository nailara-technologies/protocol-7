# name  = invoke-web.handler.fetch_watchdog
# descr = clear a stuck autofetch fetch [ the reply never arrived ]

my $event = shift;
my $name  = eval { $event->w->data->{'name'} } // return;

delete <invoke-web.autofetch.timers>->{$name};

my $entry = <invoke-web.missing_at_render>->{$name} // return;
my $fetch = $entry->{'fetch'}                       // return;
return if ( $fetch->{'state'} // '' ) ne qw| fetching |;

$fetch->{'state'}  = qw| failed |;
$fetch->{'reason'} = 'the fetch reply never arrived [ timeout ]';
$fetch->{'time'}   = <[base.time]>->(3);
<[invoke-web.missing.save]>;
<[base.logs]>->( 0, 'autofetch : %s : %s', $name, $fetch->{'reason'} );

return;

