## [:< ##

# name   = invoke-web.session.store
# descr  = load \ save the parked render sessions [ state/parked-sessions ]
# param  = [ hashref to save ; none : load ]
# return = hashref { <name> => { parked_at, mode, items => { id => prio } } }
# note   = parked items sit at priority - <invoke-web.session.park_offset> ;
#          everything below half of it counts as parked [ queue-order and
#          session-park leave those alone ]

my $sessions = shift;

if ( defined $sessions ) {
    my $json = JSON::PP->new->canonical->pretty->encode($sessions);
    <[file.zenka_dir.write]>->( 'state/parked-sessions', \$json );
    return $sessions;
}

my $saved = <[file.zenka_dir.load]>->('state/parked-sessions');
return ( defined $saved ? eval { JSON::PP::decode_json( $saved->$* ) } : undef ) // {};

