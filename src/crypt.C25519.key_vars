## [:< ##

# name = crypt.C25519.key_vars

my $key_name     = shift;
my $key_path_opt = shift;    ## optional : { holder => 'root' } ##

<crypt.C25519.key_vars_error> //= TRUE;

return <crypt.C25519.key_vars>
    if defined <crypt.C25519.key_vars>
    and not defined $key_path_opt
    and (
    not defined $key_name
    or ( defined <crypt.C25519.base_key_name>
        and $key_name eq <crypt.C25519.base_key_name> )
    );

my $cur_usr = $ENV{'USER'} // getpwuid($EUID);

## Use explicitly set usr_name, or fall back to current user  Security: each
## process uses its own home directory for keys
my $key_usr = <crypt.C25519.usr_name> // $cur_usr;

## in case being not root 'key_usr' is intended to be current user ##
#
$key_usr = $cur_usr if $key_usr ne $cur_usr and $cur_usr ne qw| root |;

( my $uid, my $gid ) = ( getpwnam($key_usr) )[ 2, 3 ];

if ( defined $key_name ) {
    ## explicit-name lookup : must NEVER mutate base_key_name as a side   ##
    ## effect [ was: first explicit caller silently claimed the process's ##
    ## own identity -- the twice-confirmed base_key_name hijack bug ]     ##
} else {
    $key_name = <crypt.C25519.base_key_name>
        // join( qw| . |, $key_usr, qw| base | );
    <crypt.C25519.base_key_name> //= $key_name;  ## bare call sets identity ##
}

my $home_dir = <crypt.C25519.key_usr_home>
    //= <[base.get_homedir]>->($key_usr);

<[base.log]>->( 2, 'no home directory, C25519 initialization aborted .,' )
    and return { qw| usr_name | => $key_usr }
    if not defined $home_dir;

my $key_dir = <crypt.C25519.key_dir>
    //= sprintf( qw| %s/.n/user-keys |, $home_dir );

my $auth_dir = <crypt.C25519.auth_dir>
    //= sprintf( qw| %s/.n/remote-keys/authorized |, $home_dir );

## the host pins [ data/md/design/TRUST-CHAIN-STEP2.md 'pins' ] -- the pre ##
## host-root 'known/' TOFU store is retired                                ##
my $known_hosts_dir = <crypt.C25519.known_hosts_dir>
    //= sprintf( qw| %s/.n/remote-keys/servers |, $home_dir );

my $incoming_dir = <crypt.C25519.incoming_dir>
    //= sprintf( qw| %s/.n/remote-keys/incoming |, $home_dir );

## When running as root from console, allow non-existent key directories The
## directory will be created by chk_key_dir if needed  Only enforce
## readability if directory already exists
if ( not -d $key_dir ) {
    ## Directory doesn't exist yet - this is OK, can be created later Just
    ## verify parent directory is writable if it exists
    my $parent_dir = <[file.last_existing_dir_path]>->($key_dir);
    if (    $EFFECTIVE_USER_ID != 0
        and $parent_dir ne $key_dir
        and not -w $parent_dir ) {
        ## Non-root user: parent must be writable for directory creation
        <[base.s_warn]>->(
            "no write permissions to parent path [ %s ] <{C1}>", $parent_dir
        );
        return undef;
    }
} elsif ( not -r $key_dir ) {
    ## Directory exists but isn't readable - this is an error
    <[base.s_warn]>->(
        "no read permission to key dir ['%s'] <{C1}>", $key_dir
    );
    return undef;
}

my $key_file_ext = { map { $ARG => $ARG } qw|  secret  private  public  | };

## key file paths : ONLY from crypt.C25519.key_path [ user key dir or the   ##
## root-held root/ ; a refused root-held key is NOT looked up elsewhere ]   ##
## -- a path given instead of a name [ crypt.C25519.encrypted_key ] gets no ##
## key file paths at all                                                    ##
my $key_path_ref;
my $holder = qw| user |;
if ( index( $key_name, qw| / | ) == -1 ) {
    $key_path_ref = <[crypt.C25519.key_path]>->( $key_name, $key_path_opt );
    return undef if ref $key_path_ref ne qw| HASH |;    ## [ logged ] ##
    $holder = $key_path_ref->{'holder'};
}
my $key_basepath = $key_path_ref->{'key_basepath'};
my $key_filename = $key_path_ref->{'key_filename'};
$key_dir = $key_path_ref->{'key_dir'} if $holder eq qw| root |;

( $uid, $gid ) = ( 0, 0 ) if $holder eq qw| root |;    ## owner 0 ##

my $key_vars_ref = {
    'uid'             => $uid,
    'gid'             => $gid,
    'usr_name'        => $key_usr,
    'usr_home'        => $home_dir,
    'key_dir'         => $key_dir,
    'holder'          => $holder,
    'auth_dir'        => $auth_dir,
    'known_hosts_dir' => $known_hosts_dir,
    'incoming_dir'    => $incoming_dir,
    'key_name'        => $key_name,
    'key_basepath'    => $key_basepath,
    'key_file_ext'    => $key_file_ext,
    'key_filename'    => $key_filename
};

<crypt.C25519.key_vars> = $key_vars_ref  ## updating key_vars when base key ##
    if not defined $key_path_opt
    and $holder eq qw| user |
    and defined <crypt.C25519.base_key_name>
    and <crypt.C25519.base_key_name> eq $key_name;

<crypt.C25519.key_vars_error> = FALSE;

return $key_vars_ref;

