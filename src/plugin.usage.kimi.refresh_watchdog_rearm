# name  = plugin.usage.kimi.refresh_watchdog_rearm
# descr = on_done handler : re-arm the next proactive watchdog fire
# note  = after=>0, not a real delay -- refresh_cleanup only fires once the
#         refresh cycle has genuinely finished, so there's nothing to wait
#         for. still routed through event.add_timer rather than a direct
#         nested call, to stay on the same event-driven footing as every
#         other timer handler here

<[event.add_timer]>->(
    {   'after'   => 0,
        'handler' => qw| plugin.usage.kimi.refresh_watchdog |,
        'data'    => {},
    }
);

return TRUE;

