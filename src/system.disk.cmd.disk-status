## [:< ##

# name  = system.disk.cmd.disk-status
# descr = size, free space, inodes and fill trend per local mount

<[system.disk.poll]>;
my $bytes = sub {
    my $value = shift // 0;
    my @unit  = qw| B KiB MiB GiB TiB PiB |;
    my $unit  = 0;
    while ( abs($value) >= 1024 and $unit < $#unit ) {
        $value /= 1024;
        $unit++;
    }
    return sprintf( $unit ? '%.2f %s' : '%.0f %s', $value, $unit[$unit] );
};
my $duration = sub {
    my $seconds = shift;
    return qw| - | if not defined $seconds;
    return sprintf '%.0f s',   $seconds        if $seconds < 90;
    return sprintf '%.1f min', $seconds / 60   if $seconds < 5400;
    return sprintf '%.1f h',   $seconds / 3600 if $seconds < 187200;
    return sprintf '%.1f d',   $seconds / 86400;
};
my @paths = sort keys <system.disk.mounts>->%*;
return {
    qw| mode | => qw| size |,
    qw| data | => "no local file systems sampled\n"
    }
    if not @paths;
my $mount_width = length qw| MOUNT |;
foreach my $path (@paths) {
    $mount_width = length $path if length($path) > $mount_width;
}
my $format = join( ' ',
    "%-${mount_width}s", qw| %12s %12s %12s %7s %21s %12s %12s %9s | ) . "\n";
my $table = sprintf( $format,
    qw| MOUNT SIZE USED FREE FREE% |,
    qw| INODES_USED/TOTAL INODES_FREE TREND ETA | );
foreach my $path (@paths) {
    my $m = <system.disk.mounts>->{$path};
    my $trend
        = defined $m->{'rate'}
        ? sprintf( '%s/s', $bytes->( $m->{'rate'} ) )
        : qw| - |;
    $table .= sprintf( $format,
        $path,
        $bytes->( $m->{'size'} ),
        $bytes->( $m->{'used'} ),
        $bytes->( $m->{'free'} ),
        sprintf( '%.1f%%', $m->{'free_percent'} ),
        sprintf( '%d/%d',  $m->{'inodes_used'}, $m->{'inodes'} ),
        $m->{'inodes_free'},
        $trend,
        $duration->( $m->{'eta'} ) );
}
return { qw| mode | => qw| size |, qw| data | => $table };

