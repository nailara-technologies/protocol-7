## [:< ##

# name  = smtpd.classify
# descr = classify parsed mail intent, sentiment, action_required
# param = $parsed_hash (modified in place)
# note  = llm call optional : defaults apply if service offline

my $parsed = shift // {};
return $parsed if ref $parsed ne qw| HASH |;

my $text    = substr( $parsed->{'body_text'} // '', 0, 800 );
my $subject = $parsed->{'subject'} // '';
my $from    = $parsed->{'from'}    // '';

## build classification prompt ##
my $prompt
    = sprintf(
    "classify this email. respond with YAML only, no explanation.\n\nfrom: "
        . "%s\nsubject: %s\nbody:\n%s\n\nfields: summary (1 sentence), "
        . "intent, sentiment, action_required (true/false), action_type, "
        . "urgency",
    $from, $subject, $text );

## try llm subprocess wrapper if available ##
my $llm_result;
my $have_llm = eval {
    my $check = <[llm.service.subprocess_wrapper]>->(qw| check |);
    $check->{'success'};
};

if ($have_llm) {
    my $response = eval {
        <[llm.service.subprocess_wrapper]>->( qw| query |, 'qwen', $prompt );
    };
    if (    defined $response
        and ref $response eq qw| HASH |
        and $response->{'success'} ) {
        my $answer = $response->{'response'}{'answer'} // '';
        $llm_result = eval { YAML::XS::Load($answer) };
    }
}

## merge llm result or apply defaults ##
if ( defined $llm_result and ref $llm_result eq qw| HASH | ) {
    for my $k (
        qw| summary intent sentiment action_required action_type
        urgency |
    ) {
        $parsed->{$k} = $llm_result->{$k}
            if defined $llm_result->{$k};
    }
}

## keyword fallback for intent when llm unavailable or failed -- via the   ##
## shared pattern registry [ data/yaml/pattern-registry/smtpd-classify.    ##
## yaml ], same trigger position as the prior inline chain: only runs when ##
## the llm path above didn't already set intent                            ##
if ( not defined $parsed->{'intent'} ) {

    ## flatten to one line : the engine matches per-line after splitting on ##
    ## \n, but the prior inline chain relied on \s+ spanning embedded       ##
    ## newlines in one un-split string -- collapse whitespace first so a    ##
    ## phrase spanning a body line-break still matches                      ##
    ( my $flat = lc("$subject $text") ) =~ s|\s+| |g;

    my $result = <[base.pattern-registry.apply]>->(
        {   'input'     => $flat,
            'file_type' => 'mail',
            'namespace' => 'smtpd.classify'
        }
    );

    my $classified
        = ( ref $result eq qw| HASH | and $result->{'mode'} eq qw| true | )
        ? $result->{'data'}->{'classified'} // []
        : [];

    $parsed->{'intent'} = $classified->[0]->{'label'} if @$classified;
    $parsed->{'intent'} //= 'information';
}

## apply defaults for all classification fields ##
$parsed->{'intent'}          //= 'information';
$parsed->{'sentiment'}       //= 'neutral';
$parsed->{'action_required'} //= 0;
$parsed->{'action_type'}     //= 'none';
$parsed->{'urgency'}         //= 'normal';
$parsed->{'summary'}         //= $parsed->{'subject'} // '';

## derive action_required from intent if still unset ##
if ( not $parsed->{'action_required'}
    and $parsed->{'intent'}
    =~ m{^(interview_request|offer|document_request|reply)$} ) {
    $parsed->{'action_required'} = 1;
}

if (    $parsed->{'action_required'}
    and $parsed->{'action_type'} eq 'none' ) {
    if ( $parsed->{'intent'} eq 'interview_request' ) {
        $parsed->{'action_type'} = 'schedule_interview';
    } elsif ( $parsed->{'intent'} eq 'document_request' ) {
        $parsed->{'action_type'} = 'upload_cv';
    } elsif ( $parsed->{'intent'} eq 'reply' ) {
        $parsed->{'action_type'} = 'reply';
    } elsif ( $parsed->{'intent'} eq 'offer' ) {
        $parsed->{'action_type'} = 'review';
    }
}

return $parsed;

