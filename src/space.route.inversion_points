# name  = space.route.inversion_points
# descr = list inversion depths up to max_depth
# param = { max_depth }

my $params    = shift                  // {};
my $max_depth = $params->{'max_depth'} // 0;

my @points;
for ( my $d = 0; $d <= $max_depth; $d += 13 ) {
    push @points, $d;
}

return \@points;

