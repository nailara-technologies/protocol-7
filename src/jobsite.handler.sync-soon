## [:< ##

# name  = jobsite.handler.sync-soon
# descr = run or defer a scheduled web-cache sync push

<jobsite.sync.soon_timer> = undef;

if (<jobsite.sync.push_in_progress>) {
    <[jobsite.sync.push_soon]>;
} else {
    <[jobsite.sync.push]>;
}

