## [:< ##

# name  = storage.9p.umount
# descr = unmount 9P remote filesystem

## teardown : resolve a mount point [ as returned by storage.9p.mount ] to its
## connection, close the socket and drop the connection + mount registry
## entries. Shape mirrors plan-9.client.disconnect. As a fallback a connection
## name is also accepted as 'mount_point'.

my ($args) = @ARG;
$args //= {};

my $mount_point = $args->{'mount_point'} // '';

return { 'mode' => 'false', 'data' => 'mount_point required' }
    if not length $mount_point;

my $name = $data{'storage'}{'9p'}{'mounts'}{$mount_point};

## fallback : accept a connection name directly ##
$name //= $mount_point
    if exists $data{'storage'}{'9p'}{'connections'}{$mount_point};

return { 'mode' => 'false', 'data' => "not mounted : $mount_point" }
    if not defined $name
    or not exists $data{'storage'}{'9p'}{'connections'}{$name};

my $conn = $data{'storage'}{'9p'}{'connections'}{$name};

close $conn->{'socket'} if $conn->{'socket'};

delete $data{'storage'}{'9p'}{'connections'}{$name};
delete $data{'storage'}{'9p'}{'mounts'}{$mount_point};

<[base.logs]>->("Storage 9P: unmounted $mount_point [ connection $name ]");

return { 'mode' => 'true', 'data' => 'unmounted' };

