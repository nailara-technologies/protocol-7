## [:< ##

# name   = coding.sign_queue.detach
# descr  = run a command detached, its exit code to a file
# args   = { cmd => [ .. ], out, rc, stdin, dir, env => { NAME => value } }
# return = TRUE when started
#
# double fork into its own session [ as p7_sign ] : the job outlives the
# zenka, nothing here waits on it. the grandchild runs the command and
# writes `rc = <code>` to the rc file when it ends [ tmp + rename, a
# reader never sees half ] ; the sign queue timer reads it. the runner is
# the session leader : its pid, in `<rc>.pid`, is the process group to kill

my $in = shift // {};
return FALSE if ref $in->{'cmd'} ne qw| ARRAY | or not @{ $in->{'cmd'} };
CORE::unlink( $in->{'rc'}, "$in->{'rc'}.pid" );
<coding.sign_queue.runner> //= join "\n",
    'my $rc_path = shift;',
    '$SIG{CHLD} = q|DEFAULT|;',
    'if ( open( my $pf, q|>|, qq|$rc_path.pid| '
    . ') ) { print {$pf} qq|$$\n|; close $pf }',
    'my $rc = system { $ARGV[0] } @ARGV;',
    '$rc = $rc == -1 ? 127 : $rc & 127 ? 128 + ( $rc & 127 ) : $rc >> 8;',
    'open( my $fh, q|>:encoding(UTF-8)|, qq|$rc_path.tmp| ) or exit 1;',
    'print {$fh} qq|rc = $rc\n|;',
    'close $fh;',
    'rename qq|$rc_path.tmp|, $rc_path;',
    'exit 0;';

my $pid = CORE::fork();
if ( not defined $pid ) {
    <[base.logs]>->( 0, '<< sign queue : fork failed : %s >>', $OS_ERROR );
    return FALSE;
}
if ( $pid == 0 ) {
    my $gpid = CORE::fork();
    POSIX::_exit(1) if not defined $gpid;
    POSIX::_exit(0) if $gpid;
    POSIX::setsid();
    CORE::open( STDIN, '<:raw', $in->{'stdin'} // '/dev/null' )
        or POSIX::_exit(1);
    CORE::open( STDOUT, '>:raw', $in->{'out'} ) or POSIX::_exit(1);
    CORE::open( STDERR, '>&',    \*STDOUT );
    CORE::chdir( $in->{'dir'} ) if defined $in->{'dir'};
    $ENV{$ARG} = $in->{'env'}{$ARG} foreach sort keys %{ $in->{'env'} // {} };
    ## exec a bare perl runner : the zenka image and its descriptors ##
    ## [ the cube socket .. close on exec ] do not wait hours for an ##
    ## approval                                                      ##
    CORE::exec( $EXECUTABLE_NAME, '-e', <coding.sign_queue.runner>,
        $in->{'rc'}, @{ $in->{'cmd'} } )
        or POSIX::_exit(127);
}
CORE::waitpid( $pid, 0 );
return TRUE;

