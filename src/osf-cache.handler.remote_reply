## [:< ##

# name  = osf-cache.handler.remote_reply
# descr = relay a reply that came back over a remote link
#
# reply handler for osf-cache.cmd.remote : SIZE \ TRUE \ anything else
# map to mode size \ true \ false and answer the waiting command
# [ users.handler.remote_fetch_reply shape ].

my ($info) = @ARG;

my $cmd       = $info->{'cmd'}                            // '';
my $call_args = $info->{'call_args'}                      // {};
my $reply_id  = ( $info->{'params'} // {} )->{'reply_id'} // return;

my $reply
    = uc($cmd) eq qw| SIZE |
    ? { 'mode' => qw| size |, 'data' => $info->{'data'} // '' }
    : uc($cmd) eq qw| TRUE |
    ? { 'mode' => qw| true |,  'data' => $call_args->{'args'} // '' }
    : { 'mode' => qw| false |, 'data' => $call_args->{'args'} // $cmd };

<[base.callback.cmd_reply]>->( $reply_id, $reply );

return;

