## [:< ##

# name   = claude.context.tick
# descr  = context size timer : one look, then the next round
# args   = the timer event [ not used ]

undef <claude.context.timer>;
## a failed round never ends the timer ##
<[base.logs]>->( 0, '<< context size check failed : %s >>', $EVAL_ERROR )
    if not defined eval {<[claude.context.check]>};
<[claude.context.arm]>;
return TRUE;

