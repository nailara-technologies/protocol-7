## [:< ##

# name  = models.task.claim-ok
# descr = may this host claim another task
# note  = capacity gate for new claims : TRUE below the in-flight
#         limit, FALSE at capacity [ task stays pending for another
#         host ], UNKNOWN when the ready-backend count is not known
# param = <model pin> [ '' = unpinned ]
# notes = limit : models.cfg.task_max_claims [ 0 = unlimited, unset =
#         default ]. default : one in-flight claim per ready local
#         backend serving the pin [ coding.inference-status, cached in
#         <models.task.local_models> for 60 s ] -- a host with one cpu
#         backend holds at most one task, the gpu host takes the rest ;
#         a pin accepted for a model swap uses all ready backends as slots

my $pin = uc( shift // '' );

## a claim that never completes must not hold its slot for ever [ a job   ##
## stuck in coding's 'depending' queue, a task failed by its owner that   ##
## this host never hears of ] : claims older than the ttl are dropped and ##
## their still-owned task is reset to pending for another worker          ##
my $claimed = <models.task.claimed> //= {};
my $ttl     = <models.cfg.task_claim_ttl> // 1800;
$ttl = 1800 if $ttl !~ m|^\d+$| or $ttl < 60;
foreach my $claimed_id ( keys %{$claimed} ) {
    my $claim      = $claimed->{$claimed_id};
    my $claimed_at = ref $claim eq qw| HASH | ? $claim->{'at'} // 0 : $claim
        // 0;

    ## a renewed claim : dropped one lease after its last renewal -- the   ##
    ## same deadline the task zenka expires it at, nothing to send.  never ##
    ## renewed [ touch not delivered ] : the task zenka has no lease on it ##
    ## [ task.handler.stale-claim-sweep ], the ttl below applies           ##
    if ( ref $claim eq qw| HASH | and $claim->{'renewed'} ) {
        next
            if time - ( $claim->{'touched'} // $claimed_at )
            <= $claim->{'lease'};
        <[base.logs]>->(
            0, ': claim %s not renewed within its lease [ %d s ] : dropped',
            $claimed_id, $claim->{'lease'}
        );
        <[models.task.drop-claim]>->( $claimed_id, 'lease expired' );
        next;
    }

    next if time - $claimed_at <= $ttl;
    <[base.logs]>->(
        0, ': claim %s expired after %d s : slot freed, resetting task',
        $claimed_id, $ttl
    );
    my $agent = <models.cfg.task_agent> // qw| models |;
    <[protocol-7.route-send]>->(
        {   'command' => <[models.task.cmd]>->( qw| release |, $claimed_id ),
            'call_args' => { 'args' => "$claimed_id $agent claim ttl" },
        }
    );
    <[models.task.drop-claim]>->( $claimed_id, 'claim ttl' );
}
my $in_flight = scalar keys %{$claimed};

my $max = <models.cfg.task_max_claims> // '';
if ( length $max and $max =~ m{^\d+$} ) {
    return TRUE if $max == 0;    ## 0 = unlimited ##
    return $in_flight < $max ? TRUE : FALSE;
}

## default : one claim per ready local backend serving the pin ##
my $local = <models.task.local_models> // {};
return UNKNOWN
    if not defined $local->{'at'}
    or time - $local->{'at'} > 60;

my @ids = @{ $local->{'ids'} // [] };
if ( length $pin ) {
    my ($pin_content) = $pin =~ m|([A-Z2-7]{7})$|;
    if ( defined $pin_content ) {
        my @matching_ids = grep {
            my ($id_content) = m|([A-Z2-7]{7})$|;
            defined $id_content and $id_content eq $pin_content;
        } @ids;
        @ids = @matching_ids;
        ## a swap-accepted pin uses every ready backend as one future slot ##
        @ids = @{ $local->{'ids'} // [] }
            if not @ids
            and ( <models.task.swap_accepted> // {} )->{$pin_content};
    }
}

return $in_flight < scalar(@ids) ? TRUE : FALSE;

