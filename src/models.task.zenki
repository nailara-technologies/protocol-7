## [:< ##

# name  = models.task.zenki
# descr = task zenki list : parsed models.cfg.task_zenka
# notes = <models.cfg.task_zenka> is a space separated LIST of task zenki
#         [ 'task' = the local one ]. a single name works exactly as
#         before. empty or unset falls back to 'task'. duplicates are
#         dropped, order kept [ the first entry is the fallback route
#         for commands that carry no task id ]

my $raw = <models.cfg.task_zenka> // qw| task |;

my %seen;
my @zenki = grep { length and not $seen{$ARG}++ } split m|\s+|, $raw;

@zenki = qw| task | if not scalar @zenki;

return @zenki;

