# name  = httpd.signature_cache_init
# descr = initialize persistence without disabling verification

my ( $state, $error ) = <[httpd.signature_persistent]>->(qw| init |);
if ( not defined $state ) {
    <httpd.signature.persistent_disabled> = TRUE;
    <[base.logs]>->(
        0,
        'signed-file persistent cache disabled : %s [ full verification ]',
        $error // 'unknown'
    );
    return FALSE;
}
<httpd.signature.persistent_disabled> = FALSE;
return TRUE;

