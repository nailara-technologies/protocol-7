# name  = X-11.helper.xpra_server_argv
# descr = build a local unix-socket-only xpra server argument list

my $xpra_bin = shift // return;
my $display  = shift // return;
my $socket   = shift // return;

return (
    $xpra_bin, qw| start |, $display, qw| --daemon=no |,
    "--bind=$socket",
    qw| --mdns=no |,
    qw| --notifications=no |,
    qw| --dbus-control=no |
);

