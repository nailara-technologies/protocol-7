# name  = work.scan_workspace_repos
# descr = scan workspace-transfer repositories

my @repos;

my $var_run_dir = <work.cfg.workspace_root>;
return \@repos unless -d $var_run_dir;

opendir my $dh, $var_run_dir or return \@repos;
while ( my $entry = readdir($dh) ) {
    next if $entry =~ /^\./;
    my $path = "$var_run_dir/$entry";
    next unless -d $path && -d "$path/.git";

    push @repos,
        {
        name   => $entry,
        path   => $path,
        source => 'workspace-transfer'
        };
}
closedir $dh;

return \@repos;

