# name  = coding.gpu_sparkline
# descr = render ASCII sparkline from coding.stats.gpu.sparkline_buf

my @chars = ( ' ', '.', ':', '|', '#' );

my $buf = <coding.stats.gpu.sparkline_buf> // [];
return '' if not @$buf;

my $sparkline = '[';
for my $val (@$buf) {
    my $idx
        = $val <= 15 ? 0
        : $val <= 35 ? 1
        : $val <= 60 ? 2
        : $val <= 80 ? 3
        :              4;
    $sparkline .= $chars[$idx];
}
$sparkline .= ']';

return $sparkline;

