## [:< ##

# name  = task.persist.summary_tree.save
# descr = save summary-tree entries to disk as yaml

my $saved_at = <[base.ntime]>;

my $yaml = <[format.yaml.dump_str]>->(
    {   'entries'  => <task.summary_tree.entries>,
        'saved_at' => $saved_at,
    }
);

return FALSE unless defined $yaml and length $yaml;

utf8::encode($yaml);

return
    defined <[file.zenka_dir.write]>->( 'summary-tree.yaml', \$yaml )
    ? TRUE
    : FALSE;

