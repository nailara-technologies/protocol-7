# name = data.topology.interference.map.calculate_fluorescent_drift
# descr = Topology calculation subroutine

my ( $hash, $base_color ) = @ARG;

# Calculate subtle drift direction toward "original" metadata color
my $drift_hash
    = <[chk-sum.amos.truth_template_chksum]>->( $hash . "drift_marker", \0 )
    // 0;

return [
    ( ( $drift_hash >> 16 ) % 256 ) / 256 * 0.1 - 0.05,
    ( ( $drift_hash >> 8 ) % 256 ) / 256 * 0.1 - 0.05,
    ( $drift_hash % 256 ) / 256 * 0.1 - 0.05,
];

