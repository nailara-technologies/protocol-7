## [:< ##

# name   = coding.sessions.touch
# descr  = one activity report of a session
# args   = { name type via dispatches sid }
# return = the record, undef : a state report of an unknown one
#
# via=keepalive, or any report within coding.cfg.keepalive_echo_seconds
# of a keep-alive [ the session answering it ], refreshes the idle time
# only : last activity and the count in a row stay. via=state carries the
# dispatch count only, it is no activity. a sid names the session : the
# record follows it to a new name [ coding.sessions.carry ]

my $in    = shift // {};
my $all   = <[coding.sessions.store]>;
my $via   = $in->{'via'} // '';
my $name  = $in->{'name'};
my $now   = time;
my $moved = <[coding.sessions.carry]>->( $name, $in->{'sid'}, $via );
my $r     = $all->{$name};
## a state report never takes another session's name ##
return undef
    if $via eq qw| state |
    and defined $in->{'sid'}
    and defined $r
    and ( $r->{'sid'} // $in->{'sid'} ) ne $in->{'sid'};
return undef if not defined $r and $via eq qw| state |;
my $new = not defined $r;
$r = $all->{$name}
    //= { 'since' => $now, 'switch' => qw| off |, 'count' => 0 };
$r->{'type'}       = $in->{'type'};
$r->{'sid'}        = $in->{'sid'}        if defined $in->{'sid'};
$r->{'dispatches'} = $in->{'dispatches'} if defined $in->{'dispatches'};

if ( $via ne qw| state | ) {
    my $echo = $via eq qw| keepalive |
        || ( defined $r->{'sent'}
        and $now - $r->{'sent'}
        < ( <coding.cfg.keepalive_echo_seconds> // 233 ) );
    if ( not $echo or $new ) {
        $r->{'last'}  = $now;
        $r->{'via'}   = $via;
        $r->{'count'} = $r->{'fail'} = 0;
    }
    $r->{'due'} = $now + <[coding.keepalive.delay]>;
}
## a name in use again points nowhere else ##
delete <coding.sessions.aliases>->{$name};
<[coding.sessions.store]>->(qw| save |);
<[coding.keepalive.arm]> if $moved or $r->{'switch'} eq qw| on |;
if ( grep {m{\Aopen\.(?:dispatch|wait)\.}} keys %{$r} ) {
    <[protocol-7.route-send]>
        ->( { 'command' => qw| events.cache-keepalive-arm | } );
}
return $r;

