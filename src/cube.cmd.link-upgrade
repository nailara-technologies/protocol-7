## [:< ##

# name    = cube.cmd.link-upgrade
# descr   = initiate link upgrade to encrypted session
#
# usage   : link-upgrade [<encoding_mode>]
# modes   : [ negotiated during handshake ]
#           utf7, base32, base32-xz [ optional, default none ]
#
# note    = triggers transition to state 2 [ link-upgrade negotiation ]
#           if successful, transitions to state 3 [encrypted]
#           if failed, returns to state 1 [authenticated]

my $session_id         = $call->{'session_id'};
my $requested_encoding = $call->{'args'} // '';

$requested_encoding = lc($requested_encoding);
$requested_encoding =~ s|\s+||g;

my $session = $data{'session'}{$session_id};

## a binding-pending session [ auth-keypair ] has no state 1 to fall back  ##
## to : any refusal here disconnects it [ data/md/design/AUTH-LINK-BINDING ##
## ]                                                                       ##
my $refuse = sub {
    my $reason = shift;
    if ( ( $session->{'link_binding'} // '' ) eq qw| pending | ) {
        map { delete $session->{'auth'}{$ARG} }
            qw| server_nonce server_pub server_key_name client_pub |;
        $session->{'flush_shutdown'} = TRUE;
        <[base.logs]>->(
            0, '[%d] link-upgrade refused on binding-pending session : %s',
            $session_id, $reason
        );
    }
    return { 'mode' => qw| false |, 'data' => $reason };
};

## Validate requested encoding mode [optional]
my $encoding_mode;
if ( $requested_encoding =~ m|^$| ) {
    $encoding_mode = undef;
} elsif ( $requested_encoding =~ m{^(utf7|base32|base32-xz)$} ) {
    $encoding_mode = $requested_encoding;
    if ( $requested_encoding =~ m|^base32-xz$|
        and not <base.perlmod.loaded>->{'Compress::Raw::Lzma'} ) {
        return $refuse->(
            'base32-xz mode not available [XZ compression not installed]');
    }
} else {
    return $refuse->( "unsupported encoding mode: '$requested_encoding' "
            . "[ optional: utf7, base32, base32-xz ]" );
}

## Store requested encoding mode (will be negotiated in state 2)
$session->{'link_encoding_mode_requested'} = $encoding_mode
    if defined $encoding_mode;

## Transition session state 1 -> 2 (link-upgrade negotiation)  This triggers
## protocol.protocol-7.link-upgrade.init
if ( not <[base.session.init_state]>->( $session_id, 2 ) ) {
    return $refuse->("failed to transition to link-upgrade state (state 2)");
}

## Get the ephemeral public key that was generated during state 2 init
use Crypt::Misc;
my $ephemeral_pubkey = $session->{'link_ephemeral_pubkey'};

unless ( defined $ephemeral_pubkey and length $ephemeral_pubkey == 32 ) {
    return $refuse->("failed to generate ephemeral public key");
}

## Encode ephemeral pubkey as base32  Include pubkey in response data (client
## will read confirmation + pubkey)
my $pubkey_b32 = Crypt::Misc::encode_b32r($ephemeral_pubkey);

## Return response with both confirmation and pubkey  Format: "TRUE
## link-upgrade OK <pubkey>"
return {
    'mode' => qw| true |,
    'data' => "link-upgrade OK $pubkey_b32"
};

