## [:< ##

# name   = host-edit.flow.needs_passphrase
# descr  = does an owner key need a passphrase to sign [ form prompt ]
# param  = <owner key name>
# return = TRUE \ FALSE
#
# encrypted keys, passphrase-derived keys [ no secret \ private file on
# disk ] and virtual seed-phrase keys [ never on disk, regenerated per use
# -- the natural form for a network authority key ] need one ; plain keys
# on disk and root-held keys [ loaded as root ] do not.

my $owner = shift // '';

my $path = <[crypt.C25519.key_path]>->($owner);
return FALSE if ref $path ne qw| HASH |;
return FALSE if $path->{'holder'} eq qw| root |;

return TRUE if <[crypt.C25519.encrypted_key]>->($owner);
my $files = $path->{'key_filename'} // {};
my $on_disk
    = grep { defined $ARG and -f $ARG } @{$files}{qw| secret private |};
return FALSE if $on_disk;
return TRUE;    ## passphrase-derived or virtual : never on disk ##

