# name = nshell.util.syswrite_complete
# descr = Write bytes ensuring complete write (syswrite may be partial)

my ( $fh, $data ) = @ARG;
my $total   = length($data);
my $written = 0;

while ( $written < $total ) {
    my $n = syswrite( $fh, $data, $total - $written, $written );
    last if !defined $n or $n <= 0;
    $written += $n;
}
return $written;

