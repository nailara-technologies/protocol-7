## [:< ##

# name  = nameserv.sync.entry.encode
# descr = canonical base32 wire form of one sync entry
# param = $entry -> base32 string | undef

my $body = <[nameserv.sync.entry.body]>->(shift);
return undef if not defined $body;

return <[base32.encode]>->($body);

