## [:< ##

# name  = thermal.outdoor.poll
# descr = request the current outdoor temperature asynchronously

my $handler_params = shift // {};

<[protocol-7.route-send]>->(
    {   'command' => qw| weather.temp |,
        'reply'   => { 'handler' => qw| thermal.handler.outdoor-reply |, },
    }
);

return TRUE;

