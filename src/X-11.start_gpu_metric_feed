## [:< ##

# name  = X-11.start_gpu_metric_feed
# descr = spawn a parallel nvidia-smi feed for one metric [ generic, multi-instance ]
# param = { metric, query_field }

my $args = shift // {};

my $metric      = $args->{'metric'}      // return;
my $query_field = $args->{'query_field'} // return;

return if defined <X-11.gpu_top.metric>->{$metric}->{'process_started'};

my $vendor = <X-11.gpu_vendor> // 'none';
return <[base.log]>->( 2, 'gpu monitoring disabled [ no supported tool ]' )
    if $vendor ne qw| nvidia |;  ## intel_gpu_top emits all metrics at once ##

my $nvidia_bin = <X-11.bin_path>->{'nvidia-smi'};

<[base.logs]>->( 1, "starting 'nvidia-smi' gpu %s monitor .,", $metric );

my $pid
    = open3( undef, my $out_fh, undef, $nvidia_bin,
    "--query-gpu=$query_field", '--format=csv,noheader,nounits',
    qw| -l 1 | );

if ( !$pid ) {
    <[base.logs]>->(
        0, "<< cannot open 'nvidia-smi' [%s] pipe [ \l$OS_ERROR ] >>", $metric
    );
    return;
}
push( @{<system.kill_list>}, $pid );

<X-11.gpu_top.metric>->{$metric} = {
    'pid'             => $pid,
    'process_started' => <[base.ntime]>,
    'out_fh'          => $out_fh,          ## keep fh alive past scope ##
};

<[event.add_io]>->(
    {   'fd'      => $out_fh,
        'handler' => qw| X-11.handler.read_gpu_metric |,
        'data'    => { 'pid' => $pid, 'metric' => $metric }
    }
);

