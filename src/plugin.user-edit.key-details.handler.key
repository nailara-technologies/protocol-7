## [:< ##

# name  = plugin.user-edit.key-details.handler.key
# descr = key-details tab key handling -- display-only, declines everything
# param = $editor_state, $field, $key

## this field NEVER enters an editable mode : 'identity_key' is kept out of
## plugin.user-edit.registry's by_key [ see this plugin's tab_info ], so
## form.handler.stdin_key's Right-entry trigger cannot fire on it and in
## practice no key ever reaches this sub.  it exists because the plugin
## contract expects a handler.key to be present -- and if plugin mode ever DID
## come up on this field, declining every key immediately with the same FALSE
## 'not handled' signal plugin.user-edit.example.handler.key establishes means
## Left exits back out gracefully through stdin_key's existing
## leave-plugin-mode branch, and every other key is a no-op that stays parked
## on the field.  no editing, no scrolling, no key management actions --
## display only, per the task's explicit scope.

my ( $editor_state, $field, $key ) = @ARG;

return FALSE;

