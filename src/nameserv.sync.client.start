## [:< ##

# name  = nameserv.sync.client.start
# descr = start an outbound sync pull [ non-blocking, event driven ]
# param = $params -> connection id | undef

my $params = shift // return undef;

my $host = $params->{'host'} // '';
my $port = $params->{'port'} // 0;

return undef if not length $host;
return undef if $port !~ m|^\d+$| or $port < 1 or $port > 65535;

my $zone = lc( $params->{'zone'} // '' );
$zone =~ s{\.+$}{};

## resolve to an ordered address list [ ipv6 first ] : one getaddrinfo per ##
## connect attempt is acceptable [ see nameserv.sync.addresses ]           ##
my $addrs = <[nameserv.sync.addresses]>->( $host, $port );

if ( not scalar @$addrs ) {
    <[base.logs]>->(
        1, ': sync pull connect failed [ %s:%d ] : %s',
        $host, $port, <[base.str.os_err]>
    );
    return undef;
}

## the address that worked last time is tried first ##
my $worked_all = <nameserv.sync.client.addr_worked> // {};
my $worked     = $worked_all->{ sprintf '%s:%d', $host, $port };
if ( length( $worked // '' ) ) {
    @$addrs = (
        ( grep { $ARG->{'host'} eq $worked } @$addrs ),
        ( grep { $ARG->{'host'} ne $worked } @$addrs )
    );
}

my $pending = <nameserv.sync.client.pending> //= {};
<nameserv.sync.client.seq> //= 0;
my $id = sprintf '%s:%d:%d', $host, $port, <nameserv.sync.client.seq>++;
$id .= '.' while exists $pending->{$id};

$pending->{$id} = {
    id        => $id,
    sock      => undef,
    host      => $host,
    port      => $port,
    target    => length $zone ? $zone : undef,
    full_zone => undef,
    reply_id  => $params->{'reply_id'},
    on_done   => $params->{'on_done'},
    peer      => $params->{'peer'},
    buf       => '',
    phase     => 'connect',
    addrs     => $addrs,
    addr_idx  => -1,    ## next-addr advances before each attempt ##
    checksums => {},
    full_done => {},
};

my $ok = <[nameserv.sync.client.next-addr]>->( $pending->{$id}, '', FALSE );

if ( not $ok ) {
    ## every address refused synchronously : nothing was started ##
    delete $pending->{$id};
    return undef;
}

## nothing may hang forever on an unauthenticated port ##
$pending->{$id}{'timer'} = <[event.add_timer]>->(
    {   after   => <nameserv.cfg.sync.idle_timeout> // 390,
        handler => qw| nameserv.sync.client.timeout |,
        data    => $id,
        desc    => "sync pull timeout [ $host:$port ]"
    }
);

return $id;

