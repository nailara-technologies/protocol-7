## [:< ##

# name  = jobsite.util.build_prompt
# descr = build assessment prompt for a single job

my $job     = shift // {};
my $defects = shift // undef;

my $title    = $job->{'title'}       // '';
my $co       = $job->{'company'}     // '';
my $city     = $job->{'city'}        // '';
my $ind      = $job->{'industry'}    // '';
my $raw_desc = $job->{'description'} // '';

HTML::Entities::decode_entities($raw_desc) if length $raw_desc;

for ( $title, $co, $city, $ind, $raw_desc ) {
    $_ = Encode::decode( 'UTF-8', $_ ) unless utf8::is_utf8($_);
}
my $desc = substr( $raw_desc, 0, 1200 );

## load candidate profile once and cache ##
my $profile_text = $data{'jobsite'}{'cached_profile'} // '';
if ( not length $profile_text ) {
    my $profile_file = <jobsite.cfg.profile_file>
        // '/etc/protocol-7/jobsite/profile.txt';
    $profile_text = <[file.read]>->($profile_file)
        // 'no profile configured : score based on job listing alone';
    $profile_text = Encode::decode( 'UTF-8', $profile_text )
        unless utf8::is_utf8($profile_text);
    $data{'jobsite'}{'cached_profile'} = $profile_text;
}

## extract candidate name from profile header ##
my $candidate_name = 'the candidate';
if ( $profile_text =~ m{^#\s*Candidate Profile\s*[-\x{2014}]\s*(.+?)$}m ) {
    $candidate_name = $1;
    $candidate_name =~ s{^\s+|\s+$}{}g;
}

## build task preamble ##
my $task_preamble;
## configurable so it can track coding.cfg.start_model over time without a ##
## code edit -- a prior hardcoded pin here drifted from the zenka's actual ##
## default and forced an avoidable gpu server kill+respawn on every        ##
## assessment ; see jobsite.cfg.assessment_model for the default           ##
my $model_pin = ':model:' . <jobsite.cfg.assessment_model> . ':';

if ( defined $defects and @$defects ) {
    my $defect_note = join( ', ', @$defects );
    $task_preamble
        = ":local: :simple: $model_pin /no_think Output ONLY YAML. No prose. "
        . "No analysis. No markdown. Start your response with: "
        . "score:\n\nThe previous assessment had these "
        . "defects: $defect_note. Fix them in the YAML output.";
} else {
    $task_preamble
        = ":local: :simple: $model_pin"
        . ' /no_think Output ONLY YAML. No prose. No analysis. '
        . 'No markdown. Start your response with: score:';
}

my $yaml_format = <<'YAML_TEMPLATE';
Output EXACTLY this YAML. Fill in all <...> values in German. Nothing before or after the YAML:

score: <0-10>
apply: <true|false>
reason: "<1-2 deutsche Sätze: passt der Kandidat zu dieser Stelle oder nicht>"
summary: "<2-3 deutsche Sätze: was die Stelle bietet, gesuchte Skills, Remote/Standort-Details, Besonderheiten>"
assertions:
  suggest:
    apply: <true|false>
    delete: <true|false>
    archive: <true|false>
  dimensions:
    location:
      score: <0-10>
      reason: "<1 Satz>"
    work-profile:
      score: <0-10>
      reason: "<1 Satz>"
    company-culture:
      score: <0-10>
      reason: "<1 Satz>"
    compensation:
      score: <0-10>
      reason: "<1 Satz>"
    remote-flexibility:
      score: <0-10>
      reason: "<1 Satz>"
    career-growth:
      score: <0-10>
      reason: "<1 Satz>"
    tech-stack:
      score: <0-10>
      reason: "<1 Satz>"
    team-structure:
      score: <0-10>
      reason: "<1 Satz>"
YAML_TEMPLATE

my @prompt_parts = (
    $task_preamble, $yaml_format, "## Kandidatenprofil : $candidate_name",
    $profile_text,  "## Stellenanzeige : $title | $co | $city",
);

if (    exists $job->{'salary_estimate_min'}
    and exists $job->{'salary_estimate_max'} ) {
    push @prompt_parts,
          "Stepstone-Gehaltsschätzung für diese Stelle: "
        . "€$job->{'salary_estimate_min'}–$job->{'salary_estimate_max'} "
        . "(jährlich brutto)";
}

## the source's own industry/category tag is sometimes simply wrong --      ##
## confirmed 2026-08-28 against a live posting whose page genuinely serves  ##
## the wrong "Branche" (a real employer-side data-entry error, not a scrape ##
## bug), which the model then trusted over the actual description text.     ##
## qualify it explicitly rather than presenting it as authoritative         ##
## structured metadata.                                                     ##
my $branche_line
    = length $ind
    ? "Branche laut Quelle: $ind (automatisch erfasst, kann fehlerhaft sein "
    . "-- bei Widerspruch zur Beschreibung der Beschreibung "
    . "vertrauen)\n\n$desc"
    : $desc;

push @prompt_parts, $branche_line, "Beginne jetzt mit: score:";

return join( "\n\n", @prompt_parts );

