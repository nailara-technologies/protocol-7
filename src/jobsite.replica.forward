## [:< ##

# name  = jobsite.replica.forward
# descr = collect local ui actions for forwarding to the primary

return if not <[jobsite.replica.enabled]>;
return if <jobsite.replica.forward_in_progress>;
<jobsite.replica.forward_in_progress> = TRUE;
<[clients.http.post]>->(
    {   'url'     => qw| http://127.0.0.1/jobs-sync |,
        'body'    => '{"jobs":[]}',
        'timeout' => 32,
        'on_done' => qw| jobsite.replica.forward-local-response |,
    }
);

