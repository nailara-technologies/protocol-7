## [:< ##

# name  = clients.https.stream.finish
# descr = finalize a stream_to_file response : close destination,
#         clean up watchers/socket, fire on_done with status +
#         headers + byte count instead of a body buffer

my $state = shift;
return undef if ref $state ne qw| HASH |;

my $status        = $state->{'stream_status'}  // 0;
my $written       = $state->{'stream_written'} // 0;
my $headers       = $state->{'stream_headers'};
my $headers_multi = $state->{'stream_headers_multi'};
my $ok            = ( $status >= 200 and $status < 300 ) ? TRUE : FALSE;

my $error = '';
if ( not defined $headers ) {
    ## eof before the header block completed : nothing trustworthy ##
    $error = 'connection closed before response headers complete';
    $ok    = FALSE;
}

my $on_done = $state->{'on_done'} // '';
my $params  = $state->{'params'};

<[clients.https.cleanup]>->($state);

if ( length $on_done and exists $code{$on_done} ) {
    $code{$on_done}->(
        {   'ok'            => $ok,
            'status'        => $status,
            'headers'       => $headers       // {},
            'headers_multi' => $headers_multi // {},
            'size'          => $written,
            'body'          => '',
            ( length $error ? ( 'error' => $error ) : () ),
            'params' => $params,
        }
    );
}

return 0;

