## [:< ##

# name  = host-edit.record.write
# descr = write one host record as json, temp + rename
# note  = mode 0640, group = the zenka user's group [ the external
#         zenka's link supervisor reads the records ]
# param = $name, $envelope_href
# return = TRUE | FALSE [ , $error ]

## overwrite mode is temp-file-then-rename() : atomic replace, no
## unlink-then-open window where a crash mid-write would leave the path
## missing instead of intact-old-or-intact-new
## [ same reasoning as base.file.zenka_dir.write ].  the temp file is created
## in the SAME directory as the target, so rename() stays on one filesystem,
## and is chmod 0640 before the rename -- host records hold link metadata
## [ ssh user@host, ports ], never secrets ; group = the zenka user's group so
## the external zenka's link supervisor can read them
## [ the console runs as the invoking unix user, external as the zenka user ].

my ( $name, $envelope ) = @ARG;

my $path = <[host-edit.record.path]>->($name)
    // return ( FALSE, 'invalid host name' );

my $resolved_path = <[base.path.resolve_keywords]>->($path)
    // return ( FALSE, 'cannot resolve record path' );

return ( FALSE, 'envelope is not a hashref' )
    if ref $envelope ne qw| HASH |;

my $hosts_dir = $resolved_path;
$hosts_dir =~ s|/[^/]+$||;

if ( not -d $hosts_dir ) {
    mkdir $hosts_dir, 0750    ## best-effort : parent [VAR_P7] dir exists ##
        or return ( FALSE, sprintf 'cannot create %s : %s',
        $hosts_dir, <[base.str.os_err]> );
}

my $json_str = <[format.json.encode]>->($envelope);

my $tmp_path = sprintf qw| %s/.%s.tmp.%s |,
    $hosts_dir, $name, <[base.prng.chars-anum]>->(8);

open( my $fh, '>', $tmp_path ) or do {
    return ( FALSE, sprintf 'cannot open %s : %s',
        $tmp_path, <[base.str.os_err]> );
};

print {$fh} $json_str;

if ( not close($fh) ) {
    my $err = <[base.str.os_err]>;
    unlink $tmp_path;
    return ( FALSE, sprintf 'close failed : %s', $err );
}

## group first : chmod after chown, a chown may clear mode bits ##
my $zenka_gid
    = ( getpwnam( <system.amos-zenka-user> // qw| protocol-7 | ) )[3];
chown -1, $zenka_gid, $tmp_path if defined $zenka_gid;

chmod 0640, $tmp_path
    or do {
    my $err = <[base.str.os_err]>;
    unlink $tmp_path;
    return ( FALSE, sprintf 'chmod failed : %s', $err );
    };

if ( not rename $tmp_path, $resolved_path ) {
    my $err = <[base.str.os_err]>;
    unlink $tmp_path;
    return ( FALSE, sprintf 'rename failed : %s', $err );
}

return ( TRUE, undef );

