# name  = nameserv.sync.client.handler.connect-timeout
# descr = connect timeout watch for a pending sync pull connect

my $id = shift->w->data;

my $pending = <nameserv.sync.client.pending> // return;
my $state   = $pending->{$id}                // return;

return FALSE if $state->{'phase'} ne qw| connect |;    ## already done ##

## the connect did not complete in time : try the next address ##
<[nameserv.sync.client.next-addr]>->( $state, 'connect timeout' );

return TRUE;

