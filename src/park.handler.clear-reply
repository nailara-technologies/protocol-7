## [:< ##

# name  = park.handler.clear-reply
# descr = reply handler : remove a waiting cleared entry

my $reply = shift                                   // {};
my $entry = ( $reply->{'params'} // {} )->{'entry'} // return FALSE;
my ( $mode, $text ) = <[base.reply.mode_text]>->($reply);
my ($state) = $text =~ m{^: \Q$entry\E\s+(\S+)}m;
if ( $mode ne qw| size | and $mode ne qw| true | ) {
    <[base.logs]>->(
        0,      ':. park : entry %s not checked [ events : %s ]',
        $entry, $text
    );
    return FALSE;
}
return TRUE if ( $state // '' ) ne qw| waiting |;
<[park.send]>->( qw| bucket-remove |, $entry );
return TRUE;

