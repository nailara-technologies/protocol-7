## [:< ##

# name  = tile.cmd.show_intent
# descr = list intent-first tile entries from window-place zenka

my $coords = <tile.coordinates> // {};

my @intent_keys = sort grep {
    ref( $coords->{$ARG} ) eq 'HASH'
        and $coords->{$ARG}{'intent_authored'}
    }
    keys %{$coords};

return {
    'mode' => qw| false |,
    'data' => 'no intent-first placements stored'
    }
    if not @intent_keys;

my $output = '';
for my $name (@intent_keys) {
    my $c = <tile.coordinates>->{$name};
    $output .= sprintf "%-24s  left=%-5d top=%-5d right=%-5d bottom=%d\n",
        $name, $c->{'left'}, $c->{'top'}, $c->{'right'}, $c->{'bottom'};
}
chomp $output;

return { 'mode' => qw| size |, 'data' => $output };

