# name  = branch.node.info
# descr = return node metadata by id
# param = node_id [ string or { id => ... } ]

my $params = shift // '';
my $node_id
    = ref $params eq 'HASH'
    ? $params->{'id'} // ''
    : $params;

return { 'mode' => 'false', 'data' => 'node id required' }
    unless length $node_id;
return { 'mode' => 'false', 'data' => 'node not found' }
    unless exists $data{'branch.nodes'}{$node_id};

my $node      = $data{'branch.nodes'}{$node_id};
my $path      = <[branch.node.path]>->($node_id);
my $sub_count = scalar keys %{ $data{'branch.children'}{$node_id} // {} };

return {
    'mode' => 'true',
    'data' => {
        %$node,
        'path'        => $path->{'data'} // '',
        'child_count' => $sub_count,
    },
};

