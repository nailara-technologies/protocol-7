# name = pdf.html.parent.init_code

<[event.add_signal]>->(
    { 'signal' => 'CHLD', 'handler' => qw|base.handler.sig_chld.shutdown| } );

<sig.chld.shutdown.pid>->{<pdf.html.child.pid>} = TRUE;

0;

