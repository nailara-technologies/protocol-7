## [:< ##

# name  = crypt.C25519.private_key_loaded
# descr = true if the named [ or default ] signing key is currently loaded
#         in memory and has a private half -- checks loaded state, not disk
#         presence [ see crypt.C25519.key_exists for that ]

my $requested_skey = shift;    ##  optional  ##

my $key_vars_ref = <[crypt.C25519.key_vars]>->($requested_skey);
my $skey_name    = $key_vars_ref->{'key_name'};

return FALSE if not exists $keys{'C25519'}->{$skey_name};
return FALSE if not exists $keys{'C25519'}->{$skey_name}->{'private'};

return TRUE;

