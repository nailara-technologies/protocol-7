## [:< ##

# name  = nshell.render.content_print
# descr = print background content [ replies, streamed chunks ] without
#         disturbing the pinned input line's cursor position
# param = <text>

my $text = shift // '';

return unless length $text;

my $state_ref = <nshell.state> // {};

## not in split mode : plain print, unchanged behaviour ##
if ( not $state_ref->{'split_active'} ) {
    print $text;
    STDOUT->flush();
    return;
}

## split mode : the real cursor rests at the pinned input row between       ##
## renders [ nshell.render.viewport's own convention -- it jumps there and  ##
## stays, never restores away ]. background content must NOT print there    ##
## directly, or it lands on top of the input line instead of the scrolling  ##
## content area above it. save the input-row position, jump into the        ##
## content area at the tracked column [ row is always the content area's    ##
## own bottom row once resting there -- that's what a scroll region does on ##
## its own, no need to track it separately ], print, track the new column,  ##
## restore back to the input row.                                           ##
my $content_row = $state_ref->{'split_row'} - 2;      ## last content row ##
my $col         = $state_ref->{'content_col'} // 1;

print "\e7";    ## DECSC : save [ = the input row ] ##

## consume a deferred wrap left by the PREVIOUS call before doing anything   ##
## else this time. an exact-width fill leaves the real cursor pending-wrap   ##
## at content_row's own right edge -- still logically ON that row, not yet   ##
## advanced/scrolled, because nothing has printed past the edge to trigger   ##
## it. this function always repositions via an absolute CUP rather than     ##
## relying on that natural advance, and the column math below already        ##
## resolves an exact fill to col 1 [ modulo wraps cleanly to 0, +1 ] -- so    ##
## without this, the NEXT call's CUP lands back on column 1 of the SAME      ##
## already-full row instead of a fresh one below it, overwriting it from     ##
## the start. confirmed live 2026-09-14 : a chunk boundary landing exactly   ##
## on the terminal width lost the entire line it had just finished. forcing  ##
## the scroll here with a real \r\n [ while still sitting on content_row,    ##
## the scroll region's own bottom row ] reproduces what the terminal would   ##
## have done on its own had printing simply continued past the edge --      ##
## content_row stays content_row [ that's what a scroll region does ], but   ##
## now genuinely blank.                                                      ##
if ( $state_ref->{'content_pending_wrap'} ) {
    print "\e[${content_row};1H\r\n";
    delete $state_ref->{'content_pending_wrap'};
    $col = 1;
}

print "\e[${content_row};${col}H";
print $text;

## accumulate into the CURRENTLY FOCUSED mode's own buffer, so switching ##
## away and back replays what happened while it was backgrounded [       ##
## nshell.display.cycle reads this on focus ]. generic -- not coding-    ##
## zenka-specific, any future mode gets redraw-on-switch for free        ##
my $modes = $state_ref->{'display_modes'};
my $index = $state_ref->{'display_mode_index'};
if ( ref $modes eq 'ARRAY' and defined $modes->[$index] ) {
    $modes->[$index]{'buffer'} //= '';
    $modes->[$index]{'buffer'} .= $text;
}

## track the new column : text after the last newline if any, else appended ##
## to the old column -- accounting for the terminal's own implicit soft-    ##
## wrap via modular arithmetic, not a blind clamp to 1. a chunk boundary    ##
## landing mid-wrap [ e.g. a streamed token split across the row edge ]     ##
## used to clamp to column 1 regardless of how many characters actually     ##
## spilled onto the new line, so the NEXT chunk's explicit CUP overwrote    ##
## that spillover instead of continuing after it -- confirmed live          ##
## 2026-09-14 : "general-purpose" streamed across a chunk boundary at the   ##
## row edge lost its "al", printed as "gener-purpose" once the following    ##
## chunk overwrote it. the old comment's "worst case is an extra blank-     ##
## looking line" was wrong -- actual content loss, not just wasted space.   ##
my ($term_w) = AMOS7::TERM::terminal_size();
$term_w ||= 80;

## an exact-width fill [ tail length a nonzero multiple of term_w ] leaves    ##
## the real cursor pending-wrap at the row's own right edge -- not yet       ##
## actually advanced, since nothing has printed PAST the edge to force it.   ##
## the col formula below already resolves that case to 1 [ modulo wraps      ##
## cleanly to 0, +1 ], indistinguishable from a genuine completed newline    ##
## unless flagged separately -- content_pending_wrap is that flag, consumed  ##
## by the NEXT call above before it trusts this col at face value.           ##
my $tail_len;

if ( $text =~ m{\n([^\n]*)\z} ) {
    $tail_len = length($1);
    $col      = $tail_len % $term_w + 1;
} elsif ( $text !~ m{\n} ) {
    $tail_len = ( $col - 1 ) + length($text);
    $col      = ( $tail_len % $term_w ) + 1;
} else {
    $tail_len = 0;
    $col      = 1;    ## ends exactly on a newline ##
}
$state_ref->{'content_col'} = $col;
$state_ref->{'content_pending_wrap'}
    = ( $tail_len > 0 and $tail_len % $term_w == 0 ) ? TRUE : FALSE;

print "\e8";     ## DECRC : restore [ back to the input row ] ##
STDOUT->flush();

return;

