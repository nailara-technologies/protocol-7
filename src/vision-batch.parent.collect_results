# name = vision-batch.parent.collect_results
# descr = Collect and process results from child workers

my $pid = shift;
my $msg = shift;

# Validate input
return { success => FALSE, error => 'Message required' } unless defined $msg;
return { success => FALSE, error => 'Message must be a hash' }
    unless ref $msg eq qw| HASH |;

my $result = $msg;

my $batch_state   = <vision-batch.batch_state>;
my $batch_queue   = <vision-batch.batch_queue>;
my $operation_log = <vision-batch.operation_log>;
my $error_log     = <vision-batch.error_log>;

return { success => FALSE, error => 'No batch_state available' }
    unless defined $batch_state;
return { success => FALSE, error => 'No batch_queue available' }
    unless defined $batch_queue;

my $job_id = $result->{job_id};
my $stats  = $batch_state->{statistics};

# Find job in queue and update it
my $job_found = 0;
foreach my $job (@$batch_queue) {
    if ( $job->{job_id} eq $job_id ) {
        $job_found = 1;

        if ( $result->{success} ) {

            # Successful analysis
            $job->{status} = 'completed';
            $job->{result} = $result;
            $stats->{completed}++;
            $stats->{processed}++;

            # Log to operation_log
            push @$operation_log,
                {
                job_id     => $job_id,
                image_path => $job->{image_path},
                success    => TRUE,
                metrics    => $result->{metrics},
                grade    => $result->{metrics}->{overall_grade} // 'unknown',
                duration => $result->{duration_ms},
                model_used => $result->{model_used},
                method     => $result->{method},
                timestamp  => <[base.ntime]>
                };

            # Update quality distribution histogram
            my $grade = $result->{metrics}->{overall_grade} // 'unknown';
            $stats->{grade_distribution}->{$grade}++;

            # Update overall statistics
            $stats->{total_duration_ms} += $result->{duration_ms} // 0;

        } else {

            # Failed analysis
            $job->{status} = 'failed';
            $job->{error}  = $result->{error} // 'Unknown error';
            $stats->{failed}++;
            $stats->{processed}++;

            # Log to error_log
            push @$error_log,
                {
                job_id     => $job_id,
                image_path => $job->{image_path},
                error      => $result->{error},
                timestamp  => <[base.ntime]>,
                type       => 'analysis_failure'
                };
        }

        last;
    }
}

return {
    success => $job_found,
    job_id  => $job_id,
    message => $job_found
    ? "Result processed for job $job_id"
    : "Job $job_id not found in queue",
    stats_updated => {
        processed => $stats->{processed},
        completed => $stats->{completed},
        failed    => $stats->{failed}
    }
};

