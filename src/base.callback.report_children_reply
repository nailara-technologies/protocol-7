# name  = base.callback.report_children_reply
# descr = surface a failed v7-zenki.register_child reply at log level 0 [ was
#         previously fire-and-forget, no visibility on failure ]

my $arg  = shift;
my $pid  = $arg->{'params'}{'pid'}     // '?';
my $data = $arg->{'call_args'}{'args'} // '';

return if $arg->{'cmd'} ne qw| FALSE |;

<[base.logs]>->(
    0, "report_children_reply: v7-zenki.register_child failed [PID:%s] : %s",
    $pid, $data
);

