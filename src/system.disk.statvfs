## [:< ##

# name  = system.disk.statvfs
# descr = byte and inode counts for one mount

<[base.perlmod.autoload]>->(qw| Filesys::Statvfs |);
my @stat = Filesys::Statvfs::statvfs(shift);
return undef if not @stat;
return {
    qw| block_size |  => $stat[0],
    qw| blocks |      => $stat[2],
    qw| blocks_free | => $stat[4],
    qw| files |       => $stat[5],
    qw| files_free |  => $stat[7],
};

