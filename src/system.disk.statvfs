## [:< ##

# name  = system.disk.statvfs
# descr = byte and inode counts for one mount

## no Filesys::Statvfs [ libfilesys-statvfs-perl ] : one notice, then no ##
## disk numbers -- the feature costs itself, never a line per poll       ##
return undef if <system.disk.statvfs_missing>;
<[base.perlmod.autoload]>->(qw| Filesys::Statvfs |)
    if not defined &Filesys::Statvfs::statvfs;
if ( not defined &Filesys::Statvfs::statvfs ) {
    <system.disk.statvfs_missing> = TRUE;
    <[base.log]>->(
        0,
        ': system.disk : Filesys::Statvfs missing, disk '
            . 'numbers off [ apt : libfilesys-statvfs-perl ]'
    );
    return undef;
}
my @stat = Filesys::Statvfs::statvfs(shift);
return undef if not @stat;
return {
    qw| block_size |  => $stat[0],
    qw| blocks |      => $stat[2],
    qw| blocks_free | => $stat[4],
    qw| files |       => $stat[5],
    qw| files_free |  => $stat[7],
};

