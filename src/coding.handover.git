## [:< ##

# name   = coding.handover.git
# descr  = commits not pushed \ not deployed
# return = { pushed => [ lines ] | undef, deployed => [ lines ] | undef,
#            branch, deployed_ref }
#
# read when the block is rendered [ two short git log runs, no shell ].
# not deployed : the commits after coding.cfg.handover_deployed_ref
# [ a ref the deploy moves ] -- undef without one

my $root = <coding.cfg.handover_root> // <system.root_path> // '';
my $log  = sub {
    my $range = shift;
    CORE::open(
        my $fh, '-|:encoding(UTF-8)', qw| git -C |, $root,
        qw| -c color.ui=false log --no-color -n 40 |,
        '--format=%h %s',
        $range, '--'
    ) or return undef;
    my @lines = map { CORE::s{\s+\z}{}r } <$fh>;
    CORE::close $fh or return undef;
    return \@lines;
};
my $branch;
if (CORE::open(
        my $fh, '-|:encoding(UTF-8)', qw| git -C |, $root,
        qw| rev-parse --abbrev-ref HEAD |
    )
) {
    $branch = <$fh> // '';
    CORE::close $fh;
    $branch =~ s{\s+\z}{};
}
my $ref = <coding.cfg.handover_deployed_ref>;
return {
    'branch'       => $branch // '?',
    'pushed'       => $log->('@{upstream}..HEAD'),
    'deployed_ref' => $ref,
    'deployed'     => defined $ref
        && length $ref
        && $ref =~ m{\A[\w./\@{}^~-]+\z} ? $log->("$ref..HEAD") : undef
};

