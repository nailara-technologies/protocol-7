# name  = amos.chksum.cmd.verify-nested
# descr = verify nested checksum notation against parent and name
# param = <[child:parent]> <parent-chksum> <child-name>

my $args = $call->{'args'} // '';

return {
    'mode' => qw| false |,
    'data' => 'expected notation, parent-chksum and child-name'
    }
    if not length $args;

my @parts = split( m| +|, $args, 3 );
return {
    'mode' => qw| false |,
    'data' => 'expected notation, parent-chksum and child-name'
    }
    if @parts < 3;

my ( $notation, $parent_chksum, $child_name ) = @parts;

my $result = AMOS7::CHKSUM::Nested::verify_nesting( $notation, $parent_chksum,
    $child_name );

return {
    'mode' => $result ? qw| true | : qw| false |,
    'data' => $result ? qw| TRUE | : qw| FALSE |
};

