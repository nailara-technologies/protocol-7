## [:< ##

# name  = user-edit.outbox.list
# descr = list staged edit entry ids from the local outbox
# param = $filter [ optional substring filter ]

my $filter = shift // '';

my $outbox_dir = <[base.path.resolve_keywords]>->(qw| [VAR_P7]/outbox |);

## an outbox that was never written to yet is a normal, expected state, not a
## warning-worthy one — file.all_files warns on a missing path
my $files = -d $outbox_dir ? <[file.all_files]>->($outbox_dir) // [] : [];

my @ids;

foreach my $file_path ( $files->@* ) {
    ( my $entry = $file_path ) =~ s|^.*/||;
    next unless $entry =~ s|\.yaml$||;

    if ( length $filter ) {
        next unless $entry =~ m|\Q$filter\E|i;
    }

    push @ids, $entry;
}

return \@ids;

