# name  = source.harmonize_payload_line_feed

my $payload_sref      = shift;
my $cur_endline_state = shift // 5;    ##  5 == unmodified  ##

warn 'expected sref to payload data <{C1}>' and return undef
    if not length ref $payload_sref;
<[base.s_warn]>->( 'got ref-type %s , want SCALAR <{C1}>', ref $payload_sref )
    and return undef
    if ref $payload_sref ne qw| SCALAR |;

warn 'expected octal endline state descriptor <{C1}>' and return undef
    if defined $cur_endline_state and $cur_endline_state !~ m|^\d$|
    or $cur_endline_state > 7;

##  endline state description  ##
#
##  7 : 2 added, 5 : untouched, 0 : 4 removed  ##

## canonical-form normalization [ Fix #3 ] below always runs : a prior
## early-return for states 0 / 7 skipped it , leaving state-7 re-signs with
## zero trailing newlines → footer concatenation oscillation on every other
## sign. the canonical loop is idempotent , so no limit guard is needed.

my $endline_state_oct       = $cur_endline_state;         ##  unmodified  ##
my $payload_size_delta      = 0;
my $previous_payload_length = length $payload_sref->$*;

## Fix #3: CRITICAL - Remove state-dependent behavior for idempotence The
## canonical form is: [non-newline]\n\n (exactly 2 newlines as separator) MUST
## NOT use $mod_offset here - it causes oscillation!
##
if ( $payload_sref->$* =~ m|\n{2,}$|s ) {

    ## Too many trailing newlines - reduce to exactly 2 (canonical       ##
    ## separator) This removes trailing newlines and adds back exactly 2 ##
    ## for canonical form                                                ##
    $payload_sref->$* =~ s|\n+$|\n\n|s;

} else {

    ## Not enough trailing newlines - add to reach exactly 2 (canonical   ##
    ## separator) Keep adding newlines until we have exactly 2 at the end ##

    while ( $previous_payload_length > 0
        and $payload_sref->$* !~ m|\n\n$|s ) {

        $payload_sref->$* .= "\n";
    }

}

$payload_size_delta = length( $payload_sref->$* ) - $previous_payload_length;

$endline_state_oct = 5 + $payload_size_delta;

## Fix #3 CRITICAL: Ensure deterministic state for canonical form If file is
## in canonical form (ends with exactly 2 newlines after harmonization),
## ALWAYS return state=5 to signal "normalized, no further changes needed"
## This prevents oscillation where successive signings toggle between states
##
if ( $payload_sref->$* =~ m|\n\n$|s ) {
    $endline_state_oct = 5;
}

return $endline_state_oct;

