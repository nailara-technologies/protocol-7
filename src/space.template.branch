## [:< ##

# name  = space.template.branch
# descr = compute branch checksum preserving ancestry
# param = { parent, next, branch_data }

my $params = shift // {};

my $parent      = $params->{'parent'}      // '';
my $next        = $params->{'next'}        // '';
my $branch_data = $params->{'branch_data'} // '';

return { 'mode' => qw| false |, 'data' => 'parent required' }
    unless length $parent;
return { 'mode' => qw| false |, 'data' => 'next required' }
    unless length $next;
return { 'mode' => qw| false |, 'data' => 'branch_data required' }
    unless length $branch_data;

my $branch_input = join ':', $parent, $next, $branch_data;

my $chksum_fn       = $code{'chk-sum.amos'} // $code{'base.chk-sum.amos'};
my $branch_checksum = $chksum_fn->( \$branch_input );

return { 'mode' => qw| true |, 'data' => $branch_checksum };

