## [:< ##

# name = image-quality.vision.encode_image
# descr = Read image file and encode as base64 for vision model APIs

my $image_path = shift;

# Validate input
return { success => FALSE, error => 'Image path required' }
    unless defined $image_path;
return { success => FALSE, error => "File not found: $image_path" }
    unless -f $image_path;

# Check file size (limit to 20MB for vision models)
my $file_size = -s $image_path;
return { success => FALSE, error => 'File too large (max 20MB)' }
    if $file_size > 20_000_000;
return { success => FALSE, error => 'File is empty' } if $file_size == 0;

# Load MIME::Base64
<[base.perlmod.load]>->( 'MIME::Base64', qw| encode_base64 | );

# Read image file as binary
open my $fh, '<:raw', $image_path
    or return { success => FALSE, error => "Cannot open file: $!" };
my $image_data = do { local $/; <$fh> };
close $fh;

return { success => FALSE, error => 'File read failed' }
    unless defined $image_data;

# Detect MIME type from magic bytes
my $mime_type = 'application/octet-stream';
if ( $image_data =~ m|^\x89PNG| ) {
    $mime_type = 'image/png';
} elsif ( $image_data =~ m|^\xFF\xD8\xFF| ) {
    $mime_type = 'image/jpeg';
} elsif ( $image_data =~ m|^GIF8[79]a| ) {
    $mime_type = 'image/gif';
} elsif ( $image_data =~ m|^RIFF.*WEBP|s ) {
    $mime_type = 'image/webp';
} elsif ( $image_data =~ m|^BM| ) {
    $mime_type = 'image/bmp';
} elsif ( $image_data =~ m|^\x00\x00\x01\x00| ) {
    $mime_type = 'image/x-icon';
} elsif ( $image_data =~ m{^MM\x00\x2a|II\x2a\x00} ) {
    $mime_type = 'image/tiff';
}

# Encode as base64 (no line breaks for JSON compatibility)
my $base64_data = encode_base64( $image_data, '' );

return {
    success    => TRUE,
    base64     => $base64_data,
    mime_type  => $mime_type,
    size_bytes => $file_size,
    file_path  => $image_path
};

