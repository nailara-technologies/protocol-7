# name = coding.routing.get_model_metadata
# descr = Fetch model metadata from models zenka for routing decisions

my ($model_alias) = @ARG;

<[base.logs]>->(
    2, "[coding.routing] get_model_metadata :. %s", $model_alias
);

## look up local model metadata cache populated during init
my $metadata = <coding.model_metadata>->{$model_alias};

return $metadata if defined $metadata && ref $metadata eq qw| HASH |;

return undef;

