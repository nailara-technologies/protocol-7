## [:< ##

# name  = screen.setup.handler.geometry_reply
# descr = collect per-window geometry replies and redraw the minimap

my $reply    = shift                       // {};
my $id       = $reply->{'params'}{'id'}    // '';
my $winid    = $reply->{'params'}{'winid'} // '';
my $target_x = $reply->{'params'}{'target_x'};
my $target_y = $reply->{'params'}{'target_y'};

return if not length $id or not length $winid;
return if not exists <screen-setup.instances>->{$id};

my $inst = <screen-setup.instances>->{$id};

my $mode = lc( $reply->{'cmd'} // '' );
if ( $mode eq qw| true | ) {
    my $args = $reply->{'call_args'}{'args'} // '';
    my ( $w, $h, $x, $y ) = split m|\s+|, $args;

    if ( defined $w and defined $h and $w > 0 and $h > 0 ) {
        my $title = '';
        if ( defined $inst->{'windows_temp'}{$winid} ) {
            $title = $inst->{'windows_temp'}{$winid}{'title'} // '';
        }

        my $new_geo = {
            'x' => $x // 0,
            'y' => $y // 0,
            'w' => $w + 0,
            'h' => $h + 0
        };

        ## update an existing entry if present, else create it [ keeps any ##
        ## intended_geo intact so a move-in-progress is not overwritten ]  ##
        my $existing;
        for my $win ( @{ $inst->{'windows'} // [] } ) {
            if ( $win->{'winid'} eq $winid ) {
                $existing = $win;
                last;
            }
        }

        if ( defined $existing ) {
            $existing->{'actual_geo'} = $new_geo;

            ## clear intended_geo only when the move actually landed      ##
            ## [ weston silently clamps cross-output configurewindow;     ##
            ##   if actual doesn't match the target we asked for, the     ##
            ##   intent stays pending until a screen-change retries ]     ##
            if (    defined $existing->{'intended_geo'}
                and defined $target_x
                and defined $target_y ) {
                my $tolerance = 8;
                if (    abs( $new_geo->{'x'} - $target_x ) <= $tolerance
                    and abs( $new_geo->{'y'} - $target_y ) <= $tolerance ) {
                    $existing->{'intended_geo'} = undef;
                    <[base.logs]>->(
                        1,
                        '[screen-setup.geometry_reply] id=%s '
                            . 'winid=%s move confirmed at %d,%d',
                        $id,
                        $winid,
                        $new_geo->{'x'},
                        $new_geo->{'y'}
                    );
                } else {
                    <[base.logs]>->(
                        1,
                        '[screen-setup.geometry_reply] id=%s winid=%s move '
                            . 'clamped, intent stays pending (actual %d,%d '
                            . 'vs target %d,%d)',
                        $id,
                        $winid,
                        $new_geo->{'x'},
                        $new_geo->{'y'},
                        $target_x,
                        $target_y
                    );
                }
            }
        } else {
            push @{ $inst->{'windows'} },
                {
                'winid'        => $winid,
                'actual_geo'   => $new_geo,
                'intended_geo' => undef,
                'title'        => $title
                };
        }

        <[base.logs]>->(
            2,   '[screen-setup.geometry_reply] id=%s winid=%s %dx%d+%d+%d',
            $id, $winid, $w, $h, $x // 0, $y // 0
        );
    }
} else {
    ## window no longer exists : prune it so the periodic refresh stops ##
    ## querying a dead xid and causing X-11 bad-Drawable errors         ##
    my $before = scalar @{ $inst->{'windows'} // [] };
    $inst->{'windows'}
        = [ grep { $_->{'winid'} ne $winid } @{ $inst->{'windows'} // [] } ];
    my $pruned = $before - scalar @{ $inst->{'windows'} };
    if ($pruned) {
        <[base.logs]>->(
            1,
            '[screen-setup.geometry_reply] id=%s '
                . 'winid=%s gone, pruned from overlay',
            $id,
            $winid
        );
    }
}

delete $inst->{'windows_temp'}{$winid}
    if exists $inst->{'windows_temp'}{$winid};

$inst->{'window_pending'}-- if ( $inst->{'window_pending'} // 0 ) > 0;

## all replies in : refresh the overlay ##
if ( ( $inst->{'window_pending'} // 0 ) <= 0 ) {
    delete $inst->{'windows_temp'};
    my $window = $inst->{'window'};
    if ( defined $window ) {
        eval { $window->queue_draw };
        my $count = scalar @{ $inst->{'windows'} // [] };
        if ( ( $inst->{'last_window_count'} // -1 ) != $count ) {
            $inst->{'last_window_count'} = $count;
            <[base.logs]>->(
                1,   '[screen-setup.geometry_reply] id=%s window count: %d',
                $id, $count
            );
        }
    }
}

