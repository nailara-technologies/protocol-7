## [:< ##

# name  = jobsite.replica.pull_soon
# descr = arm the debounced primary pull after forwarded ui actions

return if not <[jobsite.replica.enabled]>;
return if defined <jobsite.replica.soon_timer>;

<jobsite.replica.soon_timer> = <[event.add_timer]>->(
    {   'after'   => <jobsite.cfg.sync_soon_delay> // 3,
        'handler' => qw| jobsite.replica.pull_soon-fired |,
    }
);

