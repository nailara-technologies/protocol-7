## [:< ##

# name  = cube.liveness.handler.timeout
# descr = count a missed probe, close at the limit

my $event         = shift;
my $sid           = $event->w->data;
my $state         = <cube.liveness.state> //= {};
my $session_state = $state->{$sid} // return FALSE;
delete $session_state->{'timeout'};

my $session = $data{'session'}{$sid};
if (   not defined $session
    or $session->{'mode'} ne qw| client |
    or not defined $session->{'liveness'}
    or not grep { ( $data{'route'}{$ARG}{'target'}{'sid'} // -1 ) == $sid }
    values( ( $session->{'route'} // {} )->%* )
    or exists <zenki.heartbeat>->{$sid} ) {
    delete $state->{$sid};
    return FALSE;
}

my $misses     = ++$session_state->{'misses'};
my $max_misses = $session->{'liveness'}{'misses'};
return TRUE if $misses < $max_misses;

my $user        = $session->{'user'} // qw| ----- |;
my $open_routes = grep {    ## routes TO this session ##
    ( $data{'route'}{$ARG}{'target'}{'sid'} // -1 ) == $sid
} values( ( $session->{'route'} // {} )->%* );
<[base.logs]>->(
    0, '[%d] liveness : no answer to %d probes, closing session [ %s, %d ]',
    $sid, $misses, $user, $open_routes
);

delete $state->{$sid};
<[base.session.shutdown]>->( $sid, 'liveness : session not answering' );

return TRUE;

