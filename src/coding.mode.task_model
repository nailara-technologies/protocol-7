## [:< ##

# name  = coding.mode.task_model
# descr = the model a task asks for : its ':model:' pin, else its ':mode:'
#         model setting, else undef [ any loaded model will do ]
# param = $task [ coding task href ] -> model checksum | undef
# note  = read from the request text, before prompt.assemble ran -- the
#         queue grouping needs it for tasks still waiting

my $task = shift // {};

my $text = $task->{'request'}{'description'}
    // $task->{'metadata'}{'raw_request'}{'description'} // '';

return uc $1 if $text =~ m|:model:([A-Z2-7]{7}:[A-Z2-7]{7}):|i;

if ( $text =~ m|:mode:([\w.-]+):| ) {
    my $model = <[coding.mode.setting]>->( $1, qw| model | );
    return uc $model if defined $model and length $model;
}

return undef;

