## [:< ##

# name  = events.bucket.arm
# descr = arm the clock timer of a waiting entry [ at \ after ]
# args   = owner zenka, entry
# return = TRUE when a timer was set
#
# bucket entries use event.add_timer directly with the absolute time
# [ the timetable plugin arms the static entries as a batch and would arm
# them twice ] ; the handler gets the event, its data names the entry. a
# timer already set for the entry is cancelled first

my ( $owner, $e ) = @ARG;
my $key = "$owner/" . $e->{'id'};
<events.bucket_timers> //= {};
<[events.bucket.disarm]>->( $owner, $e );
return FALSE if ( $e->{'state'} // '' ) ne qw| waiting | or $e->{'met'};
return FALSE if not defined $e->{'at'};
<events.bucket_timers>->{$key} = <[event.add_timer]>->(
    {   'at'      => $e->{'at'},
        'handler' => qw| events.bucket.handler.timer |,
        'data'    => { 'owner' => $owner, 'id' => $e->{'id'} }
    }
);
return TRUE;

