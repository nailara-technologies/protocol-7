## [:< ##

# name  = sessions.secret.child
# descr = forked entrypoint for a named secret-holder child. shares the
#         identity holder's lifecycle discipline [ connect-on-fork, NO
#         Event.pm anywhere in this process, eval-wrapped main loop for
#         a die-safety net -- see sessions.holder.child's own header
#         note for the fork+Event.pm hazard this avoids ] but is
#         one-shot: no DORMANT/detach state at all. A caller-supplied
#         secret has no expensive derivation worth preserving across a
#         reattach -- one hold, one release, done.

my $socket_path = shift;
my $name        = shift;
my $secret      = shift;

if ( not defined $socket_path or not defined $secret or not length $secret ) {
    warn 'sessions.secret.child: expected socket path + secret <{C1}>';
    exit(1);
}

$SIG{ALRM} = qw| IGNORE |;
IO::AIO::reinit();

IO::AIO::aio_mlock( $secret, 0, length($secret) );

$SIG{TERM} = sub {
    <[base.buffer.erase_secure]>->( \$secret );
    exit(0);
};
$SIG{INT} = $SIG{TERM};

## connect-on-fork: dial out immediately, no signal wait -- the parent ##
## forked us on purpose and already knows the connection is wanted     ##
my $sock = <[io.unix.socket.output.open]>->($socket_path);
if ( not $sock ) {
    warn 'sessions.secret.child: initial dial-out failed <{C1}>';
    <[base.buffer.erase_secure]>->( \$secret );
    exit(1);
}
binmode($sock);
$sock->autoflush(1);

eval {
    while ( my $line = <$sock> ) {
        chomp $line;
        next if not length $line;

        my ($op) = split q| |, $line, 2;
        $op //= '';

        if ( $op eq qw| RELEASE | ) {
            print {$sock} sprintf( "OK %s\n", encode_b32r($secret) );
            last;    ## one release ends this child's life ##
        } else {
            print {$sock} sprintf( "ERR unknown op '%s'\n", $op );
        }
    }
};

warn sprintf( 'sessions.secret.child: fatal: %s <{C1}>', $EVAL_ERROR )
    if length $EVAL_ERROR;

<[base.buffer.erase_secure]>->( \$secret );
exit(0);

