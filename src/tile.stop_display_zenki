# name  = tile.stop_display_zenki
# descr = quick fix to avoid remaining x11 zenki on tile zenka restart

if ( defined <tile.startup.stop_zenki> ) {
    <[base.log]>->( 1, "stopping display zenki (if present)" );
    <[protocol-7.command.send.local]>->(
        {   'command'   => "cube.v7-zenki.terminate-implicit",
            'call_args' => { 'args' => <tile.startup.stop_zenki> }
        }
    );
}
if ( defined <tile.startup.restart_zenki> ) {
    <[base.log]>->( 1, "restarting display zenki (if present)" );
    <[protocol-7.command.send.local]>->(
        {   'command'   => "cube.v7-zenki.restart",
            'call_args' => { 'args' => <tile.startup.restart_zenki> }
        }
    );
}

