## [:< ##

# name  = system.watch.unless.finish
# descr = unless hook : a condition holds, no signal
# args  = owner, gate, state, reason
#
# once : the watch ends as skipped, what it waited for is no longer real.
# repeat : the held triggers are dropped, the watch goes on

my ( undef, $gate, undef, $reason ) = @ARG;
my $w = <system.watch.entries>->{ $gate->{'id'} } // return FALSE;
return FALSE if ( $w->{'gate'} // 0 ) != $gate;
delete @{$w}{qw| gate held |};
$w->{'reason'} = $reason;
$w->{'state'}  = qw| skipped | if $w->{'mode'} eq qw| once |;
<[base.logs]>->( 1, "watch '%s' skipped : %s", $w->{'id'}, $reason );
<system.watch.dirty> = TRUE;
<[system.watch.save]>;
return TRUE;

