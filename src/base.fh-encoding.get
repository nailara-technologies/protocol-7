## [:< ##

# name  = base.fh-encoding.get
# descr = retrieve file handle encoding mode from global %fh_encoding hash
# usage = <[base.fh-encoding.get]>->($fh)
# args  = $fh: file handle (GLOB) or filehandle reference
# returns = encoding_mode string if set, undef if not found

my ($fh) = @ARG;

if ( not defined $fh ) {
    return undef;
}

my $fd = fileno($fh);
if ( not defined $fd ) {
    return undef;    ## invalid file handle
}

return $fh_encoding{$fd};

