## [:< ##

# name  = graphics-matrix.cmd.orbital-sync
# descr = sync orbital state and return graphics-matrix summary
#
# notes = args 'subscribe' opens a STRM push channel instead, fed by
#         graphics-matrix.orbital.push_state_if_subscribed's own slow
#         timer [ no discrete mutation event exists for this summary ]

if ( defined $call->{'args'} and $call->{'args'} eq qw| subscribe | ) {
    return { 'mode' => qw| false |, 'data' => 'orbital push disabled' }
        unless
        <[base.cfg_bool]>->(<graphics-matrix.cfg.orbital_push_enabled>);

    my $h = <[base.stream.open]>->(
        {   'sid'    => $call->{'session_id'},
            'cmd_id' => $call->{'command_id'},
            'type'   => qw| STRM |,
            'total'  => undef,
        }
    );
    return { 'mode' => qw| false |, 'data' => 'stream open refused' }
        if not defined $h;

    <graphics-matrix.orbital.listeners> //= [];
    push <graphics-matrix.orbital.listeners>->@*, $h;
    <[base.logs]>->(
        2, 'orbital sync listener added [sid=%d]',
        $call->{'session_id'}
    );

    ## push the current snapshot immediately ##
    my $payload = <[graphics-matrix.orbital.build_summary]> . "\n";
    <[base.stream.push]>->( $h, \$payload );

    return { 'mode' => qw| deferred | };
}

return {
    qw| mode | => qw| size |,
    qw| data | => <[graphics-matrix.orbital.build_summary]>,
};

