# name  = site-yaml.cmd.export-stray-job
# descr = hand a single stranded record back to its consumer
#
# notes = see site-yaml.job.scan_stray ; record stays on disk until
#         jobsite confirms it was claimed ; 'size' mode reply
#         auto-fragments via STRM-SIZE if large, no manual chunking

<[base.perlmod.autoload]>->('JSON::XS');

my $id = $call->{'args'} // '';

return { 'mode' => 'false', 'data' => 'id required' } if not length $id;

my $entry = <site-yaml.stray_manifest>->{$id};
return { 'mode' => 'false', 'data' => 'unknown stray id [ re-list first ]' }
    if not defined $entry;

my $jobs_root = <[file.zenka_dir.data_path]> . '/jobs';
my $job_file  = "$jobs_root/$entry->{'status'}/$entry->{'name'}.yaml";

return { 'mode' => 'false', 'data' => 'no such stray job' }
    if not -f $job_file;

my ( $job, $yaml_err ) = <[format.yaml.load_file]>->($job_file);
return {
    'mode' => 'false',
    'data' => 'load error: ' . $yaml_err
    }
    if defined $yaml_err;

my $payload = JSON::XS::encode_json(
    {   'name'   => $entry->{'name'},
        'status' => $entry->{'status'},
        'job'    => $job
    }
);

return { 'mode' => 'size', 'data' => $payload };

