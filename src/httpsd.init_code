## [:< ##

# name = httpsd.init_code
# descr = initialize HTTPS/TLS server zenka - wraps httpd with TLS encryption

<[base.logs]>->( 2, 'initializing HTTPSD [HTTPS server] zenka.,' );

# HTTPD already initialized via [init_modules] since httpd is in modules.load
# Ensure timeout values are set for both httpd and httpsd contexts
<httpd.timeout>  //= 23;
<httpsd.timeout> //= 23;

## correct /var/httpd/ and vhost directories to httpd:httpsd [ as root ]
## httpsd group [ owner ] enables httpsd process to read web content
if ( <system.zenka.name> eq qw| httpsd | and $EUID == 0 ) {
    my $site_dir = <httpd.site_dir> // qw| /var/httpd |;
    my ( undef, undef, $httpd_uid ) = getpwnam(qw| httpd |);
    my $httpsd_gid = getgrnam(qw| httpsd |);

    if ( defined $httpd_uid and defined $httpsd_gid and -d $site_dir ) {
        foreach my $dir ( $site_dir, glob( $site_dir . '/*' ) ) {
            next unless -d $dir;
            ## 'skins' sits alongside the vhost dirs but isn't one -- it's ##
            ## web zenka's own content area [ web.init_code, protocol-7-   ##
            ## owned, only web reads it, httpd/httpsd never touch it ] --  ##
            ## this blanket vhost-normalization sweep was overwriting that ##
            ## ownership on every httpsd (re)start                         ##
            next if $dir =~ m{/skins$};
            chown( $httpd_uid, $httpsd_gid, $dir )
                or <[base.logs]>->(
                0,    'chown httpd:httpsd [ %s ] : %s',
                $dir, <[base.str.os_err]>
                );
        }
        <[base.logs]>->( 2, 'set ownership httpd:httpsd : %s', $site_dir );
    } else {
        <[base.logs]>->( 1, 'httpsd group not found : skipping chown' )
            unless defined $httpsd_gid;
    }
}

# critical fix: ensure httpd.cfg.hostnames has default entries
# httpd.scan_site_dir initializes as empty, then populates from /var/httpd
# if no vhosts exist, we must add defaults for localhost/127.0.0.1
unless ( defined <httpd.cfg.hostnames> ) {
    <httpd.cfg.hostnames> = {};
}

## set defaults with actual directory paths [not just 1/TRUE values] force
## overwrite any placeholder values from  httpd.determine_host initialization
my $site_dir = <httpd.site_dir>;
$site_dir =~ s|/$|| if $site_dir ne '/';
my $default_dir = $site_dir . qw| /default |;

foreach my $hostname (qw| default localhost 127.0.0.1 |) {
    my $current_val = <httpd.cfg.hostnames>->{$hostname};
    ## overwrite placeholder [1] or missing values with actual directory path
    if ( !defined $current_val or $current_val eq '1' or !-d $current_val ) {
        <httpd.cfg.hostnames>->{$hostname} = $default_dir;
        <[base.logs]>->(
            2,         "  set httpd.cfg.hostnames->[%s] = %s",
            $hostname, $default_dir
        );
    }
}

<[base.log]>->(
    2,
    'initialized default hostnames for HTTP/HTTPS '
        . 'routing : default, localhost, 127.0.0.1'
);

# critical fix: copy HTTPS handler configurations to HTTP namespace
# httpd.request_handler looks for handlers in <http.handler> namespace,
# but httpsd config defines them as <https.handler.*>
# solution: copy https.handler.* to http.handler.* so lookup works
if ( defined <https.handler.get> ) {
    <http.handler.get>     = <https.handler.get>;
    <http.handler.head>    = <https.handler.head>    // <https.handler.get>;
    <http.handler.post>    = <https.handler.post>    // <https.handler.get>;
    <http.handler.options> = <https.handler.options> // <https.handler.get>;
    <[base.log]>->(
        2,
        'copied https.handler.* definitions '
            . 'to http.handler.* for httpd lookup'
    );
}

# httpsd-specific TLS configuration [added to httpd config]
<httpsd.cfg.tls_version>  //= qw| TLSv1_3:TLSv1_2 |;
<httpsd.cfg.cipher_suite> //= 'ECDHE-RSA-AES256-GCM-SHA384:'
    . 'ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-CHACHA20-POLY1305';
<httpsd.cfg.certificate_path>        //= '/etc/protocol-7/certs/default.pem';
<httpsd.cfg.key_path>                //= '/etc/protocol-7/certs/default.key';
<httpsd.cfg.hsts_max_age>            //= 31536000;
<httpsd.cfg.hsts_include_subdomains> //= 1;
<httpsd.cfg.ssl_handshake_timeout>
    //= 10;    # seconds, for non-blocking SSL accept

# protocol state for HTTPS [using 'https' protocol instead of 'http']
# create HTTPS state with httpsd.request_handler for input [overriding HTTP]
# critical: read-mode=binary to handle SSL frames properly [16KB chunks]
# critical: bytes-to-read=16384 matches IO::Socket::SSL frame size limit
<protocol.https.state> = {
    '0' => {
        'read-mode'     => qw| binary |,
        'bytes-to-read' => 16384,
        'input'         => { 'handler' => qw| httpsd.request_handler | },
        'output'        => { 'handler' => qw| base.handler.write | }
    }
};
<protocol.https.connect.banner> = '';

<[base.logs]>->(
    2,
    "[protocol-7] configured https protocol state with httpsd.request_handler"
);

# critical fix: register SSL socket type and HTTPS protocol handlers
# this allows base.handler.connect to find the handlers
# when a TLS connection arrives

# register IO::Socket::SSL type handlers [for listening socket]
$data{'io'}{'type'}{'ip.ssl'} = {
    'ref'     => qw| IO::Socket::SSL |,
    'handler' => {
        'output' => {
            'open'  => 'io.ssl.ip.output.open',
            'close' => 'io.ssl.ip.output.close',
            'read'  => 'base.handler.read',
            'write' => 'base.handler.write'
        },
        'input' => {
            'open'    => 'io.ssl.ip.input.open',
            'close'   => 'io.ssl.ip.input.close',
            'connect' => 'io.ssl.ip.input.connect',
            'read'    => 'base.handler.read',
            'write'   => 'base.handler.write'
        }
    }
};

# register HTTPS protocol with httpsd.request_handler bridge
# httpsd.request_handler delegates to httpd.request_handler for HTTP parsing
# TLS encryption/decryption is transparent at IO::Socket::SSL layer
$data{'protocol'}{'https'} = {
    'connect' => {
        'callback' => undef,
        'banner'   => ''
    },
    'state' => <protocol.https.state>
};

<[base.logs]>->(
    2, 'registered SSL socket type [ip.ssl] and HTTPS protocol handlers'
);

# session management for HTTPS
<httpsd.sessions>         = {};
<httpsd.connection_count> = 0;

# SSL handshake tracking for non-blocking accept
$data{'ssl_handshake'} = {};

# performance metrics
<httpsd.metrics> = {
    handshakes_successful => 0,
    handshakes_failed     => 0,
    connections_active    => 0,
    total_bytes_encrypted => 0,
    total_bytes_decrypted => 0,
    avg_handshake_time    => 0,
};

## crash-capture buffer : initialize or clean up depending on feature state ##
if ( <[base.cfg_bool]>->( <httpsd.cfg.request_capture> // 1 ) ) {

    <httpsd.path.request_capture> //= qw| /dev/shm/httpsd-last-request |;
    ##
    ## buffer 'httpsd-crash-log' initialized ondemand when required  ##
    ############################  in httpsd.request_capture.collect  ##

    ## register end_code callback once : guards against re-init double-push ##
    if ( not <httpsd.request_capture.cb_registered> ) {
        push <callbacks.end_code>->@*, qw| httpsd.callback.reset-capture |;
        <httpsd.request_capture.cb_registered> = TRUE;
        <[base.log]>->( 1, '::[ crash mitigation ]:.' );
        <[base.log]>->( 1, ': request capture registerd..' );
    }
}

<[base.logs]>->( 2, 'HTTPSD initialization complete' );
<[base.logs]>->( 2, "  TLS Version : %s", <httpsd.cfg.tls_version> );
<[base.logs]>->( 2, "  Certificate : %s", <httpsd.cfg.certificate_path> );

0;

