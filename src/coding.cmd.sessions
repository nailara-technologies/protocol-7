## [:< ##

# name  = coding.cmd.sessions
# descr = known sessions, activity and keep-alive

my $all = <[coding.sessions.store]>;
return { 'mode' => qw| true |, 'data' => 'no session known' }
    if not keys %{$all};
my $ago = sub {
    my $at = shift // return '-';
    ## the shared formatter [ days hours mins secs ], whole seconds ##
    return <[base.parser.duration]>->( $at, 0, qw| unix | ) . ' ago';
};
my @lines
    = ( sprintf "%-24s %-12s %-10s %s\n", qw| name type active keep-alive | );
foreach my $name ( sort keys %{$all} ) {
    my $r     = $all->{$name};
    my $on    = $r->{'switch'} eq qw| on |;
    my $ended = $on && AMOS7::Switch::expired( $r->{'until'}, time );
    my $state
        = ( $on and not $ended )
        ? sprintf(
        'on [ %d of %d%s ]',
        $r->{'count'} // 0,
        <coding.cfg.keepalive_max> // 6,
        $r->{'until'}
        ? sprintf( ', %dm left', ( $r->{'until'} - time ) / 60 )
        : ''
        )
        : 'off'
        . (
          $ended       ? ' [ its time ended ]'
        : $r->{'note'} ? " [ $r->{'note'} ]"
        :                ''
        );
    $state .= " # pending : $r->{'pending'}"
        if length( $r->{'pending'} // '' );
    push @lines, sprintf "%-24s %-12s %-10s %s\n", $name, $r->{'type'},
        $ago->( $r->{'last'} ), $state;
}
return { 'mode' => qw| size |, 'data' => join '', @lines };

