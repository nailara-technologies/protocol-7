## [:< ##

# name  = debian.start.apt_child
# descr = fork the generic root runner before the privilege drop
# note  = AMOS7::deps::root_runner : detects the os family itself, installs
#         through AMOS7::deps::backend::<family>::install, 'cpan' via cpanm

return if defined <debian.apt_child.w_fh>;
return if $UID != 0 and $EUID != 0;          ## must be root to fork ##

<system.path.perl_bin> //= <[base.get_path.perl_exec]>;

foreach my $pm (qw| IPC::Open2 Cwd AMOS7::deps::root_runner |) {
    <[base.perlmod.load]>->($pm) if not <[base.perlmod.loaded]>->($pm);
}

## everything the child gets is decided HERE, still as root : the lib root ##
## [ resolved, no symlinks left ], the zenka user's uid                    ##
## [ refused as owner of anything it loads ] and the process label         ##
my $lib_root
    = Cwd::abs_path( sprintf( '%s/data/lib-path/pm', <system.root_path> ) );
my $zenka_user = <system.amos-zenka-user>;
my $deny_uid
    = defined $zenka_user ? scalar( ( getpwnam($zenka_user) )[2] ) : undef;

if ( not defined $lib_root or not defined $deny_uid ) {
    <[base.logs]>->(
        0,
        'debian: root runner not started [ %s ]',
        not defined $lib_root
        ? 'no lib path'
        : sprintf( "no uid for zenka user '%s'", $zenka_user // '' )
    );
    return;
}

## the runner file is loaded by absolute path before its own @INC hook ##
## exists : checked here first [ same owner \ mode walk ]              ##
my ( $state, $why )
    = AMOS7::deps::root_runner::check_path( $lib_root,
    qw| AMOS7/deps/root_runner.pm |, $deny_uid );
if ( $state ne qw| ok | ) {
    <[base.logs]>->( 0, 'debian: root runner refused : %s', $why );
    return;
}

my @argv = AMOS7::deps::root_runner::spawn_argv( <system.path.perl_bin>,
    $lib_root, $deny_uid, qw| debian | );

## no perl environment from this process may change what the child loads ##
{
    my @perl_env = AMOS7::deps::root_runner::perl_env_names();
    local @ENV{@perl_env};
    delete @ENV{@perl_env};

    <debian.apt_child.pid>
        = IPC::Open2::open2( <debian.apt_child.r_fh>,
        <debian.apt_child.w_fh>, @argv )
        || die sprintf( "cannot start root runner process [ %s ]\n",
        scalar <[base.format_error]>->($OS_ERROR) );
}

## start-up line : '+ ready ..' or '- refused : <reason>'              ##
## [ unsafe lib tree ] -- a refused runner leaves no w_fh, the install ##
## paths answer 'not available' instead of writing to a gone process   ##
my $status
    = AMOS7::deps::root_runner::read_status( <debian.apt_child.r_fh>, 20 );

if ( not defined $status or $status !~ m|^\+ ready | ) {
    <[base.logs]>->(
        0,
        'debian: root runner refused to start : %s',
        defined $status ? $status =~ s|^- refused : ||r : 'no start-up line'
    );
    close(<debian.apt_child.w_fh>);
    close(<debian.apt_child.r_fh>);
    kill( 'TERM', <debian.apt_child.pid> );    ## a refused one is gone ##
    waitpid( <debian.apt_child.pid>, 0 );
    <debian.apt_child.w_fh> = undef;
    <debian.apt_child.r_fh> = undef;
    <debian.apt_child.pid>  = undef;
    return;
}

## register with v7-zenki for lifecycle management : gets terminated \ ##
## restarted along with this zenka instead of surviving as an orphan   ##
## [ same precedent as coding.spawn_inference_server ]                 ##
<[base.zenki.report_child_pid]>->(<debian.apt_child.pid>);

<[base.logs]>->(
    1,                      'debian: root runner started [pid:%d] %s',
    <debian.apt_child.pid>, $status =~ s|^\+ ready ||r
);

