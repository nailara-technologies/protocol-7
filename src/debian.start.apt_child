## [:< ##

# name  = debian.start.apt_child
# descr = fork root child for apt-get before privilege drop

return if defined <debian.apt_child.w_fh>;
return if $UID != 0 and $EUID != 0;          ## must be root to fork ##

<system.path.perl_bin> //= <[base.get_path.perl_exec]>;

<[base.perlmod.load]>->('IPC::Open2')
    if not <[base.perlmod.loaded]>->('IPC::Open2');

## child reads install commands on stdin, replies with output + exit code ##
my $child_code = <<~'EOT';
use strict; use warnings;
local $ENV{'APT_LISTCHANGES_FRONTEND'} = 'none';
local $ENV{'UCF_FORCE_CONFFOLD'}       = 'true';
local $ENV{'UCF_FORCE_CONFMISS'}       = 'true';
local $ENV{'DEBCONF_PRIORITY'}         = 'critical';
local $ENV{'PAGER'}                    = '/bin/true';
local $ENV{'LANG'}                     = 'en_US.UTF-8';
local $ENV{'DEBIAN_FRONTEND'}          = 'noninteractive';
$| = 1;
$0 = 'debian[apt-child:idle]';    ## recognizable in ps, doubles as a  ##
                                  ## live status display while running ##
## the commands come from the unprivileged zenka process : every name is ##
## checked HERE again and nothing goes through a shell [ list-form exec ] ##
## -- the parent's check alone would leave a root shell to whoever can    ##
## write to this pipe                                                     ##
my $pkg_re = qr|^[a-z0-9][a-z0-9.+\-~]*$|;
my $mod_re = qr|^[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z0-9_]+)*$|;

## cpanm : fixed locations only, never a path from the parent ##
my ($cpanm) = grep { -x $_ } qw| /usr/bin/cpanm /usr/local/bin/cpanm |;

my $run = sub {    ## command list -> '> ' output lines, '< N' exit code ##
    my $pid = open( my $fh, '-|' );
    if ( not defined $pid ) { print "< 1\n"; return }
    if ( $pid == 0 ) {
        open( STDERR, '>&', \*STDOUT );
        exec {$_[0]} @_;
        exit 127;
    }
    while ( my $out = <$fh> ) { print "> $out" }
    close($fh);
    printf "< %d\n", $? >> 8;
};

while ( my $line = <STDIN> ) {
    chomp $line;
    last unless length $line;
    if ( $line =~ m|^install (.+)$| ) {
        my @pkgs = split /\s+/, $1;
        if ( grep { $_ !~ $pkg_re } @pkgs ) {
            print "> refused : invalid package name\n< 1\n";
            next;
        }
        $0 = sprintf 'debian[apt-child:installing %s]', join( ' ', @pkgs );
        $run->( qw| apt-get -fy install |, @pkgs );
        $0 = 'debian[apt-child:idle]';
    } elsif ( $line =~ m|^cpan (.+)$| ) {
        my @mods = split /\s+/, $1;
        if ( grep { $_ !~ $mod_re } @mods ) {
            print "> refused : invalid module name\n< 1\n";
            next;
        }
        if ( not defined $cpanm ) {
            print "> refused : no cpanm [ apt : cpanminus ]\n< 1\n";
            next;
        }
        $0 = sprintf 'debian[apt-child:cpan %s]', join( ' ', @mods );
        $run->( $cpanm, qw| --quiet --notest |, @mods );
        $0 = 'debian[apt-child:idle]';
    } elsif ( $line eq 'exit' ) {
        last;
    } else {
        print "< 1\n";    ## unknown command ##
    }
}
EOT

<debian.apt_child.pid>
    = IPC::Open2::open2( <debian.apt_child.r_fh>, <debian.apt_child.w_fh>,
    <system.path.perl_bin>, qw| -e |, $child_code )
    || die sprintf( "cannot start apt child process [ %s ]\n",
    scalar <[base.format_error]>->($OS_ERROR) );

## register with v7-zenki for lifecycle management : gets terminated \ ##
## restarted along with this zenka instead of surviving as an orphan   ##
## [ same precedent as coding.spawn_inference_server ]                 ##
<[base.zenki.report_child_pid]>->(<debian.apt_child.pid>);

<[base.logs]>->(
    1, 'debian: apt-child started [pid:%d]',
    <debian.apt_child.pid>
);

