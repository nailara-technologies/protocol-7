## [:< ##

# name   = coding.handover.sources
# descr  = the commands the handover state is read from
# return = { source => [ command, args ] }
#
# each answer replaces the last one of its source [ text and time ] ;
# what the coding zenka holds itself [ sign queue, its parks ] and the git
# state are read when the block is rendered

return {
    'claude'   => [ qw| claude.status |,   '' ],
    'kimi'     => [ qw| kimi.acp-status |, '' ],
    'decision' =>
        [ qw| protocol-7-menu.pending-question-list |, qw| decisions | ],
    'task' => [ qw| task.queue |, qw| status=parked | ]
};

