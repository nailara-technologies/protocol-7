## [:< ##

# name  = claude.cmd.context-size
# param = <sid> [ <sid> .. ]
# descr = context tokens per session, 0 after a compaction

## one line per session : sid tokens [ '-' unknown ] -- the keep-alive ##
## round skips small contexts, cheap to rebuild [ coding, 2026-11-28 ] ##
my @sids = grep {length} split m{\s+}, $call->{'args'} // '';
return { 'mode' => qw| false |, 'data' => 'sid : one or more expected' }
    if not @sids;
my @out;
foreach my $sid (@sids) {
    my $tokens = <[claude.context.usage]>->($sid);
    push @out, sprintf '%s %s', $sid, $tokens // '-';
}
return { 'mode' => qw| size |, 'data' => join( "\n", @out ) . "\n" };

