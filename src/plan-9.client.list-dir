## [:< ##
# name  = plan-9.client.list-dir
# descr = List directory contents from 9P server

my ( $client_name, $path ) = @ARG;

my $client = <plan-9.client>->{$client_name};
return { 'mode' => 'false', 'data' => 'client not found' } unless $client;

# Walk to directory
my @parts = grep {length} split m|/|, $path;
my $fid   = $client->{next_fid}++;

my $walk_result;
if (@parts) {
    $walk_result = <[plan-9.client.walk]>
        ->( $client, $client->{root_fid}, $fid, @parts );
} else {

    # Root directory
    $walk_result
        = <[plan-9.client.walk]>->( $client, $client->{root_fid}, $fid );
}
return $walk_result if $walk_result->{'mode'} eq 'false';

# Open directory
my $open_result = <[plan-9.client.open]>->( $client, $fid, 0 );    # OREAD
return $open_result if $open_result->{'mode'} eq 'false';

# Read directory entries
my @entries;
my $offset = 0;
my $iounit = $client->{fids}{$fid}{iounit} // 8192;

while (1) {
    my $read_result
        = <[plan-9.client.read]>->( $client, $fid, $offset, $iounit );
    last if $read_result->{'mode'} eq 'false';

    my $data = $read_result->{'data'};
    last if length($data) == 0;

    # Parse directory entries (stat structures)
    my $pos = 0;
    while ( $pos < length($data) ) {
        last if $pos + 2 > length($data);
        my $stat_size = <[plan-9.protocol.codec.decode-uint16]>
            ->( substr( $data, $pos, 2 ) );
        last if $pos + 2 + $stat_size > length($data);

        my $stat_data = substr( $data, $pos + 2, $stat_size );
        $pos += 2 + $stat_size;

        # Extract name from stat
        # $stat_data excludes the entry's leading size[2] field, so name
        # starts at 2+4+13+4+4+4+8 = 39 (type dev qid mode atime mtime
        # length), not 41.
        my $name_pos = 2 + 4 + 13 + 4 + 4 + 4 + 8;    # Skip to name field
        next if $name_pos >= length($stat_data);

        my ( $name, $rest )
            = <[plan-9.protocol.codec.decode-string]>
            ->( substr( $stat_data, $name_pos ) );
        push @entries, $name if length($name);
    }

    $offset += length($data);
    last if length($data) < $iounit;
}

# Clunk fid
<[plan-9.client.clunk]>->( $client, $fid );

return { 'mode' => 'true', 'data' => \@entries };

