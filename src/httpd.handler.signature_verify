# name  = httpd.handler.signature_verify
# descr = collect a child signature result without blocking the event loop

my $event   = shift;
my $id      = $event->w->data->{'id'};
my $session = $data{'session'}{$id};
return FALSE if not defined $session;
my $pending = $session->{'signature_pending'};
return FALSE if not defined $pending;

my $watcher = $session->{'watcher'}->{'signature_handler'};
my $read_fh = $event->w->fd;
my $read    = sysread( $read_fh, my $chunk, 4096 );
if ( defined $read and $read > 0 ) {
    $pending->{'result'} .= $chunk;
    return TRUE;
}
if ( not defined $read
    and ( $OS_ERROR == Errno::EAGAIN() or $OS_ERROR == Errno::EWOULDBLOCK() )
) {
    return TRUE;
}

$watcher->cancel;
close $read_fh;
waitpid( $pending->{'pid'}, 0 );
delete $session->{'watcher'}->{'signature_handler'};
delete $session->{'signature_pending'};

my $result = $pending->{'result'} // '';
if (<httpd.cfg.signature_debug>) {
    foreach my $line ( $result =~ m{^debug ([^\n]*)\n}mg ) {
        <[base.logs]>->(
            1,   '[%d] signed-file debug : %s : %s',
            $id, $pending->{'handler_args'}{'path'} // '', $line
        );
    }
}
$result =~ s{^debug [^\n]*\n}{}mg;
foreach my $warning ( $result =~ m{^cache-warning ([^\n]*)\n}mg ) {
    <[base.logs]>->(
        1,   '[%d] signed-file persistent cache : %s',
        $id, $warning
    );
}
$result =~ s{^cache-warning [^\n]*\n}{}mg;
my ($origin) = $result =~ m{^origin (full|persistent)\n};
$origin //= qw| full |;
$result =~ s{^origin (?:full|persistent)\n}{};
my ( $status, $error ) = $result =~ m{^(valid|unsigned|invalid) ?([^\n]*)};
$status //= qw| invalid |;
$error = 'child-result' if not length $error and $status eq qw| invalid |;

if ( $status eq qw| valid | and ( $error // '' ) eq qw| generated | ) {
    my ( $public_b32, $chain )
        = $result =~ m|\Avalid generated\n([A-Z2-7]{52})\n([A-Z2-7.]*)\n\z|;
    my $public_key
        = defined $public_b32 ? eval { decode_b32r($public_b32) } : undef;
    my ( $trusted, $trust_error );
    ( $trusted, $trust_error ) = <[httpd.generator_key_trust]>->(
        {   qw| vhost      | => $session->{'http_host'}            // '',
            qw| path       | => $pending->{'handler_args'}{'path'} // '',
            qw| public_key | => $public_key                        // '',
            qw| chain      | => $chain                             // '',
        }
    ) if defined $public_key and length($public_key) == 32;
    if ( ref $trusted ne qw| HASH | ) {
        $status = qw| invalid |;
        $error = sprintf qw| generator-%s |, $trust_error // qw| public-key |;
    }
}

my $cache_entry = {
    qw| identity | => $pending->{'identity'},
    qw| status   | => $status,
    qw| error    | => $error,
    qw| verifies | => 1,
    qw| hits     | => 0
};
if ( $status eq qw| valid | and -f $pending->{'body_path'} ) {
    $cache_entry->{'body_path'} = $pending->{'body_path'};
    $cache_entry->{'body_size'} = -s $pending->{'body_path'};
    my $file_max = <httpd.cfg.signature_memory_file_max> // 256 * 1024;
    if ( $cache_entry->{'body_size'} <= $file_max ) {
        $cache_entry->{'body_ref'}
            = <[file.slurp]>->( $pending->{'body_path'}, undef, qw| :raw | );
    }
} else {
    unlink $pending->{'body_path'};
    $status = $cache_entry->{'status'} = qw| invalid |
        if $status eq qw| valid |;
    $cache_entry->{'error'} = qw| temporary-body |
        if $cache_entry->{'status'} eq qw| invalid | and not length $error;
}

$cache_entry->{'origin'} = $origin;
<[httpd.signature_memory_store]>->( $pending->{'file_path'}, $cache_entry );
<[httpd.signature_watch]>->( $pending->{'file_path'} );
if ( $origin eq qw| persistent | ) {
    <httpd.signature.persistent_hits>++;
} else {
    <httpd.signature.verify_count>++;
}

return <[httpd.serve_static]>->( $id, $pending->{'handler_args'} );

