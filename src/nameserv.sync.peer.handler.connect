## [:< ##

# name  = nameserv.sync.peer.handler.connect
# descr = writability watch for a pending peer long-poll connect

my $key = shift->w->data;

my $peers = <nameserv.sync.peers> // return;
my $peer  = $peers->{$key}        // return;

my $sock = $peer->{'sock'};

## completing an in-progress non-blocking connect needs another connect()   ##
## call on this io.socket.ip : plain connected() never turns true while its ##
## internal flag is set                                                     ##
if ( $sock->connect ) {
    <[nameserv.sync.peer.connected]>->($key);
} elsif ( not $OS_ERROR{EINPROGRESS}
    and not $OS_ERROR{EWOULDBLOCK}
    and not $OS_ERROR{EALREADY} ) {
    ## hard connect error : try the next address ##
    <[nameserv.sync.peer.next-addr]>->(
        $key, sprintf 'connect : %s',
        <[base.str.os_err]>
    );
}
## still in progress : the watcher fires again on the next event ##

return TRUE;

