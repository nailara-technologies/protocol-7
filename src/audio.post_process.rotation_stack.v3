## [:< ##

# name  = audio.post_process.rotation_stack.v3
# descr = v2's equal-weight blend, gentle color boost + tinted background
# param = $img_path [, $opts_href ]

## same family as v1/v2/v4, a tuning pass on v2's equal-weight rotation    ##
## blend rather than a new operation. built after user asked for "boosted  ##
## colors" -- first attempt (1.7x scale + autolevels) washed out the cool  ##
## indigo/blue/violet palette entirely, since autolevels stretches each    ##
## channel's min/max to full range and this image is mostly black with     ##
## sparse bright pixels, so nearly everything bright clips to max. dropped ##
## autolevels, landed on a gentle uniform channel scale instead (default   ##
## 1.6x) which keeps the palette's relative color relationships intact.    ##
##                                                                         ##
## also replaces the pure-black canvas fill with a slightly blue-tinted    ##
## background (default #000013) -- reads as having real depth rather than  ##
## flat black, without being bright enough to compete with the foreground. ##
## user's own note: #000013 was tuned for this layer ALONE -- once a       ##
## waveform overlay (see audio.overlay.waveform_trace.v1) is drawn on top, ##
## a darker tint like #000007 likely gives the neon foreground more        ##
## contrast headroom, so this is exposed as an opt rather than fixed.      ##
##                                                                         ##
## pure post-process core : reads/rewrites only the given path, no         ##
## protocol-7 data or code path access                                     ##
##                                                                         ##
## returns ( TRUE, $img_path ) or ( FALSE, $error_string )                 ##

my ( $img_path, $opts ) = @ARG;
$opts //= {};

return ( FALSE, 'expected an image path' ) if not defined $img_path;

my $base = Imager->new( 'file' => $img_path );
return ( FALSE, 'imager read failed : ' . Imager->errstr )
    if not defined $base;

my ( $w, $h ) = ( $base->getwidth, $base->getheight );

my $bg_tint_aref = $opts->{'bg_tint'} // [ 0, 0, 0x13 ];
my $boost        = $opts->{'boost'}   // 1.6;

my $stack = Imager->new(
    'xsize'    => $w,
    'ysize'    => $h,
    'channels' => 3
);
$stack->box(
    'filled' => 1,
    'color'  => Imager::Color->new( $bg_tint_aref->@* )
);

my $layer = $base;
foreach ( 1 .. 4 ) {
    my $scaled = $layer->convert(
        'matrix' => [ [ 0.25, 0, 0 ], [ 0, 0.25, 0 ], [ 0, 0, 0.25 ] ] );
    $stack->compose(
        'src'     => $scaled,
        'tx'      => 0,
        'ty'      => 0,
        'combine' => 'add'
    );
    $layer = $layer->rotate( 'degrees' => 90 );
}

$stack = $stack->convert(
    'matrix' => [ [ $boost, 0, 0 ], [ 0, $boost, 0 ], [ 0, 0, $boost ] ] );

my $ok = $stack->write( 'file' => $img_path, 'type' => 'png' );
return ( FALSE, 'imager write failed : ' . Imager->errstr ) unless $ok;

return ( TRUE, $img_path );

