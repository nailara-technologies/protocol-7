## [:< ##

# name  = base.parser.duration
# descr = return duration since given unix time [ days hours mins + seconds ]
# param = <start_time> [precision] [scale: 'unix'|'ntime']
# note  = this subroutine version is ignoring 'leap years' entirely

my @result;
my $start_time = shift;
my $precision  = shift;    ## optional [ overrides input param precision ] ##
my $scale      = shift;    ## optional : 'unix'|'ntime' -- see below       ##

return qw|n/a| if not defined $start_time or $start_time !~ m|^\d+(\.\d+)?$|;

## capture precision from the ORIGINAL input's decimal length before the ##
## network-time conversion below runs its own regexes and clobbers       ##
## $LAST_PAREN_MATCH [ it is $1, call-stack independent ]                ##
$precision //= defined $LAST_PAREN_MATCH ? length $LAST_PAREN_MATCH : 2;

## a raw ntime value is a different scale entirely from unix time           ##
## [ 4200 ntime units per real second, see base.ntime.delta_seconds ] --    ##
## subtracting one from unix time unconverted produces a                    ##
## multi-trillion-second bogus duration [ this was live-caught via          ##
## note_list's 'created' field, always ntime-sourced ]                      ##
##                                                                          ##
## without an explicit $scale this falls back to guessing from magnitude    ##
## [ matches base.parser.timestamp's own network-time detection ], which is ##
## ambiguous near the low end : a small value could be an early ntime tick  ##
## or a genuine near-1970 unix time, indistinguishable by digit count       ##
## alone. pass $scale explicitly whenever the caller already knows which    ##
## one it has -- e.g. a note's `created` field is always ntime, regardless  ##
## of how many digits it happens to have today                              ##
my $is_ntime
    = defined $scale
    ? ( $scale eq qw| ntime | )
    : ( length( int($start_time) ) >= 13 );    ##  <-- network time ?  ##

my $secs;
if ($is_ntime) {

    ## base.ntime.delta_seconds already does ( now - start ) / 4200 -- the  ##
    ## same primitive coding.cmd.list-tasks was fixed to use for this exact ##
    ## class of bug on 2026-08-19 [ commit 5bf722767 ]                      ##
    $secs = Time::Seconds->new( <[base.ntime.delta_seconds]>->($start_time) );
} else {

    ## 'now' at full precision : truncated to the display precision first, ##
    ## a just-opened session [ start_time has 5 decimals ] showed '-0.00s' ##
    my $delta = <[base.time]>->(7) - $start_time;
    $delta = 0 if $delta < 0;    ## a clock step back is no negative age ##
    $secs  = Time::Seconds->new( sprintf qw| %.*f |, $precision, $delta );
}

my %result = (
    qw| days    | => 0,
    qw| years   | => 0,
    qw| hours   | => 0,
    qw| seconds | => 0,
    qw| minutes | => 0,
);

if ( $secs >= ONE_YEAR() ) {
    $result{'years'} = int( $secs / ONE_YEAR() );
    $secs -= $result{'years'} * ONE_YEAR();
}

if ( $secs >= ONE_DAY() ) {
    $result{'days'} = int( $secs->days );
    $secs -= $result{'days'} * ONE_DAY();
}

if ( $secs >= ONE_HOUR() ) {
    $result{'hours'} = int( $secs->hours );
    $secs -= $result{'hours'} * ONE_HOUR();
}
if ( $secs >= ONE_MINUTE() ) {
    $result{'minutes'} = int( $secs->minutes );
    $secs -= $result{'minutes'} * ONE_MINUTE();
}
$result{'seconds'} = sprintf qw| %.*f |, $precision, $secs->seconds if $secs;

if ( $result{'years'} and not $result{'days'} ) {
    push @result, sprintf '%d year%s', $result{'years'},
        <[base.cnt_s]>->( $result{'years'} );
} elsif ( $result{'years'} ) {
    push @result, sprintf( qw| %dy |, $result{'years'} );
}

if ( $result{'days'} and $result{'years'} and defined $result{'yday'} ) {
    push @result, sprintf qw| %dd |, $result{'yday'};

} elsif ( $result{'days'} ) {
    push @result, sprintf '%d day%s', $result{'days'},
        <[base.cnt_s]>->( $result{'days'} );
}

if ( $result{'hours'} and $result{'minutes'} == $result{'seconds'} == 0 ) {
    push @result, sprintf '%d hour%s', $result{'hours'},
        <[base.cnt_s]>->( $result{'hours'} );

} elsif ( $result{'hours'} ) {
    push @result, sprintf qw| %02dh |, $result{'hours'};
}

if ( $result{'minutes'} and $result{'seconds'} == 0 ) {
    push @result, sprintf '%d min', $result{'minutes'};

} elsif ( $result{'minutes'} ) {
    if ( $result{'hours'} ) {
        push @result, sprintf qw| %02d'%02d" |, $result{'minutes'},
            $result{'seconds'};
    } else {
        push @result, sprintf qw| %d'%02d" |, $result{'minutes'},
            $result{'seconds'};
    }
}

push @result, sprintf qw| %ss |, $result{seconds}
    if $result{'seconds'} and not $result{'minutes'} or not @result;

my $result_str = join ' ', @result;
$result_str =~ s| days? (\d+)h |d $1 | if length $result_str >= 10;
$result_str =~ s|(\d+d)(\d+ hours)|$1 $2 |;

return $result_str;

