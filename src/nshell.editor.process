## [:< ##

# name = nshell.editor.process
# descr = Main dispatcher for editor operations
#         (character insertion, deletion, newline)

my ( $editor, $key, $colors ) = @ARG;

## Tab cycles the display mode [ shell / coding-session / ... ] --          ##
## intercepted here, before the editor engine, since Tab has no existing    ##
## binding there [ confirmed : editor.control.process_key has no Tab branch ##
## ]                                                                        ##
if ( $key eq "\t" ) {
    <[nshell.display.cycle]>;
    return undef;
}

## Esc : let the current mode's plugin react [ abort-then-keep-buffer on   ##
## first press, clear-leftover-buffer on a second press with nothing to    ##
## abort -- see plugin.nshell.coding-session.on_escape ]. only CLAIMED if  ##
## the plugin actually wants it -- otherwise falls through to the normal   ##
## editor engine below unchanged, so Esc's existing meanings [ search-mode ##
## cancel, VIEWING_HISTORY exit ] keep working when there is nothing       ##
## coding-zenka-specific to do. avoids the historical "Esc needs pressing  ##
## twice" class of bug from claiming a key the editor engine already       ##
## handles itself.                                                         ##
if ( $key eq "\e" ) {
    my $state_ref = <nshell.state> // {};
    my $modes     = $state_ref->{'display_modes'};
    my $mode
        = ref $modes eq 'ARRAY'
        ? $modes->[ $state_ref->{'display_mode_index'} // 0 ]
        : undef;
    my $plugin_name = defined $mode ? $mode->{'plugin'} : undef;

    if ( length( $plugin_name // '' ) ) {
        my $plugin_result
            = $code{$plugin_name}
            ->( { 'hook' => 'on_escape', 'mode' => $mode } );

        if ( ref $plugin_result eq 'HASH' and $plugin_result->{'claimed'} ) {
            if ( $plugin_result->{'redraw'} and $state_ref->{'split_active'} )
            {
                ## clear + re-establish the same scroll region : wipes the ##
                ## content area's visible text for a fresh tab, same       ##
                ## mechanics as nshell.display.cycle's mode switch         ##
                my $reserved = $state_ref->{'split_reserved_rows'} // 2;
                AMOS7::TERM::scroll_region_clear($reserved);
                my $content_bottom
                    = AMOS7::TERM::scroll_region_set($reserved);
                if ( defined $content_bottom ) {
                    $state_ref->{'split_row'} = $content_bottom + $reserved;
                }
                $state_ref->{'content_col'} = 1;
            }
            $editor //= <[editor.control.create]>
                ->(<[nshell.editor.default_schema]>);
            <[nshell.render.viewport]>->( $editor, $colors );
            return undef;
        }
    }
    ## not claimed : fall through to the normal editor engine below ##
}

## Initialize editor on first key
$editor //= <[editor.control.create]>->(<[nshell.editor.default_schema]>);

## Process key through editor
my $edit_result = <[editor.control.process_key]>->( $editor, $key );

return unless defined $edit_result;

my $action = $edit_result->{action};

## helper: redraw with cursor [ viewport-aware for overflow lines ]
my $redraw_with_cursor = sub {
    <[nshell.render.viewport]>->( $editor, $colors );
};

## Character insertion (echo action)
if ( $action eq 'echo' ) {
    $redraw_with_cursor->();
    return undef;
}

## Deletion operations
if ( $action eq 'backspace' or $action eq 'delete' ) {
    $redraw_with_cursor->();
    return undef;
}

## Cursor movement
if ( $action eq 'cursor_left' or $action eq 'cursor_right' ) {
    $redraw_with_cursor->();
    return undef;
}

## Buffer modifications (kill/yank operations)
if ( $action =~ m{^(kill_to_end|kill_from_start|kill_word|yank)$} ) {
    $redraw_with_cursor->();
    return undef;
}

## Signal (Ctrl+C, etc.)
if ( $action eq 'signal' ) {
    ## Clear cursor before sending signal, preserve buffer content
    my $cursor_pos = <[editor.control.get_cursor]>->( $editor, 'command' )
        // 0;
    my $buffer = <[editor.control.get_value]>->( $editor, 'command' ) // '';

    ## editor.* state is character-based [ design: position_units ] ; the
    ## terminal path below is byte-oriented — reconstruct the byte view at the
    ## boundary, byte-identical to the old AMOS7::TERM path
    my $prefix = substr( $buffer, 0, $cursor_pos );
    utf8::encode($prefix);
    $cursor_pos = length $prefix;
    utf8::encode($buffer);

    my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';

    ## Go to start of line, clear any cursor remnants, then print buffer
    print "\r\e[K" . $colors{'p7_fg_0004'} . $buffer . " ";
    STDOUT->flush();

    ## Send signal to current process
    my $sig = $edit_result->{signal} // 'INT';
    kill( $sig, $$ );

    return undef;    ## Continue processing
}

## Newline - submit command [ action 'submit' in the new contract ]
if ( $action eq 'submit' ) {
    my $cursor_pos = <[editor.control.get_cursor]>->( $editor, 'command' )
        // 0;
    my $buffer = <[editor.control.get_value]>->( $editor, 'command' ) // '';

    ## char-based editor state -> byte view for terminal output [ same bytes
    ## as the old byte-based AMOS7::TERM path ]
    my $prefix = substr( $buffer, 0, $cursor_pos );
    utf8::encode($prefix);
    $cursor_pos = length $prefix;
    utf8::encode($buffer);

    my $buffer_len = length($buffer);

    ## get terminal width to choose render path
    my $term_cols = ( eval { ( AMOS7::TERM::terminal_size() )[0] } // 80 );

    if ( $buffer_len < $term_cols ) {
        ## normal mode: de-render cursor and show clean full line
        my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';
        print "\r";
        print substr( $buffer, 0, $cursor_pos ) if $cursor_pos > 0;
        if ( $char_at_cursor eq '' ) {
            print "\e[K";
        } elsif ( $char_at_cursor eq ' ' ) {
            print ' ';
        } else {
            print $colors{'p7_fg_0004'} . $char_at_cursor;
        }
        print substr( $buffer, $cursor_pos + 1 )
            if $cursor_pos + 1 < $buffer_len;
        print "\e[0m" . $colors{'p7_fg_0004'};
    } else {
        ## overflow mode: clear line and cursor, show full buffer from start
        print "\r\e[2K" . $colors{'p7_fg_0004'} . $buffer;
        print "\e[0m" . $colors{'p7_fg_0004'};
    }

    ## print the newline [ new contract has no {output} key ; it was always
    ## exactly "\n" on this path ]
    print "\n";
    STDOUT->flush();

    my $submit_result = <[editor.control.submit]>->($editor);
    my $result        = (
          $submit_result->{'ok'}
        ? $submit_result->{'values'}{'command'}
        : ''
    ) // '';
    ## returned command crosses back into the byte world [ execution, history
    ## file ] — same bytes the old editor_submit path returned
    utf8::encode($result);

    ## editor_submit already reset the editor; reset viewport for next command
    my $state_ref = <nshell.state> //= {};
    $state_ref->{'view_offset'} = 0;

    ## save to history if not empty [ what the user actually TYPED, not a ##
    ## plugin-transformed command -- recall should give back their own    ##
    ## words, not "coding.submit their own words" ]                       ##
    if ( length $result ) {
        my @lines = split "\n", $result;
        AMOS7::TERM::history_add(@lines);
        ## reset history index so arrow_up starts from newest entry
        $state_ref->{'current_history_index'} = -1;
    } else {
        ## redraw cursor on empty submit
        print $colors{'p7_fg_0003'} . "_\r" . "\e[0m" . $colors{'p7_fg_0004'};
        STDOUT->flush();
    }

    ## if the current display mode declares a plugin, let it turn the typed ##
    ## text into the actual command to send [ e.g. coding.submit vs         ##
    ## coding.task-append -- see plugin.nshell.coding-session ]. core stays ##
    ## plugin-agnostic : it only ever dispatches when a mode says so        ##
    my $to_send = $result;
    if ( length $result ) {
        my $modes = $state_ref->{'display_modes'};
        my $mode
            = ref $modes eq 'ARRAY'
            ? $modes->[ $state_ref->{'display_mode_index'} // 0 ]
            : undef;
        my $plugin_name = defined $mode ? $mode->{'plugin'} : undef;
        if ( length( $plugin_name // '' ) ) {
            my $plugin_result
                = $code{$plugin_name}->(
                { 'hook' => 'on_submit', 'mode' => $mode, 'text' => $result }
                );
            $to_send = $plugin_result->{'command'}
                if ref $plugin_result eq 'HASH'
                and length( $plugin_result->{'command'} // '' );
        }
    }

    return $to_send;    ## return command [ possibly plugin-transformed ] ##
}

## Unknown action - ignore
return undef;

