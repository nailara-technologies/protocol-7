## [:< ##

# name = nshell.editor.process
# descr = Main dispatcher for editor operations
#         (character insertion, deletion, newline)

my ( $editor, $key, $colors ) = @ARG;

## Initialize editor on first key
$editor //= <[editor.control.create]>->(<[nshell.editor.default_schema]>);

## Process key through editor
my $edit_result = <[editor.control.process_key]>->( $editor, $key );

return unless defined $edit_result;

my $action = $edit_result->{action};

## helper: redraw with cursor [ viewport-aware for overflow lines ]
my $redraw_with_cursor = sub {
    <[nshell.render.viewport]>->( $editor, $colors );
};

## Character insertion (echo action)
if ( $action eq 'echo' ) {
    $redraw_with_cursor->();
    return undef;
}

## Deletion operations
if ( $action eq 'backspace' or $action eq 'delete' ) {
    $redraw_with_cursor->();
    return undef;
}

## Cursor movement
if ( $action eq 'cursor_left' or $action eq 'cursor_right' ) {
    $redraw_with_cursor->();
    return undef;
}

## Buffer modifications (kill/yank operations)
if ( $action =~ m{^(kill_to_end|kill_from_start|kill_word|yank)$} ) {
    $redraw_with_cursor->();
    return undef;
}

## Signal (Ctrl+C, etc.)
if ( $action eq 'signal' ) {
    ## Clear cursor before sending signal, preserve buffer content
    my $cursor_pos = <[editor.control.get_cursor]>->( $editor, 'command' )
        // 0;
    my $buffer = <[editor.control.get_value]>->( $editor, 'command' ) // '';

    ## editor.* state is character-based [ design: position_units ] ; the
    ## terminal path below is byte-oriented — reconstruct the byte view at the
    ## boundary, byte-identical to the old AMOS7::TERM path
    my $prefix = substr( $buffer, 0, $cursor_pos );
    utf8::encode($prefix);
    $cursor_pos = length $prefix;
    utf8::encode($buffer);

    my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';

    ## Go to start of line, clear any cursor remnants, then print buffer
    print "\r\e[K" . $colors{'p7_fg_0004'} . $buffer . " ";
    STDOUT->flush();

    ## Send signal to current process
    my $sig = $edit_result->{signal} // 'INT';
    kill( $sig, $$ );

    return undef;    ## Continue processing
}

## Newline - submit command [ action 'submit' in the new contract ]
if ( $action eq 'submit' ) {
    my $cursor_pos = <[editor.control.get_cursor]>->( $editor, 'command' )
        // 0;
    my $buffer = <[editor.control.get_value]>->( $editor, 'command' ) // '';

    ## char-based editor state -> byte view for terminal output [ same bytes
    ## as the old byte-based AMOS7::TERM path ]
    my $prefix = substr( $buffer, 0, $cursor_pos );
    utf8::encode($prefix);
    $cursor_pos = length $prefix;
    utf8::encode($buffer);

    my $buffer_len = length($buffer);

    ## get terminal width to choose render path
    my $term_cols = ( eval { ( AMOS7::TERM::terminal_size() )[0] } // 80 );

    if ( $buffer_len < $term_cols ) {
        ## normal mode: de-render cursor and show clean full line
        my $char_at_cursor = substr( $buffer, $cursor_pos, 1 ) // '';
        print "\r";
        print substr( $buffer, 0, $cursor_pos ) if $cursor_pos > 0;
        if ( $char_at_cursor eq '' ) {
            print "\e[K";
        } elsif ( $char_at_cursor eq ' ' ) {
            print ' ';
        } else {
            print $colors{'p7_fg_0004'} . $char_at_cursor;
        }
        print substr( $buffer, $cursor_pos + 1 )
            if $cursor_pos + 1 < $buffer_len;
        print "\e[0m" . $colors{'p7_fg_0004'};
    } else {
        ## overflow mode: clear line and cursor, show full buffer from start
        print "\r\e[2K" . $colors{'p7_fg_0004'} . $buffer;
        print "\e[0m" . $colors{'p7_fg_0004'};
    }

    ## print the newline [ new contract has no {output} key ; it was always
    ## exactly "\n" on this path ]
    print "\n";
    STDOUT->flush();

    my $submit_result = <[editor.control.submit]>->($editor);
    my $result        = (
          $submit_result->{'ok'}
        ? $submit_result->{'values'}{'command'}
        : ''
    ) // '';
    ## returned command crosses back into the byte world [ execution, history
    ## file ] — same bytes the old editor_submit path returned
    utf8::encode($result);

    ## editor_submit already reset the editor; reset viewport for next command
    my $state_ref = $data{'nshell'}{'state'} //= {};
    $state_ref->{'view_offset'} = 0;

    ## save to history if not empty
    if ( length $result ) {
        my @lines = split "\n", $result;
        AMOS7::TERM::history_add(@lines);
        ## reset history index so arrow_up starts from newest entry
        $state_ref->{'current_history_index'} = -1;
    } else {
        ## redraw cursor on empty submit
        print $colors{'p7_fg_0003'} . "_\r" . "\e[0m" . $colors{'p7_fg_0004'};
        STDOUT->flush();
    }

    return $result;    ## return command (or empty string)
}

## Unknown action - ignore
return undef;

