# name  = plugin.events.source.bucket-dependency
# descr = events source plugin : an entry fired or failed
## bucket entries wait on other entries of the same bucket [ depends ] ;  ##
## events.bucket.finish tells this source when one ends, `wake` looks at  ##
## the bucket again so the dependants fire or block. the registration has ##
## no timetable keys : entries carry `depends`, not a section key         ##
return {
    'name'     => qw| bucket-dependency |,
    'kind'     => qw| source |,
    'describe' => 'bucket entry ended : depends = id,id [ same bucket ]',
    'keys'     => [],
    'arm'      => sub {
        my $keys = shift // [];
        <events.bucket_dep_armed> //= {};
        foreach my $key ( @{$keys} ) { <events.bucket_dep_armed>->{$key} = 1 }
        return scalar @{$keys};
    },
    'disarm' => sub {
        my $keys = shift // [];
        foreach my $key ( @{$keys} ) {
            delete( ( <events.bucket_dep_armed> //= {} )->{$key} );
        }
        return TRUE;
    },
    'wake' => sub {
        my ( $owner, $id, $state ) = @ARG;
        <[events.bucket.evaluate]>->($owner);
        return TRUE;
    }
};

