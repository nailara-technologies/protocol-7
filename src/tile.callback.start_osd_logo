my $display_logo = <tile.display_logo> // 0;

my $command_str
    = $display_logo
    ? qw| cube.v7.start_once |
    : qw| cube.v7.terminate-implicit |;

<[protocol-7.command.send.local]>->(
    {   'command'   => $command_str,
        'call_args' => { 'args' => 'osd-logo' }
    }
);

