## [:< ##

# name  = base.prng.reseed
# descr = [re]seed the CORE::[s]rand and Crypt::PRNG::Fortuna prngs
#         [ fortuna : OS-seeded by CryptX, the entropy pool ADDED on top ]

## [ initializing fortuna ] ##
##
my $start_seed    = shift // 142857;    ##[ 5 : 7 ]##
my $iterations    = shift // 57;
my $harmonic_seed = qw| FALSE |;

( my $srand_seed = $PID + <[base.ntime]>->(13) ) =~ s|\.||;
srand($srand_seed);

while ( $iterations-- and <[base.assert.harmony]>->($harmonic_seed) == 0 ) {
    ( $harmonic_seed = join( '', <[base.ntime]>->(13), rand($start_seed) ) )
        =~ s|\.||;
    ( $harmonic_seed /= 13 ) =~ s,(\.|e.+$),,g;
    <[base.sleep]>->(0.0013) if $iterations < 37;
}

## the unseeded constructor : CryptX seeds it from the OS itself ; the     ##
## entropy pool [ machine data, the harmonic seed, its own OS reads ] is   ##
## ADDED on top through add_entropy. Crypt::PRNG::Fortuna->new( $seed )    ##
## would REPLACE the OS seeding with that seed alone -- the 2026-10-06 bug ##
my $fortuna = Crypt::PRNG::Fortuna->new;
$fortuna->add_entropy( <[base.prng.entropy_pool]>->($harmonic_seed) );

return <base.prng.fortuna> = $fortuna;

