## [:< ##

# name  = base.prng.reseed
# descr = [re]seed the CORE::[s]rand and Crypt::PRNG::Fortuna prngs
#         [ fortuna from OS entropy + machine data + the harmonic seed ]

## [ initializing fortuna ] ##
##
my $start_seed    = shift // 142857;    ##[ 5 : 7 ]##
my $iterations    = shift // 57;
my $harmonic_seed = qw| FALSE |;

( my $srand_seed = $PID + <[base.ntime]>->(13) ) =~ s|\.||;
srand($srand_seed);

while ( $iterations-- and <[base.assert.harmony]>->($harmonic_seed) == 0 ) {
    ( $harmonic_seed = join( '', <[base.ntime]>->(13), rand($start_seed) ) )
        =~ s|\.||;
    ( $harmonic_seed /= 13 ) =~ s,(\.|e.+$),,g;
    <[base.sleep]>->(0.0013) if $iterations < 37;
}

## the harmonic seed alone is a function of PID + ms time [ guessable ] : ##
## it is one input of the entropy pool, which adds OS entropy + machine   ##
## data [ base.prng.entropy_pool ] -- Crypt::PRNG::Fortuna->new( $seed )  ##
## uses ONLY the given seed, it reads no OS entropy itself                ##
return <base.prng.fortuna>
    = Crypt::PRNG::Fortuna->new(
    <[base.prng.entropy_pool]>->($harmonic_seed) );

