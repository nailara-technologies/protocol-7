## [:< ##

# name  = osf-cache.cmd.segment
# descr = serve one B32-encoded segment of a held file
# param = <bmw384> <offset> <length>
#
# the segment answer of acquisition flow step 3 [ transport decided :
# one request per segment, the segment comes back B32-encoded in the
# reply args - a round trip per segment, but cube is never blocked by
# a long stream ]. serves ONLY a file in <osf-cache.holdings> whose
# digests.bmw384 matches AND whose anchored flag is true - the path is
# cache_dir/<entry name>, never anything taken from the request.
# before reading, the file is CORE::stat'ed : size, mtime and inode
# must still equal the holdings entry, else mode false 'changed since
# scan' - bytes the recorded digests do not describe are never served.
# the read is '<:raw' + sysseek \ sysread ; an offset at or beyond the
# end is mode false and the last segment may come back shorter. length
# is capped at <osf-cache.cfg.segment_max> [ //= 65536 ]. the reply is
# mode true with '<offset> <bytes> <b32>' on ONE line [ encode_b32r
# of the raw bytes, no newlines ].

my $args = $call->{'args'} // '';

my @argv = grep {length} split m{\s+}, $args;

return {
    'mode' => qw| false |,
    'data' => 'usage : segment <bmw384> <offset> <length>'
    }
    unless @argv == 3;

my ( $bmw384, $offset, $length ) = @argv;

return { 'mode' => qw| false |, 'data' => "invalid bmw384 : $bmw384" }
    unless $bmw384 =~ m|^[A-Z2-7]{77}$|o;

return {
    'mode' => qw| false |,
    'data' => 'offset and length must be non-negative integers'
    }
    unless $offset =~ m{^\d+$}o and $length =~ m{^\d+$}o;

my $seg_max = <osf-cache.cfg.segment_max> // 65536;
$seg_max = 65536 if !$seg_max or $seg_max < 1;    ## explicit floor ##

return {
    'mode' => qw| false |,
    'data' => "length outside 1 .. $seg_max"
    }
    if $length < 1 or $length > $seg_max;

my $scan = <osf-cache.scan> // {};

return { 'mode' => qw| false |, 'data' => 'holdings not ready' }
    unless $scan->{'done'};

my $holdings = <osf-cache.holdings>;
return { 'mode' => qw| false |, 'data' => 'holdings not ready' }
    unless ref $holdings eq qw| HASH |;

## only ANCHORED entries are served - an unanchored match is refused, ##
## not silently upgraded to a holder                                   ##
my ( $entry, $unanchored );
foreach my $file ( @{ $holdings->{'files'} // [] } ) {
    next unless ( $file->{'digests'}{'bmw384'} // '' ) eq $bmw384;
    if ( $file->{'anchored'} ) {
        $entry = $file;
        last;
    }
    $unanchored //= $file;
}

return { 'mode' => qw| false |, 'data' => "unknown bmw384 : $bmw384" }
    unless ref $entry eq qw| HASH | or ref $unanchored eq qw| HASH |;

return {
    'mode' => qw| false |,
    'data' => "refused : $bmw384 [ not an anchored holding ]"
    }
    unless ref $entry eq qw| HASH |;

## the path comes from the holdings entry - never from the request ##
my $path = sprintf '%s/%s', <osf-cache.cfg.cache_dir> // '', $entry->{'name'};

## CORE::stat : bin/Protocol-7 imports File::stat, whose stat returns an ##
## object -> a plain list stat left all fields undef in the zenka        ##
my @stat = CORE::stat($path);

return { 'mode' => qw| false |, 'data' => 'changed since scan [ gone ]' }
    unless @stat > 10;

return { 'mode' => qw| false |, 'data' => 'changed since scan' }
    unless $stat[7] eq $entry->{'size'}
    and $stat[9] eq $entry->{'mtime'}
    and $stat[1] eq $entry->{'inode'};

return {
    'mode' => qw| false |,
    'data' => "offset beyond end : $offset >= $stat[7]"
    }
    if $offset >= $stat[7];

open( my $fh, '<:raw', $path ) or do {
    return {
        'mode' => qw| false |,
        'data' => "cannot read $path : $OS_ERROR"
    };
};

## sysseek returns the new position : 0 at offset 0 is success, not failure ##
sysseek( $fh, $offset, 0 ) // do {
    close($fh);
    return { 'mode' => qw| false |, 'data' => 'seek failed' };
};

my $read = sysread( $fh, my $buf, $length );
close($fh);

return { 'mode' => qw| false |, 'data' => 'read failed' }
    unless defined $read and $read > 0;

<[base.perlmod.autoload]>->( 'Crypt::Misc', qw| encode_b32r | );

return {
    'mode' => qw| true |,
    'data' => sprintf '%d %d %s', $offset, $read, encode_b32r($buf)
};

