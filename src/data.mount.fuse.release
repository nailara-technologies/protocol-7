## [:< ##

# name  = data.mount.fuse.release
# param = <fuse_path> <file_info_flags>
# descr = FUSE release callback - cleanup after file close
# return = 0

my ( $fuse_path, $flags ) = @ARG;

# Currently no special cleanup needed for local hash-based files
# This callback exists for future expansion (e.g., cache cleanup,
# write-back for buffered writes, reference counting)

return 0;

