## [:< ##

# name  = lm-vision.cmd.status
# descr = query vision analysis job status

my $job_id = $call->{'args'};

if ( !defined $job_id || !length $job_id ) {

    # Return overall status with job IDs
    my $job_count = scalar keys <lm-vision.jobs>->%*;
    my $active    = 0;
    my $completed = 0;
    my $failed    = 0;
    my @job_ids   = ();

    foreach my $jid ( sort keys <lm-vision.jobs>->%* ) {
        my $job = <lm-vision.jobs>->{$jid};
        $active++    if $job->{'status'} eq 'running';
        $completed++ if $job->{'status'} eq 'completed';
        $failed++    if $job->{'status'} eq 'failed';
        push @job_ids, "$jid(" . $job->{'status'} . ")";
    }

    my $job_list = @job_ids ? " [" . join( ", ", @job_ids ) . "]" : "";

    return {
        'mode' => 'true',
        'data' => sprintf(
            'Vision Server Ready | Jobs: %d (active: '
                . '%d, completed: %d, failed: %d)%s',
            $job_count, $active, $completed, $failed, $job_list
        )
    };
}

# Query specific job
return { 'mode' => 'false', 'data' => 'no such job' }
    unless exists <lm-vision.jobs>->{$job_id};

my $job = <lm-vision.jobs>->{$job_id};

my $status_str = sprintf(
    'Job %s: status=%s pid=%s runtime=%d sec',
    $job_id, $job->{'status'},
    ( defined $job->{'pid'} ? $job->{'pid'} : 'N/A' ),
    ( time() - $job->{'start_time'} )
);

if ( $job->{'status'} eq 'completed' ) {
    my $output = $job->{'output'};
    $output = substr( $output, 0, 100 ) . '...' if length($output) > 100;
    $status_str .= " | output: $output";
    if ( defined $job->{'debug_log'} && length $job->{'debug_log'} ) {
        $status_str
            .= " | debug_log: " . length( $job->{'debug_log'} ) . " bytes";
    }
} elsif ( $job->{'status'} eq 'failed' ) {
    $status_str .= " | error: " . $job->{'error'};
}

return {
    'mode' => 'size',
    'data' => $status_str
};

