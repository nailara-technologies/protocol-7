## [:< ##

# name  = coding.handler.refresh_account_usage
# descr = request account usage numbers from the on-demand usage zenka

my $params   = shift                 // {};
my $provider = $params->{'provider'} // '';

## only ever pass through provider names the usage zenka knows ##
$provider = '' unless $provider =~ m{^(claude|kimi)$};

## no format keyword -- the default 'pretty' format is the one meant for ##
## the local model to read, same as a human would see via usage.claude   ##
my $args_str = length($provider) ? $provider : '';

my $cmd_count = <[protocol-7.route-send]>->(
    {   'command'   => qw| usage.status |,
        'call_args' => { 'args' => $args_str },
        'reply'     => {
            'handler' => qw| coding.handler.account_usage_reply |,
            'params'  => {}
        }
    }
);

<[base.logs]>->( 3, 'account usage request sent to usage zenka' )
    if $cmd_count;

return $cmd_count;

