## [:< ##

# name  = sourcecode.console.sign
# descr = sign a single source file path

my $file_path = shift // '';

if ( not length $file_path ) {
    print "usage: sourcecode sign <file-path>\n";
    return;
}

<[sourcecode.console.update-signatures]>->($file_path);

