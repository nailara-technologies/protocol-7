## [:< ##

# name  = radio.cmd.library
# descr = list keep-library files

my $dir = <radio.keep_library.path> // '';

if ( not -d $dir ) {
    return { 'mode' => qw| true |, 'data' => 'keep-library is empty' };
}

my @files = sort glob("$dir/*.mp3");
if ( not @files ) {
    return { 'mode' => qw| true |, 'data' => 'keep-library is empty' };
}

my $list = join "\n", map {
    my $size = -s $_;
    sprintf '  %s  [ %.1f MB ]', ( split m|/|, $_ )[-1], $size / 1_048_576
} @files;

return {
    'mode' => qw| true |,
    'data' => sprintf "%d track%s:\n%s",
    scalar @files, @files == 1 ? '' : 's', $list
};

