## [:< ##

# name  = workspace-transfer.cmd.status-check
# descr = intelligent workspace status analyzer

my $ws_dir = workspace_transfer::chdir_workspace();
<[base.exit]>->(qw| 0110 |) unless defined $ws_dir;

# Ensure we're in the right directory
unless ( -f 'README.md' && -d '.git' ) {
    say "⚠ Invalid workspace directory structure";
    <[base.exit]>->(qw| 0110 |);
}

say "";
say "=" x 70;
say "                    WORKSPACE STATUS CHECK";
say "=" x 70;
say "";

my $needs_action = 0;

# Check Git Status
say "💾 Git Status";
my $status_count = `git status --short | wc -l`;
chomp $status_count;

if ( $status_count > 0 ) {
    say sprintf "   ⚠️  UNCOMMITTED: %d files changed", $status_count;
    system('git status --short | head -10');
    if ( $status_count > 10 ) {
        say sprintf "   ... and %d more files", ( $status_count - 10 );
    }
    say "       → Action: git add -A && git "
        . "commit -m 'description' && git push";
    $needs_action = 1;
} else {
    say "   ✅ CLEAN: No uncommitted changes";
}

# Check Remote Sync
say "";
say "🌐 Remote Sync";
system('git fetch origin --quiet 2>/dev/null');

my $branch = `git branch --show-current`;
chomp $branch;
say sprintf "   📍 Branch: %s", $branch;

my $ahead  = `git rev-list origin/$branch..HEAD --count 2>/dev/null`;
my $behind = `git rev-list HEAD..origin/$branch --count 2>/dev/null`;
chomp( $ahead, $behind );

if ( $ahead > 0 ) {
    say sprintf "   ⚠️  AHEAD: %d commits not pushed", $ahead;
    say sprintf "       → Action: git push origin %s", $branch;
    $needs_action = 1;
} elsif ( $behind > 0 ) {
    say sprintf "   ⚠️  BEHIND: %d commits on remote", $behind;
    say sprintf "       → Action: git pull origin %s", $branch;
    $needs_action = 1;
} else {
    say "   ✅ SYNCED: Local matches remote";
}

# Check Git Config
say "";
say "🔧 Git Configuration";
my $git_user  = `git config user.name`;
my $git_email = `git config user.email`;
chomp( $git_user, $git_email );

if ( $git_user && $git_email ) {
    say sprintf "   ✅ CONFIGURED: %s <%s>", $git_user, $git_email;
} else {
    say "   ⚠️  MISCONFIGURED: Git identity not set";
    say "       → Action: Run bootstrap or configure-remote-PAT";
    $needs_action = 1;
}

# Quick Stats
say "";
say "📊 Repository Stats";
my $total_files   = `find . -type f ! -path './.git/*' | wc -l`;
my $total_commits = `git rev-list --count HEAD 2>/dev/null`;
chomp( $total_files, $total_commits );
say sprintf "   📁 Files: %s",   $total_files;
say sprintf "   💾 Commits: %s", $total_commits;

# Final Recommendation
say "";
say "=" x 70;
if ($needs_action) {
    say "⚠️  ACTION REQUIRED - See details above";
} else {
    say "✅ ALL SYSTEMS GO!";
    say "";
    say "You can now use:";
    say "  - todo/bug commands for tracking";
    say "  - checkpoint for quick saves";
}
say "=" x 70;
say "";

