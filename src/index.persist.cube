## [:< ##

# name = index.persist.cube
# descr = serialize schema v3 .zxpc cube from in-memory trie

return FALSE
    unless defined <index.trie>
    and scalar keys <index.trie>->%*;

my @depths    = sort { $a <=> $b } keys <index.trie>->%*;
my $max_depth = $depths[-1];

## pre-compute ring counts and compartment sizes ##
my @ring_count;
my @comp_sizes;
my @dir_stride;
my @dir_base;
my $total_comp_data_size = 0;

for my $D ( 0 .. $max_depth ) {
    my $nodes = <index.trie>->{$D} // [];
    my $count = scalar @$nodes;
    $ring_count[$D] = $count;
    $dir_stride[$D] = <index.cube.format.dir_entry_size>;

    my @sizes;
    for my $R ( 0 .. $count - 1 ) {
        my $node        = $nodes->[$R];
        my @child_ranks = unpack( 'N*', $node->[1] // '' );
        my $child_count = scalar @child_ranks;
        my $payload_size
            = 1 + 4 + 8 + 2 + ( 8 * $child_count );  ## C N a8 n + children ##
        my $frame_size = 9;    ## \x00 + len_byte + 7-byte checksum ##
        my $disk_size  = $payload_size + $frame_size;
        push @sizes, [ $payload_size, $disk_size ];
        $total_comp_data_size += $disk_size;
    }
    $comp_sizes[$D] = \@sizes;
}

## compute directory layout ##
my $next_offset = <index.cube.format.header_size>;

for my $D ( 0 .. $max_depth ) {
    my $base = $next_offset;
    $base += ( 16 - $base % 16 ) % 16;    ## 16-byte align ##
    $dir_base[$D] = $base;
    $next_offset = $base + $ring_count[$D] * $dir_stride[$D];
}

my $data_base = $next_offset;
$data_base += ( 16 - $data_base % 16 ) % 16;

my $total_size = $data_base + $total_comp_data_size;

## build header (without checksum field) ##
my $flags = 0;

my $header = pack( 'a4 S S L S',
    <index.cube.format.magic>,
    <index.cube.format.schema_version>,
    <index.cube.format.compat_version>,
    $flags, $max_depth );
$header .= pack( 'S*',  @ring_count[ 0 .. $max_depth ] );
$header .= pack( 'Q*',  @dir_base[ 0 .. $max_depth ] );
$header .= pack( 'S*',  @dir_stride[ 0 .. $max_depth ] );
$header .= pack( 'Q Q', $data_base, $total_size );

## compute header checksum ##
my $hdr_checksum_str = <[chk-sum.amos]>->($header);
my $hdr_chksum7      = pack( 'a8', $hdr_checksum_str );
$header .= $hdr_chksum7;

## pad to exactly 256 bytes ##
$header .= "\x00" x ( 256 - length($header) );

## build compartments depth by depth ##
my %compartment_checksum;
my $data_offset = $data_base;
my $dir_write_pos
    = <index.cube.format.header_size>; ## byte position in directory region ##
my @directory;
my @compartment_data;

for my $D ( 0 .. $max_depth ) {
    ## insert alignment padding so actual offset matches dir_base[D] in ##
    ## header                                                           ##
    if ( $dir_base[$D] > $dir_write_pos ) {
        push @directory, "\x00" x ( $dir_base[$D] - $dir_write_pos );
        $dir_write_pos = $dir_base[$D];
    }

    my $nodes       = <index.trie>->{$D} // [];
    my $ring_countD = scalar @$nodes;
    my $seq_len     = $D + 1;
    my $packed      = <index.packed_rank>->{$D} // '';

    my $child_packed  = <index.packed_rank>->{ $D + 1 } // '';
    my $child_seq_len = $D + 2;

    my @dir_entries;

    for my $R ( 0 .. $ring_countD - 1 ) {
        my $node = $nodes->[$R];

        my $seq = substr( $packed, $R * $seq_len, $seq_len );

        my $terminal = <index.terminal>->{$seq} ? 1 : 0;

        my $frequency
            = $D == 0
            ? ( <index.freq>->{$seq} // 0 )
            : ( <index.level>->{ $D + 1 }->{$seq} // 0 );

        my $parent_chksum7;
        if ( $D == 0 ) {
            $parent_chksum7 = $hdr_chksum7;
        } else {
            my $parent_seq  = substr( $seq, 0, $D );
            my $parent_rank = <index.addr>->{ ( $D - 1 ) . ":$parent_seq" };
            my $parent_chk
                = $compartment_checksum{ $D - 1 }{ $parent_rank // '' };
            $parent_chksum7 = pack( 'a8', $parent_chk // '' );
        }

        my @child_ranks = unpack( 'N*', $node->[1] // '' );
        my $child_count = scalar @child_ranks;

        my $payload = pack( <index.cube.format.pack.comp_header>,
            $terminal, $frequency, $parent_chksum7, $child_count );

        for my $child_rank (@child_ranks) {
            my $child_seq
                = substr( $child_packed, $child_rank * $child_seq_len,
                $child_seq_len );
            my $char      = substr( $child_seq, -1 );
            my $char_code = ord($char);
            $payload .= pack( <index.cube.format.pack.child_entry>,
                $char_code, $child_rank );
        }

        my $chk_str    = <[chk-sum.amos]>->( \$payload );
        my $frame      = "\x00" . chr( length $chk_str ) . $chk_str;
        my $comp_bytes = $frame . $payload;

        $compartment_checksum{$D}{$R} = $chk_str;

        my $disk_size = length($comp_bytes);
        my $entry     = pack(
            <index.cube.format.pack.dir_entry>,
            $data_offset,
            $disk_size,
            $child_count,
            0,    ## flags ##
            pack( 'a8', $chk_str )
        );
        push @dir_entries,      $entry;
        push @compartment_data, $comp_bytes;

        $data_offset += $disk_size;
    }

    push @directory, @dir_entries;
    $dir_write_pos += $ring_countD * $dir_stride[$D];

    <[base.log]>->(
        1, "index.persist.cube: ring $D [ $ring_countD entries ]"
    );
}

## padding from last ring directory to data_base ##
if ( $data_base > $dir_write_pos ) {
    push @directory, "\x00" x ( $data_base - $dir_write_pos );
}

## assemble output ##
my $output = $header . join( '', @directory ) . join( '', @compartment_data );

## write ##
my $written = <[file.zenka_dir.write]>->(
    'numerical/numerical-index_state.zxpc',
    \$output, qw| > |, 0640
);

return <[base.log]>->( 1, 'index.persist.cube: write failed' )
    if not $written;

<[base.log]>->( 1, "index.persist.cube: written [ $total_size bytes ]" );

return TRUE;

