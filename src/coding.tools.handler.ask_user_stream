# name  = coding.tools.handler.ask_user_stream
# descr = non-blocking conversational ask via the amos-term interaction buffer

my $args = shift // {};

my $question = $args->{'question'} // return 'question required';

my $target = qw| amos-term.interaction.ask |;

return 'interaction channel is not loaded'
    unless <[base.code.exists]>->($target);

my $context = { 'task_id' => <system.task_id> // qw| unknown | };

my $attach_id = <[base.code.call_optional]>->(
    $target, $question, qw| coding.handler.user_stream_reply |, $context
);

return
    defined $attach_id
    ? sprintf "question pending on interaction buffer [%s]", $attach_id
    : "interaction ask failed";

