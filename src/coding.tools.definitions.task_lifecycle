## [:< ##

# name  = coding.tools.definitions.task_lifecycle
# descr = task completion/delegation tool schemas for coding.tools.definitions

my @tools;

## task_complete : signal task completion and stop the loop ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'task_complete',
        'description' => 'signal that the task is done and stop working '
            . '[ call this when all work is finished ]',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'summary' => {
                    'type'        => 'string',
                    'description' => 'brief summary of what was accomplished'
                },
            },
            'required' => ['summary'],
        },
    },
    };

## subtask_spawn : delegate work to a child task ##
push @tools,
    {
    'type'     => 'function',
    'function' => {
        'name'        => 'subtask_spawn',
        'description' => 'spawn a focused child task to investigate or solve '
            . 'a sub-problem. the parent task pauses until '
            . 'the child completes and the result is '
            . 'injected back into parent context. use for '
            . 'parallelizable work or deep dives that '
            . 'should not block the main flow.',
        'parameters' => {
            'type'       => 'object',
            'properties' => {
                'description' => {
                    'type'        => 'string',
                    'description' => 'clear description of what '
                        . 'the child task should do'
                },
                'template' => {
                    'type'        => 'string',
                    'description' => 'optional context template '
                        . 'name to guide the child task'
                },
                'guiding_message' => {
                    'type'        => 'string',
                    'description' => 'optional guidance for the child task [ '
                        . 'constraints, priorities, hints ]'
                },
            },
            'required' => ['description'],
        },
    },
    };

return \@tools;

