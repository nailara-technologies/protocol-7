# name = httpd.update_download_count
# descr = track file download statistics

my $file_path = shift;
my $bytes     = shift;   # Optional: bytes transferred (for partial downloads)

# Skip if no file path provided
return FALSE if !defined $file_path || $file_path eq '';

# Skip if file doesn't exist
return FALSE if !-f $file_path;

# Initialize statistics data structure if needed
<httpd.downloads>        //= {};
<httpd.downloads.files>  //= {};
<httpd.downloads.totals> //= {
    'count'     => 0,
    'bytes'     => 0,
    'last_time' => 0
};

# Get file size if bytes not provided
if ( !defined $bytes ) {
    $bytes = -s $file_path;
}

# Update file-specific statistics
if ( !exists <httpd.downloads.files>->{$file_path} ) {
    <httpd.downloads.files>->{$file_path} = {
        'count'      => 0,
        'bytes'      => 0,
        'first_time' => <[base.ntime]>,
        'last_time'  => 0
    };
}

<httpd.downloads.files>->{$file_path}{'count'}++;
<httpd.downloads.files>->{$file_path}{'bytes'} += $bytes;
<httpd.downloads.files>->{$file_path}{'last_time'} = <[base.ntime]>;

# Update global download statistics
<httpd.downloads.totals.count>++;
<httpd.downloads.totals.bytes> += $bytes;
<httpd.downloads.totals.last_time> = <[base.ntime]>;

# Log download at debug level
<[base.log]>->(
    3,
    "File download: $file_path - "
        . <[httpd.base.size.normalize]>->($bytes)
        . " (Total downloads: $data{'httpd'}{'downloads'}{'files'}{$file_path}{'count'})"
);

# Clean up old statistics if too many files are tracked
if ( scalar( keys %{<httpd.downloads.files>} ) > 1000 ) {

    # Find oldest accessed files
    my @files = sort {
        <httpd.downloads.files>->{$a}{'last_time'} <=>
            <httpd.downloads.files>->{$b}{'last_time'}
    } keys %{<httpd.downloads.files>};

    # Remove oldest entries to keep only 900 entries
    foreach my $old_file ( @files[ 0 .. 99 ] ) {
        delete <httpd.downloads.files>->{$old_file};
    }
}

return TRUE;

