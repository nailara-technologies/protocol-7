## [:< ##

# name  = X-11.cmd.xvfb-status
# param = [display_num]
# descr = report status of one or all known xvfb instances

my @args
    = ref( $call->{'args'} ) eq qw| ARRAY |
    ? $call->{'args'}->@*
    : split( m| +|, $call->{'args'} // '' );

my @displays;
if ( @args and defined $args[0] and length $args[0] ) {
    my $display_num = <[X-11.helper.resolve_display_id]>->( $args[0] );
    return { 'mode' => qw| false |, 'data' => 'invalid display number' }
        if not defined $display_num;
    push @displays, $display_num;
} else {
    ## <X-11.servers> is shared across all display modes [xorg\xvfb\..] -- ##
    ## only report xvfb-mode entries here, not the primary\host display .. ##
    @displays = sort { $a <=> $b }
        map  { m|^:(\d+)$| ? $1 : () }
        grep { ( <X-11.servers>->{$ARG}->{'mode'} // '' ) eq qw| xvfb | }
        keys %{ <X-11.servers> // {} };
}

return { 'mode' => qw| true |, 'data' => 'no xvfb instances known' }
    if @displays == 0;

my @rows;
foreach my $display_num (@displays) {
    my $entry = <X-11.servers>->{":$display_num"};
    my $is_xvfb
        = ( defined $entry and ( $entry->{'mode'} // '' ) eq qw| xvfb | );
    my $pid    = $is_xvfb ? $entry->{'pid'}                    : undef;
    my $label  = $is_xvfb ? $entry->{'label'}                  : undef;
    my $status = ( defined $pid and kill 0, $pid ) ? 'running' : 'stopped';
    push @rows,
        sprintf( ":%s\t%s\t%d\t%s",
        $display_num, $label // '-',
        $pid // 0, $status );
}

return { 'mode' => qw| size |, 'data' => join( "\n", @rows ) };

