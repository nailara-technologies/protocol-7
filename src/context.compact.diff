## [:< ##

# name  = context.compact.diff
# descr = reduce diff output to essential changes

my $params = shift // {};

my $diff   = $params->{'diff'}   // '';
my $budget = $params->{'budget'} // 1000;

my $char_budget = int( $budget * <context.cfg.chars_per_token> );

return $diff if length($diff) <= $char_budget;

my @lines = split m|\n|, $diff;
my @kept;

foreach my $line (@lines) {
    ## always keep file headers ##
    if (   $line =~ m|^diff\s--git|
        or $line =~ m|^---\s|
        or $line =~ m|^\+\+\+\s| ) {
        push @kept, $line;
        next;
    }

    ## always keep hunk headers ##
    if ( $line =~ m|^@@| ) {
        push @kept, $line;
        next;
    }

    ## keep added and removed lines ##
    if ( $line =~ m|^[+-]| and $line !~ m|^[+-]{3}| ) {
        ## skip signature lines ##
        next if $line =~ m|^[+-]#,,|;
        next if $line =~ m|^[+-]#\\|;
        next if $line =~ m|^[+-]#::::|;
        push @kept, $line;
        next;
    }

    ## skip context lines [ lines starting with space ] ##
}

my $output = join "\n", @kept;

## truncate if still over budget ##
if ( length($output) > $char_budget ) {
    $output = substr( $output, 0, $char_budget );
    $output .= "\n... [ diff compacted ]\n";
}

return $output;

