## [:< ##

# name  = radio.cmd.skip
# descr = manually flag current track as jingle

my $icy = <radio.stream.icy>;

$icy->{'is_jingle'} = 1;

my $title = $icy->{'current_title'} // '(none)';

<[base.logs]>->(
    2, '[radio] skip: manually flagged as jingle [ %s ]', $title
);

return {
    'mode' => qw| true |,
    'data' => sprintf( 'skipping: %s', $title )
};

