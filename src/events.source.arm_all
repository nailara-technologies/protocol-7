## [:< ##

# name  = events.source.arm_all
# descr = arm loaded sources for static and bucket entry references
# args   = optional entry references [ default : every waiting entry ]
# numeric ids name static entries ; <owner>/<id> names bucket entries. each
# source gets its references as an array ref ; with no arguments the timetable
# source is armed even with none, as before the plugins

my @only     = @ARG;
my $registry = <[events.plugin.registry]>->();
my $armed    = 0;

foreach my $type ( sort keys %{ $registry->{'source'} } ) {
    my @ev_ids;
    if (@only) {
        @ev_ids = grep {
            my $key = $ARG;
            if ( $key =~ m{/} ) {
                my ( $owner, $id ) = split m{/}, $key, 2;
                my $e = <events.buckets>->{$owner}->{'entries'}{$id};
                defined $e
                    and ( $e->{'state'} // '' ) eq qw| waiting |
                    and not $e->{'met'}
                    and ( $type eq qw| timetable | && defined $e->{'at'}
                    or $type eq qw| signal | && defined $e->{'on'}
                    or $type eq qw| bucket-dependency |
                    && @{ $e->{'depends'} // [] } );
            } else {
                grep { $ARG eq $type }
                    @{ <events.entry.sources>->{$key} // [] };
            }
        } @only;
    } else {
        @ev_ids = sort { $a <=> $b } grep {
            grep { $ARG eq $type } @{ <events.entry.sources>->{$ARG} // [] }
        } keys <events.setup>->%*;
        push @ev_ids, map {
            my $owner = $ARG;
            map {"$owner/$_"} grep {
                my $e = <events.buckets>->{$owner}->{'entries'}{$_};
                defined $e
                    and ( $e->{'state'} // '' ) eq qw| waiting |
                    and not $e->{'met'}
                    and ( $type eq qw| timetable | && defined $e->{'at'}
                    or $type eq qw| signal | && defined $e->{'on'}
                    or $type eq qw| bucket-dependency |
                    && @{ $e->{'depends'} // [] } )
            } @{ <events.buckets>->{$owner}->{'order'} }
        } sort keys %{ <events.buckets> // {} };
    }
    $registry->{'source'}{$type}{'arm'}->( \@ev_ids );
    $armed++;
}

return $armed;

