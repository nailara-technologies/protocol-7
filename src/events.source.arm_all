## [:< ##

# name  = events.source.arm_all
# descr = arm every loaded source for the entries that wait on it
# each source plugin gets the sorted ids of its entries as an array ref ;
# the timetable source is armed even with none, as before the plugins

my $registry = <[events.plugin.registry]>->();
my $armed    = 0;

foreach my $type ( sort keys %{ $registry->{'source'} } ) {
    my @ev_ids = sort { $a <=> $b } grep {
        grep { $ARG eq $type } @{ <events.entry.sources>->{$ARG} // [] }
    } keys <events.setup>->%*;
    $registry->{'source'}{$type}{'arm'}->( \@ev_ids );
    $armed++;
}

return $armed;

