## [:< ##

# name  = form.handler.term_resize
# descr = SIGWINCH handler - update cached terminal dimensions
#         and force a form redraw so the vertical viewport recalculates

## re-query terminal size [ terminal_size returns ( cols, rows ) ] load on ##
## demand : form.init_code does not load AMOS7::TERM, and this handler may ##
## be the first code path that needs it after a resize                     ##
<[base.perlmod.load]>->('AMOS7::TERM')
    if not <[base.perlmod.loaded]>->('AMOS7::TERM');

my @size = AMOS7::TERM::terminal_size();
<form.term_cols> = $size[0] // 80;
<form.term_rows> = $size[1] // 24;

## reset the vertical viewport so the next render recomputes from scratch at
## the new height rather than keeping a stale slice that may no longer fit
<form.scroll_top> = 0;

## bump the dirty counter so the redraw watcher repaints if the form is
## currently on screen. this handler runs inside the event loop, so it must
## not call render directly
<form.dirty>++ if <form.interactive>;

return TRUE;

