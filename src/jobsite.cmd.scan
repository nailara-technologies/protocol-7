## [:< ##

# name  = jobsite.cmd.scan
# descr = trigger a scan cycle manually
# param = [:full:]

return {
    'mode' => qw| false |,
    'data' => 'replica of ' . ( <jobsite.cfg.primary_url> // '' ),
    }
    if <[jobsite.replica.enabled]>;

my $args      = $call->{'args'} // '';
my $full_mode = ( $args =~ m{:full:} ) ? TRUE : FALSE;

## a scanning cycle whose drain poll timer is gone can never finish : the ##
## poll's own backstop cannot run without the timer                       ##
## [ UFG : seen live, no poll at all while the remote queue was empty ]   ##
if ( <jobsite.cycle> eq qw| scanning | ) {
    my $timer = <jobsite.queue_poll_timer>;
    my $live
        = (     defined $timer
            and $timer->can(qw| is_active |)
            and $timer->is_active ) ? TRUE : FALSE;
    my $poll  = <jobsite.queue_poll>  // {};
    my $since = $poll->{'last_reply'} // $poll->{'started'}
        // <jobsite.last_scan> // 0;
    my $limit = <jobsite.cfg.queue_poll_timeout> // 900;
    if ( not $live and time - $since >= $limit ) {
        my $why = sprintf 'scanning for %d s with no live drain poll timer',
            time - $since;
        <[base.logs]>->(
            0, ': scan : BACKSTOP : %s -- a cause was missed, resetting', $why
        );
        <jobsite.last_fetch> //= { 'replies' => 0, 'failed' => 0 };
        <jobsite.last_fetch>->{'failed'} ||= 1;
        <jobsite.last_fetch>->{'why'} = "scan backstop : $why";
        <jobsite.last_fetch>->{'at'}  = time;
        <jobsite.queue_poll_timer>    = undef;
        <jobsite.fetch_saw_queue>     = FALSE;
        <jobsite.cycle>               = qw| idle |;
        <[jobsite.state.persist]>;
    }
}

if ( <jobsite.cycle> ne qw| idle | ) {
    return {
        'mode' => qw| false |,
        'data' => sprintf( 'cycle already active : %s', <jobsite.cycle> ),
    };
}

<[jobsite.store.prune]>;

<[jobsite.stage.fetch]>->($full_mode);

my $msg = $full_mode ? 'full scan started' : 'scan started';
return { 'mode' => qw| true |, 'data' => $msg };

