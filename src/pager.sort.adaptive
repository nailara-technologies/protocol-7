## [:< ##

# name  = pager.sort.adaptive
# descr = Adaptive sort based on user access patterns

my ($args) = @ARG;
my $items  = $args->{'items'};
my $spec   = $args->{'spec'} // {};

return $items unless @$items > 1;

my $base_keys = $spec->{'keys'}    // [];
my $history   = $spec->{'history'} // {};    # Access pattern history

# Analyze history to determine adaptive weights
my $adaptive_keys = <[pager.util.sort.compute_adaptive_keys]>->(
    $base_keys, $history, $items
);

# Delegate to multi-key sort with adaptive weights
return <[pager.sort.multi-key]>->(
    {   'items' => $items,
        'spec'  => { 'keys' => $adaptive_keys },
    }
);

