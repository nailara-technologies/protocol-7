# name  = v7.zenka.cmd.restart_concurrent
# descr = concurrent restart with handover [ zero-downtime ]
# note  = starts new instance alongside old, handover when new is ready

my ( $zenka, $zenka_sid ) = split( m| |, $call->{'args'}, 3 );

## validate injected source sid
unless ( defined $zenka_sid and $zenka_sid =~ m|^\d+$| ) {
    <[base.logs]>->(
        1,
        'restart_concurrent: no source sid injected [ cube misconfigured? ]'
    );
    return {
        'mode' => qw| false |,
        'data' => 'source zenka sid not available'
    };
}

## find source instance by cube_sid
my $old_instance_id;
foreach my $id (<[v7.instance_ids]>) {
    my $instance = <v7.zenka.instance>->{$id};
    $old_instance_id = $id
        and last
        if exists $instance->{'cube_sid'}
        and defined $instance->{'cube_sid'}
        and $instance->{'cube_sid'} == $zenka_sid;
}

unless ( defined $old_instance_id ) {
    <[base.logs]>->(
        2,          'restart_concurrent: sid %s not managed by v7 [ %s ]',
        $zenka_sid, $zenka
    );
    return {
        'mode' => qw| false |,
        'data' => 'caller zenka not managed by v7'
    };
}

my $old_instance = <v7.zenka.instance>->{$old_instance_id};
my $zenka_name   = $old_instance->{'zenka_name'};

## check if already in handover
if ( exists $old_instance->{'being_replaced_by'} ) {
    return {
        'mode' => qw| true |,
        'data' => sprintf( 'handover already in progress [new instance %d]',
            $old_instance->{'being_replaced_by'} )
    };
}

## get drain timeout from config
my $zenka_config  = <v7.start_setup.zenki.config>->{$zenka_name}     // {};
my $drain_timeout = $zenka_config->{'concurrent'}->{'drain_timeout'} // 30;

## initiate concurrent restart
<[base.logs]>->(
    "initiating concurrent restart for "
        . "'%s' [instance %d, drain_timeout=%.1fs]",
    $zenka_name, $old_instance_id, $drain_timeout
);

## track handover pair (links old and new instances)
my $new_instance_id = <[v7.zenka.instance.track_handover]>
    ->( $old_instance_id, $drain_timeout );

unless ( defined $new_instance_id ) {
    return {
        'mode' => qw| false |,
        'data' => 'failed to create handover tracking'
    };
}

## start new instance with handover expansion slot
my $start_reply = <[zenka.cmd.start]>->(
    {   'args'   => $zenka_name,
        'mode'   => qw| concurrent-handover |,
        'source' => $old_instance_id
    }
);

if ( $start_reply->{'mode'} ne qw| true | ) {
    ## cleanup handover tracking on failure
    <[v7.zenka.instance.handover_cleanup]>->($old_instance_id);
    return {
        'mode' => qw| false |,
        'data' => sprintf( 'failed to start replacement instance: %s',
            $start_reply->{'data'} )
    };
}

return {
    'mode' => qw| true |,
    'data' => sprintf(
        'concurrent restart initiated [old=%d, new=%d]',
        $old_instance_id, $new_instance_id
    )
};

