## [:< ##

# name  = coding.image.label
# descr = placeholder text for an attached image : path, type, original
#         size and the size the vision model is shown
# param = $path [ as the caller named it ], $image [ load_for_vision result ]

my ( $path, $image ) = @ARG;

my ( $w, $h, $ow, $oh ) = @$image{qw| width height orig_width orig_height |};

## the scaled size alone reads as the image's own resolution             ##
## [ a quality question was answered with 1024x465 for a 1408x640 file ] ##
my $size
    = !$w ? 'size unknown'
    : ( $ow and ( $ow != $w or $oh != $h ) )
    ? sprintf( 'original %dx%d, shown downscaled to %dx%d', $ow, $oh, $w, $h )
    : sprintf( '%dx%d', $w, $h );

return sprintf '[ image : %s, %s, %s ]', $path, $image->{'mime'}, $size;

