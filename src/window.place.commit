## [:< ##

# name  = window.place.commit
# descr = save placement geometry and reply to caller

my $id = shift;

return undef if not defined $id;

my $inst = $data{window}{place}{instances}{$id};
return undef if not defined $inst;

## final geometry recheck: if the user dragged or resized the overlay, read ##
## its actual X11 root geometry at commit time. this corrects any residual  ##
## GTK/Wayland coordinate-space mismatch that the button_release fallback   ##
## may have left in inst->{geom} [ especially for resizes ].                ##
my $window = $inst->{'window'};
if ( $inst->{'placement_interacted'} and defined $window ) {
    my $eval_err   = '';
    my $actual_geo = eval {
        my $gdk_window = $window->get_window;
        return undef if not defined $gdk_window;
        my $xid = $gdk_window->get_xid;
        return undef if not defined $xid or $xid !~ /^\d+$/;
        <[base.X-11.get_window_geometry]>->($xid);
    };
    if ( length $EVAL_ERROR ) {
        $eval_err = <[base.str.eval_error]>->(1);
    }
    if (    defined $actual_geo
        and defined $actual_geo->{'x'}
        and defined $actual_geo->{'y'} ) {
        $inst->{'geom'}{'x'}      = $actual_geo->{'x'};
        $inst->{'geom'}{'y'}      = $actual_geo->{'y'};
        $inst->{'geom'}{'width'}  = $actual_geo->{'width'};
        $inst->{'geom'}{'height'} = $actual_geo->{'height'};
        <[base.logs]>->(
            2,
            '[place.commit] id=%s rechecked from X11 x=%d y=%d w=%d h=%d',
            $id,
            $actual_geo->{'x'},
            $actual_geo->{'y'},
            $actual_geo->{'width'},
            $actual_geo->{'height'}
        );
    } else {
        <[base.logs]>->(
            1,   '[place.commit] id=%s X11 recheck failed: %s',
            $id, length $eval_err ? $eval_err : 'unknown'
        );
    }
    delete $inst->{'placement_interacted'};
}

my $geom = $inst->{'geom'}   // {};
my $x    = $geom->{'x'}      // 0;
my $y    = $geom->{'y'}      // 0;
my $w    = $geom->{'width'}  // 1;
my $h    = $geom->{'height'} // 1;

my $caller = $inst->{'caller'} // '';
my $tag    = $inst->{'tag'}    // '';

if ( length $caller ) {
    <[window.profile.save]>->( $caller, $x, $y, $w, $h );
}

## when opened over a specific window, apply the committed geometry to it ##
my $target_winid = $inst->{'target_winid'};
if ( defined $target_winid and $target_winid =~ m|^\d+$| ) {
    <[base.logs]>->(
        1,   '[place.commit] id=%s moving winid=%s to x=%d y=%d w=%d h=%d',
        $id, $target_winid, $x, $y, $w, $h
    );
    <[base.X-11.move-window]>->( $target_winid, $x, $y, $w, $h );
    <[base.logs]>->(
        2, '[place.commit] id=%s move-window call complete', $id
    );
}

my $reply_id = $inst->{'reply_id'};

my $reply_args = sprintf 'x=%d y=%d width=%d height=%d profile=saved',
    $x, $y, $w, $h;
$reply_args .= " caller=$caller" if length $caller;
$reply_args .= " tag=$tag"       if defined $tag and length $tag;

if ( defined $reply_id and $reply_id =~ m|^\d+$| ) {
    <[base.callback.cmd_reply]>->(
        $reply_id,
        {   'mode' => qw| true |,
            'data' => $reply_args
        }
    );
} else {
    <[base.logs]>->(
        1, '[place.commit] id=%s no reply_id, skipping direct reply', $id
    );
}

<[base.logs]>->( 1, '[place.commit] id=%s placement committed', $id );

## destroy the window if still alive ##
$window = $inst->{'window'};
if ( defined $window and $window->get_visible ) {
    ## ungrab before close : begin_move_drag/begin_resize_drag may leave a
    ## compositor grab that weston does not release on window destruction,
    ## blocking button-1 for all clients [ same hazard fixed for screen.setup
    ## in 0285a96f5, unfixed here until now ]
    eval { Gtk3::Gdk::pointer_ungrab( Gtk3::get_current_event_time() ) };
    $window->destroy;
}

## stop instance timers ##
my $poll_timer = $inst->{'poll'}{'timer'};
$poll_timer->cancel if defined $poll_timer;

my $damp_timer = $inst->{'damp'}{'timer'};
$damp_timer->cancel if defined $damp_timer;

## remove instance state ##
delete $data{window}{place}{instances}{$id};

return TRUE;

