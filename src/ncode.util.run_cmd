## [:< ##

# name  = ncode.util.run_cmd
# descr = run subprocess via IPC::Open3, return output

use IPC::Open3;
use Symbol qw| gensym |;

my @cmd = @ARG;

return '' if not @cmd;

my ( $out, $err ) = ( undef, Symbol::gensym() );
my $pid = eval { IPC::Open3::open3( undef, $out, $err, @cmd ) };

if ( not $pid or $EVAL_ERROR ) {
    return sprintf 'error: failed to spawn %s [ %s ]',
        $cmd[0], $EVAL_ERROR // 'unknown error';
}

local $/;
my $stdout = readline($out) // '';
my $stderr = readline($err) // '';
close $out;
close $err;
waitpid( $pid, 0 );

my $output = $stdout;
$output .= "\n" . $stderr if length $stderr;
return $output;

