## [:< ##

# name  = coding.tools.handler.note_delete
# descr = delete note section or entire task notes

my $args = shift // {};

my $task_id = $args->{'task_id'} // <system.task_id> // 'unknown';
my $section = $args->{'section'} // '';

## call backend ##
my $result = <[note.delete]>->( $task_id, $section );

return {
    'content' => $result->{'mode'} eq qw| true |
    ? $result->{'data'}{'message'}
    : "Failed: " . ( $result->{'data'} // 'unknown' ),
};

