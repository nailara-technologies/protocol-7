## [:< ##

# name  = coding.tools.handler.note_delete
# descr = move note section [ or all task notes, with confirm_all ] to trash

my $args = shift // {};

my $task_id     = $args->{'task_id'} // <system.task_id> // 'unknown';
my $section     = $args->{'section'} // '';
my $confirm_all = $args->{'confirm_all'} ? TRUE : FALSE;

## call backend ##
my $result = <[note.delete]>->( $task_id, $section, $confirm_all );

return {
    'content' => $result->{'mode'} eq qw| true |
    ? $result->{'data'}{'message'}
    : "Failed: " . ( $result->{'data'} // 'unknown' ),
};

