## [:< ##

# name  = ticker.cmd.place_window
# descr = invoke window.place zenka to position the ticker

my $profile = $call->{'args'} // 'bottom-strip';
$profile = 'bottom-strip' if not length $profile;

<[protocol-7.command.send.local]>->(
    {   'command'   => qw| cube.window-place.place_window |,
        'call_args' =>
            { 'args' => sprintf( 'caller=ticker profile=%s', $profile ) },
        'reply' => { 'handler' => qw| ticker.handler.place_reply | }
    }
);

return { 'mode' => qw| true |, 'data' => 'placement requested' };

