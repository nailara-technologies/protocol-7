## [:< ##

# name  = login-screen.handler.lock_activity
# descr = restore a dimmed lock panel and restart its inactivity delay

return FALSE if <login-screen.state> ne qw| locked |;
my $activity = <login-screen.policy.activity> // return FALSE;

## typing hides the pointer, moving \ clicking brings it back ##
my ($event_name) = @ARG;
my $gdk_window = ( <login-screen.window> // return FALSE )->get_window();
if ( defined $gdk_window ) {
    if ( ( $event_name // '' ) eq qw| key-press-event | ) {
        $gdk_window->set_cursor(
            Gtk3::Gdk::Cursor->new_from_name(
                $gdk_window->get_display(),
                qw| none |
            )
        );
    } else {
        $gdk_window->set_cursor(undef);
    }
}

$activity->($event_name);
FALSE;

