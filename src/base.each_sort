## [:< ##

# name  = base.each_sort

my $hash_ref = shift;
my $filtered = shift // 1;
die 'expected hash reference' if ref($hash_ref) ne qw| HASH |;

my @pairs;
foreach my $key ( <[base.sort]>->($hash_ref) ) {
    next if $filtered and not defined $hash_ref->{$key};

    push( @pairs, $key => $hash_ref->{$key} );
}

return @pairs;

