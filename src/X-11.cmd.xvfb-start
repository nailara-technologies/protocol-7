## [:< ##

# name  = X-11.cmd.xvfb-start
# param = <disp_num> <w> <h> [depth=24]
# descr = start an xvfb instance on the given display

my @args
    = ref( $call->{'args'} ) eq qw| ARRAY |
    ? $call->{'args'}->@*
    : split( m| +|, $call->{'args'} );

my ( $display_num, $width, $height, $depth ) = @args;
$depth //= 24;

return { 'mode' => qw| false |, 'data' => 'display number required' }
    if not defined $display_num;
return { 'mode' => qw| false |, 'data' => 'width and height required' }
    if not defined $width or not defined $height;
return { 'mode' => qw| false |, 'data' => 'invalid display number' }
    if $display_num !~ m|^\d+$|;
return { 'mode' => qw| false |, 'data' => 'invalid geometry values' }
    if grep { not defined $_ or $_ !~ m|^\d+$| or $_ == 0 }
    ( $width, $height, $depth );

my $display_str = sprintf qw| :%s |, $display_num;

if (    defined <X-11.servers>->{$display_str}
    and defined <X-11.servers>->{$display_str}->{'pid'} ) {
    my $stored_pid = <X-11.servers>->{$display_str}->{'pid'};
    if ( kill 0, $stored_pid ) {
        return {
            'mode' => qw| false |,
            'data' => sprintf(
                'xvfb %s already running [ pid %d ]',
                $display_str, $stored_pid
            )
        };
    }
}

my $xvfb_bin = <X-11.bin_path>->{'Xvfb'};
return { 'mode' => qw| false |, 'data' => 'Xvfb binary not found' }
    if not defined $xvfb_bin;

## resource guard : self-chain dep per geometry, like ensure_model_pinned   ##
## start_server queues unconditionally; this pre-check rejects if resources ##
## do not fit.                                                              ##
<X-11.xvfb.dep.resource> //= {};
my $res_key    = sprintf '%dx%dx%d', $width, $height, $depth;
my $res_dep_id = <X-11.xvfb.dep.resource>->{$res_key};

unless ( defined $res_dep_id ) {
    $res_dep_id = <[dependency.add_object]>->(
        {   'type'   => qw| xvfb_resource_available |,
            'width'  => $width,
            'height' => $height,
            'depth'  => $depth,
        }
    );
    <[dependency.add]>->( $res_dep_id, $res_dep_id )
        ;    ## self-chain : invokes the callback ##
    <X-11.xvfb.dep.resource>->{$res_key} = $res_dep_id;
}

my $resource_ok = <[dependency.ok]>->($res_dep_id);
if ( not $resource_ok ) {
    <[base.logs]>->(
        0,
        '[xvfb-start] resource check failed for %s: dimensions '
            . '%dx%dx%d exceed limits or insufficient system memory',
        $display_str,
        $width,
        $height,
        $depth
    );
    return {
        'mode' => qw| false |,
        'data' => 'resource limit exceeded (dimensions or memory)'
    };
}

## register server entry and its dependency object ##
<X-11.servers>->{$display_str} //= {};
my $server = <X-11.servers>->{$display_str};
$server->{'mode'}     = qw| xvfb |;
$server->{'display'}  = $display_str;
$server->{'bin_name'} = qw| Xvfb |;

my $dep_id = <[dependency.add_object]>
    ->( { 'type' => 'x11_display_flag', 'display' => $display_str } );
<[dependency.add]>->( $dep_id, $dep_id );
$server->{'dep_id'} = $dep_id;

my $params_str = sprintf '-screen 0 %dx%dx%d', $width, $height, $depth;

## start job runs unconditionally [ object_id 0 = no dependency ] -- it's  ##
## the job that SATISFIES $dep_id by forking Xvfb and polling the socket,  ##
## so gating it on $dep_id would deadlock : nothing could ever resolve the ##
## dependency it's waiting on. only finalize waits on $dep_id.,            ##
<[jobqueue.add_job]>->(
    {   'name'            => "X-11 start server $display_str",
        'job_callback'    => qw| X-11.job.start_server |,
        'object_id'       => 0,
        'callback_params' => {
            'display'  => $display_str,
            'mode'     => qw| xvfb |,
            'params'   => $params_str,
            'bin_name' => qw| Xvfb |,
            'primary'  => FALSE
        }
    }
);

<[jobqueue.add_job]>->(
    {   'name'            => "X-11 finalize server $display_str",
        'job_callback'    => qw| X-11.job.finalize_server |,
        'object_id'       => $dep_id,
        'callback_params' => {
            'display' => $display_str,
            'primary' => FALSE
        }
    }
);

return {
    'mode' => qw| true |,
    'data' => $display_str
};

