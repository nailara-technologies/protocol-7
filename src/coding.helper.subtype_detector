# name = coding.helper.subtype_detector
# descr = detect task subtype from description keywords

my $desc = shift @ARG // '';

return 'protocol7-module' if $desc =~ /protocol.?7|module|zenka/i;
return 'consensus-voting' if $desc =~ /consensus|vote|multiple.*model/i;
return 'math-problem'     if $desc =~ /math|equation|calculate|algorithm/i;
return 'code-review'      if $desc =~ /review|check|validate|test/i;
return 'documentation'    if $desc =~ /document|explain|describe|guide/i;
return 'general';

