# name = coding.helper.subtype_detector
# descr = detect task subtype from description keywords

my $desc = shift @ARG // '';

return 'protocol7-module' if $desc =~ m{protocol.?7|module|zenka}i;
return 'consensus-voting' if $desc =~ m{consensus|vote|multiple.*model}i;
return 'math-problem'     if $desc =~ m{math|equation|calculate|algorithm}i;
return 'code-review'      if $desc =~ m{review|check|validate|test}i;
return 'documentation'    if $desc =~ m{document|explain|describe|guide}i;
return 'general';

