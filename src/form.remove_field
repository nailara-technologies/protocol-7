## [:< ##

# name  = form.remove_field
# descr = take an empty optional field back off the form
# param = $field_name

## the MIRROR of form.add_field, and the other half of a vocabulary that was
## one-way until now : Delete on an empty optional field takes it off the
## form, and the add-a-field row offers it again immediately.
##
## only EMPTY fields, and only optional ones -- the caller  [
## form.handler.stdin_key ] enforces both, which is also why there is no
## confirmation step : nothing is lost, and the field is one keystroke away
## from coming back.
##
## the RECORD changes on submit, like every other edit in this form.  no
## delete command is needed for that : users.cmd.value-set hands its json to
## users.record.build as the WHOLE fields hash, so a field that is no longer
## in the schema is simply no longer in the record.
##
## rebuilds through editor.control.create rather than patching the two
## structures, the same move add_field and editor.control.list.expand make,
## and for the same reason : there is no add/remove-field primitive, and
## recreating reuses every guard create already has.

my ($field_name) = @ARG;

my $editor_state = <form.state>;

return FALSE if ref $editor_state ne qw| HASH |;
return FALSE if not defined $field_name or not length $field_name;

## COLLAPSE FIRST, for the same reason form.submit does : an  expanded list is
## on screen as '<field>_0', '<field>_1' and the field itself is not in the
## schema at all, so there would be nothing here to remove.  collapse is a
## no-op when nothing is expanded
my $collapsed = <[editor.control.list.collapse]>->($editor_state);

$editor_state = $collapsed
    if ref $collapsed eq qw| HASH | and $collapsed != $editor_state;

my ($target)
    = grep { ( $ARG->{'name'} // '' ) eq $field_name }
    ( $editor_state->{'schema'}{'fields'} // [] )->@*;

return FALSE if ref $target ne qw| HASH |;

## every field EXCEPT the one going away, each with its current value ##
my @fields;

foreach my $field_def ( $editor_state->{'schema'}{'fields'}->@* ) {

    my $name = $field_def->{'name'} // next;

    next if $name eq $field_name;
    next if $field_def->{'add_field'};

    push @fields,
        {
        %{$field_def},
        $field_def->{'list'}
        ? ()
        : ( qw| default | =>
                <[editor.control.get_value]>->( $editor_state, $name ) // '' )
        };
}

## a form with nothing left in it cannot be rendered [ build_frame refuses an
## empty field list ], and a record with no fields is not editable either --
## the default fields are never optional, so this cannot happen from the
## keystroke path, but a caller reaching here directly must not be able to
## empty the form
return FALSE if not @fields;

my $new_state = <[editor.control.create]>
    ->( { qw| fields | => \@fields, qw| active_field | => 0 } );

return FALSE if not defined $new_state;

$new_state->{'kill_buffer'} = $editor_state->{'kill_buffer'} // '';
$new_state->{'mode'}        = qw| insert |;
$new_state->{'title'}       = $editor_state->{'title'};

## the removed name is addable again, and comes back through the same local
## filter everything else uses -- so the case where the row did not exist at
## all, every option having been taken, needs no special handling : the
## rebuilt state simply gains one
<[form.add_field_row]>->( $new_state, <[form.addable_fields]>->($new_state) );

## focus the row that TOOK the removed field's place, by position rather than
## by name -- staying where you were reads as the row having been deleted from
## under the cursor, which is what happened.  clamped : active_field is an
## INDEX, and editor.ui.ascii_frame.render_form autovivifies a phantom field
## def from an out-of-range one rather than failing
my $position = 0;
foreach my $field_def ( $editor_state->{'schema'}{'fields'}->@* ) {
    last if ( $field_def->{'name'} // '' ) eq $field_name;
    $position++;
}

my $field_count = scalar $new_state->{'schema'}{'fields'}->@*;
$position = $field_count - 1 if $position > $field_count - 1;
$position = 0                if $position < 0;

$new_state->{'active_field'} = $position;

<form.state> = $new_state;

<[form.build_frame]>->(
    $new_state,
    <form.frame_name> // qw| user-edit-form |,
    $new_state->{'title'} // <form.title>
);

## checkpoint : the draft is rebuilt from the schema on every field
## transition, so it drops the removed key on its own -- but not until the
## next one, and a draft that still lists a field the form no longer has is a
## draft that disagrees with the screen
<[form.field_changed]>;

return TRUE;

