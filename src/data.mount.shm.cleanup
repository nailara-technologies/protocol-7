## [:< ##

# name  = data.mount.shm.cleanup
# descr = end_code callback : unlock + unlink creator-owned SHM segments on
#         normal shutdown [ phase 4 part A ]

<[base.log]>->( 2, "SHM subsystem cleaning up on shutdown" );

# Unlock all mlocked segments
for my $path ( keys <mount.shm.segments>->%* ) {
    my $seg = <mount.shm.segments>->{$path};
    if ( $seg && $seg->{'mlocked'} ) {
        eval { <[data.mount.shm.lock.unlock]>->( $seg->{'mmap_ptr'} ) };
    }
}

## phase 4 : unlink every creator-owned segment                             ##
## [ + its FIFO, handled already inside data.mount.shm.remove ] on graceful ##
## shutdown. reader-opened segments are never in this hash — see            ##
## data.mount.shm.init_code / the phase-4 task doc's "critical correctness  ##
## rule" — so this never touches a segment this process did not create.     ##
for my $path ( keys <mount.shm.segments>->%* ) {
    eval { <[data.mount.shm.remove]>->($path) };
}

return TRUE;

