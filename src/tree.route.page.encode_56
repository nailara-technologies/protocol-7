## [:< ##

# name = tree.route.page.encode_56
# descr = encode 7 bytes as 56-bit routing word with leading bits

my $input = shift // '';

return undef if length($input) != 7;

my $bits_56 = unpack qw| B* |, $input;

my $result;

for my $i ( 0 .. 7 ) {
    if ( $i < 7 ) {
        $result .= pack qw| B8 |, qw| 1 | . substr( $bits_56, $i * 7, 7 );
    } else {
        $result .= pack qw| B8 |, qw| 0 | . substr( $bits_56, $i * 7, 7 );
    }
}

return $result;

