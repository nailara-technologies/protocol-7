## [:< ##

# name   = keystore.trash.live_path
# descr  = where a removable key-store entry lives [ by kind + name ]
# param  = <kind> <name>
# return = path or undef [ list context : ( undef, reason ) ]
#
# kinds [ undo-remove ] : 'host-pin' [ servers/<name>.public, name =
# '<host>_<port>' ], 'owner-pin' [ owners/<name>.public ], 'distrust'
# [ the distrust list, name 'distrust' ], 'owner-statement' [ the
# backend key dir's host-root.dlg, name 'host-root' ].

my ( $kind, $name ) = @ARG;

my $refuse = sub {
    my $reason = shift;
    return wantarray ? ( undef, $reason ) : undef;
};

return $refuse->('name not valid')
    if not defined $name
    or $name !~ m|\A[A-Za-z0-9][A-Za-z0-9._:-]{0,127}\z|;

$kind //= '';

if ( $kind eq qw| host-pin | ) {
    my $dir = <[crypt.C25519.key_vars]>->{'known_hosts_dir'};
    return $refuse->('no host pin dir') if not defined $dir;
    return catfile( $dir, "$name.public" );
} elsif ( $kind eq qw| owner-pin | ) {
    my ( $dir, $why ) = <[keystore.remote_keys_dir]>->( qw| owners |, TRUE );
    return $refuse->($why) if not defined $dir;
    return catfile( $dir, "$name.public" );
} elsif ( $kind eq qw| distrust | ) {
    return $refuse->('the distrust list is named distrust')
        if $name ne qw| distrust |;
    my ( $dir, $why ) = <[keystore.remote_keys_dir]>->( undef, TRUE );
    return $refuse->($why) if not defined $dir;
    return catfile( $dir, qw| distrust | );
} elsif ( $kind eq qw| owner-statement | ) {
    return $refuse->('the owner statement is named host-root')
        if $name ne qw| host-root |;
    my $path = <[crypt.C25519.delegation_file]>->(qw| host-root |);
    return $refuse->('no path for host-root.dlg') if not defined $path;
    return $path;
}

return $refuse->("kind '$kind' not known");

