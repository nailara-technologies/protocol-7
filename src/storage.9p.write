## [:< ##
# name  = storage.9p.write
# descr = Write bytes to an open file on 9P server

my ( $conn, $fid, $offset, $content ) = @ARG;
$offset  //= 0;
$content //= '';

my $tag = ++$conn->{tag} & 0xFFFF;

my $req
    = <[plan-9.protocol.codec.encode-uint32]>->($fid)
    . <[plan-9.protocol.codec.encode-uint64]>->($offset)
    . <[plan-9.protocol.codec.encode-uint32]>->( length $content )
    . $content;

my $msg = <[plan-9.protocol.codec.encode-message]>->(
    <plan-9.protocol.constants.Twrite>,
    $tag, $req
);

$conn->{socket}->send($msg);

my $resp = <[storage.9p.read-message]>->( $conn, $tag );
return $resp if $resp->{'mode'} eq 'false';

my $payload = $resp->{'data'};
my $written
    = <[plan-9.protocol.codec.decode-uint32]>->( substr( $payload, 0, 4 ) );

return { 'mode' => 'true', 'data' => $written };

