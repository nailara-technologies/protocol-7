## [:< ##

# name   = host-edit.transport.free_port
# descr  = a free local tcp port on 127.0.0.1 [ for an ssh forward ]
# return = port number or undef

require IO::Socket::INET;

my $sock = IO::Socket::INET->new(
    qw| LocalAddr | => '127.0.0.1',
    qw| LocalPort | => 0,
    qw| Proto |     => 'tcp',
    qw| Listen |    => 1,
    qw| ReuseAddr | => 1,
);
return undef if not defined $sock;

my $port = $sock->sockport;
close($sock);
return $port;

