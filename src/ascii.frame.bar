## [:< ##

# name  = ascii.frame.bar
# descr = render a fractional value [ 0..1 ] as a ptd-style fill bar to a width

my $params = shift // {};

my $frac  = $params->{'frac'}  // 0;
my $width = $params->{'width'} // 0;
my $char  = $params->{'char'}  // ':';

## [ clamp into range ]##
$frac  = 0 if $frac < 0;
$frac  = 1 if $frac > 1;
$width = 0 if $width < 0;

my $fill = int( $width * $frac );
$fill = $width if $fill > $width;

## [ left-justify the fill run, space-padded to full width — ptd style ]##
return sprintf( '%-*s', $width, $char x $fill );

