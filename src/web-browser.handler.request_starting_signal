# name = web-browser.handler.request_starting_signal

my ( $view, $decision, $decision_type ) = @_;

## only intercept navigation decisions (not resource loads)
return FALSE unless $decision_type eq 'navigation-action';

## block user-initiated navigation when links_clickable is off ##
if ( !<[base.cfg_bool]>->(<web-browser.cfg.links_clickable>) ) {
    my $nav_action = eval { $decision->get_navigation_action };
    if ( defined $nav_action && eval { $nav_action->is_user_gesture } ) {
        $decision->ignore;
        return TRUE;
    }
}

my $request = $decision->get_request;
my $uri     = $request->get_uri;

## allow non-http/https schemes through (about:blank, data:, file:, etc.)
return FALSE if $uri !~ m{^https?://}i;

( my $allowed = <web-browser.load_uri> ) =~ s{^https?://|/.*$}{}g;

## allowed ##

return FALSE
    if $uri =~ m|:blank\]?$|
    or $uri =~ m{^https?://([^/]+\.)?\Q$allowed\E}i;

## blocked ##

<[base.log]>->( 0, "<< ! >> <$allowed> blocked access : " . $uri )
    if length($uri);

$decision->ignore;

return TRUE;    ## TRUE = handled (blocks default action)

