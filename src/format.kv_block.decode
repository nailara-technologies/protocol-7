## [:< ##

# name  = format.kv_block.decode
# descr = decode kv_block text [ 78 col ] to ordered key-value pairs
# param = $block - kv_block text string
# return = arrayref of [ key, value ] pairs [ order preserved ]

my $block = shift // '';

my @lines = split m|\n|, $block, -1;

## key lines : strict key charset in the aligned column, ':' on both sides ##
## right-aligned keys share one separator column; continuation lines that  ##
## happen to match the pattern start at a wider column, so the minimal     ##
## separator column among all candidates unambiguously marks key lines     ##
my $key_re = qr|^:( +)([\w\-\.]+)  :(?:  (.*))?$|;

my @candidates;
foreach my $i ( 0 .. $#lines ) {
    if ( $lines[$i] =~ $key_re ) {
        push @candidates, [ $i, length($1) + length($2) ];
    }
}
return [] unless @candidates;

my $min_col;
foreach my $cand (@candidates) {
    $min_col = $cand->[1] if not defined $min_col or $cand->[1] < $min_col;
}
my %is_key = map { $_->[0] => 1 } grep { $_->[1] == $min_col } @candidates;

## continuation prefix : ':' . ' ' x ( $max_len + 7 ) [ max_len = min_col - ##
## 2 ]                                                                      ##
my $strip_n  = $min_col + 5;
my $strip_re = qr|^: {0,$strip_n}(.*)$|;

my $recon_para = sub {    ## wrapped vs free-format reconstruction ##
    my $para = shift;     ## arrayref of [ physical_line_length, content ]
    return $para->[0][1] if @{$para} == 1;

    my $wrapped = 1;
    foreach my $i ( 0 .. $#{$para} - 1 ) {
        my ($next_word) = grep {length} split m|\s+|, $para->[ $i + 1 ][1];
        $next_word //= '';
        ## next word would have fit -> break not forced -> free-format [  ##
        ## Text::Wrap reserves one column : max text = columns - prefix - ##
        ## 1, so a word fits iff physical_len + 1 + word_len <= 78 - 1 ]  ##
        if ( $para->[$i][0] + 1 + length($next_word) <= 78 - 1 ) {
            $wrapped = 0;
            last;
        }
    }
    return join( ' ',
        grep {length} map { split m|\s+| } map { $_->[1] } @{$para} )
        if $wrapped;
    return join( "\n", map { $_->[1] } @{$para} );
};

my @pairs;
my $cur_key;
my ( @cur_paras, @cur_para );

my $flush_para = sub {
    push( @cur_paras, [@cur_para] ) if @cur_para;
    @cur_para = ();
};
my $flush_key = sub {
    return unless defined $cur_key;
    $flush_para->();
    push @pairs,
        [ $cur_key, join( "\n\n", map { $recon_para->($_) } @cur_paras ) ];
    $cur_key   = undef;
    @cur_paras = ();
    @cur_para  = ();
};

foreach my $i ( 0 .. $#lines ) {
    my $line = $lines[$i];
    if ( $is_key{$i} ) {
        $flush_key->();
        $line =~ $key_re;
        $cur_key = $2;
        my $content = $3 // '';
        @cur_paras = ();
        @cur_para  = ();
        push @cur_para, [ length($line), $content ] if length $content;
    } elsif ( $line =~ m|^:\s*$| ) {
        $flush_para->();    ## framed blank line -> paragraph break
    } elsif ( defined $cur_key and $line =~ $strip_re ) {
        push @cur_para, [ length($line), $1 ];
    }
    ## any other lines [ before first key, malformed ] are ignored
}
$flush_key->();

return \@pairs;

