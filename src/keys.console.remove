#\\\|44B6CFBO3KX4L76FRYYO7JJATJ2BNXKAZISV5HD6RL63ZZGLXE2 \ / AMOS7 \ YOURUM ::
#\[7]MOPGL4IQPEIJUV74NVXVFTQEDSS36OEHGHILX67LNOOGQZG7R4CA 7  DATA SIGNATURE ::
