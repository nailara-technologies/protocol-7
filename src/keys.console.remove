#HMYUEC54HDFBCTNKHP6HXJ3JJALLPGCGWL6SKVURL7WOUFLUKH4NG3S3OP6F3GLGPOAEEL5PCEMB6
#\\\|IVFIHM2FD4YHG757N4IIHVZIVCFZHJ6OJYZS3RBLADDR3VKF6UY \ / AMOS7 \ YOURUM ::
#\[7]CU57GFMON3BA4TPP2MGWIC7QDJNTLD7SCNP4PMOGMEANQKSEPEBI 7  DATA SIGNATURE ::
