## [:< ##

# name  = work.generate_workspace_index
# descr = generate workspace-transfer index

my $repos = <[work.scan_workspace_repos]>;
my $bugs  = <[work.extract_workspace_bugs]>;

my $index_data = {
    generated_at => scalar( localtime() ),
    timestamp    => <[base.ntime]>,
    repos        => $repos,
    total_bugs   => scalar(@$bugs),
    bugs         => $bugs
};

# Ensure index directory exists
my $index_dir = <work.cfg.index_dir>;
unless ( -d $index_dir ) {

    # Create with parents if needed
    require File::Path;
    File::Path::make_path($index_dir)
        or die "Cannot create " . "index directory: $!";
}

# Check if existing index exists and compare content (ignoring timestamps)
my $workspace_index = <work.index.workspace>;
my $should_write    = 1;

## an unreadable \ empty index is rewritten [ should_write stays set ] ##
my $existing_data
    = -f $workspace_index
    ? <[format.yaml.load_file]>->($workspace_index)
    : undef;

if ( ref $existing_data eq qw| HASH | ) {

    # Compare content excluding timestamp fields
    my $existing_copy = {%$existing_data};
    delete $existing_copy->{generated_at};
    delete $existing_copy->{timestamp};

    my $new_copy = {%$index_data};
    delete $new_copy->{generated_at};
    delete $new_copy->{timestamp};

    # Compare serialized versions to detect any actual changes
    if ( YAML::XS::Dump($existing_copy) eq YAML::XS::Dump($new_copy) ) {
        $should_write = 0;    # Only timestamp changed, skip write
    }
}

# Write index only if content actually changed
YAML::XS::DumpFile( $workspace_index, $index_data ) if $should_write;

return $index_data;

