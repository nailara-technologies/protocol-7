# name  = models.trash.load_protected
# descr = load the opt-in delete-protection checksum list from disk --
#         called once, lazily, via <models.protected_checksums> //= in
#         every command that touches it, so a restart-less zenka never
#         re-reads the file on every single call

my $path = <[file.zenka_dir.data_path]> . '/protected_checksums.yaml';

return {} unless -f $path;

my $loaded = <[format.yaml.load_file]>->($path);

return ( ref $loaded eq qw| HASH | ) ? $loaded : {};

