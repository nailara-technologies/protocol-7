## [:< ##

# name  = jobsite.report.mail_split
# descr = split a raw unix mbox file into rfc2822 messages
# param = $path
# return = arrayref of raw message strings

my $path = shift // '';
return [] if not -f $path;

my $content_ref = <[file.slurp]>->($path);
return [] if not defined $content_ref;

my @lines = split m|\r?\n|, $$content_ref;

my @messages;
my @current;
for my $line (@lines) {
    if ( $line =~ m|^From \S+| and @current ) {
        push @messages, join( "\n", @current );
        @current = ();
        next;
    }
    next if $line =~ m|^From \S+| and not @current;    ## first delimiter ##
    $line =~ s|^>(From )|$1|;    ## mboxrd unescaping of quoted "From " ##
    push @current, $line;
}
push @messages, join( "\n", @current ) if @current;

return \@messages;

