## [:< ##

# name  = ncode.transform.handler.wave_reply
# descr = async reply handler for transform.wave LLM dispatch

my $reply = shift;

## extract reply components : TRUE \ FALSE replies carry no mode \ data ##
## [ base.reply.mode_text ]                                             ##
my ( $mode, $data ) = <[base.reply.mode_text]>->($reply);
my $params = $reply->{'params'} // {};

## a FALSE answer has no transform in it : the regex result stands ##
if ( $mode eq qw| false | ) {
    <[base.logs]>->(
        1,
        ':. ncode.transform.handler.wave_reply: llm '
            . 'answered FALSE [ %s ], keeping the regex result :.',
        $data
    );
    $data = '';
}

## extract wave state from reply params ##
my $wave_state = $params;

my $original_input = $wave_state->{'original_input'} // '';
my $regex_input    = $wave_state->{'input'}          // '';
my $file_type      = $wave_state->{'file_type'}      // qw| module |;
my $namespace      = $wave_state->{'namespace'}      // '';
my $save_patterns  = $wave_state->{'save_patterns'}  // 1;
my $regex_applied  = $wave_state->{'regex_applied'}  // 0;
my $regex_flagged  = $wave_state->{'regex_flagged'}  // 0;

## get reply_id for callback : the command's own, carried in the wave state ##
## [ a reply hash has no reply_id, the waiting caller never got its answer  ##
## before 2026-10-23 ]                                                      ##
my $reply_id = $wave_state->{'reply_id'} // '';

## decode LLM response (base32r encoded) ##
my $llm_output = '';

if ( length $data ) {
    <[base.perlmod.load]>->('Crypt::Misc');

    $llm_output = eval { Crypt::Misc::decode_b32r($data) };

    if ( $@ or not defined $llm_output ) {
        <[base.logs]>->(
            0,
            ':. ncode.transform.handler.wave_reply: '
                . 'base32r decode failed [ %s ] :.',
            $@ // qw| unknown |
        );
        $llm_output = '';
    }
}

## fallback to regex output if LLM response empty or failed ##
my $final_output = length $llm_output ? $llm_output : $regex_input;
my $changed      = $final_output ne $original_input;

## extract code block if present (LLM may wrap in markdown) ##
if ( $final_output =~ m|```(?:\w+)?\n(.+?)\n```|s ) {
    $final_output = $1;
    $changed      = $final_output ne $original_input;
}

## assess patterns from the diff ##
my $candidates     = [];
my $patterns_added = 0;

if ( $changed and length $final_output ) {
    my $assess_result = <[ncode.regex.assess]>->(
        {   'input'   => $regex_input,
            'output'  => $final_output,
            'context' => {
                'file_type' => $file_type,
                'namespace' => $namespace,
                'task_id'   => $reply_id
            }
        }
    );

    if ( $assess_result->{'mode'} eq qw| true | ) {
        $candidates = $assess_result->{'data'} // [];

        ## expand candidates to library if found ##
        if (@$candidates) {
            my $expand_result = <[ncode.regex.expand]>->(
                {   'candidates' => $candidates,
                    'merge_mode' => qw| add |
                }
            );

            if ( $expand_result->{'mode'} eq qw| true | ) {
                $patterns_added = $expand_result->{'data'}->{'added'} // 0;

                <[base.logs]>->(
                    2,
                    ':. ncode.transform.handler.wave_reply: '
                        . 'expanded %d patterns :.',
                    $patterns_added
                );

                ## persist if save_patterns enabled ##
                if ( $save_patterns and $patterns_added > 0 ) {
                    my $save_file
                        = sprintf( 'data/ncode/patterns/%s.yaml',
                        $file_type );

                    my $save_result = <[ncode.regex.save]>->(
                        {   'file'   => $save_file,
                            'filter' => ''
                        }
                    );

                    if ( $save_result->{'mode'} ne qw| true | ) {
                        <[base.logs]>->(
                            1,
                            ':. ncode.transform.handler.wave_reply: '
                                . 'save failed [ %s ] :.',
                            $save_result->{'data'} // qw| unknown |
                        );
                    }
                }
            }
        }
    }
}

## build wave stats ##
my $wave_stats = {
    'regex_applied'      => $regex_applied,
    'regex_flagged'      => $regex_flagged,
    'llm_applied'        => $changed ? 1 : 0,
    'patterns_extracted' => scalar @$candidates,
    'patterns_added'     => $patterns_added
};

## answer the waiting command : the same ncfg reply ncode.cmd.transform     ##
## gives when no llm wave was needed [ ncode.transform.format_reply ] --    ##
## the hash this sent went out as HASH(0x..) ; the waves after this one are ##
## not continued yet [ remaining_waves, todo ]                              ##
if ( length $reply_id ) {
    <[base.callback.cmd_reply]>->(
        $reply_id,
        {   'mode' => qw| size |,
            'data' => <[ncode.transform.format_reply]>->(
                {   'output'      => $final_output,
                    'changed'     => $changed,
                    'total_stats' => { %$wave_stats, 'llm_calls' => 1 },
                    'candidates'  => $candidates,
                }
            ),
        }
    );
}

return TRUE;

