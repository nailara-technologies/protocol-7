# name  = login-screen.handler.session_state_reply
# descr = startup : hide while a user session runs, else show the form

my $reply = shift // {};
return FALSE if <login-screen.state> ne qw| init |;

my ( undef, $text ) = <[base.reply.mode_text]>->($reply);
if ( ( $reply->{'cmd'} // '' ) eq qw| TRUE | ) {
    if ( ( $text // '' ) =~ m|^locked ([a-z_][a-z0-9_-]{0,31})$| ) {
        my $username = ${^CAPTURE}[0];
        <login-screen.session_user> = $username;
        <[base.log]>->('user session locked : restoring lock window');
        return <[login-screen.show_lock]>->($username);
    }
    if ( ( $text // '' ) =~ m|^active ([a-z_][a-z0-9_-]{0,31})$| ) {
        <login-screen.session_user> = ${^CAPTURE}[0];
        <login-screen.state>        = qw| session |;
        <[base.log]>->('user session running : greeter stays hidden');
        return TRUE;
    }
}
<[login-screen.show_greeter]>;
TRUE;

