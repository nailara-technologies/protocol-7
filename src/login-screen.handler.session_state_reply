# name  = login-screen.handler.session_state_reply
# descr = startup : hide while a user session runs, else show the form

my $reply = shift // {};
return FALSE if <login-screen.state> ne qw| init |;

my ( undef, $text ) = <[base.reply.mode_text]>->($reply);
if (    ( $reply->{'cmd'} // '' ) eq qw| TRUE |
    and ( $text // '' ) =~ m|^active [a-z_][a-z0-9_-]{0,31}$| ) {
    <login-screen.state> = qw| session |;
    <[base.logs]>->('user session running : greeter stays hidden');
    return TRUE;
}
<[login-screen.show_greeter]>;
TRUE;

