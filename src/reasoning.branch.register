## [:< ##

# name  = reasoning.branch.register
# param = { id, agent, task_id, deps, context_path }

my $params = shift // {};

## command interface ##
if ( ref $params eq qw| HASH | and exists $params->{'args'} ) {
    my $args = $params->{'args'} // '';
    if ( length $args ) {
        my $parsed = eval { <[format.yaml.load_str]>->($args) };
        $params
            = ( defined $parsed and ref $parsed eq qw| HASH | )
            ? $parsed
            : { id => $args };
    } else {
        $params = {};
    }
}

my $id = $params->{'id'} // '';
return { 'mode' => qw| false |, 'data' => 'branch id required' }
    unless length $id;

my $registry = <reasoning.branch.registry> //= {};

## reject duplicate registration ##
return {
    'mode' => qw| false |,
    'data' => sprintf( 'branch %s already registered', $id )
    }
    if exists $registry->{$id};

my $deps = $params->{'deps'} // [];
$deps = [$deps] if ref $deps ne qw| ARRAY |;

## if deps specified, start as paused; otherwise running ##
my $initial_state = ( scalar @$deps ) ? qw| paused | : qw| running |;

$registry->{$id} = {
    agent        => $params->{'agent'}   // 'unknown',
    task_id      => $params->{'task_id'} // $id,
    state        => $initial_state,
    deps         => $deps,
    context_path => $params->{'context_path'} // '',
    checkpoints  => [],
    stuck_score  => 0.0,
    output       => undef,
    rescue_of    => undef,
    spawned_at   => <[base.ntime]>,
};

<[base.logs]>->(
    1,              "reasoning.branch.register: %s [%s] state=%s deps=%d",
    $id,            $registry->{$id}->{'agent'},
    $initial_state, scalar @$deps
);

return { 'mode' => qw| true |, 'data' => $id };

