## [:< ##

# name  = osf-cache.cmd.lookup
# descr = ask the other osf-cache sessions who holds anchors
# param = <algo>:<hex> [ <algo>:<hex> .. ]
#
# the 'who holds H' fan-out [ acquisition flow step 2 ]. tokens are
# validated with the exact checks cmd.has runs [ query_local ] ;
# anchors the LOCAL index does not know are never asked [ their size
# cannot be verified against anything ] : when NONE is known [ a
# single unknown anchor included ] the lookup is refused mode false,
# otherwise the known ones are looked up and the reply lists the
# unknown ones on an 'unknown :' line. the peers resolve
# through osf-cache.peers.list, each gets '<sid>.has <tokens>' with
# osf-cache.handler.has_reply as reply handler, and when the last
# answer landed - or the <osf-cache.cfg.lookup_timeout> [ //= 5 s ]
# timer fires - osf-cache.lookup.complete merges the replies against
# the index sizes [ merge_replies ] and answers through
# base.callback.cmd_reply : this command returns mode deferred.
# per-lookup state lives in <osf-cache.lookup.pending> keyed by a
# lookup id and is always cleaned up [ the completion cancels the
# timeout timer and deletes the state ; cmd_reply resolves the
# <base.cmd_reply> entry itself ]. unanswered peers count as failed
# [ undef reply into merge_replies ]. an optional on_done module name
# marks an INTERNAL caller : the completion then dispatches the
# merged result to that module instead of answering a text reply
# [ osf-cache.cmd.fetch uses this ; external lookups are unchanged ].

require Time::HiRes;    ## core - loaded here, modules carry no use ##

my $args     = $call->{'args'}     // '';
my $reply_id = $call->{'reply_id'} // '';

my @tokens = grep {length} split m{\s+}, $args;

return {
    'mode' => qw| false |,
    'data' => 'usage : lookup <algo>:<hex> [ <algo>:<hex> .. ]'
    }
    unless @tokens;

return { 'mode' => qw| false |, 'data' => 'lookup needs a reply route' }
    unless length $reply_id;

## the exact token checks cmd.has runs [ empty holdings : validation only, ##
## the held map is not used here ]                                         ##
my $check = <[osf-cache.lookup.query_local]>->(
    {   'hashes'   => \@tokens,
        'holdings' => { 'files' => [] },
    }
);

return { 'mode' => qw| false |, 'data' => $check->{'data'} }
    if $check->{'mode'} ne qw| true |;

my %seen;
my @anchors = grep { !$seen{$ARG}++ } map { lc $ARG } @tokens;

## anchors unknown to the local index are never asked [ cannot verify a ##
## size we do not know ] ; the known ones are still looked up           ##
my $index = <osf-cache.index> // {};
my ( %expect, @known, @unknown );
foreach my $anchor (@anchors) {
    my $entry = $index->{'anchors'}{$anchor};
    if ( ref $entry eq qw| HASH | and defined $entry->{'size'} ) {
        $expect{$anchor} = $entry->{'size'};
        push @known, $anchor;
    } else {
        push @unknown, $anchor;
    }
}

## nothing left to ask : one unknown anchor answers as before ##
return {
    'mode' => qw| false |,
    'data' => sprintf '%s : %s [ not in the local index ]',
    @unknown == 1 ? 'unknown anchor' : 'unknown anchors',
    join ' ', @unknown
    }
    unless @known;

@anchors = @known;

### an optional internal caller : lookup.complete dispatches the merged ##
## result to this module instead of answering a text reply [ explicit, like ##
## osf-cache.handler.peers_list - the static dependency graph stays intact  ##
## ]. used by osf-cache.cmd.fetch.                                          ##
my $on_done = $call->{'on_done'} // '';

## per-lookup state keyed by a lookup id ##
<osf-cache.lookup.pending> //= {};
my $lookup_id = <[base.gen_id]>->(<osf-cache.lookup.pending>);

my $timeout = <osf-cache.cfg.lookup_timeout> // 5;
$timeout = 5 if !$timeout or $timeout < 1;    ## explicit floor ##

my $timer = <[event.add_timer]>->(
    {   'after'   => $timeout,
        'repeat'  => FALSE,
        'handler' => qw| osf-cache.lookup.timeout |,
        'data'    => { 'lookup_id' => $lookup_id },
    }
);

<osf-cache.lookup.pending>->{$lookup_id} = {
    'reply_id'       => $reply_id,
    'anchors'        => \@anchors,
    'unknown'        => \@unknown,
    'expect'         => \%expect,
    'started'        => Time::HiRes::time(),
    'peers_resolved' => 0,
    'replies'        => {},
    'pending'        => {},
    'timer'          => $timer,
    'on_done'        => $on_done,
};

## resolve the peers, then fan out [ with_peers continues from there ] ##
<[osf-cache.peers.list]>->(
    {   'callback' => qw| osf-cache.lookup.with_peers |,
        'params'   => { 'lookup_id' => $lookup_id },
    }
);

return { 'mode' => qw| deferred | };

