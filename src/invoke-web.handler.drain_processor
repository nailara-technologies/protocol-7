# name  = invoke-web.handler.drain_processor
# descr = async reply for drain_check [ paused_counts_idle only ] : drain
#         only when the queue processor is really paused

my $reply  = shift              // {};
my $params = $reply->{'params'} // {};

return if not $reply->{'ok'} or ref $reply->{'data'} ne qw| HASH |;
## about to render ##
return if $reply->{'data'}->{'processor'}->{'is_started'};
return if ( <invoke-web.status> // '' ) ne 'running';

<[invoke-web.drain.stop]>->( $params->{'idle'}, $params->{'pending'} );

