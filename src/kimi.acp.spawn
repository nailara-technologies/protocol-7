## [:< ##

# name   = kimi.acp.spawn
# descr  = start the `kimi acp` child, begin the handshake
# param  = resume session id | undef
# return = { success, error }

## a stream_child : stdout lines go to kimi.handler.acp_stdout, stderr    ##
## lines to kimi.handler.acp_stderr, stdin through kimi.acp.write.  never ##
## called from init_code [ that runs before the privilege drop ]          ##

my $resume = shift;
my $st     = <[kimi.acp.state]>;

return { 'success' => FALSE, 'error' => "session is $st->{'phase'}" }
    if $st->{'phase'} ne qw| stopped |;

## an imported session : refused when another host took its lease ##
if ( defined $resume ) {
    my $held = <[kimi.acp.hold]>->(
        qw| renew |, $resume, <[kimi.acp.session_transcript]>->($resume)
    );
    return { 'success' => FALSE, 'error' => "session $resume : $held" }
        if defined $held;
}

<[base.perlmod.load]>->($ARG) for qw| JSON::XS |;

my $command = <kimi.acp.cfg.command> // 'kimi acp';
my @cmd     = CORE::split( q{ }, $command );
return { 'success' => FALSE, 'error' => 'no acp command configured' }
    if not @cmd;

## end of input first, then TERM, then KILL, then given up ##
my $r = <[stream_child.start]>->(
    {   'cmd' => \@cmd,
        'env' => <[stream_child.user_env]>->(qw| .kimi-code/bin .local/bin |),
        'on_line'   => qw| kimi.handler.acp_stdout |,
        'on_stderr' => qw| kimi.handler.acp_stderr |,
        'on_gone'   => qw| kimi.acp.child_gone |,
        'on_note'   => qw| kimi.acp.child_note |,
        'stop'      => 'close | TERM | KILL | gone',
        'interval'  =>
            { 'stop' => qw| kimi-acp-stop |, 'exit' => qw| kimi-acp-exit | },
    }
);

if ( not $r->{'ok'} ) {
    my $why = $r->{'error'};
    <[kimi.acp.event]>->( qw| error |, "cannot start the child : $why" );
    return { 'success' => FALSE, 'error' => "cannot start : $why" };
}
my $pid = $r->{'handle'}{'pid'};

%{$st} = (
    %{$st},
    'phase'      => qw| starting |,
    'pid'        => $pid,
    'child'      => $r->{'handle'},
    'next_id'    => 0,
    'pending'    => {},
    'session_id' => undef,
    'caps'       => {},
    'turn'       => undef,
    'chunk'      => undef,
    'replay'     => FALSE,
    'stopping'   => FALSE,
    'started'    => time,
);

## idle shutdown would take the child with it : paused while it lives ##
<[base.zenki.pause_ondemand_timeout]>;
<[base.zenki.report_child_pid]>->($pid);

<[kimi.acp.event]>->(
    qw| start |,
    sprintf( 'child %d : %s%s',
        $pid, $command, defined $resume ? " [ resume $resume ]" : '' )
);

<[kimi.acp.rpc]>->(
    qw| initialize |,
    {   'protocolVersion'    => 1,
        'clientCapabilities' => {
            'fs' => {
                'readTextFile'  => JSON::XS::false(),
                'writeTextFile' => JSON::XS::false()
            },
            'terminal' => JSON::XS::false()
        }
    },
    qw| initialize |,
    { 'resume' => $resume }
);

return { 'success' => TRUE };

