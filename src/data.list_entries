## [:< ##

# name  = data.list_entries
# param = <path>
# descr = list directory entries at hash path
# return = array ref of entry names

my $path_str = shift // return [];
my $ref      = <[data.resolve_hash_path]>->($path_str);

return [] unless defined $ref;

## HASH: return keys
if ( ref($ref) eq 'HASH' ) {
    return [ sort keys %{$ref} ];
}

## ARRAY: return name fields
if ( ref($ref) eq 'ARRAY' ) {
    return [ map { $_->{'name'} // 'unnamed' } @{$ref} ];
}

## CODE: execute and list result
if ( ref($ref) eq 'CODE' ) {
    my $result = eval { $ref->('list') };
    return []                               if $@;
    return <[data.list_entries]>->($result) if ref($result);
    return [];
}

## SCALAR or other: empty listing
return [];

