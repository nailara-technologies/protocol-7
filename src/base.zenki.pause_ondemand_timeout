# name  = base.zenki.pause_ondemand_timeout
# descr = suspend on-demand idle-shutdown tracking for the duration of a
#         long-running background job [ e.g. apt install ] -- pair with
#         base.zenki.resume_ondemand_timeout once the work completes ;
#         safe to call repeatedly [ no-op while already paused ]

## clearing the threshold itself [ not just the armed timer ] makes this  ##
## structurally immune to an unrelated nudge re-arming it mid-job -- same ##
## pattern as powershell.pointer-stream's own inline idle-shutdown pause  ##
if ( defined <system.ondemand_timeout> ) {
    <base.ondemand.saved_timeout> = <system.ondemand_timeout>;
    delete <system.ondemand_timeout>;
}

if ( defined <base.timer.ondemand_timeout>
    and <base.timer.ondemand_timeout>->is_active ) {
    <base.timer.ondemand_timeout>->cancel;
    delete <base.timer.ondemand_timeout>;
}

