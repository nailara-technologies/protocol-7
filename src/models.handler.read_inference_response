# name = models.handler.read_inference_response
# descr = non-blocking I/O handler - read curl response from llama-server

my $event        = shift->w;
my $read_fh      = $event->fd;
my $inference_id = $event->data;

my $job = <models.pending_inferences>->{$inference_id};

unless ( defined $job ) {
    $event->cancel if $event->is_active;
    return;
}

## Read available data from curl stdout (non-blocking)
my $bytes = <[base.s_read]>->(
    $read_fh,
    \$job->{'output'},
    8 * 1024    # Read up to 8KB at a time
) // 0;

if ( $bytes > 0 ) {
    <[base.logs]>->(
        1,             "[read_inference] id=%s bytes=%d",
        $inference_id, $bytes
    );
}

## If already processed, skip
if ( $job->{'completed'} ) {
    return;
}

