## [:< ##

# name  = window.place.handler.button_press
# descr = begin drag or commit on double-click

my ( $id, $widget, $event ) = @ARG;

return TRUE if not defined $id;

my $inst = $data{window}{place}{instances}{$id};
return TRUE if not defined $inst;

my $ex = $event->x;
my $ey = $event->y;

my $w = $inst->{'geom'}{'width'}  // 320;
my $h = $inst->{'geom'}{'height'} // 240;

## right-click anywhere : submit, same as the enter key. commit is deferred ##
## to button-release [ committing here would Gtk3->main_quit and exit       ##
## before the release event arrives, so the underlying desktop would see an ##
## unmatched release and pop its context menu ].  switch to a thin cross    ##
## cursor right away so the press itself signals the pending submit.        ##
if ( $event->button == 3 ) {
    my $gdk_window = $widget->get_window;
    $gdk_window->set_cursor( Gtk3::Gdk::Cursor->new('tcross') )
        if defined $gdk_window;
    return TRUE;
}

my $region = <[window.place.classify_region]>->( $id, $ex, $ey );

## track that a left-button interaction (drag/resize) happened so that  ##
## button_release knows whether to re-sync geometry. a pure right-click ##
## commit should leave the original geometry untouched.                 ##
$inst->{'placement_interacted'} = 1;

## double-click on body : re-center the window on the cursor [ also       ##
## compensates for the missed first drag under wslg/xwayland, letting the ##
## user land the window without relying on drag at all ]                  ##
if ( $region eq 'body' ) {
    my $now = <[base.time]>->(5);
    if ( defined $inst->{'last_click'}
        and ( $now - $inst->{'last_click'} ) < 0.3 ) {
        <[base.log]>->( 1, '[place.button_press] double-click re-center' );
        my $new_geom = {
            'x'      => int( $event->x_root - $w / 2 ),
            'y'      => int( $event->y_root - $h / 2 ),
            'width'  => $w,
            'height' => $h
        };
        <[window.place.damp.set_target]>->( $id, $new_geom );
        <[window.place.update_x11_state]>->( $id, $new_geom );
        delete $inst->{'last_click'};
        return TRUE;
    }
    $inst->{'last_click'} = $now;
}

## [ testing ] hand both move and resize to the compositor via the          ##
## Wayland-sanctioned interactive grabs instead of our own move()/resize()  ##
## calls -- repositioning [ and, for west/north edges, resizing, which also ##
## shifts the origin ] an already-mapped toplevel via plain calls has       ##
## proven unreliable under this WSLg/Weston build, while a genuine          ##
## compositor-driven grab is the same mechanism protocol-7-menu uses for    ##
## move. begin_resize_drag takes the edge being dragged and lets the        ##
## compositor apply the correct position+size combination itself.           ##
if ( $region eq 'body' ) {
    ## anchor the pre-drag position so button_release can compute final     ##
    ## placement from the pointer delta -- get_position returns the         ##
    ## reparenting frame's root coords (GDK-tracked), which differ from the ##
    ## X11 client position that TranslateCoordinates / move-window use.     ##
    ## inst->geom is already in the TranslateCoordinates system (set by     ##
    ## update_x11_state from X-11.get_geometry), so use that.               ##
    $inst->{'drag_move_start'} = {
        'ptr_x'  => $event->x_root,
        'ptr_y'  => $event->y_root,
        'geom_x' => $inst->{'geom'}{'x'} // 0,
        'geom_y' => $inst->{'geom'}{'y'} // 0,
    };
    $widget->begin_move_drag( $event->button, $event->x_root, $event->y_root,
        $event->time );
    return TRUE;
}

my %region_to_edge = (
    'nw' => qw| north-west |,
    'n'  => qw| north |,
    'ne' => qw| north-east |,
    'w'  => qw| west |,
    'e'  => qw| east |,
    'sw' => qw| south-west |,
    's'  => qw| south |,
    'se' => qw| south-east |,
);

my $edge = $region_to_edge{$region};
if ( defined $edge ) {
    $widget->begin_resize_drag(
        $edge, $event->button, $event->x_root,
        $event->y_root, $event->time
    );
}

<[base.logs]>->( 2, '[place.button_press] id=%s region=%s', $id, $region );

return TRUE;

