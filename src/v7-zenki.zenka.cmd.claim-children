## [:< ##

# name  = v7-zenki.zenka.cmd.claim-children
# param = <child-name>
# descr = claim a kept crash child for the calling instance
# note  = cube injects source zenka name and sid via source_zenka_sid alias

## the new instance of a crashed zenka [ restart.keep_children opt-in ]    ##
## claims a kept child by name : the entry moves back into the instance's ##
## child registry and <v7-zenki.child>, the grace timer is cancelled.     ##
## identity [ pid + /proc start time + cmdline ] is re-checked before the ##
## claim -- a mismatch means pid reuse : forgotten, never signalled       ##

( my $zenka, my $zenka_sid, my $child_name )
    = split( m| |, $call->{'args'} // '', 3 );

$zenka //= '';
$zenka =~ s|^.*\.||;    # <-- node portion
$child_name //= '';

my $err_reason;
$err_reason = 'expected zenka sid from cube [ misconfigured ]'
    if not defined $zenka_sid or $zenka_sid !~ m|^\d+$|;
$err_reason = 'expected child name parameter'
    if not defined $err_reason and !length $child_name;

my $zenka_instance;
if ( not defined $err_reason ) {
    foreach my $instance_id (<[v7-zenki.instance_ids]>) {
        my $instance = <v7-zenki.zenka.instance>->{$instance_id};
        $zenka_instance = $instance_id and last
            if defined $instance->{'cube_sid'}
            and $instance->{'cube_sid'} == $zenka_sid;
    }
    $err_reason = 'no instance matches cube-sid' if not defined $zenka_instance;
}

my $instance;
my $kept_href = {};
my $pid;
if ( not defined $err_reason ) {
    $instance  = <v7-zenki.zenka.instance>->{$zenka_instance};
    $kept_href = <v7-zenki.kept_children>->{$zenka} // {};
    $err_reason = sprintf(
        "zenka name mismatch [ instance is '%s' ]",
        $instance->{'zenka_name'} // qw| ? |
    ) if ( $instance->{'zenka_name'} // '' ) ne $zenka;
    ($pid)
        = grep { $kept_href->{$ARG}->{'name'} eq $child_name }
        sort { $a <=> $b } keys $kept_href->%*
        if not defined $err_reason;
    $err_reason = sprintf( "no kept child '%s' for zenka '%s'",
        $child_name, $zenka )
        if not defined $err_reason and not defined $pid;
}

my $entry;
if ( not defined $err_reason ) {
    $entry = $kept_href->{$pid};
    if ( ! <[v7-zenki.sub-process.identity_match]>->(
            $pid, $entry->{'proc_start_time'}, $entry->{'proc_cmdline'} )
    ) {
        ## pid reuse : forget the entry, never signal that pid ##
        $entry->{'timer'}->cancel
            if defined $entry->{'timer'} and ref $entry->{'timer'};
        delete $kept_href->{$pid};
        $err_reason
            = sprintf 'kept child %d identity mismatch [ pid reuse ]', $pid;
    }
}

if ( defined $err_reason ) {
    <[base.logs]>->(
        1, "< %s > [sid:%d] claim-children : %s",
        $zenka, $zenka_sid // 0, $err_reason
    );
    if ( defined <v7-zenki.kept_children> ) {
        delete <v7-zenki.kept_children>->{$zenka}
            if not keys <v7-zenki.kept_children>->{$zenka}->%*;
        delete <v7-zenki.kept_children>
            if not keys <v7-zenki.kept_children>->%*;
    }
    return { 'mode' => qw| false |, 'data' => $err_reason };
}

## move the entry back to the claiming instance ##
delete $kept_href->{$pid};
$entry->{'timer'}->cancel
    if defined $entry->{'timer'} and ref $entry->{'timer'};

my $parent_pid = $instance->{'process'}->{'id'};
my $parent_entry
    = defined $parent_pid ? <v7-zenki.child>->{$parent_pid} : undef;
<v7-zenki.child>->{$pid} = {
    ( defined $parent_entry ? $parent_entry->%* : () ),
    'instance_id'     => $zenka_instance,
    'zenka_child'     => 1,
    'child_name'      => $entry->{'name'},
    'proc_start_time' => $entry->{'proc_start_time'},
    'proc_cmdline'    => $entry->{'proc_cmdline'},
};
$instance->{'process'}->{'child'}->{$pid} = 1;

delete <v7-zenki.kept_children>->{$zenka} if not keys $kept_href->%*;
delete <v7-zenki.kept_children> if not keys <v7-zenki.kept_children>->%*;

<[base.logs]>->(
    1, "[instance:%d] claimed kept child '%s' [pid %d]",
    $zenka_instance, $child_name, $pid
);

return { 'mode' => qw| true |, 'data' => "$pid" };

