## [:< ##

# name = coding.intake.parse_command_string
# descr = parses CLI-style "type: description | constraints" strings
# purpose = Extract structured task data from command strings

my ($cmd) = @ARG;

## strip leading :template-name: prefix and promote to type  example:       ##
## ":bug-fix: investigate kimi approval reconnect"  EXCLUDES :model: -      ##
## that's a distinct marker [ ":model:CHECKSUM:CHECKSUM:" ] owned by        ##
## coding.prompt.assemble, which runs later. without this exclusion, this   ##
## generic stripper consumed just the word "model" as if it were a template ##
## name, leaving the checksum behind mangled and never recognized by        ##
## assemble's own regex - confirmed live 2026-06-21, this is why task-level ##
## model pinning never actually worked end to end.  :mode: likewise         ##
## [ ':mode:<path>:', todo WNF ]                                            ##
if ( $cmd =~ s{^:(?!model:|mode:)([\w-]+):\s*}{} ) {
    my $forced_type = $1;
    return {
        type        => $forced_type,
        description => $cmd,
        constraints => [],
        source      => qw| console |
    };
}

## Simple command parsing: "type: description | constraints"
#
# Example: "code-generation: Create Whisper module | Protocol-7 compatible,
# cache results"

if ( $cmd =~ m{^([\w-]+):\s*(.+?)(?:\s*\|\s*(.+))?$} ) {
    my ( $type, $desc, $constraints_str ) = ( $1, $2, $3 );

    my @constraints = ();
    if ($constraints_str) {
        @constraints = split( m{\s*,\s*}, $constraints_str );
    }

    return {
        type        => $type,
        description => $desc,
        constraints => \@constraints,
        source      => qw| console |
    };
}

# Fallback: treat entire string as description
return {
    type        => qw| analysis |,
    source      => qw|  console |,
    description => $cmd
};

