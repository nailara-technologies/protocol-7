## [:< ##

# name  = claude.cmd.session-register
# param = name=<n> socket=<path> [ sid= ] [ token:body ]
# descr = record a live session's inbox socket

## the token comes in the body of a multi-line call [ token = <value> ], ##
## never in the args : args reach command logs. kept in memory only      ##
## [ claude.live.sessions ] ; the same name registered again replaces it ##

my %pair;
foreach my $text ( $call->{'args'} // '', $call->{'data'} // '' ) {
    while ( $text =~ m{(?:\A|\s)(name|socket|sid)\s*[=:]\s*(\S+)}g ) {
        $pair{$1} = $2;
    }
}
## the token from the body only : one in the args is refused ##
( $pair{'token'} )
    = ( $call->{'data'} // '' ) =~ m{^\s*token\s*[=:]\s*(\S+)}m;
return { 'mode' => qw| false |, 'data' => 'token in the args refused' }
    if ( $call->{'args'} // '' ) =~ m{(?:\A|\s)token\s*[=:]};
if ( ref $call->{'param'} eq qw| HASH | ) {
    $pair{$ARG} //= $call->{'param'}{$ARG} foreach qw| name socket sid |;
}
my ( $name, $socket, $token ) = @pair{qw| name socket token |};
return { 'mode' => qw| false |, 'data' => 'name=<name> expected' }
    if not defined $name or $name !~ m|\A[\w.\-]{1,64}\z|;
return { 'mode' => qw| false |, 'data' => 'socket=<absolute path> expected' }
    if not defined $socket or $socket !~ m{\A/\S+\z};
my $sid = defined $pair{'sid'} ? lc $pair{'sid'} : undef;
return { 'mode' => qw| false |, 'data' => 'sid : a uuid' }
    if defined $sid
    and $sid !~ m|\A[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}\z|;
return { 'mode' => qw| false |, 'data' => 'token expected in the body' }
    if not defined $token
    or not CORE::length $token;
return { 'mode' => qw| false |, 'data' => "no socket at $socket" }
    if not -S $socket;

my $sessions = <[claude.live.sessions]>;
## a periodic re-register of the same socket is not news ##
my $is_new = (
    not CORE::exists $sessions->{$name}
        or $sessions->{$name}{'socket'} ne $socket
);
my $names = <[claude.live.sessions]>->(qw| names |);
if ( defined $sid ) {
    ## the same session under its former name [ crash, resume ] ##
    foreach my $old ( CORE::keys %{$sessions} ) {
        next
            if $old eq $name
            or ( $sessions->{$old}{'sid'} // '' ) ne $sid;
        CORE::delete $sessions->{$old};
        <[base.log]>->( 1, ": live session $old is now $name" );
    }
    $names->{$name} = $sid;
} else {
    CORE::delete $names->{$name};
}
$sessions->{$name} = {
    defined $sid ? ( 'sid' => $sid ) : (),
    'socket' => $socket,
    'token'  => $token,
    'since'  => CORE::time,
};
<[base.log]>->(
    $is_new ? 1 : 2,
    ": live session $name registered [ $socket ]"
);
## what waits for a live session wakes [ the name only, never the token ] ##
<[claude.signal.raise]>->(
    qw| claude.session.registered |,
    { 'name' => $name }
) if $is_new;
## its context size is looked at while it is registered ##
<[claude.context.arm]>;
return { 'mode' => qw| true |, 'data' => "live session $name registered" };

