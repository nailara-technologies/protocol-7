## [:< ##

# name  = coding.thermal.boost_active
# descr = return the active temperature boost and clear an expired one
# param = [ now ]

my $now   = @ARG ? shift : <[base.time]>->(2);
my $boost = <coding.thermal.boost>;

return undef  if ref $boost ne qw| HASH |;
return $boost if ( $boost->{'until'} // 0 ) > $now;

delete <coding.thermal.boost>;
<[base.logs]>->( 1, 'thermal boost : ended' );
return undef;

