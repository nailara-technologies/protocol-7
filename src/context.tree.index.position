## [:< ##

# name  = context.tree.index.position
# descr = index intermediate checksum position in context tree

## [ stub ] record stream position for later retrieval ##

my ($args) = @ARG;

my $stream_id = $args->{'stream_id'};
my $position  = $args->{'position'};
my $checksum  = $args->{'checksum'};
my $bytes_in  = $args->{'bytes_in'};

## TODO: store position index in context tree ##

my $tree = <context.tree.index> //= {};
$tree->{'positions'}{$stream_id}{$position} = {
    'checksum' => $checksum,
    'bytes_in' => $bytes_in,
};

return 1;

