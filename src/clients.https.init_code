# name  = clients.https.init_code
# descr = load dependencies for async https client

<[base.perlmod.autoload]>->('IO::Socket::IP');
<[base.perlmod.autoload]>->('IO::Socket::SSL');
<[base.perlmod.autoload]>->('JSON::XS');
<[base.perlmod.autoload]>->('Protocol::HTTP2::Client');
<[base.perlmod.autoload]>->('IO::Uncompress::AnyUncompress');

return 0;

