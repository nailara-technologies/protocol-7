# name  = invoke-web.handler.recover_resume_reply
# descr = last step of a recovery [ cuda error \ zenka crash ] : queue resumed

my $reply = shift // {};
<[base.logs]>->(
    $reply->{'ok'} ? 1 : 0,
    '%s : recovery done, queue %s',
    $reply->{'params'}->{'kind'} // qw| recover |,
    $reply->{'ok'} ? 'resumed' : "not resumed [ $reply->{'status'} ]"
);

