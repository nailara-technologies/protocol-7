## [:< ##

# name  = base.stdio_multiplex.emit_str
# param = $name, $value
# descr = emit a named STR typed run [ stdout.value.<name> slot ]

my ( $name, $value ) = @ARG;

my $conn_handle = <base.stdio_multiplex.conn> // undef;
return if not defined $conn_handle;
return if not defined <stdio_transport.connections>->{$conn_handle};

return if not defined $name or not length $name;

return <[base.stdio.transport.emit]>->(
    $conn_handle, qw| STR |, qw| nibble |,
    $value // '',
    { name => $name }
);

