## [:< ##

# name  = form.menu.open_record
# descr = open a chosen host-system record in the edit form
# param = $username

## the third level : a record picked from the menu opens the ORDINARY edit
## form.  it reuses form.handler.value_get_reply untouched, so the whole
## schema / frame / render / raw-mode path is exactly the one a direct
## 'show-form <user>' takes -- the menu only decided which record.
##
## create.attempted is set so a record that vanished between the listing and
## this fetch cannot trigger the create-admin offer from inside a menu.

my ($username) = @ARG;

return FALSE if not defined $username or not length $username;

my $cube_sid = <form.cube_sid>;

if ( not defined $cube_sid or not exists $data{'session'}{$cube_sid} ) {
    <[form.message]>->( 'link to cube is gone', qw| fail | );
    return FALSE;
}

## remember the menu we came from : the form that opens here is a FRESH state
## with no menu_source, so without this Esc would leave the zenka instead of
## stepping back up to the record list
<form.menu.form_return> = <form.state>;

<form.username> = $username;
my $source = <form.source> // {};
<form.title>
    = sprintf( $source->{'title_fmt'} // q{user-edit : %s}, $username );

## a record listed a moment ago is not a missing record : do not offer to
## create one from inside a menu
<form.create.attempted> = TRUE;

my $sender = $source->{'value_get'} // return FALSE;

<[$sender]>->( $username, qw| form.handler.value_get_reply | );

return TRUE;

