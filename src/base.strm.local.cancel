## [:< ##

# name  = base.strm.local.cancel
# descr = remove a local STRM consumer registration
# param = $cmd_id

my $cmd_id = shift // return;
if ( exists <base.strm.local>->{$cmd_id} ) {
    delete <base.strm.local>->{$cmd_id};
    <[base.logs]>
        ->( 2, '[strm.local] cancelled consumer cmd_id %d', $cmd_id );
}

