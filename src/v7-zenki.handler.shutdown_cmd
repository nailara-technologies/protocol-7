## [:< ##

# name = v7-zenki.handler.shutdown_cmd

## timer data : { reason, exit } [ exit 76 = :no-restart: ] -- a plain ##
## string from an older caller is the reason with exit 0               ##
my $data = shift->w->data;
my ( $reason, $exit_code )
    = ref $data eq qw| HASH |
    ? ( $data->{'reason'}, $data->{'exit'} // 0 )
    : ( $data, 0 );

<[v7-zenki.teardown]>->( $reason, undef, $exit_code );

