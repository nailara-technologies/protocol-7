## [:< ##

# name  = coding.cmd.submit
# descr = submit work request to coding zenka
# param = <request_string>
# example = work submit "code-generation: Create whisper module"

return { 'mode' => qw| false |, 'data' => 'coding zenka is draining' }
    if <coding.draining>;

# Resolve input through the shared decoder [ explicit prefixes only ]
my $request_str = '';

my $param_request = '';
if ( defined $call->{'param'} and ref $call->{'param'} eq qw| HASH | ) {
    $param_request = $call->{'param'}->{'request'}
        // $call->{'param'}->{'question'}
        // $call->{'param'}->{'description'} // '';
}

if ( length $param_request ) {

    ## param mode [ legacy multiline callers ] : the request key wins and the
    ## data body is appended as context -- the branch below is what p7c \
    ## p-7-r produce for a multi-line argument [ body = the args ]
    $param_request =~ s|\\n|\n|g;    ## literal \n unescape [ legacy ] ##
    my $decoded = <[coding.input.decode]>->(
        {   'input'  => $param_request,
            'caller' => qw| coding.cmd.submit |
        }
    );
    return { 'mode' => qw| false |, 'data' => $decoded->{'error'} }
        unless $decoded->{'success'};
    $request_str = $decoded->{'content'};

    if ( defined $call->{'data'} and length $call->{'data'} ) {
        $request_str .= "\nContext:\n" . $call->{'data'};
    }
} else {

    ## single-line args OR multi-line mode body [ $call->{'data'} ] ##
    my $raw
        = ( defined $call->{'data'} and length $call->{'data'} )
        ? $call->{'data'}
        : $call->{'args'} // '';

    my $decoded = <[coding.input.decode]>->(
        {   'input'  => $raw,
            'caller' => qw| coding.cmd.submit |
        }
    );
    return { 'mode' => qw| false |, 'data' => $decoded->{'error'} }
        unless $decoded->{'success'};
    $request_str = $decoded->{'content'};
}

return { 'mode' => qw| false |, 'data' => "work request required\n" }
    if !length($request_str);

## Validate request isn't empty after decoding
return {
    'mode' => qw| false |,
    'data' => "work request required after decoding\n"
    }
    if !length($request_str);

# Parse the work request using task intake module
my $intake_result = <[coding.task.intake]>->($request_str);

if ( !$intake_result->{success} ) {
    return {
        'mode' => qw| false |,
        'data' => "Failed to parse request: "
            . ( $intake_result->{error} // 'unknown error' ) . "\n"
    };
}

my $task = $intake_result->{task};

# Analyze the task
my $analysis = <[coding.task.analyze]>->( 'full', $task );

if ( !$analysis->{success} ) {
    return {
        'mode' => qw| false |,
        'data' => "Failed to analyze task: "
            . ( $analysis->{error} // 'unknown error' ) . "\n"
    };
}

my $analyzed_task = $analysis->{task};

# Make routing decision
my $routing = <[coding.routing.decide_service]>->( 'route', $analyzed_task );

if ( !$routing->{success} ) {
    return {
        'mode' => qw| false |,
        'data' => "Failed to determine routing: "
            . ( $routing->{error} // 'unknown error' ) . "\n"
    };
}

my $routed_task = $routing->{task};

# Enqueue the task (uses jobqueue backend for auto-execution)
my $queue_result = <[coding.task.enqueue]>->($routed_task);

if ( !$queue_result->{success} ) {
    return {
        'mode' => qw| false |,
        'data' => "Failed to enqueue task: "
            . ( $queue_result->{error} // 'unknown error' ) . "\n"
    };
}

my $response
    = "task:"
    . ( $routed_task->{id} // 'unknown' )
    . "|type:"
    . ( $routed_task->{type} // 'unknown' )
    . "|complexity:"
    . ( $routed_task->{analysis}->{complexity} // 'unknown' )
    . "|routed:"
    . ( $routed_task->{analysis}->{routed_to} // 'unknown' )
    . "|tokens:"
    . ( $routed_task->{execution}->{estimated_tokens}
        // $routed_task->{analysis}->{estimated_tokens} // 'unknown' ) . "\n";

return {
    'mode' => qw| size |,
    'data' => $response
};

