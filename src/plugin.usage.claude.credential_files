# name   = plugin.usage.claude.credential_files
# descr  = where the claude oauth credential is
# return = list of paths [ one ], empty without a home

my $home_dir = <[usage.home_dir]>;
return () if not length $home_dir;

return catfile( $home_dir, <usage.provider.claude>->{'cred_rel'} );

