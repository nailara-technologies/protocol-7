## [:< ##

# name  = base.callback.setup_rollback_timer
# descr = install rollback window watcher when new code was loaded

return FALSE    ##  no rollback pending  ##
    if not <base.loader.rollback_pending>;

delete <base.loader.rollback_pending>;    ##  clear flag  ##

<base.loader.rollback_watcher> = <[event.add_timer]>->(
    {   'after'   => <base.loader.rollback-window> // 93,
        'handler' => qw| base.callback.expire_code_version |
    }
);

<[base.log]>->( 2, ':.installed rollback watcher..' );

return FALSE;

