## [:< ##

# name  = base.file.temp

my $tmpl       = shift // 'X' x 13;
my @check_dirs = shift;
my $unlink     = shift // TRUE;     ## unlink in end code callback ##
my $register   = shift // FALSE;    ## register for unlinking at v7 zenka ##

if ( $tmpl =~ m|/| ) {    # allow paths later
    warn 'filename template syntax not valid [ no paths ] <{C1}>';
    return undef;
}

my $first_dir;
my $zenka_name = <system.zenka.name>;
@check_dirs = (qw| /var/protocol-7 |)
    if !@check_dirs
    or @check_dirs == 1 and not defined $check_dirs[0];

foreach my $chk_dir (@check_dirs) {
    my $subdir_path = catfile( $chk_dir, $zenka_name );
    <[base.logs]>->( 2, ':. tmp-dir-chck :. %s', $subdir_path );
    if ( -d $subdir_path and -w $subdir_path
        or make_path( $subdir_path, { 'mode' => 0750 } ) ) {
        $first_dir = $subdir_path;
        last;
    }
}
if ( not defined $first_dir ) {
    <[base.s_warn]>->(
        'no success creating temp dir [ %s ]',
        <[base.str.os_err]>
    );
    return undef;
}

my $retries = 47;
my $tmp_file_path;
while ( not defined $tmp_file_path or -e $tmp_file_path and $retries-- ) {
    $retries = 0 if $tmpl !~ m|X|;    # <-- no rnd char range in template
    ( my $fname = $tmpl )
        =~ s|(X+)|uc(<[base.prng.chars-anum]>->( length ${^CAPTURE}[0] ))|ge;
    $tmp_file_path = catfile( $first_dir, $fname );
}

if ( -e $tmp_file_path ) {
    warn 'cannot find suitable temp file name [ exists ] <{C1}>';
    return undef;
}

<[base.logs]>->( 2, ' : tmp-file-path : %s', $tmp_file_path );

if ( not wantarray ) {    # <-- scalar context does not open the file
    return $tmp_file_path;
}

<[base.logs]>->( 2, ' :. opening file : %s .,', $tmp_file_path );

my $tmp_fh;
if ( not open( $tmp_fh, qw| > |, $tmp_file_path ) ) {
    <[base.s_warn]>->( '> %s : %s', $tmp_file_path, <[base.str.os_err]> );
    return undef;
}

if ($unlink) {
    ## register generic cleanup callback once, collect filenames in array
    #
    <base.path.temp_files.clean_list> //= [];
    push <base.path.temp_files.clean_list>->@*, $tmp_file_path;

    ## register generic cleanup callback name if not already registered : note
    ## : registered as 'file.cleanup-temp-files' because base.file.* gets
    ## swapped to file.* in init
    unless (
        scalar(
            grep { $_ eq 'file.cleanup-temp-files' } <callbacks.end_code>->@*
        )
    ) {
        <callbacks.end_code> //= [];
        push <callbacks.end_code>->@*, qw|file.cleanup-temp-files|;
    }
}
if ($register) {
    <system.init_reports> //= [];
    push(
        <system.init_reports>->@*,
        {   'param'          => $tmp_file_path,
            'descr'          => 'registering temp file path..,',
            'target_command' => qw| v7-zenki.report-temp-path |,
        }
    );
}

return ( $tmp_fh, $tmp_file_path );

