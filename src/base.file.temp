## [:< ##

# name  = base.file.temp

my $tmpl       = shift // 'X' x 13;
my @check_dirs = shift;
## a list of candidate directories may be given as one array reference ##
@check_dirs = $check_dirs[0]->@* if ref $check_dirs[0] eq qw| ARRAY |;
my $unlink   = shift // TRUE;     ## unlink in end code callback ##
my $register = shift // FALSE;    ## register for unlinking at v7 zenka ##

if ( $tmpl =~ m|/| ) {    # allow paths later
    warn 'filename template syntax not valid [ no paths ] <{C1}>';
    return undef;
}

my $first_dir;
my $zenka_name = <system.zenka.name>;
@check_dirs = (qw| /var/protocol-7 |)
    if !@check_dirs
    or @check_dirs == 1 and not defined $check_dirs[0];

## not imported into every zenka [ the pm-src build broke on it ] ##
<[base.perlmod.load]>->('File::Path')
    if not <[base.perlmod.loaded]>->('File::Path');

foreach my $chk_dir (@check_dirs) {
    my $subdir_path = catfile( $chk_dir, $zenka_name );
    <[base.logs]>->( 2, ':. tmp-dir-chck :. %s', $subdir_path );
    File::Path::make_path( $subdir_path, { 'mode' => 0750 } )
        if not -e $subdir_path and not -l $subdir_path;
    ## a shared parent [ /var/tmp ] lets anyone pre-create the subdir : use ##
    ## it only when it is a real directory, ours, not writable by others    ##
    ## CORE:: : a zenka may have File::stat loaded, which turns stat \      ##
    ## lstat into an object -- the list form is needed here                 ##
    my @st = CORE::lstat $subdir_path;
    ## the effective uid from the kernel : /proc/self belongs to it -- no ##
    ## special variable needed [ one was undefined in zenka scope ]       ##
    my @self = CORE::stat qw| /proc/self |;
    my $euid = $self[4] // $>;
    my $egid = $self[5] // ( split m| |, $) )[0];
    if ( not @st or not defined $st[4] or not defined $euid ) {
        <[base.logs]>->(
            0,
            ': tmp-dir owner check impossible '
                . ': %s [ lstat %s, euid %s, proc %s ]',
            $subdir_path,
            ( @st ? 'ok' : "failed : $OS_ERROR" ),
            $euid // 'undef',
            ( @self ? 'ok' : 'unavailable' )
        );
        next;
    }
    next
        if -l $subdir_path
        or not -d $subdir_path
        or $st[4] != $euid
        or ( $st[2] & 002 )    ## world-writable : never ##
        or ( $st[2] & 020 and $st[5] != ( $egid // -1 ) );
    $first_dir = $subdir_path;
    last;
}
if ( not defined $first_dir ) {
    <[base.s_warn]>->(
        'no success creating temp dir [ %s ]',
        <[base.str.os_err]>
    );
    return undef;
}

my $retries = 47;
my $tmp_file_path;
while ( not defined $tmp_file_path or -e $tmp_file_path and $retries-- ) {
    $retries = 0 if $tmpl !~ m|X|;    # <-- no rnd char range in template
    ( my $fname = $tmpl )
        =~ s|(X+)|uc(<[base.prng.chars-anum]>->( length ${^CAPTURE}[0] ))|ge;
    $tmp_file_path = catfile( $first_dir, $fname );
}

if ( -e $tmp_file_path ) {
    warn 'cannot find suitable temp file name [ exists ] <{C1}>';
    return undef;
}

<[base.logs]>->( 2, ' : tmp-file-path : %s', $tmp_file_path );

if ( not wantarray ) {    # <-- scalar context does not open the file
    return $tmp_file_path;
}

<[base.logs]>->( 2, ' :. opening file : %s .,', $tmp_file_path );

my $tmp_fh;
## exclusive create, never through a link, private mode ##
<[base.perlmod.load]>->('Fcntl') if not <[base.perlmod.loaded]>->('Fcntl');
if (not sysopen(
        $tmp_fh,
        $tmp_file_path,
        Fcntl::O_WRONLY() | Fcntl::O_CREAT() | Fcntl::O_EXCL()
            | Fcntl::O_NOFOLLOW(),
        0600
    )
) {
    <[base.s_warn]>->( '> %s : %s', $tmp_file_path, <[base.str.os_err]> );
    return undef;
}
## same layer a plain open would get [ bin/Protocol-7 'use open' ] ##
binmode( $tmp_fh, ':encoding(UTF-8)' );

if ($unlink) {
    ## register generic cleanup callback once, collect filenames in array
    #
    <base.path.temp_files.clean_list> //= [];
    push <base.path.temp_files.clean_list>->@*, $tmp_file_path;

    ## register generic cleanup callback name if not already registered : note
    ## : registered as 'file.cleanup-temp-files' because base.file.* gets
    ## swapped to file.* in init
    unless (
        scalar(
            grep { $_ eq 'file.cleanup-temp-files' } <callbacks.end_code>->@*
        )
    ) {
        <callbacks.end_code> //= [];
        push <callbacks.end_code>->@*, qw|file.cleanup-temp-files|;
    }
}
if ($register) {
    <system.init_reports> //= [];
    push(
        <system.init_reports>->@*,
        {   'param'          => $tmp_file_path,
            'descr'          => 'registering temp file path..,',
            'target_command' => qw| v7-zenki.report-temp-path |,
        }
    );
}

return ( $tmp_fh, $tmp_file_path );

