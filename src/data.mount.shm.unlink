## [:< ##

# name = data.mount.shm.unlink
# descr = Remove SHM segment from system

my ( $pub_key_b32, $sub_path ) = @ARG;

return undef unless defined $pub_key_b32;

my $shm_path = sprintf( "/dev/shm/p7:M:%s", $pub_key_b32 );

if ( defined $sub_path && length($sub_path) ) {
    $shm_path .= ":" . $sub_path;
    $shm_path =~ s{[^a-zA-Z0-9_:/\-]}{_}g;
}

my $unlinked = 0;

if ( -f $shm_path ) {
    $unlinked = unlink($shm_path);
}

## the phase-3 notify fifo shares the segment's lifecycle ##
my $notify_path = $shm_path . '.notify';
if ( -p $notify_path ) {
    unlink($notify_path);
}

return $unlinked;

