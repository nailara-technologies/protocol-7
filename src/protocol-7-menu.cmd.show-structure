## [:< ##

# name = protocol-7-menu.cmd.show-structure
# descr = display current menu structure as ASCII tree

return { 'mode' => qw| false |, 'data' => 'no menu structure initialized' }
    unless defined <protocol-7-menu.menu-structure>;

my $menu_structure = <protocol-7-menu.menu-structure>;
my $output;

## Header
$output = "╔════════════════════════════════════════════════════════════╗\n";
$output .= "║          PROTOCOL-7 MENU STRUCTURE (ASCII VIEW)            ║\n";
$output .= "╚════════════════════════════════════════════════════════════╝\n";
$output .= "\n";

## Metadata
$output .= "Metadata:\n";
$output .= "  Last Changed: "
    . ( $menu_structure->{'last-changed'} // 'unset' ) . "\n";
$output .= "  Total Providers: "
    . scalar( keys %{ $menu_structure->{'providers'} } ) . "\n";
$output .= "\n";

## Provider tree
if ( scalar( keys %{ $menu_structure->{'providers'} } ) == 0 ) {
    $output .= "Providers: [none]\n";
} else {
    $output .= "Providers:\n";

    my @providers = sort keys %{ $menu_structure->{'providers'} };
    foreach my $idx ( 0 .. $#providers ) {
        my $provider     = $providers[$idx];
        my $is_last      = ( $idx == $#providers );
        my $prefix       = $is_last ? '└── ' : '├── ';
        my $child_prefix = $is_last ? '    ' : '│   ';

        my $provider_data = $menu_structure->{'providers'}{$provider};
        my $item_count
            = defined $provider_data->{'items'}
            ? scalar( keys %{ $provider_data->{'items'} } )
            : 0;

        $output .= $prefix . "[$provider] (" . $item_count . " items)\n";

        ## Items under provider
        if ( defined $provider_data->{'items'}
            && scalar( keys %{ $provider_data->{'items'} } ) > 0 ) {
            my @items = sort keys %{ $provider_data->{'items'} };
            foreach my $item_idx ( 0 .. $#items ) {
                my $item         = $items[$item_idx];
                my $item_is_last = ( $item_idx == $#items );
                my $item_prefix  = $item_is_last ? '└── ' : '├── ';
                my $full_prefix  = $child_prefix . $item_prefix;

                my $item_data = $provider_data->{'items'}{$item};
                my $item_info = '';

                ## Display item info if it's a hash
                if ( ref $item_data eq qw| HASH | ) {
                    my $label       = $item_data->{'label'}   // $item;
                    my $enabled     = $item_data->{'enabled'} // 1;
                    my $status_mark = $enabled ? '✓' : '✗';
                    $item_info = " [$status_mark] $label";
                } else {
                    $item_info = " → "
                        . ( ref $item_data ? ref($item_data) : $item_data );
                }

                $output .= $full_prefix . $item . $item_info . "\n";
            }
        }
    }
}

$output .= "\n";
$output .= "╚════════════════════════════════════════════════════════════╝\n";

return {
    'mode' => qw| size |,
    'data' => $output
};

