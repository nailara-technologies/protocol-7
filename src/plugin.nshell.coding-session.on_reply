## [:< ##

# name  = plugin.nshell.coding-session.on_reply
# descr = catch a coding.submit reply's task id and bind it to this tab,
#         then auto-subscribe to its live stream
# param = { mode => $mode_href, text => $reply_text }

my $args = shift // {};
my $mode = $args->{'mode'};
my $text = $args->{'text'} // '';

return undef unless defined $mode;

## coding.task-append resumed a completed/failed task from saved history [  ##
## coding.cmd.task-append's own "resumed from $status" reply shape ] -- the ##
## listener registration from the ORIGINAL submit was already deleted when  ##
## that round reached a terminal state [ coding.async.state_machine         ##
## deregisters on STATE_COMPLETE/STATE_ERROR ], so without a fresh          ##
## subscribe-session here the resumed round streams successfully server-    ##
## side but nothing ever reaches this tab -- confirmed live 2026-09-14 :    ##
## "task X resumed from completed [...]" logged, inference completed [1106  ##
## chunks], nothing displayed. only fires on the RESUMED reply shape, not   ##
## the plain "message queued" shape used for an already-active task -- that ##
## task's listener is still alive, and subscribing again would register a   ##
## SECOND handle, doubling every future chunk.                              ##
if (    defined $mode->{'task_id'}
    and length $mode->{'task_id'}
    and $text =~ m{^task \Q$mode->{'task_id'}\E resumed from} ) {
    my ($cube_sid) = keys <user.cube.session>->%*;
    if ( defined $cube_sid and exists $data{'session'}{$cube_sid} ) {
        $data{'session'}{$cube_sid}{'buffer'}{'output'}
            .= "coding.subscribe-session $mode->{'task_id'}\n";
    }
    return TRUE;    ## suppress the raw resume ack, same as the initial one
}

return undef unless $mode->{'awaiting_task_id'};

## coding.submit's own reply shape : "task:task-XXXX|type:...|..." ##
return undef unless $text =~ m{^task:(\S+?)\|};

my $task_id = $1;
$mode->{'task_id'} = $task_id;
delete $mode->{'awaiting_task_id'};

## send the follow-up subscribe command as if typed -- same mechanism     ##
## nshell.no-tty-debug.cmd.char-add uses to submit a command : append to  ##
## the session's own output buffer, picked up by the normal dispatch loop ##
## on its next pass                                                       ##
my ($cube_sid) = keys <user.cube.session>->%*;
if ( defined $cube_sid and exists $data{'session'}{$cube_sid} ) {
    $data{'session'}{$cube_sid}{'buffer'}{'output'}
        .= "coding.subscribe-session $task_id\n";
}

## redraw the input line [ + status bar, which reads mode->{task_id} fresh  ##
## every render ] right now -- this is the exact moment that data changes,  ##
## proven to execute since auto-subscribe depends on this same bind having  ##
## happened. deliberately NOT waiting on the STRM open event to trigger     ##
## this: it's not that open/close go unobserved client-side -- they don't,  ##
## nshell.handler.strm_reply handles both directly [ 'open' prints          ##
## "[ stream started ]" and fires its own viewport redraw once              ##
## $stream_opened is set ] -- it's that THIS hook never sees them at all.   ##
## nshell.handler.command_reply diverts every STRM-cmd reply straight to    ##
## strm_reply at its own top, before reaching the plugin-dispatch block     ##
## that calls on_reply -- so open/close structurally never reach this       ##
## function, regardless of what their args field contains. redrawing here,  ##
## right after the bind, is what actually covers the task-id-in-status-bar  ##
## case for THIS code path.                                                 ##
my $state_ref = <nshell.state> // {};
if ( $state_ref->{'split_active'} ) {
    <[nshell.render.viewport]>->( $state_ref->{'editor'}, \%colors );
}

return TRUE;

