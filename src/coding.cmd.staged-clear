## [:< ##

# name  = coding.cmd.staged-clear
# descr = clear all staged edits

my $removed = <[coding.staged.clear]>;

return {
    'mode' => qw| size |,
    'data' => $removed
    ? sprintf( "cleared %d staged file%s",
        $removed, $removed == 1 ? '' : 's' )
    : 'no staged edits to clear'
};

