## [:< ##

# name  = audio.finalize_decode
# descr = finish decode : render pcm to png and reply to deferred caller
# param = $decode_id

my $id = shift // '';

my $state = delete <audio.decode>->{$id};
return unless defined $state and defined $state->{'reply_id'};

## cancel leftover watchers + timeout, terminate decode process group ##
eval { $state->{'w_err'}->cancel } if defined $state->{'w_err'};
eval { $state->{'timer'}->cancel } if defined $state->{'timer'};
kill( 9, -( $state->{'pid'} ) ) if $state->{'pid'};

my $reply;
my $pcm_bin = $state->{'pcm'} // '';

if ( length $pcm_bin < <audio.cfg.fft_size> * 4 ) {
    my $err = $state->{'stderr'} // '';
    $err =~ s|\s+$||;
    $err   = substr( $err, -200 ) if length $err > 200;
    $reply = {
        'mode' => qw| false |,
        'data' => sprintf( 'decode produced no pcm : %s',
            length $err ? $err : 'empty stream' )
    };
} else {
    my @pcm = unpack( 'f<*', $pcm_bin );

    ## format hint : am_depth predicts dense/coherent vs scattered/bursty   ##
    ## renders (see data/tasks/audio-icon-format-hint-from-am-depth.md),    ##
    ## computed once here independent of whichever render_style runs --     ##
    ## it's a property of the content, not of any particular renderer.      ##
    ## encoded into the filename [ not the reply ] since .cmd. replies must ##
    ## stay { mode, data => STRING } with no extra keys                     ##
    my ( $am_ok, $am_depth ) = <[audio.analyze.am_depth]>->(
        \@pcm, <audio.cfg.sample_rate>, { 'fft_size' => <audio.cfg.fft_size> }
    );
    my $format_hint
        = ( $am_ok and $am_depth >= <audio.cfg.format_hint_threshold> )
        ? qw| wide |
        : qw| square |;

    ## output path chosen internally, never caller-controlled ##
    my $out_dir = <audio.cfg.output_dir>;
    $out_dir =~ s|/+$||;
    if ( not -d $out_dir ) {
        <[file.make_path]>->($out_dir);
    }
    chmod( 0775, $out_dir );    ## screenshot zenka precedent : 775/664 ##
    my $stamp    = <[base.ntime.b32]>->( 5, TRUE );
    my $out_path = sprintf '%s/spatial-%s-%s.png', $out_dir, $stamp,
        $format_hint;

    ## per-call pipeline override : lets a fixed-recipe caller [ see      ##
    ## audio.cmd.spatial-purr-icon ] pin a specific render_style/         ##
    ## post_process/overlay combo without touching the global audio.cfg.* ##
    ## knobs those experiment with via devmod -- falls back to global cfg ##
    ## for anything the override doesn't set, same as always when unset   ##
    my $pipeline = $state->{'pipeline'} // {};

    ## style dispatch : render_style selects which versioned renderer to  ##
    ## call, so future divergent styles can coexist rather than overwrite ##
    ## this one -- see audio.render_standing_wave.v1's own header         ##
    my $style      = $pipeline->{'render_style'} // <audio.cfg.render_style>;
    my $render_sub = "audio.render_standing_wave.$style";

    my ( $ok, $result, $stats );
    if ( not exists $code{$render_sub} ) {
        ( $ok, $result )
            = ( FALSE, sprintf 'unknown render_style : %s', $style );
    } else {
        ( $ok, $result, $stats ) = $code{$render_sub}->(
            \@pcm,
            <audio.cfg.sample_rate>,
            $out_path,
            {   'size'     => <audio.cfg.image_size>,
                'fft_size' => <audio.cfg.fft_size>
            }
        );
    }

    my $post_process = $pipeline->{'post_process'}
        // <audio.cfg.post_process>;

    ## post-process dispatch : orthogonal to render_style, applied in place ##
    ## on the file the render_sub already wrote -- see                      ##
    ## audio.post_process.rotation_stack.v1's own header                    ##
    if ( $ok and length $post_process and $post_process ne 'none' ) {
        my $pp_sub = "audio.post_process.$post_process";
        if ( exists $code{$pp_sub} ) {
            my ( $pp_ok, $pp_result ) = $code{$pp_sub}->($result);
            if ( not $pp_ok ) {
                <[base.logs]>->( 0, 'post-process failed : %s', $pp_result );
            }
        } else {
            <[base.logs]>->( 0, 'unknown post_process : %s', $pp_sub );
        }
    }

    my $overlay = $pipeline->{'overlay'} // <audio.cfg.overlay>;

    ## overlay dispatch : third orthogonal axis, draws new content from pcm ##
    ## as a foreground on top of the finished background -- see             ##
    ## audio.overlay.waveform_trace.v1's own header                         ##
    if ( $ok and length $overlay and $overlay ne 'none' ) {
        my $ov_sub = "audio.overlay.$overlay";
        if ( exists $code{$ov_sub} ) {
            my ( $ov_ok, $ov_result ) = $code{$ov_sub}->( \@pcm, $result );
            if ( not $ov_ok ) {
                <[base.logs]>->( 0, 'overlay failed : %s', $ov_result );
            }
        } else {
            <[base.logs]>->( 0, 'unknown overlay : %s', $ov_sub );
        }
    }

    ## auto-crop : pipeline-only opt-in [ not audio.cfg.*, since the single ##
    ## post_process slot can't combine crop_wide with a rotation stack --   ##
    ## see audio.post_process.crop_wide.v1's own header ]. only a           ##
    ## fixed-recipe caller that already knows it isn't also asking for a    ##
    ## rotation-family post_process opts into this                          ##
    if (    $ok
        and $pipeline->{'auto_crop'}
        and $format_hint eq qw| wide |
        and exists $code{'audio.post_process.crop_wide.v1'} ) {
        my ( $cw_ok, $cw_result )
            = <[audio.post_process.crop_wide.v1]>->($result);
        <[base.logs]>->( 0, 'auto-crop failed : %s', $cw_result )
            if not $cw_ok;
    }

    if ($ok) {
        chmod( 0664, $result );
        <[base.logs]>->(
            2,
            'standing-wave render : %s [ %.1f%% '
                . 'lit, %d samples, am_depth=%.3f -> %s ]',
            $result,
            100 * ( $stats->{'lit_ratio'} // 0 ),
            scalar @pcm,
            $am_ok ? $am_depth : -1,
            $format_hint
        );
        $reply = { 'mode' => qw| true |, 'data' => $result };
    } else {
        <[base.logs]>->( 0, 'standing-wave render failed : %s', $result );
        $reply = { 'mode' => qw| false |, 'data' => $result };
    }
}

<[base.callback.cmd_reply]>->( $state->{'reply_id'}, $reply );

return TRUE;

