## [:< ##

# name  = v7-zenki.zenka.cmd.login-session-state
# descr = greeter startup query : locked, active or none

## cube prepends the calling zenka [ source_zenka alias ] ##
my ( $caller, $extra ) = split( m| +|, $call->{'args'} // '', 2 );
return { 'mode' => qw| false |, 'data' => 'denied : login-screen only' }
    if ( $caller // '' ) ne qw| login-screen | or defined $extra;

foreach my $iid (<[v7-zenki.instance_ids]>) {
    my $instance = <v7-zenki.zenka.instance>->{$iid};
    next if ( $instance->{'zenka_name'} // '' ) ne qw| login-screen-session |;
    next
        if ( $instance->{'status'} // '' ) =~ m{^(?:offline|error|shutdown)$};
    my $user = $instance->{'subname'} // next;
    return { 'mode' => qw| true |, 'data' => "locked $user" }
        if ( <v7-zenki.login-session.locked> // '' ) eq $user;
    return { 'mode' => qw| true |, 'data' => "active $user" };
}
return { 'mode' => qw| true |, 'data' => qw| none | };

