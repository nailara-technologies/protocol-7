# name = data.mount.shm.open.mmap_shm_read
# descr = mmap POSIX SHM for read access

my $fd = shift;

if ( eval { require Sys::Mmap } ) {
    my $var;
    my $size = -s "/proc/self/fd/$fd" // 65536;
    Sys::Mmap::mmap( $var, $size, Sys::Mmap::PROT_READ(),
        Sys::Mmap::MAP_SHARED(), $fd, 0 );
    return \$var if length($var) > 0;
}

return undef;

