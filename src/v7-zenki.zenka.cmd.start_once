## [:< ##

# name  = v7-zenki.zenka.cmd.start_once
# param = [:wait-up:|:wait-down:] <zenka-id|name>
# descr = start a new zenka instance [ if not present ]
# note  = :wait-up: replies once its startup completed or failed,
#         :wait-down: once it ended [ error end : FALSE + exit code ]

my $args = $call->{'args'} // '';

## optional wait flags [ before the zenka name ] : the waiter is registered
## first, then the zenka is started ; without a flag the reply stays the
## immediate start confirmation
my $wait_up   = $args =~ s{^:wait-up:\s*}{};
my $wait_down = $args =~ s{^:wait-down:\s*}{};

if ( $wait_up or $wait_down ) {
    return {
        'mode' => qw| false |,
        'data' => 'expected zenka-id or name parameter'
        }
        if not length $args;

    ## strip an optional [subname] for the set-up lookup
    ## [ the way the notify commands do ] ; the waiter key keeps the full
    ## string
    my $lookup_name = $args;
    my $zenka_subname;
    my $re_sn = <regex.base.subname>;
    $zenka_subname = ${^CAPTURE}[0]
        if $lookup_name  !~ <regex.base.iid>
        and $lookup_name =~ s|\[($re_sn)\]$||;

    if (    not defined <[zenka.get_id]>->($lookup_name)
        and not defined <v7-zenki.zenka.instance>->{$args} ) {
        my $rep_msg
            = $args =~ <regex.base.iid>
            ? "no such zenka instance ($args)"
            : "no such zenka in setup [$args]";
        return {
            'mode' => qw| false |,
            'data' => $rep_msg
        };
    }

    ## :wait-up: resolves the already-present case [ instant TRUE ] and both
    ## startup reply paths through the notify_online waiter list ; its :start:
    ## registers the waiter before starting
    if ($wait_up) {
        my $call_copy = { $call->%* };
        $call_copy->{'args'} = sprintf ':start: %s', $args;
        return <[zenka.cmd.notify_online]>->($call_copy);
    }

    ## :wait-down: notify_offline waiter first, then start : a clean end
    ## replies TRUE, an error end FALSE with the exit code
    push( <v7-zenki.zenka.notify_offline>->{$args}->@*, $call->{'reply_id'} );
    $call->{'args'} = $args;
    $_[0]->{'once'} = 1;
    <[zenka.cmd.start]>->(@ARG);
    return { 'mode' => qw| deferred | };
}

$_[0]->{'once'} = 1;

return <[zenka.cmd.start]>->(@ARG);

