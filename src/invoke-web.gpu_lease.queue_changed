## [:< ##

# name  = invoke-web.gpu_lease.queue_changed
# descr = acquire for queued renders and release after an empty-queue grace
# param = resume observed by the processor poll [ repeated resume re-pauses ]

my $resume_observed = shift // FALSE;

return TRUE
    if not <[base.cfg_bool]>->( <models.cfg.gpu_lease.enabled> // FALSE );
my $dbh = <[invoke-web.queue.db]> // return FALSE;
my ( $in_progress, $pending ) = $dbh->selectrow_array(
    "SELECT SUM( status = 'in_progress' ), SUM( status "
        . "= 'pending' AND priority > ? ) FROM session_queue",
    undef,
    -( <invoke-web.session.park_offset> // 1000000 ) / 2
);
return FALSE if not defined $in_progress or not defined $pending;

my $holder = ( <invoke-web.gpu_lease.holder> // '' ) eq qw| invoke-web |;

## a hand pause keeps the lease only until its release grace expires ##
if (    defined <invoke-web.gpu_lease.processor_paused>
    and <invoke-web.gpu_lease.processor_paused>
    and not <invoke-web.gpu_lease.auto_paused> ) {
    return TRUE if not $holder;
    if ( defined <invoke-web.gpu_lease.grace_timer>
        and not <invoke-web.gpu_lease.grace_user_pause> ) {
        my $old_grace = delete <invoke-web.gpu_lease.grace_timer>;
        $old_grace->cancel if $old_grace->is_active;
    }
    return TRUE if defined <invoke-web.gpu_lease.grace_timer>;
    my $grace = <models.cfg.gpu_lease.grace> // 120;
    $grace = 120 if $grace !~ m|^\d+$|;
    <invoke-web.gpu_lease.grace_user_pause> = TRUE;
    <invoke-web.gpu_lease.grace_timer>      = <[event.add_timer]>->(
        {   'after'   => $grace,
            'handler' => qw| invoke-web.gpu_lease.handler.grace |,
            'data'    => { 'user_pause' => TRUE },
        }
    );
    <[base.logs]>->(
        1, ': render queue paused : gpu lease release in %d s', $grace
    );
    return TRUE;
}

if ( $in_progress or $pending ) {
    my $grace = delete <invoke-web.gpu_lease.grace_timer>;
    $grace->cancel if defined $grace and $grace->is_active;
    delete <invoke-web.gpu_lease.grace_user_pause>;
    my $requested = <[invoke-web.gpu_lease.request]>;
    if (    $requested == FALSE
        and not <invoke-web.gpu_lease.probe>
        and ( not <invoke-web.gpu_lease.auto_paused> or $resume_observed ) ) {
        <invoke-web.gpu_lease.auto_paused> = TRUE;
        <[invoke-web.api_async]>->(
            'PUT', '/api/v1/queue/default/processor/pause',
            undef, 'invoke-web.gpu_lease.handler.queue_pause_reply'
        );
    }
    return $requested;
}

return TRUE if not $holder;
return TRUE if defined <invoke-web.gpu_lease.grace_timer>;
my $grace = <models.cfg.gpu_lease.grace> // 120;
$grace = 120 if $grace !~ m|^\d+$|;
<invoke-web.gpu_lease.grace_user_pause> = FALSE;
<invoke-web.gpu_lease.grace_timer>      = <[event.add_timer]>->(
    {   'after'   => $grace,
        'handler' => qw| invoke-web.gpu_lease.handler.grace |,
        'data'    => { 'user_pause' => FALSE },
    }
);
<[base.logs]>->(
    1, ': render queue empty : gpu lease release in %d s', $grace
);
return TRUE;

