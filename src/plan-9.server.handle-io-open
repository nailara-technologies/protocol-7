## [:< ##
# name  = plan-9.server.handle-io-open
# descr = Handle 9P Topen/Ropen

my ( $client, $tag, $data ) = @ARG;

my $fid  = <[plan-9.protocol.codec.decode-uint32]>->( substr( $data, 0, 4 ) );
my $mode = <[plan-9.protocol.codec.decode-uint8]>->( substr( $data, 4, 1 ) );

my $f = $client->{fids}{$fid};
return <[plan-9.protocol.error]>->( $tag, "invalid fid" ) unless $f;

if ( $f->{type} eq 'realpath' ) {
    my $base_mode   = $mode & 0x03;
    my $wants_write = $base_mode == <plan-9.protocol.constants.OWRITE>
        || $base_mode == <plan-9.protocol.constants.ORDWR>;

    return <[plan-9.protocol.error]>->( $tag, "export is read-only" )
        if $wants_write and not $f->{writable};

    if (    $wants_write
        and $mode & <plan-9.protocol.constants.OTRUNC>
        and -f $f->{realpath} ) {
        truncate( $f->{realpath}, 0 )
            or return
            <[plan-9.protocol.error]>->( $tag, "cannot truncate: $!" );
    }
}

$f->{omode} = $mode;
$f->{open}  = 1;

my $qid = <[plan-9.protocol.codec.encode-qid]>->(
    $f->{qid}{type}, $f->{qid}{version},
    $f->{qid}{path}
);

my $resp
    = $qid
    . <[plan-9.protocol.codec.encode-uint32]>->( $client->{msize} // 8192 );

return <[plan-9.protocol.codec.encode-message]>->(
    <plan-9.protocol.constants.Ropen>,
    $tag, $resp
);

