## [:< ##
# name  = plan-9.server.handle-io-stat
# descr = Handle 9P Tstat/Rstat

my ( $client, $tag, $data ) = @ARG;

my $fid = <[plan-9.protocol.codec.decode-uint32]>->( substr( $data, 0, 4 ) );

my $f = $client->{fids}{$fid};
return <[plan-9.protocol.error]>->( $tag, "invalid fid" ) unless $f;

my $stat      = <[plan-9.server.buffer-stat]>->($f);
my $stat_data = <[plan-9.protocol.codec.encode-stat]>->($stat);

my $resp = <[plan-9.protocol.codec.encode-uint16]>->( length($stat_data) )
    . $stat_data;

return <[plan-9.protocol.codec.encode-message]>->(
    <plan-9.protocol.constants.Rstat>,
    $tag, $resp
);

