## [:< ##

# name  = powershell.cmd.pulse-start
# descr = start detached host pulseaudio with p7-owned .pa

my $result = <[powershell.pulse-start]>;

return {
    'mode' => $result->{'ok'} ? qw| true | : qw| false |,
    'data' => $result->{'msg'},
};

