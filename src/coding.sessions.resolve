## [:< ##

# name   = coding.sessions.resolve
# descr  = the current name of a session
# args   = name [, sid ]
# return = the name it has now, else the name given
#
# with a sid : the record holding it. without : a known name stays, an old
# one follows its alias until that ran out

my ( $name, $sid ) = @ARG;
my $all = <[coding.sessions.store]>;
if ( not defined $sid ) {
    return $name if exists $all->{$name};
    my $alias = <coding.sessions.aliases>->{$name} // return $name;
    return $name if ( $alias->{'until'} // 0 ) <= time;
    $sid = $alias->{'sid'};
}
my ($now) = grep {
    ( $all->{$ARG}{'sid'} // '' ) eq $sid
        and not $all->{$ARG}{'parked'}
} sort keys %{$all};
return $now // $name;

