## [:< ##

# name  = nameserv.enc.recovered
# param = <upstream name>
# descr = an encrypted upstream answered : leave the degraded mode

my $name  = shift // return FALSE;
my $since = <nameserv.enc.degraded_since>;
return TRUE if ref $since ne qw| HASH |;
delete <nameserv.enc.degraded_since>;
<[base.logs]>->(
    1,     ': dns back on encrypted upstream %s [ degraded for %d s : %s ]',
    $name, time - $since->{'at'},
    $since->{'reason'}
);
return TRUE;

