## [:< ##

# name   = stream_child.signal
# descr  = send a signal to the child [ or its group ]
# param  = handle, signal name, quiet
# return = TRUE when sent

my ( $handle, $signal, $quiet ) = @ARG;
return FALSE if not defined $handle or not defined $handle->{'pid'};
my $target = $handle->{'group'} ? -$handle->{'pid'} : $handle->{'pid'};
my $sent   = CORE::kill( $signal, $target ) ? TRUE  : FALSE;
<[stream_child.note]>->( $handle, qw| signal |, { 'signal' => $signal } )
    if $sent and not $quiet;
return $sent;

