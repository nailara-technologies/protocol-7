# name  = models.cmd.gpu-lease-renew
# descr = renew the gpu residency lease

my ($owner) = split m|\s+|, $call->{'args'} // '';
my $renewed = <[models.gpu_lease.renew]>->( $owner // '' );
return {
    'mode' => $renewed ? qw| true | : qw| false |,
    'data' => $renewed ? qw| done | : 'not holder'
};

