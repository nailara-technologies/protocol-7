# name  = invoke-web.handler.gpu_resume_reply
# descr = last step of a cuda error recovery : queue resumed

my $reply = shift // {};
<[base.logs]>->(
    $reply->{'ok'} ? 1 : 0,
    'gpu : recovery done, queue %s',
    $reply->{'ok'} ? 'resumed' : "not resumed [ $reply->{'status'} ]"
);

