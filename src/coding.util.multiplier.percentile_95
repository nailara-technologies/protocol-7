# name  = coding.util.multiplier.percentile_95
# descr = compute P95 from a sorted array

my @vals = sort { $a <=> $b } @_;
return $vals[0] if @vals == 1;
my $idx = int( 0.95 * ( scalar(@vals) - 1 ) + 0.5 );
$idx = $#vals if $idx > $#vals;
return $vals[$idx];

