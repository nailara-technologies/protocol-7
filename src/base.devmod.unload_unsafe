# name  = base.devmod.unload_unsafe
# descr = remove all commands not explicitly classified as safe

my @remove_cmd = <[base.devmod.unsafe_commands]>;
return 0 if not @remove_cmd;

my $unload_count = 0;
foreach my $cmd_name (@remove_cmd) {
    my $module_name = sprintf qw| devmod.cmd.%s |, $cmd_name;
    my $removed     = delete $code{$module_name};
    <[base.disable_command]>->($cmd_name);
    $unload_count++ if defined $removed;
}

<[base.parser.access_conf]>;

return $unload_count;

