## [:< ##

# name  = ui.layout.fit
# descr = decide which children unfold and which fold, for a budget
# param = { address, slot_budget, priority? }

my $address     = $ARG[0]->{'address'}     // '';
my $slot_budget = $ARG[0]->{'slot_budget'} // {};
my $priority_cb = $ARG[0]->{'priority'};

return [] if not length $address;

my $budget_rows = $slot_budget->{'rows'} // 24;
my $budget_cols = $slot_budget->{'cols'} // 80;

## [ enumerate children ]
my @children;

## list-subs hook
my $list_subs = "$address.list-subs";
if ( defined $code{$list_subs} ) {
    my $result = eval { $code{$list_subs}->() };
    if ( defined $result and ref $result eq 'ARRAY' ) {
        push @children, @$result;
    } elsif ( defined $result
        and ref $result eq 'HASH'
        and exists $result->{'children'} ) {
        push @children, $result->{'children'}->@*;
    }
}

## data children
my $data_ref = \%data;
my @segments = split /\./, $address;
my $resolved = TRUE;

for my $segment (@segments) {
    if ( ref $data_ref eq 'HASH' and exists $data_ref->{$segment} ) {
        my $next = $data_ref->{$segment};
        if ( ref $next eq 'HASH' ) {
            $data_ref = $next;
        } else {
            $resolved = FALSE;
            last;
        }
    } else {
        $resolved = FALSE;
        last;
    }
}

if ( $resolved and ref $data_ref eq 'HASH' ) {
    for my $key ( keys %$data_ref ) {
        push @children, $key;
    }
}

## code children
my $prefix     = "$address.";
my $prefix_len = length $prefix;

for my $code_key ( keys %code ) {
    next if index( $code_key, $prefix ) != 0;
    my $rest = substr( $code_key, $prefix_len );
    next if index( $rest, '.' ) < 0;
    my ($child) = split /\./, $rest, 2;
    push @children, $child;
}

## deduplicate while preserving order
my %seen;
@children = grep { !$seen{$ARG}++ } @children;

## no children → empty layout
return [] if not @children;

## compute unfolded cost per child
my @child_info;
for my $child (@children) {
    my $child_address = "$address.$child";
    my $cost
        = eval { <[ui.estimate.cost]>->( { 'address' => $child_address } ); }
        // { 'rows' => 1, 'cols' => 40 };
    push @child_info,
        {
        'address' => $child_address,
        'cost'    => $cost
        };
}

## default priority heuristic [ recency * affinity ]
my $now = eval { <[base.time]>->(5) } // time;

my @scored;
for my $info (@child_info) {
    my $priority = 1;

    if ( defined $priority_cb and ref $priority_cb eq 'CODE' ) {
        $priority = $priority_cb->($info);
    } else {
        ## recency [ inverse seconds since state change ]
        my $ref
            = eval { <[base.resolve_hash]>->( $info->{'address'}, \%data ) };
        my $timestamp;
        if (    defined $ref
            and ref $ref eq 'HASH'
            and $ref != \%data
            and exists $ref->{'timestamp'} ) {
            $timestamp = $ref->{'timestamp'};
        }
        if ( defined $timestamp and looks_like_number($timestamp) ) {
            my $age = $now - $timestamp;
            $age      = 1 if $age < 1;
            $priority = 1 / $age;
        }

        ## affinity [ currently focused multiplier ]  LLL: future work will
        ## wire focus tracking
        $priority *= 1;
    }

    push @scored, { %$info, 'priority' => $priority };
}

## sort by priority descending, address ascending for stability
@scored = sort {
           $b->{'priority'} <=> $a->{'priority'}
        or $a->{'address'} cmp $b->{'address'}
} @scored;

## greedy fill [ highest priority first ]
my @layout;
my $remaining = $budget_rows;
my $folded    = 0;

for my $info (@scored) {
    my $cost_rows = $info->{'cost'}{'rows'} // 1;
    if ( $cost_rows <= $remaining ) {
        push @layout,
            {
            'child_address' => $info->{'address'},
            'mode'          => qw| unfold |,
            'cost'          => $info->{'cost'}
            };
        $remaining -= $cost_rows;
    } else {
        push @layout,
            {
            'child_address' => $info->{'address'},
            'mode'          => qw| fold |,
            'cost'          => $info->{'cost'}
            };
        $folded++;
    }
}

## ensure trailing handle fits if any folded
if ( $folded > 0 and $remaining < 1 ) {
    while ( $remaining < 1 ) {
        my $max_cost = 0;
        my $max_idx  = -1;
        for my $i ( 0 .. $#layout ) {
            next if $layout[$i]->{'mode'} ne qw| unfold |;
            my $cost = $layout[$i]->{'cost'}{'rows'} // 1;
            if ( $cost > $max_cost ) {
                $max_cost = $cost;
                $max_idx  = $i;
            }
        }
        last if $max_idx < 0;
        $layout[$max_idx]->{'mode'} = qw| fold |;
        $remaining += $max_cost;
        $folded++;
    }
}

return \@layout;

