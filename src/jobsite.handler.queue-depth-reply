## [:< ##

# name  = jobsite.handler.queue-depth-reply
# descr = receive site-yaml queue depth; when zero, stop polling and claim strays

my $call = shift // {};

## mode_text reads both reply shapes                                    ##
## [ an external route answers in call_args.args, not data ] -- reading ##
## data alone defaulted every remote reply to 0 and declared the queue  ##
## drained 3 s after the import                                         ##
## [ 1127 queued on delta, assessment started on a fraction ]           ##
my ( $mode, $depth ) = <[base.reply.mode_text]>->($call);
if ( $mode eq qw| false | or $depth !~ m|^\s*(\d+)\s*$| ) {
    <[base.logs]>->(
        0, ': fetch : unreadable queue depth reply [ %s ] , polling on',
        $depth
    );
    return;
}
$depth = $1;

if ( $depth > 0 ) {
    ## queue has been populated for this scan ##
    <jobsite.fetch_saw_queue> = TRUE;
    <[base.logs]>->( 2, ': fetch : site-yaml queue depth = %d', $depth );
    return;
}

## ignore early zero-depth replies that race ahead of the import queueing ; ##
## once fetch-done has reported queued items [ or we have seen depth > 0 ], ##
## a zero reply means the queue is drained                                  ##
<[base.logs]>->(
    2,
    ': fetch : site-yaml queue depth = 0 [saw_queue=%s]',
    <jobsite.fetch_saw_queue> ? 'yes' : 'no'
);
return if not <jobsite.fetch_saw_queue>;

## queue drained : cancel poll timer, pull stray jobs, then assess ##
if ( defined <jobsite.queue_poll_timer> ) {
    <jobsite.queue_poll_timer>->cancel;
    <jobsite.queue_poll_timer> = undef;
}

<[base.logs]>->( 1, ':. site-yaml queue empty, claiming strays..' );

## per-category fetch tally [ WY5 ] : queued from the import replies, new \ ##
## known from the job-upsert results -- the import summary alone counted    ##
## queued links as "new", which a full=0 rescan disproved                   ##
my $queued_cat = <jobsite.fetch_queued_cat> // {};
my $upsert_st  = <jobsite.upsert_stats>     // {};
for my $category ( sort keys %{$queued_cat} ) {
    <[base.logs]>->(
        1,
        ':: %s :: queued %d · new %d · known %d',
        $category,
        $queued_cat->{$category},
        $upsert_st->{$category}{'new'}   // 0,
        $upsert_st->{$category}{'known'} // 0
    );
}

<[jobsite.stray.check]>;
<[jobsite.dispatch.assessments]>;

return;

