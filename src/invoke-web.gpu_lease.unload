## [:< ##

# name  = invoke-web.gpu_lease.unload
# descr = pause the queue then empty every unlocked invoke.ai cached model
# param = requester, mode [ handover | release ], grace was a user pause

my ( $requester, $mode, $user_pause ) = @ARG;
$mode //= qw| handover |;
return FALSE if <invoke-web.gpu_lease.unloading>;

## release ownership comes from its grace origin, not an unknown cache ##
if ( $mode eq qw| release | ) {
    if ($user_pause
        or ( ( <invoke-web.gpu_lease.processor_paused> // FALSE )
            and not <invoke-web.gpu_lease.auto_paused> )
    ) {
        <invoke-web.gpu_lease.auto_paused> = FALSE;
    } else {
        <invoke-web.gpu_lease.auto_paused> = TRUE;
    }
} elsif ( not <invoke-web.gpu_lease.auto_paused>
    and defined <invoke-web.gpu_lease.processor_paused>
    and not <invoke-web.gpu_lease.processor_paused> ) {
    <invoke-web.gpu_lease.auto_paused> = TRUE;
}

<invoke-web.gpu_lease.holder>           = undef;
<invoke-web.gpu_lease.request_inflight> = FALSE;
<invoke-web.gpu_lease.unloading>        = TRUE;
<invoke-web.gpu_lease.handover_waiting>
    = $mode eq qw| handover | ? TRUE : FALSE;
my $renew = delete <invoke-web.gpu_lease.renew_timer>;
$renew->cancel if defined $renew and $renew->is_active;

<invoke-web.gpu_lease.unload_requester> = $requester // '';
<invoke-web.gpu_lease.unload_mode>      = $mode;
if ( ( <invoke-web.status> // qw| idle | ) !~ m{^(?:running|starting)$} ) {
    <[event.add_timer]>->(
        {   'after'   => 0,
            'handler' => qw| invoke-web.gpu_lease.handler.verify_unload |,
            'data'    => { 'attempt' => 1 },
        }
    );
    return TRUE;
}
<[invoke-web.api_async]>->(
    'PUT', '/api/v1/queue/default/processor/pause',
    undef, 'invoke-web.gpu_lease.handler.unload_pause_reply'
);
return TRUE;

