# name  = models.cmd.gpu-lease-released
# descr = a previous gpu occupant acknowledges its unload

my ( $from, $requester ) = split m|\s+|, $call->{'args'} // '';
my $lease   = <models.gpu_lease> //= {};
my $pending = $lease->{'pending'};

return { 'mode' => qw| false |, 'data' => 'no matching handover' }
    if ref $pending ne qw| HASH |
    or ( $pending->{'from'}      // '' ) ne ( $from      // '' )
    or ( $pending->{'requester'} // '' ) ne ( $requester // '' );

$pending->{'unloaded'}    = TRUE;
$pending->{'wait_reason'} = 'unload acknowledged : checking vram';
<[models.gpu_lease.handler.tick]>;
return { 'mode' => qw| true |, 'data' => qw| done | };

