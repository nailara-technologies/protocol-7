## [:< ##

# name  = debian.log.condense
# descr = condense raw apt-get \ dpkg output to one line per package
# note  = the pure logic is shared with 'bin/p7-deps dist-upgrade' [ which
#         streams through it live ] in AMOS7::deps::aptlog -- this module
#         stays the p7-side entry point

use AMOS7::deps::aptlog ();

my $args = shift // {};

my $result = AMOS7::deps::aptlog::condense($args);

return { 'mode' => $result->{'mode'}, 'data' => $result->{'data'} };

