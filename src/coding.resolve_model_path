## [:< ##

# name  = coding.resolve_model_path
# descr = Request model path resolution from models zenka via async
#         reply handler
# note  = Called from start file after network connection established
#         Actual response arrives asynchronously via
#         coding.handler.model_path_reply
# param = backend [ 'gpu'|'cpu', default 'gpu' -- the bare-macro call in   #
#         cfg/zenki/coding/zenka.v7 passes no args ]

my $backend = shift // 'gpu';

## amos_id : backend-scoped config slot first [ new, may be unset ], ##
## falling back to the shared <inference.model.amos_id> so existing  ##
## single-model configs keep working with zero cfg changes           ##
my $model_amos_id = <inference.backend>->{$backend}->{'amos_id'}
    // <inference.model.amos_id> // '';

## in-flight guard, per backend [ nested-hash macro access, same pattern as ##
## <coding.inference_servers>->{$backend} ] : this is now called from two   ##
## places [ the original unconditional init-time call in zenka.v7, AND the  ##
## resolve hook [ coding.resolve.object.model_path ] that fires whenever    ##
## async_spawn_inference_servers finds the path still unresolved ] --       ##
## without this, the common case [ deferred spawn timer firing before the   ##
## original init-time request has replied ] would send a genuinely          ##
## redundant second request every time, not just occasionally. cleared      ##
## per-backend by coding.handler.model_path_reply on any reply for that     ##
## backend, success or failure                                              ##
if ( <coding.model_path_request_in_flight>->{$backend} ) {
    <[base.logs]>->(
        2, '[resolve_model_path] %s request already in flight, skipping',
        $backend
    );
    return TRUE;
}

<[base.logs]>->(
    1, '[resolve_model_path] %s amos_id from config: [%s] (length=%d)',
    $backend, $model_amos_id, length($model_amos_id)
);

unless ( defined $model_amos_id && length $model_amos_id ) {
    <[base.logs]>->(
        0, '[resolve_model_path] no model amos_id configured [backend=%s]',
        $backend
    );
    return FALSE;
}

<[base.logs]>->(
    1,        '[resolve_model_path] requesting %s model path for amos_id=%s',
    $backend, $model_amos_id
);

## Request model path from models zenka via network (route through cube)
## Response arrives asynchronously through reply handler
<[base.logs]>->(
    2, '[resolve_model_path] sending call_args with amos_id=[%s]',
    $model_amos_id
);

my $clients_reached = <[protocol-7.command.send.local]>->(
    {   'command'   => 'cube.models.get_path_by_amos',
        'call_args' => { 'args' => $model_amos_id },
        'reply'     => {
            'params' => {
                'model_amos_id' => $model_amos_id,
                'backend'       => $backend
            },
            'handler' => 'coding.handler.model_path_reply'
        }
    }
);

## Check if command was successfully sent (1 = reached models zenka)
unless ( $clients_reached == 1 ) {
    <[base.logs]>->(
        0, '[resolve_model_path] failed to reach models zenka (clients=%d)',
        $clients_reached
    );
    ## not in flight : leave the guard clear so a later resolve-hook retry ##
    ## [ or the deferred spawn timer's next dependency.ok check ] can try  ##
    ## again, instead of being permanently blocked by a flag nothing will  ##
    ## ever clear                                                          ##
    return FALSE;
}

<coding.model_path_request_in_flight>->{$backend} = TRUE;

<[base.logs]>->(
    1,
    '[resolve_model_path] %s model path request sent, awaiting async reply',
    $backend
);
return TRUE;

