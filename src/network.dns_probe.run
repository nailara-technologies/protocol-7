## [:< ##

# name  = network.dns_probe.run
# param = <iface>
# descr = ask nameserv to probe the dns of one leased network

my $iface = shift                                // return FALSE;
my $l     = <network.lease>->{$iface}            // return FALSE;
my $p     = <[network.dns_policy.get]>->($iface) // return FALSE;
my @dns   = ( ( $l->{'dns'} // [] )->@*, ( $l->{'dns6'} // [] )->@* );
return FALSE
    if not @dns
    or ( $l->{'reason'} // '' ) !~ m{^(BOUND|RENEW|REBIND|REBOOT)6?$};

## blocked : the owner withheld every query to that server, probes too ##
if ( $p->{'policy'} eq qw| blocked | ) {
    <[base.logs]>->(
        2, ': dns behaviour probe for %s skipped [ policy blocked ]', $iface
    );
    return FALSE;
}

<network.dns_probe.by_iface>->{$iface}{'probed_at'} = time;
my $sent = <[protocol-7.command.send.local]>->(
    {   qw| command |   => qw| nameserv.dns-probe |,
        qw| call_args | => {
            qw| args | => join ' ',
            "dhcp:$iface", $p->{'fingerprint'}, @dns
        }
    }
);
<[base.logs]>->(
    2,
    ': dns behaviour probe for %s [ %s ] %s',
    $iface,
    $p->{'fingerprint'},
    ( $sent // 0 ) > 0 ? 'sent' : 'not delivered [ nameserv not running ? ]'
);
return ( $sent // 0 ) > 0 ? TRUE : FALSE;

