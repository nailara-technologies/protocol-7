## [:< ##

# name  = proxy.handler.post_auth
# descr = run async transport selection then dispatch to handler.request.
#         called after auth lookup completes [or is skipped].
#         args: $client_id

my $client_id = shift;
my $client    = <proxy.clients>->{$client_id};
return if not defined $client;

## client half-closed during auth wait: nothing to respond to ##
if ( $client->{'half_closed'} ) {
    <[proxy.client.close]>->($client_id);
    return;
}

my $context = $client->{'context'};

## transport integration point [async; no-op when transport not co-loaded] ##
if ( exists $code{'proxy.transport.select'} ) {
    <[proxy.transport.select]>->(
        $context,
        sub {
            my $transport_result = shift;
            my $client_now       = <proxy.clients>->{$client_id};
            return if not defined $client_now;
            if ( defined $transport_result
                and ref $transport_result eq qw| HASH | ) {
                $context->{'transport'}{'handle'} = $transport_result;
            }
            <[proxy.handler.request]>->($client_id);
            return;
        }
    );
    return;
}

<[proxy.handler.request]>->($client_id);

return;

