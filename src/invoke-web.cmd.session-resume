# name  = invoke-web.cmd.session-resume
# descr = resume a parked session [ restores its order ]
# param = <name>

my $name = $call->{'args'} // '';
$name =~ s{^\s+|\s+$}{}g;

return { mode => qw| false |, data => 'expected : <name> [ see sessions ]' }
    if not length $name;

my $count = <[invoke-web.session.resume]>->($name);

return { mode => qw| false |, data => "no parked session '$name'" }
    if not defined $count;

return {
    mode => qw| size |,
    data => sprintf(
        "session '%s' resumed " . "[ %d items pending ]\n",
        $name, $count
    )
};

