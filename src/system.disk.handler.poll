## [:< ##

# name  = system.disk.handler.poll
# descr = sample mounted file systems and arm the next disk poll

<[system.disk.poll]>;
my $delay
    = <[base.interval.next]>->(
    { qw| type | => qw| disk |, qw| state | => <system.disk.interval_state> }
    );
return FALSE if not defined $delay or $delay <= 0;
<system.disk.timer> = <[event.add_timer]>->(
    {   qw| after |   => $delay,
        qw| repeat |  => FALSE,
        qw| handler | => qw| system.disk.handler.poll |,
    }
);
return TRUE;

