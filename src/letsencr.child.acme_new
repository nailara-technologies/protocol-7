## [:< ##

# name  = letsencr.child.acme_new
# descr = ACME account creation and order setup [ part 1 : synchronous ]
# note  = returns deferred to parent at challenge phase, continues w reply_id

my $msg      = shift;
my $reply_id = shift;    ## async reply mechanism for challenge coordination

my $domains = $msg->{'domains'};                           # array ref
my $email   = $msg->{'email'} || <letsencr.admin.email>;

return {
    'status' => qw| error |,
    'error'  => 'domains array required'
    }
    unless $domains && ref($domains) eq qw| ARRAY | && @$domains;

my $primary_domain = $domains->[0];

<[base.logs]>->(
    2,
    'issuing new certificate for domains: %s',
    join( ', ', $domains->@* )
);

## STEP 1 : Fetch ACME directory [ if not already cached ]
unless ( <letsencr.child.acme_client>->{directory} ) {
    <[base.log]>->( 2, ': step 1 : fetching ACME directory' );
    my $dir_info = <[letsencr.child.fetch_acme_directory]>;
    unless ($dir_info) {
        return {
            'status' => qw| error |,
            'error'  => 'Failed to fetch ACME directory'
        };
    }
}

## STEP 2 : Load or generate account key
<[base.log]>->( 2, ': step 2 : loading or generating account key' );
my $account_key = <[letsencr.child.load_account_key]>;
unless ($account_key) {
    $account_key = <[letsencr.child.generate_account_key]>;
    unless ($account_key) {
        return {
            'status' => qw| error |,
            'error'  => 'Failed to generate account key'
        };
    }
}

## store substituted email in acme_client state for acme_register_account
<letsencr.child.acme_client>->{'contact_email'} = $email;

## STEP 3 : Register ACME account (or retrieve existing)
unless ( <letsencr.child.acme_client>->{account_url} ) {
    <[base.log]>->( 2, 'step 3: registering ACME account' );
    my $account_info = <[letsencr.child.acme_register_account]>;
    if ( $account_info->{error} ) {
        ## account registration failed with detailed error
        return {
            'status' => qw| error |,
            'error'  => $account_info->{error}
        };
    }
    unless ($account_info) {
        ## Try checking if account already exists
        my $existing = <[letsencr.child.acme_check_account]>;
        unless ($existing) {
            return {
                'status' => qw| error |,
                'error'  => 'Failed to register ACME account'
            };
        }
    }
}

## STEP 4 : Create certificate order
<[base.log]>->( 2, 'step 4: creating certificate order' );
my $order = <[letsencr.child.acme_create_order]>->($domains);
unless ($order) {
    return {
        'status' => qw| error |,
        'error'  => 'Failed to create certificate order'
    };
}

## propagate rate_limited upstream immediately
if ( ref $order eq qw| HASH |
    and ( $order->{error} // '' ) eq qw| rate_limited | ) {
    return {
        'status'      => qw| error |,
        'error'       => 'rate_limited',
        'retry_after' => $order->{retry_after} // '',
    };
}

<[base.logs]>->( 2, 'order URL: %s', $order->{'order_url'} );
<[base.logs]>->(
    2,
    'authorizations: %d',
    scalar( @{ $order->{authorizations} } )
);

## STEP 5 : Transition to async challenge processing  store order state for
## continuation phase and return deferred
<[base.logs]>->(
    2,
    'order created with %d authorizations, transitioning to async phase',
    scalar( @{ $order->{authorizations} } )
);

## store state in global for continuation handler to access
<letsencr.child.acme_state> = {
    domains        => $domains,
    primary_domain => $primary_domain,
    email          => $email,
    order          => $order,
    reply_id       => $reply_id,
};

<[base.log]>->(
    2, 'returning deferred, challenge coordination continues asynchronously'
);

## return deferred to indicate async processing with parent coordination
## include order info so parent can orchestrate challenge setup
return {
    'status'         => qw| deferred |,
    'order'          => $order,
    'domains'        => $domains,
    'primary_domain' => $primary_domain,
};

