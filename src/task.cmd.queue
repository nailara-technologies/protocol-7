## [:< ##

# name  = task.cmd.queue
# param = [status=<pending|claimed|done|failed>]
# descr = list tasks in insertion order, filtered by status

my $filter_status = '';

## parse params
if ( defined $call->{'param'} and ref $call->{'param'} eq 'HASH' ) {
    $filter_status = $call->{'param'}->{'status'} // '';
} elsif ( defined $call->{'args'} and length $call->{'args'} ) {
    ## parse "status=value" from args
    my $args = $call->{'args'};
    if ( $args =~ m{status\s*=\s*(\S+)}i ) {
        $filter_status = $1;
    }
}

my @lines;

## iterate in insertion order
foreach my $task_id ( @{<task.queue.order>} ) {
    my $task = <task.queue>->{$task_id};
    next unless defined $task;    ## skip if deleted somehow

    ## apply status filter if specified
    if ( length $filter_status ) {
        next unless $task->{'status'} eq $filter_status;
    }

    my $desc = $task->{'description'} // '';
    ## truncate to 60 chars
    if ( length $desc > 60 ) {
        $desc = substr( $desc, 0, 57 ) . '...';
    }

    push @lines,
        sprintf( '%-7s %-8s %s', $task_id, $task->{'status'}, $desc );
}

my $output;
return { mode => qw| false |, data => 'no tasks found' }
    unless @lines;

$output = join( "\n", @lines ) . "\n";

return { 'mode' => 'size', 'data' => $output };

