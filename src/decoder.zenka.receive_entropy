## [:< ##

# name  = decoder.zenka.receive_entropy
# descr = Receive 42-bit entropy frame : boundary detection, B32, D3, D13, vterm
# param = <stream_id> <42-bit-entropy> [decode_chunk]

my $params       = shift                     // {};
my $stream_id    = $params->{'stream_id'}    // $ARG[0];
my $entropy      = $params->{'entropy'}      // $ARG[1];
my $decode_chunk = $params->{'decode_chunk'} // $ARG[2];

return { 'mode' => qw| false |, 'data' => 'missing stream_id' }
    unless defined $stream_id;
return { 'mode' => qw| false |, 'data' => 'missing entropy' }
    unless defined $entropy;

## reconstruct harmonic decimal value from 42-bit binary string ##
my $decimal = oct("0b$entropy");

## passive boundary detection : PYTAURAZUMA canvas-clean at 769230 ##
if ( $decimal == 769230 ) {
    <[protocol-7.route-send]>->(
        {   'command'   => 'decoder.handler.on-boundary',
            'call_args' => { 'args' => "$stream_id 769230" },
        }
    );
}

## feed raw entropy bytes into Term::VTerm for ANSI/sequence parsing ##
if ( defined $data{'decoder'}{'vterm'} ) {
    $data{'decoder'}{'vterm'}->input_write( pack 'B42', $entropy );
}

## level-5 : extract 5-bit chunks → base32 values [ per-stream state ] ##
<decoder.level5>->{$stream_id} //= {
    'accumulator' => '',
    'bit_count'   => 0,
    'values'      => [],
};
my $L5 = <decoder.level5>->{$stream_id};
$L5->{'accumulator'} .= $entropy;
$L5->{'bit_count'} += 42;

my $chunks_added = 0;
while ( $L5->{'bit_count'} >= 5 ) {
    my $chunk = substr( $L5->{'accumulator'}, 0, 5, '' );
    $L5->{'bit_count'} -= 5;
    my $val = oct("0b$chunk");
    push @{ $L5->{'values'} }, $val;
    $chunks_added++;
    <[base.buffer.add_line]>->(
        qw| level-5-B32 |,
        sprintf( "%02d [ stream %s ]", $val, $stream_id ), 2
    );
}

## level-6 : accumulate 3 decimal digits → unicode codepoint [ per-stream ##
## state ]                                                                ##
<decoder.level6>->{$stream_id}{'accumulator'} //= '';
my $L6 = <decoder.level6>->{$stream_id};
$L6->{'accumulator'} .= sprintf '%d', $decimal;
while ( length( $L6->{'accumulator'} ) >= 3 ) {
    my $code_point = 0 + substr( $L6->{'accumulator'}, 0, 3 );
    $L6->{'accumulator'}
        = substr( $L6->{'accumulator'}, 3 );
    my $unicode_char = chr($code_point);
    <[base.buffer.add_line]>->(
        qw| level-6-D3 |,
        join( ' ', sprintf( "%03d", $code_point ), $unicode_char ), 0
    );
}

## level-7 : passive d13 type-prefix decode of the 7-bit chunk that rides ##
## alongside the 42-bit entropy [ GFX / B32 / DOC / RT<dir><hops> / UNK ] ##
## observation only -- no routing or state change is driven by this yet   ##
my $d13_decoded;
if ( defined $decode_chunk and length($decode_chunk) == 7 ) {
    $d13_decoded = <[decoder.base.decode_d13_bits]>->($decode_chunk);

    my ($type_tag) = $d13_decoded =~ m|^(\w+)\[|;
    $type_tag //= $d13_decoded;    ## e.g. plain 'UNK' ##

    $data{'decoder'}{'d13_types'}{$type_tag}++;

    <[base.buffer.add_line]>->(
        qw| level-7-D13 |,
        sprintf( "%s [ stream %s ]", $d13_decoded, $stream_id ), 2
    );
}

<[base.logs]>->(
    2, "decoder stream %s : decimal %d : +%d B32 chunks",
    $stream_id, $decimal, $chunks_added
);

return {
    'mode' => qw| true |,
    'data' => {
        'stream_id'    => $stream_id,
        'decimal'      => $decimal,
        'boundary'     => ( $decimal == 769230 ) ? TRUE : FALSE,
        'chunks_added' => $chunks_added,
        'total_values' =>
            scalar( @{ <decoder.level5>->{$stream_id}{'values'} } ),
        'pending_bits' => <decoder.level5>->{$stream_id}{'bit_count'},
        'd13_decoded'  => $d13_decoded,
    }
};

