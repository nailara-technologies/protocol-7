# name  = nameserv.upstream_address
# descr = validate and canonicalize one upstream ip address

require Socket;

my $ip = shift // return undef;
for my $family ( Socket::AF_INET(), Socket::AF_INET6() ) {
    my $packed = Socket::inet_pton( $family, $ip ) // next;
    return Socket::inet_ntop( $family, $packed );
}
return undef;

