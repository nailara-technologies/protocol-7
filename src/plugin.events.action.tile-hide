## [:< ##

# name  = plugin.events.action.tile-hide
# descr = tile group visibility down [ up at end ]

return {
    'name'     => qw| tile-hide |,
    'kind'     => qw| action |,
    'describe' => 'tile group visibility down [ up at end ]',
    'run'      => sub {
        my $fire        = shift;
        my $ev_type     = $fire->{'ev_type'};
        my $action      = $fire->{'action'};
        my $action_type = $action->{'type'};

        my $l_name = $action->{'tile-group-name'};
        die "'tile_group_name' parameter is missing from '$action_type' setup"
            if not defined $l_name;    ## <-- check \ test [LLL]
        <events.stack.tile.visibility>->{$l_name} //= 0;
        my $change = $ev_type eq qw| end | ? -1 : 1;
        <events.stack.tile.visibility>->{$l_name} -= $change;

        <[events.action.tile_apply]>->($action);
        return TRUE;
    }
};

