## [:< ##

# name  = ticker.cmd.set-monitor
# param = <mode>
# descr = set monitor selection mode for swap-mode ticker
# modes = follow-pointer | primary | index:N | cycle

my $mode = $call->{'args'} // qw| follow-pointer |;

my $valid = qr{^(follow-pointer|primary|index:\d+|cycle)$};
if ( $mode !~ $valid ) {
    return {
        'mode' => qw| false |,
        'data' => "invalid monitor mode '$mode'"
    };
}

<ticker.window.monitor>       = $mode;
<ticker.window.monitor_index> = 0 if $mode eq qw| cycle |;

## re-apply current profile so the change is immediate ##
if ( defined <ticker.obj.window> ) {
    <[ticker.cmd.set-window-profile]>
        ->( { 'args' => <ticker.window.profile> // qw| bottom-strip | } );
}

return {
    'mode' => qw| true |,
    'data' => "monitor mode: $mode"
};

