## [:< ##

# name  = protocol.protocol-7.link-upgrade.handshake
# descr = client side link-upgrade handshake [ c25519 dh ]
# param = $socket, { timeout, binding }
#
# the CLIENT half of the link upgrade, mirroring bin/c_src/p-7-r.c and
# the server's state 2 handler [ base.handler.link-upgrade ] line by
# line - run on an authenticated, still plaintext protocol-7 socket
# BEFORE it is handed to the event loop [ a brief blocking exchange,
# the shape auth.client.auth-keypair.authenticate already uses ; every
# read is bounded by the timeout, //= 5 s ] :
#
#   -> link-upgrade                <- TRUE link-upgrade OK <server pub b32>
#   -> link-pub-key <client pub>   <- SIZE 0
#   -> link-confirm-encoding none  <- encoding-confirmed
#   -> link-complete <nonce sid> <client_bind_sig>
#                                  <- link-complete-ok <server_bind_sig>
#                                     [ still plaintext ]
#
# binding : the context auth.client.auth-keypair.authenticate returned
# [ server_nonce, server_pub, username, base_key_name ] -- REQUIRED. the
# client signs auth.binding.message 'client' with its base key and
# verifies the server's 'server' sig with the PINNED server_pub
# [ data/md/design/AUTH-LINK-BINDING.md ] : no context, no upgrade.
#
# the client key is a throwaway curve25519 pair [ random_bytes +
# curve25519_public_key, never stored ] ; the nonce sid is a random
# 32-bit value [ the server packs it with 'N' ]. returns
# ( 1, { shared_secret => <raw 32 bytes>, nonce_sid => <int> } ) or
# ( 0, { error => <text> } ). the result is applied to a registered
# client session by protocol.protocol-7.link-upgrade.client_activate.
#
# replaces an earlier stub that never sent 'link-upgrade', never read
# the server key and therefore never computed the shared secret.

my ( $socket, $options ) = @ARG;
$options //= {};

my $timeout = $options->{'timeout'} // 5;
$timeout = 5 if !$timeout or $timeout < 1;

require IO::Select;
require Crypt::Misc;
require Crypt::Curve25519;
require Crypt::Ed25519;

my $fail = sub { return ( 0, { 'error' => shift } ) };

my $binding = $options->{'binding'};
return $fail->('no binding context [ auth-keypair ]')
    if ref $binding ne qw| HASH |
    or length( $binding->{'server_pub'}        // '' ) != 32
    or length( $binding->{'server_nonce'}      // '' ) != 32
    or not length( $binding->{'username'}      // '' )
    or not length( $binding->{'base_key_name'} // '' );

my $select    = IO::Select->new($socket);
my $read_line = sub {
    return undef if not $select->can_read($timeout);
    my $line = readline($socket);
    return undef if not defined $line;
    $line =~ s{\r?\n\z}{};
    return $line;
};
my $send = sub {
    return print {$socket} shift;
};

## 1. ask for the upgrade : the server answers with its ephemeral key ##
$send->("link-upgrade\n") or return $fail->("send failed : $OS_ERROR");

my $offer = $read_line->() // return $fail->('no link-upgrade answer');
my ($server_pub_b32) = $offer =~ m{\bOK\s+([A-Za-z2-7]+)\s*$}o;
return $fail->("link-upgrade refused : $offer")
    if not defined $server_pub_b32;

my $server_pub = eval { Crypt::Misc::decode_b32r($server_pub_b32) };
return $fail->('invalid server key')
    if not defined $server_pub
    or length $server_pub != 32;

## 2. a throwaway client key, the dh secret from it ##
my $client_secret = Crypt::Misc::random_bytes(32);
my $client_pub    = Crypt::Curve25519::curve25519_public_key($client_secret);

$send->( sprintf "link-pub-key %s\n", Crypt::Misc::encode_b32r($client_pub) )
    or return $fail->("send failed : $OS_ERROR");

my $ack = $read_line->() // return $fail->('no public key answer');
return $fail->("public key refused : $ack") if $ack ne 'SIZE 0';

my $shared_secret
    = Crypt::Curve25519::curve25519_shared_secret( $client_secret,
    $server_pub );
undef $client_secret;

return $fail->('dh failed')
    if not defined $shared_secret
    or length $shared_secret != 32;

## 3. no transport encoding [ encrypted framing is binary ] ##
my $encoding = qw| none |;
$send->("link-confirm-encoding $encoding\n")
    or return $fail->("send failed : $OS_ERROR");

my $enc = $read_line->() // return $fail->('no encoding answer');
return $fail->("encoding refused : $enc") if $enc ne 'encoding-confirmed';

## 4. the nonce sid both ends derive key + nonces from ##
my $nonce_sid = unpack qw| N |, Crypt::Misc::random_bytes(4);
$nonce_sid ||= 1;

## 5. the bind transcript : this client identity <-> this dh ##
my %transcript = (
    qw| server_nonce | => $binding->{'server_nonce'},
    qw| server_pub |   => $binding->{'server_pub'},
    qw| server_eph |   => $server_pub,
    qw| client_eph |   => $client_pub,
    qw| nonce_sid |    => $nonce_sid,
    qw| encoding |     => $encoding,
    qw| username |     => $binding->{'username'},
);
my $client_message = <[auth.binding.message]>->( qw| client |, \%transcript );
my $server_message = <[auth.binding.message]>->( qw| server |, \%transcript );
return $fail->('cannot build bind transcript')
    if not defined $client_message
    or not defined $server_message;

my $client_bind_sig = <[crypt.C25519.sign_data]>->(
    \$client_message, $binding->{'base_key_name'}
);
return $fail->('cannot sign client_bind_sig')
    if not defined $client_bind_sig
    or length $client_bind_sig != 64;

$send->(
    sprintf "link-complete %d %s\n",
    $nonce_sid, Crypt::Misc::encode_b32r($client_bind_sig)
) or return $fail->("send failed : $OS_ERROR");

my $done = $read_line->() // return $fail->('no link-complete answer');
my ($server_bind_sig_b32) = $done =~ m{\Alink-complete-ok ([A-Z2-7]+)\z}o;
return $fail->("link-complete refused : $done")
    if not defined $server_bind_sig_b32;

## 6. the server proves it holds the pinned key, for THIS transcript ##
my $server_bind_sig = eval { Crypt::Misc::decode_b32r($server_bind_sig_b32) };
my $server_sig_ok   = eval {
            defined $server_bind_sig
        and length $server_bind_sig == 64
        and Crypt::Ed25519::verify( $server_message, $binding->{'server_pub'},
        $server_bind_sig );
};
return $fail->('server_bind_sig NOT valid [ server not proven ]')
    if not $server_sig_ok;

return ( 1,
    { 'shared_secret' => $shared_secret, 'nonce_sid' => $nonce_sid } );

