## [:< ##

# name  = osf-cache.fetch.segment_timeout
# descr = holder timer fired : retry once, then exclude
# param = timer event [ data => { fetch_key, sid } ]
#
# one-shot per-holder timer armed by osf-cache.fetch.send_segment [
# after <osf-cache.cfg.segment_timeout>, repeat FALSE ]. a silent
# holder is retried ONCE with the same leaf [ a fresh seq makes the
# late reply to the timed-out request a dead letter ] ; a second
# timeout excludes it and requeues the leaf [ osf-cache.fetch.
# holder_fail ] - the other holders continue. the timeout count
# resets on every good reply from that holder. a fetch past the
# segment phase or a holder without an outstanding leaf ignores the
# fire.

my $event      = shift;
my $timer_data = eval { $event->w->data }   // {};   ## poll_switch pattern ##
my $fetch_key  = $timer_data->{'fetch_key'} // '';
my $sid        = $timer_data->{'sid'}       // '';

my $state = <osf-cache.fetch.pending>->{$fetch_key};
return unless ref $state eq qw| HASH |;
return unless ( $state->{'phase'} // '' ) eq qw| segments |;

my $hs = $state->{'hs'}{$sid} // return;
return if $hs->{'excluded'};
return unless defined $hs->{'leaf'};                 ## nothing outstanding ##

$hs->{'timeouts'}++;

<[base.logs]>->(
    0, ': osf-cache : leaf %d timeout [ %s, %d ]',
    $hs->{'leaf'}, $sid, $hs->{'timeouts'}
);

if ( $hs->{'timeouts'} >= 2 ) {
    <[osf-cache.fetch.holder_fail]>->(
        {   'fetch_key' => $fetch_key,
            'sid'       => $sid,
            'reason'    => 'timeout'
        }
    );
    return;
}

## first timeout : the SAME holder gets the same leaf once more ##
<[osf-cache.fetch.send_segment]>->(
    {   'fetch_key' => $fetch_key,
        'sid'       => $sid,
        'leaf'      => $hs->{'leaf'},
    }
);

return;

