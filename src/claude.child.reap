## [:< ##

# name   = claude.child.reap
# descr  = collect the ended child's exit status
# args   = child hash
# return = TRUE when collected [ or gone already ]

## not exited yet after eof : checked again on a claude-reap timer ##

my $child = shift // return TRUE;
return TRUE if defined $child->{'exit'};
my $got = CORE::waitpid( $child->{'pid'}, POSIX::WNOHANG() );
if ( $got == $child->{'pid'} ) {
    $child->{'exit'}   = $CHILD_ERROR >> 8;
    $child->{'signal'} = $CHILD_ERROR & 127;
    <[claude.event.add]>->(
        qw| exit |, sprintf 'pid %d exit %d signal %d',
        $child->{'pid'}, $child->{'exit'}, $child->{'signal'}
    );
    return TRUE;
}
if ( $got < 0 ) {    ## reaped elsewhere ##
    $child->{'exit'} = qw| ? |;
    return TRUE;
}
$child->{'reap_state'} //= {};
my $delay = <[base.interval.next]>
    ->( { 'type' => qw| claude-reap |, 'state' => $child->{'reap_state'} } );
<[event.add_timer]>->(
    {   'after'   => $delay // 1,
        'handler' => qw| claude.handler.reap |,
        'data'    => { 'pid' => $child->{'pid'} }
    }
) if $child->{'reap_tries'}++ < 13;
return FALSE;

