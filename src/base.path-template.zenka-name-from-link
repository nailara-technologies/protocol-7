## [:< ##

# name  = base.path-template.zenka-name-from-link
# descr = zenka name carried by a launcher link name [ terminal segment rule ]
# param = link_name_or_path

##  the terminal segment rule of the zenka symlink chain : a link name is    ##
##  'recognized' when its BASENAME carries one of the three interpreter      ##
##  name forms, and the remainder of that basename is the zenka name --      ##
##                                                                          ##
##      p7-<zenka>            current form, installed by                    ##
##                            <[v7-zenki.install_zenka_symlinks]>           ##
##      v7.<zenka>            deprecated form [ pre 23a0e8d53 ]             ##
##      Protocol-7.<zenka>    interpreter-name form                         ##
##                                                                          ##
##  a bare 'Protocol-7' is deliberately NOT recognized -- it carries no      ##
##  trailing dot, so './bin/Protocol-7 <zenka>' keeps naming its zenka       ##
##  through the argument list, exactly as before                            ##
##                                                                          ##
##  matching is on the basename alone : a directory component must never be  ##
##  able to name the zenka [ '/opt/v7.tools/bin/radio-jazz' is not 'tools' ] ##

## this delegates to the bootstrap implementation in bin/Protocol-7 --   ##
## zenka-name resolution runs before the module system is live, so the   ##
## interpreter carries the only copy of the rule and this registry entry ##
## publishes it under the canonical 'path-template.*' name  [ see        ##
## data/md/design/ZENKA-SYMLINK-CHAIN-RESOLUTION.md ]                    ##

return <[base.zenka_name_from_link_name]>->(@ARG);

