# name  = cube.cmd.unset-initialized
# descr = pause command delivery [ unset initialized flag ]
# param = <sid|0>

my $sid = $call->{'args'} || $call->{'session_id'};   # 0 == self [current s.]

return { 'mode' => qw| false |, 'data' => 'no such session' }
    if not exists $data{'session'}{$sid};
return { 'mode' => qw| false |, 'data' => "session not in 'zenka' mode" }
    if not defined $data{'session'}{$sid}{'auth'}{'method'}
    or $data{'session'}{$sid}{'auth'}{'method'} ne qw| zenka |;
return { 'mode' => qw| false |, 'data' => 'was not initialized' }
    if not defined $data{'session'}{$sid}{'initialized'}
    or not $data{'session'}{$sid}{'initialized'};

$data{'session'}{$sid}{'initialized'} = 0;

my $zenka_name = $data{'session'}{$sid}{'user'};
<[base.logs]>->(
    "[%s] zenka '%s' [uninitialized — drain mode]",
    $sid, $zenka_name
);

return { 'mode' => qw| true |, 'data' => qw| uninitialized | }

