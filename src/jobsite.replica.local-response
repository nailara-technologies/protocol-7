# name  = jobsite.replica.local-response
# descr = complete a pull after the local replacement was accepted

my $result = shift // {};
my $reply
    = $result->{'ok'}
    ? eval { JSON::XS::decode_json( $result->{'body'} // '' ) }
    : undef;
my $ok = ref $reply eq 'HASH' && ( $reply->{'ok'} // FALSE );
<[jobsite.replica.complete]>->( $ok ? TRUE : FALSE );

