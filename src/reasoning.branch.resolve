## [:< ##

# name  = reasoning.branch.resolve
# param = { id, output }

my $params = shift // {};

## command interface ##
if ( ref $params eq qw| HASH | and exists $params->{'args'} ) {
    my $args = $params->{'args'} // '';
    if ( length $args ) {
        my $parsed = eval { <[format.yaml.load_str]>->($args) };
        $params
            = ( defined $parsed and ref $parsed eq qw| HASH | )
            ? $parsed
            : { id => $args };
    } else {
        $params = {};
    }
}

my $id = $params->{'id'} // '';
return { 'mode' => qw| false |, 'data' => 'branch id required' }
    unless length $id;

my $registry = <reasoning.branch.registry> // {};
my $branch   = $registry->{$id};

return { 'mode' => qw| false |, 'data' => "branch not found: $id" }
    unless defined $branch;

$branch->{'state'}       = qw| resolved |;
$branch->{'output'}      = $params->{'output'} // '';
$branch->{'resolved_at'} = <[base.ntime]>;

## forensics : coding.task.fail and coding.async.complete's failure branch ##
## both prefix 'failed: ' onto output before resolving [ the only two call ##
## sites that mark a branch failed instead of completed ] -- surface that  ##
## here so an abort or error shows up distinctly from a normal completion  ##
## instead of a bare "resolved" that looks the same either way             ##
if ( $branch->{'output'} =~ m{^failed: }i ) {
    <[base.logs]>->(
        1, "reasoning.branch.resolve: %s resolved as FAILED [%s]",
        $id,
        <[base.parser.center_ellipse_string]>->( $branch->{'output'}, 72 )
    );
} else {
    <[base.logs]>->( 1, "reasoning.branch.resolve: %s resolved", $id );
}

## notify waiting dependents ##
my @resumed;
foreach my $dep_id ( keys %$registry ) {
    my $dep_branch = $registry->{$dep_id};
    next unless $dep_branch->{'state'} eq qw| paused |;

    my $deps = $dep_branch->{'deps'} // [];
    next unless grep { $ARG eq $id } @$deps;

    ## remove resolved dependency ##
    $dep_branch->{'deps'} = [ grep { $ARG ne $id } @$deps ];

    ## if no more deps, resume ##
    if ( scalar $dep_branch->{'deps'}->@* == 0 ) {
        ## inject resolved output as context ##
        my $injected = sprintf( "[DEPENDENCY RESOLVED] %s found: %s",
            $id, $branch->{'output'} );
        <[reasoning.branch.inject]>->(
            {   id               => $dep_id,
                context          => $injected,
                source_branch_id => $id
            }
        );
        push @resumed, $dep_id;
    }
}

if (@resumed) {
    <[base.logs]>->(
        1,
        "reasoning.branch.resolve: resumed %d dependent(s) [%s]",
        scalar @resumed,
        join( ', ', @resumed )
    );
}

return {
    'mode' => qw| true |,
    'data' => { resolved => $id, resumed => \@resumed }
};

