## [:< ##

# name  = web-browser.capture_paged.advance
# descr = called when the paged capture loop finishes (successfully or after
#         an unrecoverable failure). clears the loop state and resumes the
#         slideshow's normal advance-to-next-URL flow.

## page completed normally -- disarm the watchdog ##
<web-browser.timer.capture_page_timeout>->cancel
    if defined <web-browser.timer.capture_page_timeout>
    and <web-browser.timer.capture_page_timeout>->is_active;
delete <web-browser.timer.capture_page_timeout>;

delete <web-browser.capture.paged.positions>;
delete <web-browser.capture.paged.index>;
delete <web-browser.capture.paged.uri>;
delete <web-browser.capture.paged.pending_path>;

if (<web-browser.slideshow.running>) {
    <web-browser.slideshow.status> = 'load_finished';
    <[web-browser.handler.slideshow]>;
}

