## [:< ##

# name  = usage.cmd.status
# descr = usage numbers of every loaded provider in one reply
# param = [ compact | details ] [ <provider> .. ]

my $args_str = $call->{'args'} // '';

my $format
    = $args_str =~ m{\bcompact\b}i ? qw| compact |
    : $args_str =~ m{\bdetails\b}i ? qw| box |
    :                                qw| pretty |;

##  provider names may be named explicitly, otherwise all loaded ones  ##
my @named = grep {
    $ARG ne qw| compact | and $ARG ne qw| box | and $ARG ne qw| details |
    }
    split m{ +}, $args_str;

my @providers = @named ? @named : <[usage.provider_list]>;

return { 'mode' => qw| false |, 'data' => 'no usage providers loaded' }
    if not @providers;

my $query = <[usage.query]>->( \@providers, $call->{'reply_id'}, $format );

## a query that never started answers here, otherwise the reply travels ##
## back through usage.complete_query                                    ##
return $query if ref $query eq qw| HASH |;

return { 'mode' => qw| deferred | };

