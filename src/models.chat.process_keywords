## [:< ##

# name = models.chat.process_keywords
# descr = process keywords in chat messages (:task: :output: :note: etc)
# param = $message - message text with potential keywords
# return = processed message with keyword actions executed

my $message = shift // '';

## track keyword actions
my @actions = ();

## :output: <command> - execute command and inline result
while ( $message =~ m{:output:\s+([^\s:]+(?:\s+[^:]+?)?)\s*(?=:|$)}g ) {
    my $command = $1;
    push @actions,
        {
        'type'    => 'output',
        'command' => $command,
        'pos'     => pos($message)
        };
}

## :task: marker - track as delegated task
if ( $message =~ m{:task:} ) {
    push @actions, { 'type' => 'task', 'message' => $message };
}

## :note: marker - metadata/context
if ( $message =~ m{:note:} ) {
    push @actions, { 'type' => 'note', 'message' => $message };
}

## :done: marker - completion signal
if ( $message =~ m{:done:} ) {
    push @actions, { 'type' => 'done', 'message' => $message };
}

## [:memory:CHECKSUM] - expand memory items inline
while ( $message =~ m|\[:memory:([A-Z0-9]{7})\]|g ) {
    my $checksum = $1;
    my $content  = <[models.memory.show]>->($checksum);

    if ( defined $content ) {
        ## replace pattern with actual content
        $message =~ s{\[:memory:$checksum\]}{$content}g;
        push @actions,
            { 'type' => 'memory', 'checksum' => $checksum, 'expanded' => 1 };
    } else {
        ## replace with error marker if not found
        $message =~ s{\[:memory:$checksum\]}{[memory:$checksum:not-found]}g;
        push @actions,
            { 'type' => 'memory', 'checksum' => $checksum, 'expanded' => 0 };
    }
}

## TODO: execute :output: commands and inline results

return $message;

