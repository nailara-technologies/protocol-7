## [:< ##

# name  = claude.cmd.status
# descr = state, session, turn, cost, last events

my $child = <claude.child>;
my $last  = <claude.last_result> // {};
my @lines = (
    sprintf( 'state   : %s%s',
        <claude.state> // qw| idle |,
        <claude.turn_active> ? ' [ turn running ]' : '' ),
    sprintf( 'pid     : %s',
        defined $child && defined $child->{'out'} ? $child->{'pid'} : '-' ),
    sprintf( 'session : %s', <claude.session> // '-' ),
    sprintf( 'turn    : %d%s',
        <claude.turn> // 0,
        defined $last->{'state'}
        ? " [ last $last->{'state'} $last->{'subtype'} ]"
        : '' ),
    sprintf( 'queued  : %d',       scalar @{ <claude.queue> // [] } ),
    sprintf( 'cost    : %.4f usd', <claude.cost> // 0 ),
);
my $events = <claude.events> // [];
my $from   = @{$events} > 7 ? @{$events} - 7 : 0;
push @lines, '', 'last events :',
    map {"  $ARG"} @{$events}[ $from .. $#$events ]
    if @{$events};
return { 'mode' => qw| true |, 'data' => join( "\n", @lines ) . "\n" };

