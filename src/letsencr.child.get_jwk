## [:< ##

# name  = letsencr.child.get_jwk
# descr = get public key in JWK (JSON Web Key) format for ACME (RFC 7517/8037)

my $account_key_name = <letsencr.child.acme_client>->{account_key_name};
return undef unless $account_key_name;

## get key type from acme_client state
my $key_type = <letsencr.child.acme_client>->{account_key_type};
unless ($key_type) {
    <[base.log]>->( 1, 'error: account key type not set in acme_client' );
    return undef;
}

<[base.logs]>->( 3, 'generating JWK from %s account key', $key_type );

## route to appropriate JWK generator based on key type
if ( $key_type eq 'RSA' ) {
    return <[letsencr.child.get_rsa_jwk]>;
} elsif ( $key_type eq 'Ed25519' ) {
    ## generate JWK for Ed25519 (OKP format per RFC 8037)
    unless ( exists $keys{'C25519'}->{$account_key_name}
        && exists $keys{'C25519'}->{$account_key_name}->{'public'} ) {
        <[base.log]>->(
            1, "error: account key '$account_key_name' not found"
        );
        return undef;
    }

    my $public_key_binary = $keys{'C25519'}->{$account_key_name}->{'public'};

    ## create OKP JWK structure for Ed25519
    my $jwk = {
        crv => 'Ed25519',
        kty => 'OKP',
        x   => encode_base64url($public_key_binary),
    };

    ## canonical JSON with sorted keys
    my $jwk_json = JSON::XS->new->canonical(1)->encode($jwk);
    return JSON::XS::decode_json($jwk_json);
} else {
    <[base.log]>->( 1, "error : unknown account key type : $key_type" );
    return undef;
}

