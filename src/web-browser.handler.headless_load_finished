# name = web-browser.handler.headless_load_finished
# descr = async wrapper invoked after a headless-mode page finishes loading;
#         simply routes to the standard load_finished callback without the
#         swap/fade step that exists in non-headless mode

## headless mode skips the fade/swap that normally sets fade_complete; set ##
## it here so handler.slideshow's delay calculation does not die on undef  ##
<web-browser.time.fade_complete> = <[base.time]>->(3);

<[web-browser.callback.load_finished]>;

