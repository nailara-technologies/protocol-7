## [:< ##

# name  = invoke-web.cmd.resume
# descr = resume the invoke.ai queue processor

my $result = <[invoke-web.api]>->(
    'PUT', '/api/v1/queue/defau' . 'lt/processor/resume'
);

return {
    mode => qw| false |,
    data => sprintf( 'resume failed [ %s ]', $result->{'status'} )
    }
    if not $result->{'ok'};

return { mode => qw| size |, data => "invoke.ai queue resumed\n" };

