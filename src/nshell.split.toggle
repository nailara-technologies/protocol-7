## [:< ##

# name  = nshell.split.toggle
# descr = flip split-screen streaming display mode [ Tab key ]

my $state_ref = <nshell.state> //= {};

if ( $state_ref->{'split_active'} ) {

    ## turning off : restore full-screen scrolling, let the next render ##
    ## happen at wherever the terminal cursor naturally sits            ##
    AMOS7::TERM::scroll_region_clear();
    $state_ref->{'split_active'} = FALSE;
    delete $state_ref->{'split_row'};

} else {

    ## turning on : reserve the bottom row for the input line ##
    my $content_bottom = AMOS7::TERM::scroll_region_set(1);

    ## terminal too small [ scroll_region_set returned undef ] : refuse the ##
    ## toggle rather than leave the terminal in a half-set state            ##
    return undef unless defined $content_bottom;

    $state_ref->{'split_active'} = TRUE;
    $state_ref->{'split_row'}    = $content_bottom + 1;
}

## force an immediate render of the current input line at its new spot ##
<[nshell.render.viewport]>->( $state_ref->{'editor'}, \%colors );

return TRUE;

