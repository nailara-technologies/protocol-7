## [:< ##

# name   = invoke-web.retried
# descr  = own record of every queue item invoke-web retried [ requeue,
#          cuda \ crash recovery, requeue-missing ] -- invoke.ai's
#          retried_from_item_id link disappears when the copy is pruned
# param  = [ arrayref of item ids to add ]
# return = hashref { item_id => 1 } of all recorded ids
# note   = state/retried-items, one id per line, the last 20000 kept

my $add = shift;

my $saved = <[file.zenka_dir.load]>
    ->( <[invoke-web.state_name]>->('retried-items') );
my @ids = grep {m|^\d+$|} split m|\n|, defined $saved ? $saved->$* : '';

if ( defined $add and ref $add eq qw| ARRAY | and @$add ) {
    push @ids, grep {m|^\d+$|} @$add;
    @ids = @ids[ -20000 .. -1 ] if @ids > 20000;
    <[file.zenka_dir.write]>->(
        <[invoke-web.state_name]>->('retried-items'),
        \join( "\n", @ids, '' )
    );
}

return { map { $ARG => 1 } @ids };

