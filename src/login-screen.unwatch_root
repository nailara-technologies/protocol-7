## [:< ##

# name  = login-screen.unwatch_root
# descr = remove the lock root watch and its event selection

my $watch_id = delete <login-screen.lock.root_watch.id>;
Glib::Source->remove($watch_id) if defined $watch_id;

my $X = delete <login-screen.lock.root_watch.x>;
if ( defined $X ) {
    eval { $X->ChangeWindowAttributes( $X->root(), 'event_mask' => 0 ) };
}
delete <login-screen.lock.root_watch.xid>;
TRUE;

