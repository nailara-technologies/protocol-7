## [:< ##

# name  = power.wake.send
# param = <mac> <broadcast>
# descr = one magic packet : undef when sent, else why

my ( $mac, $broadcast ) = @ARG;
return 'no broadcast address' if not defined $broadcast;
my ( $dev, $why )
    = <[power.plugin.wol.open]>
    ->( { qw| mac | => $mac, qw| broadcast | => $broadcast } );
return $why if not defined $dev;
## sent : [ 'E' ] , the state is unknown until the host answers ##
return ref <[power.plugin.wol.set]>->( $dev, [1] ) eq qw| ARRAY |
    ? undef
    : 'packet not sent';

