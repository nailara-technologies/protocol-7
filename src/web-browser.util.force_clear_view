# name  = web-browser.util.force_clear_view
# descr = load a blank sentinel page into a specific WebKit view. this
#         terminates the view's current JS execution context and lets WebKit
#         reclaim the resources held by the previous page.

my $view = shift;

return if not defined $view;

my $bg_color = <web-browser.bg_color> // '#000013';

$view->load_alternate_html( "<html><body bgcolor=\"$bg_color\"></body><html>",
    '[capture_timeout:blank]' );

