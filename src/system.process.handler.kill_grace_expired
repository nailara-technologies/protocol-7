# name  = system.process.handler.kill_grace_expired
# descr = follow-up KILL after send_kill's TERM grace period, sent via the
#         raw privileged kill channel
# note  = fires unconditionally, no liveness check -- kill() is a harmless
#         no-op against an already-dead pid, same assumption v7-zenki.
#         handler.process_kill_list already makes for its own TERM/KILL pair

my $process_id = shift->w->data;

<process.TERM_chld.w_fh>->say("KILL $process_id");

0;

