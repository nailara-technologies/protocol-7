## [:< ##

# name  = amos-term.cmd.attach_buffer
# descr = Command to attach nshell or other clients to 3D buffer

my $args = $call->{'args'} // '';
my ( $buffer_id, $client_type, $options ) = split m|\s+|, $args;
$buffer_id =~ s{^\s+|\s+$}{}g if defined $buffer_id;

$client_type //= qw| nshell |;
$options     //= {};

## === resolve buffer === ##
my $window;
if ( $buffer_id =~ m|^amos:([A-Z0-9]{10})$|i ) {
    my $amos_id = uc($1);
    my $sid     = <amos-term.windows.by_amos>->{$amos_id};
    return { 'mode' => 'false', 'data' => 'buffer not found' }
        unless defined $sid;
    $window = <amos-term.windows.by_id>->{$sid};
} elsif ( $buffer_id =~ m{^name:(.+)$} ) {
    my $name = $1;
    my $sid  = <amos-term.windows.by_name>->{$name};
    return { 'mode' => 'false', 'data' => "buffer '$name' not found" }
        unless defined $sid;
    $window = <amos-term.windows.by_id>->{$sid};
} else {
    $window = <amos-term.windows.by_id>->{$buffer_id};
}

return { 'mode' => 'false', 'data' => 'buffer not found' }
    unless defined $window;

## === create buffer if not exists (lazy allocation) === ##
if ( not defined $window->{'buffer'}->{'shm_path'} ) {
    my $result = <[amos-term.buffer-create]>->( $window->{'session_id'} );
    return { 'mode' => 'false', 'data' => 'buffer creation failed' }
        unless $result;
}

## === attach client === ##
my $attachment;

if ( $client_type eq qw| nshell | ) {
    $attachment = <[amos-term.nshell.bridge]>->($buffer_id);
} else {
    $attachment = <[amos-term.buffer-attach_generic]>->(
        $buffer_id, $client_type, $options
    );
}

if ( not defined $attachment ) {
    return { 'mode' => 'false', 'data' => 'attachment failed' };
}

## === return success info === ##
my $amos_id   = $window->{'amos_id'};
my $attach_id = $attachment->{'attach_id'};

return {
    'mode' => 'size',
    'data' => sprintf(
        "Attached to buffer [%s]\nAMOS ID: %s\nAttachment: %s\n",
        $window->{'client_name'},
        $amos_id, $attach_id
    )
};

