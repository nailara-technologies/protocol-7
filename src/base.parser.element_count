# name  = base.parser.element_count
# descr = return element count of referenced hash or array scructures

return qw| n\\a |              if ref( $_[0] ) !~ m[^ARRAY|HASH$];
return scalar $ARG[0]->@*      if ref( $ARG[0] ) eq qw| ARRAY |;
return scalar keys $ARG[0]->%* if ref( $ARG[0] ) eq qw| HASH |;

