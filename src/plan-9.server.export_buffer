## [:< ##
# name  = plan-9.server.export_buffer
# descr = Export a buffer for 9P access

my ( $window, $amos_id ) = @ARG;

$amos_id //= $window->{'amos_id'};

$data{'plan-9'}{'server'}{'buffers'}{$amos_id} = {
    ## see also plan-9.server.export_directory ##
    'kind'        => 'buffer',
    'window'      => $window,
    'qid_path'    => $data{'plan-9'}{'server'}{'next_qid'}++,
    'qid_version' => 0,
    'exported_at' => <[base.ntime]>,
};

<[base.logs]>->("Exported buffer $amos_id for 9P access");

return 1;

