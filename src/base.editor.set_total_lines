## [:< ##

# name  = base.editor.set_total_lines
# descr = set total lines callback for virtual editor buffer

## [ stub ] register callback for reporting total line count ##

my ($args) = @ARG;

my $buffer_id = $args->{'buffer_id'};
my $callback  = $args->{'callback'};
my $buf       = $data{'editor'}{'buffers'}{$buffer_id};

return undef unless $buf;

$buf->{'total_lines_callback'} = $callback;

return 1;

