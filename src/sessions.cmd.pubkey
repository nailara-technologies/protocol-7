## [:< ##

# name  = sessions.cmd.pubkey
# descr = retrieve the live child's C25519 public key
#         [ separate from status: this is a live round-trip through
#         the attached child, not a zero-cost parent-local read ]

my $pubkey = <[sessions.holder.parent]>->( qw| PUBKEY |, '' );

return { 'mode' => qw| size |, 'data' => "<< pubkey failed >>\n" }
    if not defined $pubkey
    or length($pubkey) != 32;

my $checksum = eval { <[crypt.C25519.key_bin_checksums]>->($pubkey) } // '?';

my $out = sprintf( "pubkey: %s\nchecksum: " . "%s\n",
    encode_b32r($pubkey), $checksum );

return { 'mode' => qw| size |, 'data' => $out };

