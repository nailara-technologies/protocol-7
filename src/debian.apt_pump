## [:< ##

# name  = debian.apt_pump
# descr = start next queued apt install if no install is in flight

## serialization guard : the persistent apt child reads one complete      ##
## 'install ..' line per command - only one job may be in flight, else    ##
## concurrent writes interleave on the child's stdin and corrupt the line ##
## protocol                                                               ##
while ( not defined <debian.apt_child.current_job> ) {

    return if not defined <debian.apt_child.w_fh>;

    return if not exists <jobqueue.joblist.apt-install>;

    my ( $job_id, $job_data )
        = <[jobqueue.get_next_job]>->(qw| apt-install |);
    return if not defined $job_id;

    <[jobqueue.move_job]>->( $job_id, qw| running | );

    <debian.apt_child.current_job> = {
        'job_id'   => $job_id,
        'reply_id' => $job_data->{'callback_params'}->{'reply_id'},
        'packages' => $job_data->{'callback_params'}->{'packages'} // [],
    };

    ## exec callback writes 'install ..' to the child and arms the I/O    ##
    ## watcher ; on immediate failure it clears current_job, so this loop ##
    ## then advances to the next queued job instead of stalling the queue ##
    <[jobqueue.exec_job]>->($job_id);
}

return;

