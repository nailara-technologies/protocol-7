## [:< ##

# name  = jobsite.replica.unsent-load
# descr = restore unsent ui actions at init and arm their resend

my $sref = <[file.zenka_dir.load]>->('replica-unsent.json');
my $list
    = defined $sref ? eval { JSON::XS::decode_json( $sref->$* ) } : undef;
<jobsite.replica.unsent> = ref $list eq 'ARRAY' ? $list : [];
return if not <jobsite.replica.unsent>->@*;

<[base.logs]>->(
    1,
    'jobsite replica: %d unsent ui action%s restored',
    scalar <jobsite.replica.unsent>->@*,
    ( <jobsite.replica.unsent>->@* == 1 ? '' : 's' )
);
<jobsite.replica.forward_timer> //= <[event.add_timer]>->(
    {   'after'   => 5,
        'handler' => qw| jobsite.replica.forward-retry |,
    }
);

