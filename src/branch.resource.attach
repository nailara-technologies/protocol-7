## [:< ##

# name  = branch.resource.attach
# descr = attach typed resource to branch node
# param = { node, type, data, id }
#
# res_id generated from AMOS chksum of node::type::ntime if not given

my $params = shift             // {};
my $node   = $params->{'node'} // '';
my $type   = $params->{'type'} // '';
my $rdata  = $params->{'data'};
my $id     = $params->{'id'} // '';

return { 'mode' => 'false', 'data' => 'node id required' }
    unless length $node;
return { 'mode' => 'false', 'data' => 'type required' }
    unless length $type;
return { 'mode' => 'false', 'data' => 'node not found' }
    unless exists $data{'branch.nodes'}{$node};
return { 'mode' => 'false', 'data' => 'data required' }
    unless defined $rdata;

my $ntime = <[base.ntime]>;

## generate res_id from AMOS chksum of node::type::ntime if not given ##
unless ( length $id ) {
    my $payload   = join( '::', $node, $type, $ntime );
    my $chksum_fn = $code{'chk-sum.amos'} // $code{'base.chk-sum.amos'};
    $id = $chksum_fn->( \$payload );
}

$data{'branch.resources'}{$node}{$type} //= [];
push @{ $data{'branch.resources'}{$node}{$type} },
    {
    'id'          => $id,
    'data'        => $rdata,
    'attached_at' => $ntime,
    };

<[base.logs]>->(
    2, 'branch.resource.attach: %s [%s] -> %s',
    $node, $type, $id
);

return { 'mode' => 'true', 'data' => $id };

