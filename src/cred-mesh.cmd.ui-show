## [:< ##

# name  = cred-mesh.cmd.ui-show
# descr = credential fabric interactive browser dispatch entry
#         args: view name + optional slot name + optional session_id=<id>.
#         views: overview | slots | slot <name> | relays | holder

my $args_str = $call->{'args'} // '';
$args_str =~ s/^\s+|\s+$//g;

## extract explicit session_id override if present [ injected by nshell ] ##
my $session_id = $call->{'session_id'} // '';
if ( $args_str =~ s/\s+session_id=(\d{3,17})$// ) {
    $session_id = $1;
}

my ( $view, @rest ) = split qr|\s+|, $args_str;
$view //= qw| overview |;

## initialize per-session focus on first entry ##
my $ui    = $data{'session'}{$session_id}{'cred-mesh'}{'ui'};
my $focus = $ui->{'focus'};
if ( not defined $focus or ref $focus ne qw| HASH | ) {
    $focus = {
        'view'           => $view,
        'row_index'      => 0,
        'row_count'      => 0,
        'row_keys'       => [],
        'pending_action' => undef,
    };
    $ui->{'focus'} = $focus;
} else {
    $focus->{'view'}           = $view;
    $focus->{'row_index'}      = 0;
    $focus->{'pending_action'} = undef;
}

my $output = '';
my @all_row_keys;

my $caller_level = <[ui.caller.security-level]>;

## helpers to keep restricted-message strings in one place ##
my $render_registry_list = sub {
    return
        <[cred-mesh.ui.render.registry_list]>
        ->( { 'focus_index' => $focus->{'row_index'} } )
        if $caller_level >= 1;
    return {
        'rendered' =>
            "[ restricted — slot list requires security level 1 ]\n",
        'row_keys' => []
    };
};

my $render_registry_detail = sub {
    my $slot_name = shift;
    return
        <[cred-mesh.ui.render.registry_detail]>->( { 'slot' => $slot_name } )
        if $caller_level >= 2;
    return {
        'rendered' =>
            "[ restricted — slot detail requires security level 2 ]\n",
        'row_keys' => []
    };
};

my $render_auth_relay_queue = sub {
    return
        <[cred-mesh.ui.render.auth_relay_queue]>
        ->( { 'focus_index' => $focus->{'row_index'} } );
};

my $render_rotation_log = sub {
    return
        <[cred-mesh.ui.render.rotation_log]>
        ->( { 'focus_index' => $focus->{'row_index'} } );
};

my $render_key_holder_status = sub {
    return <[cred-mesh.ui.render.key_holder_status]>;
};

my $render_overview = sub {
    return <[cred-mesh.ui.render.overview]>;
};

if ( $view eq qw| overview | ) {
    my $result = $render_overview->();
    $output .= $result->{'rendered'};
    push @all_row_keys, @{ $result->{'row_keys'} };

    $output .= "\n" if length $output;

    $result = $render_registry_list->();
    $output .= $result->{'rendered'};
    push @all_row_keys, @{ $result->{'row_keys'} };

    $output .= "\n" if length $output;

    $result = $render_auth_relay_queue->();
    $output .= $result->{'rendered'};
    push @all_row_keys, @{ $result->{'row_keys'} };

} elsif ( $view eq qw| slots | ) {
    my $result = $render_registry_list->();
    $output       = $result->{'rendered'};
    @all_row_keys = @{ $result->{'row_keys'} };

} elsif ( $view eq qw| slot | ) {
    my $slot_name = join ' ', @rest;
    my $result    = $render_registry_detail->($slot_name);
    $output       = $result->{'rendered'};
    @all_row_keys = @{ $result->{'row_keys'} };

} elsif ( $view eq qw| relays | ) {
    my $result = $render_auth_relay_queue->();
    $output .= $result->{'rendered'};
    push @all_row_keys, @{ $result->{'row_keys'} };

    $output .= "\n" if length $output;

    $result = $render_rotation_log->();
    $output .= $result->{'rendered'};
    push @all_row_keys, @{ $result->{'row_keys'} };

} elsif ( $view eq qw| holder | ) {
    my $result = $render_key_holder_status->();
    $output       = $result->{'rendered'};
    @all_row_keys = @{ $result->{'row_keys'} };

} else {
    $output
        = sprintf "[ unknown view '%s' — try: overview | "
        . "slots | slot <name> | relays | holder ]\n",
        $view;
}

## update focus row_count and row_keys from rendered views ##
$focus->{'row_count'} = scalar @all_row_keys;
$focus->{'row_keys'}  = \@all_row_keys;

## clamp row_index to available rows ##
$focus->{'row_index'} = $focus->{'row_count'} - 1
    if $focus->{'row_index'} >= $focus->{'row_count'}
    and $focus->{'row_count'} > 0;
$focus->{'row_index'} = 0 if $focus->{'row_index'} < 0;

## append status line if one is set ##
my $status = $ui->{'status'};
if ( defined $status and length $status ) {
    $output .= "\n" . $status . "\n";
    $ui->{'status'} = undef;
}

## post-render colorisation — keys.console.list pattern adapted ##
if ( length $output
    and ( <system.ansi_color> or <system.force_colors> ) ) {
    my %C = %AMOS7::C;
    no warnings qw| experimental |;

    ## 1. base teal on everything ##
    $output =~ s|^(.+)$|$C{T}$1|mg;

    ## 2. leading colons purple, back to teal ##
    $output =~ s|^( *)(:{1,2})|$1$C{0}$2$C{T}|mg;

    ## 3. trailing dots and colons ##
    $output =~ s|  (\.)$|  $C{b}$C{0}$1$C{T}|mg;
    $output =~ s|  (\:) |  $C{b}$C{0}$1$C{T} |mg;

    ## 4. bracket labels — brackets purple, label teal  [ word ] convention ##
    ## only — spaces inside brackets keep this from matching embedded ansi  ##
    ## escape sequences ( which have no space after the '[' ), unlike a     ##
    ## bare [^\]]+ would                                                    ##
    $output =~ s|(\[ [^\]]+ \])|$C{0}$1$C{T}|mg;

    ## 5. slot names in single quotes — quotes purple, name teal ##
    $output =~ s|'([^']+)'|$C{0}'$C{T}$1$C{0}'$C{T}|mg;

    ## 6. sensitivity high — bold purple ##
    $output =~ s|\b(high)\b|$C{0}$C{b}$1$C{T}|mg;

    ## 7. status words ##
    $output =~ s|\b(running)\b|$C{0}$1$C{T}|mg;
    $output =~ s|\b(not started)\b|$C{0}$1$C{T}|mg;
    $output =~ s|\b(terminated)\b|$C{0}$1$C{T}|mg;
    $output =~ s|\b(pending)\b|$C{0}$1$C{T}|mg;

    ## 8. revoked marker ##
    $output =~ s|(\[revoked\])|$C{0}$1$C{T}|mg;

    ## 9. final reset only at end ##
    $output =~ s|$|$C{R}|mg;
}

return { 'mode' => qw| size |, 'data' => $output };

