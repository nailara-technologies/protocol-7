# name  = graphics-3d.calc.cursor-translucency
# descr = Configurable cursor translucency curve for 3D terminal
#
# Cursor blink cycle: ~1.3 seconds (13/10) for Protocol-7 harmony
# 8×7×13 voxel space → cursor exists at one (x,y,z) position
# Translucency ranges 0.0-1.0 with configurable curve profiles

my $time_elapsed = shift;    # seconds since blink cycle start
my $curve_type   = shift // <graphics-3d.cfg.cursor_curve> // 'sigmoid';

my $cycle_period = 1.3;      # 13/10 seconds (P7 harmonic)
my $phase        = fmod( $time_elapsed, $cycle_period ) / $cycle_period;

## 0.0 = fully translucent (invisible), 1.0 = fully opaque ##
my $translucency;

## === curve profiles === ##
if ( $curve_type eq 'sine' ) {
    ## natural sine wave (smooth harmonic) ##
    $translucency = sin( $phase * τ / 2 );
} elsif ( $curve_type eq 'gaussian_pulse' ) {
    ## gaussian pulse at peak visibility ##
    my $x    = ( $phase - 0.5 ) * 4;        # center at 0.5, spread 4
    my $bell = <[base.calc_gauss]>->($x);
    $translucency = $bell * sqrt(τ);        # normalize to 1.0 at peak
} elsif ( $curve_type eq 'exponential' ) {
    ## exponential decay from peak (radar/ping style) ##
    $translucency = exp( -$phase * 5 ) * ( $phase < 0.2 ? 1 : 0.3 );
} elsif ( $curve_type eq 'quantized' ) {
    ## 13-step discrete levels (P7 quantum effect) ##
    my $steps = 13;
    my $step  = int( $phase * $steps );
    $translucency = $step / ( $steps - 1 );
} elsif ( $curve_type eq 'heartbeat' ) {
    ## double-pulse (heartbeat rhythm: lub-dub) ##
    my $pulse1 = <[base.calc_gauss]>->( ( $phase - 0.25 ) * 8 );
    my $pulse2 = <[base.calc_gauss]>->( ( $phase - 0.45 ) * 8 );
    $translucency = ( $pulse1 + $pulse2 * 0.7 ) * 0.7;
} else {
    ## default: sigmoid S-curve (smooth on/off transition) ##
    my $x = ( $phase - 0.5 ) * 8;    # steepness factor
    $translucency = 1 / ( 1 + exp( -$x ) );
}

## clamp to valid range ##
$translucency = 0.0 if $translucency < 0;
$translucency = 1.0 if $translucency > 1;

## apply minimum visibility floor (never fully invisible in 3D space) ##
$translucency = 0.13 if $translucency < 0.13;

return sprintf( '%.5f', $translucency );

