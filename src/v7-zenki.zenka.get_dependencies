# name   = v7-zenki.zenka.get_dependencies
# descr  = return zenka dependencies of specified zenka
# return = <list_of_zenki> [ as space seperated string ]
# note   = 'dependencies' always count. 'optional_dependencies' count
#          like them where the zenka is not disabled on this host, and
#          are left out where it is [ external : discover is lan
#          multicast, disabled on servers ]

my $zenka_name = shift;

return warn '<get_dependencies> expected zenka name {C1}'
    if not length( $zenka_name // '' );
return undef if not exists <v7-zenki.start_setup.zenki.config>;
my $config = <v7-zenki.start_setup.zenki.config>->{$zenka_name} || {};

my @dependencies = split m|\s+|, $config->{'dependencies'} // '';
push @dependencies, grep { length and not <[zenka.is_disabled]>->($ARG) }
    split m|\s+|, $config->{'optional_dependencies'} // '';
@dependencies = grep {length} @dependencies;

return @dependencies ? join( ' ', @dependencies ) : undef;

