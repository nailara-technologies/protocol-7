## [:< ##

# name = system.process.callback.send_kill

my $process_id  = shift;
my $log_message = shift;

##  $log_message //= " : << killing '$rl_name' process >> [PID=$kill_pid]";

<[base.log]>->( 0, $log_message );

## TERM first, KILL only after a grace period -- matches v7-zenki.          ##
## terminate_process's own pattern : no explicit liveness check before the  ##
## follow-up KILL, kill() is a harmless no-op against an already-dead pid [ ##
## same assumption v7-zenki.handler.process_kill_list already makes ]       ##
<process.TERM_chld.w_fh>->say("TERM $process_id");
delete <process.table.top>->{$process_id};

<[event.add_timer]>->(
    {   'after'   => <mem.oom_kill_grace> // 5,
        'handler' => qw| system.process.handler.kill_grace_expired |,
        'data'    => $process_id
    }
);

