## [:< ##

# name  = models.chat.expand_refs.format_grep
# descr = format matching lines from file content for inline expansion
# param = $path    - file path label
# param = $content - file content string
# param = $pattern - regex pattern to match lines
# return = formatted string with matching lines and count

my ( $path, $content, $pattern ) = @ARG;

return $content if $content =~ m{^\[ERROR:};

my @lines   = split( m{\n}, $content );
my @matches = grep {/$pattern/} @lines;

return sprintf(
    "\n=== GREP '%s': %s ===\n%s\n=== END (%d matches) ===\n",
    $pattern, $path, join( "\n", @matches ),
    scalar(@matches)
);

0;

