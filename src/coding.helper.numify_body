## [:< ##

# name  = coding.helper.numify_body
# descr = sampler fields of a request body as json numbers, in place
# param = $body [ hashref : a chat completions request ]
# note  = config values arrive as perl strings [ '256' ] and encode as json
#         strings : ik_llama accepts them, mainline-based builds [ prismml
#         fork ] answer http 400 'type must be number'. top-level sampler
#         keys only -- messages \ tools \ model stay as they are

my $body = shift;
return $body if ref $body ne qw| HASH |;

my $numeric_key = qr{^(?:max_tokens|n_predict|temperature|top_[pk]|min_p
    |typical_p|seed|n_probs|repeat_\w+|presence_penalty|frequency_penalty
    |dry_\w+|mirostat\w*|xtc_\w+)$}x;

for my $key ( keys %$body ) {
    next if $key !~ $numeric_key;
    my $value = $body->{$key};
    next if !defined $value or ref $value;
    $body->{$key} = 0 + $value
        if $value =~ m{^\s*-?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?\s*$};
}
return $body;

