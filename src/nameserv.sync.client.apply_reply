## [:< ##

# name  = nameserv.sync.client.apply_reply
# descr = process one since \ full reply : verify, apply, compare
# param = $state, $lines_aref -> { result => ok|need-full|false, .. }
#
# WRITER lines are verified first [ nameserv.sync.writer.verify ], every
# ENTRY goes through nameserv.sync.accept -- a rejected entry is skipped
# and logged, never applied. a full fetch applies through the same rules
# and never deletes : a record the peer did not send stays. CHECKSUM
# lines must be signed by a verified writer. after a full fetch a zone
# that still differs is logged once per peer checksum, not refetched.

my $state = shift
    // return { 'result' => qw| false |, 'reason' => 'no state' };
my $lines = shift
    // return { 'result' => qw| false |, 'reason' => 'no reply' };

my ( @entries, %checksums );
my ( $applied, $rejected, $newest ) = ( 0, 0, undef );
my $peer = sprintf '%s:%s', $state->{'host'} // '?', $state->{'port'} // '?';

my $log_reject = sub {
    my $why = shift;
    $rejected++;
    <[base.logs]>->( 1, ': sync : %s : entry rejected [ %s ]', $peer, $why )
        if not <nameserv.sync.rejected_logged>->{"$peer $why"}++;
};

for my $line (@$lines) {
    if ( $line =~ m|^WRITER (\S+) (\S+)$| ) {
        my ( $ok, $why ) = <[nameserv.sync.writer.verify]>->( $1, $2 );
        <[base.logs]>->(
            1, ': sync : %s : writer %s refused [ %s ]',
            $peer, substr( $1, 0, 13 ), $why
            )
            if not $ok
            and not <nameserv.sync.rejected_logged>->{"$peer $1"}++;
    } elsif ( $line =~ m|^ENTRY (\S+) (\S+) (\S+)$| ) {
        my ( $entry, $why ) = <[nameserv.sync.accept]>->( $1, $2, $3 );
        if ( defined $entry ) { push @entries, $entry }
        else                  { $log_reject->($why) }
    } elsif ( $line =~ m|^CHECKSUM (\S+) (\S+) (\S+) (\S+) (\S+)$| ) {
        my ( $zone, $sum, $ts, $sig_b32, $writer ) = ( $1, $2, $3, $4, $5 );
        my $info        = <nameserv.sync.writers>->{$writer};
        my $state_bytes = pack(
            'Z* n/a* ' . 'n/a* n/a*',
            'p7 sync-state v1',
            $zone, $sum, $ts
        );
        my $sig = $sig_b32 ne '-' ? <[base32.decode]>->($sig_b32) : undef;
        if (    ref $info eq qw| HASH |
            and defined $sig
            and length $sig == 64
            and Crypt::Ed25519::verify( $state_bytes, $info->{'pub'}, $sig ) )
        {
            $checksums{$zone} = $sum;
        } else {
            return {
                'result' => qw| false |,
                'reason' => "state line of $zone not "
                    . "signed by a verified writer"
            };
        }
    } elsif ( $line =~ m|^ENTRY | or $line =~ m|^CHECKSUM | ) {
        return { 'result' => qw| false |, 'reason' => 'unsigned reply' };
    } elsif ( $line =~ m|^TRUE (\S+)$| ) {
        $newest = $1;
    } elsif ( $line =~ m|^FALSE (.+)$| ) {
        return { 'result' => qw| false |, 'reason' => $1 };
    }
}

$state->{'checksums'} //= {};
$state->{'checksums'}{$ARG} = $checksums{$ARG} for keys %checksums;

$applied = <[nameserv.sync.apply]>->( undef, \@entries );
if ( $state->{'phase'} eq qw| full | ) {
    my $zone = $state->{'full_zone'} // '';
    $state->{'full_done'}{$zone} = TRUE if length $zone;
}

## the signed state after applying must match the peer's state lines ##
my @mismatched
    = <[nameserv.sync.checksums.verify]>->( $state->{'checksums'} );

## after a full fetch : entries outside our grants keep a zone different -- ##
## logged once per peer checksum, the pull itself succeeds                  ##
my $seen = <nameserv.sync.full_seen> //= {};
for my $zone ( grep { $state->{'full_done'}{$ARG} } @mismatched ) {
    my $peer_sum = $state->{'checksums'}{$zone};
    next if ( $seen->{$peer}{$zone} // '' ) eq $peer_sum;
    $seen->{$peer}{$zone} = $peer_sum;
    <[base.logs]>->(
        1,     ': sync : %s : %s still differs after a full fetch',
        $peer, $zone
    );
}

my @pending = grep {
    not $state->{'full_done'}{$ARG}
        and ( $seen->{$peer}{$ARG} // '' ) ne $state->{'checksums'}{$ARG}
} @mismatched;

return {
    'result'     => qw| need-full |,
    'applied'    => $applied,
    'rejected'   => $rejected,
    'mismatched' => \@pending,
    }
    if @pending;

return {
    'result'   => qw| ok |,
    'applied'  => $applied,
    'rejected' => $rejected,
    'newest'   => $newest,
};

