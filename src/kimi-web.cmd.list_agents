## [:< ##

# name  = kimi-web.cmd.list_agents
# descr = list active kimi-web sub-agents with status and metrics
# param = status - filter by status (optional)

my $args   = $call->{'args'}   // {};
my $filter = $args->{'status'} // '';

my $registry = <kimi-web.agent.registry> // {};
my @agents;

for my $agent_id ( sort keys %$registry ) {
    my $agent = $registry->{$agent_id};

    ## apply filter ##
    next if length $filter and $agent->{'status'} ne $filter;

    ## calculate uptime ##
    my $uptime = <[base.time]>->(3) - $agent->{'started_at'};

    push @agents,
        {
        'agent_id'   => $agent_id,
        'port'       => $agent->{'port'},
        'status'     => $agent->{'status'},
        'uptime_sec' => int($uptime),
        'priority'   => $agent->{'priority'},
        'template'   => $agent->{'template'} // '',
        };
}

return {
    'mode' => qw| true |,
    'data' => { 'agents' => \@agents, 'count' => scalar @agents }
};

