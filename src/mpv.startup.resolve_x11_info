## [:< ##

# name  = mpv.startup.resolve_x11_info
# descr = query X-11 mode/display at startup, skipped for headless
#          audio-only instances [ e.g. mpv[audio-0] used by radio zenka ] ,
#          which never touch a display and don't need to wait on X-11 ..,

my $sub = <system.zenka.subname>;

if ( defined $sub and $sub =~ m|^audio(?:-\d+)?$| ) {
    <[base.logs]>->(
        2, '[startup] audio mode [%s] — skipping X-11 mode/display query',
        $sub
    );
} else {
    <[base.X-11.get_mode]>;
    <[base.X-11.get_display]>;
}

