# name = models.cmd.consensus_vote
# descr = command wrapper for consensus voting from participants

my $params = {};

if ( defined $call->{'param'} && ref $call->{'param'} eq qw| HASH | ) {
    $params = $call->{'param'};
} elsif ( defined $call->{'args'} && length $call->{'args'} ) {
    eval { $params = JSON::PP::decode_json( $call->{'args'} ); };
    if ($@) {
        $params = <[format.yaml.load_str]>->( $call->{'args'} ) // {};
    }
}

my $result = <[models.conversation.consensus_vote]>->($params);

my $yaml_data = YAML::XS::Dump($result);
return {
    'mode' => 'size',
    'data' => $yaml_data
};

