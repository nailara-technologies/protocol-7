## [:< ##

# name  = jobsite.handler.fetch-done
# descr = receive site-yaml.import reply, dispatch assessments when all done

my $call = shift // {};

## TRUE \ FALSE replies carry no mode \ data [ base.reply.mode_text ] ##
my ( $mode, $data_str ) = <[base.reply.mode_text]>->($call);
my $category = $call->{'params'}{'category'} // '';

chomp($data_str);    ## strip trailing \n ##

if ( lc($mode) eq qw| false | ) {
    <[base.logs]>->(
        0,         ':. %s ::: import ' . 'failed : %s',
        $category, $data_str
    );
} else {
    <[base.logs]>->( 1, ':. %s .: %s', $data_str, $category );
}

## the cycle's import outcome for jobsite.status [ a fetch host gone fails ##
## every category, the cycle itself still looks normal ]                   ##
<jobsite.fetch_cycle> //= { 'replies' => 0, 'failed' => 0 };
<jobsite.fetch_cycle>->{'replies'}++;
if ( lc($mode) eq qw| false | ) {
    <jobsite.fetch_cycle>->{'failed'}++;
    <jobsite.fetch_cycle>->{'why'} = $data_str;
}

## accumulate total items queued in site-yaml across all category replies ##
if ( lc($mode) ne qw| false | ) {
    my ($n_new) = $data_str =~ m|(\d+) new|;
    <jobsite.fetch_total_queued> //= 0;
    <jobsite.fetch_total_queued> += ( $n_new // 0 );
}

## decrement fetch counter : only proceed when all categories replied
<jobsite.fetch_pending> //= 1;
<jobsite.fetch_pending>--;

return if <jobsite.fetch_pending> > 0;

<jobsite.last_fetch> = delete <jobsite.fetch_cycle>;
<jobsite.last_fetch>->{'at'} = time;

my $total_queued = delete <jobsite.fetch_total_queued> // 0;

if ( $total_queued > 0 ) {

    ## remember that we queued items so a later zero-depth reply means ##
    ## drained                                                         ##
    <jobsite.fetch_saw_queue> = TRUE;

    ## site-yaml is still async-fetching job details : poll until drained ##
    <[base.logs]>->(
        1, ':. %d items queued in site-yaml, polling for drain .,',
        $total_queued
    );

    if ( defined <jobsite.queue_poll_timer> ) {
        <jobsite.queue_poll_timer>->cancel;
        <jobsite.queue_poll_timer> = undef;
    }

    <jobsite.queue_poll_timer> = <[event.add_timer]>->(
        {   after    => 3,
            repeat   => TRUE,
            interval => 3,
            handler  => qw| jobsite.handler.queue-poll |,
        }
    );
    return;
}

## nothing queued : check for any pre-existing strays and assess ##
<[base.logs]>->( 1, ':. nothing new queued, checking strays .,' );
<[jobsite.stray.check]>;

## reset sync watermark so the next push sends the full jobsite state ; ##
## this catches jobs whose last_modified is older than the current      ##
## watermark (e.g. after a restart or a cache rebuild on the web side)  ##
for my $url ( keys %{ <jobsite.sync.last_ntime> // {} } ) {
    <jobsite.sync.last_ntime>->{$url} = '';
}
<jobsite.sync.last_server_ntime> = '';

<[jobsite.dispatch.assessments]>;

## if no assessments were queued, push changes immediately so the web cache ##
## catches up with whatever the scan produced/changed                       ##
if ( <jobsite.pending_count> == 0 ) {
    <[jobsite.sync.push]>->( undef, FALSE );
}

