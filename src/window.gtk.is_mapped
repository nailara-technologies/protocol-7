## [:< ##

# name  = window.gtk.is_mapped
# descr = TRUE if GTK window widget is mapped to display
# param = $gtk_window_widget

my $window = shift;
return FALSE unless defined $window;
return $window->get_mapped ? TRUE : FALSE;

