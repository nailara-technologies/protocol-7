## [:< ##

# name  = v7-zenki.zenka.cmd.clear-manual
# param = [zenka-name(s)]
# descr = clear "manually stopped" status for zenki

my $clear_zenki = $call->{'args'} // '';

<v7-zenki.zenka.manually_stopped> //= {};
return {
    'mode' => qw| false |,
    'data' => "no zenki have 'manually stopped' status"
    }
    if !keys( <v7-zenki.zenka.manually_stopped>->%* );

my $cleared_count = 0;

if ( !length($clear_zenki) ) {
    $cleared_count = scalar keys( <v7-zenki.zenka.manually_stopped>->%* );
    <v7-zenki.zenka.manually_stopped> = {};
} else {
    map {
        return {
            'mode' => qw| false |,
            'data' =>
                "no 'manually stopped' status exits for '$ARG', aborted!"
            }
            if not exists <v7-zenki.zenka.manually_stopped>->{$ARG}
    } split m| +|, $clear_zenki;

    map {
        $cleared_count++ if delete <v7-zenki.zenka.manually_stopped>->{$ARG}
        }
        split m| +|, $clear_zenki;
}

my $s = $cleared_count > 1 ? qw| i | : qw| a |;

return {
    'mode' => qw| true |,
    'data' => "'manually stopped' status cleared ( $cleared_count zenk$s )"
    }

