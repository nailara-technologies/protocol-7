# name = data.init_holographic.generate_field_line
# descr = Generate magnetic field line points

my ( $from, $to, $intent ) = @ARG;

my @points;
my $steps = 10;

for my $i ( 0 .. $steps ) {
    my $t = $i / $steps;
    push @points,
        [
        $from->[0] + ( $to->[0] - $from->[0] ) * $t,
        $from->[1] + ( $to->[1] - $from->[1] ) * $t,
        $from->[2] + ( $to->[2] - $from->[2] ) * $t,
        ];
}

return \@points;

