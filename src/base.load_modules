## [:< ##

# name    = base.load_modules
# descr   = load a given set of modules

## prepare known exclusion patterns ##
my $exclude_regex = <regex.base.backup_files>
    // qr{(?<![^\w/])(DEADJOE|.+~)$};    ## editor backup files ##

my @modules_to_load                      ## filter is for excluded files ##
    = grep { $ARG !~ $exclude_regex } split( m| +|, join( ' ', @ARG ) );

my %seen;                                ## uniq implementation ##
my $num_elements   = scalar @modules_to_load;
my @unique_modules = grep { !$seen{$ARG}++ } @modules_to_load;

my $delta_mod = $num_elements - scalar @unique_modules;
if ( $delta_mod > 0 ) {
    <[base.s_warn]>->(
        "%d redundant module name%s submitted\n",
        $delta_mod, ( $delta_mod == 1 ? '' : 's' )
    );
    ## filtered against redundancy ###
    @modules_to_load = @unique_modules;

} elsif ( @modules_to_load == 0 ) {
    warn 'expected module name[s] <{C1}>';
    return ( 0, 0 ) if wantarray;
    return FALSE;
}

## auto-create system user if required ##
my $zenka_user = <system.amos-zenka-user> // qw| protocol-7 |;
if ( $EUID == 0 and not defined getpwnam($zenka_user) ) {

    # :note: logging will autoload Event.pm [ as user checked ]
    <[base.log]>->( 1, ": . . triggered in load_modules . ." );
    <[base.root.check_system_user]>->($zenka_user);
}

<[base.register_src_deps]>->(@modules_to_load);

my ( $subs_ok, $subs_failed ) = <[base.load_code]>->(@modules_to_load);

## namespace marked loaded only after compilation completes -- marking it   ##
## earlier let base.mod.exists report a namespace "loaded" while its own    ##
## subs were still mid-compile, racing self-referential calls made by other ##
## modules in the same namespace during their own load [ e.g. p7-log        ##
## logging via base.buffer.add_line before p7-log.buffer.local_logfile_     ##
## write itself had compiled ]                                              ##
<[base.register_p7_mod_load]>->(@modules_to_load);

## plugin.* names listed in modules.load [ storage, universal ] must land  ##
## in the same registry base.load_plugins fills : 'reload source' skips    ##
## plugin.* by design and 'reload plugins' only walks <plugins.status>, so ##
## without this no reload ever recompiled them [ while both reported       ##
## success ]                                                               ##
map { <plugins.status>->{$ARG} //= {} }
    grep {m|^plugin\.|} @modules_to_load;

if ( not defined $subs_ok or $subs_ok == 0 ) {
    <[base.log]>->( 0, '[base.load_modules] no routines were loaded ..,' );
}

return ( $subs_ok, $subs_failed ) if wantarray;

return TRUE if not $subs_failed and $subs_ok;

return FALSE;

