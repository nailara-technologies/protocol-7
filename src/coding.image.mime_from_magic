# name  = coding.image.mime_from_magic
# descr = identify image mime type from magic bytes
# param = $raw [ first bytes of a file as a string ]
# return = $mime [ e.g. image/png, image/jpeg, ... ] or '' for unknown

my $raw = shift // '';

my $mime
    = $raw =~ m|^\x89PNG|                   ? qw| image/png |
    : $raw =~ m|^\xFF\xD8\xFF|              ? qw| image/jpeg |
    : $raw =~ m|^GIF8[79]a|                 ? qw| image/gif |
    : $raw =~ m|^RIFF.{4}WEBP|s             ? qw| image/webp |
    : $raw =~ m{^(?:MM\x00\x2a|II\x2a\x00)} ? qw| image/tiff |
    : $raw =~ m|^BM|                        ? qw| image/bmp |
    :                                         '';

return $mime;

