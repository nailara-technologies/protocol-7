# name  = httpd.classify.cmd.reload-patterns
# descr = reload the YAML pattern library, keep per-peer state
# note  : named ..cmd.reload-patterns [ not ..cmd.reload ] on purpose :
#         bare-name auto-registration would collide with and overwrite
#         base.cmd.reload in the zenka command dispatch table.
#         registered as 'classify.reload' by httpd.classify.init

return {
    'mode' => qw| false |,
    'data' => 'httpd classification not enabled [ httpd.classify.enabled ]'
    }
    if not exists $data{'httpd'}{'classify'};

return {
    'mode' => qw| false |,
    'data' => 'httpd.classify.load not loaded'
    }
    if not exists $code{'httpd.classify.load'};

my $library = <[httpd.classify.load]>;

my $family_count  = scalar keys %{ $library // {} };
my $pattern_count = 0;
map { $pattern_count += scalar @{ $ARG->{'patterns'} // [] } }
    values %{ $library // {} };

return {
    'mode' => qw| true |,
    'data' => sprintf(
        "pattern library reloaded : %d families , %d patterns\n"
            . 'per-peer state untouched',
        $family_count, $pattern_count
    )
};

