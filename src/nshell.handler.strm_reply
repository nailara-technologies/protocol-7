## [:< ##

# name  = nshell.handler.strm_reply
# descr = handle STRM protocol replies: open, chunk, close lifecycle

my $reply = shift // return FALSE;

return FALSE unless defined $reply;

my $cmd    = $reply->{'cmd'}                       // '';
my $args   = $reply->{'call_args'}->{'args'}       // '';
my $cmd_id = $reply->{'call_args'}->{'command_id'} // 0;

return FALSE unless $cmd =~ m|^STRM\b|;

## get or initialise nshell stream state
my $nshell_streams = <nshell.streams> //= {};

## right-align a structural status line [ round/state markers, stream open  ##
## lifecycle ] so only the actual model-output payload stays left- heavy in ##
## the content area -- visible-length-aware [ counts the plain text, not    ##
## the ansi bytes wrapped around it ], reserves one column same as this     ##
## renderer's other pending-wrap guards. violet [ p7_fg_0000 ], restoring   ##
## the ambient payload blue [ p7_fg_0004 ] afterward rather than leaving a  ##
## bare reset -- see the chunk branch below for why that matters            ##
my $right_align_status = sub {
    my $visible_text = shift // '';
    my ($term_w) = AMOS7::TERM::terminal_size();
    $term_w ||= 80;
    my $pad = ( $term_w - 1 ) - length($visible_text);
    $pad = 0 if $pad < 0;
    return
          ( ' ' x $pad )
        . $colors{'p7_fg_0000'}
        . $visible_text
        . $colors{'reset'}
        . $colors{'p7_fg_0004'};
};

## set once a stream genuinely opens below -- triggers a viewport redraw at ##
## the end of this handler so the split-mode status bar picks up the bound  ##
## task id [ nshell.render.viewport reads it fresh from the mode object ]   ##
## the moment streaming actually starts, rather than waiting for the user's ##
## next keystroke to redraw it incidentally                                 ##
my $stream_opened = FALSE;

if ( $args eq qw| open | ) {
    ## STRM open: unbounded
    $nshell_streams->{$cmd_id} = {
        'type'           => qw| STRM |,
        'total_bytes'    => undef,
        'received_bytes' => 0,
        'started_at'     => <[base.ntime]>,
    };

    <[base.logs]>->( 2, '[nshell] STRM open :. unbounded' );

    ## brief status line on TTY
    if ( -t STDOUT ) {
        <[nshell.render.content_print]>->(
            "\r" . $right_align_status->('[ stream started ]') . "\e[K\n" );
    }
    $stream_opened = TRUE;

} elsif ( $args =~ m|^open\s+(\d+)$| ) {
    ## STRM open: bounded
    my $total_bytes = $1;

    $nshell_streams->{$cmd_id} = {
        'type'           => qw| STRM |,
        'total_bytes'    => $total_bytes,
        'received_bytes' => 0,
        'started_at'     => <[base.ntime]>,
    };

    <[base.logs]>->( 2, '[nshell] STRM open :. %d bytes', $total_bytes );

    ## brief status line on TTY
    if ( -t STDOUT ) {
        <[nshell.render.content_print]>->(
            "\r"
                . $right_align_status->(
                sprintf "[ stream started :: %d bytes ]", $total_bytes
                )
                . "\e[K\n"
        );
    }
    $stream_opened = TRUE;

} elsif ( $args =~ m|^(\d+)$| ) {
    ## STRM chunk: write raw bytes directly to STDOUT
    my $chunk_data = $reply->{'data'} // '';

    if ( defined $nshell_streams->{$cmd_id} ) {
        $nshell_streams->{$cmd_id}{'received_bytes'}
            += bytes::length($chunk_data);
    }

    ## coding.async.state_machine's round/state-transition marker lines --  ##
    ## restyled client-side rather than baking ansi/unicode into the        ##
    ## backend's own stream : that stream is meant to stay typer-agnostic [ ##
    ## same descriptor, future web/gtk3 typers per this task's own design   ##
    ## goal ], terminal presentation belongs here in nshell, not in         ##
    ## coding.async.state_machine. distinct violet [ p7_fg_0000 ] instead   ##
    ## of the plain blue actual model-output payload prints in, so status   ##
    ## markers read as structural rather than as generated content, plus    ##
    ## unicode double-brackets instead of literal '[[ ]]'. utf8::encode     ##
    ## ONLY when this substitution actually fires -- ordinary model-output  ##
    ## chunks may already carry real UTF-8 bytes [ e.g. emoji ] as a plain  ##
    ## byte string with no wide-char flag, and encoding those               ##
    ## unconditionally would double-encode them into mojibake ; the marker  ##
    ## text itself is always pure-ASCII sprintf output before this          ##
    ## substitution runs, so it's safe to encode only in that one           ##
    ## known-controlled case. reset is followed by re-applying the ambient  ##
    ## payload color [ p7_fg_0004 ], NOT left bare -- nshell.init_code sets ##
    ## that color ONCE at startup and nothing re-sends it per chunk, so     ##
    ## payload text has always relied on the terminal's persistent SGR      ##
    ## state rather than carrying its own color code. a bare reset with     ##
    ## nothing after it drops that state to the terminal's own undecorated  ##
    ## default, so every chunk printed after this marker [ live AND on a    ##
    ## later buffer replay ] loses its color -- confirmed live 2026-09-14 : ##
    ## "the payload is suddenly unstyled gray" after a round marker fired.  ##
    ## right-aligned via the same $right_align_status helper the stream-    ##
    ## open lines above use -- covers tool-call transitions too [ the event ##
    ## name in "round N : $from --$event--> $to" is e.g. 'tool_call' ], so  ##
    ## every structural/status line pushes right while the payload itself   ##
    ## stays left-heavy                                                     ##
    if ($chunk_data =~ s{\[\[ (round \d+ : .+?) \]\]}
                         {$right_align_status->("⟦ $1 ⟧")}e
    ) {
        utf8::encode($chunk_data);
    }

    <[nshell.render.content_print]>->($chunk_data);

} elsif ( $args eq qw| close | ) {
    ## STRM close: clean up and reprint prompt
    if ( defined $nshell_streams->{$cmd_id} ) {
        my $stream = $nshell_streams->{$cmd_id};

        <[base.logs]>->(
            2,
            '[nshell] STRM closed :. %d bytes%s',
            $stream->{'received_bytes'},
            defined $stream->{'total_bytes'}
            ? sprintf( ' / %d', $stream->{'total_bytes'} )
            : ' [ unbounded ]'
        );

        delete $nshell_streams->{$cmd_id};
    }

    ## reprint cursor prompt in TTY mode
    if ( -t STDOUT ) {
        my ($session_id) = keys <user.cube.session>->%*;
        if (    defined $session_id
            and defined $data{'session'}{$session_id} ) {
            my $session = $data{'session'}{$session_id};
            if ( defined $session->{'watcher'}{'stdin_handler'} ) {
                $session->{'watcher'}{'stdin_handler'}->now();
            }
        }
    }

} else {
    <[base.logs]>->( 1, '[nshell] STRM bad args :. %s', $args );
    return FALSE;
}

## redraw the input line [ + status bar, in split mode ] now that a stream ##
## has actually opened -- content_print above only touches the content     ##
## area, it never redraws the pinned input row/separator itself            ##
if ($stream_opened) {
    my $state_ref = <nshell.state> // {};
    if ( $state_ref->{'split_active'} ) {
        <[nshell.render.viewport]>->( $state_ref->{'editor'}, \%colors );
    }
}

return TRUE;

