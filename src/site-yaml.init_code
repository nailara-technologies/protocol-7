## [:< ##

# name  = site-yaml.init_code
# descr = initialize site-yaml zenka, load http client

map { <[base.perlmod.autoload]>->($ARG) }
    qw| LWP::UserAgent HTTP::Request JSON YAML::XS HTML::Entities Socket Fcntl POSIX Errno |;

## http user agent : reused across requests
<site-yaml.ua> = LWP::UserAgent->new(
    'agent' => 'Mozilla/5.0 (X11; Linux x86_64; '
        . 'rv:124.0) Gecko/20100101 Firefox/124.0',
    'timeout' => 30,
);
<site-yaml.ua>
    ->default_header( 'Accept-Language' => 'de-DE,de;q=0.9,en;q=0.8' );
<site-yaml.ua>
    ->default_header( 'Accept' => 'text/html,application/xhtml+xml' );

## enable proxy from environment variables (HTTP_PROXY / HTTPS_PROXY) ##
<site-yaml.ua>->env_proxy;

## bypass proxy for known direct-access domains [ configurable, default ##
## false ]                                                              ##
if ( <[base.cfg_bool]>->( <site-yaml.bypass_proxy> // FALSE ) ) {
    <site-yaml.ua>->no_proxy(qw| stepstone.de www.stepstone.de |);
}

## async fetch worker defaults ##
<site-yaml.cfg.fetch_worker_timeout> //= 45;    ## per-fetch kill deadline ##
<site-yaml.fetch_worker>             //= {};

## init fetch queue state ##
<[site-yaml.fetch.state]>->('load');

## drop stale queue entries from before the generic fetch refactor (they ##
## lack a reply_handler and would be silently discarded anyway)          ##
my $queue = <site-yaml.fetch_queue> // [];
if ( @{$queue} ) {
    my $stale = scalar grep { not length( $ARG->{'reply_handler'} // '' ) }
        @{$queue};
    if ( $stale == @{$queue} ) {
        <[base.logs]>->(
            1,
            'site-yaml: dropping %d stale fetch-queue entries',
            scalar @{$queue}
        );
        <site-yaml.fetch_queue> = [];
        <[site-yaml.fetch.state]>->('save');
    }
}

<[base.logs]>->( 1, 'site-yaml ready' );

