## [:< ##

# name  = kimi.cmd.approvals
# descr = list pending tool call approval requests

my @pending = sort keys <kimi.approval.pending>->%*;

if ( not @pending ) {
    return { 'mode' => qw| false |, 'data' => 'no pending approvals' };
}

my $output = '';
foreach my $rid (@pending) {
    my $p = <kimi.approval.pending>->{$rid};
    $output .= sprintf "%s  %s  %s\n",
        $rid,
        $p->{'action'}      // '?',
        $p->{'description'} // '';
}

return { 'mode' => qw| data |, 'data' => $output };

