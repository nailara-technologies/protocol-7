## [:< ##

# name = branch.session.round.checksum
# descr = bmw384(prev_hash + round_content)

my $prev_checksum = shift // '';
my $round_content = shift // '';

return warn 'previous checksum required <{C1}>'
    if not length $prev_checksum;
return warn 'round content required <{C1}>'
    if not length $round_content;

my $bmw = Digest::BMW->new(384);
$bmw->add( $prev_checksum . $round_content );

return encode_b32r( $bmw->digest );

