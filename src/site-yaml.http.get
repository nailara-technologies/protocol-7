## [:< ##

# name  = site-yaml.http.get
# descr = fetch URL, return html string or undef on error

my $url = $ARG[0] // '';
return undef if not length $url;

my $ua  = <site-yaml.ua>;
my $res = $ua->get($url);

if ( not $res->is_success ) {
    my $code  = $res->code;
    my $level = ( $code == 410 or $code == 404 ) ? 2 : 0;
    <[base.logs]>->(
        $level, 'site-yaml.http.get : %s => %s',
        $url,   $res->status_line
    );
    return $code;
}

return $res->decoded_content;

