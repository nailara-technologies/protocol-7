## [:< ##

# name  = external.init_code
# descr = initialize generic transport registry for external plugins

my $reinit = shift // TRUE;   ### provided by 'base.init_modules' [TRUE|FALSE]

## link supervisor knobs [ the ssh zenka's numbers as defaults,          ##
## LINK-ZENKI-AND-TRANSPORTS.md 'liveness, reconnect, failure classes' ] ##
<link.cfg.heartbeat_interval>  //= 4.7;
<link.cfg.timeout>             //= 10;
<link.cfg.backoff_initial>     //= 0.5;
<link.cfg.backoff_max>         //= 30;
<link.cfg.jitter>              //= 0.5;
<link.cfg.ssh_connect_timeout> //= 10;
<link.cfg.ssh_alive_interval>  //= 30;
<link.cfg.ssh_alive_count>     //= 3;

## transport registry - populated by plugin.external.* modules ##
<external.transports> = {

    ## available transport types ##
    'available' => [],

    ## preference order (highest first) ##
    'preferred' => undef,

    ## transport metadata ##
    'registry' => {},

    ## active connections ##
    'connections' => {},

    ## statistics ##
    'stats' => {
        'bytes_sent'       => 0,
        'bytes_received'   => 0,
        'connections_ok'   => 0,
        'connections_fail' => 0,
    },
};

## protocol bridge registry ##
<external.bridges> = {
    'available' => [],
    'active'    => {},
};

<[base.logs]>->( 2, ':. external.init_code: transport registry initialized' );

## active orbital connections registry ##
<external.connections> //= {};

## named links [ supervised host records + by-hand external.connect ] ##
<external.links> //= {};

## 'external.list links' : every named link, its state and last error ##
## [ by-hand links carry no state : shown as 'by-hand' ]              ##
<list.links> = {
    'var'      => qw| data |,
    'key'      => qw| external.links |,
    'sort_key' => 'alpha:key',
    'descr'    => 'named links to other hosts [ supervised + by hand ]',
    'mask'     => '<key>:link state:state transport:via sid:session '
        . 'since:up_for attempts:retries last_rtt:rtt '
        . 'fail_why:last_error',
    'defaults' => { 'state' => qw| by-hand | },
    'align'    => {
        'link'      => qw| center |,
        'state'     => qw| center |,
        'transport' => qw| center |,
        'sid'       => qw| center |,
        'since'     => qw| right  |,
        'attempts'  => qw| center |,
        'last_rtt'  => qw| center |,
        'fail_why'  => qw| left   |,
    },
    'filters' => { 'since' => qw| base.parser.duration | }
};

<[base.list.init]>->(
    {   'name'         => qw| links |,
        'key_ref'      => \<external.links>,
        'max_elements' => 247
    }
);

## 'external.list orbital' : the orbital connections, as list-connections ##
<list.orbital> = {
    'var'      => qw| data |,
    'key'      => qw| external.connections |,
    'sort_key' => 'alpha:key',
    'descr'    => 'orbital connections',
    'mask'     => '<key>:name p7ref:p7ref ip:ip status:status',
    'align'    => {
        'name'   => qw| center |,
        'p7ref'  => qw| center |,
        'ip'     => qw| center |,
        'status' => qw| center |,
    },
};

<[base.list.init]>->(
    {   'name'         => qw| orbital |,
        'key_ref'      => \<external.connections>,
        'max_elements' => 247
    }
);

## auto-connect configuration ##
<external.cfg.auto_connect> //= 0;

## orbital STRM push : disable in zenki/external/zenka.v7 when required ##
<external.cfg.orbital_push_enabled> //= TRUE;

## schedule auto-connections to strongest neighbours on startup ##
if ( <external.cfg.auto_connect> > 0 ) {
    my $known     = <discover.orbital.known>      // {};
    my $own_p7ref = <nodes.orbital.current_p7ref> // '';

    my @sorted
        = sort { $known->{$b}->{'timestamp'} <=> $known->{$a}->{'timestamp'} }
        keys %$known;

    my $n
        = scalar @sorted < <external.cfg.auto_connect>
        ? scalar @sorted
        : <external.cfg.auto_connect>;

    my $scheduled = 0;
    foreach my $id (@sorted) {
        last if $scheduled >= $n;
        my $entry = $known->{$id};
        my $p7ref = $entry->{'p7ref'} // '';
        next if not length $p7ref;
        next if $p7ref eq $own_p7ref;

        $scheduled++;
        <[event.add_timer]>->(
            {   'after'   => 13,
                'handler' => 'external.cmd.connect-orbital',
                'data'    => { 'args' => $p7ref }
            }
        );
    }
}

return TRUE if not $reinit;

## a reload runs unprivileged [ init_code ran before [root.drop_privs] at ##
## boot, so the supervisor is invoked from zenka.v7 after the drop ]      ##
<[link.supervisor.start]>;

return TRUE;

