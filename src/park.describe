## [:< ##

# name   = park.describe
# descr  = what a park record waits for, one line
# args   = park record
# return = text

my $r = shift // return '-';
my @w;
push @w, "time $r->{'at'}"     if defined $r->{'at'};
push @w, "after $r->{'after'}" if defined $r->{'after'};
push @w, "signal $r->{'on'}" . join '',
    map {" $ARG=$r->{$ARG}"} grep {m{\Amatch\.}} sort keys %{$r}
    if defined $r->{'on'};
push @w, "depends $r->{'depends'}" if length( $r->{'depends'} // '' );
push @w, "budget $r->{'budget'}"   if length( $r->{'budget'}  // '' );
my $text = join ' ; ', @w;
$text .= "  # $r->{'reason'}" if length( $r->{'reason'} // '' );
return $text;

