## [:< ##

# name   = coding.sign_queue.prune
# descr  = keep the 13 newest committed entries and plans

my $all = <[coding.sign_queue.store]>;
foreach my $kind (qw| entry plan |) {
    my @done = sort {
        ( $all->{$kind}{$b}{'done'} // 0 )
            <=> ( $all->{$kind}{$a}{'done'} // 0 )
        }
        grep { $all->{$kind}{$ARG}{'status'} eq qw| committed | }
        keys %{ $all->{$kind} };
    delete $all->{$kind}{$ARG} foreach @done[ 13 .. $#done ];
}
return TRUE;

