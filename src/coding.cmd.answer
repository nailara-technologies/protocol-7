## [:< ##

# name  = coding.cmd.answer
# param = <id> <text>
# descr = answer an open decision : decision.answered
#
# the menu removes the question and raises the signal [ the one raise
# point for this command and the menu dialog ]

my ( $id, $text ) = ( $call->{'args'} // '' ) =~ m|\A\s*(\S*)\s*(.*?)\s*\z|s;
return { 'mode' => qw| false |, 'data' => 'decision id required' }
    if $id !~ m|\A[\w-]{1,40}\z|;
return { 'mode' => qw| false |, 'data' => 'answer text required' }
    if $text !~ m|\S|;
return <[coding.decision.send]>->(
    qw| pending-question-answer |,
    "$id $text", $call->{'reply_id'}, qw| answer |
);

