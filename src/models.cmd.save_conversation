# name = models.cmd.save_conversation
# descr = save conversation to persistent storage

my $params = {};

if ( defined $call->{'param'} && ref $call->{'param'} eq qw| HASH | ) {
    $params = $call->{'param'};
} elsif ( defined $call->{'args'} && length $call->{'args'} ) {
    eval { $params = JSON::PP::decode_json( $call->{'args'} ); };
    if ($EVAL_ERROR) {
        eval { $params = YAML::XS::Load( $call->{'args'} ); };
    }
    $params = {} if $EVAL_ERROR;
}

my $job_id   = $params->{'job_id'}   // '';
my $filename = $params->{'filename'} // '';

if ( !length($job_id) ) {
    return {
        'mode' => 'false',
        'data' => "error: job_id required\n"
    };
}

my $result = <[models.conversation.save]>->(
    {   'job_id'   => $job_id,
        'filename' => $filename,
    }
);

my $yaml_data = YAML::XS::Dump($result);
return {
    'mode' => 'size',
    'data' => $yaml_data
};

