## [:< ##

# name   = invoke-web.output.path
# descr  = invoke.ai's output transport file [ runtime dir of the zenka ]
# return = path | undef [ no runtime dir ]

my $run_dir = <invoke-web.run_dir> // <[base.file.zenka_dir.run_path]>;
return undef if not defined $run_dir or not -d $run_dir;
return "$run_dir/invokeai.out";

