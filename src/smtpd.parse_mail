## [:< ##

# name  = smtpd.parse_mail
# descr = parse raw RFC 2822 mail into structured hash
# param = $raw_mail_bytes
# return = $parsed_hash or undef

my $raw = shift // '';
return undef if not length $raw;

## try Email::MIME first ##
if (<smtpd.has_email_mime>) {
    my $parsed = eval { <[smtpd.parse_mail.mime]>->($raw) };
    return $parsed if defined $parsed;
    <[base.logs]>->( 0, 'smtpd: Email::MIME parse failed, trying fallback' );
}

## fallback to simple parser ##
return <[smtpd.parse_mail.fallback]>->($raw);

