## [:< ##

# name  = claude.turn.done
# descr = a turn ended : cost, signal, the next turn
# args  = result event hash [ or { failed => reason } ]

my $d = shift // {};
my $state
    = (     not $d->{'failed'}
        and ( $d->{'subtype'} // '' ) eq qw| success |
        and not $d->{'is_error'} )
    ? qw| ok |
    : qw| failed |;
<claude.cost> = $d->{'total_cost_usd'} + 0
    if ( $d->{'total_cost_usd'} // '' ) =~ m{\A[\d.eE+-]+\z};
<[claude.session.hold]>->( qw| renew |, <claude.session> )
    if <[claude.session.running]>;
my $was = <claude.turn_active>;
<claude.turn_active> = FALSE;
<claude.last_result> = {
    'state'   => $state,
    'subtype' => $d->{'subtype'} // $d->{'failed'} // '',
    'turn'    => <claude.turn>,
    'ended'   => time
};

<[claude.signal.done]>->(
    {   'state'   => $state,
        'session' => <claude.session> // '-',
        'turn'    => <claude.turn>,
        'cost'    => sprintf( '%.4f', <claude.cost> // 0 ),
        ( $d->{'failed'} ? ( 'reason' => $d->{'failed'} ) : () )
    }
    )
    if $was
    or not $d->{'failed'};

<[base.zenki.resume_ondemand_timeout]>
    if defined $code{'base.zenki.resume_ondemand_timeout'};
<[claude.turn.next]>;

