## [:< ##

# name  = nameserv.consistency.host-name
# descr = this host's own name [ for the ptr expectation ]

require Sys::Hostname;    ## not imported into a zenka ##

my $name = lc( Sys::Hostname::hostname() // '' );
$name =~ s|\.+$||;
return $name;

