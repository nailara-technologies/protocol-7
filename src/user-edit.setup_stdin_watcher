## [:< ##

# name  = user-edit.setup_stdin_watcher
# descr = register STDIN and the form-redraw variable watcher

## the two halves of the event-driven form, registered together because they
## are the same mechanism seen from both ends :
##
##   event.add_io   on fd 0        -> keystrokes in
##   event.add_var  on <..dirty>   -> repaint out
##
## keyboard input and network replies must share ONE loop [ a users.* reply
## can update a field out of band, long after the keystroke that asked for it
## ], which is why input is a watcher and not a blocking read.  the variable
## watcher is what connects a write into a field buffer to an actual redraw —
## with input event-driven there is no natural  "re-render after read()
## returns" point left in the flow

## the watched scalar must EXIST before its reference is taken — autovivifying
## it later would leave the watcher on a detached scalar
<user-edit.form.dirty> //= 0;

## prime the cache with current terminal dimensions so the very first paint
## can already apply a vertical viewport. load AMOS7::TERM on demand : it is
## not loaded by user-edit.init_code, but nshell already uses it for the same
## query
<[base.perlmod.load]>->('AMOS7::TERM')
    if not <[base.perlmod.loaded]>->('AMOS7::TERM');

my @init_size = AMOS7::TERM::terminal_size();
<user-edit.form.term_cols> = $init_size[0] // 80;
<user-edit.form.term_rows> = $init_size[1] // 24;

<user-edit.form.watcher.stdin> = <[event.add_io]>->(
    {   qw| fd |      => 0,
        qw| poll |    => qw| r |,
        qw| handler | => qw| user-edit.handler.stdin_key |,
        qw| prio |    => 2,
        qw| repeat |  => TRUE,
        qw| desc |    => 'user-edit STDIN handler',
    }
);

## poll => 'w' : fire when the scalar is WRITTEN [ jobqueue.event.
## register_job_queues' counter-watcher precedent ].  user-edit.form.render
## must never write this scalar itself — watchers are reentrant by default
<user-edit.form.watcher.dirty> = <[event.add_var]>->(
    ## explicit $data{..}, NOT '\<user-edit.form.dirty>' — a leading backslash
    ## is the translator's ESCAPE ((?<!\\)<..>), so that form silently watches
    ## a reference to the literal name string and never fires.  this was a
    ## real bug here, caught by the no-tty driver
    {   qw| var |     => \$data{'user-edit'}{'form'}{'dirty'},
        qw| poll |    => qw| w |,
        qw| handler | => qw| user-edit.form.render |,
        qw| repeat |  => TRUE,
        qw| desc |    => 'user-edit form redraw',
    }
);

## register SIGWINCH handler so terminal resizes update the cached dimensions
## and force a redraw with a recomputed vertical viewport
<[event.add_signal]>->(
    {   qw| signal |  => qw| WINCH |,
        qw| handler | => qw| user-edit.handler.term_resize |,
    }
);

return FALSE
    if not defined <user-edit.form.watcher.stdin>
    or not defined <user-edit.form.watcher.dirty>;

<[base.logs]>->( 2, ': form watchers registered [ stdin + redraw ]' );

return TRUE;

