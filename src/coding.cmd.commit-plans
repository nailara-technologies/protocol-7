## [:< ##

# name  = coding.cmd.commit-plans
# descr = list the commit plans and what each waits for

my $all = <[coding.sign_queue.store]>;
my @ids = sort keys %{ $all->{'plan'} };
return { 'mode' => qw| true |, 'data' => "no commit plans\n" } if not @ids;
return {
    'mode' => qw| true |,
    'data' => join( "\n\n",
        map { <[coding.sign_queue.describe]>->( qw| plan |, $ARG ) } @ids )
        . "\n"
};

