## [:< ##

# name  = sessions.holder.child
# descr = forked entrypoint for the key-holding child. structurally
#         mirrors cred-mesh.key_holder.child, INCLUDING its no-Event.pm
#         discipline in the child. Real bug found live: a forked child
#         inherits the PARENT's entire Event.pm internal state [ its
#         polling fd, existing watchers on the parent's own cube
#         connection, etc ] -- calling Event::loop() in the child saw
#         that inherited state and returned immediately with no signal
#         ever arriving, silently short-circuiting straight to clean
#         shutdown [ confirmed via a direct waitpid/$? capture: the child
#         exited with status 0, not from any signal ]. cred-mesh's child
#         avoids Event.pm entirely for exactly this reason -- this uses
#         only plain %SIG + POSIX::pause(), never Event.pm, matching it.
#         Real C25519/Ed25519 identity key -- NOT crypt.C25519.gen_keys,
#         which internally loops on <[event.once]> [ -> Event::loop() ]
#         for its harmonic-truth-checked key search, the exact same
#         fork+Event.pm hazard above, just one call deeper. Calls the
#         bare Crypt::Ed25519 primitives directly instead.

my $socket_path = shift;

if ( not defined $socket_path ) {
    warn 'sessions.holder.child: expected socket path <{C1}>';
    exit(1);
}

## isolate from whatever the parent's own init left in %SIG state -- the ##
## plain handlers below replace it regardless                            ##
$SIG{ALRM} = qw| IGNORE |;
IO::AIO::reinit();

## load or generate+persist a 32-byte C25519 secret seed -- same storage ##
## shape as the old holder-test.secret [ file.zenka_dir under /var/      ##
## protocol-7/sessions/, structurally separate from keys zenka's own     ##
## ~/.n/user-keys/ -- this is a sessions-OWNED identity, not standing in ##
## for any real user's key ]                                             ##
my $secret_key;
my $secret_ref = <[file.zenka_dir.load]>->('holder-identity.secret');
if ( defined $secret_ref ) {
    my $b32_str = $secret_ref->$* // '';
    chomp $b32_str;
    $secret_key = decode_b32r($b32_str);
} else {
    my $prng = Crypt::PRNG::Fortuna->new();
    $secret_key = $prng->bytes(32);
    my $b32_out = encode_b32r($secret_key);
    <[file.zenka_dir.write]>->(
        'holder-identity.secret', \"$b32_out\n", '>', 0600
    );
}

if ( not defined $secret_key or length($secret_key) != 32 ) {
    warn 'sessions.holder.child: invalid identity secret <{C1}>';
    exit(1);
}

## direct primitive call -- what crypt.C25519.gen_keys does internally, ##
## minus its %keys-hash bookkeeping and its Event.pm-touching loop      ##
my ( $public_key, $private_key )
    = Crypt::Ed25519::generate_keypair($secret_key);

if ( not defined $public_key or not defined $private_key ) {
    warn 'sessions.holder.child: keypair derivation failed <{C1}>';
    exit(1);
}

## mirrors what crypt.C25519.gen_keys does post-derivation, just local  ##
IO::AIO::aio_mlock( $private_key, 0, 64 );
IO::AIO::aio_mlock( $secret_key,  0, 32 );

## plain %SIG handlers, deliberately NOT Event.pm -- see header note.  USR1 ##
## wakes the DORMANT pause() loop; USR2 is corroboration-only [ EOF is what ##
## actually drives the ATTACHED->DORMANT transition ]. a plain blocking     ##
## readline IS safely interrupted [ EINTR ] and retried by Perl's own       ##
## deferred-signal-safety for ordinary %SIG handlers even with no event     ##
## loop running at all -- unlike Event->signal() watchers, which is exactly ##
## why this plain form is the safe one here.                                ##
my $attach_requested = 0;
$SIG{USR1} = sub { $attach_requested = 1; };
$SIG{USR2} = sub {
    <[base.logs]>->( 1, 'sessions.holder.child: detach signal received' );
};

$SIG{TERM} = sub {
    <[base.buffer.erase_secure]>->( \$private_key );
    <[base.buffer.erase_secure]>->( \$secret_key );
    exit(0);
};
$SIG{INT} = $SIG{TERM};

## connect-on-fork: dial out immediately, no signal wait on the FIRST     ##
## connection -- the consumer forked us on purpose and already knows the  ##
## connection is wanted; SIGUSR1 only governs every transition after this ##
## one                                                                    ##
my $sock = <[io.unix.socket.output.open]>->($socket_path);
if ( not $sock ) {
    warn 'sessions.holder.child: initial dial-out failed <{C1}>';
    exit(1);
}
binmode($sock);
$sock->autoflush(1);

## main lifecycle wrapped in eval -- a forked child with no eval has no     ##
## safety net at all: an uncaught die() prints "Died at ... line N" to the  ##
## inherited STDERR [ the controlling terminal, not any p7-log- visible     ##
## buffer ] and the process vanishes with zero trace reachable from the     ##
## console. raw warn() IS visible via console.show-buffer [                 ##
## base.init_zenka.install_signal_handlers wires __WARN__ into the same log ##
## path, inherited at fork time ], but die() bypasses that.                 ##
eval {

## main lifecycle: ATTACHED [ blocking line loop ] <-> DORMANT [           ##
## POSIX::pause(), waiting on plain SIGUSR1 ], the transition into DORMANT ##
## driven by EOF, the transition out driven by SIGUSR1                     ##
    while (1) {

        ## ATTACHED ##
        while ( my $line = <$sock> ) {
            chomp $line;
            next if not length $line;

            my ( $op, $data_b32 ) = split q| |, $line, 2;
            $op       //= '';
            $data_b32 //= '';
            my $data = eval { decode_b32r($data_b32) } // '';

            my $result;
            my $err_msg;
            if ( $op eq qw| SIGN | ) {
                $result = <[sessions.holder.op.sign]>->(
                    $public_key, $private_key, $data
                );
                $err_msg = 'signing failed' if not defined $result;
            } elsif ( $op eq qw| PUBKEY | ) {
                $result = $public_key;    ## pure accessor, no op module ##
            } else {
                $err_msg = "unknown op '$op'";
            }

            if ( defined $result ) {
                print {$sock} sprintf( "OK %s\n", encode_b32r($result) );
            } else {
                $err_msg //= 'operation failed';
                print {$sock} sprintf( "ERR %s\n", $err_msg );
            }
        }

        ## EOF -- parent closed during detach ##
        <[base.logs]>->(
            1, 'sessions.holder.child: detached [EOF], going dormant'
        );
        close($sock);
        undef $sock;

        ## DORMANT -- plain POSIX::pause() loop until SIGUSR1 sets the     ##
        ## flag; pause() returns on ANY signal delivery [ including USR2's ##
        ## harmless corroboration log, ALRM, etc ], so loop until the real ##
        ## flag lands                                                      ##
        $attach_requested = 0;
        POSIX::pause() until $attach_requested;

        ## redial the SAME socket path -- reattach, not a fresh pairing ##
        $sock = <[io.unix.socket.output.open]>->($socket_path);
        if ( not $sock ) {
            warn 'sessions.holder.child: redial failed, exiting <{C1}>';
            last;
        }
        binmode($sock);
        $sock->autoflush(1);

        <[base.logs]>->( 1, 'sessions.holder.child: reattached' );
    }

}; ## end eval ##

warn sprintf( 'sessions.holder.child: fatal: %s <{C1}>', $EVAL_ERROR )
    if length $EVAL_ERROR;

<[base.buffer.erase_secure]>->( \$private_key );
<[base.buffer.erase_secure]>->( \$secret_key );
exit(0);

