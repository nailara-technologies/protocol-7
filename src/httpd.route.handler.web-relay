## [:< ##

# name  = httpd.route.handler.web-relay
# descr = relay HTTP request to web zenka [ route-send STRM ]
# note  = relay HTTP request to web zenka via route-send STRM pattern
#         generic handler : command and args from route config ;
#         auth.required routes check their token through the web zenka's
#         admission gate [ web.auth-bearer : gate + verify + record in
#         one round trip -- a refused source gets 429 \ 401 at once,
#         never queued ; the real socket facts travel in the call,
#         never a header ]

my $id      = shift;
my $args    = shift // {};
my $session = $data{'session'}->{$id};

## route-level auth gating ##
my $auth_exempt = FALSE;
if ( $args->{'auth.required'} ) {
    my $peer_addr = $session->{'http'}->{'request'}->{'client'}->{'addr'}
        // '';
    if ( length $peer_addr and $args->{'auth.exempt-loopback'} ) {
        ## real socket peer ONLY [ never X-Forwarded-For : behind a proxy ##
        ## loopback would be everyone ]. auth.exempt-loopback spares      ##
        ## 127.0.0.1 / ::1 plus any peers the operator listed in host     ##
        ## config [ /etc/protocol-7/host-config/httpd.cfg :               ##
        ## web.auth.exempt_peers = 192.0.2.42   -- full api access from   ##
        ## that address; for set-ups reaching the ui over a private LAN   ##
        ## address instead of loopback [ e.g. a WSL host ]                ##
        my $norm_addr = lc $peer_addr;
        $norm_addr =~ s|^::ffff:||;
        if ( $norm_addr eq qw| 127.0.0.1 | or $norm_addr eq qw| ::1 | ) {
            $auth_exempt = TRUE;
        } else {
            my $exempt_peers = <web.auth.exempt_peers> // '';
            if ( length $exempt_peers ) {
                my %exempt_peer = map { $ARG => TRUE }
                    split m|[\s,]+|, $exempt_peers;
                $auth_exempt = TRUE if $exempt_peer{$norm_addr};
            }
        }
    }
    ## a token travels only over tls or loopback : refused before it is  ##
    ## checked [ plugin.web.auth.secure_transport ] -- exempt peers send ##
    ## none                                                              ##
    if (    not $auth_exempt
        and not <[plugin.web.auth.secure_transport]>->($id) ) {
        <[base.logs]>->(
            1,   '[%d] auth required for %s over plain http : refused',
            $id, $args->{'command'} // '(unknown)'
        );
        $session->{'http'}->{'close'} = TRUE;
        return <[httpd.send_error_page]>->( $id, 403 );
    }
}

my $command = $args->{'command'} // qw| web.request |;

## a route may name a separate command for peers that are NOT exempt       ##
## [ not this host's loopback \ exempt_peers ] : the receiver decides what ##
## a foreign sender may change, not the sender's own config                ##
## [ jobs-sync : only the web's own jobsite pushes full batches ]          ##
$command = $args->{'command.foreign'}
    if length( $args->{'command.foreign'} // '' )
    and not $auth_exempt;
my $body = $session->{'http'}->{'body'} // $session->{'buffer'}->{'input'}
    // '';
$session->{'http'}->{'body'}    = '';
$session->{'buffer'}->{'input'} = '';

my $call_args;

if ( defined $session->{'http'}->{'shm_path'} ) {

    ## shm transfer : body was streamed to disk by httpd.handler.shm_write ##
    ## and fully validated -- relay only the tiny path + key reference     ##
    ## instead of the inline body [ call_args buffer ceilings ]            ##
    $call_args = {
        'shm_path' => delete $session->{'http'}->{'shm_path'},
        'shm_key'  => delete $session->{'http'}->{'shm_key'},
    };

} else {

    ## decode raw utf-8 bytes to unicode before route-send : base.s_write  ##
    ## re-encodes on the outgoing side, so the body must be unicode chars, ##
    ## not raw bytes                                                       ##
    utf8::decode($body) if length($body) and not utf8::is_utf8($body);

    ## for GET requests body is empty : fall back to query string so   ##
    ## handlers can read ?param=value via call args without a separate ##
    ## channel                                                         ##
    my $query_str = '';
    if ( ( $session->{'http'}->{'request'}->{'uri'} // '' ) =~ m{\?(.+)$} ) {
        $query_str = $1;
    }
    $call_args = { 'args' => length($body) ? $body : $query_str };
}

$session->{'http'}->{'close'} = TRUE;

##  replace input watcher : keep EOF detection, disable timeout  ##
if ( defined $session->{'watcher'}{'input_handler'} ) {
    my $fd = $session->{'watcher'}{'input_handler'}->fd;
    $session->{'watcher'}{'input_handler'}->cancel;
    $session->{'watcher'}{'input_handler'} = Event->io(
        'fd'     => $fd,
        'cb'     => sub { &{ $code{'base.handler.read'} } },
        'poll'   => qw| r |,
        'prio'   => 1,
        'repeat' => FALSE,
        'data'   => $id,
        'desc'   => sprintf( '[%d] input handler [ no timeout ]', $id ),
    );
}

## the original route relay spec : used directly, or by the auth gate reply ##
## handler after the token verified [ httpd.handler.web-relay .auth-check ] ##
my $relay_spec = {
    'command'   => $command,
    'call_args' => $call_args,
    'reply'     => {
        'handler' => qw| httpd.handler.web-relay.strm_open |,
        'params'  => {
            'http_sid'     => $id,
            'content_type' => $args->{'content_type'}
                // qw| application/json |,
        },
    },
};

## auth.required : the token check runs in the web zenka                   ##
## [ one decision point, accounted on the bearer path ] ; no token         ##
## presented at all is answered right here -- nothing was checked, nothing ##
## is recorded                                                             ##
if ( $args->{'auth.required'} and not $auth_exempt ) {
    my $headers   = $session->{'http'}->{'request'}->{'headers'} // {};
    my $peer_addr = $session->{'http'}->{'request'}->{'client'}->{'addr'}
        // '';
    my $peer_fh = $session->{'handle'};

    my $presented
        = ( ( $headers->{'authorization'} // '' ) =~ m|^Bearer\s+\S+|i )
        || ( ( $headers->{'cookie'} // '' ) =~ m|\bp7_session=\S| );

    if ( not $presented ) {
        <[base.logs]>->(
            1,   '[%d] auth required for %s : unauthorized',
            $id, $args->{'command'} // '(unknown)'
        );
        return <[httpd.send_error_page]>->( $id, 401 );
    }

    ## header values : strip \r\n [ send.local refuses to frame them ] ##
    my $auth_header   = $headers->{'authorization'} // '';
    my $cookie_header = $headers->{'cookie'}        // '';
    for my $value ( $auth_header, $cookie_header ) {
        $value =~ s|[\r\n]+||g;
    }

    ## the socket facts travel as multi-line ' key : value' param lines ##
    ## [ base.protocol-7.command.send.local ] ; no body for the check   ##
    <[protocol-7.route-send]>->(
        {   'command'   => qw| web.auth-bearer |,
            'call_args' => {
                'param' => {
                    'peer_addr' => $peer_addr,
                    'peer_tls'  => (
                        ref $peer_fh and $peer_fh->isa('IO::Socket::SSL')
                    ) ? 1 : 0,
                    'auth_header'   => $auth_header,
                    'cookie_header' => $cookie_header,
                },
            },
            'reply' => {
                'handler' => qw| httpd.handler.web-relay.auth-check |,
                'params'  => {
                    'http_sid' => $id,
                    'relay'    => $relay_spec,
                },
            },
        }
    );

    return 0;    # [ deferred : auth-check fires the original relay ]
}

<[protocol-7.route-send]>->($relay_spec);

return 0;        # [ deferred : reply handler writes response ]

