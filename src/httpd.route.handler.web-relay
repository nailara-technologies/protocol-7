## [:< ##

# name  = httpd.route.handler.web-relay
# descr = relay HTTP request to web zenka via route-send STRM pattern
#         generic handler : command and args from route config

my $id      = shift;
my $args    = shift // {};
my $session = $data{'session'}->{$id};

## route-level auth gating ##
if ( $args->{'auth.required'} ) {
    my $auth_session = <[plugin.web.auth.verify_session]>->($session);
    if ( not defined $auth_session ) {
        <[base.logs]>->(
            1,   '[%d] auth required for %s : unauthorized',
            $id, $args->{'command'} // '(unknown)'
        );
        return <[httpd.send_error_page]>->( $id, 401 );
    }
    $session->{'auth_session'} = $auth_session;
}

my $command = $args->{'command'}           // qw| web.request |;
my $body    = $session->{'http'}->{'body'} // $session->{'buffer'}->{'input'}
    // '';
$session->{'http'}->{'body'}    = '';
$session->{'buffer'}->{'input'} = '';

my $call_args;

if ( defined $session->{'http'}->{'shm_path'} ) {

    ## shm transfer : body was streamed to disk by httpd.handler.shm_write ##
    ## and fully validated -- relay only the tiny path + key reference     ##
    ## instead of the inline body [ call_args buffer ceilings ]            ##
    $call_args = {
        'shm_path' => delete $session->{'http'}->{'shm_path'},
        'shm_key'  => delete $session->{'http'}->{'shm_key'},
    };

} else {

    ## decode raw utf-8 bytes to unicode before route-send : base.s_write  ##
    ## re-encodes on the outgoing side, so the body must be unicode chars, ##
    ## not raw bytes                                                       ##
    utf8::decode($body) if length($body) and not utf8::is_utf8($body);

    ## for GET requests body is empty : fall back to query string so   ##
    ## handlers can read ?param=value via call args without a separate ##
    ## channel                                                         ##
    my $query_str = '';
    if ( ( $session->{'http'}->{'request'}->{'uri'} // '' ) =~ m{\?(.+)$} ) {
        $query_str = $1;
    }
    $call_args = { 'args' => length($body) ? $body : $query_str };
}

$session->{'http'}->{'close'} = TRUE;

##  replace input watcher : keep EOF detection, disable timeout  ##
if ( defined $session->{'watcher'}{'input_handler'} ) {
    my $fd = $session->{'watcher'}{'input_handler'}->fd;
    $session->{'watcher'}{'input_handler'}->cancel;
    $session->{'watcher'}{'input_handler'} = Event->io(
        'fd'     => $fd,
        'cb'     => sub { &{ $code{'base.handler.read'} } },
        'poll'   => qw| r |,
        'prio'   => 1,
        'repeat' => FALSE,
        'data'   => $id,
        'desc'   => sprintf( '[%d] input handler [ no timeout ]', $id ),
    );
}

<[protocol-7.route-send]>->(
    {   'command'   => $command,
        'call_args' => $call_args,
        'reply'     => {
            'handler' => qw| httpd.handler.web-relay.strm_open |,
            'params'  => {
                'http_sid'     => $id,
                'content_type' => $args->{'content_type'}
                    // qw| application/json |,
            },
        },
    }
);

return 0;    # [ deferred : reply handler writes response ]

