# name  = mpv.cmd.snapshot-restore
# descr = restore player state from state/snapshot.yaml

my $restored = <[mpv.snapshot.restore]>->(qw| full |);

return { 'mode' => qw| true |, 'data' => 'snapshot state restored' }
    if $restored;

return { 'mode' => qw| false |, 'data' => 'no snapshot state found' };

