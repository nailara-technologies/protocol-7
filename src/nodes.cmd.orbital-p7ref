# name  = nodes.cmd.orbital-p7ref
# descr = return current orbital P7REF as plain string

my $p7ref = <nodes.orbital.current_p7ref> // '';

return {
    qw| mode | => qw| false |,
    qw| data | => 'orbital position not initialized'
    }
    unless length $p7ref;

return { qw| mode | => qw| size |, qw| data | => $p7ref };

