## [:< ##
# name  = plugin.storage.visual.init_code
# descr = Initialize visual mapping system for storage harmonization

## Visual mapping registry ##
<storage.mapping.visual> = {
    'enabled' => 1,
    'version' => '0.1',

    ## Float extraction layer configs ##
    'layers' => {
        'intrinsic' => {
            'enabled' => 1,
            'metrics' =>
                [qw| entropy path_depth ref_count access_freq size_log |],
        },
        'temporal' => {
            'enabled' => 1,
            'metrics' => [qw| age velocity decay time_pref |],
        },
        'network' => {
            'enabled' => 1,
            'metrics' => [qw| hops bandwidth reliability centrality |],
        },
        'L13' => {
            'enabled' => 1,    # For @INDEXCUBE integration
            'metrics' => [qw| L13_x L13_y L13_z |],
        },
    },

    ## Proximity calculation methods ##
    'proximity_methods' => {
        'checksum' => { 'weight' => 0.4, 'impl' => 'hamming' },
        'path'     => { 'weight' => 0.3, 'impl' => 'levenshtein' },
        'semantic' => { 'weight' => 0.2, 'impl' => 'segment_overlap' },
        'temporal' => { 'weight' => 0.1, 'impl' => 'time_proximity' },
    },

    ## Harmonization workflow registry ##
    'workflows' => {},

    ## Visual space cache ##
    'coordinates' => {},    # p7ref -> { x, y, z, ... }

    ## Graph cache ##
    'graphs' => {},

    ## Stats ##
    'stats' => {
        'refs_processed'  => 0,
        'graphs_rendered' => 0,
        'workflows_run'   => 0,
    },
};

## Pre-defined workflows ##
<storage.mapping.visual.workflows> = {
    'dedup-hot-files' => {
        'desc'  => 'Find and prioritize frequently accessed duplicates',
        'steps' => [
            { 'filter' => 'proximity-cluster', 'threshold' => 0.05 },
            { 'filter' => 'sort', 'by' => 'access_frequency', 'desc' => 1 },
            {   'filter'     => 'threshold',
                'percentile' => 0.10,
                'action'     => 'prioritize-cache'
            },
        ],
    },
    'migrate-cold-storage' => {
        'desc'  => 'Move old, rarely accessed files to 9P cold storage',
        'steps' => [
            { 'filter' => 'temporal', 'older_than_days' => 90 },
            { 'filter' => 'sort', 'by' => 'access_frequency', 'desc' => 0 },
            {   'filter'     => 'threshold',
                'percentile' => 0.20,
                'action'     => 'migrate-to-9p'
            },
        ],
    },
    'indexcube-cluster' => {
        'desc'  => 'Cluster by L13 coordinates for INDEXCUBE visualization',
        'steps' => [
            { 'filter' => 'extract',    'layer'  => 'L13' },
            { 'filter' => 'cluster-3d', 'radius' => 0.1 },
            { 'filter' => 'render',     'mode'   => 'sphere-cloud' },
        ],
    },
};

<[base.logs]>->("Visual mapping plugin initialized v0.1");

0;

