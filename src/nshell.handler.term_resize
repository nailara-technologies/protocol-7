## [:< ##

# name  = nshell.handler.term_resize
# descr = SIGWINCH handler - update cached terminal dimensions
#         and redraw input line

## re-query terminal size [ terminal_size returns ( cols, rows ) ]
my @size     = AMOS7::TERM::terminal_size();
my $new_cols = $size[0] // 80;
my $new_rows = $size[1] // 24;

## cache new terminal dimensions for render.viewport and other consumers
<nshell.cfg.term_cols> = $new_cols;
<nshell.cfg.term_rows> = $new_rows;

my $state_ref = <nshell.state> // {};

## split mode active : recompute the scroll region for the NEW terminal    ##
## size and force a full redraw. resizing while a DECSTBM boundary and     ##
## reserved rows were set for the OLD dimensions is exactly what produced  ##
## the "stacking separator bars at growing widths" bug -- the boundary and ##
## separator both stayed sized for whatever the terminal was before.       ##
if ( $state_ref->{'split_active'} ) {

    my $reserved = $state_ref->{'split_reserved_rows'} // 2;

    ## full clear : a physical resize can leave arbitrary reflowed content ##
    ## behind, more than a simple 2-line clear accounts for                ##
    print "\e[2J\e[H";

    my $content_bottom = AMOS7::TERM::scroll_region_set($reserved);

    if ( defined $content_bottom ) {
        $state_ref->{'split_row'} = $content_bottom + $reserved;

        ## replay this mode's accumulated buffer into the resized content ##
        ## area, same as nshell.display.cycle does on a fresh focus       ##
        my $modes = $state_ref->{'display_modes'};
        my $mode
            = ref $modes eq 'ARRAY'
            ? $modes->[ $state_ref->{'display_mode_index'} // 0 ]
            : undef;
        my $replay = defined $mode ? ( $mode->{'buffer'} // '' ) : '';

        if ( length $replay ) {
            print $replay;

            ## same modular tail-length math as nshell.render.content_print, ##
            ## kept in sync deliberately : this sets the SAME content_col /  ##
            ## content_pending_wrap pair that function reads on its very     ##
            ## next call, so an exact-width replay tail here has to leave    ##
            ## the same pending-wrap flag behind or the next live chunk      ##
            ## after a resize reproduces the row-edge overwrite bug fresh.   ##
            my $tail_len;
            if ( $replay =~ m{\n([^\n]*)\z} ) {
                $tail_len = length($1);
            } elsif ( $replay !~ m{\n} ) {
                $tail_len = length($replay);
            } else {
                $tail_len = 0;
            }
            $state_ref->{'content_col'} = ( $tail_len % $new_cols ) + 1;
            $state_ref->{'content_pending_wrap'}
                = ( $tail_len > 0 and $tail_len % $new_cols == 0 )
                ? TRUE
                : FALSE;
        } else {
            $state_ref->{'content_col'} = 1;
            delete $state_ref->{'content_pending_wrap'};
        }
    } else {
        ## terminal shrank too far to fit the reservation : fall back to ##
        ## shell mode cleanly rather than leave a broken half-set region ##
        $state_ref->{'split_active'} = FALSE;
        delete $state_ref->{'split_row'};
        delete $state_ref->{'split_reserved_rows'};
        delete $state_ref->{'split_title'};
        AMOS7::TERM::scroll_region_clear();
    }

    $state_ref->{'view_offset'} = 0;
    <[nshell.render.viewport]>->( $state_ref->{'editor'}, \%colors )
        if defined $state_ref->{'editor'};

    return;
}

## [ redraw current input line at new width (if editor is active) ]
if ( defined $state_ref->{'editor'} ) {

    ##[ reset view_offset so viewport recalculates from scratch at new width ]
    $state_ref->{'view_offset'} = 0;

    ##[ clear current line and the line below - previous wider renders may
    ##  have left remnants on the next screen line when the terminal narrows ]
    print "\r\e[2K\e[1B\r\e[2K\e[1A";
    <[nshell.render.viewport]>->( $state_ref->{'editor'}, \%colors );
}

