## [:< ##

# name  = plugin.user-edit.example.render
# descr = minimal reference plugin's display -- verifies the display_override hook
# param = $editor_state, $field

## THROWAWAY / reference only -- see plugin.user-edit.example.init_code's own
## note.  deliberately visible/distinctive [ a bracketed prefix ] so a live
## capture makes it obvious the override actually fired, rather than just
## showing the raw stored text unchanged.

my ( $editor_state, $field ) = @ARG;

my $stored = <[editor.control.get_value]>->( $editor_state, $field ) // '';

## q|...|, NOT qw|...| : qw splits on WHITESPACE into a LIST, so a format
## string containing a space would silently become two separate arguments
## instead of one -- the exact 'and'/'or' precedence-adjacent class of trap,
## just for qw() instead
return sprintf( q| [example] %s |, $stored );

