## [:< ##

# name  = base.protocol-7.command.send.local
# descr = local command send [ single + multi-line mode ]
# note  = single-line when call_args carries only 'args' [ byte for
#         byte as always ] ; multi-line packet via
#         base.format.multiline_command when call_args holds 'param'
#         [ hash ] or 'data' [ string ] and no 'args' [ the multi-line
#         head has none : with args it stays single-line, param \ data
#         dropped as before, logged ] ; param keys [a-z0-9_-] only, plain
#         values, no linebreaks -- otherwise the send is refused
#         [ log level 0, return 0 ] : never a broken frame

my $cmd       = $ARG[0]->{'command'};
my $call_args = $ARG[0]->{'call_args'};
$ARG[0]->{'reply'}   //= {};
$call_args->{'args'} //= '';

my $caller_level    ## adjust for relevant caller subroutine [route-send case]
    = [ <[base.caller]>->(0) ]->[0] eq qw| base.protocol-7.route-send |
    ? 2
    : 1;

return warn sprintf 'expected <command> parameter <{C%d}>', $caller_level
    if not defined $cmd;
return warn 'command string contained endlines <{C%d}>', $caller_level
    if index( $cmd, "\n" ) >= 0;

## no clients in session ##
if ( 0 == scalar keys $data{'session'}->%* ) {    ##  empty session : -1  ##
    <[base.logs]>->(
        0, "send.local: no clients in session, dropping '%s'", $cmd
    );
    <[base.logs]>->(
        0,
        ":         : %s",
        scalar <[base.caller]>->( $caller_level - 1 )
    );
    return -1;
}

if ( $cmd =~ s|^([^\.]+)\.((([^\.]+)\.)*\w[\w\d\_\-\.]*(\s.+)?)$|$2|go ) {

    my $cmd_id = <[base.gen_id]>->( $data{'route'}, undef, undef, 0 );

    ## route id table exhausted or invalid parameters : log once at level 0 ##
    ## and drop instead of routing with an undefined id ; the zero return   ##
    ## count signals failure to the caller [ todo 7N3 ]                     ##
    if ( not defined $cmd_id ) {
        <[base.logs]>->(
            0, "send.local: gen_id returned no route id, dropping '%s'", $cmd
        );
        return 0;
    }

    my $reply_handler = $ARG[0]->{'reply'}{'handler'} // qw| dev.null |;
    my $reply_params  = $ARG[0]->{'reply'}{'params'};

    my $target_name = ${^CAPTURE}[0];

    ##[ MULTI-LINE MODE \ REFUSALS ]##########################################

    ## call_args with 'param' [ hash ] or 'data' [ string ] travels as a  ##
    ## multi-line packet : '(<id>)<cmd>+' header lines ' key : value', an ##
    ## empty line, the body, '.' -- anything else stays single-line       ##
    my $has_multi = (
        ref $call_args->{'param'} eq qw| HASH |
            or defined $call_args->{'data'}
    ) ? TRUE : FALSE;

    ## the multi-line head carries no args : a call with args stays         ##
    ## single-line as always, its param \ data dropped as before [ logged ] ##
    my $multiline
        = ( $has_multi and not length $call_args->{'args'} ) ? TRUE : FALSE;

    <[base.logs]>->(
        1, 'send.local: args set, param \ data not sent [ %s ]', $cmd
    ) if $has_multi and not $multiline;

    if ($multiline) {
        my $param = $call_args->{'param'};
        if ( ref $param eq qw| HASH | ) {
            for my $key ( keys $param->%* ) {
                my $val = $param->{$key} // '';
                if (   $key !~ m|^[a-z0-9_-]+$|
                    or ref $val
                    or index( $key, "\n" ) >= 0
                    or index( $val, "\n" ) >= 0
                    or index( $val, "\r" ) >= 0 ) {
                    <[base.logs]>->(
                        0,
                        'send.local: multiline param refused [ '
                            . '%s ] : keys [a-z0-9_-], no linebreaks',
                        $cmd
                    );
                    return 0;
                }
            }
        }
    }

    ## send to all clients with that session id or username [in group mode] ##
    my @send_sids;
    my $target_sid = $target_name =~ m|^\d+$| ? $target_name : undef;
    if ( defined $target_sid
        and exists $data{'session'}{$target_sid} ) {   ##[ session id mode ]##
        @send_sids = ($target_sid);
    } elsif ( exists $data{'user'}{$target_name} ) {    ###[ group mode ]###
        @send_sids = keys $data{'user'}{$target_name}{'session'}->%*;
    }

    ## error handling on unknown target ##
    if ( not @send_sids ) {
        <[base.logs]>->(
            0,            'send.local: unknown target : %s [ cmd : %s ]',
            $target_name, $cmd
        );
        return 0;
    }

##[ ROUTING MODE \ RESOLUTION ]###############################################

    ## configurable bare-name multi-instance disambiguation [ config ] ##

    @send_sids = <[base.zenki.resolve_routing_sids]>->(
        $target_name, undef, \@send_sids, undef
    );

    my $count = 0;
    foreach my $target_sid (@send_sids) {
        my $session;
        $session = $data{'session'}->{$target_sid}
            if exists $data{'session'}->{$target_sid};
        next    ## skip unauthorized connections \ modes ##
            if not defined $session
            or $session->{'mode'} ne qw| client |
            or $session->{'user'} eq <base.session.uname.server>
            or $session->{'user'} eq <base.session.uname.client>
            or defined $session->{'authenticated'}
            and $session->{'authenticated'} ne qw| yes |;

        ### setting up route ###
        my $route = <[base.route.add]>->(
            {   'source' => { 'sid' => $target_sid, 'cmd_id' => $cmd_id },
                'reply'  => {
                    'handler' => $reply_handler,
                    'params'  => $reply_params
                },
                'target' => { 'sid' => $target_sid }
            }
        );

        my $target_cmd_id = $route->{'target'}->{'cmd_id'};

        my $src_name = <system.zenka.name>;
        $src_name .= sprintf qw| [%s] |, <system.zenka.subname>
            if exists <system.zenka.subname>;

        # [LLL]  implement [devmod] watch and
        # filter patterns for command logging

        <log.level.cmd-offset> //= {};
        my $cmd_base = ( $cmd =~ s|^\d+\.||r );    ## strip session prefix ##
        my $llvl_offs                              ## adjustable per cmd ##
            = ( exists <log.level.cmd-offset>->{$cmd_base}
                and <log.level.cmd-offset>->{$cmd_base} =~ m{^[\+\_]?\d} )
            ? <log.level.cmd-offset>->{$cmd_base}
            : ( exists <log.level.cmd-offset>->{$cmd}
                and <log.level.cmd-offset>->{$cmd} =~ m{^[\+\_]?\d} )
            ? <log.level.cmd-offset>->{$cmd}
            : 0;                                   ## default offset 0 ##
        ## default log level 2 for network traffic ##
        if (   <system.zenka.verbosity.console> >= $llvl_offs
            or <system.zenka.verbosity.buffer> >= $llvl_offs ) {
            if (
                (      $src_name ne qw| cube |
                    or $target_name ne qw| p7-log |
                    or $cmd ne qw| append |
                    or not <devmod.skip_log_msg>
                )
                and (  $target_name ne qw| cube |
                    or $cmd ne qw| p7-log.append |
                    or not <devmod.skip_log_msg> )
            ) {
                <[base.logs]>->(
                    2 + $llvl_offs,
                    ':network: %s ..:. %s ..:. %s',
                    $src_name, $target_name, $cmd
                );
            }
        }

        $target_cmd_id =~ s|^([1-9]\d*)$|($1)|;

        if ($multiline) {
            my $command_string = <[base.format.multiline_command]>->(
                $route->{'target'}->{'cmd_id'},
                $cmd, $call_args
            );
            if ( not defined $command_string ) {
                <[base.logs]>->(
                    0, 'send.local: multiline build failed [ %s ]', $cmd
                );
                return 0;
            }

            ##  append packet to target buffer  ##
            $data{'session'}{$target_sid}{'buffer'}{'output'}
                .= $command_string;

            ##  calculate and store average command line length  ##
            <[base.session.calc_cmd_stats]>
                ->( $target_sid, \$command_string );

            $count++;

            ###  set up timeout handler ?  ###  [LLL]
            next;
        }

        #            if ( $command_mode == 1 )    # single line command mode
        #            {
        my $args = '';

        if ( length $call_args->{'args'} ) { $cmd .= ' ' }

        my $command_string    ##  prepare full command line  ##
            = join( '', $target_cmd_id, $cmd, $call_args->{'args'}, "\n" );

        ##  append command to target buffer  ##
        $data{'session'}{$target_sid}{'buffer'}{'output'} .= $command_string;

        ##  calculate and store average command line length  ##
        <[base.session.calc_cmd_stats]>->( $target_sid, \$command_string );

        $count++;

        ###  set up timeout handler ?  ###  [LLL]
    }
    return $count;
} else {
    <[base.s_warn]>->( "protocol mismatch ['%s'] <{C$caller_level}>", $cmd );
    return -2;
}

