## [:< ##

# name  = graphics.matrix.visual.classify-all
# descr = Classify all images into cubic pixel spheres
#
# input : $images - array of image paths/refs
#         $max_spheres - maximum sphere number (0-6)
# output: array of classified image hashes

my $images      = shift // [];
my $max_spheres = shift // 6;

return [] unless @$images;

my @classified;

for my $image (@$images) {

    # Get image info
    my $info
        = ref $image eq qw| HASH |
        ? $image
        : <[graphics.matrix.visual.detect-resolution]>->($image);

    next if $info->{'mode'} eq qw| false |;

    my ( $w, $h ) = @{ $info->{'size'} // [ 0, 0 ] };
    my $pixels = $w * $h;

    # Determine sphere
    my $sphere = <[graphics.matrix.visual.sphere]>
        ->( qw| classify |, $pixels )->{'sphere'};
    $sphere = $max_spheres if $sphere > $max_spheres;

    # Calculate cubic coordinates
    my $cubic_coord
        = <[graphics.matrix.visual.sphere]>->( qw| coord |, [ $w, $h ] );

    # Extract average color for 1x1 sphere
    my $color_sample;
    if ( $sphere == 0 || $pixels <= 1 ) {
        $color_sample = <[graphics.matrix.visual.extract-color]>->($info);
    }

    push @classified,
        {
        'image'        => $image,
        'info'         => $info,
        'sphere'       => $sphere,
        'cubic_coord'  => $cubic_coord,
        'pixels'       => $pixels,
        'color_sample' => $color_sample,
        'checksum'     => $info->{'checksum'}
            // <[chk-sum.amos]>->( { 'str' => "$w:$h:$pixels" } ),
        };
}

return \@classified;

