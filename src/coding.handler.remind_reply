## [:< ##

# name  = coding.handler.remind_reply
# descr = the events zenka answered a reminder command

## label `list` : only the remind- lines of bucket-show, waiting ones ##

my $reply = shift              // {};
my $p     = $reply->{'params'} // {};
my ( $mode, $text ) = <[base.reply.mode_text]>->($reply);
$text =~ s{\s+\z}{};
my $ok = ( $mode eq qw| true | or $mode eq qw| size | ) ? TRUE : FALSE;
$text = 'events zenka not reachable' if $text =~ m{\Aclient not present};
my @kept = $p->{'label'} eq qw| list | ? <[coding.remind.lines]> : ();
my $answer;

if ( not $ok and @kept ) {
    $answer = {
        'mode' => qw| size |,
        'data' => join( "\n", @kept, "waiting ones : $text" ) . "\n"
    };
} elsif ( not $ok ) {
    $answer = { 'mode' => qw| false |, 'data' => "$p->{'label'} : $text" };
} elsif ( $p->{'label'} eq qw| list | ) {
    my @lines = grep {m{\A: remind-(?:\d+|[A-Z2-7]+\d{2})\s+waiting\s}}
        split m{\n}, $text;
    @lines  = ( ( map {s{\A: }{}r} @lines ), @kept );
    $answer = {
        'mode' => qw| size |,
        'data' => @lines ? join( "\n", @lines ) . "\n" : "no reminders\n"
    };
} else {
    $answer = { 'mode' => qw| true |, 'data' => "$p->{'label'} : $text" };
}
<[base.logs]>->( 2, ':. %s : %s', $p->{'label'}, $answer->{'data'} );
<[base.callback.cmd_reply]>->( $p->{'reply_id'}, $answer )
    if ( $p->{'reply_id'} // '' ) =~ m{\A\d+\z};
return $answer;

