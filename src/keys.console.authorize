#\\\|RD6SUHEE6O7APXJ7HMIG37KAUBXSUV2JFM22JZGE7G5OPDZNOE2 \ / AMOS7 \ YOURUM ::
#\[7]54LKGSYRV7SXKAJDQIDH465NVMEKFJTV4MIH4U25YAXTW62RDQAA 7  DATA SIGNATURE ::
