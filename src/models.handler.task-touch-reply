## [:< ##

# name  = models.handler.task-touch-reply
# descr = a claim renewal answered : TRUE renews it
#         [ the reply names the lease ]. only the task zenka's own
#         answer ends a claim [ superseded, expired, failed ] : dropped,
#         the work stops [ models.task.drop-claim ]. any other FALSE
#         [ no permission, route collapsed ] says nothing about the
#         claim : the work goes on, retried a third of a lease later

my $call = shift // {};

my ( $mode, $text ) = <[base.reply.mode_text]>->($call);
my $task_id = $call->{'params'}{'task_id'} // '';

my $claim = ( <models.task.claimed> // {} )->{$task_id};
return if ref $claim ne qw| HASH |;    ## released meanwhile ##

if ( $mode eq qw| false | ) {

    ## answered by task.cmd.touch itself : not this agent's claim any more ##
    if ( ( $text // '' ) =~ m{not an active claim|\bnot found\b} ) {
        <[base.logs]>->(
            0,        ': task %s : renewal refused [ %s ], claim dropped',
            $task_id, $text
        );
        <[models.task.drop-claim]>->( $task_id, 'renewal refused' );
        return;
    }

    ## touch_pending stays : the next try waits a third of the lease ##
    <[base.logs]>->(
        0,        ': task %s : renewal not delivered [ %s ], claim kept',
        $task_id, $text // ''
    );
    return;
}

delete $claim->{'touch_pending'};
$claim->{'touched'} = time;
$claim->{'renewed'} = TRUE;    ## the task zenka runs the lease now ##
$claim->{'lease'}   = $1 if ( $text // '' ) =~ m|\blease (\d+)|;

return;

