## [:< ##

# name  = coding.handler.spawn_servers_deferred
# descr = Timer callback to spawn inference servers after model path resolution
# purpose = Delay server spawning to allow async model path resolution to complete

my $event = shift;

<[base.logs]>->(
    1, 'deferred spawn timer triggered, spawning inference servers'
);

## skip if server already running                ##
## [ model_path_reply may have spawned already ] ##
my $gpu_pid = <inference.gpu_pid> // 0;
if ( $gpu_pid and kill( 0, $gpu_pid ) ) {
    <[base.logs]>->(
        1, 'deferred spawn: GPU server already running [pid:%d], skipping',
        $gpu_pid
    );
    $event->w->stop if defined $event->w;
    return TRUE;
}

# Call the async spawn routine
<[coding.async_spawn_inference_servers]>;

## schedule fallback verification so jobqueue.check_dependencies is called  ##
## even if a stale watcher guard cancels the io monitor before it fires --  ##
## on the backend that serves : the cpu where the gpu is switched off [     ##
## verifying the absent gpu never resumed the queue on a cpu-only host : a  ##
## server, 2026-10-22 : 54 jobs parked, none run ; as coding.task.enqueue ] ##
my $gpu_enabled
    = <[base.cfg_bool]>->( <inference.backend.gpu.enabled> // TRUE );
<[event.add_timer]>->(
    {   'after'   => 10.0,
        'handler' => qw| coding.handler.verify_inference_startup |,
        'data'    => {
            'backend' => defined $gpu_enabled && !$gpu_enabled
            ? qw| cpu |
            : qw| gpu |
        }
    }
);

# Cancel the timer if still active
$event->w->stop if defined $event->w;

return TRUE;

