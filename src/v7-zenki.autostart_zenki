## [:< ##

# name  = v7-zenki.autostart_zenki
# descr = initializing zenki for automatic\immediate start-up

foreach my $zenka_name (@ARG) {

    ## pre-start dependency check [ warn-only ; with auto_install_deps the ##
    ## sys_deps start condition governs probes + installs on every start   ##
    ## path -- autostart is only the feature-off fallback, as before ]     ##
    <[v7-zenki.check_zenka_deps]>->($zenka_name)
        if not
        <[base.cfg_bool]>->( <v7-zenki.cfg.auto_install_deps> // FALSE );

    my $zenka_config = <v7-zenki.start_setup.zenki.config>->{$zenka_name};
    my $zenka_id     = <[zenka.get_id]>->($zenka_name);
    my $obj_id       = <[zenka.get_object_id]>->($zenka_id);
    my $target_queue
        = <[dependency.ok_resolve]>->($obj_id) ? 'queued' : 'depending';
    my $instance_count = $zenka_config->{'start'}->{'instances'} || 1;

    while ( <[zenka.is_enabled]>->($zenka_name) and $instance_count-- ) {
        my $job_id = <[jobqueue.add_job]>->(
            {   'object_id'       => $obj_id,
                'target_queue'    => $target_queue,
                'job_callback'    => qw| zenka.start |,
                'callback_params' => $zenka_name
            }
        );
        <v7-zenki.zenka.autostart>->{$zenka_name}->{'job'} = $job_id;

        ## start gate flag [ v7-zenki.pressure.start_gate ] : start-set-up ##
        ## autostarts go one at a time under memory pressure               ##
        <jobqueue.joblist.by_id>->{$job_id}->{'pressure_gate'}
            = { 'origin' => qw| autostart | }
            if ref <jobqueue.joblist.by_id>->{$job_id} eq qw| HASH |;
    }
}

