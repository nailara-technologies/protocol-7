## [:< ##

# name  = branch.space.trit.intent_frame
# descr = 3+1 stream frame for octant payload bits
# param = { bits => '000'..'111' }
#
# frame = payload . separator
# separator '0' normally, inverts to '1' only for payload '000'
# [ topic-stream-framing-protocol : inversion on zero payload ]

my $params = shift             // {};
my $bits   = $params->{'bits'} // '';

return { 'mode' => 'false', 'data' => 'bits must be 3 chars of 0 or 1' }
    unless length $bits == 3 and $bits =~ m|^[01]{3}$|;

my $separator = $bits eq qw| 000 | ? qw| 1 | : qw| 0 |;

return {
    'mode' => 'true',
    'data' => { 'frame' => $bits . $separator }
};

