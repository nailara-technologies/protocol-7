## [:< ##

# name = menu-commands.load-state
# descr = Load menu-commands persistent state from disk

use YAML::XS qw| Load |;

# Load mappings
my $mappings_content_ref = <[file.zenka_dir.load]>->('data/mappings.yaml');
if ( defined $mappings_content_ref ) {
    eval {
        my $yaml_data = Load($$mappings_content_ref);
        <menu-commands.mappings> = $yaml_data->{'mappings'} // {}
            if ref($yaml_data) eq qw| HASH |;
    };
    if ($EVAL_ERROR) {
        <[base.s_warn]>->( 'Error loading mappings: %s', $EVAL_ERROR );
    }
}

# Load categories
my $categories_content_ref
    = <[file.zenka_dir.load]>->('data/categories.yaml');
if ( defined $categories_content_ref ) {
    eval {
        my $yaml_data = Load($$categories_content_ref);
        <menu-commands.categories> = $yaml_data->{'categories'} // {}
            if ref($yaml_data) eq qw| HASH |;
    };
    if ($EVAL_ERROR) {
        <[base.s_warn]>->( 'Error loading categories: %s', $EVAL_ERROR );
    }
}

1;

