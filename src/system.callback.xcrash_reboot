# name  = system.callback.xcrash_reboot

my $admin_abort = <system.X-11_crash.admin_reboot_abort> //= 0;

return
    <[base.log]>->( 0, '<< ! >> automated host reboot aborted ., =) << ! >>' )
    if $admin_abort;

<[base.log]>->( 1, ":.. sending reboot request to 'v7-zenki' zenka .," );

<[protocol-7.command.send.local]>
    ->( { 'command' => qw| cube.v7-zenki.host-reboot | } );

