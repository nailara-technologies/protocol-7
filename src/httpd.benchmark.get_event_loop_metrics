# name = httpd.benchmark.get_event_loop_metrics
# descr = collect event loop performance metrics

# Initialize metrics
my $metrics = {
    'watchers'        => 0,
    'io_watchers'     => 0,
    'timer_watchers'  => 0,
    'idle_watchers'   => 0,
    'child_watchers'  => 0,
    'signal_watchers' => 0,
    'loop_time'       => 0
};

# Check if Event module is loaded
if ( defined &Event::loop_time ) {
    $metrics->{'loop_time'} = Event::loop_time();

    # Count watchers by type if available
    $metrics->{'watchers'} = Event::all_watchers()
        if defined &Event::all_watchers;

    # Count IO watchers
    if ( exists $data{'event'} && exists <event.io> ) {
        $metrics->{'io_watchers'} = scalar( keys <event.io>->%* );
    }

    # Count timer watchers
    if ( exists $data{'event'} && exists <event.timer> ) {
        $metrics->{'timer_watchers'} = scalar( keys <event.timer>->%* );
    }
}

return $metrics;

