## [:< ##

# name  = base.curve.cancel
# descr = Stop and remove a running curve

my $id = shift;

delete <base.curve.active>->{$id}  if defined <base.curve.active>->{$id};
delete <base.curve.compose>->{$id} if defined <base.curve.compose>->{$id};

return;

