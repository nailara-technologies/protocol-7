# name  = vterm.consensus.cell_fingerprint
# descr = generate sub-bit fingerprint for agreement checking

my $cell = shift // return '';

return pack( 'c4',
    $cell->{subbit_r}    // 0,
    $cell->{subbit_g}    // 0,
    $cell->{subbit_b}    // 0,
    $cell->{subbit_attr} // 0 );

