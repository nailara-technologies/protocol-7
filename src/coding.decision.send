## [:< ##

# name   = coding.decision.send
# descr  = send a menu pending-question command, reply deferred
# args   = menu command, args, reply id, label
# return = a command reply [ deferred for a network caller ]
#
# the open decisions are the menu's pending questions [ no second store ].
# route-send only buffers : coding.handler.decision_reply answers the caller

my ( $command, $args, $reply_id, $label ) = @ARG;
$reply_id //= '';
my $sent = <[protocol-7.route-send]>->(
    {   'command'   => "protocol-7-menu.$command",
        'call_args' => { 'args' => $args },
        'reply'     => {
            'handler' => qw| coding.handler.decision_reply |,
            'params'  => { 'reply_id' => $reply_id, 'label' => $label }
        }
    }
);
return { 'mode' => qw| false |, 'data' => 'protocol-7-menu not reachable' }
    if not $sent;
return { 'mode' => qw| deferred | } if $reply_id =~ m{\A\d+\z};
return { 'mode' => qw| true |, 'data' => "$label requested" };

