## [:< ##

# name  = graphics-matrix.cursor.checksum
# descr = compute content-address checksum of current cursor state

my $cursor = $data{'graphics-matrix'}{'cursor'};

## build canonical string (fixed precision for consistent checksums) ##
my $canonical = sprintf "%d:%d:%d:%.6f:%d",
    $cursor->{'selX'},
    $cursor->{'selY'},
    $cursor->{'selZ'},
    $cursor->{'zoom'},
    $cursor->{'radius'};

## compute amos checksum ##
my $checksum = <[chk-sum.amos]>->($canonical);

return $checksum;

