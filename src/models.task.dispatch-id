## [:< ##

# name  = models.task.dispatch-id
# descr = start the claim chain for an announced task id
# note  = start the claim chain for a task id the task zenka announced
# param = <task_id>
# notes = local task zenka : claim -> start -> show -> enqueue [ unchanged ].
#         remote task zenka : show first ['peek'], claim only when the model
#         is one this host serves -- a task for another model stays pending
#         for the owning host, it is never claimed or failed from here

my $task_id = shift // '';

return FALSE if not length $task_id;

if ( not <[models.task.remote]> ) {
    return <[protocol-7.route-send]>->(
        {   'command'   => <[models.task.cmd]>->(qw| claim |),
            'call_args' => {
                'args' => sprintf '%s %s',
                $task_id, <models.cfg.task_agent> // qw| models |
            },
            'reply' => {
                'handler' => 'models.handler.task-poll-step',
                'params'  => { 'step' => 'claimed', 'task_id' => $task_id }
            }
        }
    );
}

return <[protocol-7.route-send]>->(
    {   'command'   => <[models.task.cmd]>->(qw| show |),
        'call_args' => { 'args' => $task_id },
        'reply'     => {
            'handler' => 'models.handler.task-poll-step',
            'params'  => { 'step' => 'peek', 'task_id' => $task_id }
        }
    }
);

