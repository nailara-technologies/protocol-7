## [:< ##

# name  = models.task.dispatch-id
# descr = start the claim chain for an announced task id
# note  = start the claim chain for a task id a task zenka announced
# param = <task_id> [ <source zenka> ]
# notes = the source zenka [ stream frame, poll, or the local task
#         zenka's task-notify ] is remembered per task id
#         [ <models.task.source> ] : every later command for the task
#         routes back to it [ models.task.cmd ]. local task zenka
#         [ 'task' ] : claim -> start -> show -> enqueue [ unchanged ].
#         remote task zenka : show first ['peek'], claim only when the
#         model is one this host serves -- a task for another model
#         stays pending for the owning host, it is never claimed or
#         failed from here. every claim passes the in-flight capacity
#         gate [ models.task.claim-ok ] : at capacity the task stays
#         pending for another host

my $task_id = shift // '';
my $zenka   = shift // '';

return FALSE if not length $task_id;

$zenka = <[models.task.zenka-of]>->($task_id) if not length $zenka;

## remember the source per task id : claims, start, complete and fail route ##
## back to the zenka the task came from. bounded : aged entries are dropped ##
## once the map grows past 1024 ids                                         ##
## [ completed tasks are never looked up again ]                            ##
my $source = <models.task.source> //= {};
if ( scalar keys %{$source} > 1024 ) {
    my $cutoff = time - 3600;
    delete $source->{$ARG} for grep {
        ref $source->{$ARG} eq qw| HASH |
            and ( $source->{$ARG}{'at'} // 0 )
            < $cutoff
    } keys %{$source};
}
$source->{$task_id} = { 'zenka' => $zenka, 'at' => time };

if ( $zenka eq qw| task | ) {

    ## capacity gate : claim only while below the in-flight limit     ##
    ## [ models.task.claim-ok ] -- backend count unknown : ask coding ##
    ## first, the 'capacity-models' reply re-runs this dispatch       ##
    my $gate = <[models.task.claim-ok]>->('');
    if ( $gate == UNKNOWN ) {
        my $asked = <[protocol-7.route-send]>->(
            {   'command' => qw| coding.inference-status |,
                'reply'   => {
                    'handler' => qw| models.handler.task-poll-step |,
                    'params'  => {
                        'task_id' => $task_id,
                        'zenka'   => $zenka,
                        'step'    => 'capacity-models'
                    }
                }
            }
        );
        return TRUE if $asked and $asked > 0;
        <[base.logs]>->(
            1, ': task %s left pending : backend capacity unknown', $task_id
        );
        return FALSE;
    }
    if ( not $gate ) {
        <[base.logs]>->(
            1, ': task %s left pending : claim capacity reached', $task_id
        );
        return FALSE;
    }

    ## reserve the slot NOW, not on the claim reply : two announcements in ##
    ## the same millisecond both passed the gate before either reply came  ##
    ## [ pri claimed both, the gpu stayed idle ] -- a refused claim frees  ##
    ## it                                                                  ##
    <models.task.claimed>->{$task_id} = <[models.task.claim-record]>;

    my $sent = <[protocol-7.route-send]>->(
        {   'command'   => <[models.task.cmd]>->(qw| claim |),
            'call_args' => {
                'args' => sprintf '%s %s',
                $task_id, <models.cfg.task_agent> // qw| models |
            },
            'reply' => {
                'handler' => 'models.handler.task-poll-step',
                'params'  => { 'step' => 'claimed', 'task_id' => $task_id }
            }
        }
    );
    delete <models.task.claimed>->{$task_id} if not $sent;
    return $sent;
}

return <[protocol-7.route-send]>->(
    {   'command'   => sprintf( qw| %s.show |, $zenka ),
        'call_args' => { 'args' => $task_id },
        'reply'     => {
            'handler' => 'models.handler.task-poll-step',
            'params'  => {
                'step'    => 'peek',
                'task_id' => $task_id,
                'zenka'   => $zenka
            }
        }
    }
);

