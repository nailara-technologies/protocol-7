## [:< ##

# name  = plugin.usage.kimi.init_code
# descr = kimi usage provider plugin : configuration and result cache set-up

my $reinit = shift;

## provider configuration [ never holds credential values -- only where to ##
## read them from at query time ]                                          ##

<usage.provider.kimi> //= {};

my $provider = <usage.provider.kimi>;

$provider->{'label'}   //= 'Kimi plan usage';
$provider->{'enabled'} //= TRUE;
## usage.query reuses THIS SAME value both as the individual https request
## timeout [ clients.https.get inside plugin.usage.kimi.fetch ] AND as the
## overall allowed time for the whole query [ usage.handler.query_timeout ].
## a plain successful request is fast [ well under 8s ], but the expired-
## token path does a full refresh-and-retry cycle inside that same window --
## original request + up to ~18s for plugin.usage.kimi.refresh_token to spawn
## kimi and let it actually finish writing a fresh credential file + the
## retried request. 8s [ or even 10s, tried and still too tight live
## 2026-09-15 -- "provider did not report back in time" ] silently aborts the
## outer query before the inner refresh has a chance to complete
$provider->{'timeout'}   //= 25;
$provider->{'pending'}   //= {};       ##  in-flight requests by req_id  ##
$provider->{'last'}      //= undef;    ##  parsed numbers, last good query  ##
$provider->{'last_time'} //= 0;

## credential directory, relative to the home directory of the unix user ##
## this zenka runs as [ taeki ] -- resolved at query time, not stored    ##
$provider->{'cred_rel_dir'} //= '.kimi-code/credentials';

## kimi cli binary, same relative-to-home convention -- a bare 'kimi' open3
## call failed live 2026-09-15 [ "exec of kimi failed : No such file or
## directory" ]. confirmed cause : bin/Protocol-7 deliberately cleans
## $ENV{PATH} at startup, so it never carries the ~/.kimi-code/bin entry an
## interactive shell's .bashrc/.profile adds -- this relative path is the real
## fix, not a fallback for an unconfirmed guess [ see
## plugin.usage.kimi.refresh_token : it still tries file.which first, but that
## hits the exact same cleaned-PATH wall and will always come up empty here,
## so this is what actually does the work every time ]
$provider->{'cli_rel_path'} //= '.kimi-code/bin/kimi';

$provider->{'base_url'} //= $ENV{'KIMI_CODE_BASE_URL'}
    // 'https://api.kimi.com/coding/v1';

##  seconds under which a token counts as about to expire  ##
$provider->{'expiry_warn'} //= 120;

## proactive refresh watchdog : avoid paying the reactive refresh's ~15-21s ##
## spawn latency on the first real query to hit an expired token -- see     ##
## plugin.usage.kimi.refresh_watchdog. the FIRST arm happens in             ##
## usage.startup instead [ called post-drop-privs from zenka.v7 -- this     ##
## init_code runs during init_modules, before the drop, and arming the      ##
## timer here on first boot read the wrong [ pre-drop ] credential          ##
## directory, confirmed live 2026-09-17 ]. on a RELOAD, $reinit is TRUE [   ##
## base.init_modules passes it explicitly, no state-flag inference needed ] ##
## -- cancel whatever timer is already running and install a fresh one,     ##
## rather than leaving a stale one ticking alongside a duplicate            ##
$provider->{'proactive_refresh_margin'} //= 60;

if ($reinit) {
    my $old_timer = $provider->{'watchdog_timer'};
    $old_timer->cancel if defined $old_timer and $old_timer->is_active;
    $provider->{'watchdog_timer'} = <[event.add_timer]>->(
        {   'after'   => 0,
            'handler' => qw| plugin.usage.kimi.refresh_watchdog |,
            'data'    => {},
        }
    );
}

<[base.log]>->( 1, ': usage provider [ kimi ] initialized' );

0;

