## [:< ##

# name  = sessions.cmd.attach
# descr = reattach the key-holding child [ SIGUSR1 + redial ]

my $ok = <[sessions.holder.attach]>;

return {
    'mode' => qw| size |,
    'data' => sprintf(
        "%s\n", $ok ? '<< attached >>' : '<< attach ' . 'failed >>'
    )
};

