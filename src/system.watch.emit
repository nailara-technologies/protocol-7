## [:< ##

# name  = system.watch.emit
# descr = queue a signal for the events zenka
# args  = events.signal argument line
#
# kept in the registry until events answers TRUE, so a signal is not lost
# while events is away or this zenka restarts. delivery is at least once

my $args = shift;
<system.watch.seq> //= 0;
my $seq = ++<system.watch.seq>;
<system.watch.outbox>->{$seq}
    = { 'args' => $args, 'tries' => 0, 'next_at' => 0, 'state' => {} };
my @queued = sort { $a <=> $b } keys <system.watch.outbox>->%*;
while ( @queued > 89 ) {
    my $gone = shift @queued;
    <[base.logs]>->(
        0,
        '<< watch outbox full : dropped : %s >>',
        delete( <system.watch.outbox>->{$gone} )->{'args'}
    );
}
<system.watch.dirty> = TRUE;
<[system.watch.send_outbox]>;
return TRUE;

