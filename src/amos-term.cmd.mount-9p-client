## [:< ##
# name  = amos-term.cmd.mount-9p-client
# descr = Mount remote 9P filesystem (e.g., WSL host)

my $args = $call->{'args'} // '';
my ( $host, $port, $name ) = split m|\s+|, $args, 3;

$host //= '127.0.0.1';
$port //= <plan-9.default_port> // 15640;
$name //= "$host:$port";

## Connect to 9P server ##
my $result = <[plan-9.client]>->(
    {   'host' => $host,
        'port' => $port,
        'name' => $name,
    }
);

if ( $result->{'mode'} eq 'false' ) {
    return $result;
}

## Test connection by listing root ##
my $list_result = <[plan-9.client.list-dir]>->( $name, '/' );
my $entry_count = 0;
if ( $list_result->{'mode'} eq 'true' ) {
    my $entries = $list_result->{'data'};
    $entry_count = scalar @$entries;
}

return {
    'mode' => 'size',
    'data' => sprintf(
        "9P client connected to %s:%d (name: %s)\nRoot directory has %d "
            . "entries\n\nCommands:\n  p7c amos-term.list-dir %s /path\n  "
            . "p7c amos-term.read-file %s /path/to/file\n",
        $host, $port, $name, $entry_count, $name, $name
    )
};

