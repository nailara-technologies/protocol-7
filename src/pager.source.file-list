## [:< ##

# name  = pager.source.file-list
# descr = Pager data source: filesystem file listings

my ($args) = @ARG;

my $root            = $args->{'root'}            // '.';
my $recursive       = $args->{'recursive'}       // 1;
my $follow_symlinks = $args->{'follow_symlinks'} // 0;
my $batch_size      = $args->{'batch_size'}      // 100;
my $pattern         = $args->{'pattern'}         // '';
my $files_only      = $args->{'files_only'}      // 0;
my $dirs_only       = $args->{'dirs_only'}       // 0;

my @pending = ($root);

return {
    'type'   => 'file-list',
    'root'   => $root,
    'total'  => undef,         # Unknown until enumeration
    'cursor' => 0,

    'next_batch' => sub {
        my $batch = [];

        while ( @pending && @$batch < $batch_size ) {
            my $dir = shift @pending;

            opendir( my $dh, $dir ) or next;
            my @entries = readdir($dh);
            closedir($dh);

            for my $entry ( sort @entries ) {
                next if $entry eq '.' || $entry eq '..';

                my $path = "$dir/$entry";
                $path =~ s|//|/|g;

                if ( length $pattern ) {
                    my $re = eval {qr/$pattern/};
                    if ( not defined $re ) {
                        ## invalid regex : try glob-to-regex conversion ##
                        my $glob_re = $pattern;
                        $glob_re =~ s{\.}{\\.}g;
                        $glob_re =~ s{\*}{.*}g;
                        $glob_re =~ s{\?}{.}g;
                        $glob_re = '^' . $glob_re . '$';
                        $re      = eval {qr/$glob_re/};
                        if ( defined $re ) {
                            next if $entry !~ $re;
                        } else {
                            ## fall back to literal substring match ##
                            next if index( $entry, $pattern ) == -1;
                        }
                    } else {
                        next if $entry !~ $re;
                    }
                }

                my $st = File::stat::stat($path);
                next unless defined $st;

                my $is_dir     = -d $path;
                my $is_symlink = -l $path;
                my $type       = $is_dir ? 'dir' : 'file';

                next if $files_only && $type ne 'file';
                next if $dirs_only  && $type ne 'dir';

                my $item = {
                    'path'  => $path,
                    'name'  => $entry,
                    'size'  => $st->size,
                    'mtime' => $st->mtime,
                    'mode'  => $st->mode,
                    'type'  => $type,
                };

                push @$batch, $item;

                if ( $is_dir && $recursive ) {
                    push @pending, $path
                        unless ( $is_symlink && !$follow_symlinks );
                }
            }
        }

        return $batch;
    },

    'get_item_at' => sub {
        my ($idx) = @ARG;

        # For random access, would need index - currently sequential
        return undef;
    },

    'estimate_total' => sub {

        # Quick estimate using find -maxdepth 2 | wc -l
        my $estimate = `find "$root" -maxdepth 2 2>/dev/null | wc -l`;
        chomp $estimate;
        return $estimate || 1000;
    },
};

