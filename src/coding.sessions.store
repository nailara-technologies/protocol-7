## [:< ##

# name   = coding.sessions.store
# descr  = the session registry, file `sessions`
# args   = [ save ]
# return = name -> record
#
# p7 config style in the coding zenka's dir, one `session.<name>.<key> =
# value` line each ; read on first use after a start [ never in init_code :
# still root there ], written whole on `save`. a session with keep-alive
# off and no activity for coding.cfg.session_keep_seconds is dropped then
#
# keys : type via since last due [ epochs ], sent [ last keep-alive ],
# count fail, switch [ on | off ], until [ 0 : no limit ], note [ why the
# switch went off ], pending [ the agent's marker ], dispatches, sid [ the
# stable session id : the name is only its label ], was [ the name before,
# until listed once ], parked [ another sid took its name ]
# open.dispatch.<id> and open.wait.<id> hold descriptions only
#
# `alias.<old name>.sid \ until` lines : an old name of a sid, kept for the
# coding-session-alias interval [ <coding.sessions.aliases> ]

<[base.perlmod.load]>->('AMOS7::Switch')
    if not <[base.perlmod.loaded]>->('AMOS7::Switch');

my $op  = shift // '';
my $all = <coding.sessions.records>;
if ( ref $all ne qw| HASH | ) {
    $all = {};
    my $alias = {};
    my $sref  = <[file.zenka_dir.load]>->( 'sessions', ':encoding(UTF-8)' );
    foreach my $pair (
        AMOS7::Switch::parse_state( ref $sref eq 'SCALAR' ? $sref->$* : '' ) )
    {
        my ( $kind, $name, $key )
            = $pair->[0]
            =~ m{\A(session)\.(.+)\.(open\.(?:dispatch|wait)\.[\w-]+)\z};
        ( $kind, $name, $key )
            = $pair->[0] =~ m{\A(session|alias)\.([\w.\-]+)\.(\w+)\z}
            if not defined $key;
        next if not defined $key;
        ( $kind eq qw| alias | ? $alias : $all )->{$name}{$key}
            = AMOS7::Switch::unescape_value( $pair->[1] );
    }
    delete @{$all}{ grep { not defined $all->{$ARG}{'type'} } keys %{$all} };
    <coding.sessions.records> = $all;
    <coding.sessions.aliases> = $alias;
}
my $aliases = <coding.sessions.aliases> //= {};
return $all if $op ne qw| save |;

my $keep = <coding.cfg.session_keep_seconds> // 8 * 86400;
foreach my $name ( keys %{$all} ) {
    my $r = $all->{$name};
    ## a parked one is not reachable : its switch does not keep it ##
    delete $all->{$name}
        if ( $r->{'parked'} or ( $r->{'switch'} // '' ) ne qw| on | )
        and time - ( $r->{'last'} // $r->{'since'} // 0 ) > $keep;
}
my %known = map { $ARG->{'sid'} => 1 }
    grep { defined $ARG->{'sid'} } values %{$all};
foreach my $old ( keys %{$aliases} ) {
    delete $aliases->{$old}
        if exists $all->{$old}
        or not $known{ $aliases->{$old}{'sid'} // '' }
        or ( $aliases->{$old}{'until'} // 0 ) <= time;
}
my @pairs;
foreach my $name ( sort keys %{$all} ) {
    my $r = $all->{$name};
    push @pairs, map {
        [ "session.$name.$ARG", AMOS7::Switch::escape_value( $r->{$ARG} ) ]
    } grep { defined $r->{$ARG} } sort keys %{$r};
}
foreach my $old ( sort keys %{$aliases} ) {
    push @pairs,
        map { [ "alias.$old.$ARG", $aliases->{$old}{$ARG} ] } qw| sid until |;
}
my $text
    = AMOS7::Switch::format_state(
    'coding zenka : session registry [ edit only while it is stopped ]',
    @pairs );
<[base.logs]>->( 0, '<< sessions file not written : kept in memory only >>' )
    if not <[file.zenka_dir.write]>->(
    'sessions', \$text, '>', 0600, ':encoding(UTF-8)'
    );
return $all;

