## [:< ##

# name  = v7-zenki.sub-process.pid_alive
# descr = TRUE when <pid> is a live process, ANY owner/ancestry -- NOT a
#         security check, just liveness. see get_children's own note for
#         why this exists separately from base.exists.sub-process

my $pid = shift // '';
return FALSE if $pid !~ m|^\d+$|;
return -d sprintf( '/proc/%s', $pid ) ? TRUE : FALSE;

