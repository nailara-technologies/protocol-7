## [:< ##

# name  = events.remote.start
# descr = load remote pull state and arm each configured alias

<events.remote.runs>   //= {};
<events.remote.states> //= {};

foreach my $alias ( sort keys %{ <events.remote.pull> // {} } ) {
    next if $alias !~ m|\A[a-z0-9][a-z0-9_-]{0,62}\z|;
    my $names = <events.remote.pull>->{$alias};
    next if ref $names or not defined $names or not length $names;
    <events.remote.states>->{$alias} = <[events.remote.state]>->($alias);
    <[events.remote.arm]>->( $alias, TRUE );
}
return TRUE;

