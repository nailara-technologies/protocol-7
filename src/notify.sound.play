## [:< ##

# name   = notify.sound.play
# descr  = play a cue through bin/warning-sound -profile
# args   = profile [ soft | aware | alert ]
# return = TRUE when started, FALSE for a bad profile name

my $profile = shift // '';
return FALSE if $profile !~ m|\A[a-z]{1,20}\z|;

my $player = <notify.path.warning_sound>
    // sprintf( qw| %s/bin/warning-sound |, <system.root_path> );
## setsid -f returns at once : the cue plays without blocking the zenka ##
CORE::system( qw| setsid -f |, $player, '-profile', $profile );
return TRUE;

