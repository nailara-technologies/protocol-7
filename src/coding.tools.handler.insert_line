## [:< ##

# name  = coding.tools.handler.insert_line
# descr = insert a line before given line number

my $args    = shift               // {};
my $path    = $args->{'path'}     // return 'error : path required';
my $line    = $args->{'line'}     // return 'error : line number required';
my $content = $args->{'content'}  // return 'error : content required';
my $apply   = $args->{'apply'}    // TRUE;
my $raw_enc = $args->{'encoding'} // 'UTF-8';
my $norm_encoding = $raw_enc =~ m|^:| ? $raw_enc : ":encoding($raw_enc)";

## resolve and sanitize path : no Cwd, use string check ##
return 'error: path traversal not allowed' if $path =~ m{\.\.};
my $root     = <system.root_path>;
my $abs_path = "$root/$path";
return 'error: file not found' unless -f $abs_path;

my $line_num = int($line);
return 'error: line number must be >= 1' if $line_num < 1;

## read file into lines ##
my $file_content = <[file.read]>->( $abs_path, $norm_encoding );
return 'error: cannot read file' unless defined $file_content;
my @lines = split m|^|m, $file_content;

## clamp to append at end if line > total ##
$line_num = scalar(@lines) + 1 if $line_num > scalar @lines + 1;

if ($apply) {
    splice @lines, $line_num - 1, 0, "$content\n";

    ## use chmod child for write access if needed ##
    my $chmod_fh = <coding.chmod_child.w_fh>;
    my $mode_restore;
    if ( !-w $abs_path and defined $chmod_fh ) {
        my $cur_mode = File::stat::stat($abs_path)->mode & 07777;
        print {$chmod_fh} "gw $abs_path\n";
        my $gw_reply = <[coding.chmod_child.readline]>;    ## wait for gw ##
        if ( -w $abs_path ) {
            $mode_restore = $cur_mode;
        } elsif ( defined $gw_reply and $gw_reply eq qw| ok | ) {
            ## gw changed the mode but we still cannot write [ e.g. coding  ##
            ## zenka lacks admin group ] : revert so no permission drift is ##
            ## left behind when content falls through to staging            ##
            printf {$chmod_fh} "restore %04o %s\n", $cur_mode, $abs_path;
            <[coding.chmod_child.readline]>;    ## consume restore reply ##
        }
    }

    if ( -w $abs_path ) {
        <[file.write_encoded]>->( $norm_encoding, $abs_path, \@lines );
        if ( defined $mode_restore and defined $chmod_fh ) {
            print {$chmod_fh} sprintf "restore %04o %s\n", $mode_restore,
                $abs_path;
            <[coding.chmod_child.readline]>;    ## consume restore reply ##
        }
        return sprintf "inserted line before %d in %s\n  content: %s",
            $line_num, $path, $content;
    } else {
        my $stage_name = $abs_path =~ s{/}{__}gr;
        my $stage_path = catfile( <system.path.zenka-dirs.var_P7>,
            <system.zenka.name>, 'staged', $stage_name );

        ## stage the FULL file with the insertion already applied, not just ##
        ## the inserted line -- @lines already has it spliced in above, and ##
        ## each element retains its own trailing newline [ split /^/m ], so ##
        ## a plain join reproduces exactly what `print {$fh} @lines` did    ##
        my $full_content = join '', @lines;
        <[file.put]>->( $stage_path, \$full_content );

        return
              sprintf "SUCCESS: staged insert before line %d in %s [ staged "
            . "at: %s ] : do NOT verify with read_file, "
            . "original path unchanged until commit",
            $line_num, $path, $stage_path;
    }
}

return sprintf "preview: would insert before line %d\n  content: %s",
    $line_num, $content;

