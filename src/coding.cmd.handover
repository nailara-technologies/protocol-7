## [:< ##

# name  = coding.cmd.handover
# param = [ short | write ]
# descr = the live handover ; write : to a file
#
# write puts the full block into its file [ coding.handover.write ]. every
# call also asks the sources again for the next one

my ($sub) = ( $call->{'args'} // '' ) =~ m{\A\s*(\S*)\s*\z};
return { 'mode' => qw| false |, 'data' => 'handover [ short | write ]' }
    if not defined $sub or $sub !~ m{\A(?:|short|write)\z};
if ( $sub ne qw| write | ) {
    my $text
        = <[coding.handover.render]>->( $sub eq qw| short | ? TRUE : FALSE );
    <[coding.handover.refresh]>;
    return { 'mode' => qw| size |, 'data' => $text };
}
my ( $written, $result ) = <[coding.handover.write]>;
<[coding.handover.refresh]>;
return { 'mode' => qw| false |, 'data' => $result } if not $written;
return { 'mode' => qw| true |,  'data' => "handover written : $result" };

