## [:< ##

# name = web.assets.by_status
# descr = get assets by status from registry

my ($status) = @_;

my @assets;
foreach my $path ( keys %{ $data{'web'}{'assets'}{'registry'} } ) {
    push @assets, $data{'web'}{'assets'}{'registry'}{$path}
        if $data{'web'}{'assets'}{'registry'}{$path}{status} eq $status;
}

return @assets;

0;

