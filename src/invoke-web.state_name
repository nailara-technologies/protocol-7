## [:< ##

# name   = invoke-web.state_name
# descr  = state file name for the active install [ variant ] : queue item
#          ids and sessions belong to ONE invoke.ai database -- a variant
#          keeps its own copy, the default install the plain name
# param  = file name below state/
# return = 'state/<name>' | 'state/<name>.<variant>'

my $name    = shift                       // return undef;
my $variant = <invoke-web.variant_active> // qw| default |;

return $variant eq qw| default | ? "state/$name" : "state/$name.$variant";

