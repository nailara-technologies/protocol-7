# name = v7-zenki.sub-process.get_children

my $chk_pid = shift;

if ( not defined $chk_pid or $chk_pid !~ m|^\d+$| ) {
    ( my $caller_str = [ (caller) ]->[1] ) =~ s|^.+\.||g;
    warn sprintf '[%s] expected parent process id <{C1}>', $caller_str;
    return undef;
}

### old method ### [ heavy, non-portable, to be removed.. ]

## liveness check here is deliberately v7-zenki.sub-process.pid_alive, NOT
## base.exists.sub-process : the latter is waitpid-based and can only ever
## succeed for v7-zenki's own DIRECT children -- correct for its other 18+
## callers, but it silently excluded every real grandchild [ e.g. a coding
## zenka's own spawned llama-server ] from ever reaching the real security
## check below, not just stale ones. found+fixed 2026-09-17, see
## bug-v7-zenki-get-children-registry-gap-2026-09-17.md. this loop's real
## trust boundary was ALWAYS the $ppids{$pid} == $chk_pid walk below --
## genuine kernel ppid data from Proc::ProcessTable, unfakeable by a reporting
## zenka -- the liveness check here only ever needed to filter a dead/reused
## pid, never to establish ancestry. <v7-zenki.child> gates entry into
## consideration at all [ a zenka must have explicitly self- reported the pid
## first ], but that self-report is a candidate list, not proof -- the ppid
## walk below is what actually verifies it
my $proc_table = <v7-zenki.process.pt>
    //= new Proc::ProcessTable( qw| enable_ttys | => FALSE );

my %ppids;
my %start_times;
foreach my $proc ( reverse $proc_table->table->@* ) {
    next
        if not defined $proc->{'pid'}
        or not defined <v7-zenki.child>->{ $proc->{'pid'} }
        or not <[v7-zenki.sub-process.pid_alive]>->( $proc->{'pid'} );

    $ppids{ $proc->{'pid'} }       = $proc->{'ppid'};
    $start_times{ $proc->{'pid'} } = $proc->{'start'};
}

my %children;

my $found = 0;
foreach my $pid ( keys %ppids ) {
    if ( $ppids{$pid} == $chk_pid ) {
        $children{$pid}->{'checked'} = FALSE;
        $found++;
    }
}

while ($found) {
    $found = 0;
    foreach my $child_pid ( keys %children ) {
        next if $children{$child_pid}->{'checked'};
        foreach my $pid ( keys %ppids ) {
            if ( $ppids{$pid} == $child_pid ) {
                $children{$pid}->{'checked'} = FALSE;
                $found++;
            }
        }
        $children{$child_pid}->{'checked'} = TRUE;
    }
}

## "new method" : $chk_pid must be a zenka's OWN instance pid [ not a
## grandchild -- checked against <v7-zenki.zenka.instance>...process.id
## directly ]. deliberately LEFT on base.exists.sub-process here, not switched
## to pid_alive like the old method above : this block has no independent
## ppid-ancestry check at all, it just trusts  v7-zenki.instance_child_pids'
## self-reported list outright -- for $chk_pid's own direct children [ what
## this block is actually for ], waitpid's kernel-enforced "really my own
## child" property is real protection against a spoofed self-report, not
## incidental. swapping it for a same-UID-only liveness check here, with no
## ppid-walk backing it the way the old method has, would let a zenka
## self-report an arbitrary foreign pid and have it accepted outright once
## alive -- see  bug-v7-zenki-get-children-registry-gap-2026-09-17.md's
## security discussion. this block still can't resolve grandchildren [ same
## waitpid limit ], and that's fine : the old method above already handles
## that case correctly now, with its real ppid-walk intact
my $instance_id;
foreach my $id (<[v7-zenki.instance_ids]>) {
    $instance_id = $id
        and last
        if <[base.is_defined_recursive]>
        ->( sprintf( qw| v7-zenki.zenka.instance.%d.process.id |, $id ) ) == 5
        and $chk_pid == <v7-zenki.zenka.instance>->{$id}->{'process'}->{'id'};
}
if ( defined $instance_id ) {
    map { $children{$ARG} = TRUE if <[base.exists.sub-process]>->($ARG) }
        ( <[v7-zenki.instance_child_pids]>->($instance_id) );
}

return [
    reverse sort { $start_times{$b} // 0 <=> $start_times{$a} // 0 }
        reverse sort keys %children
];

