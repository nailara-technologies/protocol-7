## [:< ##

# name  = plugin.v7-zenki.hotspot.core_line
# descr = one output line of a :core: child : keep the backtrace
# args  = line [ octets ], handle

my ( $line, $handle ) = @ARG;
return if ref $handle ne qw| HASH |;
my $data = $handle->{'data'} // return;
my $job  = <v7-zenki.hotspot.jobs> { $data->{'job'} // '' } // return;
my $inst = $job->{'instances'}{ $data->{'iid'} // '' } // return;
return if not defined $inst->{'handle'} or $inst->{'handle'} != $handle;

push $inst->{'bt_lines'}->@*, $line;
return;

