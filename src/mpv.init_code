## [:< ##

# name = mpv.init_code

###  remove proxy environment variables ?  [ mpv.network.skip_proxy ]  ###
##
if ( <[base.cfg_bool]>->( <mpv.network.skip_proxy> //= FALSE ) ) {
    <[base.log]>->( 2, '[env] skip proxy is enabled' );
    foreach my $key ( keys %ENV ) {
        if ( $key =~ m{^proxy_|_proxy$}i ) {
            <[base.logs]>->( 2, '      : deleting : ENV{ %s }', $key );
            delete $ENV{$key};    ### make only direct network connections ##
        }
    }
}    # else {} ## log if a proxy set-up is detected ## [LLL]

<[base.perlmod.autoload]>->('JSON::XS');
<[base.perlmod.autoload]>->( 'IPC::Open3', qw | open3 | );
<[base.perlmod.autoload]>->('Linux::Inotify2');
<[base.perlmod.load]>->( 'File::Path', qw| make_path | );

<mpv.json.parser> = JSON::XS->new->pretty(0);

## WSLg pulse bridge cork/resume fix -- runs here [ not from start's own  ##
## early [module] calls ] because base.exec.with_timeout needs POSIX's    ##
## WNOHANG [ base.waitpid ] + IPC::Open3's open3, both only autoloaded by ##
## base.init_code, which has already run by this point                    ##
<[mpv.pulse.disable_idle_suspend]>;

<mpv.bin_path> //= <[base.required_bin_path]>->('mpv');

die "[!] mpv binary not found, aborting startup.,"
    if not defined <mpv.bin_path>
    or not length(<mpv.bin_path>)
    or not -x <mpv.bin_path>;

<[mpv.init_settings_map]>;

<list.settings> = {
    'var'      => qw| data |,
    'key'      => qw| mpv.map.settings |,
    'mask'     => '<key>:key_name key:mpv_setting_name',
    'defaults' => { 'key' => '<key>' },
    'align'    => { 'key' => 'center' },
    'descr'    => 'adjustable mpv set-up'
};

<mpv.current.volume>   //= 100;
<mpv.start_volume>     //= 100;   # <-- ./cfg/zenki/mpv
<mpv.fade_in>          //= FALSE; # <-- video fade (in)
<mpv.fade_idle_volume> //= TRUE;  # <-- audio zero-vol/fade-in on idle
<mpv.audio.fade_speed> //= 24;    # <-- audio volume fade speed [ 0..100 ]
<mpv.reply_ids>        //= [];
<mpv.command.reply>    //= [];
<mpv.pending_reply>    //= {};    ## reply bookkeeping, keyed by request_id ##
<mpv.pause_next>       //= FALSE;
<mpv.autorescale>      //= FALSE;
<mpv.disable_reenc_msg>  //= FALSE;
<mpv.file_map.rescaled>  //= {};
<mpv.xmode.xephyr.vo>    //= qw| gpu |;
<mpv.xmode.xephyr.hwdec> //= qw| auto |;
<mpv.fade_start_geom>    //= qw| 1x1--0--0 |;
<system.zenka.mode>      //= qw| stand-alone |;
<mpv.zenka_title>
    = <system.zenka.mode> eq qw| universal-child |
    ? qw| universal.mpv |
    : <system.zenka.name>;
<mpv.current.load_iteration> //= 0;
<mpv.cleanup_rescaled_after> //= 0; # <-- 0 [days] means no cleanup [disabled]
<mpv.cleanup_check_delay>    //= 42 + int( rand(237) );     # first file check
<mpv.cleanup_check_interval> //= 3600 + int( rand(7200) );  # 1-3 hrs [repeat]
<mpv.reenc_refresh_interval> //= 3.3;                       # seconds
<mpv.rescaled_extension>     //= qw| mp4 |;
<mpv.current.volume>         //= 100;                       # will be set to 0

# eventually changed to audio ['audio' subname]
<mpv.playlist_type> //= qw| video |;

<mpv.placement_mode> //= '';    ## zenka name to use for window placement ##
<mpv.restore_last_position>
    //= TRUE;    ## restore cached window position on startup ##
<mpv.last_saved_geometry>
    //= undef;    ## in-memory signature of last written profile ##

## state snapshot / restore [ see mpv.snapshot.* ] ##
<mpv.restore_on_startup>        //= TRUE;    ## replay state/snapshot.yaml ##
<mpv.snapshot_interval_seconds> //= 60;      ## periodic checkpoint ##

## dependency setup — callbacks auto-discovered from mpv.callback.object.* ##
<[dependency.install_callbacks]>->('mpv');

## socket dep: resolves when mpv ipc socket handle is open ##
<mpv.dep.socket> //= <[dependency.add_object]>
    ->( { 'type' => 'mpv_flag', 'flag_key' => 'mpv.socket' } );
<[dependency.add]>->( <mpv.dep.socket>, <mpv.dep.socket> );

## overriding ## no audio fade in 'universal-child' mode ## [LLL] change later
## ?
<mpv.fade_idle_volume> = FALSE if <system.zenka.mode> eq qw|universal-child|;

if ( <mpv.autorescale> and defined <mpv.rescale_path> ) {
    <[mpv.check_rescale_path]>;
    if ( defined <mpv.rescale_path>
        and <mpv.cleanup_rescaled_after> ) {    # <-- 0 == cleanup disabled
        <[base.logs]>->(
            2, ": rescale path does exist ['%s']",
            <mpv.rescale_path>
        );
        <mpv.timer.rescaled_check> = <[event.add_timer]>->(
            {   'after'    => <mpv.cleanup_check_delay>,
                'interval' => <mpv.cleanup_check_interval>,
                'handler'  => qw| mpv.handler.scan_encoded_timer |
            }
        );
    }
}

## periodic snapshot checkpoint [ player unreachable : timer skips ] ##
if (<mpv.snapshot_interval_seconds>) {
    <mpv.timer.snapshot> = <[event.add_timer]>->(
        {   'after'    => <mpv.snapshot_interval_seconds>,
            'interval' => <mpv.snapshot_interval_seconds>,
            'cb'       => sub {
                <[base.code.call_optional]>->(qw| mpv.snapshot.save |)
                    if defined <mpv.socket>;
            }
        }
    );
}

0;

