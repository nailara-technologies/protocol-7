## [:< ##

# name  = fetch-files.cmd.hf-download
# descr = download GGUF model file [HuggingFace]
# param = '{"repo":"..","file":"..gguf"}'

my $args_str = $call->{'args'} // '';

return {
    'mode' => qw| false |,
    'data' => 'args required : {"repo":"...","file":"..."}'
    }
    if not length $args_str;

my $args = eval { JSON::XS::decode_json($args_str) };
return {
    'mode' => qw| false |,
    'data' => sprintf( "invalid  JSON: %s", <[base.str.eval_error]> )
    }
    if $EVAL_ERROR;

return <[huggingface.download]>->( { 'args' => $args } );

