## [:< ##

# name  = plugin.usage.kimi
# descr = kimi usage provider plugin : main dispatch
# param = { operation => 'fetch' | 'cached' | 'config', ... }

my $args = shift // {};

my $operation = $args->{'operation'} // qw| fetch |;

my $provider = <usage.provider.kimi> // {};

if ( $operation eq qw| fetch | ) {

    return <[plugin.usage.kimi.fetch]>->($args);

} elsif ( $operation eq qw| cached | ) {

    ##  last parsed result, no network access [ numbers only ]  ##
    return {
        'mode' => qw| false |,
        'data' => 'no cached kimi usage value'
        }
        if not defined $provider->{'last'};

    return {
        'mode' => qw| true |,
        'data' => {
            'result' => $provider->{'last'},
            'age'    => time - ( $provider->{'last_time'} // 0 ),
        }
    };

} elsif ( $operation eq qw| config | ) {

    ##  never includes credential values : only where they are read from  ##
    return {
        'mode' => qw| true |,
        'data' => {
            'label'    => $provider->{'label'},
            'enabled'  => $provider->{'enabled'},
            'base_url' => $provider->{'base_url'},
            'timeout'  => $provider->{'timeout'},
            'pending'  => scalar keys $provider->{'pending'}->%*,
        }
    };

} else {

    return {
        'mode' => qw| false |,
        'data' => "unknown operation: $operation",
    };
}

