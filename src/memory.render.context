## [:< ##

# name = memory.render.context
# descr = plain ascii tree render for llm context injection

my $params = shift // {};
my $n      = $params->{'n'};

my $tree = <[memory.tree.render]>->( { variant => 'compact', n => $n } );
$tree //= '';

## [ write cache for cross-zenka context.memory.load consumption ]##
my $ntime_now = sprintf '%s', <[base.ntime]>;
my $wrote_txt = <[file.zenka_dir.write]>->(
    'memory-context-cache.txt', \$tree, '>', 0600, ':utf8'
);
my $wrote_nt = <[file.zenka_dir.write]>->(
    'memory-context-cache.ntime', \$ntime_now, '>', 0600, ':utf8'
);

if ( not defined $wrote_txt or not defined $wrote_nt ) {
    <[base.logs]>->( 1, ':. memory.render.context : cache write failed' );
}

return $tree;

