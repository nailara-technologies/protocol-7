## [:< ##

# name   = stream_child.write
# descr  = queue octets for the child's stdin, write them
# param  = handle, octets
# return = TRUE, or FALSE when stdin is closed

## what does not fit the pipe now waits in pend_in ; a write watcher drains ##
## it and ends itself when it is empty                                      ##

my ( $handle, $octets ) = @ARG;
return FALSE if not defined $handle or not defined $handle->{'in'};
$handle->{'pend_in'} .= $octets // '';
return <[stream_child.flush]>->($handle);

