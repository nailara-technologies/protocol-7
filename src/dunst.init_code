## [:< ##

# name  = dunst.init_code
# descr = initializes the dunst notification daemon zenka

<[base.perlmod.autoload]>->('IPC::Open3');

<x11.display>         //= ':0.0';
<dunst.path.exec_bin> //= qw| /usr/bin/dunst |;

<base.message_parsers.child_output> = [ $code{'base.parser.xclient-errors'} ];

if ( !-x <dunst.path.exec_bin> ) {
    ## [ PATH-based fallback ] ##
    my $path = <[file.which]>->('dunst');
    if ( defined $path and length $path and -x $path ) {
        <dunst.path.exec_bin> = $path;
    } else {
        die "dunst binary not found (please install 'dunst')";
    }
}

0;

