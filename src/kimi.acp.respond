## [:< ##

# name  = kimi.acp.respond
# descr = answer a request the child sent to us
# param = id, result | undef, error code, error message

my ( $id, $result, $code, $text ) = @ARG;

<[kimi.acp.write]>->(
    defined $code
    ? { 'id' => $id, 'error'  => { 'code' => $code, 'message' => $text } }
    : { 'id' => $id, 'result' => $result // {} }
);
return TRUE;

