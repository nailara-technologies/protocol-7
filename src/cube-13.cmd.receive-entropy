## [:< ##

# name  = cube-13.cmd.receive-entropy
# descr = receive entropy from zulum and route to active decoder
# param = <stream_id> <bits> <is_true> [decode_chunk]

my $args = $call->{'args'} // '';
my ( $stream_id, $entropy, $is_true, $decode_chunk ) = split m| +|, $args, 4;

<[base.log]>->(
    0, "[cube-13] receive-entropy called: sid=$stream_id is_true=$is_true"
);

return { 'mode' => qw| false |, 'data' => 'missing stream_id' }
    unless defined $stream_id;
return { 'mode' => qw| false |, 'data' => 'missing entropy' }
    unless defined $entropy;

$is_true //= 0;    ## default to false if not provided ##

## Update stream state ##
my $streams = <cube-13.streams>;
return { 'mode' => qw| false |, 'data' => "invalid stream $stream_id" }
    unless exists $streams->{$stream_id};

$streams->{$stream_id}{'is_true'} = $is_true;

## Get active stream ##
my $active_sid = <cube-13.active_stream>;

## Only forward if this is the active stream ##
if ( $stream_id == $active_sid ) {
    my $boundary = $streams->{$stream_id}{'boundary'};

    ## Route to decoder via main cube  Use send.local targeting decoder ##
    ## through main cube                                                ##
    my $chunk_arg = defined $decode_chunk ? " $decode_chunk" : '';
    <[protocol-7.command.send.local]>->(
        {   'command'   => 'decoder.receive-entropy',
            'call_args' =>
                { 'args' => "$stream_id $entropy $boundary$chunk_arg" },
        }
    );

    return {
        'mode' => qw| true |,
        'data' => "stream $stream_id forwarded [boundary:$boundary]"
    };
} else {
    ## Stream not active, just update state ##
    return {
        'mode' => qw| true |,
        'data' => "stream $stream_id state updated [inactive]"
    };
}

