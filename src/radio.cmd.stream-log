## [:< ##

# name  = radio.cmd.stream-log
# descr = radio stream connection log buffer

my $buffer = <buffer.radio-stream.data> // undef;

return { 'mode' => qw| size |, 'data' => '' }
    if not defined $buffer
    or ref $buffer ne qw| ARRAY |;

return {
    'mode' => qw| size |,
    'data' => join( "\n", $buffer->@* ) . "\n"
};

