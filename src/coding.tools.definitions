## [:< ##

# name  = coding.tools.definitions
# descr = OpenAI function-calling tool schemas for inference

## returns arrayref of tool definitions in OpenAI format  each tool maps to ##
## an existing $code{} module  encoding parameter defaults to UTF-8 for     ##
## backwards compatibility recognized encodings: UTF-8 (default), :raw,     ##
## :bytes  normalization will convert any encoding to UTF-8 internally      ##

## split 2026-09-24 from one 2262-line monolithic file into these category ##
## modules -- each is independently self-contained (own my @tools; ...     ##
## return \@tools;), this file only aggregates them. add a new tool to the ##
## category file it belongs in, not here                                   ##

my @tools;

push @tools, <[coding.tools.definitions.file_io]>->@*;
push @tools, <[coding.tools.definitions.notes]>->@*;
push @tools, <[coding.tools.definitions.module_introspection]>->@*;
push @tools, <[coding.tools.definitions.search]>->@*;
push @tools, <[coding.tools.definitions.git]>->@*;
push @tools, <[coding.tools.definitions.regex_tools]>->@*;
push @tools, <[coding.tools.definitions.format_lint]>->@*;
push @tools, <[coding.tools.definitions.tree]>->@*;
push @tools, <[coding.tools.definitions.user_interaction]>->@*;
push @tools, <[coding.tools.definitions.task_lifecycle]>->@*;
push @tools, <[coding.tools.definitions.utility]>->@*;
push @tools, <[coding.tools.definitions.scratchpad]>->@*;

## tool set [ optional { set => 'all' | 'core', groups => aref } ] : all ##
## [ default ] is every schema, as before. core is coding.tools.groups'  ##
## core list + the named groups + load_tools, which adds a group to the  ##
## running task -- every schema costs ~160 tokens on every request       ##
my $params = shift // {};
$params = {} if ref $params ne qw| HASH |;
my $set = $params->{'set'} // qw| all |;

if ( $set eq qw| core | ) {
    my $groups_href = <[coding.tools.groups]>;
    my %grouped;
    for my $group ( values %{ $groups_href->{'groups'} } ) {
        $grouped{$ARG} = TRUE for @{ $group->{'tools'} };
    }
    my %wanted = map { $ARG => TRUE } @{ $groups_href->{'core'} };
    for my $name ( @{ $params->{'groups'} // [] } ) {
        $wanted{$ARG} = TRUE
            for @{ $groups_href->{'groups'}{$name}{'tools'} // [] };
    }

    ## tools assigned to no group : offered as 'other', never lost ##
    my @other = grep { !$grouped{$ARG} and !$wanted{$ARG} }
        map { $ARG->{'function'}{'name'} } @tools;

    my @group_lines = map {
        sprintf '%s : %s [ %s ]', $ARG,
            $groups_href->{'groups'}{$ARG}{'descr'},
            join( ' ', @{ $groups_href->{'groups'}{$ARG}{'tools'} } )
    } sort keys %{ $groups_href->{'groups'} };
    push @group_lines, sprintf 'other : remaining tools [ %s ]', "@other"
        if @other;

    @tools = grep { $wanted{ $ARG->{'function'}{'name'} } } @tools;
    push @tools,
        {
        'type'     => 'function',
        'function' => {
            'name'        => 'load_tools',
            'description' => 'add a group of tools to this task [ available '
                . 'from your next step on ] when the ones you have are '
                . "not enough. groups :\n"
                . join( "\n", @group_lines ),
            'parameters' => {
                'type'       => 'object',
                'properties' => {
                    'group' => {
                        'type'        => 'string',
                        'description' => 'group name, several '
                            . 'separated by spaces',
                    },
                },
                'required' => ['group'],
            },
        },
        };
}

## moved here from mid-list [ was logging a partial count after            ##
## write_append alone, not the real total -- correct position for this log ##
## line is once every category has actually been aggregated ]              ##
<[base.logs]>->(
    2,
    ':. tools.definitions: %d tools available',
    scalar @tools
);

return \@tools;

