## [:< ##

# name  = amos-term.cmd.window-open
# descr = Open GTK3 window for existing buffer

my $amos_id = $call->{'args'};
$amos_id =~ s/^\s+|\s+$//g;    # trim whitespace

return {
    'mode' => 'false',
    'data' => "Error: AMOS ID required\n"
    }
    unless defined $amos_id and length $amos_id;

my $result = <[amos-term.window-open]>->("amos:$amos_id");

return {
    'mode'     => 'true',
    qw| data | => ( $result ? "Window opened\n" : "Error: open failed\n" )
};

