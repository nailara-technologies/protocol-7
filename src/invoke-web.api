## [:< ##

# name   = invoke-web.api
# descr  = one request to the local invoke.ai rest api [ 3s timeout, never
#          through a proxy ] -- returns { ok, code, status, data }
# param  = method [ GET | PUT | POST ], path [ '/api/v1/..' ],
#          [ request data : a perl structure, sent as json ]

my $method  = uc( shift // qw| GET | );
my $path    = shift // '/';
my $payload = shift;

my $url = <invoke-web.url> // 'http://127.0.0.1:9090';
my $ua  = LWP::UserAgent->new( timeout => 3 );
$ua->no_proxy( 'localhost', '127.0.0.1' );    ## local api : direct ##

my $request = HTTP::Request->new( $method, "$url$path" );
if ( defined $payload ) {
    $request->header( 'Content-Type' => 'application/json' );
    $request->content( JSON::PP::encode_json($payload) );
}

my $response = $ua->request($request);
my $body     = $response->decoded_content // '';
my $decoded  = eval { JSON::PP::decode_json($body) };

return {
    'ok'     => $response->is_success ? TRUE : FALSE,
    'code'   => $response->code,
    'status' => $response->status_line,
    'data'   => $decoded // $body,
};

