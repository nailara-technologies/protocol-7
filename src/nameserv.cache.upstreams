## [:< ##

# name  = nameserv.cache.upstreams
# descr = upstream resolver list for the forwarding cache [ read once ]

## configured static ips come first, then active per-source lists. scoped ##
## sources replace that list for their domains ; local names use static   ##
## only. without selected entries resolv.conf supplies the fallback       ##

my $qname     = shift // '';
my @upstreams = <[nameserv.cache.route_upstreams]>->($qname);

if (    not scalar @upstreams
    and not <[nameserv.cache.own_name]>->($qname) ) {
    if ( open my $fh, '<:encoding(UTF-8)', '/etc/resolv.conf' ) {
        while ( my $line = <$fh> ) {
            next unless $line =~ m{^\s*nameserver\s+(\S+)}i;
            my $ip = $1;
            next if <[nameserv.cache.client_allowed]>->($ip);
            push @upstreams, $ip;
        }
        close $fh;
    }
}

return @upstreams;

