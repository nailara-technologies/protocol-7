## [:< ##

# name = coding.task.enqueue
# descr = enqueue coding task with jobqueue backend
# purpose = coding task management : wrapper around jobqueue.add_job with
#           priority calculation and duplicate detection

my ($task) = @ARG;

return {
    success => FALSE,
    error   => 'task must be a hashref'
    }
    unless ref($task) eq qw| HASH |;

return {
    success => FALSE,
    error   => 'task must have id'
    }
    unless exists $task->{id};

my $task_id = $task->{id};

## step 1: add to coding queue (for rich data + duplicate detection) ##
my $queue_href   = <coding.task.queue>   //= {};
my $aref_pending = <coding.task.pending> //= [];

## prevent duplicates ##
if ( exists $queue_href->{$task_id} ) {
    return {
        success       => FALSE,
        error         => "task already in queue: $task_id",
        existing_task => $queue_href->{$task_id}
    };
}

## cancel buffer save/drop timers : new task is active ##
for my $timer_key (qw| task_buffer_save task_buffer_drop |) {
    my $t = <coding.timer>->{$timer_key};
    if ( defined $t && ref $t && $t->is_active ) {
        $t->cancel;
        <[base.logs]>->( 2, "enqueue: cancelled %s timer", $timer_key );
    }
}

## store task in coding queue ##
$queue_href->{$task_id} = {
    %$task,
    queued_at      => <[base.time]>->(3),
    queue_position => scalar( $aref_pending->@* )
};

## add to pending list ##
push $aref_pending->@*, $task_id;

## step 2: add to jobqueue (for auto-execution) ##
my $priority
    = <[coding.helper.task_priority]>->( $task->{type} // 'general', $task );

## determine which inference server to depend on ##
my $routed_to = $task->{'analysis'}->{'routed_to'} // 'gpu';
my $dep_object_id
    = $routed_to eq 'cpu'
    ? ( <coding.dep.cpu_server> // 0 )
    : ( <coding.dep.gpu_server> // 0 );

my $job_params = {
    name            => $task_id,
    priority        => $priority,
    object_id       => $dep_object_id,
    target_queue    => 'queued',
    job_callback    => 'coding.task.execute',
    callback_params => { task_id => $task_id },
};

my $job_id = <[jobqueue.add_job]>->($job_params);

<[base.logs]>->( 2, "task enqueued : %s [job_id=%s]", $task_id, $job_id );

return {
    success    => TRUE,
    job_id     => $job_id,
    task_id    => $task_id,
    queue_size => scalar( $aref_pending->@* ),
    message    => "task enqueued: $task_id"
};

