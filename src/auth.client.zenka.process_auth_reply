## [:< ##

# name  = auth.client.zenka.process_auth_reply
#
# param = <backend_socket> [, <success_message> [, <result hashref> ] ]
# note  = the optional result hashref is an OUT-param for the link
#         supervisor's failure classes [ LINK-ZENKI-AND-TRANSPORTS.md ] :
#         on failure 'class' is set to trust [ refusal, auth_methods,
#         protocol mismatch -- the far end spoke and declined ] or
#         transport [ connection lost, timeout -- the stream died ].

my $backend_socket  = shift;
my $success_message = shift // 'success., =), cube authorized session.';
my $result_out      = shift;

my $fail_class = sub {
    $result_out->{'class'} = shift if ref $result_out eq qw| HASH |;
    return undef;
};

my $protocol_messages  = <protocol.protocol-7.connect>;
my $protocol_banner    = $protocol_messages->{'banner'};
my $proto_msg_timeout  = $protocol_messages->{'timeout'};
my $protocol_error_msg = $protocol_messages->{'protocol_error'};

if (   not defined $backend_socket
    or !-S $backend_socket
    or !$backend_socket->connected ) {
    <[base.log]>->(
        0,
        'cannot authenticate [ expecting valid socket ] '
            . <[base.caller]>->(1)
    );
    return $fail_class->(qw| transport |)
        if ref $result_out eq qw| HASH |;
    return undef;
}

( my $plugin = <[base.caller]>->(1) ) =~ s|^.*\[([^\.]+\.[^\.]+):\d+\]|${1}|;

if ( my $answer = readline($backend_socket) ) {
    chomp($answer) if defined $answer;
    if ( not defined $answer ) {
        <[base.log]>->( 0, '[X] connection lost :|' );
        <[base.logs]>->( 2, '::: [ %s ]', $plugin );
        return $fail_class->(qw| transport |);
    } elsif ( $answer eq 'AUTH_TRUE =)' ) {
        <[base.logs]>->( 1, '[*] %s',     $success_message );
        <[base.logs]>->( 2, '::: [ %s ]', $plugin );
        return $backend_socket;
    } elsif ( $answer eq 'AUTH_ERROR `>:|' ) {
        <[base.log]>->( 0, '[#] authentication error >:|' );
        <[base.logs]>->( 2, '::: [ %s ]', $plugin );
        return $fail_class->(qw| trust |);
    } elsif ( $answer =~ m|^AUTH_ERROR (\S.*)$| ) {
        ## a refusal with its reason                                     ##
        ## [ auth-keypair : not authorized, TOFU mismatch, .. ] -- not a ##
        ## protocol mismatch  remote text                                ##
        my $reason = substr( $1 =~ s{[^\x20-\x7e]}{}gr, 0, 120 );
        <[base.logs]>->( 0, '[#] authentication refused : %s', $reason );
        <[base.logs]>->( 2, '::: [ %s ]',                      $plugin );
        return $fail_class->(qw| trust |);
    } elsif ( $answer eq '>:| timeout' ) {
        <[base.log]>->( 0, '[#] authentication timeout :|' );
        <[base.logs]>->( 2, '::: [ %s ]', $plugin );
        return $fail_class->(qw| transport |);
    } elsif ( $answer eq ':| auth_methods' ) {
        <[base.log]>->( 0, '[#] server side auth nethods error :|' );
        <[base.logs]>->( 2, '::: [ %s ]', $plugin );
        return $fail_class->(qw| trust |);
    } elsif ( $answer eq '>:| auth_methods' ) {
        <[base.log]>->( 0, '[#] client side auth nethods error :|' );
        <[base.logs]>->( 2, '::: [ %s ]', $plugin );
        return $fail_class->(qw| trust |);
    } else {    ##  >:[ speak protocol ? .., ##
        <[base.logs]>->( 0, '[#] protocol mismatch :| [ %s ]', $plugin );
        <[base.logs]>->( 0, '::: \'%s\'',                      $answer );
        return $fail_class->(qw| trust |);
    }
} else {
    <[base.log]>->( 0, '[X] connection lost :|' )
        and return $fail_class->(qw| transport |);
}

