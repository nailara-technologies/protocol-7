## [:< ##

# name  = zenki.parent.start_via_v7
# descr = start zenka via v7-zenki's jobqueue system
#         [ integrates with v7-zenki's dependency resolution ]

my $params = shift || {};

my $zenka_name = $params->{'zenka_name'} || $params->{'zenka'};
my $reply_id   = $params->{'reply_id'};

unless ($zenka_name) {
    return {
        success => FALSE,
        error   => 'zenka_name parameter required'
    };
}

<[base.logs]>->(
    2, "zenki.start_via_v7: requesting v7-zenki to start '%s'..,",
    $zenka_name
);

## ensure v7-zenki is running [ this is the dependency resolution entry ] ##
my $v7_result = <[zenki.parent.ensure_v7]>;

unless ( $v7_result->{'success'} ) {
    return {
        success => FALSE,
        error   => "cannot start $zenka_name : v7-zenki not available - "
            . ( $v7_result->{'error'} || 'unknown error' ),
        v7_error => $v7_result
    };
}

<[base.logs]>->(
    3, '  ✓ v7-zenki is ' . 'running [ pid %s ]',
    $v7_result->{'pid'}
) if exists $v7_result->{'pid'};

## v7-zenki is up - are we running inside it, or talking to it ? ##
my $inside_v7 = (
    exists $code{'v7-zenki.zenka.cmd.start'}    ## v7-zenki specific sub ##
        or exists <v7-zenki.zenka.setup>        ## v7-zenki data tree ##
) ? TRUE : FALSE;

if ($inside_v7) {
    ## inside v7-zenki : use its native start mechanism ##
    <[base.log]>->( 3, '  using v7-zenki\'s native zenka.cmd.start' );

    ## call v7-zenki's start command [ with dependency resolution ] ##
    my $result = <[v7-zenki.zenka.cmd.start]>->( { args => $zenka_name } );

    if ( $result->{'mode'} eq qw| true | ) {
        return {
            success => TRUE,
            via_v7  => 1,
            message => $result->{'data'}
        };
    } else {
        return {
            success => FALSE,
            via_v7  => 1,
            error   => $result->{'data'}
        };
    }
}

## outside v7-zenki : relay the request over cube ##
<[base.log]>->( 3, '  sending ipc command to v7-zenki via cube' );

## check if the ipc capable namespaces are loaded ##
unless ( exists $code{'protocol-7.command.send.local'} ) {
    return {
        success => FALSE,
        error   => 'zenki started without ipc support [ net '
            . '\ protocol \ io.unix namespaces missing ]',
        hint => 'see zenki.cfg.cmd-modules.<command> '
            . 'in cfg/zenki/zenki/zenka.v7'
    };
}

## check if connected to cube ##
unless ( exists $data{'session'} and keys $data{'session'}->%* ) {
    return {
        success => FALSE,
        error   => 'not connected to cube - cannot reach v7-zenki',
        hint    => 'zenki connects via [base.net.connect:\'unix\'] '
            . 'in zenki.parent.start-up'
    };
}

## send the start command to v7-zenki [ route-send prefixes the parent ##
## route, so this leaves as '<cube>.v7-zenki.start' ]                  ##
my $cmd_count = <[protocol-7.route-send]>->(
    {   'command'   => qw| v7-zenki.start |,
        'call_args' => { 'args' => $zenka_name },
        'reply'     => {
            'handler' => qw| zenki.handler.v7_start_reply |,
            'params'  => {
                'zenka_name' => $zenka_name,
                'reply_id'   => $reply_id
            }
        }
    }
);

if ( $cmd_count and $cmd_count > 0 ) {
    <[base.logs]>->(
        2, "  ✓ start request sent to v7-zenki for '%s'", $zenka_name
    );

    return {
        success => TRUE,
        via_ipc => 1,
        message => 'start request queued via v7-zenki [ reply pending ]'
    };
}

return {
    success   => FALSE,
    error     => 'failed to send ipc command to v7-zenki',
    cmd_count => $cmd_count
};

0;

