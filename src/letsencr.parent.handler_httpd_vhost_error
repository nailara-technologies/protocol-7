## [:< ##

# name  = letsencr.parent.handler_httpd_vhost_error
# descr = handle errors in httpd vhost list query
#         - stores error state and triggers recovery

my ( $error_msg, $reply_data ) = @ARG;

<[base.log]>->( 1, "httpd vhost query error : $error_msg" );

## Store error state for consumer
<letsencr.parent.pending_vhosts> = {
    status => qw| error |,
    error  => $error_msg,
    reply  => $reply_data,
    vhosts => [],
};

## Log reply details for debugging if available
if ( $reply_data && ref($reply_data) eq qw| HASH | ) {
    <[base.log]>->(
        3, "error reply data: " . join( ', ', keys %$reply_data )
    );
}

## TODO: Implement retry mechanism or fallback strategy  Options:
## 1. Retry with exponential backoff
## 2. Use cached vhost list from previous successful query
## 3. Use hardcoded fallback list or primary domain only
## 4. Skip renewal check and try again next cycle

if ( exists <letsencr.parent.vhosts_cache> ) {
    <[base.log]>->(
        2,
        "using cached vhost list from "
            . scalar( gmtime( <letsencr.parent.vhosts_cache>->{timestamp} ) )
    );

    ## Fall back to cached list
    <letsencr.parent.pending_vhosts> = {
        status => 'cached',
        vhosts => <letsencr.parent.vhosts_cache>->{vhosts},
    };
} else {
    <[base.log]>->(
        1, "no cached vhost list available, renewal check will be skipped"
    );
}

return FALSE;

