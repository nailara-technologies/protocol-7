## [:< ##

# name  = screen.setup.dpi.report
# descr = format the dpi value and independent consumer statuses
# param = { value, results, dry_run } -> text

my $args  = shift // {};
my @lines = sprintf 'desktop.dpi = %d%s', $args->{'value'},
    $args->{'dry_run'} ? ' [dry-run]' : '';
push @lines, map {"$_ : $args->{'results'}{$_}"} qw| xrdb gtk tint2 openbox |;
return join "\n", @lines;

