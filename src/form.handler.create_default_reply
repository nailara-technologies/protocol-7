## [:< ##

# name  = form.handler.create_default_reply
# descr = handle the users.create-default reply

## reply-handler call signature is a SINGLE hashref { sid, cmd, call_args,
## params, data? } ; TRUE/FALSE carry their message in call_args->{'args'}.
##
## on success this RE-SENDS users.value-get through the ordinary
## form.handler.value_get_reply path and stays INSIDE the event loop, so the
## schema / frame / render / raw-mode sequence runs exactly as it does for a
## record that existed all along -- no second code path, and no second unloop.

my ($info) = @ARG;

my $cmd       = uc( $info->{'cmd'} // '' );
my $call_args = $info->{'call_args'} // {};
my $username  = <form.username>      // '?';

if ( $cmd ne qw| TRUE | ) {
    ## message passed INTO form.quit : it clears the screen first ##
    <[form.quit]>->(
        sprintf(
            'could not create the record [ %s ] : %s',
            lc($cmd), $call_args->{'args'} // 'no detail'
        ),
        qw| fail |
    );
    return FALSE;
}

<[base.logs]>->( 2, ': default record created [ %s ]', $username );

my $cube_sid = <form.cube_sid>;

if ( not defined $cube_sid or not exists $data{'session'}{$cube_sid} ) {
    <[form.quit]>->(
        'record created, but the link is gone — run the command again',
        qw| fail |
    );
    return FALSE;
}

## fetch what we just created ; create.attempted was set before the send, so a
## still-missing record cannot loop back into another offer
my $source = <form.source>          // return FALSE;
my $sender = $source->{'value_get'} // return FALSE;

<[$sender]>->( $username, qw| form.handler.value_get_reply | );

return TRUE;

