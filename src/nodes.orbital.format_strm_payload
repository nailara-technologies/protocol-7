# name  = nodes.orbital.format_strm_payload
# descr = format orbital position data as a STRM push payload
# param = \%data [ theta/phi/psi/omega/p7ref/session_start/computed_at ]

my $d = shift // {};

my $payload = '';
for my $key ( sort keys %$d ) {
    my $val = $d->{$key} // '';
    $val = sprintf '%.6f', $val
        if $val =~ m|^\d+\.\d+$| and $key =~ m{^(theta|phi|psi|omega)$};
    $payload .= sprintf "  %s  %s\n", $key, $val;
}

return $payload;

