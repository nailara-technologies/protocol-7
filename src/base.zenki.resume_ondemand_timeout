## [:< ##

# name  = base.zenki.resume_ondemand_timeout
# descr = resume on-demand idle-shutdown tracking after a paired
#         base.zenki.pause_ondemand_timeout call -- restarts the idle
#         window fresh from now rather than picking up mid-way ; safe to
#         call without a prior pause [ no-op if nothing was saved ]

return if not defined <base.ondemand.saved_timeout>;

<system.ondemand_timeout> = <base.ondemand.saved_timeout>;
delete <base.ondemand.saved_timeout>;

<base.ondemand.last_activity> = <[base.ntime]>;

## give the idle watcher a prompt chance to re-check instead of waiting on ##
## the next unrelated I/O event [ same nudge as base.stream.close ]        ##
<watcher.io.transfer>->start
    if defined <watcher.io.transfer>
    and not <watcher.io.transfer>->is_active;

