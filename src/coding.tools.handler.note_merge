## [:< ##

# name  = coding.tools.handler.note_merge
# descr = combine notes from multiple sections or tasks

my $args = shift // {};

my $sources = $args->{'sources'}        // '';
my $target  = $args->{'target_section'} // '';
my $task_id = $args->{'task_id'}        // '';

return { 'content' => 'sources and target_section required' }
    unless length $sources && length $target;

## call backend ##
my $result = <[note.merge]>
    ->( $sources, $target, length $task_id ? $task_id : undef, );

return {
    'content' => $result->{'mode'} eq qw| true |
    ? $result->{'data'}
    : "Failed: " . ( $result->{'data'} // 'unknown' ),
};

