## [:< ##

# name  = screenshot.pixel_color
# descr = return rgba values for a pixel in an Imager object

my ( $image, $pos_x, $pos_y ) = @ARG;

if ( ref( $image // '' ) ne qw| Imager | ) {
    warn 'expected image as Imager object <{C1}>';
    return undef;
}
if (   not defined $pos_x
    or $pos_x !~ m|^\d+$|
    or not defined $pos_y
    or $pos_y !~ m|^\d+$| ) {
    warn 'expected pixel position parameters <{C1}>';
    return undef;
}

my $pixel = $image->getpixel( 'x' => $pos_x, 'y' => $pos_y )
    or return Imager->errstr;

my @rgba = $pixel->rgba;
return @rgba if @rgba;
return Imager->errstr;

