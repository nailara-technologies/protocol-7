## [:< ##

# name  = coding.gpu_lease.handler.renew_reply
# descr = stop and requeue if models says this lease is no longer ours

my $reply = shift // {};
my ($mode) = <[base.reply.mode_text]>->($reply);
return TRUE if $mode eq qw| true |;
return TRUE if ( <coding.gpu_lease.holder> // '' ) ne qw| coding |;
<[base.logs]>->( 0, ': gpu lease renewal refused : yielding gpu residency' );
return <[coding.cmd.gpu-lease-yield]>->( { 'args' => qw| coding | } );

