## [:< ##

# name  = coding.gpu_lease.handler.renew_reply
# descr = stop and requeue if models says this lease is no longer ours

my $reply = shift // {};
my ( $mode, $text ) = <[base.reply.mode_text]>->($reply);
return TRUE if $mode eq qw| true |;
return TRUE if ( <coding.gpu_lease.holder> // '' ) ne qw| coding |;

## only models saying so ends the lease : an unreachable models is no     ##
## refusal, stop asking until it is back -- a renewal would also start it ##
## on demand                                                              ##
if ( $text ne 'not holder' ) {
    my $renew = delete <coding.gpu_lease.renew_timer>;
    $renew->cancel if defined $renew and $renew->is_active;
    <coding.gpu_lease.renew_timer> = <[event.add_timer]>->(
        {   'after'   => 300,    ## a notification can get lost ##
            'handler' => qw| coding.gpu_lease.handler.renew |,
        }
    );
    return TRUE if <coding.gpu_lease.models_waiting>;
    <coding.gpu_lease.models_waiting> = TRUE;
    <[base.logs]>->(
        1, ': models not reachable [ %s ] : lease renewal waits', $text
    );
    <[protocol-7.route-send]>->(
        {   'command'   => qw| v7-zenki.notify_online |,
            'call_args' => { 'args' => qw| models | },
            'reply'     => {
                'handler' => qw| coding.gpu_lease.handler.models_back |,
                'params'  => {},
            },
        }
    );
    return TRUE;
}
<[base.logs]>->( 0, ': gpu lease renewal refused : yielding gpu residency' );
return <[coding.cmd.gpu-lease-yield]>->( { 'args' => qw| coding | } );

