## [:< ##

# name  = thermal.window.current
# descr = select the day or night schedule window

my ($epoch) = @ARG;

my $range = <thermal.cfg.window.night> // qw| 22:00-06:00 |;
return qw| day |
    if $range !~ m|^\s*([0-9]{2}):([0-9]{2})\s*-\s*([0-9]{2}):([0-9]{2})\s*$|;

my ( $start_hour, $start_min, $end_hour, $end_min ) = ( $1, $2, $3, $4 );
return qw| day |
    if $start_hour > 23
    or $end_hour > 23
    or $start_min > 59
    or $end_min > 59;

my ( $minute, $hour ) = ( localtime($epoch) )[ 1, 2 ];
my $time  = $hour * 60 + $minute;
my $start = $start_hour * 60 + $start_min;
my $end   = $end_hour * 60 + $end_min;

if ( $start <= $end ) {
    return qw| night | if $time >= $start and $time < $end;
} else {
    return qw| night | if $time >= $start or $time < $end;
}

return qw| day |;

