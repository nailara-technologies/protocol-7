## [:< ##

# name  = network.status.backend
# descr = which base network layer runs

my $proc = <network.cfg.proc_root>;
my %running;
if ( opendir( my $dh, $proc ) ) {
    foreach my $pid ( grep {m|^\d+$|} readdir($dh) ) {
        my $comm = <[network.read_line]>->("$proc/$pid/comm") // next;
        ## comm is cut to 15 chars : systemd-networkd reads systemd-network ##
        $running{'dhcpcd'}         = 1 if $comm eq qw| dhcpcd |;
        $running{'networkd'}       = 1 if $comm =~ m|^systemd-network|;
        $running{'NetworkManager'} = 1 if $comm eq qw| NetworkManager |;
        $running{'wpa_supplicant'} = 1 if $comm eq qw| wpa_supplicant |;
    }
    closedir($dh);
}
## ifupdown counts only when it brings up more than lo : a debian base     ##
## always ships an interfaces file with lo, so the file alone says nothing ##
my $ifupdown = 0;
my $non_lo   = sub {
    my ( $path, $pattern ) = @ARG;
    open( my $fh, '<', $path ) or return 0;
    my $found = 0;
    while ( my $line = readline($fh) ) {
        next       if $line !~ $pattern;
        $found = 1 if ${^CAPTURE}[0] ne qw| lo |;
    }
    close($fh);
    return $found;
};
## ifstate lines read 'eth0=eth0' : written by ifup, empty when none ran ##
$ifupdown = 1
    if $non_lo->( <network.cfg.ifupdown_state>, qr|^\s*([^=\s]+)=| );
my $ifupdown_cfg = 0;
foreach my $path ( <network.cfg.ifupdown_conf>,
    glob( <network.cfg.ifupdown_conf> . qw| .d/* | ) ) {
    $ifupdown_cfg = 1 if $non_lo->( $path, qr|^\s*iface\s+(\S+)| );
}
my @backend;
push @backend, qw| NetworkManager | if $running{'NetworkManager'};
push @backend, qw| networkd |       if $running{'networkd'};
push @backend, $running{'dhcpcd'} ? qw| ifupdown+dhcpcd | : qw| ifupdown |
    if $ifupdown;
## configured for more than lo but nothing brought up by ifup ##
push @backend, qw| ifupdown-idle | if $ifupdown_cfg      and not $ifupdown;
push @backend, qw| dhcpcd |        if $running{'dhcpcd'} and not $ifupdown;
return {
    qw| backend |      => @backend ? join( ' ', @backend ) : qw| none |,
    qw| running |      => [ sort keys %running ],
    qw| ifupdown |     => $ifupdown,
    qw| ifupdown_cfg | => $ifupdown_cfg,
};

