# name  = base.log.forced_console
# descr = base.logs wrapper that guarantees the line reaches console output
#          regardless of configured verbosity -- for lines an external
#          process depends on reading back off raw stdout [ eg v7's
#          zenka-output pattern matcher, see cfg/zenki/v7-zenki/
#          zenka-output.patterns : 'cube session id received [...]' triggers
#          zenka.set_cube_sid, which is what sends verify-instance in the
#          first place, and 'instance verification [KEY:...]' confirms it ].
#          silenced console verbosity would otherwise drop these lines
#          before they're ever written, stalling the v7 startup handshake
#          silently -- the instance itself runs fine, it just never gets
#          past 'starting' from v7's point of view.
# param = same as base.logs: [level] fmt args...

my $level = ( scalar @ARG > 1 and $ARG[0] =~ m|^\d$| ) ? $ARG[0] : 1;

my $console_verbosity_bak = <system.zenka.verbosity.console>;
my $forced                = ( not defined $console_verbosity_bak )
    || ( $console_verbosity_bak < $level );
<system.zenka.verbosity.console> = $level if $forced;

<[base.logs]>->(@ARG);

<system.zenka.verbosity.console> = $console_verbosity_bak if $forced;

