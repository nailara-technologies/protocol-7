## [:< ##

# name = plugin.auth.auth-keypair.init_code
# descr = Initialize auth-keypair plugin, set up cleanup routine

my $reinit = shift;    ## provided by 'base.init_modules' [TRUE|FALSE] ##

## reinit : re-read the authorized keys                                    ##
## [ the first load is the zenka.v7 call after init_modules ] -- rotated \ ##
## revoked client keys apply ; between reinits the directory watches       ##
## re-read them                                                            ##
if ($reinit) {
    <[plugin.auth.auth-keypair.load-authorized-users]>;
    <[plugin.auth.auth-keypair.watch-authorized]>;
}

##  Run initial cleanup of expired unpinned keys  ##
my $initial_cleanup = <[plugin.auth.auth-keypair.cleanup-incoming-keys]>;
if ( defined $initial_cleanup ) {
    <[base.logs]>->(
        2, "auth-keypair: initial cleanup removed %d expired keys",
        $initial_cleanup
    );
}

## Set up periodic cleanup via event system  Cleanup runs every 6 hours by ##
## default                                                                 ##
my $cleanup_interval = <plugin.auth.auth-keypair.cleanup_interval_seconds>
    //= 21600;    ## 6 hours ## [LLL] optimize for more 'harmonic' values

<[base.logs]>->(
    2, "auth-keypair: cleanup interval set to %d seconds [%.1fh]",
    $cleanup_interval, $cleanup_interval / 3600
);

0;

