## [:< ##

# name   = host-edit.flow.cancel
# descr  = cancel an add-host flow [ stops its ssh forward ]
# param  = <record name>

my $name = shift // '';

my $s = delete( ( <host-edit.flow> // {} )->{$name} );
<[host-edit.transport.ssh_forward_stop]>->($name)
    if ref $s eq qw| HASH | and $s->{'forwarded'};
<[host-edit.flow.status]>->( $name, 'cancelled' );
return TRUE;

