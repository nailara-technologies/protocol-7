## [:< ##

# name  = vault-edit.handler.esc_timeout
# descr = a lone Esc that stayed lone is a real Esc keypress
#         [ user-edit.handler.esc_timeout precedent ]

## editor.input.next_key deliberately emits NOTHING for a lone "\e" -- it
## cannot yet tell a bare Esc from the first byte of an arrow key, and
## guessing would corrupt every escape sequence that arrives split across two
## reads. vault-edit.process_input_buffer arms this one-shot timer whenever a
## lone "\e" is left pending, and vault-edit.handler.stdin_key cancels it as
## soon as more input shows up.
##
## if it fires with that "\e" still alone, nothing followed within the timeout
## and it really was an Esc keypress -- dispatched exactly as if it had
## decoded normally

<vault-edit.esc.timer> = undef;    ## one-shot : it has fired ##

my $buffer = <vault-edit.input_buffer> // '';

## more arrived, or it was consumed some other way : not a bare Esc after all
return FALSE if $buffer ne "\e";

<vault-edit.input_buffer> = '';    ## consume it ##

return <[vault-edit.dispatch_key]>->("\e");

