## [:< ##

# name  = proxy.selector.load
# descr = load + merge global and domain selector rules from yaml config

my $config_path = <proxy.cfg.selector_config> // join( '/',
    <system.root_path>, 'data/yaml/web-proxy/template-selector.yaml' );

my $yaml_str = <[file.slurp]>->($config_path)->$*    // '';
my $config   = <[format.yaml.load_str]>->($yaml_str) // {};

<proxy.selector.rules>    = [];
<proxy.selector.fallback> = 'generic.proxy';

if ( ref $config eq 'HASH' ) {
    if ( exists $config->{'rules'} and ref $config->{'rules'} eq 'ARRAY' ) {
        push <proxy.selector.rules>->@*, $config->{'rules'}->@*;
    }
    <proxy.selector.fallback> = $config->{'fallback'}
        if exists $config->{'fallback'};
}

## load domain-specific rules ##
my $domains_dir
    = join( '/', <system.root_path>, 'data/yaml/web-proxy/domains' );
if ( -d $domains_dir and opendir my $dh, $domains_dir ) {
    while ( my $fn = readdir $dh ) {
        next unless $fn =~ m{^(.+)\.yaml$};
        my $domain        = $1;
        my $domain_path   = "$domains_dir/$fn";
        my $domain_yaml   = <[file.slurp]>->($domain_path)->$*       // '';
        my $domain_config = <[format.yaml.load_str]>->($domain_yaml) // {};
        if ( ref $domain_config eq 'HASH'
            and exists $domain_config->{'rules'} ) {
            my $drules = $domain_config->{'rules'};
            if ( ref $drules eq 'ARRAY' ) {
                for my $rule (@$drules) {
                    $rule->{'_domain'} = $domain;
                }
                push <proxy.selector.rules>->@*, @$drules;
            }
        }
    }
    closedir $dh;
}

<[base.logs]>->(
    1,
    'proxy.selector.load: %d rules loaded [fallback=%s]',
    scalar( <proxy.selector.rules>->@* ),
    <proxy.selector.fallback>
);

return;

