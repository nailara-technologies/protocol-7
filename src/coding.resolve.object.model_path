## [:< ##

# name  = coding.resolve.object.model_path
# descr = resolve hook : ask the models zenka to resolve the model file
#         path if it hasn't been requested/resolved yet. debounced
#         generically by base.dependency.ok -- no in-flight tracking
#         needed here

my $object_id = shift;
return undef unless exists <dependency.object>->{$object_id};

<[base.log]>->( 1, ': resolve : requesting model path resolution' );
return <[coding.resolve_model_path]>;

