## [:< ##

# name  = events.remote.gone
# descr = finish a remote pull, persist state and arm the next poll
# args  = stream child gone reason, handle

my ( $reason, $handle ) = @ARG;
my $alias = $handle->{'data'}{'alias'}     // return FALSE;
my $run   = <events.remote.runs>->{$alias} // return FALSE;
return FALSE if ( $run->{'handle'} // '' ) ne $handle;
delete $run->{'handle'};

my $state = <events.remote.states>->{$alias}
    //= <[events.remote.state]>->($alias);
if ( $run->{'records'} ) {
    $state->{'last_time'} = $run->{'max_time'} // $state->{'last_time'} // 0;
    <[events.remote.state]>->( $alias, $state );
}

my $failed
    = $reason ne qw| eof |
    || ( $handle->{'exit'} // 0 ) ne 0
    || $run->{'invalid'}
    || $run->{'refused'};
my @stderr = @{ $run->{'stderr'} // [] };
my @errors;
while (@stderr) {
    my $line = shift @stderr;
    if ( $line
        =~ m{\A: (?:pinned host-root|host-root ROTATED) \[ [A-Za-z0-9._-]+ \\ [A-Za-z0-9.-]+:\d+ \](?: \[ owner-certified \])?\z}
        and @stderr >= 2
        and $stderr[0] =~ m|\A :\. [A-Z2-7]{39}\z|
        and $stderr[1] =~ m|\A :\. [A-Z2-7]{38}\z| ) {
        splice @stderr, 0, 2;
        next;
    }
    push @errors, $line;
}
if ( $failed or @errors ) {
    <[base.logs]>->(
        0,
        'remote pull %s : %s [ %d new, %d refused, %d invalid ] : %s',
        $alias,
        $reason,
        $run->{'hits'}    // 0,
        $run->{'refused'} // 0,
        $run->{'invalid'} // 0,
        join( ' | ', @{ $run->{'stderr'} // [] } )
    );
} elsif ( @{ $run->{'stderr'} // [] } ) {
    <[base.logs]>->(
        $run->{'hits'} ? 1 : 2,
        'remote pull %s : %s [ %d new, %d refused, %d invalid ] : %s',
        $alias,
        $reason,
        $run->{'hits'}    // 0,
        $run->{'refused'} // 0,
        $run->{'invalid'} // 0,
        join( ' | ', @{ $run->{'stderr'} // [] } )
    );
} elsif ( $run->{'hits'} ) {
    <[base.logs]>->(
        1, 'remote pull %s : %d new signal%s',
        $alias, $run->{'hits'}, $run->{'hits'} == 1 ? '' : 's'
    );
}
return <[events.remote.arm]>->( $alias, $run->{'hits'} ? TRUE : FALSE );

