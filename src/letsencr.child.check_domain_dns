# name  = letsencr.child.check_domain_dns
# param = $domain, \@public_addresses
# descr = enrollment DNS sanity check : the name must resolve to at least
#         one address that is not loopback \ private \ link-local ; when
#         public_addresses is configured, at least one resolved address
#         must be on it [ a host behind NAT never sees its public ip ]
# return = { ok => 0|1, reason => ..., addresses => [...] }

my $domain     = shift;
my $public_cfg = shift // [];

return { 'ok' => 0, 'reason' => 'domain parameter required' }
    unless defined $domain && length($domain);

## an address qualifies when it is publicly routable [ the shared rule ] ##
my $is_public = sub { <[letsencr.base.address_is_public]>->(shift) };

my @addresses = <[letsencr.child.resolve_addresses]>->($domain);

return { 'ok' => 0, 'reason' => 'name does not resolve', 'addresses' => [] }
    unless @addresses;

my @public = grep { $is_public->($ARG) } @addresses;

return {
    'ok'        => 0,
    'reason'    => 'resolves to loopback/private/link-local only',
    'addresses' => \@addresses,
    }
    unless @public;

## when configured : at least one resolved address must be on the list ##
if ( $public_cfg && ref($public_cfg) eq qw| ARRAY | && @$public_cfg ) {
    my %wanted = map { $ARG => 1 } @$public_cfg;
    return {
        'ok'        => 0,
        'reason'    => 'no resolved address on letsencr.cfg.public_addresses',
        'addresses' => \@addresses,
        }
        unless grep { $wanted{$ARG} } @public;
}

return { 'ok' => 1, 'addresses' => \@public };

