## [:< ##

# name  = index.cmd.decode
# descr = return token for a numerical address

my $addr  = $call->{'args'} // '';
my $token = <[index.decode]>->($addr);

return { 'mode' => 'false', 'data' => 'not found' }
    if not defined $token;

return { 'mode' => 'size', 'data' => $token };

