## [:< ##

# name  = amos-term.buffer-clear
# descr = Clear all voxels in 3D buffer

my $window_id = shift;

my $window = <amos-term.windows.by_id>->{$window_id};
return undef unless defined $window;

my $shm_ptr = $window->{'buffer'}->{'shm_ptr'};
return undef unless defined $shm_ptr;

my $size = $window->{'buffer'}->{'voxel_count'} * 2;

## clear to zeros ##
substr( $$shm_ptr, 0, $size ) = "\0" x $size;

return TRUE;

