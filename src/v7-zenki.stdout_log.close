## [:< ##

# name  = v7-zenki.stdout_log.close
# descr = closes stdout log with optional termination marker

my $write_marker = shift // TRUE;

return TRUE if not defined <v7-zenki.stdout_log.fh>;

my $fh = <v7-zenki.stdout_log.fh>;

## write termination marker for tail -f clients ##
say {$fh} join( '', $colors{'p7_fg_0000'}, qw| ▼ |, $colors{'reset'} )
    if $write_marker and defined fileno($fh);

close($fh)
    or <[base.s_warn]>->( 'closing stdout log : %s', <[base.str.os_err]> );

<v7-zenki.stdout_log.fh> = undef;

return TRUE;

