## [:< ##

# name  = plugin.web.space.index.init_code
# descr = initialize persistent index plugin state

## index data cache : populated by scan, read by template commands ##
<web.space.index.cache> = {
    qw| target_dir | => qw| unknown |,
    qw| file_count | => 0,
    qw| cells      | => [],
    qw| timestamp  | => 0,
};

## configuration ##
<web.space.index.cfg.target_dir> //= qw| src |;
##  reset on reload so path stays consistent  ##
delete <web.space.index.cfg.persist_dir>;
<web.space.index.cfg.persist_dir> = qw| space-index |;
<web.space.index.cfg.checksum_bits> //= 512;

## re-entry flag for rebuild command ##
<web.space.index.running> //= 0;

## pre-encoded string cache for fast http serving ##
<web.space.index.json_cached> //= '{}';
<web.space.index.yaml_cached> //= "--- {}\n";

## command alias so p7c web.index-rebuild resolves  web zenka strips 'web.' ##
## prefix -> 'index-rebuild' -> alias to 'rebuild'                          ##
$data{'alias'}{'index-rebuild'} = qw| rebuild |;

## attempt to restore prior index from disk ##
eval {<[plugin.web.space.index.load]>};

<[base.log]>->( 1, 'plugin.web.space.index : initialized' );

0;

