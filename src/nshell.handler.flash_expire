## [:< ##

# name  = nshell.handler.flash_expire
# descr = clear an expired status-bar flash [ see plugin.nshell.coding-
#         session.on_reply ] and force a redraw so it actually disappears
#         on its own, not just on the next reply/keypress that happens to
#         trigger a render

my $state_ref = <nshell.state> // {};

return unless defined $state_ref->{'flash'};

## nshell.render.viewport already re-checks expiry itself on every render  ##
## and clears a stale flash there too -- this timer's only job is to force ##
## that render to actually run, since nothing else may otherwise touch the ##
## screen again before the user's next keystroke                           ##
delete $state_ref->{'flash'}
    if ( $state_ref->{'flash'}{'expires'} // 0 ) <= <[base.ntime]>;

<[nshell.render.viewport]>->( $state_ref->{'editor'}, \%colors )
    if $state_ref->{'split_active'} and defined $state_ref->{'editor'};

