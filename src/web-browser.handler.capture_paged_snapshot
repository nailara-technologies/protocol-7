## [:< ##

# name  = web-browser.handler.capture_paged_snapshot
# descr = requests a WebKit snapshot of the foreground view for the current
#         paged-capture position. writes the manifest line immediately (the
#         output path is already known) and hands the async save to
#         capture_paged_snapshot_result.

my $view_index = <web-browser.overlay.index.fg> // 1;
my $view       = <web-browser.gtk_obj.view>->{$view_index};
return unless defined $view;

my $uri = $view->get_uri // '';
return unless length $uri;

## the view's URI can flip to an error/blank sentinel in the async gap     ##
## since capture_paged.start's own guard ran (page errored out mid-flight) ##
## -- never write a sentinel URI into the manifest, treat it the same as a ##
## timeout                                                                 ##
if ( $uri =~ m|^\[| or $uri eq qw| [PAUSE] | ) {
    <[base.logs]>->(
        1, "capture_paged_snapshot: uri became non-content '%s', skipping",
        $uri
    );
    delete <web-browser.capture.paged.pending_path>;
    <[web-browser.capture_paged.advance]>;
    return;
}

## same naming convention as web-browser.cmd.get_snapshot: content-derived ##
## amos checksum leads (so identical captures naturally dedup/group by     ##
## source page), ntime stamp orders them -- no incrementing index          ##
my $snap_dir = <web-browser.capture.snapshot_dir>;
<web-browser.capture.counter>++;
my $url_chksum = <[chk-sum.amos]>->($uri);
my $stamp      = <[base.ntime.b32]>->( 5, TRUE );
my $out_path   = sprintf( '%s/%s.%s.png', $snap_dir, $url_chksum, $stamp );

<web-browser.capture.paged.pending_path> = $out_path;

my $position_index = <web-browser.capture.paged.index> // 0;
my $manifest_path  = <web-browser.capture.manifest_path>;

open( my $fh, '>>', $manifest_path ) or do {
    <[base.logs]>->(
        0, "capture_paged_snapshot: cannot open manifest: %s", $OS_ERROR
    );
    return;
};
print {$fh} "$url_chksum\t$uri\t$position_index\t$out_path\n";
close($fh);

my $region = <web-browser.cfg.snapshot_region> // 'visible';

eval {
    $view->get_snapshot(
        $region,
        'WEBKIT_SNAPSHOT_OPTIONS_NONE',
        undef,    ## cancellable
        $code{'web-browser.handler.capture_paged_snapshot_result'},
        undef     ## user_data
    );
};

if ($EVAL_ERROR) {
    <[base.logs]>->(
        0, "capture_paged_snapshot: snapshot request failed: %s",
        <[base.str.eval_error]>
    );
    return;
}

