## [:< ##

# name  = base.load_runtime_modules
# descr = load modules at runtime bypassing whitelist filter

##  whitelist is applied at startup only : runtime loads are intentional  ##
my $wl_state = <base.loader.sub_whitelist_enabled>;
<base.loader.sub_whitelist_enabled> = FALSE;
my $result = <[base.load_modules]>->(@ARG);
<base.loader.sub_whitelist_enabled> = $wl_state;
return $result;

