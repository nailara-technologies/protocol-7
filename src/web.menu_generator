## [:< ##

# name = web.menu_generator
# descr = generate navigation menu from vhost directory structure
#
# Automatically creates menu entries from filesystem structure:
#   - Directories become menu items
#   - index.html/index.tmpl becomes the section page
#   - Files are skipped
#   - Supports custom metadata from menu.yaml files
#
# Parameters:
#   $ARG[0] - Vhost name (e.g., "127.0.0.1")
#   $ARG[1] - Menu context/level (e.g., "main", "sidebar", or specific path)
#   $ARG[2] - Optional: base path (default: "/")
#
# Returns:
#   Array reference of menu items with structure:
#   [
#     { label => "Home", path => "/", icon => "home", active => 0 },
#     { label => "Blog", path => "/blog/", submenu => [...], active => 0 },
#     { label => "Shop", path => "/shop/", icon => "shopping-cart" }
#   ]

my $vhost        = shift;
my $menu_context = shift // 'main';
my $base_path    = shift // '/';

## Validate parameters ##
unless ( defined $vhost and length $vhost ) {
    <[base.log]>->( 0, "menu_generator : missing vhost parameter" );
    return [];
}

## Normalize base path ##
$base_path =~ s|^/+||;
$base_path =~ s|/+$||;
$base_path = "/$base_path" if length $base_path;
$base_path = '/'           if !length $base_path or $base_path eq '/';

my $site_root  = <httpd.cfg.site_dir> // '/var/httpd';
my $vhost_root = "$site_root/$vhost";

## Check if vhost directory exists ##
unless ( -d $vhost_root ) {
    <[base.log]>->(
        1, "menu_generator: vhost directory not found: $vhost_root"
    );
    return [];
}

## check cache ##
my $cache_key = "$vhost:$menu_context:$base_path";
if ( exists <web.menu_cache>->{$cache_key} ) {
    return <web.menu_cache>->{$cache_key};
}

<[base.log]>->(
    2,
    "menu_generator: [$vhost] generating "
        . "'$menu_context' menu from '$base_path'"
);

## Read vhost directory ##
my @entries;
opendir( my $dh, $vhost_root ) or do {
    <[base.log]>->(
        1, "menu_generator: cannot read vhost directory: $vhost_root: $!"
    );
    return [];
};

my @dir_contents = readdir($dh);
closedir($dh);

## Build menu items from directory entries ##
my @menu_items;

## Add "Home" link first ##
push @menu_items,
    {
    label  => 'Home',
    path   => '/',
    icon   => 'home',
    active => ( $base_path eq '/' ? 1 : 0 )
    };

## Process directory entries ##
foreach my $entry ( sort @dir_contents ) {
    ## Skip special directories ##
    next if $entry =~ /^_/;    # Skip _templates, _skins, _config, etc.
    next if $entry =~ /^\./;   # Skip . and ..
    next if $entry =~ /^[A-Z]/ # Skip uppercase (common for files like README)
        and -f "$vhost_root/$entry";

    my $entry_path = "$vhost_root/$entry";

    ## Skip if not a directory ##
    next unless -d $entry_path;

    ## Check if directory has index file ##
    my $has_index
        = ( -f "$entry_path/index.html" or -f "$entry_path/index.tmpl" );

    ## Build menu label from directory name ##
    my $label = $entry;
    $label =~ s|_| |g;          # Replace underscores with spaces
    $label = ucfirst $label;    # Capitalize first letter

    my $path = "/$entry/";

    ## Create menu item ##
    my $menu_item = {
        label  => $label,
        path   => $path,
        active => ( $base_path eq $path ? 1 : 0 )
    };

    ## Try to read menu metadata from menu.yaml if it exists ##
    my $menu_yaml_path = "$entry_path/menu.yaml";
    if ( -f $menu_yaml_path ) {
        ## Parse YAML for menu metadata (simplified) ##
        open( my $fh, '<', $menu_yaml_path ) or do {
            <[base.log]>
                ->( 2, "menu_generator: cannot read $menu_yaml_path" );
            next;
        };

        while ( my $line = <$fh> ) {
            if ( $line =~ /^\s*label\s*:\s*(.+)/ ) {
                $menu_item->{'label'} = $1;
            } elsif ( $line =~ /^\s*icon\s*:\s*(.+)/ ) {
                $menu_item->{'icon'} = $1;
            } elsif ( $line =~ /^\s*order\s*:\s*(\d+)/ ) {
                $menu_item->{'order'} = $1;
            } elsif ( $line =~ /^\s*hidden\s*:\s*(true|false)/ ) {
                $menu_item->{'hidden'} = ( $1 eq qw| true | ? 1 : 0 );
            }
        }
        close($fh);
    }

    ## Skip if marked as hidden ##
    next if $menu_item->{'hidden'};

    push @menu_items, $menu_item;
}

## Sort by order if specified, then by label ##
@menu_items = sort {
    my $order_a = $a->{'order'} // 999;
    my $order_b = $b->{'order'} // 999;
    $order_a <=> $order_b or $a->{'label'} cmp $b->{'label'};
} @menu_items;

## cache the result ##
<web.menu_cache>->{$cache_key} = \@menu_items;

<[base.log]>->(
    2, "menu_generator: generated " . scalar(@menu_items) . " menu items"
);

return \@menu_items;

