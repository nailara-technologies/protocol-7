## [:< ##

# name   = coding.sign_queue.enqueue
# descr  = add a sign queue entry [ not saved, not armed ]
# args   = { paths => [ .. ], message, op, plan }
# return = the entry id [ q<n> ]

my $in  = shift // {};
my $all = <[coding.sign_queue.store]>;
my $id  = 'q' . $all->{'next'}++;
$all->{'entry'}{$id} = {
    'num'     => substr( $id, 1 ),
    'paths'   => join( ' ', @{ $in->{'paths'} } ),
    'message' => $in->{'message'},
    'op'      => $in->{'op'} // qw| new |,
    'status'  => qw| queued |,
    'added'   => time,
    defined $in->{'plan'} ? ( 'plan' => $in->{'plan'} ) : ()
};
return $id;

