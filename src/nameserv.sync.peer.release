## [:< ##

# name  = nameserv.sync.peer.release
# descr = drop a peer's long-poll socket and watchers [ keep state ]

my $key = shift // return;

my $peers = <nameserv.sync.peers> // return;
my $peer  = $peers->{$key}        // return;

if ( ref $peer->{'watcher'} ) {
    $peer->{'watcher'}->cancel
        if $peer->{'watcher'}->can('is_active')
        and $peer->{'watcher'}->is_active;
    $peer->{'watcher'} = undef;
}

if ( ref $peer->{'conn_timer'} ) {
    $peer->{'conn_timer'}->cancel
        if $peer->{'conn_timer'}->can('is_active')
        and $peer->{'conn_timer'}->is_active;
    $peer->{'conn_timer'} = undef;
}

close $peer->{'sock'} if defined $peer->{'sock'};
$peer->{'sock'} = undef;

$peer->{'state'} = qw| idle |;

return TRUE;

