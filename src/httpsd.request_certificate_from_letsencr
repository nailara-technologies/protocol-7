## [:< ##

# name = httpsd.request_certificate_from_letsencr
# descr = request certificate provisioning from letsencr zenka
#         [ route-send only buffers : the reply arrives asynchronously in
#           httpsd.handler.cert_request_reply -- no synchronous answer ]
# return = { status => 'pending'|'failed', message => description }

## get the hostname we're provisioning for
my $hostname = shift // <system.host.hostname> // 'unknown';

<[base.logs]>->(
    2, 'httpsd: requesting certificate provisioning from letsencr for %s',
    $hostname
);

## route-send buffers the command for letsencr [ starts it on demand ] ##
my $num_clients = <[protocol-7.route-send]>->(
    {   'command'   => qw| letsencr.request-certificate |,
        'call_args' => { 'args' => $hostname },
        'reply'     => {
            'handler' => qw| httpsd.handler.cert_request_reply |,
            'params'  => { 'hostname' => $hostname }
        }
    }
);

if ( !defined $num_clients || $num_clients == 0 ) {
    <[base.logs]>->(
        2, 'httpsd: letsencr not reachable for certificate request'
    );
    return {
        status  => 'failed',
        message => 'letsencr did not accept the certificate request'
    };
}

<[base.logs]>->(
    2,
    'httpsd: certificate request routed to letsencr '
        . 'for %s [ reply handled asynchronously ]',
    $hostname
);

return {
    status  => 'pending',
    message => "certificate request sent to letsencr for '$hostname'"
};

0;

