# name = image-quality.status
# descr = Return current status of image quality analyzer

my ($arg) = @ARG;

return {
    success                   => TRUE,
    ready                     => TRUE,
    uptime_seconds            => 0,
    analyses_completed        => 0,
    last_analysis_duration_ms => 0,
    message => 'image-quality analyzer ready for image analysis'
};

