## [:< ##

# name  = websocket.init_code
# descr = initialize websocket client subsystem configuration

map { <[base.perlmod.load]>->($_) }
    qw| IO::Socket::INET Protocol::WebSocket::Handshake::Client Errno |;

<websocket.version>          //= qw| 0.1.0 |;
<websocket.read_buffer_size> //= 65536;      ## bytes per sysread call
<websocket.connect_timeout>  //= 5;          ## seconds for blocking handshake

<[base.logs]>->(
    2, ': websocket client subsystem initialized [v%s]',
    <websocket.version>
);

return TRUE;

