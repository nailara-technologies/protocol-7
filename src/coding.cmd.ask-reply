## [:< ##

# name  = coding.cmd.ask-reply
# descr = submit coding task, return full reply when complete
# param = <request_string>

# Resolve input through the shared decoder [ explicit prefixes only ]
my $request_str = '';

my $param_request = '';
if ( defined $call->{'param'} and ref $call->{'param'} eq qw| HASH | ) {
    $param_request = $call->{'param'}->{'request'}
        // $call->{'param'}->{'question'}
        // $call->{'param'}->{'description'} // '';
}

if ( length $param_request ) {

    ## param mode [ legacy multiline callers ] : the request key wins and the
    ## data body is appended as context -- the branch below is what p7c \
    ## p-7-r produce for a multi-line argument [ body = the args ]
    $param_request =~ s|\\n|\n|g;    ## literal \n unescape [ legacy ] ##
    my $decoded = <[coding.input.decode]>->(
        {   'input'  => $param_request,
            'caller' => qw| coding.cmd.ask-reply |
        }
    );
    return { 'mode' => qw| false |, 'data' => $decoded->{'error'} }
        unless $decoded->{'success'};
    $request_str = $decoded->{'content'};

    if ( defined $call->{'data'} and length $call->{'data'} ) {
        $request_str .= "\nContext:\n" . $call->{'data'};
    }
} else {

    ## single-line args OR multi-line mode body [ $call->{'data'} ] ##
    my $raw
        = ( defined $call->{'data'} and length $call->{'data'} )
        ? $call->{'data'}
        : $call->{'args'} // '';

    my $decoded = <[coding.input.decode]>->(
        {   'input'  => $raw,
            'caller' => qw| coding.cmd.ask-reply |
        }
    );
    return { 'mode' => qw| false |, 'data' => $decoded->{'error'} }
        unless $decoded->{'success'};
    $request_str = $decoded->{'content'};
}
return { 'mode' => qw| false |, 'data' => "work request required\n" }
    if !length($request_str);

## detect simple/no-tools mode from :simple: or :no_tools: marker [ :next:  ##
## first, it leads a models prompt ; :no_tools: at the start of any line -- ##
## models puts its task tag before the description ]                        ##
$request_str =~ s{^:next:\s*}{}i;
my $simple_mode   = FALSE;
my $no_tools_mode = FALSE;
if ( $request_str =~ s{:simple:\s*}{}i )     { $simple_mode   = TRUE }
if ( $request_str =~ s{^:no_tools:\n?}{}im ) { $no_tools_mode = TRUE }

# Parse and analyze task
my $intake_result = <[coding.task.intake]>->($request_str);
return {
    'mode' => qw| false |,
    'data' => "Failed to parse: $intake_result->{error}"
    }
    if !$intake_result->{success};

my $analysis = <[coding.task.analyze]>->( 'full', $intake_result->{task} );
return {
    'mode' => qw| false |,
    'data' => "Failed to analyze: $analysis->{error}"
    }
    if !$analysis->{success};

my $routing
    = <[coding.routing.decide_service]>->( 'route', $analysis->{task} );
return {
    'mode' => qw| false |,
    'data' => "Failed to route: $routing->{error}"
    }
    if !$routing->{success};

my $routed_task = $routing->{'task'};

## apply simple mode : single round, no tool calls
if ($simple_mode) {
    $routed_task->{'no_tools'}   = TRUE;
    $routed_task->{'max_rounds'} = 1;
}

## apply no_tools mode : tools disabled, rounds unrestricted
if ($no_tools_mode) {
    $routed_task->{'no_tools'} = TRUE;
}

# Enqueue task
my $queue_result = <[coding.task.enqueue]>->($routed_task);
return {
    'mode' => qw| false |,
    'data' => "Failed to enqueue: $queue_result->{error}"
    }
    if !$queue_result->{success};

# Create deferred reply tracking
<coding.deferred_replies> //= {};

my $deferred_id = <[base.gen_id]>->(<coding.deferred_replies>);
<coding.deferred_replies>->{$deferred_id} = {
    'deferred_id' => $deferred_id,
    'reply_id'    => $call->{'reply_id'},
    'task_id'     => $routed_task->{'id'},
    'submitted'   => <[base.ntime]>,
    'status'      => qw| waiting |
};

<[base.logs]>->(
    2,                    "[submit-deferred] task=%s deferred_id=%s",
    $routed_task->{'id'}, $deferred_id
);

return { 'mode' => qw| deferred | };

