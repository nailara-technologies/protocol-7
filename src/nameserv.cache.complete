## [:< ##

# name  = nameserv.cache.complete
# descr = finish a cache-miss state : cache, deliver, servfail

## a good reply is cached once and delivered to every waiter with its own  ##
## query id ; an undef reply means every upstream failed : a servfail goes ##
## to every waiter, with its own query id                                  ##

my $state = shift // return FALSE;
my $pkt   = shift;
my $key   = $state->{'key'} // return FALSE;

## cancel watcher + timer, deregister ##
for my $name (qw| watcher timer |) {
    if ( ref $state->{$name} ) {
        $state->{$name}->cancel
            if $state->{$name}->can('is_active')
            and $state->{$name}->is_active;
        $state->{$name} = undef;
    }
}
delete <nameserv.cache.in_flight>->{$key}
    if ref <nameserv.cache.in_flight>;

if ( defined $pkt ) {
    <[nameserv.cache.put]>->($pkt);
    for my $waiter ( @{ $state->{'waiters'} } ) {
        my $copy = eval { Net::DNS::Packet->new( \$pkt->data(65535) ) };
        next unless defined $copy;
        $copy->header->id( $waiter->{'id'} );
        <[nameserv.reply.echo_question]>->( $copy, $waiter->{'question'} );
        $waiter->{'deliver'}->($copy);
    }
} else {
    <nameserv.stats>->{'cache_servfail'}++;
    for my $waiter ( @{ $state->{'waiters'} } ) {
        my $fail
            = Net::DNS::Packet->new( $state->{'qname'}, $state->{'qtype'} );
        $fail->header->id( $waiter->{'id'} );
        <[nameserv.reply.echo_question]>->( $fail, $waiter->{'question'} );
        $fail->header->qr(1);
        $fail->header->aa(0);
        $fail->header->rcode(qw| SERVFAIL |);
        $waiter->{'deliver'}->($fail);
    }
}

return TRUE;

