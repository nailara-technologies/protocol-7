## [:< ##

# name  = jobsite.stage.fetch
# descr = begin scanning : route-send site-yaml.import per category url

my $full_mode = shift // FALSE;

<jobsite.cycle>     = qw| scanning |;
<jobsite.last_scan> = time;
<[jobsite.state.persist]>;

## build category → url map from config
my $cats_cfg = <jobsite.cfg.categories> // '';
my @cats     = split m|\s+|, $cats_cfg;

if ( not @cats ) {
    <[base.logs]>->( 0, '[fetch] no categories configured' );
    <jobsite.cycle> = qw| idle |;
    <[jobsite.state.persist]>;
    return;
}

my %cat_urls;
for my $cat (@cats) {
    my $url = <jobsite.cfg.url>->{$cat} // '';
    if ( not length $url ) {
        <[base.logs]>->( 0, '[fetch] no url for category %s', $cat );
        next;
    }
    $cat_urls{$cat} = $url;
}

if ( not %cat_urls ) {
    <[base.logs]>->( 0, '[fetch] no valid category urls found' );
    <jobsite.cycle> = qw| idle |;
    <[jobsite.state.persist]>;
    return;
}

<[base.logs]>->(
    1,
    ':: scanning %d categories [full=%d] : %s',
    scalar keys %cat_urls,
    $full_mode, join( ', ', sort keys %cat_urls )
);

## build skip list and field-block file from authoritative job index ##
my $index = <jobsite.job.index> // {};

my $var_root   = <system.path.zenka-dirs.var_P7>;
my $block_file = join( '/', $var_root, qw| jobsite block-list | );
my %block_seen;
my @skip_source_ids;
my $epoch_num = <[base.ntime.epoch_dec]>->('current') // '';
my $epoch_str
    = length $epoch_num
    ? <[base.ntime.epoch_timestamp]>->($epoch_num) // ''
    : '';

my $seed_file = "$block_file.seed";
if ( open my $bfh, '>', $block_file ) {

    ## merge optional seed blocklist (e.g. from backups) so it persists ##
    if ( -r $seed_file and open my $sfh, '<', $seed_file ) {
        while ( my $line = <$sfh> ) {
            chomp $line;
            next if $line =~ m{^\s*$};
            next if $block_seen{$line}++;
            print {$bfh} "$line\n";
        }
        close $sfh;
    }

    for my $id ( sort keys %{$index} ) {
        my $job = <[jobsite.job.read]>->($id) // next;

        my $source_id = <[jobsite.util.source-id]>->($job);
        if ( length $source_id ) {
            my $line = <[jobsite.util.block-line]>->(
                $epoch_str, 'id', $source_id, \%block_seen
            );
            print {$bfh} "$line\n" if length $line;
            push @skip_source_ids, $source_id;
        }

        for my $field (qw| url |) {
            my $line = <[jobsite.util.block-line]>->(
                $epoch_str, $field, $job->{$field} // '',
                \%block_seen
            );
            print {$bfh} "$line\n" if length $line;
        }
    }
    close $bfh;
} else {
    <[base.logs]>->( 0, 'fetch: cannot write %s: %s', $block_file, $! );
}

my $skip_ids = join( ' ', sort @skip_source_ids );

## reset per-cycle counters before sending imports
<jobsite.fetch_total_queued> = 0;
<jobsite.fetch_saw_queue>    = FALSE;

## cancel any leftover poll timer from a previous scan ##
if ( defined <jobsite.queue_poll_timer> ) {
    <jobsite.queue_poll_timer>->cancel;
    <jobsite.queue_poll_timer> = undef;
}

for my $cat ( sort keys %cat_urls ) {
    my $args_str = sprintf
        'url=%s handler=%s skip=%s block_file=%s full=%d',
        $cat_urls{$cat},
        qw| jobsite.job-upsert |,
        $skip_ids,
        $block_file,
        ( $full_mode ? 1 : 0 );

    <[protocol-7.route-send]>->(
        {   'command'   => qw| site-yaml.import |,
            'call_args' => { 'args' => $args_str },
            'reply'     => {
                'handler' => qw| jobsite.handler.fetch-done |,
                'params'  => { 'category' => $cat, 'url' => $cat_urls{$cat} },
            },
        }
    );
}

## track how many fetch replies we expect
<jobsite.fetch_pending> = scalar keys %cat_urls;

