# name  = external.handler.reset_retry_delay
# descr = reset per-connection retry delay after stable success

my $name = shift->w->data // '';
return if not length $name;

my $conn_ref = $data{'external'}{'connections'} // {};
return unless exists $conn_ref->{$name};

<[base.logs]>->( 2, qq| resetting retry delay for %s |, $name );

delete $conn_ref->{$name}->{'retry_delay'};
delete $conn_ref->{$name}->{'timer'}->{'reset_retry_delay'};
delete $conn_ref->{$name}->{'timer'}
    if not keys $conn_ref->{$name}->{'timer'}->%*;

return TRUE;

