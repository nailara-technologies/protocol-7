## [:< ##

# name  = coding.callback.http_chunk
# descr = HTTP streaming chunk received callback

my ( $task_id, $req_seq, $data ) = @ARG;

## process chunk ##
my $state = <[coding.async.state_manager]>->( qw| get |, $task_id );
return unless defined $state;

## reject stale chunks from old connections ##
my $current_seq = $state->{'request_seq'} // 0;
if ( defined $req_seq && $req_seq != $current_seq ) {
    <[base.logs]>->(
        2, "http_chunk: stale chunk for %s [ seq %d != %d ], ignoring",
        $task_id, $req_seq, $current_seq
    );
    return;
}

## first chunk from this backend since (re)spawn : warmup is over, clear ##
## the cold-start data-start grace [ coding.async.http_client ]          ##
my $backend_name = $state->{'backend'} // '';
if ( length $backend_name ) {
    my $srv = ( <coding.inference_servers> // {} )->{$backend_name};
    if ( $srv && $srv->{'cold_start'} ) {
        delete $srv->{'cold_start'};
        <[base.logs]>->(
            1, "http_chunk: %s backend warmed up, clearing cold-start grace",
            $backend_name
        );
    }
}

my $context = $state->{'chunk_context'} // {};
$context->{'round'} = $state->{'round'} // 0;

## call chunk handler  note: chunk_handler may trigger state_machine        ##
## transitions synchronously which can start a new round : do not overwrite ##
## state after finish_reason                                                ##
$context = <[coding.async.chunk_handler]>->( $task_id, $data, $context );

if ( defined $context->{'finish_reason'} ) {
    ## state machine already handled the transition inside chunk_handler   ##
    ## content passed via transition data : do not write stale fields here ##
    ## [ async.request may have already reset state for the next round ]   ##
    return;
}

## update chunk context for next chunk [ only during streaming ] ##
$state->{'chunk_context'} = $context;

return;

