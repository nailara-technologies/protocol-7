## [:< ##

# name  = coding.parser.model_selection
# descr = parse model_selection block from model output

my ($text) = @ARG;

return undef unless defined $text and length $text;

## extract yaml block [ fenced or bare ] ##
my $block = '';
if ( $text =~ m|```ya?ml\s*\n(.*?)```|s ) {
    $block = $1;
} elsif ( $text =~ m|(model_selection:\s*\n.*)|s ) {
    $block = $1;
}

return undef unless length $block;

## parse backend field ##
my $backend = '';
if ( $block =~ m/^backend:\s*(\S+)/m ) {
    $backend = lc($1);
    $backend =~ s|\s+$||;
}

## parse optional max_context ##
my $max_context = undef;
if ( $block =~ m/^max_context:\s*(\d+)/m ) {
    $max_context = $1;
}

## parse reason field [ literal or folded ] ##
my $reason = '';
if ( $block =~ m/^reason:\s*\|\s*\n(.*?)(?:\n\w+:|\z)/s ) {
    $reason = $1;
    $reason =~ s|^\s+||;
    $reason =~ s|\s+$||;
} elsif ( $block =~ m/^reason:\s*(.+)/m ) {
    $reason = $1;
    $reason =~ s|^\s+||;
    $reason =~ s|\s+$||;
}

return undef unless length $backend and length $reason;

return {
    backend     => $backend,
    max_context => $max_context,
    reason      => $reason,
};

