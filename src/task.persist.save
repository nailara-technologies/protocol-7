## [:< ##

# name  = task.persist.save
# descr = save task queue to disk as yaml

my $saved_at = <[base.ntime]>;
my $ok       = TRUE;

## save live queue ##
my $queue_yaml = <[format.yaml.dump_str]>->(
    {   'queue'       => <task.queue>,
        'queue_order' => <task.queue.order>,
        'saved_at'    => $saved_at
    }
);
if ( not defined $queue_yaml or not length $queue_yaml ) {
    warn 'task.persist.save: queue yaml serialization failed';
    $ok = FALSE;
} else {
    utf8::encode($queue_yaml);
    $ok = FALSE
        unless defined
        <[file.zenka_dir.write]>->( 'queue.yaml', \$queue_yaml );
}

## save history ##
my $hist_yaml = <[format.yaml.dump_str]>->(
    {   'history'  => <task.history>,
        'saved_at' => $saved_at
    }
);
if ( not defined $hist_yaml or not length $hist_yaml ) {
    warn 'task.persist.save: history yaml serialization failed';
    $ok = FALSE;
} else {
    utf8::encode($hist_yaml);
    $ok = FALSE
        unless defined
        <[file.zenka_dir.write]>->( 'history.yaml', \$hist_yaml );
}

return $ok;

