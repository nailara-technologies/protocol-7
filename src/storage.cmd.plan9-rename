## [:< ##
# name  = storage.cmd.plan9-rename
# descr = Rename a file or directory over 9P

my $args = $call->{'args'} // '';
my ( $name, $path, $new_name ) = split /\s+/, $args, 3;

if (   not length( $name // '' )
    or not length( $path     // '' )
    or not length( $new_name // '' ) ) {
    return {
        'mode' => 'false',
        'data' => 'usage: plan9-rename <connection-name> <path> <new-name>'
    };
}

my $conn = $data{'storage'}{'9p'}{'connections'}{$name};
return { 'mode' => 'false', 'data' => 'not connected' } unless $conn;

my $result = <[storage.9p.rename-path]>->( $conn, $path, $new_name );
return $result if $result->{'mode'} eq 'false';

return {
    'mode' => 'true',
    'data' => "renamed $path to $new_name"
};

