# name  = protocol-7-menu.cmd.pending-question-add
# param = <question_json>
# descr = Add a pending question to the ambient indicator queue

my $args = $call->{'args'} // '';

my $question = eval { JSON::decode_json($args) } // {};

return { 'mode' => qw| false |, 'data' => 'expected JSON question object' }
    unless ref $question eq qw| HASH |;

return { 'mode' => qw| false |, 'data' => 'question type required' }
    unless defined $question->{'type'} and length $question->{'type'};

return { 'mode' => qw| false |, 'data' => 'question text required' }
    unless defined $question->{'question'}
    and length $question->{'question'};

$question->{'id'}    //= <[base.gen_id]>->( $data{'route'}, undef, undef, 0 );
$question->{'added'} //= <[base.time]>->(4);

<protocol-7-menu.pending-questions> //= [];
push <protocol-7-menu.pending-questions>->@*, $question;

<[protocol-7-menu.pending-indicator-update]>;

<[base.logs]>->(
    1,                 "pending question added : id=%s type=%s",
    $question->{'id'}, $question->{'type'}
);

return {
    'mode' => qw| true |,
    'data' => $question->{'id'}
};

