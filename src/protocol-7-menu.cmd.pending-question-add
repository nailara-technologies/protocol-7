## [:< ##

# name  = protocol-7-menu.cmd.pending-question-add
# param = <question_json> | type= question= [ .. ]
# descr = Add a pending question to the ambient indicator queue

my $args = $call->{'args'} // '';

## json [ cred-mesh ] or key=value [ park.parse_args grammar : type=
## question="..." options=a,b id= decision=yes ] -- the coding zenka sends
## key=value, no json between zenki
my $question;
if ( $args =~ m|\A\s*\{| ) {
    $question = eval { JSON::decode_json($args) } // {};
} else {
    my $parsed = <[park.parse_args]>->($args);
    return { 'mode' => qw| false |, 'data' => $parsed->{'error'} }
        if defined $parsed->{'error'};
    $question = $parsed->{'pairs'};
    $question->{'options'}
        = [ grep {length} split m|\s*,\s*|, $question->{'options'} ]
        if defined $question->{'options'};
    my $decision = delete $question->{'decision'} // '';
    $question->{'decision'} = TRUE if $decision =~ m{\A(?:1|yes|true)\z}i;
    return { 'mode' => qw| false |, 'data' => 'id : letters digits _ -' }
        if defined $question->{'id'}
        and $question->{'id'} !~ m|\A[\w-]{1,40}\z|;
}

return { 'mode' => qw| false |, 'data' => 'expected JSON question object' }
    unless ref $question eq qw| HASH |;

return { 'mode' => qw| false |, 'data' => 'question type required' }
    unless defined $question->{'type'} and length $question->{'type'};

return { 'mode' => qw| false |, 'data' => 'question text required' }
    unless defined $question->{'question'}
    and length $question->{'question'};

$question->{'id'}    //= <[base.gen_id]>->( $data{'route'}, undef, undef, 0 );
$question->{'added'} //= <[base.time]>->(4);

<protocol-7-menu.pending-questions> //= [];
push <protocol-7-menu.pending-questions>->@*, $question;

<[protocol-7-menu.pending-indicator-update]>;

<[base.logs]>->(
    1,                 "pending question added : id=%s type=%s",
    $question->{'id'}, $question->{'type'}
);

return {
    'mode' => qw| true |,
    'data' => $question->{'id'}
};

