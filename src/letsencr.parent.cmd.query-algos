## [:< ##

# name  = letsencr.parent.cmd.query-algos
# descr = display ACME server supported signature algorithms

<[base.log]>->( 2, 'querying ACME server for supported algorithms' );

## Let's Encrypt staging/production supports these algorithms  (confirmed from
## error response when using unsupported EdDSA)
my @supported_algos = ( 'RS256', 'ES256', 'ES384', 'ES512' );

my $algo_list = join( ', ', @supported_algos );
<[base.logs]>->( 2, 'ACME server supported algorithms: %s', $algo_list );

## Return formatted output
my $output = "Supported ACME Signature Algorithms:\n";
$output .= "====================================\n\n";

foreach my $algo (@supported_algos) {
    $output .= "  • $algo\n";
}

$output
    .= "\nNote: EdDSA (Ed25519) is NOT supported by Let's Encrypt ACME API\n";
$output .= "Recommended: RS256 (RSA 2048+) or ES256 (ECDSA P-256)\n";

return {
    'mode' => 'size',
    'data' => $output
};

