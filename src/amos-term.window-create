## [:< ##

# name  = amos-term.window-create
# descr = Create new 3D terminal window with AMOS checksum ID

my $params = shift // {};

## === parameters === ##
my $client_name = $params->{'client_name'}
    // sprintf( 'term-%03d', <amos-term.windows.count> // 0 );
my $geometry   = $params->{'geometry'}   // <amos-term.cfg.default_geometry>;
my $fullscreen = $params->{'fullscreen'} // FALSE;
my $alpha      = $params->{'alpha'}      // <amos-term.cfg.default_alpha>;

## === generate AMOS checksum ID === ##
my $timestamp = <[base.time]>->(3);
## simple AMOS ID: T + timestamp + counter ##
my $amos_id = sprintf( 'T%09d%01d',
    $timestamp % 1000000000,
    <amos-term.windows.count> % 10 );
$amos_id = uc( substr( $amos_id . 'K9M2P7L4N8', 0, 10 ) );

## === check for name collision === ##
if ( exists <amos-term.windows.by_name>->{$client_name} ) {
    <[base.logs]>->( 0, ":. window name '%s' already exists", $client_name );
    return undef;
}

if ( exists <amos-term.windows.by_amos>->{$amos_id} ) {
    ## rare collision - append counter ##
    $amos_id = sprintf( '%09s%01X',
        substr( $amos_id, 0, 9 ),
        <amos-term.windows.count> % 16 );
}

## === create session ===  using a pipe for internal event communication ##
## (no socket needed)                                                    ##
pipe( my $reader, my $writer );
binmode($reader);
binmode($writer);
$writer->autoflush(1);

## set handle mode BEFORE session init (required by init_state) ##
$data{'handle'}{$reader}{'mode'} = qw| internal |;

my $session_id = <[base.session.init]>->(
    $reader,      qw| amos-term |,
    qw| client |, $client_name
);

if ( not defined $session_id ) {
    <[base.logs]>->( 0, ":: failed to create amos-term session" );
    close($reader);
    close($writer);
    return undef;
}

## === window structure === ##
my $window = {
    ## Identity ##
    qw| amos_id |     => $amos_id,
    qw| session_id |  => $session_id,
    qw| client_name | => $client_name,
    qw| created |     => $timestamp,

    ## 3D Buffer (allocated on first open) ##
    qw| buffer | => {
        qw| dimensions |   => [ 8, 7, 13 ],    # X, Y, Z
        qw| voxel_count |  => 728,             # 8*7*13
        qw| voxel_bytes |  => 2,               # 2 bytes per voxel
        qw| cursor |       => { qw| x | => 0, qw| y | => 0, qw| z | => 0 },
        qw| cursor_curve | => <amos-term.cfg.cursor_curve>,
        qw| shm_path |     => undef,           # set on buffer creation
        qw| frame_node |   => 57               # 56+1 frame intelligence
    },

    ## Display (GTK3 objects created on open) ##
    qw| display | => {
        qw| gtk_window |  => undef,
        qw| cairo_ctx |   => undef,
        qw| geometry |    => $geometry,
        qw| fullscreen |  => $fullscreen,
        qw| alpha |       => $alpha,
        qw| visible |     => FALSE,
        qw| fps |         => <amos-term.cfg.default_fps>,
        qw| last_render | => 0
    },

    ## Event handles ##
    qw| handles | => {
        qw| read |  => $reader,
        qw| write | => $writer
    },

    ## State ##
    qw| state |    => 0,     # 0=created, 1=active, 2=hidden, 3=fullscreen
    qw| plugins |  => [],    # active plugin list
    qw| metadata | => {}     # user-defined metadata
};

## === register window === ##
<amos-term.windows.by_id>->{$session_id}    = $window;
<amos-term.windows.by_amos>->{$amos_id}     = $session_id;
<amos-term.windows.by_name>->{$client_name} = $session_id;
<amos-term.windows.count>++;

## === update session data === ##
$data{'session'}->{$session_id}->{'window'}  = $window;
$data{'session'}->{$session_id}->{'amos_id'} = $amos_id;

<[base.logs]>->(
    2, ":. window '%s' created [amos:%s] [sid:%d]",
    $client_name, $amos_id, $session_id
);

## === return window reference === ##
return wantarray ? ( $session_id, $amos_id ) : $session_id;

