## [:< ##

# name = power.read_states

my $device_id = shift;
die "expected valid device id"
    if not defined $device_id
    or not exists <power.cfg.devices>->{$device_id};

my ( $dev, $driver ) = <[power.dev_obj]>->($device_id);

return () if not defined $dev;

my $states = $code{"power.plugin.$driver.get"}->($dev);

return () if ref $states ne qw| ARRAY |;

<power.last_states> = $states;

return $states->@*;

