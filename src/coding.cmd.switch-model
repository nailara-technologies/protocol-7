## [:< ##

# name  = coding.cmd.switch-model
# descr = switch active inference model and restart servers
# param = <id> [backend=gpu|cpu|both]

my $args = $call->{'args'} // '';

unless ( length $args ) {
    return {
        'mode' => qw| size |,
        data   => "Usage: switch-model <model_checksum> "
            . "[backend=gpu|cpu|both|auto]\nExample: switch-model "
            . "IR65EUQ:ZGJ3K5Y\nExample: switch-model "
            . "IR65EUQ:ZGJ3K5Y backend=cpu\nDefault: auto [ tries "
            . "gpu, falls back to cpu if gpu lacks VRAM ]\n"
    };
}

## Parse arguments ##
my ( $model_checksum, $backend_opt )
    = $args =~ m|^([A-Z2-7]{7}:[A-Z2-7]{7})(?:\s+backend=(\w+))?$|i;

unless ( defined $model_checksum ) {
    return {
        'mode' => qw| size |,
        data   => "Error: Invalid checksum format. Expected XXXXXXX:XXXXXXX\n"
    };
}

$backend_opt = lc( $backend_opt // 'auto' );
unless ( $backend_opt =~ m{^(gpu|cpu|both|auto)$} ) {
    return {
        'mode' => qw| size |,
        data   => "Error: backend must be gpu, cpu, both, or auto\n"
    };
}

## Verify model exists in registry ##
my $model_path;
my $model_name;

my $registry = <coding.model_metadata> // {};
foreach my $key ( keys %$registry ) {
    my $entry = $registry->{$key};
    if ( ( $entry->{'amos'} // '' ) eq $model_checksum ) {
        ## Skip vision projector files ##
        next if $key =~ m|mmproj|i;
        $model_name = $key;
        last;
    }
}

unless ( defined $model_name ) {
    return {
        'mode' => qw| size |,
        data   => "Error: Model $model_checksum not found in registry\nUse "
            . "'coding.list coding-models' to see available "
            . "models\n"
    };
}

## mark a switch as in-flight, generically - lets unrelated watchers (e.g.  ##
## coding.handler.await_resources's twin-handover poller) tell a deliberate ##
## switch-in-progress apart from a genuinely unexpected gpu server loss.    ##
## cleared by coding.handler.switch_model_reply on every exit path.         ##
## confirmed live 2026-06-21: without this, await_resources reacted to      ##
## spawn_smart's kill-old-server step by respawning the OLD, stale-config   ##
## model, racing against this function's own intended spawn.                ##
<coding.switch_model_active> = TRUE;

## Get model path from models zenka  pending switch identity travels with   ##
## THIS request via 'params' - not shared globals - so overlapping          ##
## switch-model calls [ e.g. a self-test switching to model A, then         ##
## restoring to model B before A's reply lands ] can never clobber each     ##
## other. confirmed live 2026-06-21: shared <coding.pending_model_switch_*> ##
## globals caused exactly this race - inference.backend.gpu.model_id could  ##
## be set to the WRONG request's checksum while the actually-spawned server ##
## ran the OTHER request's model file.                                      ##
$reply = <[protocol-7.command.send.local]>->(
    {   'command'   => 'cube.models.get_path_by_amos',
        'call_args' => { 'args' => $model_checksum },
        'reply'     => {
            'timeout' => 5,
            'params'  => {
                'checksum' => $model_checksum,
                'name'     => $model_name,
                'backend'  => $backend_opt,
            },
            'handler' => 'coding.handler.switch_model_reply'
        }
    }
);

return {
    'mode' => qw| size |,
    data   => "Switching model to $model_name "
        . "($model_checksum)...\nRestarting inference servers. "
        . "This may take a moment.\n"
};

