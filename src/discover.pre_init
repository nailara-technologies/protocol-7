## [:< ##

# name = discover.pre_init
# descr = Ensure C25519 usr_name is set before init_code runs

## Set C25519.usr_name based on privilege drop target if configured This runs
## before all init_code modules, ensuring key_vars uses the correct user
my $drop_target_user = <system.amos-zenka-user> // '';

if ( length($drop_target_user) and not defined <crypt.C25519.usr_name> ) {
    <crypt.C25519.usr_name> //= $drop_target_user;
}

0;

