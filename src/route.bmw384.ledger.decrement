## [:< ##

# name  = route.bmw384.ledger.decrement
# descr = decrement a ledger counter, trigger flash on separator inversion
# args  = $arc, $ring

my $arc  = shift;
my $ring = shift;
my $key  = "$arc:$ring";

<route.bmw384.cfg.ledger_counts> //= {};
<bmw384.ledger.counts>           //= {};
my $count = <route.bmw384.cfg.ledger_counts>->{$key} // 7;

if ( $count > 0 ) {
    $count--;
    <route.bmw384.cfg.ledger_counts>->{$key} = $count;
    <bmw384.ledger.counts>->{$key}           = $count;
}

# [ track depletion rate ]
<bmw384.ledger.rates>        //= {};
<bmw384.ledger.rate_history> //= {};
my $now     = <[base.time]>->(3);
my $history = <bmw384.ledger.rate_history>->{$key} //= [];

push @$history, $now;
shift @$history while @$history > 10;

if ( @$history >= 2 ) {
    my $span = $history->[-1] - $history->[0];
    if ( $span > 0 ) {
        <bmw384.ledger.rates>->{$key} = ( @$history - 1 ) / $span;
    }
}

# [ separator inversion at 0 : trigger flash ]
if ( $count == 0 ) {
    <route.bmw384.cfg.ledger_flash> //= {};
    <route.bmw384.cfg.ledger_flash>->{$key} = $now;
    <[base.logs]>->( 1, 'ledger: arc %d ring %d → 0 [FLASH]', $arc, $ring );
}

# [ warning map : log imminent depletions ]
my $warnings = <[route.bmw384.ledger.warning_map]>->(5);
for my $warn_key ( keys %$warnings ) {
    if ( $warnings->{$warn_key} > 0.8 ) {
        my ( $w_arc, $w_ring ) = split ':', $warn_key;
        <[base.logs]>->(
            1, 'ledger: arc %d ring %d warning %.2f',
            $w_arc, $w_ring, $warnings->{$warn_key}
        );
    }
}

return $count;

