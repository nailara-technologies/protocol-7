## [:< ##

# name = protocol-7-menu.graphical-main-loop
# descr = Run Gtk3 main event loop for graphical menu

return 0 unless <protocol-7-menu.init-graphical>;

## Show window and start event loop
my $window = <protocol-7-menu.graphical-window>;

if ( defined $window ) {
    Gtk3->main;
} else {
    <[base.logs]>->(
        2, "graphical window not initialized, cannot start main loop"
    );
    return 0;
}

return 0;

