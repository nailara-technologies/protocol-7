## [:< ##

# name  = plugin.nshell.coding-session.on_ctrl_c
# descr = fully detach this tab from its bound task -- the "close this
#         session" action, distinct from Esc [ which deliberately keeps
#         task_id bound so the conversation stays resumable ]. aborts
#         the task if still running, forgets task_id [ no longer
#         resumable via task-append after this ], clears the visible
#         transcript, and tells the caller to switch back to plain
#         shell mode.
# param = { mode => $mode_href }
# return = { claimed => TRUE } | undef [ not claimed, nothing bound ]

my $args = shift // {};
my $mode = $args->{'mode'};

return undef unless defined $mode;

my $had_task_id = defined $mode->{'task_id'} and length $mode->{'task_id'};
my $had_buffer  = length( $mode->{'buffer'} // '' );

## nothing bound and nothing on screen : don't claim the key, let it fall ##
## through to the normal editor engine [ real SIGINT ]                    ##
return undef unless $had_task_id or $had_buffer;

if ($had_task_id) {
    ## same reasoning as on_escape's abort : always send it, let           ##
    ## coding.cmd.abort-inference's own server-side check no-op harmlessly ##
    ## if nothing was actually running                                     ##
    my ($cube_sid) = keys <user.cube.session>->%*;
    if ( defined $cube_sid and exists $data{'session'}{$cube_sid} ) {
        $data{'session'}{$cube_sid}{'buffer'}{'output'}
            .= "coding.abort-inference $mode->{'task_id'}\n";
    }

    ## this is routinely a no-op [ e.g. Ctrl+C between rounds, nothing      ##
    ## streaming ] -- suppress the raw wire reply either way. MUST live on  ##
    ## shared nshell state, not the mode object : this function switches    ##
    ## display_mode_index back to shell SYNCHRONOUSLY below, but the        ##
    ## abort-inference reply only arrives LATER [ async ] -- by then        ##
    ## nshell.handler.command_reply would be looking at the shell mode [ no ##
    ## plugin at all ], never at this coding-session mode object, so a flag ##
    ## stored here would simply never get checked. confirmed live           ##
    ## 2026-09-14 : "no active inference task" still printed on an idle     ##
    ## Ctrl+C despite this flag existing, because it was on the wrong       ##
    ## object.                                                              ##
    <nshell.state>->{'suppress_next_wire_reply'} = TRUE;
}

delete $mode->{'task_id'};
delete $mode->{'awaiting_task_id'};
delete $mode->{'esc_stage'};
$mode->{'buffer'} = '';

return { 'claimed' => TRUE };

