## [:< ##

# name  = invoke-web.gpu_lease.handler.renew_reply
# descr = unload if models says the render lease is no longer ours

my $reply = shift // {};
my ( $mode, $text ) = <[base.reply.mode_text]>->($reply);
return TRUE if $mode eq qw| true |;
return TRUE if ( <invoke-web.gpu_lease.holder> // '' ) ne qw| invoke-web |;

## only models saying so ends the lease : an unreachable models is no     ##
## refusal, stop asking until it is back -- a renewal would also start it ##
## on demand                                                              ##
if ( $text ne 'not holder' ) {
    my $renew = delete <invoke-web.gpu_lease.renew_timer>;
    $renew->cancel if defined $renew and $renew->is_active;
    <invoke-web.gpu_lease.renew_timer> = <[event.add_timer]>->(
        {   'after'   => 300,    ## a notification can get lost ##
            'handler' => qw| invoke-web.gpu_lease.handler.renew |,
        }
    );
    return TRUE if <invoke-web.gpu_lease.models_waiting>;
    <invoke-web.gpu_lease.models_waiting> = TRUE;
    <[base.logs]>->(
        1, ': models not reachable [ %s ] : lease renewal waits', $text
    );
    <[protocol-7.route-send]>->(
        {   'command'   => qw| v7-zenki.notify_online |,
            'call_args' => { 'args' => qw| models | },
            'reply'     => {
                'handler' => qw| invoke-web.gpu_lease.handler.models_back |,
                'params'  => {},
            },
        }
    );
    return TRUE;
}
<[base.logs]>->( 0, ': gpu lease renewal refused : unloading render models' );
return <[invoke-web.gpu_lease.unload]>->( qw| coding |, qw| handover | );

