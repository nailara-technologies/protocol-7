## [:< ##

# name  = invoke-web.gpu_lease.handler.renew_reply
# descr = unload if models says the render lease is no longer ours

my $reply = shift // {};
my ( $mode, $text ) = <[base.reply.mode_text]>->($reply);
return TRUE if $mode eq qw| true |;
return TRUE if ( <invoke-web.gpu_lease.holder> // '' ) ne qw| invoke-web |;

## only models saying so ends the lease : an unreachable models is no ##
## refusal                                                            ##
if ( $text ne 'not holder' ) {
    <[base.logs]>->( 2, ': gpu lease renewal unanswered [ %s ]', $text );
    return TRUE;
}
<[base.logs]>->( 0, ': gpu lease renewal refused : unloading render models' );
return <[invoke-web.gpu_lease.unload]>->( qw| coding |, qw| handover | );

