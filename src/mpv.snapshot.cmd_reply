## [:< ##

# name  = mpv.snapshot.cmd_reply
# descr = snapshot-save completion : reply to the caller

my $reply_id = delete <mpv.snapshot.cmd_reply_id> // qw| silent |;

<[base.callback.cmd_reply]>->(
    $reply_id,
    {   'mode' => qw| true |,
        'data' => 'snapshot saved to state/snapshot.yaml'
    }
);

return;

