## [:< ##

# name   = base.route.add

my $params = shift;

if ( ref $params ne qw| HASH | ) {
    <[base.log]>->( 0, 'add_route: argument is no hash reference' );
    return undef;
}

my $id            = $params->{'source'}->{'sid'};
my $cmd_id        = $params->{'source'}->{'cmd_id'} // 0;
my $reply_handler = $params->{'reply'}->{'handler'};
my $reply_params  = $params->{'reply'}->{'params'};
my $target_sid    = $params->{'target'}->{'sid'};

if ( not defined $target_sid ) {
    warn 'target session id is required for setting up route <{C1}>';
    return undef;
}
if ( defined $cmd_id and not length $cmd_id ) {
    warn 'src cmd_id must be numerical or undef <{C1}>';
    $cmd_id = 0;
}

return FALSE
    if not exists $data{'session'}->{$target_sid}
    or not exists $data{'session'}->{$id};
$data{'session'}->{$target_sid}->{'route'} //= {};

my $target_cmd_id = <[base.gen_id]>->(
    $data{'session'}->{$target_sid}->{'route'},
    <limits.routes.per_client> //= 13747,
    undef, 0
);

my $route_id = <[base.list.element.add]>->(
    {   'key_ref' => \$data{'route'},
        'val_ref' => \{

            'source' => {
                'sid'    => $id,
                'cmd_id' => $cmd_id
            },
            'target' => {
                'sid'    => $target_sid,
                'cmd_id' => $target_cmd_id
            },
            'reply' => {
                'handler' => $reply_handler,
                'params'  => $reply_params
            },
            'start_time' => <[base.ntime]>,

            ## 'protocol' => $proto,  'handle'   => $fd,  'mode'     => $mode,
            'state'    => 0,
            'shutdown' => 0,
            'user'     => <base.session.uname.server>,
            'size'     => {
                'buffer' => {
                    'input'  => <size.buffer.input>,
                    'output' => <size.buffer.output>
                }
            }
        },
        'want_harmony' => 0
    }
);

$data{'session'}->{$id}->{'route'}->{$cmd_id}
    = $data{'session'}->{$target_sid}->{'route'}->{$target_cmd_id}
    = $route_id;

## short-lived route history [ optional, base.route.init_code ] : a reply ##
## to an unknown route id can then still tell what was issued for it      ##
if (<base.route_history.enabled>) {
    my $history = <base.route_history.entries> //= {};
    my $order   = <base.route_history.order>   //= [];
    my $key     = join qw| : |, $target_sid, $target_cmd_id;
    my $seq     = ++<base.route_history.seq>;
    $history->{$key} = {
        'route_id'   => $route_id,
        'src_sid'    => $id,
        'src_cmd_id' => $cmd_id,
        'time'       => time,
        'seq'        => $seq,
    };
    push $order->@*, [ $key, $seq ];

    ## oldest out first ; a key issued again since keeps its newer entry ##
    while ( $order->@* > <base.route_history.size> ) {
        my ( $old_key, $old_seq ) = ( shift $order->@* )->@*;
        delete $history->{$old_key}
            if exists $history->{$old_key}
            and $history->{$old_key}->{'seq'} == $old_seq;
    }
}

return $data{'route'}->{$route_id};

