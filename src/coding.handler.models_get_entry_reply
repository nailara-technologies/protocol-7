# name = coding.handler.models_get_entry_reply
# descr = Handle async response from models.get_entry command

my $reply = shift;

my $sid        = $reply->{'sid'};
my $cmd_status = $reply->{'cmd'};
my $call_args  = $reply->{'call_args'};
my $model_amos = $reply->{'params'}->{'model_amos'};
my $task_id    = $reply->{'params'}->{'task_id'};

<[base.logs]>->(
    2, "[coding] models_get_entry_reply: status=%s model=%s task=%s sid=%s",
    $cmd_status, $model_amos, $task_id, $sid
);

# Log call_args structure for debugging
if ( ref($call_args) eq qw| HASH | ) {
    my @keys = keys %$call_args;
    <[base.logs]>->(
        2,
        "[coding] models_get_entry: call_args keys: %s",
        join( ", ", @keys )
    );
    foreach my $key (@keys) {
        my $val = $call_args->{$key};
        if ( ref($val) eq qw| HASH | ) {
            my @subkeys = keys %$val;
            <[base.logs]>->(
                2,    "[coding] models_get_entry: %s = HASH with keys: %s",
                $key, join( ", ", @subkeys )
            );
        } elsif ( ref($val) eq 'ARRAY' ) {
            <[base.logs]>->(
                2,    "[coding] models_get_entry: %s = ARRAY[%d]",
                $key, scalar(@$val)
            );
        } elsif ( ref($val) ) {
            <[base.logs]>->(
                2,    "[coding] models_get_entry: %s = %s",
                $key, ref($val)
            );
        } else {
            <[base.logs]>->(
                2,    "[coding] models_get_entry: %s = %s",
                $key, $val
            );
        }
    }
}

# TODO: Process model entry metadata from $call_args
# TODO: Validate model exists and is available
# TODO: Continue task with model metadata

return 1;

