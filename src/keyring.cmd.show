## [:< ##

# name  = keyring.cmd.show
# descr = show key metadata for a namespace path [ no raw key ].
#         triggers derivation and caches the key if not present.

my $dot_path = shift @ARG // '';

if ( not length $dot_path ) {
    return { 'mode' => qw| false |, 'data' => 'usage: keyring.show <path>' };
}

## derive [ populates cache ] ##
my $key = <[keyring.derive]>->($dot_path);

if ( not defined $key ) {
    return {
        'mode' => qw| false |,
        'data' => sprintf(
            'keyring.show: ' . 'derivation failed [ %s ]',
            $dot_path
        )
    };
}

my $entry      = <keyring.namespace>->{$dot_path};
my $depth      = $entry->{'depth'}      // scalar split( m|\.|, $dot_path );
my $derived_at = $entry->{'derived_at'} // '?';

## distance from session root = depth ##
my $root_distance = $depth;

my $output
    = sprintf( "path:           %s\ndepth:          "
        . "%d\nderived_at:     %s\nroot_distance:  %d",
    $dot_path, $depth, $derived_at, $root_distance );

return { 'mode' => qw| size |, 'data' => $output };

