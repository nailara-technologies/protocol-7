## [:< ##

# name  = workspace-transfer.init_code
# descr = workspace-transfer zenka initialization

<[base.perlmod.autoload]>->(qw| File::Spec |);
<[base.perlmod.autoload]>->(qw| Cwd |);

# Workspace directory constant
our $WORKSPACE_DIR = '/var/run/.7/workspace-transfer';
our $WORKSPACE_REPO
    = 'https://github.com/nailara-technologies/workspace-transfer.git';

# Ensure workspace is cloned
{
    no warnings qw| redefine |;
    *ensure_workspace = sub {
        return <[workspace-transfer.util.ensure_workspace]>->(@ARG);
    };
    *chdir_workspace = sub {
        return <[workspace-transfer.util.chdir_workspace]>->(@ARG);
    };
}

# Initialize workspace module
<[base.logs]>->( 2, 'workspace module initialized' );

