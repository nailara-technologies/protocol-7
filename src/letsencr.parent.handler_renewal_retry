## [:< ##

# name  = letsencr.parent.handler_renewal_retry
# descr = handle scheduled renewal retry from timer
#         - resend renewal request to child

my $event = shift;    ## event object : retry data stored in renewal_timers

## find the first domain scheduled for retry
my $timers  = <letsencr.parent.renewal_timers> // {};
my $domain  = '';
my $attempt = 1;

for my $d ( keys %{$timers} ) {
    if ( $timers->{$d}{status} eq qw| retry | ) {
        $domain  = $d;
        $attempt = $timers->{$d}{attempts} // 1;
        last;
    }
}

unless ( length $domain ) {
    <[base.log]>->( 2, 'renewal retry: no domains pending retry' );
    return FALSE;
}

<[base.logs]>->(
    2,       "renewal retry for domain : %s (attempt %d)",
    $domain, $attempt
);

## Get certificate info
my $cert_info = <letsencr.parent.certs>->{$domain};
return FALSE unless $cert_info;

## Send renewal command to child via parent pipe (same as
## queue_renewal_requests)
<[protocol-7.command.send.local]>->(
    {   'command'   => qw| child.renew-certificate |,
        'call_args' => {
            'param' => {
                'domain'    => $domain,
                'alt_names' =>
                    join( qw| |, @{ $cert_info->{alt_names} // [] } ),
                'account_id'      => $cert_info->{account_id},
                'certificate_url' => $cert_info->{certificate_url},
                'retry_attempt'   => $attempt,
            }
        },
        'reply' => {
            'handler' => qw| letsencr.parent.handler_renewal_reply |,
            'params'  => { 'domain' => $domain, 'attempt' => $attempt }
        }
    }
);

## Update attempt counter
if ( exists <letsencr.parent.renewal_timers>->{$domain} ) {
    <letsencr.parent.renewal_timers>->{$domain}{attempts}++;
}

return TRUE;

