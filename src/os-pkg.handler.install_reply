## [:< ##

# name  = os-pkg.handler.install_reply
# descr = complete os-pkg.install with the backend zenka's deferred reply

my $reply = shift;
return warn 'no reply hashref received' if not defined $reply;

## reply-handler signature : one hashref { sid, cmd, call_args, params } ##
## 'cmd' is the wire-level mode keyword, the payload is call_args->args  ##
## [ see sys-deps.handler.install_reply ]                                ##
my $mode      = uc( $reply->{'cmd'} // '' );
my $params    = $reply->{'params'}              // {};
my $reply_str = $reply->{'call_args'}->{'args'} // '';
my $reply_id  = $params->{'reply_id'};
my $packages  = $params->{'packages'} // [];
my $zenka     = $params->{'zenka'};
my $backend   = $params->{'backend'} // 'backend';

my $ok = $mode eq qw| TRUE |;

## the wire-level reply is all-or-nothing                               ##
## [ same shape as  sys-deps.handler.install_reply ] : TRUE means every ##
## requested package installed OK, anything else means they all failed  ##
my ( @ok, @failed );
if ($ok) {
    @ok = @$packages;
} else {
    @failed = @$packages;
}

<[base.logs]>->(
    $ok ? 1 : 0,
    'os-pkg: %s %s : %s',
    $backend,
    $ok                ? 'done'     : 'failed',
    length($reply_str) ? $reply_str : qw| no details |
);

## Track the packages that INSTALLED OK in var/sys-deps/tracked.yaml via    ##
## the shared AMOS7::deps::tracked record                                   ##
## [ dedups on type + name, writes atomically ] : failed packages are never ##
## recorded                                                                 ##
if (@ok) {
    my @entries = map {
        {   'pkg'          => $ARG,
            'type'         => $params->{'backend'} // qw| debian |,
            'installed_at' => <[base.ntime.b32]>   // '',
            'source'       => 'os-pkg',
            'zenka'        => $zenka,
            'declared'     => 0
        }
    } @ok;
    AMOS7::deps::tracked::record( <system.root_path>, \@entries );
}

return if not defined $reply_id;

<[base.callback.cmd_reply]>->(
    $reply_id,
    {   'mode' => $ok ? qw| true | : qw| false |,
        'data' => length($reply_str)
        ? $reply_str
        : ( $ok ? 'installed' : 'install failed' )
    }
);

return;

