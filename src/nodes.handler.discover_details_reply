# name  = nodes.handler.discover_details_reply

my $params       = shift;
my $name         = $params->{'params'}->{'name'};
my $reply_string = $params->{'data'};
my $host_href    = <nodes.local-network.online-hosts>->{$name} //= {};

my %reply_params;
chomp $reply_string;
foreach my $line ( split "\n", $reply_string ) {
    next if $line !~ m|^ *(?<key>\S+) +: +(?<val>\S+)$|;
    $reply_params{ $+{'key'} } = $+{'val'};
}

my $reply_packet_params;
foreach my $key (qw| ip_addr hwaddr pkey |) {
    if ( not defined $reply_params{$key} ) {
        <[base.s_warn]>->(
            "[%s] reply packet is missing '%s' parameter",
            $name, $key
        );
        next;
    }
    if ( $key eq qw| pkey | ) {
        $reply_params{$key} = Crypt::Misc::decode_b32r( $reply_params{$key} );
        if ( not defined $reply_params{$key} ) {
            warn 'base 32 decoding of public key failed';
            next;
        }
    }
    $host_href->{$key} = $reply_params{$key};
}

## host-root trust fields [ data/md/design/HOST-ROOT-DELEGATION.md ] :      ##
## stored as strings, shown per node entry -- no trust decisions here.  the ##
## details reply [ from discover's host entry ] is authoritative ; the      ##
## host-status stash is the fallback when the reply omits them              ##
my $stash = <nodes.local-network.host-trust> // {};
foreach my $key (qw| trust root_fp delegated_name |) {
    if ( defined $reply_params{$key} ) {
        $host_href->{$key} = $reply_params{$key};
    } elsif ( exists $stash->{$name} and defined $stash->{$name}->{$key} ) {
        $host_href->{$key} = $stash->{$name}->{$key};
    }
}
delete $stash->{$name};    ##  consumed  ##

