## [:< ##
# name  = storage.cmd.plan9-create
# descr = Create a file or directory over 9P

my $args = $call->{'args'} // '';
my @tok  = split m|\s+|, $args;

my $name = shift @tok;
my $path = shift @tok;

if ( not length( $name // '' ) or not length( $path // '' ) ) {
    return {
        'mode' => 'false',
        'data' => 'usage: plan9-create <connection-name> '
            . '<path> [:dir:] [<content>]'
    };
}

my $is_dir = 0;
my @content_tok;

for ( my $i = 0; $i < @tok; $i++ ) {
    if ( $tok[$i] eq ':dir:' ) {
        $is_dir = 1;
    } else {
        push @content_tok, $tok[$i];
    }
}

my $content = join( ' ', @content_tok );

my $conn = <storage.9p.connections>->{$name};
return { 'mode' => 'false', 'data' => 'not connected' } unless $conn;

my $result = <[storage.9p.create-file]>->( $conn, $path, $content, $is_dir );
return $result if $result->{'mode'} eq 'false';

return {
    'mode' => 'true',
    'data' => "created $path" . ( $is_dir ? " [directory]" : "" )
};

