## [:< ##

# name  = invoke-web.handler.drain_check
# descr = drain timer [ every minute while invoke.ai runs ] :
#         1. queue empty + a parked session with resume mode 'empty' ->
#            resume it [ oldest first ]
#         2. queue drained and no activity for <invoke-web.drain.idle_after>
#            seconds -> stop invoke.ai, wait for its exit, then the regular
#            idle-term path [ base.handler.ondemand_timeout : v7 ends the
#            zenka cleanly, notify_offline subscribers get their reply ]
# note  = activity : any output line or database write [ invoke-web.
#         activity.* ]. a paused queue with pending items only counts as
#         drained with invoke-web.drain.paused_counts_idle = yes

my $now = <[base.time]>->(0);

## fallback for the interactive mode : a database write missed by the ##
## inotify watch is caught here within a minute                       ##
<[invoke-web.handler.queue_watch]> if <invoke-web.queue_interactive>;

## phase 2 : stop requested, wait until invoke.ai is gone ##
if ( defined <invoke-web.drain.stopping> ) {
    ## cmd.stop clears <invoke-web.pid> at once : the pid is kept here ##
    return
        if <[invoke-web.is_alive]>->(<invoke-web.drain.stopping_pid>)
        and $now - <invoke-web.drain.stopping> < 60;
    delete <invoke-web.drain.stopping>;
    delete <invoke-web.drain.stopping_pid>;
    <[base.logs]>->( 1, 'invoke.ai drained : zenka idle shutdown' );
    <[base.handler.ondemand_timeout]>;
    return;
}

return if ( <invoke-web.status> // '' ) ne 'running';
## the image index job needs the zenka ##
return if <invoke-web.index.running>;

## queue state from the db : no blocking http call in the event loop -- ##
## invoke.ai's api answers slowly while it loads models [ a blocking    ##
## request stalled the zenka : v7 response timeouts ]                   ##
my $dbh = <[invoke-web.queue.db]> // return;
my ( $in_progress, $pending ) = $dbh->selectrow_array(
    "SELECT SUM( status = 'in_progress' ), SUM( status "
        . "= 'pending' AND priority > ? ) FROM session_queue",
    undef,
    -( <invoke-web.session.park_offset> // 1000000 ) / 2
);
return if not defined $in_progress or $in_progress;
$pending //= 0;

## 1. empty queue : resume a parked session with resume mode 'empty' ##
if ( not $pending ) {
    my $sessions = <[invoke-web.session.store]>;
    my ($next) = sort {
        $sessions->{$a}->{'parked_at'} <=> $sessions->{$b}->{'parked_at'}
        }
        grep { ( $sessions->{$ARG}->{'mode'} // '' ) eq qw| empty | }
        keys %$sessions;
    if ( defined $next ) {
        <[invoke-web.session.resume]>->($next);
        <[invoke-web.activity.touch]>->(qw| resume |);
        return;
    }
}

## 2. drain : idle long enough with nothing left to render ##
my $idle_after = <invoke-web.drain.idle_after> // 0;
return if $idle_after < 1;

my $idle = $now - ( <invoke-web.activity.last> // $now );
return if $idle < $idle_after;

if ($pending) {
    return
        if not
        <[base.cfg_bool]>->( <invoke-web.drain.paused_counts_idle> // FALSE );

    ## the processor state is only in the api : ask async, drain in the ##
    ## reply [ invoke-web.handler.drain_processor ]                     ##
    <[invoke-web.api_async]>->(
        'GET', '/api/v1/queue/default/status',
        undef,
        'invoke-web.handler.drain_processor',
        { 'idle' => $idle, 'pending' => $pending }
    );
    return;
}

<[invoke-web.drain.stop]>->( $idle, 0 );

