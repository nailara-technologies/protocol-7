## [:< ##

# name  = branch.discover.resolve
# descr = query discover zenka for nodes matching criteria
# param = { name }  or  { group }  or  { id }
#
# returns query_id immediately [ async ]; caller polls or uses reply.handler

use YAML::XS qw| Dump |;

my $params = shift // {};

my $name  = $params->{'name'}  // '';
my $group = $params->{'group'} // '';
my $id    = $params->{'id'}    // '';

return { 'mode' => 'false', 'data' => 'query criteria required' }
    unless length $name
    or length $group
    or length $id;

my $query = {};
$query->{'name'}  = $name  if length $name;
$query->{'group'} = $group if length $group;
$query->{'id'}    = $id    if length $id;

my $query_id = <[base.gen_id]>->( $data{'branch.discover.queries'} // {} );

my $args_yaml = eval { Dump($query) } // '';

$data{'branch.discover.queries'}{$query_id} = {
    'ntime'  => <[base.ntime]>,
    'query'  => $query,
    'status' => 'pending',
};

<[protocol-7.route-send]>->(
    {   'command'   => 'discover.branch.query',
        'call_args' => { 'args' => $args_yaml },
        'reply'     => {
            'handler' => 'branch.discover.handler.resolve_reply',
            'params'  => { 'query_id' => $query_id }
        }
    }
);

<[base.logs]>->( 2, 'branch.discover.resolve: query %s', $query_id );

return { 'mode' => 'true', 'data' => $query_id };

