## [:< ##

# name  = ascii.frame.render.html.escape
# descr = escape html entities

my $text = shift;
return '' if not defined $text;
$text =~ s{&}{&amp;}g;
$text =~ s{<}{&lt;}g;
$text =~ s{>}{&gt;}g;
$text =~ s{"}{&quot;}g;
return $text;

