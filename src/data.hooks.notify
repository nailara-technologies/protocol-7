## [:< ##

# name  = data.hooks.notify
# param = <event> <hash-path> [data...]
# descr = notify registered zenki about data events

my ( $event, $hash_path, @extra ) = @ARG;

return unless defined $event and defined $hash_path;

## get registered hooks for this event ##
my $hooks = <data.hooks.registered>->{$event} // [];

return unless @{$hooks};

<[base.logs]>->(
    2,
    "data hook: notifying %d subscriber(s) for '%s'",
    scalar( @{$hooks} ), $event
);

## send notifications ##
foreach my $hook ( @{$hooks} ) {
    my $target_zenka = $hook->{'zenka'}    // 'index';
    my $command      = $hook->{'command'}  // 'data.imported';
    my $priority     = $hook->{'priority'} // 1;

    ## skip if priority filter set ##
    next
        if defined $extra[0]
        and $extra[0] =~ m|^\d+$|
        and $priority > $extra[0];

    ## send command to target zenka ##
    <[protocol-7.command.send.local]>->(
        {   'command'   => "$target_zenka.$command",
            'call_args' => { 'args' => join( ' ', $hash_path, @extra ) }
        }
    );
}

return TRUE;

