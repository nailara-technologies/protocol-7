## [:< ##

# name  = invoke-web.cmd.queue-order
# descr = re-sort pending queue items [ newest|oldest|harmonic ]
# param = newest | oldest | harmonic [ default newest ]

my $mode = $call->{'args'} // '';
$mode = qw| newest | if not length $mode;

return { mode => qw| false |, data => 'mode : newest | oldest | harmonic' }
    if $mode !~ m{^(?:newest|oldest|harmonic)$};

my $count = <[invoke-web.queue.order]>->($mode);

return { mode => qw| false |, data => 'queue reorder failed [ see log ]' }
    if not defined $count;

return {
    mode => qw| size |,
    data => sprintf(
        "queue reordered [ %s, %d pending items ]\n", $mode, $count
    )
};

