## [:< ##

# name  = pager.buffer.page.get
# descr = get page from cache or load from source

my ( $buf, $page_num ) = @ARG;

# Cache hit
if ( exists $buf->{'pages'}{'cached'}{$page_num} ) {
    $buf->{'stats'}{'hits'}++;
    <[pager.util.buffer.update_lru]>->( $buf, $page_num );
    return $buf->{'pages'}{'cached'}{$page_num};
}

# Cache miss - need to load
$buf->{'stats'}{'misses'}++;

# 1. Evict oldest page if at limit
my $cached = $buf->{'pages'}{'cached'};
if ( scalar( keys %$cached ) >= $buf->{'pages'}{'max_cache'} ) {
    my $evict = shift @{ $buf->{'pages'}{'lru'} };
    if ( defined $evict && exists $cached->{$evict} ) {
        my $evicted_items = scalar( @{ $cached->{$evict} } );
        delete $cached->{$evict};
        $buf->{'memory'}{'current'} -= $evicted_items;
    }
}

# 2. Load from source (may require multiple batches)
my $items = <[pager.util.buffer.load_page_items]>->( $buf, $page_num );

return undef unless $items && @$items;

# 3. Apply filter chain
$items = <[pager.util.buffer.apply_filters]>->( $buf, $items );

# 4. Apply sort if configured
$items = <[pager.util.buffer.apply_sort]>->( $buf, $items ) if $buf->{'sort'};

# 5. Cache and update LRU
$cached->{$page_num} = $items;
push @{ $buf->{'pages'}{'lru'} }, $page_num;
$buf->{'memory'}{'current'}   += scalar(@$items);
$buf->{'stats'}{'items_seen'} += scalar(@$items);

# 6. Trigger prefetch
<[pager.buffer.prefetch]>->(
    {   'buffer_id' => $buf->{'id'},
        'page_num'  => $page_num,
        'direction' => 'forward',
    }
);

return $items;

