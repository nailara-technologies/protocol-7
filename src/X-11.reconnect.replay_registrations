## [:< ##

# name  = X-11.reconnect.replay_registrations
# descr = re-issue per-connection X11 registrations after reconnect or dial

my $target_X  = shift // <X-11.obj>;
my $wire_only = shift // FALSE;

return if not defined $target_X;

my $is_primary
    = ( defined <X-11.obj> and $target_X == <X-11.obj> )
    ? TRUE
    : FALSE;

## safe error handler: empty/malformed error means the connection state    ##
## itself is questionable [ eg. server crashed ] -- on the primary trigger ##
## reconnect, on a standby just log since it is not the active connection  ##
$target_X->{'error_handler'} = sub {
    my ( $self, $err_data ) = @ARG;

    if ( !length($err_data) ) {
        warn(
            sprintf '[protocol-error] unknown protocol '
                . 'error [ X-server crashed ? ] <{C7}>' );
        <[X-11.reconnect]> if $is_primary;
        return;
    }

    chomp( my $err_str = $self->format_error_msg($err_data) );
    $err_str =~ s|\s*\n+\s*| << ! >> |g;
    warn( sprintf '[protocol-error] %s <{C7}>', $err_str );
};

## queue events instead of dispatching them immediately ##
$target_X->{'event_handler'} = qw| queue |;

## for the primary connection, wire up [ or re-wire ] the IO watcher so   ##
## global_hotkeys keeps reading from the right filehandle after reconnect ##
if ( $is_primary and not $wire_only ) {
    if ( defined <X-11.event.io_watcher> ) {
        <X-11.event.io_watcher>->cancel
            if <X-11.event.io_watcher>->can('cancel');
        <X-11.event.io_watcher> = undef;
    }

    <X-11.event.io_watcher> = <[event.add_io]>->(
        {   'fd'      => $target_X->{'connection'}->fh,
            'handler' => qw| X-11.handler.global_hotkeys |
        }
    );
}

## re-enable randr screen-change notifications ##
if ( <X-11.has_randr> // FALSE and <X-11.mode> eq qw| host | ) {
    my $randr_ok = eval { $target_X->init_extension('RANDR') };
    if ($randr_ok) {
        eval { $target_X->RRSelectInput( $target_X->root, 1 ) };
        if ($EVAL_ERROR) {
            <[base.log]>
                ->( 1, ': : RANDR screen-change subscription failed' );
        } else {
            <[base.log]>->(
                1, ': : RANDR screen-change notifications enabled'
            );
        }
    }
}

## re-grab keyboard ##
if ( <[base.cfg_bool]>->(<X-11.keybd.grab_all_keys>) ) {
    <[X-11.grab_key]>->( 0, undef, $target_X );
}

return TRUE;

