## [:< ##

# name  = events.source.disarm
# descr = disarm every source of static or bucket entry references
# args   = numeric static ids or <owner>/<id> bucket references

my $registry = <[events.plugin.registry]>->();
foreach my $type ( sort keys %{ $registry->{'source'} } ) {
    $registry->{'source'}{$type}{'disarm'}->( \@ARG );
}

return TRUE;

