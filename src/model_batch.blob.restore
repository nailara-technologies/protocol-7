## [:< ##

# name  = model_batch.blob.restore
# descr = restore one blob checksum to a destination path, atomically
# param = <checksum> <dest-path> -> TRUE | undef

my $checksum  = shift // '';
my $dest_path = shift // '';

if ( !length $checksum ) {
    warn 'expected checksum parameter <{C1}>';
    return undef;
}
if ( !length $dest_path ) {
    warn 'expected dest path parameter <{C1}>';
    return undef;
}

## never through a symlink : the rename below would replace the link itself ##
## with a regular file                                                      ##
if ( -l $dest_path ) {
    warn "refusing to restore over a symlink '$dest_path' <{C1}>";
    return undef;
}

my $content = <[model_batch.blob.read]>->($checksum);
return undef unless defined $content;

## ensure the destination's parent directory exists [ baseline paths ##
## normally still exist, deleted-and-recreated ones may not ]        ##
my $parent_dir = $dest_path;
$parent_dir =~ s|/[^/]+$||;
<[file.path.make_dir]>->($parent_dir)
    if length $parent_dir and not -d $parent_dir;

## raw bytes through a temp file + rename : a failed write never leaves a ##
## half-restored destination                                              ##
if ( -w $parent_dir ) {
    my $tmp_path = "$dest_path.restore-$$";
    open( my $out_fh, '>:raw', $tmp_path ) or return undef;
    my $ok = print {$out_fh} $content;
    $ok = close($out_fh) && $ok;
    if ( !$ok or !rename( $tmp_path, $dest_path ) ) {
        unlink $tmp_path;
        return undef;
    }
    return TRUE;
}

## directory not writable [ src/ : group-writable files, read-only dir ] : ##
## write in place, a missing file is created through the coding zenka's    ##
## chmod child first [ the way write_new_file creates files there ]        ##
my $chmod_fh = <coding.chmod_child.w_fh>;
if ( !-e $dest_path ) {
    return undef unless defined $chmod_fh;
    print {$chmod_fh} "create $dest_path\n";
    <[coding.chmod_child.readline]>;
}

## an existing file the zenka cannot write : edit_file wrote it through a  ##
## temporary group-write [ chmod child 'gw' ] and put the mode back -- the ##
## revert does the same [ found live 2026-10-10 : label-size-edit ]        ##
my $mode_restore;
if ( -f $dest_path and !-w $dest_path and defined $chmod_fh ) {
    $mode_restore = ( CORE::stat $dest_path )[2] & 07777;
    print {$chmod_fh} "gw $dest_path\n";
    <[coding.chmod_child.readline]>;
}

my $ok = open( my $out_fh, '>:raw', $dest_path );
if ($ok) {
    $ok = print {$out_fh} $content;
    $ok = close($out_fh) && $ok;
}

if ( defined $mode_restore ) {
    printf {$chmod_fh} "restore %04o %s\n", $mode_restore, $dest_path;
    <[coding.chmod_child.readline]>;
}

return $ok ? TRUE : undef;

