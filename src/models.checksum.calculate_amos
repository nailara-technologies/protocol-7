# name  = models.checksum.calculate_amos
# args  = $file_path
# descr = Calculate 7-character AMOS checksum for model file

my $file_path = shift;
return undef unless -f $file_path;

my $content_sref = <[file.slurp]>->( $file_path, ':raw' );
return undef unless $content_sref;

# Use Protocol-7 chk-sum.amos wrapper (delegates to AMOS7::CHKSUM)
my $amos_checksum = <[chk-sum.amos]>->($content_sref);
return $amos_checksum;    # 7-character BASE32

