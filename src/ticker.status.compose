## [:< ##

# name   = ticker.status.compose
# descr  = status lines in front of the given text
# args   = text [ the file content, may be empty ]
# return = the text to scroll [ lines in the order they were set ]

my $base  = shift                 // '';
my $lines = <ticker.status.lines> // {};
my @set   = map { $lines->{$ARG}{'text'} }
    sort { $lines->{$a}{'time'} <=> $lines->{$b}{'time'} or $a cmp $b }
    keys %{$lines};
return join ' :: ', @set, grep {length} $base;

