## [:< ##

# name  = users.init_code
# descr = init users zenka, register host-system path keyword

<[base.logs]>->( 2, 'users zenka initialized' );

## create + own etc_P7/<zenka-name> via the generic, already-established  ##
## zenka-path setup routine [ every other zenka using an etc_P7 dir uses  ##
## this same mechanism — self-healing owner/perms on every boot, not just ##
## create-once ]. relies on this zenka being named 'users', which makes   ##
## etc_P7/users == the shared top-level convention this doc wants [ NOT a ##
## per-zenka-namespaced subdir — see storage_layout in                    ##
## data/yaml/coding-tasks/users-zenka.yaml for why that's intentional ]   ##
## only meaningful while still root [ init_code runs before               ##
## root.drop_privs ] — skip cleanly on a post-drop-privs re-init/reload   ##
if ( $EFFECTIVE_USER_ID == 0 ) {
    <[base.path-set-up.check-zenka-paths]>->( FALSE, undef, TRUE, 0770 );
} else {
    <[base.logs]>->(
        2,
        'users: skipping zenka-path ownership '
            . 'check [ privileges already dropped ]'
    );
}

## etc_P7/users ##
my $users_etc_dir   = <[file.zenka_dir.data_path]>->(TRUE);
my $users_host_path = join qw| / |, $users_etc_dir, qw| host-system |;

## ONE call, both keywords together -- base.path.register_keywords ASSIGNS
## <base.path.keywords> wholesale [ '<base.path.keywords> = $keywords_href' ],
## it does not merge.  a second call would silently WIPE OUT USERS_HOST, not
## add to it -- hit live, 2026-08-15/16 : real records started reading as 'not
## found' the moment a separate VAR_P7-only call landed, even though the file
## was present, valid, and correctly owned on disk.
##
## VAR_P7 itself : this zenka's own var dir, same bare
## <[file.zenka_dir.data_path]> call user-edit.init_code already uses for its
## own VAR_P7 -- base.local_history.write [ shared, loaded here via
## users.cmd.value-set ] hardcodes '[VAR_P7]/history/...' and expects the
## loading zenka to have registered it itself ; users never had, so every
## value-set left the keyword literally unresolved [ a non-absolute path ],
## warning 'expected absolute path [ to create ]' at
## base.local_history.write:57 on every submit and silently never writing the
## history snapshot. found live while testing user-edit's key-actions tab --
## unrelated to that feature, this zenka's own pre-existing gap
<[base.path.register_keywords]>->(
    {   qw| USERS_HOST | => $users_host_path,
        qw| VAR_P7 |     => <[file.zenka_dir.data_path]>,
    }
);

## host-system/ itself: check-zenka-paths only manages the etc_P7/<zenka>   ##
## dir, not sub-dirs under it, so this one level still needs its own create ##
## step — same root-only guard as above                                     ##
if ( $EFFECTIVE_USER_ID == 0 and not -d $users_host_path ) {
    <[file.make_path]>->(
        $users_host_path,         0770,
        <system.amos-zenka-user>, <system.amos-zenka-user>
    );
}

return TRUE;

