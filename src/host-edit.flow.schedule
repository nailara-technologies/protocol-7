## [:< ##

# name   = host-edit.flow.schedule
# descr  = run the next add-host step from a timer [ repaint in between ]
# param  = <record name> <delay seconds>

my ( $name, $delay ) = @ARG;

my $timer = <[event.add_timer]>->(
    {   qw| after |  => $delay // 0,
        qw| repeat | => FALSE,
        qw| desc |   => "host-edit flow $name",
        ## by NAME at fire time : a source reload mid-flow reaches the new ##
        ## code                                                            ##
        qw| cb | => sub { <[host-edit.flow.step]>->($name) },
    }
);
return defined $timer ? TRUE : FALSE;

