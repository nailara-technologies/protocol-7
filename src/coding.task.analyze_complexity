# name = coding.task.analyze_complexity
# descr = analyze and calculate task complexity score
# purpose = task analysis : complexity scoring based on multiple factors

my ($task) = @ARG;

return {
    success => FALSE,
    error   => "Task must be a hashref"
    }
    unless ref($task) eq qw| HASH |;

my $desc       = $task->{request}->{description} // '';
my $complexity = 1;

# Length-based complexity
my $word_count = scalar( split( m|\s+|, $desc ) );
if ( $word_count > 100 ) {
    $complexity += 2;
} elsif ( $word_count > 50 ) {
    $complexity += 1;
}

# Keywords indicating complexity
my @complex_keywords = qw(
    consensus voting multiple models complex reasoning
    algorithm design architecture integration
    optimization performance debugging
);

foreach my $keyword (@complex_keywords) {
    if ( lc($desc) =~ m|\Q$keyword\E|i ) {
        $complexity += 2;
    }
}

# Keywords indicating medium complexity
my @medium_keywords = qw(
    analyze review explain summarize
    compare contrast identify
);

foreach my $keyword (@medium_keywords) {
    if ( lc($desc) =~ m|\Q$keyword\E|i ) {
        $complexity += 1;
    }
}

# Task type adjustments
my $type = $task->{type} // 'analysis';

if ( $type =~ m{code|generation|creation} ) {
    $complexity += 3;
} elsif ( $type =~ m{consensus|voting} ) {
    $complexity += 4;
} elsif ( $type =~ m{transcription|audio} ) {
    $complexity -= 2;
} elsif ( $type =~ m{image|creative} ) {
    $complexity += 2;
}

# Constraint count adds to complexity
my $constraints = $task->{request}->{constraints} // [];
$complexity += scalar(@$constraints);

# Cap complexity between 1-10
$complexity = 1  if $complexity < 1;
$complexity = 10 if $complexity > 10;

return {
    success    => TRUE,
    complexity => int($complexity),
    factors    => {
        word_count           => $word_count,
        has_complex_keywords => scalar(@complex_keywords) > 0,
        constraint_count     => scalar(@$constraints),
        task_type            => $type
    }
};

