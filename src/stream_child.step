## [:< ##

# name   = stream_child.step
# descr  = run the next stop step, arm the timer for the one after
# param  = handle

## actions : close [ end of input ], gone                ##
## [ give up : the child counts as gone ], a signal name ##
## [ to the child or its group ]                         ##

my $handle  = shift;
my $actions = $handle->{'steps'}[ $handle->{'step'}++ ] // return FALSE;

foreach my $action (@$actions) {
    if ( $action eq qw| close | ) {
        <[stream_child.close_in]>->($handle);
    } elsif ( $action eq qw| gone | ) {
        next if $handle->{'gone'};
        <[stream_child.note]>->( $handle, qw| gave_up | );
        <[stream_child.gone]>->( $handle, 'given up' );
    } else {
        <[stream_child.signal]>->( $handle, $action );
    }
}
<[stream_child.arm]>->($handle)
    if $handle->{'step'} < @{ $handle->{'steps'} };
return TRUE;

