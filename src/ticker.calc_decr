## [:< ##

# name = ticker.calc_decr

my $dt   = shift;
my $dt_2 = $dt - 4;
$dt_2 = 0 if $dt_2 > 0;
my $t_inc = $dt - 2;

my $decrease
    = ( <ticker.fade_opacity> + 0.1 ) * 0.22 * <[base.calc_gauss]>->($t_inc);

$decrease
    += ( ( <ticker.fade_opacity> + 0.1 ) * <[base.calc_gauss]>->($dt_2) ) / 4;

return sprintf( '%.5f', $decrease );

