## [:< ##

# name  = note.update
# descr = replace content in an existing note section

my ( $section, $content, $task_id ) = @ARG;

return { 'mode' => qw| false |, 'data' => 'section required' }
    unless defined $section && length $section;

return { 'mode' => qw| false |, 'data' => 'content required' }
    unless defined $content && length $content;

$task_id = <[note.util.safe_id]>->( $task_id // <system.task_id> );
my $workspace_dir
    = <[file.zenka_dir.data_path]> . "/notes/$task_id/workspace";

## ensure workspace exists ##
<[file.path.make_dir]>->($workspace_dir) unless -d $workspace_dir;

## sanitize section name ##
$section =~ s|[^a-zA-Z0-9._-]|_|g;
my $note_file = "$workspace_dir/$section.md";

## this call fully replaces the section [ by design, per this tool's own   ##
## description ] -- stash the prior content first so a bad replacement [   ##
## e.g. wrong/garbled content written over real notes ] is recoverable via ##
## note.trash.rescue instead of gone the instant this call returns         ##
<[note.trash.stash]>->( $task_id, $section ) if -f $note_file;

## replace entire section with timestamp header ##
my $timestamp = <[base.ntime]>;
my $entry     = "## $timestamp [ updated ] ##\n\n$content\n";

<[file.write]>->( $note_file, $entry );

## update meta ##
my $meta_file = <[file.zenka_dir.data_path]> . "/notes/$task_id/.meta";
if ( -f $meta_file ) {
    my $meta = eval { JSON::PP::decode_json( <[file.read]>->($meta_file) ) };
    if ( ref $meta eq qw| HASH | ) {
        $meta->{'last_update'} = <[base.ntime]>;
        <[file.write]>->( $meta_file, JSON::PP::encode_json($meta) );
    }
}

<[base.logs]>->(
    2, "note.update: section '%s' for %s [ %d bytes ]",
    $section, $task_id, length $entry
);

return {
    'mode' => qw| true |,
    'data' => { 'section' => $section, 'bytes' => length $entry }
};

