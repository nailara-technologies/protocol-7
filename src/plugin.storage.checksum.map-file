## [:< ##
# name  = plugin.storage.checksum.map-file
# descr = Map a file to its checksum address

my ($args) = @ARG;

my $path = $args->{path}
    or return { 'mode' => 'false', 'data' => 'path required' };
my $algorithm = $args->{algorithm} // 'bmw';

my $registry = <storage.mapping.checksum>;

# Validate algorithm
my $algo_info = $registry->{'algorithms'}{$algorithm};
return { 'mode' => 'false', 'data' => "Unknown algorithm: $algorithm" }
    unless $algo_info;

# Check cache first
if ( exists $registry->{'cache'}{$path} ) {
    my $cached = $registry->{'cache'}{$path};
    if ( -f $path ) {
        my $st = File::stat::stat($path);
        my ( $mtime, $size ) = ( $st->mtime, $st->size );
        ## a hit needs the same algorithm too, not only an unchanged file ##
        if (    $cached->{mtime} == $mtime
            and $cached->{size} == $size
            and ( $cached->{algorithm} // '' ) eq $algorithm ) {
            $registry->{'stats'}{'cached'}++;
            return {
                'mode' => 'true',
                'data' => {
                    'path'      => $path,
                    'checksum'  => $cached->{checksum},
                    'algorithm' => $cached->{algorithm},
                    'cached'    => 1,
                }
            };
        }
    }
}

# Compute checksum
return { 'mode' => 'false', 'data' => 'file not found' } unless -f $path;

my $checksum;

# Dispatch to correct BMW/AMOS checksum module
## file content via filesum, never the .B32 variants [ those hash their ##
## input string -> the path itself ] ; plain bmw = 384, osf-cache layer ##
if ( $algorithm eq 'bmw' or $algorithm eq 'bmw-384' ) {
    $checksum = <[chk-sum.bmw.filesum]>->( 384, $path );
} elsif ( $algorithm eq 'bmw-224' ) {
    $checksum = <[chk-sum.bmw.filesum]>->( 224, $path );
} elsif ( $algorithm eq 'bmw-512' ) {
    $checksum = <[chk-sum.bmw.filesum]>->( 512, $path );
} elsif ( $algorithm eq 'bmw-L13' ) {

    # For L13, we need to read file content as string
    open my $fh, '<:raw', $path
        or return { 'mode' => 'false', 'data' => 'cannot read file' };
    my $content = do { local $/; <$fh> };
    close $fh;
    $checksum = <[chk-sum.bmw.L13-str]>->($content);
} elsif ( $algorithm eq 'bmw-L13-b32' ) {
    open my $fh, '<:raw', $path
        or return { 'mode' => 'false', 'data' => 'cannot read file' };
    my $content = do { local $/; <$fh> };
    close $fh;
    $checksum = <[chk-sum.bmw.str-b32.L13]>->($content);
} elsif ( $algorithm eq 'amos' ) {
    ## amos hashes its input string -> read the file content first ##
    open my $fh, '<:raw', $path
        or return { 'mode' => 'false', 'data' => 'cannot read file' };
    my $content = do { local $/; <$fh> };
    close $fh;
    $checksum = <[chk-sum.amos]>->( \$content );
} else {
    return {
        'mode' => 'false',
        'data' => "Algorithm handler not implemented: $algorithm"
    };
}

return { 'mode' => 'false', 'data' => 'checksum computation failed' }
    unless defined $checksum;

my $st = File::stat::stat($path);
my ( $mtime, $size ) = ( $st->mtime, $st->size );

# Update cache
$registry->{'cache'}{$path} = {
    'checksum'  => $checksum,
    'algorithm' => $algorithm,
    'mtime'     => $mtime,
    'size'      => $size,
    'cached_at' => time(),
};

# Update reverse mapping
push @{ $registry->{'reverse'}{$checksum} }, $path
    unless grep { $ARG eq $path }
    @{ $registry->{'reverse'}{$checksum} // [] };

$registry->{'stats'}{'hashed'}++;

return {
    'mode' => 'true',
    'data' => {
        'path'      => $path,
        'checksum'  => $checksum,
        'algorithm' => $algorithm,
        'cached'    => 0,
    }
};

