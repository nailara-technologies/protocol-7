## [:< ##

# name  = power.cmd.set_states
# descr = simultaneously set power states [0|1|-]
# param = <SNUM> <S1> <S2> <S3> <S4>

<power.cfg.devices> //= {};
my ( $device_id, @state_param ) = split( m| +|, $call->{'args'} );

return { 'mode' => qw| false |, 'data' => 'numerical device id expected' }
    if !length($device_id)
    or $device_id !~ m|\d+|;

return {
    'mode' => qw| false |,
    'data' => "device '$device_id' does not exist"
    }
    if not exists <power.cfg.devices>->{$device_id};

return {
    'mode' => qw| false |,
    'data' => 'socket state parameters expected'
    }
    if not @state_param;

map {
    return {
        'mode' => qw| false |,
        'data' => "invalid state \"$ARG\" requested! ( "
            . "valid states are '0', '1' or '-' [skip] )"
        }
        if $ARG !~ m{^(0|1|-)$};
} @state_param;

my ( $dev, $driver ) = <[power.dev_obj]>->($device_id);

return {
    'mode' => qw| false |,
    'data' => <power.open_error>->{$device_id} // 'connection failed'
    }
    if not defined $dev;

my $outlets = $code{"power.plugin.$driver.outlets"}->($dev);

return {
    'mode' => qw| false |,
    'data' => 'socket state parameters expected'
    }
    if @state_param < $outlets;

@state_param = @state_param[ 0 .. $outlets - 1 ];

return {
    'mode' => qw| false |,
    'data' => "no changes [ all 'skip'ped! ]"
    }
    if not grep { $ARG ne '-' } @state_param;

## state parameters to driver states : 1 on, 0 off, undef skip ##
my @want = map { $ARG eq '-' ? undef : $ARG } @state_param;

my $new_states = $code{"power.plugin.$driver.set"}->( $dev, \@want );

return { 'mode' => qw| false |, 'data' => 'connection to device failed' }
    if ref $new_states ne qw| ARRAY |;

my @new_states = $new_states->@*;

<[protocol-7.command.send.local]>->(
    {   'command'   => "cube.power-x11.set_states",
        'call_args' => { 'args'    => join( ' ', $device_id, @new_states ) },
        'reply'     => { 'handler' => 'dev.null' }
    }
);

return { 'mode' => qw| TRUE |, 'data' => join( ' ', @new_states ) }

