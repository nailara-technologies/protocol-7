# name  = bench.key-32-iterations
# descr = benchmark AMOS7::13::key_32 to identify safe iteration limits
#         tests execution time with various entropy seed values
#         helps determine optimal balance between cryptographic depth and performance
#
# usage = perl -I./data/lib-path/pm -e 'use bench; bench::key_32_iterations->() if $INC{"bench"}'
#
# notes = key_32 with numeric seed: iterations = 113 + numeric_value
#         key_32 with SCALAR ref seed: iterations = smart value (113-226)
#         This module helps identify safe limits for numeric seeds

use strict;
use warnings;
use Time::HiRes qw(time);
use AMOS7::13;

my %THRESHOLDS = (
    'instant'  => 0.05,    ## < 50ms: instant response
    'fast'     => 0.2,     ## < 200ms: acceptable
    'moderate' => 0.5,     ## < 500ms: noticeable but tolerable
    'slow'     => 2.0,     ## > 2s: problematic in event loop
);

my %results;

print "\n========================================\n";
print "AMOS7::13::key_32 Iteration Benchmark\n";
print "========================================\n\n";

## Test 1: SCALAR ref usage (correct, smart iteration count)
print "[1/4] SCALAR ref parameter (smart iterations 113-226)\n";
print "      This is the CORRECT and RECOMMENDED usage pattern\n";
{
    my $seed       = "test_entropy_seed_data_for_benchmark";
    my @iterations = ( 100, 500, 1000, 5000, 10000 );

    foreach my $iter_seed (@iterations) {
        my $start   = time();
        my $key     = AMOS7::13::key_32( \$seed, \$iter_seed );
        my $elapsed = time() - $start;

        my $category
            = $elapsed < $THRESHOLDS{'instant'}  ? 'instant'
            : $elapsed < $THRESHOLDS{'fast'}     ? 'fast'
            : $elapsed < $THRESHOLDS{'moderate'} ? 'moderate'
            :                                      'slow';

        printf "  Seed: %6d → %.4fs (%s)\n", $iter_seed, $elapsed, $category;
        $results{'scalar_ref'}{$iter_seed} = $elapsed;
    }
}
print "\n";

## Test 2: Small numeric seeds (safe range, mimics session IDs)
print "[2/4] Small numeric seeds (113 + seed = total iterations)\n";
print "      Session ID range: 1M-4M would produce excessive iterations!\n";
{
    my $seed          = "test_entropy_seed_data_for_benchmark";
    my @numeric_seeds = ( 1, 10, 100, 1000, 10000 );

    foreach my $num_seed (@numeric_seeds) {
        my $total_iters = 113 + $num_seed;
        my $start       = time();
        my $key         = AMOS7::13::key_32( \$seed, $num_seed );
        my $elapsed     = time() - $start;

        my $category
            = $elapsed < $THRESHOLDS{'instant'}  ? 'instant'
            : $elapsed < $THRESHOLDS{'fast'}     ? 'fast'
            : $elapsed < $THRESHOLDS{'moderate'} ? 'moderate'
            :                                      'slow';

        printf "  +%-6d (total: %6d iters) → %.4fs (%s)\n", $num_seed,
            $total_iters, $elapsed, $category;
        $results{'numeric_small'}{$num_seed} = $elapsed;
    }
}
print "\n";

## Test 3: DANGEROUS numeric seeds (like the bug that was fixed)
print "[3/4] DANGEROUS numeric seeds (what we fixed!)\n";
print "      These would cause blocking in event loop:\n";
{
    my $seed = "test_entropy_seed_data_for_benchmark";
    my @bad_seeds
        = ( 100000, 500000, 1000000, 4072297 );  ## Last one is the actual bug

    foreach my $bad_seed (@bad_seeds) {
        my $total_iters = 113 + $bad_seed;

        if ( $bad_seed == 4072297 ) {
            print "  ⚠ [ACTUAL BUG VALUE] ";
        } else {
            print "  ⚠ [DANGEROUS] ";
        }

        print "Seed: $bad_seed (113 + $bad_seed = $total_iters iterations)\n";
        printf "    Would require ~%.1fx more iterations than safe range\n",
            $total_iters / 226;
    }
}
print "\n";

## Test 4: Recommendations
print "[4/4] Benchmark Summary & Recommendations\n";
print "========================================\n\n";

print "SAFE USAGE:\n";
print "  ✓ Use SCALAR ref: "
    . "AMOS7::13::key_32(\\\\$shared_secret, \\\\$session_id)\n";
print "    → Auto-calculated iterations: 113-226 (instant)\n";
print "    → No excessive computation\n";
print "    → This is what the fix enables\n\n";

print "UNSAFE USAGE (BLOCKED BY DEFAULT):\n";
print "  ✗ Numeric seed > 1000: iterations = 113 + seed\n";
print "    → Session IDs (millions) would cause blocking\n";
print "    → Example: 113 + 4,072,297 = 4,072,410 iterations\n";
print "    → This was the bug that caused event loop lockup\n\n";

print "RECOMMENDED LIMITS:\n";
print "  • Numeric seeds: 0-1000 max (total: 113-1113 iterations)\n";
print "  • SCALAR refs: encouraged (auto 113-226)\n";
print "  • Event loop timeout: 17 seconds\n";
print "  • Warning threshold: >500ms in event handler\n\n";

print "PROPOSED SAFEGUARD:\n";
print "  Add warning if numeric seed > 1000:\n";
print "    warn 'key_32: numeric seed exceeds "
    . "safe range (1000), consider SCALAR ref';\n";
print "    Can silence "
    . "with: \$AMOS7::13::suppress_iteration_warning = TRUE;\n\n";

print "========================================\n\n";

1;

