## [:< ##

# name   = coding.sign_queue.check_paths
# descr  = validate repo-relative file paths for a sign
# args   = repo root, array ref of paths
# return = error text or undef

my ( $root, $paths ) = @ARG;
return 'paths required' if ref $paths ne qw| ARRAY | or not @{$paths};
foreach my $path ( @{$paths} ) {
    return "not a repo-relative file : $path"
        if $path !~ m{\A[\w.+-][\w./+-]*\z}
        or $path =~ m{(?:\A|/)\.\.(?:/|\z)}
        or not -f "$root/$path";
}
return undef;

