## [:< ##

# name  = web.cmd.drain
# descr = drain active operations, terminate when idle
# note  = called via cube command during concurrent restart handover

<[base.log]>->('web draining: checking active operations');

## mark as draining
<web.draining> = TRUE;

## check remaining active operations
my $remaining = 0;
$remaining += scalar keys %{ <web.templates.active> // {} };
$remaining += scalar keys %{ <web.commands.pending> // {} };

<[base.logs]>->( 'web draining: %d operations remaining', $remaining );

if ( $remaining == 0 ) {
    ## no active operations - can terminate immediately
    <[base.log]>->('web: no active operations, initiating self-termination');
    <[base.exit]>->(0);
} else {
    ## set up operation check timer
    <web.drain_check_timer> = <[event.add_timer]>->(
        {   'after'    => 0.5,
            'interval' => 0.5,
            'handler'  => qw| web.handler.drain_check |,
            'data'     => {}
        }
    );
}

return { 'mode' => qw| true |, 'data' => 'draining initiated' };

