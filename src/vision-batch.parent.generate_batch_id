# name = vision-batch.parent.generate_batch_id
# descr = Generate unique batch ID for tracking

# Get module availability from init_code
my $modules_available = <vision-batch.modules_available>;

my $batch_id;

# Try using Data::UUID first (module loaded at startup)
if ( $modules_available->{'Data::UUID'} ) {
    eval {
        my $ug = Data::UUID->new();
        $batch_id = $ug->create_str();
    };
}

# If Data::UUID failed, try UUID::Tiny (module loaded at startup)
if ( !defined $batch_id && $modules_available->{'UUID::Tiny'} ) {
    eval { $batch_id = create_uuid_as_string( UUID_V4() ); };
}

# If UUID libraries unavailable, create a simple deterministic ID
if ( !defined $batch_id ) {
    my $timestamp = <[base.ntime.b32]>;
    my $random    = int( rand(999999) );
    $batch_id = sprintf( 'batch-%d-%06d', $timestamp, $random );
}

return { success => TRUE, batch_id => $batch_id };

