## [:< ##
# name  = plan-9.server.handle-io-remove
# descr = Handle 9P Tremove/Rremove

my ( $client, $tag, $data ) = @ARG;

my $fid = <[plan-9.protocol.codec.decode-uint32]>->( substr( $data, 0, 4 ) );

my $f = $client->{fids}{$fid};
return <[plan-9.protocol.error]>->( $tag, "invalid fid" ) unless $f;

unless ( $f->{type} eq 'realpath' ) {
    delete $client->{fids}{$fid};
    return <[plan-9.protocol.error]>->( $tag, "cannot remove this file" );
}

unless ( $f->{writable} ) {
    delete $client->{fids}{$fid};
    return <[plan-9.protocol.error]>->( $tag, "export is read-only" );
}

if ( $f->{realpath} eq $f->{root} ) {
    delete $client->{fids}{$fid};
    return <[plan-9.protocol.error]>->( $tag, "cannot remove export root" );
}

my $ok
    = -d $f->{realpath} ? rmdir( $f->{realpath} ) : unlink( $f->{realpath} );

unless ($ok) {
    delete $client->{fids}{$fid};
    return <[plan-9.protocol.error]>->( $tag, "cannot remove: $!" );
}

delete $client->{fids}{$fid};

return <[plan-9.protocol.codec.encode-message]>->(
    <plan-9.protocol.constants.Rremove>,
    $tag, ''
);

