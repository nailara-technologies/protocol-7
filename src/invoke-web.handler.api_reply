## [:< ##

# name  = invoke-web.handler.api_reply
# descr = clients.http on_done for invoke-web.api_async : decode the json
#         body and pass { ok, status, data, error, params } to the caller's
#         handler

my $reply   = shift              // {};
my $wrap    = $reply->{'params'} // {};
my $handler = $wrap->{'handler'} // return;

my $body = $reply->{'body'} // '';
## json bodies only : an error text stays the raw body ##
my $decoded = $body =~ m|^\s*[\[{]| ? <[format.json.decode]>->($body) : undef;

return if not exists $code{$handler};

$code{$handler}->(
    {   'ok'     => $reply->{'ok'} ? TRUE : FALSE,
        'status' => $reply->{'status'} // $reply->{'error'} // '?',
        'error'  => $reply->{'error'},
        'data'   => $decoded          // $body,
        'params' => $wrap->{'params'} // {},
    }
);

