# name  = web-browser.cmd.stop-capture-slideshow
# descr = cancel the capture-on-fade watcher armed by
#         web-browser.cmd.start-capture-slideshow

<web-browser.capture.watcher>->cancel
    if defined <web-browser.capture.watcher>
    and <web-browser.capture.watcher>->is_active;

my $count = <web-browser.capture.counter> // 0;

delete <web-browser.capture.watcher>;
delete <web-browser.capture.manifest_path>;

<[base.log]>->( 1, "capture-slideshow disarmed [ $count captured ]" );

return { 'mode' => qw| true |, 'data' => "disarmed, $count captured" }

