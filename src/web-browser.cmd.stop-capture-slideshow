## [:< ##

# name  = web-browser.cmd.stop-capture-slideshow
# descr = cancel paged capture watcher, force-clear page
# note  = watcher was armed by web-browser.cmd.start-capture-slideshow; also
#         force-clears the currently loaded page so its JS/WebGL execution
#         actually terminates, not just future advancement

<web-browser.capture.watcher>->cancel
    if defined <web-browser.capture.watcher>
    and <web-browser.capture.watcher>->is_active;

## disarm the per-page watchdog as well ##
<web-browser.timer.capture_page_timeout>->cancel
    if defined <web-browser.timer.capture_page_timeout>
    and <web-browser.timer.capture_page_timeout>->is_active;
delete <web-browser.timer.capture_page_timeout>;

## terminate whatever page is currently loaded ##
<[web-browser.util.force_clear_current_view]>;

my $count = <web-browser.capture.counter> // 0;

delete <web-browser.capture.watcher>;
delete <web-browser.capture.manifest_path>;
delete <web-browser.capture.paged.armed>;
delete <web-browser.capture.paged.positions>;
delete <web-browser.capture.paged.index>;
delete <web-browser.capture.paged.uri>;
delete <web-browser.capture.paged.pending_path>;

<[base.log]>->( 1, "capture-slideshow disarmed [ $count captured ]" );

return { 'mode' => qw| true |, 'data' => "disarmed, $count captured" }

