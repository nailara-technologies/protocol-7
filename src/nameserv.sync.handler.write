## [:< ##

# name  = nameserv.sync.handler.write
# descr = continue writing buffered sync protocol output

my $id = shift->w->data;

my $conns = <nameserv.sync.conns> // return;
my $conn  = $conns->{$id}         // return;

<[nameserv.sync.conn.flush]>->($conn);

return;

