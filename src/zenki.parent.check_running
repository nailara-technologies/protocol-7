# name = zenki.parent.check_running
# descr = check if a specific zenka is currently running

my $params = shift || {};

my $zenka_name = $params->{'zenka'};

unless ($zenka_name) {
    return { running => 0, error => 'zenka name required' };
}

## a running zenka does not keep 'Protocol-7 <name>' in its process title  ##
## -- bin/Protocol-7 rewrites $PROGRAM_NAME to '<node>.<zenka>' during     ##
## base.init [ '<node>.<zenka>[<subname>]' for multi-instance zenki ], and ##
## to 'Protocol-7.<zenka>' in stdin-config mode before that.  matching the ##
## pre-rename form only [ as this did ] never found anything at all        ##

my $node_name = <system.node.name> // '';

my @patterns;

push( @patterns, qr{^\Q$node_name.$zenka_name\E(?:\[[^\]]*\])?$} )
    if length $node_name;

push(
    @patterns,
    qr{^Protocol-7\.\Q$zenka_name\E(?:\[[^\]]*\])?$},    ## stdin-cfg mode ##
    qr{(?:^|/)Protocol-7\s+\Q$zenka_name\E(?:\s|$)}      ## bare invocation ##
);

my $ps_output = `ps -eo pid=,args= 2>/dev/null`;

foreach my $line ( split m|\n|, $ps_output ) {

    my ( $pid, $args ) = $line =~ m|^\s*(\d+)\s+(.+)$|;

    next if not defined $pid or $pid == $PID;    ## never match ourselves ##

    next if not grep { $args =~ $ARG } @patterns;

    ## a root owned zenka [ 'v7-zenki' ] answers 'permission denied' and ##
    ## not 'no such process' when probed from an unprivileged front-door ##
    ## invocation -- it is running either way, only ESRCH means gone     ##
    next if not kill( 0, $pid ) and not $!{'EPERM'};

    return {
        running => 1,
        pid     => $pid,
        cmdline => $args
    };
}

## not found ##
return {
    running => 0,
    zenka   => $zenka_name
};

0;

