## [:< ##

# name  = nameserv.cache.key
# descr = cache key for a query or reply packet

my $packet = shift // return undef;

my @questions = $packet->question;
return undef unless scalar @questions;

return
      lc( $questions[0]->qname ) . ' '
    . $questions[0]->qtype . ' '
    . $questions[0]->qclass;

