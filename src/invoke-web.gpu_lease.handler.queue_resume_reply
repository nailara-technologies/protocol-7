# name  = invoke-web.gpu_lease.handler.queue_resume_reply
# descr = log the render queue resume after a lease grant

my $reply = shift // {};
<[base.logs]>->(
    $reply->{'ok'} ? 1 : 0,
    ': render queue resume with gpu lease : %s',
    $reply->{'ok'} ? 'done' : $reply->{'status'}
);
return TRUE;

