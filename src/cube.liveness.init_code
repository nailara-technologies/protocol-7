## [:< ##

# name  = cube.liveness.init_code
# descr = arm the liveness probe timer

## no built-in values and no default activation : the probe runs only where  ##
## both values are configured                                                ##
## [ owner 2026-11-05, see  data/md/design/ROUTE-COLLAPSE-AND-LIVENESS.md ]. ##
## without them a running probe timer is stopped                             ##
## [ a reload switches it off ]                                              ##
my $interval = <cube.cfg.liveness.interval>;
my $misses   = <cube.cfg.liveness.misses>;

if (   not defined $interval
    or not defined $misses
    or $interval !~ m{^\d+(?:\.\d+)?$}
    or $misses   !~ m{^\d+$}
    or $interval <= 0
    or $misses < 1 ) {
    if ( defined <cube.liveness.timer>
        and <cube.liveness.timer>->can(qw| cancel |) ) {
        <cube.liveness.timer>->cancel;
    }
    delete <cube.liveness.timer>;
    for my $session_state ( values( ( <cube.liveness.state> // {} )->%* ) ) {
        $session_state->{'timeout'}->cancel
            if defined $session_state->{'timeout'}
            and $session_state->{'timeout'}->can(qw| cancel |);
    }
    delete <cube.liveness.state>;
    return TRUE;
}

if (   not defined <cube.liveness.timer>
    or not <cube.liveness.timer>->can(qw| is_active |)
    or not <cube.liveness.timer>->is_active ) {
    <cube.liveness.timer> = <[event.add_timer]>->(
        {   'after'    => $interval,
            'interval' => $interval,
            'desc'     => 'cube session liveness probe',
            'handler'  => qw| cube.liveness.probe_tick |
        }
    );
}

return TRUE;

