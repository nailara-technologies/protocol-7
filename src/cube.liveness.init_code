## [:< ##

# name  = cube.liveness.init_code
# descr = schedule probes at the smallest declared session interval

## the timer only schedules ticks ; each session keeps its own probe times ##
my $interval;
foreach my $session ( values $data{'session'}->%* ) {
    next if $session->{'mode'} ne qw| client |;
    next if not defined $session->{'liveness'};
    my $declared_interval = $session->{'liveness'}{'interval'};
    $interval = $declared_interval
        if not defined $interval or $declared_interval < $interval;
}

if ( defined <cube.liveness.timer>
    and <cube.liveness.timer>->can(qw| cancel |) ) {
    <cube.liveness.timer>->cancel;
}
delete <cube.liveness.timer>;

if ( not defined $interval ) {
    for my $session_state ( values( ( <cube.liveness.state> // {} )->%* ) ) {
        $session_state->{'timeout'}->cancel
            if defined $session_state->{'timeout'}
            and $session_state->{'timeout'}->can(qw| cancel |);
    }
    delete <cube.liveness.state>;
    return TRUE;
}

<cube.liveness.timer> = <[event.add_timer]>->(
    {   'after'    => $interval,
        'interval' => $interval,
        'desc'     => 'cube session liveness probe scheduler',
        'handler'  => qw| cube.liveness.probe_tick |
    }
);

return TRUE;

