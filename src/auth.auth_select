## [:< ##

# name  = auth.auth_select

my $id     = shift;
my $method = shift;

my $log_level = 2;    ## 'selected auth method' log message level ##

warn "[$id] expected auth _method_ parameter" if not defined $method;

my $client_sock_fd = $data{'session'}{$id}{'handle'};

my @available_auth_methods
    = <[base.reverse-sort]>->( split( "\n", <[auth.auth_list]>->($id) ) );

if ( <[base.list_matches]>->( \@available_auth_methods, $method . '$' ) ) {

    if ($method eq qw| zenka |
        and <[base.code.call_optional]>->(
            qw| plugin.auth.zenka.no-keys-defined |)
    ) {
        <[base.net.send_to_socket]>->(
            $client_sock_fd, "FALSE no zenka authentication expected >:[\n"
        );
        return FALSE;
    }

    $data{'session'}{$id}{'auth'}{'method'} = $method;

    ## a fresh select never inherits an earlier one's binding material ##
    map { delete $data{'session'}{$id}{'auth'}{$ARG} }
        qw| server_nonce server_pub server_key_name client_pub |;

    ## auth-keypair : announce the server key [ S ] and a fresh nonce.  the ##
    ## key name and raw key are stored together : link-complete signs with  ##
    ## exactly this key [ data/md/design/AUTH-LINK-BINDING ]                ##
    if ( $method eq 'auth-keypair' ) {
        ## unconditional once reached : any zenka accepting auth-keypair  ##
        ## connections must have crypt.C25519 loaded [ cube does; a zenka ##
        ## that reaches this without it is genuinely misconfigured ]      ##
        my $key_vars = <[crypt.C25519.key_vars]>;
        my $key_name
            = ref $key_vars eq qw| HASH | ? $key_vars->{'key_name'} : undef;
        my $server_pub;
        $server_pub = $keys{'C25519'}{$key_name}{'public'}
            if defined $key_name
            and ref $keys{'C25519'}{$key_name} eq qw| HASH |;

        my $server_nonce = eval { <[base.prng.bytes]>->(32) };

        if (    defined $server_pub
            and length($server_pub) == 32
            and defined $server_nonce
            and length($server_nonce) == 32 ) {

            my $auth = $data{'session'}{$id}{'auth'};
            $auth->{'server_key_name'} = $key_name;
            $auth->{'server_pub'}      = $server_pub;
            $auth->{'server_nonce'}    = $server_nonce;

            ## the reply is built from the stored bytes : announced == stored
            <[base.net.send_to_socket]>->(
                $client_sock_fd,
                sprintf( "TRUE %s %s\n",
                    Crypt::Misc::encode_b32r( $auth->{'server_pub'} ),
                    Crypt::Misc::encode_b32r( $auth->{'server_nonce'} ) )
            );
        } else {
            <[base.logs]>->(
                0, '[%d] auth-keypair : server key or nonce not available',
                $id
            );
            <[base.net.send_to_socket]>->(
                $client_sock_fd, "FALSE server key not available\n"
            );
            return FALSE;
        }
    } else {
        <[base.net.send_to_socket]>->( $client_sock_fd, "TRUE continue\n" );
    }
    <[base.logs]>->(
        $log_level, "[%d] selected auth method '%s'.,",
        $id,        $method
    );
    return TRUE;
} else {
    my $link_type
        = $data{'handle'}{$client_sock_fd}{'link'};

    <[base.net.send_to_socket]>->(
        $client_sock_fd,
        "FALSE not available \\ enabled, see 'list' command\n"
    ) if $data{'session'}{$id}{'counter'}{'auth'}{'select'}{'errors'} < 2;
    my $m_len = 23;
    substr( $method, $m_len - 3, length($method) - $m_len + 3, '..,' )
        if length($method) > $m_len;
    <[base.logs]>->( 1, '[%d] requested auth-method not supported.,', $id );
    <[base.logs]>->( 2, qq|:%9s: requested :."%s".:|, '', $method );
    <[base.logs]>->(
        2,  ':%9s: : available methods .:. %s-link',
        '', $link_type
    );
    map { <[base.logs]>->( 2, ":%9s: : :.. %s", '', $ARG ) }
        @available_auth_methods;
    return FALSE;
}

