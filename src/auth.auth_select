## [:< ##

# name  = auth.auth_select

my $id     = shift;
my $method = shift;

my $log_level = 2;    ## 'selected auth method' log message level ##

warn "[$id] expected auth _method_ parameter" if not defined $method;

my $client_sock_fd = $data{'session'}{$id}{'handle'};

my @available_auth_methods
    = <[base.reverse-sort]>->( split( "\n", <[auth.auth_list]>->($id) ) );

if ( <[base.list_matches]>->( \@available_auth_methods, $method . '$' ) ) {

    if ($method eq qw| zenka |
        and <[base.code.call_optional]>->(
            qw| plugin.auth.zenka.no-keys-defined |)
    ) {
        <[base.net.send_to_socket]>->(
            $client_sock_fd, "FALSE no zenka authentication expected >:[\n"
        );
        return FALSE;
    }

    $data{'session'}{$id}{'auth'}{'method'} = $method;

    ## a fresh select never inherits an earlier one's binding material ##
    map { delete $data{'session'}{$id}{'auth'}{$ARG} }
        qw| server_nonce server_pub server_key_name client_pub |;

    ## auth-keypair : announce the server key [ S ] and a fresh nonce.  the ##
    ## key name and raw key are stored together : link-complete signs with  ##
    ## exactly this key [ data/md/design/AUTH-LINK-BINDING ]                ##
    if ( $method eq 'auth-keypair' ) {
        ## unconditional once reached : any zenka accepting auth-keypair  ##
        ## connections must have crypt.C25519 loaded [ cube does; a zenka ##
        ## that reaches this without it is genuinely misconfigured ]      ##
        my $key_vars = <[crypt.C25519.key_vars]>;
        my $key_name
            = ref $key_vars eq qw| HASH | ? $key_vars->{'key_name'} : undef;
        my $server_pub;
        $server_pub = $keys{'C25519'}{$key_name}{'public'}
            if defined $key_name
            and ref $keys{'C25519'}{$key_name} eq qw| HASH |;

        ## the host-root delegation of S [ data/md/design/HOST-ROOT-        ##
        ## DELEGATION.md ] : read fresh on EVERY select [ renewals ], sent  ##
        ## as the REQUIRED 4th field. missing \ unparsable \ expired \ not  ##
        ## for this S -> auth-keypair refused, before any nonce is drawn or ##
        ## stored. the file holds the CHAIN [ TRUST-CHAIN-STEP2.md : one    ##
        ## statement per line, leaf first ; one line = step 1, unchanged ]  ##
        my ( $delegation, $dlg_refusal );
        if (   ref $code{'trust.verify'} ne qw| CODE |
            or ref $code{'trust.chain'} ne qw| CODE |
            or ref $code{'trust.statement'} ne qw| CODE |
            or ref $code{'trust.key_id'} ne qw| CODE | ) {
            $dlg_refusal = 'trust modules not loaded';
        } elsif ( not defined $server_pub or length($server_pub) != 32 ) {
            $dlg_refusal = 'no server key';
        } else {
            my $dlg_file = <[crypt.C25519.delegation_file]>->($key_name);
            my $dlg_content;
            if ( not defined $dlg_file ) {
                $dlg_refusal = 'no delegation file path';
            } elsif ( open( my $dlg_fh, '<:raw', $dlg_file ) ) {
                my $got = read( $dlg_fh, $dlg_content, 2060 );
                close($dlg_fh);
                $dlg_refusal = 'delegation file not valid'
                    if not defined $got
                    or $got > 2052;
            } else {
                $dlg_refusal = "delegation file missing [ $OS_ERROR ]";
            }
            my $chain;
            if ( not defined $dlg_refusal ) {
                my $why;
                ( $chain, $why )
                    = <[trust.chain]>->( qw| file |, $dlg_content );
                $dlg_refusal = sprintf 'delegation file not valid [ %s ]',
                    $why // '?'
                    if not defined $chain;
            }
            if ( not defined $dlg_refusal ) {

                ## the leaf decides [ under its own issuer, as in step 1 ] ##
                ## ; the chain above it is sent only while it verifies too ##
                ## -- an owner statement that expired between two daily    ##
                ## issue runs must not refuse every select : the leaf goes ##
                ## alone                                                   ##
                my $issuer_of = sub {
                    my $st = <[trust.statement]>->( qw| parse_wire |, shift );
                    return
                        ref $st eq qw| HASH |
                        ? <[trust.key_id]>->( $st->{'issuer_pub'} )
                        : undef;
                };
                my $check = sub {
                    my ( $list, $anchor ) = @ARG;
                    return ( undef, 'issuer not ' . 'valid' )
                        if not defined $anchor;
                    return <[trust.verify]>->(
                        {   qw| chain |   => $list,
                            qw| anchors | => [$anchor],
                            qw| subject | => $server_pub,
                            qw| now |     => time,
                        }
                    );
                };
                my $leaf = $chain->[-1];
                my ( $valid, $why )
                    = $check->( [$leaf], $issuer_of->($leaf) );
                if ( ref $valid ne qw| HASH | ) {
                    $dlg_refusal = sprintf 'delegation refused [ %s ]',
                        $why // 'not valid';
                } else {
                    my $send = [$leaf];
                    my $note = '';
                    if ( $chain->@* > 1 ) {
                        my ( $full, $full_why )
                            = $check->( $chain, $issuer_of->( $chain->[0] ) );
                        if ( ref $full eq qw| HASH | ) {
                            $send = $chain;
                        } else {
                            $note = $full_why // 'not valid';
                        }
                    }
                    ## one level 0 line per change, not per select ##
                    if ( ( <auth.dlg_chain_note> // '' ) ne $note ) {
                        <[base.logs]>->(
                            0,
                            '[%d] delegation chain above the leaf '
                                . 'not sent [ %s ] -- the leaf goes alone',
                            $id,
                            $note
                        ) if length $note;
                        <auth.dlg_chain_note> = $note;
                    }
                    $delegation  = <[trust.chain]>->( qw| join |, $send );
                    $dlg_refusal = 'delegation chain not joined'
                        if not defined $delegation;
                }
            }
        }

        my $server_nonce
            = defined $delegation
            ? eval { <[base.prng.bytes]>->(32) }
            : undef;

        if (    defined $server_pub
            and length($server_pub) == 32
            and defined $delegation
            and defined $server_nonce
            and length($server_nonce) == 32 ) {

            my $auth = $data{'session'}{$id}{'auth'};
            $auth->{'server_key_name'} = $key_name;
            $auth->{'server_pub'}      = $server_pub;
            $auth->{'server_nonce'}    = $server_nonce;

            ## the reply is built from the stored bytes : announced == stored
            <[base.net.send_to_socket]>->(
                $client_sock_fd,
                sprintf( "TRUE %s %s %s\n",
                    Crypt::Misc::encode_b32r( $auth->{'server_pub'} ),
                    Crypt::Misc::encode_b32r( $auth->{'server_nonce'} ),
                    $delegation )
            );
        } else {
            <[base.logs]>->(
                0,   '[%d] auth-keypair : %s',
                $id, $dlg_refusal // 'server key or nonce not available'
            );
            <[base.net.send_to_socket]>->(
                $client_sock_fd, "FALSE server key not available\n"
            );
            return FALSE;
        }
    } else {
        <[base.net.send_to_socket]>->( $client_sock_fd, "TRUE continue\n" );
    }
    <[base.logs]>->(
        $log_level, "[%d] selected auth method '%s'.,",
        $id,        $method
    );
    return TRUE;
} else {
    my $link_type
        = $data{'handle'}{$client_sock_fd}{'link'};

    <[base.net.send_to_socket]>->(
        $client_sock_fd,
        "FALSE not available \\ enabled, see 'list' command\n"
    ) if $data{'session'}{$id}{'counter'}{'auth'}{'select'}{'errors'} < 2;
    my $m_len = 23;
    substr( $method, $m_len - 3, length($method) - $m_len + 3, '..,' )
        if length($method) > $m_len;
    <[base.logs]>->( 1, '[%d] requested auth-method not supported.,', $id );
    <[base.logs]>->( 2, qq|:%9s: requested :."%s".:|, '', $method );
    <[base.logs]>->(
        2,  ':%9s: : available methods .:. %s-link',
        '', $link_type
    );
    map { <[base.logs]>->( 2, ":%9s: : :.. %s", '', $ARG ) }
        @available_auth_methods;
    return FALSE;
}

