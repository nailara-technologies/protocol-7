# name  = window.place.update_x11_state
# descr = write geometry into the per-instance state without moving the window

my ( $id, $geometry ) = @ARG;

return undef if not defined $id;
return undef if not defined $geometry;

my $inst = $data{window}{place}{instances}{$id};
return undef if not defined $inst;

$inst->{'geom'} = {
    'width'  => $geometry->{'width'},
    'height' => $geometry->{'height'},
    'x'      => $geometry->{'x'},
    'y'      => $geometry->{'y'},
    'right'  => $geometry->{'x'} + $geometry->{'width'},
    'bottom' => $geometry->{'y'} + $geometry->{'height'},
};

return TRUE;

