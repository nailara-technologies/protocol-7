# name  = nameserv.cmd.set-upstreams
# descr = replace the upstream addresses for one source

my ( $source, @addresses ) = split m|\s+|, $call->{'args'} // '';
$source //= '';

return { mode => 'false', data => 'usage: set-upstreams <source> <addr> ..' }
    if $source !~ m{^[a-z][a-z0-9_.-]*(?::[a-z0-9_.-]+)*$}
    or not @addresses;

my @canonical;
my %seen;
for my $address (@addresses) {
    my $validated = <[nameserv.upstream_address]>->($address);
    return { mode => 'false', data => "invalid ip address: $address" }
        if not defined $validated;
    push @canonical, $validated if not $seen{ lc $validated }++;
}

<nameserv.upstreams.by_source>        //= {};
<nameserv.upstreams.held_by_source>   //= {};
<nameserv.upstreams.domain_by_source> //= {};
<nameserv.upstreams.by_source>->{$source} = \@canonical;
delete <nameserv.upstreams.held_by_source>->{$source};
delete <nameserv.upstreams.domain_by_source>->{$source};
delete <nameserv.upstreams.domain_by_source>->{"reverse:$source"};
delete <nameserv.cache.upstream_list>;

return {
    mode => 'size',
    data => sprintf(
        "upstreams for %s:\n  %s", $source, join( ' ', @canonical )
    )
};

