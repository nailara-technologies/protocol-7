## [:< ##

# name  = power.dev_obj
# descr = open a device through its driver plugin [ cfg `driver`, default gembird ]
# return = ( $handle, $driver ) -- handle is undef when the open failed, reason in <power.open_error>

my $device_id = shift // '';
die "device '$device_id' does not exist"
    if not exists <power.cfg.devices>->{$device_id};

my $device_cfg = <power.cfg.devices>->{$device_id};
my $driver     = $device_cfg->{'driver'} // qw| gembird |;

<power.open_error> //= {};

my ( $handle, $reason );

if ( $driver !~ m|^[a-z0-9][a-z0-9-]*$|
    or not exists $code{"power.plugin.$driver.open"} ) {
    $reason = "unknown driver '$driver'";
} else {
    ( $handle, $reason ) = $code{"power.plugin.$driver.open"}->($device_cfg);
}

if ( defined $handle ) {
    delete <power.open_error>->{$device_id};
} else {
    $reason //= "driver '$driver' open failed";

    ## report once per device and reason [ no log flood from status polls ] ##
    <[base.log]>->( 0, "device $device_id : $reason" )
        if ( <power.open_error>->{$device_id} // '' ) ne $reason;
    <power.open_error>->{$device_id} = $reason;
}

return ( $handle, $driver );

