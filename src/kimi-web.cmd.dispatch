## [:< ##

# name  = kimi-web.cmd.dispatch
# descr = dispatch work to a specific kimi-web sub-agent
# param = agent_id - target agent identifier
# param = prompt   - work to dispatch
# param = timeout  - timeout in seconds (default 300)
# param = stream   - stream partial results (default false)

my $args = $call->{'args'} // {};

my $agent_id = $args->{'agent_id'} // '';
my $prompt   = $args->{'prompt'}   // '';
my $timeout  = $args->{'timeout'}  // 300;
my $stream   = $args->{'stream'}   // 0;

## validate ##
if ( not length $agent_id ) {
    return {
        'mode' => qw| false |,
        'data' => 'agent_id is required'
    };
}
if ( not length $prompt ) {
    return {
        'mode' => qw| false |,
        'data' => 'prompt is required'
    };
}

my $registry = <kimi-web.agent.registry> // {};
my $agent    = $registry->{$agent_id};

if ( not defined $agent ) {
    return {
        'mode' => qw| false |,
        'data' => "agent $agent_id not found"
    };
}

if ( $agent->{'status'} ne qw| ready | ) {
    return {
        'mode' => qw| false |,
        'data' => "agent $agent_id not ready [ status: $agent->{'status'} ]"
    };
}

## build HTTP request to agent ##
my $port = $agent->{'port'};
my $url  = "http://127.0.0.1:$port/v1/chat";

## prepare request body ##
my $request_body = <[base.json.encode]>->(
    {   'prompt'  => $prompt,
        'stream'  => $stream ? \1 : \0,
        'timeout' => $timeout,
    }
);

## dispatch via HTTP (async or sync based on stream) ##
if ($stream) {
    ## streaming: return immediately, results via notification ##
    my $reply_id = $call->{'reply_id'} // '';

    <[kimi-web.internal.stream_request]>->(
        {   'url'      => $url,
            'body'     => $request_body,
            'reply_id' => $reply_id,
            'agent_id' => $agent_id,
            'timeout'  => $timeout,
        }
    );

    return { 'mode' => qw| deferred | };
} else {
    ## synchronous: block for result ##
    my ( $ok, $response ) = <[kimi-web.internal.http_post_sync]>->(
        $url, $request_body, $timeout
    );

    if ( not $ok ) {
        return {
            'mode' => qw| false |,
            'data' => "request failed: $response"
        };
    }

    ## track token usage if available ##
    if ( ref $response eq qw| HASH | and $response->{'usage'} ) {
        $agent->{'tokens_used'} += $response->{'usage'}{'total'} // 0;
        <kimi-web.agent.registry> = $registry;
    }

    return {
        'mode' => qw| true |,
        'data' => $response->{'content'} // $response
    };
}

