## [:< ##

# name  = nameserv.consistency.handler.timeout
# descr = time out one async consistency query

## timer handler : the event carries the query id ##

my $id = shift->w->data;

my $state = <nameserv.consistency.state>;
return if not ref $state;
return if not exists $state->{'queries'}->{$id};

<[nameserv.consistency.complete]>->( $state, $id, [], TRUE );

return;

