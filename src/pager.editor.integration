## [:< ##

# name  = pager.editor.integration
# descr = Integrate pager with amos-term editor

my ($args) = @ARG;

my $buffer_id = $args->{'buffer_id'};
my $action    = $args->{'action'};
my $buf       = <pager.buffers>->{$buffer_id};

return undef unless $buf;

if ( $action eq 'open' ) {

    # Create amos-term buffer from pager
    my $editor_id = $args->{'editor_id'} // "pager_$buffer_id";
    my $read_only = $args->{'read_only'} // 1;

    # Initialize editor buffer (virtual - doesn't load all content)
    <[base.editor.init_buffer]>->(
        {   'buffer_id' => $editor_id,
            'virtual'   => 1,
            'pager_id'  => $buffer_id,
            'read_only' => $read_only,
        }
    );

    # Set up line getter callback
    <[base.editor.set_line_callback]>->(
        {   'buffer_id' => $editor_id,
            'callback'  => sub {
                my ($line_num) = @ARG;
                return <[pager.editor.get_line]>->(
                    {   'buffer_id' => $buffer_id,
                        'line'      => $line_num,
                    }
                );
            },
        }
    );

    # Set up total lines callback
    <[base.editor.set_total_lines]>->(
        {   'buffer_id' => $editor_id,
            'callback'  => sub {
                return $buf->{'source'}{'total'}
                    // $buf->{'stats'}{'items_seen'} * 2;
            },
        }
    );

    return $editor_id;
} elsif ( $action eq 'get_line' ) {
    my $line_num  = $args->{'line'};
    my $page_size = $buf->{'pages'}{'size'};
    my $page_num  = int( $line_num / $page_size );
    my $offset    = $line_num % $page_size;

    my $page = <[pager.buffer.page.get]>->( $buf, $page_num );
    return '' unless $page && @$page > $offset;

    my $item = $page->[$offset];
    return <[pager.util.editor.format_line]>->($item);
} elsif ( $action eq 'sync_cursor' ) {

    # Report cursor position to pager for adaptive sorting
    my $line = $args->{'line'};
    my $item = <[pager.util.editor.get_item_at_line]>->( $buf, $line );

    if ( $item && $buf->{'sort'}{'adaptive'} ) {
        <[pager.sort.chain]>->(
            {   'buffer_id' => $buffer_id,
                'action'    => 'record_access',
                'item'      => $item,
            }
        );
    }

    return 1;
} elsif ( $action eq 'get_item_at_cursor' ) {
    my $line = $args->{'line'};
    return <[pager.util.editor.get_item_at_line]>->( $buf, $line );
} elsif ( $action eq 'execute_on_item' ) {

    # Execute command on item at cursor
    my $line    = $args->{'line'};
    my $command = $args->{'command'};
    my $item    = <[pager.util.editor.get_item_at_line]>->( $buf, $line );

    return undef unless $item;

    # Substitute item properties in command
    $command =~ s/\{path\}/$item->{path}/g         if $item->{path};
    $command =~ s/\{name\}/$item->{name}/g         if $item->{name};
    $command =~ s/\{checksum\}/$item->{checksum}/g if $item->{checksum};

    return system($command);
}

return undef;

