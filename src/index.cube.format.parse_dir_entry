# name  = index.cube.format.parse_dir_entry
# descr = unpack a 16-byte directory entry into a hashref

my $bytes = shift // $ARG;

return undef unless defined $bytes and length($bytes) == 16;

my ( $data_offset, $data_size, $child_count, $flags, $chksum7 )
    = unpack( <index.cube.format.pack.dir_entry>, $bytes );

return {
    'data_offset' => $data_offset,
    'data_size'   => $data_size,
    'child_count' => $child_count,
    'flags'       => $flags,
    'chksum7'     => $chksum7,
};

