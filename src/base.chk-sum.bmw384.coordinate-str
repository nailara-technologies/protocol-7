# name  = base.chk-sum.bmw384.coordinate-str
# args  = $input
# descr = compact string representation of BMW384 field coordinate

my $input = shift;

if ( not defined $input ) {
    <[base.logs]>->( 1, 'input must be defined <{C1}>' );
    return undef;
}

<[base.perlmod.autoload]>->('AMOS7::CHKSUM::BMW384')
    if not <[base.perlmod.loaded]>->('AMOS7::CHKSUM::BMW384');

return AMOS7::CHKSUM::BMW384::bmw384_coordinate_str($input);

