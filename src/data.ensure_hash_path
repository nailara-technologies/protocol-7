# name  = data.ensure_hash_path
# param = <path>
# descr = create nested hash path if not exists (mkdir -p equivalent)
# return = hash ref at path or undef

my $path_str = shift // return undef;
my $root_ref = shift // \%data;

return $root_ref unless length($path_str);

my @segments = split( m|\.|, $path_str );
my $current  = $root_ref;

for my $segment (@segments) {
    $current->{$segment} //= {};
    return undef unless ref( $current->{$segment} ) eq 'HASH';
    $current = $current->{$segment};
}

return $current;

