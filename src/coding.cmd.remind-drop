## [:< ##

# name  = coding.cmd.remind-drop
# param = <id> [ remind-.. ]
# descr = remove a reminder before its time

my ($id) = ( $call->{'args'} // '' ) =~ m{\A\s*(\S+)\s*\z};
return { 'mode' => qw| false |, 'data' => 'reminder id : remind-<ntime>' }
    if not defined $id or $id !~ m{\Aremind-(?:\d+|[A-Z2-7]+\d{2})\z};
## a fired one not delivered yet is kept here, not in the events bucket ##
if ( defined <[coding.remind.store]>->( qw| get |, $id ) ) {
    <[coding.remind.store]>->( qw| del |, $id );
    <[coding.remind.arm]>;
    <[park.send]>->( qw| bucket-remove |, $id );
    return {
        'mode' => qw| true |,
        'data' => "drop $id : undelivered reminder removed"
    };
}
my $reply_id = $call->{'reply_id'} // '';
<[park.send]>->(
    qw| bucket-remove |,
    $id,
    qw| coding.handler.remind_reply |,
    { 'reply_id' => $reply_id, 'label' => "drop $id" }
    )
    or return {
    'mode' => qw| false |,
    'data' => 'events zenka not reachable'
    };
return { 'mode' => qw| deferred | } if $reply_id =~ m{\A\d+\z};
return { 'mode' => qw| true |, 'data' => "drop of $id requested" };

