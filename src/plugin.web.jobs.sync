## [:< ##

# name  = plugin.web.jobs.sync
# descr = jobs sync endpoint : handles batch jobsite push or single browser update

my $call = shift           // {};
my $body = $call->{'args'} // '';

## shm transfer [ large authenticated jobsite push ] : body was streamed to ##
## disk + validated by httpd.handler.shm_write -- read via base.shm.read    ##
## instead of the inline call_args body. backwards-compatible : requests    ##
## without shm_path [ browser updates ] use the inline body as before       ##
if ( defined $call->{'shm_path'} ) {
    my $shm_data = <[base.shm.read]>->(
        {   'path' => $call->{'shm_path'},
            'key'  => $call->{'shm_key'},
        }
    );
    if ( not defined $shm_data ) {
        <[base.logs]>->(
            1, '[web.jobs.sync] shm read failed : %s',
            $call->{'shm_path'}
        );
        return {
            'mode'         => qw| strm |,
            'data'         => '{"ok":false,"error":"shm read failed"}',
            'content_type' => 'application/json',
        };
    }
    <[base.logs]>->(
        2,
        '[web.jobs.sync] shm payload : %d bytes [ %s ]',
        length( $shm_data->$* ),
        $call->{'shm_path'}
    );
    $body = $shm_data->$*;
}

my $payload = eval { JSON::XS::decode_json($body) };
if ( $EVAL_ERROR or ref $payload ne qw| HASH | ) {
    return {
        'mode'         => qw| strm |,
        'data'         => '{"ok":false,"error":"invalid json"}',
        'content_type' => 'application/json',
    };
}

## last_modified deliberately excluded : it must reflect when the record    ##
## actually lands in THIS cache [ cache.write stamps a fresh local time ],  ##
## not jobsite's own write-time clock -- copying jobsite's timestamp lets a ##
## browser's delta watermark [ taken from a poll's "now" ] step past a push ##
## that is still in flight, permanently hiding it from future deltas        ##
my @pipeline_fields = qw| title company url score score_reason score_summary
    fetched_at status stage description blocked_epoch checksum_hit
    assertions city industry country postal_code repair_attempted repair_failed
    desc_check_failed desc_check_reason |;
## exported_stage \ exported_at deliberately NOT browser fields : they are ##
## a newest-wins record pair handled further below                         ##
## [ mark time = the exported_at batch epoch itself ]                      ##
my @browser_fields = qw| stage notes date_applied stage_changed_at |;

my $since    = '';
my @job_list = ();
my $is_batch = FALSE;

if ( ref $payload->{'jobs'} eq qw| ARRAY | ) {
    ## batch push from jobsite ##
    $is_batch = TRUE;
    $since    = $payload->{'since'} // '';
    @job_list = @{ $payload->{'jobs'} };
} else {
    ## single update from browser ##
    @job_list = ($payload);
}

## explicit batch role : a batch flagged 'marks' may ONLY touch the        ##
## exported_stage \ exported_at record pair + prefs -- whatever else it    ##
## carries is ignored, logged once per batch [ 2026-10-24 incident : a     ##
## stale jobsite pushed full job state + removal signals into a web it did ##
## not own, clobbering stages and dropping cache entries ]                 ##
my $is_marks_batch = FALSE;
if ($is_batch
    and ( ( $payload->{'role'} // '' ) eq qw| marks |
        or <web.jobs.sync_foreign> )
    ) {    ## foreign peer : marks only, whatever the batch claims ##
    $is_marks_batch = TRUE;
    my $extra_fields = grep {
        ref $ARG eq qw| HASH |
            && grep {
                   $_ ne 'id'
                && $_ ne 'exported_stage'
                && $_ ne 'exported_at'
            }
            keys %{$ARG}
    } @job_list;
    <[base.logs]>->(
        1, '[web.jobs.sync] marks batch : ignoring %d non-mark field%s',
        $extra_fields, <[base.cnt_s]>->($extra_fields)
    ) if $extra_fields;
}

## jobsite pushes its client prefs so every connected host converges on the ##
## newest value ; only last_export_at for now [ QLK ] -- the rest of the    ##
## prefs fan-out belongs to 3MK. max-merge into the web-side relay copy,    ##
## exactly the jobsite.cmd.set-prefs numeric-newest rule                    ##
if ($is_batch) {
    my $inc_prefs = $payload->{'prefs'};
    if ( ref $inc_prefs eq qw| HASH |
        and $inc_prefs->{'last_export_at'} =~ m{^\d+(?:\.\d+)?$} ) {
        my $prefs  = <[plugin.web.jobs.prefs.read]>;
        my $inc_at = $inc_prefs->{'last_export_at'} + 0;
        my $cur_at = $prefs->{'last_export_at'} // 0;
        if ( $inc_at > $cur_at ) {
            $prefs->{'last_export_at'} = $inc_at;
            <[plugin.web.jobs.prefs.write]>->($prefs);
        }
    }
}

my $mem         = <[plugin.web.jobs.cache.read_all]>;
my $ok          = TRUE;
my $changed_any = FALSE;
my $cache_dir   = <[plugin.web.jobs.cache.path]>;
my @conflicts;

## the resulting watermark for a single browser push, handed back so the  ##
## caller can adopt it locally -- otherwise a same-browser follow-up push ##
## [ e.g. hitting undo right after a stage move ] still carries the STALE ##
## pre-push base_last_modified and false-conflicts against its own write  ##
my $single_last_modified;

## collect pending reverse-delete IDs so a batch push does not resurrect ##
## them also collect pending reverse-stage-change IDs : a browser stage  ##
## push not yet round-tripped back into jobsite's own copy must not get  ##
## clobbered by jobsite's batch, which was built from its own            ##
## [ still older ] on-disk view                                          ##
my %pending_delete;
my %pending_stage_change;
if ($is_batch) {
    my $rev = <plugin.web.jobs.reverse> // [];
    for my $r ( @{$rev} ) {
        next if ref $r ne 'HASH';
        my $rev_id = ( $r->{'id'} // '' );
        next if not length $rev_id;
        $pending_delete{$rev_id} = 1
            if ( $r->{'action'} // '' ) eq 'delete';
        $pending_stage_change{$rev_id} = 1 if exists $r->{'stage'};
    }
}

for my $job_data (@job_list) {
    my $job_id = ( $job_data->{'id'} // '' );
    next if not length $job_id;
    my $enc_id      = $job_id;
    my $job_changed = $is_batch ? TRUE : FALSE;

    ## marks batch : never plant a record this web does not already hold :  ##
    ## a marks url owns no job state here, it may only update marks on jobs ##
    ## that exist [ skips the pending-delete and terminal-state removal     ##
    ## paths below as well, via the shared guards ]                         ##
    next if $is_marks_batch and ref $mem->{$job_id} ne qw| HASH |;

    ## set when the export-mark merge below actually lands, so a marks ##
    ## batch only rewrites the record it really changed                ##
    my $mark_merged = FALSE;

    ## load cached record from memory or start fresh ##
    my $cached
        = ref $mem->{$job_id} eq qw| HASH | ? { %{ $mem->{$job_id} } } : {};

    ## skip jobs the browser already asked to delete but jobsite has not ##
    ## yet processed; remove any resurrected on-disk copy as well        ##
    if ( $is_batch and not $is_marks_batch and $pending_delete{$job_id} ) {
        my $old_status = <plugin.web.jobs.index>->{$job_id} // '';
        my $old_path   = '';
        if ( $old_status =~ m{^(blocked|deleted):(.+)$} ) {
            $old_path = "$cache_dir/$1/$2/$enc_id.yaml";
        } elsif ( length $old_status ) {
            $old_path = "$cache_dir/$old_status/$enc_id.yaml";
        }
        unlink $old_path if length $old_path and -f $old_path;
        delete <plugin.web.jobs.cache>->{$job_id}
            if ref <plugin.web.jobs.cache> eq 'HASH';
        delete <plugin.web.jobs.index>->{$job_id}
            if ref <plugin.web.jobs.index> eq 'HASH';
        <[plugin.web.jobs.removed_log.append]>->($enc_id);
        $changed_any = TRUE;
        next;
    }

    ## jobsite batch push signalling a transition into a terminal state :  ##
    ## minimal payload [ id + status only ], prune the cache entry instead ##
    ## of caching a stale record that would otherwise never get corrected  ##
    if (    $is_batch
        and not $is_marks_batch
        and ( $job_data->{'status'} // '' ) =~ m{^(blocked|deleted|trash)$} )
    {
        my $old_status = <plugin.web.jobs.index>->{$job_id} // '';
        my $old_path   = '';
        if ( $old_status =~ m{^(blocked|deleted):(.+)$} ) {
            $old_path = "$cache_dir/$1/$2/$enc_id.yaml";
        } elsif ( length $old_status ) {
            $old_path = "$cache_dir/$old_status/$enc_id.yaml";
        }
        unlink $old_path if length $old_path and -f $old_path;
        delete <plugin.web.jobs.cache>->{$job_id}
            if ref <plugin.web.jobs.cache> eq 'HASH';
        delete <plugin.web.jobs.index>->{$job_id}
            if ref <plugin.web.jobs.index> eq 'HASH';
        <[plugin.web.jobs.removed_log.append]>->($enc_id);
        $changed_any = TRUE;
        next;
    }

    if ($is_batch) {
        ## staleness guard : jobsite builds its outbound batch from its OWN ##
        ## on-disk view, which can still predate a browser-initiated stage  ##
        ## change already applied straight to this cache -- only skip the   ##
        ## clobber for a job that actually HAS an unconfirmed reverse-queue ##
        ## entry still pending                                              ##
        ## [ not yet round-tripped into jobsite's own copy ] ;              ##
        ## self-corrects once jobsite drains the reverse queue.  [          ##
        ## wall-clock last_modified comparison doesn't work here : jobsite  ##
        ## pushes their own writes re-stamp the cache's last_modified to    ##
        ## now too, so it drifts ahead of jobsite's frozen data-change time ##
        ## on every cycle and would treat every job as permanently stale ]  ##
        my $jobsite_stale = $pending_stage_change{$job_id} ? TRUE : FALSE;

        if ( not $is_marks_batch ) {
            ## jobsite push : update pipeline fields, keep browser fields ##
            for my $f (@pipeline_fields) {
                next
                    if $jobsite_stale and ( $f eq 'stage' or $f eq 'status' );
                $cached->{$f} = $job_data->{$f} if exists $job_data->{$f};
            }

            ## jobsite only guarantees 'status'; derive UI 'stage' from ##
            ## status (preserve browser/user-owned stages: applied,     ##
            ## rejected, etc.)                                          ##
            my $status          = $cached->{'status'} // '';
            my %status_to_stage = (
                'assessed' => 'review',     ## legacy assessed → review tab ##
                'apply'    => 'to_apply',
            );
            my %user_owned_stage
                = map { $ARG => 1 }
                qw| to_apply applied interviewed responded rejected skipped archived delete |;
            my $derived = $status_to_stage{$status} // $status;
            if ( not $user_owned_stage{ $cached->{'stage'} // '' } ) {
                $cached->{'stage'} = $derived;
            }
        }

        ## force cache.write below to stamp a fresh local time : jobsite  ##
        ## only forwards jobs it considers changed, so every batch entry  ##
        ## here is a real update -- carrying over a stale cached value    ##
        ## would re-trigger the same watermark race last_modified was     ##
        ## dropped from @pipeline_fields to avoid ; the same applies to a ##
        ## marks-batch mark merge so browser deltas pick the mark up      ##
        delete $cached->{'last_modified'};

        ## export marks ride the batch as ordinary job keys once a jobsite  ##
        ## has learned them [ reverse entry or local mark-exported ] :      ##
        ## merge newest-wins on exported_at -- a record without a time only ##
        ## lands where nothing is marked yet [ legacy migration push ] ;    ##
        ## applied marks queue a reverse entry so THIS host's jobsite       ##
        ## learns marks that arrived over the batch path                    ##
        if ( exists $job_data->{'exported_stage'} ) {
            my $inc_at = $job_data->{'exported_at'};
            my $inc_time
                = ( defined $inc_at and $inc_at =~ m{^\d+$} )
                ? $inc_at + 0
                : 0;
            my $cur_at = $cached->{'exported_at'};
            my $cur_time
                = ( defined $cur_at and $cur_at =~ m{^\d+$} )
                ? $cur_at + 0
                : 0;
            if ( $inc_time > $cur_time
                or ( not length( $cur_at // '' ) and not $inc_time ) ) {
                $cached->{'exported_stage'} = $job_data->{'exported_stage'};
                $cached->{'exported_at'}    = $inc_time;
                $mark_merged                = TRUE;
                <[plugin.web.jobs.reverse.queue]>->(
                    {   'id'             => $job_id,
                        'exported_stage' => $job_data->{'exported_stage'},
                        'exported_at'    => $inc_time,
                    }
                );
            }
        }
    } else {
        ## browser update : browser-owned fields only, queue reverse        ##
        ## stale-write guard : a stage push is only applied if the          ##
        ## browser's last known last_modified still matches the cache —     ##
        ## otherwise the record moved                                       ##
        ## [ pipeline advance or another browser ] since this browser last  ##
        ## saw it, and blindly applying would silently revert a newer state ##
        my $stage_conflict;
        if ( exists $job_data->{'stage'} ) {
            my $base_lm = $job_data->{'base_last_modified'} // '';
            my $cur_lm  = $cached->{'last_modified'}        // '';
            ## a record touched without a stage move                      ##
            ## [ liveness stamp, note, reassess ] is no conflict when the ##
            ## browser's base_stage still matches : only a stage that     ##
            ## really moved on is one                                     ##
            my $base_stage = $job_data->{'base_stage'};
            if (    length $base_lm
                and $cur_lm ne $base_lm
                and ( not defined $base_stage
                    or $base_stage ne ( $cached->{'stage'} // '' ) )
            ) {
                $stage_conflict = {
                    'id'             => $enc_id,
                    'field'          => 'stage',
                    'current_stage'  => $cached->{'stage'}  // '',
                    'current_status' => $cached->{'status'} // '',
                };
                push @conflicts, $stage_conflict;
                <[base.logs]>->(
                    1,
                    '[web.jobs.sync] stage conflict %s : browser '
                        . 'base=%s current=%s, rejecting stage push',
                    $job_id,
                    $base_lm,
                    $cur_lm
                );
            }
        }

        ## export marks : newest-wins record pair, the mark time IS         ##
        ## exported_at [ the shared batch epoch of the export run ] ; an    ##
        ## unmark arrives as a null pair and is stamped with the reception  ##
        ## epoch -- an older push [ stale browser, slower host ] must never ##
        ## clobber a newer local mark                                       ##
        my %changed;
        if ( exists $job_data->{'exported_stage'} ) {
            my $mark_stage = $job_data->{'exported_stage'};
            my $mark_at    = $job_data->{'exported_at'};
            my $mark_time
                = ( defined $mark_at and $mark_at =~ m{^\d+$} )
                ? $mark_at + 0
                : time;
            my $cur_at = $cached->{'exported_at'};
            my $cur_time
                = ( defined $cur_at and $cur_at =~ m{^\d+$} )
                ? $cur_at + 0
                : 0;
            if ( $mark_time > $cur_time ) {
                $cached->{'exported_stage'} = $mark_stage;
                $cached->{'exported_at'}    = $mark_time;
                $changed{'exported_stage'}  = $mark_stage;
                $changed{'exported_at'}     = $mark_time;
            } else {
                <[base.logs]>->(
                    1,
                    '[web.jobs.sync] export mark '
                        . 'rejected %s : incoming=%d <= local=%d',
                    $job_id,
                    $mark_time,
                    $cur_time
                );
            }
        }

        for my $f (@browser_fields) {
            next if $f eq 'stage' and $stage_conflict;
            if ( exists $job_data->{$f} ) {
                $cached->{$f} = $job_data->{$f};
                $changed{$f} = $job_data->{$f};
            }
        }
        if (%changed) {
            ## bump last_modified so delta queries on other browsers pick ##
            ## up this change                                             ##
            $cached->{'last_modified'} = <[base.ntime.b32]>;
            $job_changed = TRUE;
            <[plugin.web.jobs.reverse.queue]>
                ->( { 'id' => $job_id, %changed } );
        }

        ## action entries (e.g. reassess, delete) bypass browser_fields and ##
        ## queue directly                                                   ##
        if ( exists $job_data->{'action'}
            and length( $job_data->{'action'} ) ) {
            $job_changed = TRUE;
            <[plugin.web.jobs.reverse.queue]>->(
                {   'id'     => $job_id,
                    'action' => $job_data->{'action'}
                }
            );

            ## delete: remove from web cache immediately so UI reflects it ##
            if ( $job_data->{'action'} eq 'delete' ) {
                my $old_status = <plugin.web.jobs.index>->{$job_id} // '';
                my $old_path   = '';
                if ( $old_status =~ m{^(blocked|deleted):(.+)$} ) {
                    $old_path = "$cache_dir/$1/$2/$enc_id.yaml";
                } elsif ( length $old_status ) {
                    $old_path = "$cache_dir/$old_status/$enc_id.yaml";
                }
                unlink $old_path if length $old_path and -f $old_path;
                delete <plugin.web.jobs.cache>->{$job_id}
                    if ref <plugin.web.jobs.cache> eq qw| HASH |;
                delete <plugin.web.jobs.index>->{$job_id}
                    if ref <plugin.web.jobs.index> eq qw| HASH |;
                <[plugin.web.jobs.removed_log.append]>->($enc_id);
                $changed_any = TRUE;
            }
        }
    }

    ## delete already removed the on-disk record; do not recreate it ; a ##
    ## marks batch only rewrites a record whose mark actually merged     ##
    if (( not $is_marks_batch or $mark_merged )
        and not( exists $job_data->{'action'}
            and $job_data->{'action'} eq 'delete' )
    ) {
        my $wrote = <[plugin.web.jobs.cache.write]>->( $job_id, $cached );
        $ok                   = FALSE if not $wrote;
        $changed_any          = TRUE  if $wrote and $job_changed;
        $single_last_modified = $cached->{'last_modified'} if not $is_batch;
    }
}

<[plugin.web.jobs.events.notify]> if $changed_any;

## flush reverse queue only for jobsite batch pulls, not browser POSTs ##
## browser POSTs must not drain the queue or action entries are lost   ##
my @reverse;
if ($is_batch) {
    my $all_reverse = <[plugin.web.jobs.reverse.flush]>;
    my $since_num
        = length($since)
        ? <[base.ntime_BASE32_to_numerical]>->($since)
        : undef;
    @reverse = defined $since_num
        ? grep {
        my $n = <[base.ntime_BASE32_to_numerical]>->( $_->{'ntime'} // '' );
        defined $n && $n > $since_num
        } @{$all_reverse}
        : @{$all_reverse};
}

my $current_ntime = <[base.ntime.b32]>;

## hand the merged prefs back on the batch path so the pushing jobsite      ##
## [ and through it every other connected host ] adopts a newer export time ##
## it has not seen yet                                                      ##
my %prefs_out;
if ($is_batch) {
    my $web_prefs = <[plugin.web.jobs.prefs.read]>;
    my $export_at = $web_prefs->{'last_export_at'};
    $prefs_out{'last_export_at'} = $export_at + 0
        if defined $export_at and $export_at =~ m{^\d+(?:\.\d+)?$};
}

my $rb = eval {
    JSON::XS::encode_json(
        {   'ok'        => $ok ? JSON::XS::true() : JSON::XS::false(),
            'reverse'   => \@reverse,
            'ntime'     => $current_ntime,
            'conflicts' => \@conflicts,
            ( %prefs_out ? ( 'prefs' => \%prefs_out ) : () ),
            (   defined $single_last_modified
                ? ( 'last_modified' => $single_last_modified )
                : ()
            ),
        }
    );
} // '{"ok":false,"error":"encode failed"}';

<[base.logs]>->(
    2, '[web.jobs.sync] returning %d bytes [ mode=strm ]',
    bytes::length($rb)
);

return {
    'mode'         => qw| strm |,
    'data'         => $rb,
    'content_type' => qw| application/json |,
};

