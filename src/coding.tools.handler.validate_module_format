## [:< ##

# name  = coding.tools.handler.validate_module_format
# descr = check a P7 module file against format rules

my $args   = shift             // {};
my $module = $args->{'module'} // return 'module name required';

my $root     = <system.root_path>;
my $abs_path = "$root/src/$module";
return "error: module not found [ $module ]" unless -f $abs_path;

my $content_ref = <[file.slurp]>->($abs_path);
return 'error: cannot read module' unless defined $content_ref;
my $content = $content_ref->$*;
my @lines   = split m|\n|, $content;

my @issues;

## check header format ##
if ( not @lines or $lines[0] ne '## [:< ##' ) {
    push @issues, 'header: must be "## [:< ##" on line 1';
}

## check for blank line after header ##
if ( @lines > 1 and length $lines[1] ) {
    push @issues, 'header: line 2 should be blank after ## [:< ##';
}

## check name and descr comments ##
my $has_name  = 0;
my $has_descr = 0;
for my $i ( 0 .. ( @lines > 10 ? 9 : $#lines ) ) {
    $has_name  = 1 if $lines[$i] =~ m|^# name\s+=|;
    $has_descr = 1 if $lines[$i] =~ m|^# descr\s+=|;
}
push @issues, 'metadata: missing # name line'  unless $has_name;
push @issues, 'metadata: missing # descr line' unless $has_descr;

## check for forbidden patterns ##
if ( $content =~ m|^use strict;|m ) {
    push @issues, 'forbidden: use strict [ loader handles this ]';
}
if ( $content =~ m|^use warnings;|m ) {
    push @issues, 'forbidden: use warnings [ loader handles this ]';
}
if ( $content =~ m|^return sub\s*\{|m ) {
    push @issues,
        'forbidden: return sub { } wrapper [ module body IS the sub ]';
}

## check for inline sub declarations [ extraction candidates ] ##
my @subs;
for my $i ( 0 .. $#lines ) {
    if ( $lines[$i] =~ m|^sub (\w+)| ) {
        push @subs, sprintf '%s [ line %d ]', $1, $i + 1;
    }
}
if (@subs) {
    push @issues, sprintf 'inline subs found [ %d ]: %s',
        scalar @subs, join( ', ', @subs );
}

## result ##
if (@issues) {
    return sprintf "FAIL [ %d issues ]\n%s",
        scalar @issues, join( "\n", map {"- $ARG"} @issues );
}

return sprintf "PASS [ %s ]", $module;

