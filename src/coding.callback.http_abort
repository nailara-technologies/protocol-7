## [:< ##

# name  = coding.callback.http_abort
# descr = handle an abort triggered by a matching abort-pattern during streaming

my ( $task_id, $http_state, $req_seq ) = @ARG;

return unless defined $task_id;

## resolve async state and ignore stale aborts from a replaced connection ##
my $state = <[coding.async.state_manager]>->( qw| get |, $task_id );
return unless defined $state;

my $current_seq = $state->{'request_seq'} // 0;
if ( defined $req_seq && $req_seq != $current_seq ) {
    <[base.logs]>->(
        2, "http_abort: stale abort for %s [ seq %d != %d ], ignoring",
        $task_id, $req_seq, $current_seq
    );
    return;
}

my $match = ( $http_state // {} )->{'abort_match'} // {};

<[base.logs]>->(
    0, "http_abort: task %s aborted by pattern %s matched [%s]",
    $task_id,
    $match->{'pattern_id'} // '',
    $match->{'matched'}    // ''
);

## a whitespace run [ endless blank lines ] is a sampling failure, not a    ##
## wrong approach : retry the round once with a new seed before failing the ##
## task [ fablevibes 2026-10-10 : 3/3 aborts at round 2 ]. a phrase loop    ##
## still fails at once. the connection is torn down by the caller           ##
## [ http_io_parse_line ] right after this returns                          ##
my $round = $state->{'round'} // 0;
if (    ( $match->{'pattern_id'} // '' ) eq qw| degenerate_repetition |
    and ( $match->{'matched'}                // '' ) =~ m|^\s+$|
    and ( $state->{'whitespace_retry_round'} // -1 ) != $round
    and <[base.cfg_bool]>->( <coding.cfg.whitespace_abort_retry> // 1 ) ) {
    $state->{'whitespace_retry_round'} = $round;
    $state->{'retry_seed'}             = int rand 2**31;
    <[coding.abort.count]>->( qw| retry |, qw| whitespace |, '' );
    <[base.logs]>->(
        1,
        'http_abort: %s : whitespace run at round '
            . '%d -- retrying the round once [ seed %d ]',
        $task_id,
        $round,
        $state->{'retry_seed'}
    );
    my $restarted = <[coding.async.round_soft_restart]>->(
        $task_id, undef,
        ( $http_state // {} )->{'callbacks'}{'lock_token'} // qw| force |
    );
    return if $restarted;
}

## fail the task so it does not hang waiting for a clean close ##
<[coding.async.complete]>->(
    $task_id,
    {   success     => FALSE,
        error       => 'abort: pattern matched',
        abort_match => $match,
    }
);

return;

