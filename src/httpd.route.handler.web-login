## [:< ##

# name  = httpd.route.handler.web-login
# descr = POST /auth/login through the admission queue
# note  = POST /auth/login : refuse plaintext first [ stays first ], then
#         hold the request and ask the web zenka's admission queue
#         [ web.auth-login ] when it may be checked ; the real socket
#         facts [ peer address, tls ] are passed explicitly -- never a
#         header [ LOGIN-ADMISSION.md sections 2, 3, 5 ]

my $id      = shift;
my $args    = shift // {};
my $session = $data{'session'}->{$id};

## no token over plain http [ plugin.web.auth.refuse_plaintext ] ##
return 2 if <[plugin.web.auth.refuse_plaintext]>->($id);

my $body = $session->{'http'}->{'body'} // $session->{'buffer'}->{'input'}
    // '';
$session->{'http'}->{'body'}    = '';
$session->{'buffer'}->{'input'} = '';

my $headers = $session->{'http'}->{'request'}->{'headers'} // {};

## real socket facts : the admission source and the cookie's Secure flag ##
## both come from these, never from a header                             ##
my $peer_addr = $session->{'http'}->{'request'}->{'client'}->{'addr'} // '';
my $peer_fh   = $session->{'handle'};
my $peer_tls  = ( ref $peer_fh and $peer_fh->isa('IO::Socket::SSL') ) ? 1 : 0;

## body goes as unicode chars [ base.s_write re-encodes on the wire ] ##
utf8::decode($body) if length($body) and not utf8::is_utf8($body);

$session->{'http'}->{'close'} = TRUE;

## replace input watcher : keep EOF detection, disable timeout -- the ##
## request may be held in the admission queue                         ##
if ( defined $session->{'watcher'}{'input_handler'} ) {
    my $fd = $session->{'watcher'}{'input_handler'}->fd;
    $session->{'watcher'}{'input_handler'}->cancel;
    $session->{'watcher'}{'input_handler'} = Event->io(
        'fd'     => $fd,
        'cb'     => sub { &{ $code{'base.handler.read'} } },
        'poll'   => qw| r |,
        'prio'   => 1,
        'repeat' => FALSE,
        'data'   => $id,
        'desc'   => sprintf( '[%d] input handler [ no timeout ]', $id ),
    );
}

## header values : a linebreak cannot come from the http parser, but strip ##
## \r\n anyway -- send.local refuses to frame those                        ##
my $auth_header   = $headers->{'authorization'} // '';
my $cookie_header = $headers->{'cookie'}        // '';
for my $value ( $auth_header, $cookie_header ) {
    $value =~ s|[\r\n]+||g;
}

## the cube wire carries multi-line param lines + body                    ##
## [  base.protocol-7.command.send.local ] : the socket facts travel as ' ##
## key : value' header lines, the body after the empty line               ##
my $call_args = {
    'param' => {
        'peer_addr'     => $peer_addr,
        'peer_tls'      => $peer_tls,
        'auth_header'   => $auth_header,
        'cookie_header' => $cookie_header,
    },
};
## the packet body ends in a linefeed [ base.format.multiline_command ] ; ##
## the web side strips the last one again                                 ##
$call_args->{'data'} = $body =~ s{(?<!\n)\z}{\n}r if length $body;

<[protocol-7.route-send]>->(
    {   'command'   => qw| web.auth-login |,
        'call_args' => $call_args,
        'reply'     => {
            'handler' => qw| httpd.handler.web-relay.login |,
            'params'  => { 'http_sid' => $id },
        },
    }
);

return 0;    # [ deferred : the reply handler writes the response ]

