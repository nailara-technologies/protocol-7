# name = tile.handler.root_restart_reply

my $answer = shift;

my $zenka_name_str = $answer->{'params'};

if (    $answer->{'cmd'} ne qw| TRUE |
    and $answer->{'call_args'}->{'args'} =~ m|no zenka| ) {

    <[base.log]>->(
        0, "<< ! >> no '$zenka_name_str' zenka was running, starting now..."
    );
    <[protocol-7.command.send.local]>->(
        {   'command'   => qw| cube.v7-zenki.start_once |,
            'call_args' => { 'args' => $zenka_name_str }
        }
    );
}

