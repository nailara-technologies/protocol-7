## [:< ##

# name  = smtpd.cmd.set_route
# descr = runtime routing table update
# param = <local_part> <target_zenka>

my $args = $call->{'args'} // '';
$args =~ s|^\s+|\s+$| | g;

return {
    'mode' => qw| false |,
    'data' => 'usage: set_route <local> <zenka>'
    }
    if not length $args
    or $args !~ m|^\S+\s+\S+$|;

my ( $local, $target ) = split( m|\s+|, $args, 2 );

<smtpd.cfg.route> //= {};
<smtpd.cfg.route>->{$local} = $target;

<[base.logs]>->( 1, 'smtpd: route %s -> %s', $local, $target );

return {
    'mode' => qw| true |,
    'data' => sprintf "route set: %s -> %s",
    $local, $target
};

