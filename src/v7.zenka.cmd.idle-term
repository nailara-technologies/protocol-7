## [:< ##

# name  = v7.zenka.cmd.idle-term
# descr = on-demand zenka asks v7 to terminate it cleanly
#         wraps zenka.instance.stop, can only affect the calling zenka
# note  = cube injects source zenka name and sid via source_zenka_sid alias

my ( $zenka, $zenka_sid ) = split( m| |, $call->{'args'}, 3 );

## validate injected source sid
unless ( defined $zenka_sid and $zenka_sid =~ m|^\d+$| ) {
    <[base.logs]>->(
        1, 'idle-term: no source sid injected [ cube misconfigured? ]'
    );
    return {
        'mode' => qw| false |,
        'data' => 'source zenka sid not available'
    };
}

## find instance by cube_sid [ same resolution as
## v7.zenka.cmd.restart_own-zenka ]
my $instance_id;
foreach my $id (<[v7.instance_ids]>) {
    my $instance = <v7.zenka.instance>->{$id};
    $instance_id = $id
        and last
        if exists $instance->{'cube_sid'}
        and defined $instance->{'cube_sid'}
        and $instance->{'cube_sid'} == $zenka_sid;
}

unless ( defined $instance_id ) {
    <[base.logs]>->(
        2,          'idle-term: sid %s not managed by v7 [ %s ]',
        $zenka_sid, $zenka
    );
    return {
        'mode' => qw| false |,
        'data' => 'caller zenka not managed by v7'
    };
}

## only on-demand zenki may self-terminate on idle [ always-on rejected ] ##
my $zenka_name   = <v7.zenka.instance>->{$instance_id}->{'zenka_name'};
my $zenka_config = <v7.start_setup.zenki.config>->{$zenka_name} // {};

unless ( ref $zenka_config eq qw| HASH |
    and <[base.cfg_bool]>->( $zenka_config->{'start'}->{'on-demand'} // 0 )
    == TRUE ) {
    <[base.logs]>->(
        1, 'idle-term: %s is not an on-demand zenka, rejecting', $zenka_name
    );
    return {
        'mode' => qw| false |,
        'data' => 'only on-demand zenki can self-terminate on idle'
    };
}

<[base.logs]>->(
    2,            'idle-term: terminating instance %d [ %s ] on request',
    $instance_id, $zenka_name
);

## sets <zenka.instance.shutdown> and cancels heartbeat timers before       ##
## terminating the process, so zenka_status forces 'shutdown' status and no ##
## restart is triggered [ race-proof by design ]                            ##
<[zenka.instance.stop]>->($instance_id);

## never actually reply : the calling zenka is about to be terminated, so   ##
## any TRUE we send is racing its own death [ SIGTERM first, giving its own ##
## handler time to shut down cleanly, see v7.terminate_process ] and        ##
## typically loses -- cube logs a harmless 'unknown route id' for a reply   ##
## that arrives after the source session already closed. 'deferred' skips   ##
## that attempt outright instead of losing the race. cube's own route       ##
## bookkeeping for this call is unaffected either way and collapses on its  ##
## own once the terminated zenka's session closes -- but our own local      ##
## pending-reply entry isn't touched by anything else, so we clean it up    ##
## ourselves here instead of leaving it open forever [ 'deferred' means     ##
## 'reply later', and we never will ]                                       ##
delete <base.cmd_reply>->{ $call->{'reply_id'} };

return { 'mode' => qw| deferred | };

