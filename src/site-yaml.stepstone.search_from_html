# name  = site-yaml.stepstone.search_from_html
# descr = extract job link list from stepstone search result html

my ( $url, $html ) = @ARG;

## extract all job page hrefs from the result listing -- relative or, as ##
## stepstone writes them since 2026-10, absolute [ the path is kept ]    ##
my @hrefs = (
    $html =~ m{ href="
                ## absolute : optional ##
                (?:https://www\.stepstone\.de)?
                ## the path is kept    ##
                (/stellenangebote--[^"]+inline\.html)
                " }xg
);

my @jobs;
my %seen;
for my $href (@hrefs) {
    next if $seen{$href}++;
    my ($job_id) = ( $href =~ m{--(\d+)-inline\.html} );
    next if not $job_id;

    ## the listing number, encoded ONCE here [ vax-int ] -- the job id ##
    ## everything downstream passes through unchanged                  ##
    $job_id = <[base.vax-int.encode]>->($job_id);

    ## reconstruct full url
    my $job_url = "https://www.stepstone.de$href";

    ## extract human-readable slug: everything between -- delimiters
    my ($slug) = ( $href =~ m{/stellenangebote--(.+)--\d+-inline} );
    my $title_hint = defined $slug
        ? do {
        ( my $t = $slug ) =~ s{-}{ }g;
        $t;
        }
        : '';

    push @jobs,
        {
        'id'         => $job_id,
        'url'        => $job_url,
        'title_hint' => $title_hint,
        };
}

return \@jobs;

