# name  = plugin.web.auth.create_session
# descr = generate token and create session file
# param = optional { user_id => '...', ttl => <seconds>, data => {} }

my $params  = shift                // {};
my $user_id = $params->{'user_id'} // <system.amos-zenka-user>
    // qw| protocol-7 |;
my $extra_data = $params->{'data'} // {};

my $cfg    = $data{'plugin.web.auth'}{'cfg'} // {};
my $secret = $cfg->{'secret'}                // '';

if ( not length $secret ) {
    <[base.s_warn]>
        ->('plugin.web.auth : no secret configured, cannot create session');
    return undef;
}

my $node_id = <system.node.name> // qw| protocol-7 |;
my $ntime   = <[base.ntime.b32]> // '';

## 32 bytes of OS-backed prng entropy                                     ##
## [ base.prng : fortuna, never perl rand ] : same-tick mints stay        ##
## distinct, and a leaked secret no longer makes tokens recomputable from ##
## public fields [ q1 of data/tasks/web-ui-user-login.md stage 0 ]        ##
my $entropy = unpack qw| H* |, <[base.prng.bytes]>->(32) // '';

## token = AMOS checksum of (node_id + ntime + user_id + secret + entropy) ##
## -- old tokens stay valid : only the hash is stored                      ##
my $token = <[chk-sum.amos]>->("$node_id $ntime $user_id $secret $entropy");
return undef if not defined $token;

my $token_hash = <[chk-sum.bmw.L13-str]>->($token);
return undef if not defined $token_hash;

my $secret_hash = <[chk-sum.bmw.L13-str]>->($secret);
return undef if not defined $secret_hash;

## per-token ttl override [ long-lived machine tokens ] ##
my $ttl = $params->{'ttl'} // $cfg->{'session'}->{'ttl_seconds'} // 86400;
my $now_epoch = time;
my $now_ntime = $ntime;

my $session_data = {
    'token_hash'       => $token_hash,
    'secret_hash'      => $secret_hash,
    'user_id'          => $user_id,
    'node_id'          => $node_id,
    'created_at'       => $now_ntime,
    'created_at_epoch' => $now_epoch,
    'last_seen'        => $now_ntime,
    'last_seen_epoch'  => $now_epoch,
    'expires_at'       => $now_ntime,         ## placeholder, updated below ##
    'expires_at_epoch' => $now_epoch + $ttl,
    'data'             => $extra_data,
};

my $written
    = <[plugin.web.auth.session.write]>->( $token_hash, $session_data );
return undef if not $written;

return {
    'token'            => $token,
    'token_hash'       => $token_hash,
    'user_id'          => $user_id,
    'node_id'          => $node_id,
    'expires_at_epoch' => $session_data->{'expires_at_epoch'},
};

