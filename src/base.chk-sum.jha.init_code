## [:< ##

# name  = base.chk-sum.jha.init_code
# descr = init 32-bit [ unsigned long int ] Jenkins Hashing Algorithm module

<[base.perlmod.load]>->( 'Crypt::Misc', qw| encode_b32r encode_b64u | );
<[base.perlmod.load]>->('Digest::JHash');

<[base.swap_subs]>->(qw|  base.chk-sum.jha  chk-sum.jha  |);

0;

