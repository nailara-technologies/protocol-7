## [:< ##

# name = base.session.init_code

##### must not be valid username syntax ######
<base.session.uname.client> = qw|  -  |;    ##
<base.session.uname.server> = qw| --- |;    ##
#####                             ^^^   ######

<callback.session.closing_last> = {
    'name'   => 'base.exit',   # <-- change [ or comment out ] as required ..,
    'params' => [
        sprintf( "terminating '%s' zenka [ no more sessions ]",
            <system.zenka.name> ),
        0
    ]
};

return FALSE;

