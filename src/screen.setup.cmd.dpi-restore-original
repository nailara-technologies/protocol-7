# name  = screen.setup.cmd.dpi-restore-original
# descr = restore original consumer files and clear dpi

my $reply_id = $call->{'reply_id'};
my $result   = <[screen.setup.dpi.restore-original]>->(
    {   'cb' => sub {
            my $restored = shift;
            my @lines    = map {"$_ : $restored->{'results'}{$_}"}
                qw| gtk tint2 openbox settings |;
            <[base.callback.cmd_reply]>->(
                $reply_id,
                { 'mode' => qw| size |, 'data' => join( "\n", @lines ) }
            ) if length $reply_id // '';
        },
    }
);
return $result if not length $reply_id // '';
return { 'mode' => qw| deferred | };

