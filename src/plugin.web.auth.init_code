## [:< ##

# name  = plugin.web.auth.init_code
# descr = initialize web auth plugin, set up session store paths

## detect zenka context ##
my $zenka = <system.zenka.name> // qw| web |;

## load auth config ##
my $cfg_path
    = catfile( <system.root_path> // qw| . |, qw| cfg zenki web auth.yaml | );
my $auth_cfg = {};
$auth_cfg = <[format.yaml.load_file]>->($cfg_path) // {}
    if -f $cfg_path;
$data{'plugin.web.auth'}{'cfg'} = $auth_cfg;

## ensure shared session directory exists ##
my $session_base = <[plugin.web.auth.session.path]>;
my $user         = <system.zenka-user.current> // <system.amos-zenka-user>
    // qw| protocol-7 |;
my $group = <system.zenka-group.current> // $user;

for my $subdir (qw| active expired |) {
    my $dir = "$session_base/$subdir";
    next if -d $dir;
    <[file.make_path]>->( $dir, 0750, $user, $group );
}

<[base.logs]>->( 1, 'plugin.web.auth : initialized [ zenka=%s ]', $zenka );

0;

