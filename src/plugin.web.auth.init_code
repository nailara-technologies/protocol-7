## [:< ##

# name  = plugin.web.auth.init_code
# descr = initialize web auth plugin, set up session store paths

## detect zenka context ##
my $zenka = <system.zenka.name> // qw| web |;

## load auth config ##
my $cfg_path
    = catfile( <system.root_path> // qw| . |, qw| cfg zenki web auth.yaml | );
my $auth_cfg = {};
$auth_cfg = <[format.yaml.load_file]>->($cfg_path) // {}
    if -f $cfg_path;

## secret source : host config ONLY [ base.load_host_config :               ##
## /etc/protocol-7/host-config/<zenka>.cfg 'web.auth.secret = ...' ] -- the ##
## tracked auth.yaml must never carry a secret : refuse to honor one        ##
my $yaml_secret = $auth_cfg->{'secret'} // '';
if ( length $yaml_secret ) {
    <[base.logs]>->(
        0,
        'plugin.web.auth : secret in tracked auth.yaml IGNORED : use host '
            . 'config [ web.auth.secret in /etc/protocol-7/%s/host.cfg ]',
        $zenka
    );
    $auth_cfg->{'secret'} = '';
}
my $host_secret = <web.auth.secret> // '';
$auth_cfg->{'secret'} = $host_secret if length $host_secret;

if ( not length( $auth_cfg->{'secret'} // '' ) ) {
    <[base.logs]>->(
        1,
        'plugin.web.auth : no web.auth.secret in '
            . 'host config : auth fail closed [ zenka=%s ]',
        $zenka
    );
}

$data{'plugin.web.auth'}{'cfg'} = $auth_cfg;

## shared session store : created/re-asserted while still root        ##
## [ this init_code runs before root.drop_privs ] ; idempotent -- see ##
## plugin.web.auth.store.set-up                                       ##
<[plugin.web.auth.store.set-up]>;

<[base.logs]>->( 1, 'plugin.web.auth : initialized [ zenka=%s ]', $zenka );

0;

