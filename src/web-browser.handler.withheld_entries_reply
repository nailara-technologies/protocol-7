# name = web-browser.handler.withheld_entries_reply

my $reply = shift;

return
    if $reply->{'cmd'} ne qw| TRUE |
    or $reply->{'call_args'}->{'args'} == 0;

<[base.log]>->(
    1, "got withheld playlist entries, presenting loading icon.."
);

<[web-browser.fg_view_insert]>->(<web-browser.load_icon_page>);

