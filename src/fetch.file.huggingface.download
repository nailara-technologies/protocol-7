## [:< ##

# name  = fetch.file.huggingface.download
# descr = download GGUF model from HuggingFace Hub
# param = { repo => 'user/repo', file => 'model-Q4_K_S.gguf', dest => undef }

use IPC::Open3;
use Symbol     qw| gensym |;
use POSIX      qw| WNOHANG |;
use File::Path qw| make_path |;

my $call = shift;
my $args = $call->{'args'} // {};
$args = {} if ref $args ne qw| HASH |;

my $repo = $args->{'repo'} // '';
my $file = $args->{'file'} // '';
my $dest = $args->{'dest'} // '';

## validate args ##
return { 'mode' => qw| false |, 'data' => 'repo parameter required' }
    if !length($repo);
return { 'mode' => qw| false |, 'data' => 'file parameter required' }
    if !length($file);

## auto-detect destination for GGUF files ##
if ( !length($dest) ) {
    if ( $file =~ m\.gguf$\i ) {
        $dest = <external.models.lmstudio.path> // <external.models.path>
            // '/mnt/ext-xfs-data/models-lmstudio';
    } else {
        $dest = <external.models.download.temp> // '/tmp/model-downloads';
    }
}

## ensure destination directory exists ##
if ( !-d $dest ) {
    eval { make_path( $dest, { 'mode' => 0755 } ) };
    if ($EVAL_ERROR) {
        return {
            'mode' => qw| false |,
            'data' => "cannot create destination directory: $dest"
        };
    }
}

my $dest_path = "$dest/$file";

## no upfront "already exists" short-circuit -- a partially-downloaded file ##
## from an earlier interrupted attempt must be RESUMED, not reported as     ##
## done (a real bug, hit live 2026-09-10: a truncated partial was silently  ##
## treated as a complete success). aria2c's own --continue handles "already ##
## complete" vs "resume the rest" correctly by checking the real remote     ##
## size, which a bare `-f` existence check can never do.                    ##

## LAN check first (faster than WAN) ##
my $lan_result
    = <[huggingface.lan-check]>->( { 'args' => { 'filename' => $file } } );

if ( ref $lan_result eq qw| HASH |
    and $lan_result->{'found'} ) {
    ## TODO: initiate rsync from LAN host  for now, report that LAN copy is ##
    ## available                                                            ##
    <[base.logs]>->(
        1,
        "[hf.fetch] LAN copy found on %s: %s",
        $lan_result->{'host'} // 'unknown',
        $lan_result->{'path'} // 'unknown'
    );
}

## determine download tool ##
my @cmd;
my $use_hf_cli = 0;

if ( open( my $null, '-|', 'which', 'huggingface-cli' ) ) {
    while (<$null>) { $use_hf_cli = 1 }
    close($null);
}

my $hf_token = <fetch.file.hf_token> // <external.hf.token> // '';

if ($use_hf_cli) {
    @cmd = (
        'huggingface-cli', 'download', $repo, $file, '--local-dir', $dest
    );
    push @cmd, '--token', $hf_token if length($hf_token);
} else {
    my $url = sprintf( 'https://huggingface.co/%s/resolve/main/%s',
        $repo, $file );

    ## aria2c, not wget: HF's own CDN stalls/throttles connections on       ##
    ## occasion (observed live, 2026-09-10) -- aria2c natively resumes      ##
    ## partial transfers (--continue) and detects a stalled [not just dead] ##
    ## connection via --lowest-speed-limit, retrying automatically instead  ##
    ## of silently sitting at a plateau forever. --max-tries=0 retries      ##
    ## indefinitely; --dir/--out replace wget's combined -O path since      ##
    ## aria2c wants them separate.                                          ##
    @cmd = (
        'aria2c',
        '--dir', $dest,
        '--out', $file,
        '--continue=true',
        '--allow-overwrite=false',
        '--max-tries=0',
        '--retry-wait=5',
        '--timeout=60',
        '--lowest-speed-limit=51200',    ## 50 KB/s floor before retry ##
        '--auto-file-renaming=false',
        '--summary-interval=2',
        '--console-log-level=warn',
    );

    ## this codebase's outbound network otherwise relies on http_proxy/     ##
    ## https_proxy being inherited automatically (true for wget/curl, NOT   ##
    ## true for aria2c -- confirmed, no such env-var auto-pickup in its own ##
    ## --help=all) -- thread it through explicitly or downloads silently go ##
    ## direct instead of through the configured proxy                       ##
    my $proxy = $ENV{'https_proxy'} // $ENV{'http_proxy'} // '';
    push @cmd, '--all-proxy', $proxy if length $proxy;

    push @cmd, $url;
}

## spawn download process ##
my ( $chld_in, $chld_out, $chld_err );
$chld_err = gensym;

my $pid = eval { IPC::Open3::open3( $chld_in, $chld_out, $chld_err, @cmd ) };

if ( !$pid || $EVAL_ERROR ) {
    <[base.logs]>->(
        0,
        "[hf.fetch] failed to spawn download: %s",
        $EVAL_ERROR // 'unknown error'
    );
    return {
        'mode' => qw| false |,
        'data' => 'download spawn failed: ' . ( $EVAL_ERROR // 'unknown' )
    };
}

## a large file transfer can easily outlive this on-demand zenka's idle- ##
## shutdown window -- suspend it for the duration, matching the exact    ##
## "long-running background job" use case pause_ondemand_timeout exists  ##
## for. resumed in huggingface.handler.download_progress once the child  ##
## process actually exits (success or failure).                          ##
<[base.logs]>->(
    1,     "[hf.fetch] pausing idle-shutdown for %s [pid=%d]",
    $file, $pid
);
<[base.zenki.pause_ondemand_timeout]>;

## register with v7-zenki so this child is actually terminated if the zenka ##
## itself gets restarted/killed -- without this, aria2c/wget is silently    ##
## orphaned across a zenka restart instead of being cleaned up (observed    ##
## live, 2026-09-10 -- needs cfg/zenki/cube/access.zenki's                  ##
## access.cmd.usr.fetch-files grant for v7-zenki.register_child)            ##
<[base.logs]>->(
    1, "[hf.fetch] registering child pid %d with v7-zenki", $pid
);
<[base.zenki.report_child_pid]>->($pid);

close($chld_in) if defined $chld_in;

## register progress tracking ##
<fetch.file.downloads> //= {};

my $dl_id = sprintf( '%s:%s', $repo, $file );
<fetch.file.downloads>->{$dl_id} = {
    'repo'       => $repo,
    'file'       => $file,
    'dest'       => $dest_path,
    'pid'        => $pid,
    'start_time' => <[base.time]>->(3),
    'downloaded' => 0,
    'total'      => 0,
    'status'     => qw| downloading |,
    'speed'      => 0,
    'eta'        => 0,
    'reply_id'   => $call->{'reply_id'} // '',
};

## set up non-blocking read on stderr for progress output ##
for my $fh ( $chld_out, $chld_err ) {
    next if !defined $fh;
    my $flags = fcntl( $fh, Fcntl::F_GETFL(), 0 );
    fcntl( $fh, Fcntl::F_SETFL(), $flags | Fcntl::O_NONBLOCK() )
        if defined $flags;
}

## register file handle watchers for stderr progress parsing ##
if ( defined $chld_err ) {
    <[event.add_io]>->(
        {   'fd'      => $chld_err,
            'poll'    => qw| r |,
            'handler' => qw| huggingface.handler.download_stderr |,
            'data'    => { 'dl_id' => $dl_id },
        }
    );
}

## register repeating timer for progress polling and completion check ##
<fetch.file.downloads>->{$dl_id}{'timer'} = <[event.add_timer]>->(
    {   'interval' => 2.0,
        'repeat'   => 1,
        'handler'  => qw| huggingface.handler.download_progress |,
        'data'     => { 'dl_id' => $dl_id },
    }
);

<[base.logs]>->(
    1, "[hf.fetch] started download: %s/%s -> %s [pid=%d]",
    $repo, $file, $dest_path, $pid
);

return { 'mode' => qw| deferred | };

