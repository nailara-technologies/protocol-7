## [:< ##

# name  = fetch.file.huggingface.download
# descr = download GGUF model from HuggingFace Hub via native async
#         clients.https streaming [ no external wget/aria2c child ]
# param = { repo => 'user/repo', file => 'model-Q4_K_S.gguf', dest => undef }

use File::Path qw| make_path |;

my $call = shift;
my $args = $call->{'args'} // {};
$args = {} if ref $args ne qw| HASH |;

my $repo = $args->{'repo'} // '';
my $file = $args->{'file'} // '';
my $dest = $args->{'dest'} // '';

## validate args ##
return { 'mode' => qw| false |, 'data' => 'repo parameter required' }
    if !length($repo);
return { 'mode' => qw| false |, 'data' => 'file parameter required' }
    if !length($file);

## auto-detect destination for GGUF files ##
if ( !length($dest) ) {
    if ( $file =~ m\.gguf$\i ) {
        $dest = <external.models.lmstudio.path> // <external.models.path>
            // '/mnt/ext-xfs-data/models-lmstudio';
    } else {
        $dest = <external.models.download.temp> // '/tmp/model-downloads';
    }
}

## ensure destination directory exists ##
if ( !-d $dest ) {
    eval { make_path( $dest, { 'mode' => 0755 } ) };
    if ($EVAL_ERROR) {
        return {
            'mode' => qw| false |,
            'data' => "cannot create destination directory: $dest"
        };
    }
}

my $dest_path = "$dest/$file";

## LAN check first (faster than WAN) ##
my $lan_result
    = <[huggingface.lan-check]>->( { 'args' => { 'filename' => $file } } );

if ( ref $lan_result eq qw| HASH |
    and $lan_result->{'found'} ) {
    ## TODO: initiate rsync from LAN host  for now, report that LAN copy is ##
    ## available                                                            ##
    <[base.logs]>->(
        1,
        "[hf.fetch] LAN copy found on %s: %s",
        $lan_result->{'host'} // 'unknown',
        $lan_result->{'path'} // 'unknown'
    );
}

## register download tracking ##
<fetch.file.downloads> //= {};

my $dl_id = sprintf( '%s:%s', $repo, $file );

<fetch.file.downloads>->{$dl_id} = {
    'repo' => $repo,
    'file' => $file,
    'dest' => $dest_path,
    'url'  =>
        sprintf( 'https://huggingface.co/%s/resolve/main/%s', $repo, $file ),
    'redirects'  => 0,
    'start_time' => <[base.time]>->(3),
    'downloaded' => 0,
    'total'      => 0,
    'status'     => qw| downloading |,
    'speed'      => 0,
    'eta'        => 0,
    'reply_id'   => $call->{'reply_id'} // '',
    ## LFS checksum verification state [ see huggingface.handler.           ##
    ## blob_hash_response + huggingface.verify.* ] : hash_state is pending  ##
    ## -> ok | failed | non-lfs ; a download may only reach status=complete ##
    ## through the verified path                                            ##
    'hash_state'      => qw| pending |,
    'expected_sha256' => undef,
    'expected_size'   => 0,
    'hash_attempts'   => 0,
};

## a large file transfer can easily outlive this on-demand zenka's idle-  ##
## shutdown window -- suspend it for the duration, matching the exact     ##
## "long-running background job" use case pause_ondemand_timeout exists   ##
## for. the resume ALWAYS comes from huggingface.resume_idle once every   ##
## tracked flow [ download / await-hash / verify ] is terminal -- never a ##
## bespoke resume [ see fetch.file.huggingface.resume_idle ]              ##
<[base.logs]>->( 1, "[hf.fetch] pausing idle-shutdown for %s", $file );
<[base.zenki.pause_ondemand_timeout]>;

## start the native streaming transfer : redirect-following lives in        ##
## huggingface.handler.download_response [ huggingface.co answers 302 to    ##
## the CDN ] -- the same entry is re-requested, the partial file is         ##
## truncated by the fresh stream_to_file open, so a restart-from-scratch on ##
## failure is the v1 behavior by construction [ no resumable partials ]     ##
<[huggingface.start_download]>->($dl_id);

## lightweight repeating progress logger [ size/speed for hf-status and the ##
## log stream ] -- completion itself arrives through the streaming client's ##
## own on_done callback, not through this timer                             ##
<fetch.file.downloads>->{$dl_id}{'timer'} = <[event.add_timer]>->(
    {   'interval' => 2.0,
        'repeat'   => 1,
        'handler'  => qw| huggingface.handler.download_progress |,
        'data'     => { 'dl_id' => $dl_id },
    }
);

<[base.logs]>->(
    1, "[hf.fetch] started download: %s/%s -> %s",
    $repo, $file, $dest_path
);

## fetch the published LFS sha256 for this file up-front, in parallel with  ##
## the download itself [ async via clients.https.get, proxy- threaded       ##
## explicitly ]. the result is cached in this tracking entry and consumed   ##
## by huggingface.handler.download_response / huggingface.verify.* once the ##
## bytes are on disk -- closing the exit-code-only acceptance hole behind   ##
## the 2026-09-10 corrupted-shard incident.                                 ##
<[huggingface.hash.fetch]>->( $dl_id, 1 );

return { 'mode' => qw| deferred | };

