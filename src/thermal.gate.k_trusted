## [:< ##

# name  = thermal.gate.k_trusted
# descr = check whether the learned power coefficient may drive decisions

my $gate = shift;

return FALSE if ref $gate ne qw| HASH |;
return FALSE if ( <thermal.cfg.predict> // qw| yes | ) ne qw| yes |;
return FALSE
    if ( $gate->{'k_samples'} // 0 ) < ( <thermal.cfg.k.min_samples> // 30 );

return TRUE;

