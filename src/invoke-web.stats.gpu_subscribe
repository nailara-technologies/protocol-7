## [:< ##

# name   = invoke-web.stats.gpu_subscribe
# descr  = gpu temperature feed for the render statistics : STRM
#          subscription to X-11's 'temp' metric [ X-11.gpu_metric ]
# return = TRUE [ live or requested ] | FALSE
# note   = lazy : called at every render start, does nothing while the feed
#          is live or a request is pending. no X-11 session : v7-zenki
#          starts it [ notify_online ':start:' ], then a retry subscribes by
#          sid [ bare X-11 names would fan out to every instance ]. the open stream keeps X-11 from its idle
#          shutdown -- it ends with this zenka's session [ invoke-web idles
#          out after invoke.ai stopped ]

my $feed = <invoke-web.gpu_feed> //= {};
my $now  = <[base.time]>->(3);

return TRUE
    if defined $feed->{'updated_at'} and $now - $feed->{'updated_at'} < 15;
return TRUE
    if defined $feed->{'pending'} and $now - $feed->{'pending'} < 30;

$feed->{'pending'} = $now;

<[base.zenki.resolve_primary_sid]>->(
    'X-11',
    sub {
        my $sid = shift;

        if ( defined $sid ) {
            <[protocol-7.route-send]>->(
                {   'command'   => "$sid.gpu_metric",
                    'call_args' => { 'args' => 'temp subscribe' },
                    'reply'     => {
                        'handler' => qw| invoke-web.handler.gpu_temp_reply |,
                        'params'  => {}
                    }
                }
            );
            return;
        }

        ## no X-11 session : v7 starts it [ ':start:' ] and replies once it ##
        ## is online -- the retry then subscribes by sid                    ##
        <[protocol-7.route-send]>->(
            {   'command'   => qw| v7-zenki.notify_online |,
                'call_args' => { 'args' => ':start: X-11' },
                'reply'     => {
                    'handler' => qw| invoke-web.handler.gpu_temp_reply |,
                    'params'  => { 'wake' => TRUE }
                }
            }
        );
    }
);

return TRUE;

