## [:< ##

# name   = invoke-web.stats.gpu_subscribe
# descr  = gpu feeds for the render statistics : STRM subscriptions to
#          X-11's metrics [ X-11.gpu_metric : temp, clock, power, throttle ]
# return = TRUE [ live or requested ] | FALSE
# note   = lazy : called at every render start, subscribes only the metrics
#          not live [ no sample for 15s ] while no request is pending. no
#          X-11 session : v7-zenki starts it [ notify_online ':start:' ],
#          then a retry subscribes by sid [ bare X-11 names would fan out
#          to every instance ]. open streams keep X-11 from its idle
#          shutdown -- they end with this zenka's session [ invoke-web
#          idles out after invoke.ai stopped ]

my $feed = <invoke-web.gpu_feed> //= {};
my $now  = <[base.time]>->(3);

my @stale = grep {
    not defined $feed->{'live'}->{$ARG}
        or $now - $feed->{'live'}->{$ARG} >= 15
} qw| temp clock power throttle |;

return TRUE if not @stale;
return TRUE
    if defined $feed->{'pending'} and $now - $feed->{'pending'} < 30;

$feed->{'pending'} = $now;

<[base.zenki.resolve_primary_sid]>->(
    'X-11',
    sub {
        my $sid = shift;

        if ( defined $sid ) {
            foreach my $metric (@stale) {
                <[protocol-7.route-send]>->(
                    {   'command'   => "$sid.gpu_metric",
                        'call_args' => { 'args' => "$metric subscribe" },
                        'reply'     => {
                            'handler' =>
                                qw| invoke-web.handler.gpu_metric_reply |,
                            'params' => { 'metric' => $metric }
                        }
                    }
                );
            }
            return;
        }

        ## no X-11 session : v7 starts it [ ':start:' ] and replies once it ##
        ## is online -- the retry then subscribes by sid                    ##
        <[protocol-7.route-send]>->(
            {   'command'   => qw| v7-zenki.notify_online |,
                'call_args' => { 'args' => ':start: X-11' },
                'reply'     => {
                    'handler' => qw| invoke-web.handler.gpu_metric_reply |,
                    'params'  => { 'wake' => TRUE }
                }
            }
        );
    }
);

return TRUE;

