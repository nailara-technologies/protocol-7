## [:< ##

# name = io.ip.tcp.init_code

## a stale pre-array-ification hashref may still be sitting in %data from ##
## before this shape existed [ reload doesn't reset %data ] -- normalize  ##
$data{'sig_warn_blacklist'} = []
    unless ref $data{'sig_warn_blacklist'} eq 'ARRAY';
push $data{'sig_warn_blacklist'}->@*,
    { 'pattern' => qr{^(Constant s|S)ubroutine \S+ redefined } };

<[base.perlmod.load]>->( 'IO::Socket::IP', qw| -register | );

pop $data{'sig_warn_blacklist'}->@*;    ## remove temporary entry again ##

<io.type>->{'ip.tcp'} = {

    'ref' => 'IO::Socket::IP',

    'handler' => {

        'output' => {
            'open'  => 'io.ip.tcp.output.open',
            'close' => 'io.ip.tcp.output.close',
            'read'  => 'base.handler.read',
            'write' => 'base.handler.write'
        },

        'input' => {
            'open'    => 'io.ip.tcp.input.open',
            'close'   => 'io.ip.tcp.input.close',
            'connect' => 'io.ip.tcp.input.connect',
            'read'    => 'base.handler.read',
            'write'   => 'base.handler.write'
        }
    }
};

return FALSE;

