## [:< ##

# name   = coding.remind.lines
# descr  = the kept reminders as list lines
# return = list of lines, with the reason of each

my $all = <[coding.remind.store]>->(qw| all |);
my @lines;
foreach my $id ( sort keys %{$all} ) {
    my $r     = $all->{$id};
    my $tries = $r->{'tries'} // 0;
    push @lines,
        sprintf '%s  %s  tries %d [ %s ] # %s [ to=%s ]',
        $id, $r->{'status'}, $tries, $r->{'reason'} // 'on its way',
        $r->{'text'}, $r->{'to'};
}
return @lines;

