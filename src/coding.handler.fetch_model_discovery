# name  = coding.handler.fetch_model_discovery
# descr = timer handler: request model discovery from models zenka at startup

## send async request to models zenka - guaranteed online via dependency
##
## route-send, not a raw command.send.local -- models is a peer zenka
## connected through cube, not a direct local session of coding, so a bare
## send.local here always failed with 'unknown target : models' [ silently
## mislogged as "models zenka offline" ] regardless of the command string.
## route-send prepends parent_route [ here: ['cube'] ] so the command actually
## resolves as cube.models.discover. also fixed: the command name itself was
## 'models.cmd.discover', the internal src/ file-naming form -- the real
## routable command is 'models.discover' [ matches the working call in
## coding.cmd.clear-registry ]
my $cmd_count = <[protocol-7.route-send]>->(
    {   'command'   => 'models.discover',
        'call_args' => { 'args' => 'available' },
        'reply'     => {
            'handler' => 'coding.handler.models_discover_reply',
            'params'  => { 'context' => 'init' }
        }
    }
);

if ($cmd_count) {
    <[base.logs]>->( 2, 'model discovery request sent to models zenka' );
} else {
    <[base.logs]>->( 1, 'models zenka offline during discovery request' );
}

