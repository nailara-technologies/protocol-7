## [:< ##

# name  = letsencr.parent.determine_certificate_domains
# descr = map vhost names to certificate domains for enrollment

my $vhosts_list = shift;

return {
    status  => qw| error |,
    error   => 'vhosts array required',
    domains => {},
    }
    unless $vhosts_list && ref($vhosts_list) eq qw| ARRAY |;

<[base.logs]>->(
    2,                     'determining certificate domains from %d vhost%s',
    scalar(@$vhosts_list), <[base.cnt_s]>->( scalar(@$vhosts_list) )
);

my %domains_map;

foreach my $vhost ( $vhosts_list->@* ) {
    next unless defined $vhost && length($vhost) > 0;

    ## Skip special vhosts
    # Skip 'default' - it's a generic vhost
    next if $vhost eq qw| default |;

    # Skip localhost references
    next if $vhost =~ m{^localhost|127\.0\.0\.1|::1|\[.*:.*:.*\]$}i;

    # Skip private network ranges (10.x, 172.16-31.x, 192.168.x)
    next
        if $vhost
        =~ m{^10\.|^172\.(1[6-9]|2[0-9]|3[01])\.|^192\.168\.|^fd[0-9a-f]{2}:}i;

    # Skip IPv6 link-local
    next if $vhost =~ m{^fe80:}i;

    ## only fully qualified domain names can get a public certificate : ##
    ## vhost directory names [ 'skins' ] and ip literals are skipped    ##
    if ($vhost !~ m{^(?:\*\.)?(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+
                    [a-z](?:[a-z0-9-]*[a-z0-9])?$}xi
    ) {
        <[base.logs]>->(
            2, ': skipping vhost %s ' . '[ not a domain name ]', $vhost
        );
        next;
    }

    ## special-use names never resolve publicly [ rfc 6761 \ 6762 \ 8375, ##
    ## icann .internal ; .lan by convention ] : pattern-installed local   ##
    ## vhosts like 'jobs.local' stay served but get no acme order         ##
    if ($vhost =~ m{\.(?:local|localhost|test|invalid|example|internal|lan
                       |onion|home\.arpa)$}xi
    ) {
        <[base.logs]>->(
            2, ': skipping vhost %s [ special-use name ]', $vhost
        );
        next;
    }

    # Valid domain-like vhost - queue for certificate
    # Normalize domain (lowercase)
    my $domain = lc($vhost);

    ## a wildcard groups under its base domain [ *.example.com -> ##
    ## example.com ] ; every other name is its own domain         ##
    my $base_domain = $domain;
    $base_domain = $LAST_PAREN_MATCH if $domain =~ m|^\*\.(.+)$|;

    # Initialize domain entry if not present
    unless ( exists $domains_map{$base_domain} ) {
        $domains_map{$base_domain} = {
            primary_domain => $base_domain,
            vhosts         => [],
            alt_names      => [],
        };
    }

    # Add vhost to this domain's list
    push @{ $domains_map{$base_domain}{vhosts} }, $vhost;

    # If it's a wildcard, add to alt_names
    if ( $vhost =~ m|^\*\.| ) {
        push $domains_map{$base_domain}{alt_names}->@*, $vhost;
    }

    ## no implicit 'www.' alt name : certificates cover exactly the ##
    ## configured vhosts -- a www name is a vhost of its own        ##
}

## Log determined domains
<[base.logs]>->(
    2,
    ': determined %d certificate domain%s',
    scalar( keys %domains_map ),
    <[base.cnt_s]>->( scalar( keys %domains_map ) )
);
foreach my $domain ( <[base.sort]>->( keys %domains_map ) ) {
    my $info = $domains_map{$domain};
    my $alts
        = $info->{'alt_names'}->@* > 0
        ? "  [ + " . scalar( $info->{'alt_names'}->@* ) . " alts ]"
        : "";
    <[base.logs]>->( 2, ":. %17s%s", $domain, $alts );
}

return {
    status  => qw| success |,
    domains => \%domains_map,
};

