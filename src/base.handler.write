## [:< ##

# name  = base.handler.write
# descr = writes buffer content to client handle

my $id;
my $event;

if ( ref $ARG[0] ne qw| Event::Event::Io | and $ARG[0] =~ m|^\d+| ) {
    $id = shift;    ##  direct call with session id  ##
} else {    ## was Event watcher ##
    $event = shift;              ## fetch event ##
    $id    = $event->w->data;    ## stored session id ##
}

if ( not exists $data{'session'}->{$id} ) {    ## session is gone ? ##
    $event->w->cancel if $event->w->is_active;    ## cancel watcher <- ##
    return <[base.session.check_remaining]>->( 0, TRUE ); ## using silenced ##
}

my $session = $data{'session'}->{$id};
my $buf     = $session->{'buffer'}->{'output'};

## Use bytes::length() to get actual byte count, not character count This is
## critical when buffer contains UTF-8 multi-byte characters
my $write_size = bytes::length($buf);

## true when called from the per-session IO write-ready watcher ##
my $from_write_handler
    = defined $event
    && defined $event->w->desc
    && $event->w->desc =~ m|\] write handler$|;

if ( fileno $session->{'handle'} ) {
    my $is_download = defined $session->{'watcher'}->{'download_handler'};
    my $write_count = 0;
    my $hit_eagain  = 0;    ## set when syswrite returns 0 [ socket full ] ##
    my $max_writes_per_call = 64;   ## ~1MB per handler invocation (64 * 16KB)

    while ( $write_size > 0 && $write_count < $max_writes_per_call ) {
        my $size_written
            = ref( $session->{'handle'} ) eq qw| IO::Socket::SSL |
            ? <[base.ssl.write]>->(
            $session->{'handle'}, \$session->{'buffer'}->{'output'},
            $write_size
            )
            : <[base.s_write]>->(
            $session->{'handle'}, \$session->{'buffer'}->{'output'},
            $write_size
            );

        if ( $size_written < 0 ) {
            $session->{'shutdown'} = 1;
            last;
        } elsif ( $size_written == 0 ) {
            ## socket buffer full [ EAGAIN ] ##
            $hit_eagain = 1;
            last;
        } else {
            $data{'handle'}{ $session->{'handle'} }{'bytes'}{'out'}
                += $size_written;

            substr( $session->{'buffer'}->{'output'}, 0, $size_written, '' );

            <[base.stream.advance_drain]>->( $id, $size_written )
                if defined $session->{'obs_deque'};

            $write_size = bytes::length( $session->{'buffer'}->{'output'} );
            $write_count++;
        }
    }

    if ( defined $event ) {
        $event->w->stop;

        my $remaining_buf = bytes::length $session->{'buffer'}->{'output'};

        ## exited the write loop on the write-count cap [ not EAGAIN, not   ##
        ## drained ] : every syswrite succeeded, the client is just faster  ##
        ## than 64 writes' worth of data -- neither of the branches below   ##
        ## expects this case, so left alone it re-arms the watcher as       ##
        ## active without ever having scheduled anything to continue it,    ##
        ## which then makes the io_idle_restart check further down [ 'not   ##
        ## $event->w->is_active' ] skip pushing it onto <watcher_list.      ##
        ## paused>, so the remaining buffered bytes never get sent -- a     ##
        ## silent, permanent stall with no error and no disconnect.         ##
        ## confirmed live 2026-09-14 : coding.dump [ a ~1.5MB reply, routed ##
        ## through this exact loop ] reliably completed only when the       ##
        ## client was slow enough [ higher nshell verbosity ] to force a    ##
        ## real EAGAIN before hitting 64 writes -- a fast/quiet client      ##
        ## never got EAGAIN, always hit the cap instead, and stalled        ##
        my $hit_write_cap
            = $write_count >= $max_writes_per_call && $write_size > 0;

        if ($is_download) {
            $event->w->start;    ## immediate restart for downloads ##
        } elsif ($hit_write_cap) {
            ## leave inactive : falls through to io_idle_restart below, ##
            ## which pushes it onto <watcher_list.paused> for the ->now ##
            ## rescue in base.event.callback.io-idle-restart            ##
        } elsif ( defined $session->{'burst-writes'}
            and $session->{'burst-writes'} =~ m|^\d+$| ) {
            $session->{'burst-write-counter'} //= 0;
            if ( $session->{'burst-write-counter'}++
                < $session->{'burst-writes'} ) {
                $event->w->start;    ## burst-write mode ##
            } else {
                ##  deferred restart [ idle-watcher ]  ##
                delete $session->{'burst-write-counter'};
            }

        } elsif ($from_write_handler) {
            ## IO write watcher: restart even on EAGAIN so it re-fires when ##
            ## the kernel socket buffer drains (client reads more)          ##
            $event->w->start if $remaining_buf > 0;

        } else {
            ## var watcher: only restart when socket was still writable [ ##
            ## EAGAIN case is handled by write_handler IO watcher below ] ##
            $event->w->start if not $hit_eagain;
        }

        if ( defined $session->{'watcher'}->{'download_handler'}
            and !$session->{'watcher'}->{'download_handler'}->is_running ) {
            $session->{'watcher'}->{'download_handler'}->start;
        }
    }

    ## when socket was full from var-watcher path: create an IO write-ready ##
    ## watcher so cube re-tries as soon as the client drains the kernel buf ##
    if ( $hit_eagain and not $from_write_handler ) {
        if ( not defined $session->{'watcher'}->{'write_handler'} ) {
            $session->{'watcher'}->{'write_handler'} = <[event.add_io]>->(
                {   'fd'      => $session->{'handle'},
                    'poll'    => qw| w |,
                    'prio'    => -1,
                    'repeat'  => FALSE,
                    'data'    => $id,
                    'handler' => qw| base.handler.write |,
                    'desc'    => sprintf( '[%d] write handler', $id ),
                }
            );
        } elsif ( not $session->{'watcher'}->{'write_handler'}->is_active ) {
            $session->{'watcher'}->{'write_handler'}->start;
        }
    }

} else {
    $event->w->cancel;
    $session->{'shutdown'} = 1;
    return 2;
}

## Check remaining buffer size [use byte length, not character count]
if ( $write_size = bytes::length( $session->{'buffer'}->{'output'} ) ) {

    ##  deferred restart [ when idle ]  ##
    <[event.io_idle_restart]>->($event)
        if defined $event and not $event->w->is_active;

    <watcher.io.transfer>->start
        if not <watcher.io.transfer>->is_active;

} else {
    ## buffer empty : stop write_handler watcher and restart output_buffer ##
    if ( defined $session->{'watcher'}->{'write_handler'}
        and $session->{'watcher'}->{'write_handler'}->is_active ) {
        $session->{'watcher'}->{'write_handler'}->stop;
    }
    $session->{'watcher'}->{'output_buffer'}->start
        if not $session->{'watcher'}{'output_buffer'}->is_active;
}

$session->{'shutdown'} = 1 if !$write_size and $session->{'flush_shutdown'};

return FALSE;

