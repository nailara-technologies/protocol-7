## [:< ##

# name = memory.focus.boost
# descr = temporary boost spike that decays toward floor

my $topic = @_ ? shift : $ARG;
my $boost = @_ ? shift : $ARG;

return FALSE if not defined $topic or not length $topic;

$boost = 2.0 if not defined $boost or not length $boost;
$boost = 0 + $boost;

## [ ensure state exists ]##
<memory.focus>       //= {};
<memory.focus_floor> //= {};

my $current = <memory.focus>->{$topic} // 1.0;
my $spiked  = $current * $boost;

## [ cap to prevent runaway ]##
$spiked = 13 if $spiked > 13;

<memory.focus>->{$topic} = $spiked;

return TRUE;

