# name  = v7-zenki.handler.get_display_retry
# descr = timer : ask X-11 again for its display after a 'not ready' reply

my $params   = $_[0]->w->data        // return;
my $cube_sid = $params->{'cube_sid'} // return;

<[protocol-7.route-send]>->(
    {   'command' => "$cube_sid.get_display",
        'reply'   => {
            'handler' => qw| v7-zenki.handler.get_display_reply |,
            'params'  => {
                'cube_sid' => $cube_sid,
                'attempt'  => $params->{'attempt'},
            }
        }
    }
);

