## [:< ##

# name  = kimi.end_code
# descr = zenka exit : end the acp child, never leave it behind

## no event loop here : cancel, then the stream_child stop steps with short ##
## waits from base.interval.next [ type kimi-acp-exit ]                     ##

my $st = <kimi.acp.state>;
return TRUE if ref $st ne qw| HASH | or not defined $st->{'child'};
my $child = $st->{'child'};

## END also runs in a forked child that inherited this state : only the ##
## process that started the child ends it                               ##
return TRUE if ( $child->{'owner'} // 0 ) != $PROCESS_ID;

if ( $st->{'phase'} eq qw| prompting | and defined $child->{'in'} ) {
    my $line
        = qq|{"jsonrpc":"2.0","method":"session/cancel","params":{"sessionId":"|
        . ( $st->{'session_id'} // '' )
        . qq|"}}\n|;
    CORE::syswrite( $child->{'in'}, $line );
}
<[stream_child.end_code]>->($child);
return TRUE;

