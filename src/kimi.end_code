## [:< ##

# name  = kimi.end_code
# descr = zenka exit : end the acp child, never leave it behind

## no event loop here : cancel, end of input, then a few short waits from ##
## base.interval.next [ type kimi-acp-exit ] before TERM and KILL         ##

my $st = <kimi.acp.state>;
return TRUE if ref $st ne qw| HASH | or not defined $st->{'pid'};
my $pid = $st->{'pid'};

## END also runs in a forked child that inherited this state : only the ##
## process that started the child ends it                               ##
return TRUE if ( $st->{'owner'} // 0 ) != $PROCESS_ID;

if ( $st->{'phase'} eq qw| prompting | and defined $st->{'in'} ) {
    my $line
        = qq|{"jsonrpc":"2.0","method":"session/cancel","params":{"sessionId":"|
        . ( $st->{'session_id'} // '' )
        . qq|"}}\n|;
    syswrite( $st->{'in'}, $line );
}
close $st->{'in'} if defined $st->{'in'};
$st->{'in'} = undef;

my %wait;
for my $signal ( undef, qw| TERM KILL | ) {
    kill $signal, $pid if defined $signal;
    my $delay = <[base.interval.next]>
        ->( { 'type' => qw| kimi-acp-exit |, 'state' => \%wait } );
    select( undef, undef, undef, $delay ) if kill( 0, $pid );
    waitpid( $pid, WNOHANG );
    last if not kill( 0, $pid );
}
return TRUE;

