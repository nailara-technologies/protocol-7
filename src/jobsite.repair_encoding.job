## [:< ##

# name  = jobsite.repair_encoding.job
# descr = check one job record for reversible mojibake
# param = $job [ hash ref, not modified ]
# note  = returns { fixed => { field => text }, repaired, irreversible, examples }

my $job = shift // {};

my $result = {
    'fixed'        => {},
    'repaired'     => 0,
    'irreversible' => 0,
    'multi_pass'   => 0,
    'examples'     => [],
};
return $result if ref $job ne qw| HASH |;

## text fields site-yaml.stepstone.job_from_html takes from the page ##
my @fields = qw| title company city description industry |;

for my $field (@fields) {
    my $value = $job->{$field};
    next if not defined $value or ref $value;

    my $check = <[jobsite.util.repair_mojibake]>->($value);

    if ( $check->{'state'} eq qw| irreversible | ) {
        $result->{'irreversible'}++;
    } elsif ( $check->{'state'} eq qw| repaired | ) {
        $result->{'repaired'}++;
        $result->{'multi_pass'}++ if $check->{'passes'} > 1;
        $result->{'fixed'}{$field} = $check->{'text'};
        push $result->{'examples'}->@*,
            {
            'field'  => $field,
            'passes' => $check->{'passes'},
            <[jobsite.repair_encoding.example]>
                ->( $value, $check->{'text'} )->%*,
            };
    }
}

return $result;

