## [:< ##

# name  = cube.liveness.handler.reply
# descr = reset the miss count when a probed session answers

my $reply         = shift;
my $sid           = $reply->{'params'}{'sid'} // return FALSE;
my $state         = <cube.liveness.state> //= {};
my $session_state = $state->{$sid} // return FALSE;

my $timeout = delete $session_state->{'timeout'};
$timeout->cancel if defined $timeout and $timeout->can(qw| cancel |);
$session_state->{'misses'} = 0;

my $session = $data{'session'}{$sid};
delete $state->{$sid}
    if not defined $session
    or $session->{'mode'} ne qw| client |
    or not grep { ( $data{'route'}{$ARG}{'target'}{'sid'} // -1 ) == $sid }
    values( ( $session->{'route'} // {} )->%* )
    or exists <zenki.heartbeat>->{$sid};

return TRUE;

