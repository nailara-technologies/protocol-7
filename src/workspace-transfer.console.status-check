## [:< ##

# name  = workspace-transfer.console.status-check
# descr = analyze workspace status

## Protocol-7 color scheme ##
my $reset       = "\e[0m";
my $nailara_bg  = "\e[48;2;9;5;42m";
my $blacklight  = "\e[38;2;68;39;172m";
my $TRUE_blue   = "\e[38;2;6;71;195m";
my $neon_orange = "\e[38;2;197;141;7m";
my $neon_green  = "\e[38;2;71;195;6m";
my $neon_red    = "\e[38;2;195;6;71m";

my $ws_dir = workspace_transfer::chdir_workspace();
<[base.exit]>->(qw| 0110 |) unless defined $ws_dir;

# Ensure we're in the right directory
unless ( -f 'README.md' && -d '.git' ) {
    say "";
    say "$neon_orange⚠$reset Invalid workspace directory structure";
    say "";
    <[base.exit]>->(qw| 0110 |);
}

say "";
say "$blacklight" . "=" x 70 . "$reset";
say "$blacklight .:[ ${TRUE_blue}WORKSPACE "
    . "STATUS CHECK${blacklight} ]:.$reset";
say "$blacklight" . "=" x 70 . "$reset";
say "";

my $needs_action = 0;

# Check Git Status
say "$TRUE_blue💾 Git Status$reset";
my $status_count = `git status --short | wc -l`;
chomp $status_count;

if ( $status_count > 0 ) {
    say "   $neon_red⚠$reset "
        . " ${neon_orange}UNCOMMITTED:$reset $status_count files changed";
    say "";
    my @status_lines = `git status --short | head -10`;
    foreach (@status_lines) {
        chomp;
        s|^\s*M\s+|${neon_orange}M$reset |;
        s|^\s*A\s+|${neon_green}A$reset |;
        s|^\s*D\s+|${neon_red}D$reset |;
        s|^\s*\?\?\s+|${blacklight}?$reset |;
        say "      $_";
    }
    if ( $status_count > 10 ) {
        say sprintf "      ${blacklight}... and %d more files$reset",
            ( $status_count - 10 );
    }
    say "";
    say "      ${blacklight}→ Action:$reset ${TRUE_blue}git "
        . "add -A && git commit -m 'description' && git push$reset";
    $needs_action = 1;
} else {
    say "   $neon_green✓$reset ${neon_green}CLEAN:$reset "
        . "No uncommitted changes";
}

# Check Remote Sync
say "";
say "$TRUE_blue🌐 Remote Sync$reset";
system('git fetch origin --quiet 2>/dev/null');

my $branch = `git branch --show-current`;
chomp $branch;
say sprintf "   ${blacklight}📍 Branch:$reset ${neon_orange}%s$reset", $branch;

my $ahead  = `git rev-list origin/$branch..HEAD --count 2>/dev/null`;
my $behind = `git rev-list HEAD..origin/$branch --count 2>/dev/null`;
chomp( $ahead, $behind );

if ( $ahead > 0 ) {
    say sprintf "   $neon_orange⚠$reset "
        . " ${neon_orange}AHEAD:$reset %d commits not pushed",
        $ahead;
    say sprintf "      ${blacklight}→ "
        . "Action:$reset ${TRUE_blue}git push origin %s$reset",
        $branch;
    $needs_action = 1;
} elsif ( $behind > 0 ) {
    say sprintf "   $neon_orange⚠$reset "
        . " ${neon_orange}BEHIND:$reset %d commits on remote",
        $behind;
    say sprintf "      ${blacklight}→ "
        . "Action:$reset ${TRUE_blue}git pull origin %s$reset",
        $branch;
    $needs_action = 1;
} else {
    say "   $neon_green✓$reset ${neon_green}SYNCED:$reset "
        . "Local matches remote";
}

# Check Git Config
say "";
say "$TRUE_blue🔧 Git Configuration$reset";
my $git_user  = `git config user.name`;
my $git_email = `git config user.email`;
chomp( $git_user, $git_email );

if ( $git_user && $git_email ) {
    say sprintf
        "   $neon_green✓$reset ${neon_green}CONFIGURED:$reset %s <%s>",
        $git_user, $git_email;
} else {
    say "   $neon_red⚠$reset "
        . " ${neon_orange}MISCONFIGURED:$reset Git identity not set";
    say "      ${blacklight}→ Action:$reset ${TRUE_blue}Run "
        . "bootstrap or configure-remote-PAT$reset";
    $needs_action = 1;
}

# Quick Stats
say "";
say "$TRUE_blue📊 Repository Stats$reset";
my $total_files   = `find . -type f ! -path './.git/*' | wc -l`;
my $total_commits = `git rev-list --count HEAD 2>/dev/null`;
chomp( $total_files, $total_commits );
say sprintf "   ${blacklight}📁 Files:$reset ${neon_orange}%s$reset",
    $total_files;
say sprintf "   ${blacklight}💾 Commits:$reset ${neon_orange}%s$reset",
    $total_commits;

# Final Recommendation
say "";
say "$blacklight" . "=" x 70 . "$reset";
if ($needs_action) {
    say "$neon_orange⚠$reset  ${neon_orange}ACTION "
        . "REQUIRED$reset - See details above";
} else {
    say "$neon_green✅ ALL SYSTEMS GO!$reset";
    say "";
    say "   ${blacklight}You can now use:$reset";
    say "     ${TRUE_blue}•$reset todo/bug commands for tracking";
    say "     ${TRUE_blue}•$reset checkpoint for quick saves";
}
say "$blacklight" . "=" x 70 . "$reset";
say "";

