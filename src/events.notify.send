## [:< ##

# name   = events.notify.send
# descr  = send one notification to its selected targets
# args   = { level => info|warn|loves, sound => <profile>|none, text,
#          to => notify|session[:name] .. [ default notify ],
#          time [ optional, for the quiet hours ] }
# return = the sound sent [ TRUE-ish ], FALSE for a bad level or no text
#
# the one send path of the events zenka : the notify action plugin and the
# signal map both end here. quiet hours [ notify.map ] turn the sound into
# notify.quiet.sound [ soft or none ]. the alarm loop [ a cue looping until
# the user reacts ] is a later stage : sound=alarm is sent as alert and
# logged. notify.cue decides popup or ticker [ dnd ]

my $n     = shift         // {};
my $level = $n->{'level'} // qw| info |;
my $sound = $n->{'sound'} // qw| none |;
my $text  = $n->{'text'}  // '';
$text =~ s{\s+}{ }g;
$text =~ s{\A | \z}{}g;

return FALSE if $level !~ m{\A(?:info|warn|loves)\z} or !length $text;
$sound = qw| none | if $sound !~ m|\A[a-z]{1,20}\z|;

my $quiet = <[events.notify.map]>->()->{'quiet'};
if ( defined $quiet->{'from'} and $sound ne qw| none | ) {
    my @lt     = CORE::localtime( $n->{'time'} // time );
    my $minute = $lt[2] * 60 + $lt[1];
    my ( $from, $to ) = @{$quiet}{qw| from to |};
    my $in
        = $from <= $to
        ? ( $from <= $minute && $minute < $to )
        : ( $minute >= $from || $minute < $to );
    $sound = $quiet->{'sound'} // qw| none | if $in;
}
if ( $sound eq qw| alarm | ) {
    <[base.log]>
        ->( 1, 'notify : alarm loop is not built yet, alert instead' );
    $sound = qw| alert |;
}

my @to = grep {length} split m{\s+}, $n->{'to'} // qw| notify |;
if ( CORE::grep { $ARG eq qw| notify | } @to ) {
    <[protocol-7.command.send.local]>->(
        {   'command'   => qw| cube.notify.cue |,
            'call_args' => { 'args' => "$level sound=$sound $text" }
        }
    );
}

my @session = map { m{\Asession(?::([\w.-]+))?\z} ? ( $1 // '' ) : () } @to;
if (@session) {
    <[base.perlmod.load]>->('AMOS7::Switch')
        if not <[base.perlmod.loaded]>->('AMOS7::Switch');
    my $relay = <system.root_path> . '/data/development/chat/relay';
    my %relay = map { @{$ARG} } AMOS7::Switch::read_file($relay);
    my $kind
        = defined $relay{'relay.claude.enabled'}
        ? qw| claude |
        : qw| all |;
    my $until = $relay{"relay.$kind.until"} // 0;
    my $off   = ( $relay{"relay.$kind.enabled"} // qw| yes | ) eq qw| no |;
    $off = FALSE if AMOS7::Switch::expired($until);

    <[protocol-7.route-send]>->(
        {   'command' => qw| claude.sessions |,
            'reply'   => {
                'handler' => qw| events.handler.notify_sessions |,
                'params'  => {
                    'text' => $text,
                    'to'   => $session[0],
                    'off'  => $off
                }
            }
        }
    ) if !$off;
}
return $sound;

