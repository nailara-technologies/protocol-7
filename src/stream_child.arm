## [:< ##

# name   = stream_child.arm
# descr  = timer for the next stop step [ base.interval.next ]
# param  = handle
# return = TRUE when armed

## a new serial makes every older timer of the handle a no-op ##

my $handle = shift;
<[stream_child.disarm]>->($handle);
my $type  = $handle->{'interval'}{'stop'} // qw| stream-child-stop |;
my $delay = <[base.interval.next]>
    ->( { 'type' => $type, 'state' => $handle->{'stop_state'} } );
if ( not defined $delay ) {
    <[stream_child.note]>->(
        $handle, qw| error |, { 'text' => "no delay for '$type'" }
    );
    return FALSE;
}
$handle->{'timer'} = <[event.add_timer]>->(
    {   'after'   => $delay,
        'handler' => $handle->{'timer_handler'},
        'data'    => { 'handle' => $handle, 'serial' => $handle->{'serial'} },
        'desc'    => "stream child $handle->{'pid'} stop step"
    }
);
return TRUE;

