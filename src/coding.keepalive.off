## [:< ##

# name   = coding.keepalive.off
# descr  = switch a session's keep-alive off, say why
# args   = name, reason [ the caller saves ]
# return = TRUE when it was on

my ( $name, $why ) = @ARG;
my $r = <[coding.sessions.store]>->()->{$name} // return FALSE;
return FALSE if $r->{'switch'} ne qw| on |;
$r->{'switch'} = qw| off |;
$r->{'note'}   = $why;
delete $r->{'until'};
<[base.logs]>->( 0, ':. keep-alive %s off : %s', $name, $why );
return TRUE;

