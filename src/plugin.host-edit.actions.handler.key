## [:< ##

# name  = plugin.host-edit.actions.handler.key
# descr = host-actions tab key handling -- Enter drives the add-host flow
# param = $editor_state, $field, $key

## plugin.user-edit.key-actions.handler.key's host-edit mirror.  claims
## exactly TWO trigger keys : Enter, for "run / resume the add-host flow", and
## 'c', for "cancel it".  Enter is free to use here for the same reason
## key-actions' own header documents : form.handler.stdin_key's plugin-mode
## block routes EVERY key directly to this sub once the field is entered,
## bypassing editor.control.process_key entirely, so Enter can never fall
## through to a form submit.
##
## Enter is STATE-DRIVEN, off <host-edit.flow>->{<record name>} : no flow at
## all, or one that finished [ step 'done' / 'error' ] -> host-edit.flow.start
## ; step 'need_passphrase' -> a MASKED in-frame editor.control.prompt whose
## submit hands the value to host-edit.flow.  passphrase ; any OTHER running
## step -> swallowed, the flow is already going and must never be started
## twice [ host-edit.flow.start refuses a running flow anyway, but swallowing
## here keeps the refusal silent ].  a start refusal [ ( undef, reason ) --
## e.g. the record has no address ] surfaces on the form status line through
## form.chrome.set_status, the same channel the flow itself reports over.
##
## while a prompt is open every key [ including Ctrl-C, which the prompt
## claims as prompt-cancel ] is delegated to editor.control.prompt.handler.
## key ; a 'cancelled' result backs out of the prompt AND of this tab's
## entered state, back to the focused-but-un-entered row [ same relabel +
## readonly restore key-actions' own handler does ] -- 'cancel the PROMPT
## only', never the form.  Left declines with FALSE -- the 'no further left to
## go' convention stdin_key's plugin-mode Left branch reads as its signal to
## LEAVE plugin mode.  every other key is swallowed as a handled no-op : this
## tab edits no text of its own.

my ( $editor_state, $field, $key ) = @ARG;

return undef if ref $editor_state ne qw| HASH |;

## prompt open : every key belongs to it [ modal -- see header ] ##
if ( ref $editor_state->{'prompt'} eq qw| HASH | ) {

    my $result
        = <[editor.control.prompt.handler.key]>->( $editor_state, $key );

    if ( defined $result and $result eq qw| cancelled | ) {

        ## cancel backs out of the prompt AND of this tab's entered state,
        ## back to the focused-but-un-entered row [ same relabel + readonly
        ## restore stdin_key's Left branch and form.escape's plugin branch do
        ## ] -- 'cancel the PROMPT only', never the form
        $editor_state->{'mode'} = qw| insert |;
        $editor_state->{'fields'}{$field}{'readonly'} = TRUE
            if ref $editor_state->{'fields'}{$field} eq qw| HASH |;
    }

    return TRUE;
}

if ( $key eq "\e[D" or $key eq "\x1b[D" ) {    ## Left : leave plugin mode ##
    return FALSE;
}

my $name = <form.username> // '';
my $flow = ( <host-edit.flow> // {} )->{$name};
my $step = ref $flow eq qw| HASH | ? $flow->{'step'} // '' : '';

if ( $key eq "\n" or $key eq "\r" ) {    ## Enter : run / resume the flow ##

    if ( $step eq qw| need_passphrase | ) {

        ## the owner key waits for its passphrase : MASKED in-frame prompt,
        ## anchored to THIS row ; the record name travels in the prompt's
        ## opaque 'data' slot, the same way key-actions' own passphrase stage
        ## carries the key name
        <[editor.control.prompt.open]>->(
            $editor_state,
            {   qw| field |     => qw| host_actions |,
                qw| label |     => q| owner key passphrase |,
                qw| type |      => qw| masked |,
                qw| on_submit | =>
                    qw| plugin.host-edit.actions.submit_passphrase |,
                qw| data | => { qw| name | => $name },
            }
        );
    } elsif ( not length $step
        or $step =~ m{\A(?:done|error)\z} ) {

        ## the form's CURRENT values travel along : unsaved edits count ##
        my ( $started, $why ) = <[host-edit.flow.start]>->(
            $name, <[host-edit.flow.form_values]>->($editor_state)
        );

        ## a refused start [ no address, invalid name, .. ] reports on the
        ## form status line -- the same channel host-edit.flow.status uses
        <[form.chrome.set_status]>
            ->( sprintf( q|%s : %s|, $name, $why // '?' ) )
            if not $started;
    }

    ## any other running step : claimed, no-op -- see header ##
    return TRUE;
}

if ( $key eq qw| c | ) {    ## c : cancel the flow ##
    <[host-edit.flow.cancel]>->($name);
    return TRUE;
}

return TRUE;                ## every other key : claimed, no-op ##

