# name  = base.callback.reset_strm_size_timer
# descr = reset strm-size idle timeout timer on activity

my $id     = shift;
my $cmd_id = shift;

return
        unless defined $id
    and exists $data{'session'}{$id}
    and defined $cmd_id;

my $session = $data{'session'}{$id};
my $stream  = $session->{'streams'}{$cmd_id};

return unless defined $stream;

## get timeout: declared or default ##
my $timeout = $session->{'strm_size_timeout'} // 12;

## create absolute timer on first call (never reset) ##
unless ( defined $stream->{'timer'}{'absolute_timeout'} ) {
    $stream->{'timer'}{'absolute_timeout'} = <[event.add_timer]>->(
        {   'repeat'  => FALSE,
            'after'   => $timeout,
            'handler' => qw| base.handler.strm_size_absolute_timeout |,
            'data'    => { 'sid' => $id, 'cmd_id' => $cmd_id }
        }
    );
}

## reset idle timer on every call (detects stalls) ##
if ( defined $stream->{'timer'}{'idle_timeout'}
    and not $stream->{'timer'}{'idle_timeout'}->is_cancelled ) {
    $stream->{'timer'}{'idle_timeout'}->cancel;
}

$stream->{'timer'}{'idle_timeout'} = <[event.add_timer]>->(
    {   'repeat'  => FALSE,
        'after'   => $timeout,
        'handler' => qw| base.handler.strm_size_idle_timeout |,
        'data'    => { 'sid' => $id, 'cmd_id' => $cmd_id }
    }
);

return TRUE;

