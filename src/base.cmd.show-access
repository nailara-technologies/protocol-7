## [:< ##

# name  = base.cmd.show-access
# param = [user]
# descr = display command access set-up

my $user = $call->{'args'};

my $usr_re = <regex.base.usr_str>;

return {
    'mode' => qw| false |,
    'data' => sprintf( "'%s' not a valid user name", $user )
    }
    if defined $user
    and $user ne qw| * |
    and $user !~ m|^$usr_re$|
    and $user !~ m|^<$usr_re>$|;

my $special_users = {
    map  { $ARG => $data{'system'}->{$ARG} }
    grep { !m|^amos-zenka-user$| }             ## <-- seperate namespace [LLL]
    grep {m|\-user$|} keys $data{'system'}->%*
};

my @mapped_users;

@mapped_users = map { sprintf qw| <%s> |, $ARG }
    grep { $special_users->{$ARG} eq $user }
    <[base.reverse-sort]>->($special_users)
    if defined $user and $user ne qw| * |;

if ( defined $user ) {
    return {
        'mode' => qw| false |,
        'data' => sprintf( "no permissions set-up for '%s'", $user )
        }
        if not defined <access.cmd.usr>->{$user} and not @mapped_users;

    my @pairs;
    my $map_names = {};
    if ( not defined <access.cmd.usr>->{$user} ) {  ## no custom [$user] rules
        map { $map_names->{$ARG} = sprintf '[ %s <-- %s ]', $user, $ARG }
            @mapped_users;
    } else {
        $map_names->{$user}
            = @mapped_users
            ? sprintf( '[ %s <-- %s ]', $user, join( ', ', @mapped_users ) )
            : '';
    }

    if ( $user ne qw| * | and defined <access.cmd.usr>->{'*'} ) {
        push @pairs,
            [
            qw| * |,
            join(
                ' ',
                <[base.reverse-sort]>->(
                    split m|\s+|, <access.cmd.usr>->{'*'}
                ),
                '[  matches all users  ]'
            )
            ];
    }

    foreach my $map_user (@mapped_users) {

        next if not length <access.cmd.usr>->{$map_user};  ##  none set up  ##

        push @pairs,
            [
            $map_user,
            join(
                ' ',
                <[base.reverse-sort]>->(
                    split m|\s+|, <access.cmd.usr>->{$map_user}
                ),
                $map_names->{$map_user} // ''
            )
            ];
    }

    if ( defined <access.cmd.usr>->{$user} ) {
        push @pairs,
            [
            $user,
            join(
                ' ',
                <[base.reverse-sort]>->(
                    split m|\s+|, <access.cmd.usr>->{$user}
                ),
                $map_names->{$user} // ''
            )
            ];
    }

    ## devcmd axis [ access.devcmd.usr.* -- only folds into the compiled   ##
    ## mask while devmod is loaded on THIS zenka, see base.parser.         ##
    ## access_conf. no special-user template mapping here [ unlike the cmd ##
    ## axis above ] -- not needed by anything using this axis yet.         ##
    if ( exists <access.devcmd.usr> and defined <access.devcmd.usr>->{$user} )
    {
        my $devmod_loaded = <[base.code.exists]>->(qw| devmod.dump |);
        push @pairs,
            [
            sprintf( '%s [devcmd]', $user ),
            join(
                ' ',
                <[base.reverse-sort]>->(
                    split m|\s+|, <access.devcmd.usr>->{$user}
                ),
                $devmod_loaded
                ? '[  folds into mask : devmod loaded  ]'
                : '[  inert here : devmod NOT loaded  ]'
            )
            ];
    }

    return {
        'mode' => qw| size |,
        'data' => <[format.inline-nested.encode]>->(
            \@pairs,
            {   'inline_path' =>
                    sprintf( "access permissions for '%s'", $user ),
                'pad_lines' => TRUE
            }
        )
    };

} elsif ( keys <access.cmd.usr>->%* ) {

    my @pairs = map {
        [   $ARG,
            join( ' ',
                <[base.sort]>->( split( m|\s+|, <access.cmd.usr>->{$ARG} ) ) )
        ]
    } <[base.reverse-sort]>->(<access.cmd.usr>);

    ##  devcmd axis, same simplification as above [ no template mapping ] ##
    if ( exists <access.devcmd.usr> and keys <access.devcmd.usr>->%* ) {
        my $devmod_loaded = <[base.code.exists]>->(qw| devmod.dump |);
        push @pairs, map {
            [   sprintf( '%s [devcmd]', $ARG ),
                join(
                    ' ',
                    <[base.sort]>->(
                        split( m|\s+|, <access.devcmd.usr>->{$ARG} )
                    ),
                    $devmod_loaded
                    ? '[  folds into mask : devmod loaded  ]'
                    : '[  inert here : devmod NOT loaded  ]'
                )
            ]
        } <[base.reverse-sort]>->(<access.devcmd.usr>);
    }

    return {
        'mode' => qw| size |,
        'data' => <[format.inline-nested.encode]>->(
            \@pairs,
            {   'inline_path' =>
                    sprintf( "'%s' command access permissions set-up",
                    <system.zenka.name> ),
                'pad_lines' => TRUE
            }
        )
    };

} else {
    return {
        'mode' => qw| false |,
        'data' => 'no access permissions have been set up'
    };
}

