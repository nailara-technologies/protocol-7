## [:< ##

# name  = osf-cache.fetch.fail
# descr = single fetch failure path : reply and clean up
# param = { fetch_key => <anchor>, reason => <text> }
#
# every failure of the fetch flow funnels through here : the
# lookup-level failures [ osf-cache.fetch.lookup_done ], the root
# agreement failures [ osf-cache.fetch.merkle_eval : 'merkle
# conflict' \ 'merkle unavailable' \ a tree that does not match the
# index ], the leaf-list exhaustion [ osf-cache.fetch.leaves_next ],
# holder exhaustion [ osf-cache.fetch.holder_fail ], the partial
# open \ write \ rename errors and the whole-file verification [
# osf-cache.fetch.complete ]. EXACTLY ONE reply goes out mode false
# with the reason through base.callback.cmd_reply [ which resolves
# the <base.cmd_reply> entry itself ]. the cleanup is total [ stage
# 4 step 10 ] : the phase timer AND every per-holder timer are
# cancelled, the partial fh closed, the partial file unlinked [ the
# cache dir never sees an unverified byte ] and the per-anchor state
# deleted - a failed fetch leaves nothing behind either.

my $args      = shift                // {};
my $fetch_key = $args->{'fetch_key'} // return;
my $reason    = $args->{'reason'}    // 'fetch failed';

my $state = <osf-cache.fetch.pending>->{$fetch_key};
return unless ref $state eq qw| HASH |;

if ( defined $state->{'fh'} ) {
    close( $state->{'fh'} );
    delete $state->{'fh'};
}

if ( defined $state->{'timer'}
    and eval { $state->{'timer'}->is_active } ) {
    $state->{'timer'}->cancel;
}

foreach my $hs ( values %{ $state->{'hs'} // {} } ) {
    if ( defined $hs->{'timer'}
        and eval { $hs->{'timer'}->is_active } ) {
        $hs->{'timer'}->cancel;
    }
}

unlink $state->{'partial'}
    if length( $state->{'partial'} // '' )
    and -e $state->{'partial'};

if ( length( $state->{'reply_id'} // '' ) ) {
    <[base.callback.cmd_reply]>->(
        $state->{'reply_id'},
        {   'mode' => qw| false |,
            'data' => $reason
        }
    );
}

delete <osf-cache.fetch.pending>->{$fetch_key};

return;

