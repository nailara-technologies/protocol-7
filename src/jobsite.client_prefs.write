## [:< ##

# name  = jobsite.client_prefs.write
# descr = persist browser-shared client prefs blob

my $prefs = shift // {};
return FALSE if ref $prefs ne 'HASH';

my $yaml;
eval { $yaml = YAML::XS::Dump($prefs) };
if ($@) {
    <[base.logs]>->( 0, 'jss.client_prefs.write: serialize error: %s', $@ );
    return FALSE;
}

my $written
    = <[file.zenka_dir.write]>->( 'client-prefs.yaml', \$yaml, '>', 0640 );
return defined $written;

