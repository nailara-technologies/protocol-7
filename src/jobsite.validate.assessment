## [:< ##

# name  = jobsite.validate.assessment
# descr = validate assessment result for data quality defects

my $result  = shift // '';
my $reason  = shift // '';
my $summary = shift // '';

my @defects;

## check empty fields ##
push @defects, qw| empty_reason |
    unless length( $reason // '' ) > 0;
push @defects, qw| empty_summary |
    unless length( $summary // '' ) > 0;

## language heuristics on combined text ##
my $text = "$reason $summary";

## english detection: common english stop-words that are unlikely in german ##
## job-assessment text. requires at least 2 matches for confidence.         ##
my @en_markers = qw| the and for with you your this that job work experience
    skills team company position role remote location salary benefits |;
my $en_hits = 0;
for my $word (@en_markers) {
    $en_hits++ if $text =~ m{\b$word\b}i;
}

## german counter-signals : if these are present, likely correct language ##
my @de_markers = qw| der die das und für mit ist sind bei einem eine
    arbeit erfahrung kenntnisse team firma stelle remote standort |;
my $de_hits = 0;
for my $word (@de_markers) {
    $de_hits++ if $text =~ m{\b$word\b}i;
}

## flag as english if strong english signals and weak german signals    ##
push @defects, qw| wrong_language_english |
    if $en_hits >= 2 and $de_hits < 2;

## chinese detection: han unicode range                                 ##
push @defects, qw| wrong_language_chinese |
    if $text =~ m|\p{Han}|;

## optional assertion validation : yaml or json structured output ##
my $looks_structured = $result =~ m{^\s*score\s*:}m
    || $result =~ m{^\s*\{.*\}\s*$}s;
if ( $looks_structured and $result !~ m{assertions\s*:} ) {
    push @defects, qw| missing_assertions |;
}

return {
    'is_valid' => scalar(@defects) == 0,
    'defects'  => \@defects,
};

