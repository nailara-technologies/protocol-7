## [:< ##

# name = menu-commands.update-menu
# descr = Notify protocol-7-menu of menu update (handler-based fetch pattern)

# Generate timestamp reference for this update
my $update_timestamp = <[base.ntime.b32]>;

my $item_count = scalar keys <menu-commands.mappings>->%*;   # [LLL] use ->$#*

<[base.logs]>->(
    1,           "[protocol-7-menu] notifying : %d menu items [%s]",
    $item_count, $update_timestamp
);

##[ sending notification to protocol-7-menu with : ]##
# - provider name: menu-commands
# - reference: timestamp [ allows protocol-7-menu to fetch when ready ]
# - reply handler: protocol-7-menu will call get-provider-data to fetch the YAML
my $client_count = <[protocol-7.command.send.local]>->(
    {   'command'   => qw| cube.protocol-7-menu.menu-update-notify |,
        'call_args' =>
            { 'args' => sprintf( 'menu-commands %s', $update_timestamp ) },
        'reply' =>
            { 'handler' => qw| menu-commands.handler.menu-update-reply | }
    }
);

### evalutate return code ###  [ number of clients notified ]
##
if ( $client_count == 0 ) {
    <[base.log]>->(
        1, '[[cannot_notify]] protocol-7-menu zenka not present ..'
    );
    return FALSE;
} elsif ( $client_count == -2 ) {
    <[base.s_warn]>->('[ protocol-7-menu ] protocol mismatch <{C1}>');
    return undef;
} elsif ( $client_count > 0 ) {
    <[base.log]>->( 2, "[protocol-7-menu] notified successfully =)" );
    return TRUE;
} else {
    warn '[ protocol-7-menu ] unexpected return value';
    return undef;
}
##

