## [:< ##

# name = v7-zenki.handler.get_display_reply

my $reply    = shift;
my $cube_sid = $reply->{'params'}{'cube_sid'};

## <x11.display> used to be a flat scalar [pre-multi-instance]; a running ##
## v7 process that hasn't been restarted since may still hold that old    ##
## value in memory -- coerce to a hashref rather than crashing on it.     ##
<x11.display> = {} if ref(<x11.display>) ne qw| HASH |;

if ( $reply->{'cmd'} eq qw| TRUE | and defined $cube_sid ) {
    <x11.display>->{$cube_sid} = $reply->{'call_args'}->{'args'};
    <[base.log]>->(
        1,
        "received x11.display from X-11 zenka [cube_sid=$cube_sid]., ["
            . <x11.display>->{$cube_sid} . "]"
    );
} elsif ( defined $cube_sid ) {
    ## xorg mode refuses until access control is enforced : ask again ##
    my $attempt = ( $reply->{'params'}{'attempt'} // 0 ) + 1;
    if ( $attempt > 60 ) {
        <[base.logs]>->(
            0, 'x11.display not received from X-11 [cube_sid=%s]', $cube_sid
        );
        return;
    }
    <[base.logs]>->(
        2,         'x11.display refused [cube_sid=%s] : retry %d',
        $cube_sid, $attempt
    );
    <[event.add_timer]>->(
        {   'after'   => 1,
            'handler' => qw| v7-zenki.handler.get_display_retry |,
            'data'    => { 'cube_sid' => $cube_sid, 'attempt' => $attempt },
        }
    );
}

