## [:< ##

# name  = editor.control.scalar.summary
# descr = the ':..15.chars..:' text a collapsed scalar field draws
# param = $text [ , $noun_opts ]

## third of the three collapse summaries this shape now has -- exact
## structural counterpart to editor.control.list.summary's own
## ':..2.entries..:' and editor.control.multiline.summary's own
## ':..3.lines..:' : same wrap, same dot-joined count+noun shape, factored out
## for the same reason both of those are : editor.ui.ascii_frame.  render_form
## is the only caller, and a second implementation of the same sentence would
## drift. counts CHARACTERS, not lines or entries -- the generic per-field
## measure any scalar field already has, regardless of what it happens to
## hold. 'chars', not the full word -- per user, shorter reads better here
## than it would for 'entries'/'lines', which stay spelled out
##
## $noun_opts [ optional, same { noun, noun_plural, noun_singular } shape
## list.summary's field_def keys already use ] overrides the noun ONLY --
## still a character count underneath either way. added for a masked field's
## collapsed view : render_form passes it the RANDOMIZED display value
## [ editor.control.get_display_value's variable star-count-per-character ],
## so the number is a star total, not the real password length -- but 'chars'
## reads as a length regardless of what it is actually counting. 'entries',
## per user, does not carry that implication

my ( $text, $noun_opts ) = @ARG;

my $count = length( $text // '' );

my $noun
    = ref $noun_opts eq qw| HASH |
    ? $noun_opts->{'noun'} // qw| char |
    : qw| char |;
my $plural
    = ref $noun_opts eq qw| HASH |
    ? $noun_opts->{'noun_plural'} // qw| s |
    : qw| s |;
my $singular
    = ref $noun_opts eq qw| HASH |
    ? $noun_opts->{'noun_singular'} // ''
    : '';

my $summary
    = $count
    ? sprintf( '%d.%s%s',
    $count, $noun, <[base.cnt_s]>->( $count, $plural, $singular ) )
    : sprintf( 'no.%s%s', $noun, $plural );

return sprintf( ':..%s..:', $summary );

