# name  = X-11.cmd.get_pointer_pos
# descr = return current pointer screen coordinates as x y

my %ptr = eval { <X-11.obj>->QueryPointer( <X-11.obj>->root ) };
return { 'mode' => qw| false |, 'data' => 'QueryPointer failed' }
    if $EVAL_ERROR
    or not defined $ptr{'root_x'};

return {
    'mode' => qw| true |,
    'data' => "$ptr{root_x} $ptr{root_y}"
};

