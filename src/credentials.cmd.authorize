## [:< ##

# name  = credentials.cmd.authorize
# descr = add a zenka to a credential's authorized list

my $args = $call->{'args'} // '';

return { 'mode' => qw| false |, 'data' => 'missing arguments' }
    unless length $args;

my ( $cred_name, $zenka_name ) = split m|\s+|, $args, 2;

return { 'mode' => qw| false |, 'data' => 'missing credential name' }
    unless length $cred_name;
return { 'mode' => qw| false |, 'data' => 'missing zenka name' }
    unless length $zenka_name;

my $cred = <[credentials.load]>->($cred_name);
return {
    'mode' => qw| false |,
    'data' => "unknown credential '$cred_name'"
    }
    unless defined $cred;

my @authorized = @{ $cred->{'authorized_zenki'} // [] };

if ( grep { $ARG eq $zenka_name } @authorized ) {
    return {
        'mode' => qw| true |,
        'data' => "'$zenka_name' already authorized for '$cred_name'"
    };
}

push @authorized, $zenka_name;
$cred->{'authorized_zenki'} = \@authorized;

my $saved = <[credentials.save]>->($cred);

return { 'mode' => qw| false |, 'data' => 'failed to save credential' }
    unless $saved;

return {
    'mode' => qw| true |,
    'data' => "'$zenka_name' authorized for '$cred_name'"
};

