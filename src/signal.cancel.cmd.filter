## [:< ##

# name  = signal.cancel.cmd.filter
# param = [file path]
# descr = emit only unmatched log lines (anomaly surface)

my $args  = $call->{'args'} // '';
my $input = '';

if ( length $args and -f $args ) {
    $input = <[file.read]>->($args) // '';
} else {
    local $/ = undef;
    $input = <STDIN> // '';
}

my @lines = split( m|\n|, $input );
my @unmatched;

foreach my $line (@lines) {
    next if not length $line;
    my $result = <[signal.cancel.match]>->($line);
    push @unmatched, $line if not $result->{'matched'};
}

my $output = join( "\n", @unmatched );
$output .= "\n" if length $output;

return {
    'mode' => qw| size |,
    'data' => $output
};

