## [:< ##

# name  = editor.control.prompt.handler.key
# descr = key handling for an open in-frame prompt [ modal ]
# param = $editor_state, $key

## the INPUT half of the in-frame prompt primitive.  the host routes keys here
## while $editor_state->{'prompt'} is set [ for user-edit that is every key
## arriving in plugin mode, via the anchoring plugin's own handler.key ].  the
## prompt is MODAL : every key is claimed, most are no-ops.
##
## return contract :
##   FALSE       -- no prompt open, the caller routes the key normally
##   TRUE        -- claimed [ includes a submit whose chain closed quietly ]
##   'cancelled' -- this key CANCELLED the prompt [ Esc-equivalents : Left,
##                  Ctrl-C ] -- the caller may want to back out of whatever
##                  mode it entered to open the prompt
##
## CANCEL KEYS : Esc [ via user-edit.form.escape's prompt branch -- a bare Esc
## never reaches here as a resolved key, see handler.esc_timeout ] and Ctrl-C,
## claimed EXPLICITLY as "\x03" : without this branch a Ctrl-C mid-prompt
## would propagate as process_key's advisory 'signal' action and user-edit.
## handler.stdin_key's signal branch would quit the WHOLE form via user-edit.
## form.quit -> base.exit, where the user only meant to back out of the prompt
## [ confirmed live against that branch ].
##
## Left is NOT an unconditional cancel key any more -- found live, 2026-08-16
## : cancelling on every Left made it lose whatever had already been typed on
## nothing more than an ordinary cursor-navigation keystroke, a real foot-gun
## mid-name-entry.  Left now moves the cursor left WHILE THE BUFFER STILL HAS
## CONTENT [ same "reuse editor.control.commands.move_cursor" shape ordinary
## fields already get, via a pseudo-state exactly like prompt.render/.
## cursor_char's own ], and only falls through to cancel once the buffer is
## genuinely EMPTY -- the same threshold Backspace below already respects, so
## nothing typed can ever be lost by Left alone, only by backspacing all the
## way to nothing [ or Esc/Ctrl-C, still unconditional ].  gated on buffer
## CONTENT, deliberately not cursor position : a user who navigates to column
## 0 without deleting anything must still be able to press Left once more
## without losing the text.
##
## REENTRANCY GUARD [ the busy flag, design anchor 4 ] : a submit callback is
## free to call code that briefly RE-PUMPS the event loop [ crypt.C25519.
## gen_keys's harmonic-truth retry loop calls <[event.once]>, which is a real
## Event::loop(), not a sleep ].  a keypress arriving in such a window
## re-enters this very handler while the FIRST submit is still running -- the
## busy flag, set on the prompt for exactly the callback's duration, turns
## that reentrant dispatch into a harmless no-op instead of arming a second
## submit on a half-consumed buffer.

my ( $editor_state, $key ) = @ARG;

return FALSE if ref $editor_state ne qw| HASH |;

my $prompt = $editor_state->{'prompt'};
return FALSE if ref $prompt ne qw| HASH |;

my $buffer = $prompt->{'buffer'};
return FALSE if ref $buffer ne qw| HASH |;

## reentrant keypress mid-submit [ see header ] : swallow ##
return TRUE if $prompt->{'busy'};

if ( $key eq "\x03" ) {    ## Ctrl-C : unconditional cancel, see header ##
    <[editor.control.prompt.cancel]>->($editor_state);
    return qw| cancelled |;
}

if ( $key eq "\e[D" or $key eq "\x1b[D" ) {    ## Left ##

    if ( length( $buffer->{'text'} // '' ) > 0 ) {
        ## buffer still has content : navigate, never lose it -- same       ##
        ## primitive ordinary fields use, via the                           ##
        ## prompt.render/.cursor_char pseudo-state shape [ move_cursor only ##
        ## needs 'fields'{$name} ]                                          ##
        my $pseudo_state = { qw| fields | => { qw| prompt | => $buffer } };
        <[editor.control.commands.move_cursor]>->(
            $pseudo_state, qw| prompt |, -1
        );
        return TRUE;
    }

    ## buffer is genuinely empty : same cancel as Esc/Ctrl-C ##
    <[editor.control.prompt.cancel]>->($editor_state);
    return qw| cancelled |;
}

if ( $key eq "\n" or $key eq "\r" ) {    ## Enter : submit ##

    my $submit_sub = $prompt->{'on_submit'} // '';
    my $value      = $buffer->{'text'}      // '';

    if ( length $submit_sub and exists $code{$submit_sub} ) {

        ## set BEFORE the callback, cleared straight after -- see header ##
        $prompt->{'busy'} = TRUE;
        $code{$submit_sub}->( $editor_state, $value, $prompt );
        $prompt->{'busy'}
            = FALSE;    ## harmless if the callback replaced/closed it ##
    }
    return TRUE;
}

if ( $key eq "\x7f" or $key eq "\x08" ) {    ## Backspace ##
    my $cursor = $buffer->{'cursor'} // 0;
    <[editor.buffer.memory.delete]>->( $buffer, $cursor - 1, $cursor )
        if $cursor > 0;
    return TRUE;
}

if ( $key eq "\e[3~" or $key eq "\x1b[3~" ) {    ## Delete : same, forward ##
    my $cursor = $buffer->{'cursor'} // 0;
    <[editor.buffer.memory.delete]>->( $buffer, $cursor, $cursor + 1 );
    return TRUE;
}

## printable input : one decoded character [ possibly multi-byte ] -- the   ##
## negative test, not a length test : every escape sequence starts with ESC ##
## and every control key with a byte below 0x20, so anything else arriving  ##
## here is text [ editor.buffer.memory.insert utf8::decodes it itself ]     ##
if ( $key !~ m|[\x00-\x1f\x7f]| and $key !~ m|^\e| ) {
    <[editor.buffer.memory.insert]>->( $buffer, undef, $key );
    return TRUE;
}

return TRUE;    ## anything else [ arrows, Tab, .. ] : claimed no-op ##

