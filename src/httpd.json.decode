## [:< ##

# name  = httpd.json.decode
# descr = decode JSON string to perl data structure [ delegates to format.json ]
# param = $json_string - JSON encoded string
# return = perl data structure or empty hashref on error

return <[format.json.decode]>->(shift);

0;

