## [:< ##

# name  = X-11.handler.monitor_settle_check
# descr = re-verify the monitor registry once notifications stop arriving

## screen-change notifications can stop arriving before the topology has    ##
## actually reached its FINAL state [ observed live: registry stayed on     ##
## stale flat-2-monitor values while a fresh connection immediately saw the ##
## correct, already-settled 3-monitor vertical-offset layout - no further   ##
## notification ever arrived to trigger the rebuild that would have caught  ##
## it ]. X-11.handler.screen_change [re]schedules this as a debounced       ##
## one-shot after each notification, so only the LAST one in a burst        ##
## actually fires this check.                                               ##

delete <X-11.monitor_settle_timer>;

return unless <X-11.has_randr>;

my $before_count = scalar @{ <X-11.monitors> // [] };

<[X-11.build_monitor_registry]>;

my $after_count = scalar @{ <X-11.monitors> // [] };

<[base.logs]>->(
    1, ': monitor settle-check : registry confirmed [ %d device%s ]',
    $after_count, <[base.cnt_s]>->($after_count)
) if $after_count != $before_count;

<[X-11.WM.update]>;

## windows' own notification platform has been observed stuck with toasts   ##
## silently accepted-but-never-shown after a monitor topology churn [ the   ##
## master 'notifications' toggle, HKCU ToastEnabled -- separate from focus  ##
## assist/dnd -- getting left disabled ; confirmed live 2026-08-24, not     ##
## confirmed to be CAUSED by the topology change itself, but the check-     ##
## then-fix recovery is a no-op when already enabled, so firing it here is  ##
## cheap insurance ]. only relevant on a WSLg host with the 'powershell'    ##
## windows-bridge zenka available at all -- most deployments of this        ##
## codebase are plain linux desktops with no windows host to bridge to, and ##
## 'powershell' is on-demand with a short [147s] idle timeout, so an        ##
## unconditional call here would wake-and-drop it for nothing on every one  ##
## of those. auto-detected when unset, overridable either way via           ##
## X-11.notify_recover.enabled -- base.cfg_bool defaults an undef input to  ##
## FALSE rather than passing undef through, so definedness is checked       ##
## before it, not after, to still fall through to auto-detection when unset ##
my $notify_recover_enabled_cfg = <X-11.notify_recover.enabled>;
my $notify_recover_enabled
    = defined $notify_recover_enabled_cfg
    ? <[base.cfg_bool]>->($notify_recover_enabled_cfg)
    : ( defined $ENV{'WSL_DISTRO_NAME'} or -d '/mnt/wslg' ) ? 1
    :                                                         0;

if ($notify_recover_enabled) {
    ## cooldown-guarded the same way as the display-switch toggle in ##
    ## X-11.handler.screen_change, on its own timer so the two don't ##
    ## couple.                                                       ##
    my $notify_recover_cooldown_s = <X-11.notify_recover.cooldown_s> // 30;
    my $now                       = <[base.time]>->(3);
    if ( not defined <X-11.notify_recover.cooldown_until>
        or $now >= <X-11.notify_recover.cooldown_until> ) {
        <X-11.notify_recover.cooldown_until>
            = $now + $notify_recover_cooldown_s;
        <[protocol-7.command.send.local]>
            ->( { 'command' => qw| cube.powershell.notify-recover | } );
    }
}

