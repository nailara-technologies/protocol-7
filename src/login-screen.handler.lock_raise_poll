# name  = login-screen.handler.lock_raise_poll
# descr = fallback : re-raise the lock window every 0.5 s while locked

return FALSE if <login-screen.state> ne qw| locked |;
return TRUE  if defined <login-screen.lock.raise_timer>;
<login-screen.lock.raise_timer> = Glib::Timeout->add(
    500,
    sub {
        if ( <login-screen.state> ne qw| locked | ) {
            <login-screen.lock.raise_timer> = undef;
            return FALSE;
        }
        my $window     = <login-screen.window> // return TRUE;
        my $gdk_window = $window->get_window();
        $gdk_window->raise() if defined $gdk_window;
        return TRUE;
    }
);
TRUE;

