## [:< ##

# name  = base.perlmod.runtime_use
# descr = Use Module::Runtime::use_module() to load modules with proper
#         namespace access This handles modules that don't work with
#         Module::Load-based autoload/load Automatically registers the
#         loaded module in Protocol-7's module system

my $module_name = shift // '';

if ( not length $module_name ) {
    warn 'expected module name parameter <{C1}>';
    return undef;
}

##  Module::Runtime::use_module() to load the module with namespace access  ##
my $name_loaded = eval { Module::Runtime::use_module($module_name) };

if (   length $EVAL_ERROR
    or not defined $name_loaded
    or $name_loaded ne $module_name ) {
    <base.perlmod.loaded>->{$module_name} = FALSE;  ## declaring NOT loaded ##
    <[base.s_warn]>->(
        "cannot load '$module_name' [ %s ]",
        <[base.str.eval_error]>
    );
    return FALSE;
}

##  Register the module in Protocol-7's tracking system  ##
<[base.perlmod.register_loaded_module]>->($module_name);

return TRUE;

