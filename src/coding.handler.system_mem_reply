# name  = coding.handler.system_mem_reply
# descr = handle async response from system.memory.cmd.mem-used, cache memory stats

my $reply    = shift;
my $data_str = $reply->{'call_args'}->{'args'} // '';

## parse percentage value from response [ format: '42.13%' ]
if ( $data_str =~ m|^(\d+(?:\.\d+)?)%?$| ) {
    my $pct = $1 + 0;
    <coding.system_mem_pct>      = $pct;
    <coding.system_mem_pct_time> = <[base.ntime]>;
    <[base.logs]>->( 3, 'system memory usage cached :. %.2f%% used', $pct );
} else {
    <[base.logs]>->( 1, 'unexpected memory stats format :. %s', $data_str );
}

return TRUE;

