## [:< ##

# name  = base.handler.hooks.unregister
# descr = Unregister hooks from a session

## unregister hooks from a session  Args: session_id, [hook_type]  If
## hook_type not specified, removes all hooks

my ( $sid, $hook_type ) = @ARG;
return FALSE unless defined $sid;
return FALSE unless defined $data{'session'}{$sid};

if ( defined $hook_type ) {
    delete $data{'session'}{$sid}{'hooks'}{$hook_type};
} else {
    delete $data{'session'}{$sid}{'hooks'};
}

return TRUE;

