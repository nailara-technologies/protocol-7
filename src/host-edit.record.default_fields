## [:< ##

# name  = host-edit.record.default_fields
# descr = the field set a freshly created host record starts with
# param = $name

my ($name) = @ARG;

## a record named after its host starts with that name as its address -- shown
## in the form, editable like any other entry
my @addresses = <[host-edit.record.name_is_host]>->($name) ? ($name) : ();

return {
    qw| name |       => $name // '',
    qw| addresses |  => \@addresses,
    qw| link_user |  => '',
    qw| ssh |        => '',
    qw| ssh_port |   => '',
    qw| transports | => [qw| tcp |],
    qw| af |         => qw| auto |,    ## LINK-ZENKI-AND-TRANSPORTS.md : ##
    ## auto | 4 | 6 ##
    ## a by-hand pin to adopt once [ link.pin.migrate ] ##
    qw| pin_from |  => '',
    qw| owner |     => '',    ## the owner PIN name [ client trust ] ##
    qw| owner_key | => '',    ## the local owner KEY that certifies ##
    qw| roles |     => [],
};

