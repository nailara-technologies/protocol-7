## [:< ##

# name   = invoke-web.activity.touch
# descr  = mark invoke.ai activity now [ output lines, database writes from
#          ui use ] -- the drain timer counts idle time from here
# param  = [ source : output | db ]

<invoke-web.activity.last>   = <[base.time]>->(0);
<invoke-web.activity.source> = shift // qw| output |;

