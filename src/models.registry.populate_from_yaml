# name  = models.registry.populate_from_yaml
# descr = Populate registry from models.yaml with checksum calculation

my $models_defs = <models.definitions>;
my $registry    = <models.registry> // {};

foreach my $model_id ( keys %$models_defs ) {
    my $model = $models_defs->{$model_id};

    next unless -f $model->{path};

    # Calculate checksums
    my $checksums = <[models.checksum.calculate_all]>->( $model->{'path'} );

    unless ( $checksums && $checksums->{success} ) {
        <[base.logs]>->( 0, "[models] Cannot checksum %s", $model_id );
        next;
    }

    ## composite key : path_checksum:model_checksum, same shape as the      ##
    ## discovered-model path builds, so all list/select code that expects a ##
    ## colon-joined checksum id treats yaml and discovered entries          ##
    ## identically                                                          ##
    my $path_checksum  = <[models.checksum.from_path]>->( $model->{'path'} );
    my $model_checksum = <[models.checksum.from_metadata]>->(
        {   'model_id'     => $model_id,
            'name'         => $model->{name},
            'quantization' => $model->{quantization} // 'unknown',
            'size_gb'      =>
                sprintf( qw| %.3f |, ( -s $model->{path} ) / ( 1024**3 ) ),
            'is_vision' => $model->{is_vision} // FALSE
        }
    );

    unless ( defined $path_checksum && defined $model_checksum ) {
        <[base.logs]>->(
            0, "[models] Cannot compute composite checksum for %s", $model_id
        );
        next;
    }

    my $composite_id = "$path_checksum:$model_checksum";

    # Create registry entry
    $registry->{$composite_id} = {
        amos       => $composite_id,              ## composite checksum key ##
        model_id   => $model_id,                  ## short yaml name ##
        amos_7     => $checksums->{'amos_7'},
        bmw_l13    => $checksums->{'bmw_l13'},
        bmw_base32 => $checksums->{'bmw_base32'},
        name       => $model->{name},
        path       => $model->{path},
        mmproj     => $model->{mmproj},
        quantization => $model->{quantization},
        context_size => $model->{metadata}{context_size} // 5005,
        is_vision    => $model->{is_vision}              // FALSE,
        size_gb => sprintf( qw| %.3f |, ( -s $model->{path} ) / ( 1024**3 ) ),
        source  => qw| yaml |,
        registered_at => <[base.ntime]>
    };
}

<models.registry> = $registry;

return { success => TRUE, count => scalar( keys $registry->%* ) };

