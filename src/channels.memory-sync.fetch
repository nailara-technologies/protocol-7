## [:< ##

# name  = channels.memory-sync.fetch
# descr = fetch key-value data from memory-sync channel store

my $params = shift // {};

my $channel = $params->{'channel'} // qw| default |;
my $key     = $params->{'key'}     // '';

return { 'mode' => qw| false |, 'data' => 'key required' }
    unless length $key;

<channels.memory_sync_store> //= {};

my $store = <channels.memory_sync_store>->{$channel} // {};
my $entry = $store->{$key};

return { 'mode' => qw| false |, 'data' => 'not found' }
    unless defined $entry;

return {
    'mode' => qw| true |,
    'data' => $entry->{'data'}
};

