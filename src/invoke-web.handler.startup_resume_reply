# name  = invoke-web.handler.startup_resume_reply
# descr = queue resumed after the startup pause [ start_paused = startup ]

my $reply = shift // {};
<[base.logs]>->(
    $reply->{'ok'} ? 1 : 0,
    'queue resumed after startup%s',
    $reply->{'ok'} ? '' : " failed [ $reply->{'status'} ] -- still paused"
);

