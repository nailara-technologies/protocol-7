## [:< ##

# name = web.template_cache.set
# descr = Store rendered template with timestamp and TTL
#
# Parameters:
#   $ARG[0] - Cache key (required)
#   $ARG[1] - Content to cache (required)
#   $ARG[2] - TTL in seconds (optional, defaults to web.cfg.cache_ttl)
#
# Returns:
#   On success: { status => 'success', stored => 1, size => ..., ttl => ... }
#   On error:   { status => 'error', stored => 0, message => ... }

my $cache_key = shift;
my $content   = shift;
my $ttl       = shift;

## get configuration ##
my $default_ttl = <web.cfg.cache_ttl>         // 1800;
my $max_size    = <web.cfg.template_max_size> // ( 5 * 1024 * 1024 );

## validate params ##
unless ( defined $cache_key && length $cache_key ) {
    return {
        status  => qw| error |,
        message => 'Cache key required',
        stored  => 0,
    };
}

unless ( defined $content ) {
    return {
        status  => qw| error |,
        message => 'Content required',
        stored  => 0,
    };
}

## use provided ttl or default [ validate numeric to avoid warnings ] ##
$ttl = $default_ttl unless defined $ttl && $ttl =~ m|\A[1-9][0-9]*\z|;

## check size limit ##
my $content_size = length($content);
if ( $content_size > $max_size ) {
    return {
        status  => qw| error |,
        message =>
            "Content exceeds max size ($content_size > $max_size bytes)",
        stored   => 0,
        size     => $content_size,
        max_size => $max_size,
    };
}

## ensure cache structure exists ##
<web.template_cache> = {}
    unless defined <web.template_cache>;

## store entry ##
<web.template_cache>->{$cache_key} = {
    content   => $content,
    timestamp => time(),
    ttl       => $ttl,
    size      => $content_size,
};

## update metrics ##
<web.metrics.templates_cached>++
    if defined <web.metrics.templates_cached>;

return {
    status    => qw| success |,
    message   => "Cached $content_size bytes with ttl=$ttl",
    stored    => 1,
    cache_key => $cache_key,
    size      => $content_size,
    ttl       => $ttl,
};

