## [:< ##

# name  = invoke-web.cmd.pause
# descr = pause the invoke.ai queue [ running item finishes ]

my $result = <[invoke-web.api]>->(
    qw| PUT |, qw| /api/v1/queue/default/processor/pause |
);

return {
    mode => qw| false |,
    data => sprintf( 'pause failed [ %s ]', $result->{'status'} )
    }
    if not $result->{'ok'};

return { mode => qw| size |, data => "invoke.ai queue paused\n" };

