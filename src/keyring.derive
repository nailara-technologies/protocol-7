#\\\|LLQWLIDDCO4YQTMO3DGJ3GNPDNDFY3UBSPYUOCP25LPC7EYYXFN \ / AMOS7 \ YOURUM ::
#\[7]GSGU24KPPNU35FXMATXB3LSDO2EV3FEDR75WRF2MVO6KBGIQDICI 7  DATA SIGNATURE ::
