## [:< ##

# name  = storchencam.util.loop_wait
# descr = process network events while waiting

my $tw = shift // 0;
my $ts = <[base.time]>->(3);
while ( <[base.time]>->(3) - $ts < $tw ) {
    <[event.once]>->($tw);
    SDL::delay( $tw * 100 );
}

