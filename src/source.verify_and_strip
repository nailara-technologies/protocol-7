## [:< ##

# name  = source.verify_and_strip
# descr = verify a data signature and restore the unsigned payload
# args  = <payload>, [ <key> ], [ <footer> ], [ <cached> ]
# return = { status, body, footer, report, error }

my $payload_sref = shift;
my $key_name     = shift // <source.C25519.signature_key_name>;
my $footer       = shift;
my $cached_valid = shift // FALSE;

return {
    qw| status | => qw| invalid |,
    qw| error  | => qw| payload-reference |
    }
    if ref $payload_sref ne qw| SCALAR |
    or not defined $payload_sref->$*;

## generated envelope : the opening line stays in the signed payload ; only ##
## the comment closer is removed before the shared AMOS7 parser runs. the   ##
## unsigned capture is restored after all checks succeed.                   ##
my ( $generated, $generated_error )
    = <[source.generated_envelope]>->($payload_sref);
return {
    qw| status | => qw| invalid |,
    qw| body   | => $payload_sref,
    qw| error  | => $generated_error
    }
    if defined $generated_error;

if ( defined $generated ) {
    $generated->{'original_ref'} = $payload_sref;
    my $signed
        = $generated->{'unsigned_body'}
        . $generated->{'opening'}
        . $generated->{'standard_footer'};
    $payload_sref                        = \$signed;
    $key_name                            = qw| generated.verify |;
    $keys{'C25519'}{$key_name}{'public'} = $generated->{'public_key'};
}

$footer //= <[source.extract_sig_body]>
    ->( $payload_sref, qw| strip |, qw| strict | );

return {
    qw| status | => qw| unsigned |,
    qw| body   | => $payload_sref,
    qw| footer | => $footer
    }
    if defined $footer and not $footer->{'was-present'};

return {
    qw| status | => qw| invalid |,
    qw| footer | => $footer,
    qw| error  | => qw| footer-extraction |
    }
    if not defined $footer;

my $error = $footer->{'encountered-error'};
$error //= qw| separator-endline | if $footer->{'needs_separator_endline'};
$error //= qw| footer-structure |  if not $footer->{'structure-was-valid'};

return {
    qw| status | => qw| invalid |,
    qw| body   | => $payload_sref,
    qw| footer | => $footer,
    qw| error  | => $error
    }
    if defined $error;

my ( $valid, $report )
    = $cached_valid
    ? ( TRUE, { qw| persistent-cache | => TRUE } )
    : <[source.signature_valid]>->( $payload_sref, $footer, {}, $key_name );

if ( not $valid ) {
    $report //= {};
    my $check = qw| truth-check |;
    $check = qw| AMOS-checksum |
        if exists $report->{'AMOS-chksum-matches'}
        and not $report->{'AMOS-chksum-matches'};
    $check = qw| BMW-checksum |
        if exists $report->{'bmw-chksum-matches'}
        and not $report->{'bmw-chksum-matches'};
    $check = qw| signature |
        if exists $report->{'signature-is-valid'}
        and not $report->{'signature-is-valid'};
    return {
        qw| status | => qw| invalid |,
        qw| body   | => $payload_sref,
        qw| footer | => $footer,
        qw| report | => $report,
        qw| error  | => $check
    };
}

if ( defined $generated ) {
    $generated->{'original_ref'}->$* = $generated->{'unsigned_body'};
    $payload_sref = \$generated->{'unsigned_body'};
}

return {
    qw| status | => qw| valid |,
    qw| body   | => $payload_sref,
    qw| footer | => $footer,
    qw| report | => $report,
    (   defined $generated
        ? ( qw| generator_public_key | => $generated->{'public_key'},
            qw| generator_chain      | => $generated->{'chain'}
            )
        : ()
    )
};

