## [:< ##

# name  = coding.tools.handler.ask_user_choice
# descr = ask user to pick from pre-generated options, with batching support

my $args = shift // {};

my $question = $args->{'question'} // return 'question required';
my $options  = $args->{'options'}  // return 'options array required';
my $urgent   = $args->{'urgent'}   // 0;

return 'options must be a non-empty array'
    unless ref $options eq qw| ARRAY | and scalar @$options;

my $target = qw| protocol-7-menu.cmd.input-choice |;

## urgent items ask now; everything else queues for checkpoint flush ##
if ($urgent) {
    return 'input-choice dialog module is not loaded'
        unless <[base.code.exists]>->($target);

    my $payload
        = { 'args' => JSON::PP::encode_json( [ $question, $options ] ) };
    my $result = eval { $code{$target}->($payload) };

    return sprintf "dialog failed: %s", $@ if $@;

    if (    ref $result eq qw| HASH |
        and $result->{'mode'} eq qw| true |
        and defined $result->{'data'} ) {
        my $answer = $result->{'data'};
        <[coding.tools.handler.write_answered_note]>->(
            {   'question' => $question,
                'answer'   => $answer,
            }
        );
        return $answer;
    }

    my $detail
        = ( ref $result eq qw| HASH | )
        ? ( $result->{'data'} // 'cancelled' )
        : 'unknown';
    return 'no selection: ' . $detail;
}

## non-urgent: accumulate in %data queue for later batch flush ##
<coding.pending_questions> //= [];

my $entry = {
    'id'       => <[base.ntime]>,
    'type'     => qw| choice |,
    'question' => $question,
    'options'  => $options,
};

push <coding.pending_questions>->@*, $entry;

return sprintf "queued non-urgent question [ %d pending ]",
    scalar <coding.pending_questions>->@*;

