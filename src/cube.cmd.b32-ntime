## [:< ##

# name  = cube.cmd.b32-ntime
# descr = decode BASE-32 to numerical network time

my $param  = $call->{'args'} // '';
my $B32_re = <regex.base.base_32>;

return {
    'mode' => qw| false |,
    'data' => 'expected BASE-32 encoded network time'
    }
    if $param !~ m|^$B32_re{1,22}$|;

## the charset/length check above accepts anything base32-shaped, including
## e.g. a full log-entry id [ ntime + a uniqueness suffix, concatenated before
## encoding ] -- this shape check rejects that before it ever reaches
## base.ntime_BASE32_to_numerical's own deep validation, which assumes
## well-formed input and warns loudly instead of failing quietly -- see
## base.ntime.b32_is_shape_valid's module note
return {
    'mode' => qw| false |,
    'data' => 'BASE32 decoding error [ timestamp not valid ]'
    }
    if not <[base.ntime.b32_is_shape_valid]>->($param);

my $ntime_value = <[base.ntime_BASE32_to_numerical]>->($param);

return {
    'mode' => qw| false |,
    'data' => 'BASE32 decoding error [ timestamp not valid ]'
    }
    if not defined $ntime_value
    or $ntime_value !~ m|^\d+(\.\d+)?$|;

return { 'mode' => qw| true |, 'data' => $ntime_value };

