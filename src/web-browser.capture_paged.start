## [:< ##

# name  = web-browser.capture_paged.start
# descr = entry point for the paged multi-position capture loop. called from
#         web-browser.callback.load_finished when the slideshow is running
#         and paged capture is armed. queries scroll_max, scroll position and
#         viewport height in one JS round trip, then hands off to the result
#         callback to compute the position list.

return unless <web-browser.capture.paged.armed>;

my $fg_index = <web-browser.overlay.index.fg> // 1;
my $view     = <web-browser.gtk_obj.view>->{$fg_index};

return unless defined $view;

my $settings = $view->get_settings();

if ( !$settings->get_enable_javascript() ) {
    <[base.logs]>->(
        0, "capture_paged.start: javascript disabled, skipping paged capture"
    );
    <[web-browser.capture_paged.advance]>;
    return;
}

<[web-browser.js_call]>->(
    'String( document.documentElement.scrollHeight - window.innerHeight '
        . ') + ":" + window.scrollY + ":" + window.innerHeight',
    $code{'web-browser.callback.capture_paged_query_result'}, undef
);

