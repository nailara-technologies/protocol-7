## [:< ##

# name  = jobsite.cmd.rescue-http
# param = <id> [stage]
# descr = http-facing rescue : replies strm+json, not true/false
#         same restore logic as jobsite.cmd.rescue -- the httpd
#         web-relay reply handler only builds a real HTTP response for a
#         strm [ or legacy SIZE ] reply, a true/false reply 502s over that
#         path. POST body, plain text, same format as the console command

my $args = $call->{'args'} // '';
$args =~ s{^\s+|\s+$}{}g;

my ( $id_in, $target_stage ) = split m|\s+|, $args, 2;
$target_stage //= 'review';

my $result = <[jobsite.job.rescue]>->( $id_in, $target_stage );

my $json = eval {
    JSON::XS::encode_json(
        {   'ok' => $result->{'ok'} ? JSON::XS::true() : JSON::XS::false(),
            'message' => $result->{'message'},
        }
    );
} // '{"ok":false,"message":"encode failed"}';

return {
    'mode'         => qw| strm |,
    'data'         => $json,
    'content_type' => qw| application/json |,
};

