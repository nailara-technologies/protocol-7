## [:< ##

# name = base.get_path.perl_exec
# note = see 'man perlvar' [$EXECUTABLE_NAME] for why this subroutine exists =)

my $perl_path;

eval {
    use Config;
    $perl_path = $Config{'perlpath'};
    if ( $^O ne qw| VMS | ) {
        $perl_path .= $Config{'_exe'}
            unless $perl_path =~ m|\Q$Config{_exe}\E$|i;
    }
};

if ( not defined $perl_path ) {
    warn 'failed to acquire perl bin path from Config module';
} elsif ( $perl_path ne <system.perl_execname> ) {
    <[base.s_warn]>->(
        '< security > %s and %s differ <<!>> <{C1}>',
        $Config{'perlpath'}, $EXECUTABLE_NAME
    );
}

return $perl_path // <system.perl_execname>;

