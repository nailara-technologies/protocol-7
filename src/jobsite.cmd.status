## [:< ##

# name  = jobsite.cmd.status
# descr = show current cycle state and job counts

## count from filesystem index                         ##
## [ authoritative,  same source as jobsite.progress ] ##
my %counts;
my $idx = <jobsite.job.index> // {};
for my $id ( keys %{$idx} ) {
    my $st = $idx->{$id} // '';
    $st =~ s{^(blocked|deleted|trash):.*}{$1};
    $counts{$st}++ if length $st;
}
my $total = scalar keys %{$idx};

my $last = <jobsite.last_scan> // 0;
my $age
    = $last
    ? <[base.parser.duration]>->($last)
    : qw| none |;

my @lines = "\n .: jobsite scan :.\n :";
push @lines, sprintf ' :  cycle        : %s', <jobsite.cycle> // qw| idle |;
push @lines, sprintf ' :  last scan    : %s', $age;
push @lines, sprintf ' :  total        : %d', $total;
push @lines, sprintf ' :  threshold    : %s', <jobsite.cfg.threshold> // 7;

## the fetch path : a fetch host out of reach fails every import while the ##
## cycle itself still reads 'idle' and a fresh 'last scan'                 ##
my $fetch_zenka = <jobsite.cfg.fetch_zenka> // qw| site-yaml |;
if ( $fetch_zenka ne qw| site-yaml | ) {
    push @lines, ' :';
    push @lines, sprintf ' :  fetch via    : %s', $fetch_zenka;

    my $retry = <jobsite.fetched.retry_timer>;
    my $stream
        = <jobsite.fetched.subscribed>  ? qw| open |
        : <jobsite.fetched.subscribing> ? qw| subscribing |
        : ( defined $retry
            and $retry->can(qw| is_active |)
            and $retry->is_active ) ? sprintf( 'retrying [ refused : %s ]',
        <jobsite.fetched.last_refusal> // '?' )
        : 'closed [ next import subscribes ]';
    push @lines, sprintf ' :  stream       : %s', $stream;
}

my $fetch = <jobsite.last_fetch>;
if ( ref $fetch eq qw| HASH | ) {
    my $outcome
        = $fetch->{'failed'}
        ? sprintf( '%d of %d imports FAILED [ %s ]',
        $fetch->{'failed'}, $fetch->{'replies'}, $fetch->{'why'} // '?' )
        : sprintf( '%d imports ok', $fetch->{'replies'} );
    push @lines, sprintf ' :  last fetch   : %s', $outcome;
}
push @lines, ' :';
for my $st ( <[base.sort]>->( keys %counts ) ) {
    push @lines, sprintf ' :  %-12s : %d', $st, $counts{$st};
}
push @lines, ' :.';

return { 'mode' => 'size', 'data' => join( "\n", @lines ) . "\n" };

