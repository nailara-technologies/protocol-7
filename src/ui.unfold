## [:< ##

# name  = ui.unfold
# descr = render an address in its expanded form for the given slot budget
# param = { address, slot_budget => { cols, rows } }

my $address     = $ARG[0]->{'address'}     // '';
my $slot_budget = $ARG[0]->{'slot_budget'} // {};

## the raw args string ui.cmd.ui-show received, unparsed -- forwarded to a
## zenka-specific override below [ "[ 2 ] specific ui-show command" ] so it
## isn't dropped. optional : any OTHER existing caller of ui.unfold that
## doesn't pass this gets undef here, same as before this field existed, so
## this is purely additive
my $raw_args = $ARG[0]->{'raw_args'};

return { 'mode' => qw| false |, 'data' => 'address required' }
    if not length $address;

## [ 1 ] custom renderer
my $custom = "$address.ui.render.default";
if ( defined $code{$custom} ) {
    my $rendered
        = eval { $code{$custom}->( { 'slot_budget' => $slot_budget } ) }
        // '';
    return { 'mode' => qw| true |, 'data' => $rendered };
}

## [ 2 ] specific ui-show command
my $cmd = "$address.cmd.ui-show";
if ( defined $code{$cmd} ) {
    ## called with the ORIGINAL raw args string, not bare -- found live :
    ## calling this with zero arguments silently handed the override an undef
    ## $call->{'args'} regardless of what the original caller typed, which for
    ## cred-mesh.cmd.ui-show meant session_id/view could never resolve and
    ## per-session UI state could never be found afterward [
    ## data/tasks/credential-fabric-ui-interactive.md ]
    my $result
        = eval { $code{$cmd}->($raw_args) }
        // { 'mode' => qw| false |, 'data' => '' };
    return $result if ref $result eq 'HASH' and exists $result->{'data'};
    return { 'mode' => qw| true |, 'data' => $result };
}

## [ 3 ] fallback renderer
my $field_map
    = defined $code{"$address.ui.fields"}
    ? $code{"$address.ui.fields"}->()
    : <[ui.fields.fallback]>;
my $caller_level = <[ui.caller.security-level]>;

my $filtered = {};
for my $field_name ( keys %$field_map ) {
    my $field = $field_map->{$field_name};
    next if ref $field ne 'HASH';
    my $level = $field->{'level'} // 0;
    next if $level > $caller_level;
    $filtered->{$field_name} = $field;
}

my $rendered = eval {
    <[ui.render.fallback]>->(
        {   'address'     => $address,
            'fields'      => $filtered,
            'slot_budget' => $slot_budget
        }
    );
} // '';

return { 'mode' => qw| true |, 'data' => $rendered };

