## [:< ##

# name  = credentials.audit
# descr = append audit log entry with timestamp, zenka, credential, decision

my $zenka_name = shift // '';
my $cred_name  = shift // '';
my $decision   = shift // '';

return undef
    unless length $zenka_name
    and length $cred_name
    and length $decision;

my $audit_path = <credentials.cfg.audit_log>;
my $store_dir  = <credentials.cfg.store_dir>;

## ensure audit log directory exists ##
if ( not -d $store_dir ) {
    eval {
        require File::Path;
        File::Path::make_path( $store_dir, { mode => 0700 } );
    };
}

my $timestamp = <[base.ntime]>;

## ISO-8601-ish format ##
my $log_line = sprintf( "%s  %-15s  %-15s  %s\n",
    $timestamp, $zenka_name, $cred_name, $decision );

eval {
    open my $fh, qw| >> |, $audit_path
        or die $!;
    print {$fh} $log_line;
    close($fh);
};

if ($@) {
    <[base.logs]>->( 0, 'credentials: audit log write failed: %s', $@ );
    return undef;
}

chmod 0600, $audit_path if -f $audit_path;

return TRUE;

