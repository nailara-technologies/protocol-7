## [:< ##

# name  = base.file.open
# args  = <file_path>[, <encoding>][, <mode>][, <create>[, perm]]
# descr = returns file handle of to be opened file

my $requested_file_path = File::Spec->canonpath( shift // '' );
my @encoding = ( shift // '' );    # optional encoding type [ i.e. ':raw' ]
my $mode     = shift // qw| < |;
my $create   = shift // FALSE;
my $perm     = shift // 0664;

$perm = oct($perm) if index( $perm, qw| 0 |, 0 ) == 0;

## sysopen FILEHANDLE,FILENAME,MODE,PERMS ##

if ( not length $requested_file_path ) {
    <[base.log]>->(
        0, '< file.open > expected <filename> argument ' . <[base.caller]>
    );
    return undef;
}

my $created = FALSE;    ## this call created the file [ may remove it ] ##
if ( $create and not -f $requested_file_path ) {    ##  create file  ##
    if ( not sysopen( my $fh, $requested_file_path, O_CREAT(), $perm ) ) {
        <[base.s_warn]>->(
            "cannot create file '%s' [ %s ]",
            $requested_file_path, <[base.str.os_err]>
        );
        return undef;
    } elsif ( not close($fh) ) {
        <[base.s_warn]>->(
            "error at close() call on '%s' [ %s ]",
            $requested_file_path, <[base.str.os_err]>
        );
        return undef;
    }
    $created = TRUE;
}

if ( $mode eq qw| < | and not -f $requested_file_path ) {
    <[base.logs]>->(
        0, "< file.open > file '%s' not found %s",
        $requested_file_path, <[base.str.os_err]>, <[base.caller]>
    );
    return undef;
}

## write modes : the file's permissions are set BEFORE the open -- a        ##
## truncating open came first and a failed chmod then refused the write     ##
## with the content already gone, and removed even a file this call had not ##
## created : httpsd updating a session the web zenka owns wiped the session ##
## [ 2026-10-23 ]. a file that cannot get the permissions is refused        ##
## untouched [ fail-closed ] ; only a file this call created is removed     ##
## again                                                                    ##
my $write_mode = index( $mode, qw| < | ) == -1;
my $perm_set   = sub {
    sprintf( '%#o', File::stat::stat($requested_file_path)->mode & 0777 ) eq
        sprintf( '%#o', $perm )
        or chmod( $perm, $requested_file_path );
};
my $refuse = sub {
    <[base.logs]>->(
        0, "< file.open > cannot chmod[%#o] file '%s' [ %s ] %s",
        $perm, $requested_file_path, <[base.str.os_err]>,
        scalar <[base.caller]>
    );
    if ( $created and index( $mode, qw| >> | ) == -1 ) {
        unlink($requested_file_path)    ## remove file again ##
            or <[base.s_warn]>->(
            'unlink[%s] %s',
            $requested_file_path, <[base.str.os_err]>
            );
    }
    return undef;
};

my $existed = -f $requested_file_path;
return $refuse->() if $write_mode and $existed and not $perm_set->();

my $req_file_fh;
if (not
    open( $req_file_fh, join( ' ', $mode, @encoding ), $requested_file_path )
    or not fileno $req_file_fh ) {
    <[base.logs]>->(
        0, "< file.open > cannot to open file '%s' [ %s ] %s",
        $requested_file_path, <[base.str.os_err]>, scalar <[base.caller]>
    );
    return undef;
}

## the open itself created it [ no create flag ] : set the permissions now, ##
## the file is this call's to remove                                        ##
if ( $write_mode and not $existed ) {
    $created = TRUE;
    if ( not $perm_set->() ) {
        close $req_file_fh;
        return $refuse->();
    }
}

return $req_file_fh;

