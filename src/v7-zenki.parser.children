## [:< ##

# name = v7-zenki.parser.children

my $instance_id = shift;

return ''
    if not exists
    <v7-zenki.zenka.instance>->{$instance_id}->{'process'}->{'child'};

return join( ', ',
    sort keys %{ <v7-zenki.zenka.instance>->{$instance_id}{'process'}{'child'}
    } );

