# name  = invoke-web.cmd.gpu-lease-granted
# descr = models granted invoke-web sole gpu residency

<invoke-web.gpu_lease.holder>           = qw| invoke-web |;
<invoke-web.gpu_lease.request_inflight> = FALSE;
<invoke-web.gpu_lease.unavailable>      = FALSE;
<invoke-web.gpu_lease.handover_waiting> = FALSE;
<[invoke-web.gpu_lease.handler.renew]>;
<[base.logs]>->( 1, ': gpu lease acquired' );
if (<invoke-web.gpu_lease.start_waiting>) {
    delete <invoke-web.gpu_lease.start_waiting>;
    <[invoke-web.cmd.start]>->( { 'args' => '' } );
} elsif (<invoke-web.gpu_lease.auto_paused>) {
    <invoke-web.gpu_lease.auto_paused> = FALSE;
    <[invoke-web.api_async]>->(
        'PUT', '/api/v1/queue/default/processor/resume',
        undef, 'invoke-web.gpu_lease.handler.queue_resume_reply'
    );
}
return { 'mode' => qw| true |, 'data' => qw| done | };

