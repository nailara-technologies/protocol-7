## [:< ##

# name  = amos-term.cmd.list_attachments
# descr = List all clients attached to a buffer

my $buffer_id = $call->{'args'} // 'current';
$buffer_id =~ s{^\s+|\s+$}{}g;

## === resolve buffer === ##
my $window;
if ( $buffer_id eq 'current' ) {
    ## use nshell's current attachment ##
    my $nshell_amos = <nshell.state>->{'amos_term'}->{'amos_id'};
    return { 'mode' => 'false', 'data' => 'no current buffer attachment' }
        unless defined $nshell_amos;
    $window = <amos-term.windows.by_id>
        ->{ <amos-term.windows.by_amos>->{$nshell_amos} };
} elsif ( $buffer_id =~ m|^amos:([A-Z0-9]{10})$|i ) {
    my $amos_id = uc($1);
    my $sid     = <amos-term.windows.by_amos>->{$amos_id};
    return { 'mode' => 'false', 'data' => 'buffer not found' }
        unless defined $sid;
    $window = <amos-term.windows.by_id>->{$sid};
} else {
    $window = <amos-term.windows.by_id>->{$buffer_id};
}

return { 'mode' => 'false', 'data' => 'buffer not found' }
    unless defined $window;

## === list attachments === ##
my @attachments
    = $window->{'attachments'} ? $window->{'attachments'}->@* : ();

my $output = sprintf(
    "Buffer: %s [%s]\n%d active attachment(s):\n",
    $window->{'client_name'},
    $window->{'amos_id'}, scalar(@attachments)
);

foreach my $attach_id (@attachments) {
    my $attach = <amos-term.buffer-attachments>->{$attach_id};
    next unless defined $attach;

    $output .= sprintf(
        "  %-20s | %-10s | cursor(%d,%d,%d) | %s\n",
        $attach_id,
        $attach->{'client_type'},
        $attach->{'cursor'}->{'x'},
        $attach->{'cursor'}->{'y'},
        $attach->{'cursor'}->{'z'},
        $attach->{'mode'}->{'write'} ? 'RW' : 'RO'
    );
}

return { 'mode' => 'size', 'data' => $output };

