## [:< ##

# name  = cred-mesh.ui.render.rotation_log
# descr = render the rotation log frame

my $params = shift // {};

my $entry = <[ascii.frame.load]>->('credential-fabric/rotation-log');
return { 'rendered' => '', 'row_keys' => [] } if not defined $entry;

my $focus_index = $params->{'focus_index'};

my $data = <[cred-mesh.ui.query.rotation_log]>;

my $descriptor;
if ( exists $entry->{'descriptor'} ) {
    $descriptor = $entry->{'descriptor'};
} elsif ( exists $entry->{'descriptors'} ) {
    my $mode = $entry->{'modes'}[0] // 'expanded';
    $descriptor = $entry->{'descriptors'}{$mode};
}
return { 'rendered' => '', 'row_keys' => [] }
    if not defined $descriptor;

my $rotations = $data->{'rotations'} // [];
my $count     = scalar @$rotations;

my @lines;
my @row_keys;
my $row_idx = 0;
for my $r (@$rotations) {
    my $row = sprintf( '%s  %s  by:%s  result:%s',
        $r->{'ntime_b32'}, $r->{'slot'}, $r->{'actor'}, $r->{'result'} );

    push @row_keys, $r->{'slot'};

    if ( defined $focus_index and $row_idx == $focus_index ) {
        $row = "\e[7m" . $row . "\e[27m";
    }

    push @lines, $row;
    $row_idx++;
}

my $block = @lines ? join( "\n", @lines ) : '';

my %values = (
    LOG_COUNT       => $count,
    ROTATIONS_BLOCK => $block,
);

my $rendered = <[ascii.frame.render]>->(
    {   descriptor => $descriptor,
        values     => \%values,
    }
);

return {
    'rendered' => $rendered // '',
    'row_keys' => \@row_keys,
};

