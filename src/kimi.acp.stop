## [:< ##

# name   = kimi.acp.stop
# descr  = end the child cleanly, escalate if it stays
# return = TRUE | FALSE [ nothing running ]

## session/cancel when a prompt runs, stdin closed                          ##
## [ the child ends on end of input ], a timer from base.interval.next then ##
## TERM, then KILL [ kimi.handler.acp_stop_timer ]. queued prompts are      ##
## dropped                                                                  ##

my $st = <[kimi.acp.state]>;
return FALSE if $st->{'phase'} eq qw| stopped |;
return TRUE  if $st->{'stopping'};

$st->{'stopping'} = TRUE;
my $dropped = scalar @{ $st->{'queue'} };
$st->{'queue'} = [];
<[kimi.acp.event]>->( qw| stop |, "stopping [ $dropped queued dropped ]" );

if ( $st->{'phase'} eq qw| prompting | and defined $st->{'session_id'} ) {
    <[kimi.acp.write]>->(
        {   'method' => qw| session/cancel |,
            'params' => { 'sessionId' => $st->{'session_id'} }
        }
    );
}
## the queued bytes first, then end of input ##
<[kimi.acp.flush]>;
my $watcher = delete $st->{'watchers'}{'in'};
eval { $watcher->cancel } if defined $watcher;
close $st->{'in'}         if defined $st->{'in'};
$st->{'in'} = undef;

my $delay = <[base.interval.next]>
    ->( { 'type' => qw| kimi-acp-stop |, 'state' => $st->{'stop_state'} } );
$st->{'stop_timer'} = <[event.add_timer]>->(
    {   'after'   => $delay,
        'handler' => qw| kimi.handler.acp_stop_timer |,
        'data'    => {},
        'desc'    => 'kimi acp child stop escalation'
    }
);
return TRUE;

