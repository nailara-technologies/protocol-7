## [:< ##

# name  = jobsite.handler.fetch-drain
# descr = called when site-yaml fetch queue drains : pull strays then assess

<[base.logs]>->( 1, 'fetch queue drained, claiming strays' );

<[jobsite.stray.check]>;
<[jobsite.dispatch.assessments]>;

return;

