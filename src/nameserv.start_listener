## [:< ##

# name  = nameserv.start_listener
# descr = start the dns udp listener (called by init_code)

## one udp socket per configured address [ 'nameserv.bind.addr' : a list,   ##
## e.g. '0.0.0.0 ::' for ipv4 + ipv6 -- the glue of a delegated name server ##
## announces both, resolvers may ask over either ]                          ##
require IO::Socket::IP;    ## ipv4 + ipv6 [ IO::Socket::INET is ipv4 only ] ##

my @addrs = grep {length} split m|[\s,]+|,
    <nameserv.bind.addr> // '127.0.0.1';
<nameserv.sockets> = [];

## an ipv4 address beside an ipv6 one : the ipv6 socket must be v6-only ##
my $has_v4 = grep { index( $ARG, qw| : | ) < 0 } @addrs;

for my $addr (@addrs) {
    my $is_v6 = index( $addr, qw| : | ) >= 0;
    my $open  = sub {
        IO::Socket::IP->new(
            LocalHost => $ARG[0],
            LocalPort => <nameserv.bind.port>,
            Proto     => 'udp',
            ReuseAddr => 1,
            ReusePort => 1,
            (   index( $ARG[0], qw| : | ) >= 0
                ? ( V6Only => $has_v4 ? 1 : 0 )
                : ()
            ),
        );
    };
    my $sock = $open->($addr);

    ## like httpd [ io.ip.tcp.input.open ] : no ipv6 on this host -> the ##
    ## ipv4 wildcard, not an error                                       ##
    if ( not defined $sock and $is_v6 and $addr =~ m|^[0:]+$| and !$has_v4 ) {
        <[base.logs]>->(
            1, 'IPv6 wildcard not available - retrying with 0.0.0.0'
        );
        $addr = '0.0.0.0';
        $sock = $open->($addr);
    }
    if ( not defined $sock ) {
        <[base.logs]>->(
            0,     "cannot bind dns socket %s : %s",
            $addr, <[base.str.os_err]>
        );
        next;
    }

    push <nameserv.sockets>->@*, $sock;
    <[event.add_io]>->(
        {   fd      => $sock,
            poll    => 'r',
            handler => qw| nameserv.handler.query |,
            desc    => "dns query handler [ $addr ]"
        }
    );
    <[base.logs]>->(
        1,     ": dns listener started on %s:%d",
        $addr, <nameserv.bind.port>
    );
}

## first socket : the one older code refers to ##
<nameserv.socket> = <nameserv.sockets>->[0];

return <nameserv.socket>;

