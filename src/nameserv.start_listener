# name  = nameserv.start_listener
# descr = start the dns udp listener (called by init_code)

my $sock = IO::Socket::INET->new(
    LocalAddr   => <nameserv.bind.addr>,
    LocalPort   => <nameserv.bind.port>,
    Proto       => 'udp',
    ReuseAddr   => 1,
    ReusePort   => 1,
    ReuseSocket => TRUE,
    )
    or do {
    <[base.logs]>->( 0, "cannot bind dns socket: %s", <[base.str.os_err]> );
    return;
    };

<nameserv.socket> = $sock;

<[event.add_io]>->(
    {   fd      => $sock,
        poll    => 'r',
        handler => qw| nameserv.handler.query |,
        desc    => 'dns query handler'
    }
);

<[base.logs]>->(
    1,                    ": dns listener started on %s:%d",
    <nameserv.bind.addr>, <nameserv.bind.port>
);

return $sock;

