# name  = v7-zenki.callback.cleanup_instance_cache
# descr = called when <v7-zenki.process.instance_cache> entries created \ accessed

<v7-zenki.timer.reset_instance_cache>->cancel
    if defined <v7-zenki.timer.reset_instance_cache>
    ##  moving timer  ##
    and <v7-zenki.timer.reset_instance_cache>->is_active;

<v7-zenki.timer.reset_instance_cache> = <[event.add_timer]>->(
    {   'after'   => 5,
        'repeat'  => 0,
        'prio'    => 7,
        'handler' =>
            qw| v7-zenki.callback.delete_instance_cache |    ## cache reset ##
    }
);

