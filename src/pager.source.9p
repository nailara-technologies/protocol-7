## [:< ##

# name  = pager.source.9p
# descr = Pager data source: 9P filesystem

my ($args) = @ARG;

my $location   = $args->{'location'};    # p7://9p:host/mnt/path
my $batch_size = $args->{'batch_size'} // 100;
my $filters    = $args->{'filters'}    // {};

# Parse P7REF
my $p7ref;
if ( $location && $location =~ m|^p7://| ) {
    my $parse_result
        = <[plugin.storage.p7ref.parse]>->( { 'p7ref' => $location } );
    $p7ref = $parse_result->{'data'}
        if ref($parse_result) eq 'HASH'
        && $parse_result->{'mode'} eq 'true';
}

my $mount_point;
if ( $p7ref && $p7ref->{'type'} eq '9p' ) {

    # Ensure 9P is mounted
    $mount_point = <[storage.9p.mount]>->(
        {   'authority' => $p7ref->{'authority'},
            'path'      => $p7ref->{'address'},
        }
    );
}

return undef unless $mount_point && -d $mount_point;

# Use storage.9p.scan for enumeration
my $queue  = [];
my $buffer = [];
my $cursor = 0;
my $done   = 0;

return {
    'type'     => '9p',
    'location' => $location,
    'mount'    => $mount_point,
    'total'    => undef,          # Unknown
    'cursor'   => 0,
    'filters'  => $filters,

    'next_batch' => sub {
        my $batch = [];

        # Fill buffer from scan if needed
        if ( !@$buffer && !$done ) {
            my $scan_result = <[storage.9p.scan]>->(
                {   'name'          => $p7ref->{'authority'} // '',
                    'path'          => $p7ref->{'address'}   // '/',
                    'max_results'   => $batch_size * 2,
                    'inclusion_add' => $filters->{'include'} // [],
                    'exclusion_add' => $filters->{'exclude'} // [],
                }
            );

            if ( ref($scan_result) eq 'HASH'
                && $scan_result->{'mode'} eq 'true' ) {
                $buffer = $scan_result->{'data'} // [];
                $done   = 1 if @$buffer < $batch_size * 2;
            } else {
                $buffer = [];
                $done   = 1;
            }
        }

        # Return batch from buffer
        while ( @$buffer && @$batch < $batch_size ) {
            my $entry = shift @$buffer;
            my $type
                = (
                $entry->{'qid'}
                    && ( $entry->{'qid'}{'type'}
                    & <plan-9.protocol.constants.QTDIR> )
                )
                ? 'dir'
                : 'file';

            push @$batch,
                {
                'path'  => $entry->{'path'},
                'name'  => $entry->{'name'},
                'size'  => $entry->{'length'} // $entry->{'size'} // 0,
                'mtime' => $entry->{'mtime'},
                'type'  => $type,
                'mode'  => $entry->{'mode'},
                };
            $cursor++;
        }

        return $batch;
    },

    'get_item_at' => sub {

        # 9P doesn't support efficient random access without full index
        return undef;
    },

    'close' => sub {

        # Unmount if we mounted it
        <[storage.9p.umount]>->( { 'mount_point' => $mount_point } )
            if $p7ref;
    },
};

