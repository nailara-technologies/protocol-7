# name  = web.jobs.sync_ui_authorized
# descr = check a bearer token against the primary ui sync role

my $token = shift // '';
return FALSE if not length $token;
my $allowed = <web.cfg.jobs_sync_ui_tokens> // '';
for my $candidate ( split m|\s+|, $allowed ) {
    return TRUE if length $candidate and $candidate eq $token;
}
return FALSE;

