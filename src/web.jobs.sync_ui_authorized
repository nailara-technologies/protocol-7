# name  = web.jobs.sync_ui_authorized
# descr = check a bearer token's verified user for the ui sync role
# note  = the token is verified like every web token [ only its hash is
#         stored ] ; its user must be listed in web.cfg.jobs_sync_ui_users
#         [ host config, eg jobsite-replica ] -- no token copy in config,
#         a rotation touches only the replica [ v7-zenki.jobsite-sync-token ]

my $token = shift // '';
return FALSE if not length $token;

my $allowed = <web.cfg.jobs_sync_ui_users> // '';
return FALSE if not length $allowed;

my $session = <[plugin.web.auth.verify_session]>->($token);
return FALSE if ref $session ne qw| HASH |;

my $user_id = $session->{'user_id'} // '';
return FALSE if not length $user_id;

for my $candidate ( split m|\s+|, $allowed ) {
    return TRUE if length $candidate and $candidate eq $user_id;
}
return FALSE;

