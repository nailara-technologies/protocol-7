## [:< ##

# name  = invoke-web.cmd.start
# descr = start the invoke.ai web server process
# param = [ force : skip the memory guard ]

my $status = <invoke-web.status> // 'idle';
my $pid    = <invoke-web.pid>;

## already running or starting : report and return
if ( $status eq 'running' or $status eq 'starting' ) {
    return {
        mode => qw| size |,
        data => sprintf(
            "invoke.ai already %s [pid:%s]\n", $status, $pid // '-'
        )
    };
}

my $binary = <invoke-web.binary>;
my $root   = <invoke-web.root>;

## verified while still root [ init_code ] : an unprivileged -e would fail ##
## below a 700 home directory even when the binary is present              ##
unless (<invoke-web.binary_ok>) {
    <[base.logs]>->( 0, 'binary not usable [ %s ]', $binary // 'undef' );
    return { mode => qw| false |, data => 'binary not usable' };
}

## start memory guard [ coding zenka pattern ] : when the dependency    ##
## objects [ free RAM \ VRAM ] are not satisfied the start is queued   ##
## through invoke-web.handler.start_guard instead of refused -- it      ##
## proceeds by itself once memory frees up. 'start force' skips this    ##
my $force = ( $call->{'args'} // '' ) =~ m{(?:^|\s)force(?:\s|$)} ? TRUE : FALSE;

if ( $force and defined <invoke-web.start_waiting> ) {
    ## drop the queued wait : starting now ##
    delete <invoke-web.start_waiting>;
    my $guard_timer = delete <invoke-web.timer.start_guard>;
    $guard_timer->cancel if defined $guard_timer and ref $guard_timer;
}

if ( not $force and defined <invoke-web.dep.memory_system> ) {
    my $ram_dep = <invoke-web.dep.memory_system>;
    my $gpu_dep = <invoke-web.dep.memory_gpu>;
    my $ram_ok  = defined $ram_dep ? <[dependency.ok]>->($ram_dep) : TRUE;
    my $gpu_ok  = defined $gpu_dep ? <[dependency.ok]>->($gpu_dep) : TRUE;

    if ( not $ram_ok or not $gpu_ok ) {
        my $mem = <[invoke-web.memory_free]>;
        my $mem_str = sprintf "ram  : %d MB free [ need %d MB ]\n"
            . "vram : %s free [ need %d MB ]\n",
            $mem->{'ram_free_mb'},
            $mem->{'ram_need_mb'},
            defined $mem->{'vram_free_mb'}
            ? $mem->{'vram_free_mb'} . ' MB'
            : '?',
            $mem->{'vram_need_mb'};

        ## a start is already queued : report it, don't queue twice ##
        if ( defined <invoke-web.start_waiting> ) {
            return {
                mode => qw| size |,
                data => sprintf(
                    "invoke.ai start already waiting [ %ds ]\n%s",
                    <[base.time]>->(3) - <invoke-web.start_waiting>, $mem_str
                )
            };
        }

        ## queue the start through the dependency wait ##
        <invoke-web.start_waiting> = <[base.time]>->(3);
        <invoke-web.timer.start_guard> //= <[event.add_timer]>->(
            {   'after'    => 13,
                'interval' => 13,
                'repeat'   => TRUE,
                'handler'  => qw| invoke-web.handler.start_guard |,
            }
        );

        ## the zenka must survive the wait [ on-demand idle timeout ] ##
        <[base.zenki.pause_ondemand_timeout]>;

        <[base.logs]>->(
            1, 'start queued : waiting for memory [ ram %d/%d MB free ]',
            $mem->{'ram_free_mb'}, $mem->{'ram_need_mb'}
        );

        return {
            mode => qw| size |,
            data => sprintf(
                "invoke.ai start queued : waiting for memory\n%s"
                    . "[ starts by itself once satisfied ;"
                    . " 'start force' skips the guard ]\n",
                $mem_str
            )
        };
    }
}

## build spawn command
## the zenka itself runs as the admin user [ zenka.v7 drop_privs ] ##
my @cmd = ( $binary, "--root=$root" );

## spawn via IPC::Open3
my ( $stdout_fh, $stderr_fh );
$stderr_fh = Symbol::gensym();

my $child_pid
    = eval { IPC::Open3::open3( undef, $stdout_fh, $stderr_fh, @cmd ) };

if ( !$child_pid || $EVAL_ERROR ) {
    <[base.logs]>->(
        0,
        'failed to spawn invoke.ai [ %s ]',
        $EVAL_ERROR // 'unknown'
    );
    return {
        mode => qw| false |,
        data => sprintf( 'spawn failed [ %s ]', $EVAL_ERROR || 'unknown' )
    };
}

## set pipes to non-blocking
for my $pipe_fh ( $stdout_fh, $stderr_fh ) {
    my $flags = fcntl( $pipe_fh, Fcntl::F_GETFL(), 0 );
    fcntl( $pipe_fh, Fcntl::F_SETFL(), $flags | Fcntl::O_NONBLOCK() )
        if defined $flags;
}

## update state
<invoke-web.pid>          = $child_pid;
<invoke-web.status>       = 'starting';

## no idle shutdown while invoke.ai runs [ it would take it down too ] ##
<[base.zenki.pause_ondemand_timeout]>;
<invoke-web.start_time>   = <[base.time]>->(3);
<invoke-web.output_tail>  = [];
<invoke-web.carry>        = {};
delete <invoke-web.progress>;
delete <invoke-web.last_error>;
delete <invoke-web.missing_models>;
delete <invoke-web.url_detected>;    ## reported again by the ready line ##
<invoke-web.ready_logged> = FALSE;
<invoke-web.crash_logged> = FALSE;
<invoke-web.io_stdout>    = $stdout_fh;
<invoke-web.io_stderr>    = $stderr_fh;

## persist pid for orphan detection
<[file.zenka_dir.write]>->( 'state/invokeai.pid', \"$child_pid\n$binary\n" );

## report child pid to v7
<[base.zenki.report_child_pid]>->($child_pid);

## register I/O watchers : line-wise output parsing for the process lifetime
my $watcher_out = <[event.add_io]>->(
    {   'fd'      => $stdout_fh,
        'handler' => 'invoke-web.handler.output',
        'data'    => { 'pid' => $child_pid, 'stream' => qw| out | },
        'poll'    => qw| re |,
    }
);

my $watcher_err = <[event.add_io]>->(
    {   'fd'      => $stderr_fh,
        'handler' => 'invoke-web.handler.output',
        'data'    => { 'pid' => $child_pid, 'stream' => qw| err | },
        'poll'    => qw| re |,
    }
);

<invoke-web.watcher_stdout> = $watcher_out;
<invoke-web.watcher_stderr> = $watcher_err;

<[base.logs]>->( 1, 'invoke.ai starting [pid:%d]', $child_pid );

return {
    mode => qw| size |,
    data => sprintf( "invoke.ai starting [pid:%d]\n", $child_pid )
};

