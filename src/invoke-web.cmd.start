## [:< ##

# name  = invoke-web.cmd.start
# descr = start invoke.ai [ force : skip the memory guard ]
# param = [ force ]

my $status = <invoke-web.status> // 'idle';
my $pid    = <invoke-web.pid>;

## already running or starting : report and return
if ( $status eq 'running' or $status eq 'starting' ) {
    return {
        mode => qw| size |,
        data => sprintf(
            "invoke.ai already %s [pid:%s]\n", $status, $pid // '-'
        )
    };
}

my $binary = <invoke-web.binary>;
my $root   = <invoke-web.root>;

## verified while still root [ init_code ] : an unprivileged -e would fail ##
## below a 700 home directory even when the binary is present              ##
unless (<invoke-web.binary_ok>) {
    <[base.logs]>->( 0, 'binary not usable [ %s ]', $binary // 'undef' );
    return { mode => qw| false |, data => 'binary not usable' };
}

## start memory guard [ coding zenka pattern ] : when the dependency        ##
## objects [ free RAM \ VRAM ] are not satisfied the start is queued        ##
## through invoke-web.handler.start_guard instead of refused -- it proceeds ##
## by itself once memory frees up. 'start force' skips this                 ##
my $force
    = ( $call->{'args'} // '' ) =~ m{(?:^|\s)force(?:\s|$)} ? TRUE : FALSE;

if ( $force and defined <invoke-web.start_waiting> ) {
    ## drop the queued wait : starting now ##
    delete <invoke-web.start_waiting>;
    my $guard_timer = delete <invoke-web.timer.start_guard>;
    $guard_timer->cancel if defined $guard_timer and ref $guard_timer;
}

if ( not $force and defined <invoke-web.dep.memory_system> ) {
    my $ram_dep = <invoke-web.dep.memory_system>;
    my $gpu_dep = <invoke-web.dep.memory_gpu>;
    my $ram_ok  = defined $ram_dep ? <[dependency.ok]>->($ram_dep) : TRUE;
    my $gpu_ok  = defined $gpu_dep ? <[dependency.ok]>->($gpu_dep) : TRUE;

    if ( not $ram_ok or not $gpu_ok ) {
        my $mem = <[invoke-web.memory_free]>;
        my $mem_str
            = sprintf "ram  : %d MB free [ need %d MB "
            . "]\nvram : %s free [ need %d MB ]\n",
            $mem->{'ram_free_mb'},
            $mem->{'ram_need_mb'},
            defined $mem->{'vram_free_mb'}
            ? $mem->{'vram_free_mb'} . ' MB'
            : '?',
            $mem->{'vram_need_mb'};

        ## a start is already queued : report it, don't queue twice ##
        if ( defined <invoke-web.start_waiting> ) {
            return {
                mode => qw| size |,
                data => sprintf(
                    "invoke.ai start already waiting [ %ds ]\n%s",
                    <[base.time]>->(3) - <invoke-web.start_waiting>, $mem_str
                )
            };
        }

        ## queue the start through the dependency wait ##
        <invoke-web.start_waiting> = <[base.time]>->(3);
        <invoke-web.timer.start_guard> //= <[event.add_timer]>->(
            {   'after'    => 13,
                'interval' => 13,
                'repeat'   => TRUE,
                'handler'  => qw| invoke-web.handler.start_guard |,
            }
        );

        ## the zenka must survive the wait [ on-demand idle timeout ] ##
        <[base.zenki.pause_ondemand_timeout]>;

        <[base.logs]>->(
            1, 'start queued : waiting for memory [ ram %d/%d MB free ]',
            $mem->{'ram_free_mb'}, $mem->{'ram_need_mb'}
        );

        return {
            mode => qw| size |,
            data => sprintf(
                "invoke.ai start queued : waiting for memory\n%s[ starts by "
                    . "itself once satisfied ; 'start force' skips the guard "
                    . "]\n",
                $mem_str
            )
        };
    }
}

## build spawn command  the zenka itself runs as the admin user [ zenka.v7 ##
## drop_privs ]                                                            ##
my @cmd = ( $binary, "--root=$root" );

## start paused : hold the pending items until the pause at ready is through [
## invoke.ai's processor starts resumed and dequeues before its api is up ]
<[invoke-web.queue.hold]>
    if <[invoke-web.start_paused]> ne qw| no |
    or defined <invoke-web.recover>;

## output : stdout + stderr go to a transport file in the zenka's runtime   ##
## dir [ invoke-web.output.path ] -- not a pipe : a pipe's read end dies    ##
## with this zenka, a file can be reopened by the next instance and read on ##
## from its offset [ invoke-web.output.read ]. O_APPEND, so the reader may  ##
## truncate it ; PYTHONUNBUFFERED, or lines wait in python's buffer         ##
my $out_path = <[invoke-web.output.path]>;
my ( $null_in, $out_fh );
my $spawn_err
    = !length( $out_path // '' ) ? 'no runtime dir for the output'
    : !open( $null_in, qw| < |, '/dev/null' ) ? "/dev/null : $OS_ERROR"
    : !sysopen(
    $out_fh,
    $out_path,
    Fcntl::O_WRONLY() | Fcntl::O_CREAT() | Fcntl::O_TRUNC()
        | Fcntl::O_APPEND(),
    0600
    ) ? "$out_path : $OS_ERROR"
    : undef;

my $child_pid;
if ( not defined $spawn_err ) {
    local $ENV{'PYTHONUNBUFFERED'} = 1;
    $child_pid = eval {
        IPC::Open3::open3(
            '<&' . fileno($null_in),
            '>&' . fileno($out_fh),
            undef,    ## stderr : the same file as stdout ##
            @cmd
        );
    };
    $spawn_err = $EVAL_ERROR || 'unknown' if not $child_pid;
}
close($null_in) if defined $null_in;
close($out_fh)  if defined $out_fh;

if ( defined $spawn_err ) {
    <[base.logs]>->( 0, 'failed to spawn invoke.ai [ %s ]', $spawn_err );
    <[invoke-web.queue.release]>;
    return {
        mode => qw| false |,
        data => sprintf( 'spawn failed [ %s ]', $spawn_err )
    };
}

## update state
<invoke-web.pid>    = $child_pid;
<invoke-web.status> = 'starting';

## no idle shutdown while invoke.ai runs [ it would take it down too ] ##
<[base.zenki.pause_ondemand_timeout]>;
<invoke-web.start_time>  = <[base.time]>->(3);
<invoke-web.output_tail> = [];
<invoke-web.carry>       = {};
delete <invoke-web.progress>;
delete <invoke-web.last_error>;
delete <invoke-web.missing_models>;
delete <invoke-web.url_detected>;    ## reported again by the ready line ##
<invoke-web.ready_logged> = FALSE;
<invoke-web.crash_logged> = FALSE;

## persist pid for orphan detection
<[file.zenka_dir.write]>->( 'state/invokeai.pid', \"$child_pid\n$binary\n" );

## register pid file at v7-zenki : removed on a planned end only, so a pid ##
## file still present at the next zenka start means 'not a planned end' [  ##
## invoke-web.recover.after_crash then restarts invoke.ai ]                ##
<[base.zenki.report_pid_file]>
    ->( sprintf( '%s/state/invokeai.pid', <[file.zenka_dir.data_path]> ) );

## report child pid to v7
<[base.zenki.report_child_pid]>->($child_pid);

## follow the output file from its start : line-wise parsing for the process
## lifetime [ invoke-web.output.read ] ; a start marker in the invokeai buffer
## [ persisted by p7-log ]
<[invoke-web.output.follow]>->( $child_pid, 0, qw| started | );

<[base.logs]>->( 1, 'invoke.ai starting [pid:%d]', $child_pid );

return {
    mode => qw| size |,
    data => sprintf( "invoke.ai starting [pid:%d]\n", $child_pid )
};

