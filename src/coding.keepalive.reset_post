## [:< ##

# name   = coding.keepalive.reset_post
# descr  = who leads, for the sessions kept alive
# return = count of posts buffered
#
# the handover file is written first. each post counts as a keep-alive
# sent [ the answer to it is no new activity ], not toward the count

my $all = <[coding.sessions.store]>;
my @to  = grep {
            $all->{$ARG}{'type'} eq qw| claude-live |
        and $all->{$ARG}{'switch'} eq qw| on |
        and not AMOS7::Switch::expired( $all->{$ARG}{'until'}, time )
} sort keys %{$all};
return 0 if not @to;

my ($leader) = sort { $all->{$b}{'last'} <=> $all->{$a}{'last'} }
    grep { $all->{$ARG}{'type'} =~ m{\Akimi-} } keys %{$all};
my $who
    = defined $leader
    ? sprintf( 'kimi session %s is leading [ active %d min ago ]',
    $leader, ( time - $all->{$leader}{'last'} ) / 60 )
    : 'no kimi session is leading';
my ( $written, $result ) = <[coding.handover.write]>;
my $line = "claude 5h window reset : $who ; "
    . (
    $written
    ? "handover is current : $result"
    : "handover not written : $result"
    ) . ' [ coding hand-over ]';

my $count = 0;
foreach my $name (@to) {
    $all->{$name}{'sent'} = time;
    $count++
        if <[coding.keepalive.send]>->(
        {   'name'  => $name,
            'type'  => qw| claude-live |,
            'text'  => $line,
            'reset' => TRUE
        }
        );
}
<[coding.sessions.store]>->(qw| save |);
return $count;

