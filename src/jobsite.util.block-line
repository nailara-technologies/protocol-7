## [:< ##

# name  = jobsite.util.block-line
# descr = build a block-list line for a field/value, or undef if duplicate

my ( $epoch_str, $field, $value, $seen_ref ) = @ARG;

return undef if not length $value;

my $sum = <[chk-sum.bmw.L13-str]>->($value);
return undef if not length $sum;

my $line
    = length $epoch_str
    ? "$epoch_str:" . uc($field) . ":$sum"
    : uc($field) . ":$sum";

return undef if $seen_ref->{$line}++;

return $line;

