## [:< ##

# name  = editor.buffer.memory.get_line
# descr = fetch one line from in-memory editor buffer

## single-line field types [ freeform_line ]: line 0 only ##

my ( $buffer, $line_num ) = @ARG;

return undef if ref $buffer ne qw| HASH |;
$line_num //= 0;
return undef if $line_num != 0;

return $buffer->{'text'};

