## [:< ##

# name  = base.perlmod.autoload
# descr = use autoload to load modules with by default exported functions

my ( $module_name, @export ) = @ARG;

if ( not defined &Module::Load::autoload and [caller]->[1] ne __FILE__ ) {
    eval { require Module::Load };
    if ( length $EVAL_ERROR ) {
        warn <[base.str.eval_error]>;
        eval <<~'EOT';
          sub Module::Load::autoload (*;@) { eval join ' ', qw| use |, @ARG }
        EOT
    }
    <[base.perlmod.autoload]>->(qw| Module::Load |);
}

<base.perlmod.auto_install> //= FALSE;

##  create [ exports ] registry  ##  [ LLL ]
##
if ( not @export and <[base.perlmod.loaded]>->($module_name) ) {
    <[base.logs]>->( 2, ": skipping already present '%s'..,", $module_name );
    return TRUE;    ## true ##
}

<[base.logs]>->( 2, ": loading perl module '%s'.,", $module_name );

eval { Module::Load::autoload( $module_name, @export ) };

## a previously failed require leaves a stale %%INC entry -- the next     ##
## attempt then dies with 'attempt to reload ... aborted', shadowing the  ##
## real problem and blocking auto-install. drop the poisoned entry        ##
## [ named in the error itself -- nested requires poison their own ] and  ##
## retry, bounded : a module with several broken deps heals one entry per ##
## round                                                                  ##
my $heal_rounds = 0;
while ( length $EVAL_ERROR
    and $EVAL_ERROR =~ m{attempt to reload (\S+?) aborted}i
    and $heal_rounds < 3 ) {
    my $poisoned = $LAST_PAREN_MATCH;
    last if not exists $INC{$poisoned};
    delete $INC{$poisoned};
    <[base.logs]>->( 2, ":. stale %%INC entry dropped [ %s ] .,", $poisoned );
    eval { Module::Load::autoload( $module_name, @export ) };
    $heal_rounds++;
}

if ( not length $EVAL_ERROR ) {    # success #
    <[base.perlmod.register_loaded_module]>->($module_name);
    return TRUE;                   ## true ##
} elsif ( delete <base.perlmod.silent_error>
    and not <base.perlmod.auto_install> ) {
    return FALSE;                  ##  no error messages [silenced]  ##
}

my $reason = <[base.format_error]>->( $EVAL_ERROR, 0 );    ## -1 ? ##

# load error #
<base.perlmod.loaded>->{$module_name} = FALSE;

if ( $reason !~ m|^\S+ locate | ) {
    <[base.logs]>->(
        0, "<< error while [auto]loading perl module '%s' >>", $module_name
    );
    die sprintf( ":: [ '%s' ]", $reason );
}

if ( not <base.perlmod.auto_install> ) {
    <[base.logs]>->(
        0, "<< error while [auto]loading perl module '%s' >>", $module_name
    );
    <[base.logs]>->( 1, ":: [ '%s' ]", $reason );
    <[base.log]>->(
        2, "  :. << module auto_install is not enabled, doing nothing >>"
    );
    return FALSE;    ##  no success with loading module  ##
}

<[base.logs]>->(
    2, ": << error while [auto]loading '%s' [ auto_install enabled ] >>",
    $module_name
);
<[base.logs]>->( 2, ":. [ '%s' ]", $reason );

## auto-install ##
my $install_result = <[base.perlmod.install]>->($module_name);

## track what was ACTUALLY installed in var/sys-deps/tracked.yaml         ##
## [ source perlmod-autoload ] : core perl only, no event loop exists at  ##
## this stage -- a failure to record must never fail or delay the install ##
## or the start-up [ logged at level 1, then on ]                         ##
if ( ref $install_result eq qw| HASH | ) {
    my @track_entries;
    push @track_entries, map {
        {   'pkg'    => $ARG,
            'type'   => qw| debian |,
            'source' => 'perlmod-autoload',
            'zenka'  => <system.zenka.name>,
        }
    } @{ $install_result->{'installed_deb'} // [] };
    push @track_entries, map {
        {   'pkg'    => $ARG,
            'type'   => qw| cpan |,
            'source' => 'perlmod-autoload',
            'zenka'  => <system.zenka.name>,
        }
    } @{ $install_result->{'installed_cpan'} // [] };

    if (@track_entries) {
        my $record_ok = eval {
            require AMOS7::deps::tracked;
            my $recorded
                = AMOS7::deps::tracked::record( <system.root_path>,
                \@track_entries );

            ## root install : hand the file + dir to the zenka user ##
            ## [ shared helper, same as v7-zenki.sys_deps.track ]   ##
            AMOS7::deps::tracked::chown_to_user( <system.root_path>,
                <system.amos-zenka-user> );
            $recorded;
        };
        if ( not $record_ok ) {
            my $why = length $EVAL_ERROR ? $EVAL_ERROR : 'write failed';
            <[base.logs]>->(
                1, ':. unable to track perlmod install of %s [ %s ]',
                $module_name, $why
            );
        }
    }
}

eval { Module::Load::autoload( $module_name, @export ) }; ##  trying again  ##

if ( length $EVAL_ERROR ) {
    <[base.s_warn]>->(
        "<< not able to automatically install perl module '%s' >>",
        $module_name
    );
    <[base.perlmod.unregister_loaded_module]>->($module_name);
    return FALSE;    ##  false  ##
} else {
    return TRUE;     ## true ##
}

return TRUE;         ## true ##  [ module loaded ]

