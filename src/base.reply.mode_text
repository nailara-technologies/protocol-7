## [:< ##

# name  = base.reply.mode_text
# descr = mode and text of a reply handler call, whatever the reply shape
# param = $call [ the hash a route-send reply handler receives ]
# return = ( mode [ lower case : true, false, size .. ], text [ string ] )

## a reply handler gets { sid, cmd, call_args, params [, data ] } : SIZE \  ##
## STRM replies carry 'data' [ a scalar ref ], a single line TRUE \ FALSE   ##
## reply only cmd + call_args.args. handlers reading 'mode' \ 'data' took   ##
## every FALSE reply for an empty success -- jobsite sent a repair for each ##
## assessment a coding restart had failed, and gave up on the second        ##
## [ 2026-10-23 ]. 'mode' \ 'data' still come first, for a hand-built call  ##

my $call = shift // {};

my $mode = lc( $call->{'mode'} // $call->{'cmd'} // '' );
my $raw  = $call->{'data'}
    // ( ref $call->{'call_args'} eq qw| HASH | ? $call->{'call_args'} : {} )
    ->{'args'} // '';
my $text = ref $raw eq qw| SCALAR | ? ( $raw->$* // '' ) : $raw;

return ( $mode, $text );

