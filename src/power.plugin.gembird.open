## [:< ##

# name  = power.plugin.gembird.open
# descr = power driver 'gembird' : open a connection to a gembird socket device
# param = ( $device_cfg ) -> handle, or ( undef, reason )

my $device_cfg = shift;

return ( undef, 'device config expected' )
    if ref $device_cfg ne qw| HASH |;

## the perl module is loaded here, never at zenka start ##
<base.perlmod.silent_error> = TRUE;
my $loaded = eval { <[base.perlmod.load]>->(qw| Device::Gembird |) };
delete <base.perlmod.silent_error>;

return ( undef,
    "perl module Device::Gembird missing -- bin/p7-deps install power-gembird"
) if not $loaded;

my $handle = eval {
    Device::Gembird->new(
        'host'   => $device_cfg->{'ip'},
        'port'   => $device_cfg->{'port'},
        'secret' => $device_cfg->{'pass'}
    );
};

return ( undef, 'connection to device failed' )
    if not defined $handle
    or not defined $handle->{'poller'};

return $handle;

