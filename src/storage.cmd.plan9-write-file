# name  = storage.cmd.plan9-write-file
# descr = Overwrite a whole file over 9P

my $args = $call->{'args'} // '';
my ( $name, $path, $content ) = split /\s+/, $args, 3;

if ( not length( $name // '' ) or not length( $path // '' ) ) {
    return {
        'mode' => 'false',
        'data' => 'usage: plan9-write-file <connection-name> <path> <content>'
    };
}
$content //= '';

my $conn = <storage.9p.connections>->{$name};
return { 'mode' => 'false', 'data' => 'not connected' } unless $conn;

my $result = <[storage.9p.write-file]>->( $conn, $path, $content );
return $result if $result->{'mode'} eq 'false';

return {
    'mode' => 'true',
    'data' => "wrote $result->{'data'} bytes to $path"
};

