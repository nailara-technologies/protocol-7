## [:< ##

# name  = nameserv.zone.tombstone.add
# descr = add tombstone for a removed record
# param = $zone_name, $record -> TRUE | FALSE

my $zone_name = shift // '';
my $record    = shift;
my $deleted   = shift;         ## optional explicit ts [ sync apply ] ##

return FALSE if not length $zone_name;
return FALSE if ref $record ne qw| HASH |;

my $zones = <nameserv.zones>;
my $zone  = $zones->{$zone_name} // return FALSE;

## one tombstone per identity : a newer delete replaces an older one ##
<[nameserv.zone.tombstone.clear]>->( $zone_name, $record );

push @{ $zone->{'tombstones'} //= [] },
    {
    name    => lc( $record->{'name'} // '' ),
    type    => uc( $record->{'type'} // '' ),
    value   => $record->{'value'} // '',
    deleted => $deleted           // <[base.ntime.b32]>,
    };

return TRUE;

