## [:< ##

# name  = nameserv.zone.tombstone.add
# descr = add tombstone for a removed record
# param = $zone_name, $record [, $deleted_ts, $signed ] -> TRUE | FALSE

my $zone_name = shift // '';
my $record    = shift;
my $deleted   = shift;       ## optional explicit ts [ sync apply ] ##
my $signed    = shift;       ## optional { body sig writer } [ sync apply ] ##

return FALSE if not length $zone_name;
return FALSE if ref $record ne qw| HASH |;

my $zones = <nameserv.zones>;
my $zone  = $zones->{$zone_name} // return FALSE;

## one tombstone per identity : a newer delete replaces an older one ##
<[nameserv.zone.tombstone.clear]>->( $zone_name, $record );

my $tomb = {
    name    => lc( $record->{'name'} // '' ),
    type    => uc( $record->{'type'} // '' ),
    value   => $record->{'value'} // '',
    deleted => $deleted           // <[base.ntime.b32]>,
};

## a relayed tombstone keeps its writer's signed bytes ; a local delete is ##
## signed by this host's sync key                                          ##
if ( ref $signed eq qw| HASH | ) {
    $tomb->{$ARG} = $signed->{$ARG} for qw| body sig writer |;
} elsif ( not defined $deleted ) {
    <[nameserv.sync.sign]>->( $zone_name, $tomb, TRUE );
}

push @{ $zone->{'tombstones'} //= [] }, $tomb;

return TRUE;

