## [:< ##

# name  = base.stdio.frame.encode.encode_b32
# param = $bytes
# descr = encode bytes to base32 and split
#         each digit into two base-7 frames

my $bytes = shift;
return () if not length $bytes;

my $b32 = Crypt::Misc::encode_b32r($bytes);
my @frames;
my $alphabet = qw| ABCDEFGHIJKLMNOPQRSTUVWXYZ234567 |;

for my $char ( split //, $b32 ) {
    my $idx = index( $alphabet, $char );
    next if $idx < 0;
    my $d0 = int( $idx / 7 ) + 1;
    my $d1 = ( $idx % 7 ) + 1;
    push @frames,
        <[base.stdio.frame.encode.pack_nibble]>->( $d0, 0 ),
        <[base.stdio.frame.encode.pack_nibble]>->( $d1, 0 );
}

return @frames;

