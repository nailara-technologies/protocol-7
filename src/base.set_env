## [:< ##

# name   = base.set_env
# param  = <key> <value>
# descr  = set a value in ENV hash while logging it
# return = <value> or undef

my ( $key, $value ) = ( shift, shift );

if ( not length $key // '' ) {
    <[base.s_warn]>->('key name required <{C1}>');
    return undef;
} elsif ( not defined $value ) {
    <[base.s_warn]>->('value parameter expected <{C1}>');
    return undef;
}
my $mode = exists $ENV{$key} ? qw| updating | : qw| setting |;

<[base.logs]>->( 2, ": %s env-key : %s = '%s'", $mode, $key, $value );

return $ENV{$key} = $value;

