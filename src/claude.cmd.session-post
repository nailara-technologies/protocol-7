## [:< ##

# name  = claude.cmd.session-post
# param = [ from=<name> ] [ to=<session> ] <text>
# descr = a message into the registered live session

## no reply is awaited : the session answers in its own channel. without  ##
## to= the one registered session is used ; several : refused with the    ##
## names. from= \ to= are read before the text [ these win ] and after it ##

my $text = $call->{'args'} // '';
my %opt;
while ( $text =~ s{\A\s*(from|to)=([\w.\-]+)(?:\s+|\z)}{} ) {
    $opt{$1} //= $2;
}
$text .= "\n" . $call->{'data'}
    if defined $call->{'data'} and CORE::length $call->{'data'};
while ( $text =~ s{\s+(from|to)=([\w.\-]+)\s*\z}{} ) {
    $opt{$1} //= $2;
}
$text =~ s{\A\s+|\s+\z}{}g;
return { 'mode' => qw| false |, 'data' => 'text expected' }
    if not CORE::length $text;

my $r = <[claude.live.post]>
    ->( { 'text' => $text, 'from' => $opt{'from'}, 'name' => $opt{'to'} } );
return { 'mode' => qw| false |, 'data' => $r->{'error'} }
    if defined $r->{'error'};
return {
    'mode' => qw| true |,
    'data' => "posted into live session $r->{'name'} [ no reply awaited ]"
};

