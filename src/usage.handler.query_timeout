# name  = usage.handler.query_timeout
# descr = guard timer : answer a usage query with whatever arrived when a
#         provider never reports back at all

my $req_id = shift->w->data->{'req_id'} // '';

my $request = <usage.requests>->{$req_id};
return if not defined $request;    ##  completed normally  ##

##  providers still missing are recorded as timed out  ##
foreach my $name ( $request->{'order'}->@* ) {
    next if exists $request->{'results'}->{$name};
    $request->{'results'}->{$name} = {
        'ok'    => FALSE,
        'error' => 'provider did not report back in time',
    };
}

<[base.logs]>->( 1, 'usage : query [ %s ] guard timer fired', $req_id );

return <[usage.complete_query]>->($req_id);

