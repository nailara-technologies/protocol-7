## [:< ##

# name  = nameserv.cmd.reload-zones
# descr = reload all dns zone files from disk

<[base.logs]>->( 1, ": reloading dns zones..," );

my $old_count = scalar keys <nameserv.zones>->%*;

<[nameserv.zones.load]>;

my $new_count = scalar keys <nameserv.zones>->%*;

my $msg = sprintf( "zones reloaded: %d zone(s) loaded (was %d)",
    $new_count, $old_count );

## emit event for any listeners
<[nameserv.event.emit]>->( 'cmd.reload-zones', { count => $new_count } );

return { mode => 'true', data => $msg };

