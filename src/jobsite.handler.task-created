## [:< ##

# name  = jobsite.handler.task-created
# descr = receive task id, register wait-done watcher

my $call = shift // {};

my $mode     = $call->{'mode'} // '';
my $raw      = $call->{'data'} // '';
my $task_id  = ref $raw ? $raw->$* : $raw;
my $job_id   = <[base.vax-int.decode]>->( $call->{'params'}{'job_id'} // '' );
my $attempt  = $call->{'params'}{'attempt'}                      // 0;
my $cur_attt = ( <jobsite.tasks>->{$job_id} // {} )->{'attempt'} // 0;

if ( $attempt and $attempt != $cur_attt ) {
    ## stale reply : the watchdog already gave up on this attempt and       ##
    ## either requeued the job or moved on -- ignore, do NOT touch          ##
    ## pending_count [ already released by the timeout ] or re-dispatch [ a ##
    ## newer attempt, if any, already owns the queue ]                      ##
    <[base.logs]>->(
        1,
        'jss.task-created: stale reply for job '
            . '%s [ attempt %s, current %s ], ignoring',
        $job_id,
        $attempt,
        $cur_attt
    );
    return;
}

if ( lc($mode) eq qw| false | ) {
    <[base.logs]>->(
        0,       'jss.task-created: failed for job %s: %s',
        $job_id, $task_id
    );
    if ( my $timer = delete <jobsite.assess_timer>->{$job_id} ) {
        eval { $timer->cancel };
    }
    <jobsite.pending_count>--;
    <jobsite.pending_count> = 0 if <jobsite.pending_count> < 0;
    <[jobsite.dispatch.next]>;    ## continue with next job
    return;
}

$task_id = uc( substr( $task_id, 0, 7 ) );
<[base.logs]>->( 1, 'job %s → task %s', $job_id, $task_id );

## protected stages : a reassess dispatch preserves the user's stage so ##
## assess-done/repair-done can treat it as protected — don't clobber it ##
## here just to mark the in-flight pipeline state                       ##
my %protected_stage
    = map { $ARG => 1 }
    qw| review to_apply applied interviewed responded rejected skipped
    archived |;

<jobsite.tasks>->{$job_id}{'task_id'} = $task_id;
<jobsite.tasks>->{$job_id}{'stage'}   = 'assessing'
    unless $protected_stage{ <jobsite.tasks>->{$job_id}{'stage'} // '' };
<[jobsite.state.persist]>;

## deferred watcher : fires when task.complete or task.fail is called next
## dispatch happens in assess-done to keep one task in flight at a time
<[protocol-7.route-send]>->(
    {   'command'   => 'task.wait-done',
        'call_args' => { 'args' => $task_id },
        'reply'     => {
            'handler' => 'jobsite.handler.assess-done',
            'params'  => {
                'job_id'  => $job_id,
                'task_id' => $task_id,
                'attempt' => $attempt
            },
        },
    }
);

