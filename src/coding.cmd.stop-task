## [:< ##

# name  = coding.cmd.stop-task
# descr = stop a running coding task
# param = [task_id]

my $args_str  = $call->{'args'} // '';
my ($task_id) = split m{ +}, $args_str, 2;

## if no task_id provided, use current active task ##
if ( not defined $task_id or not length $task_id ) {
    my $aref_active = <coding.task.active> // [];
    if ( $aref_active->@* ) {
        $task_id = $aref_active->[0];
    } else {
        return { 'mode' => qw| false |, 'data' => 'no active task to stop' };
    }
}

## lookup task in queue ##
my $task = <coding.task.queue>->{$task_id};

return { 'mode' => qw| false |, 'data' => "task not found: $task_id" }
    unless defined $task;

## check task is actually running ##
my $status = $task->{'execution'}->{'status'} // 'unknown';

## a pending/subtask task with no live round can't be stopped the normal   ##
## way : stop_requested is only ever consumed by send_request [ see        ##
## coding.async.send_request's stop-check ], which never runs again for a  ##
## task nothing is trying to schedule. this happens for a task that was    ##
## never dispatched, or -- as with task-PYYJCJY, a scar from the           ##
## backend_acquire double-acquire bug fixed 2026-09-23 -- one that already ##
## finished [ execution.success/result populated ] but never transitioned  ##
## out of 'pending' because a second, concurrent round raced its finalize. ##
## finalize it directly instead of setting a flag nothing will ever read   ##
if ( ( $status eq qw| pending | or $status eq qw| subtask | )
    and not exists <coding.async.task_state>->{$task_id} ) {
    $task->{'execution'}->{'status'}
        = $task->{'execution'}->{'success'} ? qw| completed | : qw| failed |;
    <coding.task.pending>
        = [ grep { $ARG ne $task_id } @{ <coding.task.pending> // [] } ];
    <[base.logs]>->(
        1, "stop-task: finalized stalled %s task %s as %s",
        $status, $task_id, $task->{'execution'}->{'status'}
    );
    return {
        'mode' => qw| true |,
        'data' => "task $task_id had no live round -- finalized as "
            . $task->{'execution'}->{'status'}
    };
}

return {
    'mode' => qw| false |,
    'data' => "task not running (status: $status)"
    }
    unless $status eq qw| in_progress |
    or $status eq qw| pending |
    or $status eq qw| subtask |;

## set stop flag ##
$task->{'stop_requested'} = 1;

## cascade to subtasks: clear queue and stop any active children ##
my $subtask_queue = <coding.task.subtask_queue>->{$task_id} // [];
if (@$subtask_queue) {
    my $stopped_children = 0;
    for my $child_id (@$subtask_queue) {
        my $child_task = <coding.task.queue>->{$child_id};
        if ( defined $child_task ) {
            $child_task->{'stop_requested'} = 1;
            $stopped_children++;
        }
    }
    ## clear the queue so async.complete won't start more ##
    <coding.task.subtask_queue>->{$task_id} = [];
    <[base.logs]>->(
        1,                 "stop-task: cascaded stop to %d subtask(s) of %s",
        $stopped_children, $task_id
    );
}

## also check for any active child that might not be in queue ##
my $parent_map = <coding.task.parent> // {};
for my $child_id ( keys %$parent_map ) {
    next unless $parent_map->{$child_id} eq $task_id;
    my $child_task = <coding.task.queue>->{$child_id};
    next unless defined $child_task;
    next if $child_task->{'stop_requested'};
    $child_task->{'stop_requested'} = 1;
    <[base.logs]>->(
        1,         "stop-task: stopped active child %s of %s",
        $child_id, $task_id
    );
}

<[base.logs]>->( 1, "stop-task: stop requested for %s", $task_id );

return {
    'mode' => qw| true |,
    'data' => "stop requested for task $task_id"
};

