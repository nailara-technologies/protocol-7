## [:< ##

# name  = nodes.ifaces.load
# descr = read the node interface table saved before

my $sref = <[file.zenka_dir.load]>->( <nodes.cfg.ifaces_file>, qw| :raw | );
return FALSE if ref $sref ne qw| SCALAR |;
my $all = <[nodes.ifaces.parse]>->( $sref->$* );
<nodes.ifaces>->{$ARG} //= $all->{$ARG} foreach keys $all->%*;
return TRUE;

