## [:< ##
# name  = storage.9p.remove-path
# descr = High-level remove path on 9P server

my ( $conn, $path ) = @ARG;

my @parts = grep {length} split m|/|, $path;
my $fid   = $conn->{next_fid}++;

my $walk_result
    = <[storage.9p.walk]>->( $conn, $conn->{root_fid}, $fid, @parts );
return $walk_result if $walk_result->{'mode'} eq 'false';

my $remove_result = <[storage.9p.remove]>->( $conn, $fid );
return $remove_result if $remove_result->{'mode'} eq 'false';

return { 'mode' => 'true', 'data' => $path };

