## [:< ##

# name  = base.interval.rhythm.disk
# descr = disk poll delay [ slow with room, faster under pressure ]

my $ctx   = shift;
my $state = $ctx->{'state'};
my $cfg   = $ctx->{'cfg'};
my $num   = sub {
    my ( $key, $default ) = @ARG;
    my $value = $cfg->{$key};
    return
        defined $value && $value =~ m|^\d+(\.\d+)?$| ? $value + 0 : $default;
};
my $start    = $num->( qw| start |, 377 );
my $cap      = $num->( qw| cap |,   13 );
my $pressure = $state->{'pressure'} // 0;
$pressure = 0 if $pressure < 0;
$pressure = 1 if $pressure > 1;
my $delay = $cap * ( ( $start / $cap )**( 1 - $pressure ) );
$state->{'current'} = $delay;
return $ctx->{'harmonize'}->($delay);

