# name  = kimi.handler.acp_signal_reply
# descr = the events zenka answered kimi.run.done

my $reply = shift;
return TRUE if ( $reply->{'cmd'} // '' ) !~ m{\AFALSE\z}i;
my $why = $reply->{'call_args'}{'args'} // 'refused';
<[base.logs]>->( 0, '<< signal kimi.run.done refused : %s >>', $why );
<[kimi.acp.event]>->( qw| error |, "signal kimi.run.done refused : $why" );
return TRUE;

