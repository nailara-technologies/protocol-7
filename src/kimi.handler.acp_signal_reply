# name  = kimi.handler.acp_signal_reply
# descr = the events zenka answered a kimi.run signal

my $reply = shift;
return TRUE if ( $reply->{'cmd'} // '' ) !~ m{\AFALSE\z}i;
my $why    = $reply->{'call_args'}{'args'} // 'refused';
my $signal = $reply->{'params'}{'signal'}  // qw| kimi.run.done |;
<[base.logs]>->( 0, '<< signal %s refused : %s >>', $signal, $why );
<[kimi.acp.event]>->( qw| error |, "signal $signal refused : $why" );
return TRUE;

