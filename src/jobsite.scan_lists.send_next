## [:< ##

# name  = jobsite.scan_lists.send_next
# descr = remote scan : send the next skip \ block list part, one at a time
#         [ each after the previous reply ] -- with none left, the imports
#         that name the lists [ jobsite.stage.fetch ]

my $out = <jobsite.scan_lists_out> // return;

if ( my $part = shift $out->{'parts'}->@* ) {
    my ( $kind, $data ) = $part->@*;
    <[protocol-7.route-send]>->(
        {   'command'   => $out->{'fetch_zenka'} . '.scan-lists',
            'call_args' => {
                'args' => sprintf(
                    'id=%s kind=%s data=%s',
                    $out->{'scan_id'}, $kind, $data
                )
            },
            'reply' => {
                'handler' => qw| jobsite.handler.scan-lists-sent |,
                'params'  => { 'scan_id' => $out->{'scan_id'} },
            },
        }
    );
    return;
}

delete <jobsite.scan_lists_out>;
<[protocol-7.route-send]>->($ARG) foreach $out->{'imports'}->@*;

return;

