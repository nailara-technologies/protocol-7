## [:< ##

# name  = user-edit.init_code
# descr = initialize user-edit console zenka skeleton

<[base.logs]>->( 2, 'user-edit zenka initialized' );

## raw terminal mode for the interactive form [ form.term_init /
## form.term_restore ] — linux-native, no XS build issues, and API-compatible
## with POSIX::Termios [ nshell.init_code precedent ]
<[base.perlmod.load]>->('Linux::Termios2');

## resolve the invoking Unix user, for the start file's  system.auth-user =
## <user-edit.unix_user> [ nshell.init_code precedent : authenticate as the
## Unix user, not a zenka credential ]
<user-edit.unix_user> //= $ENV{'USER'} // getpwuid($EUID);

## '<user>[<subname>]' routing identity : without the subname this console ##
## is indistinguishable from any other zenka authenticating as the same    ##
## unix user [ nshell, notably ], and cube cannot address either one --    ##
## 'p7c taeki.<cmd>' reaches whichever matched first.  the subname is a    ##
## routing label only : plugin.auth.unix splits it off before every access ##
## check, so authorization still sees the bare unix user.                  ##
##                                                                         ##
## built here rather than written into the start file, where '[user-edit]' ##
## would be parsed as a command invocation by the config parser            ##
## create-admin flow state, explicitly reset : a mid-session               ##
## base.cmd.reload must not leave the resume block in form.  offer_create  ##
## armed from a previous invocation                                        ##
<form.pending.create>   = FALSE;
<form.create.attempted> = FALSE;
<form.offer.create>     = FALSE;

<user-edit.auth_name> = sprintf( qw| %s[user-edit] |, <user-edit.unix_user> );

##  THE RECORD SOURCE  #######################################################
##                                                                          ##
##  one callback table the whole form engine reads : every form.* module    ##
##  that needs the record store or the secret store calls through           ##
##  <form.source> instead of building a users.*/sessions.* route itself,    ##
##  which is what keeps the engine record-independent -- host-edit will     ##
##  register its own senders here without touching any form.* module.       ##
##                                                                          ##
##    senders      : value_get / value_all / value_set / field_options /    ##
##                   create_default / secret_hold / secret_release --       ##
##                   module names, invoked as <[$sender]> by the engine    ##
##    default_record : the record a bare 'show-form'/'start' opens -- the   ##
##                   invoking unix user, exactly the fallback the pre-      ##
##                   extraction code used                                   ##
##    allow_create : may this session's user create a missing record        ##
##                   [ the create-offer gate form.handler.value_get_reply   ##
##                   checks before unlooping into form.offer_create ]       ##
##    tag_record   : the record name a :create-admin:-style tag may         ##
##                   auto-create [ <system.admin-user>, as before ]         ##
<form.source> = {
    qw| default_record |  => <user-edit.unix_user>,
    qw| allow_create    | =>
        ( <user-edit.unix_user> eq ( <system.admin-user> // '' ) )
    ? TRUE
    : FALSE,
    qw| tag_record      | => <system.admin-user> // '',
    ## record vocabulary the engine renders but never defines : a second zenka
    ## on form.* [ host-edit ] registers its own values here, keeping every
    ## one of these strings out of form.* -- the defaults below are
    ## user-edit's historical wording, byte-identical output by construction
    qw| title_fmt       | => q{user-edit : %s},
    qw| frame_name      | => qw| user-edit-form |,
    qw| menu_fallback   | => qw| user-edit |,
    qw| namespace_main  | => qw| host-system |,
    qw| namespace_keys  | => qw| keys |,
    qw| not_found_fmt   | => q{user '%s' not found},
    qw| value_get       | => qw| user-edit.source.value_get |,
    qw| value_all       | => qw| user-edit.source.value_all |,
    qw| value_set       | => qw| user-edit.source.value_set |,
    qw| field_options   | => qw| user-edit.source.field_options |,
    qw| create_default  | => qw| user-edit.source.create_default |,
    qw| secret_hold     | => qw| user-edit.source.secret_hold |,
    qw| secret_release  | => qw| user-edit.source.secret_release |,
};

## P7-native home dir resolution [ base.get_homedir, NOT AMOS7::FILE:: ##
## get_homepath directly — matches crypt.C25519.get_usr_keys_dir's     ##
## precedent for this exact ~/.n purpose ]                             ##
my $home_dir = <[base.get_homedir]>->(<user-edit.unix_user>);

my $user_edit_path_keywords = {
    qw| VAR_P7 | => <[file.zenka_dir.data_path]>,
    qw| ETC_P7 | => <[file.zenka_dir.data_path]>->(TRUE),
    qw| HOME_N | => join( qw| / |, $home_dir, qw| .n | )
};

<[base.path.register_keywords]>->($user_edit_path_keywords);

return TRUE;

