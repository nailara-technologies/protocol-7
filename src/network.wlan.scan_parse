## [:< ##

# name  = network.wlan.scan_parse
# param = <scan-results lines>
# descr = scan results -> ssid, signal, freq, security

## bssid \t freq \t signal \t flags \t ssid -- header line skipped ##
my @net;
foreach my $line (@ARG) {
    my ( $bssid, $freq, $signal, $flags, $ssid ) = split m|\t|, $line, 5;
    next if not defined $ssid or $bssid !~ m|^[0-9a-f]{2}(:[0-9a-f]{2}){5}$|i;
    my $security
        = $flags =~ m|SAE|  ? qw| wpa3 |
        : $flags =~ m|EAP|  ? qw| wpa-eap |
        : $flags =~ m|WPA2| ? qw| wpa2 |
        : $flags =~ m|WPA|  ? qw| wpa |
        : $flags =~ m|WEP|  ? qw| wep |
        :                     qw| open |;
    push @net,
        {
        qw| ssid |     => length $ssid ? $ssid : '[ hidden ]',
        qw| bssid |    => $bssid,
        qw| freq |     => $freq,
        qw| signal |   => $signal,
        qw| security | => $security
        };
}
## strongest first ##
return [ sort { $b->{'signal'} <=> $a->{'signal'} } @net ];

