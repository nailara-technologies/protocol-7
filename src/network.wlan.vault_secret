## [:< ##

# name  = network.wlan.vault_secret
# param = <ssid>
# descr = wlan secret from the vault entry wlan:<ssid>

## p7-vault get through a pipe : never argv, file or log. no tty here, so a ##
## locked vault fails at once [ it never prompts ] -> undef                 ##
my $ssid = shift // return undef;
my $bin  = <network.cfg.vault_bin>;
return undef if not -x $bin;
my $pid = open( my $pipe, '-|' ) // return undef;
if ( $pid == 0 ) {
    open( STDIN,  '<', qw| /dev/null | );
    open( STDERR, '>', qw| /dev/null | );
    CORE::exec {$bin} qw| p7-vault get |, "wlan:$ssid", qw| password |;
    CORE::exit 127;
}
my $value = do { local $INPUT_RECORD_SEPARATOR = undef; readline($pipe) };
close($pipe);
my $rc = $CHILD_ERROR;
if ( $rc != 0 or not defined $value ) {
    substr( $value, 0 ) = "\0" x length $value if defined $value;
    return undef;
}
$value =~ s|\r?\n\z||;
return \$value;

