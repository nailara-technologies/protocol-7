# name  = httpsd.callback.reset-capture
# descr = clean up /dev/shm crash-capture file on graceful shutdown
#         [ prevents false crash report on next startup ]
#         [ no-op when file absent : resilient to feature being disabled ]

my $path = <httpsd.path.request_capture>;
return warn 'request_capture path not set' if not defined $path;

unlink $path
    or <[base.logs]>->(
    1,     'request_capture : unlink %s failed [ %s ]',
    $path, <[base.str.os_err]>
    ) if -f $path;

