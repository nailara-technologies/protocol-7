# name  = web-browser.handler.capture_paged_step
# descr = one step of the paged capture loop. looks up the current position,
#         jumps the foreground view to it via a JS window.scroll() call, and
#         hands off to the scroll-result callback to snapshot. the first
#         position (index 0) also scrolls to 0 to ensure a clean header
#         capture after any previous page state.

my $positions = <web-browser.capture.paged.positions>;
my $index     = <web-browser.capture.paged.index> // 0;

if ( not defined $positions or $index >= @$positions ) {
    <[web-browser.capture_paged.advance]>;
    return;
}

my $position = $positions->[$index];

my $fg_index = <web-browser.overlay.index.fg> // 1;
my $view     = <web-browser.gtk_obj.view>->{$fg_index};

if ( !defined $view ) {
    <[base.logs]>->( 0, "capture_paged_step: no foreground view available" );
    <[web-browser.capture_paged.advance]>;
    return;
}

my $settings = $view->get_settings();

if ( !$settings->get_enable_javascript() ) {
    <[base.logs]>->(
        0,
        "capture_paged_step: javascript "
            . "disabled, aborting paged capture"
    );
    <[web-browser.capture_paged.advance]>;
    return;
}

<[web-browser.js_call]>->(
    'window.scroll(0,' . $position . ')',
    $code{'web-browser.callback.capture_paged_scroll_result'},
    { 'position' => $position }
);

