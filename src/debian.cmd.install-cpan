## [:< ##

# name  = debian.cmd.install-cpan
# descr = enqueue cpan module install [ one queue with apt ]
# param = <Module::Name> [ <Module::Name> .. ]

my $param = shift            // {};
my $args  = $param->{'args'} // '';

my @modules = grep {length} split m|\s+|, $args;

return { 'mode' => qw| false |, 'data' => 'no modules specified' }
    if not @modules;

my $job_id = <[debian.cpan_enqueue_install]>->(
    {   'modules'  => \@modules,
        'reply_id' => $param->{'reply_id'},
        'source'   => qw| cmd.install-cpan |
    }
);

return { 'mode' => qw| false |, 'data' => 'install queue unavailable' }
    if not defined $job_id;

## the reply is delivered asynchronously by                      ##
## debian.handler.cpan_child_output once cpanm actually finishes ##
## [ deferred_reply pattern ]                                    ##
return { 'mode' => qw| deferred | };

