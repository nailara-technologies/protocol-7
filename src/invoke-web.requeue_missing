## [:< ##

# name   = invoke-web.requeue_missing
# descr  = retry queue items that failed on a missing model once the model
#          file is back -- read from invoke.ai's queue db [ the source of
#          truth : every such item, also from before a zenka restart ]
# param  = [ model name ; undef : every model ], [ list only : TRUE ]
# return = arrayref of { name, path, present, items, result }
# note   = an item qualifies only when ALL hold : status 'failed',
#          error_type FileNotFoundError, the error message names the model
#          and its path, no copy of it exists yet [ retried_from_item_id,
#          pending \ in_progress \ completed -- a ui retry counts too ], the
#          file is present again. a manual cancel is never touched

my $only      = shift;
my $list_only = shift // FALSE;

my $dbh  = <[invoke-web.queue.db]> // return undef;
my $rows = $dbh->selectall_arrayref(
    "SELECT q.item_id, q.error_message FROM session_queue q "
        . "WHERE q.status = 'failed' AND q.error_type = 'FileNotFoundError' "
        . 'AND NOT EXISTS ( SELECT 1 FROM session_queue c '
        . 'WHERE c.retried_from_item_id = q.item_id '
        . "AND c.status IN ( 'pending', 'in_progress', 'completed' ) ) "
        . 'ORDER BY q.item_id',
    { 'Slice' => {} }
) // return undef;

## group by model [ name + path from the error message ] ##
my %models;
foreach my $row (@$rows) {
    my ( $name, $path )
        = ( $row->{'error_message'} // '' )
        =~ m|Files for model '([^'{}]+)' not found at (\S+)|;
    next if not defined $name;
    next if defined $only and $name ne $only;
    $models{$name}->{'path'} = $path;
    push $models{$name}->{'items'}->@*, $row->{'item_id'};
}

my @results;
foreach my $name ( sort keys %models ) {
    my $model  = $models{$name};
    my %result = (
        'name'    => $name,
        'path'    => $model->{'path'},
        'items'   => [ $model->{'items'}->@* ],
        'present' => -e $model->{'path'} ? TRUE : FALSE,
    );
    if ( $list_only or not $result{'present'} ) {
        push @results,
            {
            %result, 'result' => $result{'present'} ? 'present' : 'missing'
            };
        next;
    }

    my $retry = <[invoke-web.api]>->(
        'PUT',
        '/api/v1/queue/default/retry_items_by_id',
        [ map { $ARG + 0 } $model->{'items'}->@* ]
    );
    if ( not $retry->{'ok'} ) {
        push @results,
            {
            %result, 'result' => "retry failed [ " . "$retry->{'status'} ]"
            };
        next;
    }
    my $retried
        = ref $retry->{'data'} eq qw| HASH |
        ? scalar( ( $retry->{'data'}->{'retried_item_ids'} // [] )->@* )
        : '?';
    <[invoke-web.retried]>->( $model->{'items'} );
    push @results, { %result, 'result' => "retried $retried" };
    <[base.logs]>->(
        1, "queue : %s item%s re-queued [ model '%s' is back ]",
        $retried, $retried eq '1' ? '' : 's', $name
    );
    delete <invoke-web.missing_at_render>->{$name};
}

<[invoke-web.missing.save]>;

return \@results;

