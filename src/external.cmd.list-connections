## [:< ##

# name  = external.cmd.list-connections
# descr = list all orbital connections
#
# notes = args 'subscribe' opens a STRM push channel instead, fed by
#         every connection mutation point

if ( defined $call->{'args'} and $call->{'args'} eq qw| subscribe | ) {
    return { 'mode' => qw| false |, 'data' => 'orbital push disabled' }
        unless <[base.cfg_bool]>->(<external.cfg.orbital_push_enabled>);

    my $h = <[base.stream.open]>->(
        {   'sid'    => $call->{'session_id'},
            'cmd_id' => $call->{'command_id'},
            'type'   => qw| STRM |,
            'total'  => undef,
        }
    );
    return { 'mode' => qw| false |, 'data' => 'stream open refused' }
        if not defined $h;

    <external.orbital.listeners> //= [];
    push <external.orbital.listeners>->@*, $h;
    <[base.logs]>->(
        2, 'orbital connections listener added [sid=%d]',
        $call->{'session_id'}
    );

    ## push the current snapshot immediately ##
    my $conn_ref = <external.connections> // {};
    for my $name ( <[base.sort]>->($conn_ref) ) {
        my $c       = $conn_ref->{$name};
        my $payload = sprintf "%s %s %s %s %s\n",
            $name,
            $c->{'p7ref'}  // '',
            $c->{'ip'}     // '',
            $c->{'status'} // '',
            $c->{'encrypted'} ? qw| yes | : qw| no |;
        <[base.stream.push]>->( $h, \$payload );
    }

    return { 'mode' => qw| deferred | };
}

my $conn_ref = <external.connections> // {};
my @names    = <[base.sort]>->($conn_ref);

return { 'mode' => qw| true |, 'data' => 'no connections' }
    unless @names;

my $output = "\n";
my $fmt    = "%-16s %-30s %-16s %-12s %-10s\n";
$output .= sprintf $fmt, qw| name p7ref ip status encrypted |;
$output .= '-' x 90 . "\n";

foreach my $name (@names) {
    my $c = $conn_ref->{$name};
    $output .= sprintf $fmt,
        $name,
        $c->{'p7ref'}  // '',
        $c->{'ip'}     // '',
        $c->{'status'} // '',
        $c->{'encrypted'} ? qw| yes | : qw| no |;
}

return { 'mode' => qw| size |, 'data' => $output };

