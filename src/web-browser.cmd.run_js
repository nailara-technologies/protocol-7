## [:< ##

# name  = web-browser.cmd.run_js
# descr = run javascipt in foreground view

my $reply_id  = $call->{'reply_id'};
my $fg_index  = <web-browser.overlay.index>->{'fg'};
my $view      = <web-browser.gtk_obj.view>->{$fg_index};
my $view_uri  = $view->get_uri();
my $settings  = $view->get_settings();
my $js_string = $call->{'args'} // '';

return {
    'mode' => qw| FALSE |,
    'data' => 'javascript execution is disabled'
    }
    if !$settings->get_enable_javascript();

return {
    'mode' => qw| false |,
    'data' => 'expected javascript command string'
    }
    if !length($js_string);

<[base.log]>->( 2, "[$view_uri] running javascript : '$js_string'" );

$view->evaluate_javascript(
    $js_string,
    -1,       ## length: -1 = null-terminated string
    undef,    ## world_name: default world
    undef,    ## source_uri
    undef,    ## cancellable
    sub {
        my ( $view, $result ) = @_;
        my $result_str = '';
        my $re_mode    = qw| true |;
        my $jsc_value  = eval { $view->evaluate_javascript_finish($result) };

        if ($@) {
            ( my $ex_str = $@ ) =~ s| at /usr/.+\n$||;
            $ex_str =~ s|^[^ ]+ ||;
            $re_mode    = qw| false |;
            $result_str = $ex_str;
            <[base.log]>->(
                0,              sprintf '<!JSerr!> [%s] %s',
                $view->get_uri, $ex_str
            );
        } elsif ( defined $jsc_value ) {
            $result_str = $jsc_value->to_string;
            $re_mode    = qw| data | if $result_str =~ m|\n|;
        }

        <[base.callback.cmd_reply]>->(
            $reply_id,
            {   'mode' => $re_mode,
                'data' => $result_str
            }
        );

    },
    undef    ## user_data
);

return { 'mode' => 'deferred' };

