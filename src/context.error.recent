## [:< ##

# name  = context.error.recent
# descr = recent error log entries with optional filter

my $params = shift // {};

my $filter = $params->{'filter'} // '';
my $budget = $params->{'budget'} // 500;
my $lines  = $params->{'lines'}  // 50;

my $char_budget = int( $budget * <context.cfg.chars_per_token> );

## read from zenka buffer at error level ##
my $buffer_name = qw| zenka |;
my $output      = "## recent errors ##\n";

## access buffer data if available ##
my $buffer = <buffer.zenka.data> // undef;

unless ( defined $buffer and ref $buffer eq qw| ARRAY | ) {
    return "<!-- no error buffer available -->";
}

## collect error-level entries [ level 0 ] ##
my @errors;
my $count = 0;

for ( my $i = $#$buffer; $i >= 0 and $count < $lines; $i-- ) {
    my $entry = $buffer->[$i];
    next unless defined $entry;

    ## buffer entries may be strings or structured ##
    my $text;
    if ( ref $entry eq qw| HASH | ) {
        next
            if defined $entry->{'level'}
            and $entry->{'level'} > 0;
        $text = $entry->{'text'} // $entry->{'data'} // '';
    } else {
        $text = "$entry";
    }

    next unless length $text;

    ## apply filter if specified ##
    if ( length $filter ) {
        next unless $text =~ m|\Q$filter\E|i;
    }

    push @errors, $text;
    $count++;
}

if ( not @errors ) {
    return "<!-- no matching errors -->";
}

## build output within budget ##
my $used = length $output;

foreach my $err ( reverse @errors ) {
    my $line = "$err\n";
    if ( $used + length($line) > $char_budget ) {
        $output .= "... [ truncated ]\n";
        last;
    }
    $output .= $line;
    $used += length $line;
}

return $output;

