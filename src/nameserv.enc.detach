## [:< ##

# name  = nameserv.enc.detach
# param = <state>
# descr = take a cache-miss state off its encrypted connection

my $state = shift                // return FALSE;
my $conn  = $state->{'enc_conn'} // return TRUE;
$state->{'enc_conn'} = undef;

$conn->{'queue'} = [ grep { $ARG != $state } @{ $conn->{'queue'} } ];
for my $id ( keys %{ $conn->{'inflight'} } ) {
    delete $conn->{'inflight'}{$id} if $conn->{'inflight'}{$id} == $state;
}
## a connection nobody waits for and that never became ready is dropped ##
<[nameserv.enc.close]>->($conn)
    if $conn->{'phase'} ne qw| ready |
    and not @{ $conn->{'queue'} }
    and not %{ $conn->{'inflight'} };
return TRUE;

