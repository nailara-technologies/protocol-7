# name  = coding.handler.cpu_fit_recheck
# descr = retry the cpu spawn after its model did not fit in free ram
# note  = armed by coding.async_spawn_inference_servers, once per wait step

delete <coding.timer.cpu_fit_recheck>;

my $cpu_pid = <inference.cpu_pid> // 0;
return TRUE if $cpu_pid and kill( 0, $cpu_pid );
return TRUE if <coding.switch_model_active>;

<[coding.async_spawn_inference_servers]>;

return TRUE;

