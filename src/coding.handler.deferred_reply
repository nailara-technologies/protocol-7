## [:< ##

# name  = coding.handler.deferred_reply
# descr = send deferred reply for completed coding task
#         Called directly from coding.event.on_task_complete

my $deferred_id = shift;

my $deferred = $data{"coding"}{"deferred_replies"}->{$deferred_id};
return unless defined $deferred;

## cancel timeout timer if wait-done registered one ##
my $timer = $deferred->{'timeout_timer'};
if ( defined $timer and eval { $timer->is_active } ) {
    $timer->cancel;
}

my $task_id     = $deferred->{'task_id'};
my $reply_id    = $deferred->{'reply_id'};
my $callback_id = $deferred->{'callback_id'} // '';
my $task        = <coding.task.queue>->{$task_id};

<[base.logs]>->(
    1,
    'deferred_reply: task=%s reply_id=%s callback_id=%s task_found=%s',
    $task_id,
    $reply_id // 'undef',
    $callback_id || 'none',
    defined $task ? 'yes' : 'no'
);

my ( $result_data, $result_mode, $is_error );

unless ( defined $task ) {
    $result_data = 'task not found';
    $result_mode = 'false';
    $is_error    = TRUE;
} else {
    my $status = $task->{'execution'}->{'status'} // '';
    <[base.logs]>->( 1, 'deferred_reply: status=%s', $status );

    if ( $status eq 'completed' ) {
        my $result   = $task->{'execution'}->{'result'} // '';
        my $stripped = $result;
        $stripped =~ s/\n$//;
        $result_mode = ( $stripped =~ tr/\n// ) ? 'size' : 'true';
        $result_data = $result || '[ no reply message ]';
    } elsif ( $status eq 'failed' or $status eq 'error' ) {
        $result_data = $task->{'execution'}->{'error'} // 'task failed';
        $result_mode = 'false';
        $is_error    = TRUE;
    } else {
        return;    ## not yet complete : will be called again ##
    }
}

## reply to the original caller first : unchanged from before the tree ##
## feature existed — the caller never waits on the task zenka          ##
if ( length $callback_id ) {
    <[protocol-7.route-send]>->(
        {   command   => 'task.summarize-done',
            call_args => {
                args => join(
                    ' ',
                    "callback_id=$callback_id",
                    "mode=$result_mode",
                    ':B32:'
                        . encode_b32r(
                        Encode::encode( 'UTF-8', $result_data )
                        ),
                ),
            },
        }
    );
} else {
    ## local reply ##
    <[base.callback.cmd_reply]>->(
        $reply_id, { 'mode' => $result_mode, 'data' => $result_data }
    );
}

## then, best-effort, fire-and-forget notify the task-zenka summary tree :  ##
## only on success, only when tree=1 was requested [ chk non-empty ]. never ##
## delays or risks the reply above — it already went out                    ##
my $chk = $deferred->{'chk'} // '';
if ( not $is_error and length $chk ) {
    <[protocol-7.route-send]>->(
        {   command   => 'task.summary-tree-notify',
            call_args => {
                args => join(
                    ' ',
                    "chk=$chk",
                    'source=coding',
                    ## focus may contain spaces : always b32-wrap ##
                    (   length( $deferred->{'focus'} // '' ) ? 'focus=:B32:'
                            . encode_b32r(
                            Encode::encode( 'UTF-8', $deferred->{'focus'} )
                            )
                        : ()
                    ),
                    (   length( $deferred->{'origin'} // '' )
                        ? "origin=$deferred->{'origin'}"
                        : ()
                    ),
                    ':B32:'
                        . encode_b32r(
                        Encode::encode( 'UTF-8', $result_data )
                        ),
                ),
            },
        }
    );
}

$deferred->{'status'} = $is_error ? 'error' : 'complete';
delete $data{"coding"}{"deferred_replies"}->{$deferred_id};

