## [:< ##

# name  = system.watch.gate
# descr = ask the unless conditions of held triggers
# args  = watch
#
# events.bucket.unless.check does the asking, over the same replies and
# guard timer as for reminders ; its hooks are system.watch.unless.*

my $w = shift;
return FALSE if defined $w->{'gate'};
$w->{'gate'} = {
    'id'     => $w->{'id'},
    'added'  => $w->{'added'},
    'unless' => $w->{'unless'},
    'state'  => qw| waiting |
};
eval {
    <[events.bucket.unless.check]>->( qw| system-watch |, $w->{'gate'} );
    1;
} or do {    ## asked again at the next poll ##
    <[base.logs]>->(
        0,          "<< watch '%s' : unless check failed : %s >>",
        $w->{'id'}, $EVAL_ERROR =~ s{\s+\z}{}r
    );
    delete $w->{'gate'};
    return FALSE;
};
return TRUE;

