# name  = v7-zenki.zenka.cmd.register_child
# param = <child-pid> <parent-pid> [ <child-name> ]
# descr = associate process ID with its parent instance

## parent_pid comes from the caller directly
## [ its own pid, since it is the process that did the actual spawning ]
## rather than being re-derived here via a live /proc/<pid>/status lookup :
## that lookup reflects the CURRENT process tree, not the tree at spawn time,
## so an intermediate process exiting during the async round trip through cube
## [ eg a transient shell wrapping a piped-open spawn ] reparents the child to
## init before this code ever runs, and the real relationship is gone for good
## by then -- trusting the spawner's own identity sidesteps the race entirely
my $instance_id;
my ( $child_pid, $parent_pid, $child_name )
    = split( m| +|, $call->{'args'}, 3 );

foreach my $id (<[v7-zenki.instance_ids]>) {
    next if not defined <v7-zenki.zenka.instance>->{$id}->{'process'}{'id'};
    my $pid = <v7-zenki.zenka.instance>->{$id}->{'process'}{'id'};
    if ( defined $parent_pid and $pid == $parent_pid ) {
        $instance_id = $id;
        last;
    }
}

return { 'mode' => qw| false |, 'data' => 'found no matching parent' }
    if not defined $instance_id;

return { 'mode' => qw| true |, 'data' => 'was known' }
    if exists <v7-zenki.zenka.instance>
    ->{$instance_id}->{'process'}->{'child'}->{$child_pid};

%{ <v7-zenki.child>->{$child_pid} } = %{ <v7-zenki.child>->{$parent_pid} };
<v7-zenki.child>->{$child_pid}->{'zenka_child'} = 1;

## optional child name \ role [ e.g. 'invokeai' ] + process identity for    ##
## the crash keep-children path [ keep_children_on_error \ claim-children ] ##
## : the /proc start time is the pid-reuse guard, the cmdline the           ##
## plausibility check -- both re-verified before any keep \ claim \ signal  ##
if ( defined $child_name and length $child_name ) {
    $child_name =~ s|[^A-Za-z0-9_.\-]+||g;
    <v7-zenki.child>->{$child_pid}->{'child_name'} = $child_name
        if length $child_name;
}
if ( my $identity = <[v7-zenki.sub-process.proc_identity]>->($child_pid) ) {
    <v7-zenki.child>->{$child_pid}->{'proc_start_time'} = $identity->[0];
    <v7-zenki.child>->{$child_pid}->{'proc_cmdline'}    = $identity->[1];
}

my $instance = <v7-zenki.zenka.instance>->{$instance_id};
$instance->{'process'}->{'child'}->{$child_pid} = 1;
<[base.logs]>->(
    '[instance:%d] child pid %d registered.',
    $instance_id, $child_pid
);

return { 'mode' => qw| true |, 'data' => 'registered' };

