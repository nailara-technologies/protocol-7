## [:< ##

# name  = v7-zenki.calc_prefix_lengths
# descr = initialize zenki for automatic \ immediate startup

my $apw_href = <v7-zenki.zenka.prefix_width> //= {};

my @online_zenki = keys <v7-zenki.online-zenki>->%*;

my $max_len = 0;
foreach my $zenka_name ( uniq @ARG, @online_zenki, qw| v7 cube | ) {
    my $new_len = <[base.get_start_lpw]>->($zenka_name);
    $apw_href->{$zenka_name} //= $new_len;
    $max_len = $new_len if $new_len > $max_len;
}

foreach my $zenka_name ( <[base.sort]>->($apw_href) ) {    ## keys ##
    next if $apw_href->{$zenka_name} == $max_len;
    my @zenki_pid;
    map {
        ## no next here : inside map it would leave the zenka loop ##
        my $instance_id = $ARG;
        my $pid
            = $instance_id =~ m|^\d+$|
            ? <v7-zenki.zenka.instance>->{$instance_id}->{'process'}->{'id'}
            : undef;
        if ( defined $pid and $pid =~ m|^\d+$| ) {
            push( @zenki_pid, $pid );
        } elsif ( $instance_id =~ m|^\d+$| ) {
            ## a starting \ stopped instance has no pid yet : level 1 ##
            <[base.logs]>->(
                1,
                'ignoring non-numeric process id for zenka '
                    . "'%s' [ instance %d : %s ]",
                $zenka_name,
                $instance_id,
                $pid // qw| <undef> |
            );
        }
    } <[v7-zenki.zenka-instances.get-ids]>->($zenka_name)
        if $zenka_name ne qw| v7-zenki |;

    ## distance between signals [ increase when required ] ##
    my $timer_inc   = 0.13;
    my $timer_delay = 0;      ## start delay ##

    if ( $apw_href->{$zenka_name} < $max_len ) {
        my $delta_len = $max_len - $apw_href->{$zenka_name};

        while ( $delta_len-- ) {
            if ( $zenka_name ne qw| v7-zenki | ) {

                ##  async dispatch  ##
                <[event.add_timer]>->(
                    {   'after'  => $timer_delay += $timer_inc,
                        'repeat' => 0,
                        'prio'   => 7,
                        'cb'     => sub { kill 55, @zenki_pid },
                        'desc' => 'SIGNUM55 send-timer [ increase lp-width ]'
                    }
                );

            } else {
                <[base.sig_NUM55]>;    ## own [ v7 zenka ] process ##
            }
        }

    } elsif ( $apw_href->{$zenka_name} > $max_len ) {
        my $delta_len = $apw_href->{$zenka_name} - $max_len;
        while ( $delta_len-- ) {
            if ( $zenka_name ne qw| v7-zenki | ) {

                ##  async dispatch  ##
                <[event.add_timer]>->(
                    {   'after'  => $timer_delay += $timer_inc,
                        'repeat' => 0,
                        'prio'   => 7,
                        'cb'     => sub { kill 41, @zenki_pid },
                        'desc' => 'SIGNUM41 send-timer [ decrease lp-width ]'

                    }
                );

            } else {
                <[base.sig_NUM41]>;    ## own [ v7 zenka ] process ##
            }
        }
    }
}

map { $apw_href->{$ARG} = $max_len if $apw_href->{$ARG} != $max_len }
    ( keys $apw_href->%* );

