## [:< ##

# name  = radio.cmd.jingle-log
# descr = radio jingle detection log buffer

my $buffer = <buffer.radio-jingle.data> // undef;

return { 'mode' => qw| size |, 'data' => '' }
    if not defined $buffer
    or ref $buffer ne qw| ARRAY |;

return {
    'mode' => qw| size |,
    'data' => join( "\n", $buffer->@* ) . "\n"
};

