## [:< ##

# name  = letsencr.child.cmd.request-certificate
# param = <domain>
# descr = request new certificate from ACME server

## $call is provided by compiled-in code header  multi-line param form   ##
## [ send.local drops param next to args ] : the domain travels as param ##
## too, the domain list space separated                                  ##
my $param = ref $call->{'param'} eq qw| HASH | ? $call->{'param'} : {};
my $domain
    = length( $call->{'args'} // '' ) ? $call->{'args'} : $param->{'domain'};

return {
    'mode' => 'false',
    'data' => 'domain parameter required'
    }
    unless defined $domain && length($domain);

<[base.log]>
    ->( 2, "child : requesting new certificate for domain : $domain" );

## log enrollment workflow to buffer
my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
<[base.buffer.add_line]>->(
    qw| enrollment-activity |,
    join( ' ',
        $time_stamp, 2, ': enrollment : cmd.request-certificate : ',
        $domain,     ' : received' ),
    2
);

## Parse additional domains from parameters (if provided)
my $alt_names = $param->{'domains'} // [$domain];
$alt_names = [ grep {length} split m{\s+}, $alt_names ] if not ref $alt_names;
my @domains = @$alt_names if ref($alt_names) eq 'ARRAY' && @$alt_names;
@domains = ($domain) unless @domains;

## Get admin email from config or parameters
my $email = $param->{'email'} || <letsencr.admin.email>;

## per-request ACME server [ staging enrollments ] : default is the ##
## zenka-wide configured server [ production ]                      ##
my $acme_server
    = length( $param->{'acme_server'} // '' )
    ? $param->{'acme_server'}
    : undef;

## Substitute :requested-domain: keyword with primary domain
$email = <[letsencr.child.substitute_admin_email]>->( $email, \@domains );

<[base.log]>->( 2, "  domains : " . join( ', ', @domains ) );
<[base.log]>->( 2, "  email : $email" );

## acme order on the event loop [ letsencr.child.acme.* ] : the reply comes
## later via reply_id, or now when acme_new refuses the request
my $result = <[letsencr.child.acme.begin]>->(
    {   'domains'  => \@domains,
        'email'    => $email,
        'server'   => $acme_server,
        'reply_id' => $call->{'reply_id'},
        'label'    => $domain,
    }
);

if ( ( $result->{'mode'} // '' ) ne qw| deferred | ) {
    <[base.buffer.add_line]>->(
        qw| enrollment-activity |,
        sprintf(
            '%s 1 : cmd.request-certificate : %s : FAILED [%s]',
            <[base.anum_log_time]>->( 5, TRUE ),
            $domain,
            $result->{'data'} // '?'
        ),
        1
    );
}

return $result;

