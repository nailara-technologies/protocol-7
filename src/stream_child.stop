## [:< ##

# name   = stream_child.stop
# descr  = end the child : the stop steps, timers between
# param  = handle
# return = TRUE when asked to end [ or ending ], FALSE if gone

## the first step runs now [ usually close : end of input ], every next one ##
## after a base.interval.next delay while the child is still there          ##

my $handle = shift;
return FALSE if not defined $handle or $handle->{'gone'};
return TRUE  if $handle->{'stopping'};
$handle->{'stopping'} = TRUE;
$handle->{'step'}     = 0;
<[stream_child.step]>->($handle);
return TRUE;

