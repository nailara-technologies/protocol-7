# name  = invoke-web.cmd.queue-set
# descr = change parameters of pending invoke.ai jobs
# param = <key>=<value> .. [ items=<id,..> ] [ batch=<id> ]
#         [ model=<text> ] [ lora=<text> ]
#         [ where <key>=<current> .. ] [ -dry-run ]

return <[invoke-web.queue.set]>->( $call->{'args'} // '' );

