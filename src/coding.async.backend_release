## [:< ##

# name  = coding.async.backend_release
# param = task_id, backend, token | 'force'
# descr = release backend lock and dispatch next queued task if any

## only the holder's CURRENT token frees the lock                           ##
## [ see the header of coding.async.backend_acquire ]. a stale connection   ##
## of this same task presents an older token and is skipped. callers that   ##
## must release unconditionally                                             ##
## [ task end, user stop / cancel, sweeps / batches ] pass 'force' -- force ##
## skips the token check only, never the holder check : a release never     ##
## frees a lock another task holds                                          ##

my ( $task_id, $backend, $token ) = @ARG;
$backend //= qw| gpu |;

my $bs = <coding.state.backend>->{$backend} // {};

my $force = ( defined $token and $token eq qw| force | ) ? TRUE : FALSE;

## guard: only release if this task holds the lock ##
if ( ( $bs->{'lock'} // '' ) ne $task_id ) {
    <[base.logs]>->(
        2, 'backend_release: %s does not hold %s lock [held by %s], skipping',
        $task_id, $backend, $bs->{'lock'} // 'none'
    );
    <[base.logs]>->(
        2,
        'lock %s: %s#%s -> %s#%s [skip release by %s#%s : not holder]',
        $backend,
        $bs->{'lock'}       // 'free',
        $bs->{'lock_token'} // '-',
        $bs->{'lock'}       // 'free',
        $bs->{'lock_token'} // '-',
        $task_id,
        $token // '-'
    );
    return FALSE;
}

## token guard : a stale caller [ older connection, or no token at all ] ##
## must not free the lock the holder's current request now holds         ##
if (not $force
    and (  not defined $token
        or not defined $bs->{'lock_token'}
        or $token ne $bs->{'lock_token'} )
) {
    <[base.logs]>->(
        1, 'backend_release: %s token %s != %s [%s], skipping',
        $task_id,
        $token // 'none',
        $bs->{'lock_token'} // '-', $backend
    );
    <[base.logs]>->(
        1,
        'lock %s: %s#%s -> %s#%s [skip release by %s#%s : stale token]',
        $backend,
        $bs->{'lock'},
        $bs->{'lock_token'} // '-',
        $bs->{'lock'},
        $bs->{'lock_token'} // '-',
        $task_id,
        $token // '-'
    );
    return FALSE;
}

my $rel_holder = $bs->{'lock'};
my $rel_token  = $bs->{'lock_token'} // '-';
my $rel_reason = $force ? q|release force| : q|release|;

$bs->{'lock'} = undef;
delete $bs->{'lock_token'};
<[base.logs]>->(
    2,        'backend_release: %s released %s lock',
    $task_id, $backend
);

## hand the lock to the next queued task [ none while the queue is paused : ##
## its resume dispatches -- see coding.async.backend_dispatch_next ]        ##
<[coding.async.backend_dispatch_next]>->(
    $backend, $rel_holder, $rel_token, $rel_reason
);

return TRUE;

