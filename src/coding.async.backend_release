## [:< ##

# name  = coding.async.backend_release
# param = task_id, backend, token | 'force'
# descr = release backend lock and dispatch next queued task if any

## only the holder's CURRENT token frees the lock [ see the header of      ##
## coding.async.backend_acquire ]. a stale connection of this same task    ##
## presents an older token and is skipped. callers that must release       ##
## unconditionally [ task end, user stop / cancel, sweeps / batches ] pass ##
## 'force' -- force skips the token check only, never the holder check : a ##
## release never frees a lock another task holds                           ##

my ( $task_id, $backend, $token ) = @ARG;
$backend //= qw| gpu |;

my $bs = <coding.state.backend>->{$backend} // {};

my $force = ( defined $token and $token eq qw| force | ) ? TRUE : FALSE;

## guard: only release if this task holds the lock ##
if ( ( $bs->{'lock'} // '' ) ne $task_id ) {
    <[base.logs]>->(
        2, 'backend_release: %s does not hold %s lock [held by %s], skipping',
        $task_id, $backend, $bs->{'lock'} // 'none'
    );
    <[base.logs]>->(
        2,
        'lock %s: %s#%s -> %s#%s [skip release by %s#%s : not holder]',
        $backend,
        $bs->{'lock'}       // 'free',
        $bs->{'lock_token'} // '-',
        $bs->{'lock'}       // 'free',
        $bs->{'lock_token'} // '-',
        $task_id,
        $token // '-'
    );
    return FALSE;
}

## token guard : a stale caller [ older connection, or no token at all ] ##
## must not free the lock the holder's current request now holds         ##
if (not $force
    and (  not defined $token
        or not defined $bs->{'lock_token'}
        or $token ne $bs->{'lock_token'} )
) {
    <[base.logs]>->(
        1, 'backend_release: %s token %s != %s [%s], skipping',
        $task_id,
        $token // 'none',
        $bs->{'lock_token'} // '-', $backend
    );
    <[base.logs]>->(
        1,
        'lock %s: %s#%s -> %s#%s [skip release by %s#%s : stale token]',
        $backend,
        $bs->{'lock'},
        $bs->{'lock_token'} // '-',
        $bs->{'lock'},
        $bs->{'lock_token'} // '-',
        $task_id,
        $token // '-'
    );
    return FALSE;
}

my $rel_holder = $bs->{'lock'};
my $rel_token  = $bs->{'lock_token'} // '-';
my $rel_reason = $force ? q|release force| : q|release|;

$bs->{'lock'} = undef;
delete $bs->{'lock_token'};
<[base.logs]>->(
    2,        'backend_release: %s released %s lock',
    $task_id, $backend
);

## dequeue next waiting task and resume it : skip entries whose task has    ##
## already finished [ task_state deleted by async.complete -- eg aborted or ##
## failed while queued ]. handing the lock to one of those leaked it        ##
## permanently : send_request bails with "no state" and never releases      ##
my $next;
while ( defined( $next = shift @{ $bs->{'queue'} // [] } ) ) {
    last if exists <coding.async.task_state>->{$next};
    <[base.logs]>->(
        1,     'backend_release: dropping finished task %s from %s queue',
        $next, $backend
    );
    <[base.logs]>->(
        1, 'lock %s: %s#%s -> free [drop %s finished]',
        $backend, $rel_holder, $rel_token, $next
    );
}
if ( defined $next ) {
    <[base.logs]>->(
        1,     'backend_release: dispatching next queued task %s [%s]',
        $next, $backend
    );
    ## acquire for next task with a fresh token, then resume its request ##
    ## inside a lock context presenting that token [ async.request's     ##
    ## acquire re-enters and rotates it ]                                ##
    my $handoff_token = ++$bs->{'token_counter'};
    $bs->{'lock'}       = $next;
    $bs->{'lock_token'} = $handoff_token;
    <[base.logs]>->(
        1, 'lock %s: %s#%s -> %s#%d [handoff, %s]',
        $backend, $rel_holder, $rel_token, $next, $handoff_token, $rel_reason
    );
    my $sent = do {
        local <coding.async.lock_ctx> = {
            'task_id' => $next,
            'backend' => $backend,
            'token'   => $handoff_token
        };
        <[coding.async.send_request]>->($next);
    };

    ## send_request bailed before any request took the lock over [ its ##
    ## token is still the handoff token ] : don't leak it              ##
    if (    ref $sent eq qw| HASH |
        and not $sent->{'success'}
        and ( $bs->{'lock'}       // '' ) eq $next
        and ( $bs->{'lock_token'} // 0 ) == $handoff_token ) {
        <[base.logs]>->(
            1,     'backend_release: handoff to %s not taken [%s], releasing',
            $next, $sent->{'error'} // 'unknown'
        );
        <[coding.async.backend_release]>->( $next, $backend, $handoff_token );
    }
} else {
    <[base.logs]>->(
        1, 'lock %s: %s#%s -> free [%s]',
        $backend, $rel_holder, $rel_token, $rel_reason
    );
}

return TRUE;

