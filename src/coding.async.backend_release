# name  = coding.async.backend_release
# param = task_id, backend, [ req_seq ]
# descr = release backend lock and dispatch next queued task if any

my ( $task_id, $backend, $req_seq ) = @ARG;
$backend //= qw| gpu |;

my $bs = <coding.state.backend>->{$backend} // {};

## guard: only release if this task holds the lock ##
if ( ( $bs->{'lock'} // '' ) ne $task_id ) {
    <[base.logs]>->(
        2, 'backend_release: %s does not hold %s lock [held by %s], skipping',
        $task_id, $backend, $bs->{'lock'} // 'none'
    );
    <[base.logs]>->(
        2,
        'lock %s: %s#%s -> %s#%s [skip release by %s#%s : not holder]',
        $backend,
        $bs->{'lock'}     // 'free',
        $bs->{'lock_seq'} // '-',
        $bs->{'lock'}     // 'free',
        $bs->{'lock_seq'} // '-',
        $task_id,
        $req_seq // '-'
    );
    return FALSE;
}

## optional seq guard : per-connection callbacks pass their request seq ; a ##
## stale connection of this same task must not free the lock a newer        ##
## request holds [ callers without a seq release unconditionally ]          ##
if (    defined $req_seq
    and defined $bs->{'lock_seq'}
    and $req_seq != $bs->{'lock_seq'} ) {
    <[base.logs]>->(
        1, 'backend_release: %s stale seq %d != %d [%s], skipping',
        $task_id, $req_seq, $bs->{'lock_seq'}, $backend
    );
    <[base.logs]>->(
        1,
        'lock %s: %s#%s -> %s#%s [skip '
            . 'release by %s#%s : stale seq %d != %d]',
        $backend,
        $bs->{'lock'},
        $bs->{'lock_seq'},
        $bs->{'lock'},
        $bs->{'lock_seq'},
        $task_id,
        $req_seq,
        $req_seq,
        $bs->{'lock_seq'}
    );
    return FALSE;
}

my $rel_holder = $bs->{'lock'};
my $rel_seq    = $bs->{'lock_seq'} // '-';

$bs->{'lock'} = undef;
delete $bs->{'lock_seq'};
<[base.logs]>->(
    2,        'backend_release: %s released %s lock',
    $task_id, $backend
);

## dequeue next waiting task and resume it : skip entries whose task has    ##
## already finished [ task_state deleted by async.complete -- eg aborted or ##
## failed while queued ]. handing the lock to one of those leaked it        ##
## permanently : send_request bails with "no state" and never releases      ##
my $next;
while ( defined( $next = shift @{ $bs->{'queue'} // [] } ) ) {
    last if exists <coding.async.task_state>->{$next};
    <[base.logs]>->(
        1,     'backend_release: dropping finished task %s from %s queue',
        $next, $backend
    );
    <[base.logs]>->(
        1, 'lock %s: %s#%s -> free [drop %s finished]',
        $backend, $rel_holder, $rel_seq, $next
    );
}
if ( defined $next ) {
    <[base.logs]>->(
        1,     'backend_release: dispatching next queued task %s [%s]',
        $next, $backend
    );
    ## acquire for next task then resume its request ##
    $bs->{'lock'} = $next;
    <[base.logs]>->(
        1, 'lock %s: %s#%s -> %s#- [handoff]',
        $backend, $rel_holder, $rel_seq, $next
    );
    <[coding.async.send_request]>->($next);
} else {
    <[base.logs]>->(
        1, 'lock %s: %s#%s -> free [release]',
        $backend, $rel_holder, $rel_seq
    );
}

return TRUE;

