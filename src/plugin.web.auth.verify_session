## [:< ##

# name  = plugin.web.auth.verify_session
# descr = validate session token from cookie or Authorization header
# param = session hashref (httpd) or token string

my $input = shift // '';
my $token = '';

## context detection ##
my $zenka = <system.zenka.name> // qw| web |;

if ( ref $input eq qw| HASH | and exists $input->{'http'} ) {
    ## httpd session hash ##
    my $headers = $input->{'http'}->{'request'}->{'headers'} // {};

    ## check Authorization: Bearer <token> ##
    my $auth = $headers->{'authorization'} // '';
    if ( $auth =~ m|^Bearer\s+(\S+)$|i ) {
        $token = $LAST_PAREN_MATCH;
    }

    ## fallback to Cookie: p7_session=<token> ##
    if ( not length $token ) {
        my $cookie = $headers->{'cookie'} // '';
        if ( $cookie =~ m|\bp7_session=([^;\s]+)| ) {
            $token = $LAST_PAREN_MATCH;
        }
    }
} elsif ( length $input and not ref $input ) {
    ## direct token string ##
    $token = $input;
}

return undef if not length $token;

## fail closed without a configured secret [ host config ] ##
my $cfg    = $data{'plugin.web.auth'}{'cfg'} // {};
my $secret = $cfg->{'secret'}                // '';
if ( not length $secret ) {
    if ( not <plugin.web.auth.warned_no_secret> ) {
        <plugin.web.auth.warned_no_secret> = TRUE;
        <[base.logs]>->(
            1,
            'plugin.web.auth : no web.auth.secret '
                . 'in host config : auth fail closed'
        );
    }
    return undef;
}

## compute token hash ##
my $token_hash = <[chk-sum.bmw.L13-str]>->($token);
return undef if not defined $token_hash;

## read session file ##
my $session_data = <[plugin.web.auth.session.read]>->($token_hash);
return undef if not defined $session_data;

## secret binding : a session minted under a different secret is refused ##
## [ rotating the host secret revokes every outstanding token ]          ##
my $current_secret_hash = <[chk-sum.bmw.L13-str]>->($secret);
return undef if not defined $current_secret_hash;
my $session_secret_hash = $session_data->{'secret_hash'} // '';
if ( length $session_secret_hash
    and $session_secret_hash ne $current_secret_hash ) {
    <[base.logs]>->(
        2, 'plugin.web.auth : session secret mismatch : refused [ %s ]',
        $token_hash
    );
    return undef;
}

## check expiry ##
my $now     = time;
my $expires = $session_data->{'expires_at_epoch'} // 0;

if ( $expires > 0 and $now > $expires ) {
    <[plugin.web.auth.destroy_session]>->($token_hash);
    return undef;
}

## update last_seen ##
$session_data->{'last_seen'}       = <[base.ntime.b32]> // '';
$session_data->{'last_seen_epoch'} = $now;

<[plugin.web.auth.session.write]>->( $token_hash, $session_data );

return $session_data;

