## [:< ##

# name  = coding.model_sweep.cmd.model-sweep
# descr = start a per-backend model sweep
# param = [backend] [filter tokens] [:no_yield:] [:restart:]

my $params = shift             // {};
my $args   = $params->{'args'} // '';

## extract filter + yield-opt-out + restart tokens using substitutive       ##
## extraction, order-independent. :restart: is the explicit, auditable      ##
## opt-in for the DESTRUCTIVE path [ discard an existing paused/orphaned    ##
## cursor and start completely fresh ] -- the safe path [ resume a          ##
## matching-filter, non-paused cursor automatically ] stays implicit, as it ##
## already did before this flag existed. previously the only way to discard ##
## a stale cursor was deleting state/model_sweep_cursor.yaml by hand        ##
## outside the zenka's own command interface. deliberately does NOT         ##
## override an ACTIVELY RUNNING in-memory sweep [ that still requires       ##
## model-sweep-cancel first -- :restart: is scoped to disk-cursor cleanup,  ##
## not live-timer teardown, per explicit user direction ]                   ##
my $re_test_failed  = ( $args =~ s| *:re-test-failed: *| | );
my $re_test_success = ( $args =~ s| *:re-test-success: *| | );
my $no_yield        = ( $args =~ s| *:no_yield: *| | );
my $restart         = ( $args =~ s| *:restart: *| | );

$args =~ s|^\s+||;
$args =~ s|\s+$||;
my $backend_arg = length $args ? $args : qw| both |;

unless ( $backend_arg =~ m{^(gpu|cpu|both)$} ) {
    return {
        mode => qw| size |,
        data => "Error: backend must be gpu, cpu, or both\n"
    };
}

my @backends = $backend_arg eq qw| both | ? qw| gpu cpu | : ($backend_arg);

## determine filter label for the cursor file ##
my $filter_str;
if ( $re_test_failed && $re_test_success ) {
    $filter_str = qw| full |;
} elsif ($re_test_failed) {
    $filter_str = qw| re-test-failed |;
} elsif ($re_test_success) {
    $filter_str = qw| re-test-success |;
} else {
    $filter_str = qw| default |;
}

## load status data once [ memory first, disk fallback ] ##
my $status_data = <coding.model_status> // {};
if ( !%$status_data ) {
    my $saved_ref = <[file.zenka_dir.load]>->('state/model_status.yaml');
    $status_data
        = ( defined $saved_ref and length $$saved_ref )
        ? ( <[format.yaml.load_str]>->($$saved_ref) // {} )
        : {};
}

my $metadata      = <coding.model_metadata> // {};
my $cursor_file   = 'state/model_sweep_cursor.yaml';
my $existing_yaml = <[file.zenka_dir.load]>->($cursor_file);
my $cursor_data
    = ( defined $existing_yaml and length $$existing_yaml )
    ? ( <[format.yaml.load_str]>->($$existing_yaml) // {} )
    : {};

my @lines;

for my $backend (@backends) {
    ## refuse if a sweep is already active for this backend -- a PAUSED     ##
    ## sweep deliberately keeps its in-memory state defined, so distinguish ##
    ## : paused points at model-sweep-resume instead of the bare refusal [  ##
    ## reporting a resumable pause as "already in progress" is the          ##
    ## misleading-status class this distinction fixes ]                     ##
    if ( defined <coding.model_sweep_state>->{$backend} ) {
        my $active = <coding.model_sweep_state>->{$backend};
        my $active_state
            = ref $active eq qw| HASH |
            ? ( $active->{'state'} // qw| running | )
            : qw| running |;
        if ( $active_state eq qw| paused | ) {
            my $why = $active->{'paused_reason'} // '';
            push @lines,
                sprintf '%s : paused%s -- use model-sweep-resume %s to '
                . 'continue, or model-sweep-cancel %s to discard',
                $backend,
                ( length $why ? " [ $why ]" : '' ),
                $backend, $backend;
        } else {
            push @lines, sprintf '%s : already in progress', $backend;
        }
        next;
    }

    ## resume if a resumable cursor exists on disk for the SAME filter --  ##
    ## the in-memory sweep state is gone [ zenka restart ] but the on-disk ##
    ## cursor survived, so pick up exactly where it left off instead of    ##
    ## silently dropping the progress or forcing a fresh rebuild           ##
    my $existing = $cursor_data->{$backend} // {};
    if (   !$restart
        && ref $existing eq qw| HASH |
        && ( $existing->{'idx'} // 0 )
        < scalar( @{ $existing->{'candidates'} // [] } ) ) {
        ## a paused cursor is NEVER auto-resumed by a plain model-sweep     ##
        ## call : resume goes through model-sweep-resume, which gates       ##
        ## circuit-breaker pauses on :force: -- silently bypassing that     ##
        ## gate here is how the remaining candidates get burned on the same ##
        ## bad data a second time                                           ##
        if ( ( $existing->{'state'} // '' ) eq qw| paused | ) {
            my $why = $existing->{'paused_reason'} // '';
            push @lines,
                sprintf '%s : sweep is paused [ idx=%d/%d, filter=%s ]%s '
                . '-- use model-sweep-resume %s%s to continue',
                $backend,
                $existing->{'idx'} // 0,
                scalar( @{ $existing->{'candidates'} // [] } ),
                $existing->{'filter'} // qw| default |,
                ( length $why ? " [ $why ]" : '' ),
                $backend,
                ( length $why ? ' :force:' : '' );
            next;
        }
        if ( ( $existing->{'filter'} // '' ) eq $filter_str ) {
            ## a resumed sweep starts with a clean breaker streak ##
            delete <coding.model_sweep_breaker>->{$backend};
            <coding.model_sweep_state>->{$backend} = {
                backend    => $backend,
                candidates => $existing->{'candidates'},
                idx        => $existing->{'idx'} // 0,
                filter     => $filter_str,
                started    => $existing->{'started'} // <[base.ntime]>,
                switch_id  => '',
                phase      => qw| idle |,
                state      => qw| running |,
                ## an explicit :no_yield: re-arms the opt-out ; without the ##
                ## token the cursor's own flag carries through [ it is      ##
                ## meant to survive a zenka restart ]                       ##
                no_yield => $no_yield
                ? TRUE
                : ( $existing->{'no_yield'} // FALSE ),
            };
            <[event.add_timer]>->(
                {   'interval' => 1,
                    'repeat'   => TRUE,
                    'handler'  => qw| coding.model_sweep.handler.poll_sweep |,
                    'data'     => { backend => $backend },
                    'desc'     => "model-sweep $backend"
                }
            );
            push @lines,
                sprintf '%s : resumed [ idx=%d/%d, filter=%s ]',
                $backend,
                $existing->{'idx'} // 0,
                scalar( @{ $existing->{'candidates'} // [] } ),
                $filter_str;
        } else {
            ## different filter requested : starting fresh would silently ##
            ## discard the other filter's progress -- refuse instead      ##
            push @lines,
                  sprintf '%s : resumable cursor exists for filter=%s [ '
                . 'idx=%d/%d ] -- re-run with that filter to '
                . 'resume it, or delete '
                . 'state/model_sweep_cursor.yaml by hand to '
                . 'discard it and start filter=%s fresh',
                $backend,
                $existing->{'filter'} // 'default',
                $existing->{'idx'}    // 0,
                scalar( @{ $existing->{'candidates'} // [] } ),
                $filter_str;
        }
        next;
    }

    ## :restart: discarded a real existing cursor : say so explicitly --   ##
    ## the whole point of the flag over the old hand-delete-the-yaml       ##
    ## workaround is that this is now visible in the command's own output, ##
    ## not a silent loss                                                   ##
    if (    $restart
        and ref $existing eq qw| HASH |
        and ( $existing->{'idx'} // 0 )
        < scalar( @{ $existing->{'candidates'} // [] } ) ) {
        push @lines,
            sprintf '%s : :restart: discarded existing '
            . 'cursor [ idx=%d/%d, filter=%s ]',
            $backend,
            $existing->{'idx'} // 0,
            scalar( @{ $existing->{'candidates'} // [] } ),
            $existing->{'filter'} // qw| default |;
    }

    ## build candidate list for this backend ##
    my @candidates;
    for my $cache_name ( sort keys %$metadata ) {
        next if $cache_name =~ m|mmproj|i;
        my $entry = $metadata->{$cache_name};
        next if ref $entry ne qw| HASH |;
        my $checksum = $entry->{'amos'} // '';
        next if !length $checksum;

        my $current_status = '';
        my $status_entry   = $status_data->{$checksum}{$backend};
        if ( ref $status_entry eq qw| HASH | ) {
            $current_status = $status_entry->{'status'} // '';
        }

        ## apply filter mode ##
        my $include = 0;
        if ( $filter_str eq qw| full | ) {
            $include = 1;
        } elsif ( $filter_str eq qw| default | ) {
            $include = 1 if !length $current_status;
        } elsif ( $filter_str eq qw| re-test-failed | ) {
            $include = 1
                if !length $current_status
                || $current_status eq qw| startup-failure |
                || $current_status eq qw| inference-failures |
                || $current_status eq qw| resource-insufficient |;
        } elsif ( $filter_str eq qw| re-test-success | ) {
            $include = 1
                if !length $current_status
                || $current_status eq qw| functional |;
        }

        next if !$include;

        ## pre-filter by resource fit [ do not record status here ] ##
        my $fit = <[coding.helper.check_resource_fit]>->(
            { backend => $backend, size_gb => $entry->{'size_gb'} // 0 } );
        next if !$fit->{'fits'};

        push @candidates, $checksum;
    }

    my $total = scalar @candidates;
    if ( !$total ) {
        push @lines,
            sprintf '%s : no candidates match filter=%s',
            $backend, $filter_str;
        next;
    }

    ## persist initial cursor ##
    $cursor_data->{$backend} = {
        filter     => $filter_str,
        candidates => \@candidates,
        idx        => 0,
        started    => <[base.ntime]>,
        state      => qw| running |,
    };
    $cursor_data->{$backend}{'no_yield'} = TRUE if $no_yield;
    my $yaml_str = <[format.yaml.dump_str]>->($cursor_data);
    if ( length $yaml_str ) {
        <[file.zenka_dir.write]>->( $cursor_file, \$yaml_str, qw| > |, 0640 )
            or <[base.logs]>->(
            1, '[model_sweep] failed to persist cursor file [ %s ]',
            $cursor_file
            );
    }

    ## initialize in-memory state and start the sweep timer -- a fresh ##
    ## sweep starts with a clean circuit-breaker streak                ##
    delete <coding.model_sweep_breaker>->{$backend};
    <coding.model_sweep_state>->{$backend} = {
        backend    => $backend,
        candidates => \@candidates,
        idx        => 0,
        filter     => $filter_str,
        started    => <[base.ntime]>,
        switch_id  => '',
        phase      => qw| idle |,
        state      => qw| running |,
        no_yield   => $no_yield ? TRUE : FALSE,
    };

    <[event.add_timer]>->(
        {   'interval' => 1,
            'repeat'   => TRUE,
            'handler'  => qw| coding.model_sweep.handler.poll_sweep |,
            'data'     => { backend => $backend },
            'desc'     => "model-sweep $backend"
        }
    );

    push @lines,
        sprintf '%s : sweep started : %d candidates [filter=%s]',
        $backend, $total, $filter_str;
}

return { mode => qw| size |, data => join( "\n", @lines ) . "\n" };

