## [:< ##

# name  = sessions.holder.detach
# descr = close [ not kill ] the control connection -- this is what
#         actually forces the child out of its blocking ATTACHED read via
#         EOF, into the DORMANT pause() wait. A plain SIGUSR2 follows as
#         after-the-fact corroboration only [ logged child-side, no state
#         effect ] -- EOF is authoritative. Child process keeps running,
#         mlock'd and dormant, so a later reattach is fast and does not
#         re-derive the key.

if ( ( <sessions.holder.state> // '' ) ne qw| attached | ) {
    <[base.logs]>->( 0, 'sessions.holder.detach: not attached' );
    return undef;
}

my $pid = <sessions.holder.pid>;
if ( not defined $pid or not <[base.exists.sub-process]>->($pid) ) {
    <[base.logs]>->( 0, 'sessions.holder.detach: child not alive' );
    return undef;
}

my $sock = <sessions.holder.client_sock>;
if ( defined $sock ) {
    shutdown( $sock, 2 );
    close($sock);
}
<sessions.holder.client_sock> = undef;
<sessions.holder.state>       = qw| dormant |;

kill qw| USR2 |, $pid;

<[base.logs]>->( 1, 'sessions.holder: detached (pid %d)', $pid );

return TRUE;

