## [:< ##

# name = nshell.history.page_down
# descr = Session-based page down navigation (older history entries)

my ( $state_ref, $editor, $colors ) = @ARG;

## Configuration
my $session_gap_minutes = 10 // 13;
my $gap_seconds         = $session_gap_minutes * 60;

## At prompt: PageDown should stay at prompt  But render empty prompt to clear
## any stray init cursor
if ( $state_ref->{'current_history_index'} < 0 ) {
    <[nshell.render.empty_prompt]>->( $state_ref, $editor, $colors );
    return;
}

## Already viewing history - use tracked index
my $current_index = $state_ref->{'current_history_index'};

## Use paging stack if available [ set by Page Up ]  This ensures Page Down
## follows exact Page Up path in reverse
my $target_index;

if ( $state_ref->{'paging_index_stack'}->@* ) {
    ## Stack has indices from Page Up - use them in reverse order [LIFO]
    $target_index = pop $state_ref->{'paging_index_stack'}->@*;
} else {
    ## No stack entries - find next older session boundary normally
    $target_index = <[nshell.history.find_session_boundary]>->(
        $current_index, -1, $gap_seconds
    );
}

## Default to -1 if no result
$target_index = -1 unless defined $target_index;

## If no older session found, return to empty prompt
if ( $target_index < 0 ) {
    $state_ref->{'current_history_index'} = -1;
    $state_ref->{'paging_index_stack'}    = [];    # Clear paging stack
    <[nshell.render.empty_prompt]>->( $state_ref, $editor, $colors );
    return;
}

## Load and display the target entry
if ( $target_index >= 0 && $target_index < @AMOS7::TERM::history_entries ) {
    my $entry = $AMOS7::TERM::history_entries[$target_index];
    if ( ref($entry) eq 'ARRAY' && $entry->[1] ) {
        my $lines_ref = $entry->[1];

        ## clear current line [ \e[2K avoids wrap on long lines ]
        print "\r\e[2K";

        $state_ref->{'display_buffer'}        = join "\n", $lines_ref->@*;
        $state_ref->{'current_history_index'} = $target_index;

        ## Load into editor to sync editor buffer
        <[editor.control.load_field]>->(
            $editor, 'command', $state_ref->{'display_buffer'}
        );

        my $display_buffer
            = $colors{'p7_fg_0004'} . $state_ref->{'display_buffer'};

        ## Redraw full line with cursor
        <[nshell.render.full_line]>->( $editor, $display_buffer, $colors );

        ## Enter VIEWING_HISTORY mode
        $state_ref->{'current_mode'} = 2;    # VIEWING_HISTORY
    }
}

return;

