# name  = pager.util.encode.is_valid_state
# descr = Validate division-13 state by checking bit balance

my ( $num, $main_42 ) = @ARG;
my $bits  = sprintf( '%b', $num );
my $ones  = $bits =~ tr/1//;
my $zeros = length($bits) - $ones;
return abs( $ones - $zeros ) < length($bits) * 0.4;

