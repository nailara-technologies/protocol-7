## [:< ##
# name  = plan-9.cmd.export-directory
# descr = Export a real directory for 9P access [ read-only ]

my $args = $call->{'args'} // '';
my ( $real_path, $name ) = split /\s+/, $args, 2;

if ( not defined $real_path or not length $real_path ) {
    return {
        'mode' => 'false',
        'data' => 'usage: export-directory ' . '<path> <name>'
    };
}

$name //= '';
if ( not length $name ) {
    ($name) = $real_path =~ m{([^/]+)/?$};
}

my $ok = <[plan-9.server.export_directory]>->( $real_path, $name );

if ($ok) {
    return {
        'mode' => 'size',
        'data' => "Exported $real_path as '$name'\n"
    };
} else {
    return {
        'mode' => 'false',
        'data' => "Failed to export $real_path -- check "
            . "it's a real, absolute directory path"
    };
}

