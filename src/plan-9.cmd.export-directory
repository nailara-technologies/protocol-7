## [:< ##
# name  = plan-9.cmd.export-directory
# descr = Export a real directory for 9P access
#         <path> <name> [:rw:] [:symlinks: reject|contained|allow]

my $args = $call->{'args'} // '';
my @tok  = split /\s+/, $args;

my $real_path = shift @tok;

if ( not defined $real_path or not length $real_path ) {
    return {
        'mode' => 'false',
        'data' => 'usage: export-directory <path> <name> '
            . '[:rw:] [:symlinks: reject|contained|allow]'
    };
}

my $name;
if ( @tok and $tok[0] !~ /^:/ ) {
    $name = shift @tok;
}
$name //= '';
if ( not length $name ) {
    ($name) = $real_path =~ m{([^/]+)/?$};
}

my $writable       = 0;
my $symlink_policy = 'reject';

for ( my $i = 0; $i < @tok; $i++ ) {
    if ( $tok[$i] eq ':rw:' ) {
        $writable = 1;
    } elsif ( $tok[$i] eq ':symlinks:' and $i + 1 < @tok ) {
        my $val = $tok[ ++$i ];
        $symlink_policy = $val if $val =~ /^(?:reject|contained|allow)$/;
    }
}

my $ok = <[plan-9.server.export_directory]>->(
    $real_path, $name, $writable, $symlink_policy
);

if ($ok) {
    my $mode = $writable ? 'read-write' : 'read-only';
    return {
        'mode' => 'true',
        'data' => "exported $real_path as '$name' "
            . "[$mode, symlinks:$symlink_policy]"
    };
} else {
    return {
        'mode' => 'false',
        'data' => "failed to export $real_path -- check "
            . "it's a real, absolute directory path"
    };
}

