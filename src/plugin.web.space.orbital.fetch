## [:< ##

# name  = plugin.web.space.orbital.fetch
# descr = async fetch orbital data from orbital layer zenki not yet on
#         STRM push ; 'known'/'connections'/'self'/'gm_state' arrive via
#         push instead [ see plugin.web.space.orbital.subscribe_* ] -
#         only nameserv remains polled here

## request nameserv data if configured ##
my $nameserv_domain = <nameserv.cfg.auto_publish_domain> // '';
if ( length $nameserv_domain ) {
    <[protocol-7.route-send]>->(
        {   qw| command |   => qw| nameserv.discover-nodes |,
            qw| call_args | => { qw| args | => $nameserv_domain },
            qw| reply |     => {
                qw| handler | => qw| plugin.web.space.orbital.handler.reply |,
                qw| params |  => { qw| field | => qw| nameserv | },
            }
        }
    );
}

<[base.log]>->( 3, qq| orbital fetch dispatched | );

return 1;

