# name  = coding.async.round_soft_restart
# descr = escalate the round ceiling and re-dispatch in place
# param = <task_id> [hard_ceiling]

my $task_id      = shift;
my $hard_ceiling = shift // <coding.http-timeouts.request-completed> // 780;

return undef unless defined $task_id;

my $task_state = <[coding.async.state_manager]>->( qw| get |, $task_id );
return undef unless defined $task_state;

$task_state->{'timeout_ceiling'} = $hard_ceiling;

## the connection this round held is already torn down by the caller [   ##
## http_cleanup ], but the backend serialization lock is separate — must ##
## free it before send_request re-acquires it for the redispatch         ##
my $backend = $task_state->{'backend'} // '';
<[coding.async.backend_release]>->( $task_id, $backend )
    if length $backend;

## re-dispatch shortly : reuses the existing retry handler [ same one     ##
## coding.callback.http_error schedules for genuine errors ] — its job is ##
## just "re-send the request for this task", which is exactly what a      ##
## soft-ceiling restart needs too                                         ##
<[event.add_timer]>->(
    {   'after'   => 0.1,
        'handler' => qw| coding.callback.retry_request |,
        'data'    => $task_id
    }
);

return TRUE;

