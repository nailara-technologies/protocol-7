# name  = external.cmd.orbital-status
# descr = show orbital layer health status

my $p7ref = <nodes.orbital.current_p7ref> // 'unknown';

my $known_ref   = <discover.orbital.known> // {};
my $known_count = scalar keys %$known_ref;

my $conn_ref   = <external.connections> // {};
my $conn_count = scalar keys %$conn_ref;

my $transports    = <external.transports> // {};
my $transport_str = 'not initialized';
if ( defined $transports->{'preferred'} ) {
    $transport_str = sprintf(
        'preferred=%s available=%d',
        $transports->{'preferred'} // 'none',
        scalar @{ $transports->{'available'} // [] }
    );
}

my $output = "\n";
$output .= sprintf( "our orbital p7ref    : %s\n", $p7ref );
$output .= sprintf( "known orbital nodes  : %d\n", $known_count );
$output .= sprintf( "active connections   : %d\n", $conn_count );
$output .= sprintf( "transport registry   : %s\n", $transport_str );

return { 'mode' => qw| size |, 'data' => $output };

