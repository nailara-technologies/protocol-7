## [:< ##

# name  = letsencr.x509_field
# descr = extract x509 field from PEM certificate

my ( $pem, $field ) = @ARG;

my $x509 = eval {
    Crypt::OpenSSL::X509->new_from_string( $pem,
        Crypt::OpenSSL::X509::FORMAT_PEM() );
};
return undef unless defined $x509;

## map openssl CLI field names to X509 methods
if ( $field eq '-subject' ) {
    return $x509->subject();
} elsif ( $field eq '-issuer' ) {
    return $x509->issuer();
}

return undef;

