## [:< ##

# name  = screen.setup.cmd.display-layouts
# descr = open a scaled minimap of the discovered monitor layout
# note  = returns a xrandr-like text summary of the rects and their offsets

my $monitors = <[screen.setup.enumerate-monitors]>;

return { 'mode' => qw| false |, 'data' => 'no monitors enumerated' }
    if not defined $monitors or not @$monitors;

my $model = <[screen.setup.layout-model]>->($monitors);

## text summary [ name WxH+x+y, one per line ] + the virtual bounds ##
my @lines;
for my $m (@$monitors) {
    push @lines,
        sprintf(
        '%-14s %dx%d+%d+%d%s',
        length $m->{'name'} ? $m->{'name'} : "monitor-$m->{'index'}",
        $m->{'width'},
        $m->{'height'},
        $m->{'x'},
        $m->{'y'},
        $m->{'primary'} ? ' [primary]' : ''
        );
}
push @lines,
    sprintf( '%-14s %dx%d', 'virtual', $model->{'width'},
    $model->{'height'} );

my $summary = join "\n", @lines;

## unique per-request id, mirrors window.place instance handling ##
my $id;
do { $id = <[base.prng.chars-anum]>->(8) }
    while exists <screen-setup.instances>->{$id};

<screen-setup.instances>->{$id} = {
    'monitors'       => $monitors,
    'model'          => $model,
    'windows'        => [],
    'windows_temp'   => {},
    'window_pending' => 0,
};

## fetch currently-open windows so the minimap can overlay them ##
<[base.zenki.resolve_primary_sid]>->(
    'X-11',
    sub {
        my $sid = shift;
        return if not defined $sid;
        <[protocol-7.route-send]>->(
            {   'command'   => "$sid.get-windows",
                'call_args' => { 'args' => '' },
                'reply'     => {
                    'handler' => qw| screen.setup.handler.windows_reply |,
                    'params'  => { 'id' => $id }
                }
            }
        );
    }
);

## open the window after the command handler has returned ##
<[event.add_timer]>->(
    {   'after' => 0,
        'cb'    => sub { <[screen.setup.open_window]>->($id) },
    }
);

return { 'mode' => qw| size |, 'data' => $summary };

