## [:< ##
# name  = storage.9p.rename-path
# descr = High-level rename over 9P (walk+wstat+clunk)

my ( $conn, $path, $new_name ) = @ARG;

my @parts = grep {length} split m|/|, $path;
my $fid   = $conn->{next_fid}++;

my $walk_result
    = <[storage.9p.walk]>->( $conn, $conn->{root_fid}, $fid, @parts );
return $walk_result if $walk_result->{'mode'} eq 'false';

my $wstat_result
    = <[storage.9p.wstat]>->( $conn, $fid, { name => $new_name } );

<[storage.9p.clunk]>->( $conn, $fid );

return $wstat_result;

