## [:< ##

# name  = auth.client.auth-keypair.authenticate
# descr = authenticate to a peer's cube via the auth-keypair method,
#         modeled directly on auth.client.zenka.authenticate's own
#         banner-read + select-method + auth-line + reply-parse shape
# param = <backend_socket> <as_username> <session_key_name> <base_key_name>
#         { host, port } [ the server key pin : auth.client.server_pin.check ]
# return = the binding context [ a hash ref : server_nonce, server_pub,
#          username, base_key_name -- raw bytes ] for protocol.protocol-7.
#          link-upgrade.handshake, undef on any failure
#
# wire v2 [ data/md/design/AUTH-LINK-BINDING.md ] + host-root delegation
# [ HOST-ROOT-DELEGATION.md ] : the select reply is 'TRUE <S_pub b32>
# <server_nonce b32> <delegation b32>' ; the delegation of S_pub is
# verified under the pinned host-root BEFORE the auth line is sent ;
# auth_sig signs auth.binding.message 'auth'

my ($backend_socket, $as_username, $session_key_name,
    $base_key_name,  $server_id
) = @ARG;

if ( not defined $backend_socket ) {
    warn 'socket param undefined, cannot '
        . 'authenticate [ auth-keypair ] <{C1}>';
    return undef;
} elsif (
    not <[base.is_defined_recursive]>->(qw| protocol.protocol-7.connect |) ) {
    warn 'protocol.protocol-7 module not loaded, '
        . 'cannot authenticate [ auth-keypair ] <{C1}>';
    return undef;
}

my $re_proto_banner = <protocol.protocol-7.regex.protocol-version>;

if ( not defined $re_proto_banner
    or index( ref $re_proto_banner, qw| Regexp | ) == -1 ) {
    warn 'protocol banner regexp not defined, cannot authenticate <{C1}>';
    return undef;
}

my $protocol_messages = <protocol.protocol-7.connect>;
my $protocol_banner   = $protocol_messages->{'banner'};
my $proto_msg_timeout = $protocol_messages->{'timeout'};

if (   not defined $backend_socket
    or not -S $backend_socket
    or not $backend_socket->connected ) {
    <[base.log]>->(
        0, 'auth.auth-keypair : cannot authenticate [ have no valid socket ]'
    );
    return undef;
}

my $read_len = max( map {length} $protocol_banner, $proto_msg_timeout );
my $bytes_read
    = <[base.s_read]>->( $backend_socket, \my $banner_string, $read_len )
    // 0;

if ( $bytes_read <= 0 ) {
    <[base.logs]>->(
        0, 'auth.auth-keypair : [#] network error [ nothing read ]'
    );
    return undef;
}

if ( $banner_string !~ $re_proto_banner ) {
    <[base.logs]>->(
        0,
        '[#] protocol mismatch [ no valid connection banner \ auth-keypair ]'
    );
    return undef;
}

<[base.logs]>->( 2, '[*] Protocol 7 banner detected.,' );

## NOT protocol.protocol-7.auth.select-method -- that helper hard-requires the
## reply be literally 'TRUE continue' (real gap found 2026-08-11: it is only
## correct for methods like 'zenka' that ack that way).  auth.auth_select's
## own auth-keypair branch replies 'TRUE <server_pubkey_b32> <nonce_b32>'
## instead [ pinned server key + the nonce auth_sig binds to ], a different
## shape the generic helper rejects as a protocol error. Selecting inline.
my $select_template = <protocol.protocol-7.connect>->{'select-method'}
    // "select %s\n";
<[base.net.send_to_socket]>->(
    $backend_socket, sprintf( $select_template, qw| auth-keypair | )
);
my $select_reply = readline($backend_socket);
chomp($select_reply) if defined $select_reply;

## 4th field : the delegation chain of S [ required, <= 2048, leaf first, ##
## '.' between statements -- trust.chain checks the shape ]               ##
my ( $server_pub_b32, $server_nonce_b32, $delegation_b32 )
    = ( $select_reply // '' )
    =~ m|\ATRUE ([A-Z2-7]+) ([A-Z2-7]+) ([A-Z2-7.]{1,2048})\z|;

if ( not defined $delegation_b32 ) {
    <[base.logs]>->(
        0,
        '[#] select auth-keypair failed [ no '
            . 'server key + nonce + delegation ] : %.160s',
        $select_reply // '<none>'
    );
    return undef;
}

my $server_pub   = eval { Crypt::Misc::decode_b32r($server_pub_b32) };
my $server_nonce = eval { Crypt::Misc::decode_b32r($server_nonce_b32) };

if (   not defined $server_pub
    or length($server_pub) != 32
    or not defined $server_nonce
    or length($server_nonce) != 32 ) {
    <[base.logs]>->(
        0, '[#] select auth-keypair failed [ server key \\ nonce not valid ]'
    );
    return undef;
}

## the host-root pin + delegation decide BEFORE anything is signed or sent ##
## : S must be delegated by the pinned host-root                           ##
if (ref $server_id ne qw| HASH |
    or not <[auth.client.server_pin.check]>->(
        $server_id->{'host'}, $server_id->{'port'},
        $server_pub,          $delegation_b32
    )
) {
    <[base.logs]>->( 0, '[#] server key not accepted, auth-keypair aborted' );
    return undef;
}

## ensure the local session/base identity keys exist, generating and
## persisting them on first use -- MUST be a stable, disk-persisted identity,
## never regenerated per call: plugin.auth.auth-keypair.
## validate-incoming-tofu pins this client's session pubkey on first contact
## and requires the SAME pubkey on every later connection to reach
## 'authorized' [ real gap found + fixed 2026-08-11 ]
if ( not exists $keys{'C25519'}->{$session_key_name} ) {
    if ( <[crypt.C25519.key_exists]>->($session_key_name) ) {
        <[crypt.C25519.load_keypair]>->( $session_key_name, undef, FALSE );
    } else {
        <[crypt.C25519.gen_keys]>->($session_key_name);
        <[crypt.C25519.write_keys]>->( $session_key_name, undef, FALSE );
    }
}

my $session_pubkey_bin = $keys{'C25519'}->{$session_key_name}->{'public'};
return undef if not defined $session_pubkey_bin;

## explicit base-identity key name, never the implicit default -- calling
## crypt.C25519.key_vars(name) for a name that isn't the real base key can
## HIJACK <crypt.C25519.base_key_name> to that name if it's the first
## key_vars() call in the process and that name's key files already exist on
## disk (crypt.C25519.key_vars:29-33) -- real bug found + fixed 2026-08-11,
## signing silently used the wrong key
my $auth_message = <[auth.binding.message]>->(
    qw| auth |,
    {   qw| server_nonce | => $server_nonce,
        qw| server_pub |   => $server_pub,
        qw| session_pub |  => $session_pubkey_bin,
        qw| username |     => $as_username,
    }
);
return undef if not defined $auth_message;

my $sig_bin = <[crypt.C25519.sign_data]>->( \$auth_message, $base_key_name );
return undef if not defined $sig_bin;

my $pubkey_b32 = Crypt::Misc::encode_b32r($session_pubkey_bin);
my $sig_b32    = Crypt::Misc::encode_b32r($sig_bin);

<[base.logs]>->(
    2, "[<] authenticating as " . "'%s'., [auth-keypair]", $as_username
);
<[base.net.send_to_socket]>->(
    $backend_socket,
    sprintf( "auth %s %s %s\n", $as_username, $pubkey_b32, $sig_b32 )
);

## plugin.auth.auth-keypair's own success line is literally "AUTH_TRUE =)",
## the exact same string auth.client.zenka.process_auth_reply already checks
## for -- genuinely reusable as-is, not zenka-specific despite its namespace
return undef
    if not defined <[auth.client.zenka.process_auth_reply]>->(
    $backend_socket, 'success., =), auth-keypair authorized session.'
    );

## binding PENDING on the server : the link-upgrade must follow at once ##
return {
    qw| server_nonce |  => $server_nonce,
    qw| server_pub |    => $server_pub,
    qw| username |      => $as_username,
    qw| base_key_name | => $base_key_name,
};

