#\\\|HQSYOAITDPUNTBOTRT2LLSLIWKK4HZJIRHIWQ7DGACXPO4LQCDW \ / AMOS7 \ YOURUM ::
#\[7]Z5X34OKSQCI2ILV2ASC33AVDNNRKS4CJIMWPJS7DOOJAOD47I2CQ 7  DATA SIGNATURE ::
