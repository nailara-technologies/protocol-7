## [:< ##

# name  = coding.cmd.inference-status
# descr = return current inference server status as YAML

use YAML::XS qw| Dump |;

my $reply_id = $call->{'reply_id'} // '';

my $servers = <coding.inference_servers> // {};

## authoritative mmproj path from model resolution             ##
## [ server hash may be stale if module reloaded after spawn ] ##
my $gpu_mmproj = <inference.model.mmproj_path> // '';
my $cpu_mmproj = <inference.model.mmproj_path> // '';

## fall back to server hash if authoritative path is empty ##
$gpu_mmproj = $servers->{'gpu'}{'mmproj_path'}
    if !length $gpu_mmproj
    && length( $servers->{'gpu'}{'mmproj_path'} // '' );
$cpu_mmproj = $servers->{'cpu'}{'mmproj_path'}
    if !length $cpu_mmproj
    && length( $servers->{'cpu'}{'mmproj_path'} // '' );

my $gpu_status = $servers->{'gpu'}{'status'} // 'unknown';
my $cpu_status = $servers->{'cpu'}{'status'} // 'unknown';

## load plan of a server [ spawn_inference_server's record ] : context, ##
## layers on the gpu, moe experts in ram, kv cache type                 ##
my $plan = sub {
    my ($srv) = @ARG;
    $srv //= {};
    return (
        'n_ctx'          => $srv->{'n_ctx'}          // 0,
        'calculated_ctx' => $srv->{'calculated_ctx'} // 0,
        'kv_cache_type'  => $srv->{'kv_cache_type'}  // '',
        'gpu_layers'     => $srv->{'gpu_layers'}     // 0,
        'layer_count'    => $srv->{'layer_count'}    // 0,
        'offload_mode'   => $srv->{'offload_mode'}   // '',
        'n_cpu_moe'      => $srv->{'n_cpu_moe'}      // 0,
    );
};

## vram used / total, cached 5 s : internal callers poll this command ##
## [ vision_switch_poll every second ] and nvidia-smi blocks          ##
my $vram_cache = <coding.vram_status_cache> //= {};
my $now        = <[base.time]>->(3);
if ( $now - ( $vram_cache->{'at'} // 0 ) > 5 ) {
    my $vram = <[coding.helper.query_gpu_memory]>;
    $vram_cache->{'at'} = $now;
    $vram_cache->{'used_mb'}
        = $vram->{'ok'} ? $vram->{'total_mb'} - $vram->{'free_mb'} : -1;
    $vram_cache->{'total_mb'} = $vram->{'ok'} ? $vram->{'total_mb'} : -1;
}

my $status = {
    'gpu' => {
        'status'        => $gpu_status,
        'port'          => $servers->{'gpu'}{'port'}  // 8000,
        'pid'           => $servers->{'gpu'}{'pid'}   // 0,
        'model_id'      => $servers->{'gpu'}{'model'} // '',
        'mmproj_path'   => $gpu_mmproj,
        'url'           => $servers->{'gpu'}{'url'}     // '',
        'backend'       => $servers->{'gpu'}{'backend'} // 'gpu',
        'still_loading' => ( $gpu_status eq qw| starting | ) ? 1 : 0,
        $plan->( $servers->{'gpu'} ),
        'vram_used_mb'  => $vram_cache->{'used_mb'},
        'vram_total_mb' => $vram_cache->{'total_mb'},
    },
    'cpu' => {
        'status'        => $cpu_status,
        'port'          => $servers->{'cpu'}{'port'}  // 8001,
        'pid'           => $servers->{'cpu'}{'pid'}   // 0,
        'model_id'      => $servers->{'cpu'}{'model'} // '',
        'mmproj_path'   => $cpu_mmproj,
        'url'           => $servers->{'cpu'}{'url'}     // '',
        'backend'       => $servers->{'cpu'}{'backend'} // 'cpu',
        'still_loading' => ( $cpu_status eq qw| starting | ) ? 1 : 0,
        $plan->( $servers->{'cpu'} ),
    }
};

my $yaml = Dump($status);

if ( length $reply_id ) {
    <[base.callback.cmd_reply]>->(
        $reply_id, { 'mode' => qw| size |, 'data' => $yaml }
    );
    <[base.logs]>->(
        3,         '[inference-status] replied to %s [gpu=%s]',
        $reply_id, $status->{'gpu'}{'status'}
    );
    return { 'mode' => qw| deferred | };
}

return { 'mode' => qw| size |, 'data' => $yaml };

