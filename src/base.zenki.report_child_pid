## [:< ##

# name  = base.zenki.report_child_pid
# descr = register a child process pid for reporting [ optional name ]

my $child_pid  = shift // '';
my $child_name = shift // '';
die "expected process id parameter" if $child_pid !~ m|^\d+$|;
$child_name = '' if $child_name !~ m{^[A-Za-z0-9][A-Za-z0-9_.\-]*$};

## the optional name \ role [ e.g. 'invokeai' ] says WHICH child it is -- a ##
## new instance claims a crash-kept child by name                           ##
## [ v7-zenki restart.keep_children \ v7-zenki.claim-children ]             ##
push(
    @{ <system.report_children> //= [] },
    length $child_name ? "$child_pid $child_name" : $child_pid
);

if (<system.zenka.initialized>) {
    <[base.callback.report_children]>;
} else {
    push(
        @{ <system.callbacks.initialized> //= [] },
        'base.callback.report_children'
    );
}

