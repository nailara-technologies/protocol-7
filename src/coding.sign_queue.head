## [:< ##

# name   = coding.sign_queue.head
# descr  = the sign queue entry in turn [ undef : none ]
#
# the oldest entry not committed : a stopped one keeps its place, the
# queue waits until it is dropped

my $all = <[coding.sign_queue.store]>;
my ($head)
    = sort { $all->{'entry'}{$a}{'num'} <=> $all->{'entry'}{$b}{'num'} }
    grep   { $all->{'entry'}{$ARG}{'status'} ne qw| committed | }
    keys %{ $all->{'entry'} };
return $head;

