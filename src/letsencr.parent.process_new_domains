## [:< ##

# name  = letsencr.parent.process_new_domains
# param = \@new_domains, \%domains_map
# descr = automatic enrollment of newly discovered domains : allowlist,
#         backoff and per-check limit, then verification queued to the child
#         [ the blocking DNS + HTTP-01 self-test runs in the child ]

my $new_domains = shift;
my $domains_map = shift // {};

return FALSE unless ref($new_domains) eq qw| ARRAY | && @$new_domains;

my $state = <[letsencr.parent.enroll_state_load]>;

## allowlist : only domains on enroll_domains qualify [ unset = all ] ##
my %allowlist = map { $ARG => 1 }
    grep { length($ARG) }
    split( m|\s+|, <letsencr.cfg.enroll_domains> // '' );

my $max_per_check = <letsencr.cfg.enroll_max_per_check> // 2;
my $staging = <[base.cfg_bool]>->( <letsencr.cfg.enroll_staging> // FALSE );

my @public_addresses = grep { length($ARG) }
    split( m|\s+|, <letsencr.cfg.public_addresses> // '' );

## none configured : this host's own public interface addresses -- the DNS
## check then accepts only names resolving HERE, with no network connection [
## a dev box no longer self-tests third-party hosts ].  no public address on
## any interface : nothing to enroll from here unless configured [ a server
## behind port forwarding sets letsencr.cfg.public_addresses ]
if ( not @public_addresses ) {
    my @local = <[letsencr.parent.local_public_addresses]>;
    if ( @local == 1 and not defined $local[0] ) {
        <[base.log]>->(
            2,
            ': enroll : interfaces unreadable [ IO::Interface::Simple '
                . '] -- dns check without address pinning'
        );
    } elsif ( not @local ) {
        <[base.logs]>->(
            2,
            ': enroll : no public address on any interface -- %d domain%s '
                . 'skipped [ behind nat : set letsencr.cfg.public_addresses '
                . ']',
            scalar @{$new_domains},
            <[base.cnt_s]>->( scalar @{$new_domains} )
        );
        return { 'status' => qw| success |, 'queued' => 0 };
    } else {
        @public_addresses = @local;
    }
}

my $now    = time();
my $queued = 0;

foreach my $domain ( <[base.sort]>->( @{$new_domains} ) ) {

    if ( %allowlist and not $allowlist{$domain} ) {
        <[base.logs]>->(
            2, ': enroll : %s : skipped [ not on enroll_domains ]', $domain
        );
        next;
    }

    my $entry = $state->{$domain} // {};

    ## an explicit request owns it [ letsencr.parent.cmd.request-certificate ]
    if ( $entry->{'explicit'} ) {
        <[base.logs]>->(
            2, ': enroll : %s : skipped [ explicitly requested ]', $domain
        );
        next;
    }

    if ( $staging
        and ( $entry->{'status'} // '' ) eq qw| issued-staging | ) {
        <[base.logs]>->(
            2, ': enroll : %s : skipped [ issued-staging ]', $domain
        );
        next;
    }

    ## already in flight [ verification or order queued by an earlier check --
    ## a restart \ reload or the repeated discovery once httpd is online runs
    ## another check meanwhile ].  reply handlers replace 'pending' with
    ## failed \ issued ; an hour-old 'pending' counts as lost [ child gone ]
    if (    ( $entry->{'status'} // '' ) eq qw| pending |
        and ( $entry->{'pending_since'} // 0 ) > $now - 3600 ) {
        <[base.logs]>->(
            2, ': enroll : %s : skipped [ already in progress ]', $domain
        );
        next;
    }

    if ( ( $entry->{'next_attempt_after'} // 0 ) > $now ) {
        <[base.logs]>->(
            2,
            ': enroll : %s : backed off until %s [ %s ]',
            $domain,
            scalar( localtime( $entry->{'next_attempt_after'} ) ),
            $entry->{'last_error'} // q|previous failure|
        );
        next;
    }

    if ( $queued >= $max_per_check ) {
        <[base.logs]>->(
            2, ': enroll : %s : skipped [ enroll_max_per_check %d reached ]',
            $domain, $max_per_check
        );
        next;
    }

    ## queue the verification to the child [ blocking checks run there ] ##
    my $alt_names = $domains_map->{$domain}->{'alt_names'} // [];

    my $result = <[protocol-7.command.send.local]>->(
        {   'command'   => qw| child.verify-domain |,
            'call_args' => {
                'args'  => $domain,
                'param' => { 'public_addresses' => \@public_addresses, }
            },
            'reply' => {
                'handler' =>
                    qw| letsencr.parent.handler_enroll_verify_reply |,
                'params' => {
                    'domain'    => $domain,
                    'alt_names' => $alt_names,
                    'staging'   => $staging,
                }
            }
        }
    );

    if ($result) {
        $queued++;
        ## in flight until a reply handler records the outcome ##
        $state->{$domain} = {
            %{$entry},
            'status'        => qw| pending |,
            'pending_since' => $now,
        };
        <[letsencr.parent.enroll_state_save]>->($state);
        <[base.logs]>->(
            2, ': enroll : %s : queued for verification', $domain
        );
        <[letsencr.parent.activity_logger]>->(
            qw| enrollment |,
            $domain, qw| pending |,
            'automatic enrollment : queued for verification'
        );
    } else {
        <[base.logs]>->(
            1, ': enroll : %s : failed to queue verification', $domain
        );
        <[letsencr.parent.enroll_record_failure]>->(
            $state, $domain, 'failed to queue verification to child'
        );
    }
}

<[base.logs]>->(
    2,       ': enroll : %d domain%s queued this check [ max %d ]',
    $queued, <[base.cnt_s]>->($queued),
    $max_per_check
) if @$new_domains;

return { 'status' => qw| success |, 'queued' => $queued };

