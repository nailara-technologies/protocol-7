# name  = invoke-web.cmd.queue-interactive
# descr = new items jump to the front [ no param : state ]
# param = [ on | off ]

my $arg = lc( $call->{'args'} // '' );

if ( not length $arg ) {
    return {
        mode => qw| size |,
        data => sprintf( "interactive queue mode : %s\n",
            <invoke-web.queue_interactive> ? 'on' : 'off' )
    };
}

return { mode => qw| false |, data => 'expected : on | off' }
    if $arg !~ m{^(?:on|off)$};

my $on = <[invoke-web.queue.interactive]>->( $arg eq 'on' ? TRUE : FALSE );

return { mode => qw| false |, data => 'queue db not available [ see log ]' }
    if $arg eq 'on' and not $on;

return {
    mode => qw| size |,
    data => $on
    ? "interactive queue mode on : new items jump to the front\n"
    : "interactive queue mode off\n"
};

