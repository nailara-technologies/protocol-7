## [:< ##

# name   = claude.child.start
# descr  = start the claude code process [ one session ]
# args   = { model, resume } [ resume : id \ new \ empty = saved ]
# return = { ok => TRUE, pid } or { error => text }
#
# claude -p, stream-json in and out, a stream_child in its own process
# group : stdout lines go to claude.stream.line, stderr lines become
# events, stdin is written non-blocking [ claude.child.write ]. binary and
# flags from config

my $in = shift // {};

return {
    'error' => 'claude is running [ pid ' . <claude.child>->{'pid'} . ' ]' }
    if defined <claude.child> and defined <claude.child>->{'out'};

my $binary = <claude.cfg.binary> // '';
return { 'error' => 'claude.cfg.binary is not set' } if not length $binary;

my $model = $in->{'model'} // <claude.cfg.model> // '';
return { 'error' => "model '$model' : letters, digits, . _ - [ ] only" }
    if length $model and $model !~ m|\A[\w.\[\]-]{1,80}\z|;

my $resume = $in->{'resume'} // '';
$resume = <claude.session> // '' if not length $resume;
$resume = '' if $resume eq qw| new |;
return { 'error' => "resume '$resume' : not a session id" }
    if length $resume and $resume !~ m|\A[\w-]{8,80}\z|;

my $tool = <claude.cfg.permission_prompt_tool> // '';
my @cmd  = (
    $binary,
    grep {length} CORE::split( m{\s+}, <claude.cfg.args> // '' ),
    ( length $model  ? ( '--model',                  $model )  : () ),
    ( length $resume ? ( '--resume',                 $resume ) : () ),
    ( length $tool   ? ( '--permission-prompt-tool', $tool )   : () ),
);

## the child runs as the zenka's user after the drop               ##
## [ owner mode : the admin user ] : its own home, login names and ##
## ~/.local/bin on the path                                        ##
## [ claude's login, settings and mcp config live there ]          ##
my @pw  = CORE::getpwuid($EUID);
my %env = ();
if ( @pw and defined $pw[7] and length $pw[7] ) {
    %env = ( 'HOME' => $pw[7], 'USER' => $pw[0], 'LOGNAME' => $pw[0] );
    $env{'PATH'} = "$pw[7]/.local/bin:" . ( $ENV{'PATH'} // '/usr/bin:/bin' )
        if -d "$pw[7]/.local/bin"
        and index( $ENV{'PATH'} // '', "$pw[7]/.local/bin" ) < 0;
}

## closing stdin ends a stream-json session by itself ; TERM is sent with ##
## it, KILL after a claude-stop delay                                     ##
my $r = <[stream_child.start]>->(
    {   'cmd'       => \@cmd,
        'env'       => \%env,
        'cwd'       => <claude.cfg.work_dir> // <system.root_path> // '.',
        'group'     => TRUE,
        'on_line'   => qw| claude.stream.line |,
        'on_stderr' => qw| claude.child.stderr |,
        'on_gone'   => qw| claude.child.gone |,
        'on_note'   => qw| claude.child.note |,
        'stop'      => 'close TERM | KILL',
        'interval'  =>
            { 'stop' => qw| claude-stop |, 'reap' => qw| claude-reap | },
        'timer_handler' => qw| claude.handler.stop_kill |,
        'reap_handler'  => qw| claude.handler.reap |,
        'report'        => TRUE,
    }
);
return { 'error' => 'spawn failed : ' . $r->{'error'} } if not $r->{'ok'};

my $child = <claude.child> = $r->{'handle'};
my $pid   = $child->{'pid'};
$child->{'model'}  = $model;
$child->{'resume'} = $resume;

<claude.state>       = qw| running |;
<claude.turn_active> = FALSE;
<[base.zenki.report_child_pid]>->( $pid, qw| claude | )
    if defined $code{'base.zenki.report_child_pid'};
<[claude.event.add]>->(
    qw| start |, sprintf '%s pid %d%s%s',
    $binary,     $pid,
    length $model  ? " model $model"   : '',
    length $resume ? " resume $resume" : ' new session'
);

## turns sent before the start wait in the queue ##
<[claude.turn.next]>;
return { 'ok' => TRUE, 'pid' => $pid };

