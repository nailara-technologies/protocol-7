## [:< ##

# name  = screen.setup.dpi.handler.exec
# descr = collect one dpi consumer command result

my $event = shift;
my $job   = $event->w->data;
my $fh    = $event->w->fd;
my $bytes = <[base.s_read]>->( $fh, \$job->{'buffer'}, 4096 );
return TRUE if $bytes > 0;

$event->w->cancel;
close $fh;
<[base.waitpid]>->( $job->{'pid'} );
my $status = $CHILD_ERROR;
$job->{'cb'}->( $status == 0 ? TRUE : FALSE, $job->{'buffer'} )
    if ref $job->{'cb'} eq qw| CODE |;
return FALSE;

