## [:< ##

# name   = usage.credential_load
# descr  = parse one provider credential file, silently
# args   = path
# return = hash ref, or undef

## not through format.json.decode : on a parse error that logs and buffers ##
## the start of its input -- here that is token text. nothing is logged    ##

my $path = shift // return undef;
my $fh;
return undef if not open( $fh, '<:raw', $path );
my $octets = do { local $INPUT_RECORD_SEPARATOR = undef; <$fh> // '' };
close($fh);
my $parsed = eval { JSON::XS->new->utf8->relaxed->decode($octets) };

return ref $parsed eq qw| HASH | ? $parsed : undef;

