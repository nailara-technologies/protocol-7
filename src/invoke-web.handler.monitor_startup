## [:< ##

# name  = invoke-web.handler.monitor_startup
# descr = monitor invoke.ai startup output and detect readiness or crash

my $event        = shift->w;
my $handler_data = $event->data;
my $expected_pid = $handler_data->{'pid'};

## stale watcher guard
if ( !defined <invoke-web.pid>
    || <invoke-web.pid> != $expected_pid ) {
    $event->cancel if $event->is_active;
    return;
}

## non-blocking read
my $read_fh = $event->fd;
my $bytes
    = <[base.s_read]>->( $read_fh, \$data{'invoke-web'}{'output'}, 4096 );

## check for readiness indicators
my $output = <invoke-web.output> // '';
if ( $output =~ m{uvicorn running on|application startup complete}i ) {
    unless (<invoke-web.ready_logged>) {
        <invoke-web.status>       = 'running';
        <invoke-web.ready_logged> = TRUE;
        <[base.logs]>->( 1, 'invoke.ai ready at %s', <invoke-web.url> );
    }
}

## EOF handling
if ( $bytes <= 0 ) {
    close($read_fh);
    $event->cancel if $event->is_active;

    if (   !<invoke-web.ready_logged>
        && !<invoke-web.crash_logged> ) {
        <invoke-web.crash_logged> = TRUE;
        <invoke-web.status>       = 'crashed';
        <[base.logs]>->( 0, 'invoke.ai crashed before ready' );

        ## log last lines for diagnosis
        my @lines = grep { length $ARG } split m|\n|, $output;
        my @tail  = @lines > 5 ? @lines[ -5 .. -1 ] : @lines;
        <[base.logs]>->( 0, ':. %s', $ARG ) for @tail;
    }
}

