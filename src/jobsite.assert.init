# name  = jobsite.assert.init
# descr = create assertion tree template for a job entry

my $job_id = ( shift // '' );
return if not length $job_id;

my $assertions = {
    'suggest' => {
        'apply'   => 'undecided',
        'delete'  => 'undecided',
        'archive' => 'undecided',
    },
    'dimensions' => {
        'location' => {
            'score'  => 'unasserted',
            'reason' => '',
        },
        'work-profile' => {
            'score'  => 'unasserted',
            'reason' => '',
        },
        'company-culture' => {
            'score'  => 'unasserted',
            'reason' => '',
        },
        'compensation' => {
            'score'  => 'unasserted',
            'reason' => '',
        },
        'remote-flexibility' => {
            'score'  => 'unasserted',
            'reason' => '',
        },
        'career-growth' => {
            'score'  => 'unasserted',
            'reason' => '',
        },
        'tech-stack' => {
            'score'  => 'unasserted',
            'reason' => '',
        },
        'team-structure' => {
            'score'  => 'unasserted',
            'reason' => '',
        },
    }
};

<jobsite.tasks>->{$job_id}{'assertions'} = $assertions;

return $assertions;

