# name  = clients.https.post
# descr = async https post : thin wrapper around clients.https.request

my $p = shift // {};

$p->{'method'} = 'POST';
$p->{'headers'}{'Content-Type'} //= 'application/json';

return <[clients.https.request]>->($p);

