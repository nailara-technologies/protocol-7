## [:< ##

# name  = coding.cmd.redo-round
# descr = redo : move tip into an existing fork
# param = <task_id> [checksum]
# note  = task must be completed or failed, not in_progress. no separate
#         redo stack : "forward" is just the newest child of
#         round_chain_current [ coding.round_chain.step_target ]. after a
#         plain rewind-then-round-regen that's exactly the fork just made;
#         after several redos/rewinds it's whichever fork was visited
#         most recently. pass a checksum explicitly to jump to a specific
#         fork instead of the newest one. no inference here : the content
#         at the fork being redone into already exists, it was generated
#         when that fork was first created [ by coding.cmd.round-regen
#         ] -- confirmed live that always re-running inference on redo was
#         a real design error, same fix as rewind-round's.

my $args_str = $call->{'args'} // '';
my ( $task_id, $checksum ) = split m{ +}, $args_str, 2;

return { 'mode' => qw| false |, 'data' => 'task_id required' }
    unless defined $task_id and length $task_id;

my $task = <coding.task.queue>->{$task_id};

## buffer names use T- prefix; queue keys use task- prefix : normalize [ ##
## same normalization coding.cmd.task-append applies ]                   ##
if ( !defined $task and $task_id =~ s|^T-|task-|i ) {
    $task = <coding.task.queue>->{$task_id};
}

return { 'mode' => qw| false |, 'data' => "task not found: $task_id" }
    unless defined $task;

my $status = $task->{'execution'}->{'status'} // 'unknown';

return {
    'mode' => qw| false |,
    'data' => "cannot redo task $task_id [status: $status] "
        . '-- stop it first if it is still in progress'
    }
    unless $status eq qw| completed | or $status eq qw| failed |;

if ( not defined $checksum or not length $checksum ) {
    $checksum
        = <[coding.round_chain.step_target]>->( $task_id, qw| forward | );
    return {
        'mode' => qw| false |,
        'data' => "nothing to redo for $task_id"
        }
        unless defined $checksum;
}

my $node = <[coding.round_chain.rewind]>->( $task_id, $checksum );
return {
    'mode' => qw| false |,
    'data' => "checksum not found in round_chain for $task_id: $checksum"
    }
    unless defined $node;

## plain inclusive reconstruct -- see rewind-round's identical comment ##
my $messages = <[coding.round_chain.reconstruct]>->( $task_id, $checksum );
return {
    'mode' => qw| false |,
    'data' => "failed to reconstruct messages for checksum $checksum"
    }
    unless ref $messages eq qw| ARRAY |;

my $navigated
    = <[coding.round_chain.navigate_to_node]>->( $task_id, $messages );
return { 'mode' => qw| false |, 'data' => "failed to navigate $task_id" }
    unless $navigated;

## replay embedded directly in THIS reply -- see rewind-round's identical, ##
## fuller comment : coding.round_chain.restream's session.listeners push   ##
## was confirmed live to break a LATER real round's content streaming,     ##
## since repeated pure-navigation subscribes accumulate listeners a real   ##
## round's own completion never cleans up.                                 ##
my $replay
    = <[coding.round_chain.format_node_for_display]>->( $task_id, $node );

<[base.logs]>->(
    1,        "redo-round : %s redone to %s [round %d, %d messages]",
    $task_id, $checksum,
    $node->{'round'} // 0,
    scalar @{$messages}
);

## 'size' mode, NOT 'true' -- see rewind-round's identical comment : a      ##
## 'true'-mode reply's embedded real newlines don't survive to the terminal ##
## as actual line breaks                                                    ##
return {
    'mode' => qw| size |,
    'data' => "task $task_id redone to round $node->{'round'} "
        . "[${\scalar @{$messages}} messages]\n\n$replay\n"
};

