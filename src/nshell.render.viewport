## [:< ##

# name  = nshell.render.viewport
# descr = render input line with horizontal scroll when content
#         exceeds terminal width; overflow direction is indicated
#         by configurable marker chars at line edges
#         [ default: '<' left  '>' right, in p7 accent color (p7_fg_0003) ]
#         set nshell.cfg.overflow_marker_left/right = '' to disable markers

my ( $editor, $colors ) = @ARG;

my $buffer     = <[editor.control.get_value]>->( $editor, 'command' )  // '';
my $cursor_pos = <[editor.control.get_cursor]>->( $editor, 'command' ) // 0;

## editor.* state is character-based [ design: position_units ] ; this
## renderer's column math + terminal output is byte-oriented — reconstruct the
## byte view at the boundary, byte-identical to the old AMOS7::TERM path
my $prefix = substr( $buffer, 0, $cursor_pos );
utf8::encode($prefix);
$cursor_pos = length $prefix;
utf8::encode($buffer);

my $buf_len = length($buffer);

## get terminal width [ terminal_size returns ( cols, rows ) ]  prefer cached
## value from SIGWINCH handler; fall back to live query
my $term_cols = <nshell.cfg.term_cols>
    // ( eval { ( AMOS7::TERM::terminal_size() )[0] } // 80 );
$term_cols = 20 if $term_cols < 20;    ## minimum sanity

## nshell state for view_offset and marker config
my $state_ref   = <nshell.state>              //= {};
my $view_offset = $state_ref->{'view_offset'} //= 0;

## split-screen active : jump to the pinned input row first [ absolute      ##
## positioning, not \r-relative ]. NO restore afterward -- the real         ##
## terminal cursor is meant to stay exactly where this render leaves it,    ##
## same as nshell's existing single-cursor convention (the drawn highlight  ##
## IS the cursor, the real terminal cursor tracks it). restoring here was   ##
## the actual bug behind "two cursors" after e.g. a `clear` command: it     ##
## yanked the real cursor back to wherever it was BEFORE this render [ e.g. ##
## top-left, post-clear ], leaving it disconnected from the drawn input     ##
## line. content-push code (nshell.handler.strm_reply) is what needs to     ##
## save/jump/restore AROUND itself when printing, not this function --      ##
## background content shouldn't steal the visible cursor away from an       ##
## active input line, but rendering the input line itself should always own ##
## it. off by default, zero behaviour change unless split mode is on [      ##
## nshell.display.cycle ]                                                   ##
my $split_active = $state_ref->{'split_active'};

if ($split_active) {

    ## redraw the separator on every render, not just once at Tab-press     ##
    ## time -- makes it self-healing against a `clear` command or anything  ##
    ## else that wipes the screen, since it comes back on the very next     ##
    ## keystroke instead of staying missing until the next Tab cycle. cheap ##
    ## : one pinned_row_print call, tiny payload                            ##
    if ( length( $state_ref->{'split_title'} // '' ) ) {
        my ($term_w) = AMOS7::TERM::terminal_size();

        ## append the bound task id when one exists -- read fresh from the ##
        ## live mode object every render, same self-healing reasoning as   ##
        ## redrawing the separator itself on every keystroke rather than   ##
        ## caching it once at Tab-press time : on_reply/on_escape mutate   ##
        ## mode->{task_id} directly and don't need to remember to keep a   ##
        ## separate cached title in sync                                   ##
        my $modes = $state_ref->{'display_modes'};
        my $mode
            = ref $modes eq 'ARRAY'
            ? $modes->[ $state_ref->{'display_mode_index'} // 0 ]
            : undef;

        ## a rewind/redo boundary-hit reply [ "nothing to redo", "already  ##
        ## at the earliest round" ] is expected UI feedback, not an error  ##
        ## worth permanently scrolling into the content area next to the   ##
        ## real conversation -- plugin.nshell.coding-session.on_reply      ##
        ## claims those replies and stashes one here instead of printing   ##
        ## them, self-expiring : this render clears it once past its own   ##
        ## 'expires' timestamp, and nshell.handler.flash_expire's one-shot ##
        ## timer forces this same render to run even if no further reply/  ##
        ## keypress would otherwise trigger one, so it actually disappears ##
        ## on its own instead of lingering until the next rewind/redo      ##
        my $flash = $state_ref->{'flash'};
        if ( defined $flash
            and ( $flash->{'expires'} // 0 ) <= <[base.ntime]> ) {
            delete $state_ref->{'flash'};
            $flash = undef;
        }

        ## fill-then-anchor [ instead of frame_rule_line's anchor-then-fill ##
        ## ] so the title stays pinned to the RIGHT edge and never moves -- ##
        ## the task id, when present, is its own anchor immediately to the  ##
        ## title's left, growing the fill leftward instead of shifting the  ##
        ## title's own position  leading space : purely cosmetic symmetry   ##
        ## with the trailing cap below -- unlike the trailing reserved      ##
        ## column, there's no wrap- hazard argument for it, column 1 is     ##
        ## always safe to write to                                          ##
        my @elements = (
            {   'type'  => qw| anchor |,
                'value' => ' ',
                'color' => $colors{'p7_fg_0004'},
            },
            ## unicode box-drawing line instead of ASCII '-' -- this call   ##
            ## goes straight to frame_border_line now rather than the       ##
            ## shared frame_rule_line default, so only this one status bar  ##
            ## is affected. the coding-zenka round transcript already       ##
            ## renders box-drawing chars [ and emoji ] in this exact split  ##
            ## view, and the project's own convention is UTF-8 by default,  ##
            ## so there's no real 7-bit-compatibility argument to make here ##
            {   'type'  => qw| fill |,
                'char'  => '─',
                'min'   => 1,
                'color' => $colors{'p7_fg_0004'},
            },
        );
        if (    not defined $flash
            and defined $mode
            and length( $mode->{'task_id'} // '' ) ) {
            push @elements,
                {
                'type'  => qw| anchor |,
                'value' => " [ $mode->{'task_id'} ] ",
                'color' => $colors{'p7_fg_0003'},
                },
                ## no spaces of its own -- the task anchor's trailing space ##
                ## and the title anchor's leading space already bracket it  ##
                {
                'type'  => qw| anchor |,
                'value' => '──',
                'color' => $colors{'p7_fg_0004'},
                };
        }
        push @elements,
            {
            'type'  => qw| anchor |,
            'value' => defined $flash
            ? " [ $flash->{'text'} ] "
            : " $state_ref->{'split_title'} ",
            'color' => $colors{'p7_fg_0003'},
            },
            ## small fixed cap at the very right edge -- a second stretchy ##
            ## fill element here would fight the left one for space via    ##
            ## frame_border_line's min-ratio split rather than staying a   ##
            ## constant few columns, so this is a plain anchor instead     ##
            {
            'type'  => qw| anchor |,
            'value' => '──',
            'color' => $colors{'p7_fg_0004'},
            };

        ## reserve one column [ same pending-wrap hazard this renderer's ##
        ## own overflow path already guards against below ]              ##
        my $rule = AMOS7::TERM::frame_border_line(
            {   'width'    => $term_w - 1,
                'reset'    => "\e[0m",
                'elements' => \@elements,
            }
        );

        ## byte view at the terminal boundary, same convention this file    ##
        ## already uses for the editor buffer above -- $rule carries the    ##
        ## unicode box-drawing char [ '─', U+2500 ] now, and STDOUT here    ##
        ## isn't set up with a wide-character output layer, so printing the ##
        ## wide-flagged string as-is throws "wide character in print"       ##
        utf8::encode($rule);

        AMOS7::TERM::pinned_row_print( $state_ref->{'split_row'} - 1, $rule );
    }

    print "\e7";    ## DECSC : save the content-area cursor position ##
    print "\e[" . $state_ref->{'split_row'} . ';1H';
}

my $marker_color = $colors{'p7_fg_0003'};
my $text_color   = $colors{'p7_fg_0004'};

## ── no overflow: existing minimal render, untouched ──────────────────────
if ( $buf_len < $term_cols ) {
    $state_ref->{'view_offset'} = 0;

    print "\r";
    print $text_color . substr( $buffer, 0, $cursor_pos ) if $cursor_pos > 0;

    my $char_at = substr( $buffer, $cursor_pos, 1 ) // '';
    if ( $char_at eq '' or $char_at eq ' ' ) {
        print $marker_color . '_';
    } else {
        print "\e[7m" . $char_at . "\e[27m";
    }
    print "\e[0m" . $text_color;

    if ( $cursor_pos < $buf_len ) {
        my $after = substr( $buffer, $cursor_pos + 1 );
        print $after if length $after;
        print "\e[K";
        print "\x08" x length($after) if length($after);
    } else {
        print "\e[K";
    }

    STDOUT->flush();
    return;
}

## ── overflow: horizontal scroll viewport ─────────────────────────────────

## configurable marker chars [ '' disables the marker on that side ]
my $ml = <nshell.cfg.overflow_marker_left>  // '<';
my $mr = <nshell.cfg.overflow_marker_right> // '>';

## reserve one column so total render never reaches term_cols  printing
## exactly term_cols chars puts the cursor in pending-wrap state, where \e[K]
## wraps to the next line and erases the rightmost marker char
my $available = $term_cols - 1;

## update view_offset to keep cursor visible  reserve space for both potential
## markers  (worst case: available - 2 content)
my $min_content_w = $available - length($ml) - length($mr);
$min_content_w = 4 if $min_content_w < 4;

if ( $cursor_pos - $view_offset > $min_content_w - 1 ) {
    ## cursor beyond right edge: scroll right
    $view_offset = $cursor_pos - $min_content_w + 1;
}
if ( $cursor_pos < $view_offset ) {
    ## cursor before left edge: scroll left with small lookahead
    $view_offset = ( $cursor_pos > 2 ) ? $cursor_pos - 2 : 0;
}
$view_offset = 0 if $view_offset < 0;
$state_ref->{'view_offset'} = $view_offset;

## compute actual marker presence and resulting content width
my $left_w = ( $view_offset > 0 and length $ml ) ? length($ml) : 0;

## assume right marker present, check if content actually extends past view
my $content_w = $available - $left_w - length($mr);
my $has_right = length($mr) && ( $view_offset + $content_w ) < $buf_len;
unless ($has_right) {
    ## no right overflow: reclaim the marker column for content
    $content_w += length($mr);
}

## visible slice of buffer and cursor position within it
my $slice      = substr( $buffer, $view_offset, $content_w );
my $cursor_col = $cursor_pos - $view_offset;    ## 0-indexed within slice
my $char_at    = substr( $buffer, $cursor_pos, 1 ) // '';

## render
print "\r";

## left overflow marker
if ($left_w) {
    print $marker_color . $ml . "\e[0m" . $text_color;
}

## content before cursor
print $text_color . substr( $slice, 0, $cursor_col ) if $cursor_col > 0;

## cursor character [ underscore or inverse video ]
if ( $char_at eq '' or $char_at eq ' ' ) {
    print $marker_color . '_';
} else {
    print "\e[7m" . $char_at . "\e[27m";
}
print "\e[0m" . $text_color;

## content after cursor within viewport
my $after = '';
if ( $cursor_col + 1 < length($slice) ) {
    $after = substr( $slice, $cursor_col + 1 );
}
print $after if length $after;

## right overflow marker
print $marker_color . $mr if $has_right;

print "\e[K";    ## clear any terminal remnants past rendered content

## reposition terminal cursor to just after visual cursor char
## printed: [left_w] [cursor_col content] [cursor:1] [after] [right_w?]
## need to backspace over: after + right marker
my $back = length($after) + ( $has_right ? length($mr) : 0 );
print "\x08" x $back if $back > 0;

STDOUT->flush();
return;

#,,.,,,..,..,,.,,,.,,,...,,..,...,,,.,.,.,,,,,..,,...,...,,..,,,.,..,,,..,,..,
