# name  = letsencr.child.acme.step_poll_order
# param = <timer event>
# descr = ask the acme server for the order status again

my $order = <[letsencr.child.acme.order_of]>->( shift, qw| finalize | )
    // return FALSE;

<[letsencr.child.acme.request]>->(
    {   'method'   => qw| POST-as-GET |,
        'url'      => $order->{'order_url'},
        'order_id' => $order->{'order_id'},
        'on_done'  => qw| letsencr.child.acme.on_order |,
        'params'   => { 'order_id' => $order->{'order_id'} },
    }
);

return TRUE;

