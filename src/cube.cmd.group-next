## [:< ##

# name  = cube.cmd.group-next
# descr = arm one-shot group-mode routing override [ admin ]
# param = [:single|:next|:keep:] <name>[[subname]]

return <[cube.routing_override.arm]>->(
    $call->{'session_id'},
    qw| group |,
    $call->{'args'} // ''
);

