# name  = coding.handler.thermal_execute_hold
# descr = event-timer : a thermal hold of a new task ran out, execute it
#         again [ it passes the hover gate once more ]

my $timer_data = eval { shift->w->data } // {};
my $task_id    = $timer_data->{'task_id'};
my $params     = $timer_data->{'params'};

return unless defined $task_id and ref $params eq qw| HASH |;

delete <coding.thermal.held>->{$task_id};

<[coding.task.execute]>->($params);

return;

