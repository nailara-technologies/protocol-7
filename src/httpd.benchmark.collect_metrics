# name = httpd.benchmark.collect_metrics
# descr = collect server performance metrics

my $params = shift // {};

# Skip if benchmark tracking is disabled
return FALSE if not <httpd.benchmark.enabled>;

# Get current time
my $now = <[base.time]>->(3);

# Collect current metrics
my $metrics = {
    'timestamp'          => $now,
    'elapsed_time'       => $now - <httpd.benchmark.start_time>,
    'request_count'      => <httpd.benchmark.request_count> // 0,
    'bytes_sent'         => <httpd.benchmark.bytes_sent>    // 0,
    'active_connections' => scalar( keys %{ <httpd.clients>         // {} } ),
    'active_requests'    => scalar( keys %{ <httpd.active_requests> // {} } ),
    'active_transfers'   => scalar( keys %{ <httpd.transfers>       // {} } )
};

# Add system metrics
$metrics->{'system'} = {
    'load'        => <[httpd.system.get_load]>,
    'cpu_usage'   => <[httpd.system.cpu_usage]>,
    'memory_free' => <[httpd.system.memory_free]>,
    'network_io'  => <[httpd.system.network_io]>->('eth0')
};

# Calculate requests per second
my $elapsed = $metrics->{'elapsed_time'};
$metrics->{'requests_per_second'}
    = $elapsed > 0 ? $metrics->{'request_count'} / $elapsed : 0;

# Calculate bytes per second
$metrics->{'bytes_per_second'}
    = $elapsed > 0 ? $metrics->{'bytes_sent'} / $elapsed : 0;

# Store metrics in history (keep last 1000)
push <httpd.benchmark.history>->@*, $metrics;
if ( <httpd.benchmark.history>->@* > 1000 ) {
    shift <httpd.benchmark.history>->@*;
}

# Log metrics if debug mode enabled
if (<httpd.benchmark.debug>) {
    <[base.log]>->(
        2,
        sprintf(
            "HTTP benchmark: %d requests (%.2f/s), %s sent, %d connections",
            $metrics->{'request_count'},
            $metrics->{'requests_per_second'},
            <[httpd.base.size.normalize]>->( $metrics->{'bytes_sent'} ),
            $metrics->{'active_connections'}
        )
    );
}

return TRUE;

