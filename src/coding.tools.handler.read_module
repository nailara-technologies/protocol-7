## [:< ##

# name  = coding.tools.handler.read_module
# descr = dispatch read_module tool call to coding.context.read_module handler

my $args = shift // {};

my $result = $code{'coding.context.read_module'}->(
    {   'module'    => $args->{'module'}    // '',
        'max_chars' => $args->{'max_chars'} // 8000,
    }
);
if ( ref $result eq qw| HASH | and $result->{'mode'} eq qw| true | ) {
    my $d = $result->{'data'};
    return sprintf ".:[ module: %s ]:.\n.:[ descr: %s "
        . "]:.\n.:[ %d lines, %d chars%s ]:.\n\n%s",
        $d->{'module'},
        $d->{'descr'} // '?',
        $d->{'lines'},
        $d->{'chars'},
        $d->{'truncated'} ? ' truncated' : '',
        $d->{'content'};
}
return $result;

