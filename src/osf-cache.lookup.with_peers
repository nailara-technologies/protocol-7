## [:< ##

# name  = osf-cache.lookup.with_peers
# descr = fan a lookup out to the resolved peers
# param = { peers => [ cube session ids ], params => { lookup_id } }
#
# the peers.list callback of osf-cache.cmd.lookup : sends
# '<holder>.has <tokens>' to every peer with osf-cache.handler.
# has_reply as the reply handler and marks each holder pending.
# holders are ROUTE STRINGS since stage 4b : '<sid>' local,
# 'external.<link>.<sid>' behind a configured external link -
# the command '<holder>.has' routes over the named link for the
# remote ones. SECURITY : a remote holder is reached over a link
# that authenticates US but does not yet prove the SERVER's
# identity [ open : the trust chain work ] - content stays safe
# [ every segment checked against the agreed merkle leaf, the
# file against the signed anchor ] : localhost \ own nodes only.
# zero peers answer the lookup immediately [ mode true, 'no
# peers' ]. a lookup the timeout already completed is gone from
# <osf-cache.lookup.pending> and this call does nothing.

my $args      = shift                  // {};
my $params    = $args->{'params'}      // {};
my $lookup_id = $params->{'lookup_id'} // '';

my $state = <osf-cache.lookup.pending>->{$lookup_id};
return unless ref $state eq qw| HASH |;    ## timeout beat the query ##

$state->{'peers_resolved'} = 1;

my @peers = @{ $args->{'peers'} // [] };

## failed remote links [ stage 4b ] : reported like failed peers ##
my @failed_links = @{ $args->{'failed'} // [] };
$state->{'failed_links'} = \@failed_links if @failed_links;

if ( !@peers ) {
    <[osf-cache.lookup.complete]>->(
        {   'lookup_id' => $lookup_id,
            'mode'      => qw| true |,
            'data'      => 'no peers',
        }
    );
    return;
}

my $token_str = join ' ', @{ $state->{'anchors'} // [] };

foreach my $holder (@peers) {
    $state->{'pending'}{$holder} = 1;
    <[protocol-7.route-send]>->(
        {   'command'   => "$holder.has",
            'call_args' => { 'args' => $token_str },
            'reply'     => {
                'handler' => qw| osf-cache.handler.has_reply |,
                'params'  => { 'lookup_id' => $lookup_id, 'sid' => $holder },
            },
        }
    );
}

return;

