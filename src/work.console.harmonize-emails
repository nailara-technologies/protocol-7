## [:< ##

# name  = work.console.harmonize-emails
# param = [exec|outliers] [pattern]
# descr = standardize author+email across git history

my $param1 = shift // '';
my $param2 = shift // '';

## Determine execute mode, harmonize_outliers, and key phrase
my $dry_run            = 1;
my $harmonize_outliers = 0;
my $key_phrase         = '';

if ( $param1 eq 'execute' || $param1 eq 'exec' ) {
    $dry_run    = 0;
    $key_phrase = $param2;
} elsif ( $param1 eq 'harmonize-outliers' || $param1 eq 'outliers' ) {
    $harmonize_outliers = 1;
    if ( $param2 eq 'execute' || $param2 eq 'exec' ) {
        $dry_run = 0;
    } else {
        $key_phrase = $param2;
    }
} elsif ( length $param1 ) {
    $key_phrase = $param1;
}

<[base.log]>->(
    1, "Harmonizing author names and email addresses in git history..."
);

if ($harmonize_outliers) {
    <[base.log]>->( 1, "  Mode : Harmonizing outliers to main developer" );
}

if ( length $key_phrase ) {
    <[base.log]>->( 1, "  Filtering by key phrase : '$key_phrase'" );
}

if ($dry_run) {
    <[base.log]>->(
        1, "  DRY RUN mode - use 'execute' parameter to apply changes"
    );
}

## Trigger harmonization
my $result = <[work.parent.harmonize_emails]>->(
    {   dry_run            => $dry_run,
        harmonize_outliers => $harmonize_outliers,
        key_phrase         => $key_phrase,
        abort_after_valid  => 13
    }
);

if ( $result->{dry_run} ) {
    ## The parent function already printed detailed output  Just wrap with
    ## clean formatting
    say "";
    return FALSE;
}

unless ( $result->{success} ) {
    my $error = $result->{error} || 'unknown error';
    return say "::\n: ✗ Harmonization failed: $error\n::";
}

my $changed = $result->{changed} || 0;
return say "::\n: ✓ Harmonized $changed commits\n::";

