## [:< ##

# name  = work.console.harmonize-emails
# param = [outliers] [execute] [key phrase]
# descr = standardize author+email across git history

my $args_str = shift // q{};

## console params arrive as ONE string [ base.call.console_command ] :   ##
## leading 'outliers' \ 'execute' keywords in any order, the rest is the ##
## key phrase [ surrounding quotes removed ]                             ##
my $dry_run            = 1;
my $harmonize_outliers = 0;

my @tokens = split m| +|, $args_str =~ s{^\s+|\s+$}{}gr;
while (@tokens) {
    if ( $tokens[0] =~ m{^(?:execute|exec)$} ) {
        $dry_run = 0;
    } elsif ( $tokens[0] =~ m{^(?:harmonize-outliers|outliers)$} ) {
        $harmonize_outliers = 1;
    } else {
        last;
    }
    shift @tokens;
}
my $key_phrase = join q{ }, @tokens;
$key_phrase =~ s{^(['"])(.*)\1$}{$2}s;

<[base.log]>->(
    1, "Harmonizing author names and email addresses in git history..."
);

if ($harmonize_outliers) {
    <[base.log]>->( 1, "  Mode : Harmonizing outliers to main developer" );
}

if ( length $key_phrase ) {
    <[base.log]>->( 1, "  Filtering by key phrase : '$key_phrase'" );
}

if ($dry_run) {
    <[base.log]>->(
        1, "  DRY RUN mode - use 'execute' parameter to apply changes"
    );
}

## Trigger harmonization
my $result = <[work.parent.harmonize_emails]>->(
    {   dry_run            => $dry_run,
        harmonize_outliers => $harmonize_outliers,
        key_phrase         => $key_phrase,
        abort_after_valid  => 13
    }
);

if ( $result->{dry_run} ) {
    ## The parent function already printed detailed output  Just wrap with
    ## clean formatting
    say "";
    return FALSE;
}

unless ( $result->{success} ) {
    my $error = $result->{error} || 'unknown error';
    <[base.log]>->( 0, "✗ harmonization failed : $error" );
    return FALSE;
}

<[base.log]>->(
    1,
    sprintf( "✓ harmonized %d commits [ %d ids rewritten across all refs ]",
        $result->{changed} // 0, $result->{rewritten} // 0 )
);
return TRUE;

