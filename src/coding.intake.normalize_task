# name = coding.intake.normalize_task
# descr = normalizes task data with defaults and cleanup
# purpose = Standardize task fields for consistent processing

my ($task) = @ARG;

# Ensure all required fields exist with sensible defaults
$task->{type}                    = lc( $task->{type} // qw| analysis | );
$task->{priority}                = $task->{request}->{priority} // qw|normal|;
$task->{'execution'}->{'status'} = qw| pending |;

# Normalize priority values
if ( $task->{priority} !~ m{^(critical|high|normal|low)$} ) {
    $task->{priority} = qw| normal |;
}

return $task;

