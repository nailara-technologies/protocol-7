## [:< ##

# name  = screen.setup.dpi.revert
# descr = restore the value before the dpi preview

my $transaction = delete <screen.setup.dpi.transaction>;
return { 'mode' => qw| true |, 'data' => 'no dpi change to revert' }
    if not defined $transaction;

<screen.setup.dpi.revert_timer>->cancel
    if defined <screen.setup.dpi.revert_timer>;

my $value = $transaction->{'original'};
<[screen.setup.dpi.persist]>->($value);
delete <screen.setup.dpi.value>;

## an unset original uses the neutral baseline to undo the visible preview ##
$value //= 96;
<[screen.setup.dpi.apply]>->( { 'value' => $value } );
return { 'mode' => qw| true |, 'data' => "reverted desktop.dpi to $value" };

