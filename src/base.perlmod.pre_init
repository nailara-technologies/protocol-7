## [:< ##

# name  = base.perlmod.pre_init
# descr = ensure early dependencies are available for core functionality

##  Load Module::Runtime early for dynamic module loading in init_code  ####
<[base.perlmod.autoload]>->('Module::Runtime');

## bin/Protocol-7 needs these before any install path exists [ xz inline ##
## subroutines, AMOS7::INLINE at compile time ] : inside the auto-install ##
## window they are installed here, the next start uses them              ##
if ( <base.perlmod.auto_install> ) {
    <[base.perlmod.autoload]>->($ARG)
        foreach qw| IO::Uncompress::UnXz Inline::C |;
}

return FALSE;

