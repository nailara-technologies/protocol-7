## [:< ##

# name  = credentials.spawn_web_session
# descr = spawn a web session for web-session type credentials
#         token mode: returns a session token id
#         [ browser login integration is site-specific future work ]

my $cred      = shift;
my $for_zenka = shift // '';

return { 'mode' => qw| false |, 'data' => 'invalid credential' }
    unless ref $cred eq qw| HASH |;

my $cred_name = $cred->{'name'};

## generate session token id ##
my $token_id = <[base.gen_id]>->( <credentials.session>, undef, undef, 0 );

## store session with ttl ##
<credentials.session>->{$token_id} = {
    'cred'    => $cred_name,
    'zenka'   => $for_zenka,
    'token'   => $token_id,
    'expires' => time + <credentials.cfg.session_ttl>,
    'type'    => qw| web-session |,
};

<[base.logs]>->(
    2, 'credentials: session token %s created for %s [zenka: %s]',
    $token_id, $cred_name, $for_zenka
);

return { 'mode' => qw| true |, 'data' => $token_id };

