## [:< ##

# name  = coding.handler.spawn_smart
# descr = Intelligently spawn inference servers based on memory and existing
#         state
# note  = fully async since 2026-09-18 : the forced-respawn kill-wait [
#         while(kill(0,$pid)){ select(...) } up to 2.3s plus an
#         unconditional 0.3s gpu sleep ] blocked the ENTIRE single-threaded
#         event loop on every force=1 model switch -- confirmed live as the
#         mechanism behind repeated v7-zenki heartbeat-timeout kills of the
#         coding zenka during model sweeps. the wait is gone : the kill is
#         fired, everything needed to finish the spawn is stashed in
#         <coding.pending_switch>, and the actual memory-check + spawn runs
#         in coding.helper.complete_pending_switch once the old pid is
#         confirmed reaped by the zenka's own non-blocking SIGCHLD handler
#         [ coding.handler.inference_server_sigchld, via the
#         <coding.switching_backend> guard -- same shape as
#         <coding.draining> / <coding.lora_training_in_progress> ], or via a
#         bounded 3s fallback timer covering a missed/coalesced SIGCHLD. a
#         backend with no live old process completes immediately [ no
#         regression for the cold-start case ].
# note  = on_done convention mirrors plugin.usage.kimi.refresh_token :
#         { 'on_done' => { 'handler' => <name>, 'params' => {...} } } -- a
#         NAMED handler, never a coderef, so it survives source reloads.
#         it is dispatched via $code{handler}->(params) exactly once per
#         spawn attempt, with the real TRUE/FALSE outcome added as
#         $call_params{'spawn_result'} [ and 'backend' ]. for the
#         amos-path-async branch it fires in
#         coding.handler.spawn_smart_path_reply instead.

my $params  = shift;
my $backend = $params->{'backend'} // 'gpu';
my $force   = $params->{'force'}   // 0;

my $on_done = $params->{'on_done'};
$on_done = undef unless ref $on_done eq qw| HASH |;

## dispatch helper : fires the caller's on_done with the terminal result [ ##
## mirrors plugin.usage.kimi.refresh_token's dispatch shape ]              ##
my $dispatch_on_done = sub {
    my $result = shift;
    if (    ref $on_done eq qw| HASH |
        and length( $on_done->{'handler'} // '' )
        and exists $code{ $on_done->{'handler'} } ) {
        my $call_params = { %{ $on_done->{'params'} // {} } };
        $call_params->{'spawn_result'} = $result;
        $call_params->{'backend'}      = $backend;
        $code{ $on_done->{'handler'} }->($call_params);
    }
    return $result;
};

<[base.logs]>->(
    1, '[spawn_smart] evaluating spawn for backend=%s', $backend
);

## Check if server is already running and healthy  skip health check when ##
## force=1 [ e.g. model switch always needs respawn ]                     ##
my $port
    = $backend eq 'gpu'
    ? ( <inference.backend.gpu.port> // 8000 )
    : ( <inference.backend.cpu.port> // 8001 );

## check server status set by monitor_inference_startup [ non-blocking ] ##
unless ($force) {
    my $server = ( <coding.inference_servers> // {} )->{$backend};
    if ( defined $server && ( $server->{'status'} // '' ) eq qw| ready | ) {
        <[base.logs]>->(
            2, '[spawn_smart] %s server already ready, skipping', $backend
        );
        $dispatch_on_done->(TRUE);
        return TRUE;
    }
}

## Get model path from config ##
my $model_name
    = $backend eq 'cpu'
    ? ( <inference.backend.cpu.model_id> // '' )
    : ( <inference.backend.gpu.model_id> // '' );

unless ( length $model_name ) {
    <[base.logs]>
        ->( 0, '[spawn_smart] no model configured for %s', $backend );
    $dispatch_on_done->(FALSE);
    return FALSE;
}

## Lookup model in metadata cache ##
my $resolve = <[coding.helper.resolve_model_checksum]>
    ->( { model_name => $model_name } );
my $matched_entry = $resolve->{'matched_entry'};

unless ( defined $matched_entry ) {
    <[base.logs]>->( 0, '[spawn_smart] model not found: %s', $model_name );
    $dispatch_on_done->(FALSE);
    return FALSE;
}

my $had_live_pid = FALSE;
my $killed_pid   = 0;

## kill existing server before memory check when force=1  ensures freed ##
## VRAM / RAM is reflected in the check below                           ##
if ($force) {

    ## a second forced switch on the same backend while one is still      ##
    ## waiting for its old pid would clobber the stashed pending entry [  ##
    ## losing the first switch's on_done + leaving <coding.switch_model_  ##
    ## active> set forever ] -- finish the stale one first : converges on ##
    ## the newest request while still honouring both completions          ##
    if ( ref <coding.pending_switch>->{$backend} eq qw| HASH | ) {
        <[base.logs]>->(
            0,
            '[spawn_smart] %s : completing stale '
                . 'pending switch before new forced respawn',
            $backend
        );
        <[coding.helper.complete_pending_switch]>
            ->( { 'backend' => $backend } );
    }

    ## cancel any in-flight self-test on THIS backend before killing its    ##
    ## server [ task JEG : coding-switch-model-self-test-cancel ] :         ##
    ## confirmed live -- a model switch previously SIGKILLed the server out ##
    ## from under a genuinely streaming self-test probe with nothing        ##
    ## telling the probe's own pipeline, leaving the guard set until it     ##
    ## eventually cleared on its own [ now potentially a long wait, since   ##
    ## poll_probe's watchdog is liveness-aware and defers to the            ##
    ## coding.async.stream_tps outer cap ], and rejecting poll_switch's own ##
    ## post-switch self-test with "already in progress" the whole time.     ##
    ## same probe-state scan pattern used in verify_inference_ startup /    ##
    ## poll_switch / trigger_backend_self_test -- at most one entry can     ##
    ## match this backend, per the same invariant those rely on             ##
    if ( <coding.self_test_probe_in_flight>->{$backend} ) {
        my $probe_states = <coding.self_test_probe_state> // {};
        my $cancelled    = FALSE;
        for my $id ( keys %{$probe_states} ) {
            my $pst = $probe_states->{$id};
            next if ref $pst ne qw| HASH |;
            next if ( $pst->{'backend'} // '' ) ne $backend;

            ## a genuinely in-flight request : cancel it through its own  ##
            ## pipeline [ same shape poll_probe's own watchdog_abort path ##
            ## already uses ] rather than deleting state out from under a ##
            ## live request                                               ##
            my $http_state = $pst->{'http_state'};
            if ( $pst->{'in_flight'} and ref $http_state eq qw| HASH | ) {
                my $cb = $http_state->{'callbacks'} // {};
                $cb->{'on_error'}->('switch-model cancelled probe')
                    if ref $cb->{'on_error'} eq qw| CODE |;
                <[coding.async.http_cleanup]>->($http_state);
            }

            ## cancel the probe's own poll timer HERE, not just its state : ##
            ## without this the timer fires once more on its normal 0.5s    ##
            ## tick, finds its state already gone, and logs a level-0 "no   ##
            ## state ... stopping timer" line -- accurate, but alarming     ##
            ## noise for what is a routine, expected switch-cancel, not a   ##
            ## real anomaly. confirmed live 2026-09-18                      ##
            my $probe_timer = $pst->{'timer'};
            $probe_timer->cancel()
                if defined $probe_timer && $probe_timer->is_active();

            delete $probe_states->{$id};
            ## switch-model cancel : force [ holder check still applies ] ##
            <[coding.async.backend_release]>->( $id, $backend, qw| force | );
            $cancelled = TRUE;
            last;
        }

        ## stale guard, no matching probe state [ same case verify_         ##
        ## inference_startup's stale-guard fallback already handles ] :     ##
        ## nothing to cancel, clear it defensively - the server is about to ##
        ## be killed regardless                                             ##
        <coding.self_test_probe_in_flight>->{$backend} = FALSE;
        <[base.logs]>->(
            1,
            '[spawn_smart] %s : %s in-flight self-test before forced respawn',
            $backend,
            $cancelled ? 'cancelled' : 'cleared stale guard for'
        );
    }

    my $old = ( <coding.inference_servers> // {} )->{$backend};
    if ( defined $old ) {
        for my $w_key (qw| watcher_stdout watcher_stderr |) {
            my $w = $old->{$w_key};
            $w->cancel() if defined $w && $w->is_active();
        }
        ## cancel drain watchers BEFORE closing their fds : otherwise the ##
        ## event loop tries to re-arm a watcher on a dead fd and warns    ##
        for my $w_key (qw| watcher_drain_stdout watcher_drain_stderr |) {
            my $w = $old->{$w_key};
            $w->cancel() if defined $w && $w->is_active();
            delete $old->{$w_key};
        }
        for my $fh_key (qw| io_stdout io_stderr |) {
            my $fh = $old->{$fh_key};
            close($fh) if defined $fh;
        }
        if ( my $old_pid = $old->{'pid'} ) {
            if ( kill( 0, $old_pid ) ) {
                kill( 'KILL', $old_pid );
                <[base.logs]>->(
                    1,
                    '[spawn_smart] killed old %s server [pid:%d] '
                        . 'before memory check, completing asynchronously',
                    $backend,
                    $old_pid
                );
                $had_live_pid = TRUE;
                $killed_pid   = $old_pid;
            }
        }

        ## when a live old pid was killed the entry must STAY registered    ##
        ## until the SIGCHLD handler matches the reaped pid to this backend ##
        ## -- the completion helper deletes it. when nothing live was       ##
        ## killed there is no SIGCHLD to expect, so drop it now [ same      ##
        ## timing as the old blocking code ]                                ##
        delete <coding.inference_servers>->{$backend} unless $had_live_pid;
    }
}

## stash everything the completion helper needs once the old pid is    ##
## confirmed reaped [ or right away, when there was nothing to kill -- ##
## forced or not ]                                                     ##
<coding.pending_switch>->{$backend} = {
    'model_size_gb'     => $matched_entry->{'size_gb'} // 0,
    'mmproj_path'       => $params->{'mmproj_path'}    // '',
    'model_path'        => $params->{'model_path'}     // '',
    'amos_id'           => $matched_entry->{'amos'}    // '',
    'matched_file_path' => (
        exists $matched_entry->{'file_path'}
        ? ( $matched_entry->{'file_path'} // '' )
        : ''
    ),
    'port'         => $port,
    'on_done'      => $on_done,
    'had_live_pid' => $had_live_pid,
    'timer_w'      => undef,
};

if ($had_live_pid) {

    ## deliberate-switch guard : tells inference_server_sigchld this kill ##
    ## is NOT a crash [ same shape as <coding.draining> /                 ##
    ## <coding.lora_training_in_progress> ] -- the helper clears it       ##
    ## together with the pending entry, on BOTH the sigchld and the       ##
    ## fallback-timer path                                                ##
    <coding.switching_backend>->{$backend} = TRUE;

    ## bounded fallback : covers a missed/coalesced SIGCHLD. the old     ##
    ## blocking code budgeted ~2.3s for the old process to die -- the    ##
    ## one-shot completion gets the same magnitude [ 3s ] so callers can ##
    ## never hang forever                                                ##
    <coding.pending_switch>->{$backend}->{'timer_w'} = <[event.add_timer]>->(
        {   'after'   => 3,
            'desc'    => "pending switch fallback : $backend",
            'handler' => qw| coding.handler.pending_switch_timeout |,
            'data'    => { 'backend' => $backend },
        }
    );

    ## non-blocking reap attempt : if the old process was ALREADY a zombie ##
    ## [ e.g. it crashed earlier and was never reaped ] no SIGCHLD will    ##
    ## follow the SIGKILL -- complete immediately instead of waiting the   ##
    ## full fallback-timer budget                                          ##
    my $reaped = <[base.waitpid]>->($killed_pid);
    if ( $reaped == $killed_pid ) {
        <[coding.helper.complete_pending_switch]>
            ->( { 'backend' => $backend } );
    }

    return TRUE;    ## async : completion via sigchld handler / timer     ##
}

## no live old process : complete immediately [ cold start, or the old    ##
## server was already gone ] -- on_done fires synchronously, exactly like ##
## the pre-async code path for this case                                  ##
return
    <[coding.helper.complete_pending_switch]>->( { 'backend' => $backend } );

