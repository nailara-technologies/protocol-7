## [:< ##

# name  = coding.handler.spawn_smart
# descr = Intelligently spawn inference servers based on memory and existing state

my $params  = shift;
my $backend = $params->{'backend'} // 'gpu';
my $force   = $params->{'force'}   // 0;

<[base.logs]>->(
    1, '[spawn_smart] evaluating spawn for backend=%s', $backend
);

## Check if server is already running and healthy  skip health check when ##
## force=1 [ e.g. model switch always needs respawn ]                     ##
my $port
    = $backend eq 'gpu'
    ? ( <inference.backend.gpu.port> // 8000 )
    : ( <inference.backend.cpu.port> // 8001 );

## check server status set by monitor_inference_startup [ non-blocking ] ##
unless ($force) {
    my $server = ( <coding.inference_servers> // {} )->{$backend};
    if ( defined $server && ( $server->{'status'} // '' ) eq qw| ready | ) {
        <[base.logs]>->(
            2, '[spawn_smart] %s server already ready, skipping', $backend
        );
        return TRUE;
    }
}

## Get model path from config ##
my $model_name
    = $backend eq 'cpu'
    ? ( <inference.backend.cpu.model_id> // '' )
    : ( <inference.backend.gpu.model_id> // '' );

unless ( length $model_name ) {
    <[base.logs]>
        ->( 0, '[spawn_smart] no model configured for %s', $backend );
    return FALSE;
}

## Lookup model in metadata cache ##
my $metadata = <coding.model_metadata> // {};
my ( $matched_entry, $matched_name );

my $search_term = lc($model_name);
$search_term =~ s/[-_\s]+//g;

foreach my $cache_name ( keys %$metadata ) {
    my $entry = $metadata->{$cache_name};
    next if $cache_name =~ /mmproj/i;    ## Skip vision projectors ##

    my $entry_amos = $entry->{'amos'} // '';

    ## Check various match criteria ##
    my $norm_cache = lc($cache_name);
    $norm_cache =~ s/[-_\s]+//g;

    if (   $entry_amos eq $model_name
        || $cache_name eq $model_name
        || index( $norm_cache, $search_term ) >= 0 ) {
        $matched_entry = $entry;
        $matched_name  = $cache_name;
        last;
    }
}

unless ( defined $matched_entry ) {
    <[base.logs]>->( 0, '[spawn_smart] model not found: %s', $model_name );
    return FALSE;
}

## kill existing server before memory check when force=1  ensures freed ##
## VRAM / RAM is reflected in the check below                           ##
if ($force) {

    ## cancel any in-flight self-test on THIS backend before killing its    ##
    ## server [ task JEG : coding-switch-model-self-test-cancel ] :         ##
    ## confirmed live -- a model switch previously SIGKILLed the server out ##
    ## from under a genuinely streaming self-test probe with nothing        ##
    ## telling the probe's own pipeline, leaving the guard set until it     ##
    ## eventually cleared on its own [ now potentially a long wait, since   ##
    ## poll_probe's watchdog is liveness-aware and defers to the            ##
    ## coding.async.stream_tps outer cap ], and rejecting poll_switch's own ##
    ## post-switch self-test with "already in progress" the whole time.     ##
    ## same probe-state scan pattern used in verify_inference_ startup /    ##
    ## poll_switch / trigger_backend_self_test -- at most one entry can     ##
    ## match this backend, per the same invariant those rely on             ##
    if ( <coding.self_test_probe_in_flight>->{$backend} ) {
        my $probe_states = $data{'coding'}{'self_test_probe_state'} // {};
        my $cancelled    = FALSE;
        for my $id ( keys %{$probe_states} ) {
            my $pst = $probe_states->{$id};
            next if ref $pst ne qw| HASH |;
            next if ( $pst->{'backend'} // '' ) ne $backend;

            ## a genuinely in-flight request : cancel it through its own  ##
            ## pipeline [ same shape poll_probe's own watchdog_abort path ##
            ## already uses ] rather than deleting state out from under a ##
            ## live request                                               ##
            my $http_state = $pst->{'http_state'};
            if ( $pst->{'in_flight'} and ref $http_state eq qw| HASH | ) {
                my $cb = $http_state->{'callbacks'} // {};
                $cb->{'on_error'}->('switch-model cancelled probe')
                    if ref $cb->{'on_error'} eq qw| CODE |;
                <[coding.async.http_cleanup]>->($http_state);
            }
            delete $probe_states->{$id};
            <[coding.async.backend_release]>->( $id, $backend );
            $cancelled = TRUE;
            last;
        }

        ## stale guard, no matching probe state [ same case verify_         ##
        ## inference_startup's stale-guard fallback already handles ] :     ##
        ## nothing to cancel, clear it defensively - the server is about to ##
        ## be killed regardless                                             ##
        <coding.self_test_probe_in_flight>->{$backend} = FALSE;
        <[base.logs]>->(
            1,
            '[spawn_smart] %s : %s in-flight self-test before forced respawn',
            $backend,
            $cancelled ? 'cancelled' : 'cleared stale guard for'
        );
    }

    my $old = ( <coding.inference_servers> // {} )->{$backend};
    if ( defined $old ) {
        for my $w_key (qw| watcher_stdout watcher_stderr |) {
            my $w = $old->{$w_key};
            $w->cancel() if defined $w && $w->is_active();
        }
        ## cancel drain watchers BEFORE closing their fds : otherwise the ##
        ## event loop tries to re-arm a watcher on a dead fd and warns    ##
        for my $w_key (qw| watcher_drain_stdout watcher_drain_stderr |) {
            my $w = $old->{$w_key};
            $w->cancel() if defined $w && $w->is_active();
            delete $old->{$w_key};
        }
        for my $fh_key (qw| io_stdout io_stderr |) {
            my $fh = $old->{$fh_key};
            close($fh) if defined $fh;
        }
        if ( my $old_pid = $old->{'pid'} ) {
            if ( kill( 0, $old_pid ) ) {
                kill( 'KILL', $old_pid );
                <[base.waitpid]>->($old_pid);    ## reap zombie ##
                <[base.logs]>->(
                    1,
                    '[spawn_smart] killed old %s '
                        . 'server [pid:%d] before memory check',
                    $backend,
                    $old_pid
                );
                ## Wait for process to exit and reap zombie (max 2 seconds) ##
                my $wait_count = 0;
                while ( kill( 0, $old_pid ) && $wait_count < 20 ) {
                    select( undef, undef, undef, 0.1 );
                    <[base.waitpid]>->($old_pid)
                        ;    ## Reap if zombie [WNOHANG] ##
                    $wait_count++;
                }
                ## brief additional wait for gpu driver to release vram ##
                select( undef, undef, undef, 0.3 ) if $backend eq 'gpu';
            }
        }
        delete <coding.inference_servers>->{$backend};
    }
}

## Check memory before spawning ##
my $model_size_gb = $matched_entry->{'size_gb'} // 0;

if ( $backend eq 'gpu' ) {
    ## For GPU, check if we have enough VRAM ##
    my $nvidia_smi
        = `nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits 2>/dev/null`;
    if ( $? == 0 && $nvidia_smi =~ /^(\d+)/m ) {
        my $free_vram_mb  = $1;
        my $model_size_mb = $model_size_gb * 1024;
        my $required_mb
            = $model_size_mb + 512;    ## Model size + 512MB overhead ##

        if ( $free_vram_mb < $required_mb ) {
            <[base.logs]>->(
                1,
                '[spawn_smart] insufficient GPU '
                    . 'memory: %d MB free, need %d MB',
                $free_vram_mb,
                $required_mb
            );
            my $checksum = $matched_entry->{'amos'} // '';
            if ( length $checksum ) {
                <[coding.model_status.record]>->(
                    {   checksum => $checksum,
                        backend  => $backend,
                        status   => 'resource-insufficient',
                        detail   => sprintf(
                            '%d MB free, need %d MB',
                            $free_vram_mb, $required_mb
                        ),
                    }
                );
            }
            return FALSE;
        }
        <[base.logs]>->(
            2, '[spawn_smart] GPU memory OK: %d MB free for %d MB model',
            $free_vram_mb, $model_size_mb
        );
    }
} else {
    ## For CPU, check system RAM ##
    my $mem_available = 0;
    if ( open my $fh, '<', '/proc/meminfo' ) {
        while (<$fh>) {
            if (/^MemAvailable:\s+(\d+)/) {
                $mem_available = int( $1 / 1024 );    ## Convert to MB ##
                last;
            }
        }
        close $fh;
    }

    my $model_size_mb = $model_size_gb * 1024;
    my $required_mb
        = $model_size_mb + 1024;    ## Model size + 1GB overhead for CPU ##

    if ( $mem_available < $required_mb ) {
        <[base.logs]>->(
            1,
            '[spawn_smart] insufficient system '
                . 'memory: %d MB free, need %d MB',
            $mem_available,
            $required_mb
        );
        my $checksum = $matched_entry->{'amos'} // '';
        if ( length $checksum ) {
            <[coding.model_status.record]>->(
                {   checksum => $checksum,
                    backend  => $backend,
                    status   => 'resource-insufficient',
                    detail   => sprintf(
                        '%d MB free, need %d MB',
                        $mem_available, $required_mb
                    ),
                }
            );
        }
        return FALSE;
    }
    <[base.logs]>->(
        2, '[spawn_smart] system memory OK: %d MB free for %d MB model',
        $mem_available, $model_size_mb
    );
}

## Get the actual model path ##
my $amos_id     = $matched_entry->{'amos'} // '';
my $model_path  = $params->{'model_path'}  // '';
my $mmproj_path = $params->{'mmproj_path'} // '';

## use provided path directly if available [ e.g. from switch_model_reply ] ##
if ( length $model_path && -f $model_path ) {
    <[base.logs]>->( 2, '[spawn_smart] using provided model path directly' );
    return <[coding.spawn_inference_server]>->(
        {   backend     => $backend,
            model_path  => $model_path,
            mmproj_path => $mmproj_path,
            port        => $port,
            amos_id     => $amos_id,
        }
    );
}

## check if path cached in metadata entry ##
if ( exists $matched_entry->{'file_path'}
    && -f $matched_entry->{'file_path'} ) {
    $model_path = $matched_entry->{'file_path'};
} elsif ( length $amos_id ) {
    ## need to request path asynchronously ##
    <[base.logs]>->(
        2, '[spawn_smart] requesting path for amos=%s', $amos_id
    );

    <[protocol-7.command.send.local]>->(
        {   'command'   => 'cube.models.get_path_by_amos',
            'call_args' => { 'args' => $amos_id },
            'reply'     => {
                'params' => {
                    'amos_id'     => $amos_id,
                    'backend'     => $backend,
                    'port'        => $port,
                    'smart_spawn' => 1
                },
                'handler' => 'coding.handler.spawn_smart_path_reply'
            }
        }
    );

    return TRUE;    ## async : actual spawn happens in reply handler ##
} else {
    <[base.logs]>->( 0, '[spawn_smart] no amos_id for matched model' );
    return FALSE;
}

## spawn directly with resolved path ##
if ( defined $model_path && -f $model_path ) {
    return <[coding.spawn_inference_server]>->(
        {   backend     => $backend,
            model_path  => $model_path,
            mmproj_path => $mmproj_path,
            port        => $port,
            amos_id     => $amos_id,
        }
    );
}

return FALSE;

