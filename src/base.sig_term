## [:< ##

# name  = base.sig_term
# param = [ { reason => .., exit_code => .. } ]
# descr = SIGTERM : end the zenka [ v7-zenki : teardown of all zenki ]

## its default use is the SIGTERM watcher, called without arguments         ##
## [ base.event.add_signal ] : options only from an explicit hash reference ##
## [ base.sig_fault ], anything else keeps the defaults                     ##
my $opts = ref $ARG[0] eq qw| HASH | ? shift : {};

$PROGRAM_NAME .= ' :. shutdown in progress ., please wait .,';
<[base.log]>->( 1, 'SIGTERM received. shutting down ..,' );

<[base.code.call_expected]>->(
    <[base.mod.exists]>->(qw| v7-zenki |),
    qw| v7-zenki.teardown |,
    $opts->{'reason'} // '',
    undef, $opts->{'exit_code'}
);

<[base.net.send_to_all_initialized]>->('!TRM! zenka shutdown [ SIGTERM ]');

if ( exists <system.kill_list> and ref(<system.kill_list>) eq qw| ARRAY | ) {
    map { kill( 9, $ARG ) } <system.kill_list>->@*;
}

## logs, resets the terminal, exits ##
<[base.exit]>->( $opts->{'exit_code'} // 0, ':. done', 1 );

