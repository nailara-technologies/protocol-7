# name  = fetch.file.huggingface.handler.download_stderr
# descr = parse wget/huggingface-cli stderr output for progress

my $event = shift;
my $data  = $event->w->data;
my $dl_id = $data->{'dl_id'} // '';

my $dl = <fetch.file.downloads>->{$dl_id};
return if !defined $dl;

my $fh    = $event->w->fd;
my $buf   = '';
my $bytes = <[base.s_read]>->( $fh, \$buf, 4096 );

## EOF (0) or a real read error (negative): the child's stderr will never   ##
## produce more data. THE ACTUAL CPU-LOOP BUG, found live 2026-09-10 via    ##
## -vvv logging showing this handler firing every single event-loop         ##
## iteration forever: a level-triggered io-watcher on an EOF'd fd is        ##
## PERPETUALLY "readable" (0 bytes, over and over) -- returning here        ##
## without cancelling the watcher itself leaves it registered, so the event ##
## loop kept re-firing it continuously once the download's child process    ##
## (aria2c/wget) exited, pinning CPU near 100% even though the download     ##
## itself had already completed cleanly. matches the existing               ##
## clients.https.handler.io / clients.https.cleanup convention: cancel the  ##
## watcher on true EOF, don't just return from the handler.                 ##
if ( $bytes <= 0 ) {
    eval { $event->w->cancel };
    return;
}

## parse wget progress lines  example:  45% [========>      ] 1,234,567 ##
## 2.31MB/s  eta 45s                                                    ##
while ( $buf
    =~ m|(\d+)%\s+\[.*?\]\s+([\d,]+)\s+([\d.]+[KMGT]?B/s)\s+eta\s+(\d+\w+)|g )
{
    my ( $pct, $downloaded_str, $speed_str, $eta_str ) = ( $1, $2, $3, $4 );
    $downloaded_str =~ s|,||g;
    $dl->{'percent'}   = $pct;
    $dl->{'speed_str'} = $speed_str;
    $dl->{'eta_str'}   = $eta_str;
}

## parse aria2c summary lines  example: [#a1b2c3 4.2MiB/9.4MiB(44%) CN:1 ##
## DL:2.1MiB ETA:2s]                                                     ##
while ( $buf =~ m|\((\d+)%\)\s+CN:\d+\s+DL:([\d.]+\w*)(?:\s+ETA:(\S+))?|g ) {
    my ( $pct, $speed_str, $eta_str ) = ( $1, $2, $3 );
    $dl->{'percent'}   = $pct;
    $dl->{'speed_str'} = "$speed_str/s";
    $dl->{'eta_str'}   = $eta_str if defined $eta_str;
}

## parse huggingface-cli progress  example: Downloading README.md: ##
## 100%|████████████████| 12.3k/12.3k [00:02<00:00, 5.12kB/s]      ##
while ( $buf =~ m|(\d+(?:\.\d+)?)\s*(\w+)/\s*(\d+(?:\.\d+)?)\s*(\w+)|g ) {
    my ( $down, $down_unit, $total, $total_unit ) = ( $1, $2, $3, $4 );
    $dl->{'downloaded_str'} = "$down $down_unit";
    $dl->{'total_str'}      = "$total $total_unit";
}

