## [:< ##

# name  = coding.handler.model_path_reply
# descr = handle async reply from models zenka with resolved model path
# note  = called when models.get_path_by_amos command response arrives

use YAML::XS qw| Load |;

my $reply         = shift;
my $model_amos_id = $reply->{'params'}->{'model_amos_id'} // '';
my $backend       = $reply->{'params'}->{'backend'}       // 'gpu';

<[base.logs]>->(
    1, '[model_path_reply] received response for amos_id=%s [backend=%s]',
    $model_amos_id, $backend
);

## clear regardless of outcome below : a reply arrived, the request this ##
## guard was tracking is no longer in flight either way [ see            ##
## coding.resolve_model_path's own comment for why this flag exists ] -- ##
## per-backend now, so a cpu reply doesn't clear an in-flight gpu one    ##
<coding.model_path_request_in_flight>->{$backend} = FALSE;

my $response_text = $reply->{'data'} // '';

<[base.logs]>->(
    2, '[model_path_reply] response data length=%d',
    length($response_text)
);

## check for error response (plaintext, starts with 'error:')
if ( $response_text =~ m|^error:| ) {
    my ($err_line) = split( m|\n|, $response_text );
    <[base.logs]>->(
        0, '[model_path_reply] model lookup failed: %s', $err_line
    );
    return FALSE;
}

## parse YAML response
my $entry;
eval { $entry = Load($response_text) };
if ( $EVAL_ERROR || !ref($entry) ) {
    <[base.logs]>->(
        0, '[model_path_reply] YAML parse failed: %s',
        <[base.str.eval_error]>
    );
    return FALSE;
}

my $model_path = $entry->{'file_path'} // '';

unless ( defined $model_path && length $model_path ) {
    <[base.logs]>->( 0, '[model_path_reply] no file_path in response' );
    return FALSE;
}

<[base.logs]>->( 1, '[model_path_reply] %s model path resolved', $backend );
<[base.logs]>->(
    1, ':. %s', <[base.parser.ellipse_center]>->( $model_path, 60 )
);

## cpu writes its own backend-scoped slots; gpu keeps writing the shared ##
## <inference.model.*> keys exactly as before [ other code reads those   ##
## directly today ]                                                      ##
if ( $backend eq 'cpu' ) {
    <inference.backend.cpu.path>        = $model_path;
    <inference.backend.cpu.mmproj_path> = $entry->{'mmproj_path'} // '';
} else {
    <inference.model.path>        = $model_path;
    <inference.model.mmproj_path> = $entry->{'mmproj_path'} // '';
    <inference.model.is_vision>   = $entry->{'is_vision'}   // 0;
}

## re-trigger spawn if this backend's server is not yet running [ race with ##
## deferred timer ] -- per-backend now, via <inference.gpu_pid> /           ##
## <inference.cpu_pid>. the needs_respawn check [ mmproj became available   ##
## after initial spawn ] stays gpu-only : cpu model config has no           ##
## mmproj/vision path currently                                             ##
my $gpu_pid       = <inference.gpu_pid> // 0;
my $cpu_pid       = <inference.cpu_pid> // 0;
my $backend_pid   = $backend eq 'cpu' ? $cpu_pid : $gpu_pid;
my $needs_respawn = 0;
if ( $backend eq 'gpu' and $gpu_pid ) {
    my $server     = <coding.inference_servers>      // {};
    my $old_mmproj = $server->{'gpu'}{'mmproj_path'} // '';
    my $new_mmproj = <inference.model.mmproj_path>   // '';
    $needs_respawn = 1 if length($new_mmproj) && !length($old_mmproj);
}

if ( ( not $backend_pid or $needs_respawn )
    and exists $code{'coding.async_spawn_inference_servers'} ) {
    <[base.logs]>->(
        1,        '[model_path_reply] %s path resolved, triggering %sspawn',
        $backend, $needs_respawn ? 're-' : 'deferred '
    );
    $code{'coding.async_spawn_inference_servers'}->();

    ## cancel deferred spawn timer only once BOTH backends are settled : a  ##
    ## cpu-first reply must not cancel a timer the gpu side [ or vice versa ##
    ## ] may still need. 'settled' = genuinely spawned, or that backend is  ##
    ## not enabled at all. re-read the pids after the spawn call above --   ##
    ## it may have just set them                                            ##
    my $spawn_params = <coding.spawn_params> // {};

    ## normalize enabled flags to match async_spawn_inference_servers ##
    my $gpu_enabled_raw = lc( $spawn_params->{'gpu_enabled'} // 'yes' );
    my $gpu_enabled_str = 'no';
    $gpu_enabled_str = 'yes' if $gpu_enabled_raw =~ m{^(yes|true|1|auto)$};

    my $cpu_enabled_raw = lc( $spawn_params->{'cpu_enabled'} // 'no' );
    my $cpu_enabled_str = 'no';
    $cpu_enabled_str = 'yes'  if $cpu_enabled_raw =~ m{^(yes|true|1)$};
    $cpu_enabled_str = 'auto' if $cpu_enabled_raw eq 'auto';

    ## gpu is settled when disabled, already running, or cpu auto fallback ##
    ## is already running because gpu fit failed / gpu startup exhausted   ##
    ## retries                                                             ##
    my $gpu_settled;
    if ( $gpu_enabled_str eq 'yes' ) {
        $gpu_settled
            = (
            ( <inference.gpu_pid> // 0 )
                or ( $cpu_enabled_str eq 'auto'
                and ( <inference.cpu_pid> // 0 ) )
            )
            ? TRUE
            : FALSE;
    } else {
        $gpu_settled = TRUE;
    }

    ## cpu=auto is settled when either backend is running [ gpu success ##
    ## means no cpu fallback is needed ; cpu success means fallback     ##
    ## happened ]                                                       ##
    my $cpu_settled;
    if ( $cpu_enabled_str eq 'yes' ) {
        $cpu_settled = ( <inference.cpu_pid> // 0 ) ? TRUE : FALSE;
    } elsif ( $cpu_enabled_str eq 'auto' ) {
        $cpu_settled
            = (
                   ( <inference.cpu_pid> // 0 )
                or ( <inference.gpu_pid> // 0 )
            )
            ? TRUE
            : FALSE;
    } else {
        $cpu_settled = TRUE;
    }

    if (    $gpu_settled
        and $cpu_settled
        and defined <coding.timer.spawn_servers> ) {
        eval { <coding.timer.spawn_servers>->cancel };
        <coding.timer.spawn_servers> = undef;
        <[base.logs]>->(
            2, '[model_path_reply] cancelled deferred spawn timer'
        );
    }
}

return TRUE;

