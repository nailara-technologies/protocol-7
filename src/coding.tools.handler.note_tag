## [:< ##

# name  = coding.tools.handler.note_tag
# descr = add tags to a note section

my $args = shift // {};

my $section = $args->{'section'} // '';
my $tags    = $args->{'tags'}    // '';
my $task_id = $args->{'task_id'} // '';

return { 'content' => 'section and tags required' }
    unless length $section && length $tags;

## call backend ##
my $result
    = <[note.tag]>->( $section, $tags, length $task_id ? $task_id : undef );

return {
    'content' => $result->{'mode'} eq qw| true |
    ? $result->{'data'}{'message'}
    : "Failed: " . ( $result->{'data'} // 'unknown' ),
};

