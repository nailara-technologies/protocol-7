# name  = graphics.matrix.visual.build-cubic-grid
# descr = Build 3D cubic grid index from images

my $images = shift // [];

my $grid = {};
for my $img (@$images) {
    my ( $x, $y, $z ) = @{ $img->{'cubic_coord'} };
    $grid->{$x}{$y}{$z} = $img;
}

return $grid;

