## [:< ##

# name = models.chat.get_recent
# descr = get recent chat messages (last N or from specific point)
# param = $count - number of messages to retrieve (default: 20)
# return = arrayref of chat entries

my $count = shift // 20;

## return empty if no messages
return [] unless defined <models.chat.messages>;

my @messages = @{<models.chat.messages>};

## return last N messages
my $start = scalar(@messages) - $count;
$start = 0 if $start < 0;

return [ @messages[ $start .. $#messages ] ];

0;

