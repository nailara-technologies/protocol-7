## [:< ##

# name  = httpsd.self_restart
# descr = request v7 to restart this zenka [ binding port 443 requires
#         root privileges, available only during fresh startup ]

<[base.log]>->( 1, ': . httpsd self-restart requested .,' );

<[protocol-7.command.send.local]>->(
    {   'command'   => qw| cube.v7.restart_own-zenka |,
        'call_args' => {}
    }
);

return TRUE;

