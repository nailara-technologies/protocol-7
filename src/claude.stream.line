## [:< ##

# name  = claude.stream.line
# descr = one stream event from the child
# args  = line [ octets ]

## decoded at the edge : readable lines are kept, the session id recorded ##
## on init, a result ends the turn [ signal, the next queued turn ]       ##

my $raw = shift // '';
return if $raw !~ m{\S};
my $d = <[claude.wire.decode]>->($raw);
if ( not defined $d ) {
    utf8::decode($raw);
    <[claude.event.add]>->( qw| out |, $raw );
    return;
}

foreach my $line ( <[claude.stream.describe]>->($d) ) {
    my ( $kind, $text ) = $line =~ m{\A(\S+(?: \[ error \])?) : (.*)\z}s;
    <[claude.event.add]>->( $kind // qw| out |, $text // $line );
}

my $session = $d->{'session_id'} // '';
<[claude.session.save]>->($session)
    if $session =~ m|\A[\w-]{8,80}\z|
    and $session ne ( <claude.session> // '' );

<[claude.turn.done]>->($d) if ( $d->{'type'} // '' ) eq qw| result |;

