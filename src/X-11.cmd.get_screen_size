# name  = X-11.cmd.get_screen_size
# descr = return X-11 screen size in pixels

<X-11.obj>->choose_screen(0);    # LLL: doesn't support multiple screens yet!

my %screen_geom = eval { <X-11.obj>->GetGeometry( <X-11.obj>->root ) };

my ( $width, $height ) = ( $screen_geom{'width'}, $screen_geom{'height'} );

if ( length $EVAL_ERROR or not defined $width or not defined $height ) {
    my $err
        = length $EVAL_ERROR
        ? <[base.str.eval_error]>
        : 'no geometry returned';
    return {
        'mode' => qw| false |,
        'data' => "could not get root window geometry: $err"
    };
}

return { 'mode' => qw| true |, 'data' => "$width $height" }

