## [:< ##

# name = login-screen.init_code
# descr = load native greeter dependencies and initialize state

<[base.perlmod.autoload]>->('Gtk3');
<[base.perlmod.autoload]>->('Socket');
<[base.perlmod.autoload]>->('X11::Protocol');
<[base.perlmod.autoload]>->('Fcntl');
<[base.perlmod.autoload]>->('POSIX');
<[base.gtk.attempt_load.glib_event]>;

<login-screen.state>        //= qw| init |;
<login-screen.runtime_root> //= qw| /var/run/.7/login-screen |;

0;

