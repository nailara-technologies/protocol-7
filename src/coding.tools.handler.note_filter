## [:< ##

# name  = coding.tools.handler.note_filter
# descr = multi-criteria filtering across notes

my $args = shift // {};

my $tag     = $args->{'tag'}     // '';
my $section = $args->{'section'} // '';
my $after   = $args->{'after'}   // '';
my $task_id = $args->{'task_id'} // '';

## call backend with undef for empty filters ##
my $result = <[note.filter]>->(
    length $tag     ? $tag     : undef,
    length $section ? $section : undef,
    length $after   ? $after   : undef,
    length $task_id ? $task_id : undef,
);

return {
    'content' => $result->{'mode'} ne qw| false |
    ? $result->{'data'}
    : "Failed: " . ( $result->{'data'} // 'unknown' ),
};

