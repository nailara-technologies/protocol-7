## [:< ##

# name  = space.travel.hop
# descr = apply directional step to node coordinate
# param = { from, direction }

my $params    = shift                  // {};
my $from      = $params->{'from'}      // '';
my $direction = $params->{'direction'} // '';

return { 'mode' => 'false', 'data' => 'from node required' }
    unless length $from;

## resolve coordinate from space grid ##
my $coord = <space.grid.nodes>->{$from};
if ( not defined $coord ) {
    return { 'mode' => 'false', 'data' => 'node has no coordinate' };
}

my %next = (
    'z' => $coord->{'z'} // 0,
    'y' => $coord->{'y'} // 0,
    'x' => $coord->{'x'} // 0
);

if ( $direction eq '+z' ) {
    $next{'z'}++;
} elsif ( $direction eq '-z' ) {
    $next{'z'}--;
} elsif ( $direction eq '+y' ) {
    $next{'y'}++;
} elsif ( $direction eq '-y' ) {
    $next{'y'}--;
} elsif ( $direction eq '+x' ) {
    $next{'x'}++;
} elsif ( $direction eq '-x' ) {
    $next{'x'}--;
} else {
    return { 'mode' => 'false', 'data' => 'invalid direction' };
}

return \%next;

