## [:< ##

# name  = coding.round_chain.rewind
# param = <task_id> <target_checksum>
# descr = move a task's round_chain_current tip to an earlier node. pure-ish :
#         mutates only round_chain_current, never the round_chain array
#         itself and never live async/task state -- callers are responsible
#         for rebuilding <coding.async.task_state> from
#         coding.round_chain.reconstruct's output and re-enqueuing a round
#         [ see coding.cmd.rewind-round ]. moving the tip alone is what
#         turns the NEXT coding.round_chain.append into a fork : that call
#         parents off round_chain_current, not off the array's physical
#         last entry, so history before the fork point is preserved intact
#         and reachable by checksum, never deleted or overwritten.
#
#         returns the target node [ so callers get its round number, delta,
#         timestamp, etc without a second lookup ] on success, undef if the
#         task or checksum isn't found.

my ( $task_id, $target_checksum ) = @ARG;

if ( not defined $task_id or not length $task_id ) {
    warn 'expected defined task_id <{C1}>';
    return undef;
}

if ( not defined $target_checksum or not length $target_checksum ) {
    warn 'expected defined target_checksum <{C1}>';
    return undef;
}

my $task = <coding.task.queue>->{$task_id};
if ( not defined $task ) {
    warn "task not found : '$task_id' <{C1}>";
    return undef;
}

my $chain = $task->{'round_chain'} // [];

## last-wins lookup, NOT grep-first-match : two DIFFERENT nodes can share a ##
## checksum when a resubmission produces byte-identical content [ same      ##
## parent + same delta -> same chain_L13 output, confirmed live on a narrow ##
## deterministic task ] -- must match coding.round_chain.  reconstruct's    ##
## %by_checksum map, which is last-wins by construction, or the two         ##
## functions can silently resolve the same checksum to different physical   ##
## nodes                                                                    ##
my %by_checksum = map { $ARG->{'checksum'} => $ARG } @{$chain};
my $node        = $by_checksum{$target_checksum};

if ( not defined $node ) {
    warn "checksum not found in round_chain : '$target_checksum' <{C1}>";
    return undef;
}

$task->{'round_chain_current'} = $target_checksum;

return $node;

