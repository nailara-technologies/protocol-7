## [:< ##

# name = zenki.parent.ensure_v7
# descr = ensure the 'v7-zenki' zenka is running
#         [ required for managing cube and other zenki ]

my $params = shift || {};

<[base.log]>->( 3, "zenki.ensure: checking 'v7-zenki' zenka..," );

## check if v7-zenki is already running ##
my $v7_check = <[zenki.parent.check_running]>->( { zenka => 'v7-zenki' } );

if ( $v7_check->{'running'} ) {
    <[base.logs]>->(
        3, "  ✓ v7-zenki already running [ pid %s ]",
        $v7_check->{'pid'}
    );

    ## update registry ##
    <zenki.running.v7> = {
        pid     => $v7_check->{'pid'},
        started => <zenki.running.v7.started> || <[base.ntime]>,
        status  => qw| running |
    };

    return {
        success         => TRUE,
        already_running => 1,
        pid             => $v7_check->{'pid'}
    };
}

## v7-zenki not running - it has to be bootstrapped ##
<[base.log]>->( 2, '  v7-zenki not running - attempting to start..,' );

## the whole fleet [ v7-zenki, cube and everything they drop privileges for ##
## ] needs root : an unprivileged front-door invocation can relay a start   ##
## request, but it cannot bring the fleet up in the first place             ##
unless (<zenki.cfg.auto_start_v7>) {
    <[base.logs]>->(
        0, '  cannot auto-start v7-zenki [ needs root, uid is %s ]', $UID
    );

    return {
        success => FALSE,
        error   => 'v7-zenki is not running and starting it needs root '
            . '[ run this as root, or start the fleet first ]',
        requires_root => 1
    };
}

## start v7-zenki ##
my $v7_binary = <zenki.cfg.v7_binary>;

unless ( -x $v7_binary ) {
    return {
        success => FALSE,
        error   => "v7-zenki binary not found or not executable: $v7_binary"
    };
}

<[base.logs]>->( 2, '  starting : %s v7-zenki &', $v7_binary );

## bootstrap case : v7-zenki does not exist yet, so its own jobqueue cannot ##
## be used to start it -- plain system() with detached streams              ##
my $result = system("$v7_binary v7-zenki </dev/null >/dev/null 2>&1 &");

if ( $result != 0 ) {
    return {
        success => FALSE,
        error   => "failed to start v7-zenki: system() returned $result"
    };
}

## wait for v7-zenki to be ready ##
<[base.log]>->( 2, '  waiting for v7-zenki to start..,' );

my $timeout    = <zenki.cfg.v7_startup_timeout>;
my $start_time = time();

while ( time() - $start_time < $timeout ) {
    sleep 1;

    my $check = <[zenki.parent.check_running]>->( { zenka => 'v7-zenki' } );

    if ( $check->{'running'} ) {
        <[base.log]>->( 2, '  ✓ v7-zenki started successfully' );

        ## update registry and statistics ##
        <zenki.running.v7> = {
            pid     => $check->{'pid'},
            started => <[base.ntime]>,
            status  => qw| running |
        };

        <zenki.stats.v7_starts>++;

        return {
            success => TRUE,
            started => 1,
            pid     => $check->{'pid'}
        };
    }
}

<[base.logs]>->( 0, '  ✗ v7-zenki startup timeout after %ds', $timeout );

return {
    success => FALSE,
    error   => "v7-zenki startup timeout after ${timeout}s"
};

0;

