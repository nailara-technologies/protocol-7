# name  = letsencr.parent.enroll_backoff_delay
# param = $attempts
# descr = exponential backoff delay [ seconds ] for a failed enrollment
#         attempt count : 1 h start, doubling, capped at 24 h

my $attempts = shift // 1;
$attempts = 1 if $attempts < 1;

my $delay = 3600 * ( 2**( $attempts - 1 ) );
$delay = 86400 if $delay > 86400;    ## cap : 24 h ##

return $delay;

