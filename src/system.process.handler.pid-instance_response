## [:< ##

# name = system.process.handler.pid-instance_response

my $response   = shift;
my $process_id = $response->{'params'}->{'process_id'};
my $cmd_rep_str
    = $response->{'call_args'}->{'args'};    # verbose cmd reply string
my $log_msg_str = $response->{'params'}->{'log_message'};

return warn "received instance id is not numerical"
    if $response->{'cmd'} eq qw| TRUE |
    and $cmd_rep_str !~ m|^\d+$|;

if ( $response->{'cmd'} eq qw| TRUE | ) {    # restart by 'v7-zenki' zenka
    my $instance_id = $cmd_rep_str;

    my $restart_last = <system.process.oom_restart.last> //= {};
    my $now = <[base.time]>->(2);

    my $escalate_window = <mem.oom_restart_window> // 60;
    my $escalate_reset  = <mem.oom_restart_reset>  // 600;

    ## forget restart memory quiet for longer than reset period ##
    map {
        delete $restart_last->{$ARG}
            if $now - $restart_last->{$ARG} > $escalate_reset;
        }
        keys $restart_last->%*;

    if ( defined $restart_last->{$instance_id}
        and $now - $restart_last->{$instance_id} <= $escalate_window )
    {    ## escalation : re-matched within window after restart request ##
        <[base.log]>->(
            0,
            sprintf ':. ESCALATION :. hard terminate [PID:%d] : instance %d '
                . 're-matched oom threshold within %ds of restart '
                . 'request',
            $process_id,
            $instance_id,
            $escalate_window
        );

        <[system.process.callback.send_kill]>->( $process_id, $log_msg_str );

        ## resolve zenka name for the escalation record [ async lookup ] ##
        <[protocol-7.command.send.local]>->(
            {   'command'   => qw| cube.v7-zenki.pid-lookup |,
                'call_args' => { 'args' => $process_id },
                'reply'     => {
                    'handler' =>
                        qw| system.process.handler.pid-lookup_response |,
                    'params' => {
                        'process_id'  => $process_id,
                        'instance_id' => $instance_id
                    }
                }
            }
        );
    } else {
        $restart_last->{$instance_id} = $now;    # remember restart request

        <[base.log]>->(
            0, " : asking 'v7-zenki' to " . "restart instance $instance_id"
        );

        <[protocol-7.command.send.local]>->(
            {   'command'   => qw| cube.v7-zenki.restart |,
                'call_args' => { 'args' => $instance_id }
            }
        );
    }
} elsif ( $cmd_rep_str eq 'found no matching instance' ) {    # kill allowed
    <[base.log]>->( 1, "[PID:$process_id] process not managed by v7 zenka" );

    <[system.process.callback.send_kill]>->( $process_id, $log_msg_str );

} else {    # unclear --> warn [ no v7 zenka access ? ]
    return warn "aborted autokill for pid $process_id [no v7 zenka access?]";
}

