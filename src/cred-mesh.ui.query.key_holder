## [:< ##

# name  = cred-mesh.ui.query.key_holder
# descr = return key-holder child process status

my $pid   = <cred-mesh.key_holder.pid>;
my $state = 'not started';

## child forks before drop_privs and keeps running as root — kill(0,$pid) ##
## from the now-unprivileged parent would always read EPERM as 'dead';    ##
## base.exists.sub-process checks the parent-child relation via waitpid   ##
## instead, which needs no uid match                                      ##
if ( defined $pid and $pid > 0 ) {
    $state = <[base.exists.sub-process]>->($pid) ? 'running' : 'terminated';
}

## key material is mlocked in child — treat as locked when running ##
my $locked = ( $state eq 'running' ) ? 'yes' : 'n/a';

## no operation tracking yet — phase 1 placeholder ##
my $last_op       = '';
my $last_op_age_s = 0;

return {
    'state'         => $state,
    'pid'           => $pid // '',
    'locked'        => $locked,
    'last_op'       => $last_op,
    'last_op_age_s' => $last_op_age_s,
};

