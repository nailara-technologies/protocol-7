## [:< ##

# name  = note.merge
# descr = combine notes from multiple sections or tasks

my ( $source_specs, $target_section, $target_task_id ) = @ARG;

return { 'mode' => qw| false |, 'data' => 'source_specs required' }
    unless defined $source_specs && length $source_specs;

return { 'mode' => qw| false |, 'data' => 'target_section required' }
    unless defined $target_section && length $target_section;

$target_task_id
    = <[note.util.safe_id]>->( $target_task_id // <system.task_id> );

## sanitize target section ##
$target_section =~ s|[^a-zA-Z0-9._-]|_|g;

my $notes_base = <[file.zenka_dir.data_path]> . '/notes';

## parse source specs: comma-separated "section" or "task_id:section" --  ##
## the task_id half is free-form input from the same string, so it needs  ##
## the same treatment as any other externally-supplied task_id, or a spec ##
## like "../../somewhere:x" could read a note section belonging to an     ##
## arbitrary task_id-shaped path outside what the caller should reach     ##
my @sources;
for my $spec ( split m|\s*,\s*|, $source_specs ) {
    next unless length $spec;
    if ( $spec =~ m|^([^:]+):(.+)$| ) {
        my ( $src_task, $src_section ) = ( $1, $2 );
        $src_section =~ s|[^a-zA-Z0-9._-]|_|g;
        push @sources,
            {
            'task_id' => <[note.util.safe_id]>->($src_task),
            'section' => $src_section
            };
    } else {
        my $src_section = $spec;
        $src_section =~ s|[^a-zA-Z0-9._-]|_|g;
        push @sources,
            { 'task_id' => $target_task_id, 'section' => $src_section };
    }
}

return { 'mode' => qw| false |, 'data' => 'no valid source specs' }
    unless @sources;

## validate all sources exist ##
my @source_content;
for my $src (@sources) {
    my $tid = $src->{'task_id'};
    my $sec = $src->{'section'};
    $sec =~ s|[^a-zA-Z0-9._-]|_|g;

    my $workspace_dir = "$notes_base/$tid/workspace";
    return {
        'mode' => qw| false |,
        'data' => "source not found: $tid/$sec"
        }
        unless -d $workspace_dir && -f "$workspace_dir/$sec.md";

    my $content = <[file.read]>->("$workspace_dir/$sec.md");
    push @source_content,
        {
        'task_id' => $tid,
        'section' => $sec,
        'content' => $content,
        };
}

## build merged content ##
my @merged;
for my $src (@source_content) {
    push @merged,
        sprintf( "## merged from %s/%s ##\n",
        $src->{'task_id'}, $src->{'section'} );
    push @merged, $src->{'content'};
    push @merged, "\n---\n";
}

my $merged_str = join( '', @merged );

## ensure target workspace exists ##
my $target_ws = "$notes_base/$target_task_id/workspace";
<[file.path.make_dir]>->($target_ws) unless -d $target_ws;

## write merged file : stash a pre-existing target first, or a name        ##
## collision with a source section [ or any other prior content ] would be ##
## silently clobbered with no way back                                     ##
my $target_file = "$target_ws/$target_section.md";
if ( -f $target_file ) {
    my $stashed = <[note.trash.stash]>->( $target_task_id, $target_section );
    return {
        'mode' => qw| false |,
        'data' => "target section '$target_section' already exists for "
            . "$target_task_id and could not be backed up -- merge "
            . "aborted to avoid overwriting it unrecoverably"
        }
        unless defined $stashed;
}
<[file.write]>->( $target_file, $merged_str );

## update meta ##
my $meta_file = "$notes_base/$target_task_id/.meta";
my $meta      = {};
if ( -f $meta_file ) {
    $meta = eval { JSON::PP::decode_json( <[file.read]>->($meta_file) ) };
    $meta = {} unless ref $meta eq qw| HASH |;
}
$meta->{'last_update'} = <[base.ntime]>;
<[file.write]>->( $meta_file, JSON::PP::encode_json($meta) );

my @source_names
    = map { sprintf( "%s/%s", $ARG->{'task_id'}, $ARG->{'section'} ) }
    @source_content;

<[base.logs]>->(
    2,
    "note.merge: merged %d sources into %s/%s [ %d bytes ]",
    scalar @source_names,
    $target_task_id, $target_section, length $merged_str,
);

return {
    'mode' => qw| true |,
    'data' => sprintf(
        "merged %d sources into '%s' for %s [ %d bytes ]: %s",
        scalar @source_names,
        $target_section,
        $target_task_id,
        length $merged_str,
        join( ', ', @source_names ),
    ),
};

