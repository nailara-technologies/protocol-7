## [:< ##

# name  = editor.control.load_field
# descr = externally rewrite a field's text + cursor [ history/search/etc ]

## $cursor : 'end' [ default, matches AMOS7::TERM::editor_load ] | 'start' |
## integer CHARACTER offset  like editor_load, external rewrite clears the
## kill buffer.

my ( $editor_state, $field, $text, $cursor ) = @ARG;

return undef if ref $editor_state ne qw| HASH |;
my $buffer = $editor_state->{'fields'}{$field} // return undef;
return undef if $buffer->{'readonly'};

<[editor.buffer.memory.load]>->( $buffer, $text );

my $buf_len = <[editor.buffer.memory.length]>->($buffer);
$cursor //= 'end';
if ( $cursor eq qw| start | ) {
    $buffer->{'cursor'} = 0;
} elsif ( $cursor eq qw| end | ) {
    $buffer->{'cursor'} = $buf_len;
} else {
    $buffer->{'cursor'}
        = $cursor < 0        ? 0
        : $cursor > $buf_len ? $buf_len
        :                      $cursor;
}

$editor_state->{'kill_buffer'} = '';

return TRUE;

