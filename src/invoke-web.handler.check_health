## [:< ##

# name  = invoke-web.handler.check_health
# descr = periodic timer handler: verify invoke.ai process is still alive

my $pid = <invoke-web.pid>;
return unless defined $pid;

unless ( <[invoke-web.is_alive]>->($pid) ) {

    ## its last lines first [ a traceback explains the end ] ##
    <[invoke-web.output.read]>;
    <[invoke-web.output.stop]>;

    ## ended before ready : the start failed -- show why, hold nothing ##
    if ( not <invoke-web.ready_logged> and not <invoke-web.crash_logged> ) {
        <invoke-web.crash_logged> = TRUE;
        <[base.logs]>->( 0, 'invoke.ai ended before ready, last output :' );
        my @tail = ( <invoke-web.output_tail> // [] )->@*;
        @tail = @tail[ -8 .. -1 ] if @tail > 8;
        <[base.logs]>->( 0, ':. %s', $ARG ) for @tail;
        <[invoke-web.queue.release]>;
    }

    <[base.logs]>->( 0, 'invoke.ai process [pid:%d] disappeared', $pid );
    <invoke-web.status> = 'crashed';
    <[base.zenki.resume_ondemand_timeout]>;
    <invoke-web.pid> = undef;
    <[file.zenka_dir.unlink_file]>->( 'state/invokeai.pid', TRUE );
}

