## [:< ##

# name  = base.parser.config
# descr = returns perl code from parsed zenka config
# [LLL] = needs more clean up \ extracting of parser code..,

<[base.log]>->( 2, ': parsing protocol-7 zenka code ..,' );
<base.parser.config.errors> //= 0;
my $parse_aref = shift // [];
my $var_prefix = shift // qw| $data |;
my $entries    = 0;
my @init_code  = ();

my %seen_keys = ();    ## duplicate key detection within this parse run ##

## line rules [ description capture, comments, trimming, inline code skip, ##
## continuation joining, `key = value` blanks ] live in AMOS7::Config so   ##
## the standalone config readers share them -- what follows turns the      ##
## normalised lines into perl code                                         ##
<[base.perlmod.load]>->('AMOS7::Config')
    if not <[base.perlmod.loaded]>->('AMOS7::Config');

foreach my $_record ( AMOS7::Config::normalize_lines($parse_aref)->@* ) {

    ## the parser state decides whether a found description is taken ##
    <base.config_parser.cfg_descr> = $_record->{'descr'}
        if defined $_record->{'descr'}
        and defined <base.config_parser.cfg_type>
        and defined <base.config_parser.cfg_name>
        and ( !length(<base.config_parser.cfg_descr>)
        or <base.config_parser.cfg_descr> eq qw| <STDIN> | );

    my $conf_line = $_record->{'text'};
    next if not defined $conf_line;

    $conf_line =~ s|\$([\{\w])|\\\$$1|g;    ## <-- disallow perl variables ##

    # <<keyword>> requests corresponding data value from network
    # warning: <<<variable>>> will not work in current implementation.,
    $conf_line =~ s|<<([\w_-]+(\.[\w_-]+)*)>>|\[net.get:"$1"]|g;

    ## mask single-quoted strings — prevent [cmd] expansion inside them ##
    my %_qmask = ();
    my $_qmi   = 0;
    $conf_line =~ s{'[^']*'}{
        my $k = sprintf "\x00Q%d\x00", $_qmi++;
        $_qmask{$k} = $&;
        $k
    }ge;

    my ( $found, $rec_depth ) = ( 1, 0 );
    while ($found) {
        $found = 0;
        if ( $conf_line =~ m{(?<![\w\d])\[([^\[|^\]]+)\]} )
        {    # [LLL] check '|'
            $found = 1;
            my ( $cmd_name, $param ) = ( ${^CAPTURE}[0], '' );
            my $out = '';
            if ( $cmd_name =~ s|([^:]+):(.+)$|$1| ) {
                $param = ${^CAPTURE}[1];
                ## $param = "\"$2\"";
                ## $param =~ s|,|","|g;
            }

            while ( $param =~ m|(?<!')<([\w_-]+(\.[\w_-]+)+)>(?!')| ) {
                my $conf_key  = ${^CAPTURE}[0];
                my $eval_code = $conf_key;
                $eval_code =~ s|[ \t\n]+||g;
                $eval_code =~ s|\.|'}{'|g;
                $eval_code = "${var_prefix}{'$eval_code'}";
                $eval_code =~ s|\.|\\.|;
                $param     =~ s|(?<!')<$conf_key>(?!')|$eval_code|g;
            }

            ## [code_name:param] shortcut patterns ##

            my $cmd_name_prefixes = qr,^(zenka|root)\.,;

            if ( $cmd_name !~ m|\.|
                and defined $code{ qw| base. | . $cmd_name } ) {
                $cmd_name = sprintf qw| base.%s |, $cmd_name;

            } elsif ( $cmd_name =~ $cmd_name_prefixes
                and defined $code{ qw| base. | . $cmd_name } ) {
                $cmd_name = sprintf qw| base.%s |, $cmd_name;

            } elsif ( $cmd_name !~ m|\.|
                and defined $code{ qw| base.cmd. | . $cmd_name } ) {
                $cmd_name = sprintf qw| base.cmd.%s |, $cmd_name;

            } elsif ( $cmd_name !~ m|\.| ) {
                <[base.logs]>->(
                    "called not defined command '%s'..,", $cmd_name
                );
                ## unresolved dotless name — mask to avoid infinite loop, ##
                ## restore after the substitution loop                    ##
                my $mk = sprintf "\x00U%d\x00", $_qmi++;
                $_qmask{$mk} = "[$cmd_name]";
                $conf_line =~ s{(?<![\w\d])\[([^\[|^\]]+)\]}{$mk};
                next;
            }

            $conf_line =~ s{(?<![\w\d])\[([^\[|^\]]+)\]}
                           {\$code{'$cmd_name'}->($param)};

            while ( $conf_line =~ m,^[ \t]*([^\$|^ |^\t]+)[ \t]*=, ) {
                my $new_conf_line = $LAST_PAREN_MATCH;
                $new_conf_line =~ s|[ \t\n]||g;
                $new_conf_line = "${var_prefix}{\'$new_conf_line\'}";
                $new_conf_line =~ s|\.|'}{'|g;
                $conf_line     =~ s{^[ \t]*([^\$|^ |^\t]+)[ \t]*=}
                                   {$new_conf_line = };
            }
            $rec_depth++;
        }
    }
    ## restore masked single-quoted strings and unresolved names ##
    $conf_line =~ s|\x00[QU](\d+)\x00|$_qmask{$&} // $&|eg
        if %_qmask;
    if ($rec_depth) {
        push( @init_code, $conf_line );
        $conf_line = '';
        $found     = 0;
    } else {
        my ( $_name, $_value ) = split( qw| = |, $conf_line, 2 );
        if ( defined $_value ) {
            $_name  =~ s|[ \t\n]||g;
            $_value =~ s|'||g;

            ## Expand template keys like <admin-user> -> admin-user ##
            while ( $_name =~ m|(?<!')<([\w_-]+)>(?!')| ) {
                my $template = sprintf qw| <%s> |, ${^CAPTURE}[0];
                my $expanded    ## silent mode ##
                    = <[base.access.special-user-map]>->( $template, 1 );
                if ( defined $expanded ) {
                    $_name =~ s|(?<!')<[^>]+>(?!')|$expanded|;
                } else {
                    last;       ## template not recognized, keep original ##
                }
            }

            my $conf_hash = sprintf qw| %s{'%s'} |, $var_prefix, $_name;
            $conf_hash =~ s|\.|'}{'|g;

            while ( $_value =~ m|(?<!')<([\w_-]+(\.[\w_-]+)+)>(?!')| ) {
                my $conf_key  = ${^CAPTURE}[0];
                my $eval_code = $conf_key;
                $eval_code =~ s|[ \t\n]+||g;
                $eval_code =~ s|\.|'}{'|g;
                $eval_code = sprintf qw| %s{'%s'} |, $var_prefix, $eval_code;
                $eval_code =~ s|\.|\\.|;
                $_value    =~ s|(?<!')<$conf_key>(?!')|'.$eval_code.'|g;
            }

            my $cmd = join( qw| = |, $conf_hash, "'$_value'" );

            $cmd =~ s{''\.|\.''}{}g;

            ## warn on duplicate key : second assignment silently ##
            ## overwrites                                         ##
            if ( exists $seen_keys{$_name} ) {
                <[base.logs]>->(
                    0,
                    "duplicate config key '%s' : "
                        . "previous value overwritten [ %s ]",
                    $_name,
                    <base.config_parser.cfg_name> // 'unknown'
                );
            }
            $seen_keys{$_name} = TRUE;

            push( @init_code, $cmd );

            if ($EVAL_ERROR) {
                <base.parser.config.errors>++;
                <[base.logs]>->(
                    0,    "<< error during config parsing : ['%s'] %s >>",
                    $cmd, <[base.str.os_err]>
                );
                undef $EVAL_ERROR;
            } else {
                $entries++;
            }
        }
    }
}

if ( defined <system.zenka.verbosity.console>
    and <system.zenka.verbosity.console> > 1 ) {
    foreach my $code (@init_code) { <[base.logs]>->( 2, ': : %s', $code ) }
}

if (    my $cfg_type = <base.config_parser.cfg_type>
    and my $cfg_name = <base.config_parser.cfg_name> ) {
    <system.descr.config>->{$cfg_type}->{$cfg_name}
        = <base.config_parser.cfg_descr> // '';
}
delete <base.config_parser>;

return @init_code;

