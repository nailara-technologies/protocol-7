# name  = sessions.util.holder.accept_with_timeout
# descr = blocking accept() on a listening unix socket, bounded by a
#         wall-clock timeout [ local read-loop timing -- base.time is the
#         right tool here, not base.ntime, which is reserved for the knock
#         freshness derivation ]

my $listen_sock = shift;
my $timeout     = shift // 3;

my $start = <[base.time]>->(1);
while ( ( <[base.time]>->(1) - $start ) < $timeout ) {
    my $rin = '';
    vec( $rin, fileno($listen_sock), 1 ) = 1;
    my $nfound = select( $rin, undef, undef, 0.05 );
    next if not defined $nfound or $nfound <= 0;

    my $client = $listen_sock->accept();
    return $client if defined $client;
}

return undef;

