# name = image2html.parent.init_code

<[event.add_signal]>->(
    { 'signal' => 'CHLD', 'handler' => qw|base.handler.sig_chld.shutdown| } );

<sig.chld.shutdown.pid>->{<image2html.child.pid>} = TRUE;

0;

