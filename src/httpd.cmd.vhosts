## [:< ##

# name  = httpd.cmd.vhosts
# descr = list configured virtual hosts with status
# param = [domain]

my $domain_filter = $call->{'args'} // '';

if ($domain_filter) {
    ## Show specific vhost details
    my $vhost = <httpd.vhosts.registry>->{$domain_filter};

    if ( !defined $vhost ) {
        return {
            'mode' => qw| false |,
            'data' => "vhost '$domain_filter' not found in registry"
        };
    }

    my $age     = time() - ( $vhost->{'discovered_at'} || 0 );
    my $age_str = sprintf( "%dd %dh",
        int( $age / 86400 ),
        int( ( $age % 86400 ) / 3600 ) );

    my $output = sprintf( "VHost: %s\n  Path: %s\n  Discovered: %s ago",
        $domain_filter, $vhost->{'source_path'} // '?', $age_str );

    return {
        'mode' => qw| true |,
        'data' => $output
    };
}

## List all vhosts using list infrastructure
my @output;
my $count = scalar keys <httpd.vhosts.registry>->%*;

if ( $count == 0 ) {
    return {
        'mode' => qw| true |,
        'data' => 'no virtual hosts configured'
    };
}

push @output, sprintf( "Configured virtual hosts: %d\n", $count );

## Use fallback manual display since base.list.formatted.show doesn't exist
foreach my $id ( sort keys <httpd.vhosts.registry>->%* ) {
    my $vh   = <httpd.vhosts.registry>->{$id};
    my $cert = $vh->{cert} ? '✓' : '✗';
    push @output, sprintf( "  [%s]  (cert: %s)", $id, $cert );
}

return {
    'mode' => qw| true |,
    'data' => join( "\n", @output )
};

