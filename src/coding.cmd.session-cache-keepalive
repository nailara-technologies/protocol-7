## [:< ##

# name  = coding.cmd.session-cache-keepalive
# param = [ on | off sid=<sid> ] -- none : the query
# descr = keep-alive open work, or a session's switch
# return = size : name, last, tab-separated descriptions with their item ids

my $all = <[coding.sessions.store]>;

## [ on | off ] sid=<sid> : the session switches its own keep-alive ##
## [ eg. off while nothing it waits on needs its context ]          ##
my $args = $call->{'args'} // '';
if ( $args =~ m{\A\s*(on|off)\s+sid=([0-9a-f-]{36})\s*\z}i ) {
    my ( $switch, $sid ) = ( lc $1, lc $2 );
    my @named = grep { ( $all->{$ARG}->{'sid'} // '' ) eq $sid }
        keys %{$all};
    return {
        'mode' => qw| false |,
        'data' => 'no single session holds this sid'
        }
        if @named != 1;
    if ( $switch eq qw| off | ) {
        $all->{ $named[0] }->{'cache_keepalive'} = qw| off |;
    } else {
        delete $all->{ $named[0] }->{'cache_keepalive'};
    }
    <[coding.sessions.store]>->(qw| save |);
    <[protocol-7.route-send]>
        ->( { 'command' => qw| events.cache-keepalive-arm | } );
    return {
        'mode' => qw| true |,
        'data' => "cache keep-alive $switch for $named[0]"
    };
}
return {
    'mode' => qw| false |,
    'data' => 'expected : [ on | off ] sid=<sid>'
    }
    if $args =~ m|\S|;

my @lines;
foreach my $name ( sort keys %{$all} ) {
    my $r = $all->{$name};
    next if $r->{'parked'};
    next if ( $r->{'cache_keepalive'} // '' ) eq qw| off |;
    my @open;
    foreach my $key ( sort keys %{$r} ) {
        next if $key !~ m{\Aopen\.(?:dispatch|wait)\.([\w-]+)\z};
        my $id   = $1;
        my $what = $r->{$key} // 'work';
        $what =~ tr|_| |;
        push @open, "$what [$id]";
    }
    next if not @open;
    push @lines,
        join( "\t",
        $name,
        $r->{'last'} // $r->{'since'} // 0,
        join( ', ', @open ) );
}
return { 'mode' => qw| size |, 'data' => join( "\n", @lines ) };

