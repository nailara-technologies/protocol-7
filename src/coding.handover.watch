## [:< ##

# name   = coding.handover.watch
# descr  = the signals the handover state follows
# return = { source => signal }
#
# one bucket entry per source waits for its signal and sends
# coding.handover-event <source> : the handler re-arms it and asks the
# source again [ signals carry no state the handover needs ]

return {
    'claude'   => qw| claude.run.done |,
    'kimi'     => qw| kimi.run.done |,
    'decision' => qw| decision.answered |
};

