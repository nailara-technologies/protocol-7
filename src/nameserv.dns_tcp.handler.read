## [:< ##

# name  = nameserv.dns_tcp.handler.read
# descr = read framed dns tcp messages and answer them in order

my $id = shift->w->data;

my $conns = <nameserv.dns_tcp.conns> // return;
my $conn  = $conns->{$id}            // return;

my $sock = $conn->{'sock'};

my $chunk = '';
my $bytes = <[base.s_read]>->( $sock, \$chunk, 65536 );

if ( ( $bytes // -1 ) == -1 ) {
    <[base.logs]>->(
        1,               ': dns tcp read error [ %s ] : %s',
        $conn->{'peer'}, <[base.str.os_err]>
    );
    <[nameserv.dns_tcp.close]>->($conn);
    return;
}

if ( $bytes == 0 ) {    ## peer closed the connection ##
    <[nameserv.dns_tcp.close]>->($conn);
    return;
}

$conn->{'in'} .= $chunk;

## hard input limit : 2 length bytes + maximum dns message size ##
if ( length $conn->{'in'} > 65537 ) {
    <[base.logs]>->(
        1, ': dns tcp input buffer limit [ %s ]',
        $conn->{'peer'}
    );
    <[nameserv.dns_tcp.close]>->($conn);
    return;
}

## framed messages : 2-byte big-endian length + dns message ; several ##
## queries may arrive pipelined in a single read                      ##
my $activity = 0;
while ( length $conn->{'in'} >= 2 ) {
    my $msg_len = unpack qw| n |, $conn->{'in'};
    if ( $msg_len < 12 ) {    ## zero length or shorter than a dns header ##
        <[nameserv.dns_tcp.close]>->($conn);
        return;
    }
    last if length $conn->{'in'} < 2 + $msg_len;    ## incomplete message ##

    ## drop the whole frame [ length prefix + message ] ##
    my $wire  = substr $conn->{'in'}, 0, 2 + $msg_len, '';
    my $query = substr $wire, 2;
    $activity++;

    <nameserv.stats>->{'tcp_queries'}++;

    my $reply = <[nameserv.answer]>->($query);
    next if not defined $reply;

    ## forwarding cache mode [ same conditions as the udp handler ] ##
    if (    $reply->header->rcode eq qw| REFUSED |
        and <[base.cfg_bool]>->( <nameserv.cfg.cache.enabled> // FALSE )
        and <[nameserv.cache.client_allowed]>->( $conn->{'peer'} // '' ) ) {

        my $q_packet = eval { Net::DNS::Packet->new( \$query ) };
        if ( defined $q_packet and $q_packet->header->rd ) {
            my $hit = <[nameserv.cache.get]>->($q_packet);
            if ( defined $hit ) {
                $reply = $hit;
            } else {
                ## miss : forward async ; the connection may close before ##
                ## the upstream answers -- the deliver callback re-checks ##
                ## it by id AND identity : a new connection can reuse the ##
                ## id [ peer + fileno ] of a closed one                   ##
                my $conn_id  = $id;
                my $conn_ref = $conn;
                <[nameserv.cache.forward]>->(
                    $q_packet,
                    sub {
                        my $fwd_reply = shift                    // return;
                        my $fwd_conns = <nameserv.dns_tcp.conns> // return;
                        my $fwd_conn  = $fwd_conns->{$conn_id}   // return;
                        return if $fwd_conn != $conn_ref;
                        my $fwd_data = $fwd_reply->data(65535);
                        return unless defined $fwd_data and length $fwd_data;
                        $fwd_conn->{'out'}
                            .= pack( qw| n |, length $fwd_data ) . $fwd_data;
                        <[nameserv.dns_tcp.handler.write]>->($conn_id);
                        return;
                    }
                );
                next;    ## answered later, maybe ##
            }
        }
    }

    ## tcp replies are never truncated : 65535 holds any dns message ##
    my $reply_data = $reply->data(65535);
    next if not defined $reply_data or not length $reply_data;

    $conn->{'out'} .= pack( qw| n |, length $reply_data ) . $reply_data;

    ## a client that sends queries but never reads its replies : the output ##
    ## is capped like the input [ four full-size replies ]                  ##
    if ( length $conn->{'out'} > 4 * 65537 ) {
        <[base.logs]>->(
            1, ': dns tcp output buffer limit [ %s ]',
            $conn->{'peer'}
        );
        <[nameserv.dns_tcp.close]>->($conn);
        return;
    }
}

if ($activity) {
    $conn->{'last_active'} = time;    ## a complete query resets idle ##

    ## re-arm the idle timeout ##
    if ( ref $conn->{'timer'} ) {
        $conn->{'timer'}->cancel
            if $conn->{'timer'}->can('is_active')
            and $conn->{'timer'}->is_active;
        $conn->{'timer'} = undef;
    }
    $conn->{'timer'} = <[event.add_timer]>->(
        {   after   => <nameserv.cfg.tcp.idle_timeout> // 13,
            handler => qw| nameserv.dns_tcp.handler.timeout |,
            data    => $id,
            desc    => "dns tcp idle timeout [ $conn->{'peer'} ]"
        }
    );

    ## try to flush ; a partial write arms the write watcher ##
    <[nameserv.dns_tcp.handler.write]>->( $conn->{'id'} );
}

return;

