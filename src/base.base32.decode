## [:< ##

# name  = base.base32.decode
# descr = decode base32 string in reverse byte order and return value
# note  = dependencies loaded already in bin/Protocol-7

if ( not defined $ARG[0] ) {
    warn '[B32] input not defined., [dec] <{C1}>';
    return undef;
} elsif ( ref $ARG[0] ne qw| SCALAR | ) {
    return Crypt::Misc::decode_b32r( $ARG[0] );
} else {
    return Crypt::Misc::decode_b32r( $ARG[0]->$* );
}

