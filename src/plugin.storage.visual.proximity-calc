# name  = plugin.storage.visual.proximity-calc
# descr = Calculate visual proximity between P7REFs

my ($args) = @ARG;

my $ref1 = $args->{ref1}
    or return { 'mode' => 'false', 'data' => 'ref1 required' };
my $ref2 = $args->{ref2}
    or return { 'mode' => 'false', 'data' => 'ref2 required' };
my $method = $args->{method} // 'harmonized';

my $registry = $data{'storage'}{'mapping'}{'visual'};
my $methods  = $registry->{'proximity_methods'};

my $distance;

if ( $method eq 'checksum' ) {
    $distance
        = <[plugin.storage.util.visual.checksum_distance]>->( $ref1, $ref2 );
} elsif ( $method eq 'path' ) {
    $distance
        = <[plugin.storage.util.visual.path_distance]>->( $ref1, $ref2 );
} elsif ( $method eq 'semantic' ) {
    $distance
        = <[plugin.storage.util.visual.semantic_distance]>->( $ref1, $ref2 );
} elsif ( $method eq 'temporal' ) {
    $distance
        = <[plugin.storage.util.visual.temporal_distance]>->( $ref1, $ref2 );
} elsif ( $method eq 'harmonized' ) {

    # Weighted combination
    my $total_weight = 0;
    my $weighted_sum = 0;

    for my $m ( keys %$methods ) {
        my $d;
        $d
            = <[plugin.storage.util.visual.checksum_distance]>
            ->( $ref1, $ref2 )
            if $m eq 'checksum';
        $d = <[plugin.storage.util.visual.path_distance]>->( $ref1, $ref2 )
            if $m eq 'path';
        $d
            = <[plugin.storage.util.visual.semantic_distance]>
            ->( $ref1, $ref2 )
            if $m eq 'semantic';
        $d
            = <[plugin.storage.util.visual.temporal_distance]>
            ->( $ref1, $ref2 )
            if $m eq 'temporal';

        next unless defined $d;

        $weighted_sum += $d * $methods->{$m}{weight};
        $total_weight += $methods->{$m}{weight};
    }

    $distance = $total_weight > 0 ? $weighted_sum / $total_weight : 1.0;
} else {
    return { 'mode' => 'false', 'data' => "Unknown method: $method" };
}

# Clamp to 0-1
$distance = 0 if $distance < 0;
$distance = 1 if $distance > 1;

return {
    'mode' => 'true',
    'data' => {
        'ref1'       => $ref1,
        'ref2'       => $ref2,
        'method'     => $method,
        'distance'   => $distance,
        'similarity' => 1.0 - $distance,
    }
};

