## [:< ##

# name  = thermal.start.ready
# descr = check cold start temperature memory and idle gates

my ( $gate, $mem_gate, $idle_gate, $now ) = @ARG;

return FALSE
    if defined $gate->{'state'} and $gate->{'state'} ne qw| cold |;
return FALSE if ref $mem_gate ne qw| HASH |;
return FALSE if ( $mem_gate->{'state'} // '' ) ne qw| calm |;

return <[thermal.idle.held]>->(
    $idle_gate, $now, <thermal.cfg.start.hold> // 600
);

