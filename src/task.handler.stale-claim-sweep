## [:< ##

# name  = task.handler.stale-claim-sweep
# descr = periodic : expires claims [ task.claim_expire :
#         pending again, failed after max_attempts ]. a
#         renewing worker's claim [ task.touch ] expires one
#         lease after its last renewal, others after
#         task.cfg.stale_claim_secs
# note  = no double run : a requester dispatching again fails the
#         old task first [ jobsite : superseded ], a failed task is
#         never reset

## a renewing worker's claim [ task.touch : keep_alive ] expires one lease  ##
## after its last renewal ; a worker that never renews keeps the long limit ##
## [ task.cfg.stale_claim_secs, 0 \ small = off for them ]                  ##
my $lease     = <[task.claim_lease]>;
my $stale_max = <task.cfg.stale_claim_secs> // 21600;
$stale_max = 21600 if $stale_max !~ m|^\d+$|;

my $queue = <task.queue> // {};

foreach my $task_id ( keys %{$queue} ) {
    ## <task.queue> also holds 'order' [ an array ], not a task ##
    my $task = $queue->{$task_id};
    next if ref $task ne qw| HASH |;
    my $status = $task->{'status'} // '';
    next if $status ne qw| claimed | and $status ne qw| in_progress |;

    my $updated = $task->{'updated_at'} // '';
    next if not length $updated;
    my $age     = <[base.ntime.delta_seconds]>->($updated);
    my $max_age = $task->{'keep_alive'} ? $lease : $stale_max;
    next if not $task->{'keep_alive'} and $stale_max < 600;
    next if not defined $age or $age <= $max_age;

    ## pending again for another worker, failed after max_attempts expiries ##
    ## [ task.claim_expire logs either way ]                                ##
    <[task.claim_expire]>->(
        $task_id,
        sprintf(
            'stale claim : %s by %s, no update for %d s',
            $status, $task->{'agent'} // '-', $age
        )
    );
}

return;

