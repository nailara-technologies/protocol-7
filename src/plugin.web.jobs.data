## [:< ##

# name  = plugin.web.jobs.data
# descr = command handler for jobs data : returns SIZE reply with JSON

my $call = shift // {};

## stamp the watermark handed back to the client FIRST, before reading the ##
## cache/removed-log below -- a tombstone appended by an interleaved event ##
## between those reads and returning the response would otherwise be       ##
## silently excluded from @removed while still predating the ntime we hand ##
## back, permanently orphaning it from every future delta poll from this   ##
## client [ its watermark can only move forward ]. stamping here instead   ##
## guarantees anything appended mid-request is still >= this ntime, so the ##
## client's next poll will pick it up rather than skip it                  ##
my $current_ntime = <[base.ntime.b32]>;

## parse since=<ntime_b32> from args [forwarded from GET query string] ##
my $since_str = '';
my $args      = $call->{'args'} // '';
if ( $args =~ m{(?:^|&)since=([^&]+)} ) {
    $since_str = $1;
}
my $since_num
    = length($since_str)
    ? <[base.ntime_BASE32_to_numerical]>->($since_str)
    : undef;

my $jobs = <[plugin.web.jobs.cache.read_all]>;

my @ids = sort {
    ( $jobs->{$b}{'fetched_at'} // 0 ) <=> ( $jobs->{$a}{'fetched_at'} // 0 )
} keys %{$jobs};

my @array;
for my $job_id (@ids) {
    ## delta filter : skip jobs unchanged since the watermark note:      ##
    ## browser-owned fields [stage/notes] don not bump last_modified, so ##
    ## multi-device sync of those goes via POST reverse-queue only       ##
    if ( defined $since_num ) {
        my $lm_str = $jobs->{$job_id}{'last_modified'} // '';
        my $lm_num
            = length($lm_str)
            ? <[base.ntime_BASE32_to_numerical]>->($lm_str)
            : 0;
        next if defined $lm_num and $lm_num <= $since_num;
    }

    my $j = {
        %{ $jobs->{$job_id} },
        'id' => <[base.vax-int.encode]>->($job_id)
    };
    ## ui expects reason|summary as short aliases ##
    $j->{'reason'} = delete $j->{'score_reason'}
        if exists $j->{'score_reason'};
    $j->{'summary'} = delete $j->{'score_summary'}
        if exists $j->{'score_summary'};
    $j->{'repair_failed'} = $j->{'repair_failed'} // 0;
    ## normalize legacy pipeline status names to UI stage names ##
    my %status_to_stage = (
        'assessed' => 'review',
        'apply'    => 'to_apply',
    );
    my $stage = $j->{'stage'} // '';
    $j->{'stage'} = $status_to_stage{$stage} // $stage
        if length $stage;
    push @array, $j;
}

## tombstoned removals since the watermark : lets a delta-syncing browser   ##
## prune ids that vanished [ trashed/deleted/blocked ] instead of holding a ##
## stale cached copy forever                                                ##
my @removed;
if ( defined $since_num ) {
    my $log = <plugin.web.jobs.removed_log> // [];
    for my $entry ( @{$log} ) {
        next if ref $entry ne 'HASH';
        my $rn_str = $entry->{'ntime'} // '';
        my $rn_num
            = length($rn_str)
            ? <[base.ntime_BASE32_to_numerical]>->($rn_str)
            : undef;
        next if not defined $rn_num or $rn_num <= $since_num;
        push @removed, $entry->{'id'};
    }
}

my $json = eval {
    JSON::XS::encode_json(
        {   'jobs'    => \@array,
            'ntime'   => $current_ntime,
            'removed' => \@removed,
        }
    );
};
if ($@) {
    <[base.logs]>->(
        0, 'web.jobs.data: json error: %s',
        <[base.str.eval_error]>
    );
    return {
        'mode'         => qw| strm |,
        'data'         => '{"jobs":[],"ntime":""}',
        'content_type' => qw| application/json |
    };
}

<[base.logs]>->(
    2, '[web.jobs.data] returning %d bytes, %d jobs [ since=%s ]',
    bytes::length($json), scalar(@array), $since_str || 'none'
);

return {
    'mode'         => qw| strm |,
    'data'         => $json,
    'content_type' => qw| application/json |
};

