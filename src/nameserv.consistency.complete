## [:< ##

# name  = nameserv.consistency.complete
# descr = process one finished query, finish when none left

## the run ends when every query is answered or timed out ; follow-up queries
## [ resolve an ns, then ask it for the soa ] are dispatched from here.
## findings land in $state->{'findings'} as a set of lines, compared with the
## previous run at finish time. nothing is ever written to the zones.

my $state     = shift;
my $id        = shift;
my $values    = shift // [];
my $timed_out = shift // FALSE;

my $q = delete $state->{'queries'}->{$id};
return FALSE if not defined $q;

eval { $q->{'watcher'}->cancel } if defined $q->{'watcher'};
eval { $q->{'timer'}->cancel }   if defined $q->{'timer'};
eval { $q->{'sock'}->close }     if defined $q->{'sock'};

my $kind = $q->{'kind'};

if ( $kind eq qw| a | or $kind eq qw| aaaa | ) {
    ## public dns values of one dn name : checks 1 and 2 ##
    $state->{'dn'}->{ $q->{'name'} }->{$kind} = $values;
    <[nameserv.consistency.evaluate-dn]>->( $state, $q->{'name'} );

} elsif ( $kind eq qw| parent-ns | ) {
    ## glue is published only when the parent domain is delegated to one of ##
    ## our dn names -- otherwise skip it silently                           ##
    my @ns = map { lc $ARG } map {s|\.+$||r} @$values;
    $state->{'dn'}->{ $q->{'dn'} }->{'glue'}
        = ( grep { $state->{'dn_set'}->{$ARG} } @ns )
        ? qw| expected |
        : qw| skip |;
    <[nameserv.consistency.evaluate-dn]>->( $state, $q->{'dn'} );

} elsif ( $kind eq qw| zone-ns | ) {
    my $zone = $q->{'name'};
    my @ns   = map { lc $ARG } map {s|\.+$||r} @$values;
    if (@ns) {
        for my $peer ( @{ $state->{'peers'} } ) {
            $state->{'findings'}
                ->{ sprintf 'add %s to the NS set of %s', $peer, $zone }
                = TRUE
                if not grep { $ARG eq $peer } @ns;
        }
        $state->{'ns'}->{$zone}
            = { map { $ARG => { 'a' => undef, 'aaaa' => undef } } @ns };
        $state->{'soa'}->{$zone}
            = { 'pending' => scalar @ns, 'answers' => {} };
        for my $ns (@ns) {
            for my $family (qw| a aaaa |) {
                <[nameserv.consistency.query]>->(
                    $state,
                    {   'kind'   => qw| ns-addr |,
                        'name'   => $ns,
                        'type'   => uc $family,
                        'zone'   => $zone,
                        'ns'     => $ns,
                        'family' => $family
                    }
                );
            }
        }
    }

} elsif ( $kind eq qw| ns-addr | ) {
    my $slot = $state->{'ns'}->{ $q->{'zone'} }->{ $q->{'ns'} }
        // return TRUE;
    $slot->{ $q->{'family'} } = $values;
    return TRUE if grep { not defined $slot->{$ARG} } qw| a aaaa |;

    ## both families answered : pick an address, ask for the soa ##
    my ($addr) = ( @{ $slot->{'a'} // [] }, @{ $slot->{'aaaa'} // [] } );
    if ( not defined $addr ) {
        $state->{'findings'}->{
            sprintf '%s does not answer for %s',
            $q->{'ns'}, $q->{'zone'}
        } = TRUE;
        my $soa_state = $state->{'soa'}->{ $q->{'zone'} } // return TRUE;
        $soa_state->{'pending'}--;
        <[nameserv.consistency.soa-check]>->( $state, $q->{'zone'} );
    } else {
        <[nameserv.consistency.query]>->(
            $state,
            {   'kind'   => qw| zone-soa |,
                'name'   => $q->{'zone'},
                'type'   => qw| SOA |,
                'server' => $addr,
                'zone'   => $q->{'zone'},
                'ns'     => $q->{'ns'}
            }
        );
    }

} elsif ( $kind eq qw| zone-soa | ) {
    my $soa_state = $state->{'soa'}->{ $q->{'zone'} } // return TRUE;
    if ( $timed_out or not @$values ) {
        $state->{'findings'}->{
            sprintf '%s does not answer for %s',
            $q->{'ns'}, $q->{'zone'}
        } = TRUE;
    } else {
        $soa_state->{'answers'}->{ $q->{'ns'} } = $values->[0];
    }
    $soa_state->{'pending'}--;
    <[nameserv.consistency.soa-check]>->( $state, $q->{'zone'} );

} elsif ( $kind eq qw| ptr | ) {
    my %expected = map { $ARG => TRUE } @{ $state->{'ptr_expected'} // [] };
    my @names    = map { lc $ARG } map {s|\.+$||r} @$values;
    my $short    = $state->{'ptr_short_host'} // '';

    ## accepted : a dn name, the host name, or any name whose first label ##
    ## equals the short host name [ 'pri' -> 'pri.v7.ax' ]                ##
    my $known = grep { $expected{$ARG} } @names;
    $known
        ||= grep { length $short and ( split m|[.]|, $ARG, 2 )[0] eq $short }
        @names;
    if ( not $known ) {
        $state->{'findings'}->{
            sprintf 'set ptr %s -> %s [ hoster ]',
            $q->{'addr'},
            $state->{'ptr_expected'}->[0] // ''
        } = TRUE;
    }
}

<[nameserv.consistency.finish]>->($state)
    if not keys %{ $state->{'queries'} };

return TRUE;

