## [:< ##

# name  = base.swap_subs
# descr = moves subroutines from one module namespace into another

my $source_sub_prefix = shift;
my $target_sub_prefix = shift;
my $overwrite_policy  = shift // qw| undefine |;
## policies : < undefine | overwrite | if_missing > ##

my @sub_names     = keys %code;
my $subs_matching = 0;
map {
    $subs_matching++
        if ( $ARG =~ m|^$source_sub_prefix\.|
        or $ARG eq $source_sub_prefix )    ## exact match ##
        and not $data{'code'}{$ARG}{'deferred_stub'}
    ## an unresolved deferred-compile stub is not real reloaded code -- its ##
    ## lone presence must not be read as "there's something to move," or    ##
    ## the undefine step below wipes a fully-populated target namespace to  ##
    ## make room for nothing real. see                                      ##
    ## feedback-v7-reload-init-live-swap-subs-crash                         ##
} @sub_names;
if ( !$subs_matching ) {
    <[base.logs]>->(
        2, '<swap_subs> skipped [ no %s subs present ]',
        $source_sub_prefix
    );
    return FALSE;
}

## per-generation idempotency guard : the destructive 'undefine' wipe is    ##
## meant to fire once per real code reload (a genuinely new compile         ##
## generation), matching the intentional "wipe stale code, load fresh"      ##
## design -- not on every repeat call within the same unchanged generation  ##
## just because a lifecycle hook happened to compile/discover slightly      ##
## later than its siblings (e.g. an un-whitelisted nested hook resolving    ##
## after its whitelisted sibling already swapped everything else this       ##
## generation). without this, a lone late-arriving real sub gets read as    ##
## "there's reloaded code" and the wipe nukes an already-correct target     ##
## namespace to make room for just that one straggler. see                  ##
## feedback-v7-reload-init-live-swap-subs-crash. interim fix pending the    ##
## version-aware loader (data/md/coding-tasks/version-aware-loader.md)      ##
## which eliminates this whole class structurally via a staged %CODE swap   ##
##                                                                          ##
## the generation must be tracked per-namespace, not as a single shared     ##
## counter -- otherwise an unrelated namespace's reload would falsely look  ##
## like "this namespace changed too." walk $source_sub_prefix from most- to ##
## least-specific dot-segment to find the code_name the loader tracks       ##
## generations against [ 'v7.zenka' itself is never a code_name -- only its ##
## ancestor 'v7' is; multi-segment code_names like 'chk-sum.bmw384' match   ##
## at full length instead ]                                                 ##
my $current_generation;
my @prefix_parts = split( m|\.|, $source_sub_prefix );
while (@prefix_parts) {
    my $candidate = join( '.', @prefix_parts );
    if ( exists $data{'base'}{'loader'}{'namespace_generation'}{$candidate} )
    {
        $current_generation
            = $data{'base'}{'loader'}{'namespace_generation'}{$candidate};
        last;
    }
    pop @prefix_parts;
}
$current_generation //= <base.loader.load_seq> // 0;    ##  fallback  ##
my $swap_key = "$source_sub_prefix\->$target_sub_prefix";
my $last_wipe_generation
    = $data{'base'}{'swap_subs'}{'last_wipe_generation'}{$swap_key};
my $already_wiped_this_generation = defined $last_wipe_generation
    && $last_wipe_generation == $current_generation;

if ( $overwrite_policy eq qw| undefine |
    and not $already_wiped_this_generation ) {
    map {
        if ( $ARG =~ m|^$target_sub_prefix\.| ) {
            delete $code{$ARG};
            $data{'code'}{$ARG}{'status'} = qw| undefined |;
        }
    } @sub_names;
    my $removed_count = @sub_names - keys %code;
    <[base.logs]>->(
        2,              "undefined %d subs from '%s' namespace",
        $removed_count, $target_sub_prefix
    ) if $removed_count;
    $data{'base'}{'swap_subs'}{'last_wipe_generation'}{$swap_key}
        = $current_generation;
} elsif ( $overwrite_policy eq qw| undefine | ) {
    <[base.logs]>->(
        2, '<swap_subs> wipe skipped [ already done this generation : %s ]',
        $swap_key
    );
}

my $moved      = 0;
my $logged_yet = 0;
foreach my $sub_name ( keys %code ) {

    ( my $new_sub = $sub_name )
        =~ s|^($source_sub_prefix)\.|$target_sub_prefix.|;

    $new_sub = $target_sub_prefix    ## exact match ##
        if $new_sub eq $sub_name and $new_sub eq $source_sub_prefix;

    if ( $new_sub ne $sub_name ) {
        ## an unresolved stub is not MOVED [ its own filename hint names    ##
        ## the source name, and base.caller resolves the real source path   ##
        ## from that ], but it must still be REACHABLE under the target     ##
        ## name : after a swap every call site uses the target namespace,   ##
        ## so leaving the stub only at the source name turns "compile       ##
        ## deferred to first use" into "never loadable at all" -- the       ##
        ## whitelist governs compile TIMING, never reachability.  aliasing  ##
        ## the stub across restores the on-demand path : the stub fires     ##
        ## under either name, identifies itself as the SOURCE name, and     ##
        ## base.handler.deferred_compile's own moved_to self-heal then      ##
        ## lands the freshly compiled code at both keys.  it stays excluded ##
        ## from $subs_matching above -- an alias is not evidence of real    ##
        ## reloaded code                                                    ##
        if ( $data{'code'}{$sub_name}{'deferred_stub'} ) {
            if ( not exists $code{$new_sub} ) {
                $code{$new_sub}                          = $code{$sub_name};
                $data{'code'}{$new_sub}{'deferred_stub'} = TRUE;
                $data{'code'}{$sub_name}{'moved_to'}     = $new_sub;
            }
            next;
        }

        if ( $overwrite_policy eq 'if_missing' and exists $code{$new_sub} ) {
            delete $code{$sub_name};
            next;
        }
        if ( !$logged_yet ) {
            <[base.logs]>->(
                2,                  ': moving subroutines : %s --> %s',
                $source_sub_prefix, $target_sub_prefix
            );
            ++$logged_yet;
        }
        $code{$new_sub} = delete $code{$sub_name};
        $moved++;
        ## also transfer compilation status ##
        $data{'code'}{$new_sub}{'status'}
            = $data{'code'}{$sub_name}{'status'};
        $data{'code'}{$sub_name}{'status'} = qw| undefined |;

        if ( exists $data{'code'}{$sub_name} ) {
            $data{'code'}{$sub_name}{'moved_to'} = $new_sub;
        }
    }
}

my $sub_list_href = <[base.resolve_key]>->(qw| base.init_modules.sub_list |);

if ( defined $sub_list_href and $sub_list_href->{'r-type'} eq qw| ARRAY | ) {
    my $del_index     = 0;
    my $sub_list_aref = $sub_list_href->{'r-data'};
    foreach my $sub_name ( $sub_list_aref->@* ) {
        next if not defined $sub_name;
        if ( $sub_name =~ m,^$target_sub_prefix(\.|$), ) {
            delete $sub_list_aref->[$del_index];
        } else {
            $sub_name =~ s{^$source_sub_prefix(\.|$)}{$target_sub_prefix$1};
        }
        $del_index++;
    }
}

map {
    <base.cmd>->{$ARG} =~ s,^$source_sub_prefix(\.|$),$target_sub_prefix$1,
    }
    keys <base.cmd>->%*
    if defined <base.cmd>;

map {
    <base.cli>->{$ARG} =~ s,^$source_sub_prefix(\.|$),$target_sub_prefix$1,
    }
    keys <base.cli>->%*
    if defined <base.cli>;

if ( not $moved ) {
    <[base.logs]>->(
        2,                  '<swap_subs> nothing done [ %s --> %s ]',
        $source_sub_prefix, $target_sub_prefix
    );
} else {
    <base.modules.internal_name>->{$target_sub_prefix} = $source_sub_prefix;
    <base.modules.moved_to>->{$source_sub_prefix}      = $target_sub_prefix;
    <[base.logs]>->(
        2,      ': : done [ %d sub%s ]',
        $moved, <[base.cnt_s]>->($moved)
    );
}

<[base.referenced_subroutines.clear_found]>;

##  adjusting names of tracked subroutines [ for error handling ]  ##
if ( <[base.is_defined_recursive]>->(qw| base.subroutines.referenced |) ) {
    foreach my $subname ( keys <base.subroutines.referenced>->%* ) {
        my $matched_href = <base.subroutines.referenced>->{$subname};
        foreach my $line ( keys $matched_href->%* ) {
            foreach my $found_in ( keys $matched_href->{$line}->%* ) {
                my $prev_name = $found_in;
                ## move to new name ##
                $matched_href->{$line}->{$found_in}
                    = delete $matched_href->{$line}->{$prev_name}
                    if $found_in   ## adjusting names of parent subroutines ##
                    =~ s|^($source_sub_prefix)\.|$target_sub_prefix.|
                    and $found_in ne $prev_name;
            }
        }
    }
}

