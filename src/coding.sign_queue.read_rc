## [:< ##

# name   = coding.sign_queue.read_rc
# descr  = exit code of a detached run [ undef : still running ]
# args   = rc file path

my $path = shift // '';
CORE::open( my $fh, '<:encoding(UTF-8)', $path ) or return undef;
my $line = <$fh> // '';
CORE::close($fh);
return $line =~ m{\Arc = (\d+)} ? $1 + 0 : undef;

