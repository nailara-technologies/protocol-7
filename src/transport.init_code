## [:< ##

# name  = transport.init_code
# descr = load transport profiles, initialize quality state and probe timer

## own transport registry [ borrowed key name, but per-zenka isolation   ##
## means this is transport's private hash — seed it directly rather than ##
## depending on the [ unrelated, orbital-specific ] external zenka       ##
<transport.registry> //= {};

## profile cache ##
<transport.registry>->{'profiles'} //= {};

## quality state per exit, transport type and destination ##
<transport.registry>->{'quality'} //= {};

## demoted transports: { destination => { exit => { type => time } } } ##
<transport.registry>->{'demoted'} //= {};

## active transport handles per destination and exit ##
<transport.registry>->{'active'} //= {};

## profile directory ##
<transport.cfg.profile_dir> = 'data/yaml/transport/profiles'
    unless defined <transport.cfg.profile_dir>;

## start global probe timer [ re-armed by transport.probe.timer ] ##
<transport.probe_interval_state> //= {};
my $probe_timer = <[event.add_timer]>->(
    {   'after' => <[base.interval.next]>->(
            {   'type'  => qw| transport-probe |,
                'state' => <transport.probe_interval_state>,
            }
        ),
        'handler' => qw| transport.probe.timer |,
    }
);

<transport.probe_timer> = $probe_timer;

## subscribe to credential rotation events -- cred-mesh is a separate zenka ##
## process with its own %data tree, so this must be a real cross-zenka      ##
## route, not a local <[...]> call (a local call here would register the    ##
## subscription into transport's OWN data tree instead of the real          ##
## cred-mesh zenka's, and cred-mesh.rotate's push would never reach it).    ##
## deferred via a short one-shot timer -- transport's own cube session      ##
## isn't established yet this early in init_code, so a synchronous          ##
## route-send here silently finds no matching session                       ##
<transport.init_interval_state> //= {};
<[event.add_timer]>->(
    {   'after' => <[base.interval.next]>->(
            {   'type'  => qw| transport-init |,
                'state' => <transport.init_interval_state>,
            }
        ),
        'handler' => qw| transport.handler.subscribe_rotation_deferred |,
    }
);

<[base.logs]>->( 2, 'transport.init_code: transport selector initialized' );

return TRUE;

