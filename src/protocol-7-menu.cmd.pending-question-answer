# name  = protocol-7-menu.cmd.pending-question-answer
# param = <question_id> | { id, answer }
# descr = Mark a pending question answered, refresh indicator

my $args = $call->{'args'} // '';

my $input = eval { JSON::decode_json($args) } // $args;
my ( $question_id, $answer );

if ( ref $input eq qw| HASH | ) {
    $question_id = $input->{'id'}     // '';
    $answer      = $input->{'answer'} // '';
} else {
    $question_id = $input;
    $answer      = '';
}

return { 'mode' => qw| false |, 'data' => 'question id required' }
    unless defined $question_id and length $question_id;

my $questions = <protocol-7-menu.pending-questions> // [];
my $removed   = 0;

@$questions = grep {
    my $keep = ( $_->{'id'} // '' ) ne $question_id;
    $removed++ unless $keep;
    $keep;
} @$questions;

<[protocol-7-menu.pending-indicator-update]>;

if ($removed) {
    <[base.logs]>->( 1, "pending question answered : id=%s", $question_id );
    return { 'mode' => qw| true |, 'data' => $question_id };
} else {
    return {
        'mode' => qw| false |,
        'data' => sprintf( "question id not found: %s", $question_id )
    };
}

