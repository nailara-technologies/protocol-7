## [:< ##

# name  = thermal.window.weight
# descr = select the worker weight for a schedule window

my ( $window, $tariff_active ) = @ARG;

return <thermal.cfg.night.weight> // 1.0
    if $tariff_active
    or defined $window and $window eq qw| night |;

return <thermal.cfg.day.weight> // 0.25;

