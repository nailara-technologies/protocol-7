## [:< ##

# name  = base.cmd.show-buffer
# descr = return buffer content ['list buffers']
# param = <name> [lines] [pattern]

my $param = $_[0];
my $id    = $$param{'session_id'};
my $args  = $$param{'args'};

return { 'mode' => qw| false |, 'data' => 'buffer name required' }
    if not defined $args or not length $args;

## <name> is the leading token ; anything after it is [lines] and/or       ##
## [pattern] -- a numeric leading token of up to 5 digits is taken as      ##
## [lines] [tail count], since no real buffer runs past ~99999 lines ; a   ##
## longer digit run is more likely a pattern [ pid, hash, timestamp ] than ##
## a line count, so it falls through to [pattern]                          ##
my ( $buffer, $rest ) = split( m|\s+|, $args, 2 );
$rest //= '';

my ( $lines, $pattern );
if ( $rest =~ m|^(\d{1,5})(?:\s+(.*))?$|s ) {
    $lines   = $1;
    $pattern = $2;
} elsif ( length $rest ) {
    $pattern = $rest;
}

## NOT `not defined $data{'buffer'}{$buffer}` -- a plain read through a
## multi-level hash chain autovivifies the intermediate level, so even a
## buffer name that never existed becomes a defined (empty) hashref just
## from this check running, always passing it; the real crash then hit
## dereferencing the still-missing 'data' key as an array two lines down.
## Also: 'data' is genuinely absent on a real, freshly-registered buffer
## until its first line is written (base.buffer.add_line populates it
## lazily) -- checking its ref type directly covers both cases at once.
my $buf_entry = $data{'buffer'}{$buffer};
return { 'mode' => qw| false |, 'data' => 'no such buffer' }
    if ref $buf_entry ne qw| HASH |
    or ref $buf_entry->{'data'} ne qw| ARRAY |;

my @buf_lines = @{ $buf_entry->{'data'} };

## tail [lines] first, then filter within that window ##
if ( defined $lines and $lines < @buf_lines ) {
    @buf_lines = @buf_lines[ -$lines .. -1 ];
}

if ( defined $pattern and length $pattern ) {
    my ( $regex_filter, $regex_err ) = <[base.eval.comp_regex]>->($pattern);

    return {
        'mode' => qw| false |,
        'data' => sprintf( 'invalid pattern [ %s ]', $regex_err->$* )
        }
        if not defined $regex_filter;

    @buf_lines = grep { $ARG =~ $regex_filter } @buf_lines;
}

return {
    'mode' => qw| size |,
    'data' => join( '', map {"$ARG\n"} @buf_lines )
};

