## [:< ##

# name  = graphics-matrix.cell.util.cell_output
# descr = format a lattice cell for display

my $cell = shift;
my $pos  = $cell->{'position'};
my $out;
if ( $cell->{'empty'} ) {
    $out = sprintf "cell [%d,%d,%d] empty\n",
        $pos->{'selX'}, $pos->{'selY'}, $pos->{'selZ'};
} else {
    $out = sprintf "cell [%d,%d,%d] refs=%d chk=%s\n",
        $pos->{'selX'}, $pos->{'selY'}, $pos->{'selZ'},
        $cell->{'refs'}, $cell->{'checksum'};
    $out .= sprintf "  elements: %d\n", scalar( @{ $cell->{'elements'} } );
    $out .= sprintf "  created: %s\n",
        scalar( localtime( $cell->{'created'} ) );
    $out .= sprintf "  modified: %s\n",
        scalar( localtime( $cell->{'modified'} ) );
}
return { qw| mode | => qw| size |, qw| data | => $out };

