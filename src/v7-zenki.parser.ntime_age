## [:< ##

# name  = v7-zenki.parser.ntime_age
# descr = duration since an ntime stamp [ list filter ]

my $ntime = shift;

return qw| - | if not defined $ntime;
return <[base.parser.duration]>->( $ntime, 0, qw| ntime | );

