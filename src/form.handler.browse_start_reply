## [:< ##

# name  = form.handler.browse_start_reply
# descr = open the namespace menu once the record count is known

## the namespace menu shows a record COUNT, which only the users zenka can
## answer -- so browse asks first and the menu opens here.  raw terminal mode
## and the watchers go up BEFORE the first paint, exactly as
## form.handler.value_get_reply does for the form, so the screen clear lands
## on an already-raw terminal and no keystroke is echoed or lost.

my ($info) = @ARG;

my $cmd = uc( $info->{'cmd'} // '' );

my $listing = $cmd eq qw| SIZE | ? $info->{'data'} // '' : '';

## a failed listing is not fatal here : the namespace menu still opens, the
## host-system count just reads zero and the store answers for itself when it
## is entered
<[base.logs]>->( 1, ': record listing unavailable [ %s ]', lc($cmd) )
    if $cmd ne qw| SIZE |;

my $record_count = scalar grep { length $ARG } split m|\n|, $listing;

if ( not <[form.term_init]> ) {
    print "\n  << could not put the terminal into raw mode >>\n\n";
    <[base.exit]>;
    return FALSE;
}

if ( not <[form.setup_stdin_watcher]> ) {
    <[form.term_restore]>;
    print "\n  << could not register the form watchers >>\n\n";
    <[base.exit]>;
    return FALSE;
}

return <[form.menu.open_rows]>->(
    <[form.menu.namespaces]>->($record_count),
    qw| namespace |, undef
);

