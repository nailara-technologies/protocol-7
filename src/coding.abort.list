## [:< ##

# name  = coding.abort.list
# descr = enumerate registered abort-pattern checksum ids

my $zenka_dir_href = <system.path.zenka-dirs> // {};
my $zenka_name     = <system.zenka.name>      // 'coding';
my $store_dir
    = catdir( $zenka_dir_href->{'var_P7'}, $zenka_name, 'abort-patterns' );

my @ids;
if ( opendir my $dh, $store_dir ) {
    @ids = sort grep { !/^\./ && -f catfile( $store_dir, $_ ) } readdir $dh;
    closedir $dh;
}

return \@ids;

