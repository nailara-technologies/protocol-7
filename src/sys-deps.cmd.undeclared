## [:< ##

# name = sys-deps.cmd.undeclared
# descr = tracked packages not yet declared in deps/os cfgs

## entries whose package is not declared in any zenka's deps/os/<dir>/ ##
## [ shared AMOS7::deps::tracked implementation, type-aware ]          ##
my @undeclared = @{ AMOS7::deps::tracked::undeclared(<system.root_path>) };

my @output;
push @output, ":", "::[ undeclared packages ]", ":";

unless (@undeclared) {
    push @output, ":  all tracked packages are declared";
    push @output, ":";
    return {
        'mode' => qw| size |,
        'data' => "\n" . join( "\n", @output ) . "\n"
    };
}

push @output, ":  " . scalar(@undeclared) . " tracked but not declared:";
for my $entry (@undeclared) {
    push @output,
        sprintf(
        ":    %-40s %s  %s",
        $entry->{'pkg'}, $entry->{'installed_at'},
        $entry->{'source'}
        );
}
push @output, ":";

return {
    'mode' => qw| size |,
    'data' => "\n" . join( "\n", @output ) . "\n"
};

