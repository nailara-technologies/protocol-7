## [:< ##

# name = sys-deps.cmd.undeclared
# descr = tracked packages not yet declared in deps/os cfgs

my $os_deps = <sys-deps.os_deps>;
my $tracked = <sys-deps.tracked> // [];

my %declared;
for my $type ( keys %$os_deps ) {
    for my $pkg ( keys %{ $os_deps->{$type} } ) {
        $declared{$pkg} = 1;
    }
}

my @undeclared;
for my $entry (@$tracked) {
    next if $entry->{'declared'};
    next if $declared{ $entry->{'pkg'} };
    push @undeclared, $entry;
}

my @output;
push @output, ":", "::[ undeclared packages ]", ":";

unless (@undeclared) {
    push @output, ":  all tracked packages are declared";
    push @output, ":";
    return {
        'mode' => qw| size |,
        'data' => "\n" . join( "\n", @output ) . "\n"
    };
}

push @output, ":  " . scalar(@undeclared) . " tracked but not declared:";
for my $entry (@undeclared) {
    push @output,
        sprintf(
        ":    %-40s %s  %s",
        $entry->{'pkg'}, $entry->{'installed_at'},
        $entry->{'source'}
        );
}
push @output, ":";

return {
    'mode' => qw| size |,
    'data' => "\n" . join( "\n", @output ) . "\n"
};

