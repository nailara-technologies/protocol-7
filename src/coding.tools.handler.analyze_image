## [:< ##

# name  = coding.tools.handler.analyze_image
# descr = text description of an image by a vision-capable child task
# param = { path => ..., prompt => ..., switch => bool }

my $args   = shift             // {};
my $path   = $args->{'path'}   // '';
my $prompt = $args->{'prompt'} // '';

return 'error: path required' unless length $path;
$prompt
    = 'describe this image in detail : content, '
    . 'layout, colors, any visible text verbatim'
    unless length $prompt =~ s|^\s+||r;

## the executing task [ set by coding.async.tool_executor around dispatch ] ##
my $task_id = <coding.catalog.active_task> // '';
my $task    = length $task_id ? <coding.task.queue>->{$task_id} : undef;
return 'error: analyze_image needs a running coding task'
    unless defined $task;

## validate early : a bad path is answered now, not after a child round ##
my $image = <[coding.image.load_for_vision]>->( { 'path' => $path } );
return "error: $image->{'error'}" if defined $image->{'error'};

## child backend : the parent's own when it is vision-capable, else the ##
## other server when that one is [ a text model on one backend gets a   ##
## description from a vision model on the other ]                       ##
my $state  = <coding.async.task_state>->{$task_id} // {};
my $routed = $state->{'backend'} // $task->{'analysis'}->{'routed_to'}
    // qw| gpu |;
my $other = $routed eq qw| cpu | ? qw| single-llm | : qw| cpu |;

my $child_backend
    = <[coding.image.backend_has_vision]>->($routed) ? $routed
    : <[coding.image.backend_has_vision]>->($other)  ? $other
    :                                                  '';

## :switch: no vision anywhere : load a vision model on the gpu for the ##
## analysis, then switch back to the current model [ parent parked ]    ##
if ( !length $child_backend and <[base.cfg_bool]>->( $args->{'switch'} ) ) {
    my $prior = uc( <inference.model.amos_id> // '' );
    return 'error: cannot switch : the current gpu model '
        . 'id is unknown, so it could not be switched back'
        if $prior !~ m|^[A-Z2-7]{7}:[A-Z2-7]{7}$|;

    my $vision = <[coding.helper.find_vision_model]>;
    return 'error: cannot switch : no vision-capable model in the registry'
        unless defined $vision;

    ## park the parent like subtask_spawn does : it waits in the subtask ##
    ## state behind a placeholder, its backend lock released             ##
    my $switch_id = <[coding.helper.model_switch_start]>->(
        {   'target'        => $vision,
            'exclude_tasks' => <[coding.helper.task_chain]>->($task_id),
            'callback'      => qw| coding.handler.analyze_image_switched |,
            'callback_data' => {
                'parent_id' => $task_id,
                'path'      => $path,
                'abs_path'  => $image->{'path'},
                'prompt'    => $prompt,
                'prior'     => $prior,
                'routed'    => $routed,
            },
        }
    );
    $state->{'pending_subtask'} = "model-switch:$switch_id";
    <[coding.async.backend_release]>->(
        $task_id, $routed, <[coding.async.lock_token]>->( $task_id, $routed )
    );

    <[base.logs]>->(
        1, 'analyze_image: [%s] %s : switching %s -> %s',
        $task_id, $path, $prior, $vision
    );

    return
          sprintf "no vision-capable model loaded : switching to %s for the "
        . "analysis of %s, then back to %s [ this takes a "
        . "while, the context is re-processed afterwards ] : "
        . "the description follows as the next user message, "
        . "labelled IMAGE ANALYSIS",
        $vision, $path, $prior;
}

unless ( length $child_backend ) {
    return
          sprintf "error: no vision-capable model is loaded on any backend "
        . "-- cannot analyze %s [ coding.vision-model shows "
        . "the loaded model ] -- call again with switch=true "
        . "to load a vision model for the analysis and switch "
        . "back afterwards", $path;
}

my $spawned = <[coding.tools.handler.subtask_spawn]>->(
    {   'parent_task_id' => $task_id,
        'description'    => "$prompt\n\n:image-embed:$image->{'path'}",
        'system'         => 'you analyze the attached image for another '
            . 'model that cannot see it. answer the '
            . 'request precisely and only from what is '
            . 'visible ; say so when something cannot be '
            . 'determined from the image.',
        'no_tools'      => TRUE,
        'max_rounds'    => 1,
        'route_backend' => $child_backend,
        'result_label'  => "IMAGE ANALYSIS: $path",
    }
);

if ( ref $spawned ne qw| HASH | or not $spawned->{'child_task_id'} ) {
    return sprintf "error: analyze_image could not spawn the analysis : %s",
        ( ref $spawned eq qw| HASH | ? $spawned->{'content'} : 'unknown' );
}

<[base.logs]>->(
    1, 'analyze_image: [%s] %s -> child %s on %s',
    $task_id, $path, $spawned->{'child_task_id'},
    $child_backend
);

return
    sprintf "image analysis of %s started [ %s ] : the description follows "
    . "as the next user message, labelled IMAGE ANALYSIS",
    $path, $spawned->{'child_task_id'};

