## [:< ##

# name  = context.template.load
# descr = load named context template from yaml

my $name = shift // return undef;

## resolve template file ##
my $root         = <system.root_path>;
my $template_dir = "$root/" . <context.cfg.template_dir>;
my $path         = "$template_dir/$name.yaml";

unless ( -f $path and -r $path ) {
    <[base.logs]>->( 0, ': context template not found [ %s ]', $path );
    return undef;
}

## check cache first -- invalidated on mtime change, not just presence :    ##
## editing a template file previously had no effect until this zenka's data ##
## structures were cleared entirely [ found live 2026-09-09, editing        ##
## system-base.yaml / system-tools.yaml kept rendering the old content      ##
## through both reload config and reload source, since neither clears       ##
## arbitrary %data cache keys like this one ] -- same mtime-keyed           ##
## invalidation as coding.tools.handler.embedding_search's vec_cache        ##
## bin/Protocol-7 does 'use File::stat' globally : shadows the builtin --   ##
## use the OO form like the rest of P7 does, bare stat/list-slice always    ##
## silently returns undef here [ found live 2026-09-09 chasing why the      ##
## mtime check above never invalidated -- cached mtime was frozen at 0 ]    ##
my $st     = File::stat::stat($path);
my $mtime  = $st ? $st->mtime : 0;
my $cached = <context.templates>->{$name};
if ( defined $cached and ( $cached->{'mtime'} // -1 ) == $mtime ) {
    return $cached->{'template'};
}

## load yaml ##
my ( $template, $err ) = <[format.yaml.load_file]>->($path);

if ( defined $err or not defined $template ) {
    <[base.logs]>->(
        0,     ': context template parse error [ %s ]: %s',
        $name, $err // 'empty'
    );
    return undef;
}

## validate required fields ##
unless (defined $template->{'name'}
    and defined $template->{'sections'}
    and ref $template->{'sections'} eq qw| ARRAY | ) {
    <[base.logs]>->(
        0, ': context template invalid [ %s ]: missing name or sections',
        $name
    );
    return undef;
}

## set defaults ##
$template->{'budget'} //= <context.cfg.default_budget>;

## cache for reuse, keyed with the mtime this load actually saw ##
<context.templates>->{$name} = { 'mtime' => $mtime, 'template' => $template };

<[base.logs]>->(
    2,     ': context template loaded [ %s ] [ %d sections ]',
    $name, scalar $template->{'sections'}->@*
);

return $template;

