## [:< ##

# name  = editor.control.multiline.summary
# descr = the ':..3.lines..:' text a collapsed multiline field draws
# param = $text [ , $noun , $noun_plural , $noun_singular ]

## exact counterpart to editor.control.list.summary's ':..2.entries..:' --
## same wrap, same dot-joined count+noun shape, same reason it is factored out
## rather than inlined : editor.ui.ascii_frame.render_form is the only caller,
## and a second implementation of the same sentence would drift.  unlike
## list.summary this takes the raw TEXT, not a field def -- a multiline
## field's line count is a property of its buffer alone, nothing else on the
## def matters to it.
##
## the noun defaults to 'line'/'lines' [ base.cnt_s's own default suffixes,
## passed explicitly here so overriding them later is a one-line change, not a
## new call shape ] -- true for every genuine free-text multiline field [
## note, address ].  optional override exists for a field that is only
## IMPLEMENTATION-multiline [ user-edit.form.schema_from_record's user_keys,
## one key name per line to route around display_override's multiline gap, see
## that field's own header ] but conceptually a list of discrete entries --
## same noun/noun_plural/noun_singular shape list.summary's own field-def keys
## already use, so a caller with a field_def in hand can pass its
## 'noun'/'noun_plural'/'noun_singular' straight through unchanged

my ( $text, $noun, $noun_plural, $noun_singular ) = @ARG;
$noun          //= qw| line |;
$noun_plural   //= qw| s |;
$noun_singular //= '';

my $lines = <[editor.control.multiline.lines]>->( $text // '' );
my $count = scalar $lines->@*;

## editor.control.multiline.lines never returns an empty arrayref -- an empty
## buffer still yields ONE blank line [ its own no-reaping rule, split's -1
## limit ] -- so a genuinely empty field would otherwise show '1.line' instead
## of the 'no.lines' its list counterpart shows for zero entries
$count = 0 if $count == 1 and not length( $lines->[0] // '' );

my $summary
    = $count
    ? sprintf( '%d.%s%s',
    $count, $noun, <[base.cnt_s]>->( $count, $noun_plural, $noun_singular ) )
    : sprintf( 'no.%s%s', $noun, $noun_plural );

return sprintf( ':..%s..:', $summary );

