## [:< ##

# name   = base.parser.time_left
# descr  = list filter : time left until a unix time, as base.parser.duration
# args   = number <unix time> [, precision ]
# return = duration string or 'passed' \ 'n/a'

## base.parser.duration counts since a time : mirrored around now it counts ##
## the time left                                                            ##

my $time      = shift;
my $precision = shift // 2;
return qw| n/a | if not defined $time or $time !~ m|\A\d+(\.\d+)?\z|;

my $now = <[base.time]>->(5);
return qw| passed | if $time < $now;
return <[base.parser.duration]>->( 2 * $now - $time, $precision, qw| unix | );

