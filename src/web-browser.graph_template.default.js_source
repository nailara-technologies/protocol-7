## [:< ##

# name  = web-browser.graph_template.default.js_source
# descr = default dark line-chart renderer for graph-params overlay

return <<'JS_SRC';
(function () {
    var data = window.__p7GraphData;
    if (!data) return;
    var names = data.names;
    var samples = data.samples;

    var canvas = document.getElementById('__p7GraphCanvas');
    if (!canvas) {
        canvas = document.createElement('canvas');
        canvas.id = '__p7GraphCanvas';
        canvas.style.position = 'fixed';
        canvas.style.top = '10px';
        canvas.style.right = '10px';
        canvas.style.width = '320px';
        canvas.style.height = '180px';
        canvas.style.zIndex = '999999';
        // deep translucent blue, matching window.place.handler.draw's fill/border
        canvas.style.background = 'rgba(0, 0, 61, 0.47)';
        canvas.style.border = '1px solid rgba(6, 71, 195, 0.47)';
        document.body.appendChild(canvas);
    }
    canvas.width = 320;
    canvas.height = 180;
    var ctx = canvas.getContext('2d');

    // golden-angle hue spacing: consecutive series land maximally apart
    // on the wheel no matter how many are added [ harmonic distribution,
    // same idea as the project's node-glow palette, just hue-swept ]
    var GOLDEN_ANGLE = 137.508;
    function seriesHue(i) {
        return ( i * GOLDEN_ANGLE ) % 360;
    }
    function seriesColor(i, light) {
        return 'hsl(' + seriesHue(i) + ', 90%, ' + ( light || 60 ) + '%)';
    }

    window.__p7GraphRenderer = function () {
        var w = canvas.width;
        var h = canvas.height;
        var t = Date.now() * 0.001;

        // deep translucent blue base, matching window.place.handler.draw
        ctx.fillStyle = 'rgba(0, 0, 61, 0.47)';
        ctx.fillRect(0, 0, w, h);

        // slow-drifting corner glow wash : psychedelic without hurting readability
        var bgHue = ( t * 12 ) % 360;
        var bgGlow = ctx.createRadialGradient(
            w, 0, 0, w, 0, w * 0.9
        );
        bgGlow.addColorStop(0, 'hsla(' + bgHue + ', 90%, 55%, 0.16)');
        bgGlow.addColorStop(1, 'hsla(' + bgHue + ', 90%, 55%, 0)');
        ctx.fillStyle = bgGlow;
        ctx.fillRect(0, 0, w, h);

        // window-place accent blue wash, anchored opposite corner from the hue drift
        var accentGlow = ctx.createRadialGradient(
            0, h, 0, 0, h, w * 0.8
        );
        accentGlow.addColorStop(0, 'rgba(6, 71, 195, 0.30)');
        accentGlow.addColorStop(1, 'rgba(6, 71, 195, 0)');
        ctx.fillStyle = accentGlow;
        ctx.fillRect(0, 0, w, h);

        var allValues = [];
        for (var i = 0; i < names.length; i++) {
            var series = samples[names[i]];
            for (var j = 0; j < series.length; j++) {
                allValues.push(series[j].v);
            }
        }
        if (allValues.length === 0) return;

        var minV = allValues[0];
        var maxV = allValues[0];
        for (var k = 1; k < allValues.length; k++) {
            if (allValues[k] < minV) minV = allValues[k];
            if (allValues[k] > maxV) maxV = allValues[k];
        }
        if (minV === maxV) {
            minV -= 1;
            maxV += 1;
        }
        var range = maxV - minV;

        ctx.strokeStyle = 'rgba(100, 160, 255, 0.22)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        for (var gy = 0; gy <= h; gy += 30) {
            ctx.moveTo(0, gy);
            ctx.lineTo(w, gy);
        }
        ctx.stroke();

        for (var si = 0; si < names.length; si++) {
            var name = names[si];
            var series = samples[name];
            if (series.length < 2) continue;
            var color = seriesColor(si);
            ctx.strokeStyle = color;
            ctx.shadowColor = color;
            ctx.shadowBlur = 8;
            ctx.lineWidth = 2;
            ctx.beginPath();
            for (var pi = 0; pi < series.length; pi++) {
                var x = (pi / (series.length - 1)) * w;
                var y = h - ((series[pi].v - minV) / range) * h;
                if (pi === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.stroke();
        }
        ctx.shadowBlur = 0;

        for (var li = 0; li < names.length; li++) {
            var swatch = seriesColor(li);
            ctx.shadowColor = swatch;
            ctx.shadowBlur = 6;
            ctx.fillStyle = swatch;
            ctx.fillRect(6, 6 + li * 12, 8, 8);
            ctx.shadowBlur = 0;
            ctx.font = '10px sans-serif';
            ctx.strokeStyle = 'rgba(0, 0, 20, 0.85)';
            ctx.lineWidth = 3;
            ctx.strokeText(names[li], 18, 14 + li * 12);
            ctx.fillStyle = 'rgba(180, 210, 255, 0.9)';
            ctx.fillText(names[li], 18, 14 + li * 12);
        }
    };
})();
JS_SRC

