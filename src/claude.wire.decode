## [:< ##

# name   = claude.wire.decode
# descr  = one stream-json output line to a hash
# args   = line [ utf-8 octets ]
# return = hash ref, or undef for a line that is not one

my $line = shift // '';
return undef if $line !~ m|\A\s*\{|;
state $json;
if ( not defined $json ) {
    require JSON::XS;
    $json = JSON::XS->new->utf8;
}
my $d = eval { $json->decode($line) };
return ref $d eq qw| HASH | ? $d : undef;

