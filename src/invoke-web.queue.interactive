## [:< ##

# name   = invoke-web.queue.interactive
# descr  = switch the interactive queue mode on \ off [ timer + baseline ]
# param  = TRUE | FALSE
# note   = on : only items added AFTER switching on move to the front

my $enable = shift // FALSE;

my $timer = delete <invoke-web.timer.queue_watch>;
$timer->cancel if defined $timer and $timer->is_active;

if ( not $enable ) {
    <invoke-web.queue_interactive> = FALSE;
    return FALSE;
}

## baseline : everything queued so far keeps its order ##
my $dbh = <[invoke-web.queue.db]> // return FALSE;
my ($max_id) = $dbh->selectrow_array('SELECT MAX(item_id) FROM session_queue');

<invoke-web.queue.last_seen>   = $max_id // 0;
<invoke-web.queue_interactive> = TRUE;

## no polling : checks run on database writes [ inotify ->
## invoke-web.queue.watch_trigger, debounced ] ; drain_check's minute
## timer is the fallback. arm the db watch in case ready has not
## armed it yet [ it is a no-op when already armed ]
<[invoke-web.activity.watch_db]>;

return TRUE;

