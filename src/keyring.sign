## [:< ##

# name  = keyring.sign
# descr = sign a datum with the key at a given namespace path.
#         returns 32-byte keyed BLAKE2b signature.

my ( $dot_path, $datum ) = @ARG;

my $key = <[keyring.derive]>->($dot_path);

if ( not defined $key ) {
    <[base.logs]>->(
        0, 'keyring.sign: key ' . 'derivation failed [ %s ]', $dot_path
    );
    return undef;
}

return Crypt::Mac::BLAKE2b::blake2b( 32, $key, $datum // '' );

