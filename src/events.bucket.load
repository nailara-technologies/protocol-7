## [:< ##

# name  = events.bucket.load
# descr = read one bucket file into memory
# args   = owner zenka
# return = the bucket hash ref, undef when there is no file
# see events.bucket.save for the format ; a line that does not parse is
# logged and skipped, the others load. the entry order is the file order ;
# at, added and done accept old unix values and new numerical ntime

my $owner = shift;
my $path  = <[events.bucket.path]>->($owner);
return undef if !-f $path;
my $bucket = { 'owner' => $owner, 'entries' => {}, 'order' => [] };
if ( open my $fh, '<:encoding(UTF-8)', $path ) {
    while ( my $line = <$fh> ) {
        chomp $line;
        next if $line =~ m{\A\s*(?:\#|\.:|\z)};
        if ( $line
            !~ m{\Aentry\.([A-Za-z0-9][\w-]*)\.(\w+)(?:\.(\S+?))? = (.*)\z} )
        {
            <[base.logs]>->(
                0,      "<< bucket '%s' : line not understood : %s >>",
                $owner, $line
            );
            next;
        }
        my ( $id, $key, $sub, $value ) = ( $1, $2, $3, $4 );
        $value =~ s{\\(.)}{$1 eq 'n' ? "\n" : $1}ge;
        my $e = $bucket->{'entries'}{$id} //= do {
            push @{ $bucket->{'order'} }, $id;
            { 'id' => $id, 'depends' => [], 'match' => {}, 'action' => {} };
        };
        if ( $key eq qw| depends | ) {
            $e->{'depends'} = [ grep {length} split m{,}, $value ];
        } elsif ( $key eq qw| action | ) {
            $e->{'action'}{'type'} = $value;
        } elsif ( $key eq qw| param | and defined $sub ) {
            $e->{'action'}{$sub} = $value;
        } elsif ( $key eq qw| match | and defined $sub ) {
            $e->{'match'}{$sub} = $value;
        } else {
            $value = <[base.n2u_time]>->($value)
                if $key =~ m{\A(?:at|added|done)\z}
                and $value =~ m{\A\d+(?:\.\d+)?\z}
                and $value > 10_000_000_000;
            $e->{$key} = $value;
        }
    }
    close $fh;
}
<events.buckets>->{$owner} = $bucket;
return $bucket;

