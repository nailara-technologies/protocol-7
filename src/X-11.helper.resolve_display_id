# name  = X-11.helper.resolve_display_id
# descr = resolve a plain display number OR an x-<vax-int>
#          reference label to the plain display number

my $input = shift // '';

return undef if not length $input;

if ( $input =~ m|^x-([A-Z2-7]+)$| ) {
    my $decoded = <[base.vax-int.decode]>->($1);
    return undef if $decoded !~ m|^\d+$|;
    return $decoded;
}

return $input if $input =~ m|^\d+$|;

return undef;

