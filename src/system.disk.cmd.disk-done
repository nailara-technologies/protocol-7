## [:< ##

# name  = system.disk.cmd.disk-done
# param = <job-name>
# descr = remove a completed writer from disk accounting

my $name = shift @ARG // '';
my $job  = <system.disk.jobs>->{$name};
return { qw| mode | => qw| false |, qw| data | => "unknown job : $name\n" }
    if not defined $job;
delete <system.disk.jobs>->{$name};
return {
    qw| mode | => qw| true |,
    qw| data | => sprintf(
        "done %s mount=%s expected=%d written=%d\n",
        $name, $job->{'mount'}, $job->{'expected'}, $job->{'written'}
    )
};

