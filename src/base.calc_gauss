## [:< ##

# name  = base.calc_gauss
# descr = gaussian probability density function

my $x = shift;
my $m = 0;
my $s = 1;

return exp( -0.5 * ( ( $x - $m ) / $s )**2 ) / sqrt( τ * $s**2 );

