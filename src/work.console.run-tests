## [:< ##

# name  = work.console.run-tests
# param = <pattern>
# descr = run bin/dev test scripts matching pattern

my $pattern = shift;

unless ( defined $pattern && length $pattern ) {
    say '';
    say ' : usage: work run-tests <pattern>';
    say ' : example: work run-tests oscillation';
    say ' : example: work run-tests test-httpd';
    say '';
    return TRUE;
}

$pattern =~ s,^ *| *$,,;

say '';
say ' .:[ WORKFLOW: RUN TEST SCRIPTS ]:.';
say '';
say sprintf ' : Pattern: %s', $pattern;
say '';

# Find matching test scripts
my @test_scripts = glob("bin/dev/*${pattern}*");

unless (@test_scripts) {
    say sprintf ' : ✗ No test scripts found matching: %s', $pattern;
    say '';
    return TRUE;
}

say sprintf ' : Found %d test script(s)', scalar(@test_scripts);
say '';

my $failed = 0;
foreach my $script (@test_scripts) {
    next unless -f $script && -x $script;

    say sprintf ' .:[ RUNNING: %s ]:.', $script;
    say '';

    system($script);
    my $exit_code = $? >> 8;

    if ( $exit_code != 0 ) {
        $failed++;
        say '';
        say sprintf ' : ✗ Failed (exit code: %d)', $exit_code;
    }
    say '';
}

say ' .:[ TEST RUN COMPLETE ]:.';
say '';
if ( $failed == 0 ) {
    say sprintf ' : ✓ All %d test(s) passed', scalar(@test_scripts);
} else {
    say sprintf ' : ✗ %d of %d test(s) failed', $failed,
        scalar(@test_scripts);
}
say '';

return $failed > 0 ? 1 : 0;

