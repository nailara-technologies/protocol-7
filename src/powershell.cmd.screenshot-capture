# name  = powershell.cmd.screenshot-capture
# descr = capture the windows host screen + return path

my $win_path = <[powershell.plugin.screenshot-capture.invoke]>;
return { 'mode' => qw| false |, 'data' => 'capture failed' }
    if not defined $win_path;

my $wsl_path = <[powershell.plugin.screenshot-capture.parse]>->($win_path);
return { 'mode' => qw| false |, 'data' => 'capture result invalid' }
    if not defined $wsl_path;

return { 'mode' => qw| true |, 'data' => $wsl_path };

