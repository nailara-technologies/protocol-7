## [:< ##

# name  = stream_child.handler.timer
# descr = timer : the next stop step while the child is there

my $data   = shift->w->data    // {};
my $handle = $data->{'handle'} // return;
return if ( $data->{'serial'} // -1 ) != $handle->{'serial'};
delete $handle->{'timer'};

if ( not <[stream_child.alive]>->($handle) ) {
    ## ended without its stdout end seen yet ##
    <[stream_child.gone]>->( $handle, qw| ended | ) if not $handle->{'gone'};
    return;
}
<[stream_child.step]>->($handle);

