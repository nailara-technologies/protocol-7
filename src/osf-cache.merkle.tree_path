## [:< ##

# name  = osf-cache.merkle.tree_path
# descr = the content-addressed tree file path of a bmw384
# param = { bmw384 }
#
# ONE place that knows where trees live : '<dirname of
# osf-cache.cfg.state_path>/merkle/<bmw384>.yaml' [ content-addressed
# : the same file has the same tree on every instance, so main and
# peer may share the dir ]. returns '' without a bmw384 or a state
# path.

my $args   = shift             // {};
my $bmw384 = $args->{'bmw384'} // '';

return '' unless length $bmw384;

my $state_path = <osf-cache.cfg.state_path> // '';
return '' unless length $state_path;

( my $dir = $state_path ) =~ s{/[^/]+$}{};

return sprintf '%s/merkle/%s.yaml', $dir, $bmw384;

