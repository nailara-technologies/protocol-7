## [:< ##

# name  = base.prng.handler.add_entropy
# descr = periodic timer : feed fresh entropy into fortuna
#
# armed by base.prng.init_code every <base.prng.cfg.add_entropy_interval>
# seconds [ //= 137 ] ; a long-running zenka keeps accumulating fresh
# entropy instead of living off its start seed.

<[base.prng.add_entropy]>->('timer');

return;

