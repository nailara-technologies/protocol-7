## [:< ##

# name  = screenshot.handler.powershell_capture_reply
# descr = async reply from powershell.screenshot-capture crop
#                                   + finish deferred capture

my $reply = shift // {};
my $mode  = lc( $reply->{'cmd'} // '' );
my $rdata = $reply->{'call_args'}->{'args'} // '';
my $id    = $reply->{'params'}->{'id'}      // '';

my $inst = delete <screenshot.passthrough>->{$id};
return if not defined $inst;

my ( $reply_id, $action, $coords ) = @{$inst}{qw| reply_id action coords |};

if ( $mode ne qw| true | ) {
    <[base.callback.cmd_reply]>->(
        $reply_id,
        {   'mode' => qw| false |,
            'data' => "powershell capture failed [ $rdata ]"
        }
    ) if defined $reply_id;
    return;
}

my $image = Imager->new;
if ( not $image->read( 'file' => $rdata ) ) {
    <[base.callback.cmd_reply]>->(
        $reply_id,
        {   'mode' => qw| false |,
            'data' => 'unable to load captured png [ '
                . $image->errstr . ' ]'
        }
    ) if defined $reply_id;
    return;
}

## screenshot zenka is the only caller permitted to reach this command [   ##
## enforced in cube/access.zenki ], so the full-resolution intermediate is ##
## ours alone to clean up - no cleanup command needed on the powershell    ##
## side. both zenki run on the same host, so this is a plain unlink rather ##
## than a cross-host transfer; safe once the bytes are loaded into memory  ##
unlink($rdata)
    or warn "could not remove source capture [ $rdata ] <{C1}>";

my ( $left, $top, $right, $bottom ) = @$coords;

## all-zero coords is grab_region's own "whole window" convention [ matches ##
## Imager::Screenshot's screenshot() semantics ] - skip the crop entirely   ##
## rather than ask Imager to crop to a zero-size rect                       ##
my $cropped;
if ( $left == 0 and $top == 0 and $right == 0 and $bottom == 0 ) {
    $cropped = $image;
} else {
    $cropped = $image->crop(
        'left'   => $left,
        'top'    => $top,
        'right'  => $right,
        'bottom' => $bottom
    );
}
if ( not $cropped ) {
    <[base.callback.cmd_reply]>->(
        $reply_id,
        {   'mode' => qw| false |,
            'data' => 'unable to crop captured region [ '
                . $image->errstr . ' ]'
        }
    ) if defined $reply_id;
    return;
}

if ( $action eq qw| return_region_color | ) {
    my $scaled  = <[screenshot.scale_image]>->( $cropped, 1, 1 );
    my $err_str = $scaled if ref($scaled) ne qw| Imager |;

    my @RGB;
    if ( not defined $err_str ) {
        @RGB     = <[screenshot.pixel_color]>->( $scaled, 0, 0 );
        $err_str = shift @RGB if @RGB == 1;
    }

    if ( defined $err_str ) {
        <[base.callback.cmd_reply]>->(
            $reply_id,
            {   'mode' => qw| false |,
                'data' => "unable to acquire region color [ $err_str ]"
            }
        ) if defined $reply_id;
        return;
    }

    pop(@RGB);    # removing alpha

    <[base.callback.cmd_reply]>->(
        $reply_id,
        { 'mode' => qw| true |, 'data' => sprintf( '#%02X%02X%02X', @RGB ) }
    ) if defined $reply_id;
    return;
}

## default : capture_to_disk ##
my $out_dir = <screenshot.cfg.output_dir>;
<[file.make_path]>->($out_dir) unless -d $out_dir;
my $stamp    = <[base.ntime.b32]>->( 5, TRUE );
my $out_path = sprintf '%s/screenshot-%s.png', $out_dir, $stamp;

my $write_ok = $cropped->write( 'file' => $out_path, 'type' => qw| png | );

if ( not $write_ok ) {
    <[base.callback.cmd_reply]>->(
        $reply_id,
        {   'mode' => qw| false |,
            'data' => 'unable to write PNG [ ' . $cropped->errstr . ' ]'
        }
    ) if defined $reply_id;
    return;
}

<[base.callback.cmd_reply]>->(
    $reply_id, { 'mode' => qw| true |, 'data' => $out_path }
) if defined $reply_id;

return;

