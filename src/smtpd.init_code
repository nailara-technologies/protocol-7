## [:< ##

# name  = smtpd.init_code
# descr = initialize smtpd zenka : mail receive, parse, classify, route

<[base.perlmod.autoload]>->('YAML::XS');
<[base.perlmod.autoload]>->('JSON::XS');
<[base.perlmod.autoload]>->('IO::Compress::Xz');
## optional: Email::MIME for full RFC 2822 parsing  falls back to simple ##
## regex parser if not available                                         ##
eval { require Email::MIME; Email::MIME->import(); };
<smtpd.has_email_mime> = $@ ? 0 : 1;

if ( not <smtpd.has_email_mime> ) {
    <[base.logs]>->(
        1, 'smtpd: Email::MIME not available, using fallback parser'
    );
}

## configuration defaults ##
<smtpd.cfg.store_dir>    //= '/var/protocol-7/mail/';
<smtpd.cfg.archive_days> //= 90;
<smtpd.cfg.archive_key>  //= '';
<smtpd.cfg.encrypt_raw>  //= 1;
<smtpd.cfg.compress_raw> //= 1;

## routing table: local-part -> target zenka ##
<smtpd.cfg.route> //= {};

## in-memory index of recent messages ##
<smtpd.mail_index> //= [];

## ensure store directory exists ##
my $store_dir = <smtpd.cfg.store_dir>;
if ( not -d $store_dir ) {
    my $p7_user = <system.amos-zenka-user> // qw| protocol-7 |;
    <[file.make_path]>->( $store_dir, 0750, $p7_user, $p7_user );
}

## load shared pattern-registry seed patterns [ classify domain ] --        ##
## data/yaml/pattern-registry/ is shared across future consumers            ##
## (forensics/httpd), the smtpd-* glob prefix is what keeps this zenka from ##
## ever loading a pattern file that isn't its own                           ##
<smtpd.cfg.pattern_dir> //= qw| data/yaml/pattern-registry |;
my $pattern_dir = <smtpd.cfg.pattern_dir>;
if ( $pattern_dir !~ m|^/| and defined <system.root_path> ) {
    $pattern_dir = <system.root_path> . '/' . $pattern_dir;
}
if ( -d $pattern_dir ) {
    foreach my $file ( glob "$pattern_dir/smtpd-*.yaml" ) {
        my $result = <[base.pattern-registry.load]>->( { 'file' => $file } );
        if ( ref $result eq qw| HASH | and $result->{'mode'} eq qw| true | ) {
            <[base.logs]>->(
                2,
                ':. smtpd.init: loaded %d patterns from %s :.',
                $result->{'data'}->{'loaded'} // 0, $file
            );
        }
    }
}

<[base.logs]>->( 1, 'smtpd: ready, store=%s', $store_dir );

