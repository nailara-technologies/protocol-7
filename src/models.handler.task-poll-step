## [:< ##

# name  = models.handler.task-poll-step
# descr = async callback chain for task claim and dispatch

my $reply  = shift;
my $cmd    = $reply->{'cmd'}       // '';
my $args   = $reply->{'call_args'} // {};
my $raw    = $reply->{'data'}      // '';
my $rdata  = ref $raw ? $raw->$* : $raw;
my $params = $reply->{'params'} // {};

my $step = $params->{'step'} // '';

## ======================================================================
## step: claimed : verify claim result, fetch task details
## ======================================================================

if ( $step eq 'claimed' ) {

    my $task_id = $params->{'task_id'} // '';

    if ( $cmd ne 'TRUE' ) {
        <[base.logs]>->( 2, ': task claim failed for %s', $task_id );
        return;
    }

    <[base.logs]>->(
        2, ': claimed %s, starting + fetching details', $task_id
    );

    <[protocol-7.route-send]>->(
        {   'command'   => 'task.start',
            'call_args' => { 'args' => $task_id }
        }
    );

    <[protocol-7.route-send]>->(
        {   'command'   => 'task.show',
            'call_args' => { 'args' => $task_id },
            'reply'     => {
                'handler' => 'models.handler.task-poll-step',
                'params'  => {
                    'step'    => 'show',
                    'task_id' => $task_id
                }
            }
        }
    );
    return;
}

## ======================================================================
## step: show : parse details, determine model, enqueue via jobqueue
## ======================================================================

if ( $step eq 'show' ) {

    my $task_id = $params->{'task_id'} // '';

    ## extract task details text
    my $details = '';
    if ( $cmd eq 'SIZE' ) {
        $details = $rdata;
    } elsif ( $cmd eq 'TRUE' ) {
        $details = $args->{'args'} // '';
    }

    if ( not length $details ) {
        <[base.logs]>->( 0, ': empty task details for %s', $task_id );
        <[protocol-7.route-send]>->(
            {   'command'   => 'task.fail',
                'call_args' => { 'args' => "$task_id empty task details" }
            }
        );
        return;
    }

    ## parse description, context, and history from task details
    my ( $description, $context ) = ( '', '' );
    my @history_turns;
    my $in_history = FALSE;
    my $current_turn;

    ## parse only the task.show header lines (stop after 'result :' field)
    my $in_header = TRUE;
    foreach my $line ( split( /\n/, $details ) ) {
        if ( $line =~ m{^---\s*history\s*---}i ) {
            $in_history = TRUE;
            $in_header  = FALSE;
            next;
        }
        if ($in_history) {
            if ( $line =~ m{^turn\s+\d+\s*:\s*(.*)$}i ) {
                $current_turn = { 'prompt' => $1, 'result' => '' };
                push @history_turns, $current_turn;
            } elsif ( $line =~ m{^\s+result\s*:\s*(.*)$}i
                and defined $current_turn ) {
                $current_turn->{'result'} = $1;
            }
            next;
        }
        ## stop header parsing once we hit the result line  (everything after
        ## is task content, not task metadata)
        if ( $in_header and $line =~ m{^result\s*:\s*}i ) {
            $in_header = FALSE;
            next;
        }
        next unless $in_header;

        ## require space before ':' to match task.show header format only
        if ( $line =~ m{^description\s+:\s+(.*)$}i ) {
            $description = $1;
        } elsif ( $line =~ m{^context\s+:\s*(.*)$}i ) {
            $context = $1;
        }
    }

    ## unescape newlines escaped by task.show for protocol safety
    $description =~ s{\\n}{\n}g;
    $context     =~ s{\\n}{\n}g;

    ## determine model from :name: prefix in description [ @name fallback ]
    my $model = <models.task.default_model> // 'kimi';
    if ( $description =~ s{^:([a-z0-9\-]+):\s*}{}i ) {
        $model = $1;
    } elsif ( $description =~ s{^\@(\S+)\s*}{} ) {
        $model = $1;
    }
    ## :review: prefix → auto-route to local model with review-cycle    ##
    ## template rewrite description so coding.prompt.assemble picks the ##
    ## right template                                                   ##
    if ( $model eq 'review' ) {
        $model       = 'local';
        $description = "review-cycle $description";
    }

    ## build prompt with conversation history for multi-turn tasks
    my $prompt = '';

    if (@history_turns) {
        $prompt .= sprintf "[task %s] [continuation turn %d]\n",
            $task_id, scalar(@history_turns) + 1;
        foreach my $turn (@history_turns) {
            my $t_prompt = $turn->{'prompt'} // '';
            ## strip model prefix from history prompts
            $t_prompt =~ s{^:[a-z0-9\-]+:\s*}{}i;
            $t_prompt =~ s{^\@\S+\s*}{};
            $prompt .= sprintf "user: %s\nassistant: %s\n\n",
                $t_prompt, $turn->{'result'} // '';
        }
        $prompt .= sprintf "user: %s", $description;
    } else {
        $prompt = sprintf "[task %s]\n%s", $task_id, $description;
    }

    $prompt .= "\n\n$context" if length $context;

    ## model to backend command mapping
    my %backend_cmd = (
        'kimi'      => 'kimi.ask-reply',
        'kimi-code' => 'kimi.ask-reply',
        'llama'     => 'coding.ask-reply',
        'local'     => 'coding.ask-reply',
    );

    my $target_cmd = $backend_cmd{$model};

    if ( not defined $target_cmd ) {
        <[base.logs]>->(
            0,      ': no backend for model %s [ task %s ]',
            $model, $task_id
        );
        <[protocol-7.route-send]>->(
            {   'command'   => 'task.fail',
                'call_args' =>
                    { 'args' => "$task_id no backend for model $model" }
            }
        );
        return;
    }

    <[base.logs]>->(
        1,        ': task %s enqueueing for %s backend',
        $task_id, $model
    );

    ## enqueue for jobqueue-managed execution ##
    <[models.task.enqueue]>->(
        {   'task_id'    => $task_id,
            'model'      => $model,
            'prompt'     => $prompt,
            'target_cmd' => $target_cmd
        }
    );

    return;
}

## ======================================================================
## step: check-next : pick up next pending task after previous completes
## ======================================================================

if ( $step eq 'check-next' ) {

    ## parse queue output for first pending task id
    my $queue_text = '';
    if ( $cmd eq 'SIZE' ) {
        $queue_text = $rdata;
    } elsif ( $cmd eq 'TRUE' ) {
        $queue_text = $args->{'args'} // '';
    }

    if ( not length $queue_text or $queue_text =~ m{^no tasks found} ) {
        <[base.log]>->( 2, ': no pending tasks in queue' );
        return;
    }

    ## first line = oldest pending task: "TASKID  pending  description..."
    my ($next_id) = $queue_text =~ m{^([A-Z0-9]{7})\s+pending}m;

    if ( not defined $next_id ) {
        <[base.log]>->( 2, ': no parseable pending task in queue output' );
        return;
    }

    <[base.logs]>->( 1, ': auto-dispatching next pending task %s', $next_id );

    ## claim via same async chain as task-notify
    <[protocol-7.route-send]>->(
        {   'command'   => 'task.claim',
            'call_args' => { 'args' => "$next_id models" },
            'reply'     => {
                'handler' => 'models.handler.task-poll-step',
                'params'  => { 'step' => 'claimed', 'task_id' => $next_id }
            }
        }
    );
    return;
}

<[base.logs]>->( 0, ': task-poll-step: unknown step [ %s ]', $step );
return;

