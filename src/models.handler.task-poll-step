## [:< ##

# name  = models.handler.task-poll-step
# descr = async callback chain for task claim and dispatch
# notes = local task zenka : claimed -> show -> enqueue. remote task zenka
#         [ models.task.remote ] : peek -> peek-claimed -> enqueue, see
#         models.task.dispatch-id

my $reply  = shift;
my $cmd    = $reply->{'cmd'}       // '';
my $args   = $reply->{'call_args'} // {};
my $raw    = $reply->{'data'}      // '';
my $rdata  = ref $raw ? $raw->$* : $raw;
my $params = $reply->{'params'} // {};

my $step = $params->{'step'} // '';

## task.show \ task.queue reply text [ SIZE or single line TRUE ] ##
my $reply_text = '';
if ( $cmd eq 'SIZE' ) {
    $reply_text = $rdata;
} elsif ( $cmd eq 'TRUE' ) {
    $reply_text = $args->{'args'} // '';
}

## ======================================================================
## step: claimed : verify claim result, fetch task details
## ======================================================================

if ( $step eq 'claimed' ) {

    my $task_id = $params->{'task_id'} // '';

    if ( $cmd ne 'TRUE' ) {
        <[base.logs]>->( 2, ': task claim failed for %s', $task_id );
        delete <models.task.claimed>->{$task_id};    ## reserved slot ##
        return;
    }

    <[base.logs]>->(
        2, ': claimed %s, starting + fetching details', $task_id
    );

    <models.task.claimed>->{$task_id} = time;    ## in-flight count ##

    <[protocol-7.route-send]>->(
        {   'command'   => <[models.task.cmd]>->( qw| start |, $task_id ),
            'call_args' => { 'args' => $task_id }
        }
    );

    <[protocol-7.route-send]>->(
        {   'command'   => <[models.task.cmd]>->( qw| show |, $task_id ),
            'call_args' => { 'args' => $task_id },
            'reply'     => {
                'handler' => 'models.handler.task-poll-step',
                'params'  => {
                    'step'    => 'show',
                    'task_id' => $task_id
                }
            }
        }
    );
    return;
}

## ======================================================================
## step: show : parse details, determine model, enqueue via jobqueue
## ======================================================================

if ( $step eq 'show' ) {

    my $task_id = $params->{'task_id'} // '';

    if ( not length $reply_text ) {
        <[base.logs]>->( 0, ': empty task details for %s', $task_id );
        <[protocol-7.route-send]>->(
            {   'command'   => <[models.task.cmd]>->( qw| fail |, $task_id ),
                'call_args' => { 'args' => "$task_id empty task details" }
            }
        );
        return;
    }

    my $parsed = <[models.task.parse-show]>->( $task_id, $reply_text );
    my $model  = $parsed->{'model'};

    my $target_cmd = $parsed->{'target_cmd'};

    if ( not defined $target_cmd ) {
        <[base.logs]>->(
            0,      ': no backend for model %s [ task %s ]',
            $model, $task_id
        );
        <[protocol-7.route-send]>->(
            {   'command'   => <[models.task.cmd]>->( qw| fail |, $task_id ),
                'call_args' =>
                    { 'args' => "$task_id no backend for model $model" }
            }
        );
        return;
    }

    <[base.logs]>->(
        1,        ': task %s enqueueing for %s backend',
        $task_id, $model
    );

    ## enqueue for jobqueue-managed execution ##
    <[models.task.enqueue]>->(
        {   'task_id'    => $task_id,
            'model'      => $model,
            'prompt'     => $parsed->{'prompt'},
            'target_cmd' => $target_cmd
        }
    );

    return;
}

## ======================================================================
## step: peek : remote task zenka, details BEFORE the claim -- a task for a
## model this host does not serve stays pending for its owner.  nothing here
## fails a task : it is not ours until the claim succeeds
## ======================================================================

if ( $step eq 'peek' ) {

    my $task_id = $params->{'task_id'} // '';

    if ( not length $reply_text ) {
        <[base.logs]>->(
            1,        ': peek %s : no task details [ %s ], left alone',
            $task_id, $cmd eq 'FALSE' ? $args->{'args'} // 'FALSE' : $cmd
        );
        return;
    }

    my $parsed = <[models.task.parse-show]>->( $task_id, $reply_text );
    my $model  = $parsed->{'model'};

    if ( $parsed->{'status'} ne 'pending' ) {
        <[base.logs]>->(
            2,        ': peek %s : %s, not pending -- left alone',
            $task_id, length $parsed->{'status'} ? $parsed->{'status'} : '?'
        );
        return;
    }

    ## served here : the local backend only [ local, llama, review ] ##
    my $target_cmd = $parsed->{'target_cmd'} // '';
    if ( $target_cmd ne 'coding.ask-reply' ) {
        <[base.logs]>->(
            2,        ': peek %s : model %s not served here, left pending',
            $task_id, $model
        );
        return;
    }

    ## the iteration loop reads models' own data, never a remote queue ##
    <[base.logs]>->(
        1, ': peek %s : iteration flag ignored for a remote task', $task_id
    ) if $parsed->{'iteration'};

    ## ':model:' pin check, then the claim ##
    <[models.task.peek-claim]>->(
        {   'task_id'    => $task_id,
            'model'      => $model,
            'prompt'     => $parsed->{'prompt'},
            'target_cmd' => $target_cmd,
            'model_pin'  => $parsed->{'model_pin'}
        }
    );
    return;
}

## ======================================================================
## step: peek-models : coding.inference-status answered -- the models the
## local coding zenka has loaded, then the pin check again
## ======================================================================

if ( $step eq 'peek-models' ) {

    ## coding.inference-status answered -- the models the local coding ##
    ## zenka has loaded, then the pin + capacity checks again          ##
    <[models.task.set-local-models]>->($reply_text);

    my %peek = %{$params};
    delete $peek{'step'};
    <[models.task.peek-claim]>->( \%peek );
    return;
}

## ======================================================================   ##
## step: capacity-models : coding.inference-status answered the local claim ##
## gate -- cache the loaded models, then the dispatch again                 ##
## =======================================================================  ##

if ( $step eq 'capacity-models' ) {

    <[models.task.set-local-models]>->($reply_text);

    <[models.task.dispatch-id]>->(
        $params->{'task_id'} // '',
        $params->{'zenka'}   // ''
    );
    return;
}

## ======================================================================
## step: peek-claimed : claim answered -- start and enqueue the prompt the
## peek already built. a refused claim = another worker took it
## ======================================================================

if ( $step eq 'peek-claimed' ) {

    my $task_id = $params->{'task_id'} // '';

    if ( $cmd ne 'TRUE' ) {
        <[base.logs]>->(
            1, ': claim %s refused [ %s ] : taken elsewhere, left alone',
            $task_id, $args->{'args'} // $cmd
        );
        delete <models.task.claimed>->{$task_id};    ## reserved slot ##
        return;
    }

    <[protocol-7.route-send]>->(
        {   'command'   => <[models.task.cmd]>->( qw| start |, $task_id ),
            'call_args' => { 'args' => $task_id }
        }
    );

    <[base.logs]>->(
        1,        ': task %s claimed remotely, enqueueing for %s backend',
        $task_id, $params->{'model'}
    );

    <models.task.claimed>->{$task_id} = time;    ## in-flight count ##

    <[models.task.enqueue]>->(
        {   'task_id'    => $task_id,
            'model'      => $params->{'model'},
            'prompt'     => $params->{'prompt'},
            'target_cmd' => $params->{'target_cmd'}
        }
    );
    return;
}

## ======================================================================
## step: check-next : pick up next pending task after previous completes
## ======================================================================

if ( $step eq 'check-next' ) {

    ## parse queue output for first pending task id
    my $queue_text = $reply_text;

    if ( not length $queue_text or $queue_text =~ m{^no tasks found} ) {
        <[base.log]>->( 2, ': no pending tasks in queue' );
        return;
    }

    ## first line = oldest pending task: "TASKID  pending  description..."
    my ($next_id) = $queue_text =~ m|^([A-Z0-9]{7})\s+pending|m;

    if ( not defined $next_id ) {
        <[base.log]>->( 2, ': no parseable pending task in queue output' );
        return;
    }

    <[base.logs]>->( 1, ': auto-dispatching next pending task %s', $next_id );

    ## claim via same async chain as task-notify [ remote : peek first ] ##
    ## [ the queue just read belongs to the reply's source zenka ]       ##
    <[models.task.dispatch-id]>->( $next_id, $params->{'zenka'} // '' );
    return;
}

## ======================================================================
## step: poll-next : remote fallback poll, '<task_zenka>.next' answered "<id>
## [<assignee>] <description> (priority N)" or FALSE when empty
## ======================================================================

if ( $step eq 'poll-next' ) {

    ## poll answered : free exactly this zenka's slot ##
    my $poll_zenka = $params->{'zenka'} // '';
    if ( length $poll_zenka ) {
        my $state = <models.task.streams>->{$poll_zenka} //= {};
        $state->{'poll_sent_at'} = undef;
    } else {
        <models.task.poll.sent_at> = undef;    ## legacy in-flight reply ##
    }

    my ($next_id) = $reply_text =~ m|^([A-Z0-9]{7})\s|;

    if ( not defined $next_id ) {
        <[base.logs]>->(
            2,
            ': task poll : nothing pending [ %s ]',
            $cmd eq 'FALSE' ? $args->{'args'} // 'FALSE' : $cmd
        );
        return;
    }

    <[base.logs]>->( 2, ': task poll : peeking %s', $next_id );
    <[models.task.dispatch-id]>->( $next_id, $poll_zenka );
    return;
}

<[base.logs]>->( 0, ': task-poll-step: unknown step [ %s ]', $step );
return;

