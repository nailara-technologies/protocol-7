## [:< ##

# name  = coding.buffer.model_output
# descr = log model output to observation buffer with chat-like formatting

my $content = shift // '';
my $context = shift // {};

return FALSE unless length $content;

my $buffer_name = qw| model_output |;

##  context info  ##
my $round = $context->{'round'} // qw| ? |;
my $tool  = $context->{'tool'}  // qw| none |;

##  format based on message type  ##
my @lines;

if ( $tool eq 'stream_chunk' ) {
    ##  stream chunks: clean output, no prefixes  ##
    $content =~ s|\r||g;
    @lines = split( m|\n|, $content );
} elsif ( $tool eq 'input' ) {
    ##  user input: highlighted header  ##
    my $header = sprintf(
        '┌──[ user | round %s %s ]%s',
        $round, $context->{'pct'} ? '[CTX:' . $context->{'pct'} . '%]' : '',
        '─' x 40
    );
    push @lines, $header;
    $content =~ s|\r||g;
    my @content_lines = split( m|\n|, $content );
    foreach my $line (@content_lines) {
        push @lines, "│ $line";
    }
    push @lines, '└' . '─' x 50;
} elsif ( $tool eq 'model' ) {
    ##  model response: highlighted header  ##
    my $header = sprintf(
        '┌──[ assistant | round %s %s]%s',
        $round, $context->{'pct'} ? '[CTX:' . $context->{'pct'} . '%] ' : '',
        '─' x 36
    );
    push @lines, $header;
    $content =~ s|\r||g;
    my @content_lines = split( m|\n|, $content );
    foreach my $line (@content_lines) {
        push @lines, "│ $line";
    }
    push @lines, '└' . '─' x 50;
} else {
    ##  other tools: simple prefix  ##
    my $prefix = sprintf( '[%s|%s]', $round, $tool );
    $content =~ s|\r||g;
    my @content_lines = split( m|\n|, $content );
    foreach my $line (@content_lines) {
        push @lines, "$prefix $line";
    }
}

##  truncate long lines  ##
my $max_line = 200;
foreach my $line (@lines) {
    if ( length $line > $max_line ) {
        $line = substr( $line, 0, $max_line ) . '.,.';
    }
}

##  add to buffer  ##
foreach my $line (@lines) {
    <[base.buffer.add_line]>->( $buffer_name, $line );
}

return TRUE;

