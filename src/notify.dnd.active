## [:< ##

# name   = notify.dnd.active
# descr  = is do-not-disturb on now [ ends a timed one ]
# return = TRUE or FALSE
#
# a timed switch [ notify.dnd on for=<span> ] ends when it is read after its
# time, as the chat relay switch does : no timer of its own

my $dnd = <notify.dnd.state> // return FALSE;
return FALSE if !$dnd->{'on'};
if ( $dnd->{'until'} and $dnd->{'until'} <= time ) {
    $dnd->{'on'}    = FALSE;
    $dnd->{'until'} = 0;
    <[base.log]>->( 1, 'do not disturb ended [ timed ]' );
    return FALSE;
}
return TRUE;

