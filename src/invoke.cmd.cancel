## [:< ##

# name  = invoke.cmd.cancel
# descr = cancel a job by item_id, or all pending jobs

my $target = $call->{'args'} // '';
$target =~ s|^\s+||;
$target =~ s|\s+$||;

my $url = <invoke.url>;
my $ua  = LWP::UserAgent->new( timeout => 10 );

if ( !length $target or $target eq 'all' ) {
    ## cancel all : collect batch_ids from tracked jobs
    my @batch_ids
        = map { $ARG->{'batch_id'} } values %{ <invoke.jobs> // {} };

    unless (@batch_ids) {
        return { mode => qw| false |, data => 'no tracked jobs to cancel' };
    }

    my $body = JSON::encode_json( { 'batch_ids' => \@batch_ids } );
    my $req  = HTTP::Request->new(
        PUT => "$url/api/v1/queue/default/cancel_by_batch_ids" );
    $req->header( 'Content-Type' => 'application/json' );
    $req->content($body);
    my $resp = $ua->request($req);

    <invoke.jobs> = {};

    return $resp->is_success
        ? { mode => qw| true |, data => 'cancelled all jobs' }
        : {
        mode => qw| false |,
        data => sprintf( 'cancel failed [ %s ]', $resp->status_line )
        };
}

## cancel specific item : find its batch_id
my $job = <invoke.jobs>->{$target};
unless ($job) {
    return {
        mode => qw| false |,
        data => sprintf( 'unknown item_id [ %s ]', $target )
    };
}

my $body = JSON::encode_json( { 'batch_ids' => [ $job->{'batch_id'} ] } );
my $req  = HTTP::Request->new(
    PUT => "$url/api/v1/queue/default/cancel_by_batch_ids" );
$req->header( 'Content-Type' => 'application/json' );
$req->content($body);
my $resp = $ua->request($req);

delete <invoke.jobs>->{$target};

return $resp->is_success
    ? {
    mode => qw| true |,
    data => sprintf( 'cancelled item %s', $target )
    }
    : {
    mode => qw| false |,
    data => sprintf( 'cancel failed [ %s ]', $resp->status_line )
    };

