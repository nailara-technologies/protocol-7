## [:< ##

# name  = nameserv.zone.tombstone.purge
# descr = drop tombstones past the keep window
# param = $zone_name -> number of tombstones dropped

my $zone_name = shift // '';

my $zones = <nameserv.zones>;
my $zone  = $zones->{$zone_name} // return 0;
return 0 if ref $zone->{'tombstones'} ne qw| ARRAY |;

my $keep = <nameserv.cfg.sync.tombstone_keep> // 1123200;    ## 13 days ##

my $dropped = 0;
my @kept    = ();

for my $tomb ( @{ $zone->{'tombstones'} } ) {
    my $deleted = $tomb->{'deleted'} // '';
    if ( not length $deleted
        or $deleted !~ m|^\d+(\.\d+)?$|
        and not <[base.ntime.b32_is_shape_valid]>->($deleted) ) {
        ## missing or unparsable ts : oldest possible, expired ##
        $dropped++;
        next;
    }
    my $age = <[base.ntime.delta_seconds]>->($deleted);
    if ( not defined $age or $age > $keep ) {
        $dropped++;
    } else {
        push @kept, $tomb;
    }
}

$zone->{'tombstones'} = \@kept;

return $dropped;

