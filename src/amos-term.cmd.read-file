## [:< ##
# name  = amos-term.cmd.read-file
# descr = Read a whole file over 9P (plan-9.client)

my $args = $call->{'args'} // '';
my ( $name, $path ) = split /\s+/, $args, 2;

if ( not length( $name // '' ) or not length( $path // '' ) ) {
    return {
        'mode' => 'false',
        'data' => 'usage: read-file <connection-name> <path>'
    };
}

my $result = <[plan-9.client.read-file]>->( $name, $path );
return $result if $result->{'mode'} eq 'false';

return { 'mode' => 'size', 'data' => $result->{'data'} };

