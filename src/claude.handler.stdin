## [:< ##

# name  = claude.handler.stdin
# descr = the child's stdin is writable : drain the queue

my $event = shift->w;
my $child = <claude.child>;
if ( not defined $child
    or $child->{'pid'} != ( $event->data->{'pid'} // 0 ) ) {
    $event->cancel if $event->is_active;
    return;
}
<[claude.child.flush]>;

