## [:< ##

# name  = letsencr.child.acme.step_setup
# param = <order_id>
# descr = send every challenge set-up, each with a reply handler

my $order_id = shift;
my $order    = <[letsencr.child.acme.order_of]>->($order_id) // return FALSE;
$order->{'step'}    = qw| setup |;
$order->{'waiting'} = 0;

my $provider   = <letsencr.dns.provider> // qw| nameserv |;
my @ns_targets = grep {length}
    split m|\s+|, <letsencr.dns.nameserv.targets> // qw| nameserv |;

my $send = sub {
    my ( $authz, $target, $command, $args ) = @ARG;
    $authz->{'setup'}->{$target} = FALSE;
    $order->{'waiting'}++;
    <[protocol-7.route-send]>->(
        {   'command'   => $command,
            'call_args' => { 'args' => $args },
            'reply'     => {
                'handler' => qw| letsencr.child.acme.on_setup |,
                'params'  => {
                    'order_id' => $order_id,
                    'authz'    => $authz->{'url'},
                    'target'   => $target,
                },
            },
        }
    );
};

foreach
    my $authz ( map { $order->{'authz'}->{$ARG} } $order->{'authz_urls'}->@* )
{
    next if $authz->{'status'} eq qw| reused |;

    if ( $authz->{'type'} eq qw| http-01 | ) {
        $send->(
            $authz,   qw| httpd |,      qw| httpd.setup-acme-challenge |,
            join ' ', $authz->{'base'}, $authz->{'token'},
            $authz->{'key_auth'}
        );
    } elsif ( $provider eq qw| nameserv | ) {
        ## an alias subzone is created on first use                       ##
        ## [ nameserv ensure-zone : acme.* only, an existing zone stays ] ##
        ## -- sent ahead of add-txt on the same route, no reply counted   ##
        my $alias_zone
            = <[letsencr.child.acme.challenge_name]>->( $authz->{'base'} )
            =~ s|^_acme-challenge\.||r;
        if ( $alias_zone ne lc $authz->{'base'} ) {
            my $alias_ns = <letsencr.dns.alias_ns>
                // qw| dn0000.protocol-7.network |;
            ## the parent zone held by our own nameserv : it writes the ##
            ## _acme-challenge cname itself                             ##
            ## [ 'not ours' : the registrar way below, unchanged ] -- a ##
            ## custom alias pair, or a domain listed in                 ##
            ## letsencr.dns.unmanaged_alias_zones, is skipped           ##
            my %unmanaged = map { lc $ARG => 1 }
                grep {length} split m|[\s,]+|,
                <letsencr.dns.unmanaged_alias_zones> // '';
            <[protocol-7.route-send]>->(
                {   'command'   => "$ARG.ensure-challenge-alias",
                    'call_args' => {
                        'args' => join( ' ', lc $authz->{'base'}, $alias_ns )
                    },
                }
                )
                foreach grep { $alias_zone eq 'acme.' . lc $authz->{'base'} }
                grep { not $unmanaged{ lc $authz->{'base'} } } @ns_targets;
            <[protocol-7.route-send]>->(
                {   'command'   => "$ARG.ensure-zone",
                    'call_args' => { 'args' => "$alias_zone $alias_ns" },
                }
            ) foreach @ns_targets;
        }
        $send->(
            $authz, $ARG, "$ARG.add-txt", join ' ',
            <[letsencr.child.acme.challenge_name]>->( $authz->{'base'} ),
            $authz->{'dns_value'}
        ) foreach @ns_targets;
    } elsif ( $provider eq qw| inwx | or $provider eq qw| cloudflare | ) {
        ## provider apis : still blocking http calls, done before respond ##
        my $ok = $code{"letsencr.dns.${provider}_create_txt"}->(
            <[letsencr.child.acme.challenge_name]>->( $authz->{'base'} ),
            $authz->{'dns_value'}
        );
        return <[letsencr.child.acme.fail]>->(
            $order_id, "$provider : txt record for $authz->{'domain'} failed"
        ) if not $ok;
        $authz->{'setup'}->{$provider} = TRUE;
    } else {
        return <[letsencr.child.acme.fail]>->(
            $order_id, "dns provider '$provider' not supported"
        );
    }
}

<[base.logs]>->(
    2, ': acme : order %s : %d set-up%s sent',
    $order_id, $order->{'waiting'}, <[base.cnt_s]>->( $order->{'waiting'} )
);

return <[letsencr.child.acme.step_propagate]>->($order_id)
    if not $order->{'waiting'};

return TRUE;

