## [:< ##

# name  = space.route.encode
# descr = encode hop sequence to dot/comma route notation
# param = { hops }

my $params = shift             // {};
my $hops   = $params->{'hops'} // [];

my $route = '';

for my $hop (@$hops) {
    my $type = $hop->{'type'} // '';
    if ( $type eq 'straight' ) {
        my $distance = $hop->{'distance'} // 1;
        $route .= '.' x $distance;
    } elsif ( $type eq 'turn' ) {
        $route .= ',';
    } elsif ( $type eq 'landmark' ) {
        my $address = $hop->{'address'} // '';
        $route .= $address if length $address;
    }
}

return $route;

