## [:< ##

# name  = X-11.cmd.subscribe-screen-change
# param = subscribe
# descr = subscribe to screen-change events via STRM

## subscription mode ##
if ( not defined $call->{'args'} or $call->{'args'} eq qw| subscribe | ) {
    my $h = <[base.stream.open]>->(
        {   sid    => $call->{'session_id'},
            cmd_id => $call->{'command_id'},
            type   => qw| STRM |,
            total  => undef,
        }
    );
    return <[base.callback.cmd_reply]>->(
        $call->{'reply_id'},
        { 'mode' => qw| false |, 'data' => 'stream open refused' }
    ) if not defined $h;

    <X-11.screen_change_listeners> //= [];
    push <X-11.screen_change_listeners>->@*, $h;
    <[base.logs]>->(
        2, 'screen-change listener added [sid=%d]',
        $call->{'session_id'}
    );
    return { 'mode' => qw| deferred | };
}

return { 'mode' => qw| false |, 'data' => 'expected args = subscribe' };

