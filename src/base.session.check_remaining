## [:< ##

# name  = base.session.check_remaining
# descr = exit zenka in no more sessions

my $exit_count    = shift // 0;
my $silence       = shift // FALSE;  ## silencing logging when called directly
my $session_count = 0;

my $log_level = <[base.cfg_bool]>->($silence) ? 3 : 2;    ##[ silenced = 3 ]##

$session_count = scalar keys $data{'session'}->%* if defined $data{'session'};

if ($session_count) {
    my $single_server_session = 0;
    if ( $session_count == 1 ) {
        ( my $session_id ) = keys $data{'session'}->%*;
        my $mode = $data{'session'}{$session_id}{'mode'};
        $single_server_session = TRUE
            if defined $mode and $mode eq qw| server |;
    }
    if ($single_server_session) {
        <[base.log]>->( $log_level, 'one active server session ..,' );
    } else {
        <[base.logs]>->(
            $log_level,     '%s session%s remaining.,',
            $session_count, <[base.cnt_s]>->($session_count)
        );
    }
} else {
    <[base.log]>->( 2, 'no sessions remaining..,' ); ##  regular log-level  ##
}

if (    ( $session_count + $exit_count ) == 0
    and exists $data{'callback'}
    and exists <callback.session>
    and exists <callback.session.closing_last> ) {

    if ( <system.zenka.type> eq qw| v7-zenki | ) {
        <v7-zenki.check_remaining.fail_count> //= 0;
        <v7-zenki.check_remaining.fail_count>++;
        return if <v7-zenki.check_remaining.fail_count> < 2;
    }

    my $callback_name = <callback.session.closing_last.name> // '';

    if ( not exists $code{$callback_name} ) {
        <[base.logs]>->(
            0, ":: callback '%s' not found., [closing_last]",
            $callback_name
        );
    } else {
        <[base.log]>->( 2, "executing 'closing_last' callback..," );
        $code{$callback_name}->( <callback.session.closing_last.params>->@* );
    }
}

if ( $session_count == 0 and <[base.mod.exists]>->(qw| v7-zenki |) )
{    #[v7-zenka]#
    my $check_cmd = qw| zenka.cmd.get-instance-ids |;
    if ( exists $code{$check_cmd} ) {
        my $cmd_reply = $code{$check_cmd}->(qw| cube |);    ## cube zenka? ##
        ##
        <[base.code.call_expected]>->(
            ( $cmd_reply->{'mode'} eq qw| false | ),  ## status : shut-down ##
            qw| v7-zenki.teardown |,
            'cube zenka shut down intentionally', qw| none |
        );
    }
}

