## [:< ##

# name  = jobsite.sync.apply_reverse
# descr = apply reverse changes from httpd to local records

my $entries = shift;
return if ref $entries ne 'ARRAY';

my $jobs_dir = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite jobs |;

for my $entry ( @{$entries} ) {
    next if ref $entry ne 'HASH';

    my $id = ( $entry->{'id'} // '' );
    next if not length $id;

    my $action = $entry->{'action'} // '';
    my $enc_id = $id;

    if ( $action eq 'delete' ) {
        my ( $ok, $why ) = <[jobsite.job.trash]>->($id);
        <[base.logs]>->( 0, 'jss.sync.apply: delete %s — %s', $id, $why )
            if not $ok;
        next;
    }

    if ( $action eq 'blacklist' ) {
        my $job = <[jobsite.job.read]>->($id);
        my $company
            = ( ref $job eq 'HASH' ) ? ( $job->{'company'} // '' ) : '';
        if ( length $company ) {
            <[jobsite.cmd.blacklist-add]>->( { 'args' => $company } );
            <[base.logs]>->(
                1,   'jss.sync.apply: blacklisted %s (%s)',
                $id, $company
            );
        } else {
            <[base.logs]>->(
                0, 'jss.sync.apply: blacklist %s failed, no company', $id
            );
        }
        next;
    }

    if ( $action eq 'reassess' ) {
        my $job = <[jobsite.job.read]>->($id);
        if ( ref $job ne 'HASH' ) {
            <[base.logs]>->(
                0, 'jss.sync.apply: reassess %s — not found', $id
            );
            next;
        }

        ## clear assessment fields only : keep user stage/status ##
        for my $f (
            qw| score score_reason score_summary assertions
            repair_attempted repair_failed repair_applied |
        ) {
            delete $job->{$f};
        }
        <[jobsite.job.write]>->( $id, $job );

        ## update in-memory task record ##
        my $rec = ( <jobsite.tasks> // {} )->{$id} // {};
        delete $rec->{$ARG}
            for qw| score score_reason score_summary assertions
            repair_attempted repair_failed |;
        ## keep user-selected stage/status so assess-done treats it as ##
        ## protected                                                   ##
        $rec->{'stage'}  = $job->{'stage'}  if defined $job->{'stage'};
        $rec->{'status'} = $job->{'status'} if defined $job->{'status'};

        ## queue_gen : bump on every reassess request for this id, same    ##
        ## contract as dispatch.assessments -- a repeated/duplicate        ##
        ## reassess (double-click, retried reverse-sync entry) still lands ##
        ## a new queue entry here, but only the LAST one [ highest gen ]   ##
        ## will still match by the time dispatch.next reaches it, so       ##
        ## earlier duplicates are skipped as stale instead of each firing  ##
        ## its own real reassessment                                       ##
        my $gen = 1 + ( $rec->{'queue_gen'} // 0 );
        $rec->{'queue_gen'} = $gen;
        <jobsite.tasks>->{$id} = $rec;

        ## always count this new slot, even mid-cycle -- if a batch is    ##
        ## already 'assessing', this entry rides along on the same tally  ##
        ## instead of being silently uncounted [ uncounted slots never    ##
        ## bring pending_count to 0, same failure class as a skipped-slot ##
        ## leak; see jobsite.dispatch.consume_slot ]                      ##
        <jobsite.pending_count> = ( <jobsite.pending_count> // 0 ) + 1;

        ## refresh source data before re-scoring, when the source supports ##
        ## it : site-yaml.import-url re-scrapes and calls                  ##
        ## jobsite.cmd.job-upsert, which now preserves the full protected  ##
        ## field set and merges in whatever changed on the live posting    ##
        ## [ salary estimate, updated description, ... ]. the actual LLM   ##
        ## pass is deferred until that refresh really lands -- see         ##
        ## jobsite.dispatch.reassess_now, fired either from job-upsert's   ##
        ## awaiting_refetch check or, if the source url isn't refetchable, ##
        ## from jobsite.handler.reassess-refetch-queued's fallback -- so a ##
        ## reassess never scores stale data when a fresher fetch was       ##
        ## possible                                                        ##
        <jobsite.tasks>->{$id}{'awaiting_refetch'} = $gen;
        my $refetch_zenka = <jobsite.cfg.fetch_zenka> // qw| site-yaml |;
        ## remote fetch : outbox transport, no route-send delivery ##
        <[jobsite.fetched.subscribe]>->($refetch_zenka)
            if $refetch_zenka ne qw| site-yaml |;
        my $refetch_args = 'url=' . ( $job->{'url'} // '' );
        $refetch_args .= ' handler=:hold:'
            if $refetch_zenka ne qw| site-yaml |;
        <[protocol-7.route-send]>->(
            {   'command'   => $refetch_zenka . '.import-url',
                'call_args' => { 'args' => $refetch_args },
                'reply'     => {
                    'handler' => 'jobsite.handler.reassess-refetch-queued',
                    'params'  => { 'job_id' => $id, 'gen' => $gen },
                },
            }
        );

        <[base.logs]>->(
            1, 'jss.sync.apply: reassess %s queued (refetch requested)', $id
        );
        next;
    }

    ## update browser-owned fields
    my $job = <[jobsite.job.read]>->($id);
    if ( ref $job ne 'HASH' ) {
        <[base.logs]>->( 0, 'jss.sync.apply: cannot read %s', $id );
        next;
    }

    my %stage_to_status = (
        'review'      => 'review',
        'to_apply'    => 'apply',
        'applied'     => 'applied',
        'interviewed' => 'interviewed',
        'responded'   => 'applied',
        'rejected'    => 'rejected',
        'skipped'     => 'skipped',
        'archived'    => 'rejected',
    );

    my $updated = 0;
    for my $field (qw| stage notes date_applied stage_changed_at |) {
        if ( exists $entry->{$field} ) {
            $job->{$field} = $entry->{$field};
            $updated = 1;
        }
    }

    ## export marks : newest-wins record pair, the mark time IS exported_at ##
    ## [ the shared batch epoch of the export run, or the epoch an unmark   ##
    ## happened at ] ; an older or equal record never clobbers a newer      ##
    ## local mark, and a record without a time only lands where nothing is  ##
    ## marked yet [ legacy migration entry ] ; undo = the web-side unmark   ##
    ## flow, which arrives as exported_stage => undef with a fresh time     ##
    if ( exists $entry->{'exported_stage'} ) {
        my $inc_at = $entry->{'exported_at'};
        my $inc_time
            = ( defined $inc_at and $inc_at =~ m{^\d+$} ) ? $inc_at + 0 : 0;
        my $cur_at = $job->{'exported_at'};
        my $cur_time
            = ( defined $cur_at and $cur_at =~ m{^\d+$} ) ? $cur_at + 0 : 0;
        if ( $inc_time > $cur_time
            or ( not length( $cur_at // '' ) and not $inc_time ) ) {
            $job->{'exported_stage'} = $entry->{'exported_stage'};
            $job->{'exported_at'}    = $inc_time;
            $updated                 = 1;
        }
    }

    ## stage change also drives backend status so jobs don't stay in review ##
    ## forever                                                              ##
    if (    exists $entry->{'stage'}
        and exists $stage_to_status{ $entry->{'stage'} } ) {
        my $new_status = $stage_to_status{ $entry->{'stage'} };
        if ( ( $job->{'status'} // '' ) ne $new_status ) {
            $job->{'status'} = $new_status;
            $updated = 1;
        }
    }

    if ($updated) {
        ## keep in-memory task record in sync so assess-done protect check ##
        ## sees current stage                                              ##
        if ( exists $entry->{'stage'} ) {
            my $tasks = <jobsite.tasks>;
            if ( ref $tasks eq 'HASH' and defined $tasks->{$id} ) {
                $tasks->{$id}{'stage'}  = $entry->{'stage'};
                $tasks->{$id}{'status'} = $job->{'status'}
                    if defined $job->{'status'};
            }
        }
        <[jobsite.job.write]>->( $id, $job );
        <[base.logs]>->( 1, 'jss.sync.apply: updated %s', $id );
    }
}

