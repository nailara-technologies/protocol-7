## [:< ##

# name  = nameserv.sync.peer.sync_done
# descr = re-arm a peer wait after its sync pull finished

my $state  = shift;
my $result = shift;

my $key = ref $state eq qw| HASH | ? $state->{'peer'} // '' : '';
return if not length $key;

my $peers = <nameserv.sync.peers> // return;
my $peer  = $peers->{$key}        // return;

if ( ref $peer->{'timer'} ) {
    $peer->{'timer'}->cancel
        if $peer->{'timer'}->can('is_active')
        and $peer->{'timer'}->is_active;
    $peer->{'timer'} = undef;
}

if ( $result->{'mode'} eq qw| true | ) {
    $peer->{'ts'}      = $result->{'ts'} // $peer->{'ts'};
    $peer->{'backoff'} = 13;
    <[nameserv.sync.peer.arm]>->($key);
} else {
    <[nameserv.sync.peer.fail]>->(
        $key, $result->{'data'} // 'sync pull failed'
    );
}

return TRUE;

