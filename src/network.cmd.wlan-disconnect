# name  = network.cmd.wlan-disconnect
# param = [ <iface> ]
# descr = disconnect a wlan interface

my ( $iface, $error )
    = <[network.wlan.iface]>->( $call->{'args'} =~ s|\s+||gr );
return { qw| mode | => qw| false |, qw| data | => $error } if defined $error;
my $r = <[network.wlan.request]>->( qw| disconnect |, $iface );
return { qw| mode | => qw| false |, qw| data | => $r->{'error'} }
    if defined $r->{'error'};
<[base.logs]>->( 1, ': wlan-disconnect %s', $iface );
return { qw| mode | => qw| true |, qw| data | => "$iface disconnected" };

