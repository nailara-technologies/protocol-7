## [:< ##

# name  = X-11.cmd.get_display
# descr = return the server's X11-'display' address

return { 'mode' => qw| false |, 'data' => 'xorg access is not ready' }
    if <X-11.mode> eq qw| xorg |
    and not <X-11.servers>->{<X-11.primary_display>}->{'access_ready'};

return { 'mode' => qw| true |, 'data' => <X-11.display>->{<X-11.mode>} };

