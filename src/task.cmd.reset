## [:< ##

# name  = task.cmd.reset
# param = <task_id> [ expected_agent : task.claim_expire ]
# descr = reset a task back to pending state for retry

my $task_id = '';

## parse params
if ( defined $call->{'param'} and ref $call->{'param'} eq 'HASH' ) {
    $task_id = $call->{'param'}->{'id'} // '';

    ## a worker's own claim ttl expired [ models.task.claim-ok ] : only its ##
    ## still-active claim, counted -- failed after max_attempts expiries    ##
    my $expected_agent = $call->{'param'}->{'expected_agent'} // '';
    return <[task.claim_expire]>->(
        $task_id, sprintf( 'claim ttl of %s', $expected_agent ),
        $expected_agent
    ) if length $expected_agent and length $task_id;
} else {
    $task_id = $call->{'args'} // '';
}

$task_id = uc( substr( $task_id, 0, 7 ) );

return { 'mode' => 'false', 'data' => 'task id required' }
    unless length $task_id;

my $task = <task.queue>->{$task_id};

return {
    'mode' => 'false',
    'data' => sprintf( 'task %s not found', $task_id )
    }
    unless defined $task;

## can reset from claimed, done, or failed
if ( $task->{'status'} eq 'pending' ) {
    return {
        'mode' => 'false',
        'data' => sprintf( 'task %s is already pending', $task_id )
    };
}

## update task
my $ntime_b32 = <[base.ntime.b32]>;

$task->{'status'}     = 'pending';
$task->{'agent'}      = undef;
$task->{'updated_at'} = $ntime_b32;
## keep result for reference but mark as stale

## persist to disk
<[task.persist.save]>;

<[base.logs]>->( 1, ':. task %s reset to pending', $task_id );

return { 'mode' => 'true', 'data' => "reset $task_id" };

