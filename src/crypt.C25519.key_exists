## [:< ##

# name  = crypt.C25519.key_exists
# descr = check for C25519 key in user key dir [ 4 : virtual ]

my $name = shift;

if ( not defined $name ) {
    warn 'expected key name or filename parameter <{C1}>';
    return undef;
}

my $re_kfiles = <crypt.C25519.regex.key_files>;
if ( not defined $re_kfiles ) {
    warn 'regular expression for key file patterns not defined <{C1}>';
    return undef;
}

## the key file paths come from crypt.C25519.key_path [ user key dir or  ##
## root-held root/ -- a refused root-held key is undef, never 'absent' ] ##
my ( $key_name, $file_type );
if ( $name =~ m|\A(.+?)$re_kfiles\z| ) {    ## key filename syntax ##
    $key_name  = ${^CAPTURE}[0];
    $file_type = ${^CAPTURE}[1];
    $file_type =~ s|^[.:]||;
    $file_type = qw| virtual | if $file_type eq qw| seed-phrase |;
} else {    ## key name syntax ##
    $key_name = $name;
}

my $key_path_ref = <[crypt.C25519.key_path]>->($key_name);
return undef if ref $key_path_ref ne qw| HASH |;    ## [ logged ] ##
return undef
    if $key_path_ref->{'holder'} eq qw| user |
    and not -r $key_path_ref->{'key_dir'};

my $key_filename = $key_path_ref->{'key_filename'};
my $present = sub { my @st = CORE::lstat( $key_filename->{ shift() } ); @st };

return $present->($file_type) ? TRUE : FALSE if defined $file_type;

my @found
    = grep { $present->($ARG) } qw|  secret  private  public  virtual  |;

## key is virtual [ returning 4 ] ##
return 4 if @found == 1 and $found[0] eq qw| virtual |;

return TRUE if @found;    ##  true \ key found  ##

return FALSE;             ##  key with that name not present  ##

