## [:< ##

# name  = invoke-web.cmd.variant
# descr = list or switch the invoke.ai installs [ variants ]
# param = [ variant name ]

my $want = ( $call->{'args'} // '' ) =~ s{^\s+|\s+$}{}gr;

if ( length $want ) {
    my ( $ok, $msg ) = <[invoke-web.variant.select]>->($want);
    return { mode => $ok ? qw| size | : qw| false |, data => $msg };
}

my $set    = <invoke-web.variant_set>    // {};
my $active = <invoke-web.variant_active> // qw| default |;
my $out    = '';

## the main install first ##
my @names = ( qw| default |, sort grep { $ARG ne qw| default | } keys %$set );
foreach my $name (@names) {
    my $variant = $set->{$name};
    $out .= sprintf "%s %-10s %s\n%13s root   : %s\n",
        $name eq $active ? '*' : ' ',
        $name,
        $variant->{'descr'} // '',
        '', $variant->{'root'} // '?';
    $out .= sprintf "%13s binary : %s%s\n", '', $variant->{'binary'} // '?',
        $variant->{'ok'} ? '' : ' [ not usable ]';
}

return { mode => qw| size |, data => $out };

