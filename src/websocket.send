## [:< ##

# name  = websocket.send
# descr = encode and send a websocket text frame
# param = $sock  [ IO::Socket handle ]
# param = $text  [ utf-8 string payload ]
# return = bytes written, or undef on error

<[base.perlmod.load]>->(qw| Protocol::WebSocket::Frame |);

my $sock = shift // return undef;
my $text = shift // return 0;

## client-to-server frames must be masked per rfc6455
my $frame = Protocol::WebSocket::Frame->new(
    buffer => $text,
    type   => qw| text |,
    masked => 1
);

my $wire = $frame->to_bytes;
my $n    = $sock->syswrite($wire);

if ( not defined $n ) {
    <[base.logs]>->( 0, 'websocket.send: write error : %s', $OS_ERROR );
    return undef;
}

return $n;

