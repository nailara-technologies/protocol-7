## [:< ##

# name  = v7-zenki.parser.hold_until
# descr = when a terminate :hold: ends, for the hold list

my $zenka_name = shift;
my $until      = <v7-zenki.zenka.hold>->{$zenka_name}->{'until'} // 0;

return qw| released | if not $until;
return sprintf '%d s', $until - <[base.time]>;

