## [:< ##

# name  = power.wake.schedule_next
# param = { host, tries, last, state }
# descr = queue the next wake repeat round

## short, growing delays from the wake-fallback rhythm ##
my $job   = shift;
my $delay = <[base.interval.next]>->(
    { qw| type | => qw| wake-fallback |, qw| state | => $job->{'state'} } );
return FALSE if not defined $delay;
<[event.add_timer]>->(
    {   qw| after |   => $delay,
        qw| handler | => qw| power.handler.wake_next |,
        qw| data |    => $job
    }
);
return TRUE;

