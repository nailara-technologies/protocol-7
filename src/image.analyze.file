## [:< ##

# name   = image.analyze.file
# descr  = lightweight analysis of one image file, no vision model : core
#          ring tiles [ 1x1 .. 3x3 mean colors ], hsv of the 1x1 color,
#          luminance histogram \ clipping, entropy, sanity flags
# param  = path, [ file content as a scalar ref -- read once by the caller,
#          e.g. for a content checksum ; the path is then only a label ]
# return = hashref | undef [ unreadable, logged ] -- incl. 'text' : the png
#          text chunks [ key -> text, e.g. invokeai_metadata ]
# note   = shared layer [ images-elfdb-feature-collection.md ] : color wheel
#          angle, drift \ momentum, exposure, the render outcome check.
#          works on a downscaled copy [ max 256 px ] -- fast on full renders

## only once per process : called per image [ indexing, every render ], ##
## each autoload call logs a 'skipping already present' line            ##
<[base.perlmod.autoload]>->('Imager')     if not defined &Imager::new;
<[base.perlmod.autoload]>->('List::Util') if not defined &List::Util::max;

my $path     = shift // return undef;
my $data_ref = shift;

my $image = Imager->new;
my $read
    = ref $data_ref eq qw| SCALAR |
    ? $image->read( 'data' => $data_ref->$* )
    : $image->read( 'file' => $path );
if ( not $read ) {
    <[base.logs]>->( 1, 'image analyze : %s [ %s ]', $image->errstr, $path );
    return undef;
}

my ( $width, $height ) = ( $image->getwidth, $image->getheight );
my $bytes = ref $data_ref eq qw| SCALAR | ? length $data_ref->$* : -s $path
    // 0;

## png text chunks [ imager tags png_textN_key \ png_textN_text ] ##
my %text;
## no count tag : until a key is missing ##
for ( my $index = 0;; $index++ ) {
    my $key = $image->tags( 'name' => "png_text${index}_key" ) // last;
    $text{$key} = $image->tags( 'name' => "png_text${index}_text" ) // '';
}
$image = $image->convert( 'preset' => 'noalpha' )
    if $image->getchannels == 4
    or $image->getchannels == 2;
$image = $image->convert( 'preset' => 'rgb' ) if $image->getchannels == 1;

## working copy for the pixel statistics ##
my $work
    = ( $width > 256 or $height > 256 )
    ? $image->scale( 'xpixels' => 256, 'ypixels' => 256, 'type' => 'min' )
    : $image;

my %result = (
    'path'         => $path,
    'width'        => $width,
    'height'       => $height,
    'bytes'        => $bytes,
    'bytes_per_px' => $width * $height ? $bytes / ( $width * $height ) : 0,
    'text'         => \%text,
);

## core ring tiles : n x n mean colors [ 'mixing' averages all pixels ] ##
foreach my $n ( 1 .. 3 ) {
    my $tile = $work->scale(
        'xpixels' => $n,
        'ypixels' => $n,
        'type'    => 'nonprop',
        'qtype'   => 'mixing'
    );
    my @colors;
    foreach my $y ( 0 .. $n - 1 ) {
        foreach my $x ( 0 .. $n - 1 ) {
            my @rgb
                = ( $tile->getpixel( 'x' => $x, 'y' => $y )->rgba )[ 0 .. 2 ];
            push @colors, \@rgb;
        }
    }
    $result{'tiles'}->{$n} = \@colors;
}

## hsv of the 1x1 color : hue = the color wheel angle ##
my ( $red, $green, $blue )
    = map { $ARG / 255 } $result{'tiles'}->{1}->[0]->@*;
my $max   = List::Util::max( $red, $green, $blue );
my $min   = List::Util::min( $red, $green, $blue );
my $delta = $max - $min;
my $hue   = 0;
if ( $delta > 0 ) {
    $hue
        = $max == $red   ? 60 * ( $green - $blue ) / $delta
        : $max == $green ? 60 * ( ( $blue - $red ) / $delta + 2 )
        :                  60 * ( ( $red - $green ) / $delta + 4 );
    $hue += 360 if $hue < 0;
}
$result{'hsv'} = [ $hue, $max > 0 ? $delta / $max : 0, $max ];

## luminance : 256 bin histogram [ rec. 601 weights ] ##
my @hist = (0) x 256;
my ( $sum, $sum2, $count ) = ( 0, 0, 0 );
foreach my $y ( 0 .. $work->getheight - 1 ) {
    my @row = $work->getscanline( 'y' => $y );
    foreach my $pixel (@row) {
        my ( $pr, $pg, $pb ) = ( $pixel->rgba )[ 0 .. 2 ];
        my $luma = int( 0.299 * $pr + 0.587 * $pg + 0.114 * $pb + 0.5 );
        $hist[$luma]++;
        $sum  += $luma;
        $sum2 += $luma * $luma;
        $count++;
    }
}
my $mean   = $count ? $sum / $count                                 : 0;
my $spread = $count ? sqrt( abs( $sum2 / $count - $mean * $mean ) ) : 0;

my $entropy = 0;
foreach my $bin (@hist) {
    next if not $bin;
    my $p = $bin / $count;
    $entropy -= $p * log($p) / log(2);
}

my $low  = 0;
my $high = 0;
$low  += $hist[$ARG] for 0 .. 3;
$high += $hist[$ARG] for 252 .. 255;

$result{'luma'} = {
    'mean'         => $mean,
    'spread'       => $spread,
    'entropy'      => $entropy,    ## bits, 0 .. 8 ##
    'clipped_low'  => $count ? $low / $count  : 0,
    'clipped_high' => $count ? $high / $count : 0,
    'histogram'    => \@hist,
};

## sanity flags [ thresholds deliberately coarse -- they catch broken   ##
## renders, not style : deep blue \ blacklight images stay well above ] ##
my %flags;
$flags{'black'}        = TRUE if $mean < 8 and $spread < 4;
$flags{'flat'}         = TRUE if $entropy < 1.0;
$flags{'clipped_low'}  = TRUE if $result{'luma'}->{'clipped_low'} > 0.5;
$flags{'clipped_high'} = TRUE if $result{'luma'}->{'clipped_high'} > 0.5;
$flags{'tiny_file'}    = TRUE if $result{'bytes_per_px'} < 0.02;
$result{'flags'}       = \%flags;

return \%result;

