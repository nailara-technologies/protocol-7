## [:< ##

# name  = nameserv.sync.peer.handler.read
# descr = peer long-poll read : a TRUE wakes the pull, a drop re-arms

my $key = shift->w->data;

my $peers = <nameserv.sync.peers> // return;
my $peer  = $peers->{$key}        // return;

my $chunk = '';
my $bytes = <[base.s_read]>->( $peer->{'sock'}, \$chunk, 65536 );

if ( ( $bytes // -1 ) == -1 ) {
    <[nameserv.sync.peer.fail]>->(
        $key, sprintf 'read : %s',
        <[base.str.os_err]>
    );
    return;
}

if ( $bytes == 0 ) {    ## peer closed : reconnect with backoff ##
    <[nameserv.sync.peer.fail]>->( $key, 'peer closed connection' );
    return;
}

$peer->{'buf'} .= $chunk;

my @reply = ();
while ( $peer->{'buf'} =~ s|^([^\n]*)\n|| ) {
    my $line = $1;
    $line =~ s|\r$||;
    if ( $line eq qw| . | ) {
        <[nameserv.sync.peer.wakeup]>->( $key, \@reply );
        @reply = ();
    } else {
        push @reply, $line;
    }
}

return;

