## [:< ##

# name = httpsd.calculate_restart_delay
# descr = exponential backoff for certificate provisioning retries
# return = delay in seconds (capped at max_delay)

## exponential backoff: 10s, 20s, 40s, 80s, 160s, 320s, 640s...max 600s
my $attempt = <httpsd.startup.retry_count> // 0;

## formula: 10 * (2 ^ attempt)
my $delay     = 10 * ( 2**$attempt );
my $max_delay = <httpsd.cfg.max_retry_delay> // 600;    ## 10 minutes max

## cap at max_delay to prevent indefinite growth
if ( $delay > $max_delay ) {
    $delay = $max_delay;
}

<[base.logs]>->(
    2, 'httpsd startup retry attempt %d: backoff delay = %ds (max=%ds)',
    $attempt, $delay, $max_delay
);

return $delay;

0;

