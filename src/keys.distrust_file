## [:< ##

# name   = keys.distrust_file
# descr  = read \ write the local distrust list [ ~/.n/remote-keys/distrust ]
# param  = 'read'  -> ( { path, lines => [ raw lines ], fps => { fp => 1 } } )
#          'write' <lines arrayref> -> TRUE [ temp + rename, 0600, the
#                   previous list in the trash [ undo-remove distrust ] ]
# return = see param, or ( undef, reason )
#
# format [ auth.client.distrust_list ] : one key id per line, '#'
# comments. a malformed file is never rewritten [ every connect is
# refused until it is fixed by hand ].

my ( $mode, $lines ) = @ARG;

my ( $keys_dir, $dir_why ) = <[keys.remote_keys_dir]>->( undef, TRUE );
return ( undef, $dir_why ) if not defined $keys_dir;
my $path = catfile( $keys_dir, qw| distrust | );

if ( $mode eq qw| read | ) {
    my %fp;
    return ( { path => $path, lines => [], fps => \%fp } )
        if not -e $path and not -l $path;
    return ( undef, "not a plain " . "file [ $path ]" )
        if -l $path or not -f $path;
    open( my $fh, '<', $path ) or return ( undef, "not readable [ $path ]" );
    my @line = map {s|\n\z||r} readline($fh);
    close($fh);
    foreach my $line (@line) {
        ( my $entry = $line ) =~ s{#.*}{};
        $entry =~ s{\A\s+|\s+\z}{}g;
        next if not length $entry;
        return ( undef, "malformed line in $path -- fix it by hand" )
            if $entry !~ m|\A[A-Z2-7]{77}\z|;
        $fp{$entry} = 1;
    }
    return ( { path => $path, lines => \@line, fps => \%fp } );
}

return ( undef, 'mode not known' )   if $mode ne qw| write |;
return ( undef, 'lines not a list' ) if ref $lines ne qw| ARRAY |;

## the previous list goes to the trash [ undo-remove distrust ] ##
if ( -e $path ) {
    my ( $stashed, $stash_why )
        = <[keys.trash.stash]>
        ->( $path, qw| distrust |, qw| distrust |, TRUE );
    return ( undef, "previous list not stashed [ $stash_why ]" )
        if not defined $stashed;
}

require Fcntl;
my $tmp = sprintf qw| %s.%d.tmp |, $path, $PID;
my $fh;
sysopen(
    $fh,
    $tmp,
    Fcntl::O_WRONLY() | Fcntl::O_CREAT() | Fcntl::O_EXCL()
        | Fcntl::O_NOFOLLOW(),
    0600
) or return ( undef, "cannot write $tmp [ $OS_ERROR ]" );
my $written = print {$fh} map {"$ARG\n"} $lines->@*;
if ( not close($fh) or not $written or not rename( $tmp, $path ) ) {
    unlink($tmp);
    return ( undef, "cannot write $path" );
}
return TRUE;

