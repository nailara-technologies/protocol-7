## [:< ##

# name = v7-zenki.handler.heartbeat_response_timeout

my $event = shift;

my $instance_id = $event->w->data;

return $event->w->cancel    ##  not a valid instance entry  ##
    if not defined <v7-zenki.zenka.instance>->{$instance_id}
    or not defined <v7-zenki.zenka.instance>->{$instance_id}->{'status'};

my $instance = <v7-zenki.zenka.instance>->{$instance_id};

## host memory pressure [ v7-zenki.pressure ] : a zenka stalled in direct   ##
## reclaim is not hung -- restarting it adds memory demand and, for         ##
## invoke-web, kills invoke.ai with it. while the level is elevated \       ##
## critical, or the latest sample already crosses the critical avg10        ##
## [ the level needs 3 samples to follow a spike ], the timeout is extended ##
## instead of counted : up to heartbeat_ext.<level> times                   ##
my $level  = <v7-zenki.pressure.level>  // qw| calm |;
my $latest = <v7-zenki.pressure.latest> // {};
$level = qw| critical |
    if $level eq qw| calm |
    and ( $latest->{'mem_full_avg10'} // 0 )
    >= ( <v7-zenki.cfg.pressure.critical.mem_full_avg10> // 5.0 );

my $ext_max
    = $level eq qw| critical |
    ? <v7-zenki.cfg.pressure.heartbeat_ext.critical> // 6
    : $level eq qw| elevated |
    ? <v7-zenki.cfg.pressure.heartbeat_ext.elevated> // 3
    : 0;
my $hb = $instance->{'heartbeat'} //= {};
if ( $ext_max and ( $hb->{'pressure_ext'} // 0 ) < $ext_max ) {
    $hb->{'pressure_ext'}++;
    <[base.logs]>->(
        $hb->{'pressure_ext'} == 1 ? 1 : 2,
        'instance %d [ %s ] heartbeat late under '
            . '%s memory pressure -- waiting [ %d \ %d ]',
        $instance_id,
        $instance->{'zenka_name'},
        $level,
        $hb->{'pressure_ext'},
        $ext_max
    );
    $instance->{'timer'}->{'heartbeat-timeout'} = <[event.add_timer]>->(
        {   'after'   => <v7-zenki.cfg.pressure.heartbeat_ext.secs> // 17,
            'handler' => qw| v7-zenki.handler.heartbeat_response_timeout |,
            'data'    => $instance_id,
        }
    );
    return;
}

my $zenka_name    = $instance->{'zenka_name'};
my $zenka_status  = $instance->{'status'};
my $is_cube_zenka = $instance->{'is-cube'};
my $error_count   = $instance->{'heartbeat'}->{'errors'}++;

my $heartbeat_ref = $instance->{'heartbeat'} //= {};

delete $heartbeat_ref->{'retry_count'}
    if --$heartbeat_ref->{'retry_count'} < 0;

my $retry_count   = $heartbeat_ref->{'retry_count'} //= 0;
my $retry_timeout = $heartbeat_ref->{'retry_count'} //= 2.1;

( my $dots = qw| . | x ( $error_count % 3 ) ) =~ s|\.{3}$|..,|;
my $retry_str = $retry_count ? " , retrying $dots," : ' `:|';

my $hb_stats = <v7-zenki.stats.heartbeat>->{$instance_id} //= {};
$hb_stats->{'zenka_name'} = $zenka_name;    ##  list sort key  ##
$hb_stats->{'timeouts'}++;

<[base.logs]>->(
    $error_count == 1 ? '2:1' : 0,          ##  <-- log level  ##
    'instance %d [ %s ] response timeout%s',
    $instance_id, $zenka_name, $retry_str
);

if ( $retry_count <= 0 ) {    ## [ no further retries., ] ##
    $heartbeat_ref->{'retry_count'} = $heartbeat_ref->{'retry_reset'};
    if ($is_cube_zenka) {
        if ( $zenka_status eq qw| error | ) {    ##  once more not successful
            <callback.session.closing_last> = {
                'name'   => qw| v7-zenki.teardown |,
                'params' => [ 'fatal cube zenka error', undef, 1 ]
            };
            <[base.session.check_remaining]>;
        } else {
            delete <callback.session.closing_last>;  # allowing safe restart #
            <[zenka.change_status]>->( $instance_id, qw| error | );
        }
    } else {
        <[zenka.change_status]>->( $instance_id, qw| error | );
    }
} else {
    $instance->{'timer'}->{'heartbeat-timeout'}->cancel
        if defined $instance->{'timer'}->{'heartbeat-timeout'}
        and $instance->{'timer'}->{'heartbeat-timeout'}->is_active;

    ## decreasing heartbeat response timeout ., ##
    $retry_timeout = sprintf( qw| %.3f |, $retry_timeout / 2 );
    $retry_timeout = 0.7 if $retry_timeout < 0.7;
    $heartbeat_ref->{'retry_timeout'} = $retry_timeout;
    ##

    <[v7-zenki.stop_heartbeat_timer]>->($instance_id);

    $instance->{'timer'}->{'heartbeat-timeout'} = <[event.add_timer]>->(
        {   'handler' => qw| v7-zenki.handler.heartbeat_response_timeout |,
            'after'   => $heartbeat_ref->{'retry_timeout'},
            'data'    => $instance_id,
            'prio'    => 4
        }
    );

    <[v7-zenki.enable_heartbeat_timer]>->( $instance_id, 0 )
        ;    ##  retrying now [0]
}

