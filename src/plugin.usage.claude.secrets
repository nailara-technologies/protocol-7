## [:< ##

# name   = plugin.usage.claude.secrets
# descr  = the claude secret values [ for the leak check ]
# return = { kinds, files, secrets => [ [ kind, value ] ] }

## the values go to the caller only : never into %data or a log line ##

my @files = <[plugin.usage.claude.credential_files]>;
my @secrets;
foreach my $file (@files) {
    my $cred  = <[usage.credential_load]>->($file) // next;
    my $oauth = $cred->{'claudeAiOauth'};
    next if ref $oauth ne qw| HASH |;
    push @secrets, [ 'claude access', $oauth->{'accessToken'} ],
        [ 'claude refresh', $oauth->{'refreshToken'} ];
}

return {
    'kinds'   => [ 'claude access', 'claude refresh' ],
    'files'   => \@files,
    'secrets' => \@secrets,
};

