## [:< ##

# name  = p7-log.cmd.resolve-line
# param = <full anonymized log line>
# descr = resolve every [L:<checksum>] token in a log line

my $args = $call->{'args'} // '';

return { 'mode' => qw| false |, 'data' => 'usage : resolve-line <line>' }
    if not length $args;

my $reconstructed = <[p7-log.anon.resolve-line]>->($args);

return { 'mode' => qw| size |, 'data' => $reconstructed . "\n" };

