# name  = weather.current.util.format_current_widget
# descr = format current weather data as html widget

my ($data) = @ARG;

my $location    = $data->{location};
my $temp        = $data->{temperature};
my $feels_like  = $data->{feels_like};
my $description = $data->{description};
my $clouds      = $data->{clouds};
my $humidity    = $data->{humidity};
my $pressure    = $data->{pressure};
my $wind_speed  = $data->{wind_speed};
my $wind_dir    = $data->{wind_dir};

my $html = qq|
<div class="weather-current">
    <div class="weather-header">
        <div class="weather-location">$location</div>
        <div class="weather-updated">Updated: <span class="time-ago">just now</span></div>
    </div>

    <div class="weather-main">
        <div class="temp-display">
            <div class="temp-value">$temp°C</div>
            <div class="feels-like">Feels like $feels_like°C</div>
            <div class="weather-desc">$description</div>
        </div>

        <div class="weather-icon-container">
            <div class="weather-icon-glow"></div>
        </div>
    </div>

    <div class="weather-details">
        <div class="detail-row">
            <span class="detail-label">Cloudiness</span>
            <div class="detail-bar-container">
                <div class="detail-bar" style="width: ${clouds}%"></div>
            </div>
            <span class="detail-value">$clouds%</span>
        </div>

        <div class="detail-row">
            <span class="detail-label">Humidity</span>
            <div class="detail-bar-container">
                <div class="detail-bar humidity-bar" style="width: ${humidity}%"></div>
            </div>
            <span class="detail-value">$humidity%</span>
        </div>

        <div class="detail-row">
            <span class="detail-label">Pressure</span>
            <span class="detail-value">$pressure hPa</span>
        </div>

        <div class="detail-row">
            <span class="detail-label">Wind</span>
            <span class="detail-value">$wind_speed km/h $wind_dir</span>
        </div>
    </div>
</div>
|;

return $html;

