## [:< ##

# name = vision-batch.parent.persist
# descr = File-based persistence for batch state (stores in /tmp/vision-batch/)

<[base.perlmod.load]>->( 'JSON::XS',   qw| encode_json decode_json | );
<[base.perlmod.load]>->( 'File::Path', qw| make_path | );

my $cmd      = shift;
my $batch_id = shift;
my $data     = shift;

my $persist_dir = '/tmp/vision-batch';
make_path($persist_dir) unless -d $persist_dir;
my $batch_file = "$persist_dir/$batch_id.json";

if ( $cmd eq 'save' ) {

    # Save batch state to file
    return { success => FALSE, error => 'No data to save' }
        unless defined $data;

    my $json_str = JSON::XS::encode_json($data);
    open( my $fh, '>', $batch_file )
        or return {
        success => FALSE,
        error   => "Cannot write batch file $batch_file: $!"
        };
    print $fh $json_str;
    close($fh);

    return { success => TRUE, message => "Batch state saved to $batch_file" };

} elsif ( $cmd eq 'load' ) {

    # Load batch state from file
    return { success => FALSE, error => "Batch file not found: $batch_file" }
        unless -f $batch_file;

    open( my $fh, '<', $batch_file )
        or return {
        success => FALSE,
        error   => "Cannot read batch file $batch_file: $!"
        };
    my $json_str = do { local $/; <$fh> };
    close($fh);

    my $state;
    eval { $state = JSON::XS::decode_json($json_str); };
    return { success => FALSE, error => "Failed to parse JSON: $EVAL_ERROR" }
        if $EVAL_ERROR;

    return { success => TRUE, state => $state };

} elsif ( $cmd eq 'delete' ) {

    # Delete batch state file
    if ( -f $batch_file ) {
        unlink($batch_file)
            or return {
            success => FALSE,
            error   => "Cannot delete batch file: $!"
            };
    }
    return { success => TRUE, message => "Batch state deleted" };

} elsif ( $cmd eq 'list' ) {

    # List all batch files
    my @batches;
    opendir( my $dh, $persist_dir )
        or return {
        success => FALSE,
        error   => "Cannot read persist directory: $!"
        };
    while ( my $file = readdir($dh) ) {
        next unless $file =~ m|\.json$|;
        push @batches, $file;
    }
    closedir($dh);

    return {
        success => TRUE,
        batches => \@batches,
        count   => scalar(@batches)
    };

} else {
    return { success => FALSE, error => "Unknown command: $cmd" };
}

