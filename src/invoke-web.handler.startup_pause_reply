## [:< ##

# name  = invoke-web.handler.startup_pause_reply
# descr = async reply of the queue pause at ready [ invoke-web.start_paused ]
# note  = invoke.ai prints its 'running on' line shortly BEFORE its server
#         accepts connections : a refused connect is retried [ 2s, 10x ]

my $reply   = shift                           // {};
my $attempt = $reply->{'params'}->{'attempt'} // 1;

if (    not $reply->{'ok'}
    and ( $reply->{'status'} // '' ) =~ m|refused|i
    and $attempt < 10 ) {
    <[event.add_timer]>->(
        {   'after'   => 2,
            'handler' => 'invoke-web.handler.startup_pause_retry',
            'data'    => { 'attempt' => $attempt + 1 },
        }
    );
    return;
}

<[base.logs]>->(
    $reply->{'ok'} ? 1 : 0,
    'queue pause on startup : %s%s',
    $reply->{'ok'} ? 'done'                  : $reply->{'status'},
    $attempt > 1   ? " [ attempt $attempt ]" : ''
);

## paused [ or given up ] : the held items are dequeueable again ##
<[invoke-web.queue.release]>;

## restart of a recovery [ cuda error \ zenka crash ] : retry, resume ##
<[invoke-web.recover.requeue]>
    if $reply->{'ok'} and defined <invoke-web.recover>;

## start_paused = startup : the pause only covered the start -- resume now ##
## [ a recovery resumes through its own chain after the requeue ]          ##
<[invoke-web.api_async]>->(
    'PUT', '/api/v1/queue/default/processor/resume',
    undef, 'invoke-web.handler.startup_resume_reply'
    )
    if $reply->{'ok'}
    and not defined <invoke-web.recover>
    and <[invoke-web.start_paused]> eq qw| startup |;

