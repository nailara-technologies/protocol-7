## [:< ##

# name  = invoke-web.handler.startup_pause_reply
# descr = async reply of the queue pause at ready [ invoke-web.start_paused ]
# note  = invoke.ai prints its 'running on' line shortly BEFORE its server
#         accepts connections : a refused connect is retried [ 2s, 10x ]

my $reply   = shift                           // {};
my $attempt = $reply->{'params'}->{'attempt'} // 1;

if (    not $reply->{'ok'}
    and ( $reply->{'status'} // '' ) =~ m|refused|i
    and $attempt < 10 ) {
    <[event.add_timer]>->(
        {   'after'   => 2,
            'handler' => 'invoke-web.handler.startup_pause_retry',
            'data'    => { 'attempt' => $attempt + 1 },
        }
    );
    return;
}

<[base.logs]>->(
    $reply->{'ok'} ? 1 : 0,
    'queue pause on startup : %s%s',
    $reply->{'ok'} ? 'done'                  : $reply->{'status'},
    $attempt > 1   ? " [ attempt $attempt ]" : ''
);

## restart of a cuda error recovery : retry its items, then resume ##
<[invoke-web.gpu.requeue]>
    if $reply->{'ok'} and defined <invoke-web.gpu_recover>;

