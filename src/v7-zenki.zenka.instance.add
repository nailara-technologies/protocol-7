## [:< ##

# name  = v7-zenki.zenka.instance.add
# descr = register new zenka and return its id

my $zenka_id  = shift // '';
my $init_href = shift // {};    # optional initialization parameters

die "zenka id '$zenka_id' does not exist."
    if not exists <v7-zenki.zenka.setup>->{$zenka_id};

my $network_time = <[base.ntime]>->(3);
my $instance_id  = <[base.gen_id]>->(<v7-zenki.zenka.instance>);

<v7-zenki.zenka.instance>->{$instance_id} = {
    'zenka_id'     => $zenka_id,
    'zenka_name'   => <v7-zenki.zenka.setup>->{$zenka_id}->{'name'},
    'created'      => $network_time,
    'status-since' => $network_time,
    'status'       => qw| offline |
};

## apply optional initialization parameters (e.g., handover_expansion)
while ( my ( $key, $value ) = each %{$init_href} ) {
    <v7-zenki.zenka.instance>->{$instance_id}->{$key} = $value;
}

return $instance_id;

