## [:< ##

# name = httpd.event.remove_timer
# descr = remove a timer from the event loop

my $timer_id = shift;

# Simulate removing a timer
if ( exists $data{'event'}{'timer'}{$timer_id} ) {
    delete $data{'event'}{'timer'}{$timer_id};
    <[base.log]>->( 3, "HTTP : Removed timer $timer_id" );
    return TRUE;
} else {
    <[base.log]>->( 3, "HTTP : Timer $timer_id not found" );
    return FALSE;
}

