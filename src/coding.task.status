## [:< ##

# name = coding.task.status
# descr = get status of coding task
# purpose = coding task management : wrapper around jobqueue.get_job_data

my ($job_id) = @ARG;

return {
    success => FALSE,
    error   => 'job id required'
    }
    unless defined $job_id;

# get job data from jobqueue
my $job_data = <[jobqueue.get_job_data]>->($job_id);

return {
    success => FALSE,
    error   => "task not found : $job_id"
    }
    unless defined $job_data;

# map jobqueue status to coding task format
my %status_map = (
    queued    => 'pending',
    running   => 'in_progress',
    completed => 'completed',
    error     => 'failed',
    aborted   => 'failed',
    paused    => 'paused',
);

my $task_status = $status_map{ $job_data->{status} } // $job_data->{status};

return {
    success   => TRUE,
    job_id    => $job_id,
    task_id   => $job_data->{object_id},
    status    => $task_status,
    priority  => $job_data->{priority},
    queued_at => $job_data->{tstamp}->{queued},
    started   => $job_data->{tstamp}->{running},
    completed => $job_data->{tstamp}->{completed},
};

