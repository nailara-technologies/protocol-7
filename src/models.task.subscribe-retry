# name  = models.task.subscribe-retry
# descr = schedule a zenka's next subscribe [ backoff ]
# note  = schedule the next notice stream subscribe of one task zenka
#         [ doubling backoff ]
# param = <zenka>
# notes = 30 s, doubling up to 300 s ; reset by a registered stream
#         [ models.handler.task-stream ]. the poll tick does the retry

my $zenka = shift // '';

my $state = <models.task.streams>->{$zenka} //= {};

my $delay = $state->{'delay'} // 30;

$state->{'retry_at'} = time + $delay;
$state->{'delay'}    = $delay * 2 > 300 ? 300 : $delay * 2;

<[base.logs]>->(
    2,      ': task notice stream %s : next subscribe in %d s',
    $zenka, $delay
);

return $delay;

