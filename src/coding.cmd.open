## [:< ##

# name  = coding.cmd.open
# descr = list the open decisions [ coding.ask questions ]

return <[coding.decision.send]>->(
    qw| pending-question-list |,
    qw| decisions |,
    $call->{'reply_id'}, qw| open |
);

