## [:< ##

# name  = invoke-web.cmd.ref-scale
# descr = scale references in pending jobs and upload copies
# param = <id ..|*|last=n> [ refs=<n,..|image_name|all> ]
#         <ref_scale=f|ref_max=px> [ :dry-run: ] [ :resume: ]
# note  = repeat with refs=<n> for a different scale on another reference ;
#         without this command every reference stays at its original size

my $args   = $call->{'args'} // '';
my $dry    = $args =~ s{\s*:dry-run:}{}g;
my $resume = $args =~ s{\s*:resume:}{}g;
my $usage  = 'ref-scale <id ..|*|last=n> [ refs=<n,..|image_name|all> '
    . '] <ref_scale=f|ref_max=px> [ :dry-run: ] [ :resume: ]';

my ( $scale, $max, $selector, @item_ids, $every, $last );
foreach my $token ( grep {length} split m{\s+}, $args ) {
    if ( $token =~ m{^ref_scale=(.+)$} ) {
        $scale = $1;
    } elsif ( $token =~ m{^ref_max=(.+)$} ) {
        $max = $1;
    } elsif ( $token =~ m{^refs=(.+)$} ) {
        $selector = $1;
    } elsif ( $token =~ m{^items?=([\d,]+)$} ) {
        push @item_ids, split m{,}, $1;
    } elsif ( $token =~ m{^\d+$} ) {
        push @item_ids, $token;
    } elsif ( $token eq qw| * | ) {    ## every pending job ##
        $every = TRUE;
    } elsif ( $token =~ m|^last=([1-9]\d{0,4})$| ) {    ## the newest n ##
        $last = $1;
    } else {
        return { mode => qw| false |, data => $usage };
    }
}
return { mode => qw| false |, data => $usage }
    if ( not @item_ids and not $every and not defined $last )
    or defined $scale == defined $max;
$selector //= qw| all |;
my %seen_id;
@item_ids = sort { $a <=> $b } grep { not $seen_id{$ARG}++ } @item_ids;

my $dbh = <[invoke-web.queue.db]>
    // return { mode => qw| false |, data => 'queue db not available' };
my %select = ( 'every' => $every // FALSE );
$select{'items'} = \@item_ids if @item_ids;
$select{'last'}  = $last      if defined $last;
my $selection = <[invoke-web.queue.select]>->( $dbh, \%select );
return { mode => qw| false |, data => $selection->{'error'} }
    if exists $selection->{'error'};
my $rows = $selection->{'rows'};

my ( @plans, %wanted_name );
foreach my $row (@$rows) {
    my $session = $row->{'decoded_session'};
    my $nodes   = $session->{'graph'}->{'nodes'};

    my @ref_nodes = map { $nodes->{$ARG} } sort grep {
                $ARG =~ m{^qwen_ref_img:}
            and ( $nodes->{$ARG}->{'type'} // '' ) eq qw| image |
            and defined $nodes->{$ARG}->{'image'}->{'image_name'}
    } keys %$nodes;
    @ref_nodes = map { $nodes->{$ARG} } sort grep {
        $ARG =~ m{^qwen_ref_img_for_vae:}
            and defined $nodes->{$ARG}->{'image'}->{'image_name'}
        } keys %$nodes
        if not @ref_nodes;
    return {
        mode => qw| false |,
        data => "item $row->{'item_id'} : no qwen reference images"
        }
        if not @ref_nodes;

    ## the model decides the rule : qwen-image 2.1 keeps its reference ##
    ## dimensions, older qwen-image shrinks them, others are refused   ##
    my ($loader)
        = grep { ( $ARG->{'type'} // '' ) eq qw| qwen_image_model_loader | }
        values %$nodes;
    my $model_name
        = lc( ( ( $loader // {} )->{'model'} // {} )->{'name'} // '' );
    return {
        mode => qw| false |,
        data => "item $row->{'item_id'} : not a qwen-image job [ refused ]"
        }
        if not defined $loader;
    my $qwen21
        = $model_name =~ m{(?:^|[^\d])2[._-]?1(?:[^\d]|$)} ? TRUE : FALSE;

    my ( @references, %by_name );
    foreach my $node (@ref_nodes) {
        my $name = $node->{'image'}->{'image_name'};
        next if $by_name{$name};
        $by_name{$name} = TRUE;
        push @references,
            {
            'index' => scalar(@references) + 1,
            'name'  => $name,
            };
    }
    my @selected;
    if ( $selector eq qw| all | ) {
        @selected = @references;
    } else {
        my %wanted = map { $ARG => TRUE } split m{,}, $selector;
        @selected
            = grep { $wanted{ $ARG->{'index'} } or $wanted{ $ARG->{'name'} } }
            @references;
        return {
            mode => qw| false |,
            data => "item $row->{'item_id'} : no matching references"
            }
            if not @selected;
    }
    push @plans,
        {
        'item_id'    => $row->{'item_id'},
        'session'    => $session,
        'references' => \@selected,
        'qwen21'     => $qwen21,
        };
    $wanted_name{ $ARG->{'name'} } = TRUE for @selected;
}

my %scaled;
foreach my $name ( sort keys %wanted_name ) {
    my $result = <[invoke-web.ref.scale]>->(
        {   'image_name' => $name,
            'dbh'        => $dbh,
            'ref_scale'  => $scale,
            'ref_max'    => $max,
            'dry_run'    => $dry,
        }
    );
    return {
        mode => qw| false |,
        data => $result->{'error'} // "reference scale failed [ $name ]"
        }
        if not $result->{'ok'};
    $scaled{$name} = $result;
}

my @output;
foreach my $plan (@plans) {
    foreach my $reference ( $plan->{'references'}->@* ) {
        my $name   = $reference->{'name'};
        my $result = $scaled{$name};
        push @output,
            sprintf(
            "item %d ref %d : %s  %dx%d -> %dx%d%s\n",
            $plan->{'item_id'},
            $reference->{'index'},
            $name,
            $result->@{qw| width height new_width new_height |},
            $dry                     ? " [ $result->{'key'} ]"
            : $result->{'unchanged'} ? ' [ original ]'
            :                          " [ $result->{'image_name'} ]"
            );
    }
}

my @updates;
if ( not $dry ) {
    my ( $replace_images, $keep_dims );
    $replace_images = sub {
        my ($value) = @_;
        if ( ref $value eq qw| HASH | ) {
            my $old_name = $value->{'image_name'} // '';
            if ( exists $scaled{$old_name}
                and not $scaled{$old_name}->{'unchanged'} ) {
                my $result = $scaled{$old_name};
                $value->{'image_name'} = $result->{'image_name'};
                if (not $keep_dims
                    and
                    ( exists $value->{'width'} or exists $value->{'height'} )
                ) {
                    $value->{'width'}  = $result->{'new_width'};
                    $value->{'height'} = $result->{'new_height'};
                }
            }
            $replace_images->($ARG) for values %$value;
        } elsif ( ref $value eq qw| ARRAY | ) {
            $replace_images->($ARG) for @$value;
        }
    };

    foreach my $plan (@plans) {
        my $session = $plan->{'session'};
        my $nodes   = $session->{'graph'}->{'nodes'};
        my $changed = FALSE;
        foreach my $name ( map { $ARG->{'name'} } $plan->{'references'}->@* )
        {
            $changed = TRUE if not $scaled{$name}->{'unchanged'};
        }
        next if not $changed;

        ## per model : qwen-image 2.1 sizes every reference to the text \  ##
        ## vision encoder's ~1024x1024 area and its pad tokens must match  ##
        ## the vae latents -- shrunk i2l dimensions fail with a shape      ##
        ## mismatch [ 2026-11-28 ]. there only the image is swapped        ##
        ## [ a softer reference, no speed-up ]. older qwen-image caps at   ##
        ## 1024 and keeps smaller sizes : dimensions shrink with the image ##
        $keep_dims = $plan->{'qwen21'};
        foreach my $edge ( ( $session->{'graph'}->{'edges'} // [] )->@* ) {
            last if $keep_dims;
            my $source = $edge->{'source'}->{'node_id'}      // '';
            my $target = $edge->{'destination'}->{'node_id'} // '';
            next
                if not exists $nodes->{$source}
                or not exists $nodes->{$target}
                or ref $nodes->{$source}->{'image'} ne qw| HASH |;
            my $name = $nodes->{$source}->{'image'}->{'image_name'} // '';
            next
                if not exists $scaled{$name}
                or $scaled{$name}->{'unchanged'}
                or ( $nodes->{$target}->{'type'} // '' ) ne
                qw| qwen_image_i2l |;
            $nodes->{$target}->{'width'}  = $scaled{$name}->{'new_width'};
            $nodes->{$target}->{'height'} = $scaled{$name}->{'new_height'};
        }
        $replace_images->($session);
        push @updates,
            {
            'item_id' => $plan->{'item_id'},
            'session' => <[format.json.encode]>->($session),
            };
    }
}

if ($dry) {
    push @output, sprintf "[ dry run : %d item%s, no uploads or writes ]\n",
        scalar @plans, @plans == 1 ? '' : 's';
    return { mode => qw| size |, data => join '', @output };
}
return { mode => qw| size |, data => join( '', @output, "no changes\n" ) }
    if not @updates;

my $written = <[invoke-web.queue.write]>->(
    $dbh,
    \@updates,
    qw| ref-scale |,
    {   'backup'   => 'reference backup failed',
        'rollback' => 'reference update rolled back',
    }
);
return { mode => qw| false |, data => $written->{'error'} }
    if exists $written->{'error'};
my $backup = $written->{'backup'};
<[base.logs]>->(
    1,
    'queue : scaled references [ %d items, %d refs, backup %s ]',
    scalar @updates,
    scalar @output, $backup
);
push @output, sprintf "%d item%s updated\nbackup : %s\n", scalar @updates,
    @updates == 1 ? '' : 's', $backup;
## :resume: : the queue processor runs again once the change is written ##
if ($resume) {
    my $resumed = <[invoke-web.api]>->(
        'PUT', '/api/v1/queue/defau' . 'lt/processor/resume'
    );
    push @output, $resumed->{'ok'}
        ? "queue resumed\n"
        : sprintf( "queue NOT resumed [ %s ]\n",
        $resumed->{'status'} // '-' );
}
return { mode => qw| size |, data => join '', @output };

