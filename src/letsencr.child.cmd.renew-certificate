## [:< ##

# name  = letsencr.child.cmd.renew-certificate
# param = <domain>
# descr = renew certificate for domain from Let's Encrypt

## $call is provided by compiled-in code header
my $domain = $call->{'args'};

return {
    'mode' => qw| false |,
    'data' => 'domain parameter required'
    }
    unless defined $domain && length($domain);

<[base.logs]>->( 2, 'child : renewing certificate for domain : %s', $domain );

## Get certificate info and retry attempt from parameters
my $cert_info     = $call->{'param'}{'cert_info'}     // {};
my $retry_attempt = $call->{'param'}{'retry_attempt'} // 0;
my $alt_names     = $call->{'param'}{'alt_names'}     // [];

if ($retry_attempt) {
    <[base.logs]>->( 2, ':. retry attempt : %d', $retry_attempt );
}

## Build domains list (primary + alt names)
my @domains = ($domain);
push @domains, @$alt_names if ref($alt_names) eq qw| ARRAY | && @$alt_names;

## Get admin email from config or parameters
my $email = $call->{'param'}{'email'} || <letsencr.admin.email>;

## Substitute :requested-domain: keyword with primary domain
$email = <[letsencr.child.substitute_admin_email]>->( $email, \@domains );

<[base.log]>->( 2, "  domains : " . join( ', ', @domains ) );

## acme order on the event loop [ letsencr.child.acme.* ] : the bundle comes
## later via reply_id [ mode size ], a refusal now [ mode false ]
return <[letsencr.child.acme.begin]>->(
    {   'domains'  => \@domains,
        'email'    => $email,
        'reply_id' => $call->{'reply_id'},
        'label'    => "$domain [ renewal ]",
    }
);

