## [:< ##

# name  = jobsite.store.prune
# descr = two-phase prune: blocked->deleted, deleted->gone, with checksum backfill

my $jobs_root = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite jobs |;

my $current_epoch = int(<[base.ntime.epoch_dec]>);
my $trash_keep    = <jobsite.cfg.trash_keep_epochs>   // 1;
my $deleted_keep  = <jobsite.cfg.deleted_keep_epochs> // 2;
my ( $trash_moved, $blocked_moved, $deleted_pruned ) = ( 0, 0, 0 );

## phase 0: trash -> deleted (epoch distance > trash_keep_epochs) ##
my $trash_root = "$jobs_root/trash";
if ( -d $trash_root ) {
    opendir my $dh, $trash_root or goto PHASE1;
    my @epoch_dirs = grep { !m|^\.| && -d "$trash_root/$_" } readdir($dh);
    closedir $dh;

    for my $ep_dir (@epoch_dirs) {
        next unless $ep_dir =~ m|^V7[A-Z2-7]{5}$|i;
        my $ep_num = <[base.ntime.epoch_timestamp]>->($ep_dir);
        next unless defined $ep_num and $ep_num =~ m{^\d+$};
        my $distance = $current_epoch - $ep_num;
        next if $distance <= $trash_keep;

        my $src_dir = "$trash_root/$ep_dir";
        my $dst_dir = "$jobs_root/deleted/$ep_dir";

        if ( not -d $dst_dir ) {
            my $p7_user = <system.amos-zenka-user> // qw| protocol-7 |;
            <[file.make_path]>->( $dst_dir, 0750, $p7_user, $p7_user );
        }

        opendir my $edh, $src_dir or next;
        my @stubs = grep { m|\.yxz\.B32$| && !m|^\.| } readdir($edh);
        closedir $edh;

        for my $stub_fn (@stubs) {
            my $stub_path = "$src_dir/$stub_fn";
            my $raw       = eval {
                local $/;
                open my $fh, '<', $stub_path or die $!;
                <$fh>;
            };
            next unless defined $raw;

            my $compressed = <[base32.decode]>->($raw);
            if ( not defined $compressed ) {
                <[base.logs]>->(
                    0, 'prune: base32 decode failed for %s', $stub_path
                );
                next;
            }
            my $yaml;
            IO::Uncompress::UnXz::unxz( \$compressed, \$yaml )
                or do {
                <[base.logs]>->(
                    0,          'prune: xz decompress failed for %s : %s',
                    $stub_path, $IO::Uncompress::UnXz::UnXzError
                );
                next;
                };

            my $job = eval { YAML::XS::Load($yaml) };
            next unless ref $job eq 'HASH';

            my $enc_id = $stub_fn;
            $enc_id =~ s|\.yxz\.B32$||;
            my $job_id = <[base.vax-int.decode]>->($enc_id);

            $job->{'status'} = 'deleted';
            $job->{'stage'}  = 'deleted' if length( $job->{'stage'} // '' );
            $job->{'deleted_epoch'} //= $ep_dir;
            delete $job->{'trash_epoch'};

            my $out_yaml;
            eval { $out_yaml = YAML::XS::Dump($job) };
            next if $@;

            my $dst_fn   = "$enc_id.yaml";
            my $dst_path = "$dst_dir/$dst_fn";
            my $wrote    = <[file.zenka_dir.write]>->(
                "jobs/deleted/$ep_dir/$dst_fn",
                \$out_yaml, '>', 0640
            );
            next unless defined $wrote;

            unlink $stub_path;
            $trash_moved++;

            ## keep in-memory index consistent ##
            <jobsite.job.index>->{$job_id} = "deleted:$ep_dir"
                if length $job_id;
        }

        rmdir $src_dir;
        <[base.logs]>->( 1, 'prune: moved trash/%s to deleted/', $ep_dir );
    }
}

PHASE1:

## phase 1: blocked -> deleted (epoch distance > 0) ##
my $blocked_root = "$jobs_root/blocked";
if ( -d $blocked_root ) {
    opendir my $dh, $blocked_root or goto PHASE2;
    my @epoch_dirs = grep { !m|^\.| && -d "$blocked_root/$_" } readdir($dh);
    closedir $dh;

    for my $ep_dir (@epoch_dirs) {
        next unless $ep_dir =~ m|^V7[A-Z2-7]{5}$|i;
        my $ep_num = <[base.ntime.epoch_timestamp]>->($ep_dir);
        next unless defined $ep_num and $ep_num =~ m{^\d+$};
        my $distance = $current_epoch - $ep_num;
        next if $distance <= 0;

        my $src_dir = "$blocked_root/$ep_dir";
        my $dst_dir = "$jobs_root/deleted/$ep_dir";

        if ( not -d $dst_dir ) {
            my $p7_user = <system.amos-zenka-user> // qw| protocol-7 |;
            <[file.make_path]>->( $dst_dir, 0750, $p7_user, $p7_user );
        }

        opendir my $edh, $src_dir or next;
        my @stubs = grep { m|\.yaml$| && !m|^\.| } readdir($edh);
        closedir $edh;

        for my $stub_fn (@stubs) {
            my $stub_path = "$src_dir/$stub_fn";
            my $stub      = eval { YAML::XS::LoadFile($stub_path) };
            next unless ref $stub eq 'HASH';

            my $url        = $stub->{'url'}          // '';
            my $hit        = $stub->{'checksum_hit'} // '';
            my $store_root = catdir( <system.path.zenka-dirs.var_P7>,
                <system.zenka.name>, 'checksum-store' );

            if ( $hit =~ m{^title:([A-Z2-7]+)$} ) {
                my $t_sum   = $1;
                my $t_found = 0;
                if ( opendir my $tdh, "$store_root/titles" ) {
                    for my $st ( grep { !m|^\.| } readdir($tdh) ) {
                        if ( -e "$store_root/titles/$st/$t_sum" ) {
                            $t_found = 1;
                            last;
                        }
                    }
                    closedir $tdh;
                }
                if ( not $t_found ) {
                    my $empty = '';
                    <[file.zenka_dir.write]>->(
                        "checksum-store/titles/assessed/$t_sum",
                        \$empty, '>', 0640
                    );
                }
            }

            if ( length $url ) {
                utf8::encode( my $url_bytes = $url );
                my $u_sum = <[chk-sum.bmw.str-b32.L13]>->($url_bytes);
                if ( length $u_sum
                    and not -e "$store_root/urls/$ep_dir/$u_sum" ) {
                    my $empty = '';
                    <[file.zenka_dir.write]>->(
                        "checksum-store/urls/$ep_dir/$u_sum",
                        \$empty, '>', 0640
                    );
                }
            }

            my $dst_path = "$dst_dir/$stub_fn";
            if ( rename $stub_path, $dst_path ) {
                $blocked_moved++;
            } else {
                <[base.logs]>->(
                    0, 'prune: rename %s -> %s failed: %s',
                    $stub_path, $dst_path, $!
                );
            }
        }

        rmdir $src_dir;
        <[base.logs]>->( 1, 'prune: moved blocked/%s to deleted/', $ep_dir );
    }
}

PHASE2:

## phase 2: deleted -> gone (epoch distance > deleted_keep_epochs) ##
my $deleted_root = "$jobs_root/deleted";
if ( -d $deleted_root ) {
    opendir my $dh, $deleted_root or goto DONE;
    my @epoch_dirs = grep { !m|^\.| && -d "$deleted_root/$_" } readdir($dh);
    closedir $dh;

    for my $ep_dir (@epoch_dirs) {
        next unless $ep_dir =~ m|^V7[A-Z2-7]{5}$|i;
        my $ep_num = <[base.ntime.epoch_timestamp]>->($ep_dir);
        next unless defined $ep_num and $ep_num =~ m{^\d+$};
        my $distance = $current_epoch - $ep_num;
        next if $distance <= $deleted_keep;

        my $dir = "$deleted_root/$ep_dir";
        opendir my $edh, $dir or next;
        for my $fn ( grep { !m|^\.| } readdir($edh) ) {
            my $full   = "$dir/$fn";
            my $enc_id = $fn;
            $enc_id =~ s{\.(yaml|yxz\.B32)$}{};
            my $job_id = <[base.vax-int.decode]>->($enc_id);
            unlink $full;
            delete <jobsite.job.index>->{$job_id}
                if length $job_id;
        }
        closedir $edh;
        rmdir $dir;
        $deleted_pruned++;
        <[base.logs]>->( 1, 'prune: removed deleted/%s', $ep_dir );
    }
}

DONE:

<[base.logs]>->(
    1, 'jobsite.store.prune: trash_moved=%d blocked_moved=%d pruned=%d',
    $trash_moved, $blocked_moved, $deleted_pruned
);

return {
    'trash_moved'    => $trash_moved,
    'blocked_moved'  => $blocked_moved,
    'deleted_pruned' => $deleted_pruned,
};

