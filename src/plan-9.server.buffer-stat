## [:< ##
# name  = plan-9.server.buffer-stat
# descr = Get stat info for buffer entries

my ($f) = @ARG;

my %stat = (
    type  => 0,
    dev   => 0,
    atime => time,
    mtime => time,
    uid   => 'root',
    gid   => 'root',
    muid  => 'root',
);

if ( $f->{type} eq 'root' ) {
    $stat{qid_type}    = <plan-9.protocol.constants.QTDIR>;
    $stat{qid_version} = 0;
    $stat{qid_path}    = 0;
    $stat{mode}        = 0755 | <plan-9.protocol.constants.DMDIR>;
    $stat{name}        = '/';
    $stat{length}      = 0;
} elsif ( $f->{type} eq 'buffer' ) {
    my $buf = <plan-9.server.buffers>->{ $f->{name} };
    $stat{qid_type}    = <plan-9.protocol.constants.QTDIR>;
    $stat{qid_version} = $buf->{qid_version} // 0;
    $stat{qid_path}    = $buf->{qid_path}    // 0;
    $stat{mode}        = 0755 | <plan-9.protocol.constants.DMDIR>;
    $stat{name}        = $f->{name};
    $stat{length}      = 0;
} elsif ( $f->{type} eq 'layer' ) {
    my $buf = <plan-9.server.buffers>->{ $f->{buffer} };
    $stat{qid_type}    = <plan-9.protocol.constants.QTFILE>;
    $stat{qid_version} = 0;
    $stat{qid_path}    = ( $buf->{qid_path} // 0 ) + $f->{z} + 1;
    $stat{mode}        = 0644;
    $stat{name}        = "z-" . $f->{z};
    my $layer_data = $buf->{window}{buffer}{layers}[ $f->{z} ] // '';
    $stat{length} = length($layer_data);
} elsif ( $f->{type} eq 'metadata' ) {
    my $buf = <plan-9.server.buffers>->{ $f->{buffer} };
    $stat{qid_type}    = <plan-9.protocol.constants.QTFILE>;
    $stat{qid_version} = 0;
    $stat{qid_path}    = ( $buf->{qid_path} // 0 ) + 100;
    $stat{mode}        = 0644;
    $stat{name}        = 'metadata';
    $stat{length}      = 1024;
} elsif ( $f->{type} eq 'realpath' ) {

    ## bin/Protocol-7 does 'use File::stat' globally : shadows the builtin ##
    ## ; use the OO form like the rest of P7 does                          ##
    my $st     = File::stat::stat( $f->{realpath} );
    my $is_dir = -d $f->{realpath};
    my ($base) = $f->{realpath} =~ m{([^/]+)/?$};
    $stat{qid_type}    = $f->{qid}{type};
    $stat{qid_version} = $f->{qid}{version};
    $stat{qid_path}    = $f->{qid}{path};
    $stat{mode}
        = $is_dir ? ( 0755 | <plan-9.protocol.constants.DMDIR> ) : 0644;
    $stat{name}   = $base // '/';
    $stat{length} = $is_dir ? 0          : ( $st ? $st->size : 0 );
    $stat{atime}  = $st     ? $st->atime : time;
    $stat{mtime}  = $st     ? $st->mtime : time;
}

return \%stat;

