## [:< ##

# name = v7-zenki.compile_bin_p7c

my $bin_p7c_src_path = sprintf qw| %s/%s |, <system.root_path>,
    <system.bin_p7c_src_path>;
my $strip_bin_p7c_path = <[file.which]>->(qw| strip |);
my $compile_static
    = <[base.cfg_bool]>->( <v7-zenki.cfg.bin_p7c_static> // TRUE );
my $gcc_timeout  = <v7-zenki.gcc_timeout> || 7;
my $p7c_bin_path = <v7-zenki.cfg.p7c_bin_path>;
my $gcc_bin      = <v7-zenki.gcc_bin>;
die "<< 'gcc' binary not found >>"              if !-x $gcc_bin;
die "source file '$bin_p7c_src_path' not found" if !-f $bin_p7c_src_path;

( my $src_name = $bin_p7c_src_path ) =~ s|^.+./||;

<[base.log]>
    ->( 0, ":. compiling '$src_name' source onto '$p7c_bin_path'..," );

## reading source., ##
<[file.slurp]>->( $bin_p7c_src_path, \my $bin_p7c_source )
    or die "cannot compile '$src_name' << ! >>";

my $p7c_checksum = <v7-zenki.checksum.bin_p7c_source>
    // <[chk-sum.bmw.filesum]>->( 224, $bin_p7c_src_path );
$bin_p7c_source =~ s|\[BMW_FILE_CHkSUM\]|$p7c_checksum|g;

my $tmp_bin    = "$p7c_bin_path.$p7c_checksum";
my @gcc_params = $compile_static ? ('-static') : ();
push( @gcc_params, qw| -O3 -x c -o |, $tmp_bin, '-' );

unlink($tmp_bin) or die "< unlink > $tmp_bin [ \l$OS_ERROR ]" if -f $tmp_bin;

## save and ignore SIGCHLD during gcc compilation  so gcc's child processes
## (assembler, linker, etc.) don't trigger zenka SIGCHLD handler
my $orig_sigchld = $SIG{'CHLD'};
$SIG{'CHLD'} = 'IGNORE';

## compiling.., ###
my $gcc_in_fh  = IO::Handle->new();
my $gcc_err_fh = IO::Handle->new();
my $gcc_pid = open3( $gcc_in_fh, undef, $gcc_err_fh, $gcc_bin, @gcc_params )
    or die "<< ! >> compilation failed [ \l$OS_ERROR ] << ! >>\n";
print {$gcc_in_fh} $bin_p7c_source if $gcc_in_fh->opened;
close($gcc_in_fh)                  if $gcc_in_fh->opened;

## timeout., ###
if ( defined $gcc_pid ) {
    local $SIG{'ALRM'} = sub {
        warn "'p7c' compilation timed out after $gcc_timeout seconds.";
        kill( 9, $gcc_pid );
    };
    alarm($gcc_timeout);
    <[base.waitpid]>->( $gcc_pid, 0 );
    alarm(0);
}

## restore original SIGCHLD handler after gcc compilation completes
$SIG{'CHLD'} = $orig_sigchld;

qx| $strip_bin_p7c_path -R .comment $tmp_bin |
    if length($strip_bin_p7c_path);    # optional ##

## verify.., ##
if ( -f $tmp_bin ) {
    close($gcc_err_fh) if $gcc_err_fh->opened;
    rename( $tmp_bin, $p7c_bin_path )
        or die "< rename > $tmp_bin --> $p7c_bin_path [ \l$OS_ERROR ]";
    chmod( 0755, $p7c_bin_path )
        or die "< chmod > $p7c_bin_path [ \l$OS_ERROR ]";
    <[base.log]>->( 1, ":: :. successfully installed to '$p7c_bin_path'. =)" )
        and return TRUE
        if <[v7-zenki.bin_p7c_chksum_current]>->(2)
        ;    # <-- silent chksum verification
} else {
    ( my $err_str = join( '', $gcc_err_fh->getlines ) )
        =~ s{gcc: (fatal )?error: |\n+}{ }g;
    $err_str =~ s|  +| \\ |g;
    $err_str =~ s{^ \\|\\? +$}{}g;
    $err_str = join( ' ', '', @gcc_params ) if not length $err_str;
    $err_str =~ s{^ +| +$}{}g;
    <[base.log]>->( 0, ":: : no success. << $gcc_bin $err_str >>" );
}
return FALSE;

