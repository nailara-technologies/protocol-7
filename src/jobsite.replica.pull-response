## [:< ##

# name  = jobsite.replica.pull-response
# descr = validate primary jobs json and replace the local web cache

my $result = shift // {};
## clients.https hands the body over character-decoded, clients.http as  ##
## octets : decode_json on characters dies on anything above U+00FF      ##
## [ typographic quotes, dashes, euro in job texts : every pull failed ] ##
my $payload = $result->{'ok'}
    ? eval {
    my $raw = $result->{'body'} // '';
    JSON::XS->new->utf8( utf8::is_utf8($raw) ? 0 : 1 )->decode($raw);
    }
    : undef;

if ( ref $payload ne 'HASH' or ref $payload->{'jobs'} ne 'ARRAY' ) {
    <[jobsite.replica.complete]>->(FALSE);
    return;
}

## a ui action went to the primary after this pull left : its set may ##
## predate the action and would undo it locally -- pull again         ##
if ( ( <jobsite.replica.forward_seq> // 0 ) != <jobsite.replica.pull_seq> ) {
    <[jobsite.replica.complete]>->(TRUE);
    <[jobsite.replica.pull_soon]>;
    return;
}

my $body = eval {
    JSON::XS::encode_json(
        { 'role' => qw| replica |, 'jobs' => $payload->{'jobs'} } );
} // '';
if ( not length $body ) {
    <[jobsite.replica.complete]>->(FALSE);
    return;
}

<[clients.http.post]>->(
    {   'url'     => qw| http://127.0.0.1/jobs-sync |,
        'body'    => $body,
        'timeout' => 32,
        'on_done' => qw| jobsite.replica.local-response |,
    }
);

