## [:< ##

# name  = cred-mesh.ui.interactive.refresh
# descr = re-render the active credential-fabric ui view

my $call_args = shift // {};

my $session_id = $call_args->{'session_id'} // '';
if ( defined $call_args->{'args'}
    and $call_args->{'args'} =~ m|session_id=(\d{3,17})| ) {
    $session_id = $1;
}

return {
    'mode' => qw| false |,
    'data' => 'missing session_id'
    }
    unless length $session_id;

my $ui    = $data{'session'}{$session_id}{'cred-mesh'}{'ui'};
my $focus = $ui->{'focus'};
return {
    'mode' => qw| false |,
    'data' => 'no active ui focus'
    }
    if not defined $focus
    or ref $focus ne qw| HASH |;

my $view = $focus->{'view'} // qw| overview |;

my $output    = '';
my @row_keys  = ();
my $row_index = $focus->{'row_index'} // 0;

my $caller_level = <[ui.caller.security-level]>;

## dispatch to the same render paths as cmd.ui-show ##
if ( $view eq qw| overview | ) {
    my $result = <[cred-mesh.ui.render.overview]>;
    $output .= $result->{'rendered'};
    push @row_keys, @{ $result->{'row_keys'} };

    ## same normalization as cred-mesh.cmd.ui-show's own -- see its comment ##
    if ( length $output ) {
        $output =~ s|\n*\z||;
        $output .= "\n\n";
    }

    if ( $caller_level >= 1 ) {
        $result = <[cred-mesh.ui.render.registry_list]>
            ->( { 'focus_index' => $row_index } );
        $output .= $result->{'rendered'};
        push @row_keys, @{ $result->{'row_keys'} };
    } else {
        $output .= "[ restricted — slot list requires security level 1 ]\n";
    }

    ## same normalization as cred-mesh.cmd.ui-show's own -- see its comment ##
    if ( length $output ) {
        $output =~ s|\n*\z||;
        $output .= "\n\n";
    }

    $result = <[cred-mesh.ui.render.auth_relay_queue]>
        ->( { 'focus_index' => $row_index } );
    $output .= $result->{'rendered'};
    push @row_keys, @{ $result->{'row_keys'} };

} elsif ( $view eq qw| slots | ) {
    if ( $caller_level >= 1 ) {
        my $result = <[cred-mesh.ui.render.registry_list]>
            ->( { 'focus_index' => $row_index } );
        $output   = $result->{'rendered'};
        @row_keys = @{ $result->{'row_keys'} };
    } else {
        $output = "[ restricted — slot list requires security level 1 ]\n";
    }

} elsif ( $view eq qw| slot | ) {
    if ( $caller_level >= 2 ) {
        my $slot = $focus->{'detail_slot'} // '';
        my $result
            = <[cred-mesh.ui.render.registry_detail]>
            ->( { 'slot' => $slot } );
        $output   = $result->{'rendered'};
        @row_keys = @{ $result->{'row_keys'} };
    } else {
        $output = "[ restricted — slot detail requires security level 2 ]\n";
    }

} elsif ( $view eq qw| relays | ) {
    my $result = <[cred-mesh.ui.render.auth_relay_queue]>
        ->( { 'focus_index' => $row_index } );
    $output .= $result->{'rendered'};
    push @row_keys, @{ $result->{'row_keys'} };

    ## same normalization as cred-mesh.cmd.ui-show's own -- see its comment ##
    if ( length $output ) {
        $output =~ s|\n*\z||;
        $output .= "\n\n";
    }

    $result = <[cred-mesh.ui.render.rotation_log]>
        ->( { 'focus_index' => $row_index } );
    $output .= $result->{'rendered'};
    push @row_keys, @{ $result->{'row_keys'} };

} elsif ( $view eq qw| holder | ) {
    my $result = <[cred-mesh.ui.render.key_holder_status]>;
    $output   = $result->{'rendered'};
    @row_keys = @{ $result->{'row_keys'} };

} else {
    $output
        = sprintf "[ unknown view '%s' — try: overview | "
        . "slots | slot <name> | relays | holder ]\n",
        $view;
}

## sync focus state with new row count ##
$focus->{'row_count'} = scalar @row_keys;
$focus->{'row_keys'}  = \@row_keys;

$focus->{'row_index'} = $focus->{'row_count'} - 1
    if $focus->{'row_index'} >= $focus->{'row_count'}
    and $focus->{'row_count'} > 0;
$focus->{'row_index'} = 0 if $focus->{'row_index'} < 0;

## append status line if one is set ##
my $status = $ui->{'status'};
if ( defined $status and length $status ) {
    $output .= "\n" . $status . "\n";
    $ui->{'status'} = undef;
}

## post-render colorisation — keys.console.list pattern adapted ##
if ( length $output
    and ( <system.ansi_color> or <system.force_colors> ) ) {
    my %C = %AMOS7::C;
    no warnings qw| experimental |;

    ## 1. base teal on everything ##
    $output =~ s|^(.+)$|$C{T}$1|mg;

    ## 2. leading colons purple, back to teal ##
    $output =~ s|^( *)(:{1,2})|$1$C{0}$2$C{T}|mg;

    ## 3. trailing dots and colons ##
    $output =~ s|  (\.)$|  $C{b}$C{0}$1$C{T}|mg;
    $output =~ s|  (\:) |  $C{b}$C{0}$1$C{T} |mg;

    ## 4. bracket labels ##
    $output =~ s|(\[ [^\]]+ \])|$C{0}$1$C{T}|mg;

    ## 5. slot names in single quotes ##
    $output =~ s|'([^']+)'|$C{0}'$C{T}$1$C{0}'$C{T}|mg;

    ## 6. sensitivity high ##
    $output =~ s|\b(high)\b|$C{0}$C{b}$1$C{T}|mg;

    ## 7. status words ##
    $output =~ s|\b(running)\b|$C{0}$1$C{T}|mg;
    $output =~ s|\b(not started)\b|$C{0}$1$C{T}|mg;
    $output =~ s|\b(terminated)\b|$C{0}$1$C{T}|mg;
    $output =~ s|\b(pending)\b|$C{0}$1$C{T}|mg;

    ## 8. revoked marker ##
    $output =~ s|(\[revoked\])|$C{0}$1$C{T}|mg;

    ## 9. final reset only at end ##
    $output =~ s|$|$C{R}|mg;
}

## same trailer as cred-mesh.cmd.ui-show's own -- see its comment for why ##
$output .= sprintf( "\n\x02VEFOCUS view=%s row=%d count=%d\x03",
    $view, $focus->{'row_index'}, $focus->{'row_count'} );

return { 'mode' => qw| size |, 'data' => $output };

