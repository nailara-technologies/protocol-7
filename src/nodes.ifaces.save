## [:< ##

# name  = nodes.ifaces.save
# descr = write node observations, p7 config style

## '<node>.trust = <state>' and one line per observation :  '<node>.obs = ##
## <network> <iface> <mac> <ip> <seen> <count>'                           ##
my $text = "## nodes : observations per node [ rewritten on change ] ##\n\n";
my $all  = <nodes.ifaces> // {};
foreach my $name ( sort keys $all->%* ) {
    my $node = $all->{$name};
    $text .= sprintf( "%s.trust = %s\n", $name, $node->{'trust'} )
        if defined $node->{'trust'};
    foreach my $o ( ( $node->{'obs'} // [] )->@* ) {
        $text .= sprintf(
            "%s.obs = %s %s %s %s %d %d\n",
            $name,          $o->{'network'}, $o->{'iface'},
            $o->{'hwaddr'}, $o->{'ip_addr'}, $o->{'seen'},
            $o->{'count'}
        );
    }
}
my $written = <[file.zenka_dir.write]>->(
    <nodes.cfg.ifaces_file>, \$text, qw| > |, 0600, qw| :raw |
);
<[base.log]>->( 0, ': node observations not written' )
    if not defined $written;
return defined $written ? TRUE : FALSE;

