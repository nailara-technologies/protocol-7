## [:< ##

# name  = proxy.transport.select
# descr = async delegate to transport.select if co-loaded, else no-op.
# args  = $context_hash, $reply
#         $reply is a coderef or { handler => 'name', params => {...} }.
# returns nothing meaningful; result delivered via $reply.

my ( $ctx, $reply ) = @ARG;
return undef if not defined $ctx;

if ( not exists $code{'transport.select'} ) {
    if ( ref $reply eq qw| CODE | ) {
        $reply->(undef);
    } elsif ( ref $reply eq qw| HASH |
        and defined $reply->{'handler'}
        and exists $code{ $reply->{'handler'} } ) {
        $code{ $reply->{'handler'} }->(
            {   'handle' => undef,
                'params' => $reply->{'params'} // {},
            }
        );
    }
    return;
}

<[transport.select]>->( $ctx, $reply );
return;

