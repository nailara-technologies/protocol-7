## [:< ##

# name  = plugin.web.auth.session.read
# descr = read session data by token_hash
# param = token_hash string

my $token_hash = shift // '';
return undef if not length $token_hash;

my $session_base = <[plugin.web.auth.session.path]>;
my $file         = "$session_base/active/$token_hash/session.yaml";

return undef if not -f $file;

my ( $data, $yaml_err ) = <[format.yaml.load_file]>->($file);
if ( not defined $data ) {
    <[base.s_warn]>->(
        'plugin.web.auth.session.read : yaml error [ %s ] : %s',
        $token_hash, $yaml_err // 'unknown'
    );
    return undef;
}

return ref $data eq qw| HASH | ? $data : undef;

