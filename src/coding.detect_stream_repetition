# name  = coding.detect_stream_repetition
# descr = detect a degenerate immediately-repeating pattern in stream text

my $text = shift // '';

my $unit_min = <coding.cfg.stream_repetition_unit_min> // 8;
my $unit_max = <coding.cfg.stream_repetition_unit_max> // 60;
my $min_run  = <coding.cfg.stream_repetition_min_run>  // 4;
my $window   = <coding.cfg.stream_repetition_window>   // 600;

## homogeneous [ single-character ] runs need a much longer match before ##
## they count as degenerate - see the check below                        ##
my $homogeneous_min_len = <coding.cfg.stream_repetition_homogeneous_min_len>
    // 200;

return undef if length($text) < $unit_min * $min_run;

## only the tail matters for detection - bounds the regex cost regardless ##
## of how long the overall response has grown                             ##
my $tail = length($text) > $window ? substr( $text, -$window ) : $text;

## a short unit [ unit_min..unit_max chars ] repeated immediately min_run+ ##
## times back-to-back - the classic degenerate-loop shape [ a model        ##
## regurgitating the same phrase/token run ], independent of what the unit ##
## actually contains                                                       ##
my $re = qr/(.{$unit_min,$unit_max}?)\1{$min_run,}/s;

return undef unless $tail =~ $re;

my $matched_unit = $1;

## capture now : the structural checks below run their own regexes, which
## would overwrite @- / @+
my $full_match_len = $+[0] - $-[0];

## a unit made of a single repeated character [ ':....:' -style ascii.frame
## border fills, AMOS7 signature terminators, '====' / '----' dividers ] is
## common LEGITIMATE content in this codebase, not the degenerate-loop failure
## mode this check exists to catch [ a model looping on a real multi-character
## PHRASE ]. require a much longer run before flagging those specifically,
## using the actual matched span length rather than $& [ avoids the global
## perf penalty of touching that special var ]
##
## widened 2026-09-24 : a single-char test missed every OTHER structural shape
## -- blank-line runs [ '  \n    \n', 68 false aborts in the log ], box-
## drawing borders [ '──┼──' ], '-=-=' rules, and a line drawing that arrived
## as mojibake [ 'âââ', task-5JXMWYY 2026-09-23 03:48, aborted mid-demo ].
## structural = no letters/digits at all, OR at most 3 distinct chars ; a
## genuine phrase loop has neither property. such runs still get caught, just
## at the long threshold
my %distinct   = map { $ARG => 1 } split m||, $matched_unit;
my $structural = ( $matched_unit !~ m|[\p{L}\p{N}]| or keys(%distinct) <= 3 );

if ($structural) {
    return undef if $full_match_len < $homogeneous_min_len;
}

return { matched => $matched_unit, unit_len => length($matched_unit) };

