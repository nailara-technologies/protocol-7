## [:< ##

# name  = screen.setup.dpi.confirm
# descr = keep dpi and rerun window placement

my $transaction = delete <screen.setup.dpi.transaction>;
my $value       = $transaction->{'value'} // <screen.setup.dpi.value>
    // <[screen.setup.dpi.settings]>->{'value'};
return { 'mode' => qw| false |, 'data' => 'no dpi change to confirm' }
    if not defined $value;

<screen.setup.dpi.revert_timer>->cancel
    if defined <screen.setup.dpi.revert_timer>;
delete <screen.setup.dpi.value>;
<[screen.setup.dpi.place-windows]>;
return { 'mode' => qw| true |, 'data' => "confirmed desktop.dpi = $value" };

