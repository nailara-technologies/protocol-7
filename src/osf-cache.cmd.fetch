## [:< ##

# name  = osf-cache.cmd.fetch
# descr = fetch one anchor from a holder, verify, cache it
# param = <algo>:<hex>
#
# acquisition flow steps 3-4 [ stage 4 : multi-source ] : the anchor
# must be in the local index [ size + filename known ] ; sizes above
# <osf-cache.cfg.fetch_max> [ //= 512 MiB ] are refused. the target
# dir is THIS instance's <osf-cache.cfg.cache_dir> and must be
# writable by the zenka [ the main instance's /var/cache/apt/archives
# is root's -> mode false 'cache dir not writable' ; the live test
# fetches INTO the peer ]. an anchor already held answers mode true
# 'already held' and one fetch per anchor runs at a time [ second
# request : mode false 'fetch already running' ]. the 'who holds H'
# lookup then runs with osf-cache.fetch.lookup_done as internal
# on_done caller [ the merged result, not a text reply ] : no holder
# -> mode false with the missing \ failed summary, an anchor in
# bmw_conflicts -> mode false [ kept from stage 3 ]. the stage 4 flow
# [ osf-cache.fetch.merkle_start ] : the holders agree on a merkle
# root [ osf-cache.merkle.quorum, k/n over <osf-cache.cfg.
# root_quorum> //= '5/7' - ALL asked must agree below n ], the leaf
# list is paged from one agreeing holder and rebuilt against the
# agreed root, then leaves are fetched in parallel [ one leaf per
# '<sid>.segment' request, ONE outstanding per holder, per-holder seq
# + timeout ] and verified against their leaf hash on arrival. the
# bytes land in <cache_dir>/partial/<deb filename>.partial and the
# stage 3 whole-file verification stays [ size + anchor digest +
# bmw384 ] before the rename into the cache dir - an unverified byte
# never reaches the cache dir. on success the file is scan_file'd
# into the holdings [ which also writes the merkle tree ] and
# state_saved. this command returns mode deferred ; every exit path
# cleans up pending state, ALL timers and the partial file [
# osf-cache.fetch.fail ].

require Time::HiRes;    ## core - loaded here, modules carry no use ##

my $args     = $call->{'args'}     // '';
my $reply_id = $call->{'reply_id'} // '';

my @tokens = grep {length} split m{\s+}, $args;

return {
    'mode' => qw| false |,
    'data' => 'usage : fetch <algo>:<hex>'
    }
    unless @tokens == 1;

return { 'mode' => qw| false |, 'data' => 'fetch needs a reply route' }
    unless length $reply_id;

my $token = lc $tokens[0];

## the exact token checks cmd.has runs [ empty holdings : validation only ] ##
my $check = <[osf-cache.lookup.query_local]>->(
    {   'hashes'   => [$token],
        'holdings' => { 'files' => [] },
    }
);

return { 'mode' => qw| false |, 'data' => $check->{'data'} }
    if $check->{'mode'} ne qw| true |;

## the anchor must be in the LOCAL index : size + filename known ##
my $index = <osf-cache.index> // {};
my $entry = $index->{'anchors'}{$token};

return {
    'mode' => qw| false |,
    'data' => "unknown anchor : $token [ not in the local index ]"
    }
    unless ref $entry eq qw| HASH |
    and defined $entry->{'size'}
    and length( $entry->{'filename'} // '' );

my $size = $entry->{'size'} // 0;

my $fetch_max = <osf-cache.cfg.fetch_max> // 536870912;
$fetch_max = 536870912 if !$fetch_max or $fetch_max < 1;    ## 512 MiB ##

return {
    'mode' => qw| false |,
    'data' => "size $size above fetch_max $fetch_max"
    }
    if $size > $fetch_max;

## the target dir is THIS instance's cache dir, writable by the zenka ##
my $cache_dir = <osf-cache.cfg.cache_dir> // '';

return { 'mode' => qw| false |, 'data' => 'cache dir not writable' }
    unless length $cache_dir
    and -d $cache_dir
    and -w $cache_dir;

## already held ? unanchored files never count [ the trust rule ] ##
my $holdings = <osf-cache.holdings>;
my $held     = <[osf-cache.lookup.query_local]>->(
    {   'hashes'   => [$token],
        'holdings' => ref $holdings eq qw| HASH |
        ? $holdings
        : { 'files' => [] },
    }
);

return { 'mode' => qw| true |, 'data' => "already held : $token" }
    if $held->{'mode'} eq qw| true |
    and scalar keys %{ $held->{'data'}{'held'} };

## one fetch per anchor at a time ##
<osf-cache.fetch.pending> //= {};

return { 'mode' => qw| false |, 'data' => 'fetch already running' }
    if exists <osf-cache.fetch.pending>->{$token};

my ( $algo, $hex ) = split m{:}, $token, 2;
my $filename = $entry->{'filename'} =~ s{^.*/}{}r;

## per-anchor state - every module of the flow reads THIS entry ##
<osf-cache.fetch.pending>->{$token} = {
    'reply_id'  => $reply_id,
    'anchor'    => $token,
    'algo'      => $algo,
    'hex'       => $hex,
    'size'      => $size,
    'filename'  => $filename,
    'cache_dir' => $cache_dir,
    'partial'   => "$cache_dir/partial/$filename.partial",
    'segments'  => 0,
    'holders'   => [],
    'excluded'  => [],
    'bmw384'    => '',
    'started'   => Time::HiRes::time(),
};

## the lookup with an internal caller : lookup_done continues the fetch ##
my $lookup = <[osf-cache.cmd.lookup]>->(
    {   'args'     => $token,
        'reply_id' => $reply_id,    ## unused : on_done takes over ##
        'on_done'  => qw| osf-cache.fetch.lookup_done |,
    }
);

if ( ref $lookup eq qw| HASH | and $lookup->{'mode'} ne qw| deferred | ) {
    ## refused up front : nothing may linger ##
    delete <osf-cache.fetch.pending>->{$token};
    return {
        'mode' => qw| false |,
        'data' => $lookup->{'data'} // 'lookup failed'
    };
}

return { 'mode' => qw| deferred | };

