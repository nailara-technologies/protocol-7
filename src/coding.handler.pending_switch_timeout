# name  = coding.handler.pending_switch_timeout
# descr = reap poll for the async force=1 model-switch completion :
#         armed by coding.handler.spawn_smart [ every 0.1 s ] when a
#         pending switch is stashed. completes the switch as soon as the
#         killed old server is gone -- reaped here, or already reaped by
#         any waitpid(-1) loop in the zenka [ a SIGCHLD is no reliable
#         completion signal : signals coalesce, competing reapers take the
#         exit status ]. the sigchld handler may still complete it first ;
#         the poll then finds nothing pending and stops. bounded : 10 s.

my $event        = shift;
my $handler_data = $event->w->data;
my $backend      = $handler_data->{'backend'} // 'gpu';
my $pending      = <coding.pending_switch>->{$backend};

## nothing pending [ completed by the sigchld handler meanwhile ] : stop ##
if ( ref $pending ne qw| HASH | ) {
    $event->w->cancel if $event->w->is_active;
    return TRUE;
}

## gone : reaped now [ pid ], already reaped elsewhere [ -1, ECHILD ] or no ##
## longer signalable -- whoever collected it                                ##
my $pid  = $pending->{'killed_pid'} // 0;
my $gone = !$pid || <[base.waitpid]>->($pid) != 0 || !kill( 0, $pid );

## bounded : complete after 10 s even when the old server still lingers ##
my $waited = <[base.time]>->(3) - ( $pending->{'poll_started'} // 0 );
return TRUE if !$gone and $waited < 10;

$event->w->cancel if $event->w->is_active;
<[base.logs]>->(
    ( $gone ? 2 : 0 ),
    '[pending_switch] %s : old server [ pid %s ] %s after %.1f s, completing',
    $backend,
    $pid,
    ( $gone ? 'gone' : 'STILL RUNNING' ),
    $waited
);
<[coding.helper.complete_pending_switch]>->( { 'backend' => $backend } );
return TRUE;

