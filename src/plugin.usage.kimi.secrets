## [:< ##

# name   = plugin.usage.kimi.secrets
# descr  = the kimi secret values [ for the leak check ]
# return = { kinds, files, secrets => [ [ kind, value ] ] }

## every credential file, not only the current one : an expired token in ##
## the wrong place counts too. values go to the caller only              ##

my $found = <[plugin.usage.kimi.credential_files]>;
my @files = $found->{'files'}->@*;
my @secrets;
foreach my $file (@files) {
    my $cred = <[usage.credential_load]>->($file) // next;
    push @secrets, [ 'kimi access', $cred->{'access_token'} ],
        [ 'kimi refresh', $cred->{'refresh_token'} ];
}

return {
    'kinds'   => [ 'kimi access', 'kimi refresh' ],
    'files'   => \@files,
    'secrets' => \@secrets,
};

