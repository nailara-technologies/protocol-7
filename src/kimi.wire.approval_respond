## [:< ##

# name  = kimi.wire.approval_respond
# descr = send approval response for a pending tool request

my $request_id = shift // return undef;
my $response   = shift // 'approve'; ## approve | approve_for_session | reject
my $message    = shift // undef;     ## optional decline reason for model

## build json-rpc 2.0 success response with ApprovalResponse result note:
## cannot use kimi.wire.send here : it builds method-based messages but
## approval responses are id-based with 'result' field
unless ( <kimi.ws.connected> and defined <kimi.ws.socket> ) {
    <[base.logs]>->( 0, 'kimi.wire.approval_respond: not connected' );
    return undef;
}

my %result = (
    'request_id' => $request_id,
    'response'   => $response,
);
$result{'message'} = $message if defined $message;

my %msg = (
    'jsonrpc' => '2.0',
    'id'      => $request_id,
    'result'  => \%result,
);

my $json = eval { JSON::encode_json( \%msg ) };
if ($@) {
    <[base.logs]>->( 0, 'kimi.wire.approval_respond: encode error : %s', $@ );
    return undef;
}

<[base.logs]>->(
    2,           ': approval response [ %s ] -> %s',
    $request_id, $response
);

## send first : websocket.send returns written byte count, undef on error
my $sent = <[websocket.send]>->( <kimi.ws.socket>, $json );

## only mark responded after confirmed send : a failed send must leave the
## request recoverable via kimi-web re-send [ toctou : marking before the send
## silently swallows the legitimate re-send on reconnect ]
if ( not defined $sent or $sent == 0 ) {
    <[base.logs]>->(
        0,
        'kimi.wire.approval_respond: send failed [ %s ] : '
            . 'not marking responded, awaiting kimi-web re-send',
        $request_id
    );
    return undef;
}

## track responded ids to suppress re-sent requests on reconnect
<kimi.approval.responded> //= {};
<kimi.approval.responded>->{$request_id} = 1;

## persist responded set for session resume across restarts
my $responded_str = join( "\n", keys <kimi.approval.responded>->%* ) . "\n";
<[file.zenka_dir.write]>->( 'approval_responded', \$responded_str );

return $sent;

