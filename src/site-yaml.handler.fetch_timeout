## [:< ##

# name  = site-yaml.handler.fetch_timeout
# descr = abort stalled async fetch worker

my $event = shift;

my $wdata = eval { $event->w->data } // {};
my $id    = $wdata->{'id'}           // '';

my $state = <site-yaml.fetch_worker>->{$id} or return;

<[base.logs]>->(
    0,   'site-yaml.fetch: timeout [ %s ] pid=%d url=%s',
    $id, $state->{'pid'}, $state->{'url'}
);

## timed_out makes async_fetch.finalize report failure rather than use ##
## whatever partial buffer the worker managed to write before the kill ##
$state->{'timed_out'} = TRUE;

kill( 9, -( $state->{'pid'} ) ) if $state->{'pid'};

<[site-yaml.async_fetch.finalize]>->($id);

return;

