## [:< ##

# name  = events.bucket.handler.timer
# descr = timer handler : the time of a bucket entry has come
# gets the EVENT [ the data is in ->w->data ] : { owner, id }

my $data   = shift->w->data;
my $owner  = $data->{'owner'};
my $bucket = <[events.bucket.get]>->($owner)       // return FALSE;
my $e      = $bucket->{'entries'}{ $data->{'id'} } // return FALSE;
return FALSE if ( $e->{'state'} // '' ) ne qw| waiting | or $e->{'met'};
delete <events.bucket_timers>->{ "$owner/" . $e->{'id'} };
$e->{'met'} = TRUE;
<[events.bucket.evaluate]>->($owner);
return TRUE;

