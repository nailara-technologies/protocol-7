## [:< ##

# name  = fetch-files.cmd.hf-list
# descr = list GGUF quantizations for HuggingFace repo
# param = '{"repo":"user/repo-GGUF"}'

my $args_str = $call->{'args'} // '';

return {
    'mode' => qw| false |,
    'data' => 'args required: {"repo":"user/model-GGUF"}'
    }
    if not length $args_str;

my $args = eval { JSON::XS::decode_json($args_str) };
return { 'mode' => qw| false |, 'data' => "invalid JSON: $@" } if $@;

## reply_id : the module answers deferred via cmd_reply -- without it the ##
## reply is dropped and the caller waits until the route collapses        ##
return
    <[huggingface.list]>
    ->( { 'args' => $args, 'reply_id' => $call->{'reply_id'} } );

