## [:< ##

# name  = fetch.file.huggingface.handler.download_progress
# descr = lightweight periodic progress logger for an active download
# note  = completion no longer detected here -- it arrives through the
#         streaming client's own on_done callback [ huggingface.handler.
#         download_response ]. this timer only refreshes size/speed for
#         hf-status and the log stream, and stops once the entry leaves
#         status=downloading [ final responses cancel it directly ]

my $event      = shift;
my $timer_data = eval { $event->w->data } // {};
my $dl_id      = $timer_data->{'dl_id'}   // '';

my $dl = <fetch.file.downloads>->{$dl_id};

if ( not defined $dl ) {
    ## tracking entry gone : nothing left to report for ##
    eval { $event->w->cancel };
    return;
}

if ( ( $dl->{'status'} // '' ) ne qw| downloading | ) {
    ## terminal or verify-phase state reached without cancelling us ##
    delete $dl->{'timer'};
    eval { $event->w->cancel };
    return;
}

my $dest         = $dl->{'dest'};
my $current_size = -f $dest ? ( -s $dest ) : 0;
my $prev_size    = $dl->{'downloaded'};
$dl->{'downloaded'} = $current_size;

my $now     = <[base.time]>->(3);
my $elapsed = $now - ( $dl->{'start_time'} // $now );
my $speed   = $elapsed > 0 ? ( $current_size / $elapsed ) : 0;
$dl->{'speed'} = sprintf( '%.2f', $speed / ( 1024**2 ) );    ## MB/s ##

if ( $current_size > $prev_size ) {
    <[base.logs]>->(
        2,             "[hf.fetch] progress: %s -> %.1f MB (%.1f MB/s)",
        $dl->{'file'}, $current_size / ( 1024**2 ),
        $dl->{'speed'}
    );
}

return 0;

