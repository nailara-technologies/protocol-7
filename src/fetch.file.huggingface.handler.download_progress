## [:< ##

# name  = fetch.file.huggingface.handler.download_progress
# descr = poll download progress and detect completion

my $event      = shift;
my $timer_data = eval { $event->w->data } // {};
my $dl_id      = $timer_data->{'dl_id'}   // '';

my $dl = <fetch.file.downloads>->{$dl_id};
return if !defined $dl;

my $pid      = $dl->{'pid'};
my $dest     = $dl->{'dest'};
my $reply_id = $dl->{'reply_id'};

## check if process has exited. NOT just `waitpid($pid, WNOHANG) == $pid`   ##
## -- confirmed live 2026-09-10: something else in this event framework     ##
## (`base.sig_chld`, the global handler, loops waitpid(-1,WNOHANG) on every ##
## SIGCHLD) can already collect the exit status before this 2s-interval     ##
## poll gets to it, so waitpid here returns -1 (ECHILD) instead of a clean  ##
## $pid match. That matched NEITHER the "exited" nor "still running" branch ##
## below, so the download stayed stuck at status=downloading forever with   ##
## its own timer firing every 2s indefinitely, never finalizing --          ##
## `fetch-files.dump` showed exactly                                        ##
## this: downloaded == the real complete file size, status still            ##
## 'downloading'. kill(0, $pid) is the authoritative liveness check;        ##
## waitpid's return value only tells us whether WE reaped it (and if so,    ##
## gives a trustworthy $? exit code -- if something else reaped it first    ##
## there is no trustworthy exit code available at all, handled below).      ##
my $wait_result   = waitpid( $pid, WNOHANG );
my $still_running = ( $wait_result == 0 ) && kill( 0, $pid );

## update file size ##
my $current_size = -f $dest ? ( -s $dest ) : 0;
my $prev_size    = $dl->{'downloaded'};
$dl->{'downloaded'} = $current_size;

my $now     = <[base.time]>->(3);
my $elapsed = $now - ( $dl->{'start_time'} // $now );
my $speed   = $elapsed > 0 ? ( $current_size / $elapsed ) : 0;
$dl->{'speed'} = sprintf( '%.2f', $speed / ( 1024**2 ) );    ## MB/s ##

if ( $current_size > 0 && $current_size > $prev_size && $speed > 0 ) {
    ## rough ETA based on observed speed  total is unknown unless we can ##
    ## get it from HF API                                                ##
}

## process exited [ confirmed via kill(0,...), not just a waitpid match -- ##
## see the note above -- covers both "we reaped it ourselves" [trustworthy ##
## $? exit code] and "something else already reaped it" [no trustworthy    ##
## exit code available, fall back to file state as the success signal]     ##
if ( not $still_running ) {
    my $exit_code = $wait_result == $pid ? ( $? >> 8 ) : undef;

    <[base.logs]>->(
        1,
        "[hf.fetch] %s exited [pid=%d] -- %s",
        $dl->{'file'},
        $pid,
        defined $exit_code
        ? "reaped directly, exit=$exit_code"
        : "already reaped elsewhere [base.sig_chld] "
            . "-- deciding from file state"
    );

    ## cancel timer ##
    my $timer = delete $dl->{'timer'};
    $timer->cancel if defined $timer;

    my $succeeded
        = defined $exit_code
        ? ( $exit_code == 0 && -f $dest )
        : ( -f $dest && ( -s $dest ) > 0 );    ## no trustworthy exit code ##

    my $hash_state = $dl->{'hash_state'} // qw| pending |;

    if ( $succeeded and $hash_state eq qw| ok | ) {
        ## expected sha256 already in hand -> fork the verify child.  reply ##
        ## is sent by huggingface.handler.verify_progress once the hash     ##
        ## comparison lands. idle-shutdown stays paused for the verify      ##
        ## child, resumed by the verify path.                               ##
        $dl->{'status'} = qw| verifying |;
        <[huggingface.verify.start]>->($dl_id);
        return;
    } elsif ( $succeeded and $hash_state eq qw| failed | ) {
        ## the expected hash genuinely could not be obtained -- this is NOT ##
        ## "no verification needed". NEVER fall through to the old          ##
        ## exit-code-only success path : that is the exact silent-          ##
        ## acceptance hole this verification layer exists to close          ##
        $dl->{'status'} = qw| unverified |;
        <[base.logs]>->(
            0,
            "[hf.fetch] UNVERIFIED: %s -- expected sha256 could not "
                . "be fetched after %d attempt(s); NOT marking complete",
            $dest,
            $dl->{'hash_attempts'} // 0
        );
        if ( length $reply_id ) {
            <[base.callback.cmd_reply]>->(
                $reply_id,
                {   'mode' => qw| false |,
                    'data' =>
                        "download UNVERIFIED: expected sha256 unavailable "
                        . "after retries -- not marked complete"
                }
            );
        }
        <[huggingface.resume_idle]>->();
        return;
    } elsif ( $succeeded and $hash_state eq qw| non-lfs | ) {
        ## small non-LFS file : no published sha256 exists [ git blob SHA1  ##
        ## scheme deliberately out of scope ] -> complete, with the skipped ##
        ## verification explicitly noted in the log                         ##
        my $size_gb = ( -s $dest ) / ( 1024**3 );
        $dl->{'status'} = qw| complete |;
        $dl->{'total'}  = $size_gb;
        <[base.logs]>->(
            1,
            "[hf.fetch] download complete [non-LFS, "
                . "sha skipped]: %s (%.2f GB, %d sec)",
            $dest,
            $size_gb,
            int($elapsed)
        );
        if ( length $reply_id ) {
            <[base.callback.cmd_reply]>->(
                $reply_id,
                {   'mode' => qw| true |,
                    'data' => sprintf(
                        "ok path=%s size_gb=%.2f duration=%d "
                            . "note=non-lfs sha256-skipped",
                        $dest, $size_gb, int($elapsed)
                    )
                }
            );
        }
        <[huggingface.resume_idle]>->();
        return;
    } elsif ($succeeded) {
        ## hash fetch still in flight -> park in awaiting-hash;        ##
        ## huggingface.handler.blob_hash_response continues the flow [ ##
        ## verify.start / unverified / non-lfs complete ] when the API ##
        ## response lands. idle-shutdown stays paused meanwhile.       ##
        $dl->{'status'} = qw| awaiting-hash |;
        <[base.logs]>->(
            1,
            "[hf.fetch] %s downloaded -- awaiting "
                . "expected sha256 before verification",
            $dl->{'file'}
        );
        return;
    } else {
        $dl->{'status'} = qw| error |;
        unlink($dest) if -f $dest;

        <[base.logs]>->(
            0, "[hf.fetch] download failed: %s [exit=%s]",
            $dest, ( $exit_code // 'unknown, reaped elsewhere' )
        );

        if ( length $reply_id ) {
            <[base.callback.cmd_reply]>->(
                $reply_id,
                {   'mode' => qw| false |,
                    'data' => sprintf( "download failed [exit code=%s]",
                        ( $exit_code // 'unknown' ) )
                }
            );
        }

        ## resume idle-shutdown tracking, paired with the pause in         ##
        ## fetch.file.huggingface.download -- only once EVERY tracked flow ##
        ## is terminal [ see fetch.file.huggingface.resume_idle ]          ##
        <[huggingface.resume_idle]>->();
        return;
    }
}

## process still running ##
if ($still_running) {
    <[base.logs]>->(
        2,             "[hf.fetch] progress: %s -> %.1f MB (%.1f MB/s)",
        $dl->{'file'}, $current_size / ( 1024**2 ),
        $dl->{'speed'}
    );
}

