## [:< ##

# name  = keys.console.removed
# param = [purge [::yes::]]
# descr = list removals that undo-remove can bring back
# note  = purge : drops entries older than 90 days that are not among the
#         newest 3 of their name -- only with '::yes::'

my $arg = shift // '';
my ( $purge, $yes ) = split m|[\t ]+|, $arg;

my $show = sub {
    my $entry = shift;
    printf " :. %-16s %-26s %s [ %s ]\n", $entry->{'kind'}, $entry->{'name'},
        scalar gmtime( $entry->{'time'} ), $entry->{'stamp'};
};

if ( defined $purge and length $purge ) {
    if ( $purge ne qw| purge | ) {
        say "\n  << expected 'purge [::yes::]' or nothing >>\n";
        <[base.exit]>->(qw| 0010 |);
    }
    my $candidates = <[keys.trash.purge_candidates]>;
    if ( not @{$candidates} ) {
        say " :\n :: nothing past retention [ 90 days, newest 3 kept ] ::\n";
        return;
    }
    say " :\n :: past retention :";
    $show->($ARG) foreach @{$candidates};
    if ( ( $yes // '' ) ne qw| ::yes:: | ) {
        say " :\n :. add '::yes::' to purge these ::\n";
        return;
    }
    my $purged = grep { unlink( $ARG->{'path'} ) } @{$candidates};
    printf " :\n :: purged %d of %d ::\n\n", $purged, scalar @{$candidates};
    return;
}

my $entries = <[keys.trash.entries]>;
say " :\n :: removed [ newest first ]";
if ( not @{$entries} ) {
    say " :. none";
} else {
    $show->($ARG) foreach @{$entries};
    say " :\n :. undo-remove <[kind:]name> [stamp]";
}
my $trash = <[keys.remote_keys_dir]>->( qw| trash |, FALSE );
<[keys.store_note]>->( $trash // '~/.n/remote-keys/trash' );
say " :.\n";

