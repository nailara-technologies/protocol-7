## [:< ##

# name  = context.modules.list
# descr = list modules in a namespace, truncated to budget
# usage = <[context.modules.list]>->( { namespace => 'coding',
#                                          budget => 800 } )

my $params = shift // {};

my $namespace   = $params->{'namespace'} // '';
my $budget      = $params->{'budget'}    // 800;
my $char_budget = int( $budget * 4 );

## validate namespace ##
unless ( length($namespace) ) {
    return "<!-- no namespace specified -->";
}

## sanitize namespace (prevent path traversal) ##
$namespace =~ s|[^\w.\-]||g;

## find modules ##
my $root    = <system.root_path>;
my $pattern = "$root/src/$namespace.*";
my @modules = glob($pattern);

## sort by filename length (shorter = more generic = more important) ##
@modules = sort { length($a) <=> length($b) } @modules;

## build output ##
my $header = "## modules in $namespace ##\n";
my $used   = length($header);
my @output = ($header);

foreach my $mod (@modules) {
    ## extract module name from path ##
    $mod =~ s|^.*/src/||;

    my $line     = "- $mod\n";
    my $line_len = length($line);

    if ( $used + $line_len > $char_budget ) {
        push @output, "... (truncated)";
        last;
    }

    push @output, $line;
    $used += $line_len;
}

return join( '', @output );

