## [:< ##

# name = base.ssl.write
# descr = SSL socket write handler using syswrite instead of IO::AIO
# CRITICAL: SSL sockets must use syswrite not IO::AIO, since SSL encryption
#           must happen at the OpenSSL library level, not at the kernel level.

my $write_fh         = $ARG[0];
my $write_string_ref = $ARG[1];
my $write_len        = $ARG[2];
my $str_offset       = $ARG[3] // 0;
my $fh_offset        = $ARG[4];        # Not used for SSL sockets

if ( not defined $write_fh ) {
    warn 'write_fh param not defined <{C1}>';
    return -1;
} elsif ( not defined $write_string_ref ) {
    warn 'write_string param not defined <{C1}>';
    return -1;
} elsif ( not length ref $write_string_ref ) {
    $write_string_ref = \$ARG[1];    ## scalar reference to argument ##
}

$write_len //= length $write_string_ref->$*;

## For binary file data, remove UTF-8 flag to prevent syswrite from
## auto-encoding
if ( utf8::is_utf8( $write_string_ref->$* ) ) {
    utf8::downgrade( $write_string_ref->$*, 0 );
}

## the scalar-level downgrade above doesn't help if the HANDLE itself carries
## a :utf8 \ :encoding perlio layer -- syswrite refuses outright on those
## regardless of the data's own utf8 flag. binmode is idempotent and cheap ;
## see base.s_read for the read-side counterpart of this same guard
binmode( $write_fh, ':raw' );

## one tls record per call [ 16 KiB ] ; a write openssl could not finish   ##
## must be repeated with the same length, even when the output buffer grew ##
## meanwhile -- that pending length is kept per handle                     ##
my $handle_data = $data{'handle'}{$write_fh} //= {};
$write_len = 16384 if $write_len > 16384;
$write_len = $handle_data->{'ssl_retry_len'}
    if defined $handle_data->{'ssl_retry_len'}
    and $handle_data->{'ssl_retry_len'}
    <= length( $write_string_ref->$* ) - $str_offset;

## Use syswrite for SSL sockets  syswrite(FILEHANDLE, SCALAR, LENGTH, OFFSET)
## writes LENGTH bytes from SCALAR starting at OFFSET For SSL sockets, OpenSSL
## handles the encryption automatically.
my $size_written
    = syswrite( $write_fh, $write_string_ref->$*, $write_len, $str_offset );

if ( defined $size_written ) {
    delete $handle_data->{'ssl_retry_len'};
    return $size_written;    ## [ bytes written ] ##
}

## a full send buffer is not an error : a non-blocking IO::Socket::SSL      ##
## answers undef with EAGAIN \ SSL_WANT_WRITE [ or WANT_READ ]. as -1 the   ##
## caller closed the session -- every https response larger than the kernel ##
## buffer broke off at a record boundary                                    ##
## [ 81920 of 125229 bytes, 2026-10-23 ]. 0 is 'socket full' to it, as      ##
## base.s_write reports                                                     ##
my $ssl_error = $IO::Socket::SSL::SSL_ERROR // 0;
if (   $!{EAGAIN}
    or $!{EWOULDBLOCK}
    or $ssl_error == IO::Socket::SSL::SSL_WANT_WRITE()
    or $ssl_error == IO::Socket::SSL::SSL_WANT_READ() ) {
    $handle_data->{'ssl_retry_len'} = $write_len;
    return 0;
}

delete $handle_data->{'ssl_retry_len'};
return -1;    ## [ a real error ] ##

