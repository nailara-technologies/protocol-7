## [:< ##

# name  = discover.orbital.store_remote
# descr = store orbital p7ref received from remote node

my $hostname = shift // '';
my $pkey_b32 = shift // '';
my $p7ref    = shift // '';

return
        unless length $hostname
    and length $pkey_b32
    and length $p7ref;

my $pkey = Crypt::Misc::decode_b32r($pkey_b32);
return unless defined $pkey and length $pkey;

my $pkey_L13 = <[chk-sum.bmw.L13-str]>->($pkey);

<discover.orbital.known> //= {};
<discover.orbital.known>->{$pkey_L13} = {
    'hostname'  => $hostname,
    'pkey'      => $pkey,
    'p7ref'     => $p7ref,
    'timestamp' => <[base.time]>->(5)
};

<[base.logs]>
    ->( 2, "orbital address received for %s: %s", $hostname, $p7ref );

## push to orbital STRM subscribers [ web's poll-replacement ] ##
if (    <[base.cfg_bool]>->(<discover.cfg.orbital_push_enabled>)
    and defined <discover.orbital.listeners>
    and <discover.orbital.listeners>->@* ) {

    my $pkey_short = substr( $pkey_b32, 0, 7 );
    my $payload    = sprintf "%s %s %s %s\n", $hostname, $pkey_short, $p7ref,
        '0.0s';

    my @keep;
    for my $h ( <discover.orbital.listeners>->@* ) {
        if ( <[base.stream.push]>->( $h, \$payload ) ) {
            push @keep, $h;
        } else {
            <[base.stream.close]>->($h)
                ;    ## clean up base-level producer state ##
        }
    }
    <discover.orbital.listeners> = \@keep;
}

return TRUE;

