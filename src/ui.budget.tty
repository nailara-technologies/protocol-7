## [:< ##

# name  = ui.budget.tty
# descr = derive a slot budget from the current tty
# param = { reserve_rows? = 2 }

my $reserve_rows = $ARG[0]->{'reserve_rows'} // 2;

my ( $cols, $rows ) = eval { AMOS7::TERM::terminal_size() };
$cols //= 80;
$rows //= 24;

$rows -= $reserve_rows;
$rows = 1 if $rows < 1;

return { 'cols' => $cols, 'rows' => $rows };

