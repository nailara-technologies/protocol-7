# name  = source.generated_envelope
# descr = parse a generated signature envelope without verifying it
# args  = <payload_sref>
# return = envelope fields, undef [ list context : undef, error ]

my $payload_sref = shift;
return ( undef, 'payload-reference' )
    if ref $payload_sref ne qw| SCALAR |
    or not defined $payload_sref->$*;
return if $payload_sref->$* !~ m{
        \A(.*)
        ((?:/\*|<!--)[\t ]*P7-GENERATED[\t ]+([A-Z2-7]{52})
            (?:[\t ]+([A-Z2-7.]+))?[\t ]*\n\n?)
        (\#[\.,]{70,}\n(?:\#[^\n]+\n)+)
        (\*/|-->)[\t ]*\n?\z
    }sx;
my ( $unsigned, $opening, $public_b32, $chain, $standard_footer, $close )
    = ( $1, $2, $3, $4 // '', $5, $6 );
my $pair_valid
    = $opening =~ m{\A/\*} ? $close eq qw| */ | : $close eq qw| --> |;
return if not $pair_valid;
my $public_key = eval { decode_b32r($public_b32) };
return ( undef, 'generator-public-key' )
    if not defined $public_key
    or length($public_key) != 32;
return {
    qw| unsigned_body   | => $unsigned,
    qw| opening         | => $opening,
    qw| public_b32      | => $public_b32,
    qw| public_key      | => $public_key,
    qw| chain           | => $chain,
    qw| standard_footer | => $standard_footer,
    qw| close           | => $close,
};

