# name  = osf-cache.holdings.scan_apt_cache
# descr = scan local apt archive cache against an anchor index
# param = { dir => '/var/cache/apt/archives',
#           index => { anchors => { '<algo>:<hex>' => \%entry },
#                      algos => \@algos } [ or a flat anchor map ],
#           previous => \@{ file entries } [ optional ] }
#
# passive supply : many nodes never cleared their apt cache and those
# .debs already match the signed index hashes exactly - free supply,
# announced by hash. scans the cache directory for .deb files [ partial
# and lock entries skipped ] by delegating every file to
# osf-cache.holdings.scan_file [ the per-file body lives there - same
# reuse and anchoring rules : ONE read pass per file computes every
# index algo plus bmw384, the five-field reuse check reuses all
# recorded digests unless the current index needs an algo the previous
# entry lacks ]. anchoring always uses the CURRENT index, never the
# previous result. rehashed in the result counts the files actually
# read.

my $args     = shift               // {};
my $dir      = $args->{'dir'}      // '/var/cache/apt/archives';
my $index    = $args->{'index'}    // {};
my $previous = $args->{'previous'} // [];

my %anchors;
my @index_algos;
if ( ref $index eq qw| HASH | and ref $index->{'anchors'} eq qw| HASH | ) {
    %anchors     = %{ $index->{'anchors'} };
    @index_algos = sort grep {length} @{ $index->{'algos'} // [] };
} else {
    ## flat anchor map : derive the algo list from the tokens ##
    %anchors = ref $index eq qw| HASH | ? %$index : ();
    my %seen_algo;
    foreach my $token ( keys %anchors ) {
        my ($algo) = split m{:}, $token, 2;
        $seen_algo{$algo} = 1 if defined $algo and length $algo;
    }
    @index_algos = sort keys %seen_algo;
}

my %previous_by_name = map { $ARG->{'name'} => $ARG } @$previous;

return { 'mode' => 'false', 'data' => 'dir required' } unless length $dir;
return { 'mode' => 'false', "data" => "not a directory : $dir" }
    unless -d $dir;
opendir( my $dh, $dir )
    or return {
    'mode' => 'false',
    'data' => "cannot open $dir : $OS_ERROR"
    };

my @files;
my $rehashed_count = 0;
while ( my $entry = readdir $dh ) {
    next unless $entry =~ m{\.deb$};
    my $path = "$dir/$entry";
    next unless -f $path;

    my $file = <[osf-cache.holdings.scan_file]>->(
        {   'path'     => $path,
            'name'     => $entry,
            'anchors'  => \%anchors,
            'algos'    => \@index_algos,
            'previous' => $previous_by_name{$entry},
        }
    );
    next unless ref $file eq qw| HASH |;
    $rehashed_count++ if $file->{'rehashed'};
    push @files, $file;
}
closedir($dh);

@files = sort { $a->{'name'} cmp $b->{'name'} } @files;

my $anchored_count = 0;
my $total_bytes    = 0;
my $anchored_bytes = 0;
foreach my $file (@files) {
    $total_bytes += $file->{'size'};
    if ( $file->{'anchored'} ) {
        $anchored_count++;
        $anchored_bytes += $file->{'size'};
    }
}

return {
    'mode' => qw| true |,
    'data' => {
        'files'          => \@files,
        'anchored_count' => $anchored_count,
        'total_bytes'    => $total_bytes,
        'anchored_bytes' => $anchored_bytes,
        'rehashed'       => $rehashed_count,
        'algos'          => \@index_algos,
    }
};

