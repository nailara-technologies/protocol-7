## [:< ##

# name = base.s_write
# descr = utf8 safe non-blocking syswrite for sockets and pipes
# note = use base.s_write.file_io for file handle writes [ IO::AIO with offset ]
# todo = create custom version to pass buffer by reference + reducing overhead

my $write_fh         = $ARG[0];
my $write_string_ref = $ARG[1];
my $write_len        = $ARG[2];
my $str_offset       = $ARG[3] // 0;

if ( not defined $write_fh ) {
    warn 'write_fh param not defined <{C1}>';
    return undef;
} elsif ( not defined $write_string_ref ) {
    warn 'write_string param not defined <{C1}>';
    return undef;
} elsif ( not length ref $write_string_ref ) {
    $write_string_ref = \$ARG[1];    ## scalar reference to argument ##
}

## utf8 safety : encode in-place before computing byte count ##
if ( utf8::is_utf8( $write_string_ref->$* ) ) {
    utf8::encode( $write_string_ref->$* )
        if $write_string_ref->$* =~ m|[^\p{ASCII}]|;
    utf8::downgrade( $write_string_ref->$*, 1 );    ## strip internal flag ##
}

$write_len //= bytes::length( $write_string_ref->$* );

## non-blocking syswrite : returns 0 on EAGAIN, -1 on error  5th param :    ##
## non-blocking for this one write on a socket  [ send + MSG_DONTWAIT ] --  ##
## the event-driven drain [ base.handler. write ] must never wait on a full ##
## socket buffer, while synchronous exchanges on the same blocking socket   ##
## [ whoami, X-11 helpers ] keep their blocking reads and writes. capped    ##
## per call : no copy of a large buffer for a partial send                  ##
my $size_written;
if ( $ARG[4] and -S $write_fh ) {
    $write_len = 65536 if $write_len > 65536;
    $size_written
        = send( $write_fh,
        bytes::substr( $write_string_ref->$*, $str_offset, $write_len ),
        Socket::MSG_DONTWAIT() );
} else {
    $size_written
        = syswrite( $write_fh, $write_string_ref->$*, $write_len,
        $str_offset );
}

return 0
    if not defined $size_written
    and ( $OS_ERROR{EAGAIN} or $OS_ERROR{EWOULDBLOCK} );

return -1 if not defined $size_written;

return $size_written;

