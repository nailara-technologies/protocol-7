## [:< ##

# name  = letsencr.child.acme.next_queued
# param = <finished order_id>
# descr = free the order slot, start the next queued request

my $order_id = shift;

delete <letsencr.child.acme.active>
    if ( <letsencr.child.acme.active> // '' ) eq ( $order_id // '' );

while ( my $req = shift <letsencr.child.acme.queue>->@* ) {
    my $result = <[letsencr.child.acme.begin]>->($req);

    ## started [ or parked again ] : its reply comes later ##
    last if ( $result->{'mode'} // '' ) eq qw| deferred |;

    ## refused at once [ no key, bad request ] : answer it, try the next ##
    <[base.callback.cmd_reply]>->( $req->{'reply_id'}, $result )
        if defined $req->{'reply_id'};
}

return TRUE;

