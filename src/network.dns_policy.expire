## [:< ##

# name  = network.dns_policy.expire
# param = [ <fingerprint>, <generation> ]
# descr = restore the policy from before temporary portal trust

my $args = shift // return FALSE;
my ( $fingerprint, $generation ) = $args->@*;
my $p = <network.dns_policy.by_fingerprint>->{$fingerprint} // return FALSE;
return FALSE
    if not $p->{'temporary'}
    or ( $p->{'generation'} // 0 ) != $generation;

my $previous = delete $p->{'previous'};
$p->{'policy'}  = $previous->{'policy'};
$p->{'domains'} = $previous->{'domains'};
delete @{$p}{qw| temporary until generation timer reason |};
<[network.dns_policy.save]>;
<[network.lease.dns_handoff]>->( $p->{'iface'} );
return TRUE;

