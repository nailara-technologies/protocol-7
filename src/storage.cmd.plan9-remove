## [:< ##
# name  = storage.cmd.plan9-remove
# descr = Remove a path over 9P

my $args = $call->{'args'} // '';
my ( $name, $path ) = split /\s+/, $args, 2;

if ( not length( $name // '' ) or not length( $path // '' ) ) {
    return {
        'mode' => 'false',
        'data' => 'usage: plan9-remove <connection-name> <path>'
    };
}

my $conn = <storage.9p.connections>->{$name};
return { 'mode' => 'false', 'data' => 'not connected' } unless $conn;

my $result = <[storage.9p.remove-path]>->( $conn, $path );
return $result if $result->{'mode'} eq 'false';

return {
    'mode' => 'true',
    'data' => "removed $path"
};

