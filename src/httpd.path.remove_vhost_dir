# name  = httpd.path.remove_vhost_dir
# param = <content_path>
# descr = remove vhost content directory recursively

my $content_path = shift;

unless ($content_path) {
    <[base.log]>->( 0, 'content_path parameter required' );
    return FALSE;
}

unless ( -d $content_path ) {
    <[base.logs]>->( 2, 'vhost directory not found : %s', $content_path );
    return TRUE;
}

<[base.logs]>->( 2, 'removing vhost directory : %s', $content_path );

my $removed_count = <[file.remove_tree]>->( $content_path, {} );

if ( $removed_count == FALSE ) {
    return FALSE;
}

return TRUE;

