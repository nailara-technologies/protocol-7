# name  = storage.cmd.plan9-connect
# descr = Connect to 9P server

my $args = $call->{'args'} // '';
my ( $host, $port, $name ) = split m|\s+|, $args, 3;

$host //= '127.0.0.1';
$port //= <plan-9.default_port> // 15640;
$name //= "$host:$port";

my $result = <[storage.9p.connect]>->(
    {   host => $host,
        port => $port,
        name => $name,
    }
);

if ( $result->{'mode'} eq 'true' ) {
    return {
        'mode' => 'true',
        'data' => "connected to 9P server $name at $host:$port"
    };
} else {
    return $result;
}

