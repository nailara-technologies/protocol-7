## [:< ##

# name  = plugin.web.space.index.load
# descr = restore index cache from persisted json on disk

my $persist_dir = <web.space.index.cfg.persist_dir> // qw| space-index |;
my $json_file   = "$persist_dir/src.json";

## load via zenka_dir [ returns scalar ref or undef ] ##
my $content_sref = <[file.zenka_dir.load]>->($json_file);
return FALSE if not defined $content_sref;

my $cache = eval { JSON::XS::decode_json( $content_sref->$* ) };
if ( not defined $cache or length $EVAL_ERROR ) {
    <[base.logs]>->(
        0,
        'plugin.web.space.index.load : json parse error : %s',
        $EVAL_ERROR // qw| unknown |
    );
    return FALSE;
}

## validate minimal structure ##
if (   not exists $cache->{'cells'}
    or not exists $cache->{'file_count'}
    or not exists $cache->{'timestamp'} ) {
    <[base.logs]>->(
        0, 'plugin.web.space.index.load : invalid cache structure in %s',
        $json_file
    );
    return FALSE;
}

<web.space.index.cache> = $cache;

## pre-encode for fast http serving ##
my $payload = {
    qw| target_dir | => $cache->{'target_dir'} // qw| unknown |,
    qw| file_count | => $cache->{'file_count'} // 0,
    qw| cells      | => $cache->{'cells'}      // [],
    qw| timestamp  | => $cache->{'timestamp'}  // 0,
};

<web.space.index.json_cached>
    = eval { JSON::XS::encode_json($payload) } // '{}';
require YAML::XS;
<web.space.index.yaml_cached>
    = eval { YAML::XS::Dump($payload) } // "--- {}\n";

<[base.logs]>->(
    2,
    'plugin.web.space.index.load : restored %s files from %s',
    $cache->{'file_count'} // 0, $json_file
);

return TRUE;

