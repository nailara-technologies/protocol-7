## [:< ##

# name  = v7-zenki.handler.stdio_multiplex_scope
# param = $record  [ META subtype = scope-enter / scope-leave ]
# descr = maintain the per-zenka scope tree used for provenance
#         routing of inbound typed runs

my ( $record, $socket ) = @ARG;

if ( not defined $record or ref $record ne qw| HASH | ) {
    warn 'expected typed-run record <{C1}>';
    return;
}

my $tag = $record->{'tag'} // '';
if ( $tag ne qw| META | ) {
    warn 'scope handler only accepts META records <{C1}>';
    return;
}

my $subtype = $record->{'header'}{'subtype'} // '';
if (    $subtype ne qw| scope-enter |
    and $subtype ne qw| scope-leave | ) {
    ## [ non-scope META records do not touch the scope tree ]
    return;
}

## [ per-connection scope stack rooted at the inbound zenka ] ##
<v7-zenki.stdio_multiplex.scope> //= {};
my $stack = <v7-zenki.stdio_multiplex.scope>->{$socket} //= [];

if ( $subtype eq qw| scope-enter | ) {
    my $node = {
        qw| origin    | => $record->{'header'}{'origin'}    // '',
        qw| slot_addr | => $record->{'header'}{'slot_addr'} // '',
        qw| hop_id    | => $record->{'header'}{'hop_id'}    // 0,
    };
    push @$stack, $node;
} elsif ( $subtype eq qw| scope-leave | ) {
    my $origin = $record->{'header'}{'origin'} // '';
    if (    length $origin
        and @$stack
        and $stack->[-1]->{'origin'} eq $origin ) {
        pop @$stack;
    } elsif (@$stack) {
        ## [ mismatch — pop top to keep stack balanced ] ##
        pop @$stack;
    }
}

return $stack;

