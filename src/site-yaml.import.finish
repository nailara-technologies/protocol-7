## [:< ##

# name  = site-yaml.import.finish
# descr = import page loop is done : queue fetch timer, reply, clean up

my $import_id = shift;
my $st        = delete <site-yaml.import_state>->{$import_id};
return unless defined $st;

if ( $st->{'queued_count'} and not defined <site-yaml.fetch_timer> ) {
    <[site-yaml.fetch.schedule]>;
}

<[site-yaml.fetch.state]>->('save');

my $summary = sprintf 'import : queued %03d · skipped %03d · %s errors',
    $st->{'queued_count'}, $st->{'skip_count'}, $st->{'err_count'} || 'no';
<[base.logs]>->( 1, ':: %s', $summary );

<[base.callback.cmd_reply]>->(
    $st->{'reply_id'}, { 'mode' => qw| size |, 'data' => $summary }
);

## an import that queued nothing may be the last thing a fetched-stream ##
## waits for [ no check at subscribe : the imports arrive after it ]    ##
<[site-yaml.outbox.check-terminate]>;

return;

