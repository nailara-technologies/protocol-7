## [:< ##

# name  = coding.cmd.budget
# descr = show token budget status and usage breakdown
# param = [history|breakdown]

my $subcommand = length( $call->{'args'} ) ? $call->{'args'} : 'status';

if ( $subcommand eq 'status' ) {

    # Show current budget status
    my $budget = <[coding.budget.track_tokens]>->('status');

    return {
        'mode' => qw| size |,
        'data' => "token budget status:\n  total allocated: "
            . $budget->{total_allocated}
            . " tokens\n  total used: "
            . $budget->{total_used}
            . " tokens\n  remaining: "
            . $budget->{remaining}
            . " tokens\n  percentage used: "
            . $budget->{percentage_used}
            . "%\n  percentage remaining: "
            . $budget->{percentage_remaining}
            . "%\n  status: "
            . $budget->{status}
            . "\n  session duration: "
            . $budget->{session_duration}
            . "\n  avg per transaction: "
            . $budget->{average_per_transaction}
            . " tokens\n"
    };

} elsif ( $subcommand eq 'history' ) {

    # Show transaction history
    my $history = <[coding.budget.track_tokens]>->( 'history', 10 );

    my $output = "recent token transactions (last 10):\n";
    $output
        .= "  total transactions: " . $history->{transaction_count} . "\n";
    $output
        .= "  avg per transaction: "
        . $history->{summary}->{avg_tokens_per_transaction}
        . " tokens\n";
    $output .= "  successful: " . $history->{summary}->{successful} . "\n";
    $output .= "  failed: " . $history->{summary}->{failed} . "\n";
    $output .= "\n  recent transactions:\n";

    foreach my $txn ( @{ $history->{recent} } ) {
        $output .= sprintf(
            "    [%s] %s: %d tokens (balance: %d)\n",
            scalar( localtime( $txn->{timestamp} ) ),
            $txn->{service} // 'unknown',
            $txn->{tokens_used}, $txn->{balance_after}
        );
    }

    return {
        'mode' => qw| size |,
        'data' => $output
    };

} elsif ( $subcommand eq 'breakdown' ) {

    # Show usage by service
    my $breakdown = <[coding.budget.track_tokens]>->('breakdown');

    my $output = "Token Usage by Service:\n";
    $output .= "  Total Transactions: "
        . $breakdown->{total_transactions} . "\n\n";

    foreach my $service ( @{ $breakdown->{by_service} } ) {
        my $percentage = ( $service->{tokens_used} / 100 );
        $output .= sprintf(
            "  %s: %d tokens (%d transactions, avg %d/txn)\n",
            $service->{service},      $service->{tokens_used},
            $service->{transactions}, $service->{average_per_transaction}
        );
    }

    return {
        'mode' => qw| size |,
        'data' => $output
    };

} else {
    return {
        'mode' => qw| false |,
        'data' => "Unknown budget subcommand: "
            . "$subcommand\nAvailable: status, history, breakdown"
    };
}

