## [:< ##

# name  = plugin.nshell.coding-session.on_submit
# descr = turn typed text into the right coding-zenka command : submit a
#         new task if this tab has none yet, else append to it
# param = { mode => $mode_href, text => $typed_text }

my $args = shift // {};
my $mode = $args->{'mode'};
my $text = $args->{'text'} // '';

return undef unless defined $mode and length $text;

## a new round is starting either way below -- re-arm on_escape's "first    ##
## press aborts" behaviour for it, rather than leaving it in whatever stage ##
## a previous [ now-irrelevant ] round left it in                           ##
delete $mode->{'esc_stage'};

if ( defined $mode->{'task_id'} and length $mode->{'task_id'} ) {

    ## stash the text so on_reply can resubmit it fresh if the coding zenka ##
    ## no longer has this task_id [ see on_reply's "task not found" branch  ##
    ## ]                                                                    ##
    $mode->{'pending_append_text'} = $text;

    return { 'command' => "coding.task-append $mode->{'task_id'} $text" };
}

## no task yet : start one, and remember we're waiting for its id to come ##
## back in the reply [ plugin.nshell.coding-session.on_reply catches it ] ##
$mode->{'awaiting_task_id'} = TRUE;

return { 'command' => "coding.submit $text" };

