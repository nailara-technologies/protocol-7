# name  = protocol-7-menu.handler.decision_signal_reply
# descr = the events zenka answered decision.answered

my $reply = shift // {};
my ( $mode, $text ) = <[base.reply.mode_text]>->($reply);
my $id = ( $reply->{'params'} // {} )->{'id'} // '?';
if ( $mode eq qw| true | ) {
    <[base.logs]>->( 1, ':. decision %s : %s', $id, $text );
} else {
    <[base.logs]>->(
        0,   '<< signal decision.answered [ %s ] refused : %s >>',
        $id, length $text ? $text : 'no answer'
    );
}
return TRUE;

