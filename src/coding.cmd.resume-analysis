# name  = coding.cmd.resume-analysis
# descr = manually resume/continue incomplete code analysis
# param = <job_id> [instruction]

( my $meta_id, my $additional_instruction )
    = split( m| +|, $call->{'args'}, 2 );
$additional_instruction //= '';

# Parameter validation
return { 'mode' => qw| false |, 'data' => 'meta_job_id required' }
    if not defined $meta_id || not length $meta_id;

# Retrieve the meta job
my $meta_job = <coding.complete_analysis_jobs>->{$meta_id};

unless ( defined $meta_job ) {
    return {
        'mode' => qw| false |,
        'data' => 'meta job not found: ' . $meta_id
    };
}

unless ( defined $meta_job->{'task_id'} && length $meta_job->{'task_id'} ) {
    return {
        'mode' => qw| false |,
        'data' => 'meta job has no active task'
    };
}

# Check if we've exceeded max resumes
if ( $meta_job->{'resume_count'} >= $meta_job->{'max_resumes'} ) {
    return {
        'mode' => qw| true |,
        'data' => "Analysis already at maximum resumes ("
            . $meta_job->{'max_resumes'}
            . "). Accumulated result:\n"
            . $meta_job->{'accumulated'}
    };
}

<[base.logs]>->(
    1, "[resume-analysis] continuing analysis for meta=%s (attempt %d)",
    $meta_id, $meta_job->{'resume_count'} + 1
);

# Trigger continuation via variable watcher
$meta_job->{'resume_count'}++;
$meta_job->{'continue_analysis'} = TRUE;

<[base.logs]>->(
    1, "[resume-analysis] triggered continuation, returning deferred"
);

return { 'mode' => qw| deferred | };

