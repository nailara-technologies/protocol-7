## [:< ##

# name  = link.supervisor.teardown
# descr = stop timers, session and transport of a managed link
# param = <name> [, <shutdown session : // true> ]
#
# the shared half of a reconnect [ the design : a heartbeat timeout
# closes the session AND the transport ]. order matters : the sid is
# cleared from <link.sids> BEFORE base.session.shutdown so the session's
# rip_handler [ link.handler.session_rip ] sees nothing to do -- the
# teardown itself schedules the retry. the transport child [ ssh -W ]
# exits on its own once its socketpair end hits eof ; TERM + a bounded
# waitpid reap covers a child that missed it. never a $SIG handler [ the
# host-edit.transport.ssh_forward_stop shape ].

my ( $name, $shutdown_session ) = @ARG;
$shutdown_session //= TRUE;

return if not length $name;

my $timers = <link.supervisor.timers> //= {};
my $entry  = <external.links>->{$name} // return;

## timers ##
foreach my $key (qw| hb hb_timeout retry |) {
    my $watcher = delete $timers->{$name}{$key};
    next             if not defined $watcher;
    $watcher->cancel if $watcher->can(qw| cancel |);
}

## session ##
my $sid = delete $entry->{'sid'};
if (    length( $sid // '' )
    and $shutdown_session
    and exists $data{'session'}{$sid} ) {
    delete <link.sids>->{$sid};
    <[base.session.shutdown]>->($sid);
}

## transport child + stream ##
my $fd = delete $entry->{'transport_fd'};
if ( defined $fd ) {
    delete $data{'handle'}{$fd};
    close($fd);
}

my $pid = delete $entry->{'transport_pid'};
if ( defined $pid ) {
    kill qw| TERM |, $pid;
    foreach my $try ( 1 .. 20 ) {    ## WNOHANG == 1 [ bounded reap ] ##
        my $reaped = waitpid( $pid, 1 );
        last if $reaped == $pid;
        select( undef, undef, undef, 0.05 );
    }
    kill qw| KILL |, $pid if kill 0, $pid;
    waitpid( $pid, 1 );
}

return TRUE;

