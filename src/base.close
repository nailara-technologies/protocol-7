## [:< ##

# name       = base.close

my $fd = $_[0];

my $type = $data{'handle'}{$fd}{'link'};
my $mode = $data{'handle'}{$fd}{'mode'};
my @params;

if ( not defined <io.type>->{$type} ) {
    <[base.log]>->( 0, "base.close: io type '$type' not defined" );
    return undef;
} elsif ( not defined <io.type>->{$type}{'handler'}{$mode} ) {
    <[base.log]>->(
        0, "base.close: unknown io mode '$mode' for type '$type'"
    );
    return undef;
} elsif (
    not defined &{ $code{ <io.type>->{$type}{'handler'}{$mode}{'close'} } } )
{
    <[base.log]>->(
        0, "base.close: '$type'-handler for mode '$mode' not defined"
    );
    return undef;
}

return &{ $code{ <io.type>->{$type}{'handler'}{$mode}{'close'} } }(@params);

