## [:< ##

# name  = coding.tools.handler.escalate
# descr = signal that the task needs human attention and stop the loop

my $args     = shift               // {};
my $question = $args->{'question'} // return 'question required';
my $context  = $args->{'context'}  // '';
my $severity = $args->{'severity'} // 'question';

## set the stop flag with escalation details ##
<coding.tool_loop.stop>         = TRUE;
<coding.tool_loop.stop_reason>  = 'escalate';
<coding.tool_loop.stop_summary> = $question;

## build escalation message ##
my $msg = sprintf "[ESCALATE:%s] %s", $severity, $question;
$msg .= "\ncontext: $context" if length $context;

<[base.logs]>->(
    1,
    ':. escalate: %s [ %s ]',
    substr( $question, 0, 200 ), $severity
);

return $msg;

