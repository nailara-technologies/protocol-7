## [:< ##

# name  = network.lease.load
# descr = read the lease table saved before the restart

my $sref = <[file.zenka_dir.load]>->( <network.cfg.lease_file>, qw| :raw | );
return FALSE if ref $sref ne qw| SCALAR |;
my $lease = <[network.lease.parse]>->( $sref->$* );
## an event that came in since the start wins over the saved one ##
<network.lease>->{$ARG} //= $lease->{$ARG} foreach keys $lease->%*;
<[base.logs]>->( 1, ': %d saved leases read', scalar keys $lease->%* );
return TRUE;

