## [:< ##

# name  = pager.util.editor.format_line
# descr = Format item as single line for editor display

my ($item) = @ARG;

if ( $item->{'checksum'} ) {
    return sprintf( "%s  %s", $item->{'checksum'}, $item->{'path'} // '' );
}

return $item->{'path'} // $item->{'name'} // '(unknown)';

