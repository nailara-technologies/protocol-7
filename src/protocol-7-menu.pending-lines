# name  = protocol-7-menu.pending-lines
# descr = pending questions as p7 config lines [ list \ save ]
# args  = [ only decisions : TRUE ]
#
# question.<id>.<key> = value, one block per question [ type, question,
# options, added, decision ] ; backslash and newline escaped

my $only      = shift;
my $questions = <protocol-7-menu.pending-questions> // [];
my $esc       = sub { ( shift // '' ) =~ s{\\}{\\\\}gr =~ s{\n}{\\n}gr };
my @out;
foreach my $q ( @{$questions} ) {
    next if $only and not $q->{'decision'};
    my $id = $q->{'id'} // '?';
    push @out, "question.$id.type = " . $esc->( $q->{'type'} );
    push @out, "question.$id.question = " . $esc->( $q->{'question'} );
    push @out,
        "question.$id.options = " . $esc->( join ', ', @{ $q->{'options'} } )
        if ref $q->{'options'} eq qw| ARRAY | and @{ $q->{'options'} };
    push @out, "question.$id.added = " . $esc->( $q->{'added'} );
    push @out, "question.$id.decision = yes" if $q->{'decision'};
}
return @out;

