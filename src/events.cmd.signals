## [:< ##

# name  = events.cmd.signals
# descr = list the last signals : events.signals [ n ]
# param = [ n ]
# descr = last n signals [ time, name, source, woken, values ]

my $count = $call->{'args'} // 20;
$count =~ s{\A\s+|\s+\z}{}g;
$count = 20 if !length $count;

return { 'mode' => qw| false |, 'data' => 'numerical [ n ] expected' }
    if $count !~ m{\A\d+\z};

my $records = <[events.signal.journal_read]>->($count);

return { 'mode' => qw| false |, 'data' => 'no signals raised' }
    if !@{$records};

my @lines;
foreach my $rec ( @{$records} ) {
    my $values = $rec->{'values'};
    my $woken
        = @{ $rec->{'woken'} }
        ? join( ', ', @{ $rec->{'woken'} } )
        : 'nothing';
    my $pairs = join ' ',
        map { $ARG . '=' . $values->{$ARG} } sort keys %{$values};
    push @lines, sprintf "%s %s from %s : woke %s%s\n", $rec->{'time'},
        $rec->{'name'}, $rec->{'source'}, $woken,
        length $pairs ? " [ $pairs ]" : '';
}

return { 'mode' => qw| size |, 'data' => join( '', @lines ) };

