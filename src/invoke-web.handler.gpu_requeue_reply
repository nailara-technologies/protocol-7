# name  = invoke-web.handler.gpu_requeue_reply
# descr = cuda-failed items retried : resume the queue, recovery done

my $reply = shift // {};
my $count = $reply->{'params'}->{'count'};

<[base.logs]>->(
    $reply->{'ok'} ? 1 : 0,
    'gpu : %s',
    $reply->{'ok'}
    ? sprintf( '%d cuda-failed items re-queued', $count )
    : "retry failed [ $reply->{'status'} ] -- queue stays paused"
) if defined $count;

delete <invoke-web.gpu_recover>;
return if not $reply->{'ok'};

<[invoke-web.api_async]>->(
    'PUT', '/api/v1/queue/default/processor/resume',
    undef, 'invoke-web.handler.gpu_resume_reply'
);

