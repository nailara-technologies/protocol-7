## [:< ##

# name = data.mount.shm.lock.unlock
# descr = Unlock (release) a locked region of SHM

# thin zenka wrapper -> AMOS7::SHM::unlock_memory [ zero behavior change ;
# the ported body was already zenka-agnostic pure perl ]

my ( $mmap_ref, $offset, $size ) = @ARG;

return AMOS7::SHM::unlock_memory( $mmap_ref, $offset, $size );

