## [:< ##

# name     = base.parser.command_list
# args     = <cmd_aref>, [section_name]
# descr    = format command list with short descriptions
# return   = plain[ formatted command list ]

my $cmd_aref  = shift;
my $section   = shift // qw| cmd |;    # [cmd|console]
my $max_len   = shift // 0;
my $reply_str = '';
my @commands;
my %param;

##  aliases [ added by init code ] share the entry of their target sub  ##
my %entry_by_sub;
foreach my $name ( keys <base.commands>->{$section}->%* ) {
    my $sub_name = $data{'base'}{$section}{$name} // next;
    $entry_by_sub{$sub_name} //= <base.commands>->{$section}{$name};
}
foreach my $name ( $cmd_aref->@* ) {
    my $sub_name = $data{'base'}{$section}{$name} // next;
    <base.commands>->{$section}{$name} //= $entry_by_sub{$sub_name}
        if defined $entry_by_sub{$sub_name};
}

map {
    if ( not exists $data{'base'}{$section}{$ARG} ) {
        my $cli = " $section";
        $cli = '' if $section eq qw| cmd |;
        warn $cli . " cmd '$ARG' does not exist! <{C1}>";
    } else {
        my $cmd_str = $ARG;
        if ( exists <base.commands>->{$section}{$ARG}{'param'} ) {
            my $param_str
                = <base.commands>->{$section}{$ARG}{'param'};
            $cmd_str .= ' ' . $param_str;
            $param{$ARG} = $param_str;
        }
        $max_len = length($cmd_str) if length($cmd_str) > $max_len;
        push( @commands, $ARG );
    }
} @$cmd_aref;
$max_len += 2;

foreach my $cmd (@commands) {
    my $cmd_descr;
    my $call_cmd = $data{'base'}{$section}{$cmd};
    if ( exists $code{$call_cmd} and defined &{ $code{$call_cmd} } ) {
        if ( defined <base.commands>->{$section}{$cmd} ) {
            $cmd_descr = <base.commands>->{$section}{$cmd}{'descr'};
        }
        $cmd_descr = qw| n\\a |
            if not defined $cmd_descr or not length $cmd_descr;
    } else {
        $cmd_descr = "<< broken command >> [ '$cmd' ]";
    }
    $cmd .= ' ' . $param{$cmd} if exists $param{$cmd};
    my $dots = $max_len - length($cmd);
    $reply_str .= "$cmd " . '_' x $dots . " $cmd_descr\n";
}

return ( \$reply_str, $max_len );

