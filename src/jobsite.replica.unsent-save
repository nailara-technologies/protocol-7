## [:< ##

# name  = jobsite.replica.unsent-save
# descr = persist the unsent ui actions so a restart does not lose them

my $unsent = <jobsite.replica.unsent>                           // [];
my $json   = eval { JSON::XS->new->canonical->encode($unsent) } // '[]';
<[file.zenka_dir.write]>->( 'replica-unsent.json', \$json, '>', 0640 );

