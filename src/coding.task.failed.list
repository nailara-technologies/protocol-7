## [:< ##

# name  = coding.task.failed.list
# descr = list failed tasks with optional filters

my ( $filter_type, $max_results ) = @ARG;

$max_results //= 20;

my $queue_href  = <coding.task.queue>  // {};
my $aref_failed = <coding.task.failed> // [];
my @results;

for my $task_id (
    sort {
        ( $queue_href->{$b}->{'execution'}->{'failed_at'} // 0 )
            <=> ( $queue_href->{$a}->{'execution'}->{'failed_at'} // 0 )
    } $aref_failed->@*
) {
    my $task = $queue_href->{$task_id} // next;
    my $exec = $task->{'execution'}    // {};

    ## filter by failure type if requested ##
    if ( defined $filter_type && length $filter_type ) {
        next unless ( $exec->{'failure_type'} // '' ) eq $filter_type;
    }

    push @results,
        {
        'task_id'   => $task_id,
        'failed_at' => $exec->{'failed_at'},
        'error'     => <[base.parser.ellipse_center]>->(
            $exec->{'error'} // 'unknown', 80
        ),
        'failure_type' => $exec->{'failure_type'} // 'unknown',
        'retry_count'  => $exec->{'retry_count'}  // 0,
        'type'         => $task->{'type'}         // 'unknown',
        };

    last if @results >= $max_results;
}

return {
    'mode' => qw| true |,
    'data' => \@results,
};

