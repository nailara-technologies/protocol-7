# name  = branch.discover.handler.register_reply
# descr = handle reply from discover.branch.register

my $reply   = shift;
my $node_id = $reply->{'params'}{'node_id'} // '';

return unless length $node_id;
return unless exists $data{'branch.nodes'}{$node_id};

$data{'branch.nodes'}{$node_id}{'discovered'} = TRUE;
delete $data{'branch.discover.pending'}{$node_id};

<[base.logs]>
    ->( 2, 'branch.discover.register_reply: %s confirmed', $node_id );

return { 'mode' => 'true', 'data' => $node_id };

