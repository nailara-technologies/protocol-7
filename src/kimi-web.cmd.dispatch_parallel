## [:< ##

# name  = kimi-web.cmd.dispatch_parallel
# descr = dispatch prompt to multiple agents, aggregate results
# param = agent_ids   - array of agent identifiers
# param = prompt      - work to dispatch to all agents
# param = aggregation - concat|vote|best|merge (default concat)
# param = timeout     - timeout in seconds (default 300)

my $args = $call->{'args'} // {};
if ( not ref $args ) {
    my $args_str = $args;
    $args = {};
    for my $token ( split m|\s+|, $args_str ) {
        $args->{ lc $1 } = $2 if $token =~ m{^([\w\-]+)=(.*)$};
    }
    ## agent_ids= arrives comma-separated over the string-args path ##
    $args->{'agent_ids'} = [ split m|,|, $args->{'agent_ids'} ]
        if defined $args->{'agent_ids'};
}

my $agent_ids   = $args->{'agent_ids'}   // [];
my $prompt      = $args->{'prompt'}      // '';
my $aggregation = $args->{'aggregation'} // qw| concat |;
my $timeout     = $args->{'timeout'}     // 300;

## validate ##
if ( not @$agent_ids ) {
    return {
        'mode' => qw| false |,
        'data' => 'agent_ids array is required'
    };
}
if ( not length $prompt ) {
    return {
        'mode' => qw| false |,
        'data' => 'prompt is required'
    };
}

my $registry = <kimi-web.agent.registry> // {};
my @ready_agents;

## filter to ready agents ##
for my $agent_id (@$agent_ids) {
    my $agent = $registry->{$agent_id};
    if ( defined $agent and $agent->{'status'} eq qw| ready | ) {
        push @ready_agents, $agent_id;
    }
}

if ( not @ready_agents ) {
    return {
        'mode' => qw| false |,
        'data' => 'no ready agents found in provided list'
    };
}

## dispatch to all agents in parallel (async) ##
my $reply_id = $call->{'reply_id'} // '';
my $batch_id = sprintf( 'batch-%d', <[base.ntime.b32]> );

## store batch state ##
<kimi-web.agent.batches> //= {};
<kimi-web.agent.batches> {$batch_id} = {
    'agent_ids'   => \@ready_agents,
    'results'     => {},
    'completed'   => 0,
    'total'       => scalar @ready_agents,
    'aggregation' => $aggregation,
    'reply_id'    => $reply_id,
    'started_at'  => <[base.ntime]>,
    'timeout'     => $timeout,
};

## fire off async requests ##
for my $agent_id (@ready_agents) {
    my $agent = $registry->{$agent_id};
    my $port  = $agent->{'port'};
    my $url   = "http://127.0.0.1:$port/v1/chat";

    my $request_body = <[base.json.encode]>->(
        {   'prompt'   => $prompt,
            'stream'   => \0,
            'timeout'  => $timeout,
            'batch_id' => $batch_id,
        }
    );

    <[clients.http.post]>->(
        {   'url'     => $url,
            'body'    => $request_body,
            'timeout' => $timeout,
            'on_done' => 'kimi-web.handler.batch_result',
            'params'  => { 'agent_id' => $agent_id, 'batch_id' => $batch_id },
        }
    );
}

## schedule timeout check ##
<[event.add_timer]>->(
    {   'after'   => $timeout + 5,
        'handler' => 'kimi-web.handler.batch_timeout_check',
        'data'    => { 'batch_id' => $batch_id },
    }
);

<[base.logs]>->(
    2, ': dispatched batch %s to %d agents [ agg: %s ]',
    $batch_id, scalar @ready_agents, $aggregation
);

return { 'mode' => qw| deferred | };

