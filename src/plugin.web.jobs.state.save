## [:< ##

# name  = plugin.web.jobs.state.save
# descr = save browser-owned fields of a single job record

my $id    = shift // '';
my $delta = shift // {};

return FALSE if not length $id;
return FALSE if ref $delta ne 'HASH';

## locate job via index ##
my $cache_dir = <[plugin.web.jobs.cache.path]>;
my $status    = <plugin.web.jobs.index>->{$id} // '';
my $enc_id    = $id;

my $job_file;
if ( $status =~ m{^(blocked|deleted):(.+)$} ) {
    $job_file = "$cache_dir/$1/$2/$enc_id.yaml";
} elsif ( length $status ) {
    $job_file = "$cache_dir/$status/$enc_id.yaml";
} else {
    $job_file = "$cache_dir/new/$enc_id.yaml";
}

my ( $job, $yaml_err ) = <[format.yaml.load_file]>->($job_file);
if ( defined $yaml_err ) {
    <[base.logs]>->(
        0,   'plugin.web.jobs.state.save: load error %s: %s',
        $id, $yaml_err
    );
    return FALSE;
}

return FALSE if ref $job ne 'HASH';

## merge only browser-owned fields ##
for my $field (qw| stage notes date_applied |) {
    $job->{$field} = $delta->{$field}
        if exists $delta->{$field};
}

## queue reverse change so jobsite learns of browser update ##
<[plugin.web.jobs.reverse.queue]>->( { 'id' => $id, %{$delta} } );

return <[plugin.web.jobs.cache.write]>->( $id, $job );

