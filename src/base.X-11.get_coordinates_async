## [:< ##

# name  = base.X-11.get_coordinates_async
# param = <continuation-handler-name>, [continuation-params-href]
# descr = async variant of base.X-11.get_coordinates -- requests this zenka's
#         tile/strip coordinates from the tile zenka via cube and invokes the
#         continuation once resolved, instead of blocking on a readline loop
#         [ which cannot resolve a deferred reply ]. the reply handler stores
#         <x11.coordinates> on success or marks them undefined on failure;
#         the continuation owns any fallback SHAPING, since strip-vs-window
#         shape differs per zenka.

my $continuation_handler = shift;
my $continuation_params  = shift;

return warn 'expected continuation handler name <{C1}>'
    if not defined $continuation_handler;

my $zenka_subname = <system.zenka.subname>;
my $sn_str
    = defined $zenka_subname
    ? ' ' . <system.zenka.name> . "[$zenka_subname]"
    : '';

<[base.logs]>->(
    1, 'requesting coordinates [async], continuation -> %s',
    $continuation_handler
);

## bounded fallback: if tile is offline or the reply is otherwise lost,   ##
## fire the continuation once with coordinates_were_undefined=TRUE rather ##
## than hanging startup indefinitely. the real reply cancels this timer.  ##
if ( defined <x11.coordinates_async_timer> ) {
    <x11.coordinates_async_timer>->cancel
        if <x11.coordinates_async_timer>->is_active;
    delete <x11.coordinates_async_timer>;
}

<x11.coordinates_async_continuation> = {
    'handler' => $continuation_handler,
    'params'  => $continuation_params
};

## bounded fallback timeout : configurable, defaults to 7s -- comfortably  ##
## under the v7 zenka start-up timeout [ 13s minimum ] so the zenka comes  ##
## up on fallback geometry instead of being failed for a start-up timeout. ##
## a named handler [ not an inline cb ] survives source-code reload,       ##
## matching the codebase timer idiom [ cf. v7-zenki.zenka.start /          ##
## mpv.cmd.resume ].                                                       ##
my $fallback_after = <x11.coordinates_fallback_timeout> // 7;

<x11.coordinates_async_timer> = <[event.add_timer]>->(
    {   'after'   => $fallback_after,
        'desc'    => 'x11.coordinates_async_fallback',
        'handler' => qw| base.X-11.handler.coordinates_timeout |,
    }
);

<[protocol-7.route-send]>->(
    {   'command'   => qw| tile.get_coordinates |,
        'call_args' => { 'args' => $sn_str },
        'reply'     => {
            'handler' => qw| base.X-11.handler.coordinates_reply |,
            'params'  => {
                'continuation_handler' => $continuation_handler,
                'continuation_params'  => $continuation_params
            }
        }
    }
);

return TRUE;

