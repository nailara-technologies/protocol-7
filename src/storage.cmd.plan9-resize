## [:< ##
# name  = storage.cmd.plan9-resize
# descr = Resize (truncate) a file over 9P

my $args = $call->{'args'} // '';
my ( $name, $path, $length ) = split /\s+/, $args, 3;

if (   not length( $name // '' )
    or not length( $path // '' )
    or not defined $length
    or $length !~ /^\d+$/ ) {
    return {
        'mode' => 'false',
        'data' => 'usage: plan9-resize <connection-name> <path> <length>'
    };
}

my $conn = <storage.9p.connections>->{$name};
return { 'mode' => 'false', 'data' => 'not connected' } unless $conn;

my $result = <[storage.9p.resize-path]>->( $conn, $path, $length );
return $result if $result->{'mode'} eq 'false';

return {
    'mode' => 'true',
    'data' => "resized $path to $length bytes"
};

