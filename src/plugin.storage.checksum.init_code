## [:< ##
# name  = plugin.storage.checksum.init_code
# descr = Initialize checksum-based storage mapping plugin

## Initialize checksum mapping registry ##
<storage.mapping.checksum> = {
    'enabled'    => 1,
    'algorithms' => {},    # algorithm -> { priority, impl }
    'cache'      => {},    # path -> { checksum, mtime, size }
    'reverse'    => {},    # checksum -> [ paths ]
    'stats'      => {
        'hashed'     => 0,
        'cached'     => 0,
        'collisions' => 0,
    },
};

## Available BMW checksum algorithms ##
<storage.mapping.checksum.algorithms> = {

    # Standard file checksums
    ## all four : chk-sum.bmw.filesum with the bit size [ bmw = 384 ] ##
    'bmw'     => { 'priority' => 1, 'module' => qw| chk-sum.bmw.filesum | },
    'bmw-224' => { 'priority' => 2, 'module' => qw| chk-sum.bmw.filesum | },
    'bmw-384' => { 'priority' => 2, 'module' => qw| chk-sum.bmw.filesum | },
    'bmw-512' => { 'priority' => 3, 'module' => qw| chk-sum.bmw.filesum | },

    # L13 for @INDEXCUBE integration
    'bmw-L13' => { 'priority' => 4, 'module' => qw| chk-sum.bmw.L13-str | },
    'bmw-L13-b32' =>
        { 'priority' => 5, 'module' => qw| chk-sum.bmw.str-b32.L13 | },

    # AMOS checksums
    'amos' => { 'priority' => 6, 'module' => qw| chk-sum.amos | },
};

<[base.logs]>->(
    1, "storage mapping plugin initialized: checksum [BMW|AMOS|L13]"
);

0;

