## [:< ##

# name  = letsencr.child.acme.step_respond
# param = <order_id>
# descr = tell the acme server the next challenge is ready

my $order = <[letsencr.child.acme.order_of]>->( shift, qw| respond | )
    // return FALSE;

my $url = shift $order->{'todo'}->@*;

if ( not defined $url ) {    ## all responded : validation runs now ##
    $order->{'step'} = qw| poll_authz |;
    return <[letsencr.child.acme.schedule_poll]>->(
        {   'order_id' => $order->{'order_id'},
            'delay'    => 2,
            'handler'  => qw| letsencr.child.acme.step_poll_authz |,
            'data'     => { 'order_id' => $order->{'order_id'} },
        }
    );
}

my $authz = $order->{'authz'}->{$url};

<[letsencr.child.acme.request]>->(
    {   'method'   => qw| POST |,
        'url'      => $authz->{'challenge_url'},
        'payload'  => {},
        'order_id' => $order->{'order_id'},
        'on_done'  => qw| letsencr.child.acme.on_respond |,
        'params'   => { 'order_id' => $order->{'order_id'}, 'authz' => $url },
    }
);

return TRUE;

