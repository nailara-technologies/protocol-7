## [:< ##

# name  = events.remote.line
# descr = validate and raise one received remote journal record
# args  = native line [ octets ], stream child handle
#
# fail closed : only an exact alias + name pair from events.remote.pull.<alias>
# is accepted. the remote host field belongs to the id, never to local routing

my ( $line, $handle ) = @ARG;
my $alias = $handle->{'data'}{'alias'}     // return FALSE;
my $run   = <events.remote.runs>->{$alias} // return FALSE;
return FALSE if ( $run->{'handle'} // '' ) ne $handle;

utf8::decode($line);
return $run->{'invalid'}++
    if $line
    !~ m|\Aremote\.([A-Z0-9]{13}) = host:(\S+) time:(\d+) name:(\S+) values:(\S+)\z|;
my ( $id, $host, $unix, $name, $encoded_values ) = ( $1, $2, $3, $4, $5 );
$name = <[events.signal.decode]>->($name);
my %allow = map { $ARG => TRUE } grep {length}
    split m{\s+}, <events.remote.pull>->{$alias} // '';

if ( $name !~ m|\A[a-z0-9][a-z0-9._-]{0,79}\z| or not $allow{$name} ) {
    ## the names go into the completion line [ what was refused ] ##
    my $shown = $name =~ m|\A[\x21-\x7e]{1,80}\z| ? $name : '?';
    $run->{'refused_names'}{$shown}++;
    return $run->{'refused'}++;
}

my $state = <events.remote.states>->{$alias}
    //= <[events.remote.state]>->($alias);
$run->{'records'}++;
$run->{'max_time'} = $unix if $unix > ( $run->{'max_time'} // 0 );
return TRUE                if exists $state->{'seen'}{$id};

my %values;
foreach
    my $pair ( $encoded_values eq qw| - | ? () : split m{,}, $encoded_values )
{
    my ( $key, $value ) = split m{=}, $pair, 2;
    $values{ <[events.signal.decode]>->($key) }
        = <[events.signal.decode]>->( $value // '' );
}
$values{'from'} = $alias;

$state->{'seen'}{$id} = $unix;
push @{ $state->{'order'} }, $id;
while ( @{ $state->{'order'} } > 500 ) {
    my $old = shift @{ $state->{'order'} };
    delete $state->{'seen'}{$old};
}
$run->{'hits'}++;
<[events.signal.raise]>->( qw| events.remote |, "$name\@$alias", \%values );
return TRUE;

