## [:< ##

# name  = nameserv.sync.ts-oldest
# descr = the oldest valid ntime b32 ts [ since from nothing ]

## one second of network time : every timestamped entry is newer ##
return <[base32.encode]>->( pack qw| w |, 4200 );

