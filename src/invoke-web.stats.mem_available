# name   = invoke-web.stats.mem_available
# descr  = MemAvailable in MB [ one /proc/meminfo read : sampled with every
#          gpu temperature line while a render runs ]
# return = MB | undef

open my $fh, qw| < |, '/proc/meminfo' or return undef;
while ( my $line = <$fh> ) {
    next if $line !~ m{^MemAvailable:\s+(\d+)};
    close $fh;
    return int( $1 / 1024 );
}
close $fh;

return undef;

