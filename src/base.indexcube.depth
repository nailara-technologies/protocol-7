## [:< ##

# name  = base.indexcube.depth
# descr = Return tamper-evidence depth (scalar @INDEXCUBE)

my $depth = scalar(@INDEXCUBE);

return {
    'mode' => qw| true |,
    'data' => {
        'depth'     => $depth,
        'is_origin' => $depth == 1,
        'is_empty'  => $depth == 0,
    }
};

