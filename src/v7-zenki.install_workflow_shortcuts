## [:< ##

# name  = v7-zenki.install_workflow_shortcuts
# descr = install p7.<shorthand> launcher link chains for console shortcuts
#
## each shorthand becomes a 'p7.<shorthand>' -> 'p7-<zenka>' link chain [   ##
## an ordinary chain onto the zenka's own link, deliberately NOT a          ##
## recognized name form -- see                                              ##
## data/md/design/ZENKA-SYMLINK-CHAIN-RESOLUTION.md ].  the chain names the ##
## zenka through its 'p7-<zenka>' hop; the alias name reaches the started   ##
## zenka as <system.start.launcher_name> and is expanded into console       ##
## command words by <[base.call.console_command]>.  both sides read the     ##
## single shorthand table in <[path-template.console-shorthand]>            ##

my $root_path     = <system.root_path>;
my $protocol7_bin = sprintf( '%s/bin/Protocol-7', $root_path );
my $symlink_dir   = <v7-zenki.cfg.zenka_symlink_dir> || '/usr/local/bin';
my $enabled = <[base.cfg_bool]>->(<v7-zenki.cfg.install_workflow_shortcuts>);

return FALSE unless $enabled;
return FALSE unless $UID == 0;                             ## root only
return FALSE unless -x $protocol7_bin;
return FALSE unless -d $symlink_dir and -w $symlink_dir;

## shorthand => '<zenka> <console command ..>' [ single table, also read by ##
## <[base.call.console_command]> for the expansion side ]                   ##
my $workflow_shortcuts = <[path-template.console-shorthand]>;

my $installed_count = 0;
my $updated_count   = 0;

## install shorthand alias link chains
foreach my $shorthand ( sort keys %{$workflow_shortcuts} ) {
    my ($zenka_name) = split( m| +|, $workflow_shortcuts->{$shorthand}, 2 );
    my $zenka_link_path = sprintf( '%s/p7-%s', $symlink_dir, $zenka_name );
    my $symlink_path    = sprintf( '%s/p7.%s', $symlink_dir, $shorthand );

    ## the chain walk resolves names, but the boot-time lib-path walk      ##
    ## follows the links themselves -- skip when the 'p7-<zenka>' middle   ##
    ## hop is not [ yet ] installed by <[v7-zenki.install_zenka_symlinks]> ##
    if ( not -l $zenka_link_path
        or readlink($zenka_link_path) ne $protocol7_bin ) {
        <[base.log]>->(
            0,
            ": skipping shortcut '$shorthand' [ "
                . "no $zenka_link_path link installed ]"
        );
        next;
    }

    ## check if symlink already exists and is current
    if ( -l $symlink_path ) {
        my $current_target = readlink($symlink_path);
        if ( $current_target eq $zenka_link_path ) {
            ## already correct, skip
            next;
        } else {
            ## update symlink
            unlink($symlink_path) or do {
                <[base.log]>->(
                    0, ": cannot update shortcut symlink: $symlink_path"
                );
                next;
            };
            $updated_count++;
        }
    }

    ## create shorthand link onto the zenka's own 'p7-<zenka>' link
    if ( symlink( $zenka_link_path, $symlink_path ) ) {
        $installed_count++;
    } else {
        <[base.log]>->(
            0,
            ": failed to create shortcut symlink: $symlink_path [ $OS_ERROR ]"
        );
    }
}

if ( $installed_count > 0 or $updated_count > 0 ) {
    <[base.log]>->(
        1,
        sprintf(
            ": installed %d workflow shortcut%s to %s",
            $installed_count + $updated_count,
            $installed_count + $updated_count == 1 ? '' : 's',
            $symlink_dir
        )
    );

    if ( $installed_count > 0 ) {
        <[base.log]>->(
            2, sprintf( ": :. new shortcuts: %d", $installed_count )
        );
    }
    if ( $updated_count > 0 ) {
        <[base.log]>->( 2, sprintf( ": :. updated : %d", $updated_count ) );
    }
}

return $installed_count + $updated_count;

