# name  = invoke-web.handler.gpu_pause_reply
# descr = queue paused after a cuda error : stop invoke.ai, the start
#         follows once the process is gone [ invoke-web.handler.recover_restart ]

my $reply   = shift                // {};
my $recover = <invoke-web.recover> // return;

<[base.logs]>->(
    $reply->{'ok'} ? 1 : 0,
    'gpu : queue pause %s',
    $reply->{'ok'} ? 'done' : $reply->{'status'}
);

if ( not $recover->{'restart'} ) {
    delete <invoke-web.recover>;    ## paused, left for the user ##
    return;
}

$recover->{'old_pid'} = <invoke-web.pid>;
<[invoke-web.cmd.stop]>->( {} );

<[event.add_timer]>->(
    {   'after'   => 5,
        'handler' => 'invoke-web.handler.recover_restart',
        'data'    => { 'attempt' => 1 },
    }
);

