## [:< ##

# name   = invoke-web.output.stop
# descr  = stop following invoke.ai's output file [ the file stays ]
# note   = the offset is saved first : an adopted process is read on from it

my $watch = delete <invoke-web.output.watch>;
$watch->cancel if defined $watch and ref $watch;
my $timer = delete <invoke-web.output.timer>;
$timer->cancel if defined $timer and ref $timer;

my $pid = delete <invoke-web.output.pid>;
<[file.zenka_dir.write]>->(
    'state/invokeai.out.offset',
    \sprintf( "%d %d\n", $pid, <invoke-web.output.offset> // 0 )
) if defined $pid;

return TRUE;

