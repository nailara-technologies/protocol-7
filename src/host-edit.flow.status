## [:< ##

# name   = host-edit.flow.status
# descr  = set an add-host flow's status text [ + the form status line ]
# param  = <record name> <text>

my ( $name, $text ) = @ARG;

my $state = ( <host-edit.flow> // {} )->{ $name // '' };
$state->{'status'} = $text if ref $state eq qw| HASH |;

<[form.chrome.set_status]>->( sprintf '%s : %s', $name // '?', $text )
    if ref $code{'form.chrome.set_status'} eq qw| CODE |;
return TRUE;

