# name = httpsd.wait_for_certificate
# param = timeout in seconds (optional, default 30)
# descr = wait for certificate to become available, polling with timeout
# return = TRUE [5] if certificate becomes available, FALSE [0] on timeout

my $timeout = shift // <httpsd.cfg.startup_timeout> // 30;

<[base.logs]>->(
    2, 'httpsd: waiting for certificate (timeout: %ds)', $timeout
);

my $start_time    = time();
my $poll_interval = 1;        ## poll every second

while (1) {
    my $elapsed = time() - $start_time;

    ## check if certificate is available
    my $cert_info = <[httpsd.check_certificate_available]>;

    if ( $cert_info->{available} ) {
        <[base.logs]>->(
            2, 'httpsd: certificate became available after %ds', $elapsed
        );
        return TRUE;
    }

    ## timeout check
    if ( $elapsed >= $timeout ) {
        <[base.logs]>->(
            2, 'httpsd: certificate timeout after %ds, giving up', $elapsed
        );
        return FALSE;
    }

    ## wait before next poll
    sleep($poll_interval);

    my $remaining = $timeout - $elapsed;
    if ( $remaining <= 5 ) {
        <[base.logs]>->(
            3, 'httpsd: waiting for certificate... %ds remaining', $remaining
        );
    }
}

0;

