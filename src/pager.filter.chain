## [:< ##

# name  = pager.filter.chain
# descr = Manage filter chains for virtual buffers

my ($args) = @ARG;

my $buffer_id = $args->{'buffer_id'};
my $action    = $args->{'action'};
my $buf       = <pager.buffers>->{$buffer_id};

return undef unless $buf;

if ( $action eq 'add' ) {
    my $filter_type = $args->{'type'};
    my $params      = $args->{'params'} // {};

    push @{ $buf->{'filters'} },
        {
        'type'   => $filter_type,
        'params' => $params,
        };

    # Mark all pages dirty since filter changed
    <[pager.buffer.page.invalidate-all]>->( { 'buffer' => $buf } );

    return scalar( @{ $buf->{'filters'} } );
} elsif ( $action eq 'remove' ) {
    my $index = $args->{'index'};
    return undef
        unless defined $index
        && $index >= 0
        && $index < @{ $buf->{'filters'} };

    splice( @{ $buf->{'filters'} }, $index, 1 );
    <[pager.buffer.page.invalidate-all]>->( { 'buffer' => $buf } );
    return 1;
} elsif ( $action eq 'clear' ) {
    $buf->{'filters'} = [];
    <[pager.buffer.page.invalidate-all]>->( { 'buffer' => $buf } );
    return 1;
} elsif ( $action eq 'list' ) {
    return $buf->{'filters'};
} elsif ( $action eq 'reorder' ) {
    my $new_order = $args->{'order'};    # Array of indices
    return undef unless ref($new_order) eq 'ARRAY';

    my @new_filters;
    for my $idx (@$new_order) {
        push @new_filters, $buf->{'filters'}[$idx]
            if defined $buf->{'filters'}[$idx];
    }

    $buf->{'filters'} = \@new_filters;
    <[pager.buffer.page.invalidate-all]>->( { 'buffer' => $buf } );
    return 1;
}

return undef;

