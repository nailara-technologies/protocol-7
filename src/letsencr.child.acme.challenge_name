## [:< ##

# name  = letsencr.child.acme.challenge_name
# descr = the dns-01 record name for a domain, following its alias
# param = <base domain> -> '_acme-challenge.<base or its alias>'
# note  = letsencr.dns.challenge_alias : 'domain:alias' pairs, e.g.
#         'protocol-7.network:acme.protocol-7.network'. the registrar's
#         zone carries _acme-challenge.<domain> CNAME
#         _acme-challenge.<alias> and delegates <alias> to our nameserv --
#         records are written and checked at the alias, no registrar
#         credentials needed. no pair for a domain : <prefix>.<domain>
#         with letsencr.dns.challenge_alias_prefix set, else the name itself

my $base = shift // '';

my %alias = map { split m|:|, $ARG, 2 } grep {m|:|}
    split m|[\s,]+|, <letsencr.dns.challenge_alias> // '';

## convention instead of one pair per domain : with a prefix [ 'acme' ] ##
## every domain without its own pair uses <prefix>.<domain>             ##
my $prefix = <letsencr.dns.challenge_alias_prefix> // '';
$prefix =~ s{\.+$}{};
my $alias = $alias{ lc $base }
    // ( length $prefix ? sprintf( '%s.%s', $prefix, lc $base ) : $base );

return '_acme-challenge.' . $alias;

