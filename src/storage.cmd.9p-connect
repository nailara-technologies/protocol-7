## [:< ##
# name  = storage.cmd.9p-connect
# descr = Connect to 9P server

my $args = $call->{'args'} // '';
my ( $host, $port, $name ) = split /\s+/, $args, 3;

$host //= '127.0.0.1';
$port //= 5640;
$name //= "$host:$port";

my $result = <[storage.9p.connect]>->(
    {   host => $host,
        port => $port,
        name => $name,
    }
);

if ( $result->{'mode'} eq 'true' ) {
    return {
        'mode' => 'size',
        'data' => "Connected to 9P server $name at $host:$port\n"
    };
} else {
    return $result;
}

