## [:< ##

# name  = claude.cmd.sessions
# descr = registered live sessions and since when

## names and times only : the token is never shown. a session whose socket ##
## path is gone is dropped here [ its token with it ]                      ##

my $sessions = <[claude.live.sessions]>;
my @lines;
foreach my $name ( CORE::sort CORE::keys %{$sessions} ) {
    my $s = $sessions->{$name};
    if ( not -S $s->{'socket'} ) {
        CORE::delete $sessions->{$name};
        <[base.log]>->( 1, ": live session $name dropped [ socket gone ]" );
        next;
    }
    CORE::push @lines,
        CORE::sprintf( '%s : since %s',
        $name, CORE::scalar( CORE::localtime $s->{'since'} ) );
}
return { 'mode' => qw| true |, 'data' => 'no live session registered' }
    if not @lines;
return { 'mode' => qw| size |, 'data' => CORE::join( "\n", @lines ) . "\n" };

