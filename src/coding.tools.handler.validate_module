## [:< ##

# name  = coding.tools.handler.validate_module
# descr = dispatch validate_module tool call to coding.validate.module

my $tool_call = shift // {};

my $args = $tool_call->{'function'}->{'arguments'} // {};

## extract parameters ##
my $module = $args->{'module'} // '';

## validate module name ##
return { 'mode' => qw| false |, 'data' => 'module parameter required' }
    unless length $module;

## call the validate module ##
my $result = <[coding.validate.module]>->($module);

## format response ##
my $data = $result->{'data'};

if ( !$data->{'valid'} ) {
    my $output = "Validation FAILED for '$module':\n\n";

    if ( @{ $data->{'errors'} } ) {
        $output .= "ERRORS:\n";
        for my $err ( @{ $data->{'errors'} } ) {
            $output .= "  ✗ $err\n";
        }
        $output .= "\n";
    }

    if ( @{ $data->{'warnings'} } ) {
        $output .= "WARNINGS:\n";
        for my $warn ( @{ $data->{'warnings'} } ) {
            $output .= "  ⚠ $warn\n";
        }
    }

    return { 'mode' => qw| false |, 'data' => $output };
} else {
    my $output = "Validation PASSED for '$module'\n";

    if ( @{ $data->{'warnings'} } ) {
        $output .= "\nWARNINGS:\n";
        for my $warn ( @{ $data->{'warnings'} } ) {
            $output .= "  ⚠ $warn\n";
        }
    } else {
        $output .= "No issues found.\n";
    }

    return { 'mode' => qw| true |, 'data' => $output };
}

