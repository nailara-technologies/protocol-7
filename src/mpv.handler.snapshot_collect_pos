## [:< ##

# name  = mpv.handler.snapshot_collect_pos
# descr = snapshot collect chain : time-pos reply, then request playlist

my $time_pos = shift;

## time-pos restores more precisely than percent-pos      ##
## [ absolute seconds, no dependency on stream duration ] ##
<mpv.snapshot.pending.pos> = $time_pos
    if defined $time_pos and $time_pos =~ m|^-?\d+(\.\d+)?$|;

<mpv.snapshot.pending.stage> = qw| playlist |;
push(
    <mpv.command.reply>->@*,
    {   'handler'  => qw| mpv.handler.snapshot_collect_playlist |,
        'callback' => qw| mpv.handler.snapshot_collect_error |,
    }
);
<[mpv.send_command]>->( 'get_property_string', 'playlist' );

return;

