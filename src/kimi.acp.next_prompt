## [:< ##

# name   = kimi.acp.next_prompt
# descr  = send the next queued text as a session/prompt
# return = TRUE when one went out

## one active prompt per session : only from phase `ready` ##

my $st = <[kimi.acp.state]>;
return FALSE
    if $st->{'phase'} ne qw| ready |
    or $st->{'stopping'}
    or not @{ $st->{'queue'} };

my $text = shift @{ $st->{'queue'} };
$st->{'phase'} = qw| prompting |;
$st->{'turn'}  = { 'started' => time };
$st->{'turns'}++;
<[kimi.acp.event]>->( qw| prompt |, $text );

## the session registry : a keep-alive prompt is no new activity ##
<[protocol-7.command.send.local]>->(
    {   'command'   => qw| cube.coding.session-touch |,
        'call_args' => {
            'args' => 'name=kimi-acp type=kimi-acp via='
                . ( $text =~ m{\Akeep-alive \[} ? 'keepalive' : 'prompt' )
        }
    }
);

## route-send only buffers, and in order : start goes before done ##
my $session = ( $st->{'session_id'} // qw| none | ) =~ s{[^\w.:-]}{_}gr;
<[protocol-7.route-send]>->(
    {   'command'   => qw| events.signal |,
        'call_args' => {
            'args' => "kimi.run.start session=$session turn=$st->{'turns'}"
        },
        'reply' => {
            'handler' => qw| kimi.handler.acp_signal_reply |,
            'params'  => { 'signal' => qw| kimi.run.start | }
        }
    }
);
<[kimi.acp.rpc]>->(
    qw| session/prompt |,
    {   'sessionId' => $st->{'session_id'},
        'prompt'    => [ { 'type' => qw| text |, 'text' => $text } ]
    },
    qw| prompt |
);
return TRUE;

