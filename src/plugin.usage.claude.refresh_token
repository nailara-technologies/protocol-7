# name  = plugin.usage.claude.refresh_token
# descr = start `claude` attached to a real pty, chdir'd into the already-
#         trusted project root with mcp server loading suppressed, let it run
#         undisturbed for the full timeout, then ask it to exit [ ctrl-d,
#         sigterm, sigkill as successive fallbacks ] -- claude code refreshes
#         its own oauth token during startup, before any prompt is ever
#         submitted, mirroring plugin.usage.kimi.refresh_token's proven
#         mechanism [ confirmed live 2026-09-16 : starting the interactive
#         claude cli by hand made both the zenka's own probe and the
#         standalone bin/dev/usage-external script succeed again after a
#         401 ]
# param = [ timeout ] [ { on_done => { handler => <name>, params => {} } } ]
# note  = a REAL PTY, not a plain pipe -- confirmed live 2026-09-16 : with
#         stdout not a tty, claude auto-switches into --print mode and
#         requires an actual prompt [ "Input must be provided either through
#         stdin or as a prompt argument when using --print" ], and feeding it
#         one would submit a real, token-costing message -- exactly what this
#         module must never do. pty.spawn's own module note warns against
#         reaching for a real pty on suspicion alone ; this is the provable
#         case it asks for -- see that module's note
# note  = chdir target is <system.root_path>, matching kimi's refresh_token --
#         reversed live 2026-09-16 from an earlier $home_dir choice : a
#         never-before-seen directory hits claude code's own first-run "do you
#         trust this folder" dialog, and a single early keypress [ see the
#         history below ] could not reliably clear it -- the project root is
#         already trusted [ this very session runs interactively from it ],
#         so the dialog never appears at all. the recursion concern that
#         originally motivated $home_dir [ this project's own .mcp.json
#         starting the protocol-7 mcp server as a side effect of every
#         background refresh ] is handled separately below, via
#         --strict-mcp-config
# note  = `--strict-mcp-config` is passed with no `--mcp-config` value, which
#         loads zero mcp servers [ confirmed live 2026-09-16 ] -- this is what
#         actually avoids the .mcp.json recursion now that chdir targets the
#         project root instead of avoiding the directory outright
# note  = single-slot -- see plugin.usage.kimi.refresh_token's module note :
#         same reload-safety contract [ named handlers only, no coderef
#         closures ], same reasoning for sigterm-before-sigkill [ a refreshed
#         credential flushed on a deferred \ on-exit path would be lost to a
#         bare sigkill ]. this module adds one more tier ahead of sigterm : a
#         single ctrl-d byte on the pty first, the same keypress an
#         interactive user's ctrl-d would send and the most likely to reach
#         claude code's own clean-shutdown path [ mirrors pty.spawn's own
#         discipline, made non-blocking -- see plugin.usage.claude.
#         refresh_finish and refresh_reap ]
# note  = manual-trigger history [ usage.cmd.claude-refresh-test, a live
#         verification aid, not the 401 path itself ] : 1st run raced
#         plugin.usage.claude.refresh_reap's own waitpid($pid) poll against
#         base.sig_chld's catch-all waitpid(-1) and mislabeled a real,
#         sigterm-honored exit as 'killed' -- fixed via a kill(0,$pid)
#         existence check, see refresh_reap's module note. 2nd run [ fix
#         verified, but still $home_dir at the time ] exposed the real
#         problem : claude sat the entire run [ 45s tested ] on its own
#         first-run "do you trust this folder" dialog, unconfirmed -- the
#         pty output preview [ see refresh_cleanup ] caught the dialog text
#         directly. root cause : the single "\r" keypress below is written
#         to the pty immediately after fork(), before claude's own raw-mode
#         stdin reader ever attaches, and was silently lost. fixed by
#         switching chdir to <system.root_path> [ already trusted, no dialog
#         to clear at all -- see the module note above ]. 3rd run [ trust
#         dialog gone, confirmed ] exposed a different problem : the pty
#         output preview showed "Claude Code v2.0.13" stuck in a failing
#         auto-update loop for the entire run, never reaching anything
#         oauth-related -- `file.which(qw|claude|)` was finding
#         /usr/local/bin/claude, a stale Oct-2025 global npm install
#         [ /usr/local/lib/node_modules/@anthropic-ai/claude-code/cli.js ]
#         that happens to sit on a baseline system PATH entry bin/Protocol-7's
#         cleaning doesn't strip, BEFORE this code ever reached the
#         known-good home-relative fallback below. fixed by trying the
#         home-relative path first -- see the binary-resolution block below.
#         still untested end-to-end against a genuinely expired token as of
#         this note -- the fixture-based verification approach remains
#         blocked, see data/ai-mem/claude/
#         project-claude-usage-refresh-pending-verification.md

use POSIX ();

my $timeout = shift // 18;
my $args    = shift // {};

## see plugin.usage.kimi.refresh_token for why this unwraps two call shapes ##
my $on_done = $args;
$on_done = $args->{'on_done'}
    if ref $args eq qw| HASH |
    and ref $args->{'on_done'} eq qw| HASH |;

my $provider = <usage.provider.claude>;

## single slot : never stack two refresh children on top of each other ##
if ( ref $provider->{'refresh_state'} eq qw| HASH | ) {
    <[base.logs]>->(
        1,
        '[usage.claude.refresh_token] refresh already '
            . 'in progress [ pid %d ] : not starting another',
        $provider->{'refresh_state'}->{'pid'} // 0
    );
    return FALSE;
}

my $home_dir = ( getpwuid($UID) )[7] // $ENV{'HOME'} // '';

## the home-relative known-good install is tried FIRST here -- reversed order
## from plugin.usage.kimi.refresh_token's identical-looking resolution on
## purpose, see the module note above : a bare file.which(qw|claude|) found a
## stale, unrelated global npm install squatting on a baseline system PATH
## entry before it ever reached this fallback
my $claude_bin;
if ( length $home_dir and length $provider->{'cli_rel_path'} ) {
    my $candidate = catfile( $home_dir, $provider->{'cli_rel_path'} );
    $claude_bin = $candidate if -x $candidate;
}

$claude_bin ||= <[file.which]>->(qw| claude |);

if ( not length $claude_bin ) {
    <[base.logs]>->(
        0,
        '[usage.claude.refresh_token] cannot locate claude '
            . 'binary [ PATH lookup and known install path both failed ]'
    );
    return FALSE;
}

my $pty;
eval { $pty = IO::Pty->new };

if ( not $pty ) {
    <[base.logs]>->(
        0, '[usage.claude.refresh_token] cannot allocate pty : %s',
        <[base.str.eval_error]>
    );
    return FALSE;
}

my $pid = fork();

if ( not defined $pid ) {
    <[base.logs]>->(
        0, '[usage.claude.refresh_token] fork failed : %s',
        <[base.str.os_err]>
    );
    close($pty);
    return FALSE;
}

if ( $pid == 0 ) {
    ## make the pty's slave side this process' real controlling terminal, then
    ## exec -- claude sees an actual terminal, not a pipe [ see the module
    ## note above on why that distinction matters here ]
    $pty->make_slave_controlling_terminal();
    my $slave = $pty->slave;

    ## a freshly allocated pty starts at 0x0 unless something sizes it -- same
    ## floor pty.spawn applies, for the same reason [ several tui frameworks
    ## refuse to render properly otherwise ]
    my ( $min_rows, $min_cols ) = ( 24, 80 );
    $slave->clone_winsize_from( \*STDIN ) if -t STDIN;
    my ( $rows, $cols ) = $slave->get_winsize();
    $slave->set_winsize( $min_rows, $min_cols, 0, 0 )
        if not $rows
        or $rows < $min_rows
        or not $cols
        or $cols < $min_cols;

    close($pty);
    open( STDIN,  '<&', $slave->fileno ) or POSIX::_exit(1);
    open( STDOUT, '>&', $slave->fileno ) or POSIX::_exit(1);
    open( STDERR, '>&', $slave->fileno ) or POSIX::_exit(1);
    close($slave);

    ## already trusted -- see the module note above on why this replaced ##
    ## $home_dir                                                         ##
    chdir( <system.root_path> // $home_dir );

    ## --strict-mcp-config with no --mcp-config value loads zero mcp servers
    ## -- see the module note above : this is what keeps the project root's
    ## own .mcp.json from starting the protocol-7 mcp server as a side effect
    ## of every background refresh
    { exec( $claude_bin, qw| --strict-mcp-config | ) };
    POSIX::_exit(1);    ##  exec itself failed  ##
}

## belt-and-suspenders : a single enter keypress in case some other first-run
## prompt shows up despite chdir'ing into an already-trusted directory -- same
## spirit as kimi's own note. the trust dialog itself no longer needs this :
## see the module note above on why the timing here can't be trusted to clear
## it reliably
syswrite( $pty, "\r" );

## from here on the parent NEVER BLOCKS, and no event callback is a coderef ##
## closure : the io watcher, the deadline timer and the reap poll are all   ##
## named handlers resolving the single-slot per-cycle state below           ##
$provider->{'refresh_state'} = {
    'pid'      => $pid,
    'fh'       => $pty,
    'buffer'   => '',
    'deadline' => time() + $timeout,
    'on_done'  => (
        ref $on_done eq qw| HASH | and length( $on_done->{'handler'} // '' )
        )
    ? { 'handler' => $on_done->{'handler'},
        'params'  => $on_done->{'params'} // {},
        }
    : undef,
    'io_w'       => undef,
    'timer_w'    => undef,
    'reap_timer' => undef,
};

$provider->{'refresh_state'}->{'io_w'} = <[event.add_io]>->(
    {   'fd'      => fileno($pty),
        'poll'    => qw| r |,
        'desc'    => 'claude refresh pty output',
        'handler' => qw| plugin.usage.claude.refresh_io |,
    }
);

## the tui keeps redrawing rather than ever closing its own stdout, so this
## deadline firing is the normal, expected outcome -- not a failure signal
$provider->{'refresh_state'}->{'timer_w'} = <[event.add_timer]>->(
    {   'after'   => $timeout,
        'desc'    => 'claude refresh deadline',
        'handler' => qw| plugin.usage.claude.refresh_timeout |,
    }
);

return TRUE;

