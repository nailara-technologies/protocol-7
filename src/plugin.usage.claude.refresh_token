# name  = plugin.usage.claude.refresh_token
# descr = start `claude` attached to a real pty, chdir'd into a neutral,
#         non-project directory, send a single belt-and-suspenders enter
#         keypress for any first-run trust dialog, let it run undisturbed for
#         the full timeout, then ask it to exit [ ctrl-d, sigterm, sigkill as
#         successive fallbacks ] -- claude code refreshes its own oauth token
#         during startup, before any prompt is ever submitted, mirroring
#         plugin.usage.kimi.refresh_token's proven mechanism [ confirmed live
#         2026-09-16 : starting the interactive claude cli by hand made both
#         the zenka's own probe and the standalone bin/dev/usage-external
#         script succeed again after a 401 ]
# param = [ timeout ] [ { on_done => { handler => <name>, params => {} } } ]
# note  = a REAL PTY, not a plain pipe -- confirmed live 2026-09-16 : with
#         stdout not a tty, claude auto-switches into --print mode and
#         requires an actual prompt [ "Input must be provided either through
#         stdin or as a prompt argument when using --print" ], and feeding it
#         one would submit a real, token-costing message -- exactly what this
#         module must never do. pty.spawn's own module note warns against
#         reaching for a real pty on suspicion alone ; this is the provable
#         case it asks for -- see that module's note
# note  = chdir target is $home_dir, NOT <system.root_path> [ unlike kimi's
#         refresh_token ] : this project's own directory carries a .mcp.json
#         that would start the protocol-7 mcp server [ and everything
#         downstream of that ] as a side effect of every single background
#         token refresh -- a directory outside the project avoids that
#         recursion entirely
# note  = single-slot -- see plugin.usage.kimi.refresh_token's module note :
#         same reload-safety contract [ named handlers only, no coderef
#         closures ], same reasoning for sigterm-before-sigkill [ a refreshed
#         credential flushed on a deferred \ on-exit path would be lost to a
#         bare sigkill ]. this module adds one more tier ahead of sigterm : a
#         single ctrl-d byte on the pty first, the same keypress an
#         interactive user's ctrl-d would send and the most likely to reach
#         claude code's own clean-shutdown path [ mirrors pty.spawn's own
#         discipline, made non-blocking -- see plugin.usage.claude.
#         refresh_finish and refresh_reap ]
# note  = untested end-to-end against a genuinely expired token as of
#         2026-09-16 -- building the safe test fixture [ backdated expiresAt
#         + corrupted refreshToken in a scratch copy under CLAUDE_CONFIG_DIR,
#         same trick used to verify plugin.usage.kimi.refresh_token ] was
#         blocked by this session's own permission classifier as "credential
#         leakage", even though it never touched the live credential file or
#         printed any token value ; delegating the same test to the coding
#         zenka didn't work either [ it has no shell-execution tool, only
#         read \ search \ edit tools, and answered a different question
#         instead ]. the first-run trust-dialog handling below in particular
#         is unverified best-effort, same spirit as kimi's own belt-and-
#         suspenders note -- needs a live pass with a real expired token
#         before this is trusted the way the kimi path now is

use POSIX ();

my $timeout = shift // 18;
my $args    = shift // {};

## see plugin.usage.kimi.refresh_token for why this unwraps two call shapes ##
my $on_done = $args;
$on_done = $args->{'on_done'}
    if ref $args eq qw| HASH |
    and ref $args->{'on_done'} eq qw| HASH |;

my $provider = <usage.provider.claude>;

## single slot : never stack two refresh children on top of each other ##
if ( ref $provider->{'refresh_state'} eq qw| HASH | ) {
    <[base.logs]>->(
        1,
        '[usage.claude.refresh_token] refresh already '
            . 'in progress [ pid %d ] : not starting another',
        $provider->{'refresh_state'}->{'pid'} // 0
    );
    return FALSE;
}

my $claude_bin = <[file.which]>->(qw| claude |);

my $home_dir = ( getpwuid($UID) )[7] // $ENV{'HOME'} // '';

if ( not length $claude_bin ) {
    if ( length $home_dir and length $provider->{'cli_rel_path'} ) {
        my $candidate = catfile( $home_dir, $provider->{'cli_rel_path'} );
        $claude_bin = $candidate if -x $candidate;
    }
}

if ( not length $claude_bin ) {
    <[base.logs]>->(
        0,
        '[usage.claude.refresh_token] cannot locate claude '
            . 'binary [ PATH lookup and known install path both failed ]'
    );
    return FALSE;
}

my $pty;
eval { $pty = IO::Pty->new };

if ( not $pty ) {
    <[base.logs]>->(
        0, '[usage.claude.refresh_token] cannot allocate pty : %s',
        <[base.str.eval_error]>
    );
    return FALSE;
}

my $pid = fork();

if ( not defined $pid ) {
    <[base.logs]>->(
        0, '[usage.claude.refresh_token] fork failed : %s',
        <[base.str.os_err]>
    );
    close($pty);
    return FALSE;
}

if ( $pid == 0 ) {
    ## make the pty's slave side this process' real controlling terminal, then
    ## exec -- claude sees an actual terminal, not a pipe [ see the module
    ## note above on why that distinction matters here ]
    $pty->make_slave_controlling_terminal();
    my $slave = $pty->slave;

    ## a freshly allocated pty starts at 0x0 unless something sizes it -- same
    ## floor pty.spawn applies, for the same reason [ several tui frameworks
    ## refuse to render properly otherwise ]
    my ( $min_rows, $min_cols ) = ( 24, 80 );
    $slave->clone_winsize_from( \*STDIN ) if -t STDIN;
    my ( $rows, $cols ) = $slave->get_winsize();
    $slave->set_winsize( $min_rows, $min_cols, 0, 0 )
        if not $rows
        or $rows < $min_rows
        or not $cols
        or $cols < $min_cols;

    close($pty);
    open( STDIN,  '<&', $slave->fileno ) or POSIX::_exit(1);
    open( STDOUT, '>&', $slave->fileno ) or POSIX::_exit(1);
    open( STDERR, '>&', $slave->fileno ) or POSIX::_exit(1);
    close($slave);

    ## see the module note above : deliberately NOT <system.root_path> ##
    chdir($home_dir) if length $home_dir;

    { exec($claude_bin) };
    POSIX::_exit(1);    ##  exec itself failed  ##
}

## belt-and-suspenders : a single enter keypress in case a first-run "do you
## trust this folder" dialog shows up for $home_dir -- see module note above
## on why this is unverified best-effort, same spirit as kimi's own note
syswrite( $pty, "\r" );

## from here on the parent NEVER BLOCKS, and no event callback is a coderef ##
## closure : the io watcher, the deadline timer and the reap poll are all   ##
## named handlers resolving the single-slot per-cycle state below           ##
$provider->{'refresh_state'} = {
    'pid'      => $pid,
    'fh'       => $pty,
    'buffer'   => '',
    'deadline' => time() + $timeout,
    'on_done'  => (
        ref $on_done eq qw| HASH | and length( $on_done->{'handler'} // '' )
        )
    ? { 'handler' => $on_done->{'handler'},
        'params'  => $on_done->{'params'} // {},
        }
    : undef,
    'io_w'       => undef,
    'timer_w'    => undef,
    'reap_timer' => undef,
};

$provider->{'refresh_state'}->{'io_w'} = <[event.add_io]>->(
    {   'fd'      => fileno($pty),
        'poll'    => qw| r |,
        'desc'    => 'claude refresh pty output',
        'handler' => qw| plugin.usage.claude.refresh_io |,
    }
);

## the tui keeps redrawing rather than ever closing its own stdout, so this
## deadline firing is the normal, expected outcome -- not a failure signal
$provider->{'refresh_state'}->{'timer_w'} = <[event.add_timer]>->(
    {   'after'   => $timeout,
        'desc'    => 'claude refresh deadline',
        'handler' => qw| plugin.usage.claude.refresh_timeout |,
    }
);

return TRUE;

