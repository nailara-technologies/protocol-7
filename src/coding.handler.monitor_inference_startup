## [:< ##

# name  = coding.handler.monitor_inference_startup
# descr = monitor llama-server startup output and confirm readiness

my $event        = shift->w;
my $handler_data = $event->data;
my $backend      = $handler_data->{'backend'};
my $expected_pid = $handler_data->{'pid'};
my $whitelist    = $handler_data->{'log_whitelist'} // [];

my $server = <coding.inference_servers>->{$backend};

## stale watcher guard : cancel if server was replaced by a newer spawn ##
if ( !defined $server
    || ( defined $expected_pid && $server->{'pid'} != $expected_pid ) ) {
    <[base.logs]>->(
        1,
        "[monitor_startup] stale watcher for backend=%s "
            . "expected_pid=%s current_pid=%s : cancelling",
        $backend,
        $expected_pid // 'undef',
        $server->{'pid'} // 'undef'
    );
    $event->cancel if $event->is_active;
    return;
}

## Read available output [non-blocking]
#
my $read_size = 4096;
my $read_fh   = $event->fd;
#
my $bytes = <[base.s_read]>->( $read_fh, \$server->{'output'}, $read_size );
#
if ( $bytes > 0 ) {
    <[base.logs]>->(
        2, "[monitor_startup] backend=%s bytes=%-4s [ %s.. ]",
        $backend, $bytes, substr( $server->{'output'}, -9 )
    );
}
#
##

# Check for readiness indicators in output
my $output = $server->{'output'} // '';

# Check for actual errors [ not whitelisted ones ]
unless ( $server->{'error_checked'} ) {
    my $has_real_error = FALSE;
    for my $line ( split "\n", $output ) {
        next if !length $line;

        # Check if line matches whitelist [LLL] not required [base.log filter]
        my $is_whitelisted = FALSE;
        for my $pattern ( $whitelist->@* ) {
            if ( $line =~ m|$pattern|i ) {
                $is_whitelisted = TRUE;
                last;
            }
        }

        # Only flag as error if it's NOT whitelisted and matches error pattern
        if (  !$is_whitelisted
            && $line =~ m{error|failed|cannot|refused|exception}i ) {
            $has_real_error = TRUE;
            <[base.logs]>->(
                0,        "[monitor_startup] backend=%s :ERROR: %s",
                $backend, substr( $line, 0, 200 )
            );
            last;
        }
    }
    $server->{'error_checked'} = TRUE;
}

# llama-server indicates readiness with "Server listening on"
if (
    $output =~ m{listening on|ready to accept|Model loaded|uvicorn running}i )
{
    unless ( $server->{'ready_logged'} ) {
        <[base.logs]>->(
            1, "[monitor_startup] backend=%s is ready", $backend
        );
        $server->{'status'}       = qw| ready |;
        $server->{'ready_logged'} = TRUE;

        ## await_resources exists ONLY for the one-time :twin: handover     ##
        ## scenario at boot - once THIS instance's own server has become    ##
        ## ready even once, that purpose is permanently fulfilled. without  ##
        ## retiring it here, it stays armed indefinitely and re-fires on    ##
        ## every future incidental gpu-server loss (e.g. a switch-model     ##
        ## kill), racing against the legitimate respawn with a stale-config ##
        ## default model. a flag-based in-flight guard alone isn't enough - ##
        ## await_resources polls on a 3s interval, which can be slower than ##
        ## an entire switch+respawn cycle, so the flag can already be       ##
        ## cleared by the time it next checks. confirmed live 2026-06-21.   ##
        my $await_timer = <coding.timer.await_resources>;
        if ( defined $await_timer ) {
            $await_timer->cancel if eval { $await_timer->is_active };
            delete <coding.timer.await_resources>;
            delete <coding.awaiting_resources>;
        }

        ## mark cold-start : the first request to a freshly-(re)spawned   ##
        ## server pays model-load / first-inference warmup latency on top ##
        ## of normal prefill — independent of prompt size. http_client    ##
        ## grants this request extra data-start grace ; cleared on the    ##
        ## first chunk actually received [ coding.callback.http_chunk ]   ##
        $server->{'cold_start'} = TRUE;
        $server->{'url'}
            = sprintf( 'http://127.0.0.1:%d', $server->{'port'} // 8000 );
        $server->{'model'}       = <inference.model.amos_id>     // '';
        $server->{'mmproj_path'} = <inference.model.mmproj_path> // '';

        ## reset dependency object (may have been marked failed by a        ##
        ## previous server that was killed mid-startup, e.g. during         ##
        ## switch-model) + recheck waiting jobs. gated on self-test         ##
        ## actually concluding [ pass OR fail ] - NOT fired the instant the ##
        ## server merely responds. a real production task must never start  ##
        ## against a server whose reasoning- sanity check [ prompt 2 ]      ##
        ## hasn't resolved yet - confirmed live 2026-07-31 : the async      ##
        ## conversion originally ran this immediately, letting tasks start  ##
        ## mid-self-test, sometimes well before a bad-seed cat-test failure ##
        ## was even detected. the body lives in the named helper [          ##
        ## coding.helper.resume_task_queue_for_backend ] since the          ##
        ## self-test guard watcher's retry path [ event.add_var handlers    ##
        ## cannot carry closures ] reaches the same logic by name           ##
        my $resume_queue = sub {
            <[coding.helper.resume_task_queue_for_backend]>->($backend);
        };

        ## run model self-test cycle after server is ready [ timeout_stats, ##
        ## TTFT, anomaly detection ] must come after $server->{'model'} is  ##
        ## set above, not before SKIP if a self-test-driven                 ##
        ## switch-test-restore cycle is already running its own explicit    ##
        ## test against this exact readiness event - without this, every    ##
        ## switch self-test triggers caused a redundant duplicate auto-test ##
        ## [ confirmed live 2026-06-21 ]                                    ##
        if (<coding.self_test_switch_in_progress>) {
            <[base.logs]>->(
                2,
                '[monitor_startup] skipping auto self-test '
                    . ': switch-driven cycle in progress'
            );
            ## no on_done will ever fire from this branch - resume now ##
            $resume_queue->();
        } else {
            ## explicit pause : coding.task.queue_paused defaults falsy and ##
            ## nothing else sets it for a normal (non-crash) fresh spawn -  ##
            ## coding.async.send_request's gate was a no-op this whole time ##
            ## for this path. real tasks must not dispatch while            ##
            ## self-test's reasoning-sanity check is still running          ##
            <coding.task.queue_paused> = 1;

            ## trigger + async result handling extracted into a helper so ##
            ## the single-flight-guard retry path [ another backend's     ##
            ## self-test already running at this readiness event ]        ##
            ## re-enters the SAME logic via timer instead of a drifting   ##
            ## duplicate [ task : coding-self-test-parallel-backend-gap,  ##
            ## option 1 ]                                                 ##
            <[coding.helper.trigger_backend_self_test]>->(
                {   'backend'      => $backend,
                    'server'       => $server,
                    'tested_pid'   => $server->{'pid'} // 0,
                    'resume_queue' => $resume_queue,
                }
            );
        }
    }

    ## cancel watcher once ready : no need to keep reading server output [ ##
    ## continuing to read monopolizes the event loop during inference ]    ##
    <[coding.cancel_watcher.backend_monitor]>->($event);

### [ LLL : needs combined event cancel handler [ stdout stderr ] ]

    return;
}

# If EOF or no data : verify the server process is still alive before
# declaring crash.  When fd numbers are reused after a switch-model, a
# spurious 0-byte read can fire on the new pipe; don't misread it as EOF.
if ( $bytes <= 0 ) {
    if ( kill( 0, $expected_pid ) ) {
        ## process still alive : spurious read, stay active ##
        return;
    }

    ## crash path : cancel startup watchers directly, no drain needed do   ##
    ## NOT call cancel_watcher.backend_monitor here : that installs drain  ##
    ## watchers on a dead server's closed pipes, which spin the event loop ##
    ## at 100% cpu until the fd is GC'd                                    ##
    $event->cancel if $event->is_active;
    if ( exists <coding.watcher_pair>->{$event} ) {
        my $other = delete <coding.watcher_pair>->{$event};
        if ( defined $other ) {
            $other->cancel if $other->is_active;
            delete <coding.watcher_pair>->{$other};
        }
    }
    close($read_fh);

    ## Check if server became ready before EOF (normal) or crashed (error) ##
    ## crash_logged guard : both stdout+stderr watchers fire EOF on crash  ##
    if ( !$server->{'ready_logged'} && !$server->{'crash_logged'} ) {
        $server->{'crash_logged'} = TRUE;
        <[base.logs]>->(
            0, "[monitor_startup] backend=%s CRASHED before ready (exit)",
            $backend
        );
        ## log last output lines to help diagnose the crash ##
        my $crash_out = $server->{'output'} // '';
        if ( length $crash_out ) {
            my @lines = grep {length} split /\n/, $crash_out;
            my @tail  = @lines > 3 ? @lines[ -3 .. -1 ] : @lines;
            for my $line (@tail) {
                <[base.logs]>->( 0, "[monitor_startup] :. %s", $line );
            }
        }
        $server->{'status'} = qw| crashed |;

        ## Mark dependency as failed by setting failed flag on object ##
        my $dep_id
            = $backend eq qw| gpu |
            ? ( <coding.dep.gpu_server> // 0 )
            : ( <coding.dep.cpu_server> // 0 );
        if ( $dep_id && exists <dependency.object>->{$dep_id} ) {
            <dependency.object>->{$dep_id}->{'failed'} = TRUE;
            <dependency.object>->{$dep_id}->{'error'}
                = 'server crashed during startup';
            <[base.logs]>->(
                1, "[monitor_startup] marked dependency %s as failed", $dep_id
            );
        }

        ## Trigger dependency check so jobs can see failure and fail ##
        ## gracefully                                                ##
        <[jobqueue.check_dependencies]>;
    } else {
        <[base.logs]>->(
            2, "[monitor_startup] EOF : backend=%s (normal)", $backend
        );
    }
}

