## [:< ##

# name  = ncode.cmd.transform
# descr = command interface for ncode transformations
# param = $call [ args, param => { input, file_type,
#                                  namespace, target, waves, llm_cmd,
#                                  llm_budget, mode } ]

## the waves run in ncode.transform.run                                    ##
## [ a structure, for internal callers ] ; a .cmd. answers a string -- the ##
## hash this returned went out as HASH(0x..) [ 2026-10-23 ]. the reply is  ##
## ncfg, the same one an llm wave answers later through the reply id       ##

my $param = { %{ $call->{'param'} // {} } };
$param->{'reply_id'} = $call->{'reply_id'};

my $run = <[ncode.transform.run]>->($param);

return { 'mode' => qw| deferred | } if $run->{'mode'} eq qw| deferred |;
return {
    'mode' => qw| false |,
    'data' => $run->{'data'} // 'transform ' . 'failed'
    }
    if $run->{'mode'} ne qw| true |;

return {
    'mode' => qw| size |,
    'data' => <[ncode.transform.format_reply]>->(
        $run->{'data'}, $param->{'mode'} // qw| apply |
    ),
};

