## [:< ##

# name = login-screen.open_window
# descr = build the whole dark greeter before mapping it

$ENV{'DISPLAY'} = <x11.display>;
Gtk3->init;
my $settings = Gtk3::Settings::get_default();
$settings->set_property( 'gtk-application-prefer-dark-theme' => TRUE );

my $theme      = <login-screen.theme>   // {};
my $brightness = $theme->{'brightness'} // 0.82;
$brightness = 0.82 if $brightness !~ m|^\d+(?:[.]\d+)?$|;
$brightness = 0.2  if $brightness < 0.2;
$brightness = 1    if $brightness > 1;

my $color = sub {
    my ($name) = @ARG;
    my %fallback = (
        ## protocol-7 palette [ base.gtk.style ] ##
        'background' => '000013',
        'panel'      => '000042',
        'text'       => '0055CC',
        'muted'      => '003A8C',
        'accent'     => '0055CC',
        'entry'      => '000042',
        'error'      => '4427AC',
    );
    my $hex = $theme->{'color'}->{$name} // $fallback{$name};
    $hex = $fallback{$name} if $hex !~ m|^[0-9a-fA-F]{6}$|;
    my @rgb
        = map { int( hex($ARG) * $brightness + 0.5 ) } ( $hex =~ m|(..)|g );
    return sprintf( '#%02x%02x%02x', @rgb );
};
my $font_size = $theme->{'font_size'} // 32;
$font_size = 32 if $font_size !~ m|^\d+$|;
$font_size = 16 if $font_size < 16;
$font_size = 96 if $font_size > 96;
my $title_size = $theme->{'title_size'} // 42;
$title_size = 42 if $title_size !~ m|^\d+$|;
my $status_size = $theme->{'status_size'} // 22;
$status_size = 22 if $status_size !~ m|^\d+$|;
my $family = $theme->{'font_family'} // 'White Rabbit';
$family =~ s|[{};]| |g;
my $width = $theme->{'content_width'} // 620;
$width = 620 if $width !~ m|^\d+$|;
my $padding = $theme->{'padding'} // 42;
$padding = 42 if $padding !~ m|^\d+$|;

my $window = Gtk3::Window->new('toplevel');
my $screen = $window->get_screen();
$window->set_visual( $screen->get_system_visual() );
<[base.gtk.style]>->(
    $screen,
    {   'color' => {
            'background' => $color->('background'),
            'panel'      => $color->('entry'),
            'text'       => $color->('text'),
            'muted'      => $color->('muted'),
            'border'     => $color->('accent'),
        },
        'font_family' => $family,
        'font_size'   => $font_size,
        'css'         => sprintf(
            ".title { font-size: %dpx; }\n.status { color: %s; font-size: "
                . "%dpx; }\nentry { padding: 12px; }\nbutton { padding: "
                . "14px; }\n",
            $title_size, $color->('error'), $status_size
        ),
    }
);
$window->set_decorated(0);
$window->set_resizable(0);
$window->set_keep_above(1);
$window->set_border_width($padding);
$window->set_app_paintable(1);
$window->set_default_size( $screen->get_width(), $screen->get_height() );
$window->fullscreen();

my $grid = Gtk3::Grid->new();
$grid->set_halign('center');
$grid->set_valign('center');
$grid->set_size_request( $width, -1 );
$grid->set_row_spacing(24);
$grid->set_column_spacing(16);
$window->add($grid);

my $title = Gtk3::Label->new('protocol-7');
$title->get_style_context()->add_class('title');
$title->set_xalign(1);
my $user_label = Gtk3::Label->new('user');
$user_label->set_xalign(1);
my $user = Gtk3::Entry->new();
$user->set_max_length(32);
$user->set_activates_default(FALSE);
my $password_label = Gtk3::Label->new('password');
$password_label->set_xalign(1);
my $password = Gtk3::Entry->new();
$password->set_visibility(FALSE);
$password->set_max_length(1024);
eval { $password->set_input_purpose('password') };
my $button = Gtk3::Button->new_with_label('log in');
my $status = Gtk3::Label->new('');
$status->get_style_context()->add_class('status');
$status->set_xalign(0);
$status->set_line_wrap(TRUE);

$grid->attach( $title,          0, 0, 2, 1 );
$grid->attach( $user_label,     0, 1, 2, 1 );
$grid->attach( $user,           0, 2, 2, 1 );
$grid->attach( $password_label, 0, 3, 2, 1 );
$grid->attach( $password,       0, 4, 2, 1 );
$grid->attach( $button,         0, 5, 2, 1 );
$grid->attach( $status,         0, 6, 2, 1 );
$user->set_hexpand(TRUE);
$password->set_hexpand(TRUE);
$button->set_hexpand(TRUE);

$user->signal_connect( 'activate' => sub { $password->grab_focus } );
$password->signal_connect(
    'activate' => sub {<[login-screen.authenticate]>} );
$button->signal_connect( 'clicked' => sub {<[login-screen.authenticate]>} );
$window->signal_connect( 'delete_event' => sub { Gtk3->main_quit } );
Glib::Timeout->add( 1000, $code{'login-screen.handler.helper_watch'} );

<login-screen.window>          = $window;
<login-screen.widget.user>     = $user;
<login-screen.widget.password> = $password;
<login-screen.widget.button>   = $button;
<login-screen.widget.status>   = $status;
<login-screen.state>           = qw| init |;
$password->set_text('');

## a running user session [ greeter restarted ] : stay hidden, never cover ##
## it ; no session or no answer : show the login form                      ##
<[protocol-7.route-send]>->(
    {   'command' => qw| v7-zenki.login-session-state |,
        'reply'   =>
            { 'handler' => qw| login-screen.handler.session_state_reply | }
    }
);
Glib::Timeout->add(
    5000,
    sub {
        <[login-screen.show_greeter]> if <login-screen.state> eq qw| init |;
        return FALSE;
    }
);
TRUE;

