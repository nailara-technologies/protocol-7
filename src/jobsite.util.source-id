## [:< ##

# name  = jobsite.util.source-id
# descr = extract stepstone-style source/posting id from a job record

my $job = shift // {};

## the job id IS the encoded listing number [ site-yaml.stepstone.* ] ##
my $id = $job->{'id'} // '';
return $id if length $id;

my $url = $job->{'url'} // '';
return <[base.vax-int.encode]>->($1) if $url =~ m{--(\d+)-inline\.html};

return '';

