## [:< ##

# name  = jobsite.util.source-id
# descr = extract stepstone-style source/posting id from a job record

my $job = shift // {};

my $id = $job->{'id'} // '';
return $id if $id =~ m{^\d+$} and $id > 1000000;

my $url = $job->{'url'} // '';
return $1 if $url =~ m{--(\d+)-inline\.html};

return '';

