## [:< ##

# name  = v7-zenki.cmd.teardown
# param = [:no-restart:] [reason]
# descr = shut down v7 zenka and all zenka instances

my $params = shift;
my $reason = $params->{'args'};
my $user   = $1 if $reason =~ s|^([^\s]+) *||;
$user =~ s|^[^\.]+\.||;

## ':no-restart:' : protocol-7 stays down -- exit code 76, which the        ##
## systemd unit names in RestartPreventExitStatus. without it a teardown is ##
## a restart [ Restart=always : v7-zenki brings the zenki back, systemd     ##
## brings v7-zenki back ]. powering the machine off : system-poweroff       ##
my $no_restart = ( $reason =~ s{\s*:no-restart:\s*}{ }g );
$reason =~ s{^\s+|\s+$}{}g;

<[base.log]>->( 1, "<<!>> specified shutdown reason : $reason <<!>>" )
    if length($reason);
<[base.log]>->( 1, '<<!>> no restart : protocol-7 stays down <<!>>' )
    if $no_restart;

<[event.add_timer]>->(
    {   'after'   => 0,
        'repeat'  => 0,
        'prio'    => 5,
        'handler' => qw| v7-zenki.handler.shutdown_cmd |,
        'data'    => {
            'reason' => "requested by '$user'"
                . ( length $reason ? " : $reason" : '' ),
            'exit' => ( $no_restart ? 76 : 0 ),
        }
    }
);

return {
    'mode' => qw| true |,
    'data' => "shutting down 'v7-zenki' zenka"
        . ( $no_restart ? ' [ no restart ]' : '' ) . " ..,"
};

