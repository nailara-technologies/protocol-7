## [:< ##

# name  = v7-zenki.cmd.teardown
# param = [reason]
# descr = shut down v7 zenka and all zenka instances

my $params = shift;
my $reason = $params->{'args'};
my $user   = $1 if $reason =~ s|^([^\s]+) *||;
$user =~ s|^[^\.]+\.||;

<[base.log]>->( 1, "<<!>> specified shutdown reason : $reason <<!>>" )
    if length($reason);

<[event.add_timer]>->(
    {   'after'   => 0,
        'repeat'  => 0,
        'prio'    => 5,
        'handler' => qw| v7-zenki.handler.shutdown_cmd |,
        'data'    => "requested by '$user'"
    }
);

return {
    'mode' => qw| true |,
    'data' => "shutting down " . "'v7-zenki' zenka ..,"
};

