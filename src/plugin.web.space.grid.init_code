## [:< ##

# name  = plugin.web.space.grid.init_code
# descr = initialize grid visualization plugin state

## grid data cache : populated by scan, read by template commands ##
<web.space.grid.cache> = {
    qw| target_dir | => qw| unknown |,
    qw| file_count | => 0,
    qw| cells      | => [],
    qw| timestamp  | => 0,
    qw| ttl        | => 60,
};

## configuration : which directory to scan for grid coordinates ##
<web.space.grid.cfg.target_dir> //= qw| data/md/design |;
<web.space.grid.cfg.ttl>        //= 60;

<[base.log]>->( 1, 'plugin.web.space.grid : initialized' );

0;

