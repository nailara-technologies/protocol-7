## [:< ##

# name  = power.cmd.show_all
# descr = return all device states

<power.cfg.devices> //= {};

my $reply_str = '';

map {
    my $states = <[power.cmd.get_states]>->($ARG);

    ## a device without states [ driver module missing, no connection ] ##
    ## keeps its row, every outlet unknown                              ##
    my $driver = <power.cfg.devices>->{$ARG}->{'driver'} // qw| gembird |;
    my $row_states
        = ref $states eq qw| HASH | && lc $states->{'mode'} eq qw| true |
        ? $states->{'data'}
        : join( ' ', ('E') x ( $driver eq qw| gembird | ? 4 : 1 ) );

    ## rows keep 4 state columns for power-x11 : pad with '-' ##
    my @row = split( m| |, $row_states );
    push @row, '-' while @row < 4;
    $row_states = join( ' ', @row );

    $reply_str .= join( ' ',
        $ARG,
        <power.cfg.devices>->{$ARG}->{'mac'} // '-',
        <power.cfg.devices>->{$ARG}->{'ip'} // '-', $row_states )
        . "\n"
} sort {
    <power.cfg.devices>->{$a}->{'added'} <=>
        <power.cfg.devices>->{$b}->{'added'}
} keys <power.cfg.devices>->%*;

return { 'mode' => qw| size |, 'data' => $reply_str };

