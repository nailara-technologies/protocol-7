# name  = work.load_todos_index
# descr = load or generate todos index

my $todos_index = <work.index.todos>;

if ( <[work.index_needs_regeneration]>->($todos_index) ) {
    return <[work.generate_todos_index]>;
}

my $index_data = <[format.yaml.load_file]>->($todos_index);

# If load fails, regenerate
return <[work.generate_todos_index]> if not defined $index_data;

return $index_data;

