## [:< ##

# name  = keys.console.owner-unpin
# param = <name>
# descr = remove an owner pin [ undo-remove brings it back ]
# note  = moved to the trash [ undo-remove ] ; host pins written
#         under this owner stay [ they pin the host-root itself ] -- only
#         automatic rotation needs the owner

my $name = shift // '';
$name =~ s{\A\s+|\s+\z}{}g;

if ( $name !~ m|\A[A-Za-z0-9][A-Za-z0-9._-]{0,63}\z| ) {
    say "\n  << expected an owner name >>\n";
    <[base.exit]>->(qw| 0010 |);
}

my ( $owner_dir, $dir_why )
    = <[keystore.remote_keys_dir]>->( qw| owners |, FALSE );
my $pin_file
    = defined $owner_dir ? catfile( $owner_dir, "$name.public" ) : '';

if ( not defined $owner_dir or ( not -e $pin_file and not -l $pin_file ) ) {
    printf "\n  << owner '%s' is not pinned >>\n\n", $name;
    <[base.exit]>->(qw| 0010 |);
}

## into the trash [ undo-remove brings it back ] ##
my ( $stashed, $stash_why )
    = <[keystore.trash.stash]>->( $pin_file, qw| owner-pin |, $name );
if ( not defined $stashed ) {
    printf "\n  << '%s' not moved to the trash [ %s ] >>\n\n", $pin_file,
        $stash_why;
    <[base.exit]>->(qw| 0110 |);
}

printf " :\n :: owner '%s' unpinned\n :. undo : undo-remove owner-pin:%s\n",
    $name, $name;
<[keys.store_note]>->($owner_dir);
say " :.\n";

