## [:< ##

# name  = site-yaml.cmd.queue-depth
# descr = return current async fetch queue length

my $depth = scalar @{ $data{'site-yaml'}{'fetch_queue'} // [] };

return { 'mode' => 'true', 'data' => "$depth" };

