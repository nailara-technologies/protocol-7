## [:< ##

# name  = kimi.handler.acp_stdout
# descr = one json-rpc line from the child's stdout
# param = line [ octets ], handle

## the stream_child frames the lines ; json is decoded here, at the edge ##

my $line = shift // return;
my $st   = <[kimi.acp.state]>;
return if $line !~ m{\S};

$st->{'json'} //= JSON::XS->new->utf8->canonical;
my $message = eval { $st->{'json'}->decode($line) };
if ( ref $message ne qw| HASH | ) {
    <[kimi.acp.event]>->( qw| raw |, $line );
    return;
}
eval { <[kimi.acp.dispatch]>->($message); 1 } or do {
    my $why = $EVAL_ERROR =~ s{\s+\z}{}r;
    <[base.logs]>->( 0, '<< kimi.acp dispatch failed : %s >>', $why );
    <[kimi.acp.event]>->( qw| error |, "dispatch failed : $why" );
};
return TRUE;

