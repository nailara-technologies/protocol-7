## [:< ##

# name  = jobsite.lease.renew
# descr = request a replacement token from the configured issuer

<jobsite.lease.timer_pending> = FALSE;
return if <jobsite.lease.in_progress>;

my $issuer = <jobsite.cfg.lease.issuer> // '';
my $user   = <jobsite.cfg.lease.user>   // '';
return <[jobsite.lease.failed]>->(qw| configuration |)
    if not length $issuer or $user !~ m|^[\w.+-]+$|;

my $old_token
    = <[jobsite.sync.token_for_url]>->( <jobsite.cfg.sync_url> // '' );
return <[jobsite.lease.failed]>->(qw| no-token |) if not length $old_token;

<jobsite.lease.in_progress> = TRUE;
my $sent = <[protocol-7.route-send]>->(
    {   'command'   => "$issuer.lease-renew",
        'call_args' => {
            'param' => { 'user' => $user },
            'data'  => $old_token,
        },
        'reply' => {
            'handler' => qw| jobsite.handler.lease-renewed |,
            'params'  => { 'lease_user' => $user },
        },
    }
);
undef $old_token;
return <[jobsite.lease.failed]>->(qw| route |) if not $sent or $sent <= 0;
return TRUE;

