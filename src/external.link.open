## [:< ##

# name  = external.link.open
# descr = encrypted named link to another host's cube
# param = { name, host, port, as_username }
#
# opens - or reuses while alive - an ENCRYPTED, authenticated protocol-7
# client session to '<host>:<port>' and registers it under <name> : the
# remote cube then behaves like a zenka of this one's, every zenka can
# route 'external.<name>.<zenka>.<command>' [ base.handler.command.
# route_to_target forwards '<name>.<rest>' over the client session that
# carries that name ]. the thin tcp caller of link.session.open [ stage
# 1 of LINK-ZENKI-AND-TRANSPORTS.md 'idea 2 : transports' ] : the
# auth-keypair + link-upgrade + session half lives THERE ; the pin stays
# named after pin_host + pin_port [ here the dial address, as before --
# the managed links pass the RECORD name instead ]. steps : tcp connect
# [ io.ip.tcp.output.open, 7 s bound ], link.session.open [ auth-keypair
# as <as_username> [ //= <external.cfg.link_user> ] with this unix
# user's '<user>.base' key [ the remote cube must hold that label's
# public key under ~/.n/remote-keys/authorized/cube/ ; the remote cube's
# key is pinned per <host>_<port> ], the link-upgrade handshake bound to
# that auth, then base.session.init + state 1 + state 3 [
# link-upgrade.client_activate, link_role client ]. the blocking part
# is only this setup ; commands afterwards are event-driven [ the
# users.remote_fetch.run shape, never a blocking read loop ].
# result : { mode => true, data => <session id> } or mode false + why.

my $args = shift           // {};
my $name = $args->{'name'} // '';
my $host = $args->{'host'} // '';
my $port = $args->{'port'} // '';

return { 'mode' => qw| false |, 'data' => 'name, host and port required' }
    if not length $name
    or not length $host
    or $port !~ m{^\d+$}o;

return { 'mode' => qw| false |, 'data' => "not a valid link name : $name" }
    if $name !~ <regex.base.usr>;

<external.links> //= {};

## a live link is reused ##
my $known = <external.links>->{$name};
if ( ref $known eq qw| HASH | and exists $data{'session'}{ $known->{'sid'} } )
{
    return {
        'mode' => qw| false |,
        'data' => "link $name is open to $known->{'host'}:$known->{'port'}"
        }
        if $known->{'host'} ne $host
        or $known->{'port'} ne $port;
    return { 'mode' => qw| true |, 'data' => $known->{'sid'} };
}
delete <external.links>->{$name};

my $as_username = $args->{'as_username'} // <external.cfg.link_user> // '';
return { 'mode' => qw| false |, 'data' => 'no link identity configured' }
    if not length $as_username;

my $target = "$host:$port";

my $sock = <[base.open]>->( qw| ip.tcp output |, $host, $port );
return { 'mode' => qw| false |, 'data' => "cannot connect to $target" }
    if not defined $sock;

## the session half : auth-keypair + link-upgrade + named client session ##
## [ link.session.open closes the fd on its own failures ]               ##
my $opened = eval {
    <[link.session.open]>->(
        {   qw| fd |          => $sock,
            qw| name |        => $name,
            qw| pin_host |    => $host,
            qw| pin_port |    => $port,
            qw| as_user |     => $as_username,
            qw| target_host | => $host,
            qw| target_port | => $port
        }
    );
};
if ( length $EVAL_ERROR ) {
    close($sock);
    die $EVAL_ERROR;
}
return $opened if ref $opened ne qw| HASH |;
return $opened if $opened->{'mode'} ne qw| true |;

my $id = $opened->{'data'};

<external.links>->{$name} = {
    'sid'  => $id,
    'host' => $host,
    'port' => $port,
    'user' => $as_username,
};

<[base.logs]>->(
    1, ': external : encrypted link %s -> %s [ session %d ]',
    $name, $target, $id
);

return { 'mode' => qw| true |, 'data' => $id };

