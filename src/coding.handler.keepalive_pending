## [:< ##

# name  = coding.handler.keepalive_pending
# descr = a pending source answered ; the last one decides

my $reply  = shift              // {};
my $p      = $reply->{'params'} // {};
my $round  = <coding.keepalive.round>;
my $source = $p->{'source'} // '';
return FALSE
    if not defined $round
    or ( $p->{'round'} // '' ) ne $round->{'id'};

if ( $p->{'presence'} ) {
    return FALSE if not exists $round->{'wait'}{$source};
    my ($mode) = <[base.reply.mode_text]>->($reply);
    if ( $mode ne qw| true | ) {
        delete $round->{'wait'}{$source};
    } else {
        my $sent = <[protocol-7.route-send]>->(
            {   'command'   => $p->{'command'},
                'call_args' => { 'args' => $p->{'args'} },
                'reply'     => {
                    'handler' => qw| coding.handler.keepalive_pending |,
                    'params'  =>
                        { 'round' => $p->{'round'}, 'source' => $source }
                }
            }
        );
        delete $round->{'wait'}{$source} if not $sent;
    }
    <[coding.keepalive.decide]> if not keys $round->{'wait'}->%*;
    return TRUE;
}

return FALSE if not delete $round->{'wait'}{$source};
my ( $mode, $text ) = <[base.reply.mode_text]>->($reply);
$text =~ s{\\n}{\n}g;    ## a true line arrives with newlines escaped ##
$round->{'got'}{$source} = $text if $mode ne qw| false |;
<[coding.keepalive.decide]>      if not keys $round->{'wait'}->%*;
return TRUE;

