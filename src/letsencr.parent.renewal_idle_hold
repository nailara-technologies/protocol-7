# name  = letsencr.parent.renewal_idle_hold
# descr = mark one more renewal in flight and pause the on-demand idle
#         timeout [ pair with letsencr.parent.renewal_idle_release on the
#         success and failure paths -- an idle exit can never kill a
#         running ACME child ]

<letsencr.parent.renewals_in_flight> //= 0;
<letsencr.parent.renewals_in_flight>++;

<[base.zenki.pause_ondemand_timeout]>;

