## [:< ##

# name  = v7-zenki.zenka.cmd.notify_online
# param = [:start:] <zenka|instance>
# descr = reply when zenka startup complete or failed

<v7-zenki.zenka.notify_online> //= {};

my $zenka_subname;
my $query_param = $call->{'args'};
my $reply_id    = $call->{'reply_id'};

return {
    'mode' => qw| false |,
    'data' => 'expected zenka name or instance parameter'
    }
    if not defined $query_param or !length($query_param);

## optional :start: prefix : ensure zenka is started before waiting
my $do_start = $query_param =~ s{^:start:\s*}{};

my @instances = <[v7-zenki.instance_ids]>;

if ( $query_param =~ m|^job:(\d+)$| and my $job_id = $LAST_PAREN_MATCH ) {
    my $instance_id;
    map {
        $instance_id = $ARG
            if <v7-zenki.zenka.instance>->{$ARG}->{'job_id'} == $job_id
    } @instances;
    if ( defined $instance_id ) {
        $query_param = $instance_id;
    } else {
        return {
            'mode' => qw| false |,
            'data' => "unknown job id '$job_id'"
        };
    }
}

my $query_copy = $query_param;
$zenka_subname = $LAST_PAREN_MATCH
    if $query_param !~ <regex.base.iid> and $query_param =~ s|\[([^\]]+)\]$||;

if (    not defined <[zenka.get_id]>->($query_param)
    and not defined <v7-zenki.zenka.instance>->{$query_param} ) {
    my $rep_msg
        = $query_param =~ <regex.base.iid>
        ? "no such zenka instance [$query_param]"
        : "no such zenka in setup [$query_param]";
    return {
        'mode' => qw| false |,
        'data' => $rep_msg
    };
}

if ( $query_param =~ <regex.base.iid> and my $id = $query_param ) {  # inst.id
    my $cube_sid = <v7-zenki.zenka.instance>->{$id}->{'cube_sid'};
    my $prog_pid = <v7-zenki.zenka.instance>->{$id}->{'process'}->{'id'};
    if ( defined <v7-zenki.zenka.instance>->{$id} ) {
        return {
            'mode' => qw| true |,
            'data' => "zenka instance '$id' already online., [$cube_sid]"
            }
            if <v7-zenki.zenka.instance>->{$id}->{'status'} eq qw| online |;
        return {
            'mode' => qw| true |,
            'data' => "external program instance '$id' "
                . "already running., [PID=$prog_pid]"
            }
            if <v7-zenki.zenka.instance>->{$id}->{'status'} eq qw| extbin |;
    }
}

foreach my $id (@instances) {    # zenka name [ +subname ]
    my $cube_sid = <v7-zenki.zenka.instance>->{$id}->{'cube_sid'};
    my $prog_pid = <v7-zenki.zenka.instance>->{$id}->{'process'}->{'id'};
    if (<v7-zenki.zenka.instance>->{$id}->{'zenka_name'} eq $query_param
        and (
            not defined $zenka_subname
            or ( defined <v7-zenki.zenka.instance>->{$id}->{'subname'}
                and <v7-zenki.zenka.instance>->{$id}->{'subname'} eq
                $zenka_subname )
        )
    ) {
        return {
            'mode' => qw| true |,
            'data' => "zenka '$query_copy' already online., [$cube_sid]"
            }
            if defined $cube_sid
            and <v7-zenki.zenka.instance>->{$id}->{'status'} eq qw| online |;
        return {
            'mode' => qw| true |,
            'data' => "external program '$query_copy' "
                . "already running., [PID=$prog_pid]"
            }
            if <v7-zenki.zenka.instance>->{$id}->{'status'} eq qw| extbin |;
    }
}

<[base.logs]>->( 2, "startup notification request ['%s']", $query_copy );

## register the waiter first : an instance starting and ending fast must still
## find its waiter when the status arrives
push <v7-zenki.zenka.notify_online>->{$query_copy}->@*, $reply_id;

## trigger start_once when :start: prefix was given
if ($do_start) {
    <[base.logs]>->(
        2, ': notify_online :start: : ensuring %s is started', $query_copy
    );
    <[zenka.cmd.start_once]>->( { 'args' => $query_copy } );
}

return { 'mode' => qw| deferred | }

