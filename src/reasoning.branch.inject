## [:< ##

# name  = reasoning.branch.inject
# param = { id, context, source_branch_id }

my $params = shift // {};

## command interface ##
if ( ref $params eq qw| HASH | and exists $params->{'args'} ) {
    my $args = $params->{'args'} // '';
    if ( length $args ) {
        my $parsed = eval { <[format.yaml.load_str]>->($args) };
        $params
            = ( defined $parsed and ref $parsed eq qw| HASH | )
            ? $parsed
            : { id => $args };
    } else {
        $params = {};
    }
}

my $id = $params->{'id'} // '';
return { 'mode' => qw| false |, 'data' => 'branch id required' }
    unless length $id;

my $registry = <reasoning.branch.registry> // {};
my $branch   = $registry->{$id};

return { 'mode' => qw| false |, 'data' => "branch not found: $id" }
    unless defined $branch;

my $context = $params->{'context'} // '';
return { 'mode' => qw| false |, 'data' => 'context required' }
    unless length $context;

## append to context file if path exists ##
my $ctx_path = $branch->{'context_path'} // '';
if ( length $ctx_path and -f $ctx_path ) {
    open my $fh, '>>',
        $ctx_path
        or return {
        'mode' => qw| false |,
        'data' => sprintf( 'cannot append to %s: %s', $ctx_path, $! )
        };
    my $src = $params->{'source_branch_id'} // 'unknown';
    print $fh "\n[INJECTED from $src]\n$context\n";
    close $fh;
}

## record injection in branch history ##
push $branch->{'checkpoints'}->@*,
    {
    summary       => "injected context from $params->{'source_branch_id'}",
    output_so_far => $context,
    timestamp     => <[base.ntime]>,
    };

## transition from paused to running ##
if ( $branch->{'state'} eq qw| paused | ) {
    $branch->{'state'} = qw| running |;
}

return { 'mode' => qw| true |, 'data' => 'context injected' };

