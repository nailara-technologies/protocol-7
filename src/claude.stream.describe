## [:< ##

# name   = claude.stream.describe
# descr  = readable lines for one stream event
# args   = decoded event hash
# return = list of 'kind : text' lines
#
# thin call : the one implementation is AMOS7::Claude::Stream, shared with
# _claude_stream_events in bin/mcp-server-p7 [ the one-shot claude runs ]

require AMOS7::Claude::Stream;
return AMOS7::Claude::Stream::describe( shift // {} );

