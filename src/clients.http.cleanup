## [:< ##

# name  = clients.http.cleanup
# descr = cancel watchers and close socket for a request state

my $state = shift // {};

for my $key (qw| timeout_watcher io_watcher |) {
    if ( defined $state->{$key} ) {
        eval { $state->{$key}->cancel };
        delete $state->{$key};
    }
}

if ( defined $state->{'sock'} ) {
    eval { $state->{'sock'}->close };
    delete $state->{'sock'};
}

