## [:< ##

# name  = system.watch.handler.signal_reply
# descr = events answered a watch signal

my $reply = shift                                        // {};
my $p     = $reply->{'params'}                           // {};
my $item  = <system.watch.outbox>->{ $p->{'seq'} // '' } // return FALSE;
return FALSE if $item->{'args'} ne ( $p->{'args'} // '' );

my ( $mode, $text ) = <[base.reply.mode_text]>->($reply);
if ( $mode ne qw| true | ) {
    <[base.logs]>->(
        0,
        '<< watch signal refused : %s : %s >>',
        $text =~ s{\s+\z}{}r,
        $item->{'args'}
    );
    return FALSE;    ## stays queued : sent again later ##
}
delete <system.watch.outbox>->{ $p->{'seq'} };
<system.watch.dirty> = TRUE;
<[system.watch.save]>;
return TRUE;

