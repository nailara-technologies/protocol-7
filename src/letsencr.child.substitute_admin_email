# name  = letsencr.child.substitute_admin_email
# param = <email_template> <domain_or_domains>
# descr = substitute :requested-domain: keyword in email template

my $email_template = shift;
my $domains        = shift;

unless ($email_template) {
    return undef;
}

## Handle domain list (array ref or scalar)
my $primary_domain = ref $domains eq qw| ARRAY | ? $domains->[0] : $domains;

unless ($primary_domain) {
    return $email_template;
}

## Perform substitution
my $result = $email_template;
$result =~ s/:requested-domain:/$primary_domain/g;

return $result;

0;

