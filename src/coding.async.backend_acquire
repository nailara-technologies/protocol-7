# name  = coding.async.backend_acquire
# param = task_id, backend
# descr = acquire backend lock or queue task if busy

my ( $task_id, $backend ) = @ARG;
$backend //= qw| gpu |;

<coding.state.backend> //= {};
<coding.state.backend>->{$backend} //= { lock => undef, queue => [] };

my $bs = <coding.state.backend>->{$backend};

## already holds the lock : re-entrancy guard. REVERTED 2026-09-24 to the   ##
## plain task_id-only check -- a same-task_id reacquire is the NORMAL,      ##
## expected shape of an ordinary round-to-round continuation [              ##
## state_machine / chunk_handler never call backend_release between a       ##
## task's own rounds, by design -- <coding.async.task_state> exists for a   ##
## task's ENTIRE lifecycle, not just while a request is actively in flight, ##
## so gating this on "does task_state exist" [ tried 2026-09-23, commit     ##
## d3c07acee ] refuses the shortcut for EVERY normal round transition, not  ##
## just a genuine race -- confirmed live 2026-09-24 : every multi-round     ##
## coding task got stuck queued behind its own lock at round 2, the very    ##
## first internal round-to-round transition after a tool call. this reopens ##
## the narrower original race [ two INDEPENDENT external triggers -- task-  ##
## append's resume branch vs coding.async.complete's own injected-messages  ##
## recovery -- both deciding a terminal-looking task needs a fresh round at ##
## the same moment ] rather than leaving basic multi-round functionality    ##
## broken ; that race needs a signal that actually distinguishes "one       ##
## caller's own synchronous continuation" from "a second, concurrent        ##
## caller", not task_state's mere existence -- revisit with more care       ##
## before re-adding, don't re-copy this exact check                         ##
if ( defined $bs->{'lock'} and $bs->{'lock'} eq $task_id ) {
    return { acquired => TRUE, queued => FALSE };
}

## lock is free : acquire ##
if ( not defined $bs->{'lock'} ) {
    $bs->{'lock'} = $task_id;
    <[base.logs]>->(
        2,        'backend_acquire: %s acquired %s lock',
        $task_id, $backend
    );
    return { acquired => TRUE, queued => FALSE };
}

## lock is held by another task : queue this task ##
my $queue = $bs->{'queue'};
unless ( grep { $ARG eq $task_id } @{$queue} ) {
    push @{$queue}, $task_id;
    <[base.logs]>->(
        1, 'backend_acquire: %s queued behind %s [%s] [%d waiting]',
        $task_id, $bs->{'lock'}, $backend, scalar @{$queue}
    );
}

return { acquired => FALSE, queued => TRUE };

