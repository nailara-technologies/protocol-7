## [:< ##

# name  = coding.async.backend_acquire
# param = task_id, backend
# descr = acquire backend lock or queue task if busy

my ( $task_id, $backend ) = @ARG;
$backend //= qw| gpu |;

<coding.state.backend> //= {};
<coding.state.backend>->{$backend} //= { lock => undef, queue => [] };

my $bs = <coding.state.backend>->{$backend};

## already holds the lock : re-entrancy guard, but only when nothing is     ##
## actually in flight for this task. an active round leaves an entry in     ##
## <coding.async.task_state> until it completes/errors [ deleted by         ##
## coding.async.state_machine / state_manager ] -- without this check, a    ##
## second, independent caller [ e.g. task-append's resume branch racing     ##
## coding.async.complete's own injected-messages recovery ] that still sees ##
## this task_id as lock-holder gets waved through instead of queued,        ##
## producing two concurrent send_request calls for one task : confirmed     ##
## live via duplicate enqueue_round log lines for one round number,         ##
## immediately after a burst of task-append resume lines ]                  ##
if (    defined $bs->{'lock'}
    and $bs->{'lock'} eq $task_id
    and not exists <coding.async.task_state>->{$task_id} ) {
    return { acquired => TRUE, queued => FALSE };
}

## lock is free : acquire ##
if ( not defined $bs->{'lock'} ) {
    $bs->{'lock'} = $task_id;
    <[base.logs]>->(
        2,        'backend_acquire: %s acquired %s lock',
        $task_id, $backend
    );
    return { acquired => TRUE, queued => FALSE };
}

## lock is held by another task : queue this task ##
my $queue = $bs->{'queue'};
unless ( grep { $ARG eq $task_id } @{$queue} ) {
    push @{$queue}, $task_id;
    <[base.logs]>->(
        1, 'backend_acquire: %s queued behind %s [%s] [%d waiting]',
        $task_id, $bs->{'lock'}, $backend, scalar @{$queue}
    );
}

return { acquired => FALSE, queued => TRUE };

