## [:< ##

# name  = coding.async.backend_acquire
# param = task_id, backend, [ token ]
# descr = acquire backend lock [ returns a token ] or queue task if busy

## token-based lock [ 2026-09-24 ] : the lock identity is a per-backend     ##
## token, not the task_id. one task makes many sequential requests and old  ##
## connections keep streaming / closing after the next round was sent, so   ##
## "same task_id" can not tell the holder from a stale or concurrent caller ##

## a fresh grant and a re-entry both rotate to a NEW token : whoever held  ##
## the previous one [ an older connection's callbacks ] can no longer      ##
## release. re-entry needs the CURRENT token, presented explicitly or      ##
## through <coding.async.lock_ctx> [ set by async.request's callbacks,     ##
## enqueue_round and the release handoff around their own synchronous call ##
## chain -- see coding.async.lock_token ]. a caller of the holder task     ##
## WITHOUT the token [ task-append, timers, complete's recovery paths ] is ##
## a second, independent caller : it queues like any other task instead of ##
## riding the running request                                              ##

## do NOT go back to a task_id / task_state based re-entry check -- see    ##
## data/ai-mem/claude/project-coding-async-backend-acquire-reentrancy-race ##

my ( $task_id, $backend, $token ) = @ARG;
$backend //= qw| gpu |;

<coding.state.backend> //= {};
<coding.state.backend>->{$backend} //= { lock => undef, queue => [] };

my $bs = <coding.state.backend>->{$backend};

## implicit presentation : the synchronous call chain of the holder ##
$token //= <[coding.async.lock_token]>->( $task_id, $backend );

## holder presents the current token : re-entry, rotate the token ##
if (    defined $bs->{'lock'}
    and $bs->{'lock'} eq $task_id
    and defined $token
    and defined $bs->{'lock_token'}
    and $token == $bs->{'lock_token'} ) {
    my $new_token = ++$bs->{'token_counter'};
    $bs->{'lock_token'} = $new_token;
    <[base.logs]>->(
        '2:1',    'lock %s: %s#%d -> %s#%d [reenter]',
        $backend, $task_id, $token, $task_id, $new_token
    );
    return { acquired => TRUE, queued => FALSE, token => $new_token };
}

## lock is free : acquire ##
if ( not defined $bs->{'lock'} ) {
    my $new_token = ++$bs->{'token_counter'};
    $bs->{'lock'}       = $task_id;
    $bs->{'lock_token'} = $new_token;
    <[base.logs]>->(
        2,        'backend_acquire: %s acquired %s lock',
        $task_id, $backend
    );
    <[base.logs]>->(
        '2:1',    'lock %s: free -> %s#%d [acquire]',
        $backend, $task_id, $new_token
    );
    return { acquired => TRUE, queued => FALSE, token => $new_token };
}

## lock is held [ by another task, or by this task without its token ] : ##
## queue this task                                                       ##
my $queue = $bs->{'queue'};
unless ( grep { $ARG eq $task_id } @{$queue} ) {
    push @{$queue}, $task_id;
    <[base.logs]>->(
        1, 'backend_acquire: %s queued behind %s [%s] [%d waiting]',
        $task_id, $bs->{'lock'}, $backend, scalar @{$queue}
    );
    <[base.logs]>->(
        ## level 1 only when queued behind itself [ lost token context ] ##
        ( $bs->{'lock'} eq $task_id ? 1 : '2:1' ),
        'lock %s: %s#%s -> %s#%s [queue %s%s, %d waiting]',
        $backend,
        $bs->{'lock'},
        $bs->{'lock_token'} // '-',
        $bs->{'lock'},
        $bs->{'lock_token'} // '-',
        $task_id,
        (   $bs->{'lock'} eq $task_id
            ? ' : holder without token#' . ( $token // '-' )
            : ''
        ),
        scalar @{$queue}
    );
}

return { acquired => FALSE, queued => TRUE };

