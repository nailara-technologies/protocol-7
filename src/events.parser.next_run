## [:< ##

# name   = events.parser.next_run
# descr  = list filter : unix time of the next run as clock time
# args   = number <unix time>
# return = 'HH:MM:SS' or 'n/a'

my $time = shift;
return qw| n/a | if not defined $time or $time !~ m|\A\d+(\.\d+)?\z|;

return <[base.parser.timestamp]>->( qw| time |, $time );

