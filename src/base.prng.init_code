## [:< ##

# name  = base.prng.init_code

my $reinit = shift;    ## guard : a reload must not arm a second timer ##

<[base.perlmod.load]>->('Crypt::PRNG::Fortuna');

##  Crypt::PRNG::Fortuna object is in <base.prng.fortuna>  ##
##
<[base.prng.reseed]>;

## keep feeding fresh entropy [ base.prng.add_entropy ] -- eval : a zenka ##
## without an event loop simply goes without the timer                    ##
<base.prng.cfg.add_entropy_interval> //= 137;
if (   not $reinit
    or not defined <base.prng.entropy_timer>
    or not eval { <base.prng.entropy_timer>->is_active } ) {
    eval {
        <base.prng.entropy_timer> = <[event.add_timer]>->(
            {   'after'    => <base.prng.cfg.add_entropy_interval>,
                'interval' => <base.prng.cfg.add_entropy_interval>,
                'repeat'   => 1,
                'handler'  => qw| base.prng.handler.add_entropy |,
                'data'     => {},
                'desc'     => 'fortuna : periodic fresh entropy',
            }
        );
    };
}

0;

