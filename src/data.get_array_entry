# name  = data.get_array_entry
# param = <path> <name>
# descr = get entry by name from ARRAY listing
# return = entry hash ref or undef

my $path_str = shift // return undef;
my $name     = shift // return undef;
my $ref      = <[data.resolve_hash_path]>->($path_str);

return undef unless ref($ref) eq 'ARRAY';

for my $entry ( @{$ref} ) {
    return $entry if $entry->{'name'} eq $name;
}

return undef;

