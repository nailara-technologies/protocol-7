## [:< ##

# name  = nameserv.enc.dispatch
# param = <connection> <dns wire>
# descr = hand one reply of an encrypted connection to the waiting query

my $conn = shift // return FALSE;
my $wire = shift // return FALSE;

my $id    = unpack qw| n |, $wire;
my $state = $conn->{'inflight'}{$id} // return FALSE;    ## late \ unknown ##
delete $conn->{'inflight'}{$id};
$state->{'enc_conn'} = undef;
if ( ref $state->{'timer'} ) {
    $state->{'timer'}->cancel
        if $state->{'timer'}->can('is_active')
        and $state->{'timer'}->is_active;
    $state->{'timer'} = undef;
}
return <[nameserv.enc.deliver]>->( $state, $wire );

