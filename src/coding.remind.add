## [:< ##

# name   = coding.remind.add
# descr  = the events bucket entry of a new reminder
# args   = { when time to text unless reply_id }
# return = the command reply [ deferred \ true \ false ]

my $in = shift // {};
my ( $when, $to, $text ) = @{$in}{qw| when to text |};
my $reply_id = $in->{'reply_id'} // '';

## the id : milliseconds and a counter -- a fired entry is final under its ##
## id, so a new reminder after a restart must not meet an old one          ##
my $seq = ++<coding.remind.seq>;
my $id  = sprintf 'remind-%d%02d', int( Time::HiRes::time() * 1000 ),
    $seq % 100;
## a named session is recorded with its sid : `session:<name>@<sid>` in the ##
## entry's command, the name may change before it fires                     ##
my $target = $to;
if ( $to =~ m{\Asession:([\w.\-]+)\z} ) {
    my $name = <[coding.sessions.resolve]>->($1);
    my $sid  = ( <[coding.sessions.store]>->()->{$name} // {} )->{'sid'};
    $target = "session:$name\@$sid" if defined $sid;
}
my $quote = sub { "\x22" . ( shift =~ s{([\\\x22])}{\\$1}gr ) . "\x22" };
my $args
    = join ' ',
    $id,
    "$when=" . $quote->( $in->{'time'} ),
    'action=send-command',
    'command=' . $quote->("coding.remind-fire $id $target $text"),
    'reason=' . $quote->("$text [ to=$to ]"),
    defined $in->{'unless'}
    ? ( 'unless=' . $quote->( $in->{'unless'} ) )
    : ();
<[park.send]>->(
    qw| bucket-add |,
    $args,
    qw| coding.handler.remind_reply |,
    { 'reply_id' => $reply_id, 'label' => "reminder $id" }
    )
    or return {
    'mode' => qw| false |,
    'data' => 'events zenka not reachable : no reminder'
    };
return { 'mode' => qw| deferred | } if $reply_id =~ m{\A\d+\z};
return { 'mode' => qw| true |, 'data' => "reminder $id requested" };

