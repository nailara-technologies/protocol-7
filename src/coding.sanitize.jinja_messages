## [:< ##

# name  = coding.sanitize.jinja_messages
# descr = sanitize message array for jinja2 template safety + tool role workaround

## sanitize all messages in-place for jinja2 template safety prevents       ##
## ik_llama.cpp jinja engine from crashing on {{ }}, {% %} and namespace( ) ##
## patterns in message content and tool call arguments                      ##

my ($messages) = @ARG;

return unless ref $messages eq qw| ARRAY |;

## Check if workaround is enabled ##
my $convert_tool_role = <[base.cfg_bool]>->(<coding.jinja.convert_tool_role>);

my $converted_count = 0;
for my $msg ( @{$messages} ) {

    ## Workaround: convert tool role messages to user role  [ Qwen3.5 and   ##
    ## some other models' jinja templates don't handle role='tool', causing ##
    ## server hangs on accumulated tool rounds ]                            ##
    if ( $convert_tool_role
        && ( $msg->{'role'} // '' ) eq qw| tool | ) {
        my $tc_id   = $msg->{'tool_call_id'} // 'unknown';
        my $content = $msg->{'content'}      // '';
        $msg->{'role'}    = qw| user |;
        $msg->{'content'} = "[TOOL RESULT: $tc_id]\n$content";
        delete $msg->{'tool_call_id'};
        $converted_count++;
    }

    ## sanitize message content ##
    my $content = $msg->{'content'} // '';
    if ( length $content ) {
        $content =~ s|\{\{|｛｛|g;
        $content =~ s|\}\}|｝｝|g;
        $content =~ s|\{%|｛%|g;
        $content =~ s|%\}|%｝|g;
        $content =~ s|namespace\s*\(|namespace_(|g;
        $msg->{'content'} = $content;
    }

    ## sanitize tool call arguments ##
    if ( ref $msg->{'tool_calls'} eq qw| ARRAY | ) {
        for my $tc ( $msg->{'tool_calls'}->@* ) {
            my $args = $tc->{'function'}->{'arguments'} // '';
            ## skip if arguments already decoded to hashref ##
            next if ref $args;
            if ( length $args ) {
                $args =~ s|\{\{|\\{\\{|g;
                $args =~ s|\{%|\\{%|g;
                $args =~ s|namespace\s*\(|namespace_(|g;
                ## fix illegal backslash escapes : server Jinja crashes on ##
                ## \[ etc (?<!\\) prevents re-processing already-escaped   ##
                ## sequences without lookbehind, each round doubles: \. →  ##
                ## \\. → \\\\.                                             ##
                $args =~ s|(?<!\\)\\([^"\\\/bfnrtu])|'\\\\' . $1|ge;
                $tc->{'function'}->{'arguments'} = $args;
            }
        }
    }
}

if ($converted_count) {
    <[base.logs]>->(
        1, "sanitize.jinja: converted %d tool role messages to user role",
        $converted_count
    );
}

## Strip tool_calls from older assistant messages  [ Qwen template tries to ##
## match tool_calls with role:tool messages; after conversion those are     ##
## user-role, causing hangs with >3 rounds ]                                ##
if ($convert_tool_role) {
    my @tc_indices;
    for my $i ( 0 .. $#{$messages} ) {
        my $msg = $messages->[$i];
        push @tc_indices, $i
            if ( $msg->{'role'} // '' ) eq qw| assistant |
            and ref $msg->{'tool_calls'} eq qw| ARRAY |
            and @{ $msg->{'tool_calls'} };
    }
    if (@tc_indices) {
        my $stripped = 0;
        for my $i (@tc_indices) {
            delete $messages->[$i]->{'tool_calls'};
            $stripped++;
        }
        <[base.logs]>->(
            1, "sanitize.jinja: stripped tool_calls from %d assistant msgs",
            $stripped
        );
    }
}

return;

