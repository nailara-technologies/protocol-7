## [:< ##

# name  = clients.https.h2.send_request
# descr = build + send http/2 request via Protocol::HTTP2::Client, register read watcher
# note  = called by clients.https.handler.handshake when alpn negotiated 'h2'

my $state = shift // {};
my $sock  = $state->{'sock'};

## shared failure path : same response contract as the http/1.1 handlers ##
my $fail = sub {
    my $err = shift // 'http/2 request failed';

    return if not defined $state->{'sock'};    ## already cleaned up ##

    <[base.logs]>->( 0, 'clients.https.h2: %s', $err );
    <[clients.https.cleanup]>->($state);
    $code{ $state->{'on_done'} }->(
        {   'ok'     => FALSE,
            'error'  => $err,
            'params' => $state->{'params'},
        }
    );
    return;
};

## stream completion : headers arrive as flat [ name, value, ... ] list ##
my $on_response = sub {
    my $h2_headers = shift;
    my $data       = shift;

    return if not defined $state->{'sock'};    ## already cleaned up ##

    my %resp_headers;
    my @flat = @{ $h2_headers // [] };
    while ( my ( $k, $v ) = splice( @flat, 0, 2 ) ) {
        $resp_headers{ lc $k } = $v;
    }
    my $status = ( $resp_headers{':status'} // 0 ) + 0;
    my $ok     = ( $status >= 200 and $status < 300 ) ? TRUE : FALSE;

    my $body = $data // '';

    $body = <[clients.https.decode_body]>->(
        $body, \%resp_headers, qw| clients.https.h2 |
    );

    <[clients.https.cleanup]>->($state);
    ## header names are already lower-cased above : same contract as the ##
    ## http/1.1 path in clients.https.handler.io                         ##
    $code{ $state->{'on_done'} }->(
        {   'ok'      => $ok,
            'status'  => $status,
            'body'    => $body,
            'headers' => \%resp_headers,
            'params'  => $state->{'params'},
        }
    );
    return;
};

my $h2 = eval {
    Protocol::HTTP2::Client->new(
        ## connection-level protocol errors [ not stream resets ] ##
        'on_error' => sub {
            my $code = shift;
            $fail->(
                sprintf 'http/2 protocol error [ code %d ]',
                $code // -1
            );
        },
    );
};

if ( length $EVAL_ERROR or not $h2 ) {
    $fail->(
        sprintf 'http/2 client ' . 'init failed: %s',
        scalar <[base.str.eval_error]>
    );
    return undef;
}

$state->{'h2'} = $h2;

## request headers : caller-supplied only, lowercased [ h2 requirement ] h1 ##
## connection-specific headers are invalid in http/2 : skipped              ##
my %skip_h1
    = map { $_ => TRUE }
    qw| host connection keep-alive transfer-encoding upgrade |;
my @h2_headers;
for my $k ( keys %{ $state->{'headers'} // {} } ) {
    my $lk = lc $k;
    next if exists $skip_h1{$lk};
    push @h2_headers, $lk, $state->{'headers'}->{$k};
}
if ( length( $state->{'body'} // '' ) ) {
    push @h2_headers, 'content-length', length $state->{'body'};
}

my $authority = $state->{'host'};
$authority .= ':' . $state->{'port'} if $state->{'port'} != 443;

## per-request on_error is required inside the request hash : without it a ##
## stream reset [ RST_STREAM ] is silently routed to on_done as an empty   ##
## response, indistinguishable from a real-but-empty one                   ##
eval {
    $h2->request(
        ':scheme'    => 'https',
        ':authority' => $authority,
        ':path'      => $state->{'path'},
        ':method'    => $state->{'method'},
        'headers'    => \@h2_headers,
        (   length( $state->{'body'} // '' )
            ? ( 'data' => $state->{'body'} )
            : ()
        ),
        'on_done'  => $on_response,
        'on_error' => sub {
            my $code = shift;
            $fail->(
                sprintf 'http/2 stream reset [ error code %d ]',
                $code // -1
            );
        },
    );
};

if ( length $EVAL_ERROR ) {
    $fail->(
        sprintf 'http/2 request ' . 'build failed: %s',
        scalar <[base.str.eval_error]>
    );
    return undef;
}

## drain queued frames [ preface, settings, headers ] : next_frame can ##
## produce more than one frame per call site, loop until exhausted     ##
while ( my $frame = $h2->next_frame ) {
    my $total   = length($frame);
    my $written = 0;
    while ( $written < $total ) {
        my $n = syswrite( $sock, $frame, $total - $written, $written );
        if ( defined $n ) {
            $written += $n;
        } elsif ( $OS_ERROR{EAGAIN}
            or $OS_ERROR{EWOULDBLOCK}
            or $IO::Socket::SSL::SSL_ERROR
            == IO::Socket::SSL::SSL_WANT_WRITE()
            or $IO::Socket::SSL::SSL_ERROR
            == IO::Socket::SSL::SSL_WANT_READ() ) {
            select( undef, undef, undef, 0.001 );
        } else {
            $fail->("ssl write failed: $OS_ERROR");
            return undef;
        }
    }
}

## read watcher for the response ##
my $io_watcher = <[event.add_io]>->(
    {   'fd'      => $sock,
        'poll'    => 'r',
        'handler' => 'clients.https.h2.handler.io',
        'data'    => $state,
    }
);

$state->{'io_watcher'} = $io_watcher;

<[base.logs]>->(
    2, 'clients.https.h2.send_request: %s %s%s [ h2 request sent ]',
    $state->{'method'}, $state->{'host'}, $state->{'path'}
);

return $state;

