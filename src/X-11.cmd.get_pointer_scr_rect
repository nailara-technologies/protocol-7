## [:< ##

# name  = X-11.cmd.get_pointer_scr_rect
# descr = return monitor rect containing pointer position

my %ptr = eval { <X-11.obj>->QueryPointer( <X-11.obj>->root ) };
return { 'mode' => qw| false |, 'data' => 'QueryPointer failed' }
    if $EVAL_ERROR
    or not defined $ptr{'root_x'};

my ( $px, $py ) = @ptr{qw| root_x root_y |};

## lookup monitor rect from in-memory RANDR registry ##
my $monitors = <X-11.monitors>;
if ( not defined $monitors or not @$monitors ) {
    return {
        'mode' => qw| false |,
        'data' => 'monitor registry not available'
    };
}

my ( $first_x, $first_y, $first_w, $first_h );
for my $m (@$monitors) {
    my ( $x, $y, $w, $h ) = @{$m}{qw| x y width height |};
    ( $first_x, $first_y, $first_w, $first_h ) = ( $x, $y, $w, $h )
        if not defined $first_w;
    if (    $px >= $x
        and $px < $x + $w
        and $py >= $y
        and $py < $y + $h ) {
        return { 'mode' => qw| true |, 'data' => "$x $y $w $h" };
    }
}
return defined $first_w
    ? {
    'mode' => qw| true |,
    'data' => "$first_x $first_y $first_w $first_h"
    }
    : { 'mode' => qw| false |, 'data' => 'no monitors in registry' };

