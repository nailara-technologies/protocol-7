## [:< ##

# name  = editor.buffer.memory.insert
# descr = insert text at CHARACTER position in in-memory editor buffer

## $position in CHARACTERS [ design: position_units ]. text inserted at or
## before the cursor pushes the cursor right [ standard editing semantics ].

my ( $buffer, $position, $text ) = @ARG;

return undef if ref $buffer ne qw| HASH |;
return undef if $buffer->{'readonly'};
$text //= '';
return TRUE if not length $text;

utf8::decode($text) if not utf8::is_utf8($text);

my $buf_len = length $buffer->{'text'};
$position //= $buffer->{'cursor'};
$position = 0        if $position < 0;
$position = $buf_len if $position > $buf_len;

substr( $buffer->{'text'}, $position, 0, $text );

## keep the parallel star-count array in sync with the inserted characters
if ( ( $buffer->{'type'} // '' ) eq qw| masked | ) {
    $buffer->{'mask_stars'} //= [];
    $buffer->{'mask_stars'} = []
        if ref $buffer->{'mask_stars'} ne qw| ARRAY |;
    splice @{ $buffer->{'mask_stars'} }, $position, 0,
        map { <[editor.buffer.mask_star_count]>->( $position + $ARG ) }
        0 .. length($text) - 1;
}

$buffer->{'cursor'} += length($text) if $buffer->{'cursor'} >= $position;

return TRUE;

