## [:< ##

# name  = site-yaml.async_fetch.headers
# descr = browser-realistic request header set for async fetches
# note  = live-verified against stepstone.de through akamai : a minimal
#         header set gets RST_STREAM -- keep this exact [ never offer br ]

return {
    'user-agent' => 'Mozilla/5.0 (X11; Linux x86_64; '
        . 'rv:124.0) Gecko/20100101 Firefox/124.0',
    'accept' => 'text/html,application/xhtml+xml,application/xml;'
        . 'q=0.9,image/avif,image/webp,*/*;q=0.8',
    'accept-language' => 'de-DE,de;q=0.9,en;q=0.8',
    ## never br, see http2 task ##
    'accept-encoding'           => 'gzip, deflate, zstd',
    'upgrade-insecure-requests' => '1',
    'sec-fetch-dest'            => 'document',
    'sec-fetch-mode'            => 'navigate',
    'sec-fetch-site'            => 'none',
    'sec-fetch-user'            => '?1',
};

