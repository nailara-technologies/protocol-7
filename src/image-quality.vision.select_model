## [:< ##

# name = image-quality.vision.select_model
# descr = Select appropriate vision model from registry

# Get vision models from centralized init_code loading
my $vision_models = <image-quality.vision_models> || [];

return { success => FALSE, error => 'No vision models available' }
    unless @$vision_models > 0;

<[base.logs]>->(
    1,
    "[image-quality.vision.select_model] Selecting from %d available models",
    scalar(@$vision_models)
);

# Preferred order (based on tested reliability with llama-mtmd-cli)
my @preferred_ids = (
    'qwen2.5-vl-7b-instruct', 'qwen3-vl-4b-instruct',
    'opus-100-manga',         'gemma3-4b-it-uncensored',
    'gemma3-glitter-4b'
);

# Try to find a preferred model
foreach my $preferred_id (@preferred_ids) {
    foreach my $model (@$vision_models) {
        if ( $model->{id} eq $preferred_id ) {
            <[base.logs]>->(
                1, "[image-quality.vision.select_model] Selected: %s",
                $model->{name}
            );

            return {
                success        => TRUE,
                model_id       => $model->{id},
                model_path     => $model->{path},
                model_name     => $model->{name},
                mmproj         => $model->{mmproj},
                context_size   => $model->{context_size},
                batch_size     => $model->{batch_size},
                tokens_per_sec => $model->{tokens_per_sec},
                max_resolution => 4096
            };
        }
    }
}

# Fallback: return first available vision model
my $first = $vision_models->[0];
<[base.logs]>->(
    1, "[image-quality.vision.select_model] Using fallback: %s",
    $first->{name}
);

return {
    success        => TRUE,
    model_id       => $first->{id},
    model_path     => $first->{path},
    model_name     => $first->{name},
    mmproj         => $first->{mmproj},
    context_size   => $first->{context_size},
    batch_size     => $first->{batch_size},
    tokens_per_sec => $first->{tokens_per_sec},
    max_resolution => 4096
};

