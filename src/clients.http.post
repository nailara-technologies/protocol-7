# name  = clients.http.post
# descr = async http post : thin wrapper around clients.http.request

my $p = shift // {};

$p->{'method'} = 'POST';
$p->{'headers'}{'Content-Type'} //= 'application/json';

return <[clients.http.request]>->($p);

