## [:< ##

# name  = base.pattern-registry.action.classify
# descr = terminal action : match -> label, no output mutation [ smtpd's
#         actual need -- the "what does a match mean" decision is left to
#         the caller, not the engine, matching how ncode.regex.apply
#         already leaves "what a fix means" entirely to its callers ]
# param = { def, name, output, matches }
# return = { label }

my $params = shift // {};

my $def = $params->{'def'} // {};

return { 'label' => $def->{'label'} };

