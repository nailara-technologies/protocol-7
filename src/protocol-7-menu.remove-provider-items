# name = protocol-7-menu.remove-provider-items
# descr = Remove all menu items for provider from GUI

my ($provider) = @ARG;

return 0 unless <protocol-7-menu.init-graphical>;

my $gui_items     = <protocol-7-menu.gui-provider-items> //= {};
my $provider_refs = $gui_items->{$provider};

return 0 unless defined $provider_refs;

## Get the provider's menu item
my $provider_item = $provider_refs->{menu_item};
return 0 unless defined $provider_item;

## Get parent menu and remove the item
my $parent_menu = $provider_item->get_parent();
if ( defined $parent_menu ) {
    $parent_menu->remove($provider_item);
    $parent_menu->show_all;
}

## Clean up references
delete $gui_items->{$provider};

<[base.logs]>->( 1, "removed menu items for provider '%s'", $provider );

return 0;

