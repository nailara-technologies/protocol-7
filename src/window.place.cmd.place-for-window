## [:< ##

# name  = window.place.cmd.place-for-window
# descr = overlay placement over target window current geometry

my $args = $call->{'args'} // '';

my ( $caller, $winid );
foreach my $token ( split /\s+/, $args ) {
    if    ( $token =~ m|^caller=(.+)$| ) { $caller = $1 }
    elsif ( $token =~ m|^winid=(\d+)$| ) { $winid  = $1 }
    elsif ( not defined $caller )        { $caller = $token }
    elsif ( not defined $winid )         { $winid  = $token }
}

$caller //= '';
$winid  //= '';

if ( not length $caller ) {
    <[base.log]>->( 0, '[place-for-window] caller required' );
    return { 'mode' => 'false', 'data' => 'caller required' };
}
if ( not length $winid or $winid !~ /^\d+$/ ) {
    <[base.log]>->( 0, '[place-for-window] numeric winid required' );
    return { 'mode' => 'false', 'data' => 'numeric winid required' };
}

## guard: deduplicate requests for same caller+winid ##
for my $eid ( keys %{ $data{window}{place}{instances} } ) {
    my $e = $data{window}{place}{instances}{$eid};
    next if ( $e->{'caller'}       // '' ) ne $caller;
    next if ( $e->{'target_winid'} // '' ) ne $winid;
    ## overlay already shown: raise it rather than blocking ##
    my $win = $e->{'window'};
    if ( defined $win ) {
        eval { $win->set_keep_above(1); $win->present; $win->grab_focus };
        <[base.logs]>->(
            1,
            '[place-for-window] raising existing '
                . 'overlay [caller=%s winid=%s]',
            $caller,
            $winid
        );
    } else {
        <[base.logs]>->(
            1,
            '[place-for-window] overlay already active [caller=%s winid=%s]',
            $caller,
            $winid
        );
    }
    return { 'mode' => qw| true |, 'data' => 'placement already active' };
}

## unique per-request identifier ##
my $id;
do { $id = <[base.prng.chars-anum]>->(8) }
    while exists $data{window}{place}{instances}{$id};

$data{window}{place}{instances}{$id} = {
    'caller'       => $caller,
    'reply_id'     => $call->{'reply_id'},
    'target_winid' => $winid,
    'fill_alpha'   => 0.52,
};

<[base.logs]>->(
    1,   '[place-for-window] id=%s caller=%s winid=%s — querying geometry',
    $id, $caller, $winid
);

<[base.zenki.resolve_primary_sid]>->(
    'X-11',
    sub {
        my $sid = shift;
        return if not defined $sid;
        <[protocol-7.route-send]>->(
            {   'command'   => "$sid.get_geometry",
                'call_args' => { 'args' => $winid },
                'reply'     => {
                    'handler' => 'window.place.handler.wingeom_reply',
                    'params'  => { 'instance_id' => $id }
                }
            }
        );
    }
);

return { 'mode' => 'deferred' };

