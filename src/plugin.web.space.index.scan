## [:< ##

# name  = plugin.web.space.index.scan
# descr = walk target directory and populate index cache with checksum + gen_path

my $target_dir = <web.space.index.cfg.target_dir> // qw| src |;
my $base_path  = $target_dir;

## resolve relative path against project root if needed ##
if ( index( $target_dir, qw| / | ) != 0 ) {
    my $root = <system.root_path> // $ENV{'PWD'} // qw| . |;
    $base_path = "$root/$target_dir";
}

## ensure directory exists ##
if ( not -d $base_path ) {
    <[base.logs]>->(
        0, 'plugin.web.space.index.scan : target dir not found: %s',
        $base_path
    );
    return;
}

my $checksum_bits = <web.space.index.cfg.checksum_bits> // 512;
my @cells;
my @dirs_to_scan = ($base_path);

## manual directory recursion [ no File::Find needed ] ##
while ( my $current_dir = shift @dirs_to_scan ) {
    opendir my $dh, $current_dir
        or next;

    my @entries = readdir $dh;
    closedir $dh;

    foreach my $entry (@entries) {
        next if $entry eq '.' or $entry eq '..';

        my $full_path = "$current_dir/$entry";

        if ( -d $full_path ) {
            push @dirs_to_scan, $full_path;
        } elsif ( -f $full_path ) {
            my $rel_path = $full_path;
            $rel_path =~ s|^$base_path/||;

            my $checksum = eval {
                <[chk-sum.bmw.filesum]>->( $checksum_bits, $full_path );
            } // qw| error |;

            my $gen_path
                = eval { <[index.gen_path]>->( \$checksum ) } // qw| error |;

            ## bin/Protocol-7 does 'use File::stat' globally : shadows the ##
            ## builtin ; use the OO form like the rest of P7 does          ##
            my $st    = File::stat::stat($full_path);
            my $size  = $st ? $st->size  : 0;
            my $mtime = $st ? $st->mtime : 0;

            push @cells,
                {
                qw| path     | => $full_path,
                qw| rel_path | => $rel_path,
                qw| checksum | => $checksum,
                qw| gen_path | => $gen_path,
                qw| size     | => $size,
                qw| mtime    | => $mtime,
                };
        }
    }
}

my $cache = <web.space.index.cache> // {};

$cache->{'target_dir'} = $target_dir;
$cache->{'file_count'} = scalar @cells;
$cache->{'cells'}      = \@cells;
$cache->{'timestamp'}  = time();

## pre-encode json + yaml for fast http serving ##
my $payload = {
    qw| target_dir | => $target_dir,
    qw| file_count | => scalar @cells,
    qw| cells      | => \@cells,
    qw| timestamp  | => $cache->{'timestamp'},
};

<web.space.index.json_cached>
    = eval { JSON::XS::encode_json($payload) } // '{}';
require YAML::XS;
<web.space.index.yaml_cached>
    = eval { YAML::XS::Dump($payload) } // "--- {}\n";

<[base.logs]>->(
    2,              'plugin.web.space.index.scan : scanned %s files in %s',
    scalar(@cells), $target_dir
);

return $cache;

