## [:< ##

# name  = letsencr.child.acme.cleanup
# param = <order record>
# descr = remove every challenge set up for an order

my $order = shift // return FALSE;

my $provider = <letsencr.dns.provider> // qw| nameserv |;

foreach my $authz ( values $order->{'authz'}->%* ) {
    my $setup = $authz->{'setup'} // next;
    foreach my $target ( sort keys $setup->%* ) {

        ## a set-up that was sent may have landed even without its reply ##
        if ( $target eq qw| httpd | ) {
            <[protocol-7.route-send]>->(
                {   'command'   => qw| httpd.cleanup-acme-challenge |,
                    'call_args' =>
                        { 'args' => "$authz->{'base'} $authz->{'token'}" }
                }
            );
        } elsif ( $target eq $provider
            and exists $code{"letsencr.dns.${target}_delete_txt"} ) {
            $code{"letsencr.dns.${target}_delete_txt"}->(
                <[letsencr.child.acme.challenge_name]>->( $authz->{'base'} ),
                $authz->{'dns_value'}
            );
        } else {
            <[protocol-7.route-send]>->(
                {   'command'   => "$target.remove-txt",
                    'call_args' => {
                        'args' => <[letsencr.child.acme.challenge_name]>->(
                            $authz->{'base'}
                            )
                            . ' '
                            . $authz->{'dns_value'}
                    }
                }
            );
        }
    }
    delete $authz->{'setup'};
}

return TRUE;

