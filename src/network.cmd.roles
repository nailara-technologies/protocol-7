## [:< ##

# name  = network.cmd.roles
# descr = iface roles [ lan external unknown ] and networks

my $iface = <[network.interfaces.collect]>;
my $role  = <[network.interfaces.roles]>->($iface);
my @names = sort keys $role->%*;
return {
    qw| mode | => qw| size |,
    qw| data | => "no network interfaces found\n"
    }
    if not @names;
my $width = length qw| IFACE |;
foreach my $name (@names) {
    $width = length $name if length($name) > $width;
}
my $format = "%-${width}s %-8s %-11s %s\n";
my $table  = sprintf( $format, qw| IFACE ROLE SOURCE NETWORK | );
$table
    .= sprintf( $format, $ARG, $role->{$ARG}->@{qw| role source network |} )
    foreach @names;
$table .= "set a role : net.role.<iface> = "
    . "lan|external in host-config/net.cfg\n";
return { qw| mode | => qw| size |, qw| data | => $table };

