## [:< ##

# name  = models.chat.expand_refs.format_head
# descr = format first N lines of file content for inline expansion
# param = $path    - file path label
# param = $content - file content string
# param = $n       - number of lines from start
# return = formatted string with head lines

my ( $path, $content, $n ) = @ARG;

return $content if $content =~ m{^\[ERROR:};

my @lines = split( m{\n}, $content );
my @head  = splice( @lines, 0, $n );

return sprintf( "\n=== HEAD (%d lines): %s ===\n%s\n=== END ===\n",
    $n, $path, join( "\n", @head ) );

0;

