## [:< ##

# name  = context.git.recent_changes
# descr = return recent git changes, truncated to fit token budget
# usage = <[context.git.recent_changes]>->( { budget => 1500,
#           max_files => 10, since_commit => '' } )

my $params = shift // {};

## extract parameters ##
my $budget       = $params->{'budget'}    // 1500;    ## token budget
my $max_files    = $params->{'max_files'} // 10;      ## max files to list
my $since_commit = $params->{'since_commit'}
    // '';    ## optional: since specific commit

## convert token budget to char budget ( ~4 chars/token ) ##
my $char_budget = int( $budget * 4 );
my $output      = '';

## run from project root ##
my $root = <system.root_path>;

## verify git repo before running commands ##
unless ( -d "$root/.git" ) {
    return "<!-- not a git repository -->";
}

## git diff --stat for uncommitted changes, via the git binary ##
##
## Git::Native::Diff is deliberately NOT used here : its diff entry points
## corrupt process-global FFI state after the FIRST call in any long- running
## process [ second call dies 'invalid version <garbage> on git_diff_options'
## -- reproducible one-shot, owner-independent ] and the root cause is
## untraced. the binary path needs no libgit2 and honors the safe.directory
## env vars coding.init_code sets [ GIT_CONFIG_COUNT ; the binary never had
## the ownership problem ]. Git::Wrapper passes diff args through RAW [ no
## Smart parser on diff ] so '--stat' output comes back verbatim.
my $git = Git::Wrapper->new($root);

my $stat_output = '';
my $diff_error  = '';
my @diff_args   = ('--stat');
push @diff_args, $since_commit if length $since_commit;
eval {
    $stat_output = join "\n", $git->diff(@diff_args);
    1;
} or $diff_error = $EVAL_ERROR;
<[base.logs]>->(
    1,
    'recent_changes : git diff failed :. %s',
    ( $diff_error =~ s|\s+at\s+\S+.*||sgr )
) if length $diff_error;

## if no uncommitted changes, show recent commits instead ##
unless ( length $stat_output ) {
    ## the log stays on Git::Wrapper -- Git::Native has no log API [ only
    ## Diff, currently landmined, see above ]. Git::Wrapper's log() FORCES its
    ## own --pretty=medium and parses for '^commit <sha>' lines : passing
    ## '--oneline' overrides the format on the command line and the parser
    ## dies 'unhandled: <line>' on the first output row -- broken since the
    ## March 2026 rewrite, masked by a fully silent eval. use the structured
    ## objects and build the oneline shape here instead.
    my @logs      = ();
    my $log_error = '';
    eval {
        @logs = $git->log("-$max_files");
        1;
    } or $log_error = $EVAL_ERROR;
    ## a genuinely quiet repo and a failed git call used to collapse into the
    ## same '<!-- no recent changes -->' -- log the real error so the two stop
    ## being indistinguishable
    <[base.logs]>->(
        1,
        'recent_changes : git log failed :. %s',
        length $log_error ? $log_error : '( no output, no error )'
    ) if length $log_error or not @logs;
    return "<!-- no recent changes -->" unless @logs;
    $stat_output = join "\n", map {
        my ($subject) = split m{\n}, $_->message // '';
        substr( $_->id, 0, 7 ) . ' ' . $subject
    } @logs;
}

## parse and truncate to budget ##
my @lines        = split( m|\n|, $stat_output );
my $header       = "## recent changes ##\n";
my $used         = length($header);
my @output_lines = ($header);

## add lines until budget exhausted ##
my $file_count = 0;
foreach my $line (@lines) {
    last if $file_count >= $max_files;

    my $line_len = length($line) + 1;    ## +1 for newline

    ## check if adding this line would exceed budget ##
    if ( $used + $line_len > $char_budget ) {
        push @output_lines, "... (truncated, budget exceeded)";
        last;
    }

    push @output_lines, $line;
    $used += $line_len;
    $file_count++ if $line =~ m{\|};     ## count files (lines with |)
}

$output = join( "\n", @output_lines );

## add summary ##
$output .= "\n\n";
if ( $file_count >= $max_files ) {
    $output .= "<!-- showing $max_files of " . scalar(@lines) . " files -->";
} else {
    $output .= "<!-- $file_count files changed -->";
}

return $output;

