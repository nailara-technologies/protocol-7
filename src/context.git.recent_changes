## [:< ##

# name  = context.git.recent_changes
# descr = return recent git changes, truncated to fit token budget
# usage = <[context.git.recent_changes]>->( { budget => 1500,
#           max_files => 10, since_commit => '' } )

my $params = shift // {};

## extract parameters ##
my $budget       = $params->{'budget'}    // 1500;    ## token budget
my $max_files    = $params->{'max_files'} // 10;      ## max files to list
my $since_commit = $params->{'since_commit'}
    // '';    ## optional: since specific commit

## convert token budget to char budget ( ~4 chars/token ) ##
my $char_budget = int( $budget * 4 );
my $output      = '';

## run from project root ##
my $root = <system.root_path>;

## verify git repo before running commands ##
unless ( -d "$root/.git" ) {
    return "<!-- not a git repository -->";
}

## git diff --stat for uncommitted changes [ native libgit2 ] ##
my $stat_output = '';
eval {
    require Git::Native;
    require Git::Native::Diff;
    my $repo = Git::Native->open($root);
    $stat_output
        = length $since_commit
        ? Git::Native::Diff->tree_to_workdir_stat( $repo, $since_commit )
        : Git::Native::Diff->workdir_stat($repo);
    1;
};
## on error $stat_output stays '' and the log fallback below fires, ##
## matching previous Git::Wrapper failure behavior [ silent eval ]  ##

## if no uncommitted changes, show recent commits instead ##
unless ( length $stat_output ) {
    my $git = Git::Wrapper->new($root);    ## log stays on Git::Wrapper
    eval {
        $stat_output = join "\n", $git->log( '--oneline', "-$max_files" );
    };
    return "<!-- no recent changes -->" unless length $stat_output;
}

## parse and truncate to budget ##
my @lines        = split( /\n/, $stat_output );
my $header       = "## recent changes ##\n";
my $used         = length($header);
my @output_lines = ($header);

## add lines until budget exhausted ##
my $file_count = 0;
foreach my $line (@lines) {
    last if $file_count >= $max_files;

    my $line_len = length($line) + 1;    ## +1 for newline

    ## check if adding this line would exceed budget ##
    if ( $used + $line_len > $char_budget ) {
        push @output_lines, "... (truncated, budget exceeded)";
        last;
    }

    push @output_lines, $line;
    $used += $line_len;
    $file_count++ if $line =~ /\|/;      ## count files (lines with |)
}

$output = join( "\n", @output_lines );

## add summary ##
$output .= "\n\n";
if ( $file_count >= $max_files ) {
    $output .= "<!-- showing $max_files of " . scalar(@lines) . " files -->";
} else {
    $output .= "<!-- $file_count files changed -->";
}

return $output;

