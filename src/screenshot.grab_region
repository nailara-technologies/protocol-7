## [:< ##

# name  = screenshot.grab_region
# descr = grab a screen region; returns Imager object or error string

my @coords = @ARG;
if ( @coords != 4 ) {
    warn 'expected four region coordinates <{C1}>';
    return undef;
}

my $image = screenshot(
    'left'   => $coords[0],
    'top'    => $coords[1],
    'right'  => $coords[2],
    'bottom' => $coords[3]
);
return $image if $image;
return Imager->errstr;

