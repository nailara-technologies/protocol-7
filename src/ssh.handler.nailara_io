## [:< ##

# name  = ssh.handler.nailara_io
# descr = reads and processes output from local protocol-7 socket

my $event = shift->w;

my $read_fh      = $event->fd;
my $con_id       = $event->data->{'con_id'};
my $ssh          = $event->data->{'ssh_obj'};
my $profile_name = $event->data->{'profile_name'};
my $link_name    = $event->data->{'link_name'};
my $connection   = <ssh.connections>->{$con_id};
my $profile_data = <ssh.cfg.profiles>->{$profile_name};
my $channel      = $connection->{'nch'};

my $buffer = '';

my $bytes = <[base.s_read]>->( $read_fh, \$buffer, 4096 );

if ( $bytes <= 0 ) {
    <[base.logs]>->(
        0, ': : [nailara_io] read error or eof (%s bytes)', $bytes
    );
    <[ssh.connection.stop]>->($con_id);
} else {
    my $written = $channel->write($buffer);
    if ( not defined $written or $written != length($buffer) ) {
        <[base.logs]>->(
            0,
            ': : [nailara_io] write failed (%s/%s bytes)',
            $written // 'undef',
            length($buffer)
        );
        <[ssh.connection.stop]>->($con_id);
    }
}

