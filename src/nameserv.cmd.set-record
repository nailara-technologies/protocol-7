## [:< ##

# name  = nameserv.cmd.set-record
# descr = add or update a dns record in a zone

my $args_str = $call->{'args'} // '';

## parse args: zone=<zone> name=<name> type=<type> value=<value>
## or positional: <zone> <type> <name> <value>. the key=value form only when
## the args START with zone= : a txt value [ spf, dkim, dmarc ] always carries
## '=' and spaces -- any '=' anywhere used to pick the key=value form, whose
## \S+ cut the value at its first space [ 2026-11-20 ]
my %args;
if ( $args_str =~ m|^\s*zone=| ) {
    ## key=value format -- value= takes the rest of the line ##
    my $kv = $args_str;
    $args{'value'} = $1 if $kv =~ s|\s*\bvalue=(.*)\z||s;
    while ( $kv =~ m|(\w+)=(\S+)|g ) {
        $args{$1} //= $2;
    }
} else {
    ## positional: zone type name value
    my @parts = split m|\s+|, $args_str;
    $args{'zone'}  = $parts[0]                           if @parts;
    $args{'type'}  = $parts[1]                           if @parts > 1;
    $args{'name'}  = $parts[2]                           if @parts > 2;
    $args{'value'} = join( ' ', @parts[ 3 .. $#parts ] ) if @parts > 3;
}

my $zone_name = lc( $args{'zone'} // '' );
my $rec_input = lc( $args{'name'} // '' );
my $rec_type  = uc( $args{'type'} // 'A' );
my $rec_value = $args{'value'} // '';
$zone_name =~ s{\.+$}{};

if ( not $zone_name or not $rec_input or not $rec_value ) {
    return {
        mode => 'false',
        data => 'usage: set-record zone=<zone> '
            . 'name=<name> type=<type> value=<value>'
    };
}

my $rec_name = <[nameserv.name.normalize]>->( $zone_name, $rec_input );
return {
    mode => 'false',
    data => "record name outside zone $zone_name: $rec_input"
    }
    if not defined $rec_name;

my $zones = <nameserv.zones>;

if ( not exists $zones->{$zone_name} ) {
    ## create new zone
    $zones->{$zone_name} = {
        records => [],
        serial  => time(),
        ttl     => <nameserv.cfg.default_ttl>,
    };
}

my $zone = $zones->{$zone_name};

my $new_rec = {
    name  => $rec_name,
    type  => $rec_type,
    value => $rec_value,
    ts    => <[base.ntime.b32]>,
};
my $new_identity = <[nameserv.entry.identity]>->( $zone_name, $new_rec );

## replace existing records with same name/type ; a replaced value of       ##
## another identity [ a -> other address ] gets a tombstone, or peers would ##
## keep the old value next to the new one                                   ##
my @kept = ();
for my $rec ( @{ $zone->{'records'} } ) {
    if ( lc( $rec->{'name'} ) eq $rec_name
        and $rec->{'type'} eq $rec_type ) {
        <[nameserv.zone.tombstone.add]>->( $zone_name, $rec )
            if <[nameserv.entry.identity]>->( $zone_name, $rec ) ne
            $new_identity;
    } else {
        push @kept, $rec;
    }
}
$zone->{'records'} = \@kept;

## add new record, signed by this host's sync key ##
<[nameserv.sync.sign]>->( $zone_name, $new_rec );
push @{ $zone->{'records'} }, $new_rec;

## a re-add cancels a tombstone of the same identity ##
<[nameserv.zone.tombstone.clear]>->( $zone_name, $zone->{'records'}[-1] );

$zone->{'serial'} = time();

<[nameserv.zone.save]>->($zone_name);

## wake sync waiters holding next-data-timestamp ##
<[nameserv.event.emit]>->( 'data-changed', { 'zone' => $zone_name } );

my $msg
    = sprintf( "record added: %s %s %s", $rec_name, $rec_type, $rec_value );
return { mode => 'true', data => $msg };

