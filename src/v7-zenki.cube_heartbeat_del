# name  = v7-zenki.cube_heartbeat_del
# descr = unregister a managed zenka at cube

my $instance_id = shift;
my $instance    = <v7-zenki.zenka.instance>->{$instance_id} // return FALSE;
return FALSE if not delete $instance->{'cube_heartbeat_registered'};
my $cube_sid = $instance->{'cube_sid'} // return FALSE;

<[protocol-7.command.send.local]>->(
    {   'command' => qw| cube.zenka-heartbeat |,
        'reply'   => {
            'handler' => qw| base.handler.warn_nak_reply |,
            'params'  => "cube.zenka-heartbeat del $cube_sid"
        },
        'call_args' => { 'args' => "del $cube_sid" }
    }
);

return TRUE;

