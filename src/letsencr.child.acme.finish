## [:< ##

# name  = letsencr.child.acme.finish
# param = <order_id> <result>
# descr = order done : cleanup, reply with the bundle, next order

my $order_id = shift;
my $result   = shift;

my $order = delete <letsencr.child.orders>->{ $order_id // '' }
    // return FALSE;

<[letsencr.child.acme.cancel_poll]>->( { 'order_id' => $order_id } );
my $deadline = $order->{'deadline_timer'};
$deadline->cancel if ref $deadline and eval { $deadline->can('cancel') };
<[letsencr.child.acme.cleanup]>->($order);

<[base.logs]>->(
    2,         ': acme : order %s : certificate for %s',
    $order_id, join( ' ', $order->{'domains'}->@* )
);

if ( defined $order->{'reply_id'} ) {
    <[base.callback.cmd_reply]>->(
        $order->{'reply_id'},
        {   'mode' => qw| size |,
            'data' =>
                Crypt::Misc::encode_b32r( JSON::XS::encode_json($result) )
        }
    );
} else {
    <[base.logs]>->( 0, ': acme : order %s had no reply_id', $order_id );
}

return <[letsencr.child.acme.next_queued]>->($order_id);

