## [:< ##

# name  = model_batch.blob.read
# descr = fetch unpacked content of one checksum-addressed batch blob
# param = <checksum> -> <content> | undef

my $checksum = shift // '';

if ( !length $checksum ) {
    warn 'expected checksum parameter <{C1}>';
    return undef;
}
if ( $checksum !~ m|^[A-Z2-7]{20,128}$| ) {
    warn sprintf( "invalid checksum '%s' <{C1}>", $checksum );
    return undef;
}

my $blob_path = join qw| / |, <[model_batch.blob.path]>, "$checksum.mxz.B32";

if ( !-f $blob_path ) {
    warn sprintf( "blob '%s' not in store <{C1}>", $checksum );
    return undef;
}

my $b32 = <[file.read]>->($blob_path);
return undef unless defined $b32;

my $compressed = <[base32.decode]>->($b32);
return undef unless defined $compressed;

<[base.perlmod.autoload]>->('IO::Uncompress::UnXz');

my $content;
IO::Uncompress::UnXz::unxz( \$compressed, \$content )
    or return undef;

## raw bytes, exactly as packed                                             ##
## [ binary-safe : latin-1 sources, model adapters ] -- blob.restore writes ##
## them back raw, diff.text decodes for display itself                      ##
return $content;

