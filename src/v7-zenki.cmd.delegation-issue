## [:< ##

# name  = v7-zenki.cmd.delegation-issue
# descr = re-run the host-root delegation now
# note  = e.g. after keys accept-owner

## v7-zenki.delegation.issue keeps a current leaf and rewrites the .dlg ##
## only when its content changes [ an owner statement added \ dropped ] ##

my $issued = <[v7-zenki.delegation.issue]>;

return {
    'mode' => $issued ? qw| true | : qw| false |,
    'data' => $issued
    ? 'delegation current [ see the log for the chain state ]'
    : 'delegation NOT issued [ see the log ]'
};

