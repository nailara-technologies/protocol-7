## [:< ##

# name  = amos.chksum.cmd.nest
# descr = compute nested AMOS checksum [parent-chksum child-name]
# param = <parent-chksum> <child-name>

my $args = $call->{'args'} // '';

return {
    'mode' => qw| false |,
    'data' => 'expected parent-chksum and child-name'
    }
    if not length $args;

my @parts = split( m| +|, $args, 2 );
return {
    'mode' => qw| false |,
    'data' => 'expected parent-chksum and child-name'
    }
    if @parts < 2;

my ( $parent_chksum, $child_name ) = @parts;

my $child_chksum
    = AMOS7::CHKSUM::Nested::child_chksum( $parent_chksum, $child_name );

return {
    'mode' => qw| false |,
    'data' => 'failed to compute nested checksum'
    }
    if not defined $child_chksum;

return {
    'mode' => qw| true |,
    'data' =>
        AMOS7::CHKSUM::Nested::format_nested( $child_chksum, $parent_chksum )
};

