## [:< ##

# name  = base.code.exists
# descr = check %code subroutine presence by name

## dynamic key access - exempt from the referenced-subroutine scanner, ##
## which only matches literal-quoted $code{'name'} patterns            ##
my $sub_name = shift // '';

return FALSE if not length $sub_name;

return TRUE if defined $code{$sub_name};

return FALSE;

