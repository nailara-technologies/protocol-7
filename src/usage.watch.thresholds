## [:< ##

# name   = usage.watch.thresholds
# descr  = the configured threshold percents, sorted
# return = list of numbers [ default 50 75 90 ]

my $cfg = <usage.cfg.thresholds> // '50 75 90';
my %seen;
return sort { $a <=> $b }
    grep { $ARG > 0 and $ARG <= 100 and not $seen{$ARG}++ }
    map  { $ARG + 0 }
    grep {m|\A\d{1,3}(?:\.\d+)?\z|}
    split m{[\s,]+}, ref $cfg eq qw| ARRAY | ? join( ' ', @{$cfg} ) : $cfg;

