## [:< ##

# name  = nameserv.cache.forward.try
# descr = send one async upstream query try for a cache-miss state

## one connected non-blocking socket + io watcher + timeout timer per try.  ##
## both the transaction id and source port come from base.prng. a trailing  ##
## :port is honoured [ ipv4 a.b.c.d:port or bracketed [v6]:port ] ; without ##
## one port 53 applies. udp truncation retries the same address over tcp.   ##

my $state = shift // return FALSE;

require IO::Socket::IP;
require Socket;

## drop the previous attempt's watcher + timer + socket ##
for my $name (qw| watcher timer |) {
    if ( ref $state->{$name} ) {
        $state->{$name}->cancel
            if $state->{$name}->can('is_active')
            and $state->{$name}->is_active;
        $state->{$name} = undef;
    }
}
close $state->{'sock'} if defined $state->{'sock'};
$state->{'sock'} = undef;

my @upstreams = <[nameserv.cache.upstreams]>;

if ( $state->{'upstream_idx'} >= scalar @upstreams ) {
    ## every upstream failed : servfail to every waiter ##
    return <[nameserv.cache.complete]>->( $state, undef );
}

my $server = $upstreams[ $state->{'upstream_idx'} ];
my $ip     = $server;
my $port   = 53;
if ( $server =~ m{^\[(.+)\]:(\d+)$} ) {
    ( $ip, $port ) = ( $1, $2 );
} elsif ( $server =~ m{^([\d.]+):(\d+)$} ) {
    ( $ip, $port ) = ( $1, $2 );
}

my $query_id   = unpack qw| n |, <[base.prng.bytes]>->(2);
my $query_wire = $state->{'query'}->data(65535);
my $query      = eval { Net::DNS::Packet->new( \$query_wire ) };
return <[nameserv.cache.forward.next]>->($state) if not defined $query;
$query->header->id($query_id);
$query->header->qr(0);
$query->header->aa(0);
$query->header->tc(0);
$query->header->rd(1);
$query_wire = $query->data(65535);

my $protocol   = $state->{'usevc'}          ? qw| tcp | : qw| udp |;
my $local_host = index( $ip, qw| : | ) >= 0 ? qw| :: |  : qw| 0.0.0.0 |;
my $sock;
for my $try ( 1 .. 13 ) {
    my $local_port
        = 49152 + unpack( qw| n |, <[base.prng.bytes]>->(2) ) % 16384;
    $sock = IO::Socket::IP->new(
        'LocalHost' => $local_host,
        'LocalPort' => $local_port,
        'PeerHost'  => $ip,
        'PeerPort'  => $port,
        'Proto'     => $protocol,
        'Blocking'  => 0,
    );
    last if defined $sock;
}
if ( not defined $sock ) {
    return <[nameserv.cache.forward.next]>->($state);
}

@{$state}{qw| sock upstream_ip upstream_port query_id query_wire in out |}
    = ( $sock, $ip, $port, $query_id, $query_wire, '', '' );
$state->{'phase'} = $state->{'usevc'} ? qw| tcp_connect | : qw| udp |;

if ( not $state->{'usevc'} ) {
    my $sent = send $sock, $query_wire, 0;
    if ( not defined $sent or $sent != length $query_wire ) {
        return <[nameserv.cache.forward.next]>->($state);
    }
} else {
    $state->{'out'} = pack( qw| n |, length $query_wire ) . $query_wire;
}

$state->{'watcher'} = <[event.add_io]>->(
    {   'fd'      => $sock,
        'poll'    => $state->{'usevc'} ? qw| rw | : qw| r |,
        'handler' => qw| nameserv.cache.handler.answer |,
        'data'    => $state,
        'desc'    => "cache upstream query [ $state->{'qname'} "
            . "$state->{'qtype'} via $server ]"
    }
);
$state->{'timer'} = <[event.add_timer]>->(
    {   'after'   => <nameserv.cfg.cache.upstream_timeout> // 3,
        'handler' => qw| nameserv.cache.handler.timeout |,
        'data'    => $state,
        'desc'    => "cache upstream timeout [ "
            . "$state->{'qname'} $state->{'qtype'} ]"
    }
);

<nameserv.stats>->{'cache_forwarded'}++;

return TRUE;

