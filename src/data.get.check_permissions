# name = data.get.check_permissions
# descr = Check if caller has required permissions

my ( $have, $need ) = @ARG;

for my $required (@$need) {
    return 1 if $required eq 'all';
    return 1 if grep { $_ eq $required } @$have;

    if ( $required =~ m{^owner:(.+)$} ) {
        return 1 if grep { $_ eq "owner:$1" || $_ eq $1 } @$have;
    }
}

return 0;

