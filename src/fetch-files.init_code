## [:< ##

# name  = fetch-files.init_code
# descr = start the chmod child [ admin user ] while still root : model
#         publisher directories belong to the admin user, downloads run
#         as the zenka user [ huggingface.download mkdir + grant ]

my ($reinit) = @ARG;
return if $reinit;

<[base.chmod_child.start]>
    ->( { 'grant_user' => <system.amos-zenka-user> // qw| protocol-7 | } );

0;

