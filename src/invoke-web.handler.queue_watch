## [:< ##

# name  = invoke-web.handler.queue_watch
# descr = interactive queue mode check : pending items added since the
#         last check jump ahead of everything already queued
# note  = all items found in one check share one priority [ max + 1 ] :
#         a batch keeps its own order [ item_id ASC tie-break ], the next
#         batch lands ahead of it -- newest work first

<[invoke-web.gpu_lease.queue_changed]>;

if ( not <invoke-web.queue_interactive> ) {    ## switched off meanwhile ##
    my $timer = delete <invoke-web.timer.queue_watch>;
    $timer->cancel if defined $timer and $timer->is_active;
    return;
}

my $dbh = <[invoke-web.queue.db]> // return;

my $last_seen = <invoke-web.queue.last_seen> // 0;
my $new_items = $dbh->selectcol_arrayref(
    "SELECT item_id FROM session_queue WHERE status = 'pending' "
        . 'AND item_id > ? ORDER BY item_id ASC',
    undef, $last_seen
) // [];
return if not @$new_items;

my ($max_priority)
    = $dbh->selectrow_array(
    "SELECT MAX(priority) FROM session_queue WHERE status = 'pending'");
my $priority = ( $max_priority // 0 ) + 1;

$dbh->begin_work;
my $sth = $dbh->prepare(
    'UPDATE session_queue SET priority = ? WHERE item_id = ?');
## invoke.ai writes the same db : a held write lock is an expected retry ##
## [ last_seen stays, the next tick tries the same items again ] -- loud ##
## only when it keeps failing, any other error at once                   ##
my $busy_limit = 5;
my $failed_err;

foreach my $item_id (@$new_items) {
    next if $sth->execute( $priority, $item_id );
    $failed_err = $dbh->errstr // 'unknown error';
    last;
}
$failed_err = $dbh->errstr // 'commit failed'
    if not defined $failed_err and not $dbh->commit;

if ( defined $failed_err ) {
    $dbh->rollback;
    if ( $failed_err =~ m|database is locked|i ) {
        my $busy_count = ++<invoke-web.queue.busy_count>;
        <[base.logs]>->(
            $busy_count >= $busy_limit ? 0 : 2,
            'queue watch : db locked by invoke.ai, retry next tick [ %d ]',
            $busy_count
        );
    } else {
        <[base.logs]>->(
            0, 'queue watch : update failed [ %s ]', $failed_err
        );
    }
    return;
}
<invoke-web.queue.busy_count> = 0;

<invoke-web.queue.last_seen> = $new_items->[-1];
<[base.logs]>->(
    1,
    'queue : %d new item%s moved to the front [ priority %d ]',
    scalar @$new_items,
    @$new_items == 1 ? '' : 's', $priority
);

