## [:< ##

# name  = task.handler.gpu_temp_update
# descr = handle gpu temperature subscription replies

my $reply = shift;

## handle FALSE reply [ X-11 unavailable or stats not ready ] : mark the  ##
## gpu feed unavailable so the sweep falls back to notify-timing debounce ##
if ( $reply->{'cmd'} eq qw| FALSE | ) {
    <task.cold_queue.gpu_available> = FALSE;
    <[base.logs]>->(
        2,
        'gpu temp subscription failed [ cold-queue gpu gate disabled ]: %s',
        $reply->{'call_args'}->{'args'} // 'unknown error'
    );
    return;
}

<task.stats.gpu.temp> //= {};
return
    unless <[thermal.feed.register]>->(
    $reply,
    <task.stats.gpu.temp>,
    sub {
        my ( $temp_1s, $avg_5s ) = @ARG;
        <task.thermal.gate> //= {};
        my $idle = <task.thermal.idle> //= {};
        my $now  = <[base.time]>->(2);

        if ( not defined $idle->{'loadavg_at'}
            or $now - $idle->{'loadavg_at'} >= 10 ) {
            $idle->{'load_per_core'} = <[thermal.idle.loadavg]>;
            $idle->{'loadavg_at'}    = $now;
        }

        my $power = <task.stats.gpu.power> //= {};
        my $watts
            = (     defined $power->{'watts'}
                and defined $power->{'updated_at'}
                and $now - $power->{'updated_at'} <= 30 )
            ? $power->{'watts'}
            : undef;
        my $busy = TRUE;
        if ( defined $watts ) {
            $busy = $watts > ( <thermal.cfg.idle.power_max> // 60 );
        }

        $idle->{'state'} = <[thermal.idle.sample]>->(
            $idle,
            {   'load_per_core' => $idle->{'load_per_core'},
                'busy'          => $busy,
            },
            $now
        );
        $idle->{'power_watts'} = $power->{'watts'};
        my $idle_held = <[thermal.idle.held]>->(
            $idle, $now, <thermal.cfg.idle.hold> // 600
        );

        ## the idle power is learned while idle holds only -- power_watts ##
        ## is the current reading, as idle power the gate saw dP = 0      ##
        if ( $idle_held and defined $watts ) {
            $idle->{'idle_watts'} //= $watts;
            $idle->{'idle_watts'}
                += 0.01 * ( $watts - $idle->{'idle_watts'} );
        }
        <[thermal.gate.sample]>->(
            <task.thermal.gate>, $temp_1s, $now, $idle_held, $watts,
            $idle->{'idle_watts'}
        );
        <[thermal.gate.decide]>->( <task.thermal.gate>, $now );
    }
    );

## gpu feed live : cold-queue gpu gate authoritative from here on ##
<task.cold_queue.gpu_available> = TRUE;

<[base.logs]>->(
    2, 'gpu temp STRM consumer registered [cmd_id=%d]',
    $reply->{'cmd_id'}
);

