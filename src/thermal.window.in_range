## [:< ##

# name  = thermal.window.in_range
# descr = check an epoch against an HH:MM schedule range

my ( $range, $epoch ) = @ARG;

return FALSE
    if not defined $range
    or $range !~ m|^\s*([0-9]{2}):([0-9]{2})\s*-\s*([0-9]{2}):([0-9]{2})\s*$|;

my ( $start_hour, $start_min, $end_hour, $end_min ) = ( $1, $2, $3, $4 );
return FALSE
    if $start_hour > 23
    or $end_hour > 23
    or $start_min > 59
    or $end_min > 59;

my ( $minute, $hour ) = ( localtime($epoch) )[ 1, 2 ];
my $time  = $hour * 60 + $minute;
my $start = $start_hour * 60 + $start_min;
my $end   = $end_hour * 60 + $end_min;

return TRUE
    if $start <= $end
    ? ( $time >= $start and $time < $end )
    : ( $time >= $start or $time < $end );
return FALSE;

