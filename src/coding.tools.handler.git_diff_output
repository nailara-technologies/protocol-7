## [:< ##

# name  = coding.tools.handler.git_diff_output
# descr = git diff output [ staged or unstaged ] via Git::Native FFI

my $git_args   = shift // '';            ## kept for signature compat; unused
my $stage_type = shift // 'unstaged';    ## 'staged' or 'unstaged' ##

my $root = <system.root_path>;

## verify git repo ##
unless ( -d "$root/.git" ) {
    return {
        'mode' => qw| false |,
        'data' => 'not a git repository'
    };
}

my $diff_text = '';
my $error     = '';
eval {
    require Git::Native;
    require Git::Native::Diff;
    my $repo = Git::Native->open($root);
    $diff_text
        = $stage_type eq 'staged'
        ? Git::Native::Diff->staged_patch($repo)
        : Git::Native::Diff->workdir_patch($repo);
    1;
};
if ($EVAL_ERROR) {
    $error = "$EVAL_ERROR";
    $error =~ s|\s+at\s+\S+\s+line\s+\d+.*||s;
    return {
        'mode' => qw| false |,
        'data' => "git diff $stage_type failed: $error"
    };
}

return {
    'mode' => qw| true |,
    'data' => $diff_text
};

