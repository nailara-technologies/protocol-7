## [:< ##

# name  = coding.tools.handler.git_diff_output
# descr = git diff output [ staged or unstaged ]
#
## routed through the git binary [ Git::Wrapper ] rather than
## Git::Native::Diff : the native diff entry points corrupt process-global FFI
## state after the FIRST call in any long-running process [ second call dies
## 'invalid version <garbage> on git_diff_options' -- reproducible in a
## one-shot perl, owner-independent ] and the root cause is untraced. the
## binary path honors the safe.directory env vars coding.init_code sets, so
## the service-user [ protocol-7 ] ownership case is covered. Git::Wrapper
## passes diff args through RAW [ no Smart parser on diff ].

my $first = shift // {};

## two calling shapes : the sibling handlers pass  ( $git_args,
## 'staged'|'unstaged' ) positionally, while a direct call-tool invocation
## delivers one args hashref instead
my ( $git_args, $stage_type );
if ( ref $first eq qw| HASH | ) {
    $git_args   = $first->{'git_args'} // '';
    $stage_type = ( $first->{'staged'} // 0 ) ? qw| staged | : qw| unstaged |;
} else {
    $git_args   = $first;
    $stage_type = shift // qw| unstaged |;
}

my $root = <system.root_path>;

## verify git repo ##
unless ( -d "$root/.git" ) {
    return {
        'mode' => qw| false |,
        'data' => 'not a git repository'
    };
}

my @diff_args = $stage_type eq 'staged' ? ('--cached') : ();
my $diff_text = '';
my $error     = '';
eval {
    my $git = Git::Wrapper->new($root);
    $diff_text = join "\n", $git->diff(@diff_args);
    1;
};
if ($EVAL_ERROR) {
    $error = "$EVAL_ERROR";
    $error =~ s|\s+at\s+\S+\s+line\s+\d+.*||s;
    return {
        'mode' => qw| false |,
        'data' => "git diff $stage_type failed: $error"
    };
}

return {
    'mode' => qw| true |,
    'data' => $diff_text
};

