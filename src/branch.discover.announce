## [:< ##

# name  = branch.discover.announce
# descr = announce node state change to discover zenka
# param = { id, event }  [ event = available | changed | removed ]
#
# fire-and-forget after branch.attach / branch.detach

use YAML::XS qw| Dump |;

my $params  = shift              // {};
my $node_id = $params->{'id'}    // '';
my $event   = $params->{'event'} // '';

return { 'mode' => 'false', 'data' => 'node id required' }
    unless length $node_id;
return { 'mode' => 'false', 'data' => 'event required' }
    unless length $event;
return { 'mode' => 'false', 'data' => 'invalid event' }
    unless $event =~ m{^(available|changed|removed)$};

my $path_result = <[branch.node.path]>->($node_id);
my $address     = $path_result->{'data'} // '';

my $args = {
    'node_id' => $node_id,
    'address' => $address,
    'event'   => $event,
    'ntime'   => <[base.ntime]>,
};

my $args_yaml = eval { Dump($args) } // '';

<[protocol-7.route-send]>->(
    {   'command'   => 'discover.branch.announce',
        'call_args' => { 'args' => $args_yaml }
    }
);

<[base.logs]>->( 2, 'branch.discover.announce: %s [%s]', $node_id, $event );

return { 'mode' => 'true', 'data' => $event };

