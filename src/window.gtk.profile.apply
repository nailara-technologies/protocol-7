## [:< ##

# name  = window.gtk.profile.apply
# descr = apply calculated geometry to a GTK window object

my ( $window, $geometry ) = @ARG;

return undef if not defined $window;
return undef if not defined $geometry;

## set size before position: under Wayland the initial-placement configure  ##
## request GTK sends on realize/map is computed from the default size, so a ##
## move() issued before the size is known can be off by the difference      ##
## between the default (pre-size) and final window size.  resize() on an    ##
## unrealized window can hang under Wayland; use set_default_size           ##
if ( $window->get_realized ) {
    $window->resize( $geometry->{'width'}, $geometry->{'height'} );
} else {
    $window->set_default_size( $geometry->{'width'}, $geometry->{'height'} );
}

$window->move( $geometry->{'x'}, $geometry->{'y'} );

<[base.logs]>->(
    2,
    'applied window geometry: x=%d y=%d w=%d h=%d [profile=%s]',
    $geometry->{'x'},
    $geometry->{'y'},
    $geometry->{'width'},
    $geometry->{'height'},
    $geometry->{'profile'} // 'unknown'
);

return 1;

