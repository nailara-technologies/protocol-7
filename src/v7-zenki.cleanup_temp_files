## [:< ##

# name  = v7-zenki.cleanup_temp_files

##  clean temp path from last zenka session  ##
##
<[v7-zenki.tmp-paths.global.clean-up]> if -d <v7-zenki.dirpath.tmp_paths>;
##

##  registered pid files from last session [ v7-zenki startup ]  ##
##
<v7-zenki.dirpath.pid_files> //= qw| /var/run/.7/v7-zenki/pid_files |;
<[v7-zenki.pid-files.global.clean-up]> if -d <v7-zenki.dirpath.pid_files>;
##

## web-browser crash mitigation files ##
##
my $count = my @web_browser_files
    = <[file.match_files]>->(qw|  /var/tmp/  web-browser.**  |);
if ($count) {
    <[base.logs]>->(
        'removing %d left over web-browser zenka temp file%s..,',
        $count, <[base.cnt_s]>->($count)
    );
    unlink(@web_browser_files) or warn <[base.str.os_err]>;
}
