## [:< ##

# name  = nameserv.orbital.auto_publish
# descr = auto-publish orbital dns records on timer

my $domain = <nameserv.cfg.auto_publish_domain>;

if ( not defined $domain or not length $domain ) {
    <[base.logs]>->( 3, 'auto_publish skipped: no domain configured' );
    return;
}

my $ttl = 777;

<[nameserv.cmd.publish-node]>
    ->( { 'args' => sprintf( '%s 7777 %d', $domain, $ttl ) } );

return TRUE;

