## [:< ##

# name   = coding.sign_queue.file_sums
# descr  = BMW checksums of repo files [ path => sum ]
# args   = repo root, array ref of repo-relative paths
# return = hash ref [ a missing file : 'missing' ]

my ( $root, $paths ) = @ARG;
my %sums;
foreach my $path ( @{$paths} ) {
    my $file = "$root/$path";
    $sums{$path}
        = -f $file
        ? <[chk-sum.bmw.filesum]>->( 256, $file ) // qw| unreadable |
        : qw| missing |;
}
return \%sums;

