## [:< ##

# name  = v7-zenki.delegation.retry
# descr = retry the first S delegation every minute, at most 60 times

my $retries = ++<v7-zenki.delegation.retries>;

my $issued = <[v7-zenki.delegation.issue]>;

return if not $issued and $retries < 60;

<[base.log]>->( 0, ': delegation : retries exhausted, daily timer only' )
    if not $issued;

my $timer = delete <v7-zenki.delegation>->{'retry_timer'};
$timer->cancel if ref $timer and eval { $timer->can('cancel') };

return;

