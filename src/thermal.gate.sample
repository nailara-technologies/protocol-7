## [:< ##

# name  = thermal.gate.sample
# descr = sample the thermal gate and learn its power coefficient

my ( $gate, $temp_1s, $now, $idle_held, $watts, $idle_watts ) = @ARG;

return FALSE if ref $gate ne qw| HASH |;

my $short_window = <thermal.cfg.avg.short>       // 300;
my $long_window  = <thermal.cfg.avg.long>        // 900;
my $base_window  = <thermal.cfg.baseline.window> // 1800;

my $dt = 0;
if ( not defined $gate->{'last_sample_at'} ) {
    $gate->{'avg_short'} = $temp_1s;
    $gate->{'avg_long'}  = $temp_1s;
    $gate->{'baseline'}  = $temp_1s;
} else {
    $dt = $now - $gate->{'last_sample_at'};
    $dt = 0 if $dt < 0;

    my $short_alpha = 1 - exp( -$dt / $short_window );
    my $long_alpha  = 1 - exp( -$dt / $long_window );

    $gate->{'avg_short'}
        += $short_alpha * ( $temp_1s - $gate->{'avg_short'} );
    $gate->{'avg_long'}
        += $long_alpha * ( $temp_1s - $gate->{'avg_long'} );

    ## real idle learns in both directions without a band ; otherwise only ##
    ## near itself while cold, so load just under the mark can not creep   ##
    my $band = <thermal.cfg.baseline.band> // 1.5;
    if ( $idle_held
        or ( $gate->{'state'} // '' ) eq qw| cold |
        and $temp_1s <= $gate->{'baseline'} + $band ) {
        my $base_alpha = 1 - exp( -$dt / $base_window );
        $gate->{'baseline'}
            += $base_alpha * ( $temp_1s - $gate->{'baseline'} );
    }
}

my $base_max = <thermal.cfg.baseline.max> // 55.0;
$gate->{'baseline'} = $base_max if $gate->{'baseline'} > $base_max;

$gate->{'idle_watts'} = $idle_watts if defined $idle_watts;

if ( defined $watts ) {
    if ( not defined $gate->{'power_avg'} ) {
        $gate->{'power_avg'} = $watts;
    } else {
        my $power_alpha = 1 - exp( -$dt / $short_window );
        $gate->{'power_avg'}
            += $power_alpha * ( $watts - $gate->{'power_avg'} );
    }

    my $delta_w
        = defined $idle_watts ? $gate->{'power_avg'} - $idle_watts : undef;
    if (    defined $delta_w
        and $delta_w >= ( <thermal.cfg.k.min_delta_w> // 40 )
        and abs( $watts - $gate->{'power_avg'} )
        <= ( <thermal.cfg.k.power_band> // 15 )
        and abs( $gate->{'avg_short'} - $gate->{'avg_long'} )
        <= ( <thermal.cfg.k.temp_band> // 1.0 ) ) {
        $gate->{'k_since'} //= $now;
        if ( $now - $gate->{'k_since'} >= ( <thermal.cfg.k.settle> // 600 ) )
        {
            my $k_obs
                = ( $gate->{'avg_long'} - $gate->{'baseline'} ) / $delta_w;
            my $trusted = <[thermal.gate.k_trusted]>->($gate);
            if (    $trusted
                and $k_obs
                > $gate->{'k'} * ( <thermal.cfg.k.fault_ratio> // 1.5 ) ) {
                if ( not exists $gate->{'fault'} ) {
                    $gate->{'fault'} = {
                        'since' => $now,
                        'k_obs' => $k_obs,
                        'k'     => $gate->{'k'},
                    };
                    my $message
                        = sprintf( 'possible stopped fan or blocked airflow '
                            . '[ k_obs %.3f C/W vs k %.3f C/W ]',
                        $k_obs, $gate->{'k'} );
                    <[base.logs]>->(
                        0, 'thermal cooling fault : %s', $message
                    );
                    <[protocol-7.route-send]>->(
                        {   'command'   => qw| notify.warn |,
                            'call_args' => {
                                'args' =>
                                    sprintf( "'thermal cooling fault' '%s'",
                                    $message )
                            },
                        }
                    );
                }
            } else {
                if ( $trusted and exists $gate->{'fault'} ) {
                    <[base.logs]>->(
                        0,
                        'thermal cooling fault cleared '
                            . '[ k_obs %.3f C/W vs k %.3f C/W ]',
                        $k_obs,
                        $gate->{'k'}
                    );
                    delete $gate->{'fault'};
                }
                if (    $k_obs >= ( <thermal.cfg.k.min> // 0.02 )
                    and $k_obs <= ( <thermal.cfg.k.max> // 0.5 ) ) {
                    if ( defined $gate->{'k'} ) {
                        my $k_alpha
                            = 1 - exp(
                            -$dt / ( <thermal.cfg.k.window> // 3600 ) );
                        $gate->{'k'} += $k_alpha * ( $k_obs - $gate->{'k'} );
                    } else {
                        $gate->{'k'} = $k_obs;
                    }
                    $gate->{'k_samples'}++;
                    $gate->{'k_at'} = $now;
                }
            }
        }
    } else {
        delete $gate->{'k_since'};
    }
}

## a fault holds the gate hot, so the load stops and no settled k_obs can ##
## clear it : after the hold, real idle back near the baseline lets it    ##
## retry -- a cooling still broken sets it again on the next load         ##
if (    exists $gate->{'fault'}
    and $idle_held
    and $now - $gate->{'fault'}->{'since'}
    >= ( <thermal.cfg.k.fault_hold> // 1800 )
    and $gate->{'avg_long'}
    <= $gate->{'baseline'} + ( <thermal.cfg.baseline.band> // 1.5 ) ) {
    <[base.logs]>->(
        0, 'thermal cooling fault cleared for a retry [ idle %.1f C ]',
        $gate->{'avg_long'}
    );
    delete $gate->{'fault'};
}

my $predicted = <[thermal.gate.predict]>->($gate);
if ( defined $predicted ) {
    $gate->{'predicted'} = $predicted;
} else {
    delete $gate->{'predicted'};
}

$gate->{'last_sample_at'} = $now;

return TRUE;

