## [:< ##

# name  = thermal.gate.sample
# descr = sample the thermal gate and fit its power coefficient

my ( $gate, $temp_1s, $now, $idle_held, $watts, $idle_watts ) = @ARG;

return FALSE if ref $gate ne qw| HASH |;

my $short_window = <thermal.cfg.avg.short>       // 300;
my $long_window  = <thermal.cfg.avg.long>        // 900;
my $base_window  = <thermal.cfg.baseline.window> // 1800;

my $dt = 0;
if ( not defined $gate->{'last_sample_at'} ) {
    $gate->{'avg_short'} = $temp_1s;
    $gate->{'avg_long'}  = $temp_1s;
    $gate->{'baseline'}  = $temp_1s;
} else {
    $dt = $now - $gate->{'last_sample_at'};
    $dt = 0 if $dt < 0;

    my $short_alpha = 1 - exp( -$dt / $short_window );
    my $long_alpha  = 1 - exp( -$dt / $long_window );

    $gate->{'avg_short'}
        += $short_alpha * ( $temp_1s - $gate->{'avg_short'} );
    $gate->{'avg_long'}
        += $long_alpha * ( $temp_1s - $gate->{'avg_long'} );

    ## real idle learns in both directions without a band ; otherwise only ##
    ## near itself while cold, so load just under the mark can not creep   ##
    my $band = <thermal.cfg.baseline.band> // 1.5;
    if ( $idle_held
        or ( $gate->{'state'} // '' ) eq qw| cold |
        and $temp_1s <= $gate->{'baseline'} + $band ) {
        my $base_alpha = 1 - exp( -$dt / $base_window );
        $gate->{'baseline'}
            += $base_alpha * ( $temp_1s - $gate->{'baseline'} );
    }
}

my $base_max = <thermal.cfg.baseline.max> // 55.0;
$gate->{'baseline'} = $base_max if $gate->{'baseline'} > $base_max;

$gate->{'idle_watts'} = $idle_watts if defined $idle_watts;

if ( defined $watts ) {
    if ( not defined $gate->{'power_avg'} ) {
        $gate->{'power_avg'} = $watts;
    } else {
        my $power_alpha = 1 - exp( -$dt / $short_window );
        $gate->{'power_avg'}
            += $power_alpha * ( $watts - $gate->{'power_avg'} );
    }

    ## bounded ring of recent samples for the transient fit : the gate      ##
    ## pauses the load itself, so a settled period never happens -- fit the ##
    ## first-order model [ tau*dT/dt + T-baseline = k*[P-P_idle] ]          ##
    my $ring = $gate->{'k_ring'} //= [];
    push( @{$ring}, [ $now, $temp_1s, $watts ] );
    shift @{$ring}
        while @{$ring}
        and $ring->[0][0] < $now - ( <thermal.cfg.k.fit.window> // 1800 );
    shift @{$ring}
        while @{$ring} > ( <thermal.cfg.k.fit.max_samples> // 1800 );

    my $fit_every = <thermal.cfg.k.fit.every> // 120;
    if (
        $now - ( $gate->{'k_fit_check'} // $now - $fit_every ) >= $fit_every )
    {
        $gate->{'k_fit_check'} = $now;

        ## least squares : dT/dt = a*dP + b*[T-baseline], tau=-1/b, k=-a/b ##
        my $k_obs;
    FIT: {
            last FIT if not defined $gate->{'idle_watts'};
            last FIT if not defined $gate->{'baseline'};
            my $idle_w     = $gate->{'idle_watts'};
            my $min_points = <thermal.cfg.k.fit.min_points> // 20;
            last FIT if @{$ring} < $min_points + 1;
            my $deriv_span = <thermal.cfg.k.fit.deriv_span> // 20;

            ## no power variation in the window -> no signal to fit ##
            my ( $dp_min, $dp_max );
            for my $point ( @{$ring} ) {
                my $dp = $point->[2] - $idle_w;
                $dp_min = $dp if not defined $dp_min or $dp < $dp_min;
                $dp_max = $dp if not defined $dp_max or $dp > $dp_max;
            }
            last FIT
                if $dp_max - $dp_min < ( <thermal.cfg.k.min_delta_w> // 40 );

            my ( $s11, $s12, $s22, $t1, $t2, $yy, $count )
                = ( 0, 0, 0, 0, 0, 0, 0 );
            for my $i ( 1 .. $#{$ring} ) {
                my $j = $i - 1;
                $j--
                    while $j > 0
                    and $ring->[$i][0] - $ring->[$j][0] < $deriv_span;
                my $span = $ring->[$i][0] - $ring->[$j][0];
                next if $span < $deriv_span;    ## smoothed derivative ##
                my $y  = ( $ring->[$i][1] - $ring->[$j][1] ) / $span;
                my $x1 = $ring->[$i][2] - $idle_w;
                my $x2 = $ring->[$i][1] - $gate->{'baseline'};
                $s11 += $x1 * $x1;
                $s12 += $x1 * $x2;
                $s22 += $x2 * $x2;
                $t1  += $x1 * $y;
                $t2  += $x2 * $y;
                $yy  += $y * $y;
                $count++;
            }
            last FIT if $count < $min_points or $yy == 0 or $s11 == 0;
            my $det = $s11 * $s22 - $s12 * $s12;
            last FIT if $det <= 1e-6 * $s11 * $s22;    ## nearly collinear ##
            my $a = ( $t1 * $s22 - $t2 * $s12 ) / $det;
            my $b = ( $s11 * $t2 - $s12 * $t1 ) / $det;
            last FIT if $b >= 0;
            my $tau = -1 / $b;
            last FIT
                if $tau < ( <thermal.cfg.k.fit.tau_min> // 30 )
                or $tau > ( <thermal.cfg.k.fit.tau_max> // 3000 );
            my $ss_res
                = $yy
                - 2 * $a * $t1
                - 2 * $b * $t2
                + $a * $a * $s11
                + 2 * $a * $b * $s12
                + $b * $b * $s22;
            $ss_res = 0 if $ss_res < 0;
            my $r2 = 1 - $ss_res / $yy;
            $gate->{'k_fit_tau'} = $tau;
            $gate->{'k_fit_r2'}  = $r2;
            $gate->{'k_fit_at'}  = $now;
            last FIT if $r2 < ( <thermal.cfg.k.fit.min_r2> // 0.8 );
            $k_obs = -$a / $b;
        }

        if ( defined $k_obs ) {
            my $trusted = <[thermal.gate.k_trusted]>->($gate);
            if (    $trusted
                and $k_obs
                > $gate->{'k'} * ( <thermal.cfg.k.fault_ratio> // 1.5 ) ) {
                if ( not exists $gate->{'fault'} ) {
                    $gate->{'fault'} = {
                        'since' => $now,
                        'k_obs' => $k_obs,
                        'k'     => $gate->{'k'},
                    };
                    my $message
                        = sprintf( 'possible stopped fan or blocked airflow '
                            . '[ k_obs %.3f C/W vs k %.3f C/W ]',
                        $k_obs, $gate->{'k'} );
                    <[base.logs]>->(
                        0, 'thermal cooling fault : %s', $message
                    );
                    <[protocol-7.route-send]>->(
                        {   'command'   => qw| notify.warn |,
                            'call_args' => {
                                'args' =>
                                    sprintf( "'thermal cooling fault' '%s'",
                                    $message )
                            },
                        }
                    );
                }
            } else {
                if ( $trusted and exists $gate->{'fault'} ) {
                    <[base.logs]>->(
                        0,
                        'thermal cooling fault cleared '
                            . '[ k_obs %.3f C/W vs k %.3f C/W ]',
                        $k_obs,
                        $gate->{'k'}
                    );
                    delete $gate->{'fault'};
                }
                ## out of range : still a fault signal above, never learned ##
                my $in_range
                    = ( <thermal.cfg.k.min> // 0.02 ) <= $k_obs
                    <= ( <thermal.cfg.k.max> // 0.5 );
                if ( $in_range and defined $gate->{'k'} ) {
                    my $k_alpha
                        = 1 - exp(
                        -$fit_every / ( <thermal.cfg.k.window> // 3600 ) );
                    $gate->{'k'} += $k_alpha * ( $k_obs - $gate->{'k'} );
                } elsif ($in_range) {
                    $gate->{'k'} = $k_obs;
                }
                if ($in_range) {
                    $gate->{'k_samples'}++;
                    $gate->{'k_at'} = $now;
                }
            }
        }
    }
}

## a fault holds the gate hot, so the load stops and no settled k_obs can ##
## clear it : after the hold, real idle back near the baseline lets it    ##
## retry -- a cooling still broken sets it again on the next load         ##
if (    exists $gate->{'fault'}
    and $idle_held
    and $now - $gate->{'fault'}->{'since'}
    >= ( <thermal.cfg.k.fault_hold> // 1800 )
    and $gate->{'avg_long'}
    <= $gate->{'baseline'} + ( <thermal.cfg.baseline.band> // 1.5 ) ) {
    <[base.logs]>->(
        0, 'thermal cooling fault cleared for a retry [ idle %.1f C ]',
        $gate->{'avg_long'}
    );
    delete $gate->{'fault'};
}

my $predicted = <[thermal.gate.predict]>->($gate);
if ( defined $predicted ) {
    $gate->{'predicted'} = $predicted;
} else {
    delete $gate->{'predicted'};
}

$gate->{'last_sample_at'} = $now;

return TRUE;

