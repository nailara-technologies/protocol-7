## [:< ##

# name  = httpsd.handler.drain_check
# descr = check if all sessions closed, self-terminate when done

my $remaining = 0;
if ( exists <base.session.ids> ) {
    $remaining = scalar keys <base.session.ids>->%*;
}

if ( $remaining == 0 ) {
    <[base.log]>->('httpsd drain: all sessions closed, self-terminating');

    ## cancel drain check timer
    if ( exists <httpsd.drain_check_timer> ) {
        <httpsd.drain_check_timer>->cancel
            if <httpsd.drain_check_timer>->is_active;
        delete <httpsd.drain_check_timer>;
    }

    ## self-terminate
    <[httpsd.cmd.self_terminate]>;

} else {
    <[base.logs]>
        ->( 2, 'httpsd drain: %d sessions still active', $remaining );
    ## timer continues, will check again
}

return TRUE;

