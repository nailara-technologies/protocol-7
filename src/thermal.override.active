## [:< ##

# name  = thermal.override.active
# descr = return a forced verdict within its schedule window

my ( $store, $now ) = @ARG;

return undef if ref $store ne qw| HASH |;
return undef if not defined $store->{'verdict'};

my $window = <[thermal.window.current]>->($now);
return $store->{'verdict'}
    if defined $store->{'window'} and $store->{'window'} eq $window;

delete @{$store}{qw| verdict window set_at |};
return undef;

