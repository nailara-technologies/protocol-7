# name  = coding.handler.inference_server_sigchld
# descr = SIGCHLD handler for inference server crash detection
#
# note  = Event->signal passes no args to the callback.
#         We reap all children via waitpid(-1, WNOHANG) loop,
#         same pattern as base.sig_chld.

my $servers = <coding.inference_servers> // {};
my $reaped  = 0;

local ( $OS_ERROR, $CHILD_ERROR );
while ( ( my $pid = <[base.waitpid]>->(-1) ) > 0 ) {
    $reaped++;
    my $exit_status = $CHILD_ERROR;

    ## check if this was an inference server process ##
    my $matched = 0;
    for my $backend (qw| gpu cpu |) {
        my $server_info = $servers->{$backend} // {};
        next unless defined $server_info->{'pid'};

        if ( $server_info->{'pid'} == $pid ) {
            $matched = 1;
            ## exit=0 is a clean exit [ e.g. a deliberate SIGTERM/SIGKILL   ##
            ## from coding.lora_train_spawn freeing the gpu for training ], ##
            ## not a crash -- "crashed" on that line reads as alarming and  ##
            ## contradicts the very next log line when the training guard   ##
            ## below fires. wording only; $server_info->{'status'} stays    ##
            ## 'crashed' below, other code paths key off that literal       ##
            <[base.logs]>->(
                0,
                '[inference_server_sigchld] %s server %s [pid=%d exit=%d]',
                $backend,
                ( $exit_status == 0 ? qw| terminated | : qw| crashed | ),
                $pid,
                $exit_status
            );

            ## mark server as crashed ##
            $server_info->{'status'}      = qw| crashed |;
            $server_info->{'crashed_at'}  = <[base.ntime]>;
            $server_info->{'exit_status'} = $exit_status;

            ## skip crash recovery if zenka is draining [ new twin instance ##
            ## owns GPU ]                                                   ##
            if (<coding.draining>) {
                <[base.logs]>->(
                    1,
                    '[inference_server_sigchld] '
                        . 'draining — skipping %s crash restart',
                    $backend
                );
                next;
            }

            ## same reasoning as the draining guard above -- a deliberate   ##
            ## kill to free the gpu for a lora training run looks IDENTICAL ##
            ## to a real crash from here (same SIGCHLD, exit=0), and would  ##
            ## otherwise get "healed" by a fresh respawn fighting the       ##
            ## training process for the same VRAM. caught live 2026-09-12   ##
            ## killing the server via eval-code for exactly this purpose    ##
            if (<coding.lora_training_in_progress>) {
                <[base.logs]>->(
                    1,
                    '[inference_server_sigchld] lora training '
                        . 'in progress — skipping %s crash restart',
                    $backend
                );
                next;
            }

            ## schedule restart with backoff ##
            my $restart_count = $server_info->{'restart_count'} // 0;
            $restart_count++;
            $server_info->{'restart_count'} = $restart_count;

            ## exponential backoff: 5s, 10s, 20s, 30s, max 60s ##
            my $backoff
                = $restart_count <= 1 ? 5
                : $restart_count == 2 ? 10
                : $restart_count == 3 ? 20
                : $restart_count == 4 ? 30
                :                       60;

            ## max 5 restart attempts ##
            if ( $restart_count > 5 ) {
                <[base.logs]>->(
                    0,
                    '[inference_server_sigchld] max '
                        . 'restarts exceeded for %s server',
                    $backend
                );
                $server_info->{'status'} = qw| failed |;
                next;
            }

            <[base.logs]>->(
                1,
                '[inference_server_sigchld] scheduling '
                    . '%s restart in %ds (attempt %d/5)',
                $backend,
                $backoff,
                $restart_count
            );

            ## pause dispatch NOW, at crash detection -- not $backoff       ##
            ## seconds from now when the backoff-delayed                    ##
            ## inference_crash_restart handler finally begins. that used to ##
            ## be the only place this got set, leaving coding.async.        ##
            ## send_request's queue_paused gate blind for the whole backoff ##
            ## window : confirmed live 2026-09-14, a retry fired ~100ms     ##
            ## after this exact crash log line, saw queue_paused still      ##
            ## false, and dispatched straight into the not-yet-restarted    ##
            ## server [ "connection refused" ], burning its one retry and   ##
            ## hard-failing the task outright instead of waiting for the    ##
            ## restart already scheduled right here. same pattern           ##
            ## coding.handler.monitor_inference_startup already uses for    ##
            ## the self-test-in-progress case : pause at the moment the     ##
            ## disruption is KNOWN, not when the handler that resolves it   ##
            ## happens to start running                                     ##
            <coding.task.queue_paused> = 1;

            <[event.add_timer]>->(
                {   'after'   => $backoff,
                    'handler' => 'coding.handler.inference_crash_restart',
                    'data'    => { 'backend' => $backend }
                }
            );
        }
    }

    ## log unexpected child exits for debugging ##
    if ( not $matched ) {
        <[base.logs]>->(
            2,
            '[inference_server_sigchld] reaped '
                . 'unknown child [pid=%d exit=%d]',
            $pid,
            $exit_status
        );
    }
}

## note: if $reaped == 0, the child was already reaped by another path (e.g.
## Perl's system() waitpid) : this is normal, no action needed.

