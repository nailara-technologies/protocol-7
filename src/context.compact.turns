## [:< ##

# name  = context.compact.turns
# descr = compact conversation turns via models.conversation

my $params = shift // {};

my $job_id     = $params->{'job_id'}     // '';
my $keep_turns = $params->{'keep_turns'} // 5;

## delegate to models.conversation.compact if available ##
if ( exists $code{'models.conversation.compact'} ) {
    my $result = $code{'models.conversation.compact'}->(
        {   'job_id'     => $job_id,
            'keep_turns' => $keep_turns
        }
    );
    return $result if defined $result;
}

return {
    'mode' => qw| false |,
    'data' => 'conversation compaction not available'
};

