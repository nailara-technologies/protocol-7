## [:< ##

# name  = claude.handler.stop_kill
# descr = timer : KILL a child group left after TERM

my $data  = shift->w->data // {};
my $child = <claude.child>;
return if not defined $child or $child->{'pid'} != ( $data->{'pid'} // 0 );
return if not CORE::kill( 0, -$child->{'pid'} );
CORE::kill( 'KILL', -$child->{'pid'} );
<[claude.event.add]>->( qw| stop |, "pid $child->{'pid'} : KILL" );

