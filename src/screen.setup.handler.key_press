## [:< ##

# name  = screen.setup.handler.key_press
# descr = Escape / Return / q dismisses the layout map

my ( $id, $widget, $event ) = @ARG;

return FALSE if not defined $id;

my $keyval = $event->keyval;

my $KEY_ESC = eval { Gtk3::Gdk::KEY_Escape() } // 65307;
my $KEY_RET = eval { Gtk3::Gdk::KEY_Return() } // 65293;
my $KEY_Q   = eval { Gtk3::Gdk::KEY_q() }      // 113;

if ( $keyval == $KEY_ESC or $keyval == $KEY_RET or $keyval == $KEY_Q ) {
    <[screen.setup.close]>->($id);
    return TRUE;
}

return FALSE;

