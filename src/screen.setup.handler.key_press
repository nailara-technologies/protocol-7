## [:< ##

# name  = screen.setup.handler.key_press
# descr = Escape / Return / q dismisses the layout map

my ( $id, $widget, $event ) = @ARG;

return FALSE if not defined $id;

my $keyval = $event->keyval;

my $KEY_ESC = eval { Gtk3::Gdk::KEY_Escape() } // 65307;
my $KEY_RET = eval { Gtk3::Gdk::KEY_Return() } // 65293;
my $KEY_Q   = eval { Gtk3::Gdk::KEY_q() }      // 113;
my $inst    = <screen.setup.instances>->{$id};

if ( $inst->{'dpi_control'} ) {
    my $up       = eval { Gtk3::Gdk::KEY_Up() }          // 65362;
    my $down     = eval { Gtk3::Gdk::KEY_Down() }        // 65364;
    my $plus     = eval { Gtk3::Gdk::KEY_plus() }        // 43;
    my $minus    = eval { Gtk3::Gdk::KEY_minus() }       // 45;
    my $equal    = eval { Gtk3::Gdk::KEY_equal() }       // 61;
    my $add      = eval { Gtk3::Gdk::KEY_KP_Add() }      // 65451;
    my $subtract = eval { Gtk3::Gdk::KEY_KP_Subtract() } // 65453;
    my $raise = eval { Gtk3::Gdk::keyval_from_name('XF86AudioRaiseVolume') };
    my $lower = eval { Gtk3::Gdk::keyval_from_name('XF86AudioLowerVolume') };

    if ( $keyval == $KEY_ESC ) {
        <[screen.setup.dpi.revert]>;
        <[screen.setup.close]>->($id);
        return TRUE;
    }
    if ( $keyval == $KEY_RET ) {
        <[screen.setup.dpi.confirm]>;
        <[screen.setup.close]>->($id);
        return TRUE;
    }

    my $delta
        = $keyval == $up
        || $keyval == $plus
        || $keyval == $equal
        || $keyval == $add || defined $raise && $keyval == $raise ? 6
        : $keyval == $down
        || $keyval == $minus
        || $keyval == $subtract
        || defined $lower && $keyval == $lower ? -6
        : 0;
    if ($delta) {
        my $current = <screen.setup.dpi.value>
            // <[screen.setup.dpi.settings]>->{'value'} // 96;
        my ( $value, $error )
            = AMOS7::Desktop::DPI::parse_value( sprintf( '%+d', $delta ),
            $current );
        if ( defined $value ) {
            <[screen.setup.dpi.change]>->(
                {   'value' => $value,
                    'cb'    => sub {
                        my $live = <screen.setup.instances>->{$id};
                        $live->{'window'}->queue_draw
                            if defined $live and defined $live->{'window'};
                    },
                }
            );
        }
        return TRUE;
    }
}

if ( $keyval == $KEY_ESC or $keyval == $KEY_RET or $keyval == $KEY_Q ) {
    <[screen.setup.close]>->($id);
    return TRUE;
}

return FALSE;

