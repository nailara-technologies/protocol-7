## [:< ##

# name  = screen.setup.subscribe-screen-change
# descr = initialized callback — subscribe screen.setup to X-11 screen-change STRM events

<[base.log]>->(
    1, 'subscribing screen.setup to X-11 screen-change events .,'
);

<[base.zenki.resolve_primary_sid]>->(
    'X-11',
    sub {
        my $sid = shift;
        return if not defined $sid;
        <[protocol-7.route-send]>->(
            {   'command' => "$sid.subscribe-screen-change",
                'reply'   => {
                    'handler' =>
                        qw| screen.setup.handler.screen-change_strm_open |,
                }
            }
        );
    }
);

return TRUE;

