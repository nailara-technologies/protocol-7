## [:< ##

# name = memory.focus.set
# descr = set persistent boost floor for a topic

my $topic = @_ ? shift : $ARG;
my $boost = @_ ? shift : $ARG;

return FALSE if not defined $topic or not length $topic;
return FALSE if not defined $boost or $boost !~ m|^\d+(?:\.\d+)?$|;

$boost = 0 + $boost;

## [ ensure state exists ]##
<memory.focus>       //= {};
<memory.focus_floor> //= {};

## [ set persistent floor and current boost ]##
<memory.focus_floor>->{$topic} = $boost;
<memory.focus>->{$topic}       = $boost;

return TRUE;

