## [:< ##

# name  = base.protocol-7.route-send
# descr = send command via protocol-7.network.parent_route prefix

my $params  = shift                // return 0;
my $command = $params->{'command'} // return 0;
my @route;

## prepend parent_route hops to command [e.g.:'parent.cube','p7-log.append'..]
@route = <protocol-7.network.parent_route>->@*
    if ref(<protocol-7.network.parent_route>) eq qw| ARRAY |;

$params->{'command'} = @route ? join( '.', @route, $command ) : $command;

return <[protocol-7.command.send.local]>->($params);

