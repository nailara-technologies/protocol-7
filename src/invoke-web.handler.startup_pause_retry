# name  = invoke-web.handler.startup_pause_retry
# descr = timer : send \ resend the queue pause at startup [ see
#         invoke-web.handler.startup_pause_reply ]

my $event   = shift;
my $attempt = eval { $event->w->data->{'attempt'} } // 2;

<[invoke-web.api_async]>->(
    'PUT', '/api/v1/queue/default/processor/pause',
    undef,
    'invoke-web.handler.startup_pause_reply',
    { 'attempt' => $attempt }
);

