## [:< ##

# name  = discover.orbital.handler.local_p7ref_reply
# descr = reply handler for local orbital p7ref request

my $reply = shift;

if ( ( $reply->{'mode'} // '' ) eq qw| false | ) {
    <[discover.orbital.request_backoff]>->(FALSE);
    return undef;
}

<[discover.orbital.request_backoff]>->(TRUE);

## nodes.orbital-p7ref returns mode=size with plain p7ref string ##
my $p7ref = $reply->{'data'} // '';
$p7ref =~ s|^\s+||;
$p7ref =~ s|\s+$||;

if ( length $p7ref ) {
    <discover.orbital.local_p7ref> = $p7ref;
    return $p7ref;
}

<[base.logs]>->( 2, 'orbital p7ref reply: empty or not initialized' );

return undef;

