## [:< ##

# name  = plugin.web.jobs.cache.read_all
# descr = return in-memory job cache, loading from disk once on first call

return <plugin.web.jobs.cache>
    if ref <plugin.web.jobs.cache> eq qw| HASH |;

my $cache_dir = <[plugin.web.jobs.cache.path]>;
my %jobs;
my $index = {};

my @active_statuses
    = qw| new review apply applied interviewed rejected skipped |;
my @epoch_statuses = qw| blocked deleted |;

## scan active status dirs ##
for my $status (@active_statuses) {
    my $dir = "$cache_dir/$status";
    next if not -d $dir;
    opendir my $dh, $dir or next;
    for my $fn ( grep { m|\.yaml$| && !m|^\.| } readdir($dh) ) {
        my $enc_id = $fn;
        $enc_id =~ s|\.yaml$||;
        my $job_id = <[base.vax-int.decode]>->($enc_id);
        my ( $job, $yaml_err ) = <[format.yaml.load_file]>->("$dir/$fn");
        if ( defined $yaml_err ) {
            <[base.logs]>->(
                0, 'web.jobs.cache.read_all: error %s/%s: %s',
                $status, $fn, $yaml_err
            );
            next;
        }
        next if ref $job ne qw| HASH |;
        $jobs{$job_id} = $job;
        $index->{$job_id} = $status;
    }
    closedir $dh;
}

## scan epoch-bucketed dirs for index only ##
for my $status (@epoch_statuses) {
    my $dir = "$cache_dir/$status";
    next if not -d $dir;
    opendir my $dh, $dir or next;
    for my $epoch_dir ( grep { !m|^\.| && -d "$dir/$_" } readdir($dh) ) {
        opendir my $edh, "$dir/$epoch_dir" or next;
        for my $fn ( grep { m|\.yaml$| && !m|^\.| } readdir($edh) ) {
            my $enc_id = $fn;
            $enc_id =~ s|\.yaml$||;
            my $job_id = <[base.vax-int.decode]>->($enc_id);
            $index->{$job_id} = "$status:$epoch_dir";
        }
        closedir $edh;
    }
    closedir $dh;
}

<plugin.web.jobs.index> = $index;
<plugin.web.jobs.cache> = \%jobs;

return <plugin.web.jobs.cache>;

