# name  = letsencr.parent.notify_httpd_certificate_update
# descr = notify httpsd zenka that certificate has been
#         updated and needs reload

my $cert_data = shift;

my $domain    = $cert_data->{domain};
my $cert_path = $cert_data->{cert_path};
my $key_path  = $cert_data->{key_path};

unless ( $domain && $cert_path && $key_path ) {
    <[base.logs]>->(
        1, 'error: domain, cert_path, and key_path are required'
    );
    return {
        status => qw| error |,
        error  => 'Missing required certificate data'
    };
}

<[base.logs]>->(
    2, 'notifying httpsd of certificate update for: %s', $domain
);

## send notification to httpsd via Protocol-7 command protocol  httpsd can
## refresh its loaded certificate cache from disk
my $notify_cmd = 'cube.httpsd.reload-certificates';

my $result = <[protocol-7.command.send.local]>->(
    {   'command'   => $notify_cmd,
        'call_args' => {}
    }
);

if ($result) {
    <[base.logs]>->(
        2, 'certificate update notification sent to httpsd for: %s', $domain
    );
    return {
        status => qw| success |,
        domain => $domain,
        msg    => 'Notification sent to httpsd'
    };
} else {
    <[base.logs]>->(
        1, 'warning: failed to notify httpsd of certificate update for: %s',
        $domain
    );
    return {
        status => qw| error |,
        error  => 'Failed to send notification to httpsd'
    };
}

