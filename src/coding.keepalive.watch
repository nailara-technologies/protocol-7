## [:< ##

# name   = coding.keepalive.watch
# descr  = (re)arm the wake on claude's 5h window reset
# return = TRUE when both commands were buffered
#
# a fired entry is final under its id : removed, then added again

<[park.send]>->( qw| bucket-remove |, qw| keepalive-reset | );
return <[park.send]>->(
    qw| bucket-add |,
    join( ' ',
        qw| keepalive-reset on=usage.window.reset |,
        qw| match.provider=claude match.window=5h match.activity=used |,
        qw| action=send-command |,
        "command=\x22coding.keepalive-reset\x22",
        "reason=\x22keep-alive : hand over at the 5h reset\x22" ),
    qw| coding.handler.handover_reply |,
    { 'source' => qw| arm-keepalive | }
);

