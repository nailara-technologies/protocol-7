## [:< ##

# name  = letsencr.extract_aia_url
# descr = extract AIA CA Issuers URI from PEM

my ($pem) = @ARG;

my $x509 = eval {
    Crypt::OpenSSL::X509->new_from_string( $pem,
        Crypt::OpenSSL::X509::FORMAT_PEM() );
};
return undef unless defined $x509;

## extract AIA extension
my $exts = $x509->extensions_by_name();
return undef
    unless ref $exts eq qw| HASH | and exists $exts->{'authorityInfoAccess'};

my $aia_text = $exts->{'authorityInfoAccess'}->to_string();

## parse CA Issuers URI from AIA text
if ( $aia_text =~ m{CA Issuers\s*-\s*URI:(\S+)} ) {
    return $1;
}

return undef;

