## [:< ##

# name  = httpd.vhost.handler.cert_reply
# descr = handle TLS certificate request reply from letsencr zenka

my $reply = shift;

my $hostname = $reply->{'params'}->{'hostname'};
my $mode     = $reply->{'cmd'}  // qw| FALSE |;
my $data     = $reply->{'data'} // '';

unless ($hostname) {
    <[base.log]>->( 1, 'cert reply handler: missing hostname in params' );
    return FALSE;
}

my $status;
if ( $mode eq qw| TRUE | ) {
    $status = qw| pending |;
    if ( $data =~ m|completed|i or $data =~ m|success|i ) {
        $status = qw| active |;
    }
} elsif ( $mode eq qw| SIZE | ) {
    ## certificate data returned directly ##
    $status = qw| active |;
} elsif ( $mode eq qw| FALSE | ) {
    $status = qw| failed |;
} else {
    $status = qw| pending |;
}

if ( exists <httpd.vhosts.installed>->{$hostname} ) {
    <httpd.vhosts.installed>->{$hostname}->{'cert_status'} = $status;
    <httpd.vhosts.installed>->{$hostname}->{'cert_updated_at'}
        = <[base.ntime]>;
    <httpd.vhosts.installed>->{$hostname}->{'cert_error'} = $data
        if $status eq qw| failed |;
}

<[base.logs]>->( 2, 'cert for %s: %s', $hostname, $status );

return $status;

