# name = power-x11.get_states

<[base.log]>->( 1, ": fetching device list and states ..." );
<[protocol-7.command.send.local]>->(
    {   'command' => "cube.power.show_all",
        'reply'   => { 'handler' => 'power-x11.handler.show_all' }
    }
);

