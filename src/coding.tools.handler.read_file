## [:< ##
# name  = coding.tools.handler.read_file
# descr = dispatch read_file tool call to context.file handler

my $args = shift // {};

## offset/length as line numbers (model-friendly pagination) ##
my $from_line = $args->{'from_line'} // $args->{'offset'} // 1;
my $to_line   = $args->{'to_line'}   // 0;

## if length given, derive to_line from from_line + length ##
if ( !$to_line && ( $args->{'length'} // 0 ) > 0 ) {
    $to_line = $from_line + $args->{'length'} - 1;
}

$from_line = 1 if $from_line < 1;

my $path = $args->{'path'} // '';
## default budget scales as a fraction of the actual server context window ##
## [ not a near-flat cutoff -- a single untargeted read must never consume ##
## most of n_ctx, or the next round's system prompt + history overflow ]   ##
my $srv_n_ctx = ( <coding.inference_servers> // {} )->{'gpu'}->{'n_ctx'}
    // <inference.model.context_length> // 16384;
my $default_budget = int( $srv_n_ctx / 4 );
my $budget         = $args->{'budget'} // $default_budget;

## line numbers on by default, can be disabled ##
my $show_line_numbers = $args->{'show_line_numbers'} // TRUE;

my $result = $code{'context.file'}->(
    {   'path'              => $path,
        'budget'            => $budget,
        'from_line'         => $from_line,
        'to_line'           => $to_line,
        'show_line_numbers' => $show_line_numbers,
        'encoding'          => $args->{'encoding'},
    }
);

## status comments [ binary, not found, unreadable ] pass through as-is -- ##
## no pagination box, and no line count over a binary file                 ##
if ( defined $result and $result =~ m|^<!-- | ) {
    ## images : name the coding tools that can actually read them ##
    $result
        .= "\n:: use view_image path=\"$path\" to see it [ vision model "
        . "loaded ] or analyze_image path=\"$path\" for a text "
        . "description"
        if $result =~ m|^<!-- binary image file|;
    return $result;
}

## count total lines in file for pagination display ##
my $total_lines = 0;
if ( length $path && -f $path ) {
    if ( open my $fh, '<', $path ) {
        $total_lines++ while <$fh>;
        close $fh;
    }
}

## wrap truncated output with ASCII pagination UI ##
if ( defined $result && $total_lines > 0 ) {
    my $shown_to
        = $to_line && $to_line < $total_lines ? $to_line : $total_lines;
    my $pct        = int( $shown_to / $total_lines * 100 );
    my $bar_filled = int( $pct / 5 );
    my $bar        = '|' x $bar_filled . ' ' x ( 20 - $bar_filled );
    my $is_partial = $shown_to < $total_lines;

    my $header = sprintf
        ".:[ file: %s  lines %d-%d / %d ]:%s\n",
        $path, $from_line, $shown_to, $total_lines,
        $is_partial ? '' : ' [ end of file ]';

    my $footer;
    if ($is_partial) {
        my $hint = sprintf(
            "offset=%d  [ %d lines remaining of %d ]\n:: to continue: "
                . "read_file path=\"%s\" offset=%d\n:: note: requesting the "
                . "next page replaces this page in context -- extract what "
                . "you need before paging further",
            $from_line,   $total_lines - $shown_to,
            $total_lines, $path, $shown_to + 1
        );
        my $hint_box = <[base.parser.txt_box]>->( \$hint, 'truncated' );
        $footer
            = sprintf( "\n::[ %s %3d%% ]::\n%s\n", $bar, $pct, $hint_box );
    } else {
        $footer = sprintf( "\n::[ %s 100%% ]:: [ end of file ]::\n", $bar );
    }

    $result = $header . $result . $footer;
}

return $result;

