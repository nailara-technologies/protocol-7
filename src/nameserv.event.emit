## [:< ##

# name  = nameserv.event.emit
# descr = emit internal nameserv events (zenka-local event dispatcher)

my $event_name = shift;
my $event_data = shift // {};

## zenka-local event emitter since p7 core lacks event.emit

my $full_event_name = "nameserv.$event_name";

## dispatch registered handlers                                            ##
## [ e.g. nameserv.sync.notify on data-changed ] ; absent registry stays a ##
## pure log line                                                           ##
my $handlers = <nameserv.event.handlers>;
if (    ref $handlers eq qw| HASH |
    and ref $handlers->{$full_event_name} eq qw| ARRAY | ) {
    <[base.code.call_optional]>->( $ARG, $event_name, $event_data )
        for @{ $handlers->{$full_event_name} };
}

## log the event
if ( ref $event_data eq 'HASH' ) {
    my $data_str = join ', ',
        map {"$ARG=$event_data->{$ARG}"} sort keys %$event_data;
    <[base.logs]>->( 3, "event: %s [ %s ]", $full_event_name, $data_str );
} else {
    <[base.logs]>->( 3, "event: %s", $full_event_name );
}

return TRUE;

