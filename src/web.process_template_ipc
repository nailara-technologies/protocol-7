## [:< ##

# name  = web.process_template_ipc
# descr = processing templates from httpd zenka
# args  = template_id:template_content_b32r:meta_vars_b32r:session_id

my $args_str = shift // '';

unless ( length($args_str) ) {
    return {
        'mode' => qw| false |,
        'data' => qq| usage: template_id:template_b32r:meta_b32r:session_id |
    };
}

my ( $template_id, $template_b32r, $meta_b32r, $session_id )
    = split( m|:|, $args_str, 4 );

unless ( defined $template_id and defined $template_b32r ) {
    return {
        'mode' => qw| false |,
        'data' => qq| missing required parameters |
    };
}

<[base.log]>->(
    2,
    "web.process-template-ipc: received "
        . "template $template_id from httpd session $session_id"
);

## Template content is base32r-encoded to avoid colon delimiter conflicts ##
my $template_content = decode_b32r($template_b32r);

unless ( defined $template_content and length($template_content) ) {
    <[base.log]>->(
        0,
        "web.process-template-ipc: missing template content for $template_id"
    );
    return {
        'mode' => qw| false |,
        'data' => qq| missing template content |
    };
}

## Meta variables are base32r-encoded JSON ##
my $meta_vars = {};
if ( defined $meta_b32r and length($meta_b32r) ) {
    my $meta_json = decode_b32r($meta_b32r);
    $meta_vars = JSON::XS::decode_json($meta_json) // {};
}

<[base.log]>->(
    2,
    "web.process-template-ipc: processing template $template_id ("
        . length($template_content)
        . " bytes, "
        . scalar( keys %{$meta_vars} )
        . " meta vars)"
);

## Track active template processing ##
<web.templates.active>->{$template_id} = {
    template_id => $template_id,
    client_id   => $session_id,
    status      => qw| processing |,
    depth       => 0,
    started_at  => time(),
};

## Process template recursively ##
my $start_time = <[base.time]>->(4);

my $result = <[web.process_template_recursive]>->(
    {   content     => $template_content,
        meta        => $meta_vars,
        depth       => 0,
        template_id => $template_id,
        session_id  => $session_id,
    }
);

my $elapsed_ms = ( <[base.time]>->(4) - $start_time ) * 1000;

## Clean up active template tracking ##
delete <web.templates.active>->{$template_id};

## Update metrics ##
<web.templates.processed>++;
my $prev_avg = <web.metrics>->{avg_processing_time_ms};
<web.metrics>->{avg_processing_time_ms}
    = ( $prev_avg * ( <web.templates.processed> - 1 ) + $elapsed_ms ) /
    <web.templates.processed>;

if ( $result->{status} eq qw| success | ) {
    my $content = $result->{content};

    ## safety: dereference if not a plain string ##
    if ( ref($content) eq qw| ARRAY | ) {
        my @deref
            = map { ref($ARG) eq qw| SCALAR | ? $$ARG : $ARG } @{$content};
        $content = join( '', @deref );
    } elsif ( ref($content) eq qw| SCALAR | ) {
        $content = $$content;
    }

    <[base.logs]>->(
        2, "template %s completed in %.1fms [ depth %d, %d bytes ]",
        $template_id, $elapsed_ms, $result->{depth}, length($content)
    );

    ## check for template-set content-type override ##
    my $content_type_override = <web.template.response_content_type>;
    <web.template.response_content_type> = undef; ## clear for next request ##

    ## prepend content-type header when override is set ##
    if ( defined $content_type_override
        and length $content_type_override ) {
        $content = "content-type:$content_type_override\n\n$content";
    }

    ## return processed content as size response ##
    return {
        'mode' => qw| size |,
        'data' => $content
    };

} else {
    <[base.log]>->(
        0,
        "web.process-template-ipc: processing failed for $template_id: "
            . $result->{message}
    );

    ## Return error as false response ##
    return {
        'mode' => qw| false |,
        'data' => qq| template processing failed: | . $result->{message}
    };
}

