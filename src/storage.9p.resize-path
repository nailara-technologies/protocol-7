## [:< ##
# name  = storage.9p.resize-path
# descr = High-level resize (truncate) over 9P (walk+wstat+clunk)

my ( $conn, $path, $length ) = @ARG;
$length //= 0;

my @parts = grep {length} split m|/|, $path;
my $fid   = $conn->{next_fid}++;

my $walk_result
    = <[storage.9p.walk]>->( $conn, $conn->{root_fid}, $fid, @parts );
return $walk_result if $walk_result->{'mode'} eq 'false';

my $wstat_result
    = <[storage.9p.wstat]>->( $conn, $fid, { length => $length } );

<[storage.9p.clunk]>->( $conn, $fid );

return $wstat_result;

