# name  = coding.task.chunked_summary_eligible
# descr = check if a task qualifies for round-0 rolling-window chunk summarization

my ($task) = @ARG;

return FALSE unless defined $task and ref $task eq qw| HASH |;

my $meta = $task->{'metadata'} // {};

## never chunk a child of chunking (prevents infinite recursion) ##
return FALSE if $meta->{'is_compaction'};
return FALSE if $meta->{'is_chunked_summary'};

## eligible if explicitly flagged or is a known summarization shape ##
return TRUE
    if $meta->{'allow_chunking'}
    or ( $task->{'type'} // '' ) eq qw| summary |;

return FALSE;

