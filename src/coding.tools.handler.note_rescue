## [:< ##

# name  = coding.tools.handler.note_rescue
# descr = restore a trashed note section back into the live workspace

my $args = shift // {};

my $task_id = $args->{'task_id'} // <system.task_id> // 'unknown';
my $section = $args->{'section'} // '';
my $ntime   = $args->{'ntime'}   // '';

my $result = <[note.trash.rescue]>->( $task_id, $section, $ntime );

return {
    'content' => $result->{'mode'} eq qw| true |
    ? $result->{'data'}{'message'}
    : "Failed: " . ( $result->{'data'} // 'unknown' ),
};

