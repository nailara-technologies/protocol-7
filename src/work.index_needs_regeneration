# name  = work.index_needs_regeneration
# descr = check if index needs regeneration based on TTL

my ($index_file) = @ARG;

return TRUE unless -f $index_file;

my $mtime = File::stat::stat($index_file)->mtime;
return TRUE unless defined $mtime;

my $age       = time() - $mtime;
my $index_ttl = <work.cfg.index_ttl>;

return $age > $index_ttl;

