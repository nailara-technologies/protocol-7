## [:< ##

# name  = base.indexcube.pop
# descr = Pop top entry from @INDEXCUBE and verify signature

return { 'mode' => qw| false |, 'data' => 'stack empty' }
    unless @INDEXCUBE;

## Cannot pop the identity anchor (index 0) ##
return {
    'mode' => qw| false |,
    'data' => 'cannot pop identity anchor (INDEXCUBE[0])'
    }
    if scalar(@INDEXCUBE) == 1;

## verify the complete chain before changing the stack ##
my $verification = <[base.indexcube.verify]>;
if ( ref $verification ne qw| HASH |
    or $verification->{'mode'} ne qw| true | ) {
    my $reason
        = ref $verification eq qw| HASH |
        ? $verification->{'data'}
        : 'chain verification failed';
    <[base.logs]>->( 0, '[indexcube.pop] chain INVALID : %s', $reason );
    return {
        'mode' => qw| false |,
        'data' => { 'valid' => FALSE, 'reason' => $reason }
    };
}

my $entry = pop @INDEXCUBE;

<[base.logs]>->(
    2,                 '[indexcube.pop] %s depth %d - signature valid',
    $entry->{'p7ref'}, $entry->{'depth'}
);

return {
    'mode' => qw| true |,
    'data' => {
        'p7ref'     => $entry->{'p7ref'},
        'depth'     => $entry->{'depth'},
        'timestamp' => $entry->{'timestamp'},
        'prev'      => $entry->{'prev'},
        'signature' => $entry->{'signature'},
        'valid'     => TRUE,
    }
};

