# name  = form.test.secret_send_hold
# descr = send HOLD for the current test case index -- called both from
#         the console command [ first case ] and from the release reply
#         handler [ chaining into the next case ]

my $index = <form.test.index>;
my $case  = <form.test.cases>->[$index];

<[base.logs]>->(
    2,      ': secret roundtrip case %d [ %s ]: sending hold',
    $index, $case->{'label'}
);

my $source = <form.source>            // return FALSE;
my $sender = $source->{'secret_hold'} // return FALSE;

<[$sender]>->(
    $case->{'name'},
    encode_b32r( $case->{'value'} ),
    qw| form.handler.secret_hold_reply |
);

return TRUE;

