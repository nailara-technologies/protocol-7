# name  = web-browser.cmd.wait-for-state
# descr = poll window.* vars until settled or timeout
# param = <var...> [tolerance=] [samples=] [timeout=]

my $reply_id = $call->{'reply_id'};
my $args_str = $call->{'args'} // '';

return {
    'mode' => qw| false |,
    'data' => 'usage: wait-for-state <var> [var ...] '
        . '[tolerance=0.01] [samples=5] [timeout=10]'
    }
    if !length($args_str);

my $fg_index = <web-browser.overlay.index>->{'fg'};
my $view     = <web-browser.gtk_obj.view>->{$fg_index};

return { 'mode' => qw| false |, 'data' => 'no foreground view' }
    unless defined $view;

my $settings = $view->get_settings();

return {
    'mode' => qw| false |,
    'data' => 'javascript execution is disabled'
    }
    if !$settings->get_enable_javascript();

my @tokens = split( m|\s+|, $args_str );

my $tolerance = 0.01;
my $samples   = 5;
my $timeout   = 10;
my @names;
foreach my $token (@tokens) {
    if ( $token =~ m|^tolerance=(\d+(?:\.\d+)?)$| ) {
        $tolerance = 0 + $1;
    } elsif ( $token =~ m|^samples=(\d+)$| ) {
        $samples = 0 + $1;
    } elsif ( $token =~ m|^timeout=(\d+(?:\.\d+)?)$| ) {
        $timeout = 0 + $1;
    } elsif ( length($token) ) {
        push @names, $token;
    }
}

return {
    'mode' => qw| false |,
    'data' => 'expected at least one variable name'
    }
    if !@names;

$samples = 1 if $samples < 1;

<[web-browser.wait-state-poll]>->(
    {   'view'      => $view,
        'names'     => \@names,
        'tolerance' => $tolerance,
        'samples'   => $samples,
        'timeout'   => $timeout,
        'finish'    => sub {
            my $poll = shift;

            if ( length( $poll->{'error'} // '' ) ) {
                <[base.callback.cmd_reply]>->(
                    $reply_id,
                    {   'mode' => qw| false |,
                        'data' => $poll->{'error'}
                    }
                );
                return;
            }

            my @vals
                = ref( $poll->{'values'} ) eq qw| ARRAY |
                ? $poll->{'values'}->@*
                : ();
            my @pairs;
            for ( my $i = 0; $i < @names; $i++ ) {
                push @pairs,
                    sprintf( '%s=%s',
                    $names[$i], defined $vals[$i] ? $vals[$i] : qw| undef | );
            }
            <[base.callback.cmd_reply]>->(
                $reply_id,
                {   'mode' => $poll->{'ok'} ? qw| true | : qw| false |,
                    'data' => sprintf(
                        '%s [%s after %.1fs]',
                        join( ' ', @pairs ),
                        $poll->{'ok'} ? qw| settled | : qw| timeout |,
                        $poll->{'elapsed'} // 0
                    )
                }
            );
        }
    }
);

return { 'mode' => qw| deferred | };

