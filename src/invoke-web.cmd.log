## [:< ##

# name  = invoke-web.cmd.log
# descr = last lines of invoke.ai output [ default 20 ]
# param = [ lines ]

my $count = $call->{'args'} // '';
$count = 20 if $count !~ m|^\d+$| or $count < 1;

my @tail = ( <invoke-web.output_tail> // [] )->@*;
@tail = @tail[ -$count .. -1 ] if @tail > $count;

return { mode => qw| false |, data => 'no invoke.ai output yet' }
    if not @tail;

return { mode => qw| size |, data => join( "\n", @tail ) . "\n" };

