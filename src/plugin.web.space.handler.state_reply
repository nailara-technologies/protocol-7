## [:< ##

# name  = plugin.web.space.handler.state_reply
# descr = handle async reply from data source zenka

my $reply = shift;

my $params = $reply->{'params'}            // {};
my $field  = $params->{'field'}            // return;
my $data_r = $reply->{'call_args'}{'args'} // '';

my $cache = <web.space.cache>;
my $state = $cache->{'state'};

if ( $field eq qw| cursor | ) {
    ## parse cursor-state reply: "selX,selY,selZ zoom radius" ##
    if ( $data_r =~ m|(\d+),(\d+),(\d+)| ) {
        $state->{'cursor'} = {
            qw| selX | => $1,
            qw| selY | => $2,
            qw| selZ | => $3,
        };
    }
} elsif ( $field eq qw| graph | ) {
    ## parse graph stats reply: "graph: N edges, M clusters" ##
    if ( $data_r =~ m|(\d+)\s+edges.*?(\d+)\s+clusters| ) {
        $state->{'edges'}    = $1;
        $state->{'clusters'} = $2;
    }
}

$cache->{'timestamp'} = time();
$cache->{'source'}    = <web.space.cfg.data_source> // qw| unknown |;

<[base.logs]>->( 2, 'plugin.web.space : updated %s from reply', $field );

return 0;

