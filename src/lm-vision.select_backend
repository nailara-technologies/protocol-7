# name  = lm-vision.select_backend
# descr = choose vision backend with memory safety and server awareness
# return = ( $backend, $reason ) where backend is 'http', 'cli', 'loading', or 'unavailable'

my $configured = <lm-vision.backend> // qw| auto |;

## explicit cli is allowed but warned ##
if ( $configured eq qw| cli | ) {
    <[base.logs]>->( 1, '[select_backend] cli backend explicitly requested' );
    return ( qw| cli |, qw| explicit cli configuration | );
}

## check cached coding zenka gpu server status ##
my $server_info = <lm-vision.cached_coding_status> // {};
my $gpu_server  = $server_info->{'gpu'}            // {};
my $is_ready    = ( $gpu_server->{'status'}            // '' ) eq qw| ready |;
my $has_mmproj  = length( $gpu_server->{'mmproj_path'} // '' );

## http backend requirements: server ready AND spawned with mmproj ##
if ( $is_ready && $has_mmproj ) {
    <[base.logs]>->(
        2,
        '[select_backend] http backend available' . ' [ port=%d mmproj=%s ]',
        $gpu_server->{'port'} // 8000,
        $gpu_server->{'mmproj_path'}
    );
    return ( qw| http |, qw| coding zenka gpu server ready with mmproj | );
}

## server is still loading the model - signal to queue and retry ##
if ( $gpu_server->{'still_loading'} ) {
    <[base.logs]>
        ->( 1, '[select_backend] coding server still loading model' );
    return ( qw| loading |,
        'coding inference server is still loading the model' );
}

## server ready but current model has no mmproj: a normal, common state [   ##
## non-vision models run on the same shared gpu server ], not a fault --    ##
## cache is kept fresh by the steady-state poll in update_coding_status, so ##
## this reflects the currently loaded model, not a stale guess              ##
if ( $is_ready && !$has_mmproj ) {
    <[base.logs]>->(
        1,
        '[select_backend] coding server ready, '
            . 'current model has no vision support'
    );
    return ( qw| unavailable |,
        'current coding model has no vision support (no mmproj loaded)' );
}

## server not ready but http forced - treat as loading to queue request ##
if ( $configured eq qw| http | ) {
    <[base.logs]>->(
        1, '[select_backend] http forced but server not ready, will retry'
    );
    return ( qw| loading |,
        'coding inference server not ready, queuing for retry' );
}

## auto mode: do not fall back to cli when gpu memory is committed loading ##
## a second model instance would oom the host                              ##
my $gpu_pid = $gpu_server->{'pid'} // 0;
if ( $gpu_pid && kill( 0, $gpu_pid ) ) {
    <[base.logs]>->(
        0,
        '[select_backend] coding server is running '
            . '(pid=%d), refusing cli fallback to prevent oom',
        $gpu_pid
    );
    return (
        qw| unavailable |,
        'coding inference server running, '
            . 'cli fallback disabled to prevent oom'
    );
}

## auto mode with no server running: check for other llama processes ##
my @other_llama = qx{ pgrep -a 'llama-(server|mtmd-cli)' 2>/dev/null };
if (@other_llama) {
    chomp( my $proc_list = join( ', ', @other_llama ) );
    <[base.logs]>->(
        0,
        '[select_backend] other llama process '
            . 'detected, refusing cli fallback: %s',
        $proc_list
    );
    return (
        qw| unavailable |,
        'another llama process is running, '
            . 'cli fallback disabled to prevent oom'
    );
}

## last resort: cli fallback only when nothing else is running ##
<[base.logs]>->( 1, '[select_backend] falling back to cli backend' );
return ( qw| cli |, 'no shared server available, isolated cli spawn' );

