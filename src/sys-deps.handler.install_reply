## [:< ##

# name  = sys-deps.handler.install_reply
# descr = handle deferred debian.install-packages reply

my $reply = shift;
return warn 'no reply hashref received' if not defined $reply;

## reply-handler call signature is a SINGLE hashref { sid, cmd, call_args,  ##
## params } -- 'cmd' is the wire-level mode keyword and the payload sits in ##
## call_args->{args} [ see base.handler.command.process_reply ] -- this     ##
## previously read $reply->{'mode'}/{'data'}, neither of which exists on    ##
## this hashref, so every reply silently fell through to the failure branch ##
## regardless of the real outcome                                           ##
my $mode      = uc( $reply->{'cmd'} // '' );
my $params    = $reply->{'params'}              // {};
my $reply_str = $reply->{'call_args'}->{'args'} // '';
my $packages  = $params->{'packages'}           // [];
my $zenka     = $params->{'zenka'};
my $reply_id  = $params->{'reply_id'};

my ( @ok, @failed );
if ( $mode eq qw| TRUE | ) {
    @ok = @$packages;
} else {
    @failed = @$packages;
    <[base.logs]>->(
        0,
        'sys-deps: install via debian zenka failed : %s',
        length($reply_str) ? $reply_str : qw| unknown error |
    );
}

## Track successful installs [ moved from sys-deps.cmd.install : the actual ##
## install now completes asynchronously in the debian zenka ] via the       ##
## shared AMOS7::deps::tracked record : dedups on type + name and writes    ##
## atomically                                                               ##
if (@ok) {
    my @entries = map {
        {   'pkg'          => $ARG,
            'type'         => qw| debian |,
            'installed_at' => <[base.ntime.b32]> // '',
            'source'       => 'sys-deps',
            'zenka'        => $zenka,
            'declared'     => 0
        }
    } @ok;
    AMOS7::deps::tracked::record( <system.root_path>, \@entries );
    <sys-deps.tracked>
        = AMOS7::deps::tracked::read_tracked(<system.root_path>);
}

my @output;
push @output, ":", "::[ sys-deps install ]", ":";
push @output, map {":  installed : $ARG"} @ok;
push @output, map {":  failed    : $ARG"} @failed;
push @output, ":";

## complete the original caller's deferred reply ##
if ( defined $reply_id ) {
    <[base.callback.cmd_reply]>->(
        $reply_id,
        {   'mode' => qw| size |,
            'data' => "\n" . join( "\n", @output ) . "\n"
        }
    );
}

return;

