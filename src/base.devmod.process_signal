# name  = base.devmod.process_signal
# descr = apply a devmod state from a signal or start-up value

my $requested_state = delete <base.devmod.requested_state>;
return TRUE if not defined $requested_state;
return TRUE if $requested_state !~ m{^(?:off|safe|full)$};

my $success = TRUE;
if ( $requested_state eq qw| off | ) {
    <base.devmod.keep_on_reload> = FALSE;
    <[base.purge_code]>->('devmod');
    delete <base.p7_mod.loaded.devmod>;
    <[base.parser.access_conf]>;
} elsif ( $requested_state eq qw| safe | ) {
    my @safe_commands = <[base.devmod.safe_commands]>;
    my @modules       = qw| devmod.dump devmod.pre_init devmod.init_code |;
    push @modules, map { sprintf qw| devmod.cmd.%s |, $ARG } @safe_commands;
    push @modules, qw| devmod.post_init |;

    $success = <[base.load_runtime_modules]>->(@modules);
    $success = <[base.init_modules]>->('devmod') if $success;
    $success = <[base.devmod.unload_unsafe]> >= 0 && $success;
} else {
    $success = <[base.load_runtime_modules]>->('devmod');
    $success = <[base.init_modules]>->('devmod') if $success;
    <[base.parser.access_conf]> if $success;
}

<base.devmod.state> = $requested_state if $success;

<[base.logs]>->(
    $success ? 1 : 0,
    'devmod transition to %s %s',
    $requested_state, $success ? qw| complete | : qw| failed |
);

return $success;

