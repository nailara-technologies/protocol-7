# name  = plugin.usage.kimi.refresh_watchdog
# descr = proactively refresh the kimi credential shortly before it expires
# note  = re-checks via the same plugin.usage.kimi.refresh_token path
#         handler.response already uses reactively on a 401 -- if the file
#         is already fresh [ refreshed by something else in the meantime ],
#         refresh_token's own on-disk check finds that and skips the spawn,
#         so firing this a little early or a little late costs nothing
#         extra. confirmed live 2026-09-17 : kimi's expires_at is reliable
#         [ the on-disk value at a real 401 matched the locally-cached one
#         exactly, and a fresh value appeared after the refresh completed ]
#         -- unlike claude's own expiresAt, see plugin.usage.claude.
#         refresh_watchdog's note on why that one is best-effort only

my $provider = <usage.provider.kimi>;
my $margin   = $provider->{'proactive_refresh_margin'} // 60;

my $cred = <[plugin.usage.kimi.read_credential]>;
my $now  = time;

if ( length $cred->{'token'} and defined $cred->{'expires_at'} ) {
    my $remaining = $cred->{'expires_at'} - $now;

    if ( $remaining <= $margin ) {
        if ( $remaining < 0 ) {
            <[base.logs]>->(
                1,
                '[usage.kimi.refresh_watchdog] proactive '
                    . 'refresh : already expired %ds ago',
                -$remaining
            );
        } else {
            <[base.logs]>->(
                2,
                '[usage.kimi.refresh_watchdog] proactive '
                    . 'refresh : expires in %ds, within %ds margin',
                $remaining,
                $margin
            );
        }
        <[plugin.usage.kimi.refresh_token]>->(
            undef,
            {   'on_done' => {
                    'handler' =>
                        qw| plugin.usage.kimi.refresh_watchdog_rearm |,
                    'params' => {},
                },
            }
        );
        return TRUE;
    }

    ## not due yet -- schedule exactly when it will be ##
    <[event.add_timer]>->(
        {   'after'   => $remaining - $margin,
            'handler' => qw| plugin.usage.kimi.refresh_watchdog |,
            'data'    => {},
        }
    );
    return TRUE;
}

## credential unreadable right now -- retry soon rather than giving up      ##
## permanently. short delay, not a long backoff : the expected real case is ##
## this timer's own FIRST fire, from init_code, which runs before           ##
## [root.drop_privs] -- $ENV{HOME}/$UID still resolve to the pre-drop       ##
## launching user at that point [ confirmed live 2026-09-17 ], not taeki,   ##
## so the credential directory genuinely doesn't exist under that home yet  ##
## -- self-heals the moment drop_privs completes, a few seconds later. a    ##
## genuinely missing/corrupt credential past that point is rare and cheap   ##
## to keep re-checking quickly rather than worth a long backoff             ##
<[base.logs]>->(
    2,
    '[usage.kimi.refresh_watchdog] credential '
        . 'unreadable [ %s ], retrying in 3s',
    $cred->{'error'} // 'unknown'
);
<[event.add_timer]>->(
    {   'after'   => 3,
        'handler' => qw| plugin.usage.kimi.refresh_watchdog |,
        'data'    => {},
    }
);
return TRUE;

