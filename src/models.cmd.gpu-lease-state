# name  = models.cmd.gpu-lease-state
# descr = show gpu residency holder, handover and timeout state

my $state  = <[models.gpu_lease.state]>;
my $lease  = <models.gpu_lease> // {};
my $output = sprintf "enabled  : %s\nholder   : %s\n",
    $state->{'enabled'}       ? 'yes'              : 'no',
    length $state->{'holder'} ? $state->{'holder'} : 'none';
$output .= sprintf "age      : %d s\n", <[base.time]> - $state->{'touched'}
    if length $state->{'holder'};
$output .= sprintf "pending  : %s -> %s%s\n",
    $state->{'pending'}->{'from'}      // 'none',
    $state->{'pending'}->{'requester'} // '?',
    $state->{'pending'}->{'unloaded'} ? ' [ unload acknowledged ]' : ''
    if defined $state->{'pending'};
$output .= sprintf "waiting  : %s\n", join ' ', $state->{'waiting'}->@*;
$output .= sprintf "reason   : %s\n", $state->{'wait_reason'}
    if length $state->{'wait_reason'};

return { 'mode' => qw| size |, 'data' => $output };

