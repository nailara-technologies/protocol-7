# name  = letsencr.child.acme_use_server
# param = $server_url [ default : <letsencr.acme.server> ]
# descr = select the ACME server context for the next request : when the
#         server changes the client state is reset [ directory, nonce,
#         account ] -- staging and production use separate accounts
# return = the selected server url

my $server_url = shift // <letsencr.acme.server>;

my $current = <letsencr.child.acme_client>->{'server'} // '';

if ( $current ne $server_url ) {
    <[base.logs]>->(
        2,
        'switching ACME server context : %s -> %s',
        $current || qw| none |, $server_url
    );
    <letsencr.child.acme_client> = {
        'server'           => $server_url,
        'account_key'      => undef,
        'account_key_name' => undef,
        'account_key_type' => 'Ed25519',
        'account_id'       => undef,
        'account_url'      => undef,
        'nonce'            => undef,
        'directory'        => undef,
    };
}

return $server_url;

