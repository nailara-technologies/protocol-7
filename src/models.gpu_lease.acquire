## [:< ##

# name  = models.gpu_lease.acquire
# descr = request sole gpu residency for coding or invoke-web
# param = owner name [ required free vram MB ]

my ( $owner, $need_mb ) = @ARG;
$owner //= '';
return FALSE if $owner ne qw| coding | and $owner ne qw| invoke-web |;
return FALSE
    if not <[base.cfg_bool]>->( <models.cfg.gpu_lease.enabled> // FALSE );

my $lease = <models.gpu_lease> //= {};

## acquire from the current holder : a restarted owner                   ##
## [ the lease is kept by name, not instance ]. it waits for a grant --  ##
## refresh and send it again. without it tick dropped the request as     ##
## 'already held', the new instance never renewed, the lease expired and ##
## went to the other side                                                ##
## [ invoke-web restart 2026-11-26 : coding took the gpu ]               ##
if ( ( $lease->{'holder'} // '' ) eq $owner ) {
    my $timeout = <models.cfg.gpu_lease.timeout> // 45;
    $timeout = 45 if $timeout !~ m|^\d+$| or $timeout < 5;
    $lease->{'touched'} = <[base.time]>;
    delete $lease->{'waiting'}->{$owner};
    <[protocol-7.route-send]>->(
        {   'command'   => "$owner.gpu-lease-granted",
            'call_args' => { 'args' => $timeout },
        }
    );
    <[base.logs]>->(
        1, ': gpu lease re-granted to %s [ re-acquire ]', $owner
    );
    return TRUE;
}

$lease->{'waiting'}->{$owner} = {
    'at'      => <[base.time]>,
    'need_mb' => $need_mb // 0,
};
<[models.gpu_lease.handler.tick]>;

return ( $lease->{'holder'} // '' ) eq $owner ? TRUE : FALSE;

