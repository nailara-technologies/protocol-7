## [:< ##

# name  = X-11.chk.early-priv-drop

my $X11_user_name = shift;

if ( not defined <system.zenka-user.current> ) {
    warn 'expected user param <{C1}>';
    return undef;
}

<X-11.xorg-mode.no-root-start-up> //= FALSE;
<X-11.auto-conf.non-root-setup>   //= FALSE;

my $X11_start_mode = <X-11.mode>;    ## configured start mode ##

## required by bg image path-chksum cache ##
<[base.path-set-up.check-zenka-paths]>->(TRUE);

if ( $X11_start_mode eq qw| auto-xephyr | ) {  ## checking auto-xephyr mode ##
    ## detect if Xorg running --> xephyr
    system('ps h -C Xorg 1>/dev/null 2>/dev/null');
    $X11_start_mode = $CHILD_ERROR == 256 ? qw| xorg | : qw| xephyr |;
}

##  checking if system changes required  ##
##
if ( $X11_start_mode eq qw| xorg | ) {

    ##  keep root privs when configured for root user start-up  ##
    ##
    return FALSE
        if not <[base.cfg_bool]>->(<X-11.xorg-mode.no-root-start-up>);

    ##  check \ perform required system changes for non-root start  ##
    ##
    if ( <[base.cfg_bool]>->(<X-11.auto-conf.non-root-setup>) ) {
        ##  adjust system  ##
        if ( not <[X-11.autoconfigure.non-root-start]>->($X11_user_name) ) {
            <[base.log]>->( 0, 'cannot configure non-root start-up .,' );
            <[base.log]>->( 0, ':. giving up X-11 zenka start-up..,' );
            <[base.exit]>->(qw| 0110 |);    ## shutting down zenka ##
        }
    }
}

## ensure /tmp/.X11-unix has the sticky bit so a nested X server can create ##
## its filesystem socket -- without it, some servers fall back to the       ##
## abstract-namespace socket only, which X11::Protocol cannot connect to ;  ##
## this is the last point still running as root [ checked unconditionally   ##
## of mode -- <X-11.mode> may still read the static config value here,      ##
## before X-11.init_code applies a mode override ]                          ##
my $x11_unix_dir = qw| /tmp/.X11-unix |;

## under WSLg, /tmp/.X11-unix is its own dedicated read-only tmpfs mount [  ##
## used to expose the host display's socket ] -- chmod alone cannot succeed ##
## there regardless of privilege, it must be remounted rw first             ##
if ( open( my $mounts_fh, '<', '/proc/mounts' ) ) {
    while ( my $mount_line = <$mounts_fh> ) {
        my @field = split( ' ', $mount_line );
        next unless ( $field[1] // '' ) eq $x11_unix_dir;
        next unless ( $field[3] // '' ) =~ m{(?:^|,)ro(?:,|$)};
        system( 'mount', '-o', 'remount,rw', $x11_unix_dir );
        <[base.logs]>->(
            ( $CHILD_ERROR == 0 ? 1 : 0 ),
            ': remounted %s rw [ %s ]',
            $x11_unix_dir, ( $CHILD_ERROR == 0 ? 'ok' : 'failed' )
        );
    }
    close($mounts_fh);
}

my $x11_unix_stat = File::stat::stat($x11_unix_dir);
if ( defined $x11_unix_stat and ( $x11_unix_stat->mode & 07777 ) != 01777 ) {
    if ( chmod( 01777, $x11_unix_dir ) ) {
        <[base.logs]>
            ->( 1, ': fixed %s permissions [ 1777 ]', $x11_unix_dir );
    } else {
        <[base.logs]>->(
            0,             'could not fix %s permissions: %s',
            $x11_unix_dir, $OS_ERROR
        );
    }
}

##  dropping root priviledges to configured user  ##
return <[base.root.drop_privs]>->($X11_user_name);

