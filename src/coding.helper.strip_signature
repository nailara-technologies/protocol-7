# name  = coding.helper.strip_signature
# descr = remove a trailing AMOS7 signature block from model-written content
# param = <content scalar ref> -> TRUE when a block was removed, else FALSE
# note  = models copy the block from the modules they read [ fablevibes,
#         2026-10-10 ] : a signature the signing tool never made. removed,
#         not refused -- the tool result tells the model why

my $content_ref = shift;

return FALSE unless ref $content_ref eq qw| SCALAR | and defined $$content_ref;

## '#,,..' rule, base32 lines, 'DATA SIGNATURE ::', '#::::' terminator ##
return FALSE
    unless $$content_ref
    =~ s{ (?:^|\n) \#[,.]{40,} \n .*? DATA \s SIGNATURE \s :: [^\n]* \n
          \#:{40,} \s* \z }{\n}xs;

## keep a single trailing newline ##
$$content_ref =~ s|\n+\z|\n|;

return TRUE;

