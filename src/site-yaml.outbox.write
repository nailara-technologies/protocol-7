## [:< ##

# name  = site-yaml.outbox.write
# descr = durably store one fetched job + fan it out to open fetched-streams
# param = <job id> <json payload> [category]
# return = outbox record name [ without .json ] or undef on write error

my ( $job_id, $payload, $category ) = @ARG;

return undef if not length( $job_id // '' ) or not defined $payload;

## the record always wraps the payload : {"job":<job>[,"cat":..]} -- the  ##
## frame inserts "name" into it [ jobsite.fetched.frame reads all three ] ##
my $record
    = length( $category // '' )
    ? sprintf( qq|{"job":%s,"cat":%s}|, $payload,
    JSON::encode_json($category) )
    : sprintf( qq|{"job":%s}|, $payload );

my $outbox_dir = <[site-yaml.outbox.dir]> // return undef;

## durable record : <ntime b32>-<job id>.json, atomic via temp + rename [   ##
## the name only uses what outbox-confirm accepts -- an id with other       ##
## characters [ another site, a url id ] could never be confirmed and would ##
## hold its stream open ]                                                   ##
( my $safe_id = $job_id ) =~ s|[^A-Za-z0-9._-]|_|g;
my $name = sprintf '%s-%s', <[base.ntime.b32]>, $safe_id;
my $file = "$outbox_dir/$name.json";
my $temp = "$outbox_dir/.$name.$PROCESS_ID.tmp";

## raw : the payload is json OCTETS [ encode_json ] -- the zenka's default ##
## :encoding(UTF-8) layer encoded them a second time on disk, and the      ##
## backlog read decoded them into a character string that the stream sent  ##
## in its internal utf-8 form : every umlaut double-encoded [ 2026-10-24 ] ##
my $out_fh;
if ( not open $out_fh, '>:raw', $temp ) {
    <[base.logs]>->(
        0,     'site-yaml.outbox: cannot write %s [ %s ]',
        $temp, $!
    );
    return undef;
}
print {$out_fh} $record;
close $out_fh;

if ( not rename $temp, $file ) {
    <[base.logs]>->(
        0, 'site-yaml.outbox: cannot rename %s to %s [ %s ]',
        $temp, $file, $!
    );
    unlink $temp;
    return undef;
}

## fan out to every open fetched-stream : one JSON line per frame ##
my $streams = <site-yaml.fetched_streams> // [];
if ( @{$streams} ) {
    my $frame = sprintf qq|{"name":"%s",%s| . "\n", $name,
        substr( $record, 1 );
    my @alive;
    for my $h ( @{$streams} ) {
        if ( <[base.stream.push]>->( $h, \$frame ) ) {
            push @alive, $h;
        } else {
            ## subscriber session gone : drop its handle ##
            <[base.logs]>->(
                1,
                'site-yaml.outbox: fetched-stream '
                    . 'subscriber gone [ sid %s ], handle dropped',
                $h->{'sid'} // qw| ? |
            );
        }
    }
    <site-yaml.fetched_streams> = \@alive;
}

return $name;

