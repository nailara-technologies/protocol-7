## [:< ##

# name  = editor.control.commands.insert
# descr = insert text into a field buffer at CHARACTER position

my ( $editor_state, $field, $pos, $text ) = @ARG;

return undef if ref $editor_state ne qw| HASH |;
my $buffer = $editor_state->{'fields'}{$field} // return undef;

return <[editor.buffer.memory.insert]>->( $buffer, $pos, $text );

