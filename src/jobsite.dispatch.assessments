## [:< ##

# name  = jobsite.dispatch.assessments
# descr = collect new untracked jobs and queue assessment tasks

## re-entrant safe : a settle-timer (new job-upsert arrivals) or a        ##
## queue-drain signal can both call this while a previous batch is still  ##
## mid-flight ; only the call that finds cycle already idle is allowed to ##
## kick dispatch.next -- an in-flight chain already re-invokes            ##
## dispatch.next via assess-done, so a second kick here would             ##
## double-dispatch a task                                                 ##
my $was_idle = ( <jobsite.cycle> // '' ) ne qw| assessing |;

## collect new untracked jobs from per-file store ##
my $store = <[jobsite.job.load_all]>;

my @to_assess;
for my $job_id ( keys %{$store} ) {
    my $job = $store->{$job_id};
    next if ( $job->{'status'} // '' ) ne qw| new |;

    ## skip only if an active task is already in flight for this job ##
    my $existing = ( <jobsite.tasks>->{$job_id} // {} )->{'stage'} // '';
    next if $existing =~ m{^(?:queued|assessing|assessed|done)$};

    ## checksum dedup / blacklist check ##
    my $chk = <[jobsite.checksum.index]>->( qw| check |, $job );
    if ( $chk->{'is_blocked'} ) {
        <[base.logs]>->(
            2,       'job %s blocked by checksum index [%s]',
            $job_id, join( ', ', $chk->{'hits'}->@* )
        );

        ## backfill checksums if missing [ original  assessment may predate ##
        ## store ]                                                          ##
        my $need_add   = 0;
        my $store_root = catdir( <system.path.zenka-dirs.var_P7>,
            <system.zenka.name>, 'checksum-store' );
        for my $hit ( $chk->{'hits'}->@* ) {
            if ( $hit =~ m{^url:([A-Z2-7]+)$} ) {
                my $found = 0;
                if ( opendir my $udh, "$store_root/urls" ) {
                    for my $ep ( grep { !/^\./ } readdir($udh) ) {
                        if ( -e "$store_root/urls/$ep/$1" ) {
                            $found = 1;
                            last;
                        }
                    }
                    closedir $udh;
                }
                $need_add = 1 if not $found;
            }
        }
        <[jobsite.checksum.index]>->( qw| add |, $job ) if $need_add;

        ## write blocked stub and skip assessment ##
        my $blocked_job = {
            'id'            => $job_id,
            'url'           => $job->{'url'} // '',
            'status'        => qw| blocked |,
            'blocked_epoch' => <[base.ntime.epoch_timestamp]>,
            'checksum_hit'  => ( $chk->{'hits'}[0] // '' ),
        };
        <[jobsite.job.write]>->( $job_id, $blocked_job );

        ## job.write's rename-based cleanup trusts <jobsite.job.index> for  ##
        ## the old path, which can already point elsewhere if this id was   ##
        ## blocked under a different filename/epoch before (e.g. a          ##
        ## resurrected repost racing an index rebuild) -- that leaves this  ##
        ## 'new' copy orphaned, re-detected and re-"blocked" forever        ##
        ## without ever being removed.  we know for certain this file lives ##
        ## at new/<enc_id>.yaml since we just loaded it from there, so      ##
        ## remove it directly instead of trusting the index's single-slot   ##
        ## memory of the old location                                       ##
        my $enc_id   = <[base.vax-int.encode]>->($job_id);
        my $new_path = join( '/',
            <system.path.zenka-dirs>->{'var_P7'},
            qw| jobsite jobs new | )
            . "/$enc_id.yaml";
        unlink $new_path if -f $new_path;

        next;
    }

    ## description quality gate : catches a scrape/decode failure before it ##
    ## ever reaches the llm as a content-free prompt [ confirmed live -- an ##
    ## empty description let the model hallucinate a full assessment purely ##
    ## from the candidate profile it still had, describing an "ideal" job   ##
    ## that was really just its own profile reflected back ]. one refetch   ##
    ## is given the benefit of the doubt [ desc_refetch_attempted ], a      ##
    ## second failure is terminal -- otherwise a permanently-broken source  ##
    ## (layout change, dead listing) would retry forever on every dispatch  ##
    ## cycle                                                                ##
    my $quality = <[jobsite.util.description_ok]>->($job);
    if ( not $quality->{'ok'} ) {
        if ( $job->{'desc_refetch_attempted'} ) {
            <[base.logs]>->(
                0,
                'job %s description still bad after '
                    . 'refetch (%s), routing to review',
                $job_id,
                $quality->{'reason'}
            );
            ## 'review' [ not a dedicated 'error' status, and stage left   ##
            ## untouched ] : job.load_all's @active_statuses is a fixed    ##
            ## list that does not include an 'error' bucket -- a job filed ##
            ## there would vanish from the store [ and every downstream    ##
            ## view ] entirely. 'review' is already in that list and is    ##
            ## what jobsite.handler.repair-done routes its own terminal    ##
            ## failures to. stage is deliberately NOT set to 'review' here ##
            ## : that's the tab that's active by default, and seeding it   ##
            ## with a score-less, reason-less card is exactly the kind of  ##
            ## clutter this whole feature exists to prevent -- the         ##
            ## desc_check_failed flag [ see plugin.web.jobs.sync's         ##
            ## @pipeline_fields and the ui's 'fehler' tab filter, which    ##
            ## bypasses stage entirely ] is what actually surfaces it,     ##
            ## without touching the primary view                           ##
            my $failed_job = {
                %{$job},
                'desc_check_failed' => TRUE,
                'desc_check_reason' => $quality->{'reason'},
                'status'            => qw| review |,
            };
            <[jobsite.job.write]>->( $job_id, $failed_job );

            ## also patch the persistent store, not just disk :           ##
            ## job-upsert's preserve-on-reupsert whitelist reads          ##
            ## $data{'jobs'}{'store'} [ set once at init, never refreshed ##
            ## from a re-load ], NOT the fresh-from-disk $store local to  ##
            ## this loop -- a write that only hits job.write leaves that  ##
            ## global stale, so a future re-scrape of this same job would ##
            ## silently lose the flag                                     ##
            <jobs.store>->{$job_id} = $failed_job
                if ref <jobs.store> eq 'HASH';
            next;
        }

        <[base.logs]>->(
            1,       'job %s description looks bad (%s), refetching once',
            $job_id, $quality->{'reason'}
        );
        my $marked_job = { %{$job}, 'desc_refetch_attempted' => TRUE };
        <[jobsite.job.write]>->( $job_id, $marked_job );
        ## see the persistent-store note above -- same reason, same fix ##
        <jobs.store>->{$job_id} = $marked_job
            if ref <jobs.store> eq 'HASH';

        <jobsite.tasks>->{$job_id}{'awaiting_desc_refetch'} = TRUE;
        <[protocol-7.route-send]>->(
            {   'command'   => qw| site-yaml.import-url |,
                'call_args' => { 'args' => 'url=' . ( $job->{'url'} // '' ) },
                'reply'     => {
                    'handler' => qw| jobsite.handler.desc-refetch-queued |,
                    'params'  => { 'job_id' => $job_id },
                },
            }
        );
        next;
    }

    push @to_assess, $job_id;
}

if ( not @to_assess ) {
    if ($was_idle) {
        <[base.logs]>->( 1, '[idle] no new untracked jobs to assess.,' );
        <jobsite.cycle> = qw| idle |;
        <[jobsite.state.persist]>;
    }
    return;
}

<jobsite.cycle> = qw| assessing |;
<jobsite.pending_count>
    = ( <jobsite.pending_count> // 0 ) + scalar @to_assess;
<[jobsite.state.persist]>;

<[base.logs]>->(
    2,
    'queuing %d assessment tasks [ sequential ]',
    scalar @to_assess
);

## load candidate profile once
my $profile_file = <jobsite.cfg.profile_file>
    // '/etc/protocol-7/jobsite/profile.txt';
my $profile_text = '';
$profile_text = <[file.read]>->($profile_file)
    // 'no profile configured : score based on job listing alone';
$profile_text = Encode::decode( 'UTF-8', $profile_text )
    unless utf8::is_utf8($profile_text);

## build queue entries  queue_gen : bumped on every enqueue [ here and in   ##
## apply_reverse's reassess branch ] so dispatch.next can tell "still the   ##
## freshest queued instance of this job" from a stale duplicate left behind ##
## by a re-queue, uniformly for both fresh-new dispatch and reassess -- see ##
## dispatch.next for the other half of this contract                        ##
my @queue;
for my $job_id (@to_assess) {
    my $gen
        = 1 + ( ( <jobsite.tasks>->{$job_id} // {} )->{'queue_gen'} // 0 );
    <jobsite.tasks>->{$job_id}
        = { 'stage' => 'queued', 'task_id' => '', 'queue_gen' => $gen };

    ## initialize assertion tree for this job ##
    <[jobsite.assert.init]>->($job_id);

    my $prompt = <[jobsite.util.build_prompt]>->( $store->{$job_id} );

    push @queue, { 'job_id' => $job_id, 'desc' => $prompt, 'gen' => $gen };
}

## append : a batch may already be mid-flight with its own queue tail ##
<jobsite.assess_queue> //= [];
push <jobsite.assess_queue>->@*, @queue;

## dispatch first task only if nothing was already running -- an in-flight ##
## chain's own assess-done -> dispatch.next will pick up the appended      ##
## entries                                                                 ##
<[jobsite.dispatch.next]>
    if $was_idle;

return;

