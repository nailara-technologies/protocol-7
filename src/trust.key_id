## [:< ##

# name   = trust.key_id
# descr  = key id of an Ed25519 public key [ the host-root pin ]
# param  = <raw 32 byte public key>
# return = encode_b32r( bmw_384( key ) ) [ 77 chars ], undef if not valid

my $pub = shift;

return undef if not defined $pub or ref $pub;
return undef if not utf8::downgrade( $pub, 1 );
return undef if bytes::length($pub) != 32;

require Digest::BMW;

return Crypt::Misc::encode_b32r( Digest::BMW::bmw_384($pub) );

