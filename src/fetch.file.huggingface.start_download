## [:< ##

# name  = fetch.file.huggingface.start_download
# descr = issue the streaming clients.https request for a tracked
#         download entry [ used for the initial request and for
#         every redirect hop -- each fresh request truncates the
#         destination via its own stream_to_file open ]

my $dl_id = shift // '';

my $dl = <fetch.file.downloads>->{$dl_id};
return if !defined $dl;

my $url  = $dl->{'url'}  // '';
my $dest = $dl->{'dest'} // '';
return if !length($url) or !length($dest);

## authorization only when a token is configured [ gated repos ] ##
my $headers  = {};
my $hf_token = <fetch.file.hf_token> // <external.hf.token> // '';
$headers->{'authorization'} = "Bearer $hf_token" if length($hf_token);

## resume after a transfer error : ask for the rest, append to the partial ##
## [ set by huggingface.handler.download_response, sent on every hop ]     ##
my $resume_from = $dl->{'resume_from'} // 0;
$headers->{'range'} = "bytes=$resume_from-" if $resume_from > 0;

## thread the proxy explicitly, exactly like the previous aria2c            ##
## --all-proxy threading : clients.https does NOT auto-pickup http(s)_proxy ##
## env vars, and this host's outbound traffic goes through the configured   ##
## proxy for reliability                                                    ##
my $proxy = $ENV{'https_proxy'} // $ENV{'http_proxy'} // '';

<[clients.https.request]>->(
    {   'method'  => qw| GET |,
        'url'     => $url,
        'headers' => $headers,
        'proxy'   => $proxy,

        ## stall window, re-armed per received chunk                       ##
        ## [ clients.https. stall_reset ] -- a transfer making progress    ##
        ## never ages out, a stalled one dies after this long and restarts ##
        ## from scratch                                                    ##
        'timeout' => 120,

        'stream_to_file' => $dest,
        'stream_append'  => ( $resume_from > 0 ? TRUE : FALSE ),
        'on_done'        => qw| huggingface.handler.download_response |,
        'params'         => { 'dl_id' => $dl_id },
    }
);

return 0;

