## [:< ##

# name  = kimi.acp.raise_done
# descr = raise signal kimi.run.done through the events zenka
# param = state

## values carry no spaces [ the signal line splits on them ]. route-send ##
## only buffers : the answer comes to kimi.handler.acp_signal_reply      ##

my $state = shift // qw| unknown |;
my $st    = <[kimi.acp.state]>;
s{[^\w.-]}{_}g for $state;
my $session = ( $st->{'session_id'} // qw| none | ) =~ s{[^\w.:-]}{_}gr;

<[protocol-7.route-send]>->(
    {   'command'   => qw| events.signal |,
        'call_args' =>
            { 'args' => "kimi.run.done state=$state session=$session" },
        'reply' => {
            'handler' => qw| kimi.handler.acp_signal_reply |,
            'params'  => {}
        }
    }
);
return TRUE;

