## [:< ##

# name = events.handler.event_triggered

my $watcher    = shift->w;
my $event      = $watcher->data;
my $ev_id      = $event->{'id'};
my $ev_type    = $event->{'type'};
my $ev_data    = <events.setup>->{$ev_id};
my $event_name = $ev_data->{'name'};

## already-fired-this-slot guard [ NZ2 ] : one entry \ type \ second fires ##
## once, whatever timer duplicates a recalc left behind                    ##
my $slot      = int( $event->{'at'} // time );
my $fired_key = join qw| : |, $ev_id, $ev_type;
if ( ( <events.fired_slot>->{$fired_key} // -1 ) == $slot ) {
    <[base.logs]>->(
        1,
        "[IGNORED] event '%s' [%s] already fired for slot %d",
        $event_name // $ev_id,
        $ev_type, $slot
    );
    return;
}
<events.fired_slot>->{$fired_key} = $slot;

## enabled \ dependency checks and the action itself : events.fire, the ##
## action plugins [ plugin.events.action.* ] do the rest                ##
my $ran = <[events.fire]>->( { 'ev_id' => $ev_id, 'ev_type' => $ev_type } );
return if not $ran;

if ( $ev_type eq qw| at | or $ev_type eq qw| end | ) {
    delete <events.unix.timetable>->{$ev_id};
    <events.timer.recalc>->cancel if defined <events.timer.recalc>;
    <events.timer.recalc> = <[event.add_timer]>
        ->( { 'at' => time + 1, 'handler' => qw| events.recalc | } );
}

