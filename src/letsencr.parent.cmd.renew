## [:< ##

# name  = letsencr.parent.cmd.renew
# descr = run a renewal check now [ due certificates only ]

<[base.log]>->( 2, 'renew command received : running renewal check now' );

## same code path as the periodic timer [ due certificates only ] ##
<[letsencr.parent.handler_renewal_check]>->( {} );

return {
    mode => qw| true |,
    data => 'renewal check started',
};

