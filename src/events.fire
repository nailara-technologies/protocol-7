## [:< ##

# name  = events.fire
# descr = run the action of an entry through its plugin
# args   = { ev_id, ev_type [ at | start | end | signal ] [, entry ] }
#          entry = { name, action } : a bucket entry, which is not in the
#          static setup -- no enabled \ dependency check, the bucket did them
# return = TRUE when the action ran, FALSE when the entry was skipped
#          [ not enabled, dependencies unresolved, no such action ]
# an action that dies dies through here, as it did in the handler

my $fire    = shift;
my $ev_id   = $fire->{'ev_id'};
my $ev_type = $fire->{'ev_type'};

my $entry      = $fire->{'entry'};
my $ev_data    = defined $entry ? undef            : <events.setup>->{$ev_id};
my $event_name = defined $entry ? $entry->{'name'} : $ev_data->{'name'};
my $action     = defined $entry ? $entry->{'action'} : $ev_data->{'action'};
my $action_type = $action->{'type'};

if ( not defined $entry ) {
    if (   not defined <events.enabled>->{$event_name}
        or not <events.enabled>->{$event_name} ) {
        <[base.logs]>->(
            2, "[IGNORED] event '%s' not enabled in set-up", $event_name
        );
        return FALSE;
    }

    if ( defined $ev_data->{'dep_id'}
        and !<[dependency.ok]>->( $ev_data->{'dep_id'}, $ev_id ) ) {
        <[base.logs]>->(
            1, "[IGNORED] '%s' event [ unresolved dependencies ]", $event_name
        );
        return FALSE;
    } elsif ( defined $ev_data->{'dep_id'} ) {
        <[base.logs]>->(
            2, "[RUN] dependencies resolved [ event '%s' ]", $event_name
        );
    }
}

<[base.logs]>->( "<%s> '%s' [%s]", $action_type, $event_name, uc($ev_type) );

<events.stack.playlist>->{ $action->{'b32id'} }->{'action'}->{'type'}
    = $action_type
    if defined $action->{'b32id'};

my $plugin = <[events.plugin.registry]>->()->{'action'}{$action_type};
if ( not defined $plugin ) {
    <[base.logs]>->(
        0,           "<< event '%s' : no action plugin '%s' loaded >>",
        $event_name, $action_type
    );
    return FALSE;
}

$plugin->{'run'}->(
    {   'ev_id'   => $ev_id,
        'ev_type' => $ev_type,
        'name'    => $event_name,
        'action'  => $action,
        'signal'  => $fire->{'signal'}
    }
);

return TRUE;

