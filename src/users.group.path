## [:< ##

# name  = users.group.path
# param = <namespace> <group-name> [ <document> ]
# descr = keyword path of a group record document

my ( $namespace, $group_name, $document ) = @ARG;

return undef if not defined $namespace or $namespace !~ m{^(?:cube|web)$};
return undef
    if not defined $group_name
    or $group_name !~ m|^[a-z0-9][a-z0-9_.+-]{0,63}$|;

$document //= qw| details |;

return sprintf( qw| [USERS_HOST]/groups/%s/%s/%s.yaml |,
    $namespace, $group_name, $document );

