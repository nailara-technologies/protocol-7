## [:< ##

# name  = models.task.claim-record
# descr = claim record : timestamp, lease, last renewal
#         and the current coding instance, when known

## the lease from the claim reply : models renews within it     ##
## [ models.handler.task-touch ], 'touched' is the last renewal ##
my $lease  = shift;
my $record = { 'at' => time, 'touched' => time };
$record->{'lease'} = $lease if defined $lease and $lease =~ m|^\d+$|;

my $instance = <models.task.coding_instance> // '';
if ( length $instance ) {
    $record->{'owner_zenka'}    = qw| coding |;
    $record->{'owner_instance'} = $instance;
}

return $record;

