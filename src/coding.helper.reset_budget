## [:< ##

# name = coding.helper.reset_budget
# descr = reset budget for new session

my ($new_allocation) = @ARG;

my $old_total = <coding.budget.used>;

<coding.budget.allocated>     = $new_allocation // 12000;
<coding.budget.used>          = 0;
<coding.budget.session_start> = <[base.time]>;
<coding.budget.transactions>  = [];

return {
    success             => TRUE,
    previous_total_used => $old_total,
    new_allocation      => <coding.budget.allocated>,
    message             => "Budget reset for new session"
};

