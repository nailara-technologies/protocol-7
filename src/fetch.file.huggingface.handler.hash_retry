## [:< ##

# name  = fetch.file.huggingface.handler.hash_retry
# descr = retry timer trampoline for the expected-hash fetch

my $event = shift;
my $data  = eval { $event->w->data } // {};

<[huggingface.hash.fetch]>->(
    $data->{'dl_id'}   // '',
    $data->{'attempt'} // 1
);

return 0;

