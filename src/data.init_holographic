## [:< ##

# name  = data.init_holographic
# descr = Initialize holographic topology extensions for data zenka

<[base.log]>->( 2, "initializing holographic topology extensions" );

##[ REGISTER CORE ]###########################################################

my $mapper = <[devmod.cmd.get]>->('data.topology.interference.map');
<topology.interference.map> = $mapper;

$data{'get'} = <[devmod.cmd.get]>->('data.get');

##[ UNIFIED PHYSICS ]#########################################################

<unified.physics.electrical> = sub {
    my ( $position, $options ) = @ARG;
    $options //= {};
    $options->{'include_electrical'}  = 1;
    $options->{'include_holographic'} = 0;
    $options->{'include_magnetic'}    = 0;

    my $hash  = <[data.init_holographic.coordinate_to_hash]>->(@$position);
    my $field = <[data.topology.interference.map]>->( $hash, $options );

    return $field->{'unified'} // {};
};

<unified.physics.holographic> = sub {
    my ( $position, $options ) = @ARG;
    $options //= {};
    $options->{'include_electrical'}  = 0;
    $options->{'include_holographic'} = 1;
    $options->{'include_magnetic'}    = 0;

    my $hash  = <[data.init_holographic.coordinate_to_hash]>->(@$position);
    my $field = <[data.topology.interference.map]>->( $hash, $options );

    return {
        'interference' => $field->{'interference'},
        'workholes'    => $field->{'routing'}{'workholes'},
    };
};

<unified.physics.magnetic> = sub {
    my ( $position, $intent, $options ) = @ARG;
    $options //= {};
    $options->{'include_electrical'}  = 0;
    $options->{'include_holographic'} = 0;
    $options->{'include_magnetic'}    = 1;

    my $hash  = <[data.init_holographic.coordinate_to_hash]>->(@$position);
    my $field = <[data.topology.interference.map]>->( $hash, $options );

    my $trajectory
        = <[data.init_holographic.calculate_magnetic_trajectory]>->(
        $position, $field->{'routing'}{'next_hop'}, $intent
        );

    return {
        'trajectory' => $trajectory,
        'flux'       => $field->{'interference'}{'resonance_map'},
        'polarity'   =>
            <[data.init_holographic.determine_polarity]>->($position),
    };
};

<unified.physics.field> = sub {
    my ( $position, $options ) = @ARG;
    my $hash  = <[data.init_holographic.coordinate_to_hash]>->(@$position);
    my $field = <[data.topology.interference.map]>->( $hash, $options // {} );
    return $field->{'unified'};
};

##[ TOPOLOGY ACCESS ]#########################################################

<topology.resolve> = sub {
    my ( $x, $y, $z, $property ) = @ARG;
    my $hash = <[data.init_holographic.coordinate_to_hash]>->( $x, $y, $z );
    my $data = <[data.topology.interference.map]>->( $hash, {} );
    return $property ? $data->{$property} : $data;
};

##[ INTENT REGISTRY ]#########################################################

<intent.register> = sub {
    my ( $entity_id, $current_pos, $intent_pos, $phase ) = @ARG;

    my $ghost_key = sprintf( "intent:%s:%d:%d:%d",
        $entity_id, $intent_pos->[0], $intent_pos->[1], $intent_pos->[2] );

    <topology.ghosts>->{$ghost_key} = {
        'entity'    => $entity_id,
        'from'      => $current_pos,
        'to'        => $intent_pos,
        'phase'     => $phase,
        'timestamp' => <[base.ntime]>,
    };

    return $ghost_key;
};

<intent.query_at> = sub {
    my ($position) = @ARG;
    my @affecting;

    for my $ghost_key ( keys %{<topology.ghosts>} ) {
        my $ghost = <topology.ghosts>->{$ghost_key};
        if (<[data.init_holographic.position_in_intent_path]>->(
                $position, $ghost
            )
        ) {
            push @affecting, $ghost;
        }
    }

    return \@affecting;
};

##[ WORKHOLE REGISTRY ]#######################################################

<workhole.register> = sub {
    my ( $from_func, $to_func, $path_coords ) = @ARG;
    my $key = sprintf( "%s->%s", $from_func, $to_func );

    <topology.workholes>->{$key} = {
        'from_function' => $from_func,
        'to_function'   => $to_func,
        'path'          => $path_coords,
        'bandwidth'     =>
            <[data.init_holographic.calculate_workhole_bandwidth]>->(
            $path_coords),
    };

    return $key;
};

<workhole.find> = sub {
    my ($function) = @ARG;
    my @workholes;

    for my $key ( keys %{<topology.workholes>} ) {
        my $wh = <topology.workholes>->{$key};
        if (   $wh->{'from_function'} eq $function
            || $wh->{'to_function'} eq $function ) {
            push @workholes, $wh;
        }
    }

    return \@workholes;
};

<[base.log]>->( 2, "holographic topology extensions initialized" );

return 1;

