## [:< ##

# name  = nameserv.sync.full.replace
# descr = replace a zone's live records with a fetched full set
# param = $zone_name, $entries_aref -> TRUE | FALSE

my $zone_name = shift // '';
my $entries   = shift;

return FALSE if not length $zone_name;
return FALSE if ref $entries ne qw| ARRAY |;

my $zones = <nameserv.zones> //= {};

my $zone = $zones->{$zone_name} //= {
    records => [],
    serial  => time(),
    ttl     => <nameserv.cfg.default_ttl>,
};

my @live = ();
for my $entry (@$entries) {
    next if ref $entry ne qw| HASH |;
    next if lc( $entry->{'zone'} // '' ) ne $zone_name;
    next if $entry->{'deleted'};
    my $rec = {
        name  => lc( $entry->{'name'} // '' ),
        type  => uc( $entry->{'type'} // '' ),
        value => $entry->{'value'} // '',
        ts    => $entry->{'ts'}    // '',
    };
    $rec->{'ttl'} = $entry->{'ttl'}
        if ( $entry->{'ttl'} // 0 ) =~ m|^\d+$| and $entry->{'ttl'} > 0;
    push @live, $rec;
}

$zone->{'records'} = \@live;
$zone->{'serial'}  = time();

## live entries cancel tombstones of the same identity ##
for my $rec (@live) {
    <[nameserv.zone.tombstone.clear]>->( $zone_name, $rec );
}

<[nameserv.zone.save]>->($zone_name);
<[nameserv.event.emit]>->( 'data-changed', { 'zone' => $zone_name } );

return TRUE;

