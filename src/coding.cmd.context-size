## [:< ##

# name  = coding.cmd.context-size
# descr = return currently set context size in tokens

## prefer the actual n_ctx a running server was spawned with -- auto-calc  ##
## may expand it above the configured floor [ see spawn_inference_server ] ##
my $backend = $call->{'args'} // qw| gpu |;
$backend = qw| gpu | unless $backend =~ m{^(gpu|cpu)$}i;

my $server = ( <coding.inference_servers> // {} )->{$backend} // {};

return {
    'mode' => qw| true |,
    'data' => $server->{'n_ctx'} // <inference.model.context_length>
        // qw| undefined |
    }

