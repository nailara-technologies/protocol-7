# name  = plugin.usage.claude.refresh_retry
# descr = on_done target for a completed claude token refresh : schedules the
#         transparent single retry of the rate-limit probe, deferred one
#         event-loop tick rather than run synchronously inside the refresh
#         teardown -- same rationale as plugin.usage.kimi.refresh_retry :
#         starting a fresh https connection outside the fork's own call
#         stack is a cheap, standard mitigation for the utf8-handle crash
#         that module's note documents.
# note  = the deferral uses event.add_idle, NOT a plain timer : only the
#         add_idle handler branch forwards 'params' to the callback -- see
#         plugin.usage.kimi.refresh_retry's note for the live 2026-09-16
#         confirmation. named handler + params [ not a coderef closure ] so a
#         source reload between refresh start and completion still runs
#         current code.
# param = { on_result => <handler name>, params => <original query params> }

my $params = shift // {};

## the refresh cycle can end without a new token [ cli too slow to reach its
## oauth refresh before the timeout -- seen on the kimi side 2026-09-30 under
## critical memory pressure ]. claude's expiresAt is not trustworthy [ see
## plugin.usage.claude.refresh_watchdog ] -- the signal here is whether the
## credential file was REWRITTEN since the 401 [ refresh_since, from
## handler.response ]. if not : ONE more cycle with a longer timeout [ queues
## onto a running one ] before the retry.  bounded : attempt 2 always goes on
## to the retry
my $attempt  = $params->{'attempt'} // 1;
my $provider = <usage.provider.claude>;
my $home_dir = ( getpwuid($UID) )[7] // $ENV{'HOME'} // '';
my $mtime
    = length $home_dir
    ? ( CORE::stat( catfile( $home_dir, $provider->{'cred_rel'} ) ) )[9]
    : undef;
my $rewritten = defined $mtime
    && $mtime >= ( $params->{'refresh_since'} // time );

if ( !$rewritten and $attempt < 2 ) {
    <[base.logs]>->(
        1,
        'usage [ claude ] : refresh cycle ended without a '
            . 'rewritten credential, one more cycle before the retry ..,'
    );
    my $started = <[plugin.usage.claude.refresh_token]>->(
        $provider->{'refresh_timeout_retry'} // 30,
        {   'on_done' => {
                'handler' => qw| plugin.usage.claude.refresh_retry |,
                'params'  => { %$params, 'attempt' => $attempt + 1 },
            },
        }
    );
    return TRUE if $started;    ## on_done brings us back here ##
}

<[event.add_idle]>->(
    {   'handler' => qw| plugin.usage.claude.fetch |,
        'params'  => {
            'on_result' => $params->{'on_result'} // '',
            'params'    => $params->{'params'}    // {},
            'retried'   => TRUE,
        },
    }
);

return TRUE;

