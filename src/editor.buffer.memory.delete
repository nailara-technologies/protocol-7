## [:< ##

# name  = editor.buffer.memory.delete
# descr = delete CHARACTER range [start,end) from in-memory editor buffer

## char offsets, half-open [ $start, $end ) [ design: position_units ]. cursor
## inside the deleted range moves to $start ; cursor past the range shifts
## left by the deleted length.

my ( $buffer, $start, $end ) = @ARG;

return undef if ref $buffer ne qw| HASH |;
return undef if $buffer->{'readonly'};

my $buf_len = length $buffer->{'text'};
$start //= 0;
$end   //= $buf_len;
$start = 0        if $start < 0;
$end   = $buf_len if $end > $buf_len;
return TRUE if $end <= $start;

my $del_len = $end - $start;
substr( $buffer->{'text'}, $start, $del_len, '' );

## drop exactly the star-count entries of the deleted character range
splice @{ $buffer->{'mask_stars'} }, $start, $del_len
    if ( $buffer->{'type'} // '' ) eq qw| masked |
    and ref $buffer->{'mask_stars'} eq qw| ARRAY |;

if ( $buffer->{'cursor'} > $start ) {
    $buffer->{'cursor'} -= $del_len;
    $buffer->{'cursor'} = $start if $buffer->{'cursor'} < $start;
}

return TRUE;

