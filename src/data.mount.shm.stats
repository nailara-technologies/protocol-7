## [:< ##

# name = data.mount.shm.stats
# descr = Get statistics on SHM usage

my $pattern = shift // 'p7:M:*';

my $stats = {
    'segments'    => 0,
    'total_bytes' => 0,
    'by_owner'    => {},
};

my $shm_dir = '/dev/shm';
opendir( my $dh, $shm_dir ) or return undef;

while ( my $entry = readdir($dh) ) {
    next unless $entry =~ m{^p7:M:};

    my $path = "$shm_dir/$entry";
    next unless -f $path;

    my $size = -s $path;
    $stats->{'segments'}++;
    $stats->{'total_bytes'} += $size;

    # Extract owner from filename
    if ( $entry =~ m{^p7:M:([^:]+)} ) {
        my $owner = $1;
        $stats->{'by_owner'}{$owner} //= { 'count' => 0, 'bytes' => 0 };
        $stats->{'by_owner'}{$owner}{'count'}++;
        $stats->{'by_owner'}{$owner}{'bytes'} += $size;
    }
}

closedir($dh);

return $stats;

