# name  = coding.handler.spawn_path_reply
# descr = handle async reply from models.get_path_by_amos for spawn_with_deps

use YAML::XS qw| Load |;

my $reply   = shift;
my $params  = $reply->{'params'}   // {};
my $amos_id = $params->{'amos_id'} // '';
my $backend = $params->{'backend'} // 'gpu';

<[base.logs]>->(
    2, '[spawn_path_reply] received path reply for amos=%s', $amos_id
);

my $reply_data = $reply->{'data'} // '';

## check for error response
if ( $reply_data =~ m|^error:| ) {
    my ($err_line) = split( m|\n|, $reply_data );
    <[base.logs]>->(
        0, '[spawn_path_reply] model lookup failed: %s', $err_line
    );
    return FALSE;
}

## parse YAML response
my $entry;
eval { $entry = Load($reply_data) };
if ( $EVAL_ERROR || !ref($entry) ) {
    <[base.logs]>->(
        0, '[spawn_path_reply] YAML parse failed: %s',
        <[base.str.eval_error]>
    );
    return FALSE;
}

my $model_path  = $entry->{'file_path'}   // '';
my $mmproj_path = $entry->{'mmproj_path'} // '';

unless ( defined $model_path && length $model_path && -f $model_path ) {
    <[base.logs]>->(
        0, '[spawn_path_reply] invalid or missing model path: %s', $model_path
    );
    return FALSE;
}

<[base.logs]>->(
    1,        '[spawn_path_reply] spawning %s server with %s',
    $backend, $model_path
);

## determine binary based on backend
my $binary
    = $backend eq 'gpu'
    ? ( <inference.backend.gpu.binary>
        // '/data/source/ik_llama.cpp/llama-server-cuda-fa' )
    : ( <inference.backend.cpu.binary>
        // '/data/source/ik_llama.cpp/llama-server-cpu' );

## spawn the server (pass mmproj_path if available)
my $result = <[coding.spawn_inference_server]>->(
    {   backend     => $backend,
        model_path  => $model_path,
        mmproj_path => $mmproj_path,
        binary      => $binary,
        port        => $params->{'port'}
    }
);

return $result;

