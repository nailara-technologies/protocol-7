## [:< ##

# name  = v7-zenki.cmd.rotate-web-auth-secret
# param = [:force-now:] [:no-restart:]
# descr = new web.auth.secret in each host config with the
#         key, then restart those zenki
# note  = every web session ends : sessions keep the hash of the secret
#         they were made with [ plugin.web.auth.verify_session ] -- re-mint
#         ui and machine tokens afterwards [ web.auth-issue ]. the host
#         configs are root 0600 and the plugin reads the secret at init,
#         so a 'reload config' never sees it : the zenki restart. with
#         :no-restart: only the files change [ in effect at the next
#         restart ]. the secret itself is never logged or replied
#         live sessions : refused and listed unless :force-now: is given
#         [ todo : :when-gone: + session classes -- renewable tokens end
#         freely, interactive ones drain, hand-minted ones listed apart ]

my $args = $call->{'args'} // '';

my $no_restart = ( $args =~ s{\s*:no-restart:\s*}{ }g ) ? TRUE : FALSE;
my $force_now  = ( $args =~ s{\s*:force-now:\s*}{ }g )  ? TRUE : FALSE;
$args =~ s{^\s+|\s+$}{}g;
return {
    'mode' => qw| false |,
    'data' => 'usage : v7-zenki.rotate-web-auth-secret '
        . '[:force-now:] [:no-restart:]'
    }
    if length $args;

my $key_re = qr{^(\s*web\.auth\.secret\s*=\s*)\S.*$}m;

## host configs that already carry the key [ never adds it elsewhere ] ##
my $etc_dir = <system.path.zenka-dirs.etc_P7> // '/etc/protocol-7';
my %target;
foreach my $host_cfg ( sort glob "$etc_dir/*/host.cfg" ) {
    my ($zenka_name) = $host_cfg =~ m{/([\w.-]+)/host\.cfg$};
    next if not defined $zenka_name or -l $host_cfg or not -f $host_cfg;
    open( my $fh, '<:raw', $host_cfg ) or do {
        return {
            'mode' => qw| false |,
            'data' => "cannot read $host_cfg : $OS_ERROR [ nothing changed ]"
        };
    };
    my $content = do { local $INPUT_RECORD_SEPARATOR = undef; <$fh> };
    close($fh);
    my $count = () = $content =~ m{$key_re}g;
    next if not $count;
    return {
        'mode' => qw| false |,
        'data' => "$count web.auth.secret lines in $host_cfg "
            . '[ expected one, nothing changed ]'
        }
        if $count > 1;
    ## owner + mode to keep [ File::stat object : a list slice is undef ] ##
    my $stat = File::stat::stat($host_cfg);
    return {
        'mode' => qw| false |,
        'data' => "cannot stat $host_cfg : $OS_ERROR [ nothing changed ]"
        }
        if not defined $stat;
    $target{$zenka_name} = {
        'path'    => $host_cfg,
        'content' => $content,
        'mode'    => $stat->mode & 07777,
        'uid'     => $stat->uid,
        'gid'     => $stat->gid,
    };
}

return {
    'mode' => qw| false |,
    'data' => "no host config in $etc_dir carries web.auth.secret "
        . '[ nothing changed ]'
    }
    if not %target;

## sessions this ends [ by user, live ones only ] ##
my $session_dir = join qw| / |, <system.path.zenka-dirs.var_P7>,
    qw| shared web-auth active |;
my %ended;
foreach my $session_file ( glob "$session_dir/*/session.yaml" ) {
    open( my $fh, '<:raw', $session_file ) or next;
    my $yaml = do { local $INPUT_RECORD_SEPARATOR = undef; <$fh> };
    close($fh);
    my ($expires) = $yaml =~ m{^expires_at_epoch:\s*'?(\d+)}m;
    next if $expires and $expires < time;
    my ($user_id) = $yaml =~ m{^user_id:\s*'?([\w.+-]+)}m;
    $ended{ $user_id // '?' }++;
}

## live sessions end only on request ##
my $live_sum = 0;
$live_sum += $ARG foreach values %ended;
return {
    'mode' => qw| false |,
    'data' => sprintf(
        '%d live sessions [ %s ] would end : '
            . 'add :force-now: [ nothing changed ]',
        $live_sum, join( ', ', map {"$ARG $ended{$ARG}"} sort keys %ended )
    )
    }
    if $live_sum and not $force_now;

## one new secret, written to every target [ temp file + rename ] ##
require Fcntl;
my $secret = <[base.prng.chars-anum]>->(64);

foreach my $zenka_name ( sort keys %target ) {
    my $host_cfg = $target{$zenka_name}->{'path'};
    ( my $content = $target{$zenka_name}->{'content'} )
        =~ s{$key_re}{$1$secret};
    my ( $mode, $uid, $gid )
        = @{ $target{$zenka_name} }{qw| mode uid gid |};
    my $tmp_file = sprintf '%s.rotate-%d', $host_cfg, $PID;
    my $written  = FALSE;
    if (sysopen(
            my $fh,
            $tmp_file,
            Fcntl::O_WRONLY() | Fcntl::O_CREAT() | Fcntl::O_EXCL()
                | Fcntl::O_NOFOLLOW(),
            0600
        )
    ) {
        $written = ( print {$fh} $content ) && close($fh);
        $written
            &&= chown( $uid, $gid, $tmp_file )
            && chmod( $mode, $tmp_file )
            && rename( $tmp_file, $host_cfg );
    }
    if ( not $written ) {
        my $error = "$OS_ERROR";
        unlink $tmp_file;
        my @done = grep { $target{$ARG}->{'done'} } sort keys %target;
        <[base.logs]>->(
            0,         '<< web.auth.secret rotation FAILED at %s : %s >>',
            $host_cfg, $error
        );
        return {
            'mode' => qw| false |,
            'data' => "writing $host_cfg failed : $error"
                . (
                @done
                ? ' [ ALREADY ROTATED : '
                    . join( ' ', @done )
                    . ' -- secrets now differ, run the rotation again ]'
                : ' [ nothing changed ]'
                )
        };
    }
    $target{$zenka_name}->{'done'} = TRUE;
}

## read back : one value in every file ##
my %seen;
foreach my $zenka_name ( sort keys %target ) {
    open( my $fh, '<:raw', $target{$zenka_name}->{'path'} ) or next;
    my $content = do { local $INPUT_RECORD_SEPARATOR = undef; <$fh> };
    close($fh);
    $seen{$2}++ if $content =~ m{^(\s*web\.auth\.secret\s*=\s*)(\S+)\s*$}m;
}
my $consistent = ( keys %seen == 1 and exists $seen{$secret} );
undef $secret;

my @zenki = sort keys %target;
<[base.logs]>->(
    0,
    '<< web.auth.secret rotated : %s >>',
    join( ' ', @zenki )
);

## restart the zenki that read it ##
my @restarted;
if ( not $no_restart and $consistent ) {
    foreach my $zenka_name (@zenki) {
        my $zenka_id = <[zenka.get_id]>->($zenka_name);
        next if not defined $zenka_id;
        foreach my $instance_id (<[v7-zenki.instance_ids]>) {
            next
                if <v7-zenki.zenka.instance>->{$instance_id}->{'zenka_id'}
                != $zenka_id;
            <[zenka.instance.restart]>->($instance_id);
            push @restarted, $zenka_name;
        }
    }
}

my $ended_sum = 0;
$ended_sum += $ARG foreach values %ended;

## several lines : 'data' mode [ 'false' carries one line ] ##
my @report = (
    sprintf(
        'web.auth.secret rotated in %d host configs : %s',
        scalar @zenki,
        join( ' ', @zenki )
    ),
    (   $consistent ? 'read back : one value in every file'
        : 'read back : VALUES DIFFER -- run the rotation again'
    ),
    sprintf(
        'live sessions ended : %d%s',
        $ended_sum,
        $ended_sum
        ? ' [ '
            . join( ', ', map {"$ARG $ended{$ARG}"} sort keys %ended )
            . ' ] -- re-mint with web.auth-issue'
        : ''
    ),
    (   $no_restart
        ? 'not restarted [ :no-restart: ] : the old '
            . 'secret stays in use until the next restart'
        : @restarted  ? 'restarted : ' . join( ' ', @restarted )
        : $consistent ? 'restarted : none running'
        :               'not restarted'
    )
);

return { 'mode' => qw| false |, 'data' => join ' ; ', @report }
    if not $consistent;

return { 'mode' => qw| data |, 'data' => join( "\n", @report ) . "\n" };

