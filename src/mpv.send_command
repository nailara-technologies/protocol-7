## [:< ##

# name = mpv.send_command
# descr = send JSON IPC command to mpv [ buffered until ready ]

return <[base.log]>->( 0, 'no command defined' ) if not @ARG;

<mpv.request_id_seq> = ( <mpv.request_id_seq> // 0 ) + 1;
my $request_id = <mpv.request_id_seq>;

my $json_string = <[mpv.json.command]>->( $request_id, @ARG );

<[base.logs]>->( 2, '<send_command> %s', $json_string );

## claim whatever reply bookkeeping the caller just registered [always      ##
## synchronous -- no other command call can interleave between the caller's ##
## push and this line] and re-file it under $request_id, so                 ##
## mpv.handler.pipe_output can match replies by id instead of arrival       ##
## order. a single dropped, deferred, or reordered reply used to            ##
## permanently desync the old shift()-based FIFO matching.,                 ##
if (   ( <mpv.reply_ids> and <mpv.reply_ids>->@* )
    or ( <mpv.command.reply> and <mpv.command.reply>->@* ) ) {
    <mpv.pending_reply>->{$request_id} = {
        'reply_id' => ( <mpv.reply_ids> and <mpv.reply_ids>->@* )
        ? pop <mpv.reply_ids>->@*
        : undef,
        'reply_setup' => ( <mpv.command.reply> and <mpv.command.reply>->@* )
        ? pop <mpv.command.reply>->@*
        : undef,
        'success_reply_str' => delete <mpv.success_reply_str>,
    };
}

## player not ready yet -- buffer in arrival order and replay as one batch ##
## once the socket opens [ see mpv.startup.handler.socket_ready ].  a      ##
## jobqueue job per command used to be spun up here instead: correct, but  ##
## each one carries a full job id, priority slot, and dependency tracking  ##
## entry for what is really just "write these bytes once ready" — a plain  ##
## ordered buffer says the same thing without the per-command jobqueue     ##
## bookkeeping and log noise.,                                             ##
if ( not defined <mpv.socket> ) {
    <[base.log]>->(
        2, '[send_command] player not ' . 'ready — buffering command'
    );
    push @{ <mpv.pending_commands> //= [] }, $json_string;
    return;
}

<[base.s_write]>->( <mpv.socket>, $json_string );

