# name  = space.search.util.fallback_resonance
# descr = compute fallback resonance score for a node

my $node_id   = shift;
my $passages  = <space.orbit.passages>->{$node_id} // [];
my $ref_count = scalar @$passages;
my $harmonic  = FALSE;
eval { $harmonic = AMOS7::Assert::Truth::is_true($node_id) ? TRUE : FALSE; };
my $node        = <space.grid.nodes>->{$node_id} // {};
my $shell       = $node->{'shell'}               // 1;
my $shell_bonus = 1 / ( $shell > 0 ? $shell : 1 );
return $ref_count * ( $harmonic ? 2 : 1 ) * $shell_bonus;

