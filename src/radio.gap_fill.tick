## [:< ##

# name  = radio.gap_fill.tick
# descr = idle watcher: push gap-fill audio chunk to listeners

my $event = shift->w;

##  stop if jingle ended (new real track playing)  ##
if ( not <radio.stream.icy>->{'is_jingle'} ) {
    CORE::close( delete <radio.gap_fill.fh> ) if <radio.gap_fill.fh>;
    <radio.gap_fill.active> = 0;
    $event->cancel;
    delete <radio.gap_fill.watcher>;
    <[base.logs]>->( 2, '[radio] gap filler: stopped [ track resumed ]' );

    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
    <[base.buffer.add_line]>->(
        qw| radio-jingle |,
        join( ' ', $time_stamp, 2, 'gap fill ended' ), 2
    );
    return;
}

##  read one chunk from gap-fill file  ##
my $chunk = '';
my $n     = read( <radio.gap_fill.fh>, $chunk, 16384 );

if ( not defined $n or $n == 0 ) {    ##  EOF  ##
    CORE::close( delete <radio.gap_fill.fh> );
    <radio.gap_fill.active> = 0;
    $event->cancel;
    delete <radio.gap_fill.watcher>;
    <[base.logs]>->( 2, '[radio] gap filler: file ended' );

    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
    <[base.buffer.add_line]>->(
        qw| radio-jingle |,
        join( ' ', $time_stamp, 2, 'gap fill ended' ), 2
    );

    ##  optionally restart with another file  ##
    <[radio.gap_fill.start]> if <radio.stream.icy>->{'is_jingle'};
    return;
}

##  push to listeners  ##
my $before = scalar <radio.listeners>->@*;
my @keep;
for my $h ( <radio.listeners>->@* ) {
    if ( <[base.stream.push]>->( $h, \$chunk ) ) {
        push @keep, $h;
    } else {
        <[base.stream.close]>->($h);  ## clean up base-level producer state ##
    }
}
my $after = scalar @keep;
if ( $after < $before ) {
    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
    <[base.buffer.add_line]>->(
        qw| radio-stream |,
        join( ' ', $time_stamp, 2, "listener removed :. $after" ), 2
    );
}
<radio.listeners> = \@keep;

