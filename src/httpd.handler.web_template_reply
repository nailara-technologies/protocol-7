# name  = httpd.handler.web_template_reply
# descr = handle reply from web zenka for template processing

my $reply_data = shift;

my $client_sid  = $reply_data->{'params'}{'client_sid'};
my $template_id = $reply_data->{'params'}{'template_id'};
my $mode        = lc( $reply_data->{'cmd'} // '' );  ## Normalize to lowercase
my $reply_content = $reply_data->{'data'};

unless ( defined $data{'session'}{$client_sid} ) {
    <[base.logs]>->(
        1,           "[%s] template reply : session gone [ %s ]",
        $client_sid, $template_id
    );
    return 0;
}

my $session = $data{'session'}{$client_sid};

<[base.logs]>->(
    2, "[%s] template reply for %s [ %s, %d bytes ]",
    $client_sid, $template_id, $mode,
    defined $reply_content ? length($reply_content) : 0
);

if ( $mode eq 'size' ) {
    ## SUCCESS: Web zenka returned processed content ##

    my $content = $reply_content;

    ## check for template-set content-type override  format: ##
    ## "content-type:mime/type\n\ncontent..."                ##
    if ( $content =~ s|^content-type:([\w\-]+/[\w\-+.]+)\n\n||s ) {
        $session->{'content'}->{'type'} = $1;
    }

    my $content_length  = length($content);
    my $content_type    = $session->{'content'}->{'type'} // 'text/html';
    my $content_date    = $session->{'content'}->{'date'} // time2str(time);
    my $response_params = $session->{'response'}->{'params'} // {};

    <[base.logs]>->(
        2, "[%s] template complete : %s [ %s, %d bytes ]",
        $client_sid, $template_id, $content_type, $content_length
    );

    ## build http response header ##
    my $header = <[httpd.new_header]>->(
        200,
        {   'Content-Type'   => $content_type,
            'Last-Modified'  => $content_date,
            'Content-Length' => $content_length,
            'Connection'     => $session->{'http'}->{'close'}
            ? 'close'
            : 'keep-alive',
            'Accept-Ranges' => 'bytes',
            %{$response_params}
        }
    );

    ## append body only for non-HEAD requests ##
    my $method = $session->{'http'}->{'request'}->{'method'} // '';
    if ( uc($method) eq qw| HEAD | ) {
        $session->{'buffer'}->{'output'} .= $header;
    } else {
        $session->{'buffer'}->{'output'} .= $header . $content;
    }

    ## Mark content as complete ##
    $session->{'content'}->{'complete'} = 1;

    ## Trigger output flush ##
    if ( $session->{'http'}->{'close'} ) {
        $session->{'flush_shutdown'} = 1;
    } else {
        $session->{'flush'} = 1;
    }

} elsif ( $mode eq qw| false | ) {
    ## ERROR: Web zenka failed to process template ##

    my $error_message = $reply_content // 'unknown error';

    <[base.logs]>->(
        0, "[%s] template failed : %s [ %s ]",
        $client_sid, $template_id, $error_message
    );

    ## Send 500 Internal Server Error ##
    <[httpd.send_error_page]>->( $client_sid, 500 );
    $session->{'flush_shutdown'} = 1;

} elsif ( $mode eq qw| true | ) {
    ## Unexpected TRUE response without data ##
    <[base.logs]>->(
        1,           "[%s] template : unexpected TRUE reply for %s",
        $client_sid, $template_id
    );

    ## Send 500 Internal Server Error ##
    <[httpd.send_error_page]>->( $client_sid, 500 );
    $session->{'flush_shutdown'} = 1;

} else {
    ## Unknown response mode ##
    <[base.logs]>->(
        0, "[%s] template : unknown reply mode '%s' for %s",
        $client_sid, $mode, $template_id
    );

    ## Send 500 Internal Server Error ##
    <[httpd.send_error_page]>->( $client_sid, 500 );
    $session->{'flush_shutdown'} = 1;
}

return 0;

