## [:< ##

# name  = memory.status.provider.branch_count
# descr = status provider : visible / total branch count [ fallback floor ]

my $ctx = shift // {};

my $visible = $ctx->{'visible'} // 0;
my $total   = $ctx->{'total'}   // 0;
my $width   = $ctx->{'width'}   // 23;

my $text = sprintf( '%d of %d branches', $visible, $total );

## [ pad / truncate to the fixed slot width so the border never jitters ]##
$text = substr( $text, 0, $width ) if length $text > $width;
$text = sprintf( '%-*s', $width, $text );

## [ low constant interest : the always-available fallback ]##
return { value => $text, label => 'branches', interest => 0.05 };

