## [:< ##

# name  = events.bucket.path
# descr = where a bucket \ the bucket journal lives
# args   = owner zenka, or nothing for the journal
# return = path ; the directory is <events.bucket_dir> or the var dir of the
#          events zenka [ one file per bucket : bucket.<owner> ]

my $owner = shift;
my $dir   = <events.bucket_dir>
    // sprintf qw| %s/events |,
    <system.path.zenka-dirs.var_P7> // qw| /var/protocol-7 |;
return defined $owner ? "$dir/bucket/$owner.bucket" : "$dir/bucket.journal";

