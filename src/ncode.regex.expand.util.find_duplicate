# name  = ncode.regex.expand.util.find_duplicate
# descr = find duplicate pattern by exact pattern string match

my ( $pattern, $patterns ) = @ARG;

foreach my $name ( keys %$patterns ) {
    my $existing = $patterns->{$name};
    if ( $existing->{'pattern'} eq $pattern ) {
        return $name;
    }
}
return undef;

