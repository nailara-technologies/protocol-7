## [:< ##

# name  = letsencr.child.acme.key_authorization
# param = <token>
# descr = http-01 key authorization and dns-01 txt value

my $token = shift // return undef;

my $jwk = <[letsencr.child.get_jwk]> // return undef;

## rfc 7638 thumbprint : canonical json of the public jwk ##
my $thumbprint
    = encode_base64url( sha256( JSON::XS->new->canonical(1)->encode($jwk) ) );

my $key_auth = join qw| . |, $token, $thumbprint;

return {
    'key_auth'  => $key_auth,
    'dns_value' => encode_base64url( sha256($key_auth) ),
};

