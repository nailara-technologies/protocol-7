## [:< ##

# name  = base.sig_chld

<[base.log]>->( 2, 'SIGCHLD received. collecting children ..,' );
local ( $OS_ERROR, $CHILD_ERROR );
while ( ( my $pid = <[base.waitpid]>->(-1) ) > 0 ) {    ##  WNOHANG  ##

    <[base.logs]>->(
        2,    "cleaning up child pid %s [ exit code : %d ]..,",
        $pid, $CHILD_ERROR
    );
    ## whoever watches child exits [ system.watch ] reads it from here ##
    <base.child_exit>->{$pid} = $CHILD_ERROR
        if ref <base.child_exit> eq qw| HASH |;
}

