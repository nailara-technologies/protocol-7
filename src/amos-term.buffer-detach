## [:< ##

# name  = amos-term.buffer-detach
# descr = Detach client from buffer

my $attach_id = shift;

return undef unless defined $attach_id;

## === find attachment === ##
my $attach = <amos-term.buffer-attachments>->{$attach_id};
return undef unless defined $attach;

my $buffer_id = $attach->{'buffer_id'};
my $window    = <amos-term.windows.by_id>->{$buffer_id};

## === remove from window's attachment list === ##
if ( defined $window and defined $window->{'attachments'} ) {
    $window->{'attachments'}
        = [ grep { $_ ne $attach_id } $window->{'attachments'}->@* ];
}

## === remove from global registry === ##
delete <amos-term.buffer-attachments>->{$attach_id};

<[base.logs]>->( 2, "[buffer] detached %s", $attach_id );

return TRUE;

