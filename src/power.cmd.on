## [:< ##

# name  = power.cmd.on
# descr = switch on a single socket [1..outlets]
# param = <id> <s-num>

<power.cfg.devices> //= {};
my ( $device_id, $sock_num ) = split( m| +|, $call->{'args'} );

return { 'mode' => qw| false |, 'data' => 'numerical device id expected' }
    if !length($device_id)
    or $device_id !~ m|\d+|;

return {
    'mode' => qw| false |,
    'data' => "device '$device_id' does not exist"
    }
    if not exists <power.cfg.devices>->{$device_id};

return {
    'mode' => qw| false |,
    'data' => 'power socket number expected [1..outlets]'
    }
    if not defined $sock_num or $sock_num !~ m|^[1-9]\d*$|;

my $index      = $sock_num - 1;
my @set_states = (undef) x $index;
push @set_states, 1;

## set_states dies when the socket number exceeds the outlets of the driver ##
my @states = eval { <[power.set_states]>->( $device_id, @set_states ) };

return { 'mode' => qw| false |, 'data' => "socket $sock_num out of range" }
    if $EVAL_ERROR =~ m|^expected at most|;
die $EVAL_ERROR if length $EVAL_ERROR;

my $new_state = $states[$index];

if ( not defined $new_state ) {
    <[protocol-7.command.send.local]>->(
        {   'command'   => "cube.power-x11.set_states",
            'call_args' => {
                'args' => join( ' ', $device_id, <power.last_states>->@* )
            }
        }
    ) if defined <power.last_states>;
    return { 'mode' => qw| FALSE |, 'data' => 'connection to device failed' };
}

if ( $new_state ne '1' ) {
    my $err_msg = 'unable to retrieve new socket state';
    $err_msg = 'unable to set socket state to \'ON\'' if $new_state eq '0';
    return { 'mode' => qw| FALSE |, 'data' => $err_msg };
}

<[protocol-7.command.send.local]>->(
    {   'command'   => "cube.power-x11.set_states",
        'call_args' => { 'args' => join( ' ', $device_id, @states ) }
    }
);

return { 'mode' => qw| TRUE |, 'data' => "socket $sock_num switched ON" }

