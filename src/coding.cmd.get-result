## [:< ##

# name  = coding.cmd.get-result
# descr = fetch result of a completed coding task
# param = <task_id>

my $task_id = $call->{'args'} // '';

return { 'mode' => qw| false |, 'data' => 'task_id required' }
    if !length($task_id);

# Look up task in queue
my $task = <coding.task.queue>->{$task_id};

## not in memory : check disk (survives idle shutdown) ##
if ( !defined $task ) {
    my $result_sref
        = <[file.zenka_dir.load]>->( "results/$task_id", ':encoding(UTF-8)' );
    if ( defined $result_sref ) {
        my $result   = $result_sref->$* // '';
        my $stripped = $result;
        $stripped =~ s|\n$||;
        my $newlines = ( $stripped =~ tr/\n// );
        if ( $newlines == 0 ) {
            $result =~ s|\n$||;
            return { 'mode' => qw| true |, 'data' => $result };
        } else {
            $result .= "\n" if $result !~ m|\n$|;
            return { 'mode' => qw| size |, 'data' => $result };
        }
    }
    return { 'mode' => qw| false |, 'data' => "task not found: $task_id" };
}

my $status = $task->{'execution'}->{'status'} // 'unknown';

# Return based on task status
if ( $status eq 'completed' ) {
    my $result = $task->{'execution'}->{'result'} // '';
    my $review = $task->{'execution'}->{'review'};
    if ( ref $review eq qw| HASH | and $review->{'verdict'} ne qw| pending | )
    {
        $result .= "\n\n[ review verdict : $review->{'verdict'} ]";
        $result .= "\n[ review defects ]\n$review->{'defects'}"
            if length $review->{'defects'} // '';
    }

    ## empty result means task produced no output ##
    return {
        'mode' => qw| false |,
        'data' => 'task completed with empty result'
        }
        unless length $result;

    # Determine reply mode based on internal newlines
    my $stripped = $result;
    $stripped =~ s|\n$||;
    my $newlines = ( $stripped =~ tr/\n// );

    if ( $newlines == 0 ) {
        $result =~ s|\n$||;
        return { 'mode' => qw| true |, 'data' => $result };
    } else {
        $result .= "\n" if $result !~ m|\n$|;
        return { 'mode' => qw| size |, 'data' => $result };
    }
} elsif ( $status eq 'failed' || $status eq 'error' ) {
    my $error = $task->{'execution'}->{'error'} // 'unknown error';
    return { 'mode' => qw| false |, 'data' => $error };
} elsif ( $status eq 'in_progress' || $status eq 'pending' ) {
    return {
        'mode' => qw| true |,
        'data' => "task $task_id is still $status"
    };
} else {
    return {
        'mode' => qw| true |,
        'data' => "task $task_id status: $status"
    };
}

