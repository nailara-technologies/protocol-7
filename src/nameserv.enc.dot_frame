## [:< ##

# name  = nameserv.enc.dot_frame
# param = <dns wire>
# descr = dns over tls message framing [ rfc 7858 : 2 byte length prefix ]

my $wire = shift // return undef;
return undef if length $wire > 65535;
return pack( qw| n |, length $wire ) . $wire;

