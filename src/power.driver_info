## [:< ##

# name  = power.driver_info
# descr = static facts about a power driver [ perl module, deps profile ]
# param = ( $driver ) -> { module => name or undef, profile => name or undef }

my $driver = shift // '';

## a driver needing nothing beyond core perl has neither module nor profile ##
my %info = (
    'gembird' => {
        'module'  => qw| Device::Gembird |,
        'profile' => qw| power-gembird |
    },
    ## wol sends with core perl ; its state check uses Net::Oping ##
    'wol' => {
        'module'  => qw| Net::Oping |,
        'profile' => qw| power-reach |
    },
);

return $info{$driver} // { 'module' => undef, 'profile' => undef };

