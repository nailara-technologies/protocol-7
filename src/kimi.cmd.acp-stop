## [:< ##

# name  = kimi.cmd.acp-stop
# descr = stop the kimi acp session [ the stored id is kept ]

return { 'mode' => qw| false |, 'data' => 'not running' }
    if not <[kimi.acp.stop]>;
return { 'mode' => qw| true |, 'data' => 'stopping' };

