## [:< ##

# name  = X-11.cmd.get-windows
# param = [pattern]
# descr = list mapped windows with XID and title

my $pattern = $call->{'args'};

<[X-11.WM.update]>;

my $reply_msg = '';
for my $win ( <X-11.WM>->sorted->@* ) {

    my $title    = <[base.utf8.sanitize]>->( $win->title    // '' );
    my $instance = <[base.utf8.sanitize]>->( $win->instance // '' );

    next
        if defined $pattern
        and index( $instance, $pattern ) == -1
        and index( $title,    $pattern ) == -1;

    $reply_msg .= sprintf( "%d %s\n", $win->id, $title );
}

return {
    'mode' => qw| false |,
    'data' => sprintf( "no match for '%s'", $pattern )
    }
    if defined $pattern and not length $reply_msg;

return { 'mode' => qw| size |, 'data' => $reply_msg };

