# name  = protocol.protocol-7.pre_init

if ( <[base.is_defined_recursive]>->(qw| system.p7.ext-proto-ver |)
    and index( <system.p7.ext-proto-ver>, '\\', 0 ) != 0 ) {
    <[base.parser.protocol-version]>->(<system.p7.ext-proto-ver>);
}

## load updated value if present ##
##
<[base.config.load_proto_7_version]>;

0;

