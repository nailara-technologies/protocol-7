# name  = screenshot.cmd.return-region-color
# param = <X1> <Y1> <X2> <Y2>
# descr = return average color for given region

my $param_str = $call->{'args'} // '';
return {
    'mode' => qw| false |,
    'data' => 'expected valid region coordinates'
    }
    if $param_str !~ m|^(\d+ +){3}\d+$|;
my @coords = ( split( m| +|, $param_str ) );

if (<screenshot.cfg.use_powershell_passthrough>) {
    <[screenshot.powershell_passthrough.request]>->(
        $call, 'return_region_color', \@coords
    );
    return { 'mode' => qw| deferred | };
}

my $err_str;

my $img = <[screenshot.grab_region]>->(@coords);
$err_str = $img if ref($img) ne qw| Imager |;

$img     = <[screenshot.scale_image]>->( $img, 1, 1 ) if not defined $err_str;
$err_str = $img
    if not defined $err_str
    and ref($img) ne qw| Imager |;

my @RGB = <[screenshot.pixel_color]>->( $img, 0, 0 );
$err_str = shift @RGB if @RGB == 1;

return {
    'mode' => qw| false |,
    'data' => "unable to acquire region color [ $err_str ]"
    }
    if defined $err_str;

pop(@RGB);    # removing alpha

return { 'mode' => qw| true |, 'data' => sprintf( '#%02X%02X%02X', @RGB ) };

