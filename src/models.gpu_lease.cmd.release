## [:< ##

# name  = models.gpu_lease.cmd.release
# descr = release the gpu residency lease

my ($owner) = split m|\s+|, $call->{'args'} // '';
return {
    'mode' => <[models.gpu_lease.release]>->( $owner // '' )
    ? qw| true |
    : qw| false |
};

