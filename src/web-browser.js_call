## [:< ##

# name  = web-browser.js_call
# descr = run javascript on a web-browser view with callback

my $js_string       = shift // '';
my $result_callback = shift
    // sub { warn "<js_call> invoked empty callback." };
my $re_cb_params = shift;    # no params [default] undef
my $target_view  = shift;    # optional explicit view id

my $caller_sub_name = [caller]->[1];

my $fg_index   = <web-browser.overlay.index>->{'fg'};
my $view_index = defined $target_view ? $target_view : $fg_index;
my $view       = <web-browser.gtk_obj.view>->{$view_index};

return warn "<js_call> target view $view_index is not available"
    if !defined $view;

my $settings = $view->get_settings();
my $view_uri = $view->get_uri();

return warn "<<!>> javascript execution is disabled <<!>>"
    if !$settings->get_enable_javascript();

if ( $caller_sub_name eq 'web-browser.callback.scroll_start_js_exec' ) {
    <[base.log]>->( 2, ".. checking if scrollable ..," );
} elsif ( $caller_sub_name eq 'web-browser.handler.auto_scroll' ) {

    # LLL: log periodically the current scroll progress percentage ..,

} else {
    <[base.log]>->( 2, "<js_call> [$view_uri] : '$js_string'" );
}

$view->evaluate_javascript(
    $js_string,
    -1,       ## length: -1 = null-terminated string
    undef,    ## world_name: default world
    undef,    ## source_uri
    undef,    ## cancellable
    sub {
        my ( $view, $result ) = @_;
        my $result_str = '';
        my $jsc_value  = eval { $view->evaluate_javascript_finish($result) };

        if ($@) {
            ( my $ex_str = $@ ) =~ s| at /usr/.+\n$||;
            $ex_str =~ s|^[^ ]+ ||;
            my $has_err = $ex_str =~ m|^[^:]*Error[^:]*:| ? 1 : 0;
            <[base.log]>->(
                0,              sprintf '<!JSerr!> [%s] %s',
                $view->get_uri, $ex_str
            ) if $has_err;
            $result_str = $ex_str;
        } elsif ( defined $jsc_value ) {
            $result_str = $jsc_value->to_string;
        }

        $result_callback->( $result_str, $re_cb_params )
            if defined $result_callback;
    },
    undef    ## user_data
);

