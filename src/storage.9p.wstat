## [:< ##
# name  = storage.9p.wstat
# descr = Send a Twstat (rename/resize) request to 9P server

my ( $conn, $fid, $stat_fields ) = @ARG;
$stat_fields //= {};

my $tag = ++$conn->{tag} & 0xFFFF;

my $req = <[plan-9.protocol.codec.encode-uint32]>->($fid)
    . <[plan-9.protocol.codec.encode-wstat]>->($stat_fields);

my $msg = <[plan-9.protocol.codec.encode-message]>->(
    <plan-9.protocol.constants.Twstat>,
    $tag, $req
);

$conn->{socket}->send($msg);

return <[storage.9p.read-message]>->( $conn, $tag );

