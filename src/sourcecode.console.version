## [:< ##

# name  = sourcecode.console.version
# descr = return current protocol-7 sourcecode version

## 'version :' compacts to 'version:' in both lines when either line would ##
## pass 78 columns [ longer version strings later ]                        ##
my @line = (
    sprintf( ':/ /   protocol-7 source code version : %s',
        <protocol-7.src-ver> ),
    sprintf( ':_/ .: AMOS7 base software release version : %s',
        <protocol-7.rel-ver> )
);
if ( grep { length $ARG > 78 } @line ) {
    s|version :|version:| for @line;
}

printf( ".____\n:__ / .\n%s\n%s\n:\n", @line );

