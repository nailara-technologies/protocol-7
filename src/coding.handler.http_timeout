## [:< ##

# name  = coding.handler.http_timeout
# descr = Handle HTTP request timeout
# purpose = Clean up and report timeout error

my $event     = shift->w;
my $data      = $event->data;
my $state     = $data->{'state'};
my $callbacks = $state->{'callbacks'};

## skip if already completed [ timer event queued before cleanup ] ##
if ( $state->{'completed'} || !defined $state->{'sock'} ) {
    <[base.logs]>
        ->( 2, "async.http_timeout: skipping [ already completed ]" );
    return;
}

my $ceiling_used = $callbacks->{'timeout'}
    // <coding.http-timeouts.request-completed> // 780;
my $hard_ceiling = <coding.http-timeouts.request-completed> // 780;

## diagnostic only : this fires unconditionally before the stream-alive     ##
## check below decides soft-extend vs. genuine failure, and the soft-       ##
## extend case is the COMMON one [ confirmed live 2026-08-26 : hits         ##
## regularly, average completion closer to 120s than the 90s soft ceiling ] ##
## -- level 0 here made routine, already-handled extends look like a real   ##
## failure. the actual failure path further down had no log line of its own ##
## at all, so a genuine hard timeout was ONLY ever recorded via this same   ##
## line -- added one there instead                                          ##
<[base.logs]>->(
    1,
    "async.http_timeout: request timed out after %d seconds [ceiling=%d]",
    int(<[base.time]>->(3)
            - ( $state->{'request_start'} // $state->{'last_activity'} // 0 )
    ),
    $ceiling_used
);

my $task_id = $state->{'task_id'} // '';
my $task_state
    = length($task_id)
    ? <[coding.async.state_manager]>->( qw| get |, $task_id )
    : undef;

## soft-ceiling trip : only worth escalating [ instead of hard-failing ]    ##
## when the stream is actually still alive - confirmed live 2026-08-07 :    ##
## this used to gate purely on `defined $task_state`, which says nothing    ##
## about liveness. coding.self_test.async_probe deliberately passes an      ##
## empty task_id [ "makes the shared downstream handlers degrade to safe    ##
## no-ops" ] to stay decoupled from the task queue, which meant self-test   ##
## requests could NEVER take this branch and always hard-failed at the flat ##
## per-request ceiling [ 90s ] even while genuinely streaming valid tokens  ##
## the whole time - the stall watcher [ coding.handler.http_io : re-armed   ##
## on every chunk ] is the thing that actually detects a hung connection ;  ##
## check its own signal directly [ chunks received + recent activity within ##
## the stall window ] rather than inferring liveness from whether a task    ##
## happens to exist for this request [ the check itself now lives in        ##
## coding.async.stream_tps/is_alive so every layer shares one definition    ##
## that cannot drift apart ]                                                ##
my $stream_alive = <[coding.async.stream_tps]>->( qw| is_alive |, $state );

## absolute outer cap [ task : backend-aware timeout scaling ] : auto-     ##
## derived from live tokens/sec [ coding.async.stream_tps ], frozen on     ##
## stall, static per-backend fallback until enough samples. this is the    ##
## last-resort backstop bounding the repeating extend below -- generous by ##
## design, NOT a tight tracker of normal request duration                  ##
my $outer_cap = <[coding.async.stream_tps]>->( qw| get_cap |, $state );

## task-based branch stays ONE-SHOT [ gated on $hard_ceiling, NOT the outer ##
## cap ] : round_soft_restart re-fires the round's generation from scratch  ##
## on a fresh connection, so repeating it per trip would discard a slow     ##
## round's accumulated output on every re-arm and livelock a legitimately   ##
## slow backend into never finishing. probes [ below ] have no restart      ##
## machinery, so THEY get the repeating in-place extend instead - the same  ##
## stuck-vs-slow rule, expressed through the mechanism each request type    ##
## actually has. task-side dynamic rescaling is deliberate follow-up work,  ##
## not an oversight                                                         ##
if ( $stream_alive and defined $task_state and $ceiling_used < $hard_ceiling )
{
    ## task-based request : restart THIS round in place, not the heavier ##
    ## on_error pipeline [ which assumes a broken connection and does    ##
    ## backend-restart + full task requeue ]                             ##
    <[base.logs]>->(
        1,
        "async.http_timeout: soft ceiling [%ds] "
            . "hit for %s, restarting round with full %ds",
        $ceiling_used,
        $task_id,
        $hard_ceiling
    );
    <[coding.async.http_cleanup]>->($state);
    <[coding.async.round_soft_restart]>->( $task_id, $hard_ceiling );
    return;
}

## no task to restart [ eg self-test probes ] : the connection is still     ##
## open and actively producing valid output, tearing it down and re-sending ##
## from scratch would just throw away real progress and repeat the same     ##
## slow generation - extend the deadline on the SAME in-flight connection   ##
## instead. REPEATING since 2026-08-27 [ was one-shot ] : as long as the    ##
## stream is alive at trip time, push the deadline out by another           ##
## $hard_ceiling-sized window and re-arm, up to the auto-derived outer cap  ##
## above. the existing request-completed budget is reused as the re-check   ##
## interval [ a distinct  coding.cfg.round_liveness_extend_sec knob was     ##
## considered and rejected : a second constant that must stay in sync with  ##
## the same tuning, while the interval itself is not load-bearing for       ##
## correctness - liveness is re-derived from the stall watcher's own signal ##
## at every trip, and the per-chunk stall watcher remains the only thing    ##
## that actually kills a hung stream ]                                      ##
if ( $stream_alive and !defined $task_state and $ceiling_used < $outer_cap ) {
    my $new_ceiling = $ceiling_used + $hard_ceiling;
    $new_ceiling = $outer_cap if $new_ceiling > $outer_cap;
    <[base.logs]>->(
        1,
        "async.http_timeout: ceiling [%ds] hit but stream is "
            . "alive [chunks=%d] : extending to %ds in place [cap=%ds]",
        $ceiling_used,
        $state->{'chunks_received'} // 0,
        $new_ceiling,
        $outer_cap
    );
    $callbacks->{'timeout'}     = $new_ceiling;
    $state->{'timeout_watcher'} = <[event.add_timer]>->(
        {   'after'   => $hard_ceiling,
            'handler' => qw| coding.handler.http_timeout |,
            'data'    =>
                { state => $state, io_watcher => $data->{'io_watcher'} },
        }
    );
    return;
}

## stream stalled/dead, or past the outer cap : genuine timeout ##
<[base.logs]>->(
    0,
    "async.http_timeout: genuine failure after %d seconds "
        . '[ceiling=%d, stream_alive=%d, cap=%d]',
    int(<[base.time]>->(3)
            - ( $state->{'request_start'} // $state->{'last_activity'} // 0 )
    ),
    $ceiling_used,
    $stream_alive ? 1 : 0,
    $outer_cap
);
my $error = "Request timeout";
$callbacks->{'on_error'}->($error) if exists $callbacks->{'on_error'};

<[coding.async.http_cleanup]>->($state);

