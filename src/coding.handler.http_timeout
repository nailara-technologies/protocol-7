## [:< ##

# name  = coding.handler.http_timeout
# descr = Handle HTTP request timeout
# purpose = Clean up and report timeout error

my $event     = shift->w;
my $data      = $event->data;
my $state     = $data->{'state'};
my $callbacks = $state->{'callbacks'};

## skip if already completed [ timer event queued before cleanup ] ##
if ( $state->{'completed'} || !defined $state->{'sock'} ) {
    <[base.logs]>
        ->( 2, "async.http_timeout: skipping [ already completed ]" );
    return;
}

my $ceiling_used = $callbacks->{'timeout'}
    // <coding.http-timeouts.request-completed> // 780;
my $hard_ceiling = <coding.http-timeouts.request-completed> // 780;

## diagnostic only : this fires unconditionally before the stream-alive     ##
## check below decides soft-extend vs. genuine failure, and the soft-       ##
## extend case is the COMMON one [ confirmed live 2026-08-26 : hits         ##
## regularly, average completion closer to 120s than the 90s soft ceiling ] ##
## -- level 0 here made routine, already-handled extends look like a real   ##
## failure. the actual failure path further down had no log line of its own ##
## at all, so a genuine hard timeout was ONLY ever recorded via this same   ##
## line -- added one there instead                                          ##
<[base.logs]>->(
    1,
    "async.http_timeout: request timed out after %d seconds [ceiling=%d]",
    int(<[base.time]>->(3)
            - ( $state->{'request_start'} // $state->{'last_activity'} // 0 )
    ),
    $ceiling_used
);

my $task_id = $state->{'task_id'} // '';
my $task_state
    = length($task_id)
    ? <[coding.async.state_manager]>->( qw| get |, $task_id )
    : undef;

## soft-ceiling trip : only worth escalating [ instead of hard-failing ]    ##
## when the stream is actually still alive - confirmed live 2026-08-07 :    ##
## this used to gate purely on `defined $task_state`, which says nothing    ##
## about liveness. coding.self_test.async_probe deliberately passes an      ##
## empty task_id [ "makes the shared downstream handlers degrade to safe    ##
## no-ops" ] to stay decoupled from the task queue, which meant self-test   ##
## requests could NEVER take this branch and always hard-failed at the flat ##
## per-request ceiling [ 90s ] even while genuinely streaming valid tokens  ##
## the whole time - the stall watcher [ coding.handler.http_io : re-armed   ##
## on every chunk ] is the thing that actually detects a hung connection ;  ##
## check its own signal directly [ chunks received + recent activity within ##
## the stall window ] rather than inferring liveness from whether a task    ##
## happens to exist for this request                                        ##
my $now          = <[base.time]>->(3);
my $stream_alive = ( $state->{'chunks_received'} // 0 ) > 0
    && ( $now - ( $state->{'last_activity'} // 0 ) )
    < ( $state->{'stall_timeout_sec'} // 77 );

if ( $stream_alive and $ceiling_used < $hard_ceiling ) {
    if ( defined $task_state ) {
        ## task-based request : restart THIS round in place, not the     ##
        ## heavier on_error pipeline [ which assumes a broken connection ##
        ## and does backend-restart + full task requeue ]                ##
        <[base.logs]>->(
            1,
            "async.http_timeout: soft ceiling [%ds] "
                . "hit for %s, restarting round with full %ds",
            $ceiling_used,
            $task_id,
            $hard_ceiling
        );
        <[coding.async.http_cleanup]>->($state);
        <[coding.async.round_soft_restart]>->( $task_id, $hard_ceiling );
        return;
    }

    ## no task to restart [ eg self-test probes ] : the connection is still ##
    ## open and actively producing valid output, tearing it down and        ##
    ## re-sending from scratch would just throw away real progress and      ##
    ## repeat the same slow generation - extend the deadline on the SAME    ##
    ## in-flight connection instead                                         ##
    <[base.logs]>->(
        1,
        "async.http_timeout: soft ceiling [%ds] hit but stream "
            . "is alive [chunks=%d] : extending to full %ds in place",
        $ceiling_used,
        $state->{'chunks_received'} // 0,
        $hard_ceiling
    );
    $callbacks->{'timeout'}     = $hard_ceiling;
    $state->{'timeout_watcher'} = <[event.add_timer]>->(
        {   'after'   => $hard_ceiling,
            'handler' => qw| coding.handler.http_timeout |,
            'data'    =>
                { state => $state, io_watcher => $data->{'io_watcher'} },
        }
    );
    return;
}

## already at the hard ceiling : genuine timeout, existing failure path ##
<[base.logs]>->(
    0,
    "async.http_timeout: genuine failure after %d seconds "
        . '[ceiling=%d, stream_alive=%d]',
    int(<[base.time]>->(3)
            - ( $state->{'request_start'} // $state->{'last_activity'} // 0 )
    ),
    $ceiling_used,
    $stream_alive ? 1 : 0
);
my $error = "Request timeout";
$callbacks->{'on_error'}->($error) if exists $callbacks->{'on_error'};

<[coding.async.http_cleanup]>->($state);

