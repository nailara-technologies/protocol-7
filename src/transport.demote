## [:< ##

# name  = transport.demote
# descr = mark transport as demoted for a destination and exit
# args  = $dest, $type, $reason, $exit

my ( $dest, $type, $reason, $exit ) = @ARG;

return if not defined $dest or not defined $type or not defined $exit;

<transport.registry>->{'demoted'}{$dest}{$exit}{$type} = <[base.time]>->(4);

<[base.logs]>->(
    1, 'transport.demote: %s demoted for %s via %s (reason: %s)',
    $type, $dest, $exit, $reason // 'unknown'
);

## update consecutive failures ##
my $q = <transport.registry>->{'quality'}{$exit}{$type}{$dest} //= {};
$q->{'consecutive_failures'} //= 0;
$q->{'consecutive_failures'}++;

return 1;

