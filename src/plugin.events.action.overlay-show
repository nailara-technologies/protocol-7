## [:< ##

# name  = plugin.events.action.overlay-show
# descr = overlay visibility show [ reverted at end ]

return {
    'name'     => qw| overlay-show |,
    'kind'     => qw| action |,
    'describe' => 'overlay visibility show [ reverted at end ]',
    'run'      => sub {
        my $fire        = shift;
        my $ev_type     = $fire->{'ev_type'};
        my $action      = $fire->{'action'};
        my $action_type = $action->{'type'};

        my $l_name = $action->{'tile-group-name'};
        <events.stack.overlay.visibility>->{$l_name} //= 0;
        my $change = $ev_type eq qw| end | ? -1 : 1;
        <events.stack.overlay.visibility>->{$l_name} += $change;

        <[events.action.overlay_apply]>->( $action, $ev_type );
        return TRUE;
    }
};

