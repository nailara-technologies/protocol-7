## [:< ##

# name  = base.fh-encoding.set
# descr = register file handle encoding mode in global %fh_encoding hash
# usage = <[base.fh-encoding.set]>->($fh, $encoding_mode)
# args  = $fh: file handle; $encoding_mode: 'UTF-8'|'OCTETS'|other
# returns = TRUE [5] on success, FALSE [0] on failure

my ( $fh, $encoding_mode ) = @ARG;

if ( not defined $fh or not defined $encoding_mode ) {
    return FALSE;    ## false:0
}

my $fd = fileno($fh);
if ( not defined $fd ) {
    return FALSE;    ## invalid file handle [false:0]
}

$fh_encoding{$fd} = $encoding_mode;
return TRUE;         ## success [true:5]

