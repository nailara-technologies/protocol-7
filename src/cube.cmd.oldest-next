## [:< ##

# name  = cube.cmd.oldest-next
# descr = arm one-shot contact-oldest routing override [ admin ]
# param = [:single|:next|:keep:] <name>[[subname]]

return <[cube.routing_override.arm]>->(
    $call->{'session_id'},
    qw| contact-oldest |,
    $call->{'args'} // ''
);

