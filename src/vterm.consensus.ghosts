## [:< ##

# name  = vterm.consensus.ghosts
# descr = identify dissenting layers from cells

my $cells_ref = shift // return [];

## identify dissenting layers
my @ghosts;
my %state_counts;

foreach my $cell (@$cells_ref) {
    next if not defined $cell;
    my $state_key = sprintf( "%d,%d,%d",
        $cell->{subbit_r} // 0,
        $cell->{subbit_g} // 0,
        $cell->{subbit_b} // 0 );
    $state_counts{$state_key}++;
}

## find minority states (dissenters)
my ($majority) = sort { $b <=> $a } values %state_counts;
foreach my $cell (@$cells_ref) {
    next if not defined $cell;
    my $sk = sprintf( "%d,%d,%d",
        $cell->{subbit_r} // 0,
        $cell->{subbit_g} // 0,
        $cell->{subbit_b} // 0 );
    if ( $state_counts{$sk} < $majority ) {
        push @ghosts, $cell;
    }
}

return \@ghosts;

