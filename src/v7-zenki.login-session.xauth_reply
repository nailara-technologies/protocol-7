## [:< ##

# name = v7-zenki.login-session.xauth_reply
# descr = hand X authority to the user, request session access

my $reply    = shift                                         // {};
my $cube_sid = $reply->{'params'}->{'cube_sid'}              // '';
my $pending  = <v7-zenki.login-session.pending>->{$cube_sid} // return;
my $request  = $pending->{'request'};
my $fail     = sub {
    my ($message) = @ARG;
    delete <v7-zenki.login-session.pending>->{$cube_sid};
    <[base.callback.cmd_reply]>->(
        $request->{'reply_id'},
        { 'mode' => qw| false |, 'data' => $message }
    );
    return FALSE;
};

return $fail->('X-11 authorization unavailable')
    if ( $reply->{'cmd'} // '' ) ne qw| TRUE |;
my ( $protocol, $cookie_hex )
    = split( m| = |, $reply->{'call_args'}->{'args'} // '', 2 );
my $path = sprintf( qw| /var/run/.7/login-screen/sessions/%s.Xauthority |,
    $pending->{'user'} );
my $written = <[base.X-11.write_xauth_file]>->(
    {   'display'    => $pending->{'display'},
        'protocol'   => $protocol,
        'cookie_hex' => $cookie_hex,
        'path'       => $path,
        'uid'        => $pending->{'uid'},
        'gid'        => $pending->{'gid'},
    }
);
return $fail->('cannot hand X authority to user') if not $written;

my $sent = <[protocol-7.route-send]>->(
    {   'command'   => qw| X-11.grant_session_user |,
        'call_args' => { 'args' => $pending->{'user'} },
        'reply'     => {
            'handler' => qw| v7-zenki.login-session.access_reply |,
            'params'  => { 'cube_sid' => $cube_sid },
        }
    }
);
return $fail->('cannot request X access for session user') if not $sent;
TRUE;

