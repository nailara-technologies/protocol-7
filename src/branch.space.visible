## [:< ##

# name  = branch.space.visible
# descr = return visible nodes within focal length from observer
# param = { focal_length, observer_node, scope }
#
# focal_length: 0 = omni (all), 13 = natural harmonic, higher = fewer shells
# returns nodes sorted by shell ascending, darksun (observer) first

my $params        = shift                      // {};
my $focal_length  = $params->{'focal_length'}  // 13;
my $observer_node = $params->{'observer_node'} // '';
my $scope         = $params->{'scope'}         // 'global';

return { 'mode' => 'false', 'data' => 'observer node required' }
    unless length $observer_node;
return { 'mode' => 'false', 'data' => 'observer not found' }
    unless exists $data{'branch.nodes'}{$observer_node};

## resolve node set for scope ##
my @node_set;
my $observer = $data{'branch.nodes'}{$observer_node};

if ( $scope eq 'local' ) {
    my $parent = $observer->{'parent'} // '';
    if ( length $parent ) {
        @node_set = keys %{ $data{'branch.children'}{$parent} // {} };
    } else {
        @node_set = grep {
            my $n = $data{'branch.nodes'}{$ARG} // {};
            ( not defined $n->{'parent'} or not length $n->{'parent'} )
                and $ARG ne $observer_node;
        } keys %{ $data{'branch.nodes'} // {} };
    }
} elsif ( $scope eq 'regional' ) {
    my $parent = $observer->{'parent'} // '';
    if ( length $parent ) {
        @node_set = <[branch.space.util.collect_subtree]>->($parent);
    } else {
        @node_set = <[branch.space.util.collect_subtree]>->($observer_node);
    }
} else {
    ## global ##
    @node_set = grep { $ARG ne $observer_node }
        keys %{ $data{'branch.nodes'} // {} };
}

## omni mode: return all nodes with observer first ##
if ( $focal_length eq 'omni' or $focal_length == 0 ) {
    my @result = <[branch.space.util.build_visible_result]>->(
        $observer_node, \@node_set, $scope
    );
    @result = sort { $a->{'shell'} <=> $b->{'shell'} } @result;
    return { 'mode' => 'true', 'data' => \@result };
}

## compute max visible shell ##
my $max_shell = int( 63 / $focal_length );
$max_shell++ if 63 % $focal_length;

## rank all nodes in scope and filter ##
my @ranked = map {
    { 'id' => $ARG, 'ref_count' => <[branch.space.util.ref_count]>->($ARG), }
} @node_set;

@ranked = sort {
           $b->{'ref_count'} <=> $a->{'ref_count'}
        || $a->{'id'} cmp $b->{'id'}
} @ranked;

my $total_nodes = scalar @ranked;
my $n           = int( $total_nodes / 2 ) + ( $total_nodes % 2 );
my @result;

## observer at shell 0 always visible unless max_shell < 0 ##
push @result,
    {
    'node_id'  => $observer_node,
    'shell'    => 0,
    'position' => 0,
    };

for my $i ( 0 .. $#ranked ) {
    my $rank = $i + 1;
    my $pos  = int( ( $rank + 1 ) / 2 );
    $pos = -$pos if $rank % 2 == 0;
    my $shell = abs($pos);

    last if $shell > $max_shell;

    push @result,
        {
        'node_id'  => $ranked[$i]->{'id'},
        'shell'    => $shell,
        'position' => $pos,
        };

    $data{'branch.space.positions'}{$scope}{ $ranked[$i]->{'id'} } = {
        'position' => $pos,
        'shell'    => $shell,
        'n'        => $n,
    };
}

return { 'mode' => 'true', 'data' => \@result };

