## [:< ##

# name  = invoke-web.cmd.stop
# descr = stop the invoke.ai web server process

my $pid = <invoke-web.pid>;

unless ( defined $pid and <[invoke-web.is_alive]>->($pid) ) {

    ## a start not spawned yet is stopped too : a pending recovery restart ##
    ## [ crash \ cuda -- its timer finds no <invoke-web.recover> ] or a    ##
    ## start queued by the memory guard                                    ##
    my @dropped;
    push @dropped, sprintf '%s recovery restart',
        ( delete <invoke-web.recover> )->{'kind'} // '?'
        if defined <invoke-web.recover>;
    if ( defined <invoke-web.start_waiting> ) {
        delete <invoke-web.start_waiting>;
        my $guard_timer = delete <invoke-web.timer.start_guard>;
        $guard_timer->cancel if defined $guard_timer and ref $guard_timer;
        push @dropped, 'start waiting for memory';
    }
    if (@dropped) {
        <[invoke-web.queue.release]>;
        <[base.zenki.resume_ondemand_timeout]>;
        <[base.logs]>->( 1, 'stop : %s canceled', join ', ', @dropped );
        return {
            mode => qw| size |,
            data => sprintf(
                "invoke.ai not started : %s canceled\n",
                join ', ', @dropped
            )
        };
    }

    return { mode => qw| false |, data => 'invoke.ai is not running' };
}

## stop following the output file [ it stays : the offset is saved ] ##
<[invoke-web.output.stop]>;

## send SIGTERM first
unless ( kill( 'TERM', $pid ) ) {
    <[base.logs]>->(
        0,    'SIGTERM to invoke.ai refused [pid:%d : %s]',
        $pid, "$OS_ERROR"
    );
    return {
        mode => qw| false |,
        data => sprintf( 'SIGTERM refused [pid:%d : %s]', $pid, "$OS_ERROR" )
    };
}
<invoke-web.status> = 'stopping';
## stopped during startup : nothing stays held ##
<[invoke-web.queue.release]>;

<[base.logs]>->( 1, 'sent SIGTERM to invoke.ai [pid:%d]', $pid );

## schedule SIGKILL fallback after 10 seconds
<[event.add_timer]>->(
    {   'after'   => 10,
        'handler' => 'invoke-web.handler.check_health',
    }
);

## clean up state
<[file.zenka_dir.unlink_file]>->( 'state/invokeai.pid', TRUE );
<invoke-web.pid>    = undef;
<invoke-web.status> = 'idle';
<[base.zenki.resume_ondemand_timeout]>;    ## idle shutdown allowed again ##

return {
    mode => qw| size |,
    data => sprintf( "invoke.ai stopping [pid:%d sent SIGTERM]\n", $pid )
};

