## [:< ##

# name  = invoke-web.cmd.stop
# descr = stop the invoke.ai web server process

my $pid = $data{'invoke-web'}{'pid'};

unless ( defined $pid and kill( 0, $pid ) ) {
    return { mode => qw| size |, data => "invoke.ai is not running\n" };
}

## cancel I/O watchers
for my $key (qw| watcher_stdout watcher_stderr |) {
    my $w = $data{'invoke-web'}{$key};
    $w->cancel if defined $w and $w->is_active;
}

## close I/O pipes
for my $key (qw| io_stdout io_stderr |) {
    my $fh = $data{'invoke-web'}{$key};
    close($fh) if defined $fh;
}

## send SIGTERM first
kill( 'TERM', $pid );
$data{'invoke-web'}{'status'} = 'stopping';

<[base.logs]>->( 1, 'sent SIGTERM to invoke.ai [pid:%d]', $pid );

## schedule SIGKILL fallback after 10 seconds
<[event.add_timer]>->(
    {   'after'   => 10,
        'handler' => 'invoke-web.handler.check_health',
    }
);

## clean up state
<[file.zenka_dir.unlink_file]>->( 'state/invokeai.pid', TRUE );
$data{'invoke-web'}{'pid'}    = undef;
$data{'invoke-web'}{'status'} = 'idle';

return {
    mode => qw| size |,
    data => sprintf( "invoke.ai stopping [pid:%d sent SIGTERM]\n", $pid )
};

