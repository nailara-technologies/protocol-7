## [:< ##

# name  = invoke-web.gpu_lease.handler.acquire_timeout
# descr = models did not answer : leave the existing render path unchanged

my $event = shift;
my $stage = $event->w->data->{'stage'} // qw| timeout |;
if ( $stage eq qw| retry | ) {
    ## a probe : the queue keeps rendering until models answers [ on hold ] ##
    <invoke-web.gpu_lease.unavailable> = FALSE;
    <invoke-web.gpu_lease.probe>       = TRUE;
    return <[invoke-web.gpu_lease.request]>;
}
return TRUE if ( <invoke-web.gpu_lease.holder> // '' ) eq qw| invoke-web |;
return TRUE if not <invoke-web.gpu_lease.request_inflight>;
<invoke-web.gpu_lease.request_inflight> = FALSE;
<invoke-web.gpu_lease.unavailable>      = TRUE;
## models is gone : our own pause must not strand the queue ##
if (<invoke-web.gpu_lease.auto_paused>) {
    <invoke-web.gpu_lease.auto_paused> = FALSE;
    <[invoke-web.api_async]>->(
        'PUT', '/api/v1/queue/default/processor/resume',
        undef, 'invoke-web.gpu_lease.handler.queue_resume_reply'
    );
}
<[base.logs]>->(
    1,
    ': models gpu lease request unanswered : existing render path continues'
) if not <invoke-web.gpu_lease.probe>;
## back off while models stays silent : 30 s doubling up to 780 s ##
my $after = <invoke-web.gpu_lease.retry_after> // 15;
$after = $after * 2 > 780 ? 780 : $after * 2;
<invoke-web.gpu_lease.retry_after> = $after;
<[event.add_timer]>->(
    {   'after'   => $after,
        'handler' => qw| invoke-web.gpu_lease.handler.acquire_timeout |,
        'data'    => { 'stage' => qw| retry | },
    }
);
return TRUE;

