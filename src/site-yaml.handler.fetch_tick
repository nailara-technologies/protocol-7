## [:< ##

# name  = site-yaml.handler.fetch_tick
# descr = process one item from fetch queue, route result, reschedule

my $queue = <site-yaml.fetch_queue> // [];

if ( not @{$queue} ) {
    <[site-yaml.fetch.schedule]>;
    return;
}

my $item          = shift @{$queue};
my $url           = $item->{'url'}           // '';
my $id            = $item->{'id'}            // '';
my $reply_handler = $item->{'reply_handler'} // '';

return unless length $url;

<[site-yaml.async_fetch.request]>->(
    $id, $url,
    sub {
        my $raw_result = shift;    ## content string, or numeric http code ##

        ## liveness check [ site-yaml.cmd.liveness ] : one verdict back to ##
        ## the deferred caller, never a retry -- unknown is an answer too  ##
        if ( defined $item->{'liveness'} ) {
            my $verdict
                = <[site-yaml.liveness.verdict]>->( $url, $raw_result );
            <[base.logs]>->(
                1,   'liveness: %s [%s %s] q=%d',
                $id, $verdict->{'verdict'}, $verdict->{'code'},
                scalar @{$queue}
            );
            <[base.callback.cmd_reply]>->(
                $item->{'liveness'},
                {   'mode' => qw| true |,
                    'data' => JSON::encode_json($verdict),
                }
            );
            <[site-yaml.fetch.backoff]>->(
                ( $verdict->{'code'} // 0 ) =~ m{\A(?:403|429)\z}
                ? qw| error |
                : qw| success |
            );
            <[site-yaml.fetch.state]>->('save');
            <[site-yaml.fetch.schedule]>;
            return;
        }

        my $job
            = ( $raw_result =~ m{\A\d+\z} )
            ? $raw_result
            : <[site-yaml.stepstone.job_from_html]>->( $url, $raw_result );

        my $ql = scalar @{$queue} + 1;    ## including current item ##

        if ( ref $job ne 'HASH' ) {
            my $code = $job // 0;
            ## 410 Gone, 404 Not Found ##
            my $is_gone      = $code =~ m{^4(10|04)$};
            my $is_ratelimit = $code =~ m{403|429}
                || ( $code // '' ) =~ m{rate.?limit|too.?many}i;
            my $tag = $is_gone ? 'gone' : $is_ratelimit ? '403' : 'err';

            if ($is_gone) {
                ## permanent : drop immediately, no retry ##
            } elsif ($is_ratelimit) {
                $item->{'retry_count'} //= 0;
                $item->{'retry_count'}++;
                if ( $item->{'retry_count'} <= 5 ) {
                    ## back of queue : allow others through ##
                    push @{$queue}, $item;
                    $tag .= ' retry=' . $item->{'retry_count'};
                    <[site-yaml.fetch.backoff]>->('error');
                } else {
                    ## give up after 5 ratelimit retries ##
                    $tag = 'drop';
                }
            } else {
                $item->{'retry_count'} //= 0;
                $item->{'retry_count'}++;
                if ( $item->{'retry_count'} <= 2 ) {
                    push @{$queue}, $item;
                    $tag .= ' retry=' . $item->{'retry_count'};
                } else {
                    $tag = 'drop';
                }
            }

            my $is_retry = $tag =~ m{retry=};
            my $log_level
                = $is_gone ? 2 : ( $is_ratelimit || $is_retry ) ? 2 : 1;
            <[base.logs]>->(
                $log_level, 'fetch: %s [%s] q=%d',
                $id, $tag, scalar @{$queue}
            );
            <[site-yaml.fetch.state]>->('save');
            <[site-yaml.fetch.schedule]>;
            return;
        }

        ## success : route the fetched record to the configured handler ##
        if ( length $reply_handler ) {
            my $payload = eval { JSON::encode_json($job) };
            if ( not defined $payload or $@ ) {
                <[base.logs]>->(
                    0,   'fetch: %s json encode error: %s',
                    $id, $@ // '?'
                );
            } elsif ( $reply_handler eq qw| :hold: | ) {
                ## durable outbox + STRM fan-out instead of a route-send : ##
                ## the caller may sit on another host [ remote fetch ]     ##
                <[base.logs]>->( 1, 'fetch: %s [hold] q=%d', $id, $ql - 1 );
                <[site-yaml.outbox.write]>->(
                    $id, $payload, $item->{'category'} // ''
                );
            } else {
                <[base.logs]>->( 1, 'fetch: %s [route] q=%d', $id, $ql - 1 );
                ## param-only multiline send : param \ data do not travel ##
                ## with args [ send.local ], and the category tag must    ##
                ## reach the upsert side for per-category tallies [ WY5 ] ##
                <[protocol-7.route-send]>->(
                    {   'command'   => $reply_handler,
                        'call_args' => {
                            'param' => {
                                'job' => $payload,
                                'cat' => $item->{'category'} // '',
                            }
                        },
                    }
                );
            }
        } else {
            <[base.logs]>->( 1, 'fetch: %s [drop] q=%d', $id, $ql - 1 );
        }

        <[site-yaml.fetch.backoff]>->('success');
        <[site-yaml.fetch.state]>->('save');
        <[site-yaml.fetch.schedule]>;
    }
);

return;

