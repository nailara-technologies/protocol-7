## [:< ##

# name  = events.signal.encode
# descr = journal field escape : %XX for anything outside the plain set
# args   = text
# return = text safe in a space \ comma \ colon separated journal line ;
#          the empty text is '-' [ a lone '-' is escaped as %2D ]

my $text = shift // '';
return qw| - | if !length $text;
utf8::encode($text);    ## octets : one %XX per byte ##
$text =~ s{([^A-Za-z0-9_./@+\-])}{sprintf '%%%02X', ord $1}ge;
$text =~ s{\A-\z}{%2D};
return $text;

