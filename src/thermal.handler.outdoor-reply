# name  = thermal.handler.outdoor-reply
# descr = store a numeric outdoor temperature reply

my $call = shift // {};

my ( $ok, $text, $why ) = <[base.reply.value]>->( $call, qw| text | );
if ( not $ok or $text !~ m|^\s*(-?\d+(?:\.\d+)?)| ) {
    <[base.logs]>->(
        2,
        ': thermal : outdoor temperature unavailable [ %s ]',
        $ok ? $text : $why
    );
    return FALSE;
}

<thermal.outdoor.temp> = 0 + $1;
<thermal.outdoor.at>   = <[base.time]>->(2);

return TRUE;

