## [:< ##

# name  = jobsite.handler.sync-response
# descr = called when batch sync post completes : stores server ntime, applies reverse

my $result     = shift                   // {};
my $ok         = $result->{'ok'}         // FALSE;
my $body       = $result->{'body'}       // '';
my $params     = $result->{'params'}     // {};
my $chunk_size = $params->{'chunk_size'} // 0;
my $url        = $params->{'url'}        // '';

## a chunk only counts as confirmed if the transport succeeded AND the  ##
## server's own response body says ok : a 200 wrapping {"ok":false,...} ##
## [ e.g. a partial write failure on the receiving side ] must NOT be   ##
## treated as delivered, or the affected jobs get silently skipped from ##
## every future sync once the watermark moves past them                 ##
my $reply   = $ok ? eval { JSON::XS::decode_json($body) }        : undef;
my $body_ok = ref $reply eq 'HASH' ? ( $reply->{'ok'} // FALSE ) : FALSE;

if ( $ok and ref $reply eq 'HASH' and $body_ok ) {
    my $ntime   = $reply->{'ntime'}   // '';
    my $reverse = $reply->{'reverse'} // [];

    ## web-side relayed prefs : adopt a newer last_export_at               ##
    ## [ max-merge, same numeric-newest rule as jobsite.cmd.set-prefs ] so ##
    ## an export run on any connected host becomes the since-last-export   ##
    ## watermark everywhere [ QLK ]                                        ##
    my $prefs_reply = $reply->{'prefs'};
    if ( ref $prefs_reply eq 'HASH'
        and $prefs_reply->{'last_export_at'} =~ m{^\d+(?:\.\d+)?$} ) {
        my $prefs     = <[jobsite.client_prefs.read]>;
        my $remote_at = $prefs_reply->{'last_export_at'} + 0;
        if ( $remote_at > ( $prefs->{'last_export_at'} // 0 ) ) {
            $prefs->{'last_export_at'} = $remote_at;
            <[jobsite.client_prefs.write]>->($prefs);
        }
    }

    ## server ntime stored for reference; local cycle ntime used as filter ##
    ## watermark                                                           ##
    <jobsite.sync.last_remote_ntime> = $ntime if length $ntime;
    push <jobsite.sync.push_reverse>->@*, @{$reverse};
    <[base.logs]>->(
        2,           'jobsite: chunk done (%d jobs), reverse=%d',
        $chunk_size, scalar @{$reverse}
    );

    <jobsite.sync.push_total_confirmed> += $chunk_size if $chunk_size;
} else {
    <[base.logs]>->(
        0,
        'jss.sync: chunk failed [%s]: %s',
        $url,
        $ok
        ? (   ( ref $reply eq 'HASH' )
            ? ( $reply->{'error'} // 'server ok:false' )
            : 'invalid response body'
            )
        : ( $result->{'error'} // $result->{'status'} // '?' )
    );
    <jobsite.sync.push_had_failure>->{$url} = TRUE if length $url;
}

## advance to next chunk regardless of success : a failure freezes that ##
## url's watermark at cycle end instead [ see push_chunk ], so it never ##
## blocks the rest of the queue from being attempted this cycle         ##
<[jobsite.sync.push_chunk]>;

