# name  = plugin.events.action.playlist-show-entry
# descr = playlist entry visibility up [ down at end ]

return {
    'name'     => qw| playlist-show-entry |,
    'kind'     => qw| action |,
    'describe' => 'playlist entry visibility up [ down at end ]',
    'run'      => sub {
        my $fire        = shift;
        my $ev_type     = $fire->{'ev_type'};
        my $action      = $fire->{'action'};
        my $action_type = $action->{'type'};

        my $b32id = $action->{'b32id'};    # SHOW event
        die "'b32id' parameter is missing from '$action_type' setup"
            if not defined $b32id;
        <events.stack.playlist>->{$b32id}->{'visibility'} //= 0;
        my $change = $ev_type eq qw| end | ? -1 : 1;
        <events.stack.playlist>->{$b32id}->{'visibility'} += $change;

        <[protocol-7.command.send.local]>
            ->( { 'command' => qw| cube.content.update | } );
        return TRUE;
    }
};

