## [:< ##

# name  = window.place.build_corner_candidates
# param = <monitors_aref> <win_width> <win_height> <margin> [<preferred_monitor_index>]
# descr = build an ordered corner candidate list across all given monitors,
#         for window.place.find_safe_position to try in order

## ordering: preferred monitor first (if valid), then the rest in given    ##
## order.  within each monitor the four corners are emitted as: top-right, ##
## top-left, bottom-right, bottom-left. top-right first preserves          ##
## protocol-7-menu's historical default-position bias. each corner keeps   ##
## the requested margin from the monitor edges it touches.                 ##

my ( $monitors, $win_width, $win_height, $margin, $preferred_index ) = @ARG;

return []
    if ref($monitors) ne qw| ARRAY |
    or not @$monitors
    or not defined $win_width
    or not defined $win_height;

$margin //= 0;

## preferred monitor first, then the rest in given order ##
my @ordered_indices = ( 0 .. $#$monitors );
if ( defined $preferred_index and exists $monitors->[$preferred_index] ) {
    @ordered_indices = (
        $preferred_index, grep { $ARG != $preferred_index } @ordered_indices
    );
}

my @candidates;
for my $mon_idx (@ordered_indices) {
    my $mon = $monitors->[$mon_idx];
    next
        if ref($mon) ne qw| HASH |
        or not defined $mon->{'width'}
        or not defined $mon->{'height'};

    my $mx = $mon->{'x'} // 0;
    my $my = $mon->{'y'} // 0;
    my $mw = $mon->{'width'};
    my $mh = $mon->{'height'};

    my @corners = (
        [ qw| top-right |, $mx + $mw - $win_width - $margin, $my + $margin ],
        [ qw| top-left |,  $mx + $margin,                    $my + $margin ],
        [   qw| bottom-right |,
            $mx + $mw - $win_width - $margin,
            $my + $mh - $win_height - $margin
        ],
        [   qw| bottom-left |,
            $mx + $margin,
            $my + $mh - $win_height - $margin
        ],
    );

    for my $corner (@corners) {
        my ( $name, $x, $y ) = @$corner;
        push @candidates,
            {
            'x'             => $x + 0,
            'y'             => $y + 0,
            'width'         => $win_width + 0,
            'height'        => $win_height + 0,
            'monitor_index' => $mon_idx,
            'corner'        => $name,
            };
    }
}

return \@candidates;

