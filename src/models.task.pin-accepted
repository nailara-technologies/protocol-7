## [:< ##

# name  = models.task.pin-accepted
# descr = is a remote task's model pin served here
# note  = is a remote task's ':model:' pin loaded here, or available for
#         an idle model swap
# param = <pin> [ registry key '<path>:<content>' \ ':<content>' ]
# return = TRUE accepted, FALSE not served here, UNKNOWN : the local coding
#          zenka's loaded models or their idle time are not known [ or the
#          status is older than 60 s ]
# notes = models.cfg.task_models [ space separated registry keys ] set :
#         those keys. empty : the models the local coding zenka has loaded
#         [ coding.inference-status, cached in <models.task.local_models> ].
#         compared by the content half : the path half differs between
#         hosts for the same file, coding.mode.local_model_id maps a pin
#         the same way -- the pin itself is never rewritten

my $pin = uc( shift // '' );

return TRUE if not length $pin;    ## no pin : any loaded model will do ##

my ($pin_content) = $pin =~ m|([A-Z2-7]{7})$|;
return FALSE if not defined $pin_content;

my @keys;
my $local       = <models.task.local_models> // {};
my $task_models = <models.cfg.task_models>   // '';
my $swap        = <models.task.swap_accepted> //= {};

if ( $task_models =~ m|\S| ) {
    @keys = split m|\s+|, uc $task_models;
} else {
    return UNKNOWN
        if not defined $local->{'at'}
        or time - $local->{'at'} > 60;
    @keys = @{ $local->{'ids'} // [] };
}

foreach my $key (@keys) {
    my ($key_content) = $key =~ m|([A-Z2-7]{7})$|;
    if ( defined $key_content and $key_content eq $pin_content ) {
        delete $swap->{$pin_content};
        return TRUE;
    }
}

if ( $task_models =~ m|\S|
    or not <[base.cfg_bool]>->( <models.cfg.task_swap> // TRUE ) ) {
    delete $swap->{$pin_content};
    return FALSE;
}

my $idle_secs = $local->{'idle_secs'};
if ( not defined $idle_secs or $idle_secs !~ m|^\d+$| ) {
    delete $swap->{$pin_content};
    return UNKNOWN;
}
## a model only loaded [ startup, switch ] gives way sooner than one that ##
## served requests                                                        ##
my $swap_idle
    = $local->{'idle_used'}
    ? <models.cfg.task_swap_idle> // 1620
    : <models.cfg.task_swap_idle_load> // 420;
if ( $idle_secs < $swap_idle
    or not defined <[models.registry.lookup]>->($pin) ) {
    delete $swap->{$pin_content};
    return FALSE;
}

if ( not $swap->{$pin_content} ) {
    $swap->{$pin_content} = TRUE;
    <[base.logs]>->(
        1,    'pin %s not loaded : swap accepted [ idle %d s ]',
        $pin, $idle_secs
    );
}
return TRUE;

