## [:< ##

# name  = user-edit.source.secret_hold
# descr = sessions-zenka sender : hold a secret under a name
# param = $hold_name, $encoded_value, $reply_handler [ , $params_href ]

## the secret half of the record source behind <form.source> -- masked field
## values must never reach users.value-set's plaintext payload, so a submit
## holding secrets fans them out to sessions.hold, one call per field.  the
## value arrives base32-encoded [ encode_b32r ], as the sessions wire format
## expects

my ( $hold_name, $encoded_value, $reply_handler, $params ) = @ARG;

my $cube_sid = <form.cube_sid> // return FALSE;

my $reply = { qw| handler | => $reply_handler };
$reply->{'params'} = $params if defined $params;

return <[protocol-7.command.send.local]>->(
    {   qw| command |   => sprintf( '%d.sessions.hold', $cube_sid ),
        qw| call_args | =>
            { qw| args | => sprintf( '%s %s', $hold_name, $encoded_value ) },
        qw| reply | => $reply
    }
);

