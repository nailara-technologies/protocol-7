## [:< ##

# name  = cube-13.zenka.init_code
# descr = Initialize cube-13 switch matrix for zulum-13 stream routing

## cube-13: switch matrix between 13 entropy streams  Implements jump true, ##
## jump reverse, jump next navigation                                       ##

## Stream registry: tracks which decoder is connected to which stream ##
<cube-13.streams> = {
    map {
        $ARG => {
            'id'          => $ARG,
            'is_true'     => undef,    ## harmonic truth of current value ##
            'decoder_sid' => undef,    ## connected decoder session ID ##
            'boundary'    => 0,        ## boundary marker sequence ##
        }
    } ( 1 .. 13 )
};

## Current active stream for jump operations ##
<cube-13.active_stream> = 1;

## Jump table: direction -> next stream calculation ##
<cube-13.jump_table> = {
    'true' => sub {    ## jump to stream with is_true=1 ##
        my $current = <cube-13.active_stream>;
        my $streams = <cube-13.streams>;

        ## Search forward from current, wrap around ##
        for my $offset ( 1 .. 13 ) {
            my $sid = ( ( $current - 1 + $offset ) % 13 ) + 1;
            return $sid if $streams->{$sid}{'is_true'};
        }
        return $current;    ## no true stream found, stay ##
    },
    'reverse' =>
        sub {  ## jump to harmonic mirror entry point [ stream 3 = 230769 ] ##
        ## 230769 / 0.7 = 329670 -- true digit reversal, not just roll ##
        ## 538461 / 0.7 = 769230 -- only rolls left, NOT true reversal ##
        return 3;    ## stream 3 = 076923 × 3 = 230769 ##
        },
    'next' => sub {    ## jump to next stream ##
        my $current = <cube-13.active_stream>;
        return ( $current % 13 ) + 1;
    },
    'root' => sub {  ## jump to convergence attractor [ 769230 = gen × 10 ] ##
        ## 769230 is reachable from any stream via /0.N operator algebra: ##
        ## (076923 × N) / (N/10) = 769230 for any N                       ##
        return 10;    ## stream 10 = 076923 × 10 = 769230 ##
    },
};

<[base.log]>->( 1, "[cube-13] switch matrix initialized, 13 streams ready" );

return TRUE;

