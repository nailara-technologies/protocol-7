## [:< ##

# name   = usage.home_dir
# descr  = home of the unix user this zenka runs as
# return = path, or '' when it cannot be resolved

## provider credential paths are relative to it [ never hardcoded ] ##

return ( CORE::getpwuid($UID) )[7] // $ENV{'HOME'} // '';

