## [:< ##

# name  = v7-zenki.zenka.setup.add
# descr = store a new zenka setup and return its id

my $zenka_details = shift;
die 'v7-zenki.zenka.setup.add: expected a hash reference!'
    if ref($zenka_details) ne qw| HASH |;

my $zenka_name = $zenka_details->{'name'};
die 'v7-zenki.zenka.setup.add: [minimum] \'name\' parameter required'
    if not defined $zenka_name or !length $zenka_name;

$zenka_details->{'type'} //= 'local';

my $zenka_id = <[base.gen_id]>->(<v7-zenki.zenka.setup>);

<v7-zenki.zenka.setup>->{$zenka_id} = $zenka_details;

return $zenka_id;

