## [:< ##

# name  = authorization.cmd.key-approve
# param = <entry id> <owner decision signature b32>

my ( $id, $signature_b32 ) = split( m|\s+|, $call->{'args'} // '' );
return {
    qw| mode | => qw| false |,
    qw| data | => 'usage : key-approve <entry-id> <owner-signature-b32>'
    }
    if not defined $signature_b32
    or not length $signature_b32;

return <[authorization.buffer.approve]>->( $id, $signature_b32 );

