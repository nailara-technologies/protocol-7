## [:< ##

# name  = mpv.handler.reposition_reply
# descr = window-place coords reply: apply new geometry to running player

my $reply = shift // {};
my $mode  = lc( $reply->{'cmd'} // '' );
my $rdata = $reply->{'call_args'}->{'args'} // '';

if ( $mode ne qw| true | ) {
    <[base.logs]>->( 1, '[reposition] coords unavailable — no change' );
    return;
}

my %geo;
for my $token ( split m|\s+|, $rdata ) {
    $geo{$1} = $2 + 0 if $token =~ m{^(x|y|width|height)=(-?\d+)$};
}

unless (defined $geo{'x'}
    and defined $geo{'y'}
    and defined $geo{'width'}
    and defined $geo{'height'} ) {
    <[base.logs]>->( 0, '[reposition] unparseable coords [%s]', $rdata );
    return;
}

my $geometry = sprintf '%dx%d+%d+%d',
    $geo{'width'}, $geo{'height'}, $geo{'x'}, $geo{'y'};

## cache the new profile ##
my $caller = <mpv.startup.caller> // <system.zenka.name> // 'mpv';
<[window.profile.save]>->(
    $caller, $geo{'x'}, $geo{'y'}, $geo{'width'}, $geo{'height'}
);

## apply to running player via X-11 ##
my $window_id = <x11.id>;
if ( defined $window_id ) {
    <[base.zenki.resolve_primary_sid]>->(
        'X-11',
        sub {
            my $sid = shift;
            return if not defined $sid;
            <[protocol-7.route-send]>->(
                {   'command'   => "$sid.set_geometry",
                    'call_args' =>
                        { 'args' => sprintf '%d %s', $window_id, $geometry }
                }
            );
        }
    );
    <[base.logs]>->( 1, '[reposition] applied geometry [%s]', $geometry );
} else {
    <[base.logs]>->(
        0, '[reposition] no x11 window id — geometry not applied'
    );
}

