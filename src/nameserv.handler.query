## [:< ##

# name  = nameserv.handler.query
# descr = handle incoming dns query packets over udp

require Socket;    ## getnameinfo : not imported into a zenka ##

## reply on the socket the query arrived on [ ipv4 \ ipv6 listeners ] ##
my $event = shift;
my $sock
    = ( ref $event and $event->can('w') and defined $event->w->fd )
    ? $event->w->fd
    : <nameserv.socket>;

## receive packet
my $from_addr = recv $sock, my $packet_data, 512, 0;
if ( not defined $from_addr ) {
    <nameserv.stats>->{'errors'}++;
    return;
}

## udp size limit : the query's edns udp size when it carries an opt record ##
## [ capped at 1232, the safe mtu-derived ceiling ], else 512               ##
my $udp_size = 512;
my $q_packet = eval { Net::DNS::Packet->new( \$packet_data ) };
if ( defined $q_packet ) {
    my ($opt)
        = grep { $_->isa(qw| Net::DNS::RR::OPT |) } $q_packet->additional;
    if ( defined $opt ) {
        ## Net::DNS 1.57 : udpsize [ size is a deprecated, warning alias ] ##
        ## ; 1.36 [ debian bookworm ] : size -- its udpsize passes can()   ##
        ## but dies 'unknown instance method', so try it instead of asking ##
        my $edns_size = eval { $opt->udpsize } // $opt->size;
        $udp_size = $edns_size > 1232 ? 1232 : $edns_size
            if $edns_size > 512;
    }
}

my $reply = <[nameserv.answer]>->($packet_data);
return if not defined $reply;

## forwarding cache mode : authoritative REFUSED + mode on + rd set + ##
## loopback client [ checked in code, never only by bind or config ]  ##
if (    $reply->header->rcode eq qw| REFUSED |
    and <[base.cfg_bool]>->( <nameserv.cfg.cache.enabled> // FALSE )
    and defined $q_packet
    and $q_packet->header->rd
    and defined $from_addr ) {

    my ( $gai_err, $peer_ip )
        = Socket::getnameinfo( $from_addr, Socket::NI_NUMERICHOST() );

    if (    not length $gai_err
        and defined $peer_ip
        and <[nameserv.cache.client_allowed]>->($peer_ip) ) {
        my $hit = <[nameserv.cache.get]>->($q_packet);
        if ( defined $hit ) {
            $reply = $hit;
        } else {
            ## miss : forward async, the deliver callback answers later ##
            <[nameserv.cache.forward]>->(
                $q_packet,
                sub {
                    my $fwd_reply = shift // return;
                    my $fwd_data  = $fwd_reply->data($udp_size);
                    if ( defined $fwd_data and length $fwd_data ) {
                        send $sock, $fwd_data, 0, $from_addr;
                    }
                }
            );
            return;    ## no synchronous reply ##
        }
    }
}

## send response [ truncate sets the tc bit when records drop off ] ##
my $reply_data = $reply->data($udp_size);
if ( defined $reply_data and length $reply_data ) {
    send $sock, $reply_data, 0, $from_addr;
}

0;

