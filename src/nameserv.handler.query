## [:< ##

# name  = nameserv.handler.query
# descr = handle incoming dns query packets

my $sock  = <nameserv.socket>;
my $zones = <nameserv.zones>;

## receive packet
my $from_addr = recv $sock, my $packet_data, 512, 0;
if ( not defined $from_addr ) {
    <nameserv.stats>->{'errors'}++;
    return;
}

## parse dns packet
my $packet = eval { Net::DNS::Packet->new( \$packet_data ) };
if ( not defined $packet or $@ ) {
    <nameserv.stats>->{'errors'}++;
    <[base.logs]>->( 0, "failed to parse dns packet: %s", $@ ) if $@;
    return;
}

my @questions = $packet->question();
if ( not @questions ) {
    ## no questions, ignore
    return;
}

my $qname = lc( $questions[0]->qname() );
my $qtype = $questions[0]->qtype();

<nameserv.stats>->{'queries'}++;

<[base.logs]>->( 3, ": dns query [ %s %s ]", $qname, $qtype );

## create reply packet
my $reply = Net::DNS::Packet->new( $qname, $qtype );
$reply->header->id( $packet->header->id );
$reply->header->qr(1);    ## set as response
$reply->header->aa(1);    ## authoritative answer

## find matching zone
my $zone_match = undef;
for my $zone_name ( keys %$zones ) {
    my $zone = $zones->{$zone_name};
    ## match exact zone or subdomain
    if ( $qname eq $zone_name or $qname =~ m|\.$zone_name$|i ) {
        $zone_match = $zone;
        last;
    }
}

my $found_answer = 0;

if ($zone_match) {
    my $ttl = $zone_match->{'ttl'};

    ## search records for match
    if ( $qname =~ m|^_protocol7\._tcp\.| ) {
        $found_answer = <[nameserv.handler.p7ref_lookup]>->(
            {   reply      => $reply,
                qname      => $qname,
                zone_match => $zone_match,
                ttl        => $ttl,
            }
        );
    } else {
        for my $rec ( @{ $zone_match->{'records'} } ) {
            my $rec_name = lc( $rec->{'name'} // '' );
            my $rec_type = $rec->{'type'} // '';

            ## match name and type
            next if $rec_name ne $qname;
            next if $rec_type ne $qtype;

            ## build rr using string-form constructor (phase-1 simple
            ## approach)
            my $value = $rec->{'value'} // '';
            my $rr_str
                = sprintf( "%s %d IN %s %s", $qname, $ttl, $qtype, $value );

            my $rr = eval { Net::DNS::RR->new($rr_str) };
            if ( defined $rr ) {
                $reply->push( answer => $rr );
                $found_answer = 1;
            } else {
                <[base.logs]>->(
                    0,      "failed to create rr for %s: %s",
                    $qname, $@
                ) if $@;
            }
        }
    }

    if ($found_answer) {
        $reply->header->rcode('NOERROR');
    } else {
        $reply->header->rcode('NXDOMAIN');
    }
} else {
    ## no zone match
    $reply->header->rcode('REFUSED');
}

## send response
my $reply_data = $reply->data;
if ( defined $reply_data and length $reply_data ) {
    send $sock, $reply_data, 0, $from_addr;
}

0;

