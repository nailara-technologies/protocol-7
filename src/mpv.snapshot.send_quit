## [:< ##

# name  = mpv.snapshot.send_quit
# descr = send 'quit' to the player once [ idempotent ] -- called as     ##
#         snapshot-save completion from mpv.cmd.quit and by its safety   ##
#         timer in case snapshot collection stalls                       ##

return if <mpv.snapshot.quit_sent> // FALSE;
<mpv.snapshot.quit_sent> = TRUE;

push( @{<mpv.reply_ids>}, <mpv.snapshot.quit_reply_id> // qw| silent | );
<mpv.success_reply_str> = 'shutting down mpv zenka';

<[mpv.send_command]>->('quit');

return;

