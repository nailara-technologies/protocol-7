## [:< ##

# name = tree.sort.trunk.remainder
# descr = return asymmetric survivors (the trunk)

my $args = shift // {};

my $unpaired  = $args->{'unpaired'}  // [];
my $residuals = $args->{'residuals'} // [];

my @trunk;

## [ collect unpaired entries ] ##
for my $entry (@$unpaired) {
    push @trunk, $entry;
}

## [ collect residuals as synthetic entries ] ##
for my $res (@$residuals) {
    push @trunk,
        {
        layer    => <[tree.sort.trunk.col_to_layer]>->( $res->{'col'} ),
        col      => $res->{'col'},
        row      => $res->{'row'},
        weight   => $res->{'weight'},
        residual => 1,
        };
}

## [ select highest-weight entry per column ] ##
my %by_col;
for my $entry (@trunk) {
    my $c = $entry->{'col'}
        // <[tree.sort.trunk.layer_to_col]>->( $entry->{'layer'} // '' );
    next if not defined $c;
    push @{ $by_col{$c} }, $entry;
}

my @result;
for my $c ( 0 .. 4 ) {
    my $list = $by_col{$c} // [];
    next if not @$list;
    my $best = $list->[0];
    for my $entry (@$list) {
        $best = $entry
            if ( $entry->{'weight'} // 0 ) > ( $best->{'weight'} // 0 );
    }
    push @result, $best;
}

return \@result;

