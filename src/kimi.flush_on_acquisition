## [:< ##

# name  = kimi.flush_on_acquisition
# descr = flush pending approvals when kimi session is acquired

my $href_pending = <kimi.approval.pending> // {};

## reset store first [ hashref ] : handler re-stores entries it leaves pending
## for manual approval : a trailing reset would wipe those
<kimi.approval.pending> = {};

foreach my $request_id ( keys %{$href_pending} ) {
    ## re-invoke handler with the original stored record [ not a blank payload
    ## ] so sudo check and auto_allow policy see real fields
    my $stored  = $href_pending->{$request_id} // {};
    my $payload = {
        'id'           => $request_id,
        'tool_call_id' => $stored->{'tool_call'}   // '',
        'sender'       => $stored->{'sender'}      // '',
        'action'       => $stored->{'action'}      // '',
        'description'  => $stored->{'description'} // ''
    };
    <[kimi.handler.approval_request]>->( $request_id, $payload );
}

