## [:< ##

# name  = claude.handler.reap
# descr = timer : collect an ended child's exit status

my $data  = shift->w->data // {};
my $child = <claude.child>;
return if not defined $child or $child->{'pid'} != ( $data->{'pid'} // 0 );
<[claude.child.reap]>->($child);

