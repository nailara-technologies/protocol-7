# name  = models.cmd.list-protected
# descr = list checksums on the delete-protection list
# note  = see models.cmd.protect / models.cmd.unprotect

<models.protected_checksums> //= <[models.trash.load_protected]>;

my $protected = <models.protected_checksums> // {};

unless ( keys %$protected ) {
    return { 'mode' => qw| size |, 'data' => "no protected checksums\n" };
}

my $out = '';
for my $checksum ( sort keys %$protected ) {
    my $info = $protected->{$checksum} // {};
    $out .= sprintf "%-16s %s\n", $checksum, $info->{'name'} // '';
}

return { 'mode' => qw| size |, 'data' => $out };

