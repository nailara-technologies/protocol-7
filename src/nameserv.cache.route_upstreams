# name  = nameserv.cache.route_upstreams
# param = <qname>
# descr = choose active or domain upstreams without local dns leaks

my $name = lc( shift // '' );
$name =~ s|\.$||;
my @entries = <[nameserv.upstream_entries]>;
my @static  = grep { $ARG->{'source'} eq qw| static | } @entries;
return map { $ARG->{'address'} } @static
    if <[nameserv.cache.own_name]>->($name);

my $domain  = <nameserv.upstreams.domain_by_source> // {};
my $longest = 0;
my @addresses;
foreach my $source ( sort keys $domain->%* ) {
    my $route = $domain->{$source};
    foreach my $suffix ( $route->{'domains'}->@* ) {
        next
            if $name ne $suffix
            and $name !~ m|\.\Q$suffix\E$|;
        if ( length($suffix) > $longest ) {
            $longest   = length($suffix);
            @addresses = ();
        }
        push @addresses, $route->{'addresses'}->@*
            if length($suffix) == $longest;
    }
}
my %seen;
return grep { not $seen{ lc $ARG }++ } @addresses if $longest;
return grep { not $seen{ lc $ARG }++ }
    map { $ARG->{'address'} } @entries;

