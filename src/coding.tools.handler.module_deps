# name  = coding.tools.handler.module_deps
# descr = dispatch module_deps tool call to context.module.dependencies handler

my $args = shift // {};

return $code{'context.module.dependencies'}->(
    {   'module' => $args->{'module'} // '',
        'budget' => $args->{'budget'} // 800,
    }
);

