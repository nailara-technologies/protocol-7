## [:< ##

# name   = coding.handover.write
# descr  = write the full handover block to its file
# return = ( TRUE, path ) or ( FALSE, error text )
#
# data/ai-mem/claude/handover-live.md [ overwritten each time, the one file
# the next session reads first ] -- no other file

my $text = <[coding.handover.render]>->(FALSE);
my $root = <coding.cfg.handover_root> // <system.root_path> // '';
my $path = "$root/data/ai-mem/claude/handover-live.md";
my $tmp  = "$path.tmp-$PID";
my $fail = sub {
    my $error = shift;
    CORE::unlink $tmp;
    return ( FALSE, "$path : $error" );
};
return $fail->('directory missing') if not -d "$root/data/ai-mem/claude";
CORE::open( my $fh, '>:encoding(UTF-8)', $tmp ) or return $fail->($OS_ERROR);
CORE::print {$fh} "# handover live [ coding.handover write ]\n\n", $text
    or return $fail->($OS_ERROR);
CORE::close $fh             or return $fail->($OS_ERROR);
CORE::rename( $tmp, $path ) or return $fail->($OS_ERROR);
return ( TRUE, $path );

