## [:< ##

# name = base.call_filter

my ( $filters, $key, $val, $params ) = ( shift, shift, shift, shift );

if ( defined $filters and exists $filters->{$key} ) {

    my $filter_spec = $filters->{$key};
    my $filter_name = $filter_spec;
    my $filter_param;

    # Check for inline parameter syntax: 'filter_name:param'
    if ( $filter_spec =~ m|^([^:]+):(.+)$| ) {
        $filter_name  = $1;
        $filter_param = $2;
    } else {

        # Fall back to legacy {key}_param convention
        my $filter_par_name = sprintf qw| %s_param |, $key;
        $filter_param = $filters->{$filter_par_name}
            if defined $filters->{$filter_par_name};
    }

    # Call filter if it exists
    if ( defined $code{$filter_name} ) {
        if ( defined $filter_param ) {
            return $code{$filter_name}->( $val, $filter_param );
        } else {
            return $code{$filter_name}->($val);
        }
    }
}

# unfiltered
return $val;

