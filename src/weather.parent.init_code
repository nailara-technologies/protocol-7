## use Encode; ##
<[base.perlmod.autoload]>->('Encode');
<[base.perlmod.autoload]>->('File::Copy');

<weather.zenka.initialized>        //= 0;
<weather.cache.max_age.station_id> //= 3600 * 24 * 7;    # default = 7 days
<weather.parked_replies>           //= {};
<weather.cfg.parked_timeout>       //= 30;

<weather.template_width>  = { '1' => 342, '2' => 342 + 349, '3' => 1040 };
<weather.template_height> = 130;

<weather.tile.adjust> //= 1;

0;

