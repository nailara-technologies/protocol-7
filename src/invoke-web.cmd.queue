## [:< ##

# name  = invoke-web.cmd.queue
# descr = invoke.ai queue counts and processor state

my $result = <[invoke-web.api]>->( 'GET', '/api/v1/queue/default/status' );

return {
    mode => qw| false |,
    data => sprintf( 'queue status failed [ %s ]', $result->{'status'} )
    }
    if not $result->{'ok'} or ref $result->{'data'} ne qw| HASH |;

my $queue = $result->{'data'}->{'queue'}     // {};
my $proc  = $result->{'data'}->{'processor'} // {};

return {
    mode => qw| size |,
    data => sprintf(
        "processor : %s%s\npending   : %d\nrunning   : %d [ item %s ]\n"
            . "completed : %d\nfailed    : %d\ncanceled  : %d\n",
        $proc->{'is_started'}    ? 'started' : 'paused',
        $proc->{'is_processing'} ? ' [ processing ]' : '',
        $queue->{'pending'}     // 0, $queue->{'in_progress'} // 0,
        $queue->{'item_id'}     // '-', $queue->{'completed'} // 0,
        $queue->{'failed'}      // 0, $queue->{'canceled'}    // 0
    )
};

