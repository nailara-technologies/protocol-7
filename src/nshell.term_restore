## [:< ##

# name = nshell.term_restore
# descr = Restore terminal settings after nshell session

## pop the keyboard-protocol negotiation from nshell.term_init, if the
## terminal understood it -- leaving it enabled would affect whatever runs in
## this terminal next, not just nshell
print "\e[<1u\e[>4;0m";

## clear any stray cursor rendering before restoring terminal
print "\e[0m\r\e[K";
STDOUT->flush();

## prefer tty_fd stored by term_init  [ fileno(STDIN) may be stale at exit
## time ]
my $tty_fd = $main::data{'nshell'}{'tty_fd'} // fileno(STDIN);
return FALSE if not defined $tty_fd or $tty_fd < 0;

## restore STDIN to blocking mode first
my $flags = fcntl( \*STDIN, F_GETFL, 0 );
fcntl( \*STDIN, F_SETFL, $flags & ~O_NONBLOCK ) if defined $flags;

## restore original terminal settings from backup  use TCSANOW (apply
## immediately) rather than TCSAFLUSH, which waits for i/o drain that never
## completes during a ctrl+c / signal exit path
my $orig_termios = $main::data{'nshell'}{'orig_termios'};
if ( defined $orig_termios ) {
    $orig_termios->setattr( $tty_fd, TCSANOW() );
    return TRUE;
}

## fallback: orig_termios unavailable : explicitly re-enable echo and
## canonical mode so the calling shell is not left in noecho / raw state
my $fallback = Linux::Termios2->new();
if ( $fallback->getattr($tty_fd) ) {
    my $lflag = $fallback->getlflag();
    $fallback->setlflag( $lflag | ECHO() | ICANON() | ISIG() );
    $fallback->setattr( $tty_fd, TCSANOW() );
}

return TRUE;

