## [:< ##

# name  = form.chrome.set_status
# descr = set the form's footer status text and repaint
# param = $text

my $text = shift;

<form.status> = defined $text ? $text : '';

## repaint through the SAME path a keystroke takes -- form.render is the
## base.event.add_var watcher on <form.dirty> -- rather than calling any
## render module directly : an async status update and a keystroke then stay
## indistinguishable to the repaint machinery, exactly the contract
## form.handler.stdin_key's header already documents
<form.dirty>++;

return TRUE;

