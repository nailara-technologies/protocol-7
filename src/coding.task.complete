## [:< ##

# name    = coding.task.complete
# descr   = mark coding task as completed
# purpose = coding task management
#           [ wrapper around jobqueue.move_job to mark job complete ]

my ( $task_id, $result ) = @ARG;

return {
    success => FALSE,
    error   => 'task_id required'
    }
    unless defined $task_id;

# Get task from coding task queue
my $queue_href = <coding.task.queue>;
my $task       = $queue_href->{$task_id};

return {
    success => FALSE,
    error   => "task not found : '$task_id'"
    }
    unless defined $task;

# Update task execution status
$task->{'execution'}->{'status'}    = qw| completed |;
$task->{'execution'}->{'result'}    = $result;
$task->{'execution'}->{'success'}   = TRUE;
$task->{'execution'}->{'completed'} = <[base.ntime]>;

# Move task to completed list
my $aref_pending   = <coding.task.pending>;
my $aref_active    = <coding.task.active>;
my $aref_completed = <coding.task.completed>;

$aref_pending->@* = grep { $ARG ne $task_id } $aref_pending->@*;
$aref_active->@*  = grep { $ARG ne $task_id } $aref_active->@*;
push $aref_completed->@*, $task_id;

<[base.logs]>->( 2, "task completed : %s", $task_id );

## resolve reasoning branch ##
<[reasoning.branch.resolve]>->(
    {   id     => $task_id,
        output => $result
    }
);

## persist result to disk for recovery after idle shutdown ##
if ( defined $result && length $result ) {
    my $written = <[file.zenka_dir.write]>->(
        "results/$task_id", \$result, '>', 0640, ':encoding(UTF-8)'
    );
    if ( defined $written ) {
        <[base.logs]>->( 2, "task result saved to disk : %s", $task_id );
    } else {
        <[base.logs]>->( 0, "task result save failed : %s", $task_id );
    }
}

## flush this task's ( task text -> modules touched ) pair to the           ##
## catalog-retrieval corpus [ inert unless coding.cfg.catalog_harvest is    ##
## enabled ]. THIS is the live completion path : coding.async.complete ->   ##
## coding.task.complete. the identical call in coding.task.queue_complete   ##
## only fires via the manual `coding.task.queue complete` dispatcher, which ##
## real tasks never take -- wiring it there alone meant the flush never ran ##
## live and touched-entries accumulated unboundedly [ confirmed 2026-09-09  ##
## ]. the queue_complete call stays : corpus.record deletes the touched     ##
## entry first thing, so a second call is a harmless no-op                  ##
<[coding.catalog.corpus.record]>->( { 'task_id' => $task_id } );

# Trigger task completion event handler (checks for auto-resume)
<[coding.event.on_task_complete]>->( $task_id, $result );

return {
    success => TRUE,
    task_id => $task_id,
    result  => $result,
    message => "task completed : $task_id"
};

