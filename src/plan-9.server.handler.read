## [:< ##
# name  = plan-9.server.handler.read
# descr = event.add_io callback for a connected 9P client socket -- reads
#         available bytes and hands them to plan-9.server.client.data,
#         which already correctly frames/dispatches 9P messages and was
#         just never fed any bytes. Mirrors proxy.handler.connection's
#         read/error/disconnect handling.

my $fd = shift->w->data;

my $client = <plan-9.server.clients>->{$fd};
return unless $client;

my $sock = $client->{'sock'};

my $chunk = '';
my $bytes = <[base.s_read]>->( $sock, \$chunk, 65536 );

if ( ( $bytes // -1 ) == -1 ) {
    <[base.logs]>->( "9P client fd=%d read error: %s", $fd, $OS_ERROR );
    <[plan-9.server.client.close]>->($fd);
    return;
}

if ( $bytes == 0 ) {
    <[plan-9.server.client.close]>->($fd);
    return;
}

<[plan-9.server.client.data]>->( $fd, $chunk );

return;

