## [:< ##

# name  = jobsite.sync.push_soon
# descr = schedule a debounced web-cache sync push

return if defined <jobsite.sync.soon_timer>;

<jobsite.sync.soon_timer> = <[event.add_timer]>->(
    {   'after'   => <jobsite.cfg.sync_soon_delay> // 3,
        'handler' => 'jobsite.handler.sync-soon',
    }
);

