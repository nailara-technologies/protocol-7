## [:< ##

# name = data.mount.shm.feedback.process
# descr = Writer-side ding processing : freshness + clock-regression guard

# thin zenka wrapper -> AMOS7::SHM::Feedback::process_feedback
# injects the real <[base.ntime]> [ no parameter, harmony-validated ] as the
# time_source used for the writer's own "now" check. the caller maintains the
# last_seen_ntime state across dings.

my ( $mount, $state, $options ) = @ARG;

$state   //= {};
$options //= {};

## zenka path : real network time through p7_ntime's harmony-retry loop ##
$options->{'time_source'} //= sub {<[base.ntime]>};

return AMOS7::SHM::Feedback::process_feedback( $mount, $state, $options );

