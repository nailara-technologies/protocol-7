## [:< ##

# name  = plugin.nshell.coding-session.on_escape
# descr = abort a bound task's live inference if still running [ first
#         press ], then step the task back one round via round_chain on
#         every press after that [ coding.cmd.rewind-round, no checksum ->
#         "one round back from the current tip" ] -- task_id itself is
#         NEVER unbound here, since coding.cmd.task-append can resume a
#         completed OR failed task from its saved history, and staying
#         bound means the next message naturally continues the same
#         conversation instead of losing it. non-destructive : rewinding
#         forks history rather than deleting it [ see coding.round_chain.
#         append's round_chain_current comment ], so redo [ F1 / Shift+
#         Esc, plugin.nshell.coding-session.on_redo ] can always step
#         forward again. Ctrl+C (on_ctrl_c) is the actual "detach/close
#         this tab" action, not Esc.
# param = { mode => $mode_href }
# return = { claimed => TRUE, redraw => TRUE|FALSE } | undef [ not claimed ]

my $args = shift // {};
my $mode = $args->{'mode'};

return undef unless defined $mode;

if (    defined $mode->{'task_id'}
    and length $mode->{'task_id'}
    and not $mode->{'esc_stage'} ) {

    ## first press since the last message was sent : always send the abort  ##
    ## -- this plugin runs inside the NSHELL zenka's own process, not the   ##
    ## coding zenka's, so <coding.task.active> here would only ever read    ##
    ## nshell's own local, never-populated copy of that key [ per-zenka     ##
    ## %data isolation ], not the coding zenka's real active-task list --   ##
    ## an earlier version gated on that read and it was always empty, so    ##
    ## the abort silently never got sent. coding.cmd.abort-inference        ##
    ## already does this exact "is it still running" check correctly,       ##
    ## server-side, with real data -- trust it, and let it harmlessly no-op ##
    ## if nothing was actually running [ e.g. this press landed after       ##
    ## natural completion ] rather than trying to guess here.               ##
    my ($cube_sid) = keys <user.cube.session>->%*;
    if ( defined $cube_sid and exists $data{'session'}{$cube_sid} ) {
        $data{'session'}{$cube_sid}{'buffer'}{'output'}
            .= "coding.abort-inference $mode->{'task_id'}\n";
    }

    ## this is routinely a no-op [ e.g. Esc between rounds, nothing      ##
    ## streaming ] -- suppress the raw wire reply either way. lives on   ##
    ## shared nshell state, not the mode object : nshell.handler.        ##
    ## command_reply checks it directly, BEFORE looking at which mode is ##
    ## even current -- on_ctrl_c needs this same flag to survive a       ##
    ## synchronous mode switch back to shell before the async reply      ##
    ## arrives, so both use the same mechanism rather than two           ##
    <nshell.state>->{'suppress_next_wire_reply'} = TRUE;

    ## armed : the NEXT Esc press [ with nothing new typed meanwhile ]      ##
    ## clears the buffer instead of re-sending an abort. on_submit clears   ##
    ## this flag again whenever a new message actually goes out, so a fresh ##
    ## round always gets its own "first press aborts" chance                ##
    $mode->{'esc_stage'} = TRUE;

    ## keep the visible transcript AND the task binding -- the user may    ##
    ## still want to see what was generated, and their next message should ##
    ## resume this same conversation via task-append, not start an         ##
    ## unrelated new one                                                   ##
    return { 'claimed' => TRUE, 'redraw' => FALSE };
}

if ( defined $mode->{'task_id'} and length $mode->{'task_id'} ) {

    ## armed [ abort already sent for this round, or a previous rewind      ##
    ## press already landed ] : step back one more round instead of just    ##
    ## clearing the screen. omitted checksum -> coding.round_chain.         ##
    ## step_target resolves "one back from the current tip" server-side.    ##
    ## esc_stage deliberately stays TRUE [ NOT cleared here ] so repeated   ##
    ## presses keep walking further back -- on_submit clears it the instant ##
    ## a real new message goes out, which is the only point a fresh "first  ##
    ## press aborts" cycle should start.                                    ##
    ##                                                                      ##
    ## NOT re-subscribing here : an earlier version queued                  ##
    ## coding.subscribe- session before this, so rewind-round's replay push ##
    ## [ via coding.  round_chain.restream ] would reach a live listener -- ##
    ## confirmed live that repeated pure-navigation presses each adding a   ##
    ## fresh listener [ never cleaned up, since navigation never completes  ##
    ## a round the way coding.async.state_machine's STATE_COMPLETE cleanup  ##
    ## expects ] left stale accumulated handles that broke a LATER real     ##
    ## round's actual content streaming. rewind-round now embeds its replay ##
    ## directly in its own reply text instead -- no listener, no            ##
    ## subscribe-session, nothing left lying around.                        ##
    my ($cube_sid) = keys <user.cube.session>->%*;
    if ( defined $cube_sid and exists $data{'session'}{$cube_sid} ) {
        $data{'session'}{$cube_sid}{'buffer'}{'output'}
            .= "coding.rewind-round $mode->{'task_id'}\n";
    }

    ## NOT suppressed, unlike the abort branch above : a rewind attempt can ##
    ## genuinely fail [ already at genesis, or the task hasn't settled from ##
    ## a just-sent abort yet -- still in_progress ], and its own reply --   ##
    ## either the embedded replay [ 'size' mode ] or a short rejection      ##
    ## message [ 'false' mode ] -- IS the confirmation the user needs.      ##
    ##                                                                      ##
    ## NOT clearing the buffer or requesting a redraw here, unlike an       ##
    ## earlier version : confirmed live that wiping the screen BEFORE the   ##
    ## command's own async reply arrives means a FAILED rewind [ "already   ##
    ## at the earliest round" etc ] leaves nothing but that one bare error  ##
    ## line on screen, with whatever was previously shown already gone --   ##
    ## same "clear now, hope the reply fills it back in" mistake the abort  ##
    ## branch above already avoids [ redraw => FALSE there too ]. leave the ##
    ## display exactly as-is and let the eventual reply -- success or       ##
    ## failure -- print via the normal content_print path instead.          ##
    return { 'claimed' => TRUE, 'redraw' => FALSE };
}

if ( length( $mode->{'buffer'} // '' ) ) {

    ## no task was ever bound : just a leftover transcript to clear for a ##
    ## visually fresh tab                                                 ##
    $mode->{'buffer'} = '';
    delete $mode->{'esc_stage'};
    return { 'claimed' => TRUE, 'redraw' => TRUE };
}

## nothing bound, nothing to clear : don't claim the key, let it fall ##
## through to the normal editor engine unchanged                      ##
return undef;

