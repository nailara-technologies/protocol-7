## [:< ##

# name  = plugin.nshell.coding-session.on_escape
# descr = abort a bound task's live inference if still running, else
#         clear a leftover transcript for a genuinely fresh tab
# param = { mode => $mode_href }
# return = { claimed => TRUE, redraw => TRUE|FALSE } | undef [ not claimed ]

my $args = shift // {};
my $mode = $args->{'mode'};

return undef unless defined $mode;

if ( defined $mode->{'task_id'} and length $mode->{'task_id'} ) {

    ## bound to a task : always send the abort -- this plugin runs inside   ##
    ## the NSHELL zenka's own process, not the coding zenka's, so           ##
    ## <coding.task.active> here would only ever read nshell's own local,   ##
    ## never-populated copy of that key [ per-zenka %data isolation ], not  ##
    ## the coding zenka's real active-task list -- an earlier version gated ##
    ## on that read and it was always empty, so the abort command silently  ##
    ## never got sent at all. coding.cmd.abort-inference already does this  ##
    ## exact "is it still running" check correctly, server-side, with real  ##
    ## data -- trust it rather than duplicating it here. unbind             ##
    ## unconditionally either way, so the NEXT message starts a fresh task  ##
    ## rather than trying [ and likely failing ] to task-append onto a now- ##
    ## completed/failed one. the interrupted turn itself is preserved       ##
    ## server-side by abort-inference's own partial-content-commit fix,     ##
    ## independent of anything done here.                                   ##
    my ($cube_sid) = keys <user.cube.session>->%*;
    if ( defined $cube_sid and exists $data{'session'}{$cube_sid} ) {
        $data{'session'}{$cube_sid}{'buffer'}{'output'}
            .= "coding.abort-inference $mode->{'task_id'}\n";
    }

    delete $mode->{'task_id'};
    delete $mode->{'awaiting_task_id'};

    ## keep the visible transcript -- this is the "first Esc" case, the ##
    ## user may still want to see what was generated before redirecting ##
    return { 'claimed' => TRUE, 'redraw' => FALSE };
}

if ( length( $mode->{'buffer'} // '' ) ) {

    ## no task bound [ already unbound by a prior Esc, or the task          ##
    ## finished/failed on its own ] but there's still a leftover transcript ##
    ## on screen : this is the "second Esc" case -- clear it for a          ##
    ## genuinely fresh tab                                                  ##
    $mode->{'buffer'} = '';
    return { 'claimed' => TRUE, 'redraw' => TRUE };
}

## nothing bound, nothing to clear : don't claim the key, let it fall ##
## through to the normal editor engine unchanged                      ##
return undef;

