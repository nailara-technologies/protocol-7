# name = tree.sort.trunk.halve_frequency
# descr = collapse 7 rows to single representative per column

my $grid = shift // [];

my @trunk_values;

for my $col ( 0 .. 4 ) {
    my $sum = 0;
    if ( defined $grid->[$col] ) {
        for my $r ( 0 .. 6 ) {
            my $entries = $grid->[$col][$r] // [];
            for my $entry (@$entries) {
                $sum += $entry->{'weight'} // 0;
            }
        }
    }
    ## [ halve: one full period collapses to net scalar ] ##
    push @trunk_values, int( $sum / 2 );
}

return \@trunk_values;

