## [:< ##

# name  = keys.console.prune-backups
# param = [name]|remove <name> <type> <bak> [--yes]
# descr = dedup backups, or explicitly remove one

my @args = @ARG;

if ( @args and $args[0] eq qw| remove | ) {
    shift @args;

    my $force = FALSE;
    if ( @args and $args[-1] eq qw| --yes | ) {
        $force = TRUE;
        pop @args;
    }

    my ( $key_name, $type, $backup_sel ) = @args;

    if (   not length( $key_name // '' )
        or not length( $type       // '' )
        or not length( $backup_sel // '' ) ) {
        return
            print "\n  << expected : remove <key_name> "
            . "<type> <backup_basename> [--yes] >>\n\n";
    }

    my $status = <[keys.backup.remove]>->(
        $key_name, $type, $backup_sel, { qw| force | => $force }
    );

    if ( not $status ) {
        printf "\n  << removal not completed >>\n\n";
        <[base.exit]>->(qw| 0110 |);
    } else {
        printf "\n  ::  removed backup '%s'  ::\n\n", $backup_sel;
        <[base.exit]>->(qw| 00000 |);
    }

} else {
    my $name_filter = shift @args;
    my $removed     = <[keys.backup.prune]>->($name_filter);

    printf "\n  ::  deduplicated %d redundant backup%s  ::\n\n",
        scalar(@$removed), ( @$removed == 1 ? '' : 's' );
    <[base.exit]>->(qw| 00000 |);
}

