## [:< ##

# name   = session_move.read_text
# descr  = a text file as one string
# args   = path
# return = text, or undef [ missing, a symlink ]

my $path = shift;
return undef if -l $path                         or not -f $path;
CORE::open( my $fh, '<:encoding(UTF-8)', $path ) or return undef;
local $RS = undef;
my $text = <$fh>;
CORE::close($fh);
return $text // '';

