## [:< ##

# name  = transport.profile.match
# descr = match request context to transport profile name
# args  = $context_hash

my $ctx = shift // return qw| default |;

my $dest = $ctx->{'session'}{'destination'} // $ctx->{'request'}{'domain'}
    // '';
my $tags = $ctx->{'transport'}{'tags'} // [];

my $profile_dir = <transport.cfg.profile_dir>
    // 'data/yaml/transport/profiles';

## helper: scan profile files ##
my @profile_files;
if ( opendir my $dh, $profile_dir ) {
    @profile_files = sort grep {m|\.yaml\z|} readdir $dh;
    closedir $dh;
}

## 1. owner-marked site group -> exit endpoint ##
if ( length $dest and ref <transport.exit_groups> eq qw| HASH | ) {
    my $group_dest = $dest;
    $group_dest =~ s|:[0-9]+\z||;
    my @labels = split m|\.|, lc $group_dest;
    my $marked_exit;
    while ( @labels and not defined $marked_exit ) {
        my $node = <transport.exit_groups>;
        for my $label (@labels) {
            $node = ref $node eq qw| HASH | ? $node->{$label} : undef;
            last if not defined $node;
        }
        $marked_exit = $node if defined $node and ref $node eq '';
        shift @labels;
    }

    if ( defined $marked_exit and length $marked_exit ) {
        for my $file (@profile_files) {
            my $pname = $file;
            $pname =~ s|\.yaml\z||;
            my $prof = <[transport.profile.load]>->($pname);
            next unless defined $prof;
            for my $entry ( @{ $prof->{'transports'} // [] } ) {
                if ( ( $entry->{'endpoint'} // '' ) eq $marked_exit ) {
                    $ctx->{'transport'}{'exit'} = $marked_exit;
                    return $pname;
                }
            }
        }
        <[base.logs]>->(
            0, 'transport.profile.match: no profile entry for marked exit %s',
            $marked_exit
        );
    }
}

## 2. explicit destination match ##
if ( length $dest ) {
    my $exact = $dest;
    $exact =~ s|\.host\z||;

    ## check by file name first ##
    for my $file (@profile_files) {
        my $pname = $file;
        $pname =~ s|\.yaml\z||;
        return $pname if $pname eq $exact;
    }

    ## then check context.destination inside each profile ##
    for my $file (@profile_files) {
        my $pname = $file;
        $pname =~ s|\.yaml\z||;
        next if $pname eq qw| default |;

        my $prof = <[transport.profile.load]>->($pname);
        next unless defined $prof;

        my $pdest = $prof->{'context'}{'destination'} // '';
        return $pname if length $pdest and $pdest eq $dest;
    }
}

## 3. tag match ##
if ( ref $tags eq qw| ARRAY | and @$tags ) {
    for my $file (@profile_files) {
        my $pname = $file;
        $pname =~ s|\.yaml\z||;
        next if $pname eq qw| default |;

        my $prof = <[transport.profile.load]>->($pname);
        next unless defined $prof;

        my $ptags = $prof->{'context'}{'tags'} // [];
        next unless ref $ptags eq qw| ARRAY |;

        my %ptag_map = map { $ARG => 1 } @$ptags;
        for my $tag (@$tags) {
            return $pname if exists $ptag_map{$tag};
        }
    }
}

## 4. subnet/domain pattern match ##
if ( length $dest ) {
    for my $file (@profile_files) {
        my $pname = $file;
        $pname =~ s|\.yaml\z||;
        next if $pname eq qw| default |;

        my $prof = <[transport.profile.load]>->($pname);
        next unless defined $prof;

        my $patterns = $prof->{'context'}{'patterns'} // [];
        next unless ref $patterns eq qw| ARRAY |;

        for my $pat (@$patterns) {
            return $pname if $dest =~ m|$pat|;
        }
    }
}

## 5. default profile ##
return qw| default |;

