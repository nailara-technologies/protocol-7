## [:< ##

# name  = work.console.sig-update
# descr = update all source code signatures

say '';
say ' .:[ WORKFLOW: UPDATE ALL SIGNATURES ]:.';
say '';

system( './bin/Protocol-7', 'sourcecode', 'update-signatures' );
my $exit_code = $? >> 8;

say '';
if ( $exit_code == 0 ) {
    say ' : ✓ Signatures updated successfully';
} else {
    say sprintf ' : ✗ Update failed (exit code: %d)', $exit_code;
}
say '';

return $exit_code;

