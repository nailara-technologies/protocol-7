## [:< ##

# name  = amos-term.handler.interaction-changed
# descr = Interaction prototype: accumulate user reply, deliver to pending caller
#
# Invoked via the on_buffer_change dispatch in amos-term.buffer-write for any
# non-interaction client writing into the 'agent.interaction' buffer. Reply
# completes on newline; the pending question's reply_handler is then called as
# ->( $question, $reply_text ) and the pending state is cleared.

my ( $attach_id, $change_info ) = @ARG;

## === ignore own writes [ question text from the interaction client ] === ##
return TRUE if ( $change_info->{'client_type'} // qw|| ) eq qw| interaction |;

my $state = <amos-term.interaction.state>;
return TRUE unless defined $state and defined $state->{'pending'};

my $char = $change_info->{'char'};
return TRUE unless defined $char;

if ( $char eq "\n" or $char eq "\r" ) {

    ## === reply complete -> deliver to calling task === ##
    my $pending = $state->{'pending'};
    my $reply   = $state->{'reply_buffer'} // qw||;

    $state->{'pending'}      = undef;
    $state->{'reply_buffer'} = qw||;

    ## === cancel timeout timer === ##
    if ( defined $state->{'timeout_timer'}
        and not $state->{'timeout_timer'}->is_cancelled ) {
        $state->{'timeout_timer'}->cancel;
    }

    <[base.logs]>->(
        2,              "[interaction] reply received [%d chars] : %s",
        length($reply), $reply
    );

    my $handler = $pending->{'reply_handler'} // return TRUE;
    if ( ref $handler eq 'CODE' ) {
        $handler->( $pending->{'question'}, $reply );
    } else {
        <[base.load_code]>->($handler)
            if not defined $code{$handler};
        $code{$handler}->( $pending->{'question'}, $reply )
            if defined $code{$handler};
    }

} else {
    ## === accumulate reply character === ##
    $state->{'reply_buffer'} .= $char;
}

return TRUE;

