## [:< ##

# name  = thermal.gate.decide
# descr = apply thermal thresholds with hysteresis and dwell

my ( $gate, $now ) = @ARG;

return FALSE if ref $gate ne qw| HASH |;
return FALSE if not defined $gate->{'avg_short'};

my $ceiling = <thermal.cfg.ceiling> // 83.0;
my $temp    = $gate->{'avg_short'};
$temp = $gate->{'avg_long'} if $gate->{'avg_long'} > $temp;

if ( $temp >= $ceiling ) {
    $gate->{'state_since'} = $now
        if ( $gate->{'state'} // '' ) ne qw| hot |;
    $gate->{'state'} = qw| hot |;
    return $gate->{'state'};
}

if ( exists $gate->{'fault'} ) {
    $gate->{'state'} = qw| hot |;
    return $gate->{'state'};
}

my $predicted = <[thermal.gate.predict]>->($gate);
$temp = $predicted if defined $predicted and $predicted > $temp;

my $window
    = defined $gate->{'window'}
    ? $gate->{'window'}
    : <[thermal.window.current]>->($now);
my $cold_mark
    = $window eq qw| night |
    ? <thermal.cfg.night.cold> // 8.0
    : <thermal.cfg.cold> // 4.5;
if ( ( <thermal.cfg.mode> // qw| relative | ) eq qw| relative |
    and $window eq qw| night | ) {
    $cold_mark *= $gate->{'amp'} // <[thermal.outdoor.amp]>->(
        <thermal.outdoor.temp>, <thermal.outdoor.at>, $now
    );
}
$cold_mark += $gate->{'baseline'}
    if ( <thermal.cfg.mode> // qw| relative | ) eq qw| relative |;
my $hot_mark = <[thermal.gate.hot_mark]>->( $gate, $now );

my $next_state = qw| warm |;
$next_state = qw| cold | if $temp < $cold_mark;
$next_state = qw| hot |  if $temp > $hot_mark;

my $state = $gate->{'state'};
if ( not defined $state ) {
    $gate->{'state'}       = $next_state;
    $gate->{'state_since'} = $now;
} elsif ( $next_state ne $state
    and $now - $gate->{'state_since'} >= ( <thermal.cfg.dwell> // 120 ) ) {
    $gate->{'state'}       = $next_state;
    $gate->{'state_since'} = $now;
}

return $gate->{'state'};

