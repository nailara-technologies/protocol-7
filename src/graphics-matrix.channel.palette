## [:< ##

# name  = graphics-matrix.channel.palette
# descr = generate full palette for current channel from glow shells

my $glow   = <graphics-matrix.glow>;
my $shells = $glow->{'shells'};
my @palette;

## no cells placed yet : synthesize palette from channel hue_base ##
if ( not defined $shells or not keys %$shells ) {
    for my $hop ( 0 .. 5 ) {
        my $intensity = 0.2 + $hop * ( 0.8 / 5 );
        my $color     = <[graphics-matrix.channel.translate]>->(
            {   qw| intensity | => $intensity,
                qw| channel   | => <graphics-matrix.channel.active>,
            }
        );
        push @palette,
            {
            qw| hop |       => $hop,
            qw| intensity | => $intensity,
            qw| color |     => $color
            };
    }
    return \@palette;
}

for my $hop ( sort { $a <=> $b } keys %$shells ) {
    my $shell     = $shells->{$hop};
    my $intensity = $shell->{'intensity'} // 0.0;

    my $color = <[graphics-matrix.channel.translate]>->(
        {   qw| intensity | => $intensity,
            qw| channel   | => <graphics-matrix.channel.active>,
        }
    );

    push @palette,
        {
        qw| hop |       => int($hop),
        qw| intensity | => $intensity,
        qw| color |     => $color,
        };
}

return \@palette;

