## [:< ##
# name  = plan-9.protocol.error
# descr = Encode 9P error responses

my ( $tag, $error ) = @ARG;

my $resp = <[plan-9.protocol.codec.encode-string]>->($error);

return <[plan-9.protocol.codec.encode-message]>->(
    <plan-9.protocol.constants.Rerror>,
    $tag, $resp
);

