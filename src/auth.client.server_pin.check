## [:< ##

# name   = auth.client.server_pin.check
# descr  = verify a server's host-root delegation + pin the host-root
#          fingerprint [ client TOFU, data/md/design/HOST-ROOT-
#          DELEGATION.md ]
# param  = <host> <port> <server_pub [ raw 32 bytes ]> <delegation [ b32 ]>
# return = TRUE [ delegation verified : pinned now or matches the pin ],
#          FALSE [ refuse ]
#
# pin file : ~/.n/remote-keys/servers/<host>_<port>.public, content
# exactly '<77 char host-root fingerprint>\n' [ shared with the C
# client ]. the delegation must verify [ trust.verify : sig, time, the
# subject == the announced S, name, scope ] under the pinned host-root ;
# S itself may rotate. first contact verifies under the statement's own
# issuer and only THEN pins it [ log level 0 'pinned host-root <fp>
# [ <name> ]' ]. a later different host-root is refused and NEVER
# re-pinned automatically ; a pin file that cannot be read or does not
# hold a fingerprint [ an old 52 char S pin included ] : refused.

my ( $host, $port, $server_pub, $delegation ) = @ARG;

my $refuse = sub {
    <[base.logs]>->( 0, '[#] server key pin : %s', shift );
    return FALSE;
};

return $refuse->('host \ port missing')
    if not defined $host
    or not defined $port;

$host = lc $host;

## the host becomes part of a file name : tight charset, no dot runs ##
return $refuse->('host not usable as pin name')
    if $host !~ m|\A[a-z0-9][a-z0-9.:-]{0,252}\z|
    or index( $host, '..' ) != -1;
return $refuse->('port not valid')
    if $port !~ m|\A[0-9]{1,5}\z|
    or $port < 1
    or $port > 65535;
return $refuse->('server key is not 32 bytes')
    if not defined $server_pub
    or length($server_pub) != 32;

foreach my $sub (qw| trust.statement trust.verify trust.fingerprint |) {
    return $refuse->("module $sub not loaded")
        if ref $code{$sub} ne qw| CODE |;
}

## the statement's own issuer [ verified below, before anything is kept ] ##
my ( $statement, $parse_err )
    = <[trust.statement]>->( qw| parse_wire |, $delegation );
return $refuse->( 'delegation not valid [ ' . ( $parse_err // '?' ) . ' ]' )
    if not defined $statement;
my $issuer_fp = <[trust.fingerprint]>->( $statement->{'issuer_pub'} );
return $refuse->('delegation issuer not valid') if not defined $issuer_fp;

my $verify = sub {    ## ( result ) or ( undef, reason ) ##
    my $anchor = shift;
    return <[trust.verify]>->(
        {   qw| chain |   => [$delegation],
            qw| anchors | => [$anchor],
            qw| subject | => $server_pub,
            qw| now |     => time,
        }
    );
};

my $home_dir = <[base.get_homedir]>->();
return $refuse->('no home directory')
    if not defined $home_dir
    or not length $home_dir
    or not -d $home_dir;

my $pin_dir = join( qw| / |, $home_dir, qw| .n remote-keys servers | );
## same file name as the C client [ p7-auth-keypair-helper.pl ] : ':' -> ##
## '_'                                                                   ##
( my $host_safe = $host ) =~ tr{:}{_};
my $pin_path = sprintf( qw| %s/%s_%d.public |, $pin_dir, $host_safe, $port );

## compare against an existing pin ##
my $compare = sub {
    open( my $pin_fh, '<', $pin_path )
        or return $refuse->("pin file not readable [ $pin_path ]");
    my $pinned = readline($pin_fh);
    close($pin_fh);
    $pinned //= '';
    $pinned =~ s{\s+\z}{};
    return $refuse->(
        "pin file holds an old server key pin, never migrated [ $pin_path ]")
        if $pinned =~ m|\A[A-Z2-7]{52}\z|;
    return $refuse->("pin file not valid [ $pin_path ]")
        if $pinned !~ m|\A[A-Z2-7]{77}\z|;
    if ( $pinned ne $issuer_fp ) {
        <[base.logs]>->(
            0, '[#] host-root MISMATCH for %s:%d [ pinned %s, got %s ]',
            $host, $port, $pinned, $issuer_fp
        );
        return FALSE;
    }
    my ( $valid, $why ) = $verify->($pinned);
    return $refuse->( 'delegation refused [ ' . ( $why // '?' ) . ' ]' )
        if ref $valid ne qw| HASH |;
    return TRUE;
};

return $compare->() if -e $pin_path or -l $pin_path;

## first contact : the delegation must verify BEFORE anything is pinned ##
my ( $valid, $why ) = $verify->($issuer_fp);
return $refuse->( 'delegation refused [ ' . ( $why // '?' ) . ' ]' )
    if ref $valid ne qw| HASH |;

## create the pin [ exclusive, 0600 ] ##
foreach my $dir ( join( qw| / |, $home_dir, qw| .n | ),
    join( qw| / |, $home_dir, qw| .n remote-keys | ), $pin_dir ) {
    next if -d $dir;
    mkdir( $dir, 0700 )
        or -d $dir
        or return $refuse->("cannot create $dir : $OS_ERROR");
}

require Fcntl;
my $pin_fh;
if (not sysopen(
        $pin_fh,                                                $pin_path,
        Fcntl::O_WRONLY() | Fcntl::O_CREAT() | Fcntl::O_EXCL(), 0600
    )
) {
    ## created concurrently : the existing pin decides ##
    return $compare->() if -e $pin_path;
    return $refuse->("cannot write pin $pin_path : $OS_ERROR");
}
my $written = print {$pin_fh} $issuer_fp, "\n";
if ( not close($pin_fh) or not $written ) {
    unlink($pin_path);
    return $refuse->("cannot write pin $pin_path");
}

<[base.logs]>->(
    0, '[*] pinned host-root %s [ %s ] [ %s:%d ]',
    $issuer_fp, $valid->{'name'}, $host, $port
);

return TRUE;

