## [:< ##

# name   = auth.client.server_pin.check
# descr  = pin \ check a server's announced Ed25519 key [ client TOFU ]
# param  = <host> <port> <server_pub [ raw 32 bytes ]>
# return = TRUE [ pinned now or matches the pin ], FALSE [ refuse ]
#
# pin file : ~/.n/remote-keys/servers/<host>_<port>.public [ S_pub b32 ].
# first contact pins it [ log level 0 'pinned server key <b32>' ] ; a
# later mismatch is refused and NEVER re-pinned automatically. a pin file
# that exists but cannot be read or does not hold a valid key : refused.

my ( $host, $port, $server_pub ) = @ARG;

my $refuse = sub {
    <[base.logs]>->( 0, '[#] server key pin : %s', shift );
    return FALSE;
};

return $refuse->('host \ port missing')
    if not defined $host
    or not defined $port;

$host = lc $host;

## the host becomes part of a file name : tight charset, no dot runs ##
return $refuse->('host not usable as pin name')
    if $host !~ m|\A[a-z0-9][a-z0-9.:-]{0,252}\z|
    or index( $host, '..' ) != -1;
return $refuse->('port not valid')
    if $port !~ m|\A[0-9]{1,5}\z|
    or $port < 1
    or $port > 65535;
return $refuse->('server key is not 32 bytes')
    if not defined $server_pub
    or length($server_pub) != 32;

my $server_pub_b32 = Crypt::Misc::encode_b32r($server_pub);

my $home_dir = <[base.get_homedir]>->();
return $refuse->('no home directory')
    if not defined $home_dir
    or not length $home_dir
    or not -d $home_dir;

my $pin_dir = join( qw| / |, $home_dir, qw| .n remote-keys servers | );
## same file name as the C client [ p7-auth-keypair-helper.pl ] : ':' -> ##
## '_'                                                                   ##
( my $host_safe = $host ) =~ tr{:}{_};
my $pin_path = sprintf( qw| %s/%s_%d.public |, $pin_dir, $host_safe, $port );

## compare against an existing pin ##
my $compare = sub {
    open( my $pin_fh, '<', $pin_path )
        or return $refuse->("pin file not readable [ $pin_path ]");
    my $pinned = readline($pin_fh);
    close($pin_fh);
    $pinned //= '';
    $pinned =~ s{\s+\z}{};
    return $refuse->("pin file not valid [ $pin_path ]")
        if $pinned !~ m|\A[A-Z2-7]{52}\z|;
    if ( $pinned ne $server_pub_b32 ) {
        <[base.logs]>->(
            0, '[#] server key MISMATCH for %s:%d [ pinned %s, got %s ]',
            $host, $port, $pinned, $server_pub_b32
        );
        return FALSE;
    }
    return TRUE;
};

return $compare->() if -e $pin_path or -l $pin_path;

## first contact : create the pin [ exclusive, 0600 ] ##
foreach my $dir ( join( qw| / |, $home_dir, qw| .n | ),
    join( qw| / |, $home_dir, qw| .n remote-keys | ), $pin_dir ) {
    next if -d $dir;
    mkdir( $dir, 0700 )
        or -d $dir
        or return $refuse->("cannot create $dir : $OS_ERROR");
}

require Fcntl;
my $pin_fh;
if (not sysopen(
        $pin_fh,                                                $pin_path,
        Fcntl::O_WRONLY() | Fcntl::O_CREAT() | Fcntl::O_EXCL(), 0600
    )
) {
    ## created concurrently : the existing pin decides ##
    return $compare->() if -e $pin_path;
    return $refuse->("cannot write pin $pin_path : $OS_ERROR");
}
my $written = print {$pin_fh} $server_pub_b32, "\n";
if ( not close($pin_fh) or not $written ) {
    unlink($pin_path);
    return $refuse->("cannot write pin $pin_path");
}

<[base.logs]>->(
    0, '[*] pinned server key %s [ %s:%d ]',
    $server_pub_b32, $host, $port
);

return TRUE;

