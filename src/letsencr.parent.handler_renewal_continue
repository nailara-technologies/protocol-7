## [:< ##

# name  = letsencr.parent.handler_renewal_continue
# descr = continue renewal check after receiving vhost list from httpd

my $reply_data = shift @ARG;
my $params     = shift @ARG;

<[base.logs]>->( 2, 'renewal check continuing with vhost query reply' );

## validate reply structure
unless ( $reply_data && ref($reply_data) eq qw| HASH | ) {
    <[base.log]>->( 0, 'vhost reply structure from httpd is not valid' );
    return FALSE;
}

## parse reply based on mode  reply text : 'data' for a SIZE reply , ##
## call_args for a one line reply                                    ##
my $mode           = $reply_data->{'cmd'} // $reply_data->{'mode'};
my $reply_data_str = $reply_data->{'data'}
    // $reply_data->{'call_args'}->{'args'} // '';

unless ($mode) {
    <[base.log]>->( 0, 'httpd vhost-list returned no mode field' );
    return FALSE;
}

## parse vhost list from reply
my @vhosts;
if ( $mode eq qw| SIZE | || $mode eq qw| TRUE | ) {
    ## both SIZE and TRUE modes return multi-line vhost names
    @vhosts = grep { length($ARG) > 0 } split( m|\n|, $reply_data_str );
} else {
    ## FALSE or unexpected mode : no new domains, but still check known certs
    <[base.logs]>->(
        2, 'httpd vhost-list returned %s : checking known certs only', $mode
    );

    ## httpd not online yet [ startup order ] : repeat the discovery when ##
    ## it is -- v7-zenki.notify_online, as base.log.send-buffer does      ##
    my $client_not_present = <[base.sprint_t]>->( qw| IRW7V6A |, '' );
    $client_not_present =~ s|^FALSE ||;
    chomp $client_not_present;

    <[letsencr.parent.wait_httpd_online]>
        if $reply_data_str eq $client_not_present;
}

## remove whitespace and filter empty lines
@vhosts = map { s{^\s+|\s+$}{}g; $ARG } @vhosts;
@vhosts = <[base.sort]>->( grep { length($ARG) > 0 } @vhosts );

if ( @vhosts > 0 ) {
    <[base.logs]>->(
        2,               'found %d vhost%s from httpd',
        scalar(@vhosts), <[base.cnt_s]>->( scalar(@vhosts) )
    );
    foreach my $vh (@vhosts) {
        <[base.logs]>->( 3, '  - %s', $vh );
    }
} else {
    <[base.log]>->(
        2, ': no vhosts from httpd : proceeding with registry renewal only'
    );
}

## step 2: determine certificate domains from vhosts (skip if none)
my %domains_map;
if ( @vhosts > 0 ) {
    my $domain_result
        = <[letsencr.parent.determine_certificate_domains]>->( \@vhosts );
    ## determine_certificate_domains logs the result itself ##
    if ( $domain_result && $domain_result->{status} eq qw| success | ) {
        %domains_map = %{ $domain_result->{'domains'} // {} };
    } else {
        <[base.log]>->(
            1, 'cannot determine certificate domains from vhosts'
        );
    }
}

## step 3: refresh registry (load from disk in case of external updates)
my $refresh_result = <[letsencr.parent.load_certificate_registry]>;
if ( !$refresh_result || $refresh_result->{status} eq qw| error | ) {
    <[base.log]>->(
        2, ': note : no stored certificates yet [ first renewal check ]'
    );
    ## not an error - continue with enrollment for new domains
}

## step 4: check which certificates need renewal
my $check_result = <[letsencr.parent.check_certificate_expiration]>
    ->(<letsencr.parent.certs>);
unless ( $check_result && ref($check_result) eq qw| HASH | ) {
    <[base.log]>->( 0, 'cannot check certificate expiration' );
    return FALSE;
}

my @needs_renewal = @{ $check_result->{'needs_renewal'} // [] };
my @expiring_soon = @{ $check_result->{'expiring_soon'} // [] };

if ( @expiring_soon > 0 ) {
    <[base.logs]>->(
        1, ': warning : %d certificates expiring soon',
        scalar(@expiring_soon)
    );
}

## step 5: queue renewal requests for domains needing renewal [ ##
## queue_renewal_requests logs the result itself ]              ##
<[letsencr.parent.queue_renewal_requests]>->( \@needs_renewal );

## also check for new domains that need certificates  (have vhosts but no
## certificate)
my @new_domains;
foreach my $domain ( keys %domains_map ) {
    unless ( exists <letsencr.parent.certs>->{$domain} ) {
        push @new_domains, $domain;
    }
}

if ( @new_domains > 0 ) {
    <[base.logs]>->(
        2,                    'found %d domain%s with no certificate yet',
        scalar(@new_domains), <[base.cnt_s]>->( scalar(@new_domains) )
    );
    ## TODO: implement automatic enrollment for new domains  for now, just log
    ## that they need certificates
}

<[base.log]>->( 2, 'renewal check complete' );

return TRUE;

