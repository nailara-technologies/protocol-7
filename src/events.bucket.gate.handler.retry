## [:< ##

# name   = events.bucket.gate.handler.retry
# descr  = re-check timer of a closed gate : ask usage again
#
# a timer handler gets the event : the entry comes from its data

my $event = shift;
my $d     = eval { $event->w->data } // {};
my ( $owner, $id ) = ( $d->{'owner'} // '', $d->{'id'} // '' );
delete <events.gate_timers>->{"$owner/$id"} if <events.gate_timers>;
my $bucket = <[events.bucket.get]>->($owner) // return FALSE;
my $e      = $bucket->{'entries'}{$id}       // return FALSE;
return FALSE
    if ( $e->{'added'} // '' ) ne ( $d->{'added'} // '' )
    or ( $e->{'state'} // '' ) ne qw| waiting |
    or ( $e->{'gate'}  // '' ) ne qw| closed |;
delete $e->{'gate'};
<[events.bucket.evaluate]>->($owner);
return TRUE;

