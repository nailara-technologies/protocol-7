## [:< ##

# name  = base.chk-sum.bmw.filesum
# descr = BASE32 BMW file checksum [ 224 256 384 512 bit ]
# note  = this will block on large files --> event based async. method ..,
# param = <bit-size> <file-path>

my $bit_size = shift;
if ( not defined $bit_size or $bit_size !~ m,^(224|256|384|512)$, ) {
    warn 'expected bit-size parameter <{C1}>';
    return undef;
}
my $fname = shift;
if ( not $fname ) {
    warn 'expected file name parameter <{C1}>';
    return undef;
}
if ( not -f $fname ) {
    warn sprintf( "file '%s' not found <{C1}>", $fname );
    return undef;
}

my $bmw = <[chk-sum.bmw.ctx]>->($bit_size);

open( my $SUM_FD, qw| <:raw |, $fname ) or do {
    warn sprintf '<< %s : %s >>', $fname, <[base.str.os_err]>;
    return undef;
};

$bmw->addfile($SUM_FD);

close($SUM_FD);

return encode_b32r( $bmw->digest );

