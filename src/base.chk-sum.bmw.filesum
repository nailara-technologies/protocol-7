#I3Z56FAX75X5DTH2T63UIBJBFUSG7RSWWWAZYURQHASPZ56KSVDGOISOAMHG4W677QVIQ7CFYEEAO
#\\\|RV7Z2XLBKQJD2SEQU3RUHYOQ5UCQMW3EA7RHZ6CB54IQDIHHIF3 \ / AMOS7 \ YOURUM ::
#\[7]4C56LNFYZIWYDGM37QJU2IHDBONSXEDL63PDS65SFXU5IU4DQCCI 7  DATA SIGNATURE ::
