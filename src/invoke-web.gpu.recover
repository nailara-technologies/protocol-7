## [:< ##

# name   = invoke-web.gpu.recover
# descr  = a render hit 'CUDA error' : invoke.ai's gpu context is broken and
#          every following item fails within a second [ the whole queue
#          drains into failed ]. pause the queue, restart invoke.ai, retry
#          the cuda-failed items, resume
# param  = [ queue item id of the failed render ]
# note   = steps : this pause -> handler.gpu_pause_reply [ stop ] ->
#          handler.recover_restart [ start ] -> ready : startup pause ->
#          recover.requeue -> handler.recover_requeue_reply [ resume ]. at most 3
#          recoveries per hour, then only the pause [ a broken gpu \ driver
#          must not become a restart loop ]

my $item = shift;

return if defined <invoke-web.recover>;    ## one recovery at a time ##

my $now    = <[base.time]>->(3);
my $recent = <invoke-web.gpu_recoveries> //= [];
$recent->@* = grep { $now - $ARG < 3600 } $recent->@*;
my $restart = $recent->@* < 3 ? TRUE : FALSE;
push $recent->@*, $now if $restart;

<invoke-web.recover> = {
    'kind'    => qw| gpu |,
    'time'    => $now,
    'item'    => $item,
    'restart' => $restart,
};

<[base.logs]>->(
    0,
    'gpu : cuda error [ item %s ] -- pausing the queue%s',
    $item // '?',
    $restart
    ? ', restarting invoke.ai'
    : ' only [ 3 recoveries this hour, needs a look ]'
);

<[invoke-web.api_async]>->(
    'PUT', '/api/v1/queue/default/processor/pause',
    undef, 'invoke-web.handler.gpu_pause_reply'
);

return TRUE;

