## [:< ##

# name  = events.signal.decode
# descr = journal field unescape [ inverse of events.signal.encode ]
my $text = shift // '';
return '' if $text eq qw| - |;
$text =~ s|%([0-9A-Fa-f]{2})|chr hex $1|eg;
utf8::decode($text);
return $text;

