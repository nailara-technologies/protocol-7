# name  = pager.view.amos-data-pager
# descr = Integration with bin/amos-data-pager for 72-bit visualization

my ($args) = @ARG;

my $buffer_id = $args->{'buffer_id'};
my $buf       = $data{'pager'}{'buffers'}{$buffer_id};
return undef unless $buf;

my $start     = $args->{'start'}     // 0;
my $lines     = $args->{'lines'}     // 20;
my $temp_file = $args->{'temp_file'} // "/tmp/pager-$buffer_id-$$.bin";

# Export current viewport to binary format for amos-data-pager
my $page_size  = $buf->{'pages'}{'size'};
my $start_page = int( $start / $page_size );

# Gather items from buffer
my @items;
for my $page_num ( $start_page .. $start_page + 1 ) {
    my $page = <[pager.buffer.page.get]>->( $buf, $page_num );
    push @items, @$page if $page;
}

# Convert items to binary representation
# 72-bit = 9 bytes per row
open( my $fh, '>:raw', $temp_file ) or return undef;

for my $i ( 0 .. $lines - 1 ) {
    my $item = $items[ $start + $i - ( $start_page * $page_size ) ];

    if ( $item && $item->{'checksum'} ) {

        # Decode base32 checksum to binary
        my $bin = <[base32.decode]>->( $item->{'checksum'} );

        # Pad/truncate to 9 bytes (72 bits)
        $bin = substr( $bin . "\0" x 9, 0, 9 );
        print $fh $bin;
    } elsif ( $item && $item->{'path'} ) {

        # Encode path as 72-bit fingerprint
        my $bin = <[base32.decode]>
            ->( <[chk-sum.bmw.L13-str]>->( $item->{'path'} ) );
        $bin = substr( $bin . "\0" x 9, 0, 9 );
        print $fh $bin;
    } else {

        # Empty row
        print $fh "\0" x 9;
    }
}

close($fh);

# Launch amos-data-pager
my $cmd = "$data{'path'}{'bin'}/amos-data-pager '$temp_file'";

if ( $args->{'async'} ) {

    # Non-blocking launch
    system("$cmd &");
    return { 'temp_file' => $temp_file };
} else {

    # Blocking launch
    system($cmd);
    unlink($temp_file) unless $args->{'keep_temp'};
    return 1;
}

