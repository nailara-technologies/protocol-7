## [:< ##

# name  = network.cmd.dns-policy
# descr = list dns policy and dhcp servers per network

<[network.dns_policy.get]>->($ARG) for keys <network.lease>->%*;
my $all = <network.dns_policy.by_fingerprint> // {};
my @rows;
foreach my $fingerprint ( sort keys $all->%* ) {
    my $p = $all->{$fingerprint};
    push @rows,
        join( '  ',
        $fingerprint,
        $p->{'iface'},
        $p->{'policy'},
        join( ',', $p->{'domains'}->@* ) || qw| - |,
        join( ',', $p->{'dhcp'}->@* )    || qw| - |,
        $p->{'until'} // qw| - | );
}
return {
    qw| mode | => qw| size |,
    qw| data | => join( "\n",
        'FINGERPRINT  IFACE  POLICY  DOMAINS  DHCP SERVERS  UNTIL',
        @rows ? @rows : qw| - | )
};

