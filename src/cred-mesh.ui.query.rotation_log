## [:< ##

# name  = cred-mesh.ui.query.rotation_log
# descr = return last 20 rotation log entries

my $log = <cred-mesh.rotation_log> // [];

my @entries;
my $start = scalar(@$log) > 20 ? scalar(@$log) - 20 : 0;
for my $i ( $start .. $#$log ) {
    my $entry = $log->[$i];
    push @entries,
        {
        'ntime_b32' => $entry->{'ntime_b32'} // '',
        'slot'      => $entry->{'slot'}      // '',
        'actor'     => $entry->{'actor'}     // '',
        'result'    => $entry->{'result'}    // '',
        };
}

return { 'rotations' => \@entries };

