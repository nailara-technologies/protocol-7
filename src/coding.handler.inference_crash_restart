# name  = coding.handler.inference_crash_restart
# descr = Restart inference server after crash with same model

my $handler_data = shift->w->data;
my $backend      = $handler_data->{'backend'} // 'gpu';

## skip crash recovery if zenka is draining [ new twin instance owns GPU ]
if (<coding.draining>) {
    <[base.logs]>->(
        1, '[inference_crash_restart] draining — skipping %s restart',
        $backend
    );
    return;
}

## same guard as inference_server_sigchld -- belt-and-suspenders in case a ##
## restart timer was already scheduled just before the training flag       ##
## flipped TRUE                                                            ##
if (<coding.lora_training_in_progress>) {
    <[base.logs]>->(
        1,
        '[inference_crash_restart] lora training '
            . 'in progress — skipping %s restart',
        $backend
    );
    return;
}

<[base.logs]>->(
    1, '[inference_crash_restart] restarting %s server after crash', $backend
);

## get server info ##
my $servers     = <coding.inference_servers> // {};
my $server_info = $servers->{$backend}       // {};

## get the model that was loaded ##
my $model_path = $server_info->{'model_path'}
    // $server_info->{'last_model_path'} // '';

if ( not length $model_path ) {
    <[base.logs]>->(
        0,
        '[inference_crash_restart] no '
            . 'model_path for %s server, cannot restart',
        $backend
    );
    $server_info->{'status'} = qw| failed |;
    return FALSE;
}

## queue was already paused by coding.handler.inference_server_sigchld the  ##
## moment the crash was detected -- not here, $backoff seconds later, which ##
## used to leave a window where a dispatch could race straight into the     ##
## not-yet-restarted server. this handler's only job now is the restart     ##
## itself                                                                   ##

## clear crashed status ##
$server_info->{'status'} = qw| restarting |;

## use existing restart infrastructure ##
my $result = <[coding.handler.restart_server]>->(
    {   'params' => {
            'backend'    => $backend,
            'model_path' => $model_path,
            'amos_id'    => $server_info->{'model'} // ''
        }
    }
);

if ($result) {
    <[base.logs]>->(
        1,
        '[inference_crash_restart] %s server restart initiated successfully',
        $backend
    );
    $server_info->{'status'} = qw| starting |;

    ## schedule startup verification ##
    <[event.add_timer]>->(
        {   'after'   => 10.0,
            'handler' => 'coding.handler.verify_inference_startup',
            'params'  => { 'backend' => $backend }
        }
    );

    return TRUE;
} else {
    <[base.logs]>->(
        0, '[inference_crash_restart] %s server restart failed', $backend
    );
    $server_info->{'status'} = qw| failed |;
    return FALSE;
}

