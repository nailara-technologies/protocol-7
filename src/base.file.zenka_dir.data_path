## [:< ##

# name  = base.file.zenka_dir.data_path
# descr = data dir path for current zenka [ /var/.., or /etc/.., ]

my $global_config = shift // FALSE;

my $zenka_dir_href = <system.path.zenka-dirs>;

## select base directory ##
my $base_dir = $global_config
    ? $zenka_dir_href->{'etc_P7'}     ## /etc/protocol-7/ ##
    : $zenka_dir_href->{'var_P7'};    ## /var/protocol-7/ ##

## append zenka name subdirectory using catdir ##
my $data_dir = join qw| / |, $base_dir, <system.zenka.name>;

return $data_dir;

