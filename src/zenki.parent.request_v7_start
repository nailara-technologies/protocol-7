## [:< ##

# name = zenki.parent.request_v7_start
# descr = request v7-zenki to start a specific zenka

my $params = shift || {};

my $zenka_name = $params->{'zenka'};

unless ($zenka_name) {
    return { success => FALSE, error => 'zenka name required' };
}

<[base.logs]>->(
    3, "zenki.request: asking v7-zenki to start '%s'..,", $zenka_name
);

## this used to fork \ exec the zenka directly, which produced an UNMANAGED ##
## process : no instance id, no heartbeat, no restart policy and no         ##
## dependency resolution.  the relay does all of that properly, so this is  ##
## now a thin alias of it -- kept as its own name because                   ##
## zenki.parent.ensure_zenka reads as a request \ wait pair                 ##

return <[zenki.parent.start_via_v7]>->(
    {   'zenka_name' => $zenka_name,
        'reply_id'   => $params->{'reply_id'}
    }
);

0;

