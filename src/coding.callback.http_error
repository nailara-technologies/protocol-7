## [:< ##

# name  = coding.callback.http_error
# descr = HTTP streaming error callback

my ( $task_id, $error ) = @ARG;

<[base.logs]>->( 0, "async.request: error for %s: %s", $task_id, $error );

## check for retryable errors (HTTP 500, timeouts) ##
my $state       = <[coding.async.state_manager]>->( 'get', $task_id );
my $retry_count = $state->{'retry_count'} // 0;
my $max_retries = 1;

## prevent duplicate retry timers ##
if ( $state->{'retry_pending'} ) {
    <[base.logs]>->(
        2,
        "async.request: retry already pending "
            . "for %s [ ignoring duplicate error ]",
        $task_id
    );
    ## release lock if we own it [ safety net ] ##
    my $backend_dup = $state->{'backend'} // '';
    <[coding.async.backend_release]>->( $task_id, $backend_dup )
        if length $backend_dup;
    return;
}

if (   $error =~ m{HTTP error:\s*5\d\d|timeout|connection closed}i
    && $retry_count < $max_retries ) {
    $retry_count++;
    <[base.logs]>->(
        1, "async.request: retrying %s [attempt %d/%d]",
        $task_id, $retry_count, $max_retries
    );

    ## server 500 with tool_calls: strip tool_calls from assistant msgs     ##
    ## matches blocking version [ process-queued-task lines 544-548 ] jinja ##
    ## template cannot handle tool_calls arguments as strings model keeps   ##
    ## content and tool results for context                                 ##
    if ( $error =~ m{HTTP error:\s*500}i ) {
        my $msgs = $state->{'messages'} // [];

        ## detect gemma/llama jinja templates that reject role:tool     ##
        ## messages pattern: raise_exception("Invalid content type") in ##
        ## else branch                                                  ##
        my $convert_tool_role = ( $error =~ m{Invalid content type}i
                || $error =~ m{raise_exception}i ) ? 1 : 0;

        for my $msg ( @{$msgs} ) {
            my $role = $msg->{'role'} // '';

            ## convert role:tool → role:user when template rejects tool ##
            ## role                                                     ##
            if ( $convert_tool_role && $role eq qw| tool | ) {
                my $tc_id = $msg->{'tool_call_id'} // 'unknown';
                $msg->{'role'} = qw| user |;
                $msg->{'content'}
                    = "[TOOL RESULT: $tc_id]\n" . ( $msg->{'content'} // '' );
                delete $msg->{'tool_call_id'};
                <[base.logs]>->(
                    1,
                    "http_error: converted tool role → user [jinja mismatch]"
                );

                ## convert role:assistant → role:model for gemma-family   ##
                ## templates gemma uses 'model' not 'assistant' as the AI ##
                ## turn role name                                         ##

            } elsif ( $convert_tool_role && $role eq qw| assistant | ) {
                $msg->{'role'} = qw| model |;
                <[base.logs]>->(
                    1,
                    "http_error: converted assistant → model [gemma jinja]"
                );
            }

            ## strip tool_calls from assistant|model messages ##
            if ( ref $msg->{'tool_calls'} eq qw| ARRAY | ) {
                delete $msg->{'tool_calls'};
                <[base.logs]>->(
                    1, "http_error: stripped tool_calls from %s msg", $role
                );
            }
        }
    }

    ## update retry count and set pending flag ##
    <[coding.async.state_manager]>->(
        'set', $task_id,
        {   retry_count   => $retry_count,
            retry_pending => TRUE
        }
    );

    ## retry after short delay [100ms]  use named handler - coderefs not ##
    ## supported by event.add_timer                                      ##
    <[event.add_timer]>->(
        {   'after'   => 0.1,
            'handler' => qw| coding.callback.retry_request |,
            'data'    => $task_id
        }
    );
    ## release backend lock before scheduling retry ##
    my $backend_retry = $state->{'backend'} // '';
    <[coding.async.backend_release]>->( $task_id, $backend_retry )
        if length $backend_retry;
    return;
}

## release backend lock before failing task ##
my $backend_fail = $state->{'backend'} // '';
<[coding.async.backend_release]>->( $task_id, $backend_fail )
    if length $backend_fail;

## fail the task ##
my $result = {
    success => FALSE,
    error   => $error,
};

## when all retries fail with a timeout the server accepted the TCP         ##
## connection but never responded : restart it so the next task gets a      ##
## fresh process rather than silently hanging again  also requeue on 0-byte ##
## close during restart [ same recovery path ]                              ##
if ( $error =~ m{timeout|connection closed with no data}i ) {
    my $backend_r = $state->{'backend'} // 'gpu';

    ## map routing name to server key [ 'single-llm' routes to gpu, same ##
    ## mapping as coding.async.send_request / coding.task.execute ]      ##
    my $srv_key    = $backend_r eq qw| cpu | ? qw| cpu | : qw| gpu |;
    my $srv        = ( <coding.inference_servers> // {} )->{$srv_key} // {};
    my $srv_status = $srv->{'status'}                                 // '';

    ## allow requeue when server is ready, already restarting, or starting ##
    if (   $srv_status eq qw| ready |
        || $srv_status eq qw| restart_needed |
        || $srv_status eq qw| starting | ) {

        ## only schedule a fresh restart if one is not already in flight ##
        if ( $srv_status eq qw| ready | ) {
            <[base.logs]>->(
                0,
                "http_error: %s timed out after %d "
                    . "retries : scheduling %s server restart",
                $task_id,
                $max_retries,
                $backend_r
            );
            $srv->{'status'} = qw| restart_needed |;

            ## reduce context size to recover from VRAM-pressure timeouts ##
            ## NOTE: <inference.model.context_length> is a FLOOR — spawn  ##
            ## picks max(auto_calc, floor), so lowering it alone has no   ##
            ## effect once auto-calc already exceeds it. set a recovery   ##
            ## CEILING too : spawn clamps the final size down to it,      ##
            ## regardless of what auto-calc would otherwise pick only     ##
            ## reduce when context was actually high — low ctx% means the ##
            ## timeout was model-speed | TTFT, not VRAM pressure; cutting ##
            ## the ceiling in that case makes future tasks worse          ##
            my $step  = <coding.cfg.ctx_timeout_step>  // 7000;
            my $floor = <coding.cfg.ctx_timeout_floor> // 16000;
            my $cur   = <coding.cfg.ctx_recovery_ceiling>
                // <inference.model.context_length> // 0;
            my $ctx_pct = $state->{'pct_used'} // 100;
            if ( $cur > $floor && $ctx_pct >= 70 ) {
                my $reduced
                    = ( $cur - $step > $floor ) ? $cur - $step : $floor;
                <inference.model.context_length>  = $reduced;
                <coding.cfg.ctx_recovery_ceiling> = $reduced;
                <[base.logs]>->(
                    1,
                    "http_error: reducing context %d → %d "
                        . "[timeout recovery ceiling, floor=%d, ctx=%d%%]",
                    $cur,
                    $reduced,
                    $floor,
                    $ctx_pct
                );
            } elsif ( $ctx_pct < 70 ) {
                <[base.logs]>->(
                    1,
                    "http_error: skip context reduction [ctx=%d%% "
                        . "< 70%% — model latency, not VRAM pressure]",
                    $ctx_pct
                );
            }

            ## clear cached pid so spawn_servers_deferred doesn't skip us ##
            <inference.gpu_pid> = 0 if $srv_key eq qw| gpu |;
            ## clear awaiting_resources: may be stuck from twin startup, ##
            ## blocking async_spawn_inference_servers silently           ##
            delete <coding.awaiting_resources>
                if <coding.awaiting_resources>;
            ## defer restart to avoid interfering with task teardown ##
            <[event.add_timer]>->(
                {   'after'   => 0.5,
                    'handler' => qw| coding.handler.spawn_servers_deferred |,
                    'data'    => { 'reason' => 'timeout_restart' }
                }
            );
        } else {
            <[base.logs]>->(
                1,
                "http_error: %s timed out while %s server "
                    . "status=%s : requeue without duplicate restart",
                $task_id,
                $backend_r,
                $srv_status
            );
        }

        ## requeue task transparently instead of failing it : server    ##
        ## restart is already scheduled; verify_inference_startup calls ##
        ## jobqueue.check_dependencies when ready, which picks us up    ##
        my $task = <coding.task.queue>->{$task_id};
        if ( defined $task ) {
            my $task_exec = $task->{'execution'} //= {};

            ## guard against double-requeue corrupting status ##
            if ( ( $task_exec->{'status'} // '' ) eq qw| pending | ) {
                <[base.logs]>->(
                    2,
                    "http_error: %s already pending, skipping double-requeue",
                    $task_id
                );
            } else {
                $task_exec->{'status'} = qw| pending |;

                ## restore task to pending list so queue_next can find it ##
                my $aref_pending = <coding.task.pending> //= [];
                my $aref_active  = <coding.task.active>  //= [];
                $aref_active->@* = grep { $ARG ne $task_id } $aref_active->@*;
                push $aref_pending->@*, $task_id
                    unless grep { $ARG eq $task_id } $aref_pending->@*;

                <[base.logs]>->(
                    1,
                    "http_error: requeued %s as pending "
                        . "— retries after server restart",
                    $task_id
                );
            }

            ## move jobqueue job back to depending so the next       ##
            ## jobqueue.check_dependencies call re-executes the task ##
            my $job_id = $state->{'job_id'};
            if ( defined $job_id ) {
                my $job_data = <[jobqueue.get_job_data]>->($job_id);
                if ( defined $job_data
                    && $job_data->{'status'} eq qw| running | ) {
                    <[jobqueue.move_job]>->( $job_id, qw| depending | );
                    <[base.logs]>->(
                        1,
                        "http_error: moved job %s to "
                            . "depending for retry after restart",
                        $job_id
                    );
                }
            }

            ## clear http-level state so next attempt starts a fresh round ##
            <[coding.async.state_manager]>->( 'delete', $task_id );
            return;
        }
    } else {
        <[base.logs]>->(
            0,
            "http_error: %s timed out but %s server "
                . "status=%s : cannot schedule restart",
            $task_id,
            $backend_r,
            $srv_status
        );
    }
}

<[coding.async.complete]>->( $task_id, $result );

return;

