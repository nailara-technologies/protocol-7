## [:< ##

# name  = usage.provider_list
# descr = names of the usage providers currently loaded as plugins
# return = sorted list of provider names [ e.g. 'claude', 'kimi' ]

## every plugin.usage.<name> dispatch routine is one provider : the list ##
## follows plugins.load, nothing has to be declared twice                ##

my @provider_names
    = sort map { m{^plugin\.usage\.([^.]+)$} ? $1 : () } keys %code;

return @provider_names;

