## [:< ##

# name = zenki.parent.resolve_dependencies
# descr = resolve and ensure all dependencies in the chain are running

my $params = shift || {};

my $zenka_name = $params->{zenka};

unless ($zenka_name) {
    return { success => FALSE, error => 'zenka name required' };
}

<[base.log]>
    ->( 3, "zenki.resolve: resolving dependencies for '$zenka_name'" );

## Determine dependency chain
my @chain;

## All zenki (except v7-zenki and cube) depend on: cube → v7-zenki
if ( $zenka_name eq 'v7-zenki' ) {
    @chain = qw| v7-zenki |;
} elsif ( $zenka_name eq 'cube' ) {
    @chain = qw| v7-zenki cube |;
} else {
    @chain = qw| v7-zenki cube |;
}

<[base.log]>->( 3, "  Dependency chain : " . join( ' → ', @chain ) );

## Resolve each dependency in order
foreach my $dep (@chain) {
    my $result;

    if ( $dep eq 'v7-zenki' ) {
        $result = <[zenki.parent.ensure_v7]>;
    } elsif ( $dep eq 'cube' ) {
        $result = <[zenki.parent.ensure_cube]>;
    } else {
        $result = <[zenki.parent.ensure_zenka]>->( { zenka => $dep } );
    }

    unless ( $result->{success} ) {
        <[base.log]>->(
            0,
            "  Failed to ensure '$dep': " . ( $result->{error} || 'unknown' )
        );

        return {
            success => FALSE,
            error   => "dependency '$dep' failed: "
                . ( $result->{error} || 'unknown' ),
            failed_at => $dep,
            chain     => \@chain
        };
    }

    <[base.log]>->( 3, "  ✓ '$dep' available" );
}

return {
    success  => TRUE,
    chain    => \@chain,
    resolved => scalar(@chain)
};

0;

