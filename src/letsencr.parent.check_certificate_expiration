# name  = letsencr.parent.check_certificate_expiration
# descr = evaluate which certificates need renewal based on expiration

my $cert_registry = shift;

return {
    status        => qw| error |,
    error         => 'certificate registry required',
    needs_renewal => [],
    expiring_soon => [],
    }
    unless $cert_registry && ref($cert_registry) eq qw| HASH |;

my $renewal_threshold  = <letsencr.renewal.days-before> // 30;
my $expiring_threshold = 7;    # Alert for certs expiring within 7 days

<[base.logs]>->(
    2, 'checking certificate expiration [ renewal threshold : %s days ]',
    $renewal_threshold
);

my @needs_renewal;
my @expiring_soon;
my $now = <[base.time]>;

foreach my $domain ( keys %$cert_registry ) {
    my $cert_info = $cert_registry->{$domain};
    next unless $cert_info->{expires_at};

    my $days_remaining = ( $cert_info->{expires_at} - $now ) / 86400;

    ## Check if renewal needed
    if ( $days_remaining <= $renewal_threshold ) {
        push @needs_renewal,
            {
            domain          => $domain,
            days_remaining  => $days_remaining,
            expires_at      => $cert_info->{expires_at},
            alt_names       => $cert_info->{alt_names},
            certificate_url => $cert_info->{certificate_url},
            account_id      => $cert_info->{account_id},
            };

        my $expiry_str
            = $days_remaining < 0
            ? sprintf( 'expired %.1f days ago', abs($days_remaining) )
            : sprintf( 'expires in %.1f days',  $days_remaining );
        <[base.logs]>->(
            2,       ': certificate %s needs renewal [ %s ]',
            $domain, $expiry_str
        );
    }

    ## Check if expiring soon [ alert only ]
    elsif ( $days_remaining <= $expiring_threshold ) {
        push @expiring_soon,
            {
            domain         => $domain,
            days_remaining => $days_remaining,
            expires_at     => $cert_info->{expires_at},
            };

        <[base.logs]>->(
            1,       ': warning : certificate %s [ expires in %.1f days ]',
            $domain, $days_remaining
        );
    }
}

## Sort by urgency [ most urgent first ]
@needs_renewal
    = sort { $a->{days_remaining} <=> $b->{days_remaining} } @needs_renewal;
@expiring_soon
    = sort { $a->{days_remaining} <=> $b->{days_remaining} } @expiring_soon;

<[base.logs]>->(
    2, ': expiration check complete : %d need renewal, %d expiring soon',
    scalar(@needs_renewal), scalar(@expiring_soon)
);

return {
    status        => qw| success |,
    needs_renewal => \@needs_renewal,
    expiring_soon => \@expiring_soon,
};

