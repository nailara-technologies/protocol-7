## [:< ##

# name  = coding.gpu_lease.gate
# descr = gpu spawn gate : owned, held elsewhere, or models unavailable

return TRUE
    if not <[base.cfg_bool]>->( <models.cfg.gpu_lease.enabled> // FALSE );
return TRUE if ( <coding.gpu_lease.holder> // '' ) eq qw| coding |;
return <[coding.gpu_lease.request]>;

