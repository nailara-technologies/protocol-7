## [:< ##

# name = data.mount.shm.feedback.ding
# descr = Reader-side one-byte ding on the notify fifo

# thin zenka wrapper -> AMOS7::SHM::Feedback::ding
# the actual data lives in the feedback region; the fifo byte is only a wakeup.

my $mount = shift;

return AMOS7::SHM::Feedback::ding($mount);

