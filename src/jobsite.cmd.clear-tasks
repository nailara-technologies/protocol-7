## [:< ##

# name  = jobsite.cmd.clear-tasks
# descr = reset all task tracking state (keeps job store intact)

<jobsite.tasks>         = {};
<jobsite.cycle>         = 'idle';
<jobsite.pending_count> = 0;
<jobsite.assess_queue>  = [];
<jobsite.rewire_queue>  = [];

<[jobsite.state.persist]>;

<[base.logs]>->( 1, 'task state cleared' );

return { 'mode' => 'true', 'data' => 'task state cleared' };

