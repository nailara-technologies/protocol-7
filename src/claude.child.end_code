## [:< ##

# name  = claude.child.end_code
# descr = zenka exit : the child ends too [ no orphan ]

## end_code runs on every exit path [ bin/Protocol-7 END ] : the stop steps ##
## without the event loop [ stream_child.end_code ]                         ##

my $child = <claude.child>;
return if not defined $child or $child->{'gone'};
<[stream_child.end_code]>->($child);

