# name = data.topology.interference.map.generate_povray_csg
# descr = Generate POV-Ray CSG description for node

my ( $coord, $color, $alpha, $drift, $constructive ) = @ARG;

my ( $x,  $y,  $z )  = @$coord;
my ( $r,  $g,  $b )  = @$color;
my ( $dr, $dg, $db ) = @$drift;

# Emission color with drift
my $er = $r + $dr;
my $eg = $g + $dg;
my $eb = $b + $db;

return sprintf(
    "sphere { <%d,%d,%d>, 0.5\n  pigment { rgbt <%.3f,%.3f,%.3f,%.3f> "
        . "}\n  finish { emission <%.3f,%.3f,%.3f> }\n}",
    $x, $y, $z, $r, $g, $b, 1 - $alpha,
    $er * $constructive,
    $eg * $constructive,
    $eb * $constructive
);

