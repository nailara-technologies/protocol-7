## [:< ##

# name  = web-browser.cmd.start-capture-slideshow
# descr = arm a paged multi-position capture loop. once
#         a page is fully ready (fade complete in non-headless mode, load
#         finished in headless mode), the loop captures the page at Y
#         positions 0, viewport_height, 2*viewport_height, ... scroll_max,
#         appending '<id>\t<uri>\t<position_index>\t<snapshot_path>' lines to
#         a manifest file. the loop is driven from inside the settled-page
#         window before the slideshow advances to the next URL, replacing the
#         previous single-shot capture-on-advance watcher.
#
# param = <manifest_path> [snapshot_dir]

my @call_params = split m{\ +}, $call->{'args'} // '';

return { 'mode' => qw| size |, 'data' => <<'EOT' } if not @call_params;

::[ web-browser start-capture-slideshow <manifest_path> [snapshot_dir] ]:.
:
:: arm a paged multi-position capture loop for the slideshow. captures the
:: page at Y positions 0, viewport_height, 2*viewport_height, ... scroll_max
:: before advancing to the next URL.
:
:: manifest_path ....... file to append '<id>\t<uri>\t<pos>\t<snapshot_path>' lines to
:: snapshot_dir ......... where to save PNGs [ default: web-browser.cfg.snapshot_dir ]
.

EOT

my $manifest_path = $call_params[0];
my $snapshot_dir  = $call_params[1] // <web-browser.cfg.snapshot_dir>
    // ( <system.root_path> . '/data/snapshots' );

<[file.make_path]>->($snapshot_dir) unless -d $snapshot_dir;

<web-browser.capture.manifest_path> = $manifest_path;
<web-browser.capture.snapshot_dir>  = $snapshot_dir;
<web-browser.capture.counter>       = 0;
<web-browser.capture.paged.armed>   = 5;                ## TRUE ##

my $timeout_log_path = $manifest_path;
$timeout_log_path =~ s|\.[^.]*$||;
$timeout_log_path .= '.timeouts.tsv';
<web-browser.capture.timeout_log_path> = $timeout_log_path;

<web-browser.capture.watcher>->cancel
    if defined <web-browser.capture.watcher>
    and <web-browser.capture.watcher>->is_active;

delete <web-browser.capture.watcher>;

<[base.log]>->( 1, "capture-slideshow armed [ manifest: $manifest_path ]" );

return { 'mode' => qw| true |, 'data' => 'paged capture watcher armed' }

