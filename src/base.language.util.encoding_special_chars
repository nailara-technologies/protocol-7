# name  = base.language.util.encoding_special_chars
# descr = extract non-ascii chars an encoding maps from 0x80-0xFF

my $enc   = shift;
my %seen  = ();
my @chars = ();
for my $byte ( 0x80 .. 0xFF ) {
    my $uni
        = eval { Encode::decode( $enc, chr($byte), Encode::FB_CROAK ) };
    next unless defined $uni and not $@ and length $uni;
    push @chars, $uni unless $seen{$uni}++;
}
return @chars;

