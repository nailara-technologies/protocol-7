# name  = coding.cmd.gpu-lease-granted
# descr = models granted coding sole gpu residency

<coding.gpu_lease.holder>           = qw| coding |;
<coding.gpu_lease.request_inflight> = FALSE;
<coding.gpu_lease.unavailable>      = FALSE;
delete <coding.gpu_lease.retry_after>;
<coding.gpu_lease.wait_logged>   = FALSE;
<coding.gpu_lease.dispatch_hold> = FALSE;
<[base.logs]>->( 1, ': gpu lease acquired : reloading local gpu backend' );
<[coding.gpu_lease.handler.renew]>;
<[coding.async_spawn_inference_servers]>;
<[coding.async.backend_dispatch_next]>->(qw| gpu |)
    if ( ( <coding.inference_servers> // {} )->{'gpu'}->{'status'} // '' ) eq
    qw| ready |;
return { 'mode' => qw| true |, 'data' => qw| done | };

