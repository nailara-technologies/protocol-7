## [:< ##
# name  = plan-9.client.clunk
# descr = Close/release fid on 9P server

my ( $client, $fid ) = @ARG;

my $req = <[plan-9.protocol.codec.encode-uint32]>->($fid);

my $msg = <[plan-9.protocol.codec.encode-message]>->(
    <plan-9.protocol.constants.Tclunk>,
    6, $req
);

$client->{socket}->send($msg);

my $resp = <[plan-9.client.read-message]>->($client);
delete $client->{fids}{$fid};

return $resp;

