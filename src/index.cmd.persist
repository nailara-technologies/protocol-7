## [:< ##

# name  = index.cmd.persist
# descr = save index state to disk

<index.persist.reply_id> = $call->{'reply_id'};

<[event.add_timer]>->(
    {   'after'   => 0,
        'handler' => qw| index.callback.persist |,
    }
);

return { 'mode' => 'deferred' };

