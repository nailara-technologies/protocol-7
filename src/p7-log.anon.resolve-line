## [:< ##

# name  = p7-log.anon.resolve-line
# descr = resolve every [L:<checksum>] token in a log line
#         [ unresolvable tokens are left as-is, never dropped ]

my $line = shift // '';

return $line if not length $line;

$line =~ s{(\[L:[A-Z2-7]{8,13}\])}{
    my $plaintext = <[p7-log.anon.resolve]>->($1);
    ( defined $plaintext and $plaintext ne qw| 0 | ) ? $plaintext : $1;
}ge;

return $line;

