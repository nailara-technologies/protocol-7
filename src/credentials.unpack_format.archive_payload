## [:< ##

# name  = credentials.unpack_format.archive_payload
# descr = unpack archive payload into credential hash

my $archive_payload_ref = shift;

if ( ref $archive_payload_ref ne qw| SCALAR | ) {
    warn 'expected scalar ref to archive payload <{C1}>';
    return undef;
} elsif ( not length( $archive_payload_ref->$* // '' ) ) {
    warn 'archive payload is empty or not defined <{C1}>';
    return undef;
}

my $payload_data_body;
my $header_str         = "## [:< ##\n#.\n";
my $archive_footer_str = "\n#.\n#.::\n";

## unwrapping ##
if ( $archive_payload_ref->$*
    !~ m|^\Q$header_str\E(.+)\Q$archive_footer_str\E$|s ) {
    warn 'archive format not correct [ header \ footer ] <{C1}>';
    return undef;
} else {
    $payload_data_body = $LAST_PAREN_MATCH;
}

my $cred_yaml;
foreach my $line ( split "\n", $payload_data_body ) {
    if ( $line !~ m|^\['credential'\](.+)$| ) {
        warn 'archive format not correct [ credential line error ] <{C1}>';
        return undef;
    }
    $cred_yaml = $LAST_PAREN_MATCH;
    $cred_yaml =~ s|\\n|\n|g;    ## restoring escaped linefeeds ##
}

if ( not defined $cred_yaml or not length $cred_yaml ) {
    warn 'no credential data extracted <{C1}>';
    return undef;
}

my $cred = eval { YAML::XS::Load($cred_yaml) };
if ($@) {
    <[base.logs]>->( 0, 'credentials: yaml parse failed: %s', $@ );
    return undef;
}

if ( ref $cred ne qw| HASH | ) {
    warn 'invalid credential data format <{C1}>';
    return undef;
}

return $cred;

