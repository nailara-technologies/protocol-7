# name  = discover.cmd.orbital-p7ref-update
# descr = receive local orbital p7ref push from nodes zenka

my $p7ref = $call->{'args'} // '';
$p7ref =~ s|^\s+||;
$p7ref =~ s|\s+$||;

return { qw| mode | => qw| false |, qw| data | => 'empty p7ref' }
    unless length $p7ref;

<discover.orbital.local_p7ref> = $p7ref;

<[base.logs]>->( 2, 'orbital local p7ref updated: %s', $p7ref );

return { qw| mode | => qw| true |, qw| data | => 'ok' };

