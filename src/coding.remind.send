## [:< ##

# name   = coding.remind.send
# descr  = one delivery round of a kept reminder
# args   = reminder id
# return = TRUE when a command is on its way

## one round at a time : a record already 'sending' is left alone, until ##
## its answer is overdue [ <coding.remind.stale_seconds> ]               ##

my $id    = shift                                       // '';
my $r     = <[coding.remind.store]>->( qw| get |, $id ) // return FALSE;
my $stale = <coding.remind.stale_seconds>               // 89;
return FALSE
    if $r->{'status'} eq qw| sending |
    and time - ( $r->{'since'} // 0 ) < $stale;
my $round = ++<coding.remind.round>;
$r->{'status'} = qw| sending |;
$r->{'since'}  = time;
$r->{'round'}  = $round;
<[coding.remind.store]>->( qw| set |, $id, $r );
my ( $session, $target ) = $r->{'to'} =~ m{\A(session)(?::([\w.\-]+))?\z};
## the name the session has now ; one recorded by name only too ##
my $sid = $r->{'sid'};

if ( defined $target ) {
    $target = <[coding.sessions.resolve]>->( $target, $sid );
    $sid //= ( <[coding.sessions.store]>->()->{$target} // {} )->{'sid'};
}
my $paths
    = defined $session
    ? [ qw| session |, qw| notify | ]
    : [ qw| notify |, qw| session | ];
return <[coding.remind.deliver]>->(
    {   'id'      => $id,
        'text'    => $r->{'text'},
        'paths'   => $paths,
        'session' => $target,
        'sid'     => $sid,
        'round'   => $round,
        'reasons' => []
    }
);

