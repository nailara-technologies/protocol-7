## [:< ##

# name   = protocol-7-menu.decision.raise
# descr  = raise decision.answered for an answered decision
# args   = question [ hash ], answer text
# return = TRUE when sent, FALSE when not a decision
#
# only questions added with decision=yes [ coding.ask ] raise it, never a
# password question : the values go to the signal journal. the signal line
# splits on spaces : the answer goes with every space run as '_' and at
# most 200 characters. route-send only buffers : refusals come to
# protocol-7-menu.handler.decision_signal_reply

my ( $question, $answer ) = @ARG;
return FALSE
    if ref $question ne qw| HASH |
    or not $question->{'decision'}
    or ( $question->{'type'} // '' ) eq qw| password |;

my $id = $question->{'id'} // '';
return FALSE if $id !~ m|\A[\w-]{1,40}\z|;
$answer = ( $answer // '' ) =~ s{\A\s+|\s+\z}{}gr =~ s{\s+}{_}gr;
$answer = substr( $answer, 0, 200 );

<[protocol-7.route-send]>->(
    {   'command'   => qw| events.signal |,
        'call_args' =>
            { 'args' => "decision.answered id=$id answer=$answer" },
        'reply' => {
            'handler' => qw| protocol-7-menu.handler.decision_signal_reply |,
            'params'  => { 'id' => $id }
        }
    }
);
<[base.logs]>->( 1, ':. decision %s answered : signal sent', $id );
return TRUE;

