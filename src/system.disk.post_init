## [:< ##

# name  = system.disk.post_init
# descr = start local file system space monitoring

<system.disk.timer>->cancel if defined <system.disk.timer>;
if ( not <system.zenka.initialized> ) {
    push @{ <system.callbacks.initialized> //= [] },
        qw| system.disk.handler.poll |;
} else {
    <[system.disk.handler.poll]>;
}
0;

