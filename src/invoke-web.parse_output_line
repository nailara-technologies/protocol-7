## [:< ##

# name   = invoke-web.parse_output_line
# descr  = one line of invoke.ai output : keep it in the output tail, match
#          it against <invoke-web.output_patterns> [ first match wins ] and
#          update status \ last error \ render progress
# param  = line, stream [ out | err ]

my $line   = shift // return;
my $stream = shift // qw| out |;

$line =~ s|\e\[[0-9;?]*[A-Za-z]||g;    ## ansi colors \ cursor codes ##
$line =~ s|\s+$||;
return if not length $line;

<[invoke-web.activity.touch]>->(qw| output |);    ## drain idle clock ##

## bounded output tail [ invoke-web.log ] ##
my $tail = <invoke-web.output_tail> //= [];
push $tail->@*, $line;
splice( $tail->@*, 0, @$tail - <invoke-web.output_tail_max> )
    if @$tail > <invoke-web.output_tail_max>;

my ( $kind, $level ) = ( qw| line |, 3 );
foreach my $pattern ( <invoke-web.output_patterns>->@* ) {
    next if $line !~ $pattern->{'match'};
    ( $kind, $level ) = ( $pattern->{'kind'}, $pattern->{'level'} );
    last;
}

if ( $kind eq qw| ready | ) {

    ## the port actually listened on [ invoke.ai config, not ours ] ##
    <invoke-web.url> = <invoke-web.url_detected> = "http://127.0.0.1:$1"
        if $line =~ m{https?://[^\s:/]+:(\d+)};

    if ( not <invoke-web.ready_logged> ) {
        <invoke-web.status>       = 'running';
        <invoke-web.ready_logged> = TRUE;
        <[base.logs]>->( 1, 'invoke.ai ready at %s', <invoke-web.url> );

        ## invoke.ai resumes its queue on every start [ zenka.v7 flag ] ##
        ## async : right after ready invoke.ai is still loading models  ##
        <[invoke-web.api_async]>->(
            'PUT', '/api/v1/queue/default/processor/pause',
            undef, 'invoke-web.handler.startup_pause_reply'
            )
            if <[base.cfg_bool]>->( <invoke-web.start_paused> // 0 )
            or defined <invoke-web.gpu_recover>;    ## requeue first ##

        ## interactive queue mode from the start [ zenka.v7 flag ; armed ##
        ## here, not in init_code : that one still runs as root ]        ##
        <[invoke-web.queue.interactive]>->(TRUE)
            if
            <[base.cfg_bool]>->( <invoke-web.queue_interactive_start> // 0 )
            and not <invoke-web.queue_interactive>;

        ## activity from ui use [ db writes ] + the drain timer ##
        <[invoke-web.activity.watch_db]>;
        <invoke-web.timer.drain_check> //= <[event.add_timer]>->(
            {   'after'    => 60,
                'interval' => 60,
                'repeat'   => TRUE,
                'handler'  => 'invoke-web.handler.drain_check',
            }
        );
    }
    return;
} elsif ( $kind eq qw| progress | ) {    ## tqdm : ' 45%|####  | 9/20 [..' ##
    <invoke-web.progress> = $1 if $line =~ m{(\d+/\d+)\s*\[};
    return;    ## no log line per step ##
} elsif ( $kind eq qw| model | ) {    ## startup lists every missing file ##
    <invoke-web.missing_models>++;
} elsif ( $kind eq qw| model_render | ) {

    ## second complaint about a missing model : the autofetch trigger [   ##
    ## data/tasks/invoke-missing-model-autofetch.md ]. same model name as ##
    ## the startup 'Missing model file' line ; item status : failed,      ##
    ## error_type FileNotFoundError                                       ##
    my ($name)    = $line =~ m{Files for model '([^']+)' not found at (\S+)};
    my $path      = $2;
    my ($session) = $line =~ m{invoking session (\S+),};
    my $render    = <invoke-web.render> // {};
    <invoke-web.missing_at_render>->{$name} = {
        'path'    => $path,
        'item'    => $render->{'item'},
        'session' => $session // $render->{'session'},
        'time'    => <[base.time]>->(3),
        }
        if defined $name;
    <[invoke-web.missing.save]> if defined $name;
    <invoke-web.render>->{'failed'} //= sprintf "model '%s' " . "missing",
        $name // '?'
        if defined <invoke-web.render> and not <invoke-web.render>->{'done'};
    <invoke-web.last_error> = {
        'kind' => qw| model |,
        'line' => sprintf(
            "model '%s' missing [ item %s ]",
            $name // '?',
            $render->{'item'} // '?'
        ),
        'time' => <[base.time]>->(3),
    };
} elsif ( $kind eq qw| gpu | ) {

    ## broken cuda context : every next item would fail as well ##
    <invoke-web.render>->{'failed'} //= $kind
        if defined <invoke-web.render> and not <invoke-web.render>->{'done'};
    <invoke-web.last_error> = {
        'kind' => $kind,
        'line' => $line,
        'time' => <[base.time]>->(3),
    };
    <[invoke-web.gpu.recover]>->( ( <invoke-web.render> // {} )->{'item'} );
} elsif ( $kind =~ m{^(?:error|oom)$} ) {
    <invoke-web.render>->{'failed'} //= $kind    ## this render failed ##
        if defined <invoke-web.render> and not <invoke-web.render>->{'done'};
    <invoke-web.last_error> = {
        'kind' => $kind,
        'line' => $line,
        'time' => <[base.time]>->(3),
    };
} elsif ( $kind eq qw| item | ) {
    delete <invoke-web.progress>;    ## a new render item starts ##
    <invoke-web.render> = { 'item' => $1, 'session' => $2 }
        if $line =~ m{queue item (\d+), session (\S+)};
} elsif ( $kind eq qw| item_done | ) {
    delete <invoke-web.progress>;
    <invoke-web.render>->{'done'} = TRUE if defined <invoke-web.render>;
} elsif ( $kind eq qw| render_node | ) {

    ## executed graph nodes of this item : name -> vram [ G ] ##
    my ( $node, $vram ) = $line =~ m{^\s*(\w+)\s+\d+\s+[\d.]+s\s+([\d.]+)G};
    <invoke-web.render>->{'nodes'}->{$node} = $vram
        if defined $node and defined <invoke-web.render>;
} elsif ( $kind eq qw| render_stat | ) {

    ## one summary line once the table's last collected value arrives ##
    my ( $key, $value ) = $line =~ m{^\s*([^:]+):\s*(.+)$};
    my $render = <invoke-web.render> //= {};
    $render->{'stats'}->{$key} = $value;
    if ( $key eq 'Cache high water mark' ) {
        <invoke-web.last_render> = $render;

        ## graph stats come for failed items too : an error in the same    ##
        ## session, or a memory based sanity check -- no image decode node ##
        ## [ l2i \ *_l2i ] ran with vram in use = nothing was rendered.    ##
        ## not the time : it depends on the hardware ; not the ram delta   ##
        ## alone : a fully cached render shows +0.000G too                 ##
        my $nodes = $render->{'nodes'} // {};
        my $decoded
            = grep { m{(?:^|_)l2i$} and $nodes->{$ARG} > 0 } keys %$nodes;
        $render->{'result'}
            = defined $render->{'failed'} ? qw| failed |
            : not $decoded                ? qw| suspicious |
            :                               qw| done |;

        ## a clean graph can still hide a silent decode failure : look at ##
        ## the result image itself [ black \ flat -> failed ]             ##
        if ( $render->{'result'} eq qw| done |
            and defined $render->{'session'} ) {
            my $check = <[invoke-web.render.check_images]>
                ->( $render->{'session'} );
            $render->{'images'} = $check->{'images'} if defined $check;
            if ( defined $check and $check->{'bad'}->@* ) {
                $render->{'result'} = qw| failed |;
                $render->{'failed'} = sprintf 'silent failure : %s',
                    join '; ', $check->{'bad'}->@*;
            }
        }

        <[base.logs]>->(
            $render->{'result'} eq qw| done | ? 1 : 0,
            'render %s [ item %s%s ]',
            $render->{'result'},
            $render->{'item'} // '?',
            $render->{'result'} eq qw| failed |
            ? " : $render->{'failed'}"
            : ''
        ) if $render->{'result'} ne qw| done |;

        return if $render->{'result'} ne qw| done |;
        <[base.logs]>->(
            1,
            'render done [ item %s : %s, ram %s, vram %s ]',
            $render->{'item'}                                    // '?',
            $render->{'stats'}->{'TOTAL GRAPH EXECUTION TIME'}   // '?',
            $render->{'stats'}->{'RAM used by InvokeAI process'} // '?',
            $render->{'stats'}->{'VRAM in use'}                  // '?'
        );
    }
}

## console \ logfile in house style : '(node_name)' -> '[ node_name ]' [ ##
## single identifiers only ; the output tail keeps the raw line ]        ##
( my $log_line = $line ) =~ s{\(([\w.-]+)\)}{[ $1 ]}g;
<[base.logs]>->( $level, '[invoke.ai] %s', $log_line );

