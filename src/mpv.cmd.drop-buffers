## [:< ##

# name  = mpv.cmd.drop-buffers
# descr = clear audio/video/demuxer buffers

push( @{<mpv.reply_ids>}, $call->{'reply_id'} );

<mpv.success_reply_str> = 'buffers cleared';

<[mpv.send_command]>->('drop-buffers');

return { 'mode' => qw| deferred | };

