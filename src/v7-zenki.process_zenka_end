## [:< ##

# name  = v7-zenki.process_zenka_end

my $instance_id = shift;
my $process_id  = shift;
my $exit_sig    = shift;
my $exit_val    = shift;    ##  exit code from external binary ##
##                                 [ extbin \ exec-external ]  ##

my $log_level = 2;          ##[  decrease when searching errors  ]##

return <[base.logs]>->(
    0,
    '[process_zenka_end] missing instance id <-- %s',
    scalar <[base.caller]>
) if not defined $instance_id;

my $instance;
if ( defined $instance_id
    and exists <v7-zenki.zenka.instance>->{$instance_id} ) {
    $instance = <v7-zenki.zenka.instance>->{$instance_id};
    $process_id //= $instance->{'process'}->{'id'};
} elsif ( defined $instance_id ) {
    <[base.logs]>->(
        $log_level, ': process_zenka_end : gone [ %u ]', $instance_id
    );
    return undef;
}

my $zenka_name     = $instance->{'zenka_name'};
my $zenka_subname  = $instance->{'subname'};
my $current_status = $instance->{'status'} // qw| undefined |;

my $pid_str
    = defined $process_id ? sprintf( ' \ pid : %u', $process_id ) : '';

if ( defined $zenka_name ) {
    <[base.logs]>->(
        $log_level,  ': processing end of %s-zenka [ instance : %u%s ]',
        $zenka_name, $instance_id, $pid_str
    );
} else {
    <[base.logs]>->(
        $log_level,   ': processing end of zenka-instance %u%s',
        $instance_id, $pid_str
    );
}

<[v7-zenki.stop_heartbeat_timer]>->($instance_id) if defined $instance_id;
<[v7-zenki.terminate_process]>->($process_id)     if defined $process_id;

####

# <-- cleaning up children  .., [LLL]

if (    defined $instance_id
    and $instance_id =~ <regex.base.iid>
    and defined $instance
    and my $child = <v7-zenki.child>->{$process_id} ) {
    <[base.logs]>->( $log_level, ': was instance %d', $instance_id );

    delete <v7-zenki.child>->{$process_id};
    delete $instance->{'restart_pids'}->{$process_id}
        if exists $instance->{'restart_pids'};

    <[base.logs]>->( $log_level, ": had status : '%s'", $current_status );

    my $zenka_term_callback    ##  custom term handlers  ##
        ## own zenka.* subs load unprefixed ##
        = sprintf( qw| zenka.end-handler.%s |, $zenka_name );

    if ( exists $code{$zenka_term_callback} ) {
        <[base.logs]>->(
            $log_level, ': calling term handler for %s zenka..,', $zenka_name
        );
        $code{$zenka_term_callback}->( $instance_id, $process_id, $exit_sig );
    }

    my $next_status
        = $current_status =~ m,error|online|starting,
        ? qw|  error  |
        : qw| offline |;

    ##  check exit code for external binaries [ exec-external zenki ]  ##
    if (    $instance->{'external'}
        and defined $exit_val
        and $exit_val != 0 ) {
        $next_status = qw| error |;
        ## remember the outcome for notify_offline waiters [ replied when   ##
        ## the instance reaches 'shutdown' in v7-zenki.handler.zenka_status ##
        ## ]                                                                ##
        $instance->{'terminated'}
            = { 'status' => qw| error |, 'exit' => $exit_val };
        <[base.logs]>->(
            0, "[terminated] : external binary : '%s' : [ exit : %d ]",
            $zenka_name, $exit_val
        );
    } elsif ( $instance->{'external'}
        and defined $exit_val
        and $exit_val == 0 ) {
        <[base.logs]>->(
            1, ": [ exit 0 ] : external binary : '%s' : completed =).",
            $zenka_name
        );
    }

    $next_status = qw| restart | if $current_status eq qw| restart |;

    if ( $current_status eq qw| online |
        and defined <v7-zenki.ondemand_zenki> ) {
        map { $next_status = qw| offline | if $ARG eq $zenka_name }
            <v7-zenki.ondemand_zenki>->@*;
    }

    if ( <[v7-zenki.instance_pid_count]>->($instance_id) ) {

        <[zenka.change_status]>->( $instance_id, qw| delayed | )
            if $current_status eq qw| restart |;

        $instance->{'pid_check_timer'} = <[event.add_timer]>->(
            {   'after'    => 0.07,
                'interval' => 0.13,
                'handler'  => qw| v7-zenki.handler.children_left |,
                'data'     => {
                    qw| instance_id | => $instance_id,
                    qw| next_status | => $next_status
                }
            }
        );
    } else {

        <[zenka.change_status]>->( $instance_id, $next_status )
            if $current_status ne $next_status;

        ## an external binary                                               ##
        ## [ no heartbeat : zenka_status' restart gate never sees it ] with ##
        ## restart.disabled ends on an error exit                           ##
        ## [ pull-git, dist-upgrade ] -- :wait-down: waiters get FALSE      ##
        my $zenka_config
            = ( <v7-zenki.start_setup.zenki.config> // {} )->{$zenka_name}
            // {};
        if (    $instance->{'external'}
            and $next_status eq qw| error |
            and $zenka_config->{'restart'}->{'disabled'} ) {
            <[base.logs]>->(
                ': no auto-restart for external %s [ restart.disabled ]',
                $zenka_name
            );
            <[zenka.cmd.terminate]>
                ->( { 'args' => $instance_id, 'mode' => qw| implicit | } );
        } elsif ( $next_status !~ m,offline|shutdown, ) {
            <[v7-zenki.init_restart_timer]>->($instance_id);
        }
    }
} elsif ( defined $instance_id and defined $instance ) {
    delete <v7-zenki.zenka.instance>->{$instance_id};
}

<[base.logs]>->( $log_level, ': :. reported .: %s', scalar <[base.caller]> );

return TRUE;

