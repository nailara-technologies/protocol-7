## [:< ##

# name  = screen.setup.cmd.dpi-get
# descr = show effective layered desktop dpi

my $value = <screen.setup.dpi.value>
    // <[screen.setup.dpi.settings]>->{'value'};
return { 'mode' => qw| true |, 'data' => defined $value ? $value : 'unset' };

