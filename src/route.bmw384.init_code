## [:< ##

# name  = route.bmw384.init_code
# descr = initialize BMW384 field index and alias bmw384.* namespace

<[route.bmw384.index.init]>;

# [ populate index at startup if modules dir exists ]
my $code_path = <system.code_path> // qw| src |;
if ( -d $code_path
    and not scalar keys %{ <bmw384.index>->{'by_name'} // {} } ) {
    <[route.bmw384.index.from-path]>->($code_path);
}

0;

