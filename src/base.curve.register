## [:< ##

# name  = base.curve.register
# descr = Create and start a named parameter curve

my $params = shift;

my $id = $params->{'id'} // do {
    state $auto_id = 0;
    'curve_' . ++$auto_id;
};

<base.curve.active>->{$id} = {
    from     => $params->{'from'}     // 0,
    to       => $params->{'to'}       // 1,
    duration => $params->{'duration'} // 1,
    type     => $params->{'type'}     // 'linear',
    started  => <[base.time]>->(3),
    callback => $params->{'callback'},
    on_done  => $params->{'on_done'},
};

<[base.curve.init]>
    if not defined <base.curve.timer>
    or not <base.curve.timer>->is_active;

return $id;

