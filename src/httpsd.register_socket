## [:< ##

# name  = httpsd.register_socket
# param = $socket, $type, $mode
# descr = register SSL socket in data structure for handler lookup
# note  = called after SSL socket creation; httpsd.create_ssl_socket doesn't
#         register like base.open does, so base.handler.connect can find handler
#         definitions when a connection arrives

my $socket = shift;
my $type   = shift;
my $mode   = shift;

unless ( defined $socket and fileno($socket) ) {
    <[base.logs]>->( 0, "httpsd.register_socket: invalid socket supplied" );
    return undef;
}

unless ( defined $type and defined $mode ) {
    <[base.logs]>->(
        0, "httpsd.register_socket: missing type or mode parameter"
    );
    return undef;
}

my $fd = fileno($socket);

## register socket in handle data structure using both socket ref and FD
## socket ref is used by base.protocol.bind, FD used by handler lookup
$data{'handle'}{$socket}{'link'}     = $type;
$data{'handle'}{$socket}{'mode'}     = $mode;
$data{'handle'}{$socket}{'protocol'} = 'https';

$data{'handle'}{$fd}{'link'}     = $type;
$data{'handle'}{$fd}{'mode'}     = $mode;
$data{'handle'}{$fd}{'protocol'} = 'https';

<[base.logs]>->(
    2,
    "httpsd.register_socket: registered fd=$fd "
        . "using both socket ref and numeric fd"
);
<[base.logs]>->( 3, "  type=$type mode=$mode protocol=https" );

## reset retry counter on successful socket registration  indicates httpsd
## started successfully and no longer needs to retry
<httpsd.startup.retry_count> = 0;
<[base.logs]>->(
    2, 'httpsd: socket registration successful, retry counter reset'
);

return TRUE;

0;

