## [:< ##

# name  = user-edit.test.secret_send_hold
# descr = send HOLD for the current test case index -- called both from
#         the console command [ first case ] and from the release reply
#         handler [ chaining into the next case ]

my $cube_sid = <user-edit.test.cube_sid>;
my $index    = <user-edit.test.index>;
my $case     = <user-edit.test.cases>->[$index];

<[base.logs]>->(
    2,      ': secret roundtrip case %d [ %s ]: sending hold',
    $index, $case->{'label'}
);

<[protocol-7.command.send.local]>->(
    {   qw| command |   => sprintf( '%d.sessions.hold', $cube_sid ),
        qw| call_args | => {
            qw| args | => sprintf( '%s %s',
                $case->{'name'}, encode_b32r( $case->{'value'} ) )
        },
        qw| reply | =>
            { qw| handler | => qw| user-edit.handler.secret_hold_reply | }
    }
);

return TRUE;

