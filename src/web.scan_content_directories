## [:< ##

# name = web.scan_content_directories
# descr = Recursively scan content directories for template candidates
#
# Scans /var/httpd/{vhost}/ for files and checks if templates exist
# using the 3-level hierarchy: vhost-subdir -> vhost-root -> global
#
# Parameters:
#   $ARG[0] - Base directory (default: /var/httpd)
#   $ARG[1] - Vhost name (optional: scan specific vhost only)
#
# Returns:
#   Hash reference with { status, message, count, index }
#   Stores results in $data{'web'}{'content_index'}

my $base_dir = shift // <web.cfg.base_dir> // '/var/httpd';
my $vhost    = shift // '';

my $scan_dir = $vhost ? "$base_dir/$vhost" : $base_dir;

## skip if directory not found ##
unless ( -d $scan_dir ) {
    return {
        status  => qw| error |,
        message => "Directory not found: $scan_dir",
        count   => 0,
    };
}

## build content index ##
my $index = {};

## manual directory recursion [ no File::Find needed ] ##
my @dirs_to_scan = ($scan_dir);

while ( my $current_dir = shift @dirs_to_scan ) {
    opendir my $dh, $current_dir
        or next;    # Skip directories we can't read

    my @entries = readdir $dh;
    closedir $dh;

    foreach my $entry (@entries) {
        next if $entry eq '.' or $entry eq '..';
        next if $entry =~ m|^[_.]|;    ## skip hidden and special dirs

        my $full_path = "$current_dir/$entry";

        if ( -d $full_path ) {

            ## queue subdirectory for scanning ##
            push @dirs_to_scan, $full_path;
        } elsif ( -f $full_path ) {

            ## process file ##
            my $rel_path = $full_path;
            $rel_path =~ s|^$scan_dir||;
            $rel_path =~ s|^/||;

            my $file = $entry;

            ## check if template exists [ 3-level hierarchy ] ##
            my $has_template   = 0;
            my $template_path  = undef;
            my $template_level = 0;

            ## get subdirectory name if any ##
            my $subdir = '';
            if ( $rel_path =~ m|^(.+)/[^/]+$| ) {
                $subdir = $1;
            }

            ## level 1 : vhost subdirectory templates ##
            if ($subdir) {
                my $subdir_template
                    = "$base_dir/$vhost/$subdir/_templates/$file.tmpl";
                if ( -f $subdir_template ) {
                    $has_template   = 1;
                    $template_path  = $subdir_template;
                    $template_level = 1;
                }
            }

            ## level 2 : vhost root templates ##
            unless ($has_template) {
                my $vhost_template = "$base_dir/$vhost/_templates/$file.tmpl";
                if ( -f $vhost_template ) {
                    $has_template   = 1;
                    $template_path  = $vhost_template;
                    $template_level = 2;
                }
            }

            ## level 3 : global templates ##
            unless ($has_template) {
                my $global_template
                    = "$base_dir/_global_templates/$file.tmpl";
                if ( -f $global_template ) {
                    $has_template   = 1;
                    $template_path  = $global_template;
                    $template_level = 3;
                }
            }

            ## get file stats ##
            my $mtime = File::stat::stat($full_path)->mtime // 0;
            my $size  = -s $full_path                       // 0;

            ## store in index ##
            $index->{ "/" . $rel_path } = {
                path           => "/" . $rel_path,
                has_template   => $has_template ? 1 : 0,
                template_path  => $template_path,
                template_level => $template_level,
                mtime          => $mtime,
                size           => $size,
                is_dynamic     => $has_template ? 1 : 0,
            };
        }
    }
}

## store in global data structure ##
my $vhost_key = $vhost || '_all_';
<web.content_index>->{$vhost_key} = $index;

my $entry_count = scalar( keys %$index );

<[base.log]>->(
    2,
    "scanned content directories: $entry_count entries for vhost='$vhost_key'"
);

return {
    status  => qw| success |,
    message => "Scanned $entry_count entries",
    count   => $entry_count,
    index   => $index,
};

