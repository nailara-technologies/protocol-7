# name  = fetch.file.huggingface.handler.list_response
# descr = parse HF API repo response and format GGUF file list

my $data   = shift;
my $params = $data->{'params'}   // {};
my $req_id = $params->{'req_id'} // '';
my $body   = $data->{'body'}     // '';
my $ok     = $data->{'ok'};

my $pending = <fetch.file.hf_pending>->{$req_id};
return if !defined $pending;

delete <fetch.file.hf_pending>->{$req_id};

my $reply_id = $pending->{'reply_id'};

if ( !$ok ) {
    <[base.callback.cmd_reply]>->(
        $reply_id,
        {   'mode' => qw| false |,
            'data' => 'HF API request failed'
        }
    ) if length $reply_id;
    return;
}

## parse JSON response ##
my $repo_info = eval { JSON::XS::decode_json($body) };
if ( $EVAL_ERROR || !ref $repo_info ) {
    <[base.callback.cmd_reply]>->(
        $reply_id,
        {   'mode' => qw| false |,
            'data' => 'failed to parse HF API response'
        }
    ) if length $reply_id;
    return;
}

my $siblings = $repo_info->{'siblings'} // [];
my @gguf_files;

for my $sib (@$siblings) {
    my $rfilename = $sib->{'rfilename'} // '';
    next if $rfilename !~ m\.gguf$\i;

    ## sizes come with ?blobs=true [ huggingface.list ] ; per-file download ##
    ## counts are not in the api at all                                     ##
    my $size = $sib->{'size'} // 0;

    push @gguf_files,
        {
        'file'    => $rfilename,
        'size'    => $size,
        'size_gb' => sprintf( '%.2f', $size / ( 1024**3 ) ),
        };
}

if ( !@gguf_files ) {
    <[base.callback.cmd_reply]>->(
        $reply_id,
        {   'mode' => qw| true |,
            'data' => 'no .gguf files found in repository'
        }
    ) if length $reply_id;
    return;
}

## format table ##
my @lines = sprintf( "%-58s %10s", 'file', 'size' );
push @lines, '-' x 69;

for my $f ( sort { $a->{'size'} <=> $b->{'size'} } @gguf_files ) {
    push @lines,
        sprintf( "%-58s %10s", $f->{'file'}, $f->{'size_gb'} . ' GB' );
}

my $output = join( "\n", @lines );

if ( length $reply_id ) {
    <[base.callback.cmd_reply]>->(
        ## size mode : multi-line data, true mode escapes the newlines ##
        $reply_id, { 'mode' => qw| size |, 'data' => "$output\n" }
    );
} else {
    <[base.logs]>->( 1, "[hf.list]\n%s", $output );
}

