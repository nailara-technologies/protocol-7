## [:< ##

# name  = osf-cache.debian.read_packages
# descr = stream a debian Packages file into an anchor index
# param = { path, expect => { algo, hash } [ optional ] }
#
# reads a debian Packages index line by line [ never slurped - real
# indexes reach hundreds of thousands of stanzas ]. BOTH 'SHA256:' and
# 'SHA512:' stanza fields are read ; every stanza with a Package field
# and at least one of them is indexed by its anchor token :
# by_anchor => { '<algo>:<hex>' => { package, version, architecture,
# filename, size } } - a stanza carrying both fields is indexed under
# both keys. algos lists the sorted algos seen. the file digests are
# computed while streaming ; when expect => { algo, hash } is given
# [ the value anchored in the signed InRelease ], anchored reports 1
# if the digest of that algo matches and 0 otherwise.

my $args   = shift           // {};
my $path   = $args->{'path'} // '';
my $expect = $args->{'expect'};

return { 'mode' => 'false', 'data' => 'path required' } unless length $path;
return { 'mode' => 'false', 'data' => "cannot read $path" } unless -f $path;

my %expect_entry;
if ( defined $expect ) {
    return { 'mode' => 'false', 'data' => 'expect must be a hash' }
        unless ref $expect eq qw| HASH |;
    %expect_entry = %$expect;
}

require Digest::SHA;    ## core - loaded here, modules carry no use ##

open( my $fh, '<', $path )
    or return {
    'mode' => 'false',
    'data' => "cannot open $path : $OS_ERROR"
    };

my %field_map = (
    'Package'      => 'package',
    'Version'      => 'version',
    'Architecture' => 'architecture',
    'Filename'     => 'filename',
    'Size'         => 'size',
    'SHA256'       => 'sha256',
    'SHA512'       => 'sha512',
);

my $ctx     = Digest::SHA->new(256);
my $ctx_512 = Digest::SHA->new(512);
my %by_anchor;
my $entries = 0;
my %cur;

## flush one stanza into the index [ needs package + at least one hash ] ##
my $flush = sub {
    if ( length( $cur{'package'} // '' ) ) {
        my $indexed = 0;
        foreach my $field ( sort grep {m{^SHA\d+$}} keys %field_map ) {
            my $hex = $cur{ lc $field } // '';
            next unless length $hex;
            $by_anchor{ sprintf '%s:%s', lc $field, lc $hex } = {
                'package'      => $cur{'package'},
                'version'      => $cur{'version'},
                'architecture' => $cur{'architecture'},
                'filename'     => $cur{'filename'},
                'size'         => $cur{'size'},
            };
            $indexed = 1;
        }
        $entries++ if $indexed;
    }
    %cur = ();
};

while ( my $line = <$fh> ) {
    ## hash the raw line before any chomping [ sha512 for the repos whose ##
    ## index anchors sha512-only entries ]                                ##
    $ctx->add($line);
    $ctx_512->add($line);
    chomp $line;
    $line =~ s{\r$}{};
    next if $line =~ m{^#};      ## signature footer lines are never fields ##
    if ( $line =~ m{^\s*$} ) {
        $flush->();
        next;
    }
    next unless $line =~ m{^(\S+):\s?(.*)$};
    my $key = $field_map{$1};
    $cur{$key} = $2 if $key;
}
$flush->();    ## trailing stanza without final blank line ##
close($fh);

my $file_sha256 = $ctx->hexdigest;
my $file_sha512 = $ctx_512->hexdigest;

## anchored when the expected hash matches the digest of its algo ##
my $anchored = 0;
if ( length( $expect_entry{'hash'} // '' ) ) {
    my $algo = lc( $expect_entry{'algo'} // '' );
    my $hash = lc $expect_entry{'hash'};
    $anchored = 1
        if ( $algo eq qw| sha256 | and $file_sha256 eq $hash )
        or ( $algo eq qw| sha512 | and $file_sha512 eq $hash );
}

my %seen_algos;
foreach my $token ( keys %by_anchor ) {
    my ($algo) = split m{:}, $token, 2;
    $seen_algos{$algo} = 1;
}

return {
    'mode' => qw| true |,
    'data' => {
        'entries'     => $entries,
        'by_anchor'   => \%by_anchor,
        'algos'       => [ sort keys %seen_algos ],
        'file_sha256' => $file_sha256,
        'file_sha512' => $file_sha512,
        'anchored'    => $anchored,
    }
};

