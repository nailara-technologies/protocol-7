## [:< ##

# name  = base.protocol.compile_once
# descr = Compile Protocol-7 module if not already compiled

my $module_path = shift;

return undef unless defined $module_path;

## check if already compiled ##
my $module_name = $module_path;
$module_name =~ s{^src/}{};
$module_name =~ s{/}{.}g;

return TRUE if exists $code{$module_name};

## module compilation is handled by base.load_code  this stub just confirms ##
## the module exists                                                        ##
return TRUE;

