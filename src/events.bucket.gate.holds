## [:< ##

# name   = events.bucket.gate.holds
# descr  = evaluate a parsed gate against its source reading
# args   = gate, answer text [ seen : records, since unix time ]
# return = { open => TRUE | FALSE, used, resets_in, reading }
#
# compact usage rows are provider, window, used percent, reset seconds. a
# missing or malformed reading is closed and says why. task, seen and sign
# queue readings use the same result shape for their unless evaluation

my ( $gate, $text, $since ) = @ARG;
my $closed = sub {
    return { 'open' => FALSE, 'readable' => FALSE, 'reading' => shift };
};
if ( ( $gate->{'kind'} // qw| budget | ) eq qw| task | ) {
    $text //= '';
    return $closed->('task : no status in task.show answer')
        if $text !~ m{^status\s+:\s+(\w+)\s*$}m;
    my $state = lc $1;
    return {
        'open'     => $state eq $gate->{'state'} ? TRUE : FALSE,
        'readable' => TRUE,
        'reading'  => "task $gate->{'id'} status "
            . "$state [ needs $gate->{'state'} ]"
    };
}
if ( ( $gate->{'kind'} // '' ) eq qw| sign-queue | ) {
    $text //= '';
    $text =~ s{(?:\\n|\s)+\z}{};
    return $closed->('sign queue : empty answer') if not length $text;
    return {
        'open'     => $text =~ m{\Asign queue empty\s*\z} ? TRUE : FALSE,
        'readable' => TRUE,
        'reading'  => $text =~ m{\Asign queue empty\s*\z}
        ? 'sign queue empty'
        : 'sign queue has entries'
    };
}
if ( ( $gate->{'kind'} // '' ) eq qw| seen | ) {
    foreach my $rec ( reverse @{ ref $text eq qw| ARRAY | ? $text : [] } ) {
        my $stamp = str2time( $rec->{'time'} // '' );
        next if not defined $stamp or $stamp < ( $since // 0 );
        next if ( $rec->{'name'} // '' ) ne $gate->{'name'};
        next
            if defined $gate->{'key'}
            and ( $rec->{'values'}{ $gate->{'key'} } // '' ) ne
            $gate->{'value'};
        return {
            'open'     => TRUE,
            'readable' => TRUE,
            'reading'  => "signal $gate->{'name'} raised at $rec->{'time'}"
        };
    }
    return {
        'open'     => FALSE,
        'readable' => TRUE,
        'reading'  => "signal $gate->{'text'} not raised since reminder"
    };
}
$text //= '';
my ( $used, $resets_in );
foreach my $line ( split m{\n}, $text ) {
    my ( $provider, $window, $pct, $resets ) = split m{\s+}, $line;
    next if ( $provider // '' ) ne $gate->{'provider'};
    return $closed->( 'usage : ' . ( $line =~ s{\A\S+\s+error\s+}{}r ) )
        if ( $window // '' ) eq qw| error |;
    next if ( $window // '' ) ne $gate->{'window'};
    next if ( $pct    // '' ) !~ m{\A\d+(?:\.\d+)?\z};
    $used      = $pct + 0;
    $resets_in = $resets if ( $resets // '' ) =~ m{\A-?\d+\z};
    last;
}
return $closed->("usage : no $gate->{'provider'} $gate->{'window'} row")
    if not defined $used;
my $op = $gate->{'op'};
my $p  = $gate->{'percent'};
my $open
    = $op eq '<'  ? $used < $p
    : $op eq '<=' ? $used <= $p
    : $op eq '>'  ? $used > $p
    :               $used >= $p;
return {
    'open'      => $open ? TRUE : FALSE,
    'readable'  => TRUE,
    'used'      => $used,
    'resets_in' => $resets_in,
    'reading'   => sprintf(
        '%s %s %.1f %% used [ needs %s%s ]',
        $gate->{'provider'}, $gate->{'window'}, $used, $op, $p
    )
};

