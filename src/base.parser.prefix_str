## [:< ##

# name  = base.parser.prefix_str
# param = <prefix> [values]
# descr = return prefixed list as space seperated string [for cfg inclusion]

my $prefix_str = shift;
return warn 'expected prefix string param <{C1}>' if not defined $prefix_str;

my @values = split m|\s+|, join ' ', @ARG;
return '' if !@values;    ## nothing to do ##

return join ' ', map { join '', $prefix_str, $ARG } @values;    ## prefixed ##

