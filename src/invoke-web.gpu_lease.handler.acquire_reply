## [:< ##

# name  = invoke-web.gpu_lease.handler.acquire_reply
# descr = acquire command completed [ a grant arrives separately ]

## a refusal [ models on hold : blocked start ] counts as no answer : the   ##
## acquire timeout marks models unavailable and backs off                   ##
## [ cleared here, every processor poll sent a new request, once a second ] ##
my ($mode) = <[base.reply.mode_text]>->( shift // {} );
return TRUE if $mode eq qw| false |;
<invoke-web.gpu_lease.request_inflight> = FALSE;
## models answered : a probe ends, the normal pause and yield apply again ##
delete <invoke-web.gpu_lease.probe>;
delete <invoke-web.gpu_lease.retry_after>;
return TRUE;

