## [:< ##

# name = power.set_states

my $device_id  = shift;
my @set_states = @_;
die "expected valid device id"
    if not defined $device_id
    or not exists <power.cfg.devices>->{$device_id};

my ( $dev, $driver ) = <[power.dev_obj]>->($device_id);

if ( not defined $dev ) {
    <[base.log]>->( 0, "connection to device $device_id failed" );
    return undef;
}

my $outlets = $code{"power.plugin.$driver.outlets"}->($dev);

die "expected at most $outlets socket state parameters"
    if @set_states > $outlets;

## fewer states than outlets : the rest is skipped ##
push @set_states, undef while @set_states < $outlets;

my $new_states = $code{"power.plugin.$driver.set"}->( $dev, \@set_states );

return undef if ref $new_states ne qw| ARRAY |;

<power.last_states> = $new_states;

return $new_states->@*;

