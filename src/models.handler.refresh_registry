## [:< ##

# name  = models.handler.refresh_registry
# descr = Deferred handler to refresh registry from disk

<[base.logs]>->( 2, '[refresh_registry] reloading registry from disk' );

## Reload from disk to catch updates from other zenka instances ##
my $persisted_registry = <[models.storage.yaml_load]>;
if ( ref($persisted_registry) eq qw| HASH |
    && scalar( keys %$persisted_registry ) > 0 ) {

    my $current_count = scalar keys %{ <models.registry> // {} };
    my $new_count     = scalar keys %$persisted_registry;

    if ( $new_count != $current_count ) {
        <[base.logs]>->(
            1,              '[refresh_registry] updating: %d -> %d entries',
            $current_count, $new_count
        );
        <models.registry> = $persisted_registry;
    } else {
        <[base.logs]>->( 2, '[refresh_registry] no changes needed' );
    }
}

return TRUE;

