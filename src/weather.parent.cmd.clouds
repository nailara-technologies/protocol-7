## [:< ##

# name  = weather.parent.cmd.clouds
# descr = return current local cloud coverage in %

my $stid = <weather.station_id>;

## first data still pending [ on-demand start ] : answer when it lands ##
my $parked = <[weather.parent.park_pending]>->( $call, qw| clouds | );
return $parked if defined $parked;

my $current = <weather.data>->{$stid}->{'current'};

return {
    'mode' => qw| false |,
    'data' => 'no city selected (undefined station id)'
    }
    if not defined $stid;

my $clouds = $current->{'clouds'} // 'n|a';
$clouds .= "%" if $clouds =~ m|^\d+(\.\d+)?$|;

return { 'mode' => qw| true |, 'data' => $clouds }

