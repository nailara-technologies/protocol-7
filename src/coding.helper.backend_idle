## [:< ##

# name  = coding.helper.backend_idle
# descr = shared global idle predicate, extracted verbatim from
#         coding.handler.vision_switch_poll [ itself mirrored from
#         coding.handler.drain_check ] : zero active [ non-completed,
#         non-failed ] tasks in <coding.task.queue> AND no backend lock
#         held anywhere in <coding.state.backend>. deliberately GLOBAL,
#         not per-backend -- loops every backend lock and counts the whole
#         task queue. returns a hashref so callers can both branch on
#         'idle' and log the 'active' / 'in_flight' counts.
# param = [ aref of task ids to leave out : tasks that only wait on the
#         caller, e.g. the parent chain analyze_image :switch: parks ]

my $exclude = { map { $ARG => TRUE } @{ shift // [] } };

my $active = 0;
if ( exists <coding.task.queue> ) {
    for my $task_id ( keys <coding.task.queue>->%* ) {
        next if $exclude->{$task_id};
        my $task = <coding.task.queue>->{$task_id};
        my $st   = $task->{'execution'}{'status'} // '';
        $active++ unless $st eq 'completed' or $st eq 'failed';
    }
}

## the lock AND matters : the lock can release after the final completion ##
## event, so a zero-active queue alone is not proof of idle               ##
my $backend_ref = <coding.state.backend> // {};
my $in_flight   = 0;
## every lock key : gpu-routed tasks lock under their routing name ##
## [ e.g. single-llm ], not only gpu / cpu                         ##
for my $backend ( keys %$backend_ref ) {
    my $holder = $backend_ref->{$backend}{'lock'};
    $in_flight++ if defined $holder and not $exclude->{$holder};
}

return {
    'idle'      => ( $active == 0 && $in_flight == 0 ? TRUE : FALSE ),
    'active'    => $active,
    'in_flight' => $in_flight,
};

