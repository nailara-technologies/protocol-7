# name = tile.callback.poll_tile_color

my $params = shift->w->data // {};

my $tile_name        = $params->{'tile_name'};
my $current_interval = $params->{'current_interval'};

my $bg_color = <tile.x11_bg_color> // '';

<tile.last_tile_color> //= {};
<tile.last_tile_color>->{$tile_name} //= $bg_color;

my %zenka_names;
map { $zenka_names{$ARG} = 1 if $ARG =~ m|\[$tile_name\]$| }
    keys <tile.coordinates>->%*;
( my $zenka_name ) = keys(%zenka_names);

my $coordinates_data = <tile.coordinates>->{$zenka_name};

my @coordinates;
my @borders = ( 'left', 'top', 'right', 'bottom' );
foreach my $border_name (@borders) {
    push( @coordinates, $coordinates_data->{$border_name} )
        if defined $coordinates_data->{$border_name};
}

return warn "[!] unable to find coordinates for tile '$tile_name'"
    if @coordinates != 4;

<[protocol-7.command.send.local]>->(
    {   'command'   => 'cube.screenshot.return-region-color',
        'call_args' => { 'args' => join( ' ', @coordinates ) },
        'reply'     => {
            'handler' => qw| tile.handler.poll_tile_color_reply |,
            'params'  => {
                'tile_name'        => $tile_name,
                'current_interval' => $current_interval
            }
        }
    }
);

