## [:< ##

# name  = ascii.frame.load
# descr = load named frame from yaml, parse mockup(s), cache descriptors

my $name = shift // return undef;

## check cache [ wiped on reload by ascii.frame.init_code, so edited frame ##
## yaml is re-parsed after a source reload ]                               ##
if ( exists <ascii.frame.cache>->{$name} ) {
    return <ascii.frame.cache>->{$name};
}

## resolve yaml path ##
my $root = <system.root_path>;
my $path = "$root/data/yaml/ascii-frames/$name.yaml";

unless ( -f $path and -r $path ) {
    <[base.logs]>->( 0, ': ascii frame not found [ %s ]', $path );
    return undef;
}

## load yaml ##
my ( $yaml, $err ) = <[format.yaml.load_file]>->($path);

if ( defined $err or not defined $yaml ) {
    <[base.logs]>->(
        0,     ': ascii frame parse error [ %s ]: %s',
        $name, $err // 'empty'
    );
    return undef;
}

## determine mode structure ##
my $has_mockup     = exists $yaml->{'mockup'};
my @mockup_keys    = grep {m{^mockup_}} keys %{$yaml};
my $is_single_mode = 0;
my %descriptors;

if ($has_mockup) {
    $is_single_mode = 1;
    my $parsed = <[ascii.frame.parse]>->( $yaml->{'mockup'} );
    if ( defined $parsed ) {
        $descriptors{'mockup'} = $parsed;
    } else {
        <[base.logs]>->(
            0, ': ascii frame mockup parse failed [ %s ]', $name
        );
    }
} elsif (@mockup_keys) {
    for my $key (@mockup_keys) {
        my $mode = $key;
        $mode =~ s{^mockup_}{};
        my $parsed = <[ascii.frame.parse]>->( $yaml->{$key} );
        if ( defined $parsed ) {
            $descriptors{$mode} = $parsed;
        } else {
            <[base.logs]>->(
                0,     ': ascii frame mockup parse failed [ %s ] mode=%s',
                $name, $mode
            );
        }
    }
}

## apply border style ##
my $border_style = $yaml->{'border_style'} // 'single';
if ( $border_style eq 'double' ) {
    for my $desc ( values %descriptors ) {
        $desc->{'border_style'} = 'double';
    }
}

## validate each descriptor ##
for my $mode ( keys %descriptors ) {
    my $result = <[ascii.frame.validate]>->( $descriptors{$mode} );
    if ( not $result->{'valid'} ) {
        <[base.logs]>->(
            2,
            ': ascii frame validation warning [ %s ] mode=%s ' . 'errors=%d',
            $name,
            $mode,
            scalar $result->{'errors'}->@*
        );
    }
}

## build frame entry ##
my $entry = {
    name         => $yaml->{'name'}  // $name,
    title        => $yaml->{'title'} // '',
    descr        => $yaml->{'descr'} // '',
    border_style => $border_style,
    modes        => $yaml->{'modes'} // ['expanded'],
    slots        => $yaml->{'slots'} // {},
};

if ($is_single_mode) {
    $entry->{'descriptor'} = $descriptors{'mockup'};
} else {
    $entry->{'descriptors'} = \%descriptors;
}

## [ apply explicit padding from yaml if given ]##
if ( exists $yaml->{'padding'} ) {
    my $pad = $yaml->{'padding'};
    for my $desc ( values %descriptors ) {
        $desc->{'padding'}{'left'} = $pad->{'left'}
            if exists $pad->{'left'};
        $desc->{'padding'}{'right'} = $pad->{'right'}
            if exists $pad->{'right'};
        $desc->{'padding'}{'top'} = $pad->{'top'}
            if exists $pad->{'top'};
        $desc->{'padding'}{'bottom'} = $pad->{'bottom'}
            if exists $pad->{'bottom'};
    }
}

## [ apply outer margin from yaml if given : space OUTSIDE the border — the ##
## parent-plane's breathing room, assignable per frame, 0 when nested ]     ##
if ( exists $yaml->{'margin'} ) {
    my $mar = $yaml->{'margin'};
    for my $desc ( values %descriptors ) {
        $desc->{'margin'}{'left'} = $mar->{'left'}
            if exists $mar->{'left'};
        $desc->{'margin'}{'right'} = $mar->{'right'}
            if exists $mar->{'right'};
    }
}

## cache and return ##
<ascii.frame.cache>->{$name} = $entry;

<[base.logs]>->(
    2,     ': ascii frame loaded [ %s ] [ %s ]',
    $name, $is_single_mode ? 'single' : 'multi'
);

return $entry;

