## [:< ##

# name = branch.session.jump
# descr = load context at checksum, create dag node with two parents

my $resumed_state  = shift // return undef;
my $decision_point = shift // return undef;

return warn 'resumed state checksum required <{C1}>'
    if not length $resumed_state;
return warn 'decision point checksum required <{C1}>'
    if not length $decision_point;

return warn 'resumed state not found in dag <{C1}>'
    if not exists $data{ 'branch.session.dag.' . $resumed_state };
return warn 'decision point not found in dag <{C1}>'
    if not exists $data{ 'branch.session.dag.' . $decision_point };

my $jump_checksum = <[branch.session.dag.node_add]>->(
    {   'parents' => [ $resumed_state, $decision_point ],
        'content' => \'',
        'intent'  => '',
        'state'   => 'open',
    }
);

return $jump_checksum;

