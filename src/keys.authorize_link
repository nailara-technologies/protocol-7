## [:< ##

# name  = keys.authorize_link
# descr = create the authorized/<zenka>/<username>.public symlink for a pin
# note  = shared by keys.console.authorize and keys.console.add-incoming ;
#         every directory it creates is verified owned by the key user via
#         keys.owned_dir and the symlink itself is lchown'ed when running
#         as root ; refusal messages are printed here, TRUE/FALSE returned

my ( $zenka, $username, $allow_same ) = @ARG;    ## allow_same : a link to ##
## the same pin = success ##

my $key_vars_ref  = <[crypt.C25519.key_vars]>;
my $incoming_dir  = $key_vars_ref->{'incoming_dir'};
my $auth_base_dir = $key_vars_ref->{'auth_dir'};
my $uid           = $key_vars_ref->{'uid'};
my $gid           = $key_vars_ref->{'gid'};

if ( not defined $incoming_dir or not defined $auth_base_dir ) {
    say "\n  << key registry directories not resolved >>\n";
    return FALSE;
}

## authorized/<zenka>/<username>.public is checked by                      ##
## plugin.auth.auth-keypair.validate-incoming-tofu purely for existence    ##
## [ -l && -f ] -- its target is never read/compared there, the actual     ##
## pubkey match happens independently against whatever incoming file the   ##
## connecting client's host:port resolves to. so any currently-pinned file ##
## for this username is a valid target; prefer the unrestricted pin        ##
## [ same fallback order validate-incoming-tofu itself uses ]              ##
my $unrestricted_file = catfile( $incoming_dir, "${username}.public" );

my $pin_file;
if ( -f $unrestricted_file ) {
    $pin_file = $unrestricted_file;
} else {
    foreach
        my $file ( glob catfile( $incoming_dir, "${username}.*.public" ) ) {
        $pin_file = $file;
        last;
    }
}

if ( not defined $pin_file ) {
    printf(
        "\n  << no pending incoming key for "
            . "'%s' -- nothing to authorize >>\n\n",
        $username
    );
    return FALSE;
}

my $zenka_dir = catfile( $auth_base_dir, $zenka );
my $auth_link = catfile( $zenka_dir,     "${username}.public" );

## ownership of every directory on the path -- as root a mismatched        ##
## existing directory is fixed [ with a warning line from keys.owned_dir ] ##
## , as anyone else the helper refuses with a clear error. walked before   ##
## the already-authorized check : a repeated call repairs a root-made tree ##
my $remote_keys_dir = $auth_base_dir;
$remote_keys_dir =~ s|/+[^/]+$||;

return FALSE
    if not <[keys.owned_dir]>->( $remote_keys_dir, 0750, $uid, $gid );
return FALSE
    if not <[keys.owned_dir]>->( $auth_base_dir, 0700, $uid, $gid );
return FALSE if not <[keys.owned_dir]>->( $zenka_dir, 0700, $uid, $gid );

if ( -e $auth_link or -l $auth_link ) {
    ## same pin already linked : success for a caller that allows it ##
    if ( $allow_same and ( readlink($auth_link) // '' ) eq $pin_file ) {
        printf "\n  :: '%s' already authorized for '%s' ::\n\n", $username,
            $zenka;
        return TRUE;
    }
    printf( "\n  << '%s' is already authorized for '%s' >>\n\n",
        $username, $zenka );
    return FALSE;
}

symlink( $pin_file, $auth_link )
    or die sprintf( "<< symlink failed : %s >>\n", <[base.str.os_err]> );

if ( $EUID == 0 and defined $uid ) {
    require POSIX;
    if ( not POSIX::lchown( $uid, $gid, $auth_link ) ) {
        printf "\n  << lchown '%s' failed : %s >>\n\n",
            $auth_link, <[base.str.os_err]>;
    }
}

return TRUE;

