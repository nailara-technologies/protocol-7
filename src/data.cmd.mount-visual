## [:< ##

# name  = data.cmd.mount-visual
# descr = mount visual similarity structure as FUSE filesystem
# param = <source-images-path> <mountpoint> [options]

my $params = shift // return { 'mode' => qw| false |, 'data' => 'no params' };
my @args   = split m{\s+}, $params->{'args'} // '';

my ( $source_path, $mountpoint, $options ) = @args;

return {
    'mode' => qw| size |,
    'data' => <<'EOT' } unless defined $source_path and defined $mountpoint;

::[ data mount-visual <source-path> <mountpoint> [options] ]:.
:
:: Mount images sorted by visual similarity as navigable FUSE filesystem
:
:: source-path .... directory containing images
:: mountpoint ..... local directory to mount FUSE filesystem
:: options ........ json-encoded options (optional)
::
:: Spheres (directories created):
::   core/    - 1x1 pixel color samples
::   inner/   - tiny thumbnails (2-4px)
::   mid/     - small images (5-6px)
::   outer/   - medium images (7-8px)
::   halo/    - large images (9-10px)
::   nebula/  - very large (11-12px)
::   void/    - full resolution (13px+)
.

EOT

## Validate source path
return { 'mode' => qw| false |, 'data' => "source not found: $source_path" }
    unless -d $source_path;

## Find all images in source path
my @images = glob("$source_path/*.{png,jpg,jpeg,gif,bmp,webp}");

return { 'mode' => qw| false |, 'data' => 'no images found' } unless @images;

## Call graphics-matrix to sort images into cubic spheres
my $sorted = <[graphics.matrix.visual.cubic-sort]>->(
    {   'images'      => \@images,
        'max_spheres' => 6,
    }
);

return { 'mode' => qw| false |, 'data' => $sorted->{'data'} }
    if $sorted->{'mode'} eq qw| false |;

## Create hash structure for FUSE mounting
my $visual_hash = {
    'type'       => qw| visual_similarity |,
    'source'     => $source_path,
    'total'      => $sorted->{'total_images'},
    'spheres'    => {},
    'clusters'   => $sorted->{'clusters'},
    'statistics' => $sorted->{'statistics'},
};

## Organize by spheres
for my $sphere_num ( 0 .. 6 ) {
    my $sphere_name
        = [qw| core inner mid outer halo nebula void |]->[$sphere_num];
    my $sphere_data = $sorted->{'spheres'}{$sphere_num} // [];

    $visual_hash->{'spheres'}{$sphere_name} = {
        'count'  => scalar(@$sphere_data),
        'images' => $sphere_data,
    };
}

## Mount via data channel SHM/FUSE
my $mount_result = <[data.cmd.mount-hash]>->(
    { 'args' => "$mountpoint " . <[format.json.encode]>->($visual_hash), } );

return $mount_result;

