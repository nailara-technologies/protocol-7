## [:< ##

# name   = invoke-web.start_paused
# descr  = queue pause mode for an invoke.ai start [ invoke-web.start_paused ]
# return = 'no' | 'yes' | 'startup'
# note   = yes : paused at ready, stays paused until resume. startup : held
#          and paused only while starting [ invoke.ai dequeues before its
#          api is up ], resumed after the release. other values as
#          base.cfg_bool [ on \ true -> yes, off \ no -> no ]

my $mode = lc( <invoke-web.start_paused> // qw| no | );
return $mode if $mode eq qw| startup |;
return <[base.cfg_bool]>->($mode) ? qw| yes | : qw| no |;

