## [:< ##
# name  = plan-9.server.export_directory
# descr = Export a real filesystem directory for 9P access
#
# Registers into the same top-level $data{'plan-9'}{'server'}{'buffers'}
# root registry that plan-9.server.export_buffer uses, so the existing
# root-listing/attach/dispatch code needs no changes -- a 'kind' field
# distinguishes a real directory export from a vterm-buffer export.
# Walking below the exported root is handled by the 'realpath' fid type
# in plan-9.server.handle_walk, and content reads by
# plan-9.server.realpath-read.
#
# 'writable' and 'symlink_policy' are opt-in per export -- read-only and
# 'reject' are the safe defaults unless the caller asks for otherwise.
# symlink_policy: 'reject' (default) | 'contained' (allow only if the
# resolved target stays inside the export root) | 'allow' (no check).

my ( $real_path, $name, $writable, $symlink_policy ) = @ARG;

return 0 unless defined $real_path and length $real_path and -d $real_path;
return 0 unless defined $name and length $name;

## caller's responsibility to pass an absolute path -- this is a plain ##
## registration step, not a path-resolution one                        ##
return 0 unless $real_path =~ m{^/};

$symlink_policy = 'reject'
    unless defined $symlink_policy
    and $symlink_policy =~ m{^(?:reject|contained|allow)$};

## canonicalize once at export time so every containment check downstream ##
## compares against the same normalized root                              ##
my $root = Cwd::abs_path($real_path) // $real_path;

my $writable_flag = $writable ? 1 : 0;

<plan-9.server.buffers>->{$name} = {
    'kind'           => 'directory',
    'realpath'       => $real_path,
    'root'           => $root,
    'writable'       => $writable_flag,
    'symlink_policy' => $symlink_policy,
    'qid_path'       => <plan-9.server.next_qid>++,
    'qid_version'    => 0,
    'exported_at'    => <[base.ntime]>,
};

<[base.logs]>->( "Exported directory $real_path as '$name' for 9P access "
        . "[writable=$writable_flag symlinks=$symlink_policy]" );

return 1;

