# name  = base.handler.ondemand_idle_term_reply
# descr = v7-zenki.idle-term reply handler [ idle on-demand zenka self-exit ]
# note  = v7 only ever replies FALSE here -- on the accept path it replies
#         'deferred' and never completes it, since it's about to terminate
#         us anyway, so this handler only ever sees a rejection

my $reply = shift;

<[base.logs]>->(
    1,
    'v7-zenki.idle-term declined [ %s ], exiting directly ..,',
    $reply->{'call_args'}->{'args'} // qw| no reason given |
);

exit(0);

