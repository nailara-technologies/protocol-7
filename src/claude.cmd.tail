## [:< ##

# name  = claude.cmd.tail
# param = [ n ]
# descr = the last n readable event lines

my $n = $call->{'args'} // '';
$n =~ s{\s+}{}g;
$n = 21 if not length $n;
return { 'mode' => qw| false |, 'data' => 'n : a number expected' }
    if $n !~ m|\A\d{1,5}\z|;
my $events = <claude.events> // [];
my $from   = @{$events} > $n ? @{$events} - $n : 0;
return {
    'mode' => qw| true |,
    'data' => "no events yet\n"
    }
    if not @{$events};
return {
    'mode' => qw| true |,
    'data' => join( "\n", @{$events}[ $from .. $#$events ] ) . "\n"
};

