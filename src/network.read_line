## [:< ##

# name  = network.read_line
# param = <path>
# descr = first line of a small sysfs \ proc file, undef when unreadable

my $path = shift // return undef;
open( my $fh, '<', $path ) or return undef;
my $line = readline($fh);
close($fh);
return undef if not defined $line;
chomp $line;
return $line;

