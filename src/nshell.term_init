## [:< ##

# name = nshell.term_init
# descr = Initialize terminal for nshell
#         using Linux::Termios2 [ Linux-native, no XS build issues ]

## modules laoded in bin/Protocol-7 [ Fcntl ]
###                       base.init [ POSIX ]
####          and  nshell.init_code [ Linux::Termios2 ]
##  [ use SOMECONSTANT() version instead of barewords ]

## Get current terminal file descriptor
my $tty_fd = fileno(STDIN);
return FALSE if not defined $tty_fd or $tty_fd < 0;

## Set STDIN to non-blocking mode so sysread doesn't freeze the event loop
my $flags = fcntl( \*STDIN, F_GETFL, 0 );
fcntl( \*STDIN, F_SETFL, $flags | O_NONBLOCK ) or return 0;

## Create Termios object and get current settings  [ Linux::Termios2
## API-compatible with POSIX::Termios ]
my $orig_termios = Linux::Termios2->new();
$orig_termios->getattr($tty_fd) or return 0;

## Save to main data for restoration in nshell.term_restore
$main::data{'nshell'}{'orig_termios'} = $orig_termios;
$main::data{'nshell'}{'tty_fd'}       = $tty_fd;

## Create working copy for modifications
my $modified_termios = Linux::Termios2->new();
$modified_termios->getattr($tty_fd);

## Disable canonical mode and echo: enter raw input mode  ISIG = interrupt
## signals,  ECHO = echo input, ICANON = canonical input
my $orig_flags = $orig_termios->getlflag();
my $new_flags  = $orig_flags & ~( ISIG() | ECHO() | ICANON() );
$modified_termios->setlflag($new_flags);

## Apply modified settings immediately

## [ Linux::Termios2 doesn't expose setcc, control character  defaults are
## sufficient for sysread ]
$modified_termios->setattr( $tty_fd, TCSAFLUSH() );

## best-effort : ask the terminal to report modified special keys [ Shift+
## Escape for redo, see plugin.nshell.coding-session.on_redo ] unambiguously
## instead of the plain bare-Escape byte every terminal sends by default for
## every Escape combination, modified or not. two independent asks since we
## can't detect terminal support in advance -- private CSI sequences an
## unsupporting terminal doesn't recognize are simply ignored, never an error,
## so sending both is safe:
## - Kitty keyboard protocol [ CSI > 1 u, flag 1 = "disambiguate escape codes"
## ] : Shift+Escape then reports as \e[27;2u. supported by
## kitty/wezterm/foot/ghostty and recent xterm builds.
## - xterm modifyOtherKeys mode 1 [ CSI > 4 ; 1 m ] : gentler than mode 2,
## only affects otherwise-ambiguous combinations, leaves plain typing alone.
## exact reported form varies by xterm version -- F1 [ \eOP / \e[11~, always
## unambiguous ] is the reliable primary redo binding regardless of whether
## either negotiation below actually lands.
print "\e[>1u\e[>4;1m";
STDOUT->flush();

return TRUE;

