## [:< ##

# name  = radio.cmd.stop
# descr = close all listener streams and disconnect TCP socket

##  close listener streams  ##

my $stop_count = scalar <radio.listeners>->@*;
if ( $stop_count > 0 ) {
    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );
    <[base.buffer.add_line]>->(
        qw| radio-stream |,
        join( ' ', $time_stamp, 2, 'listener removed :. 0' ), 2
    );
}

for my $h ( <radio.listeners>->@* ) {
    <[base.stream.close]>->($h);
}
<radio.listeners> = [];

##  cancel IO watcher  ##

if ( defined <radio.stream.io_watcher> ) {
    <radio.stream.io_watcher>->cancel;
    delete <radio.stream.io_watcher>;
}

##  close socket  ##

if ( defined <radio.stream.sock> ) {
    close( delete <radio.stream.sock> );
}

##  reset icy state  ##

my $icy = <radio.stream.icy>;
$icy->{'headers_done'}  = 0;
$icy->{'header_buf'}    = '';
$icy->{'meta_expected'} = 0;
$icy->{'meta_buf'}      = '';

return { 'mode' => qw| true |, 'data' => 'stopped' };

