# name = data.topology.interference.map.min_distance_to_center
# descr = Topology calculation subroutine

my $coord = shift;
my ( $x, $y, $z ) = @$coord;

# Distance to center (6, 6, 6)
my $dx = abs( $x - 6 );
my $dy = abs( $y - 6 );
my $dz = abs( $z - 6 );

return ( $dx + $dy + $dz ) / 3;    # Normalized 0-6

