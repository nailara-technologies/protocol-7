## [:< ##

# name  = base.waitpid

my $wait_PID   = shift // 0;
my $wait_FLAGS = shift // WNOHANG();

my $pid_result = waitpid( $wait_PID, $wait_FLAGS );

## keep the status of a child reaped here [ base.sig_chld reaps with -1 ] : ##
## its owner [ stream_child.reap ] finds the pid gone and takes it from     ##
## here -- without it the exit status was lost, every clean eof of an       ##
## events remote pull logged as a failure. kept small : the oldest drop     ##
if ( $pid_result > 0 ) {
    my $collected = <base.process.exit_status> //= {};
    $collected->{$pid_result} = $CHILD_ERROR;
    if ( keys %{$collected} > 89 ) {
        my @oldest = ( sort { $a <=> $b } keys %{$collected} )[ 0 .. 33 ];
        delete @{$collected}{@oldest};
    }
}

if ( <system.zenka.name> eq qw| v7-zenki | and $pid_result > 0 )
{    ## has terminated ##
    my $registry_handler = qw| v7-zenki.report_collected_child_pid |;
    $code{$registry_handler}->($pid_result);    ##  register for sig_chld  ##
}

return $pid_result;

