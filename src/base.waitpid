## [:< ##

# name  = base.waitpid

my $wait_PID   = shift // 0;
my $wait_FLAGS = shift // WNOHANG();

my $pid_result = waitpid( $wait_PID, $wait_FLAGS );

if ( <system.zenka.name> eq qw| v7-zenki | and $pid_result > 0 )
{    ## has terminated ##
    my $registry_handler = qw| v7-zenki.report_collected_child_pid |;
    $code{$registry_handler}->($pid_result);    ##  register for sig_chld  ##
}

return $pid_result;

