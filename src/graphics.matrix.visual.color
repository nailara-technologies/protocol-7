## [:< ##

# name  = graphics.matrix.visual.color
# descr = Color utility functions for visual similarity calculations

## color_distance - Calculate Euclidean distance between two RGB colors ##
my $rgb1 = shift // return undef;
my $rgb2 = shift // return undef;

return
    sqrt( ( $rgb1->[0] - $rgb2->[0] )**2
        + ( $rgb1->[1] - $rgb2->[1] )**2
        + ( $rgb1->[2] - $rgb2->[2] )**2 );

