## [:< ##

# name  = keys.console.certify-host
# param = <owner> <host> <root> [days] [:pass-env:]
# descr = owner root certifies a host-root [ scope '<host>.*' ]
# note  = <owner> owner key name [ any key form ] , <host> the host's
#         node name [ scope '<host>.*' ] , <root> the host-root public
#         key [ 52 chars ] or the host's .dlg file , [days] default 365 ;
#         writes ./<host>.host-root.dlg -- on the host : p7-keys
#         accept-owner <file> [ as the backend user ] ; :pass-env: the
#         owner key's passphrase \ seed phrase from PROTOCOL_7_KEY_PASSPHRASE
#         [ read once, deleted from the environment -- for scripts ]

## data/md/design/TRUST-CHAIN-STEP2.md [ 'the owner root' ] : the owner key ##
## may be in ANY form the keys zenka holds [ load_keypair prompts,          ##
## decrypts, derives ] -- plain and passphrase-derived forms are WARNED     ##
## about, never refused. 365 days unless given. the host-root public key    ##
## comes from the host's .dlg [ the leaf's issuer ] or out of band ; its    ##
## key id is shown for the out of band comparison.                          ##

## ':pass-env:' : the owner key's passphrase from the environment ##
my ( $params, $env ) = <[keys.passphrase_from_env]>->(
    shift // '',
    { qw| vars | => [qw| PROTOCOL_7_KEY_PASSPHRASE |] }
);
if ( not defined $params ) {
    printf "\n  << %s >>\n\n", $env;
    <[base.exit]>->(qw| 0010 |);
}
## ':expect=<key id>:' : the owner key id this phrase must produce ##
my ($expect_id) = $params =~ m{(?:\A|\s):expect=([A-Z2-7]{77}):(?=\s|\z)};
$params =~ s{(?:\A|\s):expect=[A-Z2-7]{77}:(?=\s|\z)}{ }g;
my ( $owner, $host, $root_arg, $days ) = grep {length} split m|[\t ]+|,
    $params;

if ( not defined $root_arg or not length $root_arg ) {
    say "\n  << expected '<owner key> <host> <host-root "
        . "public key | .dlg file> [ days ]' >>\n";
    <[base.exit]>->(qw| 0010 |);
}

## the name v7-zenki delegates is '<system.node.name lowercased>.cube' ##
$host = lc( $host // '' );

## the host-root public key : a .dlg file [ leaf issuer ] or b32 ##
my $root_pub;
if ( -f $root_arg ) {
    my $content = '';
    if ( open( my $fh, '<:raw', $root_arg ) ) {
        read( $fh, $content, 12288 );
        close($fh);
    }
    my ( $chain, $why ) = <[trust.chain]>->( qw| file |, $content );
    my $leaf
        = defined $chain
        ? <[trust.statement]>->( qw| parse_wire |, $chain->[-1] )
        : undef;
    if ( ref $leaf ne qw| HASH | ) {
        printf "\n  << '%s' is not a delegation file [ %s ] >>\n\n",
            $root_arg, $why // 'leaf not valid';
        <[base.exit]>->(qw| 0010 |);
    }
    $root_pub = $leaf->{'issuer_pub'};
} elsif ( $root_arg =~ m|\A[A-Z2-7]{52}\z| ) {
    $root_pub = eval { Crypt::Misc::decode_b32r($root_arg) };
}
if ( not defined $root_pub or length($root_pub) != 32 ) {
    say "\n  << host-root : expected a 52 "
        . "char public key or a .dlg file >>\n";
    <[base.exit]>->(qw| 0010 |);
}

## absolute : the keys zenka keeps the caller's cwd [ no drop_privs ], the ##
## path is printed so the file is found either way                         ##
my $out_file = File::Spec->rel2abs( sprintf qw| %s.host-root.dlg |, $host );
if ( -e $out_file or -l $out_file ) {
    printf "\n  << '%s' exists -- move it away first >>\n\n", $out_file;
    <[base.exit]>->(qw| 0010 |);
}

## no explicit expectation : an owner pin named like the key [ owners/ ] ##
## gives it -- a virtual \ derived key cannot detect a wrong phrase      ##
## otherwise                                                             ##
my $expect_from = defined $expect_id ? qw| tag | : undef;
if ( not defined $expect_id and defined $owner ) {
    my $owners = <[keystore.remote_keys_dir]>->( qw| owners |, FALSE );
    my $pin    = defined $owners ? catfile( $owners, "$owner.public" ) : '';
    if (    length $pin
        and -f $pin
        and not -l $pin
        and open( my $fh, '<', $pin ) ) {
        my $line = readline($fh) // '';
        close($fh);
        $line =~ s{\s+\z}{};
        ( $expect_id, $expect_from ) = ( $line, qw| owner pin | )
            if $line =~ m|\A[A-Z2-7]{77}\z|;
    }
}

## validate, warn [ before any passphrase prompt ], load, sign, unload : ##
## keys.certify_host -- the same core host-edit's certify action uses    ##
my ( $certified, $exit_code, $reason ) = <[keys.certify_host]>->(
    {   qw| owner |      => $owner,
        qw| host |       => $host,
        qw| root_pub |   => $root_pub,
        qw| days |       => $days,
        qw| passphrase | => $env->{'PROTOCOL_7_KEY_PASSPHRASE'},
        qw| expect_id |  => $expect_id,
        qw| on_warning | => sub {
            say " :\n :: << WARNING : " . shift() . ' >>';
        },
    }
);
if ( defined $certified and not defined $expect_id ) {
    say " :\n :: << NOTE : no expected key id [ no owner pin '"
        . ( $owner // '' )
        . "', no :expect=..: ] --\n :.    a virtual or "
        . "passphrase-derived key cannot tell a wrong phrase >>";
}
if ( not defined $certified ) {
    printf "\n  << %s >>\n\n", $reason;
    <[base.exit]>->($exit_code);
}
my ( $wire, $owner_pub ) = @{$certified}{qw| wire owner_pub |};
$days //= 365;

require Fcntl;
my $fh;
if (not sysopen(
        $fh,
        $out_file,
        Fcntl::O_WRONLY() | Fcntl::O_CREAT() | Fcntl::O_EXCL()
            | Fcntl::O_NOFOLLOW(),
        0644
    )
    or not chmod( 0644, $fh )    ## public : not narrowed by the umask ##
    or not print {$fh} "$wire\n" or not close($fh)
) {
    printf "\n  << cannot write '%s' [ %s ] >>\n\n", $out_file,
        <[base.str.os_err]>;
    <[base.exit]>->(qw| 0110 |);
}

my $halves = sub {
    my $fp   = shift;
    my $half = int( ( length($fp) + 1 ) / 2 );
    return ( substr( $fp, 0, $half ), substr( $fp, $half ) );
};
printf " :\n :: certified host-root of '%s' [ scope %s.* , %d days ]\n",
    $host, $host, $days;
printf " :. host-root %s\n :.           %s\n",
    $halves->( <[trust.key_id]>->($root_pub) );
printf " :. owner     %s\n :.           %s\n",
    $halves->( <[trust.key_id]>->($owner_pub) );
printf " :\n :. written   %s\n :\n", $out_file;
say " :. compare the host-root key id out of band [ on the host :";
say " :.   p7c host-root-id ]";
say " :. copy it to the host ; there, as the backend user :";
say " :.   p7-keys accept-owner <file>";
say " :. on clients : p7-keys owner-pin <name> <owner key id> ::\n";

