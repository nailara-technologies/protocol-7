#\\\|OITAMCKXQGLAN66JHTCJHNLC5C6SWZ3J3PDVGSLL3XPBQU2LWWH \ / AMOS7 \ YOURUM ::
#\[7]KCQ7UWNMEOOWFNLLR636BHSYG2WNW7PBAI72TQSY2MXY3V7WZYDQ 7  DATA SIGNATURE ::
