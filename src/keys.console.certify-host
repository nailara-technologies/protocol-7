#H4XKGWY6MHQFWRQPOI3ESRIQ35MZ4Z35RXAZKMM4UXR4MA4DJIEMLMSGVZNNXYP52XWSHUU4QVKS2
#\\\|OMSWGYLE42ZI2F5F53ODAZWNDJIJNWWLF3ES4RPFXT777VB23QP \ / AMOS7 \ YOURUM ::
#\[7]L22AH23TSJVS52R4JRWV7UIMHIUH4SQ5F4SCLKA7ZAALJ4LZSACA 7  DATA SIGNATURE ::
