#\\\|AP5FOB5LRUNBI5XEALDX2S22SK3UMPVUYF5QUDNGJYIVDPIDOIX \ / AMOS7 \ YOURUM ::
#\[7]2ODMNI3IUSAPLQ24VSIERW2RCI57RVC6HOZEH4QFKKDCWWWZGOCI 7  DATA SIGNATURE ::
