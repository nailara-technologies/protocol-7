## [:< ##
# name  = plan-9.server.client.close
# descr = Handle 9P client disconnection

my ($fd) = @ARG;

my $client = delete $data{'plan-9'}{'server'}{'clients'}{$fd};
return unless $client;

## cancel the read watcher before closing the socket -- mirrors ##
## proxy.client.close                                           ##
if ( defined $client->{'watcher'} ) {
    $client->{'watcher'}->cancel if $client->{'watcher'}->is_active;
}
$client->{'sock'}->close if defined $client->{'sock'};

<[base.logs]>->("9P client disconnected (fd=$fd)");

