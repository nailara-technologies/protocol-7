## [:< ##

# name  = pager.export.binary
# descr = Export pager buffer to binary format for external viewers

my ($args) = @ARG;

my $buffer_id = $args->{'buffer_id'};
my $buf       = $data{'pager'}{'buffers'}{$buffer_id};
return undef unless $buf;

my $output = $args->{'output'};    # File path or return scalar ref
my $format = $args->{'format'} // '56-bit';   # 56-bit | 72-bit | 64-bit | L13
my $start  = $args->{'start'}  // 0;
my $count  = $args->{'count'}  // $buf->{'pages'}{'size'};

my $page_size  = $buf->{'pages'}{'size'};
my $start_page = int( $start / $page_size );
my $end_page   = int( ( $start + $count - 1 ) / $page_size );

# Gather items
my @items;
for my $page_num ( $start_page .. $end_page ) {
    my $page = <[pager.buffer.page.get]>->( $buf, $page_num );
    push @items, @$page if $page;
}

# Extract visible slice
my $offset = $start - ( $start_page * $page_size );
if ( $offset < 0 || $offset > $#items ) {
    @items = ();
} else {
    my $end_offset = $offset + $count - 1;
    $end_offset = $#items if $end_offset > $#items;
    @items      = @items[ $offset .. $end_offset ];
}

# Determine byte width based on format
my $byte_width = {
    '56-bit' => 7,
    '72-bit' => 9,
    '64-bit' => 8,
    'L13'    => 7,
}->{$format} // 7;

# Build binary output
my $binary = '';

for my $item (@items) {
    my $bin;

    if ( $item->{'checksum'} ) {

        # Decode checksum to binary
        my $algo = $item->{'algorithm'} // 'bmw';

        if ( $algo =~ /bmw-L13/i || $format eq 'L13' ) {
            $bin = <[base32.decode]>->( $item->{'checksum'} );
        } else {
            $bin = <[base32.decode]>->( $item->{'checksum'} );
        }
    } elsif ( $item->{'path'} ) {

        # Hash path to binary
        $bin = <[base32.decode]>
            ->( <[chk-sum.bmw.L13-str]>->( $item->{'path'} ) );
    } else {

        # Default to item fingerprint
        my $data = join( '', map { $item->{$ARG} // '' } sort keys %$item );
        $bin = <[base32.decode]>->( <[chk-sum.bmw.L13-str]>->($data) );
    }

    # Pad/truncate to exact width
    $bin = substr( $bin . "\0" x $byte_width, 0, $byte_width );
    $binary .= $bin;
}

# Output
if ($output) {
    open( my $fh, '>:raw', $output ) or return undef;
    print $fh $binary;
    close($fh);
    return length($binary);
} else {
    return \$binary;
}

