## [:< ##

# name  = task.claim_lease
# descr = the claim lease in seconds : a claim not renewed
#         [ task.touch ] within it expires. one value for the
#         task zenka and its workers -- claim and touch replies
#         carry it [ task.cfg.claim_lease, default 600 ]

my $lease = <task.cfg.claim_lease> // 600;
$lease = 600 if $lease !~ m|^\d+$| or $lease < 60;

return $lease;

