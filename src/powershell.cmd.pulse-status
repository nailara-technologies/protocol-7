## [:< ##

# name  = powershell.cmd.pulse-status
# descr = host pulseaudio process and tcp 4713 reachability

my $status = <[powershell.pulse-status]>;

return { 'mode' => qw| false |, 'data' => 'pulse-status failed' }
    if not defined $status;

return { 'mode' => qw| false |, 'data' => $status->{'error'} }
    if defined $status->{'error'};

my $proc_str
    = $status->{'running'}
    ? sprintf( 'running [ pid %s ]', join( ', ', $status->{'pids'}->@* ) )
    : 'not running';
my $tcp_str = $status->{'tcp'} ? 'reachable' : 'unreachable';

return {
    'mode' => $status->{'running'} && $status->{'tcp'}
    ? qw| true |
    : qw| false |,
    'data' => sprintf(
        "process : %s ; tcp %s:4713 : %s",
        $proc_str, $status->{'host_ip'}, $tcp_str
    ),
};

