## [:< ##
# name  = plan-9.server.handle_walk
# descr = Handle 9P Twalk/Rwalk

my ( $client, $tag, $data ) = @ARG;

my $fid = <[plan-9.protocol.codec.decode-uint32]>->( substr( $data, 0, 4 ) );
my $newfid
    = <[plan-9.protocol.codec.decode-uint32]>->( substr( $data, 4, 4 ) );
my $nwname
    = <[plan-9.protocol.codec.decode-uint16]>->( substr( $data, 8, 2 ) );

my $rest = substr( $data, 10 );
my @wnames;
for ( 1 .. $nwname ) {
    my ( $name, $r ) = <[plan-9.protocol.codec.decode-string]>->($rest);
    push @wnames, $name;
    $rest = $r;
}

my $current = $client->{fids}{$fid};

return <[plan-9.protocol.error]>->( $tag, "invalid fid" ) unless $current;

my @qids;
my $walk_result = $current;

foreach my $name (@wnames) {
    if ( $walk_result->{type} eq 'root' ) {

        # Walking from root - look up exported buffer or directory
        my $buf = $data{'plan-9'}{'server'}{'buffers'}{$name};
        return <[plan-9.protocol.error]>->( $tag, "file not found" )
            unless $buf;

        if ( ( $buf->{'kind'} // 'buffer' ) eq 'directory' ) {
            $walk_result = {
                type           => 'realpath',
                realpath       => $buf->{'realpath'},
                root           => $buf->{'root'}     // $buf->{'realpath'},
                writable       => $buf->{'writable'} // 0,
                symlink_policy => $buf->{'symlink_policy'} // 'reject',
                qid            => {
                    type    => <plan-9.protocol.constants.QTDIR>,
                    version => $buf->{qid_version},
                    path    => $buf->{qid_path}
                },
            };
        } else {
            $walk_result = {
                type => 'buffer',
                name => $name,
                qid  => {
                    type    => <plan-9.protocol.constants.QTDIR>,
                    version => $buf->{qid_version},
                    path    => $buf->{qid_path}
                },
            };
        }
        push @qids, $walk_result->{qid};

    } elsif ( $walk_result->{type} eq 'realpath' ) {

        # Walking inside a real exported directory tree -- a wname must be
        # a single path component, never a traversal/escape attempt
        return <[plan-9.protocol.error]>->( $tag, "invalid path component" )
            if $name eq ''
            or $name eq '.'
            or $name eq '..'
            or $name =~ m{/};

        my $child = $walk_result->{realpath} . '/' . $name;

        ## a symlink component is a per-export policy decision -- 'reject' ##
        ## (default) blocks it outright, 'contained' allows it only if the ##
        ## resolved target still lives under the export root, 'allow' does ##
        ## no check. checked with -l (doesn't follow the link) so a        ##
        ## rejected/broken symlink is caught before -e/-d ever follow it.  ##
        if ( -l $child ) {
            my $policy = $walk_result->{'symlink_policy'} // 'reject';
            if ( $policy eq 'reject' ) {
                return <[plan-9.protocol.error]>->(
                    $tag, "symlink access denied by export policy"
                );
            } elsif ( $policy eq 'contained' ) {
                my $resolved = Cwd::abs_path($child);
                my $root     = $walk_result->{'root'};
                return <[plan-9.protocol.error]>->(
                    $tag, "symlink escapes exported root"
                    )
                    unless defined $resolved
                    and $root
                    and ( $resolved eq $root
                    or index( $resolved, "$root/" ) == 0 );
            }

            # 'allow' falls through with no check
        }

        return <[plan-9.protocol.error]>->( $tag, "file not found" )
            unless -e $child;

        my $is_dir = -d $child;
        $data{'plan-9'}{'server'}{'realpath_qids'}{$child}
            //= $data{'plan-9'}{'server'}{'next_qid'}++;

        $walk_result = {
            type           => 'realpath',
            realpath       => $child,
            root           => $walk_result->{'root'},
            writable       => $walk_result->{'writable'},
            symlink_policy => $walk_result->{'symlink_policy'},
            qid            => {
                type => $is_dir
                ? <plan-9.protocol.constants.QTDIR>
                : <plan-9.protocol.constants.QTFILE>,
                version => 0,
                path    => $data{'plan-9'}{'server'}{'realpath_qids'}{$child},
            },
        };
        push @qids, $walk_result->{qid};

    } elsif ( $walk_result->{type} eq 'buffer' ) {

        # Walking in buffer directory
        my $buf
            = $data{'plan-9'}{'server'}{'buffers'}{ $walk_result->{name} };

        if ( $name =~ /^z-(\d+)$/ ) {
            my $z = $1;
            return <[plan-9.protocol.error]>->( $tag, "invalid layer" )
                unless $z >= 0 && $z <= 12;

            $walk_result = {
                type   => 'layer',
                buffer => $walk_result->{name},
                z      => $z,
                qid    => {
                    type    => <plan-9.protocol.constants.QTFILE>,
                    version => 0,
                    path    => $buf->{qid_path} + $z + 1,
                },
            };
            push @qids, $walk_result->{qid};

        } elsif ( $name eq 'metadata' ) {
            $walk_result = {
                type   => 'metadata',
                buffer => $walk_result->{name},
                qid    => {
                    type    => <plan-9.protocol.constants.QTFILE>,
                    version => 0,
                    path    => $buf->{qid_path} + 100,
                },
            };
            push @qids, $walk_result->{qid};

        } else {
            return <[plan-9.protocol.error]>->( $tag, "file not found" );
        }
    } else {
        return <[plan-9.protocol.error]>->( $tag, "not a directory" );
    }
}

# Clone to newfid
$client->{fids}{$newfid} = $walk_result;

# Encode response
my $resp = <[plan-9.protocol.codec.encode-uint16]>->( scalar @qids );
foreach my $qid (@qids) {
    $resp .= <[plan-9.protocol.codec.encode-qid]>->(
        $qid->{type}, $qid->{version}, $qid->{path}
    );
}

return <[plan-9.protocol.codec.encode-message]>->(
    <plan-9.protocol.constants.Rwalk>,
    $tag, $resp
);

