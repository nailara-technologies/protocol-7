## [:< ##

# name  = fetch.file.huggingface.handler.download_response
# descr = streaming download completion callback : follow redirects,
#         then feed the existing hash_state / status state machine
#         [ drop-in replacement for the old wget-child waitpid role ]

my $data   = shift;
my $params = $data->{'params'}  // {};
my $dl_id  = $params->{'dl_id'} // '';

my $dl = <fetch.file.downloads>->{$dl_id};
return if !defined $dl;

my $status   = $data->{'status'}  // 0;
my $headers  = $data->{'headers'} // {};
my $ok       = $data->{'ok'};
my $reply_id = $dl->{'reply_id'} // '';
my $dest     = $dl->{'dest'};

## redirect handling : huggingface.co /<repo>/resolve/... answers 302 to ##
## the CDN carrying the real bytes -- the wget/aria2c children followed  ##
## these transparently, so the native transport must too. same tracking  ##
## entry, fresh request [ a resumed download keeps its range header and  ##
## appends on every hop, see huggingface.start_download ]                ##
if (    $status >= 300
    and $status < 400
    and length( $headers->{'location'} // '' ) ) {
    my $max_redirects = 5;
    if ( ( $dl->{'redirects'} // 0 ) < $max_redirects ) {
        my $location = $headers->{'location'};

        ## scheme-relative location ##
        $location = "https:$location" if $location =~ m{\A //}x;

        ## path-relative location : resolve against the previous url ##
        if ( $location !~ m{\A https?:// }x ) {
            my $base = $dl->{'url'} // '';
            $location = ( $base =~ m{\A (https?://[^/]+) }x )[0] . $location;
        }

        $dl->{'url'} = $location;
        $dl->{'redirects'}++;

        <[base.logs]>->(
            1,                  "[hf.fetch] following redirect #%d -> %s",
            $dl->{'redirects'}, $location
        );

        ## note : progress timer stays running across hops                 ##
        ## [ status remains 'downloading' ], only the final response below ##
        ## cancels it                                                      ##
        <[huggingface.start_download]>->($dl_id);
        return;
    }

    <[base.logs]>->(
        0,
        "[hf.fetch] too many redirects [%d] for %s",
        $dl->{'redirects'} // 0,
        $dl->{'url'}       // ''
    );
}

## transfer error [ cdn http/2 stream reset, stall timeout, 5xx ] : keep  ##
## the partial and resume it with a range request, from the original      ##
## resolve url [ a freshly signed cdn redirect ]. a reset used to throw   ##
## away a multi-GB partial [ 2026-10-09 : fable5 q4_k_m at 1.4 GB ].  a   ##
## definite client error [ 4xx but 408 / 429 ] is not retried. the sha256 ##
## verify still covers the whole file afterwards  the partial against the ##
## published size                                                         ##
## [ lfs size from the hash fetch, else a 416's content-range total ]     ##
my $partial  = -f $dest ? ( -s $dest ) : 0;
my $expected = $dl->{'expected_size'} // 0;
$expected = $1
    if !$expected
    and ( $headers->{'content-range'} // '' ) =~ m{ / \s* (\d+) \s* \z}x;

## 416 on a resumed request with every byte already on disk              ##
## [ the reset came after the last byte ] : complete, go verify -- never ##
## delete it                                                             ##
if (    $status == 416
    and ( $dl->{'resume_from'} // 0 ) > 0
    and $expected > 0
    and $partial == $expected ) {
    ( $ok, $status ) = ( TRUE, 206 );
}

## a 2xx that ended short of the published size : the connection closed  ##
## early -- a transfer error to resume, not a file for the size check to ##
## reject and delete                                                     ##
if ( $ok and $expected > 0 and $partial < $expected ) {
    $ok = FALSE;
    $data->{'error'} //= sprintf 'transfer ended short [ %d of %d bytes ]',
        $partial, $expected;
}

my $retryable = (
            not $ok
        and not( $status >= 300 and $status < 400 )
        and not( $status >= 400
        and $status < 500
        and $status != 408
        and $status != 429 )
) ? TRUE : FALSE;
my $max_retries = <fetch.file.cfg.download_retries> // 8;

## the limit counts consecutive attempts without progress : a long file on ##
## a cdn that resets every ~25 minutes must not run out of retries         ##
$dl->{'retries'} = 0 if $partial > ( $dl->{'resume_from'} // 0 );

if ( $retryable and ( $dl->{'retries'} // 0 ) < $max_retries ) {
    $dl->{'retries'}++;
    $dl->{'resume_from'} = $partial;
    $dl->{'url'}         = $dl->{'origin_url'} // $dl->{'url'};
    $dl->{'redirects'}   = 0;

    my $wait = 10 * $dl->{'retries'};
    <[base.logs]>->(
        0,
        "[hf.fetch] transfer error [%s] : retry "
            . "%d/%d in %ds, resuming %s at %.2f GB",
        ( $data->{'error'} // "http status $status" ),
        $dl->{'retries'},
        $max_retries,
        $wait,
        $dl->{'file'} // $dest,
        $dl->{'resume_from'} / ( 1024**3 )
    );

    ## status stays 'downloading' : idle-shutdown stays paused, the ##
    ## progress timer keeps running across the retry                ##
    <[event.add_timer]>->(
        {   'after'   => $wait,
            'handler' => qw| huggingface.handler.retry_download |,
            'data'    => { 'dl_id' => $dl_id },
        }
    );
    return;
}

## cancel the progress log timer -- final response reached ##
my $timer = delete $dl->{'timer'};
$timer->cancel if defined $timer;

if ( not $ok ) {
    $dl->{'status'} = qw| error |;
    unlink($dest) if -f $dest;

    <[base.logs]>->(
        0, "[hf.fetch] download failed: %s [%s]",
        $dest, ( $data->{'error'} // "http status $status" )
    );

    if ( length $reply_id ) {
        <[base.callback.cmd_reply]>->(
            $reply_id,
            {   'mode' => qw| false |,
                'data' => sprintf( 'download failed: %s',
                    ( $data->{'error'} // "http status $status" ) )
            }
        );
    }

    ## resume idle-shutdown tracking, paired with the pause in            ##
    ## fetch.file.huggingface.download -- only once EVERY tracked flow is ##
    ## terminal [ see fetch.file.huggingface.resume_idle ]                ##
    <[huggingface.resume_idle]>->();
    return;
}

## success : bytes are on disk -- now feed the SAME verification state     ##
## machine the wget-child path used                                        ##
## [ hash_state pending -> ok | failed | non-lfs ], so download_progress's ##
## hash_state branching consumers [ huggingface.verify.* ] keep working    ##
## unchanged  the file, not the stream count : a resumed transfer wrote    ##
## only its tail                                                           ##
my $size = -f $dest ? ( -s $dest ) : ( $data->{'size'} // 0 );
$dl->{'downloaded'} = $size;

my $now     = <[base.time]>->(3);
my $elapsed = $now - ( $dl->{'start_time'} // $now );
$dl->{'speed'} = sprintf( '%.2f',
    ( $elapsed > 0 ? ( $size / $elapsed ) : 0 ) / ( 1024**2 ) );

my $succeeded = -f $dest;

my $hash_state = $dl->{'hash_state'} // qw| pending |;

if ( $succeeded and $hash_state eq qw| ok | ) {
    ## expected sha256 already in hand -> fork the verify child.  reply is  ##
    ## sent by huggingface.handler.verify_progress once the hash comparison ##
    ## lands. idle-shutdown stays paused for the verify child, resumed by   ##
    ## the verify path.                                                     ##
    $dl->{'status'} = qw| verifying |;
    <[huggingface.verify.start]>->($dl_id);
    return;
} elsif ( $succeeded and $hash_state eq qw| failed | ) {
    ## the expected hash genuinely could not be obtained -- this is NOT "no ##
    ## verification needed". NEVER fall through to a bare transfer-ok       ##
    ## success path : that is the exact silent-acceptance hole the          ##
    ## verification layer exists to close                                   ##
    $dl->{'status'} = qw| unverified |;
    <[base.logs]>->(
        0,
        "[hf.fetch] UNVERIFIED: %s -- expected sha256 could not "
            . "be fetched after %d attempt(s); NOT marking complete",
        $dest,
        $dl->{'hash_attempts'} // 0
    );
    if ( length $reply_id ) {
        <[base.callback.cmd_reply]>->(
            $reply_id,
            {   'mode' => qw| false |,
                'data' => "download UNVERIFIED: expected sha256 unavailable "
                    . "after retries -- not marked complete"
            }
        );
    }
    <[huggingface.resume_idle]>->();
    return;
} elsif ( $succeeded and $hash_state eq qw| non-lfs | ) {
    ## small non-LFS file : no published sha256 exists                      ##
    ## [ git blob SHA1 scheme deliberately out of scope ] -> complete, with ##
    ## the skipped verification explicitly noted in the log                 ##
    my $size_gb = ( -s $dest ) / ( 1024**3 );
    $dl->{'status'} = qw| complete |;
    $dl->{'total'}  = $size_gb;
    <[base.logs]>->(
        1,
        "[hf.fetch] download complete [non-LFS, "
            . "sha skipped]: %s (%.2f GB, %d sec)",
        $dest,
        $size_gb,
        int($elapsed)
    );
    if ( length $reply_id ) {
        <[base.callback.cmd_reply]>->(
            $reply_id,
            {   'mode' => qw| true |,
                'data' => sprintf(
                    "ok path=%s size_gb=%.2f duration=%d "
                        . "note=non-lfs sha256-skipped",
                    $dest, $size_gb, int($elapsed)
                )
            }
        );
    }
    <[huggingface.resume_idle]>->();
    return;
} elsif ($succeeded) {
    ## hash fetch still in flight -> park in awaiting-hash;          ##
    ## huggingface.handler.blob_hash_response continues the flow     ##
    ## [ verify.start / unverified / non-lfs complete ] when the API ##
    ## response lands. idle-shutdown stays paused meanwhile.         ##
    $dl->{'status'} = qw| awaiting-hash |;
    <[base.logs]>->(
        1,
        "[hf.fetch] %s downloaded -- awaiting "
            . "expected sha256 before verification",
        $dl->{'file'}
    );
    return;
} else {
    ## transfer succeeded at http level but no file on disk : treat as ##
    ## failure, same cleanup as the error path above                   ##
    $dl->{'status'} = qw| error |;
    <[base.logs]>->(
        0, "[hf.fetch] download failed: %s [no file after transfer]", $dest
    );
    if ( length $reply_id ) {
        <[base.callback.cmd_reply]>->(
            $reply_id,
            {   'mode' => qw| false |,
                'data' => 'download failed: no file after transfer'
            }
        );
    }
    <[huggingface.resume_idle]>->();
    return;
}

