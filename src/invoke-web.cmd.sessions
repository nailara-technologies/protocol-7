## [:< ##

# name  = invoke-web.cmd.sessions
# descr = list the parked render sessions

my $sessions = <[invoke-web.session.store]>;

return { mode => qw| false |, data => 'no parked sessions' }
    if not keys %$sessions;

## how many of each session's items are still pending ##
my $dbh     = <[invoke-web.queue.db]>;
my %pending = ();
if ( defined $dbh ) {
    my $rows = $dbh->selectcol_arrayref(
        "SELECT item_id FROM session_queue WHERE status = 'pending'") // [];
    %pending = map { $ARG => 1 } @$rows;
}

my $now = <[base.time]>->(0);
my $out = '';
foreach my $name ( sort keys %$sessions ) {
    my $session = $sessions->{$name};
    my @items   = keys $session->{'items'}->%*;
    $out .= sprintf "%-24s %4d of %4d pending  "
        . "resume : %-6s  parked %dm ago\n",
        $name, scalar( grep { $pending{$ARG} } @items ), scalar @items,
        $session->{'mode'} // 'manual',
        ( $now - ( $session->{'parked_at'} // $now ) ) / 60;
}

return { mode => qw| size |, data => $out };

