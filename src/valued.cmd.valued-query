## [:< ##

# name  = valued.cmd.valued-query
# param = [n] [parent=<id>] [type=<type>]
# descr = query top-N valued tree nodes [ parent + type filter ]

my ( $n, $parent, $type ) = ( 10, '', '' );

## parse params: hash path first, positional args fallback ##
if ( defined $call->{'param'} and ref $call->{'param'} eq 'HASH' ) {
    $n      = $call->{'param'}->{'n'}      // 10;
    $parent = $call->{'param'}->{'parent'} // '';
    $type   = $call->{'param'}->{'type'}   // '';
} elsif ( length( $call->{'args'} // '' ) ) {
    my ($first) = split m|\s+|, $call->{'args'};
    $n = $first if defined $first && $first =~ m|^\d+$|;
}

## clamp n to valid range ##
$n = int $n;
$n = 1   if $n < 1;
$n = 100 if $n > 100;

return
    <[valued.tree.top_n]>
    ->( { 'n' => $n, 'parent' => $parent, 'type' => $type } );

