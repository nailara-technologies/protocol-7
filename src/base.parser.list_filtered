## [:< ##

# name  = base.parser.list_filtered
# descr = returns parsed list table with opt. regex filtering on keys|values
#
# This module extends base.parser.list with a 'filter' parameter that allows
# searching across both hash keys AND field values.
#
# FILTER BEHAVIOR:
#   - When filter is provided, only entries matching the regex are included
#   - Matching checks: hash key OR any visible field value
#   - Field names are extracted from mask
#             [ e.g.: 'user:uname' -> checks $data{user} ]
#
# USAGE VIA base.cmd.list:
#  list <name> <pattern> -> uses this filtered parser
#  list sessions cube    -> shows sessions where 'cube' appears
#                                            in ID or any field
#
# MASK FORMAT:
#   Same as base.parser.list:
#   - '<key>:display'  -> shows hash key with header 'display'
#   - 'field:display'  -> shows $data{field} with header 'display'
#   - 'field'          -> shows $data{field} with header 'field'
#
# RELATED: base.parser.list (unfiltered version)

(   my $h_name,
    my $h_key,
    my $sub_key,
    my $display_keys,
    my $align,
    my $defaults,
    my $filters,
    my $sort_key,
    my $filter
    )
    = map { $ARG[0]->{$ARG} }
    qw[
    var  key  sub_key
    mask  align  defaults
    filters  sort_key  filter
    ];

my $list_error = sprintf "\n\n%67s\n\n\n",
    'error in list definition  [  details have been logged  ]';

my %max_len;
my $data_ref;
my $spacing      = 4;
my $table_string = "\n";

warn "variable name '$h_name' not valid <{C1}>" and return $list_error
    if $h_name !~ m|^[a-z][\w_]*$|i;

no strict qw| refs |;
warn "parser.list_filtered: hash '\%$h_name' not defined <{C1}>"
    and return $list_error
    if not defined \%{"$h_name"};
use strict qw| refs |;

if ( $h_key !~ m|\.| ) {

    no strict qw| refs |;
    $data_ref = ${$h_name}{$h_key};
    use strict qw| refs |;

} elsif ( $h_key =~ m|^\w[\w\.\-]+\w$| ) {

    no strict qw| refs |;
    $data_ref = <[base.resolve_hash]>->( $h_key, \%{"$h_name"} );
    use strict qw| refs |;

    <[base.s_warn]>->(
        "parser.list_filtered: no match for '%s' in '%%%s' hash <{C1}>",
        $h_key, $h_name
        )
        and return $list_error
        if not defined $data_ref;

} else {
    die "list key syntax in '$h_key' not valid";
}

warn "parser.list_filtered : hash key [ or subkey ] not defined <{C1}>"
    and return $list_error
    if not defined $data_ref;

# helper : check if entry matches filter [ key or any visible value ]
my $entry_matches_filter = sub {
    my ( $key, $entry_data ) = @_;
    return 1 unless defined $filter;

    ## Check key
    return 1 if $key =~ $filter;

    ## Check all visible values
    foreach my $key_name ( $display_keys->@* ) {
        my $key_name_str = $key_name;
        next if $key_name_str =~ s|^<key>:||;    ## Skip key column

        ## Extract field name :
        #            "field:display" -> "field", "field" -> "field"
        my $field_name;
        if ( $key_name_str =~ m|^([^:]+):(.+)$| ) {
            $field_name = $1;    ## Field name is before the colon
        } else {
            $field_name = $key_name_str;
        }

        my $value = $entry_data->{$field_name} // '';
        return 1 if $value =~ $filter;
    }
    return 0;
};

# .: preparation :.
my $table_width = 0;
foreach my $key_name ( $display_keys->@* ) {
    my $index        = 0;
    my $key_name_str = $key_name;
    my $key_orig_str = $key_name;
    if ( $key_name_str =~ s|^<key>:|| ) {
        $index        = 1;
        $key_orig_str = $key_name_str;
    } else {
        $key_name_str =~ s|^([^:]+):([^:]+)$|$2|;
        $key_orig_str = $1 if defined $1;
    }
    $max_len{$key_name} = length($key_name_str) + $spacing + 3;
    foreach my $key_val ( keys $data_ref->%* ) {
        ## Skip entries that don't match filter
        next
            unless $entry_matches_filter->( $key_val, $data_ref->{$key_val} );

        next
            if defined $sub_key
            and not exists $data_ref->{$key_val}->{$sub_key}; # only requested
        my $value_str = $key_val;
        if ( $index == 0 ) {
            $value_str = $data_ref->{$key_val}->{$key_orig_str};
        }
        $value_str //= '';
        my $filtered_val
            = <[base.call_filter]>->( $filters, $key_orig_str, $value_str )
            // '';
        $max_len{$key_name} = length($filtered_val) + 4
            if length($filtered_val) > $max_len{$key_name} - 3;
    }
    $table_width += $max_len{$key_name};
}

# .: header :.
foreach my $key_name ( $display_keys->@* ) {
    my $key_name_str = $key_name;
    $key_name_str =~ s|^<key>:||;
    $key_name_str =~ s|^[^:]+:([^:]+)$|$1|;
    $key_name_str =~ s|_| |g;
    my $len = length($key_name_str) + $spacing;
    $table_string
        .= pack( "A$max_len{$key_name}", " : " . $key_name_str . " :." );
}
$table_string =~ s| +$||;
my $last_d_key = $$display_keys[ scalar $display_keys->@* - 1 ];
$max_len{$last_d_key} -= 2;
$table_width-- if $table_width >= 80;
my $sub_line  .= '-' x $table_width;
$table_string .= "\n$sub_line\n";

my @sorted_keys = <[base.reverse-sort]>->($data_ref);

# .: custom sorting :.
if ( defined $sort_key ) {
    my $sort_type = $sort_key =~ s|^([^:]+):|| ? $1 : qw| reverse-len-alpha |;

    if ( $sort_type eq 'alpha-len' ) {
        @sorted_keys
            = <[base.reverse-sort.key-name]>->( $sort_key, $data_ref );
    } elsif ( $sort_type eq qw| alpha | ) {
        eval { @sorted_keys = sort keys( %{$data_ref} ); };
    } elsif ( $sort_type eq qw| num | ) {
        eval {
            @sorted_keys = grep {m|.|} sort {
                ( $data_ref->{$a}->{$sort_key} // 0 )
                    <=> ( $data_ref->{$b}->{$sort_key} // 0 )
                }
                keys %{$data_ref};
        };
    } elsif ( $sort_type eq qw| reverse-num | ) {
        eval {
            @sorted_keys = sort {
                $data_ref->{$b}->{$sort_key} <=> $data_ref->{$a}->{$sort_key}
                }
                keys %{$data_ref};
        };
    } elsif ( $sort_type eq qw| reverse-len-alpha | ) {
        @sorted_keys
            = <[base.reverse-sort.key-name]>->( $sort_key, $data_ref );
    } else {
        warn "unknown sort_type '$sort_type'";
    }
}

warn "custom sort failed [$EVAL_ERROR]" if defined $sort_key and $EVAL_ERROR;

##  .: data :.  ##

foreach my $key_val (@sorted_keys) {
    ## Skip entries that don't match filter
    next unless $entry_matches_filter->( $key_val, $data_ref->{$key_val} );

    next
        if defined $sub_key
        and not defined $data_ref->{$key_val}->{$sub_key};

    foreach my $key_name ( $display_keys->@* ) {
        my $key_name_str = $key_name;
        if ( $key_name_str =~ s|^<key>:|| ) {
            $table_string .= '  '
                . <[base.parser.align]>->(
                $align->{$key_name_str} || qw| left |,
                <[base.call_filter]>->( $filters, $key_name_str, $key_val ),
                $max_len{$key_name} - 1
                ) . ' ';
        } else {
            my $len = $max_len{$key_name};
            $key_name_str =~ s|:.+$||;
            my $value = $data_ref->{$key_val}->{$key_name_str};
            my $val_default
                = defined $defaults->{$key_name_str}
                ? $defaults->{$key_name_str}
                : '';
            $val_default =~ s|<key>|$key_val|;
            $value = $val_default if not length $value;
            $value
                = <[base.call_filter]>->( $filters, $key_name_str, $value );
            $table_string .= <[base.parser.align]>->(
                $align->{$key_name_str} || qw| left |,
                $value, $len - 1
            ) . ' ';
        }
    }
    $table_string =~ s| +$||;
    $table_string .= "\n";
}

return $table_string . "\n";

