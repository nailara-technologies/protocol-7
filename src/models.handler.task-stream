## [:< ##

# name  = models.handler.task-stream
# descr = reply handler for a task notice STRM
# note  = reply handler for <zenka>.subscribe : register the STRM
#         consumer that feeds each announced task id to the peek chain
# notes = same shape as jobsite.handler.fetched-stream. each frame is one
#         line with a new task id -> models.task.dispatch-id with the
#         stream's zenka as the task source [ remote : peek, claim only
#         what this host serves ]. per listed zenka : one down never
#         blocks the others

my $reply = shift // {};

my $zenka = $reply->{'params'}{'zenka'} // '';

return if not length $zenka;

my $state = <models.task.streams>->{$zenka} //= {};

if ( $reply->{'cmd'} eq qw| FALSE | ) {
    <[base.logs]>->(
        0,      ': task notice stream %s : subscribe refused : %s',
        $zenka, $reply->{'call_args'}->{'args'} // 'unknown error'
    );
    $state->{'since'} = undef;
    <[models.task.subscribe-retry]>->($zenka);
    return;
}

return if $reply->{'cmd'} ne qw| STRM |;
return if ( $reply->{'args'} // '' ) ne qw| open |;

my $cmd_id = $reply->{'cmd_id'};
return if not defined $cmd_id or $cmd_id !~ m|^\d+$|;

my $registered = <[strm.local.register]>->(
    $cmd_id,
    {   'watcher' => sub {
            my $lc = shift;
            return if not length $lc->{'buf'};

            ## whole lines only : a frame split across stream chunks stays ##
            ## in the buffer until its newline arrives                     ##
            while ( $lc->{'buf'} =~ s|^([^\n]*)\n|| ) {
                my $line = $1;
                $line =~ s{^\s+|\s+$}{}g;
                next if not length $line;

                if ( $line !~ m|^[A-Z0-9]{7}$| ) {
                    <[base.logs]>->(
                        1, ': task notice stream %s : frame ignored [ %s ]',
                        $zenka, substr( $line, 0, 42 )
                    );
                    next;
                }

                <[base.logs]>->( 2, ': task notice %s : %s', $zenka, $line );
                <[models.task.dispatch-id]>->( $line, $zenka );
            }
        },
        'on_eof' => sub {
            ## stream closed [ task zenka restart or peer gone ] : the poll ##
            ## tick resubscribes after the backoff. a close for an older    ##
            ## stream [ dropped after a silent link ] leaves the newer one  ##
            return
                if ( $state->{'cmd_id'} // -1 ) != $cmd_id;
            $state->{'subscribed'} = FALSE;
            $state->{'since'}      = undef;
            $state->{'cmd_id'}     = undef;
            <[models.task.subscribe-retry]>->($zenka);
            <[base.logs]>->(
                1,      ': task notice stream %s : closed [ cmd_id=%d ]',
                $zenka, $cmd_id
            );
        },
    }
);

if ( not $registered ) {
    $state->{'since'} = undef;
    <[models.task.subscribe-retry]>->($zenka);
    return;
}

$state->{'subscribed'} = TRUE;
$state->{'cmd_id'}     = $cmd_id;
$state->{'since'}      = undef;
$state->{'delay'}      = undef;     ## backoff starts over ##

<[base.logs]>->(
    1,      ': task notice stream %s : consumer registered [ cmd_id=%d ]',
    $zenka, $cmd_id
);

return;

