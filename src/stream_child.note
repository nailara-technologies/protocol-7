## [:< ##

# name  = stream_child.note
# descr = tell the owner what the child did [ on_note ]
# param = handle, kind, info hash

## kinds : signal { signal }, exit { exit, signal }, error { text }, ##
## gave_up, line_dropped { bytes } -- the zenka words them           ##

my ( $handle, $kind, $info ) = @ARG;
my $name = $handle->{'on_note'} // return FALSE;
return FALSE if not defined $code{$name};
$code{$name}->( $kind, $info // {}, $handle );
return TRUE;

