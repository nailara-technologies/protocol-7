## [:< ##

# name  = jobsite.liveness-sweep.complete
# descr = record one sweep verdict and refill its slot
# param = $job_id, $verdict kind

my ( $job_id, $kind ) = @ARG;
my $sweep = <jobsite.liveness_sweep>;
return if ref $sweep ne qw| HASH |;

if ( delete $sweep->{'in_flight'}->{$job_id} ) {
    $sweep->{'done'}++;
    $sweep->{$kind}++ if $kind =~ m{^(?:alive|gone|unknown)$};
}

<[jobsite.liveness-sweep.next]>;

