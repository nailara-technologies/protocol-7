## [:< ##

# name  = coding.helper.calculate_safe_context
# descr = calculate safe context length from available VRAM/RAM
# param = { model_path => ..., mmproj_path => ..., backend => ...,
#           gpu_layers => N, layer_count => N,    [ gpu offload fraction ]
#           kv_cache_type => f16 | q8_0 | .. ,   [ default f16 ]
#           offload_mb => N,      [ moe expert weights in ram : --n-cpu-moe ]
#           vram_total_mb => N }  [ skips the nvidia-smi query : planners ]
# return = { context_length => N, calculated => N, explanation => "...",
#            limited_by => "..." }

my ($params) = @ARG;

my $model_path  = $params->{'model_path'}  // '';
my $mmproj_path = $params->{'mmproj_path'} // '';
my $backend     = $params->{'backend'}     // qw| gpu |;

## gpu offload fraction [ gpu branch only ] : actual -ngl value used and    ##
## the model's true total layer count [ gguf block_count ] -- both 0/absent ##
## means full vram residency is assumed [ exactly the pre-2026-09-17        ##
## behavior, kept identical for the full-offload case ]                     ##
my $gpu_layers  = $params->{'gpu_layers'}  // 0;
my $layer_count = $params->{'layer_count'} // 0;

## safe operating range ##
my $MIN_CONTEXT = 7777;    ## below this, system prompt + tools may not fit ##

## configurable ceiling : set coding.cfg.context_max in start file to cap ##
## smaller models; 0 = uncapped (let VRAM math decide)  default 131072    ##
## covers most consumer GPUs without excessive KV alloc                   ##
my $MAX_CONTEXT = <coding.cfg.context_max> // 131072;
$MAX_CONTEXT = 0 if $MAX_CONTEXT < 0;    ## treat negative as uncapped ##

## model weights size [ file size is good proxy for Q8_0 / Q4 ] ##
my $model_size_mb = 0;
if ( length($model_path) && -f $model_path ) {
    $model_size_mb = ( -s $model_path ) / ( 1024 * 1024 );
}

## multimodal projector size [ loaded even for text if specified ] ##
my $mmproj_size_mb = 0;
if ( length($mmproj_path) && -f $mmproj_path ) {
    $mmproj_size_mb = ( -s $mmproj_path ) / ( 1024 * 1024 );
}

## KV-cache bytes per token : exact from the gguf attention shape when      ##
## readable, size-class estimate otherwise. hybrid models                   ##
## [ qwen35 : full_attention_interval 4 ] keep a kv cache on every 4th      ##
## layer only -- the rest are ssm layers with a fixed-size state. bytes per ##
## cache element follow the kv cache type the server is started with        ##
my %CACHE_BYTES = (
    qw| f32 |    => 4,
    qw| f16 |    => 2,
    qw| bf16 |   => 2,
    qw| q8_0 |   => 34 / 32,
    qw| q6_0 |   => 26 / 32,
    qw| q5_1 |   => 24 / 32,
    qw| q5_0 |   => 22 / 32,
    qw| q4_1 |   => 20 / 32,
    qw| q4_0 |   => 18 / 32,
    qw| iq4_nl | => 18 / 32,
);
my $cache_type = lc( $params->{'kv_cache_type'} // qw| f16 | );
my $elem_bytes = $CACHE_BYTES{$cache_type} // 2;

my $kv_bytes_per_token;
my $kv_source = qw| size-class |;
my $shape
    = length $model_path
    ? <[models.gguf.file.extract_attention]>->($model_path)
    : undef;
if ( ref $shape eq qw| HASH | and $shape->{'block_count'} ) {
    my $layers    = $shape->{'block_count'};
    my $heads     = $shape->{'head_count'}       // 0;
    my $embedding = $shape->{'embedding_length'} // 0;
    my $head_dim  = $heads ? $embedding / ( ref $heads ? 1 : $heads ) : 0;
    my $k_len     = $shape->{'key_length'}    // $head_dim;
    my $v_len     = $shape->{'value_length'}  // $head_dim;
    my $kv_heads  = $shape->{'head_count_kv'} // $heads;

    ## kv heads summed over the layers that hold a kv cache : a per-layer ##
    ## array already carries 0 for the non-attention layers               ##
    my $kv_head_sum = 0;
    if ( ref $kv_heads eq qw| ARRAY | ) {
        $kv_head_sum += $ARG for @$kv_heads;
    } else {
        my $interval  = $shape->{'full_attention_interval'} // 0;
        my $kv_layers = $interval > 1 ? int( $layers / $interval ) : $layers;
        $kv_head_sum = $kv_layers * $kv_heads;
    }

    my $bytes = $kv_head_sum * ( $k_len + $v_len ) * $elem_bytes;
    if ( $bytes > 0 ) {
        $kv_bytes_per_token = $bytes;
        $kv_source          = sprintf 'gguf %s', $cache_type;
    }
}

if ( !$kv_bytes_per_token ) {
    ## parameter count from file size [ Q8_0 ≈ 1 byte/param ] ##
    my $est_params_gb = $model_size_mb / 1024;
    $kv_bytes_per_token = $est_params_gb < 3
        ? 18 * 1024                            # ~18 KB  (3B class)
        : $est_params_gb < 7  ? 28 * 1024      # ~28 KB  (7B class)
        : $est_params_gb < 12 ? 42 * 1024      # ~42 KB  (9-10B class)
        : $est_params_gb < 20 ? 65 * 1024      # ~65 KB  (14-20B class)
        : $est_params_gb < 35 ? 95 * 1024      # ~95 KB  (30B class)
        :                       140 * 1024;    # ~140 KB (70B class)
}
<[base.logs]>->(
    1,
    '[calculate_safe_context] kv cache : %.1f KB per token [ %s ]',
    $kv_bytes_per_token / 1024, $kv_source
);

## for CPU backend : RAM-aware clamp, mirrors the GPU/VRAM math below using ##
## /proc/meminfo MemAvailable [ same source as                              ##
## coding.handler.spawn_smart's own pre-flight RAM check ]. added           ##
## 2026-08-26 after a live crash: the prior unconditional MAX_CONTEXT-or-   ##
## 131072 default let a 9B model auto-expand to a GPU-tuned                 ##
## coding.cfg.context_max [144993] with zero RAM check, crashing the CPU    ##
## llama-server on every spawn attempt                                      ##
## [exit=11, consistent with a KV-cache allocation failure]                 ##
if ( $backend ne qw| gpu | ) {
    my $mem_available_mb = 0;
    my $mem_total_mb     = 0;
    if ( open my $fh, '<', '/proc/meminfo' ) {
        while (<$fh>) {
            if (m|^MemAvailable:\s+(\d+)|) {
                $mem_available_mb = int( $1 / 1024 );    ## kB -> MB ##
            } elsif (m|^MemTotal:\s+(\d+)|) {
                $mem_total_mb = int( $1 / 1024 );        ## kB -> MB ##
            }
            last if $mem_available_mb && $mem_total_mb;
        }
        close $fh;
    }

    if ( not $mem_available_mb ) {
        <[base.logs]>->(
            1,
            '[calculate_safe_context] /proc/meminfo '
                . 'unavailable, falling back to minimum=%d',
            $MIN_CONTEXT
        );
        return {
            context_length => $MIN_CONTEXT,
            calculated     => $MIN_CONTEXT,
            explanation    => 'RAM query failed: using safe minimum',
            limited_by     => qw| ram_query_failed |,
        };
    }

    ## fixed OS/runtime overhead reserve [ conservative flat allowance --  ##
    ## RAM pools vary far more than a single GPU's VRAM, so no overhead    ##
    ## constant is precise here; err generous like the CUDA overhead below ##
    ## ]                                                                   ##
    my $os_overhead_mb = <coding.cfg.cpu_ram_overhead_mb> // 2048;

    my $remaining_mb
        = $mem_available_mb
        - $model_size_mb
        - $mmproj_size_mb
        - $os_overhead_mb;

    ## cannot fit model at all ##
    if ( $remaining_mb <= 0 ) {
        <[base.logs]>->(
            0,
            '[calculate_safe_context] model does not fit '
                . 'RAM: available=%dMB model=%.0fMB mmproj=%.0fMB',
            $mem_available_mb,
            $model_size_mb,
            $mmproj_size_mb
        );
        return {
            context_length => $MIN_CONTEXT,
            calculated     => 0,
            explanation    => sprintf(
                'Model too large for RAM: available=%dMB '
                    . 'model=%.0fMB mmproj=%.0fMB',
                $mem_available_mb, $model_size_mb, $mmproj_size_mb
            ),
            limited_by => qw| model_size |,
        };
    }

    ## adaptive safety margin: 30% of remaining space for generation       ##
    ## buffers [ temporary allocations, headroom for token generation ] -- ##
    ## deliberately NOT covering the compute-graph buffer any more, that's ##
    ## now its own context-scaling term below : a flat capped margin (was  ##
    ## max 4096MB) cannot track a cost that grows with context itself      ##
    my $safety_min_mb = <coding.cfg.cpu_ram_safety_min_mb> // 512;
    my $safety_max_mb = <coding.cfg.cpu_ram_safety_max_mb> // 4096;
    my $safety_mb     = int( $remaining_mb * 0.30 );
    $safety_mb = $safety_min_mb if $safety_mb < $safety_min_mb;
    $safety_mb = $safety_max_mb if $safety_mb > $safety_max_mb;

    ## compute-graph buffer [ prompt-processing attention/intermediate      ##
    ## buffers, NOT the KV cache -- grows with context, unlike the flat     ##
    ## safety margin above. added after a live incident 2026-09-17: a 7B-   ##
    ## class model at ctx=144993 predicted ~7.9GB total (model+KV) by the   ##
    ## KV-only formula but actually used ~14.9GB RSS, OOM-killing the whole ##
    ## host. a same-day retest with the multiplier below at 2x STILL        ##
    ## undershot a *different* 7B model badly enough to need a manual kill  ##
    ## before it repeated the OOM -- the true ratio isn't a stable          ##
    ## per-architecture-class constant like kv_bytes_per_token is (2 real   ##
    ## points so far: ~1.8x and ~4x+, second one still climbing when        ##
    ## killed, true peak unknown). raised to 6x as a wide-margin stopgap    ##
    ## over both, NOT a fitted constant -- see                              ##
    ## bug-coding-cpu-context-oom-forced-wsl-reboot-2026-09-17.md. the      ##
    ## $mem_total_mb hard ceiling right below is the real backstop while    ##
    ## this per-token model stays this uncertain                            ##
    my $compute_buffer_multiplier
        = <coding.cfg.cpu_compute_buffer_multiplier> // 6;
    my $combined_bytes_per_token
        = $kv_bytes_per_token * ( 1 + $compute_buffer_multiplier );

    my $available_for_kv_mb = $remaining_mb - $safety_mb;

    my $calculated_context = int(
        ( $available_for_kv_mb * 1024 * 1024 ) / $combined_bytes_per_token );

    my $final_context = $calculated_context;
    $final_context = $MIN_CONTEXT if $final_context < $MIN_CONTEXT;
    $final_context = $MAX_CONTEXT
        if $MAX_CONTEXT && $final_context > $MAX_CONTEXT;

    ## hard backstop, independent of the per-token model above              ##
    ## [ which two real incidents 2026-09-17 proved unreliable on its own ] ##
    ## : never let the inference process's OWN predicted footprint exceed a ##
    ## flat fraction of TOTAL system ram, regardless of what MemAvailable   ##
    ## said was free -- protects against the compute-buffer estimate being  ##
    ## wrong in EITHER direction, not just against transient available-ram  ##
    ## noise the safety_mb margin above already covers                      ##
    ##                                                                      ##
    ## deliberately uses its OWN much more pessimistic multiplier, not      ##
    ## $combined_bytes_per_token above : converting this budget through the ##
    ## SAME soft rate just rescales that rate's own error straight through  ##
    ## unchanged [ verified by hand: a soft rate that's 2x too optimistic   ##
    ## still lands ~74% of total ram via that path, 3x too optimistic lands ##
    ## ~99% -- back in OOM territory ]. this multiplier only has to be      ##
    ## right ONCE, independent of the soft model's own accuracy             ##
    my $hard_backstop_multiplier
        = <coding.cfg.cpu_compute_buffer_hard_multiplier> // 15;
    my $hard_bytes_per_token
        = $kv_bytes_per_token * ( 1 + $hard_backstop_multiplier );

    my $hard_ram_limited = FALSE;
    if ($mem_total_mb) {
        my $hard_fraction = <coding.cfg.cpu_ram_hard_fraction> // 0.5;
        my $hard_budget_mb
            = $mem_total_mb * $hard_fraction
            - $model_size_mb
            - $mmproj_size_mb;
        my $hard_context
            = $hard_budget_mb > 0
            ? int( ( $hard_budget_mb * 1024 * 1024 ) / $hard_bytes_per_token )
            : 0;
        if ( $hard_context < $final_context ) {
            $final_context    = $hard_context;
            $hard_ram_limited = TRUE;
        }
        $final_context = $MIN_CONTEXT if $final_context < $MIN_CONTEXT;
    }

    my $limited_by
        = $hard_ram_limited                     ? qw| hard_ram_fraction |
        : $final_context == $calculated_context ? qw| none |
        : $final_context == $MIN_CONTEXT        ? qw| minimum |
        :                                         qw| maximum |;

    <[base.logs]>->(
        1,
        ': RAM=%d MB : model %.0f MB mmproj %.0f MB KV [ token '
            . '%.1f KB ] compute [ token %.1f KB : %dx multiplier ]',
        $mem_available_mb,
        $model_size_mb,
        $mmproj_size_mb,
        $kv_bytes_per_token / 1024,
        ( $combined_bytes_per_token - $kv_bytes_per_token ) / 1024,
        $compute_buffer_multiplier,
    );
    <[base.logs]>->(
        1, ': safety=%d MB : calc : %d | clamped : %d [ %s ]',
        $safety_mb, $calculated_context, $final_context, $limited_by
    );

    return {
        context_length => $final_context,
        calculated     => $calculated_context,
        explanation    => sprintf(
            'RAM=%dMB model=%.0fMB mmproj=%.0fMB KV/token=%.1fKB '
                . 'compute/token=%.1fKB safety=%dMB -> calc : %d clamped : '
                . '%d',
            $mem_available_mb,
            $model_size_mb,
            $mmproj_size_mb,
            $kv_bytes_per_token / 1024,
            ( $combined_bytes_per_token - $kv_bytes_per_token ) / 1024,
            $safety_mb,
            $calculated_context,
            $final_context
        ),
        limited_by         => $limited_by,
        kv_source          => $kv_source,
        kv_bytes_per_token => $kv_bytes_per_token,
    };
}

## query GPU memory [ single shared helper, see its own file for why ] ##
my $vram
    = $params->{'vram_total_mb'}
    ? {
    'ok'       => TRUE,
    'total_mb' => $params->{'vram_total_mb'},
    'free_mb'  => 0
    }
    : <[coding.helper.query_gpu_memory]>;
if ( !$vram->{'ok'} ) {
    <[base.logs]>->(
        1,
        '[calculate_safe_context] nvidia-smi '
            . 'failed, falling back to minimum=%d',
        $MIN_CONTEXT
    );
    return {
        context_length => $MIN_CONTEXT,
        calculated     => $MIN_CONTEXT,
        explanation    => 'GPU query failed: using safe minimum',
        limited_by     => qw| gpu_query_failed |,
    };
}

my ( $total_mb, $free_mb ) = ( $vram->{'total_mb'}, $vram->{'free_mb'} );

## fixed CUDA context overhead                                             ##
## [ empirical: actual overhead ~1256MB for WSL2 + CUDA + FlashAttention ] ##
my $cuda_overhead_mb = 1256;

## partial gpu offload awareness [ added 2026-09-17, gpu-side sibling of    ##
## the cpu-branch incident fixed above : llama-server-cu kernel-oom-killed  ##
## at 14.98GB anon RSS on a ~15GB WSL2 host -- journalctl -b -1 confirmed ] ##
## : a model with MORE layers than the actual -ngl value is partially       ##
## resident in system RAM, and this holds even when spawn_inference_server  ##
## 's calculate_partial_gpu_layers reduction branch never fired -- the      ##
## default -ngl 33 is a generic constant, not a model-derived value, so     ##
## e.g. a 48-layer model that fits vram at the file-size check still        ##
## silently keeps 15 layers [ + their share of weights ] on cpu/ram. the    ##
## old math below assumed full vram residency, subtracting the FULL model   ##
## size from vram only and never budgeting the ram side at all -- a         ##
## partially-offloaded model was handed a vram-scale context whose kv-cache ##
## + context-scaling compute buffers then landed in system ram on top of    ##
## the cpu-resident weight fraction : the incident mechanism                ##
##                                                                          ##
## gpu-resident weight share uses the SAME first-order per-layer            ##
## approximation as coding.helper.calculate_partial_gpu_layers              ##
## [ model_size_mb / layer_count ] -- deliberately not a different one      ##
my $partial_offload = FALSE;
my $gpu_model_mb    = $model_size_mb;    ## full vram residency [ default ] ##
my $cpu_model_mb    = 0;
if (    $layer_count > 0
    and $gpu_layers > 0
    and $gpu_layers < $layer_count ) {
    $partial_offload = TRUE;
    $gpu_model_mb    = $model_size_mb * ( $gpu_layers / $layer_count );
    $cpu_model_mb    = $model_size_mb - $gpu_model_mb;
}

## moe expert offload [ --n-cpu-moe ] : the expert weights of the first n   ##
## layers live in ram, attention and the kv cache stay on the gpu -- not    ##
## the partial-layer branch, whose ram math puts the kv there too. ram only ##
## has to hold those weights [ + os overhead ]                              ##
my $offload_mb = $params->{'offload_mb'} // 0;
if ( $offload_mb > 0 and !$partial_offload ) {
    $gpu_model_mb = $model_size_mb - $offload_mb;
    $cpu_model_mb = $offload_mb;
    my $mem_available_mb = 0;
    if ( open my $fh, '<', '/proc/meminfo' ) {
        while (<$fh>) {
            if (m|^MemAvailable:\s+(\d+)|) {
                $mem_available_mb = int( $1 / 1024 );
                last;
            }
        }
        close $fh;
    }
    my $os_overhead_mb = <coding.cfg.cpu_ram_overhead_mb> // 2048;
    if (  !$mem_available_mb
        or $offload_mb + $os_overhead_mb > $mem_available_mb ) {
        return {
            context_length => $MIN_CONTEXT,
            calculated     => 0,
            explanation    => sprintf(
                'moe expert offload does not fit '
                    . 'ram : experts=%.0fMB available=%dMB',
                $offload_mb, $mem_available_mb
            ),
            limited_by         => qw| moe_ram |,
            kv_source          => $kv_source,
            kv_bytes_per_token => $kv_bytes_per_token,
        };
    }
}

## memory left after loading [ gpu-resident ] model weights + CUDA context ##
my $remaining_mb
    = $total_mb - $gpu_model_mb - $mmproj_size_mb - $cuda_overhead_mb;

## cannot fit model at all ##
if ( $remaining_mb <= 0 ) {
    <[base.logs]>->(
        0,
        '[calculate_safe_context] model does not fit '
            . 'GPU: total=%dMB model=%.0fMB mmproj=%.0fMB',
        $total_mb,
        $model_size_mb,
        $mmproj_size_mb
    );
    return {
        context_length => $MIN_CONTEXT,
        calculated     => 0,
        explanation    => sprintf(
            'Model too large for GPU: total=%dMB model=%.0fMB mmproj=%.0fMB',
            $total_mb, $model_size_mb, $mmproj_size_mb
        ),
        limited_by => qw| model_size |,
    };
}

## adaptive safety margin: 30% of remaining space for generation buffers [ ##
## compute buffers, temporary allocations, headroom for token generation ] ##
my $safety_min_mb = <coding.cfg.vram_safety_min_mb> // 512;
my $safety_max_mb = <coding.cfg.vram_safety_max_mb> // 3072;
my $safety_mb     = int( $remaining_mb * 0.30 );
$safety_mb = $safety_min_mb if $safety_mb < $safety_min_mb;
$safety_mb = $safety_max_mb if $safety_mb > $safety_max_mb;

my $available_for_kv_mb = $remaining_mb - $safety_mb;

## derive context from available KV memory ##
my $calculated_context
    = int( ( $available_for_kv_mb * 1024 * 1024 ) / $kv_bytes_per_token );

## clamp to safe range ##
my $final_context = $calculated_context;
$final_context = $MIN_CONTEXT if $final_context < $MIN_CONTEXT;
$final_context = $MAX_CONTEXT
    if $MAX_CONTEXT && $final_context > $MAX_CONTEXT;

my $limited_by
    = $final_context == $calculated_context ? qw| none |
    : $final_context == $MIN_CONTEXT        ? qw| minimum |
    :                                         qw| maximum |;

## ram-side budget for the cpu-resident fraction [ partial offload only ]   ##
##                                                                          ##
## the KV cache is a SINGLE allocation regardless of offload split          ##
## [ llama.cpp/ik_llama.cpp keep it together ] and its actual placement     ##
## [ vram vs ram ] depends on build flags and offload split -- neither pool ##
## can be relied upon to hold it here. so the context is constrained by the ##
## TIGHTER of two budgets : the vram-side one above                         ##
## [ existing math, unchanged ] and this ram-side one, which mirrors the    ##
## cpu branch's own already-incident-tested pattern [ os overhead reserve,  ##
## 30%-clamped safety margin, context-scaling compute term at the same      ##
## cpu_compute_buffer_multiplier, and the decoupled hard total-ram-fraction ##
## backstop with its own much more pessimistic multiplier -- the real       ##
## safety net while the per-token compute cost stays this uncertain, see    ##
## bug-coding-cpu-context-oom-forced-wsl-reboot-2026-09-17 ]. two real      ##
## incidents 2026-09-17 proved the kv-only estimate lands several GB under  ##
## actual rss at large context -- that error lands in system ram for a      ##
## partially-offloaded model, which is precisely the 14.98GB oom-kill this  ##
## block exists to prevent                                                  ##
if ($partial_offload) {
    my $mem_available_mb = 0;
    my $mem_total_mb     = 0;
    if ( open my $fh, '<', '/proc/meminfo' ) {
        while (<$fh>) {
            if (m|^MemAvailable:\s+(\d+)|) {
                $mem_available_mb = int( $1 / 1024 );    ## kB -> MB ##
            } elsif (m|^MemTotal:\s+(\d+)|) {
                $mem_total_mb = int( $1 / 1024 );        ## kB -> MB ##
            }
            last if $mem_available_mb && $mem_total_mb;
        }
        close $fh;
    }

    ## ram unreadable : fail safe, exactly like the cpu branch ##
    if ( not $mem_available_mb ) {
        <[base.logs]>->(
            1,
            '[calculate_safe_context] partial offload but '
                . '/proc/meminfo unavailable, falling back to minimum=%d',
            $MIN_CONTEXT
        );
        return {
            context_length => $MIN_CONTEXT,
            calculated     => $MIN_CONTEXT,
            explanation    => 'partial offload, RAM query '
                . 'failed: using safe minimum',
            limited_by => qw| ram_query_failed |,
        };
    }

    ## same fixed os/runtime reserve as the cpu branch ##
    my $os_overhead_mb = <coding.cfg.cpu_ram_overhead_mb> // 2048;

    my $ram_remaining_mb
        = $mem_available_mb - $cpu_model_mb - $os_overhead_mb;

    ## cpu-resident weight fraction alone does not fit available ram ##
    if ( $ram_remaining_mb <= 0 ) {
        <[base.logs]>->(
            0,
            '[calculate_safe_context] partial offload : cpu-resident weights '
                . 'do not fit RAM: available=%dMB cpu_model=%.0fMB [ %d/%d '
                . 'layers on gpu ]',
            $mem_available_mb,
            $cpu_model_mb,
            $gpu_layers,
            $layer_count
        );
        return {
            context_length => $MIN_CONTEXT,
            calculated     => 0,
            explanation    => sprintf(
                'partial offload: cpu-resident weights too large for '
                    . 'RAM: available=%dMB cpu_model=%.0fMB [ %d/%d layers ]',
                $mem_available_mb, $cpu_model_mb,
                $gpu_layers,       $layer_count
            ),
            limited_by => qw| partial_model_size |,
        };
    }

    ## same adaptive safety margin as the cpu branch [ 30% clamped ] ##
    my $ram_safety_min_mb = <coding.cfg.cpu_ram_safety_min_mb> // 512;
    my $ram_safety_max_mb = <coding.cfg.cpu_ram_safety_max_mb> // 4096;
    my $ram_safety_mb     = int( $ram_remaining_mb * 0.30 );
    $ram_safety_mb = $ram_safety_min_mb
        if $ram_safety_mb < $ram_safety_min_mb;
    $ram_safety_mb = $ram_safety_max_mb
        if $ram_safety_mb > $ram_safety_max_mb;

    ## same context-scaling compute-buffer term as the cpu branch : the ##
    ## compute graph of the cpu-resident layers                         ##
    ## [ prompt-processing attention/intermediate buffers ] grows with  ##
    ## context and lands in system ram                                  ##
    my $compute_buffer_multiplier
        = <coding.cfg.cpu_compute_buffer_multiplier> // 6;
    my $combined_bytes_per_token
        = $kv_bytes_per_token * ( 1 + $compute_buffer_multiplier );

    my $ram_calculated
        = int( ( ( $ram_remaining_mb - $ram_safety_mb ) * 1024 * 1024 )
        / $combined_bytes_per_token );

    ## same decoupled hard total-ram-fraction backstop as the cpu branch, ##
    ## budgeted against the cpu-resident weight fraction only             ##
    ## [ the gpu-resident fraction lives in vram ] : never let this       ##
    ## process's own predicted ram footprint exceed a flat fraction of    ##
    ## TOTAL system ram                                                   ##
    my $hard_backstop_multiplier
        = <coding.cfg.cpu_compute_buffer_hard_multiplier> // 15;
    my $hard_bytes_per_token
        = $kv_bytes_per_token * ( 1 + $hard_backstop_multiplier );

    my $hard_ram_limited = FALSE;
    if ($mem_total_mb) {
        my $hard_fraction  = <coding.cfg.cpu_ram_hard_fraction> // 0.5;
        my $hard_budget_mb = $mem_total_mb * $hard_fraction - $cpu_model_mb;
        my $hard_context
            = $hard_budget_mb > 0
            ? int( ( $hard_budget_mb * 1024 * 1024 ) / $hard_bytes_per_token )
            : 0;
        if ( $hard_context < $ram_calculated ) {
            $ram_calculated   = $hard_context;
            $hard_ram_limited = TRUE;
        }
    }

    ## tighter pool wins [ see block header comment for why both apply ] ##
    if ( $ram_calculated < $final_context ) {
        $final_context = $ram_calculated;
        $limited_by
            = $hard_ram_limited
            ? qw| partial_hard_ram_fraction |
            : qw| partial_ram |;
        ## keep the reported raw calculated value consistent for callers ##
        $calculated_context = $ram_calculated
            if $ram_calculated < $calculated_context;
    }
    $final_context = $MIN_CONTEXT if $final_context < $MIN_CONTEXT;

    <[base.logs]>->(
        1,
        ': partial offload [ %d/%d layers on gpu ] : cpu-resident '
            . '%.0f MB : RAM=%d MB : safety=%d MB : ram-calc %d [ %s ]',
        $gpu_layers,
        $layer_count,
        $cpu_model_mb,
        $mem_available_mb,
        $ram_safety_mb,
        $ram_calculated,
        $hard_ram_limited ? qw| hard | : qw| soft |
    );
}

<[base.logs]>->(
    1, ': VRAM=%d MB : model %.0f MB mmproj %.0f MB KV [ token %.1f KB ]',
    $total_mb, $model_size_mb, $mmproj_size_mb, $kv_bytes_per_token / 1024,
);
<[base.logs]>->(
    1, ': safety=%d MB : calc : %d | clamped : %d [ %s ]',
    $safety_mb, $calculated_context, $final_context, $limited_by
);

return {
    context_length => $final_context,
    calculated     => $calculated_context,
    explanation    => sprintf(
        'VRAM=%dMB model=%.0fMB mmproj=%.0fMB '
            . 'KV/token=%.1fKB safety=%dMB -> calc : %d clamped : %d',
        $total_mb,       $model_size_mb,
        $mmproj_size_mb, $kv_bytes_per_token / 1024,
        $safety_mb,      $calculated_context,
        $final_context
    ),
    limited_by         => $limited_by,
    kv_source          => $kv_source,
    kv_bytes_per_token => $kv_bytes_per_token,
};

