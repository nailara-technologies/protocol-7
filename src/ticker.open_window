## [:< ##

# name = ticker.open_window

<[base.log]>->( 1, ': opening ticker window.,' );

$ENV{'DISPLAY'}     = <x11.display>;
$ENV{'GDK_BACKEND'} = 'x11';           ## force XWayland under WSL/Wayland ##
delete $ENV{'WAYLAND_DISPLAY'};
Gtk3->init;

<ticker.is-iconified> //= FALSE;

my $swap_enabled = <[base.cfg_bool]>->(<ticker.mouse.swap_edge>);
my $window_mode
    = $swap_enabled               ? qw| toplevel |
    : <ticker.window.force_above> ? qw| popup |
    :                               qw| toplevel |;
my $is_popup = $window_mode eq qw| popup |;

my $window = <ticker.obj.window> = Gtk3::Window->new($window_mode);

$window->signal_connect( delete_event => sub { Gtk3->main_quit } );

if ( $window->is_composited ) {
    <ticker.is_composited> = TRUE;
    <[base.log]>->( 1, ': : compositor detected =)' );
    $window->set_opacity(0)
        if <ticker.use_transparency> and <ticker.do_custom_fade_in>;
} else {
    <ticker.is_composited> = FALSE;
    <[base.log]>->( 1, ': : no compositor running :|' );
}

## apply window placement profile  in swap mode this also constrains the    ##
## ticker to the selected monitor, so use the shared profile helper instead ##
## of duplicating the logic here.                                           ##
<[ticker.cmd.set-window-profile]>->( { 'args' => <ticker.window.profile> } );

## detect when the monitor the ticker is on disappears (e.g. beamer       ##
## switched off) and move it to the next available monitor automatically. ##
my $display = Gtk3::Gdk::Display::get_default;
if ( defined $display and <[base.cfg_bool]>->(<ticker.mouse.swap_edge>) ) {
    $display->signal_connect(
        'monitor-removed' => sub {
            my ( undef, $monitor ) = @ARG;
            return if not defined $monitor;

            my $mgeo = eval { $monitor->get_geometry };
            return if not defined $mgeo;
            my ( $mx, $my )
                = ref($mgeo) eq qw| HASH |
                ? @$mgeo{qw| x y |}
                : ( $mgeo->x, $mgeo->y );

            return
                if not defined <x11.coordinates.left>
                or not defined <x11.coordinates.top>;

            my $tol = 5;
            if (    abs( <x11.coordinates.left> - $mx ) <= $tol
                and abs( <x11.coordinates.top> - $my ) <= $tol ) {
                <[base.log]>->(
                    1,
                    ': current monitor removed, moving ticker to next monitor'
                );
                <[ticker.cmd.set-window-profile]>
                    ->( { 'args' => <ticker.window.profile> } );
            }
        }
    );
}

my $geo = {
    'width'  => <x11.window.width>,
    'height' => <x11.window.height>,
    'x'      => <x11.coordinates.left>,
    'y'      => <x11.coordinates.top>
};

<[ticker.load_font_offsets_table]>;    ## <--  uses window-height ##

$window->set_title(<x11.title_str>);
$window->set_border_width(0);
$window->set_decorated(0);
$window->set_keep_above(1) if <ticker.window.force_above> or $swap_enabled;
$window->set_app_paintable(1);
$window->set_accept_focus(0);
$window->set_focus_on_map(0);
$window->set_can_focus(0);
$window->set_skip_taskbar_hint(1);

## dock type hint makes WSLg/Weston take over positioning and ignore client ##
## moves; override-redirect popup windows must not carry it.                ##
## keep the dock hint for the non-swap toplevel so it behaves like a panel; ##
## for swap mode a normal toplevel is used so client moves are honored.     ##
$window->set_type_hint('dock')
    if not $is_popup
    and not $swap_enabled;    ## don't steal focus/taskbar entry ##

## mouse-avoidance: fade out + lower on hover, raise + fade in on leave ##
<ticker.mouse.avoid>  //= TRUE;
<ticker.mouse.inside> //= FALSE;
$window->add_events(
    [   qw| enter-notify-mask leave-notify-mask
            button-press-mask scroll-mask |
    ]
);

my $start_fade = sub {
    my ($handler) = @ARG;
    return if not <ticker.use_transparency> or not <ticker.do_custom_fade_in>;
    <ticker.timer.fade>->cancel if defined <ticker.timer.fade>;
    delete <ticker.time.fade_view>
        ;    ## reset time, keep opacity for smooth switch ##
    <ticker.fade.handler> = $handler;
    <ticker.timer.fade>   = <[event.add_timer]>->(
        {   'after'    => 0,
            'interval' => 0.017,
            'handler'  => $handler
        }
    );
};

$window->signal_connect(
    'enter-notify-event' => sub {
        my ( undef, $event ) = @ARG;
        return FALSE if not <ticker.mouse.avoid>;
        return FALSE if <ticker.mouse.inside>;
        return FALSE
            if defined $event
            and $event->detail =~ /^(inferior|virtual|nonlinear-virtual)$/;
        if ( defined <ticker.mouse.grace_until>
            and <[base.time]>->(5) < <ticker.mouse.grace_until> ) {
            return FALSE;
        }
        <ticker.mouse.inside> = TRUE;
        delete <ticker.mouse.leave_pending_until>;
        delete <ticker.mouse.swap_left_at>;

        ## in swap mode start the fade-out immediately; the fade itself now ##
        ## lasts ticker.swap.delay seconds, and the swap happens when it    ##
        ## ends.                                                            ##
        if ( <[base.cfg_bool]>->(<ticker.mouse.swap_edge>)
            and not <ticker.swap.disabled> ) {
            <[base.log]>->(
                2, ': mouse entered ticker window (swap), fading out'
            );
            if ( <ticker.use_transparency> and <ticker.do_custom_fade_in> ) {
                <ticker.fade.handler> = qw| fade_out |;
                $start_fade->(qw| ticker.handler.fade_out |);
            } elsif ( defined <x11.id> ) {
                <[base.X-11.keep_below]>->(<x11.id>);
            }
            return FALSE;
        }

        <[base.log]>->( 1, ': mouse entered ticker window, fading out' );
        if ( <ticker.use_transparency> and <ticker.do_custom_fade_in> ) {
            $start_fade->(qw| ticker.handler.fade_out |);
        } elsif ( defined <x11.id> ) {
            <[base.X-11.keep_below]>->(<x11.id>);
        }
        return FALSE;
    }
);
$window->signal_connect(
    'leave-notify-event' => sub {
        my ( undef, $event ) = @ARG;
        return FALSE if not <ticker.mouse.avoid>;
        return FALSE if not <ticker.mouse.inside>;
        return FALSE
            if defined $event
            and $event->detail =~ /^(inferior|virtual|nonlinear-virtual)$/;
        <ticker.mouse.inside> = FALSE;

        ## in swap mode fade back in immediately when the cursor leaves, ##
        ## aborting an in-progress fade-out so the ticker does not swap. ##
        if ( <[base.cfg_bool]>->(<ticker.mouse.swap_edge>)
            and not <ticker.swap.disabled> ) {
            <ticker.mouse.swap_left_at> = <[base.ntime]>;
            delete <ticker.swap.pending_until>
                if defined <ticker.swap.pending_until>;
            <[base.log]>->(
                2, ': mouse left ticker window (swap), fading in'
            );
            if ( <ticker.use_transparency> and <ticker.do_custom_fade_in> ) {
                <ticker.fade.handler> = qw| fade_in |;
                $start_fade->(qw| ticker.handler.fade_in |);
            } elsif ( defined <x11.id> ) {
                <[base.X-11.raise-window]>->(<x11.id>);
                <[base.X-11.keep_above]>->(<x11.id>);
            }
        } else {
            ## a dismissed notification, or a ticker.dismiss'd ticker in ##
            ## either mode, stays hidden; do not fade back in            ##
            if (
                (   ( <ticker.display.mode> // qw| continuous | ) eq
                    qw| notify | and <ticker.notify.dismissed>
                )
                or <ticker.hidden>
            ) {
                return FALSE;
            }

            <ticker.mouse.leave_pending_until> = <[base.time]>->(5) + 0.3;
            <[base.log]>->(
                1, ': mouse left ticker window, fade-in delayed 300ms'
            );
        }
        return FALSE;
    }
);

## generic button/wheel events: always emitted on ticker.events for       ##
## external listeners [LMB info popup, continuous-mode RMB menu, wheel-   ##
## driven HUD, etc.]. RMB additionally toggles top/bottom in notify mode, ##
## mirroring the swap-edge top/bottom switch already available in         ##
## continuous mode.                                                       ##
my %button_name = ( 1 => qw| left |, 2 => qw| middle |, 3 => qw| right | );

$window->signal_connect(
    'button-press-event' => sub {
        my ( undef, $event ) = @ARG;
        my $name = $button_name{ $event->button } // $event->button;
        <[ticker.emit_event]>->("click:$name");

        if (    $name eq qw| right |
            and ( <ticker.display.mode> // qw| continuous | ) eq qw| notify |
            and defined <ticker.obj.window>
            and <ticker.obj.window>->get_visible ) {

            my $current = <ticker.window.profile> // qw| top-strip |;
            my $target
                = $current eq qw| top-strip |
                ? qw| bottom-strip |
                : qw| top-strip |;

            <[ticker.move_to_profile]>->( $target, $current );
        }

        return FALSE;
    }
);

$window->signal_connect(
    'scroll-event' => sub {
        my ( undef, $event ) = @ARG;
        my $direction = $event->direction;    ## up|down|left|right|smooth ##
        <[ticker.emit_event]>->("scroll:$direction");
        return FALSE;
    }
);

my $screen = $window->get_screen;

my $rgba = FALSE;
$rgba = $screen->get_rgba_visual() if <ticker.use_transparency>;

if ( not $rgba ) {
    <ticker.use_transparency> = FALSE;
} else {
    $window->set_visual($rgba);
}

## $window->signal_connect( 'draw' => $code{'ticker.callback.draw'} );

$window->signal_connect(
    qw| draw | => sub {
        eval { <[ticker.callback.draw]>->(@ARG) };
        if ( length $EVAL_ERROR ) {
            <[base.log]>->( 0, <[base.str.eval_error]>->(1) );
            <[base.sleep]>->(0.07);
        }
    }
);

my $map_assigned = 0;
$window->signal_connect(
    qw| map | => sub {
        return FALSE if $map_assigned++;
        <[base.log]>->( 1, ': ticker window mapped, assigning X11 id' );
        <x11.id> = $window->get_toplevel()->get_window()->get_xid();
        <[base.X-11.assign_window]>;

        ## GTK's initial placement can be off under WSLg. at the time       ##
        ## set-window-profile first ran [just after Gtk3->init], the GDK    ##
        ## display's monitor list/geometry may not have settled yet, so the ##
        ## computed <x11.coordinates.*> can be based on the wrong monitor's ##
        ## offset. unlike the swap case, the window has *just* been mapped  ##
        ## here, so a ConfigureWindow issued immediately races with         ##
        ## Weston's own initial-placement handshake and gets clobbered even ##
        ## with a short sleep. defer to a one-shot timer so the display has ##
        ## time to settle, recompute the profile geometry [picks up correct ##
        ## monitor offsets], then double-apply the move as in swap_profile. ##
        ## startup initial placement now happens pre-show_all from the      ##
        ## geo_ready snapshot [ ticker.startup_coordinates ], which Weston  ##
        ## honors at map time. skip the post-map settle/move correction in  ##
        ## that case -- a post-map cross-output move only gets clamped and  ##
        ## would clobber the correct initial placement.                     ##
        if ( defined <x11.coordinates.left>
            and not defined <ticker.startup_coordinates> ) {

            ## the GDK monitor list/geometry can take longer than 0.3s to   ##
            ## settle on the very first query after Gtk3->init [especially  ##
            ## for non-primary monitors with a host-configured vertical     ##
            ## offset]. instead of a single deferred recompute, poll the    ##
            ## monitor geometry via select_monitor every 0.2s until two     ##
            ## consecutive reads agree [or a max attempt count is reached], ##
            ## then apply the profile + double-move once with that stable   ##
            ## geometry. swap-time recomputes are unaffected - this only    ##
            ## guards the startup placement.                                ##
            my $last_geo;
            my $attempts     = 0;
            my $max_attempts = 10;
            <ticker.timer.startup_settle> = <[event.add_timer]>->(
                {   'after'    => 0.2,
                    'interval' => 0.2,
                    'cb'       => sub {
                        return if not defined <x11.id>;
                        $attempts++;

                        my $mon = <[ticker.select_monitor]>;
                        my $cur
                            = defined $mon
                            ? sprintf( '%d,%d,%d,%d',
                            $mon->{'x'},     $mon->{'y'},
                            $mon->{'width'}, $mon->{'height'} )
                            : 'undef';

                        <[base.logs]>->(
                            2,
                            ': startup-debug: settle '
                                . 'attempt %d monitor geo=%s',
                            $attempts,
                            $cur
                        );

                        my $stable
                            = ( defined $last_geo and $last_geo eq $cur );
                        $last_geo = $cur;

                        return
                            if not $stable
                            and $attempts < $max_attempts;

                        <ticker.timer.startup_settle>->cancel
                            if defined <ticker.timer.startup_settle>;
                        delete <ticker.timer.startup_settle>;

                        ## debug instrumentation: where is the window  ##
                        ## actually placed before/after the corrective ##
                        ## move, vs the computed target?               ##
                        my $before
                            = <[base.X-11.get_window_geometry]>->(<x11.id>);
                        <[base.logs]>->(
                            2,
                            ': startup-debug: before-move '
                                . 'actual x=%d y=%d, target x=%d y=%d',
                            $before->{'x'} // -1,
                            $before->{'y'} // -1,
                            <x11.coordinates.left>,
                            <x11.coordinates.top>
                        );

                        <[ticker.cmd.set-window-profile]>
                            ->( { 'args' => <ticker.window.profile> } );
                        <[base.X-11.move-window]>->(
                            <x11.id>,              <x11.coordinates.left>,
                            <x11.coordinates.top>, <x11.window.width>,
                            <x11.window.height>
                        );
                        <[base.sleep]>->(0.05);
                        <[base.X-11.move-window]>->(
                            <x11.id>,              <x11.coordinates.left>,
                            <x11.coordinates.top>, <x11.window.width>,
                            <x11.window.height>
                        );

                        <[base.sleep]>->(0.05);
                        my $after
                            = <[base.X-11.get_window_geometry]>->(<x11.id>);
                        <[base.logs]>->(
                            2,
                            ': startup-debug: after-move '
                                . 'actual x=%d y=%d, target x=%d y=%d',
                            $after->{'x'} // -1,
                            $after->{'y'} // -1,
                            <x11.coordinates.left>,
                            <x11.coordinates.top>
                        );
                    }
                }
            );
        } elsif ( defined <ticker.startup_coordinates> ) {

            ## verify the pre-show_all snapshot placement actually landed - ##
            ## confirmed live: even this previously-reliable path can land  ##
            ## in a VOID [ no monitor contains the actual position at all ] ##
            ## when the snapshot target falls in the primary/secondary      ##
            ## Y-range overlap zone - a never-before-mapped window is not   ##
            ## immune either. a never-mapped window's own initial-placement ##
            ## handshake with Weston can still be in progress for a while,  ##
            ## so a single delayed check+correct is unreliable [ confirmed  ##
            ## live: the very first recheck can itself still land in the    ##
            ## void ]. retry with the same patience as the no-snapshot      ##
            ## settle-timer branch above instead of a single shot, and only ##
            ## give up [ leaving whatever the last attempt produced ] after ##
            ## repeated failures.                                           ##
            my $attempts     = 0;
            my $max_attempts = 10;
            <ticker.timer.startup_void_recovery> = <[event.add_timer]>->(
                {   'after'    => 0.2,
                    'interval' => 0.2,
                    'cb'       => sub {
                        return if not defined <x11.id>;
                        $attempts++;

                        my $actual
                            = <[base.X-11.get_window_geometry]>->(<x11.id>);
                        my $sc  = <ticker.startup_coordinates>;
                        my $tol = 50;

                        my $landed
                            = defined $actual
                            && abs( $actual->{'x'} - $sc->{'x'} ) <= $tol
                            && abs( $actual->{'y'} - $sc->{'y'} ) <= $tol;

                        if ($landed) {
                            <ticker.timer.startup_void_recovery>->cancel
                                if defined
                                <ticker.timer.startup_void_recovery>;
                            delete <ticker.timer.startup_void_recovery>;
                            return;
                        }

                        <[base.logs]>->(
                            0,
                            ': startup placement failed (attempt %d/%d, '
                                . 'actual x=%s y=%s, target x=%d y=%d)',
                            $attempts,
                            $max_attempts,
                            $actual->{'x'} // '?',
                            $actual->{'y'} // '?',
                            $sc->{'x'},
                            $sc->{'y'}
                        );

                        my $monitors = <[base.gtk.list_monitors]> // [];
                        my $preferred_index;
                        for my $i ( 0 .. $#$monitors ) {
                            my $m = $monitors->[$i];
                            if (    $sc->{'x'} >= $m->{'x'}
                                and $sc->{'x'} < $m->{'x'} + $m->{'width'}
                                and $sc->{'y'} >= $m->{'y'}
                                and $sc->{'y'} < $m->{'y'} + $m->{'height'} )
                            {
                                $preferred_index = $i;
                                last;
                            }
                        }

                        my $candidates
                            = <[window.place.build_strip_candidates]>->(
                            $monitors,
                            <ticker.window.profile> // qw| bottom-strip |,
                            $preferred_index
                            );
                        my $safe = <[window.place.find_safe_position]>->(
                            <x11.id>, $candidates
                        );

                        if ( defined $safe and defined $safe->{'profile'} ) {
                            <ticker.window.profile> = $safe->{'profile'};
                            <x11.coordinates.left>  = $safe->{'x'};
                            <x11.coordinates.top>   = $safe->{'y'};
                            <x11.coordinates.right>
                                = $safe->{'x'} + $safe->{'width'};
                            <x11.coordinates.bottom>
                                = $safe->{'y'} + $safe->{'height'};
                            <x11.window.width>  = $safe->{'width'};
                            <x11.window.height> = $safe->{'height'};

                            <[base.X-11.raise-window]>->(<x11.id>);
                            <[base.X-11.keep_above]>->(<x11.id>);

                            <ticker.timer.startup_void_recovery>->cancel
                                if defined
                                <ticker.timer.startup_void_recovery>;
                            delete <ticker.timer.startup_void_recovery>;
                            return;
                        }

                        return if $attempts < $max_attempts;

                        <[base.log]>->(
                            0,
                            ': startup placement recovery exhausted '
                                . 'all attempts, window may be in a void'
                        );
                        <ticker.timer.startup_void_recovery>->cancel
                            if defined <ticker.timer.startup_void_recovery>;
                        delete <ticker.timer.startup_void_recovery>;
                    }
                }
            );
        }

        return FALSE;
    }
);

## keep input shape in sync with the actual window size. under Wayland the ##
## allocation at map time can differ from the final compositor placement , ##
## so we refresh the shape on every resize/configure.                      ##
my $update_input_shape = sub {
    eval {
        return if not $window->get_realized;

        ## get_allocation can return an unblessed hash ref on some ##
        ## Gtk3/Perl versions, so access width/height defensively. ##
        my $alloc = $window->get_allocation;
        my ( $alloc_w, $alloc_h )
            = ref($alloc) eq qw| HASH |
            ? ( $alloc->{'width'}, $alloc->{'height'} )
            : ( $alloc->width, $alloc->height );

        return if $alloc_w <= 1 or $alloc_h <= 1;

        return
            if not defined <x11.coordinates.left>
            or not defined <x11.window.width>;

        ## set input shape to the full allocation. on Wayland               ##
        ## gtk_window_get_position returns (0,0), so a position-relative    ##
        ## clip would end up empty. the log shows the allocation already    ##
        ## matches the intended ticker geometry, so full-window input shape ##
        ## is correct here.                                                 ##
        my $shape_w = $alloc_w;
        my $shape_h = $alloc_h;

        return if $shape_w <= 1 or $shape_h <= 1;

        my $region = Cairo::Region->create(
            {   x      => 0,
                y      => 0,
                width  => $shape_w,
                height => $shape_h
            }
        );
        $window->input_shape_combine_region($region);

        <[base.logs]>->(
            2,        ': updated input shape: w=%d h=%d',
            $shape_w, $shape_h
        );
    };
    <[base.log]>->( 0, ': input shape update failed: ' . $EVAL_ERROR )
        if length $EVAL_ERROR;
    return FALSE;
};
$window->signal_connect( 'configure-event' => $update_input_shape );
$window->signal_connect( 'size-allocate'   => $update_input_shape );

## initial placement BEFORE show_all, from geo_ready's snapshot -- Weston  ##
## honors a client move issued before map but clamps/centers a post-map    ##
## cross-output move [ the centered-on-wrong-monitor regression ]. mirrors ##
## protocol-7-menu's pre-show_all gravity+default_size+move. set-window-   ##
## profile [ above ] may have recomputed wrong coords from an unsettled    ##
## GDK; the snapshot is geo_ready's correct rect, so use it here.          ##
if ( defined <ticker.startup_coordinates> ) {
    my $sc = <ticker.startup_coordinates>;
    $window->set_gravity('north-west');
    $window->set_default_size( $sc->{'width'}, $sc->{'height'} );
    $window->move( $sc->{'x'}, $sc->{'y'} );
    <[base.logs]>->(
        1, ': initial placement [before show_all] x=%d y=%d w=%d h=%d',
        $sc->{'x'}, $sc->{'y'}, $sc->{'width'}, $sc->{'height'}
    );
}

$window->show_all;

## set initial input shape once allocation is known ##
Glib::Idle->add($update_input_shape);

## poll-based hover detection because WSLg/XWayland enter/leave events are ##
## unreliable for transparent dock windows                                 ##
<ticker.timer.pointer_check> //= <[event.add_timer]>->(
    {   'after'    => 0.1,
        'interval' => 0.1,
        'handler'  => qw| ticker.handler.check_pointer |
    }
);

<ticker.font.size> = 0;

my $font_name = <ticker.font.name>;
my $font_path = sprintf qw| %s/%s.ttf |, <ticker.font.path>, $font_name;
my $freetype  = Font::FreeType->new;
my $ft_face   = $freetype->face($font_path);
<ticker.font.face> = Cairo::FtFontFace->create($ft_face);

<ticker.obj.window>->queue_draw;

