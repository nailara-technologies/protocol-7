## [:< ##

# name  = nameserv.consistency.handler.answer
# descr = read one async consistency query reply [ bgread ]

## io watcher handler : the event carries the query id ##

my $id = shift->w->data;

my $state = <nameserv.consistency.state>;
return if not ref $state;

my $q = $state->{'queries'}->{$id};
return if not defined $q;

my $pkt = $q->{'resolver'}->bgread( $q->{'sock'} );

my @values;
if ( defined $pkt ) {
    for my $rr ( $pkt->answer ) {
        my $rr_type = $rr->type;
        if ( $rr_type eq qw| A | or $rr_type eq qw| AAAA | ) {
            push @values, $rr->address;
        } elsif ( $rr_type eq qw| NS | ) {
            push @values, $rr->nsdname;
        } elsif ( $rr_type eq qw| PTR | ) {
            push @values, $rr->ptrdname;
        } elsif ( $rr_type eq qw| SOA | ) {
            push @values, $rr->serial;
        }
    }
}

<[nameserv.consistency.complete]>->( $state, $id, \@values, FALSE );

return;

