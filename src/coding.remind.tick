## [:< ##

# name   = coding.remind.tick
# descr  = retry timer : send what is still undelivered
# args   = the timer event [ not used ]

## also the first look after a start : the file is read here, after the ##
## privilege drop. nothing kept : no timer is armed again               ##

undef <coding.remind.timer>;
my $all = <[coding.remind.store]>->(qw| all |);
return TRUE if not keys %{$all};
<[coding.remind.watch]>;
<[coding.remind.send]>->($ARG) foreach sort keys %{$all};
<[coding.remind.arm]>;
return TRUE;

