## [:< ##

# name  = data.cmd.import-fs
# param = <local-path> <hash-path>
# descr = import filesystem directory into hash structure

my ( $local_path, $hash_path ) = split( m| +|, $call->{'args'} // '', 2 );

return {
    'mode' => qw| false |,
    'data' => 'expected <local-path> and <hash-path> arguments'
    }
    unless defined $local_path and defined $hash_path;

return {
    'mode' => qw| false |,
    'data' => "path '$local_path' does not exist"
    }
    unless -e $local_path;

## ensure target hash path exists ##
my $target_ref = <[data.ensure_hash_path]>->($hash_path);

return {
    'mode' => qw| false |,
    'data' => "cannot create hash path '$hash_path'"
    }
    unless defined $target_ref;

## recursive import function ##
my $import_count = 0;
my $total_size   = 0;

my $import_path;
$import_path = sub {
    my ( $src_path, $target_hash ) = @ARG;

    if ( -d $src_path ) {
        ## directory - create hash entry
        opendir( my $dh, $src_path ) or return;
        my @entries = grep { $_ ne '.' && $_ ne '..' } readdir($dh);
        closedir($dh);

        for my $entry (@entries) {
            my $src_child  = "$src_path/$entry";
            my $entry_name = $entry;

            if ( -d $src_child ) {
                ## subdirectory - recurse
                $target_hash->{$entry_name} //= {};
                if ( ref( $target_hash->{$entry_name} ) eq 'HASH' ) {
                    $import_path->( $src_child, $target_hash->{$entry_name} );
                }
            } else {
                ## file - read content as scalar ref
                open( my $fh, '<', $src_child ) or next;
                local $/;
                my $content = <$fh>;
                close($fh);

                $target_hash->{$entry_name} = \$content;
                $import_count++;
                $total_size += length($content);
            }
        }
    } elsif ( -f $src_path ) {
        ## single file
        open( my $fh, '<', $src_path ) or return;
        local $/;
        my $content = <$fh>;
        close($fh);

        my $basename = File::Basename::basename($src_path);
        $target_hash->{$basename} = \$content;
        $import_count++;
        $total_size += length($content);
    }
};

## do import ##
$import_path->( $local_path, $target_ref );

## clean up ##
undef $import_path;

## notify registered hooks ##
<[data.hooks.notify]>->( 'import', $hash_path, $import_count, $total_size );

return {
    'mode' => qw| true |,
    'data' => sprintf(
        "Imported %d files (%d bytes) into '%s'",
        $import_count, $total_size, $hash_path
    )
};

