## [:< ##

# name  = X-11.handler.display_poll
# descr = async poll: connect to X display when its socket appears;
#          abort on crash or timeout; then resolve display dependency

my $event       = shift->w;
my $display_str = $event->data->{'display'}      // return;
my $server      = <X-11.servers>->{$display_str} // return;
my $max_retries = 80;    ## 80 x 100ms = 8s ##

my $cancel_poll = sub {
    if ( defined $server->{'poll_timer'} ) {
        $server->{'poll_timer'}->cancel;
        delete $server->{'poll_timer'};
    }
};

## check if server process died ##
my $pid = $server->{'pid'};
if ( defined $pid ) {
    my $wait_res = <[base.waitpid]>->($pid);    ## WNOHANG ##
    if ( $wait_res < 0 or $wait_res == $pid ) {
        $cancel_poll->();
        <[base.logs]>->(
            0, "X-11 server on %s terminated unexpectedly [ pid %s ]",
            $display_str, $pid
        );
        return;
    }
}

## timeout ##
if ( ++$server->{'poll_retries'} > $max_retries ) {
    $cancel_poll->();
    <[base.logs]>->(
        0, "[!] X-11 display %s socket connection timed out", $display_str
    );
    return;
}

## cheap non-blocking pre-check first : a filesystem-namespace socket     ##
## [ the default for Xvfb ] tells us in a stat() call whether             ##
## X11::Protocol->new even has a chance -- skip attempting the connect at ##
## all while it's not there yet. abstract-namespace sockets don't show up ##
## here [ fall through to the guarded connect below in that case, same as ##
## before ]                                                               ##
my ($disp_num) = $display_str =~ m|^:(\d+)|;
if ( defined $disp_num and not -S "/tmp/.X11-unix/X$disp_num" ) {
    <[base.logs]>->( 2, ": display %s socket not present yet", $display_str )
        if $server->{'poll_retries'} % 7 == 0;
    return;
}

## attempt X11::Protocol connection [ also matches an abstract-namespace    ##
## socket, which never shows up as a /tmp/.X11-unix/X<n> filesystem entry ] ##
## NOTE : this connect + setup handshake is synchronous, and REVERTED       ##
## 2026-08-28 an alarm()-based bound around it -- this zenka's event loop   ##
## almost certainly uses alarm()/SIGALRM internally for its own timers, so  ##
## a local $SIG{ALRM} override from inside a timer callback clobbered the   ##
## framework's own alarm state instead of safely bounding just this call,   ##
## making the crash-loop worse [ cascaded into killing dbus too ]. see      ##
## feedback-x11-blocking-display-poll-heartbeat-crash before trying again : ##
## fix needs a signal-free bound [ e.g. non-blocking IO::Socket::UNIX       ##
## connect + handing the already-open fh to X11::Protocol->new($fh) ], not  ##
## alarm(). the filesystem pre-check above still stands -- it's signal-free ##
## and narrows how often this synchronous call is even attempted.,          ##
my $conn;
my @connect_args = ($display_str);
push( @connect_args,
    [ $server->{'xauth'}->{'protocol'}, $server->{'xauth'}->{'data'} ] )
    if $server->{'mode'} eq qw| xorg |
    and defined $server->{'xauth'};
my $connect_start = <[base.time]>->(4);
eval { $conn = X11::Protocol->new(@connect_args); };
my $connect_error = $EVAL_ERROR;
my $connect_ms    = ( <[base.time]>->(4) - $connect_start ) * 1000;

<[base.logs]>->(
    2,            ": display %s X11::Protocol->new took %.2f ms",
    $display_str, $connect_ms
);

if ( length $connect_error or not defined $conn ) {
    <[base.logs]>->(
        2,            ": display %s connection not ready yet: %s",
        $display_str, $connect_error
    ) if $server->{'poll_retries'} % 7 == 0;
    return;
}

if ( $server->{'mode'} eq qw| xorg | ) {
    my $x11_user  = $server->{'xauth'}->{'user'} // '';
    my $access_ok = eval {
        die 'missing xorg authority or user' if not length $x11_user;
        foreach my $local_user ( $x11_user, qw| root | ) {
            $conn->ChangeHosts( qw| Insert ServerInterpreted |,
                "localuser:$local_user" );
        }
        $conn->SetAccessControl(qw| Enabled |);
        my @hosts = $conn->ListHosts();
        die 'X access control is disabled'
            if not @hosts
            or $hosts[0] ne qw| Enabled |;
        foreach my $local_user ( $x11_user, qw| root | ) {
            my $present = grep {
                        ref($ARG) eq qw| ARRAY |
                    and $ARG->[0] eq qw| ServerInterpreted |
                    and $ARG->[1] eq "localuser:$local_user"
            } @hosts[ 1 .. $#hosts ];
            die "missing SI localuser entry for $local_user" if not $present;
        }
        TRUE;
    };
    if ( not $access_ok or length $EVAL_ERROR ) {
        <[base.logs]>->(
            0,            'xorg access setup failed on %s : %s',
            $display_str, $EVAL_ERROR
        );
        eval { $conn->{'connection'}->fh->close };
        return;
    }
    $server->{'access_ready'} = TRUE;
}

## connection established and xorg access control enforced ##
$cancel_poll->();

$server->{'conn'}      = $conn;
$server->{'connected'} = TRUE;

<[base.logs]>->(
    1, "display %s connected [ X11::Protocol ready ]", $display_str
);

## resolve jobs waiting on this display ##
<[jobqueue.check_dependencies]>;

