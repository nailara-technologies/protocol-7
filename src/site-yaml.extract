## [:< ##

# name  = site-yaml.extract
# descr = route URL to domain-specific extractor, return hashref

my $url = $ARG[0] // '';

if ( $url =~ m|stepstone\.de/stellenangebote--|i ) {
    return <[site-yaml.stepstone.job]>->($url);
} elsif ( $url =~ m|stepstone\.de/jobs/|i ) {
    return <[site-yaml.stepstone.search]>->($url);
}

return "no extraction template for url: $url";

