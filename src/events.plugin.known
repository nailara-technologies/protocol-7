## [:< ##

# name  = events.plugin.known
# descr = sorted names of the loaded plugins of one kind
# args   = kind [ action | source ]
# return = list of names

my $kind = shift // '';
return sort keys %{ <[events.plugin.registry]>->()->{$kind} // {} };

