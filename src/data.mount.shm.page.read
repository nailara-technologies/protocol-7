## [:< ##

# name = data.mount.shm.page.read
# descr = Read one page from a paged SHM segment

# thin zenka wrapper -> AMOS7::SHM::Page::read_page [ zero added logic ;
# this layer is pure computation, identical standalone and in-zenka ]

my ( $mount, $page_num ) = @ARG;

return AMOS7::SHM::Page::read_page( $mount, $page_num );

