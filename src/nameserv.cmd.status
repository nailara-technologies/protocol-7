## [:< ##

# name  = nameserv.cmd.status
# descr = return nameserv zenka status information

my $zones = <nameserv.zones>;
my $stats = <nameserv.stats>;

my @zone_list = map {
    my $z = $zones->{$ARG};
    sprintf(
        "%s: %d records (serial %d)",
        $ARG, scalar @{ $z->{'records'} // [] },
        $z->{'serial'}
    );
} sort keys %$zones;

my $data_str = sprintf(
    "nameserv status:\n  bind: %s:%d\n  zones: %d loaded\n "
        . " queries: %d\n  errors: %d\n  zone list:\n    %s",
    <nameserv.bind.addr>, <nameserv.bind.port>,
    scalar keys %$zones,  $stats->{'queries'},
    $stats->{'errors'},   join( "\n    ", @zone_list ) || '(none)'
);

return { mode => 'size', data => $data_str };

