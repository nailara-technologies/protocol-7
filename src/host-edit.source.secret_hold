## [:< ##

# name  = host-edit.source.secret_hold
# descr = local record source : hold a secret -- NOT SUPPORTED
# param = $hold_name, $encoded_value, $reply_handler [ , $params_href ]

## host records hold NO secrets [ HOST-SETUP.md 'host record' : link metadata
## only, and the trust columns are read from the pin store, never stored ], so
## the sessions half of the record source has nothing behind it.  the reply
## still honours the deferred contract and the failure shape the engine's
## secret handlers detect : sessions.cmd.* uses mode=>size UNIFORMLY, failure
## is the '<<' prefix in the data string [ form.handler.secret_hold_reply /
## submit_secret_hold_reply ].

my ( $hold_name, $encoded_value, $reply_handler, $params ) = @ARG;

my $msg = '<< host records hold no secrets : hold not supported >>';

my $info = {
    qw| sid |       => <form.cube_sid> // 0,
    qw| cmd |       => qw| SIZE |,
    qw| call_args | => { qw| args | => '' },
    defined $params ? ( qw| params | => $params ) : (),
    qw| data | => $msg
};

<[event.add_timer]>->(
    {   qw| after | => 0,
        qw| desc |  => 'host-edit.source.secret_hold deferred reply',
        qw| cb |    => sub { <[$reply_handler]>->($info) },
    }
);

return TRUE;

