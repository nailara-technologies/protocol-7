## [:< ##

# name  = models.storage.yaml_load
# descr = Load models registry from YAML file in zenka directory
# return = registry hash reference or empty hash on error

use YAML::XS qw| Load |;

## Load YAML content from zenka directory [ registry/models.yaml ]
my $yaml_content_ref = <[file.zenka_dir.load]>->('registry/models.yaml');

## If file doesn't exist, return empty registry
unless ( defined $yaml_content_ref ) {
    <[base.logs]>->(
        2,
        '[storage.yaml_load] registry file '
            . 'not found, returning empty registry'
    );
    return {};
}

## Dereference the content (file.zenka_dir.load returns scalar reference)
my $yaml_content
    = ref($yaml_content_ref) eq qw| SCALAR |
    ? $$yaml_content_ref
    : $yaml_content_ref;

## Parse YAML content
my $registry        = {};
my $scan_paths_data = {};
if ( defined $yaml_content && length $yaml_content ) {
    eval {
        my $parsed = Load($yaml_content);
        if ( ref($parsed) eq qw| HASH | ) {
            $registry        = $parsed->{models}     // {};
            $scan_paths_data = $parsed->{scan_paths} // {};
        }
    };
    if ($EVAL_ERROR) {
        <[base.logs]>->(
            0, '[storage.yaml_load] YAML parse error: %s',
            <[base.str.eval_error]>
        );
        return {};
    }
}

## Restore scan_paths to zenka namespace if data was loaded
if ( scalar( keys %$scan_paths_data ) > 0 ) {
    <models.scan_paths> = $scan_paths_data;
    <[base.logs]>->(
        1,
        '[storage.yaml_load] loaded %d scan paths',
        scalar( keys $scan_paths_data->%* )
    );
}

<[base.logs]>->(
    1,
    '[storage.yaml_load] loaded registry with %d entries',
    scalar( keys $registry->%* )
);

return $registry;

