## [:< ##

# name  = usage.leak_check.line
# descr = one result line of the scan child
# args  = line [ octets ], handle

my ( $line, $handle ) = @ARG;
my $run = <usage.leak_check.run> // return;
return if $run->{'handle'} != $handle;

utf8::decode($line);
my ( $key, @field ) = CORE::split( m{\t}, $line );
$key //= '';

if ( $key eq qw| hit | and @field >= 3 ) {
    push $run->{'hits'}->@*, [@field];
} elsif ( $key eq qw| unreadable | and @field == 1 ) {
    push $run->{'skipped'}->@*, $field[0];
} elsif ( $key eq qw| done | and @field == 2 ) {
    @{$run}{qw| unreadable seconds |} = @field;
}
return;

