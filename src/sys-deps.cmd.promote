## [:< ##

# name = sys-deps.cmd.promote
# descr = promote tracked package to zenka deps/os config
# param = <pkg> <zenka>

my $param = shift;
my $args  = $param->{'args'} // '';

my ( $pkg, $zenka ) = split( m|\s+|, $args, 2 );

unless ( defined $pkg && defined $zenka ) {
    return {
        'mode' => qw| false |,
        'data' => 'usage: promote <pkg> <zenka>'
    };
}

## write the declaration marker + flag the entry declared [ shared       ##
## AMOS7::deps::tracked promote : validates names, refuses unknown zenki ##
## and untracked packages, writes atomically ]                           ##
my $result
    = AMOS7::deps::tracked::promote( <system.root_path>, $zenka, $pkg );

return { 'mode' => qw| false |, 'data' => $result->{'error'} }
    if not $result->{'ok'};

## reflect the new declared state in memory ##
my $tracked = <sys-deps.tracked> // [];
for my $entry (@$tracked) {
    if ( $entry->{'pkg'} eq $pkg ) {
        $entry->{'declared'} = 1;
        last;
    }
}

if ( $result->{'status'} eq qw| exists | ) {
    return {
        'mode' => qw| true |,
        'data' => "$pkg already declared for zenka '$zenka'"
    };
}

return {
    'mode' => qw| true |,
    'data' => "declared $pkg for zenka '$zenka'"
};

