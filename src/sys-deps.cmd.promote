## [:< ##

# name = sys-deps.cmd.promote
# descr = promote tracked package to zenka deps/os config
# param = <pkg> <zenka>

my $param = shift;
my $args  = $param->{'args'} // '';

my ( $pkg, $zenka ) = split( m|\s+|, $args, 2 );

unless ( defined $pkg && defined $zenka ) {
    return {
        'mode' => qw| false |,
        'data' => 'usage: promote <pkg> <zenka>'
    };
}

my $dep_dir_name = AMOS7::deps::os_package::dep_type_to_dir('debian');
my $zenka_os_dep_dir
    = <system.conf_path> . "/zenki/$zenka/deps/os/$dep_dir_name";

eval {
    require File::Path;
    File::Path::make_path($zenka_os_dep_dir) unless -d $zenka_os_dep_dir;
};

my $pkg_file = "$zenka_os_dep_dir/$pkg";

if ( -f $pkg_file ) {
    return {
        'mode' => qw| true |,
        'data' => "$pkg already declared for zenka '$zenka'"
    };
}

open my $fh, '>',
    $pkg_file
    or return {
    'mode' => qw| false |,
    'data' => "failed to create $pkg_file: $!"
    };
close $fh;

## Update tracking state ##
my $tracked = <sys-deps.tracked> // [];
for my $entry (@$tracked) {
    if ( $entry->{'pkg'} eq $pkg ) {
        $entry->{'declared'} = 1;
        last;
    }
}

## Save updated tracking state ##
my $track_file = <system.root_path> . '/var/sys-deps/tracked.yaml';
eval {
    require YAML::Tiny;
    my $yaml = YAML::Tiny->new( { tracked => $tracked } );
    $yaml->write($track_file);
};
chmod( 0664, $track_file ) if -f $track_file and -o $track_file;

return {
    'mode' => qw| true |,
    'data' => "declared $pkg for zenka '$zenka'"
};

