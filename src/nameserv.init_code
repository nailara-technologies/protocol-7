## [:< ##

# name  = nameserv.init_code
# descr = initialize nameserv dns server state

<[base.perlmod.load]>->('Net::DNS');
<[base.perlmod.load]>->('Net::DNS::Packet');
<[base.perlmod.load]>->('Net::DNS::RR');

## nameserv configuration
<nameserv.bind.addr> //= '0:0:0:0:0:0:0:0';
<nameserv.bind.port> //= 53;
<nameserv.zone_dir>  //= catdir( <system.path.zenka-dirs.var_P7>,
    <system.zenka.name>, 'zones' );

## runtime state
<nameserv.zones> //= {}; ## { zone_name => { records => [...], serial => N } }
<nameserv.socket>                  //= undef;
<nameserv.stats>                   //= { queries => 0, errors => 0 };
<nameserv.discovered>              //= {};
<nameserv.cfg.auto_publish_domain> //= undef;
<nameserv.cfg.challenge_ttl>       //= 60;

## tombstones stay this long for offline peers [ 13 days ] ##
<nameserv.cfg.sync.tombstone_keep> //= 1123200;

## the official sync port [ harmonic ] ; listening is opt-in -- the port ##
## takes unauthenticated connections, a desktop never opens it unasked   ##
<nameserv.cfg.sync.port>   //= 7753;
<nameserv.cfg.sync.listen> //= 'no';

## 13 steps of 5 minutes [ 3600 / 3900 = 12 / 13 ] ##
<nameserv.cfg.default_ttl> //= 3900;

if ( defined <nameserv.cfg.auto_publish_domain> ) {
    <[event.add_timer]>->(
        {   'interval' => 777,
            'repeat'   => TRUE,
            'handler'  => qw| nameserv.orbital.auto_publish |
        }
    );
}

## ensure zone directory exists
if ( not -d <nameserv.zone_dir> ) {
    <[file.make_path]>->(
        <nameserv.zone_dir>, 0750, <system.amos-zenka-user>,
        <system.amos-zenka-user>
    ) or die "<< cannot create zone dir >>";
}

## load initial zones
<[nameserv.zones.load]>;

## start udp listener (binds to port 53, must happen before root.drop_privs)
<[nameserv.start_listener]>;

## stage 2 : timestamp delta sync [ silent without sync config ] ##
<[nameserv.sync.start]>;

0;

