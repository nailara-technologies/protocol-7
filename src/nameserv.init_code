## [:< ##

# name  = nameserv.init_code
# descr = initialize nameserv dns server state

my $reinit = shift;

<[base.perlmod.load]>->('Net::DNS');
<[base.perlmod.load]>->('Net::DNS::Packet');
<[base.perlmod.load]>->('Net::DNS::RR');

## per-subname instance configuration [ nameserv[cache] \ cache-local ] ##
my $subname = <system.zenka.subname> // '';
my $sub_cfg
    = length $subname
    ? ( <nameserv.cfg.by_subname> // {} )->{$subname} // {}
    : {};

<nameserv.bind.addr> = $sub_cfg->{'bind_addr'}
    if defined $sub_cfg->{'bind_addr'};
<nameserv.bind.port> = $sub_cfg->{'bind_port'}
    if defined $sub_cfg->{'bind_port'};
<nameserv.zone_dir> = $sub_cfg->{'zone_dir'}
    if defined $sub_cfg->{'zone_dir'};
<nameserv.cfg.cache.enabled> = $sub_cfg->{'enabled'}
    if defined $sub_cfg->{'enabled'};
<nameserv.cfg.cache.upstream> = $sub_cfg->{'upstream'}
    if defined $sub_cfg->{'upstream'};

## nameserv configuration
<nameserv.bind.addr> //= '0:0:0:0:0:0:0:0';
<nameserv.bind.port> //= 53;
<nameserv.zone_dir>  //= catdir( <system.path.zenka-dirs.var_P7>,
    <system.zenka.name>, 'zones' );

## runtime state
<nameserv.zones> //= {}; ## { zone_name => { records => [...], serial => N } }
<nameserv.socket> //= undef;
<nameserv.stats>  //= {
    'queries'         => 0,
    'errors'          => 0,
    'tcp_queries'     => 0,
    'cache_hits'      => 0,
    'cache_misses'    => 0,
    'cache_forwarded' => 0,
    'cache_servfail'  => 0,
    'cache_encrypted' => 0
};
<nameserv.discovered>              //= {};
<nameserv.cfg.auto_publish_domain> //= undef;
<nameserv.cfg.challenge_ttl>       //= 60;

## tombstones stay this long for offline peers [ 13 days ] ##
<nameserv.cfg.sync.tombstone_keep> //= 1123200;

## the official sync port [ harmonic ] ; listening is opt-in -- the port ##
## takes unauthenticated connections, a desktop never opens it unasked   ##
<nameserv.cfg.sync.port>   //= 7753;
<nameserv.cfg.sync.listen> //= 'no';

## tcp dns [ rfc 7766 ] connection limits ##
<nameserv.cfg.tcp.max_connections> //= 77;
<nameserv.cfg.tcp.idle_timeout>    //= 13;

## forwarding dns cache [ loopback clients only -- never an open resolver : ##
## authoritative REFUSED + rd + loopback client -> cache hit, else          ##
## forwarded to the upstreams ; without configured upstreams the            ##
## resolv.conf nameservers are used, loopback excluded                      ##
<nameserv.cfg.cache.enabled>          //= 'no';
<nameserv.cfg.cache.max_ttl>          //= 86400;
<nameserv.cfg.cache.max_negative_ttl> //= 900;
<nameserv.cfg.cache.max_entries>      //= 7777;
<nameserv.cfg.cache.upstream>         //= '';
<nameserv.cfg.cache.upstream_timeout> //= 3;

## cache and source upstream state            ##
## [ reinit safe : neither resets on reload ] ##
<nameserv.cache.entries>                 //= {};
<nameserv.upstreams.by_source>           //= {};
<nameserv.upstreams.held_by_source>      //= {};
<nameserv.upstreams.domain_by_source>    //= {};
<nameserv.upstreams.behaviour_by_source> //= {};

## encrypted fallback [ dns over tls 853, dns over https 443 ] : used for ##
## networks measured intercepting \ blocking-outside. upstreams from      ##
## nameserv.cfg.encrypted.upstream.NAME.* or                              ##
## nameserv.set-encrypted-upstreams ; connections and back-off state      ##
## survive a reload                                                       ##
<nameserv.encrypted.upstreams> //= {};
<nameserv.enc.pool>            //= {};
<nameserv.enc.health>          //= {};
<[nameserv.enc.load_cfg]>;

## a config reload may change cache.upstream : read the list again ##
delete <nameserv.cache.upstream_list> if $reinit;
<nameserv.cache.in_flight> //= {};

## consistency check configuration [ per host in host.cfg ] ##
<nameserv.cfg.dn_names>       //= '';    ## own name server names ##
<nameserv.cfg.dn_peers_names> //= '';    ## optional, every dn name ##
## expected in each zone  ##

## 13 steps of 5 minutes [ 3600 / 3900 = 12 / 13 ] ##
<nameserv.cfg.default_ttl> //= 3900;

if ( defined <nameserv.cfg.auto_publish_domain> ) {
    <[event.add_timer]>->(
        {   'interval' => 777,
            'repeat'   => TRUE,
            'handler'  => qw| nameserv.orbital.auto_publish |
        }
    );
}

## ensure zone directory exists
if ( not -d <nameserv.zone_dir> ) {
    <[file.make_path]>->(
        <nameserv.zone_dir>, 0750, <system.amos-zenka-user>,
        <system.amos-zenka-user>
    ) or die "<< cannot create zone dir >>";
}

## load initial zones
<[nameserv.zones.load]>;

## udp + tcp listeners [ port 53 : before root.drop_privs ] ##
<[nameserv.start_listener]>->($reinit);

## stage 2 : timestamp delta sync [ silent without sync config ] ##
<[nameserv.sync.start]>;

## consistency check [ warns only, never changes anything ] : first run 77  ##
## s after start [ the cube session is up by then -- the check itself never ##
## runs from init, only from the timer ], then every 3900  re-init safe : a ##
## reload cancels the previous timers instead of adding a second set        ##
for my $timer ( @{ <nameserv.consistency.timers> // [] } ) {
    $timer->cancel if ref $timer and eval { $timer->can('cancel') };
}
<nameserv.consistency.timers> = [
    <[event.add_timer]>->(
        {   'after'   => 77,
            'handler' => qw| nameserv.consistency.run |
        }
    ),
    <[event.add_timer]>->(
        {   'interval' => 3900,
            'handler'  => qw| nameserv.consistency.run |
        }
    ),
];

0;

