## [:< ##

# name  = base.load_host_config
# descr = apply the optional per-host overlay of the zenka config
# note  = /etc/protocol-7/host-config/<zenka>.cfg -- 'key = value' lines
#         that override the tree's config on THIS host only [ a public
#         dns bind, an acme provider, paths, cube grants ]. no file :
#         nothing changes. used as '[load_host_config]' in a zenka.v7,
#         after its own keys and before [load_modules] ; re-applied on
#         'reload config'. applied only when base.host.trusted_file
#         accepts it [ root \ tree owner, no group \ other write up to
#         '/' ] : the zenka user cannot write it. an old
#         /etc/protocol-7/<zenka>/host.cfg [ zenka owned dir ] is never
#         read and never moved -- logged until the admin moves it

my $zenka_name = <system.zenka.name> // '';
return TRUE unless length $zenka_name and $zenka_name =~ m|^[\w.-]+$|;

my $cfg_dir = <[base.host.config_dir]>;
( my $dir_name = $cfg_dir ) =~ s{^.*/}{};
if ( $zenka_name eq $dir_name ) {
    <[base.logs]>->(
        0, ': zenka name %s is the host config dir : no overlay', $zenka_name
    );
    return TRUE;
}

my $etc_dir = ( <system.path.zenka-dirs> // {} )->{'etc_P7'}
    // '/etc/protocol-7';

## the zenka's own state dir exists on every host                    ##
## [ zenka owned, no overlay in it ] : created here while still root ##
## [ before root.drop_privs ]                                        ##
if ( !-d "$etc_dir/$zenka_name" and $EFFECTIVE_USER_ID == 0 ) {
    if ( mkdir "$etc_dir/$zenka_name", 0750 ) {
        my $user = <system.amos-zenka-user> // qw| protocol-7 |;
        my ( $uid, $gid ) = ( getpwnam $user )[ 2, 3 ];
        chown $uid, $gid, "$etc_dir/$zenka_name" if defined $uid;
        <[base.logs]>->(
            1, ': zenka etc dir created : %s',
            "$etc_dir/$zenka_name"
        );
    }
}

my $old_cfg = "$etc_dir/$zenka_name/host.cfg";
<[base.logs]>->(
    0,
    ': %s NOT applied : host overlays live in '
        . '%s/%s.cfg now [ review it, then move it as root ]',
    $old_cfg,
    $cfg_dir,
    $zenka_name
) if -e $old_cfg;

my $host_cfg = "$cfg_dir/$zenka_name.cfg";
return TRUE unless -e $host_cfg or -l $host_cfg;

my ( $trusted, $why ) = <[base.host.trusted_file]>->($host_cfg);
if ( not $trusted ) {
    <[base.logs]>->(
        0,         ': host overlay %s REFUSED : %s [ nothing applied ]',
        $host_cfg, $why
    );
    return TRUE;
}

## a root-only overlay [ 0600 : web.auth.secret for httpd \ httpsd \ web ] ##
## is read at start-up, before the privilege drop. a reload after it can   ##
## not read it again : the start-up values stay in memory                  ##
## [ nothing here has a zenka default to fall back to ] -- keep them, not  ##
## an error                                                                ##
if ( not -r $host_cfg and <system.host_config.applied> ) {
    <[base.logs]>->(
        1, ': host overlay %s root-only : start-up values kept', $host_cfg
    );
    return TRUE;
}

<[base.logs]>->( 1, ': host overlay : %s', $host_cfg );

## remembered : base.reload_config applies the overlay again after the ##
## zenka's own keys, as at start-up [ else they win on a reload ]      ##
<system.host_config.applied> = TRUE;

return <[base.load_config_file]>->($host_cfg);

