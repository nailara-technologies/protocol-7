## [:< ##

# name  = powershell.cmd.notify-msg
# param = '<title>' '<message>'
# descr = native windows toast [ generic, p7 icon by default ]
#         pick a different one with a leading '::icon:<name>::' tag,
#         see powershell.icons

return <[powershell.notify_from_args]>->(
    {   'txt_param'    => $call->{'args'} // '',
        'default_icon' => qw| p7 |
    }
);

