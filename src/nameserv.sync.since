## [:< ##

# name  = nameserv.sync.since
# descr = build since \ full reply lines for one zone or the set
# param = $since_ts|undef, $zone_name|undef, $live_only -> ( line, .. )
#
# only signed records and tombstones are sent, as their STORED bytes
# [ 'ENTRY <body> <sig> <writer>' -- a relay never re-encodes ]. every
# writer in the reply gets one 'WRITER <id> <chain>' line ahead of the
# entries ; per zone 'CHECKSUM <zone> <checksum> <ts> <sig> <writer>',
# the checksum over the signed live records, signed by this host
# [ 'p7 sync-state v1' : attributes the claim, cannot prove completeness ].

my $since_ts  = shift;
my $zone_name = lc( shift // '' );
my $live_only = shift // FALSE;

my $zones = <nameserv.zones> // {};

my @zone_names = ();
if ( length $zone_name ) {
    return () if not exists $zones->{$zone_name};
    push @zone_names, $zone_name;
} else {
    @zone_names = sort keys %$zones;
}

my $max_entries = <nameserv.cfg.sync.max_entries_reply> // 7777;

my ( $own_id, $own_field ) = <[nameserv.sync.writer.own]>;
my $writers = <nameserv.sync.writers> // {};

my $newer = sub {
    my $ts = shift // '';
    return FALSE if not length $ts;
    return TRUE  if not defined $since_ts;    ## full : everything ##
    my $delta = <[base.ntime.delta_seconds]>->( $since_ts, $ts );
    return ( defined $delta and $delta > 0 ) ? TRUE : FALSE;
};

my ( @lines, %used ) = ();
my $count = 0;

for my $z_name (@zone_names) {
    my $zone = $zones->{$z_name} // next;

    my @signed = grep {
                ref $ARG eq qw| HASH |
            and defined $ARG->{'sig'}
            and defined $ARG->{'body'}
    } @{ $zone->{'records'} // [] };
    push @signed, grep {
                ref $ARG eq qw| HASH |
            and defined $ARG->{'sig'}
            and defined $ARG->{'body'}
    } @{ $zone->{'tombstones'} // [] }
        if not $live_only;

    for my $rec ( sort { $a->{'body'} cmp $b->{'body'} } @signed ) {
        next if not $newer->( $rec->{'deleted'} // $rec->{'ts'} );
        ## a relayed writer is only passed on while its chain is known ##
        my $writer = $rec->{'writer'} // next;
        next
            if $writer ne ( $own_id // '' )
            and ref $writers->{$writer} ne qw| HASH |;
        if ( $count++ >= $max_entries ) {
            ## never a silently cut reply : the receiver must not apply it ##
            return ( sprintf 'FALSE reply limit [ %d entries ]',
                $max_entries );
        }
        $used{$writer} = TRUE;
        push @lines, join ' ', qw| ENTRY |, $rec->{'body'}, $rec->{'sig'},
            $writer;
    }

    my $checksum = <[nameserv.zone.checksum]>->( $z_name, TRUE ) // '-';
    my $zone_ts  = <[nameserv.zone.timestamp]>->($z_name) // '-';
    my $state    = pack(
        'Z* n/a* n/a* n/a*',
        'p7 sync-state v1',
        $z_name, $checksum, $zone_ts
    );
    my $sig
        = defined $own_id
        ? <[crypt.C25519.sign_data]>->( \$state, qw| nameserv-sync | )
        : undef;
    push @lines, join ' ', qw| CHECKSUM |, $z_name, $checksum, $zone_ts,
        ( defined $sig ? ( <[base32.encode]>->($sig), $own_id ) : qw| - - | );
}

## the state lines are signed by this host : its WRITER line always ##
$used{$own_id} = TRUE if defined $own_id and defined $own_field;

my @writer_lines;
for my $writer ( sort keys %used ) {
    my $field
        = $writer eq ( $own_id // '' )
        ? $own_field
        : $writers->{$writer}{'field'};
    push @writer_lines, "WRITER $writer $field" if defined $field;
}

return ( @writer_lines, @lines );

