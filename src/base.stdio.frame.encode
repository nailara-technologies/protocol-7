## [:< ##

# name  = base.stdio.frame.encode
# descr = emit a typed-run frame sequence as a byte string
# param = $type_tag, $content_encoding, $payload, $header_fields_hashref

my ( $type_tag, $content_encoding, $payload, $header_fields_hashref ) = @ARG;

$header_fields_hashref //= {};

## [ tag lookup ] ##
my %tag_by_name = (
    qw| META | => 0b000,
    qw| SIN  | => 0b001,
    qw| RIN  | => 0b010,
    qw| EOUT | => 0b011,
    qw| TOUT | => 0b100,
    qw| NUM  | => 0b101,
    qw| STR  | => 0b110,
    qw| ERR  | => 0b111,
);

my $tag_val = $tag_by_name{$type_tag};
if ( not defined $tag_val ) {
    warn sprintf 'unknown type tag [ %s ] <{C1}>', $type_tag;
    return undef;
}

## [ encoding lookup ] ##
my %enc_by_name = (
    qw| b32       | => 0b00,
    qw| nibble    | => 0b01,
    qw| byte-pack | => 0b10,
);

my $enc_val = $enc_by_name{$content_encoding};
if ( not defined $enc_val ) {
    warn sprintf 'unknown content encoding [ %s ] <{C1}>', $content_encoding;
    return undef;
}

## [ prepare payload bytes ] ##
my $payload_bytes;

if ( $tag_val == 0b000 ) {    ## [ META run ] ##
    $payload_bytes = <[base.stdio.frame.encode.serialize_meta]>
        ->($header_fields_hashref);
} elsif ( $tag_val == 0b011 or $tag_val == 0b111 ) {
    ## [ EOUT or ERR — prepend fd index ] ##
    my $fd = $header_fields_hashref->{'fd'} // 0;
    $payload_bytes = pack( qw| C |, $fd ) . ( $payload // '' );
} else {
    $payload_bytes = $payload // '';
}

## [ encode payload into data frames ] ##
my @data_frames;

if ( $content_encoding eq qw| b32 | ) {
    @data_frames = <[base.stdio.frame.encode.encode_b32]>->($payload_bytes);
} elsif ( $content_encoding eq qw| nibble | ) {
    @data_frames
        = <[base.stdio.frame.encode.encode_nibble]>->($payload_bytes);
} elsif ( $content_encoding eq qw| byte-pack | ) {
    @data_frames
        = <[base.stdio.frame.encode.encode_byte_pack]>->($payload_bytes);
}

## [ build frame stream ] ##
my @frames;

## [ boundary META frame ] ##
push @frames, <[base.stdio.frame.encode.pack_nibble]>->( 0b000, 1 );

## [ fixed header — 4 frames, base-7 encoded ] ##
my $run_len = scalar @data_frames;
if ( $run_len > 63 ) {
    ## [ open-ended run for long payloads ] ##
    $run_len = 0;
}

my $header_value = ( ( $tag_val * 3 ) + $enc_val ) * 64 + $run_len;
my @header_frames;
for my $i ( 0 .. 3 ) {
    unshift @header_frames,
        <[base.stdio.frame.encode.pack_nibble]>->(
        ( $header_value % 7 ) + 1, 0
        );
    $header_value = int( $header_value / 7 );
}
push @frames, @header_frames;

## [ data frames ] ##
push @frames, $_ for @data_frames;

## [ if open-ended, inject closing META boundary ] ##
if ( $run_len == 0 and scalar @data_frames > 0 ) {
    push @frames, <[base.stdio.frame.encode.pack_nibble]>->( 0b000, 1 );
}

## [ pack nibbles into bytes ] ##
my $out = '';
for ( my $i = 0; $i < @frames; $i += 2 ) {
    if ( $i + 1 < @frames ) {
        $out .= chr( ( $frames[$i] << 4 ) | $frames[ $i + 1 ] );
    } else {
        $out .= chr( ( $frames[$i] << 4 ) | 0x1 );    ## [ pad with 001. ] ##
    }
}

return $out;

