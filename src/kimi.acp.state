## [:< ##

# name   = kimi.acp.state
# descr  = the acp adapter session state [ made on first use ]
# return = hash ref

## one `kimi acp` child per adapter session. phase : stopped, starting     ##
## [ handshake ], ready, prompting. the state lives under <kimi.acp.state> ##
## beside the config <kimi.acp.cfg.*>                                      ##
## [ permission, autostart, command, buffer ]  the child itself : a        ##
## stream_child handle under 'child'                                       ##

my $st = <kimi.acp.state>;
return $st if ref $st eq qw| HASH |;

return <kimi.acp.state> = {
    'phase'      => qw| stopped |,
    'pid'        => undef,
    'child'      => undef,
    'next_id'    => 0,
    'pending'    => {},
    'session_id' => undef,
    'caps'       => {},
    'queue'      => [],
    'events'     => [],
    'seq'        => 0,
    'turn'       => undef,
    'chunk'      => undef,
    'replay'     => FALSE,
    'stopping'   => FALSE,
    'started'    => undef,
    'json'       => undef
};

