## [:< ##

# name  = graphics-matrix.harmonic.coords
# descr = compute 3D voxel position from AMOS checksum offsets

my ( $input, $preset_id ) = @ARG;
$preset_id //= '';

return <[chk-sum.profile.calc]>->(
    length $preset_id
    ? "harmonic-slide.$preset_id"
    : qw| harmonic-slide |, $input
);

