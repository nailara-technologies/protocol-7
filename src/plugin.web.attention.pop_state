## [:< ##

# name  = plugin.web.attention.pop_state
# descr = pop the top state from the attention stack

return { qw| error | => qw| stack empty | }
    unless <web.attention.stack>->@* > 1;

pop <web.attention.stack>->@*;

my $top = <web.attention.stack>->[-1] // {};

<[base.log]>->(
    3, qq| attention pop_state: | . ( $top->{'name'} // qw| unknown | )
);

return {
    qw| name        | => ( $top->{'name'} // qw| ambient | ),
    qw| stack_depth | => scalar( <web.attention.stack>->@* ),
};

