# name  = index.cube.format.pack_dir_entry
# descr = pack a directory entry hashref into 16 bytes

my $entry = shift // $ARG;

return pack(
    <index.cube.format.pack.dir_entry>,
    $entry->{'data_offset'} // 0,
    $entry->{'data_size'}   // 0,
    $entry->{'child_count'} // 0,
    $entry->{'flags'}       // 0,
    $entry->{'chksum7'}     // "\x00" x 8,
);

