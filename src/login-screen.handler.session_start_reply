# name = login-screen.handler.session_start_reply
# descr = hide the greeter once the user session runs

my $reply = shift // {};
<login-screen.ticket> = undef;

if ( ( $reply->{'cmd'} // '' ) eq qw| TRUE | ) {
    <login-screen.state> = qw| session |;
    <login-screen.window>->hide();
    return TRUE;
}

<[login-screen.show_greeter]>;
<login-screen.widget.status>->set_text('session could not be started');
FALSE;

