## [:< ##

# name  = coding.mode.local_model_id
# descr = map a model pin to the id this host knows : '<path>:<content>',
#         ':<content>' or '<content>' -> the local '<path>:<content>' with
#         the same content half [ served first, then the registry ], else
#         the pin as given
# param = $model_id -> model id [ upper case ] | undef
# note  = the path half differs between hosts [ same file under another
#         parent dir ], the content half does not -- a repo pin written on
#         one host would else make every task switch away from the model
#         this host serves. known ids : the selected model, the cpu
#         backend's model_id and what the inference servers have loaded

my $model_id = uc( shift // '' );
return undef unless length $model_id;

my ( $path_part, $content_part )
    = $model_id =~ m|^(?:([A-Z2-7]{7}))?:?([A-Z2-7]{7})$|;
return $model_id unless defined $content_part;

my @known = grep { defined and length } map { uc( $ARG // '' ) } (
    <inference.model.amos_id>,
    <inference.backend.cpu.model_id>,
    map { ( $ARG // {} )->{'model'} }
        values %{ <coding.inference_servers> // {} }
);

## an exact id this host knows stays as it is ##
return $model_id if defined $path_part and grep { $ARG eq $model_id } @known;

foreach my $known_id (@known) {
    next unless $known_id =~ m|^[A-Z2-7]{7}:\Q$content_part\E$|;
    <[base.logs]>->(
        2,         '[local_model_id] %s -> %s [ same content ]',
        $model_id, $known_id
    ) if $known_id ne $model_id;
    return $known_id;
}

## not served right now : the registry knows the full id of every model on ##
## this host -- a content-only pin for a model that is not loaded would    ##
## else reach switch-model without its path half                           ##
my $metadata    = <coding.model_metadata> // {};
my @in_registry = sort { ( $b->[1] <=> $a->[1] ) or ( $a->[0] cmp $b->[0] ) }
    map {
    [ uc( $ARG->{'amos'} // '' ), ( $ARG->{'available'} // TRUE ) ? 1 : 0 ]
    }
    grep { uc( $ARG->{'amos'} // '' ) =~ m|^[A-Z2-7]{7}:\Q$content_part\E$| }
    grep { ref $ARG eq qw| HASH | } values %$metadata;

if (@in_registry) {
    <[base.logs]>->(
        2,         '[local_model_id] %s -> %s [ registry, same content ]',
        $model_id, $in_registry[0][0]
    ) if $in_registry[0][0] ne $model_id;
    return $in_registry[0][0];
}

return $model_id;

