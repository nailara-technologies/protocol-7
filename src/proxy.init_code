## [:< ##

# name  = proxy.init_code
# descr = initialize proxy zenka state, load selector config, start listener

$data{'proxy'}{'clients'}     //= {};
$data{'proxy'}{'listen_sock'} //= undef;
$data{'proxy'}{'auth_cache'}  //= {};

## load required perl modules ##
map { <[base.perlmod.autoload]>->($ARG) } qw| HTTP::Request URI YAML::XS |;

## ensure HTTP status codes are available ##
<protocol.http.status_codes> //= <[httpd.status_codes]>;

## load selector rules ##
<[proxy.selector.load]>;

## only the proxy zenka itself owns the listen socket — other zenki that    ##
## load the proxy module namespace [ e.g. cred-mesh, for subscribe_rotation ##
## side effect ] must not bind a duplicate SO_REUSEPORT listener on 8118    ##
my $is_proxy_zenka = ( <system.zenka.name> // '' ) eq qw| proxy |;

## start listener only once — not re-run on reinit ##
<[proxy.listen]>
    if $is_proxy_zenka and not defined $data{'proxy'}{'listen_sock'};

## close any stale listen sockets on our port (leaked from prior process ##
## runs)                                                                 ##
if ( $is_proxy_zenka and defined $data{'proxy'}{'listen_sock'} ) {
    my $good_fd   = fileno( $data{'proxy'}{'listen_sock'} );
    my $good_port = <proxy.cfg.listen_port> // 8118;
    if ( defined $good_fd and opendir my $dh, '/proc/self/fd' ) {
        for my $entry ( grep {m{^\d+$}} readdir $dh ) {
            my $fd = int($entry);
            next if $fd == $good_fd;
            my $target = readlink("/proc/self/fd/$fd") // '';
            next unless $target =~ m{^socket:};
            ## dup fd to inspect without risking close of original ##
            open( my $fh, '+<&', $fd ) or next;
            my $sa = getsockname($fh);
            close $fh;
            my $port = eval {
                defined $sa ? ( Socket::unpack_sockaddr_in($sa) )[0] : undef;
            };
            next unless defined $port and $port == $good_port;
            <[base.logs]>->(
                1, 'proxy: closing stale listen socket fd %d', $fd
            );
            POSIX::close($fd);
        }
        closedir $dh;
    }
}

## subscribe to credential rotation events -- cred-mesh is a separate zenka ##
## process with its own %data tree, so this must be a real cross-zenka      ##
## route, not a local <[...]> call (a local call here would register the    ##
## subscription into proxy's OWN data tree instead of the real cred-mesh    ##
## zenka's, and cred-mesh.rotate's push would never reach it). deferred via ##
## a short one-shot timer -- proxy's own cube session isn't established yet ##
## this early in init_code, so a synchronous route-send here silently finds ##
## no matching session                                                      ##
##
## proxy-only, like the listener block above -- other zenki that co-load ##
## the proxy module namespace must not run proxy's own subscribe timer   ##
<[event.add_timer]>->(
    {   'after'   => 0.5,
        'handler' => qw| proxy.handler.subscribe_rotation_deferred |,
    }
) if $is_proxy_zenka;

0;

