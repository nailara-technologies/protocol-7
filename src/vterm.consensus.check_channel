# name  = vterm.consensus.check_channel
# descr = check if sub-bit total has reached declaration threshold

my $total     = shift // 0;
my $threshold = <vterm.subbit.threshold>;

return qw| set   | if $total >= $threshold;
return qw| clear | if $total <= -$threshold;
return qw| superposition |;

