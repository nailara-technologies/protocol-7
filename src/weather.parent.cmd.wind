## [:< ##

# name  = weather.parent.cmd.wind
# descr = return current local wind speed and direction

my $stid = <weather.station_id>;

## first data still pending [ on-demand start ] : answer when it lands ##
my $parked = <[weather.parent.park_pending]>->( $call, qw| wind | );
return $parked if defined $parked;

my $current = <weather.data>->{$stid}->{'current'};

return {
    'mode' => qw| false |,
    'data' => 'no city selected [undefined station id]'
    }
    if not defined $stid;

my $wind = $current->{'wind'} // {};

my $speed = $wind->{'speed_kmh'} // 'n|a';
my $dir   = $wind->{'direction'} // 'n|a';

my $data;
if ( $speed =~ m{^\d+(\.\d+)?$} ) {
    $data = sprintf 'km|h: %03d', $speed;
    $data .= Encode::encode( 'UTF-8', " <-\N{DEGREE SIGN}" ) . $dir
        if $dir =~ m{^\d+(\.\d+)?$};
} else {
    $data = 'n|a';
}

return { 'mode' => qw| true |, 'data' => $data }

