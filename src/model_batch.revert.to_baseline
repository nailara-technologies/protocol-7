## [:< ##

# name  = model_batch.revert.to_baseline
# descr = revert steps 2+3 : restore changed, delete baseline-absent paths
# note  = safe by construction : capture step 1 already blob-stored
#         the content of every path this module overwrites or deletes
# param = { baseline => href, capture => href } -> TRUE | undef

my $params        = shift                 // {};
my $baseline_href = $params->{'baseline'} // {};
my $capture_href  = $params->{'capture'}  // {};

if ( ref $baseline_href ne qw| HASH | or !%$baseline_href ) {
    warn 'expected baseline manifest parameter <{C1}>';
    return undef;
}
if ( ref $capture_href ne qw| HASH | ) {
    warn 'expected capture result parameter <{C1}>';
    return undef;
}

my $root_path  = canonpath(<system.root_path>);
my $paths_href = $capture_href->{'paths'} // {};

for my $rel_path ( sort keys $paths_href->%* ) {
    my $pair_href = $paths_href->{$rel_path} // {};
    my $abs_path  = catfile( $root_path, split m|/|, $rel_path );

    if ( defined $pair_href->{'before'} ) {
        ## changed or task-deleted path : restore the baseline content from ##
        ## its blob [ a deleted baseline file used to stay deleted, and the ##
        ## reverify failed ]                                                ##
        if (!<[model_batch.blob.restore]>->(
                $pair_href->{'before'}, $abs_path
            )
        ) {
            warn sprintf(
                'revert failed [ %s : baseline blob missing ] <{C1}>',
                $rel_path );
            return undef;
        }
    } elsif ( exists $pair_href->{'after'} ) {
        ## baseline-absent path : delete -- recoverable, its content is ##
        ## already packed under its own checksum. a directory the zenka ##
        ## cannot write [ src/ : files there are created by the chmod   ##
        ## child, as the admin user ] : remove through the child too, a ##
        ## plain unlink fails silently and the reverify failed          ##
        if ( -f $abs_path and !unlink $abs_path ) {
            my $chmod_fh = <coding.chmod_child.w_fh>;
            if ( defined $chmod_fh ) {
                print {$chmod_fh} "remove $abs_path\n";
                <[coding.chmod_child.readline]>;
            }
        }
    }
}

return TRUE;

