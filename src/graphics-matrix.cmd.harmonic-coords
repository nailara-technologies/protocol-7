# name  = graphics-matrix.cmd.harmonic-coords
# descr = show 3D harmonic voxel coordinates for an input string
# param = <input-string>

my $input = $call->{'args'} // '';
return { 'mode' => 'false', 'data' => 'expected input string' }
    unless length $input;

my ( $x, $y, $z ) = <[graphics-matrix.harmonic.coords]>->( \$input );

my $out = sprintf "x: %s  y: %s  z: %s", $x, $y, $z;
$out .= '  [ y=z axis agreement ]' if $y eq $z;
$out .= '  [ x=y axis agreement ]' if $x eq $y;
$out .= '  [ x=z axis agreement ]' if $x eq $z;

return { 'mode' => 'size', 'data' => "$out\n" };

