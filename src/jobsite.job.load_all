## [:< ##

# name  = jobsite.job.load_all
# descr = load all active job records from status-directory storage

my $jobs_root = join qw| / |,
    <system.path.zenka-dirs>->{'var_P7'}, qw| jobsite jobs |;

my %jobs;
my $index = {};
my @active_statuses
    = qw| new assessed review apply applied interviewed rejected skipped |;

## also index blocked/deleted/trash for completeness, but don't load      ##
## content scanned FIRST : an orphaned terminal-state file left behind by ##
## an incomplete cleanup [ e.g. a rescue that didn't remove the old trash ##
## copy ] must never win over a legitimate active-status record for the   ##
## same id -- active statuses are scanned second and take priority below  ##
my @epoch_statuses = qw| blocked deleted |;
for my $status (@epoch_statuses) {
    my $dir = "$jobs_root/$status";
    next if not -d $dir;
    opendir my $dh, $dir or next;
    for my $epoch_dir ( grep { !m|^\.| && -d "$dir/$_" } readdir($dh) ) {
        opendir my $edh, "$dir/$epoch_dir" or next;
        for my $fn ( grep { m|\.yaml$| && !m|^\.| } readdir($edh) ) {
            my $enc_id = $fn;
            $enc_id =~ s|\.yaml$||;
            my $job_id = <[base.vax-int.decode]>->($enc_id);
            $index->{$job_id} = "$status:$epoch_dir";
        }
        closedir $edh;
    }
    closedir $dh;
}

## index compressed trash files [.yxz.B32] ##
my $trash_root = "$jobs_root/trash";
if ( -d $trash_root ) {
    opendir my $dh, $trash_root or goto TRASH_DONE;
    for my $epoch_dir ( grep { !m|^\.| && -d "$trash_root/$_" } readdir($dh) )
    {
        opendir my $edh, "$trash_root/$epoch_dir" or next;
        for my $fn ( grep { m|\.yxz\.B32$| && !m|^\.| } readdir($edh) ) {
            my $enc_id = $fn;
            $enc_id =~ s|\.yxz\.B32$||;
            my $job_id = <[base.vax-int.decode]>->($enc_id);
            $index->{$job_id} = "trash:$epoch_dir";
        }
        closedir $edh;
    }
    closedir $dh;
}
TRASH_DONE:

## active statuses scanned SECOND : wins on collision, see above ##
for my $status (@active_statuses) {
    my $dir = "$jobs_root/$status";
    next if not -d $dir;
    opendir my $dh, $dir or next;
    my @files = grep { m|\.yaml$| && !m|^\.| } readdir($dh);
    closedir $dh;

    for my $file (@files) {
        my $enc_id = $file;
        $enc_id =~ s|\.yaml$||;
        my $job_id = <[base.vax-int.decode]>->($enc_id);

        my $job_file = catfile( $dir, $file );
        my $job      = eval { YAML::XS::LoadFile($job_file) };
        if ($EVAL_ERROR) {
            <[base.logs]>->(
                0,         'jss.load_all: error loading %s: %s',
                $job_file, <[base.str.eval_error]>
            );
            next;
        }
        next unless ref $job eq 'HASH';
        $jobs{$job_id} = $job;
        $index->{$job_id} = $status;
    }
}

<jobsite.job.index> = $index;

<[base.logs]>->(
    2,
    'jss.load_all: loaded %d active jobs, index=%d',
    scalar keys %jobs,
    scalar keys $index->%*
) if scalar keys %jobs;

## populate in-memory task map from loaded job YAMLs ##
##
## an in-flight marker ['queued'/'assessing'] only ever exists in memory -- ##
## a still-'new' job on disk has no 'stage' field yet, so refreshing stage  ##
## unconditionally from the file wipes the marker dispatch.assessments just ##
## set, moments before the task it dispatched even replies. that defeats    ##
## dispatch.assessments' own "already in flight" skip-check, so a           ##
## re-entrant call [ settle-timer, or any repeat call while a batch is      ##
## running ] queues the same job again -- keep the in-flight marker,        ##
## refresh everything else                                                  ##
for my $id ( keys %jobs ) {
    my $job           = $jobs{$id};
    my $prior_stage   = ( <jobsite.tasks>->{$id} // {} )->{'stage'} // '';
    my $keep_inflight = $prior_stage =~ m{^(?:queued|assessing)$};
    ## queue_gen only ever exists in memory too, same reasoning as the    ##
    ## in-flight stage marker above -- it has no on-disk field to refresh ##
    ## from, so it must be carried over explicitly or dispatch.next's     ##
    ## staleness check [ see dispatch.next ] loses track of it on every   ##
    ## single sync cycle and starts treating the current entry as stale   ##
    my $prior_gen = ( <jobsite.tasks>->{$id} // {} )->{'queue_gen'} // 0;
    ## attempt token [ see dispatch.next/dispatch.repair ] : same reasoning ##
    ## as queue_gen above -- carry it forward or a re-entrant load_all call ##
    ## while a task.create/task.wait-done round trip is in flight makes the ##
    ## real reply's attempt param mismatch the freshly-wiped value and get  ##
    ## dropped as "stale"                                                   ##
    my $prior_attempt = ( <jobsite.tasks>->{$id} // {} )->{'attempt'} // 0;
    ## task_id / repair_task_id : memory-only markers used by the startup   ##
    ## re-wire pass and the watchdog's timeout cleanup ; same carry-forward ##
    ## reasoning                                                            ##
    my $prior_task_id = ( <jobsite.tasks>->{$id} // {} )->{'task_id'} // '';
    my $prior_repair_task_id
        = ( <jobsite.tasks>->{$id} // {} )->{'repair_task_id'} // '';
    <jobsite.tasks>->{$id} = {
        'status' => $job->{'status'} // 'new',
        'stage'  => $keep_inflight ? $prior_stage : ( $job->{'stage'} // '' ),
        'queue_gen'        => $prior_gen,
        'attempt'          => $prior_attempt,
        'task_id'          => $prior_task_id,
        'repair_task_id'   => $prior_repair_task_id,
        'score'            => $job->{'score'}            // '',
        'repair_attempted' => $job->{'repair_attempted'} // FALSE,
        'repair_failed'    => $job->{'repair_failed'}    // FALSE,
    };
}

## directory name is the authoritative status ##
my $tasks = <jobsite.tasks> // {};
for my $id ( keys $tasks->%* ) {
    my $dir_status = $index->{$id} // '';
    ## strip epoch prefix for blocked/deleted ##
    $dir_status =~ s{^(blocked|deleted):.*}{$1};
    $tasks->{$id}{'status'} = $dir_status if length $dir_status;
}

return \%jobs;

