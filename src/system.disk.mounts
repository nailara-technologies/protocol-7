## [:< ##

# name  = system.disk.mounts
# descr = mounted local file systems [ pseudo and network types excluded ]

my @mounts;
my %pseudo = map { $ARG => TRUE } qw|
    proc sysfs devpts devtmpfs tmpfs securityfs cgroup cgroup2 pstore debugfs
    tracefs configfs fusectl hugetlbfs mqueue binfmt_misc autofs overlay
    efivarfs bpf rootfs rpc_pipefs nfs nfs4 cifs smbfs ceph fuse.sshfs
    |;

my $mounts_path = shift // qw| /proc/self/mounts |;
open( my $fh, '<', $mounts_path )
    or return
    <[base.logs]>->( 1, 'disk watch : cannot read mounts : %s', $OS_ERROR );
while ( my $line = <$fh> ) {
    my ( $device, $path, $type ) = split m|\s+|, $line;
    next if not defined $type;
    next
        if $pseudo{$type}
        and not( $type eq qw| tmpfs |
        and <[base.cfg_bool]>->(<disk.include_tmpfs>) );
    $path =~ s|\\([0-7]{3})|chr( oct $1 )|eg;
    push @mounts,
        {
        qw| device | => $device,
        qw| path |   => $path,
        qw| type |   => $type
        };
}
close $fh;
return \@mounts;

