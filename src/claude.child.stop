## [:< ##

# name   = claude.child.stop
# descr  = end the child : stdin closed, TERM, KILL later
# return = TRUE when a child was asked to end

## the stop steps of the stream_child : close TERM, then KILL on a ##
## claude-stop timer when it is still there                        ##

my $child = <claude.child>;
return FALSE if not defined $child or not defined $child->{'out'};
return <[stream_child.stop]>->($child);

