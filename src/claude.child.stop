## [:< ##

# name   = claude.child.stop
# descr  = end the child : stdin closed, TERM, KILL later
# return = TRUE when a child was asked to end

## closing stdin ends a stream-json session by itself ; TERM is sent too, a ##
## claude-stop timer sends KILL when it is still there                      ##

my $child = <claude.child>;
return FALSE if not defined $child or not defined $child->{'out'};
$child->{'stopping'} = TRUE;
if ( defined $child->{'in'} ) {
    <[event.del_io]>->( delete $child->{'w_in'} ) if defined $child->{'w_in'};
    CORE::close( $child->{'in'} );
    $child->{'in'} = undef;
}
CORE::kill( 'TERM', -$child->{'pid'} );
<[claude.event.add]>->( qw| stop |, "pid $child->{'pid'} : TERM" );
my $delay = <[base.interval.next]>->(
    {   'type'  => qw| claude-stop |,
        'state' => ( $child->{'stop_state'} //= {} )
    }
);
<[event.add_timer]>->(
    {   'after'   => $delay // 3,
        'handler' => qw| claude.handler.stop_kill |,
        'data'    => { 'pid' => $child->{'pid'} }
    }
);
return TRUE;

