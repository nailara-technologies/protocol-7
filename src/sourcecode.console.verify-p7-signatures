## [:< ##

# name  = sourcecode.console.verify-p7-signatures
# descr = verify source code signature sections

my $command_params = shift // '';

my $verify_verbosity = 2;           ## [ 0 | 1 | 2 ] ##
my $verify_mode      = 'strict';    ## [ 'strict', 'repair' ] ##

$verify_verbosity = 0
    if $command_params =~ s| *:verify-silent: *| |
    or exists $ENV{'VERIFY_SILENT'}
    and <[base.cfg_bool]>->( $ENV{'VERIFY_SILENT'} ) == TRUE;

# Parse repair mode flag from command
if ( $command_params =~ s| *:repair-mode: *| |i ) {
    $verify_mode = 'repair';
    <[base.log]>->(
        1, ': running in repair mode (will not fail on fixable issues)'
    );
}

## :workers=N: overrides the parallel-worker count [ default : auto, based ##
## on cpu count -- 'strict' mode only, see below. :workers=1: forces the   ##
## plain sequential path                                                  ##
my $workers_override;
$workers_override = $1
    if $command_params =~ s| *:workers=(\d+): *| |;
$command_params =~ s,^ *| *$,,;

my $signature_key_name = qw| proto-7.sourcecode |;

### needs passphrase for implicit secret key loading ###
##
## <[source.load_signature_key]>->($signature_key_name);

### LOADING PUBLIC KEY FROM DATA BLOCK IN bin/Protocol-7 ##
## [ - silent - no passphrase required. ]
##
<[crypt.C25519.load_from_string]>->(
    $signature_key_name, <[protocol-7.source-key]>
);
###

# For verification, we only need the public key
if (   not exists $keys{'C25519'}{$signature_key_name}
    or not exists $keys{'C25519'}{$signature_key_name}->{'public'} ) {
    <[base.logs]>->(
        0, "source signature public key '%s' not loaded, aborting..,",
        $signature_key_name
    );
    <[base.exit]>->(qw| 0110 |);
}

my $source_version  = <protocol-7.src-ver>;
my $release_version = <protocol-7.rel-ver>;

my $paths     = <sourcecode.path>;    # <-- prepared in 'sourcecode.init_code'
my $work_tree = $paths->{'work_tree'};

my @source_paths;

if ( length $command_params ) {
    if ( not @source_paths
        = <[base.source.collect_file_list]>->($command_params) ) {
        <[base.logs]>->( 0, ": no files found for '%s'", $command_params );
        <[base.exit]>;
    } else {
        my $file_count = scalar @source_paths;
        <[base.logs]>->(
            ": %d file%s match%s '%s'",
            $file_count,
            <[base.cnt_s]>->($file_count),
            <[base.cnt_s]>->( $file_count, '', 'es' ),
            <[base.parser.ellipse_center]>->( $command_params, 19 )
        );
    }
} else {
    @source_paths = <[sourcecode.source_path_set_up]>;
}

if (   @source_paths == 0
    or @source_paths == 1 and not defined $source_paths[0] ) {
    <[base.log]>->(
        0, 'no matching source files, cannot verify signatures..,'
    );
    <[base.exit]>->('0110');
}

<[base.log]>->( 1, '.:[ VERIFYING SOURCE SIGNATURES ]:.' );

my $valid_count         = 0;
my $invalid_count       = 0;
my $repair_needed_count = 0;
my $file_count          = scalar @source_paths;

<[base.logs]>->( '* verifying %s source file signatures..,', $file_count );

## 'repair' mode writes files -- always run it as a single, sequential   ##
## shard, unchanged behaviour. 'strict' mode never writes anything, so   ##
## it's safe to fan it out across workers with no race-safety design     ##
## needed at all [ unlike sourcecode.console.update-signatures, which    ##
## does write and needed the TOCTOU-guard + result-file + kill-list      ##
## machinery -- copied here verbatim for the orchestration shape only ]  ##
my $workers = 1;

if ( $verify_mode eq 'strict' ) {
    $workers = $workers_override;
    if ( not defined $workers ) {
        $workers = 1;
        my $parallel_verify_threshold   = 200;
        my $parallel_verify_max_workers = 8;
        if ( $file_count >= $parallel_verify_threshold ) {
            my $cpu_count = 0;
            my $cpuinfo;
            if ( <[file.slurp]>->( '/proc/cpuinfo', \$cpuinfo ) ) {
                $cpu_count++ while $cpuinfo =~ m|^processor\s*:|mg;
            }
            $workers = $cpu_count > 1 ? $cpu_count : 1;
            $workers = $parallel_verify_max_workers
                if $workers > $parallel_verify_max_workers;
        }
    }
    $workers = 1           if $workers < 1;
    $workers = $file_count if $workers > $file_count;
}

if ( $workers <= 1 ) {

    my $result_href = <[sourcecode.verify_file_list]>->(
        \@source_paths, $work_tree, $verify_verbosity,
        $verify_mode,   $signature_key_name
    );

    $valid_count         = $result_href->{'valid_count'};
    $invalid_count       = $result_href->{'invalid_count'};
    $repair_needed_count = $result_href->{'repair_needed_count'};

} else {

    <[base.logs]>->( 2, ': verifying with %d parallel workers..,', $workers );

    my @shards   = map { [] } 1 .. $workers;
    my $shard_ix = 0;
    foreach my $path_rel (@source_paths) {
        push $shards[ $shard_ix % $workers ]->@*, $path_rel;
        $shard_ix++;
    }

    my $run_tag = sprintf( qw| %d-%d |, $PID, time() );
    my @worker_pid;
    my @worker_result_file;

    foreach my $w ( 0 .. $#shards ) {

        my $result_file
            = sprintf( qw| /tmp/p7-sourcecode-verify.%s.w%d.tmp |, $run_tag,
            $w );

        my $pid = <[base.fork]>;

        if ( not defined $pid ) {
            <[base.logs]>->( 0, ':E: fork failed for worker %d <{C1}>', $w );
            <[base.exit]>->(
                qw| 0110 |, 'aborting signature verify, fork failed', 0
            );
        }

        if ( $pid == 0 ) {    ## child : verify this shard, report, exit ##

            my $result_href = <[sourcecode.verify_file_list]>->(
                $shards[$w], $work_tree, $verify_verbosity,
                $verify_mode, $signature_key_name, $w
            );

            <[file.put]>->(
                $result_file,
                sprintf(
                    "DONE\t%d\t%d\t%d\n",
                    $result_href->{'valid_count'},
                    $result_href->{'invalid_count'},
                    $result_href->{'repair_needed_count'}
                )
            );

            <[base.exit]>->(
                0,
                sprintf(
                    'worker %d done, %d valid, %d invalid',
                    $w, $result_href->{'valid_count'},
                    $result_href->{'invalid_count'}
                ),
                2
            );
        }

        push( <system.kill_list>->@*, $pid );
        push @worker_pid,         $pid;
        push @worker_result_file, $result_file;
    }

    my %pending = map { $ARG => 1 } 0 .. $#worker_pid;
    my %crashed;

    while ( keys %pending ) {
        foreach my $w ( <[base.sort]>->( keys %pending ) ) {

            my $report;
            <[file.slurp]>->( $worker_result_file[$w], \$report )
                if -f $worker_result_file[$w];

            if ( defined $report
                and $report =~ m|^DONE\t(\d+)\t(\d+)\t(\d+)|m ) {
                $valid_count         += $1;
                $invalid_count       += $2;
                $repair_needed_count += $3;
                delete $pending{$w};
            } elsif ( not kill( 0, $worker_pid[$w] ) ) {
                $crashed{$w} = TRUE;
                delete $pending{$w};
            }
        }

        if ( keys %pending ) {
            <[event.once]>;    ## keep SIGINT responsive [ safe : parent ##
                                ## process, not a forked child ]         ##
            select( undef, undef, undef, 0.1 );
        }
    }

    my %spawned_pid = map { $ARG => TRUE } @worker_pid;
    <system.kill_list>->@*
        = grep { not $spawned_pid{$ARG} } <system.kill_list>->@*;
    unlink grep {-f} @worker_result_file;

    if (%crashed) {
        <[base.logs]>->(
            0,
            ':E: worker%s %s crashed mid-verify -- treating as invalid',
            <[base.cnt_s]>->( scalar keys %crashed ),
            join( ', ', <[base.sort]>->( keys %crashed ) )
        );
        $invalid_count += scalar keys %crashed;    ## fail closed, not open ##
    }
}

# Final summary
<[base.log]>->( 0, qw| : | ) if $invalid_count;

## repaired/reconstructed counts are only ever displayed below in repair ##
## mode -- skip the extra full-corpus re-read pass entirely in strict    ##
## mode [ it always ran before, on every commit, computing numbers that  ##
## strict mode's own summary branch never even looks at ]                ##
my $repaired_count      = 0;
my $reconstructed_count = 0;
if ( $verify_mode eq 'repair' ) {
    foreach my $path_rel (@source_paths) {
        my $path_abs = catfile( $work_tree, $path_rel );
        next
            if not defined
            <[file.slurp]>->( $path_abs, \my $src_str, qw| :raw | );
        my $footer_data = <[source.extract_sig_body]>
            ->( \$src_str, qw| strip |, $verify_mode );
        $repaired_count++
            if $footer_data->{'repaired'} && !$footer_data->{'reconstructed'};
        $reconstructed_count++ if $footer_data->{'reconstructed'};
    }
}

if ( $verify_mode eq 'repair' ) {
    if ( $repaired_count > 0 || $reconstructed_count > 0 ) {
        <[base.logs]>->(
            1,
            ':.: %d valid (%d repaired, %d reconstructed), '
                . '%d invalid, %d need repair [total: %d]',
            $valid_count,
            $repaired_count,
            $reconstructed_count,
            $invalid_count,
            $repair_needed_count,
            $file_count
        );
    } elsif ( $repair_needed_count > 0 ) {
        <[base.logs]>->(
            1, ':.: %d valid, %d invalid, %d need repair [total: %d]',
            $valid_count, $invalid_count, $repair_needed_count, $file_count
        );
    } else {
        <[base.logs]>->(
            1, ':.: %d valid, %d invalid signatures [total: %d]',
            $valid_count, $invalid_count, $file_count
        );
    }
} else {
    <[base.logs]>->(
        1, ':. %d files .: signed valid : %d, re-sign : %d',
        $file_count, $valid_count, $invalid_count
    );
}
<[base.log]>->( 1, $invalid_count == 0 ? ':.  .    .     .' : qw| . | );

# Exit with count of invalid signatures (0 = success)
<[base.exit]>->( sprintf( '%04d', $invalid_count ) );

