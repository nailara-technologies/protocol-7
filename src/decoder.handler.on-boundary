## [:< ##

# name  = decoder.handler.on-boundary
# descr = Handle harmonic convergence boundary : close level buffers, log, INDEXCUBE

my $args_str
    = ref( $ARG[0] ) eq 'HASH' ? $ARG[0]->{'args'} : ( $ARG[0] // '' );
my ( $stream_id, $boundary_value ) = split m| +|, $args_str, 2;

$stream_id      //= 'unknown';
$boundary_value //= 769230;

<decoder.boundary_count>++;
my $boundary_n = <decoder.boundary_count>;

## close all level buffers for this stream ##
for my $level_name (qw| level-5-B32 level-6-D3 |) {
    if ( exists $data{'buffer'}{$level_name} ) {
        $data{'buffer'}{$level_name}{'state'} = 'closed';
    }
}

## reset per-stream accumulators to prevent fragment bleed across boundary ##
<decoder.level5>->{$stream_id}{'accumulator'} = ''
    if exists <decoder.level5>->{$stream_id};
<decoder.level5>->{$stream_id}{'bit_count'} = 0
    if exists <decoder.level5>->{$stream_id};
<decoder.level6>->{$stream_id}{'accumulator'} = ''
    if exists <decoder.level6>->{$stream_id};

## log boundary event ##
<[base.logs]>->(
    2, "decoder boundary #%d : stream %s at convergence root [ %s ]",
    $boundary_n, $stream_id, $boundary_value
);

## fetch P7REF from zulum for this stream ##
my $stream_status
    = <[zulum.cmd.stream-status]>->( { 'stream_id' => $stream_id } );
my $p7ref = "STREAM:UNKNOWN:XXXXXX";
if ( $stream_status->{'mode'} eq 'size' ) {
    ($p7ref) = $stream_status->{'data'} =~ m|^p7ref\s+:\s+(\S+)|m;
    $p7ref //= "STREAM:PARSE_ERROR:XXXXXX";
}

## push stream coordinate onto INDEXCUBE traversal log ##
<decoder.INDEXCUBE> //= [];
push @{<decoder.INDEXCUBE>},
    {
    'stream_id'      => $stream_id,
    'boundary_value' => $boundary_value + 0,
    'boundary_n'     => $boundary_n,
    'p7ref'          => $p7ref,
    'timestamp'      => <[base.ntime]>,
    'depth'          => scalar @{<decoder.INDEXCUBE>},
    };

<[base.logs]>->(
    2,
    "INDEXCUBE depth %d : stream %s [%s] traversal recorded",
    scalar( @{<decoder.INDEXCUBE>} ),
    $stream_id, $p7ref
);

return { 'mode' => qw| true |, 'data' => "boundary $boundary_n recorded" };

