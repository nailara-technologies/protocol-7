## [:< ##

# name  = nameserv.sync.client.process
# descr = run one complete sync pull reply through the state machine

my $state = shift // return;
my $lines = shift // return;

if ( $state->{'phase'} eq qw| last-ts | ) {
    my $line = shift @$lines;
    if ( $line =~ m|^FALSE (.+)$| ) {
        <[nameserv.sync.client.finish]>->(
            $state, { mode => qw| false |, data => $1 }
        );
        return;
    }
    return <[nameserv.sync.client.finish]>->(
        $state, { mode => qw| false |, data => 'unexpected last-ts reply' }
    ) if $line !~ m|^TRUE (\S+)(?: (\S+))?$|;

    my $peer_ts = $1;

    ## the cursor is the PEER's ts at the last successful pull from it -- ##
    ## never the local ts                                                 ##
    ## [ a newer local change would hide the peer's older, unseen ones ]  ##
    my $cursor_key = sprintf '%s:%s %s', $state->{'host'}, $state->{'port'},
        $state->{'target'} // '*';
    my $cursor = <nameserv.sync.cursor>->{$cursor_key};
    $state->{'peer_ts'}    = $peer_ts;
    $state->{'cursor_key'} = $cursor_key;
    if ( defined $cursor and $cursor eq $peer_ts ) {
        return <[nameserv.sync.client.finish]>->(
            $state,
            {   mode => qw| true |,
                data => 'already current',
                ts   => $peer_ts
            }
        );
    }
    my $since_ts = $cursor // <[nameserv.sync.ts-oldest]>;
    my $request
        = length( $state->{'target'} // '' )
        ? "since $since_ts $state->{'target'}\n"
        : "since $since_ts\n";
    syswrite $state->{'sock'}, $request;
    $state->{'phase'} = qw| since |;
    return TRUE;
}

## since / full replies : multi-line, ends with '.' ##
my $result = <[nameserv.sync.client.apply_reply]>->( $state, $lines );

if ( $result->{'result'} eq qw| ok | ) {
    ## the next pull from this peer starts here ##
    <nameserv.sync.cursor>->{ $state->{'cursor_key'} } = $state->{'peer_ts'}
        if defined $state->{'cursor_key'} and defined $state->{'peer_ts'};
    my $target
        = length( $state->{'target'} // '' )
        ? $state->{'target'}
        : 'the set';
    <[nameserv.sync.client.finish]>->(
        $state,
        {   mode => qw| true |,
            data => sprintf 'synced %s [ %d entries ]',
            $target, $result->{'applied'} // 0
        }
    );
} elsif ( $result->{'result'} eq qw| need-full | ) {
    my $zone = shift @{ $result->{'mismatched'} };
    syswrite $state->{'sock'}, "full $zone\n";
    $state->{'full_zone'} = $zone;
    $state->{'phase'}     = qw| full |;
} else {
    <[nameserv.sync.client.finish]>->(
        $state,
        {   mode => qw| false |,
            data => $result->{'reason'} // 'sync failed'
        }
    );
}

return TRUE;

