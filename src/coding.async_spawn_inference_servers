## [:< ##

# name  = coding.async_spawn_inference_servers
# descr = spawn inference servers asynchronously
# purpose = Start GPU and CPU inference servers without blocking zenka
#           initialization

## await_resources owns the spawn during :twin: handover — skip if set ##
if (<coding.awaiting_resources>) {
    <[base.logs]>->(
        1, ': async_spawn : awaiting_resources flag set : spawn blocked :'
    );
    return FALSE;
}

<[base.logs]>->( 1, ": starting inference servers asynchronously" );

## check system memory before spawning [ prevents oom conditions ]
my $mem_pct = <coding.system_mem_pct> // 0;
<[base.logs]>->( 2, ": system memory usage :. %.2f%% used", $mem_pct );

## abort if memory critically constrained  [ system will kill largest consumer
## at limit ]
if ( $mem_pct >= 90 ) {
    <[base.logs]>->(
        0, ": system memory at %.2f%% - skipping inference server spawn",
        $mem_pct
    );
    return FALSE;
}

# Get spawn parameters
my $spawn_params = <coding.spawn_params> // {};

if ( not keys $spawn_params->%* ) {
    warn 'expected spawn parameters not found [cannot start server]';
    return FALSE;
}

## tracks whether anything below failed or deferred : FALSE return when any ##
## enabled backend still needs a later retry/retrigger, TRUE only when      ##
## nothing needed spawning or everything spawned successfully               ##
my $spawn_ok = TRUE;

## gpu and cpu blocks below are deliberately independent : neither may  ##
## short-circuit the other, each re-checks its own <inference.{gpu,cpu} ##
## _pid> guard on every call, so re-entry [ deferred timer,             ##
## model_path_reply retrigger, backoff retry ] is always safe           ##

# Spawn GPU server if enabled and not already running
if ( $spawn_params->{'gpu_enabled'} and not <inference.gpu_pid> ) {
    my $gpu_port   = <inference.backend.gpu.port>    // 8000;
    my $gpu_model  = $spawn_params->{'gpu_model_id'} // qw|gemma3-glitter-4b|;
    my $gpu_binary = $spawn_params->{'gpu_binary'}
        // '/data/source/ik_llama.cpp/llama-server-cuda-fa';
    my $gpu_layers = $spawn_params->{'gpu_layers'} // 33;

    my $gpu_resolve = <[coding.helper.resolve_model_checksum]>
        ->( { model_name => $gpu_model } );
    my $gpu_amos_id = $gpu_resolve->{'amos_id'} // '';

    # Get model path (resolved earlier in startup after network connect)
    my $model_path = <inference.model.path> // undef;

    ## gated on the model_path dependency [ coding.init_dependencies ]    ##
    ## rather than just re-checking the raw flag directly : this is what  ##
    ## triggers the resolve hook [ coding.resolve.object.model_path ->    ##
    ## coding.resolve_model_path ] when unresolved, instead of silently   ##
    ## failing and relying entirely on a separate, bespoke catch-up check ##
    ## in coding.handler.model_path_reply. this deferred-timer's own 0.5s ##
    ## delay is a best-effort nudge, not a real wait, so hitting this     ##
    ## branch is the COMMON path whenever the models zenka needs any      ##
    ## cold-start time at all - not a failure, hence level 1 not 0 [      ##
    ## confirmed live 2026-08-26 ]  checking dependency.ok on the ROOT [  ##
    ## spawn_ready_gpu ], not model_path_gpu directly -- dependency.ok(X) ##
    ## only checks X's OWN chain members' callbacks, it never invokes X's ##
    ## own type callback. a standalone object with no chain of its own    ##
    ## would trivially always read "ok" here. dependency.ok(undef) also   ##
    ## fails OPEN [ returns TRUE, its own "no dependency" convention ] -- ##
    ## keep the raw check too so a broken init-order edge case [          ##
    ## coding.dep.spawn_ready_gpu never set up ] can't let a              ##
    ## genuinely-unset $model_path slip through to the spawn call below   ##
    unless (defined $model_path
        and length $model_path
        and <[dependency.ok]>->(<coding.dep.spawn_ready_gpu>) ) {
        <[base.logs]>->(
            1,
            ': gpu model path not yet resolved - deferring '
                . 'gpu spawn until model_path_reply arrives'
        );
        $spawn_ok = FALSE;
    } else {
        <[base.logs]>->(
            1,         ": spawning GPU server on port %d for %s",
            $gpu_port, $gpu_model
        );

        ## spawn_inference_server owns the spawning_in_progress guard ##
        my $gpu_result = <[coding.spawn_inference_server]>->(
            {   'backend'     => 'gpu',
                'binary'      => $gpu_binary,
                'port'        => $gpu_port,
                'model_path'  => $model_path,
                'mmproj_path' => <inference.model.mmproj_path> // '',
                'gpu_layers'  => $gpu_layers,
                'amos_id'     => $gpu_amos_id
            }
        );

        if ( $gpu_result->{'success'} ) {
            <[base.logs]>->(
                1, ": GPU server spawned [pid=%d] - monitoring startup",
                $gpu_result->{'pid'}
            );
            <inference.gpu_port>           = $gpu_port;
            <inference.gpu_pid>            = $gpu_result->{'pid'};
            <coding.spawn_retry_count_gpu> = 0;
        } else {
            my $retries = ( <coding.spawn_retry_count_gpu> //= 0 );
            <coding.spawn_retry_count_gpu>++;
            my $delay = 2**$retries;
            $delay = 120 if $delay > 120;    ## cap at 2 minutes ##
            <[base.logs]>->(
                0,
                'GPU server spawn failed (attempt '
                    . '%d) — retrying in %.0fs: %s',
                $retries + 1,
                $delay,
                $gpu_result->{'error'}
            );
            <[event.add_timer]>->(
                {   'after'   => $delay,
                    'handler' => qw| coding.handler.spawn_servers_deferred |
                }
            );
            $spawn_ok = FALSE;    ## gpu spawning not successful ##
        }
    }
}

# Spawn CPU server if enabled and not already running [ mirrors the GPU
# block above, minus gpu_layers/mmproj_path which are gpu-only params ]
if ( $spawn_params->{'cpu_enabled'} and not <inference.cpu_pid> ) {
    my $cpu_port   = <inference.backend.cpu.port> // 8001;
    my $cpu_binary = $spawn_params->{'cpu_binary'}
        // '/data/source/ik_llama.cpp/llama-server-cpu';
    my $cpu_threads = $spawn_params->{'cpu_threads'}  // 7;
    my $cpu_model   = $spawn_params->{'cpu_model_id'} // '';

    my $cpu_resolve = <[coding.helper.resolve_model_checksum]>
        ->( { model_name => $cpu_model } );
    my $cpu_amos_id = $cpu_resolve->{'amos_id'} // '';

    ## cpu-specific resolved path first, falling back to the shared       ##
    ## <inference.model.path> [ common case : one model file serving both ##
    ## backends ]                                                         ##
    my $cpu_model_path = <inference.backend.cpu.path>
        // <inference.model.path> // undef;

    ## same dependency-gated pattern as gpu, on the cpu root [ see the gpu  ##
    ## block's comment for why the raw check stays alongside dependency.ok, ##
    ## and why the ROOT is checked rather than model_path_cpu directly ]    ##
    unless (defined $cpu_model_path
        and length $cpu_model_path
        and <[dependency.ok]>->(<coding.dep.spawn_ready_cpu>) ) {
        <[base.logs]>->(
            1,
            ': cpu model path not yet resolved - deferring '
                . 'cpu spawn until model_path_reply arrives'
        );
        $spawn_ok = FALSE;
    } else {
        <[base.logs]>->(
            1,         ": spawning CPU server on port %d [%d threads]",
            $cpu_port, $cpu_threads
        );

        ## spawn_inference_server owns the spawning_in_progress guard ##
        my $cpu_result = <[coding.spawn_inference_server]>->(
            {   'backend'    => 'cpu',
                'binary'     => $cpu_binary,
                'port'       => $cpu_port,
                'model_path' => $cpu_model_path,
                'threads'    => $cpu_threads,
                'amos_id'    => $cpu_amos_id
            }
        );

        if ( $cpu_result->{'success'} ) {
            <[base.logs]>->(
                1, ": CPU server spawned [pid=%d] - monitoring startup",
                $cpu_result->{'pid'}
            );
            <inference.cpu_port>           = $cpu_port;
            <inference.cpu_pid>            = $cpu_result->{'pid'};
            <coding.spawn_retry_count_cpu> = 0;
        } else {
            my $retries = ( <coding.spawn_retry_count_cpu> //= 0 );
            <coding.spawn_retry_count_cpu>++;
            my $delay = 2**$retries;
            $delay = 120 if $delay > 120;    ## cap at 2 minutes ##
            <[base.logs]>->(
                0,
                'CPU server spawn failed (attempt '
                    . '%d) — retrying in %.0fs: %s',
                $retries + 1,
                $delay,
                $cpu_result->{'error'}
            );
            <[event.add_timer]>->(
                {   'after'   => $delay,
                    'handler' => qw| coding.handler.spawn_servers_deferred |
                }
            );
            $spawn_ok = FALSE;    ## cpu spawning not successful ##
        }
    }
}

if ($spawn_ok) {
    <[base.logs]>->( 1, ": inference server spawning complete" );
    return TRUE;
}

return FALSE;

