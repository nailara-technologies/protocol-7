## [:< ##

# name  = coding.self_test.cmd.self-test-detail
# descr = show full per-prompt self-test detail + tier1 attempts

my $params   = shift // {};
my $model_id = $params->{'args'} // $params->{'model_id'} // '';

$model_id = <inference.model.amos_id> // '' if !length $model_id;

return {
    mode => qw| false |,
    data => 'usage: coding.self-test-detail '
        . '[model_id] (no model currently loaded)'
    }
    if !length $model_id;

my $self_test = <coding.self_test> // {};

## find latest ntime that has a record for this model ##
my $last_ntime = 0;
for my $ntime ( keys %$self_test ) {
    next                 if !exists $self_test->{$ntime}{$model_id};
    $last_ntime = $ntime if $ntime > $last_ntime;
}

return {
    mode => qw| size |,
    data => "no self-test record found for $model_id\n"
    }
    if !$last_ntime;

my $store   = $self_test->{$last_ntime}{$model_id};
my $prompts = $store->{'prompts'} // {};

my @lines;
push @lines, sprintf "self-test detail : %s : ntime %s\n", $model_id,
    $last_ntime;

## durable cross-restart stats [ coding.self_test.archive ] - separate from ##
## the ntime-scoped detail above, which resets every restart. this is the   ##
## actual answer to "how many retries does this model typically need"       ##
{
    my $stats_yaml = <[file.zenka_dir.load]>->('self_test-stats.yaml');
    my $stats
        = ( defined $stats_yaml and length $$stats_yaml )
        ? ( <[format.yaml.load_str]>->($$stats_yaml) // {} )
        : {};
    my $model_stats = $stats->{$model_id} // {};

    if (%$model_stats) {
        push @lines, "durable stats [ across all runs, this model ] :";
        for my $prompt_id ( sort { $a <=> $b } keys %$model_stats ) {
            my $e        = $model_stats->{$prompt_id};
            my $hist     = $e->{'attempts_histogram'} // {};
            my $hist_str = join ', ', map {"$_ attempt(s): $hist->{$_}x"}
                sort { $a <=> $b } keys %$hist;
            push @lines, sprintf "  prompt %d : %d pass / %d fail",
                $prompt_id, $e->{'pass_count'} // 0, $e->{'fail_count'} // 0;
            push @lines, "    attempts " . "needed : $hist_str"
                if length $hist_str;
            my $fc = $e->{'failure_class_counts'} // {};
            if (%$fc) {
                my $fc_str = join ', ', map {"$_: $fc->{$_}x"} sort keys %$fc;
                push @lines, "    failure classes : $fc_str";
            }
        }
        push @lines, '';
    }
}

for my $prompt_id ( sort { $a <=> $b } keys %$prompts ) {
    my $p = $prompts->{$prompt_id};
    push @lines, sprintf "prompt %d : %s", $prompt_id,
        $p->{'passed'} ? 'PASS' : 'FAIL';
    push @lines, sprintf "  question : %s", $p->{'prompt'};
    push @lines, sprintf "  answer   : '%s'  expected : '%s'", $p->{'answer'},
        $p->{'expected'};

    ## empty content but a reasoning trace exists : most likely the whole ##
    ## max_tokens budget went to <think> and generation stopped before a  ##
    ## final answer - show it so it's visible instead of just '' with no  ##
    ## explanation                                                        ##
    if ( !length $p->{'answer'} and length( $p->{'reasoning'} // '' ) ) {
        push @lines, sprintf "  finish_reason : %s",
            $p->{'finish_reason'} || 'unknown';
        my $reasoning = $p->{'reasoning'};
        my $preview
            = length($reasoning) > 400
            ? substr( $reasoning, 0, 400 ) . '... [truncated]'
            : $reasoning;
        push @lines, "  reasoning (no final answer emitted) : $preview";
    }

    ## the initial call outright failed [ eg http_500 ] : show whatever the ##
    ## llama-server process itself said right before the failure - the bare ##
    ## status code alone gives no clue why it 500'd                         ##
    if ( length( $p->{'server_tail'} // '' ) ) {
        push @lines, "  server output at failure time :";
        push @lines, "    $_" for split /\n/, $p->{'server_tail'};
    }

    push @lines, sprintf "  tier     : %s", $p->{'tier'} || '-';
    push @lines, sprintf "  structural_reason : %s",
        $p->{'structural_reason'} || '-';
    push @lines, sprintf "  tier1_reason      : %s",
        $p->{'tier1_reason'} || '-';

    my $attempts = $p->{'tier1_attempts'} // [];
    if (@$attempts) {
        for my $i ( 0 .. $#$attempts ) {
            my $a = $attempts->[$i];
            push @lines, sprintf "  tier1 attempt %d : %s", $i + 1,
                $a->{'ok'} ? 'OK' : 'FAIL';
            push @lines, sprintf "    hint sent : %s",   $a->{'hint'};
            push @lines, sprintf "    got back  : '%s'", $a->{'reformatted'};
            push @lines, sprintf "    reason    : %s", $a->{'reason'} || '-'
                if !$a->{'ok'};

            ## same "empty but reasoning present" signal as the top-level  ##
            ## answer above, per tier1 attempt -- this is what was missing ##
            ## for a reformat round: a bare "got back : ''" with no clue   ##
            ## whether the model reasoned itself out of tokens             ##
            if (   !length $a->{'reformatted'}
                and length( $a->{'reasoning'} // '' ) ) {
                push @lines, sprintf "    finish_reason : %s",
                    $a->{'finish_reason'} || 'unknown';
                my $reasoning = $a->{'reasoning'};
                my $preview
                    = length($reasoning) > 400
                    ? substr( $reasoning, 0, 400 ) . '... [truncated]'
                    : $reasoning;
                push @lines,
                    "    reasoning (no final answer emitted) : $preview";
            }
        }
    } else {
        push @lines, "  tier1 attempt : none [ tier0 structural "
            . "check passed or answer never sent for reformat ]";
    }
    push @lines, '';
}

return { mode => qw| size |, data => join( "\n", @lines ) . "\n" };

