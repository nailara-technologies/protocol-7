## [:< ##

# name  = sessions.cmd.status
# descr = report key-holding child pid/liveness/state/socket path

my $pid   = <sessions.holder.pid>;
my $state = <sessions.holder.state> // 'unspawned';
my $alive = defined $pid ? <[base.exists.sub-process]>->($pid) : FALSE;

my $out = sprintf(
    "pid: %s\nstate: %s\nalive: %s\nsocket: %s\n",
    $pid // 'none',
    $state,
    $alive ? 'yes' : 'no',
    <sessions.holder.socket_path> // 'none'
);

return { 'mode' => qw| size |, 'data' => $out };

