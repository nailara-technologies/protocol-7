## [:< ##

# name  = plugin.web.auth.admit.envelope_429
# descr = the 429 envelope for the httpd reply handler
# note  = the 429 envelope string for the httpd reply handler
#         [ httpd.handler.web-relay.login ] : status, Retry-After and a
#         short json body -- sent at once, never a held connection
# param = retry_after [ seconds ]

my $retry_after = shift // 1;
$retry_after = 1 if $retry_after < 1;
$retry_after = int( $retry_after + 0.5 );    ## whole seconds on the wire ##

return JSON::XS::encode_json(
    {   'status'      => 429,
        'retry_after' => $retry_after,
        'body'        => '{"ok":false,"error":"too many requests"}',
    }
);

