## [:< ##

# name   = keys.trash.stash
# descr  = move a key-store file into the trash [ xz + b32, undo-remove ]
# param  = <path> <kind> <name> [ keep : TRUE leaves the original ]
# return = trash file path or undef [ list context : ( undef, reason ) ]
#
# ~/.n/remote-keys/trash/<kind>/<name>.<epoch>[-n].mxz.B32, 0600 [ the
# note.trash.stash format ]. the copy is decoded back and compared BEFORE
# the original is removed -- a removal is only as reliable as its undo.
# keep : the caller overwrites the file itself [ a list rewrite ].

my ( $path, $kind, $name, $keep ) = @ARG;

my $refuse = sub {
    my $reason = shift;
    return wantarray ? ( undef, $reason ) : undef;
};

return $refuse->('nothing to stash')
    if not defined $path
    or -l $path
    or not -f $path;
return $refuse->('kind not valid')
    if not defined $kind
    or $kind !~ m|\A[a-z][a-z-]{1,31}\z|;
return $refuse->('name not valid')
    if not defined $name
    or $name !~ m|\A[A-Za-z0-9][A-Za-z0-9._:-]{0,127}\z|;

my ( $trash_root, $why ) = <[keys.remote_keys_dir]>->( qw| trash |, TRUE );
return $refuse->($why) if not defined $trash_root;
my $dir = catfile( $trash_root, $kind );
if ( not -d $dir ) {
    return $refuse->("not a directory [ $dir ]") if -l $dir;
    mkdir( $dir, 0700 )
        or -d $dir
        or return $refuse->("cannot create $dir [ $OS_ERROR ]");
}

open( my $in, '<:raw', $path ) or return $refuse->("cannot read $path");
my $content = do { local $INPUT_RECORD_SEPARATOR = undef; readline($in) };
close($in);
return $refuse->("cannot read $path") if not defined $content;

require IO::Compress::Xz;
require IO::Uncompress::UnXz;
my $packed;
IO::Compress::Xz::xz( \$content, \$packed )
    or return $refuse->('xz failed');
my $b32 = Crypt::Misc::encode_b32r($packed);

## the copy must decode back to the exact bytes ##
my $check;
my $unpacked_b32 = Crypt::Misc::decode_b32r($b32);
IO::Uncompress::UnXz::unxz( \$unpacked_b32, \$check )
    or return $refuse->('xz check failed');
return $refuse->('trash copy does not decode back') if $check ne $content;

require Fcntl;
my $now = time;
my ( $trash_file, $fh );
foreach my $n ( 0 .. 99 ) {
    $trash_file = catfile( $dir,
        sprintf( '%s.%d%s.mxz.B32', $name, $now, $n ? "-$n" : '' ) );
    last
        if sysopen(
        $fh,
        $trash_file,
        Fcntl::O_WRONLY() | Fcntl::O_CREAT() | Fcntl::O_EXCL()
            | Fcntl::O_NOFOLLOW(),
        0600
        );
    undef $fh;
}
return $refuse->("no free trash name in $dir") if not defined $fh;

if ( not print {$fh} "$b32\n" or not close($fh) ) {
    unlink($trash_file);
    return $refuse->("cannot write $trash_file");
}

if ( not $keep and not unlink($path) ) {
    my $os_err = "$OS_ERROR";
    unlink($trash_file);
    return $refuse->("cannot remove $path [ $os_err ]");
}

return $trash_file;

