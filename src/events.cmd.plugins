## [:< ##

# name  = events.cmd.plugins
# descr = list the loaded events plugins [ sources and actions ]
# descr = loaded source \ action plugins and what each does

my $registry = <[events.plugin.registry]>->();

my @lines;
foreach my $kind (qw| source action |) {
    foreach my $type ( sort keys %{ $registry->{$kind} } ) {
        push @lines, sprintf ": %-6s %-24s %s\n", $kind, $type,
            $registry->{$kind}{$type}{'describe'};
    }
}

return { 'mode' => qw| false |, 'data' => 'no events plugins loaded' }
    if !@lines;

return { 'mode' => qw| size |, 'data' => join( '', @lines ) };

