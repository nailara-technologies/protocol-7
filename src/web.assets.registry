## [:< ##

# name = web.assets.registry
# descr = registry of template assets discovered and managed

## Asset registry data structure ##
<web.assets.registry> = {};

## Asset statistics ##
<web.assets.stats> = {
    total_assets      => 0,
    templates_scanned => 0,
    last_scan_time    => 0,
    assets_present    => 0,
    assets_missing    => 0,
    assets_copied     => 0,
};

## Visibility list for asset registry ##
<list.web-assets> = {
    'var'      => qw| data |,
    'key'      => qw| web.assets.registry |,
    'sort_key' => 'alpha-len:asset_path',
    'descr'    => 'Template assets registry - discovered and managed',
    'mask'     => 'path:asset_path tmpl:template '
        . 'src:source_path status last:last_validated',
    'align' => {
        'path'   => 'left+2',
        'tmpl'   => 'center',
        'src'    => 'left+1',
        'status' => 'center-1',
        'last'   => 'center-1',
    },
    'filters' => { 'last' => qw| base.parser.timestamp |, }
};

<[base.list.init]>->(
    {   'name'         => qw| web-assets |,
        'key_ref'      => \<web.assets.registry>,
        'max_elements' => 1024
    }
);

0;

