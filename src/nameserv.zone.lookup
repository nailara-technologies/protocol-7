## [:< ##

# name  = nameserv.zone.lookup
# descr = internal zone lookup by query name

my $qname = shift;

$qname = lc( $qname // '' );

my $zones = <nameserv.zones>;

## find longest matching zone (most specific)
my $best_match = undef;
my $best_len   = 0;

for my $zone_name ( keys %$zones ) {
    my $zone = $zones->{$zone_name};
    my $zlen = length $zone_name;

    ## match exact zone or subdomain
    if ( $qname eq $zone_name or $qname =~ m|\.$zone_name$|i ) {
        if ( $zlen > $best_len ) {
            $best_match = $zone;
            $best_len   = $zlen;
        }
    }
}

return $best_match;

