## [:< ##

# name  = nameserv.zone.lookup
# descr = internal zone lookup by query name [ longest suffix ]
#         returns the zone, or [ zone, zone name ] in list context

my $qname = shift;

$qname = lc( $qname // '' );

my $zones = <nameserv.zones>;

## find longest matching zone (most specific)
my $best_match = undef;
my $best_name  = undef;
my $best_len   = 0;

for my $zone_name ( keys %$zones ) {
    my $zone = $zones->{$zone_name};
    my $zlen = length $zone_name;

    ## match exact zone or subdomain on a label boundary
    if ( $qname eq $zone_name or $qname =~ m|\Q.\E\Q$zone_name\E$|i ) {
        if ( $zlen > $best_len ) {
            $best_match = $zone;
            $best_name  = $zone_name;
            $best_len   = $zlen;
        }
    }
}

return wantarray ? ( $best_match, $best_name ) : $best_match;

