# name  = web-browser.handler.capture_paged_snapshot_result
# descr = async completion callback for a paged-capture snapshot. saves the
#         PNG via the shared snapshot_save helper, then either advances to the
#         next position or resumes the normal slideshow advance flow.

my ( $view, $async_result ) = @_;

my $out_path = delete <web-browser.capture.paged.pending_path>;

my $saved = <[web-browser.util.snapshot_save]>->(
    $view, $async_result, $out_path, undef
);

my $positions = <web-browser.capture.paged.positions>;
my $index     = <web-browser.capture.paged.index> // 0;

if ($saved) {
    <web-browser.capture.paged.index> = $index + 1;
    if ( defined $positions
        and <web-browser.capture.paged.index> < @$positions ) {
        <[web-browser.handler.capture_paged_step]>;
        return;
    }
}

<[web-browser.capture_paged.advance]>;

