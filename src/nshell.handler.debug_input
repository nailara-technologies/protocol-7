## [:< ##

# name  = nshell.handler.debug_input
# descr = trigger reading from debug buffer

my $event   = shift;                      ## get var_watcher event ##
my $id      = $event->w->data;            ## get session id ##
my $session = $data{'session'}->{$id};    ## acquire session hash ##

<[base.log]>->( 2, "[debug_input] called read handler..," );

$session->{'watcher'}{'stdin_handler'}->now;    ## nshell.read_from_buffer ##

return 0;

