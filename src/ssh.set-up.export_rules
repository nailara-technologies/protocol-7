# name = ssh.set-up.export_rules

return {
    'keys' => {
        'set-up' =>
            { 'export' => [ 'ssh.config_name', 'ssh.autostart_profiles' ] },
        'link_setup' => { 'export' => ['ssh.cfg'] }
    }
};

