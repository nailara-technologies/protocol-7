## [:< ##

# name  = kimi.acp.dispatch
# descr = route one decoded json-rpc message
# param = message [ hash ref ]

my $message = shift;
my $st      = <[kimi.acp.state]>;

if ( defined $message->{'method'} and defined $message->{'id'} ) {
    return <[kimi.acp.agent_request]>->($message);    ## child asks us ##
}

if ( defined $message->{'method'} ) {    ## notification ##
    if ( $message->{'method'} eq qw| session/update | ) {
        return <[kimi.acp.on_update]>->( $message->{'params'} // {} );
    }
    <[kimi.acp.event]>->( qw| note |, $message->{'method'} );
    return TRUE;
}

return FALSE if not defined $message->{'id'};    ## a response ##
my $pending = delete $st->{'pending'}{ $message->{'id'} };
if ( not defined $pending ) {
    <[kimi.acp.event]>
        ->( qw| note |, "reply to unknown id $message->{'id'}" );
    return FALSE;
}
return <[kimi.acp.on_response]>->(
    $pending, $message->{'result'}, $message->{'error'}
);

