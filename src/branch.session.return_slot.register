## [:< ##

# name = branch.session.return_slot.register
# descr = attach return handler to current node; set state to awaiting_return

my $node_checksum = shift // return undef;
my $handler       = shift // return undef;

return warn 'node checksum required <{C1}>'
    if not length $node_checksum;
return warn 'handler coderef required <{C1}>'
    if ref $handler ne 'CODE';

my $node_key = 'branch.session.dag.' . $node_checksum;
return warn 'node not found in dag <{C1}>'
    if not exists $data{$node_key};

$data{$node_key}{'return_slot'} = $handler;
$data{$node_key}{'state'}       = 'awaiting_return';

return 1;

