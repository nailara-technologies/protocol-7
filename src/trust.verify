## [:< ##

# name   = trust.verify
# descr  = walk a delegation chain from a pinned anchor down to a subject
# param  = { chain   => [ <wire b32 statement>, .. ] [ anchor-most first ],
#            anchors => [ <77 char fingerprint>, .. ],
#            subject => <raw 32 byte public key>,
#            now     => <unix seconds> }
# return = { name, anchor, issuer_pub, not_after, depth } [ of the last
#          statement ; depth = statements actually verified ] or undef
#          [ list context : ( undef, reason ) ]
#
# data/md/design/TRUST-CHAIN-STEP2.md [ 'scope grammar' ] : the chain is
# given anchor-most first ; verification STARTS at the first statement
# whose issuer fingerprint is pinned [ statements before it are ignored :
# not parsed, not checked ] -- none pinned : refuse. every later issuer
# must be the previous subject. per statement, in this order : exact
# parse -> sig under the issuer pub -> not_before <= now <= not_after ->
# [ last : subject ] -> name charset -> scope.
#
# a scope pattern is '' [ certifies nothing ], <name> [ exactly that
# name ] or '<prefix>.*' [ any name strictly below <prefix>, any depth ]
# ; pattern charset : the name rule, optionally followed by '.*'. the
# anchor's implicit scope is '*' ; a statement CARRYING scope '*' is
# refused. per hop the name must match the issuer's scope AND the
# statement's own scope must be strictly narrower [ '' always allowed ;
# under an exact <name> only '' ; under '<prefix>.*' the equal scope
# refuses ]. the last statement's own scope must be ''. max chain length
# 4 [ refused before anything is parsed ].

my $param = shift;

my $refuse = sub {
    my $reason = shift;
    return wantarray ? ( undef, $reason ) : undef;
};

my $max_chain = 4;
my $re_name   = qr|\A[A-Za-z0-9][A-Za-z0-9._-]{0,254}\z|;
my $re_scope  = qr|\A[A-Za-z0-9][A-Za-z0-9._-]{0,254}(?:\.\*)?\z|;
my $label_len = 17;    ## the literal bytes 'p7 delegation v1' . \0 ##

return $refuse->('parameters not a hash') if ref $param ne qw| HASH |;

my ( $chain, $anchors, $subject, $now )
    = @{$param}{qw| chain anchors subject now |};

return $refuse->('chain missing')
    if ref $chain ne qw| ARRAY |
    or not $chain->@*;
return $refuse->('chain too long') if $chain->@* > $max_chain;
return $refuse->('anchors missing')
    if ref $anchors ne qw| ARRAY |
    or not grep { defined $ARG and not ref $ARG and length $ARG }
    $anchors->@*;
return $refuse->('subject not 32 bytes')
    if not defined $subject
    or ref $subject
    or not utf8::downgrade( $subject, 1 )
    or bytes::length($subject) != 32;
return $refuse->('time not valid')
    if not defined $now
    or ref $now
    or $now !~ m|\A[0-9]{1,10}\z|;

my %anchor = map { $ARG => TRUE }
    grep { defined $ARG and not ref $ARG and length $ARG } $anchors->@*;

## a name inside a scope pattern ? [ the caller handles '' \ '*' ] ##
my $name_in_scope = sub {
    my ( $scope, $name ) = @ARG;
    return 1 if $scope eq qw| * |;
    my ($prefix) = $scope =~ m|\A(.+)\.\*\z|;
    ## strictly below : something must follow "<prefix>." ##
    return ( index( $name, "$prefix." ) == 0
            and length($name) > length($prefix) + 1 ) ? 1 : 0
        if defined $prefix;
    return $name eq $scope ? 1 : 0;
};

## $sub STRICTLY within $iss ? [ the caller handles '' : always allowed ; ##
## both are checked patterns before this runs ]                           ##
my $scope_within = sub {
    my ( $iss, $sub ) = @ARG;
    return 1 if $iss eq qw| * |;
    return 0 if $iss eq '';
    my ($i_pre) = $iss =~ m|\A(.+)\.\*\z|;
    return 0 if not defined $i_pre;    ## an exact name : only '' below ##
    my ($s_core) = $sub =~ m|\A(.+?)(?:\.\*)?\z|;
    return ( index( $s_core, "$i_pre." ) == 0
            and length($s_core) > length($i_pre) + 1 ) ? 1 : 0;
};

## the first statement whose issuer fingerprint is pinned starts the chain ##
## ; everything before it is ignored [ not parsed, not checked ].  the     ##
## issuer pub sits at a fixed offset right after the label -- a b32 decode ##
## is all the scan needs                                                   ##
my $start;
my $anchor_fp;
foreach my $index ( 0 .. $chain->$#* ) {
    my $wire = $chain->[$index];
    next if not defined $wire or ref $wire;
    next if $wire !~ m|\A[A-Z2-7]+\z|;
    my $bytes = eval { Crypt::Misc::decode_b32r($wire) };
    next if not defined $bytes or bytes::length($bytes) < $label_len + 32;
    my $fp = <[trust.fingerprint]>->( substr( $bytes, $label_len, 32 ) );
    next if not defined $fp or not exists $anchor{$fp};
    $start     = $index;
    $anchor_fp = $fp;
    last;
}
return $refuse->('no pinned anchor in chain') if not defined $start;

my $issuer_scope = qw| * |;    ## the anchor's implicit scope ##
my $prev_subject;
my $last;

foreach my $index ( $start .. $chain->$#* ) {
    my $at = sprintf 'statement %d', $index + 1;

    my ( $st, $reason )
        = <[trust.statement]>->( qw| parse_wire |, $chain->[$index] );
    return $refuse->("$at : $reason") if not defined $st;

    return $refuse->("$at : issuer is not the previous subject")
        if $index > $start
        and $st->{'issuer_pub'} ne $prev_subject;

    return $refuse->("$at : signature not valid")
        if not Crypt::Ed25519::verify( $st->{'statement'},
        $st->{'issuer_pub'}, $st->{'sig'} );

    return $refuse->("$at : not_after before not_before")
        if $st->{'not_after'} < $st->{'not_before'};
    return $refuse->("$at : not yet valid") if $now < $st->{'not_before'};
    return $refuse->("$at : expired")       if $now > $st->{'not_after'};

    my $is_last = $index == $chain->$#*;

    return $refuse->("$at : subject mismatch")
        if $is_last
        and $st->{'subject_pub'} ne $subject;

    return $refuse->("$at : name not valid") if $st->{'name'} !~ $re_name;

    ## the issuer may certify this name ? ##
    return $refuse->("$at : issuer scope is empty") if $issuer_scope eq '';
    return $refuse->("$at : name outside issuer scope")
        if not $name_in_scope->( $issuer_scope, $st->{'name'} );

    ## the subject's own scope : a valid pattern, strictly narrower ##
    my $scope = $st->{'scope'};
    if ( $scope ne '' ) {
        return $refuse->("$at : scope pattern not valid")
            if $scope !~ $re_scope;
        return $refuse->("$at : scope not within issuer scope")
            if not $scope_within->( $issuer_scope, $scope );
    }

    ## the leaf certifies nothing ##
    return $refuse->("$at : leaf scope not empty")
        if $is_last
        and $scope ne '';

    $issuer_scope = $scope;
    $prev_subject = $st->{'subject_pub'};
    $last         = $st;
}

return {
    qw| name |       => $last->{'name'},
    qw| anchor |     => $anchor_fp,
    qw| issuer_pub | => $last->{'issuer_pub'},
    qw| not_after |  => $last->{'not_after'},
    qw| depth |      => $chain->$#* - $start + 1,
};

