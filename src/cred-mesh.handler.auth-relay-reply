## [:< ##

# name  = cred-mesh.handler.auth-relay-reply
# descr = handle protocol-7-menu dialog response to auth approval request.
#         on approval, store session credential in tier-1 storage.
#         on graphical-mode-failure, kick off console fallback.
#         on cancellation, propagate failure and clear pending.

## the route-send reply hash { cmd, call_args, params } -- cred-mesh.cmd.   ##
## approve builds the same. this read a hand-built { reply, args } shape    ##
## only the console path sent, so every dialog answer had no req_id and was ##
## dropped [ 2026-10-23 ] ; TRUE \ FALSE replies carry no mode \ data       ##
## [ base.reply.mode_text ]                                                 ##
my $call = shift // {};
my ( $reply_mode, $reply_data ) = <[base.reply.mode_text]>->($call);

my $req_id = ( $call->{'params'} // {} )->{'req_id'} // '';

return undef unless length $req_id;

my $pending = <cred-mesh.auth_relay_pending>->{$req_id};
return undef if not defined $pending;

my $domain = $pending->{'domain'};

## mode true: user approved via dialog ##
if ( $reply_mode eq qw| true | ) {
    my $session_value = $reply_data;
    if ( not length $session_value ) {
        delete <cred-mesh.auth_relay_pending>->{$req_id};
        return {
            'mode' => qw| false |,
            'data' => 'no session value provided'
        };
    }

    return <[cred-mesh.util.complete_approval]>->(
        $req_id, $domain, $session_value
    );
}

## mode false with graphical not enabled: console fallback ##
if (    $reply_mode eq qw| false |
    and $reply_data =~ m|graphical mode not enabled| ) {
    ## write pending entry to file for external tooling ##
    my $pending_yaml
        = eval { YAML::XS::Dump( <cred-mesh.auth_relay_pending>->%* ); };
    if ( defined $pending_yaml ) {
        <[file.zenka_dir.write]>->(
            'relay_pending.yaml', \$pending_yaml, '>', 0600
        );
    }

    <[base.logs]>->(
        0,
        'auth relay pending [%s] domain=%s — approve '
            . 'with: p7c cred-mesh.approve %s <payload>',
        $req_id,
        $domain,
        $req_id
    );

    ## keep pending entry in memory for console approve ##
    return {
        'mode'   => qw| pending |,
        'data'   => 'console fallback active',
        'req_id' => $req_id,
    };
}

## mode false with input cancelled: user dismissed ##
if (    $reply_mode eq qw| false |
    and $reply_data eq 'input cancelled' ) {
    <[base.logs]>->(
        1, 'cred-mesh: auth relay cancelled for domain %s', $domain
    );
    delete <cred-mesh.auth_relay_pending>->{$req_id};
    return { 'mode' => qw| false |, 'data' => 'input cancelled' };
}

## unknown mode: propagate failure ##
<[base.logs]>->(
    1,       'cred-mesh: auth relay failed for domain %s (mode=%s)',
    $domain, $reply_mode
);
delete <cred-mesh.auth_relay_pending>->{$req_id};
return { 'mode' => qw| false |, 'data' => 'auth relay failed' };

