## [:< ##

# name  = plugin.web.auth.session.path
# descr = return base path to the shared web-auth session storage
# note  = built here, NOT as a 'shared' key in base.path-set-up
#         .zenka-directories : that table is enforced as
#         protocol-7:protocol-7 0775 by base.path-set-up.check-zenka-paths,
#         which would fight the store's protocol-7:httpd 2770 requirement

return join qw| / |, <system.path.zenka-dirs>->{'var_P7'},
    qw| shared web-auth |;

