## [:< ##

# name   = keys.remote_keys_dir
# descr  = <home>/.n/remote-keys [ + a sub dir ], created 0700 on demand
# param  = [ <sub dir name> ] [ e.g. 'owners' ] , [ create : TRUE \ FALSE ]
# return = path or undef [ list context : ( undef, reason ) ]
#
# the CLIENT side pin store [ data/md/design/TRUST-CHAIN-STEP2.md 'pins' ]
# of the user running the command : servers/ [ host pins ], owners/
# [ owner pins ], distrust [ a file ].

my ( $sub, $create ) = @ARG;

my $refuse = sub {
    my $reason = shift;
    return wantarray ? ( undef, $reason ) : undef;
};

my $home_dir = <[base.get_homedir]>->();
return $refuse->('no home directory')
    if not defined $home_dir
    or not length $home_dir
    or not -d $home_dir;

return $refuse->('sub dir name not valid')
    if defined $sub
    and $sub !~ m|\A[a-z]{1,32}\z|;

my @dirs = (
    join( qw| / |, $home_dir, qw| .n | ),
    join( qw| / |, $home_dir, qw| .n remote-keys | )
);
push @dirs, join( qw| / |, $dirs[-1], $sub ) if defined $sub;

foreach my $dir (@dirs) {
    return $refuse->("not a directory [ $dir ]") if -l $dir;
    next                                         if -d $dir;
    return $refuse->("missing [ $dir ]")         if not $create;
    mkdir( $dir, 0700 )
        or -d $dir
        or return $refuse->("cannot create $dir [ $OS_ERROR ]");
}

return $dirs[-1];

