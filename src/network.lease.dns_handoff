## [:< ##

# name  = network.lease.dns_handoff
# param = <iface>
# descr = hand the dhcp dns servers to nameserv upstream state

my $iface = shift                     // return FALSE;
my $l     = <network.lease>->{$iface} // return FALSE;
return FALSE if $l->{'reason'} !~ m{^(BOUND|RENEW|REBIND|REBOOT)6?$};
my @dns = ( ( $l->{'dns'} // [] )->@*, ( $l->{'dns6'} // [] )->@* );
return FALSE if not @dns;
my $before = join ' ', ( <network.dns.upstreams> // [] )->@*;
<network.dns.upstreams>       = \@dns;
<network.dns.upstreams_iface> = $iface;
return TRUE if $before eq join ' ', @dns;

## fire and forget : a missing nameserv never makes the lease update fail ##
my $sent = <[protocol-7.command.send.local]>->(
    {   'command'   => qw| nameserv.set-upstreams |,
        'call_args' => { 'args' => join( ' ', "dhcp:$iface", @dns ) }
    }
);
<[base.logs]>->(
    ( $sent // 0 ) > 0 ? 1 : 0,
    ': dns hand-off [ nameserv upstreams ] : %s from %s : %s',
    join( ' ', @dns ),
    $iface,
    ( $sent // 0 ) > 0 ? 'sent' : 'not delivered [ nameserv not running ? ]'
);
return TRUE;

