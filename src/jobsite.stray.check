## [:< ##

# name  = jobsite.stray.check
# descr = on its own initiative, ask configured zenki for stray jobs
#
# notes = stray = job files stranded under a zenka's own var dir [ eg
#         from a past path-resolution desync ] ; claimed back one at a
#         time once a listing reply names any

my $targets_cfg = <jobsite.cfg.stray_check_targets> // qw| site-yaml |;
my @targets     = split m|\s+|, $targets_cfg;

for my $target (@targets) {
    <[protocol-7.route-send]>->(
        {   'command' => "$target.list-stray-jobs",
            'reply'   => {
                'handler' => 'jobsite.handler.stray-jobs-listed',
                'params'  => { 'source' => $target },
            },
        }
    );
}

return scalar @targets;

