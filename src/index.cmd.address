## [:< ##

# name  = index.cmd.address
# descr = return numerical address for a token

my $token = $call->{'args'} // '';
my $addr  = <[index.address]>->($token);

return { 'mode' => 'false', 'data' => 'not found' }
    if not defined $addr;

my $display
    = ref $addr eq 'ARRAY'
    ? join( '.', map { $ARG // '?' } @{$addr} )
    : "$addr";

return { 'mode' => 'size', 'data' => "$token  :  $display" };

