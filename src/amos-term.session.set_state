## [:< ##

# name  = amos-term.session.set_state
# descr = Update amos-term session to new protocol state

my ( $session_id, $new_state ) = @ARG;

## use base.session.init_state for proper protocol state transition ##
my $result = <[base.session.init_state]>->( $session_id, $new_state );

return $result ? $new_state : undef;

