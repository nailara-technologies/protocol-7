## [:< ##

# name  = v7.zenka.push_routing_mode
# descr = push declared routing_mode of a zenka to the cube-side mirror
# param = <zenka_name>

my $zenka_name = shift // return FALSE;

## only possible while connected to cube ##
return FALSE if not exists <user.cube.session>;

my $mode;
if ( defined <v7.start_setup.zenki.config>
    and exists <v7.start_setup.zenki.config>->{$zenka_name} ) {
    $mode = <v7.start_setup.zenki.config>->{$zenka_name}->{'routing_mode'};
}

## no declared mode : reset cube-side mirror to default ##
my $args_str
    = defined $mode ? sprintf( '%s %s', $zenka_name, $mode ) : $zenka_name;

return <[protocol-7.command.send.local]>->(
    {   'command'   => qw| cube.set-routing-mode |,
        'call_args' => { 'args' => $args_str }
    }
);

