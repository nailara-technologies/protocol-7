## [:< ##

# name = base.X-11.get_display

my $silent_warnings = shift // 0;

## an x-<vax-int> subname [ eg. mpv[x-HE] ] is a reversible reference to an ##
## auto-allocated xvfb display [ X-11.helper.alloc_xvfb_display ] -- decode ##
## it locally, pure math, no round trip to the X-11 zenka at all [ works    ##
## even without a primary X-11 connection present ] .,                      ##
my $subname = <system.zenka.subname>;
if ( defined $subname and $subname =~ m|^x-([A-Z2-7]+)$| ) {
    my $decoded = <[base.vax-int.decode]>->($1);
    if ( $decoded =~ m|^\d+$| ) {
        <x11.display> = ":$decoded";
        <[base.logs]>->(
            2,        'display resolved from subname [%s] -> [%s]',
            $subname, <x11.display>
        );
        return <x11.display>;
    }
    <[base.logs]>->(
        $silent_warnings ? 2 : 0,
        "subname '%s' looked like an x-<id> label but failed to decode",
        $subname
    );
}

my ($local_sid) = keys <user.cube.session>->%*;

<[base.log]>->( 2, 'requesting display name from X-11 zenka.,' );

$data{'route'} //= {};
my $cmd_id = <[base.gen_id]>->( $data{'route'} );

my $cube_fh = $data{'session'}{$local_sid}{'handle'};
<[base.net.send_to_socket]>->(
    $cube_fh, sprintf( "(%d)X-11.get_display\n", $cmd_id )
);

my $reply_string;
my $matched_reply = 0;
while ( !$matched_reply ) {
    $reply_string = readline($cube_fh);    ### [LLL] improve ###
    die 'cube handle exception' if not defined $reply_string;
    $matched_reply = 1 if $reply_string =~ m{^\($cmd_id\)(TRUE|FALSE) };
    if ( !$matched_reply ) {
        $data{'session'}{$local_sid}{'buffer'}{'input'} .= $reply_string;
    }
}

if ( $reply_string =~ m{^\($cmd_id\)TRUE ([^\n]+)\n$} ) {
    <x11.display> = ${^CAPTURE}[0];
    <[base.logs]>->( 'received X display name [%s]', <x11.display> );
    return <x11.display>;

} elsif (
    $reply_string eq    ### known protocol reply for no X-11 zenka present ###
    <[base.sprint_t]>->( qw| IRW7V6A |, sprintf( qw| (%d) |, $cmd_id ) )
) {

    <x11.display> //= qw| :0.0 |;
    <[base.logs]>->(
        'no X-11 zenka found, using default display [%s]',
        <x11.display>
    );
    return <x11.display>;
} else {
    <[base.logs]>->(
        $silent_warnings ? 2 : 0,
        "not expected X-11 reply ['%s']",
        $reply_string
    );
    return undef;
}

