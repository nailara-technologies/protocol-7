## [:< ##

# name  = screenshot.powershell_passthrough.request
# descr = route a capture through powershell zenka when
#                     native x11 capture is unavailable

my ( $call, $action, $coords_aref ) = @ARG;

my $id;
do { $id = <[base.prng.chars-anum]>->(8) }
    while exists <screenshot.passthrough>->{$id};

<screenshot.passthrough>->{$id} = {
    'reply_id' => $call->{'reply_id'},
    'action'   => $action,
    'coords'   => $coords_aref,
};

<[protocol-7.route-send]>->(
    {   'command'   => qw| powershell.screenshot-capture |,
        'call_args' => { 'args' => '' },
        'reply'     => {
            'handler' => qw| screenshot.handler.powershell_capture_reply |,
            'params'  => { 'id' => $id }
        }
    }
);

return TRUE;

