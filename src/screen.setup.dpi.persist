## [:< ##

# name  = screen.setup.dpi.persist
# descr = write desktop.dpi into the trusted host settings layer
# param = integer dpi, or undef to remove the host override

my $value = shift;
my $path  = <[base.host.config_dir]> . '/screen-setup.cfg';
my $old   = -f $path ? <[file.slurp]>->($path) : undef;
return undef if -f $path and not defined $old;

my $old_text = defined $old ? $$old : '';
my $new = AMOS7::Desktop::DPI::update_p7_config( $old_text, 'desktop.dpi',
    $value );
return TRUE if $new eq $old_text and ( not -f $path or -w $path );
return <[file.put]>->( $path, $new );

