## [:< ##

# name  = crypt.C25519.get_keyname
# descr = return key name of given key filename

my $C25519_filename = shift // '';

$C25519_filename =~ s|^.*/||;    ##  removing directory path compotent  ##

if ( not length $C25519_filename ) {
    warn 'expected key filename parameter <{C1}>';
    return undef;
}

## memoized : repeated look-ups of the same filename [ common — every       ##
## keyfiles()/chksum() rescan re-asks about every file it passes ] must not ##
## re-derive the classification or re-warn on every call                    ##
return <crypt.C25519.get_keyname.cache>->{$C25519_filename}
    if exists <crypt.C25519.get_keyname.cache>->{$C25519_filename};

my $keyname;

if ( $C25519_filename =~ m|^:\.virtual\.::(.+)$| )    ##[ description ]##
{
    $keyname = $LAST_PAREN_MATCH;
} else {
    foreach my $type ( keys <crypt.C25519.regex.key_file>->%* ) {
        if ( $C25519_filename =~ <crypt.C25519.regex.key_file>->{$type} ) {
            $keyname = $LAST_PAREN_MATCH;
            last;
        }
    }
}

if ( not defined $keyname and not <crypt.C25519.get_keyname.quiet> ) {
    ## callers that intend to report unrecognized files themselves, with a ##
    ## specific reason, set <crypt.C25519.get_keyname.quiet> around the    ##
    ## call — e.g. keys.console.list — so this generic warn doesn't also   ##
    ## reach the user redundantly                                          ##
    <[base.s_warn]>->(
        'key file %s does not match any defined type <{C1}>',
        $C25519_filename
    );
}

return <crypt.C25519.get_keyname.cache>->{$C25519_filename} = $keyname;

