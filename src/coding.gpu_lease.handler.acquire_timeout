# name  = coding.gpu_lease.handler.acquire_timeout
# descr = models did not answer : hold the gpu spawn and retry

my $event = shift;
my $stage = $event->w->data->{'stage'} // qw| timeout |;
if ( $stage eq qw| retry | ) {
    <coding.gpu_lease.unavailable> = FALSE;
    return <[coding.gpu_lease.request]>;
}
return TRUE if ( <coding.gpu_lease.holder> // '' ) eq qw| coding |;
return TRUE if not <coding.gpu_lease.request_inflight>;
<coding.gpu_lease.request_inflight> = FALSE;
<coding.gpu_lease.unavailable>      = TRUE;
<[base.logs]>->(
    1, ': models gpu lease request unanswered : local gpu spawn held'
) if not defined <coding.gpu_lease.retry_interval>;
## back off while models stays silent : coding-gpu-lease-retry rhythm ##
my $state = <coding.gpu_lease.retry_interval> //= {};
my $after = <[base.interval.next]>
    ->( { 'type' => qw| coding-gpu-lease-retry |, 'state' => $state } );
<[event.add_timer]>->(
    {   'after'   => $after,
        'handler' => qw| coding.gpu_lease.handler.acquire_timeout |,
        'data'    => { 'stage' => qw| retry | },
    }
);
return TRUE;

