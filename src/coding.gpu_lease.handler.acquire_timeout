# name  = coding.gpu_lease.handler.acquire_timeout
# descr = models did not answer : use the legacy gpu memory check

my $event = shift;
my $stage = $event->w->data->{'stage'} // qw| timeout |;
if ( $stage eq qw| retry | ) {
    <coding.gpu_lease.unavailable> = FALSE;
    return <[coding.gpu_lease.request]>;
}
return TRUE if ( <coding.gpu_lease.holder> // '' ) eq qw| coding |;
return TRUE if not <coding.gpu_lease.request_inflight>;
<coding.gpu_lease.request_inflight> = FALSE;
<coding.gpu_lease.unavailable>      = TRUE;
<[base.logs]>->(
    1, ': models gpu lease request unanswered : using existing memory check'
) if not defined <coding.gpu_lease.retry_after>;
## back off while models stays silent : 30 s doubling up to 780 s ##
my $after = <coding.gpu_lease.retry_after> // 15;
$after = $after * 2 > 780 ? 780 : $after * 2;
<coding.gpu_lease.retry_after> = $after;
<[event.add_timer]>->(
    {   'after'   => $after,
        'handler' => qw| coding.gpu_lease.handler.acquire_timeout |,
        'data'    => { 'stage' => qw| retry | },
    }
);
return TRUE;

