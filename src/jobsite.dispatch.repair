## [:< ##

# name  = jobsite.dispatch.repair
# descr = dispatch repair assessment task for a job with defects

my $job_id  = shift // '';
my $defects = shift // [];

return unless length $job_id;

my $job_rec = <jobsite.tasks>->{$job_id};
return unless defined $job_rec;

## load job data from per-file store ##
my $job = <[jobsite.job.read]>->($job_id) // {};

## build repair prompt via shared builder ##
my $prompt = <[jobsite.util.build_prompt]>->( $job, $defects );

## dispatch repair task ##
my $encoded = ':B32:' . encode_b32r( Encode::encode( 'UTF-8', $prompt ) );

## fresh attempt token for this new round trip -- see dispatch.next for the ##
## full rationale ; re-arms the watchdog rather than leaving the original   ##
## assess dispatch's timer (now stale) ticking against the repair leg       ##
my $attempt = 1 + ( ( <jobsite.tasks>->{$job_id} // {} )->{'attempt'} // 0 );
<jobsite.tasks>->{$job_id}{'attempt'} = $attempt;
<[jobsite.dispatch.supersede]>->( $job_id, $attempt, qw| repair | );

<[protocol-7.route-send]>->(
    {   'command'   => 'task.create',
        'call_args' => { 'args' => $encoded },
        'reply'     => {
            'handler' => 'jobsite.handler.repair-created',
            'params'  => { 'job_id' => $job_id, 'attempt' => $attempt },
        },
    }
);

<[jobsite.dispatch.arm_watchdog]>->( $job_id, $attempt, qw| repair | );

