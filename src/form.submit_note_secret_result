## [:< ##

# name  = form.submit_note_secret_result
# descr = record one masked field's leg of a fan-in submit
# param = $field_name, $ok, $message

my ( $field_name, $ok, $message ) = @ARG;

my $pending = <form.submit_pending>;
return FALSE if ref $pending ne qw| HASH |;    ## late/duplicate reply ##

$pending->{'secrets'}{$field_name}
    = { 'status' => $ok, 'detail' => $message };
$pending->{'pending'}--;

<[form.submit_maybe_finish]>;

return TRUE;

