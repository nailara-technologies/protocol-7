# name = mpv.handler.event.property-change

my $params = shift;

return
    if ( <mpv.audio_only>
    and $params->{'name'} !~ m{^(volume|path|core-idle)$} )
    or not exists $params->{'event'}
    or not exists $params->{'name'};

my $handler_name = sprintf qw| mpv.handler.event.property-change.%s |,
    $params->{'name'};

if ( exists $code{$handler_name} ) {
    $code{$handler_name}->($params);
} else {
    ## generic fallback : properties without a dedicated handler module ##
    ## still populate the <mpv.current.*> cache [ state snapshots ]     ##
    $data{'mpv'}{'current'}{ $params->{'name'} } = $params->{'data'};
}

