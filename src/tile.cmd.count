## [:< ##

# name  = tile.cmd.count
# descr = number of tiles in selected tile group

my $tile_group_name = <tile.current_tile_group>;
my $err_str;

$err_str = "no tile configured"
    if !keys( %{<tile.setup.tile>} );
$err_str //= "\<tile.current_tile_group> not defined"
    if not defined $tile_group_name;
$err_str //= "no setup found for tile '$tile_group_name'"
    if not exists <tile.setup.tile>->{$tile_group_name};

return { 'mode' => qw| false |, 'data' => $err_str } if defined $err_str;

return {
    'mode' => qw| true |,
    'data' => scalar keys( %{ <tile.setup.tile>->{$tile_group_name} } )
};

