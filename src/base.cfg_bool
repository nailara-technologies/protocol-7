## [:< ##

# name  = base.cfg_bool
# descr = interprets boolean configuration options [ undef if unknown ]

my $option_value = shift // FALSE;

##  '' | 'n' | 'no' | '0' | 'false' | 'off'  ##                       <--[ 0 ]
##
return FALSE
    if not length $option_value
    or $option_value =~ m{^(0|\-1|no?|false|off)$}i;

##  'y' | 'yes' | '1' | '5' | 'true' | 'on'  ##                       <--[ 5 ]
##
return TRUE if $option_value =~ m{^(y(es)?|1|5|true|on)$}i;    ## 5 == true ##

## otherwise ##
##
<[base.s_warn]>->( "option '%s' not understood <{C1}>", $option_value );

return undef;

