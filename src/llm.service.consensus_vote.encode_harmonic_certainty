# name  = llm.service.consensus_vote.encode_harmonic_certainty
# descr = encode certainty level using harmonic mathematics
# param = $certainty

my ($certainty) = @ARG;

# map 0-1 to harmonic levels using div-7 pattern
# BASE32 encoding: 7^n divisions

my $level         = int( $certainty * 7 );
my $harmonic_code = sprintf( "%07b", $level );    # 7-bit binary

return {
    numeric         => $certainty,
    harmonic_level  => $level,
    binary_encoding => $harmonic_code,
    interpretation  =>
        <[llm.service.consensus_vote.interpret_certainty_level]>->($level)
};

