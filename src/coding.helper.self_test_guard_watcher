# name  = coding.helper.self_test_guard_watcher
# descr = per-backend var watcher on one <coding.self_test_probe_in_flight>
#         ->{$backend} slot : wakes that backend waiting for its own self-
#         test guard the instant the slot clears [ one watcher per backend,
#         the jobqueue.event.register_job_queues pattern - tasks :
#         coding-self-test-parallel-backend-gap, watcher redesign, and
#         coding-self-test-true-parallelization ]

## registered PER BACKEND [ one persistent watcher per guard slot ] by      ##
## coding.helper.trigger_backend_self_test's contention path, tracked in    ##
## <coding.watcher.self_test_guard>->{$backend}. each watcher instance only ##
## ever owns its OWN backend's slot and pending state - no multi-backend    ##
## coalescing loop any more [ that only existed because one shared watcher  ##
## had to cover every backend's wake on a single global scalar guard ]      ##

my $event = shift->w;
my ( $backend, $guard_ref ) = @{ $event->data // [] };
return if !length( $backend // '' );

## fires on EVERY write to this backend's guard slot [ set TRUE and clear   ##
## FALSE both count - poll => 'w' ] : only a cleared slot has work for us.  ##
## the watcher is edge-triggered on the next event loop tick and a burst of ##
## synchronous writes coalesces into ONE firing [ same semantics as         ##
## jobqueue.handler.queue_counter ], so all state is re-derived from        ##
## <coding.self_test_retry_pending> here, never assumed from the firing     ##
return if <coding.self_test_probe_in_flight>->{$backend};

my $pending = delete <coding.self_test_retry_pending>->{$backend};
return if not defined $pending;

<[base.logs]>->(
    2, '[self_test_guard_watcher] guard slot cleared : waking backend=%s',
    $backend
);

my $tested_pid
    = ref $pending eq qw| HASH |
    ? ( $pending->{'tested_pid'} // 0 )
    : 0;

## the watcher got there first : cancel this backend's safety-net timeout   ##
## so it cannot fire stale after the backend got its real turn. if the      ##
## re-trigger below loses the race AGAIN [ something else grabbed this      ##
## backend's slot first ], the contention path re-arms a FRESH timer itself ##
## - so cancel unconditionally, not only on success                         ##
my $safety_timer = delete <coding.self_test_retry_timer>->{$backend};
$safety_timer->cancel
    if defined $safety_timer
    and eval { $safety_timer->is_active };

## stale server guard [ same shape as the guards in                        ##
## coding.handler.monitor_inference_startup and                            ##
## coding.helper.trigger_backend_self_test's on_done ] : if the server was ##
## replaced by a newer spawn while this backend was pending, the new       ##
## server's own readiness event runs its own trigger cycle - resume this   ##
## one's queue and bail                                                    ##
my $srv = <coding.inference_servers>->{$backend};
if ( !defined $srv
    or ( $srv->{'pid'} // 0 ) != $tested_pid ) {
    <[base.logs]>->(
        1,
        '[self_test_guard_watcher] backend=%s : retry '
            . 'for stale server [tested_pid=%s] : giving up',
        $backend,
        $tested_pid
    );
    <[coding.helper.resume_task_queue_for_backend]>->($backend);
    return;
}

## the guard slot just cleared, so the re-trigger below wins it for this  ##
## backend; on the off chance it loses anyway, the normal contention path ##
## re-registers pending state [ plus a fresh safety timer ]. resume_queue ##
## is NOT passed : the trigger defaults it to                             ##
## coding.helper.resume_task_queue_for_backend for the backend [ var      ##
## watcher handlers cannot carry closures ]                               ##
<[coding.helper.trigger_backend_self_test]>->(
    {   'backend'    => $backend,
        'server'     => $srv,
        'tested_pid' => $srv->{'pid'} // 0,
    }
);

return;

