## [:< ##

# name = web.template_cache.get
# descr = Retrieve cached template by key, checking TTL expiration
#
# Parameters:
#   $ARG[0] - Cache key (required)
#
# Returns:
#   On hit:  { status => 'hit', content => ..., hit => 1, age => ..., ttl => ..., size => ... }
#   On miss: { status => 'miss', hit => 0 }
#   On expired: { status => 'expired', hit => 0, age => ... }

my $cache_key = shift;

## validate input ##
unless ( defined $cache_key && length $cache_key ) {
    return {
        status  => qw| error |,
        message => 'Cache key required',
        hit     => 0,
    };
}

## check if cache structure exists ##
my $cache = <web.template_cache>;
unless ( defined $cache && ref $cache eq qw| HASH | ) {
    return {
        status  => qw| miss |,
        message => 'Cache not initialized',
        hit     => 0,
        content => undef,
    };
}

## check if key exists ##
unless ( exists $cache->{$cache_key} ) {
    return {
        status  => qw| miss |,
        message => "Key not in cache: $cache_key",
        hit     => 0,
        content => undef,
    };
}

my $entry = $cache->{$cache_key};

## validate entry structure ##
unless ( ref $entry eq qw| HASH |
    && defined $entry->{'content'}
    && defined $entry->{'timestamp'}
    && defined $entry->{'ttl'} ) {
    return {
        status  => qw| error |,
        message => 'Corrupted cache entry structure',
        hit     => 0,
        content => undef,
    };
}

## check ttl expiration ##
my $age = time() - $entry->{'timestamp'};
if ( $age > $entry->{'ttl'} ) {

    ## expired - remove from cache ##
    delete $cache->{$cache_key};

    ## update metrics ##
    <web.metrics.cache_misses>++
        if defined <web.metrics.cache_misses>;

    return {
        status  => qw| expired |,
        message => "Expired after $age seconds (ttl=$entry->{'ttl'})",
        hit     => 0,
        content => undef,
        age     => $age,
        ttl     => $entry->{'ttl'},
    };
}

## cache hit - update metrics ##
<web.metrics.cache_hits>++
    if defined <web.metrics.cache_hits>;

return {
    status  => qw| hit |,
    message => "Cache hit: $cache_key",
    hit     => 1,
    content => $entry->{'content'},
    age     => $age,
    ttl     => $entry->{'ttl'},
    size    => $entry->{'size'},
};

