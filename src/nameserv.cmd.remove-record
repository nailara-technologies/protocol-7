## [:< ##

# name  = nameserv.cmd.remove-record
# descr = remove a dns record from a zone

my $args_str = $call->{'args'} // '';

## parse args: zone=<zone> name=<name> [type=<type>]
## or positional: <zone> <name> [type]
my %args;
if ( $args_str =~ m|=| ) {
    while ( $args_str =~ m|(\w+)=(\S+)|g ) {
        $args{$1} = $2;
    }
} else {
    my @parts = split m|\s+|, $args_str;
    $args{'zone'} = $parts[0] if @parts;
    $args{'name'} = $parts[1] if @parts > 1;
    $args{'type'} = $parts[2] if @parts > 2;
}

my $zone_name = lc( $args{'zone'} // '' );
my $rec_name  = lc( $args{'name'} // '' );
my $rec_type  = uc( $args{'type'} // '' );

if ( not $zone_name or not $rec_name ) {
    return {
        mode => 'false',
        data => 'usage: remove-record zone=<zone> name=<name> [type=<type>]'
    };
}

my $zones = <nameserv.zones>;

if ( not exists $zones->{$zone_name} ) {
    return { mode => 'false', data => "zone not found: $zone_name" };
}

my $zone       = $zones->{$zone_name};
my $orig_count = scalar @{ $zone->{'records'} };

## filter out matching records, tombstoning each removed one ##
my @kept = ();
for my $rec ( @{ $zone->{'records'} } ) {
    my $match = lc( $rec->{'name'} ) eq $rec_name;
    $match &&= $rec->{'type'} eq $rec_type if $rec_type;
    if ($match) {
        <[nameserv.zone.tombstone.add]>->( $zone_name, $rec );
    } else {
        push @kept, $rec;
    }
}
$zone->{'records'} = \@kept;

my $removed = $orig_count - scalar @{ $zone->{'records'} };

if ( $removed == 0 ) {
    return { mode => 'false', data => "record not found: $rec_name" };
}

$zone->{'serial'} = time();

<[nameserv.zone.save]>->($zone_name);

my $msg = sprintf( "removed %d record(s) from %s", $removed, $zone_name );
return { mode => 'true', data => $msg };

