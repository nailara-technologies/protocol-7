## [:< ##

# name  = sessions.secret.parent
# descr = dispatcher to a named secret-holder child. call with
#         ($name, 'RELEASE', '') to retrieve and tear down.

my $name = shift // '';
my $op   = shift // '';
my $data = shift // '';

my $entry = <sessions.secrets>->{$name};
if ( not defined $entry ) {
    <[base.logs]>->( 0, "sessions.secret: no secret held under '%s'", $name );
    return undef;
}

my $pid = $entry->{'pid'};
if ( not defined $pid or not <[base.exists.sub-process]>->($pid) ) {
    <[base.logs]>->( 0, "sessions.secret: '%s' child not alive", $name );
    delete <sessions.secrets>->{$name};
    return undef;
}

my $sock     = $entry->{'client_sock'};
my $data_b32 = encode_b32r($data);
my $req_line = sprintf( "%s %s\n", $op, $data_b32 );

my $written = syswrite( $sock, $req_line );
if ( not defined $written or $written != length($req_line) ) {
    <[base.logs]>->(
        0, "sessions.secret: '%s' " . "failed to write request", $name
    );
    return undef;
}

## bounded select/sysread read loop, same shape as sessions.holder.parent ##
my $response;
my $buf     = '';
my $start   = <[base.time]>->(1);
my $timeout = 7;

while ( ( <[base.time]>->(1) - $start ) < $timeout ) {
    my $rin = '';
    vec( $rin, fileno($sock), 1 ) = 1;
    my $nfound = select( $rin, undef, undef, 0.05 );
    next if not defined $nfound or $nfound <= 0;

    my $n = sysread( $sock, $buf, 65536, length($buf) );
    if ( defined $n and $n > 0 ) {
        if ( $buf =~ s|^(.+)\n||s ) {
            $response = $1;
            last;
        }
    } elsif ( defined $n and $n == 0 ) {
        last;    ## EOF ##
    }
}

if ( not defined $response ) {
    <[base.logs]>->(
        0, "sessions.secret: '%s' timeout waiting for child response", $name
    );
    return undef;
}

if ( $response =~ s|^OK\s+|| ) {
    return eval { decode_b32r($response) };
} else {
    $response =~ s|^ERR\s+||;
    <[base.s_warn]>->( 'sessions.secret: child error: %s <{C1}>', $response );
    return undef;
}

