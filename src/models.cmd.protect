## [:< ##

# name  = models.cmd.protect
# param = <checksum>
# descr = opt-in delete-protection for a checksum
# note  = delete-model refuses outright while a checksum
#         is on this list, even from an automated cleanup
#         sweep

my $checksum = $call->{'args'} // '';
$checksum =~ s|^\s+||;
$checksum =~ s|\s+$||;

unless ( length $checksum ) {
    return {
        'mode' => qw| size |,
        'data' => "Usage: protect <checksum>\n"
    };
}

<models.protected_checksums> //= <[models.trash.load_protected]>;

my $entry = <[models.resolve.entry]>->($checksum);
<models.protected_checksums>->{$checksum} = {
    'name'         => ( defined $entry ? ( $entry->{'name'} // '' ) : '' ),
    'protected_at' => <[base.ntime]>,
};

unless (<[models.trash.save_protected]>) {
    return {
        'mode' => qw| size |,
        'data' => "error: failed to persist protect-list\n"
    };
}

<[base.logs]>->( 1, '[protect] %s is now delete-protected', $checksum );

return {
    'mode' => qw| size |,
    'data' => "protected: $checksum\n"
};

