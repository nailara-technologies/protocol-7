## [:< ##

# name  = osf-cache.merkle.hash_leaf
# descr = bmw384 leaf hash : domain-separated raw digest
# param = { bytes => <raw leaf bytes> }
#
# the leaf hash construction of the stage 4 merkle tree : bmw384 over
# "\x00" . bytes [ the "\x00" prefix is the leaf domain - inner nodes
# use "\x01", so no byte string is both a leaf and an inner node ].
# returns the RAW 48-byte digest [ Digest::BMW->new(384), ->digest ] ;
# B32 through <[chk-sum.bmw.encode_digest]> is for storage \ wire only.

my $args  = shift            // {};
my $bytes = $args->{'bytes'} // '';

require Digest::BMW;    ## known dependency - loaded here ##
my $ctx = Digest::BMW->new(384);
$ctx->add("\x00");
$ctx->add($bytes);

return $ctx->digest;

