# name  = web-browser.callback.capture_paged_scroll_result
# descr = callback after a paged-capture window.scroll() JS call completes.
#         records the new scroll position and triggers the snapshot for this
#         position.

my $js_result = shift // '';
my $cb_params = shift;
my $position  = $cb_params->{'position'};

<window.scroll.pos> = $position;

<[base.logs]>->( 2, "capture_paged: scrolled to position %d", $position );

<[web-browser.handler.capture_paged_snapshot]>;

