## [:< ##

# name = data.mount.shm.permission.verify
# descr = Verify requester has permission to access SHM path

# thin zenka wrapper -> AMOS7::SHM::permission_verify
# inject the zenka group registry [ $data{'groups'} ] so the core stays
# branch-free ; matches the original group_contains lookup target exactly
my $header           = shift;
my $requester_pubkey = shift;
my $requested_path   = shift;
my $requested_rights = shift;

return AMOS7::SHM::permission_verify(
    $header,           $requester_pubkey, $requested_path,
    $requested_rights, $data{'groups'},
);

