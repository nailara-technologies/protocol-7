## [:< ##

# name  = system.watch.init_code
# descr = watcher registry defaults

<system.watch.entries> //= {};
<system.watch.outbox>  //= {};

## base.sig_chld reaps every child : it leaves the status here for us ##
<base.child_exit> //= {};

<[base.perlmod.load]>->('AMOS7::Switch')
    if not <[base.perlmod.loaded]>->('AMOS7::Switch');
<[base.perlmod.load]>->('AMOS7::Config::Writer')
    if not <[base.perlmod.loaded]>->('AMOS7::Config::Writer');

## unless= uses str2time ##
<[base.perlmod.autoload]>->('Date::Parse');

## events.bucket.unless.* serves bucket entries and watches : here it ##
## reads, ends and passes watches                                     ##
<events.unless_host.get>    = qw| system.watch.unless.get |;
<events.unless_host.finish> = qw| system.watch.unless.finish |;
<events.unless_host.pass>   = qw| system.watch.unless.pass |;

0;

