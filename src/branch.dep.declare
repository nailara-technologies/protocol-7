## [:< ##

# name  = branch.dep.declare
# descr = declare dependency edge between branch nodes
# param = { from, to, type }

my $params = shift // {};

my $from = $params->{'from'} // '';
my $to   = $params->{'to'}   // '';
my $type = $params->{'type'} // 'required';

return { 'mode' => 'false', 'data' => 'from node id required' }
    unless length $from;
return { 'mode' => 'false', 'data' => 'to node id required' }
    unless length $to;
return { 'mode' => 'false', 'data' => 'from node not found' }
    unless exists $data{'branch.nodes'}{$from};
return { 'mode' => 'false', 'data' => 'to node not found' }
    unless exists $data{'branch.nodes'}{$to};

return {
    'mode' => 'true',
    'data' => sprintf '%s -> %s [%s]',
    $from, $to, $type
    }
    if exists $data{'branch.deps'}{$from}{$to};

my $declared_at = <[base.ntime]>;

$data{'branch.deps'}{$from}{$to} = {
    'type'        => $type,
    'declared_at' => $declared_at,
};

$data{'branch.dep.reverse'}{$to}{$from} = TRUE;

<[base.logs]>->( 2, 'branch.dep.declare: %s -> %s [%s]', $from, $to, $type );

return {
    'mode' => 'true',
    'data' => sprintf '%s -> %s [%s]',
    $from, $to, $type
};

