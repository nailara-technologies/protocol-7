## [:< ##

# name  = base.chk-sum.jha
# descr = 32-bit unsigned long int version of jhash digest chksum

my $input = ref $ARG[0] eq 'SCALAR' ? ${ shift @ARG } : join '', @ARG;
return Digest::JHash::jhash($input)

