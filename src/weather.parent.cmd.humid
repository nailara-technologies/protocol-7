## [:< ##

# name  = weather.parent.cmd.humid
# descr = return outside air humidity in percent

my $stid = <weather.station_id>;

## first data still pending [ on-demand start ] : answer when it lands ##
my $parked = <[weather.parent.park_pending]>->( $call, qw| humid | );
return $parked if defined $parked;

my $current = <weather.data>->{$stid}->{'current'};

return {
    'mode' => qw| false |,
    'data' => 'no city selected (undefined station id)'
    }
    if not defined $stid;

my $humidity = $current->{'humidity'} // 'n|a';
$humidity .= "%" if $humidity =~ m|^\d+(\.\d+)?$|;

return { 'mode' => qw| true |, 'data' => $humidity }

