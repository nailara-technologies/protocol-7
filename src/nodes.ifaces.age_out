## [:< ##

# name  = nodes.ifaces.age_out
# param = <node entry> [ <now> ]
# descr = drop old node observations, keep the newest

my ( $node, $now ) = @ARG;
$now //= CORE::time();
my $max_age = <nodes.cfg.obs_max_age> // 1123200;    # [ 13 days ]
my $max_obs = <nodes.cfg.obs_max>     // 13;
my @keep    = sort { $b->{'seen'} <=> $a->{'seen'} }
    grep { $now - $ARG->{'seen'} <= $max_age } ( $node->{'obs'} // [] )->@*;
splice( @keep, $max_obs ) if @keep > $max_obs;
$node->{'obs'} = \@keep;
return scalar @keep;

