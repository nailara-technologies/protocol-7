## [:< ##

# name  = httpd.route.handler.web-status
# descr = GET /auth/status through the admission gate
# note  = GET /auth/status : refuse plaintext first [ stays first ], then
#         ask the web zenka's admission gate [ web.auth-status ] -- the
#         real socket facts [ peer address, tls ] are passed explicitly,
#         never a header ; the answer arrives at once [ 200 session info,
#         401, or 429 with Retry-After ] -- never queued
#         [ LOGIN-ADMISSION.md section 2 on all four paths ]

my $id      = shift;
my $args    = shift // {};
my $session = $data{'session'}->{$id};

## no token over plain http [ plugin.web.auth.refuse_plaintext ] ##
return 2 if <[plugin.web.auth.refuse_plaintext]>->($id);

my $headers = $session->{'http'}->{'request'}->{'headers'} // {};

## real socket facts : the admission source and the gate itself come from ##
## these, never from a header                                             ##
my $peer_addr = $session->{'http'}->{'request'}->{'client'}->{'addr'} // '';
my $peer_fh   = $session->{'handle'};
my $peer_tls  = ( ref $peer_fh and $peer_fh->isa('IO::Socket::SSL') ) ? 1 : 0;

$session->{'http'}->{'close'} = TRUE;

##  replace input watcher : keep EOF detection, disable timeout  ##
if ( defined $session->{'watcher'}{'input_handler'} ) {
    my $fd = $session->{'watcher'}{'input_handler'}->fd;
    $session->{'watcher'}{'input_handler'}->cancel;
    $session->{'watcher'}{'input_handler'} = Event->io(
        'fd'     => $fd,
        'cb'     => sub { &{ $code{'base.handler.read'} } },
        'poll'   => qw| r |,
        'prio'   => 1,
        'repeat' => FALSE,
        'data'   => $id,
        'desc'   => sprintf( '[%d] input handler [ no timeout ]', $id ),
    );
}

## header values : a linebreak cannot come from the http parser, but strip ##
## \r\n anyway -- send.local refuses to frame those                        ##
my $auth_header   = $headers->{'authorization'} // '';
my $cookie_header = $headers->{'cookie'}        // '';
for my $value ( $auth_header, $cookie_header ) {
    $value =~ s|[\r\n]+||g;
}

## the socket facts travel as multi-line ' key : value' param lines ##
## [ base.protocol-7.command.send.local ] ; status has no body      ##
<[protocol-7.route-send]>->(
    {   'command'   => qw| web.auth-status |,
        'call_args' => {
            'param' => {
                'peer_addr'     => $peer_addr,
                'peer_tls'      => $peer_tls,
                'auth_header'   => $auth_header,
                'cookie_header' => $cookie_header,
            },
        },
        'reply' => {
            'handler' => qw| httpd.handler.web-relay.auth |,
            'params'  => { 'http_sid' => $id },
        },
    }
);

return 0;    # [ deferred : the reply handler writes the response ]

