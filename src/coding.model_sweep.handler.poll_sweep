## [:< ##

# name  = coding.model_sweep.handler.poll_sweep
# descr = timer-driven per-backend model sweep cursor

my $event = shift;

## data lives on the watcher, not the raw event wrapper - same pattern as ##
## coding.self_test.handler.poll_switch                                   ##
my $timer_data = eval { $event->w->data } // {};
my $backend    = $timer_data->{'backend'} // '';

if ( !length $backend || $backend !~ m{^(gpu|cpu)$} ) {
    <[base.logs]>->( 0, '[model_sweep] no valid backend, stopping timer' );
    $event->w->cancel if defined $event->w and $event->w->is_active;
    return;
}

my $state = <coding.model_sweep_state>->{$backend};
if ( !defined $state ) {
    <[base.logs]>->(
        0, '[model_sweep] no state for backend=%s, stopping timer', $backend
    );
    $event->w->cancel if defined $event->w and $event->w->is_active;
    return;
}

my $candidates = $state->{'candidates'} // [];
my $idx        = $state->{'idx'}        // 0;
my $total      = scalar @$candidates;

my $cursor_file = 'state/model_sweep_cursor.yaml';

## helper : load cursor file from disk ##
my $load_cursor = sub {
    my $existing_yaml = <[file.zenka_dir.load]>->($cursor_file);
    return ( defined $existing_yaml and length $$existing_yaml )
        ? ( <[format.yaml.load_str]>->($$existing_yaml) // {} )
        : {};
};

## helper : persist cursor for a given idx ##
my $persist_cursor = sub {
    my ( $cursor_idx, $cursor_state, $paused_reason ) = @_;
    $cursor_state //= qw| running |;
    my $cursor_data = $load_cursor->();

    ## extension point : an optional 'template' field is reserved to sit ##
    ## alongside filter/candidates here [ templated test workflows ] --  ##
    ## unused until that work starts, do not write it yet                ##
    my $entry = {
        filter     => $state->{'filter'} // qw| default |,
        candidates => $candidates,
        idx        => $cursor_idx,
        started    => $state->{'started'} // <[base.ntime]>,
        state      => $cursor_state,
    };
    $entry->{'paused_reason'} = $paused_reason
        if defined $paused_reason and length $paused_reason;
    ## :no_yield: is operator intent, not derived state : it rides the  ##
    ## persisted cursor so it survives pause/resume and a zenka restart ##
    $entry->{'no_yield'} = TRUE if $state->{'no_yield'};
    $cursor_data->{$backend} = $entry;

    my $yaml_str = <[format.yaml.dump_str]>->($cursor_data);
    if ( length $yaml_str ) {
        <[file.zenka_dir.write]>->( $cursor_file, \$yaml_str, qw| > |, 0640 )
            or <[base.logs]>->(
            1, '[model_sweep] failed to persist cursor file [ %s ]',
            $cursor_file
            );
    }
};

## helper : remove this backend's cursor entry on completion ##
my $clear_cursor = sub {
    my $cursor_data = $load_cursor->();
    delete $cursor_data->{$backend};

    my $yaml_str = <[format.yaml.dump_str]>->($cursor_data);
    if ( length $yaml_str ) {
        <[file.zenka_dir.write]>->( $cursor_file, \$yaml_str, qw| > |, 0640 )
            or <[base.logs]>->(
            1, '[model_sweep] failed to ' . 'clear cursor file [ %s ]',
            $cursor_file
            );
    }
};

## helper : finish the sweep and log a per-status summary ##
my $finish_sweep = sub {
    $clear_cursor->();

    ## read counts back from coding.model_status [ source of truth ] ##
    my $status_data = <coding.model_status> // {};
    if ( !%$status_data ) {
        my $saved_ref = <[file.zenka_dir.load]>->('state/model_status.yaml');
        $status_data
            = ( defined $saved_ref and length $$saved_ref )
            ? ( <[format.yaml.load_str]>->($$saved_ref) // {} )
            : {};
    }

    my %counts;
    for my $checksum (@$candidates) {
        my $entry = $status_data->{$checksum}{$backend};
        next if ref $entry ne qw| HASH |;
        my $status = $entry->{'status'} // 'untested';
        $counts{$status}++;
    }

    my $summary = sprintf '[model_sweep] %s sweep complete : %d candidates',
        $backend, $total;
    for my $status ( sort keys %counts ) {
        $summary .= sprintf ' : %s=%d', $status, $counts{$status};
    }
    <[base.logs]>->( 1, $summary );

    ## drain deferred pinned-model switches : a :no_yield: sweep never   ##
    ## yields by definition, so a pin deferred during this run only gets ##
    ## its switch once the sweep is actually done [ drain site : natural ##
    ## completion ]                                                      ##
    <[coding.helper.drain_model_pin_deferrals]>->($backend);

    delete <coding.model_sweep_state>->{$backend};
    $event->w->cancel if defined $event->w and $event->w->is_active;
};

if ( $idx >= $total ) {
    $finish_sweep->();
    return;
}

## helper : circuit breaker -- classify the just-finished candidate's       ##
## verdict via the crash-class tag now carried in its model_status detail [ ##
## poll_switch / verify_inference_startup write sites ] and count           ##
## CONSECUTIVE identical [ crash_class, exit_status ] signatures.           ##
## in-memory, per-backend, never persisted -- reset on model-sweep-resume [ ##
## a stale pre-fix count would re-trip instantly ] and on any non-matching  ##
## outcome. trips ONLY on crash_before_ready :  crash_after_ready is        ##
## plausibly N genuinely distinct bad models [ auto- halting on it is a     ##
## false positive in the wrong direction ], and resource-insufficient       ##
## returns before any spawn at all, so transient contention never produces  ##
## a crash class to false-positive here                                     ##
my $check_breaker = sub {
    my ($checksum) = @_;
    return '' if !length $checksum;

    <coding.model_sweep_breaker> //= {};
    my $bk = <coding.model_sweep_breaker>->{$backend}
        //= { signature => '', count => 0 };

    my $match       = '';
    my $status_data = <coding.model_status> // {};
    my $entry       = $status_data->{$checksum}{$backend};
    if ( ref $entry eq qw| HASH |
        and ( $entry->{'detail'} // '' )
        =~ m{ \[ (crash_before_ready|crash_after_ready) \s+ exit=(\d+) \] }x )
    {
        $match = sprintf '%s exit=%d', $1, $2;
    }

    if ( length $match and $match =~ m{^crash_before_ready} ) {
        if ( $bk->{'signature'} eq $match ) {
            $bk->{'count'}++;
        } else {
            $bk->{'signature'} = $match;
            $bk->{'count'}     = 1;
        }
        if ( $bk->{'count'} >= 3 ) {
            return sprintf 'circuit-breaker : %dx %s', $bk->{'count'}, $match;
        }
    } else {
        ## any non-matching outcome [ success, timeout, crash_after_ready, ##
        ## or a different signature ] breaks the streak                    ##
        $bk->{'signature'} = '';
        $bk->{'count'}     = 0;
    }
    return '';
};

## helper : initiate switch-test-restore for the current candidate ##
my $start_candidate = sub {
    my $checksum = $candidates->[$idx] // '';
    if ( !length $checksum ) {
        $state->{'idx'} = $total;    ## force done on next tick ##
        return;
    }

    ## need a current model to restore to after the test ##
    my $original_model
        = $backend eq qw| gpu |
        ? ( <inference.backend.gpu.model_id> // '' )
        : ( <inference.backend.cpu.model_id> // '' );
    $original_model = <inference.model.amos_id> // ''
        if !length $original_model;

    if ( !length $original_model ) {
        <[base.logs]>->(
            0,
            '[model_sweep] %s : no current model to '
                . 'restore to, aborting sweep at candidate %s',
            $backend,
            $checksum
        );
        $state->{'idx'} = $total;
        return;
    }

    ## suppress monitor_inference_startup auto-self-test for this switch ##
    <coding.self_test_switch_in_progress> = TRUE;

    ## create poll_switch state, backend-aware ##
    <coding.self_test_switch_state> //= {};
    my $switch_id = <[base.gen_id]>->(<coding.self_test_switch_state>);

    my $prior_pid = ( <coding.inference_servers> // {} )->{$backend}{'pid'}
        // 0;

    <coding.self_test_switch_state>->{$switch_id} = {
        'reply_id'       => '',
        'target_model'   => $checksum,
        'test_model'     => $checksum,
        'original_model' => $original_model,
        'phase'          => qw| switching |,
        'started'        => <[base.time]>->(3),
        'dep_id'         => 0,
        'result'         => undef,
        'prior_pid'      => $prior_pid,
        'backend'        => $backend,
    };

    ## start the switch-test-restore poll for this candidate ##
    <[event.add_timer]>->(
        {   'interval' => 0.5,
            'repeat'   => TRUE,
            'handler'  => qw| coding.self_test.handler.poll_switch |,
            'data'     => { 'switch_id' => $switch_id },
            'desc'     => "model-sweep $backend $switch_id"
        }
    );

    ## issue the actual switch-model command ##
    eval {
        <[coding.cmd.switch-model]>
            ->( { args => sprintf '%s backend=%s', $checksum, $backend } );
        1;
    } or do {
        my $err = $@ || 'unknown error';
        <[base.logs]>->(
            0,        '[model_sweep] %s : switch-model call failed : %s',
            $backend, $err
        );
    };

    $state->{'switch_id'} = $switch_id;
    $state->{'phase'}     = qw| waiting |;

    <[base.logs]>->(
        1, '[model_sweep] %s : started candidate %d/%d : %s [switch_id=%s]',
        $backend, $idx + 1, $total, $checksum, $switch_id
    );
};

my $phase = $state->{'phase'} // qw| idle |;

if ( $phase eq qw| idle | ) {
    ## honor a pending pause request BEFORE issuing the next switch-model  ##
    ## call -- this is the one point in time where "no more calls will be  ##
    ## issued" is actually true [ the previous candidate's cycle already   ##
    ## reached its terminal transition ]. persist at CURRENT idx [ not N+1 ##
    ## : the next candidate never started, resume picks it up here ]       ##
    if ( $state->{'pause_requested'} ) {
        $state->{'pause_requested'} = FALSE;
        $state->{'yielding'}        = FALSE;    ## pause wins over yield ##
        delete $state->{'yield_since'};
        $state->{'state'} = qw| paused |;
        $persist_cursor->( $idx, qw| paused |, $state->{'paused_reason'} );
        <[base.logs]>->(
            1,
            '[model_sweep] %s : pause honored at idx=%d/%d : '
                . 'cursor persisted [ state=paused ], timer cancelled',
            $backend,
            $idx,
            $total
        );
        ## in-memory state deliberately stays DEFINED : cmd.model-sweep's ##
        ## refusal and model-sweep-status distinguish paused from running ##
        ## via it [ model-sweep-resume re-arms the timer ]                ##
        $event->w->cancel if defined $event->w and $event->w->is_active;
        return TRUE;
    }

    ## yield gate : real task activity wins over the sweep. a queued or     ##
    ## running task [ or a held backend lock ] means starting the next      ##
    ## candidate would kill its inference server out from under it -- wait  ##
    ## instead. in-memory only : the persisted cursor is NOT rewritten per  ##
    ## yield tick [ it already ticks at 1s intervals, and a long yield must ##
    ## not rewrite the YAML once a second for nothing ]. skipped entirely   ##
    ## for a :no_yield: run. runs AFTER the pause- request check above :    ##
    ## pause always wins over yield                                         ##
    if ( !$state->{'no_yield'} ) {
        my $idle = <[coding.helper.backend_idle]>;
        if ( !$idle->{'idle'} ) {
            my $now = <[base.time]>->(3);

            ## stream-aware yield gate : the flat 300s cap below must never ##
            ## fire while the task actually holding THIS backend's lock is  ##
            ## genuinely working -- that is real task activity, exactly     ##
            ## what yielding exists to let through. mirror                  ##
            ## coding.cmd.round-progress's lock -> state -> liveness        ##
            ## lookup, scoped to this one backend [ no cross-backend scan   ##
            ## needed : poll_sweep already knows its own $backend ] :       ##
            my $yield_hold = FALSE;   ## TRUE => real activity, no 300s cap ##
            my $yield_why  = 'no lock held on this backend';
            my $lock_task
                = ( <coding.state.backend> // {} )->{$backend}{'lock'};
            if ( defined $lock_task and length $lock_task ) {
                my $task_state = <[coding.async.state_machine]>
                    ->( qw| get |, $lock_task );
                my $http_state = $task_state->{'http_state'};
                if ( defined $task_state->{'round_tools_started'} ) {
                    ## tools-execution phase : NO ceiling anywhere else in  ##
                    ## this codebase for it either [ round-progress :       ##
                    ## "tools: %ds (no ceiling)" ; self_test_guard_ watcher ##
                    ## bounds only self-test probe guard slots, not real    ##
                    ## task tool execution -- no task-level tools watchdog  ##
                    ## exists ]. deliberately inherit the same stance here  ##
                    ## : never escalate on the flat 300s timer while the    ##
                    ## locked task is in its tools phase                    ##
                    $yield_hold = TRUE;
                    $yield_why  = 'task in tools phase [ no ceiling ]';
                } elsif ( ref $http_state eq qw| HASH | ) {
                    ## http/streaming phase : the SAME liveness signal    ##
                    ## async.http_timeout already extends its own ceiling ##
                    ## in place for [ stream_tps is_alive, shared so the  ##
                    ## definitions cannot drift apart ]                   ##
                    my $alive = <[coding.async.stream_tps]>->(
                        qw| is_alive |, $http_state
                    );
                    if ($alive) {
                        $yield_hold = TRUE;
                        $yield_why  = 'task stream alive';
                    } else {
                        $yield_why = 'task stream STALLED';
                    }
                } else {
                    ## lock held but no http_state yet [ between rounds,   ##
                    ## brief dispatch window ] : nothing to check liveness ##
                    ## against -- fall through to the flat 300s cap        ##
                    $yield_why = 'task pre-stream [ no http_state ]';
                }
            }

            if ( !$state->{'yielding'} ) {
                $state->{'yielding'}    = TRUE;
                $state->{'yield_since'} = $now;
                ## yielding must never overwrite the state axis when it is ##
                ## already paused or pause-requested                       ##
                $state->{'state'} = qw| yielding |
                    if ( $state->{'state'} // qw| running | )
                    !~ m{^(paused|pause-requested)$};
                <[base.logs]>->(
                    1,
                    '[model_sweep] %s : yielding to task activity at '
                        . 'idx=%d/%d [ %d active task%s, %d in flight ] [ '
                        . 'yield : %s ]',
                    $backend,
                    $idx,
                    $total,
                    $idle->{'active'},
                    <[base.cnt_s]>->( $idle->{'active'} ),
                    $idle->{'in_flight'},
                    $yield_why
                );
            }

            ## the whole point of yielding is to let a parked pinned task ##
            ## through : drain its deferred switch-model right here, the  ##
            ## same tick the yield is detected [ and every tick it keeps  ##
            ## yielding ], rather than waiting for a separate signal      ##
            <[coding.helper.drain_model_pin_deferrals]>->($backend);

            ## bounded, matching vision_switch_poll's own 300s bound : past ##
            ## that this is no longer "let real work finish", it is "the    ##
            ## queue never goes idle" -- escalate to a REAL, persisted      ##
            ## pause through the same mechanics a circuit- breaker pause    ##
            ## uses [ resume then requires :force: under the existing,      ##
            ## deliberately unnarrowed resume gate ]. while $yield_hold is  ##
            ## TRUE [ live stream or tools-phase task on this backend ]     ##
            ## wall-clock must NOT accumulate : real task activity wins, no ##
            ## matter how long -- reset the accumulation point every tick,  ##
            ## exactly like async.http_timeout extending its ceiling in     ##
            ## place for the SAME stream                                    ##
            if ($yield_hold) {
                $state->{'yield_since'} = $now;
            } elsif ( $now - ( $state->{'yield_since'} // $now ) > 300 ) {
                $state->{'yielding'} = FALSE;
                delete $state->{'yield_since'};
                $state->{'state'}         = qw| paused |;
                $state->{'paused_reason'} = qw| yield-timeout |;
                $persist_cursor->( $idx, qw| paused |, qw| yield-timeout | );
                <[base.logs]>->(
                    0,
                    '[model_sweep] %s : yield exceeded 300s at idx=%d/%d -- '
                        . 'sweep paused [ yield-timeout ], resume with '
                        . 'model-sweep-resume %s :force:',
                    $backend,
                    $idx,
                    $total,
                    $backend
                );
                $event->w->cancel
                    if defined $event->w and $event->w->is_active;
                return TRUE;
            }

            ## still yielding : timer continues, low-verbosity progress log ##
            ## [ same style vision_switch_poll uses for its own ]           ##
            <[base.logs]>->(
                2,
                '[model_sweep] %s : waiting for idle : %d '
                    . 'active task%s, %d in flight [ yield : %s ]',
                $backend,
                $idle->{'active'},
                <[base.cnt_s]>->( $idle->{'active'} ),
                $idle->{'in_flight'},
                $yield_why
            ) if int($now) % 5 == 0;

            return TRUE;    ## skip $persist_cursor : nothing changed ##
        }
    }

    if ( $state->{'yielding'} ) {
        ## idle again : yielding is self-clearing by construction, no ##
        ## operator action, no resume command                         ##
        $state->{'yielding'} = FALSE;
        delete $state->{'yield_since'};
        $state->{'state'} = qw| running |
            if ( $state->{'state'} // '' ) eq qw| yielding |;
        <[base.logs]>->(
            1, '[model_sweep] %s : queue idle again, resuming at idx=%d/%d',
            $backend, $idx, $total
        );
    }

    $start_candidate->();
    $persist_cursor->($idx);
    return TRUE;
}

if ( $phase eq qw| waiting | ) {
    my $switch_id = $state->{'switch_id'} // '';
    my $switch_state
        = defined $switch_id
        ? <coding.self_test_switch_state>->{$switch_id}
        : undef;

    if ( !defined $switch_state ) {
        ## terminal phase reached : advance cursor ##
        <[base.logs]>->(
            1, '[model_sweep] %s : candidate %d/%d finished, advancing',
            $backend, $idx + 1, $total
        );
        $idx++;
        $state->{'idx'}       = $idx;
        $state->{'phase'}     = qw| idle |;
        $state->{'switch_id'} = '';

        ## circuit breaker : read the verdict of the candidate that just    ##
        ## finished [ the ONLY place per-candidate outcomes are observed in ##
        ## this loop ]. auto-PAUSE on a trip, never cancel -- cancel clears ##
        ## the cursor and destroys the frozen candidate list, which is      ##
        ## exactly what the operator needs intact to resume after fixing    ##
        ## the actual cause                                                 ##
        if ( my $trip_reason
            = $check_breaker->( $candidates->[ $idx - 1 ] // '' ) ) {
            $state->{'state'}         = qw| paused |;
            $state->{'paused_reason'} = $trip_reason;
            $persist_cursor->( $idx, qw| paused |, $trip_reason );
            <[base.logs]>->(
                0,
                '[model_sweep] %s : circuit breaker tripped at idx=%d/%d : '
                    . '%s -- sweep auto-paused, resume with '
                    . 'model-sweep-resume %s :force: after fixing the cause',
                $backend,
                $idx,
                $total,
                $trip_reason,
                $backend
            );
            $event->w->cancel if defined $event->w and $event->w->is_active;
            return TRUE;
        }

        $persist_cursor->($idx);
        ## next tick will either start the next candidate or finish ##
        return TRUE;
    }

    ## still waiting on the current switch cycle ##
    <[base.logs]>->(
        2, '[model_sweep] %s : waiting on candidate %d/%d [switch_id=%s]',
        $backend, $idx + 1, $total, $switch_id
    ) if int( <[base.time]>->(3) ) % 5 == 0;

    return TRUE;
}

## unknown phase : defensive cleanup ##
<[base.logs]>->(
    0,        '[model_sweep] %s : unknown phase %s, aborting sweep',
    $backend, $phase
);
$state->{'idx'} = $total;
return TRUE;

