## [:< ##

# name   = coding.keepalive.start
# descr  = after a start : read the registry, arm
# args   = the timer event [ not used ]

<[coding.sessions.store]>;
<[coding.keepalive.watch]>;
<[coding.keepalive.arm]>;
return TRUE;

