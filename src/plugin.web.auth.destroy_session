## [:< ##

# name  = plugin.web.auth.destroy_session
# descr = invalidate session (logout) — move to expired bucket
# param = token string or token_hash string

my $input = shift // '';
return FALSE if not length $input;

my $token_hash;
if ( length $input == 13 and $input =~ m|^[A-Z0-9]+$| ) {
    ## already a BMW-L13 hash ##
    $token_hash = $input;
} else {
    $token_hash = <[chk-sum.bmw.L13-str]>->($input);
    return FALSE if not defined $token_hash;
}

my $session_base = <[plugin.web.auth.session.path]>;
my $active_file  = "$session_base/active/$token_hash/session.yaml";

return FALSE if not -f $active_file;

## load session data before moving ##
my $session_data = <[plugin.web.auth.session.read]>->($token_hash);
return FALSE if not defined $session_data;

my $epoch       = <[base.ntime.epoch_timestamp]> // time;
my $expired_dir = "$session_base/expired/$epoch";

my $user = <system.amos-zenka-user> // qw| protocol-7 |;

if ( not -d $expired_dir ) {
    my $group = <[plugin.web.auth.store.group]>;
    <[file.make_path]>->( $expired_dir, 02770, $user, $group );
}

my $expired_file = "$expired_dir/$token_hash.yaml";

## write to expired location then remove active ##
my $yaml_str = eval { YAML::XS::Dump($session_data) };
if ($@) {
    <[base.s_warn]>->(
        'plugin.web.auth.destroy_session : yaml dump error : %s', $@
    );
    return FALSE;
}

my $fh = <[file.open]>->( $expired_file, qw| :raw |, qw| > |, TRUE, 0640 );
if ( not defined $fh ) {
    <[base.s_warn]>->(
        'plugin.web.auth.destroy_session : cannot write %s',
        $expired_file
    );
    return FALSE;
}
print {$fh} $yaml_str;
close($fh)
    or <[base.s_warn]>->('plugin.web.auth.destroy_session : close error');

## umask-proof : the prune runs as yet another uid [ see session.write ] ##
chmod 0660,
    $expired_file
    or <[base.s_warn]>->(
    'plugin.web.auth.destroy_session : chmod 0660 failed [ %s ]',
    $expired_file
    );

if ( unlink($active_file) ) {
    rmdir "$session_base/active/$token_hash";    ## remove empty parent dir ##
    <[base.logs]>->(
        2, 'plugin.web.auth : session destroyed [ %s ]', $token_hash
    );
    return TRUE;
} else {
    <[base.s_warn]>->(
        'plugin.web.auth.destroy_session : unlink %s failed : %s',
        $active_file, <[base.str.os_err]>
    );
    return FALSE;
}

