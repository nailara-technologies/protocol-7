# name  = models.decision.recommendation_base.find_models_for_context
# descr = Find models suitable for a specific context

my ( $all_models, $context ) = @ARG;

return [] unless $all_models && ref($all_models) eq 'ARRAY';

# Context to category mapping
my %context_categories = (
    real_time   => [qw| vision real_time |],
    interactive => [qw| vision reasoning |],
    streaming   => [qw| streaming video |],
    batch       => [qw| analysis reasoning |],
    default     => [qw| general |],
);

my $target_categories = $context_categories{$context}
    // $context_categories{default};

my @matching = grep {
    my $model    = $_;
    my $category = $model->{metadata}->{category} // '';
    grep { $_ eq $category } @$target_categories;
} @$all_models;

return \@matching;

