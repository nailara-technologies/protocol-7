## [:< ##

# name   = claude.live.sessions
# descr  = registered live sessions [ memory only ]
# args   = [ names ]
# return = name -> { socket token since sid } ; names :
#          every name registered with a sid -> that sid

## the inbox tokens live in this closure, never in %data : %data is shown  ##
## by dump \ status paths and inherited by forked children. a restart of   ##
## the zenka \ reload of this module empties it : the mcp server registers ##
## again only after its own cube link reconnects [ open ]                  ##

state %sessions = ();
## kept when a session goes : an old name still finds its sid ##
state %names = ();
return ( $ARG[0] // '' ) eq qw| names | ? \%names : \%sessions;

