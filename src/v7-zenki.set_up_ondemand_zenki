# name  = v7-zenki.set_up_ondemand_zenki
# descr = set up specified zenki for ondemand startup

<v7-zenki.ondemand_zenki> = [];

foreach my $zenka_name (@ARG) {
    my $zenka_config   = <v7-zenki.start_setup.zenki.config>->{$zenka_name};
    my $start_ondemand = $zenka_config->{'start'}->{'on-demand'} // 0;
    push( <v7-zenki.ondemand_zenki>->@*, $zenka_name ) if $start_ondemand;
}

