## [:< ##

# name  = events.bucket.get
# descr = the bucket of an owner : memory, file, new
# args   = owner zenka, create [ TRUE : a missing bucket is created ]
# return = bucket hash ref { owner, entries => { id => entry }, order => [ id .. ] }
#          or undef when it does not exist and create is not set

my ( $owner, $create ) = @ARG;
<events.buckets> //= {};
return <events.buckets>->{$owner} if defined <events.buckets>->{$owner};
my $bucket = <[events.bucket.load]>->($owner);
return $bucket if defined $bucket;
return undef   if not $create;
return <events.buckets>->{$owner}
    = { 'owner' => $owner, 'entries' => {}, 'order' => [] };

