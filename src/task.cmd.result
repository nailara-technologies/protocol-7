## [:< ##

# name  = task.cmd.result
# descr = return full untruncated result of a task

my $task_id = $call->{'args'} // '';
$task_id = uc( substr( $task_id, 0, 7 ) );

return { 'mode' => qw| false |, 'data' => 'task id required' }
    unless length $task_id;

my $task = <task.queue>->{$task_id} // <task.history>->{$task_id};

return { 'mode' => qw| false |, 'data' => "task $task_id not found" }
    unless defined $task;

my $result = $task->{'result'};

return { 'mode' => qw| false |, 'data' => 'no result yet' }
    unless defined $result and length $result;

return { 'mode' => qw| size |, 'data' => $result };

