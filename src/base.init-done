## [:< ##

# name  = base.init-done
# descr = called after module loading and initialization is done
# param = [hybrid-init:TRUE|FALSE]

## set initialized in zenki other than cube? [ hybrid, non-v7 managed ]
my $hybrid_init = <[base.cfg_bool]>->( shift // FALSE );

if ( defined <zenka.init_return> and <zenka.init_return> == TRUE ) {
    warn 'skipping init-done [ already completed ] <{C1}>';
    return <zenka.init_return>;
}

## tracking not defined or loaded subroutines ##
<[base.referenced_subroutines.clear_from_disk]>;

<[base.log]>->( 2, 'init-done completed [ success ]' );

<system.zenka.initialized> = TRUE
    if $hybrid_init or <system.zenka.name> eq qw| cube |;

## hybrid zenki never receive 'verify-instance' [ only v7-zenki sends it, to ##
## the zenki it started ] : run the deferred callbacks here instead         ##
<[base.callback.run_initialized]> if $hybrid_init;

return <zenka.init_return> = TRUE;    ## true ##

