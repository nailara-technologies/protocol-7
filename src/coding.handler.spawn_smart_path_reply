# name  = coding.handler.spawn_smart_path_reply
# descr = Handle async path reply for spawn_smart

my $reply  = shift;
my $params = $reply->{'params'} // {};

my $amos_id = $params->{'amos_id'} // '';
my $backend = $params->{'backend'} // 'gpu';
my $port    = $params->{'port'}    // ( $backend eq 'gpu' ? 8000 : 8001 );

## on_done threaded through from the original spawn_smart call [ same    ##
## {handler,params} shape as plugin.usage.kimi.refresh_token ] -- this   ##
## reply handler is the terminal point of the amos-path-async branch, so ##
## the caller's callback fires HERE instead of being a dead end          ##
my $on_done = $params->{'on_done'};
$on_done = undef unless ref $on_done eq qw| HASH |;

my $dispatch_on_done = sub {
    my $result = shift;
    if (    ref $on_done eq qw| HASH |
        and length( $on_done->{'handler'} // '' )
        and exists $code{ $on_done->{'handler'} } ) {
        my $call_params = { %{ $on_done->{'params'} // {} } };
        $call_params->{'spawn_result'} = $result;
        $call_params->{'backend'}      = $backend;
        $code{ $on_done->{'handler'} }->($call_params);
    }
    return $result;
};

<[base.logs]>->(
    2, '[spawn_smart_path_reply] received path for amos=%s', $amos_id
);

## Parse YAML reply from models zenka ##
my $reply_data = $reply->{'data'} // '';
my $entry      = eval { YAML::XS::Load($reply_data) };
if ( $@ || !ref $entry ) {
    <[base.logs]>->(
        0, '[spawn_smart_path_reply] failed to parse reply: %s', $@
    );
    $dispatch_on_done->(FALSE);
    return FALSE;
}

my $model_path  = $entry->{'file_path'}   // '';
my $mmproj_path = $entry->{'mmproj_path'} // '';

unless ( length $model_path && -f $model_path ) {
    <[base.logs]>->(
        0, '[spawn_smart_path_reply] invalid path: %s', $model_path
    );
    $dispatch_on_done->(FALSE);
    return FALSE;
}

## Spawn the server ##
<[base.logs]>->(
    1,        '[spawn_smart_path_reply] spawning %s server with %s',
    $backend, $model_path
);

my $result = <[coding.spawn_inference_server]>->(
    {   backend     => $backend,
        model_path  => $model_path,
        mmproj_path => $mmproj_path,
        port        => $port,
        amos_id     => $amos_id,
    }
);

if ( $result && $result->{'success'} ) {
    <[base.logs]>->(
        1, '[spawn_smart_path_reply] %s server spawned successfully', $backend
    );
} else {
    <[base.logs]>->(
        0,        '[spawn_smart_path_reply] failed to spawn %s server: %s',
        $backend, $result->{'error'} // 'unknown'
    );
}

$dispatch_on_done->( ( $result && $result->{'success'} ) ? TRUE : FALSE );

return $result;

