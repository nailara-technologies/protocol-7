## [:< ##

# name  = external.cmd.revoke-link
# param = <label>
# descr = remove a link authorized with authorize-link
# note  = drops the 'p7-link:<label>' line from ~/.ssh/authorized_keys and
#         ~/.n/remote-keys/authorized/cube/<label>.public [ the symlink ] with
#         its pin in incoming/. an open link keeps its session until it closes

my ($label) = grep {length} split m|\s+|, $call->{'args'} // '';

return { 'mode' => qw| false |, 'data' => 'usage : revoke-link <label>' }
    if not defined $label or $label !~ m|^[a-z0-9][a-z0-9-]{2,31}$|;

my $home = ( getpwuid($EUID) )[7] // '';
my $tag  = "p7-link:$label";
my @done;

my $ak_file = "$home/.ssh/authorized_keys";
if ( open my $ak_fh, '<', $ak_file ) {
    my @lines = <$ak_fh>;
    close $ak_fh;
    my @kept = grep { not m|\s\Q$tag\E\s*$| } @lines;
    if ( @kept != @lines ) {
        my $ak_tmp = "$ak_file.p7-link.$PID";
        if ( open my $out_fh, '>', $ak_tmp ) {
            print {$out_fh} @kept;
            if (    close($out_fh)
                and chmod( 0600, $ak_tmp )
                and rename( $ak_tmp, $ak_file ) ) {
                push @done, 'ssh line';
            } else {
                unlink $ak_tmp;
            }
        }
    }
}

## the authorizing symlink first, then the pin it points at ##
my $key_vars = <[crypt.C25519.key_vars]>;
my $link = catfile( $key_vars->{'auth_dir'}, qw| cube |, "$label.public" );
my $pin  = catfile( $key_vars->{'incoming_dir'}, "$label.public" );
push @done, 'cube authorization' if ( -l $link or -e $link ) and unlink $link;
push @done, 'cube key pin'       if -e $pin                  and unlink $pin;

<[base.logs]>->(
    0,      '<< link revoked : %s [ %s ] >>',
    $label, join( ', ', @done ) || 'nothing found'
) if @done;

return {
    'mode' => qw| true |,
    'data' => @done
    ? "link '$label' revoked : " . join( ', ', @done )
    : "link '$label' : nothing to revoke"
};

