## [:< ##

# name  = models.task.startup
# descr = arm remote streams + poll, scan local queues
# notes = called from cfg/zenki/models/zenka.v7 after the privilege drop
#         and from models.init_code on a reload only [ $reinit ], also
#         from models.cmd.set-zenki after a run time list change. the
#         local task zenka 'task' arms nothing : it notifies
#         models.task-notify itself -- so a restart loses every task
#         created while models was down : one recovery scan of each
#         listed local zenka's pending queue per startup heals it [ the
#         check-next reply claims the first, each completion re-scans
#         the rest ]. remote listed zenki need no scan : the notice
#         stream + fallback poll cover them [ models.task.subscribe ]

## a reload re-arms : cancel the running timer, never two side by side ##
my $old_timer = <models.task.poll.timer>;
$old_timer->cancel if defined $old_timer and $old_timer->is_active;
<models.task.poll.timer> = undef;

## local listed task zenki have no stream + poll -- their notify fires at   ##
## create time only, so a restart loses every task created while models was ##
## down [ HWO live 2026-10-24 : two pinned assessments pending for 30+ min, ##
## never notified after the restart ]. one recovery scan per startup : the  ##
## check-next reply claims the first pending task, each task completion     ##
## re-scans the queue                                                       ##
foreach my $zenka (<[models.task.zenki]>) {
    next if $zenka ne qw| task |;
    my $scan = <[protocol-7.route-send]>->(
        {   'command'   => sprintf( qw| %s.queue |, $zenka ),
            'call_args' => { 'args' => qw| status=pending | },
            'reply'     => {
                'handler' => qw| models.handler.task-poll-step |,
                'params'  => { 'step' => 'check-next', 'zenka' => $zenka }
            }
        }
    );
    <[base.logs]>->(
        1, ': task zenka %s : pending recovery scan %s',
        $zenka, ( $scan and $scan > 0 ) ? 'sent' : 'not routed'
    );
}

return FALSE if not <[models.task.remote]>;

my @remote = grep { $ARG ne qw| task | } <[models.task.zenki]>;

## a set-zenki shrink drops the streams of zenki no longer listed ##
my %listed = map { $ARG => 1 } @remote;
foreach my $zenka ( keys %{ <models.task.streams> // {} } ) {
    next if $listed{$zenka};
    my $state = <models.task.streams>->{$zenka} // {};
    <[strm.local.cancel]>->( $state->{'cmd_id'} )
        if $state->{'subscribed'} and defined $state->{'cmd_id'};
    delete <models.task.streams>->{$zenka};
}

my $interval = <models.cfg.task_poll_interval> // 30;
$interval = 30 if $interval !~ m|^\d+$| or $interval < 5;

<models.task.poll.timer> = <[event.add_timer]>->(
    {   'after'    => 3,
        'interval' => $interval,
        'repeat'   => TRUE,
        'handler'  => qw| models.handler.task-poll |,
    }
);

<[base.logs]>->(
    1,
    ': remote task zenki [ %s ] : notice stream + %d s poll armed',
    join( ' ', @remote ), $interval
);

return TRUE;

