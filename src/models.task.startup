## [:< ##

# name  = models.task.startup
# descr = arm the remote task notice streams + fallback poll timer
# notes = called from cfg/zenki/models/zenka.v7 after the privilege drop
#         and from models.init_code on a reload only [ $reinit ], also
#         from models.cmd.set-zenki after a run time list change. the
#         local task zenka 'task' arms nothing : it notifies
#         models.task-notify itself. the timer's first tick subscribes
#         every listed remote zenka, every tick polls '<zenka>.next'
#         and retries a dropped or unanswered subscription
#         [ models.task.subscribe ] -- each zenka independent, one down
#         never blocks the others

## a reload re-arms : cancel the running timer, never two side by side ##
my $old_timer = <models.task.poll.timer>;
$old_timer->cancel if defined $old_timer and $old_timer->is_active;
<models.task.poll.timer> = undef;

return FALSE if not <[models.task.remote]>;

my @remote = grep { $ARG ne qw| task | } <[models.task.zenki]>;

## a set-zenki shrink drops the streams of zenki no longer listed ##
my %listed = map { $ARG => 1 } @remote;
foreach my $zenka ( keys %{ <models.task.streams> // {} } ) {
    next if $listed{$zenka};
    my $state = <models.task.streams>->{$zenka} // {};
    <[strm.local.cancel]>->( $state->{'cmd_id'} )
        if $state->{'subscribed'} and defined $state->{'cmd_id'};
    delete <models.task.streams>->{$zenka};
}

my $interval = <models.cfg.task_poll_interval> // 30;
$interval = 30 if $interval !~ m|^\d+$| or $interval < 5;

<models.task.poll.timer> = <[event.add_timer]>->(
    {   'after'    => 3,
        'interval' => $interval,
        'repeat'   => TRUE,
        'handler'  => qw| models.handler.task-poll |,
    }
);

<[base.logs]>->(
    1,
    ': remote task zenki [ %s ] : notice stream + %d s poll armed',
    join( ' ', @remote ), $interval
);

return TRUE;

