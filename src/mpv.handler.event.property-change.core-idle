## [:< ##

# name = mpv.handler.event.property-change.core-idle

my $cube_idle = shift->{'data'};
return
    if defined <mpv.status.core-idle>
    and ( not defined $cube_idle
    or $cube_idle !~ m,^1|0$,
    or $cube_idle == <mpv.status.core-idle> );

<mpv.status.core-idle> = $cube_idle;
<mpv.fade_idle_volume> //= TRUE;

if ( $cube_idle and <mpv.fade_idle_volume> ) {

    ## intentionally not calling mpv.callback.silenced here any more --    ##
    ## pause/resume [ mpv.handler.cmd_prop.pause ] and stop                ##
    ## [ mpv.cmd.stop ] each now own their own silence/fade sequencing     ##
    ## directly and deterministically. this event fires too late           ##
    ## [ mpv already stopped producing audio by the time core-idle flips ] ##
    ## to be useful for a fade, and having it *also* run mpv.callback.     ##
    ## silenced's device reassignment here raced with, and could swallow   ##
    ## the start of, do_resume's fade-in.,                                 ##
} else {    # LLL: s|start|current| volume ..,
    <[mpv.cmd.fade]>->( { qw| args | => <mpv.current.volume_target> } );
}

