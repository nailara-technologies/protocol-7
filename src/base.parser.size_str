## [:< ##

# name = base.parser.size_str

return 'n/a' if not defined $_[0] or $_[0] !~ m|^\d+$|;

my $size_str = shift;

$size_str =~ s|0{9}$|G|;
$size_str =~ s|(\d\d)0{7}$|.$1G| if $size_str =~ m|^\d{10,}$|;
$size_str =~ s|0{6}$|M|          if $size_str =~ m|^\d+$|;
$size_str =~ s|(\d\d)0{4}$|.$1M| if $size_str =~ m|^\d{7,}$|;
$size_str =~ s|0{3}$|K|          if $size_str =~ m|^\d+$|;
$size_str =~ s|(\d)00$|.$1K|     if $size_str =~ m|^\d{5,}$|;
$size_str =~ s|\.([1-9]+)0+(\w)$|.$1$2|;

return $size_str;

