## [:< ##

# name  = base.call
# descr = utility wrapper for calling modules with named action interface

my ( $module, $action, @args ) = @ARG;

return { success => FALSE, error => 'module name required' }
    unless defined $module;

$action //= qw| get |;

## call the module ##
my $coderef = $code{$module};
return { success => FALSE, error => "module not found: $module" }
    unless defined $coderef && ref $coderef eq qw| CODE |;

my $result = $coderef->( $action, @args );

return $result;

