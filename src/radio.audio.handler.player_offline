## [:< ##

# name  = radio.audio.handler.player_offline
# descr = v7.notify_offline reply: mark mpv offline and schedule re-init

my $reply    = shift;
my $instance = $reply->{'params'}{'instance'} // 'mpv[audio-0]';

##  guard: must be a TRUE reply  ##
if ( $reply->{'cmd'} ne 'TRUE' ) {
    <[base.logs]>->(
        1, '[radio.audio] notify_offline for %s returned non-TRUE', $instance
    );
    return;
}

<[base.logs]>->( 1, '[radio.audio] %s offline', $instance );

<radio.audio.active> = 0;

##  stop playback-health watchdog  ##
if ( defined <radio.audio.watchdog.watcher> ) {
    <radio.audio.watchdog.watcher>->cancel;
    delete <radio.audio.watchdog.watcher>;
}
<radio.audio.watchdog.idle_count> = 0;

##  guard: do not double-schedule re-init  ##
return if defined <radio.audio.reinit_watcher>;

<radio.audio.reinit_watcher> = <[event.add_timer]>->(
    {   after   => 3.0,
        handler => qw| radio.audio.init |,
    }
);

0;

