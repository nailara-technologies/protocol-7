## [:< ##

# name  = v7-zenki.parser.dependency_chain

my $object_id = shift;

return '--' if not exists <dependency.chain>->{$object_id};

return join(
    ' ',
    map {
        my $object = <dependency.object>->{$ARG};
        ## condition objects [ unix_group:httpsd .. ] carry type+name, no ##
        ## zenka_name : render them in their cfg syntax                   ##
        defined $object->{'zenka_name'}
            ? $object->{'zenka_name'}
            : sprintf( '%s:%s',
            $object->{'type'} // qw| ? |,
            $object->{'name'} // qw| ? | )
    } @{ <dependency.chain>->{$object_id} }
);

