## [:< ##

# name   = stream_child.alive
# descr  = is the child [ or its process group ] still there
# param  = handle
# return = TRUE \ FALSE

my $handle = shift;
return FALSE if not defined $handle or not defined $handle->{'pid'};
my $target = $handle->{'group'} ? -$handle->{'pid'} : $handle->{'pid'};
return CORE::kill( 0, $target ) ? TRUE : FALSE;

