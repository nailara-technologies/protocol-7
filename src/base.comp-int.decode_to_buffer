# name  = base.comp-int.decode_to_buffer
# descr = decode BER compressed integer buffer to arrayref of integers

my $buffer = shift;

if ( not length( $buffer // '' ) ) {
    warn 'expected BER compressed integer buffer [ got nothing ] <{C1}>';
    return undef;
}

my $valid = <[base.comp-int.is_valid]>->($buffer);

if ( not $valid ) {
    warn 'invalid BER compressed integer buffer [ not terminated ] <{C1}>';
    return undef;
}

my @decoded = unpack qw| w* |, $buffer;

return \@decoded;

