## [:< ##

# name  = crypt.C25519.cmd.host-root-id
# descr = host-root key id [ 77 chars, from the .dlg leaf ]
#
# the key id clients pin [ data/md/design/HOST-ROOT-DELEGATION.md ],
# for an out of band comparison. read from the delegation statement
# [ cube cannot read root/ ] ; the statement must parse and carry a valid
# signature by the host-root it names.

my $key_vars = <[crypt.C25519.key_vars]>;
my $s_name   = ref $key_vars eq qw| HASH | ? $key_vars->{'key_name'} : undef;

my $false = sub { return { 'mode' => qw| false |, 'data' => shift } };

return $false->('trust modules not loaded')
    if ref $code{'trust.statement'} ne qw| CODE |
    or ref $code{'trust.key_id'} ne qw| CODE |
    or ref $code{'trust.chain'} ne qw| CODE |;

my $dlg_file = <[crypt.C25519.delegation_file]>->($s_name);
return $false->('no delegation file path') if not defined $dlg_file;

## the .dlg holds the chain [ one statement per line, leaf first ] : the ##
## host-root is the LEAF's issuer                                        ##
open( my $dlg_fh, '<:raw', $dlg_file )
    or return $false->("no delegation [ $OS_ERROR ]");
my $got = read( $dlg_fh, my $dlg_content, 2060 );
close($dlg_fh);
return $false->('delegation not readable')
    if not defined $got
    or $got > 2052;

my ( $chain, $chain_why ) = <[trust.chain]>->( qw| file |, $dlg_content );
return $false->("delegation not valid [ $chain_why ]") if not defined $chain;

my ( $st, $why ) = <[trust.statement]>->( qw| parse_wire |, $chain->[-1] );
return $false->("delegation not valid [ $why ]") if not defined $st;

return $false->('delegation signature not valid')
    if not Crypt::Ed25519::verify( $st->{'statement'}, $st->{'issuer_pub'},
    $st->{'sig'} );

my $key_id = <[trust.key_id]>->( $st->{'issuer_pub'} );
return $false->('no key id') if not defined $key_id;

return { 'mode' => qw| true |, 'data' => $key_id };

