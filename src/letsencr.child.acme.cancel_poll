## [:< ##

# name  = letsencr.child.acme.cancel_poll
# descr = cancel a pending order poll timer

my $p = shift // {};

my $order_id = ref $p eq qw| HASH | ? $p->{'order_id'} // '' : $p;

my $order
    = length $order_id
    ? <letsencr.child.orders>->{$order_id}
    : undef;

return FALSE if ref $order ne qw| HASH |;
return FALSE if not defined $order->{'timer'};

eval { $order->{'timer'}->cancel };
delete $order->{'timer'};

return TRUE;

