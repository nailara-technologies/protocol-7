## [:< ##

# name  = io.ssl.ip.handshake.cleanup
# descr = cleanup ssl handshake state [ watchers, timers, socket ]

my ( $hs_id, $keep_socket ) = @ARG;

return unless exists $data{'ssl_handshake'}{$hs_id};

my $hs = $data{'ssl_handshake'}{$hs_id};

## cancel io watcher ##
if ( defined $hs->{'io_watcher'} and $hs->{'io_watcher'}->can('cancel') ) {
    $hs->{'io_watcher'}->cancel if $hs->{'io_watcher'}->is_active;
}

## cancel timeout timer ##
if ( defined $hs->{'timer'} and $hs->{'timer'}->can('cancel') ) {
    $hs->{'timer'}->cancel if $hs->{'timer'}->is_active;
}

## close socket unless told to keep it [ on successful handshake ] ##
if ( not $keep_socket and defined $hs->{'socket'} ) {
    if ( defined fileno( $hs->{'socket'} ) ) {
        eval { shutdown( $hs->{'socket'}, 2 ) };
        close( $hs->{'socket'} );
    }
}

## remove handshake state ##
delete $data{'ssl_handshake'}{$hs_id};

