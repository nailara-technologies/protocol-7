## [:< ##

# name  = os-pkg.init_code
# descr = detect OS distribution and select package backend
# param = [ reinit ]

my $reinit = shift // FALSE;

if ( $reinit and defined <os-pkg.backend_type> ) {
    <[base.log]>->( 2, 'skipping os-pkg re-init [ backend already set ]' );
    return 0;
}

<[base.log]>->( 2, 'initializing os-pkg zenka..,' );

## the OS family comes from the shared detector  [ the same detect_os      ##
## sys-deps.init_code, v7-zenki and the debian zenka's root runner use ] ; ##
## the os-release display data comes from the same module, no parsing of   ##
## its own here                                                            ##
<[base.perlmod.load]>->('AMOS7::deps::os_package')
    if not <[base.perlmod.loaded]>->('AMOS7::deps::os_package');

my $family = AMOS7::deps::os_package::detect_os();

my %os_release = %{ AMOS7::deps::os_package::read_os_release() };

my $id = $os_release{'ID'} // '';

## the backend type is the family when a backend module exists for it, ##
## undef otherwise [ same 'unsupported' replies as before ]            ##
my $backend_type
    = AMOS7::deps::os_package::backend_available($family) ? $family : undef;

## optional config override [ os-pkg.backend = <type> in zenka config ] ##
my $override = <os-pkg.backend>;
if ( defined $override and length $override ) {
    $backend_type
        = AMOS7::deps::os_package::backend_available($override)
        ? $override
        : undef;
    <[base.log]>->( 2, "  backend override from config : $override" );
}

<os-pkg.os_release>   = \%os_release;
<os-pkg.backend_type> = $backend_type;    ## undef when unsupported ##

if ( defined $backend_type ) {
    <[base.log]>->( 2, "  package backend : $backend_type" );
} else {
    <[base.s_warn]>->(
        'unsupported distribution [ ID : %s ]',
        length $id ? $id : 'unknown'
    );
}

## Load the shared tracked-package list module                         ##
## [ same way sys-deps.init_code does ] : os-pkg.handler.install_reply ##
## records successful installs into var/sys-deps/tracked.yaml for      ##
## undeclared \ promote                                                ##
<[base.perlmod.load]>->('AMOS7::deps::tracked')
    if not <[base.perlmod.loaded]>->('AMOS7::deps::tracked');

<[base.log]>->( 2, 'os-pkg zenka initialization complete' );

0;

