# name  = storage.cmd.plan9-read-file
# descr = Read a whole file over 9P

my $args = $call->{'args'} // '';
my ( $name, $path ) = split m|\s+|, $args, 2;

if ( not length( $name // '' ) or not length( $path // '' ) ) {
    return {
        'mode' => 'false',
        'data' => 'usage: plan9-read-file <connection-name> <path>'
    };
}

my $conn = <storage.9p.connections>->{$name};
return { 'mode' => 'false', 'data' => 'not connected' } unless $conn;

my $result = <[storage.9p.read-file]>->( $conn, $path );
return $result if $result->{'mode'} eq 'false';

return { 'mode' => 'size', 'data' => $result->{'data'} };

