## [:< ##

# name  = ncode.cmd.sign-batch
# descr = sign all modified tracked source files

my $args = $call->{'args'} // '';

my @parts = split m|\s+|, $args;
my $glob  = shift @parts // '';

my $protocol7_bin = <system.root_path> . '/bin/Protocol-7';

return {
    'mode' => qw| false |,
    'data' => 'bin/Protocol-7 not found or not executable'
    }
    if not -x $protocol7_bin;

## collect modified tracked files ##
my @cmd        = (qw| git status --porcelain |);
my $git_output = <[ncode.util.run_cmd]>->(@cmd);

my @files;
for my $line ( split m|\n|, $git_output ) {
    next if $line =~ m|^\?\?|;               ## untracked ##
    next if length $line < 4;
    my $path = substr( $line, 3 );
    $path =~ s|^\s+||;
    $path =~ s|\s+$||;
    next unless length $path;
    next if index( $path, ' -> ' ) != -1;    ## rename ##
    push @files, $path;
}

## filter to source paths and optional glob ##
@files = grep {
           m|^src/|
        or m|^bin/|
        or m|^cfg/|
        or m|^data/md/|
        or m|^data/tasks/|
} @files;

if ( length $glob ) {
    @files = grep { m|\Q$glob\E| or m|$glob| } @files;
}

if ( not @files ) {
    return {
        'mode' => qw| true |,
        'data' => 'no modified tracked source files'
    };
}

my @sign_cmd = ( $protocol7_bin, qw| sourcecode update-signatures |, @files );

my $output = <[ncode.util.run_cmd]>->(@sign_cmd);

return { 'mode' => qw| size |, 'data' => $output };

