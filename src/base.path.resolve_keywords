## [:< ##

# name  = base.path.resolve_keywords
# param = $path_string
# descr = resolve registered keywords to actual paths
# return = resolved path string

my $path = shift;
return $path unless defined $path;

## Get keyword registry ##
return $path unless <[base.is_defined_recursive]>->(qw| base.path.keywords |);
my $keywords_href = <base.path.keywords>;

## Replace all registered keywords with their actual paths ##
foreach my $key_name ( keys %$keywords_href ) {
    my $key_path = $keywords_href->{$key_name};
    next unless defined $key_path;

    $path =~ s{\[$key_name\]}{$key_path}g;
}

return $path;

