## [:< ##

# name  = space.template.chain
# descr = compute next link checksum in a chain
# param = { parent, data }

my $params = shift // {};

my $parent = $params->{'parent'} // '';
my $data   = $params->{'data'}   // '';

return { 'mode' => qw| false |, 'data' => 'parent required' }
    unless length $parent;
return { 'mode' => qw| false |, 'data' => 'data required' }
    unless length $data;

my $chain_input = join ':', $parent, $data;

my $chksum_fn     = $code{'chk-sum.amos'} // $code{'base.chk-sum.amos'};
my $next_checksum = $chksum_fn->( \$chain_input );

return { 'mode' => qw| true |, 'data' => $next_checksum };

