## [:< ##

# name  = plugin.events.cache-keepalive.arm
# descr = one narrow registry query, then the earliest open session's timer

eval { <events.cache_keepalive.timer>->cancel }
    if defined <events.cache_keepalive.timer>;
undef <events.cache_keepalive.timer>;
my $seq = ++<events.cache_keepalive.seq>;
return <[protocol-7.route-send]>->(
    {   'command'   => qw| coding.session-cache-keepalive |,
        'call_args' => { 'args' => '' },
        'reply'     => {
            'handler' => qw| plugin.events.cache-keepalive.handler.reply |,
            'params'  => { 'seq' => $seq }
        }
    }
);

