## [:< ##

# name = weather.cmd.current
# descr = format weather conditions for display

my $params = shift || {};

my $location
    = $params->{location} || <weather.location> || qw| Offenburg,DE |;

## In future, fetch from weather zenka via IPC:
## <[protocol-7.command.send.local]>->(
##     { 'command' => 'weather.present', 'zenka' => 'weather', ... }
## );

## For now, use example data to demonstrate the UI pattern
my $weather_data = {
    location    => $location,
    temperature => 18,
    feels_like  => 16,
    description => qw| partly cloudy |,
    clouds      => 65,
    humidity    => 72,
    pressure    => 1013,
    wind_speed  => 12,
    wind_dir    => qw| NW |,
    icon        => qw| 02d |,
    updated     => <[base.ntime]>,
};

## Generate psychedelic HTML
my $html = <[weather.current.util.format_current_widget]>->($weather_data);

return $html;

0;

