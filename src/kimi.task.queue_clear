## [:< ##

# name = kimi.task.queue_clear
# descr = remove completed tasks from queue history
# purpose = queue operation: clean up finished work

<kimi.task.queue>     //= {};
<kimi.task.completed> //= [];

my $cleared = scalar <kimi.task.completed>->@*;

## remove completed tasks from queue ##
foreach my $task_id ( <kimi.task.completed>->@* ) {
    delete <kimi.task.queue>->{$task_id};
}

## clear completed list ##
<kimi.task.completed> = [];

<[base.logs]>->( 1, "kimi: cleared %d completed tasks", $cleared );

return {
    success   => TRUE,
    cleared   => $cleared,
    remaining => scalar( keys <kimi.task.queue>->%* )
};

