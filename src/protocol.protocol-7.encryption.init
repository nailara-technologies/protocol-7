## [:< ##

# name  = protocol.protocol-7.encryption.init
# descr = initialization for encrypted session state (state 3)
#         derives the ChaCha20-Poly1305 session key and installs the
#         length-prefixed encrypted frame handlers for both directions
#
# called = from base.session.init_state when transitioning to state 3
#         (only after successful link-upgrade negotiation at state 2)
# optional = only entered if client requested and completed link upgrade
#            unencrypted local links never reach this state
# args   = session_id, mode, state_id
# returns = 1 (success) | 0 (failure - disconnect, not return to state 2)
#
# wire format [ state 3 ] :
#   frame = pack('N', length) . ciphertext . 16-byte auth tag
#   nonce = pack('N', link_nonce_session_id) . pack('N', counter) . "\0" x 4
#   key   = SHA256( dh_shared_secret . pack('N', link_nonce_session_id ) )
#   link_nonce_session_id is selected by the client and transmitted with
#   the 'link-complete <session_id>' line [ fallback : server session id ]

my ( $session_id, $mode, $state_id ) = @ARG;

my $session = $data{'session'}{$session_id};

## Verify shared secret exists from link-upgrade negotiation
if ( not defined $session->{'link_dh_shared_secret'} ) {
    <[base.logs]>->(
        0, '[%d] encryption init: missing DH shared secret from link-upgrade',
        $session_id
    );
    return FALSE;
}

## nonce session id : client-selected [ sent with link-complete ], fallback to
## server session id for legacy peers that do not transmit one
$session->{'link_nonce_session_id'} //= $session_id;
my $nonce_sid = $session->{'link_nonce_session_id'};

## Derive encryption key : SHA256( shared_secret . pack('N', nonce_sid ) ) [
## identical to the client-side 'derive-key' KDF, both ends must match ]
use Digest::SHA qw| sha256 |;
my $enc_key = sha256( $session->{'link_dh_shared_secret'} . pack qw| N |,
    $nonce_sid );

if ( not defined $enc_key or length($enc_key) != 32 ) {
    <[base.logs]>->(
        0, '[%d] encryption init: key derivation failed', $session_id
    );
    return FALSE;
}

## Store encryption key in session (volatile, not persistent)
$session->{'link_encryption_key'} = $enc_key;

## Load cipher module if not already loaded
if ( not <[base.perlmod.loaded]>->('Crypt::AuthEnc::ChaCha20Poly1305') ) {
    <[base.perlmod.load]>->('Crypt::AuthEnc::ChaCha20Poly1305');
}

## Initialize frame counters for nonce generation [ first frame : counter 0 ]
$session->{'link_read_counter'}  = 0;              ## read-side frame counter
$session->{'link_write_counter'} = 0;              ## write-side frame counter
$session->{'link_frame_state'}   = qw| header |;
$session->{'link_plain_buffer'}  = q||;    ## decrypted bytes pending parse

## Warn if a transport encoding was negotiated : state 3 framing carries
## binary ciphertext, link-layer encodings are not applied on top of it
if ( defined $session->{'link_encoding_mode'}
    and length $session->{'link_encoding_mode'} ) {
    <[base.logs]>->(
        1,
        '[%d] encryption init: encoding mode \'%s\' not applied [ encrypted '
            . 'framing is binary, linewise encodings incompatible ]',
        $session_id,
        $session->{'link_encoding_mode'}
    );
}

## Switch input to length-prefixed binary frames : read 4-byte header first
$session->{'read-mode'}          = qw| bytewise |;
$session->{'bytes-to-read'}      = 4;
$session->{'input'}->{'handler'} = qw| base.handler.link-upgrade.input |;

## transform for direct sends via base.net.send_to_socket [ rare path ]
## session-specific closure : encrypts payload into one framed message
my $frame_handler_name = sprintf qw| base.handler.link-upgrade.frame-%d |,
    $session_id;
$code{$frame_handler_name} = sub {
    my $payload = shift;
    $payload = q|| if not defined $payload;

    my $sess = $data{'session'}{$session_id} or return $payload;
    return $payload if not defined $sess->{'link_encryption_key'};

    utf8::downgrade( $payload, 1 ) if utf8::is_utf8($payload);

    my $w_counter = $sess->{'link_write_counter'} // 0;
    my $w_nonce
        = pack( qw| N |, $sess->{'link_nonce_session_id'} // $session_id )
        . pack( qw| N |, $w_counter )
        . qq|\0\0\0\0|;

    my $w_cipher = Crypt::AuthEnc::ChaCha20Poly1305->new(
        $sess->{'link_encryption_key'}, $w_nonce );
    return $payload if not defined $w_cipher;

    my $w_framed = eval {
        my $ct  = $w_cipher->encrypt_add($payload);
        my $tag = $w_cipher->encrypt_done();
        pack( qw| N |, bytes::length($ct) + 16 ) . $ct . $tag;
    };
    return $payload if not defined $w_framed or length $EVAL_ERROR;

    $sess->{'link_write_counter'} = $w_counter + 1;
    return $w_framed;
};
$session->{'output'}->{'handler'} = $frame_handler_name;

## Re-register the output buffer watcher with the encrypting write handler [
## base.handler.write drains the buffer raw, encryption must wrap it ]
if ( defined $session->{'watcher'}->{'output_buffer'} ) {
    $session->{'watcher'}->{'output_buffer'}->cancel
        if $session->{'watcher'}->{'output_buffer'}->is_active;
    delete $session->{'watcher'}->{'output_buffer'};
}
$session->{'watcher'}{'output_buffer'} = <[event.add_var]>->(
    {   'var'     => \$session->{'buffer'}->{'output'},        ## VARIABLE ##
        'prio'    => -1,
        'repeat'  => FALSE,
        'poll'    => qw| w |,
        'data'    => $session_id,
        'handler' => qw| base.handler.link-upgrade.output |,
        'desc'    => sprintf( '[%d] output buffer', $session_id )
    }
);

<[base.logs]>->(
    2,
    '[%d] encryption initialized (state %d) : '
        . 'ChaCha20-Poly1305, nonce-sid=%d, length-prefixed frames',
    $session_id,
    $state_id,
    $nonce_sid
);

return TRUE;

1;

