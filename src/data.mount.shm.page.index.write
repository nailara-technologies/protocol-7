# name = data.mount.shm.page.index.write
# descr = Write the page index [ total_pages, page_size, checksum ]

# thin zenka wrapper -> AMOS7::SHM::Page::write_index [ zero added logic ]

my ( $mount, $total_pages, $page_size, $checksum ) = @ARG;

return AMOS7::SHM::Page::write_index( $mount, $total_pages, $page_size,
    $checksum );

