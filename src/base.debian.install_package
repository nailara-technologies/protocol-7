## [:< ##

# name = base.debian.install_package

my @deb_list = @_;

return FALSE if !@deb_list;

## use root apt child if available (zenka has dropped privs) ##
if ( defined <debian.apt_child.w_fh> ) {

    my $s = @deb_list > 1 ? 's' : '';
    <[base.logs]>->(
        1,  "auto_install: queueing debian package%s: %s",
        $s, join( ', ', @deb_list )
    );

    ## enqueue into jobqueue [ serialized through the 'apt-install' queue,  ##
    ## one install in flight at a time ] - the 'install ..' line is written ##
    ## to <debian.apt_child.w_fh> by the job callback and completion is     ##
    ## event-driven via debian.handler.apt_child_output, instead of a       ##
    ## blocking readline loop on r_fh that stalled the entire zenka event   ##
    ## loop for every apt-get run                                           ##
    my $job_id = <[debian.apt_enqueue_install]>->(
        {   'packages' => [@deb_list],
            'source'   => qw| base.debian.install_package |
        }
    );

    return 1 if not defined $job_id;

    ## this function's own callers [ base.perlmod.install/install_cpanm ]   ##
    ## still expect an immediate, synchronous real result -- pump the event ##
    ## loop locally until THIS job resolves, instead of blocking on a raw   ##
    ## readline. other timers/I-O still run interleaved via                 ##
    ## base.event.once, so this doesn't reintroduce the original stall --   ##
    ## it just waits for one specific outcome without freezing everything   ##
    ## else in the zenka  seconds - matches apt-get's own realistic upper   ##
    ## bound                                                                ##
    my $max_wait  = 300;
    my $waited    = 0;
    my $poll_step = 0.1;
    while ( $waited < $max_wait ) {
        my $job_data = <jobqueue.joblist.by_id>->{$job_id};
        last if not defined $job_data;
        last if $job_data->{'status'} eq qw| completed |;
        last if $job_data->{'status'} eq qw| error |;
        <[base.event.once]>->($poll_step);
        $waited += $poll_step;
    }

    my $final_status = <jobqueue.joblist.by_id>->{$job_id}->{'status'} // '';
    return 0 if $final_status eq qw| completed |;
    <[base.logs]>->(
        0, "auto_install: job %d did not complete cleanly [ status: %s ]",
        $job_id, length($final_status) ? $final_status : 'timeout'
    );
    return 1;
}

## direct install : only works when running as root ##
if ( $> != 0 ) {
    <[base.logs]>->(
        1, "auto_install: skipping apt-get : not running as root"
    );
    return 0;
}

local $ENV{'APT_LISTCHANGES_FRONTEND'} = qw| none |;
local $ENV{'UCF_FORCE_CONFFOLD'}       = qw| true |;
local $ENV{'UCF_FORCE_CONFMISS'}       = qw| true |;
local $ENV{'DEBCONF_PRIORITY'}         = qw| critical |;
local $ENV{'DEBIAN_FRONTEND'}          = qw| noninteractive |;
local $ENV{'PAGER'}                    = qw| /bin/true |;
local $ENV{'LANG'}                     = qw| en_US.UTF-8 |;

my $errors   = 0;
my $max_fail = 5;
my $ok       = 0;
my $wait;
my $warned;

while ( !$ok and $max_fail-- ) {
    $warned = 0;
    $wait   = 2 + int( rand(5) );
    while ( length(qx(lslocks|grep ^dpkg)) and $wait = 11 or $wait-- ) {
        if ( $wait > 10 and !$warned++ ) {
            <[base.logs]>->( 1, "auto_install: waiting for dpkg lock ..." );
        }
        <[base.sleep]>->(0.33);
    }

    my $s = @deb_list > 1 ? 's' : '';
    <[base.logs]>->(
        1,  "auto_install: debian package%s: %s",
        $s, join( ', ', @deb_list )
    );

    my $apt_cmd = 'apt-get -fy install ' . join( ' ', @deb_list ) . ' 2>&1';
    open( my $apt_out, '-|', $apt_cmd ) or do {
        <[base.logs]>->( 0, "  ✗ apt-get failed to execute : %s", $! );
        $errors++;
        next;
    };

    my $output = join( '', <$apt_out> );
    close($apt_out);
    my $result = $?;

    if ( $result == 0 ) {
        <[base.logs]>->( 1, ":. successfully installed." );
        $ok = 1;
    } elsif ( $output =~ m|Unable to locate package| ) {
        ## package doesn't exist : don't retry ##
        <[base.logs]>->( 0, "  ✗ package not found : cannot continue" );
        $errors++;
        last;
    } else {
        $errors++;
        <[base.logs]>->( 1, ": retrying automatic installation ..," );
    }
}

return $errors;

