## [:< ##

# name  = authorization.cmd.key-pending
# descr = list key arrivals oldest first

my @entry = sort { $ARG->{'first_seen'} <=> $ARG->{'first_seen'} }
    values( ( $data{'authorization.buffer'} // {} )->%* );
return { qw| mode | => qw| true |, qw| data | => 'no key arrivals' }
    if not @entry;

my $output = join "\n", qw| ID TYPE STATE USER ROLE FINGERPRINT CHANNELS |;
foreach my $entry (@entry) {
    $output .= sprintf "\n%s %s %s %s %s %s %s",
        @{$entry}
        {qw| id type state requested_user requested_role fingerprint |},
        join( ',', $entry->{'channels'}->@* );
}
return { qw| mode | => qw| size |, qw| data | => "$output\n" };

