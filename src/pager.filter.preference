## [:< ##

# name  = pager.filter.preference
# descr = Apply user preference weighting to item ordering

my ($args) = @ARG;
my $items  = $args->{'items'};
my $params = $args->{'params'} // {};

return $items unless @$items > 0;

my $recent_weight = $params->{'recent'}    // 0.0;
my $type_weight   = $params->{'type_pref'} // 0.0;
my $size_weight   = $params->{'size_pref'} // 0.0;    # prefer large/small
my $name_weight   = $params->{'name_pref'} // 0.0;    # pattern match
my $pattern       = $params->{'pattern'};

my $now = time();

my @scored;
for my $item (@$items) {
    my $score = 0;

    # Recency score (exponential decay)
    if ( $recent_weight > 0 && $item->{'mtime'} ) {
        my $age_days = ( $now - $item->{'mtime'} ) / 86400;
        my $recency  = exp( -$age_days / 30 );              # 30-day half-life
        $score += $recent_weight * $recency;
    }

    # File type preference (directories vs files)
    if ( $type_weight > 0 && $item->{'type'} ) {
        my $type_score = $item->{'type'} eq 'dir' ? 1.0 : 0.5;
        $score += $type_weight * $type_score;
    }

    # Size preference (log scale, prefer medium-sized files)
    if ( $size_weight > 0 && $item->{'size'} ) {
        my $size_kb    = $item->{'size'} / 1024;
        my $size_score = 1.0 / ( 1.0 + abs( log( $size_kb + 1 ) - 10 ) / 10 );
        $score += $size_weight * $size_score;
    }

    # Name pattern match
    if ( $name_weight > 0 && $pattern && $item->{'name'} ) {
        my $name_score = ( $item->{'name'} =~ m|$pattern|i ) ? 1.0 : 0.0;
        $score += $name_weight * $name_score;
    }

    # Preserve original position as tiebreaker
    push @scored,
        {
        'item'  => $item,
        'score' => $score,
        };
}

# Sort by score descending
@scored = sort {
           $b->{'score'} <=> $a->{'score'}
        || $a->{'item'}{'_original_idx'} <=> $b->{'item'}{'_original_idx'}
} @scored;

my @result = map { $ARG->{'item'} } @scored;

# Mark with preference score
for my $i ( 0 .. $#result ) {
    $result[$i]{'_pref_score'} = $scored[$i]{'score'};
}

return \@result;

