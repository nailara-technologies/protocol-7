## [:< ##

# name  = graphics.matrix.visual.extract-color
# descr = average color of an image : the whole image scaled to 1x1
#
# input : $info - image info hash [ graphics.matrix.visual.detect-resolution ]
# output: [r, g, b] array

my $info = shift // {};

## given directly [ 1x1 pixel input, precomputed average ] ##
return $info->{'average_color'} if $info->{'average_color'};
return $info->{'rgb'}           if $info->{'rgb'};

## an image file : its 1x1 core ring tile [ image.analyze.file ] ##
if ( defined $info->{'path'} and -f $info->{'path'} ) {
    my $analysis = <[image.analyze.file]>->( $info->{'path'} );
    return $analysis->{'tiles'}->{1}->[0] if defined $analysis;
}

return [ 128, 128, 128 ];    ## unreadable input : neutral gray ##

