## [:< ##

# name  = system.disk.poll
# descr = update space levels, trends and notifications

my $now          = <[base.time]>->(2);
my $mounts       = <[system.disk.mounts]> // [];
my $old          = <system.disk.mounts>   // {};
my $current      = {};
my $max_pressure = 0;
my $gib          = 1024**3;

foreach my $mount ( @{$mounts} ) {
    my $path = $mount->{'path'};
    my $stat = <[system.disk.statvfs]>->($path) // next;
    next if not $stat->{'block_size'} or not $stat->{'blocks'};

    my $size = $stat->{'blocks'} * $stat->{'block_size'};
    my $free = $stat->{'blocks_free'} * $stat->{'block_size'};
    $free = 0 if $free < 0;
    my $used = $size - $free;
    $used = 0 if $used < 0;
    my $free_pct = 100 * $free / $size;
    ## windows \ 9p \ fuse mounts report invented inode numbers ##
    my $inodes_counted
        = (     $stat->{'files'}
            and $stat->{'files_free'} <= $stat->{'files'}
            and ( $mount->{'type'} // '' )
            !~ m{\A(?:drvfs|9p|fuse(?:blk|\..*)?)\z} )
        ? TRUE
        : FALSE;
    my $inode_free_pct
        = $inodes_counted
        ? 100 * $stat->{'files_free'} / $stat->{'files'}
        : undef;

    my $cfg      = <disk.mount>->{$path}      // {};
    my $warn_pct = $cfg->{'warn_free'}        // <disk.warn_free>;
    my $crit_pct = $cfg->{'critical_free'}    // <disk.critical_free>;
    my $warn_min = $cfg->{'warn_min_free_gb'} // <disk.warn_min_free_gb>;
    my $crit_min = $cfg->{'critical_min_free_gb'}
        // <disk.critical_min_free_gb>;
    my $floor_min = $cfg->{'absolute_floor_min_size_gb'}
        // <disk.absolute_floor_min_size_gb>;
    my $warn_bytes = $size >= $floor_min * $gib ? $warn_min * $gib : 0;
    my $crit_bytes = $size >= $floor_min * $gib ? $crit_min * $gib : 0;
    my $warn_limit
        = $warn_pct > 100 * $warn_bytes / $size
        ? $warn_pct
        : 100 * $warn_bytes / $size;
    my $crit_limit
        = $crit_pct > 100 * $crit_bytes / $size
        ? $crit_pct
        : 100 * $crit_bytes / $size;

    my @available = ($free_pct);
    push @available, $inode_free_pct if $inodes_counted;
    if ( not $mount->{'read_only'} ) {
        foreach my $available (@available) {
            my $pressure
                = $available <= $crit_limit
                ? 1
                : ( $warn_limit - $available )
                / ( $warn_limit - $crit_limit || 1 );
            $pressure     = 0         if $pressure < 0;
            $max_pressure = $pressure if $pressure > $max_pressure;
        }
    }

    my $level = 0;
    if ( not $mount->{'read_only'} ) {
        $level = 1
            if $free_pct <= $warn_pct
            or $free <= $warn_bytes
            or ( $inodes_counted and $inode_free_pct <= $warn_pct );
        $level = 2
            if $free_pct <= $crit_pct
            or $free <= $crit_bytes
            or ( $inodes_counted and $inode_free_pct <= $crit_pct );
    }

    my $previous   = $old->{$path};
    my $first_seen = not defined $previous;
    my $history    = $previous->{'history'} // [];
    push @{$history}, { qw| at | => $now, qw| free | => $free };
    shift @{$history} while @{$history} > ( <disk.history_samples> // 13 );
    my ( $rate, $eta );
    if ( @{$history} > 1 ) {
        my ( $sum_x, $sum_y, $sum_xx, $sum_xy ) = ( 0, 0, 0, 0 );
        my $first_at = $history->[0]{'at'};
        foreach my $sample ( @{$history} ) {
            my $x = $sample->{'at'} - $first_at;
            $sum_x  += $x;
            $sum_y  += $sample->{'free'};
            $sum_xx += $x * $x;
            $sum_xy += $x * $sample->{'free'};
        }
        my $n       = scalar @{$history};
        my $divisor = $n * $sum_xx - $sum_x * $sum_x;
        $rate = ( $n * $sum_xy - $sum_x * $sum_y ) / $divisor
            if $divisor > 0;
        $eta = $free / -$rate if defined $rate and $rate < 0;
    }

    my @jobs = sort { $a->{'name'} cmp $b->{'name'} }
        grep { $ARG->{'mount'} eq $path } values <system.disk.jobs>->%*;
    my $reserved = 0;
    foreach my $job (@jobs) {
        my $left = $job->{'expected'} - $job->{'written'};
        $reserved += $left > 0 ? $left : 0;
    }
    $current->{$path} = {
        %{$mount},
        qw| size |                => $size,
        qw| used |                => $used,
        qw| free |                => $free,
        qw| free_after_jobs |     => $free - $reserved,
        qw| free_percent |        => $free_pct,
        qw| warn_free_bytes |     => $warn_limit * $size / 100,
        qw| critical_free_bytes | => $crit_limit * $size / 100,
        qw| inodes |              => $stat->{'files'},
        qw| inodes_used |         => $stat->{'files'} - $stat->{'files_free'},
        qw| inodes_free |         => $stat->{'files_free'},
        qw| inodes_free_percent | => $inode_free_pct,
        qw| inodes_counted |      => $inodes_counted,
        qw| level |               => $level,
        qw| jobs |                => \@jobs,
        qw| history |             => $history,
        qw| rate |                => $rate,
        qw| eta |                 => $eta,
    };

    my $old_level = $first_seen ? 0 : $previous->{'level'};
    next if $level == $old_level;
    my $kind
        = $level == 0 ? qw| recovered |
        : $level == 2 ? qw| critical |
        :               qw| warning |;
    my $inode_text
        = $inodes_counted
        ? sprintf( '%.1f %% inodes free', $inode_free_pct )
        : 'inodes n\a';
    my $job_text
        = @jobs
        ? sprintf( ', registered jobs : %s',
        join( ', ', map { $ARG->{'name'} } @jobs ) )
        : '';
    my $message = sprintf '%s : %s [ %.1f %% bytes, %s%s ]',
        $path, $kind, $free_pct, $inode_text, $job_text;
    <[base.logs]>->( 0, 'disk space : %s', $message );
    my $quoted = $message =~ s|'|\\'|gr;
    <[protocol-7.route-send]>->(
        {     qw| command | => $level == 0
            ? qw| notify.info |
            : qw| notify.warn |,
            qw| call_args | =>
                { qw| args | => sprintf( "'disk space' '%s'", $quoted ) },
        }
    );
}

<system.disk.mounts> = $current;
<system.disk.interval_state> {'pressure'} = $max_pressure;
return $current;

