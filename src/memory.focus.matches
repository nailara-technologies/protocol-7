## [:< ##

# name = memory.focus.matches
# descr = predicate does node match topic substring or index relation

my $node  = @_ ? shift : $ARG;
my $topic = @_ ? shift : $ARG;

return FALSE if not defined $node  or not ref $node eq 'HASH';
return FALSE if not defined $topic or not length $topic;

my $text = join ' ',
    grep {defined} (
    $node->{'title'}      // '',
    $node->{'body'}       // '',
    $node->{'source_ref'} // '',
    );

my $lctext  = lc($text);
my $lctopic = lc($topic);

## [ index cache: if topic has related tokens from index, match those too ] ##
my $cache   = <memory.focus_index_cache> // {};
my $related = $cache->{$lctopic};

if ( defined $related and @$related ) {
    ## [ index is live — match topic or any related token ] ##
    return TRUE if index( $lctext, $lctopic ) >= 0;
    for my $token (@$related) {
        return TRUE if index( $lctext, lc($token) ) >= 0;
    }
    return FALSE;
}

## [ fallback: substring only ] ##
return index( $lctext, $lctopic ) >= 0 ? TRUE : FALSE;

