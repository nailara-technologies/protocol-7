# name = data.topology.interference.map.determine_security_zone
# descr = Topology calculation subroutine

my $layer_depth = shift;

# Inner layers = higher trust
return 'core'     if $layer_depth < 2;
return 'trusted'  if $layer_depth < 4;
return 'standard' if $layer_depth < 6;
return 'perimeter';

