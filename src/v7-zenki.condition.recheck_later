# name  = v7-zenki.condition.recheck_later
# descr = re-check waiting zenka starts while a start condition is unmet
# note  = jobqueue re-checks dependencies when a job moves -- a condition
#         that turns true between moves [ a group created by another
#         zenka's drop_privs ] waited for the next unrelated move. a
#         one-shot timer, armed by an unmet condition callback, re-checks
#         after <v7-zenki.cfg.condition_recheck> seconds [ 5 ] ; only one
#         pending at a time, none once every condition holds

return TRUE if <v7-zenki.condition.recheck_pending>;
<v7-zenki.condition.recheck_pending> = TRUE;

<[event.add_timer]>->(
    {   'after'   => <v7-zenki.cfg.condition_recheck> // 5,
        'repeat'  => FALSE,
        'handler' => qw| v7-zenki.handler.condition_recheck |,
        'desc'    => 'start condition re-check',
    }
);

return TRUE;

