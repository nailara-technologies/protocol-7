## [:< ##

# name  = discover.process_host_packet

my $packet_payload     = shift;
my $packet_fields_href = shift;

##  target route to 'nodes' zenka  ##
##
my $nodes_update_cmd = <discover.cfg.nodes.host_status_command>;

<discover.resend-host-reqs> //= {};

return ( warn 'HOST packet syntax error [ packet format ] <{C1}>' and undef )
    if $packet_payload !~ m|^HOST\[ (?<hostname>\S+) \] \{\n(?#
                           )(?<payload>(?: {10,81}(?#
                           )[A-Fa-f\d\.:]{5,29}  (?#
                           )(?:(?:[0-9a-f]{2}:){5}[0-9a-f]{2})  (?#
                           )<[\w\.\:]{1,15}>\n)*)(?#
                           ) {10,81}\}\n|;

my $hostname = $+{'hostname'};
my $pkey     = Crypt::Misc::encode_b32r( $packet_fields_href->{'hostkey'} );

## the HOST payload capture is saved HERE : the trust.* calls below run ##
## regexes that would otherwise clobber %+ before it is read again      ##
my $host_payload = $+{'payload'} // '';

my $hostname_L13
    = keys <discover.resend-host-reqs>->%*
    ? <[chk-sum.bmw.L13-str]>->($hostname)
    : undef;

my %payload_id;
my $entry_added = FALSE;    ##  host [re-]appeared ?  ##

my $pkey_L13 = <[chk-sum.bmw.L13-str]>->( $packet_fields_href->{'hostkey'} );

## --------------------------------------------------------------------   ##
## host-root delegation [ data/md/design/HOST-ROOT-DELEGATION.md ] : the  ##
## packet signature already verified under the hostkey ; now classify the ##
## delegation that key carries. the hostkey IS the announced S, so it is  ##
## the subject. pinning is a read-only set-membership test against the    ##
## client pin store -- discover NEVER writes a pin.                       ##
## --------------------------------------------------------------------   ##
##
my $delegation = $packet_fields_href->{'delegation'};    ## wire or undef ##
my $hostkey    = $packet_fields_href->{'hostkey'};       ## raw 32 bytes ##

my ( $trust, $root_fp, $delegated_name );
my $drop_reason;

if ( not defined $delegation or not length $delegation ) {
    $trust = qw| unverified |;    ##  no delegation field  ##
} else {
    ##  exact parse first -- the issuer is needed as the anchor  ##
    my ( $parsed, $parse_reason )
        = <[trust.statement]>->( qw| parse_wire |, $delegation );
    if ( ref $parsed ne qw| HASH | ) {
        $drop_reason = $parse_reason // 'parse failed';
    } else {
        my $issuer_fp = <[trust.fingerprint]>->( $parsed->{'issuer_pub'} );
        if ( not defined $issuer_fp ) {
            $drop_reason = 'issuer fingerprint failed';
        } else {
            ## verify under the statement's OWN issuer : sig, the time    ##
            ## window, subject eq the announced hostkey, the name and the ##
            ## empty leaf scope. pinning is decided separately so a       ##
            ## valid-but-unpinned root is 'offered', not refused.         ##
            my ( $verified, $verify_reason ) = <[trust.verify]>->(
                {   qw| chain |   => [$delegation],
                    qw| anchors | => [$issuer_fp],
                    qw| subject | => $hostkey,
                    qw| now |     => time,
                }
            );
            if ( ref $verified ne qw| HASH | ) {
                $drop_reason = $verify_reason // 'verify failed';
            } else {
                $root_fp        = $issuer_fp;
                $delegated_name = $verified->{'name'};
                my $pins = <[discover.read_host_root_pins]>;
                $trust
                    = exists $pins->{$root_fp}
                    ? qw| pinned |
                    : qw| offered |;
            }
        }
    }
}

## adaptive log level per host key : level 0 the first time, then up to 3 ##
## for repeats -- a flood of bad packets cannot flood the log [ the       ##
## base.cache.refaddr-prefix.init pattern, kept per sender ]              ##
$data{'discover.host-root-log'} //= {};
my $flood_level = sub {
    my $level = $data{'discover.host-root-log'}->{$pkey_L13}++ // 0;
    return $level > 3 ? 3 : $level;
};

## 'nodes' gets a host's trust when the host [re-]appears AND whenever that ##
## trust changes [ a host staying online would otherwise keep its first     ##
## trust state there ] -- last sent state kept per host key                 ##
$data{'discover.nodes-trust'} //= {};
my $notify_nodes = sub {
    my ( $n_root_fp, $n_trust, $force ) = @ARG;
    my $state = join ' ', ( $n_root_fp // qw| - | ), $n_trust;
    my $sent  = $data{'discover.nodes-trust'}->{$pkey_L13};
    return if not $force and defined $sent and $sent eq $state;
    return
        if not defined $nodes_update_cmd
        or not
        <[base.is_defined_recursive]>->(qw| discover.notify-nodes-zenka |)
        or not <[base.cfg_bool]>->(<discover.notify-nodes-zenka>);
    $data{'discover.nodes-trust'}->{$pkey_L13} = $state;
    <[base.logs]>->(
        2, "sending host [online] status to 'nodes' zenka [ %s ] .,",
        $n_trust
    );
    <[protocol-7.command.send.local]>->(
        {   'command'   => $nodes_update_cmd,
            'call_args' => {    ##  carry root_fp + trust along the route  ##
                'args' => join( ' ', qw| online |, $hostname, $state )
            }
        }
    );
    return;
};

## a broken claim is worse than none : DROP the packet ##
if ( defined $drop_reason ) {
    <[base.logs]>->(
        $flood_level->(),
        "invalid host-root delegation from '%s' [ %s ] : dropping packet",
        $hostname, $drop_reason
    );
    return FALSE;
}

## a host whose root_fp CHANGES is never adopted : the packet is DROPPED [  ##
## no address update ], the old entry kept and marked invalid until the new ##
## root is re-pinned out of band                                            ##
$data{'discover.host-root'} //= {};
if ( defined $root_fp ) {
    my $prev = $data{'discover.host-root'}->{$pkey_L13};
    if (    defined $prev
        and defined $prev->{'root_fp'}
        and $prev->{'root_fp'} ne $root_fp ) {
        <[base.logs]>->(
            $flood_level->(), "host-root changed for '%s' : dropping packet",
            $hostname
        );
        $prev->{'trust'} = qw| invalid |;
        map { $data{'hosts'}->{$ARG}->{'trust'} = qw| invalid | }
            grep { index( $ARG, $pkey_L13, 0 ) == 0 }
            keys( ( $data{'hosts'} // {} )->%* );
        $notify_nodes->( $prev->{'root_fp'}, qw| invalid | );
        return FALSE;
    } else {
        $data{'discover.host-root'}->{$pkey_L13} = {
            qw| root_fp |        => $root_fp,
            qw| delegated_name | => $delegated_name,
            qw| trust |          => $trust,
        };
    }
}

## the trust fields stored on every host entry built below [ and shown by ##
## discover.cmd.host_details ] ; a bare 'unverified' carries no root an   ##
## accepted packet resets this sender's flood log level                   ##
delete $data{'discover.host-root-log'}->{$pkey_L13};

my %trust_field = ( qw| trust | => $trust );
$trust_field{'root_fp'}        = $root_fp        if defined $root_fp;
$trust_field{'delegated_name'} = $delegated_name if defined $delegated_name;

if ( not length $host_payload ) {

    my $entry_id = $pkey_L13;

    $payload_id{$entry_id} = TRUE;    ##  protect from removing  ##

    $entry_added = TRUE if not exists $data{'hosts'}->{$entry_id};

    $data{'hosts'}->{$entry_id} = {
        qw| pkey |               => $packet_fields_href->{'hostkey'},
        qw| host |               => $hostname,
        qw| timestamp |          => $packet_fields_href->{'timestamp'},
        qw| tstamp-adj |         => $packet_fields_href->{'tstamp-adj'},
        qw| time-delta-seconds | =>
            $packet_fields_href->{'time-delta-seconds'},
        %trust_field
    };
} else {
    foreach my $line ( split "\n", $host_payload ) {
        next if not length $line;
        return ( warn 'HOST packet error [ address payload line ] <{C1}>'
                and undef )
            if $line !~ m| {13,81}(?<ip_address>[A-Fa-f\d\.:]{5,29})  (?#
                     )(?<hwaddr>(?:[0-9a-f]{2}:){5}[0-9a-f]{2})  (?#
                     )<(?<iface>[\w\d\.:]{1,15})>|;

        my $entry_id = join qw| : |, $pkey_L13,
            <[chk-sum.bmw.L13-str]>->(
            $hostname, $+{'ip_address'}, $+{'hwaddr'}, $+{'iface'},
            );

        $payload_id{$entry_id} = TRUE;    ##  protect from removing  ##

        $entry_added = TRUE if not exists $data{'hosts'}->{$entry_id};

        ## add to list .., ##
        $data{'hosts'}->{$entry_id} = {
            qw| pkey |               => $packet_fields_href->{'hostkey'},
            qw| host |               => $hostname,
            qw| ip_addr |            => $+{'ip_address'},
            qw| hwaddr |             => $+{'hwaddr'},
            qw| iface |              => $+{'iface'},
            qw| timestamp |          => $packet_fields_href->{'timestamp'},
            qw| tstamp-adj |         => $packet_fields_href->{'tstamp-adj'},
            qw| time-delta-seconds | =>
                $packet_fields_href->{'time-delta-seconds'},
            %trust_field
        };
    }
}

## clean-up previous entries ##
##
foreach my $id (    ## entries signed with the same host key ##
    grep { not exists $payload_id{$ARG} }
    grep { index( $ARG, $pkey_L13, 0 ) == 0 }
    keys $data{'hosts'}->%*
) {
    delete $data{'hosts'}->{$id};    ## no longer in packet payload ##
}

if ($entry_added) {    ## seperate buffer status change logging ##

    my $log_level  = 1;
    my $log_msg    = sprintf ": host status :  online .: '%s'", $hostname;
    my $time_stamp = <[base.anum_log_time]>->( 5, TRUE );

    <[base.buffer.add_line]>->(
        qw| host-status |,
        join( ' ', $time_stamp, $log_level, $log_msg ), $log_level
    );
}

## send status change for [all] host to 'nodes' zenka : on [re-]appearance ##
## [ forced ] and on any trust change                                      ##
##
$notify_nodes->( $root_fp, $trust, $entry_added );

##  requested host status updates  ##
##
if ($entry_added    ##  when announce host request [re-]appears  ##
    and defined $hostname_L13
    and exists <discover.host-status-requests>->{$hostname_L13}
) {
    my @send_update_zenki
        = <discover.host-status-requests>->{$hostname_L13}->{'zenki'}->@*;
    if (not defined
        <discover.host-status-requests>->{$hostname_L13}->{'host-key'}
        or $packet_fields_href->{'hostkey'} eq    ## comparing host-keys ##
        <discover.host-status-requests>->{$hostname_L13}->{'host-key'}
        ) {    ## sending host status updates to configured zenki ##
        foreach my $target_zenka (@send_update_zenki) {
            <[base.logs]>->(
                2, "sending host [online] status to '%s' ..,",
                $target_zenka
            );
            <[protocol-7.command.send.local]>->(
                {   'command' =>
                        sprintf( qw| cube.%s.host-status |, $target_zenka ),
                    'call_args' =>
                        { 'args' => join ' ', qw| online |, $hostname }
                }
            );
        }
    } elsif (
        defined
        <discover.host-status-requests>->{$hostname_L13}->{'host-key'} ) {
        <[base.s_warn]>->(
            "host key mismatch , clearing status update request%s for '%s'",
            <[base.cnt_s]>->( scalar @send_update_zenki ), $hostname
        );
        foreach my $zenkaname (@send_update_zenki) {
            my $zenka_cfg_path = sprintf qw| notify-reqs/%s.%s |,
                $hostname_L13, $zenkaname;
            <[file.zenka_dir.unlink_file]>->( $zenka_cfg_path, TRUE );
        }
    }
}

## host awareness resend-requests ##
##
if ($entry_added    ##  when announce host request [re-]appears  ##
    and defined $hostname_L13
    and exists <discover.resend-host-reqs>->{$hostname_L13}
    ) {             ##  processing host awareness resend-requests  ##
    if (not defined <discover.resend-host-reqs>->{$hostname_L13}->{'host-key'}
        or $packet_fields_href->{'hostkey'} eq    ## comparing host-keys ##
        <discover.resend-host-reqs>->{$hostname_L13}->{'host-key'}
        ) {    ## reset announce interval ##
        <[base.log]>->( 2, 'resend request matched [ resetting interval ]' );
        <[discover.callback.resend_interval_reset]>->(FALSE);
    } elsif (
        defined <discover.resend-host-reqs>->{$hostname_L13}->{'host-key'} ) {
        <[base.s_warn]>->(
            "host key mismatch , clearing resend-request for '%s'", $hostname
        );
        my $zenka_cfg_path = sprintf qw| resend-reqs/%s |, $hostname_L13;
        <[file.zenka_dir.unlink_file]>->( $zenka_cfg_path, TRUE );
    }
}

## check for orbital p7ref line ##
my $orbital_p7ref;
if ( $packet_payload =~ m|^p7ref\s+(\S+)$|m ) {
    $orbital_p7ref = $1;
}

if ( defined $orbital_p7ref and length $orbital_p7ref ) {
    <[discover.orbital.store_remote]>->( $hostname, $pkey, $orbital_p7ref );
    <[discover.orbital.share_grid_fragment]>->( $hostname, $pkey );
}

