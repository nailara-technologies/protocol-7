## [:< ##

# name  = nameserv.sync.checksums.verify
# descr = compare local zone checksums against peer CHECKSUM lines
# param = $checksums_href -> ( mismatched zone, .. )

my $checksums = shift;
return () if ref $checksums ne qw| HASH |;

my @mismatched = ();

for my $z_name ( sort keys %$checksums ) {
    my $local = <[nameserv.zone.checksum]>->( $z_name, TRUE );    ## signed ##
    my $peer  = $checksums->{$z_name} // '';
    if (   not defined $local
        or not length $peer
        or $peer eq qw| - |
        or $local ne $peer ) {
        push @mismatched, $z_name;
    }
}

return @mismatched;

