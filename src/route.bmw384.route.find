## [:< ##

# name  = route.bmw384.route.find
# args  = $src_name, $dst_name
# descr = main entry point for bmw384 geometric route discovery

my $src_name = shift;
my $dst_name = shift;

if ( not defined $src_name or not defined $dst_name ) {
    <[base.logs]>->( 1, 'source and destination names required <{C1}>' );
    return undef;
}

my $src_coord = <[route.bmw384.index.lookup]>->($src_name);
my $dst_coord = <[route.bmw384.index.lookup]>->($dst_name);

if ( not defined $src_coord ) {
    <[base.logs]>->(
        1, 'source node [%s] not found in index <{C1}>', $src_name
    );
    return undef;
}

if ( not defined $dst_coord ) {
    <[base.logs]>->(
        1, 'destination node [%s] not found in index <{C1}>', $dst_name
    );
    return undef;
}

my $result;
if ( $src_coord->{'arc'} == $dst_coord->{'arc'} ) {
    $result = <[route.bmw384.route.direct]>->(
        $src_coord, $dst_coord, $src_name, $dst_name
    );
} else {
    $result = <[route.bmw384.route.vortex]>->(
        $src_coord, $dst_coord, $src_name, $dst_name
    );
}

return $result;

