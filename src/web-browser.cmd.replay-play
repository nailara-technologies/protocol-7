## [:< ##

# name  = web-browser.cmd.replay-play
# descr = replay recorded input against __p7ReplayTarget
# param = <buffer-name|json-path> [speed=1.0] [force=1]
#       .. [verify=var:target,..] [tolerance=0.01] [samples=5] [timeout=10]

my $reply_id = $call->{'reply_id'};
my $args_str = $call->{'args'} // '';

return {
    'mode' => qw| false |,
    'data' =>
        'usage: replay-play <buffer-name|json-path> [speed=1.0] [force=1] '
        . '[verify=var:target,..] [tolerance=0.01] [samples=5] '
        . '[timeout=10]'
    }
    if !length($args_str);

my $fg_index = <web-browser.overlay.index>->{'fg'};
my $view     = <web-browser.gtk_obj.view>->{$fg_index};

return { 'mode' => qw| false |, 'data' => 'no foreground view' }
    unless defined $view;

my $settings = $view->get_settings();

return {
    'mode' => qw| false |,
    'data' => 'javascript execution is disabled'
    }
    if !$settings->get_enable_javascript();

my @tokens = split( m|\s+|, $args_str );
my $source = shift @tokens // '';

my $speed     = 1.0;
my $force     = 0;
my $tolerance = 0.01;
my $samples   = 5;
my $timeout   = 10;
my %verify;
foreach my $token (@tokens) {
    if ( $token =~ m|^speed=(\d+(?:\.\d+)?)$| ) {
        $speed = 0 + $1;
    } elsif ( $token =~ m|^force=([01])$| ) {
        $force = 0 + $1;
    } elsif ( $token =~ m|^tolerance=(\d+(?:\.\d+)?)$| ) {
        $tolerance = 0 + $1;
    } elsif ( $token =~ m|^samples=(\d+)$| ) {
        $samples = 0 + $1;
    } elsif ( $token =~ m|^timeout=(\d+(?:\.\d+)?)$| ) {
        $timeout = 0 + $1;
    } elsif ( $token =~ m|^verify=(\S+)$| ) {
        foreach my $pair ( split( m|,|, $1 ) ) {
            return {
                'mode' => qw| false |,
                'data' =>
                    sprintf(
                    'invalid verify pair: %s [expected var:target,..]',
                    $pair )
                }
                unless $pair =~ m|^(\w+):(-?\d+(?:\.\d+)?)$|;
            $verify{$1} = $2;
        }
    }
}
$speed = 1.0 if $speed <= 0;

##  load normalized event records from named buffer or json file  ##
my @events;
if ( exists $data{'buffer'}{$source} ) {
    foreach my $line ( $data{'buffer'}{$source}{'data'}->@* ) {
        my $rec = <[format.json.decode]>->($line);
        push @events, $rec
            if ref($rec) eq qw| HASH | and defined $rec->{'type'};
    }
} elsif ( -f $source and -r $source ) {
    my $content = do {
        open my $fh, '<',
            $source
            or return {
            'mode' => qw| false |,
            'data' => sprintf( 'cannot open %s: %s', $source, $! )
            };
        local $INPUT_RECORD_SEPARATOR = undef;
        <$fh>;
    };
    my $parsed = <[format.json.decode]>->($content);
    return { 'mode' => qw| false |, 'data' => 'invalid json event array' }
        unless ref($parsed) eq qw| ARRAY |;
    @events
        = grep { ref($ARG) eq qw| HASH | and defined $ARG->{'type'} }
        $parsed->@*;
} else {
    return {
        'mode' => qw| false |,
        'data' => sprintf( 'no such buffer or file: %s', $source )
    };
}

##  extract leading pin meta record, if present  ##
my ( $pin_url, $pin_chk );
if ( @events and $events[0]->{'type'} eq qw| meta | ) {
    my $pin_rec = shift @events;
    $pin_url = $pin_rec->{'url'} // '';
    $pin_chk = $pin_rec->{'chk'} // '';
}

return { 'mode' => qw| false |, 'data' => 'no events to replay' }
    if !@events;

##  pin check : recording must match current foreground page  ##
if ( defined $pin_chk and not $force ) {
    my $cur_url     = $view->get_uri() // '';
    my $cur_subject = $cur_url;
    $cur_subject =~ s|#.*$||;    ##  fragment holds ephemeral state  ##
    my $cur_chk = <[chk-sum.bmw.L13-str]>->($cur_subject);
    if ( $cur_chk ne $pin_chk ) {
        return {
            'mode' => qw| false |,
            'data' => sprintf(
                'checksum mismatch: recording pinned to %s [chk=%s], current '
                    . 'page is %s [chk=%s] -- pass force=1 to override',
                $pin_url, $pin_chk, $cur_url, $cur_chk
            )
        };
    }
}

<[web-browser.replay.dispatch]>->(
    {   'view'      => $view,
        'events'    => \@events,
        'speed'     => $speed,
        'source'    => $source,
        'reply_id'  => $reply_id,
        'verify'    => \%verify,
        'tolerance' => $tolerance,
        'samples'   => $samples,
        'timeout'   => $timeout
    }
);

return { 'mode' => qw| deferred | };

