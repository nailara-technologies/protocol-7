## [:< ##

# name  = site-yaml.liveness.verdict
# descr = fetch result -> liveness verdict hash
# param = $url, $raw_result [ page html, or a numeric http code ]
# return = { verdict => alive | gone | unknown, code, valid_through }

## 404 \ 410 = gone. any other code [ 403 \ 429 rate limit, 5xx, 599 ] is   ##
## unknown, never gone. a 200 page may still be a dead posting : the portal ##
## keeps the page and flags "isOffline":true -- an expired listing that was ##
## re-posted answers 200 with a fresh validThrough                          ##
## [ 2026-10-29, valid_through in august, live again ] so the STORED date   ##
## proves nothing                                                           ##

my ( $url, $raw_result ) = @ARG;
$raw_result //= 599;

if ( $raw_result =~ m{\A\d+\z} ) {
    return {
        'verdict' => $raw_result =~ m{\A4(?:04|10)\z} ? 'gone' : 'unknown',
        'code'    => 0 + $raw_result,
    };
}

return { 'verdict' => qw| gone |, 'code' => 200, 'offline' => TRUE }
    if $raw_result =~ m{"isOffline"\s*:\s*true};

my $job = <[site-yaml.stepstone.job_from_html]>->( $url, $raw_result );

## no json-ld job posting and no offline flag : can not tell ##
return { 'verdict' => qw| unknown |, 'code' => 200, 'why' => "$job" }
    if ref $job ne qw| HASH |;

return {
    'verdict'       => qw| alive |,
    'code'          => 200,
    'valid_through' => $job->{'valid_through'} // '',
};

