## [:< ##

# name  = index.cmd.restore
# descr = restore index state from disk

my $ok = <[index.restore]>;
return $ok
    ? { 'mode' => 'size',  'data' => 'index state restored' }
    : { 'mode' => 'false', 'data' => 'no saved state found' };

