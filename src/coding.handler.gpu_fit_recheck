## [:< ##

# name  = coding.handler.gpu_fit_recheck
# descr = retry the gpu spawn until its model fits in vram
# note  = armed by coding.async_spawn_inference_servers when the gpu fit
#         check fails [ vram held by another process, e.g. invoke ] ;
#         stops itself once a gpu server runs

my $event = shift;

my $stop = sub {
    $event->w->cancel if ref $event and defined $event->w;
    delete <coding.timer.gpu_fit_recheck>;
    return TRUE;
};

my $gpu_pid = <inference.gpu_pid> // 0;
return $stop->() if $gpu_pid and kill( 0, $gpu_pid );

## a switch owns the spawn while it runs ##
return TRUE if <coding.switch_model_active>;

## the spawn decides : only it knows the moe plan and the partial offload.  ##
## the fallback request set by a busy gpu would skip the gpu block, cleared ##
<coding.cpu_fallback_requested> = FALSE;
<[coding.async_spawn_inference_servers]>;

return TRUE if not <inference.gpu_pid>;    ##  still busy, timer continues  ##

<[base.logs]>->( 1, ': gpu recheck : vram free - gpu server spawned' );
$stop->();
<[event.add_timer]>->(
    {   'after'   => 10.0,
        'handler' => qw| coding.handler.verify_inference_startup |,
        'data'    => { 'backend' => qw| gpu | }
    }
);

return TRUE;

