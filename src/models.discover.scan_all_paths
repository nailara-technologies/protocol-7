## [:< ##

# name  = models.discover.scan_all_paths
# descr = scan every enabled configured search path for .gguf model files
# return = arrayref of discovered model hashrefs [ no registry mutation ]

## factored out of models.cmd.discover_files / models.cmd.clear-registry,
## which each duplicated this exact search-path-resolution + scan loop inline
## [ data/yaml/coding-tasks/models-discover-cleanup.yaml, problem 1 ]

my @discovered;

## models.storage.search_paths is the canonical shape ; fall back to      ##
## models.scan_paths [ keyed hash ] and convert to the same list shape if ##
## search_paths hasn't been populated yet  a copy : the added paths below ##
## must not grow the configured list                                      ##
my $search_paths = [ ( <models.storage.search_paths> // [] )->@* ];

## paths added with scan-path-add are ALWAYS scanned too -- before, they ##
## only counted while no search path was configured, so a host whose     ##
## configured paths do not exist discovered 0 models [ 2026-10-18 ]      ##
my %path_index;
foreach my $index ( 0 .. $#$search_paths ) {
    my $entry = $search_paths->[$index];
    next unless ref $entry eq qw| HASH |;
    $path_index{ $entry->{'path'} // '' } = $index;
}
if ( scalar keys %{ <models.scan_paths> // {} } ) {
    foreach my $path_id ( sort keys <models.scan_paths>->%* ) {
        my $path_data = <models.scan_paths>->{$path_id};
        my $path_str  = $path_data->{'path'} // '';
        if ( exists $path_index{$path_str} ) {
            ## same path already configured : the added entry wins its scan ##
            ## flags -- a configured non-recursive entry must not silence a ##
            ## path explicitly registered for recursive scanning            ##
            ## [ else discover finds 0 where scan-path-add found N ].       ##
            ## replaces the list slot with a copy : the canonical store     ##
            ## must not change                                              ##
            my $entry = $search_paths->[ $path_index{$path_str} ];
            $search_paths->[ $path_index{$path_str} ] = {
                %$entry,
                'enabled' => ( $entry->{'enabled'} // FALSE )
                    || ( $path_data->{'enabled'} // TRUE ),
                'recursive' => ( $entry->{'recursive'} // FALSE )
                    || ( $path_data->{'recursive'} // TRUE )
            };
            next;
        }
        $path_index{$path_str} = scalar @$search_paths;
        push @$search_paths,
            {
            'path'      => $path_data->{'path'},
            'enabled'   => $path_data->{'enabled'} // TRUE,
            'recursive' => TRUE,
            'tier'      => $path_data->{'tier'} // 3
            };
    }
}

foreach my $path_config (@$search_paths) {
    next unless $path_config->{'enabled'};
    next unless -d $path_config->{'path'};

    my $result = <[models.storage.discover_directory]>->(
        $path_config->{'path'},
        $path_config->{'recursive'}
    );
    push @discovered, @$result if $result;
}

return \@discovered;

