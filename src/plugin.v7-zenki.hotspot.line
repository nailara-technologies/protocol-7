## [:< ##

# name  = plugin.v7-zenki.hotspot.line
# descr = one output line of a sample child : count the module:line
# args  = line [ octets ], handle

my ( $line, $handle ) = @ARG;
return if ref $handle ne qw| HASH |;
my $data = $handle->{'data'} // return;
my $job  = <v7-zenki.hotspot.jobs> { $data->{'job'} // '' } // return;
my $inst = $job->{'instances'}{ $data->{'iid'} // '' } // return;
return if not defined $inst->{'handle'} or $inst->{'handle'} != $handle;

## cop_file is the p7 module name [ models.handler.task-poll-step:197 ], ##
## perl and xs files keep their path                                     ##

$inst->{'histogram'}->{$1}++
    if $line =~ m{^(\S+:\d+)\s*$};
return;

