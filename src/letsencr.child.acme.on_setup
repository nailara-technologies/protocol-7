## [:< ##

# name  = letsencr.child.acme.on_setup
# param = <reply> [ { sid, cmd, call_args, data, params } ]
# descr = a challenge set-up confirmed [ httpd \ nameserv ]

## a route reply handler gets ONE hash : the reply params sit inside it ##
my $reply  = shift              // {};
my $params = $reply->{'params'} // {};

my $order = <[letsencr.child.acme.order_of]>->( $params, qw| setup | )
    // return FALSE;
my $authz = $order->{'authz'}->{ $params->{'authz'} // '' } // return FALSE;

my $mode = uc( $reply->{'cmd'} // $reply->{'mode'} // '' );

if ( $mode ne qw| TRUE | ) {
    return <[letsencr.child.acme.fail]>->(
        $order->{'order_id'},
        sprintf '%s : %s set-up failed [ %s ]',
        $authz->{'domain'},
        $params->{'target'},
        $reply->{'call_args'} // $reply->{'data'} // $mode
    );
}

$authz->{'setup'}->{ $params->{'target'} } = TRUE;
$order->{'waiting'}--;

<[base.logs]>->(
    2,                  ': acme : %s : %s ready',
    $authz->{'domain'}, $params->{'target'}
);

return <[letsencr.child.acme.step_propagate]>->( $order->{'order_id'} )
    if $order->{'waiting'} <= 0;

return TRUE;

