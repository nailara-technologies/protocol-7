## [:< ##

# name  = models.cmd.get_path_by_amos
# descr = get model metadata by amos id [ composite or :content ]
# return = { mode, data } YAML-encoded model entry or error string

use YAML::XS qw| Dump |;

my $amos_id = $call->{'args'} // '';

unless ( defined $amos_id && length $amos_id ) {
    return {
        'mode' => 'size',
        'data' => "error: amos_id required (checksum or composite key)\n"
    };
}

## a content half must name exactly one installed model ##
if ( $amos_id =~ m|^:([^:]+)$| ) {
    my $content_part = $1;
    my $registry     = <models.registry> // {};
    my @matches      = grep {m|^[^:]+:\Q$content_part\E$|} keys %$registry;

    return {
        'mode' => 'size',
        'data' => "error: model content id matches "
            . "no installed model: $amos_id\n"
        }
        if not @matches;

    return {
        'mode' => 'size',
        'data' => "error: model content id is ambiguous [ "
            . scalar(@matches)
            . " installed matches ]: $amos_id\n"
        }
        if @matches > 1;
}

## unified lookup: aliases -> definitions -> discovered registry
my $entry = <[models.resolve.entry]>->($amos_id);

unless ( defined $entry ) {
    return {
        'mode' => 'size',
        'data' => "error: model not found: $amos_id\n"
    };
}

## verify file exists on disk
unless ( length $entry->{'file_path'} && -f $entry->{'file_path'} ) {
    return {
        'mode' => 'size',
        'data' => "error: model file not found: $entry->{'file_path'}\n"
    };
}

return { 'mode' => 'size', 'data' => Dump($entry) };

