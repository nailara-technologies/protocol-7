## [:< ##

# name  = osf-cache.holdings.state_save
# descr = persist holdings scan result as a versioned YAML state file
# param = { path, holdings }
#
# writes the holdings scan result data [ the scan's data hash ] to path
# as YAML through the format.yaml wrapper modules [ the zenka loads
# format.yaml in its zenka.v7 ; format.yaml.pre_init must have run ].
# write_file is not atomic itself : the state goes to '<path>.tmp.<pid>'
# first and is renamed into place only when complete [ a concurrent
# state_load never sees a truncated file ]. the state carries a version
# field : { version => 2, holdings => ... }.

my $args     = shift           // {};
my $path     = $args->{'path'} // '';
my $holdings = $args->{'holdings'};

return { 'mode' => 'false', 'data' => 'path required' } unless length $path;
return { 'mode' => 'false', 'data' => 'holdings required' }
    unless ref $holdings eq qw| HASH |;

## the zenka data dir does not exist before the first save ##
( my $state_dir = $path ) =~ s{/[^/]+$}{};
if ( length $state_dir and not -d $state_dir ) {
    require File::Path;
    File::Path::make_path( $state_dir,
        { 'mode' => oct 750, 'error' => \my $mkdir_err } );
    return { 'mode' => 'false', 'data' => "cannot create $state_dir" }
        if not -d $state_dir;
}

my $tmp_path = sprintf '%s.tmp.%d', $path, $PROCESS_ID;

my ( $written, $err ) = <[format.yaml.write_file]>->(
    $tmp_path,
    {   'version'  => 2,
        'holdings' => $holdings,
    }
);

## a failed write must not leave a partial temp file behind ##
if ( not $written ) {
    unlink $tmp_path;
    return { 'mode' => 'false', 'data' => "cannot write state : $err" };
}

if ( not rename( $tmp_path, $path ) ) {
    my $rename_err = $OS_ERROR;    ## before unlink overwrites it ##
    unlink $tmp_path;
    return {
        'mode' => 'false',
        'data' => "cannot rename $tmp_path to $path : $rename_err"
    };
}

return { 'mode' => qw| true |, 'data' => $path };

