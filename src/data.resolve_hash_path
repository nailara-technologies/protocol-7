# name  = data.resolve_hash_path
# param = <path> [root-ref]
# descr = resolve dot-separated path to hash reference
# return = hash ref or undef

my $path_str = shift // return undef;
my $root_ref = shift // \%data;

return $root_ref unless length($path_str);

my @segments = split( /\./, $path_str );
my $current  = $root_ref;

for my $segment (@segments) {
    return undef unless ref($current) eq 'HASH';
    return undef unless exists $current->{$segment};
    $current = $current->{$segment};
}

return $current;

