## [:< ##
# name  = plan-9.protocol.constants.pre_init
# descr = 9P protocol message type constants -- populates the
#         plan-9.protocol.constants.* data-tree path so <plan-9.protocol.
#         constants.KEY> resolves for every caller across plan-9.client.*,
#         plan-9.server.*, and storage.9p.*. Previously defined via a
#         plain Perl 'use constant' block, which never actually populated
#         %data at all -- <...> is this codebase's data-tree read syntax,
#         completely separate from a use-constant symbol, so every
#         constant read anywhere in the 9P stack silently resolved to
#         undef since the day this was written. A .pre_init suffix makes
#         base.init_modules run this once automatically at zenka start,
#         same as any other pre_init hook. Uses real Const::Fast constants,
#         same idiom as crypt.C25519.init_code's <crypt.C25519.regex>.

delete <plan-9.protocol.constants>    ##  allow updates during reload  ##
    if <[base.is_defined_recursive]>->(qw| plan-9.protocol.constants |);

## read-only when Const::Fast is available [ plain hash otherwise ] [ bare ##
## 'const' without the import is a compile-time syntax error, so the call  ##
## is runtime-guarded and prototype-bypassed ]                             ##
my $set_readonly = sub {
    return $ARG[1] if not defined &Const::Fast::const;    ## degraded ##
    &Const::Fast::const( $ARG[0], $ARG[1] );
    return $ARG[1];
};

## read-only below when Const::Fast loaded ##
<plan-9.protocol.constants> = {

    # Message sizes
    HEADER_SIZE  => 7,       # size[4] type[1] tag[2]
    MAX_MSG_SIZE => 8192,    # Maximum message size

    # Message types (T = request, R = response)
    Tversion => 100,
    Rversion => 101,
    Tauth    => 102,
    Rauth    => 103,
    Tattach  => 104,
    Rattach  => 105,
    Terror   => 106,         # Illegal
    Rerror   => 107,
    Tflush   => 108,
    Rflush   => 109,
    Twalk    => 110,
    Rwalk    => 111,
    Topen    => 112,
    Ropen    => 113,
    Tcreate  => 114,
    Rcreate  => 115,
    Tread    => 116,
    Rread    => 117,
    Twrite   => 118,
    Rwrite   => 119,
    Tclunk   => 120,
    Rclunk   => 121,
    Tremove  => 122,
    Rremove  => 123,
    Tstat    => 124,
    Rstat    => 125,
    Twstat   => 126,
    Rwstat   => 127,

    # File modes
    DMDIR    => 0x80000000,    # Directory
    DMAPPEND => 0x40000000,    # Append-only
    DMEXCL   => 0x20000000,    # Exclusive use
    DMMOUNT  => 0x10000000,    # Mounted channel
    DMAUTH   => 0x08000000,    # Authentication file
    DMTMP    => 0x04000000,    # Temporary file

    # Permissions
    DMREAD  => 0x4,            # Read permission
    DMWRITE => 0x2,            # Write permission
    DMEXEC  => 0x1,            # Execute permission

    # Qid types
    QTDIR     => 0x80,         # Directory
    QTAPPEND  => 0x40,         # Append-only
    QTEXCL    => 0x20,         # Exclusive use
    QTMOUNT   => 0x10,         # Mounted channel
    QTAUTH    => 0x08,         # Authentication file
    QTTMP     => 0x04,         # Temporary file
    QTSYMLINK => 0x02,         # Symbolic link
    QTFILE    => 0x00,         # Plain file

    # Open modes
    OREAD   => 0,              # Open for read
    OWRITE  => 1,              # Open for write
    ORDWR   => 2,              # Open for read/write
    OEXEC   => 3,              # Open for execute
    OTRUNC  => 0x10,           # Truncate
    ORCLOSE => 0x40,           # Remove on close

    # Version string
    PROTOCOL_VERSION => qw| 9P2000 |,
};

$set_readonly->( \<plan-9.protocol.constants>, <plan-9.protocol.constants> );

0;

