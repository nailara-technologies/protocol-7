## [:< ##

# name = models.backend.api.detect_limit
# descr = detect API rate limit conditions from response

my $params = shift;

my $api_result = $params->{'api_result'} // {};
my $context    = $params->{'context'}    // qw| backend |;

## Check if result indicates rate limiting
my $is_rate_limited = <[base.cfg_bool]>->( $api_result->{'rate_limited'} );
my $limit_type      = $api_result->{'limit_type'} // qw| unknown |;

## Also check error messages for quota patterns if not already detected
unless ($is_rate_limited) {
    my $error_msg = $api_result->{'error'} // '';
    if ( $error_msg =~ m{rate\s+limit|quota|throttle|429|overload}i ) {
        $is_rate_limited = 1;
        $limit_type = 'quota'      if $error_msg =~ m{quota|tokens}i;
        $limit_type = 'overloaded' if $error_msg =~ m{overload|capacity}i;
        $limit_type = 'rate_limit' unless $limit_type;
    }
}

<[base.logs]>->(
    2, "[$context] limit detection: limited=%d type=%s status=%s",
    $is_rate_limited, $limit_type, $api_result->{'http_status'} // 'unknown'
);

return {
    'rate_limited' => $is_rate_limited,
    'limit_type'   => $limit_type,
    'http_status'  => $api_result->{'http_status'},
    'error'        => $api_result->{'error'},
    'api_result'   => $api_result,
};

