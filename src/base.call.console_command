## [:< ##

# name  = base.call.console_command
# descr = executes specified console command or
#         base.console.commands when no parameters are given

my $command_line = shift // '';

## a 'p7.<shorthand>' launcher alias expands into its console command     ##
## words, user arguments appended [ 'p7.<shorthand>' -> 'p7-<zenka>' link ##
## chains installed by <[v7-zenki.install_workflow_shortcuts]>, patterns  ##
## from <[path-template.console-shorthand]> -- see                        ##
## data/md/design/ZENKA-SYMLINK-CHAIN-RESOLUTION.md ]                     ##
if ( defined <system.start.launcher_name>
    and <system.start.launcher_name> =~ m|^p7\.([0-9a-z-]+)$| ) {
    my $shorthand = $LAST_PAREN_MATCH;
    my $pattern   = <[path-template.console-shorthand]>->($shorthand);
    if ( defined $pattern and length $pattern ) {
        my ( $pattern_zenka, $pattern_words ) = split( m| +|, $pattern, 2 );
        if ( $pattern_zenka ne <system.zenka.name> ) {
            print sprintf(
                "\n  << shortcut 'p7.%s' targets zenka '%s', not '%s' >>\n\n",
                $shorthand, $pattern_zenka, <system.zenka.name> );
        } elsif ( defined $pattern_words and length $pattern_words ) {
            $command_line
                = join( ' ', grep {length} $pattern_words, $command_line );
        }
    }
}

( my $console_cmd, my $console_params ) = split( m| +|, $command_line, 2 );

<base.ntime-harmony> = FALSE;

$console_cmd //= qw| commands |;

if ( not defined <base.console>->{$console_cmd} ) {
    print "\n  << command '$console_cmd' not "
        . "found [ 'commands' for list ] >>\n\n";
    return;
}

my $command_handler = <base.console>->{$console_cmd};

if (   not defined $code{$command_handler}
    or not defined $code{$command_handler}->&* ) {
    print "\n  << command handler '$command_handler' not defined";
    return;
}

## resetting from start-up setting to zenka default handler ##
##
$SIG{'__WARN__'} = $code{'base.sig_warn'};

<system.console.command> = $console_cmd;

$code{$command_handler}->($console_params);

