## [:< ##

# name  = task.post_init
# descr = set up reasoning branch stuck-check timer
#         + register reasoning branch commands for direct access

## register reasoning branch commands ##
my @rb_cmds = qw|
    reasoning.branch.register
    reasoning.branch.checkpoint
    reasoning.branch.stuck_score
    reasoning.branch.spawn_rescue
    reasoning.branch.resolve
    reasoning.branch.inject
    reasoning.branch.status
    reasoning.branch.internal.check_stuck
    |;

foreach my $cmd (@rb_cmds) {
    <base.cmd>->{$cmd} = $cmd;
}

my $interval = <reasoning.branch.check_interval> // 300;

<[event.add_timer]>->(
    {   'after'    => $interval,
        'interval' => $interval,
        'repeat'   => TRUE,
        'handler'  => 'reasoning.branch.internal.check_stuck',
    }
);

<[base.logs]>->(
    2,
    'task.post_init: reasoning branch stuck-check timer '
        . 'started [interval=%ds, %d commands registered]',
    $interval,
    scalar @rb_cmds
);

## cold-queue sweep : periodic check for un-integrated summary-tree entries ##
## against the cold gate [ gpu temp / debounce fallback ]                   ##
my $sweep_interval = 15;
<[event.add_timer]>->(
    {   'after'    => $sweep_interval,
        'interval' => $sweep_interval,
        'repeat'   => TRUE,
        'handler'  => 'task.handler.cold-queue-sweep',
    }
);
<[base.logs]>->(
    2, 'task.post_init: cold-queue sweep timer started [interval=%ds]',
    $sweep_interval
);

## stale claims : a renewing worker's claim expires one lease after its    ##
## last task.touch, others after task.cfg.stale_claim_secs -- checked each ##
## minute                                                                  ##
<task.cfg.stale_claim_secs> //= 21600;
<[event.add_timer]>->(
    {   'after'    => 60,
        'interval' => 60,
        'repeat'   => TRUE,
        'handler'  => 'task.handler.stale-claim-sweep',
    }
);

## outdoor temperature for the thermal night amplifier [ step 5 ] : the ##
## reply lands in <thermal.outdoor.*>, weather answers deferred on an   ##
## on-demand start [ GDX ] -- stale after thermal.outdoor.max_age       ##
<[event.add_timer]>->(
    {   'after'    => 5,
        'interval' => <thermal.cfg.outdoor.poll> // 600,
        'repeat'   => TRUE,
        'handler'  => 'thermal.outdoor.poll',
    }
);

0;

