## [:< ##

# name  = letsencr.parent.queue_renewal_requests
# descr = create renewal requests for expiring certificates and send to child

my $renewal_list = shift;

return {
    status => qw| error |,
    error  => 'renewal list array required',
    queued => 0,
    }
    unless $renewal_list && ref($renewal_list) eq qw| ARRAY |;

## Initialize renewal timers hash if not present
<letsencr.parent.renewal_timers> = {}
    unless <letsencr.parent.renewal_timers>;

my $queued_count = 0;
my $now          = time();

foreach my $renewal_info (@$renewal_list) {
    my $domain          = $renewal_info->{domain};
    my $alt_names       = $renewal_info->{alt_names} // [];
    my $days_remaining  = $renewal_info->{days_remaining};
    my $account_id      = $renewal_info->{account_id};
    my $certificate_url = $renewal_info->{certificate_url};

    next unless $domain;

    ## Check if already in renewal process
    if ( exists <letsencr.parent.renewal_timers>->{$domain} ) {
        my $timer_info = <letsencr.parent.renewal_timers>->{$domain};
        if ( $timer_info->{started}
            && ( $now - $timer_info->{started} ) < 300 ) {
            ## Already queued within last 5 minutes - skip duplicate
            <[base.log]>->(
                3, "renewal already queued for $domain - skipping"
            );
            next;
        }
    }

    ## Send renewal command to child via parent pipe [not cube]
    my $cmd = qw| child.renew-certificate |;

    <[base.logs]>
        ->( 2, "sending renewal command to child for : %s", $domain );

    my $result = <[protocol-7.command.send.local]>->(
        {   'command'   => $cmd,
            'call_args' => {
                'args'  => $domain,
                'param' => {
                    'alt_names'       => $alt_names,
                    'account_id'      => $account_id,
                    'certificate_url' => $certificate_url,
                    'retry_attempt'   => 0,
                }
            },
            'reply' => {
                'handler' => qw| letsencr.parent.handler_renewal_reply |,
                'params'  => { 'domain' => $domain }
            }
        }
    );

    if ($result) {
        <[base.logs]>->( 3, "renewal command queued for %s", $domain );

        ## Track renewal attempt
        <letsencr.parent.renewal_timers>->{$domain} = {
            started  => $now,
            attempts => 1,
            status   => qw| pending |,
        };

        $queued_count++;
    } else {
        <[base.logs]>->(
            1, "error : failed to queue renewal for %s", $domain
        );
    }
}

## the one log line per call [ callers do not repeat it ] ##
<[base.logs]>->(
    2,             'queued %d of %d renewal request%s',
    $queued_count, scalar(@$renewal_list),
    <[base.cnt_s]>->( scalar(@$renewal_list) )
);

return {
    status => qw| success |,
    queued => $queued_count,
};

