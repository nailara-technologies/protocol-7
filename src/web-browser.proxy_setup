## [:< ##

# name = web-browser.proxy_setup

my $use_proxy = shift // <web-browser.cfg.use_proxy> // 'no';
my $log_level = shift // 1;

<web-browser.init_proxy> = 0;

if (    defined <web-browser.cfg.proxy_addr>
    and defined <web-browser.cfg.proxy_port>
    and defined $use_proxy ) {
    my $proxy_addr = <web-browser.cfg.proxy_addr>;
    my $proxy_port = <web-browser.cfg.proxy_port>;
    if ( $use_proxy eq 'yes' ) {
        <web-browser.init_proxy> = 1;
        <[base.log]>->(
            $log_level, "http proxy is enabled ($proxy_addr:$proxy_port)"
        );
    } elsif ( $use_proxy eq 'auto' ) {
        <[base.log]>->(
            $log_level, "checking http proxy... ($proxy_addr:$proxy_port)"
        );
        my $check_sock = IO::Socket::IP->new(
            PeerAddr => $proxy_addr,
            PeerPort => $proxy_port,
            Proto    => 'tcp',
            Timeout  => 0.2
        );
        if (    defined $check_sock
            and -S $check_sock
            and $check_sock->connected() ) {
            <[base.log]>->( $log_level, ": proxy ok - enabled.." );
            $check_sock->close();
            <web-browser.init_proxy> = 1;
        } else {
            <[base.log]>->(
                $log_level, ": cannot connect to proxy - disabled"
            );
        }
    } else {
        <[base.log]>->(
            $log_level, "http proxy is disabled in zenka setup.."
        );
    }
}

my $context = <web-browser.gtk_obj.web_context>;

## proxy_setup can run before open_window has assigned web_context yet ##
return <web-browser.init_proxy> if not defined $context;

if (<web-browser.init_proxy>) {
    my $proxy_addr = <web-browser.cfg.proxy_addr>;
    my $proxy_port = <web-browser.cfg.proxy_port>;

    my $proxy_settings = Gtk3::WebKit2::NetworkProxySettings->new(
        "http://$proxy_addr:$proxy_port",
        []    ## ignore-hosts: empty array = no exceptions
    );
    $context->set_network_proxy_settings( 'WEBKIT_NETWORK_PROXY_MODE_CUSTOM',
        $proxy_settings );
} else {

    ## WebKit's own proxy default [ unset here ] falls back to glib's proxy ##
    ## resolver, which reads http_proxy/https_proxy/ALL_PROXY from the      ##
    ## environment regardless of use_proxy='no' -- explicitly forcing       ##
    ## NO_PROXY mode is the only way to actually get no proxy.              ##
    $context->set_network_proxy_settings(
        'WEBKIT_NETWORK_PROXY_MODE_NO_PROXY', undef );
}

return
    <web-browser.init_proxy>
    ;    # no checks performed if use_proxy set to 'yes' ..,

