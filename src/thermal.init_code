## [:< ##

# name  = thermal.init_code
# descr = initialize shared thermal gate defaults

<thermal.cfg.mode>              //= qw| relative |;
<thermal.cfg.baseline.window>   //= 1800;
<thermal.cfg.baseline.band>     //= 1.5;
<thermal.cfg.baseline.max>      //= 55.0;
<thermal.cfg.cold>              //= +4.5;
<thermal.cfg.hot>               //= +18.0;
<thermal.cfg.ceiling>           //= 83.0;
<thermal.cfg.dwell>             //= 120;
<thermal.cfg.avg.short>         //= 300;
<thermal.cfg.avg.long>          //= 900;
<thermal.cfg.k.fit.window>      //= 1800;
<thermal.cfg.k.fit.max_samples> //= 1800;
<thermal.cfg.k.fit.every>       //= 120;
<thermal.cfg.k.fit.taus>        //= [ 30, 60, 90, 120, 180 ];
<thermal.cfg.k.fit.min_r2>      //= 0.8;
<thermal.cfg.k.fit.min_points>  //= 20;
<thermal.cfg.k.min_delta_w>     //= 40;
<thermal.cfg.k.min>             //= 0.02;
<thermal.cfg.k.max>             //= 0.5;
<thermal.cfg.k.window>          //= 3600;
<thermal.cfg.k.min_samples>     //= 30;
<thermal.cfg.k.fault_ratio>     //= 1.5;
<thermal.cfg.k.fault_hold>      //= 1800;
<thermal.cfg.predict>           //= qw| yes |;
<thermal.cfg.start.hold>        //= 600;
<thermal.cfg.unload.hold>       //= 900;
<thermal.cfg.idle.hold>         //= 600;
<thermal.cfg.idle.load_max>     //= 0.6;
<thermal.cfg.idle.power_max>    //= 60;
<thermal.cfg.hover.night>       //= 68;    ## C : night work hovers here ##
<thermal.cfg.hover.day>         //= 0;     ## 0 = no day hover ##
<thermal.cfg.hover.per_c>       //= 15;    ## s hold per C over ##
<thermal.cfg.hover.gap_max>     //= 180;
<thermal.cfg.hover.step>        //= 20;    ## s : re-check while held ##
## C per outdoor amp unit [ night ] ##
<thermal.cfg.hover.amp_c>       //= 12;
<thermal.cfg.boost.minutes>     //= 42;
<thermal.cfg.boost.max_minutes> //= 180;
<thermal.cfg.boost.level>       //= qw| hot |;
<thermal.cfg.boost.warm>        //= 4;         ## C added to the hover mark ##
<thermal.cfg.boost.hot>         //= 8;         ## C added to the hover mark ##
<thermal.cfg.window.night>      //= qw| 22:00-06:00 |;
<thermal.cfg.window.tariff>     //= '';
<thermal.cfg.outdoor.enabled>   //= qw| yes |;
<thermal.cfg.outdoor.t_ref>     //= 15.0;
<thermal.cfg.outdoor.k>         //= 0.04;
<thermal.cfg.outdoor.max>       //= 1.5;
<thermal.cfg.outdoor.poll>      //= 600;
<thermal.cfg.outdoor.max_age>   //= 3600;
<thermal.cfg.outdoor.forecast>  //= qw| yes |;
<thermal.cfg.night.cold>        //= +8.0;
<thermal.cfg.night.hot>         //= +25.0;
<thermal.cfg.night.weight>      //= 1.0;
<thermal.cfg.day.weight>        //= 0.25;
<thermal.cfg.mem.psi_some_soft> //= 10.0;
<thermal.cfg.mem.psi_full_hard> //= 5.0;
<thermal.cfg.mem.avail_min_pct> //= 15.0;
<thermal.cfg.mem.hold>          //= 60;

return TRUE;

