## [:< ##

# name  = thermal.init_code
# descr = initialize shared thermal gate defaults

<thermal.cfg.mode>              //= qw| relative |;
<thermal.cfg.baseline.window>   //= 1800;
<thermal.cfg.baseline.band>     //= 1.5;
<thermal.cfg.baseline.max>      //= 55.0;
<thermal.cfg.cold>              //= +4.5;
<thermal.cfg.hot>               //= +18.0;
<thermal.cfg.ceiling>           //= 83.0;
<thermal.cfg.dwell>             //= 120;
<thermal.cfg.avg.short>         //= 300;
<thermal.cfg.avg.long>          //= 900;
<thermal.cfg.start.hold>        //= 600;
<thermal.cfg.unload.hold>       //= 900;
<thermal.cfg.idle.hold>         //= 600;
<thermal.cfg.idle.load_max>     //= 0.6;
<thermal.cfg.window.night>      //= qw| 22:00-06:00 |;
<thermal.cfg.night.cold>        //= +8.0;
<thermal.cfg.night.hot>         //= +25.0;
<thermal.cfg.night.weight>      //= 1.0;
<thermal.cfg.day.weight>        //= 0.25;
<thermal.cfg.mem.psi_some_soft> //= 10.0;
<thermal.cfg.mem.psi_full_hard> //= 5.0;
<thermal.cfg.mem.avail_min_pct> //= 15.0;
<thermal.cfg.mem.hold>          //= 60;

return TRUE;

