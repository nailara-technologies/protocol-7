## [:< ##
# name  = storage.9p.readdir
# descr = Read directory entries from 9P

my ( $conn, $fid ) = @ARG;

## clone the fid first : opening the caller's fid directly would leave it in
## open state, and 9P2000 forbids Twalk from an open fid (strict servers
## reject it, breaking subsequent walks from the same fid).  A zero-element
## Twalk clones $fid into $dir_fid; the clone is opened, read and clunked
## here, leaving the caller's fid untouched.

my $dir_fid = $conn->{next_fid}++;
my $clone   = <[storage.9p.walk]>->( $conn, $fid, $dir_fid );
return $clone if $clone->{'mode'} eq 'false';

# Open directory clone
my $open_res = <[storage.9p.open]>->( $conn, $dir_fid, 0 );    # OREAD
if ( $open_res->{'mode'} eq 'false' ) {
    <[storage.9p.clunk]>->( $conn, $dir_fid );
    return $open_res;
}

my @entries;
my $offset = 0;

## read count : iounit from Ropen, where 0 means 'no preference' : fall back
## to msize minus 9P header overhead ( IOHDRSZ = 24 ). count must stay below
## msize, else a server reply clamped to msize would be shorter than count and
## falsely signal end-of-directory below.
my $msize  = $conn->{'msize'}                // 8192;
my $iounit = $conn->{fids}{$dir_fid}{iounit} // 0;
my $count
    = ( $iounit > 0 and $iounit <= $msize - 24 )
    ? $iounit
    : $msize - 24;

while (1) {
    my $tag = ++$conn->{tag} & 0xFFFF;

    my $req
        = <[plan-9.protocol.codec.encode-uint32]>->($dir_fid)
        . <[plan-9.protocol.codec.encode-uint64]>->($offset)
        . <[plan-9.protocol.codec.encode-uint32]>->($count);

    my $msg = <[plan-9.protocol.codec.encode-message]>->(
        <plan-9.protocol.constants.Tread>,
        $tag, $req
    );

    $conn->{socket}->send($msg);

    my $resp = <[storage.9p.read-message]>->( $conn, $tag );
    if ( $resp->{'mode'} eq 'false' ) {
        <[storage.9p.clunk]>->( $conn, $dir_fid );
        return $resp;
    }

    my $data = $resp->{'data'};
    my $len
        = <[plan-9.protocol.codec.decode-uint32]>->( substr( $data, 0, 4 ) );
    my $content = substr( $data, 4, $len );

    last if length($content) == 0;

    # Parse directory entries
    my $pos = 0;
    while ( $pos < length($content) ) {
        last if $pos + 2 > length($content);
        my $stat_size = <[plan-9.protocol.codec.decode-uint16]>
            ->( substr( $content, $pos, 2 ) );
        last if $pos + 2 + $stat_size > length($content);

        my $stat_data = substr( $content, $pos + 2, $stat_size );
        $pos += 2 + $stat_size;

        ## 9P2000 stat wire entry : size[2] type[2] dev[4] qid[13] mode[4]
        ## atime[4] mtime[4] length[8] name[s] uid[s] gid[s] muid[s].
        ## $stat_data EXCLUDES the leading size[2] field, so name starts at
        ## 2+4+13+4+4+4+8 = 39. ( storage.9p.stat uses 41 because its buffer
        ## INCLUDES the entry's own size[2]. )
        my $name_pos = 2 + 4 + 13 + 4 + 4 + 4 + 8;
        next if $name_pos >= length($stat_data);

        my ( $name, $rest )
            = <[plan-9.protocol.codec.decode-string]>
            ->( substr( $stat_data, $name_pos ) );

        # Skip . and ..
        if ( $name ne '.' and $name ne '..' ) {
            push @entries, $name;
        }
    }

    $offset += length($content);
    last if length($content) < $count;
}

<[storage.9p.clunk]>->( $conn, $dir_fid );

return { 'mode' => 'true', 'data' => \@entries };

