# name  = lm-vision.cmd.get_debug_log
# descr = retrieve debug logs from a vision analysis job

my $job_id = $call->{'args'};

unless ( defined $job_id && length $job_id ) {
    return { 'mode' => 'false', 'data' => 'job_id required' };
}

unless ( exists <lm-vision.jobs>->{$job_id} ) {
    return { 'mode' => 'false', 'data' => 'no such job' };
}

my $job = <lm-vision.jobs>->{$job_id};

unless ( defined $job->{'debug_log'} && length $job->{'debug_log'} ) {
    return {
        'mode' => 'false',
        'data' => 'no debug log available for this job'
    };
}

return {
    'mode' => qw| size |,
    'data' => $job->{'debug_log'}
};

