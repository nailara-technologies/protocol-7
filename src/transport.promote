## [:< ##

# name  = transport.promote
# descr = restore a demoted transport after probe success
# args  = $dest, $type, $exit

my ( $dest, $type, $exit ) = @ARG;

return if not defined $dest or not defined $type or not defined $exit;

delete <transport.registry>->{'demoted'}{$dest}{$exit}{$type};
delete <transport.registry>->{'demoted'}{$dest}{$exit}
    if not keys %{ <transport.registry>->{'demoted'}{$dest}{$exit} // {} };
delete <transport.registry>->{'demoted'}{$dest}
    if not keys %{ <transport.registry>->{'demoted'}{$dest} // {} };

<[base.logs]>->(
    1, 'transport.promote: %s promoted for %s via %s',
    $type, $dest, $exit
);

## reset consecutive failures ##
my $q = <transport.registry>->{'quality'}{$exit}{$type}{$dest} //= {};
$q->{'consecutive_failures'} = 0;

return 1;

