## p7-host-build layout template [ bin/p7-host-build -layout <file|host> ]
##
## copy it OUTSIDE the tracked tree before filling in real values :
##   ~/.n/host-build/<host>.layout  [ then : bin/p7-host-build -layout <host> ]
## real disk serials and host names never go into the repo.
##
## p7 config style : 'key = value' and 'key : value' are the same, '#'
## starts a comment, '[ .. ]' is an annotation and is ignored. unknown keys
## are refused [ a typo never passes silently ].
##
## sizes : <n>K \ M \ G \ T [ binary : 1G = 1024 MiB ] or 'rest' [ the
## remaining space, the last entry of its list only ].
## file systems : vfat ext4 xfs swap, lvm [ a partition holding a vg ],
## bios_grub [ 1M, legacy boot fallback, no file system ]

## the host and the disk [ lsblk -d -o NAME,SERIAL,MODEL,SIZE ] ##
host.name        = example-host
disk.serial      = 0000-REPLACE-ME

## partitions in disk order : <size> <fs> [ <mount point> | <vg name> ] ##
part.bios        = 1M bios_grub            [ legacy fallback, optional ]
part.efi         = 512M vfat /boot/efi
part.boot        = 1G ext4 /boot
part.main        = rest lvm main-vg

## luks on a partition [ an option, off by default : the actual installs ##
## stay bootable without a passphrase, the data is sealed by n7fs ]      ##
# crypt.main     = luks

## logical volumes in main-vg : <size> <fs> [ <mount point> ] ##
lv.root          = 40G ext4 /
lv.rescue        = 8G ext4                 [ second boot system, not mounted ]
lv.data          = rest xfs /data

## the debian system : trixie for main systems, unstable allowed ##
## [ experiment slot ]                                           ##
system.suite     = trixie
system.arch      = amd64
system.mirror    = http://deb.debian.org/debian
system.locale    = C.UTF-8
# system.timezone = Etc/UTC                [ the default ; a zoneinfo name ]

## network : ifupdown + dhcpcd [ the default : /etc/network/interfaces,    ##
## dhcpcd writes resolv.conf from the lease ], networkd [ no resolved ] or ##
## none. net.wired is an interface match, not a machine's name ; net.wlan  ##
## adds an inactive wpa_supplicant stanza \ networkd stub                  ##
# net.backend    = ifupdown                [ ifupdown | networkd | none ]
# net.wired      = en*                     [ the default ]
# net.wlan       = wl*                     [ optional, disabled stub ]
# net.mac.enp1s0 = 02:00:00:00:00:01       [ per wired interface : wake on lan ]

## grub-efi [ removable path, no nvram write ] or none ##
system.bootloader = grub-efi

## bin/p7-install inside the new system : its dependency profile, and ##
## 'enable' for the boot start of the service unit [ default : no ]   ##
system.profile   = minimal
system.service   = no

## further systems on the same disk, each on its own unmounted lv         ##
## [ ext4 or xfs ] with its own debootstrap tree. the keys above mean the ##
## main system [ system.main.suite \ .profile also work ].  the main      ##
## system's grub owns the one menu : an explicit entry per further system ##
## [ /etc/grub.d/41_p7-systems ], os-prober off.  suite \ profile default ##
## to the main system's, hostname to <host.name>-<system>                 ##
# system.rescue.lv       = lv.rescue
# system.rescue.suite    = trixie
# system.rescue.profile  = minimal
# system.rescue.hostname = example-host-rescue
# system.rescue.timezone = Etc/UTC       [ timezone \ locale \ net : the ]
# system.rescue.locale   = C.UTF-8       [ main system's by default      ]
# system.rescue.net.backend = ifupdown
#
# lv.lab                 = 16G ext4         [ before lv.data : 'rest' stays last ]
# system.lab.lv          = lv.lab
# system.lab.suite       = unstable         [ experiment slot ]

## a first user [ the password : -password-fd <n>, else asked twice on the ##
## terminal ; never argv, never here. without either : locked ]            ##
# user.name      = <name>
#
## its password from p7-vault : a login entry host-build:<host>:<user> ##
## [ field password ], read through a pipe ; -password-fd wins over it ##
# user.password  = vault                 [ or vault:<title> ]

## access for the installing user [ ssh, keys only ] : the installer's     ##
## public key [ vault file entry host-build:<host>:<user>:authorized_keys  ##
## else ~/.ssh/*.pub ] into the user's authorized_keys ; the new host keys ##
## into the installer's ~/.ssh/known_hosts [ no trust on first use ]       ##
# access.from    = installer
# access.alias   = <alias>               [ a Host block in ~/.ssh/config, no dots ]

## protocol-7 [ stage 2, always unless -no-p7 ] : the new host-root key is ##
## created root-held and pinned both ways [ installer <-> new host ] ;     ##
## optional : a cube grant for user.name [ host-config/cube.cfg ]          ##
# access.p7_user = ** ..*.**             [ the access.cmd.usr.<user> mask ]

