## [:< ##

.:[ desktop surfaces : per-host display settings ]:.

## unset means no dpi changes ; set desktop.dpi in the host overlay ##
## desktop.tint2rc and desktop.openbox_rc override detected paths   ##

.:[ desktop surfaces : shared dark violet \ blue theme tokens ]:.

## canonical font spelling : White Rabbit  other spellings left for their ##
## surface adapters : WhiteRabbit, white-rabbit.flipped, White Rabbit     ##
## Regular                                                                ##

desktop.theme.font.family = White Rabbit
desktop.theme.font.size = 13

desktop.theme.color.background = 000013
desktop.theme.color.background_mid = 000042
desktop.theme.color.background_dark = 000208
desktop.theme.color.background_focus = 00084A
desktop.theme.color.background_held = 05082A
desktop.theme.color.foreground = 0055CC
desktop.theme.color.foreground_bright = 0088FF
desktop.theme.color.foreground_dim = 003A8C
desktop.theme.color.accent = 4427AC
desktop.theme.color.warning = C58D07
desktop.theme.color.error = C05050
desktop.theme.color.ok = 09AA5E
desktop.theme.color.selection = 1A0946
desktop.theme.color.button = 001A88
desktop.theme.color.button_top = 000EA0

desktop.theme.translucency.panel = 0.92
desktop.theme.translucency.overlay = 0.74
desktop.theme.translucency.selection = 0.72
desktop.theme.translucency.muted = 0.45

desktop.theme.spacing.xs = 2
desktop.theme.spacing.s = 4
desktop.theme.spacing.m = 8
desktop.theme.spacing.l = 12
desktop.theme.spacing.xl = 20

## old value -> token mapping ; dominant existing values win              ##
## 000011, 000006, 00040c, 010015, 090518 -> color.background             ##
## 000042, 000028, 00003a, 000033, 00003d, 031542 -> color.background_mid ##
## 000208, 000007, 000510, 12061b -> color.background_dark                ##
## 00084A -> color.background_focus ; 05082A -> color.background_held     ##
## 0055CC, 0647c3, 002fdd, 0028c0, 0044aa, 0044ff, 0092f9, 4a68c0         ##
##   -> color.foreground                                                  ##
## 0088FF, 003aff, 5a70ff, 6a8cff -> color.foreground_bright              ##
## 003A8C, 262e99, 2a3a9a, 344080 -> color.foreground_dim                 ##
## 4427AC, 5e35b1, 7700ff, 8b5cf6 -> color.accent                         ##
## C58D07, aa5e02, d4a830, e0b060 -> color.warning                        ##
## C05050, a51d2d -> color.error ; 09AA5E, 4ac0a0, 00e840 -> color.ok     ##
## 1A0946 -> color.selection                                              ##
## 001A88, 001ebb -> color.button ; 000EA0 -> color.button_top            ##
## 0.92 -> translucency.panel ; 0.74 -> translucency.overlay              ##
## 0.72 -> translucency.selection ; 0.45 -> translucency.muted            ##

