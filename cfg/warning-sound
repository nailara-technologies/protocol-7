.:[ warning-sound : audio output and time limit of a play ]:.

## the audio output, passed to mpv as --ao=                               ##
## [ the user's mpv.conf does not decide it ]. empty : no --ao= is passed ##
warning-sound.output = pulse

## a play is stopped after : sample length \ speed + margin, in seconds.  a ##
## hanging playback [ wsl pulse underruns ] ends this way                   ##
warning-sound.limit_margin = 5
## sample length at speed 1.0 [ seconds ], by file name without .ogg ##
warning-sound.sample_length.yourum.warning = 2.0

