## git config fragment : safe.directory for service-user zenki processes ##
##
## coding [ and any other zenka running under the protocol-7 service user ]
## operates on this repository, whose checkout owner differs from the
## service uid. the git binary and libgit2 [ >= 1.7 ] both refuse to touch
## a repo whose owner differs from the current uid : the binary with
## 'detected dubious ownership', libgit2 with GIT_EOWNER 'repository path
## is not owned by current user'. neither reads the GIT_CONFIG_COUNT env
## vars coding.init_code already sets -- only the binary does. both DO
## honor GIT_CONFIG_GLOBAL, which coding.init_code points at this file.
##
## entries are per-path literals and silently inert where absent, so both
## the development checkout and the production install path belong here :
## each host only ever exercises the entry that matches its own checkout.
## safe.directory grants no filesystem access -- it only stops git from
## refusing an otherwise-readable repo on ownership grounds.

[safe]
	directory = /usr/local/protocol-7
	directory = /data/projects/protocol-7
