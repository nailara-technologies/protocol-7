
.: ascii-frame :.

##[ border fill characters ]##

- colors

: fill :
  single   = p7_fg_0000   ## :  single border — structural purple
  double   = p7_fg_0001   ## :: double border — container blue
  dot      = p7_fg_0001   ## .  dot fill — soft blue
  equals   = p7_fg_0002   ## =  separator — amber

: bracket :
  char     = p7_fg_0000   ## [ ] — same as adjacent fill
  label    = p7_fg_0004   ## text inside [ ] — content TRUE blue

: corner :
  soft     = p7_fg_0001   ## . ,  soft endpoints — blue
  anchor   = p7_fg_0000   ## #  hard bottom — structural purple
  anchor.bold = 1

: content :
  value    = p7_fg_0004   ## slot values — TRUE blue
  label    = p7_fg_0001   ## field labels [ role: why: apply: ] — blue
  progress = p7_fg_0003   ## {{PROGRESS}} animated fill — phosphor green

##[ render modes ]##

- modes

: progress :
  border.only = 1         ## emit top border line only, no trailing newline
  animate     = 1         ## \r rewrite loop enabled

: expanded :
  border.only = 0

