
.:[ nailara [ memory ] zenka : focus-weighted memory tree ]:.

[load_config_file:'shared-params']

modules.load          = net protocol io.unix ui auth \
                        base.curve base.sort base.sort-num \
                        base.chk-sum.jha ascii.frame format.yaml \
                        context.memory memory devmod # <- !!

access.cmd.usr.cube   = verify-instance commands heart reload \
                        show-buffer src-age src-ver list \
                        show render tree focus search init startup \
                        dedup summarize zoom digest

## devmod commands : only reachable while devmod is loaded on THIS zenka  ##
## [ v7-zenki.devmod-enable / devmod-clear ], not a permanent grant       ##
access.devcmd.usr.cube = devmod:*

memory.cfg.n_visible        = 7
memory.cfg.n_max_cap        = 13
memory.cfg.focus_decay      = 0.85
memory.cfg.ai_mem_dir       = data/ai-mem
memory.cfg.git_commit_limit = 200
memory.cfg.status_providers = focus_saturation weight_captured rebuild_age branch_count

## manually including for dynamically called routines ##
[base.white-list.register:'memory']
[base.white-list.register:'ascii.frame']

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

