
.:[ resource-aware model management and recommendation zenka ]:.

## loading local network parameters
#
[load_config_file:'shared-params']

## loading external inference model configuration
## (shared across zenki: models, lm-vision, coding, etc.)
#
[load_config_file:'external-inference-models']

system.zenka.verbosity.buffer   =  1   ##  set to 2 or 3 for debugging  ##
system.zenka.verbosity.logfile  =  0
system.zenka.verbosity.console  =  1
#
modules.load = auth.client net protocol io.unix ui jobqueue \
               models format.yaml                    devmod ## <-- dev.

## Access Control - Commands This Zenka Exposes
#
access.cmd.usr.cube = heart verify-instance commands reload show-access \
                      show-buffer list get_model find_models recommend \
                      record_invocation statistics cost_analysis discover \
                      status maintenance \
                      get_model_path get_path_by_amos chat request memory \
                      find rec record stats cost metrics get_path \
                      conversation_create conversation_add_turn \
                      conversation_get_context add_participant extract_file \
                      invoke_participant route_by_role attach_file \
                      list_attachments save_conversation load_conversation \
                      list_conversations compact_conversation \
                      analytics_conversation consensus_vote task_chain \
                      local_server local_discover substitute_template \
                      buffer-erase \
                      get_inference_endpoint scan-path-add \
                      scan-path-del task-notify \
                      delete-model trash-list trash-rescue trash-prune \
                      protect unprotect list-protected \
                      adapter-discover adapter-resolve adapter-repair \
                      adapter-lmstudio-discover adapter-lmstudio-resolve \
                      adapter-lmstudio-repair adapter-export adapter-import \
                      app-models

## devmod commands : only reachable while devmod is loaded on THIS zenka  ##
## [ v7-zenki.devmod-enable / devmod-clear ], not a permanent grant       ##
access.devcmd.usr.cube = devmod:* test_discover test_api_limit \
                          test_api_fallback test_end_to_end_local

## task zenka the task dispatch claims from : 'task' = the local one   ##
## [ default ]. an external route [ 'external.<link>.task' ] makes this ##
## host take that host's tasks for the models it serves itself [ local, ##
## llama, review ] : peek before claim, a notice stream and a poll      ##
## [ models.task.startup ]. set per host in /etc/protocol-7/models/     ##
## host.cfg -- the link and its grants come first                       ##
models.cfg.task_zenka = task
## claimer name sent as task.claim's 2nd arg ##
models.cfg.task_agent = models
## remote task zenka : a task pinned to a model [ ':model:<key>:', jobsite ##
## assessments ] is claimed only for these registry keys [ space        ##
## separated, compared by the content half ]. empty : only a pin equal  ##
## to a model the local coding zenka has loaded [ coding.inference-     ##
## status ] -- anything else stays pending for its owner, never re-     ##
## pinned, never a gpu server swap per task                              ##
models.cfg.task_models =
## remote task zenka : seconds between '<task_zenka>.next' polls ##
models.cfg.task_poll_interval = 30

[load_host_config]

## Module Initialization
#
[load_modules:<modules.load>]
[init_modules]

## Drop Privileges
#
[root.drop_privs:<system.amos-zenka-user>]

## default model for task dispatch [override kimi fallback]
models.task.default_model = local

## Connect to Network
#
[base.net.connect:'unix']

## Register with Network as initialized
## Models have already been discovered during init_code
#
[get_session_id]

## remote task zenka only : notice stream + fallback poll, armed after ##
## the privilege drop [ a reload re-arms from models.init_code ]       ##
[models.task.startup]

## Enter Event Loop
#
[zenka.loop]

