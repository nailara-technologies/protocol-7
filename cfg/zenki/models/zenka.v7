
.:[ resource-aware model management and recommendation zenka ]:.

## loading local network parameters
#
[load_config_file:'shared-params']

## loading external inference model configuration
## (shared across zenki: models, lm-vision, coding, etc.)
#
[load_config_file:'external-inference-models']

system.zenka.verbosity.buffer   =  1   ##  set to 2 or 3 for debugging  ##
system.zenka.verbosity.logfile  =  0
system.zenka.verbosity.console  =  1
#
modules.load = auth.client net protocol io.unix ui jobqueue models devmod ## <-- dev.

## Access Control - Commands This Zenka Exposes
#
access.cmd.usr.cube = heart verify-instance commands reload show-access \
                      show-buffer list get_model find_models recommend \
                      record_invocation statistics cost_analysis discover \
                      test_discover status maintenance \
                      get_model_path get_path_by_amos chat request memory \
                      get find rec record stats cost metrics get_path \
                      conversation_create conversation_add_turn \
                      conversation_get_context add_participant extract_file \
                      invoke_participant route_by_role attach_file \
                      list_attachments save_conversation load_conversation \
                      list_conversations compact_conversation \
                      analytics_conversation consensus_vote task_chain \
                      test_api_limit test_api_fallback test_end_to_end_local \
                      local_server local_discover substitute_template \
                      core-subs get set dump eval-code exec-sub buffer-erase \
                      list-subs permission-setup since unload-unsafe \
                      unload-devmod get_inference_endpoint scan-path-add \
                      scan-path-del task-notify \
                      adapter-discover adapter-resolve adapter-repair \
                      adapter-lmstudio-discover adapter-lmstudio-resolve \
                      adapter-lmstudio-repair adapter-export adapter-import \
                      app-models

## Module Initialization
#
[load_modules:<modules.load>]
[init_modules]

## Drop Privileges
#
[root.drop_privs:<system.amos-zenka-user>]

## default model for task dispatch (override kimi fallback)
models.task.default_model = local

## Connect to Network
#
[base.net.connect:'unix']

## Register with Network as initialized
## Models have already been discovered during init_code
#
[get_session_id]

## Enter Event Loop
#
[zenka.loop]

