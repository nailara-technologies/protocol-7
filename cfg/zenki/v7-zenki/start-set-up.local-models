
 .:[  'local-models' : defines a test-setup configuration for LLM zenki ]:.

.: globals :.

  zenki.enabled  =  cube p7-log system models coding lm-vision \
                                                  image-quality \
                                                    vision-batch \
                                                     httpd events
# zenki.disabled =

.: zenki :.

# specific configuration imported : zenki/<zenka_name>/start.cfg ###

  - dist-upgrade

      max_concurrency  = 1
      restart.disabled = 1

      : v7-init :
        start_mode = exec-external
        exec_bin = p7-dist-upgrade            # [ ./bin/p7-deps dist-upgrade, ]
        exec_usr = root

