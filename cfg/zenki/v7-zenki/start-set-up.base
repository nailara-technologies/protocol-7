
 .:[  'base' : defines a basic local [v7] zenka start-up configuration ]:.

.: globals :.

  zenki.enabled  =  cube p7-log system          # models coding

## no external here : a fresh host opens no connection to other hosts. a ##
## host with link records enables it in its overlay [ base.load_host_    ##
## config ] : v7-zenki.host.zenki.enable = external                      ##

  zenki.disabled =

.: zenki :.

# specific configuration imported : zenki/<zenka_name>/start.cfg ###

  - dist-upgrade

      max_concurrency  = 1
      restart.disabled = 1

      : v7-init :
        start_mode = exec-external
        exec_bin = p7-dist-upgrade            # [ ./bin/p7-deps dist-upgrade ]
        exec_usr = root

