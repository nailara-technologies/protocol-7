
 .:[  'base' : defines a basic local [v7] zenka start-up configuration ]:.

.: globals :.

  zenki.enabled  =  cube p7-log system external # models coding

  zenki.disabled =

.: zenki :.

# specific configuration imported : zenki/<zenka_name>/start.cfg ###

  - dist-upgrade

      max_concurrency  = 1
      restart.disabled = 1

      : v7-init :
        start_mode = exec-external
        exec_bin = p7-dist-upgrade            # [ ./bin/p7-deps dist-upgrade ]
        exec_usr = root

