
 .:[  'remote-server' : simple [v7] zenka start-up cfg for web-servers  ]:.

.: globals :.

  zenki.enabled  =  cube p7-log  httpd web  letsencr httpsd  nameserv  system  events
# note : 'letsencr' is configured as 'ondemand' zenka, restarted by 'events'

## no automatic start on a server [ on-demand \ as a dependency ] : the web ##
## space plugin subscribes to the orbital zenki ; discover is lan multicast, ##
## graphics-matrix a desktop visualization. external + nodes stay possible  ##
## [ links between hosts ] -- a host that needs neither disables them in its ##
## local-modifications commit, until finer-grained control exists          ##
  zenki.disabled =  discover graphics-matrix

.: zenki :.

# specific configuration imported : zenki/<zenka_name>/start.cfg ###

  - dist-upgrade

      max_concurrency  = 1
      restart.disabled = 1

      : v7-init :
        start_mode = exec-external
        exec_bin = debian_dist_upgrade.sh       # [ ./bin/dependencies/.., ]
        exec_usr = root

### external program example ###    [ supports '<AMOS-user>' from X11-vars ]

  - namesrv

      max_concurrency = 1
      dependencies = cube

      : v7-init :
        start_mode = exec-external
        exec_bin = /usr/local/bin/namesrv
        exec_usr = root

### rudimentary backend update wrapper - used for development acceleration ###

  - pull-git

      max_concurrency = 1
      dependencies = cube

      : v7-init :
        start_mode = exec-external
        exec_bin = p7-git-pull--rebase
        exec_usr = root

