
 .:[  'remote-server' : simple [v7] zenka start-up cfg for web-servers  ]:.

.: globals :.

  zenki.enabled  =  cube p7-log  httpd web  letsencr httpsd  nameserv  system  events
# note : 'letsencr' is an 'ondemand' zenka : events sends letsencr.renew daily, httpsd.cert_watch near expiry

## no automatic start on a server [ on-demand \ as a dependency ] : the web ##
## space plugin subscribes to the orbital zenki ; discover is lan           ##
## multicast, graphics-matrix a desktop visualization. external + nodes     ##
## stay possible [ links between hosts ] -- a host that needs neither       ##
## disables them in host-config/v7-zenki.cfg, until finer-grained control   ##
## exists                                                                   ##
  zenki.disabled =  discover graphics-matrix

## per-host zenki choices belong into                                      ##
## /etc/protocol-7/host-config/v7-zenki.cfg [ base.load_host_config ], not ##
## into a local edit of this profile -- the three keys are applied on top  ##
## of whichever profile is selected                                        ##
## [ including an automatic '-lowram' one ], space separated names :       ##
##   v7-zenki.host.zenki.enable    = <names>  ## added to zenki.enabled   ##
##   v7-zenki.host.zenki.disable   = <names>  ## removed from enabled and ##
##                                            ## added to zenki.disabled  ##
##   v7-zenki.host.zenki.on-demand = <names>  ## added to zenki.on-demand ##

.: zenki :.

# specific configuration imported : zenki/<zenka_name>/start.cfg ###

  - dist-upgrade

      max_concurrency  = 1
      restart.disabled = 1

      : v7-init :
        start_mode = exec-external
        exec_bin = p7-dist-upgrade            # [ ./bin/p7-deps dist-upgrade, ]
        exec_usr = root

### external program example ###    [ supports '<AMOS-user>' from X11-vars ]

  - namesrv

      max_concurrency = 1
      dependencies = cube

      : v7-init :
        start_mode = exec-external
        exec_bin = /usr/local/bin/namesrv
        exec_usr = root

### rudimentary backend update wrapper - used for development acceleration ###

  - pull-git

      max_concurrency = 1
      ## one-shot : a refused pull [ local changes, conflict ] ends it ##
      ## [ v7-zenki.process_zenka_end ] -- :wait-down: gets FALSE      ##
      restart.disabled = 1
      dependencies = cube

      : v7-init :
        start_mode = exec-external
        exec_bin = p7-git-pull--rebase
        exec_usr = root

