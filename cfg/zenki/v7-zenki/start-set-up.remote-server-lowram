
 .:[  'remote-server-lowram' : lean [v7] start-up cfg for ~2 GB servers  ]:.

.: globals :.

  zenki.enabled  =  cube p7-log  httpd web  letsencr httpsd  nameserv  system  events
# note : 'letsencr' is configured as 'ondemand' zenka, restarted by 'events'

## a ~2 GB host [ ~90 MB per zenka ] : only the enabled zenki and the ones ##
## listed here start automatically [ on demand, as a dependency ] -- every ##
## other one by hand only [ v7-zenki.start <name> ]. remote-server is the  ##
## permissive profile for larger hosts ; choose per host in                ##
## /etc/protocol-7/host-config/v7-zenki.cfg : load.start_setup = <profile> ##
## calc : a quick value when someone asks, kept in the session history ;   ##
## it ends itself when idle [ set_ondemand_timeout 4200 s ]                ##
  zenki.on-demand =  letsencr debian smtpd users calc
  zenki.disabled  =  discover graphics-matrix

.: zenki :.

# specific configuration imported : zenki/<zenka_name>/start.cfg ###

  - dist-upgrade

      max_concurrency  = 1
      restart.disabled = 1

      : v7-init :
        start_mode = exec-external
        exec_bin = p7-dist-upgrade            # [ ./bin/p7-deps dist-upgrade, ]
        exec_usr = root

### external program example ###    [ supports '<AMOS-user>' from X11-vars ]

  - namesrv

      max_concurrency = 1
      dependencies = cube

      : v7-init :
        start_mode = exec-external
        exec_bin = /usr/local/bin/namesrv
        exec_usr = root

### rudimentary backend update wrapper - used for development acceleration ###

  - pull-git

      max_concurrency = 1
      dependencies = cube

      : v7-init :
        start_mode = exec-external
        exec_bin = p7-git-pull--rebase
        exec_usr = root

