
.:[ protocol-7 'v7-zenki' process start-up zenka ]:.

system.zenka.name = v7-zenki

[load_config_file:'shared-params']
[load_config_file:'X11-vars']

[load_config_file:'zenki/v7-zenki/pressure.cfg']  ## memory pressure sampler

crypt.C25519.auto_load_keys  = 0  ## prevent base key auto-loading ..,

## Load debian dependency manager for automatic dependency installation
modules.load = v7-zenki jobqueue net protocol io.unix io.ip ui ascii format.yaml \
                           crypt.C25519 auth.zenka auth.client trust \
                           keystore   ## debian

load.start_setup = base          #    <--   [ ,../zenki/v7-zenki/start-set-up.base ]
                              ## [ additional : local-models + remote-server ]
access.cmd.usr.cube          = *
access.cmd.usr.system        = v7-zenki.teardown

v7-zenki.host-reboot.enabled        = 1
v7-zenki.host-reboot.term-delay     = 1.3787
v7-zenki.system-poweroff.enabled    = 1
v7-zenki.system-poweroff.term-delay = 1.3787

v7-zenki.local_cube.connect-unix = 1   ## connect to local cube on unix path ##

###  BIN/P7C AUTO-INSTALLATION (LOCAL)  ###
v7-zenki.cfg.install_bin_p7c      =   yes
v7-zenki.cfg.bin_p7c_static       =   yes
v7-zenki.cfg.bin_p7c_has_symlink  =   auto # [yes|no|auto]
#                       ## /usr/local/protocol-7 ., ##
system.bin_p7c_src_path     =   'bin/c_src/p7c.c'   ##
v7-zenki.cfg.p7c_bin_path         =   '/usr/local/bin/p7c'

###  BIN/P-7-R AUTO-INSTALLATION (REMOTE)  ###
v7-zenki.cfg.install_bin_p7r      =   yes
v7-zenki.cfg.bin_p7r_static       =   yes
v7-zenki.cfg.bin_p7r_has_symlink  =   auto # [yes|no|auto]
#                               ## /usr/local/protocol-7 ., ##
system.bin_p7r_src_path     =   'bin/c_src/p-7-r.c'         ##
v7-zenki.cfg.p7r_bin_path         =   '/usr/local/bin/p-7-r'

### ZENKA SYMLINKS AUTO-INSTALLATION ###
v7-zenki.cfg.install_zenka_symlinks  =  yes     # [yes|no]
v7-zenki.cfg.zenka_symlink_dir       =  '/usr/local/bin'
v7-zenki.cfg.install_workflow_shortcuts = yes   # [yes|no] p7.<shorthand> links

### ZENKA DEPENDENCY AUTO-INSTALL [ sys_deps start condition ] ###
## hosts enable it in /etc/protocol-7/host-config/v7-zenki.cfg :
#v7-zenki.cfg.auto_install_deps  =  yes    ## wait for + install declared deps
v7-zenki.cfg.sys_deps.retry_after = 3600   ## secs before a 'failed' zenka
                                           ## re-probes + re-installs
## an install that never answers counts as failed after this [ secs ] : the ##
## zenka then starts without, degraded                                      ##
#v7-zenki.cfg.sys_deps.install_timeout = 1800
## never gated : the install path itself [ routing, logging, installers ] ##
#v7-zenki.cfg.sys_deps.exempt = cube p7-log debian os-pkg

## v7-zenki stdout cloning | redirection ##
#
v7-zenki.path.zenka_stdout.parent_dir = /var/run/.7/STDOUT
v7-zenki.cfg.zenka_stdout_redir = yes # ::enabled::
#

# create protocol-7 user if required.,
## layered host config : cfg/ defaults < detected facts < host decisions ##
## [ /etc/protocol-7/host-config/host.detected : written once by          ##
## base.host.detect, delete it to detect again -- host.mem_mb, host.cpus,  ##
## host.ipv6 ]                                                             ##
[base.host.detect]
[load_config_file_if_present:'cfg-dir:host-config/host.detected']

## per-host overrides                                                       ##
## [ /etc/protocol-7/host-config/v7-zenki.cfg, optional ] : e.g.            ##
## 'load.start_setup = remote-server-lowram' -- the start profile without a ##
## local-modifications commit                                               ##
[load_host_config]

[root.check_system_user:<system.amos-zenka-user>]

[load_modules:<modules.load>]
[init_modules]

[init-done] ## declare initialization completed ##

## host-root delegates cube's S [ <backend key dir>/<S>.dlg ] now and daily ##
## -- after init, never from init_code [ HOST-ROOT-DELEGATION ]             ##
[v7-zenki.delegation.startup]

[v7-zenki.call_cmd:<system.args>]

[zenka.loop]

