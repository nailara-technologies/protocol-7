
 .:[ protocol-7 nameserv dns server zenka (phase-1) ]:.

[load_config_file:'shared-params']

## dns server configuration
## public, one dual-stack socket [ v4 through v4-mapped addresses ] ; a     ##
## host without ipv6 falls back to 0.0.0.0 by itself [ like httpd ].        ##
## authoritative only [ REFUSED outside its zones -- no open resolver ].  a ##
## desktop where systemd-resolved holds :53 sets  'nameserv.bind.addr =     ##
## 127.0.0.1' in /etc/protocol-7/host-config/nameserv.cfg                   ##
nameserv.bind.addr = 0:0:0:0:0:0:0:0
nameserv.bind.port = 53
nameserv.zone_dir  = '/var/protocol-7/nameserv/zones'

## rfc 1035 master files for apply-zone-source [ <zone>.zone per zone ] ##
nameserv.cfg.zone_source_dir = '/etc/protocol-7/nameserv/zones'

## dns over tcp [ rfc 7766 ] : connections beyond the limit are closed at ##
## once, idle ones after the timeout [ seconds, reset per query ]         ##
# nameserv.cfg.tcp.max_connections = 77
# nameserv.cfg.tcp.idle_timeout    = 13

## forwarding dns cache [ loopback clients only -- never an open resolver ] ##
## : an authoritative REFUSED + rd + loopback client is answered from the   ##
## cache, a miss is forwarded [ rd = 1 ] to the upstreams below ; without   ##
## them the resolv.conf nameservers are used, loopback addresses excluded   ##
## -- the cache never asks itself                                           ##
# nameserv.cfg.cache.enabled          = no
# nameserv.cfg.cache.max_ttl          = 86400
# nameserv.cfg.cache.max_negative_ttl = 900
# nameserv.cfg.cache.max_entries      = 7777
# nameserv.cfg.cache.upstream         = 192.0.2.53 192.0.2.54
# nameserv.cfg.cache.upstream_timeout = 3

## loopback-only sub-named instances [ v7-zenki.start nameserv[cache] or   ##
## nameserv[cache-local] ] : both bind udp + tcp 53 on loopback only ; the ##
## client address is still checked in code on every query. upstreams are a ##
## space-separated p7 config list and can be replaced in host-config.      ##
nameserv.cfg.by_subname.cache.bind_addr = 127.0.0.1 ::1
nameserv.cfg.by_subname.cache.bind_port = 53
nameserv.cfg.by_subname.cache.zone_dir  = '/var/protocol-7/nameserv/cache/zones'
nameserv.cfg.by_subname.cache.enabled   = yes
nameserv.cfg.by_subname.cache.upstream  = 1.1.1.1 9.9.9.9

nameserv.cfg.by_subname.cache-local.bind_addr = 127.0.0.1 ::1
nameserv.cfg.by_subname.cache-local.bind_port = 53
nameserv.cfg.by_subname.cache-local.zone_dir  = '/var/protocol-7/nameserv/cache-local/zones'
nameserv.cfg.by_subname.cache-local.enabled   = yes
nameserv.cfg.by_subname.cache-local.upstream  = 1.1.1.1 9.9.9.9

## command access for cube
access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase buffer-erase-level \
                      show-access src-ver src-age subname name \
                      reload-zones status set-record remove-record \
                      get-record show-zone list-zones discover-nodes \
                      add-txt remove-txt ensure-zone last-data-timestamp \
                      remove-zone restore-zone sync-pull sign-zone \
                      add-record apply-zone-source consistency \
                      ensure-challenge-alias upstreams set-upstreams \
                      set-domain-upstreams set-held-upstreams dns-probe \
                      set-behaviour encrypted-upstreams \
                      set-encrypted-upstreams

## dns behaviour probe [ nameserv.dns-probe, asked by net ] : one name per ##
## list and round. known_answer = name=addr[,addr] pairs whose real answer ##
## is fixed ; neutral = names compared between our upstreams and the dhcp  ##
## server. empty lists skip the check [ logged ]. examples only :          ##
# nameserv.cfg.dns_probe.known_answer = fixed.example.test=192.0.2.77
# nameserv.cfg.dns_probe.neutral      = neutral.example.test
base.interval.cfg.type.dns-probe-wait.start      = 2.1
base.interval.cfg.type.dns-probe-wait.factor     = 1.01
base.interval.cfg.type.dns-probe-wait.cap        = 2.1
base.interval.cfg.type.dns-probe-wait.cap_jitter = 0.34

## encrypted fallback [ dns over tls 853, dns over https 443 ] : used for a ##
## network whose stored behaviour is intercepting \ blocking-outside ; the  ##
## held dhcp server is the logged degraded fallback. tls_name is the sni    ##
## and the certificate name, verification is always on                      ##
## [ system ca store, or nameserv.cfg.encrypted.ca_file ]. examples only :  ##
# nameserv.cfg.encrypted.upstream.quad9-dot.protocol = dot
# nameserv.cfg.encrypted.upstream.quad9-dot.address  = 9.9.9.9
# nameserv.cfg.encrypted.upstream.quad9-dot.tls_name = dns.quad9.net
# nameserv.cfg.encrypted.upstream.quad9-doh.protocol = doh
# nameserv.cfg.encrypted.upstream.quad9-doh.address  = 9.9.9.9
# nameserv.cfg.encrypted.upstream.quad9-doh.tls_name = dns.quad9.net
# nameserv.cfg.encrypted.upstream.quad9-doh.path     = /dns-query
## how long one encrypted try waits [ connect, tls, answer ] : start, then ##
## x1.2 per further try of the same query, capped with a jitter            ##
base.interval.cfg.type.dns-enc-wait.start      = 4.7
base.interval.cfg.type.dns-enc-wait.factor     = 1.2
base.interval.cfg.type.dns-enc-wait.cap        = 8.1
base.interval.cfg.type.dns-enc-wait.cap_jitter = 1.3
## a failed connect \ handshake backs the upstream off, the delay from ##
## base.interval.next ; the first success clears it                    ##
base.interval.cfg.type.dns-enc-reconnect.start      = 3.4
base.interval.cfg.type.dns-enc-reconnect.factor     = 1.6
base.interval.cfg.type.dns-enc-reconnect.cap        = 377
base.interval.cfg.type.dns-enc-reconnect.cap_jitter = 55

## logging verbosity
system.zenka.verbosity.buffer  = 2
system.zenka.verbosity.console = 1

## required modules
## per-host overrides [ /etc/protocol-7/host-config/<zenka>.cfg, optional ] ##
[load_host_config]

## crypt.C25519 : the sync key only, never the backend base key ##
crypt.C25519.auto_load_keys = 0

modules.load = auth.client net protocol io.unix io.ip ui format.yaml \
               crypt.C25519 trust nameserv

[load_modules:<modules.load>]
[init_modules]

## drop privileges
[root.drop_privs:<system.amos-zenka-user>]


## connect to cube for ipc (receive routed commands)
[base.net.connect:'unix']

## register with cube (required for command routing)
[get_session_id]

## the sync key, as the backend user [ created once, never regenerated ] -- ##
## after the cube session : a new key asks v7-zenki for its delegation      ##
[nameserv.sync.key.ensure]

## enter event loop (handles dns via io events)
[zenka.loop]

