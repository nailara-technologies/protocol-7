
 .:[ protocol-7 nameserv dns server zenka (phase-1) ]:.

[load_config_file:'shared-params']

## dns server configuration
## public, one dual-stack socket [ v4 through v4-mapped addresses ] ; a ##
## host without ipv6 falls back to 0.0.0.0 by itself [ like httpd ].     ##
## authoritative only [ REFUSED outside its zones -- no open resolver ]. ##
## a desktop where systemd-resolved holds :53 sets                       ##
## 'nameserv.bind.addr = 127.0.0.1' in /etc/protocol-7/host-config/nameserv.cfg ##
nameserv.bind.addr = 0:0:0:0:0:0:0:0
nameserv.bind.port = 53
nameserv.zone_dir  = '/var/protocol-7/nameserv/zones'

## dns over tcp [ rfc 7766 ] : connections beyond the limit are closed ##
## at once, idle ones after the timeout [ seconds, reset per query ]    ##
# nameserv.cfg.tcp.max_connections = 77
# nameserv.cfg.tcp.idle_timeout    = 13

## forwarding dns cache [ loopback clients only -- never an open        ##
## resolver ] : an authoritative REFUSED + rd + loopback client is     ##
## answered from the cache, a miss is forwarded [ rd = 1 ] to the      ##
## upstreams below ; without them the resolv.conf nameservers are      ##
## used, loopback addresses excluded -- the cache never asks itself    ##
# nameserv.cfg.cache.enabled          = no
# nameserv.cfg.cache.max_ttl          = 86400
# nameserv.cfg.cache.max_negative_ttl = 900
# nameserv.cfg.cache.max_entries      = 7777
# nameserv.cfg.cache.upstream         = 192.0.2.53 192.0.2.54
# nameserv.cfg.cache.upstream_timeout = 3

## command access for cube
access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase buffer-erase-level \
                      show-access src-ver src-age subname name \
                      reload-zones status set-record remove-record \
                      get-record show-zone list-zones discover-nodes \
                      add-txt remove-txt ensure-zone last-data-timestamp \
                      remove-zone restore-zone sync-pull sign-zone \
                      add-record consistency

## logging verbosity
system.zenka.verbosity.buffer  = 2
system.zenka.verbosity.console = 1

## required modules
## per-host overrides [ /etc/protocol-7/host-config/<zenka>.cfg, optional ] ##
[load_host_config]

## crypt.C25519 : the sync key only, never the backend base key ##
crypt.C25519.auto_load_keys = 0

modules.load = auth.client net protocol io.unix io.ip ui format.yaml \
               crypt.C25519 trust nameserv

[load_modules:<modules.load>]
[init_modules]

## drop privileges
[root.drop_privs:<system.amos-zenka-user>]


## connect to cube for ipc (receive routed commands)
[base.net.connect:'unix']

## register with cube (required for command routing)
[get_session_id]

## the sync key, as the backend user [ created once, never regenerated ] ##
## -- after the cube session : a new key asks v7-zenki for its delegation ##
[nameserv.sync.key.ensure]

## enter event loop (handles dns via io events)
[zenka.loop]

