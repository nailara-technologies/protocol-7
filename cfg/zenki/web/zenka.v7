
  .:[ web content zenka ]:.

[load_config_file:'shared-params']

system.zenka.verbosity.buffer = 2

access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer content process_template_ipc \
                      cmd.jobs-data cmd.jobs-sync cmd.jobs-sync-foreign *

## host-specific overrides                                                 ##
## [ base.load_host_config : /etc/protocol-7/host-config/web.cfg ] -- MUST ##
## carry the same web.auth.secret as the httpd host config : the web zenka ##
## mints the session tokens                                                ##
[load_host_config]

modules.load = auth.client net protocol io.unix ui format.yaml web devmod \
               index.gen_path jobsite.job plugin.web.auth  ## [ opt-in auth ] ##
[load_modules:<modules.load>]

plugins.load = plugin.web
[load_plugins:<plugins.load>]

[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

