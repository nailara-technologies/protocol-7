
 .:[ jobsite — job search scan and assessment coordinator ]:.

[load_config_file:'shared-params']

buffer.session.log_cmd  = p7-log.append
buffer.session.max_size = 795648

system.zenka.verbosity.buffer = 1

## named search categories — space separated list of category keys
jobsite.cfg.categories       =      linux-sysadmin linux-developer devops \
                                      platform-engineer security-engineer \
                                       ki-infrastruktur backend-architect \
                                                      solutions-architect \
                                                       security-architect

## per-category stepstone search urls
jobsite.cfg.url.linux-sysadmin      = https://www.stepstone.de/jobs/linux-administrator/in-Offenburg
jobsite.cfg.url.linux-developer     = https://www.stepstone.de/jobs/linux-entwickler/in-Freiburg
jobsite.cfg.url.devops              = https://www.stepstone.de/jobs/devops-engineer/in-Offenburg
jobsite.cfg.url.platform-engineer   = https://www.stepstone.de/jobs/platform-engineer/in-deutschland
jobsite.cfg.url.security-engineer   = https://www.stepstone.de/jobs/security-engineer/in-deutschland
jobsite.cfg.url.ki-infrastruktur    = https://www.stepstone.de/jobs/ki-infrastruktur/in-deutschland
jobsite.cfg.url.backend-architect   = https://www.stepstone.de/jobs/softwarearchitekt/in-Freiburg
jobsite.cfg.url.solutions-architect = \       ## 'Home Office'-workaround [successful] ##
    https://www.stepstone.de/jobs/software-architect?action=facet_selected%3bworkFromHome%3b1&wfh=1
jobsite.cfg.url.security-architect  = https://www.stepstone.de/jobs/security-architect/in-deutschland

## minimum llm score [ 0..10 ] to flag job for review
jobsite.cfg.threshold       = 7

## model pinned in every assessment prompt [ composite registry key,
## see coding.cfg.start_model / models.registry.lookup ] -- keep this in
## step with whichever model is actually preferred, or every assessment
## forces the gpu server to kill+respawn away from the zenka's own
## default. ZDMAPAY:AR3OCKQ = Qwopus3.5 9B v3 ["more precise on analysis"]
# jobsite.cfg.assessment_model = ZDMAPAY:AR3OCKQ

# jobsite.cfg.assessment_model = M7XXVGY:AH6BYCA  ##  Qwen3.8 9B Abliterated  ##
jobsite.cfg.assessment_model = OFSQC4I:QDBKEXY  ## Qwen3.8 9B Heretic Uncensored


## seconds between automatic rescans [ 0 = manual trigger only ]
jobsite.cfg.rescan_interval = 7007  ## current ondemand timeout : 7200 ##

## seconds between sync pushes to httpd cache
jobsite.cfg.sync_interval = 300

## remote fetch zenka [ optional ] : when set to an external route like     ##
## 'external.delta.site-yaml', scans + refetches run on THAT host's         ##
## site-yaml [ stepstone blocks this host's ip range ] and fetched jobs     ##
## travel back through its durable outbox + subscribe-fetched STRM          ##
## transport. default : unset == local site-yaml                            ##
### set in /etc/protocol-7/jobsite/host.cfg :
## jobsite.cfg.fetch_zenka = external.delta.site-yaml

## seconds to wait for a dispatched assessment/repair task's reply before
## giving up on it and draining the next queue entry [ watchdog against a
## lost task.create/task.wait-done reply wedging cycle on 'assessing' ]
jobsite.cfg.assess_timeout = 777

## when it fires, task is asked first : a task still pending \ running \ done
## re-arms the watchdog, up to this many times [ ~5 h at 777 s -- a cpu-only
## server takes 8-9 min per assessment ] before giving up
jobsite.cfg.assess_watch_extensions = 24

## assessment tasks in flight at once : dispatch.next fills up to N, each
## in-flight job holds its slot through its watchdog until its reply [ or
## timeout \ give_up ] releases it and refills one. default 1 = the old
## strictly serial chain
jobsite.cfg.assess_parallel = 1

## two-stage delete retention (in V7 epochs)
jobsite.cfg.trash_keep_epochs   = 1  ## recoverable compressed stage
jobsite.cfg.deleted_keep_epochs = 2  ## plain deleted stage before purging

## httpd sync endpoint : repo default is a hub pushing to its own    ##
## httpd [ loopback needs no auth token with auth.exempt-loopback ]. ##
## any other target [ several : sync_urls ] and its bearer token go  ##
## in /etc/protocol-7/jobsite/host.cfg :                             ##
##   jobsite.cfg.sync_url    = http://<host>/jobs-sync               ##
##   jobsite.cfg.sync_urls   = <url> [<url> ..]                      ##
##   jobsite.cfg.sync_token  = <token>   ## or per-url : ##
##   jobsite.cfg.sync_tokens = <url>=<token> [<url>=<token> ..]      ##
##   jobsite.cfg.sync_url_roles = <url>=owner|marks [<url>=<role> ..] ##
## [ roles : owner [ default ] = full sync behaviour ; marks = export ##
##   marks + prefs ONLY, never job state or removal signals -- for    ##
##   a url whose web belongs to a DIFFERENT jobsite, e.g. forwarding  ##
##   export marks to a host that does not own this stock ]            ##
## [ token : p7c web.auth-issue jobsite-push -ttl 31536000 ]         ##
jobsite.cfg.sync_url      = http://127.0.0.1/jobs-sync
jobsite.cfg.sync_urls     =

## path to cv/profile context file injected into assessment prompt
jobsite.cfg.profile_file    = /etc/protocol-7/jobsite/profile.txt

## jobcenter reporting : periodic bewerbungen-csv exports (backed up, ##
## outside the repo -- personal data) + rendered report output        ##
jobsite.cfg.csv_import_dir       = /data/jobcenter-report-data/reports-sent/csv
jobsite.cfg.report_dir           = /data/jobcenter-report-data/reports
jobsite.cfg.cv_dir               = /data/jobcenter-report-data/cv
jobsite.cfg.applications_html_dir = /data/jobcenter-report-data/applications-html
jobsite.cfg.reference_docs_dir   = /data/jobcenter-report-data/references
jobsite.cfg.mail_dir             = /data/jobcenter-report-data/mail-rejections

access.cmd.usr.cube = heart subname name commands reload verify-instance \
                      list-jobs src-age src-ver show-buffer buffer-erase \
                      buffer-erase-level mail_received manual-sync \
                      scan status list approve reject reset set-threshold \
                      set-status job-upsert import-url import-url-http \
                      clear-tasks blacklist-add blacklist-stats \
                      show-prompt progress report-stray-jobs group-jobs \
                      list-trashed rescue-http get-prefs set-prefs rescue \
                      report-build dossier-build set-export-time \
                      mark-exported unmark-exported repair-encoding \
                      delete

## devmod commands : only reachable while devmod is loaded on THIS zenka  ##
## [ v7-zenki.devmod-enable / devmod-clear ], not a permanent grant       ##
access.devcmd.usr.cube = devmod:*

modules.load = auth.client net protocol io.unix ui format.yaml jobsite \
                                    clients.http clients.https  devmod

## host-specific overrides [ base.load_host_config : /etc/protocol-7/  ##
## jobsite/host.cfg, 'key = value' on top of this file ] -- e.g. a     ##
## cpu-only host sets jobsite.cfg.assessment_model to the model its    ##
## coding zenka serves [ data/tasks/coding-cpu-host-setup.md ]         ##
[load_host_config]

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[base.get_session_id]

[zenka.loop]

