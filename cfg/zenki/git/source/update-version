#!/usr/bin/perl
## [:< ##

# name  = git.update-version
# descr = Update Protocol-7 version strings

use v5.24;
use strict;
use English;
use warnings;
use File::Spec;
use Cwd qw| abs_path |;
use FindBin qw| $RealBin |;

## Wrapper around bin/dev/update-version ##

my $up_dir = File::Spec->updir;
my $p7_root = abs_path(
    File::Spec->catdir( $RealBin, ($up_dir) x 4 )
);

my $update_ver = File::Spec->catfile( $p7_root, 'bin', 'dev', 'update-version' );

die ":\n:: update-version not found: $update_ver\n\n" if !-x $update_ver;

exec( $update_ver, @ARGV );

