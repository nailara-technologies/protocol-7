
.:[ nailara [ file ] 'index' zenka ]:.

[load_config_file:'shared-params']

modules.load          = net protocol io.unix ui auth index \
                        base.chk-sum.bmw384 route.bmw384  devmod # <- !!

access.cmd.usr.cube   = verify-instance commands heart reload \
                        list show-buffer buffer-erase buffer-erase-level \
                        add-wordlist stop-job dependencies \
                        add-path gen-path write lookup cluster correlate \
                        search contributions index-stats \
                        index-path find-route verify-coordinate visual-wheel \
                        stats address decode feed-dir export persist restore \
                        replace remove

## devmod commands : only reachable while devmod is loaded on THIS zenka  ##
## [ v7-zenki.devmod-enable / devmod-clear ], not a permanent grant       ##
access.devcmd.usr.cube = devmod:*

index.path.index-cfg   = /data/index/set-up/index-paths
index.path.index-files = /data/index/data/index-state

index.permissions.index_root_path = 0770

[base.white-list.register:'base.chk-sum.profile']
[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

