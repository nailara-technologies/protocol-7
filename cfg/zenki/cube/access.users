
   .:[ cube command access permissions set-up ]:.

    ## << developer account permissions >> ## matches <system.admin-user>
    ## web.auth-issue [ web session token minting ] is listed explicitly :  ##
    ## admin-only, kept even when the ** wildcards above get disabled       ##
    access.cmd.usr.<admin-user>  =   ** ..*.** web.auth-issue
    access.cmd.usr.<unix-admin>  =   ** ..*.** web.auth-issue

    ### adjust as required [ current : permissive ] ###
    access.cmd.usr.root          =   ** ..*.** ## [ bin/nshell + 'p7.nshell' ]
    access.cmd.usr.unix-root     =   ** ..*.** ## [ /usr/local/bin/p7c auth. ]

    ## console zenki for sending notification messages ##
    access.cmd.usr.notify-loves  =   notify.loves
    access.cmd.usr.notify-info   =   notify.info
    access.cmd.usr.notify-warn   =   notify.warn

    ## remote auth-keypair peer identities [ narrow, per-identity grants -- ##
    ## a peer's blast radius is exactly the commands listed here, never     ##
    ## the admin's ** ..*.** wildcard above ] ##
    access.cmd.usr.test-auth-keypair = users.remote-get link-upgrade list \
                                       osf-cache.has osf-cache.merkle \
                                       osf-cache.segment

    ## a jobsite on another host fetching through this host's site-yaml   ##
    ## [ jobsite.cfg.fetch_zenka = external.<link>.site-yaml ] : inert     ##
    ## unless this cube authorizes a key under the label 'remote-fetch'    ##
    ## [ ~/.n/remote-keys/authorized/cube/remote-fetch.public ]            ##
    access.cmd.usr.remote-fetch = link-upgrade site-yaml.import \
                                  site-yaml.import-url \
                                  site-yaml.queue-depth \
                                  site-yaml.subscribe-fetched \
                                  site-yaml.outbox-confirm

