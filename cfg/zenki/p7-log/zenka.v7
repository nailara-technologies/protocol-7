
 .:[ nailara 'p7-log' [log-writer] zenka ]:.

[load_config_file:'shared-params']
system.zenka.verbosity.buffer  = 2
system.zenka.verbosity.logfile = 1

log.timestamp_mode  =  ntime-b32  #  [ntime-b32|ntime-num|unix|localtime]

## log anonymization [ opt-in : classify > replace > store ] ##
p7-log.anon.enabled    =  1
p7-log.anon.token_len  =  13

## its own key, not the zenka user's identity key [ <user>.base ]: rotating ##
## the identity no longer forces archive-anon-table + rekey-anon-table      ##
p7-log.anon.key_name   =  p7-log.anon

## anon.key resolves its key file through crypt.C25519.key_path ; no key  ##
## auto-loading here [ the secret is read lazily after drop_privs ]       ##
crypt.C25519.auto_load_keys = 0

modules.load        = auth.client net protocol io.unix io.ip ui crypt.C25519 \
                      p7-log

access.cmd.usr.cube = append commands heart reload cur-pid verify-instance \
                      list-logs \
                      list show-buffer buffer-erase buffer-erase-level \
                      set-name-width file-sizes verbosity \
                      resolve resolve-line archive-anon-table \
                      rekey-anon-table

## devmod commands : only reachable while devmod is loaded on THIS zenka  ##
## [ v7-zenki.devmod-enable / devmod-clear ], not a permanent grant       ##
access.devcmd.usr.cube = devmod:*

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

