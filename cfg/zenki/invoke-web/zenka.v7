
.:[ invoke.ai web process manager zenka ]:.

[load_config_file:'shared-params']
[load_config_file:'external-inference-models']

##  the invoke.ai install owner : the zenka runs as this user  ##
invoke-web.run_user = <system.admin-user>
system.zenka-user.current = <invoke-web.run_user>   ## <-- not 'protocol-7' ##

##  queue at an invoke.ai start [ its processor starts resumed ] : yes =  ##
##  paused until resume ; startup = paused only while starting, resumed  ##
##  after it ; no = untouched                                            ##
invoke-web.start_paused = startup

##  interactive queue mode at ready : new items jump to the front  ##
invoke-web.queue_interactive_start = yes

##  start memory guard [ invoke.ai takes ~9 GB RAM while loading ] :     ##
##  start waits until at least this much RAM \ VRAM is free             ##
invoke-web.start.min_free_ram_mb  = 8192
invoke-web.start.min_free_vram_mb = 4096

##  drain : once the queue is done and invoke.ai idle this long [ output ##
##  lines, db writes from ui use ], stop it and end the zenka [ 0 = off ]  ##
invoke-web.drain.idle_after         = 4620
invoke-web.drain.paused_counts_idle = no

##  autofetch : a render failing on a missing model fetches it through the ##
##  fetch-files zenka [ off | ask = log a confirm hint for fetch-missing | ##
##  on ; yes \ no as usual ] -- default off. max_gb : per-model size limit ##
##  [ 0 = no limit ] ; timeout : watchdog for a lost fetch reply           ##
invoke-web.autofetch.mode    = off
invoke-web.autofetch.max_gb  = 0
invoke-web.autofetch.timeout = 7200

##  image index : local primary in the zenka data dir [ state/image-index.db ],  ##
##  lazy external backup copy [ empty = off ]                                   ##
invoke-web.index.backup_path = /mnt/ext-xfs-data/p7-images/image-index.db

##  invoke.ai output : ring buffer 'invokeai' [ show-buffer invokeai ],  ##
##  persisted by p7-log ; the transport file in /var/run/.7/invoke-web  ##
##  is truncated once read beyond output.trim_mb                        ##
buffer.invokeai.log_cmd  = p7-log.append
buffer.invokeai.max_size = 262144
invoke-web.output.trim_mb = 16

##  index the result images of every finished render [ yes | no ]  ##
invoke-web.index.on_render = yes

system.zenka.verbosity.buffer  = 2
system.zenka.verbosity.logfile = 2
system.zenka.verbosity.console = 1

start.on-demand    = 1
restart.disabled   = 1
heartbeat.disabled = 1

## idle timeout: 5 minutes — invoke process keeps running independently ##
[base.zenki.set_ondemand_timeout:300]

access.cmd.usr.cube = heart verify-instance commands reload \
                      show-buffer show-access \
                      start stop restart status health log \
                      pause resume queue queue-order \
                      queue-interactive queue-front \
                      model-source fetch-missing requeue requeue-failed \
                      requeue-cancelled requeue-missing \
                      session-park session-resume sessions index

## devmod commands : only reachable while devmod is loaded on THIS zenka ##
## [ v7-zenki.devmod-enable / devmod-clear ], not a permanent grant      ##
access.devcmd.usr.cube = devmod:*

##  memory guard callbacks cross-loaded from the coding zenka [ same    ##
##  dependency objects gate its inference server spawns ]               ##
modules.load = auth.client net protocol io.unix ui invoke-web clients.http \
               format.json \
               image.analyze \
               coding.callback.object_memory_system \
               coding.callback.object_memory_gpu

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.zenka-user.current>]

[base.net.connect:'unix']

[get_session_id]

[zenka.loop]

