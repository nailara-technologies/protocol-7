
 .:[ nshell [ Protocol-7 native shell as zenka ] ]:.

[load_config_file:'shared-params']

access.cmd.usr.cube = commands heart verify-instance \
                      reload src-age src-ver rel-ver \
                      list show-buffer buffer-erase buffer-erase-level \
                      history get-history clear-history \
                      eval execute \
                      char-add debug-status \
                      * # <-- all enabled temp. for devmod debug commands

modules.load = auth.client net protocol io.unix ui ascii format.yaml \
               editor nshell   devmod ## <-- development only .. ##

## History session grouping - gap in minutes to define session boundaries
## Used by Page Up/Down to skip between work sessions based on temporal proximity
history.session_gap_minutes = 13

## Overflow markers shown at line edges when input exceeds terminal width
## Set to '' to disable a marker [ minimalist mode ]
# nshell.cfg.overflow_marker_left  = <
# nshell.cfg.overflow_marker_right = >

## Whether to redraw cursor indicator after replies [ all | none ]
## all  : cursor redrawn after all reply types [default]
## none : never redraw cursor after any reply
# nshell.cfg.cursor_after_reply = all

[load_modules:<modules.load>]

## chat/session logic for coding-zenka display-mode tabs [ submit vs      ##
## task-append routing, task-id capture, auto-subscribe -- see            ##
## data/tasks/coding-zenka-session-ui.md ]. nshell core stays agnostic to ##
## this : it only dispatches to a mode's declared plugin, never hardcodes ##
## coding-zenka behaviour itself                                          ##
plugins.load = plugin.nshell.coding-session
[load_plugins:<plugins.load>]

[init_modules]

## Set authentication user to current Unix user (not zenka name)
system.auth-user = <nshell.unix_user>

[base.net.connect:'unix']

## nshell authenticates as Unix user, not as zenka
## so it doesn't need/use cube session IDs
## [base.get_session_id]

## Register hooks to intercept unknown messages from cube\other zenki
# [ These hooks allow nshell to display messages to the user instead of
# silently dropping them ]
#
[nshell.register_hooks]

## Register STDIN as an I/O watcher so keyboard input is captured continuously
[nshell.setup_stdin_watcher]

[nshell.clear_terminal]   ## clear screen and print phosphor colored cursor ##

## tell cube this session can receive real STRM-SIZE framing instead of the
## atomic SIZE-body downgrade [ see base.handler.command.process_reply ] --
## must run before [init-done:TRUE] : that's what makes this session
## reachable by other zenki, so the flag has to already be set by then
[nshell.declare_strm_size_support]

[init-done:TRUE]  ## setting 'initialized' state for sending 'init-reports' ##

[zenka.loop]

