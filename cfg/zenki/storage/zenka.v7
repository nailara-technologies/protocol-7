
.:[ 'storage' zenka ]:.

[load_config_file:'shared-params']


## start amos chksum unix domain socket ##
storage.use_amos_chksum_socket = yes

## start SFTP unix domain socket ##
storage.use_SFTP_socket  = yes


sftp.allowed_unix_users = <system.amos-zenka-user>  ## running as ##

system.zenka.verbosity.console = 1
system.zenka.verbosity.buffer  = 2

modules.load  =  auth.client net protocol io.unix ui storage plan-9 \
                        plugin.storage.checksum plugin.storage.p7ref  ## devmod

access.cmd.usr.cube-13 = whoami name heart commands src-ver rel-ver src-age

access.cmd.usr.cube    = verify-instance commands heart reload cur-pid \
                         list src-ver rel-ver src-age \
                         show-buffer buffer-erase buffer-erase-level \
                         name subname plan9-connect plan9-scan \
                         plan9-read-file plan9-write-file \
                         plan9-create plan9-remove plan9-rename \
                         plan9-resize map-file \
                         lookup-checksum p7ref visual

## devmod commands : only reachable while devmod is loaded on THIS zenka  ##
## [ v7-zenki.devmod-enable / devmod-clear ], not a permanent grant       ##
access.devcmd.usr.cube = devmod:*

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

