
 .:[ 'pdf2html' conversion zenka ]:.

[load_config_file:'shared-params']
system.access.wildcards.allow = false

access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer get_url check_format \
                                              child.cur-pid
access.cmd.usr.parent = commands reload show-buffer convert_pdf \
                                                        cur-pid
access.cmd.usr.child = cube.v7-zenki.notify_online cube.p7-log.append

pdf.html.cache_dir   = /var/cache/pdf2html
pdf.html.cache_perm  = 0755
pdf.html.cache_timeout = 30 # days

modules.load = auth.client net protocol io.unix ui pdf.html.base
[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[pdf.html.base.fork_conv_child]

[zenka.loop]

