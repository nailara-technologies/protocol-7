
 .:[ native x11 login-screen : unprivileged greeter + root crypt helper ]:.

[load_config_file:'shared-params'] or [base.exit:1,'login-screen config failed']
[load_config_file:'X11-vars'] or [base.exit:1,'login-screen config failed']
[load_config_file:'zenki/login-screen/auth.cfg'] or [base.exit:1,'login-screen config failed']
[load_config_file:'zenki/login-screen/theme.cfg'] or [base.exit:1,'login-screen config failed']
[load_host_config] or [base.exit:1,'login-screen host config failed']

login-screen.greeter_user = <system.amos-zenka-user>

access.cmd.usr.cube = commands heart reload verify-instance session-ended lock

modules.load = auth.client net protocol io.unix ui base.curve login-screen
[load_modules:<modules.load>] or [base.exit:1,'login-screen module load failed']
[init_modules] or [base.exit:1,'login-screen module init failed']

## root helper and private runtime dirs exist before the permanent drop ##
[login-screen.start_auth_helper] or [base.exit:1,'login-screen helper failed']
[root.drop_privs:<login-screen.greeter_user>] or [base.exit:1,'login-screen privilege drop failed']

[base.net.connect:'unix'] or [base.exit:1,'login-screen cube connection failed']
[base.get_session_id] or [base.exit:1,'login-screen session setup failed']
[base.X-11.get_display] or [base.exit:1,'login-screen display setup failed']
[login-screen.xauth_setup] or [base.exit:1,'login-screen xauth setup failed']
[login-screen.open_window] or [base.exit:1,'login-screen window setup failed']

[base.gtk.main_loop]

