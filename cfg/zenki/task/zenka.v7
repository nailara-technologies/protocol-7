
.:[ task zenka — general-purpose task queue ]:.

[load_config_file:'shared-params']

buffer.session.log_cmd  = p7-log.append
buffer.session.max_size = 795648

system.zenka.verbosity.buffer = 2

system.zenka.name = task

access.cmd.usr.cube = heart subname name commands reload verify-instance \
                      list src-age src-ver show-buffer \
                      buffer-erase buffer-erase-level \
                      create continue queue show result summarize \
                      summarize-done summary-tree-query summary-tree-notify \
                      claim complete fail reset start next handover touch \
                      wait-done trigger-cold-queue subscribe \
                      valued-nodes valued-query valued-stats query stats

## devmod commands : only reachable while devmod is loaded on THIS zenka ##
## [ v7-zenki.devmod-enable / devmod-clear ], not a permanent grant      ##
access.devcmd.usr.cube = devmod:*

access.cmd.usr.models = show queue claim complete fail reset start

modules.load = auth.client net protocol io.unix ui calc format.yaml \
                   format.json task thermal reasoning.branch valued

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[base.get_session_id]

[zenka.loop]

