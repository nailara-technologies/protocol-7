
.:[ 'menu-commands' zenka [ menu management provider ] ]:.

[load_config_file:'shared-params']

access.cmd.usr.cube = commands heart verify-instance reload \
                              list show-buffer buffer-erase \
                                         buffer-erase-level \
                                    src-age src-ver rel-ver \
                      add remove update list clear-mappings \
                                add-category remove-category \
                                    status get-provider-data

## devmod commands : only reachable while devmod is loaded on THIS zenka ##
## [ v7-zenki.devmod-enable / devmod-clear ], not a permanent grant      ##
access.devcmd.usr.cube = devmod:*

modules.load = auth.client net protocol io.unix ui menu-commands  devmod ## <-- [LLL] ##
[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]    ###  unix user protocol-7  ###

[base.net.connect:'unix'] ## connect to local cube.. ##

## registering with protocol-7-menu as a provider ##
[menu-commands.update-menu] # sending notidication #
#
[get_session_id]       ## register as initialized ##
[zenka.loop]           ## . .processing events .. ##

