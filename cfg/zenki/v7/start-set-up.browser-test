 .:[  'browser-test' : display stack for web-browser zenka development  ]:.

.: globals :.

  zenki.enabled  =  cube p7-log  X-11  openbox  web-browser  system

# zenki.disabled =

.: zenki :.

# specific configuration imported : zenki/<zenka_name>/start.cfg ###

  - dist-upgrade

      max_concurrency  = 1
      restart.disabled = 1

      : v7-init :
        start_mode = exec-external
        exec_bin = debian_dist_upgrade.sh
        exec_usr = root

