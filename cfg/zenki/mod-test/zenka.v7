
.:[ module test zenka ]:.

[load_config_file:'shared-params']

system.zenka.verbosity.buffer = 2

access.cmd.usr.cube = heart subname name commands reload verify-instance \
                      list src-age src-ver show-buffer cur-pid \
                      buffer-erase buffer-erase-level \
                      write-blacklist-code \
                      start-test stop \ ## exec-sub eval-code # * # <-- devmod
                      strm-start strm-stop strm-open ## <-- STRM test commands

## devmod commands : only while devmod is loaded on this zenka ##
access.devcmd.usr.cube = devmod:*

modules.load = auth.client net protocol io.unix io.ip ui mod-test         ## devmod
[load_modules:<modules.load>]
[base.prune_key:'modules.load']
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

# [base.net.connect:'ip']
[base.net.connect:'unix']

system.zenka.verbosity.console = 2

[base.get_session_id]

# [mod-test.check_name_collisions]

# [mod-test.perlmod.run_reload_test]

[zenka.loop]

