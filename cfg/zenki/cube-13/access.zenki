
   .:[ 'zulum-13' cube zenka command access permission set-up ]:.

              access.cmd.usr.cube =  verify-instance heart \
                                     show-buffer list reload \
                                     jump stream-status receive-entropy

    ## devmod commands : only reachable while devmod is loaded on THIS     ##
    ## zenka [ v7-zenki.devmod-enable is not network-reachable here --     ##
    ## cube-13 is not v7-zenki-managed -- but the universal base.sig_NUM53 ##
    ## handler still answers a direct local signal, so this grant matters  ##
    ## once loaded ]                                                       ##
           access.devcmd.usr.cube =  devmod:*

            access.cmd.usr.zulum =  receive-entropy stream-status jump

                access.cmd.usr.*  =  close exit commands heart time clear \
                                     whoami name when-present present heart \
                                     ntime-dec timestamp src-ver rel-ver \
                                     reply-encoding-mode

