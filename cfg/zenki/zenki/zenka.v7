
 .:[ protocol-7 zenki dependency manager and smart launcher ]:.

[load_config_file:'shared-params']

system.zenka.verbosity.buffer  = 2
system.zenka.verbosity.logfile = 2

## commands available to cube users ##
access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase buffer-erase-level \
                      start stop status stats *

##                     .:[ hybrid start-up ]:.                              ##
##                                                                          ##
## only the domain module is loaded up front [ 'configure' zenka shape ] --  ##
## every further namespace is loaded on demand by                            ##
## [zenki.parent.select-modules], once the invoked command is known.  with   ##
## no console command in <system.args> this is a resident, 'v7-zenki'        ##
## managed instance and the complete set is loaded after all, so nothing     ##
## behind [zenka.loop] changes -- see                                        ##
## data/md/design/ZENKA-HYBRID-STARTUP-DISPATCH.md                           ##

## every namespace a fully capable instance needs [ cube ipc + event loop ] ##
zenki.cfg.modules.full        = auth.client net protocol io.unix ui

## namespaces loaded when no console command was given [ resident mode ]  ##
zenki.cfg.modules.resident    = <zenki.cfg.modules.full>

## fallback for console commands not named in the manifest below ##
zenki.cfg.modules.cmd-default = <zenki.cfg.modules.full>

## per-console-command namespace manifest ['-none-' : 'zenki' is enough]  ##
##                                                                        ##
## 'start' relays through cube and waits for the reply in the event loop, ##
## so it needs everything.  the purely local commands need nothing at all ##
## beyond the domain module itself                                        ##
zenki.cfg.cmd-modules.start       = <zenki.cfg.modules.full>
zenki.cfg.cmd-modules.status      = -none-
zenki.cfg.cmd-modules.attach-logs = -none-
zenki.cfg.cmd-modules.commands    = -none-
zenki.cfg.cmd-modules.describe    = -none-

## console commands that need an authenticated cube session ##
zenki.cfg.cmd-network.start       = yes

## the one namespace that is always present ##
modules.load = zenki

[load_modules:<modules.load>]

## further namespaces for this specific invocation -- loaded before  ##
## [init_modules] so their own init hooks still run in that one pass ##
[zenki.parent.select-modules]

[init_modules]

## privilege handling, cube connect and either console dispatch [ one-shot ] ##
## or [zenka.loop] [ resident ] all happen inside this one call             ##
[zenki.parent.start-up]

