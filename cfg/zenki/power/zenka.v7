
 .:[ "gembird" power socket control zenka ]:.

[load_config_file:'shared-params']

access.cmd.usr.cube = verify-instance heart commands reload add-wol-device remove-wol-device wake * # <-- LLL

modules.preload = power.set-up set-up.json
[load_modules:<modules.preload>]
[init_modules]
[set-up.json.import_file:'power.set-up.json']

power.config_dir  = '/etc/protocol-7/zenki/power'
power.config_file = set-up.json
power.state_file  = states.json

# power.cfg. =

## wake : every candidate network at once, then repeat rounds against ##
## packet loss on short, growing delays [ power.wake.schedule_next ]  ##
power.cfg.wake_repeats = 3
base.interval.cfg.type.wake-fallback.start = 3.1
base.interval.cfg.type.wake-fallback.factor = 1.3
base.interval.cfg.type.wake-fallback.cap = 13

modules.load = auth.client net protocol io.unix ui power set-up.json netinfo

[load_modules:<modules.load>]
[init_modules]

[base.disable_command:'subname']

[base.net.connect:'unix']

[base.get_session_id]

[zenka.loop]

