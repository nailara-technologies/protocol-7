
 .:[ protocol-7 nodes-zenka ]:.

[load_config_file:'shared-params']

system.zenka.verbosity.buffer = 2  ##  memory ring buffer verbosity  ##

access.cmd.usr.cube = commands heart reload verify-instance *-version src-age \
                      list show-buffer buffer-erase buffer-erase-level \
                      cur-pid \
                      add-tronk add-group-user update-protocol-elf \
                      host-status orbital-position orbital-p7ref \
                      orbital-grid-fragment

## devmod commands : only reachable while devmod is loaded on THIS zenka ##
## [ v7-zenki.devmod-enable / devmod-clear ], not a permanent grant      ##
access.devcmd.usr.cube = devmod:*

modules.load = auth.client net protocol io.unix io.ip ui crypt.C25519 nodes  ## devmod

[load_modules:<modules.load>]
[init_modules]

## orbital position derivation and publishing ##
[nodes.orbital.init_code]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

