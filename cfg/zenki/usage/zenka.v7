
.:[ usage tracking zenka : account quota and rate-limit values ]:.

## runs as the admin unix user [ same privilege model as the 'powershell' ##
## zenka ] because the provider credentials it reads at query time live in ##
## that user's home directory : the parsed numbers are what other zenki    ##
## get to see, never anything credential-shaped                            ##

[load_config_file:'shared-params']
[load_config_file:'X11-vars']

## this zenka does no zenka-to-zenka signed messaging of its own -- provider
## credentials arrive as plain oauth bearer tokens, not p7 keys -- so its own
## C25519 identity key is never actually used. autocreate-user-key was
## inherited unchanged from the powershell template and left auto_load_keys
## at its TRUE default, which broke on reload : crypt.C25519.post_init
## resolves the key name via the GLOBAL <system.amos-zenka-user> ('protocol-7')
## regardless of what this zenka's own drop_privs line actually targets
## ('taeki'), so at root-time startup it can write wherever that resolves to,
## but the post-drop-privs reload [ now genuinely running as taeki ] can't
## read it back -- "no read permission for key 'protocol-7.base.secret'".
## same latent mismatch likely affects any zenka overriding its drop-privs
## target away from the standard service user [ powershell included, just
## never reload-tested ] -- worth its own task if/when this zenka [ or any
## other taeki-privileged one ] ever needs a real C25519 identity, not fixed
## here. simplest correct fix for now : don't load a key nothing uses
crypt.C25519.autocreate-user-key = yes
crypt.C25519.auto_load_keys      = no

system.zenka.verbosity.buffer = 2

access.cmd.usr.cube = commands heart name subname verify-instance reload \
                      src-age src-ver list show-buffer \
                      buffer-erase buffer-erase-level \
                      claude kimi status claude-refresh-test

## pty : plugin.usage.claude.refresh_token needs a real terminal [ IO::Pty ]
## to refresh claude code's own oauth token -- see that module's note on why
## a plain pipe doesn't work for it the way it does for kimi's refresh
modules.load = auth.client net protocol.protocol-7 io.unix ui crypt.C25519 \
               format.json clients.https usage pty
[load_modules:<modules.load>]

plugins.load = plugin.usage.claude plugin.usage.kimi
[load_plugins:<plugins.load>]

[init_modules]

[root.drop_privs:<system.AMOS-user>.':'.<system.amos-zenka-user>]

[base.net.connect:'unix']

[base.get_session_id]

## explicit post-drop callback, same pattern the 'universal' zenka uses    ##
## for its own after-drop setup [ [universal.startup], called after        ##
## base.net.connect there too ] -- arms both providers' proactive refresh  ##
## watchdogs here, genuinely after drop_privs, rather than from inside     ##
## plugin.usage.kimi/claude.init_code [ which runs during init_modules,    ##
## before the drop, and whose own timer-arm read the wrong credential      ##
## directory on a fresh boot as a result -- see usage.startup's own note ] ##
[usage.startup]

[zenka.loop]

