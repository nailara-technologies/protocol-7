
.:[ site-yaml — structured site scraping zenka ]:.

[load_config_file:'shared-params']

buffer.session.log_cmd  = p7-log.append
buffer.session.max_size = 795648

system.zenka.verbosity.console = 0  ## silencing regular operation ##
system.zenka.verbosity.buffer  = 2  ## messages available for dev. ##

access.cmd.usr.cube = heart subname name commands reload verify-instance \
                      list src-age src-ver show-buffer src-age src-ver \
                      buffer-erase buffer-erase-level \
                      fetch search import import-url queue-depth \
                      list-stray-jobs export-stray-job confirm-stray-claimed \
                      subscribe-fetched outbox-confirm outbox-list

## devmod commands : only reachable while devmod is loaded on THIS zenka  ##
## [ v7-zenki.devmod-enable / devmod-clear ], not a permanent grant       ##
access.devcmd.usr.cube = devmod:*

site-yaml.bypass_proxy = no         ## bypass proxy for stepstone domains ? ##
site-yaml.import_max_pages = 4      ## pages per search term [25 jobs|page] ##
site-yaml.import_delay_search = 1.5  ## seconds between search page fetches ##
site-yaml.import_delay_detail = 2.0  ## seconds between job detail fetches  ##

modules.load = auth.client net protocol io.unix ui format.yaml site-yaml clients.https # devmod # <- <!>
[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[base.get_session_id]

[zenka.loop]

