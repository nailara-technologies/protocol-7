 .:[ protocol-7 claude code session zenka ]:.

[load_config_file:'shared-params']

## owner mode : the zenka runs as the admin user                         ##
## [ the owner's claude login and mcp config ] ; init, still root, gives ##
## the zenka dirs to this user                                           ##
system.zenka-user.current = <system.admin-user>   ## <-- not 'protocol-7' ##

access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase buffer-erase-level \
                      src-age src-ver subname name \
                      start send interrupt status tail stop permission \
                      session-register session-unregister \
                      session-post sessions \
                      session-export session-import session-lease

system.zenka.verbosity.buffer  = 2
system.zenka.verbosity.console = 2

## the claude code process [ one session per instance ] : binary and flags  ##
## are config -- --model, --resume and --permission-prompt-tool are added   ##
## from claude.start parameters \ the saved session \ the keys below mode : ##
## owner [ the admin user, its claude login and mcp config, the owner's     ##
## checkout ] -- zenka \ dev \ inspect : data/tasks/claude-zenka.md "run-as ##
## modes" [ planned ] ; the mode sets the drop_privs user below             ##
claude.cfg.mode   = owner
claude.cfg.binary = claude
claude.cfg.args   = -p --input-format stream-json \
                    --output-format stream-json --verbose
# claude.cfg.model                  = sonnet
# claude.cfg.permission_prompt_tool =      ## later stage [ claude.permission ]
# claude.cfg.work_dir               =      ## default : <system.root_path>
# claude.cfg.var_dir                =      ## default : the zenka data dir
## interrupt : control [ a stream-json control_request ] or signal [ SIGINT ]
claude.cfg.interrupt    = control
## session continuity : how long a store lease holds without a renewal   ##
# claude.cfg.lease_hours  = 13
# claude.cfg.config_dir   =              ## default : ~/.claude of the user
## readable event lines kept in memory [ claude.status \ claude.tail ]
claude.cfg.buffer_lines = 377

## context size reminder [ claude.context.check ] : a registered live    ##
## session is offered a handover once per threshold                      ##
## [ percent of the window ] ; none while a handover is younger than the ##
## quiet minutes                                                         ##
# claude.cfg.context_window                 = 1000000
# claude.cfg.context_thresholds             = 70 85
# claude.cfg.context_handover_quiet_minutes = 13
base.interval.cfg.type.claude-context.minutes = 3
base.interval.cfg.type.claude-context.jitter  = 0.08

## stop : TERM, then KILL when the child is still there after this delay ##
base.interval.cfg.type.claude-stop.start      = 3
base.interval.cfg.type.claude-stop.factor     = 1.6
base.interval.cfg.type.claude-stop.cap        = 13
base.interval.cfg.type.claude-stop.cap_jitter = 2

## eof seen, exit status not yet there : reap checks ##
base.interval.cfg.type.claude-reap.start      = 1
base.interval.cfg.type.claude-reap.factor     = 1.6
base.interval.cfg.type.claude-reap.cap        = 8
base.interval.cfg.type.claude-reap.cap_jitter = 1

modules.load = auth.client net protocol io.unix ui stream_child session_move \
               claude

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.zenka-user.current>]

[base.net.connect:'unix']

[base.get_session_id]

[zenka.loop]

