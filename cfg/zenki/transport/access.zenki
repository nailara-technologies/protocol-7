
   .:[ transport zenka command access permission set-up ]:.

                access.cmd.usr.proxy      =  transport.select

                access.cmd.usr.transport  =  transport.select \
                                              transport.profile.load \
                                              transport.profile.match \
                                              transport.handle.direct-tcp \
                                              transport.handle.udt-tunnel \
                                              transport.handle.quic-hysteria \
                                              transport.handle.socks5 \
                                              transport.handler.cred_rotated \
                                              transport.probe.timer \
                                              transport.demote \
                                              transport.promote \
                                              transport.quality.derive_passive \
                                              transport.quality.measure \
                                              transport.quality.probe

