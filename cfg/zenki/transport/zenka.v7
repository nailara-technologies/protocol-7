
 .:[ protocol-7 transport zenka ]:.

[load_config_file:'shared-params']

transport.cfg.profile_dir    = <system.root_path>/data/yaml/transport/profiles
transport.cfg.probe_interval = 30

access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase buffer-erase-level \
                      status cred-rotated

## devmod commands : only reachable while devmod is loaded on THIS zenka ##
## [ v7-zenki.devmod-enable / devmod-clear ], not a permanent grant.     ##
## harness scenarios 2/3 (F2/F8) now need devmod-enable before eval-code ##
access.devcmd.usr.cube = devmod:*

env_override_allowed = PROTOCOL_7_VAR

modules.load = auth.client net protocol io.unix io.ip ui format.yaml transport devmod

[load_modules:<modules.load>]
[init_modules]

[load_config_file:'zenki/transport/access.zenki']

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[base.get_session_id]

[zenka.loop]

