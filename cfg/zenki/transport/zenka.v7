
 .:[ protocol-7 transport zenka ]:.

[load_config_file:'shared-params']

transport.cfg.profile_dir = <system.root_path>/data/yaml/transport/profiles
base.interval.cfg.type.transport-probe.start      = 13
base.interval.cfg.type.transport-probe.factor     = 1.2
base.interval.cfg.type.transport-probe.cap        = 34
base.interval.cfg.type.transport-probe.cap_jitter = 0.3
base.interval.cfg.type.transport-init.start       = 0.5
base.interval.cfg.type.transport-init.factor      = 1
base.interval.cfg.type.transport-init.cap         = 0.5
base.interval.cfg.type.transport-init.cap_jitter  = 0.2

[load_config_file:'transport-exit-groups.v7']

access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase buffer-erase-level \
                      status cred-rotated

## devmod commands : only reachable while devmod is loaded on THIS zenka ##
## [ v7-zenki.devmod-enable-rw / devmod-clear ], not a permanent grant.  ##
## harness scenarios 2/3 (F2/F8) need devmod-enable-rw before eval-code  ##
access.devcmd.usr.cube = devmod:*

env_override_allowed = PROTOCOL_7_VAR

modules.load = auth.client net protocol io.unix io.ip ui format.yaml transport devmod

[load_modules:<modules.load>]
[init_modules]

[load_config_file:'zenki/transport/access.zenki']

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[base.get_session_id]

[zenka.loop]

