
.:[ windows host bridge zenka : plugin-mapped powershell.exe capabilities ]:.

[load_config_file:'shared-params']
[load_config_file:'X11-vars']

crypt.C25519.autocreate-user-key = yes

modules.load     = auth.client net protocol.protocol-7 io.unix ui crypt.C25519 powershell # devmod
access.cmd.usr.* = commands heart name verify-instance reload src-age \
                   show-buffer buffer-erase buffer-erase-level \
                   screenshot-capture display-switch-toggle pointer-stream \
                   pointer-stream-path notify-msg notify-loves-it \
                   notify-recover get-event-log mem-used mem-top-proc

## devmod commands : only reachable while devmod is loaded on THIS zenka ##
## [ v7-zenki.devmod-enable / devmod-clear ], not a permanent grant      ##
access.devcmd.usr.* = devmod:*

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.AMOS-user>.':'.<system.amos-zenka-user>]

[base.net.connect:'unix']

[base.get_session_id]

[zenka.loop]

