
 .:[ protocol-7 development work[flow] zenka ]:.

[load_config_file:'shared-params']
buffer.zenka.log_cmd = ''    ## standalone zenka : no network logging

## keys are explicitly loaded by commands that need them [ e.g. version-sign-commit ]
crypt.C25519.auto_load_keys      = no
crypt.C25519.autocreate-user-key = no

## git remotes for version-sign-commit [ hub = github, ext-bundle = local bundle ]
work.git.remotes = hub ext-bundle

modules.load = crypt.C25519 git workspace-transfer format.yaml work

[load_modules:<modules.load>]
[init_modules]

[base.call.console_command:<system.args>]

[exit]

