
.:[ 'plan-9' protocol zenka ]:.

modules.load = plan-9.protocol.constants.pre_init plan-9.protocol.codec plan-9.protocol.error \
               plan-9.config plan-9.server plan-9.server.export_buffer \
               plan-9.server.handle_version plan-9.server.handle_attach \
               plan-9.server.handle_walk plan-9.server.handle_request \
               plan-9.server.handle_io plan-9.server.client.accept \
               plan-9.server.client.close plan-9.server.client.data \
               plan-9.server.buffer.read plan-9.server.buffer.write \
               plan-9.server.buffer.stat

[load_modules:<modules.load>]
[init_modules]

[zenka.loop]

