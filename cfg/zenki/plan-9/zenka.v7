
.:[ 'plan-9' protocol zenka ]:.

[load_config_file:'shared-params']

system.zenka.verbosity.console = 1
system.zenka.verbosity.buffer  = 2

modules.load  =  auth.client net protocol io.unix io.ip ui \
                        plan-9.protocol plan-9.server plan-9.cmd  ## devmod

access.cmd.usr.cube-13 = whoami name heart commands src-ver rel-ver src-age

access.cmd.usr.cube    = verify-instance commands heart reload cur-pid \
                         list list-deps src-ver rel-ver src-age \
                         show-buffer buffer-erase buffer-erase-level \
                         name subname \
                         * ## <-- devmod [ restrict later ]

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

## nothing else ever calls plan-9.server -- it does the real listen-socket ##
## bind via io.ip.tcp.input.open, without this the zenka compiles         ##
## everything but never actually accepts a connection                    ##
[plan-9.server]

[zenka.loop]

