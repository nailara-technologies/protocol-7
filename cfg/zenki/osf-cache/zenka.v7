.:[ osf-cache : operating system file cache - local holdings lookup ]:.

[load_config_file:'shared-params']

modules.load          = net protocol io.unix ui auth format.yaml osf-cache
## explicit command list : no wildcard - has answers for this node's own
## holdings, status and rescan are read-only, lookup fans out to the
## other osf-cache sessions ; install stays out ##
access.cmd.usr.cube   = commands heart reload verify-instance \
                        list show-buffer buffer-erase buffer-erase-level \
                        status has rescan lookup
## peer grant [ zenka-to-zenka form, like zulum's cube-13 line ] : a
## session authenticated as osf-cache may ask this node's holdings.
## routed-via-cube calls arrive as user cube [ covered above ] - this
## covers a direct zenka-to-zenka connection and documents the intent ##
access.cmd.usr.osf-cache = has

## per-subname instance config [ v7-zenki.start osf-cache[peer] ] :
## the peer instance scans this dir instead of the apt archive cache ##
osf-cache.cfg.by_subname.peer.cache_dir = /var/protocol-7/osf-cache/peer-archives

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

## post-drop startup : load state, build the anchor index, arm the
## sliced rescan timer [ same pattern usage.startup uses - init_code
## runs BEFORE the drop and must not scan or arm timers ]
[osf-cache.startup]

[zenka.loop]

