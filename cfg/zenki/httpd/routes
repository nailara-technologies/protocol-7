
## httpd route registry
## format: METHOD  PATH  SUBROUTINE
##
## METHOD    : GET POST PUT DELETE HEAD ANY
## PATH      : exact path, or prefix:<path> for prefix matching
## SUBROUTINE: module name (called with session id as first arg)
##
## routes are checked before template and static file routing
##
## note: subroutines from a foreign module namespace (e.g. plugin.web.*)
##       need [base.white-list.register:'plugin.name'] in the start file.
##       plugins under the loaded namespace (plugin.httpd.*) work as-is.

## web auth endpoints -- every token check is relayed to the web zenka's    ##
## admission gate [ LOGIN-ADMISSION.md section 2 on all four paths : login  ##
## holds in the fair queue, status \ logout \ bearer answer at once, never  ##
## queued ] ; the real socket facts travel in the call, never a header.     ##
## token minting is admin-only : p7c  web.auth-issue <user> [ -ttl <s> ] -- ##
## the ui shows a paste-token prompt on any 401 from /jobs*                 ##
GET   /auth/status   httpd.route.handler.web-status
POST  /auth/login    httpd.route.handler.web-login
POST  /auth/logout   httpd.route.handler.web-logout

## job pipeline api -- auth.required since 2026-10 [ these routes are     ##
## served on a PUBLIC host : bearer token [ jobsite push, minted via      ##
## web.auth-issue ] or p7_session cookie [ ui login ] required ].         ##
## auth.exempt-loopback spares ONLY real socket peers 127.0.0.1 / ::1     ##
## [ never X-Forwarded-For : behind a proxy loopback would be everyone ]. ##
## a local set-up reaching the ui over its private LAN address [ e.g.     ##
## the WSL host ] is NOT loopback : it either logs in via the ui prompt,  ##
## or the operator exempts that peer address in host config [ applies     ##
## only to routes carrying auth.exempt-loopback ] :                       ##
##   /etc/protocol-7/host-config/httpd.cfg :                              ##
##     web.auth.exempt_peers = 192.0.2.42                                 ##
##   [ full api access from that address -- use sparingly ]               ##
## a local hub pushing to 127.0.0.1 needs no token with the exemption     ##
## as enabled below ; a remote jobsite carries its own bearer token in    ##
## /etc/protocol-7/host-config/jobsite.cfg [ jobsite.cfg.sync_token ]     ##
GET   /jobs.json    httpd.route.handler.web-relay  [command:web.jobs-data,auth.required=1,auth.exempt-loopback=1]
GET   /jobs-events  httpd.route.handler.web-relay  [command:web.jobs-events,auth.required=1,auth.exempt-loopback=1,content_type=text/event-stream]
POST  /jobs-sync    httpd.route.handler.web-relay  [command:web.jobs-sync,command.foreign=web.jobs-sync-foreign,auth.required=1,auth.exempt-loopback=1]

## trash-history panel : lightweight recent-trash list + rescue, routed   ##
## straight to jobsite [ no per-job content ever lives in the web cache ] ##
GET   /jobs-trash          httpd.route.handler.web-relay  [command:jobsite.list-trashed,auth.required=1,auth.exempt-loopback=1]
POST  /jobs-trash-rescue   httpd.route.handler.web-relay  [command:jobsite.rescue-http,auth.required=1,auth.exempt-loopback=1]

## manual single-url import : same shape as trash-rescue -- straight to     ##
## jobsite [ no content in the web cache ], jobsite.cmd.import-url does the ##
## actual validation/dedup/queueing, this is only the strm+json face        ##
POST  /jobs-import-url     httpd.route.handler.web-relay  [command:jobsite.import-url-http,auth.required=1,auth.exempt-loopback=1]

## small shared client-prefs blob [ e.g. trash-panel watermark ] so a     ##
## purely-local, no-canonical-server-value setting can still agree across ##
## different browsers/profiles instead of drifting independently forever  ##
GET   /jobs-prefs          httpd.route.handler.web-relay  [command:jobsite.get-prefs,auth.required=1,auth.exempt-loopback=1]
POST  /jobs-prefs          httpd.route.handler.web-relay  [command:jobsite.set-prefs,auth.required=1,auth.exempt-loopback=1]

## iris — BMW384 field visualization
GET   /iris/svg     httpd.route.handler.iris-svg
POST  /iris/route   httpd.route.handler.iris-route
POST  /iris/ledger  httpd.route.handler.iris-ledger
POST  /iris/pulse   httpd.route.handler.iris-pulse
POST  /iris/negotiate httpd.route.handler.iris-negotiate

