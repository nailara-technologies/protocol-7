
 .:[ nailara 'httpd' server zenka ]:.

[load_config_file:'shared-params']

modules.load  =  auth.client net protocol io.unix io.ip ui format.json format.yaml \
                 httpd httpd.classify jobsite.job httpd.route route.bmw384 \
                 devmod

plugins.load = plugin.httpd.radio plugin.web.auth
[load_plugins:<plugins.load>]

net.http.addr        =  0:0:0:0:0:0:0:0
net.http.port        =  80

http.handler.get     =  httpd.http_get
http.handler.head    =  httpd.http_head
http.handler.post    =  httpd.http_post
http.handler.options =  httpd.http_options

access.cmd.usr.cube  =  *

httpd.system.user    =  httpd
httpd.system.group   =  httpd

httpd.site_dir    = '/var/httpd/'
httpd.upload_dir  = '/var/protocol-7/httpd/uploads'

httpd.cfg.default_site_name = default  ##  <-- change \ auto-rename  ##  [LLL]

httpd.cfg.external_sitedirs = 1 # allow site_dir links to point outs. httpd dir?
httpd.cfg.uploads_enabled   = 1 # files need to be explicitly announced to zenka

httpd.cfg.allow_range_overlap = 1 # allow overlapping range request? [same data]

httpd.cfg.max_post_size = 5242880  ## 5MB

max.connections     =  1024
httpd.timeout       =  23

##  httpd request pattern classification [ phase 1 : observation only ] ##
##  deliberately opt-in : no state, no timers, zero cost while disabled ##
##  [ human-reviewed before enabling on the live deployment ]           ##
# httpd.classify.enabled         =  1
# httpd.classify.ring_size       =  64
# httpd.classify.peer_ttl        =  3600
# httpd.classify.max_peers       =  10000
# httpd.classify.expire_interval =  300

# development: enable debug logging for ACME endpoints [buffer, file, console]
system.zenka.verbosity.buffer  = 1
system.zenka.verbosity.logfile = 0
system.zenka.verbosity.console = 0 ## <-- reduce again after initialization ##

## host-specific overrides [ base.load_host_config : /etc/protocol-7/  ##
## httpd/host.cfg, 'key = value' on top of this file ] -- e.g. the web ##
## auth secret + exempt peers for the jobsite routes :                 ##
##   web.auth.secret = <long random>                                   ##
##   web.auth.exempt_peers = 192.0.2.42                                ##
[load_host_config]

[load_modules:<modules.load>]

[init_modules]

##  request pattern classification init [ internal guard on enabled ]   ##
[httpd.classify.init]

[base.net.connect:'unix']

httpd.sock = [base.open:'ip.tcp','input',<net.http.addr>,<net.http.port>]
[base.protocol.bind:<httpd.sock>,'http','server']

[root.drop_privs:<httpd.system.user>]

[base.get_session_id]

[zenka.loop]

