
 .:[ protocol-7 kimi-web client zenka ]:.

[load_config_file:'shared-params']

## owner mode : the zenka runs as the admin user                            ##
## [ the acp child : the owner's kimi login ] ; init, still root, gives the ##
## zenka dirs to this user                                                  ##
system.zenka-user.current = <system.admin-user>   ## <-- not 'protocol-7' ##

access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase buffer-erase-level \
                      ask-reply task-file status \
                      approve reject approvals new-session session-info \
                      list-models set-model \
                      acp-start acp-send acp-cancel acp-status \
                      acp-tail acp-stop acp-session-export \
                      acp-session-import acp-session-lease \
                      src-age src-ver subname name

## devmod commands : only reachable while devmod is loaded on THIS zenka ##
## [ v7-zenki.devmod-enable / devmod-clear ], not a permanent grant      ##
access.devcmd.usr.cube = devmod:*

system.zenka.verbosity.buffer  = 2
system.zenka.verbosity.console = 2

## kimi-web endpoint
#           ##   [ override if kimi-web is on a different host|port ]
# kimi.web.host = 127.0.0.1
# kimi.web.port = 5494

## reconnect backoff [ 2s initial, doubling up to max cap ]
# kimi.connect.retry_delay = 60

## local agent mode [ uses kimi-web zenka to spawn local agents ]
# kimi.cfg.use_local_agent = 0        ## set to 1 to enable local mode
# kimi.cfg.work_dir =                 ## default: <system.root_path>
# kimi.cfg.local_template =           ## context template for new agents

## admin group for spawned agent file access [ auto-detected from root_path ]
# kimi.cfg.assume_admin_group = 0     ## set to 1 to use project admin group

## memory index path
## [ prepended to every task prompt — relative to root_path ]
kimi.cfg.memory_path = data/ai-mem/kimi

## acp adapter : one `kimi acp` child, started by kimi.acp-start
## [ or by kimi.acp-send ] ; events in kimi.acp-tail and acp.log
# kimi.acp.cfg.command    = kimi acp
# kimi.acp.cfg.permission = deny           ## deny \ allow-once
# kimi.acp.cfg.autostart  = yes            ## acp-send starts a session
# kimi.acp.cfg.buffer     = 500            ## event lines kept
# kimi.acp.cfg.lease_hours = 13            ## session store lease
# kimi.acp.cfg.kimi_home   =               ## default : ~/.kimi-code

## child stop escalation and the zenka exit waits [ seconds, non-linear ]
base.interval.cfg.type.kimi-acp-stop.start      = 2
base.interval.cfg.type.kimi-acp-stop.factor     = 1.5
base.interval.cfg.type.kimi-acp-stop.cap        = 8
base.interval.cfg.type.kimi-acp-stop.cap_jitter = 0.3
base.interval.cfg.type.kimi-acp-exit.start      = 0.3
base.interval.cfg.type.kimi-acp-exit.factor     = 1.6
base.interval.cfg.type.kimi-acp-exit.cap        = 1.5
base.interval.cfg.type.kimi-acp-exit.cap_jitter = 0.2

crypt.C25519.autocreate-user-key = yes

modules.load = auth.client net protocol io.unix ui websocket crypt.C25519 \
               format.json devmod stream_child session_move \
               kimi

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.zenka-user.current>]

[base.net.connect:'unix']

[base.async.get_session_id]

[zenka.loop]

