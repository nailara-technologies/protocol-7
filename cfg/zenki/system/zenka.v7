
  .:[ 'system' monitor and utility zenka ]:.

[load_config_file:'shared-params']

access.cmd.usr.cube = commands heart reload verify-instance list show-buffer \
                      top cpu-load mem-used reload_gfx_module pid_autokill \
                      name cur-pid hostname report-X-11-error \
                      abort-reboot reenable-reboot disk-status disk-register \
                      disk-update disk-done watch-add watch-remove \
                      watches

## devmod commands : only reachable while devmod is loaded on THIS zenka ##
## [ v7-zenki.devmod-enable / devmod-clear ], not a permanent grant      ##
access.devcmd.usr.cube = devmod:*

system.cleanup_on_startup = 1  # [ .., perform cleanup tasks from list in ]
                               # [ ./cfg/zenki/system/cleanup-on-upgrade ]

#[ configuring thresholds ]

process.top_min.mem = 1 # %
process.top_min.cpu = 1 # %

process.poll.interval = 5 # [sec.]

mem.max_used = 98 # %
mem.autokill = 1 # whether to kill process w most used memory on max_used limit
mem.kill_min = 11 # %[memory usage before mem-alert based auto-kill is allowed]

mem.accel_threshold = 77 # %[ poll acceleration starts : poll interval tightens
                         #   linearly down to mem.accel_min_interval at
                         #   mem.max_used , flat process.poll.interval below ]
mem.accel_min_interval = 1 # [sec.] fastest allowed poll interval under pressure

disk.warn_free = 13 # [ % bytes or inodes free ]
disk.critical_free = 5 # [ % bytes or inodes free ]
disk.warn_min_free_gb = 13 # [ absolute warning floor on big file systems ]
disk.critical_min_free_gb = 5 # [ absolute critical floor on big file systems ]
disk.absolute_floor_min_size_gb = 64 # [ apply floors at this size and above ]
disk.include_tmpfs = no # [ yes opts tmpfs mounts into the same thresholds ]
disk.history_samples = 13 # [ recent samples in the free-space trend ]
base.interval.cfg.type.disk.rhythm = disk
base.interval.cfg.type.disk.start = 377 # [ seconds with comfortable room ]
base.interval.cfg.type.disk.cap = 13 # [ seconds under critical pressure ]

## watcher registry : unless= answers are waited for, an unanswered signal ##
## to events is sent again [ data/tasks/watcher-registry.md ]              ##
base.interval.cfg.type.budget-gate-answer.start = 89
base.interval.cfg.type.budget-gate-answer.cap = 89
base.interval.cfg.type.budget-gate-answer.cap_jitter = 13
base.interval.cfg.type.watch-signal-retry.start = 13
base.interval.cfg.type.watch-signal-retry.factor = 1.5
base.interval.cfg.type.watch-signal-retry.cap = 780
base.interval.cfg.type.watch-signal-retry.cap_jitter = 89

## per-mount overrides use disk.mount.<path>.<key>, for example :          ##
#disk.mount./data.warn_free = 8
#disk.mount./data.critical_free = 3
#disk.mount./data.warn_min_free_gb = 34
#disk.mount./data.critical_min_free_gb = 13

mem.oom_restart_window = 77 # [sec.] oom re-match within this window after a
                            #   restart request escalates to hard terminate
mem.oom_restart_reset  = 600 # [sec.] quiet period clearing restart-escalation
                             #   memory [ instance-id timestamps ]

mem.oom_kill_grace = 5 # [sec.] grace period between TERM and the follow-up
                       #   KILL sent to the raw privileged kill channel
                       #   [ system.process.callback.send_kill ]
mem.oom_terminate_backstop = 8 # [sec.] escalation only : how long to wait
                               #   after asking v7-zenki.terminate to clean
                               #   up an instance before falling back to the
                               #   raw kill channel as a last resort -- must
                               #   exceed v7-zenki.timeout.kill_list [ 2s
                               #   default ], terminate's own internal grace

## custom process rules example
## [ also matches zenki named <servername>.httpd ]
#process.limits.httpd.max_mem = 4.7 # [%]
#process.limits.httpd.seconds = 37  # [s] duration of condition
#process.limits.httpd.action  = kill
##

## [ per-host overlay : /etc/protocol-7/host-config/system.cfg, optional ] ##
## see base.load_host_config : host-level keys like                         ##
## process.limits.<name>.* belong THERE [ by role, not hostname ], not into ##
## a local edit of this file. the name matches the process fname \/* the    ##
## first cmndline token [ /proc comm is 15 chars -- 'llama-server' fits ].  ##
## max_mem is PERCENT OF TOTAL RAM [ rss ], seconds is the condition        ##
## duration before action.  example : bound a runaway cpu inference server  ##
## on a ram-tight host [ 23 GB total, 14 G cgroup cap -> ~61 %, backstop    ##
## set just above so the two layers do not fight ] :                        ##
#process.limits.llama-server.max_mem = 65  # [% of total ram]
#process.limits.llama-server.seconds = 13
#process.limits.llama-server.action  = kill
##

[load_host_config]

### [ 'X-11' zenka can notify on fatal protocol errors for mitigation ] ##
##
# system.X-11_crash.perform_host_reboot = yes
# system.X-11_crash.reboot_delay_secs = 7
# system.X-11_crash.reboot_condition = 'hostname-pattern:^some-hostname-\d+$'
##
###

modules.load = auth.client net protocol io.unix ui system \
               events.bucket.unless events.bucket.parse_args \
               events.bucket.gate.parse events.bucket.gate.holds \
               events.signal.encode events.signal.decode \
               events.signal.journal_read
[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

