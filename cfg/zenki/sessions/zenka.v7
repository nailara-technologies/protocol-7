
.:[ protocol-7 sessions zenka [ stub ] ]:.

[load_config_file:'shared-params']

access.cmd.usr.cube = heart subname name commands reload verify-instance \
                      list src-age src-ver show-buffer \
                      buffer-erase buffer-erase-level \
                      spawn status detach attach sign pubkey stop \
                      hold release secrets

## crypt.C25519 loaded for Crypt::Ed25519 + checksum-display helpers only  ##
## -- the holder child calls Crypt::Ed25519 primitives directly, never     ##
## crypt.C25519.gen_keys [ which loops on <[event.once]>, the same         ##
## fork+Event.pm hazard sessions.holder.child's own header note documents  ##
## ]. auto_load_keys=0 keeps crypt.C25519's own auto-load/ auto-create     ##
## machinery fully inert -- this zenka holds its OWN identity under        ##
## /var/protocol-7/sessions/, not any user's ~/.n/user-keys/. deliberately ##
## NOT loading the full keys zenka family: keys.init_code unconditionally  ##
## clobbers <system.amos-zenka-user>, which                                ##
## [root.drop_privs:<system.amos-zenka-user>] below depends on.            ##
crypt.C25519.auto_load_keys = 0

modules.load = auth.client net protocol io.unix sessions crypt.C25519
[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']

[base.get_session_id]

[zenka.loop]

