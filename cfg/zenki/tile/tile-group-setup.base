  - web-browser

      : web-browser[main] :

        fade   = 1
        prepare_cmd  = web-browser.hide_bg_window
        left   = 0%
        top    = 0%
        width  = 100%
        height = 100%

  - example-four

    : ticker :

        fade   = 1
        get_opacity = 1
        stop_zenki  = rss-ticker ticker
