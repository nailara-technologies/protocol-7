
# name  = events-setup.letsencr
# descr = event handlers [ includes base events ]

.: events :.

    enabled = letsencr-renewal forensics dist-upgrade

    - letsencr-renewal

      : action :
        type    = send-command
        command = letsencr.renew

    - forensics

      : action :
        type       = zenka-present
        zenka-name = forensics

    - dist-upgrade

      : action :
        type       = zenka-present
        zenka-name = dist-upgrade


.: timetable :.

  - forensics
    at  =  04:07
    jitter = 780 harmonic

  - dist-upgrade
    at  =  03:47
    jitter = 780 harmonic

  - letsencr-renewal
    at  =  04:31:07
    jitter = 780 harmonic

