
# name  = events-setup.base
# descr = simple example setup for 'events' zenka


.: events :.

    enabled = forensics # dist-upgrade

    - dist-upgrade

      : action :
        type      = zenka-present
        zenka-name = dist-upgrade

    - forensics

      : action :
        type   = zenka-present
        zenka-name = forensics

    - another-example

      : action :
        type    = send-command
        command = zenka-name.command [params]

.: timetable :.

  - dist-upgrade
    at  =  03:47
    jitter = 780 harmonic

  - forensics
    at  =  04:07
    jitter = 780 harmonic

  - another-example
    at  =  HH:05:13
    # .. or .,
    # start = 07:05
    # end   = 20:07
    # jitter = 780 harmonic   ## a random offset of up to 780 s [ ms ] per
    #                         ## run, start and end move together ;
    #                         ## harmonic : only offsets that assert true

