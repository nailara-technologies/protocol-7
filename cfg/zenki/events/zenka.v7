
.:[ 'events' [ trigger ] zenka ]:.

[load_config_file:'shared-params']

events.load_config  = base        ## [ ./cfg/zenki/events/event-setup.<name> ]

## per-host overrides [ /etc/protocol-7/host-config/events.cfg, optional ]: ##
## a server sets 'events.load_config = letsencr' there, not in the tree     ##
[load_host_config]
##        available : letsencr | base  ## enable letsencr for 'remote-server'

modules.load      = net protocol io.unix ui auth events set-up.json ## devmod
access.cmd.usr.cube  = verify-instance commands heart reload \
                      signal signals plugins \
                      bucket-add bucket-remove bucket-show bucket-clear \
                      *  ## <-- refine

## buckets [ runtime timetables of the zenki, see events.bucket-add ] :     ##
## entries per bucket, and the rhythms of `after=<type>` -- fresh state per ##
## add, so each type gives its start value ; minutes 13 \ 15 preferred      ##
events.bucket_limit                          = 377
## the same notification cue at most once per window ##
## [ events.notify.apply ]                           ##
base.interval.cfg.type.notify-repeat.start      = 55
base.interval.cfg.type.notify-repeat.factor     = 1.2
base.interval.cfg.type.notify-repeat.cap        = 233
base.interval.cfg.type.notify-repeat.cap_jitter = 21

base.interval.cfg.type.bucket-wait-short.start   = 34
base.interval.cfg.type.bucket-wait-short.factor  = 1.2
base.interval.cfg.type.bucket-wait-short.cap     = 89
base.interval.cfg.type.bucket-wait-short.cap_jitter = 13
base.interval.cfg.type.bucket-wait.minutes   = 13
base.interval.cfg.type.bucket-wait-long.minutes  = 89
## budget gates [ budget=claude:5h<60 ] : a closed gate is read again a     ##
## margin after the reset of its reading, or on the budget-gate rhythm when ##
## the reset is not known [ the usage zenka may be idle ]                   ##
base.interval.cfg.type.budget-gate-margin.start      = 21
base.interval.cfg.type.budget-gate-margin.factor     = 1
base.interval.cfg.type.budget-gate-margin.cap        = 21
base.interval.cfg.type.budget-gate-margin.cap_jitter = 8
base.interval.cfg.type.budget-gate.start             = 55
base.interval.cfg.type.budget-gate.factor            = 1.6
base.interval.cfg.type.budget-gate.cap               = 987
base.interval.cfg.type.budget-gate.cap_jitter        = 89
## a read with no answer at all [ above the slowest usage provider ] ##
base.interval.cfg.type.budget-gate-answer.start      = 89
base.interval.cfg.type.budget-gate-answer.factor     = 1
base.interval.cfg.type.budget-gate-answer.cap        = 89
base.interval.cfg.type.budget-gate-answer.cap_jitter = 13

[load_modules:<modules.load>]

## event types : plugin.events.action.* what a fired entry does,    ##
## plugin.events.source.* what wakes an entry [ timetable, signal ] ##
plugins.load      = plugin.events
[load_plugins:<plugins.load>]

[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

