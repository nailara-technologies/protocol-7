
.:[ 'events' [ trigger ] zenka ]:.

[load_config_file:'shared-params']

events.load_config  = base        ## [ ./cfg/zenki/events/event-setup.<name> ]

## per-host overrides [ /etc/protocol-7/host-config/events.cfg, optional ]: ##
## a server sets 'events.load_config = letsencr' there, not in the tree     ##
[load_host_config]
##        available : letsencr | base  ## enable letsencr for 'remote-server'

modules.load      = net protocol io.unix ui auth events set-up.json ## devmod
access.cmd.usr.cube  = verify-instance commands heart reload \
                      signal signals plugins *  ## <-- refine

[load_modules:<modules.load>]

## event types : plugin.events.action.* what a fired entry does,    ##
## plugin.events.source.* what wakes an entry [ timetable, signal ] ##
plugins.load      = plugin.events
[load_plugins:<plugins.load>]

[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

