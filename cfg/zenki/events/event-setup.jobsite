
# name  = events-setup.jobsite
# descr = letsencr events + an hourly jobsite scan [ the scanning host ]

.: events :.

    enabled = letsencr-renewal forensics dist-upgrade jobsite-scan

    - letsencr-renewal

      : action :
        type    = send-command
        command = letsencr.renew

    - forensics

      : action :
        type       = zenka-present
        zenka-name = forensics

    - dist-upgrade

      : action :
        type       = zenka-present
        zenka-name = dist-upgrade

    ## starts jobsite on demand and scans at once -- after a reboot, a ##
    ## crash or a manual stop it is back within the hour. a scan still ##
    ## running refuses the next [ 'cycle already active' ]             ##
    - jobsite-scan

      : action :
        type    = send-command
        command = jobsite.scan


.: timetable :.

  - forensics
    at  =  04:07
    jitter = 780 harmonic

  - dist-upgrade
    at  =  03:47
    jitter = 780 harmonic

  - letsencr-renewal
    at  =  04:31:07
    jitter = 780 harmonic

  - jobsite-scan
    at  =  HH:13:07
    jitter = 780 harmonic

