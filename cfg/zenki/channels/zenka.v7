
 .:[ nailara 'channels' zenka ]:.

[load_config_file:'shared-params']

start.on-demand    = 1
restart.disabled   = 1

## idle timeout: 10 minutes ##
[base.zenki.set_ondemand_timeout:600]

system.zenka.verbosity.buffer = 2  ##  memory ring buffer verbosity  ##

modules.load = auth.client net protocol io.unix ui format.yaml channels devmod ## <-- development ##

access.cmd.usr.cube = commands heart reload verify-instance *-version \
                      show-buffer buffer-erase buffer-erase-level list \
                      src-age cur-pid \
                      ai-review-approve ai-review-feedback ai-review-status \
                      ai-review-submit channels-since last-data-timestamp \
                      next-data-timestamp subscribe unsubscribe update

## devmod commands : only reachable while devmod is loaded on THIS zenka  ##
## [ v7-zenki.devmod-enable / devmod-clear ], not a permanent grant       ##
## strm-test/strm-size-test are channels' own dev/test commands, same    ##
## gate as devmod's since they're equally dev-only [ renamed from a      ##
## bare-name collision with devmod's own test-strm/test-strm-size ]      ##
access.devcmd.usr.cube = devmod:* strm-test strm-size-test

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

