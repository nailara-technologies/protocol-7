
.:[ 'external' connection handling zenka ]:.


[load_config_file:'shared-params']

modules.load           = auth.client auth.binding net protocol io.unix io.ip ui \
                         crypt.C25519 trust format.json external link   ## devmod

## self.* : routes cube to the named link [ test ] -- '*' is ONE dotted
## segment [ base.parser.access_conf ], so osf-cache's '<sid>.<cmd>' over
## the link needs its own one-level-deeper grants ##
access.cmd.usr.cube    = verify-instance commands heart reload subname \
                         list show-buffer buffer-erase buffer-erase-level \
                         list-connections connect authorize-link revoke-link \
                         list-deps cur-pid src-ver rel-ver src-age \
                         self.* self.*.has self.*.merkle self.*.segment \
                         *.site-yaml.import *.site-yaml.import-url \
                         *.site-yaml.queue-depth *.site-yaml.liveness \
                         *.site-yaml.subscribe-fetched *.site-yaml.outbox-confirm \
                         *.site-yaml.scan-lists \
                         *.task.claim *.task.start *.task.show \
                         *.task.complete *.task.fail *.task.queue \
                         *.task.next *.task.subscribe

## devmod commands : only reachable while devmod is loaded on this zenka ##
## [ v7-zenki.devmod-enable / devmod-clear ], not a permanent grant      ##
access.devcmd.usr.cube = devmod:*

## *.site-yaml.* : jobsite fetching through another host's site-yaml        ##
## [ jobsite.cfg.fetch_zenka = external.<link>.site-yaml ] -- cube still    ##
## checks every caller [ access.cmd.usr.jobsite ], the remote cube the link ##
## identity [ access.cmd.usr.remote-fetch ]                                 ##

## named encrypted links [ external.connect <name> <host[:port]> ] :
## the auth-keypair label this host authenticates as - the remote cube
## must hold its public key under ~/.n/remote-keys/authorized/cube/
## [ unset : connect needs an explicit <as-username> ]
# external.cfg.link_user = <label>

## *.task.* : a remote task worker's claims through a managed link       ##
## [ the task-worker grant on the REMOTE cube decides what really runs ] ##

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

## managed links [ stage 1 of LINK-ZENKI-AND-TRANSPORTS.md ] : host records ##
## with role 'link' open here and stay supervised [ heartbeat + backoff ]   ##
## -- AFTER the privilege drop : forks ssh children, reads pins under the   ##
## zenka user's ~/.n                                                        ##
[link.supervisor.start]

[zenka.loop]

