
 .:[ protocol-7 kimi-web sub-agent spawner zenka ]:.

[load_config_file:'shared-params']

access.cmd.usr.cube = commands heart reload verify-instance \
                      list show-buffer buffer-erase buffer-erase-level \
                      spawn_agent list_agents dispatch dispatch_parallel \
                      dispatch_stream enqueue \
                      terminate_agent resolve_template \
                      list-sessions get-session-state read-session-context \
                      find-session resume-session distill-session \
                      inject-context-to-coding \
                      src-age src-ver subname name \
                      eval-code deparse-code list-subs

system.zenka.verbosity.buffer  = 2
system.zenka.verbosity.console = 2

## agent configuration
kimi-web.agent.base_port   = 16000
kimi-web.agent.max_agents  = 8

## session cache configuration
## kimi-legacy itself always runs as the interactive admin user, not this
## zenka's dropped-privs service account -- $ENV{'HOME'} inside the zenka
## process points at the wrong home dir, so this must be set explicitly
## via <system.admin-user> rather than left to the code's own ENV fallback
kimi-web.cfg.sessions_dir = /home/<system.admin-user>/.kimi/sessions
kimi-web.cfg.context_file = context.jsonl
kimi-web.cfg.state_file   = state.json
kimi-web.cfg.wire_file    = wire.jsonl

## default context template budget
kimi-web.template.budget = 8000

crypt.C25519.autocreate-user-key = yes

modules.load = auth.client net protocol io.unix ui crypt.C25519 \
               format.json format.yaml clients.http devmod context kimi-web

[load_modules:<modules.load>]
[init_modules]

## kimi-web bridges to kimi-legacy sessions the interactive user runs
## directly (~/.kimi/sessions) -- drops to the interactive user like the
## desktop-integrated zenki (mpv, notify-osd, openbox, ...) do via
## AMOS-user, not the isolated amos-zenka-user service account everything
## else uses
[root.drop_privs:<system.admin-user>]

[base.net.connect:'unix']

[base.async.get_session_id]

[zenka.loop]

