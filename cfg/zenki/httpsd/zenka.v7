
 .:[ nailara 'httpsd' HTTPS server zenka - TLS/SSL encrypted ]:.

[load_config_file:'shared-params']

## Enable verbose logging for HTTPS debugging [ level 2 = more details ]
system.zenka.verbosity.buffer  = 2
system.zenka.verbosity.logfile = 2

## Load httpd modules + httpsd wrappers
modules.load         =  auth.client net protocol io.unix io.ip ui io.ssl \
                        format.json httpd httpd.classify httpsd ## devmod

net.https.addr       =  0:0:0:0:0:0:0:0
net.https.port       =  443

## TLS configuration - TLS 1.3 preferred, TLS 1.2 fallback
## [ SSL_version takes first entry from colon-separated list ]
httpsd.cfg.tls_version              = TLSv1_3:TLSv1_2
## RSA cipher suite [ matching Let's Encrypt RSA 2048 certificate ]
httpsd.cfg.cipher_suite             = ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-CHACHA20-POLY1305:DEFAULT
## certificate paths now auto-discovered from /etc/protocol-7/certs/
## [ see : httpsd.discover_active_certificate module ]
httpsd.cfg.hsts_max_age             = 31536000
httpsd.cfg.hsts_include_subdomains  = 1

## crash capture : write last request to /dev/shm before each request ####
## disable once crash is identified and fixed [ re-enable if it recurs ] #
httpsd.cfg.request_capture = yes
### forward crash capture buffer to disk via p7-log zenka ##
httpsd.cfg.request_capture_send = true
####

## graceful startup: certificate provisioning with exponential backoff
## when certificate missing, retry periodically with increasing delays
httpsd.cfg.startup_timeout          = 30        ## seconds to wait for certificate provisioning
httpsd.cfg.initial_retry_delay      = 10        ## seconds (exponential base: 10, 20, 40, 80...)
httpsd.cfg.max_retry_delay          = 600       ## 10 minutes max backoff

## HTTP handlers [ reuse httpd handlers for HTTPS ]
https.handler.get     =  httpd.http_get
https.handler.head    =  httpd.http_head
https.handler.post    =  httpd.http_post
https.handler.options =  httpd.http_options

## Shared settings with httpd [ site content ]
httpsd.site_dir     =    /var/httpd/
httpsd.upload_dir   =    /var/protocol-7/httpd/uploads

httpsd.cfg.default_site_name = default

httpsd.cfg.uploads_enabled      =  1
httpsd.cfg.external_sitedirs    =  1
httpsd.cfg.allow_range_overlap  =  1
httpd.cfg.external_sitedirs     =  1

access.cmd.usr.cube  =  *

## run as httpsd user, httpd group for /var/httpd access
httpsd.system.user    =  httpsd
httpsd.system.group   =  httpd

max.connections     =  1024
httpsd.timeout      =  14

##  httpd request pattern classification [ phase 1 : observation only ] ##
##  deliberately opt-in : no state, no timers, zero cost while disabled ##
##  [ human-reviewed before enabling on the live deployment ]           ##
# httpd.classify.enabled         =  1
# httpd.classify.ring_size       =  64
# httpd.classify.peer_ttl        =  3600
# httpd.classify.max_peers       =  10000
# httpd.classify.expire_interval =  300

[load_modules:<modules.load>]

[init_modules]

##  request pattern classification init [ internal guard on enabled ]   ##
[httpd.classify.init]

[base.net.connect:'unix']

## socket creation handled in post_init with graceful cert handling
[httpsd.post_init]

[root.drop_privs:'httpsd','httpd']

[get_session_id]

[zenka.loop]

