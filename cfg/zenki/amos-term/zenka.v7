
.:[ 'amos-term' terminal zenka ]:.

[load_config_file:'shared-params']
[load_config_file:'X11-vars']

modules.load          = net protocol io.unix ui auth data data.mount.shm \
                               amos-term amos-term.handler plan-9  ## devmod

access.cmd.usr.cube   = verify-instance commands heart reload subname \
                        list show-buffer buffer-erase buffer-erase-level \
                        cur-pid src-ver rel-ver src-age \
                        list_attachments attach_buffer mount-9p \
                        mount-9p-client list-dir read-file \
                        window-create window-open window-close \
                        window-destroy list-windows \
                        attach-fs-mount detach-cube export-directory \
                        import-fs interaction-ask interaction-reply \
                        interaction-status list-fs-mounts mount-cube \
                        mount-hash mount-visual shm-reap

## devmod commands : only reachable while devmod is loaded on THIS zenka  ##
## [ v7-zenki.devmod-enable / devmod-clear ], not a permanent grant       ##
access.devcmd.usr.cube = devmod:* shm-self-test

amos-term.term-user             =  <system.AMOS-user>

amos-term.auto-open-terminal    =  1
amos-term.term-param.face-size  = 24

[load_modules:<modules.load>]
[init_modules]

[root.drop_privs:<system.amos-zenka-user>]

[base.net.connect:'unix']
[base.get_session_id]

[zenka.loop]

